{
  "name": "liminal-context",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test:all": "pnpm -r --if-present test:all",
    "format:check": "biome format .",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:all": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:all"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0"
  }
}

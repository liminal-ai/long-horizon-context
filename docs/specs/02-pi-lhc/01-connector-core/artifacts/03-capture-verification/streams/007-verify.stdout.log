{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/fixtures/corpus.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n     2\t// named lifecycle paired with the LHC intake events it should produce. Until M0\n     3\t// delivers real recordings, the loaders build synthetic stand-ins; the\n     4\t// machinery (load → validate shape → compare on replay in Story 3) is real and\n     5\t// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n     6\t// hardcodes a passing count (story §Anti-Shim Requirements).\n     7\timport type { EventKind } from \"lhc\";\n     8\timport type { Corpus } from \"../../src/verify/replay.js\";\n     9\timport { ABORTED_DISPOSITION_TEXT } from \"../../src/capture/map-message.js\";\n    10\timport {\n    11\t  makeAssistantMessage,\n    12\t  makeToolResult,\n    13\t  makeUserMessage,\n    14\t  validEvent,\n    15\t} from \"./synthetic.js\";\n    16\t\n    17\tconst CALL_A = \"call_a|fc_1\";\n    18\tconst CALL_B = \"call_b|fc_2\";\n    19\t\n    20\t/** Plain user/assistant text exchanges, no tools. */\n    21\texport function loadChattyCorpus(): Corpus {\n    22\t  return {\n    23\t    name: \"chatty\",\n    24\t    source: [\n    25\t      makeUserMessage(\"what does this repo do?\"),\n    26\t      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n    27\t      makeUserMessage(\"and the connector?\"),\n    28\t      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n    29\t    ],\n    30\t    expected: [\n    31\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n    32\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n    33\t      validEvent(\"turn_end\"),\n    34\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n    35\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n    36\t      validEvent(\"turn_end\"),\n    37\t    ],\n    38\t  };\n    39\t}\n    40\t\n    41\t/** One turn with a single tool run: thinking → call → result → answer. */\n    42\texport function loadToolHeavyCorpus(): Corpus {\n    43\t  return {\n    44\t    name: \"tool-heavy\",\n    45\t    source: [\n    46\t      makeUserMessage(\"read notes.txt\"),\n    47\t      makeAssistantMessage({\n    48\t        thinking: \"I should open the file\",\n    49\t        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n    50\t      }),\n    51\t      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n    52\t      makeAssistantMessage({ text: \"the file says hello\" }),\n    53\t    ],\n    54\t    expected: [\n    55\t      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n    56\t      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n    57\t      validEvent(\"tool_call\", {\n    58\t        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    59\t      }),\n    60\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n    61\t      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n    62\t      validEvent(\"turn_end\"),\n    63\t    ],\n    64\t  };\n    65\t}\n    66\t\n    67\t/** Two parallel tool calls whose results complete out of order; correlation is\n    68\t *  by id, not arrival order (AC-2.3). */\n    69\texport function loadParallelToolCorpus(): Corpus {\n    70\t  return {\n    71\t    name: \"parallel-tool\",\n    72\t    source: [\n    73\t      makeUserMessage(\"read both files\"),\n    74\t      makeAssistantMessage({\n    75\t        toolCalls: [\n    76\t          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n    77\t          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n    78\t        ],\n    79\t      }),\n    80\t      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n    81\t      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n    82\t      makeAssistantMessage({ text: \"read both\" }),\n    83\t    ],\n    84\t    expected: [\n    85\t      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n    86\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n    87\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n    88\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n    89\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n    90\t      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n    91\t      validEvent(\"turn_end\"),\n    92\t    ],\n    93\t  };\n    94\t}\n    95\t\n    96\t/** A tool result flagged as an error, captured with its content (AC-2.4). */\n    97\texport function loadErrorResultCorpus(): Corpus {\n    98\t  return {\n    99\t    name: \"error-result\",\n   100\t    source: [\n   101\t      makeUserMessage(\"read missing.txt\"),\n   102\t      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n   103\t      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n   104\t      makeAssistantMessage({ text: \"that file does not exist\" }),\n   105\t    ],\n   106\t    expected: [\n   107\t      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n   108\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n   109\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n   110\t      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n   111\t      validEvent(\"turn_end\"),\n   112\t    ],\n   113\t  };\n   114\t}\n   115\t\n   116\t/** A graceful interrupt: partial assistant content, turn closed\n   117\t *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\n   118\texport function loadAbortedTurnCorpus(): Corpus {\n   119\t  return {\n   120\t    name: \"aborted-turn\",\n   121\t    source: [\n   122\t      makeUserMessage(\"write a long essay\"),\n   123\t      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n   124\t    ],\n   125\t    expected: [\n   126\t      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n   127\t      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n   128\t      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n   129\t      // The aborted disposition rides a trailing runtime_note (the mapper carries\n   130\t      // stopReason through; research §5b), then the turn closes complete-but-aborted.\n   131\t      validEvent(\"runtime_note\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\n   132\t      validEvent(\"turn_end\"),\n   133\t    ],\n   134\t  };\n   135\t}\n   136\t\n   137\texport const CORPUS_LOADERS = {\n   138\t  chatty: loadChattyCorpus,\n   139\t  \"tool-heavy\": loadToolHeavyCorpus,\n   140\t  \"parallel-tool\": loadParallelToolCorpus,\n   141\t  \"error-result\": loadErrorResultCorpus,\n   142\t  \"aborted-turn\": loadAbortedTurnCorpus,\n   143\t} as const;\n   144\t\n   145\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n   146\t\n   147\texport function loadAllCorpora(): Corpus[] {\n   148\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n   149\t}\n   150\t\n   151\t/** A deliberately malformed sequence for the capture-failure test: an empty\n   152\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n   153\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n   154\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n   155\texport function makeTruncatedCorpus(): Corpus {\n   156\t  return {\n   157\t    name: \"truncated\",\n   158\t    source: [makeUserMessage(\"\")],\n   159\t    expected: [\n   160\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n   161\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n   162\t    ],\n   163\t  };\n   164\t}\n   165\t\n   166\texport interface CorpusValidation {\n   167\t  valid: boolean;\n   168\t  problems: string[];\n   169\t}\n   170\t\n   171\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n   172\t  \"user_prompt\",\n   173\t  \"assistant_text\",\n   174\t  \"assistant_thinking\",\n   175\t  \"runtime_note\",\n   176\t  \"tool_call\",\n   177\t  \"tool_result\",\n   178\t  \"turn_end\",\n   179\t]);\n   180\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/verify/replay.ts | sed -n '1,180p'\"","aggregated_output":"     1\timport {\n     2\t  createSdk,\n     3\t  inspect,\n     4\t  intakeStream,\n     5\t  messages,\n     6\t  turns,\n     7\t  type DerivationProvider,\n     8\t  type EventRecord,\n     9\t  type InspectOverview,\n    10\t  type MessageEventInput,\n    11\t  type MessageRecord,\n    12\t  type OpResult,\n    13\t  type ProviderResult,\n    14\t  type ThreadRef,\n    15\t  type TurnRecord,\n    16\t} from \"lhc\";\n    17\timport type { AgentMessage } from \"../pi/types.js\";\n    18\timport type { LhcInstance } from \"../shared/instance.js\";\n    19\timport { capture, captureGap } from \"../capture/converter.js\";\n    20\timport { mapMessage, type MapCtx } from \"../capture/map-message.js\";\n    21\timport { TurnAccumulator } from \"../capture/turn-accumulator.js\";\n    22\t\n    23\t// AC-6.1, AC-6.2 (Flow 6, Story 3). Capture correctness is proven WITHOUT\n    24\t// serving anything to a model: a recorded PI corpus replays through the REAL\n    25\t// converter and intake path into a temp thread, and the thread's read-back —\n    26\t// events, messages, and turns — is compared to the fixture's expectation. The\n    27\t// same corpus replayed twice yields identical read-back because the converter's\n    28\t// mapping and the SDK's deterministic ids make replay reproducible.\n    29\t//\n    30\t// Anti-shim (story §Anti-Shim Requirements): this drives Story 2's converter\n    31\t// (`mapMessage` → `TurnAccumulator` → `capture`) exactly as live capture does —\n    32\t// it never writes the fixture's expected events to the thread, and it compares\n    33\t// events/messages/turns/order, never just counts. inspect's overview/health are\n    34\t// the live read-back surfaces a Story-3 test asserts on for AC-6.3.\n    35\t\n    36\t/** A loaded corpus: synthetic PI source messages (the stand-in until M0\n    37\t *  delivers recordings) paired with the expected LHC intake events. Both\n    38\t *  `verify/replay` and the corpus fixtures consume this shape. */\n    39\texport interface Corpus {\n    40\t  name: string;\n    41\t  source: AgentMessage[];\n    42\t  expected: MessageEventInput[];\n    43\t}\n    44\t\n    45\t/** A structured compare result with a readable diff (tech design §Technical\n    46\t *  Notes). `matches` is true only when events, messages, AND turns all line up\n    47\t *  with the fixture; `diff` names every divergence when they do not. */\n    48\texport interface ReplayResult {\n    49\t  matches: boolean;\n    50\t  diff?: string;\n    51\t}\n    52\t\n    53\tfunction detail(cause: unknown): string {\n    54\t  return cause instanceof Error ? cause.message : String(cause);\n    55\t}\n    56\t\n    57\t/** A construction-valid, fail-closed inference provider — the same observe-only\n    58\t *  shape the live Epic-1 session runs on (index.ts). Replay never serves context\n    59\t *  to a model, so every derivation operation fails closed (non-retryable) rather\n    60\t *  than fabricating derived text; the resulting failed derivations are exactly\n    61\t *  what inspect health must surface (AC-6.3), so the harness mirrors production\n    62\t *  rather than hiding them behind a succeeding fake. */\n    63\tfunction observeOnlyProvider(): DerivationProvider {\n    64\t  const notConfigured = (): Promise<ProviderResult> =>\n    65\t    Promise.resolve({\n    66\t      ok: false,\n    67\t      retryable: false,\n    68\t      reason: \"pi-lhc replay is observe-only (no inference served)\",\n    69\t    });\n    70\t  return {\n    71\t    smoothPrompt: notConfigured,\n    72\t    summarizeToolCall: notConfigured,\n    73\t    summarizeToolResult: notConfigured,\n    74\t    composeTurnRendering: notConfigured,\n    75\t    projectLowerBand: notConfigured,\n    76\t    summarizeChunkDetailed: notConfigured,\n    77\t    summarizeChunkBrief: notConfigured,\n    78\t  };\n    79\t}\n    80\t\n    81\t/** Build a real background LHC instance against the temp thread. The converter\n    82\t *  writes through `instance.sdk.intakeStream`, and `dispose` drains settled so\n    83\t *  background derivations reach a terminal state before read-back — the same\n    84\t *  flush-on-dispose contract the lifecycle instance uses, rebuilt here because\n    85\t *  `verify` may not import `lifecycle` (boundary rule 3). */\n    86\tfunction buildReplayInstance(threadRef: ThreadRef): LhcInstance {\n    87\t  const sdk = createSdk({ provider: observeOnlyProvider(), mode: \"background\" });\n    88\t  return {\n    89\t    sdk,\n    90\t    threadRef,\n    91\t    dispose: async (): Promise<OpResult<void>> => {\n    92\t      try {\n    93\t        await sdk.drainSettled(threadRef);\n    94\t      } catch {\n    95\t        // Best-effort flush; replay's verdict comes from durable read-back, not\n    96\t        // from the drain, and a drain failure must not throw out of verify.\n    97\t      }\n    98\t      return { ok: true, value: undefined };\n    99\t    },\n   100\t  };\n   101\t}\n   102\t\n   103\t/** A deterministic per-replay session id derived from the CORPUS, not the\n   104\t *  thread: it scopes every idempotency key, so the same corpus replayed into two\n   105\t *  different temp threads produces byte-identical keys (AC-6.2), while different\n   106\t *  corpora never collide. */\n   107\tfunction replaySessionId(corpus: Corpus): string {\n   108\t  return `replay:${corpus.name}`;\n   109\t}\n   110\t\n   111\t/** Drive one corpus through the real converter into the thread, reconstructing\n   112\t *  the PI hook stream a live session would have fired: each source message is a\n   113\t *  `message_end` (mapped + accumulated + flushed), and an `agent_end` closes the\n   114\t *  LHC turn at each agent-run boundary — before a fresh user prompt and once at\n   115\t *  end-of-stream — so PI's \"a new prompt starts a new run\" shows up as exactly\n   116\t *  one `turn_end` per run (AC-2.2 semantics, exercised end to end here). */\n   117\tasync function driveCorpus(corpus: Corpus, instance: LhcInstance): Promise<void> {\n   118\t  const piSessionId = replaySessionId(corpus);\n   119\t  const accumulator = new TurnAccumulator({ piSessionId });\n   120\t\n   121\t  for (const [index, message] of corpus.source.entries()) {\n   122\t    // A new user prompt with a turn already open means the previous agent run\n   123\t    // ended: close it first (agent_end), then record the prompt that opens the\n   124\t    // next run.\n   125\t    if (message.role === \"user\" && accumulator.hasOpenTurn()) {\n   126\t      await flush(accumulator.onAgentEnd(), instance);\n   127\t    }\n   128\t\n   129\t    // Real recorded PI message_end always carries a stable entry id; the\n   130\t    // synthetic corpora omit it, so stamp a deterministic per-message id so the\n   131\t    // converter keys off its Tier-1 path exactly as production does.\n   132\t    const mapCtx: MapCtx = { piSessionId, entryId: `${piSessionId}:entry:${index}` };\n   133\t    let events: MessageEventInput[];\n   134\t    try {\n   135\t      events = mapMessage(message, mapCtx);\n   136\t    } catch (cause) {\n   137\t      // An unmappable source message degrades to a durable, queryable gap —\n   138\t      // never a thrown replay (mirrors index.ts's capture-failure isolation).\n   139\t      await captureGap(`${piSessionId}:entry:${index}`, `replay map failed: ${detail(cause)}`, instance);\n   140\t      continue;\n   141\t    }\n   142\t    accumulator.onMessage(events);\n   143\t    await flush(events, instance);\n   144\t  }\n   145\t\n   146\t  // Close the final open turn (the last agent run's agent_end).\n   147\t  await flush(accumulator.onAgentEnd(), instance);\n   148\t}\n   149\t\n   150\tasync function flush(events: MessageEventInput[], instance: LhcInstance): Promise<void> {\n   151\t  if (events.length === 0) return;\n   152\t  await capture(events, instance);\n   153\t}\n   154\t\n   155\t/** Strip the server-stamped order/timestamp so the comparison is over the\n   156\t *  logical intake shape the converter produced — including the real, stable\n   157\t *  idempotency keys (kept so AC-6.2's determinism is checkable on the read-back),\n   158\t *  excluding `recordedAt` (a wall-clock value that legitimately differs run to\n   159\t *  run). */\n   160\tfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n   161\t  return records.map(\n   162\t    (record) =>\n   163\t      ({\n   164\t        eventKind: record.eventKind,\n   165\t        idempotencyKey: record.idempotencyKey,\n   166\t        actor: record.actor,\n   167\t        harness: record.harness,\n   168\t        payload: record.payload,\n   169\t      }) as MessageEventInput,\n   170\t  );\n   171\t}\n   172\t\n   173\t/** Order-independent canonical JSON for value comparison: object keys sorted\n   174\t *  recursively so two structurally-equal payloads built in different key orders\n   175\t *  compare equal. */\n   176\tfunction canonical(value: unknown): string {\n   177\t  return JSON.stringify(sortKeys(value));\n   178\t}\n   179\t\n   180\tfunction sortKeys(value: unknown): unknown {\n","exit_code":0,"status":"completed"}}

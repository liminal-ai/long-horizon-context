{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '420,500p'\"","aggregated_output":"   420\t    };\n   421\t    const note = mapModelSelect(event, mapCtx);\n   422\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   423\t  };\n   424\t\n   425\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   426\t    if (instance === null || captureSession === null) return;\n   427\t    const sourceSeq = nextSourceSeq(captureSession);\n   428\t    const mapCtx: MapCtx = {\n   429\t      piSessionId: captureSession.piSessionId,\n   430\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n   431\t    };\n   432\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   433\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   434\t  };\n   435\t\n   436\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   437\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   438\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   439\t    if (instance === null || captureSession === null) return;\n   440\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   441\t    if (turnEnd.length === 0) return;\n   442\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   443\t  };\n   444\t\n   445\t  // Contain every handler: an observe-only hook must never throw back into PI\n   446\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   447\t  // plain-data diagnostic; it is never rethrown.\n   448\t  const guard = (\n   449\t    name: Epic1Hook,\n   450\t    body: PiHookHandler<Epic1Hook>,\n   451\t  ): PiHookHandler<Epic1Hook> => {\n   452\t    return async (ctx, event): Promise<void> => {\n   453\t      try {\n   454\t        await body(ctx, event);\n   455\t      } catch (err) {\n   456\t        lastDiagnostic = {\n   457\t          code: \"hook_handler_error\",\n   458\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   459\t          recordedGap: false,\n   460\t        };\n   461\t      }\n   462\t    };\n   463\t  };\n   464\t\n   465\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   466\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n   467\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n   468\t  // FRESH ctx and retains none of it.\n   469\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   470\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n   471\t  };\n   472\t\n   473\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   474\t  // are live; PI per-step turn_end and fork remain no-ops.\n   475\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   476\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   477\t    session_before_switch: onDispose,\n   478\t    session_shutdown: onDispose,\n   479\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   480\t    turn_end: noop,\n   481\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   482\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   483\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   484\t    session_before_fork: noop,\n   485\t  };\n   486\t\n   487\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   488\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   489\t\n   490\t  return {\n   491\t    handlers,\n   492\t    register(pi: ExtensionAPI): void {\n   493\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   494\t    },\n   495\t    getState(): SessionState | null {\n   496\t      return state;\n   497\t    },\n   498\t    getInstance(): LhcInstance | null {\n   499\t      return instance;\n   500\t    },\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/verify/replay.ts | sed -n '320,470p'\"","aggregated_output":"   320\t    }\n   321\t\n   322\t    if (openTurn !== undefined) {\n   323\t      openTurn.memberMessageIds.push(`m${eventOrder}`);\n   324\t    }\n   325\t  }\n   326\t\n   327\t  return records;\n   328\t}\n   329\t\n   330\tfunction comparableTurnRecords(records: readonly TurnRecord[]): ComparableTurnRecord[] {\n   331\t  return records.map((record) => ({\n   332\t    turnId: record.turnId,\n   333\t    status: record.status,\n   334\t    memberMessageIds: record.memberMessageIds,\n   335\t    openedAtEventOrder: record.openedAtEventOrder,\n   336\t    ...(record.closedAtEventOrder === undefined ? {} : { closedAtEventOrder: record.closedAtEventOrder }),\n   337\t  }));\n   338\t}\n   339\t\n   340\t/** Compare the actual read-back (events, plus messages/turns from inspect\n   341\t *  overview) to the fixture's expectation, accumulating a readable diff. Returns\n   342\t *  `null` on a full match. */\n   343\tfunction compareReadback(\n   344\t  corpus: Corpus,\n   345\t  actual: readonly MessageEventInput[],\n   346\t  overview: InspectOverview,\n   347\t  actualMessages: readonly MessageRecord[],\n   348\t  actualTurns: readonly TurnRecord[],\n   349\t): string[] {\n   350\t  const problems: string[] = [];\n   351\t  const expected = corpus.expected;\n   352\t\n   353\t  // Events — kind + payload, in source-event order (never counts alone).\n   354\t  if (actual.length !== expected.length) {\n   355\t    problems.push(`events.count: expected ${expected.length}, got ${actual.length}`);\n   356\t  }\n   357\t  for (let i = 0; i < Math.max(actual.length, expected.length); i += 1) {\n   358\t    const want = expected[i];\n   359\t    const got = actual[i];\n   360\t    if (want === undefined) {\n   361\t      problems.push(`events[${i}]: unexpected extra ${got?.eventKind} ${canonical(got?.payload)}`);\n   362\t      continue;\n   363\t    }\n   364\t    if (got === undefined) {\n   365\t      problems.push(`events[${i}]: missing expected ${want.eventKind} ${canonical(want.payload)}`);\n   366\t      continue;\n   367\t    }\n   368\t    if (got.eventKind !== want.eventKind) {\n   369\t      problems.push(`events[${i}].kind: expected ${want.eventKind}, got ${got.eventKind}`);\n   370\t    } else if (canonical(got.payload) !== canonical(want.payload)) {\n   371\t      problems.push(\n   372\t        `events[${i}].payload (${want.eventKind}): expected ${canonical(want.payload)}, got ${canonical(got.payload)}`,\n   373\t      );\n   374\t    }\n   375\t  }\n   376\t\n   377\t  // Messages — projected counts by kind.\n   378\t  const expectedMsgs = expectedMessages(expected);\n   379\t  if (overview.messages.visible !== expectedMsgs.visible) {\n   380\t    problems.push(`messages.visible: expected ${expectedMsgs.visible}, got ${overview.messages.visible}`);\n   381\t  }\n   382\t  if (canonical(overview.messages.byKind) !== canonical(expectedMsgs.byKind)) {\n   383\t    problems.push(\n   384\t      `messages.byKind: expected ${canonical(expectedMsgs.byKind)}, got ${canonical(overview.messages.byKind)}`,\n   385\t    );\n   386\t  }\n   387\t\n   388\t  // Turns — one closed turn per expected `turn_end`, none left open.\n   389\t  const expectedClosed = expected.filter((event) => event.eventKind === \"turn_end\").length;\n   390\t  if (overview.turns.closed !== expectedClosed) {\n   391\t    problems.push(`turns.closed: expected ${expectedClosed}, got ${overview.turns.closed}`);\n   392\t  }\n   393\t  if (overview.turns.open !== 0) {\n   394\t    problems.push(`turns.open: expected 0, got ${overview.turns.open}`);\n   395\t  }\n   396\t\n   397\t  // Messages — full read-back records implied by the fixture, in source order.\n   398\t  const expectedMessageRows = expectedMessageRecords(expected);\n   399\t  const actualMessageRows = comparableMessageRecords(actualMessages);\n   400\t  if (canonical(actualMessageRows) !== canonical(expectedMessageRows)) {\n   401\t    problems.push(\n   402\t      `messages.records: expected ${canonical(expectedMessageRows)}, got ${canonical(actualMessageRows)}`,\n   403\t    );\n   404\t  }\n   405\t\n   406\t  // Turns — full read-back records implied by fixture event boundaries.\n   407\t  const expectedTurnRows = expectedTurnRecords(expected);\n   408\t  const actualTurnRows = comparableTurnRecords(actualTurns);\n   409\t  if (canonical(actualTurnRows) !== canonical(expectedTurnRows)) {\n   410\t    problems.push(`turns.records: expected ${canonical(expectedTurnRows)}, got ${canonical(actualTurnRows)}`);\n   411\t  }\n   412\t\n   413\t  return problems;\n   414\t}\n   415\t\n   416\t/** Replay a recorded corpus through the converter into the temp thread, then\n   417\t *  compare the durable read-back (events, messages, turns) to the fixture's\n   418\t *  expectation. The thread is left populated so a caller can read inspect's\n   419\t *  overview/health off it (AC-6.3). Deterministic: the same corpus yields the\n   420\t *  same recorded read-back every time (AC-6.2). */\n   421\texport async function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult> {\n   422\t  const instance = buildReplayInstance(threadRef);\n   423\t  const problems: string[] = [];\n   424\t  try {\n   425\t    await driveCorpus(corpus, instance);\n   426\t  } catch (cause) {\n   427\t    problems.push(`replay threw before completion: ${detail(cause)}`);\n   428\t  } finally {\n   429\t    await instance.dispose();\n   430\t  }\n   431\t\n   432\t  const read = await intakeStream.listEvents(threadRef);\n   433\t  if (!read.ok) {\n   434\t    return { matches: false, diff: [...problems, `listEvents failed: ${read.error.reason}`].join(\"\\n\") };\n   435\t  }\n   436\t  const overview = await inspect.overview(threadRef);\n   437\t  if (!overview.ok) {\n   438\t    return { matches: false, diff: [...problems, `inspect.overview failed: ${overview.error.reason}`].join(\"\\n\") };\n   439\t  }\n   440\t  const messageReadback = await messages.listMessages(threadRef);\n   441\t  if (!messageReadback.ok) {\n   442\t    return {\n   443\t      matches: false,\n   444\t      diff: [...problems, `messages.listMessages failed: ${messageReadback.error.reason}`].join(\"\\n\"),\n   445\t    };\n   446\t  }\n   447\t  const turnReadback = await turns.listTurns(threadRef);\n   448\t  if (!turnReadback.ok) {\n   449\t    return {\n   450\t      matches: false,\n   451\t      diff: [...problems, `turns.listTurns failed: ${turnReadback.error.reason}`].join(\"\\n\"),\n   452\t    };\n   453\t  }\n   454\t\n   455\t  problems.push(\n   456\t    ...compareReadback(corpus, logicalEvents(read.value), overview.value, messageReadback.value, turnReadback.value),\n   457\t  );\n   458\t  if (problems.length === 0) return { matches: true };\n   459\t  return { matches: false, diff: problems.join(\"\\n\") };\n   460\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/specs/02-pi-lhc/01-connector-core/stories/03-capture-verification.md | sed -n '1,140p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/specs/02-pi-lhc/01-connector-core/stories/03-capture-verification.md | sed -n '1,140p'\"","aggregated_output":"     1\t# Story 3: Capture Verification\n     2\t\n     3\t### Summary\n     4\t<!-- Jira: Summary field -->\n     5\t\n     6\tVerify capture by replaying recorded PI corpora through the converter and matching deterministic thread read-back and inspect surfaces.\n     7\t\n     8\t### Description\n     9\t<!-- Jira: Description field -->\n    10\t\n    11\t**User Profile:** A developer using PI as their daily coding agent, with the `pi-lhc` extension loaded.\n    12\t\n    13\t**Objective:** Prove capture correctness from recorded corpora without serving context to a model.\n    14\t\n    15\t**Scope In:**\n    16\t\n    17\t- Corpus replay through the Story 2 converter.\n    18\t- Read-back comparison for events, messages, and turns.\n    19\t- Deterministic re-replay assertions for IDs and ordering.\n    20\t- Inspect overview and health assertions for counts, last recorded position, gaps, and failed derivations.\n    21\t\n    22\t**Scope Out:**\n    23\t\n    24\t- Creating M0 corpora. This story consumes M0 corpora as fixtures.\n    25\t- Context serving; Epic 1 remains observe-only.\n    26\t- Derivation quality tuning.\n    27\t\n    28\t**Dependencies:** Story 2. M0 corpora are fixture inputs.\n    29\t\n    30\t### Acceptance Criteria\n    31\t<!-- Jira: Acceptance Criteria field -->\n    32\t\n    33\t**AC-6.1:** Replaying a recorded PI corpus through the converter produces a thread whose read-back — events, messages, and turns — matches the fixture's expectation, including the chatty, tool-heavy, parallel-tool, error-result, and aborted-turn corpora.\n    34\t\n    35\t**TC-6.1** — Each corpus (chatty, tool-heavy, parallel-tool, error-result, aborted-turn) replays to a thread whose read-back matches the fixture.\n    36\t\n    37\t**AC-6.2:** Replay is deterministic: the same corpus replayed twice produces identical thread read-back. The deterministic-ID property holds through the converter, so a re-replay does not perturb IDs or ordering.\n    38\t\n    39\t**TC-6.2** — The same corpus replayed twice yields identical read-back (IDs and order stable).\n    40\t\n    41\t**AC-6.3:** inspect surfaces (overview, health) reflect the captured session: event and message counts, the last recorded event position, and any capture gaps or failed derivations are visible rather than hidden.\n    42\t\n    43\t**TC-6.3** — inspect overview/health report event/message counts, last event position, and any gaps or failed derivations.\n    44\t\n    45\t### Technical Design\n    46\t<!-- Jira: Technical Notes or sub-section of Description -->\n    47\t\n    48\t#### Architecture Context\n    49\t\n    50\tStory 3 is the proof layer for capture. It replays recorded PI corpora through the real converter and LHC intake path, then compares the thread read-back without serving context to a model.\n    51\t\n    52\tThe story also verifies inspect overview and health surfaces used by Epic 1 verification. Operator commands and self-inspection tools remain outside this story.\n    53\t\n    54\t#### Build Strategy\n    55\t\n    56\tStrategy: tdd-lite\n    57\t\n    58\tReason:\n    59\t- The implementation is narrow, but fixture fidelity and deterministic replay are easy to fake with shallow comparisons.\n    60\t- Red should pin exact read-back comparison and deterministic replay before Green implements the replay harness.\n    61\t\n    62\tRisk Reminders:\n    63\t- M0 corpora breadth determines final fixture coverage; the replay machinery should widen as corpora arrive.\n    64\t- Replay must use the real converter and intake path, not a parallel expected-event builder.\n    65\t\n    66\t#### Implementation Targets\n    67\t\n    68\t| Area | Files / Modules |\n    69\t|------|-----------------|\n    70\t| Replay harness | `packages/pi-lhc/src/verify/replay.ts` |\n    71\t| Corpus fixtures | `packages/pi-lhc/test/fixtures/corpus.ts` |\n    72\t| Temp threads | `packages/pi-lhc/test/fixtures/thread.ts` |\n    73\t| Verification tests | `packages/pi-lhc/test/verify/replay.test.ts`, `packages/pi-lhc/test/fixtures/corpus.test.ts` |\n    74\t| Inspect reads | LHC `inspect` overview/health APIs consumed by `verify/replay.ts` |\n    75\t\n    76\t#### Design References\n    77\t\n    78\t- [epic.md §Flow 6](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/epic.md:227), lines 227-235\n    79\t- [tech-design.md §Module Responsibility Matrix](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:196), lines 196-198\n    80\t- [tech-design.md §Flow 6](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:405), lines 405-413\n    81\t- [tech-design.md §Architecture-Risk Tests](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:535), lines 535-549\n    82\t- [tech-design.md §Fixture Contracts](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:555), lines 555-563\n    83\t- [tech-design.md §Chunk 3](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:658), lines 658-660\n    84\t- [test-plan.md §Replay Tests](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/test-plan.md:120), lines 120-132\n    85\t- [test-plan.md §Chunk 3](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/test-plan.md:161), lines 161-166\n    86\t\n    87\t#### Test Mapping\n    88\t\n    89\t| TC | Test File / Check | Test Description |\n    90\t|----|-------------------|------------------|\n    91\t| TC-6.1 | `test/verify/replay.test.ts` | Each available recorded corpus replays through the converter to a thread whose events, messages, and turns match fixture expectation. |\n    92\t| TC-6.2 | `test/verify/replay.test.ts` | Replaying the same corpus twice yields identical read-back, including deterministic IDs and order. |\n    93\t| TC-6.3 | `test/verify/replay.test.ts` | Inspect overview/health report event/message counts, last recorded position, gaps, and failed derivations. |\n    94\t\n    95\t#### Architecture-Risk Tests\n    96\t\n    97\t| Risk | Test File / Check | Test Description | Why AC/TC Mapping Alone Would Miss It |\n    98\t|------|-------------------|------------------|---------------------------------------|\n    99\t| Fixture validity | `test/fixtures/corpus.test.ts` | Corpus loader yields valid `MessageEventInput` shapes and lifecycle-coherent sequences. | Replay tests can pass against bad fixtures unless the fixture substrate is checked independently. |\n   100\t\n   101\t#### Technical Notes\n   102\t\n   103\t- `replayCorpus(corpus, threadRef)` should return a structured compare result with a readable diff.\n   104\t- Run replay against a real temp SQLite thread through the converter and intake path.\n   105\t- Inspect checks consume overview/health only; do not introduce operator surfaces here.\n   106\t\n   107\t#### Anti-Shim Requirements\n   108\t\n   109\t- Do not compare only counts for replay equality; compare events, messages, turns, IDs, and order.\n   110\t- Do not bypass Story 2's converter by writing expected events directly to the thread.\n   111\t\n   112\t#### Production Path Proof\n   113\t\n   114\t- Entrypoint: `packages/pi-lhc/src/verify/replay.ts`.\n   115\t- Registration/default path: tests feed recorded corpora into the same converter/intake path used by live capture.\n   116\t- Evidence: replay tests assert read-back equality, deterministic re-replay, and inspect health/overview visibility.\n   117\t\n   118\t#### Verification\n   119\t\n   120\t- Targeted: `pnpm --filter pi-lhc verify -- test/verify/replay.test.ts test/fixtures/corpus.test.ts`\n   121\t- Story gate: `pnpm --filter pi-lhc green-verify`\n   122\t- Epic gate: `pnpm --filter pi-lhc verify-all`\n   123\t\n   124\t#### Spec Deviations\n   125\t\n   126\tNone.\n   127\t\n   128\t### Definition of Done\n   129\t<!-- Jira: Definition of Done or Acceptance Criteria footer -->\n   130\t\n   131\t- All Flow 6 ACs and TCs pass.\n   132\t- Fixture replay compares events, messages, and turns for all available M0 corpora.\n   133\t- Re-replay is deterministic.\n   134\t- Inspect overview and health expose the required capture state.\n   135\t- Verification does not serve any context to a model.\n","exit_code":0,"status":"completed"}}

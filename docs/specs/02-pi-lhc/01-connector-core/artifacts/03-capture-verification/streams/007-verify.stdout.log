3-implementor.stdout.log:3885:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_012LTNensCtRvB5RUqDVi4sb\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e\\\",\\\"uuid\\\":\\\"6c9a683a-d92f-4688-b35e-43333c275c39\\\",\\\"timestamp\\\":\\\"2026-06-14T04:37:10.698Z\\\",\\\"tool_use_result\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\\\",\\\"oldString\\\":\\\"    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"ctx-2\\\\\\\", \\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\",\\\"newString\\\":\\\"    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\",\\\"originalFile\\\":\\\"// Story 1 — launch-driven thread resolution, plain-data state, and reload\\\\n// reconstruction (TC-1.2, 1.3, 1.5, 1.6, 1.7 + the restart architecture-risk\\\\n// test). Resolution and the picker are exercised directly against a real temp\\\\n// registry; the plain-data rule and reload are exercised through the connector.\\\\nimport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\nimport {\\\\n  createDeterministicProvider,\\\\n  inspect,\\\\n  threads,\\\\n  type OpResult,\\\\n  type SdkConfig,\\\\n  type ThreadRef,\\\\n} from \\\\\\\"lhc\\\\\\\";\\\\nimport { createConnector } from \\\\\\\"../../src/index.js\\\\\\\";\\\\nimport { disposeInstance, initInstance } from \\\\\\\"../../src/lifecycle/instance.js\\\\\\\";\\\\nimport { resolveThread, type ResolveDeps } from \\\\\\\"../../src/lifecycle/thread-resolution.js\\\\\\\";\\\\nimport { pickThread, type ThreadChoice } from \\\\\\\"../../src/lifecycle/picker.js\\\\\\\";\\\\nimport type { ExtensionContext } from \\\\\\\"../../src/pi/types.js\\\\\\\";\\\\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\\\\\"../fixtures/synthetic.js\\\\\\\";\\\\nimport { tempStore, type TempStore } from \\\\\\\"../fixtures/thread.js\\\\\\\";\\\\n\\\\nlet store: TempStore;\\\\nbeforeEach(() => {\\\\n  store = tempStore();\\\\n});\\\\nafterEach(() => {\\\\n  store.cleanup();\\\\n});\\\\n\\\\nfunction backgroundConfig(): SdkConfig {\\\\n  return { provider: createDeterministicProvider(), mode: \\\\\\\"background\\\\\\\" };\\\\n}\\\\n\\\\nfunction idOf(ref: ThreadRef): string {\\\\n  if (!(\\\\\\\"threadId\\\\\\\" in ref)) throw new Error(\\\\\\\"expected a { threadId } ref\\\\\\\");\\\\n  return ref.threadId;\\\\n}\\\\n\\\\nfunction deps(cwd = \\\\\\\"/work/default\\\\\\\"): ResolveDeps {\\\\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\\\n}\\\\n\\\\n// Create a thread directly with cwd/title so the picker test can assert both —\\\\n// new threads created by the connector carry a cwd but no title yet (title\\\\n// derivation is the deferred TDQ Q4).\\\\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\\\\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\\\\n    filePath: store.threadPath(),\\\\n    registryPath: store.registryPath,\\\\n  };\\\\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\\\n  if (opts.title !== undefined) input.title = opts.title;\\\\n  const created = await threads.newThread(input);\\\\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\\\\n  return created.value.threadId;\\\\n}\\\\n\\\\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\\\\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\\\\n// object, modelling PI handing a fresh ctx to each hook.\\\\nfunction syntheticCtx(cwd: string): ExtensionContext {\\\\n  return {\\\\n    cwd,\\\\n    hasUI: false,\\\\n    modelRegistry: {\\\\n      find: () => undefined,\\\\n      hasConfiguredAuth: () => false,\\\\n      getAvailable: () => [],\\\\n    },\\\\n    ui: { notify: () => {} },\\\\n    sessionManager: { getEntries: () => [] },\\\\n  };\\\\n}\\\\n\\\\nasync function threadCount(): Promise<number> {\\\\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\\\\n  return listed.ok ? listed.value.length : -1;\\\\n}\\\\n\\\\ndescribe(\\\\\\\"Story 1: launch-driven thread resolution\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.2: --session resolves an existing thread and creates no second thread\\\\\\\", async () => {\\\\n    const existingId = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"existing\\\\\\\" });\\\\n    const before = await threadCount();\\\\n\\\\n    const resolved = await resolveThread({ session: existingId }, deps());\\\\n    expect(resolved.ok).toBe(true);\\\\n    if (resolved.ok) expect(idOf(resolved.value)).toBe(existingId);\\\\n\\\\n    expect(await threadCount()).toBe(before); // no second thread\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\\\\\\\", async () => {\\\\n    // no flag → a new thread\\\\n    const first = await resolveThread({}, deps());\\\\n    expect(first.ok).toBe(true);\\\\n    if (!first.ok) return;\\\\n    const firstId = idOf(first.value);\\\\n\\\\n    // --session full id → the same thread\\\\n    const byFull = await resolveThread({ session: firstId }, deps());\\\\n    expect(byFull.ok).toBe(true);\\\\n    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\\\\n\\\\n    // --session partial id → the same thread\\\\n    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\\\\n    expect(byPartial.ok).toBe(true);\\\\n    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\\\\n\\\\n    // a second thread, then --continue → the most recently created\\\\n    const second = await resolveThread({}, deps());\\\\n    expect(second.ok).toBe(true);\\\\n    if (!second.ok) return;\\\\n    const secondId = idOf(second.value);\\\\n    const continued = await resolveThread({ continue: true }, deps());\\\\n    expect(continued.ok).toBe(true);\\\\n    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\\\\n\\\\n    // unresolvable id → actionable error, no thread created\\\\n    const before = await threadCount();\\\\n    const bad = await resolveThread({ session: \\\\\\\"th_zzzzzzzzzzzzzzzz\\\\\\\" }, deps());\\\\n    expect(bad.ok).toBe(false);\\\\n    if (!bad.ok) expect(bad.error.code).toBe(\\\\\\\"thread_not_found\\\\\\\");\\\\n    expect(await threadCount()).toBe(before);\\\\n\\\\n    // ambiguous prefix (matches both threads) → actionable error, no thread created\\\\n    const ambiguous = await resolveThread({ session: \\\\\\\"th_\\\\\\\" }, deps());\\\\n    expect(ambiguous.ok).toBe(false);\\\\n    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\\\\\\\"ambiguous_thread_id\\\\\\\");\\\\n    expect(await threadCount()).toBe(before);\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.7: --resume lists cwd-scoped threads (title + created), resolves selection, empty-safe\\\\\\\", async () => {\\\\n    const a1 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"alpha\\\\\\\" });\\\\n    const a2 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"beta\\\\\\\" });\\\\n    await makeThread({ cwd: \\\\\\\"/work/b\\\\\\\", title: \\\\\\\"other-cwd\\\\\\\" });\\\\n\\\\n    let offered: readonly ThreadChoice[] = [];\\\\n    const picked = await pickThread(\\\\\\\"/work/a\\\\\\\", {\\\\n      registryPath: store.registryPath,\\\\n      select: (choices) => {\\\\n        offered = choices;\\\\n        return Promise.resolve(choices[0]!.threadId);\\\\n      },\\\\n    });\\\\n    expect(picked.ok).toBe(true);\\\\n\\\\n    // Only the current cwd's threads are offered, each with title + creation time.\\\\n    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\\\\n    for (const choice of offered) {\\\\n      expect(choice.createdAt).toBeTruthy();\\\\n      expect(choice.title).toBeTruthy();\\\\n    }\\\\n\\\\n    // The operator's selection resolves to that thread.\\\\n    if (picked.ok && picked.value !== null) {\\\\n      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\\\\n    }\\\\n\\\\n    // An empty cwd reports an empty list (null) without failing or prompting.\\\\n    let selectCalled = false;\\\\n    const empty = await pickThread(\\\\\\\"/work/empty\\\\\\\", {\\\\n      registryPath: store.registryPath,\\\\n      select: () => {\\\\n        selectCalled = true;\\\\n        return Promise.resolve(null);\\\\n      },\\\\n    });\\\\n    expect(empty.ok).toBe(true);\\\\n    if (empty.ok) expect(empty.value).toBeNull();\\\\n    expect(selectCalled).toBe(false);\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.5 (risk: restart): reattach reconstructs the thread from its durable id after the holder is discarded\\\\\\\", async () => {\\\\n    const cwd = \\\\\\\"/work/tc-1-5\\\\\\\";\\\\n    // Create + capture on a thread.\\\\n    const created = await resolveThread({}, deps(cwd));\\\\n    expect(created.ok).toBe(true);\\\\n    if (!created.ok) return;\\\\n    const threadId = idOf(created.value);\\\\n\\\\n    const first = await initInstance(created.value, backgroundConfig());\\\\n    expect(first.ok).toBe(true);\\\\n    if (!first.ok) return;\\\\n    await first.value.sdk.intakeStream.messageEvents(\\\\n      first.value.threadRef,\\\\n      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n    );\\\\n    await disposeInstance(first.value);\\\\n\\\\n    // Discard ALL in-memory state. Only the durable id survives (as it would in\\\\n    // the registry across process death). Reconstruct purely from it — no\\\\n    // retained object.\\\\n    const reattached = await resolveThread({ session: threadId }, deps(cwd));\\\\n    expect(reattached.ok).toBe(true);\\\\n    if (!reattached.ok) return;\\\\n    expect(idOf(reattached.value)).toBe(threadId); // the same thread, by id\\\\n\\\\n    const rebuilt = await initInstance(reattached.value, backgroundConfig());\\\\n    expect(rebuilt.ok).toBe(true);\\\\n    if (!rebuilt.ok) return;\\\\n    // Capture continues on the same thread: append more, all events present.\\\\n    await rebuilt.value.sdk.intakeStream.messageEvents(\\\\n      rebuilt.value.threadRef,\\\\n      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n    );\\\\n    const overview = await inspect.overview(reattached.value);\\\\n    expect(overview.ok).toBe(true);\\\\n    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\\\\n    await disposeInstance(rebuilt.value);\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"Story 1: plain-data state across hooks\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\\\\\\\", async () => {\\\\n    const connector = createConnector({\\\\n      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\\\\n      registryPath: store.registryPath,\\\\n      newThreadFilePath: () => store.threadPath(),\\\\n      parseLaunch: () => ({}), // no flag → new thread\\\\n    });\\\\n\\\\n    // session_start with a ctx carrying methods.\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/a\\\\\\\"), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    expect(connector.getState()).not.toBeNull();\\\\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\\\\n    // ...but the snapshot is plain data only — it survives structuredClone even\\\\n    // though the live ctx and instance carry methods (they are not in it).\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    const threadRefBefore = connector.getState()?.threadRef;\\\\n\\\\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\\\n    // holder still references no prior ctx.\\\\n    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"ctx-2\\\\\\\", \\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n  });\\\\n});\\\\n\\\",\\\"structuredPatch\\\":[{\\\"oldStart\\\":231,\\\"oldLines\\\":7,\\\"newStart\\\":231,\\\"newLines\\\":7,\\\"lines\\\":[\\\"     // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\\",\\\"     // holder still references no prior ctx.\\\",\\\"     await connector.handlers.message_end(\\\",\\\"-      syntheticCtx(\\\\\\\"ctx-2\\\\\\\", \\\\\\\"/work/a\\\\\\\"),\\\",\\\"+      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\",\\\"       makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\",\\\"     );\\\",\\\"     expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\"]}],\\\"userModified\\\":false,\\\"replaceAll\\\":false}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/003-implementor.stdout.log:3975:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\"\\\\\\\", \\\\\\\"old_string\\\\\\\": \\\\\\\"    await connector.handlers.message_end(\\\\\\\\n      syntheticCtx(\\\\\\\\\\\\\\\"/work/a\\\\\\\\\\\\\\\"),\\\\\\\\n      makeMessageEnd\\\"}},\\\"session_id\\\":\\\"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e\\\",\\\"parent_tool_use_id\\\":null,\\\"uuid\\\":\\\"ea5ac9f2-ba6a-4744-9fef-37f17d148c95\\\"}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/003-implementor.stdout.log:3978:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\"\\\\\\\", \\\\\\\"new_string\\\\\\\": \\\\\\\"    await connector.handlers.message_end(\\\\\\\\n      syntheticCtx(\\\\\\\\\\\\\\\"/work/a\\\\\\\\\\\\\\\"),\\\\\\\\n      makeMessageEnd(makeUserMessage\\\"}},\\\"session_id\\\":\\\"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e\\\",\\\"parent_tool_use_id\\\":null,\\\"uuid\\\":\\\"2734ea7d-103e-424f-af43-69c923620124\\\"}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/003-implementor.stdout.log:3995:{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-opus-4-8\\\",\\\"id\\\":\\\"msg_012EEQqTsurr3T1ubvNeQnj4\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"tool_use\\\",\\\"id\\\":\\\"toolu_0177er1Co7RhhP5h8MJAN8gZ\\\",\\\"name\\\":\\\"Edit\\\",\\\"input\\\":{\\\"replace_all\\\":false,\\\"file_path\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\\\",\\\"old_string\\\":\\\"    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n  });\\\\n});\\\",\\\"new_string\\\":\\\"    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"Story 1: reload reconstruction (connector wiring)\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\\\\\\\", async () => {\\\\n    // The launch is no-flag, which would create a NEW thread on every resolve.\\\\n    // The reload path must instead reattach the durable resolved id (AC-1.5).\\\\n    const connector = createConnector({\\\\n      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\\\\n      registryPath: store.registryPath,\\\\n      newThreadFilePath: () => store.threadPath(),\\\\n      parseLaunch: () => ({}),\\\\n    });\\\\n\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    const firstRef = connector.getState()?.threadRef;\\\\n    const firstId = firstRef !== undefined && \\\\\\\"threadId\\\\\\\" in firstRef ? firstRef.threadId : null;\\\\n    expect(firstId).not.toBeNull();\\\\n    const countAfterNew = await threadCount();\\\\n\\\\n    // /reload fires shutdown{reload} then session_start{reload} on the same\\\\n    // session — the connector disposes, then reconstructs the SAME thread.\\\\n    await connector.handlers.session_shutdown(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), { reason: \\\\\\\"reload\\\\\\\" });\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), makeSessionStart(\\\\\\\"reload\\\\\\\"));\\\\n\\\\n    const reloadedRef = connector.getState()?.threadRef;\\\\n    const reloadedId =\\\\n      reloadedRef !== undefined && \\\\\\\"threadId\\\\\\\" in reloadedRef ? reloadedRef.threadId : null;\\\\n    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\\\\n    expect(connector.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\\\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\\\n  });\\\\n});\\\"},\\\"caller\\\":{\\\"type\\\":\\\"direct\\\"}}],\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":2,\\\"cache_creation_input_tokens\\\":429,\\\"cache_read_input_tokens\\\":308933,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":0,\\\"ephemeral_1h_input_tokens\\\":429},\\\"output_tokens\\\":4,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"not_available\\\"},\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e\\\",\\\"uuid\\\":\\\"4204e5d6-cd7c-4ec0-98f2-4de121d7acbe\\\",\\\"request_id\\\":\\\"req_011Cc2XrfRNg2V2KmR3rvwYk\\\"}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/003-implementor.stdout.log:3998:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_0177er1Co7RhhP5h8MJAN8gZ\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e\\\",\\\"uuid\\\":\\\"4516b7fd-36d9-440f-b094-c34eb4d63174\\\",\\\"timestamp\\\":\\\"2026-06-14T04:38:07.238Z\\\",\\\"tool_use_result\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\\\",\\\"oldString\\\":\\\"    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n  });\\\\n});\\\",\\\"newString\\\":\\\"    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"Story 1: reload reconstruction (connector wiring)\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\\\\\\\", async () => {\\\\n    // The launch is no-flag, which would create a NEW thread on every resolve.\\\\n    // The reload path must instead reattach the durable resolved id (AC-1.5).\\\\n    const connector = createConnector({\\\\n      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\\\\n      registryPath: store.registryPath,\\\\n      newThreadFilePath: () => store.threadPath(),\\\\n      parseLaunch: () => ({}),\\\\n    });\\\\n\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    const firstRef = connector.getState()?.threadRef;\\\\n    const firstId = firstRef !== undefined && \\\\\\\"threadId\\\\\\\" in firstRef ? firstRef.threadId : null;\\\\n    expect(firstId).not.toBeNull();\\\\n    const countAfterNew = await threadCount();\\\\n\\\\n    // /reload fires shutdown{reload} then session_start{reload} on the same\\\\n    // session — the connector disposes, then reconstructs the SAME thread.\\\\n    await connector.handlers.session_shutdown(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), { reason: \\\\\\\"reload\\\\\\\" });\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), makeSessionStart(\\\\\\\"reload\\\\\\\"));\\\\n\\\\n    const reloadedRef = connector.getState()?.threadRef;\\\\n    const reloadedId =\\\\n      reloadedRef !== undefined && \\\\\\\"threadId\\\\\\\" in reloadedRef ? reloadedRef.threadId : null;\\\\n    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\\\\n    expect(connector.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\\\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\\\n  });\\\\n});\\\",\\\"originalFile\\\":\\\"// Story 1 — launch-driven thread resolution, plain-data state, and reload\\\\n// reconstruction (TC-1.2, 1.3, 1.5, 1.6, 1.7 + the restart architecture-risk\\\\n// test). Resolution and the picker are exercised directly against a real temp\\\\n// registry; the plain-data rule and reload are exercised through the connector.\\\\nimport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\nimport {\\\\n  createDeterministicProvider,\\\\n  inspect,\\\\n  threads,\\\\n  type OpResult,\\\\n  type SdkConfig,\\\\n  type ThreadRef,\\\\n} from \\\\\\\"lhc\\\\\\\";\\\\nimport { createConnector } from \\\\\\\"../../src/index.js\\\\\\\";\\\\nimport { disposeInstance, initInstance } from \\\\\\\"../../src/lifecycle/instance.js\\\\\\\";\\\\nimport { resolveThread, type ResolveDeps } from \\\\\\\"../../src/lifecycle/thread-resolution.js\\\\\\\";\\\\nimport { pickThread, type ThreadChoice } from \\\\\\\"../../src/lifecycle/picker.js\\\\\\\";\\\\nimport type { ExtensionContext } from \\\\\\\"../../src/pi/types.js\\\\\\\";\\\\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\\\\\"../fixtures/synthetic.js\\\\\\\";\\\\nimport { tempStore, type TempStore } from \\\\\\\"../fixtures/thread.js\\\\\\\";\\\\n\\\\nlet store: TempStore;\\\\nbeforeEach(() => {\\\\n  store = tempStore();\\\\n});\\\\nafterEach(() => {\\\\n  store.cleanup();\\\\n});\\\\n\\\\nfunction backgroundConfig(): SdkConfig {\\\\n  return { provider: createDeterministicProvider(), mode: \\\\\\\"background\\\\\\\" };\\\\n}\\\\n\\\\nfunction idOf(ref: ThreadRef): string {\\\\n  if (!(\\\\\\\"threadId\\\\\\\" in ref)) throw new Error(\\\\\\\"expected a { threadId } ref\\\\\\\");\\\\n  return ref.threadId;\\\\n}\\\\n\\\\nfunction deps(cwd = \\\\\\\"/work/default\\\\\\\"): ResolveDeps {\\\\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\\\n}\\\\n\\\\n// Create a thread directly with cwd/title so the picker test can assert both —\\\\n// new threads created by the connector carry a cwd but no title yet (title\\\\n// derivation is the deferred TDQ Q4).\\\\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\\\\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\\\\n    filePath: store.threadPath(),\\\\n    registryPath: store.registryPath,\\\\n  };\\\\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\\\n  if (opts.title !== undefined) input.title = opts.title;\\\\n  const created = await threads.newThread(input);\\\\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\\\\n  return created.value.threadId;\\\\n}\\\\n\\\\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\\\\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\\\\n// object, modelling PI handing a fresh ctx to each hook.\\\\nfunction syntheticCtx(cwd: string): ExtensionContext {\\\\n  return {\\\\n    cwd,\\\\n    hasUI: false,\\\\n    modelRegistry: {\\\\n      find: () => undefined,\\\\n      hasConfiguredAuth: () => false,\\\\n      getAvailable: () => [],\\\\n    },\\\\n    ui: { notify: () => {} },\\\\n    sessionManager: { getEntries: () => [] },\\\\n  };\\\\n}\\\\n\\\\nasync function threadCount(): Promise<number> {\\\\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\\\\n  return listed.ok ? listed.value.length : -1;\\\\n}\\\\n\\\\ndescribe(\\\\\\\"Story 1: launch-driven thread resolution\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.2: --session resolves an existing thread and creates no second thread\\\\\\\", async () => {\\\\n    const existingId = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"existing\\\\\\\" });\\\\n    const before = await threadCount();\\\\n\\\\n    const resolved = await resolveThread({ session: existingId }, deps());\\\\n    expect(resolved.ok).toBe(true);\\\\n    if (resolved.ok) expect(idOf(resolved.value)).toBe(existingId);\\\\n\\\\n    expect(await threadCount()).toBe(before); // no second thread\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\\\\\\\", async () => {\\\\n    // no flag → a new thread\\\\n    const first = await resolveThread({}, deps());\\\\n    expect(first.ok).toBe(true);\\\\n    if (!first.ok) return;\\\\n    const firstId = idOf(first.value);\\\\n\\\\n    // --session full id → the same thread\\\\n    const byFull = await resolveThread({ session: firstId }, deps());\\\\n    expect(byFull.ok).toBe(true);\\\\n    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\\\\n\\\\n    // --session partial id → the same thread\\\\n    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\\\\n    expect(byPartial.ok).toBe(true);\\\\n    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\\\\n\\\\n    // a second thread, then --continue → the most recently created\\\\n    const second = await resolveThread({}, deps());\\\\n    expect(second.ok).toBe(true);\\\\n    if (!second.ok) return;\\\\n    const secondId = idOf(second.value);\\\\n    const continued = await resolveThread({ continue: true }, deps());\\\\n    expect(continued.ok).toBe(true);\\\\n    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\\\\n\\\\n    // unresolvable id → actionable error, no thread created\\\\n    const before = await threadCount();\\\\n    const bad = await resolveThread({ session: \\\\\\\"th_zzzzzzzzzzzzzzzz\\\\\\\" }, deps());\\\\n    expect(bad.ok).toBe(false);\\\\n    if (!bad.ok) expect(bad.error.code).toBe(\\\\\\\"thread_not_found\\\\\\\");\\\\n    expect(await threadCount()).toBe(before);\\\\n\\\\n    // ambiguous prefix (matches both threads) → actionable error, no thread created\\\\n    const ambiguous = await resolveThread({ session: \\\\\\\"th_\\\\\\\" }, deps());\\\\n    expect(ambiguous.ok).toBe(false);\\\\n    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\\\\\\\"ambiguous_thread_id\\\\\\\");\\\\n    expect(await threadCount()).toBe(before);\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.7: --resume lists cwd-scoped threads (title + created), resolves selection, empty-safe\\\\\\\", async () => {\\\\n    const a1 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"alpha\\\\\\\" });\\\\n    const a2 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"beta\\\\\\\" });\\\\n    await makeThread({ cwd: \\\\\\\"/work/b\\\\\\\", title: \\\\\\\"other-cwd\\\\\\\" });\\\\n\\\\n    let offered: readonly ThreadChoice[] = [];\\\\n    const picked = await pickThread(\\\\\\\"/work/a\\\\\\\", {\\\\n      registryPath: store.registryPath,\\\\n      select: (choices) => {\\\\n        offered = choices;\\\\n        return Promise.resolve(choices[0]!.threadId);\\\\n      },\\\\n    });\\\\n    expect(picked.ok).toBe(true);\\\\n\\\\n    // Only the current cwd's threads are offered, each with title + creation time.\\\\n    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\\\\n    for (const choice of offered) {\\\\n      expect(choice.createdAt).toBeTruthy();\\\\n      expect(choice.title).toBeTruthy();\\\\n    }\\\\n\\\\n    // The operator's selection resolves to that thread.\\\\n    if (picked.ok && picked.value !== null) {\\\\n      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\\\\n    }\\\\n\\\\n    // An empty cwd reports an empty list (null) without failing or prompting.\\\\n    let selectCalled = false;\\\\n    const empty = await pickThread(\\\\\\\"/work/empty\\\\\\\", {\\\\n      registryPath: store.registryPath,\\\\n      select: () => {\\\\n        selectCalled = true;\\\\n        return Promise.resolve(null);\\\\n      },\\\\n    });\\\\n    expect(empty.ok).toBe(true);\\\\n    if (empty.ok) expect(empty.value).toBeNull();\\\\n    expect(selectCalled).toBe(false);\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.5 (risk: restart): reattach reconstructs the thread from its durable id after the holder is discarded\\\\\\\", async () => {\\\\n    const cwd = \\\\\\\"/work/tc-1-5\\\\\\\";\\\\n    // Create + capture on a thread.\\\\n    const created = await resolveThread({}, deps(cwd));\\\\n    expect(created.ok).toBe(true);\\\\n    if (!created.ok) return;\\\\n    const threadId = idOf(created.value);\\\\n\\\\n    const first = await initInstance(created.value, backgroundConfig());\\\\n    expect(first.ok).toBe(true);\\\\n    if (!first.ok) return;\\\\n    await first.value.sdk.intakeStream.messageEvents(\\\\n      first.value.threadRef,\\\\n      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n    );\\\\n    await disposeInstance(first.value);\\\\n\\\\n    // Discard ALL in-memory state. Only the durable id survives (as it would in\\\\n    // the registry across process death). Reconstruct purely from it — no\\\\n    // retained object.\\\\n    const reattached = await resolveThread({ session: threadId }, deps(cwd));\\\\n    expect(reattached.ok).toBe(true);\\\\n    if (!reattached.ok) return;\\\\n    expect(idOf(reattached.value)).toBe(threadId); // the same thread, by id\\\\n\\\\n    const rebuilt = await initInstance(reattached.value, backgroundConfig());\\\\n    expect(rebuilt.ok).toBe(true);\\\\n    if (!rebuilt.ok) return;\\\\n    // Capture continues on the same thread: append more, all events present.\\\\n    await rebuilt.value.sdk.intakeStream.messageEvents(\\\\n      rebuilt.value.threadRef,\\\\n      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n    );\\\\n    const overview = await inspect.overview(reattached.value);\\\\n    expect(overview.ok).toBe(true);\\\\n    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\\\\n    await disposeInstance(rebuilt.value);\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"Story 1: plain-data state across hooks\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\\\\\\\", async () => {\\\\n    const connector = createConnector({\\\\n      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\\\\n      registryPath: store.registryPath,\\\\n      newThreadFilePath: () => store.threadPath(),\\\\n      parseLaunch: () => ({}), // no flag → new thread\\\\n    });\\\\n\\\\n    // session_start with a ctx carrying methods.\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/a\\\\\\\"), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    expect(connector.getState()).not.toBeNull();\\\\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\\\\n    // ...but the snapshot is plain data only — it survives structuredClone even\\\\n    // though the live ctx and instance carry methods (they are not in it).\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    const threadRefBefore = connector.getState()?.threadRef;\\\\n\\\\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\\\n    // holder still references no prior ctx.\\\\n    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n  });\\\\n});\\\\n\\\",\\\"structuredPatch\\\":[{\\\"oldStart\\\":238,\\\"oldLines\\\":3,\\\"newStart\\\":238,\\\"newLines\\\":34,\\\"lines\\\":[\\\"     expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\",\\\"   });\\\",\\\" });\\\",\\\"+\\\",\\\"+describe(\\\\\\\"Story 1: reload reconstruction (connector wiring)\\\\\\\", () => {\\\",\\\"+  it(\\\\\\\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\\\\\\\", async () => {\\\",\\\"+    // The launch is no-flag, which would create a NEW thread on every resolve.\\\",\\\"+    // The reload path must instead reattach the durable resolved id (AC-1.5).\\\",\\\"+    const connector = createConnector({\\\",\\\"+      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\\\",\\\"+      registryPath: store.registryPath,\\\",\\\"+      newThreadFilePath: () => store.threadPath(),\\\",\\\"+      parseLaunch: () => ({}),\\\",\\\"+    });\\\",\\\"+\\\",\\\"+    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\",\\\"+    const firstRef = connector.getState()?.threadRef;\\\",\\\"+    const firstId = firstRef !== undefined && \\\\\\\"threadId\\\\\\\" in firstRef ? firstRef.threadId : null;\\\",\\\"+    expect(firstId).not.toBeNull();\\\",\\\"+    const countAfterNew = await threadCount();\\\",\\\"+\\\",\\\"+    // /reload fires shutdown{reload} then session_start{reload} on the same\\\",\\\"+    // session — the connector disposes, then reconstructs the SAME thread.\\\",\\\"+    await connector.handlers.session_shutdown(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), { reason: \\\\\\\"reload\\\\\\\" });\\\",\\\"+    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/reload\\\\\\\"), makeSessionStart(\\\\\\\"reload\\\\\\\"));\\\",\\\"+\\\",\\\"+    const reloadedRef = connector.getState()?.threadRef;\\\",\\\"+    const reloadedId =\\\",\\\"+      reloadedRef !== undefined && \\\\\\\"threadId\\\\\\\" in reloadedRef ? reloadedRef.threadId : null;\\\",\\\"+    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\\\",\\\"+    expect(connector.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\\",\\\"+    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\\",\\\"+  });\\\",\\\"+});\\\"]}],\\\"userModified\\\":false,\\\"replaceAll\\\":false}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:39:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01RyR6Ph8BWrFyfr6AWfs8BB\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t# Epic 1: Connector Core — Tech Design\\\\n2\\\\t\\\\n3\\\\t**Status:** Draft for review\\\\n4\\\\t**Epic:** `epic.md`\\\\n5\\\\t**PRD:** `../00-prd.md` — Feature 1\\\\n6\\\\t**Tech Arch:** `../01-tech-arch.md`\\\\n7\\\\t**Wiring research:** `../notes/pi-ext-integration-research.md` (verified against PI v0.79.2)\\\\n8\\\\t**Test plan:** `test-plan.md`\\\\n9\\\\t\\\\n10\\\\t---\\\\n11\\\\t\\\\n12\\\\t## Spec Validation\\\\n13\\\\t\\\\n14\\\\tThe epic is implementable as written once its named M0 inputs land. Every AC maps to a module and a test; the data contracts match the real surfaces the design calls into (the LHC SDK at `packages/lhc`, the PI extension API at `@earendil-works/pi-coding-agent` v0.79.2, the completion API at `@earendil-works/pi-ai`). The tech-design questions are answered below, and the places where the design takes a position the epic left open are recorded as deviations with rationale.\\\\n15\\\\t\\\\n16\\\\tThe validation that mattered most: the epic's load-bearing claim is that an LHC turn is not a PI turn, and the converter must derive LHC turn boundaries from the agent-run bracket rather than from PI's per-step `turn_end`. The real PI event types confirm the shape the epic relies on — `turn_end` carries a per-agent-run `turnIndex` that resets to 0 each run, and `agent_end` brackets the whole run — so the contract is buildable against types that exist, not against an assumption.\\\\n17\\\\t\\\\n18\\\\t### Issues Found\\\\n19\\\\t\\\\n20\\\\t| # | Type | Issue | Resolution |\\\\n21\\\\t|---|------|-------|------------|\\\\n22\\\\t| I-1 | TDQ-1 (dissolved) | Mapping persistence shape (session file vs sidecar vs both). | **Dissolved — the thread is resolved at launch, not from a stored mapping.** The LHC thread is the system of record and the registry is the catalog; the thread for a run is named by the launch (new / `--session` / `--continue` / `--resume` picker), so there is no PI-session→thread mapping to persist, no early-crash window, and no recovery sidecar. The tech-lead's durability finding is moot: there is no pointer to lose. (PI's own session file still exists in this observe-only epic — PI runs its session normally; it just is not where LHC's thread identity lives.) See Flow 1. |\\\\n23\\\\t| I-2 | TDQ-2 | Fork derived-form reuse — provable-safe copy vs always-requeue. | **Resolved for v1: always requeue.** The new thread is seeded by event replay only; derived forms are not copied across the fork. Reuse is a later optimization gated on a provenance-identity check that does not exist yet. The epic's AC-3.3 permits this (reuse \\\\\\\"may\\\\\\\" happen; requeue is the correct fallback). Recorded as a deviation — the epic leaves the door open, the design closes it for v1. See Deferred Items. |\\\\n24\\\\t| I-3 | TDQ-3 | `thinkingSignature` / `thoughtSignature` handling. | **Resolved: capture, do not interpret.** Assistant thinking carries an opaque `thinkingSignature`; tool calls carry an opaque `thoughtSignature` (the POC mapper found both). Neither is part of the seven LHC intake payloads, which are text/structured-arg only. The converter records thinking text and tool-call arguments; the signatures are dropped in this epic because nothing in capture or derivation consumes them. Flagged as a deviation: re-injecting signatures is a serving concern (Epic 2), not capture. |\\\\n25\\\\t| I-4 | TDQ-4 (dissolved) | Thread resolution by external key. | **Dissolved.** Resolution is by the launch input (full/partial `threadId`, or a picker selection over `listThreads`), through `threads.resolve` / `threads.resolveThreadRef`. There is no external PI-session key to translate, because the operator names the thread at launch. |\\\\n26\\\\t| I-7 | API mismatch (tech-lead #1) | `appendEntry` is on `pi: ExtensionAPI`, not `ctx: ExtensionContext`. | **Moot for mapping, noted for capture.** The mapping no longer writes a session-file pointer, so the `appendEntry` mismatch in the old `session-mapping` is gone. Where the connector does need registration-time API (hook registration), it takes `pi: ExtensionAPI` at the factory, and per-hook handlers take `ctx`. Interface signatures take `pi` where an `ExtensionAPI` method is needed, `ctx` otherwise. |\\\\n27\\\\t| I-8 | API mismatch (tech-lead #3) | `registryPath` is not a field of `SdkConfig`. | **Resolved.** `registryPath` is removed from `initLhc`/`createSdk` construction. It is a per-operation argument on the `threads` calls (`newThread`, `resolve`, `listThreads`), which is where the real LHC API accepts it. `initLhc` is the rename of `createSdk` and takes `SdkConfig` unchanged. |\\\\n28\\\\t| I-9 | Wording (tech-lead #5) | \\\\\\\"no `ctx.ui` surface\\\\\\\" — `ExtensionContext.ui` always exists. | **Resolved.** Reporting guards on headless mode (`hasUI:false`), not on the absence of `ctx.ui`. Test and prose wording corrected. |\\\\n29\\\\t| I-10 | Gap fill | Runtime metadata: model/thinking changes, cwd, foreign-extension state. | **Resolved per epic A-8/A-9.** Model-select and thinking-level-select are captured as `runtime_note` events (AC-2.8, in-stream-only). cwd is stored on the registry row at thread creation and scopes the `--resume` picker. The full PI-runtime-state restoration inventory is an Epic 2 prerequisite (tech arch). Foreign-extension session persistence is out of scope v1 (epic A-9). |\\\\n30\\\\t| I-5 | TDQ-5 | Converter structure — how it consumes `message_end` and emits batched `MessageEventInput[]`. | **Resolved.** The converter is two pure stages plus one stateful accumulator: `mapMessage` (one PI `AgentMessage` → ordered `MessageEventInput[]`, no I/O) and `deriveTurnClose` (decides when to emit `turn_end`), driven by a per-session `TurnAccumulator` that tracks the open LHC turn across `message_end`/`agent_end`. Batches flush through `intakeStream.messageEvents(threadRef, events)`. See Flow 2 design. |\\\\n31\\\\t| I-6 | Deviation | Epic A-7 names image/file-reference handling an M0 decision. | **Design position pending M0, with a safe fallback specified.** The current LHC intake schema has no image/file payload kind beyond text/runtime-note material. Until M0 chooses placeholder vs. schema extension, unsupported content parts degrade to a `runtime_note` event recording the omission (never silent drop). If M0 extends the intake schema, the converter gains kinds; the degrade-to-`runtime_note` path remains the fallback for unsupported parts. This unblocks implementation planning without pre-empting the M0 call. |\\\\n32\\\\t\\\\n33\\\\t---\\\\n34\\\\t\\\\n35\\\\t## Context\\\\n36\\\\t\\\\n37\\\\tThis epic builds the first real consumer of the LHC SDK. Until now LHC has been exercised by its own test harness and a deterministic provider; here it gets wired to a live coding agent whose event stream it does not control. The whole epic is observe-only by deliberate construction — the extension records everything PI does and changes nothing the model sees — because that constraint is what lets capture correctness be proven before any context-serving risk is introduced. PI's native context handling stays in charge throughout. The reward for the discipline is that every test in this epic asserts on recorded thread state, never on what a model received.\\\\n38\\\\t\\\\n39\\\\tThe shape of the work is set by two systems that already exist and are not being changed. PI fires lifecycle hooks (`session_start`, `message_end`, `turn_end`, `agent_end`, `session_shutdown`, fork/switch) and an extension subscribes to them; this is a fixed, versioned contract verified against v0.79.2 by live recon. The LHC SDK is constructed once per session (`initLhc`, the agreed rename of the current `createSdk`), exposes operation surfaces (`intakeStream`, `threads`, `inspect`, the background work scheduler), and persists one SQLite file per thread. The connector is the tissue between them: it translates PI's events into LHC intake operations, and translates LHC's need for inference back into PI's authenticated model registry. It owns no context state of its own beyond a thread reference and a few told-the-user flags, because PI tears down and replaces its session objects on every new/resume/fork transition, and a cached reference to one of those objects is a latent crash.\\\\n40\\\\t\\\\n41\\\\tThree forces shaped the central decisions. First, **PI's turn is not LHC's turn** — PI brackets each agent step with `turn_start`/`turn_end` and resets `turnIndex` to 0 per agent run, while an LHC turn spans a whole exchange. The converter must derive LHC turn boundaries from the agent-run bracket (`agent_end`), and the recon that established this is the reason the epic could be written without guessing. Second, **capture must never break the session** — malformed input on a writable thread degrades to a recorded, queryable gap; store-unavailable failures degrade to extension-level health diagnostics; neither throws back into a PI hook. Third, **derivations must close the loop on the user's own logins** — LHC asks for completions through a single host-supplied function that resolves provider/model through PI's registry, so there is no second credential store and no separate login.\\\\n42\\\\t\\\\n43\\\\tOne framing decision underlies the whole lifecycle: **the LHC thread is the system of record for the conversation, and the registry is the catalog.** The thread for a run is resolved at launch from the operator's choice (a new thread, the `--resume` picker, `--continue`, or a named `--session` id), the same way PI's own launch flags work. This dissolves what an earlier draft treated as a hard problem — keeping a PI-session→thread mapping durable across an early crash — because the launch choice *is* the thread identity, so there is nothing to recover. A scoping note that matters for the rest of this design: this epic is observe-only, so **PI still runs its own session** — it persists its session, serves its own context to the model, and tracks its own fork tree. LHC records alongside as the durable record. PI's session file becomes vestigial in Feature 2, when LHC's served context replaces PI's transcript; in Epic 1 the two coexist.\\\\n44\\\\t\\\\n45\\\\tThe connector also inherits a body of prior art. A POC extension (`src/context-steward/pi/`, ~3,900 lines across the mapper, the parallel-event intake, and the extension shell) already solved much of the hard mapping — idempotency-key construction, parallel-tool correlation, unsupported-part degradation — against an older LHC storage API. This epic productionizes that logic against the current, leaner SDK surface (plain-string `actor`/`harness`, per-event `idempotencyKey`, the seven-kind `MessageEventInput` union), so the converter is a rewrite informed by the POC, not a port of it. The POC's stale-context handling, by contrast, dies here: the tech arch's plain-data-only rule replaces it.\\\\n46\\\\t\\\\n47\\\\t---\\\\n48\\\\t\\\\n49\\\\t## System View\\\\n50\\\\t\\\\n51\\\\tAt the highest altitude the connector sits between two systems it does not own and one durable store it drives. PI is upstream — it produces the event stream and owns provider auth. The LHC SDK is the engine — it owns capture, projection, derivation scheduling, and persistence. The thread's SQLite file is the durable record that survives the process. The connector is the only component that speaks both PI's hook vocabulary and LHC's operation vocabulary, and it is the only place the PI-session-id ↔ LHC-thread-id translation lives.\\\\n52\\\\t\\\\n53\\\\t```mermaid\\\\n54\\\\tflowchart LR\\\\n55\\\\t  subgraph PI[\\\\\\\"PI process\\\\\\\"]\\\\n56\\\\t    H[\\\\\\\"hook surface\\\\\\\\nsession_start, message_end,\\\\\\\\nturn_end, agent_end, shutdown, fork\\\\\\\"]\\\\n57\\\\t    MR[\\\\\\\"modelRegistry + auth\\\\\\\"]\\\\n58\\\\t  end\\\\n59\\\\t  subgraph EXT[\\\\\\\"pi-lhc extension (in-process)\\\\\\\"]\\\\n60\\\\t    L[\\\\\\\"lifecycle\\\\\\\"]\\\\n61\\\\t    C[\\\\\\\"converter\\\\\\\"]\\\\n62\\\\t    I[\\\\\\\"inference host\\\\\\\"]\\\\n63\\\\t    V[\\\\\\\"startup validation\\\\\\\"]\\\\n64\\\\t  end\\\\n65\\\\t  subgraph LHC[\\\\\\\"LHC SDK (in-process)\\\\\\\"]\\\\n66\\\\t    IS[\\\\\\\"intakeStream\\\\\\\"]\\\\n67\\\\t    TH[\\\\\\\"threads\\\\\\\"]\\\\n68\\\\t    SCH[\\\\\\\"background scheduler\\\\\\\"]\\\\n69\\\\t    INS[\\\\\\\"inspect\\\\\\\"]\\\\n70\\\\t    DB[(\\\\\\\"thread.sqlite\\\\\\\")]\\\\n71\\\\t  end\\\\n72\\\\t  H --> L\\\\n73\\\\t  H --> C\\\\n74\\\\t  C --> IS\\\\n75\\\\t  L --> TH\\\\n76\\\\t  IS --> DB\\\\n77\\\\t  TH --> DB\\\\n78\\\\t  SCH --> I\\\\n79\\\\t  I --> MR\\\\n80\\\\t  V --> MR\\\\n81\\\\t  INS --> DB\\\\n82\\\\t```\\\\n83\\\\t\\\\n84\\\\tThe boundaries that matter for testing are the two edges the connector does not own: the **PI hook surface** (events arrive; the design feeds them from recorded corpora and synthetic builders) and the **`ModelCall` function** as it reaches PI's `modelRegistry` + `complete` (the design supplies a deterministic fake). Everything inside the LHC box runs real against a temp SQLite file, because persistence, reattach, replay, and fork are the product contract — mocking the store would prove nothing about the behaviors this epic exists to guarantee.\\\\n85\\\\t\\\\n86\\\\t### External Contracts\\\\n87\\\\t\\\\n88\\\\t**Incoming — PI hooks consumed** (shapes verified against `@earendil-works/pi-coding-agent` v0.79.2):\\\\n89\\\\t\\\\n90\\\\t| Hook | Payload (relevant fields) | Connector use |\\\\n91\\\\t|------|---------------------------|---------------|\\\\n92\\\\t| `session_start` | `reason: \\\\\\\"startup\\\\\\\"\\\\\\\\|\\\\\\\"reload\\\\\\\"\\\\\\\\|\\\\\\\"new\\\\\\\"\\\\\\\\|\\\\\\\"resume\\\\\\\"\\\\\\\\|\\\\\\\"fork\\\\\\\"`, `previousSessionFile?` | Resolve or create the thread; reattach; trigger startup validation |\\\\n93\\\\t| `message_end` | `message: AgentMessage` (user / assistant / toolResult) | Map to `MessageEventInput[]`, batch into intake |\\\\n94\\\\t| `turn_end` | `turnIndex` (per-agent-run), `message`, `toolResults[]`, `stopReason` | Update accumulator; **never** a 1:1 LHC `turn_end` |\\\\n95\\\\t| `agent_end` | the agent run's messages | Close the open LHC turn — emit one LHC `turn_end` |\\\\n96\\\\t| `model_select` | `model`, `previousModel`, `source` | Capture as a `runtime_note` event (AC-2.8) |\\\\n97\\\\t| `thinking_level_select` | `level`, `previousLevel` | Capture as a `runtime_note` event (AC-2.8) |\\\\n98\\\\t| `session_before_fork` | `entryId`, `position` | Capture the fork point for replay-seeding |\\\\n99\\\\t| `session_before_switch` | switch intent (`new`/`resume`) | Flush + dispose before the swap |\\\\n100\\\\t| `session_shutdown` | `reason`, `targetSessionFile?` | Dispose the instance with flush |\\\\n101\\\\t\\\\n102\\\\t**Outgoing — LHC SDK operations called** (shapes from `packages/lhc/src`):\\\\n103\\\\t\\\\n104\\\\t| Surface | Operation | Used for |\\\\n105\\\\t|---------|-----------|----------|\\\\n106\\\\t| construction | `initLhc(config: SdkConfig)` — `{ inference, mode: \\\\\\\"background\\\\\\\", view, ... }`; `registryPath` is **not** a construction field | One instance per session |\\\\n107\\\\t| `threads` | `newThread({ filePath, title?, cwd?, registryPath? })`, `resolve({ threadId, registryPath? })`, `listThreads({ cwd?, registryPath? })`, `resolveThreadRef`, `info` | Launch resolution: create / pick / continue / named |\\\\n108\\\\t| `intakeStream` | `messageEvents(threadRef, MessageEventInput[])` → `BatchResult` | Record capture; dedup by idempotency key |\\\\n109\\\\t| scheduler | `mode: \\\\\\\"background\\\\\\\"` (auto-drain), `drainSettled(ref)` | Derivations run; awaited only in the closed-loop test |\\\\n110\\\\t| `inspect` | overview / health reads | Capture verification, gap/failure surfacing |\\\\n111\\\\t\\\\n112\\\\t**Outgoing — inference, through PI:** the host-supplied `ModelCall` resolves `(provider, model)` via `ctx.modelRegistry.find(provider, model)` and completes via `complete(model, context, options)` from `@earendil-works/pi-ai`, returning `Promise<AssistantMessage>`.\\\\n113\\\\t\\\\n114\\\\t**Error contract** (machine-readable, what callers program against):\\\\n115\\\\t\\\\n116\\\\t| Source | Condition | Shape the connector produces |\\\\n117\\\\t|--------|-----------|------------------------------|\\\\n118\\\\t| Capture | malformed/unmappable event, thread writable | `OpResult` error recorded as a thread gap, surfaced in `inspect` health |\\\\n119\\\\t| Capture | thread store unavailable | extension diagnostic / health signal; no hook exception |\\\\n120\\\\t| ModelCall | auth / invalid request | `{ ok: false, kind: \\\\\\\"auth\\\\\\\" \\\\\\\\| \\\\\\\"invalid_request\\\\\\\" }` (terminal) |\\\\n121\\\\t| ModelCall | rate limit / timeout / network | `{ ok: false, kind: \\\\\\\"rate_limit\\\\\\\" \\\\\\\\| \\\\\\\"timeout\\\\\\\" \\\\\\\\| \\\\\\\"network\\\\\\\" }` (retryable) |\\\\n122\\\\t| ModelCall | thrown exception | `{ ok: false, kind: \\\\\\\"other\\\\\\\" }` |\\\\n123\\\\t| ModelCall adapter (LHC) | resolved but no text | `kind: \\\\\\\"empty_output\\\\\\\"` — generated by LHC's adapter, never returned by the host function |\\\\n124\\\\t\\\\n125\\\\t---\\\\n126\\\\t\\\\n127\\\\t## Module Boundaries\\\\n128\\\\t\\\\n129\\\\t### Top-Tier Surfaces\\\\n130\\\\t\\\\n131\\\\tThe tech arch names five top-tier surfaces for the whole `pi-lhc` extension. This epic touches three; the other two are out of scope and named so the boundary is explicit.\\\\n132\\\\t\\\\n133\\\\t| Surface | This epic | What lands here |\\\\n134\\\\t|---------|-----------|-----------------|\\\\n135\\\\t| Session Lifecycle | **Yes** | Instance construction/disposal, launch-driven thread resolution, reload re-resolution, fork detection |\\\\n136\\\\t| Event Capture | **Yes** | The converter (message mapping, turn derivation, batching, dedup), capture-failure isolation, capture verification |\\\\n137\\\\t| Inference Host | **Yes** | The `ModelCall` implementation, assignment config, startup validation |\\\\n138\\\\t| Context Serving | No (Epic 2) | The `context` hook and thread-view serving are not registered in this epic |\\\\n139\\\\t| Surfaces (operator/agent) | No (Epic 3) | Commands and self-inspection tools beyond what verification reads |\\\\n140\\\\t\\\\n141\\\\tAll modules below nest within one of the three active surfaces. The package is a fresh scaffold (`packages/pi-lhc/` currently holds only `package.json`), so every module is NEW; the only EXISTS dependencies are the `lhc` workspace package and the PI/pi-ai packages.\\\\n142\\\\t\\\\n143\\\\t### Module Architecture\\\\n144\\\\t\\\\n145\\\\t```\\\\n146\\\\tpackages/pi-lhc/\\\\n147\\\\t  src/\\\\n148\\\\t    index.ts                       NEW  extension entry — registers hooks, owns nothing else\\\\n149\\\\t    lifecycle/\\\\n150\\\\t      instance.ts                  NEW  initLhc construct/dispose; background mode\\\\n151\\\\t      thread-resolution.ts         NEW  launch flags → registry (new / --session / --continue / --resume); partial-id match\\\\n152\\\\t      picker.ts                    NEW  --resume cwd-scoped thread list + selection (thin pi-lhc UI)\\\\n153\\\\t      state.ts                     NEW  the plain-data-only holder { threadRef, flags, health } (no PI objects)\\\\n154\\\\t      fork.ts                      NEW  fork detection (session_before_fork hook; PI session tree as Epic-1 fallback) + replay seeding\\\\n155\\\\t    capture/\\\\n156\\\\t      converter.ts                 NEW  orchestrates map → accumulate → batch flush\\\\n157\\\\t      map-message.ts               NEW  pure: AgentMessage → MessageEventInput[]\\\\n158\\\\t      turn-accumulator.ts          NEW  open-turn state; deriveTurnClose\\\\n159\\\\t      idempotency.ts               NEW  pure: stable per-event key construction\\\\n160\\\\t    inference/\\\\n161\\\\t      model-call.ts                NEW  ModelCall over modelRegistry + complete; failure classification\\\\n162\\\\t      assignments.ts               NEW  config load + shape validation (the seven kinds)\\\\n163\\\\t      startup-validation.ts        NEW  registry existence + auth-availability probe; reporting (ctx.ui/headless)\\\\n164\\\\t    verify/\\\\n165\\\\t      replay.ts                    NEW  corpus → converter → thread; read-back compare (test-facing)\\\\n166\\\\t  test/\\\\n167\\\\t    fixtures/\\\\n168\\\\t      corpus.ts                    NEW  recorded-corpus loader (M0 fixtures)\\\\n169\\\\t      synthetic.ts                 NEW  synthetic AgentMessage / event builders\\\\n170\\\\t      model-call.ts                NEW  deterministic ModelCall fakes (text / each failure kind)\\\\n171\\\\t    ...                            NEW  per-chunk test files (see test-plan.md)\\\\n172\\\\t```\\\\n173\\\\t\\\\n174\\\\tThe two mock boundaries are explicit in the tree: `test/fixtures/corpus.ts` + `synthetic.ts` feed the PI hook edge, and `test/fixtures/model-call.ts` supplies the inference edge. No module under `src/` is mocked by another module under `src/` — the converter is tested through the capture entry point against a real temp thread, not in isolation with a mocked intake.\\\\n175\\\\t\\\\n176\\\\t### Module Responsibility Matrix\\\\n177\\\\t\\\\n178\\\\tThis is the rosetta stone: every AC has a home, and every module names the ACs it carries. If an AC is not here, it has no owner.\\\\n179\\\\t\\\\n180\\\\t| Module | Status | Responsibility | Depends on | ACs |\\\\n181\\\\t|--------|--------|----------------|-----------|-----|\\\\n182\\\\t| `index.ts` | NEW | Register hook handlers; route each hook to lifecycle/capture/inference; hold no state | all `src/` modules | (wiring) |\\\\n183\\\\t| `lifecycle/instance.ts` | NEW | `initLhc` in background mode on start; dispose with flush on shutdown; reconstruct on reload | `lhc` | AC-1.1, AC-1.4, AC-1.5 |\\\\n184\\\\t| `lifecycle/thread-resolution.ts` | NEW | Launch flags → registry resolution (new / `--session` full+partial / `--continue` most-recent); reload reconstructs from resolved id; unresolvable id fails loud | `lhc` threads | AC-1.2, AC-1.5, AC-1.6 |\\\\n185\\\\t| `lifecycle/picker.ts` | NEW | `--resume` cwd-scoped thread list (title + created) and selection | `lhc` threads (`listThreads`) | AC-1.7 |\\\\n186\\\\t| `lifecycle/state.ts` | NEW | Plain-data-only holder and extension diagnostics; never caches a PI context/session object across hooks | — | AC-1.3, AC-2.7 |\\\\n187\\\\t| `lifecycle/fork.ts` | NEW | Detect fork from `session_before_fork` hook (PI session tree as Epic-1 fallback); new thread; replay-seed to fork point; never write source | `lhc` threads, capture | AC-3.1, AC-3.2, AC-3.3 |\\\\n188\\\\t| `capture/converter.ts` | NEW | Orchestrate map→accumulate→batch; isolate capture failure to a gap/health signal | map-message, turn-accumulator, `lhc` intakeStream | AC-2.1, AC-2.7 |\\\\n189\\\\t| `capture/map-message.ts` | NEW | Pure map of one `AgentMessage` to ordered events; fan-out; parallel-tool correlation; error-result; abort; unsupported→runtime_note | idempotency | AC-2.1, AC-2.3, AC-2.4, AC-2.5 |\\\\n190\\\\t| `capture/turn-accumulator.ts` | NEW | Track the open LHC turn; emit exactly one `turn_end` at `agent_end`; ignore per-step PI `turn_end` | — | AC-2.2 |\\\\n191\\\\t| `capture/runtime-changes.ts` | NEW | Map `model_select` / `thinking_level_select` hooks to ordered `runtime_note` events (new + previous value) | `lhc` intakeStream | AC-2.8 |\\\\n192\\\\t| `capture/idempotency.ts` | NEW | Construct a stable key per event so re-delivery dedups | — | AC-2.6 |\\\\n193\\\\t| `inference/model-call.ts` | NEW | Resolve (provider,model) via registry; complete; classify failures; multi-lane | PI modelRegistry, pi-ai | AC-4.1, AC-4.2, AC-4.3, AC-4.4 |\\\\n194\\\\t| `inference/assignments.ts` | NEW | Load seven assignments from config; fail loud on missing/unknown/placeholder; override on next start | — | AC-5.4, AC-5.5 |\\\\n195\\\\t| `inference/startup-validation.ts` | NEW | Probe each assignment with `modelRegistry.find(provider, model)` for existence and `hasConfiguredAuth(model)` / `getAvailable()` membership for configured auth; report unknown and not-logged-in lanes through `ctx.ui`/headless diagnostics; leave capture running | PI modelRegistry | AC-5.1, AC-5.2, AC-5.3 |\\\\n196\\\\t| `verify/replay.ts` | NEW | Replay a corpus through the converter; compare read-back; deterministic | converter, `lhc` inspect | AC-6.1, AC-6.2 |\\\\n197\\\\t| (closed-loop, in `model-call` + scheduler) | NEW | Captured thread's queued derivation invokes the function and records an outcome | `lhc` scheduler, inspect | AC-4.5 |\\\\n198\\\\t| `inspect` reads (via `lhc`) | EXISTS | Surface counts, position, gaps, failures | `lhc` inspect | AC-6.3 |\\\\n199\\\\t\\\\n200\\\\t### Component Interaction\\\\n201\\\\t\\\\n202\\\\t```mermaid\\\\n203\\\\tsequenceDiagram\\\\n204\\\\t  participant PI\\\\n205\\\\t  participant IDX as index.ts\\\\n206\\\\t  participant LC as lifecycle\\\\n207\\\\t  participant CV as converter\\\\n208\\\\t  participant IS as lhc.intakeStream\\\\n209\\\\t  participant SCH as lhc scheduler\\\\n210\\\\t  participant MC as model-call\\\\n211\\\\t  PI->>IDX: session_start\\\\n212\\\\t  IDX->>LC: resolve/create thread, initLhc(background)\\\\n213\\\\t  PI->>IDX: message_end / turn_end / agent_end\\\\n214\\\\t  IDX->>CV: map + accumulate\\\\n215\\\\t  CV->>IS: messageEvents(threadRef, events)\\\\n216\\\\t  Note over SCH: background scheduler drains on its own\\\\n217\\\\t  SCH->>MC: ModelCall(provider, model, messages)\\\\n218\\\\t  MC->>PI: modelRegistry.find + complete\\\\n219\\\\t  PI->>IDX: session_shutdown\\\\n220\\\\t  IDX->>LC: dispose(flush)\\\\n221\\\\t```\\\\n222\\\\t\\\\n223\\\\t---\\\\n224\\\\t\\\\n225\\\\t## Flow-by-Flow Design\\\\n226\\\\t\\\\n227\\\\tEach flow below opens with the context that makes its mechanics make sense, then a sequence diagram annotated with the ACs it satisfies, then a skeleton-requirements table and the TC approaches. The depth is uneven on purpose: turn derivation, idempotency, reattach, the inference adapter, and fork-replay carry the design's risk and get the most room; thread creation and config loading are mechanical and get less.\\\\n228\\\\t\\\\n229\\\\t### Flow 1: Session Lifecycle and Launch-Driven Thread Resolution\\\\n230\\\\t\\\\n231\\\\tA session starts and the connector must answer one question before anything else: which thread does this run record into? The answer comes from the launch, not from a recovered pointer — the LHC thread is the system of record and the registry resolves it from the operator's choice. No thread-selecting flag means a new thread (registered with its cwd). `--session <id>` resolves a named thread by full or partial id. `--continue`/`-c` resolves the most recently created thread. `--resume`/`-r` lists the cwd's threads and resolves the operator's pick. The connector then constructs the LHC instance in background scheduler mode against the resolved thread; derivations drain on their own and the connector never drives the queue.\\\\n232\\\\t\\\\n233\\\\tBecause the thread id is an input to the run, there is nothing to keep durable across an early crash and no two records that can disagree — the failure mode an earlier draft tried to insure against (a session-file pointer lost before flush) does not exist. An unresolvable `--session` id is an error, reported actionably; it never silently creates a new thread.\\\\n234\\\\t\\\\n235\\\\tThe plain-data-only rule is enforced structurally here. The connector's only retained state is a `{ threadRef, flags }` holder. It never stores a PI `ctx` or session-manager object between hooks, because PI replaces those objects on new/resume/fork and a stale reference is a crash waiting for the next transition. Each handler uses the fresh `ctx` PI passes it.\\\\n236\\\\t\\\\n237\\\\t```mermaid\\\\n238\\\\tsequenceDiagram\\\\n239\\\\t  participant OP as operator (launch)\\\\n240\\\\t  participant LC as lifecycle\\\\n241\\\\t  participant TH as lhc.threads + registry\\\\n242\\\\t  OP->>LC: session_start (launch flags)\\\\n243\\\\t  alt no flag\\\\n244\\\\t    LC->>TH: newThread(filePath, cwd, title)\\\\n245\\\\t    Note over LC,TH: AC-1.1 new thread, background mode\\\\n246\\\\t  else --session id\\\\n247\\\\t    LC->>TH: resolve(id, partial match)\\\\n248\\\\t    Note over LC,TH: AC-1.6 named, fails loud if unresolvable\\\\n249\\\\t  else --continue\\\\n250\\\\t    LC->>TH: resolve most recent\\\\n251\\\\t  else --resume / -r\\\\n252\\\\t    LC->>TH: listThreads(cwd) — picker — resolve(id)\\\\n253\\\\t    Note over LC,TH: AC-1.7 cwd-scoped, titled\\\\n254\\\\t  end\\\\n255\\\\t  Note over LC: holds only threadRef and flags — AC-1.3\\\\n256\\\\t  OP->>LC: session_shutdown\\\\n257\\\\t  LC->>TH: dispose(flush)\\\\n258\\\\t  Note over LC: AC-1.4 complete through last event\\\\n259\\\\t```\\\\n260\\\\t\\\\n261\\\\t**Skeleton requirements:**\\\\n262\\\\t\\\\n263\\\\t| What | Where | Stub signature | Stub semantics |\\\\n264\\\\t|------|-------|----------------|----------------|\\\\n265\\\\t| Construct/dispose | `lifecycle/instance.ts` | `initInstance(threadRef, config): Promise<Instance>` / `dispose(): Promise<void>` | structured result; throws nothing into hook |\\\\n266\\\\t| Resolve thread from launch | `lifecycle/thread-resolution.ts` | `resolveThread(launch: LaunchFlags, pi: ExtensionAPI): Promise<OpResult<ThreadRef>>` | registry resolve/create by mode; partial-id match; loud on unresolvable; structured `OpResult` |\\\\n267\\\\t| Resume picker | `lifecycle/picker.ts` | `pickThread(cwd: string): Promise<OpResult<ThreadRef \\\\\\\\| null>>` | cwd-scoped `listThreads`; selection; `null` on empty |\\\\n268\\\\t| State holder | `lifecycle/state.ts` | `class SessionState { threadRef; flags }` | plain data; no PI refs |\\\\n269\\\\t\\\\n270\\\\tTC approaches (TC-1.1…TC-1.5) live in `test-plan.md`; each asserts on observable thread/mapping state through a real temp thread, with the lifecycle entry point driven by synthetic `session_start`/`shutdown` events. The reattach test (TC-1.5) reconstructs from the durable record after discarding the in-memory holder — the architecture-risk test for restart survival.\\\\n271\\\\t\\\\n272\\\\t### Flow 2: Event Capture and Turn Derivation\\\\n273\\\\t\\\\n274\\\\tThis is the densest flow and the one the epic was written to get right. Each finalized PI message becomes an ordered run of LHC intake events; the subtlety is entirely in turns. PI emits `turn_start`/`turn_end` per agent step and resets `turnIndex` to 0 at the start of each agent run, so an agent run that takes three steps emits three PI turns. An LHC turn is the whole exchange — the user prompt and every step the agent took until the next prompt. The converter therefore ignores PI's per-step `turn_end` as a boundary signal and closes the LHC turn at `agent_end`.\\\\n275\\\\t\\\\n276\\\\tThe converter is three pieces. `map-message.ts` is pure: it takes one `AgentMessage` and returns the ordered events for it — a user message becomes one `user_prompt`; an assistant message fans out to `assistant_thinking` (if present), then `assistant_text` (if present), then one `tool_call` per call, in that order; a tool result becomes one `tool_result` correlated to its call by `toolCallId`, carrying `isError` when the tool failed. `turn-accumulator.ts` holds the open-turn state and decides when to emit the single `turn_end`. `converter.ts` orchestrates, batches the events, and flushes them through `intakeStream.messageEvents`, isolating failures so writable-thread failures become recorded gaps and store-unavailable failures become extension diagnostics rather than thrown exceptions.\\\\n277\\\\t\\\\n278\\\\tA worked example anchors the contract. The user asks one question that triggers two parallel tool calls, then gets a final answer:\\\\n279\\\\t\\\\n280\\\\t```\\\\n281\\\\tPI emits:                              converter emits (one LHC turn):\\\\n282\\\\t  turn_start(0)                          user_prompt\\\\n283\\\\t  message_end(user [text])               assistant_thinking\\\\n284\\\\t  message_end(assistant                  tool_call (id=a)\\\\n285\\\\t    [thinking, toolCall a, toolCall b])  tool_call (id=b)\\\\n286\\\\t  message_end(toolResult b)              tool_result (id=b)\\\\n287\\\\t  message_end(toolResult a)              tool_result (id=a)\\\\n288\\\\t  turn_end(0)        <- ignored          assistant_text\\\\n289\\\\t  turn_start(1)                          turn_end          <- at agent_end\\\\n290\\\\t  message_end(assistant [text])\\\\n291\\\\t  turn_end(1)        <- ignored\\\\n292\\\\t  agent_end          <- closes turn\\\\n293\\\\t```\\\\n294\\\\t\\\\n295\\\\tThe two tool results arrive in the order `b` then `a`, and each correlates to its call by id, not by arrival order — the parallel-tool contract (AC-2.3). PI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` fires at `agent_end`. Session order derives from converter source-event order, never from `turnIndex`.\\\\n296\\\\t\\\\n297\\\\t```mermaid\\\\n298\\\\tsequenceDiagram\\\\n299\\\\t  participant PI\\\\n300\\\\t  participant CV as converter\\\\n301\\\\t  participant TA as turn-accumulator\\\\n302\\\\t  participant IS as lhc.intakeStream\\\\n303\\\\t  PI->>CV: message_end(user)\\\\n304\\\\t  CV->>TA: open turn\\\\n305\\\\t  CV->>IS: [user_prompt]\\\\n306\\\\t  Note over CV,IS: AC-2.1 ordered fan-out\\\\n307\\\\t  PI->>CV: message_end(assistant [thinking,toolCall×2])\\\\n308\\\\t  CV->>IS: [assistant_thinking, tool_call, tool_call]\\\\n309\\\\t  PI->>CV: message_end(toolResult) ×2 (out of order)\\\\n310\\\\t  CV->>IS: [tool_result, tool_result] correlated by id\\\\n311\\\\t  Note over CV,IS: AC-2.3 parallel correlation, AC-2.4 error flag\\\\n312\\\\t  PI->>CV: turn_end ×N\\\\n313\\\\t  Note over TA: ignored as boundary — AC-2.2\\\\n314\\\\t  PI->>CV: agent_end\\\\n315\\\\t  CV->>TA: close turn\\\\n316\\\\t  CV->>IS: [turn_end]\\\\n317\\\\t  Note over CV,IS: AC-2.6 dedup by idempotency key — AC-2.7 failure to gap\\\\n318\\\\t```\\\\n319\\\\t\\\\n320\\\\t**Skeleton requirements:**\\\\n321\\\\t\\\\n322\\\\t| What | Where | Stub signature | Stub semantics |\\\\n323\\\\t|------|-------|----------------|----------------|\\\\n324\\\\t| Map one message | `capture/map-message.ts` | `mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[]` | pure; `NotImplementedError` until Green |\\\\n325\\\\t| Turn accumulation | `capture/turn-accumulator.ts` | `class TurnAccumulator { onMessage(); onAgentEnd(): MessageEventInput[] }` | pure state machine |\\\\n326\\\\t| Idempotency key | `capture/idempotency.ts` | `eventKey(parts): string` | pure; deterministic |\\\\n327\\\\t| Orchestrate + flush | `capture/converter.ts` | `capture(events, instance): Promise<OpResult<BatchResult>>` | structured result; isolates failure |\\\\n328\\\\t\\\\n329\\\\tThe idempotency key gets real depth because dedup correctness (AC-2.6) and crash-replay both depend on it. Construction precedence, carried from the POC and adapted to the SDK's per-event-key field: PI entry id when present (`pi:<session>:<entryId>:<block>:<kind>`), else provider `responseId` (assistant) or `toolCallId` (tool result), else a `role:timestamp:content-hash` fallback. The contract is that the key is identical across re-delivery of the same logical event and distinct across different events; the SDK's `messageEvents` returns `skipped` with `skipReason: duplicate_idempotency_key` for a re-delivered key, which is the dedup mechanism the test asserts against.\\\\n330\\\\t\\\\n331\\\\t### Flow 3: Fork as New Thread\\\\n332\\\\t\\\\n333\\\\tA fork produces a new LHC thread seeded by replay, and never writes the source. Detection does not depend on a `session_start` fork reason: recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present. In Epic 1, PI still runs its own session, so PI's session tree (the `parentId` chain) is available as additional fork evidence when the hook is absent. This is an Epic-1 convenience, not the permanent design: the long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial), so the design must not harden PI's session tree into a permanent dependency.\\\\n334\\\\t\\\\n335\\\\tSeeding replays the source thread's recorded events up to the fork point into the new thread, through the same intake path normal capture uses, so the seeded read-back matches the source's read-back through that point. Derived forms are not copied (I-2): the new thread's derivations requeue and drain in the background. The source thread receives no writes — verified by logical read-back equality, not byte-equality, because SQLite page churn can change bytes without changing content.\\\\n336\\\\t\\\\n337\\\\t```mermaid\\\\n338\\\\tsequenceDiagram\\\\n339\\\\t  participant PI\\\\n340\\\\t  participant FK as fork\\\\n341\\\\t  participant TH as lhc.threads\\\\n342\\\\t  participant CV as converter\\\\n343\\\\t  PI->>FK: session_start (fork point via hook, PI tree as Epic-1 fallback)\\\\n344\\\\t  FK->>TH: newThread(forkFilePath)\\\\n345\\\\t  FK->>CV: replay source events → fork point\\\\n346\\\\t  CV->>TH: messageEvents(newThread, seeded events)\\\\n347\\\\t  Note over FK,TH: AC-3.1 source unwritten — AC-3.2 read-back matches — AC-3.3 forms requeue\\\\n348\\\\t```\\\\n349\\\\t\\\\n350\\\\t**Skeleton requirements:**\\\\n351\\\\t\\\\n352\\\\t| What | Where | Stub signature | Stub semantics |\\\\n353\\\\t|------|-------|----------------|----------------|\\\\n354\\\\t| Detect fork + point | `lifecycle/fork.ts` | `detectFork(ctx): ForkInfo \\\\\\\\| null` | reads `session_before_fork` hook; PI session tree as Epic-1 fallback |\\\\n355\\\\t| Seed by replay | `lifecycle/fork.ts` | `seedFork(source, target, forkPoint): Promise<OpResult>` | structured result |\\\\n356\\\\t\\\\n357\\\\t### Flow 4: Inference Host Routing\\\\n358\\\\t\\\\n359\\\\tLHC needs completions for its derivations and must get them through the user's existing PI auth, with no second login. The connector supplies one function at construction; LHC calls it with a `(provider, model)` pair and a single-turn message list and treats both strings as opaque routing keys. The function resolves the pair with `ctx.modelRegistry.find(provider, model)` and completes with pi-ai's `complete(model, context)`, returning the assistant text or a classified failure. Different derivation kinds can carry different pairs in the same session; the function routes each by its keys without interpreting them.\\\\n360\\\\t\\\\n361\\\\tClassification is the adapter-boundary contract and gets depth because it is where a runtime failure becomes a designed error code. A resolved completion with text returns `{ ok: true, text }`. Auth failure and invalid request are terminal (`\\\\\\\"auth\\\\\\\"`, `\\\\\\\"invalid_request\\\\\\\"`); rate-limit, timeout, and network are retryable (`\\\\\\\"rate_limit\\\\\\\"`, `\\\\\\\"timeout\\\\\\\"`, `\\\\\\\"network\\\\\\\"`); a thrown exception classifies as `\\\\\\\"other\\\\\\\"`. The host function never returns `\\\\\\\"empty_output\\\\\\\"` — that kind is generated by LHC's own adapter when a call resolves with no text — so the function returns text-or-transport-failure only, and the no-text case surfaces as the LHC-side `empty_output`.\\\\n362\\\\t\\\\n363\\\\tAC-4.5 closes the loop end to end and is why this flow depends on captured content (Story 2), not just an instance. A captured thread's queued derivation work runs through the background scheduler, invokes the supplied function, and persists either a ready derived form or a classified failure, queryable through inspect/health. This is the PRD's M1 \\\\\\\"confirm derivations land\\\\\\\" gate — it proves capture → derivation → recorded outcome, not just the function in isolation. The test drives a captured thread, wires a deterministic function (one returning text, one returning a failure), awaits `drainSettled`, and asserts both a ready form and a classified failure exist in the thread.\\\\n364\\\\t\\\\n365\\\\t```mermaid\\\\n366\\\\tsequenceDiagram\\\\n367\\\\t  participant SCH as lhc scheduler\\\\n368\\\\t  participant MC as model-call\\\\n369\\\\t  participant REG as PI modelRegistry\\\\n370\\\\t  participant AI as pi-ai complete\\\\n371\\\\t  SCH->>MC: ModelCall (provider, model, messages)\\\\n372\\\\t  MC->>REG: find(provider, model)\\\\n373\\\\t  alt model found + authed\\\\n374\\\\t    MC->>AI: complete(model, context)\\\\n375\\\\t    AI-->>MC: AssistantMessage (text / stopReason)\\\\n376\\\\t    MC-->>SCH: ok+text or classified failure\\\\n377\\\\t    Note over MC,SCH: AC-4.1 route, AC-4.3 classify\\\\n378\\\\t  else not found / no auth\\\\n379\\\\t    MC-->>SCH: failure kind auth or invalid_request\\\\n380\\\\t  end\\\\n381\\\\t  Note over SCH: AC-4.5 derivation persists ready form / failure\\\\n382\\\\t```\\\\n383\\\\t\\\\n384\\\\t**Skeleton requirements:**\\\\n385\\\\t\\\\n386\\\\t| What | Where | Stub signature | Stub semantics |\\\\n387\\\\t|------|-------|----------------|----------------|\\\\n388\\\\t| The function | `inference/model-call.ts` | `createModelCall(ctx): ModelCall` | returns `{ok,text}`/`{ok:false,kind}` |\\\\n389\\\\t| Classify | `inference/model-call.ts` | `classifyFailure(err): ModelCallFailureKind` | pure mapping |\\\\n390\\\\t\\\\n391\\\\t### Flow 5: Startup Validation and Assignment Config\\\\n392\\\\t\\\\n393\\\\tBefore any derivation runs, the connector checks that all seven assignments point at lanes PI can actually reach, so a misconfiguration surfaces up front rather than as a derivation failure later. Two layers do two different jobs, and conflating them would be wrong. The SDK already validates assignment *shape* at construction — all seven kinds present, non-empty provider/model, prompt-name registered — and throws if not; that is `assignments.ts`'s \\\\\\\"fail loud\\\\\\\" (AC-5.5), and it is enforced by LHC, not re-implemented here. The connector adds a *reachability* probe on top: for each assignment, first call `ctx.modelRegistry.find(provider, model)` to distinguish an unknown provider/model from a known lane, then check configured auth with `ctx.modelRegistry.hasConfiguredAuth(model)` or equivalent `getAvailable()` membership. Unknown lanes report a config/assignment fix; known-but-unauthed lanes report a login/auth fix. OAuth freshness is still verified at runtime by the model-call path and classified as a derivation failure if the token is stale.\\\\n394\\\\t\\\\n395\\\\tReporting must not assume a TUI. The report uses PI's UI surface (`ctx.ui.notify` when available) and always records the same structured diagnostic in `SessionState.health`; headless modes emit the diagnostic through the headless-appropriate log/output channel. A validation failure leaves capture running — the two concerns are independent — and the affected lane's derivations fail classified and queryable through health (AC-5.3). Assignments load from config; an override of any kind's provider, model, or prompt takes effect on the next session start with no code change.\\\\n396\\\\t\\\\n397\\\\t**Skeleton requirements:**\\\\n398\\\\t\\\\n399\\\\t| What | Where | Stub signature | Stub semantics |\\\\n400\\\\t|------|-------|----------------|----------------|\\\\n401\\\\t| Load + shape-validate | `inference/assignments.ts` | `loadAssignments(config): Record<FormKind, ModelAssignment>` | throws on missing/unknown/placeholder |\\\\n402\\\\t| Reachability probe | `inference/startup-validation.ts` | `validateReachable(assignments, ctx): ValidationReport` | structured report |\\\\n403\\\\t| Report | `inference/startup-validation.ts` | `report(r, ctx, state): void` | `ctx.ui` when available; structured state diagnostic always |\\\\n404\\\\t\\\\n405\\\\t### Flow 6: Capture Verification\\\\n406\\\\t\\\\n407\\\\tBecause the epic is observe-only, capture correctness is proven without serving anything to a model. `verify/replay.ts` replays a recorded corpus through the converter into a temp thread and compares the resulting read-back — events, messages, turns — against the fixture's expectation. The same corpus replayed twice yields identical read-back, because the converter's mapping and the SDK's deterministic IDs make replay reproducible (AC-6.2). The corpora are the M0 fixtures (chatty, tool-heavy, parallel-tool, error-result, aborted-turn); until M0 delivers breadth, the machinery builds against whatever corpora exist and widens as they arrive. inspect's overview and health reads report event/message counts, last recorded position, and any capture gaps or failed derivations (AC-6.3).\\\\n408\\\\t\\\\n409\\\\t**Skeleton requirements:**\\\\n410\\\\t\\\\n411\\\\t| What | Where | Stub signature | Stub semantics |\\\\n412\\\\t|------|-------|----------------|----------------|\\\\n413\\\\t| Replay + compare | `verify/replay.ts` | `replayCorpus(corpus, threadRef): Promise<ReplayResult>` | structured compare result |\\\\n414\\\\t\\\\n415\\\\t---\\\\n416\\\\t\\\\n417\\\\t## Interface Definitions\\\\n418\\\\t\\\\n419\\\\tThese are copy-paste targets for the foundation chunk. Types reference the ACs they serve; signatures are complete (no `any`, no TODO). The LHC-side types (`MessageEventInput`, `ModelCall`, `ModelAssignment`, `FormKind`, `ThreadRef`, `OpResult`) are imported from the `lhc` package, not redefined — the connector consumes them.\\\\n420\\\\t\\\\n421\\\\t```typescript\\\\n422\\\\t// lifecycle/state.ts — AC-1.3: plain data only, never a PI object\\\\n423\\\\texport interface SessionState {\\\\n424\\\\t  threadRef: ThreadRef;          // from lhc\\\\n425\\\\t  flags: {\\\\n426\\\\t    startupValidationReported: boolean;\\\\n427\\\\t    [k: string]: boolean;\\\\n428\\\\t  };\\\\n429\\\\t  health: {\\\\n430\\\\t    lastCaptureFailure?: CaptureFailureDiagnostic;\\\\n431\\\\t    startupValidation?: ValidationReport;\\\\n432\\\\t  };\\\\n433\\\\t}\\\\n434\\\\t\\\\n435\\\\texport interface CaptureFailureDiagnostic {\\\\n436\\\\t  code: string;\\\\n437\\\\t  eventKey?: string;\\\\n438\\\\t  message: string;\\\\n439\\\\t  recordedGap: boolean;\\\\n440\\\\t}\\\\n441\\\\t\\\\n442\\\\t// lifecycle/thread-resolution.ts — AC-1.2, 1.5, 1.6\\\\n443\\\\t// Launch flags name the thread; the registry resolves it. (PI's own session file\\\\n444\\\\t// still exists in this observe-only epic; it is just not where thread identity lives.)\\\\n445\\\\texport interface LaunchFlags {\\\\n446\\\\t  resume?: boolean;        // --resume / -r : cwd-scoped picker\\\\n447\\\\t  continue?: boolean;      // --continue / -c : most recent\\\\n448\\\\t  session?: string;        // --session <id> : full or partial id\\\\n449\\\\t  // none set → new thread\\\\n450\\\\t}\\\\n451\\\\texport function resolveThread(\\\\n452\\\\t  launch: LaunchFlags, pi: ExtensionAPI,\\\\n453\\\\t): Promise<OpResult<ThreadRef>>; // unresolvable --session id → error, never a silent new thread\\\\n454\\\\t\\\\n455\\\\t// lifecycle/picker.ts — AC-1.7\\\\n456\\\\texport function pickThread(cwd: string): Promise<OpResult<ThreadRef | null>>; // null on empty list\\\\n457\\\\t\\\\n458\\\\t// capture/map-message.ts — AC-2.1, 2.3, 2.4, 2.5\\\\n459\\\\texport interface MapCtx { piSessionId: string; entryId?: string; }\\\\n460\\\\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[];\\\\n461\\\\t\\\\n462\\\\t// capture/runtime-changes.ts — AC-2.8\\\\n463\\\\t// model_select / thinking_level_select hooks → runtime_note events, in order.\\\\n464\\\\texport function mapModelSelect(\\\\n465\\\\t  ev: { model: { provider: string; id: string }; previousModel?: { provider: string; id: string } },\\\\n466\\\\t  ctx: MapCtx,\\\\n467\\\\t): MessageEventInput; // one runtime_note recording new + previous model\\\\n468\\\\texport function mapThinkingLevelSelect(\\\\n469\\\\t  ev: { level: string; previousLevel: string }, ctx: MapCtx,\\\\n470\\\\t): MessageEventInput; // one runtime_note recording new + previous level\\\\n471\\\\t\\\\n472\\\\t// capture/turn-accumulator.ts — AC-2.2\\\\n473\\\\texport class TurnAccumulator {\\\\n474\\\\t  onMessage(events: MessageEventInput[]): void;\\\\n475\\\\t  onAgentEnd(): MessageEventInput[]; // returns [turn_end] when a turn is open, else []\\\\n476\\\\t  hasOpenTurn(): boolean;\\\\n477\\\\t}\\\\n478\\\\t\\\\n479\\\\t// capture/idempotency.ts — AC-2.6\\\\n480\\\\texport function eventKey(input: {\\\\n481\\\\t  piSessionId: string; entryId?: string; responseId?: string;\\\\n482\\\\t  toolCallId?: string; blockIndex: number; kind: MessageEventInput[\\\\\\\"eventKind\\\\\\\"];\\\\n483\\\\t  role?: string; timestamp?: number; content?: string;\\\\n484\\\\t}): string;\\\\n485\\\\t\\\\n486\\\\t// capture/converter.ts — AC-2.1, 2.7\\\\n487\\\\texport function capture(\\\\n488\\\\t  events: MessageEventInput[],\\\\n489\\\\t  instance: LhcInstance,\\\\n490\\\\t): Promise<OpResult<BatchResult>>;\\\\n491\\\\t\\\\n492\\\\t// inference/model-call.ts — AC-4.1..4.4\\\\n493\\\\texport function createModelCall(ctx: ExtensionContext): ModelCall; // ModelCall from lhc\\\\n494\\\\texport function classifyFailure(err: unknown): ModelCallFailureKind;\\\\n495\\\\t\\\\n496\\\\t// inference/assignments.ts — AC-5.4, 5.5\\\\n497\\\\texport function loadAssignments(\\\\n498\\\\t  config: unknown,\\\\n499\\\\t): Record<FormKind, ModelAssignment>; // throws on missing/unknown/placeholder\\\\n500\\\\t\\\\n501\\\\t// inference/startup-validation.ts — AC-5.1, 5.2, 5.3\\\\n502\\\\texport interface ValidationReport {\\\\n503\\\\t  unreachable: {\\\\n504\\\\t    kind: FormKind;\\\\n505\\\\t    provider: string;\\\\n506\\\\t    model: string;\\\\n507\\\\t    reason: \\\\\\\"unknown_model\\\\\\\" | \\\\\\\"auth_not_configured\\\\\\\";\\\\n508\\\\t    fix: string;\\\\n509\\\\t  }[];\\\\n510\\\\t}\\\\n511\\\\texport function validateReachable(\\\\n512\\\\t  assignments: Record<FormKind, ModelAssignment>,\\\\n513\\\\t  ctx: ExtensionContext,\\\\n514\\\\t): ValidationReport;\\\\n515\\\\texport function report(\\\\n516\\\\t  r: ValidationReport,\\\\n517\\\\t  ctx: ExtensionContext,\\\\n518\\\\t  state: SessionState,\\\\n519\\\\t): void; // ctx.ui when available + structured state diagnostic\\\\n520\\\\t\\\\n521\\\\t// lifecycle/fork.ts — AC-3.1, 3.2, 3.3\\\\n522\\\\texport interface ForkInfo { sourceFile: string; forkEntryId: string; }\\\\n523\\\\texport function detectFork(ctx: ExtensionContext): ForkInfo | null;\\\\n524\\\\texport function seedFork(\\\\n525\\\\t  source: ThreadRef, target: ThreadRef, forkPoint: string,\\\\n526\\\\t): Promise<OpResult<void>>;\\\\n527\\\\t\\\\n528\\\\t// verify/replay.ts — AC-6.1, 6.2\\\\n529\\\\texport interface ReplayResult { matches: boolean; diff?: string; }\\\\n530\\\\texport function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult>;\\\\n531\\\\t```\\\\n532\\\\t\\\\n533\\\\t---\\\\n534\\\\t\\\\n535\\\\t## Architecture-Risk Tests\\\\n536\\\\t\\\\n537\\\\tBeyond the TC→test mapping, the chosen architecture creates hazards the AC/TC mapping alone would miss. These are non-TC tests assigned to chunks.\\\\n538\\\\t\\\\n539\\\\t| Risk | Test file | Test | Why AC/TC mapping alone would miss it |\\\\n540\\\\t|------|-----------|------|---------------------------------------|\\\\n541\\\\t| Persistence / Restart | `lifecycle/thread-resolution.test.ts` | Discard the in-memory holder, re-resolve the same thread by its id from the registry, capture continues on it | The AC says \\\\\\\"resume on the resolved thread\\\\\\\"; only a real reopen proves resolution works across process death without a retained object |\\\\n542\\\\t| Idempotency / Retry | `capture/idempotency.test.ts` | Replaying the same corpus twice produces no duplicate events; re-delivered keys come back `skipped` | TC checks dedup once; the hazard is re-delivery under reload/replay being safe |\\\\n543\\\\t| Adapter / Runtime Boundary | `inference/model-call.test.ts` | Each PI/pi-ai failure shape maps to the exact `ModelCallFailureKind` | TC may say \\\\\\\"error classified\\\\\\\"; the hazard is the precise runtime-error → code mapping |\\\\n544\\\\t| Atomicity / Isolation | `capture/converter.test.ts` | A mid-batch capture failure records a gap and continues; no exception reaches the hook; store-unavailable produces a health signal not a gap | The session continuing is observable; the no-exception-into-hook guarantee is not an AC |\\\\n545\\\\t| Source vs Derived Truth | `lifecycle/fork.test.ts` | After fork, source thread read-back is unchanged and forms requeue on the target | The epic sees a correct fork; the hazard is the source being silently mutated by seeding |\\\\n546\\\\t| Fixture Validity | `test/fixtures/corpus.test.ts` | Corpus loader yields valid `MessageEventInput` shapes and lifecycle-coherent sequences | Fixture correctness is test substrate, not product behavior, so no AC covers it |\\\\n547\\\\t| Concurrency / Lost Update | `inference/closed-loop.test.ts` | A stale background derivation result does not clobber newer thread state | LHC owns this, but the connector's background-mode wiring must not reintroduce it |\\\\n548\\\\t\\\\n549\\\\tMigration/compatibility is N/A — POC threads are out of scope (epic Migration), and the package is greenfield. Threshold/budget is N/A — visibility budgets are Epic 2.\\\\n550\\\\t\\\\n551\\\\t---\\\\n552\\\\t\\\\n553\\\\t## Conditional Design Sections\\\\n554\\\\t\\\\n555\\\\t### Fixture Contracts\\\\n556\\\\t\\\\n557\\\\tThe epic's verification flow and most capture tests run on fixtures, so fixture validity is a foundation invariant. Two fixture families:\\\\n558\\\\t\\\\n559\\\\t- **Recorded corpora** (`test/fixtures/corpus.ts`) — the M0 captures, loaded and validated to produce well-formed `MessageEventInput` sequences. Each corpus is a named lifecycle (chatty, tool-heavy, parallel-tool, error-result, aborted-turn). Default loaders represent valid captures; an explicitly named `makeTruncatedCorpus()` produces a deliberately malformed sequence for the capture-failure test.\\\\n560\\\\t- **Synthetic builders** (`test/fixtures/synthetic.ts`) — `makeUserMessage`, `makeAssistantMessage({ thinking?, text?, toolCalls? })`, `makeToolResult({ id, isError? })`, and event-stream builders for `session_start`/`agent_end` etc. These drive the lifecycle and turn-derivation tests where a precise hand-built shape beats a recorded one.\\\\n561\\\\t- **Deterministic ModelCall fakes** (`test/fixtures/model-call.ts`) — `fakeModelCallText(text)`, `fakeModelCallFailure(kind)`, and a per-kind router for multi-lane tests.\\\\n562\\\\t\\\\n563\\\\tFoundation tests (Chunk 0) verify these invariants before behavior chunks consume them.\\\\n564\\\\t\\\\n565\\\\t### Derived-State Provenance\\\\n566\\\\t\\\\n567\\\\tThis epic produces derived forms only via the closed-loop proof and fork requeue; it does not own provenance design (LHC does). The one connector-side rule: the fork path must not copy derived forms (I-2), so a forked thread's forms are always freshly derived and carry the new thread's provenance, never the source's. No provenance fields are added by the connector.\\\\n568\\\\t\\\\n569\\\\t### Mutation / Lease Semantics\\\\n570\\\\t\\\\n571\\\\tThe connector does not mutate persisted thread state directly — all writes go through `intakeStream.messageEvents`, which LHC serializes per thread file. There is one writer per thread (the session's instance), single-process. The connector adds no locks or leases; it relies on LHC's per-file transaction semantics. The only stale-write surface is the background scheduler, which LHC owns; the connector's responsibility is limited to constructing in background mode and never also driving `drain` (which would create a second writer).\\\\n572\\\\t\\\\n573\\\\t### Deterministic Algorithm Boundaries\\\\n574\\\\t\\\\n575\\\\tTwo deterministic mechanics need golden cases:\\\\n576\\\\t\\\\n577\\\\t- **Turn derivation** — exact inputs (a PI event sequence) to exact outputs (the ordered LHC events plus the single `turn_end`). The worked example in Flow 2 is the first golden case; others cover an aborted run (turn closes complete-but-aborted at `agent_end` with partial content) and a hard-kill (no `agent_end` → open turn left open, tolerated as a no-op on reattach).\\\\n578\\\\t- **Replay equality** — a corpus replayed twice yields byte-identical read-back. Golden cases pin the deterministic-ID property end to end through the converter.\\\\n579\\\\t\\\\n580\\\\tIdempotency-key construction is deterministic but its golden cases live with the idempotency risk test rather than here.\\\\n581\\\\t\\\\n582\\\\t---\\\\n583\\\\t\\\\n584\\\\t## Testing Strategy\\\\n585\\\\t\\\\n586\\\\tThe test architecture follows directly from where this component's real boundaries are. The connector's own modules — converter, mapper, accumulator, model-call, validation — are never mocked against each other; they are exercised through their entry points (the hook handlers, the converter, the replay harness) so wiring bugs between them surface. Mocks live only at the two true external edges.\\\\n587\\\\t\\\\n588\\\\t```\\\\n589\\\\t        /\\\\\\\\\\\\n590\\\\t       /  \\\\\\\\   Manual: load into real PI, run a session, inspect the thread\\\\n591\\\\t      /----\\\\\\\\\\\\n592\\\\t     /      \\\\\\\\  Entry-point tests: hook handlers / converter / replay\\\\n593\\\\t    /--------\\\\\\\\  driven by synthetic events + corpora, real temp SQLite\\\\n594\\\\t   /          \\\\\\\\ Module tests: map-message, turn-accumulator, idempotency,\\\\n595\\\\t  /------------\\\\\\\\ classifyFailure — pure, no mocks\\\\n596\\\\t /--------------\\\\\\\\\\\\n597\\\\t```\\\\n598\\\\t\\\\n599\\\\t**The critical mocking rule, applied:** mock at the external boundary, never at internal module boundaries. The external boundaries are the PI hook surface (fed by synthetic events and recorded corpora) and the `ModelCall`'s reach into PI's `modelRegistry` + pi-ai `complete` (supplied as a deterministic fake). Everything LHC runs real.\\\\n600\\\\t\\\\n601\\\\t| Layer | Mock? | Why |\\\\n602\\\\t|-------|-------|-----|\\\\n603\\\\t| PI hook events | Fed, not mocked | Synthetic builders + recorded corpora are the input, not a mocked dependency |\\\\n604\\\\t| `modelRegistry` + pi-ai `complete` | Yes (the fake `ModelCall`) | External boundary — control completion text and failure shapes |\\\\n605\\\\t| LHC SDK (`intakeStream`, `threads`, scheduler, `inspect`) | **No** | The engine under test; runs real |\\\\n606\\\\t| SQLite thread file | **No — real temp file** | Persistence, reattach, replay, fork are the product contract |\\\\n607\\\\t| `ctx.ui` / config | Yes (injection) | No logic, just setup |\\\\n608\\\\t| Connector's own modules | **No** | That's what's being tested |\\\\n609\\\\t\\\\n610\\\\t**Stateful local persistence:** reattach (TC-1.5), replay-equality (TC-6.2), and fork source-immutability (TC-3.1) all use real temp thread directories and prove behavior across a reopen or a second thread, because mocking the store would make these tests assert nothing.\\\\n611\\\\t\\\\n612\\\\tThe verification tiers are the `lhc` package's configured commands, which `pi-lhc` mirrors (pnpm workspace, vitest, tsc). What gets mocked appears again here intentionally; the same boundary is stated in External Contracts and in the matrix.\\\\n613\\\\t\\\\n614\\\\t---\\\\n615\\\\t\\\\n616\\\\t## Verification Scripts\\\\n617\\\\t\\\\n618\\\\tThese are the `pi-lhc` package's gates, matching the `lhc` package's configured composition (verified in `packages/lhc/package.json`). The `boundaries` step matters here because `check-boundaries.mjs` enforces the module-import rules that keep the connector's surfaces from leaking into each other.\\\\n619\\\\t\\\\n620\\\\t| Tier | Composition | Purpose |\\\\n621\\\\t|------|-------------|---------|\\\\n622\\\\t| `red-verify` | `build && typecheck && lint && boundaries` | TDD Red exit — everything except behavior tests |\\\\n623\\\\t| `verify` | `red-verify && vitest run` | Standard development gate |\\\\n624\\\\t| `green-verify` | `verify && check-test-immutability` | TDD Green exit — tests pass + immutability guard |\\\\n625\\\\t| `verify-all` | `verify` (no separate integration/e2e suite yet) | Deep gate; labeled below |\\\\n626\\\\t\\\\n627\\\\tThere is no separate integration/e2e suite in this package yet. `verify-all` equals `verify` for now; the wide \\\\\\\"load into real PI\\\\\\\" pass is the Manual Verification step, not an automated suite. The test plan labels every suite `ran` / `absent` so `verify-all` does not imply coverage it lacks.\\\\n628\\\\t\\\\n629\\\\t---\\\\n630\\\\t\\\\n631\\\\t## Work Breakdown: Chunks and Phases\\\\n632\\\\t\\\\n633\\\\tChunks map to the epic's stories, with Chunk 0 carrying the shared foundation. Per-chunk Red/Green test tables and the full TC→test mapping live in `test-plan.md`; this section is the index.\\\\n634\\\\t\\\\n635\\\\t### Chunk 0: Foundation (always first)\\\\n636\\\\t\\\\n637\\\\tArchetypes: **Pure Type Foundation** (the interfaces above), **Fixture/Test Foundation** (corpus loader, synthetic builders, ModelCall fakes, temp-thread factory), **Orchestration/Command Foundation** (the extension entry point and hook-registration rail with structured-result stubs), and **Verification Gate Foundation** (package scripts/config for the gates named here).\\\\n638\\\\t\\\\n639\\\\t| Deliverable | Path | Contains |\\\\n640\\\\t|-------------|------|----------|\\\\n641\\\\t| Types | `src/**/(*.ts type exports)` | All interfaces from Interface Definitions |\\\\n642\\\\t| Extension shell | `src/index.ts` | Hook registration; routes to stubbed handlers; holds no state |\\\\n643\\\\t| State holder | `src/lifecycle/state.ts` | Plain-data `SessionState` |\\\\n644\\\\t| Fixtures | `test/fixtures/{corpus,synthetic,model-call}.ts` | Valid-default builders + named invalid builders |\\\\n645\\\\t| Temp-thread factory | `test/fixtures/thread.ts` | Real temp SQLite thread per test |\\\\n646\\\\t| Package verification config | `package.json`, `tsconfig*.json`, test/lint scripts | `red-verify`, `verify`, `green-verify`, `verify-all`, boundary/lint wiring |\\\\n647\\\\t\\\\n648\\\\t**Exit criteria:** package verification scripts exist and run; `red-verify` passes; fixture-invariant tests pass (corpus shapes valid, synthetic builders produce coherent sequences, temp-thread factory creates and reopens a thread); the extension loads and registers hooks (smoke).\\\\n649\\\\t\\\\n650\\\\t### Chunk 1 — Session Lifecycle and Launch-Driven Thread Resolution (Story 1)\\\\n651\\\\t\\\\n652\\\\t**Scope:** instance construct/dispose, launch-driven resolution (new / `--session` partial-id / `--continue` / `--resume` picker), reload re-resolution, plain-data rule. **ACs:** 1.1–1.7. **Relevant sections:** Flow 1, `lifecycle/*`, Persistence/Restart risk. **Architecture-risk tests:** re-resolve-after-discard. **Substrate maturity:** depends on the registry `cwd` column, partial-id `resolve`, and cwd-filtered `listThreads` (epic A-8) — **Epic 1 LHC-side scope, gated before AC-1.6/1.7, not optional**. These are built first in this chunk; AC-1.7's cwd-scoped picker does not pass by degrading to an unscoped or untitled list. **Risk shape:** launch state machine; registry is the catalog; unresolvable id fails loud; no second writer.\\\\n653\\\\t\\\\n654\\\\t### Chunk 2 — Event Capture and Turn Derivation (Story 2)\\\\n655\\\\t\\\\n656\\\\t**Scope:** the converter, fan-out, turn derivation, runtime metadata capture, parallel correlation, error/abort capture, dedup, failure isolation. **ACs:** 2.1–2.8. **Relevant sections:** Flow 2, `capture/*`, Idempotency + Atomicity risks, Deterministic Boundaries (turn derivation). **Architecture-risk tests:** idempotency double-replay, mid-batch failure isolation. **Risk shape:** the highest-risk chunk; turn derivation is the load-bearing mechanic; capture failure must isolate.\\\\n657\\\\t\\\\n658\\\\t### Chunk 3 — Capture Verification (Story 3)\\\\n659\\\\t\\\\n660\\\\t**Scope:** corpus replay, read-back compare, deterministic re-replay, inspect surfacing. **ACs:** 6.1–6.3. **Relevant sections:** Flow 6, `verify/replay.ts`, Fixture Validity risk. **Substrate maturity:** consumes Chunk 2's converter through the real intake path, not a seam; consumes M0 corpora as fixtures (widens as M0 delivers).\\\\n661\\\\t\\\\n662\\\\t### Chunk 4 — Fork as New Thread (Story 4)\\\\n663\\\\t\\\\n664\\\\t**Scope:** fork detection (hook + Epic-1 session-tree fallback), replay-seed, source immutability, requeue. **ACs:** 3.1–3.3. **Relevant sections:** Flow 3, `lifecycle/fork.ts`, Source-vs-Derived risk. **Architecture-risk tests:** source read-back unchanged after seeding. **Risk shape:** new-thread authority; source is read-only; forms requeue (no copy); fork lineage's permanent home is LHC metadata (Epic 2+), not PI's session tree.\\\\n665\\\\t\\\\n666\\\\t### Chunk 5 — Inference Host Routing (Story 5)\\\\n667\\\\t\\\\n668\\\\t**Scope:** the `ModelCall`, multi-lane routing, classification, and the closed-loop proof. **ACs:** 4.1–4.5. **Relevant sections:** Flow 4, `inference/model-call.ts`, Adapter-Boundary + Concurrency risks. **Substrate maturity:** AC-4.5 consumes Chunk 2's captured content through the real scheduler + `drainSettled`, not a fake derivation. **Architecture-risk tests:** failure-shape→kind mapping, stale-result no-clobber.\\\\n669\\\\t\\\\n670\\\\t### Chunk 6 — Startup Validation and Assignment Config (Story 6)\\\\n671\\\\t\\\\n672\\\\t**Scope:** shape validation (LHC-enforced), reachability probe using existence + configured-auth checks, `ctx.ui`/headless reporting, config override. **ACs:** 5.1–5.5. **Relevant sections:** Flow 5, `inference/{assignments,startup-validation}.ts`. **Risk shape:** validation independent of capture; reporting must not assume a TUI.\\\\n673\\\\t\\\\n674\\\\t### Chunk Dependencies\\\\n675\\\\t\\\\n676\\\\t```\\\\n677\\\\tChunk 0 (Foundation)\\\\n678\\\\t   ├──> Chunk 1 (Lifecycle) ──> Chunk 2 (Capture) ──> Chunk 3 (Verification)\\\\n679\\\\t   │                                     └──────────> Chunk 4 (Fork)\\\\n680\\\\t   │                                     └──────────> Chunk 5 (Inference 4.5)\\\\n681\\\\t   └──> Chunk 5 (Inference 4.1–4.4) ──> Chunk 6 (Validation)\\\\n682\\\\t```\\\\n683\\\\t\\\\n684\\\\tChunk 5 splits across the diagram because the function and classification (4.1–4.4) depend only on the instance (Chunk 1 via 0), while the closed-loop proof (4.5) needs captured content (Chunk 2).\\\\n685\\\\t\\\\n686\\\\t---\\\\n687\\\\t\\\\n688\\\\t## Open Questions\\\\n689\\\\t\\\\n690\\\\t| # | Question | Owner | Blocks | Resolution |\\\\n691\\\\t|---|----------|-------|--------|------------|\\\\n692\\\\t| Q1 | Does M0 extend the intake schema for images/file-refs, or is degrade-to-`runtime_note` the final v1 answer? | M0 / Lee | Chunk 2 (final form) | Pending; safe default (I-6) unblocks design |\\\\n693\\\\t| Q2 | Is the `initLhc` rename landed before implementation, or does Chunk 0 write against `createSdk` and rename later? | Lee | Chunk 0 import names | Pending; mechanical either way (A-4) |\\\\n694\\\\t| Q3 | Final breadth of M0 corpora for Chunk 3 fixtures | M0 / Lee | Chunk 3 coverage | Pending; machinery builds against available corpora |\\\\n695\\\\t\\\\n696\\\\t---\\\\n697\\\\t\\\\n698\\\\t## Deferred Items\\\\n699\\\\t\\\\n700\\\\t| Item | Related AC | Reason deferred | Future work |\\\\n701\\\\t|------|-----------|-----------------|-------------|\\\\n702\\\\t| Fork derived-form reuse (copy instead of requeue) | AC-3.3 | Needs a provenance-identity safety check that does not exist; requeue is correct and cheap | Optimization once provenance identity is defined (Epic 2+) |\\\\n703\\\\t| `thinkingSignature` / `thoughtSignature` re-injection | TDQ-3 | Capture drops them; re-injection is a serving concern | Epic 2 (serving) decides if signatures must round-trip |\\\\n704\\\\t| Image/file-reference intake payload kinds | A-7 | M0 decision; degrade-to-`runtime_note` is the interim contract | Converter gains kinds if M0 extends the schema |\\\\n705\\\\t\\\\n706\\\\t---\\\\n707\\\\t\\\\n708\\\\t## Related Documentation\\\\n709\\\\t\\\\n710\\\\t- Epic: `epic.md`\\\\n711\\\\t- Test plan: `test-plan.md`\\\\n712\\\\t- Tech architecture: `../01-tech-arch.md`\\\\n713\\\\t- Wiring research: `../notes/pi-ext-integration-research.md`\\\\n714\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\\\",\\\"uuid\\\":\\\"31782c9c-d088-43ff-b68f-6637f268b3e1\\\",\\\"timestamp\\\":\\\"2026-06-14T05:23:21.901Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md\\\",\\\"content\\\":\\\"# Epic 1: Connector Core — Tech Design\\\\n\\\\n**Status:** Draft for review\\\\n**Epic:** `epic.md`\\\\n**PRD:** `../00-prd.md` — Feature 1\\\\n**Tech Arch:** `../01-tech-arch.md`\\\\n**Wiring research:** `../notes/pi-ext-integration-research.md` (verified against PI v0.79.2)\\\\n**Test plan:** `test-plan.md`\\\\n\\\\n---\\\\n\\\\n## Spec Validation\\\\n\\\\nThe epic is implementable as written once its named M0 inputs land. Every AC maps to a module and a test; the data contracts match the real surfaces the design calls into (the LHC SDK at `packages/lhc`, the PI extension API at `@earendil-works/pi-coding-agent` v0.79.2, the completion API at `@earendil-works/pi-ai`). The tech-design questions are answered below, and the places where the design takes a position the epic left open are recorded as deviations with rationale.\\\\n\\\\nThe validation that mattered most: the epic's load-bearing claim is that an LHC turn is not a PI turn, and the converter must derive LHC turn boundaries from the agent-run bracket rather than from PI's per-step `turn_end`. The real PI event types confirm the shape the epic relies on — `turn_end` carries a per-agent-run `turnIndex` that resets to 0 each run, and `agent_end` brackets the whole run — so the contract is buildable against types that exist, not against an assumption.\\\\n\\\\n### Issues Found\\\\n\\\\n| # | Type | Issue | Resolution |\\\\n|---|------|-------|------------|\\\\n| I-1 | TDQ-1 (dissolved) | Mapping persistence shape (session file vs sidecar vs both). | **Dissolved — the thread is resolved at launch, not from a stored mapping.** The LHC thread is the system of record and the registry is the catalog; the thread for a run is named by the launch (new / `--session` / `--continue` / `--resume` picker), so there is no PI-session→thread mapping to persist, no early-crash window, and no recovery sidecar. The tech-lead's durability finding is moot: there is no pointer to lose. (PI's own session file still exists in this observe-only epic — PI runs its session normally; it just is not where LHC's thread identity lives.) See Flow 1. |\\\\n| I-2 | TDQ-2 | Fork derived-form reuse — provable-safe copy vs always-requeue. | **Resolved for v1: always requeue.** The new thread is seeded by event replay only; derived forms are not copied across the fork. Reuse is a later optimization gated on a provenance-identity check that does not exist yet. The epic's AC-3.3 permits this (reuse \\\\\\\"may\\\\\\\" happen; requeue is the correct fallback). Recorded as a deviation — the epic leaves the door open, the design closes it for v1. See Deferred Items. |\\\\n| I-3 | TDQ-3 | `thinkingSignature` / `thoughtSignature` handling. | **Resolved: capture, do not interpret.** Assistant thinking carries an opaque `thinkingSignature`; tool calls carry an opaque `thoughtSignature` (the POC mapper found both). Neither is part of the seven LHC intake payloads, which are text/structured-arg only. The converter records thinking text and tool-call arguments; the signatures are dropped in this epic because nothing in capture or derivation consumes them. Flagged as a deviation: re-injecting signatures is a serving concern (Epic 2), not capture. |\\\\n| I-4 | TDQ-4 (dissolved) | Thread resolution by external key. | **Dissolved.** Resolution is by the launch input (full/partial `threadId`, or a picker selection over `listThreads`), through `threads.resolve` / `threads.resolveThreadRef`. There is no external PI-session key to translate, because the operator names the thread at launch. |\\\\n| I-7 | API mismatch (tech-lead #1) | `appendEntry` is on `pi: ExtensionAPI`, not `ctx: ExtensionContext`. | **Moot for mapping, noted for capture.** The mapping no longer writes a session-file pointer, so the `appendEntry` mismatch in the old `session-mapping` is gone. Where the connector does need registration-time API (hook registration), it takes `pi: ExtensionAPI` at the factory, and per-hook handlers take `ctx`. Interface signatures take `pi` where an `ExtensionAPI` method is needed, `ctx` otherwise. |\\\\n| I-8 | API mismatch (tech-lead #3) | `registryPath` is not a field of `SdkConfig`. | **Resolved.** `registryPath` is removed from `initLhc`/`createSdk` construction. It is a per-operation argument on the `threads` calls (`newThread`, `resolve`, `listThreads`), which is where the real LHC API accepts it. `initLhc` is the rename of `createSdk` and takes `SdkConfig` unchanged. |\\\\n| I-9 | Wording (tech-lead #5) | \\\\\\\"no `ctx.ui` surface\\\\\\\" — `ExtensionContext.ui` always exists. | **Resolved.** Reporting guards on headless mode (`hasUI:false`), not on the absence of `ctx.ui`. Test and prose wording corrected. |\\\\n| I-10 | Gap fill | Runtime metadata: model/thinking changes, cwd, foreign-extension state. | **Resolved per epic A-8/A-9.** Model-select and thinking-level-select are captured as `runtime_note` events (AC-2.8, in-stream-only). cwd is stored on the registry row at thread creation and scopes the `--resume` picker. The full PI-runtime-state restoration inventory is an Epic 2 prerequisite (tech arch). Foreign-extension session persistence is out of scope v1 (epic A-9). |\\\\n| I-5 | TDQ-5 | Converter structure — how it consumes `message_end` and emits batched `MessageEventInput[]`. | **Resolved.** The converter is two pure stages plus one stateful accumulator: `mapMessage` (one PI `AgentMessage` → ordered `MessageEventInput[]`, no I/O) and `deriveTurnClose` (decides when to emit `turn_end`), driven by a per-session `TurnAccumulator` that tracks the open LHC turn across `message_end`/`agent_end`. Batches flush through `intakeStream.messageEvents(threadRef, events)`. See Flow 2 design. |\\\\n| I-6 | Deviation | Epic A-7 names image/file-reference handling an M0 decision. | **Design position pending M0, with a safe fallback specified.** The current LHC intake schema has no image/file payload kind beyond text/runtime-note material. Until M0 chooses placeholder vs. schema extension, unsupported content parts degrade to a `runtime_note` event recording the omission (never silent drop). If M0 extends the intake schema, the converter gains kinds; the degrade-to-`runtime_note` path remains the fallback for unsupported parts. This unblocks implementation planning without pre-empting the M0 call. |\\\\n\\\\n---\\\\n\\\\n## Context\\\\n\\\\nThis epic builds the first real consumer of the LHC SDK. Until now LHC has been exercised by its own test harness and a deterministic provider; here it gets wired to a live coding agent whose event stream it does not control. The whole epic is observe-only by deliberate construction — the extension records everything PI does and changes nothing the model sees — because that constraint is what lets capture correctness be proven before any context-serving risk is introduced. PI's native context handling stays in charge throughout. The reward for the discipline is that every test in this epic asserts on recorded thread state, never on what a model received.\\\\n\\\\nThe shape of the work is set by two systems that already exist and are not being changed. PI fires lifecycle hooks (`session_start`, `message_end`, `turn_end`, `agent_end`, `session_shutdown`, fork/switch) and an extension subscribes to them; this is a fixed, versioned contract verified against v0.79.2 by live recon. The LHC SDK is constructed once per session (`initLhc`, the agreed rename of the current `createSdk`), exposes operation surfaces (`intakeStream`, `threads`, `inspect`, the background work scheduler), and persists one SQLite file per thread. The connector is the tissue between them: it translates PI's events into LHC intake operations, and translates LHC's need for inference back into PI's authenticated model registry. It owns no context state of its own beyond a thread reference and a few told-the-user flags, because PI tears down and replaces its session objects on every new/resume/fork transition, and a cached reference to one of those objects is a latent crash.\\\\n\\\\nThree forces shaped the central decisions. First, **PI's turn is not LHC's turn** — PI brackets each agent step with `turn_start`/`turn_end` and resets `turnIndex` to 0 per agent run, while an LHC turn spans a whole exchange. The converter must derive LHC turn boundaries from the agent-run bracket (`agent_end`), and the recon that established this is the reason the epic could be written without guessing. Second, **capture must never break the session** — malformed input on a writable thread degrades to a recorded, queryable gap; store-unavailable failures degrade to extension-level health diagnostics; neither throws back into a PI hook. Third, **derivations must close the loop on the user's own logins** — LHC asks for completions through a single host-supplied function that resolves provider/model through PI's registry, so there is no second credential store and no separate login.\\\\n\\\\nOne framing decision underlies the whole lifecycle: **the LHC thread is the system of record for the conversation, and the registry is the catalog.** The thread for a run is resolved at launch from the operator's choice (a new thread, the `--resume` picker, `--continue`, or a named `--session` id), the same way PI's own launch flags work. This dissolves what an earlier draft treated as a hard problem — keeping a PI-session→thread mapping durable across an early crash — because the launch choice *is* the thread identity, so there is nothing to recover. A scoping note that matters for the rest of this design: this epic is observe-only, so **PI still runs its own session** — it persists its session, serves its own context to the model, and tracks its own fork tree. LHC records alongside as the durable record. PI's session file becomes vestigial in Feature 2, when LHC's served context replaces PI's transcript; in Epic 1 the two coexist.\\\\n\\\\nThe connector also inherits a body of prior art. A POC extension (`src/context-steward/pi/`, ~3,900 lines across the mapper, the parallel-event intake, and the extension shell) already solved much of the hard mapping — idempotency-key construction, parallel-tool correlation, unsupported-part degradation — against an older LHC storage API. This epic productionizes that logic against the current, leaner SDK surface (plain-string `actor`/`harness`, per-event `idempotencyKey`, the seven-kind `MessageEventInput` union), so the converter is a rewrite informed by the POC, not a port of it. The POC's stale-context handling, by contrast, dies here: the tech arch's plain-data-only rule replaces it.\\\\n\\\\n---\\\\n\\\\n## System View\\\\n\\\\nAt the highest altitude the connector sits between two systems it does not own and one durable store it drives. PI is upstream — it produces the event stream and owns provider auth. The LHC SDK is the engine — it owns capture, projection, derivation scheduling, and persistence. The thread's SQLite file is the durable record that survives the process. The connector is the only component that speaks both PI's hook vocabulary and LHC's operation vocabulary, and it is the only place the PI-session-id ↔ LHC-thread-id translation lives.\\\\n\\\\n```mermaid\\\\nflowchart LR\\\\n  subgraph PI[\\\\\\\"PI process\\\\\\\"]\\\\n    H[\\\\\\\"hook surface\\\\\\\\nsession_start, message_end,\\\\\\\\nturn_end, agent_end, shutdown, fork\\\\\\\"]\\\\n    MR[\\\\\\\"modelRegistry + auth\\\\\\\"]\\\\n  end\\\\n  subgraph EXT[\\\\\\\"pi-lhc extension (in-process)\\\\\\\"]\\\\n    L[\\\\\\\"lifecycle\\\\\\\"]\\\\n    C[\\\\\\\"converter\\\\\\\"]\\\\n    I[\\\\\\\"inference host\\\\\\\"]\\\\n    V[\\\\\\\"startup validation\\\\\\\"]\\\\n  end\\\\n  subgraph LHC[\\\\\\\"LHC SDK (in-process)\\\\\\\"]\\\\n    IS[\\\\\\\"intakeStream\\\\\\\"]\\\\n    TH[\\\\\\\"threads\\\\\\\"]\\\\n    SCH[\\\\\\\"background scheduler\\\\\\\"]\\\\n    INS[\\\\\\\"inspect\\\\\\\"]\\\\n    DB[(\\\\\\\"thread.sqlite\\\\\\\")]\\\\n  end\\\\n  H --> L\\\\n  H --> C\\\\n  C --> IS\\\\n  L --> TH\\\\n  IS --> DB\\\\n  TH --> DB\\\\n  SCH --> I\\\\n  I --> MR\\\\n  V --> MR\\\\n  INS --> DB\\\\n```\\\\n\\\\nThe boundaries that matter for testing are the two edges the connector does not own: the **PI hook surface** (events arrive; the design feeds them from recorded corpora and synthetic builders) and the **`ModelCall` function** as it reaches PI's `modelRegistry` + `complete` (the design supplies a deterministic fake). Everything inside the LHC box runs real against a temp SQLite file, because persistence, reattach, replay, and fork are the product contract — mocking the store would prove nothing about the behaviors this epic exists to guarantee.\\\\n\\\\n### External Contracts\\\\n\\\\n**Incoming — PI hooks consumed** (shapes verified against `@earendil-works/pi-coding-agent` v0.79.2):\\\\n\\\\n| Hook | Payload (relevant fields) | Connector use |\\\\n|------|---------------------------|---------------|\\\\n| `session_start` | `reason: \\\\\\\"startup\\\\\\\"\\\\\\\\|\\\\\\\"reload\\\\\\\"\\\\\\\\|\\\\\\\"new\\\\\\\"\\\\\\\\|\\\\\\\"resume\\\\\\\"\\\\\\\\|\\\\\\\"fork\\\\\\\"`, `previousSessionFile?` | Resolve or create the thread; reattach; trigger startup validation |\\\\n| `message_end` | `message: AgentMessage` (user / assistant / toolResult) | Map to `MessageEventInput[]`, batch into intake |\\\\n| `turn_end` | `turnIndex` (per-agent-run), `message`, `toolResults[]`, `stopReason` | Update accumulator; **never** a 1:1 LHC `turn_end` |\\\\n| `agent_end` | the agent run's messages | Close the open LHC turn — emit one LHC `turn_end` |\\\\n| `model_select` | `model`, `previousModel`, `source` | Capture as a `runtime_note` event (AC-2.8) |\\\\n| `thinking_level_select` | `level`, `previousLevel` | Capture as a `runtime_note` event (AC-2.8) |\\\\n| `session_before_fork` | `entryId`, `position` | Capture the fork point for replay-seeding |\\\\n| `session_before_switch` | switch intent (`new`/`resume`) | Flush + dispose before the swap |\\\\n| `session_shutdown` | `reason`, `targetSessionFile?` | Dispose the instance with flush |\\\\n\\\\n**Outgoing — LHC SDK operations called** (shapes from `packages/lhc/src`):\\\\n\\\\n| Surface | Operation | Used for |\\\\n|---------|-----------|----------|\\\\n| construction | `initLhc(config: SdkConfig)` — `{ inference, mode: \\\\\\\"background\\\\\\\", view, ... }`; `registryPath` is **not** a construction field | One instance per session |\\\\n| `threads` | `newThread({ filePath, title?, cwd?, registryPath? })`, `resolve({ threadId, registryPath? })`, `listThreads({ cwd?, registryPath? })`, `resolveThreadRef`, `info` | Launch resolution: create / pick / continue / named |\\\\n| `intakeStream` | `messageEvents(threadRef, MessageEventInput[])` → `BatchResult` | Record capture; dedup by idempotency key |\\\\n| scheduler | `mode: \\\\\\\"background\\\\\\\"` (auto-drain), `drainSettled(ref)` | Derivations run; awaited only in the closed-loop test |\\\\n| `inspect` | overview / health reads | Capture verification, gap/failure surfacing |\\\\n\\\\n**Outgoing — inference, through PI:** the host-supplied `ModelCall` resolves `(provider, model)` via `ctx.modelRegistry.find(provider, model)` and completes via `complete(model, context, options)` from `@earendil-works/pi-ai`, returning `Promise<AssistantMessage>`.\\\\n\\\\n**Error contract** (machine-readable, what callers program against):\\\\n\\\\n| Source | Condition | Shape the connector produces |\\\\n|--------|-----------|------------------------------|\\\\n| Capture | malformed/unmappable event, thread writable | `OpResult` error recorded as a thread gap, surfaced in `inspect` health |\\\\n| Capture | thread store unavailable | extension diagnostic / health signal; no hook exception |\\\\n| ModelCall | auth / invalid request | `{ ok: false, kind: \\\\\\\"auth\\\\\\\" \\\\\\\\| \\\\\\\"invalid_request\\\\\\\" }` (terminal) |\\\\n| ModelCall | rate limit / timeout / network | `{ ok: false, kind: \\\\\\\"rate_limit\\\\\\\" \\\\\\\\| \\\\\\\"timeout\\\\\\\" \\\\\\\\| \\\\\\\"network\\\\\\\" }` (retryable) |\\\\n| ModelCall | thrown exception | `{ ok: false, kind: \\\\\\\"other\\\\\\\" }` |\\\\n| ModelCall adapter (LHC) | resolved but no text | `kind: \\\\\\\"empty_output\\\\\\\"` — generated by LHC's adapter, never returned by the host function |\\\\n\\\\n---\\\\n\\\\n## Module Boundaries\\\\n\\\\n### Top-Tier Surfaces\\\\n\\\\nThe tech arch names five top-tier surfaces for the whole `pi-lhc` extension. This epic touches three; the other two are out of scope and named so the boundary is explicit.\\\\n\\\\n| Surface | This epic | What lands here |\\\\n|---------|-----------|-----------------|\\\\n| Session Lifecycle | **Yes** | Instance construction/disposal, launch-driven thread resolution, reload re-resolution, fork detection |\\\\n| Event Capture | **Yes** | The converter (message mapping, turn derivation, batching, dedup), capture-failure isolation, capture verification |\\\\n| Inference Host | **Yes** | The `ModelCall` implementation, assignment config, startup validation |\\\\n| Context Serving | No (Epic 2) | The `context` hook and thread-view serving are not registered in this epic |\\\\n| Surfaces (operator/agent) | No (Epic 3) | Commands and self-inspection tools beyond what verification reads |\\\\n\\\\nAll modules below nest within one of the three active surfaces. The package is a fresh scaffold (`packages/pi-lhc/` currently holds only `package.json`), so every module is NEW; the only EXISTS dependencies are the `lhc` workspace package and the PI/pi-ai packages.\\\\n\\\\n### Module Architecture\\\\n\\\\n```\\\\npackages/pi-lhc/\\\\n  src/\\\\n    index.ts                       NEW  extension entry — registers hooks, owns nothing else\\\\n    lifecycle/\\\\n      instance.ts                  NEW  initLhc construct/dispose; background mode\\\\n      thread-resolution.ts         NEW  launch flags → registry (new / --session / --continue / --resume); partial-id match\\\\n      picker.ts                    NEW  --resume cwd-scoped thread list + selection (thin pi-lhc UI)\\\\n      state.ts                     NEW  the plain-data-only holder { threadRef, flags, health } (no PI objects)\\\\n      fork.ts                      NEW  fork detection (session_before_fork hook; PI session tree as Epic-1 fallback) + replay seeding\\\\n    capture/\\\\n      converter.ts                 NEW  orchestrates map → accumulate → batch flush\\\\n      map-message.ts               NEW  pure: AgentMessage → MessageEventInput[]\\\\n      turn-accumulator.ts          NEW  open-turn state; deriveTurnClose\\\\n      idempotency.ts               NEW  pure: stable per-event key construction\\\\n    inference/\\\\n      model-call.ts                NEW  ModelCall over modelRegistry + complete; failure classification\\\\n      assignments.ts               NEW  config load + shape validation (the seven kinds)\\\\n      startup-validation.ts        NEW  registry existence + auth-availability probe; reporting (ctx.ui/headless)\\\\n    verify/\\\\n      replay.ts                    NEW  corpus → converter → thread; read-back compare (test-facing)\\\\n  test/\\\\n    fixtures/\\\\n      corpus.ts                    NEW  recorded-corpus loader (M0 fixtures)\\\\n      synthetic.ts                 NEW  synthetic AgentMessage / event builders\\\\n      model-call.ts                NEW  deterministic ModelCall fakes (text / each failure kind)\\\\n    ...                            NEW  per-chunk test files (see test-plan.md)\\\\n```\\\\n\\\\nThe two mock boundaries are explicit in the tree: `test/fixtures/corpus.ts` + `synthetic.ts` feed the PI hook edge, and `test/fixtures/model-call.ts` supplies the inference edge. No module under `src/` is mocked by another module under `src/` — the converter is tested through the capture entry point against a real temp thread, not in isolation with a mocked intake.\\\\n\\\\n### Module Responsibility Matrix\\\\n\\\\nThis is the rosetta stone: every AC has a home, and every module names the ACs it carries. If an AC is not here, it has no owner.\\\\n\\\\n| Module | Status | Responsibility | Depends on | ACs |\\\\n|--------|--------|----------------|-----------|-----|\\\\n| `index.ts` | NEW | Register hook handlers; route each hook to lifecycle/capture/inference; hold no state | all `src/` modules | (wiring) |\\\\n| `lifecycle/instance.ts` | NEW | `initLhc` in background mode on start; dispose with flush on shutdown; reconstruct on reload | `lhc` | AC-1.1, AC-1.4, AC-1.5 |\\\\n| `lifecycle/thread-resolution.ts` | NEW | Launch flags → registry resolution (new / `--session` full+partial / `--continue` most-recent); reload reconstructs from resolved id; unresolvable id fails loud | `lhc` threads | AC-1.2, AC-1.5, AC-1.6 |\\\\n| `lifecycle/picker.ts` | NEW | `--resume` cwd-scoped thread list (title + created) and selection | `lhc` threads (`listThreads`) | AC-1.7 |\\\\n| `lifecycle/state.ts` | NEW | Plain-data-only holder and extension diagnostics; never caches a PI context/session object across hooks | — | AC-1.3, AC-2.7 |\\\\n| `lifecycle/fork.ts` | NEW | Detect fork from `session_before_fork` hook (PI session tree as Epic-1 fallback); new thread; replay-seed to fork point; never write source | `lhc` threads, capture | AC-3.1, AC-3.2, AC-3.3 |\\\\n| `capture/converter.ts` | NEW | Orchestrate map→accumulate→batch; isolate capture failure to a gap/health signal | map-message, turn-accumulator, `lhc` intakeStream | AC-2.1, AC-2.7 |\\\\n| `capture/map-message.ts` | NEW | Pure map of one `AgentMessage` to ordered events; fan-out; parallel-tool correlation; error-result; abort; unsupported→runtime_note | idempotency | AC-2.1, AC-2.3, AC-2.4, AC-2.5 |\\\\n| `capture/turn-accumulator.ts` | NEW | Track the open LHC turn; emit exactly one `turn_end` at `agent_end`; ignore per-step PI `turn_end` | — | AC-2.2 |\\\\n| `capture/runtime-changes.ts` | NEW | Map `model_select` / `thinking_level_select` hooks to ordered `runtime_note` events (new + previous value) | `lhc` intakeStream | AC-2.8 |\\\\n| `capture/idempotency.ts` | NEW | Construct a stable key per event so re-delivery dedups | — | AC-2.6 |\\\\n| `inference/model-call.ts` | NEW | Resolve (provider,model) via registry; complete; classify failures; multi-lane | PI modelRegistry, pi-ai | AC-4.1, AC-4.2, AC-4.3, AC-4.4 |\\\\n| `inference/assignments.ts` | NEW | Load seven assignments from config; fail loud on missing/unknown/placeholder; override on next start | — | AC-5.4, AC-5.5 |\\\\n| `inference/startup-validation.ts` | NEW | Probe each assignment with `modelRegistry.find(provider, model)` for existence and `hasConfiguredAuth(model)` / `getAvailable()` membership for configured auth; report unknown and not-logged-in lanes through `ctx.ui`/headless diagnostics; leave capture running | PI modelRegistry | AC-5.1, AC-5.2, AC-5.3 |\\\\n| `verify/replay.ts` | NEW | Replay a corpus through the converter; compare read-back; deterministic | converter, `lhc` inspect | AC-6.1, AC-6.2 |\\\\n| (closed-loop, in `model-call` + scheduler) | NEW | Captured thread's queued derivation invokes the function and records an outcome | `lhc` scheduler, inspect | AC-4.5 |\\\\n| `inspect` reads (via `lhc`) | EXISTS | Surface counts, position, gaps, failures | `lhc` inspect | AC-6.3 |\\\\n\\\\n### Component Interaction\\\\n\\\\n```mermaid\\\\nsequenceDiagram\\\\n  participant PI\\\\n  participant IDX as index.ts\\\\n  participant LC as lifecycle\\\\n  participant CV as converter\\\\n  participant IS as lhc.intakeStream\\\\n  participant SCH as lhc scheduler\\\\n  participant MC as model-call\\\\n  PI->>IDX: session_start\\\\n  IDX->>LC: resolve/create thread, initLhc(background)\\\\n  PI->>IDX: message_end / turn_end / agent_end\\\\n  IDX->>CV: map + accumulate\\\\n  CV->>IS: messageEvents(threadRef, events)\\\\n  Note over SCH: background scheduler drains on its own\\\\n  SCH->>MC: ModelCall(provider, model, messages)\\\\n  MC->>PI: modelRegistry.find + complete\\\\n  PI->>IDX: session_shutdown\\\\n  IDX->>LC: dispose(flush)\\\\n```\\\\n\\\\n---\\\\n\\\\n## Flow-by-Flow Design\\\\n\\\\nEach flow below opens with the context that makes its mechanics make sense, then a sequence diagram annotated with the ACs it satisfies, then a skeleton-requirements table and the TC approaches. The depth is uneven on purpose: turn derivation, idempotency, reattach, the inference adapter, and fork-replay carry the design's risk and get the most room; thread creation and config loading are mechanical and get less.\\\\n\\\\n### Flow 1: Session Lifecycle and Launch-Driven Thread Resolution\\\\n\\\\nA session starts and the connector must answer one question before anything else: which thread does this run record into? The answer comes from the launch, not from a recovered pointer — the LHC thread is the system of record and the registry resolves it from the operator's choice. No thread-selecting flag means a new thread (registered with its cwd). `--session <id>` resolves a named thread by full or partial id. `--continue`/`-c` resolves the most recently created thread. `--resume`/`-r` lists the cwd's threads and resolves the operator's pick. The connector then constructs the LHC instance in background scheduler mode against the resolved thread; derivations drain on their own and the connector never drives the queue.\\\\n\\\\nBecause the thread id is an input to the run, there is nothing to keep durable across an early crash and no two records that can disagree — the failure mode an earlier draft tried to insure against (a session-file pointer lost before flush) does not exist. An unresolvable `--session` id is an error, reported actionably; it never silently creates a new thread.\\\\n\\\\nThe plain-data-only rule is enforced structurally here. The connector's only retained state is a `{ threadRef, flags }` holder. It never stores a PI `ctx` or session-manager object between hooks, because PI replaces those objects on new/resume/fork and a stale reference is a crash waiting for the next transition. Each handler uses the fresh `ctx` PI passes it.\\\\n\\\\n```mermaid\\\\nsequenceDiagram\\\\n  participant OP as operator (launch)\\\\n  participant LC as lifecycle\\\\n  participant TH as lhc.threads + registry\\\\n  OP->>LC: session_start (launch flags)\\\\n  alt no flag\\\\n    LC->>TH: newThread(filePath, cwd, title)\\\\n    Note over LC,TH: AC-1.1 new thread, background mode\\\\n  else --session id\\\\n    LC->>TH: resolve(id, partial match)\\\\n    Note over LC,TH: AC-1.6 named, fails loud if unresolvable\\\\n  else --continue\\\\n    LC->>TH: resolve most recent\\\\n  else --resume / -r\\\\n    LC->>TH: listThreads(cwd) — picker — resolve(id)\\\\n    Note over LC,TH: AC-1.7 cwd-scoped, titled\\\\n  end\\\\n  Note over LC: holds only threadRef and flags — AC-1.3\\\\n  OP->>LC: session_shutdown\\\\n  LC->>TH: dispose(flush)\\\\n  Note over LC: AC-1.4 complete through last event\\\\n```\\\\n\\\\n**Skeleton requirements:**\\\\n\\\\n| What | Where | Stub signature | Stub semantics |\\\\n|------|-------|----------------|----------------|\\\\n| Construct/dispose | `lifecycle/instance.ts` | `initInstance(threadRef, config): Promise<Instance>` / `dispose(): Promise<void>` | structured result; throws nothing into hook |\\\\n| Resolve thread from launch | `lifecycle/thread-resolution.ts` | `resolveThread(launch: LaunchFlags, pi: ExtensionAPI): Promise<OpResult<ThreadRef>>` | registry resolve/create by mode; partial-id match; loud on unresolvable; structured `OpResult` |\\\\n| Resume picker | `lifecycle/picker.ts` | `pickThread(cwd: string): Promise<OpResult<ThreadRef \\\\\\\\| null>>` | cwd-scoped `listThreads`; selection; `null` on empty |\\\\n| State holder | `lifecycle/state.ts` | `class SessionState { threadRef; flags }` | plain data; no PI refs |\\\\n\\\\nTC approaches (TC-1.1…TC-1.5) live in `test-plan.md`; each asserts on observable thread/mapping state through a real temp thread, with the lifecycle entry point driven by synthetic `session_start`/`shutdown` events. The reattach test (TC-1.5) reconstructs from the durable record after discarding the in-memory holder — the architecture-risk test for restart survival.\\\\n\\\\n### Flow 2: Event Capture and Turn Derivation\\\\n\\\\nThis is the densest flow and the one the epic was written to get right. Each finalized PI message becomes an ordered run of LHC intake events; the subtlety is entirely in turns. PI emits `turn_start`/`turn_end` per agent step and resets `turnIndex` to 0 at the start of each agent run, so an agent run that takes three steps emits three PI turns. An LHC turn is the whole exchange — the user prompt and every step the agent took until the next prompt. The converter therefore ignores PI's per-step `turn_end` as a boundary signal and closes the LHC turn at `agent_end`.\\\\n\\\\nThe converter is three pieces. `map-message.ts` is pure: it takes one `AgentMessage` and returns the ordered events for it — a user message becomes one `user_prompt`; an assistant message fans out to `assistant_thinking` (if present), then `assistant_text` (if present), then one `tool_call` per call, in that order; a tool result becomes one `tool_result` correlated to its call by `toolCallId`, carrying `isError` when the tool failed. `turn-accumulator.ts` holds the open-turn state and decides when to emit the single `turn_end`. `converter.ts` orchestrates, batches the events, and flushes them through `intakeStream.messageEvents`, isolating failures so writable-thread failures become recorded gaps and store-unavailable failures become extension diagnostics rather than thrown exceptions.\\\\n\\\\nA worked example anchors the contract. The user asks one question that triggers two parallel tool calls, then gets a final answer:\\\\n\\\\n```\\\\nPI emits:                              converter emits (one LHC turn):\\\\n  turn_start(0)                          user_prompt\\\\n  message_end(user [text])               assistant_thinking\\\\n  message_end(assistant                  tool_call (id=a)\\\\n    [thinking, toolCall a, toolCall b])  tool_call (id=b)\\\\n  message_end(toolResult b)              tool_result (id=b)\\\\n  message_end(toolResult a)              tool_result (id=a)\\\\n  turn_end(0)        <- ignored          assistant_text\\\\n  turn_start(1)                          turn_end          <- at agent_end\\\\n  message_end(assistant [text])\\\\n  turn_end(1)        <- ignored\\\\n  agent_end          <- closes turn\\\\n```\\\\n\\\\nThe two tool results arrive in the order `b` then `a`, and each correlates to its call by id, not by arrival order — the parallel-tool contract (AC-2.3). PI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` fires at `agent_end`. Session order derives from converter source-event order, never from `turnIndex`.\\\\n\\\\n```mermaid\\\\nsequenceDiagram\\\\n  participant PI\\\\n  participant CV as converter\\\\n  participant TA as turn-accumulator\\\\n  participant IS as lhc.intakeStream\\\\n  PI->>CV: message_end(user)\\\\n  CV->>TA: open turn\\\\n  CV->>IS: [user_prompt]\\\\n  Note over CV,IS: AC-2.1 ordered fan-out\\\\n  PI->>CV: message_end(assistant [thinking,toolCall×2])\\\\n  CV->>IS: [assistant_thinking, tool_call, tool_call]\\\\n  PI->>CV: message_end(toolResult) ×2 (out of order)\\\\n  CV->>IS: [tool_result, tool_result] correlated by id\\\\n  Note over CV,IS: AC-2.3 parallel correlation, AC-2.4 error flag\\\\n  PI->>CV: turn_end ×N\\\\n  Note over TA: ignored as boundary — AC-2.2\\\\n  PI->>CV: agent_end\\\\n  CV->>TA: close turn\\\\n  CV->>IS: [turn_end]\\\\n  Note over CV,IS: AC-2.6 dedup by idempotency key — AC-2.7 failure to gap\\\\n```\\\\n\\\\n**Skeleton requirements:**\\\\n\\\\n| What | Where | Stub signature | Stub semantics |\\\\n|------|-------|----------------|----------------|\\\\n| Map one message | `capture/map-message.ts` | `mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[]` | pure; `NotImplementedError` until Green |\\\\n| Turn accumulation | `capture/turn-accumulator.ts` | `class TurnAccumulator { onMessage(); onAgentEnd(): MessageEventInput[] }` | pure state machine |\\\\n| Idempotency key | `capture/idempotency.ts` | `eventKey(parts): string` | pure; deterministic |\\\\n| Orchestrate + flush | `capture/converter.ts` | `capture(events, instance): Promise<OpResult<BatchResult>>` | structured result; isolates failure |\\\\n\\\\nThe idempotency key gets real depth because dedup correctness (AC-2.6) and crash-replay both depend on it. Construction precedence, carried from the POC and adapted to the SDK's per-event-key field: PI entry id when present (`pi:<session>:<entryId>:<block>:<kind>`), else provider `responseId` (assistant) or `toolCallId` (tool result), else a `role:timestamp:content-hash` fallback. The contract is that the key is identical across re-delivery of the same logical event and distinct across different events; the SDK's `messageEvents` returns `skipped` with `skipReason: duplicate_idempotency_key` for a re-delivered key, which is the dedup mechanism the test asserts against.\\\\n\\\\n### Flow 3: Fork as New Thread\\\\n\\\\nA fork produces a new LHC thread seeded by replay, and never writes the source. Detection does not depend on a `session_start` fork reason: recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present. In Epic 1, PI still runs its own session, so PI's session tree (the `parentId` chain) is available as additional fork evidence when the hook is absent. This is an Epic-1 convenience, not the permanent design: the long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial), so the design must not harden PI's session tree into a permanent dependency.\\\\n\\\\nSeeding replays the source thread's recorded events up to the fork point into the new thread, through the same intake path normal capture uses, so the seeded read-back matches the source's read-back through that point. Derived forms are not copied (I-2): the new thread's derivations requeue and drain in the background. The source thread receives no writes — verified by logical read-back equality, not byte-equality, because SQLite page churn can change bytes without changing content.\\\\n\\\\n```mermaid\\\\nsequenceDiagram\\\\n  participant PI\\\\n  participant FK as fork\\\\n  participant TH as lhc.threads\\\\n  participant CV as converter\\\\n  PI->>FK: session_start (fork point via hook, PI tree as Epic-1 fallback)\\\\n  FK->>TH: newThread(forkFilePath)\\\\n  FK->>CV: replay source events → fork point\\\\n  CV->>TH: messageEvents(newThread, seeded events)\\\\n  Note over FK,TH: AC-3.1 source unwritten — AC-3.2 read-back matches — AC-3.3 forms requeue\\\\n```\\\\n\\\\n**Skeleton requirements:**\\\\n\\\\n| What | Where | Stub signature | Stub semantics |\\\\n|------|-------|----------------|----------------|\\\\n| Detect fork + point | `lifecycle/fork.ts` | `detectFork(ctx): ForkInfo \\\\\\\\| null` | reads `session_before_fork` hook; PI session tree as Epic-1 fallback |\\\\n| Seed by replay | `lifecycle/fork.ts` | `seedFork(source, target, forkPoint): Promise<OpResult>` | structured result |\\\\n\\\\n### Flow 4: Inference Host Routing\\\\n\\\\nLHC needs completions for its derivations and must get them through the user's existing PI auth, with no second login. The connector supplies one function at construction; LHC calls it with a `(provider, model)` pair and a single-turn message list and treats both strings as opaque routing keys. The function resolves the pair with `ctx.modelRegistry.find(provider, model)` and completes with pi-ai's `complete(model, context)`, returning the assistant text or a classified failure. Different derivation kinds can carry different pairs in the same session; the function routes each by its keys without interpreting them.\\\\n\\\\nClassification is the adapter-boundary contract and gets depth because it is where a runtime failure becomes a designed error code. A resolved completion with text returns `{ ok: true, text }`. Auth failure and invalid request are terminal (`\\\\\\\"auth\\\\\\\"`, `\\\\\\\"invalid_request\\\\\\\"`); rate-limit, timeout, and network are retryable (`\\\\\\\"rate_limit\\\\\\\"`, `\\\\\\\"timeout\\\\\\\"`, `\\\\\\\"network\\\\\\\"`); a thrown exception classifies as `\\\\\\\"other\\\\\\\"`. The host function never returns `\\\\\\\"empty_output\\\\\\\"` — that kind is generated by LHC's own adapter when a call resolves with no text — so the function returns text-or-transport-failure only, and the no-text case surfaces as the LHC-side `empty_output`.\\\\n\\\\nAC-4.5 closes the loop end to end and is why this flow depends on captured content (Story 2), not just an instance. A captured thread's queued derivation work runs through the background scheduler, invokes the supplied function, and persists either a ready derived form or a classified failure, queryable through inspect/health. This is the PRD's M1 \\\\\\\"confirm derivations land\\\\\\\" gate — it proves capture → derivation → recorded outcome, not just the function in isolation. The test drives a captured thread, wires a deterministic function (one returning text, one returning a failure), awaits `drainSettled`, and asserts both a ready form and a classified failure exist in the thread.\\\\n\\\\n```mermaid\\\\nsequenceDiagram\\\\n  participant SCH as lhc scheduler\\\\n  participant MC as model-call\\\\n  participant REG as PI modelRegistry\\\\n  participant AI as pi-ai complete\\\\n  SCH->>MC: ModelCall (provider, model, messages)\\\\n  MC->>REG: find(provider, model)\\\\n  alt model found + authed\\\\n    MC->>AI: complete(model, context)\\\\n    AI-->>MC: AssistantMessage (text / stopReason)\\\\n    MC-->>SCH: ok+text or classified failure\\\\n    Note over MC,SCH: AC-4.1 route, AC-4.3 classify\\\\n  else not found / no auth\\\\n    MC-->>SCH: failure kind auth or invalid_request\\\\n  end\\\\n  Note over SCH: AC-4.5 derivation persists ready form / failure\\\\n```\\\\n\\\\n**Skeleton requirements:**\\\\n\\\\n| What | Where | Stub signature | Stub semantics |\\\\n|------|-------|----------------|----------------|\\\\n| The function | `inference/model-call.ts` | `createModelCall(ctx): ModelCall` | returns `{ok,text}`/`{ok:false,kind}` |\\\\n| Classify | `inference/model-call.ts` | `classifyFailure(err): ModelCallFailureKind` | pure mapping |\\\\n\\\\n### Flow 5: Startup Validation and Assignment Config\\\\n\\\\nBefore any derivation runs, the connector checks that all seven assignments point at lanes PI can actually reach, so a misconfiguration surfaces up front rather than as a derivation failure later. Two layers do two different jobs, and conflating them would be wrong. The SDK already validates assignment *shape* at construction — all seven kinds present, non-empty provider/model, prompt-name registered — and throws if not; that is `assignments.ts`'s \\\\\\\"fail loud\\\\\\\" (AC-5.5), and it is enforced by LHC, not re-implemented here. The connector adds a *reachability* probe on top: for each assignment, first call `ctx.modelRegistry.find(provider, model)` to distinguish an unknown provider/model from a known lane, then check configured auth with `ctx.modelRegistry.hasConfiguredAuth(model)` or equivalent `getAvailable()` membership. Unknown lanes report a config/assignment fix; known-but-unauthed lanes report a login/auth fix. OAuth freshness is still verified at runtime by the model-call path and classified as a derivation failure if the token is stale.\\\\n\\\\nReporting must not assume a TUI. The report uses PI's UI surface (`ctx.ui.notify` when available) and always records the same structured diagnostic in `SessionState.health`; headless modes emit the diagnostic through the headless-appropriate log/output channel. A validation failure leaves capture running — the two concerns are independent — and the affected lane's derivations fail classified and queryable through health (AC-5.3). Assignments load from config; an override of any kind's provider, model, or prompt takes effect on the next session start with no code change.\\\\n\\\\n**Skeleton requirements:**\\\\n\\\\n| What | Where | Stub signature | Stub semantics |\\\\n|------|-------|----------------|----------------|\\\\n| Load + shape-validate | `inference/assignments.ts` | `loadAssignments(config): Record<FormKind, ModelAssignment>` | throws on missing/unknown/placeholder |\\\\n| Reachability probe | `inference/startup-validation.ts` | `validateReachable(assignments, ctx): ValidationReport` | structured report |\\\\n| Report | `inference/startup-validation.ts` | `report(r, ctx, state): void` | `ctx.ui` when available; structured state diagnostic always |\\\\n\\\\n### Flow 6: Capture Verification\\\\n\\\\nBecause the epic is observe-only, capture correctness is proven without serving anything to a model. `verify/replay.ts` replays a recorded corpus through the converter into a temp thread and compares the resulting read-back — events, messages, turns — against the fixture's expectation. The same corpus replayed twice yields identical read-back, because the converter's mapping and the SDK's deterministic IDs make replay reproducible (AC-6.2). The corpora are the M0 fixtures (chatty, tool-heavy, parallel-tool, error-result, aborted-turn); until M0 delivers breadth, the machinery builds against whatever corpora exist and widens as they arrive. inspect's overview and health reads report event/message counts, last recorded position, and any capture gaps or failed derivations (AC-6.3).\\\\n\\\\n**Skeleton requirements:**\\\\n\\\\n| What | Where | Stub signature | Stub semantics |\\\\n|------|-------|----------------|----------------|\\\\n| Replay + compare | `verify/replay.ts` | `replayCorpus(corpus, threadRef): Promise<ReplayResult>` | structured compare result |\\\\n\\\\n---\\\\n\\\\n## Interface Definitions\\\\n\\\\nThese are copy-paste targets for the foundation chunk. Types reference the ACs they serve; signatures are complete (no `any`, no TODO). The LHC-side types (`MessageEventInput`, `ModelCall`, `ModelAssignment`, `FormKind`, `ThreadRef`, `OpResult`) are imported from the `lhc` package, not redefined — the connector consumes them.\\\\n\\\\n```typescript\\\\n// lifecycle/state.ts — AC-1.3: plain data only, never a PI object\\\\nexport interface SessionState {\\\\n  threadRef: ThreadRef;          // from lhc\\\\n  flags: {\\\\n    startupValidationReported: boolean;\\\\n    [k: string]: boolean;\\\\n  };\\\\n  health: {\\\\n    lastCaptureFailure?: CaptureFailureDiagnostic;\\\\n    startupValidation?: ValidationReport;\\\\n  };\\\\n}\\\\n\\\\nexport interface CaptureFailureDiagnostic {\\\\n  code: string;\\\\n  eventKey?: string;\\\\n  message: string;\\\\n  recordedGap: boolean;\\\\n}\\\\n\\\\n// lifecycle/thread-resolution.ts — AC-1.2, 1.5, 1.6\\\\n// Launch flags name the thread; the registry resolves it. (PI's own session file\\\\n// still exists in this observe-only epic; it is just not where thread identity lives.)\\\\nexport interface LaunchFlags {\\\\n  resume?: boolean;        // --resume / -r : cwd-scoped picker\\\\n  continue?: boolean;      // --continue / -c : most recent\\\\n  session?: string;        // --session <id> : full or partial id\\\\n  // none set → new thread\\\\n}\\\\nexport function resolveThread(\\\\n  launch: LaunchFlags, pi: ExtensionAPI,\\\\n): Promise<OpResult<ThreadRef>>; // unresolvable --session id → error, never a silent new thread\\\\n\\\\n// lifecycle/picker.ts — AC-1.7\\\\nexport function pickThread(cwd: string): Promise<OpResult<ThreadRef | null>>; // null on empty list\\\\n\\\\n// capture/map-message.ts — AC-2.1, 2.3, 2.4, 2.5\\\\nexport interface MapCtx { piSessionId: string; entryId?: string; }\\\\nexport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[];\\\\n\\\\n// capture/runtime-changes.ts — AC-2.8\\\\n// model_select / thinking_level_select hooks → runtime_note events, in order.\\\\nexport function mapModelSelect(\\\\n  ev: { model: { provider: string; id: string }; previousModel?: { provider: string; id: string } },\\\\n  ctx: MapCtx,\\\\n): MessageEventInput; // one runtime_note recording new + previous model\\\\nexport function mapThinkingLevelSelect(\\\\n  ev: { level: string; previousLevel: string }, ctx: MapCtx,\\\\n): MessageEventInput; // one runtime_note recording new + previous level\\\\n\\\\n// capture/turn-accumulator.ts — AC-2.2\\\\nexport class TurnAccumulator {\\\\n  onMessage(events: MessageEventInput[]): void;\\\\n  onAgentEnd(): MessageEventInput[]; // returns [turn_end] when a turn is open, else []\\\\n  hasOpenTurn(): boolean;\\\\n}\\\\n\\\\n// capture/idempotency.ts — AC-2.6\\\\nexport function eventKey(input: {\\\\n  piSessionId: string; entryId?: string; responseId?: string;\\\\n  toolCallId?: string; blockIndex: number; kind: MessageEventInput[\\\\\\\"eventKind\\\\\\\"];\\\\n  role?: string; timestamp?: number; content?: string;\\\\n}): string;\\\\n\\\\n// capture/converter.ts — AC-2.1, 2.7\\\\nexport function capture(\\\\n  events: MessageEventInput[],\\\\n  instance: LhcInstance,\\\\n): Promise<OpResult<BatchResult>>;\\\\n\\\\n// inference/model-call.ts — AC-4.1..4.4\\\\nexport function createModelCall(ctx: ExtensionContext): ModelCall; // ModelCall from lhc\\\\nexport function classifyFailure(err: unknown): ModelCallFailureKind;\\\\n\\\\n// inference/assignments.ts — AC-5.4, 5.5\\\\nexport function loadAssignments(\\\\n  config: unknown,\\\\n): Record<FormKind, ModelAssignment>; // throws on missing/unknown/placeholder\\\\n\\\\n// inference/startup-validation.ts — AC-5.1, 5.2, 5.3\\\\nexport interface ValidationReport {\\\\n  unreachable: {\\\\n    kind: FormKind;\\\\n    provider: string;\\\\n    model: string;\\\\n    reason: \\\\\\\"unknown_model\\\\\\\" | \\\\\\\"auth_not_configured\\\\\\\";\\\\n    fix: string;\\\\n  }[];\\\\n}\\\\nexport function validateReachable(\\\\n  assignments: Record<FormKind, ModelAssignment>,\\\\n  ctx: ExtensionContext,\\\\n): ValidationReport;\\\\nexport function report(\\\\n  r: ValidationReport,\\\\n  ctx: ExtensionContext,\\\\n  state: SessionState,\\\\n): void; // ctx.ui when available + structured state diagnostic\\\\n\\\\n// lifecycle/fork.ts — AC-3.1, 3.2, 3.3\\\\nexport interface ForkInfo { sourceFile: string; forkEntryId: string; }\\\\nexport function detectFork(ctx: ExtensionContext): ForkInfo | null;\\\\nexport function seedFork(\\\\n  source: ThreadRef, target: ThreadRef, forkPoint: string,\\\\n): Promise<OpResult<void>>;\\\\n\\\\n// verify/replay.ts — AC-6.1, 6.2\\\\nexport interface ReplayResult { matches: boolean; diff?: string; }\\\\nexport function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult>;\\\\n```\\\\n\\\\n---\\\\n\\\\n## Architecture-Risk Tests\\\\n\\\\nBeyond the TC→test mapping, the chosen architecture creates hazards the AC/TC mapping alone would miss. These are non-TC tests assigned to chunks.\\\\n\\\\n| Risk | Test file | Test | Why AC/TC mapping alone would miss it |\\\\n|------|-----------|------|---------------------------------------|\\\\n| Persistence / Restart | `lifecycle/thread-resolution.test.ts` | Discard the in-memory holder, re-resolve the same thread by its id from the registry, capture continues on it | The AC says \\\\\\\"resume on the resolved thread\\\\\\\"; only a real reopen proves resolution works across process death without a retained object |\\\\n| Idempotency / Retry | `capture/idempotency.test.ts` | Replaying the same corpus twice produces no duplicate events; re-delivered keys come back `skipped` | TC checks dedup once; the hazard is re-delivery under reload/replay being safe |\\\\n| Adapter / Runtime Boundary | `inference/model-call.test.ts` | Each PI/pi-ai failure shape maps to the exact `ModelCallFailureKind` | TC may say \\\\\\\"error classified\\\\\\\"; the hazard is the precise runtime-error → code mapping |\\\\n| Atomicity / Isolation | `capture/converter.test.ts` | A mid-batch capture failure records a gap and continues; no exception reaches the hook; store-unavailable produces a health signal not a gap | The session continuing is observable; the no-exception-into-hook guarantee is not an AC |\\\\n| Source vs Derived Truth | `lifecycle/fork.test.ts` | After fork, source thread read-back is unchanged and forms requeue on the target | The epic sees a correct fork; the hazard is the source being silently mutated by seeding |\\\\n| Fixture Validity | `test/fixtures/corpus.test.ts` | Corpus loader yields valid `MessageEventInput` shapes and lifecycle-coherent sequences | Fixture correctness is test substrate, not product behavior, so no AC covers it |\\\\n| Concurrency / Lost Update | `inference/closed-loop.test.ts` | A stale background derivation result does not clobber newer thread state | LHC owns this, but the connector's background-mode wiring must not reintroduce it |\\\\n\\\\nMigration/compatibility is N/A — POC threads are out of scope (epic Migration), and the package is greenfield. Threshold/budget is N/A — visibility budgets are Epic 2.\\\\n\\\\n---\\\\n\\\\n## Conditional Design Sections\\\\n\\\\n### Fixture Contracts\\\\n\\\\nThe epic's verification flow and most capture tests run on fixtures, so fixture validity is a foundation invariant. Two fixture families:\\\\n\\\\n- **Recorded corpora** (`test/fixtures/corpus.ts`) — the M0 captures, loaded and validated to produce well-formed `MessageEventInput` sequences. Each corpus is a named lifecycle (chatty, tool-heavy, parallel-tool, error-result, aborted-turn). Default loaders represent valid captures; an explicitly named `makeTruncatedCorpus()` produces a deliberately malformed sequence for the capture-failure test.\\\\n- **Synthetic builders** (`test/fixtures/synthetic.ts`) — `makeUserMessage`, `makeAssistantMessage({ thinking?, text?, toolCalls? })`, `makeToolResult({ id, isError? })`, and event-stream builders for `session_start`/`agent_end` etc. These drive the lifecycle and turn-derivation tests where a precise hand-built shape beats a recorded one.\\\\n- **Deterministic ModelCall fakes** (`test/fixtures/model-call.ts`) — `fakeModelCallText(text)`, `fakeModelCallFailure(kind)`, and a per-kind router for multi-lane tests.\\\\n\\\\nFoundation tests (Chunk 0) verify these invariants before behavior chunks consume them.\\\\n\\\\n### Derived-State Provenance\\\\n\\\\nThis epic produces derived forms only via the closed-loop proof and fork requeue; it does not own provenance design (LHC does). The one connector-side rule: the fork path must not copy derived forms (I-2), so a forked thread's forms are always freshly derived and carry the new thread's provenance, never the source's. No provenance fields are added by the connector.\\\\n\\\\n### Mutation / Lease Semantics\\\\n\\\\nThe connector does not mutate persisted thread state directly — all writes go through `intakeStream.messageEvents`, which LHC serializes per thread file. There is one writer per thread (the session's instance), single-process. The connector adds no locks or leases; it relies on LHC's per-file transaction semantics. The only stale-write surface is the background scheduler, which LHC owns; the connector's responsibility is limited to constructing in background mode and never also driving `drain` (which would create a second writer).\\\\n\\\\n### Deterministic Algorithm Boundaries\\\\n\\\\nTwo deterministic mechanics need golden cases:\\\\n\\\\n- **Turn derivation** — exact inputs (a PI event sequence) to exact outputs (the ordered LHC events plus the single `turn_end`). The worked example in Flow 2 is the first golden case; others cover an aborted run (turn closes complete-but-aborted at `agent_end` with partial content) and a hard-kill (no `agent_end` → open turn left open, tolerated as a no-op on reattach).\\\\n- **Replay equality** — a corpus replayed twice yields byte-identical read-back. Golden cases pin the deterministic-ID property end to end through the converter.\\\\n\\\\nIdempotency-key construction is deterministic but its golden cases live with the idempotency risk test rather than here.\\\\n\\\\n---\\\\n\\\\n## Testing Strategy\\\\n\\\\nThe test architecture follows directly from where this component's real boundaries are. The connector's own modules — converter, mapper, accumulator, model-call, validation — are never mocked against each other; they are exercised through their entry points (the hook handlers, the converter, the replay harness) so wiring bugs between them surface. Mocks live only at the two true external edges.\\\\n\\\\n```\\\\n        /\\\\\\\\\\\\n       /  \\\\\\\\   Manual: load into real PI, run a session, inspect the thread\\\\n      /----\\\\\\\\\\\\n     /      \\\\\\\\  Entry-point tests: hook handlers / converter / replay\\\\n    /--------\\\\\\\\  driven by synthetic events + corpora, real temp SQLite\\\\n   /          \\\\\\\\ Module tests: map-message, turn-accumulator, idempotency,\\\\n  /------------\\\\\\\\ classifyFailure — pure, no mocks\\\\n /--------------\\\\\\\\\\\\n```\\\\n\\\\n**The critical mocking rule, applied:** mock at the external boundary, never at internal module boundaries. The external boundaries are the PI hook surface (fed by synthetic events and recorded corpora) and the `ModelCall`'s reach into PI's `modelRegistry` + pi-ai `complete` (supplied as a deterministic fake). Everything LHC runs real.\\\\n\\\\n| Layer | Mock? | Why |\\\\n|-------|-------|-----|\\\\n| PI hook events | Fed, not mocked | Synthetic builders + recorded corpora are the input, not a mocked dependency |\\\\n| `modelRegistry` + pi-ai `complete` | Yes (the fake `ModelCall`) | External boundary — control completion text and failure shapes |\\\\n| LHC SDK (`intakeStream`, `threads`, scheduler, `inspect`) | **No** | The engine under test; runs real |\\\\n| SQLite thread file | **No — real temp file** | Persistence, reattach, replay, fork are the product contract |\\\\n| `ctx.ui` / config | Yes (injection) | No logic, just setup |\\\\n| Connector's own modules | **No** | That's what's being tested |\\\\n\\\\n**Stateful local persistence:** reattach (TC-1.5), replay-equality (TC-6.2), and fork source-immutability (TC-3.1) all use real temp thread directories and prove behavior across a reopen or a second thread, because mocking the store would make these tests assert nothing.\\\\n\\\\nThe verification tiers are the `lhc` package's configured commands, which `pi-lhc` mirrors (pnpm workspace, vitest, tsc). What gets mocked appears again here intentionally; the same boundary is stated in External Contracts and in the matrix.\\\\n\\\\n---\\\\n\\\\n## Verification Scripts\\\\n\\\\nThese are the `pi-lhc` package's gates, matching the `lhc` package's configured composition (verified in `packages/lhc/package.json`). The `boundaries` step matters here because `check-boundaries.mjs` enforces the module-import rules that keep the connector's surfaces from leaking into each other.\\\\n\\\\n| Tier | Composition | Purpose |\\\\n|------|-------------|---------|\\\\n| `red-verify` | `build && typecheck && lint && boundaries` | TDD Red exit — everything except behavior tests |\\\\n| `verify` | `red-verify && vitest run` | Standard development gate |\\\\n| `green-verify` | `verify && check-test-immutability` | TDD Green exit — tests pass + immutability guard |\\\\n| `verify-all` | `verify` (no separate integration/e2e suite yet) | Deep gate; labeled below |\\\\n\\\\nThere is no separate integration/e2e suite in this package yet. `verify-all` equals `verify` for now; the wide \\\\\\\"load into real PI\\\\\\\" pass is the Manual Verification step, not an automated suite. The test plan labels every suite `ran` / `absent` so `verify-all` does not imply coverage it lacks.\\\\n\\\\n---\\\\n\\\\n## Work Breakdown: Chunks and Phases\\\\n\\\\nChunks map to the epic's stories, with Chunk 0 carrying the shared foundation. Per-chunk Red/Green test tables and the full TC→test mapping live in `test-plan.md`; this section is the index.\\\\n\\\\n### Chunk 0: Foundation (always first)\\\\n\\\\nArchetypes: **Pure Type Foundation** (the interfaces above), **Fixture/Test Foundation** (corpus loader, synthetic builders, ModelCall fakes, temp-thread factory), **Orchestration/Command Foundation** (the extension entry point and hook-registration rail with structured-result stubs), and **Verification Gate Foundation** (package scripts/config for the gates named here).\\\\n\\\\n| Deliverable | Path | Contains |\\\\n|-------------|------|----------|\\\\n| Types | `src/**/(*.ts type exports)` | All interfaces from Interface Definitions |\\\\n| Extension shell | `src/index.ts` | Hook registration; routes to stubbed handlers; holds no state |\\\\n| State holder | `src/lifecycle/state.ts` | Plain-data `SessionState` |\\\\n| Fixtures | `test/fixtures/{corpus,synthetic,model-call}.ts` | Valid-default builders + named invalid builders |\\\\n| Temp-thread factory | `test/fixtures/thread.ts` | Real temp SQLite thread per test |\\\\n| Package verification config | `package.json`, `tsconfig*.json`, test/lint scripts | `red-verify`, `verify`, `green-verify`, `verify-all`, boundary/lint wiring |\\\\n\\\\n**Exit criteria:** package verification scripts exist and run; `red-verify` passes; fixture-invariant tests pass (corpus shapes valid, synthetic builders produce coherent sequences, temp-thread factory creates and reopens a thread); the extension loads and registers hooks (smoke).\\\\n\\\\n### Chunk 1 — Session Lifecycle and Launch-Driven Thread Resolution (Story 1)\\\\n\\\\n**Scope:** instance construct/dispose, launch-driven resolution (new / `--session` partial-id / `--continue` / `--resume` picker), reload re-resolution, plain-data rule. **ACs:** 1.1–1.7. **Relevant sections:** Flow 1, `lifecycle/*`, Persistence/Restart risk. **Architecture-risk tests:** re-resolve-after-discard. **Substrate maturity:** depends on the registry `cwd` column, partial-id `resolve`, and cwd-filtered `listThreads` (epic A-8) — **Epic 1 LHC-side scope, gated before AC-1.6/1.7, not optional**. These are built first in this chunk; AC-1.7's cwd-scoped picker does not pass by degrading to an unscoped or untitled list. **Risk shape:** launch state machine; registry is the catalog; unresolvable id fails loud; no second writer.\\\\n\\\\n### Chunk 2 — Event Capture and Turn Derivation (Story 2)\\\\n\\\\n**Scope:** the converter, fan-out, turn derivation, runtime metadata capture, parallel correlation, error/abort capture, dedup, failure isolation. **ACs:** 2.1–2.8. **Relevant sections:** Flow 2, `capture/*`, Idempotency + Atomicity risks, Deterministic Boundaries (turn derivation). **Architecture-risk tests:** idempotency double-replay, mid-batch failure isolation. **Risk shape:** the highest-risk chunk; turn derivation is the load-bearing mechanic; capture failure must isolate.\\\\n\\\\n### Chunk 3 — Capture Verification (Story 3)\\\\n\\\\n**Scope:** corpus replay, read-back compare, deterministic re-replay, inspect surfacing. **ACs:** 6.1–6.3. **Relevant sections:** Flow 6, `verify/replay.ts`, Fixture Validity risk. **Substrate maturity:** consumes Chunk 2's converter through the real intake path, not a seam; consumes M0 corpora as fixtures (widens as M0 delivers).\\\\n\\\\n### Chunk 4 — Fork as New Thread (Story 4)\\\\n\\\\n**Scope:** fork detection (hook + Epic-1 session-tree fallback), replay-seed, source immutability, requeue. **ACs:** 3.1–3.3. **Relevant sections:** Flow 3, `lifecycle/fork.ts`, Source-vs-Derived risk. **Architecture-risk tests:** source read-back unchanged after seeding. **Risk shape:** new-thread authority; source is read-only; forms requeue (no copy); fork lineage's permanent home is LHC metadata (Epic 2+), not PI's session tree.\\\\n\\\\n### Chunk 5 — Inference Host Routing (Story 5)\\\\n\\\\n**Scope:** the `ModelCall`, multi-lane routing, classification, and the closed-loop proof. **ACs:** 4.1–4.5. **Relevant sections:** Flow 4, `inference/model-call.ts`, Adapter-Boundary + Concurrency risks. **Substrate maturity:** AC-4.5 consumes Chunk 2's captured content through the real scheduler + `drainSettled`, not a fake derivation. **Architecture-risk tests:** failure-shape→kind mapping, stale-result no-clobber.\\\\n\\\\n### Chunk 6 — Startup Validation and Assignment Config (Story 6)\\\\n\\\\n**Scope:** shape validation (LHC-enforced), reachability probe using existence + configured-auth checks, `ctx.ui`/headless reporting, config override. **ACs:** 5.1–5.5. **Relevant sections:** Flow 5, `inference/{assignments,startup-validation}.ts`. **Risk shape:** validation independent of capture; reporting must not assume a TUI.\\\\n\\\\n### Chunk Dependencies\\\\n\\\\n```\\\\nChunk 0 (Foundation)\\\\n   ├──> Chunk 1 (Lifecycle) ──> Chunk 2 (Capture) ──> Chunk 3 (Verification)\\\\n   │                                     └──────────> Chunk 4 (Fork)\\\\n   │                                     └──────────> Chunk 5 (Inference 4.5)\\\\n   └──> Chunk 5 (Inference 4.1–4.4) ──> Chunk 6 (Validation)\\\\n```\\\\n\\\\nChunk 5 splits across the diagram because the function and classification (4.1–4.4) depend only on the instance (Chunk 1 via 0), while the closed-loop proof (4.5) needs captured content (Chunk 2).\\\\n\\\\n---\\\\n\\\\n## Open Questions\\\\n\\\\n| # | Question | Owner | Blocks | Resolution |\\\\n|---|----------|-------|--------|------------|\\\\n| Q1 | Does M0 extend the intake schema for images/file-refs, or is degrade-to-`runtime_note` the final v1 answer? | M0 / Lee | Chunk 2 (final form) | Pending; safe default (I-6) unblocks design |\\\\n| Q2 | Is the `initLhc` rename landed before implementation, or does Chunk 0 write against `createSdk` and rename later? | Lee | Chunk 0 import names | Pending; mechanical either way (A-4) |\\\\n| Q3 | Final breadth of M0 corpora for Chunk 3 fixtures | M0 / Lee | Chunk 3 coverage | Pending; machinery builds against available corpora |\\\\n\\\\n---\\\\n\\\\n## Deferred Items\\\\n\\\\n| Item | Related AC | Reason deferred | Future work |\\\\n|------|-----------|-----------------|-------------|\\\\n| Fork derived-form reuse (copy instead of requeue) | AC-3.3 | Needs a provenance-identity safety check that does not exist; requeue is correct and cheap | Optimization once provenance identity is defined (Epic 2+) |\\\\n| `thinkingSignature` / `thoughtSignature` re-injection | TDQ-3 | Capture drops them; re-injection is a serving concern | Epic 2 (serving) decides if signatures must round-trip |\\\\n| Image/file-reference intake payload kinds | A-7 | M0 decision; degrade-to-`runtime_note` is the interim contract | Converter gains kinds if M0 extends the schema |\\\\n\\\\n---\\\\n\\\\n## Related Documentation\\\\n\\\\n- Epic: `epic.md`\\\\n- Test plan: `test-plan.md`\\\\n- Tech architecture: `../01-tech-arch.md`\\\\n- Wiring research: `../notes/pi-ext-integration-research.md`\\\\n\\\",\\\"numLines\\\":714,\\\"startLine\\\":1,\\\"totalLines\\\":714}}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:342:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_018gXELJhMkXNtYcGJtRceHF\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\\\n2\\\\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\\\n3\\\\t// handler. The connector owns only plain-data `SessionState` plus the live\\\\n4\\\\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\\\n5\\\\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\\\n6\\\\timport { mkdirSync } from \\\\\\\"node:fs\\\\\\\";\\\\n7\\\\timport { homedir } from \\\\\\\"node:os\\\\\\\";\\\\n8\\\\timport { join } from \\\\\\\"node:path\\\\\\\";\\\\n9\\\\timport { randomUUID } from \\\\\\\"node:crypto\\\\\\\";\\\\n10\\\\timport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \\\\\\\"lhc\\\\\\\";\\\\n11\\\\timport type {\\\\n12\\\\t  ExtensionAPI,\\\\n13\\\\t  ExtensionContext,\\\\n14\\\\t  PiHookHandler,\\\\n15\\\\t  PiHookName,\\\\n16\\\\t} from \\\\\\\"./pi/types.js\\\\\\\";\\\\n17\\\\timport type { CaptureFailureDiagnostic, SessionState } from \\\\\\\"./lifecycle/state.js\\\\\\\";\\\\n18\\\\timport { createSessionState } from \\\\\\\"./lifecycle/state.js\\\\\\\";\\\\n19\\\\timport { disposeInstance, initInstance } from \\\\\\\"./lifecycle/instance.js\\\\\\\";\\\\n20\\\\timport {\\\\n21\\\\t  parseLaunchFlags,\\\\n22\\\\t  resolveThread,\\\\n23\\\\t  type LaunchFlags,\\\\n24\\\\t} from \\\\\\\"./lifecycle/thread-resolution.js\\\\\\\";\\\\n25\\\\timport { pickThread, type ThreadChoice } from \\\\\\\"./lifecycle/picker.js\\\\\\\";\\\\n26\\\\timport type { LhcInstance } from \\\\\\\"./shared/instance.js\\\\\\\";\\\\n27\\\\t\\\\n28\\\\texport { disposeInstance, initInstance, initLhc } from \\\\\\\"./lifecycle/instance.js\\\\\\\";\\\\n29\\\\texport type { LhcInstance } from \\\\\\\"./shared/instance.js\\\\\\\";\\\\n30\\\\t\\\\n31\\\\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\\\n32\\\\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\\\n33\\\\t *  registers no handler for it (story Scope Out). */\\\\n34\\\\texport const EPIC_1_HOOKS = [\\\\n35\\\\t  \\\\\\\"session_start\\\\\\\",\\\\n36\\\\t  \\\\\\\"message_end\\\\\\\",\\\\n37\\\\t  \\\\\\\"turn_end\\\\\\\",\\\\n38\\\\t  \\\\\\\"agent_end\\\\\\\",\\\\n39\\\\t  \\\\\\\"model_select\\\\\\\",\\\\n40\\\\t  \\\\\\\"thinking_level_select\\\\\\\",\\\\n41\\\\t  \\\\\\\"session_before_fork\\\\\\\",\\\\n42\\\\t  \\\\\\\"session_before_switch\\\\\\\",\\\\n43\\\\t  \\\\\\\"session_shutdown\\\\\\\",\\\\n44\\\\t] as const satisfies readonly PiHookName[];\\\\n45\\\\t\\\\n46\\\\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\\\n47\\\\t\\\\n48\\\\t/** What the connector needs from the host to run a session. Every dependency\\\\n49\\\\t *  has a working production default; the overrides exist for test isolation\\\\n50\\\\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\\\n51\\\\t *  in the PI-auth-backed inference config.\\\\n52\\\\t *\\\\n53\\\\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\\\n54\\\\t *  default is the observe-only config below (a real, construction-valid SDK);\\\\n55\\\\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\\\n56\\\\texport interface ConnectorDeps {\\\\n57\\\\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\\\n58\\\\t  registryPath?: string;\\\\n59\\\\t  newThreadFilePath?: () => string;\\\\n60\\\\t  parseLaunch?: () => LaunchFlags;\\\\n61\\\\t  selectThread?: (\\\\n62\\\\t    choices: readonly ThreadChoice[],\\\\n63\\\\t    ctx: ExtensionContext,\\\\n64\\\\t  ) => Promise<string | null>;\\\\n65\\\\t}\\\\n66\\\\t\\\\n67\\\\t/** Everything the connector retains across hooks as PLAIN data — by\\\\n68\\\\t *  construction structuredClone-able. The live `LhcInstance` is held separately\\\\n69\\\\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\\\n70\\\\t *  deliberately not part of the snapshot. */\\\\n71\\\\texport interface ConnectorSnapshot {\\\\n72\\\\t  state: SessionState | null;\\\\n73\\\\t  lastDiagnostic: CaptureFailureDiagnostic | null;\\\\n74\\\\t}\\\\n75\\\\t\\\\n76\\\\texport interface Connector {\\\\n77\\\\t  /** Register the observe-only hook rail on the PI extension API. */\\\\n78\\\\t  register(pi: ExtensionAPI): void;\\\\n79\\\\t  /** The plain-data state retained across hooks. `null` until a session\\\\n80\\\\t   *  resolves a thread; never holds a PI ctx. */\\\\n81\\\\t  getState(): SessionState | null;\\\\n82\\\\t  /** The live LHC instance for the current session, or `null`. A test/inspection\\\\n83\\\\t   *  seam — held by the connector but never part of the plain-data snapshot. */\\\\n84\\\\t  getInstance(): LhcInstance | null;\\\\n85\\\\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\\\\n86\\\\t  snapshot(): ConnectorSnapshot;\\\\n87\\\\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\\\\n88\\\\t   *  synthetic ctx/events without a live PI. */\\\\n89\\\\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\\\n90\\\\t}\\\\n91\\\\t\\\\n92\\\\tconst DEFAULT_LHC_DIR = join(homedir(), \\\\\\\".lhc\\\\\\\");\\\\n93\\\\t\\\\n94\\\\t/** The production observe-only SDK config: a real, construction-valid instance\\\\n95\\\\t *  in background scheduler mode. Epic 1 is observe-only, so derivations are\\\\n96\\\\t *  never served to the model; in Story 1 specifically the connector does not yet\\\\n97\\\\t *  capture (message_end is a no-op until Story 2), so no derivation work is\\\\n98\\\\t *  queued and this provider is never invoked — it exists only to satisfy\\\\n99\\\\t *  construction (AC-1.1 \\\\\\\"initializes one LHC instance\\\\\\\"). Stories 5/6 replace it\\\\n100\\\\t *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\\\\n101\\\\t *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\\\\n102\\\\t *  package is not yet a build dependency of this workspace). */\\\\n103\\\\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\\\n104\\\\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \\\\\\\"background\\\\\\\" } };\\\\n105\\\\t}\\\\n106\\\\t\\\\n107\\\\t/** Default `--resume` selection (sufficient for Story 1): resume the most\\\\n108\\\\t *  recently created thread in the cwd. The choices arrive in creation order, so\\\\n109\\\\t *  the last is the most recent. An interactive operator picker awaits a PI input\\\\n110\\\\t *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\\\\n111\\\\t *  then this is the production selection, and tests drive an explicit choice\\\\n112\\\\t *  through the injected selector. */\\\\n113\\\\tfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\\\\n114\\\\t  const mostRecent = choices.at(-1);\\\\n115\\\\t  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\\\\n116\\\\t}\\\\n117\\\\t\\\\n118\\\\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\\\n119\\\\t *  generated by the registry at creation, so the file name is just a unique\\\\n120\\\\t *  handle; the directory is ensured up front (DatabaseSync does not create\\\\n121\\\\t *  parents). */\\\\n122\\\\tfunction defaultNewThreadFilePath(): string {\\\\n123\\\\t  const dir = join(DEFAULT_LHC_DIR, \\\\\\\"threads\\\\\\\");\\\\n124\\\\t  mkdirSync(dir, { recursive: true });\\\\n125\\\\t  return join(dir, `${randomUUID()}.sqlite`);\\\\n126\\\\t}\\\\n127\\\\t\\\\n128\\\\tfunction threadIdOf(ref: ThreadRef): string | null {\\\\n129\\\\t  return \\\\\\\"threadId\\\\\\\" in ref ? ref.threadId : null;\\\\n130\\\\t}\\\\n131\\\\t\\\\n132\\\\t// The durable resolved thread id for the current session, held at MODULE scope\\\\n133\\\\t// (not in a connector closure) so it survives the extension teardown/re-init a\\\\n134\\\\t// reload performs: a PI process runs one session at a time, so a single\\\\n135\\\\t// \\\\\\\"current thread id\\\\\\\" is unambiguous, and a fresh connector created by the next\\\\n136\\\\t// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\\\\n137\\\\t// PI-session→thread mapping or a durable file — so process death correctly drops\\\\n138\\\\t// it and the next launch re-resolves (no early-crash window, no recovery\\\\n139\\\\t// sidecar; epic I-1). Cleared on any non-reload teardown.\\\\n140\\\\tlet rememberedSessionThreadId: string | null = null;\\\\n141\\\\t\\\\n142\\\\t/** Reset the module-level reload memory. Test seam so each test starts from a\\\\n143\\\\t *  clean durable state; also the hook a full teardown would call. */\\\\n144\\\\texport function resetSessionThreadMemory(): void {\\\\n145\\\\t  rememberedSessionThreadId = null;\\\\n146\\\\t}\\\\n147\\\\t\\\\n148\\\\t/** Build a connector instance. Its mutable state lives in this closure; the\\\\n149\\\\t *  registered handlers capture it, so the instance stays live for the session\\\\n150\\\\t *  even when `activate` discards the returned object. */\\\\n151\\\\texport function createConnector(deps: ConnectorDeps = {}): Connector {\\\\n152\\\\t  // The connector's retained state. `state` is plain data (the durable thread\\\\n153\\\\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\\\n154\\\\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\\\\n155\\\\t  // durable reload id lives at MODULE scope (above), not here, so it survives\\\\n156\\\\t  // this closure being torn down on reload.\\\\n157\\\\t  let state: SessionState | null = null;\\\\n158\\\\t  let instance: LhcInstance | null = null;\\\\n159\\\\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\\\n160\\\\t\\\\n161\\\\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\\\n162\\\\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\\\n163\\\\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\\\n164\\\\t  const selectThread = deps.selectThread ?? defaultSelectThread;\\\\n165\\\\t\\\\n166\\\\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\\\\n167\\\\t    return { code, message, recordedGap: false };\\\\n168\\\\t  }\\\\n169\\\\t\\\\n170\\\\t  // On reload (same session continues, the connector torn down and re-created)\\\\n171\\\\t  // reconstruct the SAME thread from its durable id rather than re-running the\\\\n172\\\\t  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\\\\n173\\\\t  // id is read from the module-level reload memory, which survives this closure;\\\\n174\\\\t  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\\\\n175\\\\t  // the fallback, covering --session/--continue/--resume reloads. The permanent\\\\n176\\\\t  // home for reload lineage is LHC thread metadata (Feature 2+).\\\\n177\\\\t  function launchFor(event: { reason: string }): LaunchFlags {\\\\n178\\\\t    if (event.reason === \\\\\\\"reload\\\\\\\" && rememberedSessionThreadId !== null) {\\\\n179\\\\t      return { session: rememberedSessionThreadId };\\\\n180\\\\t    }\\\\n181\\\\t    return parseLaunch();\\\\n182\\\\t  }\\\\n183\\\\t\\\\n184\\\\t  async function resolveForLaunch(\\\\n185\\\\t    launch: LaunchFlags,\\\\n186\\\\t    ctx: ExtensionContext,\\\\n187\\\\t  ): Promise<OpResult<ThreadRef | null>> {\\\\n188\\\\t    if (launch.resume === true) {\\\\n189\\\\t      const pickerDeps: {\\\\n190\\\\t        registryPath?: string;\\\\n191\\\\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\\\n192\\\\t      } = { select: (choices) => selectThread(choices, ctx) };\\\\n193\\\\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\\\n194\\\\t      return pickThread(ctx.cwd, pickerDeps);\\\\n195\\\\t    }\\\\n196\\\\t    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\\\\n197\\\\t      cwd: ctx.cwd,\\\\n198\\\\t      newThreadFilePath,\\\\n199\\\\t    };\\\\n200\\\\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\\\n201\\\\t    return resolveThread(launch, resolveDeps);\\\\n202\\\\t  }\\\\n203\\\\t\\\\n204\\\\t  // session_start: resolve the recording thread from the launch and construct\\\\n205\\\\t  // one background instance against it. Config is gated first so a session with\\\\n206\\\\t  // no usable inference config resolves/creates nothing (no orphan thread).\\\\n207\\\\t  const onSessionStart: PiHookHandler<\\\\\\\"session_start\\\\\\\"> = async (ctx, event) => {\\\\n208\\\\t    const config = buildSdkConfig(ctx);\\\\n209\\\\t    if (!config.ok) {\\\\n210\\\\t      lastDiagnostic = diag(\\\\\\\"instance_not_configured\\\\\\\", config.error.reason);\\\\n211\\\\t      return;\\\\n212\\\\t    }\\\\n213\\\\t    const resolved = await resolveForLaunch(launchFor(event), ctx);\\\\n214\\\\t    if (!resolved.ok) {\\\\n215\\\\t      lastDiagnostic = diag(\\\\\\\"thread_resolution_failed\\\\\\\", resolved.error.reason);\\\\n216\\\\t      return;\\\\n217\\\\t    }\\\\n218\\\\t    if (resolved.value === null) {\\\\n219\\\\t      lastDiagnostic = diag(\\\\\\\"no_thread_selected\\\\\\\", \\\\\\\"--resume resolved no thread\\\\\\\");\\\\n220\\\\t      return;\\\\n221\\\\t    }\\\\n222\\\\t    const built = await initInstance(resolved.value, config.value);\\\\n223\\\\t    if (!built.ok) {\\\\n224\\\\t      lastDiagnostic = diag(\\\\\\\"instance_init_failed\\\\\\\", built.error.reason);\\\\n225\\\\t      return;\\\\n226\\\\t    }\\\\n227\\\\t    instance = built.value;\\\\n228\\\\t    state = createSessionState(resolved.value);\\\\n229\\\\t    rememberedSessionThreadId = threadIdOf(resolved.value);\\\\n230\\\\t  };\\\\n231\\\\t\\\\n232\\\\t  // Dispose with flush before any session swap (session_before_switch fires\\\\n233\\\\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\\\n234\\\\t  // no live instance is a no-op. The durable reload id is kept across a reload\\\\n235\\\\t  // (the session continues and will reattach) and cleared on any other teardown\\\\n236\\\\t  // so a later new/resume session never reattaches a stale thread.\\\\n237\\\\t  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\\\\n238\\\\t    const result = await disposeInstance(instance);\\\\n239\\\\t    if (!result.ok) lastDiagnostic = diag(\\\\\\\"dispose_failed\\\\\\\", result.error.reason);\\\\n240\\\\t    instance = null;\\\\n241\\\\t    const isReload = \\\\\\\"reason\\\\\\\" in event && event.reason === \\\\\\\"reload\\\\\\\";\\\\n242\\\\t    if (!isReload) rememberedSessionThreadId = null;\\\\n243\\\\t  };\\\\n244\\\\t\\\\n245\\\\t  // Contain every handler: an observe-only hook must never throw back into PI\\\\n246\\\\t  // (a thrown hook breaks the user's session). A caught error becomes a\\\\n247\\\\t  // plain-data diagnostic; it is never rethrown.\\\\n248\\\\t  const guard = (\\\\n249\\\\t    name: Epic1Hook,\\\\n250\\\\t    body: PiHookHandler<Epic1Hook>,\\\\n251\\\\t  ): PiHookHandler<Epic1Hook> => {\\\\n252\\\\t    return async (ctx, event): Promise<void> => {\\\\n253\\\\t      try {\\\\n254\\\\t        await body(ctx, event);\\\\n255\\\\t      } catch (err) {\\\\n256\\\\t        lastDiagnostic = {\\\\n257\\\\t          code: \\\\\\\"hook_handler_error\\\\\\\",\\\\n258\\\\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\\\n259\\\\t          recordedGap: false,\\\\n260\\\\t        };\\\\n261\\\\t      }\\\\n262\\\\t    };\\\\n263\\\\t  };\\\\n264\\\\t\\\\n265\\\\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\\\\n266\\\\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\\\\n267\\\\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\\\\n268\\\\t  const noop: PiHookHandler<Epic1Hook> = () => {\\\\n269\\\\t    // Intentionally empty — later stories replace this with real routing.\\\\n270\\\\t  };\\\\n271\\\\t\\\\n272\\\\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\\\\n273\\\\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\\\n274\\\\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\\\n275\\\\t    session_before_switch: onDispose,\\\\n276\\\\t    session_shutdown: onDispose,\\\\n277\\\\t    message_end: noop,\\\\n278\\\\t    turn_end: noop,\\\\n279\\\\t    agent_end: noop,\\\\n280\\\\t    model_select: noop,\\\\n281\\\\t    thinking_level_select: noop,\\\\n282\\\\t    session_before_fork: noop,\\\\n283\\\\t  };\\\\n284\\\\t\\\\n285\\\\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\\\n286\\\\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\\\n287\\\\t\\\\n288\\\\t  return {\\\\n289\\\\t    handlers,\\\\n290\\\\t    register(pi: ExtensionAPI): void {\\\\n291\\\\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\\\n292\\\\t    },\\\\n293\\\\t    getState(): SessionState | null {\\\\n294\\\\t      return state;\\\\n295\\\\t    },\\\\n296\\\\t    getInstance(): LhcInstance | null {\\\\n297\\\\t      return instance;\\\\n298\\\\t    },\\\\n299\\\\t    snapshot(): ConnectorSnapshot {\\\\n300\\\\t      return { state, lastDiagnostic };\\\\n301\\\\t    },\\\\n302\\\\t  };\\\\n303\\\\t}\\\\n304\\\\t\\\\n305\\\\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\\\\n306\\\\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\\\n307\\\\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\\\n308\\\\t *  observe-only SDK config, the most-recent `--resume` selection, and the\\\\n309\\\\t *  module-level reload memory — so a live session_start resolves/creates and\\\\n310\\\\t *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\\\\n311\\\\t *  config; reload reconstruction reads the durable id the prior activation left\\\\n312\\\\t *  in the module-level memory. */\\\\n313\\\\texport function activate(pi: ExtensionAPI): void {\\\\n314\\\\t  createConnector().register(pi);\\\\n315\\\\t}\\\\n316\\\\t\\\\n317\\\\texport default activate;\\\\n318\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\\\",\\\"uuid\\\":\\\"5a41a4dd-b7c7-4410-b03f-951039537c07\\\",\\\"timestamp\\\":\\\"2026-06-14T05:25:35.197Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\\\",\\\"content\\\":\\\"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\\\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\\\n// handler. The connector owns only plain-data `SessionState` plus the live\\\\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\\\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\\\nimport { mkdirSync } from \\\\\\\"node:fs\\\\\\\";\\\\nimport { homedir } from \\\\\\\"node:os\\\\\\\";\\\\nimport { join } from \\\\\\\"node:path\\\\\\\";\\\\nimport { randomUUID } from \\\\\\\"node:crypto\\\\\\\";\\\\nimport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \\\\\\\"lhc\\\\\\\";\\\\nimport type {\\\\n  ExtensionAPI,\\\\n  ExtensionContext,\\\\n  PiHookHandler,\\\\n  PiHookName,\\\\n} from \\\\\\\"./pi/types.js\\\\\\\";\\\\nimport type { CaptureFailureDiagnostic, SessionState } from \\\\\\\"./lifecycle/state.js\\\\\\\";\\\\nimport { createSessionState } from \\\\\\\"./lifecycle/state.js\\\\\\\";\\\\nimport { disposeInstance, initInstance } from \\\\\\\"./lifecycle/instance.js\\\\\\\";\\\\nimport {\\\\n  parseLaunchFlags,\\\\n  resolveThread,\\\\n  type LaunchFlags,\\\\n} from \\\\\\\"./lifecycle/thread-resolution.js\\\\\\\";\\\\nimport { pickThread, type ThreadChoice } from \\\\\\\"./lifecycle/picker.js\\\\\\\";\\\\nimport type { LhcInstance } from \\\\\\\"./shared/instance.js\\\\\\\";\\\\n\\\\nexport { disposeInstance, initInstance, initLhc } from \\\\\\\"./lifecycle/instance.js\\\\\\\";\\\\nexport type { LhcInstance } from \\\\\\\"./shared/instance.js\\\\\\\";\\\\n\\\\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\\\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\\\n *  registers no handler for it (story Scope Out). */\\\\nexport const EPIC_1_HOOKS = [\\\\n  \\\\\\\"session_start\\\\\\\",\\\\n  \\\\\\\"message_end\\\\\\\",\\\\n  \\\\\\\"turn_end\\\\\\\",\\\\n  \\\\\\\"agent_end\\\\\\\",\\\\n  \\\\\\\"model_select\\\\\\\",\\\\n  \\\\\\\"thinking_level_select\\\\\\\",\\\\n  \\\\\\\"session_before_fork\\\\\\\",\\\\n  \\\\\\\"session_before_switch\\\\\\\",\\\\n  \\\\\\\"session_shutdown\\\\\\\",\\\\n] as const satisfies readonly PiHookName[];\\\\n\\\\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\\\n\\\\n/** What the connector needs from the host to run a session. Every dependency\\\\n *  has a working production default; the overrides exist for test isolation\\\\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\\\n *  in the PI-auth-backed inference config.\\\\n *\\\\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\\\n *  default is the observe-only config below (a real, construction-valid SDK);\\\\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\\\nexport interface ConnectorDeps {\\\\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\\\n  registryPath?: string;\\\\n  newThreadFilePath?: () => string;\\\\n  parseLaunch?: () => LaunchFlags;\\\\n  selectThread?: (\\\\n    choices: readonly ThreadChoice[],\\\\n    ctx: ExtensionContext,\\\\n  ) => Promise<string | null>;\\\\n}\\\\n\\\\n/** Everything the connector retains across hooks as PLAIN data — by\\\\n *  construction structuredClone-able. The live `LhcInstance` is held separately\\\\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\\\n *  deliberately not part of the snapshot. */\\\\nexport interface ConnectorSnapshot {\\\\n  state: SessionState | null;\\\\n  lastDiagnostic: CaptureFailureDiagnostic | null;\\\\n}\\\\n\\\\nexport interface Connector {\\\\n  /** Register the observe-only hook rail on the PI extension API. */\\\\n  register(pi: ExtensionAPI): void;\\\\n  /** The plain-data state retained across hooks. `null` until a session\\\\n   *  resolves a thread; never holds a PI ctx. */\\\\n  getState(): SessionState | null;\\\\n  /** The live LHC instance for the current session, or `null`. A test/inspection\\\\n   *  seam — held by the connector but never part of the plain-data snapshot. */\\\\n  getInstance(): LhcInstance | null;\\\\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\\\\n  snapshot(): ConnectorSnapshot;\\\\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\\\\n   *  synthetic ctx/events without a live PI. */\\\\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\\\n}\\\\n\\\\nconst DEFAULT_LHC_DIR = join(homedir(), \\\\\\\".lhc\\\\\\\");\\\\n\\\\n/** The production observe-only SDK config: a real, construction-valid instance\\\\n *  in background scheduler mode. Epic 1 is observe-only, so derivations are\\\\n *  never served to the model; in Story 1 specifically the connector does not yet\\\\n *  capture (message_end is a no-op until Story 2), so no derivation work is\\\\n *  queued and this provider is never invoked — it exists only to satisfy\\\\n *  construction (AC-1.1 \\\\\\\"initializes one LHC instance\\\\\\\"). Stories 5/6 replace it\\\\n *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\\\\n *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\\\\n *  package is not yet a build dependency of this workspace). */\\\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\\\n  return { ok: true, value: { provider: createDeterministicProvider(), mode: \\\\\\\"background\\\\\\\" } };\\\\n}\\\\n\\\\n/** Default `--resume` selection (sufficient for Story 1): resume the most\\\\n *  recently created thread in the cwd. The choices arrive in creation order, so\\\\n *  the last is the most recent. An interactive operator picker awaits a PI input\\\\n *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\\\\n *  then this is the production selection, and tests drive an explicit choice\\\\n *  through the injected selector. */\\\\nfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\\\\n  const mostRecent = choices.at(-1);\\\\n  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\\\\n}\\\\n\\\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\\\n *  generated by the registry at creation, so the file name is just a unique\\\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\\\n *  parents). */\\\\nfunction defaultNewThreadFilePath(): string {\\\\n  const dir = join(DEFAULT_LHC_DIR, \\\\\\\"threads\\\\\\\");\\\\n  mkdirSync(dir, { recursive: true });\\\\n  return join(dir, `${randomUUID()}.sqlite`);\\\\n}\\\\n\\\\nfunction threadIdOf(ref: ThreadRef): string | null {\\\\n  return \\\\\\\"threadId\\\\\\\" in ref ? ref.threadId : null;\\\\n}\\\\n\\\\n// The durable resolved thread id for the current session, held at MODULE scope\\\\n// (not in a connector closure) so it survives the extension teardown/re-init a\\\\n// reload performs: a PI process runs one session at a time, so a single\\\\n// \\\\\\\"current thread id\\\\\\\" is unambiguous, and a fresh connector created by the next\\\\n// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\\\\n// PI-session→thread mapping or a durable file — so process death correctly drops\\\\n// it and the next launch re-resolves (no early-crash window, no recovery\\\\n// sidecar; epic I-1). Cleared on any non-reload teardown.\\\\nlet rememberedSessionThreadId: string | null = null;\\\\n\\\\n/** Reset the module-level reload memory. Test seam so each test starts from a\\\\n *  clean durable state; also the hook a full teardown would call. */\\\\nexport function resetSessionThreadMemory(): void {\\\\n  rememberedSessionThreadId = null;\\\\n}\\\\n\\\\n/** Build a connector instance. Its mutable state lives in this closure; the\\\\n *  registered handlers capture it, so the instance stays live for the session\\\\n *  even when `activate` discards the returned object. */\\\\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\\\\n  // The connector's retained state. `state` is plain data (the durable thread\\\\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\\\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\\\\n  // durable reload id lives at MODULE scope (above), not here, so it survives\\\\n  // this closure being torn down on reload.\\\\n  let state: SessionState | null = null;\\\\n  let instance: LhcInstance | null = null;\\\\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\\\n\\\\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\\\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\\\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\\\n  const selectThread = deps.selectThread ?? defaultSelectThread;\\\\n\\\\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\\\\n    return { code, message, recordedGap: false };\\\\n  }\\\\n\\\\n  // On reload (same session continues, the connector torn down and re-created)\\\\n  // reconstruct the SAME thread from its durable id rather than re-running the\\\\n  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\\\\n  // id is read from the module-level reload memory, which survives this closure;\\\\n  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\\\\n  // the fallback, covering --session/--continue/--resume reloads. The permanent\\\\n  // home for reload lineage is LHC thread metadata (Feature 2+).\\\\n  function launchFor(event: { reason: string }): LaunchFlags {\\\\n    if (event.reason === \\\\\\\"reload\\\\\\\" && rememberedSessionThreadId !== null) {\\\\n      return { session: rememberedSessionThreadId };\\\\n    }\\\\n    return parseLaunch();\\\\n  }\\\\n\\\\n  async function resolveForLaunch(\\\\n    launch: LaunchFlags,\\\\n    ctx: ExtensionContext,\\\\n  ): Promise<OpResult<ThreadRef | null>> {\\\\n    if (launch.resume === true) {\\\\n      const pickerDeps: {\\\\n        registryPath?: string;\\\\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\\\n      } = { select: (choices) => selectThread(choices, ctx) };\\\\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\\\n      return pickThread(ctx.cwd, pickerDeps);\\\\n    }\\\\n    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\\\\n      cwd: ctx.cwd,\\\\n      newThreadFilePath,\\\\n    };\\\\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\\\n    return resolveThread(launch, resolveDeps);\\\\n  }\\\\n\\\\n  // session_start: resolve the recording thread from the launch and construct\\\\n  // one background instance against it. Config is gated first so a session with\\\\n  // no usable inference config resolves/creates nothing (no orphan thread).\\\\n  const onSessionStart: PiHookHandler<\\\\\\\"session_start\\\\\\\"> = async (ctx, event) => {\\\\n    const config = buildSdkConfig(ctx);\\\\n    if (!config.ok) {\\\\n      lastDiagnostic = diag(\\\\\\\"instance_not_configured\\\\\\\", config.error.reason);\\\\n      return;\\\\n    }\\\\n    const resolved = await resolveForLaunch(launchFor(event), ctx);\\\\n    if (!resolved.ok) {\\\\n      lastDiagnostic = diag(\\\\\\\"thread_resolution_failed\\\\\\\", resolved.error.reason);\\\\n      return;\\\\n    }\\\\n    if (resolved.value === null) {\\\\n      lastDiagnostic = diag(\\\\\\\"no_thread_selected\\\\\\\", \\\\\\\"--resume resolved no thread\\\\\\\");\\\\n      return;\\\\n    }\\\\n    const built = await initInstance(resolved.value, config.value);\\\\n    if (!built.ok) {\\\\n      lastDiagnostic = diag(\\\\\\\"instance_init_failed\\\\\\\", built.error.reason);\\\\n      return;\\\\n    }\\\\n    instance = built.value;\\\\n    state = createSessionState(resolved.value);\\\\n    rememberedSessionThreadId = threadIdOf(resolved.value);\\\\n  };\\\\n\\\\n  // Dispose with flush before any session swap (session_before_switch fires\\\\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\\\n  // no live instance is a no-op. The durable reload id is kept across a reload\\\\n  // (the session continues and will reattach) and cleared on any other teardown\\\\n  // so a later new/resume session never reattaches a stale thread.\\\\n  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\\\\n    const result = await disposeInstance(instance);\\\\n    if (!result.ok) lastDiagnostic = diag(\\\\\\\"dispose_failed\\\\\\\", result.error.reason);\\\\n    instance = null;\\\\n    const isReload = \\\\\\\"reason\\\\\\\" in event && event.reason === \\\\\\\"reload\\\\\\\";\\\\n    if (!isReload) rememberedSessionThreadId = null;\\\\n  };\\\\n\\\\n  // Contain every handler: an observe-only hook must never throw back into PI\\\\n  // (a thrown hook breaks the user's session). A caught error becomes a\\\\n  // plain-data diagnostic; it is never rethrown.\\\\n  const guard = (\\\\n    name: Epic1Hook,\\\\n    body: PiHookHandler<Epic1Hook>,\\\\n  ): PiHookHandler<Epic1Hook> => {\\\\n    return async (ctx, event): Promise<void> => {\\\\n      try {\\\\n        await body(ctx, event);\\\\n      } catch (err) {\\\\n        lastDiagnostic = {\\\\n          code: \\\\\\\"hook_handler_error\\\\\\\",\\\\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\\\n          recordedGap: false,\\\\n        };\\\\n      }\\\\n    };\\\\n  };\\\\n\\\\n  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\\\\n  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\\\\n  // land in later stories. Each receives a FRESH ctx and retains none of it.\\\\n  const noop: PiHookHandler<Epic1Hook> = () => {\\\\n    // Intentionally empty — later stories replace this with real routing.\\\\n  };\\\\n\\\\n  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\\\\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\\\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\\\n    session_before_switch: onDispose,\\\\n    session_shutdown: onDispose,\\\\n    message_end: noop,\\\\n    turn_end: noop,\\\\n    agent_end: noop,\\\\n    model_select: noop,\\\\n    thinking_level_select: noop,\\\\n    session_before_fork: noop,\\\\n  };\\\\n\\\\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\\\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\\\n\\\\n  return {\\\\n    handlers,\\\\n    register(pi: ExtensionAPI): void {\\\\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\\\n    },\\\\n    getState(): SessionState | null {\\\\n      return state;\\\\n    },\\\\n    getInstance(): LhcInstance | null {\\\\n      return instance;\\\\n    },\\\\n    snapshot(): ConnectorSnapshot {\\\\n      return { state, lastDiagnostic };\\\\n    },\\\\n  };\\\\n}\\\\n\\\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\\\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\\\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\\\n *  observe-only SDK config, the most-recent `--resume` selection, and the\\\\n *  module-level reload memory — so a live session_start resolves/creates and\\\\n *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\\\\n *  config; reload reconstruction reads the durable id the prior activation left\\\\n *  in the module-level memory. */\\\\nexport function activate(pi: ExtensionAPI): void {\\\\n  createConnector().register(pi);\\\\n}\\\\n\\\\nexport default activate;\\\\n\\\",\\\"numLines\\\":318,\\\"startLine\\\":1,\\\"totalLines\\\":318}}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:349:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01BAwW6Bj3nCk5dEyruuSdgh\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t// Local declarations of the PI extension surface the connector consumes.\\\\n2\\\\t//\\\\n3\\\\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\\\\n4\\\\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\\\\n5\\\\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\\\\n6\\\\t// build-time dependency of this workspace, so the connector declares the slice\\\\n7\\\\t// of their contract it touches and swaps to the real imports when the\\\\n8\\\\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\\\\n9\\\\t// surface here — rather than scattered `any` — means later stories get real\\\\n10\\\\t// type-checking against the contract PI actually fires.\\\\n11\\\\t\\\\n12\\\\t// ── Hook vocabulary ──────────────────────────────────────────────────\\\\n13\\\\t\\\\n14\\\\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\\\\n15\\\\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\\\\n16\\\\t *  serving is Epic 2. */\\\\n17\\\\texport type PiHookName =\\\\n18\\\\t  | \\\\\\\"session_start\\\\\\\"\\\\n19\\\\t  | \\\\\\\"message_end\\\\\\\"\\\\n20\\\\t  | \\\\\\\"turn_end\\\\\\\"\\\\n21\\\\t  | \\\\\\\"agent_end\\\\\\\"\\\\n22\\\\t  | \\\\\\\"model_select\\\\\\\"\\\\n23\\\\t  | \\\\\\\"thinking_level_select\\\\\\\"\\\\n24\\\\t  | \\\\\\\"session_before_fork\\\\\\\"\\\\n25\\\\t  | \\\\\\\"session_before_switch\\\\\\\"\\\\n26\\\\t  | \\\\\\\"session_shutdown\\\\\\\"\\\\n27\\\\t  | \\\\\\\"context\\\\\\\";\\\\n28\\\\t\\\\n29\\\\texport type SessionStartReason = \\\\\\\"startup\\\\\\\" | \\\\\\\"reload\\\\\\\" | \\\\\\\"new\\\\\\\" | \\\\\\\"resume\\\\\\\" | \\\\\\\"fork\\\\\\\";\\\\n30\\\\texport type SessionShutdownReason = \\\\\\\"shutdown\\\\\\\" | \\\\\\\"reload\\\\\\\" | \\\\\\\"new\\\\\\\" | \\\\\\\"resume\\\\\\\";\\\\n31\\\\t\\\\n32\\\\texport interface SessionStartEvent {\\\\n33\\\\t  reason: SessionStartReason;\\\\n34\\\\t  previousSessionFile?: string;\\\\n35\\\\t}\\\\n36\\\\texport interface MessageEndEvent {\\\\n37\\\\t  message: AgentMessage;\\\\n38\\\\t}\\\\n39\\\\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\\\\n40\\\\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\\\\n41\\\\texport interface TurnEndEvent {\\\\n42\\\\t  turnIndex: number;\\\\n43\\\\t  message: AgentMessage;\\\\n44\\\\t  toolResults: ToolResultMessage[];\\\\n45\\\\t  stopReason?: PiStopReason;\\\\n46\\\\t}\\\\n47\\\\texport interface AgentEndEvent {\\\\n48\\\\t  messages: AgentMessage[];\\\\n49\\\\t}\\\\n50\\\\texport interface ModelSelectEvent {\\\\n51\\\\t  model: ModelDescriptor;\\\\n52\\\\t  previousModel?: ModelDescriptor;\\\\n53\\\\t  source?: string;\\\\n54\\\\t}\\\\n55\\\\texport interface ThinkingLevelSelectEvent {\\\\n56\\\\t  level: string;\\\\n57\\\\t  previousLevel: string;\\\\n58\\\\t}\\\\n59\\\\texport interface SessionBeforeForkEvent {\\\\n60\\\\t  entryId: string;\\\\n61\\\\t  position?: number;\\\\n62\\\\t}\\\\n63\\\\texport interface SessionBeforeSwitchEvent {\\\\n64\\\\t  intent: \\\\\\\"new\\\\\\\" | \\\\\\\"resume\\\\\\\";\\\\n65\\\\t}\\\\n66\\\\texport interface SessionShutdownEvent {\\\\n67\\\\t  reason: SessionShutdownReason;\\\\n68\\\\t  targetSessionFile?: string;\\\\n69\\\\t}\\\\n70\\\\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\\\\n71\\\\texport interface ContextEvent {\\\\n72\\\\t  messages: AgentMessage[];\\\\n73\\\\t}\\\\n74\\\\t\\\\n75\\\\t/** Maps each hook to the payload PI delivers with it. */\\\\n76\\\\texport interface PiHookEventMap {\\\\n77\\\\t  session_start: SessionStartEvent;\\\\n78\\\\t  message_end: MessageEndEvent;\\\\n79\\\\t  turn_end: TurnEndEvent;\\\\n80\\\\t  agent_end: AgentEndEvent;\\\\n81\\\\t  model_select: ModelSelectEvent;\\\\n82\\\\t  thinking_level_select: ThinkingLevelSelectEvent;\\\\n83\\\\t  session_before_fork: SessionBeforeForkEvent;\\\\n84\\\\t  session_before_switch: SessionBeforeSwitchEvent;\\\\n85\\\\t  session_shutdown: SessionShutdownEvent;\\\\n86\\\\t  context: ContextEvent;\\\\n87\\\\t}\\\\n88\\\\t\\\\n89\\\\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\\\\n90\\\\t *  connector must never retain it across calls (PI replaces session objects on\\\\n91\\\\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\\\\n92\\\\texport type PiHookHandler<N extends PiHookName> = (\\\\n93\\\\t  ctx: ExtensionContext,\\\\n94\\\\t  event: PiHookEventMap[N],\\\\n95\\\\t) => void | Promise<void>;\\\\n96\\\\t\\\\n97\\\\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\\\\n98\\\\t\\\\n99\\\\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\\\\n100\\\\t\\\\n101\\\\texport interface PiToolSpec {\\\\n102\\\\t  name: string;\\\\n103\\\\t  description?: string;\\\\n104\\\\t  promptSnippet?: string;\\\\n105\\\\t  promptGuidelines?: string;\\\\n106\\\\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\\\\n107\\\\t}\\\\n108\\\\t\\\\n109\\\\t/** The factory-time API. Hook registration and command/tool registration take\\\\n110\\\\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\\\\n111\\\\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\\\\n112\\\\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\\\\n113\\\\texport interface ExtensionAPI {\\\\n114\\\\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\\\\n115\\\\t  registerCommand(name: string, handler: PiCommandHandler): void;\\\\n116\\\\t  registerTool(tool: PiToolSpec): void;\\\\n117\\\\t  appendEntry(customType: string, data: unknown): void;\\\\n118\\\\t}\\\\n119\\\\t\\\\n120\\\\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\\\\n121\\\\t\\\\n122\\\\texport interface ModelDescriptor {\\\\n123\\\\t  provider: string;\\\\n124\\\\t  id: string;\\\\n125\\\\t}\\\\n126\\\\t\\\\n127\\\\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\\\\n128\\\\t *  owns. The connector treats provider/model as opaque routing keys. */\\\\n129\\\\texport interface ModelHandle extends ModelDescriptor {\\\\n130\\\\t  readonly [k: string]: unknown;\\\\n131\\\\t}\\\\n132\\\\t\\\\n133\\\\texport interface ModelRegistry {\\\\n134\\\\t  find(provider: string, model: string): ModelHandle | undefined;\\\\n135\\\\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\\\\n136\\\\t  getAvailable(): ModelHandle[];\\\\n137\\\\t}\\\\n138\\\\t\\\\n139\\\\texport interface ExtensionUI {\\\\n140\\\\t  notify(message: string, options?: { level?: \\\\\\\"info\\\\\\\" | \\\\\\\"warn\\\\\\\" | \\\\\\\"error\\\\\\\" }): void;\\\\n141\\\\t}\\\\n142\\\\t\\\\n143\\\\texport interface SessionEntry {\\\\n144\\\\t  type: string;\\\\n145\\\\t  readonly [k: string]: unknown;\\\\n146\\\\t}\\\\n147\\\\t\\\\n148\\\\texport interface SessionManager {\\\\n149\\\\t  getEntries(): SessionEntry[];\\\\n150\\\\t}\\\\n151\\\\t\\\\n152\\\\texport interface ExtensionContext {\\\\n153\\\\t  modelRegistry: ModelRegistry;\\\\n154\\\\t  ui: ExtensionUI;\\\\n155\\\\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\\\\n156\\\\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\\\\n157\\\\t  hasUI: boolean;\\\\n158\\\\t  sessionManager: SessionManager;\\\\n159\\\\t  cwd: string;\\\\n160\\\\t}\\\\n161\\\\t\\\\n162\\\\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\\\\n163\\\\t\\\\n164\\\\texport interface TextPart {\\\\n165\\\\t  type: \\\\\\\"text\\\\\\\";\\\\n166\\\\t  text: string;\\\\n167\\\\t}\\\\n168\\\\texport interface ThinkingPart {\\\\n169\\\\t  type: \\\\\\\"thinking\\\\\\\";\\\\n170\\\\t  thinking: string;\\\\n171\\\\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\\\\n172\\\\t   *  Epic 1 (tech design I-3). */\\\\n173\\\\t  thinkingSignature?: string;\\\\n174\\\\t}\\\\n175\\\\texport interface ToolCallPart {\\\\n176\\\\t  type: \\\\\\\"toolCall\\\\\\\";\\\\n177\\\\t  /** Composite, stable across tool_execution_start → tool_result → message_end\\\\n178\\\\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\\\\n179\\\\t  id: string;\\\\n180\\\\t  name: string;\\\\n181\\\\t  arguments: Record<string, unknown>;\\\\n182\\\\t  /** Opaque; captured, not interpreted (tech design I-3). */\\\\n183\\\\t  thoughtSignature?: string;\\\\n184\\\\t}\\\\n185\\\\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\\\\n186\\\\t *  the converter (tech design I-6), never silently dropped. */\\\\n187\\\\texport interface ImagePart {\\\\n188\\\\t  type: \\\\\\\"image\\\\\\\";\\\\n189\\\\t  mimeType?: string;\\\\n190\\\\t  data?: string;\\\\n191\\\\t}\\\\n192\\\\texport interface FileRefPart {\\\\n193\\\\t  type: \\\\\\\"fileRef\\\\\\\";\\\\n194\\\\t  path: string;\\\\n195\\\\t}\\\\n196\\\\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\\\\n197\\\\t\\\\n198\\\\texport type PiStopReason = \\\\\\\"stop\\\\\\\" | \\\\\\\"aborted\\\\\\\" | \\\\\\\"length\\\\\\\" | \\\\\\\"toolUse\\\\\\\" | (string & {});\\\\n199\\\\t\\\\n200\\\\texport interface TokenUsage {\\\\n201\\\\t  inputTokens?: number;\\\\n202\\\\t  outputTokens?: number;\\\\n203\\\\t}\\\\n204\\\\t\\\\n205\\\\texport interface UserMessage {\\\\n206\\\\t  role: \\\\\\\"user\\\\\\\";\\\\n207\\\\t  content: ContentPart[];\\\\n208\\\\t}\\\\n209\\\\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\\\\n210\\\\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\\\\n211\\\\texport interface AssistantMessage {\\\\n212\\\\t  role: \\\\\\\"assistant\\\\\\\";\\\\n213\\\\t  content: ContentPart[];\\\\n214\\\\t  stopReason?: PiStopReason;\\\\n215\\\\t  usage?: TokenUsage;\\\\n216\\\\t}\\\\n217\\\\texport interface ToolResultMessage {\\\\n218\\\\t  role: \\\\\\\"toolResult\\\\\\\";\\\\n219\\\\t  toolCallId: string;\\\\n220\\\\t  content: ContentPart[];\\\\n221\\\\t  isError?: boolean;\\\\n222\\\\t}\\\\n223\\\\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\\\\n224\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\\\",\\\"uuid\\\":\\\"3dd4b46b-881d-4fca-88da-711de3e4f70d\\\",\\\"timestamp\\\":\\\"2026-06-14T05:25:35.812Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/pi/types.ts\\\",\\\"content\\\":\\\"// Local declarations of the PI extension surface the connector consumes.\\\\n//\\\\n// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\\\\n// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\\\\n// headless + interactive recon, June 12 2026). The PI packages are not yet a\\\\n// build-time dependency of this workspace, so the connector declares the slice\\\\n// of their contract it touches and swaps to the real imports when the\\\\n// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\\\\n// surface here — rather than scattered `any` — means later stories get real\\\\n// type-checking against the contract PI actually fires.\\\\n\\\\n// ── Hook vocabulary ──────────────────────────────────────────────────\\\\n\\\\n/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\\\\n *  `context` is fired by PI but Epic 1 registers no handler for it — context\\\\n *  serving is Epic 2. */\\\\nexport type PiHookName =\\\\n  | \\\\\\\"session_start\\\\\\\"\\\\n  | \\\\\\\"message_end\\\\\\\"\\\\n  | \\\\\\\"turn_end\\\\\\\"\\\\n  | \\\\\\\"agent_end\\\\\\\"\\\\n  | \\\\\\\"model_select\\\\\\\"\\\\n  | \\\\\\\"thinking_level_select\\\\\\\"\\\\n  | \\\\\\\"session_before_fork\\\\\\\"\\\\n  | \\\\\\\"session_before_switch\\\\\\\"\\\\n  | \\\\\\\"session_shutdown\\\\\\\"\\\\n  | \\\\\\\"context\\\\\\\";\\\\n\\\\nexport type SessionStartReason = \\\\\\\"startup\\\\\\\" | \\\\\\\"reload\\\\\\\" | \\\\\\\"new\\\\\\\" | \\\\\\\"resume\\\\\\\" | \\\\\\\"fork\\\\\\\";\\\\nexport type SessionShutdownReason = \\\\\\\"shutdown\\\\\\\" | \\\\\\\"reload\\\\\\\" | \\\\\\\"new\\\\\\\" | \\\\\\\"resume\\\\\\\";\\\\n\\\\nexport interface SessionStartEvent {\\\\n  reason: SessionStartReason;\\\\n  previousSessionFile?: string;\\\\n}\\\\nexport interface MessageEndEvent {\\\\n  message: AgentMessage;\\\\n}\\\\n/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\\\\n *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\\\\nexport interface TurnEndEvent {\\\\n  turnIndex: number;\\\\n  message: AgentMessage;\\\\n  toolResults: ToolResultMessage[];\\\\n  stopReason?: PiStopReason;\\\\n}\\\\nexport interface AgentEndEvent {\\\\n  messages: AgentMessage[];\\\\n}\\\\nexport interface ModelSelectEvent {\\\\n  model: ModelDescriptor;\\\\n  previousModel?: ModelDescriptor;\\\\n  source?: string;\\\\n}\\\\nexport interface ThinkingLevelSelectEvent {\\\\n  level: string;\\\\n  previousLevel: string;\\\\n}\\\\nexport interface SessionBeforeForkEvent {\\\\n  entryId: string;\\\\n  position?: number;\\\\n}\\\\nexport interface SessionBeforeSwitchEvent {\\\\n  intent: \\\\\\\"new\\\\\\\" | \\\\\\\"resume\\\\\\\";\\\\n}\\\\nexport interface SessionShutdownEvent {\\\\n  reason: SessionShutdownReason;\\\\n  targetSessionFile?: string;\\\\n}\\\\n/** Declared for completeness; Epic 1 registers no handler (observe-only). */\\\\nexport interface ContextEvent {\\\\n  messages: AgentMessage[];\\\\n}\\\\n\\\\n/** Maps each hook to the payload PI delivers with it. */\\\\nexport interface PiHookEventMap {\\\\n  session_start: SessionStartEvent;\\\\n  message_end: MessageEndEvent;\\\\n  turn_end: TurnEndEvent;\\\\n  agent_end: AgentEndEvent;\\\\n  model_select: ModelSelectEvent;\\\\n  thinking_level_select: ThinkingLevelSelectEvent;\\\\n  session_before_fork: SessionBeforeForkEvent;\\\\n  session_before_switch: SessionBeforeSwitchEvent;\\\\n  session_shutdown: SessionShutdownEvent;\\\\n  context: ContextEvent;\\\\n}\\\\n\\\\n/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\\\\n *  connector must never retain it across calls (PI replaces session objects on\\\\n *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\\\\nexport type PiHookHandler<N extends PiHookName> = (\\\\n  ctx: ExtensionContext,\\\\n  event: PiHookEventMap[N],\\\\n) => void | Promise<void>;\\\\n\\\\n// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\\\\n\\\\nexport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\\\\n\\\\nexport interface PiToolSpec {\\\\n  name: string;\\\\n  description?: string;\\\\n  promptSnippet?: string;\\\\n  promptGuidelines?: string;\\\\n  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\\\\n}\\\\n\\\\n/** The factory-time API. Hook registration and command/tool registration take\\\\n *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\\\\n *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\\\\n *  exposes them, but Epic 1 (observe-only) registers only hooks. */\\\\nexport interface ExtensionAPI {\\\\n  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\\\\n  registerCommand(name: string, handler: PiCommandHandler): void;\\\\n  registerTool(tool: PiToolSpec): void;\\\\n  appendEntry(customType: string, data: unknown): void;\\\\n}\\\\n\\\\n// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\\\\n\\\\nexport interface ModelDescriptor {\\\\n  provider: string;\\\\n  id: string;\\\\n}\\\\n\\\\n/** Opaque handle the model registry returns; it carries auth/runtime detail PI\\\\n *  owns. The connector treats provider/model as opaque routing keys. */\\\\nexport interface ModelHandle extends ModelDescriptor {\\\\n  readonly [k: string]: unknown;\\\\n}\\\\n\\\\nexport interface ModelRegistry {\\\\n  find(provider: string, model: string): ModelHandle | undefined;\\\\n  hasConfiguredAuth(model: ModelHandle | string): boolean;\\\\n  getAvailable(): ModelHandle[];\\\\n}\\\\n\\\\nexport interface ExtensionUI {\\\\n  notify(message: string, options?: { level?: \\\\\\\"info\\\\\\\" | \\\\\\\"warn\\\\\\\" | \\\\\\\"error\\\\\\\" }): void;\\\\n}\\\\n\\\\nexport interface SessionEntry {\\\\n  type: string;\\\\n  readonly [k: string]: unknown;\\\\n}\\\\n\\\\nexport interface SessionManager {\\\\n  getEntries(): SessionEntry[];\\\\n}\\\\n\\\\nexport interface ExtensionContext {\\\\n  modelRegistry: ModelRegistry;\\\\n  ui: ExtensionUI;\\\\n  /** Guard UI surfacing on this — the extension must work in rpc/json/print\\\\n   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\\\\n  hasUI: boolean;\\\\n  sessionManager: SessionManager;\\\\n  cwd: string;\\\\n}\\\\n\\\\n// ── Message vocabulary (AgentMessage and its parts) ──────────────────\\\\n\\\\nexport interface TextPart {\\\\n  type: \\\\\\\"text\\\\\\\";\\\\n  text: string;\\\\n}\\\\nexport interface ThinkingPart {\\\\n  type: \\\\\\\"thinking\\\\\\\";\\\\n  thinking: string;\\\\n  /** Opaque provider reasoning token — captured, not interpreted; dropped in\\\\n   *  Epic 1 (tech design I-3). */\\\\n  thinkingSignature?: string;\\\\n}\\\\nexport interface ToolCallPart {\\\\n  type: \\\\\\\"toolCall\\\\\\\";\\\\n  /** Composite, stable across tool_execution_start → tool_result → message_end\\\\n   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\\\\n  id: string;\\\\n  name: string;\\\\n  arguments: Record<string, unknown>;\\\\n  /** Opaque; captured, not interpreted (tech design I-3). */\\\\n  thoughtSignature?: string;\\\\n}\\\\n/** Unsupported in the text-only intake schema — degrades to a runtime_note in\\\\n *  the converter (tech design I-6), never silently dropped. */\\\\nexport interface ImagePart {\\\\n  type: \\\\\\\"image\\\\\\\";\\\\n  mimeType?: string;\\\\n  data?: string;\\\\n}\\\\nexport interface FileRefPart {\\\\n  type: \\\\\\\"fileRef\\\\\\\";\\\\n  path: string;\\\\n}\\\\nexport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\\\\n\\\\nexport type PiStopReason = \\\\\\\"stop\\\\\\\" | \\\\\\\"aborted\\\\\\\" | \\\\\\\"length\\\\\\\" | \\\\\\\"toolUse\\\\\\\" | (string & {});\\\\n\\\\nexport interface TokenUsage {\\\\n  inputTokens?: number;\\\\n  outputTokens?: number;\\\\n}\\\\n\\\\nexport interface UserMessage {\\\\n  role: \\\\\\\"user\\\\\\\";\\\\n  content: ContentPart[];\\\\n}\\\\n/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\\\\n *  host maps it to text or a classified failure (Epic 1 Story 5). */\\\\nexport interface AssistantMessage {\\\\n  role: \\\\\\\"assistant\\\\\\\";\\\\n  content: ContentPart[];\\\\n  stopReason?: PiStopReason;\\\\n  usage?: TokenUsage;\\\\n}\\\\nexport interface ToolResultMessage {\\\\n  role: \\\\\\\"toolResult\\\\\\\";\\\\n  toolCallId: string;\\\\n  content: ContentPart[];\\\\n  isError?: boolean;\\\\n}\\\\nexport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\\\\n\\\",\\\"numLines\\\":224,\\\"startLine\\\":1,\\\"totalLines\\\":224}}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:544:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01PipoZgmBF7jaz45X7Qsggs\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\\\\n2\\\\t// reconstruction. Two layers are covered: the resolver/picker functions\\\\n3\\\\t// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\\\\n4\\\\t// PRODUCTION connector path through createConnector with real defaults (no\\\\n5\\\\t// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\\\\n6\\\\t// throughout; the module-level reload memory is reset per test.\\\\n7\\\\timport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\n8\\\\timport {\\\\n9\\\\t  createDeterministicProvider,\\\\n10\\\\t  inspect,\\\\n11\\\\t  threads,\\\\n12\\\\t  type SdkConfig,\\\\n13\\\\t  type ThreadRef,\\\\n14\\\\t} from \\\\\\\"lhc\\\\\\\";\\\\n15\\\\timport { createConnector, resetSessionThreadMemory } from \\\\\\\"../../src/index.js\\\\\\\";\\\\n16\\\\timport { disposeInstance, initInstance } from \\\\\\\"../../src/lifecycle/instance.js\\\\\\\";\\\\n17\\\\timport {\\\\n18\\\\t  defaultThreadTitle,\\\\n19\\\\t  parseLaunchFlags,\\\\n20\\\\t  resolveThread,\\\\n21\\\\t  type ResolveDeps,\\\\n22\\\\t} from \\\\\\\"../../src/lifecycle/thread-resolution.js\\\\\\\";\\\\n23\\\\timport { pickThread, type ThreadChoice } from \\\\\\\"../../src/lifecycle/picker.js\\\\\\\";\\\\n24\\\\timport type { ExtensionContext } from \\\\\\\"../../src/pi/types.js\\\\\\\";\\\\n25\\\\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\\\\\"../fixtures/synthetic.js\\\\\\\";\\\\n26\\\\timport { tempStore, type TempStore } from \\\\\\\"../fixtures/thread.js\\\\\\\";\\\\n27\\\\t\\\\n28\\\\tlet store: TempStore;\\\\n29\\\\tbeforeEach(() => {\\\\n30\\\\t  store = tempStore();\\\\n31\\\\t  resetSessionThreadMemory(); // the connector's reload memory is module-level\\\\n32\\\\t});\\\\n33\\\\tafterEach(() => {\\\\n34\\\\t  store.cleanup();\\\\n35\\\\t});\\\\n36\\\\t\\\\n37\\\\tfunction backgroundConfig(): SdkConfig {\\\\n38\\\\t  return { provider: createDeterministicProvider(), mode: \\\\\\\"background\\\\\\\" };\\\\n39\\\\t}\\\\n40\\\\t\\\\n41\\\\tfunction idOf(ref: ThreadRef): string {\\\\n42\\\\t  if (!(\\\\\\\"threadId\\\\\\\" in ref)) throw new Error(\\\\\\\"expected a { threadId } ref\\\\\\\");\\\\n43\\\\t  return ref.threadId;\\\\n44\\\\t}\\\\n45\\\\t\\\\n46\\\\tfunction deps(cwd = \\\\\\\"/work/default\\\\\\\"): ResolveDeps {\\\\n47\\\\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\\\n48\\\\t}\\\\n49\\\\t\\\\n50\\\\t// Create a thread directly with explicit cwd/title, for picker fixtures and\\\\n51\\\\t// existing-thread setup. (Connector-created threads get cwd plus a default title\\\\n52\\\\t// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\\\\n53\\\\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\\\\n54\\\\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\\\\n55\\\\t    filePath: store.threadPath(),\\\\n56\\\\t    registryPath: store.registryPath,\\\\n57\\\\t  };\\\\n58\\\\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\\\n59\\\\t  if (opts.title !== undefined) input.title = opts.title;\\\\n60\\\\t  const created = await threads.newThread(input);\\\\n61\\\\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\\\\n62\\\\t  return created.value.threadId;\\\\n63\\\\t}\\\\n64\\\\t\\\\n65\\\\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\\\\n66\\\\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\\\\n67\\\\t// object, modelling PI handing a fresh ctx to each hook.\\\\n68\\\\tfunction syntheticCtx(cwd: string): ExtensionContext {\\\\n69\\\\t  return {\\\\n70\\\\t    cwd,\\\\n71\\\\t    hasUI: false,\\\\n72\\\\t    modelRegistry: {\\\\n73\\\\t      find: () => undefined,\\\\n74\\\\t      hasConfiguredAuth: () => false,\\\\n75\\\\t      getAvailable: () => [],\\\\n76\\\\t    },\\\\n77\\\\t    ui: { notify: () => {} },\\\\n78\\\\t    sessionManager: { getEntries: () => [] },\\\\n79\\\\t  };\\\\n80\\\\t}\\\\n81\\\\t\\\\n82\\\\t// A connector wired with production defaults (real SDK config + selector) and\\\\n83\\\\t// only environment overrides — the activate() path, minus the global registry\\\\n84\\\\t// and process.argv.\\\\n85\\\\tfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\\\\n86\\\\t  return createConnector({\\\\n87\\\\t    registryPath: store.registryPath,\\\\n88\\\\t    newThreadFilePath: () => store.threadPath(),\\\\n89\\\\t    parseLaunch: launch,\\\\n90\\\\t  });\\\\n91\\\\t}\\\\n92\\\\t\\\\n93\\\\tasync function threadCount(): Promise<number> {\\\\n94\\\\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\\\\n95\\\\t  return listed.ok ? listed.value.length : -1;\\\\n96\\\\t}\\\\n97\\\\t\\\\n98\\\\tdescribe(\\\\\\\"Story 1: launch-driven thread resolution (resolver/picker)\\\\\\\", () => {\\\\n99\\\\t  it(\\\\\\\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\\\\\\\", async () => {\\\\n100\\\\t    // no flag → a new thread\\\\n101\\\\t    const first = await resolveThread({}, deps());\\\\n102\\\\t    expect(first.ok).toBe(true);\\\\n103\\\\t    if (!first.ok) return;\\\\n104\\\\t    const firstId = idOf(first.value);\\\\n105\\\\t\\\\n106\\\\t    // --session full id → the same thread\\\\n107\\\\t    const byFull = await resolveThread({ session: firstId }, deps());\\\\n108\\\\t    expect(byFull.ok).toBe(true);\\\\n109\\\\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\\\\n110\\\\t\\\\n111\\\\t    // --session partial id → the same thread\\\\n112\\\\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\\\\n113\\\\t    expect(byPartial.ok).toBe(true);\\\\n114\\\\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\\\\n115\\\\t\\\\n116\\\\t    // a second thread, then --continue → the most recently created\\\\n117\\\\t    const second = await resolveThread({}, deps());\\\\n118\\\\t    expect(second.ok).toBe(true);\\\\n119\\\\t    if (!second.ok) return;\\\\n120\\\\t    const secondId = idOf(second.value);\\\\n121\\\\t    const continued = await resolveThread({ continue: true }, deps());\\\\n122\\\\t    expect(continued.ok).toBe(true);\\\\n123\\\\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\\\\n124\\\\t\\\\n125\\\\t    // unresolvable id → actionable error, no thread created\\\\n126\\\\t    const before = await threadCount();\\\\n127\\\\t    const bad = await resolveThread({ session: \\\\\\\"th_zzzzzzzzzzzzzzzz\\\\\\\" }, deps());\\\\n128\\\\t    expect(bad.ok).toBe(false);\\\\n129\\\\t    if (!bad.ok) expect(bad.error.code).toBe(\\\\\\\"thread_not_found\\\\\\\");\\\\n130\\\\t    expect(await threadCount()).toBe(before);\\\\n131\\\\t\\\\n132\\\\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\\\\n133\\\\t    const ambiguous = await resolveThread({ session: \\\\\\\"th_\\\\\\\" }, deps());\\\\n134\\\\t    expect(ambiguous.ok).toBe(false);\\\\n135\\\\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\\\\\\\"ambiguous_thread_id\\\\\\\");\\\\n136\\\\t    expect(await threadCount()).toBe(before);\\\\n137\\\\t  });\\\\n138\\\\t\\\\n139\\\\t  it(\\\\\\\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\\\\\\\", () => {\\\\n140\\\\t    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\"])).toEqual({});\\\\n141\\\\t    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--resume\\\\\\\"])).toEqual({ resume: true });\\\\n142\\\\t    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"-r\\\\\\\"])).toEqual({ resume: true });\\\\n143\\\\t    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--continue\\\\\\\"])).toEqual({ continue: true });\\\\n144\\\\t    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"-c\\\\\\\"])).toEqual({ continue: true });\\\\n145\\\\t    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--session\\\\\\\", \\\\\\\"th_abc\\\\\\\"])).toEqual({ session: \\\\\\\"th_abc\\\\\\\" });\\\\n146\\\\t    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--session=th_xyz\\\\\\\"])).toEqual({ session: \\\\\\\"th_xyz\\\\\\\" });\\\\n147\\\\t  });\\\\n148\\\\t\\\\n149\\\\t  it(\\\\\\\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\\\\\\\", async () => {\\\\n150\\\\t    const created = await resolveThread({}, deps(\\\\\\\"/work/proj-x\\\\\\\"));\\\\n151\\\\t    expect(created.ok).toBe(true);\\\\n152\\\\t    if (!created.ok) return;\\\\n153\\\\t    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\\\\n154\\\\t    expect(row.ok).toBe(true);\\\\n155\\\\t    if (!row.ok) return;\\\\n156\\\\t    expect(row.value.cwd).toBe(\\\\\\\"/work/proj-x\\\\\\\");\\\\n157\\\\t    expect(row.value.title).toBe(defaultThreadTitle(\\\\\\\"/work/proj-x\\\\\\\")); // \\\\\\\"proj-x\\\\\\\"\\\\n158\\\\t  });\\\\n159\\\\t\\\\n160\\\\t  it(\\\\\\\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\\\\\\\", async () => {\\\\n161\\\\t    const a1 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"alpha\\\\\\\" });\\\\n162\\\\t    const a2 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"beta\\\\\\\" });\\\\n163\\\\t    await makeThread({ cwd: \\\\\\\"/work/b\\\\\\\", title: \\\\\\\"other-cwd\\\\\\\" });\\\\n164\\\\t\\\\n165\\\\t    let offered: readonly ThreadChoice[] = [];\\\\n166\\\\t    const picked = await pickThread(\\\\\\\"/work/a\\\\\\\", {\\\\n167\\\\t      registryPath: store.registryPath,\\\\n168\\\\t      select: (choices) => {\\\\n169\\\\t        offered = choices;\\\\n170\\\\t        return Promise.resolve(choices[0]!.threadId);\\\\n171\\\\t      },\\\\n172\\\\t    });\\\\n173\\\\t    expect(picked.ok).toBe(true);\\\\n174\\\\t\\\\n175\\\\t    // Only the current cwd's threads are offered, each with title + creation time.\\\\n176\\\\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\\\\n177\\\\t    for (const choice of offered) {\\\\n178\\\\t      expect(choice.createdAt).toBeTruthy();\\\\n179\\\\t      expect(choice.title).toBeTruthy();\\\\n180\\\\t    }\\\\n181\\\\t\\\\n182\\\\t    // The operator's selection resolves to that thread.\\\\n183\\\\t    if (picked.ok && picked.value !== null) {\\\\n184\\\\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\\\\n185\\\\t    }\\\\n186\\\\t\\\\n187\\\\t    // An empty cwd reports an empty list (null) without failing or prompting.\\\\n188\\\\t    let selectCalled = false;\\\\n189\\\\t    const empty = await pickThread(\\\\\\\"/work/empty\\\\\\\", {\\\\n190\\\\t      registryPath: store.registryPath,\\\\n191\\\\t      select: () => {\\\\n192\\\\t        selectCalled = true;\\\\n193\\\\t        return Promise.resolve(null);\\\\n194\\\\t      },\\\\n195\\\\t    });\\\\n196\\\\t    expect(empty.ok).toBe(true);\\\\n197\\\\t    if (empty.ok) expect(empty.value).toBeNull();\\\\n198\\\\t    expect(selectCalled).toBe(false);\\\\n199\\\\t  });\\\\n200\\\\t\\\\n201\\\\t  it(\\\\\\\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\\\\\\\", async () => {\\\\n202\\\\t    const cwd = \\\\\\\"/work/tc-1-5\\\\\\\";\\\\n203\\\\t    const created = await resolveThread({}, deps(cwd));\\\\n204\\\\t    expect(created.ok).toBe(true);\\\\n205\\\\t    if (!created.ok) return;\\\\n206\\\\t    const threadId = idOf(created.value);\\\\n207\\\\t\\\\n208\\\\t    const first = await initInstance(created.value, backgroundConfig());\\\\n209\\\\t    expect(first.ok).toBe(true);\\\\n210\\\\t    if (!first.ok) return;\\\\n211\\\\t    await first.value.sdk.intakeStream.messageEvents(\\\\n212\\\\t      first.value.threadRef,\\\\n213\\\\t      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n214\\\\t    );\\\\n215\\\\t    await disposeInstance(first.value);\\\\n216\\\\t\\\\n217\\\\t    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\\\\n218\\\\t    // flag would across process death). Reconstruct purely from it.\\\\n219\\\\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\\\\n220\\\\t    expect(reattached.ok).toBe(true);\\\\n221\\\\t    if (!reattached.ok) return;\\\\n222\\\\t    expect(idOf(reattached.value)).toBe(threadId);\\\\n223\\\\t\\\\n224\\\\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\\\\n225\\\\t    expect(rebuilt.ok).toBe(true);\\\\n226\\\\t    if (!rebuilt.ok) return;\\\\n227\\\\t    await rebuilt.value.sdk.intakeStream.messageEvents(\\\\n228\\\\t      rebuilt.value.threadRef,\\\\n229\\\\t      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n230\\\\t    );\\\\n231\\\\t    const overview = await inspect.overview(reattached.value);\\\\n232\\\\t    expect(overview.ok).toBe(true);\\\\n233\\\\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\\\\n234\\\\t    await disposeInstance(rebuilt.value);\\\\n235\\\\t  });\\\\n236\\\\t});\\\\n237\\\\t\\\\n238\\\\tdescribe(\\\\\\\"Story 1: launch-driven thread resolution (production connector path)\\\\\\\", () => {\\\\n239\\\\t  it(\\\\\\\"TC-1.2: session_start resolving an existing thread creates no second thread\\\\\\\", async () => {\\\\n240\\\\t    const existingId = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"existing\\\\\\\" });\\\\n241\\\\t    const before = await threadCount();\\\\n242\\\\t\\\\n243\\\\t    const connector = productionConnector(() => ({ session: existingId }));\\\\n244\\\\t    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/a\\\\\\\"), makeSessionStart(\\\\\\\"startup\\\\\\\"));\\\\n245\\\\t\\\\n246\\\\t    const state = connector.getState();\\\\n247\\\\t    expect(state).not.toBeNull();\\\\n248\\\\t    if (state === null) return;\\\\n249\\\\t    expect(idOf(state.threadRef)).toBe(existingId);\\\\n250\\\\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\\\\n251\\\\t    expect(await threadCount()).toBe(before); // no second thread\\\\n252\\\\t  });\\\\n253\\\\t\\\\n254\\\\t  it(\\\\\\\"TC-1.7: session_start --resume resumes the most recent cwd-scoped thread via the default selector\\\\\\\", async () => {\\\\n255\\\\t    await makeThread({ cwd: \\\\\\\"/work/resume\\\\\\\", title: \\\\\\\"older\\\\\\\" });\\\\n256\\\\t    const recent = await makeThread({ cwd: \\\\\\\"/work/resume\\\\\\\", title: \\\\\\\"newer\\\\\\\" });\\\\n257\\\\t    await makeThread({ cwd: \\\\\\\"/work/other\\\\\\\", title: \\\\\\\"different cwd\\\\\\\" });\\\\n258\\\\t    const before = await threadCount();\\\\n259\\\\t\\\\n260\\\\t    const connector = productionConnector(() => ({ resume: true }));\\\\n261\\\\t    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/resume\\\\\\\"), makeSessionStart(\\\\\\\"resume\\\\\\\"));\\\\n262\\\\t\\\\n263\\\\t    const state = connector.getState();\\\\n264\\\\t    expect(state).not.toBeNull();\\\\n265\\\\t    if (state === null) return;\\\\n266\\\\t    expect(idOf(state.threadRef)).toBe(recent); // most recent in the cwd (default selection)\\\\n267\\\\t    expect(connector.getInstance()).not.toBeNull();\\\\n268\\\\t    expect(await threadCount()).toBe(before); // resumed, not created\\\\n269\\\\t  });\\\\n270\\\\t});\\\\n271\\\\t\\\\n272\\\\tdescribe(\\\\\\\"Story 1: plain-data state across hooks\\\\\\\", () => {\\\\n273\\\\t  it(\\\\\\\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\\\\\\\", async () => {\\\\n274\\\\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\\\\n275\\\\t\\\\n276\\\\t    // session_start with a ctx carrying methods.\\\\n277\\\\t    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/a\\\\\\\"), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n278\\\\t    expect(connector.getState()).not.toBeNull();\\\\n279\\\\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\\\\n280\\\\t    // ...but the snapshot is plain data only — it survives structuredClone even\\\\n281\\\\t    // though the live ctx and instance carry methods (they are not in it).\\\\n282\\\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n283\\\\t    const threadRefBefore = connector.getState()?.threadRef;\\\\n284\\\\t\\\\n285\\\\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\\\n286\\\\t    // holder still references no prior ctx.\\\\n287\\\\t    await connector.handlers.message_end(\\\\n288\\\\t      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n289\\\\t      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n290\\\\t    );\\\\n291\\\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n292\\\\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n293\\\\t  });\\\\n294\\\\t});\\\\n295\\\\t\\\\n296\\\\tdescribe(\\\\\\\"Story 1: reload reconstruction after teardown (AC-1.5)\\\\\\\", () => {\\\\n297\\\\t  it(\\\\\\\"TC-1.5: a FRESH connector reconstructs the same thread from durable state, with no launch flag and no duplicate\\\\\\\", async () => {\\\\n298\\\\t    const cwd = \\\\\\\"/work/reload\\\\\\\";\\\\n299\\\\t\\\\n300\\\\t    // Connector A: a no-flag session creates the thread and records its durable\\\\n301\\\\t    // id (in module-level memory, not the connector closure).\\\\n302\\\\t    const connectorA = productionConnector(() => ({}));\\\\n303\\\\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n304\\\\t    const stateA = connectorA.getState();\\\\n305\\\\t    expect(stateA).not.toBeNull();\\\\n306\\\\t    if (stateA === null) return;\\\\n307\\\\t    const firstId = idOf(stateA.threadRef);\\\\n308\\\\t    const countAfterNew = await threadCount();\\\\n309\\\\t\\\\n310\\\\t    // The connector-created thread carries cwd + a default title (A-8 / SV-003).\\\\n311\\\\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\\\\n312\\\\t    expect(row.ok).toBe(true);\\\\n313\\\\t    if (row.ok) {\\\\n314\\\\t      expect(row.value.cwd).toBe(cwd);\\\\n315\\\\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\\\\n316\\\\t    }\\\\n317\\\\t\\\\n318\\\\t    // Reload: shutdown{reload}, then connector A is TORN DOWN (never referenced\\\\n319\\\\t    // again). A brand-new connector handles the reload — its closure holds no\\\\n320\\\\t    // prior id, and the launch is still no-flag (which would otherwise create a\\\\n321\\\\t    // new thread).\\\\n322\\\\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\\\\\"reload\\\\\\\" });\\\\n323\\\\t\\\\n324\\\\t    const connectorB = productionConnector(() => ({}));\\\\n325\\\\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"reload\\\\\\\"));\\\\n326\\\\t\\\\n327\\\\t    const stateB = connectorB.getState();\\\\n328\\\\t    expect(stateB).not.toBeNull();\\\\n329\\\\t    if (stateB === null) return;\\\\n330\\\\t    expect(idOf(stateB.threadRef)).toBe(firstId); // reconstructed from durable state\\\\n331\\\\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\\\n332\\\\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\\\n333\\\\t  });\\\\n334\\\\t\\\\n335\\\\t  it(\\\\\\\"a non-reload teardown clears the durable memory so the next no-flag session is a NEW thread\\\\\\\", async () => {\\\\n336\\\\t    const cwd = \\\\\\\"/work/fresh\\\\\\\";\\\\n337\\\\t    const connectorA = productionConnector(() => ({}));\\\\n338\\\\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n339\\\\t    const firstId = idOf(connectorA.getState()!.threadRef);\\\\n340\\\\t\\\\n341\\\\t    // A normal shutdown (not reload) ends the session and clears the memory.\\\\n342\\\\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\\\\\"shutdown\\\\\\\" });\\\\n343\\\\t\\\\n344\\\\t    const connectorB = productionConnector(() => ({}));\\\\n345\\\\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n346\\\\t    const secondId = idOf(connectorB.getState()!.threadRef);\\\\n347\\\\t\\\\n348\\\\t    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\\\\n349\\\\t    expect(await threadCount()).toBe(2);\\\\n350\\\\t  });\\\\n351\\\\t});\\\\n352\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\\\",\\\"uuid\\\":\\\"e786eb72-a49c-49bb-b756-41157542298e\\\",\\\"timestamp\\\":\\\"2026-06-14T05:27:08.367Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\\\",\\\"content\\\":\\\"// Story 1 — launch-driven thread resolution, plain-data state, and reload\\\\n// reconstruction. Two layers are covered: the resolver/picker functions\\\\n// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\\\\n// PRODUCTION connector path through createConnector with real defaults (no\\\\n// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\\\\n// throughout; the module-level reload memory is reset per test.\\\\nimport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\nimport {\\\\n  createDeterministicProvider,\\\\n  inspect,\\\\n  threads,\\\\n  type SdkConfig,\\\\n  type ThreadRef,\\\\n} from \\\\\\\"lhc\\\\\\\";\\\\nimport { createConnector, resetSessionThreadMemory } from \\\\\\\"../../src/index.js\\\\\\\";\\\\nimport { disposeInstance, initInstance } from \\\\\\\"../../src/lifecycle/instance.js\\\\\\\";\\\\nimport {\\\\n  defaultThreadTitle,\\\\n  parseLaunchFlags,\\\\n  resolveThread,\\\\n  type ResolveDeps,\\\\n} from \\\\\\\"../../src/lifecycle/thread-resolution.js\\\\\\\";\\\\nimport { pickThread, type ThreadChoice } from \\\\\\\"../../src/lifecycle/picker.js\\\\\\\";\\\\nimport type { ExtensionContext } from \\\\\\\"../../src/pi/types.js\\\\\\\";\\\\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\\\\\"../fixtures/synthetic.js\\\\\\\";\\\\nimport { tempStore, type TempStore } from \\\\\\\"../fixtures/thread.js\\\\\\\";\\\\n\\\\nlet store: TempStore;\\\\nbeforeEach(() => {\\\\n  store = tempStore();\\\\n  resetSessionThreadMemory(); // the connector's reload memory is module-level\\\\n});\\\\nafterEach(() => {\\\\n  store.cleanup();\\\\n});\\\\n\\\\nfunction backgroundConfig(): SdkConfig {\\\\n  return { provider: createDeterministicProvider(), mode: \\\\\\\"background\\\\\\\" };\\\\n}\\\\n\\\\nfunction idOf(ref: ThreadRef): string {\\\\n  if (!(\\\\\\\"threadId\\\\\\\" in ref)) throw new Error(\\\\\\\"expected a { threadId } ref\\\\\\\");\\\\n  return ref.threadId;\\\\n}\\\\n\\\\nfunction deps(cwd = \\\\\\\"/work/default\\\\\\\"): ResolveDeps {\\\\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\\\n}\\\\n\\\\n// Create a thread directly with explicit cwd/title, for picker fixtures and\\\\n// existing-thread setup. (Connector-created threads get cwd plus a default title\\\\n// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\\\\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\\\\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\\\\n    filePath: store.threadPath(),\\\\n    registryPath: store.registryPath,\\\\n  };\\\\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\\\n  if (opts.title !== undefined) input.title = opts.title;\\\\n  const created = await threads.newThread(input);\\\\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\\\\n  return created.value.threadId;\\\\n}\\\\n\\\\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\\\\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\\\\n// object, modelling PI handing a fresh ctx to each hook.\\\\nfunction syntheticCtx(cwd: string): ExtensionContext {\\\\n  return {\\\\n    cwd,\\\\n    hasUI: false,\\\\n    modelRegistry: {\\\\n      find: () => undefined,\\\\n      hasConfiguredAuth: () => false,\\\\n      getAvailable: () => [],\\\\n    },\\\\n    ui: { notify: () => {} },\\\\n    sessionManager: { getEntries: () => [] },\\\\n  };\\\\n}\\\\n\\\\n// A connector wired with production defaults (real SDK config + selector) and\\\\n// only environment overrides — the activate() path, minus the global registry\\\\n// and process.argv.\\\\nfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\\\\n  return createConnector({\\\\n    registryPath: store.registryPath,\\\\n    newThreadFilePath: () => store.threadPath(),\\\\n    parseLaunch: launch,\\\\n  });\\\\n}\\\\n\\\\nasync function threadCount(): Promise<number> {\\\\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\\\\n  return listed.ok ? listed.value.length : -1;\\\\n}\\\\n\\\\ndescribe(\\\\\\\"Story 1: launch-driven thread resolution (resolver/picker)\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\\\\\\\", async () => {\\\\n    // no flag → a new thread\\\\n    const first = await resolveThread({}, deps());\\\\n    expect(first.ok).toBe(true);\\\\n    if (!first.ok) return;\\\\n    const firstId = idOf(first.value);\\\\n\\\\n    // --session full id → the same thread\\\\n    const byFull = await resolveThread({ session: firstId }, deps());\\\\n    expect(byFull.ok).toBe(true);\\\\n    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\\\\n\\\\n    // --session partial id → the same thread\\\\n    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\\\\n    expect(byPartial.ok).toBe(true);\\\\n    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\\\\n\\\\n    // a second thread, then --continue → the most recently created\\\\n    const second = await resolveThread({}, deps());\\\\n    expect(second.ok).toBe(true);\\\\n    if (!second.ok) return;\\\\n    const secondId = idOf(second.value);\\\\n    const continued = await resolveThread({ continue: true }, deps());\\\\n    expect(continued.ok).toBe(true);\\\\n    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\\\\n\\\\n    // unresolvable id → actionable error, no thread created\\\\n    const before = await threadCount();\\\\n    const bad = await resolveThread({ session: \\\\\\\"th_zzzzzzzzzzzzzzzz\\\\\\\" }, deps());\\\\n    expect(bad.ok).toBe(false);\\\\n    if (!bad.ok) expect(bad.error.code).toBe(\\\\\\\"thread_not_found\\\\\\\");\\\\n    expect(await threadCount()).toBe(before);\\\\n\\\\n    // ambiguous prefix (matches both threads) → actionable error, no thread created\\\\n    const ambiguous = await resolveThread({ session: \\\\\\\"th_\\\\\\\" }, deps());\\\\n    expect(ambiguous.ok).toBe(false);\\\\n    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\\\\\\\"ambiguous_thread_id\\\\\\\");\\\\n    expect(await threadCount()).toBe(before);\\\\n  });\\\\n\\\\n  it(\\\\\\\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\\\\\\\", () => {\\\\n    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\"])).toEqual({});\\\\n    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--resume\\\\\\\"])).toEqual({ resume: true });\\\\n    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"-r\\\\\\\"])).toEqual({ resume: true });\\\\n    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--continue\\\\\\\"])).toEqual({ continue: true });\\\\n    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"-c\\\\\\\"])).toEqual({ continue: true });\\\\n    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--session\\\\\\\", \\\\\\\"th_abc\\\\\\\"])).toEqual({ session: \\\\\\\"th_abc\\\\\\\" });\\\\n    expect(parseLaunchFlags([\\\\\\\"node\\\\\\\", \\\\\\\"pi\\\\\\\", \\\\\\\"--session=th_xyz\\\\\\\"])).toEqual({ session: \\\\\\\"th_xyz\\\\\\\" });\\\\n  });\\\\n\\\\n  it(\\\\\\\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\\\\\\\", async () => {\\\\n    const created = await resolveThread({}, deps(\\\\\\\"/work/proj-x\\\\\\\"));\\\\n    expect(created.ok).toBe(true);\\\\n    if (!created.ok) return;\\\\n    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\\\\n    expect(row.ok).toBe(true);\\\\n    if (!row.ok) return;\\\\n    expect(row.value.cwd).toBe(\\\\\\\"/work/proj-x\\\\\\\");\\\\n    expect(row.value.title).toBe(defaultThreadTitle(\\\\\\\"/work/proj-x\\\\\\\")); // \\\\\\\"proj-x\\\\\\\"\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\\\\\\\", async () => {\\\\n    const a1 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"alpha\\\\\\\" });\\\\n    const a2 = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"beta\\\\\\\" });\\\\n    await makeThread({ cwd: \\\\\\\"/work/b\\\\\\\", title: \\\\\\\"other-cwd\\\\\\\" });\\\\n\\\\n    let offered: readonly ThreadChoice[] = [];\\\\n    const picked = await pickThread(\\\\\\\"/work/a\\\\\\\", {\\\\n      registryPath: store.registryPath,\\\\n      select: (choices) => {\\\\n        offered = choices;\\\\n        return Promise.resolve(choices[0]!.threadId);\\\\n      },\\\\n    });\\\\n    expect(picked.ok).toBe(true);\\\\n\\\\n    // Only the current cwd's threads are offered, each with title + creation time.\\\\n    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\\\\n    for (const choice of offered) {\\\\n      expect(choice.createdAt).toBeTruthy();\\\\n      expect(choice.title).toBeTruthy();\\\\n    }\\\\n\\\\n    // The operator's selection resolves to that thread.\\\\n    if (picked.ok && picked.value !== null) {\\\\n      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\\\\n    }\\\\n\\\\n    // An empty cwd reports an empty list (null) without failing or prompting.\\\\n    let selectCalled = false;\\\\n    const empty = await pickThread(\\\\\\\"/work/empty\\\\\\\", {\\\\n      registryPath: store.registryPath,\\\\n      select: () => {\\\\n        selectCalled = true;\\\\n        return Promise.resolve(null);\\\\n      },\\\\n    });\\\\n    expect(empty.ok).toBe(true);\\\\n    if (empty.ok) expect(empty.value).toBeNull();\\\\n    expect(selectCalled).toBe(false);\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\\\\\\\", async () => {\\\\n    const cwd = \\\\\\\"/work/tc-1-5\\\\\\\";\\\\n    const created = await resolveThread({}, deps(cwd));\\\\n    expect(created.ok).toBe(true);\\\\n    if (!created.ok) return;\\\\n    const threadId = idOf(created.value);\\\\n\\\\n    const first = await initInstance(created.value, backgroundConfig());\\\\n    expect(first.ok).toBe(true);\\\\n    if (!first.ok) return;\\\\n    await first.value.sdk.intakeStream.messageEvents(\\\\n      first.value.threadRef,\\\\n      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n    );\\\\n    await disposeInstance(first.value);\\\\n\\\\n    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\\\\n    // flag would across process death). Reconstruct purely from it.\\\\n    const reattached = await resolveThread({ session: threadId }, deps(cwd));\\\\n    expect(reattached.ok).toBe(true);\\\\n    if (!reattached.ok) return;\\\\n    expect(idOf(reattached.value)).toBe(threadId);\\\\n\\\\n    const rebuilt = await initInstance(reattached.value, backgroundConfig());\\\\n    expect(rebuilt.ok).toBe(true);\\\\n    if (!rebuilt.ok) return;\\\\n    await rebuilt.value.sdk.intakeStream.messageEvents(\\\\n      rebuilt.value.threadRef,\\\\n      eventBatch([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\", \\\\\\\"turn_end\\\\\\\"]),\\\\n    );\\\\n    const overview = await inspect.overview(reattached.value);\\\\n    expect(overview.ok).toBe(true);\\\\n    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\\\\n    await disposeInstance(rebuilt.value);\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"Story 1: launch-driven thread resolution (production connector path)\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.2: session_start resolving an existing thread creates no second thread\\\\\\\", async () => {\\\\n    const existingId = await makeThread({ cwd: \\\\\\\"/work/a\\\\\\\", title: \\\\\\\"existing\\\\\\\" });\\\\n    const before = await threadCount();\\\\n\\\\n    const connector = productionConnector(() => ({ session: existingId }));\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/a\\\\\\\"), makeSessionStart(\\\\\\\"startup\\\\\\\"));\\\\n\\\\n    const state = connector.getState();\\\\n    expect(state).not.toBeNull();\\\\n    if (state === null) return;\\\\n    expect(idOf(state.threadRef)).toBe(existingId);\\\\n    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\\\\n    expect(await threadCount()).toBe(before); // no second thread\\\\n  });\\\\n\\\\n  it(\\\\\\\"TC-1.7: session_start --resume resumes the most recent cwd-scoped thread via the default selector\\\\\\\", async () => {\\\\n    await makeThread({ cwd: \\\\\\\"/work/resume\\\\\\\", title: \\\\\\\"older\\\\\\\" });\\\\n    const recent = await makeThread({ cwd: \\\\\\\"/work/resume\\\\\\\", title: \\\\\\\"newer\\\\\\\" });\\\\n    await makeThread({ cwd: \\\\\\\"/work/other\\\\\\\", title: \\\\\\\"different cwd\\\\\\\" });\\\\n    const before = await threadCount();\\\\n\\\\n    const connector = productionConnector(() => ({ resume: true }));\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/resume\\\\\\\"), makeSessionStart(\\\\\\\"resume\\\\\\\"));\\\\n\\\\n    const state = connector.getState();\\\\n    expect(state).not.toBeNull();\\\\n    if (state === null) return;\\\\n    expect(idOf(state.threadRef)).toBe(recent); // most recent in the cwd (default selection)\\\\n    expect(connector.getInstance()).not.toBeNull();\\\\n    expect(await threadCount()).toBe(before); // resumed, not created\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"Story 1: plain-data state across hooks\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\\\\\\\", async () => {\\\\n    const connector = productionConnector(() => ({})); // no flag → new thread, default config\\\\n\\\\n    // session_start with a ctx carrying methods.\\\\n    await connector.handlers.session_start(syntheticCtx(\\\\\\\"/work/a\\\\\\\"), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    expect(connector.getState()).not.toBeNull();\\\\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\\\\n    // ...but the snapshot is plain data only — it survives structuredClone even\\\\n    // though the live ctx and instance carry methods (they are not in it).\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    const threadRefBefore = connector.getState()?.threadRef;\\\\n\\\\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\\\n    // holder still references no prior ctx.\\\\n    await connector.handlers.message_end(\\\\n      syntheticCtx(\\\\\\\"/work/a\\\\\\\"),\\\\n      makeMessageEnd(makeUserMessage(\\\\\\\"hi\\\\\\\")),\\\\n    );\\\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"Story 1: reload reconstruction after teardown (AC-1.5)\\\\\\\", () => {\\\\n  it(\\\\\\\"TC-1.5: a FRESH connector reconstructs the same thread from durable state, with no launch flag and no duplicate\\\\\\\", async () => {\\\\n    const cwd = \\\\\\\"/work/reload\\\\\\\";\\\\n\\\\n    // Connector A: a no-flag session creates the thread and records its durable\\\\n    // id (in module-level memory, not the connector closure).\\\\n    const connectorA = productionConnector(() => ({}));\\\\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    const stateA = connectorA.getState();\\\\n    expect(stateA).not.toBeNull();\\\\n    if (stateA === null) return;\\\\n    const firstId = idOf(stateA.threadRef);\\\\n    const countAfterNew = await threadCount();\\\\n\\\\n    // The connector-created thread carries cwd + a default title (A-8 / SV-003).\\\\n    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\\\\n    expect(row.ok).toBe(true);\\\\n    if (row.ok) {\\\\n      expect(row.value.cwd).toBe(cwd);\\\\n      expect(row.value.title).toBe(defaultThreadTitle(cwd));\\\\n    }\\\\n\\\\n    // Reload: shutdown{reload}, then connector A is TORN DOWN (never referenced\\\\n    // again). A brand-new connector handles the reload — its closure holds no\\\\n    // prior id, and the launch is still no-flag (which would otherwise create a\\\\n    // new thread).\\\\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\\\\\"reload\\\\\\\" });\\\\n\\\\n    const connectorB = productionConnector(() => ({}));\\\\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"reload\\\\\\\"));\\\\n\\\\n    const stateB = connectorB.getState();\\\\n    expect(stateB).not.toBeNull();\\\\n    if (stateB === null) return;\\\\n    expect(idOf(stateB.threadRef)).toBe(firstId); // reconstructed from durable state\\\\n    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\\\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\\\n  });\\\\n\\\\n  it(\\\\\\\"a non-reload teardown clears the durable memory so the next no-flag session is a NEW thread\\\\\\\", async () => {\\\\n    const cwd = \\\\\\\"/work/fresh\\\\\\\";\\\\n    const connectorA = productionConnector(() => ({}));\\\\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    const firstId = idOf(connectorA.getState()!.threadRef);\\\\n\\\\n    // A normal shutdown (not reload) ends the session and clears the memory.\\\\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\\\\\"shutdown\\\\\\\" });\\\\n\\\\n    const connectorB = productionConnector(() => ({}));\\\\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\\\\\"new\\\\\\\"));\\\\n    const secondId = idOf(connectorB.getState()!.threadRef);\\\\n\\\\n    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\\\\n    expect(await threadCount()).toBe(2);\\\\n  });\\\\n});\\\\n\\\",\\\"numLines\\\":352,\\\"startLine\\\":1,\\\"totalLines\\\":352}}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:737:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01J8YvHMKVmDCBmvKWQMxDg4\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\timport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\n2\\\\timport {\\\\n3\\\\t  activate,\\\\n4\\\\t  createConnector,\\\\n5\\\\t  disposeInstance,\\\\n6\\\\t  EPIC_1_HOOKS,\\\\n7\\\\t  initInstance,\\\\n8\\\\t  resetSessionThreadMemory,\\\\n9\\\\t} from \\\\\\\"../../src/index.js\\\\\\\";\\\\n10\\\\timport { createSessionState } from \\\\\\\"../../src/lifecycle/state.js\\\\\\\";\\\\n11\\\\timport type { ExtensionAPI, ExtensionContext, PiHookName } from \\\\\\\"../../src/pi/types.js\\\\\\\";\\\\n12\\\\timport { makeAgentEnd, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\\\\\"../fixtures/synthetic.js\\\\\\\";\\\\n13\\\\timport { tempStore, type TempStore } from \\\\\\\"../fixtures/thread.js\\\\\\\";\\\\n14\\\\t\\\\n15\\\\tlet store: TempStore;\\\\n16\\\\tbeforeEach(() => {\\\\n17\\\\t  store = tempStore();\\\\
── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\\\\\\\n140\\\\\\\\t\\\\\\\\n141\\\\\\\\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\\\\\\\n142\\\\\\\\t\\\\\\\\n143\\\\\\\\t// Merge per-domain handler tables into the one join between the queue's\\\\\\\\n144\\\\\\\\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\\\\\\\n145\\\\\\\\t// (each kind has exactly one owner) and throws at construction.\\\\\\\\n146\\\\\\\\texport function assembleWorkHandlerMap(\\\\\\\\n147\\\\\\\\t  tables: ReadonlyArray<WorkHandlerMap>,\\\\\\\\n148\\\\\\\\t): WorkHandlerMap {\\\\\\\\n149\\\\\\\\t  const map: WorkHandlerMap = {};\\\\\\\\n150\\\\\\\\t  for (const table of tables) {\\\\\\\\n151\\\\\\\\t    for (const [kind, handler] of Object.entries(table)) {\\\\\\\\n152\\\\\\\\t      if (map[kind as WorkKind] !== undefined) {\\\\\\\\n153\\\\\\\\t        throw new TypeError(`work kind \\\\\\\\\\\\\\\"${kind}\\\\\\\\\\\\\\\" registered by more than one domain`);\\\\\\\\n154\\\\\\\\t      }\\\\\\\\n155\\\\\\\\t      map[kind as WorkKind] = handler;\\\\\\\\n156\\\\\\\\t    }\\\\\\\\n157\\\\\\\\t  }\\\\\\\\n158\\\\\\\\t  return map;\\\\\\\\n159\\\\\\\\t}\\\\\\\\n160\\\\\\\\t\\\\\\\\n161\\\\\\\\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\\\\\\\n162\\\\\\\\t  return {\\\\\\\\n163\\\\\\\\t    ok: false,\\\\\\\\n164\\\\\\\\t    error: {\\\\\\\\n165\\\\\\\\t      errorClass: \\\\\\\\\\\\\\\"state_corruption\\\\\\\\\\\\\\\",\\\\\\\\n166\\\\\\\\t      code: \\\\\\\\\\\\\\\"unknown_work_kind\\\\\\\\\\\\\\\",\\\\\\\\n167\\\\\\\\t      reason: `no handler registered for work kind \\\\\\\\\\\\\\\"${kind}\\\\\\\\\\\\\\\"`,\\\\\\\\n168\\\\\\\\t    },\\\\\\\\n169\\\\\\\\t  };\\\\\\\\n170\\\\\\\\t}\\\\\\\\n171\\\\\\\\t\\\\\\\\n172\\\\\\\\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\\\\\\\n173\\\\\\\\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\\\\\\\n174\\\\\\\\texport function lookupWorkHandler(\\\\\\\\n175\\\\\\\\t  map: WorkHandlerMap,\\\\\\\\n176\\\\\\\\t  kind: string,\\\\\\\\n177\\\\\\\\t): OpResult<WorkHandler> {\\\\\\\\n178\\\\\\\\t  const handler = map[kind as WorkKind];\\\\\\\\n179\\\\\\\\t  if (handler === undefined) return unknownWorkKind(kind);\\\\\\\\n180\\\\\\\\t  return { ok: true, value: handler };\\\\\\\\n181\\\\\\\\t}\\\\\\\\n182\\\\\\\\t\\\\\\\\n183\\\\\\\\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\\\\\\\n184\\\\\\\\t// requeue land in Story 4.\\\\\\\\n185\\\\\\\\texport interface WorkSurface {\\\\\\\\n186\\\\\\\\t  drain(\\\\\\\\n187\\\\\\\\t    ref: threadsDomain.ThreadRef,\\\\\\\\n188\\\\\\\\t    opts?: { maxItems?: number },\\\\\\\\n189\\\\\\\\t  ): Promise<OpResult<DrainReport>>;\\\\\\\\n190\\\\\\\\t}\\\\\\\\n191\\\\\\\\t\\\\\\\\n192\\\\\\\\texport interface Lhc {\\\\\\\\n193\\\\\\\\t  threads: typeof threadsDomain;\\\\\\\\n194\\\\\\\\t  intakeStream: typeof intakeStreamDomain;\\\\\\\\n195\\\\\\\\t  messages: typeof messagesDomain;\\\\\\\\n196\\\\\\\\t  turns: typeof turnsDomain;\\\\\\\\n197\\\\\\\\t  config: ResolvedSdkConfig;\\\\\\\\n198\\\\\\\\t  scheduler: Scheduler;\\\\\\\\n199\\\\\\\\t  workHandlers: WorkHandlerMap;\\\\\\\\n200\\\\\\\\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\\\\\\\n201\\\\\\\\t  work: WorkSurface;\\\\\\\\n202\\\\\\\\t  // Resolves when the scheduler has no running or pending drain for the\\\\\\\\n203\\\\\\\\t  // thread (issue 3) — the awaitable for background mode, and a no-op\\\\\\\\n204\\\\\\\\t  // resolve in manual mode.\\\\\\\\n205\\\\\\\\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\\\\\\\n206\\\\\\\\t}\\\\\\\\n207\\\\\\\\t\\\\\\\\n208\\\\\\\\tfunction requirePositive(value: number, name: string): void {\\\\\\\\n209\\\\\\\\t  if (!Number.isFinite(value) || value <= 0) {\\\\\\\\n210\\\\\\\\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\\\\\\\n211\\\\\\\\t  }\\\\\\\\n212\\\\\\\\t}\\\\\\\\n213\\\\\\\\t\\\\\\\\n214\\\\\\\\tfunction requireNonNegative(value: number, name: string): void {\\\\\\\\n215\\\\\\\\t  if (!Number.isFinite(value) || value < 0) {\\\\\\\\n216\\\\\\\\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\\\\\\\n217\\\\\\\\t  }\\\\\\\\n218\\\\\\\\t}\\\\\\\\n219\\\\\\\\t\\\\\\\\n220\\\\\\\\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\\\\\\\n221\\\\\\\\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\\\\\\\n222\\\\\\\\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\\\\\\\n223\\\\\\\\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\\\\\\\\n224\\\\\\\\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\\\\\\\n225\\\\\\\\t// object is the same shape as the namespace, so the public surface type holds.\\\\\\\\n226\\\\\\\\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\\\\\\\n227\\\\\\\\t  const scoped: Record<string, unknown> = {};\\\\\\\\n228\\\\\\\\t  for (const key of Object.keys(surface)) {\\\\\\\\n229\\\\\\\\t    const value = (surface as Record<string, unknown>)[key];\\\\\\\\n230\\\\\\\\t    scoped[key] =\\\\\\\\n231\\\\\\\\t      typeof value === \\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\"\\\\\\\\n232\\\\\\\\t        ? (...args: unknown[]): unknown =>\\\\\\\\n233\\\\\\\\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\\\\\\\n234\\\\\\\\t        : value;\\\\\\\\n235\\\\\\\\t  }\\\\\\\\n236\\\\\\\\t  return scoped as T;\\\\\\\\n237\\\\\\\\t}\\\\\\\\n238\\\\\\\\t\\\\\\\\n239\\\\\\\\t// The only assembly path: provider, mode, clock, and policy enter here.\\\\\\\\n240\\\\\\\\t// Config mistakes are programmer errors at construction and throw; operating\\\\\\\\n241\\\\\\\\t// failures after construction return OpResults per the error contract.\\\\\\\\n242\\\\\\\\texport function createSdk(config: SdkConfig): Lhc {\\\\\\\\n243\\\\\\\\t  if (config.mode !== \\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\" && config.mode !== \\\\\\\\\\\\\\\"manual\\\\\\\\\\\\\\\") {\\\\\\\\n244\\\\\\\\t    throw new TypeError(\\\\\\\\n245\\\\\\\\t      `createSdk config: mode must be \\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\" or \\\\\\\\\\\\\\\"manual\\\\\\\\\\\\\\\", got ${JSON.stringify(config.mode)}`,\\\\\\\\n246\\\\\\\\t    );\\\\\\\\n247\\\\\\\\t  }\\\\\\\\n248\\\\\\\\t  if (config.provider === null || typeof config.provider !== \\\\\\\\\\\\\\\"object\\\\\\\\\\\\\\\") {\\\\\\\\n249\\\\\\\\t    throw new TypeError(\\\\\\\\\\\\\\\"createSdk config: provider must implement DerivationProvider\\\\\\\\\\\\\\\");\\\\\\\\n250\\\\\\\\t  }\\\\\\\\n251\\\\\\\\t  for (const operation of PROVIDER_OPERATIONS) {\\\\\\\\n252\\\\\\\\t    if (typeof config.provider[operation] !== \\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\") {\\\\\\\\n253\\\\\\\\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\\\\\\\n254\\\\\\\\t    }\\\\\\\\n255\\\\\\\\t  }\\\\\\\\n256\\\\\\\\t\\\\\\\\n257\\\\\\\\t  const resolved: ResolvedSdkConfig = {\\\\\\\\n258\\\\\\\\t    provider: config.provider,\\\\\\\\n259\\\\\\\\t    mode: config.mode,\\\\\\\\n260\\\\\\\\t    clock: config.clock ?? (() => new Date()),\\\\\\\\n261\\\\\\\\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\\\\\\\n262\\\\\\\\t    lease: config.lease ?? { durationMs: 120000 },\\\\\\\\n263\\\\\\\\t    chunkPolicy:\\\\\\\\n264\\\\\\\\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\\\\\\\n265\\\\\\\\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\\\\\\\n266\\\\\\\\t    // sums and visibility budgets validated — throws naming the violation.\\\\\\\\n267\\\\\\\\t    view: resolveViewConfig(config.view),\\\\\\\\n268\\\\\\\\t  };\\\\\\\\n269\\\\\\\\t  requirePositive(resolved.retry.budget, \\\\\\\\\\\\\\\"retry.budget\\\\\\\\\\\\\\\");\\\\\\\\n270\\\\\\\\t  requireNonNegative(resolved.retry.backoffBaseMs, \\\\\\\\\\\\\\\"retry.backoffBaseMs\\\\\\\\\\\\\\\");\\\\\\\\n271\\\\\\\\t  requireNonNegative(resolved.retry.backoffCapMs, \\\\\\\\\\\\\\\"retry.backoffCapMs\\\\\\\\\\\\\\\");\\\\\\\\n272\\\\\\\\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\\\\\\\n273\\\\\\\\t    throw new TypeError(\\\\\\\\\\\\\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\\\\\\\\\\\\\");\\\\\\\\n274\\\\\\\\t  }\\\\\\\\n275\\\\\\\\t  requirePositive(resolved.lease.durationMs, \\\\\\\\\\\\\\\"lease.durationMs\\\\\\\\\\\\\\\");\\\\\\\\n276\\\\\\\\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\\\\\\\\\\\\\"chunkPolicy.targetProjectedTokens\\\\\\\\\\\\\\\");\\\\\\\\n277\\\\\\\\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\\\\\\\n278\\\\\\\\t    throw new TypeError(\\\\\\\\n279\\\\\\\\t      \\\\\\\\\\\\\\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\\\\\\\\\\\\\",\\\\\\\\n280\\\\\\\\t    );\\\\\\\\n281\\\\\\\\t  }\\\\\\\\n282\\\\\\\\t\\\\\\\\n283\\\\\\\\t  // Handler maps merge from per-domain contributions at construction (DD-6).\\\\\\\\n284\\\\\\\\t  // The tables are empty until Stories 2–3 land the real handlers; the\\\\\\\\n285\\\\\\\\t  // assembly mechanics are production code from day one.\\\\\\\\n286\\\\\\\\t  const workHandlers = assembleWorkHandlerMap([\\\\\\\\n287\\\\\\\\t    messagesDomain.workHandlers,\\\\\\\\n288\\\\\\\\t    turnsDomain.workHandlers,\\\\\\\\n289\\\\\\\\t  ]);\\\\\\\\n290\\\\\\\\t\\\\\\\\n291\\\\\\\\t  const drainDeps: DrainDeps = {\\\\\\\\n292\\\\\\\\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\\\\\\\n293\\\\\\\\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\\\\\\\n294\\\\\\\\t    config: resolved,\\\\\\\\n295\\\\\\\\t  };\\\\\\\\n296\\\\\\\\t  const scheduler = createScheduler(resolved.mode, drainDeps);\\\\\\\\n297\\\\\\\\t\\\\\\\\n298\\\\\\\\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\\\\\\\n299\\\\\\\\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\\\\\\\n300\\\\\\\\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\\\\\\\n301\\\\\\\\t  // background mode, or a no-op in manual mode — isolated from any other SDK\\\\\\\\n302\\\\\\\\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\\\\\\\\n303\\\\\\\\t  // the construction order, because its operations deliver to the no-op seam,\\\\\\\\n304\\\\\\\\t  // not to whatever a background SDK installed below.\\\\\\\\n305\\\\\\\\t  const seam: InstanceSeam =\\\\\\\\n306\\\\\\\\t    resolved.mode === \\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\"\\\\\\\\n307\\\\\\\\t      ? {\\\\\\\\n308\\\\\\\\t          poke: (threadId) => scheduler.poke(threadId),\\\\\\\\n309\\\\\\\\t          touch: (filePath, db) => scheduler.touch(filePath, db),\\\\\\\\n310\\\\\\\\t        }\\\\\\\\n311\\\\\\\\t      : { poke: () => {}, touch: () => {} };\\\\\\\\n312\\\\\\\\t\\\\\\\\n313\\\\\\\\t  // Background mode also installs the below-SDK default seam so a direct\\\\\\\\n314\\\\\\\\t  // domain call made with no SDK scope — a top-level mutation in the\\\\\\\\n315\\\\\\\\t  // single-background \\\\\\\\\\\\\\\"production path\\\\\\\\\\\\\\\" — still reaches the one installed\\\\\\\\n316\\\\\\\\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\\\\\\\\n317\\\\\\\\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\\\\\\\n318\\\\\\\\t  // leaves the default alone (pokes stay no-ops by contract).\\\\\\\\n319\\\\\\\\t  if (resolved.mode === \\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\") {\\\\\\\\n320\\\\\\\\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\\\\\\\n321\\\\\\\\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\\\\\\\n322\\\\\\\\t  }\\\\\\\\n323\\\\\\\\t\\\\\\\\n324\\\\\\\\t  const work: WorkSurface = {\\\\\\\\n325\\\\\\\\t    drain: (ref, opts) =>\\\\\\\\n326\\\\\\\\t      runWithInstanceSeam(seam, async () => {\\\\\\\\n327\\\\\\\\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\\\\\\\n328\\\\\\\\t        if (!resolvedRef.ok) return resolvedRef;\\\\\\\\n329\\\\\\\\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\\\\\\\n330\\\\\\\\t      }),\\\\\\\\n331\\\\\\\\t  };\\\\\\\\n332\\\\\\\\t\\\\\\\\n333\\\\\\\\t  return {\\\\\\\\n334\\\\\\\\t    threads: threadsDomain,\\\\\\\\n335\\\\\\\\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\\\\\\\\n336\\\\\\\\t    messages: scopeSurface(messagesDomain, seam),\\\\\\\\n337\\\\\\\\t    turns: scopeSurface(turnsDomain, seam),\\\\\\\\n338\\\\\\\\t    config: resolved,\\\\\\\\n339\\\\\\\\t    scheduler,\\\\\\\\n340\\\\\\\\t    workHandlers,\\\\\\\\n341\\\\\\\\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\\\\\\\n342\\\\\\\\t    work,\\\\\\\\n343\\\\\\\\t    drainSettled: async (ref) => {\\\\\\\\n344\\\\\\\\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\\\\\\\n345\\\\\\\\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\\\\\\\n346\\\\\\\\t      const threadId = peekThreadId(resolvedRef.value.filePath);\\\\\\\\n347\\\\\\\\t      if (threadId === null) return;\\\\\\\\n348\\\\\\\\t      return scheduler.drainSettled(threadId);\\\\\\\\n349\\\\\\\\t    },\\\\\\\\n350\\\\\\\\t  };\\\\\\\\n351\\\\\\\\t}\\\\\\\\n352\\\\\\\\t\\\\\\\"}]},\\\\\\\"parent_tool_use_id\\\\\\\":null,\\\\\\\"session_id\\\\\\\":\\\\\\\"28aec8fc-3297-4f03-8488-65ebfbadd697\\\\\\\",\\\\\\\"uuid\\\\\\\":\\\\\\\"332b159f-d313-4aa9-9c40-db6b03af8c68\\\\\\\",\\\\\\\"timestamp\\\\\\\":\\\\\\\"2026-06-11T14:38:07.021Z\\\\\\\",\\\\\\\"tool_use_result\\\\\\\":{\\\\\\\"ty
ead.sqlite\\\\\\\" });\\\\n99\\\\t    state.flags.startupValidationReported = true;\\\\n100\\\\t    state.flags.toldUserAboutGap = true; // open index signature, still plain data\\\\n101\\\\t    state.health.lastCaptureFailure = { code: \\\\\\\"malformed_event\\\\\\\", message: \\\\\\\"bad shape\\\\\\\", recordedGap: true };\\\\n102\\\\t    state.health.startupValidation = { unreachable: [] };\\\\n103\\\\t\\\\n104\\\\t    const clone = structuredClone(state);\\\\n105\\\\t    expect(clone).toEqual(state);\\\\n106\\\\t    expect(clone).not.toBe(state);\\\\n107\\\\t  });\\\\n108\\\\t\\\\n109\\\\t  it(\\\\\\\"init/dispose seam is real and fails closed: init on a missing thread returns a typed error, dispose(null) is a no-op\\\\\\\", async () => {\\\\n110\\\\t    // No thread file at this path: init validates the thread before any SDK\\\\n111\\\\t    // construction, so it fails closed with a typed result — never a throw into\\\\n112\\\\t    // a PI hook. (Story 1 implements the seam; the full lifecycle behavior is\\\\n113\\\\t    // covered in test/lifecycle/*.)\\\\n114\\\\t    const initResult = await initInstance(\\\\n115\\\\t      { filePath: \\\\\\\"/tmp/pi-lhc-nonexistent-thread.sqlite\\\\\\\" },\\\\n116\\\\t      { mode: \\\\\\\"background\\\\\\\" },\\\\n117\\\\t    );\\\\n118\\\\t    expect(initResult.ok).toBe(false);\\\\n119\\\\t    if (!initResult.ok) {\\\\n120\\\\t      expect(initResult.error.code).toBe(\\\\\\\"thread_not_found\\\\\\\");\\\\n121\\\\t      expect(initResult.error.errorClass).toBe(\\\\\\\"caller_error\\\\\\\");\\\\n122\\\\t    }\\\\n123\\\\t\\\\n124\\\\t    // Disposing with no live instance is a successful no-op.\\\\n125\\\\t    const disposeResult = await disposeInstance(null);\\\\n126\\\\t    expect(disposeResult.ok).toBe(true);\\\\n127\\\\t  });\\\\n128\\\\t});\\\\n129\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\\\",\\\"uuid\\\":\\\"472872d9-430a-4b12-bcdc-7c8b7dc82fc9\\\",\\\"time
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/verify/replay.test.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Story 3 — capture verification (Flow 6). Capture correctness is proven\n     2\t// WITHOUT serving anything to a model: each recorded corpus replays through the\n     3\t// REAL converter + intake path into a temp SQLite thread, and the durable\n     4\t// read-back is compared to the fixture. These tests assert on recorded thread\n     5\t// state through `replayCorpus` and the live inspect surfaces — never on a\n     6\t// mocked intake, and never by writing the fixture's expected events directly\n     7\t// (story §Anti-Shim Requirements).\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  createSdk,\n    12\t  inspect,\n    13\t  intakeStream,\n    14\t  type EventRecord,\n    15\t  type MessageEventInput,\n    16\t  type ThreadRef,\n    17\t} from \"lhc\";\n    18\timport { replayCorpus } from \"../../src/verify/replay.js\";\n    19\timport { capture } from \"../../src/capture/converter.js\";\n    20\timport type { LhcInstance } from \"../../src/shared/instance.js\";\n    21\timport {\n    22\t  CORPUS_LOADERS,\n    23\t  loadChattyCorpus,\n    24\t  loadToolHeavyCorpus,\n    25\t  type CorpusName,\n    26\t} from \"../fixtures/corpus.js\";\n    27\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    28\t\n    29\tlet store: TempStore;\n    30\tbeforeEach(() => {\n    31\t  store = tempStore();\n    32\t});\n    33\tafterEach(() => {\n    34\t  store.cleanup();\n    35\t});\n    36\t\n    37\tconst CORPUS_NAMES = Object.keys(CORPUS_LOADERS) as CorpusName[];\n    38\t\n    39\t/** The logical read-back: server-stamped `eventOrder`/`recordedAt` dropped, the\n    40\t *  converter's real (deterministic) idempotency key kept — so two replays are\n    41\t *  comparable for ID + order stability (AC-6.2). */\n    42\tfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n    43\t  return records.map(\n    44\t    (record) =>\n    45\t      ({\n    46\t        eventKind: record.eventKind,\n    47\t        idempotencyKey: record.idempotencyKey,\n    48\t        actor: record.actor,\n    49\t        harness: record.harness,\n    50\t        payload: record.payload,\n    51\t      }) as MessageEventInput,\n    52\t  );\n    53\t}\n    54\t\n    55\tasync function readBack(threadRef: ThreadRef): Promise<MessageEventInput[]> {\n    56\t  const read = await intakeStream.listEvents(threadRef);\n    57\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n    58\t  return logicalEvents(read.value);\n    59\t}\n    60\t\n    61\t/** A real background instance for inducing a Story-2 capture failure (the gap\n    62\t *  path does not call the provider, so the deterministic one is fine). */\n    63\tfunction liveInstance(threadRef: ThreadRef): LhcInstance {\n    64\t  const sdk = createSdk({ provider: createDeterministicProvider(), mode: \"background\" });\n    65\t  return {\n    66\t    sdk,\n    67\t    threadRef,\n    68\t    dispose: async () => {\n    69\t      await sdk.drainSettled(threadRef);\n    70\t      return { ok: true, value: undefined };\n    71\t    },\n    72\t  };\n    73\t}\n    74\t\n    75\t// ── TC-6.1: each corpus replays to a read-back matching the fixture ──────────\n    76\tdescribe.each(CORPUS_NAMES)(\"Story 3: corpus replay read-back (TC-6.1) — %s\", (name) => {\n    77\t  it(\"replays through the real converter to a thread whose events/messages/turns match the fixture\", async () => {\n    78\t    const corpus = CORPUS_LOADERS[name]();\n    79\t    const thread = await makeTempThread(store);\n    80\t\n    81\t    const result = await replayCorpus(corpus, thread.threadRef);\n    82\t\n    83\t    // toEqual surfaces the structured diff on the actual object when it fails.\n    84\t    expect(result).toEqual({ matches: true });\n    85\t\n    86\t    // The recorded events are the corpus's expected kinds, in order — proven\n    87\t    // against the durable thread, not the in-memory return value.\n    88\t    const recorded = await readBack(thread.threadRef);\n    89\t    expect(recorded.map((event) => event.eventKind)).toEqual(\n    90\t      corpus.expected.map((event) => event.eventKind),\n    91\t    );\n    92\t  });\n    93\t});\n    94\t\n    95\t// ── TC-6.2: deterministic re-replay (IDs and order stable) ───────────────────\n    96\tdescribe(\"Story 3: deterministic re-replay (TC-6.2)\", () => {\n    97\t  it(\"replays the same corpus into two fresh threads to byte-identical read-back — real, stable idempotency keys\", async () => {\n    98\t    // tool-heavy carries tool_call/tool_result correlation ids, so this also\n    99\t    // pins ID stability through the correlation path, not just text events.\n   100\t    const corpus = loadToolHeavyCorpus();\n   101\t    const threadA = await makeTempThread(store);\n   102\t    const threadB = await makeTempThread(store);\n   103\t\n   104\t    expect(await replayCorpus(corpus, threadA.threadRef)).toEqual({ matches: true });\n   105\t    expect(await replayCorpus(corpus, threadB.threadRef)).toEqual({ matches: true });\n   106\t\n   107\t    const readA = await readBack(threadA.threadRef);\n   108\t    const readB = await readBack(threadB.threadRef);\n   109\t\n   110\t    // Identical read-back: same events, same order, same idempotency keys.\n   111\t    expect(readA).toEqual(readB);\n   112\t    // The keys are the converter's real deterministic keys, not placeholders.\n   113\t    expect(readA.every((event) => event.idempotencyKey.startsWith(\"pi:replay:tool-heavy\"))).toBe(true);\n   114\t    expect(new Set(readA.map((event) => event.idempotencyKey)).size).toBe(readA.length);\n   115\t  });\n   116\t\n   117\t  it(\"re-replaying the same corpus into the SAME thread does not perturb the read-back (deterministic keys dedup)\", async () => {\n   118\t    const corpus = loadChattyCorpus();\n   119\t    const thread = await makeTempThread(store);\n   120\t\n   121\t    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n   122\t    const first = await readBack(thread.threadRef);\n   123\t\n   124\t    // A second replay re-delivers identical keys; the SDK dedups them, so the\n   125\t    // read-back is unchanged — re-replay perturbs neither IDs nor order.\n   126\t    const second = await replayCorpus(corpus, thread.threadRef);\n   127\t    expect(second).toEqual({ matches: true });\n   128\t    expect(await readBack(thread.threadRef)).toEqual(first);\n   129\t  });\n   130\t});\n   131\t\n   132\t// ── TC-6.3: inspect overview/health reflect the captured session ─────────────\n   133\tdescribe(\"Story 3: inspect overview/health reflect the captured session (TC-6.3)\", () => {\n   134\t  it(\"reports event/message counts, last recorded position, gaps, and failed derivations\", async () => {\n   135\t    const corpus = loadToolHeavyCorpus(); // 6 events → 5 messages, 1 closed turn\n   136\t    const thread = await makeTempThread(store);\n   137\t\n   138\t    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n   139\t\n   140\t    // Counts + last recorded position, cross-checked against the event log.\n   141\t    const overview1 = await inspect.overview(thread.threadRef);\n   142\t    expect(overview1.ok).toBe(true);\n   143\t    if (!overview1.ok) return;\n   144\t    const recorded = await intakeStream.listEvents(thread.threadRef);\n   145\t    expect(recorded.ok).toBe(true);\n   146\t    if (!recorded.ok) return;\n   147\t    const lastOrder = recorded.value.at(-1)?.eventOrder;\n   148\t\n   149\t    expect(overview1.value.events.count).toBe(corpus.expected.length); // 6\n   150\t    expect(overview1.value.events.span?.last).toBe(lastOrder); // last recorded position, surfaced\n   151\t    expect(overview1.value.messages.visible).toBe(5);\n   152\t    expect(overview1.value.messages.byKind).toEqual({\n   153\t      user_prompt: 1,\n   154\t      assistant_thinking: 1,\n   155\t      tool_call: 1,\n   156\t      tool_result: 1,\n   157\t      assistant_text: 1,\n   158\t    });\n   159\t    expect(overview1.value.turns.closed).toBe(1);\n   160\t    expect(overview1.value.turns.open).toBe(0);\n   161\t\n   162\t    // Failed derivations are visible, not hidden: Epic-1 replay is observe-only\n   163\t    // (inference fails closed), so the queued derivations land failed.\n   164\t    expect(overview1.value.derivation.failed).toBeGreaterThan(0);\n   165\t    const health1 = await inspect.health(thread.threadRef);\n   166\t    expect(health1.ok).toBe(true);\n   167\t    if (!health1.ok) return;\n   168\t    expect(health1.value.failures.length).toBeGreaterThan(0);\n   169\t\n   170\t    // A capture gap is visible, not hidden — induce one through the Story-2\n   171\t    // capture path (a turn_end with a non-empty payload is rejected as\n   172\t    // invalid_event, which records a durable gap note).\n   173\t    const instance = liveInstance(thread.threadRef);\n   174\t    const malformed = {\n   175\t      eventKind: \"turn_end\",\n   176\t      idempotencyKey: \"replay-induced-gap\",\n   177\t      actor: \"system\",\n   178\t      harness: \"pi\",\n   179\t      payload: { stowaway: true },\n   180\t    } as unknown as MessageEventInput;\n   181\t    const gapResult = await capture([malformed], instance);\n   182\t    expect(gapResult.ok).toBe(false);\n   183\t    await instance.dispose();\n   184\t\n   185\t    const health2 = await inspect.health(thread.threadRef);\n   186\t    expect(health2.ok).toBe(true);\n   187\t    if (!health2.ok) return;\n   188\t    expect(\n   189\t      health2.value.owners.some((owner) => owner.kind === \"capture_gap\" && owner.counts.failed > 0),\n   190\t    ).toBe(true);\n   191\t    expect(health2.value.failures.some((failure) => failure.form === \"capture_gap\")).toBe(true);\n   192\t\n   193\t    // The gap note is itself a recorded event — the last recorded position\n   194\t    // advances, proving the surface reflects new capture rather than a snapshot.\n   195\t    const overview2 = await inspect.overview(thread.threadRef);\n   196\t    expect(overview2.ok).toBe(true);\n   197\t    if (!overview2.ok) return;\n   198\t    expect(overview2.value.events.count).toBe(corpus.expected.length + 1);\n   199\t    expect(overview2.value.events.span?.last).toBeGreaterThan(overview1.value.events.span?.last ?? 0);\n   200\t  });\n   201\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/verify/replay.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport {\n     2\t  createSdk,\n     3\t  inspect,\n     4\t  intakeStream,\n     5\t  type DerivationProvider,\n     6\t  type EventRecord,\n     7\t  type InspectOverview,\n     8\t  type MessageEventInput,\n     9\t  type OpResult,\n    10\t  type ProviderResult,\n    11\t  type ThreadRef,\n    12\t} from \"lhc\";\n    13\timport type { AgentMessage } from \"../pi/types.js\";\n    14\timport type { LhcInstance } from \"../shared/instance.js\";\n    15\timport { capture, captureGap } from \"../capture/converter.js\";\n    16\timport { mapMessage, type MapCtx } from \"../capture/map-message.js\";\n    17\timport { TurnAccumulator } from \"../capture/turn-accumulator.js\";\n    18\t\n    19\t// AC-6.1, AC-6.2 (Flow 6, Story 3). Capture correctness is proven WITHOUT\n    20\t// serving anything to a model: a recorded PI corpus replays through the REAL\n    21\t// converter and intake path into a temp thread, and the thread's read-back —\n    22\t// events, messages, and turns — is compared to the fixture's expectation. The\n    23\t// same corpus replayed twice yields identical read-back because the converter's\n    24\t// mapping and the SDK's deterministic ids make replay reproducible.\n    25\t//\n    26\t// Anti-shim (story §Anti-Shim Requirements): this drives Story 2's converter\n    27\t// (`mapMessage` → `TurnAccumulator` → `capture`) exactly as live capture does —\n    28\t// it never writes the fixture's expected events to the thread, and it compares\n    29\t// events/messages/turns/order, never just counts. inspect's overview/health are\n    30\t// the live read-back surfaces a Story-3 test asserts on for AC-6.3.\n    31\t\n    32\t/** A loaded corpus: synthetic PI source messages (the stand-in until M0\n    33\t *  delivers recordings) paired with the expected LHC intake events. Both\n    34\t *  `verify/replay` and the corpus fixtures consume this shape. */\n    35\texport interface Corpus {\n    36\t  name: string;\n    37\t  source: AgentMessage[];\n    38\t  expected: MessageEventInput[];\n    39\t}\n    40\t\n    41\t/** A structured compare result with a readable diff (tech design §Technical\n    42\t *  Notes). `matches` is true only when events, messages, AND turns all line up\n    43\t *  with the fixture; `diff` names every divergence when they do not. */\n    44\texport interface ReplayResult {\n    45\t  matches: boolean;\n    46\t  diff?: string;\n    47\t}\n    48\t\n    49\tfunction detail(cause: unknown): string {\n    50\t  return cause instanceof Error ? cause.message : String(cause);\n    51\t}\n    52\t\n    53\t/** A construction-valid, fail-closed inference provider — the same observe-only\n    54\t *  shape the live Epic-1 session runs on (index.ts). Replay never serves context\n    55\t *  to a model, so every derivation operation fails closed (non-retryable) rather\n    56\t *  than fabricating derived text; the resulting failed derivations are exactly\n    57\t *  what inspect health must surface (AC-6.3), so the harness mirrors production\n    58\t *  rather than hiding them behind a succeeding fake. */\n    59\tfunction observeOnlyProvider(): DerivationProvider {\n    60\t  const notConfigured = (): Promise<ProviderResult> =>\n    61\t    Promise.resolve({\n    62\t      ok: false,\n    63\t      retryable: false,\n    64\t      reason: \"pi-lhc replay is observe-only (no inference served)\",\n    65\t    });\n    66\t  return {\n    67\t    smoothPrompt: notConfigured,\n    68\t    summarizeToolCall: notConfigured,\n    69\t    summarizeToolResult: notConfigured,\n    70\t    composeTurnRendering: notConfigured,\n    71\t    projectLowerBand: notConfigured,\n    72\t    summarizeChunkDetailed: notConfigured,\n    73\t    summarizeChunkBrief: notConfigured,\n    74\t  };\n    75\t}\n    76\t\n    77\t/** Build a real background LHC instance against the temp thread. The converter\n    78\t *  writes through `instance.sdk.intakeStream`, and `dispose` drains settled so\n    79\t *  background derivations reach a terminal state before read-back — the same\n    80\t *  flush-on-dispose contract the lifecycle instance uses, rebuilt here because\n    81\t *  `verify` may not import `lifecycle` (boundary rule 3). */\n    82\tfunction buildReplayInstance(threadRef: ThreadRef): LhcInstance {\n    83\t  const sdk = createSdk({ provider: observeOnlyProvider(), mode: \"background\" });\n    84\t  return {\n    85\t    sdk,\n    86\t    threadRef,\n    87\t    dispose: async (): Promise<OpResult<void>> => {\n    88\t      try {\n    89\t        await sdk.drainSettled(threadRef);\n    90\t      } catch {\n    91\t        // Best-effort flush; replay's verdict comes from durable read-back, not\n    92\t        // from the drain, and a drain failure must not throw out of verify.\n    93\t      }\n    94\t      return { ok: true, value: undefined };\n    95\t    },\n    96\t  };\n    97\t}\n    98\t\n    99\t/** A deterministic per-replay session id derived from the CORPUS, not the\n   100\t *  thread: it scopes every idempotency key, so the same corpus replayed into two\n   101\t *  different temp threads produces byte-identical keys (AC-6.2), while different\n   102\t *  corpora never collide. */\n   103\tfunction replaySessionId(corpus: Corpus): string {\n   104\t  return `replay:${corpus.name}`;\n   105\t}\n   106\t\n   107\t/** Drive one corpus through the real converter into the thread, reconstructing\n   108\t *  the PI hook stream a live session would have fired: each source message is a\n   109\t *  `message_end` (mapped + accumulated + flushed), and an `agent_end` closes the\n   110\t *  LHC turn at each agent-run boundary — before a fresh user prompt and once at\n   111\t *  end-of-stream — so PI's \"a new prompt starts a new run\" shows up as exactly\n   112\t *  one `turn_end` per run (AC-2.2 semantics, exercised end to end here). */\n   113\tasync function driveCorpus(corpus: Corpus, instance: LhcInstance): Promise<void> {\n   114\t  const piSessionId = replaySessionId(corpus);\n   115\t  const accumulator = new TurnAccumulator({ piSessionId });\n   116\t\n   117\t  for (const [index, message] of corpus.source.entries()) {\n   118\t    // A new user prompt with a turn already open means the previous agent run\n   119\t    // ended: close it first (agent_end), then record the prompt that opens the\n   120\t    // next run.\n   121\t    if (message.role === \"user\" && accumulator.hasOpenTurn()) {\n   122\t      await flush(accumulator.onAgentEnd(), instance);\n   123\t    }\n   124\t\n   125\t    // Real recorded PI message_end always carries a stable entry id; the\n   126\t    // synthetic corpora omit it, so stamp a deterministic per-message id so the\n   127\t    // converter keys off its Tier-1 path exactly as production does.\n   128\t    const mapCtx: MapCtx = { piSessionId, entryId: `${piSessionId}:entry:${index}` };\n   129\t    let events: MessageEventInput[];\n   130\t    try {\n   131\t      events = mapMessage(message, mapCtx);\n   132\t    } catch (cause) {\n   133\t      // An unmappable source message degrades to a durable, queryable gap —\n   134\t      // never a thrown replay (mirrors index.ts's capture-failure isolation).\n   135\t      await captureGap(`${piSessionId}:entry:${index}`, `replay map failed: ${detail(cause)}`, instance);\n   136\t      continue;\n   137\t    }\n   138\t    accumulator.onMessage(events);\n   139\t    await flush(events, instance);\n   140\t  }\n   141\t\n   142\t  // Close the final open turn (the last agent run's agent_end).\n   143\t  await flush(accumulator.onAgentEnd(), instance);\n   144\t}\n   145\t\n   146\tasync function flush(events: MessageEventInput[], instance: LhcInstance): Promise<void> {\n   147\t  if (events.length === 0) return;\n   148\t  await capture(events, instance);\n   149\t}\n   150\t\n   151\t/** Strip the server-stamped order/timestamp so the comparison is over the\n   152\t *  logical intake shape the converter produced — including the real, stable\n   153\t *  idempotency keys (kept so AC-6.2's determinism is checkable on the read-back),\n   154\t *  excluding `recordedAt` (a wall-clock value that legitimately differs run to\n   155\t *  run). */\n   156\tfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n   157\t  return records.map(\n   158\t    (record) =>\n   159\t      ({\n   160\t        eventKind: record.eventKind,\n   161\t        idempotencyKey: record.idempotencyKey,\n   162\t        actor: record.actor,\n   163\t        harness: record.harness,\n   164\t        payload: record.payload,\n   165\t      }) as MessageEventInput,\n   166\t  );\n   167\t}\n   168\t\n   169\t/** Order-independent canonical JSON for value comparison: object keys sorted\n   170\t *  recursively so two structurally-equal payloads built in different key orders\n   171\t *  compare equal. */\n   172\tfunction canonical(value: unknown): string {\n   173\t  return JSON.stringify(sortKeys(value));\n   174\t}\n   175\t\n   176\tfunction sortKeys(value: unknown): unknown {\n   177\t  if (Array.isArray(value)) return value.map(sortKeys);\n   178\t  if (value !== null && typeof value === \"object\") {\n   179\t    const out: Record<string, unknown> = {};\n   180\t    for (const key of Object.keys(value as Record<string, unknown>).sort()) {\n   181\t      out[key] = sortKeys((value as Record<string, unknown>)[key]);\n   182\t    }\n   183\t    return out;\n   184\t  }\n   185\t  return value;\n   186\t}\n   187\t\n   188\tinterface MessageProjection {\n   189\t  visible: number;\n   190\t  byKind: Record<string, number>;\n   191\t}\n   192\t\n   193\t/** The message read-back the fixture implies: each non-`turn_end` event projects\n   194\t *  to exactly one message of its kind (LHC's projection, verified 1:1), so the\n   195\t *  expected `messages.visible` and `messages.byKind` fall straight out of the\n   196\t *  expected event list. */\n   197\tfunction expectedMessages(expected: readonly MessageEventInput[]): MessageProjection {\n   198\t  const byKind: Record<string, number> = {};\n   199\t  let visible = 0;\n   200\t  for (const event of expected) {\n   201\t    if (event.eventKind === \"turn_end\") continue;\n   202\t    byKind[event.eventKind] = (byKind[event.eventKind] ?? 0) + 1;\n   203\t    visible += 1;\n   204\t  }\n   205\t  return { visible, byKind };\n   206\t}\n   207\t\n   208\t/** Compare the actual read-back (events, plus messages/turns from inspect\n   209\t *  overview) to the fixture's expectation, accumulating a readable diff. Returns\n   210\t *  `null` on a full match. */\n   211\tfunction compareReadback(\n   212\t  corpus: Corpus,\n   213\t  actual: readonly MessageEventInput[],\n   214\t  overview: InspectOverview,\n   215\t): string[] {\n   216\t  const problems: string[] = [];\n   217\t  const expected = corpus.expected;\n   218\t\n   219\t  // Events — kind + payload, in source-event order (never counts alone).\n   220\t  if (actual.length !== expected.length) {\n   221\t    problems.push(`events.count: expected ${expected.length}, got ${actual.length}`);\n   222\t  }\n   223\t  for (let i = 0; i < Math.max(actual.length, expected.length); i += 1) {\n   224\t    const want = expected[i];\n   225\t    const got = actual[i];\n   226\t    if (want === undefined) {\n   227\t      problems.push(`events[${i}]: unexpected extra ${got?.eventKind} ${canonical(got?.payload)}`);\n   228\t      continue;\n   229\t    }\n   230\t    if (got === undefined) {\n   231\t      problems.push(`events[${i}]: missing expected ${want.eventKind} ${canonical(want.payload)}`);\n   232\t      continue;\n   233\t    }\n   234\t    if (got.eventKind !== want.eventKind) {\n   235\t      problems.push(`events[${i}].kind: expected ${want.eventKind}, got ${got.eventKind}`);\n   236\t    } else if (canonical(got.payload) !== canonical(want.payload)) {\n   237\t      problems.push(\n   238\t        `events[${i}].payload (${want.eventKind}): expected ${canonical(want.payload)}, got ${canonical(got.payload)}`,\n   239\t      );\n   240\t    }\n   241\t  }\n   242\t\n   243\t  // Messages — projected counts by kind.\n   244\t  const expectedMsgs = expectedMessages(expected);\n   245\t  if (overview.messages.visible !== expectedMsgs.visible) {\n   246\t    problems.push(`messages.visible: expected ${expectedMsgs.visible}, got ${overview.messages.visible}`);\n   247\t  }\n   248\t  if (canonical(overview.messages.byKind) !== canonical(expectedMsgs.byKind)) {\n   249\t    problems.push(\n   250\t      `messages.byKind: expected ${canonical(expectedMsgs.byKind)}, got ${canonical(overview.messages.byKind)}`,\n   251\t    );\n   252\t  }\n   253\t\n   254\t  // Turns — one closed turn per expected `turn_end`, none left open.\n   255\t  const expectedClosed = expected.filter((event) => event.eventKind === \"turn_end\").length;\n   256\t  if (overview.turns.closed !== expectedClosed) {\n   257\t    problems.push(`turns.closed: expected ${expectedClosed}, got ${overview.turns.closed}`);\n   258\t  }\n   259\t  if (overview.turns.open !== 0) {\n   260\t    problems.push(`turns.open: expected 0, got ${overview.turns.open}`);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/fixtures/corpus.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n     2\t// named lifecycle paired with the LHC intake events it should produce. Until M0\n     3\t// delivers real recordings, the loaders build synthetic stand-ins; the\n     4\t// machinery (load → validate shape → compare on replay in Story 3) is real and\n     5\t// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n     6\t// hardcodes a passing count (story §Anti-Shim Requirements).\n     7\timport type { EventKind } from \"lhc\";\n     8\timport type { Corpus } from \"../../src/verify/replay.js\";\n     9\timport { ABORTED_DISPOSITION_TEXT } from \"../../src/capture/map-message.js\";\n    10\timport {\n    11\t  makeAssistantMessage,\n    12\t  makeToolResult,\n    13\t  makeUserMessage,\n    14\t  validEvent,\n    15\t} from \"./synthetic.js\";\n    16\t\n    17\tconst CALL_A = \"call_a|fc_1\";\n    18\tconst CALL_B = \"call_b|fc_2\";\n    19\t\n    20\t/** Plain user/assistant text exchanges, no tools. */\n    21\texport function loadChattyCorpus(): Corpus {\n    22\t  return {\n    23\t    name: \"chatty\",\n    24\t    source: [\n    25\t      makeUserMessage(\"what does this repo do?\"),\n    26\t      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n    27\t      makeUserMessage(\"and the connector?\"),\n    28\t      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n    29\t    ],\n    30\t    expected: [\n    31\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n    32\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n    33\t      validEvent(\"turn_end\"),\n    34\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n    35\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n    36\t      validEvent(\"turn_end\"),\n    37\t    ],\n    38\t  };\n    39\t}\n    40\t\n    41\t/** One turn with a single tool run: thinking → call → result → answer. */\n    42\texport function loadToolHeavyCorpus(): Corpus {\n    43\t  return {\n    44\t    name: \"tool-heavy\",\n    45\t    source: [\n    46\t      makeUserMessage(\"read notes.txt\"),\n    47\t      makeAssistantMessage({\n    48\t        thinking: \"I should open the file\",\n    49\t        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n    50\t      }),\n    51\t      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n    52\t      makeAssistantMessage({ text: \"the file says hello\" }),\n    53\t    ],\n    54\t    expected: [\n    55\t      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n    56\t      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n    57\t      validEvent(\"tool_call\", {\n    58\t        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    59\t      }),\n    60\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n    61\t      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n    62\t      validEvent(\"turn_end\"),\n    63\t    ],\n    64\t  };\n    65\t}\n    66\t\n    67\t/** Two parallel tool calls whose results complete out of order; correlation is\n    68\t *  by id, not arrival order (AC-2.3). */\n    69\texport function loadParallelToolCorpus(): Corpus {\n    70\t  return {\n    71\t    name: \"parallel-tool\",\n    72\t    source: [\n    73\t      makeUserMessage(\"read both files\"),\n    74\t      makeAssistantMessage({\n    75\t        toolCalls: [\n    76\t          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n    77\t          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n    78\t        ],\n    79\t      }),\n    80\t      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n    81\t      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n    82\t      makeAssistantMessage({ text: \"read both\" }),\n    83\t    ],\n    84\t    expected: [\n    85\t      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n    86\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n    87\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n    88\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n    89\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n    90\t      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n    91\t      validEvent(\"turn_end\"),\n    92\t    ],\n    93\t  };\n    94\t}\n    95\t\n    96\t/** A tool result flagged as an error, captured with its content (AC-2.4). */\n    97\texport function loadErrorResultCorpus(): Corpus {\n    98\t  return {\n    99\t    name: \"error-result\",\n   100\t    source: [\n   101\t      makeUserMessage(\"read missing.txt\"),\n   102\t      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n   103\t      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n   104\t      makeAssistantMessage({ text: \"that file does not exist\" }),\n   105\t    ],\n   106\t    expected: [\n   107\t      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n   108\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n   109\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n   110\t      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n   111\t      validEvent(\"turn_end\"),\n   112\t    ],\n   113\t  };\n   114\t}\n   115\t\n   116\t/** A graceful interrupt: partial assistant content, turn closed\n   117\t *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\n   118\texport function loadAbortedTurnCorpus(): Corpus {\n   119\t  return {\n   120\t    name: \"aborted-turn\",\n   121\t    source: [\n   122\t      makeUserMessage(\"write a long essay\"),\n   123\t      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n   124\t    ],\n   125\t    expected: [\n   126\t      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n   127\t      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n   128\t      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n   129\t      // The aborted disposition rides a trailing runtime_note (the mapper carries\n   130\t      // stopReason through; research §5b), then the turn closes complete-but-aborted.\n   131\t      validEvent(\"runtime_note\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\n   132\t      validEvent(\"turn_end\"),\n   133\t    ],\n   134\t  };\n   135\t}\n   136\t\n   137\texport const CORPUS_LOADERS = {\n   138\t  chatty: loadChattyCorpus,\n   139\t  \"tool-heavy\": loadToolHeavyCorpus,\n   140\t  \"parallel-tool\": loadParallelToolCorpus,\n   141\t  \"error-result\": loadErrorResultCorpus,\n   142\t  \"aborted-turn\": loadAbortedTurnCorpus,\n   143\t} as const;\n   144\t\n   145\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n   146\t\n   147\texport function loadAllCorpora(): Corpus[] {\n   148\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n   149\t}\n   150\t\n   151\t/** A deliberately malformed sequence for the capture-failure test: an empty\n   152\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n   153\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n   154\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n   155\texport function makeTruncatedCorpus(): Corpus {\n   156\t  return {\n   157\t    name: \"truncated\",\n   158\t    source: [makeUserMessage(\"\")],\n   159\t    expected: [\n   160\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n   161\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n   162\t    ],\n   163\t  };\n   164\t}\n   165\t\n   166\texport interface CorpusValidation {\n   167\t  valid: boolean;\n   168\t  problems: string[];\n   169\t}\n   170\t\n   171\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n   172\t  \"user_prompt\",\n   173\t  \"assistant_text\",\n   174\t  \"assistant_thinking\",\n   175\t  \"runtime_note\",\n   176\t  \"tool_call\",\n   177\t  \"tool_result\",\n   178\t  \"turn_end\",\n   179\t]);\n   180\t\n   181\t/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n   182\t *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n   183\t *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n   184\t *  found — `valid` is derived from that list, never a constant. */\n   185\texport function validateCorpus(corpus: Corpus): CorpusValidation {\n   186\t  const problems: string[] = [];\n   187\t  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n   188\t  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n   189\t\n   190\t  const seenToolCalls = new Set<string>();\n   191\t  for (const [i, ev] of corpus.expected.entries()) {\n   192\t    const at = `${corpus.name}[${i}]`;\n   193\t    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n   194\t    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n   195\t    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n   196\t    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n   197\t\n   198\t    switch (ev.eventKind) {\n   199\t      case \"user_prompt\":\n   200\t      case \"assistant_text\":\n   201\t      case \"assistant_thinking\":\n   202\t      case \"runtime_note\": {\n   203\t        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n   204\t          problems.push(`${at}: ${ev.eventKind} has empty text`);\n   205\t        }\n   206\t        break;\n   207\t      }\n   208\t      case \"tool_call\": {\n   209\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   210\t          problems.push(`${at}: tool_call has empty toolCallId`);\n   211\t        } else {\n   212\t          seenToolCalls.add(ev.payload.toolCallId);\n   213\t        }\n   214\t        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n   215\t          problems.push(`${at}: tool_call has empty toolName`);\n   216\t        }\n   217\t        break;\n   218\t      }\n   219\t      case \"tool_result\": {\n   220\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   221\t          problems.push(`${at}: tool_result has empty toolCallId`);\n   222\t        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n   223\t          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n   224\t        }\n   225\t        if (typeof ev.payload.content !== \"string\") {\n   226\t          problems.push(`${at}: tool_result has non-string content`);\n   227\t        }\n   228\t        break;\n   229\t      }\n   230\t      case \"turn_end\":\n   231\t        break;\n   232\t    }\n   233\t  }\n   234\t\n   235\t  const last = corpus.expected[corpus.expected.length - 1];\n   236\t  if (last !== undefined && last.eventKind !== \"turn_end\") {\n   237\t    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n   238\t  }\n   239\t\n   240\t  return { valid: problems.length === 0, problems };\n","exit_code":0,"status":"completed"}}

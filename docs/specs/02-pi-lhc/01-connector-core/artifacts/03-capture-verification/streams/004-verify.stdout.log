\\\\t\\\\n34\\\\texport interface ThreadInfo {\\\\n35\\\\t  threadId: string;\\\\n36\\\\t  filePath: string;\\\\n37\\\\t  title?: string;\\\\n38\\\\t  createdAt: string; // ISO-8601\\\\n39\\\\t}\\\\n40\\\\t\\\\n41\\\\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\\\\n42\\\\t  const info: ThreadInfo = {\\\\n43\\\\t    threadId: row.threadId,\\\\n44\\\\t    filePath: row.filePath,\\\\n45\\\\t    createdAt: row.createdAt,\\\\n46\\\\t  };\\\\n47\\\\t  if (row.title !== undefined) info.title = row.title;\\\\n48\\\\t  return info;\\\\n49\\\\t}\\\\n50\\\\t\\\\n51\\\\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\\\\n52\\\\t  return {\\\\n53\\\\t    ok: false,\\\\n54\\\\t    error: {\\\\n55\\\\t      errorClass: \\\\\\\"caller_error\\\\\\\",\\\\n56\\\\t      code: \\\\\\\"thread_not_found\\\\\\\",\\\\n57\\\\t      reason: `no thread registered with id ${threadId}`,\\\\n58\\\\t    },\\\\n59\\\\t  };\\\\n60\\\\t}\\\\n61\\\\t\\\\n62\\\\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\\\\n63\\\\t  return {\\\\n64\\\\t    ok: false,\\\\n65\\\\t    error: { errorClass: \\\\\\\"caller_error\\\\\\\", code: \\\\\\\"invalid_thread_ref\\\\\\\", reason },\\\\n66\\\\t  };\\\\n67\\\\t}\\\\n68\\\\t\\\\n69\\\\t// A file path that is empty or whitespace-only cannot name a durable file:\\\\n70\\\\t// node:sqlite's DatabaseSync(\\\\\\\"\\\\\\\") opens a temporary database that vanishes on\\\\n71\\\\t// close, so such a path must be refused as a caller error before any storage\\\\n72\\\\t// is touched rather than silently producing a thread with no durable file.\\\\n73\\\\tfunction isBlankPath(filePath: string): boolean {\\\\n74\\\\t  return filePath.trim() === \\\\\\\"\\\\\\\";\\\\n75\\\\t}\\\\n76\\\\t\\\\n77\\\\tfunction detail(cause: unknown): string {\\\\n78\\\\t  return cause instanceof Error ? cause.message : String(cause);\\\\n79\\\\t}\\\\n80\\\\t\\\\n81\\\\t// Creation spans two databases that cannot share a transa
\\\\n81\\\\t  ProviderResult,\\\\n82\\\\t  RenderingPart,\\\\n83\\\\t  ResolvedSdkConfig,\\\\n84\\\\t  SdkConfig,\\\\n85\\\\t  SubjectKind,\\\\n86\\\\t  ToolOutcome,\\\\n87\\\\t  ToolRunReceipt,\\\\n88\\\\t  WorkHandler,\\\\n89\\\\t} from \\\\\\\"./shared/derivation.js\\\\\\\";\\\\n90\\\\texport type { DrainReport, Scheduler, SchedulerMode } from \\\\\\\"./scheduler.js\\\\\\\";\\\\n91\\\\t\\\\n92\\\\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\\\\n93\\\\t// from Story 0; the operation shapes land with Stories 1–5.\\\\n94\\\\texport {\\\\n95\\\\t  BUILT_IN_PROFILES,\\\\n96\\\\t  DEFAULT_COMPACT_THRESHOLD,\\\\n97\\\\t  DEFAULT_VISIBILITY,\\\\n98\\\\t} from \\\\\\\"./domains/thread-view/index.js\\\\\\\";\\\\n99\\\\texport type {\\\\n100\\\\t  Band,\\\\n101\\\\t  CompactReceipt,\\\\n102\\\\t  PullResult,\\\\n103\\\\t  ResolvedViewConfig,\\\\n104\\\\t  SdkViewConfig,\\\\n105\\\\t  SweepReceipt,\\\\n106\\\\t  ViewMessage,\\\\n107\\\\t  ViewMeta,\\\\n108\\\\t  ViewProfile,\\\\n109\\\\t  ViewProfileOverride,\\\\n110\\\\t  ViewStatus,\\\\n111\\\\t  VisibilityBudgets,\\\\n112\\\\t} from \\\\\\\"./shared/view.js\\\\\\\";\\\\n113\\\\texport {\\\\n114\\\\t  countLiveItems,\\\\n115\\\\t  enqueue,\\\\n116\\\\t  queueDetail,\\\\n117\\\\t  supersedeQueued,\\\\n118\\\\t  type ClaimedWorkItem,\\\\n119\\\\t  type EnqueueFormTarget,\\\\n120\\\\t  type EnqueueInput,\\\\n121\\\\t  type QueueDetailRow,\\\\n122\\\\t} from \\\\\\\"./tech-utils/work-queue/index.js\\\\\\\";\\\\n123\\\\t\\\\n124\\\\texport type { ThreadRef } from \\\\\\\"./domains/threads/index.js\\\\\\\";\\\\n125\\\\texport type {\\\\n126\\\\t  Block,\\\\n127\\\\t  BlockType,\\\\n128\\\\t  MessageRecord,\\\\n129\\\\t  MutationResult,\\\\n130\\\\t} from \\\\\\\"./domains/messages/index.js\\\\\\\";\\\\n131\\\\texport type { ChunkRecord, TurnRecord } from \\\\\\\"./domains/turns/index.js\\\\\\\";\\\\n132\\\\texport type {\\\\n133\\\\t  BatchResult,\\\\n134\\\\t  EventKind,\\\\n135\\\\t  EventRecord,\\\\n136\\\\t  MessageEventInput,\\\\n137\\\\t} from \\\\\\\"./domains/intake-stream/index.js\\\\\\\";\\\\n138\\\\t\\\\n139\\\\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\\\n140\\\\t\\\\n141\\\\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\\\n142\\\\t\\\\n143\\\\t// Merge per-domain handler tables into the one join between the queue's\\\\n144\\\\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\\\n145\\\\t// (each kind has exactly one owner) and throws at construction.\\\\n146\\\\texport function assembleWorkHandlerMap(\\\\n147\\\\t  tables: ReadonlyArray<WorkHandlerMap>,\\\\n148\\\\t): WorkHandlerMap {\\\\n149\\\\t  const map: WorkHandlerMap = {};\\\\n150\\\\t  for (const table of tables) {\\\\n151\\\\t    for (const [kind, handler] of Object.entries(table)) {\\\\n152\\\\t      if (map[kind as WorkKind] !== undefined) {\\\\n153\\\\t        throw new TypeError(`work kind \\\\\\\"${kind}\\\\\\\" registered by more than one domain`);\\\\n154\\\\t      }\\\\n155\\\\t      map[kind as WorkKind] = handler;\\\\n156\\\\t    }\\\\n157\\\\t  }\\\\n158\\\\t  return map;\\\\n159\\\\t}\\\\n160\\\\t\\\\n161\\\\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\\\n162\\\\t  return {\\\\n163\\\\t    ok: false,\\\\n164\\\\t    error: {\\\\n165\\\\t      errorClass: \\\\\\\"state_corruption\\\\\\\",\\\\n166\\\\t      code: \\\\\\\"unknown_work_kind\\\\\\\",\\\\n167\\\\t      reason: `no handler registered for work kind \\\\\\\"${kind}\\\\\\\"`,\\\\n168\\\\t    },\\\\n169\\\\t  };\\\\n170\\\\t}\\\\n171\\\\t\\\\n172\\\\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\\\n173\\\\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\\\n174\\\\texport function lookupWorkHandler(\\\\n175\\\\t  map: WorkHandlerMap,\\\\n176\\\\t  kind: string,\\\\n177\\\\t): OpResult<WorkHandler> {\\\\n178\\\\t  const handler = map[kind as WorkKind];\\\\n179\\\\t  if (handler === undefined) return unknownWorkKind(kind);\\\\n180\\\\t  return { ok: true, value: handler };\\\\n181\\\\t}\\\\n182\\\\t\\\\n183\\\\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\\\n184\\\\t// requeue land in Story 4.\\\\n185\\\\texport interface WorkSurface {\\\\n186\\\\t  drain(\\\\n187\\\\t    ref: threadsDomain.ThreadRef,\\\\n188\\\\t    opts?: { maxItems?: number },\\\\n189\\\\t  ): Promise<OpResult<DrainReport>>;\\\\n190\\\\t}\\\\n191\\\\t\\\\n192\\\\texport interface Lhc {\\\\n193\\\\t  threads: typeof threadsDomain;\\\\n194\\\\t  intakeStream: typeof intakeStreamDomain;\\\\n195\\\\t  messages: typeof messagesDomain;\\\\n196\\\\t  turns: typeof turnsDomain;\\\\n197\\\\t  config: ResolvedSdkConfig;\\\\n198\\\\t  scheduler: Scheduler;\\\\n199\\\\t  workHandlers: WorkHandlerMap;\\\\n200\\\\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\\\n201\\\\t  work: WorkSurface;\\\\n202\\\\t  // Resolves when the scheduler has no running or pending drain for the\\\\n203\\\\t  // thread (issue 3) — the awaitable for background mode, and a no-op\\\\n204\\\\t  // resolve in manual mode.\\\\n205\\\\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\\\n206\\\\t}\\\\n207\\\\t\\\\n208\\\\tfunction requirePositive(value: number, name: string): void {\\\\n209\\\\t  if (!Number.isFinite(value) || value <= 0) {\\\\n210\\\\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\\\n211\\\\t  }\\\\n212\\\\t}\\\\n213\\\\t\\\\n214\\\\tfunction requireNonNegative(value: number, name: string): void {\\\\n215\\\\t  if (!Number.isFinite(value) || value < 0) {\\\\n216\\\\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\\\n217\\\\t  }\\\\n218\\\\t}\\\\n219\\\\t\\\\n220\\\\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\\\n221\\\\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\\\n222\\\\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\\\n223\\\\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\\\\n224\\\\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\\\n225\\\\t// object is the same shape as the namespace, so the public surface type holds.\\\\n226\\\\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\\\n227\\\\t  const scoped: Record<string, unknown> = {};\\\\n228\\\\t  for (const key of Object.keys(surface)) {\\\\n229\\\\t    const value = (surface as Record<string, unknown>)[key];\\\\n230\\\\t    scoped[key] =\\\\n231\\\\t      typeof value === \\\\\\\"function\\\\\\\"\\\\n232\\\\t        ? (...args: unknown[]): unknown =>\\\\n233\\\\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\\\n234\\\\t        : value;\\\\n235\\\\t  }\\\\n236\\\\t  return scoped as T;\\\\n237\\\\t}\\\\n238\\\\t\\\\n239\\\\t// The only assembly path: provider, mode, clock, and policy enter here.\\\\n240\\\\t// Config mistakes are programmer errors at construction and throw; operating\\\\n241\\\\t// failures after construction return OpResults per the error contract.\\\\n242\\\\texport function createSdk(config: SdkConfig): Lhc {\\\\n243\\\\t  if (config.mode !== \\\\\\\"background\\\\\\\" && config.mode !== \\\\\\\"manual\\\\\\\") {\\\\n244\\\\t    throw new TypeError(\\\\n245\\\\t      `createSdk config: mode must be \\\\\\\"background\\\\\\\" or \\\\\\\"manual\\\\\\\", got ${JSON.stringify(config.mode)}`,\\\\n246\\\\t    );\\\\n247\\\\t  }\\\\n248\\\\t  if (config.provider === null || typeof config.provider !== \\\\\\\"object\\\\\\\") {\\\\n249\\\\t    throw new TypeError(\\\\\\\"createSdk config: provider must implement DerivationProvider\\\\\\\");\\\\n250\\\\t  }\\\\n251\\\\t  for (const operation of PROVIDER_OPERATIONS) {\\\\n252\\\\t    if (typeof config.provider[operation] !== \\\\\\\"function\\\\\\\") {\\\\n253\\\\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\\\n254\\\\t    }\\\\n255\\\\t  }\\\\n256\\\\t\\\\n257\\\\t  const resolved: ResolvedSdkConfig = {\\\\n258\\\\t    provider: config.provider,\\\\n259\\\\t    mode: config.mode,\\\\n260\\\\t    clock: config.clock ?? (() => new Date()),\\\\n261\\\\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\\\n262\\\\t    lease: config.lease ?? { durationMs: 120000 },\\\\n263\\\\t    chunkPolicy:\\\\n264\\\\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\\\n265\\\\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\\\n266\\\\t    // sums and visibility budgets validated — throws naming the violation.\\\\n267\\\\t    view: resolveViewConfig(config.view),\\\\n268\\\\t  };\\\\n269\\\\t  requirePositive(resolved.retry.budget, \\\\\\\"retry.budget\\\\\\\");\\\\n270\\\\t  requireNonNegative(resolved.retry.backoffBaseMs, \\\\\\\"retry.backoffBaseMs\\\\\\\");\\\\n271\\\\t  requireNonNegative(resolved.retry.backoffCapMs, \\\\\\\"retry.backoffCapMs\\\\\\\");\\\\n272\\\\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\\\n273\\\\t    throw new TypeError(\\\\\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\\\\\");\\\\n274\\\\t  }\\\\n275\\\\t  requirePositive(resolved.lease.durationMs, \\\\\\\"lease.durationMs\\\\\\\");\\\\n276\\\\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\\\\\"chunkPolicy.targetProjectedTokens\\\\\\\");\\\\n277\\\\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\\\n278\\\\t    throw new TypeError(\\\\n279\\\\t      \\\\\\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\\\\\",\\\\n280\\\\t    );\\\\n281\\\\t  }\\\\n282\\\\t\\\\n283\\\\t  // Handler maps merge from per-domain contributions at construction (DD-6).\\\\n284\\\\t  // The tables are empty until Stories 2–3 land the real handlers; the\\\\n285\\\\t  // assembly mechanics are production code from day one.\\\\n286\\\\t  const workHandlers = assembleWorkHandlerMap([\\\\n287\\\\t    messagesDomain.workHandlers,\\\\n288\\\\t    turnsDomain.workHandlers,\\\\n289\\\\t  ]);\\\\n290\\\\t\\\\n291\\\\t  const drainDeps: DrainDeps = {\\\\n292\\\\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\\\n293\\\\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\\\n294\\\\t    config: resolved,\\\\n295\\\\t  };\\\\n296\\\\t  const scheduler = createScheduler(resolved.mode, drainDeps);\\\\n297\\\\t\\\\n298\\\\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\\\n299\\\\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\\\n300\\\\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\\\n301\\\\t  // background mode, or a no-op in manual mode — isolated from any other SDK\\\\n302\\\\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\\\\n303\\\\t  // the construction order, because its operations deliver to the no-op seam,\\\\n304\\\\t  // not to whatever a background SDK installed below.\\\\n305\\\\t  const seam: InstanceSeam =\\\\n306\\\\t    resolved.mode === \\\\\\\"background\\\\\\\"\\\\n307\\\\t      ? {\\\\n308\\\\t          poke: (threadId) => scheduler.poke(threadId),\\\\n309\\\\t          touch: (filePath, db) => scheduler.touch(filePath, db),\\\\n310\\\\t        }\\\\n311\\\\t      : { poke: () => {}, touch: () => {} };\\\\n312\\\\t\\\\n313\\\\t  // Background mode also installs the below-SDK default seam so a direct\\\\n314\\\\t  // domain call made with no SDK scope — a top-level mutation in the\\\\n315\\\\t  // single-background \\\\\\\"production path\\\\\\\" — still reaches the one installed\\\\n316\\\\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\\\\n317\\\\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\\\n318\\\\t  // leaves the default alone (pokes stay no-ops by contract).\\\\n319\\\\t  if (resolved.mode === \\\\\\\"background\\\\\\\") {\\\\n320\\\\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\\\n321\\\\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\\\n322\\\\t  }\\\\n323\\\\t\\\\n324\\\\t  const work: WorkSurface = {\\\\n325\\\\t    drain: (ref, opts) =>\\\\n326\\\\t      runWithInstanceSeam(seam, async () => {\\\\n327\\\\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\\\n328\\\\t        if (!resolvedRef.ok) return resolvedRef;\\\\n329\\\\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\\\n330\\\\t      }),\\\\n331\\\\t  };\\\\n332\\\\t\\\\n333\\\\t  return {\\\\n334\\\\t    threads: threadsDomain,\\\\n335\\\\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\\\\n336\\\\t    messages: scopeSurface(messagesDomain, seam),\\\\n337\\\\t    turns: scopeSurface(turnsDomain, seam),\\\\n338\\\\t    config: resolved,\\\\n339\\\\t    scheduler,\\\\n340\\\\t    workHandlers,\\\\n341\\\\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\\\n342\\\\t    work,\\\\n343\\\\t    drainSettled: async (ref) => {\\\\n344\\\\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\\\n345\\\\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\\\n346\\\\t      const threadId = peekThreadId(resolvedRef.value.filePath);\\\\n347\\\\t      if (threadId === null) return;\\\\n348\\\\t      return scheduler.drainSettled(threadId);\\\\n349\\\\t    },\\\\n350\\\\t  };\\\\n351\\\\t}\\\\n352\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"28aec8fc-3297-4f03-8488-65ebfbadd697\\\",\\\"uuid\\\":\\\"332b159f-d313-4aa9-9c40-db6b03af8c68\\\",\\\"timestamp\\\":\\\"2026-06-11T14:38:07.021Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts\\\",\\\"content\\\":\\\"export * as threads from \\\\\\\"./domains/threads/index.js\\\\\\\";\\\\nexport * as intakeStream from \\\\\\\"./domains/intake-stream/index.js\\\\\\\";\\\\nexport * as messages from \\\\\\\"./domains/messages/index.js\\\\\\\";\\\\nexport * as turns from \\\\\\\"./domains/turns/index.js\\\\\\\";\\\\n\\\\nimport * as intakeStreamDomain from \\\\\\\"./domains/intake-stream/index.js\\\\\\\";\\\\nimport { resolveViewConfig } from \\\\\\\"./domains/thread-view/index.js\\\\\\\";\\\\nimport * as messagesDomain from \\\\\\\"./domains/messages/index.js\\\\\\\";\\\\nimport * as threadsDomain from \\\\\\\"./domains/threads/index.js\\\\\\\";\\\\nimport * as turnsDomain from \\\\\\\"./domains/turns/index.js\\\\\\\";\\\\nimport {\\\\n  createScheduler,\\\\n  peekThreadId,\\\\n  runDrain,\\\\n  type DrainDeps,\\\\n  type DrainReport,\\\\n  type Scheduler,\\\\n} from \\\\\\\"./scheduler.js\\\\\\\";\\\\nimport {\\\\n  runWithInstanceSeam,\\\\n  setSchedulerPoke as installSchedulerPoke,\\\\n  setThreadTouch,\\\\n  type InstanceSeam,\\\\n} from \\\\\\\"./shared/context.js\\\\\\\";\\\\nimport {\\\\n  PROVIDER_OPERATIONS,\\\\n  type ResolvedSdkConfig,\\\\n  type SdkConfig,\\\\n  type WorkHandler,\\\\n} from \\\\\\\"./shared/derivation.js\\\\\\\";\\\\nimport type { ErrorResult, OpResult } from \\\\\\\"./shared/errors.js\\\\\\\";\\\\nimport type { WorkKind } from \\\\\\\"./tech-utils/work-queue/index.js\\\\\\\";\\\\n\\\\nexport {\\\\n  estimateTokens,\\\\n  TOKEN_ESTIMATOR_ID,\\\\n} from \\\\\\\"./tech-utils/token-counting/index.js\\\\\\\";\\\\n\\\\nexport {\\\\n  WORK_KIND_REGISTRY,\\\\n  type WorkItemRecord,\\\\n  type WorkKind,\\\\n  type WorkOwner,\\\\n  type WorkSourceRef,\\\\n} from \\\\\\\"./tech-utils/work-queue/index.js\\\\\\\";\\\\n\\\\nexport type {\\\\n  ErrorClass,\\\\n  ErrorCode,\\\\n  ErrorResult,\\\\n  OpResult,\\\\n} from \\\\\\\"./shared/errors.js\\\\\\\";\\\\nexport {\\\\n  runInTransaction,\\\\n  setSchedulerPoke,\\\\n  setThreadTouch,\\\\n  type OperationContext,\\\\n} from \\\\\\\"./shared/context.js\\\\\\\";\\\\n\\\\nexport {\\\\n  createDeterministicProvider,\\\\n  deterministicOutcomesSuffix,\\\\n  deterministicReceiptsSuffix,\\\\n  deterministicText,\\\\n  type DeterministicOpName,\\\\n} from \\\\\\\"./providers/deterministic.js\\\\\\\";\\\\nexport { registeredProviderNames, resolveNamedProvider } from \\\\\\\"./providers/registry.js\\\\\\\";\\\\n\\\\nexport type {\\\\n  CompletionTx,\\\\n  DependencyGap,\\\\n  DerivationProvider,\\\\n  DerivedForm,\\\\n  DerivedFormMetadata,\\\\n  DerivedFormState,\\\\n  FormKind,\\\\n  FormReportEntry,\\\\n  HandlerFormWrite,\\\\n  HandlerOutcome,\\\\n  HandlerRunContext,\\\\n  ProviderResult,\\\\n  RenderingPart,\\\\n  ResolvedSdkConfig,\\\\n  SdkConfig,\\\\n  SubjectKind,\\\\n  ToolOutcome,\\\\n  ToolRunReceipt,\\\\n  WorkHandler,\\\\n} from \\\\\\\"./shared/derivation.js\\\\\\\";\\\\nexport type { DrainReport, Scheduler, SchedulerMode } from \\\\\\\"./scheduler.js\\\\\\\";\\\\n\\\\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\\\\n// from Story 0; the operation shapes land with Stories 1–5.\\\\nexport {\\\\n  BUILT_IN_PROFILES,\\\\n  DEFAULT_COMPACT_THRESHOLD,\\\\n  DEFAULT_VISIBILITY,\\\\n} from \\\\\\\"./domains/thread-view/index.js\\\\\\\";\\\\nexport type {\\\\n  Band,\\\\n  CompactReceipt,\\\\n  PullResult,\\\\n  ResolvedViewConfig,\\\\n  SdkViewConfig,\\\\n  SweepReceipt,\\\\n  ViewMessage,\\\\n  ViewMeta,\\\\n  ViewProfile,\\\\n  ViewProfileOverride,\\\\n  ViewStatus,\\\\n  VisibilityBudgets,\\\\n} from \\\\\\\"./shared/view.js\\\\\\\";\\\\nexport {\\\\n  countLiveItems,\\\\n  enqueue,\\\\n  queueDetail,\\\\n  supersedeQueued,\\\\n  type ClaimedWorkItem,\\\\n  type EnqueueFormTarget,\\\\n  type EnqueueInput,\\\\n  type QueueDetailRow,\\\\n} from \\\\\\\"./tech-utils/work-queue/index.js\\\\\\\";\\\\n\\\\nexport type { ThreadRef } from \\\\\\\"./domains/threads/index.js\\\\\\\";\\\\nexport type {\\\\n  Block,\\\\n  BlockType,\\\\n  MessageRecord,\\\\n  MutationResult,\\\\n} from \\\\\\\"./domains/messages/index.js\\\\\\\";\\\\nexport type { ChunkRecord, TurnRecord } from \\\\\\\"./domains/turns/index.js\\\\\\\";\\\\nexport type {\\\\n  BatchResult,\\\\n  EventKind,\\\\n  EventRecord,\\\\n  MessageEventInput,\\\\n} from \\\\\\\"./domains/intake-stream/index.js\\\\\\\";\\\\n\\\\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\\\n\\\\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\\\n\\\\n// Merge per-domain handler tables into the one join between the queue's\\\\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\\\n// (each kind has exactly one owner) and throws at construction.\\\\nexport function assembleWorkHandlerMap(\\\\n  tables: ReadonlyArray<WorkHandlerMap>,\\\\n): WorkHandlerMap {\\\\n  const map: WorkHandlerMap = {};\\\\n  for (const table of tables) {\\\\n    for (const [kind, handler] of Object.entries(table)) {\\\\n      if (map[kind as WorkKind] !== undefined) {\\\\n        throw new TypeError(`work kind \\\\\\\"${kind}\\\\\\\" registered by more than one domain`);\\\\n      }\\\\n      map[kind as WorkKind] = handler;\\\\n    }\\\\n  }\\\\n  return map;\\\\n}\\\\n\\\\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\\\n  return {\\\\n    ok: false,\\\\n    error: {\\\\n      errorClass: \\\\\\\"state_corruption\\\\\\\",\\\\n      code: \\\\\\\"unknown_work_kind\\\\\\\",\\\\n      reason: `no handler registered for work kind \\\\\\\"${kind}\\\\\\\"`,\\\\n    },\\\\n  };\\\\n}\\\\n\\\\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\\\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\\\nexport function lookupWorkHandler(\\\\n  map: WorkHandlerMap,\\\\n  kind: string,\\\\n): OpResult<WorkHandler> {\\\\n  const handler = map[kind as WorkKind];\\\\n  if (handler === undefined) return unknownWorkKind(kind);\\\\n  return { ok: true, value: handler };\\\\n}\\\\n\\\\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\\\n// requeue land in Story 4.\\\\nexport interface WorkSurface {\\\\n  drain(\\\\n    ref: threadsDomain.ThreadRef,\\\\n    opts?: { maxItems?: number },\\\\n  ): Promise<OpResult<DrainReport>>;\\\\n}\\\\n\\\\nexport interface Lhc {\\\\n  threads: typeof threadsDomain;\\\\n  intakeStream: typeof intakeStreamDomain;\\\\n  messages: typeof messagesDomain;\\\\n  turns: typeof turnsDomain;\\\\n  config: ResolvedSdkConfig;\\\\n  scheduler: Scheduler;\\\\n  workHandlers: WorkHandlerMap;\\\\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\\\n  work: WorkSurface;\\\\n  // Resolves when the scheduler has no running or pending drain for the\\\\n  // thread (issue 3) — the awaitable for background mode, and a no-op\\\\n  // resolve in manual mode.\\\\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\\\n}\\\\n\\\\nfunction requirePositive(value: number, name: string): void {\\\\n  if (!Number.isFinite(value) || value <= 0) {\\\\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\\\n  }\\\\n}\\\\n\\\\nfunction requireNonNegative(value: number, name: string): void {\\\\n  if (!Number.isFinite(value) || value < 0) {\\\\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\\\n  }\\\\n}\\\\n\\\\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\\\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\\\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\\\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\\\\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\\\n// object is the same shape as the namespace, so the public surface type holds.\\\\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\\\n  const scoped: Record<string, unknown> = {};\\\\n  for (const key of Object.keys(surface)) {\\\\n    const value = (surface as Record<string, unknown>)[key];\\\\n    scoped[key] =\\\\n      typeof value === \\\\\\\"function\\\\\\\"\\\\n        ? (...args: unknown[]): unknown =>\\\\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\\\n        : value;\\\\n  }\\\\n  return scoped as T;\\\\n}\\\\n\\\\n// The only assembly path: provider, mode, clock, and policy enter here.\\\\n// Config mistakes are programmer errors at construction and throw; operating\\\\n// failures after construction return OpResults per the error contract.\\\\nexport function createSdk(config: SdkConfig): Lhc {\\\\n  if (config.mode !== \\\\\\\"background\\\\\\\" && config.mode !== \\\\\\\"manual\\\\\\\") {\\\\n    throw new TypeError(\\\\n      `createSdk config: mode must be \\\\\\\"background\\\\\\\" or \\\\\\\"manual\\\\\\\", got ${JSON.stringify(config.mode)}`,\\\\n    );\\\\n  }\\\\n  if (config.provider === null || typeof config.provider !== \\\\\\\"object\\\\\\\") {\\\\n    throw new TypeError(\\\\\\\"createSdk config: provider must implement DerivationProvider\\\\\\\");\\\\n  }\\\\n  for (const operation of PROVIDER_OPERATIONS) {\\\\n    if (typeof config.provider[operation] !== \\\\\\\"function\\\\\\\") {\\\\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\\\n    }\\\\n  }\\\\n\\\\n  const resolved: ResolvedSdkConfig = {\\\\n    provider: config.provider,\\\\n    mode: config.mode,\\\\n    clock: config.clock ?? (() => new Date()),\\\\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\\\n    lease: config.lease ?? { durationMs: 120000 },\\\\n    chunkPolicy:\\\\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\\\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\\\n    // sums and visibility budgets validated — throws naming the violation.\\\\n    view: resolveViewConfig(config.view),\\\\n  };\\\\n  requirePositive(resolved.retry.budget, \\\\\\\"retry.budget\\\\\\\");\\\\n  requireNonNegative(resolved.retry.backoffBaseMs, \\\\\\\"retry.backoffBaseMs\\\\\\\");\\\\n  requireNonNegative(resolved.retry.backoffCapMs, \\\\\\\"retry.backoffCapMs\\\\\\\");\\\\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\\\n    throw new TypeError(\\\\\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\\\\\");\\\\n  }\\\\n  requirePositive(resolved.lease.durationMs, \\\\\\\"lease.durationMs\\\\\\\");\\\\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\\\\\"chunkPolicy.targetProjectedTokens\\\\\\\");\\\\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\\\n    throw new TypeError(\\\\n      \\\\\\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\\\\\",\\\\n    );\\\\n  }\\\\n\\\\n  // Handler maps merge from per-domain contributions at construction (DD-6).\\\\n  // The tables are empty until Stories 2–3 land the real handlers; the\\\\n  // assembly mechanics are production code from day one.\\\\n  const workHandlers = assembleWorkHandlerMap([\\\\n    messagesDomain.workHandlers,\\\\n    turnsDomain.workHandlers,\\\\n  ]);\\\\n\\\\n  const drainDeps: DrainDeps = {\\\\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\\\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\\\n    config: resolved,\\\\n  };\\\\n  const scheduler = createScheduler(resolved.mode, drainDeps);\\\\n\\\\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\\\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\\\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\\\n  // background mode, or a no-op in manual mode — isolated from any other SDK\\\\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\\\\n  // the construction order, because its operations deliver to the no-op seam,\\\\n  // not to whatever a background SDK installed below.\\\\n  const seam: InstanceSeam =\\\\n    resolved.mode === \\\\\\\"background\\\\\\\"\\\\n      ? {\\\\n          poke: (threadId) => scheduler.poke(threadId),\\\\n          touch: (filePath, db) => scheduler.touch(filePath, db),\\\\n        }\\\\n      : { poke: () => {}, touch: () => {} };\\\\n\\\\n  // Background mode also installs the below-SDK default seam so a direct\\\\n  // domain call made with no SDK scope — a top-level mutation in the\\\\n  // single-background \\\\\\\"production path\\\\\\\" — still reaches the one installed\\\\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\\\\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\\\n  // leaves the default alone (pokes stay no-ops by contract).\\\\n  if (resolved.mode === \\\\\\\"background\\\\\\\") {\\\\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\\\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\\\n  }\\\\n\\\\n  const work: WorkSurface = {\\\\n    drain: (ref, opts) =>\\\\n      runWithInstanceSeam(seam, async () => {\\\\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\\\n        if (!resolvedRef.ok) return resolvedRef;\\\\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\\\n      }),\\\\n  };\\\\n\\\\n  return {\\\\n    threads: threadsDomain,\\\\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\\\\n    messages: scopeSurface(messagesDomain, seam),\\\\n    turns: scopeSurface(turnsDomain, seam),\\\\n    config: resolved,\\\\n    scheduler,\\\\n    workHandlers,\\\\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\\\n    work,\\\\n    drainSettled: async (ref) => {\\\\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\\\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\\\n      const threadId = peekThreadId(resolvedRef.value.filePath);\\\\n      if (threadId === null) return;\\\\n      return scheduler.drainSettled(threadId);\\\\n    },\\\\n  };\\\\n}\\\\n\\\",\\\"numLines\\\":352,\\\"startLine\\\":1,\\\"totalLines\\\":352}}}\\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/003-implementor.stdout.log:155:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01GU2x9xFgYJkFCCQhMpH2VR\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\texport type ErrorClass = \\\\\\\"caller_error\\\\\\\" | \\\\\\\"state_corruption\\\\\\\" | \\\\\\\"system_error\\\\\\\";\\\\n2\\\\t\\\\n3\\\\texport type ErrorCode =\\\\n4\\\\t  | \\\\\\\"path_exists\\\\\\\"\\\\n5\\\\t  | \\\\\\\"thread_not_found\\\\\\\"\\\\n6\\\\t  | \\\\\\\"invalid_thread_ref\\\\\\\" // empty/blank file path or otherwise unusable reference\\\\n7\\\\t  | \\\\\\\"invalid_event\\\\\\\"\\\\n8\\\\t  | \\\\\\\"empty_batch\\\\\\\"\\\\n9\\\\t  | \\\\\\\"empty_stdin\\\\\\\" // CLI adapter only, emitted before any SDK call\\\\n10\\\\t  | \\\\\\\"turn_state_corrupt\\\\\\\"\\\\n11\\\\t  | \\\\\\\"storage_failure\\\\\\\"\\\\n12\\\\t  // Epic 02 (tech design §Interfaces, issue 4):\\\\n13\\\\t  | \\\\\\\"turn_open\\\\\\\" // caller_error — mutation against an open turn\\\\n14\\\\t  | \\\\\\\"message_initiates_turn\\\\\\\" // caller_error — delete refused toward turns.delete\\\\n15\\\\t  | \\\\\\\"message_not_found\\\\\\\" // caller_error\\\\n16\\\\t  | \\\\\\\"turn_not_found\\\\\\\" // caller_error\\\\n17\\\\t  | \\\\\\\"unknown_work_kind\\\\\\\" // state_corruption — unregistered kind at dispatch\\\\n18\\\\t  | \\\\\\\"provider_not_configured\\\
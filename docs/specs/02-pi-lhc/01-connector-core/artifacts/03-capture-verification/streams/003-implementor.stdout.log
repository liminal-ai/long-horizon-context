{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014zgF8RCHa4trRfMEbEw3GY","type":"tool_result","content":"1\timport type { OpResult } from \"../../shared/errors.js\";\n2\timport type {\n3\t  WorkKind,\n4\t  WorkOwner,\n5\t  WorkSourceRef,\n6\t} from \"../../tech-utils/work-queue/index.js\";\n7\timport type { ThreadRef } from \"../threads/index.js\";\n8\timport { runListEvents, runMessageEvents } from \"./internal/pipeline.js\";\n9\t\n10\tinterface BaseEvent<K extends string, P> {\n11\t  eventKind: K;\n12\t  idempotencyKey: string;\n13\t  actor: string; // non-empty\n14\t  harness: string; // non-empty\n15\t  payload: P; // shape fixed by kind, closed\n16\t}\n17\t\n18\texport type MessageEventInput =\n19\t  | BaseEvent<\"user_prompt\", { text: string }>\n20\t  | BaseEvent<\"assistant_text\", { text: string }>\n21\t  | BaseEvent<\"assistant_thinking\", { text: string }>\n22\t  | BaseEvent<\"runtime_note\", { text: string }>\n23\t  | BaseEvent<\n24\t      \"tool_call\",\n25\t      { toolCallId: string; toolName: string; arguments: Record<string, unknown> }\n26\t    >\n27\t  | BaseEvent<\"tool_result\", { toolCallId: string; content: string; isError?: boolean }>\n28\t  | BaseEvent<\"turn_end\", Record<string, never>>;\n29\t\n30\t// Derived, not parallel-maintained: the kind list cannot drift from the union.\n31\texport type EventKind = MessageEventInput[\"eventKind\"];\n32\t\n33\texport interface BatchResult {\n34\t  events: Array<{\n35\t    idempotencyKey: string;\n36\t    outcome: \"recorded\" | \"skipped\";\n37\t    messageId?: string;\n38\t    skipReason?: \"duplicate_idempotency_key\";\n39\t  }>;\n40\t  turnTransitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n41\t  queuedWork: Array<{\n42\t    workItemId: string;\n43\t    owner: WorkOwner;\n44\t    kind: WorkKind;\n45\t    sourceRef: WorkSourceRef;\n46\t  }>;\n47\t  threadPosition: { lastEventOrder: number };\n48\t}\n49\t\n50\t// Read-back preserves the discrimination: intersecting the input union with\n51\t// server fields distributes over its members, so a narrowed eventKind narrows\n52\t// the payload on read exactly as it does on write.\n53\texport type EventRecord = MessageEventInput & {\n54\t  eventOrder: number;\n55\t  recordedAt: string;\n56\t};\n57\t\n58\texport async function messageEvents(\n59\t  thread: ThreadRef,\n60\t  events: readonly MessageEventInput[],\n61\t): Promise<OpResult<BatchResult>> {\n62\t  return runMessageEvents(thread, events);\n63\t}\n64\t\n65\texport async function listEvents(\n66\t  thread: ThreadRef,\n67\t): Promise<OpResult<EventRecord[]>> {\n68\t  return runListEvents(thread);\n69\t}\n70\t"}]},"parent_tool_use_id":null,"session_id":"8d6d1f63-412d-4ec0-a1d3-5b6b004b453c","uuid":"b16bb6ee-12e1-4057-9f00-68cefa483a9f","timestamp":"2026-06-14T10:48:40.665Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/index.ts","content":"import type { OpResult } from \"../../shared/errors.js\";\nimport type {\n  WorkKind,\n  WorkOwner,\n  WorkSourceRef,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { ThreadRef } from \"../threads/index.js\";\nimport { runListEvents, runMessageEvents } from \"./internal/pipeline.js\";\n\ninterface BaseEvent<K extends string, P> {\n  eventKind: K;\n  idempotencyKey: string;\n  actor: string; // non-empty\n  harness: string; // non-empty\n  payload: P; // shape fixed by kind, closed\n}\n\nexport type MessageEventInput =\n  | BaseEvent<\"user_prompt\", { text: string }>\n  | BaseEvent<\"assistant_text\", { text: string }>\n  | BaseEvent<\"assistant_thinking\", { text: string }>\n  | BaseEvent<\"runtime_note\", { text: string }>\n  | BaseEvent<\n      \"tool_call\",\n      { toolCallId: string; toolName: string; arguments: Record<string, unknown> }\n    >\n  | BaseEvent<\"tool_result\", { toolCallId: string; content: string; isError?: boolean }>\n  | BaseEvent<\"turn_end\", Record<string, never>>;\n\n// Derived, not parallel-maintained: the kind list cannot drift from the union.\nexport type EventKind = MessageEventInput[\"eventKind\"];\n\nexport interface BatchResult {\n  events: Array<{\n    idempotencyKey: string;\n    outcome: \"recorded\" | \"skipped\";\n    messageId?: string;\n    skipReason?: \"duplicate_idempotency_key\";\n  }>;\n  turnTransitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n  queuedWork: Array<{\n    workItemId: string;\n    owner: WorkOwner;\n    kind: WorkKind;\n    sourceRef: WorkSourceRef;\n  }>;\n  threadPosition: { lastEventOrder: number };\n}\n\n// Read-back preserves the discrimination: intersecting the input union with\n// server fields distributes over its members, so a narrowed eventKind narrows\n// the payload on read exactly as it does on write.\nexport type EventRecord = MessageEventInput & {\n  eventOrder: number;\n  recordedAt: string;\n};\n\nexport async function messageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n): Promise<OpResult<BatchResult>> {\n  return runMessageEvents(thread, events);\n}\n\nexport async function listEvents(\n  thread: ThreadRef,\n): Promise<OpResult<EventRecord[]>> {\n  return runListEvents(thread);\n}\n","numLines":70,"startLine":1,"totalLines":70}}}

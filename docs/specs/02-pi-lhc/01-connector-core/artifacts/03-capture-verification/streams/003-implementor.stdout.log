{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QtEAf4Usrt3srnnpbQPCzp","type":"tool_result","content":"1\timport type { MessageEventInput, ThreadRef } from \"lhc\";\n2\timport type { AgentMessage } from \"../pi/types.js\";\n3\t\n4\t// AC-6.1, AC-6.2. Replay a recorded corpus through the converter into a temp\n5\t// thread and compare read-back to the fixture expectation; the same corpus\n6\t// replayed twice yields identical read-back. Story 3.\n7\t\n8\t/** A loaded corpus: synthetic PI source messages (the stand-in until M0\n9\t *  delivers recordings) paired with the expected LHC intake events. Both\n10\t *  `verify/replay` and the corpus fixtures consume this shape. */\n11\texport interface Corpus {\n12\t  name: string;\n13\t  source: AgentMessage[];\n14\t  expected: MessageEventInput[];\n15\t}\n16\t\n17\texport interface ReplayResult {\n18\t  matches: boolean;\n19\t  diff?: string;\n20\t}\n21\t\n22\t/** Fail-closed until Story 3 — `matches:false`, never a faked pass (story\n23\t *  §Anti-Shim: no stub reports successful replay). */\n24\texport function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult> {\n25\t  return Promise.resolve({\n26\t    matches: false,\n27\t    diff: \"verify.replayCorpus is not implemented yet (Epic 1 foundation stub)\",\n28\t  });\n29\t}\n30\t"}]},"parent_tool_use_id":null,"session_id":"8d6d1f63-412d-4ec0-a1d3-5b6b004b453c","uuid":"73e21cc1-702e-467a-9b63-7edd1fc24eac","timestamp":"2026-06-14T10:45:17.880Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/verify/replay.ts","content":"import type { MessageEventInput, ThreadRef } from \"lhc\";\nimport type { AgentMessage } from \"../pi/types.js\";\n\n// AC-6.1, AC-6.2. Replay a recorded corpus through the converter into a temp\n// thread and compare read-back to the fixture expectation; the same corpus\n// replayed twice yields identical read-back. Story 3.\n\n/** A loaded corpus: synthetic PI source messages (the stand-in until M0\n *  delivers recordings) paired with the expected LHC intake events. Both\n *  `verify/replay` and the corpus fixtures consume this shape. */\nexport interface Corpus {\n  name: string;\n  source: AgentMessage[];\n  expected: MessageEventInput[];\n}\n\nexport interface ReplayResult {\n  matches: boolean;\n  diff?: string;\n}\n\n/** Fail-closed until Story 3 — `matches:false`, never a faked pass (story\n *  §Anti-Shim: no stub reports successful replay). */\nexport function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult> {\n  return Promise.resolve({\n    matches: false,\n    diff: \"verify.replayCorpus is not implemented yet (Epic 1 foundation stub)\",\n  });\n}\n","numLines":30,"startLine":1,"totalLines":30}}}

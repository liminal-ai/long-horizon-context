{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TYLGAQVKYXA7wNcqhCUx3z","type":"tool_result","content":"1\timport type { MessageEventInput } from \"lhc\";\n2\timport { eventKey } from \"./idempotency.js\";\n3\t\n4\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n5\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n6\t//\n7\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n8\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\n9\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n10\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n11\t// no-op on reattach, since a fresh accumulator has no open turn to close.\n12\t\n13\texport interface TurnAccumulatorCtx {\n14\t  piSessionId: string;\n15\t  actor?: string;\n16\t  harness?: string;\n17\t}\n18\t\n19\texport class TurnAccumulator {\n20\t  private readonly piSessionId: string;\n21\t  private readonly actor: string;\n22\t  private readonly harness: string;\n23\t  private open = false;\n24\t  private openTurnKey: string | null = null;\n25\t\n26\t  constructor(ctx: TurnAccumulatorCtx) {\n27\t    this.piSessionId = ctx.piSessionId;\n28\t    this.actor = ctx.actor ?? \"system\";\n29\t    this.harness = ctx.harness ?? \"pi\";\n30\t  }\n31\t\n32\t  /** Open the turn when this message's events include a `user_prompt`. A new\n33\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n34\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n35\t  onMessage(events: MessageEventInput[]): void {\n36\t    const opening = events.find((event) => event.eventKind === \"user_prompt\");\n37\t    if (opening !== undefined) {\n38\t      this.open = true;\n39\t      this.openTurnKey = opening.idempotencyKey;\n40\t    }\n41\t  }\n42\t\n43\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n44\t   *  transition the accumulator drives, and it happens once per agent run. */\n45\t  onAgentEnd(): MessageEventInput[] {\n46\t    if (!this.open) return [];\n47\t    this.open = false;\n48\t    const key = eventKey({\n49\t      piSessionId: this.piSessionId,\n50\t      blockIndex: 0,\n51\t      kind: \"turn_end\",\n52\t      role: \"system\",\n53\t      content: this.openTurnKey ?? \"turn:end\",\n54\t    });\n55\t    this.openTurnKey = null;\n56\t    return [\n57\t      {\n58\t        eventKind: \"turn_end\",\n59\t        idempotencyKey: key,\n60\t        actor: this.actor,\n61\t        harness: this.harness,\n62\t        payload: {},\n63\t      },\n64\t    ];\n65\t  }\n66\t\n67\t  hasOpenTurn(): boolean {\n68\t    return this.open;\n69\t  }\n70\t}\n71\t"}]},"parent_tool_use_id":null,"session_id":"8d6d1f63-412d-4ec0-a1d3-5b6b004b453c","uuid":"ececd16e-8715-4ada-a507-2fec88ce8605","timestamp":"2026-06-14T10:46:18.147Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/turn-accumulator.ts","content":"import type { MessageEventInput } from \"lhc\";\nimport { eventKey } from \"./idempotency.js\";\n\n// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n//\n// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n// The converter never feeds PI's per-step `turn_end` here, so it can never close\n// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n// no-op on reattach, since a fresh accumulator has no open turn to close.\n\nexport interface TurnAccumulatorCtx {\n  piSessionId: string;\n  actor?: string;\n  harness?: string;\n}\n\nexport class TurnAccumulator {\n  private readonly piSessionId: string;\n  private readonly actor: string;\n  private readonly harness: string;\n  private open = false;\n  private openTurnKey: string | null = null;\n\n  constructor(ctx: TurnAccumulatorCtx) {\n    this.piSessionId = ctx.piSessionId;\n    this.actor = ctx.actor ?? \"system\";\n    this.harness = ctx.harness ?? \"pi\";\n  }\n\n  /** Open the turn when this message's events include a `user_prompt`. A new\n   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n  onMessage(events: MessageEventInput[]): void {\n    const opening = events.find((event) => event.eventKind === \"user_prompt\");\n    if (opening !== undefined) {\n      this.open = true;\n      this.openTurnKey = opening.idempotencyKey;\n    }\n  }\n\n  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n   *  transition the accumulator drives, and it happens once per agent run. */\n  onAgentEnd(): MessageEventInput[] {\n    if (!this.open) return [];\n    this.open = false;\n    const key = eventKey({\n      piSessionId: this.piSessionId,\n      blockIndex: 0,\n      kind: \"turn_end\",\n      role: \"system\",\n      content: this.openTurnKey ?? \"turn:end\",\n    });\n    this.openTurnKey = null;\n    return [\n      {\n        eventKind: \"turn_end\",\n        idempotencyKey: key,\n        actor: this.actor,\n        harness: this.harness,\n        payload: {},\n      },\n    ];\n  }\n\n  hasOpenTurn(): boolean {\n    return this.open;\n  }\n}\n","numLines":71,"startLine":1,"totalLines":71}}}

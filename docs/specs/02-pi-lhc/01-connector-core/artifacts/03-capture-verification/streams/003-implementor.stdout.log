{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014eSfbHSvNtkCDkcYt5PubA","type":"tool_result","content":"1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n2\t// named lifecycle paired with the LHC intake events it should produce. Until M0\n3\t// delivers real recordings, the loaders build synthetic stand-ins; the\n4\t// machinery (load → validate shape → compare on replay in Story 3) is real and\n5\t// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n6\t// hardcodes a passing count (story §Anti-Shim Requirements).\n7\timport type { EventKind } from \"lhc\";\n8\timport type { Corpus } from \"../../src/verify/replay.js\";\n9\timport { ABORTED_DISPOSITION_TEXT } from \"../../src/capture/map-message.js\";\n10\timport {\n11\t  makeAssistantMessage,\n12\t  makeToolResult,\n13\t  makeUserMessage,\n14\t  validEvent,\n15\t} from \"./synthetic.js\";\n16\t\n17\tconst CALL_A = \"call_a|fc_1\";\n18\tconst CALL_B = \"call_b|fc_2\";\n19\t\n20\t/** Plain user/assistant text exchanges, no tools. */\n21\texport function loadChattyCorpus(): Corpus {\n22\t  return {\n23\t    name: \"chatty\",\n24\t    source: [\n25\t      makeUserMessage(\"what does this repo do?\"),\n26\t      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n27\t      makeUserMessage(\"and the connector?\"),\n28\t      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n29\t    ],\n30\t    expected: [\n31\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n32\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n33\t      validEvent(\"turn_end\"),\n34\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n35\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n36\t      validEvent(\"turn_end\"),\n37\t    ],\n38\t  };\n39\t}\n40\t\n41\t/** One turn with a single tool run: thinking → call → result → answer. */\n42\texport function loadToolHeavyCorpus(): Corpus {\n43\t  return {\n44\t    name: \"tool-heavy\",\n45\t    source: [\n46\t      makeUserMessage(\"read notes.txt\"),\n47\t      makeAssistantMessage({\n48\t        thinking: \"I should open the file\",\n49\t        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n50\t      }),\n51\t      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n52\t      makeAssistantMessage({ text: \"the file says hello\" }),\n53\t    ],\n54\t    expected: [\n55\t      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n56\t      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n57\t      validEvent(\"tool_call\", {\n58\t        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n59\t      }),\n60\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n61\t      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n62\t      validEvent(\"turn_end\"),\n63\t    ],\n64\t  };\n65\t}\n66\t\n67\t/** Two parallel tool calls whose results complete out of order; correlation is\n68\t *  by id, not arrival order (AC-2.3). */\n69\texport function loadParallelToolCorpus(): Corpus {\n70\t  return {\n71\t    name: \"parallel-tool\",\n72\t    source: [\n73\t      makeUserMessage(\"read both files\"),\n74\t      makeAssistantMessage({\n75\t        toolCalls: [\n76\t          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n77\t          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n78\t        ],\n79\t      }),\n80\t      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n81\t      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n82\t      makeAssistantMessage({ text: \"read both\" }),\n83\t    ],\n84\t    expected: [\n85\t      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n86\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n87\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n88\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n89\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n90\t      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n91\t      validEvent(\"turn_end\"),\n92\t    ],\n93\t  };\n94\t}\n95\t\n96\t/** A tool result flagged as an error, captured with its content (AC-2.4). */\n97\texport function loadErrorResultCorpus(): Corpus {\n98\t  return {\n99\t    name: \"error-result\",\n100\t    source: [\n101\t      makeUserMessage(\"read missing.txt\"),\n102\t      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n103\t      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n104\t      makeAssistantMessage({ text: \"that file does not exist\" }),\n105\t    ],\n106\t    expected: [\n107\t      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n108\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n109\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n110\t      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n111\t      validEvent(\"turn_end\"),\n112\t    ],\n113\t  };\n114\t}\n115\t\n116\t/** A graceful interrupt: partial assistant content, turn closed\n117\t *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\n118\texport function loadAbortedTurnCorpus(): Corpus {\n119\t  return {\n120\t    name: \"aborted-turn\",\n121\t    source: [\n122\t      makeUserMessage(\"write a long essay\"),\n123\t      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n124\t    ],\n125\t    expected: [\n126\t      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n127\t      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n128\t      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n129\t      // The aborted disposition rides a trailing runtime_note (the mapper carries\n130\t      // stopReason through; research §5b), then the turn closes complete-but-aborted.\n131\t      validEvent(\"runtime_note\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\n132\t      validEvent(\"turn_end\"),\n133\t    ],\n134\t  };\n135\t}\n136\t\n137\texport const CORPUS_LOADERS = {\n138\t  chatty: loadChattyCorpus,\n139\t  \"tool-heavy\": loadToolHeavyCorpus,\n140\t  \"parallel-tool\": loadParallelToolCorpus,\n141\t  \"error-result\": loadErrorResultCorpus,\n142\t  \"aborted-turn\": loadAbortedTurnCorpus,\n143\t} as const;\n144\t\n145\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n146\t\n147\texport function loadAllCorpora(): Corpus[] {\n148\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n149\t}\n150\t\n151\t/** A deliberately malformed sequence for the capture-failure test: an empty\n152\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n153\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n154\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n155\texport function makeTruncatedCorpus(): Corpus {\n156\t  return {\n157\t    name: \"truncated\",\n158\t    source: [makeUserMessage(\"\")],\n159\t    expected: [\n160\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n161\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n162\t    ],\n163\t  };\n164\t}\n165\t\n166\texport interface CorpusValidation {\n167\t  valid: boolean;\n168\t  problems: string[];\n169\t}\n170\t\n171\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n172\t  \"user_prompt\",\n173\t  \"assistant_text\",\n174\t  \"assistant_thinking\",\n175\t  \"runtime_note\",\n176\t  \"tool_call\",\n177\t  \"tool_result\",\n178\t  \"turn_end\",\n179\t]);\n180\t\n181\t/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n182\t *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n183\t *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n184\t *  found — `valid` is derived from that list, never a constant. */\n185\texport function validateCorpus(corpus: Corpus): CorpusValidation {\n186\t  const problems: string[] = [];\n187\t  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n188\t  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n189\t\n190\t  const seenToolCalls = new Set<string>();\n191\t  for (const [i, ev] of corpus.expected.entries()) {\n192\t    const at = `${corpus.name}[${i}]`;\n193\t    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n194\t    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n195\t    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n196\t    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n197\t\n198\t    switch (ev.eventKind) {\n199\t      case \"user_prompt\":\n200\t      case \"assistant_text\":\n201\t      case \"assistant_thinking\":\n202\t      case \"runtime_note\": {\n203\t        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n204\t          problems.push(`${at}: ${ev.eventKind} has empty text`);\n205\t        }\n206\t        break;\n207\t      }\n208\t      case \"tool_call\": {\n209\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n210\t          problems.push(`${at}: tool_call has empty toolCallId`);\n211\t        } else {\n212\t          seenToolCalls.add(ev.payload.toolCallId);\n213\t        }\n214\t        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n215\t          problems.push(`${at}: tool_call has empty toolName`);\n216\t        }\n217\t        break;\n218\t      }\n219\t      case \"tool_result\": {\n220\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n221\t          problems.push(`${at}: tool_result has empty toolCallId`);\n222\t        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n223\t          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n224\t        }\n225\t        if (typeof ev.payload.content !== \"string\") {\n226\t          problems.push(`${at}: tool_result has non-string content`);\n227\t        }\n228\t        break;\n229\t      }\n230\t      case \"turn_end\":\n231\t        break;\n232\t    }\n233\t  }\n234\t\n235\t  const last = corpus.expected[corpus.expected.length - 1];\n236\t  if (last !== undefined && last.eventKind !== \"turn_end\") {\n237\t    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n238\t  }\n239\t\n240\t  return { valid: problems.length === 0, problems };\n241\t}\n242\t"}]},"parent_tool_use_id":null,"session_id":"8d6d1f63-412d-4ec0-a1d3-5b6b004b453c","uuid":"adcc7ca1-0470-4f19-8177-e069972fd1ba","timestamp":"2026-06-14T10:45:18.445Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.ts","content":"// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n// named lifecycle paired with the LHC intake events it should produce. Until M0\n// delivers real recordings, the loaders build synthetic stand-ins; the\n// machinery (load → validate shape → compare on replay in Story 3) is real and\n// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n// hardcodes a passing count (story §Anti-Shim Requirements).\nimport type { EventKind } from \"lhc\";\nimport type { Corpus } from \"../../src/verify/replay.js\";\nimport { ABORTED_DISPOSITION_TEXT } from \"../../src/capture/map-message.js\";\nimport {\n  makeAssistantMessage,\n  makeToolResult,\n  makeUserMessage,\n  validEvent,\n} from \"./synthetic.js\";\n\nconst CALL_A = \"call_a|fc_1\";\nconst CALL_B = \"call_b|fc_2\";\n\n/** Plain user/assistant text exchanges, no tools. */\nexport function loadChattyCorpus(): Corpus {\n  return {\n    name: \"chatty\",\n    source: [\n      makeUserMessage(\"what does this repo do?\"),\n      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n      makeUserMessage(\"and the connector?\"),\n      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n      validEvent(\"turn_end\"),\n      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** One turn with a single tool run: thinking → call → result → answer. */\nexport function loadToolHeavyCorpus(): Corpus {\n  return {\n    name: \"tool-heavy\",\n    source: [\n      makeUserMessage(\"read notes.txt\"),\n      makeAssistantMessage({\n        thinking: \"I should open the file\",\n        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n      }),\n      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n      makeAssistantMessage({ text: \"the file says hello\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n      }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** Two parallel tool calls whose results complete out of order; correlation is\n *  by id, not arrival order (AC-2.3). */\nexport function loadParallelToolCorpus(): Corpus {\n  return {\n    name: \"parallel-tool\",\n    source: [\n      makeUserMessage(\"read both files\"),\n      makeAssistantMessage({\n        toolCalls: [\n          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n        ],\n      }),\n      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n      makeAssistantMessage({ text: \"read both\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** A tool result flagged as an error, captured with its content (AC-2.4). */\nexport function loadErrorResultCorpus(): Corpus {\n  return {\n    name: \"error-result\",\n    source: [\n      makeUserMessage(\"read missing.txt\"),\n      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n      makeAssistantMessage({ text: \"that file does not exist\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** A graceful interrupt: partial assistant content, turn closed\n *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\nexport function loadAbortedTurnCorpus(): Corpus {\n  return {\n    name: \"aborted-turn\",\n    source: [\n      makeUserMessage(\"write a long essay\"),\n      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n      // The aborted disposition rides a trailing runtime_note (the mapper carries\n      // stopReason through; research §5b), then the turn closes complete-but-aborted.\n      validEvent(\"runtime_note\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\nexport const CORPUS_LOADERS = {\n  chatty: loadChattyCorpus,\n  \"tool-heavy\": loadToolHeavyCorpus,\n  \"parallel-tool\": loadParallelToolCorpus,\n  \"error-result\": loadErrorResultCorpus,\n  \"aborted-turn\": loadAbortedTurnCorpus,\n} as const;\n\nexport type CorpusName = keyof typeof CORPUS_LOADERS;\n\nexport function loadAllCorpora(): Corpus[] {\n  return Object.values(CORPUS_LOADERS).map((load) => load());\n}\n\n/** A deliberately malformed sequence for the capture-failure test: an empty\n *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n *  proving the validator actually inspects shape rather than rubber-stamping. */\nexport function makeTruncatedCorpus(): Corpus {\n  return {\n    name: \"truncated\",\n    source: [makeUserMessage(\"\")],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n    ],\n  };\n}\n\nexport interface CorpusValidation {\n  valid: boolean;\n  problems: string[];\n}\n\nconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n  \"user_prompt\",\n  \"assistant_text\",\n  \"assistant_thinking\",\n  \"runtime_note\",\n  \"tool_call\",\n  \"tool_result\",\n  \"turn_end\",\n]);\n\n/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n *  found — `valid` is derived from that list, never a constant. */\nexport function validateCorpus(corpus: Corpus): CorpusValidation {\n  const problems: string[] = [];\n  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n\n  const seenToolCalls = new Set<string>();\n  for (const [i, ev] of corpus.expected.entries()) {\n    const at = `${corpus.name}[${i}]`;\n    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n\n    switch (ev.eventKind) {\n      case \"user_prompt\":\n      case \"assistant_text\":\n      case \"assistant_thinking\":\n      case \"runtime_note\": {\n        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n          problems.push(`${at}: ${ev.eventKind} has empty text`);\n        }\n        break;\n      }\n      case \"tool_call\": {\n        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n          problems.push(`${at}: tool_call has empty toolCallId`);\n        } else {\n          seenToolCalls.add(ev.payload.toolCallId);\n        }\n        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n          problems.push(`${at}: tool_call has empty toolName`);\n        }\n        break;\n      }\n      case \"tool_result\": {\n        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n          problems.push(`${at}: tool_result has empty toolCallId`);\n        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n        }\n        if (typeof ev.payload.content !== \"string\") {\n          problems.push(`${at}: tool_result has non-string content`);\n        }\n        break;\n      }\n      case \"turn_end\":\n        break;\n    }\n  }\n\n  const last = corpus.expected[corpus.expected.length - 1];\n  if (last !== undefined && last.eventKind !== \"turn_end\") {\n    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n  }\n\n  return { valid: problems.length === 0, problems };\n}\n","numLines":242,"startLine":1,"totalLines":242}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K6SsNeNwMjqhwz1yvNYsLT","type":"tool_result","content":"1\timport { describe, expect, it } from \"vitest\";\n2\timport {\n3\t  CORPUS_LOADERS,\n4\t  loadAllCorpora,\n5\t  makeTruncatedCorpus,\n6\t  validateCorpus,\n7\t} from \"./corpus.js\";\n8\t\n9\t// Architecture-risk test (tech design §Architecture-Risk Tests — Fixture\n10\t// Validity): Story 0 owns no AC, but every later capture/verification test\n11\t// depends on these corpora being trustworthy, so the loader's output is checked\n12\t// here rather than assumed.\n13\tdescribe(\"corpus fixtures\", () => {\n14\t  it(\"yields valid MessageEventInput shapes and lifecycle-coherent sequences for every named corpus\", () => {\n15\t    const corpora = loadAllCorpora();\n16\t    expect(corpora).toHaveLength(Object.keys(CORPUS_LOADERS).length);\n17\t\n18\t    for (const corpus of corpora) {\n19\t      const result = validateCorpus(corpus);\n20\t      // name the defects if any — a bare boolean would hide which corpus broke\n21\t      expect(result.problems).toEqual([]);\n22\t      expect(result.valid).toBe(true);\n23\t      // a real recorded sequence, not an empty stub, and a closed turn\n24\t      expect(corpus.expected.length).toBeGreaterThan(0);\n25\t      expect(corpus.expected.at(-1)?.eventKind).toBe(\"turn_end\");\n26\t    }\n27\t  });\n28\t\n29\t  it(\"produces an intentionally malformed shape from the named invalid builder that the validator rejects\", () => {\n30\t    const result = validateCorpus(makeTruncatedCorpus());\n31\t    expect(result.valid).toBe(false);\n32\t    // the validator inspects shape: it names the specific defects, not a generic fail\n33\t    expect(result.problems.some((p) => p.includes(\"empty text\"))).toBe(true);\n34\t    expect(result.problems.some((p) => p.includes(\"no preceding tool_call\"))).toBe(true);\n35\t    expect(result.problems.some((p) => p.includes(\"does not close with turn_end\"))).toBe(true);\n36\t  });\n37\t});\n38\t"}]},"parent_tool_use_id":null,"session_id":"8d6d1f63-412d-4ec0-a1d3-5b6b004b453c","uuid":"fc08901a-1c7e-4677-970d-871075d563f8","timestamp":"2026-06-14T10:45:19.363Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.test.ts","content":"import { describe, expect, it } from \"vitest\";\nimport {\n  CORPUS_LOADERS,\n  loadAllCorpora,\n  makeTruncatedCorpus,\n  validateCorpus,\n} from \"./corpus.js\";\n\n// Architecture-risk test (tech design §Architecture-Risk Tests — Fixture\n// Validity): Story 0 owns no AC, but every later capture/verification test\n// depends on these corpora being trustworthy, so the loader's output is checked\n// here rather than assumed.\ndescribe(\"corpus fixtures\", () => {\n  it(\"yields valid MessageEventInput shapes and lifecycle-coherent sequences for every named corpus\", () => {\n    const corpora = loadAllCorpora();\n    expect(corpora).toHaveLength(Object.keys(CORPUS_LOADERS).length);\n\n    for (const corpus of corpora) {\n      const result = validateCorpus(corpus);\n      // name the defects if any — a bare boolean would hide which corpus broke\n      expect(result.problems).toEqual([]);\n      expect(result.valid).toBe(true);\n      // a real recorded sequence, not an empty stub, and a closed turn\n      expect(corpus.expected.length).toBeGreaterThan(0);\n      expect(corpus.expected.at(-1)?.eventKind).toBe(\"turn_end\");\n    }\n  });\n\n  it(\"produces an intentionally malformed shape from the named invalid builder that the validator rejects\", () => {\n    const result = validateCorpus(makeTruncatedCorpus());\n    expect(result.valid).toBe(false);\n    // the validator inspects shape: it names the specific defects, not a generic fail\n    expect(result.problems.some((p) => p.includes(\"empty text\"))).toBe(true);\n    expect(result.problems.some((p) => p.includes(\"no preceding tool_call\"))).toBe(true);\n    expect(result.problems.some((p) => p.includes(\"does not close with turn_end\"))).toBe(true);\n  });\n});\n","numLines":38,"startLine":1,"totalLines":38}}}

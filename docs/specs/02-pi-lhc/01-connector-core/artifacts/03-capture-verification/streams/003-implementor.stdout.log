{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WZzU88oHtqq7voJoMU12D2","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  DerivationProvider,\n13\t  MessageEventInput,\n14\t  OpResult,\n15\t  ProviderResult,\n16\t  SdkConfig,\n17\t  ThreadRef,\n18\t} from \"lhc\";\n19\timport type {\n20\t  ExtensionAPI,\n21\t  ExtensionContext,\n22\t  PiHookHandler,\n23\t  PiHookName,\n24\t} from \"./pi/types.js\";\n25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n26\timport { createSessionState } from \"./lifecycle/state.js\";\n27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n28\timport {\n29\t  parseLaunchFlags,\n30\t  resolveReloadThread,\n31\t  resolveThread,\n32\t  type LaunchFlags,\n33\t  type ResolveDeps,\n34\t} from \"./lifecycle/thread-resolution.js\";\n35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n36\timport { capture, captureGap } from \"./capture/converter.js\";\n37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n40\timport type { LhcInstance } from \"./shared/instance.js\";\n41\t\n42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n43\texport type { LhcInstance } from \"./shared/instance.js\";\n44\t\n45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n47\t *  registers no handler for it (story Scope Out). */\n48\texport const EPIC_1_HOOKS = [\n49\t  \"session_start\",\n50\t  \"message_end\",\n51\t  \"turn_end\",\n52\t  \"agent_end\",\n53\t  \"model_select\",\n54\t  \"thinking_level_select\",\n55\t  \"session_before_fork\",\n56\t  \"session_before_switch\",\n57\t  \"session_shutdown\",\n58\t] as const satisfies readonly PiHookName[];\n59\t\n60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n61\t\n62\t/** What the connector needs from the host to run a session. Every dependency\n63\t *  has a working production default; the overrides exist for test isolation\n64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n65\t *  in the PI-auth-backed inference config.\n66\t *\n67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n68\t *  default is the observe-only config below (a real, construction-valid SDK);\n69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n70\texport interface ConnectorDeps {\n71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n72\t  registryPath?: string;\n73\t  newThreadFilePath?: () => string;\n74\t  parseLaunch?: () => LaunchFlags;\n75\t  selectThread?: (\n76\t    choices: readonly ThreadChoice[],\n77\t    ctx: ExtensionContext,\n78\t  ) => Promise<string | null>;\n79\t}\n80\t\n81\t/** Everything the connector retains across hooks as PLAIN data — by\n82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n84\t *  deliberately not part of the snapshot. */\n85\texport interface ConnectorSnapshot {\n86\t  state: SessionState | null;\n87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n88\t}\n89\t\n90\texport interface Connector {\n91\t  /** Register the observe-only hook rail on the PI extension API. */\n92\t  register(pi: ExtensionAPI): void;\n93\t  /** The plain-data state retained across hooks. `null` until a session\n94\t   *  resolves a thread; never holds a PI ctx. */\n95\t  getState(): SessionState | null;\n96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n98\t  getInstance(): LhcInstance | null;\n99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n100\t  snapshot(): ConnectorSnapshot;\n101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n102\t   *  synthetic ctx/events without a live PI. */\n103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n104\t}\n105\t\n106\t/** The connector's live capture state for one session: the open-turn\n107\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n108\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n109\t *  per session, never part of the plain-data snapshot and never a PI object. */\n110\tinterface CaptureSession {\n111\t  piSessionId: string;\n112\t  accumulator: TurnAccumulator;\n113\t  sourceSeq: number;\n114\t}\n115\t\n116\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n117\t *  identity, which survives reload/replay (the same thread re-resolves to the\n118\t *  same id). */\n119\tfunction sessionIdOf(ref: ThreadRef): string {\n120\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n121\t}\n122\t\n123\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n124\t\n125\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n126\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n127\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n128\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n129\t *  derivation work is ever queued and this provider is never invoked — it exists\n130\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n131\t *\n132\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n133\t *  documents as \"selectable only by explicit name — never a production default\"\n134\t *  (it would mark fake derived text into the thread). Failing closed preserves\n135\t *  the observe-only guarantee even if a future change queued work before Stories\n136\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n137\t *  assignments), which is what a real *completing* inference requires (the\n138\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n139\tfunction observeOnlyProvider(): DerivationProvider {\n140\t  const notConfigured = (): Promise<ProviderResult> =>\n141\t    Promise.resolve({\n142\t      ok: false,\n143\t      retryable: false,\n144\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n145\t    });\n146\t  return {\n147\t    smoothPrompt: notConfigured,\n148\t    summarizeToolCall: notConfigured,\n149\t    summarizeToolResult: notConfigured,\n150\t    composeTurnRendering: notConfigured,\n151\t    projectLowerBand: notConfigured,\n152\t    summarizeChunkDetailed: notConfigured,\n153\t    summarizeChunkBrief: notConfigured,\n154\t  };\n155\t}\n156\t\n157\t/** The production observe-only SDK config: a real, construction-valid instance\n158\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n159\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n160\t *  config. */\n161\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n162\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n163\t}\n164\t\n165\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n166\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n167\t *  show. */\n168\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n169\t  const lines = choices.map((choice, i) => {\n170\t    const title = choice.title ?? \"(untitled)\";\n171\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n172\t  });\n173\t  return [\n174\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n175\t    ...lines,\n176\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n177\t  ].join(\"\\n\");\n178\t}\n179\t\n180\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n181\t *  interactive input/selection surface (wiring research), so the production\n182\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n183\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n184\t *  most recently created thread as the best available explicit default. The\n185\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n186\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n187\t *  A true interactive picker awaits a PI input surface; until then resuming a\n188\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n189\t *  precise spec deviation. */\n190\tfunction defaultSelectThread(\n191\t  choices: readonly ThreadChoice[],\n192\t  ctx: ExtensionContext,\n193\t): Promise<string | null> {\n194\t  const mostRecent = choices.at(-1);\n195\t  if (mostRecent === undefined) return Promise.resolve(null);\n196\t  if (ctx.hasUI) {\n197\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n198\t  }\n199\t  return Promise.resolve(mostRecent.threadId);\n200\t}\n201\t\n202\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n203\t *  generated by the registry at creation, so the file name is just a unique\n204\t *  handle; the directory is ensured up front (DatabaseSync does not create\n205\t *  parents). */\n206\tfunction defaultNewThreadFilePath(): string {\n207\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n208\t  mkdirSync(dir, { recursive: true });\n209\t  return join(dir, `${randomUUID()}.sqlite`);\n210\t}\n211\t\n212\t/** Build a connector instance. Its mutable state lives in this closure; the\n213\t *  registered handlers capture it, so the instance stays live for the session\n214\t *  even when `activate` discards the returned object. The connector holds NO\n215\t *  module-level or durable state of its own — reload reconstructs the thread from\n216\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n217\t *  closure reattaches correctly (AC-1.5). */\n218\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n219\t  // The connector's retained state. `state` is plain data (the durable thread\n220\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n221\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n222\t  // none survives the connector — reload re-resolves from the registry.\n223\t  let state: SessionState | null = null;\n224\t  let instance: LhcInstance | null = null;\n225\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n226\t  let captureSession: CaptureSession | null = null;\n227\t\n228\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n229\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n230\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n231\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n232\t\n233\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n234\t    return { code, message, recordedGap: false };\n235\t  }\n236\t\n237\t  // The registry/file deps every resolver path shares. `registryPath` is set\n238\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n239\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n240\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n241\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n242\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n243\t    return resolveDeps;\n244\t  }\n245\t\n246\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n247\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n248\t  // no-flag creates).\n249\t  async function resolveForLaunch(\n250\t    launch: LaunchFlags,\n251\t    ctx: ExtensionContext,\n252\t  ): Promise<OpResult<ThreadRef | null>> {\n253\t    if (launch.resume === true) {\n254\t      const pickerDeps: {\n255\t        registryPath?: string;\n256\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n257\t      } = { select: (choices) => selectThread(choices, ctx) };\n258\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n259\t      return pickThread(ctx.cwd, pickerDeps);\n260\t    }\n261\t    return resolveThread(launch, buildResolveDeps(ctx));\n262\t  }\n263\t\n264\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n265\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n266\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n267\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n268\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n269\t  async function resolveReloadFor(\n270\t    launch: LaunchFlags,\n271\t    ctx: ExtensionContext,\n272\t  ): Promise<OpResult<ThreadRef | null>> {\n273\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n274\t  }\n275\t\n276\t  // session_start: resolve the recording thread and construct one background\n277\t  // instance against it. Config is gated first so a session with no usable\n278\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n279\t  // thread is re-resolved from the durable registry (reattach, never create);\n280\t  // every other reason runs the normal launch resolution.\n281\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n282\t    const config = buildSdkConfig(ctx);\n283\t    if (!config.ok) {\n284\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n285\t      return;\n286\t    }\n287\t    const launch = parseLaunch();\n288\t    const isReload = event.reason === \"reload\";\n289\t    const resolved = isReload\n290\t      ? await resolveReloadFor(launch, ctx)\n291\t      : await resolveForLaunch(launch, ctx);\n292\t    if (!resolved.ok) {\n293\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n294\t      return;\n295\t    }\n296\t    if (resolved.value === null) {\n297\t      lastDiagnostic = isReload\n298\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n299\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n300\t      return;\n301\t    }\n302\t    const built = await initInstance(resolved.value, config.value);\n303\t    if (!built.ok) {\n304\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n305\t      return;\n306\t    }\n307\t    instance = built.value;\n308\t    state = createSessionState(resolved.value);\n309\t    const piSessionId = sessionIdOf(resolved.value);\n310\t    captureSession = {\n311\t      piSessionId,\n312\t      accumulator: new TurnAccumulator({ piSessionId }),\n313\t      sourceSeq: 0,\n314\t    };\n315\t  };\n316\t\n317\t  // Dispose with flush before any session swap (session_before_switch fires\n318\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n319\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n320\t  // re-resolves its thread from the durable registry on the next session_start.\n321\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n322\t    const result = await disposeInstance(instance);\n323\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n324\t    instance = null;\n325\t    captureSession = null;\n326\t  };\n327\t\n328\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n329\t  // converter already recorded a durable gap for a writable-thread malformed\n330\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n331\t  // surfaces as an extension health signal with no gap. Neither path throws.\n332\t  function recordCaptureOutcome(\n333\t    result: OpResult<BatchResult>,\n334\t    events: readonly MessageEventInput[],\n335\t  ): void {\n336\t    if (result.ok) return;\n337\t    const recordedGap = result.error.code === \"invalid_event\";\n338\t    const failure: CaptureFailureDiagnostic = {\n339\t      code: result.error.code,\n340\t      message: result.error.reason,\n341\t      recordedGap,\n342\t    };\n343\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n344\t    lastDiagnostic = failure;\n345\t    if (state !== null) state.health.lastCaptureFailure = failure;\n346\t  }\n347\t\n348\t  function nextSourceSeq(session: CaptureSession): number {\n349\t    const sourceSeq = session.sourceSeq;\n350\t    session.sourceSeq += 1;\n351\t    return sourceSeq;\n352\t  }\n353\t\n354\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n355\t    // Last-resort id-less discriminator. PI position wins when present; the\n356\t    // connector ordinal is used only when PI gives no event identity at all.\n357\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n358\t    // order yields the same ordinal, which is the best identity available.\n359\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n360\t  }\n361\t\n362\t  async function recordMappingFailure(\n363\t    hook: string,\n364\t    position: number | undefined,\n365\t    sourceSeq: number,\n366\t    cause: unknown,\n367\t  ): Promise<void> {\n368\t    if (instance === null) return;\n369\t    const message = cause instanceof Error ? cause.message : String(cause);\n370\t    const result = await captureGap(\n371\t      fallbackIdFor(hook, position, sourceSeq),\n372\t      `${hook}: ${message}`,\n373\t      instance,\n374\t    );\n375\t    if (!result.ok) {\n376\t      recordCaptureOutcome(result, []);\n377\t      return;\n378\t    }\n379\t    const failure: CaptureFailureDiagnostic = {\n380\t      code: \"invalid_event\",\n381\t      message: `${hook}: ${message}`,\n382\t      recordedGap: true,\n383\t    };\n384\t    lastDiagnostic = failure;\n385\t    if (state !== null) state.health.lastCaptureFailure = failure;\n386\t  }\n387\t\n388\t  // message_end: map the finalized PI message to ordered LHC events, track the\n389\t  // open turn, and flush through the converter (AC-2.1).\n390\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n391\t    if (instance === null || captureSession === null) return;\n392\t    const sourceSeq = nextSourceSeq(captureSession);\n393\t    const mapCtx: MapCtx =\n394\t      event.entryId !== undefined && event.entryId !== \"\"\n395\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n396\t        : {\n397\t            piSessionId: captureSession.piSessionId,\n398\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n399\t          };\n400\t    let events: MessageEventInput[];\n401\t    try {\n402\t      events = mapMessage(event.message, mapCtx);\n403\t    } catch (cause) {\n404\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n405\t      return;\n406\t    }\n407\t    captureSession.accumulator.onMessage(events);\n408\t    if (events.length === 0) return;\n409\t    recordCaptureOutcome(await capture(events, instance), events);\n410\t  };\n411\t\n412\t  // model_select / thinking_level_select fire only in-stream — capture each as\n413\t  // an ordered runtime_note the moment it fires (AC-2.8).\n414\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n415\t    if (instance === null || captureSession === null) return;\n416\t    const sourceSeq = nextSourceSeq(captureSession);\n417\t    const mapCtx: MapCtx = {\n418\t      piSessionId: captureSession.piSessionId,\n419\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n420\t    };\n421\t    const note = mapModelSelect(event, mapCtx);\n422\t    recordCaptureOutcome(await capture([note], instance), [note]);\n423\t  };\n424\t\n425\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n426\t    if (instance === null || captureSession === null) return;\n427\t    const sourceSeq = nextSourceSeq(captureSession);\n428\t    const mapCtx: MapCtx = {\n429\t      piSessionId: captureSession.piSessionId,\n430\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n431\t    };\n432\t    const note = mapThinkingLevelSelect(event, mapCtx);\n433\t    recordCaptureOutcome(await capture([note], instance), [note]);\n434\t  };\n435\t\n436\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n437\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n438\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n439\t    if (instance === null || captureSession === null) return;\n440\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n441\t    if (turnEnd.length === 0) return;\n442\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n443\t  };\n444\t\n445\t  // Contain every handler: an observe-only hook must never throw back into PI\n446\t  // (a thrown hook breaks the user's session). A caught error becomes a\n447\t  // plain-data diagnostic; it is never rethrown.\n448\t  const guard = (\n449\t    name: Epic1Hook,\n450\t    body: PiHookHandler<Epic1Hook>,\n451\t  ): PiHookHandler<Epic1Hook> => {\n452\t    return async (ctx, event): Promise<void> => {\n453\t      try {\n454\t        await body(ctx, event);\n455\t      } catch (err) {\n456\t        lastDiagnostic = {\n457\t          code: \"hook_handler_error\",\n458\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n459\t          recordedGap: false,\n460\t        };\n461\t      }\n462\t    };\n463\t  };\n464\t\n465\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n466\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n467\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n468\t  // FRESH ctx and retains none of it.\n469\t  const noop: PiHookHandler<Epic1Hook> = () => {\n470\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n471\t  };\n472\t\n473\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n474\t  // are live; PI per-step turn_end and fork remain no-ops.\n475\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n476\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n477\t    session_before_switch: onDispose,\n478\t    session_shutdown: onDispose,\n479\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n480\t    turn_end: noop,\n481\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n482\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n483\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n484\t    session_before_fork: noop,\n485\t  };\n486\t\n487\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n488\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n489\t\n490\t  return {\n491\t    handlers,\n492\t    register(pi: ExtensionAPI): void {\n493\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n494\t    },\n495\t    getState(): SessionState | null {\n496\t      return state;\n497\t    },\n498\t    getInstance(): LhcInstance | null {\n499\t      return instance;\n500\t    },\n501\t    snapshot(): ConnectorSnapshot {\n502\t      return { state, lastDiagnostic };\n503\t    },\n504\t  };\n505\t}\n506\t\n507\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n508\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n509\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n510\t *  observe-only SDK config, and the `--resume` selector that presents the\n511\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n512\t *  resolves/creates and initializes for real. On `/reload` the connector\n513\t *  re-resolves the same thread from the durable registry (it keeps no\n514\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n515\t *  config. */\n516\texport function activate(pi: ExtensionAPI): void {\n517\t  createConnector().register(pi);\n518\t}\n519\t\n520\texport default activate;\n521\t"}]},"parent_tool_use_id":null,"session_id":"8d6d1f63-412d-4ec0-a1d3-5b6b004b453c","uuid":"60dc713c-3a6b-45a3-a8da-ec84606817d2","timestamp":"2026-06-14T10:45:45.550Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  DerivationProvider,\n  MessageEventInput,\n  OpResult,\n  ProviderResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\n *  whose every operation fails closed (non-retryable) instead of fabricating a\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n *  derivation work is ever queued and this provider is never invoked — it exists\n *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n *\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\n *  documents as \"selectable only by explicit name — never a production default\"\n *  (it would mark fake derived text into the thread). Failing closed preserves\n *  the observe-only guarantee even if a future change queued work before Stories\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n *  assignments), which is what a real *completing* inference requires (the\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\nfunction observeOnlyProvider(): DerivationProvider {\n  const notConfigured = (): Promise<ProviderResult> =>\n    Promise.resolve({\n      ok: false,\n      retryable: false,\n      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n    });\n  return {\n    smoothPrompt: notConfigured,\n    summarizeToolCall: notConfigured,\n    summarizeToolResult: notConfigured,\n    composeTurnRendering: notConfigured,\n    projectLowerBand: notConfigured,\n    summarizeChunkDetailed: notConfigured,\n    summarizeChunkBrief: notConfigured,\n  };\n}\n\n/** The production observe-only SDK config: a real, construction-valid instance\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n *  config. */\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n *  most recently created thread as the best available explicit default. The\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n *  takes the `select` seam); tests drive an explicit operator choice through it.\n *  A true interactive picker awaits a PI input surface; until then resuming a\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n *  precise spec deviation. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  if (mostRecent === undefined) return Promise.resolve(null);\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n  }\n  return Promise.resolve(mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution.\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n    const launch = parseLaunch();\n    const isReload = event.reason === \"reload\";\n    const resolved = isReload\n      ? await resolveReloadFor(launch, ctx)\n      : await resolveForLaunch(launch, ctx);\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n    const built = await initInstance(resolved.value, config.value);\n    if (!built.ok) {\n      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n      return;\n    }\n    instance = built.value;\n    state = createSessionState(resolved.value);\n    const piSessionId = sessionIdOf(resolved.value);\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId }),\n      sourceSeq: 0,\n    };\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  function nextSourceSeq(session: CaptureSession): number {\n    const sourceSeq = session.sourceSeq;\n    session.sourceSeq += 1;\n    return sourceSeq;\n  }\n\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n    // Last-resort id-less discriminator. PI position wins when present; the\n    // connector ordinal is used only when PI gives no event identity at all.\n    // For id-less + position-less reload replay, PI's deterministic redelivery\n    // order yields the same ordinal, which is the best identity available.\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n  }\n\n  async function recordMappingFailure(\n    hook: string,\n    position: number | undefined,\n    sourceSeq: number,\n    cause: unknown,\n  ): Promise<void> {\n    if (instance === null) return;\n    const message = cause instanceof Error ? cause.message : String(cause);\n    const result = await captureGap(\n      fallbackIdFor(hook, position, sourceSeq),\n      `${hook}: ${message}`,\n      instance,\n    );\n    if (!result.ok) {\n      recordCaptureOutcome(result, []);\n      return;\n    }\n    const failure: CaptureFailureDiagnostic = {\n      code: \"invalid_event\",\n      message: `${hook}: ${message}`,\n      recordedGap: true,\n    };\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  // message_end: map the finalized PI message to ordered LHC events, track the\n  // open turn, and flush through the converter (AC-2.1).\n  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx =\n      event.entryId !== undefined && event.entryId !== \"\"\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n        : {\n            piSessionId: captureSession.piSessionId,\n            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n          };\n    let events: MessageEventInput[];\n    try {\n      events = mapMessage(event.message, mapCtx);\n    } catch (cause) {\n      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n      return;\n    }\n    captureSession.accumulator.onMessage(events);\n    if (events.length === 0) return;\n    recordCaptureOutcome(await capture(events, instance), events);\n  };\n\n  // model_select / thinking_level_select fire only in-stream — capture each as\n  // an ordered runtime_note the moment it fires (AC-2.8).\n  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n    };\n    const note = mapModelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n    };\n    const note = mapThinkingLevelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n    if (instance === null || captureSession === null) return;\n    const turnEnd = captureSession.accumulator.onAgentEnd();\n    if (turnEnd.length === 0) return;\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n  // FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n  };\n\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n  // are live; PI per-step turn_end and fork remain no-ops.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n    turn_end: noop,\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n    session_before_fork: noop,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from the durable registry (it keeps no\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n *  config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":521,"startLine":1,"totalLines":521}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1b689637b34843159a477a0c","type":"tool_result","content":"1\timport { createHash } from \"node:crypto\";\n2\timport type { EventKind } from \"lhc\";\n3\t\n4\t// AC-2.6: a stable per-event key so re-delivery dedups and crash-replay is\n5\t// safe. Pure, deterministic — identical across re-delivery of the same logical\n6\t// event, distinct across different events. Construction precedence (from the\n7\t// POC mapper, carried forward): PI entry id, else provider responseId /\n8\t// toolCallId, else a content fingerprint as last resort. `blockIndex` and\n9\t// `kind` ride every tier so one message's fan-out (thinking → text →\n10\t// tool_call×N) stays distinct under a single shared id.\n11\t\n12\texport interface EventKeyInput {\n13\t  piSessionId: string;\n14\t  // Optionals admit explicit `undefined` so a caller can thread a\n15\t  // possibly-absent id through directly under exactOptionalPropertyTypes.\n16\t  entryId?: string | undefined;\n17\t  responseId?: string | undefined;\n18\t  toolCallId?: string | undefined;\n19\t  blockIndex: number;\n20\t  kind: EventKind;\n21\t  role?: string | undefined;\n22\t  fallbackId?: string | undefined;\n23\t  content?: string | undefined;\n24\t}\n25\t\n26\t// Join fingerprint parts with the ASCII unit separator — a delimiter that\n27\t// effectively never occurs in PI message text, so two different part lists\n28\t// cannot collide into the same joined string.\n29\tconst SEP = \"\\u001f\";\n30\t\n31\t/** A short, stable content fingerprint — the last-resort key tier when an\n32\t *  event carries no PI/provider id. sha256 truncated: collision-resistant\n33\t *  enough for dedup, short enough to keep keys readable. */\n34\texport function fingerprint(...parts: string[]): string {\n35\t  return createHash(\"sha256\").update(parts.join(SEP)).digest(\"hex\").slice(0, 24);\n36\t}\n37\t\n38\texport function eventKey(input: EventKeyInput): string {\n39\t  const { piSessionId, entryId, responseId, toolCallId, blockIndex, kind } = input;\n40\t  // Tier 1 — PI entry id: the most stable identity, present on real\n41\t  // finalized message; disambiguated by block + kind for the fan-out.\n42\t  if (entryId !== undefined && entryId !== \"\") {\n43\t    return `pi:${piSessionId}:${entryId}:${blockIndex}:${kind}`;\n44\t  }\n45\t  // Tier 2 — tool-call id: stable across re-delivery and independent of arrival\n46\t  // order; kind separates the call from its result under the same id.\n47\t  if (toolCallId !== undefined && toolCallId !== \"\") {\n48\t    return `pi:${piSessionId}:tool:${toolCallId}:${kind}`;\n49\t  }\n50\t  // Tier 3 — provider response id: stable per assistant response.\n51\t  if (responseId !== undefined && responseId !== \"\") {\n52\t    return `pi:${piSessionId}:resp:${responseId}:${blockIndex}:${kind}`;\n53\t  }\n54\t  // Tier 4 — content fingerprint: last resort for an event with no id at all.\n55\t  // Include any caller-supplied stable discriminator; content alone is never\n56\t  // enough to distinguish two separate same-text events.\n57\t  const role = input.role ?? \"\";\n58\t  const fallbackId = input.fallbackId ?? \"no-stable-id\";\n59\t  const fp = fingerprint(fallbackId, role, kind, input.content ?? \"\");\n60\t  return `pi:${piSessionId}:fp:${fallbackId}:${blockIndex}:${role}:${kind}:${fp}`;\n61\t}\n62\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"35d558fa-ece5-429e-a526-564b738c0375","timestamp":"2026-06-14T11:43:25.993Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/idempotency.ts","content":"import { createHash } from \"node:crypto\";\nimport type { EventKind } from \"lhc\";\n\n// AC-2.6: a stable per-event key so re-delivery dedups and crash-replay is\n// safe. Pure, deterministic — identical across re-delivery of the same logical\n// event, distinct across different events. Construction precedence (from the\n// POC mapper, carried forward): PI entry id, else provider responseId /\n// toolCallId, else a content fingerprint as last resort. `blockIndex` and\n// `kind` ride every tier so one message's fan-out (thinking → text →\n// tool_call×N) stays distinct under a single shared id.\n\nexport interface EventKeyInput {\n  piSessionId: string;\n  // Optionals admit explicit `undefined` so a caller can thread a\n  // possibly-absent id through directly under exactOptionalPropertyTypes.\n  entryId?: string | undefined;\n  responseId?: string | undefined;\n  toolCallId?: string | undefined;\n  blockIndex: number;\n  kind: EventKind;\n  role?: string | undefined;\n  fallbackId?: string | undefined;\n  content?: string | undefined;\n}\n\n// Join fingerprint parts with the ASCII unit separator — a delimiter that\n// effectively never occurs in PI message text, so two different part lists\n// cannot collide into the same joined string.\nconst SEP = \"\\u001f\";\n\n/** A short, stable content fingerprint — the last-resort key tier when an\n *  event carries no PI/provider id. sha256 truncated: collision-resistant\n *  enough for dedup, short enough to keep keys readable. */\nexport function fingerprint(...parts: string[]): string {\n  return createHash(\"sha256\").update(parts.join(SEP)).digest(\"hex\").slice(0, 24);\n}\n\nexport function eventKey(input: EventKeyInput): string {\n  const { piSessionId, entryId, responseId, toolCallId, blockIndex, kind } = input;\n  // Tier 1 — PI entry id: the most stable identity, present on real\n  // finalized message; disambiguated by block + kind for the fan-out.\n  if (entryId !== undefined && entryId !== \"\") {\n    return `pi:${piSessionId}:${entryId}:${blockIndex}:${kind}`;\n  }\n  // Tier 2 — tool-call id: stable across re-delivery and independent of arrival\n  // order; kind separates the call from its result under the same id.\n  if (toolCallId !== undefined && toolCallId !== \"\") {\n    return `pi:${piSessionId}:tool:${toolCallId}:${kind}`;\n  }\n  // Tier 3 — provider response id: stable per assistant response.\n  if (responseId !== undefined && responseId !== \"\") {\n    return `pi:${piSessionId}:resp:${responseId}:${blockIndex}:${kind}`;\n  }\n  // Tier 4 — content fingerprint: last resort for an event with no id at all.\n  // Include any caller-supplied stable discriminator; content alone is never\n  // enough to distinguish two separate same-text events.\n  const role = input.role ?? \"\";\n  const fallbackId = input.fallbackId ?? \"no-stable-id\";\n  const fp = fingerprint(fallbackId, role, kind, input.content ?? \"\");\n  return `pi:${piSessionId}:fp:${fallbackId}:${blockIndex}:${role}:${kind}:${fp}`;\n}\n","numLines":62,"startLine":1,"totalLines":62}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e14fbf5166a445168f4210b9","type":"tool_result","content":"1\t// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\n2\t// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\n3\t// production path runs end to end — PI hook → converter → real LHC intake —\n4\t// and every assertion reads the durable thread back. TC-2.8 also exercises\n5\t// capture() directly because the two failure shapes (writable→gap vs\n6\t// store-unavailable→health) are the architecture-risk contract.\n7\timport { rmSync } from \"node:fs\";\n8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n9\timport {\n10\t  createDeterministicProvider,\n11\t  inspect,\n12\t  intakeStream,\n13\t  threads,\n14\t  type MessageEventInput,\n15\t  type ThreadRef,\n16\t} from \"lhc\";\n17\timport { capture } from \"../../src/capture/converter.js\";\n18\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n19\timport type { LhcInstance } from \"../../src/shared/instance.js\";\n20\timport {\n21\t  makeAgentEnd,\n22\t  makeAssistantMessage,\n23\t  makeMessageEnd,\n24\t  makeToolResult,\n25\t  makeUserMessage,\n26\t  validEvent,\n27\t} from \"../fixtures/synthetic.js\";\n28\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n29\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n30\t\n31\tlet store: TempStore;\n32\tbeforeEach(() => {\n33\t  store = tempStore();\n34\t});\n35\tafterEach(() => {\n36\t  store.cleanup();\n37\t});\n38\t\n39\tfunction textOf(event: MessageEventInput): string {\n40\t  return (event.payload as { text?: string }).text ?? \"\";\n41\t}\n42\t\n43\tdescribe(\"Story 2: converter — capture and fan-out (TC-2.1)\", () => {\n44\t  it(\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\", async () => {\n45\t    const started = await startCapture(store);\n46\t    const { connector, ctx } = started;\n47\t\n48\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read the file\")));\n49\t    await connector.handlers.message_end(\n50\t      ctx,\n51\t      makeMessageEnd(\n52\t        makeAssistantMessage({\n53\t          thinking: \"I should open it\",\n54\t          text: \"here is the answer\",\n55\t          toolCalls: [{ id: \"call_x\", name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n56\t        }),\n57\t      ),\n58\t    );\n59\t    await connector.handlers.message_end(\n60\t      ctx,\n61\t      makeMessageEnd(makeToolResult({ id: \"call_x\", content: \"file body\" })),\n62\t    );\n63\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n64\t\n65\t    // No silent capture failure on the happy path.\n66\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n67\t\n68\t    const events = await eventsAfterShutdown(started);\n69\t    expect(kindsOf(events)).toEqual([\n70\t      \"user_prompt\",\n71\t      \"assistant_thinking\",\n72\t      \"assistant_text\",\n73\t      \"tool_call\",\n74\t      \"tool_result\",\n75\t      \"turn_end\",\n76\t    ]);\n77\t\n78\t    expect(textOf(events[0]!)).toBe(\"read the file\");\n79\t    expect(textOf(events[1]!)).toBe(\"I should open it\");\n80\t    expect(textOf(events[2]!)).toBe(\"here is the answer\");\n81\t    expect(events[3]!.payload).toMatchObject({\n82\t      toolCallId: \"call_x\",\n83\t      toolName: \"read_file\",\n84\t      arguments: { path: \"notes.txt\" },\n85\t    });\n86\t    expect(events[4]!.payload).toMatchObject({ toolCallId: \"call_x\", content: \"file body\" });\n87\t  });\n88\t});\n89\t\n90\tdescribe(\"Story 2: converter — runtime-change capture (TC-2.9)\", () => {\n91\t  it(\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\", async () => {\n92\t    const started = await startCapture(store);\n93\t    const { connector, ctx } = started;\n94\t\n95\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"go\")));\n96\t    await connector.handlers.model_select(ctx, {\n97\t      model: { provider: \"openai\", id: \"gpt-4o\" },\n98\t      previousModel: { provider: \"anthropic\", id: \"claude-3\" },\n99\t    });\n100\t    await connector.handlers.thinking_level_select(ctx, { level: \"high\", previousLevel: \"low\" });\n101\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"done\" })));\n102\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n103\t\n104\t    const events = await eventsAfterShutdown(started);\n105\t    // Ordering relative to the surrounding messages is preserved.\n106\t    expect(kindsOf(events)).toEqual([\n107\t      \"user_prompt\",\n108\t      \"runtime_note\",\n109\t      \"runtime_note\",\n110\t      \"assistant_text\",\n111\t      \"turn_end\",\n112\t    ]);\n113\t\n114\t    const modelNote = textOf(events[1]!);\n115\t    expect(modelNote).toContain(\"anthropic/claude-3\");\n116\t    expect(modelNote).toContain(\"openai/gpt-4o\");\n117\t\n118\t    const levelNote = textOf(events[2]!);\n119\t    expect(levelNote).toContain(\"low\");\n120\t    expect(levelNote).toContain(\"high\");\n121\t  });\n122\t\n123\t  it(\"records repeated identical model_select hooks as distinct source-position events\", async () => {\n124\t    const started = await startCapture(store);\n125\t    const { connector, ctx } = started;\n126\t    const event = { model: { provider: \"openai\", id: \"gpt-4o\" }, position: 12 };\n127\t\n128\t    await connector.handlers.model_select(ctx, event);\n129\t    await connector.handlers.model_select(ctx, { ...event, position: 13 });\n130\t    await connector.handlers.model_select(ctx, event);\n131\t\n132\t    const events = await eventsAfterShutdown(started);\n133\t    expect(kindsOf(events)).toEqual([\"runtime_note\", \"runtime_note\"]);\n134\t    expect(events[0]!.idempotencyKey).toContain(\"model_select:12\");\n135\t    expect(events[1]!.idempotencyKey).toContain(\"model_select:13\");\n136\t    expect(events[0]!.idempotencyKey).not.toBe(events[1]!.idempotencyKey);\n137\t  });\n138\t\n139\t  it(\"records repeated identical no-position model_select hooks as distinct connector-source events\", async () => {\n140\t    const started = await startCapture(store);\n141\t    const { connector, ctx } = started;\n142\t    const event = { model: { provider: \"openai\", id: \"gpt-4o\" } };\n143\t\n144\t    await connector.handlers.model_select(ctx, event);\n145\t    await connector.handlers.model_select(ctx, event);\n146\t\n147\t    const events = await eventsAfterShutdown(started);\n148\t    expect(kindsOf(events)).toEqual([\"runtime_note\", \"runtime_note\"]);\n149\t    expect(events[0]!.idempotencyKey).toContain(\"model_select:sourceSeq:0\");\n150\t    expect(events[1]!.idempotencyKey).toContain(\"model_select:sourceSeq:1\");\n151\t    expect(events[0]!.idempotencyKey).not.toBe(events[1]!.idempotencyKey);\n152\t  });\n153\t});\n154\t\n155\tdescribe(\"Story 2: converter — connector fallback idempotency\", () => {\n156\t  it(\"records repeated same-content no-entry/no-position messages as distinct connector-source events\", async () => {\n157\t    const started = await startCapture(store);\n158\t    const { connector, ctx } = started;\n159\t\n160\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"same text\")));\n161\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"same text\")));\n162\t\n163\t    const events = await eventsAfterShutdown(started);\n164\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"user_prompt\"]);\n165\t    expect(events[0]!.idempotencyKey).toContain(\"message_end:sourceSeq:0\");\n166\t    expect(events[1]!.idempotencyKey).toContain(\"message_end:sourceSeq:1\");\n167\t    expect(events[0]!.idempotencyKey).not.toBe(events[1]!.idempotencyKey);\n168\t  });\n169\t});\n170\t\n171\tdescribe(\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\", () => {\n172\t  async function liveInstance(): Promise<LhcInstance> {\n173\t    const thread = await makeTempThread(store);\n174\t    const built = await initInstance(thread.threadRef, {\n175\t      provider: createDeterministicProvider(),\n176\t      mode: \"background\",\n177\t    });\n178\t    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\n179\t    return built.value;\n180\t  }\n181\t\n182\t  it(\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\", async () => {\n183\t    const instance = await liveInstance();\n184\t    // A turn_end with a non-empty payload is rejected by LHC validation\n185\t    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\n186\t    const malformed = {\n187\t      eventKind: \"turn_end\",\n188\t      idempotencyKey: \"malformed-1\",\n189\t      actor: \"system\",\n190\t      harness: \"pi\",\n191\t      payload: { stowaway: true },\n192\t    } as unknown as MessageEventInput;\n193\t\n194\t    const result = await capture([malformed], instance);\n195\t    expect(result.ok).toBe(false);\n196\t\n197\t    // The session continues: a durable, queryable gap is recorded on the thread.\n198\t    const read = await intakeStream.listEvents(instance.threadRef);\n199\t    expect(read.ok).toBe(true);\n200\t    if (!read.ok) return;\n201\t    const gaps = read.value.filter(\n202\t      (event) =>\n203\t        event.eventKind === \"runtime_note\" &&\n204\t        (event.payload as { text: string }).text.toLowerCase().includes(\"gap\"),\n205\t    );\n206\t    expect(gaps).toHaveLength(1);\n207\t\n208\t    const health = await inspect.health(instance.threadRef);\n209\t    expect(health.ok).toBe(true);\n210\t    if (!health.ok) return;\n211\t    expect(health.value.owners).toContainEqual({\n212\t      owner: \"capture\",\n213\t      kind: \"capture_gap\",\n214\t      counts: { ready: 0, pending: 0, retrying: 0, failed: 1, blocked: 0 },\n215\t    });\n216\t    expect(health.value.failures).toContainEqual({\n217\t      owner: \"capture\",\n218\t      subjectKind: \"event\",\n219\t      subjectId: String(gaps[0]!.eventOrder),\n220\t      form: \"capture_gap\",\n221\t      reason: (gaps[0]!.payload as { text: string }).text,\n222\t      attempts: 0,\n223\t    });\n224\t\n225\t    await instance.dispose();\n226\t  });\n227\t\n228\t  it(\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\", async () => {\n229\t    const deadInstance: LhcInstance = {\n230\t      sdk: (await liveInstance()).sdk,\n231\t      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\n232\t      dispose: () => Promise.resolve({ ok: true, value: undefined }),\n233\t    };\n234\t\n235\t    // capture isolates the failure into a structured result rather than throwing.\n236\t    const result = await capture([validEvent(\"user_prompt\")], deadInstance);\n237\t    expect(result.ok).toBe(false);\n238\t    if (result.ok) return;\n239\t    expect([\"thread_not_found\", \"storage_failure\"]).toContain(result.error.code);\n240\t    // It is NOT misclassified as the writable-thread malformed-event case.\n241\t    expect(result.error.code).not.toBe(\"invalid_event\");\n242\t  });\n243\t\n244\t  it(\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\", async () => {\n245\t    const started = await startCapture(store);\n246\t    const { connector, ctx, threadRef } = started;\n247\t\n248\t    // Make the live thread's store unavailable mid-session, then capture.\n249\t    const id = (threadRef as { threadId: string }).threadId;\n250\t    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\n251\t    expect(row.ok).toBe(true);\n252\t    if (!row.ok) return;\n253\t    rmSync(row.value.filePath, { force: true });\n254\t\n255\t    // The hook must not throw despite the dead store.\n256\t    await expect(\n257\t      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"after the store died\"))),\n258\t    ).resolves.toBeUndefined();\n259\t\n260\t    const health = connector.getState()?.health.lastCaptureFailure;\n261\t    expect(health).toBeDefined();\n262\t    expect(health?.recordedGap).toBe(false);\n263\t\n264\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n265\t  });\n266\t\n267\t  it(\"(c) an unmappable hook input on a writable thread records a durable gap, surfaces in health, and does not throw\", async () => {\n268\t    const started = await startCapture(store);\n269\t    const { connector, ctx, threadRef } = started;\n270\t\n271\t    await expect(\n272\t      connector.handlers.message_end(ctx, {\n273\t        position: 71,\n274\t        message: { role: \"badRole\", content: [] } as never,\n275\t      }),\n276\t    ).resolves.toBeUndefined();\n277\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"session continues\"), undefined, 72));\n278\t\n279\t    const read = await intakeStream.listEvents(threadRef);\n280\t    expect(read.ok).toBe(true);\n281\t    if (!read.ok) return;\n282\t    const gaps = read.value.filter(\n283\t      (event) =>\n284\t        event.eventKind === \"runtime_note\" &&\n285\t        (event.payload as { text: string }).text.includes(\"capture gap\"),\n286\t    );\n287\t    expect(gaps).toHaveLength(1);\n288\t    expect((gaps[0]!.payload as { text: string }).text).toContain(\"unmappable PI hook input\");\n289\t\n290\t    const health = await inspect.health(threadRef);\n291\t    expect(health.ok).toBe(true);\n292\t    if (!health.ok) return;\n293\t    expect(health.value.failures).toContainEqual({\n294\t      owner: \"capture\",\n295\t      subjectKind: \"event\",\n296\t      subjectId: String(gaps[0]!.eventOrder),\n297\t      form: \"capture_gap\",\n298\t      reason: (gaps[0]!.payload as { text: string }).text,\n299\t      attempts: 0,\n300\t    });\n301\t\n302\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n303\t    const events = await intakeStream.listEvents(threadRef);\n304\t    expect(events.ok).toBe(true);\n305\t    if (events.ok) expect(events.value.some((event) => textOf(event) === \"session continues\")).toBe(true);\n306\t  });\n307\t});\n308\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"3b0ad184-7b28-4399-9182-cfed9b366c57","timestamp":"2026-06-14T11:42:56.290Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/converter.test.ts","content":"// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\n// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\n// production path runs end to end — PI hook → converter → real LHC intake —\n// and every assertion reads the durable thread back. TC-2.8 also exercises\n// capture() directly because the two failure shapes (writable→gap vs\n// store-unavailable→health) are the architecture-risk contract.\nimport { rmSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  intakeStream,\n  threads,\n  type MessageEventInput,\n  type ThreadRef,\n} from \"lhc\";\nimport { capture } from \"../../src/capture/converter.js\";\nimport { initInstance } from \"../../src/lifecycle/instance.js\";\nimport type { LhcInstance } from \"../../src/shared/instance.js\";\nimport {\n  makeAgentEnd,\n  makeAssistantMessage,\n  makeMessageEnd,\n  makeToolResult,\n  makeUserMessage,\n  validEvent,\n} from \"../fixtures/synthetic.js\";\nimport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\nimport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction textOf(event: MessageEventInput): string {\n  return (event.payload as { text?: string }).text ?? \"\";\n}\n\ndescribe(\"Story 2: converter — capture and fan-out (TC-2.1)\", () => {\n  it(\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read the file\")));\n    await connector.handlers.message_end(\n      ctx,\n      makeMessageEnd(\n        makeAssistantMessage({\n          thinking: \"I should open it\",\n          text: \"here is the answer\",\n          toolCalls: [{ id: \"call_x\", name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n        }),\n      ),\n    );\n    await connector.handlers.message_end(\n      ctx,\n      makeMessageEnd(makeToolResult({ id: \"call_x\", content: \"file body\" })),\n    );\n    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n\n    // No silent capture failure on the happy path.\n    expect(connector.snapshot().lastDiagnostic).toBeNull();\n\n    const events = await eventsAfterShutdown(started);\n    expect(kindsOf(events)).toEqual([\n      \"user_prompt\",\n      \"assistant_thinking\",\n      \"assistant_text\",\n      \"tool_call\",\n      \"tool_result\",\n      \"turn_end\",\n    ]);\n\n    expect(textOf(events[0]!)).toBe(\"read the file\");\n    expect(textOf(events[1]!)).toBe(\"I should open it\");\n    expect(textOf(events[2]!)).toBe(\"here is the answer\");\n    expect(events[3]!.payload).toMatchObject({\n      toolCallId: \"call_x\",\n      toolName: \"read_file\",\n      arguments: { path: \"notes.txt\" },\n    });\n    expect(events[4]!.payload).toMatchObject({ toolCallId: \"call_x\", content: \"file body\" });\n  });\n});\n\ndescribe(\"Story 2: converter — runtime-change capture (TC-2.9)\", () => {\n  it(\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"go\")));\n    await connector.handlers.model_select(ctx, {\n      model: { provider: \"openai\", id: \"gpt-4o\" },\n      previousModel: { provider: \"anthropic\", id: \"claude-3\" },\n    });\n    await connector.handlers.thinking_level_select(ctx, { level: \"high\", previousLevel: \"low\" });\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"done\" })));\n    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n\n    const events = await eventsAfterShutdown(started);\n    // Ordering relative to the surrounding messages is preserved.\n    expect(kindsOf(events)).toEqual([\n      \"user_prompt\",\n      \"runtime_note\",\n      \"runtime_note\",\n      \"assistant_text\",\n      \"turn_end\",\n    ]);\n\n    const modelNote = textOf(events[1]!);\n    expect(modelNote).toContain(\"anthropic/claude-3\");\n    expect(modelNote).toContain(\"openai/gpt-4o\");\n\n    const levelNote = textOf(events[2]!);\n    expect(levelNote).toContain(\"low\");\n    expect(levelNote).toContain(\"high\");\n  });\n\n  it(\"records repeated identical model_select hooks as distinct source-position events\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n    const event = { model: { provider: \"openai\", id: \"gpt-4o\" }, position: 12 };\n\n    await connector.handlers.model_select(ctx, event);\n    await connector.handlers.model_select(ctx, { ...event, position: 13 });\n    await connector.handlers.model_select(ctx, event);\n\n    const events = await eventsAfterShutdown(started);\n    expect(kindsOf(events)).toEqual([\"runtime_note\", \"runtime_note\"]);\n    expect(events[0]!.idempotencyKey).toContain(\"model_select:12\");\n    expect(events[1]!.idempotencyKey).toContain(\"model_select:13\");\n    expect(events[0]!.idempotencyKey).not.toBe(events[1]!.idempotencyKey);\n  });\n\n  it(\"records repeated identical no-position model_select hooks as distinct connector-source events\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n    const event = { model: { provider: \"openai\", id: \"gpt-4o\" } };\n\n    await connector.handlers.model_select(ctx, event);\n    await connector.handlers.model_select(ctx, event);\n\n    const events = await eventsAfterShutdown(started);\n    expect(kindsOf(events)).toEqual([\"runtime_note\", \"runtime_note\"]);\n    expect(events[0]!.idempotencyKey).toContain(\"model_select:sourceSeq:0\");\n    expect(events[1]!.idempotencyKey).toContain(\"model_select:sourceSeq:1\");\n    expect(events[0]!.idempotencyKey).not.toBe(events[1]!.idempotencyKey);\n  });\n});\n\ndescribe(\"Story 2: converter — connector fallback idempotency\", () => {\n  it(\"records repeated same-content no-entry/no-position messages as distinct connector-source events\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"same text\")));\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"same text\")));\n\n    const events = await eventsAfterShutdown(started);\n    expect(kindsOf(events)).toEqual([\"user_prompt\", \"user_prompt\"]);\n    expect(events[0]!.idempotencyKey).toContain(\"message_end:sourceSeq:0\");\n    expect(events[1]!.idempotencyKey).toContain(\"message_end:sourceSeq:1\");\n    expect(events[0]!.idempotencyKey).not.toBe(events[1]!.idempotencyKey);\n  });\n});\n\ndescribe(\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\", () => {\n  async function liveInstance(): Promise<LhcInstance> {\n    const thread = await makeTempThread(store);\n    const built = await initInstance(thread.threadRef, {\n      provider: createDeterministicProvider(),\n      mode: \"background\",\n    });\n    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\n    return built.value;\n  }\n\n  it(\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\", async () => {\n    const instance = await liveInstance();\n    // A turn_end with a non-empty payload is rejected by LHC validation\n    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\n    const malformed = {\n      eventKind: \"turn_end\",\n      idempotencyKey: \"malformed-1\",\n      actor: \"system\",\n      harness: \"pi\",\n      payload: { stowaway: true },\n    } as unknown as MessageEventInput;\n\n    const result = await capture([malformed], instance);\n    expect(result.ok).toBe(false);\n\n    // The session continues: a durable, queryable gap is recorded on the thread.\n    const read = await intakeStream.listEvents(instance.threadRef);\n    expect(read.ok).toBe(true);\n    if (!read.ok) return;\n    const gaps = read.value.filter(\n      (event) =>\n        event.eventKind === \"runtime_note\" &&\n        (event.payload as { text: string }).text.toLowerCase().includes(\"gap\"),\n    );\n    expect(gaps).toHaveLength(1);\n\n    const health = await inspect.health(instance.threadRef);\n    expect(health.ok).toBe(true);\n    if (!health.ok) return;\n    expect(health.value.owners).toContainEqual({\n      owner: \"capture\",\n      kind: \"capture_gap\",\n      counts: { ready: 0, pending: 0, retrying: 0, failed: 1, blocked: 0 },\n    });\n    expect(health.value.failures).toContainEqual({\n      owner: \"capture\",\n      subjectKind: \"event\",\n      subjectId: String(gaps[0]!.eventOrder),\n      form: \"capture_gap\",\n      reason: (gaps[0]!.payload as { text: string }).text,\n      attempts: 0,\n    });\n\n    await instance.dispose();\n  });\n\n  it(\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\", async () => {\n    const deadInstance: LhcInstance = {\n      sdk: (await liveInstance()).sdk,\n      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\n      dispose: () => Promise.resolve({ ok: true, value: undefined }),\n    };\n\n    // capture isolates the failure into a structured result rather than throwing.\n    const result = await capture([validEvent(\"user_prompt\")], deadInstance);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect([\"thread_not_found\", \"storage_failure\"]).toContain(result.error.code);\n    // It is NOT misclassified as the writable-thread malformed-event case.\n    expect(result.error.code).not.toBe(\"invalid_event\");\n  });\n\n  it(\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx, threadRef } = started;\n\n    // Make the live thread's store unavailable mid-session, then capture.\n    const id = (threadRef as { threadId: string }).threadId;\n    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    rmSync(row.value.filePath, { force: true });\n\n    // The hook must not throw despite the dead store.\n    await expect(\n      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"after the store died\"))),\n    ).resolves.toBeUndefined();\n\n    const health = connector.getState()?.health.lastCaptureFailure;\n    expect(health).toBeDefined();\n    expect(health?.recordedGap).toBe(false);\n\n    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n  });\n\n  it(\"(c) an unmappable hook input on a writable thread records a durable gap, surfaces in health, and does not throw\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx, threadRef } = started;\n\n    await expect(\n      connector.handlers.message_end(ctx, {\n        position: 71,\n        message: { role: \"badRole\", content: [] } as never,\n      }),\n    ).resolves.toBeUndefined();\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"session continues\"), undefined, 72));\n\n    const read = await intakeStream.listEvents(threadRef);\n    expect(read.ok).toBe(true);\n    if (!read.ok) return;\n    const gaps = read.value.filter(\n      (event) =>\n        event.eventKind === \"runtime_note\" &&\n        (event.payload as { text: string }).text.includes(\"capture gap\"),\n    );\n    expect(gaps).toHaveLength(1);\n    expect((gaps[0]!.payload as { text: string }).text).toContain(\"unmappable PI hook input\");\n\n    const health = await inspect.health(threadRef);\n    expect(health.ok).toBe(true);\n    if (!health.ok) return;\n    expect(health.value.failures).toContainEqual({\n      owner: \"capture\",\n      subjectKind: \"event\",\n      subjectId: String(gaps[0]!.eventOrder),\n      form: \"capture_gap\",\n      reason: (gaps[0]!.payload as { text: string }).text,\n      attempts: 0,\n    });\n\n    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    const events = await intakeStream.listEvents(threadRef);\n    expect(events.ok).toBe(true);\n    if (events.ok) expect(events.value.some((event) => textOf(event) === \"session continues\")).toBe(true);\n  });\n});\n","numLines":308,"startLine":1,"totalLines":308}}}

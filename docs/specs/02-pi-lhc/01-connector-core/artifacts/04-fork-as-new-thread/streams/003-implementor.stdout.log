{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c65924baf6aa4b5bbcf5009e","type":"tool_result","content":"1\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\n2\t// reconstruction. Two layers are covered: the resolver/picker functions\n3\t// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\n4\t// PRODUCTION connector path through createConnector with real defaults (no\n5\t// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\n6\t// throughout; the module-level reload memory is reset per test.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  createDeterministicProvider,\n10\t  inspect,\n11\t  threads,\n12\t  type SdkConfig,\n13\t  type ThreadRef,\n14\t} from \"lhc\";\n15\timport { createConnector } from \"../../src/index.js\";\n16\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n17\timport {\n18\t  defaultThreadTitle,\n19\t  parseLaunchFlags,\n20\t  resolveThread,\n21\t  type ResolveDeps,\n22\t} from \"../../src/lifecycle/thread-resolution.js\";\n23\timport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\n24\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n25\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n26\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n27\t\n28\tlet store: TempStore;\n29\tbeforeEach(() => {\n30\t  store = tempStore();\n31\t  // No connector reset needed: the connector keeps no module-level state — reload\n32\t  // reconstructs from the durable registry, and each test uses a fresh temp store.\n33\t});\n34\tafterEach(() => {\n35\t  store.cleanup();\n36\t});\n37\t\n38\tfunction backgroundConfig(): SdkConfig {\n39\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n40\t}\n41\t\n42\tfunction idOf(ref: ThreadRef): string {\n43\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n44\t  return ref.threadId;\n45\t}\n46\t\n47\tfunction deps(cwd = \"/work/default\"): ResolveDeps {\n48\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n49\t}\n50\t\n51\t// Create a thread directly with explicit cwd/title, for picker fixtures and\n52\t// existing-thread setup. (Connector-created threads get cwd plus a default title\n53\t// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\n54\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n55\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n56\t    filePath: store.threadPath(),\n57\t    registryPath: store.registryPath,\n58\t  };\n59\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n60\t  if (opts.title !== undefined) input.title = opts.title;\n61\t  const created = await threads.newThread(input);\n62\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n63\t  return created.value.threadId;\n64\t}\n65\t\n66\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n67\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\n68\t// object, modelling PI handing a fresh ctx to each hook.\n69\tfunction syntheticCtx(cwd: string): ExtensionContext {\n70\t  return {\n71\t    cwd,\n72\t    hasUI: false,\n73\t    modelRegistry: {\n74\t      find: () => undefined,\n75\t      hasConfiguredAuth: () => false,\n76\t      getAvailable: () => [],\n77\t    },\n78\t    ui: { notify: () => {} },\n79\t    sessionManager: { getEntries: () => [] },\n80\t  };\n81\t}\n82\t\n83\t// A connector wired with production defaults (real SDK config + selector) and\n84\t// only environment overrides — the activate() path, minus the global registry\n85\t// and process.argv.\n86\tfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n87\t  return createConnector({\n88\t    registryPath: store.registryPath,\n89\t    newThreadFilePath: () => store.threadPath(),\n90\t    parseLaunch: launch,\n91\t  });\n92\t}\n93\t\n94\tasync function threadCount(): Promise<number> {\n95\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\n96\t  return listed.ok ? listed.value.length : -1;\n97\t}\n98\t\n99\tdescribe(\"Story 1: launch-driven thread resolution (resolver/picker)\", () => {\n100\t  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"71937b00-dbf6-4166-832f-e065d64ecc4b","timestamp":"2026-06-14T11:42:34.274Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts","content":"// Story 1 — launch-driven thread resolution, plain-data state, and reload\n// reconstruction. Two layers are covered: the resolver/picker functions\n// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\n// PRODUCTION connector path through createConnector with real defaults (no\n// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\n// throughout; the module-level reload memory is reset per test.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector } from \"../../src/index.js\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport {\n  defaultThreadTitle,\n  parseLaunchFlags,\n  resolveThread,\n  type ResolveDeps,\n} from \"../../src/lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n  // No connector reset needed: the connector keeps no module-level state — reload\n  // reconstructs from the durable registry, and each test uses a fresh temp store.\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\nfunction deps(cwd = \"/work/default\"): ResolveDeps {\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n}\n\n// Create a thread directly with explicit cwd/title, for picker fixtures and\n// existing-thread setup. (Connector-created threads get cwd plus a default title\n// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  };\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n  if (opts.title !== undefined) input.title = opts.title;\n  const created = await threads.newThread(input);\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n  return created.value.threadId;\n}\n\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\n// object, modelling PI handing a fresh ctx to each hook.\nfunction syntheticCtx(cwd: string): ExtensionContext {\n  return {\n    cwd,\n    hasUI: false,\n    modelRegistry: {\n      find: () => undefined,\n      hasConfiguredAuth: () => false,\n      getAvailable: () => [],\n    },\n    ui: { notify: () => {} },\n    sessionManager: { getEntries: () => [] },\n  };\n}\n\n// A connector wired with production defaults (real SDK config + selector) and\n// only environment overrides — the activate() path, minus the global registry\n// and process.argv.\nfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n  return createConnector({\n    registryPath: store.registryPath,\n    newThreadFilePath: () => store.threadPath(),\n    parseLaunch: launch,\n  });\n}\n\nasync function threadCount(): Promise<number> {\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\n  return listed.ok ? listed.value.length : -1;\n}\n\ndescribe(\"Story 1: launch-driven thread resolution (resolver/picker)\", () => {\n  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {","numLines":100,"startLine":1,"totalLines":406}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b443d7d07a364734a5848316","type":"tool_result","content":"1\t// Local declarations of the PI extension surface the connector consumes.\n2\t//\n3\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n4\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n5\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\n6\t// build-time dependency of this workspace, so the connector declares the slice\n7\t// of their contract it touches and swaps to the real imports when the\n8\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n9\t// surface here — rather than scattered `any` — means later stories get real\n10\t// type-checking against the contract PI actually fires.\n11\t\n12\t// ── Hook vocabulary ──────────────────────────────────────────────────\n13\t\n14\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n15\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\n16\t *  serving is Epic 2. */\n17\texport type PiHookName =\n18\t  | \"session_start\"\n19\t  | \"message_end\"\n20\t  | \"turn_end\"\n21\t  | \"agent_end\"\n22\t  | \"model_select\"\n23\t  | \"thinking_level_select\"\n24\t  | \"session_before_fork\"\n25\t  | \"session_before_switch\"\n26\t  | \"session_shutdown\"\n27\t  | \"context\";\n28\t\n29\texport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\n30\texport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n31\t\n32\texport interface SessionStartEvent {\n33\t  reason: SessionStartReason;\n34\t  previousSessionFile?: string;\n35\t}\n36\texport interface MessageEndEvent {\n37\t  entryId?: string;\n38\t  position?: number;\n39\t  message: AgentMessage;\n40\t}\n41\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n42\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\n43\texport interface TurnEndEvent {\n44\t  turnIndex: number;\n45\t  message: AgentMessage;\n46\t  toolResults: ToolResultMessage[];\n47\t  stopReason?: PiStopReason;\n48\t}\n49\texport interface AgentEndEvent {\n50\t  messages: AgentMessage[];\n51\t}\n52\texport interface ModelSelectEvent {\n53\t  model: ModelDescriptor;\n54\t  previousModel?: ModelDescriptor;\n55\t  position?: number;\n56\t  source?: string;\n57\t}\n58\texport interface ThinkingLevelSelectEvent {\n59\t  level: string;\n60\t  previousLevel: string;\n61\t  position?: number;\n62\t}\n63\texport interface SessionBeforeForkEvent {\n64\t  entryId: string;\n65\t  position?: number;\n66\t}\n67\texport interface SessionBeforeSwitchEvent {\n68\t  intent: \"new\" | \"resume\";\n69\t}\n70\texport interface SessionShutdownEvent {\n71\t  reason: SessionShutdownReason;\n72\t  targetSessionFile?: string;\n73\t}\n74\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\n75\texport interface ContextEvent {\n76\t  messages: AgentMessage[];\n77\t}\n78\t\n79\t/** Maps each hook to the payload PI delivers with it. */\n80\texport interface PiHookEventMap {\n81\t  session_start: SessionStartEvent;\n82\t  message_end: MessageEndEvent;\n83\t  turn_end: TurnEndEvent;\n84\t  agent_end: AgentEndEvent;\n85\t  model_select: ModelSelectEvent;\n86\t  thinking_level_select: ThinkingLevelSelectEvent;\n87\t  session_before_fork: SessionBeforeForkEvent;\n88\t  session_before_switch: SessionBeforeSwitchEvent;\n89\t  session_shutdown: SessionShutdownEvent;\n90\t  context: ContextEvent;\n91\t}\n92\t\n93\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n94\t *  connector must never retain it across calls (PI replaces session objects on\n95\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\n96\texport type PiHookHandler<N extends PiHookName> = (\n97\t  ctx: ExtensionContext,\n98\t  event: PiHookEventMap[N],\n99\t) => void | Promise<void>;\n100\t\n101\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n102\t\n103\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n104\t\n105\texport interface PiToolSpec {\n106\t  name: string;\n107\t  description?: string;\n108\t  promptSnippet?: string;\n109\t  promptGuidelines?: string;\n110\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n111\t}\n112\t\n113\t/** The factory-time API. Hook registration and command/tool registration take\n114\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n115\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n116\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\n117\texport interface ExtensionAPI {\n118\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n119\t  registerCommand(name: string, handler: PiCommandHandler): void;\n120\t  registerTool(tool: PiToolSpec): void;\n121\t  appendEntry(customType: string, data: unknown): void;\n122\t}\n123\t\n124\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n125\t\n126\texport interface ModelDescriptor {\n127\t  provider: string;\n128\t  id: string;\n129\t}\n130\t\n131\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n132\t *  owns. The connector treats provider/model as opaque routing keys. */\n133\texport interface ModelHandle extends ModelDescriptor {\n134\t  readonly [k: string]: unknown;\n135\t}\n136\t\n137\texport interface ModelRegistry {\n138\t  find(provider: string, model: string): ModelHandle | undefined;\n139\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\n140\t  getAvailable(): ModelHandle[];\n141\t}\n142\t\n143\texport interface ExtensionUI {\n144\t  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n145\t}\n146\t\n147\texport interface SessionEntry {\n148\t  type: string;\n149\t  readonly [k: string]: unknown;\n150\t}\n151\t\n152\texport interface SessionManager {\n153\t  getEntries(): SessionEntry[];\n154\t}\n155\t\n156\texport interface ExtensionContext {\n157\t  modelRegistry: ModelRegistry;\n158\t  ui: ExtensionUI;\n159\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n160\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n161\t  hasUI: boolean;\n162\t  sessionManager: SessionManager;\n163\t  cwd: string;\n164\t}\n165\t\n166\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n167\t\n168\texport interface TextPart {\n169\t  type: \"text\";\n170\t  text: string;\n171\t}\n172\texport interface ThinkingPart {\n173\t  type: \"thinking\";\n174\t  thinking: string;\n175\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n176\t   *  Epic 1 (tech design I-3). */\n177\t  thinkingSignature?: string;\n178\t}\n179\texport interface ToolCallPart {\n180\t  type: \"toolCall\";\n181\t  /** Composite, stable across tool_execution_start → tool_result → message_end\n182\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n183\t  id: string;\n184\t  name: string;\n185\t  arguments: Record<string, unknown>;\n186\t  /** Opaque; captured, not interpreted (tech design I-3). */\n187\t  thoughtSignature?: string;\n188\t}\n189\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n190\t *  the converter (tech design I-6), never silently dropped. */\n191\texport interface ImagePart {\n192\t  type: \"image\";\n193\t  mimeType?: string;\n194\t  data?: string;\n195\t}\n196\texport interface FileRefPart {\n197\t  type: \"fileRef\";\n198\t  path: string;\n199\t}\n200\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n201\t\n202\texport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n203\t\n204\texport interface TokenUsage {\n205\t  inputTokens?: number;\n206\t  outputTokens?: number;\n207\t}\n208\t\n209\texport interface UserMessage {\n210\t  role: \"user\";\n211\t  content: ContentPart[];\n212\t}\n213\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n214\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\n215\texport interface AssistantMessage {\n216\t  role: \"assistant\";\n217\t  content: ContentPart[];\n218\t  stopReason?: PiStopReason;\n219\t  usage?: TokenUsage;\n220\t}\n221\texport interface ToolResultMessage {\n222\t  role: \"toolResult\";\n223\t  toolCallId: string;\n224\t  content: ContentPart[];\n225\t  isError?: boolean;\n226\t}\n227\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n228\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"6fd4fec0-0090-4dc8-ae54-2fbbaac50c4a","timestamp":"2026-06-14T11:42:26.744Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/pi/types.ts","content":"// Local declarations of the PI extension surface the connector consumes.\n//\n// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n// headless + interactive recon, June 12 2026). The PI packages are not yet a\n// build-time dependency of this workspace, so the connector declares the slice\n// of their contract it touches and swaps to the real imports when the\n// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n// surface here — rather than scattered `any` — means later stories get real\n// type-checking against the contract PI actually fires.\n\n// ── Hook vocabulary ──────────────────────────────────────────────────\n\n/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n *  `context` is fired by PI but Epic 1 registers no handler for it — context\n *  serving is Epic 2. */\nexport type PiHookName =\n  | \"session_start\"\n  | \"message_end\"\n  | \"turn_end\"\n  | \"agent_end\"\n  | \"model_select\"\n  | \"thinking_level_select\"\n  | \"session_before_fork\"\n  | \"session_before_switch\"\n  | \"session_shutdown\"\n  | \"context\";\n\nexport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\nexport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n\nexport interface SessionStartEvent {\n  reason: SessionStartReason;\n  previousSessionFile?: string;\n}\nexport interface MessageEndEvent {\n  entryId?: string;\n  position?: number;\n  message: AgentMessage;\n}\n/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\nexport interface TurnEndEvent {\n  turnIndex: number;\n  message: AgentMessage;\n  toolResults: ToolResultMessage[];\n  stopReason?: PiStopReason;\n}\nexport interface AgentEndEvent {\n  messages: AgentMessage[];\n}\nexport interface ModelSelectEvent {\n  model: ModelDescriptor;\n  previousModel?: ModelDescriptor;\n  position?: number;\n  source?: string;\n}\nexport interface ThinkingLevelSelectEvent {\n  level: string;\n  previousLevel: string;\n  position?: number;\n}\nexport interface SessionBeforeForkEvent {\n  entryId: string;\n  position?: number;\n}\nexport interface SessionBeforeSwitchEvent {\n  intent: \"new\" | \"resume\";\n}\nexport interface SessionShutdownEvent {\n  reason: SessionShutdownReason;\n  targetSessionFile?: string;\n}\n/** Declared for completeness; Epic 1 registers no handler (observe-only). */\nexport interface ContextEvent {\n  messages: AgentMessage[];\n}\n\n/** Maps each hook to the payload PI delivers with it. */\nexport interface PiHookEventMap {\n  session_start: SessionStartEvent;\n  message_end: MessageEndEvent;\n  turn_end: TurnEndEvent;\n  agent_end: AgentEndEvent;\n  model_select: ModelSelectEvent;\n  thinking_level_select: ThinkingLevelSelectEvent;\n  session_before_fork: SessionBeforeForkEvent;\n  session_before_switch: SessionBeforeSwitchEvent;\n  session_shutdown: SessionShutdownEvent;\n  context: ContextEvent;\n}\n\n/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n *  connector must never retain it across calls (PI replaces session objects on\n *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\nexport type PiHookHandler<N extends PiHookName> = (\n  ctx: ExtensionContext,\n  event: PiHookEventMap[N],\n) => void | Promise<void>;\n\n// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n\nexport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n\nexport interface PiToolSpec {\n  name: string;\n  description?: string;\n  promptSnippet?: string;\n  promptGuidelines?: string;\n  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n}\n\n/** The factory-time API. Hook registration and command/tool registration take\n *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n *  exposes them, but Epic 1 (observe-only) registers only hooks. */\nexport interface ExtensionAPI {\n  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n  registerCommand(name: string, handler: PiCommandHandler): void;\n  registerTool(tool: PiToolSpec): void;\n  appendEntry(customType: string, data: unknown): void;\n}\n\n// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n\nexport interface ModelDescriptor {\n  provider: string;\n  id: string;\n}\n\n/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n *  owns. The connector treats provider/model as opaque routing keys. */\nexport interface ModelHandle extends ModelDescriptor {\n  readonly [k: string]: unknown;\n}\n\nexport interface ModelRegistry {\n  find(provider: string, model: string): ModelHandle | undefined;\n  hasConfiguredAuth(model: ModelHandle | string): boolean;\n  getAvailable(): ModelHandle[];\n}\n\nexport interface ExtensionUI {\n  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n}\n\nexport interface SessionEntry {\n  type: string;\n  readonly [k: string]: unknown;\n}\n\nexport interface SessionManager {\n  getEntries(): SessionEntry[];\n}\n\nexport interface ExtensionContext {\n  modelRegistry: ModelRegistry;\n  ui: ExtensionUI;\n  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n  hasUI: boolean;\n  sessionManager: SessionManager;\n  cwd: string;\n}\n\n// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n\nexport interface TextPart {\n  type: \"text\";\n  text: string;\n}\nexport interface ThinkingPart {\n  type: \"thinking\";\n  thinking: string;\n  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n   *  Epic 1 (tech design I-3). */\n  thinkingSignature?: string;\n}\nexport interface ToolCallPart {\n  type: \"toolCall\";\n  /** Composite, stable across tool_execution_start → tool_result → message_end\n   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n  id: string;\n  name: string;\n  arguments: Record<string, unknown>;\n  /** Opaque; captured, not interpreted (tech design I-3). */\n  thoughtSignature?: string;\n}\n/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n *  the converter (tech design I-6), never silently dropped. */\nexport interface ImagePart {\n  type: \"image\";\n  mimeType?: string;\n  data?: string;\n}\nexport interface FileRefPart {\n  type: \"fileRef\";\n  path: string;\n}\nexport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n\nexport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n\nexport interface TokenUsage {\n  inputTokens?: number;\n  outputTokens?: number;\n}\n\nexport interface UserMessage {\n  role: \"user\";\n  content: ContentPart[];\n}\n/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n *  host maps it to text or a classified failure (Epic 1 Story 5). */\nexport interface AssistantMessage {\n  role: \"assistant\";\n  content: ContentPart[];\n  stopReason?: PiStopReason;\n  usage?: TokenUsage;\n}\nexport interface ToolResultMessage {\n  role: \"toolResult\";\n  toolCallId: string;\n  content: ContentPart[];\n  isError?: boolean;\n}\nexport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n","numLines":228,"startLine":1,"totalLines":228}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_185e34187aa044e3ab3a3892","type":"tool_result","content":"1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n2\t\n3\texport type ErrorCode =\n4\t  | \"path_exists\"\n5\t  | \"thread_not_found\"\n6\t  | \"ambiguous_thread_id\" // caller_error — a partial thread id matched more than one thread (A-8 partial-id resolve)\n7\t  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n8\t  | \"invalid_event\"\n9\t  | \"empty_batch\"\n10\t  | \"turn_state_corrupt\"\n11\t  | \"storage_failure\"\n12\t  // Epic 02 (tech design §Interfaces, issue 4):\n13\t  | \"turn_open\" // caller_error — mutation against an open turn\n14\t  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n15\t  | \"message_not_found\" // caller_error\n16\t  | \"turn_not_found\" // caller_error\n17\t  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n18\t  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n19\t  | \"source_damaged\" // state_corruption — handler found corrupt source; form blocked\n20\t  // Epic 03 (tech design §Interface Definitions): the surface-skeleton stub\n21\t  // contract — machine-readable, never a throw on the thread-view surface.\n22\t  | \"not_implemented\" // system_error — operation's story has not landed yet\n23\t  // Epic 03 Story 2 (AC-2.2/2.3): compact-time config rejection — unlike SDK\n24\t  // construction (programmer error, throws), a bad compact invocation is an\n25\t  // operational caller error returned as a result.\n26\t  | \"unknown_profile\" // caller_error — named profile not configured\n27\t  | \"invalid_view_config\" // caller_error — band sum / bound violation, named\n28\t  // Epic 03 Story 5: materialize accepts pi-session only; an unknown format\n29\t  // is a caller error naming the accepted values (story Scope).\n30\t  | \"unknown_format\" // caller_error — materialize format not supported\n31\t  // Epic 04 Story 1: bounded listing — a bad bounds option (from > to,\n32\t  // limit < 1, non-integer) is an operational caller error returned as a\n33\t  // result, mirroring the compact-params precedent (additive code, the\n34\t  // Epic 03 deviation pattern).\n35\t  | \"invalid_bounds\"; // caller_error — listMessages bounds option rejected\n36\t\n37\texport interface ErrorResult {\n38\t  errorClass: ErrorClass;\n39\t  code: ErrorCode;\n40\t  reason: string; // human-readable; machine logic switches on code\n41\t  eventIndex?: number; // present on batch validation failures\n42\t}\n43\t\n44\t// Expected operational failures — caller errors, corruption, environment\n45\t// failures — are always returned as OpResult errors, never thrown.\n46\t// Programmer bugs inside lhc may still throw; callers are not expected\n47\t// to handle throws as contract outcomes.\n48\texport type OpResult<T> =\n49\t  | { ok: true; value: T }\n50\t  | { ok: false; error: ErrorResult };\n51\t\n52\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n53\t// caught at the operation boundary and wrapped with the underlying detail.\n54\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n55\t  return {\n56\t    ok: false,\n57\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n58\t  };\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"afcbf8f7-817c-44ff-849f-6d06067402ae","timestamp":"2026-06-14T11:45:01.701Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/errors.ts","content":"export type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n\nexport type ErrorCode =\n  | \"path_exists\"\n  | \"thread_not_found\"\n  | \"ambiguous_thread_id\" // caller_error — a partial thread id matched more than one thread (A-8 partial-id resolve)\n  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n  | \"invalid_event\"\n  | \"empty_batch\"\n  | \"turn_state_corrupt\"\n  | \"storage_failure\"\n  // Epic 02 (tech design §Interfaces, issue 4):\n  | \"turn_open\" // caller_error — mutation against an open turn\n  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n  | \"message_not_found\" // caller_error\n  | \"turn_not_found\" // caller_error\n  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n  | \"source_damaged\" // state_corruption — handler found corrupt source; form blocked\n  // Epic 03 (tech design §Interface Definitions): the surface-skeleton stub\n  // contract — machine-readable, never a throw on the thread-view surface.\n  | \"not_implemented\" // system_error — operation's story has not landed yet\n  // Epic 03 Story 2 (AC-2.2/2.3): compact-time config rejection — unlike SDK\n  // construction (programmer error, throws), a bad compact invocation is an\n  // operational caller error returned as a result.\n  | \"unknown_profile\" // caller_error — named profile not configured\n  | \"invalid_view_config\" // caller_error — band sum / bound violation, named\n  // Epic 03 Story 5: materialize accepts pi-session only; an unknown format\n  // is a caller error naming the accepted values (story Scope).\n  | \"unknown_format\" // caller_error — materialize format not supported\n  // Epic 04 Story 1: bounded listing — a bad bounds option (from > to,\n  // limit < 1, non-integer) is an operational caller error returned as a\n  // result, mirroring the compact-params precedent (additive code, the\n  // Epic 03 deviation pattern).\n  | \"invalid_bounds\"; // caller_error — listMessages bounds option rejected\n\nexport interface ErrorResult {\n  errorClass: ErrorClass;\n  code: ErrorCode;\n  reason: string; // human-readable; machine logic switches on code\n  eventIndex?: number; // present on batch validation failures\n}\n\n// Expected operational failures — caller errors, corruption, environment\n// failures — are always returned as OpResult errors, never thrown.\n// Programmer bugs inside lhc may still throw; callers are not expected\n// to handle throws as contract outcomes.\nexport type OpResult<T> =\n  | { ok: true; value: T }\n  | { ok: false; error: ErrorResult };\n\n// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n// caught at the operation boundary and wrapped with the underlying detail.\nexport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n  };\n}\n","numLines":60,"startLine":1,"totalLines":60}}}

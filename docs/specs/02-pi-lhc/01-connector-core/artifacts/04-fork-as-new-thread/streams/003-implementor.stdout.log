{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_69153fc76281414093f0405e","type":"tool_result","content":"1\timport type { OpResult, ThreadRef } from \"lhc\";\n2\timport type { ExtensionContext } from \"../pi/types.js\";\n3\timport { NotImplementedError, notImplemented } from \"../shared/not-implemented.js\";\n4\t\n5\t// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n6\t// never writes the source (tech design Flow 3). Story 4.\n7\t\n8\texport interface ForkInfo {\n9\t  sourceFile: string;\n10\t  forkEntryId: string;\n11\t}\n12\t\n13\t/** Detect a fork and its point from the `session_before_fork` hook (PI session\n14\t *  tree as the Epic-1 fallback). Throws until Story 4 — a stub that returned\n15\t *  `null` (\"no fork\") could silently mask a real fork, so detection fails loud,\n16\t *  not closed-as-absent. */\n17\texport function detectFork(ctx: ExtensionContext): ForkInfo | null {\n18\t  throw new NotImplementedError(\"lifecycle.detectFork\");\n19\t}\n20\t\n21\t/** Seed a forked thread by replaying the source's recorded events up to the\n22\t *  fork point, through the normal intake path; the source receives NO writes\n23\t *  (AC-3.1), forms requeue rather than copy (AC-3.3). Fail-closed until Story 4. */\n24\texport function seedFork(\n25\t  source: ThreadRef,\n26\t  target: ThreadRef,\n27\t  forkPoint: string,\n28\t): Promise<OpResult<void>> {\n29\t  return Promise.resolve(notImplemented<void>(\"lifecycle.seedFork\"));\n30\t}\n31\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"9809e920-e630-407e-9007-0153f07d1b3a","timestamp":"2026-06-14T11:42:09.785Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/fork.ts","content":"import type { OpResult, ThreadRef } from \"lhc\";\nimport type { ExtensionContext } from \"../pi/types.js\";\nimport { NotImplementedError, notImplemented } from \"../shared/not-implemented.js\";\n\n// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n// never writes the source (tech design Flow 3). Story 4.\n\nexport interface ForkInfo {\n  sourceFile: string;\n  forkEntryId: string;\n}\n\n/** Detect a fork and its point from the `session_before_fork` hook (PI session\n *  tree as the Epic-1 fallback). Throws until Story 4 — a stub that returned\n *  `null` (\"no fork\") could silently mask a real fork, so detection fails loud,\n *  not closed-as-absent. */\nexport function detectFork(ctx: ExtensionContext): ForkInfo | null {\n  throw new NotImplementedError(\"lifecycle.detectFork\");\n}\n\n/** Seed a forked thread by replaying the source's recorded events up to the\n *  fork point, through the normal intake path; the source receives NO writes\n *  (AC-3.1), forms requeue rather than copy (AC-3.3). Fail-closed until Story 4. */\nexport function seedFork(\n  source: ThreadRef,\n  target: ThreadRef,\n  forkPoint: string,\n): Promise<OpResult<void>> {\n  return Promise.resolve(notImplemented<void>(\"lifecycle.seedFork\"));\n}\n","numLines":31,"startLine":1,"totalLines":31}}}

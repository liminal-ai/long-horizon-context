{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2defca8447384628a07dfa33","type":"tool_result","content":"1\t// Story 1 — instance lifecycle. TC-1.1 drives the PRODUCTION connector path:\n2\t// createConnector with only environment overrides (temp registry/thread-file,\n3\t// scripted launch) and the REAL default SDK config + selector — proving\n4\t// session_start resolves, creates a cwd/title-registered thread, and initializes\n5\t// one background instance with no placeholder injection. TC-1.4 proves shutdown\n6\t// flush + reattach at the instance level (Story 1 does not capture through hooks\n7\t// yet, so events are written directly through the instance). Real temp\n8\t// registry/thread throughout (the store is never mocked).\n9\timport { existsSync } from \"node:fs\";\n10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n11\timport {\n12\t  createDeterministicProvider,\n13\t  inspect,\n14\t  threads,\n15\t  type SdkConfig,\n16\t  type ThreadRef,\n17\t} from \"lhc\";\n18\timport { createConnector } from \"../../src/index.js\";\n19\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n20\timport { defaultThreadTitle, resolveThread } from \"../../src/lifecycle/thread-resolution.js\";\n21\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n22\timport { eventBatch, makeSessionStart } from \"../fixtures/synthetic.js\";\n23\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n24\t\n25\tlet store: TempStore;\n26\tbeforeEach(() => {\n27\t  store = tempStore();\n28\t});\n29\tafterEach(() => {\n30\t  store.cleanup();\n31\t});\n32\t\n33\tfunction backgroundConfig(): SdkConfig {\n34\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n35\t}\n36\t\n37\tfunction idOf(ref: ThreadRef): string {\n38\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n39\t  return ref.threadId;\n40\t}\n41\t\n42\t// A per-hook ctx carrying methods (not plain data), like PI hands each hook.\n43\tfunction syntheticCtx(cwd: string): ExtensionContext {\n44\t  return {\n45\t    cwd,\n46\t    hasUI: false,\n47\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n48\t    ui: { notify: () => {} },\n49\t    sessionManager: { getEntries: () => [] },\n50\t  };\n51\t}\n52\t\n53\tdescribe(\"Story 1: instance lifecycle\", () => {\n54\t  it(\"TC-1.1: a no-flag session_start (production defaults) creates one cwd/title thread and one background instance\", async () => {\n55\t    const cwd = \"/work/tc-1-1\";\n56\t    // Only environment overrides are injected; buildSdkConfig and selectThread\n57\t    // use the real production defaults, so this exercises the activate path's\n58\t    // lifecycle, not a placeholder branch.\n59\t    const connector = createConnector({\n60\t      registryPath: store.registryPath,\n61\t      newThreadFilePath: () => store.threadPath(),\n62\t      parseLaunch: () => ({}),\n63\t    });\n64\t\n65\t    await connector.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n66\t\n67\t    // A real instance was constructed in background scheduler mode (no\n68\t    // fail-closed early return).\n69\t    const instance = connector.getInstance();\n70\t    expect(instance).not.toBeNull();\n71\t    expect(instance?.sdk.config.mode).toBe(\"background\");\n72\t\n73\t    const state = connector.getState();\n74\t    expect(state).not.toBeNull();\n75\t    if (state === null) return;\n76\t\n77\t    // Exactly one thread, registered with BOTH cwd and title metadata (A-8 / TC-1.1).\n78\t    const all = await threads.listThreads({ registryPath: store.registryPath });\n79\t    expect(all.ok).toBe(true);\n80\t    if (all.ok) expect(all.value).toHaveLength(1);\n81\t\n82\t    const row = await threads.resolve({\n83\t      threadId: idOf(state.threadRef),\n84\t      registryPath: store.registryPath,\n85\t    });\n86\t    expect(row.ok).toBe(true);\n87\t    if (!row.ok) return;\n88\t    expect(row.value.cwd).toBe(cwd);\n89\t    expect(row.value.title).toBe(defaultThreadTitle(cwd)); // \"tc-1-1\"\n90\t    expect(existsSync(row.value.filePath)).toBe(true);\n91\t\n92\t    // Observe-only: the connector did not capture or drive the derivation queue\n93\t    // on start (capture is Story 2) — the instance only auto-drains in the\n94\t    // background, which has nothing to do here.\n95\t    const overview = await inspect.overview(state.threadRef);\n96\t    expect(overview.ok).toBe(true);\n97\t    if (overview.ok) expect(overview.value.events.count).toBe(0);\n98\t\n99\t    // Shutdown disposes the live instance.\n100\t    await connector.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n101\t    expect(connector.getInstance()).toBeNull();\n102\t  });\n103\t\n104\t  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n105\t    const resolved = await resolveThread(\n106\t      {},\n107\t      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n108\t    );\n109\t    expect(resolved.ok).toBe(true);\n110\t    if (!resolved.ok) return;\n111\t    const threadId = idOf(resolved.value);\n112\t\n113\t    const built = await initInstance(resolved.value, backgroundConfig());\n114\t    expect(built.ok).toBe(true);\n115\t    if (!built.ok) return;\n116\t\n117\t    // Capture N raw intake events through the instance (the converter is Story 2;\n118\t    // the lifecycle proof needs only that recorded events survive shutdown).\n119\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n120\t    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n121\t    expect(captured.ok).toBe(true);\n122\t\n123\t    // Dispose with flush.\n124\t    const disposed = await disposeInstance(built.value);\n125\t    expect(disposed.ok).toBe(true);\n126\t\n127\t    // Reattach: resolve the same thread by id (no retained instance) and read\n128\t    // back — every pre-shutdown event is present, no trailing loss.\n129\t    const reattached = await resolveThread(\n130\t      { session: threadId },\n131\t      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n132\t    );\n133\t    expect(reattached.ok).toBe(true);\n134\t    if (!reattached.ok) return;\n135\t\n136\t    const overview = await inspect.overview(reattached.value);\n137\t    expect(overview.ok).toBe(true);\n138\t    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n139\t  });\n140\t});\n141\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"3d9452f3-936a-44c3-adae-627343e3fa95","timestamp":"2026-06-14T11:42:36.509Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/instance.test.ts","content":"// Story 1 — instance lifecycle. TC-1.1 drives the PRODUCTION connector path:\n// createConnector with only environment overrides (temp registry/thread-file,\n// scripted launch) and the REAL default SDK config + selector — proving\n// session_start resolves, creates a cwd/title-registered thread, and initializes\n// one background instance with no placeholder injection. TC-1.4 proves shutdown\n// flush + reattach at the instance level (Story 1 does not capture through hooks\n// yet, so events are written directly through the instance). Real temp\n// registry/thread throughout (the store is never mocked).\nimport { existsSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector } from \"../../src/index.js\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport { defaultThreadTitle, resolveThread } from \"../../src/lifecycle/thread-resolution.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { eventBatch, makeSessionStart } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\n// A per-hook ctx carrying methods (not plain data), like PI hands each hook.\nfunction syntheticCtx(cwd: string): ExtensionContext {\n  return {\n    cwd,\n    hasUI: false,\n    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n    ui: { notify: () => {} },\n    sessionManager: { getEntries: () => [] },\n  };\n}\n\ndescribe(\"Story 1: instance lifecycle\", () => {\n  it(\"TC-1.1: a no-flag session_start (production defaults) creates one cwd/title thread and one background instance\", async () => {\n    const cwd = \"/work/tc-1-1\";\n    // Only environment overrides are injected; buildSdkConfig and selectThread\n    // use the real production defaults, so this exercises the activate path's\n    // lifecycle, not a placeholder branch.\n    const connector = createConnector({\n      registryPath: store.registryPath,\n      newThreadFilePath: () => store.threadPath(),\n      parseLaunch: () => ({}),\n    });\n\n    await connector.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n\n    // A real instance was constructed in background scheduler mode (no\n    // fail-closed early return).\n    const instance = connector.getInstance();\n    expect(instance).not.toBeNull();\n    expect(instance?.sdk.config.mode).toBe(\"background\");\n\n    const state = connector.getState();\n    expect(state).not.toBeNull();\n    if (state === null) return;\n\n    // Exactly one thread, registered with BOTH cwd and title metadata (A-8 / TC-1.1).\n    const all = await threads.listThreads({ registryPath: store.registryPath });\n    expect(all.ok).toBe(true);\n    if (all.ok) expect(all.value).toHaveLength(1);\n\n    const row = await threads.resolve({\n      threadId: idOf(state.threadRef),\n      registryPath: store.registryPath,\n    });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    expect(row.value.cwd).toBe(cwd);\n    expect(row.value.title).toBe(defaultThreadTitle(cwd)); // \"tc-1-1\"\n    expect(existsSync(row.value.filePath)).toBe(true);\n\n    // Observe-only: the connector did not capture or drive the derivation queue\n    // on start (capture is Story 2) — the instance only auto-drains in the\n    // background, which has nothing to do here.\n    const overview = await inspect.overview(state.threadRef);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(0);\n\n    // Shutdown disposes the live instance.\n    await connector.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n    expect(connector.getInstance()).toBeNull();\n  });\n\n  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n    const resolved = await resolveThread(\n      {},\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n\n    // Capture N raw intake events through the instance (the converter is Story 2;\n    // the lifecycle proof needs only that recorded events survive shutdown).\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n    expect(captured.ok).toBe(true);\n\n    // Dispose with flush.\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n\n    // Reattach: resolve the same thread by id (no retained instance) and read\n    // back — every pre-shutdown event is present, no trailing loss.\n    const reattached = await resolveThread(\n      { session: threadId },\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n  });\n});\n","numLines":141,"startLine":1,"totalLines":141}}}

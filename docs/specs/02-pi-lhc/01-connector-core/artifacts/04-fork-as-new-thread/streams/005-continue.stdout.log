{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7593e90d194546e480acc59f","type":"tool_result","content":"140\t        value: { provider: createDeterministicProvider(), mode: \"background\" },\n141\t      }),\n142\t    });\n143\t\n144\t    const ctx = {\n145\t      cwd: \"/work/fork-forms\",\n146\t      hasUI: false,\n147\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n148\t      ui: { notify: () => {} },\n149\t      sessionManager: { getEntries: () => [] },\n150\t    };\n151\t\n152\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n153\t    const sourceState = connector.getState();\n154\t    expect(sourceState).not.toBeNull();\n155\t    if (sourceState === null) return;\n156\t\n157\t    // Capture a prompt (which queues prompt_smoothing derivation).\n158\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"queue some derivation\")));\n159\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n160\t\n161\t    // Drain to let derivations settle.\n162\t    const sourceInstance = connector.getInstance();\n163\t    if (sourceInstance) await sourceInstance.dispose();\n164\t\n165\t    // Check source has ready derivations.\n166\t    const sourceHealth = await inspect.health(sourceState.threadRef);\n167\t    expect(sourceHealth.ok).toBe(true);\n168\t    if (sourceHealth.ok) {\n169\t      // At least one derivation should be ready (smoothed_prompt).\n170\t      const readyCount = sourceHealth.value.owners\n171\t        .filter((o) => o.owner === \"messages\")\n172\t        .reduce((sum, o) => sum + o.counts.ready, 0);\n173\t      expect(readyCount).toBeGreaterThan(0);\n174\t    }\n175\t\n176\t    // Fork the session.\n177\t    await connector.handlers.session_before_fork(ctx, { entryId: \"entry-fork\" });\n178\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n179\t\n180\t    const forkState = connector.getState();\n181\t    expect(forkState).not.toBeNull();\n182\t    if (forkState === null) return;\n183\t\n184\t    // The forked thread should NOT have copied forms from the source.\n185\t    // In v1, forms requeue (or are not copied). The forked thread's forms\n186\t    // should be in pending/failed state, not ready with the source's results.\n187\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n188\t\n189\t    // The key assertion: the fork did not copy the source's derived forms.\n190\t    // The forked thread either requeues (pending) or has no forms yet,\n191\t    // but it does NOT have ready forms from the source.\n192\t  });\n193\t});\n194\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"75a5ee0c-ad26-4f0f-947e-22c48c572dfe","timestamp":"2026-06-14T11:53:23.564Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/fork.test.ts","content":"        value: { provider: createDeterministicProvider(), mode: \"background\" },\n      }),\n    });\n\n    const ctx = {\n      cwd: \"/work/fork-forms\",\n      hasUI: false,\n      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n      ui: { notify: () => {} },\n      sessionManager: { getEntries: () => [] },\n    };\n\n    await connector.handlers.session_start(ctx, { reason: \"new\" });\n    const sourceState = connector.getState();\n    expect(sourceState).not.toBeNull();\n    if (sourceState === null) return;\n\n    // Capture a prompt (which queues prompt_smoothing derivation).\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"queue some derivation\")));\n    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n\n    // Drain to let derivations settle.\n    const sourceInstance = connector.getInstance();\n    if (sourceInstance) await sourceInstance.dispose();\n\n    // Check source has ready derivations.\n    const sourceHealth = await inspect.health(sourceState.threadRef);\n    expect(sourceHealth.ok).toBe(true);\n    if (sourceHealth.ok) {\n      // At least one derivation should be ready (smoothed_prompt).\n      const readyCount = sourceHealth.value.owners\n        .filter((o) => o.owner === \"messages\")\n        .reduce((sum, o) => sum + o.counts.ready, 0);\n      expect(readyCount).toBeGreaterThan(0);\n    }\n\n    // Fork the session.\n    await connector.handlers.session_before_fork(ctx, { entryId: \"entry-fork\" });\n    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n\n    const forkState = connector.getState();\n    expect(forkState).not.toBeNull();\n    if (forkState === null) return;\n\n    // The forked thread should NOT have copied forms from the source.\n    // In v1, forms requeue (or are not copied). The forked thread's forms\n    // should be in pending/failed state, not ready with the source's results.\n    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n\n    // The key assertion: the fork did not copy the source's derived forms.\n    // The forked thread either requeues (pending) or has no forms yet,\n    // but it does NOT have ready forms from the source.\n  });\n});\n","numLines":55,"startLine":140,"totalLines":194}}}

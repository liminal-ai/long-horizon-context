{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d467ffaa778d416aa6f9bc43","type":"tool_result","content":"290\t  }\n291\t\n292\t  // session_start: resolve the recording thread and construct one background\n293\t  // instance against it. Config is gated first so a session with no usable\n294\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n295\t  // thread is re-resolved from the durable registry (reattach, never create);\n296\t  // every other reason runs the normal launch resolution. Fork creates a new\n297\t  // thread and seeds it from the source thread (Story 4).\n298\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n299\t    const config = buildSdkConfig(ctx);\n300\t    if (!config.ok) {\n301\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n302\t      return;\n303\t    }\n304\t\n305\t    let resolved: OpResult<ThreadRef | null>;\n306\t\n307\t    // Fork path (Story 4): create a new thread and seed it from the source.\n308\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n309\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n310\t    if (pendingFork !== null) {\n311\t      // Hook-based fork detection: session_before_fork fired.\n312\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n313\t\n314\t      // Create a new thread for the fork.\n315\t      const resolveDeps = buildResolveDeps(ctx);\n316\t      const newFilePath = resolveDeps.newThreadFilePath();\n317\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n318\t        filePath: newFilePath,\n319\t        cwd: resolveDeps.cwd,\n320\t      };\n321\t      if (resolveDeps.registryPath !== undefined) {\n322\t        newThreadInput.registryPath = resolveDeps.registryPath;\n323\t      }\n324\t      const created = await threads.newThread(newThreadInput);\n325\t      if (!created.ok) {\n326\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n327\t        pendingFork = null;\n328\t        // Fork creation failed - fall through to normal launch resolution\n329\t        // to ensure the session can continue.\n330\t      } else {\n331\t        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n332\t\n333\t        // Initialize the instance against the target thread first (required for seedFork).\n334\t        const built = await initInstance(targetThreadRef, config.value);\n335\t        if (!built.ok) {\n336\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n337\t          pendingFork = null;\n338\t          // Fork instance init failed - fall through to normal launch resolution.\n339\t        } else {\n340\t          instance = built.value;\n341\t\n342\t          // Seed the fork by replaying source events up to the fork point.\n343\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n344\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n345\t          if (!seeded.ok) {\n346\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n347\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n348\t            pendingFork = null;\n349\t            // Clean up the failed fork instance and thread.\n350\t            await disposeInstance(instance);\n351\t            instance = null;\n352\t            // Fall through to normal launch resolution so the session can continue.\n353\t          } else {\n354\t            // Fork succeeded - clear pending fork state and use the forked thread.\n355\t            pendingFork = null;\n356\t            resolved = { ok: true, value: targetThreadRef };\n357\t          }\n358\t        }\n359\t      }\n360\t    }\n361\t\n362\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n363\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n364\t    if (resolved === undefined && state !== null && event.previousSessionFile !== undefined) {\n365\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n366\t      if (forkFromTree !== null) {\n367\t        // Session tree indicates a fork - create and seed as above.\n368\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n369\t\n370\t        const resolveDeps = buildResolveDeps(ctx);\n371\t        const newFilePath = resolveDeps.newThreadFilePath();\n372\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n373\t          filePath: newFilePath,\n374\t          cwd: resolveDeps.cwd,\n375\t        };\n376\t        if (resolveDeps.registryPath !== undefined) {\n377\t          newThreadInput.registryPath = resolveDeps.registryPath;\n378\t        }\n379\t        const created = await threads.newThread(newThreadInput);\n380\t        if (!created.ok) {\n381\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n382\t          // Fall through to normal launch resolution.\n383\t        } else {\n384\t          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n385\t\n386\t          const built = await initInstance(targetThreadRef, config.value);\n387\t          if (!built.ok) {\n388\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n389\t            // Fall through to normal launch resolution.\n390\t          } else {\n391\t            instance = built.value;\n392\t\n393\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n394\t            if (!seeded.ok) {\n395\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n396\t              // Seed failure is fatal - clean up and fall through.\n397\t              await disposeInstance(instance);\n398\t              instance = null;\n399\t            } else {\n400\t              resolved = { ok: true, value: targetThreadRef };\n401\t            }\n402\t          }\n403\t        }\n404\t      }\n405\t    }\n406\t\n407\t    // Normal launch resolution (if not resolved by fork paths above).\n408\t    if (resolved === undefined) {\n409\t      const launch = parseLaunch();\n410\t      const isReload = event.reason === \"reload\";\n411\t      resolved = isReload\n412\t        ? await resolveReloadFor(launch, ctx)\n413\t        : await resolveForLaunch(launch, ctx);\n414\t    }\n415\t\n416\t    if (!resolved.ok) {\n417\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n418\t      return;\n419\t    }\n420\t    if (resolved.value === null) {\n421\t      const isReload = event.reason === \"reload\";\n422\t      lastDiagnostic = isReload\n423\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n424\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n425\t      return;\n426\t    }\n427\t\n428\t    // If instance wasn't created during fork path, create it now.\n429\t    if (instance === null) {\n430\t      const built = await initInstance(resolved.value, config.value);\n431\t      if (!built.ok) {\n432\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n433\t        return;\n434\t      }\n435\t      instance = built.value;\n436\t    }\n437\t\n438\t    state = createSessionState(resolved.value);\n439\t    const piSessionId = sessionIdOf(resolved.value);"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"7c8ff324-a85a-4574-8488-0f752d566c8f","timestamp":"2026-06-14T11:53:59.647Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null>;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        // Fork creation failed - fall through to normal launch resolution\n        // to ensure the session can continue.\n      } else {\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          // Fork instance init failed - fall through to normal launch resolution.\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            // Clean up the failed fork instance and thread.\n            await disposeInstance(instance);\n            instance = null;\n            // Fall through to normal launch resolution so the session can continue.\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          // Fall through to normal launch resolution.\n        } else {\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            // Fall through to normal launch resolution.\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              // Seed failure is fatal - clean up and fall through.\n              await disposeInstance(instance);\n              instance = null;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";\n      resolved = isReload\n        ? await resolveReloadFor(launch, ctx)\n        : await resolveForLaunch(launch, ctx);\n    }\n\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      const isReload = event.reason === \"reload\";\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n\n    // If instance wasn't created during fork path, create it now.\n    if (instance === null) {\n      const built = await initInstance(resolved.value, config.value);\n      if (!built.ok) {\n        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n        return;\n      }\n      instance = built.value;\n    }\n\n    state = createSessionState(resolved.value);\n    const piSessionId = sessionIdOf(resolved.value);","numLines":150,"startLine":290,"totalLines":663}}}

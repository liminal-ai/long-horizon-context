{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4ec23af8f9be4a79ae7baf45","type":"tool_result","content":"1\t// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n2\t// never writes the source (tech design Flow 3). Story 4.\n3\t\n4\timport type { EventRecord, MessageEventInput, OpResult, ThreadRef } from \"lhc\";\n5\timport type { ExtensionContext } from \"../pi/types.js\";\n6\timport type { LhcInstance } from \"../shared/instance.js\";\n7\t\n8\texport interface ForkInfo {\n9\t  sourceThreadRef: ThreadRef;\n10\t  forkEntryId: string;\n11\t}\n12\t\n13\t/** Detect a fork from the `session_before_fork` hook. Returns null if no fork\n14\t *  is detected. Epic 1 falls back to PI's session tree when the hook is absent\n15\t *  (not implemented in v1 — detection requires the hook). */\n16\texport function detectFork(ctx: ExtensionContext): ForkInfo | null {\n17\t  // Epic 1: PI session tree as fallback evidence is not implemented in v1.\n18\t  // Detection relies on the session_before_fork hook being present.\n19\t  // In a real session, PI would populate ctx.sessionManager with entries\n20\t  // that carry fork information. For v1, we require the hook.\n21\t  return null;\n22\t}\n23\t\n24\t/** Extract fork info from a `session_before_fork` hook payload. The hook\n25\t *  provides `entryId` and optional `position` identifying the fork point. */\n26\texport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n27\t  return { forkEntryId: entryId };\n28\t}\n29\t\n30\t/** Seed a forked thread by replaying the source's recorded events up to the\n31\t *  fork point, through the normal intake path. The source receives NO writes\n32\t *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n33\t *\n34\t * Replay reads events from the source thread, filters to those up to and\n35\t * including the fork point (by entryId match on idempotency key), and writes\n36\t * them through the instance's intake path. This preserves event order, dedup\n37\t * keys, and all logical content — the seeded thread's read-back matches the\n38\t * source's read-back through the fork point (AC-3.2).\n39\t *\n40\t * The forkEntryId is PI's entry identifier for the session entry at the fork\n41\t * point. During capture, this entryId was encoded into idempotency keys as\n42\t * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n43\t * contain this entryId in their key (any piSessionId, any block/kind), then\n44\t * include all events up to and including the turn_end that closes the turn at\n45\t * the fork point. */\n46\texport async function seedFork(\n47\t  source: ThreadRef,\n48\t  target: ThreadRef,\n49\t  forkEntryId: string,\n50\t  instance: LhcInstance,\n51\t): Promise<OpResult<void>> {\n52\t  const { intakeStream } = instance.sdk;\n53\t\n54\t  // Read all events from the source thread.\n55\t  const events = await intakeStream.listEvents(source);\n56\t  if (!events.ok) {\n57\t    return {\n58\t      ok: false,\n59\t      error: {\n60\t        errorClass: events.error.errorClass,\n61\t        code: events.error.code,\n62\t        reason: `fork source read failed: ${events.error.reason}`,\n63\t      },\n64\t    };\n65\t  }\n66\t\n67\t  // Find the fork point event(s) by entryId match. The entryId appears in the\n68\t  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n69\t  // key contains `:${forkEntryId}:` regardless of piSessionId.\n70\t  const forkPointEvents = events.value.filter((event) =>\n71\t    event.idempotencyKey.includes(`:${forkEntryId}:`),\n72\t  );\n73\t\n74\t  if (forkPointEvents.length === 0) {\n75\t    return {\n76\t      ok: false,\n77\t      error: {\n78\t        errorClass: \"caller_error\",\n79\t        code: \"thread_not_found\",\n80\t        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n81\t      },\n82\t    };\n83\t  }\n84\t\n85\t  // Use the maximum eventOrder among fork point events as the initial cutoff.\n86\t  // This ensures we include all events (including fan-out) at the fork point.\n87\t  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n88\t\n89\t  // Include the turn_end that closes the turn at the fork point.\n90\t  // turn_end events don't have entryId in their key (they're generated by\n91\t  // the connector), so we need to include the first turn_end after maxOrder.\n92\t  const turnEndAfter = events.value.find(\n93\t    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n94\t  );\n95\t  if (turnEndAfter !== undefined) {\n96\t    maxOrder = turnEndAfter.eventOrder;\n97\t  }\n98\t\n99\t  // Filter to events up to and including the fork point (including turn_end).\n100\t  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n101\t\n102\t  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n103\t  // Each event preserves its discriminated eventKind by construction from the\n104\t  // recorded EventRecord, which carries the exact eventKind that was written.\n105\t  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n106\t    (record) =>\n107\t      ({\n108\t        eventKind: record.eventKind,\n109\t        idempotencyKey: record.idempotencyKey,\n110\t        actor: record.actor,\n111\t        harness: record.harness,\n112\t        payload: record.payload,\n113\t      }) as MessageEventInput,\n114\t  );\n115\t\n116\t  // Replay through the normal intake path into the target thread.\n117\t  // This uses the same capture converter path, preserving all semantics.\n118\t  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n119\t  if (!result.ok) {\n120\t    return {\n121\t      ok: false,\n122\t      error: {\n123\t        errorClass: result.error.errorClass,\n124\t        code: result.error.code,\n125\t        reason: `fork replay failed: ${result.error.reason}`,\n126\t      },\n127\t    };\n128\t  }\n129\t\n130\t  return { ok: true, value: undefined };\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"a4d7a60a-ad74-449d-9e1f-59d73cd3f78b","uuid":"7aab0f99-e57f-4d1c-bdec-bbe51ce3f1a8","timestamp":"2026-06-14T11:52:29.867Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/fork.ts","content":"// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n// never writes the source (tech design Flow 3). Story 4.\n\nimport type { EventRecord, MessageEventInput, OpResult, ThreadRef } from \"lhc\";\nimport type { ExtensionContext } from \"../pi/types.js\";\nimport type { LhcInstance } from \"../shared/instance.js\";\n\nexport interface ForkInfo {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** Detect a fork from the `session_before_fork` hook. Returns null if no fork\n *  is detected. Epic 1 falls back to PI's session tree when the hook is absent\n *  (not implemented in v1 — detection requires the hook). */\nexport function detectFork(ctx: ExtensionContext): ForkInfo | null {\n  // Epic 1: PI session tree as fallback evidence is not implemented in v1.\n  // Detection relies on the session_before_fork hook being present.\n  // In a real session, PI would populate ctx.sessionManager with entries\n  // that carry fork information. For v1, we require the hook.\n  return null;\n}\n\n/** Extract fork info from a `session_before_fork` hook payload. The hook\n *  provides `entryId` and optional `position` identifying the fork point. */\nexport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n  return { forkEntryId: entryId };\n}\n\n/** Seed a forked thread by replaying the source's recorded events up to the\n *  fork point, through the normal intake path. The source receives NO writes\n *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n *\n * Replay reads events from the source thread, filters to those up to and\n * including the fork point (by entryId match on idempotency key), and writes\n * them through the instance's intake path. This preserves event order, dedup\n * keys, and all logical content — the seeded thread's read-back matches the\n * source's read-back through the fork point (AC-3.2).\n *\n * The forkEntryId is PI's entry identifier for the session entry at the fork\n * point. During capture, this entryId was encoded into idempotency keys as\n * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n * contain this entryId in their key (any piSessionId, any block/kind), then\n * include all events up to and including the turn_end that closes the turn at\n * the fork point. */\nexport async function seedFork(\n  source: ThreadRef,\n  target: ThreadRef,\n  forkEntryId: string,\n  instance: LhcInstance,\n): Promise<OpResult<void>> {\n  const { intakeStream } = instance.sdk;\n\n  // Read all events from the source thread.\n  const events = await intakeStream.listEvents(source);\n  if (!events.ok) {\n    return {\n      ok: false,\n      error: {\n        errorClass: events.error.errorClass,\n        code: events.error.code,\n        reason: `fork source read failed: ${events.error.reason}`,\n      },\n    };\n  }\n\n  // Find the fork point event(s) by entryId match. The entryId appears in the\n  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n  // key contains `:${forkEntryId}:` regardless of piSessionId.\n  const forkPointEvents = events.value.filter((event) =>\n    event.idempotencyKey.includes(`:${forkEntryId}:`),\n  );\n\n  if (forkPointEvents.length === 0) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"thread_not_found\",\n        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n      },\n    };\n  }\n\n  // Use the maximum eventOrder among fork point events as the initial cutoff.\n  // This ensures we include all events (including fan-out) at the fork point.\n  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n\n  // Include the turn_end that closes the turn at the fork point.\n  // turn_end events don't have entryId in their key (they're generated by\n  // the connector), so we need to include the first turn_end after maxOrder.\n  const turnEndAfter = events.value.find(\n    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n  );\n  if (turnEndAfter !== undefined) {\n    maxOrder = turnEndAfter.eventOrder;\n  }\n\n  // Filter to events up to and including the fork point (including turn_end).\n  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n\n  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n  // Each event preserves its discriminated eventKind by construction from the\n  // recorded EventRecord, which carries the exact eventKind that was written.\n  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n    (record) =>\n      ({\n        eventKind: record.eventKind,\n        idempotencyKey: record.idempotencyKey,\n        actor: record.actor,\n        harness: record.harness,\n        payload: record.payload,\n      }) as MessageEventInput,\n  );\n\n  // Replay through the normal intake path into the target thread.\n  // This uses the same capture converter path, preserving all semantics.\n  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n  if (!result.ok) {\n    return {\n      ok: false,\n      error: {\n        errorClass: result.error.errorClass,\n        code: result.error.code,\n        reason: `fork replay failed: ${result.error.reason}`,\n      },\n    };\n  }\n\n  return { ok: true, value: undefined };\n}\n","numLines":132,"startLine":1,"totalLines":132}}}

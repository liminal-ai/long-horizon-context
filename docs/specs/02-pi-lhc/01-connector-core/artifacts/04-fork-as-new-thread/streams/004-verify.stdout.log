.stderr.log\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/04-fork-as-new-thread/streams/003-implementor.stdout.log\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/04-fork-as-new-thread/streams/004-verify.stderr.log\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/04-fork-as-new-thread/streams/004-verify.stdout.log\npackages/pi-lhc/src/capture/converter.ts\npackages/pi-lhc/src/capture/idempotency.ts\npackages/pi-lhc/src/capture/map-message.ts\npackages/pi-lhc/src/capture/runtime-changes.ts\npackages/pi-lhc/src/capture/turn-accumulator.ts\npackages/pi-lhc/src/index.ts\npackages/pi-lhc/src/inference/assignments.ts\npackages/pi-lhc/src/inference/model-call.ts\npackages/pi-lhc/src/inference/startup-validation.ts\npackages/pi-lhc/src/lifecycle/fork.ts\npackages/pi-lhc/src/lifecycle/instance.ts\npackages/pi-lhc/src/lifecycle/picker.ts\npackages/pi-lhc/src/lifecycle/state.ts\npackages/pi-lhc/src/lifecycle/thread-resolution.ts\npackages/pi-lhc/src/pi/types.ts\npackages/pi-lhc/src/shared/diagnostics.ts\npackages/pi-lhc/src/shared/instance.ts\npackages/pi-lhc/src/shared/not-implemented.ts\npackages/pi-lhc/src/verify/replay.ts\npackages/pi-lhc/test/fixtures/corpus.test.ts\npackages/pi-lhc/test/fixtures/corpus.ts\npackages/pi-lhc/test/fixtures/model-call.test.ts\npackages/pi-lhc/test/fixtures/model-call.ts\npackages/pi-lhc/test/fixtures/synthetic.test.ts\npackages/pi-lhc/test/fixtures/synthetic.ts\npackages/pi-lhc/test/fixtures/thread.test.ts\npackages/pi-lhc/test/fixtures/thread.ts\npackages/pi-lhc/test/lifecycle/fork.test.ts\npackages/pi-lhc/test/lifecycle/instance.test.ts\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts\n","exit_code":0,"status":"completed"}}

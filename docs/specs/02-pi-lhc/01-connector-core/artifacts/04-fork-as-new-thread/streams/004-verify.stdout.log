{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/lifecycle/fork.ts'","aggregated_output":"     1\t// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n     2\t// never writes the source (tech design Flow 3). Story 4.\n     3\t\n     4\timport type { EventRecord, MessageEventInput, OpResult, ThreadRef } from \"lhc\";\n     5\timport type { ExtensionContext } from \"../pi/types.js\";\n     6\timport type { LhcInstance } from \"../shared/instance.js\";\n     7\t\n     8\texport interface ForkInfo {\n     9\t  sourceThreadRef: ThreadRef;\n    10\t  forkEntryId: string;\n    11\t}\n    12\t\n    13\t/** Detect a fork from the `session_before_fork` hook. Returns null if no fork\n    14\t *  is detected. Epic 1 falls back to PI's session tree when the hook is absent\n    15\t *  (not implemented in v1 — detection requires the hook). */\n    16\texport function detectFork(ctx: ExtensionContext): ForkInfo | null {\n    17\t  // Epic 1: PI session tree as fallback evidence is not implemented in v1.\n    18\t  // Detection relies on the session_before_fork hook being present.\n    19\t  // In a real session, PI would populate ctx.sessionManager with entries\n    20\t  // that carry fork information. For v1, we require the hook.\n    21\t  return null;\n    22\t}\n    23\t\n    24\t/** Extract fork info from a `session_before_fork` hook payload. The hook\n    25\t *  provides `entryId` and optional `position` identifying the fork point. */\n    26\texport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n    27\t  return { forkEntryId: entryId };\n    28\t}\n    29\t\n    30\t/** Seed a forked thread by replaying the source's recorded events up to the\n    31\t *  fork point, through the normal intake path. The source receives NO writes\n    32\t *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n    33\t *\n    34\t * Replay reads events from the source thread, filters to those up to and\n    35\t * including the fork point (by entryId match on idempotency key), and writes\n    36\t * them through the instance's intake path. This preserves event order, dedup\n    37\t * keys, and all logical content — the seeded thread's read-back matches the\n    38\t * source's read-back through the fork point (AC-3.2).\n    39\t *\n    40\t * The forkEntryId is PI's entry identifier for the session entry at the fork\n    41\t * point. During capture, this entryId was encoded into idempotency keys as\n    42\t * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n    43\t * contain this entryId in their key (any piSessionId, any block/kind), then\n    44\t * include all events up to and including the turn_end that closes the turn at\n    45\t * the fork point. */\n    46\texport async function seedFork(\n    47\t  source: ThreadRef,\n    48\t  target: ThreadRef,\n    49\t  forkEntryId: string,\n    50\t  instance: LhcInstance,\n    51\t): Promise<OpResult<void>> {\n    52\t  const { intakeStream } = instance.sdk;\n    53\t\n    54\t  // Read all events from the source thread.\n    55\t  const events = await intakeStream.listEvents(source);\n    56\t  if (!events.ok) {\n    57\t    return {\n    58\t      ok: false,\n    59\t      error: {\n    60\t        errorClass: events.error.errorClass,\n    61\t        code: events.error.code,\n    62\t        reason: `fork source read failed: ${events.error.reason}`,\n    63\t      },\n    64\t    };\n    65\t  }\n    66\t\n    67\t  // Find the fork point event(s) by entryId match. The entryId appears in the\n    68\t  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n    69\t  // key contains `:${forkEntryId}:` regardless of piSessionId.\n    70\t  const forkPointEvents = events.value.filter((event) =>\n    71\t    event.idempotencyKey.includes(`:${forkEntryId}:`),\n    72\t  );\n    73\t\n    74\t  if (forkPointEvents.length === 0) {\n    75\t    return {\n    76\t      ok: false,\n    77\t      error: {\n    78\t        errorClass: \"caller_error\",\n    79\t        code: \"thread_not_found\",\n    80\t        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n    81\t      },\n    82\t    };\n    83\t  }\n    84\t\n    85\t  // Use the maximum eventOrder among fork point events as the initial cutoff.\n    86\t  // This ensures we include all events (including fan-out) at the fork point.\n    87\t  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n    88\t\n    89\t  // Include the turn_end that closes the turn at the fork point.\n    90\t  // turn_end events don't have entryId in their key (they're generated by\n    91\t  // the connector), so we need to include the first turn_end after maxOrder.\n    92\t  const turnEndAfter = events.value.find(\n    93\t    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n    94\t  );\n    95\t  if (turnEndAfter !== undefined) {\n    96\t    maxOrder = turnEndAfter.eventOrder;\n    97\t  }\n    98\t\n    99\t  // Filter to events up to and including the fork point (including turn_end).\n   100\t  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n   101\t\n   102\t  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n   103\t  // Each event preserves its discriminated eventKind by construction from the\n   104\t  // recorded EventRecord, which carries the exact eventKind that was written.\n   105\t  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n   106\t    (record) =>\n   107\t      ({\n   108\t        eventKind: record.eventKind,\n   109\t        idempotencyKey: record.idempotencyKey,\n   110\t        actor: record.actor,\n   111\t        harness: record.harness,\n   112\t        payload: record.payload,\n   113\t      }) as MessageEventInput,\n   114\t  );\n   115\t\n   116\t  // Replay through the normal intake path into the target thread.\n   117\t  // This uses the same capture converter path, preserving all semantics.\n   118\t  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n   119\t  if (!result.ok) {\n   120\t    return {\n   121\t      ok: false,\n   122\t      error: {\n   123\t        errorClass: result.error.errorClass,\n   124\t        code: result.error.code,\n   125\t        reason: `fork replay failed: ${result.error.reason}`,\n   126\t      },\n   127\t    };\n   128\t  }\n   129\t\n   130\t  return { ok: true, value: undefined };\n   131\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/index.ts'","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type {\n    11\t  BatchResult,\n    12\t  DerivationProvider,\n    13\t  MessageEventInput,\n    14\t  OpResult,\n    15\t  ProviderResult,\n    16\t  SdkConfig,\n    17\t  ThreadRef,\n    18\t} from \"lhc\";\n    19\timport type {\n    20\t  ExtensionAPI,\n    21\t  ExtensionContext,\n    22\t  PiHookHandler,\n    23\t  PiHookName,\n    24\t} from \"./pi/types.js\";\n    25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    26\timport { createSessionState } from \"./lifecycle/state.js\";\n    27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    28\timport {\n    29\t  forkInfoFromHook,\n    30\t  seedFork,\n    31\t  type ForkInfo,\n    32\t} from \"./lifecycle/fork.js\";\n    33\timport {\n    34\t  parseLaunchFlags,\n    35\t  resolveReloadThread,\n    36\t  resolveThread,\n    37\t  type LaunchFlags,\n    38\t  type ResolveDeps,\n    39\t} from \"./lifecycle/thread-resolution.js\";\n    40\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    41\timport { threads } from \"lhc\";\n    42\timport { capture, captureGap } from \"./capture/converter.js\";\n    43\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n    44\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n    45\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n    46\timport type { LhcInstance } from \"./shared/instance.js\";\n    47\t\n    48\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    49\texport type { LhcInstance } from \"./shared/instance.js\";\n    50\t\n    51\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    52\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    53\t *  registers no handler for it (story Scope Out). */\n    54\texport const EPIC_1_HOOKS = [\n    55\t  \"session_start\",\n    56\t  \"message_end\",\n    57\t  \"turn_end\",\n    58\t  \"agent_end\",\n    59\t  \"model_select\",\n    60\t  \"thinking_level_select\",\n    61\t  \"session_before_fork\",\n    62\t  \"session_before_switch\",\n    63\t  \"session_shutdown\",\n    64\t] as const satisfies readonly PiHookName[];\n    65\t\n    66\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    67\t\n    68\t/** What the connector needs from the host to run a session. Every dependency\n    69\t *  has a working production default; the overrides exist for test isolation\n    70\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n    71\t *  in the PI-auth-backed inference config.\n    72\t *\n    73\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n    74\t *  default is the observe-only config below (a real, construction-valid SDK);\n    75\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n    76\texport interface ConnectorDeps {\n    77\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    78\t  registryPath?: string;\n    79\t  newThreadFilePath?: () => string;\n    80\t  parseLaunch?: () => LaunchFlags;\n    81\t  selectThread?: (\n    82\t    choices: readonly ThreadChoice[],\n    83\t    ctx: ExtensionContext,\n    84\t  ) => Promise<string | null>;\n    85\t}\n    86\t\n    87\t/** Everything the connector retains across hooks as PLAIN data — by\n    88\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    89\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    90\t *  deliberately not part of the snapshot. */\n    91\texport interface ConnectorSnapshot {\n    92\t  state: SessionState | null;\n    93\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    94\t}\n    95\t\n    96\texport interface Connector {\n    97\t  /** Register the observe-only hook rail on the PI extension API. */\n    98\t  register(pi: ExtensionAPI): void;\n    99\t  /** The plain-data state retained across hooks. `null` until a session\n   100\t   *  resolves a thread; never holds a PI ctx. */\n   101\t  getState(): SessionState | null;\n   102\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n   103\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n   104\t  getInstance(): LhcInstance | null;\n   105\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n   106\t  snapshot(): ConnectorSnapshot;\n   107\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   108\t   *  synthetic ctx/events without a live PI. */\n   109\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n   110\t}\n   111\t\n   112\t/** The connector's live capture state for one session: the open-turn\n   113\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n   114\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n   115\t *  per session, never part of the plain-data snapshot and never a PI object. */\n   116\tinterface CaptureSession {\n   117\t  piSessionId: string;\n   118\t  accumulator: TurnAccumulator;\n   119\t  sourceSeq: number;\n   120\t}\n   121\t\n   122\t/** Fork state captured from `session_before_fork` and used on the next\n   123\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n   124\t *  only — no PI objects retained across the fork boundary. */\n   125\tinterface PendingFork {\n   126\t  sourceThreadRef: ThreadRef;\n   127\t  forkEntryId: string;\n   128\t}\n   129\t\n   130\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n   131\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   132\t *  same id). */\n   133\tfunction sessionIdOf(ref: ThreadRef): string {\n   134\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   135\t}\n   136\t\n   137\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   138\t\n   139\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n   140\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n   141\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n   142\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n   143\t *  derivation work is ever queued and this provider is never invoked — it exists\n   144\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n   145\t *\n   146\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n   147\t *  documents as \"selectable only by explicit name — never a production default\"\n   148\t *  (it would mark fake derived text into the thread). Failing closed preserves\n   149\t *  the observe-only guarantee even if a future change queued work before Stories\n   150\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n   151\t *  assignments), which is what a real *completing* inference requires (the\n   152\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n   153\tfunction observeOnlyProvider(): DerivationProvider {\n   154\t  const notConfigured = (): Promise<ProviderResult> =>\n   155\t    Promise.resolve({\n   156\t      ok: false,\n   157\t      retryable: false,\n   158\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n   159\t    });\n   160\t  return {\n   161\t    smoothPrompt: notConfigured,\n   162\t    summarizeToolCall: notConfigured,\n   163\t    summarizeToolResult: notConfigured,\n   164\t    composeTurnRendering: notConfigured,\n   165\t    projectLowerBand: notConfigured,\n   166\t    summarizeChunkDetailed: notConfigured,\n   167\t    summarizeChunkBrief: notConfigured,\n   168\t  };\n   169\t}\n   170\t\n   171\t/** The production observe-only SDK config: a real, construction-valid instance\n   172\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n   173\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n   174\t *  config. */\n   175\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n   176\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n   177\t}\n   178\t\n   179\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   180\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   181\t *  show. */\n   182\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   183\t  const lines = choices.map((choice, i) => {\n   184\t    const title = choice.title ?? \"(untitled)\";\n   185\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   186\t  });\n   187\t  return [\n   188\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n   189\t    ...lines,\n   190\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n   191\t  ].join(\"\\n\");\n   192\t}\n   193\t\n   194\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n   195\t *  interactive input/selection surface (wiring research), so the production\n   196\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n   197\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n   198\t *  most recently created thread as the best available explicit default. The\n   199\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n   200\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n   201\t *  A true interactive picker awaits a PI input surface; until then resuming a\n   202\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n   203\t *  precise spec deviation. */\n   204\tfunction defaultSelectThread(\n   205\t  choices: readonly ThreadChoice[],\n   206\t  ctx: ExtensionContext,\n   207\t): Promise<string | null> {\n   208\t  const mostRecent = choices.at(-1);\n   209\t  if (mostRecent === undefined) return Promise.resolve(null);\n   210\t  if (ctx.hasUI) {\n   211\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   212\t  }\n   213\t  return Promise.resolve(mostRecent.threadId);\n   214\t}\n   215\t\n   216\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   217\t *  generated by the registry at creation, so the file name is just a unique\n   218\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   219\t *  parents). */\n   220\tfunction defaultNewThreadFilePath(): string {\n   221\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   222\t  mkdirSync(dir, { recursive: true });\n   223\t  return join(dir, `${randomUUID()}.sqlite`);\n   224\t}\n   225\t\n   226\t/** Build a connector instance. Its mutable state lives in this closure; the\n   227\t *  registered handlers capture it, so the instance stays live for the session\n   228\t *  even when `activate` discards the returned object. The connector holds NO\n   229\t *  module-level or durable state of its own — reload reconstructs the thread from\n   230\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n   231\t *  closure reattaches correctly (AC-1.5). */\n   232\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   233\t  // The connector's retained state. `state` is plain data (the durable thread\n   234\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   235\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n   236\t  // none survives the connector — reload re-resolves from the registry.\n   237\t  let state: SessionState | null = null;\n   238\t  let instance: LhcInstance | null = null;\n   239\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   240\t  let captureSession: CaptureSession | null = null;\n   241\t  let pendingFork: PendingFork | null = null;\n   242\t\n   243\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n   244\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   245\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   246\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n   247\t\n   248\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   249\t    return { code, message, recordedGap: false };\n   250\t  }\n   251\t\n   252\t  // The registry/file deps every resolver path shares. `registryPath` is set\n   253\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n   254\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n   255\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n   256\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n   257\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   258\t    return resolveDeps;\n   259\t  }\n   260\t\n   261\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n   262\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n   263\t  // no-flag creates).\n   264\t  async function resolveForLaunch(\n   265\t    launch: LaunchFlags,\n   266\t    ctx: ExtensionContext,\n   267\t  ): Promise<OpResult<ThreadRef | null>> {\n   268\t    if (launch.resume === true) {\n   269\t      const pickerDeps: {\n   270\t        registryPath?: string;\n   271\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n   272\t      } = { select: (choices) => selectThread(choices, ctx) };\n   273\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n   274\t      return pickThread(ctx.cwd, pickerDeps);\n   275\t    }\n   276\t    return resolveThread(launch, buildResolveDeps(ctx));\n   277\t  }\n   278\t\n   279\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n   280\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n   281\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n   282\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n   283\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n   284\t  async function resolveReloadFor(\n   285\t    launch: LaunchFlags,\n   286\t    ctx: ExtensionContext,\n   287\t  ): Promise<OpResult<ThreadRef | null>> {\n   288\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n   289\t  }\n   290\t\n   291\t  // session_start: resolve the recording thread and construct one background\n   292\t  // instance against it. Config is gated first so a session with no usable\n   293\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n   294\t  // thread is re-resolved from the durable registry (reattach, never create);\n   295\t  // every other reason runs the normal launch resolution. Fork creates a new\n   296\t  // thread and seeds it from the source thread (Story 4).\n   297\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   298\t    const config = buildSdkConfig(ctx);\n   299\t    if (!config.ok) {\n   300\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   301\t      return;\n   302\t    }\n   303\t\n   304\t    let resolved: OpResult<ThreadRef | null>;\n   305\t\n   306\t    // Fork path (Story 4): create a new thread and seed it from the source.\n   307\t    if (event.reason === \"fork\" && pendingFork !== null) {\n   308\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n   309\t\n   310\t      // Create a new thread for the fork.\n   311\t      const resolveDeps = buildResolveDeps(ctx);\n   312\t      const newFilePath = resolveDeps.newThreadFilePath();\n   313\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n   314\t        filePath: newFilePath,\n   315\t        cwd: resolveDeps.cwd,\n   316\t      };\n   317\t      if (resolveDeps.registryPath !== undefined) {\n   318\t        newThreadInput.registryPath = resolveDeps.registryPath;\n   319\t      }\n   320\t      const created = await threads.newThread(newThreadInput);\n   321\t      if (!created.ok) {\n   322\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n   323\t        pendingFork = null;\n   324\t        return;\n   325\t      }\n   326\t\n   327\t      const targetThreadRef: ThreadRef = { filePath: newFilePath };\n   328\t\n   329\t      // Initialize the instance against the target thread first (required for seedFork).\n   330\t      const built = await initInstance(targetThreadRef, config.value);\n   331\t      if (!built.ok) {\n   332\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   333\t        pendingFork = null;\n   334\t        return;\n   335\t      }\n   336\t      instance = built.value;\n   337\t\n   338\t      // Seed the fork by replaying source events up to the fork point.\n   339\t      const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n   340\t      if (!seeded.ok) {\n   341\t        lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n   342\t        // The instance and thread are created; we continue with an empty fork\n   343\t        // rather than failing completely — the forked session can proceed.\n   344\t      }\n   345\t\n   346\t      // Clear pending fork state.\n   347\t      pendingFork = null;\n   348\t\n   349\t      resolved = { ok: true, value: targetThreadRef };\n   350\t    } else {\n   351\t      // Normal launch resolution.\n   352\t      const launch = parseLaunch();\n   353\t      const isReload = event.reason === \"reload\";\n   354\t      resolved = isReload\n   355\t        ? await resolveReloadFor(launch, ctx)\n   356\t        : await resolveForLaunch(launch, ctx);\n   357\t    }\n   358\t\n   359\t    if (!resolved.ok) {\n   360\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   361\t      return;\n   362\t    }\n   363\t    if (resolved.value === null) {\n   364\t      const isReload = event.reason === \"reload\";\n   365\t      lastDiagnostic = isReload\n   366\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n   367\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   368\t      return;\n   369\t    }\n   370\t\n   371\t    // If instance wasn't created during fork path, create it now.\n   372\t    if (instance === null) {\n   373\t      const built = await initInstance(resolved.value, config.value);\n   374\t      if (!built.ok) {\n   375\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   376\t        return;\n   377\t      }\n   378\t      instance = built.value;\n   379\t    }\n   380\t\n   381\t    state = createSessionState(resolved.value);\n   382\t    const piSessionId = sessionIdOf(resolved.value);\n   383\t    captureSession = {\n   384\t      piSessionId,\n   385\t      accumulator: new TurnAccumulator({ piSessionId }),\n   386\t      sourceSeq: 0,\n   387\t    };\n   388\t  };\n   389\t\n   390\t  // Dispose with flush before any session swap (session_before_switch fires\n   391\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   392\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n   393\t  // re-resolves its thread from the durable registry on the next session_start.\n   394\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   395\t    const result = await disposeInstance(instance);\n   396\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   397\t    instance = null;\n   398\t    captureSession = null;\n   399\t  };\n   400\t\n   401\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n   402\t  // converter already recorded a durable gap for a writable-thread malformed\n   403\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n   404\t  // surfaces as an extension health signal with no gap. Neither path throws.\n   405\t  function recordCaptureOutcome(\n   406\t    result: OpResult<BatchResult>,\n   407\t    events: readonly MessageEventInput[],\n   408\t  ): void {\n   409\t    if (result.ok) return;\n   410\t    const recordedGap = result.error.code === \"invalid_event\";\n   411\t    const failure: CaptureFailureDiagnostic = {\n   412\t      code: result.error.code,\n   413\t      message: result.error.reason,\n   414\t      recordedGap,\n   415\t    };\n   416\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n   417\t    lastDiagnostic = failure;\n   418\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   419\t  }\n   420\t\n   421\t  function nextSourceSeq(session: CaptureSession): number {\n   422\t    const sourceSeq = session.sourceSeq;\n   423\t    session.sourceSeq += 1;\n   424\t    return sourceSeq;\n   425\t  }\n   426\t\n   427\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n   428\t    // Last-resort id-less discriminator. PI position wins when present; the\n   429\t    // connector ordinal is used only when PI gives no event identity at all.\n   430\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n   431\t    // order yields the same ordinal, which is the best identity available.\n   432\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n   433\t  }\n   434\t\n   435\t  async function recordMappingFailure(\n   436\t    hook: string,\n   437\t    position: number | undefined,\n   438\t    sourceSeq: number,\n   439\t    cause: unknown,\n   440\t  ): Promise<void> {\n   441\t    if (instance === null) return;\n   442\t    const message = cause instanceof Error ? cause.message : String(cause);\n   443\t    const result = await captureGap(\n   444\t      fallbackIdFor(hook, position, sourceSeq),\n   445\t      `${hook}: ${message}`,\n   446\t      instance,\n   447\t    );\n   448\t    if (!result.ok) {\n   449\t      recordCaptureOutcome(result, []);\n   450\t      return;\n   451\t    }\n   452\t    const failure: CaptureFailureDiagnostic = {\n   453\t      code: \"invalid_event\",\n   454\t      message: `${hook}: ${message}`,\n   455\t      recordedGap: true,\n   456\t    };\n   457\t    lastDiagnostic = failure;\n   458\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   459\t  }\n   460\t\n   461\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   462\t  // open turn, and flush through the converter (AC-2.1).\n   463\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   464\t    if (instance === null || captureSession === null) return;\n   465\t    const sourceSeq = nextSourceSeq(captureSession);\n   466\t    const mapCtx: MapCtx =\n   467\t      event.entryId !== undefined && event.entryId !== \"\"\n   468\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n   469\t        : {\n   470\t            piSessionId: captureSession.piSessionId,\n   471\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n   472\t          };\n   473\t    let events: MessageEventInput[];\n   474\t    try {\n   475\t      events = mapMessage(event.message, mapCtx);\n   476\t    } catch (cause) {\n   477\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n   478\t      return;\n   479\t    }\n   480\t    captureSession.accumulator.onMessage(events);\n   481\t    if (events.length === 0) return;\n   482\t    recordCaptureOutcome(await capture(events, instance), events);\n   483\t  };\n   484\t\n   485\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   486\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   487\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   488\t    if (instance === null || captureSession === null) return;\n   489\t    const sourceSeq = nextSourceSeq(captureSession);\n   490\t    const mapCtx: MapCtx = {\n   491\t      piSessionId: captureSession.piSessionId,\n   492\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n   493\t    };\n   494\t    const note = mapModelSelect(event, mapCtx);\n   495\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   496\t  };\n   497\t\n   498\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   499\t    if (instance === null || captureSession === null) return;\n   500\t    const sourceSeq = nextSourceSeq(captureSession);\n   501\t    const mapCtx: MapCtx = {\n   502\t      piSessionId: captureSession.piSessionId,\n   503\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n   504\t    };\n   505\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   506\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   507\t  };\n   508\t\n   509\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   510\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   511\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   512\t    if (instance === null || captureSession === null) return;\n   513\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   514\t    if (turnEnd.length === 0) return;\n   515\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   516\t  };\n   517\t\n   518\t  // Contain every handler: an observe-only hook must never throw back into PI\n   519\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   520\t  // plain-data diagnostic; it is never rethrown.\n   521\t  const guard = (\n   522\t    name: Epic1Hook,\n   523\t    body: PiHookHandler<Epic1Hook>,\n   524\t  ): PiHookHandler<Epic1Hook> => {\n   525\t    return async (ctx, event): Promise<void> => {\n   526\t      try {\n   527\t        await body(ctx, event);\n   528\t      } catch (err) {\n   529\t        lastDiagnostic = {\n   530\t          code: \"hook_handler_error\",\n   531\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   532\t          recordedGap: false,\n   533\t        };\n   534\t      }\n   535\t    };\n   536\t  };\n   537\t\n   538\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   539\t  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n   540\t  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n   541\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   542\t    // Intentionally empty — turn_end is ignored as a boundary.\n   543\t  };\n   544\t\n   545\t  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n   546\t  // The source thread ref is captured from the current session state; the hook\n   547\t  // provides entryId/position identifying the fork point. No writes to the source\n   548\t  // thread occur — the fork happens on the next session_start (Story 4).\n   549\t  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n   550\t    if (state === null) return;\n   551\t    // Store the fork info for use on session_start{fork}.\n   552\t    pendingFork = {\n   553\t      sourceThreadRef: state.threadRef,\n   554\t      forkEntryId: event.entryId,\n   555\t    };\n   556\t  };\n   557\t\n   558\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   559\t  // are live; fork handling (Story 4) is wired.\n   560\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   561\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   562\t    session_before_switch: onDispose,\n   563\t    session_shutdown: onDispose,\n   564\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   565\t    turn_end: noop,\n   566\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   567\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   568\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   569\t    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n   570\t  };\n   571\t\n   572\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   573\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   574\t\n   575\t  return {\n   576\t    handlers,\n   577\t    register(pi: ExtensionAPI): void {\n   578\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   579\t    },\n   580\t    getState(): SessionState | null {\n   581\t      return state;\n   582\t    },\n   583\t    getInstance(): LhcInstance | null {\n   584\t      return instance;\n   585\t    },\n   586\t    snapshot(): ConnectorSnapshot {\n   587\t      return { state, lastDiagnostic };\n   588\t    },\n   589\t  };\n   590\t}\n   591\t\n   592\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   593\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n   594\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n   595\t *  observe-only SDK config, and the `--resume` selector that presents the\n   596\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n   597\t *  resolves/creates and initializes for real. On `/reload` the connector\n   598\t *  re-resolves the same thread from the durable registry (it keeps no\n   599\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n   600\t *  config. */\n   601\texport function activate(pi: ExtensionAPI): void {\n   602\t  createConnector().register(pi);\n   603\t}\n   604\t\n   605\texport default activate;\n","exit_code":0,"status":"completed"}}

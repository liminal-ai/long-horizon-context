{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc 'cat packages/pi-lhc/package.json'","aggregated_output":"{\n  \"name\": \"pi-lhc\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"PI ↔ LHC connector extension (Epic 1: Connector Core, observe-only).\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\"\n  ],\n  \"scripts\": {\n    \"clean\": \"rm -rf dist\",\n    \"build\": \"pnpm run clean && tsc -p tsconfig.json\",\n    \"typecheck\": \"tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json\",\n    \"lint\": \"node scripts/lint.mjs\",\n    \"boundaries\": \"node scripts/check-boundaries.mjs\",\n    \"test\": \"vitest run\",\n    \"red-verify\": \"pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run boundaries\",\n    \"verify\": \"pnpm run red-verify && vitest run\",\n    \"green-verify\": \"pnpm run verify && node scripts/check-test-immutability.mjs\",\n    \"verify-all\": \"pnpm run verify\"\n  },\n  \"engines\": {\n    \"node\": \">=24\"\n  },\n  \"dependencies\": {\n    \"lhc\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^24.12.4\",\n    \"typescript\": \"^5.9.3\",\n    \"vitest\": \"^4.1.8\"\n  }\n}\n","exit_code":0,"status":"completed"}}

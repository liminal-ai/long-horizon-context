{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/lifecycle/fork.test.ts'","aggregated_output":"     1\t// Story 4 — fork as new thread. Tests fork detection, new thread creation,\n     2\t// replay seeding, source immutability, and derived form requeue behavior.\n     3\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     4\timport {\n     5\t  createDeterministicProvider,\n     6\t  inspect,\n     7\t  intakeStream,\n     8\t  threads,\n     9\t  type MessageEventInput,\n    10\t  type ThreadRef,\n    11\t} from \"lhc\";\n    12\timport { createConnector } from \"../../src/index.js\";\n    13\timport {\n    14\t  makeAgentEnd,\n    15\t  makeAssistantMessage,\n    16\t  makeMessageEnd,\n    17\t  makeToolResult,\n    18\t  makeUserMessage,\n    19\t} from \"../fixtures/synthetic.js\";\n    20\timport { eventsAfterShutdown, kindsOf, startCapture } from \"../capture/support.js\";\n    21\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    22\t\n    23\tlet store: TempStore;\n    24\tbeforeEach(() => {\n    25\t  store = tempStore();\n    26\t});\n    27\tafterEach(() => {\n    28\t  store.cleanup();\n    29\t});\n    30\t\n    31\tdescribe(\"Story 4: fork as new thread\", () => {\n    32\t  it(\"TC-3.1 (risk: source-vs-derived): fork creates a new thread; source receives no writes\", async () => {\n    33\t    const started = await startCapture(store, \"/work/fork-source\");\n    34\t    const { connector, ctx, threadRef: sourceRef } = started;\n    35\t\n    36\t    // Capture some events in the source thread with deterministic entryIds.\n    37\t    const forkEntryId = \"entry-fork-point\";\n    38\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"source prompt\"), forkEntryId));\n    39\t    await connector.handlers.message_end(\n    40\t      ctx,\n    41\t      makeMessageEnd(\n    42\t        makeAssistantMessage({\n    43\t          text: \"source response\",\n    44\t          toolCalls: [{ id: \"call-1\", name: \"read_file\", arguments: { path: \"file.txt\" } }],\n    45\t        }),\n    46\t        forkEntryId,\n    47\t      ),\n    48\t    );\n    49\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call-1\", content: \"file content\" })));\n    50\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    51\t\n    52\t    // Record the source thread's event count for comparison.\n    53\t    const sourceEventsBefore = await eventsAfterShutdown(started);\n    54\t\n    55\t    // Simulate a fork: fire session_before_fork with the fork entryId.\n    56\t    await connector.handlers.session_before_fork(ctx, { entryId: forkEntryId, position: 10 });\n    57\t\n    58\t    // Fire session_start with reason \"fork\" to trigger fork handling.\n    59\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n    60\t\n    61\t    // The connector state should now point to a NEW thread (different from source).\n    62\t    const state = connector.getState();\n    63\t    expect(state).not.toBeNull();\n    64\t    if (state === null) return;\n    65\t\n    66\t    // The forked thread is a different file from the source.\n    67\t    const sourceId = (sourceRef as { threadId: string }).threadId;\n    68\t    const forkedId = (state.threadRef as { threadId: string }).threadId;\n    69\t    expect(forkedId).not.toBe(sourceId);\n    70\t\n    71\t    // The source thread should have NO new writes — its logical read-back is unchanged.\n    72\t    const sourceEventsAfter = await intakeStream.listEvents(sourceRef);\n    73\t    expect(sourceEventsAfter.ok).toBe(true);\n    74\t    if (sourceEventsAfter.ok) {\n    75\t      expect(sourceEventsAfter.value.length).toBe(sourceEventsBefore.length);\n    76\t      // Event kinds and order should be identical.\n    77\t      expect(kindsOf(sourceEventsAfter.value)).toEqual(kindsOf(sourceEventsBefore));\n    78\t    }\n    79\t\n    80\t    // Shut down the forked session.\n    81\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    82\t  });\n    83\t\n    84\t  it(\"TC-3.2: fork seeded by replay; read-back matches source through fork point\", async () => {\n    85\t    const started = await startCapture(store, \"/work/fork-replay\");\n    86\t    const { connector, ctx, threadRef: sourceRef } = started;\n    87\t\n    88\t    // Capture events in the source thread. Use deterministic entryIds for testing.\n    89\t    const sourceEntryId = \"entry-fork-point\";\n    90\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"prompt before fork\"), sourceEntryId, 1));\n    91\t    await connector.handlers.message_end(\n    92\t      ctx,\n    93\t      makeMessageEnd(makeAssistantMessage({ text: \"response before fork\" }), sourceEntryId, 2),\n    94\t    );\n    95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    96\t\n    97\t    // Record the source thread's events as the expected fork seed.\n    98\t    const sourceEvents = await intakeStream.listEvents(sourceRef);\n    99\t    expect(sourceEvents.ok).toBe(true);\n   100\t    if (!sourceEvents.ok) return;\n   101\t    const expectedSeed = kindsOf(sourceEvents.value);\n   102\t\n   103\t    // Simulate fork at the current position.\n   104\t    await connector.handlers.session_before_fork(ctx, { entryId: sourceEntryId, position: 3 });\n   105\t\n   106\t    // Start the forked session.\n   107\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n   108\t\n   109\t    // The forked thread should be seeded with the source events up to the fork point.\n   110\t    const state = connector.getState();\n   111\t    expect(state).not.toBeNull();\n   112\t    if (state === null) return;\n   113\t\n   114\t    const forkedEvents = await intakeStream.listEvents(state.threadRef);\n   115\t    expect(forkedEvents.ok).toBe(true);\n   116\t    if (forkedEvents.ok) {\n   117\t      // The forked thread should have the same events as the source through the fork point.\n   118\t      // The replay mechanism copies events with the matching entryId in their key.\n   119\t      expect(forkedEvents.value.length).toBeGreaterThan(0);\n   120\t      // The forked events should match the source events through the fork point.\n   121\t      const forkedKinds = kindsOf(forkedEvents.value);\n   122\t      expect(forkedKinds).toEqual(expectedSeed);\n   123\t    }\n   124\t\n   125\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   126\t  });\n   127\t\n   128\t  it(\"TC-3.3: forms requeue on fork (v1: no copy)\", async () => {\n   129\t    // This test verifies that derived forms are NOT copied from source to fork.\n   130\t    // In v1, forms always requeue on the fork target.\n   131\t    // The test requires the deterministic provider to have queued derivations.\n   132\t\n   133\t    // Start a source session with deterministic provider (so derivations run).\n   134\t    const connector = createConnector({\n   135\t      registryPath: store.registryPath,\n   136\t      newThreadFilePath: () => store.threadPath(),\n   137\t      parseLaunch: () => ({}),\n   138\t      buildSdkConfig: () => ({\n   139\t        ok: true,\n   140\t        value: { provider: createDeterministicProvider(), mode: \"background\" },\n   141\t      }),\n   142\t    });\n   143\t\n   144\t    const ctx = {\n   145\t      cwd: \"/work/fork-forms\",\n   146\t      hasUI: false,\n   147\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n   148\t      ui: { notify: () => {} },\n   149\t      sessionManager: { getEntries: () => [] },\n   150\t    };\n   151\t\n   152\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n   153\t    const sourceState = connector.getState();\n   154\t    expect(sourceState).not.toBeNull();\n   155\t    if (sourceState === null) return;\n   156\t\n   157\t    // Capture a prompt (which queues prompt_smoothing derivation).\n   158\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"queue some derivation\")));\n   159\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   160\t\n   161\t    // Drain to let derivations settle.\n   162\t    const sourceInstance = connector.getInstance();\n   163\t    if (sourceInstance) await sourceInstance.dispose();\n   164\t\n   165\t    // Check source has ready derivations.\n   166\t    const sourceHealth = await inspect.health(sourceState.threadRef);\n   167\t    expect(sourceHealth.ok).toBe(true);\n   168\t    if (sourceHealth.ok) {\n   169\t      // At least one derivation should be ready (smoothed_prompt).\n   170\t      const readyCount = sourceHealth.value.owners\n   171\t        .filter((o) => o.owner === \"messages\")\n   172\t        .reduce((sum, o) => sum + o.counts.ready, 0);\n   173\t      expect(readyCount).toBeGreaterThan(0);\n   174\t    }\n   175\t\n   176\t    // Fork the session.\n   177\t    await connector.handlers.session_before_fork(ctx, { entryId: \"entry-fork\" });\n   178\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n   179\t\n   180\t    const forkState = connector.getState();\n   181\t    expect(forkState).not.toBeNull();\n   182\t    if (forkState === null) return;\n   183\t\n   184\t    // The forked thread should NOT have copied forms from the source.\n   185\t    // In v1, forms requeue (or are not copied). The forked thread's forms\n   186\t    // should be in pending/failed state, not ready with the source's results.\n   187\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   188\t\n   189\t    // The key assertion: the fork did not copy the source's derived forms.\n   190\t    // The forked thread either requeues (pending) or has no forms yet,\n   191\t    // but it does NOT have ready forms from the source.\n   192\t  });\n   193\t});\n","exit_code":0,"status":"completed"}}

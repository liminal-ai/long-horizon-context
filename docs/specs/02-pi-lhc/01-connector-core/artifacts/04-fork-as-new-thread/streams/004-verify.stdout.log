{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/idempotency.ts'","aggregated_output":"     1\timport { createHash } from \"node:crypto\";\n     2\timport type { EventKind } from \"lhc\";\n     3\t\n     4\t// AC-2.6: a stable per-event key so re-delivery dedups and crash-replay is\n     5\t// safe. Pure, deterministic — identical across re-delivery of the same logical\n     6\t// event, distinct across different events. Construction precedence (from the\n     7\t// POC mapper, carried forward): PI entry id, else provider responseId /\n     8\t// toolCallId, else a content fingerprint as last resort. `blockIndex` and\n     9\t// `kind` ride every tier so one message's fan-out (thinking → text →\n    10\t// tool_call×N) stays distinct under a single shared id.\n    11\t\n    12\texport interface EventKeyInput {\n    13\t  piSessionId: string;\n    14\t  // Optionals admit explicit `undefined` so a caller can thread a\n    15\t  // possibly-absent id through directly under exactOptionalPropertyTypes.\n    16\t  entryId?: string | undefined;\n    17\t  responseId?: string | undefined;\n    18\t  toolCallId?: string | undefined;\n    19\t  blockIndex: number;\n    20\t  kind: EventKind;\n    21\t  role?: string | undefined;\n    22\t  fallbackId?: string | undefined;\n    23\t  content?: string | undefined;\n    24\t}\n    25\t\n    26\t// Join fingerprint parts with the ASCII unit separator — a delimiter that\n    27\t// effectively never occurs in PI message text, so two different part lists\n    28\t// cannot collide into the same joined string.\n    29\tconst SEP = \"\\u001f\";\n    30\t\n    31\t/** A short, stable content fingerprint — the last-resort key tier when an\n    32\t *  event carries no PI/provider id. sha256 truncated: collision-resistant\n    33\t *  enough for dedup, short enough to keep keys readable. */\n    34\texport function fingerprint(...parts: string[]): string {\n    35\t  return createHash(\"sha256\").update(parts.join(SEP)).digest(\"hex\").slice(0, 24);\n    36\t}\n    37\t\n    38\texport function eventKey(input: EventKeyInput): string {\n    39\t  const { piSessionId, entryId, responseId, toolCallId, blockIndex, kind } = input;\n    40\t  // Tier 1 — PI entry id: the most stable identity, present on real\n    41\t  // finalized message; disambiguated by block + kind for the fan-out.\n    42\t  if (entryId !== undefined && entryId !== \"\") {\n    43\t    return `pi:${piSessionId}:${entryId}:${blockIndex}:${kind}`;\n    44\t  }\n    45\t  // Tier 2 — tool-call id: stable across re-delivery and independent of arrival\n    46\t  // order; kind separates the call from its result under the same id.\n    47\t  if (toolCallId !== undefined && toolCallId !== \"\") {\n    48\t    return `pi:${piSessionId}:tool:${toolCallId}:${kind}`;\n    49\t  }\n    50\t  // Tier 3 — provider response id: stable per assistant response.\n    51\t  if (responseId !== undefined && responseId !== \"\") {\n    52\t    return `pi:${piSessionId}:resp:${responseId}:${blockIndex}:${kind}`;\n    53\t  }\n    54\t  // Tier 4 — content fingerprint: last resort for an event with no id at all.\n    55\t  // Include any caller-supplied stable discriminator; content alone is never\n    56\t  // enough to distinguish two separate same-text events.\n    57\t  const role = input.role ?? \"\";\n    58\t  const fallbackId = input.fallbackId ?? \"no-stable-id\";\n    59\t  const fp = fingerprint(fallbackId, role, kind, input.content ?? \"\");\n    60\t  return `pi:${piSessionId}:fp:${fallbackId}:${blockIndex}:${role}:${kind}:${fp}`;\n    61\t}\n","exit_code":0,"status":"completed"}}

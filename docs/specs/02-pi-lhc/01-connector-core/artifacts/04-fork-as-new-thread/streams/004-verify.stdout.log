\n    42\t    workItemId: string;\n    43\t    owner: WorkOwner;\n    44\t    kind: WorkKind;\n    45\t    sourceRef: WorkSourceRef;\n    46\t  }>;\n    47\t  threadPosition: { lastEventOrder: number };\n    48\t}\n    49\t\n    50\t// Read-back preserves the discrimination: intersecting the input union with\n    51\t// server fields distributes over its members, so a narrowed eventKind narrows\n    52\t// the payload on read exactly as it does on write.\n    53\texport type EventRecord = MessageEventInput & {\n    54\t  eventOrder: number;\n    55\t  recordedAt: string;\n    56\t};\n    57\t\n    58\texport async function messageEvents(\n    59\t  thread: ThreadRef,\n    60\t  events: readonly MessageEventInput[],\n    61\t): Promise<OpResult<BatchResult>> {\n    62\t  return runMessageEvents(thread, events);\n    63\t}\n    64\t\n    65\texport async function listEvents(\n    66\t  thread: ThreadRef,\n    67\t): Promise<OpResult<EventRecord[]>> {\n    68\t  return runListEvents(thread);\n    69\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/lifecycle/fork.ts'","aggregated_output":"     1\t// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n     2\t// never writes the source (tech design Flow 3). Story 4.\n     3\t\n     4\timport { readFileSync } from \"node:fs\";\n     5\timport type { MessageEventInput, OpResult, ThreadRef } from \"lhc\";\n     6\timport type { ExtensionContext, SessionStartEvent } from \"../pi/types.js\";\n     7\timport type { LhcInstance } from \"../shared/instance.js\";\n     8\t\n     9\texport interface ForkInfo {\n    10\t  sourceThreadRef: ThreadRef;\n    11\t  forkEntryId: string;\n    12\t}\n    13\t\n    14\t/** Detect a fork from PI's session tree when the session_before_fork hook is\n    15\t *  absent (Epic 1 fallback evidence). This function is called during\n    16\t *  session_start when we have a previousSessionFile but no pending fork from the\n    17\t *  hook. Returns fork info if the session tree indicates a fork, null otherwise.\n    18\t *\n    19\t * The fallback uses the previousSessionFile as evidence that we're starting a\n    20\t *  new session after an existing one (the fork pattern). The fork point is\n    21\t *  inferred as the end of the previous session. */\n    22\texport function detectForkFromSessionTree(\n    23\t  ctx: ExtensionContext,\n    24\t  event: SessionStartEvent,\n    25\t  sourceThreadRef: ThreadRef,\n    26\t): ForkInfo | null {\n    27\t  if (!event.previousSessionFile) return null;\n    28\t\n    29\t  const currentTreeForkPoint = lastSessionTreeEntryId(ctx.sessionManager.getEntries());\n    30\t  if (currentTreeForkPoint !== null) {\n    31\t    return { sourceThreadRef, forkEntryId: currentTreeForkPoint };\n    32\t  }\n    33\t\n    34\t  const previousTreeForkPoint = lastSessionFileEntryId(event.previousSessionFile);\n    35\t  if (previousTreeForkPoint !== null) {\n    36\t    return { sourceThreadRef, forkEntryId: previousTreeForkPoint };\n    37\t  }\n    38\t\n    39\t  return null;\n    40\t}\n    41\t\n    42\tfunction stringField(record: { readonly [k: string]: unknown }, field: string): string | null {\n    43\t  const value = record[field];\n    44\t  return typeof value === \"string\" && value !== \"\" ? value : null;\n    45\t}\n    46\t\n    47\tfunction lastSessionTreeEntryId(entries: readonly { readonly [k: string]: unknown }[]): string | null {\n    48\t  for (let index = entries.length - 1; index >= 0; index -= 1) {\n    49\t    const entry = entries[index];\n    50\t    if (entry === undefined) continue;\n    51\t    const id = stringField(entry, \"id\") ?? stringField(entry, \"entryId\");\n    52\t    if (id !== null) return id;\n    53\t  }\n    54\t  return null;\n    55\t}\n    56\t\n    57\tfunction lastSessionFileEntryId(filePath: string): string | null {\n    58\t  let contents: string;\n    59\t  try {\n    60\t    contents = readFileSync(filePath, \"utf8\");\n    61\t  } catch {\n    62\t    return null;\n    63\t  }\n    64\t\n    65\t  const lines = contents.trim().split(\"\\n\");\n    66\t  for (let index = lines.length - 1; index >= 0; index -= 1) {\n    67\t    const line = lines[index];\n    68\t    if (line === undefined || line.trim() === \"\") continue;\n    69\t    try {\n    70\t      const parsed = JSON.parse(line) as unknown;\n    71\t      if (typeof parsed !== \"object\" || parsed === null) continue;\n    72\t      const entry = parsed as { readonly [k: string]: unknown };\n    73\t      if (entry.type === \"session\") continue;\n    74\t      const id = stringField(entry, \"id\") ?? stringField(entry, \"entryId\");\n    75\t      if (id !== null) return id;\n    76\t    } catch {\n    77\t      continue;\n    78\t    }\n    79\t  }\n    80\t  return null;\n    81\t}\n    82\t\n    83\t/** Extract fork info from a `session_before_fork` hook payload. The hook\n    84\t *  provides `entryId` and optional `position` identifying the fork point. */\n    85\texport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n    86\t  return { forkEntryId: entryId };\n    87\t}\n    88\t\n    89\t/** Seed a forked thread by replaying the source's recorded events up to the\n    90\t *  fork point, through the normal intake path. The source receives NO writes\n    91\t *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n    92\t *\n    93\t * Replay reads events from the source thread, filters to those up to and\n    94\t * including the fork point (by entryId match on idempotency key), and writes\n    95\t * them through the instance's intake path. This preserves event order, dedup\n    96\t * keys, and all logical content — the seeded thread's read-back matches the\n    97\t * source's read-back through the fork point (AC-3.2).\n    98\t *\n    99\t * The forkEntryId is PI's entry identifier for the session entry at the fork\n   100\t * point. During capture, this entryId was encoded into idempotency keys as\n   101\t * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n   102\t * contain this entryId in their key (any piSessionId, any block/kind), then\n   103\t * include all events up to and including the turn_end that closes the turn at\n   104\t * the fork point. */\n   105\texport async function seedFork(\n   106\t  source: ThreadRef,\n   107\t  target: ThreadRef,\n   108\t  forkEntryId: string,\n   109\t  instance: LhcInstance,\n   110\t): Promise<OpResult<void>> {\n   111\t  const { intakeStream } = instance.sdk;\n   112\t\n   113\t  // Read all events from the source thread.\n   114\t  const events = await intakeStream.listEvents(source);\n   115\t  if (!events.ok) {\n   116\t    return {\n   117\t      ok: false,\n   118\t      error: {\n   119\t        errorClass: events.error.errorClass,\n   120\t        code: events.error.code,\n   121\t        reason: `fork source read failed: ${events.error.reason}`,\n   122\t      },\n   123\t    };\n   124\t  }\n   125\t\n   126\t  // Find the fork point event(s) by entryId match. The entryId appears in the\n   127\t  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n   128\t  // key contains `:${forkEntryId}:` regardless of piSessionId.\n   129\t  const forkPointEvents = events.value.filter((event) =>\n   130\t    event.idempotencyKey.includes(`:${forkEntryId}:`),\n   131\t  );\n   132\t\n   133\t  if (forkPointEvents.length === 0) {\n   134\t    return {\n   135\t      ok: false,\n   136\t      error: {\n   137\t        errorClass: \"caller_error\",\n   138\t        code: \"thread_not_found\",\n   139\t        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n   140\t      },\n   141\t    };\n   142\t  }\n   143\t\n   144\t  // Use the maximum eventOrder among fork point events as the initial cutoff.\n   145\t  // This ensures we include all events (including fan-out) at the fork point.\n   146\t  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n   147\t\n   148\t  // Include the turn_end that closes the turn at the fork point.\n   149\t  // turn_end events don't have entryId in their key (they're generated by\n   150\t  // the connector), so we need to include the first turn_end after maxOrder.\n   151\t  const turnEndAfter = events.value.find(\n   152\t    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n   153\t  );\n   154\t  if (turnEndAfter !== undefined) {\n   155\t    maxOrder = turnEndAfter.eventOrder;\n   156\t  }\n   157\t\n   158\t  // Filter to events up to and including the fork point (including turn_end).\n   159\t  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n   160\t\n   161\t  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n   162\t  // Each event preserves its discriminated eventKind by construction from the\n   163\t  // recorded EventRecord, which carries the exact eventKind that was written.\n   164\t  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n   165\t    (record) =>\n   166\t      ({\n   167\t        eventKind: record.eventKind,\n   168\t        idempotencyKey: record.idempotencyKey,\n   169\t        actor: record.actor,\n   170\t        harness: record.harness,\n   171\t        payload: record.payload,\n   172\t      }) as MessageEventInput,\n   173\t  );\n   174\t\n   175\t  // Replay through the normal intake path into the target thread.\n   176\t  // This uses the same capture converter path, preserving all semantics.\n   177\t  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n   178\t  if (!result.ok) {\n   179\t    return {\n   180\t      ok: false,\n   181\t      error: {\n   182\t        errorClass: result.error.errorClass,\n   183\t        code: result.error.code,\n   184\t        reason: `fork replay failed: ${result.error.reason}`,\n   185\t      },\n   186\t    };\n   187\t  }\n   188\t\n   189\t  return { ok: true, value: undefined };\n   190\t}\n","exit_code":0,"status":"completed"}}

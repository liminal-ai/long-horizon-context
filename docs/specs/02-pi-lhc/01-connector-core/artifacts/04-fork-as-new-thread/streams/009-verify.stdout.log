{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/lifecycle/fork.test.ts'","aggregated_output":"     1\t// Story 4 — fork as new thread. Tests fork detection, new thread creation,\n     2\t// replay seeding, source immutability, and derived form requeue behavior.\n     3\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     4\timport {\n     5\t  createDeterministicProvider,\n     6\t  inspect,\n     7\t  intakeStream,\n     8\t} from \"lhc\";\n     9\timport { createConnector } from \"../../src/index.js\";\n    10\timport {\n    11\t  makeAgentEnd,\n    12\t  makeAssistantMessage,\n    13\t  makeMessageEnd,\n    14\t  makeToolResult,\n    15\t  makeUserMessage,\n    16\t} from \"../fixtures/synthetic.js\";\n    17\timport { eventsAfterShutdown, kindsOf, startCapture } from \"../capture/support.js\";\n    18\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    19\t\n    20\tlet store: TempStore;\n    21\tbeforeEach(() => {\n    22\t  store = tempStore();\n    23\t});\n    24\tafterEach(() => {\n    25\t  store.cleanup();\n    26\t});\n    27\t\n    28\tdescribe(\"Story 4: fork as new thread\", () => {\n    29\t  it(\"TC-3.1 (risk: source-vs-derived): fork creates a new thread; source receives no writes\", async () => {\n    30\t    const started = await startCapture(store, \"/work/fork-source\");\n    31\t    const { connector, ctx, threadRef: sourceRef } = started;\n    32\t\n    33\t    // Capture some events in the source thread with deterministic entryIds.\n    34\t    const forkEntryId = \"entry-fork-point\";\n    35\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"source prompt\"), forkEntryId));\n    36\t    await connector.handlers.message_end(\n    37\t      ctx,\n    38\t      makeMessageEnd(\n    39\t        makeAssistantMessage({\n    40\t          text: \"source response\",\n    41\t          toolCalls: [{ id: \"call-1\", name: \"read_file\", arguments: { path: \"file.txt\" } }],\n    42\t        }),\n    43\t        forkEntryId,\n    44\t      ),\n    45\t    );\n    46\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call-1\", content: \"file content\" })));\n    47\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    48\t\n    49\t    // Record the source thread's event count for comparison.\n    50\t    const sourceEventsBefore = await eventsAfterShutdown(started);\n    51\t\n    52\t    // Simulate a fork: fire session_before_fork with the fork entryId.\n    53\t    await connector.handlers.session_before_fork(ctx, { entryId: forkEntryId, position: 10 });\n    54\t\n    55\t    // print-mode --fork can report reason=startup; detection comes from the hook data.\n    56\t    await connector.handlers.session_start(ctx, { reason: \"startup\" });\n    57\t\n    58\t    // The connector state should now point to a NEW thread (different from source).\n    59\t    const state = connector.getState();\n    60\t    expect(state).not.toBeNull();\n    61\t    if (state === null) return;\n    62\t\n    63\t    // The forked thread is a different file from the source.\n    64\t    const sourceId = (sourceRef as { threadId: string }).threadId;\n    65\t    const forkedId = (state.threadRef as { threadId: string }).threadId;\n    66\t    expect(forkedId).not.toBe(sourceId);\n    67\t\n    68\t    // The source thread should have NO new writes — its logical read-back is unchanged.\n    69\t    const sourceEventsAfter = await intakeStream.listEvents(sourceRef);\n    70\t    expect(sourceEventsAfter.ok).toBe(true);\n    71\t    if (sourceEventsAfter.ok) {\n    72\t      expect(sourceEventsAfter.value.length).toBe(sourceEventsBefore.length);\n    73\t      // Event kinds and order should be identical.\n    74\t      expect(kindsOf(sourceEventsAfter.value)).toEqual(kindsOf(sourceEventsBefore));\n    75\t    }\n    76\t\n    77\t    // Shut down the forked session.\n    78\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    79\t  });\n    80\t\n    81\t  it(\"TC-3.2: fork seeded by replay; read-back matches source through fork point\", async () => {\n    82\t    const started = await startCapture(store, \"/work/fork-replay\");\n    83\t    const { connector, ctx, threadRef: sourceRef } = started;\n    84\t\n    85\t    // Capture events in the source thread. Use deterministic entryIds for testing.\n    86\t    const sourceEntryId = \"entry-fork-point\";\n    87\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"prompt before fork\"), sourceEntryId, 1));\n    88\t    await connector.handlers.message_end(\n    89\t      ctx,\n    90\t      makeMessageEnd(makeAssistantMessage({ text: \"response before fork\" }), sourceEntryId, 2),\n    91\t    );\n    92\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    93\t\n    94\t    // Record the source thread's events as the expected fork seed.\n    95\t    const sourceEvents = await intakeStream.listEvents(sourceRef);\n    96\t    expect(sourceEvents.ok).toBe(true);\n    97\t    if (!sourceEvents.ok) return;\n    98\t    const expectedSeed = kindsOf(sourceEvents.value);\n    99\t\n   100\t    // Simulate fork at the current position.\n   101\t    await connector.handlers.session_before_fork(ctx, { entryId: sourceEntryId, position: 3 });\n   102\t\n   103\t    // Start the forked session.\n   104\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n   105\t\n   106\t    // The forked thread should be seeded with the source events up to the fork point.\n   107\t    const state = connector.getState();\n   108\t    expect(state).not.toBeNull();\n   109\t    if (state === null) return;\n   110\t\n   111\t    const forkedEvents = await intakeStream.listEvents(state.threadRef);\n   112\t    expect(forkedEvents.ok).toBe(true);\n   113\t    if (forkedEvents.ok) {\n   114\t      // The forked thread should have the same events as the source through the fork point.\n   115\t      // The replay mechanism copies events with the matching entryId in their key.\n   116\t      expect(forkedEvents.value.length).toBeGreaterThan(0);\n   117\t      // The forked events should match the source events through the fork point.\n   118\t      const forkedKinds = kindsOf(forkedEvents.value);\n   119\t      expect(forkedKinds).toEqual(expectedSeed);\n   120\t    }\n   121\t\n   122\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   123\t  });\n   124\t\n   125\t  it(\"TC-3.3: forms requeue on fork (v1: no copy)\", async () => {\n   126\t    // This test verifies that derived forms are NOT copied from source to fork.\n   127\t    // In v1, forms always requeue on the fork target.\n   128\t    // The test requires the deterministic provider to have queued derivations.\n   129\t\n   130\t    let sdkMode: \"background\" | \"manual\" = \"background\";\n   131\t\n   132\t    // Start a source session with deterministic provider (so derivations run).\n   133\t    const connector = createConnector({\n   134\t      registryPath: store.registryPath,\n   135\t      newThreadFilePath: () => store.threadPath(),\n   136\t      parseLaunch: () => ({}),\n   137\t      buildSdkConfig: () => ({\n   138\t        ok: true,\n   139\t        value: { provider: createDeterministicProvider(), mode: sdkMode },\n   140\t      }),\n   141\t    });\n   142\t\n   143\t    const ctx = {\n   144\t      cwd: \"/work/fork-forms\",\n   145\t      hasUI: false,\n   146\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n   147\t      ui: { notify: () => {} },\n   148\t      sessionManager: {\n   149\t        // Provide session entries with entryId for fallback fork detection.\n   150\t        getEntries: () => [{ type: \"message_end\", entryId: \"source-entry-1\", position: 1 }],\n   151\t      },\n   152\t    };\n   153\t\n   154\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n   155\t    const sourceState = connector.getState();\n   156\t    expect(sourceState).not.toBeNull();\n   157\t    if (sourceState === null) return;\n   158\t\n   159\t    // Capture a prompt with matching entryId (for fork seeding) which queues\n   160\t    // prompt_smoothing derivation.\n   161\t    const forkEntryId = \"source-entry-1\";\n   162\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"queue some derivation\"), forkEntryId));\n   163\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   164\t\n   165\t    // Drain to let derivations settle.\n   166\t    const sourceInstance = connector.getInstance();\n   167\t    if (sourceInstance) await sourceInstance.dispose();\n   168\t\n   169\t    // Check source has ready derivations.\n   170\t    const sourceHealth = await inspect.health(sourceState.threadRef);\n   171\t    expect(sourceHealth.ok).toBe(true);\n   172\t    if (sourceHealth.ok) {\n   173\t      // At least one derivation should be ready (smoothed_prompt).\n   174\t      expect(sourceHealth.value.owners).toContainEqual({\n   175\t        owner: \"messages\",\n   176\t        kind: \"smoothed_prompt\",\n   177\t        counts: { ready: 1, pending: 0, retrying: 0, failed: 0, blocked: 0 },\n   178\t      });\n   179\t    }\n   180\t\n   181\t    // Fork the session using the same entryId used for capture.\n   182\t    sdkMode = \"manual\";\n   183\t    await connector.handlers.session_before_fork(ctx, { entryId: forkEntryId });\n   184\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n   185\t\n   186\t    const forkState = connector.getState();\n   187\t    expect(forkState).not.toBeNull();\n   188\t    if (forkState === null) return;\n   189\t\n   190\t    // Check forked thread's health before draining: forms requeue on the target\n   191\t    // as pending work instead of copying the source's ready rows.\n   192\t    const forkHealth = await inspect.health(forkState.threadRef);\n   193\t    expect(forkHealth.ok).toBe(true);\n   194\t    if (forkHealth.ok) {\n   195\t      expect(forkHealth.value.owners).toContainEqual({\n   196\t        owner: \"messages\",\n   197\t        kind: \"smoothed_prompt\",\n   198\t        counts: { ready: 0, pending: 1, retrying: 0, failed: 0, blocked: 0 },\n   199\t      });\n   200\t      expect(forkHealth.value.queue.queued).toBeGreaterThan(0);\n   201\t    }\n   202\t\n   203\t    const forkInstance = connector.getInstance();\n   204\t    if (forkInstance) await forkInstance.dispose();\n   205\t\n   206\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   207\t\n   208\t    // Final verification: source and forked threads have different forms.\n   209\t    // The forked thread's forms were derived fresh, not copied.\n   210\t    const sourceHealthFinal = await inspect.health(sourceState.threadRef);\n   211\t    const forkHealthFinal = await inspect.health(forkState.threadRef);\n   212\t    expect(sourceHealthFinal.ok).toBe(true);\n   213\t    expect(forkHealthFinal.ok).toBe(true);\n   214\t    if (sourceHealthFinal.ok && forkHealthFinal.ok) {\n   215\t      // Both threads have ready derivations, but they are independent copies.\n   216\t      const sourceReady = sourceHealthFinal.value.owners\n   217\t        .filter((o) => o.owner === \"messages\")\n   218\t        .reduce((sum, o) => sum + o.counts.ready, 0);\n   219\t      const forkReady = forkHealthFinal.value.owners\n   220\t        .filter((o) => o.owner === \"messages\")\n   221\t        .reduce((sum, o) => sum + o.counts.ready, 0);\n   222\t\n   223\t      // Both have derivations - proving forms requeue and derive on fork target.\n   224\t      expect(sourceReady).toBeGreaterThan(0);\n   225\t      expect(forkReady).toBeGreaterThan(0);\n   226\t    }\n   227\t  });\n   228\t});\n","exit_code":0,"status":"completed"}}

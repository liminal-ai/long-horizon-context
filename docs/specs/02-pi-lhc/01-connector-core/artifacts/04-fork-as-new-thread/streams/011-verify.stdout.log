{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/lifecycle/fork.test.ts'","aggregated_output":"     1\t// Story 4 — fork as new thread. Tests fork detection, new thread creation,\n     2\t// replay seeding, source immutability, and derived form requeue behavior.\n     3\timport { writeFileSync } from \"node:fs\";\n     4\timport { join } from \"node:path\";\n     5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     6\timport {\n     7\t  createDeterministicProvider,\n     8\t  inspect,\n     9\t  intakeStream,\n    10\t} from \"lhc\";\n    11\timport { createConnector } from \"../../src/index.js\";\n    12\timport {\n    13\t  makeAgentEnd,\n    14\t  makeAssistantMessage,\n    15\t  makeMessageEnd,\n    16\t  makeToolResult,\n    17\t  makeUserMessage,\n    18\t} from \"../fixtures/synthetic.js\";\n    19\timport { eventsAfterShutdown, kindsOf, startCapture } from \"../capture/support.js\";\n    20\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tdescribe(\"Story 4: fork as new thread\", () => {\n    31\t  it(\"TC-3.1 (risk: source-vs-derived): fork creates a new thread; source receives no writes\", async () => {\n    32\t    const started = await startCapture(store, \"/work/fork-source\");\n    33\t    const { connector, ctx, threadRef: sourceRef } = started;\n    34\t\n    35\t    // Capture some events in the source thread with deterministic entryIds.\n    36\t    const forkEntryId = \"entry-fork-point\";\n    37\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"source prompt\"), forkEntryId));\n    38\t    await connector.handlers.message_end(\n    39\t      ctx,\n    40\t      makeMessageEnd(\n    41\t        makeAssistantMessage({\n    42\t          text: \"source response\",\n    43\t          toolCalls: [{ id: \"call-1\", name: \"read_file\", arguments: { path: \"file.txt\" } }],\n    44\t        }),\n    45\t        forkEntryId,\n    46\t      ),\n    47\t    );\n    48\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call-1\", content: \"file content\" })));\n    49\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    50\t\n    51\t    // Record the source thread's event count for comparison.\n    52\t    const sourceEventsBefore = await eventsAfterShutdown(started);\n    53\t\n    54\t    // Simulate a fork: fire session_before_fork with the fork entryId.\n    55\t    await connector.handlers.session_before_fork(ctx, { entryId: forkEntryId, position: 10 });\n    56\t\n    57\t    // print-mode --fork can report reason=startup; detection comes from the hook data.\n    58\t    await connector.handlers.session_start(ctx, { reason: \"startup\" });\n    59\t\n    60\t    // The connector state should now point to a NEW thread (different from source).\n    61\t    const state = connector.getState();\n    62\t    expect(state).not.toBeNull();\n    63\t    if (state === null) return;\n    64\t\n    65\t    // The forked thread is a different file from the source.\n    66\t    const sourceId = (sourceRef as { threadId: string }).threadId;\n    67\t    const forkedId = (state.threadRef as { threadId: string }).threadId;\n    68\t    expect(forkedId).not.toBe(sourceId);\n    69\t\n    70\t    // The source thread should have NO new writes — its logical read-back is unchanged.\n    71\t    const sourceEventsAfter = await intakeStream.listEvents(sourceRef);\n    72\t    expect(sourceEventsAfter.ok).toBe(true);\n    73\t    if (sourceEventsAfter.ok) {\n    74\t      expect(sourceEventsAfter.value.length).toBe(sourceEventsBefore.length);\n    75\t      // Event kinds and order should be identical.\n    76\t      expect(kindsOf(sourceEventsAfter.value)).toEqual(kindsOf(sourceEventsBefore));\n    77\t    }\n    78\t\n    79\t    // Shut down the forked session.\n    80\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    81\t  });\n    82\t\n    83\t  it(\"TC-3.1 fallback: detects fork from PI session tree parentId chain when hook is absent\", async () => {\n    84\t    const started = await startCapture(store, \"/work/fork-tree-fallback\");\n    85\t    const { connector, ctx, threadRef: sourceRef } = started;\n    86\t\n    87\t    const forkEntryId = \"pi-entry-source-user\";\n    88\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"tree fallback prompt\"), forkEntryId));\n    89\t    await connector.handlers.message_end(\n    90\t      ctx,\n    91\t      makeMessageEnd(makeAssistantMessage({ text: \"tree fallback response\" }), forkEntryId),\n    92\t    );\n    93\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    94\t\n    95\t    const previousSessionFile = join(store.dir, \"source-session.jsonl\");\n    96\t    writeFileSync(\n    97\t      previousSessionFile,\n    98\t      [\n    99\t        JSON.stringify({ type: \"session\", version: 3 }),\n   100\t        JSON.stringify({ type: \"message\", id: forkEntryId, parentId: \"root\" }),\n   101\t      ].join(\"\\n\"),\n   102\t    );\n   103\t\n   104\t    ctx.sessionManager = {\n   105\t      getEntries: () => [\n   106\t        { type: \"message\", id: forkEntryId, parentId: \"root\" },\n   107\t        { type: \"message\", id: \"pi-entry-child\", parentId: forkEntryId },\n   108\t      ],\n   109\t    };\n   110\t\n   111\t    await connector.handlers.session_start(ctx, { reason: \"startup\", previousSessionFile });\n   112\t\n   113\t    const state = connector.getState();\n   114\t    expect(state).not.toBeNull();\n   115\t    if (state === null) return;\n   116\t    expect((state.threadRef as { threadId?: string }).threadId).not.toBe(\n   117\t      (sourceRef as { threadId?: string }).threadId,\n   118\t    );\n   119\t\n   120\t    const forkedEvents = await intakeStream.listEvents(state.threadRef);\n   121\t    expect(forkedEvents.ok).toBe(true);\n   122\t    if (forkedEvents.ok) {\n   123\t      expect(kindsOf(forkedEvents.value)).toEqual([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n   124\t    }\n   125\t\n   126\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   127\t  });\n   128\t\n   129\t  it(\"TC-3.2: fork seeded by replay; read-back matches source through fork point\", async () => {\n   130\t    const started = await startCapture(store, \"/work/fork-replay\");\n   131\t    const { connector, ctx, threadRef: sourceRef } = started;\n   132\t\n   133\t    // Capture events in the source thread. Use deterministic entryIds for testing.\n   134\t    const sourceEntryId = \"entry-fork-point\";\n   135\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"prompt before fork\"), sourceEntryId, 1));\n   136\t    await connector.handlers.message_end(\n   137\t      ctx,\n   138\t      makeMessageEnd(makeAssistantMessage({ text: \"response before fork\" }), sourceEntryId, 2),\n   139\t    );\n   140\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   141\t\n   142\t    // Record the source thread's events as the expected fork seed.\n   143\t    const sourceEvents = await intakeStream.listEvents(sourceRef);\n   144\t    expect(sourceEvents.ok).toBe(true);\n   145\t    if (!sourceEvents.ok) return;\n   146\t    const expectedSeed = kindsOf(sourceEvents.value);\n   147\t\n   148\t    // Simulate fork at the current position.\n   149\t    await connector.handlers.session_before_fork(ctx, { entryId: sourceEntryId, position: 3 });\n   150\t\n   151\t    // Start the forked session.\n   152\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n   153\t\n   154\t    // The forked thread should be seeded with the source events up to the fork point.\n   155\t    const state = connector.getState();\n   156\t    expect(state).not.toBeNull();\n   157\t    if (state === null) return;\n   158\t\n   159\t    const forkedEvents = await intakeStream.listEvents(state.threadRef);\n   160\t    expect(forkedEvents.ok).toBe(true);\n   161\t    if (forkedEvents.ok) {\n   162\t      // The forked thread should have the same events as the source through the fork point.\n   163\t      // The replay mechanism copies events with the matching entryId in their key.\n   164\t      expect(forkedEvents.value.length).toBeGreaterThan(0);\n   165\t      // The forked events should match the source events through the fork point.\n   166\t      const forkedKinds = kindsOf(forkedEvents.value);\n   167\t      expect(forkedKinds).toEqual(expectedSeed);\n   168\t    }\n   169\t\n   170\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   171\t  });\n   172\t\n   173\t  it(\"TC-3.3: forms requeue on fork (v1: no copy)\", async () => {\n   174\t    // This test verifies that derived forms are NOT copied from source to fork.\n   175\t    // In v1, forms always requeue on the fork target.\n   176\t    // The test requires the deterministic provider to have queued derivations.\n   177\t\n   178\t    let sdkMode: \"background\" | \"manual\" = \"background\";\n   179\t\n   180\t    // Start a source session with deterministic provider (so derivations run).\n   181\t    const connector = createConnector({\n   182\t      registryPath: store.registryPath,\n   183\t      newThreadFilePath: () => store.threadPath(),\n   184\t      parseLaunch: () => ({}),\n   185\t      buildSdkConfig: () => ({\n   186\t        ok: true,\n   187\t        value: { provider: createDeterministicProvider(), mode: sdkMode },\n   188\t      }),\n   189\t    });\n   190\t\n   191\t    const ctx = {\n   192\t      cwd: \"/work/fork-forms\",\n   193\t      hasUI: false,\n   194\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n   195\t      ui: { notify: () => {} },\n   196\t      sessionManager: {\n   197\t        // Provide session entries with entryId for fallback fork detection.\n   198\t        getEntries: () => [{ type: \"message_end\", entryId: \"source-entry-1\", position: 1 }],\n   199\t      },\n   200\t    };\n   201\t\n   202\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n   203\t    const sourceState = connector.getState();\n   204\t    expect(sourceState).not.toBeNull();\n   205\t    if (sourceState === null) return;\n   206\t\n   207\t    // Capture a prompt with matching entryId (for fork seeding) which queues\n   208\t    // prompt_smoothing derivation.\n   209\t    const forkEntryId = \"source-entry-1\";\n   210\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"queue some derivation\"), forkEntryId));\n   211\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   212\t\n   213\t    // Drain to let derivations settle.\n   214\t    const sourceInstance = connector.getInstance();\n   215\t    if (sourceInstance) await sourceInstance.dispose();\n   216\t\n   217\t    // Check source has ready derivations.\n   218\t    const sourceHealth = await inspect.health(sourceState.threadRef);\n   219\t    expect(sourceHealth.ok).toBe(true);\n   220\t    if (sourceHealth.ok) {\n   221\t      // At least one derivation should be ready (smoothed_prompt).\n   222\t      expect(sourceHealth.value.owners).toContainEqual({\n   223\t        owner: \"messages\",\n   224\t        kind: \"smoothed_prompt\",\n   225\t        counts: { ready: 1, pending: 0, retrying: 0, failed: 0, blocked: 0 },\n   226\t      });\n   227\t    }\n   228\t\n   229\t    // Fork the session using the same entryId used for capture.\n   230\t    sdkMode = \"manual\";\n   231\t    await connector.handlers.session_before_fork(ctx, { entryId: forkEntryId });\n   232\t    await connector.handlers.session_start(ctx, { reason: \"fork\" });\n   233\t\n   234\t    const forkState = connector.getState();\n   235\t    expect(forkState).not.toBeNull();\n   236\t    if (forkState === null) return;\n   237\t\n   238\t    // Check forked thread's health before draining: forms requeue on the target\n   239\t    // as pending work instead of copying the source's ready rows.\n   240\t    const forkHealth = await inspect.health(forkState.threadRef);\n   241\t    expect(forkHealth.ok).toBe(true);\n   242\t    if (forkHealth.ok) {\n   243\t      expect(forkHealth.value.owners).toContainEqual({\n   244\t        owner: \"messages\",\n   245\t        kind: \"smoothed_prompt\",\n   246\t        counts: { ready: 0, pending: 1, retrying: 0, failed: 0, blocked: 0 },\n   247\t      });\n   248\t      expect(forkHealth.value.queue.queued).toBeGreaterThan(0);\n   249\t    }\n   250\t\n   251\t    const forkInstance = connector.getInstance();\n   252\t    if (forkInstance) await forkInstance.dispose();\n   253\t\n   254\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   255\t\n   256\t    // Final verification: source and forked threads have different forms.\n   257\t    // The forked thread's forms were derived fresh, not copied.\n   258\t    const sourceHealthFinal = await inspect.health(sourceState.threadRef);\n   259\t    const forkHealthFinal = await inspect.health(forkState.threadRef);\n   260\t    expect(sourceHealthFinal.ok).toBe(true);\n   261\t    expect(forkHealthFinal.ok).toBe(true);\n   262\t    if (sourceHealthFinal.ok && forkHealthFinal.ok) {\n   263\t      // Both threads have ready derivations, but they are independent copies.\n   264\t      const sourceReady = sourceHealthFinal.value.owners\n   265\t        .filter((o) => o.owner === \"messages\")\n   266\t        .reduce((sum, o) => sum + o.counts.ready, 0);\n   267\t      const forkReady = forkHealthFinal.value.owners\n   268\t        .filter((o) => o.owner === \"messages\")\n   269\t        .reduce((sum, o) => sum + o.counts.ready, 0);\n   270\t\n   271\t      // Both have derivations - proving forms requeue and derive on fork target.\n   272\t      expect(sourceReady).toBeGreaterThan(0);\n   273\t      expect(forkReady).toBeGreaterThan(0);\n   274\t    }\n   275\t  });\n   276\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/lifecycle/fork.ts'","aggregated_output":"     1\t// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n     2\t// never writes the source (tech design Flow 3). Story 4.\n     3\t\n     4\timport { readFileSync } from \"node:fs\";\n     5\timport type { MessageEventInput, OpResult, ThreadRef } from \"lhc\";\n     6\timport type { ExtensionContext, SessionStartEvent } from \"../pi/types.js\";\n     7\timport type { LhcInstance } from \"../shared/instance.js\";\n     8\t\n     9\texport interface ForkInfo {\n    10\t  sourceThreadRef: ThreadRef;\n    11\t  forkEntryId: string;\n    12\t}\n    13\t\n    14\t/** Detect a fork from PI's session tree when the session_before_fork hook is\n    15\t *  absent (Epic 1 fallback evidence). This function is called during\n    16\t *  session_start when we have a previousSessionFile but no pending fork from the\n    17\t *  hook. Returns fork info if the session tree indicates a fork, null otherwise.\n    18\t *\n    19\t * The fallback uses the previousSessionFile as evidence that we're starting a\n    20\t *  new session after an existing one (the fork pattern). The fork point is\n    21\t *  inferred as the end of the previous session. */\n    22\texport function detectForkFromSessionTree(\n    23\t  ctx: ExtensionContext,\n    24\t  event: SessionStartEvent,\n    25\t  sourceThreadRef: ThreadRef,\n    26\t): ForkInfo | null {\n    27\t  if (!event.previousSessionFile) return null;\n    28\t\n    29\t  const previousEntries = readSessionEntries(event.previousSessionFile);\n    30\t  const previousIds = new Set(previousEntries.map(entryIdOf).filter((id): id is string => id !== null));\n    31\t  if (previousIds.size === 0) return null;\n    32\t\n    33\t  const currentEntries = ctx.sessionManager.getEntries();\n    34\t  const sharedCurrentEntry = lastEntryMatching(currentEntries, (entry) => {\n    35\t    const id = entryIdOf(entry);\n    36\t    return id !== null && previousIds.has(id);\n    37\t  });\n    38\t  if (sharedCurrentEntry !== null) {\n    39\t    return { sourceThreadRef, forkEntryId: sharedCurrentEntry };\n    40\t  }\n    41\t\n    42\t  const parentLink = firstEntryMatching(currentEntries, (entry) => {\n    43\t    const parentId = stringField(entry, \"parentId\");\n    44\t    return parentId !== null && previousIds.has(parentId);\n    45\t  });\n    46\t  if (parentLink !== null) {\n    47\t    return { sourceThreadRef, forkEntryId: parentLink };\n    48\t  }\n    49\t\n    50\t  return null;\n    51\t}\n    52\t\n    53\tfunction stringField(record: { readonly [k: string]: unknown }, field: string): string | null {\n    54\t  const value = record[field];\n    55\t  return typeof value === \"string\" && value !== \"\" ? value : null;\n    56\t}\n    57\t\n    58\tfunction entryIdOf(entry: { readonly [k: string]: unknown }): string | null {\n    59\t  return stringField(entry, \"id\") ?? stringField(entry, \"entryId\");\n    60\t}\n    61\t\n    62\tfunction lastEntryMatching(\n    63\t  entries: readonly { readonly [k: string]: unknown }[],\n    64\t  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n    65\t): string | null {\n    66\t  for (let index = entries.length - 1; index >= 0; index -= 1) {\n    67\t    const entry = entries[index];\n    68\t    if (entry === undefined || !matches(entry)) continue;\n    69\t    return entryIdOf(entry);\n    70\t  }\n    71\t  return null;\n    72\t}\n    73\t\n    74\tfunction firstEntryMatching(\n    75\t  entries: readonly { readonly [k: string]: unknown }[],\n    76\t  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n    77\t): string | null {\n    78\t  for (const entry of entries) {\n    79\t    if (!matches(entry)) continue;\n    80\t    const parentId = stringField(entry, \"parentId\");\n    81\t    if (parentId !== null) return parentId;\n    82\t  }\n    83\t  return null;\n    84\t}\n    85\t\n    86\tfunction readSessionEntries(filePath: string): { readonly [k: string]: unknown }[] {\n    87\t  let contents: string;\n    88\t  try {\n    89\t    contents = readFileSync(filePath, \"utf8\");\n    90\t  } catch {\n    91\t    return [];\n    92\t  }\n    93\t\n    94\t  const entries: { readonly [k: string]: unknown }[] = [];\n    95\t  for (const line of contents.trim().split(\"\\n\")) {\n    96\t    if (line.trim() === \"\") continue;\n    97\t    try {\n    98\t      const parsed = JSON.parse(line) as unknown;\n    99\t      if (typeof parsed !== \"object\" || parsed === null) continue;\n   100\t      const entry = parsed as { readonly [k: string]: unknown };\n   101\t      if (entry.type === \"session\") continue;\n   102\t      entries.push(entry);\n   103\t    } catch {\n   104\t      continue;\n   105\t    }\n   106\t  }\n   107\t  return entries;\n   108\t}\n   109\t\n   110\t/** Extract fork info from a `session_before_fork` hook payload. The hook\n   111\t *  provides `entryId` and optional `position` identifying the fork point. */\n   112\texport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n   113\t  return { forkEntryId: entryId };\n   114\t}\n   115\t\n   116\t/** Seed a forked thread by replaying the source's recorded events up to the\n   117\t *  fork point, through the normal intake path. The source receives NO writes\n   118\t *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n   119\t *\n   120\t * Replay reads events from the source thread, filters to those up to and\n   121\t * including the fork point (by entryId match on idempotency key), and writes\n   122\t * them through the instance's intake path. This preserves event order, dedup\n   123\t * keys, and all logical content — the seeded thread's read-back matches the\n   124\t * source's read-back through the fork point (AC-3.2).\n   125\t *\n   126\t * The forkEntryId is PI's entry identifier for the session entry at the fork\n   127\t * point. During capture, this entryId was encoded into idempotency keys as\n   128\t * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n   129\t * contain this entryId in their key (any piSessionId, any block/kind), then\n   130\t * include all events up to and including the turn_end that closes the turn at\n   131\t * the fork point. */\n   132\texport async function seedFork(\n   133\t  source: ThreadRef,\n   134\t  target: ThreadRef,\n   135\t  forkEntryId: string,\n   136\t  instance: LhcInstance,\n   137\t): Promise<OpResult<void>> {\n   138\t  const { intakeStream } = instance.sdk;\n   139\t\n   140\t  // Read all events from the source thread.\n   141\t  const events = await intakeStream.listEvents(source);\n   142\t  if (!events.ok) {\n   143\t    return {\n   144\t      ok: false,\n   145\t      error: {\n   146\t        errorClass: events.error.errorClass,\n   147\t        code: events.error.code,\n   148\t        reason: `fork source read failed: ${events.error.reason}`,\n   149\t      },\n   150\t    };\n   151\t  }\n   152\t\n   153\t  // Find the fork point event(s) by entryId match. The entryId appears in the\n   154\t  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n   155\t  // key contains `:${forkEntryId}:` regardless of piSessionId.\n   156\t  const forkPointEvents = events.value.filter((event) =>\n   157\t    event.idempotencyKey.includes(`:${forkEntryId}:`),\n   158\t  );\n   159\t\n   160\t  if (forkPointEvents.length === 0) {\n   161\t    return {\n   162\t      ok: false,\n   163\t      error: {\n   164\t        errorClass: \"caller_error\",\n   165\t        code: \"thread_not_found\",\n   166\t        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n   167\t      },\n   168\t    };\n   169\t  }\n   170\t\n   171\t  // Use the maximum eventOrder among fork point events as the initial cutoff.\n   172\t  // This ensures we include all events (including fan-out) at the fork point.\n   173\t  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n   174\t\n   175\t  // Include the turn_end that closes the turn at the fork point.\n   176\t  // turn_end events don't have entryId in their key (they're generated by\n   177\t  // the connector), so we need to include the first turn_end after maxOrder.\n   178\t  const turnEndAfter = events.value.find(\n   179\t    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n   180\t  );\n   181\t  if (turnEndAfter !== undefined) {\n   182\t    maxOrder = turnEndAfter.eventOrder;\n   183\t  }\n   184\t\n   185\t  // Filter to events up to and including the fork point (including turn_end).\n   186\t  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n   187\t\n   188\t  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n   189\t  // Each event preserves its discriminated eventKind by construction from the\n   190\t  // recorded EventRecord, which carries the exact eventKind that was written.\n   191\t  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n   192\t    (record) =>\n   193\t      ({\n   194\t        eventKind: record.eventKind,\n   195\t        idempotencyKey: record.idempotencyKey,\n   196\t        actor: record.actor,\n   197\t        harness: record.harness,\n   198\t        payload: record.payload,\n   199\t      }) as MessageEventInput,\n   200\t  );\n   201\t\n   202\t  // Replay through the normal intake path into the target thread.\n   203\t  // This uses the same capture converter path, preserving all semantics.\n   204\t  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n   205\t  if (!result.ok) {\n   206\t    return {\n   207\t      ok: false,\n   208\t      error: {\n   209\t        errorClass: result.error.errorClass,\n   210\t        code: result.error.code,\n   211\t        reason: `fork replay failed: ${result.error.reason}`,\n   212\t      },\n   213\t    };\n   214\t  }\n   215\t\n   216\t  return { ok: true, value: undefined };\n   217\t}\n","exit_code":0,"status":"completed"}}

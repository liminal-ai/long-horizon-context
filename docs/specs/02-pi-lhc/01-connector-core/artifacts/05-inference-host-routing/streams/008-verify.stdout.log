{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '130,165p'\"","aggregated_output":"   130\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   131\t *  same id). */\n   132\tfunction sessionIdOf(ref: ThreadRef): string {\n   133\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   134\t}\n   135\t\n   136\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   137\t\n   138\t/** The production SDK config for Story 5+: injects the host ModelCall function\n   139\t *  that resolves provider/model through PI's registry and completes through\n   140\t *  pi-ai when available. Story 6 will replace the first-available-model default\n   141\t *  with explicit operator config. */\n   142\tfunction defaultBuildSdkConfig(ctx: ExtensionContext): OpResult<SdkConfig> {\n   143\t  const model = ctx.modelRegistry.getAvailable()[0];\n   144\t  return {\n   145\t    ok: true,\n   146\t    value: {\n   147\t      inference: {\n   148\t        call: createModelCall(ctx),\n   149\t        assignments: defaultAssignments(model),\n   150\t      },\n   151\t      mode: \"background\",\n   152\t    },\n   153\t  };\n   154\t}\n   155\t\n   156\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   157\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   158\t *  show. */\n   159\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   160\t  const lines = choices.map((choice, i) => {\n   161\t    const title = choice.title ?? \"(untitled)\";\n   162\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   163\t  });\n   164\t  return [\n   165\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/inference/model-call.test.ts | sed -n '24,310p'\"","aggregated_output":"    24\t\n    25\tdescribe(\"Story 5: Inference Host Routing\", () => {\n    26\t  describe(\"TC-4.1: ModelCall resolves provider/model and returns text\", () => {\n    27\t    it(\"resolves a known model with configured auth and returns completion text\", async () => {\n    28\t      const mockHandle: ModelHandle = { provider: \"openai\", id: \"gpt-5.4\" };\n    29\t      const ctx: ExtensionContext = {\n    30\t        cwd: \"/test\",\n    31\t        hasUI: false,\n    32\t        modelRegistry: {\n    33\t          find: () => mockHandle,\n    34\t          hasConfiguredAuth: () => true,\n    35\t          getAvailable: () => [mockHandle],\n    36\t        },\n    37\t        ui: { notify: () => {} },\n    38\t        sessionManager: { getEntries: () => [] },\n    39\t      };\n    40\t\n    41\t      const complete = vi.fn<PiAiComplete>(async (model) => ({\n    42\t        role: \"assistant\",\n    43\t        content: [{ type: \"text\", text: `real completion from ${model.provider}/${model.id}` }],\n    44\t      }));\n    45\t      const modelCall = createModelCall(ctx, { complete });\n    46\t      const result = await modelCall(INPUT);\n    47\t\n    48\t      expect(result.ok).toBe(true);\n    49\t      if (result.ok) {\n    50\t        expect(result.text).toBe(\"real completion from openai-codex/gpt-5.4\");\n    51\t      }\n    52\t      expect(complete).toHaveBeenCalledWith(mockHandle, { messages: INPUT.messages });\n    53\t    });\n    54\t  });\n    55\t\n    56\t  describe(\"TC-4.2: Multi-lane routing — different kinds route to different pairs\", () => {\n    57\t    it(\"routes each call by its provider/model keys independently\", async () => {\n    58\t      const handles: ModelHandle[] = [\n    59\t        { provider: \"openai\", id: \"gpt-5.4\" },\n    60\t        { provider: \"anthropic\", id: \"claude-3-opus\" },\n    61\t        { provider: \"openai\", id: \"gpt-4o\" },\n    62\t      ];\n    63\t\n    64\t      const findMock = vi.fn(\n    65\t        (provider: string, model: string) => handles.find((h) => h.provider === provider && h.id === model),\n    66\t      ) as (provider: string, model: string) => ModelHandle | undefined;\n    67\t\n    68\t      const ctx: ExtensionContext = {\n    69\t        cwd: \"/test\",\n    70\t        hasUI: false,\n    71\t        modelRegistry: {\n    72\t          find: findMock,\n    73\t          hasConfiguredAuth: () => true,\n    74\t          getAvailable: () => handles,\n    75\t        },\n    76\t        ui: { notify: () => {} },\n    77\t        sessionManager: { getEntries: () => [] },\n    78\t      };\n    79\t\n    80\t      const modelCall = createModelCall(ctx, {\n    81\t        complete: async (resolved) => ({\n    82\t          role: \"assistant\",\n    83\t          content: [{ type: \"text\", text: `routed ${resolved.provider}/${resolved.id}` }],\n    84\t        }),\n    85\t      });\n    86\t\n    87\t      // Call with different provider/model pairs\n    88\t      const result1 = await modelCall({\n    89\t        ...INPUT,\n    90\t        provider: \"openai\",\n    91\t        model: \"gpt-5.4\",\n    92\t      });\n    93\t      const result2 = await modelCall({\n    94\t        ...INPUT,\n    95\t        provider: \"anthropic\",\n    96\t        model: \"claude-3-opus\",\n    97\t      });\n    98\t      const result3 = await modelCall({\n    99\t        ...INPUT,\n   100\t        provider: \"openai\",\n   101\t        model: \"gpt-4o\",\n   102\t      });\n   103\t\n   104\t      // All should succeed and route correctly\n   105\t      expect(result1.ok).toBe(true);\n   106\t      expect(result2.ok).toBe(true);\n   107\t      expect(result3.ok).toBe(true);\n   108\t\n   109\t      // Verify find was called with the correct keys\n   110\t      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-5.4\");\n   111\t      expect(findMock).toHaveBeenCalledWith(\"anthropic\", \"claude-3-opus\");\n   112\t      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-4o\");\n   113\t    });\n   114\t  });\n   115\t\n   116\t  describe(\"TC-4.3: Adapter-boundary risk — failure shapes map to exact kinds\", () => {\n   117\t    describe(\"terminal failures\", () => {\n   118\t      it(\"classifies auth failure as terminal\", async () => {\n   119\t        const ctx: ExtensionContext = {\n   120\t          cwd: \"/test\",\n   121\t          hasUI: false,\n   122\t          modelRegistry: {\n   123\t            find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n   124\t            hasConfiguredAuth: () => false, // No auth configured\n   125\t            getAvailable: () => [],\n   126\t          },\n   127\t          ui: { notify: () => {} },\n   128\t          sessionManager: { getEntries: () => [] },\n   129\t        };\n   130\t\n   131\t        const modelCall = createModelCall(ctx);\n   132\t        const result = await modelCall(INPUT);\n   133\t\n   134\t        expect(result.ok).toBe(false);\n   135\t        if (!result.ok) {\n   136\t          expect(result.kind).toBe(\"auth\");\n   137\t        }\n   138\t      });\n   139\t\n   140\t      it(\"classifies invalid_request as terminal\", async () => {\n   141\t        const ctx: ExtensionContext = {\n   142\t          cwd: \"/test\",\n   143\t          hasUI: false,\n   144\t          modelRegistry: {\n   145\t            find: () => undefined, // Model not found\n   146\t            hasConfiguredAuth: () => true,\n   147\t            getAvailable: () => [],\n   148\t          },\n   149\t          ui: { notify: () => {} },\n   150\t          sessionManager: { getEntries: () => [] },\n   151\t        };\n   152\t\n   153\t        const modelCall = createModelCall(ctx);\n   154\t        const result = await modelCall(INPUT);\n   155\t\n   156\t        expect(result.ok).toBe(false);\n   157\t        if (!result.ok) {\n   158\t          expect(result.kind).toBe(\"invalid_request\");\n   159\t        }\n   160\t      });\n   161\t    });\n   162\t\n   163\t    describe(\"retryable failures\", () => {\n   164\t      it(\"classifies rate_limit error as retryable\", () => {\n   165\t        const error = { code: \"rate_limit_exceeded\", message: \"Rate limit exceeded\" };\n   166\t        const kind = classifyFailure(error);\n   167\t        expect(kind).toBe(\"rate_limit\");\n   168\t      });\n   169\t\n   170\t      it(\"classifies timeout error as retryable\", () => {\n   171\t        const error = { code: \"request_timeout\", message: \"Request timed out\" };\n   172\t        const kind = classifyFailure(error);\n   173\t        expect(kind).toBe(\"timeout\");\n   174\t      });\n   175\t\n   176\t      it(\"classifies network error as retryable\", () => {\n   177\t        const error = { code: \"network_error\", message: \"Connection failed\" };\n   178\t        const kind = classifyFailure(error);\n   179\t        expect(kind).toBe(\"network\");\n   180\t      });\n   181\t    });\n   182\t\n   183\t    describe(\"thrown exception maps to other\", () => {\n   184\t      it(\"classifies a thrown generic error as other\", () => {\n   185\t        const error = new Error(\"Something went wrong\");\n   186\t        const kind = classifyFailure(error);\n   187\t        expect(kind).toBe(\"other\");\n   188\t      });\n   189\t\n   190\t      it(\"classifies a non-error throw as other\", () => {\n   191\t        const kind = classifyFailure(\"string error\");\n   192\t        expect(kind).toBe(\"other\");\n   193\t      });\n   194\t\n   195\t      it(\"classifies null as other\", () => {\n   196\t        const kind = classifyFailure(null);\n   197\t        expect(kind).toBe(\"other\");\n   198\t      });\n   199\t    });\n   200\t\n   201\t    describe(\"error pattern matching\", () => {\n   202\t      it(\"recognizes auth patterns in code, type, and message\", () => {\n   203\t        expect(classifyFailure({ code: \"auth_failed\" })).toBe(\"auth\");\n   204\t        expect(classifyFailure({ type: \"authentication_error\" })).toBe(\"auth\");\n   205\t        expect(classifyFailure({ message: \"Unauthorized access\" })).toBe(\"auth\");\n   206\t        expect(classifyFailure({ code: \"401\" })).toBe(\"auth\");\n   207\t      });\n   208\t\n   209\t      it(\"recognizes invalid_request patterns\", () => {\n   210\t        expect(classifyFailure({ code: \"invalid_request\" })).toBe(\"invalid_request\");\n   211\t        expect(classifyFailure({ code: \"400\" })).toBe(\"invalid_request\");\n   212\t        expect(classifyFailure({ message: \"Bad request\" })).toBe(\"invalid_request\");\n   213\t      });\n   214\t\n   215\t      it(\"recognizes rate_limit patterns\", () => {\n   216\t        expect(classifyFailure({ code: \"rate_limit\" })).toBe(\"rate_limit\");\n   217\t        expect(classifyFailure({ code: \"429\" })).toBe(\"rate_limit\");\n   218\t        expect(classifyFailure({ type: \"rate_limit_exceeded\" })).toBe(\"rate_limit\");\n   219\t      });\n   220\t\n   221\t      it(\"recognizes timeout patterns\", () => {\n   222\t        expect(classifyFailure({ code: \"timeout\" })).toBe(\"timeout\");\n   223\t        expect(classifyFailure({ code: \"408\" })).toBe(\"timeout\");\n   224\t        expect(classifyFailure({ message: \"Request timed out\" })).toBe(\"timeout\");\n   225\t      });\n   226\t\n   227\t      it(\"recognizes network patterns\", () => {\n   228\t        expect(classifyFailure({ code: \"network_error\" })).toBe(\"network\");\n   229\t        expect(classifyFailure({ code: \"ECONNREFUSED\" })).toBe(\"network\");\n   230\t        expect(classifyFailure({ type: \"connection_error\" })).toBe(\"network\");\n   231\t      });\n   232\t    });\n   233\t  });\n   234\t\n   235\t  describe(\"TC-4.4: Host returns text-or-transport-failure; adapter owns empty_output\", () => {\n   236\t    it(\"returns ok:true with empty text when completion produces no output\", async () => {\n   237\t      const ctx: ExtensionContext = {\n   238\t        cwd: \"/test\",\n   239\t        hasUI: false,\n   240\t        modelRegistry: {\n   241\t          find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n   242\t          hasConfiguredAuth: () => true,\n   243\t          getAvailable: () => [],\n   244\t        },\n   245\t        ui: { notify: () => {} },\n   246\t        sessionManager: { getEntries: () => [] },\n   247\t      };\n   248\t\n   249\t      const modelCall = createModelCall(ctx, {\n   250\t        complete: async () => ({ role: \"assistant\", content: [] }),\n   251\t      });\n   252\t      const result = await modelCall(INPUT);\n   253\t\n   254\t      expect(result.ok).toBe(true);\n   255\t      if (result.ok) {\n   256\t        expect(result.text).toBe(\"\");\n   257\t      }\n   258\t    });\n   259\t\n   260\t    it(\"LHC adapter classifies empty resolved output as empty_output\", async () => {\n   261\t      const store = tempStore();\n   262\t      try {\n   263\t        const sdk = createSdk({\n   264\t          inference: {\n   265\t            call: async () => ({ ok: true, text: \"\" }),\n   266\t            assignments: {\n   267\t              smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   268\t              tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   269\t              tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   270\t              turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   271\t              lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   272\t              chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   273\t              chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   274\t            },\n   275\t          },\n   276\t          mode: \"manual\",\n   277\t          retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n   278\t        });\n   279\t        const created = await threads.newThread({\n   280\t          filePath: store.threadPath(),\n   281\t          registryPath: store.registryPath,\n   282\t        });\n   283\t        expect(created.ok).toBe(true);\n   284\t        if (!created.ok) return;\n   285\t\n   286\t        const captured = await sdk.intakeStream.messageEvents({ filePath: created.value.filePath }, [\n   287\t          validEvent(\"user_prompt\", {\n   288\t            idempotencyKey: \"empty-output-prompt\",\n   289\t            payload: { text: \"produce no output\" },\n   290\t          }),\n   291\t        ]);\n   292\t        expect(captured.ok).toBe(true);\n   293\t\n   294\t        const drained = await sdk.work.drain({ filePath: created.value.filePath });\n   295\t        expect(drained.ok).toBe(true);\n   296\t        const health = await sdk.inspect.health({ filePath: created.value.filePath });\n   297\t        expect(health.ok).toBe(true);\n   298\t        if (health.ok) {\n   299\t          const failures = health.value.failures.filter((f) => f.form === \"smoothed_prompt\");\n   300\t          expect(failures).toEqual([\n   301\t            expect.objectContaining({\n   302\t              reason: expect.stringContaining(\"empty_output\"),\n   303\t              lastError: expect.stringContaining(\"empty_output\"),\n   304\t            }),\n   305\t          ]);\n   306\t        }\n   307\t      } finally {\n   308\t        store.cleanup();\n   309\t      }\n   310\t    });\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/model-call.ts | sed -n '1,190p'\"","aggregated_output":"     1\t// AC-4.1..4.4. The host-supplied ModelCall function.\n     2\t//\n     3\t// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n     4\t// a production-valid boundary, and classifies failures into the LHC contract.\n     5\t// Provider/model are opaque routing keys — the connector does not interpret them.\n     6\t//\n     7\t// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n     8\t// registry and completes through @earendil-works/pi-ai when that package is\n     9\t// available in the host runtime. If the runtime does not provide pi-ai, the host\n    10\t// returns a classified failure; it never fabricates completion text.\n    11\t//\n    12\t// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n    13\t// @earendil-works/pi-ai (package not yet available).\n    14\t\n    15\timport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\n    16\timport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\n    17\timport type { PiAiComplete } from \"./pi-ai.js\";\n    18\t\n    19\tinterface ModelCallDeps {\n    20\t  complete?: PiAiComplete;\n    21\t}\n    22\t\n    23\t/** Extract the text content from an AssistantMessage-like shape. */\n    24\tfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n    25\t  const content = message.content ?? [];\n    26\t  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n    27\t  return textParts.map((part) => part.text as string).join(\"\\n\");\n    28\t}\n    29\t\n    30\t/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n    31\t *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n    32\t *  thrown → other). */\n    33\texport function classifyFailure(err: unknown): ModelCallFailureKind {\n    34\t  // Guard: non-object errors fall through to \"other\"\n    35\t  if (typeof err !== \"object\" || err === null) {\n    36\t    return \"other\";\n    37\t  }\n    38\t\n    39\t  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n    40\t  const code = errorLike.code?.toLowerCase() ?? \"\";\n    41\t  const type = errorLike.type?.toLowerCase() ?? \"\";\n    42\t  const message = errorLike.message?.toLowerCase() ?? \"\";\n    43\t\n    44\t  // Check for auth failures (terminal)\n    45\t  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n    46\t  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    47\t    return \"auth\";\n    48\t  }\n    49\t\n    50\t  // Check for invalid request (terminal)\n    51\t  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n    52\t  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    53\t    return \"invalid_request\";\n    54\t  }\n    55\t\n    56\t  // Check for rate limit (retryable)\n    57\t  const rateLimitPatterns = [\"rate\", \"429\"];\n    58\t  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    59\t    return \"rate_limit\";\n    60\t  }\n    61\t\n    62\t  // Check for timeout (retryable)\n    63\t  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n    64\t  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    65\t    return \"timeout\";\n    66\t  }\n    67\t\n    68\t  // Check for network errors (retryable)\n    69\t  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n    70\t  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    71\t    return \"network\";\n    72\t  }\n    73\t\n    74\t  // Default for unknown errors\n    75\t  return \"other\";\n    76\t}\n    77\t\n    78\tasync function importPiAiComplete(): Promise<PiAiComplete> {\n    79\t  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n    80\t    specifier: string,\n    81\t  ) => Promise<unknown>;\n    82\t  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n    83\t  const complete = (loaded as { complete?: unknown }).complete;\n    84\t  if (typeof complete !== \"function\") {\n    85\t    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n    86\t      code: \"invalid_request\",\n    87\t    });\n    88\t  }\n    89\t  return complete as PiAiComplete;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Production ModelCall implementation using PI's model registry and pi-ai.\n    94\t *\n    95\t * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n    96\t * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n    97\t * when the host runtime provides it.\n    98\t */\n    99\texport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n   100\t  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n   101\t    // Resolve the model through PI's registry\n   102\t    const resolved = ctx.modelRegistry.find(provider, model);\n   103\t    if (resolved === undefined) {\n   104\t      // Unknown model - treat as invalid request (terminal)\n   105\t      return {\n   106\t        ok: false,\n   107\t        kind: \"invalid_request\",\n   108\t        message: `Model not found in registry: ${provider}/${model}`,\n   109\t      };\n   110\t    }\n   111\t\n   112\t    // Check if auth is configured\n   113\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n   114\t      // No auth - treat as auth failure (terminal)\n   115\t      return {\n   116\t        ok: false,\n   117\t        kind: \"auth\",\n   118\t        message: `No configured auth for model: ${provider}/${model}`,\n   119\t      };\n   120\t    }\n   121\t\n   122\t    // Complete through pi-ai. Tests may inject this seam; production loads the\n   123\t    // host package at runtime so pi-lhc does not publish fabricated text when\n   124\t    // the host dependency is absent.\n   125\t    try {\n   126\t      const complete = deps.complete ?? await importPiAiComplete();\n   127\t      const response = await complete(resolved, { messages });\n   128\t\n   129\t      // Extract text from the response\n   130\t      const text = extractAssistantText(response);\n   131\t\n   132\t      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n   133\t      // empty_output is classified by LHC's adapter, not by the host function.\n   134\t      // The host function returns text-or-failure only, even if the text is empty.\n   135\t      return { ok: true, text };\n   136\t    } catch (err) {\n   137\t      // Classify the error into a ModelCallFailureKind\n   138\t      const kind = classifyFailure(err);\n   139\t      const message = err instanceof Error ? err.message : String(err);\n   140\t      return { ok: false, kind, message };\n   141\t    }\n   142\t  };\n   143\t}\n   144\t\n   145\t/**\n   146\t * Default assignments for all seven FormKinds.\n   147\t *\n   148\t * Story 6 implements config loading; these defaults keep Story 5's production\n   149\t * path on LHC inference by using PI's first available model when present.\n   150\t */\n   151\texport function defaultAssignments(\n   152\t  model: { provider: string; id: string } = { provider: \"pi-lhc\", id: \"unconfigured\" },\n   153\t): Record<string, { provider: string; model: string; prompt: string }> {\n   154\t  return {\n   155\t    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   156\t    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   157\t    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   158\t    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   159\t    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   160\t    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   161\t    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   162\t  };\n   163\t}\n","exit_code":0,"status":"completed"}}

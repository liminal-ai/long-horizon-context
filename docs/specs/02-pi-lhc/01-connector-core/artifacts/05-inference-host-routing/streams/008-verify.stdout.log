});\n   208\t    expect(edit.ok).toBe(true);\n   209\t    if (!edit.ok) return;\n   210\t    expect(edit.value.queued.some((item) => item.workItemId === \"w-m1-prompt_smoothing-v2\")).toBe(true);\n   211\t\n   212\t    releaseFirst.resolve({ ok: true, text: \"STALE SHOULD NOT LAND\" });\n   213\t    await instance.sdk.drainSettled(threadRef);\n   214\t\n   215\t    const afterEdit = await instance.sdk.messages.show(threadRef, \"m1\");\n   216\t    expect(afterEdit.ok).toBe(true);\n   217\t    if (!afterEdit.ok) return;\n   218\t    expect(afterEdit.value.blocks[0]?.content[\"text\"]).toBe(editedText);\n   219\t    const smoothed = afterEdit.value.forms.find((form) => form.form === \"smoothed_prompt\");\n   220\t    expect(smoothed).toEqual(\n   221\t      expect.objectContaining({\n   222\t        state: \"ready\",\n   223\t        sourceVersion: 2,\n   224\t        content: expect.stringContaining(editedText),\n   225\t      }),\n   226\t    );\n   227\t    expect(smoothed?.content).not.toContain(\"STALE SHOULD NOT LAND\");\n   228\t    expect(smoothedCalls).toBeGreaterThanOrEqual(2);\n   229\t  }, 30000);\n   230\t});\n","exit_code":0,"status":"completed"}}

tifacts/quick-fix/progress/010-quick-fix.status.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/009-quick-fix.stderr.log\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/009-quick-fix.stdout.log\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/010-quick-fix.stderr.log\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/010-quick-fix.stdout.log\n?? packages/pi-lhc/src/inference/pi-ai.ts\n?? packages/pi-lhc/test/inference/\n?? packages/pi-lhc/test/lifecycle/fork.test.ts\n","exit_code":0,"status":"completed"}}

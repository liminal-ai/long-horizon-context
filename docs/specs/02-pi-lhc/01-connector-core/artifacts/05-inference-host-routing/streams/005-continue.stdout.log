{"type":"stream_event","event":{"type":"message_stop"},"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","parent_tool_use_id":null,"uuid":"163c5906-610a-4eeb-a4d5-a0ed4bccd8a1"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f355aa6d3be54fbd940afb86","type":"tool_result","content":"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/model-call.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"d822664a-92a3-4f33-a8d2-8f460d21a393","timestamp":"2026-06-14T12:44:23.983Z","tool_use_result":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/model-call.test.ts","oldString":"      const assignments: Record<string, { provider: string; model: string; prompt: string }> = {\n        smoothed_prompt: { provider: \"test\", model: \"test\", prompt: \"smoothingV1\" },\n        tool_call_summary: { provider: \"test\", model: \"test\", prompt: \"toolCallV1\" },\n        tool_result_summary: { provider: \"test\", model: \"test\", prompt: \"toolResultV1\" },\n        turn_rendering: { provider: \"test\", model: \"test\", prompt: \"turnComposeV1\" },\n        lower_band_projection: { provider: \"test\", model: \"test\", prompt: \"lowerBandV1\" },\n        chunk_summary_detailed: { provider: \"test\", model: \"test\", prompt: \"chunkDetailedV1\" },\n        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: \"chunkBriefV1\" },\n      };","newString":"      const assignments: Record<string, { provider: string; model: string; prompt: string }> = {\n        smoothed_prompt: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };","originalFile":"// TC-4.1..4.4. Model call function tests.\n//\n// TC-4.1: Function resolves (provider,model) via registry, returns text.\n// TC-4.2: Two kinds → different (provider,model) both route in one session.\n// TC-4.3: Failure shapes map to exact kinds (adapter-boundary risk test).\n// TC-4.4: Resolved-but-no-output → empty_output by adapter (not host fn).\n//\n// These tests use synthetic PI contexts (mock-free at the boundary) and assert\n// on the ModelCallResult shapes, exercising classification and routing without\n// a live provider.\nimport { describe, expect, it, vi } from \"vitest\";\nimport type { ModelCallFailureKind, ModelCallInput, ModelCall } from \"lhc\";\nimport { classifyFailure, createModelCall, DEFAULT_PROMPT_NAMES } from \"lhc\";\nimport \"../../src/inference/model-call.js\";\nimport type { ExtensionContext, ModelHandle } from \"../../src/pi/types.js\";\n\nconst INPUT: ModelCallInput = {\n  provider: \"openai\",\n  model: \"gpt-5.4\",\n  messages: [{ role: \"user\", content: \"hi\" }],\n};\n\ndescribe(\"Story 5: Inference Host Routing\", () => {\n  describe(\"TC-4.1: ModelCall resolves provider/model and returns text\", () => {\n    it(\"resolves a known model with configured auth and returns completion text\", async () => {\n      const mockHandle: ModelHandle = { provider: \"openai\", id: \"gpt-5.4\" };\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: () => mockHandle,\n          hasConfiguredAuth: () => true,\n          getAvailable: () => [mockHandle],\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },\n      };\n\n      const modelCall = createModelCall(ctx);\n      const result = await modelCall(INPUT);\n\n      expect(result.ok).toBe(true);\n      if (result.ok) {\n        expect(result.text).toBeTruthy();\n        expect(typeof result.text).toBe(\"string\");\n      }\n    });\n  });\n\n  describe(\"TC-4.2: Multi-lane routing — different kinds route to different pairs\", () => {\n    it(\"routes each call by its provider/model keys independently\", async () => {\n      const handles: ModelHandle[] = [\n        { provider: \"openai\", id: \"gpt-5.4\" },\n        { provider: \"anthropic\", id: \"claude-3-opus\" },\n        { provider: \"openai\", id: \"gpt-4o\" },\n      ];\n\n      const findMock = vi.fn(\n        (provider: string, model: string) => handles.find((h) => h.provider === provider && h.id === model),\n      ) as (provider: string, model: string) => ModelHandle | undefined;\n\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: findMock,\n          hasConfiguredAuth: () => true,\n          getAvailable: () => handles,\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },\n      };\n\n      const modelCall = createModelCall(ctx);\n\n      // Call with different provider/model pairs\n      const result1 = await modelCall({\n        ...INPUT,\n        provider: \"openai\",\n        model: \"gpt-5.4\",\n      });\n      const result2 = await modelCall({\n        ...INPUT,\n        provider: \"anthropic\",\n        model: \"claude-3-opus\",\n      });\n      const result3 = await modelCall({\n        ...INPUT,\n        provider: \"openai\",\n        model: \"gpt-4o\",\n      });\n\n      // All should succeed and route correctly\n      expect(result1.ok).toBe(true);\n      expect(result2.ok).toBe(true);\n      expect(result3.ok).toBe(true);\n\n      // Verify find was called with the correct keys\n      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-5.4\");\n      expect(findMock).toHaveBeenCalledWith(\"anthropic\", \"claude-3-opus\");\n      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-4o\");\n    });\n  });\n\n  describe(\"TC-4.3: Adapter-boundary risk — failure shapes map to exact kinds\", () => {\n    describe(\"terminal failures\", () => {\n      it(\"classifies auth failure as terminal\", async () => {\n        const ctx: ExtensionContext = {\n          cwd: \"/test\",\n          hasUI: false,\n          modelRegistry: {\n            find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n            hasConfiguredAuth: () => false, // No auth configured\n            getAvailable: () => [],\n          },\n          ui: { notify: () => {} },\n          sessionManager: { getEntries: () => [] },\n        };\n\n        const modelCall = createModelCall(ctx);\n        const result = await modelCall(INPUT);\n\n        expect(result.ok).toBe(false);\n        if (!result.ok) {\n          expect(result.kind).toBe(\"auth\");\n        }\n      });\n\n      it(\"classifies invalid_request as terminal\", async () => {\n        const ctx: ExtensionContext = {\n          cwd: \"/test\",\n          hasUI: false,\n          modelRegistry: {\n            find: () => undefined, // Model not found\n            hasConfiguredAuth: () => true,\n            getAvailable: () => [],\n          },\n          ui: { notify: () => {} },\n          sessionManager: { getEntries: () => [] },\n        };\n\n        const modelCall = createModelCall(ctx);\n        const result = await modelCall(INPUT);\n\n        expect(result.ok).toBe(false);\n        if (!result.ok) {\n          expect(result.kind).toBe(\"invalid_request\");\n        }\n      });\n    });\n\n    describe(\"retryable failures\", () => {\n      it(\"classifies rate_limit error as retryable\", () => {\n        const error = { code: \"rate_limit_exceeded\", message: \"Rate limit exceeded\" };\n        const kind = classifyFailure(error);\n        expect(kind).toBe(\"rate_limit\");\n      });\n\n      it(\"classifies timeout error as retryable\", () => {\n        const error = { code: \"request_timeout\", message: \"Request timed out\" };\n        const kind = classifyFailure(error);\n        expect(kind).toBe(\"timeout\");\n      });\n\n      it(\"classifies network error as retryable\", () => {\n        const error = { code: \"network_error\", message: \"Connection failed\" };\n        const kind = classifyFailure(error);\n        expect(kind).toBe(\"network\");\n      });\n    });\n\n    describe(\"thrown exception maps to other\", () => {\n      it(\"classifies a thrown generic error as other\", () => {\n        const error = new Error(\"Something went wrong\");\n        const kind = classifyFailure(error);\n        expect(kind).toBe(\"other\");\n      });\n\n      it(\"classifies a non-error throw as other\", () => {\n        const kind = classifyFailure(\"string error\");\n        expect(kind).toBe(\"other\");\n      });\n\n      it(\"classifies null as other\", () => {\n        const kind = classifyFailure(null);\n        expect(kind).toBe(\"other\");\n      });\n    });\n\n    describe(\"error pattern matching\", () => {\n      it(\"recognizes auth patterns in code, type, and message\", () => {\n        expect(classifyFailure({ code: \"auth_failed\" })).toBe(\"auth\");\n        expect(classifyFailure({ type: \"authentication_error\" })).toBe(\"auth\");\n        expect(classifyFailure({ message: \"Unauthorized access\" })).toBe(\"auth\");\n        expect(classifyFailure({ code: \"401\" })).toBe(\"auth\");\n      });\n\n      it(\"recognizes invalid_request patterns\", () => {\n        expect(classifyFailure({ code: \"invalid_request\" })).toBe(\"invalid_request\");\n        expect(classifyFailure({ code: \"400\" })).toBe(\"invalid_request\");\n        expect(classifyFailure({ message: \"Bad request\" })).toBe(\"invalid_request\");\n      });\n\n      it(\"recognizes rate_limit patterns\", () => {\n        expect(classifyFailure({ code: \"rate_limit\" })).toBe(\"rate_limit\");\n        expect(classifyFailure({ code: \"429\" })).toBe(\"rate_limit\");\n        expect(classifyFailure({ type: \"rate_limit_exceeded\" })).toBe(\"rate_limit\");\n      });\n\n      it(\"recognizes timeout patterns\", () => {\n        expect(classifyFailure({ code: \"timeout\" })).toBe(\"timeout\");\n        expect(classifyFailure({ code: \"408\" })).toBe(\"timeout\");\n        expect(classifyFailure({ message: \"Request timed out\" })).toBe(\"timeout\");\n      });\n\n      it(\"recognizes network patterns\", () => {\n        expect(classifyFailure({ code: \"network_error\" })).toBe(\"network\");\n        expect(classifyFailure({ code: \"ECONNREFUSED\" })).toBe(\"network\");\n        expect(classifyFailure({ type: \"connection_error\" })).toBe(\"network\");\n      });\n    });\n  });\n\n  describe(\"TC-4.4: Host function never returns empty_output\", () => {\n    it(\"returns ok:true with empty text when completion produces no output\", async () => {\n      // The host function contract: returns text or failure, never empty_output kind.\n      // Empty output is classified by LHC's adapter, not the host function.\n\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n          hasConfiguredAuth: () => true,\n          getAvailable: () => [],\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },\n      };\n\n      const modelCall = createModelCall(ctx);\n\n      // The deterministic complete returns text with content\n      const result = await modelCall(INPUT);\n\n      // The key assertion: the function returns ok:true (never a failure with empty_output kind)\n      expect(result.ok).toBe(true);\n      // The empty_output classification is done by LHC's adapter, not by this function\n    });\n\n    it(\"LHC adapter classifies empty resolved output as empty_output\", async () => {\n      // This test verifies that when a ModelCall returns empty text,\n      // LHC's adapter classifies it as empty_output (not the host function).\n      //\n      // We create a ModelCall that returns empty text, wire it into LHC,\n      // trigger a derivation, and verify the adapter classifies the empty output.\n\n      const emptyModelCall: ModelCall = async () => ({\n        ok: true,\n        text: \"\", // Empty completion text\n      });\n\n      const assignments: Record<string, { provider: string; model: string; prompt: string }> = {\n        smoothed_prompt: { provider: \"test\", model: \"test\", prompt: \"smoothingV1\" },\n        tool_call_summary: { provider: \"test\", model: \"test\", prompt: \"toolCallV1\" },\n        tool_result_summary: { provider: \"test\", model: \"test\", prompt: \"toolResultV1\" },\n        turn_rendering: { provider: \"test\", model: \"test\", prompt: \"turnComposeV1\" },\n        lower_band_projection: { provider: \"test\", model: \"test\", prompt: \"lowerBandV1\" },\n        chunk_summary_detailed: { provider: \"test\", model: \"test\", prompt: \"chunkDetailedV1\" },\n        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: \"chunkBriefV1\" },\n      };\n\n      // Create an LHC instance with the empty-returning ModelCall\n      const { createSdk } = await import(\"lhc\");\n      const sdk = createSdk({\n        inference: {\n          call: emptyModelCall,\n          assignments,\n        },\n        mode: \"background\",\n      });\n\n      // Create a temp thread\n      const { tempStore: tempStore } = await import(\"../fixtures/thread.js\");\n      const store = tempStore();\n      const { threads } = await import(\"lhc\");\n\n      const created = await threads.newThread({\n        filePath: store.threadPath(),\n        registryPath: store.registryPath,\n      });\n      if (!created.ok) {\n        store.cleanup();\n        throw new Error(`Failed to create thread: ${created.error.reason}`);\n      }\n\n      const threadRef = { filePath: store.threadPath() };\n\n      // Intake a turn to trigger derivation\n      const { intakeStream } = await import(\"lhc\");\n      const intakeResult = await intakeStream.messageEvents(threadRef, [\n        {\n          eventKind: \"user_prompt\",\n          idempotencyKey: \"test-key-1\",\n          actor: \"test\",\n          harness: \"pi\",\n          payload: { text: \"test prompt\" },\n        },\n        {\n          eventKind: \"assistant_text\",\n          idempotencyKey: \"test-key-2\",\n          actor: \"test\",\n          harness: \"pi\",\n          payload: { text: \"test response\" },\n        },\n        {\n          eventKind: \"turn_end\",\n          idempotencyKey: \"test-key-3\",\n          actor: \"test\",\n          harness: \"pi\",\n          payload: {},\n        },\n      ]);\n      expect(intakeResult.ok).toBe(true);\n\n      // Drain the scheduler\n      await sdk.drainSettled(threadRef);\n\n      // Query health to verify the empty_output classification\n      const { inspect } = await import(\"lhc\");\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n\n      if (health.ok) {\n        // The adapter should have classified the empty output as empty_output\n        // Check for failures with empty_output kind\n        const emptyOutputFailures = health.value.failures.filter(\n          (f) => f.reason === \"empty_output\" || f.lastError?.includes(\"empty_output\"),\n        );\n\n        // At least one derivation should have been classified as empty_output\n        expect(emptyOutputFailures.length).toBeGreaterThan(0);\n      }\n\n      store.cleanup();\n    });\n  });\n});\n","structuredPatch":[{"oldStart":261,"oldLines":13,"newStart":261,"newLines":13,"lines":["       });"," ","       const assignments: Record<string, { provider: string; model: string; prompt: string }> = {","-        smoothed_prompt: { provider: \"test\", model: \"test\", prompt: \"smoothingV1\" },","-        tool_call_summary: { provider: \"test\", model: \"test\", prompt: \"toolCallV1\" },","-        tool_result_summary: { provider: \"test\", model: \"test\", prompt: \"toolResultV1\" },","-        turn_rendering: { provider: \"test\", model: \"test\", prompt: \"turnComposeV1\" },","-        lower_band_projection: { provider: \"test\", model: \"test\", prompt: \"lowerBandV1\" },","-        chunk_summary_detailed: { provider: \"test\", model: \"test\", prompt: \"chunkDetailedV1\" },","-        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: \"chunkBriefV1\" },","+        smoothed_prompt: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },","+        tool_call_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },","+        tool_result_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },","+        turn_rendering: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },","+        lower_band_projection: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },","+        chunk_summary_detailed: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },","+        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },","       };"," ","       // Create an LHC instance with the empty-returning ModelCall"]}],"userModified":false,"replaceAll":false}}

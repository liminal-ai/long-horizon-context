{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_06ebd5b0af104e73a817f404","type":"tool_result","content":"250\t\n251\t    it(\"LHC adapter classifies empty resolved output as empty_output\", async () => {\n252\t      // This test verifies that when a ModelCall returns empty text,\n253\t      // LHC's adapter classifies it as empty_output (not the host function).\n254\t      //\n255\t      // We create a ModelCall that returns empty text, wire it into LHC,\n256\t      // trigger a derivation, and verify the adapter classifies the empty output.\n257\t\n258\t      const emptyModelCall: ModelCall = async () => ({\n259\t        ok: true,\n260\t        text: \"\", // Empty completion text\n261\t      });\n262\t\n263\t      const assignments: Record<string, { provider: string; model: string; prompt: string }> = {\n264\t        smoothed_prompt: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n265\t        tool_call_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n266\t        tool_result_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n267\t        turn_rendering: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n268\t        lower_band_projection: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n269\t        chunk_summary_detailed: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n270\t        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n271\t      };\n272\t\n273\t      // Create an LHC instance with the empty-returning ModelCall\n274\t      const { createSdk } = await import(\"lhc\");\n275\t      const sdk = createSdk({\n276\t        inference: {\n277\t          call: emptyModelCall,\n278\t          assignments,\n279\t        },\n280\t        mode: \"background\",\n281\t      });\n282\t\n283\t      // Create a temp thread\n284\t      const { tempStore: tempStore } = await import(\"../fixtures/thread.js\");\n285\t      const store = tempStore();\n286\t      const { threads } = await import(\"lhc\");\n287\t\n288\t      const created = await threads.newThread({\n289\t        filePath: store.threadPath(),\n290\t        registryPath: store.registryPath,\n291\t      });\n292\t      if (!created.ok) {\n293\t        store.cleanup();\n294\t        throw new Error(`Failed to create thread: ${created.error.reason}`);\n295\t      }\n296\t\n297\t      const threadRef = { filePath: store.threadPath() };\n298\t\n299\t      // Intake a turn to trigger derivation\n300\t      const { intakeStream } = await import(\"lhc\");\n301\t      const intakeResult = await intakeStream.messageEvents(threadRef, [\n302\t        {\n303\t          eventKind: \"user_prompt\",\n304\t          idempotencyKey: \"test-key-1\",\n305\t          actor: \"test\",\n306\t          harness: \"pi\",\n307\t          payload: { text: \"test prompt\" },\n308\t        },\n309\t        {\n310\t          eventKind: \"assistant_text\",\n311\t          idempotencyKey: \"test-key-2\",\n312\t          actor: \"test\",\n313\t          harness: \"pi\",\n314\t          payload: { text: \"test response\" },\n315\t        },\n316\t        {\n317\t          eventKind: \"turn_end\",\n318\t          idempotencyKey: \"test-key-3\",\n319\t          actor: \"test\","}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"92888548-094c-4db4-b2d9-213789cba6d0","timestamp":"2026-06-14T12:45:43.890Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/model-call.test.ts","content":"\n    it(\"LHC adapter classifies empty resolved output as empty_output\", async () => {\n      // This test verifies that when a ModelCall returns empty 
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_881964a312564abdbdfdbea5","type":"tool_result","content":"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"45d15fe9-fa8d-4520-adc5-bffc2582e6fb","timestamp":"2026-06-14T12:45:38.823Z","tool_use_result":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts","oldString":"        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });","newString":"        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: routerWithFallback,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });","originalFile":"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\n// injected ModelCall function and persists outcomes queryable through\n// inspect/health.\n//\n// This test proves the full capture → derivation → recorded-outcome loop, not\n// just the function in isolation. It:\n// 1. Captures content to a thread (through the real converter)\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\n// 3. Awaits drainSettled to flush background work\n// 4. Asserts both ready forms and classified failures exist in the thread\n//\n// Architecture-risk test: concurrency/lost-update — a stale background result does\n// not clobber newer thread state.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  intakeStream,\n  threads,\n  DEFAULT_PROMPT_NAMES,\n  type FormKind,\n  type InferenceConfig,\n  type ModelAssignment,\n  type ModelCall,\n  type ModelCallFailureKind,\n  type ModelCallResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \"../fixtures/synthetic.js\";\nimport type { TempStore } from \"../fixtures/thread.js\";\nimport { tempStore } from \"../fixtures/thread.js\";\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \"../fixtures/model-call.js\";\n\ndescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n  let store: TempStore;\n  let connector: Connector;\n  let ctx: ExtensionContext;\n  let threadRef: ThreadRef | null;\n\n  beforeEach(async () => {\n    store = tempStore();\n    threadRef = null;\n\n    // Synthetic headless context\n    ctx = {\n      cwd: \"/test/closed-loop\",\n      hasUI: false,\n      modelRegistry: {\n        find: (provider: string, model: string) => {\n          // Recognize both openai and anthropic models\n          if (provider === \"openai\" && model === \"gpt-5.4\") {\n            return { provider, id: model };\n          }\n          if (provider === \"anthropic\" && model === \"claude-3\") {\n            return { provider, id: model };\n          }\n          return undefined;\n        },\n        hasConfiguredAuth: (model: { provider: string; id: string }) => {\n          // All models have auth configured in tests\n          return true;\n        },\n        getAvailable: () => [],\n      },\n      ui: { notify: () => {} },\n      sessionManager: { getEntries: () => [] },\n    };\n  });\n\n  afterEach(async () => {\n    if (connector !== null && threadRef !== null) {\n      try {\n        await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n      } catch (e) {\n        // Ignore cleanup errors in tests\n        console.warn(\"Cleanup error:\", e);\n      }\n    }\n    store.cleanup();\n  });\n\n  describe(\"TC-4.5: Capture → derivation → recorded-outcome loop\", () => {\n    it(\"captured thread's queued derivation invokes function and persists ready form + classified failure\", async () => {\n      // TC-4.5 requires ONE ready derived form AND ONE classified failure,\n      // both queryable through inspect/health.\n      //\n      // Use a ModelCall router that returns:\n      // - text for most kinds (producing ready forms)\n      // - failure for one kind (producing classified failures)\n      const modelCall = fakeModelCallRouter({\n        \"test/test\": fakeModelCallText(\"derived text\"),\n      });\n      // Use a fallback that returns failure for unrouted keys\n      const failureCall = fakeModelCallFailure(\"rate_limit\", \"Rate limited\");\n      const routerWithFallback: ModelCall = (input) => {\n        // Route test/test to success, everything else to failure\n        if (input.provider === \"test\" && input.model === \"test\") {\n          return modelCall(input);\n        }\n        return failureCall(input);\n      };\n\n      const assignments: Record<FormKind, ModelAssignment> = {\n        // These use test/test and will succeed\n        smoothed_prompt: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        // lower_band_projection uses different keys - will fail\n        lower_band_projection: { provider: \"other\", model: \"other\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture content — a user prompt and assistant response (one turn)\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"please summarize this file\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"here is the summary\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \"here is the summary\" })],\n      });\n\n      // Get the instance and drain the background scheduler\n      const instance = connector.getInstance();\n      expect(instance).not.toBeNull();\n      if (!instance) return;\n\n      // Await drainSettled — all derivations complete or fail\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query inspect.health for derivation outcomes\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (!health.ok) return;\n\n      const report = health.value;\n\n      // Assert: at least ONE ready derived form exists (from openai lane)\n      // Health report has owners array with counts per kind\n      const readyOwners = report.owners.filter((o) => o.counts.ready > 0);\n      expect(readyOwners.length).toBeGreaterThan(0);\n\n      // Assert: at least ONE classified failure exists (from anthropic lane)\n      // Check the failures array for rate_limit failure\n      const rateLimitFailures = report.failures.filter((f) => f.reason.includes(\"rate_limit\"));\n      expect(rateLimitFailures.length).toBeGreaterThan(0);\n\n      // Also verify that the failed count in owners reflects the failure\n      const failedOwners = report.owners.filter((o) => o.counts.failed > 0);\n      expect(failedOwners.length).toBeGreaterThan(0);\n    }, 30000); // Increase timeout to 30s for this test\n\n    it(\"verify outcomes are queryable through inspect (not just internal state)\", async () => {\n      // This test verifies the same loop but asserts specifically on the\n      // inspect surface, proving outcomes are queryable (not just internal)\n      const modelCall = fakeModelCallText(\"success\");\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture a turn\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"test prompt\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"test response\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage()],\n      });\n\n      const instance = connector.getInstance();\n      if (!instance) return;\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query through inspect\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (health.ok) {\n        // Health report contains owners with form counts\n        expect(health.value.owners).toBeInstanceOf(Array);\n        expect(health.value.owners.length).toBeGreaterThan(0);\n      }\n\n      const overview = await inspect.overview(threadRef);\n      expect(overview.ok).toBe(true);\n      if (overview.ok) {\n        // Overview shows turn count\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\n      }\n    });\n\n    describe(\"Architecture-risk: Concurrency / Lost Update\", () => {\n      it(\"stale background derivation result does not clobber newer thread state\", async () => {\n        // This test verifies that a stale result from the background scheduler\n        // does not overwrite newer state. LHC owns this guarantee, but the test\n        // proves the connector's wiring doesn't break it.\n\n        const modelCall = fakeModelCallText(\"result\");\n\n        const assignments: Record<FormKind, ModelAssignment> = {\n          smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n          tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n          tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n          turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n          lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n          chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n          chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n        };\n\n        const inferenceConfig: InferenceConfig = {\n          call: modelCall,\n          assignments,\n        };\n\n        const sdkConfig: SdkConfig = {\n          inference: inferenceConfig,\n          mode: \"background\",\n        };\n\n        connector = createConnector({\n          registryPath: store.registryPath,\n          newThreadFilePath: () => store.threadPath(),\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n        });\n\n        await connector.handlers.session_start(ctx, { reason: \"new\" });\n        const state = connector.getState();\n        expect(state).not.toBeNull();\n        if (!state) return;\n        threadRef = state.threadRef;\n\n        // Capture a turn\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"first prompt\"),\n          entryId: \"entry-1\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"first response\" }),\n          entryId: \"entry-2\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        const instance = connector.getInstance();\n        if (!instance) return;\n\n        // Drain first round\n        await instance.sdk.drainSettled(threadRef);\n\n        // Capture another turn (newer state)\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"second prompt\"),\n          entryId: \"entry-3\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"second response\" }),\n          entryId: \"entry-4\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        // Drain second round\n        await instance.sdk.drainSettled(threadRef);\n\n        // Verify both turns exist and no corruption occurred\n        const overview = await inspect.overview(threadRef);\n        expect(overview.ok).toBe(true);\n        if (overview.ok) {\n          // Should have 2 closed turns\n          expect(overview.value.turns.closed).toBe(2);\n        }\n\n        // Verify forms exist for both turns\n        const health = await inspect.health(threadRef);\n        expect(health.ok).toBe(true);\n        if (health.ok) {\n          // Should have owners with forms\n          expect(health.value.owners.length).toBeGreaterThan(0);\n        }\n      });\n\n      it(\"forces a stale background result against advanced state and asserts newer state wins\", async () => {\n        // TC-4.5 concurrency risk test: force a stale background derivation result\n        // against advanced state and assert the newer state wins.\n        //\n        // This test simulates a race where background work for an earlier turn\n        // completes after the thread has advanced, ensuring the stale result\n        // does not clobber the newer state.\n\n        const callCount = { count: 0 };\n        const modelCall = fakeModelCallText(\"result\");\n\n        const assignments: Record<FormKind, ModelAssignment> = {\n          smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n          tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n          tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n          turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n          lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n          chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n          chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n        };\n\n        const inferenceConfig: InferenceConfig = {\n          call: modelCall,\n          assignments,\n        };\n\n        const sdkConfig: SdkConfig = {\n          inference: inferenceConfig,\n          mode: \"background\",\n        };\n\n        connector = createConnector({\n          registryPath: store.registryPath,\n          newThreadFilePath: () => store.threadPath(),\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n        });\n\n        await connector.handlers.session_start(ctx, { reason: \"new\" });\n        const state = connector.getState();\n        expect(state).not.toBeNull();\n        if (!state) return;\n        threadRef = state.threadRef;\n\n        const instance = connector.getInstance();\n        if (!instance) return;\n\n        // Capture first turn\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"first prompt\"),\n          entryId: \"entry-1\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"first response\" }),\n          entryId: \"entry-2\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        // DON'T drain yet - let the background work queue up\n\n        // Capture second turn immediately (advancing state while first turn's\n        // derivations are still pending in the background)\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"second prompt\"),\n          entryId: \"entry-3\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"second response\" }),\n          entryId: \"entry-4\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        // Now drain - this processes both turns' derivations\n        await instance.sdk.drainSettled(threadRef);\n\n        // Verify both turns exist and the state is consistent\n        const overview = await inspect.overview(threadRef);\n        expect(overview.ok).toBe(true);\n        if (overview.ok) {\n          // Should have 2 closed turns\n          expect(overview.value.turns.closed).toBe(2);\n        }\n\n        // Verify no data corruption - both turns should have their forms\n        const health = await inspect.health(threadRef);\n        expect(health.ok).toBe(true);\n        if (health.ok) {\n          // The newer state (second turn) should not have been clobbered by\n          // stale results from the first turn\n          expect(health.value.owners.length).toBeGreaterThan(0);\n\n          // Verify there are no \"lost update\" failures - all forms that\n          // completed should have valid state\n          const failedForms = health.value.failures.filter(\n            (f) => f.reason.includes(\"clobber\") || f.reason.includes(\"stale\") || f.reason.includes(\"conflict\"),\n          );\n          expect(failedForms.length).toBe(0);\n        }\n      });\n    });\n  });\n});\n","structuredPatch":[{"oldStart":116,"oldLines":7,"newStart":116,"newLines":7,"lines":["       };"," ","       const inferenceConfig: InferenceConfig = {","-        call: modelCall,","+        call: routerWithFallback,","         assignments,","       };"," "]}],"userModified":false,"replaceAll":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b85f41534a9846dab76803dd","type":"tool_result","content":"220\t    });\n221\t  });\n222\t\n223\t  describe(\"TC-4.4: Host function never returns empty_output\", () => {\n224\t    it(\"returns ok:true with empty text when completion produces no output\", async () => {\n225\t      // Mock the internal complete to return empty content\n226\t      // In the real implementation, this would be from pi-ai\n227\t      // For this test, we verify the function's contract directly\n228\t\n229\t      const ctx: ExtensionContext = {\n230\t        cwd: \"/test\",\n231\t        hasUI: false,\n232\t        modelRegistry: {\n233\t          find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n234\t          hasConfiguredAuth: () => true,\n235\t          getAvailable: () => [],\n236\t        },\n237\t        ui: { notify: () => {} },\n238\t        sessionManager: { getEntries: () => [] },\n239\t      };\n240\t\n241\t      const modelCall = createModelCall(ctx);\n242\t\n243\t      // The mock implementation currently returns a placeholder text\n244\t      // In a real scenario with pi-ai returning empty content, the function\n245\t      // would still return { ok: true, text: \"\" } - not { ok: false, kind: \"empty_output\" }\n246\t      const result = await modelCall(INPUT);\n247\t\n248\t      // The key assertion: the function returns ok:true (never a failure with empty_output kind)\n249\t      expect(result.ok).toBe(true);\n250\t      // The empty_output classification is done by LHC's adapter, not by this function\n251\t    });\n252\t  });\n253\t});\n254\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"4d96aefc-59ac-4052-9871-5f18ca716438","timestamp":"2026-06-14T12:41:36.044Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/model-call.test.ts","content":"    });\n  });\n\n  describe(\"TC-4.4: Host function never returns empty_output\", () => {\n    it(\"returns ok:true with empty text when completion produces no output\", async () => {\n      // Mock the internal complete to return empty content\n      // In the real implementation, this would be from pi-ai\n      // For this test, we verify the function's contract directly\n\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n          hasConfiguredAuth: () => true,\n          getAvailable: () => [],\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },\n      };\n\n      const modelCall = createModelCall(ctx);\n\n      // The mock implementation currently returns a placeholder text\n      // In a real scenario with pi-ai returning empty content, the function\n      // would still return { ok: true, text: \"\" } - not { ok: false, kind: \"empty_output\" }\n      const result = await modelCall(INPUT);\n\n      // The key assertion: the function returns ok:true (never a failure with empty_output kind)\n      expect(result.ok).toBe(true);\n      // The empty_output classification is done by LHC's adapter, not by this function\n    });\n  });\n});\n","numLines":35,"startLine":220,"totalLines":254}}}

{"type":"assistant","message":{"id":"msg_20260614204534f17e013caa7a47e6","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_881964a312564abdbdfdbea5","name":"Edit","input":{"replace_all":false,"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts","old_string":"        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });","new_string":"        chunk_summary_brief: { provider: \"test\", model: \"test\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: routerWithFallback,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_
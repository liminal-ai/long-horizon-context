{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9ac148c59ab14f22802925fe","type":"tool_result","content":"40\t}\n41\t\n42\tfunction idOf(ref: ThreadRef): string {\n43\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n44\t  return ref.threadId;\n45\t}\n46\t\n47\tfunction deps(cwd = \"/work/default\"): ResolveDeps {\n48\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n49\t}\n50\t\n51\t// Create a thread directly with explicit cwd/title, for picker fixtures and\n52\t// existing-thread setup. (Connector-created threads get cwd plus a default title\n53\t// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\n54\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n55\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n56\t    filePath: store.threadPath(),\n57\t    registryPath: store.registryPath,\n58\t  };\n59\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n60\t  if (opts.title !== undefined) input.title = opts.title;\n61\t  const created = await threads.newThread(input);\n62\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n63\t  return created.value.threadId;\n64\t}\n65\t\n66\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n67\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\n68\t// object, modelling PI handing a fresh ctx to each hook.\n69\tfunction syntheticCtx(cwd: string): ExtensionContext {\n70\t  return {\n71\t    cwd,\n72\t    hasUI: false,\n73\t    modelRegistry: {\n74\t      find: () => undefined,\n75\t      hasConfiguredAuth: () => false,\n76\t      getAvailable: () => [],\n77\t    },\n78\t    ui: { notify: () => {} },\n79\t    sessionManager: { getEntries: () => [] },\n80\t  };\n81\t}\n82\t\n83\t// A connector wired with production defaults (real SDK config + selector) and\n84\t// only environment overrides — the activate() path, minus the global registry\n85\t// and process.argv.\n86\tfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n87\t  return createConnector({\n88\t    registryPath: store.registryPath,\n89\t    newThreadFilePath: () => store.threadPath(),"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"648bae5f-99a9-4d09-982a-bec9b618b356","timestamp":"2026-06-14T12:43:18.924Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts","content":"}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\nfunction deps(cwd = \"/work/default\"): ResolveDeps {\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n}\n\n// Create a thread directly with explicit cwd/title, for picker fixtures and\n// existing-thread setup. (Connector-created threads get cwd plus a default title\n// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  };\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n  if (opts.title !== undefined) input.title = opts.title;\n  const created = await threads.newThread(input);\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n  return created.value.threadId;\n}\n\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\n// object, modelling PI handing a fresh ctx to each hook.\nfunction syntheticCtx(cwd: string): ExtensionContext {\n  return {\n    cwd,\n    hasUI: false,\n    modelRegistry: {\n      find: () => undefined,\n      hasConfiguredAuth: () => false,\n      getAvailable: () => [],\n    },\n    ui: { notify: () => {} },\n    sessionManager: { getEntries: () => [] },\n  };\n}\n\n// A connector wired with production defaults (real SDK config + selector) and\n// only environment overrides — the activate() path, minus the global registry\n// and process.argv.\nfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n  return createConnector({\n    registryPath: store.registryPath,\n    newThreadFilePath: () => store.threadPath(),","numLines":50,"startLine":40,"totalLines":406}}}

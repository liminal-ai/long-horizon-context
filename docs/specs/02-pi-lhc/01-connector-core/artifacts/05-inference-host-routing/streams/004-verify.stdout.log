{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/inference/closed-loop.test.ts | sed -n '145,315p'\"","aggregated_output":"   145\t      expect(readyOwners.length).toBeGreaterThan(0);\n   146\t\n   147\t      // The fact that drainSettled completed and we have ready forms proves\n   148\t      // the capture → derivation → recorded-outcome loop works end-to-end\n   149\t    }, 30000); // Increase timeout to 30s for this test\n   150\t\n   151\t    it(\"verify outcomes are queryable through inspect (not just internal state)\", async () => {\n   152\t      // This test verifies the same loop but asserts specifically on the\n   153\t      // inspect surface, proving outcomes are queryable (not just internal)\n   154\t      const modelCall = fakeModelCallText(\"success\");\n   155\t      const assignments: Record<FormKind, ModelAssignment> = {\n   156\t        smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   157\t        tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   158\t        tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   159\t        turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   160\t        lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   161\t        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   162\t        chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   163\t      };\n   164\t\n   165\t      const inferenceConfig: InferenceConfig = {\n   166\t        call: modelCall,\n   167\t        assignments,\n   168\t      };\n   169\t\n   170\t      const sdkConfig: SdkConfig = {\n   171\t        inference: inferenceConfig,\n   172\t        mode: \"background\",\n   173\t      };\n   174\t\n   175\t      connector = createConnector({\n   176\t        registryPath: store.registryPath,\n   177\t        newThreadFilePath: () => store.threadPath(),\n   178\t        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n   179\t      });\n   180\t\n   181\t      await connector.handlers.session_start(ctx, { reason: \"new\" });\n   182\t      const state = connector.getState();\n   183\t      expect(state).not.toBeNull();\n   184\t      if (!state) return;\n   185\t      threadRef = state.threadRef;\n   186\t\n   187\t      // Capture a turn\n   188\t      await connector.handlers.message_end(ctx, {\n   189\t        message: makeUserMessage(\"test prompt\"),\n   190\t        entryId: \"entry-1\",\n   191\t      });\n   192\t      await connector.handlers.message_end(ctx, {\n   193\t        message: makeAssistantMessage({ text: \"test response\" }),\n   194\t        entryId: \"entry-2\",\n   195\t      });\n   196\t      await connector.handlers.agent_end(ctx, {\n   197\t        messages: [makeUserMessage(), makeAssistantMessage()],\n   198\t      });\n   199\t\n   200\t      const instance = connector.getInstance();\n   201\t      if (!instance) return;\n   202\t      await instance.sdk.drainSettled(threadRef);\n   203\t\n   204\t      // Query through inspect\n   205\t      const health = await inspect.health(threadRef);\n   206\t      expect(health.ok).toBe(true);\n   207\t      if (health.ok) {\n   208\t        // Health report contains owners with form counts\n   209\t        expect(health.value.owners).toBeInstanceOf(Array);\n   210\t        expect(health.value.owners.length).toBeGreaterThan(0);\n   211\t      }\n   212\t\n   213\t      const overview = await inspect.overview(threadRef);\n   214\t      expect(overview.ok).toBe(true);\n   215\t      if (overview.ok) {\n   216\t        // Overview shows turn count\n   217\t        expect(overview.value.turns.closed).toBeGreaterThan(0);\n   218\t      }\n   219\t    });\n   220\t\n   221\t    describe(\"Architecture-risk: Concurrency / Lost Update\", () => {\n   222\t      it(\"stale background derivation result does not clobber newer thread state\", async () => {\n   223\t        // This test verifies that a stale result from the background scheduler\n   224\t        // does not overwrite newer state. LHC owns this guarantee, but the test\n   225\t        // proves the connector's wiring doesn't break it.\n   226\t\n   227\t        const modelCall = fakeModelCallText(\"result\");\n   228\t\n   229\t        const assignments: Record<FormKind, ModelAssignment> = {\n   230\t          smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   231\t          tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   232\t          tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   233\t          turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   234\t          lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   235\t          chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   236\t          chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   237\t        };\n   238\t\n   239\t        const inferenceConfig: InferenceConfig = {\n   240\t          call: modelCall,\n   241\t          assignments,\n   242\t        };\n   243\t\n   244\t        const sdkConfig: SdkConfig = {\n   245\t          inference: inferenceConfig,\n   246\t          mode: \"background\",\n   247\t        };\n   248\t\n   249\t        connector = createConnector({\n   250\t          registryPath: store.registryPath,\n   251\t          newThreadFilePath: () => store.threadPath(),\n   252\t          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n   253\t        });\n   254\t\n   255\t        await connector.handlers.session_start(ctx, { reason: \"new\" });\n   256\t        const state = connector.getState();\n   257\t        expect(state).not.toBeNull();\n   258\t        if (!state) return;\n   259\t        threadRef = state.threadRef;\n   260\t\n   261\t        // Capture a turn\n   262\t        await connector.handlers.message_end(ctx, {\n   263\t          message: makeUserMessage(\"first prompt\"),\n   264\t          entryId: \"entry-1\",\n   265\t        });\n   266\t        await connector.handlers.message_end(ctx, {\n   267\t          message: makeAssistantMessage({ text: \"first response\" }),\n   268\t          entryId: \"entry-2\",\n   269\t        });\n   270\t        await connector.handlers.agent_end(ctx, {\n   271\t          messages: [makeUserMessage(), makeAssistantMessage()],\n   272\t        });\n   273\t\n   274\t        const instance = connector.getInstance();\n   275\t        if (!instance) return;\n   276\t\n   277\t        // Drain first round\n   278\t        await instance.sdk.drainSettled(threadRef);\n   279\t\n   280\t        // Capture another turn (newer state)\n   281\t        await connector.handlers.message_end(ctx, {\n   282\t          message: makeUserMessage(\"second prompt\"),\n   283\t          entryId: \"entry-3\",\n   284\t        });\n   285\t        await connector.handlers.message_end(ctx, {\n   286\t          message: makeAssistantMessage({ text: \"second response\" }),\n   287\t          entryId: \"entry-4\",\n   288\t        });\n   289\t        await connector.handlers.agent_end(ctx, {\n   290\t          messages: [makeUserMessage(), makeAssistantMessage()],\n   291\t        });\n   292\t\n   293\t        // Drain second round\n   294\t        await instance.sdk.drainSettled(threadRef);\n   295\t\n   296\t        // Verify both turns exist and no corruption occurred\n   297\t        const overview = await inspect.overview(threadRef);\n   298\t        expect(overview.ok).toBe(true);\n   299\t        if (overview.ok) {\n   300\t          // Should have 2 closed turns\n   301\t          expect(overview.value.turns.closed).toBe(2);\n   302\t        }\n   303\t\n   304\t        // Verify forms exist for both turns\n   305\t        const health = await inspect.health(threadRef);\n   306\t        expect(health.ok).toBe(true);\n   307\t        if (health.ok) {\n   308\t          // Should have owners with forms\n   309\t          expect(health.value.owners.length).toBeGreaterThan(0);\n   310\t        }\n   311\t      });\n   312\t    });\n   313\t  });\n   314\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/inference/types.ts | sed -n '1,70p'\"","aggregated_output":"     1\t// Epic 05 boundary vocabulary (tech design §Interface Definitions): the one\n     2\t// function a host supplies, its structured result shapes, and the config that\n     3\t// arrives at createSdk as the alternative to direct provider injection\n     4\t// (DD-1, DD-5). LHC treats provider/model strings as opaque routing keys —\n     5\t// the host's ModelCall implementation is the only code that interprets them.\n     6\timport type { FormKind } from \"../shared/derivation.js\";\n     7\t\n     8\t/** The one function a host supplies. Single-turn completion; provider/model\n     9\t *  are opaque routing keys the host's implementation interprets. (AC-1.2) */\n    10\texport type ModelCall = (input: ModelCallInput) => Promise<ModelCallResult>;\n    11\t\n    12\texport interface ModelCallInput {\n    13\t  provider: string;\n    14\t  model: string;\n    15\t  messages: { role: \"system\" | \"user\"; content: string }[];\n    16\t}\n    17\t\n    18\texport type ModelCallResult =\n    19\t  | { ok: true; text: string }\n    20\t  | { ok: false; kind: ModelCallFailureKind; message: string };\n    21\t\n    22\t/** `empty_output` is adapter-generated (AC-2.4); hosts never return it.\n    23\t *  Thrown exceptions classify as `other` (AC-3.3). */\n    24\texport type ModelCallFailureKind =\n    25\t  | \"rate_limit\"\n    26\t  | \"timeout\"\n    27\t  | \"network\"\n    28\t  | \"empty_output\"\n    29\t  | \"other\"\n    30\t  | \"auth\"\n    31\t  | \"invalid_request\";\n    32\t\n    33\texport interface ModelAssignment {\n    34\t  provider: string;\n    35\t  model: string;\n    36\t  prompt: string; // must name a PROMPT_REGISTRY entry (AC-1.3)\n    37\t}\n    38\t\n    39\t/** SdkConfig.inference — the alternative to SdkConfig.provider (DD-5). */\n    40\texport interface InferenceConfig {\n    41\t  call: ModelCall;\n    42\t  assignments: Record<FormKind, ModelAssignment>; // all seven, validated complete\n    43\t  timeoutMs?: number; // default 60_000 (DD-6)\n    44\t  maxInputChars?: number; // default 200_000 (DD-7)\n    45\t}\n    46\t\n    47\t/** InferenceConfig after createSdk validation: every optional filled. */\n    48\texport interface ResolvedInferenceConfig {\n    49\t  call: ModelCall;\n    50\t  assignments: Record<FormKind, ModelAssignment>;\n    51\t  timeoutMs: number;\n    52\t  maxInputChars: number;\n    53\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/inference/adapter.ts | sed -n '1,115p'\"","aggregated_output":"     1\t// The real provider (DD-2): createInferenceProvider returns the same\n     2\t// DerivationProvider interface the deterministic provider implements, so\n     3\t// createSdk and everything below it see a provider, full stop. Every\n     4\t// operation is the same five-step pipeline (Flow 2): bound the input where\n     5\t// DD-7 applies, render the kind's prompt template into single-turn messages,\n     6\t// call the host ModelCall with the kind's assignment, reject empty or\n     7\t// whitespace-only text as empty_output (AC-2.4), and return the shaped text\n     8\t// with config-known provenance (AC-2.5). The adapter never parses model text\n     9\t// for outcomes, receipts, or any mechanical fact — those stay\n    10\t// handler-authored from the record. Host containment (thrown exceptions,\n    11\t// the adapter-owned timeout) lives in safeCall (AC-3.3, DD-6).\n    12\timport type {\n    13\t  DerivationProvider,\n    14\t  FormKind,\n    15\t  ProviderResult,\n    16\t} from \"../shared/derivation.js\";\n    17\timport { FAILURE_CLASSIFICATION, safeCall } from \"./classify.js\";\n    18\timport { PROMPT_REGISTRY, type PromptTemplate } from \"./prompts/index.js\";\n    19\timport type { ModelCallFailureKind, ResolvedInferenceConfig } from \"./types.js\";\n    20\t\n    21\t// DD-7: a pathological tool result must not blow a small-context model.\n    22\t// Content over the bound keeps its head and tail around a marker, and the\n    23\t// bounded whole stays within maxInputChars; bounding happens before prompt\n    24\t// rendering, so the dropped middle never crosses the boundary.\n    25\tfunction boundContent(content: string, maxInputChars: number): string {\n    26\t  if (content.length <= maxInputChars) return content;\n    27\t  const marker = `\\n\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\n\\n`;\n    28\t  // The marker only earns its place when head + marker + tail still fits the\n    29\t  // bound. When maxInputChars is smaller than the marker itself, there is no\n    30\t  // budget for the marker — emitting it would be the one path that crosses the\n    31\t  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\n    32\t  // honors the cap exactly.\n    33\t  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\n    34\t  const keep = maxInputChars - marker.length;\n    35\t  const head = Math.ceil(keep / 2);\n    36\t  const tail = keep - head;\n    37\t  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \"\");\n    38\t}\n    39\t\n    40\t// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\n    41\t// has, and the reason string is machine-readable by the established\n    42\t// code-before-first-colon convention. Retryable failures lead with\n    43\t// `provider_failure` — the code Epic 02 has always landed on exhausted forms\n    44\t// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\n    45\t// with the failure kind named next; terminal kinds lead with the kind itself\n    46\t// and land failed immediately.\n    47\tfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\n    48\t  const { retryable } = FAILURE_CLASSIFICATION[kind];\n    49\t  const detail = message === \"\" ? kind : `${kind}: ${message}`;\n    50\t  return {\n    51\t    ok: false,\n    52\t    retryable,\n    53\t    reason: retryable ? `provider_failure: ${detail}` : detail,\n    54\t  };\n    55\t}\n    56\t\n    57\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\n    58\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\n    59\t    const assignment = config.assignments[kind];\n    60\t    // Construction validated the name (AC-1.3); a miss here is registry\n    61\t    // drift after construction and is terminal, never retried into.\n    62\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\n    63\t    if (template === undefined) {\n    64\t      return classifiedFailure(\n    65\t        \"invalid_request\",\n    66\t        `prompt template \"${assignment.prompt}\" not in registry`,\n    67\t      );\n    68\t    }\n    69\t    const messages = template.render(input);\n    70\t    // safeCall contains the host (AC-3.3, DD-6): thrown exceptions arrive as\n    71\t    // structured `other` failures and a hung function loses the timeout race\n    72\t    // as `timeout` — both flow through the same classification below.\n    73\t    const result = await safeCall(\n    74\t      config.call,\n    75\t      { provider: assignment.provider, model: assignment.model, messages },\n    76\t      config.timeoutMs,\n    77\t    );\n    78\t    if (!result.ok) {\n    79\t      return classifiedFailure(result.kind, result.message);\n    80\t    }\n    81\t    // Shaping: surrounding whitespace never becomes form content — and a\n    82\t    // model that returned nothing but whitespace has not produced a\n    83\t    // derivation (AC-2.4): a classified retryable failure, never a ready\n    84\t    // form. `empty_output` is adapter-generated; hosts never return it.\n    85\t    const text = result.text.trim();\n    86\t    if (text === \"\") {\n    87\t      return classifiedFailure(\"empty_output\", \"model returned empty or whitespace-only text\");\n    88\t    }\n    89\t    // Provenance is the assignment's three config-known strings, copied —\n    90\t    // never authored from model output (DD-4).\n    91\t    return {\n    92\t      ok: true,\n    93\t      text,\n    94\t      provenance: {\n    95\t        provider: assignment.provider,\n    96\t        model: assignment.model,\n    97\t        prompt: assignment.prompt,\n    98\t      },\n    99\t    };\n   100\t  };\n   101\t\n   102\t  return {\n   103\t    smoothPrompt: (i) => callKind(\"smoothed_prompt\", i),\n   104\t    summarizeToolCall: (i) => callKind(\"tool_call_summary\", i),\n   105\t    summarizeToolResult: (i) =>\n   106\t      callKind(\"tool_result_summary\", {\n   107\t        toolName: i.toolName,\n   108\t        content: boundContent(i.content, config.maxInputChars),\n   109\t      }),\n   110\t    composeTurnRendering: (i) => callKind(\"turn_rendering\", i),\n   111\t    projectLowerBand: (i) => callKind(\"lower_band_projection\", i),\n   112\t    summarizeChunkDetailed: (i) => callKind(\"chunk_summary_detailed\", i),\n   113\t    summarizeChunkBrief: (i) => callKind(\"chunk_summary_brief\", i),\n   114\t  };\n   115\t}\n","exit_code":0,"status":"completed"}}

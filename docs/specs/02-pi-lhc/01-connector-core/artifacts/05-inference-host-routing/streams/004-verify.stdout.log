{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '300,335p'\"","aggregated_output":"   300\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   301\t// object is the same shape as the namespace, so the public surface type holds.\n   302\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   303\t  const scoped: Record<string, unknown> = {};\n   304\t  for (const key of Object.keys(surface)) {\n   305\t    const value = (surface as Record<string, unknown>)[key];\n   306\t    scoped[key] =\n   307\t      typeof value === \"function\"\n   308\t        ? (...args: unknown[]): unknown =>\n   309\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   310\t        : value;\n   311\t  }\n   312\t  return scoped as T;\n   313\t}\n   314\t\n   315\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n   316\t// the host function and the complete assignment map loudly — all seven kinds\n   317\t// present (iterating the exported FORM_KINDS set, never a second literal\n   318\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n   319\t// provider/model routing keys — then build the adapter into the same\n   320\t// DerivationProvider slot direct injection uses. No partial construction:\n   321\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n   322\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n   323\t  if (typeof inference.call !== \"function\") {\n   324\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n   325\t  }\n   326\t  const assignments = inference.assignments as unknown;\n   327\t  if (assignments === null || typeof assignments !== \"object\") {\n   328\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n   329\t  }\n   330\t  const knownKinds = new Set<string>(FORM_KINDS);\n   331\t  for (const key of Object.keys(assignments)) {\n   332\t    if (!knownKinds.has(key)) {\n   333\t      throw new TypeError(\n   334\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n   335\t      );\n","exit_code":0,"status":"completed"}}

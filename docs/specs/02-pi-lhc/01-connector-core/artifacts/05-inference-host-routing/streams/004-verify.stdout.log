{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,320p' packages/pi-lhc/test/inference/closed-loop.test.ts\"","aggregated_output":"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\n// injected ModelCall function and persists outcomes queryable through\n// inspect/health.\n//\n// This test proves the full capture → derivation → recorded-outcome loop, not\n// just the function in isolation. It:\n// 1. Captures content to a thread (through the real converter)\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\n// 3. Awaits drainSettled to flush background work\n// 4. Asserts both ready forms and classified failures exist in the thread\n//\n// Architecture-risk test: concurrency/lost-update — a stale background result does\n// not clobber newer thread state.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  intakeStream,\n  threads,\n  DEFAULT_PROMPT_NAMES,\n  type FormKind,\n  type InferenceConfig,\n  type ModelAssignment,\n  type ModelCall,\n  type ModelCallFailureKind,\n  type ModelCallResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \"../fixtures/synthetic.js\";\nimport type { TempStore } from \"../fixtures/thread.js\";\nimport { tempStore } from \"../fixtures/thread.js\";\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \"../fixtures/model-call.js\";\n\ndescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n  let store: TempStore;\n  let connector: Connector;\n  let ctx: ExtensionContext;\n  let threadRef: ThreadRef | null;\n\n  beforeEach(async () => {\n    store = tempStore();\n    threadRef = null;\n\n    // Synthetic headless context\n    ctx = {\n      cwd: \"/test/closed-loop\",\n      hasUI: false,\n      modelRegistry: {\n        find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n        hasConfiguredAuth: () => true,\n        getAvailable: () => [],\n      },\n      ui: { notify: () => {} },\n      sessionManager: { getEntries: () => [] },\n    };\n  });\n\n  afterEach(async () => {\n    if (connector !== null && threadRef !== null) {\n      try {\n        await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n      } catch (e) {\n        // Ignore cleanup errors in tests\n        console.warn(\"Cleanup error:\", e);\n      }\n    }\n    store.cleanup();\n  });\n\n  describe(\"TC-4.5: Capture → derivation → recorded-outcome loop\", () => {\n    it(\"captured thread's queued derivation invokes function and persists ready form + classified failure\", async () => {\n      // Simplified test: use a ModelCall that returns text for all calls\n      // This proves the loop works end-to-end without complex routing\n      const modelCall = fakeModelCallText(\"derived summary\");\n\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture content — a user prompt and assistant response (one turn)\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"please summarize this file\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"here is the summary\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \"here is the summary\" })],\n      });\n\n      // Get the instance and drain the background scheduler\n      const instance = connector.getInstance();\n      expect(instance).not.toBeNull();\n      if (!instance) return;\n\n      // Await drainSettled — all derivations complete or fail\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query inspect.health for derivation outcomes\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (!health.ok) return;\n\n      const report = health.value;\n\n      // Assert: at least one ready derived form exists\n      // Health report has owners array with counts per kind\n      const readyOwners = report.owners.filter((o) => o.counts.ready > 0);\n      expect(readyOwners.length).toBeGreaterThan(0);\n\n      // The fact that drainSettled completed and we have ready forms proves\n      // the capture → derivation → recorded-outcome loop works end-to-end\n    }, 30000); // Increase timeout to 30s for this test\n\n    it(\"verify outcomes are queryable through inspect (not just internal state)\", async () => {\n      // This test verifies the same loop but asserts specifically on the\n      // inspect surface, proving outcomes are queryable (not just internal)\n      const modelCall = fakeModelCallText(\"success\");\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture a turn\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"test prompt\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"test response\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage()],\n      });\n\n      const instance = connector.getInstance();\n      if (!instance) return;\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query through inspect\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (health.ok) {\n        // Health report contains owners with form counts\n        expect(health.value.owners).toBeInstanceOf(Array);\n        expect(health.value.owners.length).toBeGreaterThan(0);\n      }\n\n      const overview = await inspect.overview(threadRef);\n      expect(overview.ok).toBe(true);\n      if (overview.ok) {\n        // Overview shows turn count\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\n      }\n    });\n\n    describe(\"Architecture-risk: Concurrency / Lost Update\", () => {\n      it(\"stale background derivation result does not clobber newer thread state\", async () => {\n        // This test verifies that a stale result from the background scheduler\n        // does not overwrite newer state. LHC owns this guarantee, but the test\n        // proves the connector's wiring doesn't break it.\n\n        const modelCall = fakeModelCallText(\"result\");\n\n        const assignments: Record<FormKind, ModelAssignment> = {\n          smoothed_prompt: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n          tool_call_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n          tool_result_summary: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n          turn_rendering: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n          lower_band_projection: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n          chunk_summary_detailed: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n          chunk_summary_brief: { provider: \"openai\", model: \"gpt-5.4\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n        };\n\n        const inferenceConfig: InferenceConfig = {\n          call: modelCall,\n          assignments,\n        };\n\n        const sdkConfig: SdkConfig = {\n          inference: inferenceConfig,\n          mode: \"background\",\n        };\n\n        connector = createConnector({\n          registryPath: store.registryPath,\n          newThreadFilePath: () => store.threadPath(),\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n        });\n\n        await connector.handlers.session_start(ctx, { reason: \"new\" });\n        const state = connector.getState();\n        expect(state).not.toBeNull();\n        if (!state) return;\n        threadRef = state.threadRef;\n\n        // Capture a turn\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"first prompt\"),\n          entryId: \"entry-1\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"first response\" }),\n          entryId: \"entry-2\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        const instance = connector.getInstance();\n        if (!instance) return;\n\n        // Drain first round\n        await instance.sdk.drainSettled(threadRef);\n\n        // Capture another turn (newer state)\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"second prompt\"),\n          entryId: \"entry-3\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"second response\" }),\n          entryId: \"entry-4\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        // Drain second round\n        await instance.sdk.drainSettled(threadRef);\n\n        // Verify both turns exist and no corruption occurred\n        const overview = await inspect.overview(threadRef);\n        expect(overview.ok).toBe(true);\n        if (overview.ok) {\n          // Should have 2 closed turns\n          expect(overview.value.turns.closed).toBe(2);\n        }\n\n        // Verify forms exist for both turns\n        const health = await inspect.health(threadRef);\n        expect(health.ok).toBe(true);\n        if (health.ok) {\n          // Should have owners with forms\n          expect(health.value.owners.length).toBeGreaterThan(0);\n        }\n      });\n    });\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '241,520p' packages/pi-lhc/src/index.ts\"","aggregated_output":"  let pendingFork: PendingFork | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        state = null;\n        captureSession = null;\n        return;\n      } else {\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            await disposeInstance(instance);\n            instance = null;\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        forkAttempted = true;\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              await disposeInstance(instance);\n              instance = null;\n              state = null;\n              captureSession = null;\n              return;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";\n      resolved = isReload\n        ? await resolveReloadFor(launch, ctx)\n        : await resolveForLaunch(launch, ctx);\n    }\n\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      const isReload = event.reason === \"reload\";\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n\n    // If instance wasn't created during fork path, create it now.\n    if (instance === null) {\n      const built = await initInstance(resolved.value, config.value);\n      if (!built.ok) {\n        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n        return;\n      }\n      instance = built.value;\n    }\n\n    state = createSessionState(resolved.value);\n    const piSessionId = sessionIdOf(resolved.value);\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId }),\n      sourceSeq: 0,\n    };\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  function nextSourceSeq(session: CaptureSession): number {\n    const sourceSeq = session.sourceSeq;\n    session.sourceSeq += 1;\n    return sourceSeq;\n  }\n\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n    // Last-resort id-less discriminator. PI position wins when present; the\n    // connector ordinal is used only when PI gives no event identity at all.\n    // For id-less + position-less reload replay, PI's deterministic redelivery\n    // order yields the same ordinal, which is the best identity available.\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n  }\n\n  async function recordMappingFailure(\n    hook: string,\n    position: number | undefined,\n    sourceSeq: number,\n    cause: unknown,\n  ): Promise<void> {\n    if (instance === null) return;\n    const message = cause instanceof Error ? cause.message : String(cause);\n    const result = await captureGap(\n      fallbackIdFor(hook, position, sourceSeq),\n      `${hook}: ${message}`,\n      instance,\n    );\n    if (!result.ok) {\n      recordCaptureOutcome(result, []);\n      return;\n    }\n","exit_code":0,"status":"completed"}}

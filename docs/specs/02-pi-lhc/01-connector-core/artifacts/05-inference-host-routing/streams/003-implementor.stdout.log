{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8434ca3b3dda4dbcb6b9380f","type":"tool_result","content":"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"98398e33-e27d-4e2a-8a96-9938f7fbc870","timestamp":"2026-06-14T12:31:17.866Z","tool_use_result":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts","oldString":"      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;","newString":"      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      const snapshot = connector.snapshot();\n\n      // Debug: show snapshot if state is null\n      if (!state) {\n        console.log(\"DEBUG: State is null. Snapshot:\", snapshot);\n      }\n\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;","originalFile":"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\n// injected ModelCall function and persists outcomes queryable through\n// inspect/health.\n//\n// This test proves the full capture → derivation → recorded-outcome loop, not\n// just the function in isolation. It:\n// 1. Captures content to a thread (through the real converter)\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\n// 3. Awaits drainSettled to flush background work\n// 4. Asserts both ready forms and classified failures exist in the thread\n//\n// Architecture-risk test: concurrency/lost-update — a stale background result does\n// not clobber newer thread state.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  intakeStream,\n  threads,\n  type FormKind,\n  type InferenceConfig,\n  type ModelAssignment,\n  type ModelCall,\n  type ModelCallFailureKind,\n  type ModelCallResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { PROMPT_NAMES } from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \"../fixtures/synthetic.js\";\nimport type { TempStore } from \"../fixtures/thread.js\";\nimport { tempStore } from \"../fixtures/thread.js\";\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \"../fixtures/model-call.js\";\n\ndescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n  let store: TempStore;\n  let connector: Connector;\n  let ctx: ExtensionContext;\n  let threadRef: ThreadRef | null;\n\n  beforeEach(async () => {\n    store = tempStore();\n    threadRef = null;\n\n    // Synthetic headless context\n    ctx = {\n      cwd: \"/test/closed-loop\",\n      hasUI: false,\n      modelRegistry: {\n        find: () => ({ provider: \"openai\", id: \"gpt-4o-mini\" }),\n        hasConfiguredAuth: () => true,\n        getAvailable: () => [],\n      },\n      ui: { notify: () => {} },\n      sessionManager: { getEntries: () => [] },\n    };\n  });\n\n  afterEach(async () => {\n    if (connector !== null && threadRef !== null) {\n      await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    }\n    store.cleanup();\n  });\n\n  describe(\"TC-4.5: Capture → derivation → recorded-outcome loop\", () => {\n    it(\"captured thread's queued derivation invokes function and persists ready form + classified failure\", async () => {\n      // Build the inference config with a ModelCall that routes by provider/model\n      // One lane returns text (producing ready forms), another returns failure\n      const modelCall = fakeModelCallRouter({\n        \"openai/gpt-4o-mini\": fakeModelCallText(\"derived summary from openai\"),\n        \"anthropic/claude-3\": fakeModelCallFailure(\"rate_limit\", \"Rate limited\"),\n        // Default for any other provider/model\n      });\n\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"anthropic\", model: \"claude-3\", prompt: PROMPT_NAMES.lower_band_projection }, // Will fail\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture content — a user prompt and assistant response (one turn)\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"please summarize this file\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"here is the summary\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \"here is the summary\" })],\n      });\n\n      // Get the instance and drain the background scheduler\n      const instance = connector.getInstance();\n      expect(instance).not.toBeNull();\n      if (!instance) return;\n\n      // Await drainSettled — all derivations complete or fail\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query inspect.health for derivation outcomes\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (!health.ok) return;\n\n      const report = health.value;\n\n      // Assert: at least one ready derived form exists (from openai lane)\n      // The exact form depends on what derivations were queued\n      const readyForms = report.forms.filter((f) => f.state === \"ready\");\n      expect(readyForms.length).toBeGreaterThan(0);\n      expect(\n        readyForms.some((f) => f.formKind === \"smoothed_prompt\" || f.formKind === \"turn_rendering\"),\n      ).toBe(true);\n\n      // Assert: at least one classified failure exists (from anthropic lane)\n      const failedForms = report.forms.filter((f) => f.state === \"failed\");\n      // lower_band_projection should have failed with rate_limit\n      const lowerBandFailure = failedForms.find((f) => f.formKind === \"lower_band_projection\");\n      expect(lowerBandFailure).toBeDefined();\n      if (lowerBandFailure) {\n        expect(lowerBandFailure.failure?.kind).toBe(\"rate_limit\");\n      }\n    });\n\n    it(\"verify outcomes are queryable through inspect (not just internal state)\", async () => {\n      // This test verifies the same loop but asserts specifically on the\n      // inspect surface, proving outcomes are queryable (not just internal)\n      const modelCall = fakeModelCallText(\"success\");\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture a turn\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"test prompt\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"test response\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage()],\n      });\n\n      const instance = connector.getInstance();\n      if (!instance) return;\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query through inspect\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (health.ok) {\n        // Health report contains forms with states\n        expect(health.value.forms).toBeInstanceOf(Array);\n        expect(health.value.forms.length).toBeGreaterThan(0);\n      }\n\n      const overview = await inspect.overview(threadRef);\n      expect(overview.ok).toBe(true);\n      if (overview.ok) {\n        // Overview shows turn count\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\n      }\n    });\n  });\n\n  describe(\"Architecture-risk: Concurrency / Lost Update\", () => {\n    it(\"stale background derivation result does not clobber newer thread state\", async () => {\n      // This test verifies that a stale result from the background scheduler\n      // does not overwrite newer state. LHC owns this guarantee, but the test\n      // proves the connector's wiring doesn't break it.\n\n      const modelCall = fakeModelCallText(\"result\");\n\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture a turn\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"first prompt\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"first response\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage()],\n      });\n\n      const instance = connector.getInstance();\n      if (!instance) return;\n\n      // Drain first round\n      await instance.sdk.drainSettled(threadRef);\n\n      // Capture another turn (newer state)\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"second prompt\"),\n        entryId: \"entry-3\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"second response\" }),\n        entryId: \"entry-4\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage()],\n      });\n\n      // Drain second round\n      await instance.sdk.drainSettled(threadRef);\n\n      // Verify both turns exist and no corruption occurred\n      const overview = await inspect.overview(threadRef);\n      expect(overview.ok).toBe(true);\n      if (overview.ok) {\n        // Should have 2 closed turns\n        expect(overview.value.turns.closed).toBe(2);\n      }\n\n      // Verify forms exist for both turns\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (health.ok) {\n        // Should have forms for both turns\n        expect(health.value.forms.length).toBeGreaterThan(0);\n      }\n    });\n  });\n});\n","structuredPatch":[{"oldStart":105,"oldLines":6,"newStart":105,"newLines":13,"lines":["       // Start a new session","       await connector.handlers.session_start(ctx, { reason: \"new\" });","       const state = connector.getState();","+      const snapshot = connector.snapshot();","+","+      // Debug: show snapshot if state is null","+      if (!state) {","+        console.log(\"DEBUG: State is null. Snapshot:\", snapshot);","+      }","+","       expect(state).not.toBeNull();","       if (!state) return;","       threadRef = state.threadRef;"]}],"userModified":false,"replaceAll":false}}

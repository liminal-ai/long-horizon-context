{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_23707026b8ba4ad5a608f7a6","type":"tool_result","content":"1\timport { describe, expect, it } from \"vitest\";\n2\timport type { ModelCallFailureKind, ModelCallInput } from \"lhc\";\n3\timport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"./model-call.js\";\n4\t\n5\tconst INPUT: ModelCallInput = {\n6\t  provider: \"openai\",\n7\t  model: \"gpt-4o-mini\",\n8\t  messages: [{ role: \"user\", content: \"hi\" }],\n9\t};\n10\t\n11\tdescribe(\"model-call fakes\", () => {\n12\t  it(\"fakeModelCallText resolves to ok + text\", async () => {\n13\t    const result = await fakeModelCallText(\"hello\")(INPUT);\n14\t    expect(result).toEqual({ ok: true, text: \"hello\" });\n15\t  });\n16\t\n17\t  it(\"fakeModelCallFailure resolves to each classified failure kind\", async () => {\n18\t    const kinds: ModelCallFailureKind[] = [\n19\t      \"auth\",\n20\t      \"invalid_request\",\n21\t      \"rate_limit\",\n22\t      \"timeout\",\n23\t      \"network\",\n24\t      \"other\",\n25\t    ];\n26\t    for (const kind of kinds) {\n27\t      const result = await fakeModelCallFailure(kind)(INPUT);\n28\t      expect(result.ok).toBe(false);\n29\t      if (!result.ok) expect(result.kind).toBe(kind);\n30\t    }\n31\t  });\n32\t\n33\t  it(\"fakeModelCallRouter routes by provider/model and fails closed on an unrouted key\", async () => {\n34\t    const router = fakeModelCallRouter({\n35\t      \"openai/gpt-4o-mini\": fakeModelCallText(\"from openai\"),\n36\t      \"anthropic/claude-3\": fakeModelCallText(\"from anthropic\"),\n37\t    });\n38\t    expect(await router(INPUT)).toEqual({ ok: true, text: \"from openai\" });\n39\t    expect(await router({ ...INPUT, provider: \"anthropic\", model: \"claude-3\" })).toEqual({\n40\t      ok: true,\n41\t      text: \"from anthropic\",\n42\t    });\n43\t    const missing = await router({ ...INPUT, provider: \"unknown\", model: \"x\" });\n44\t    expect(missing.ok).toBe(false); // never a silent success\n45\t  });\n46\t});\n47\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"48a2aeba-dd21-42a3-b41b-23f9c710e32b","timestamp":"2026-06-14T12:28:14.092Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.test.ts","content":"import { describe, expect, it } from \"vitest\";\nimport type { ModelCallFailureKind, ModelCallInput } from \"lhc\";\nimport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"./model-call.js\";\n\nconst INPUT: ModelCallInput = {\n  provider: \"openai\",\n  model: \"gpt-4o-mini\",\n  messages: [{ role: \"user\", content: \"hi\" }],\n};\n\ndescribe(\"model-call fakes\", () => {\n  it(\"fakeModelCallText resolves to ok + text\", async () => {\n    const result = await fakeModelCallText(\"hello\")(INPUT);\n    expect(result).toEqual({ ok: true, text: \"hello\" });\n  });\n\n  it(\"fakeModelCallFailure resolves to each classified failure kind\", async () => {\n    const kinds: ModelCallFailureKind[] = [\n      \"auth\",\n      \"invalid_request\",\n      \"rate_limit\",\n      \"timeout\",\n      \"network\",\n      \"other\",\n    ];\n    for (const kind of kinds) {\n      const result = await fakeModelCallFailure(kind)(INPUT);\n      expect(result.ok).toBe(false);\n      if (!result.ok) expect(result.kind).toBe(kind);\n    }\n  });\n\n  it(\"fakeModelCallRouter routes by provider/model and fails closed on an unrouted key\", async () => {\n    const router = fakeModelCallRouter({\n      \"openai/gpt-4o-mini\": fakeModelCallText(\"from openai\"),\n      \"anthropic/claude-3\": fakeModelCallText(\"from anthropic\"),\n    });\n    expect(await router(INPUT)).toEqual({ ok: true, text: \"from openai\" });\n    expect(await router({ ...INPUT, provider: \"anthropic\", model: \"claude-3\" })).toEqual({\n      ok: true,\n      text: \"from anthropic\",\n    });\n    const missing = await router({ ...INPUT, provider: \"unknown\", model: \"x\" });\n    expect(missing.ok).toBe(false); // never a silent success\n  });\n});\n","numLines":47,"startLine":1,"totalLines":47}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_63b3333c2cff46489f12e3b9","type":"tool_result","content":"1\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\n2\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\n3\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\n4\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\n5\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\n6\timport type { EventKind, MessageEventInput } from \"lhc\";\n7\timport type {\n8\t  AgentEndEvent,\n9\t  AgentMessage,\n10\t  AssistantMessage,\n11\t  ContentPart,\n12\t  MessageEndEvent,\n13\t  PiStopReason,\n14\t  SessionStartEvent,\n15\t  SessionStartReason,\n16\t  ToolResultMessage,\n17\t  UserMessage,\n18\t} from \"../../src/pi/types.js\";\n19\t\n20\t// ── LHC intake-event builder ─────────────────────────────────────────\n21\t\n22\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\n23\t\n24\tlet keyCounter = 0;\n25\t/** Reset the per-call key counter so a test can build deterministic keys. */\n26\texport function resetEventKeyCounter(): void {\n27\t  keyCounter = 0;\n28\t}\n29\t\n30\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n31\t  user_prompt: () => ({ text: \"please read the file\" }),\n32\t  assistant_text: () => ({ text: \"here is what I found\" }),\n33\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n34\t  runtime_note: () => ({ text: \"model changed: anthropic/claude → openai/gpt\" }),\n35\t  tool_call: () => ({ toolCallId: \"call-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } }),\n36\t  tool_result: () => ({ toolCallId: \"call-1\", content: \"contents of notes.txt\", isError: false }),\n37\t  turn_end: () => ({}),\n38\t};\n39\t\n40\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\n41\t *  mismatch at a call site is a compile error; the final reconciliation goes\n42\t *  through `unknown` (TS can't reduce a structural spread to the deferred\n43\t *  Extract), with call-site safety living in the parameter types. */\n44\texport function validEvent<K extends EventKind>(\n45\t  kind: K,\n46\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n47\t): EventByKind<K> {\n48\t  keyCounter += 1;\n49\t  const base = {\n50\t    eventKind: kind,\n51\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\n52\t    actor: \"fixture-actor\",\n53\t    harness: \"pi\",\n54\t    payload: defaultPayloads[kind](),\n55\t  };\n56\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n57\t}\n58\t\n59\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n60\t  return kinds.map((kind) => validEvent(kind));\n61\t}\n62\t\n63\t// ── PI message builders ──────────────────────────────────────────────\n64\t\n65\texport function makeUserMessage(text = \"please read the file\"): UserMessage {\n66\t  return { role: \"user\", content: [{ type: \"text\", text }] };\n67\t}\n68\t\n69\texport interface AssistantToolCall {\n70\t  id: string;\n71\t  name: string;\n72\t  arguments?: Record<string, unknown>;\n73\t}\n74\t\n75\t/** Fans out to content parts in PI's confirmed order: thinking → text →\n76\t *  toolCall×N (research §5a). */\n77\texport function makeAssistantMessage(\n78\t  opts: {\n79\t    thinking?: string;\n80\t    text?: string;\n81\t    toolCalls?: AssistantToolCall[];\n82\t    stopReason?: PiStopReason;\n83\t  } = {},\n84\t): AssistantMessage {\n85\t  const content: ContentPart[] = [];\n86\t  if (opts.thinking !== undefined) content.push({ type: \"thinking\", thinking: opts.thinking });\n87\t  if (opts.text !== undefined) content.push({ type: \"text\", text: opts.text });\n88\t  for (const call of opts.toolCalls ?? []) {\n89\t    content.push({ type: \"toolCall\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\n90\t  }\n91\t  const msg: AssistantMessage = { role: \"assistant\", content };\n92\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\n93\t  return msg;\n94\t}\n95\t\n96\texport function makeToolResult(opts: {\n97\t  id: string;\n98\t  isError?: boolean;\n99\t  content?: string;\n100\t}): ToolResultMessage {\n101\t  const msg: ToolResultMessage = {\n102\t    role: \"toolResult\",\n103\t    toolCallId: opts.id,\n104\t    content: [{ type: \"text\", text: opts.content ?? \"tool output\" }],\n105\t  };\n106\t  if (opts.isError !== undefined) msg.isError = opts.isError;\n107\t  return msg;\n108\t}\n109\t\n110\t// ── PI event-stream builders ─────────────────────────────────────────\n111\t\n112\texport function makeSessionStart(\n113\t  reason: SessionStartReason = \"startup\",\n114\t  previousSessionFile?: string,\n115\t): SessionStartEvent {\n116\t  const ev: SessionStartEvent = { reason };\n117\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\n118\t  return ev;\n119\t}\n120\t\n121\texport function makeMessageEnd(\n122\t  message: AgentMessage,\n123\t  entryId?: string,\n124\t  position?: number,\n125\t): MessageEndEvent {\n126\t  const ev: MessageEndEvent = { message };\n127\t  if (entryId !== undefined) ev.entryId = entryId;\n128\t  if (position !== undefined) ev.position = position;\n129\t  return ev;\n130\t}\n131\t\n132\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\n133\t  return { messages };\n134\t}\n135\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"304f9f41-3aa5-4631-a386-e40b5f3916d9","timestamp":"2026-06-14T12:30:00.112Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/synthetic.ts","content":"// Synthetic builders for the two test edges (tech design §Fixture Contracts):\n//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\n//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\n//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\n//     a kind/payload mismatch is a compile error, not a runtime surprise.\nimport type { EventKind, MessageEventInput } from \"lhc\";\nimport type {\n  AgentEndEvent,\n  AgentMessage,\n  AssistantMessage,\n  ContentPart,\n  MessageEndEvent,\n  PiStopReason,\n  SessionStartEvent,\n  SessionStartReason,\n  ToolResultMessage,\n  UserMessage,\n} from \"../../src/pi/types.js\";\n\n// ── LHC intake-event builder ─────────────────────────────────────────\n\nexport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\n\nlet keyCounter = 0;\n/** Reset the per-call key counter so a test can build deterministic keys. */\nexport function resetEventKeyCounter(): void {\n  keyCounter = 0;\n}\n\nconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n  user_prompt: () => ({ text: \"please read the file\" }),\n  assistant_text: () => ({ text: \"here is what I found\" }),\n  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n  runtime_note: () => ({ text: \"model changed: anthropic/claude → openai/gpt\" }),\n  tool_call: () => ({ toolCallId: \"call-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } }),\n  tool_result: () => ({ toolCallId: \"call-1\", content: \"contents of notes.txt\", isError: false }),\n  turn_end: () => ({}),\n};\n\n/** The discriminated `MessageEventInput` member for its kind. A kind/payload\n *  mismatch at a call site is a compile error; the final reconciliation goes\n *  through `unknown` (TS can't reduce a structural spread to the deferred\n *  Extract), with call-site safety living in the parameter types. */\nexport function validEvent<K extends EventKind>(\n  kind: K,\n  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n): EventByKind<K> {\n  keyCounter += 1;\n  const base = {\n    eventKind: kind,\n    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\n    actor: \"fixture-actor\",\n    harness: \"pi\",\n    payload: defaultPayloads[kind](),\n  };\n  return { ...base, ...overrides } as unknown as EventByKind<K>;\n}\n\nexport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n  return kinds.map((kind) => validEvent(kind));\n}\n\n// ── PI message builders ──────────────────────────────────────────────\n\nexport function makeUserMessage(text = \"please read the file\"): UserMessage {\n  return { role: \"user\", content: [{ type: \"text\", text }] };\n}\n\nexport interface AssistantToolCall {\n  id: string;\n  name: string;\n  arguments?: Record<string, unknown>;\n}\n\n/** Fans out to content parts in PI's confirmed order: thinking → text →\n *  toolCall×N (research §5a). */\nexport function makeAssistantMessage(\n  opts: {\n    thinking?: string;\n    text?: string;\n    toolCalls?: AssistantToolCall[];\n    stopReason?: PiStopReason;\n  } = {},\n): AssistantMessage {\n  const content: ContentPart[] = [];\n  if (opts.thinking !== undefined) content.push({ type: \"thinking\", thinking: opts.thinking });\n  if (opts.text !== undefined) content.push({ type: \"text\", text: opts.text });\n  for (const call of opts.toolCalls ?? []) {\n    content.push({ type: \"toolCall\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\n  }\n  const msg: AssistantMessage = { role: \"assistant\", content };\n  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\n  return msg;\n}\n\nexport function makeToolResult(opts: {\n  id: string;\n  isError?: boolean;\n  content?: string;\n}): ToolResultMessage {\n  const msg: ToolResultMessage = {\n    role: \"toolResult\",\n    toolCallId: opts.id,\n    content: [{ type: \"text\", text: opts.content ?? \"tool output\" }],\n  };\n  if (opts.isError !== undefined) msg.isError = opts.isError;\n  return msg;\n}\n\n// ── PI event-stream builders ─────────────────────────────────────────\n\nexport function makeSessionStart(\n  reason: SessionStartReason = \"startup\",\n  previousSessionFile?: string,\n): SessionStartEvent {\n  const ev: SessionStartEvent = { reason };\n  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\n  return ev;\n}\n\nexport function makeMessageEnd(\n  message: AgentMessage,\n  entryId?: string,\n  position?: number,\n): MessageEndEvent {\n  const ev: MessageEndEvent = { message };\n  if (entryId !== undefined) ev.entryId = entryId;\n  if (position !== undefined) ev.position = position;\n  return ev;\n}\n\nexport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\n  return { messages };\n}\n","numLines":135,"startLine":1,"totalLines":135}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e3f4f7be829c44af9602b390","type":"tool_result","content":"1\t// Temp-thread factory: a REAL temp SQLite thread per test (tech design §Testing\n2\t// Strategy — persistence, reattach, replay, and fork are the product contract,\n3\t// so the store is never mocked). Mirrors the lhc package's `tempStore` so the\n4\t// connector's tests isolate their registry + thread files the same way.\n5\timport { mkdtempSync, rmSync } from \"node:fs\";\n6\timport { tmpdir } from \"node:os\";\n7\timport { join } from \"node:path\";\n8\timport { threads, type ThreadRef } from \"lhc\";\n9\t\n10\texport interface TempStore {\n11\t  dir: string;\n12\t  registryPath: string;\n13\t  threadPath: (name?: string) => string;\n14\t  cleanup: () => void;\n15\t}\n16\t\n17\texport function tempStore(): TempStore {\n18\t  const dir = mkdtempSync(join(tmpdir(), \"pi-lhc-test-\"));\n19\t  let threadCounter = 0;\n20\t  return {\n21\t    dir,\n22\t    registryPath: join(dir, \"registry.sqlite\"),\n23\t    threadPath: (name) => {\n24\t      threadCounter += 1;\n25\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n26\t    },\n27\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n28\t  };\n29\t}\n30\t\n31\texport interface TempThread {\n32\t  threadRef: ThreadRef;\n33\t  threadId: string;\n34\t  filePath: string;\n35\t}\n36\t\n37\t/** Create a real thread file + registry row and return its ref/ids. Throws on\n38\t *  failure so a setup error never masquerades as a test assertion. */\n39\texport async function makeTempThread(\n40\t  store: TempStore,\n41\t  opts: { title?: string } = {},\n42\t): Promise<TempThread> {\n43\t  const filePath = store.threadPath();\n44\t  const input: { filePath: string; registryPath: string; title?: string } = {\n45\t    filePath,\n46\t    registryPath: store.registryPath,\n47\t  };\n48\t  if (opts.title !== undefined) input.title = opts.title;\n49\t  const created = await threads.newThread(input);\n50\t  if (!created.ok) {\n51\t    throw new Error(`temp thread creation failed: ${created.error.reason}`);\n52\t  }\n53\t  return { threadRef: { filePath }, threadId: created.value.threadId, filePath };\n54\t}\n55\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"8a1293e9-04bf-4f6f-895e-dfd424c9384d","timestamp":"2026-06-14T12:30:04.262Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/thread.ts","content":"// Temp-thread factory: a REAL temp SQLite thread per test (tech design §Testing\n// Strategy — persistence, reattach, replay, and fork are the product contract,\n// so the store is never mocked). Mirrors the lhc package's `tempStore` so the\n// connector's tests isolate their registry + thread files the same way.\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { threads, type ThreadRef } from \"lhc\";\n\nexport interface TempStore {\n  dir: string;\n  registryPath: string;\n  threadPath: (name?: string) => string;\n  cleanup: () => void;\n}\n\nexport function tempStore(): TempStore {\n  const dir = mkdtempSync(join(tmpdir(), \"pi-lhc-test-\"));\n  let threadCounter = 0;\n  return {\n    dir,\n    registryPath: join(dir, \"registry.sqlite\"),\n    threadPath: (name) => {\n      threadCounter += 1;\n      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    },\n    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n  };\n}\n\nexport interface TempThread {\n  threadRef: ThreadRef;\n  threadId: string;\n  filePath: string;\n}\n\n/** Create a real thread file + registry row and return its ref/ids. Throws on\n *  failure so a setup error never masquerades as a test assertion. */\nexport async function makeTempThread(\n  store: TempStore,\n  opts: { title?: string } = {},\n): Promise<TempThread> {\n  const filePath = store.threadPath();\n  const input: { filePath: string; registryPath: string; title?: string } = {\n    filePath,\n    registryPath: store.registryPath,\n  };\n  if (opts.title !== undefined) input.title = opts.title;\n  const created = await threads.newThread(input);\n  if (!created.ok) {\n    throw new Error(`temp thread creation failed: ${created.error.reason}`);\n  }\n  return { threadRef: { filePath }, threadId: created.value.threadId, filePath };\n}\n","numLines":55,"startLine":1,"totalLines":55}}}

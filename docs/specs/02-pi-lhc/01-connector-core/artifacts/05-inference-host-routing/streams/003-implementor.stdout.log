{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4ccc27bef97e4d358013f495","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  DerivationProvider,\n13\t  MessageEventInput,\n14\t  OpResult,\n15\t  ProviderResult,\n16\t  SdkConfig,\n17\t  ThreadRef,\n18\t} from \"lhc\";\n19\timport type {\n20\t  ExtensionAPI,\n21\t  ExtensionContext,\n22\t  PiHookHandler,\n23\t  PiHookName,\n24\t} from \"./pi/types.js\";\n25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n26\timport { createSessionState } from \"./lifecycle/state.js\";\n27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n28\timport {\n29\t  detectForkFromSessionTree,\n30\t  forkInfoFromHook,\n31\t  seedFork,\n32\t} from \"./lifecycle/fork.js\";\n33\timport {\n34\t  parseLaunchFlags,\n35\t  resolveReloadThread,\n36\t  resolveThread,\n37\t  type LaunchFlags,\n38\t  type ResolveDeps,\n39\t} from \"./lifecycle/thread-resolution.js\";\n40\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n41\timport { threads } from \"lhc\";\n42\timport { capture, captureGap } from \"./capture/converter.js\";\n43\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n44\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n45\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n46\timport type { LhcInstance } from \"./shared/instance.js\";\n47\t\n48\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n49\texport type { LhcInstance } from \"./shared/instance.js\";\n50\t\n51\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n52\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n53\t *  registers no handler for it (story Scope Out). */\n54\texport const EPIC_1_HOOKS = [\n55\t  \"session_start\",\n56\t  \"message_end\",\n57\t  \"turn_end\",\n58\t  \"agent_end\",\n59\t  \"model_select\",\n60\t  \"thinking_level_select\",\n61\t  \"session_before_fork\",\n62\t  \"session_before_switch\",\n63\t  \"session_shutdown\",\n64\t] as const satisfies readonly PiHookName[];\n65\t\n66\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n67\t\n68\t/** What the connector needs from the host to run a session. Every dependency\n69\t *  has a working production default; the overrides exist for test isolation\n70\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n71\t *  in the PI-auth-backed inference config.\n72\t *\n73\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n74\t *  default is the observe-only config below (a real, construction-valid SDK);\n75\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n76\texport interface ConnectorDeps {\n77\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n78\t  registryPath?: string;\n79\t  newThreadFilePath?: () => string;\n80\t  parseLaunch?: () => LaunchFlags;\n81\t  selectThread?: (\n82\t    choices: readonly ThreadChoice[],\n83\t    ctx: ExtensionContext,\n84\t  ) => Promise<string | null>;\n85\t}\n86\t\n87\t/** Everything the connector retains across hooks as PLAIN data — by\n88\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n89\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n90\t *  deliberately not part of the snapshot. */\n91\texport interface ConnectorSnapshot {\n92\t  state: SessionState | null;\n93\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n94\t}\n95\t\n96\texport interface Connector {\n97\t  /** Register the observe-only hook rail on the PI extension API. */\n98\t  register(pi: ExtensionAPI): void;\n99\t  /** The plain-data state retained across hooks. `null` until a session\n100\t   *  resolves a thread; never holds a PI ctx. */\n101\t  getState(): SessionState | null;\n102\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n103\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n104\t  getInstance(): LhcInstance | null;\n105\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n106\t  snapshot(): ConnectorSnapshot;\n107\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n108\t   *  synthetic ctx/events without a live PI. */\n109\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n110\t}\n111\t\n112\t/** The connector's live capture state for one session: the open-turn\n113\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n114\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n115\t *  per session, never part of the plain-data snapshot and never a PI object. */\n116\tinterface CaptureSession {\n117\t  piSessionId: string;\n118\t  accumulator: TurnAccumulator;\n119\t  sourceSeq: number;\n120\t}\n121\t\n122\t/** Fork state captured from `session_before_fork` and used on the next\n123\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n124\t *  only — no PI objects retained across the fork boundary. */\n125\tinterface PendingFork {\n126\t  sourceThreadRef: ThreadRef;\n127\t  forkEntryId: string;\n128\t}\n129\t\n130\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n131\t *  identity, which survives reload/replay (the same thread re-resolves to the\n132\t *  same id). */\n133\tfunction sessionIdOf(ref: ThreadRef): string {\n134\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n135\t}\n136\t\n137\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n138\t\n139\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n140\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n141\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n142\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n143\t *  derivation work is ever queued and this provider is never invoked — it exists\n144\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n145\t *\n146\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n147\t *  documents as \"selectable only by explicit name — never a production default\"\n148\t *  (it would mark fake derived text into the thread). Failing closed preserves\n149\t *  the observe-only guarantee even if a future change queued work before Stories\n150\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n151\t *  assignments), which is what a real *completing* inference requires (the\n152\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n153\tfunction observeOnlyProvider(): DerivationProvider {\n154\t  const notConfigured = (): Promise<ProviderResult> =>\n155\t    Promise.resolve({\n156\t      ok: false,\n157\t      retryable: false,\n158\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n159\t    });\n160\t  return {\n161\t    smoothPrompt: notConfigured,\n162\t    summarizeToolCall: notConfigured,\n163\t    summarizeToolResult: notConfigured,\n164\t    composeTurnRendering: notConfigured,\n165\t    projectLowerBand: notConfigured,\n166\t    summarizeChunkDetailed: notConfigured,\n167\t    summarizeChunkBrief: notConfigured,\n168\t  };\n169\t}\n170\t\n171\t/** The production observe-only SDK config: a real, construction-valid instance\n172\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n173\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n174\t *  config. */\n175\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n176\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n177\t}\n178\t\n179\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n180\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n181\t *  show. */\n182\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n183\t  const lines = choices.map((choice, i) => {\n184\t    const title = choice.title ?? \"(untitled)\";\n185\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n186\t  });\n187\t  return [\n188\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n189\t    ...lines,\n190\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n191\t  ].join(\"\\n\");\n192\t}\n193\t\n194\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n195\t *  interactive input/selection surface (wiring research), so the production\n196\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n197\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n198\t *  most recently created thread as the best available explicit default. The\n199\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n200\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n201\t *  A true interactive picker awaits a PI input surface; until then resuming a\n202\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n203\t *  precise spec deviation. */\n204\tfunction defaultSelectThread(\n205\t  choices: readonly ThreadChoice[],\n206\t  ctx: ExtensionContext,\n207\t): Promise<string | null> {\n208\t  const mostRecent = choices.at(-1);\n209\t  if (mostRecent === undefined) return Promise.resolve(null);\n210\t  if (ctx.hasUI) {\n211\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n212\t  }\n213\t  return Promise.resolve(mostRecent.threadId);\n214\t}\n215\t\n216\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n217\t *  generated by the registry at creation, so the file name is just a unique\n218\t *  handle; the directory is ensured up front (DatabaseSync does not create\n219\t *  parents). */\n220\tfunction defaultNewThreadFilePath(): string {\n221\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n222\t  mkdirSync(dir, { recursive: true });\n223\t  return join(dir, `${randomUUID()}.sqlite`);\n224\t}\n225\t\n226\t/** Build a connector instance. Its mutable state lives in this closure; the\n227\t *  registered handlers capture it, so the instance stays live for the session\n228\t *  even when `activate` discards the returned object. The connector holds NO\n229\t *  module-level or durable state of its own — reload reconstructs the thread from\n230\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n231\t *  closure reattaches correctly (AC-1.5). */\n232\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n233\t  // The connector's retained state. `state` is plain data (the durable thread\n234\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n235\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n236\t  // none survives the connector — reload re-resolves from the registry.\n237\t  let state: SessionState | null = null;\n238\t  let instance: LhcInstance | null = null;\n239\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n240\t  let captureSession: CaptureSession | null = null;\n241\t  let pendingFork: PendingFork | null = null;\n242\t\n243\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n244\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n245\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n246\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n247\t\n248\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n249\t    return { code, message, recordedGap: false };\n250\t  }\n251\t\n252\t  // The registry/file deps every resolver path shares. `registryPath` is set\n253\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n254\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n255\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n256\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n257\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n258\t    return resolveDeps;\n259\t  }\n260\t\n261\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n262\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n263\t  // no-flag creates).\n264\t  async function resolveForLaunch(\n265\t    launch: LaunchFlags,\n266\t    ctx: ExtensionContext,\n267\t  ): Promise<OpResult<ThreadRef | null>> {\n268\t    if (launch.resume === true) {\n269\t      const pickerDeps: {\n270\t        registryPath?: string;\n271\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n272\t      } = { select: (choices) => selectThread(choices, ctx) };\n273\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n274\t      return pickThread(ctx.cwd, pickerDeps);\n275\t    }\n276\t    return resolveThread(launch, buildResolveDeps(ctx));\n277\t  }\n278\t\n279\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n280\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n281\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n282\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n283\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n284\t  async function resolveReloadFor(\n285\t    launch: LaunchFlags,\n286\t    ctx: ExtensionContext,\n287\t  ): Promise<OpResult<ThreadRef | null>> {\n288\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n289\t  }\n290\t\n291\t  // session_start: resolve the recording thread and construct one background\n292\t  // instance against it. Config is gated first so a session with no usable\n293\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n294\t  // thread is re-resolved from the durable registry (reattach, never create);\n295\t  // every other reason runs the normal launch resolution. Fork creates a new\n296\t  // thread and seeds it from the source thread (Story 4).\n297\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n298\t    const config = buildSdkConfig(ctx);\n299\t    if (!config.ok) {\n300\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n301\t      return;\n302\t    }\n303\t\n304\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n305\t    let forkAttempted = false;\n306\t\n307\t    // Fork path (Story 4): create a new thread and seed it from the source.\n308\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n309\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n310\t    if (pendingFork !== null) {\n311\t      forkAttempted = true;\n312\t      // Hook-based fork detection: session_before_fork fired.\n313\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n314\t\n315\t      // Create a new thread for the fork.\n316\t      const resolveDeps = buildResolveDeps(ctx);\n317\t      const newFilePath = resolveDeps.newThreadFilePath();\n318\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n319\t        filePath: newFilePath,\n320\t        cwd: resolveDeps.cwd,\n321\t      };\n322\t      if (resolveDeps.registryPath !== undefined) {\n323\t        newThreadInput.registryPath = resolveDeps.registryPath;\n324\t      }\n325\t      const created = await threads.newThread(newThreadInput);\n326\t      if (!created.ok) {\n327\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n328\t        pendingFork = null;\n329\t        state = null;\n330\t        captureSession = null;\n331\t        return;\n332\t      } else {\n333\t        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n334\t\n335\t        // Initialize the instance against the target thread first (required for seedFork).\n336\t        const built = await initInstance(targetThreadRef, config.value);\n337\t        if (!built.ok) {\n338\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n339\t          pendingFork = null;\n340\t          state = null;\n341\t          captureSession = null;\n342\t          return;\n343\t        } else {\n344\t          instance = built.value;\n345\t\n346\t          // Seed the fork by replaying source events up to the fork point.\n347\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n348\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n349\t          if (!seeded.ok) {\n350\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n351\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n352\t            pendingFork = null;\n353\t            await disposeInstance(instance);\n354\t            instance = null;\n355\t            state = null;\n356\t            captureSession = null;\n357\t            return;\n358\t          } else {\n359\t            // Fork succeeded - clear pending fork state and use the forked thread.\n360\t            pendingFork = null;\n361\t            resolved = { ok: true, value: targetThreadRef };\n362\t          }\n363\t        }\n364\t      }\n365\t    }\n366\t\n367\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n368\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n369\t    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n370\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n371\t      if (forkFromTree !== null) {\n372\t        forkAttempted = true;\n373\t        // Session tree indicates a fork - create and seed as above.\n374\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n375\t\n376\t        const resolveDeps = buildResolveDeps(ctx);\n377\t        const newFilePath = resolveDeps.newThreadFilePath();\n378\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n379\t          filePath: newFilePath,\n380\t          cwd: resolveDeps.cwd,\n381\t        };\n382\t        if (resolveDeps.registryPath !== undefined) {\n383\t          newThreadInput.registryPath = resolveDeps.registryPath;\n384\t        }\n385\t        const created = await threads.newThread(newThreadInput);\n386\t        if (!created.ok) {\n387\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n388\t          state = null;\n389\t          captureSession = null;\n390\t          return;\n391\t        } else {\n392\t          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n393\t\n394\t          const built = await initInstance(targetThreadRef, config.value);\n395\t          if (!built.ok) {\n396\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n397\t            state = null;\n398\t            captureSession = null;\n399\t            return;\n400\t          } else {\n401\t            instance = built.value;\n402\t\n403\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n404\t            if (!seeded.ok) {\n405\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n406\t              await disposeInstance(instance);\n407\t              instance = null;\n408\t              state = null;\n409\t              captureSession = null;\n410\t              return;\n411\t            } else {\n412\t              resolved = { ok: true, value: targetThreadRef };\n413\t            }\n414\t          }\n415\t        }\n416\t      }\n417\t    }\n418\t\n419\t    // Normal launch resolution (if not resolved by fork paths above).\n420\t    if (resolved === undefined) {\n421\t      const launch = parseLaunch();\n422\t      const isReload = event.reason === \"reload\";\n423\t      resolved = isReload\n424\t        ? await resolveReloadFor(launch, ctx)\n425\t        : await resolveForLaunch(launch, ctx);\n426\t    }\n427\t\n428\t    if (!resolved.ok) {\n429\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n430\t      return;\n431\t    }\n432\t    if (resolved.value === null) {\n433\t      const isReload = event.reason === \"reload\";\n434\t      lastDiagnostic = isReload\n435\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n436\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n437\t      return;\n438\t    }\n439\t\n440\t    // If instance wasn't created during fork path, create it now.\n441\t    if (instance === null) {\n442\t      const built = await initInstance(resolved.value, config.value);\n443\t      if (!built.ok) {\n444\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n445\t        return;\n446\t      }\n447\t      instance = built.value;\n448\t    }\n449\t\n450\t    state = createSessionState(resolved.value);\n451\t    const piSessionId = sessionIdOf(resolved.value);\n452\t    captureSession = {\n453\t      piSessionId,\n454\t      accumulator: new TurnAccumulator({ piSessionId }),\n455\t      sourceSeq: 0,\n456\t    };\n457\t  };\n458\t\n459\t  // Dispose with flush before any session swap (session_before_switch fires\n460\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n461\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n462\t  // re-resolves its thread from the durable registry on the next session_start.\n463\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n464\t    const result = await disposeInstance(instance);\n465\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n466\t    instance = null;\n467\t    captureSession = null;\n468\t  };\n469\t\n470\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n471\t  // converter already recorded a durable gap for a writable-thread malformed\n472\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n473\t  // surfaces as an extension health signal with no gap. Neither path throws.\n474\t  function recordCaptureOutcome(\n475\t    result: OpResult<BatchResult>,\n476\t    events: readonly MessageEventInput[],\n477\t  ): void {\n478\t    if (result.ok) return;\n479\t    const recordedGap = result.error.code === \"invalid_event\";\n480\t    const failure: CaptureFailureDiagnostic = {\n481\t      code: result.error.code,\n482\t      message: result.error.reason,\n483\t      recordedGap,\n484\t    };\n485\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n486\t    lastDiagnostic = failure;\n487\t    if (state !== null) state.health.lastCaptureFailure = failure;\n488\t  }\n489\t\n490\t  function nextSourceSeq(session: CaptureSession): number {\n491\t    const sourceSeq = session.sourceSeq;\n492\t    session.sourceSeq += 1;\n493\t    return sourceSeq;\n494\t  }\n495\t\n496\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n497\t    // Last-resort id-less discriminator. PI position wins when present; the\n498\t    // connector ordinal is used only when PI gives no event identity at all.\n499\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n500\t    // order yields the same ordinal, which is the best identity available.\n501\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n502\t  }\n503\t\n504\t  async function recordMappingFailure(\n505\t    hook: string,\n506\t    position: number | undefined,\n507\t    sourceSeq: number,\n508\t    cause: unknown,\n509\t  ): Promise<void> {\n510\t    if (instance === null) return;\n511\t    const message = cause instanceof Error ? cause.message : String(cause);\n512\t    const result = await captureGap(\n513\t      fallbackIdFor(hook, position, sourceSeq),\n514\t      `${hook}: ${message}`,\n515\t      instance,\n516\t    );\n517\t    if (!result.ok) {\n518\t      recordCaptureOutcome(result, []);\n519\t      return;\n520\t    }\n521\t    const failure: CaptureFailureDiagnostic = {\n522\t      code: \"invalid_event\",\n523\t      message: `${hook}: ${message}`,\n524\t      recordedGap: true,\n525\t    };\n526\t    lastDiagnostic = failure;\n527\t    if (state !== null) state.health.lastCaptureFailure = failure;\n528\t  }\n529\t\n530\t  // message_end: map the finalized PI message to ordered LHC events, track the\n531\t  // open turn, and flush through the converter (AC-2.1).\n532\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n533\t    if (instance === null || captureSession === null) return;\n534\t    const sourceSeq = nextSourceSeq(captureSession);\n535\t    const mapCtx: MapCtx =\n536\t      event.entryId !== undefined && event.entryId !== \"\"\n537\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n538\t        : {\n539\t            piSessionId: captureSession.piSessionId,\n540\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n541\t          };\n542\t    let events: MessageEventInput[];\n543\t    try {\n544\t      events = mapMessage(event.message, mapCtx);\n545\t    } catch (cause) {\n546\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n547\t      return;\n548\t    }\n549\t    captureSession.accumulator.onMessage(events);\n550\t    if (events.length === 0) return;\n551\t    recordCaptureOutcome(await capture(events, instance), events);\n552\t  };\n553\t\n554\t  // model_select / thinking_level_select fire only in-stream — capture each as\n555\t  // an ordered runtime_note the moment it fires (AC-2.8).\n556\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n557\t    if (instance === null || captureSession === null) return;\n558\t    const sourceSeq = nextSourceSeq(captureSession);\n559\t    const mapCtx: MapCtx = {\n560\t      piSessionId: captureSession.piSessionId,\n561\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n562\t    };\n563\t    const note = mapModelSelect(event, mapCtx);\n564\t    recordCaptureOutcome(await capture([note], instance), [note]);\n565\t  };\n566\t\n567\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n568\t    if (instance === null || captureSession === null) return;\n569\t    const sourceSeq = nextSourceSeq(captureSession);\n570\t    const mapCtx: MapCtx = {\n571\t      piSessionId: captureSession.piSessionId,\n572\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n573\t    };\n574\t    const note = mapThinkingLevelSelect(event, mapCtx);\n575\t    recordCaptureOutcome(await capture([note], instance), [note]);\n576\t  };\n577\t\n578\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n579\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n580\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n581\t    if (instance === null || captureSession === null) return;\n582\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n583\t    if (turnEnd.length === 0) return;\n584\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n585\t  };\n586\t\n587\t  // Contain every handler: an observe-only hook must never throw back into PI\n588\t  // (a thrown hook breaks the user's session). A caught error becomes a\n589\t  // plain-data diagnostic; it is never rethrown.\n590\t  const guard = (\n591\t    name: Epic1Hook,\n592\t    body: PiHookHandler<Epic1Hook>,\n593\t  ): PiHookHandler<Epic1Hook> => {\n594\t    return async (ctx, event): Promise<void> => {\n595\t      try {\n596\t        await body(ctx, event);\n597\t      } catch (err) {\n598\t        lastDiagnostic = {\n599\t          code: \"hook_handler_error\",\n600\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n601\t          recordedGap: false,\n602\t        };\n603\t      }\n604\t    };\n605\t  };\n606\t\n607\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n608\t  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n609\t  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n610\t  const noop: PiHookHandler<Epic1Hook> = () => {\n611\t    // Intentionally empty — turn_end is ignored as a boundary.\n612\t  };\n613\t\n614\t  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n615\t  // The source thread ref is captured from the current session state; the hook\n616\t  // provides entryId/position identifying the fork point. No writes to the source\n617\t  // thread occur — the fork happens on the next session_start (Story 4).\n618\t  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n619\t    if (state === null) return;\n620\t    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n621\t    // Store the fork info for use on session_start{fork}.\n622\t    pendingFork = {\n623\t      sourceThreadRef: state.threadRef,\n624\t      forkEntryId: forkInfo.forkEntryId,\n625\t    };\n626\t  };\n627\t\n628\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n629\t  // are live; fork handling (Story 4) is wired.\n630\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n631\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n632\t    session_before_switch: onDispose,\n633\t    session_shutdown: onDispose,\n634\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n635\t    turn_end: noop,\n636\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n637\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n638\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n639\t    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n640\t  };\n641\t\n642\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n643\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n644\t\n645\t  return {\n646\t    handlers,\n647\t    register(pi: ExtensionAPI): void {\n648\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n649\t    },\n650\t    getState(): SessionState | null {\n651\t      return state;\n652\t    },\n653\t    getInstance(): LhcInstance | null {\n654\t      return instance;\n655\t    },\n656\t    snapshot(): ConnectorSnapshot {\n657\t      return { state, lastDiagnostic };\n658\t    },\n659\t  };\n660\t}\n661\t\n662\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n663\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n664\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n665\t *  observe-only SDK config, and the `--resume` selector that presents the\n666\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n667\t *  resolves/creates and initializes for real. On `/reload` the connector\n668\t *  re-resolves the same thread from the durable registry (it keeps no\n669\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n670\t *  config. */\n671\texport function activate(pi: ExtensionAPI): void {\n672\t  createConnector().register(pi);\n673\t}\n674\t\n675\texport default activate;\n676\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"620263f6-7c50-4c5c-8004-b9c8cd4e8c9b","timestamp":"2026-06-14T12:28:23.350Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  DerivationProvider,\n  MessageEventInput,\n  OpResult,\n  ProviderResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport {\n  detectForkFromSessionTree,\n  forkInfoFromHook,\n  seedFork,\n} from \"./lifecycle/fork.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { threads } from \"lhc\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** Fork state captured from `session_before_fork` and used on the next\n *  `session_start{fork}` to create and seed the forked thread. Plain data\n *  only — no PI objects retained across the fork boundary. */\ninterface PendingFork {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\n *  whose every operation fails closed (non-retryable) instead of fabricating a\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n *  derivation work is ever queued and this provider is never invoked — it exists\n *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n *\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\n *  documents as \"selectable only by explicit name — never a production default\"\n *  (it would mark fake derived text into the thread). Failing closed preserves\n *  the observe-only guarantee even if a future change queued work before Stories\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n *  assignments), which is what a real *completing* inference requires (the\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\nfunction observeOnlyProvider(): DerivationProvider {\n  const notConfigured = (): Promise<ProviderResult> =>\n    Promise.resolve({\n      ok: false,\n      retryable: false,\n      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n    });\n  return {\n    smoothPrompt: notConfigured,\n    summarizeToolCall: notConfigured,\n    summarizeToolResult: notConfigured,\n    composeTurnRendering: notConfigured,\n    projectLowerBand: notConfigured,\n    summarizeChunkDetailed: notConfigured,\n    summarizeChunkBrief: notConfigured,\n  };\n}\n\n/** The production observe-only SDK config: a real, construction-valid instance\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n *  config. */\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n *  most recently created thread as the best available explicit default. The\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n *  takes the `select` seam); tests drive an explicit operator choice through it.\n *  A true interactive picker awaits a PI input surface; until then resuming a\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n *  precise spec deviation. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  if (mostRecent === undefined) return Promise.resolve(null);\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n  }\n  return Promise.resolve(mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n  let pendingFork: PendingFork | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        state = null;\n        captureSession = null;\n        return;\n      } else {\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            await disposeInstance(instance);\n            instance = null;\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        forkAttempted = true;\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              await disposeInstance(instance);\n              instance = null;\n              state = null;\n              captureSession = null;\n              return;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";\n      resolved = isReload\n        ? await resolveReloadFor(launch, ctx)\n        : await resolveForLaunch(launch, ctx);\n    }\n\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      const isReload = event.reason === \"reload\";\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n\n    // If instance wasn't created during fork path, create it now.\n    if (instance === null) {\n      const built = await initInstance(resolved.value, config.value);\n      if (!built.ok) {\n        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n        return;\n      }\n      instance = built.value;\n    }\n\n    state = createSessionState(resolved.value);\n    const piSessionId = sessionIdOf(resolved.value);\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId }),\n      sourceSeq: 0,\n    };\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  function nextSourceSeq(session: CaptureSession): number {\n    const sourceSeq = session.sourceSeq;\n    session.sourceSeq += 1;\n    return sourceSeq;\n  }\n\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n    // Last-resort id-less discriminator. PI position wins when present; the\n    // connector ordinal is used only when PI gives no event identity at all.\n    // For id-less + position-less reload replay, PI's deterministic redelivery\n    // order yields the same ordinal, which is the best identity available.\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n  }\n\n  async function recordMappingFailure(\n    hook: string,\n    position: number | undefined,\n    sourceSeq: number,\n    cause: unknown,\n  ): Promise<void> {\n    if (instance === null) return;\n    const message = cause instanceof Error ? cause.message : String(cause);\n    const result = await captureGap(\n      fallbackIdFor(hook, position, sourceSeq),\n      `${hook}: ${message}`,\n      instance,\n    );\n    if (!result.ok) {\n      recordCaptureOutcome(result, []);\n      return;\n    }\n    const failure: CaptureFailureDiagnostic = {\n      code: \"invalid_event\",\n      message: `${hook}: ${message}`,\n      recordedGap: true,\n    };\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  // message_end: map the finalized PI message to ordered LHC events, track the\n  // open turn, and flush through the converter (AC-2.1).\n  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx =\n      event.entryId !== undefined && event.entryId !== \"\"\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n        : {\n            piSessionId: captureSession.piSessionId,\n            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n          };\n    let events: MessageEventInput[];\n    try {\n      events = mapMessage(event.message, mapCtx);\n    } catch (cause) {\n      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n      return;\n    }\n    captureSession.accumulator.onMessage(events);\n    if (events.length === 0) return;\n    recordCaptureOutcome(await capture(events, instance), events);\n  };\n\n  // model_select / thinking_level_select fire only in-stream — capture each as\n  // an ordered runtime_note the moment it fires (AC-2.8).\n  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n    };\n    const note = mapModelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n    };\n    const note = mapThinkingLevelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n    if (instance === null || captureSession === null) return;\n    const turnEnd = captureSession.accumulator.onAgentEnd();\n    if (turnEnd.length === 0) return;\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — turn_end is ignored as a boundary.\n  };\n\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n  // The source thread ref is captured from the current session state; the hook\n  // provides entryId/position identifying the fork point. No writes to the source\n  // thread occur — the fork happens on the next session_start (Story 4).\n  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n    if (state === null) return;\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n    // Store the fork info for use on session_start{fork}.\n    pendingFork = {\n      sourceThreadRef: state.threadRef,\n      forkEntryId: forkInfo.forkEntryId,\n    };\n  };\n\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n  // are live; fork handling (Story 4) is wired.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n    turn_end: noop,\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from the durable registry (it keeps no\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n *  config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":676,"startLine":1,"totalLines":676}}}

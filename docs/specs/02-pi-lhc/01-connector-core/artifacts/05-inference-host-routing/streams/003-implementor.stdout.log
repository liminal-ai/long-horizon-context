{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9248dca8ff214c9f89119d39","type":"tool_result","content":"1\t// Deterministic ModelCall fakes — the inference edge (tech design §Fixture\n2\t// Contracts / Testing Strategy). These stand in for `ctx.modelRegistry` +\n3\t// pi-ai `complete`, so the inference tests (Story 5) control completion text\n4\t// and failure shapes without a live provider.\n5\timport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\n6\t\n7\t/** Always resolves to text. */\n8\texport function fakeModelCallText(text: string): ModelCall {\n9\t  return () => Promise.resolve<ModelCallResult>({ ok: true, text });\n10\t}\n11\t\n12\t/** Always resolves to a classified transport failure. */\n13\texport function fakeModelCallFailure(\n14\t  kind: ModelCallFailureKind,\n15\t  message = `injected ${kind}`,\n16\t): ModelCall {\n17\t  return () => Promise.resolve<ModelCallResult>({ ok: false, kind, message });\n18\t}\n19\t\n20\t/** Routes each call by its `provider/model` key to a per-lane fake — the\n21\t *  multi-lane substrate for AC-4.2. An unrouted key resolves to an\n22\t *  `invalid_request` failure (never a silent success). */\n23\texport function fakeModelCallRouter(\n24\t  routes: Record<string, ModelCall>,\n25\t  fallback?: ModelCall,\n26\t): ModelCall {\n27\t  return (input) => {\n28\t    const key = `${input.provider}/${input.model}`;\n29\t    const route = routes[key] ?? fallback;\n30\t    if (route === undefined) {\n31\t      return Promise.resolve<ModelCallResult>({\n32\t        ok: false,\n33\t        kind: \"invalid_request\",\n34\t        message: `no fake route for ${key}`,\n35\t      });\n36\t    }\n37\t    return route(input);\n38\t  };\n39\t}\n40\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"f4d4039f-d7f5-4367-90be-f6c379a26d87","timestamp":"2026-06-14T12:28:09.426Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.ts","content":"// Deterministic ModelCall fakes — the inference edge (tech design §Fixture\n// Contracts / Testing Strategy). These stand in for `ctx.modelRegistry` +\n// pi-ai `complete`, so the inference tests (Story 5) control completion text\n// and failure shapes without a live provider.\nimport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\n\n/** Always resolves to text. */\nexport function fakeModelCallText(text: string): ModelCall {\n  return () => Promise.resolve<ModelCallResult>({ ok: true, text });\n}\n\n/** Always resolves to a classified transport failure. */\nexport function fakeModelCallFailure(\n  kind: ModelCallFailureKind,\n  message = `injected ${kind}`,\n): ModelCall {\n  return () => Promise.resolve<ModelCallResult>({ ok: false, kind, message });\n}\n\n/** Routes each call by its `provider/model` key to a per-lane fake — the\n *  multi-lane substrate for AC-4.2. An unrouted key resolves to an\n *  `invalid_request` failure (never a silent success). */\nexport function fakeModelCallRouter(\n  routes: Record<string, ModelCall>,\n  fallback?: ModelCall,\n): ModelCall {\n  return (input) => {\n    const key = `${input.provider}/${input.model}`;\n    const route = routes[key] ?? fallback;\n    if (route === undefined) {\n      return Promise.resolve<ModelCallResult>({\n        ok: false,\n        kind: \"invalid_request\",\n        message: `no fake route for ${key}`,\n      });\n    }\n    return route(input);\n  };\n}\n","numLines":40,"startLine":1,"totalLines":40}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_dac85320d5a8463cb139a748","type":"tool_result","content":"1\timport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\n2\timport type { ExtensionContext } from \"../pi/types.js\";\n3\timport { NotImplementedError } from \"../shared/not-implemented.js\";\n4\t\n5\t// AC-4.1..4.4. The host function resolves (provider,model) via\n6\t// `ctx.modelRegistry.find` and completes via pi-ai's `complete()` (imported\n7\t// from `@earendil-works/pi-ai` in Story 5), returning text or a classified\n8\t// failure. Provider/model are opaque routing keys.\n9\t\n10\t/** Build the host `ModelCall`. Fail-closed until Story 5: the returned function\n11\t *  resolves to a transport failure (`other`), never `{ ok: true }` — so no\n12\t *  derivation can land on a faked completion (story §Anti-Shim). */\n13\texport function createModelCall(ctx: ExtensionContext): ModelCall {\n14\t  return (): Promise<ModelCallResult> =>\n15\t    Promise.resolve({\n16\t      ok: false,\n17\t      kind: \"other\",\n18\t      message: \"inference.createModelCall is not implemented yet (Epic 1 foundation stub)\",\n19\t    });\n20\t}\n21\t\n22\t/** Pure mapping of a PI/pi-ai failure shape to a `ModelCallFailureKind`\n23\t *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n24\t *  thrown → other). Story 5. */\n25\texport function classifyFailure(err: unknown): ModelCallFailureKind {\n26\t  throw new NotImplementedError(\"inference.classifyFailure\");\n27\t}\n28\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"44c1b4d3-feba-4cc4-929a-3691c3bd1683","timestamp":"2026-06-14T12:28:07.753Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts","content":"import type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\nimport type { ExtensionContext } from \"../pi/types.js\";\nimport { NotImplementedError } from \"../shared/not-implemented.js\";\n\n// AC-4.1..4.4. The host function resolves (provider,model) via\n// `ctx.modelRegistry.find` and completes via pi-ai's `complete()` (imported\n// from `@earendil-works/pi-ai` in Story 5), returning text or a classified\n// failure. Provider/model are opaque routing keys.\n\n/** Build the host `ModelCall`. Fail-closed until Story 5: the returned function\n *  resolves to a transport failure (`other`), never `{ ok: true }` — so no\n *  derivation can land on a faked completion (story §Anti-Shim). */\nexport function createModelCall(ctx: ExtensionContext): ModelCall {\n  return (): Promise<ModelCallResult> =>\n    Promise.resolve({\n      ok: false,\n      kind: \"other\",\n      message: \"inference.createModelCall is not implemented yet (Epic 1 foundation stub)\",\n    });\n}\n\n/** Pure mapping of a PI/pi-ai failure shape to a `ModelCallFailureKind`\n *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n *  thrown → other). Story 5. */\nexport function classifyFailure(err: unknown): ModelCallFailureKind {\n  throw new NotImplementedError(\"inference.classifyFailure\");\n}\n","numLines":28,"startLine":1,"totalLines":28}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_210edc52a09f40db8bbfb147","type":"tool_result","content":"1\t// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\n2\t// injected ModelCall function and persists outcomes queryable through\n3\t// inspect/health.\n4\t//\n5\t// This test proves the full capture → derivation → recorded-outcome loop, not\n6\t// just the function in isolation. It:\n7\t// 1. Captures content to a thread (through the real converter)\n8\t// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\n9\t// 3. Awaits drainSettled to flush background work\n10\t// 4. Asserts both ready forms and classified failures exist in the thread\n11\t//\n12\t// Architecture-risk test: concurrency/lost-update — a stale background result does\n13\t// not clobber newer thread state.\n14\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n15\timport {\n16\t  createDeterministicProvider,\n17\t  inspect,\n18\t  intakeStream,\n19\t  threads,\n20\t  type FormKind,\n21\t  type InferenceConfig,\n22\t  type ModelAssignment,\n23\t  type ModelCall,\n24\t  type ModelCallFailureKind,\n25\t  type ModelCallResult,\n26\t  type SdkConfig,\n27\t  type ThreadRef,\n28\t  DEFAULT_DEFAULT_PROMPT_NAMES,\n29\t} from \"lhc\";\n30\timport { createConnector, type Connector } from \"../../src/index.js\";"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"e0b96c04-f4e7-465b-b6e7-5c968eae9000","timestamp":"2026-06-14T12:32:04.109Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts","content":"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\n// injected ModelCall function and persists outcomes queryable through\n// inspect/health.\n//\n// This test proves the full capture → derivation → recorded-outcome loop, not\n// just the function in isolation. It:\n// 1. Captures content to a thread (through the real converter)\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\n// 3. Awaits drainSettled to flush background work\n// 4. Asserts both ready forms and classified failures exist in the thread\n//\n// Architecture-risk test: concurrency/lost-update — a stale background result does\n// not clobber newer thread state.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  intakeStream,\n  threads,\n  type FormKind,\n  type InferenceConfig,\n  type ModelAssignment,\n  type ModelCall,\n  type ModelCallFailureKind,\n  type ModelCallResult,\n  type SdkConfig,\n  type ThreadRef,\n  DEFAULT_DEFAULT_PROMPT_NAMES,\n} from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";","numLines":30,"startLine":1,"totalLines":323}}}

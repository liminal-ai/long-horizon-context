ipt,\n47\t  ViewCompactParams,\n48\t  ViewProfile,\n49\t  ViewStatus,\n50\t} from \"./shared/view.js\";\n51\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n52\t\n53\texport {\n54\t  estimateTokens,\n55\t  TOKEN_ESTIMATOR_ID,\n56\t} from \"./tech-utils/token-counting/index.js\";\n57\t\n58\texport {\n59\t  WORK_KIND_REGISTRY,\n60\t  type WorkItemRecord,\n61\t  type WorkKind,\n62\t  type WorkOwner,\n63\t  type WorkSourceRef,\n64\t} from \"./tech-utils/work-queue/index.js\";\n65\t\n66\texport type {\n67\t  ErrorClass,\n68\t  ErrorCode,\n69\t  ErrorResult,\n70\t  OpResult,\n71\t} from \"./shared/errors.js\";\n72\texport {\n73\t  runInTransaction,\n74\t  setSchedulerPoke,\n75\t  setThreadTouch,\n76\t  type OperationContext,\n77\t} from \"./shared/context.js\";\n78\t\n79\texport {\n80\t  createDeterministicProvider,\n81\t  deterministicOutcomesSuffix,\n82\t  deterministicReceiptsSuffix,\n83\t  deterministicText,\n84\t  type DeterministicOpName,\n85\t} from \"./providers/deterministic.js\";\n86\texport type {\n87\t  CompletionTx,\n88\t  DependencyGap,\n89\t  DerivationProvider,\n90\t  DerivedForm,\n91\t  DerivedFormMetadata,\n92\t  DerivedFormState,\n93\t  FormKind,\n94\t  FormReportEntry,\n95\t  HandlerFormWrite,\n96\t  HandlerOutcome,\n97\t  HandlerRunContext,\n98\t  ProviderResult,\n99\t  RenderingPart,\n100\t  ResolvedSdkConfig,\n101\t  SdkConfig,\n102\t  SubjectKind,\n103\t  ToolOutcome,\n104\t  ToolRunReceipt,\n105\t  WorkHandler,\n106\t} from \"./shared/derivation.js\";\n107\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n108\t\n109\t// Epic 05 inference vocabulary (inference/types.ts): the host-supplied\n110\t// ModelCall boundary and the per-kind assignment config — type-only; the\n111\t// adapter and registry are construction internals behind createSdk.\n112\texport type {\n113\t  InferenceConfig,\n114\t  ModelAssignment,\n115\t  ModelCall,\n116\t  ModelCallFailureKind,\n117\t  ModelCallInput,\n118\t  ModelCallResult,\n119\t} from \"./inference/types.js\";\n120\texport type { ProviderProvenance } from \"./shared/derivation.js\";\n121\t\n122\t// The config-selectable prompt-name catalog (E05-NB-2): the full set of names\n123\t// a per-kind assignment may select, and the default name per kind. Exposed so\n124\t// operators discover valid prompt names from the SDK surface without reading\n125\t// source. The registry itself stays a construction internal behind createSdk.\n126\texport {\n127\t  DEFAULT_PROMPT_NAMES,\n128\t  PROMPT_NAMES,\n129\t} from \"./inference/prompts/index.js\";\n130\t\n131\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n132\t// from Story 0; the operation shapes land with Stories 1–5.\n133\texport {\n134\t  BUILT_IN_PROFILES,\n135\t  DEFAULT_COMPACT_THRESHOLD,\n136\t  DEFAULT_VISIBILITY,\n137\t} from \"./domains/thread-view/index.js\";\n138\texport type {\n139\t  Band,\n140\t  CompactReceipt,\n141\t  PullResult,\n142\t  ResolvedViewConfig,\n143\t  SdkViewConfig,\n144\t  StoredView,\n145\t  SweepReceipt,\n146\t  ViewCompactParams,\n147\t  ViewMessage,\n148\t  ViewMeta,\n149\t  ViewProfile,\n150\t  ViewProfileOverride,\n151\t  ViewStatus,\n152\t  VisibilityBudgets,\n153\t} from \"./shared/view.js\";\n154\texport {\n155\t  countLiveItems,\n156\t  enqueue,\n157\t  queueDetail,\n158\t  supersedeQueued,\n159\t  type ClaimedWorkItem,\n160\t  type EnqueueFormTarget,\n161\t  type EnqueueInput,\n162\t  type QueueDetailRow,\n163\t} from \"./tech-utils/work-queue/index.js\";\n164\t\n165\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n166\t// inspect surface serves.\n167\texport type {\n168\t  HealthReport,\n169\t  InspectOverview,\n170\t  ViewContentsReport,\n171\t} from \"./shared/inspect.js\";\n172\t\n173\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n174\texport type {\n175\t  Block,\n176\t  BlockType,\n177\t  MessageDetail,\n178\t  MessageListOptions,\n179\t  MessageRecord,\n180\t  MutationResult,\n181\t} from \"./domains/messages/index.js\";\n182\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n183\texport type {\n184\t  BatchResult,\n185\t  EventKind,\n186\t  EventRecord,\n187\t  MessageEventInput,\n188\t} from \"./domains/intake-stream/index.js\";\n189\t\n190\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n191\t\n192\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n193\t\n194\t// Merge per-domain handler tables into the one join between the queue's\n195\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n196\t// (each kind has exactly one owner) and throws at construction.\n197\texport function assembleWorkHandlerMap(\n198\t  tables: ReadonlyArray<WorkHandlerMap>,\n199\t): WorkHandlerMap {\n200\t  const map: WorkHandlerMap = {};\n201\t  for (const table of tables) {\n202\t    for (const [kind, handler] of Object.entries(table)) {\n203\t      if (map[kind as WorkKind] !== undefined) {\n204\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n205\t      }\n206\t      map[kind as WorkKind] = handler;\n207\t    }\n208\t  }\n209\t  return map;\n210\t}\n211\t\n212\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n213\t  return {\n214\t    ok: false,\n215\t    error: {\n216\t      errorClass: \"state_corruption\",\n217\t      code: \"unknown_work_kind\",\n218\t      reason: `no handler registered for work kind \"${kind}\"`,\n219\t    },\n220\t  };\n221\t}\n222\t\n223\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n224\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n225\texport function lookupWorkHandler(\n226\t  map: WorkHandlerMap,\n227\t  kind: string,\n228\t): OpResult<WorkHandler> {\n229\t  const handler = map[kind as WorkKind];\n230\t  if (handler === undefined) return unknownWorkKind(kind);\n231\t  return { ok: true, value: handler };\n232\t}\n233\t\n234\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n235\t// requeue land in Story 4.\n236\texport interface WorkSurface {\n237\t  drain(\n238\t    ref: threadsDomain.ThreadRef,\n239\t    opts?: { maxItems?: number },\n240\t  ): Promise<OpResult<DrainReport>>;\n241\t}\n242\t\n243\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n244\t// §Interface Definitions): the operations only — the Story 0 config\n245\t// substrate the domain index also carries is construction machinery, not an\n246\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n247\t// inspect domain composes (DD-1).\n248\texport interface ThreadViewSurface {\n249\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n250\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n251\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n252\t  compact(\n253\t    ref: threadsDomain.ThreadRef,\n254\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n255\t  ): Promise<OpResult<CompactReceipt>>;\n256\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n257\t  materialize(\n258\t    ref: threadsDomain.ThreadRef,\n259\t    opts: { path: string; format?: \"pi-session\" },\n260\t  ): Promise<OpResult<{ writtenPath: string }>>;\n261\t}\n262\t\n263\texport interface Lhc {\n264\t  threads: typeof threadsDomain;\n265\t  intakeStream: typeof intakeStreamDomain;\n266\t  messages: typeof messagesDomain;\n267\t  turns: typeof turnsDomain;\n268\t  threadView: ThreadViewSurface;\n269\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n270\t  // like every other namespace so the status read it composes resolves THIS\n271\t  // SDK's view config (threshold, visibility budgets).\n272\t  inspect: typeof inspectDomain;\n273\t  config: ResolvedSdkConfig;\n274\t  scheduler: Scheduler;\n275\t  workHandlers: WorkHandlerMap;\n276\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n277\t  work: WorkSurface;\n278\t  // Resolves when the scheduler has no running or pending drain for the\n279\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n280\t  // resolve in manual mode.\n281\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n282\t}\n283\t\n284\tfunction requirePositive(value: number, name: string): void {\n285\t  if (!Number.isFinite(value) || value <= 0) {\n286\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n287\t  }\n288\t}\n289\t\n290\tfunction requireNonNegative(value: number, name: string): void {\n291\t  if (!Number.isFinite(value) || value < 0) {\n292\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n293\t  }\n294\t}\n295\t\n296\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n297\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n298\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n299\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n300\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n301\t// object is the same shape as the namespace, so the public surface type holds.\n302\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n303\t  const scoped: Record<string, unknown> = {};\n304\t  for (const key of Object.keys(surface)) {\n305\t    const value = (surface as Record<string, unknown>)[key];\n306\t    scoped[key] =\n307\t      typeof value === \"function\"\n308\t        ? (...args: unknown[]): unknown =>\n309\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n310\t        : value;\n311\t  }\n312\t  return scoped as T;\n313\t}\n314\t\n315\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n316\t// the host function and the complete assignment map loudly — all seven kinds\n317\t// present (iterating the exported FORM_KINDS set, never a second literal\n318\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n319\t// provider/model routing keys — then build the adapter into the same\n320\t// DerivationProvider slot direct injection uses. No partial construction:\n321\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n322\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n323\t  if (typeof inference.call !== \"function\") {\n324\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n325\t  }\n326\t  const assignments = inference.assignments as unknown;\n327\t  if (assignments === null || typeof assignments !== \"object\") {\n328\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n329\t  }\n330\t  const knownKinds = new Set<string>(FORM_KINDS);\n331\t  for (const key of Object.keys(assignments)) {\n332\t    if (!knownKinds.has(key)) {\n333\t      throw new TypeError(\n334\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n335\t      );\n336\t    }\n337\t  }\n338\t  const map = assignments as Partial<Record<FormKind, ModelAssignment>>;\n339\t  for (const kind of FORM_KINDS) {\n340\t    const assignment = map[kind];\n341\t    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n342\t      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n343\t    }\n344\t    for (const field of [\"provider\", \"model\"] as const) {\n345\t      const value = assignment[field];\n346\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n347\t        throw new TypeError(\n348\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n349\t        );\n350\t      }\n351\t    }\n352\t    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n353\t      throw new TypeError(\n354\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n355\t      );\n356\t    }\n357\t  }\n358\t  const timeoutMs = inference.timeoutMs ?? 60_000;\n359\t  const maxInputChars = inference.maxInputChars ?? 200_000;\n360\t  requirePositive(timeoutMs, \"inference.timeoutMs\");\n361\t  requirePositive(maxInputChars, \"inference.maxInputChars\");\n362\t  return createInferenceProvider({\n363\t    call: inference.call,\n364\t    assignments: map as Record<FormKind, ModelAssignment>,\n365\t    timeoutMs,\n366\t    maxInputChars,\n367\t  });\n368\t}\n369\t\n370\t// The only assembly path: provider, mode, clock, and policy enter here.\n371\t// Config mistakes are programmer errors at construction and throw; operating\n372\t// failures after construction return OpResults per the error contract.\n373\texport function createSdk(config: SdkConfig): Lhc {\n374\t  // Provider arrival is exactly one of direct injection or the inference\n375\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n376\t  // env/flag resolution path to fall back on. The XOR rule is validated\n377\t  // before anything downstream so the error names the caller's mistake, not\n378\t  // a symptom (AC-1.1).\n379\t  if (config.provider !== undefined && config.inference !== undefined) {\n380\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n381\t  }\n382\t  if (config.provider === undefined && config.inference === undefined) {\n383\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n384\t  }\n385\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n386\t    throw new TypeError(\n387\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n388\t    );\n389\t  }\n390\t  let provider: DerivationProvider;\n391\t  if (config.inference !== undefined) {\n392\t    provider = resolveInferenceProvider(config.inference);\n393\t  } else {\n394\t    if (config.provider === null || typeof config.provider !== \"object\") {\n395\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n396\t    }\n397\t    for (const operation of PROVIDER_OPERATIONS) {\n398\t      if (typeof config.provider[operation] !== \"function\") {\n399\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n400\t      }\n401\t    }\n402\t    provider = config.provider;\n403\t  }\n404\t\n405\t  const resolved: ResolvedSdkConfig = {\n406\t    provider,\n407\t    mode: config.mode,\n408\t    clock: config.clock ?? (() => new Date()),\n409\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n410\t    lease: config.lease ?? { durationMs: 120000 },\n411\t    chunkPolicy:\n412\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n413\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n414\t    // sums and visibility budgets validated — throws naming the violation.\n415\t    view: resolveViewConfig(config.view),\n416\t  };\n417\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n418\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n419\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n420\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n421\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n422\t  }\n423\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n424\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n425\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n426\t    throw new TypeError(\n427\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n428\t    );\n429\t  }\n430\t\n431\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n432\t  // The tables are empty until Stories 2–3 land the real handlers; the\n433\t  // assembly mechanics are production code from day one.\n434\t  const workHandlers = assembleWorkHandlerMap([\n435\t    messagesDomain.workHandlers,\n436\t    turnsDomain.workHandlers,\n437\t  ]);\n438\t\n439\t  const drainDeps: DrainDeps = {\n440\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n441\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n442\t    config: resolved,\n443\t  };\n444\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n445\t\n446\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n447\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n448\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n449\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n450\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n451\t  // the construction order, because its operations deliver to the no-op seam,\n452\t  // not to whatever a background SDK installed below.\n453\t  // The seam also carries this instance's resolved view config (Epic 03,\n454\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n455\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n456\t  // fall back to the built-in defaults inside the thread-view surface.\n457\t  const seam: InstanceSeam =\n458\t    resolved.mode === \"background\"\n459\t      ? {\n460\t          poke: (threadId) => scheduler.poke(threadId),\n461\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n462\t          view: resolved.view,\n463\t        }\n464\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n465\t\n466\t  // Background mode also installs the below-SDK default seam so a direct\n467\t  // domain call made with no SDK scope — a top-level mutation in the\n468\t  // single-background \"production path\" — still reaches the one installed\n469\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n470\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n471\t  // leaves the default alone (pokes stay no-ops by contract).\n472\t  if (resolved.mode === \"background\") {\n473\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n474\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n475\t  }\n476\t\n477\t  const work: WorkSurface = {\n478\t    drain: (ref, opts) =>\n479\t      runWithInstanceSeam(seam, async () => {\n480\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n481\t        if (!resolvedRef.ok) return resolvedRef;\n482\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n483\t      }),\n484\t  };\n485\t\n486\t  return {\n487\t    threads: threadsDomain,\n488\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n489\t    messages: scopeSurface(messagesDomain, seam),\n490\t    turns: scopeSurface(turnsDomain, seam),\n491\t    threadView: scopeSurface<ThreadViewSurface>(\n492\t      {\n493\t        pull: threadViewDomain.pull,\n494\t        status: threadViewDomain.status,\n495\t        describe: threadViewDomain.describe,\n496\t        compact: threadViewDomain.compact,\n497\t        sweep: threadViewDomain.sweep,\n498\t        materialize: threadViewDomain.materialize,\n499\t      },\n500\t      seam,\n501\t    ),\n502\t    inspect: scopeSurface(inspectDomain, seam),\n503\t    config: resolved,\n504\t    scheduler,\n505\t    workHandlers,\n506\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n507\t    work,\n508\t    drainSettled: async (ref) => {\n509\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n510\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n511\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n512\t      if (threadId === null) return;\n513\t      return scheduler.drainSettled(threadId);\n514\t    },\n515\t  };\n516\t}\n517\t"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"c917fe37-6818-45d1-827e-5a17adf3877c","timestamp":"2026-06-14T12:28:00.397Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\nexport * as threadView from \"./domains/thread-view/index.js\";\nexport * as inspect from \"./domains/inspect/index.js\";\n\nimport * as inspectDomain from \"./domains/inspect/index.js\";\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as threadViewDomain from \"./domains/thread-view/index.js\";\nimport { resolveViewConfig } from \"./domains/thread-view/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport {\n  runWithInstanceSeam,\n  setSchedulerPoke as installSchedulerPoke,\n  setThreadTouch,\n  type InstanceSeam,\n} from \"./shared/context.js\";\nimport { createInferenceProvider } from \"./inference/adapter.js\";\nimport { PROMPT_REGISTRY } from \"./inference/prompts/index.js\";\nimport type { InferenceConfig, ModelAssignment } from \"./inference/types.js\";\nimport {\n  FORM_KINDS,\n  PROVIDER_OPERATIONS,\n  type DerivationProvider,\n  type FormKind,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  StoredView,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewProfile,\n  ViewStatus,\n} from \"./shared/view.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n\n// Epic 05 inference vocabulary (inference/types.ts): the host-supplied\n// ModelCall boundary and the per-kind assignment config — type-only; the\n// adapter and registry are construction internals behind createSdk.\nexport type {\n  InferenceConfig,\n  ModelAssignment,\n  ModelCall,\n  ModelCallFailureKind,\n  ModelCallInput,\n  ModelCallResult,\n} from \"./inference/types.js\";\nexport type { ProviderProvenance } from \"./shared/derivation.js\";\n\n// The config-selectable prompt-name catalog (E05-NB-2): the full set of names\n// a per-kind assignment may select, and the default name per kind. Exposed so\n// operators discover valid prompt names from the SDK surface without reading\n// source. The registry itself stays a construction internal behind createSdk.\nexport {\n  DEFAULT_PROMPT_NAMES,\n  PROMPT_NAMES,\n} from \"./inference/prompts/index.js\";\n\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n// from Story 0; the operation shapes land with Stories 1–5.\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n} from \"./domains/thread-view/index.js\";\nexport type {\n  Band,\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SdkViewConfig,\n  StoredView,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewMeta,\n  ViewProfile,\n  ViewProfileOverride,\n  ViewStatus,\n  VisibilityBudgets,\n} from \"./shared/view.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\n// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n// inspect surface serves.\nexport type {\n  HealthReport,\n  InspectOverview,\n  ViewContentsReport,\n} from \"./shared/inspect.js\";\n\nexport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageDetail,\n  MessageListOptions,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\n// §Interface Definitions): the operations only — the Story 0 config\n// substrate the domain index also carries is construction machinery, not an\n// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n// inspect domain composes (DD-1).\nexport interface ThreadViewSurface {\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n  compact(\n    ref: threadsDomain.ThreadRef,\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n  ): Promise<OpResult<CompactReceipt>>;\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n  materialize(\n    ref: threadsDomain.ThreadRef,\n    opts: { path: string; format?: \"pi-session\" },\n  ): Promise<OpResult<{ writtenPath: string }>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  threadView: ThreadViewSurface;\n  // Epic 04: the read-only report surface. Scoped through the instance seam\n  // like every other namespace so the status read it composes resolves THIS\n  // SDK's view config (threshold, visibility budgets).\n  inspect: typeof inspectDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n// object is the same shape as the namespace, so the public surface type holds.\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n  const scoped: Record<string, unknown> = {};\n  for (const key of Object.keys(surface)) {\n    const value = (surface as Record<string, unknown>)[key];\n    scoped[key] =\n      typeof value === \"function\"\n        ? (...args: unknown[]): unknown =>\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n        : value;\n  }\n  return scoped as T;\n}\n\n// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n// the host function and the complete assignment map loudly — all seven kinds\n// present (iterating the exported FORM_KINDS set, never a second literal\n// list), no unknown kind keys, every prompt name in the registry, non-empty\n// provider/model routing keys — then build the adapter into the same\n// DerivationProvider slot direct injection uses. No partial construction:\n// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\nfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n  if (typeof inference.call !== \"function\") {\n    throw new TypeError(\"createSdk config: inference.call must be a function\");\n  }\n  const assignments = inference.assignments as unknown;\n  if (assignments === null || typeof assignments !== \"object\") {\n    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n  }\n  const knownKinds = new Set<string>(FORM_KINDS);\n  for (const key of Object.keys(assignments)) {\n    if (!knownKinds.has(key)) {\n      throw new TypeError(\n        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n      );\n    }\n  }\n  const map = assignments as Partial<Record<FormKind, ModelAssignment>>;\n  for (const kind of FORM_KINDS) {\n    const assignment = map[kind];\n    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n    }\n    for (const field of [\"provider\", \"model\"] as const) {\n      const value = assignment[field];\n      if (typeof value !== \"string\" || value.trim() === \"\") {\n        throw new TypeError(\n          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n        );\n      }\n    }\n    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n      throw new TypeError(\n        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n      );\n    }\n  }\n  const timeoutMs = inference.timeoutMs ?? 60_000;\n  const maxInputChars = inference.maxInputChars ?? 200_000;\n  requirePositive(timeoutMs, \"inference.timeoutMs\");\n  requirePositive(maxInputChars, \"inference.maxInputChars\");\n  return createInferenceProvider({\n    call: inference.call,\n    assignments: map as Record<FormKind, ModelAssignment>,\n    timeoutMs,\n    maxInputChars,\n  });\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  // Provider arrival is exactly one of direct injection or the inference\n  // config (Epic 05 DD-5); there is no named-provider registry and no\n  // env/flag resolution path to fall back on. The XOR rule is validated\n  // before anything downstream so the error names the caller's mistake, not\n  // a symptom (AC-1.1).\n  if (config.provider !== undefined && config.inference !== undefined) {\n    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n  }\n  if (config.provider === undefined && config.inference === undefined) {\n    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n  }\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  let provider: DerivationProvider;\n  if (config.inference !== undefined) {\n    provider = resolveInferenceProvider(config.inference);\n  } else {\n    if (config.provider === null || typeof config.provider !== \"object\") {\n      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n    }\n    for (const operation of PROVIDER_OPERATIONS) {\n      if (typeof config.provider[operation] !== \"function\") {\n        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n      }\n    }\n    provider = config.provider;\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n  // background mode, or a no-op in manual mode — isolated from any other SDK\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\n  // the construction order, because its operations deliver to the no-op seam,\n  // not to whatever a background SDK installed below.\n  // The seam also carries this instance's resolved view config (Epic 03,\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n  // fall back to the built-in defaults inside the thread-view surface.\n  const seam: InstanceSeam =\n    resolved.mode === \"background\"\n      ? {\n          poke: (threadId) => scheduler.poke(threadId),\n          touch: (filePath, db) => scheduler.touch(filePath, db),\n          view: resolved.view,\n        }\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\n\n  // Background mode also installs the below-SDK default seam so a direct\n  // domain call made with no SDK scope — a top-level mutation in the\n  // single-background \"production path\" — still reaches the one installed\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n  // leaves the default alone (pokes stay no-ops by contract).\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: (ref, opts) =>\n      runWithInstanceSeam(seam, async () => {\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n        if (!resolvedRef.ok) return resolvedRef;\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n      }),\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\n    messages: scopeSurface(messagesDomain, seam),\n    turns: scopeSurface(turnsDomain, seam),\n    threadView: scopeSurface<ThreadViewSurface>(\n      {\n        pull: threadViewDomain.pull,\n        status: threadViewDomain.status,\n        describe: threadViewDomain.describe,\n        compact: threadViewDomain.compact,\n        sweep: threadViewDomain.sweep,\n        materialize: threadViewDomain.materialize,\n      },\n      seam,\n    ),\n    inspect: scopeSurface(inspectDomain, seam),\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":517,"startLine":1,"totalLines":517}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_121e5c6ed5e5410296db8330","type":"tool_result","content":"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"64ff6578-9ca4-44a7-a10a-359347574abf","timestamp":"2026-06-14T12:30:58.649Z","tool_use_result":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts","oldString":"  // Check for invalid request (terminal)\n  const invalidPatterns = [\"invalid\", \"400\", \"bad_request\"];\n  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"invalid_request\";\n  }","newString":"  // Check for invalid request (terminal)\n  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"invalid_request\";\n  }","originalFile":"// AC-4.1..4.4. The host-supplied ModelCall function.\n//\n// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n// pi-ai's complete(), and classifies failures into the LHC contract.\n// Provider/model are opaque routing keys — the connector does not interpret them.\n//\n// NOTE: The real pi-ai package is not yet a build dependency. This implementation\n// uses a local placeholder that simulates the pi-ai complete() contract. The\n// production swap is mechanical when the dependency lands (Spec Deviation).\n\nimport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\nimport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\nimport type { CompleteContext, PiAiComplete, PiAiError } from \"./pi-ai.js\";\n\n/** Extract the text content from an AssistantMessage. */\nfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n  const content = message.content ?? [];\n  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n  return textParts.map((part) => part.text as string).join(\"\\n\");\n}\n\n/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n *  thrown → other). */\nexport function classifyFailure(err: unknown): ModelCallFailureKind {\n  // Guard: non-object errors fall through to \"other\"\n  if (typeof err !== \"object\" || err === null) {\n    return \"other\";\n  }\n\n  const errorLike = err as Partial<PiAiError & Error>;\n  const code = errorLike.code?.toLowerCase() ?? \"\";\n  const type = errorLike.type?.toLowerCase() ?? \"\";\n  const message = errorLike.message?.toLowerCase() ?? \"\";\n\n  // Check for auth failures (terminal)\n  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"auth\";\n  }\n\n  // Check for invalid request (terminal)\n  const invalidPatterns = [\"invalid\", \"400\", \"bad_request\"];\n  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"invalid_request\";\n  }\n\n  // Check for rate limit (retryable)\n  const rateLimitPatterns = [\"rate\", \"429\"];\n  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"rate_limit\";\n  }\n\n  // Check for timeout (retryable)\n  const timeoutPatterns = [\"timeout\", \"timed_out\", \"408\"];\n  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"timeout\";\n  }\n\n  // Check for network errors (retryable)\n  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"network\";\n  }\n\n  // Default for unknown errors\n  return \"other\";\n}\n\n/** Simulated pi-ai complete() for when the real package is not available.\n *  This will be replaced with the real import when the dependency lands. */\nfunction mockComplete(model: string, context: CompleteContext): Promise<{ content?: Array<{ type: string; text?: string }> }> {\n  // In production, this would be:\n  // import { complete } from \"@earendil-works/pi-ai\";\n  // return complete(model, context);\n  //\n  // For now, return a placeholder that simulates the response shape.\n  // The real implementation swaps in the actual import mechanically.\n  return Promise.resolve({\n    content: [{ type: \"text\", text: \"(pi-ai not yet integrated - placeholder response)\" }],\n  });\n}\n\n/** Build the host ModelCall function.\n *\n * The function:\n * - Resolves (provider, model) via ctx.modelRegistry.find()\n * - Completes via pi-ai's complete()\n * - Classifies failures into ModelCallFailureKind\n * - Never returns \"empty_output\" (that's LHC's adapter's job)\n *\n * AC-4.1: Resolves provider/model and returns completion text.\n * AC-4.2: Different derivation kinds route to different pairs.\n * AC-4.3: Provider errors map to LHC failure classifications.\n * AC-4.4: Host function never returns empty_output.\n */\nexport function createModelCall(ctx: ExtensionContext): ModelCall {\n  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n    // Resolve the model through PI's registry\n    const resolved = ctx.modelRegistry.find(provider, model);\n    if (resolved === undefined) {\n      // Unknown model - treat as invalid request (terminal)\n      return {\n        ok: false,\n        kind: \"invalid_request\",\n        message: `Model not found in registry: ${provider}/${model}`,\n      };\n    }\n\n    // Check if auth is configured\n    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n      // No auth - treat as auth failure (terminal)\n      return {\n        ok: false,\n        kind: \"auth\",\n        message: `No configured auth for model: ${provider}/${model}`,\n      };\n    }\n\n    // Complete through pi-ai\n    try {\n      const completeContext: CompleteContext = { messages };\n      const response = await mockComplete(model, completeContext);\n\n      // Extract text from the response\n      const text = extractAssistantText(response);\n\n      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n      // empty_output is classified by LHC's adapter, not by the host function.\n      // The host function returns text-or-failure only, even if the text is empty.\n      return { ok: true, text };\n    } catch (err) {\n      // Classify the error into a ModelCallFailureKind\n      const kind = classifyFailure(err);\n      const message = err instanceof Error ? err.message : String(err);\n      return { ok: false, kind, message };\n    }\n  };\n}\n","structuredPatch":[{"oldStart":40,"oldLines":7,"newStart":40,"newLines":7,"lines":["   }"," ","   // Check for invalid request (terminal)","-  const invalidPatterns = [\"invalid\", \"400\", \"bad_request\"];","+  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];","   if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {","     return \"invalid_request\";","   }"]}],"userModified":false,"replaceAll":false}}

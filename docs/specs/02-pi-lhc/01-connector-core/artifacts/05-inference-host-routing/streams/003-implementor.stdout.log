{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7bac1fb63f6c42ab8c702ca6","type":"tool_result","content":"1\t// TC-4.1..4.4. Model call function tests.\n2\t//\n3\t// TC-4.1: Function resolves (provider,model) via registry, returns text.\n4\t// TC-4.2: Two kinds → different (provider,model) both route in one session.\n5\t// TC-4.3: Failure shapes map to exact kinds (adapter-boundary risk test).\n6\t// TC-4.4: Resolved-but-no-output → empty_output by adapter (not host fn).\n7\t//\n8\t// These tests use synthetic PI contexts (mock-free at the boundary) and assert\n9\t// on the ModelCallResult shapes, exercising classification and routing without\n10\t// a live provider.\n11\timport { describe, expect, it, vi } from \"vitest\";\n12\timport type { ModelCallFailureKind, ModelCallInput } from \"lhc\";\n13\timport { classifyFailure, createModelCall } from \"../../src/inference/model-call.js\";\n14\timport type { ExtensionContext, ModelHandle } from \"../../src/pi/types.js\";\n15\t\n16\tconst INPUT: ModelCallInput = {\n17\t  provider: \"openai\",\n18\t  model: \"gpt-4o-mini\",\n19\t  messages: [{ role: \"user\", content: \"hi\" }],\n20\t};\n21\t\n22\tdescribe(\"Story 5: Inference Host Routing\", () => {\n23\t  describe(\"TC-4.1: ModelCall resolves provider/model and returns text\", () => {\n24\t    it(\"resolves a known model with configured auth and returns completion text\", async () => {\n25\t      const mockHandle: ModelHandle = { provider: \"openai\", id: \"gpt-4o-mini\" };\n26\t      const ctx: ExtensionContext = {\n27\t        cwd: \"/test\",\n28\t        hasUI: false,\n29\t        modelRegistry: {\n30\t          find: () => mockHandle,\n31\t          hasConfiguredAuth: () => true,\n32\t          getAvailable: () => [mockHandle],\n33\t        },\n34\t        ui: { notify: () => {} },\n35\t        sessionManager: { getEntries: () => [] },\n36\t      };\n37\t\n38\t      const modelCall = createModelCall(ctx);\n39\t      const result = await modelCall(INPUT);\n40\t\n41\t      expect(result.ok).toBe(true);\n42\t      if (result.ok) {\n43\t        expect(result.text).toBeTruthy();\n44\t        expect(typeof result.text).toBe(\"string\");\n45\t      }\n46\t    });\n47\t  });\n48\t\n49\t  describe(\"TC-4.2: Multi-lane routing — different kinds route to different pairs\", () => {\n50\t    it(\"routes each call by its provider/model keys independently\", async () => {\n51\t      const handles: ModelHandle[] = [\n52\t        { provider: \"openai\", id: \"gpt-4o-mini\" },\n53\t        { provider: \"anthropic\", id: \"claude-3-opus\" },\n54\t        { provider: \"openai\", id: \"gpt-4o\" },\n55\t      ];\n56\t\n57\t      const findMock = vi.fn<[string, string], ModelHandle | undefined>(\n58\t        (provider, model) => handles.find((h) => h.provider === provider && h.id === model),\n59\t      );\n60\t\n61\t      const ctx: ExtensionContext = {\n62\t        cwd: \"/test\",\n63\t        hasUI: false,\n64\t        modelRegistry: {\n65\t          find: findMock,\n66\t          hasConfiguredAuth: () => true,\n67\t          getAvailable: () => handles,\n68\t        },\n69\t        ui: { notify: () => {} },\n70\t        sessionManager: { getEntries: () => [] },"}]},"parent_tool_use_id":null,"session_id":"7894f3ec-841a-4c17-b9cf-403440004aac","uuid":"10067272-d06c-429c-a8f7-1795947a7585","timestamp":"2026-06-14T12:33:51.243Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/model-call.test.ts","content":"// TC-4.1..4.4. Model call function tests.\n//\n// TC-4.1: Function resolves (provider,model) via registry, returns text.\n// TC-4.2: Two kinds → different (provider,model) both route in one session.\n// TC-4.3: Failure shapes map to exact kinds (adapter-boundary risk test).\n// TC-4.4: Resolved-but-no-output → empty_output by adapter (not host fn).\n//\n// These tests use synthetic PI contexts (mock-free at the boundary) and assert\n// on the ModelCallResult shapes, exercising classification and routing without\n// a live provider.\nimport { describe, expect, it, vi } from \"vitest\";\nimport type { ModelCallFailureKind, ModelCallInput } from \"lhc\";\nimport { classifyFailure, createModelCall } from \"../../src/inference/model-call.js\";\nimport type { ExtensionContext, ModelHandle } from \"../../src/pi/types.js\";\n\nconst INPUT: ModelCallInput = {\n  provider: \"openai\",\n  model: \"gpt-4o-mini\",\n  messages: [{ role: \"user\", content: \"hi\" }],\n};\n\ndescribe(\"Story 5: Inference Host Routing\", () => {\n  describe(\"TC-4.1: ModelCall resolves provider/model and returns text\", () => {\n    it(\"resolves a known model with configured auth and returns completion text\", async () => {\n      const mockHandle: ModelHandle = { provider: \"openai\", id: \"gpt-4o-mini\" };\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: () => mockHandle,\n          hasConfiguredAuth: () => true,\n          getAvailable: () => [mockHandle],\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },\n      };\n\n      const modelCall = createModelCall(ctx);\n      const result = await modelCall(INPUT);\n\n      expect(result.ok).toBe(true);\n      if (result.ok) {\n        expect(result.text).toBeTruthy();\n        expect(typeof result.text).toBe(\"string\");\n      }\n    });\n  });\n\n  describe(\"TC-4.2: Multi-lane routing — different kinds route to different pairs\", () => {\n    it(\"routes each call by its provider/model keys independently\", async () => {\n      const handles: ModelHandle[] = [\n        { provider: \"openai\", id: \"gpt-4o-mini\" },\n        { provider: \"anthropic\", id: \"claude-3-opus\" },\n        { provider: \"openai\", id: \"gpt-4o\" },\n      ];\n\n      const findMock = vi.fn<[string, string], ModelHandle | undefined>(\n        (provider, model) => handles.find((h) => h.provider === provider && h.id === model),\n      );\n\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: findMock,\n          hasConfiguredAuth: () => true,\n          getAvailable: () => handles,\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },","numLines":70,"startLine":1,"totalLines":254}}}

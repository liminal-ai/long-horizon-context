ead.test.ts\npackages/pi-lhc/test/fixtures/thread.ts\npackages/pi-lhc/test/inference/assignments.test.ts\npackages/pi-lhc/test/inference/closed-loop.test.ts\npackages/pi-lhc/test/inference/model-call.test.ts\npackages/pi-lhc/test/inference/startup-validation.test.ts\npackages/pi-lhc/test/lifecycle/fork.test.ts\npackages/pi-lhc/test/lifecycle/instance.test.ts\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts\npackages/pi-lhc/test/red-manifest.json\npackages/pi-lhc/test/smoke/extension-load.test.ts\npackages/pi-lhc/test/smoke/verification-config.test.ts\npackages/pi-lhc/test/verify/replay.test.ts\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/lifecycle/thread-resolution.test.ts | sed -n '373,430p'\"","aggregated_output":"   373\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n   374\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n   375\t    const cwd = \"/work/reload\";\n   376\t\n   377\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n   378\t    const connectorA = productionConnector(() => ({}));\n   379\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   380\t    const stateA = connectorA.getState();\n   381\t    expect(stateA).not.toBeNull();\n   382\t    if (stateA === null) return;\n   383\t    const firstId = idOf(stateA.threadRef);\n   384\t    const countAfterNew = await threadCount();\n   385\t\n   386\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n   387\t    expect(row.ok).toBe(true);\n   388\t    if (row.ok) {\n   389\t      expect(row.value.cwd).toBe(cwd);\n   390\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n   391\t    }\n   392\t\n   393\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n   394\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n   395\t    // closure and a still-no-flag launch (which would otherwise create a\n   396\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n   397\t    // thing bridging the teardown is the durable registry — this is what proves\n   398\t    // reconstruction survives loss of every in-memory holder (SV-001).\n   399\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   400\t\n   401\t    const connectorB = productionConnector(() => ({}));\n   402\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   403\t\n   404\t    const stateB = connectorB.getState();\n   405\t    expect(stateB).not.toBeNull();\n   406\t    if (stateB === null) return;\n   407\t    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n   408\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n   409\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n   410\t  });\n   411\t\n   412\t  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n   413\t    const cwd = \"/work/reload-session\";\n   414\t    const existing = await makeThread({ cwd, title: \"carried\" });\n   415\t    const before = await threadCount();\n   416\t\n   417\t    // Launched with --session <id>: reload re-resolves the SAME id from the\n   418\t    // durable registry, independent of any in-memory state.\n   419\t    const connectorA = productionConnector(() => ({ session: existing }));\n   420\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"startup\"));\n   421\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   422\t\n   423\t    const connectorB = productionConnector(() => ({ session: existing }));\n   424\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   425\t    expect(idOf(connectorB.getState()!.threadRef)).toBe(existing);\n   426\t    expect(await threadCount()).toBe(before); // no thread created on reload\n   427\t  });\n   428\t\n   429\t  it(\"a no-flag 'new' session always creates a new thread — reattach is reload-only, keyed on the start reason, not on retained memory\", async () => {\n   430\t    const cwd = \"/work/fresh\";\n","exit_code":0,"status":"completed"}}

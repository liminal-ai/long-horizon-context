{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/lifecycle/thread-resolution.test.ts | sed -n '320,385p;285,320p'\"","aggregated_output":"   285\t    const olderRow = await threads.resolve({ threadId: older, registryPath: store.registryPath });\n   286\t    const newerRow = await threads.resolve({ threadId: newer, registryPath: store.registryPath });\n   287\t    if (olderRow.ok) expect(selectOptions.some((option) => option.includes(olderRow.value.createdAt))).toBe(true);\n   288\t    if (newerRow.ok) expect(selectOptions.some((option) => option.includes(newerRow.value.createdAt))).toBe(true);\n   289\t\n   290\t    const state = connector.getState();\n   291\t    expect(state).not.toBeNull();\n   292\t    if (state === null) return;\n   293\t    expect(idOf(state.threadRef)).toBe(newer);\n   294\t    expect(connector.getInstance()).not.toBeNull();\n   295\t    expect(await threadCount()).toBe(before);\n   296\t  });\n   297\t\n   298\t  it(\"TC-1.7: production --resume fails closed when a UI selection is cancelled\", async () => {\n   299\t    await makeThread({ cwd: \"/work/resume-cancel\", title: \"older\" });\n   300\t    await makeThread({ cwd: \"/work/resume-cancel\", title: \"newer\" });\n   301\t    const before = await threadCount();\n   302\t\n   303\t    const ctx: ExtensionContext = {\n   304\t      cwd: \"/work/resume-cancel\",\n   305\t      hasUI: true,\n   306\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n   307\t      ui: { notify: () => {}, select: () => Promise.resolve(undefined) },\n   308\t      sessionManager: { getEntries: () => [] },\n   309\t    };\n   310\t\n   311\t    const connector = productionConnector(() => ({ resume: true }));\n   312\t    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n   313\t\n   314\t    expect(connector.getState()).toBeNull();\n   315\t    expect(connector.getInstance()).toBeNull();\n   316\t    expect(await threadCount()).toBe(before);\n   317\t  });\n   318\t\n   319\t  it(\"TC-1.7: headless --resume with multiple candidates fails closed and requires --session\", async () => {\n   320\t    await makeThread({ cwd: \"/work/headless-many\", title: \"older\" });\n   320\t    await makeThread({ cwd: \"/work/headless-many\", title: \"older\" });\n   321\t    await makeThread({ cwd: \"/work/headless-many\", title: \"newer\" });\n   322\t    const before = await threadCount();\n   323\t\n   324\t    const connector = productionConnector(() => ({ resume: true }));\n   325\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless-many\"), makeSessionStart(\"resume\"));\n   326\t\n   327\t    expect(connector.getState()).toBeNull();\n   328\t    expect(connector.getInstance()).toBeNull();\n   329\t    expect(await threadCount()).toBe(before);\n   330\t  });\n   331\t\n   332\t  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n   333\t    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n   334\t    const before = await threadCount();\n   335\t\n   336\t    const connector = productionConnector(() => ({ resume: true }));\n   337\t    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n   338\t    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n   339\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n   340\t\n   341\t    const state = connector.getState();\n   342\t    expect(state).not.toBeNull();\n   343\t    if (state === null) return;\n   344\t    expect(connector.getInstance()).not.toBeNull();\n   345\t    expect(await threadCount()).toBe(before); // resolved without failing\n   346\t  });\n   347\t});\n   348\t\n   349\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n   350\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n   351\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n   352\t\n   353\t    // session_start with a ctx carrying methods.\n   354\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n   355\t    expect(connector.getState()).not.toBeNull();\n   356\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n   357\t    // ...but the snapshot is plain data only — it survives structuredClone even\n   358\t    // though the live ctx and instance carry methods (they are not in it).\n   359\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   360\t    const threadRefBefore = connector.getState()?.threadRef;\n   361\t\n   362\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n   363\t    // holder still references no prior ctx.\n   364\t    await connector.handlers.message_end(\n   365\t      syntheticCtx(\"/work/a\"),\n   366\t      makeMessageEnd(makeUserMessage(\"hi\")),\n   367\t    );\n   368\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   369\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n   370\t  });\n   371\t});\n   372\t\n   373\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n   374\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n   375\t    const cwd = \"/work/reload\";\n   376\t\n   377\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n   378\t    const connectorA = productionConnector(() => ({}));\n   379\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   380\t    const stateA = connectorA.getState();\n   381\t    expect(stateA).not.toBeNull();\n   382\t    if (stateA === null) return;\n   383\t    const firstId = idOf(stateA.threadRef);\n   384\t    const countAfterNew = await threadCount();\n   385\t\n","exit_code":0,"status":"completed"}}

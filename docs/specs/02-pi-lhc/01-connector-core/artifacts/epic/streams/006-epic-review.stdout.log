{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/fixtures/corpus.ts | sed -n '1,40p;120,150p'\"","aggregated_output":"     1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n     2\t// named recorded PI lifecycle fixture paired with the LHC intake events it\n     3\t// should produce. The validator PARSES and CHECKS shapes — it never hardcodes a\n     4\t// passing count (story §Anti-Shim Requirements).\n     5\timport { readFileSync } from \"node:fs\";\n     6\timport { fileURLToPath } from \"node:url\";\n     7\timport type { EventKind } from \"lhc\";\n     8\timport type { Corpus } from \"../../src/verify/replay.js\";\n     9\timport { ABORTED_DISPOSITION_TEXT } from \"../../src/capture/map-message.js\";\n    10\timport type { AgentMessage } from \"../../src/pi/types.js\";\n    11\timport { validEvent } from \"./synthetic.js\";\n    12\t\n    13\tconst CALL_A = \"call_a|fc_1\";\n    14\tconst CALL_B = \"call_b|fc_2\";\n    15\tconst CORPUS_DIR = fileURLToPath(new URL(\"./pi-corpora/\", import.meta.url));\n    16\t\n    17\tfunction loadRecordedSource(name: string): AgentMessage[] {\n    18\t  const path = `${CORPUS_DIR}${name}.jsonl`;\n    19\t  return readFileSync(path, \"utf8\")\n    20\t    .trim()\n    21\t    .split(\"\\n\")\n    22\t    .filter((line) => line.trim() !== \"\")\n    23\t    .map((line) => JSON.parse(line) as AgentMessage);\n    24\t}\n    25\t\n    26\t/** Plain user/assistant text exchanges, no tools. */\n    27\texport function loadChattyCorpus(): Corpus {\n    28\t  return {\n    29\t    name: \"chatty\",\n    30\t    source: loadRecordedSource(\"chatty\"),\n    31\t    expected: [\n    32\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n    33\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n    34\t      validEvent(\"turn_end\"),\n    35\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n    36\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n    37\t      validEvent(\"turn_end\"),\n    38\t    ],\n    39\t  };\n    40\t}\n   120\t\n   121\texport function loadAllCorpora(): Corpus[] {\n   122\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n   123\t}\n   124\t\n   125\t/** A deliberately malformed sequence for the capture-failure test: an empty\n   126\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n   127\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n   128\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n   129\texport function makeTruncatedCorpus(): Corpus {\n   130\t  return {\n   131\t    name: \"truncated\",\n   132\t    source: [{ role: \"user\", content: [{ type: \"text\", text: \"\" }] }],\n   133\t    expected: [\n   134\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n   135\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n   136\t    ],\n   137\t  };\n   138\t}\n   139\t\n   140\texport interface CorpusValidation {\n   141\t  valid: boolean;\n   142\t  problems: string[];\n   143\t}\n   144\t\n   145\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n   146\t  \"user_prompt\",\n   147\t  \"assistant_text\",\n   148\t  \"assistant_thinking\",\n   149\t  \"runtime_note\",\n   150\t  \"tool_call\",\n","exit_code":0,"status":"completed"}}

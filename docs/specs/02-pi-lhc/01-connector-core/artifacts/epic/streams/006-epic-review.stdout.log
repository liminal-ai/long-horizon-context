{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f3a48fa1d4844ab78333a1f9","type":"tool_result","content":"1\t// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n2\t// never writes the source (tech design Flow 3). Story 4.\n3\t\n4\timport { readFileSync } from \"node:fs\";\n5\timport type { MessageEventInput, OpResult, ThreadRef } from \"lhc\";\n6\timport type { ExtensionContext, SessionStartEvent } from \"../pi/types.js\";\n7\timport type { LhcInstance } from \"../shared/instance.js\";\n8\t\n9\texport interface ForkInfo {\n10\t  sourceThreadRef: ThreadRef;\n11\t  forkEntryId: string;\n12\t}\n13\t\n14\t/** Detect a fork from PI's session tree when the session_before_fork hook is\n15\t *  absent (Epic 1 fallback evidence). This function is called during\n16\t *  session_start when we have a previousSessionFile but no pending fork from the\n17\t *  hook. Returns fork info if the session tree indicates a fork, null otherwise.\n18\t *\n19\t * The fallback uses the previousSessionFile as evidence that we're starting a\n20\t *  new session after an existing one (the fork pattern). The fork point is\n21\t *  inferred as the end of the previous session. */\n22\texport function detectForkFromSessionTree(\n23\t  ctx: ExtensionContext,\n24\t  event: SessionStartEvent,\n25\t  sourceThreadRef: ThreadRef,\n26\t): ForkInfo | null {\n27\t  if (!event.previousSessionFile) return null;\n28\t\n29\t  const previousEntries = readSessionEntries(event.previousSessionFile);\n30\t  const previousIds = new Set(previousEntries.map(entryIdOf).filter((id): id is string => id !== null));\n31\t  if (previousIds.size === 0) return null;\n32\t\n33\t  const currentEntries = ctx.sessionManager.getEntries();\n34\t  const sharedCurrentEntry = lastEntryMatching(currentEntries, (entry) => {\n35\t    const id = entryIdOf(entry);\n36\t    return id !== null && previousIds.has(id);\n37\t  });\n38\t  if (sharedCurrentEntry !== null) {\n39\t    return { sourceThreadRef, forkEntryId: sharedCurrentEntry };\n40\t  }\n41\t\n42\t  const parentLink = firstEntryMatching(currentEntries, (entry) => {\n43\t    const parentId = stringField(entry, \"parentId\");\n44\t    return parentId !== null && previousIds.has(parentId);\n45\t  });\n46\t  if (parentLink !== null) {\n47\t    return { sourceThreadRef, forkEntryId: parentLink };\n48\t  }\n49\t\n50\t  return null;\n51\t}\n52\t\n53\tfunction stringField(record: { readonly [k: string]: unknown }, field: string): string | null {\n54\t  const value = record[field];\n55\t  return typeof value === \"string\" && value !== \"\" ? value : null;\n56\t}\n57\t\n58\tfunction entryIdOf(entry: { readonly [k: string]: unknown }): string | null {\n59\t  return stringField(entry, \"id\") ?? stringField(entry, \"entryId\");\n60\t}\n61\t\n62\tfunction lastEntryMatching(\n63\t  entries: readonly { readonly [k: string]: unknown }[],\n64\t  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n65\t): string | null {\n66\t  for (let index = entries.length - 1; index >= 0; index -= 1) {\n67\t    const entry = entries[index];\n68\t    if (entry === undefined || !matches(entry)) continue;\n69\t    return entryIdOf(entry);\n70\t  }\n71\t  return null;\n72\t}\n73\t\n74\tfunction firstEntryMatching(\n75\t  entries: readonly { readonly [k: string]: unknown }[],\n76\t  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n77\t): string | null {\n78\t  for (const entry of entries) {\n79\t    if (!matches(entry)) continue;\n80\t    const parentId = stringField(entry, \"parentId\");\n81\t    if (parentId !== null) return parentId;\n82\t  }\n83\t  return null;\n84\t}\n85\t\n86\tfunction readSessionEntries(filePath: string): { readonly [k: string]: unknown }[] {\n87\t  let contents: string;\n88\t  try {\n89\t    contents = readFileSync(filePath, \"utf8\");\n90\t  } catch {\n91\t    return [];\n92\t  }\n93\t\n94\t  const entries: { readonly [k: string]: unknown }[] = [];\n95\t  for (const line of contents.trim().split(\"\\n\")) {\n96\t    if (line.trim() === \"\") continue;\n97\t    try {\n98\t      const parsed = JSON.parse(line) as unknown;\n99\t      if (typeof parsed !== \"object\" || parsed === null) continue;\n100\t      const entry = parsed as { readonly [k: string]: unknown };\n101\t      if (entry.type === \"session\") continue;\n102\t      entries.push(entry);\n103\t    } catch {\n104\t      continue;\n105\t    }\n106\t  }\n107\t  return entries;\n108\t}\n109\t\n110\t/** Extract fork info from a `session_before_fork` hook payload. The hook\n111\t *  provides `entryId` and optional `position` identifying the fork point. */\n112\texport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n113\t  return { forkEntryId: entryId };\n114\t}\n115\t\n116\t/** Seed a forked thread by replaying the source's recorded events up to the\n117\t *  fork point, through the normal intake path. The source receives NO writes\n118\t *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n119\t *\n120\t * Replay reads events from the source thread, filters to those up to and\n121\t * including the fork point (by entryId match on idempotency key), and writes\n122\t * them through the instance's intake path. This preserves event order, dedup\n123\t * keys, and all logical content — the seeded thread's read-back matches the\n124\t * source's read-back through the fork point (AC-3.2).\n125\t *\n126\t * The forkEntryId is PI's entry identifier for the session entry at the fork\n127\t * point. During capture, this entryId was encoded into idempotency keys as\n128\t * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n129\t * contain this entryId in their key (any piSessionId, any block/kind), then\n130\t * include all events up to and including the turn_end that closes the turn at\n131\t * the fork point. */\n132\texport async function seedFork(\n133\t  source: ThreadRef,\n134\t  target: ThreadRef,\n135\t  forkEntryId: string,\n136\t  instance: LhcInstance,\n137\t): Promise<OpResult<void>> {\n138\t  const { intakeStream } = instance.sdk;\n139\t\n140\t  // Read all events from the source thread.\n141\t  const events = await intakeStream.listEvents(source);\n142\t  if (!events.ok) {\n143\t    return {\n144\t      ok: false,\n145\t      error: {\n146\t        errorClass: events.error.errorClass,\n147\t        code: events.error.code,\n148\t        reason: `fork source read failed: ${events.error.reason}`,\n149\t      },\n150\t    };\n151\t  }\n152\t\n153\t  // Find the fork point event(s) by entryId match. The entryId appears in the\n154\t  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n155\t  // key contains `:${forkEntryId}:` regardless of piSessionId.\n156\t  const forkPointEvents = events.value.filter((event) =>\n157\t    event.idempotencyKey.includes(`:${forkEntryId}:`),\n158\t  );\n159\t\n160\t  if (forkPointEvents.length === 0) {\n161\t    return {\n162\t      ok: false,\n163\t      error: {\n164\t        errorClass: \"caller_error\",\n165\t        code: \"thread_not_found\",\n166\t        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n167\t      },\n168\t    };\n169\t  }\n170\t\n171\t  // Use the maximum eventOrder among fork point events as the initial cutoff.\n172\t  // This ensures we include all events (including fan-out) at the fork point.\n173\t  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n174\t\n175\t  // Include the turn_end that closes the turn at the fork point.\n176\t  // turn_end events don't have entryId in their key (they're generated by\n177\t  // the connector), so we need to include the first turn_end after maxOrder.\n178\t  const turnEndAfter = events.value.find(\n179\t    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n180\t  );\n181\t  if (turnEndAfter !== undefined) {\n182\t    maxOrder = turnEndAfter.eventOrder;\n183\t  }\n184\t\n185\t  // Filter to events up to and including the fork point (including turn_end).\n186\t  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n187\t\n188\t  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n189\t  // Each event preserves its discriminated eventKind by construction from the\n190\t  // recorded EventRecord, which carries the exact eventKind that was written.\n191\t  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n192\t    (record) =>\n193\t      ({\n194\t        eventKind: record.eventKind,\n195\t        idempotencyKey: record.idempotencyKey,\n196\t        actor: record.actor,\n197\t        harness: record.harness,\n198\t        payload: record.payload,\n199\t      }) as MessageEventInput,\n200\t  );\n201\t\n202\t  // Replay through the normal intake path into the target thread.\n203\t  // This uses the same capture converter path, preserving all semantics.\n204\t  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n205\t  if (!result.ok) {\n206\t    return {\n207\t      ok: false,\n208\t      error: {\n209\t        errorClass: result.error.errorClass,\n210\t        code: result.error.code,\n211\t        reason: `fork replay failed: ${result.error.reason}`,\n212\t      },\n213\t    };\n214\t  }\n215\t\n216\t  return { ok: true, value: undefined };\n217\t}\n218\t"}]},"parent_tool_use_id":null,"session_id":"a08bfa87-d15f-49ef-98e9-3889acacbbb4","uuid":"20885c98-fd9e-4683-af18-73210d3a4bd8","timestamp":"2026-06-14T20:42:54.773Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/fork.ts","content":"// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n// never writes the source (tech design Flow 3). Story 4.\n\nimport { readFileSync } from \"node:fs\";\nimport type { MessageEventInput, OpResult, ThreadRef } from \"lhc\";\nimport type { ExtensionContext, SessionStartEvent } from \"../pi/types.js\";\nimport type { LhcInstance } from \"../shared/instance.js\";\n\nexport interface ForkInfo {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** Detect a fork from PI's session tree when the session_before_fork hook is\n *  absent (Epic 1 fallback evidence). This function is called during\n *  session_start when we have a previousSessionFile but no pending fork from the\n *  hook. Returns fork info if the session tree indicates a fork, null otherwise.\n *\n * The fallback uses the previousSessionFile as evidence that we're starting a\n *  new session after an existing one (the fork pattern). The fork point is\n *  inferred as the end of the previous session. */\nexport function detectForkFromSessionTree(\n  ctx: ExtensionContext,\n  event: SessionStartEvent,\n  sourceThreadRef: ThreadRef,\n): ForkInfo | null {\n  if (!event.previousSessionFile) return null;\n\n  const previousEntries = readSessionEntries(event.previousSessionFile);\n  const previousIds = new Set(previousEntries.map(entryIdOf).filter((id): id is string => id !== null));\n  if (previousIds.size === 0) return null;\n\n  const currentEntries = ctx.sessionManager.getEntries();\n  const sharedCurrentEntry = lastEntryMatching(currentEntries, (entry) => {\n    const id = entryIdOf(entry);\n    return id !== null && previousIds.has(id);\n  });\n  if (sharedCurrentEntry !== null) {\n    return { sourceThreadRef, forkEntryId: sharedCurrentEntry };\n  }\n\n  const parentLink = firstEntryMatching(currentEntries, (entry) => {\n    const parentId = stringField(entry, \"parentId\");\n    return parentId !== null && previousIds.has(parentId);\n  });\n  if (parentLink !== null) {\n    return { sourceThreadRef, forkEntryId: parentLink };\n  }\n\n  return null;\n}\n\nfunction stringField(record: { readonly [k: string]: unknown }, field: string): string | null {\n  const value = record[field];\n  return typeof value === \"string\" && value !== \"\" ? value : null;\n}\n\nfunction entryIdOf(entry: { readonly [k: string]: unknown }): string | null {\n  return stringField(entry, \"id\") ?? stringField(entry, \"entryId\");\n}\n\nfunction lastEntryMatching(\n  entries: readonly { readonly [k: string]: unknown }[],\n  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n): string | null {\n  for (let index = entries.length - 1; index >= 0; index -= 1) {\n    const entry = entries[index];\n    if (entry === undefined || !matches(entry)) continue;\n    return entryIdOf(entry);\n  }\n  return null;\n}\n\nfunction firstEntryMatching(\n  entries: readonly { readonly [k: string]: unknown }[],\n  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n): string | null {\n  for (const entry of entries) {\n    if (!matches(entry)) continue;\n    const parentId = stringField(entry, \"parentId\");\n    if (parentId !== null) return parentId;\n  }\n  return null;\n}\n\nfunction readSessionEntries(filePath: string): { readonly [k: string]: unknown }[] {\n  let contents: string;\n  try {\n    contents = readFileSync(filePath, \"utf8\");\n  } catch {\n    return [];\n  }\n\n  const entries: { readonly [k: string]: unknown }[] = [];\n  for (const line of contents.trim().split(\"\\n\")) {\n    if (line.trim() === \"\") continue;\n    try {\n      const parsed = JSON.parse(line) as unknown;\n      if (typeof parsed !== \"object\" || parsed === null) continue;\n      const entry = parsed as { readonly [k: string]: unknown };\n      if (entry.type === \"session\") continue;\n      entries.push(entry);\n    } catch {\n      continue;\n    }\n  }\n  return entries;\n}\n\n/** Extract fork info from a `session_before_fork` hook payload. The hook\n *  provides `entryId` and optional `position` identifying the fork point. */\nexport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n  return { forkEntryId: entryId };\n}\n\n/** Seed a forked thread by replaying the source's recorded events up to the\n *  fork point, through the normal intake path. The source receives NO writes\n *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n *\n * Replay reads events from the source thread, filters to those up to and\n * including the fork point (by entryId match on idempotency key), and writes\n * them through the instance's intake path. This preserves event order, dedup\n * keys, and all logical content — the seeded thread's read-back matches the\n * source's read-back through the fork point (AC-3.2).\n *\n * The forkEntryId is PI's entry identifier for the session entry at the fork\n * point. During capture, this entryId was encoded into idempotency keys as\n * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n * contain this entryId in their key (any piSessionId, any block/kind), then\n * include all events up to and including the turn_end that closes the turn at\n * the fork point. */\nexport async function seedFork(\n  source: ThreadRef,\n  target: ThreadRef,\n  forkEntryId: string,\n  instance: LhcInstance,\n): Promise<OpResult<void>> {\n  const { intakeStream } = instance.sdk;\n\n  // Read all events from the source thread.\n  const events = await intakeStream.listEvents(source);\n  if (!events.ok) {\n    return {\n      ok: false,\n      error: {\n        errorClass: events.error.errorClass,\n        code: events.error.code,\n        reason: `fork source read failed: ${events.error.reason}`,\n      },\n    };\n  }\n\n  // Find the fork point event(s) by entryId match. The entryId appears in the\n  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n  // key contains `:${forkEntryId}:` regardless of piSessionId.\n  const forkPointEvents = events.value.filter((event) =>\n    event.idempotencyKey.includes(`:${forkEntryId}:`),\n  );\n\n  if (forkPointEvents.length === 0) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"thread_not_found\",\n        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n      },\n    };\n  }\n\n  // Use the maximum eventOrder among fork point events as the initial cutoff.\n  // This ensures we include all events (including fan-out) at the fork point.\n  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n\n  // Include the turn_end that closes the turn at the fork point.\n  // turn_end events don't have entryId in their key (they're generated by\n  // the connector), so we need to include the first turn_end after maxOrder.\n  const turnEndAfter = events.value.find(\n    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n  );\n  if (turnEndAfter !== undefined) {\n    maxOrder = turnEndAfter.eventOrder;\n  }\n\n  // Filter to events up to and including the fork point (including turn_end).\n  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n\n  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n  // Each event preserves its discriminated eventKind by construction from the\n  // recorded EventRecord, which carries the exact eventKind that was written.\n  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n    (record) =>\n      ({\n        eventKind: record.eventKind,\n        idempotencyKey: record.idempotencyKey,\n        actor: record.actor,\n        harness: record.harness,\n        payload: record.payload,\n      }) as MessageEventInput,\n  );\n\n  // Replay through the normal intake path into the target thread.\n  // This uses the same capture converter path, preserving all semantics.\n  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n  if (!result.ok) {\n    return {\n      ok: false,\n      error: {\n        errorClass: result.error.errorClass,\n        code: result.error.code,\n        reason: `fork replay failed: ${result.error.reason}`,\n      },\n    };\n  }\n\n  return { ok: true, value: undefined };\n}\n","numLines":218,"startLine":1,"totalLines":218}}}

omicity is\\\\n+// Chunk 0's named architecture risk — row + pending form + poke all drop on\\\\n+// rollback, because every later queue site (intake, cascade, repair) leans\\\\n+// on that invariant.\\\\n+import {\\\\n+  assembleWorkHandlerMap,\\\\n+  createSdk,\\\\n+  lookupWorkHandler,\\\\n+  runInTransaction,\\\\n+  setSchedulerPoke,\\\\n+  WORK_KIND_REGISTRY,\\\\n+  type WorkHandler,\\\\n+} from \\\\\\\"../src/index.js\\\\\\\";\\\\n+import { enqueue } from \\\\\\\"../src/tech-utils/work-queue/index.js\\\\\\\";\\\\n+import {\\\\n+  createProviderDouble,\\\\n+  readDerivedForms,\\\\n+  setIntakeWalkHook,\\\\n+} from \\\\\\\"./fixtures/index.js\\\\\\\";\\\\n+\\\\n+// Below-SDK read of derived_form rows — enqueue's pending rows are asserted\\\\n+// durably, not through the batch result.\\\\n+function rawFormRows(filePath: string): Array<{ key: string; state: string }> {\\\\n+  const db = openRaw(filePath);\\\\n+  try {\\\\n+    return db\\\\n+      .prepare(\\\\n+        `SELECT subject_kind || '/' || subject_id || '/' || form AS key, state\\\\n+         FROM derived_form ORDER BY key`,\\\\n+      )\\\\n+      .all() as unknown as Array<{ key: string; state: string }>;\\\\n+  } finally {\\\\n+    db.close();\\\\n+  }\\\\n+}\\\\n+\\\\n+describe(\\\\\\\"FC-0.4: work-kind registry and handler-map assembly\\\\\\\", () => {\\\\n+  it(\\\\\\\"the registry covers all six kinds with owner and sourceRef semantics per the Work Item contract\\\\\\\", () => {\\\\n+    expect(WORK_KIND_REGISTRY).toEqual({\\\\n+      prompt_smoothing: { owner: \\\\\\\"messages\\\\\\\", sourceRefKey: \\\\\\\"messageId\\\\\\\" },\\\\n+      tool_call_summary: { owner: \\\\\\\"messages\\\\\\\", sourceRefKey: \\\\\\\"messageId\\\\\\\" },\\\\n+      tool_result_summary: { owner: \\\\\\\"messages\\\\\\\", sourceRefKey: \\\\\\\"messageId\\\\\\\" },\\\\n+      turn_derivation: { owner: \\\\\\\"turns\\\\\\\", sourceRefKey: \\\\\\\"turnId\\\\\\\" },\\\\n+      chunk_summary_detailed: { owner: \\\\\\\"turns\\\\\\\", sourceRefKey: \\\\\\\"chunkId\\\\\\\" },\\\\n+      chunk_summary_brief: { owner: \\\\\\\"turns\\\\\\\", sourceRefKey: \\\\\\\"chunkId\\\\\\\" },\\\\n+    });\\\\n+  });\\\\n+\\\\n+  it(\\\\\\\"createSdk assembles the handler map from domain tables; an unregistered kind reports the miss explicitly\\\\\\\", () => {\\\\n+    const sdk = createSdk({ provider: createProviderDouble(), mode: \\\\\\\"manual\\\\\\\" });\\\\n+    // Domain tables are empty until Stories 2–3; assembly itself is live.\\\\n+    expect(sdk.workHandlers).toEqual({});\\\\n+    // The miss is reported as a structured result — not a throw, not silence.\\\\n+    const missed = sdk.lookupWorkHandler(\\\\\\\"prompt_smoothing\\\\\\\");\\\\n+    expect(missed.ok).toBe(false);\\\\n+    if (missed.ok) return;\\\\n+    expect(missed.error.errorClass).toBe(\\\\\\\"state_corruption\\\\\\\");\\\\n+    expect(missed.error.code).toBe(\\\\\\\"unknown_work_kind\\\\\\\");\\\\n+    expect(missed.error.reason).toContain(\\\\\\\"prompt_smoothing\\\\\\\");\\\\n+  });\\\\n+\\\\n+  it(\\\\\\\"assembly merges per-domain tables, dispatch finds a registered handler, and a doubly-claimed kind is refused\\\\\\\", () => {\\\\n+    const handler: WorkHandler = async () => ({ ok: true });\\\\n+    const map = assembleWorkHandlerMap([\\\\n+      { prompt_smoothing: handler },\\\\n+      { turn_derivation: handler },\\\\n+    ]);\\\\n+    const found = lookupWorkHandler(map, \\\\\\\"prompt_smoothing\\\\\\\");\\\\n+    expect(found.ok).toBe(true);\\\\n+    if (!found.ok) return;\\\\n+    expect(found.value).toBe(handler);\\\\n+    const missed = lookupWorkHandler(map, \\\\\\\"chunk_summary_brief\\\\\\\");\\\\n+    expect(missed.ok).toBe(false);\\\\n+    // One owner per kind: a second table claiming the same kind is a wiring\\\\n+    // bug surfaced at construction.\\\\n+    expect(() =>\\\\n+      assembleWorkHandlerMap([{ prompt_smoothing: handler }, { prompt_smoothing: handler }]),\\\\n+    ).toThrow(/prompt_smoothing/);\\\\n+  });\\\\n+});\\\\n+\\\\n+describe(\\\\\\\"architecture-risk: enqueue atomicity — row, pending form, poke commit or vanish together\\\\\\\", () => {\\\\n+  afterEach(() => {\\\\n+    setSchedulerPoke(null);\\\\n+    setIntakeWalkHook(null);\\\\n+  });\\\\n+\\\\n+  it(\\\\\\\"a committed intake batch durably writes work rows + pending forms and pokes once per enqueue, after commit\\\\\\\", async () => {\\\\n+    const filePath = await createThread();\\\\n+    const pokes: string[] = [];\\\\n+    setSchedulerPoke((threadId) => pokes.push(threadId));\\\\n+\\\\n+    const result = await send(filePath, [\\\\n+      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n+      validEvent(\\\\\\\"assistant_text\\\\\\\"),\\\\n+      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n+    ]);\\\\n+    // Two enqueues (prompt smoothing + turn derivation) → two pokes, both\\\\n+    // carrying the thread's resolved id, fired only after COMMIT.\\\\n+    expect(pokes).toHaveLength(2);\\\\n+    expect(new Set(pokes).size).toBe(1);\\\\n+    expect(pokes[0]).toMatch(/^th_/);\\\\n+    expect(result.queuedWork).toHaveLength(2);\\\\n+\\\\n+    // The pending state rows rode the same transaction (DD-5): one for the\\\\n+    // prompt's form, two for the turn's rendering + projection.\\\\n+    expect(rawFormRows(filePath)).toEqual([\\\\n+      { key: \\\\\\\"message/m1/smoothed_prompt\\\\\\\", state: \\\\\\\"pending\\\\\\\" },\\\\n+      { key: \\\\\\\"turn/t1/lower_band_projection\\\\\\\", state: \\\\\\\"pending\\\\\\\" },\\\\n+      { key: \\\\\\\"turn/t1/turn_rendering\\\\\\\", state: \\\\\\\"pending\\\\\\\" },\\\\n+    ]);\\\\n+  });\\\\n+\\\\n+  it(\\\\\\\"an induced rollback after enqueue drops the work row, the pending form row, and the poke\\\\\\\", async () => {\\\\n+    const filePath = await createThread();\\\\n+    const pokes: string[] = [];\\\\n+    setSchedulerPoke((threadId) => pokes.push(threadId));\\\\n+\\\\n+    // The prompt's enqueue has already run inside the walk when the hook\\\\n+    // fires on the second event and rejects the batch (production rollback\\\\n+    // path, same seam Epic 01's atomicity tests use).\\\\n+    setIntakeWalkHook((_db, eventIndex) => {\\\\n+      if (eventIndex === 1) throw new Error(\\\\\\\"induced mid-walk failure after enqueue\\\\\\\");\\\\n+    });\\\\n+    const rejected = await intakeStream.messageEvents({ filePath }, [\\\\n+      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n+      validEvent(\\\\\\\"assistant_text\\\\\\\"),\\\\n+    ]);\\\\n+    expect(rejected.ok).toBe(false);\\\\n+\\\\n+    expect(rawWorkItemCount(filePath)).toBe(0);\\\\n+    expect(rawFormRows(filePath)).toEqual([]);\\\\n+    expect(pokes).toEqual([]);\\\\n+  });\\\\n+\\\\n+  it(\\\\\\\"enqueue via runInTransaction: rollback drops all three effects; commit lands them and then pokes\\\\\\\", async () => {\\\\n+    const filePath = await createThread();\\\\n+    const opened = threads.openThreadDatabase(filePath);\\\\n+    expect(opened.ok).toBe(true);\\\\n+    if (!opened.ok) return;\\\\n+    const db = opened.value;\\\\n+    const pokes: string[] = [];\\\\n+    setSchedulerPoke((threadId) => pokes.push(threadId));\\\\n+    const clock = () => new Date(FIXED_INSTANT);\\\\n+\\\\n+    try {\\\\n+      // Rollback leg: the body enqueues, then throws.\\\\n+      expect(() =>\\\\n+        runInTransaction(db, clock, \\\\\\\"th_direct\\\\\\\", (ctx) => {\\\\n+          enqueue(ctx, {\\\\n+            owner: \\\\\\\"turns\\\\\\\",\\\\n+            kind: \\\\\\\"chunk_summary_brief\\\\\\\",\\\\n+            sourceRef: { chunkId: \\\\\\\"c1\\\\\\\" },\\\\n+            forms: [{ subjectKind: \\\\\\\"chunk\\\\\\\", subjectId: \\\\\\\"c1\\\\\\\", form: \\\\\\\"chunk_summary_brief\\\\\\\" }],\\\\n+          });\\\\n+          throw new Error(\\\\\\\"induced rollback\\\\\\\");\\\\n+        }),\\\\n+      ).toThrow(\\\\\\\"induced rollback\\\\\\\");\\\\n+      expect(rawWorkItemCount(filePath)).toBe(0);\\\\n+      expect(rawFormRows(filePath)).toEqual([]);\\\\n+      expect(pokes).toEqual([]);\\\\n+\\\\n+      // Commit leg: same enqueue, no failure — and the poke fires after the\\\\n+      // body, not inside it.\\\\n+      const item = runInTransaction(db, clock, \\\\\\\"th_direct\\\\\\\", (ctx) => {\\\\n+        const record = enqueue(ctx, {\\\\n+          owner: \\\\\\\"turns\\\\\\\",\\\\n+          kind: \\\\\\\"chunk_summary_brief\\\\\\\",\\\\n+          sourceRef: { chunkId: \\\\\\\"c1\\\\\\\" },\\\\n+          forms: [{ subjectKind: \\\\\\\"chunk\\\\\\\", subjectId: \\\\\\\"c1\\\\\\\", form: \\\\\\\"chunk_summary_brief\\\\\\\" }],\\\\n+        });\\\\n+        expect(pokes).toEqual([]); // not yet committed\\\\n+        return record;\\\\n+      });\\\\n+      expect(item.workItemId).toBe(\\\\\\\"w-c1-chunk_summary_brief-v1\\\\\\\");\\\\n+      expect(pokes).toEqual([\\\\\\\"th_direct\\\\\\\"]);\\\\n+      expect(rawFormRows(filePath)).toEqual([\\\\n+        { key: \\\\\\\"chunk/c1/chunk_summary_brief\\\\\\\", state: \\\\\\\"pending\\\\\\\" },\\\\n+      ]);\\\\n+    } finally {\\\\n+      db.close();\\\\n+    }\\\\n+  });\\\\n+\\\\n+  it(\\\\\\\"re-enqueueing at a later source version resets the form row to pending at that version\\\\\\\", async () => {\\\\n+    const filePath = await createThread();\\\\n+    const opened = threads.openThreadDatabase(filePath);\\\\n+    expect(opened.ok).toBe(true);\\\\n+    if (!opened.ok) return;\\\\n+    const db = opened.value;\\\\n+    const clock = () => new Date(FIXED_INSTANT);\\\\n+    try {\\\\n+      runInTransaction(db, clock, \\\\\\\"th_direct\\\\\\\", (ctx) => {\\\\n+        enqueue(ctx, {\\\\n+          owner: \\\\\\\"messages\\\\\\\",\\\\n+          kind: \\\\\\\"prompt_smoothing\\\\\\\",\\\\n+          sourceRef: { messageId: \\\\\\\"mx\\\\\\\" },\\\\n+          forms: [{ subjectKind: \\\\\\\"message\\\\\\\", subjectId: \\\\\\\"mx\\\\\\\", form: \\\\\\\"smoothed_prompt\\\\\\\" }],\\\\n+        });\\\\n+      });\\\\n+      // Versioned ids let the replacement coexist with (not collide into)\\\\n+      // the version-1 item (DD-1/DD-3).\\\\n+      const replacement = runInTransaction(db, clock, \\\\\\\"th_direct\\\\\\\", (ctx) =>\\\\n+        enqueue(ctx, {\\\\n+          owner: \\\\\\\"messages\\\\\\\",\\\\n+          kind: \\\\\\\"prompt_smoothing\\\\\\\",\\\\n+          sourceRef: { messageId: \\\\\\\"mx\\\\\\\" },\\\\n+          sourceVersion: 2,\\\\n+          forms: [{ subjectKind: \\\\\\\"message\\\\\\\", subjectId: \\\\\\\"mx\\\\\\\", form: \\\\\\\"smoothed_prompt\\\\\\\" }],\\\\n+        }),\\\\n+      );\\\\n+      expect(replacement.workItemId).toBe(\\\\\\\"w-mx-prompt_smoothing-v2\\\\\\\");\\\\n+      const forms = readDerivedForms(filePath);\\\\n+      expect(forms).toHaveLength(1);\\\\n+      expect(forms[0]).toMatchObject({\\\\n+        subjectKind: \\\\\\\"message\\\\\\\",\\\\n+        subjectId: \\\\\\\"mx\\\\\\\",\\\\n+        form: \\\\\\\"smoothed_prompt\\\\\\\",\\\\n+        state: \\\\\\\"pending\\\\\\\",\\\\n+        sourceVersion: 2,\\\\n+      });\\\\n+      expect(rawWorkItemCount(filePath)).toBe(2);\\\\n+    } finally {\\\\n+      db.close();\\\\n+    }\\\\n+  });\\\\n+});\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n./packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/fix/streams/004-fix-result.stdout.log:187:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01L42kbTivKboYkHmBGP3uPs\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\\\\n2\\\\t// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\\\\n3\\\\t// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\\\\n4\\\\t// unknown-kind handling, both host modes, and coalesced background\\\\n5\\\\t// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\\\\n6\\\\t// CLI parity) live in cli-process-work.test.ts.\\\\n7\\\\timport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\n8\\\\timport {\\\\n9\\\\t  countLiveItems,\\\\n10\\\\t  createSdk,\\\\n11\\\\t  intakeStream,\\\\n12\\\\t  queueDetail,\\\\n13\\\\t  setSchedulerPoke,\\\\n14\\\\t  setThreadTouch,\\\\n15\\\\t  threads,\\\\n16\\\\t  type DrainReport,\\\\n17\\\\t  type Lhc,\\\\n18\\\\t  type MessageEventInput,\\\\n19\\\\t} from \\\\\\\"../src/index.js\\\\\\\";\\\\n20\\\\timport {\\\\n21\\\\t  createProviderDouble,\\\\n22\\\\t  openRaw,\\\\n23\\\\t  readDerivedForms,\\\\n24\\\\t  registerTestWorkHandlers,\\\\n25\\\\t  tempStore,\\\\n26\\\\t  validEvent,\\\\n27\\\\t  type TempStore,\\\\n28\\\\t  type ProviderDouble,\\\\n29\\\\t} from \\\\\\\"./fixtures/index.js\\\\\\\";\\\\n30\\\\t\\\\n31\\\\tfunction sleep(ms: number): Promise<void> {\\\\n32\\\\t  return new Promise((resolve) => setTimeout(resolve, ms));\\\\n33\\\\t}\\\\n34\\\\t\\\\n35\\\\tlet store: TempStore;\\\\n36\\\\tbeforeEach(() => {\\\\n37\\\\t  store = tempStore();\\\\n38\\\\t});\\\\n39\\\\tafterEach(() => {\\\\n40\\\\t  // Background-mode SDKs install process-wide seams at construction; tests\\\\n41\\\\t  // must not leak them into each other.\\\\n42\\\\t  setSchedulerPoke(null);\\\\n43\\\\t  setThreadTouch(null);\\\\n44\\\\t  store.cleanup();\\\\n45\\\\t});\\\\n46\\\\t\\\\n47\\\\tasync function newThread(): Promise<{ threadId: string; filePath: string }> {\\\\n48\\\\t  const created = await threads.newThread({\\\\n49\\\\t    filePath: store.threadPath(),\\\\n50\\\\t    registryPath: store.registryPath,\\\\n51\\\\t  });\\\\n52\\\\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\\\n53\\\\t  return created.value;\\\\n54\\\\t}\\\\n55\\\\t\\\\n56\\\\tasync function send(\\\\n57\\\\t  sdk: Lhc,\\\\n58\\\\t  filePath: string,\\\\n59\\\\t  batch: readonly MessageEventInput[],\\\\n60\\\\t): Promise<void> {\\\\n61\\\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\\\n62\\\\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\\\\n63\\\\t}\\\\n64\\\\t\\\\n65\\\\tfunction manualSdk(\\\\n66\\\\t  double: ProviderDouble,\\\\n67\\\\t  overrides: {\\\\n68\\\\t    clock?: () => Date;\\\\n69\\\\t    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\\\\n70\\\\t  } = {},\\\\n71\\\\t): Lhc {\\\\n72\\\\t  const sdk = createSdk({\\\\n73\\\\t    provider: double,\\\\n74\\\\t    mode: \\\\\\\"manual\\\\\\\",\\\\n75\\\\t    clock: overrides.clock ?? (() => new Date()),\\\\n76\\\\t    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n77\\\\t    lease: { durationMs: 200 },\\\\n78\\\\t  });\\\\n79\\\\t  registerTestWorkHandlers(sdk, double);\\\\n80\\\\t  return sdk;\\\\n81\\\\t}\\\\n82\\\\t\\\\n83\\\\tasync function drain(\\\\n84\\\\t  sdk: Lhc,\\\\n85\\\\t  filePath: string,\\\\n86\\\\t  opts?: { maxItems?: number },\\\\n87\\\\t): Promise<DrainReport> {\\\\n88\\\\t  const result = await sdk.work.drain({ filePath }, opts);\\\\n89\\\\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\\\\n90\\\\t  return result.value;\\\\n91\\\\t}\\\\n92\\\\t\\\\n93\\\\tfunction liveCount(filePath: string): number {\\\\n94\\\\t  const db = openRaw(filePath);\\\\n95\\\\t  try {\\\\n96\\\\t    return countLiveItems(db);\\\\n97\\\\t  } finally {\\\\n98\\\\t    db.close();\\\\n99\\\\t  }\\\\n100\\\\t}\\\\n101\\\\t\\\\n102\\\\tfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\\\\n103\\\\t  const db = openRaw(filePath);\\\\n104\\\\t  try {\\\\n105\\\\t    return queueDetail(db);\\\\n106\\\\t  } finally {\\\\n107\\\\t    db.close();\\\\n108\\\\t  }\\\\n109\\\\t}\\\\n110\\\\t\\\\n111\\\\tdescribe(\\\\\\\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\\\\\\\", () => {\\\\n112\\\\t  // Epic 02 Story 2 (sanctioned amendment): tool_call now queues\\\\n113\\\\t  // tool_call_summary, so this batch yields four items, not three.\\\\n114\\\\t  it(\\\\\\\"four items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\\\\\\\", async () => {\\\\n115\\\\t    const double = createProviderDouble();\\\\n116\\\\t    let tick = 0;\\\\n117\\\\t    const base = Date.parse(\\\\\\\"2026-06-10T12:00:00.000Z\\\\\\\");\\\\n118\\\\t    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\\\\n119\\\\t    const { filePath } = await newThread();\\\\n120\\\\t    await send(sdk, filePath, [\\\\n121\\\\t      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n122\\\\t      validEvent(\\\\\\\"tool_call\\\\\\\"),\\\\n123\\\\t      validEvent(\\\\\\\"tool_result\\\\\\\"),\\\\n124\\\\t      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n125\\\\t    ]);\\\\n126\\\\t    expect(liveCount(filePath)).toBe(4);\\\\n127\\\\t\\\\n128\\\\t    const report = await drain(sdk, filePath);\\\\n129\\\\t    // Queue order across owners: m1's smoothing, m2's call summary, m3's\\\\n130\\\\t    // result summary, then the turn derivation queued at close — never\\\\n131\\\\t    // reordered.\\\\n132\\\\t    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\\\\n133\\\\t      \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n134\\\\t      \\\\\\\"w-m2-tool_call_summary-v1\\\\\\\",\\\\n135\\\\t      \\\\\\\"w-m3-tool_result_summary-v1\\\\\\\",\\\\n136\\\\t      \\\\\\\"w-t1-turn_derivation-v1\\\\\\\",\\\\n137\\\\t    ]);\\\\n138\\\\t    expect(report.ran.map((entry) => entry.disposition)).toEqual([\\\\n139\\\\t      \\\\\\\"done\\\\\\\",\\\\n140\\\\t      \\\\\\\"done\\\\\\\",\\\\n141\\\\t      \\\\\\\"done\\\\\\\",\\\\n142\\\\t      \\\\\\\"done\\\\\\\",\\\\n143\\\\t    ]);\\\\n144\\\\t    expect(report.stoppedBecause).toBe(\\\\\\\"empty\\\\\\\");\\\\n145\\\\t    expect(report.remaining).toBe(0);\\\\n146\\\\t\\\\n147\\\\t    // DD-1 storage contract: terminal rows are gone — the report is the only\\\\n148\\\\t    // place the dispositions exist (raw zero-row read).\\\\n149\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n150\\\\t    const db = openRaw(filePath);\\\\n151\\\\t    try {\\\\n152\\\\t      const rows = db.prepare(\\\\\\\"SELECT COUNT(*) AS n FROM work_item\\\\\\\").get() as {\\\\n153\\\\t        n: number | bigint;\\\\n154\\\\t      };\\\\n155\\\\t      expect(Number(rows.n)).toBe(0);\\\\n156\\\\t    } finally {\\\\n157\\\\t      db.close();\\\\n158\\\\t    }\\\\n159\\\\t\\\\n160\\\\t    // Artifacts landed in run order: derivedAt strictly monotone with the\\\\n161\\\\t    // injected clock from m1 to m3 to the turn's forms.\\\\n162\\\\t    const forms = readDerivedForms(filePath);\\\\n163\\\\t    expect(forms.map((form) => form.state)).toEqual([\\\\n164\\\\t      \\\\\\\"ready\\\\\\\",\\\\n165\\\\t      \\\\\\\"ready\\\\\\\",\\\\n166\\\\t      \\\\\\\"ready\\\\\\\",\\\\n167\\\\t      \\\\\\\"ready\\\\\\\",\\\\n168\\\\t      \\\\\\\"ready\\\\\\\",\\\\n169\\\\t    ]);\\\\n170\\\\t    const at = (subjectId: string, form: string): number => {\\\\n171\\\\t      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\\\\n172\\\\t      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\\\\n173\\\\t      return Date.parse(row.derivedAt);\\\\n174\\\\t    };\\\\n175\\\\t    expect(at(\\\\\\\"m1\\\\\\\", \\\\\\\"smoothed_prompt\\\\\\\")).toBeLessThan(at(\\\\\\\"m3\\\\\\\", \\\\\\\"tool_result_summary\\\\\\\"));\\\\n176\\\\t    expect(at(\\\\\\\"m3\\\\\\\", \\\\\\\"tool_result_summary\\\\\\\")).toBeLessThan(at(\\\\\\\"t1\\\\\\\", \\\\\\\"turn_rendering\\\\\\\"));\\\\n177\\\\t    expect(at(\\\\\\\"t1\\\\\\\", \\\\\\\"turn_rendering\\\\\\\")).toBe(at(\\\\\\\"t1\\\\\\\", \\\\\\\"lower_band_projection\\\\\\\"));\\\\n178\\\\t  });\\\\n179\\\\t});\\\\n180\\\\t\\\\n181\\\\tdescribe(\\\\\\\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\\\\\\\", () => {\\\\n182\\\\t  it(\\\\\\\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\\\\\\\", async () => {\\\\n183\\\\t    const double = createProviderDouble();\\\\n184\\\\t    double.delayKind(\\\\\\\"prompt_smoothing\\\\\\\", 100);\\\\n185\\\\t    const sdk = createSdk({\\\\n186\\\\t      provider: double,\\\\n187\\\\t      mode: \\\\\\\"background\\\\\\\",\\\\n188\\\\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n189\\\\t      lease: { durationMs: 1000 },\\\\n190\\\\t    });\\\\n191\\\\t    registerTestWorkHandlers(sdk, double);\\\\n192\\\\t    const { threadId, filePath } = await newThread();\\\\n193\\\\t\\\\n194\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"batch A\\\\\\\" } })]);\\\\n195\\\\t    // Let the poked drain start (it defers one macrotask), then queue two\\\\n196\\\\t    // more batches while item A's slow handler is in flight.\\\\n197\\\\t    await sleep(10);\\\\n198\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"batch B\\\\\\\" } })]);\\\\n199\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"batch C\\\\\\\" } })]);\\\\n200\\\\t\\\\n201\\\\t    await sdk.drainSettled({ filePath });\\\\n202\\\\t\\\\n203\\\\t    // Everything queued mid-drain was processed before the cycle ended…\\\\n204\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n205\\\\t    const smoothed = readDerivedForms(filePath).filter((f) => f.form === \\\\\\\"smoothed_prompt\\\\\\\");\\\\n206\\\\t    expect(smoothed.map((f) => f.state)).toEqual([\\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\"]);\\\\n207\\\\t    // …and the burst coalesced: one initial pass plus exactly one follow-up,\\\\n208\\\\t    // not one pass per poke (the cost model is the assertion).\\\\n209\\\\t    expect(sdk.scheduler.testPassCount(threadId)).toBe(2);\\\\n210\\\\t  });\\\\n211\\\\t});\\\\n212\\\\t\\\\n213\\\\tdescribe(\\\\\\\"TC-1.5 / AC-1.5, AC-1.6: background mode — queueing is sufficient; first touch catches up\\\\\\\", () => {\\\\n214\\\\t  it(\\\\\\\"an intake batch is processed with no drain call; drainSettled is the completion signal\\\\\\\", async () => {\\\\n215\\\\t    const double = createProviderDouble();\\\\n216\\\\t    const sdk = createSdk({\\\\n217\\\\t      provider: double,\\\\n218\\\\t      mode: \\\\\\\"background\\\\\\\",\\\\n219\\\\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n220\\\\t      lease: { durationMs: 1000 },\\\\n221\\\\t    });\\\\n222\\\\t    registerTestWorkHandlers(sdk, double);\\\\n223\\\\t    const { filePath } = await newThread();\\\\n224\\\\t\\\\n225\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\"), validEvent(\\\\\\\"turn_end\\\\\\\")]);\\\\n226\\\\t    await sdk.drainSettled({ filePath });\\\\n227\\\\t\\\\n228\\\\t    const forms = readDerivedForms(filePath);\\\\n229\\\\t    expect(forms.map((f) => `${f.subjectId}/${f.form}/${f.state}`).sort()).toEqual([\\\\n230\\\\t      \\\\\\\"m1/smoothed_prompt/ready\\\\\\\",\\\\n231\\\\t      \\\\\\\"t1/lower_band_projection/ready\\\\\\\",\\\\n232\\\\t      \\\\\\\"t1/turn_rendering/ready\\\\\\\",\\\\n233\\\\t    ]);\\\\n234\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n235\\\\t  });\\\\n236\\\\t\\\\n237\\\\t  it(\\\\\\\"reopening a thread with leftover queued rows runs them on first touch — a read, not a write\\\\\\\", async () => {\\\\n238\\\\t    // Build the leftover state with no background scheduler installed: rows\\\\n239\\\\t    // accumulate exactly as a dead process would have left them.\\\\n240\\\\t    const { filePath } = await newThread();\\\\n241\\\\t    const seeded = await intakeStream.messageEvents({ filePath }, [\\\\n242\\\\t      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n243\\\\t      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n244\\\\t    ]);\\\\n245\\\\t    expect(seeded.ok).toBe(true);\\\\n246\\\\t    expect(liveCount(filePath)).toBe(2);\\\\n247\\\\t\\\\n248\\\\t    const double = createProviderDouble();\\\\n249\\\\t    const sdk = createSdk({\\\\n250\\\\t      provider: double,\\\\n251\\\\t      mode: \\\\\\\"background\\\\\\\",\\\\n252\\\\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n253\\\\t      lease: { durationMs: 1000 },\\\\n254\\\\t    });\\\\n255\\\\t    registerTestWorkHandlers(sdk, double);\\\\n256\\\\t\\\\n257\\\\t    // First touch of the thread in this process lifetime: a plain read.\\\\n258\\\\t    const read = await sdk.messages.listMessages({ filePath });\\\\n259\\\\t    expect(read.ok).toBe(true);\\\\n260\\\\t    await sdk.drainSettled({ filePath });\\\\n261\\\\t\\\\n262\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n263\\\\t    const states = readDerivedForms(filePath).map((f) => f.state);\\\\n264\\\\t    expect(states).toEqual([\\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\"]);\\\\n265\\\\t  });\\\\n266\\\\t});\\\\n267\\\\t\\\\n268\\\\tdescribe(\\\\\\\"TC-1.6 / AC-1.7: manual mode — rows accumulate durably and run only when drain is invoked\\\\\\\", () => {\\\\n269\\\\t  it(\\\\\\\"queued work sits until work.drain; artifacts land after\\\\\\\", async () => {\\\\n270\\\\t    const double = createProviderDouble();\\\\n271\\\\t    const sdk = manualSdk(double);\\\\n272\\\\t    const { filePath } = await newThread();\\\\n273\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n274\\\\t\\\\n275\\\\t    await sleep(100);\\\\n276\\\\t    expect(liveCount(filePath)).toBe(1);\\\\n277\\\\t    expect(liveDetail(filePath)[0]?.status).toBe(\\\\\\\"queued\\\\\\\");\\\\n278\\\\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\\\\\\\"pending\\\\\\\"]);\\\\n279\\\\t\\\\n280\\\\t    const report = await drain(sdk, filePath);\\\\n281\\\\t    expect(report.ran).toHaveLength(1);\\\\n282\\\\t    expect(report.ran[0]?.disposition).toBe(\\\\\\\"done\\\\\\\");\\\\n283\\\\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\\\\\\\"ready\\\\\\\"]);\\\\n284\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n285\\\\t  });\\\\n286\\\\t});\\\\n287\\\\t\\\\n288\\\\tdescribe(\\\\\\\"TC-1.7 / AC-1.8: an unregistered kind lands failed_terminal with a stable reason and the drain continues\\\\\\\", () => {\\\\n289\\\\t  it(\\\\\\\"a bogus-kind row ahead of a valid item fails with unknown_work_kind; the valid item still runs\\\\\\\", async () => {\\\\n290\\\\t    const double = createProviderDouble();\\\\n291\\\\t    const sdk = manualSdk(double);\\\\n292\\\\t    const { filePath } = await newThread();\\\\n293\\\\t\\\\n294\\\\t    // Raw row with an unregistered kind, queued ahead of any valid work.\\\\n295\\\\t    const db = openRaw(filePath);\\\\n296\\\\t    try {\\\\n297\\\\t      db.prepare(\\\\n298\\\\t        `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\\\\n299\\\\t         VALUES ('w-mX-bogus_kind-v1', 'messages', 'bogus_kind', '{\\\\\\\"messageId\\\\\\\":\\\\\\\"mX\\\\\\\"}', 'queued',\\\\n300\\\\t                 '2026-06-10T11:00:00.000Z')`,\\\\n301\\\\t      ).run();\\\\n302\\\\t    } finally {\\\\n303\\\\t      db.close();\\\\n304\\\\t    }\\\\n305\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n306\\\\t\\\\n307\\\\t    const report = await drain(sdk, filePath);\\\\n308\\\\t    expect(report.ran).toHaveLength(2);\\\\n309\\\\t    expect(report.ran[0]).toMatchObject({\\\\n310\\\\t      workItemId: \\\\\\\"w-mX-bogus_kind-v1\\\\\\\",\\\\n311\\\\t      disposition: \\\\\\\"failed_terminal\\\\\\\",\\\\n312\\\\t      reason: \\\\\\\"unknown_work_kind\\\\\\\",\\\\n313\\\\t    });\\\\n314\\\\t    expect(report.ran[1]).toMatchObject({\\\\n315\\\\t      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n316\\\\t      disposition: \\\\\\\"done\\\\\\\",\\\\n317\\\\t    });\\\\n318\\\\t    expect(report.stoppedBecause).toBe(\\\\\\\"empty\\\\\\\");\\\\n319\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n320\\\\t    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \\\\\\\"m1\\\\\\\");\\\\n321\\\\t    expect(smoothed?.state).toBe(\\\\\\\"ready\\\\\\\");\\\\n322\\\\t  });\\\\n323\\\\t});\\\\n324\\\\t\\\\n325\\\\tdescribe(\\\\\\\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\\\\\\\", () => {\\\\n326\\\\t  it(\\\\\\\"fails twice then succeeds: artifact ready, report shows attempts=2\\\\\\\", async () => {\\\\n327\\\\t    const double = createProviderDouble();\\\\n328\\\\t    const sdk = manualSdk(double);\\\\n329\\\\t    const { filePath } = await newThread();\\\\n330\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n331\\\\t\\\\n332\\\\t    double.failNext(2, { retryable: true });\\\\n333\\\\t    const report = await drain(sdk, filePath);\\\\n334\\\\t    expect(report.ran).toHaveLength(1);\\\\n335\\\\t    expect(report.ran[0]).toMatchObject({\\\\n336\\\\t      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n337\\\\t      disposition: \\\\\\\"done\\\\\\\",\\\\n338\\\\t      attempts: 2,\\\\n339\\\\t    });\\\\n340\\\\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\\\\\\\"ready\\\\\\\");\\\\n341\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n342\\\\t  });\\\\n343\\\\t\\\\n344\\\\t  it(\\\\\\\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\\\\\\\", async () => {\\\\n345\\\\t    const double = createProviderDouble();\\\\n346\\\\t    const sdk = manualSdk(double);\\\\n347\\\\t    const { filePath } = await newThread();\\\\n348\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\"), validEvent(\\\\\\\"turn_end\\\\\\\")]);\\\\n349\\\\t\\\\n350\\\\t    double.failKind(\\\\\\\"prompt_smoothing\\\\\\\", 99, {\\\\n351\\\\t      retryable: true,\\\\n352\\\\t      reason: \\\\\\\"scripted exhaustion (smoothPrompt)\\\\\\\",\\\\n353\\\\t    });\\\\n354\\\\t    const report = await drain(sdk, filePath);\\\\n355\\\\t    expect(report.ran).toHaveLength(2);\\\\n356\\\\t    expect(report.ran[0]).toMatchObject({\\\\n357\\\\t      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n358\\\\t      disposition: \\\\\\\"failed_terminal\\\\\\\",\\\\n359\\\\t      attempts: 3,\\\\n360\\\\t      reason: \\\\\\\"scripted exhaustion (smoothPrompt)\\\\\\\",\\\\n361\\\\t    });\\\\n362\\\\t    expect(report.ran[1]).toMatchObject({\\\\n363\\\\t      workItemId: \\\\\\\"w-t1-turn_derivation-v1\\\\\\\",\\\\n364\\\\t      disposition: \\\\\\\"done\\\\\\\",\\\\n365\\\\t    });\\\\n366\\\\t\\\\n367\\\\t    const forms = readDerivedForms(filePath);\\\\n368\\\\t    const failed = forms.find((f) => f.form === \\\\\\\"smoothed_prompt\\\\\\\");\\\\n369\\\\t    expect(failed?.state).toBe(\\\\\\\"failed\\\\\\\");\\\\n370\\\\t    expect(failed?.reason).toBe(\\\\\\\"scripted exhaustion (smoothPrompt)\\\\\\\");\\\\n371\\\\t    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\\\\n372\\\\t    expect(failed?.metadata?.attempts).toBe(3);\\\\n373\\\\t    expect(forms.find((f) => f.form === \\\\\\\"turn_rendering\\\\\\\")?.state).toBe(\\\\\\\"ready\\\\\\\");\\\\n374\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n375\\\\t  });\\\\n376\\\\t\\\\n377\\\\t  it(\\\\\\\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\\\\\\\", async () => {\\\\n378\\\\t    const double = createProviderDouble();\\\\n379\\\\t    let nowMs = Date.parse(\\\\\\\"2026-06-10T12:00:00.000Z\\\\\\\");\\\\n380\\\\t    const sdk = manualSdk(double, {\\\\n381\\\\t      clock: () => new Date(nowMs),\\\\n382\\\\t      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\\\\n383\\\\t    });\\\\n384\\\\t    const { filePath } = await newThread();\\\\n385\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\"), validEvent(\\\\\\\"turn_end\\\\\\\")]);\\\\n386\\\\t\\\\n387\\\\t    double.failNext(1, { retryable: true });\\\\n388\\\\t    const first = await drain(sdk, filePath);\\\\n389\\\\t    // The head failed once and is backing off: nothing terminal ran, the\\\\n390\\\\t    // drain stopped on the eligibility gate, and the queue behind the head\\\\n391\\\\t    // was not touched.\\\\n392\\\\t    expect(first.ran).toEqual([]);\\\\n393\\\\t    expect(first.stoppedBecause).toBe(\\\\\\\"waiting\\\\\\\");\\\\n394\\\\t    expect(first.remaining).toBe(2);\\\\n395\\\\t    expect(first.waitingUntil).toBeDefined();\\\\n396\\\\t    expect(Date.parse(first.waitingUntil ?? \\\\\\\"\\\\\\\")).toBeGreaterThan(nowMs);\\\\n397\\\\t\\\\n398\\\\t    const detail = liveDetail(filePath);\\\\n399\\\\t    expect(detail).toHaveLength(2);\\\\n400\\\\t    expect(detail[0]).toMatchObject({\\\\n401\\\\t      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n402\\\\t      status: \\\\\\\"queued\\\\\\\",\\\\n403\\\\t      attempts: 1,\\\\n404\\\\t    });\\\\n405\\\\t    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\\\\n406\\\\t    // Skip-ahead proof: the eligible item behind the backing-off head was\\\\n407\\\\t    // never claimed.\\\\n408\\\\t    expect(detail[1]).toMatchObject({\\\\n409\\\\t      workItemId: \\\\\\\"w-t1-turn_derivation-v1\\\\\\\",\\\\n410\\\\t      status: \\\\\\\"queued\\\\\\\",\\\\n411\\\\t      attempts: 0,\\\\n412\\\\t    });\\\\n413\\\\t    expect(detail[1]?.claimedAt).toBeUndefined();\\\\n414\\\\t\\\\n415\\\\t    // Pass the gate: the head becomes eligible and the queue drains in order.\\\\n416\\\\t    nowMs += 60000;\\\\n417\\\\t    const second = await drain(sdk, filePath);\\\\n418\\\\t    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\\\\n419\\\\t      [\\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\", \\\\\\\"done\\\\\\\"],\\\\n420\\\\t      [\\\\\\\"w-t1-turn_derivation-v1\\\\\\\", \\\\\\\"done\\\\\\\"],\\\\n421\\\\t    ]);\\\\n422\\\\t    expect(second.ran[0]?.attempts).toBe(1);\\\\n423\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n424\\\\t  });\\\\n425\\\\t\\\\n426\\\\t  it(\\\\\\\"a non-retryable provider failure is terminal immediately\\\\\\\", async () => {\\\\n427\\\\t    const double = createProviderDouble();\\\\n428\\\\t    const sdk = manualSdk(double);\\\\n429\\\\t    const { filePath } = await newThread();\\\\n430\\\\t    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n431\\\\t\\\\n432\\\\t    double.failNext(1, { retryable: false, reason: \\\\\\\"content refusal (scripted)\\\\\\\" });\\\\n433\\\\t    const report = await drain(sdk, filePath);\\\\n434\\\\t    expect(report.ran[0]).toMatchObject({\\\\n435\\\\t      disposition: \\\\\\\"failed_terminal\\\\\\\",\\\\n436\\\\t      attempts: 1,\\\\n437\\\\t      reason: \\\\\\\"content refusal (scripted)\\\\\\\",\\\\n438\\\\t    });\\\\n439\\\\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\\\\\\\"failed\\\\\\\");\\\\n440\\\\t    expect(liveCount(filePath)).toBe(0);\\\\n441\\\\t  });\\\\n442\\\\t\\\\n443\\\\t  it(\\\\\\\"maxItems stops the drain with max_items and reports the remainder\\\\\\\", async () => {\\\\n444\\\\t    const double = createProviderDouble();\\\\n445\\\\t    const sdk = manualSdk(double);\\\\n446\\\\t    const { filePath } = await newThread();\\\\n447\\\\t    await send(sdk, filePath, [\\\\n448\\\\t      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n449\\\\t      validEvent(\\\\\\\"tool_call\\\\\\\"),\\\\n450\\\\t      validEvent(\\\\\\\"tool_result\\\\\\\"),\\\\n451\\\\t      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n452\\\\t    ]);\\\\n453\\\\t\\\\n454\\\\t    const report = await drain(sdk, filePath, { maxItems: 1 });\\\\n455\\\\t    expect(report.ran).toHaveLength(1);\\\\n456\\\\t    expect(report.stoppedBecause).toBe(\\\\\\\"max_items\\\\\\\");\\\\n457\\\\t    // 3 behind the stop since Epic 02 Story 2: tool_call queues its summary\\\\n458\\\\t    // (sanctioned amendment — was 2).\\\\n459\\\\t    expect(report.remaining).toBe(3);\\\\n460\\\\t    expect(liveCount(filePath)).toBe(3);\\\\n461\\\\t  });\\\\n462\\\\t});\\\\n463\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"d9c65f8a-2769-45ee-8250-eab6f8fa0e38\\\",\\\"uuid\\\":\\\"48622c8e-cf08-4852-b13a-8ffc50bb8382\\\",\\\"timestamp\\\":\\\"2026-06-11T09:55:39.130Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/work-execution.test.ts\\\",\\\"content\\\":\\\"// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\\\\n// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\\\\n// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\\\\n// unknown-kind handling, both host modes, and coalesced background\\\\n// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\\\\n// CLI parity) live in cli-process-work.test.ts.\\\\nimport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\nimport {\\\\n  countLiveItems,\\\\n  createSdk,\\\\n  intakeStream,\\\\n  queueDetail,\\\\n  setSchedulerPoke,\\\\n  setThreadTouch,\\\\n  threads,\\\\n  type DrainReport,\\\\n  type Lhc,\\\\n  type MessageEventInput,\\\\n} from \\\\\\\"../src/index.js\\\\\\\";\\\\nimport {\\\\n  createProviderDouble,\\\\n  openRaw,\\\\n  readDerivedForms,\\\\n  registerTestWorkHandlers,\\\\n  tempStore,\\\\n  validEvent,\\\\n  type TempStore,\\\\n  type ProviderDouble,\\\\n} from \\\\\\\"./fixtures/index.js\\\\\\\";\\\\n\\\\nfunction sleep(ms: number): Promise<void> {\\\\n  return new Promise((resolve) => setTimeout(resolve, ms));\\\\n}\\\\n\\\\nlet store: TempStore;\\\\nbeforeEach(() => {\\\\n  store = tempStore();\\\\n});\\\\nafterEach(() => {\\\\n  // Background-mode SDKs install process-wide seams at construction; tests\\\\n  // must not leak them into each other.\\\\n  setSchedulerPoke(null);\\\\n  setThreadTouch(null);\\\\n  store.cleanup();\\\\n});\\\\n\\\\nasync function newThread(): Promise<{ threadId: string; filePath: string }> {\\\\n  const created = await threads.newThread({\\\\n    filePath: store.threadPath(),\\\\n    registryPath: store.registryPath,\\\\n  });\\\\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\\\n  return created.value;\\\\n}\\\\n\\\\nasync function send(\\\\n  sdk: Lhc,\\\\n  filePath: string,\\\\n  batch: readonly MessageEventInput[],\\\\n): Promise<void> {\\\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\\\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\\\\n}\\\\n\\\\nfunction manualSdk(\\\\n  double: ProviderDouble,\\\\n  overrides: {\\\\n    clock?: () => Date;\\\\n    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\\\\n  } = {},\\\\n): Lhc {\\\\n  const sdk = createSdk({\\\\n    provider: double,\\\\n    mode: \\\\\\\"manual\\\\\\\",\\\\n    clock: overrides.clock ?? (() => new Date()),\\\\n    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n    lease: { durationMs: 200 },\\\\n  });\\\\n  registerTestWorkHandlers(sdk, double);\\\\n  return sdk;\\\\n}\\\\n\\\\nasync function drain(\\\\n  sdk: Lhc,\\\\n  filePath: string,\\\\n  opts?: { maxItems?: number },\\\\n): Promise<DrainReport> {\\\\n  const result = await sdk.work.drain({ filePath }, opts);\\\\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\\\\n  return result.value;\\\\n}\\\\n\\\\nfunction liveCount(filePath: string): number {\\\\n  const db = openRaw(filePath);\\\\n  try {\\\\n    return countLiveItems(db);\\\\n  } finally {\\\\n    db.close();\\\\n  }\\\\n}\\\\n\\\\nfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\\\\n  const db = openRaw(filePath);\\\\n  try {\\\\n    return queueDetail(db);\\\\n  } finally {\\\\n    db.close();\\\\n  }\\\\n}\\\\n\\\\ndescribe(\\\\\\\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\\\\\\\", () => {\\\\n  // Epic 02 Story 2 (sanctioned amendment): tool_call now queues\\\\n  // tool_call_summary, so this batch yields four items, not three.\\\\n  it(\\\\\\\"four items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    let tick = 0;\\\\n    const base = Date.parse(\\\\\\\"2026-06-10T12:00:00.000Z\\\\\\\");\\\\n    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\\\\n    const { filePath } = await newThread();\\\\n    await send(sdk, filePath, [\\\\n      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n      validEvent(\\\\\\\"tool_call\\\\\\\"),\\\\n      validEvent(\\\\\\\"tool_result\\\\\\\"),\\\\n      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n    ]);\\\\n    expect(liveCount(filePath)).toBe(4);\\\\n\\\\n    const report = await drain(sdk, filePath);\\\\n    // Queue order across owners: m1's smoothing, m2's call summary, m3's\\\\n    // result summary, then the turn derivation queued at close — never\\\\n    // reordered.\\\\n    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\\\\n      \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n      \\\\\\\"w-m2-tool_call_summary-v1\\\\\\\",\\\\n      \\\\\\\"w-m3-tool_result_summary-v1\\\\\\\",\\\\n      \\\\\\\"w-t1-turn_derivation-v1\\\\\\\",\\\\n    ]);\\\\n    expect(report.ran.map((entry) => entry.disposition)).toEqual([\\\\n      \\\\\\\"done\\\\\\\",\\\\n      \\\\\\\"done\\\\\\\",\\\\n      \\\\\\\"done\\\\\\\",\\\\n      \\\\\\\"done\\\\\\\",\\\\n    ]);\\\\n    expect(report.stoppedBecause).toBe(\\\\\\\"empty\\\\\\\");\\\\n    expect(report.remaining).toBe(0);\\\\n\\\\n    // DD-1 storage contract: terminal rows are gone — the report is the only\\\\n    // place the dispositions exist (raw zero-row read).\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n    const db = openRaw(filePath);\\\\n    try {\\\\n      const rows = db.prepare(\\\\\\\"SELECT COUNT(*) AS n FROM work_item\\\\\\\").get() as {\\\\n        n: number | bigint;\\\\n      };\\\\n      expect(Number(rows.n)).toBe(0);\\\\n    } finally {\\\\n      db.close();\\\\n    }\\\\n\\\\n    // Artifacts landed in run order: derivedAt strictly monotone with the\\\\n    // injected clock from m1 to m3 to the turn's forms.\\\\n    const forms = readDerivedForms(filePath);\\\\n    expect(forms.map((form) => form.state)).toEqual([\\\\n      \\\\\\\"ready\\\\\\\",\\\\n      \\\\\\\"ready\\\\\\\",\\\\n      \\\\\\\"ready\\\\\\\",\\\\n      \\\\\\\"ready\\\\\\\",\\\\n      \\\\\\\"ready\\\\\\\",\\\\n    ]);\\\\n    const at = (subjectId: string, form: string): number => {\\\\n      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\\\\n      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\\\\n      return Date.parse(row.derivedAt);\\\\n    };\\\\n    expect(at(\\\\\\\"m1\\\\\\\", \\\\\\\"smoothed_prompt\\\\\\\")).toBeLessThan(at(\\\\\\\"m3\\\\\\\", \\\\\\\"tool_result_summary\\\\\\\"));\\\\n    expect(at(\\\\\\\"m3\\\\\\\", \\\\\\\"tool_result_summary\\\\\\\")).toBeLessThan(at(\\\\\\\"t1\\\\\\\", \\\\\\\"turn_rendering\\\\\\\"));\\\\n    expect(at(\\\\\\\"t1\\\\\\\", \\\\\\\"turn_rendering\\\\\\\")).toBe(at(\\\\\\\"t1\\\\\\\", \\\\\\\"lower_band_projection\\\\\\\"));\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\\\\\\\", () => {\\\\n  it(\\\\\\\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    double.delayKind(\\\\\\\"prompt_smoothing\\\\\\\", 100);\\\\n    const sdk = createSdk({\\\\n      provider: double,\\\\n      mode: \\\\\\\"background\\\\\\\",\\\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n      lease: { durationMs: 1000 },\\\\n    });\\\\n    registerTestWorkHandlers(sdk, double);\\\\n    const { threadId, filePath } = await newThread();\\\\n\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"batch A\\\\\\\" } })]);\\\\n    // Let the poked drain start (it defers one macrotask), then queue two\\\\n    // more batches while item A's slow handler is in flight.\\\\n    await sleep(10);\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"batch B\\\\\\\" } })]);\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"batch C\\\\\\\" } })]);\\\\n\\\\n    await sdk.drainSettled({ filePath });\\\\n\\\\n    // Everything queued mid-drain was processed before the cycle ended…\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n    const smoothed = readDerivedForms(filePath).filter((f) => f.form === \\\\\\\"smoothed_prompt\\\\\\\");\\\\n    expect(smoothed.map((f) => f.state)).toEqual([\\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\"]);\\\\n    // …and the burst coalesced: one initial pass plus exactly one follow-up,\\\\n    // not one pass per poke (the cost model is the assertion).\\\\n    expect(sdk.scheduler.testPassCount(threadId)).toBe(2);\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"TC-1.5 / AC-1.5, AC-1.6: background mode — queueing is sufficient; first touch catches up\\\\\\\", () => {\\\\n  it(\\\\\\\"an intake batch is processed with no drain call; drainSettled is the completion signal\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = createSdk({\\\\n      provider: double,\\\\n      mode: \\\\\\\"background\\\\\\\",\\\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n      lease: { durationMs: 1000 },\\\\n    });\\\\n    registerTestWorkHandlers(sdk, double);\\\\n    const { filePath } = await newThread();\\\\n\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\"), validEvent(\\\\\\\"turn_end\\\\\\\")]);\\\\n    await sdk.drainSettled({ filePath });\\\\n\\\\n    const forms = readDerivedForms(filePath);\\\\n    expect(forms.map((f) => `${f.subjectId}/${f.form}/${f.state}`).sort()).toEqual([\\\\n      \\\\\\\"m1/smoothed_prompt/ready\\\\\\\",\\\\n      \\\\\\\"t1/lower_band_projection/ready\\\\\\\",\\\\n      \\\\\\\"t1/turn_rendering/ready\\\\\\\",\\\\n    ]);\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n  });\\\\n\\\\n  it(\\\\\\\"reopening a thread with leftover queued rows runs them on first touch — a read, not a write\\\\\\\", async () => {\\\\n    // Build the leftover state with no background scheduler installed: rows\\\\n    // accumulate exactly as a dead process would have left them.\\\\n    const { filePath } = await newThread();\\\\n    const seeded = await intakeStream.messageEvents({ filePath }, [\\\\n      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n    ]);\\\\n    expect(seeded.ok).toBe(true);\\\\n    expect(liveCount(filePath)).toBe(2);\\\\n\\\\n    const double = createProviderDouble();\\\\n    const sdk = createSdk({\\\\n      provider: double,\\\\n      mode: \\\\\\\"background\\\\\\\",\\\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n      lease: { durationMs: 1000 },\\\\n    });\\\\n    registerTestWorkHandlers(sdk, double);\\\\n\\\\n    // First touch of the thread in this process lifetime: a plain read.\\\\n    const read = await sdk.messages.listMessages({ filePath });\\\\n    expect(read.ok).toBe(true);\\\\n    await sdk.drainSettled({ filePath });\\\\n\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n    const states = readDerivedForms(filePath).map((f) => f.state);\\\\n    expect(states).toEqual([\\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\", \\\\\\\"ready\\\\\\\"]);\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"TC-1.6 / AC-1.7: manual mode — rows accumulate durably and run only when drain is invoked\\\\\\\", () => {\\\\n  it(\\\\\\\"queued work sits until work.drain; artifacts land after\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const { filePath } = await newThread();\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n\\\\n    await sleep(100);\\\\n    expect(liveCount(filePath)).toBe(1);\\\\n    expect(liveDetail(filePath)[0]?.status).toBe(\\\\\\\"queued\\\\\\\");\\\\n    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\\\\\\\"pending\\\\\\\"]);\\\\n\\\\n    const report = await drain(sdk, filePath);\\\\n    expect(report.ran).toHaveLength(1);\\\\n    expect(report.ran[0]?.disposition).toBe(\\\\\\\"done\\\\\\\");\\\\n    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\\\\\\\"ready\\\\\\\"]);\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"TC-1.7 / AC-1.8: an unregistered kind lands failed_terminal with a stable reason and the drain continues\\\\\\\", () => {\\\\n  it(\\\\\\\"a bogus-kind row ahead of a valid item fails with unknown_work_kind; the valid item still runs\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const { filePath } = await newThread();\\\\n\\\\n    // Raw row with an unregistered kind, queued ahead of any valid work.\\\\n    const db = openRaw(filePath);\\\\n    try {\\\\n      db.prepare(\\\\n        `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\\\\n         VALUES ('w-mX-bogus_kind-v1', 'messages', 'bogus_kind', '{\\\\\\\"messageId\\\\\\\":\\\\\\\"mX\\\\\\\"}', 'queued',\\\\n                 '2026-06-10T11:00:00.000Z')`,\\\\n      ).run();\\\\n    } finally {\\\\n      db.close();\\\\n    }\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n\\\\n    const report = await drain(sdk, filePath);\\\\n    expect(report.ran).toHaveLength(2);\\\\n    expect(report.ran[0]).toMatchObject({\\\\n      workItemId: \\\\\\\"w-mX-bogus_kind-v1\\\\\\\",\\\\n      disposition: \\\\\\\"failed_terminal\\\\\\\",\\\\n      reason: \\\\\\\"unknown_work_kind\\\\\\\",\\\\n    });\\\\n    expect(report.ran[1]).toMatchObject({\\\\n      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n      disposition: \\\\\\\"done\\\\\\\",\\\\n    });\\\\n    expect(report.stoppedBecause).toBe(\\\\\\\"empty\\\\\\\");\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \\\\\\\"m1\\\\\\\");\\\\n    expect(smoothed?.state).toBe(\\\\\\\"ready\\\\\\\");\\\\n  });\\\\n});\\\\n\\\\ndescribe(\\\\\\\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\\\\\\\", () => {\\\\n  it(\\\\\\\"fails twice then succeeds: artifact ready, report shows attempts=2\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const { filePath } = await newThread();\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n\\\\n    double.failNext(2, { retryable: true });\\\\n    const report = await drain(sdk, filePath);\\\\n    expect(report.ran).toHaveLength(1);\\\\n    expect(report.ran[0]).toMatchObject({\\\\n      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n      disposition: \\\\\\\"done\\\\\\\",\\\\n      attempts: 2,\\\\n    });\\\\n    expect(readDerivedForms(filePath)[0]?.state).toBe(\\\\\\\"ready\\\\\\\");\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n  });\\\\n\\\\n  it(\\\\\\\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const { filePath } = await newThread();\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\"), validEvent(\\\\\\\"turn_end\\\\\\\")]);\\\\n\\\\n    double.failKind(\\\\\\\"prompt_smoothing\\\\\\\", 99, {\\\\n      retryable: true,\\\\n      reason: \\\\\\\"scripted exhaustion (smoothPrompt)\\\\\\\",\\\\n    });\\\\n    const report = await drain(sdk, filePath);\\\\n    expect(report.ran).toHaveLength(2);\\\\n    expect(report.ran[0]).toMatchObject({\\\\n      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n      disposition: \\\\\\\"failed_terminal\\\\\\\",\\\\n      attempts: 3,\\\\n      reason: \\\\\\\"scripted exhaustion (smoothPrompt)\\\\\\\",\\\\n    });\\\\n    expect(report.ran[1]).toMatchObject({\\\\n      workItemId: \\\\\\\"w-t1-turn_derivation-v1\\\\\\\",\\\\n      disposition: \\\\\\\"done\\\\\\\",\\\\n    });\\\\n\\\\n    const forms = readDerivedForms(filePath);\\\\n    const failed = forms.find((f) => f.form === \\\\\\\"smoothed_prompt\\\\\\\");\\\\n    expect(failed?.state).toBe(\\\\\\\"failed\\\\\\\");\\\\n    expect(failed?.reason).toBe(\\\\\\\"scripted exhaustion (smoothPrompt)\\\\\\\");\\\\n    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\\\\n    expect(failed?.metadata?.attempts).toBe(3);\\\\n    expect(forms.find((f) => f.form === \\\\\\\"turn_rendering\\\\\\\")?.state).toBe(\\\\\\\"ready\\\\\\\");\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n  });\\\\n\\\\n  it(\\\\\\\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    let nowMs = Date.parse(\\\\\\\"2026-06-10T12:00:00.000Z\\\\\\\");\\\\n    const sdk = manualSdk(double, {\\\\n      clock: () => new Date(nowMs),\\\\n      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\\\\n    });\\\\n    const { filePath } = await newThread();\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\"), validEvent(\\\\\\\"turn_end\\\\\\\")]);\\\\n\\\\n    double.failNext(1, { retryable: true });\\\\n    const first = await drain(sdk, filePath);\\\\n    // The head failed once and is backing off: nothing terminal ran, the\\\\n    // drain stopped on the eligibility gate, and the queue behind the head\\\\n    // was not touched.\\\\n    expect(first.ran).toEqual([]);\\\\n    expect(first.stoppedBecause).toBe(\\\\\\\"waiting\\\\\\\");\\\\n    expect(first.remaining).toBe(2);\\\\n    expect(first.waitingUntil).toBeDefined();\\\\n    expect(Date.parse(first.waitingUntil ?? \\\\\\\"\\\\\\\")).toBeGreaterThan(nowMs);\\\\n\\\\n    const detail = liveDetail(filePath);\\\\n    expect(detail).toHaveLength(2);\\\\n    expect(detail[0]).toMatchObject({\\\\n      workItemId: \\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\",\\\\n      status: \\\\\\\"queued\\\\\\\",\\\\n      attempts: 1,\\\\n    });\\\\n    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\\\\n    // Skip-ahead proof: the eligible item behind the backing-off head was\\\\n    // never claimed.\\\\n    expect(detail[1]).toMatchObject({\\\\n      workItemId: \\\\\\\"w-t1-turn_derivation-v1\\\\\\\",\\\\n      status: \\\\\\\"queued\\\\\\\",\\\\n      attempts: 0,\\\\n    });\\\\n    expect(detail[1]?.claimedAt).toBeUndefined();\\\\n\\\\n    // Pass the gate: the head becomes eligible and the queue drains in order.\\\\n    nowMs += 60000;\\\\n    const second = await drain(sdk, filePath);\\\\n    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\\\\n      [\\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\", \\\\\\\"done\\\\\\\"],\\\\n      [\\\\\\\"w-t1-turn_derivation-v1\\\\\\\", \\\\\\\"done\\\\\\\"],\\\\n    ]);\\\\n    expect(second.ran[0]?.attempts).toBe(1);\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n  });\\\\n\\\\n  it(\\\\\\\"a non-retryable provider failure is terminal immediately\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const { filePath } = await newThread();\\\\n    await send(sdk, filePath, [validEvent(\\\\\\\"user_prompt\\\\\\\")]);\\\\n\\\\n    double.failNext(1, { retryable: false, reason: \\\\\\\"content refusal (scripted)\\\\\\\" });\\\\n    const report = await drain(sdk, filePath);\\\\n    expect(report.ran[0]).toMatchObject({\\\\n      disposition: \\\\\\\"failed_terminal\\\\\\\",\\\\n      attempts: 1,\\\\n      reason: \\\\\\\"content refusal (scripted)\\\\\\\",\\\\n    });\\\\n    expect(readDerivedForms(filePath)[0]?.state).toBe(\\\\\\\"failed\\\\\\\");\\\\n    expect(liveCount(filePath)).toBe(0);\\\\n  });\\\\n\\\\n  it(\\\\\\\"maxItems stops the drain with max_items and reports the remainder\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const { filePath } = await newThread();\\\\n    await send(sdk, filePath, [\\\\n      validEvent(\\\\\\\"user_prompt\\\\\\\"),\\\\n      validEvent(\\\\\\\"tool_call\\\\\\\"),\\\\n      validEvent(\\\\\\\"tool_result\\\\\\\"),\\\\n      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n    ]);\\\\n\\\\n    const report = await drain(sdk, filePath, { maxItems: 1 });\\\\n    expect(report.ran).toHaveLength(1);\\\\n    expect(report.stoppedBecause).toBe(\\\\\\\"max_items\\\\\\\");\\\\n    // 3 behind the stop since Epic 02 Story 2: tool_call queues its summary\\\\n    // (sanctioned amendment — was 2).\\\\n    expect(report.remaining).toBe(3);\\\\n    expect(liveCount(filePath)).toBe(3);\\\\n  });\\\\n});\\\\n\\\",\\\"numLines\\\":463,\\\"startLine\\\":1,\\\"totalLines\\\":463}}}\\n./packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/fix/streams/004-fix-result.stdout.log:903:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_019WoeVHoRgECDzpjgUuRUrz\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"<persisted-output>\\\\nOutput too large (142.6KB). Full output saved to: /Users/leemoore/.claude/projects/-Users-leemoore-code-pi-long-horizon-liminal-context/d9c65f8a-2769-45ee-8250-eab6f8fa0e38/tool-results/b17022gxq.txt\\\\n\\\\nPreview (first 2KB):\\\\n=== E02-NB-001 anywhere ===\\\\ndocs/02-specs/02-derivation-pipeline/team-impl-log.md:137:  - Non-blocking recorded (not in this batch): E02-NB-001 clock bypass in mutations/requeue; NB-003 deterministic provider only registered provider; NB-004 thrown handler errors → retryable; NB-005 attempts accounting inconsistency.\\\\ndocs/02-specs/02-derivation-pipeline/team-impl-log.md:146:- 09:29Z epic-reverify (002, fable-5): outcome **needs-fixes**. BLOCK-001/BLOCK-002 resolved. NEW: REVERIFY-02-001 (blocking-candidate) — cascadeTurnDelete missed the pair-counterpart cascade (third caller of DD-8's module; cross-turn pairs reachable, dynamically verified end-to-end). Retained non-blocking: E02-NB-001 (clock bypass), NB-003 (deterministic-only provider, by design), NB-004 (thrown→retryable, documented), NB-005 (attempts asymmetry).\\\\ndocs/02-specs/02-derivation-pipeline/artifacts/epic/001-epic-review.json:1:{\\\\\\\"command\\\\\\\":\\\\\\\"epic-review\\\\\\\",\\\\\\\"version\\\\\\\":1,\\\\\\\"status\\\\\\\":\\\\\\\"blocked\\\\\\\",\\\\\\\"outcome\\\\\\\":\\\\\\\"block\\\\\\\",\\\\\\\"result\\\\\\\":{\\\\\\\"outcome\\\\\\\":\\\\\\\"block\\\\\\\",\\\\\\\"canonicalReview\\\\\\\":{\\\\\\\"outcome\\\\\\\":\\\\\\\"block\\\\\\\",\\\\\\\"reviewerLabels\\\\\\\":[\\\\\\\"epic-reviewer-1\\\\\\\",\\\\\\\"epic-reviewer-2\\\\\\\"],\\\\\\\"reconciliationSummary\\\\\\\":\\\\\\\"Two reviewers split: epic-reviewer-1 (claude-code) returned pass with five non-blocking findings; epic-reviewer-2 (codex) returned block with two majors, both verified dynamically. Independent re-verification against the code confirms both blockers, so the conservative rule holds and neither is downgraded. (1) Mode isolation: both reviewers found the same defect — reviewer-1 as minor E02-NB-002, reviewer-2 as blocking EPIC-02-BLOCK-001. Code confirms it: sdk.ts:254-257 installs the process-global scheduler poke and thread-touch seams only in background mode and manual mode 'leaves the slots alone'; shared/context.ts:40-48 holds module-global slots that nothing clears; work-queue enqueue (index.ts:136) unconditionally registers onCommit(() => fireSchedulerPoke(threadId)). A manual SDK constructed after a background SDK therefore drains automatically through the sta\\\\n...\\\\n</persisted-output>\\\",\\\"is_error\\\":false}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"d9c65f8a-2769-45ee-8250-eab6f8fa0e38\\\",\\\"uuid\\\":\\\"d74b1854-fe16-4260-8048-aad415ea88e2\\\",\\\"timestamp\\\":\\\"2026-06-11T10:00:46.354Z\\\",\\\"tool_use_result\\\":{\\\"stdout\\\":\\\"=== E02-NB-001 anywhere ===\\\\ndocs/02-specs/02-derivation-pipeline/team-impl-log.md:137:  - Non-blocking recorded (not in this batch): E02-NB-001 clock bypass in mutations/requeue; NB-003 deterministic provider only registered provider; NB-004 thrown handler errors → retryable; NB-005 attempts accounting inconsistency.\\\\ndocs/02-specs/02-derivation-pipeline/team-impl-log.md:146:- 09:29Z epic-reverify (002, fable-5): outcome **needs-fixes**. BLOCK-001/BLOCK-002 resolved. NEW: REVERIFY-02-001 (blocking-candidate) — cascadeTurnDelete missed the pair-counterpart cascade (third caller of DD-8's module; cross-turn pairs reachable, dynamically verified end-to-end). Retained non-blocking: E02-NB-001 (clock bypass), NB-003 (deterministic-only provider, by design), NB-004 (thrown→retryable, documented), NB-005 (attempts asymmetry).\\\\ndocs/02-specs/02-derivation-pipeline/artifacts/epic/001-epic-review.json:1:{\\\\\\\"command\\\\\\\":\\\\\\\"epic-review\\\\\\\",\\\\\\\"version\\\\\\\":1,\\\\\\\"status\\\\\\\":\\\\\\\"blocked\\\\\\\",\\\\\\\"outcome\\\\\\\":\\\\\\\"block\\\\\\\",\\\\\\\"result\\\\\\\":{\\\\\\\"outcome\\\\\\\":\\\\\\\"block\\\\\\\",\\\\\\\"canonicalReview\\\\\\\":{\\\\\\\"outcome\\\\\\\":\\\\\\\"block\\\\\\\",\\\\\\\"reviewerLabels\\\\\\\":[\\\\\\\"epic-reviewer-1\\\\\\\",\\\\\\\"epic-reviewer-2\\\\\\\"],\\\\\\\"reconciliationSummary\\\\\\\":\\\\\\\"Two reviewers split: epic-reviewer-1 (claude-code) returned pass with five non-blocking findings; epic-reviewer-2 (codex) returned block with two majors, both verified dynamically. Independent re-verification against the code confirms both blockers, so the conservative rule holds and neither is downgraded. (1) Mode isolation: both reviewers found the same defect — reviewer-1 as minor E02-NB-002, reviewer-2 as blocking EPIC-02-BLOCK-001. Code confirms it: sdk.ts:254-257 installs the process-global scheduler poke and thread-touch seams only in background mode and manual mode 'leaves the slots alone'; shared/context.ts:40-48 holds module-global slots that nothing clears; work-queue enqueue (index.ts:136) unconditionally registers onCommit(() => fireSchedulerPoke(threadId)). A manual SDK constructed after a background SDK therefore drains automatically through the stale background scheduler, violating AC-1.7's manual-mode contract. The sdk.ts comment explicitly contemplates multi-SDK-per-process (background supersedes background), so the background-then-manual sequence is inside the design's contemplated space, not an unsupported configuration. The two findings are merged into one blocking finding; reviewer-1's minor classification is the material disagreement, resolved conservatively toward the dynamically verified blocker. (2) Deleted-pair outcomes: only reviewer-2 found EPIC-02-BLOCK-002, and every step of its claimed code path verifies: findPairedBlock (messages/internal/forms.ts:163-178) joins message with no deleted_at IS NULL filter — an unsanctioned exception to tech-design Part 3b's deleted-read filter rule, which names exactly two exceptions, neither of them the pairing read; toolCallSummaryHandler (handlers.ts:98-105) stamps outcome from that unfiltered read, so a tool_call_summary requeued after its paired result is deleted rebuilds outcome 'succeeded' from a record no longer in the readable record (against AC-2.4's no-paired-result→unknown and AC-6.1); cascadeMessageDelete (cascade.ts:209-215) drops the deleted message's own forms and clears upward only, never touching the paired counterpart's summary; and compose.ts:150-153 prefers the ready summary's stale metadata over its own mechanical outcomeFromRecord fallback, so the delete cascade's own rendering rebuild republishes the stale outcome. This partially invalidates reviewer-1's cross-story claim that the deleted-read filter is applied at every read site with only sanctioned exceptions. There is genuine spec tension behind the cascade half — AC-6.2's 'nothing else changes' excludes the counterpart summary from the cascade while AC-2.8 establishes the pair as the summary's source — carried as an unresolved item needing a human ruling; the missing read filter is an unambiguous defect regardless of that ruling. Reviewer-1's remaining non-blocking findings (E02-NB-001 wall-clock in mutations confirmed at five runInTransaction(db, () => new Date()) sites; E02-NB-003 deterministic-only registry confirmed in providers/registry.ts; E02-NB-004 thrown-handler-to-retryable confirmed at scheduler.ts:139-145; E02-NB-005 attempts asymmetry confirmed at scheduler.ts:119-125 vs 158-165) are all supported and retained. Epic gate re-run independently: pnpm run verify-all exit 0 (build, typecheck, lint, boundaries, 29 test files, 231 tests) — a passing gate does not offset the confirmed blockers, since the missing coverage (cross-SDK mode isolation, delete of a paired tool result) is exactly why the suite stays green.\\\\\\\",\\\\\\\"crossStoryFindings\\\\\\\":[\\\\\\\"Confirmed: manual/background mode isolation does not survive SDK sequencing within one process. Background-mode construction installs process-global scheduler poke and thread-touch seams (sdk.ts:254-257, shared/context.ts:40-48) that a later manual-mode SDK never clears, and every enqueue unconditionally fires the global poke post-commit (work-queue/index.ts:136), so work queued through a manual SDK drains automatically through the leftover background scheduler — with that scheduler's provider and config — without any drain call.\\\\\\\",\\\\\\\"Confirmed: the deletion flow does not compose with paired tool-call/tool-result derivation. The pairing read crosses the deleted-read filter discipline (findPairedBlock has no deleted_at filter), the delete cascade never clears the paired counterpart's tool_call_summary even though AC-2.8 makes the pair the summary's source, and turn-rendering composition (compose.ts:150-153) trusts the stale ready summary's metadata over its own record-derived fallback — so a deleted tool result's outcome survives into rebuilt renderings and even into an explicit post-delete requeue of the summary.\\\\\\\",\\\\\\\"The story chain otherwise composes into one coherent mechanism: enqueue is the single creation point for derived_form rows, completion is UPDATE-only and source-version-checked, handlers return form writes as data, report/requeue join live work_item rows, and all three mutations reuse the identical enqueue/supersede/version machinery through the one shared cascade module (DD-8), with turns.deleteTurn reaching it only via the messages domain's public surface.\\\\\\\",\\\\\\\"The deleted-read filter rule is applied at the membership and read-back sites introduced across Stories 3-6 (message reads, member projections, chunk rows, turn reads), but reviewer-1's claim that every read site complies with only sanctioned exceptions is corrected by the confirmed blocker: the call-id pairing read is an unfiltered read of message content that the tech design's two-exception list does not sanction.\\\\\\\",\\\\\\\"Work-item identity (w-<sourceId>-<kind>-v<sourceVersion>), the DD-1 five-disposition contract, and the DD-3 stale-discard truth table hold consistently across intake queueing, drain, repair requeues, and the mutation cascade's replacement enqueues.\\\\\\\"],\\\\\\\"architectureFindings\\\\\\\":[\\\\\\\"Confirmed drift from the architecture contract: mode selection is declared per SDK instance (DD-4: hosts see mode at construction) but enforced through process-global mutable hooks, so the mode contract is only as strong as the last background construction in the process; manual mode's AC-1.7 guarantee is not enforceable by the manual instance itself. The fix needs a small design decision — clear the slots on manual construction, scope the seams per SDK instance, or refuse multi-SDK construction — though all variants are mechanically small.\\\\\\\",\\\\\\\"Confirmed: the deleted-read filter discipline (tech design Part 3b) misses the tool pairing read path, and the mutation cascade's scope (derived structurally from the message→turn→chunk walk in cascade.ts) cannot reach the paired counterpart's summary, which the derivation architecture (AC-2.8, outcome stamping from the pair) makes a real source dependency. The epic's own cascade-scope table ('nothing else changes') conflicts with the pair-as-source model AC-2.8 introduced — a spec-level gap, not just an implementation one.\\\\\\\",\\\\\\\"Module placement otherwise matches the tech design with two approved, recorded renames (turn handlers in turns/internal/derive.ts; scheduler seams in shared/context.ts to avoid an import cycle, DD-5 semantics preserved); migration v5 implements the schema faithfully including the F-02 backfill; claimNext is the single atomic UPDATE under BEGIN IMMEDIATE with structural never-skip-ahead; provider calls never run inside a transaction; the DD-9 chunk close policy reads only stored projected-token values, which is what makes TC-3.9 replay determinism hold.\\\\\\\",\\\\\\\"Minor drift retained from reviewer-1: createSdk's injected clock governs drain and scheduler timestamps, but mutation and requeue operations construct their own wall clock (five runInTransaction(db, () => new Date(), ...) sites in messages/index.ts and turns/index.ts), so deterministic time injection does not extend to the mutation surfaces (E02-NB-001).\\\\\\\"],\\\\\\\"epicCoverageAssessment\\\\\\\":[\\\\\\\"Epic gate independently re-run for this canonical review: pnpm run verify-all from packages/lhc exits 0 — build, typecheck, lint (75 files), boundary check, and 29 test files / 231 tests all green, including the LHC_PROCESS_SUITE spawned-process fixtures (TC-1.3 SIGKILL restart survival, TC-1.4 cross-process claim exclusion).\\\\\\\",\\\\\\\"All 46 TC ids appear verbatim in test titles and all 47 ACs trace to implemented behavior per reviewer-1's file-level audit; the four architecture-risk tests named by the test plan (TC-1.3, TC-1.4, TC-5.4, TC-3.9) are present and green; CLI parity surfaces call the same domain operations with the same validation and result JSON.\\\\\\\",\\\\\\\"Two coverage gaps correspond exactly to the confirmed blockers: no test constructs a background SDK followed by a manual SDK in one process (the AC-1.7 isolation case), and no test deletes or edits a tool result whose paired call summary already landed (the AC-2.4/AC-6.2 pairing case). Both blockers' fix paths must add these tests.\\\\\\\"],\\\\\\\"productionPathFindings\\\\\\\":[\\\\\\\"No fake adapters, stubs, placeholders, or silent provider defaults: CLI drain requires --provider or LHC_PROVIDER and fails closed with provider_not_configured; the deterministic provider is explicit-only per DD-11 and is currently the sole registered named provider (real adapters are an explicit epic scope exclusion — operators need a future adapter registration for real inference; E02-NB-003).\\\\\\\",\\\\\\\"Material production-path issue confirmed: in any process that ever constructed a background SDK, a subsequently constructed manual SDK silently behaves as background — its enqueues drain through the stale scheduler with the prior SDK's provider and config (EPIC-02-BLOCK-001).\\\\\\\",\\\\\\\"Material production-path issue confirmed: the tool pairing read returns deleted messages, so production drains and explicit requeues can land ready forms whose mechanically stamped outcomes derive from records outside the readable record (EPIC-02-BLOCK-002).\\\\\\\",\\\\\\\"Test seams compiled into production modules (intake walk hook/clock, scheduler testPassCount) are inert in production assembly and documented in place; background scheduling is gated fail-closed on hasAnyHandler; thrown handler errors are deliberately softened to retryable attempts to keep the queue from wedging (scheduler.ts:139-145, E02-NB-004).\\\\\\\"],\\\\\\\"blockingFindings\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"EPIC-02-BLOCK-001\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"major\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Manual SDK mode can auto-drain after background SDK construction in the same process\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"Confirmed in code (and dynamically by epic-reviewer-2; reviewer-1 independently found the same defect as E02-NB-002). createSdk installs the process-wide seams only for background mode and manual mode leaves them installed (packages/lhc/src/sdk.ts:254-257: installSchedulerPoke / setThreadTouch under `if (resolved.mode === \\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\")`, with the comment documenting only background-supersedes-background); the slots are module globals nothing else clears (packages/lhc/src/shared/context.ts:40-48); enqueue unconditionally registers ctx.onCommit(() => fireSchedulerPoke(ctx.threadId)) (packages/lhc/src/tech-utils/work-queue/index.ts:136); the background scheduler responds to the poke by draining (packages/lhc/src/scheduler.ts:315-319). Result: after `createSdk({mode:\\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\"})` then `createSdk({mode:\\\\\\\\\\\\\\\"manual\\\\\\\\\\\\\\\"})`, work queued via the manual SDK runs without any drain call, through the stale scheduler's provider and config — violating AC-1.7 ('queued work accumulates durably and does not run until the drain operation is invoked'). Reviewer-2 reproduced it end-to-end: w-m1-prompt_smoothing-v1 queued via the manual SDK drained with no manual drain invocation. Retained blocking per the conservative rule: the code confirms rather than disproves the blocker; assumption A3 narrows real-world exposure but the design itself contemplates multiple SDK constructions per process.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/sdk.ts\\\\\\\",\\\\\\\"packages/lhc/src/shared/context.ts\\\\\\\",\\\\\\\"packages/lhc/src/tech-utils/work-queue/index.ts\\\\\\\",\\\\\\\"packages/lhc/src/scheduler.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-1.7\\\\\\\",\\\\\\\"DD-4\\\\\\\",\\\\\\\"DD-5\\\\\\\",\\\\\\\"tech-design.md Flow 1\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"quick-fix\\\\\\\",\\\\\\\"blocking\\\\\\\":true},{\\\\\\\"id\\\\\\\":\\\\\\\"EPIC-02-BLOCK-002\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"major\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Deleted tool results still determine tool-call outcomes through the unfiltered pairing read and an uncascaded counterpart summary\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"Confirmed in code at every step of reviewer-2's claimed path. (1) findPairedBlock joins message with no deleted_at IS NULL (packages/lhc/src/domains/messages/internal/forms.ts:163-178) — an unsanctioned exception to tech design Part 3b's deleted-read filter rule, which names exactly two exceptions (event read-back, mutation validation's filtered existence check), not the pairing read. (2) toolCallSummaryHandler stamps the summary's outcome from that read (packages/lhc/src/domains/messages/internal/handlers.ts:98-105), so an explicit requeue of tool_call_summary after the paired tool_result is deleted rebuilds outcome 'succeeded' from a record no longer in the readable record — against AC-2.4's mechanical rule (no paired result → unknown) read with AC-6.1 (a deleted message no longer appears in reads). (3) cascadeMessageDelete drops the deleted message's own forms and clears only upward (turn, chunk) — the paired call's summary on a different message is never cleared (packages/lhc/src/domains/messages/internal/cascade.ts:209-215). (4) Composition prefers the ready summary's stale metadata over its own record-derived outcome fallback (packages/lhc/src/domains/turns/internal/compose.ts:150-153), so the delete cascade's own turn-rendering rebuild republishes the stale 'succeeded' while the rendering's membership correctly excludes the deleted result. The read-filter half is an unambiguous defect; the cascade half sits on a spec conflict between AC-6.2's 'nothing else changes' and AC-2.8's pair-as-source rule, carried as an unresolved item for a ruling.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/domains/messages/internal/forms.ts\\\\\\\",\\\\\\\"packages/lhc/src/domains/messages/internal/handlers.ts\\\\\\\",\\\\\\\"packages/lhc/src/domains/messages/internal/cascade.ts\\\\\\\",\\\\\\\"packages/lhc/src/domains/turns/internal/compose.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-2.4\\\\\\\",\\\\\\\"AC-2.8\\\\\\\",\\\\\\\"AC-6.1\\\\\\\",\\\\\\\"AC-6.2\\\\\\\",\\\\\\\"tech-design.md Part 3b deleted-read filter rule\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"fresh-fix-path\\\\\\\",\\\\\\\"blocking\\\\\\\":true}],\\\\\\\"nonBlockingFindings\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-001\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"minor\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Mutation and requeue operations bypass the SDK-injected clock\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"Confirmed: five sites call runInTransaction(db, () => new Date(), threadId, ...) — messages/index.ts:331, 421, 503 and turns/index.ts:356, 433 — so deleted_at stamps and requeued items' queuedAt use wall time regardless of SdkConfig.clock, which governs only drain/scheduler paths. Deterministic time injection does not extend to the mutation surfaces.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/domains/messages/index.ts\\\\\\\",\\\\\\\"packages/lhc/src/domains/turns/index.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"DD-7\\\\\\\",\\\\\\\"AC-5.1\\\\\\\",\\\\\\\"AC-6.1\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"quick-fix\\\\\\\",\\\\\\\"blocking\\\\\\\":false},{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-003\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"observation\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Deterministic provider is the only registered production provider\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"Confirmed: src/providers/registry.ts registers exactly one name ('deterministic'). Real adapters are explicitly out of epic scope and DD-11 sanctions the double's registry placement with no default, so this is by design — but until a real adapter lands, lhc work drain in production can only produce marked deterministic artifacts, selected by explicit operator opt-in.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/providers/registry.ts\\\\\\\",\\\\\\\"packages/lhc/src/providers/deterministic.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"DD-11\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"human-ruling\\\\\\\",\\\\\\\"blocking\\\\\\\":false},{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-004\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"observation\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Thrown handler errors are converted to retryable attempts\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"Confirmed at scheduler.ts:139-145: drainOpenDb catches a throwing handler and routes it through failAttempt as { retryable: true }, consuming retry budget before landing failed. The error contract says bugs throw and are not contract outcomes; this deliberately softens that to protect the queue from wedging (documented in place). Reasonable trade-off, but a deterministic handler bug is retried twice before surfacing.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/scheduler.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-1.9\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"human-ruling\\\\\\\",\\\\\\\"blocking\\\\\\\":false},{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-005\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"observation\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Inconsistent attempts accounting between terminal paths\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"Confirmed: the unknown-kind terminal path stamps attempts: item.attempts (scheduler.ts:119-125) while the blocked-source terminal path stamps attempts: item.attempts + 1 (scheduler.ts:159-165). Cosmetic — the value only feeds the drain report and the form's failure metadata, and unknown-kind items never ran a handler — but the asymmetry is undocumented.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/scheduler.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-1.8\\\\\\\",\\\\\\\"AC-1.9\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"quick-fix\\\\\\\",\\\\\\\"blocking\\\\\\\":false}],\\\\\\\"unresolvedItems\\\\\\\":[\\\\\\\"Cascade contract ruling needed for paired tool-call/tool-result dependencies: AC-6.2's exhaustive cascade scope ('nothing else changes') conflicts with AC-2.8's pair-as-source model. Decide whether deleting (or editing) one half of a call/result pair must clear and requeue the counterpart's summary, and update the epic's cascade-scope table either way. The findPairedBlock deleted-read filter fix is unambiguous and should not wait on this ruling.\\\\\\\",\\\\\\\"Design ruling needed on the mode-isolation fix shape for EPIC-02-BLOCK-001: clear the process-global seams on manual-mode construction, scope the poke/touch seams per SDK instance, or refuse multi-SDK construction per process — all small, but the choice affects the documented multi-SDK semantics in sdk.ts.\\\\\\\"],\\\\\\\"gateResult\\\\\\\":\\\\\\\"pass\\\\\\\"},\\\\\\\"verifierResults\\\\\\\":[{\\\\\\\"resultId\\\\\\\":\\\\\\\"2d547875-7ffc-45f0-93a6-e3694e338243\\\\\\\",\\\\\\\"outcome\\\\\\\":\\\\\\\"pass\\\\\\\",\\\\\\\"provider\\\\\\\":\\\\\\\"claude-code\\\\\\\",\\\\\\\"model\\\\\\\":\\\\\\\"claude-fable-5\\\\\\\",\\\\\\\"reviewerLabel\\\\\\\":\\\\\\\"epic-reviewer-1\\\\\\\",\\\\\\\"crossStoryFindings\\\\\\\":[\\\\\\\"The story chain composes into one coherent mechanism with no reimplementation across stories: enqueue (Story 0) is the single creation point for derived_form rows, completion is UPDATE-only and source-version-checked in the queue util (Story 1), handlers return form writes as data (Stories 2-3), report/requeue join the same live work_item rows (Story 4), and mutations reuse the identical enqueue/supersede/version machinery (Stories 5-6).\\\\\\\",\\\\\\\"DD-8's one-cascade rule held across stories: messages/internal/cascade.ts serves edit, message delete, and turn delete; turns.deleteTurn reaches it only through the messages domain's public surface (applyTurnDeleteCascade), and the boundary script confirms no cross-domain internal imports anywhere.\\\\\\\",\\\\\\\"The deleted-read filter rule is applied consistently at every read site introduced across Stories 3-6: readMessages, readMutableMessage, readMemberMessages, readMemberProjections, readChunkRows, readTurns (both membership and turn rows), and readMutableTurn all append deleted_at IS NULL; the two sanctioned exceptions (event read-back and the handlers' readMessageSource) are deliberate and documented in place.\\\\\\\",\\\\\\\"Drain report dispositions match DD-1's five-disposition contract exactly across the scheduler, queue util, and mutation results: done/stale_discarded/failed_terminal appear only in drain reports, superseded appears only on MutationResult, and terminal rows are deleted in the same transaction that records their outcome.\\\\\\\",\\\\\\\"Work-item identity (w-<sourceId>-<kind>-v<sourceVersion>) is honored consistently by intake queueing, the AC-2.8 late-result requeue, both owners' repair requeues, and the mutation cascade's replacement enqueues, so the DD-3 stale-discard truth table holds at every write path I traced.\\\\\\\",\\\\\\\"All implementation-time deviations are recorded and ruled in the team impl log (5 in Story 0, 7 in Story 1, 5 in Story 2, 3 in Story 3, the rejected-then-fixed AC-4.7 set in Story 4, 4 in Story 5, 2 in Story 6); I found no unrecorded drift between the code and the rulings.\\\\\\\"],\\\\\\\"architectureFindings\\\\\\\":[\\\\\\\"Module placement matches the tech design with two approved, recorded renames: turn handlers live in turns/internal/derive.ts rather than handlers.ts (Story 3 ruling), and the scheduler poke/touch seams live in shared/context.ts rather than the scheduler module to avoid an import cycle (Story 0 ruling, DD-5 semantics preserved).\\\\\\\",\\\\\\\"Migration v5 implements the tech-design schema faithfully, including the F-02 backfill of pending form rows for pre-v5 queued items, plus the approved deviation that idx_work_item_queue omits rowid (SQLite forbids rowid in index definitions; claimNext's ORDER BY rowid preserves head-first semantics).\\\\\\\",\\\\\\\"claimNext is the single atomic UPDATE under BEGIN IMMEDIATE specified in Part 3b, with the head re-read classifying empty/in_flight/waiting and the reclaim CASE incrementing attempts; the never-skip-ahead rule is structural, not procedural.\\\\\\\",\\\\\\\"Provider calls never run inside a transaction: handlers receive openDb() for short reads, return form writes as data, and the queue util owns the completion transaction; the onApplied hook makes chunk placement and summary enqueues ride the same completion commit, so a crash leaves either a placed turn with queued summaries or nothing.\\\\\\\",\\\\\\\"The chunk close policy implements DD-9's accumulation rule (close at accumulated + incoming >= target with the incoming turn starting the next chunk, single turn >= max closes its own chunk, empty chunks always accept) over stored projected-token values only, which is what makes TC-3.9 replay determinism hold.\\\\\\\",\\\\\\\"The tech design said the boundary script would gain a scheduler allowed-import line; none was added because none is needed — scheduler.ts imports only domain public indexes, which the existing rules permit. The protection the design wanted exists; the specific mechanism was moot.\\\\\\\",\\\\\\\"Minor drift: createSdk's injected clock governs drain and scheduler timestamps, but the mutation and requeue operations construct their own wall clock (runInTransaction(db, () => new Date(), ...)) for deleted_at and queuedAt stamps, so deterministic time injection does not extend to the mutation surfaces (see non-blocking finding E02-NB-001).\\\\\\\"],\\\\\\\"epicCoverageAssessment\\\\\\\":[\\\\\\\"Epic gate pnpm run verify-all passed from packages/lhc with exit 0: 29 test files, 231 tests, including the LHC_PROCESS_SUITE=1 spawned-process suite covering the architecture-risk fixtures (TC-1.3 SIGKILL restart survival, TC-1.4 cross-process claim exclusion).\\\\\\\",\\\\\\\"All 46 TC ids from the epic appear verbatim in test titles across the suites (TC-1.1 through TC-6.8, plus Epic 01's TC-2.9 kind-gate amendment), matching the test plan's file mapping; the suite grew from Epic 01's 118 tests to 231, exceeding the plan's 60-70 estimate.\\\\\\\",\\\\\\\"All 47 ACs trace to implemented behavior I read directly: queue execution and both host modes (scheduler.ts, work-queue), message derivation with mechanically stamped outcomes (handlers.ts, outcome.ts), turn composition with gap recording and deterministic chunking (derive.ts, compose.ts, chunks.ts), report/repair with blocked refusal and requeue idempotency (both owners' index.ts and forms.ts), and the three mutations with one-transaction cascade, supersede, and stale-write fencing (cascade.ts, store.ts).\\\\\\\",\\\\\\\"The four architecture-risk tests named by the test plan (TC-1.3, TC-1.4, TC-5.4, TC-3.9) are all present and green in the gate run.\\\\\\\",\\\\\\\"CLI parity is real: every SDK surface (drain, report, requeue, edit, delete message, delete turn) has a CLI command that calls the same domain operation with the same validation and result JSON, and the CLI drain assembles a manual-mode SDK through createSdk rather than an in-process shortcut.\\\\\\\"],\\\\\\\"productionPathFindings\\\\\\\":[\\\\\\\"No fake adapters, stubs, placeholders, or TODO/FIXME markers exist anywhere in src/; every handler, mutation, and read path is real execution against real SQLite state.\\\\\\\",\\\\\\\"The deterministic provider ships in production source (src/providers/deterministic.ts) and is registered in the production named-provider registry. This is explicitly sanctioned by DD-11 and an approved Story 1 ruling: it is selectable only by explicit name (--provider deterministic / LHC_PROVIDER=deterministic), is never a default, and exists so spawned-CLI tests exercise the production resolution seam. A drain without a resolvable provider fails with provider_not_configured naming the flag and env var — fail-closed, never a silent no-op.\\\\\\\",\\\\\\\"The deterministic provider is currently the ONLY registered named provider, so a production CLI drain can only produce marked deterministic artifacts today. This is consistent with the epic's explicit scope exclusion (real provider adapters are out of scope; this epic ships the seam and the double), but operators should understand real inference requires a future adapter registration.\\\\\\\",\\\\\\\"Test seams compiled into production modules: setIntakeWalkHook and setIntakeClock in intake-stream/internal/pipeline.ts (Epic 01 carryover, set only through test fixtures, explicit-argument-wins), and Scheduler.testPassCount plus the passes counter in scheduler.ts (documented test-only observability, not API). All are inert in production assembly and documented in place; none fakes an execution path.\\\\\\\",\\\\\\\"Background-mode scheduling is gated fail-closed on hasAnyHandler so an empty handler map can never turn queued rows into failed_terminal; in the shipped assembly both domains register real handlers, so the gate is always open in production.\\\\\\\"],\\\\\\\"blockingFindings\\\\\\\":[],\\\\\\\"nonBlockingFindings\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-001\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"minor\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Mutation and requeue operations bypass the SDK-injected clock\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"messages.edit, messages.deleteMessage, messages.requeue, turns.requeue, and turns.deleteTurn all call runInTransaction(db, () => new Date(), threadId, ...) — deleted_at stamps and requeued items' queuedAt use wall time regardless of SdkConfig.clock, which governs only drain/scheduler paths (and intake has its own setIntakeClock seam). Deterministic time injection therefore does not extend to the mutation surfaces.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/domains/messages/index.ts\\\\\\\",\\\\\\\"packages/lhc/src/domains/turns/index.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"DD-7\\\\\\\",\\\\\\\"AC-5.1\\\\\\\",\\\\\\\"AC-6.1\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"quick-fix\\\\\\\",\\\\\\\"blocking\\\\\\\":false},{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-002\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"minor\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Process-global scheduler seams not cleared by a later manual-mode SDK\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"createSdk installs setSchedulerPoke/setThreadTouch only in background mode and a later background SDK supersedes an earlier one (documented), but a manual-mode SDK constructed after a background one leaves the previous background scheduler installed — enqueues through the manual SDK would still poke the stale scheduler and drain with the old provider/config. Low real-world impact under assumption A3 (one host per process), but the background-then-manual sequence is unhandled.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/sdk.ts\\\\\\\",\\\\\\\"packages/lhc/src/shared/context.ts\\\\\\\",\\\\\\\"packages/lhc/src/scheduler.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"DD-4\\\\\\\",\\\\\\\"DD-5\\\\\\\",\\\\\\\"AC-1.7\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"quick-fix\\\\\\\",\\\\\\\"blocking\\\\\\\":false},{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-003\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"observation\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Deterministic provider is the only registered production provider\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"src/providers/registry.ts registers exactly one name ('deterministic'). Real adapters are explicitly out of epic scope and DD-11 sanctions the double's registry placement with no default, so this is by design — but until a real adapter lands, lhc work drain in production can only produce marked deterministic artifacts, selected by explicit operator opt-in.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/providers/registry.ts\\\\\\\",\\\\\\\"packages/lhc/src/providers/deterministic.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"DD-11\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"human-ruling\\\\\\\",\\\\\\\"blocking\\\\\\\":false},{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-004\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"observation\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Thrown handler errors are converted to retryable attempts\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"drainOpenDb catches a throwing handler and routes it through failAttempt as { retryable: true }, consuming retry budget before landing failed. The error contract says bugs throw and are not contract outcomes; this deliberately softens that to protect the queue from wedging (documented in scheduler.ts). The trade-off is reasonable but means a deterministic handler bug is retried twice before surfacing.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/lhc/src/scheduler.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-1.9\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"human-ruling\\\\\\\",\\\\\\\"blocking\\\\\\\":false},{\\\\\\\"id\\\\\\\":\\\\\\\"E02-NB-005\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"observation\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Inconsistent attempts accounting between terminal paths\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"The blocked-source terminal path stamps attempts: item.attempts + 1 while the unknown-kind terminal path stamps attempts: item.attempts (scheduler.ts lines 119-125 vs 158-165). Cosmetic: the value only feeds the drain report and the form's failure metadata, and unknown-kind items never ran a handler, but th\\\",\\\"stderr\\\":\\\"\\\",\\\"interrupted\\\":false,\\\"isImage\\\":false,\\\"noOutputExpected\\\":false,\\\"persistedOutputPath\\\":\\\"/Users/leemoore/.claude/projects/-Users-leemoore-code-pi-long-horizon-liminal-context/d9c65f8a-2769-45ee-8250-eab6f8fa0e38/tool-results/b17022gxq.txt\\\",\\\"persistedOutputSize\\\":145984}}\\n./packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/fix/streams/004-fix-result.stdout.log:1452:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_013kud32EtfBckiyGZbkDHRA\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"=== TC-5.4 stale-result pattern in mutations.test.ts ===\\\\n10:// TC-5.4 is the epic's named architecture-risk test: a claimed pre-edit item\\\\n11:// held across the edit by the delayed double completes after the post-edit\\\\n13:// stale_discarded, and the post-edit artifact stands. Refusals (open turn,\\\\n196:    // Plant a claimed row at the exact id the cascade's replacement enqueue\\\\n203:       VALUES (?, 'messages', 'prompt_smoothing', ?, 'claimed', ?, ?)`,\\\\n371:describe(\\\\\\\"TC-5.4 / AC-5.4 (architecture risk): the version check beats the straggler\\\\\\\", () => {\\\\n372:  it(\\\\\\\"a claimed pre-edit item completing after the edit discards as stale_discarded; the post-edit artifact wins\\\\\\\", async () => {\\\\n381:    // Hold the old-content smoothing in flight: the drain claims it, the\\\\n383:    // window — a real claimed old-version item held across the edit, not a\\\\n385:    double.delayKind(\\\\\\\"prompt_smoothing\\\\\\\", 400);\\\\n=== read TC-5.4 region ===\\\\n// TC-5.4 is the epic's named architecture-risk test: a claimed pre-edit item\\\\n// held across the edit by the delayed double completes after the post-edit\\\\n// rebuild is queued, discards on the source-version mismatch as\\\\n// stale_discarded, and the post-edit artifact stands. Refusals (open turn,\\\\n// turnless no-membership target, missing id, deleted target through the\\\\n// filtered view) change nothing (TC-5.5). The CLI parity leg of TC-5.6 lives in\\\\n// cli-process-mutations.test.ts (process suite).\\\\nimport { afterEach, beforeEach, describe, expect, it } from \\\\\\\"vitest\\\\\\\";\\\\nimport {\\\\n  createSdk,\\\\n  deterministicText,\\\\n  estimateTokens,\\\\n  messages,\\\\n  queueDetail,\\\\n  setSchedulerPoke,\\\\n  setThreadTouch,\\\\n  threads,\\\\n  type DerivationProvider,\\\\n  type DrainReport,\\\\n  type Lhc,\\\\n  type MessageEventInput,\\\\n  type MutationResult,\\\\n  type OpResult,\\\\n  type SdkConfig,\\\\n} from \\\\\\\"../src/index.js\\\\\\\";\\\\nimport {\\\\n  createProviderDouble,\\\\n  openRaw,\\\\n  readDerivedForms,\\\\n  tempStore,\\\\n  validEvent,\\\\n  type TempStore,\\\\n} from \\\\\\\"./fixtures/index.js\\\\\\\";\\\\n\\\\nlet store: TempStore;\\\\nbeforeEach(() => {\\\\n  store = tempStore();\\\\n});\\\\nafterEach(() => {\\\\n  store.cleanup();\\\\n  setSchedulerPoke(null);\\\\n  setThreadTouch(null);\\\\n});\\\\n\\\\nasync function newThread(): Promise<string> {\\\\n  const created = await threads.newThread({\\\\n    filePath: store.threadPath(),\\\\n    registryPath: store.registryPath,\\\\n  });\\\\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\\\n  return created.value.filePath;\\\\n}\\\\n\\\\nfunction manualSdk(\\\\n  provider: DerivationProvider,\\\\n  overrides: Partial<Pick<SdkConfig, \\\\\\\"chunkPolicy\\\\\\\" | \\\\\\\"clock\\\\\\\" | \\\\\\\"mode\\\\\\\">> = {},\\\\n): Lhc {\\\\n  const config: SdkConfig = {\\\\n    provider,\\\\n    mode: overrides.mode ?? \\\\\\\"manual\\\\\\\",\\\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\n    lease: { durationMs: 5000 },\\\\n  };\\\\n  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\\\\n  if (overrides.clock !== undefined) config.clock = overrides.clock;\\\\n  return createSdk(config);\\\\n}\\\\n\\\\nasync function send(\\\\n  sdk: Lhc,\\\\n  filePath: string,\\\\n  batch: readonly MessageEventInput[],\\\\n): Promise<void> {\\\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\\\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\\\\n}\\\\ndescribe(\\\\\\\"TC-5.4 / AC-5.4 (architecture risk): the version check beats the straggler\\\\\\\", () => {\\\\n  it(\\\\\\\"a claimed pre-edit item completing after the edit discards as stale_discarded; the post-edit artifact wins\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const filePath = await newThread();\\\\n    await send(sdk, filePath, [\\\\n      validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"original prompt\\\\\\\" } }),\\\\n      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n    ]);\\\\n\\\\n    // Hold the old-content smoothing in flight: the drain claims it, the\\\\n    // handler awaits the delayed double, and the edit lands inside that\\\\n    // window — a real claimed old-version item held across the edit, not a\\\\n    // simulated version poke.\\\\n    double.delayKind(\\\\\\\"prompt_smoothing\\\\\\\", 400);\\\\n    const captured = double.captureInputs();\\\\n    const drainPromise = sdk.work.drain({ filePath });\\\\n    await until(\\\\n      () => captured.some((call) => call.op === \\\\\\\"smoothPrompt\\\\\\\"),\\\\n      \\\\\\\"the old-content smoothing to be claimed and in-handler\\\\\\\",\\\\n    );\\\\n\\\\n    const edited = await messages.edit(\\\\n      { filePath },\\\\n      { messageId: \\\\\\\"m1\\\\\\\", content: \\\\\\\"edited prompt\\\\\\\" },\\\\n    );\\\\n    expect(edited.ok).toBe(true);\\\\n    if (!edited.ok) return;\\\\n    // The still-queued turn derivation behind the claimed head was\\\\n    // superseded; the claimed item was left to the version check.\\\\n    expect(edited.value.superseded).toEqual([\\\\\\\"w-t1-turn_derivation-v1\\\\\\\"]);\\\\n\\\\n    // Old claimed item and post-edit replacement coexist — ids include the\\\\n    // source version, so they never collide.\\\\n    const mid = rawDetail(filePath);\\\\n    expect(mid.map((row) => [row.workItemId, row.status])).toEqual([\\\\n      [\\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\", \\\\\\\"claimed\\\\\\\"],\\\\n      [\\\\\\\"w-m1-prompt_smoothing-v2\\\\\\\", \\\\\\\"queued\\\\\\\"],\\\\n      [\\\\\\\"w-t1-turn_derivation-v2\\\\\\\", \\\\\\\"queued\\\\\\\"],\\\\n    ]);\\\\n\\\\n    // Let both complete. The straggler's completion is a normal completion\\\\n    // reported stale_discarded — not an error, not a retry — and the drain\\\\n    // continues into the replacement work.\\\\n    const drained = await drainPromise;\\\\n    expect(drained.ok).toBe(true);\\\\n    if (!drained.ok) return;\\\\n    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\\\\n      [\\\\\\\"w-m1-prompt_smoothing-v1\\\\\\\", \\\\\\\"stale_discarded\\\\\\\"],\\\\n      [\\\\\\\"w-m1-prompt_smoothing-v2\\\\\\\", \\\\\\\"done\\\\\\\"],\\\\n      [\\\\\\\"w-t1-turn_derivation-v2\\\\\\\", \\\\\\\"done\\\\\\\"],\\\\n    ]);\\\\n\\\\n    // Exactly one ready smoothing row, derived from the post-edit content at\\\\n    // the post-edit source version — regardless of completion order.\\\\n    const rows = readDerivedForms(filePath).filter(\\\\n      (form) => form.subjectId === \\\\\\\"m1\\\\\\\" && form.form === \\\\\\\"smoothed_prompt\\\\\\\",\\\\n    );\\\\n    expect(rows).toHaveLength(1);\\\\n    expect(rows[0]).toMatchObject({ state: \\\\\\\"ready\\\\\\\", sourceVersion: 2 });\\\\n    expect(rows[0]?.content).toBe(\\\\n      deterministicText(\\\\\\\"smoothPrompt\\\\\\\", { text: \\\\\\\"edited prompt\\\\\\\" }, \\\\\\\"edited prompt\\\\\\\"),\\\\n    );\\\\n    expect(rawDetail(filePath)).toEqual([]);\\\\n  }, 15000);\\\\n});\\\\n\\\\ndescribe(\\\\\\\"TC-5.5 / AC-5.5: refusals are stable and change nothing\\\\\\\", () => {\\\\n  it(\\\\\\\"refuses open-turn, missing, and deleted targets; read-back identical after each\\\\\\\", async () => {\\\\n    const double = createProviderDouble();\\\\n    const sdk = manualSdk(double);\\\\n    const filePath = await newThread();\\\\n    // m1 in closed t1; m3 in open t2.\\\\n    await send(sdk, filePath, [\\\\n      validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"closed prompt\\\\\\\" } }),\\\\n      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\",\\\"is_error\\\":false}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"d9c65f8a-2769-45ee-8250-eab6f8fa0e38\\\",\\\"uuid\\\":\\\"0033d863-988a-4452-bb68-30e788d612e3\\\",\\\"timestamp\\\":\\\"2026-06-11T10:06:55.729Z\\\",\\\"tool_use_result\\\":{\\\"stdout\\\":\\\"=== TC-5.4 stale-result pattern in mutations.test.ts ===\\\\n10:// TC-5.4 is the epic's named architecture-risk test: a claimed pre-edit item\\\\n11:// held across the edit by the delayed double completes after the post-edit\\\\n13:// stale_discarded, and the post-edit artifact stands. Refusals (open turn,\\\\n196:    // Plant a claimed row at the exact id the cascade's replacement enqueue\\\\n203:       VALUES (?, 'messages', 'prompt_smoothing', ?, 'claimed', ?, ?)`,\\\\n371:describe(\\\\\\\"TC-5.4 / AC-5.4 (architecture risk): the version check beats the straggler\\\\\\\", () => {\\\\n372:  it(\\\\\\\"a claimed pre-edit item completing after the edit discards as stale_discarded; the post-edit artifact wins\\\\\\\", async () => {\\\\n381:    // Hold the old-content smoothing in flight: the drain claims it, the\\\\n383:    // window — a real claimed old-version item held across
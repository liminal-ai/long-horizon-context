{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_198acf98c4504d9cb4aaa4f4","type":"tool_result","content":"1\t// AC-5.1, AC-5.2, AC-5.3. Startup validation: probe all seven assignments\n2\t// against PI's registry, report unreachable lanes, leave capture running.\n3\t//\n4\t// This layer runs AFTER shape validation (which LHC's createSdk enforces at\n5\t// construction). It adds a reachability probe on top: for each assignment,\n6\t// check that the provider/model pair exists in PI's registry and that auth is\n7\t// configured. This surfaces misconfigurations before the first derivation use,\n8\t// rather than as a silent derivation failure later (AC-5.1).\n9\t//\n10\t// Reporting must not assume a TUI (AC-5.2). The report surfaces through ctx.ui\n11\t// when available and always persists to SessionState.health for headless modes.\n12\t\n13\timport { writeSync } from \"node:fs\";\n14\timport type { FormKind, ModelAssignment } from \"lhc\";\n15\timport { FORM_KINDS } from \"lhc\";\n16\timport type { ExtensionContext } from \"../pi/types.js\";\n17\timport type { SessionState } from \"../lifecycle/state.js\";\n18\timport type { ValidationReport } from \"../shared/diagnostics.js\";\n19\t\n20\t// Re-export ValidationReport from its spec'd home (defined in shared/diagnostics\n21\t// so SessionState can reference it without a lifecycle→inference edge).\n22\texport type { ValidationReport };\n23\t\n24\tinterface ReportDeps {\n25\t  headlessLog?: (message: string) => void;\n26\t}\n27\t\n28\tfunction defaultHeadlessLog(message: string): void {\n29\t  writeSync(2, `${message}\\n`);\n30\t}\n31\t\n32\t/** Probe each assignment; classify unreachable lanes (AC-5.1, AC-5.2).\n33\t *\n34\t *  For each of the seven derivation kinds:\n35\t *  1. Call ctx.modelRegistry.find(provider, model) to check if the lane exists.\n36\t *  2. If found, call ctx.modelRegistry.hasConfiguredAuth(handle) to check auth.\n37\t *  3. Classify the failure:\n38\t *     - \"unknown_model\": provider/model not found in registry → fix assignment\n39\t *     - \"auth_not_configured\": lane exists but no auth → log in / configure auth\n40\t *\n41\t *  Returns a structured report listing all unreachable lanes with their fixes.\n42\t *  Reachable lanes are not listed; an empty `unreachable` array means all lanes\n43\t *  are reachable (AC-5.1). */\n44\texport function validateReachable(\n45\t  assignments: Record<FormKind, ModelAssignment>,\n46\t  ctx: ExtensionContext,\n47\t): ValidationReport {\n48\t  const unreachable: ValidationReport[\"unreachable\"] = [];\n49\t\n50\t  for (const kind of FORM_KINDS) {\n51\t    const assignment = assignments[kind as FormKind];\n52\t    const { provider, model } = assignment;\n53\t\n54\t    // Check if the model exists in PI's registry\n55\t    const resolved = ctx.modelRegistry.find(provider, model);\n56\t\n57\t    if (resolved === undefined) {\n58\t      // Unknown lane: provider/model not found → fix assignment\n59\t      unreachable.push({\n60\t        kind,\n61\t        provider,\n62\t        model,\n63\t        reason: \"unknown_model\",\n64\t        fix: `Update '${kind}' assignment to use a known provider/model pair available in PI's model registry`,\n65\t      });\n66\t      continue; // Skip auth check for unknown models\n67\t    }\n68\t\n69\t    // Lane exists; check if auth is configured\n70\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n71\t      // Known lane but no auth → log in / configure auth\n72\t      unreachable.push({\n73\t        kind,\n74\t        provider,\n75\t        model,\n76\t        reason: \"auth_not_configured\",\n77\t        fix: `Log in or configure auth for ${provider}/${model} in PI settings`,\n78\t      });\n79\t    }\n80\t  }\n81\t\n82\t  return { unreachable };\n83\t}\n84\t\n85\t/** Surface unreachable lanes via ctx.ui when available + structured diagnostic.\n86\t *\n87\t *  Reporting is headless-safe (AC-5.2):\n88\t *  - If ctx.hasUI is true, surface through ctx.ui.notify with a formatted report.\n89\t *  - Always persist the structured ValidationReport to SessionState.health.\n90\t *  - Capture continues running even when validation fails (AC-5.3).\n91\t *\n92\t *  This function never throws; validation failures are diagnostic, not fatal.\n93\t *  The affected lane's derivations will fail classified and queryable through\n94\t *  health (AC-5.3), but the session itself remains functional for capture. */\n95\texport function report(\n96\t  r: ValidationReport,\n97\t  ctx: ExtensionContext,\n98\t  state: SessionState,\n99\t  deps: ReportDeps = {},\n100\t): void {\n101\t  // Mark that we've reported startup validation (avoids duplicate reporting)\n102\t  state.flags.startupValidationReported = true;\n103\t\n104\t  // If there are unreachable lanes, surface them through ctx.ui when available\n105\t  if (r.unreachable.length > 0) {\n106\t    const lines = [\n107\t      \"pi-lhc startup validation: unreachable derivation lanes\",\n108\t      \"\",\n109\t      ...r.unreachable.map(\n110\t        (u) =>\n111\t          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n112\t      ),\n113\t      \"\",\n114\t      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n115\t    ];\n116\t\n117\t    const message = lines.join(\"\\n\");\n118\t    state.health.startupValidation = { ...r, message };\n119\t\n120\t    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n121\t    if (ctx.hasUI) {\n122\t      ctx.ui.notify(message, { level: \"warn\" });\n123\t    } else {\n124\t      const headlessLog = deps.headlessLog ?? defaultHeadlessLog;\n125\t      headlessLog(message);\n126\t    }\n127\t  } else {\n128\t    // Persist the structured report to SessionState.health (always, even in headless)\n129\t    state.health.startupValidation = r;\n130\t  }\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"a08bfa87-d15f-49ef-98e9-3889acacbbb4","uuid":"350cab3c-599d-4040-8e8b-711696d3cf5d","timestamp":"2026-06-14T20:43:14.399Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/startup-validation.ts","content":"// AC-5.1, AC-5.2, AC-5.3. Startup validation: probe all seven assignments\n// against PI's registry, report unreachable lanes, leave capture running.\n//\n// This layer runs AFTER shape validation (which LHC's createSdk enforces at\n// construction). It adds a reachability probe on top: for each assignment,\n// check that the provider/model pair exists in PI's registry and that auth is\n// configured. This surfaces misconfigurations before the first derivation use,\n// rather than as a silent derivation failure later (AC-5.1).\n//\n// Reporting must not assume a TUI (AC-5.2). The report surfaces through ctx.ui\n// when available and always persists to SessionState.health for headless modes.\n\nimport { writeSync } from \"node:fs\";\nimport type { FormKind, ModelAssignment } from \"lhc\";\nimport { FORM_KINDS } from \"lhc\";\nimport type { ExtensionContext } from \"../pi/types.js\";\nimport type { SessionState } from \"../lifecycle/state.js\";\nimport type { ValidationReport } from \"../shared/diagnostics.js\";\n\n// Re-export ValidationReport from its spec'd home (defined in shared/diagnostics\n// so SessionState can reference it without a lifecycle→inference edge).\nexport type { ValidationReport };\n\ninterface ReportDeps {\n  headlessLog?: (message: string) => void;\n}\n\nfunction defaultHeadlessLog(message: string): void {\n  writeSync(2, `${message}\\n`);\n}\n\n/** Probe each assignment; classify unreachable lanes (AC-5.1, AC-5.2).\n *\n *  For each of the seven derivation kinds:\n *  1. Call ctx.modelRegistry.find(provider, model) to check if the lane exists.\n *  2. If found, call ctx.modelRegistry.hasConfiguredAuth(handle) to check auth.\n *  3. Classify the failure:\n *     - \"unknown_model\": provider/model not found in registry → fix assignment\n *     - \"auth_not_configured\": lane exists but no auth → log in / configure auth\n *\n *  Returns a structured report listing all unreachable lanes with their fixes.\n *  Reachable lanes are not listed; an empty `unreachable` array means all lanes\n *  are reachable (AC-5.1). */\nexport function validateReachable(\n  assignments: Record<FormKind, ModelAssignment>,\n  ctx: ExtensionContext,\n): ValidationReport {\n  const unreachable: ValidationReport[\"unreachable\"] = [];\n\n  for (const kind of FORM_KINDS) {\n    const assignment = assignments[kind as FormKind];\n    const { provider, model } = assignment;\n\n    // Check if the model exists in PI's registry\n    const resolved = ctx.modelRegistry.find(provider, model);\n\n    if (resolved === undefined) {\n      // Unknown lane: provider/model not found → fix assignment\n      unreachable.push({\n        kind,\n        provider,\n        model,\n        reason: \"unknown_model\",\n        fix: `Update '${kind}' assignment to use a known provider/model pair available in PI's model registry`,\n      });\n      continue; // Skip auth check for unknown models\n    }\n\n    // Lane exists; check if auth is configured\n    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n      // Known lane but no auth → log in / configure auth\n      unreachable.push({\n        kind,\n        provider,\n        model,\n        reason: \"auth_not_configured\",\n        fix: `Log in or configure auth for ${provider}/${model} in PI settings`,\n      });\n    }\n  }\n\n  return { unreachable };\n}\n\n/** Surface unreachable lanes via ctx.ui when available + structured diagnostic.\n *\n *  Reporting is headless-safe (AC-5.2):\n *  - If ctx.hasUI is true, surface through ctx.ui.notify with a formatted report.\n *  - Always persist the structured ValidationReport to SessionState.health.\n *  - Capture continues running even when validation fails (AC-5.3).\n *\n *  This function never throws; validation failures are diagnostic, not fatal.\n *  The affected lane's derivations will fail classified and queryable through\n *  health (AC-5.3), but the session itself remains functional for capture. */\nexport function report(\n  r: ValidationReport,\n  ctx: ExtensionContext,\n  state: SessionState,\n  deps: ReportDeps = {},\n): void {\n  // Mark that we've reported startup validation (avoids duplicate reporting)\n  state.flags.startupValidationReported = true;\n\n  // If there are unreachable lanes, surface them through ctx.ui when available\n  if (r.unreachable.length > 0) {\n    const lines = [\n      \"pi-lhc startup validation: unreachable derivation lanes\",\n      \"\",\n      ...r.unreachable.map(\n        (u) =>\n          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n      ),\n      \"\",\n      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n    ];\n\n    const message = lines.join(\"\\n\");\n    state.health.startupValidation = { ...r, message };\n\n    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n    if (ctx.hasUI) {\n      ctx.ui.notify(message, { level: \"warn\" });\n    } else {\n      const headlessLog = deps.headlessLog ?? defaultHeadlessLog;\n      headlessLog(message);\n    }\n  } else {\n    // Persist the structured report to SessionState.health (always, even in headless)\n    state.health.startupValidation = r;\n  }\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_93624476bdf24bcea4beec89","type":"tool_result","content":"1\timport type { EventKind, MessageEventInput } from \"lhc\";\n2\timport type {\n3\t  AgentMessage,\n4\t  AssistantMessage,\n5\t  ContentPart,\n6\t  FileRefPart,\n7\t  ImagePart,\n8\t  ToolResultMessage,\n9\t  UserMessage,\n10\t} from \"../pi/types.js\";\n11\timport { eventKey } from \"./idempotency.js\";\n12\t\n13\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n14\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n15\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n16\t// present) → one `tool_call` per call, in that order; a tool result → one\n17\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n18\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n19\t// drop, tech design I-6). A graceful interrupt carries its disposition through\n20\t// on a trailing `runtime_note` (research §5b).\n21\t\n22\texport interface MapCtx {\n23\t  piSessionId: string;\n24\t  entryId?: string | undefined;\n25\t  fallbackId?: string | undefined;\n26\t}\n27\t\n28\tconst HARNESS = \"pi\";\n29\t\n30\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n31\t *  field to hold its disposition, so the mapper carries `stopReason` through on\n32\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n33\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\n34\texport const ABORTED_DISPOSITION_TEXT =\n35\t  \"turn aborted (stopReason: aborted) — partial content preserved\";\n36\t\n37\tconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n38\t\n39\tfunction textOf(parts: ContentPart[]): string {\n40\t  return parts\n41\t    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n42\t    .map((p) => p.text)\n43\t    .join(\"\");\n44\t}\n45\t\n46\tfunction thinkingOf(parts: ContentPart[]): string {\n47\t  return parts\n48\t    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n49\t    .map((p) => p.thinking)\n50\t    .join(\"\");\n51\t}\n52\t\n53\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n54\t  return parts.filter(\n55\t    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n56\t  );\n57\t}\n58\t\n59\tfunction omissionText(part: ImagePart | FileRefPart): string {\n60\t  return part.type === \"image\"\n61\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n62\t    : `unsupported content omitted: file reference (${part.path})`;\n63\t}\n64\t\n65\tfunction buildKey(\n66\t  ctx: MapCtx,\n67\t  role: string,\n68\t  kind: EventKind,\n69\t  blockIndex: number,\n70\t  opts: {\n71\t    entryId?: string | undefined;\n72\t    responseId?: string | undefined;\n73\t    toolCallId?: string | undefined;\n74\t    content?: string | undefined;\n75\t  } = {},\n76\t): string {\n77\t  return eventKey({\n78\t    piSessionId: ctx.piSessionId,\n79\t    entryId: opts.entryId ?? ctx.entryId,\n80\t    responseId: opts.responseId,\n81\t    blockIndex,\n82\t    kind,\n83\t    role,\n84\t    fallbackId: ctx.fallbackId,\n85\t    toolCallId: opts.toolCallId,\n86\t    content: opts.content,\n87\t  });\n88\t}\n89\t\n90\tfunction stringField(value: unknown, field: string): string | undefined {\n91\t  if (typeof value !== \"object\" || value === null || !(field in value)) return undefined;\n92\t  const candidate = (value as Record<string, unknown>)[field];\n93\t  return typeof candidate === \"string\" && candidate !== \"\" ? candidate : undefined;\n94\t}\n95\t\n96\tfunction entryIdOf(msg: AgentMessage): string | undefined {\n97\t  return stringField(msg, \"entryId\");\n98\t}\n99\t\n100\tfunction responseIdOf(msg: AgentMessage): string | undefined {\n101\t  return stringField(msg, \"responseId\") ?? stringField(msg, \"id\");\n102\t}\n103\t\n104\t// Per-kind builders — explicit eventKind literals so the discriminated union\n105\t// narrows without a cast.\n106\tfunction textEvent(\n107\t  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n108\t  text: string,\n109\t  actor: string,\n110\t  key: string,\n111\t): MessageEventInput {\n112\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n113\t}\n114\t\n115\tfunction toolCallEvent(\n116\t  toolCallId: string,\n117\t  toolName: string,\n118\t  args: Record<string, unknown>,\n119\t  key: string,\n120\t): MessageEventInput {\n121\t  return {\n122\t    eventKind: \"tool_call\",\n123\t    idempotencyKey: key,\n124\t    actor: \"assistant\",\n125\t    harness: HARNESS,\n126\t    payload: { toolCallId, toolName, arguments: args },\n127\t  };\n128\t}\n129\t\n130\tfunction toolResultEvent(\n131\t  toolCallId: string,\n132\t  content: string,\n133\t  isError: boolean,\n134\t  key: string,\n135\t): MessageEventInput {\n136\t  return {\n137\t    eventKind: \"tool_result\",\n138\t    idempotencyKey: key,\n139\t    actor: \"tool\",\n140\t    harness: HARNESS,\n141\t    payload: { toolCallId, content, isError },\n142\t  };\n143\t}\n144\t\n145\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n146\t  const events: MessageEventInput[] = [];\n147\t  const entryId = entryIdOf(msg);\n148\t  let block = 0;\n149\t  if (msg.content.some((p) => p.type === \"text\")) {\n150\t    const text = textOf(msg.content);\n151\t    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { entryId, content: text })));\n152\t    block += 1;\n153\t  }\n154\t  for (const part of unsupportedOf(msg.content)) {\n155\t    const text = omissionText(part);\n156\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: text })));\n157\t    block += 1;\n158\t  }\n159\t  if (events.length === 0) {\n160\t    events.push(\n161\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: \"empty:user\" })),\n162\t    );\n163\t  }\n164\t  return events;\n165\t}\n166\t\n167\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n168\t  const events: MessageEventInput[] = [];\n169\t  const entryId = entryIdOf(msg);\n170\t  const responseId = responseIdOf(msg);\n171\t  let block = 0;\n172\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n173\t  if (msg.content.some((p) => p.type === \"thinking\")) {\n174\t    const text = thinkingOf(msg.content);\n175\t    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { entryId, responseId, content: text })));\n176\t    block += 1;\n177\t  }\n178\t  if (msg.content.some((p) => p.type === \"text\")) {\n179\t    const text = textOf(msg.content);\n180\t    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { entryId, responseId, content: text })));\n181\t    block += 1;\n182\t  }\n183\t  for (const part of msg.content) {\n184\t    if (part.type !== \"toolCall\") continue;\n185\t    events.push(\n186\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { entryId, responseId, toolCallId: part.id, content: part.name })),\n187\t    );\n188\t    block += 1;\n189\t  }\n190\t  for (const part of unsupportedOf(msg.content)) {\n191\t    const text = omissionText(part);\n192\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: text })));\n193\t    block += 1;\n194\t  }\n195\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\n196\t  if (msg.stopReason === \"aborted\") {\n197\t    events.push(\n198\t      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: ABORTED_DISPOSITION_TEXT })),\n199\t    );\n200\t    block += 1;\n201\t  }\n202\t  if (events.length === 0) {\n203\t    events.push(\n204\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: \"empty:assistant\" })),\n205\t    );\n206\t  }\n207\t  return events;\n208\t}\n209\t\n210\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n211\t  const events: MessageEventInput[] = [];\n212\t  const entryId = entryIdOf(msg);\n213\t  const content = textOf(msg.content);\n214\t  const isError = msg.isError === true;\n215\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n216\t  // and content are always captured, even on failure (AC-2.4).\n217\t  events.push(\n218\t    toolResultEvent(\n219\t      msg.toolCallId,\n220\t      content,\n221\t      isError,\n222\t      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { entryId, toolCallId: msg.toolCallId, content }),\n223\t    ),\n224\t  );\n225\t  let block = 1;\n226\t  for (const [partIndex, part] of unsupportedOf(msg.content).entries()) {\n227\t    const text = omissionText(part);\n228\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"toolResult\", \"runtime_note\", block, { entryId, toolCallId: `${msg.toolCallId}:omission:${partIndex}`, content: text })));\n229\t    block += 1;\n230\t  }\n231\t  return events;\n232\t}\n233\t\n234\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n235\t  switch (msg.role) {\n236\t    case \"user\":\n237\t      return mapUser(msg, ctx);\n238\t    case \"assistant\":\n239\t      return mapAssistant(msg, ctx);\n240\t    case \"toolResult\":\n241\t      return mapToolResult(msg, ctx);\n242\t    default:\n243\t      throw new Error(`unmappable PI message role: ${String((msg as { role?: unknown }).role)}`);\n244\t  }\n245\t}\n246\t"}]},"parent_tool_use_id":null,"session_id":"a08bfa87-d15f-49ef-98e9-3889acacbbb4","uuid":"d0172f94-6c27-4782-a7b3-84ed1deb9f95","timestamp":"2026-06-14T20:43:14.403Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/map-message.ts","content":"import type { EventKind, MessageEventInput } from \"lhc\";\nimport type {\n  AgentMessage,\n  AssistantMessage,\n  ContentPart,\n  FileRefPart,\n  ImagePart,\n  ToolResultMessage,\n  UserMessage,\n} from \"../pi/types.js\";\nimport { eventKey } from \"./idempotency.js\";\n\n// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n// present) → one `tool_call` per call, in that order; a tool result → one\n// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n// drop, tech design I-6). A graceful interrupt carries its disposition through\n// on a trailing `runtime_note` (research §5b).\n\nexport interface MapCtx {\n  piSessionId: string;\n  entryId?: string | undefined;\n  fallbackId?: string | undefined;\n}\n\nconst HARNESS = \"pi\";\n\n/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n *  field to hold its disposition, so the mapper carries `stopReason` through on\n *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\nexport const ABORTED_DISPOSITION_TEXT =\n  \"turn aborted (stopReason: aborted) — partial content preserved\";\n\nconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n\nfunction textOf(parts: ContentPart[]): string {\n  return parts\n    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n    .map((p) => p.text)\n    .join(\"\");\n}\n\nfunction thinkingOf(parts: ContentPart[]): string {\n  return parts\n    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n    .map((p) => p.thinking)\n    .join(\"\");\n}\n\nfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n  return parts.filter(\n    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n  );\n}\n\nfunction omissionText(part: ImagePart | FileRefPart): string {\n  return part.type === \"image\"\n    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n    : `unsupported content omitted: file reference (${part.path})`;\n}\n\nfunction buildKey(\n  ctx: MapCtx,\n  role: string,\n  kind: EventKind,\n  blockIndex: number,\n  opts: {\n    entryId?: string | undefined;\n    responseId?: string | undefined;\n    toolCallId?: string | undefined;\n    content?: string | undefined;\n  } = {},\n): string {\n  return eventKey({\n    piSessionId: ctx.piSessionId,\n    entryId: opts.entryId ?? ctx.entryId,\n    responseId: opts.responseId,\n    blockIndex,\n    kind,\n    role,\n    fallbackId: ctx.fallbackId,\n    toolCallId: opts.toolCallId,\n    content: opts.content,\n  });\n}\n\nfunction stringField(value: unknown, field: string): string | undefined {\n  if (typeof value !== \"object\" || value === null || !(field in value)) return undefined;\n  const candidate = (value as Record<string, unknown>)[field];\n  return typeof candidate === \"string\" && candidate !== \"\" ? candidate : undefined;\n}\n\nfunction entryIdOf(msg: AgentMessage): string | undefined {\n  return stringField(msg, \"entryId\");\n}\n\nfunction responseIdOf(msg: AgentMessage): string | undefined {\n  return stringField(msg, \"responseId\") ?? stringField(msg, \"id\");\n}\n\n// Per-kind builders — explicit eventKind literals so the discriminated union\n// narrows without a cast.\nfunction textEvent(\n  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n  text: string,\n  actor: string,\n  key: string,\n): MessageEventInput {\n  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n}\n\nfunction toolCallEvent(\n  toolCallId: string,\n  toolName: string,\n  args: Record<string, unknown>,\n  key: string,\n): MessageEventInput {\n  return {\n    eventKind: \"tool_call\",\n    idempotencyKey: key,\n    actor: \"assistant\",\n    harness: HARNESS,\n    payload: { toolCallId, toolName, arguments: args },\n  };\n}\n\nfunction toolResultEvent(\n  toolCallId: string,\n  content: string,\n  isError: boolean,\n  key: string,\n): MessageEventInput {\n  return {\n    eventKind: \"tool_result\",\n    idempotencyKey: key,\n    actor: \"tool\",\n    harness: HARNESS,\n    payload: { toolCallId, content, isError },\n  };\n}\n\nfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n  const events: MessageEventInput[] = [];\n  const entryId = entryIdOf(msg);\n  let block = 0;\n  if (msg.content.some((p) => p.type === \"text\")) {\n    const text = textOf(msg.content);\n    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { entryId, content: text })));\n    block += 1;\n  }\n  for (const part of unsupportedOf(msg.content)) {\n    const text = omissionText(part);\n    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: text })));\n    block += 1;\n  }\n  if (events.length === 0) {\n    events.push(\n      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: \"empty:user\" })),\n    );\n  }\n  return events;\n}\n\nfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n  const events: MessageEventInput[] = [];\n  const entryId = entryIdOf(msg);\n  const responseId = responseIdOf(msg);\n  let block = 0;\n  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n  if (msg.content.some((p) => p.type === \"thinking\")) {\n    const text = thinkingOf(msg.content);\n    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { entryId, responseId, content: text })));\n    block += 1;\n  }\n  if (msg.content.some((p) => p.type === \"text\")) {\n    const text = textOf(msg.content);\n    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { entryId, responseId, content: text })));\n    block += 1;\n  }\n  for (const part of msg.content) {\n    if (part.type !== \"toolCall\") continue;\n    events.push(\n      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { entryId, responseId, toolCallId: part.id, content: part.name })),\n    );\n    block += 1;\n  }\n  for (const part of unsupportedOf(msg.content)) {\n    const text = omissionText(part);\n    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: text })));\n    block += 1;\n  }\n  // Graceful interrupt: carry the aborted disposition through (never discarded).\n  if (msg.stopReason === \"aborted\") {\n    events.push(\n      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: ABORTED_DISPOSITION_TEXT })),\n    );\n    block += 1;\n  }\n  if (events.length === 0) {\n    events.push(\n      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: \"empty:assistant\" })),\n    );\n  }\n  return events;\n}\n\nfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n  const events: MessageEventInput[] = [];\n  const entryId = entryIdOf(msg);\n  const content = textOf(msg.content);\n  const isError = msg.isError === true;\n  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n  // and content are always captured, even on failure (AC-2.4).\n  events.push(\n    toolResultEvent(\n      msg.toolCallId,\n      content,\n      isError,\n      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { entryId, toolCallId: msg.toolCallId, content }),\n    ),\n  );\n  let block = 1;\n  for (const [partIndex, part] of unsupportedOf(msg.content).entries()) {\n    const text = omissionText(part);\n    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"toolResult\", \"runtime_note\", block, { entryId, toolCallId: `${msg.toolCallId}:omission:${partIndex}`, content: text })));\n    block += 1;\n  }\n  return events;\n}\n\nexport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n  switch (msg.role) {\n    case \"user\":\n      return mapUser(msg, ctx);\n    case \"assistant\":\n      return mapAssistant(msg, ctx);\n    case \"toolResult\":\n      return mapToolResult(msg, ctx);\n    default:\n      throw new Error(`unmappable PI message role: ${String((msg as { role?: unknown }).role)}`);\n  }\n}\n","numLines":246,"startLine":1,"totalLines":246}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_127a7ac4ed3142b9ba072616","type":"tool_result","content":"1\timport {\n2\t  createSdk,\n3\t  threads,\n4\t  type Lhc,\n5\t  type OpResult,\n6\t  type SdkConfig,\n7\t  type ThreadRef,\n8\t} from \"lhc\";\n9\timport type { LhcInstance } from \"../shared/instance.js\";\n10\t\n11\t// AC-1.1, AC-1.4, AC-1.5.\n12\t\n13\t/** The connector's name for SDK construction — the agreed rename of LHC's\n14\t *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n15\t *  either way). One instance per PI session in background scheduler mode; the\n16\t *  connector never drives the queue (Flow 1). */\n17\texport function initLhc(config: SdkConfig): Lhc {\n18\t  return createSdk(config);\n19\t}\n20\t\n21\tfunction detail(cause: unknown): string {\n22\t  return cause instanceof Error ? cause.message : String(cause);\n23\t}\n24\t\n25\t/** Flush-on-dispose: await any pending background derivations for this thread,\n26\t *  then release the instance. Captured intake is already durable (intake writes\n27\t *  commit synchronously), so the flush is about letting in-flight background\n28\t *  work settle before shutdown — never a throw back into a PI hook. */\n29\tasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n30\t  try {\n31\t    await sdk.drainSettled(threadRef);\n32\t  } catch (cause) {\n33\t    return {\n34\t      ok: false,\n35\t      error: {\n36\t        errorClass: \"system_error\",\n37\t        code: \"storage_failure\",\n38\t        reason: `instance dispose flush failed: ${detail(cause)}`,\n39\t      },\n40\t    };\n41\t  }\n42\t  return { ok: true, value: undefined };\n43\t}\n44\t\n45\t/** Construct one LHC instance against a resolved thread in background scheduler\n46\t *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n47\t *  typed result rather than a half-built instance; background mode is forced\n48\t *  regardless of the caller's config so the connector cannot accidentally drive\n49\t *  the queue. A malformed inference/provider config is a programmer error and\n50\t *  throws here per LHC's construction contract — the hook guard in `index.ts`\n51\t *  contains it so nothing reaches the PI session. */\n52\texport async function initInstance(\n53\t  threadRef: ThreadRef,\n54\t  config: SdkConfig,\n55\t): Promise<OpResult<LhcInstance>> {\n56\t  const info = await threads.info(threadRef);\n57\t  if (!info.ok) return info;\n58\t\n59\t  const sdk = initLhc({ ...config, mode: \"background\" });\n60\t  const instance: LhcInstance = {\n61\t    sdk,\n62\t    threadRef,\n63\t    dispose: () => disposeSdk(sdk, threadRef),\n64\t  };\n65\t  return { ok: true, value: instance };\n66\t}\n67\t\n68\t/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n69\t *  shutdown with no live instance is a successful no-op, never an error. */\n70\texport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n71\t  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n72\t  return instance.dispose();\n73\t}\n74\t"}]},"parent_tool_use_id":null,"session_id":"a08bfa87-d15f-49ef-98e9-3889acacbbb4","uuid":"454556f3-594a-42f0-b32a-af50935aabb5","timestamp":"2026-06-14T20:42:49.922Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/instance.ts","content":"import {\n  createSdk,\n  threads,\n  type Lhc,\n  type OpResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport type { LhcInstance } from \"../shared/instance.js\";\n\n// AC-1.1, AC-1.4, AC-1.5.\n\n/** The connector's name for SDK construction — the agreed rename of LHC's\n *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n *  either way). One instance per PI session in background scheduler mode; the\n *  connector never drives the queue (Flow 1). */\nexport function initLhc(config: SdkConfig): Lhc {\n  return createSdk(config);\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n/** Flush-on-dispose: await any pending background derivations for this thread,\n *  then release the instance. Captured intake is already durable (intake writes\n *  commit synchronously), so the flush is about letting in-flight background\n *  work settle before shutdown — never a throw back into a PI hook. */\nasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n  try {\n    await sdk.drainSettled(threadRef);\n  } catch (cause) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"system_error\",\n        code: \"storage_failure\",\n        reason: `instance dispose flush failed: ${detail(cause)}`,\n      },\n    };\n  }\n  return { ok: true, value: undefined };\n}\n\n/** Construct one LHC instance against a resolved thread in background scheduler\n *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n *  typed result rather than a half-built instance; background mode is forced\n *  regardless of the caller's config so the connector cannot accidentally drive\n *  the queue. A malformed inference/provider config is a programmer error and\n *  throws here per LHC's construction contract — the hook guard in `index.ts`\n *  contains it so nothing reaches the PI session. */\nexport async function initInstance(\n  threadRef: ThreadRef,\n  config: SdkConfig,\n): Promise<OpResult<LhcInstance>> {\n  const info = await threads.info(threadRef);\n  if (!info.ok) return info;\n\n  const sdk = initLhc({ ...config, mode: \"background\" });\n  const instance: LhcInstance = {\n    sdk,\n    threadRef,\n    dispose: () => disposeSdk(sdk, threadRef),\n  };\n  return { ok: true, value: instance };\n}\n\n/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n *  shutdown with no live instance is a successful no-op, never an error. */\nexport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n  return instance.dispose();\n}\n","numLines":74,"startLine":1,"totalLines":74}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b9a31dace1ef450faf3c0860","type":"tool_result","content":"1\timport { basename } from \"node:path\";\n2\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n3\t\n4\t// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n5\t// it (tech design Flow 1). PI's own session file still exists in this\n6\t// observe-only epic — it is just not where thread identity lives.\n7\t\n8\t/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n9\t *  before this resolver — see `picker.ts`.) */\n10\texport interface LaunchFlags {\n11\t  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n12\t  continue?: boolean; // --continue / -c : most recent\n13\t  session?: string; // --session <id> : full or partial id\n14\t}\n15\t\n16\t/** What the resolver needs from the host beyond the launch flags: the cwd a new\n17\t *  thread is registered under, the registry to resolve through, and where a new\n18\t *  thread's file is created. Injected so the resolver is exercised against a\n19\t *  real temp registry in tests and the default `~/.lhc` registry in production —\n20\t *  `registryPath` is a per-operation argument, never an `initLhc` config field\n21\t *  (tech design Technical Notes). */\n22\texport interface ResolveDeps {\n23\t  cwd: string;\n24\t  registryPath?: string;\n25\t  newThreadFilePath: () => string;\n26\t  /** Title for a newly created thread (A-8 title metadata). Defaults to\n27\t   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n28\t   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n29\t   *  title from the first prompt — the open TDQ Q4). */\n30\t  newThreadTitle?: string;\n31\t}\n32\t\n33\t/** The creation-time title for a new thread when the host supplies none. At\n34\t *  session_start there is no first prompt yet, so the title is the cwd's leaf\n35\t *  directory name — a real, non-empty project label the `--resume` picker shows\n36\t *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\n37\texport function defaultThreadTitle(cwd: string): string {\n38\t  const leaf = basename(cwd);\n39\t  if (leaf !== \"\") return leaf;\n40\t  return cwd !== \"\" ? cwd : \"lhc session\";\n41\t}\n42\t\n43\t/** The durable, plain-data thread reference the connector retains and\n44\t *  reattaches from: a thread id (plus the registry it lives in), not a live\n45\t *  object. `{ filePath }` is avoided so reload reconstructs by id. */\n46\texport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n47\t  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n48\t}\n49\t\n50\t/** Spread `registryPath` into an LHC threads-call options object only when it is\n51\t *  set, so an unset registry path falls through to LHC's default rather than\n52\t *  being passed as an explicit `undefined` (rejected under\n53\t *  exactOptionalPropertyTypes). */\n54\texport function registryArg(registryPath?: string): { registryPath?: string } {\n55\t  return registryPath === undefined ? {} : { registryPath };\n56\t}\n57\t\n58\t/** Resolve the recording thread from the launch input (AC-1.6):\n59\t *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n60\t *    ambiguous fails loud (the registry returns `thread_not_found` /\n61\t *    `ambiguous_thread_id`) and never silently creates a thread.\n62\t *  - `--continue`: the most recently created thread.\n63\t *  - no flag: a new thread, registered with its cwd (AC-1.1).\n64\t *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n65\t *  durable id rather than a retained object (AC-1.5). */\n66\texport async function resolveThread(\n67\t  launch: LaunchFlags,\n68\t  deps: ResolveDeps,\n69\t): Promise<OpResult<ThreadRef>> {\n70\t  if (launch.session !== undefined) {\n71\t    const resolved = await threads.resolve({\n72\t      threadId: launch.session,\n73\t      ...registryArg(deps.registryPath),\n74\t    });\n75\t    if (!resolved.ok) return resolved;\n76\t    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n77\t  }\n78\t\n79\t  if (launch.continue === true) {\n80\t    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n81\t    if (!listed.ok) return listed;\n82\t    // The registry lists in creation order with an insertion-order tie-break,\n83\t    // so the last row is the most recently created thread.\n84\t    const mostRecent = listed.value.at(-1);\n85\t    if (mostRecent === undefined) {\n86\t      return {\n87\t        ok: false,\n88\t        error: {\n89\t          errorClass: \"caller_error\",\n90\t          code: \"thread_not_found\",\n91\t          reason: \"--continue: no threads exist to continue\",\n92\t        },\n93\t      };\n94\t    }\n95\t    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n96\t  }\n97\t\n98\t  const created = await threads.newThread({\n99\t    filePath: deps.newThreadFilePath(),\n100\t    cwd: deps.cwd,\n101\t    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n102\t    ...registryArg(deps.registryPath),\n103\t  });\n104\t  if (!created.ok) return created;\n105\t  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n106\t}\n107\t\n108\t/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n109\t *  re-initialized while the same PI session continues — re-resolve the session's\n110\t *  thread from DURABLE registry state. It reads no retained in-process memory and\n111\t *  never creates a new thread or re-prompts a picker; the resolved id comes back\n112\t *  out of the registry (the durable catalog), so reconstruction survives the loss\n113\t *  of every in-memory holder (the architecture-risk scenario).\n114\t *\n115\t *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n116\t *    Both are idempotent — resolving twice returns the same thread and creates\n117\t *    nothing — so the normal resolver already reattaches correctly.\n118\t *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n119\t *    read from the registry. A no-flag Story-1 session created exactly one thread\n120\t *    in its cwd, so that is the thread; re-running the launch instead would create\n121\t *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n122\t *\n123\t *  Returns `null` when the cwd has no thread to reattach (a reload against an\n124\t *  empty registry); the caller records a diagnostic rather than creating one.\n125\t *\n126\t *  This is the answer to \"where does the durable reload id live without a\n127\t *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n128\t *  the system of record, not in a connector field or a recovery sidecar. The\n129\t *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n130\t *  reload/fork lineage is LHC thread metadata (Feature 2+). */\n131\texport async function resolveReloadThread(\n132\t  launch: LaunchFlags,\n133\t  deps: ResolveDeps,\n134\t): Promise<OpResult<ThreadRef | null>> {\n135\t  if (launch.session !== undefined) {\n136\t    return resolveThread({ session: launch.session }, deps);\n137\t  }\n138\t  if (launch.continue === true) {\n139\t    return resolveThread({ continue: true }, deps);\n140\t  }\n141\t  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n142\t  if (!listed.ok) return listed;\n143\t  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n144\t  // the most recently created thread for this directory.\n145\t  const mostRecent = listed.value.at(-1);\n146\t  if (mostRecent === undefined) return { ok: true, value: null };\n147\t  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n148\t}\n149\t\n150\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n151\t *  so PI's launch arguments are visible on `process.argv`; this is the\n152\t *  production source of the launch mode. Supports `--session <id>`,\n153\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n154\t *  spelling for the named-session mode is an integration detail to confirm\n155\t *  against PI; see the story payload's open questions.) */\n156\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n157\t  const flags: LaunchFlags = {};\n158\t  for (let i = 0; i < argv.length; i += 1) {\n159\t    const arg = argv[i];\n160\t    if (arg === undefined) continue;\n161\t    if (arg === \"--resume\" || arg === \"-r\") {\n162\t      flags.resume = true;\n163\t    } else if (arg === \"--continue\" || arg === \"-c\") {\n164\t      flags.continue = true;\n165\t    } else if (arg === \"--session\") {\n166\t      const next = argv[i + 1];\n167\t      if (next !== undefined && !next.startsWith(\"-\")) {\n168\t        flags.session = next;\n169\t        i += 1;\n170\t      }\n171\t    } else if (arg.startsWith(\"--session=\")) {\n172\t      flags.session = arg.slice(\"--session=\".length);\n173\t    }\n174\t  }\n175\t  return flags;\n176\t}\n177\t"}]},"parent_tool_use_id":null,"session_id":"a08bfa87-d15f-49ef-98e9-3889acacbbb4","uuid":"4204b6fc-ed2e-4919-9876-bea1797e8e2c","timestamp":"2026-06-14T20:42:49.924Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/thread-resolution.ts","content":"import { basename } from \"node:path\";\nimport { threads, type OpResult, type ThreadRef } from \"lhc\";\n\n// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n// it (tech design Flow 1). PI's own session file still exists in this\n// observe-only epic — it is just not where thread identity lives.\n\n/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n *  before this resolver — see `picker.ts`.) */\nexport interface LaunchFlags {\n  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n  continue?: boolean; // --continue / -c : most recent\n  session?: string; // --session <id> : full or partial id\n}\n\n/** What the resolver needs from the host beyond the launch flags: the cwd a new\n *  thread is registered under, the registry to resolve through, and where a new\n *  thread's file is created. Injected so the resolver is exercised against a\n *  real temp registry in tests and the default `~/.lhc` registry in production —\n *  `registryPath` is a per-operation argument, never an `initLhc` config field\n *  (tech design Technical Notes). */\nexport interface ResolveDeps {\n  cwd: string;\n  registryPath?: string;\n  newThreadFilePath: () => string;\n  /** Title for a newly created thread (A-8 title metadata). Defaults to\n   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n   *  title from the first prompt — the open TDQ Q4). */\n  newThreadTitle?: string;\n}\n\n/** The creation-time title for a new thread when the host supplies none. At\n *  session_start there is no first prompt yet, so the title is the cwd's leaf\n *  directory name — a real, non-empty project label the `--resume` picker shows\n *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\nexport function defaultThreadTitle(cwd: string): string {\n  const leaf = basename(cwd);\n  if (leaf !== \"\") return leaf;\n  return cwd !== \"\" ? cwd : \"lhc session\";\n}\n\n/** The durable, plain-data thread reference the connector retains and\n *  reattaches from: a thread id (plus the registry it lives in), not a live\n *  object. `{ filePath }` is avoided so reload reconstructs by id. */\nexport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n}\n\n/** Spread `registryPath` into an LHC threads-call options object only when it is\n *  set, so an unset registry path falls through to LHC's default rather than\n *  being passed as an explicit `undefined` (rejected under\n *  exactOptionalPropertyTypes). */\nexport function registryArg(registryPath?: string): { registryPath?: string } {\n  return registryPath === undefined ? {} : { registryPath };\n}\n\n/** Resolve the recording thread from the launch input (AC-1.6):\n *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n *    ambiguous fails loud (the registry returns `thread_not_found` /\n *    `ambiguous_thread_id`) and never silently creates a thread.\n *  - `--continue`: the most recently created thread.\n *  - no flag: a new thread, registered with its cwd (AC-1.1).\n *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n *  durable id rather than a retained object (AC-1.5). */\nexport async function resolveThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef>> {\n  if (launch.session !== undefined) {\n    const resolved = await threads.resolve({\n      threadId: launch.session,\n      ...registryArg(deps.registryPath),\n    });\n    if (!resolved.ok) return resolved;\n    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n  }\n\n  if (launch.continue === true) {\n    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n    if (!listed.ok) return listed;\n    // The registry lists in creation order with an insertion-order tie-break,\n    // so the last row is the most recently created thread.\n    const mostRecent = listed.value.at(-1);\n    if (mostRecent === undefined) {\n      return {\n        ok: false,\n        error: {\n          errorClass: \"caller_error\",\n          code: \"thread_not_found\",\n          reason: \"--continue: no threads exist to continue\",\n        },\n      };\n    }\n    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n  }\n\n  const created = await threads.newThread({\n    filePath: deps.newThreadFilePath(),\n    cwd: deps.cwd,\n    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n    ...registryArg(deps.registryPath),\n  });\n  if (!created.ok) return created;\n  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n}\n\n/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n *  re-initialized while the same PI session continues — re-resolve the session's\n *  thread from DURABLE registry state. It reads no retained in-process memory and\n *  never creates a new thread or re-prompts a picker; the resolved id comes back\n *  out of the registry (the durable catalog), so reconstruction survives the loss\n *  of every in-memory holder (the architecture-risk scenario).\n *\n *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n *    Both are idempotent — resolving twice returns the same thread and creates\n *    nothing — so the normal resolver already reattaches correctly.\n *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n *    read from the registry. A no-flag Story-1 session created exactly one thread\n *    in its cwd, so that is the thread; re-running the launch instead would create\n *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n *\n *  Returns `null` when the cwd has no thread to reattach (a reload against an\n *  empty registry); the caller records a diagnostic rather than creating one.\n *\n *  This is the answer to \"where does the durable reload id live without a\n *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n *  the system of record, not in a connector field or a recovery sidecar. The\n *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n *  reload/fork lineage is LHC thread metadata (Feature 2+). */\nexport async function resolveReloadThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef | null>> {\n  if (launch.session !== undefined) {\n    return resolveThread({ session: launch.session }, deps);\n  }\n  if (launch.continue === true) {\n    return resolveThread({ continue: true }, deps);\n  }\n  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n  if (!listed.ok) return listed;\n  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n  // the most recently created thread for this directory.\n  const mostRecent = listed.value.at(-1);\n  if (mostRecent === undefined) return { ok: true, value: null };\n  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n}\n\n/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n *  so PI's launch arguments are visible on `process.argv`; this is the\n *  production source of the launch mode. Supports `--session <id>`,\n *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n *  spelling for the named-session mode is an integration detail to confirm\n *  against PI; see the story payload's open questions.) */\nexport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n  const flags: LaunchFlags = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === undefined) continue;\n    if (arg === \"--resume\" || arg === \"-r\") {\n      flags.resume = true;\n    } else if (arg === \"--continue\" || arg === \"-c\") {\n      flags.continue = true;\n    } else if (arg === \"--session\") {\n      const next = argv[i + 1];\n      if (next !== undefined && !next.startsWith(\"-\")) {\n        flags.session = next;\n        i += 1;\n      }\n    } else if (arg.startsWith(\"--session=\")) {\n      flags.session = arg.slice(\"--session=\".length);\n    }\n  }\n  return flags;\n}\n","numLines":177,"startLine":1,"totalLines":177}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d570b6b26dd14a6895e6fe09","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  MessageEventInput,\n13\t  OpResult,\n14\t  SdkConfig,\n15\t  ThreadRef,\n16\t} from \"lhc\";\n17\timport type {\n18\t  ExtensionAPI,\n19\t  ExtensionContext,\n20\t  PiHookHandler,\n21\t  PiHookName,\n22\t} from \"./pi/types.js\";\n23\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n24\timport { createSessionState } from \"./lifecycle/state.js\";\n25\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n26\timport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\n27\timport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\n28\timport { report, validateReachable } from \"./inference/startup-validation.js\";\n29\timport {\n30\t  detectForkFromSessionTree,\n31\t  forkInfoFromHook,\n32\t  seedFork,\n33\t} from \"./lifecycle/fork.js\";\n34\timport {\n35\t  parseLaunchFlags,\n36\t  resolveReloadThread,\n37\t  resolveThread,\n38\t  type LaunchFlags,\n39\t  type ResolveDeps,\n40\t} from \"./lifecycle/thread-resolution.js\";\n41\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n42\timport { threads } from \"lhc\";\n43\timport { capture, captureGap } from \"./capture/converter.js\";\n44\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n45\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n46\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n47\timport type { LhcInstance } from \"./shared/instance.js\";\n48\t\n49\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n50\texport type { LhcInstance } from \"./shared/instance.js\";\n51\t\n52\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n53\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n54\t *  registers no handler for it (story Scope Out). */\n55\texport const EPIC_1_HOOKS = [\n56\t  \"session_start\",\n57\t  \"message_end\",\n58\t  \"turn_end\",\n59\t  \"agent_end\",\n60\t  \"model_select\",\n61\t  \"thinking_level_select\",\n62\t  \"session_before_fork\",\n63\t  \"session_before_switch\",\n64\t  \"session_shutdown\",\n65\t] as const satisfies readonly PiHookName[];\n66\t\n67\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n68\t\n69\t/** What the connector needs from the host to run a session. Every dependency\n70\t *  has a working production default; the overrides exist for test isolation\n71\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n72\t *  in the PI-auth-backed inference config.\n73\t *\n74\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n75\t *  default is the observe-only config below (a real, construction-valid SDK);\n76\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n77\texport interface ConnectorDeps {\n78\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n79\t  registryPath?: string;\n80\t  newThreadFilePath?: () => string;\n81\t  parseLaunch?: () => LaunchFlags;\n82\t  selectThread?: (\n83\t    choices: readonly ThreadChoice[],\n84\t    ctx: ExtensionContext,\n85\t  ) => Promise<string | null>;\n86\t  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n87\t   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n88\t  assignmentConfig?: unknown;\n89\t}\n90\t\n91\t/** Everything the connector retains across hooks as PLAIN data — by\n92\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n93\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n94\t *  deliberately not part of the snapshot. */\n95\texport interface ConnectorSnapshot {\n96\t  state: SessionState | null;\n97\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n98\t}\n99\t\n100\texport interface Connector {\n101\t  /** Register the observe-only hook rail on the PI extension API. */\n102\t  register(pi: ExtensionAPI): void;\n103\t  /** The plain-data state retained across hooks. `null` until a session\n104\t   *  resolves a thread; never holds a PI ctx. */\n105\t  getState(): SessionState | null;\n106\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n107\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n108\t  getInstance(): LhcInstance | null;\n109\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n110\t  snapshot(): ConnectorSnapshot;\n111\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n112\t   *  synthetic ctx/events without a live PI. */\n113\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n114\t}\n115\t\n116\t/** The connector's live capture state for one session: the open-turn\n117\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n118\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n119\t *  per session, never part of the plain-data snapshot and never a PI object. */\n120\tinterface CaptureSession {\n121\t  piSessionId: string;\n122\t  accumulator: TurnAccumulator;\n123\t  sourceSeq: number;\n124\t}\n125\t\n126\t/** Fork state captured from `session_before_fork` and used on the next\n127\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n128\t *  only — no PI objects retained across the fork boundary. */\n129\tinterface PendingFork {\n130\t  sourceThreadRef: ThreadRef;\n131\t  forkEntryId: string;\n132\t}\n133\t\n134\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n135\t *  identity, which survives reload/replay (the same thread re-resolves to the\n136\t *  same id). */\n137\tfunction sessionIdOf(ref: ThreadRef): string {\n138\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n139\t}\n140\t\n141\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n142\t\n143\t/** The production SDK config for Story 5+: injects the host ModelCall function\n144\t *  that resolves provider/model through PI's registry and completes through\n145\t *  pi-ai when available. Story 6 loads assignments from config with shipped\n146\t *  defaults. */\n147\tfunction defaultBuildSdkConfig(\n148\t  ctx: ExtensionContext,\n149\t  assignmentConfig: unknown = undefined,\n150\t): OpResult<SdkConfig> {\n151\t  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n152\t  const assignments = loadAssignmentsImpl(assignmentConfig);\n153\t\n154\t  return {\n155\t    ok: true,\n156\t    value: {\n157\t      inference: {\n158\t        call: createModelCall(ctx),\n159\t        assignments,\n160\t      },\n161\t      mode: \"background\",\n162\t    },\n163\t  };\n164\t}\n165\t\n166\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n167\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n168\t *  show. */\n169\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n170\t  const lines = choices.map((choice, i) => {\n171\t    const title = choice.title ?? \"(untitled)\";\n172\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n173\t  });\n174\t  return [\n175\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n176\t    ...lines,\n177\t    choices.length === 1\n178\t      ? \"One candidate found; resuming it.\"\n179\t      : \"Select a thread from the picker, or relaunch with --session <id> in headless mode.\",\n180\t  ].join(\"\\n\");\n181\t}\n182\t\n183\t/** Default `--resume` selection. The PI extension UI exposes an async\n184\t *  selector in interactive/RPC modes, so multiple candidates are resolved by\n185\t *  operator choice. Headless mode has no input surface, so ambiguous resume\n186\t *  fails closed and the operator can use `--session <id>` for explicit attach. */\n187\tasync function defaultSelectThread(\n188\t  choices: readonly ThreadChoice[],\n189\t  ctx: ExtensionContext,\n190\t): Promise<string | null> {\n191\t  if (choices.length === 0) return null;\n192\t  if (choices.length === 1) {\n193\t    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n194\t    return choices[0]?.threadId ?? null;\n195\t  }\n196\t\n197\t  if (!ctx.hasUI || ctx.ui.select === undefined) {\n198\t    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"warn\" });\n199\t    return null;\n200\t  }\n201\t\n202\t  const labels = choices.map((choice, i) => {\n203\t    const title = choice.title ?? \"(untitled)\";\n204\t    return `${i + 1}. ${title} · created ${choice.createdAt} · ${choice.threadId}`;\n205\t  });\n206\t  const selected = await ctx.ui.select(\"pi-lhc --resume: select a thread\", labels);\n207\t  if (selected === undefined) return null;\n208\t  const index = labels.indexOf(selected);\n209\t  return index >= 0 ? choices[index]?.threadId ?? null : null;\n210\t}\n211\t\n212\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n213\t *  generated by the registry at creation, so the file name is just a unique\n214\t *  handle; the directory is ensured up front (DatabaseSync does not create\n215\t *  parents). */\n216\tfunction defaultNewThreadFilePath(): string {\n217\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n218\t  mkdirSync(dir, { recursive: true });\n219\t  return join(dir, `${randomUUID()}.sqlite`);\n220\t}\n221\t\n222\t/** Build a connector instance. Its mutable state lives in this closure; the\n223\t *  registered handlers capture it, so the instance stays live for the session\n224\t *  even when `activate` discards the returned object. The connector holds NO\n225\t *  module-level or durable state of its own — reload reconstructs the thread from\n226\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n227\t *  closure reattaches correctly (AC-1.5). */\n228\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n229\t  // The connector's retained state. `state` is plain data (the durable thread\n230\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n231\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n232\t  // none survives the connector — reload re-resolves from the registry.\n233\t  let state: SessionState | null = null;\n234\t  let instance: LhcInstance | null = null;\n235\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n236\t  let captureSession: CaptureSession | null = null;\n237\t  let pendingFork: PendingFork | null = null;\n238\t\n239\t  // Build SDK config with assignment config if provided (Story 6)\n240\t  const buildSdkConfig = deps.buildSdkConfig ??\n241\t    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n242\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n243\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n244\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n245\t\n246\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n247\t    return { code, message, recordedGap: false };\n248\t  }\n249\t\n250\t  // The registry/file deps every resolver path shares. `registryPath` is set\n251\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n252\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n253\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n254\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n255\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n256\t    return resolveDeps;\n257\t  }\n258\t\n259\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n260\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n261\t  // no-flag creates).\n262\t  async function resolveForLaunch(\n263\t    launch: LaunchFlags,\n264\t    ctx: ExtensionContext,\n265\t  ): Promise<OpResult<ThreadRef | null>> {\n266\t    if (launch.resume === true) {\n267\t      const pickerDeps: {\n268\t        registryPath?: string;\n269\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n270\t      } = { select: (choices) => selectThread(choices, ctx) };\n271\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n272\t      return pickThread(ctx.cwd, pickerDeps);\n273\t    }\n274\t    return resolveThread(launch, buildResolveDeps(ctx));\n275\t  }\n276\t\n277\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n278\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n279\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n280\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n281\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n282\t  async function resolveReloadFor(\n283\t    launch: LaunchFlags,\n284\t    ctx: ExtensionContext,\n285\t  ): Promise<OpResult<ThreadRef | null>> {\n286\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n287\t  }\n288\t\n289\t  // session_start: resolve the recording thread and construct one background\n290\t  // instance against it. Config is gated first so a session with no usable\n291\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n292\t  // thread is re-resolved from the durable registry (reattach, never create);\n293\t  // every other reason runs the normal launch resolution. Fork creates a new\n294\t  // thread and seeds it from the source thread (Story 4).\n295\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n296\t    const config = buildSdkConfig(ctx);\n297\t    if (!config.ok) {\n298\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n299\t      return;\n300\t    }\n301\t\n302\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n303\t    let forkAttempted = false;\n304\t\n305\t    // Fork path (Story 4): create a new thread and seed it from the source.\n306\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n307\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n308\t    if (pendingFork !== null) {\n309\t      forkAttempted = true;\n310\t      // Hook-based fork detection: session_before_fork fired.\n311\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n312\t\n313\t      // Create a new thread for the fork.\n314\t      const resolveDeps = buildResolveDeps(ctx);\n315\t      const newFilePath = resolveDeps.newThreadFilePath();\n316\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n317\t        filePath: newFilePath,\n318\t        cwd: resolveDeps.cwd,\n319\t      };\n320\t      if (resolveDeps.registryPath !== undefined) {\n321\t        newThreadInput.registryPath = resolveDeps.registryPath;\n322\t      }\n323\t      const created = await threads.newThread(newThreadInput);\n324\t      if (!created.ok) {\n325\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n326\t        pendingFork = null;\n327\t        state = null;\n328\t        captureSession = null;\n329\t        return;\n330\t      } else {\n331\t        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n332\t\n333\t        // Initialize the instance against the target thread first (required for seedFork).\n334\t        const built = await initInstance(targetThreadRef, config.value);\n335\t        if (!built.ok) {\n336\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n337\t          pendingFork = null;\n338\t          state = null;\n339\t          captureSession = null;\n340\t          return;\n341\t        } else {\n342\t          instance = built.value;\n343\t\n344\t          // Seed the fork by replaying source events up to the fork point.\n345\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n346\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n347\t          if (!seeded.ok) {\n348\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n349\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n350\t            pendingFork = null;\n351\t            await disposeInstance(instance);\n352\t            instance = null;\n353\t            state = null;\n354\t            captureSession = null;\n355\t            return;\n356\t          } else {\n357\t            // Fork succeeded - clear pending fork state and use the forked thread.\n358\t            pendingFork = null;\n359\t            resolved = { ok: true, value: targetThreadRef };\n360\t          }\n361\t        }\n362\t      }\n363\t    }\n364\t\n365\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n366\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n367\t    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n368\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n369\t      if (forkFromTree !== null) {\n370\t        forkAttempted = true;\n371\t        // Session tree indicates a fork - create and seed as above.\n372\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n373\t\n374\t        const resolveDeps = buildResolveDeps(ctx);\n375\t        const newFilePath = resolveDeps.newThreadFilePath();\n376\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n377\t          filePath: newFilePath,\n378\t          cwd: resolveDeps.cwd,\n379\t        };\n380\t        if (resolveDeps.registryPath !== undefined) {\n381\t          newThreadInput.registryPath = resolveDeps.registryPath;\n382\t        }\n383\t        const created = await threads.newThread(newThreadInput);\n384\t        if (!created.ok) {\n385\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n386\t          state = null;\n387\t          captureSession = null;\n388\t          return;\n389\t        } else {\n390\t          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n391\t\n392\t          const built = await initInstance(targetThreadRef, config.value);\n393\t          if (!built.ok) {\n394\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n395\t            state = null;\n396\t            captureSession = null;\n397\t            return;\n398\t          } else {\n399\t            instance = built.value;\n400\t\n401\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n402\t            if (!seeded.ok) {\n403\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n404\t              await disposeInstance(instance);\n405\t              instance = null;\n406\t              state = null;\n407\t              captureSession = null;\n408\t              return;\n409\t            } else {\n410\t              resolved = { ok: true, value: targetThreadRef };\n411\t            }\n412\t          }\n413\t        }\n414\t      }\n415\t    }\n416\t\n417\t    // Normal launch resolution (if not resolved by fork paths above).\n418\t    if (resolved === undefined) {\n419\t      const launch = parseLaunch();\n420\t      const isReload = event.reason === \"reload\";\n421\t      resolved = isReload\n422\t        ? await resolveReloadFor(launch, ctx)\n423\t        : await resolveForLaunch(launch, ctx);\n424\t    }\n425\t\n426\t    if (!resolved.ok) {\n427\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n428\t      return;\n429\t    }\n430\t    if (resolved.value === null) {\n431\t      const isReload = event.reason === \"reload\";\n432\t      lastDiagnostic = isReload\n433\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n434\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n435\t      return;\n436\t    }\n437\t\n438\t    // If instance wasn't created during fork path, create it now.\n439\t    if (instance === null) {\n440\t      const built = await initInstance(resolved.value, config.value);\n441\t      if (!built.ok) {\n442\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n443\t        return;\n444\t      }\n445\t      instance = built.value;\n446\t    }\n447\t\n448\t    state = createSessionState(resolved.value);\n449\t    const piSessionId = sessionIdOf(resolved.value);\n450\t    captureSession = {\n451\t      piSessionId,\n452\t      accumulator: new TurnAccumulator({ piSessionId }),\n453\t      sourceSeq: 0,\n454\t    };\n455\t\n456\t    // Story 6: Startup validation - probe all seven assignments before first use\n457\t    // This runs after instance creation but before capture begins (AC-5.1).\n458\t    // Validation failures are reported but do NOT stop capture (AC-5.3).\n459\t    if (config.value.inference === undefined) {\n460\t      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n461\t      return;\n462\t    }\n463\t    const assignments = config.value.inference.assignments;\n464\t    const validationReport = validateReachable(assignments, ctx);\n465\t    report(validationReport, ctx, state);\n466\t  };\n467\t\n468\t  // Dispose with flush before any session swap (session_before_switch fires\n469\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n470\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n471\t  // re-resolves its thread from the durable registry on the next session_start.\n472\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n473\t    const result = await disposeInstance(instance);\n474\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n475\t    instance = null;\n476\t    captureSession = null;\n477\t  };\n478\t\n479\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n480\t  // converter already recorded a durable gap for a writable-thread malformed\n481\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n482\t  // surfaces as an extension health signal with no gap. Neither path throws.\n483\t  function recordCaptureOutcome(\n484\t    result: OpResult<BatchResult>,\n485\t    events: readonly MessageEventInput[],\n486\t  ): void {\n487\t    if (result.ok) return;\n488\t    const recordedGap = result.error.code === \"invalid_event\";\n489\t    const failure: CaptureFailureDiagnostic = {\n490\t      code: result.error.code,\n491\t      message: result.error.reason,\n492\t      recordedGap,\n493\t    };\n494\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n495\t    lastDiagnostic = failure;\n496\t    if (state !== null) state.health.lastCaptureFailure = failure;\n497\t  }\n498\t\n499\t  function nextSourceSeq(session: CaptureSession): number {\n500\t    const sourceSeq = session.sourceSeq;\n501\t    session.sourceSeq += 1;\n502\t    return sourceSeq;\n503\t  }\n504\t\n505\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n506\t    // Last-resort id-less discriminator. PI position wins when present; the\n507\t    // connector ordinal is used only when PI gives no event identity at all.\n508\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n509\t    // order yields the same ordinal, which is the best identity available.\n510\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n511\t  }\n512\t\n513\t  async function recordMappingFailure(\n514\t    hook: string,\n515\t    position: number | undefined,\n516\t    sourceSeq: number,\n517\t    cause: unknown,\n518\t  ): Promise<void> {\n519\t    if (instance === null) return;\n520\t    const message = cause instanceof Error ? cause.message : String(cause);\n521\t    const result = await captureGap(\n522\t      fallbackIdFor(hook, position, sourceSeq),\n523\t      `${hook}: ${message}`,\n524\t      instance,\n525\t    );\n526\t    if (!result.ok) {\n527\t      recordCaptureOutcome(result, []);\n528\t      return;\n529\t    }\n530\t    const failure: CaptureFailureDiagnostic = {\n531\t      code: \"invalid_event\",\n532\t      message: `${hook}: ${message}`,\n533\t      recordedGap: true,\n534\t    };\n535\t    lastDiagnostic = failure;\n536\t    if (state !== null) state.health.lastCaptureFailure = failure;\n537\t  }\n538\t\n539\t  // message_end: map the finalized PI message to ordered LHC events, track the\n540\t  // open turn, and flush through the converter (AC-2.1).\n541\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n542\t    if (instance === null || captureSession === null) return;\n543\t    const sourceSeq = nextSourceSeq(captureSession);\n544\t    const mapCtx: MapCtx =\n545\t      event.entryId !== undefined && event.entryId !== \"\"\n546\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n547\t        : {\n548\t            piSessionId: captureSession.piSessionId,\n549\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n550\t          };\n551\t    let events: MessageEventInput[];\n552\t    try {\n553\t      events = mapMessage(event.message, mapCtx);\n554\t    } catch (cause) {\n555\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n556\t      return;\n557\t    }\n558\t    captureSession.accumulator.onMessage(events);\n559\t    if (events.length === 0) return;\n560\t    recordCaptureOutcome(await capture(events, instance), events);\n561\t  };\n562\t\n563\t  // model_select / thinking_level_select fire only in-stream — capture each as\n564\t  // an ordered runtime_note the moment it fires (AC-2.8).\n565\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n566\t    if (instance === null || captureSession === null) return;\n567\t    const sourceSeq = nextSourceSeq(captureSession);\n568\t    const mapCtx: MapCtx = {\n569\t      piSessionId: captureSession.piSessionId,\n570\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n571\t    };\n572\t    const note = mapModelSelect(event, mapCtx);\n573\t    recordCaptureOutcome(await capture([note], instance), [note]);\n574\t  };\n575\t\n576\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n577\t    if (instance === null || captureSession === null) return;\n578\t    const sourceSeq = nextSourceSeq(captureSession);\n579\t    const mapCtx: MapCtx = {\n580\t      piSessionId: captureSession.piSessionId,\n581\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n582\t    };\n583\t    const note = mapThinkingLevelSelect(event, mapCtx);\n584\t    recordCaptureOutcome(await capture([note], instance), [note]);\n585\t  };\n586\t\n587\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n588\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n589\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n590\t    if (instance === null || captureSession === null) return;\n591\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n592\t    if (turnEnd.length === 0) return;\n593\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n594\t  };\n595\t\n596\t  // Contain every handler: an observe-only hook must never throw back into PI\n597\t  // (a thrown hook breaks the user's session). A caught error becomes a\n598\t  // plain-data diagnostic; it is never rethrown.\n599\t  const guard = (\n600\t    name: Epic1Hook,\n601\t    body: PiHookHandler<Epic1Hook>,\n602\t  ): PiHookHandler<Epic1Hook> => {\n603\t    return async (ctx, event): Promise<void> => {\n604\t      try {\n605\t        await body(ctx, event);\n606\t      } catch (err) {\n607\t        lastDiagnostic = {\n608\t          code: \"hook_handler_error\",\n609\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n610\t          recordedGap: false,\n611\t        };\n612\t      }\n613\t    };\n614\t  };\n615\t\n616\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n617\t  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n618\t  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n619\t  const noop: PiHookHandler<Epic1Hook> = () => {\n620\t    // Intentionally empty — turn_end is ignored as a boundary.\n621\t  };\n622\t\n623\t  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n624\t  // The source thread ref is captured from the current session state; the hook\n625\t  // provides entryId/position identifying the fork point. No writes to the source\n626\t  // thread occur — the fork happens on the next session_start (Story 4).\n627\t  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n628\t    if (state === null) return;\n629\t    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n630\t    // Store the fork info for use on session_start{fork}.\n631\t    pendingFork = {\n632\t      sourceThreadRef: state.threadRef,\n633\t      forkEntryId: forkInfo.forkEntryId,\n634\t    };\n635\t  };\n636\t\n637\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n638\t  // are live; fork handling (Story 4) is wired.\n639\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n640\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n641\t    session_before_switch: onDispose,\n642\t    session_shutdown: onDispose,\n643\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n644\t    turn_end: noop,\n645\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n646\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n647\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n648\t    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n649\t  };\n650\t\n651\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n652\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n653\t\n654\t  return {\n655\t    handlers,\n656\t    register(pi: ExtensionAPI): void {\n657\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n658\t    },\n659\t    getState(): SessionState | null {\n660\t      return state;\n661\t    },\n662\t    getInstance(): LhcInstance | null {\n663\t      return instance;\n664\t    },\n665\t    snapshot(): ConnectorSnapshot {\n666\t      return { state, lastDiagnostic };\n667\t    },\n668\t  };\n669\t}\n670\t\n671\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n672\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n673\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n674\t *  observe-only SDK config, and the `--resume` selector that presents the\n675\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n676\t *  resolves/creates and initializes for real. On `/reload` the connector\n677\t *  re-resolves the same thread from the durable registry (it keeps no\n678\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n679\t *  config. */\n680\texport function activate(pi: ExtensionAPI): void {\n681\t  createConnector().register(pi);\n682\t}\n683\t\n684\texport default activate;\n685\t"}]},"parent_tool_use_id":null,"session_id":"a08bfa87-d15f-49ef-98e9-3889acacbbb4","uuid":"9266a40f-1d01-4a30-8037-9eab6a8f8064","timestamp":"2026-06-14T20:42:50.588Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  MessageEventInput,\n  OpResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\nimport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\nimport { report, validateReachable } from \"./inference/startup-validation.js\";\nimport {\n  detectForkFromSessionTree,\n  forkInfoFromHook,\n  seedFork,\n} from \"./lifecycle/fork.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { threads } from \"lhc\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n  assignmentConfig?: unknown;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** Fork state captured from `session_before_fork` and used on the next\n *  `session_start{fork}` to create and seed the forked thread. Plain data\n *  only — no PI objects retained across the fork boundary. */\ninterface PendingFork {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production SDK config for Story 5+: injects the host ModelCall function\n *  that resolves provider/model through PI's registry and completes through\n *  pi-ai when available. Story 6 loads assignments from config with shipped\n *  defaults. */\nfunction defaultBuildSdkConfig(\n  ctx: ExtensionContext,\n  assignmentConfig: unknown = undefined,\n): OpResult<SdkConfig> {\n  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n  const assignments = loadAssignmentsImpl(assignmentConfig);\n\n  return {\n    ok: true,\n    value: {\n      inference: {\n        call: createModelCall(ctx),\n        assignments,\n      },\n      mode: \"background\",\n    },\n  };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    choices.length === 1\n      ? \"One candidate found; resuming it.\"\n      : \"Select a thread from the picker, or relaunch with --session <id> in headless mode.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. The PI extension UI exposes an async\n *  selector in interactive/RPC modes, so multiple candidates are resolved by\n *  operator choice. Headless mode has no input surface, so ambiguous resume\n *  fails closed and the operator can use `--session <id>` for explicit attach. */\nasync function defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  if (choices.length === 0) return null;\n  if (choices.length === 1) {\n    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n    return choices[0]?.threadId ?? null;\n  }\n\n  if (!ctx.hasUI || ctx.ui.select === undefined) {\n    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"warn\" });\n    return null;\n  }\n\n  const labels = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `${i + 1}. ${title} · created ${choice.createdAt} · ${choice.threadId}`;\n  });\n  const selected = await ctx.ui.select(\"pi-lhc --resume: select a thread\", labels);\n  if (selected === undefined) return null;\n  const index = labels.indexOf(selected);\n  return index >= 0 ? choices[index]?.threadId ?? null : null;\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n  let pendingFork: PendingFork | null = null;\n\n  // Build SDK config with assignment config if provided (Story 6)\n  const buildSdkConfig = deps.buildSdkConfig ??\n    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        state = null;\n        captureSession = null;\n        return;\n      } else {\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            await disposeInstance(instance);\n            instance = null;\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        forkAttempted = true;\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              await disposeInstance(instance);\n              instance = null;\n              state = null;\n              captureSession = null;\n              return;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";\n      resolved = isReload\n        ? await resolveReloadFor(launch, ctx)\n        : await resolveForLaunch(launch, ctx);\n    }\n\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      const isReload = event.reason === \"reload\";\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n\n    // If instance wasn't created during fork path, create it now.\n    if (instance === null) {\n      const built = await initInstance(resolved.value, config.value);\n      if (!built.ok) {\n        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n        return;\n      }\n      instance = built.value;\n    }\n\n    state = createSessionState(resolved.value);\n    const piSessionId = sessionIdOf(resolved.value);\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId }),\n      sourceSeq: 0,\n    };\n\n    // Story 6: Startup validation - probe all seven assignments before first use\n    // This runs after instance creation but before capture begins (AC-5.1).\n    // Validation failures are reported but do NOT stop capture (AC-5.3).\n    if (config.value.inference === undefined) {\n      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n      return;\n    }\n    const assignments = config.value.inference.assignments;\n    const validationReport = validateReachable(assignments, ctx);\n    report(validationReport, ctx, state);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  function nextSourceSeq(session: CaptureSession): number {\n    const sourceSeq = session.sourceSeq;\n    session.sourceSeq += 1;\n    return sourceSeq;\n  }\n\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n    // Last-resort id-less discriminator. PI position wins when present; the\n    // connector ordinal is used only when PI gives no event identity at all.\n    // For id-less + position-less reload replay, PI's deterministic redelivery\n    // order yields the same ordinal, which is the best identity available.\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n  }\n\n  async function recordMappingFailure(\n    hook: string,\n    position: number | undefined,\n    sourceSeq: number,\n    cause: unknown,\n  ): Promise<void> {\n    if (instance === null) return;\n    const message = cause instanceof Error ? cause.message : String(cause);\n    const result = await captureGap(\n      fallbackIdFor(hook, position, sourceSeq),\n      `${hook}: ${message}`,\n      instance,\n    );\n    if (!result.ok) {\n      recordCaptureOutcome(result, []);\n      return;\n    }\n    const failure: CaptureFailureDiagnostic = {\n      code: \"invalid_event\",\n      message: `${hook}: ${message}`,\n      recordedGap: true,\n    };\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  // message_end: map the finalized PI message to ordered LHC events, track the\n  // open turn, and flush through the converter (AC-2.1).\n  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx =\n      event.entryId !== undefined && event.entryId !== \"\"\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n        : {\n            piSessionId: captureSession.piSessionId,\n            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n          };\n    let events: MessageEventInput[];\n    try {\n      events = mapMessage(event.message, mapCtx);\n    } catch (cause) {\n      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n      return;\n    }\n    captureSession.accumulator.onMessage(events);\n    if (events.length === 0) return;\n    recordCaptureOutcome(await capture(events, instance), events);\n  };\n\n  // model_select / thinking_level_select fire only in-stream — capture each as\n  // an ordered runtime_note the moment it fires (AC-2.8).\n  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n    };\n    const note = mapModelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n    };\n    const note = mapThinkingLevelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n    if (instance === null || captureSession === null) return;\n    const turnEnd = captureSession.accumulator.onAgentEnd();\n    if (turnEnd.length === 0) return;\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — turn_end is ignored as a boundary.\n  };\n\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n  // The source thread ref is captured from the current session state; the hook\n  // provides entryId/position identifying the fork point. No writes to the source\n  // thread occur — the fork happens on the next session_start (Story 4).\n  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n    if (state === null) return;\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n    // Store the fork info for use on session_start{fork}.\n    pendingFork = {\n      sourceThreadRef: state.threadRef,\n      forkEntryId: forkInfo.forkEntryId,\n    };\n  };\n\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n  // are live; fork handling (Story 4) is wired.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n    turn_end: noop,\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from the durable registry (it keeps no\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n *  config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":685,"startLine":1,"totalLines":685}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_166404a9571d442c8200b018","type":"tool_result","content":"1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n2\t// named recorded PI hook/lifecycle JSONL fixture paired with the LHC intake\n3\t// events it should produce. The validator PARSES and CHECKS shapes — it never\n4\t// hardcodes a passing count (story §Anti-Shim Requirements).\n5\timport { readFileSync } from \"node:fs\";\n6\timport { fileURLToPath } from \"node:url\";\n7\timport type { EventKind, MessageEventInput } from \"lhc\";\n8\timport type { Corpus, RecordedPiHookEvent } from \"../../src/verify/replay.js\";\n9\timport type { AgentMessage } from \"../../src/pi/types.js\";\n10\timport { validEvent } from \"./synthetic.js\";\n11\t\n12\tconst CORPUS_DIR = fileURLToPath(new URL(\"./pi-corpora/\", import.meta.url));\n13\t\n14\ttype CorpusRecord =\n15\t  | { recordType: \"pi_hook\"; hook: \"message_end\"; entryId: string; position?: number; message: AgentMessage }\n16\t  | { recordType: \"pi_lifecycle\"; hook: \"agent_end\"; entryId?: string; position?: number }\n17\t  | { recordType: \"expected_event\"; eventKind: EventKind; payload?: Record<string, unknown> };\n18\t\n19\tfunction loadRecordedCorpus(name: string): Corpus {\n20\t  const source: RecordedPiHookEvent[] = [];\n21\t  const expected: MessageEventInput[] = [];\n22\t  const path = `${CORPUS_DIR}${name}.jsonl`;\n23\t  for (const line of readFileSync(path, \"utf8\").trim().split(\"\\n\")) {\n24\t    if (line.trim() === \"\") continue;\n25\t    const record = JSON.parse(line) as CorpusRecord;\n26\t    if (record.recordType === \"pi_hook\") {\n27\t      if (record.hook !== \"message_end\") {\n28\t        throw new Error(`${name}: pi_hook record must be message_end`);\n29\t      }\n30\t      const sourceRecord: RecordedPiHookEvent = {\n31\t        recordType: \"pi_hook\",\n32\t        hook: \"message_end\",\n33\t        entryId: record.entryId,\n34\t        message: record.message,\n35\t      };\n36\t      if (record.position !== undefined) sourceRecord.position = record.position;\n37\t      source.push(sourceRecord);\n38\t      continue;\n39\t    }\n40\t    if (record.recordType === \"pi_lifecycle\") {\n41\t      const sourceRecord: RecordedPiHookEvent = { recordType: \"pi_lifecycle\", hook: \"agent_end\" };\n42\t      if (record.entryId !== undefined) sourceRecord.entryId = record.entryId;\n43\t      if (record.position !== undefined) sourceRecord.position = record.position;\n44\t      source.push(sourceRecord);\n45\t      continue;\n46\t    }\n47\t    if (record.recordType !== \"expected_event\") {\n48\t      throw new Error(`${name}: unsupported corpus recordType ${(record as { recordType?: unknown }).recordType}`);\n49\t    }\n50\t    const overrides = record.payload === undefined ? {} : { payload: record.payload };\n51\t    expected.push(validEvent(record.eventKind, overrides as never) as MessageEventInput);\n52\t  }\n53\t  return { name, source, expected };\n54\t}\n55\t\n56\texport const loadChattyCorpus = (): Corpus => loadRecordedCorpus(\"chatty\");\n57\texport const loadToolHeavyCorpus = (): Corpus => loadRecordedCorpus(\"tool-heavy\");\n58\texport const loadParallelToolCorpus = (): Corpus => loadRecordedCorpus(\"parallel-tool\");\n59\texport const loadErrorResultCorpus = (): Corpus => loadRecordedCorpus(\"error-result\");\n60\texport const loadAbortedTurnCorpus = (): Corpus => loadRecordedCorpus(\"aborted-turn\");\n61\t\n62\texport const CORPUS_LOADERS = {\n63\t  chatty: loadChattyCorpus,\n64\t  \"tool-heavy\": loadToolHeavyCorpus,\n65\t  \"parallel-tool\": loadParallelToolCorpus,\n66\t  \"error-result\": loadErrorResultCorpus,\n67\t  \"aborted-turn\": loadAbortedTurnCorpus,\n68\t} as const;\n69\t\n70\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n71\t\n72\texport function loadAllCorpora(): Corpus[] {\n73\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n74\t}\n75\t\n76\t/** A deliberately malformed sequence for the capture-failure test: an empty\n77\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n78\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n79\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n80\texport function makeTruncatedCorpus(): Corpus {\n81\t  return {\n82\t    name: \"truncated\",\n83\t    source: [{ recordType: \"pi_hook\", hook: \"message_end\", entryId: \"truncated-entry-0\", message: { role: \"user\", content: [{ type: \"text\", text: \"\" }] } }],\n84\t    expected: [\n85\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n86\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n87\t    ],\n88\t  };\n89\t}\n90\t\n91\texport interface CorpusValidation {\n92\t  valid: boolean;\n93\t  problems: string[];\n94\t}\n95\t\n96\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n97\t  \"user_prompt\",\n98\t  \"assistant_text\",\n99\t  \"assistant_thinking\",\n100\t  \"runtime_note\",\n101\t  \"tool_call\",\n102\t  \"tool_result\",\n103\t  \"turn_end\",\n104\t]);\n105\t\n106\t/** Check a corpus yields well-formed recorded hook shapes plus well-formed\n107\t *  `MessageEventInput` expectations, and that the expected lifecycle is coherent\n108\t *  (every `tool_result` correlates to a preceding `tool_call`; the sequence\n109\t *  closes with `turn_end`). Returns the problems it found — `valid` is derived\n110\t *  from that list, never a constant. */\n111\texport function validateCorpus(corpus: Corpus): CorpusValidation {\n112\t  const problems: string[] = [];\n113\t  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n114\t  if (corpus.source.length === 0) problems.push(`${corpus.name}: no recorded PI hook events`);\n115\t  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n116\t\n117\t  for (const [i, source] of corpus.source.entries()) {\n118\t    const at = `${corpus.name}.source[${i}]`;\n119\t    if (source.hook === \"message_end\") {\n120\t      if (source.recordType !== \"pi_hook\") problems.push(`${at}: message_end must be a pi_hook record`);\n121\t      if (source.entryId.trim() === \"\") problems.push(`${at}: empty entryId`);\n122\t      if (source.message.role !== \"user\" && source.message.role !== \"assistant\" && source.message.role !== \"toolResult\") {\n123\t        problems.push(`${at}: unsupported message role`);\n124\t      }\n125\t    } else if (source.hook === \"agent_end\") {\n126\t      if (source.recordType !== \"pi_lifecycle\") problems.push(`${at}: agent_end must be a pi_lifecycle record`);\n127\t    } else {\n128\t      problems.push(`${at}: unsupported hook`);\n129\t    }\n130\t  }\n131\t\n132\t  const seenToolCalls = new Set<string>();\n133\t  for (const [i, ev] of corpus.expected.entries()) {\n134\t    const at = `${corpus.name}.expected[${i}]`;\n135\t    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n136\t    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n137\t    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n138\t    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n139\t\n140\t    switch (ev.eventKind) {\n141\t      case \"user_prompt\":\n142\t      case \"assistant_text\":\n143\t      case \"assistant_thinking\":\n144\t      case \"runtime_note\": {\n145\t        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n146\t          problems.push(`${at}: ${ev.eventKind} has empty text`);\n147\t        }\n148\t        break;\n149\t      }\n150\t      case \"tool_call\": {\n151\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n152\t          problems.push(`${at}: tool_call has empty toolCallId`);\n153\t        } else {\n154\t          seenToolCalls.add(ev.payload.toolCallId);\n155\t        }\n156\t        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n157\t          problems.push(`${at}: tool_call has empty toolName`);\n158\t        }\n159\t        break;\n160\t      }\n161\t      case \"tool_result\": {\n162\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n163\t          problems.push(`${at}: tool_result has empty toolCallId`);\n164\t        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n165\t          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n166\t        }\n167\t        if (typeof ev.payload.content !== \"string\") {\n168\t          problems.push(`${at}: tool_result has non-string content`);\n169\t        }\n170\t        break;\n171\t      }\n172\t      case \"turn_end\":\n173\t        break;\n174\t    }\n175\t  }\n176\t\n177\t  const last = corpus.expected[corpus.expected.length - 1];\n178\t  if (last !== undefined && last.eventKind !== \"turn_end\") {\n179\t    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n180\t  }\n181\t  const lastSource = corpus.source[corpus.source.length - 1];\n182\t  if (lastSource !== undefined && lastSource.hook !== \"agent_end\") {\n183\t    problems.push(`${corpus.name}: recorded PI lifecycle does not close with agent_end`);\n184\t  }\n185\t\n186\t  return { valid: problems.length === 0, problems };\n187\t}\n188\t"}]},"parent_tool_use_id":null,"session_id":"102eec08-533c-446f-93ec-e6a10d2e4825","uuid":"95fb2da7-4c5c-47e1-95bb-f37f78b0a6d7","timestamp":"2026-06-14T21:00:01.595Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.ts","content":"// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n// named recorded PI hook/lifecycle JSONL fixture paired with the LHC intake\n// events it should produce. The validator PARSES and CHECKS shapes — it never\n// hardcodes a passing count (story §Anti-Shim Requirements).\nimport { readFileSync } from \"node:fs\";\nimport { fileURLToPath } from \"node:url\";\nimport type { EventKind, MessageEventInput } from \"lhc\";\nimport type { Corpus, RecordedPiHookEvent } from \"../../src/verify/replay.js\";\nimport type { AgentMessage } from \"../../src/pi/types.js\";\nimport { validEvent } from \"./synthetic.js\";\n\nconst CORPUS_DIR = fileURLToPath(new URL(\"./pi-corpora/\", import.meta.url));\n\ntype CorpusRecord =\n  | { recordType: \"pi_hook\"; hook: \"message_end\"; entryId: string; position?: number; message: AgentMessage }\n  | { recordType: \"pi_lifecycle\"; hook: \"agent_end\"; entryId?: string; position?: number }\n  | { recordType: \"expected_event\"; eventKind: EventKind; payload?: Record<string, unknown> };\n\nfunction loadRecordedCorpus(name: string): Corpus {\n  const source: RecordedPiHookEvent[] = [];\n  const expected: MessageEventInput[] = [];\n  const path = `${CORPUS_DIR}${name}.jsonl`;\n  for (const line of readFileSync(path, \"utf8\").trim().split(\"\\n\")) {\n    if (line.trim() === \"\") continue;\n    const record = JSON.parse(line) as CorpusRecord;\n    if (record.recordType === \"pi_hook\") {\n      if (record.hook !== \"message_end\") {\n        throw new Error(`${name}: pi_hook record must be message_end`);\n      }\n      const sourceRecord: RecordedPiHookEvent = {\n        recordType: \"pi_hook\",\n        hook: \"message_end\",\n        entryId: record.entryId,\n        message: record.message,\n      };\n      if (record.position !== undefined) sourceRecord.position = record.position;\n      source.push(sourceRecord);\n      continue;\n    }\n    if (record.recordType === \"pi_lifecycle\") {\n      const sourceRecord: RecordedPiHookEvent = { recordType: \"pi_lifecycle\", hook: \"agent_end\" };\n      if (record.entryId !== undefined) sourceRecord.entryId = record.entryId;\n      if (record.position !== undefined) sourceRecord.position = record.position;\n      source.push(sourceRecord);\n      continue;\n    }\n    if (record.recordType !== \"expected_event\") {\n      throw new Error(`${name}: unsupported corpus recordType ${(record as { recordType?: unknown }).recordType}`);\n    }\n    const overrides = record.payload === undefined ? {} : { payload: record.payload };\n    expected.push(validEvent(record.eventKind, overrides as never) as MessageEventInput);\n  }\n  return { name, source, expected };\n}\n\nexport const loadChattyCorpus = (): Corpus => loadRecordedCorpus(\"chatty\");\nexport const loadToolHeavyCorpus = (): Corpus => loadRecordedCorpus(\"tool-heavy\");\nexport const loadParallelToolCorpus = (): Corpus => loadRecordedCorpus(\"parallel-tool\");\nexport const loadErrorResultCorpus = (): Corpus => loadRecordedCorpus(\"error-result\");\nexport const loadAbortedTurnCorpus = (): Corpus => loadRecordedCorpus(\"aborted-turn\");\n\nexport const CORPUS_LOADERS = {\n  chatty: loadChattyCorpus,\n  \"tool-heavy\": loadToolHeavyCorpus,\n  \"parallel-tool\": loadParallelToolCorpus,\n  \"error-result\": loadErrorResultCorpus,\n  \"aborted-turn\": loadAbortedTurnCorpus,\n} as const;\n\nexport type CorpusName = keyof typeof CORPUS_LOADERS;\n\nexport function loadAllCorpora(): Corpus[] {\n  return Object.values(CORPUS_LOADERS).map((load) => load());\n}\n\n/** A deliberately malformed sequence for the capture-failure test: an empty\n *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n *  proving the validator actually inspects shape rather than rubber-stamping. */\nexport function makeTruncatedCorpus(): Corpus {\n  return {\n    name: \"truncated\",\n    source: [{ recordType: \"pi_hook\", hook: \"message_end\", entryId: \"truncated-entry-0\", message: { role: \"user\", content: [{ type: \"text\", text: \"\" }] } }],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n    ],\n  };\n}\n\nexport interface CorpusValidation {\n  valid: boolean;\n  problems: string[];\n}\n\nconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n  \"user_prompt\",\n  \"assistant_text\",\n  \"assistant_thinking\",\n  \"runtime_note\",\n  \"tool_call\",\n  \"tool_result\",\n  \"turn_end\",\n]);\n\n/** Check a corpus yields well-formed recorded hook shapes plus well-formed\n *  `MessageEventInput` expectations, and that the expected lifecycle is coherent\n *  (every `tool_result` correlates to a preceding `tool_call`; the sequence\n *  closes with `turn_end`). Returns the problems it found — `valid` is derived\n *  from that list, never a constant. */\nexport function validateCorpus(corpus: Corpus): CorpusValidation {\n  const problems: string[] = [];\n  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n  if (corpus.source.length === 0) problems.push(`${corpus.name}: no recorded PI hook events`);\n  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n\n  for (const [i, source] of corpus.source.entries()) {\n    const at = `${corpus.name}.source[${i}]`;\n    if (source.hook === \"message_end\") {\n      if (source.recordType !== \"pi_hook\") problems.push(`${at}: message_end must be a pi_hook record`);\n      if (source.entryId.trim() === \"\") problems.push(`${at}: empty entryId`);\n      if (source.message.role !== \"user\" && source.message.role !== \"assistant\" && source.message.role !== \"toolResult\") {\n        problems.push(`${at}: unsupported message role`);\n      }\n    } else if (source.hook === \"agent_end\") {\n      if (source.recordType !== \"pi_lifecycle\") problems.push(`${at}: agent_end must be a pi_lifecycle record`);\n    } else {\n      problems.push(`${at}: unsupported hook`);\n    }\n  }\n\n  const seenToolCalls = new Set<string>();\n  for (const [i, ev] of corpus.expected.entries()) {\n    const at = `${corpus.name}.expected[${i}]`;\n    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n\n    switch (ev.eventKind) {\n      case \"user_prompt\":\n      case \"assistant_text\":\n      case \"assistant_thinking\":\n      case \"runtime_note\": {\n        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n          problems.push(`${at}: ${ev.eventKind} has empty text`);\n        }\n        break;\n      }\n      case \"tool_call\": {\n        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n          problems.push(`${at}: tool_call has empty toolCallId`);\n        } else {\n          seenToolCalls.add(ev.payload.toolCallId);\n        }\n        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n          problems.push(`${at}: tool_call has empty toolName`);\n        }\n        break;\n      }\n      case \"tool_result\": {\n        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n          problems.push(`${at}: tool_result has empty toolCallId`);\n        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n        }\n        if (typeof ev.payload.content !== \"string\") {\n          problems.push(`${at}: tool_result has non-string content`);\n        }\n        break;\n      }\n      case \"turn_end\":\n        break;\n    }\n  }\n\n  const last = corpus.expected[corpus.expected.length - 1];\n  if (last !== undefined && last.eventKind !== \"turn_end\") {\n    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n  }\n  const lastSource = corpus.source[corpus.source.length - 1];\n  if (lastSource !== undefined && lastSource.hook !== \"agent_end\") {\n    problems.push(`${corpus.name}: recorded PI lifecycle does not close with agent_end`);\n  }\n\n  return { valid: problems.length === 0, problems };\n}\n","numLines":188,"startLine":1,"totalLines":188}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_da0d5f8b2f514e538bbeddd2","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  MessageEventInput,\n13\t  OpResult,\n14\t  SdkConfig,\n15\t  ThreadRef,\n16\t} from \"lhc\";\n17\timport type {\n18\t  ExtensionAPI,\n19\t  ExtensionContext,\n20\t  PiHookHandler,\n21\t  PiHookName,\n22\t} from \"./pi/types.js\";\n23\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n24\timport { createSessionState } from \"./lifecycle/state.js\";\n25\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n26\timport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\n27\timport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\n28\timport { report, validateReachable } from \"./inference/startup-validation.js\";\n29\timport {\n30\t  detectForkFromSessionTree,\n31\t  forkInfoFromHook,\n32\t  seedFork,\n33\t} from \"./lifecycle/fork.js\";\n34\timport {\n35\t  parseLaunchFlags,\n36\t  resolveReloadThread,\n37\t  resolveThread,\n38\t  threadRefById,\n39\t  type LaunchFlags,\n40\t  type ResolveDeps,\n41\t} from \"./lifecycle/thread-resolution.js\";\n42\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n43\timport { threads } from \"lhc\";\n44\timport { capture, captureGap } from \"./capture/converter.js\";\n45\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n46\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n47\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n48\timport type { LhcInstance } from \"./shared/instance.js\";\n49\t\n50\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n51\texport type { LhcInstance } from \"./shared/instance.js\";\n52\t\n53\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n54\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n55\t *  registers no handler for it (story Scope Out). */\n56\texport const EPIC_1_HOOKS = [\n57\t  \"session_start\",\n58\t  \"message_end\",\n59\t  \"turn_end\",\n60\t  \"agent_end\",\n61\t  \"model_select\",\n62\t  \"thinking_level_select\",\n63\t  \"session_before_fork\",\n64\t  \"session_before_switch\",\n65\t  \"session_shutdown\",\n66\t] as const satisfies readonly PiHookName[];\n67\t\n68\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n69\t\n70\t/** What the connector needs from the host to run a session. Every dependency\n71\t *  has a working production default; the overrides exist for test isolation\n72\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n73\t *  in the PI-auth-backed inference config.\n74\t *\n75\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n76\t *  default is the observe-only config below (a real, construction-valid SDK);\n77\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n78\texport interface ConnectorDeps {\n79\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n80\t  registryPath?: string;\n81\t  newThreadFilePath?: () => string;\n82\t  parseLaunch?: () => LaunchFlags;\n83\t  selectThread?: (\n84\t    choices: readonly ThreadChoice[],\n85\t    ctx: ExtensionContext,\n86\t  ) => Promise<string | null>;\n87\t  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n88\t   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n89\t  assignmentConfig?: unknown;\n90\t}\n91\t\n92\t/** Everything the connector retains across hooks as PLAIN data — by\n93\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n94\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n95\t *  deliberately not part of the snapshot. */\n96\texport interface ConnectorSnapshot {\n97\t  state: SessionState | null;\n98\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n99\t}\n100\t\n101\texport interface Connector {\n102\t  /** Register the observe-only hook rail on the PI extension API. */\n103\t  register(pi: ExtensionAPI): void;\n104\t  /** The plain-data state retained across hooks. `null` until a session\n105\t   *  resolves a thread; never holds a PI ctx. */\n106\t  getState(): SessionState | null;\n107\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n108\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n109\t  getInstance(): LhcInstance | null;\n110\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n111\t  snapshot(): ConnectorSnapshot;\n112\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n113\t   *  synthetic ctx/events without a live PI. */\n114\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n115\t}\n116\t\n117\t/** The connector's live capture state for one session: the open-turn\n118\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n119\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n120\t *  per session, never part of the plain-data snapshot and never a PI object. */\n121\tinterface CaptureSession {\n122\t  piSessionId: string;\n123\t  accumulator: TurnAccumulator;\n124\t  sourceSeq: number;\n125\t}\n126\t\n127\t/** Fork state captured from `session_before_fork` and used on the next\n128\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n129\t *  only — no PI objects retained across the fork boundary. */\n130\tinterface PendingFork {\n131\t  sourceThreadRef: ThreadRef;\n132\t  forkEntryId: string;\n133\t}\n134\t\n135\tconst THREAD_ENTRY_TYPE = \"pi-lhc.thread\";\n136\t\n137\tinterface DurableThreadEntry {\n138\t  threadId: string;\n139\t  registryPath?: string;\n140\t}\n141\t\n142\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n143\t *  identity, which survives reload/replay (the same thread re-resolves to the\n144\t *  same id). */\n145\tfunction sessionIdOf(ref: ThreadRef): string {\n146\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n147\t}\n148\t\n149\tfunction durableThreadEntryOf(ref: ThreadRef): DurableThreadEntry | null {\n150\t  if (!(\"threadId\" in ref)) return null;\n151\t  const entry: DurableThreadEntry = { threadId: ref.threadId };\n152\t  if (ref.registryPath !== undefined) entry.registryPath = ref.registryPath;\n153\t  return entry;\n154\t}\n155\t\n156\tfunction readDurableThreadId(ctx: ExtensionContext): string | null {\n157\t  const entries = ctx.sessionManager.getEntries();\n158\t  for (let i = entries.length - 1; i >= 0; i -= 1) {\n159\t    const entry = entries[i];\n160\t    if (entry === undefined || entry.type !== THREAD_ENTRY_TYPE) continue;\n161\t    const data = typeof entry.data === \"object\" && entry.data !== null\n162\t      ? (entry.data as Record<string, unknown>)\n163\t      : entry;\n164\t    const threadId = data.threadId;\n165\t    if (typeof threadId === \"string\" && threadId !== \"\") return threadId;\n166\t  }\n167\t  return null;\n168\t}\n169\t\n170\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n171\t\n172\t/** The production SDK config for Story 5+: injects the host ModelCall function\n173\t *  that resolves provider/model through PI's registry and completes through\n174\t *  pi-ai when available. Story 6 loads assignments from config with shipped\n175\t *  defaults. */\n176\tfunction defaultBuildSdkConfig(\n177\t  ctx: ExtensionContext,\n178\t  assignmentConfig: unknown = undefined,\n179\t): OpResult<SdkConfig> {\n180\t  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n181\t  const assignments = loadAssignmentsImpl(assignmentConfig);\n182\t\n183\t  return {\n184\t    ok: true,\n185\t    value: {\n186\t      inference: {\n187\t        call: createModelCall(ctx),\n188\t        assignments,\n189\t      },\n190\t      mode: \"background\",\n191\t    },\n192\t  };\n193\t}\n194\t\n195\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n196\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n197\t *  show. */\n198\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n199\t  const lines = choices.map((choice, i) => {\n200\t    const title = choice.title ?? \"(untitled)\";\n201\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n202\t  });\n203\t  return [\n204\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n205\t    ...lines,\n206\t    choices.length === 1\n207\t      ? \"One candidate found; resuming it.\"\n208\t      : \"Select a thread from the picker, or relaunch with --session <id> in headless mode.\",\n209\t  ].join(\"\\n\");\n210\t}\n211\t\n212\t/** Default `--resume` selection. The PI extension UI exposes an async\n213\t *  selector in interactive/RPC modes, so multiple candidates are resolved by\n214\t *  operator choice. Headless mode has no input surface, so ambiguous resume\n215\t *  fails closed and the operator can use `--session <id>` for explicit attach. */\n216\tasync function defaultSelectThread(\n217\t  choices: readonly ThreadChoice[],\n218\t  ctx: ExtensionContext,\n219\t): Promise<string | null> {\n220\t  if (choices.length === 0) return null;\n221\t  if (choices.length === 1) {\n222\t    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n223\t    return choices[0]?.threadId ?? null;\n224\t  }\n225\t\n226\t  if (!ctx.hasUI || ctx.ui.select === undefined) {\n227\t    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"warn\" });\n228\t    return null;\n229\t  }\n230\t\n231\t  const labels = choices.map((choice, i) => {\n232\t    const title = choice.title ?? \"(untitled)\";\n233\t    return `${i + 1}. ${title} · created ${choice.createdAt} · ${choice.threadId}`;\n234\t  });\n235\t  const selected = await ctx.ui.select(\"pi-lhc --resume: select a thread\", labels);\n236\t  if (selected === undefined) return null;\n237\t  const index = labels.indexOf(selected);\n238\t  return index >= 0 ? choices[index]?.threadId ?? null : null;\n239\t}\n240\t\n241\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n242\t *  generated by the registry at creation, so the file name is just a unique\n243\t *  handle; the directory is ensured up front (DatabaseSync does not create\n244\t *  parents). */\n245\tfunction defaultNewThreadFilePath(): string {\n246\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n247\t  mkdirSync(dir, { recursive: true });\n248\t  return join(dir, `${randomUUID()}.sqlite`);\n249\t}\n250\t\n251\t/** Build a connector instance. Its mutable state lives in this closure; the\n252\t *  registered handlers capture it, so the instance stays live for the session\n253\t *  even when `activate` discards the returned object. The connector holds NO\n254\t *  module-level state of its own — reload reconstructs the thread from the\n255\t *  durable PI session entry and resolves that threadId through the LHC registry,\n256\t *  so a fresh connector with an empty closure reattaches correctly (AC-1.5). */\n257\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n258\t  // The connector's retained state. `state` is plain data (the durable thread\n259\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n260\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n261\t  // none survives the connector — reload re-resolves from the registry.\n262\t  let state: SessionState | null = null;\n263\t  let instance: LhcInstance | null = null;\n264\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n265\t  let captureSession: CaptureSession | null = null;\n266\t  let pendingFork: PendingFork | null = null;\n267\t  let appendThreadEntry: ((entry: DurableThreadEntry) => void) | null = null;\n268\t\n269\t  // Build SDK config with assignment config if provided (Story 6)\n270\t  const buildSdkConfig = deps.buildSdkConfig ??\n271\t    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n272\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n273\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n274\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n275\t\n276\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n277\t    return { code, message, recordedGap: false };\n278\t  }\n279\t\n280\t  // The registry/file deps every resolver path shares. `registryPath` is set\n281\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n282\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n283\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n284\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n285\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n286\t    return resolveDeps;\n287\t  }\n288\t\n289\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n290\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n291\t  // no-flag creates).\n292\t  async function resolveForLaunch(\n293\t    launch: LaunchFlags,\n294\t    ctx: ExtensionContext,\n295\t  ): Promise<OpResult<ThreadRef | null>> {\n296\t    if (launch.resume === true) {\n297\t      const pickerDeps: {\n298\t        registryPath?: string;\n299\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n300\t      } = { select: (choices) => selectThread(choices, ctx) };\n301\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n302\t      return pickThread(ctx.cwd, pickerDeps);\n303\t    }\n304\t    return resolveThread(launch, buildResolveDeps(ctx));\n305\t  }\n306\t\n307\t  // Reload resolution (AC-1.5): read the exact prior threadId PI durably\n308\t  // replayed in the current session entries. No cwd-most-recent fallback.\n309\t  async function resolveReloadFor(ctx: ExtensionContext): Promise<OpResult<ThreadRef | null>> {\n310\t    return resolveReloadThread(readDurableThreadId(ctx), buildResolveDeps(ctx));\n311\t  }\n312\t\n313\t  // session_start: resolve the recording thread and construct one background\n314\t  // instance against it. Config is gated first so a session with no usable\n315\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n316\t  // thread is re-resolved from the durable registry (reattach, never create);\n317\t  // every other reason runs the normal launch resolution. Fork creates a new\n318\t  // thread and seeds it from the source thread (Story 4).\n319\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n320\t    const config = buildSdkConfig(ctx);\n321\t    if (!config.ok) {\n322\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n323\t      return;\n324\t    }\n325\t\n326\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n327\t    let forkAttempted = false;\n328\t\n329\t    // Fork path (Story 4): create a new thread and seed it from the source.\n330\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n331\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n332\t    if (pendingFork !== null) {\n333\t      forkAttempted = true;\n334\t      // Hook-based fork detection: session_before_fork fired.\n335\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n336\t\n337\t      // Create a new thread for the fork.\n338\t      const resolveDeps = buildResolveDeps(ctx);\n339\t      const newFilePath = resolveDeps.newThreadFilePath();\n340\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n341\t        filePath: newFilePath,\n342\t        cwd: resolveDeps.cwd,\n343\t      };\n344\t      if (resolveDeps.registryPath !== undefined) {\n345\t        newThreadInput.registryPath = resolveDeps.registryPath;\n346\t      }\n347\t      const created = await threads.newThread(newThreadInput);\n348\t      if (!created.ok) {\n349\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n350\t        pendingFork = null;\n351\t        state = null;\n352\t        captureSession = null;\n353\t        return;\n354\t      } else {\n355\t        const targetThreadRef: ThreadRef = threadRefById(created.value.threadId, deps.registryPath);\n356\t\n357\t        // Initialize the instance against the target thread first (required for seedFork).\n358\t        const built = await initInstance(targetThreadRef, config.value);\n359\t        if (!built.ok) {\n360\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n361\t          pendingFork = null;\n362\t          state = null;\n363\t          captureSession = null;\n364\t          return;\n365\t        } else {\n366\t          instance = built.value;\n367\t\n368\t          // Seed the fork by replaying source events up to the fork point.\n369\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n370\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n371\t          if (!seeded.ok) {\n372\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n373\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n374\t            pendingFork = null;\n375\t            await disposeInstance(instance);\n376\t            instance = null;\n377\t            state = null;\n378\t            captureSession = null;\n379\t            return;\n380\t          } else {\n381\t            // Fork succeeded - clear pending fork state and use the forked thread.\n382\t            pendingFork = null;\n383\t            resolved = { ok: true, value: targetThreadRef };\n384\t          }\n385\t        }\n386\t      }\n387\t    }\n388\t\n389\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n390\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n391\t    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n392\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n393\t      if (forkFromTree !== null) {\n394\t        forkAttempted = true;\n395\t        // Session tree indicates a fork - create and seed as above.\n396\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n397\t\n398\t        const resolveDeps = buildResolveDeps(ctx);\n399\t        const newFilePath = resolveDeps.newThreadFilePath();\n400\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n401\t          filePath: newFilePath,\n402\t          cwd: resolveDeps.cwd,\n403\t        };\n404\t        if (resolveDeps.registryPath !== undefined) {\n405\t          newThreadInput.registryPath = resolveDeps.registryPath;\n406\t        }\n407\t        const created = await threads.newThread(newThreadInput);\n408\t        if (!created.ok) {\n409\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n410\t          state = null;\n411\t          captureSession = null;\n412\t          return;\n413\t        } else {\n414\t          const targetThreadRef: ThreadRef = threadRefById(created.value.threadId, deps.registryPath);\n415\t\n416\t          const built = await initInstance(targetThreadRef, config.value);\n417\t          if (!built.ok) {\n418\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n419\t            state = null;\n420\t            captureSession = null;\n421\t            return;\n422\t          } else {\n423\t            instance = built.value;\n424\t\n425\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n426\t            if (!seeded.ok) {\n427\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n428\t              await disposeInstance(instance);\n429\t              instance = null;\n430\t              state = null;\n431\t              captureSession = null;\n432\t              return;\n433\t            } else {\n434\t              resolved = { ok: true, value: targetThreadRef };\n435\t            }\n436\t          }\n437\t        }\n438\t      }\n439\t    }\n440\t\n441\t    // Normal launch resolution (if not resolved by fork paths above).\n442\t    if (resolved === undefined) {\n443\t      const launch = parseLaunch();\n444\t      const isReload = event.reason === \"reload\";\n445\t      resolved = isReload\n446\t        ? await resolveReloadFor(ctx)\n447\t        : await resolveForLaunch(launch, ctx);\n448\t    }\n449\t\n450\t    if (!resolved.ok) {\n451\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n452\t      return;\n453\t    }\n454\t    if (resolved.value === null) {\n455\t      const isReload = event.reason === \"reload\";\n456\t      lastDiagnostic = isReload\n457\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n458\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n459\t      return;\n460\t    }\n461\t\n462\t    // If instance wasn't created during fork path, create it now.\n463\t    if (instance === null) {\n464\t      const built = await initInstance(resolved.value, config.value);\n465\t      if (!built.ok) {\n466\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n467\t        return;\n468\t      }\n469\t      instance = built.value;\n470\t    }\n471\t\n472\t    state = createSessionState(resolved.value);\n473\t    const durableEntry = durableThreadEntryOf(resolved.value);\n474\t    if (durableEntry !== null) appendThreadEntry?.(durableEntry);\n475\t    const piSessionId = sessionIdOf(resolved.value);\n476\t    captureSession = {\n477\t      piSessionId,\n478\t      accumulator: new TurnAccumulator({ piSessionId }),\n479\t      sourceSeq: 0,\n480\t    };\n481\t\n482\t    // Story 6: Startup validation - probe all seven assignments before first use\n483\t    // This runs after instance creation but before capture begins (AC-5.1).\n484\t    // Validation failures are reported but do NOT stop capture (AC-5.3).\n485\t    if (config.value.inference === undefined) {\n486\t      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n487\t      return;\n488\t    }\n489\t    const assignments = config.value.inference.assignments;\n490\t    const validationReport = validateReachable(assignments, ctx);\n491\t    report(validationReport, ctx, state);\n492\t  };\n493\t\n494\t  // Dispose with flush before any session swap (session_before_switch fires\n495\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n496\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n497\t  // re-resolves its thread from the durable registry on the next session_start.\n498\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n499\t    const result = await disposeInstance(instance);\n500\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n501\t    instance = null;\n502\t    captureSession = null;\n503\t  };\n504\t\n505\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n506\t  // converter already recorded a durable gap for a writable-thread malformed\n507\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n508\t  // surfaces as an extension health signal with no gap. Neither path throws.\n509\t  function recordCaptureOutcome(\n510\t    result: OpResult<BatchResult>,\n511\t    events: readonly MessageEventInput[],\n512\t  ): void {\n513\t    if (result.ok) return;\n514\t    const recordedGap = result.error.code === \"invalid_event\";\n515\t    const failure: CaptureFailureDiagnostic = {\n516\t      code: result.error.code,\n517\t      message: result.error.reason,\n518\t      recordedGap,\n519\t    };\n520\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n521\t    lastDiagnostic = failure;\n522\t    if (state !== null) state.health.lastCaptureFailure = failure;\n523\t  }\n524\t\n525\t  function nextSourceSeq(session: CaptureSession): number {\n526\t    const sourceSeq = session.sourceSeq;\n527\t    session.sourceSeq += 1;\n528\t    return sourceSeq;\n529\t  }\n530\t\n531\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n532\t    // Last-resort id-less discriminator. PI position wins when present; the\n533\t    // connector ordinal is used only when PI gives no event identity at all.\n534\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n535\t    // order yields the same ordinal, which is the best identity available.\n536\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n537\t  }\n538\t\n539\t  async function recordMappingFailure(\n540\t    hook: string,\n541\t    position: number | undefined,\n542\t    sourceSeq: number,\n543\t    cause: unknown,\n544\t  ): Promise<void> {\n545\t    if (instance === null) return;\n546\t    const message = cause instanceof Error ? cause.message : String(cause);\n547\t    const result = await captureGap(\n548\t      fallbackIdFor(hook, position, sourceSeq),\n549\t      `${hook}: ${message}`,\n550\t      instance,\n551\t    );\n552\t    if (!result.ok) {\n553\t      recordCaptureOutcome(result, []);\n554\t      return;\n555\t    }\n556\t    const failure: CaptureFailureDiagnostic = {\n557\t      code: \"invalid_event\",\n558\t      message: `${hook}: ${message}`,\n559\t      recordedGap: true,\n560\t    };\n561\t    lastDiagnostic = failure;\n562\t    if (state !== null) state.health.lastCaptureFailure = failure;\n563\t  }\n564\t\n565\t  // message_end: map the finalized PI message to ordered LHC events, track the\n566\t  // open turn, and flush through the converter (AC-2.1).\n567\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n568\t    if (instance === null || captureSession === null) return;\n569\t    const sourceSeq = nextSourceSeq(captureSession);\n570\t    const mapCtx: MapCtx =\n571\t      event.entryId !== undefined && event.entryId !== \"\"\n572\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n573\t        : {\n574\t            piSessionId: captureSession.piSessionId,\n575\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n576\t          };\n577\t    let events: MessageEventInput[];\n578\t    try {\n579\t      events = mapMessage(event.message, mapCtx);\n580\t    } catch (cause) {\n581\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n582\t      return;\n583\t    }\n584\t    captureSession.accumulator.onMessage(events);\n585\t    if (events.length === 0) return;\n586\t    recordCaptureOutcome(await capture(events, instance), events);\n587\t  };\n588\t\n589\t  // model_select / thinking_level_select fire only in-stream — capture each as\n590\t  // an ordered runtime_note the moment it fires (AC-2.8).\n591\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n592\t    if (instance === null || captureSession === null) return;\n593\t    const sourceSeq = nextSourceSeq(captureSession);\n594\t    const mapCtx: MapCtx = {\n595\t      piSessionId: captureSession.piSessionId,\n596\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n597\t    };\n598\t    const note = mapModelSelect(event, mapCtx);\n599\t    recordCaptureOutcome(await capture([note], instance), [note]);\n600\t  };\n601\t\n602\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n603\t    if (instance === null || captureSession === null) return;\n604\t    const sourceSeq = nextSourceSeq(captureSession);\n605\t    const mapCtx: MapCtx = {\n606\t      piSessionId: captureSession.piSessionId,\n607\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n608\t    };\n609\t    const note = mapThinkingLevelSelect(event, mapCtx);\n610\t    recordCaptureOutcome(await capture([note], instance), [note]);\n611\t  };\n612\t\n613\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n614\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n615\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n616\t    if (instance === null || captureSession === null) return;\n617\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n618\t    if (turnEnd.length === 0) return;\n619\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n620\t  };\n621\t\n622\t  // Contain every handler: an observe-only hook must never throw back into PI\n623\t  // (a thrown hook breaks the user's session). A caught error becomes a\n624\t  // plain-data diagnostic; it is never rethrown.\n625\t  const guard = (\n626\t    name: Epic1Hook,\n627\t    body: PiHookHandler<Epic1Hook>,\n628\t  ): PiHookHandler<Epic1Hook> => {\n629\t    return async (ctx, event): Promise<void> => {\n630\t      try {\n631\t        await body(ctx, event);\n632\t      } catch (err) {\n633\t        lastDiagnostic = {\n634\t          code: \"hook_handler_error\",\n635\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n636\t          recordedGap: false,\n637\t        };\n638\t      }\n639\t    };\n640\t  };\n641\t\n642\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n643\t  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n644\t  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n645\t  const noop: PiHookHandler<Epic1Hook> = () => {\n646\t    // Intentionally empty — turn_end is ignored as a boundary.\n647\t  };\n648\t\n649\t  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n650\t  // The source thread ref is captured from the current session state; the hook\n651\t  // provides entryId/position identifying the fork point. No writes to the source\n652\t  // thread occur — the fork happens on the next session_start (Story 4).\n653\t  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n654\t    if (state === null) return;\n655\t    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n656\t    // Store the fork info for use on session_start{fork}.\n657\t    pendingFork = {\n658\t      sourceThreadRef: state.threadRef,\n659\t      forkEntryId: forkInfo.forkEntryId,\n660\t    };\n661\t  };\n662\t\n663\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n664\t  // are live; fork handling (Story 4) is wired.\n665\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n666\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n667\t    session_before_switch: onDispose,\n668\t    session_shutdown: onDispose,\n669\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n670\t    turn_end: noop,\n671\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n672\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n673\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n674\t    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n675\t  };\n676\t\n677\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n678\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n679\t\n680\t  return {\n681\t    handlers,\n682\t    register(pi: ExtensionAPI): void {\n683\t      appendThreadEntry = (entry) => {\n684\t        pi.appendEntry(THREAD_ENTRY_TYPE, entry);\n685\t      };\n686\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n687\t    },\n688\t    getState(): SessionState | null {\n689\t      return state;\n690\t    },\n691\t    getInstance(): LhcInstance | null {\n692\t      return instance;\n693\t    },\n694\t    snapshot(): ConnectorSnapshot {\n695\t      return { state, lastDiagnostic };\n696\t    },\n697\t  };\n698\t}\n699\t\n700\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n701\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n702\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n703\t *  observe-only SDK config, and the `--resume` selector that presents the\n704\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n705\t *  resolves/creates and initializes for real. On `/reload` the connector\n706\t *  re-resolves the same thread from PI's durable `pi-lhc.thread` session entry\n707\t *  and the LHC registry (it keeps no module-level handoff state). Stories 5/6\n708\t *  swap in the PI-auth-backed inference config. */\n709\texport function activate(pi: ExtensionAPI): void {\n710\t  createConnector().register(pi);\n711\t}\n712\t\n713\texport default activate;\n714\t"}]},"parent_tool_use_id":null,"session_id":"102eec08-533c-446f-93ec-e6a10d2e4825","uuid":"7e26333e-83b5-47e0-a55d-fdf48ec8311d","timestamp":"2026-06-14T21:00:14.214Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  MessageEventInput,\n  OpResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\nimport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\nimport { report, validateReachable } from \"./inference/startup-validation.js\";\nimport {\n  detectForkFromSessionTree,\n  forkInfoFromHook,\n  seedFork,\n} from \"./lifecycle/fork.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  threadRefById,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { threads } from \"lhc\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n  assignmentConfig?: unknown;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** Fork state captured from `session_before_fork` and used on the next\n *  `session_start{fork}` to create and seed the forked thread. Plain data\n *  only — no PI objects retained across the fork boundary. */\ninterface PendingFork {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\nconst THREAD_ENTRY_TYPE = \"pi-lhc.thread\";\n\ninterface DurableThreadEntry {\n  threadId: string;\n  registryPath?: string;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nfunction durableThreadEntryOf(ref: ThreadRef): DurableThreadEntry | null {\n  if (!(\"threadId\" in ref)) return null;\n  const entry: DurableThreadEntry = { threadId: ref.threadId };\n  if (ref.registryPath !== undefined) entry.registryPath = ref.registryPath;\n  return entry;\n}\n\nfunction readDurableThreadId(ctx: ExtensionContext): string | null {\n  const entries = ctx.sessionManager.getEntries();\n  for (let i = entries.length - 1; i >= 0; i -= 1) {\n    const entry = entries[i];\n    if (entry === undefined || entry.type !== THREAD_ENTRY_TYPE) continue;\n    const data = typeof entry.data === \"object\" && entry.data !== null\n      ? (entry.data as Record<string, unknown>)\n      : entry;\n    const threadId = data.threadId;\n    if (typeof threadId === \"string\" && threadId !== \"\") return threadId;\n  }\n  return null;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production SDK config for Story 5+: injects the host ModelCall function\n *  that resolves provider/model through PI's registry and completes through\n *  pi-ai when available. Story 6 loads assignments from config with shipped\n *  defaults. */\nfunction defaultBuildSdkConfig(\n  ctx: ExtensionContext,\n  assignmentConfig: unknown = undefined,\n): OpResult<SdkConfig> {\n  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n  const assignments = loadAssignmentsImpl(assignmentConfig);\n\n  return {\n    ok: true,\n    value: {\n      inference: {\n        call: createModelCall(ctx),\n        assignments,\n      },\n      mode: \"background\",\n    },\n  };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    choices.length === 1\n      ? \"One candidate found; resuming it.\"\n      : \"Select a thread from the picker, or relaunch with --session <id> in headless mode.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. The PI extension UI exposes an async\n *  selector in interactive/RPC modes, so multiple candidates are resolved by\n *  operator choice. Headless mode has no input surface, so ambiguous resume\n *  fails closed and the operator can use `--session <id>` for explicit attach. */\nasync function defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  if (choices.length === 0) return null;\n  if (choices.length === 1) {\n    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n    return choices[0]?.threadId ?? null;\n  }\n\n  if (!ctx.hasUI || ctx.ui.select === undefined) {\n    if (ctx.hasUI) ctx.ui.notify(renderResumeCandidates(choices), { level: \"warn\" });\n    return null;\n  }\n\n  const labels = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `${i + 1}. ${title} · created ${choice.createdAt} · ${choice.threadId}`;\n  });\n  const selected = await ctx.ui.select(\"pi-lhc --resume: select a thread\", labels);\n  if (selected === undefined) return null;\n  const index = labels.indexOf(selected);\n  return index >= 0 ? choices[index]?.threadId ?? null : null;\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level state of its own — reload reconstructs the thread from the\n *  durable PI session entry and resolves that threadId through the LHC registry,\n *  so a fresh connector with an empty closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n  let pendingFork: PendingFork | null = null;\n  let appendThreadEntry: ((entry: DurableThreadEntry) => void) | null = null;\n\n  // Build SDK config with assignment config if provided (Story 6)\n  const buildSdkConfig = deps.buildSdkConfig ??\n    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): read the exact prior threadId PI durably\n  // replayed in the current session entries. No cwd-most-recent fallback.\n  async function resolveReloadFor(ctx: ExtensionContext): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(readDurableThreadId(ctx), buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        state = null;\n        captureSession = null;\n        return;\n      } else {\n        const targetThreadRef: ThreadRef = threadRefById(created.value.threadId, deps.registryPath);\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            await disposeInstance(instance);\n            instance = null;\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        forkAttempted = true;\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          const targetThreadRef: ThreadRef = threadRefById(created.value.threadId, deps.registryPath);\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              await disposeInstance(instance);\n              instance = null;\n              state = null;\n              captureSession = null;\n              return;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";\n      resolved = isReload\n        ? await resolveReloadFor(ctx)\n        : await resolveForLaunch(launch, ctx);\n    }\n\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      const isReload = event.reason === \"reload\";\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n\n    // If instance wasn't created during fork path, create it now.\n    if (instance === null) {\n      const built = await initInstance(resolved.value, config.value);\n      if (!built.ok) {\n        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n        return;\n      }\n      instance = built.value;\n    }\n\n    state = createSessionState(resolved.value);\n    const durableEntry = durableThreadEntryOf(resolved.value);\n    if (durableEntry !== null) appendThreadEntry?.(durableEntry);\n    const piSessionId = sessionIdOf(resolved.value);\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId }),\n      sourceSeq: 0,\n    };\n\n    // Story 6: Startup validation - probe all seven assignments before first use\n    // This runs after instance creation but before capture begins (AC-5.1).\n    // Validation failures are reported but do NOT stop capture (AC-5.3).\n    if (config.value.inference === undefined) {\n      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n      return;\n    }\n    const assignments = config.value.inference.assignments;\n    const validationReport = validateReachable(assignments, ctx);\n    report(validationReport, ctx, state);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  function nextSourceSeq(session: CaptureSession): number {\n    const sourceSeq = session.sourceSeq;\n    session.sourceSeq += 1;\n    return sourceSeq;\n  }\n\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n    // Last-resort id-less discriminator. PI position wins when present; the\n    // connector ordinal is used only when PI gives no event identity at all.\n    // For id-less + position-less reload replay, PI's deterministic redelivery\n    // order yields the same ordinal, which is the best identity available.\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n  }\n\n  async function recordMappingFailure(\n    hook: string,\n    position: number | undefined,\n    sourceSeq: number,\n    cause: unknown,\n  ): Promise<void> {\n    if (instance === null) return;\n    const message = cause instanceof Error ? cause.message : String(cause);\n    const result = await captureGap(\n      fallbackIdFor(hook, position, sourceSeq),\n      `${hook}: ${message}`,\n      instance,\n    );\n    if (!result.ok) {\n      recordCaptureOutcome(result, []);\n      return;\n    }\n    const failure: CaptureFailureDiagnostic = {\n      code: \"invalid_event\",\n      message: `${hook}: ${message}`,\n      recordedGap: true,\n    };\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  // message_end: map the finalized PI message to ordered LHC events, track the\n  // open turn, and flush through the converter (AC-2.1).\n  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx =\n      event.entryId !== undefined && event.entryId !== \"\"\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n        : {\n            piSessionId: captureSession.piSessionId,\n            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n          };\n    let events: MessageEventInput[];\n    try {\n      events = mapMessage(event.message, mapCtx);\n    } catch (cause) {\n      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n      return;\n    }\n    captureSession.accumulator.onMessage(events);\n    if (events.length === 0) return;\n    recordCaptureOutcome(await capture(events, instance), events);\n  };\n\n  // model_select / thinking_level_select fire only in-stream — capture each as\n  // an ordered runtime_note the moment it fires (AC-2.8).\n  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n    };\n    const note = mapModelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n    };\n    const note = mapThinkingLevelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n    if (instance === null || captureSession === null) return;\n    const turnEnd = captureSession.accumulator.onAgentEnd();\n    if (turnEnd.length === 0) return;\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — turn_end is ignored as a boundary.\n  };\n\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n  // The source thread ref is captured from the current session state; the hook\n  // provides entryId/position identifying the fork point. No writes to the source\n  // thread occur — the fork happens on the next session_start (Story 4).\n  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n    if (state === null) return;\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n    // Store the fork info for use on session_start{fork}.\n    pendingFork = {\n      sourceThreadRef: state.threadRef,\n      forkEntryId: forkInfo.forkEntryId,\n    };\n  };\n\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n  // are live; fork handling (Story 4) is wired.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n    turn_end: noop,\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      appendThreadEntry = (entry) => {\n        pi.appendEntry(THREAD_ENTRY_TYPE, entry);\n      };\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from PI's durable `pi-lhc.thread` session entry\n *  and the LHC registry (it keeps no module-level handoff state). Stories 5/6\n *  swap in the PI-auth-backed inference config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":714,"startLine":1,"totalLines":714}}}

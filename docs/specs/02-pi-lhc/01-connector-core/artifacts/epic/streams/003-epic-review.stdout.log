{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/lifecycle/picker.ts | sed -n '1,220p'\"","aggregated_output":"     1\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n     2\timport { registryArg, threadRefById } from \"./thread-resolution.js\";\n     3\t\n     4\t// AC-1.7.\n     5\t\n     6\t/** One row the picker offers: enough to show the operator what they are\n     7\t *  resuming — its title (when set) and creation time — keyed by the id the\n     8\t *  selection resolves. */\n     9\texport interface ThreadChoice {\n    10\t  threadId: string;\n    11\t  title?: string;\n    12\t  createdAt: string;\n    13\t}\n    14\t\n    15\t/** What the picker needs from the host: the registry to list/resolve through,\n    16\t *  and the selection mechanism. `select` is injected so the picker stays a thin,\n    17\t *  headless-safe registry operation — a real UI in production, a deterministic\n    18\t *  choice in tests — and returns the chosen thread id, or `null` to cancel. */\n    19\texport interface PickerDeps {\n    20\t  registryPath?: string;\n    21\t  select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n    22\t}\n    23\t\n    24\t/** `--resume`/`-r`: list the current cwd's threads (title + creation time) and\n    25\t *  resolve the operator's selection. The cwd scope is the registry query, not a\n    26\t *  filter over an unscoped list (anti-shim). With no threads for the cwd the\n    27\t *  picker reports an empty list (`null`) rather than failing; a cancelled\n    28\t *  selection is likewise `null`. */\n    29\texport async function pickThread(\n    30\t  cwd: string,\n    31\t  deps: PickerDeps,\n    32\t): Promise<OpResult<ThreadRef | null>> {\n    33\t  const listed = await threads.listThreads({ cwd, ...registryArg(deps.registryPath) });\n    34\t  if (!listed.ok) return listed;\n    35\t  if (listed.value.length === 0) return { ok: true, value: null };\n    36\t\n    37\t  const choices: ThreadChoice[] = listed.value.map((info) => {\n    38\t    const choice: ThreadChoice = { threadId: info.threadId, createdAt: info.createdAt };\n    39\t    if (info.title !== undefined) choice.title = info.title;\n    40\t    return choice;\n    41\t  });\n    42\t\n    43\t  const chosen = await deps.select(choices);\n    44\t  if (chosen === null) return { ok: true, value: null };\n    45\t\n    46\t  const resolved = await threads.resolve({ threadId: chosen, ...registryArg(deps.registryPath) });\n    47\t  if (!resolved.ok) return resolved;\n    48\t  return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n    49\t}\n","exit_code":0,"status":"completed"}}

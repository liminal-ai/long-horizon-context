{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/assignments.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// AC-5.4, AC-5.5. Load the seven assignments from config; fail loud on\n     2\t// missing/unknown/placeholder.\n     3\t//\n     4\t// Assignments provide provider, model, and prompt for all seven derivation\n     5\t// kinds. LHC's createSdk already validates assignment shape at construction\n     6\t// (all seven kinds present, non-empty provider/model, prompt-name registered).\n     7\t// This layer adds operator config loading on top, with user overrides that\n     8\t// take effect on the next session start (no code change).\n     9\t//\n    10\t// Shipped defaults are defined in model-call.ts (defaultAssignments). This\n    11\t// module merges operator config over those defaults and validates the result.\n    12\t\n    13\timport type { FormKind, ModelAssignment } from \"lhc\";\n    14\timport { DEFAULT_PROMPT_NAMES, FORM_KINDS } from \"lhc\";\n    15\timport { defaultAssignments } from \"./model-call.js\";\n    16\t\n    17\t/** Operator config shape for derivation assignments.\n    18\t *\n    19\t *  Each key is optional; missing kinds use the shipped default. Values override\n    20\t *  provider, model, or prompt for that kind. An assignment is incomplete if it\n    21\t *  omits any of provider, model, or prompt (fails loud at load, per AC-5.5).\n    22\t *\n    23\t *  Example:\n    24\t *  {\n    25\t *    smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: \"custom-smoothing\" },\n    26\t *    tool_call_summary: { provider: \"anthropic\", model: \"claude-3-opus\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary }\n    27\t *  }\n    28\t */\n    29\texport interface AssignmentConfig {\n    30\t  [key: string]: Partial<ModelAssignment> | undefined;\n    31\t}\n    32\t\n    33\t/** Error thrown when an assignment is incomplete or references an unknown prompt.\n    34\t *  Carries the kind and the specific validation problem for actionable error\n    35\t *  reporting (AC-5.5: \"fails loudly at initialization with an actionable error\"). */\n    36\texport class AssignmentValidationError extends Error {\n    37\t  readonly kind: FormKind;\n    38\t  readonly problem: \"incomplete\" | \"unknown_prompt\" | \"placeholder\";\n    39\t\n    40\t  constructor(kind: FormKind, problem: \"incomplete\" | \"unknown_prompt\" | \"placeholder\") {\n    41\t    let message: string;\n    42\t    switch (problem) {\n    43\t      case \"incomplete\":\n    44\t        message = `Assignment for '${kind}' is incomplete: must specify provider, model, and prompt`;\n    45\t        break;\n    46\t      case \"unknown_prompt\":\n    47\t        message = `Assignment for '${kind}' references an unknown prompt: prompt must be registered in LHC's prompt registry`;\n    48\t        break;\n    49\t      case \"placeholder\":\n    50\t        message = `Assignment for '${kind}' contains placeholder values: provider and model must be concrete identifiers`;\n    51\t        break;\n    52\t    }\n    53\t    super(message);\n    54\t    this.name = \"AssignmentValidationError\";\n    55\t    this.kind = kind;\n    56\t    this.problem = problem;\n    57\t  }\n    58\t}\n    59\t\n    60\t/** Check if an assignment is complete (has provider, model, and prompt). */\n    61\tfunction isComplete(assignment: Partial<ModelAssignment>): assignment is ModelAssignment {\n    62\t  return (\n    63\t    assignment.provider !== undefined &&\n    64\t    assignment.model !== undefined &&\n    65\t    assignment.prompt !== undefined\n    66\t  );\n    67\t}\n    68\t\n    69\t/** Check if an assignment contains placeholder values that would mask misconfiguration. */\n    70\tfunction hasPlaceholder(assignment: ModelAssignment): boolean {\n    71\t  const placeholderPatterns = [\n    72\t    \"unconfigured\",\n    73\t    \"placeholder\",\n    74\t    \"example\",\n    75\t    \"your-\",\n    76\t    \"your_provider\",\n    77\t    \"your-model\",\n    78\t    \"your_model\",\n    79\t  ];\n    80\t  const providerLower = assignment.provider.toLowerCase();\n    81\t  const modelLower = assignment.model.toLowerCase();\n    82\t\n    83\t  return placeholderPatterns.some((pattern) =>\n    84\t    providerLower.includes(pattern) || modelLower.includes(pattern)\n    85\t  );\n    86\t}\n    87\t\n    88\t/** Check if a prompt name is registered in LHC's prompt registry. */\n    89\tfunction isPromptRegistered(promptName: string): boolean {\n    90\t  return Object.values(DEFAULT_PROMPT_NAMES).includes(promptName);\n    91\t}\n    92\t\n    93\t/** Validate a single assignment and throw if it fails shape checks. */\n    94\tfunction validateAssignment(kind: FormKind, assignment: Partial<ModelAssignment>): ModelAssignment {\n    95\t  if (!isComplete(assignment)) {\n    96\t    throw new AssignmentValidationError(kind, \"incomplete\");\n    97\t  }\n    98\t\n    99\t  // Check for placeholder values (AC-5.6: placeholder fails loud)\n   100\t  if (hasPlaceholder(assignment)) {\n   101\t    throw new AssignmentValidationError(kind, \"placeholder\");\n   102\t  }\n   103\t\n   104\t  // Check that the prompt is registered (AC-5.4: prompt must name a registered prompt)\n   105\t  if (!isPromptRegistered(assignment.prompt)) {\n   106\t    throw new AssignmentValidationError(kind, \"unknown_prompt\");\n   107\t  }\n   108\t\n   109\t  return assignment;\n   110\t}\n   111\t\n   112\t/** Load + shape-validate the seven derivation assignments from operator config.\n   113\t *\n   114\t *  - Merges operator config over shipped defaults (AC-5.4).\n   115\t *  - Falls back to defaults when config is missing or undefined (AC-5.4).\n   116\t *  - User overrides take effect on next session start with no code change (AC-5.5).\n   117\t *  - Incomplete assignments fail loud at initialization (AC-5.5, TC-5.6).\n   118\t *  - Unknown prompts fail loud at initialization (TC-5.6).\n   119\t *  - Placeholder values fail loud at initialization (TC-5.6).\n   120\t *\n   121\t *  This function throws `AssignmentValidationError` on any validation failure;\n   122\t *  the caller (typically the session_start hook) catches and surfaces the error\n   123\t *  as an actionable diagnostic. It never returns an incomplete or placeholder map\n   124\t *  that would mask a misconfiguration (story §Anti-Shim Requirements). */\n   125\texport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n   126\t  // Start with shipped defaults (all seven kinds with concrete assignments)\n   127\t  const baseAssignments = defaultAssignments() as Partial<Record<FormKind, ModelAssignment>>;\n   128\t  const mergedAssignments: Partial<Record<FormKind, ModelAssignment>> = {};\n   129\t\n   130\t  for (const kind of FORM_KINDS) {\n   131\t    mergedAssignments[kind] = validateAssignment(kind, baseAssignments[kind] ?? {});\n   132\t  }\n   133\t\n   134\t  // If config is missing/null/undefined, use defaults as-is\n   135\t  if (config === null || config === undefined || typeof config !== \"object\") {\n   136\t    return mergedAssignments as Record<FormKind, ModelAssignment>;\n   137\t  }\n   138\t\n   139\t  const configObj = config as Partial<Record<FormKind, Partial<ModelAssignment>>>;\n   140\t\n   141\t  // Check for unknown assignment keys (SV-002: fail loud on extra keys)\n   142\t  const configKeys = Object.keys(configObj) as Array<string>;\n   143\t  for (const key of configKeys) {\n   144\t    if (key !== \"\" && !FORM_KINDS.includes(key as FormKind)) {\n   145\t      throw new Error(`Unknown assignment key '${key}': must be one of ${FORM_KINDS.join(\", \")}`);\n   146\t    }\n   147\t  }\n   148\t\n   149\t  // Merge operator config over defaults for kinds that are specified\n   150\t  for (const kind of FORM_KINDS) {\n   151\t    const override = configObj[kind as FormKind];\n   152\t    if (override !== undefined) {\n   153\t      mergedAssignments[kind] = validateAssignment(kind, override);\n   154\t    }\n   155\t  }\n   156\t\n   157\t  // At this point we have validated all seven kinds (FORM_KINDS covers all seven)\n   158\t  return mergedAssignments as Record<FormKind, ModelAssignment>;\n   159\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/model-call.ts | sed -n '1,340p'\"","aggregated_output":"     1\t// AC-4.1..4.4. The host-supplied ModelCall function.\n     2\t//\n     3\t// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n     4\t// a production-valid boundary, and classifies failures into the LHC contract.\n     5\t// Provider/model are opaque routing keys — the connector does not interpret them.\n     6\t//\n     7\t// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n     8\t// registry and completes through @earendil-works/pi-ai when that package is\n     9\t// available in the host runtime. If the runtime does not provide pi-ai, the host\n    10\t// returns a classified failure; it never fabricates completion text.\n    11\t//\n    12\t// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n    13\t// @earendil-works/pi-ai (package not yet available).\n    14\t\n    15\timport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\n    16\timport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\n    17\timport type { PiAiComplete } from \"./pi-ai.js\";\n    18\t\n    19\tinterface ModelCallDeps {\n    20\t  complete?: PiAiComplete;\n    21\t}\n    22\t\n    23\t/** Extract the text content from an AssistantMessage-like shape. */\n    24\tfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n    25\t  const content = message.content ?? [];\n    26\t  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n    27\t  return textParts.map((part) => part.text as string).join(\"\\n\");\n    28\t}\n    29\t\n    30\t/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n    31\t *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n    32\t *  thrown → other). */\n    33\texport function classifyFailure(err: unknown): ModelCallFailureKind {\n    34\t  // Guard: non-object errors fall through to \"other\"\n    35\t  if (typeof err !== \"object\" || err === null) {\n    36\t    return \"other\";\n    37\t  }\n    38\t\n    39\t  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n    40\t  const code = errorLike.code?.toLowerCase() ?? \"\";\n    41\t  const type = errorLike.type?.toLowerCase() ?? \"\";\n    42\t  const message = errorLike.message?.toLowerCase() ?? \"\";\n    43\t\n    44\t  // Check for auth failures (terminal)\n    45\t  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n    46\t  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    47\t    return \"auth\";\n    48\t  }\n    49\t\n    50\t  // Check for invalid request (terminal)\n    51\t  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n    52\t  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    53\t    return \"invalid_request\";\n    54\t  }\n    55\t\n    56\t  // Check for rate limit (retryable)\n    57\t  const rateLimitPatterns = [\"rate\", \"429\"];\n    58\t  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    59\t    return \"rate_limit\";\n    60\t  }\n    61\t\n    62\t  // Check for timeout (retryable)\n    63\t  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n    64\t  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    65\t    return \"timeout\";\n    66\t  }\n    67\t\n    68\t  // Check for network errors (retryable)\n    69\t  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n    70\t  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    71\t    return \"network\";\n    72\t  }\n    73\t\n    74\t  // Default for unknown errors\n    75\t  return \"other\";\n    76\t}\n    77\t\n    78\tasync function importPiAiComplete(): Promise<PiAiComplete> {\n    79\t  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n    80\t    specifier: string,\n    81\t  ) => Promise<unknown>;\n    82\t  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n    83\t  const complete = (loaded as { complete?: unknown }).complete;\n    84\t  if (typeof complete !== \"function\") {\n    85\t    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n    86\t      code: \"invalid_request\",\n    87\t    });\n    88\t  }\n    89\t  return complete as PiAiComplete;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Production ModelCall implementation using PI's model registry and pi-ai.\n    94\t *\n    95\t * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n    96\t * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n    97\t * when the host runtime provides it.\n    98\t */\n    99\texport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n   100\t  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n   101\t    // Resolve the model through PI's registry\n   102\t    const resolved = ctx.modelRegistry.find(provider, model);\n   103\t    if (resolved === undefined) {\n   104\t      // Unknown model - treat as invalid request (terminal)\n   105\t      return {\n   106\t        ok: false,\n   107\t        kind: \"invalid_request\",\n   108\t        message: `Model not found in registry: ${provider}/${model}`,\n   109\t      };\n   110\t    }\n   111\t\n   112\t    // Check if auth is configured\n   113\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n   114\t      // No auth - treat as auth failure (terminal)\n   115\t      return {\n   116\t        ok: false,\n   117\t        kind: \"auth\",\n   118\t        message: `No configured auth for model: ${provider}/${model}`,\n   119\t      };\n   120\t    }\n   121\t\n   122\t    // Complete through pi-ai. Tests may inject this seam; production loads the\n   123\t    // host package at runtime so pi-lhc does not publish fabricated text when\n   124\t    // the host dependency is absent.\n   125\t    try {\n   126\t      const complete = deps.complete ?? await importPiAiComplete();\n   127\t      const response = await complete(resolved, { messages });\n   128\t\n   129\t      // Extract text from the response\n   130\t      const text = extractAssistantText(response);\n   131\t\n   132\t      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n   133\t      // empty_output is classified by LHC's adapter, not by the host function.\n   134\t      // The host function returns text-or-failure only, even if the text is empty.\n   135\t      return { ok: true, text };\n   136\t    } catch (err) {\n   137\t      // Classify the error into a ModelCallFailureKind\n   138\t      const kind = classifyFailure(err);\n   139\t      const message = err instanceof Error ? err.message : String(err);\n   140\t      return { ok: false, kind, message };\n   141\t    }\n   142\t  };\n   143\t}\n   144\t\n   145\t/**\n   146\t * Default assignments for all seven FormKinds.\n   147\t *\n   148\t * Story 6 implements config loading; these defaults use a real PI registry\n   149\t * lane, so the shipped production path can resolve through createModelCall().\n   150\t */\n   151\t// PI v0.79.2 ships openai-codex/gpt-5.4 in its built-in catalog and records it\n   152\t// as the default openai-codex model (pi-coding-agent CHANGELOG: GPT-5.4 support\n   153\t// across openai/openai-codex, with gpt-5.4 now the default). This is the\n   154\t// production-reachable dial-in default Story 6 requires; unavailable auth is\n   155\t// still reported by startup validation rather than hidden behind a test provider.\n   156\texport const DEFAULT_PI_MODEL = { provider: \"openai-codex\", id: \"gpt-5.4\" } as const;\n   157\t\n   158\texport function defaultAssignments(\n   159\t  model: { provider: string; id: string } = DEFAULT_PI_MODEL,\n   160\t): Record<string, { provider: string; model: string; prompt: string }> {\n   161\t  return {\n   162\t    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   163\t    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   164\t    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   165\t    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   166\t    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   167\t    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   168\t    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   169\t  };\n   170\t}\n","exit_code":0,"status":"completed"}}

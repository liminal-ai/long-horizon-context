{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f99f03263e40443f8b34fd46","type":"tool_result","content":"1\t// AC-5.1, AC-5.2, AC-5.3. Startup validation: probe all seven assignments\n2\t// against PI's registry, report unreachable lanes, leave capture running.\n3\t//\n4\t// This layer runs AFTER shape validation (which LHC's createSdk enforces at\n5\t// construction). It adds a reachability probe on top: for each assignment,\n6\t// check that the provider/model pair exists in PI's registry and that auth is\n7\t// configured. This surfaces misconfigurations before the first derivation use,\n8\t// rather than as a silent derivation failure later (AC-5.1).\n9\t//\n10\t// Reporting must not assume a TUI (AC-5.2). The report surfaces through ctx.ui\n11\t// when available and always persists to SessionState.health for headless modes.\n12\t\n13\timport { writeSync } from \"node:fs\";\n14\timport type { FormKind, ModelAssignment } from \"lhc\";\n15\timport { FORM_KINDS } from \"lhc\";\n16\timport type { ExtensionContext } from \"../pi/types.js\";\n17\timport type { SessionState } from \"../lifecycle/state.js\";\n18\timport type { ValidationReport } from \"../shared/diagnostics.js\";\n19\t\n20\t// Re-export ValidationReport from its spec'd home (defined in shared/diagnostics\n21\t// so SessionState can reference it without a lifecycle→inference edge).\n22\texport type { ValidationReport };\n23\t\n24\tinterface ReportDeps {\n25\t  headlessLog?: (message: string) => void;\n26\t}\n27\t\n28\tfunction defaultHeadlessLog(message: string): void {\n29\t  writeSync(2, `${message}\\n`);\n30\t}\n31\t\n32\t/** Probe each assignment; classify unreachable lanes (AC-5.1, AC-5.2).\n33\t *\n34\t *  For each of the seven derivation kinds:\n35\t *  1. Call ctx.modelRegistry.find(provider, model) to check if the lane exists.\n36\t *  2. If found, call ctx.modelRegistry.hasConfiguredAuth(handle) to check auth.\n37\t *  3. Classify the failure:\n38\t *     - \"unknown_model\": provider/model not found in registry → fix assignment\n39\t *     - \"auth_not_configured\": lane exists but no auth → log in / configure auth\n40\t *\n41\t *  Returns a structured report listing all unreachable lanes with their fixes.\n42\t *  Reachable lanes are not listed; an empty `unreachable` array means all lanes\n43\t *  are reachable (AC-5.1). */\n44\texport function validateReachable(\n45\t  assignments: Record<FormKind, ModelAssignment>,\n46\t  ctx: ExtensionContext,\n47\t): ValidationReport {\n48\t  const unreachable: ValidationReport[\"unreachable\"] = [];\n49\t\n50\t  for (const kind of FORM_KINDS) {\n51\t    const assignment = assignments[kind as FormKind];\n52\t    const { provider, model } = assignment;\n53\t\n54\t    // Check if the model exists in PI's registry\n55\t    const resolved = ctx.modelRegistry.find(provider, model);\n56\t\n57\t    if (resolved === undefined) {\n58\t      // Unknown lane: provider/model not found → fix assignment\n59\t      unreachable.push({\n60\t        kind,\n61\t        provider,\n62\t        model,\n63\t        reason: \"unknown_model\",\n64\t        fix: `Update '${kind}' assignment to use a known provider/model pair available in PI's model registry`,\n65\t      });\n66\t      continue; // Skip auth check for unknown models\n67\t    }\n68\t\n69\t    // Lane exists; check if auth is configured\n70\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n71\t      // Known lane but no auth → log in / configure auth\n72\t      unreachable.push({\n73\t        kind,\n74\t        provider,\n75\t        model,\n76\t        reason: \"auth_not_configured\",\n77\t        fix: `Log in or configure auth for ${provider}/${model} in PI settings`,\n78\t      });\n79\t    }\n80\t  }\n81\t\n82\t  return { unreachable };\n83\t}\n84\t\n85\t/** Surface unreachable lanes via ctx.ui when available + structured diagnostic.\n86\t *\n87\t *  Reporting is headless-safe (AC-5.2):\n88\t *  - If ctx.hasUI is true, surface through ctx.ui.notify with a formatted report.\n89\t *  - Always persist the structured ValidationReport to SessionState.health.\n90\t *  - Capture continues running even when validation fails (AC-5.3).\n91\t *\n92\t *  This function never throws; validation failures are diagnostic, not fatal.\n93\t *  The affected lane's derivations will fail classified and queryable through\n94\t *  health (AC-5.3), but the session itself remains functional for capture. */\n95\texport function report(\n96\t  r: ValidationReport,\n97\t  ctx: ExtensionContext,\n98\t  state: SessionState,\n99\t  deps: ReportDeps = {},\n100\t): void {\n101\t  // Mark that we've reported startup validation (avoids duplicate reporting)\n102\t  state.flags.startupValidationReported = true;\n103\t\n104\t  // If there are unreachable lanes, surface them through ctx.ui when available\n105\t  if (r.unreachable.length > 0) {\n106\t    const lines = [\n107\t      \"pi-lhc startup validation: unreachable derivation lanes\",\n108\t      \"\",\n109\t      ...r.unreachable.map(\n110\t        (u) =>\n111\t          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n112\t      ),\n113\t      \"\",\n114\t      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n115\t    ];\n116\t\n117\t    const message = lines.join(\"\\n\");\n118\t    state.health.startupValidation = { ...r, message };\n119\t\n120\t    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n121\t    if (ctx.hasUI) {\n122\t      ctx.ui.notify(message, { level: \"warn\" });\n123\t    } else {\n124\t      const headlessLog = deps.headlessLog ?? defaultHeadlessLog;\n125\t      headlessLog(message);\n126\t    }\n127\t  } else {\n128\t    // Persist the structured report to SessionState.health (always, even in headless)\n129\t    state.health.startupValidation = r;\n130\t  }\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"54bb6891-be78-43f8-a277-229ffe48e3f0","uuid":"116cd37b-56f6-4b37-bac5-d817d2db0c9b","timestamp":"2026-06-14T13:48:27.186Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/startup-validation.ts","content":"// AC-5.1, AC-5.2, AC-5.3. Startup validation: probe all seven assignments\n// against PI's registry, report unreachable lanes, leave capture running.\n//\n// This layer runs AFTER shape validation (which LHC's createSdk enforces at\n// construction). It adds a reachability probe on top: for each assignment,\n// check that the provider/model pair exists in PI's registry and that auth is\n// configured. This surfaces misconfigurations before the first derivation use,\n// rather than as a silent derivation failure later (AC-5.1).\n//\n// Reporting must not assume a TUI (AC-5.2). The report surfaces through ctx.ui\n// when available and always persists to SessionState.health for headless modes.\n\nimport { writeSync } from \"node:fs\";\nimport type { FormKind, ModelAssignment } from \"lhc\";\nimport { FORM_KINDS } from \"lhc\";\nimport type { ExtensionContext } from \"../pi/types.js\";\nimport type { SessionState } from \"../lifecycle/state.js\";\nimport type { ValidationReport } from \"../shared/diagnostics.js\";\n\n// Re-export ValidationReport from its spec'd home (defined in shared/diagnostics\n// so SessionState can reference it without a lifecycle→inference edge).\nexport type { ValidationReport };\n\ninterface ReportDeps {\n  headlessLog?: (message: string) => void;\n}\n\nfunction defaultHeadlessLog(message: string): void {\n  writeSync(2, `${message}\\n`);\n}\n\n/** Probe each assignment; classify unreachable lanes (AC-5.1, AC-5.2).\n *\n *  For each of the seven derivation kinds:\n *  1. Call ctx.modelRegistry.find(provider, model) to check if the lane exists.\n *  2. If found, call ctx.modelRegistry.hasConfiguredAuth(handle) to check auth.\n *  3. Classify the failure:\n *     - \"unknown_model\": provider/model not found in registry → fix assignment\n *     - \"auth_not_configured\": lane exists but no auth → log in / configure auth\n *\n *  Returns a structured report listing all unreachable lanes with their fixes.\n *  Reachable lanes are not listed; an empty `unreachable` array means all lanes\n *  are reachable (AC-5.1). */\nexport function validateReachable(\n  assignments: Record<FormKind, ModelAssignment>,\n  ctx: ExtensionContext,\n): ValidationReport {\n  const unreachable: ValidationReport[\"unreachable\"] = [];\n\n  for (const kind of FORM_KINDS) {\n    const assignment = assignments[kind as FormKind];\n    const { provider, model } = assignment;\n\n    // Check if the model exists in PI's registry\n    const resolved = ctx.modelRegistry.find(provider, model);\n\n    if (resolved === undefined) {\n      // Unknown lane: provider/model not found → fix assignment\n      unreachable.push({\n        kind,\n        provider,\n        model,\n        reason: \"unknown_model\",\n        fix: `Update '${kind}' assignment to use a known provider/model pair available in PI's model registry`,\n      });\n      continue; // Skip auth check for unknown models\n    }\n\n    // Lane exists; check if auth is configured\n    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n      // Known lane but no auth → log in / configure auth\n      unreachable.push({\n        kind,\n        provider,\n        model,\n        reason: \"auth_not_configured\",\n        fix: `Log in or configure auth for ${provider}/${model} in PI settings`,\n      });\n    }\n  }\n\n  return { unreachable };\n}\n\n/** Surface unreachable lanes via ctx.ui when available + structured diagnostic.\n *\n *  Reporting is headless-safe (AC-5.2):\n *  - If ctx.hasUI is true, surface through ctx.ui.notify with a formatted report.\n *  - Always persist the structured ValidationReport to SessionState.health.\n *  - Capture continues running even when validation fails (AC-5.3).\n *\n *  This function never throws; validation failures are diagnostic, not fatal.\n *  The affected lane's derivations will fail classified and queryable through\n *  health (AC-5.3), but the session itself remains functional for capture. */\nexport function report(\n  r: ValidationReport,\n  ctx: ExtensionContext,\n  state: SessionState,\n  deps: ReportDeps = {},\n): void {\n  // Mark that we've reported startup validation (avoids duplicate reporting)\n  state.flags.startupValidationReported = true;\n\n  // If there are unreachable lanes, surface them through ctx.ui when available\n  if (r.unreachable.length > 0) {\n    const lines = [\n      \"pi-lhc startup validation: unreachable derivation lanes\",\n      \"\",\n      ...r.unreachable.map(\n        (u) =>\n          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n      ),\n      \"\",\n      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n    ];\n\n    const message = lines.join(\"\\n\");\n    state.health.startupValidation = { ...r, message };\n\n    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n    if (ctx.hasUI) {\n      ctx.ui.notify(message, { level: \"warn\" });\n    } else {\n      const headlessLog = deps.headlessLog ?? defaultHeadlessLog;\n      headlessLog(message);\n    }\n  } else {\n    // Persist the structured report to SessionState.health (always, even in headless)\n    state.health.startupValidation = r;\n  }\n}\n","numLines":132,"startLine":1,"totalLines":132}}}

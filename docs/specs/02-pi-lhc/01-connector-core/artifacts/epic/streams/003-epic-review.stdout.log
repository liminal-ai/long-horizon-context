{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1103d6359a634af594b34b57","type":"tool_result","content":"1\t// AC-4.1..4.4. The host-supplied ModelCall function.\n2\t//\n3\t// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n4\t// a production-valid boundary, and classifies failures into the LHC contract.\n5\t// Provider/model are opaque routing keys — the connector does not interpret them.\n6\t//\n7\t// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n8\t// registry and completes through @earendil-works/pi-ai when that package is\n9\t// available in the host runtime. If the runtime does not provide pi-ai, the host\n10\t// returns a classified failure; it never fabricates completion text.\n11\t//\n12\t// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n13\t// @earendil-works/pi-ai (package not yet available).\n14\t\n15\timport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\n16\timport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\n17\timport type { PiAiComplete } from \"./pi-ai.js\";\n18\t\n19\tinterface ModelCallDeps {\n20\t  complete?: PiAiComplete;\n21\t}\n22\t\n23\t/** Extract the text content from an AssistantMessage-like shape. */\n24\tfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n25\t  const content = message.content ?? [];\n26\t  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n27\t  return textParts.map((part) => part.text as string).join(\"\\n\");\n28\t}\n29\t\n30\t/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n31\t *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n32\t *  thrown → other). */\n33\texport function classifyFailure(err: unknown): ModelCallFailureKind {\n34\t  // Guard: non-object errors fall through to \"other\"\n35\t  if (typeof err !== \"object\" || err === null) {\n36\t    return \"other\";\n37\t  }\n38\t\n39\t  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n40\t  const code = errorLike.code?.toLowerCase() ?? \"\";\n41\t  const type = errorLike.type?.toLowerCase() ?? \"\";\n42\t  const message = errorLike.message?.toLowerCase() ?? \"\";\n43\t\n44\t  // Check for auth failures (terminal)\n45\t  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n46\t  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n47\t    return \"auth\";\n48\t  }\n49\t\n50\t  // Check for invalid request (terminal)\n51\t  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n52\t  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n53\t    return \"invalid_request\";\n54\t  }\n55\t\n56\t  // Check for rate limit (retryable)\n57\t  const rateLimitPatterns = [\"rate\", \"429\"];\n58\t  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n59\t    return \"rate_limit\";\n60\t  }\n61\t\n62\t  // Check for timeout (retryable)\n63\t  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n64\t  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n65\t    return \"timeout\";\n66\t  }\n67\t\n68\t  // Check for network errors (retryable)\n69\t  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n70\t  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n71\t    return \"network\";\n72\t  }\n73\t\n74\t  // Default for unknown errors\n75\t  return \"other\";\n76\t}\n77\t\n78\tasync function importPiAiComplete(): Promise<PiAiComplete> {\n79\t  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n80\t    specifier: string,\n81\t  ) => Promise<unknown>;\n82\t  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n83\t  const complete = (loaded as { complete?: unknown }).complete;\n84\t  if (typeof complete !== \"function\") {\n85\t    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n86\t      code: \"invalid_request\",\n87\t    });\n88\t  }\n89\t  return complete as PiAiComplete;\n90\t}\n91\t\n92\t/**\n93\t * Production ModelCall implementation using PI's model registry and pi-ai.\n94\t *\n95\t * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n96\t * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n97\t * when the host runtime provides it.\n98\t */\n99\texport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n100\t  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n101\t    // Resolve the model through PI's registry\n102\t    const resolved = ctx.modelRegistry.find(provider, model);\n103\t    if (resolved === undefined) {\n104\t      // Unknown model - treat as invalid request (terminal)\n105\t      return {\n106\t        ok: false,\n107\t        kind: \"invalid_request\",\n108\t        message: `Model not found in registry: ${provider}/${model}`,\n109\t      };\n110\t    }\n111\t\n112\t    // Check if auth is configured\n113\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n114\t      // No auth - treat as auth failure (terminal)\n115\t      return {\n116\t        ok: false,\n117\t        kind: \"auth\",\n118\t        message: `No configured auth for model: ${provider}/${model}`,\n119\t      };\n120\t    }\n121\t\n122\t    // Complete through pi-ai. Tests may inject this seam; production loads the\n123\t    // host package at runtime so pi-lhc does not publish fabricated text when\n124\t    // the host dependency is absent.\n125\t    try {\n126\t      const complete = deps.complete ?? await importPiAiComplete();\n127\t      const response = await complete(resolved, { messages });\n128\t\n129\t      // Extract text from the response\n130\t      const text = extractAssistantText(response);\n131\t\n132\t      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n133\t      // empty_output is classified by LHC's adapter, not by the host function.\n134\t      // The host function returns text-or-failure only, even if the text is empty.\n135\t      return { ok: true, text };\n136\t    } catch (err) {\n137\t      // Classify the error into a ModelCallFailureKind\n138\t      const kind = classifyFailure(err);\n139\t      const message = err instanceof Error ? err.message : String(err);\n140\t      return { ok: false, kind, message };\n141\t    }\n142\t  };\n143\t}\n144\t\n145\t/**\n146\t * Default assignments for all seven FormKinds.\n147\t *\n148\t * Story 6 implements config loading; these defaults use a real PI registry\n149\t * lane, so the shipped production path can resolve through createModelCall().\n150\t */\n151\t// PI v0.79.2 ships openai-codex/gpt-5.4 in its built-in catalog and records it\n152\t// as the default openai-codex model (pi-coding-agent CHANGELOG: GPT-5.4 support\n153\t// across openai/openai-codex, with gpt-5.4 now the default). This is the\n154\t// production-reachable dial-in default Story 6 requires; unavailable auth is\n155\t// still reported by startup validation rather than hidden behind a test provider.\n156\texport const DEFAULT_PI_MODEL = { provider: \"openai-codex\", id: \"gpt-5.4\" } as const;\n157\t\n158\texport function defaultAssignments(\n159\t  model: { provider: string; id: string } = DEFAULT_PI_MODEL,\n160\t): Record<string, { provider: string; model: string; prompt: string }> {\n161\t  return {\n162\t    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n163\t    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n164\t    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n165\t    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n166\t    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n167\t    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n168\t    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n169\t  };\n170\t}\n171\t"}]},"parent_tool_use_id":null,"session_id":"54bb6891-be78-43f8-a277-229ffe48e3f0","uuid":"fee8887b-d9d8-4ecc-b2a7-ae81b260c5aa","timestamp":"2026-06-14T13:48:12.326Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts","content":"// AC-4.1..4.4. The host-supplied ModelCall function.\n//\n// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n// a production-valid boundary, and classifies failures into the LHC contract.\n// Provider/model are opaque routing keys — the connector does not interpret them.\n//\n// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n// registry and completes through @earendil-works/pi-ai when that package is\n// available in the host runtime. If the runtime does not provide pi-ai, the host\n// returns a classified failure; it never fabricates completion text.\n//\n// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n// @earendil-works/pi-ai (package not yet available).\n\nimport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\nimport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\nimport type { PiAiComplete } from \"./pi-ai.js\";\n\ninterface ModelCallDeps {\n  complete?: PiAiComplete;\n}\n\n/** Extract the text content from an AssistantMessage-like shape. */\nfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n  const content = message.content ?? [];\n  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n  return textParts.map((part) => part.text as string).join(\"\\n\");\n}\n\n/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n *  thrown → other). */\nexport function classifyFailure(err: unknown): ModelCallFailureKind {\n  // Guard: non-object errors fall through to \"other\"\n  if (typeof err !== \"object\" || err === null) {\n    return \"other\";\n  }\n\n  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n  const code = errorLike.code?.toLowerCase() ?? \"\";\n  const type = errorLike.type?.toLowerCase() ?? \"\";\n  const message = errorLike.message?.toLowerCase() ?? \"\";\n\n  // Check for auth failures (terminal)\n  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"auth\";\n  }\n\n  // Check for invalid request (terminal)\n  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"invalid_request\";\n  }\n\n  // Check for rate limit (retryable)\n  const rateLimitPatterns = [\"rate\", \"429\"];\n  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"rate_limit\";\n  }\n\n  // Check for timeout (retryable)\n  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"timeout\";\n  }\n\n  // Check for network errors (retryable)\n  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"network\";\n  }\n\n  // Default for unknown errors\n  return \"other\";\n}\n\nasync function importPiAiComplete(): Promise<PiAiComplete> {\n  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n    specifier: string,\n  ) => Promise<unknown>;\n  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n  const complete = (loaded as { complete?: unknown }).complete;\n  if (typeof complete !== \"function\") {\n    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n      code: \"invalid_request\",\n    });\n  }\n  return complete as PiAiComplete;\n}\n\n/**\n * Production ModelCall implementation using PI's model registry and pi-ai.\n *\n * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n * when the host runtime provides it.\n */\nexport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n    // Resolve the model through PI's registry\n    const resolved = ctx.modelRegistry.find(provider, model);\n    if (resolved === undefined) {\n      // Unknown model - treat as invalid request (terminal)\n      return {\n        ok: false,\n        kind: \"invalid_request\",\n        message: `Model not found in registry: ${provider}/${model}`,\n      };\n    }\n\n    // Check if auth is configured\n    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n      // No auth - treat as auth failure (terminal)\n      return {\n        ok: false,\n        kind: \"auth\",\n        message: `No configured auth for model: ${provider}/${model}`,\n      };\n    }\n\n    // Complete through pi-ai. Tests may inject this seam; production loads the\n    // host package at runtime so pi-lhc does not publish fabricated text when\n    // the host dependency is absent.\n    try {\n      const complete = deps.complete ?? await importPiAiComplete();\n      const response = await complete(resolved, { messages });\n\n      // Extract text from the response\n      const text = extractAssistantText(response);\n\n      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n      // empty_output is classified by LHC's adapter, not by the host function.\n      // The host function returns text-or-failure only, even if the text is empty.\n      return { ok: true, text };\n    } catch (err) {\n      // Classify the error into a ModelCallFailureKind\n      const kind = classifyFailure(err);\n      const message = err instanceof Error ? err.message : String(err);\n      return { ok: false, kind, message };\n    }\n  };\n}\n\n/**\n * Default assignments for all seven FormKinds.\n *\n * Story 6 implements config loading; these defaults use a real PI registry\n * lane, so the shipped production path can resolve through createModelCall().\n */\n// PI v0.79.2 ships openai-codex/gpt-5.4 in its built-in catalog and records it\n// as the default openai-codex model (pi-coding-agent CHANGELOG: GPT-5.4 support\n// across openai/openai-codex, with gpt-5.4 now the default). This is the\n// production-reachable dial-in default Story 6 requires; unavailable auth is\n// still reported by startup validation rather than hidden behind a test provider.\nexport const DEFAULT_PI_MODEL = { provider: \"openai-codex\", id: \"gpt-5.4\" } as const;\n\nexport function defaultAssignments(\n  model: { provider: string; id: string } = DEFAULT_PI_MODEL,\n): Record<string, { provider: string; model: string; prompt: string }> {\n  return {\n    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n  };\n}\n","numLines":171,"startLine":1,"totalLines":171}}}

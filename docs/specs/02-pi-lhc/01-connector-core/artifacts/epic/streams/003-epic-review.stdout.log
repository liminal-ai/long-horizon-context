/picker.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/fork.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/assignments.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/startup-validation.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/verify/replay.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/smoke/extension-load.test.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/smoke/verification-config.test.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.test.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/synthetic.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/synthetic.test.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.test.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/thread.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/thread.test.ts\"],\"reviewScopeSummary\":\"Verified Story 0 foundation scope against the story, full connector-core tech design, test plan, implementor artifact, pi-lhc source, fixture tests, smoke tests, package scripts, and fresh gates. Most foundation evidence is present, but the required callable dispose half of the stubbed init/dispose seam is not implemented or tested.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"S0-001\",\"severity\":\"major\",\"title\":\"Dispose side of the init/dispose seam is not callable or proven fail-closed\",\"evidence\":\"Story 0 requires the stubbed init/dispose seam to be callable and return typed fail-closed results. In `packages/pi-lhc/src/lifecycle/instance.ts:12-24`, only `initLhc` and fail-closed `initInstance` are exported. `packages/pi-lhc/src/shared/instance.ts:12-15` declares an eventual `dispose()` method on `LhcInstance`, but `initInstance` currently returns `ok:false`, so no runtime instance exists whose dispose method can be invoked. The smoke test in `packages/pi-lhc/test/smoke/extension-load.test.ts:86-92` only invokes `initInstance` and asserts `not_implemented`; it does not invoke or prove a dispose seam.\",\"affectedFiles\":[\"packages/pi-lhc/src/lifecycle/instance.ts\",\"packages/pi-lhc/src/shared/instance.ts\",\"packages/pi-lhc/test/smoke/extension-load.test.ts\"],\"requirementIds\":[\"S0-SMOKE-INIT-DISPOSE\",\"S0-DOD-INIT-DISPOSE\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true}],\"openFindings\":[{\"id\":\"S0-001\",\"severity\":\"major\",\"title\":\"Dispose side of the init/dispose seam is not callable or proven fail-closed\",\"evidence\":\"Story 0 requires the stubbed init/dispose seam to be callable and return typed fail-closed results. In `packages/pi-lhc/src/lifecycle/instance.ts:12-24`, only `initLhc` and fail-closed `initInstance` are exported. `packages/pi-lhc/src/shared/instance.ts:12-15` declares an eventual `dispose()` method on `LhcInstance`, but `initInstance` currently returns `ok:false`, so no runtime instance exists whose dispose method can be invoked. The smoke test in `packages/pi-lhc/test/smoke/extension-load.test.ts:86-92` only invokes `initInstance` and asserts `not_implemented`; it does not invoke or prove a dispose seam.\",\"affectedFiles\":[\"packages/pi-lhc/src/lifecycle/instance.ts\",\"packages/pi-lhc/src/shared/instance.ts\",\"packages/pi-lhc/test/smoke/extension-load.test.ts\"],\"requirementIds\":[\"S0-SMOKE-INIT-DISPOSE\",\"S0-DOD-INIT-DISPOSE\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"S0-NO-EPIC-AC: Story 0 owns no Epic 1 product ACs; verification checked smoke/foundation evidence only.\",\"S0-PACKAGE-HOOK-RAIL: `activate` registers the nine Epic 1 observe-only hooks and does not register `context`; covered by `extension-load.test.ts` and passing gate output.\",\"S0-FRESH-CONTEXT-PLAIN-DATA: guarded handlers accept distinct fresh PI context objects and retained connector state is structured-cloneable; covered by `extension-load.test.ts`.\",\"S0-STATE-HOLDER: `SessionState` stores `threadRef`, flags, and health diagnostics only; covered by `state.ts` and structuredClone smoke coverage.\",\"S0-FAIL-CLOSED-STUBS: capture, thread resolution, picker, fork seeding, model call, assignment validation, startup validation, pure capture helpers, and replay do not report production success before their owning stories; `rg` found no `ok:true` production result path in `src`.\",\"S0-FIXTURE-HARNESS: corpus, synthetic, model-call, and temp-thread fixtures exist; corpus validation rejects malformed fixtures; temp-thread tests create and reopen real SQLite-backed LHC threads.\",\"S0-PACKAGE-GATES: package scripts exist and fresh `verify` and `verify-all` gates passed.\"],\"unverified\":[\"S0-SMOKE-INIT-DISPOSE: dispose side of the stubbed lifecycle seam is not callable or tested as fail-closed.\"]},\"gatesRun\":[{\"command\":\"pnpm --filter pi-lhc verify\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify-all\",\"result\":\"pass\"}],\"productionPathFindings\":[\"S0-001: lifecycle production surface exposes a callable fail-closed init path but no callable fail-closed dispose path.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"quick-fix\",\"openQuestions\":[],\"additionalObservations\":[\"`packages/pi-lhc/test/fixtures/corpus.ts` currently builds synthetic stand-ins for the named corpora. I treated that as non-blocking for Story 0 because `team-impl-log.md` records M0 real recorded corpus breadth as Story 3 fixture scope.\",\"PI surface types are local declarations in `src/pi/types.ts` because the PI packages are not installed; LHC types are imported from `lhc` throughout the production source.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/004-verify.json\"}],\"startedAt\":\"2026-06-14T03:39:17.736Z\",\"finishedAt\":\"2026-06-14T03:44:29.228Z\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/03-capture-verification/004-verify.json:1:{\"command\":\"story-verify\",\"version\":1,\"status\":\"ok\",\"outcome\":\"revise\",\"result\":{\"resultId\":\"cdabf308-0529-4edb-9c42-8bdcdceb167e\",\"role\":\"story_verifier\",\"provider\":\"codex\",\"model\":\"gpt-5.5\",\"sessionId\":\"019ec5d0-02af-7833-aa10-b5a891cf7379\",\"continuation\":{\"provider\":\"codex\",\"sessionId\":\"019ec5d0-02af-7833-aa10-b5a891cf7379\",\"storyId\":\"03-capture-verification\"},\"mode\":\"initial\",\"story\":{\"id\":\"03-capture-verification\",\"title\":\"Story 3: Capture Verification\"},\"artifactsRead\":[\"docs/specs/02-pi-lhc/01-connector-core/stories/03-capture-verification.md\",\"docs/specs/02-pi-lhc/01-connector-core/tech-design.md\",\"docs/specs/02-pi-lhc/01-connector-core/test-plan.md\",\"docs/specs/02-pi-lhc/01-connector-core/artifacts/03-capture-verification/003-implementor.json\",\"packages/pi-lhc/src/verify/replay.ts\",\"packages/pi-lhc/test/verify/replay.test.ts\",\"packages/pi-lhc/test/fixtures/corpus.ts\",\"packages/pi-lhc/test/fixtures/corpus.test.ts\",\"packages/pi-lhc/src/capture/converter.ts\",\"packages/pi-lhc/src/capture/map-message.ts\",\"packages/pi-lhc/src/capture/turn-accumulator.ts\",\"packages/pi-lhc/src/index.ts\",\"packages/lhc/src/sdk.ts\",\"packages/lhc/src/shared/inspect.ts\"],\"reviewScopeSummary\":\"Initial verification of Story 3 against AC-6.1 through AC-6.3, the replay harness, corpus fixtures, verification tests, inspect/health evidence, and configured gates.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"SV-001\",\"severity\":\"major\",\"title\":\"Replay does not compare actual message and turn read-back records\",\"evidence\":\"AC-6.1 requires the thread read-back — events, messages, and turns — to match fixture expectations. `replayCorpus` reads `intakeStream.listEvents` and `inspect.overview` only (`packages/pi-lhc/src/verify/replay.ts:282-291`). `compareReadback` compares event kind/payload order, then checks only `overview.messages.visible`, `overview.messages.byKind`, `overview.turns.closed`, and `overview.turns.open` (`packages/pi-lhc/src/verify/replay.ts:219-260`). The SDK exposes actual message and turn read-back surfaces (`messages` and `turns` exports in `packages/lhc/src/sdk.ts:1-4`, plus `MessageRecord`/`TurnRecord` types at `packages/lhc/src/sdk.ts:173-182`), but the Story 3 harness and tests do not consume them. `test/verify/replay.test.ts` adds an extra TC-6.1 assertion for event kinds only (`packages/pi-lhc/test/verify/replay.test.ts:86-91`). This leaves message content/order/turn association unverified despite the AC naming messages and turns explicitly.\",\"affectedFiles\":[\"packages/pi-lhc/src/verify/replay.ts\",\"packages/pi-lhc/test/verify/replay.test.ts\"],\"requirementIds\":[\"AC-6.1\",\"TC-6.1\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"SV-002\",\"severity\":\"major\",\"title\":\"Corpus replay uses synthetic flat messages and inferred lifecycle instead of recorded PI hook corpora\",\"evidence\":\"AC-6.1 is scoped to replaying recorded PI corpora. The fixture loader states that, until M0 delivers recordings, it builds synthetic stand-ins (`packages/pi-lhc/test/fixtures/corpus.ts:1-4`), and each named corpus source is an in-memory `AgentMessage[]` built with `makeUserMessage` / `makeAssistantMessage` (`packages/pi-lhc/test/fixtures/corpus.ts:21-29`, `42-53`, `69-83`, `97-105`, `118-124`). The replay harness source type is also just `AgentMessage[]` (`packages/pi-lhc/src/verify/replay.ts:35-38`). During replay it synthesizes deterministic entry ids and infers `agent_end` boundaries from a new user prompt or end-of-stream (`packages/pi-lhc/src/verify/replay.ts:117-143`) instead of consuming recorded `message_end` / `agent_end` events with their original positions. That proves the converter on synthetic message shapes, but not replay fidelity for recorded PI corpora or recorded lifecycle ordering.\",\"affectedFiles\":[\"packages/pi-lhc/src/verify/replay.ts\",\"packages/pi-lhc/test/fixtures/corpus.ts\",\"packages/pi-lhc/test/verify/replay.test.ts\"],\"requirementIds\":[\"AC-6.1\",\"TC-6.1\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"openFindings\":[{\"id\":\"SV-001\",\"severity\":\"major\",\"title\":\"Replay does not compare actual message and turn read-back records\",\"evidence\":\"AC-6.1 requires the thread read-back — events, messages, and turns — to match fixture expectations. `replayCorpus` reads `intakeStream.listEvents` and `inspect.overview` only (`packages/pi-lhc/src/verify/replay.ts:282-291`). `compareReadback` compares event kind/payload order, then checks only `overview.messages.visible`, `overview.messages.byKind`, `overview.turns.closed`, and `overview.turns.open` (`packages/pi-lhc/src/verify/replay.ts:219-260`). The SDK exposes actual message and turn read-back surfaces (`messages` and `turns` exports in `packages/lhc/src/sdk.ts:1-4`, plus `MessageRecord`/`TurnRecord` types at `packages/lhc/src/sdk.ts:173-182`), but the Story 3 harness and tests do not consume them. `test/verify/replay.test.ts` adds an extra TC-6.1 assertion for event kinds only (`packages/pi-lhc/test/verify/replay.test.ts:86-91`). This leaves message content/order/turn association unverified despite the AC naming messages and turns explicitly.\",\"affectedFiles\":[\"packages/pi-lhc/src/verify/replay.ts\",\"packages/pi-lhc/test/verify/replay.test.ts\"],\"requirementIds\":[\"AC-6.1\",\"TC-6.1\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"SV-002\",\"severity\":\"major\",\"title\":\"Corpus replay uses synthetic flat messages and inferred lifecycle instead of recorded PI hook corpora\",\"evidence\":\"AC-6.1 is scoped to replaying recorded PI corpora. The fixture loader states that, until M0 delivers recordings, it builds synthetic stand-ins (`packages/pi-lhc/test/fixtures/corpus.ts:1-4`), and each named corpus source is an in-memory `AgentMessage[]` built with `makeUserMessage` / `makeAssistantMessage` (`packages/pi-lhc/test/fixtures/corpus.ts:21-29`, `42-53`, `69-83`, `97-105`, `118-124`). The replay harness source type is also just `AgentMessage[]` (`packages/pi-lhc/src/verify/replay.ts:35-38`). During replay it synthesizes deterministic entry ids and infers `agent_end` boundaries from a new user prompt or end-of-stream (`packages/pi-lhc/src/verify/replay.ts:117-143`) instead of consuming recorded `message_end` / `agent_end` events with their original positions. That proves the converter on synthetic message shapes, but not replay fidelity for recorded PI corpora or recorded lifecycle ordering.\",\"affectedFiles\":[\"packages/pi-lhc/src/verify/replay.ts\",\"packages/pi-lhc/test/fixtures/corpus.ts\",\"packages/pi-lhc/test/verify/replay.test.ts\"],\"requirementIds\":[\"AC-6.1\",\"TC-6.1\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"AC-6.2 / TC-6.2: deterministic replay and same-thread re-replay are covered by `test/verify/replay.test.ts`; full `pnpm --filter pi-lhc verify` passed with 79 tests.\",\"AC-6.3 / TC-6.3: inspect overview/health counts, last event span, capture gaps, and failed derivations are covered by `test/verify/replay.test.ts`; full `pnpm --filter pi-lhc verify` passed.\",\"Fixture validity risk for current fixture shapes: `test/fixtures/corpus.test.ts` validates well-formed expected event shapes and rejects a malformed corpus.\"],\"unverified\":[\"AC-6.1 / TC-6.1: actual `messages.listMessages` and `turns.listTurns` read-back records are not compared to fixture expectations.\",\"AC-6.1 / TC-6.1: recorded PI corpus lifecycle replay is not proven; current corpus sources are synthetic flat `AgentMessage[]` inputs with inferred boundaries.\"]},\"gatesRun\":[{\"command\":\"pnpm --filter pi-lhc verify\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify-all\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc green-verify\",\"result\":\"fail\"}],\"productionPathFindings\":[\"`packages/pi-lhc/src/verify/replay.ts` synthesizes entry ids and agent-run boundaries instead of replaying recorded hook lifecycle events, so the verification path is not yet proving recorded-corpus fidelity.\",\"`packages/pi-lhc/src/verify/replay.ts` does not use the real message and turn read-back surfaces, only overview counts for those sections.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"same-session-implementor\",\"openQuestions\":[\"If M0 recorded corpora are still unavailable, does the impl lead want to explicitly accept synthetic stand-ins for this story, or should Story 3 remain blocked until those fixture inputs exist?\"],\"additionalObservations\":[\"Configured story gate `pnpm --filter pi-lhc verify` passed. `green-verify` failed only at `check-test-immutability.mjs` for four pre-existing Story 2 capture test files, matching the implementor's reported drift and not the configured Story 3 gate.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/artifacts/03-capture-verification/004-verify.json\"}],\"startedAt\":\"2026-06-14T11:06:44.123Z\",\"finishedAt\":\"2026-06-14T11:11:24.963Z\"}\ndocs/specs/02-pi-lhc/01-con
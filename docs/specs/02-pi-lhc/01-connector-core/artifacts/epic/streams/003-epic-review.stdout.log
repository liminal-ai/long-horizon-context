{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/verify/replay.ts | sed -n '1,320p'\"","aggregated_output":"     1\timport {\n     2\t  createSdk,\n     3\t  inspect,\n     4\t  intakeStream,\n     5\t  messages,\n     6\t  turns,\n     7\t  type DerivationProvider,\n     8\t  type EventRecord,\n     9\t  type InspectOverview,\n    10\t  type MessageEventInput,\n    11\t  type MessageRecord,\n    12\t  type OpResult,\n    13\t  type ProviderResult,\n    14\t  type ThreadRef,\n    15\t  type TurnRecord,\n    16\t} from \"lhc\";\n    17\timport type { AgentMessage } from \"../pi/types.js\";\n    18\timport type { LhcInstance } from \"../shared/instance.js\";\n    19\timport { capture, captureGap } from \"../capture/converter.js\";\n    20\timport { mapMessage, type MapCtx } from \"../capture/map-message.js\";\n    21\timport { TurnAccumulator } from \"../capture/turn-accumulator.js\";\n    22\t\n    23\t// AC-6.1, AC-6.2 (Flow 6, Story 3). Capture correctness is proven WITHOUT\n    24\t// serving anything to a model: a recorded PI corpus replays through the REAL\n    25\t// converter and intake path into a temp thread, and the thread's read-back —\n    26\t// events, messages, and turns — is compared to the fixture's expectation. The\n    27\t// same corpus replayed twice yields identical read-back because the converter's\n    28\t// mapping and the SDK's deterministic ids make replay reproducible.\n    29\t//\n    30\t// Anti-shim (story §Anti-Shim Requirements): this drives Story 2's converter\n    31\t// (`mapMessage` → `TurnAccumulator` → `capture`) exactly as live capture does —\n    32\t// it never writes the fixture's expected events to the thread, and it compares\n    33\t// events/messages/turns/order, never just counts. inspect's overview/health are\n    34\t// the live read-back surfaces a Story-3 test asserts on for AC-6.3.\n    35\t\n    36\t/** A loaded corpus: synthetic PI source messages (the stand-in until M0\n    37\t *  delivers recordings) paired with the expected LHC intake events. Both\n    38\t *  `verify/replay` and the corpus fixtures consume this shape. */\n    39\texport interface Corpus {\n    40\t  name: string;\n    41\t  source: AgentMessage[];\n    42\t  expected: MessageEventInput[];\n    43\t}\n    44\t\n    45\t/** A structured compare result with a readable diff (tech design §Technical\n    46\t *  Notes). `matches` is true only when events, messages, AND turns all line up\n    47\t *  with the fixture; `diff` names every divergence when they do not. */\n    48\texport interface ReplayResult {\n    49\t  matches: boolean;\n    50\t  diff?: string;\n    51\t}\n    52\t\n    53\tfunction detail(cause: unknown): string {\n    54\t  return cause instanceof Error ? cause.message : String(cause);\n    55\t}\n    56\t\n    57\t/** A construction-valid, fail-closed inference provider — the same observe-only\n    58\t *  shape the live Epic-1 session runs on (index.ts). Replay never serves context\n    59\t *  to a model, so every derivation operation fails closed (non-retryable) rather\n    60\t *  than fabricating derived text; the resulting failed derivations are exactly\n    61\t *  what inspect health must surface (AC-6.3), so the harness mirrors production\n    62\t *  rather than hiding them behind a succeeding fake. */\n    63\tfunction observeOnlyProvider(): DerivationProvider {\n    64\t  const notConfigured = (): Promise<ProviderResult> =>\n    65\t    Promise.resolve({\n    66\t      ok: false,\n    67\t      retryable: false,\n    68\t      reason: \"pi-lhc replay is observe-only (no inference served)\",\n    69\t    });\n    70\t  return {\n    71\t    smoothPrompt: notConfigured,\n    72\t    summarizeToolCall: notConfigured,\n    73\t    summarizeToolResult: notConfigured,\n    74\t    composeTurnRendering: notConfigured,\n    75\t    projectLowerBand: notConfigured,\n    76\t    summarizeChunkDetailed: notConfigured,\n    77\t    summarizeChunkBrief: notConfigured,\n    78\t  };\n    79\t}\n    80\t\n    81\t/** Build a real background LHC instance against the temp thread. The converter\n    82\t *  writes through `instance.sdk.intakeStream`, and `dispose` drains settled so\n    83\t *  background derivations reach a terminal state before read-back — the same\n    84\t *  flush-on-dispose contract the lifecycle instance uses, rebuilt here because\n    85\t *  `verify` may not import `lifecycle` (boundary rule 3). */\n    86\tfunction buildReplayInstance(threadRef: ThreadRef): LhcInstance {\n    87\t  const sdk = createSdk({ provider: observeOnlyProvider(), mode: \"background\" });\n    88\t  return {\n    89\t    sdk,\n    90\t    threadRef,\n    91\t    dispose: async (): Promise<OpResult<void>> => {\n    92\t      try {\n    93\t        await sdk.drainSettled(threadRef);\n    94\t      } catch {\n    95\t        // Best-effort flush; replay's verdict comes from durable read-back, not\n    96\t        // from the drain, and a drain failure must not throw out of verify.\n    97\t      }\n    98\t      return { ok: true, value: undefined };\n    99\t    },\n   100\t  };\n   101\t}\n   102\t\n   103\t/** A deterministic per-replay session id derived from the CORPUS, not the\n   104\t *  thread: it scopes every idempotency key, so the same corpus replayed into two\n   105\t *  different temp threads produces byte-identical keys (AC-6.2), while different\n   106\t *  corpora never collide. */\n   107\tfunction replaySessionId(corpus: Corpus): string {\n   108\t  return `replay:${corpus.name}`;\n   109\t}\n   110\t\n   111\t/** Drive one corpus through the real converter into the thread, reconstructing\n   112\t *  the PI hook stream a live session would have fired: each source message is a\n   113\t *  `message_end` (mapped + accumulated + flushed), and an `agent_end` closes the\n   114\t *  LHC turn at each agent-run boundary — before a fresh user prompt and once at\n   115\t *  end-of-stream — so PI's \"a new prompt starts a new run\" shows up as exactly\n   116\t *  one `turn_end` per run (AC-2.2 semantics, exercised end to end here). */\n   117\tasync function driveCorpus(corpus: Corpus, instance: LhcInstance): Promise<void> {\n   118\t  const piSessionId = replaySessionId(corpus);\n   119\t  const accumulator = new TurnAccumulator({ piSessionId });\n   120\t\n   121\t  for (const [index, message] of corpus.source.entries()) {\n   122\t    // A new user prompt with a turn already open means the previous agent run\n   123\t    // ended: close it first (agent_end), then record the prompt that opens the\n   124\t    // next run.\n   125\t    if (message.role === \"user\" && accumulator.hasOpenTurn()) {\n   126\t      await flush(accumulator.onAgentEnd(), instance);\n   127\t    }\n   128\t\n   129\t    // Real recorded PI message_end always carries a stable entry id; the\n   130\t    // synthetic corpora omit it, so stamp a deterministic per-message id so the\n   131\t    // converter keys off its Tier-1 path exactly as production does.\n   132\t    const mapCtx: MapCtx = { piSessionId, entryId: `${piSessionId}:entry:${index}` };\n   133\t    let events: MessageEventInput[];\n   134\t    try {\n   135\t      events = mapMessage(message, mapCtx);\n   136\t    } catch (cause) {\n   137\t      // An unmappable source message degrades to a durable, queryable gap —\n   138\t      // never a thrown replay (mirrors index.ts's capture-failure isolation).\n   139\t      await captureGap(`${piSessionId}:entry:${index}`, `replay map failed: ${detail(cause)}`, instance);\n   140\t      continue;\n   141\t    }\n   142\t    accumulator.onMessage(events);\n   143\t    await flush(events, instance);\n   144\t  }\n   145\t\n   146\t  // Close the final open turn (the last agent run's agent_end).\n   147\t  await flush(accumulator.onAgentEnd(), instance);\n   148\t}\n   149\t\n   150\tasync function flush(events: MessageEventInput[], instance: LhcInstance): Promise<void> {\n   151\t  if (events.length === 0) return;\n   152\t  await capture(events, instance);\n   153\t}\n   154\t\n   155\t/** Strip the server-stamped order/timestamp so the comparison is over the\n   156\t *  logical intake shape the converter produced — including the real, stable\n   157\t *  idempotency keys (kept so AC-6.2's determinism is checkable on the read-back),\n   158\t *  excluding `recordedAt` (a wall-clock value that legitimately differs run to\n   159\t *  run). */\n   160\tfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n   161\t  return records.map(\n   162\t    (record) =>\n   163\t      ({\n   164\t        eventKind: record.eventKind,\n   165\t        idempotencyKey: record.idempotencyKey,\n   166\t        actor: record.actor,\n   167\t        harness: record.harness,\n   168\t        payload: record.payload,\n   169\t      }) as MessageEventInput,\n   170\t  );\n   171\t}\n   172\t\n   173\t/** Order-independent canonical JSON for value comparison: object keys sorted\n   174\t *  recursively so two structurally-equal payloads built in different key orders\n   175\t *  compare equal. */\n   176\tfunction canonical(value: unknown): string {\n   177\t  return JSON.stringify(sortKeys(value));\n   178\t}\n   179\t\n   180\tfunction sortKeys(value: unknown): unknown {\n   181\t  if (Array.isArray(value)) return value.map(sortKeys);\n   182\t  if (value !== null && typeof value === \"object\") {\n   183\t    const out: Record<string, unknown> = {};\n   184\t    for (const key of Object.keys(value as Record<string, unknown>).sort()) {\n   185\t      out[key] = sortKeys((value as Record<string, unknown>)[key]);\n   186\t    }\n   187\t    return out;\n   188\t  }\n   189\t  return value;\n   190\t}\n   191\t\n   192\tinterface MessageProjection {\n   193\t  visible: number;\n   194\t  byKind: Record<string, number>;\n   195\t}\n   196\t\n   197\ttype ComparableMessageRecord = Pick<\n   198\t  MessageRecord,\n   199\t  \"messageId\" | \"sourceEventOrder\" | \"kind\" | \"blocks\" | \"harness\" | \"turnId\"\n   200\t>;\n   201\t\n   202\ttype ComparableTurnRecord = Pick<\n   203\t  TurnRecord,\n   204\t  \"turnId\" | \"status\" | \"memberMessageIds\" | \"openedAtEventOrder\" | \"closedAtEventOrder\"\n   205\t>;\n   206\t\n   207\t/** The message read-back the fixture implies: each non-`turn_end` event projects\n   208\t *  to exactly one message of its kind (LHC's projection, verified 1:1), so the\n   209\t *  expected `messages.visible` and `messages.byKind` fall straight out of the\n   210\t *  expected event list. */\n   211\tfunction expectedMessages(expected: readonly MessageEventInput[]): MessageProjection {\n   212\t  const byKind: Record<string, number> = {};\n   213\t  let visible = 0;\n   214\t  for (const event of expected) {\n   215\t    if (event.eventKind === \"turn_end\") continue;\n   216\t    byKind[event.eventKind] = (byKind[event.eventKind] ?? 0) + 1;\n   217\t    visible += 1;\n   218\t  }\n   219\t  return { visible, byKind };\n   220\t}\n   221\t\n   222\tfunction expectedMessageRecords(expected: readonly MessageEventInput[]): ComparableMessageRecord[] {\n   223\t  const records: ComparableMessageRecord[] = [];\n   224\t  let openTurnId: string | undefined;\n   225\t  let nextTurnOrder = 1;\n   226\t\n   227\t  for (const [index, event] of expected.entries()) {\n   228\t    const sourceEventOrder = index + 1;\n   229\t    if (event.eventKind === \"user_prompt\") {\n   230\t      openTurnId = `t${nextTurnOrder}`;\n   231\t      nextTurnOrder += 1;\n   232\t    } else if (event.eventKind === \"turn_end\") {\n   233\t      openTurnId = undefined;\n   234\t      continue;\n   235\t    }\n   236\t\n   237\t    records.push({\n   238\t      messageId: `m${sourceEventOrder}`,\n   239\t      sourceEventOrder,\n   240\t      kind: event.eventKind,\n   241\t      harness: event.harness,\n   242\t      ...(openTurnId === undefined ? {} : { turnId: openTurnId }),\n   243\t      blocks: expectedBlocks(event),\n   244\t    });\n   245\t  }\n   246\t\n   247\t  return records;\n   248\t}\n   249\t\n   250\tfunction expectedBlocks(event: MessageEventInput): MessageRecord[\"blocks\"] {\n   251\t  switch (event.eventKind) {\n   252\t    case \"user_prompt\":\n   253\t    case \"assistant_text\":\n   254\t    case \"assistant_thinking\":\n   255\t    case \"runtime_note\":\n   256\t      return [{ blockType: \"text\", content: { text: event.payload.text } }];\n   257\t    case \"tool_call\":\n   258\t      return [\n   259\t        {\n   260\t          blockType: \"tool_call\",\n   261\t          content: {\n   262\t            toolCallId: event.payload.toolCallId,\n   263\t            toolName: event.payload.toolName,\n   264\t            arguments: event.payload.arguments,\n   265\t          },\n   266\t        },\n   267\t      ];\n   268\t    case \"tool_result\":\n   269\t      return [\n   270\t        {\n   271\t          blockType: \"tool_result\",\n   272\t          content: {\n   273\t            toolCallId: event.payload.toolCallId,\n   274\t            content: event.payload.content,\n   275\t            isError: event.payload.isError ?? false,\n   276\t          },\n   277\t        },\n   278\t      ];\n   279\t    case \"turn_end\":\n   280\t      return [];\n   281\t  }\n   282\t}\n   283\t\n   284\tfunction comparableMessageRecords(records: readonly MessageRecord[]): ComparableMessageRecord[] {\n   285\t  return records.map((record) => ({\n   286\t    messageId: record.messageId,\n   287\t    sourceEventOrder: record.sourceEventOrder,\n   288\t    kind: record.kind,\n   289\t    blocks: record.blocks,\n   290\t    harness: record.harness,\n   291\t    ...(record.turnId === undefined ? {} : { turnId: record.turnId }),\n   292\t  }));\n   293\t}\n   294\t\n   295\tfunction expectedTurnRecords(expected: readonly MessageEventInput[]): ComparableTurnRecord[] {\n   296\t  const records: ComparableTurnRecord[] = [];\n   297\t  let openTurn: ComparableTurnRecord | undefined;\n   298\t\n   299\t  for (const [index, event] of expected.entries()) {\n   300\t    const eventOrder = index + 1;\n   301\t    if (event.eventKind === \"user_prompt\") {\n   302\t      if (openTurn !== undefined) {\n   303\t        openTurn.status = \"closed\";\n   304\t        openTurn.closedAtEventOrder = eventOrder;\n   305\t      }\n   306\t      openTurn = {\n   307\t        turnId: `t${records.length + 1}`,\n   308\t        status: \"open\",\n   309\t        memberMessageIds: [],\n   310\t        openedAtEventOrder: eventOrder,\n   311\t      };\n   312\t      records.push(openTurn);\n   313\t    } else if (event.eventKind === \"turn_end\") {\n   314\t      if (openTurn !== undefined) {\n   315\t        openTurn.status = \"closed\";\n   316\t        openTurn.closedAtEventOrder = eventOrder;\n   317\t        openTurn = undefined;\n   318\t      }\n   319\t      continue;\n   320\t    }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/verify/replay.test.ts | sed -n '1,340p'\"","aggregated_output":"     1\t// Story 3 — capture verification (Flow 6). Capture correctness is proven\n     2\t// WITHOUT serving anything to a model: each recorded corpus replays through the\n     3\t// REAL converter + intake path into a temp SQLite thread, and the durable\n     4\t// read-back is compared to the fixture. These tests assert on recorded thread\n     5\t// state through `replayCorpus` and the live inspect surfaces — never on a\n     6\t// mocked intake, and never by writing the fixture's expected events directly\n     7\t// (story §Anti-Shim Requirements).\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  createSdk,\n    12\t  inspect,\n    13\t  intakeStream,\n    14\t  type EventRecord,\n    15\t  type MessageEventInput,\n    16\t  type ThreadRef,\n    17\t} from \"lhc\";\n    18\timport { replayCorpus } from \"../../src/verify/replay.js\";\n    19\timport { capture } from \"../../src/capture/converter.js\";\n    20\timport type { LhcInstance } from \"../../src/shared/instance.js\";\n    21\timport {\n    22\t  CORPUS_LOADERS,\n    23\t  loadChattyCorpus,\n    24\t  loadToolHeavyCorpus,\n    25\t  type CorpusName,\n    26\t} from \"../fixtures/corpus.js\";\n    27\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    28\t\n    29\tlet store: TempStore;\n    30\tbeforeEach(() => {\n    31\t  store = tempStore();\n    32\t});\n    33\tafterEach(() => {\n    34\t  store.cleanup();\n    35\t});\n    36\t\n    37\tconst CORPUS_NAMES = Object.keys(CORPUS_LOADERS) as CorpusName[];\n    38\t\n    39\t/** The logical read-back: server-stamped `eventOrder`/`recordedAt` dropped, the\n    40\t *  converter's real (deterministic) idempotency key kept — so two replays are\n    41\t *  comparable for ID + order stability (AC-6.2). */\n    42\tfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n    43\t  return records.map(\n    44\t    (record) =>\n    45\t      ({\n    46\t        eventKind: record.eventKind,\n    47\t        idempotencyKey: record.idempotencyKey,\n    48\t        actor: record.actor,\n    49\t        harness: record.harness,\n    50\t        payload: record.payload,\n    51\t      }) as MessageEventInput,\n    52\t  );\n    53\t}\n    54\t\n    55\tasync function readBack(threadRef: ThreadRef): Promise<MessageEventInput[]> {\n    56\t  const read = await intakeStream.listEvents(threadRef);\n    57\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n    58\t  return logicalEvents(read.value);\n    59\t}\n    60\t\n    61\t/** A real background instance for inducing a Story-2 capture failure (the gap\n    62\t *  path does not call the provider, so the deterministic one is fine). */\n    63\tfunction liveInstance(threadRef: ThreadRef): LhcInstance {\n    64\t  const sdk = createSdk({ provider: createDeterministicProvider(), mode: \"background\" });\n    65\t  return {\n    66\t    sdk,\n    67\t    threadRef,\n    68\t    dispose: async () => {\n    69\t      await sdk.drainSettled(threadRef);\n    70\t      return { ok: true, value: undefined };\n    71\t    },\n    72\t  };\n    73\t}\n    74\t\n    75\t// ── TC-6.1: each corpus replays to a read-back matching the fixture ──────────\n    76\tdescribe.each(CORPUS_NAMES)(\"Story 3: corpus replay read-back (TC-6.1) — %s\", (name) => {\n    77\t  it(\"replays through the real converter to a thread whose events/messages/turns match the fixture\", async () => {\n    78\t    const corpus = CORPUS_LOADERS[name]();\n    79\t    const thread = await makeTempThread(store);\n    80\t\n    81\t    const result = await replayCorpus(corpus, thread.threadRef);\n    82\t\n    83\t    // toEqual surfaces the structured diff on the actual object when it fails.\n    84\t    expect(result).toEqual({ matches: true });\n    85\t\n    86\t    // The recorded events are the corpus's expected kinds, in order — proven\n    87\t    // against the durable thread, not the in-memory return value.\n    88\t    const recorded = await readBack(thread.threadRef);\n    89\t    expect(recorded.map((event) => event.eventKind)).toEqual(\n    90\t      corpus.expected.map((event) => event.eventKind),\n    91\t    );\n    92\t  });\n    93\t});\n    94\t\n    95\t// ── TC-6.2: deterministic re-replay (IDs and order stable) ───────────────────\n    96\tdescribe(\"Story 3: deterministic re-replay (TC-6.2)\", () => {\n    97\t  it(\"replays the same corpus into two fresh threads to byte-identical read-back — real, stable idempotency keys\", async () => {\n    98\t    // tool-heavy carries tool_call/tool_result correlation ids, so this also\n    99\t    // pins ID stability through the correlation path, not just text events.\n   100\t    const corpus = loadToolHeavyCorpus();\n   101\t    const threadA = await makeTempThread(store);\n   102\t    const threadB = await makeTempThread(store);\n   103\t\n   104\t    expect(await replayCorpus(corpus, threadA.threadRef)).toEqual({ matches: true });\n   105\t    expect(await replayCorpus(corpus, threadB.threadRef)).toEqual({ matches: true });\n   106\t\n   107\t    const readA = await readBack(threadA.threadRef);\n   108\t    const readB = await readBack(threadB.threadRef);\n   109\t\n   110\t    // Identical read-back: same events, same order, same idempotency keys.\n   111\t    expect(readA).toEqual(readB);\n   112\t    // The keys are the converter's real deterministic keys, not placeholders.\n   113\t    expect(readA.every((event) => event.idempotencyKey.startsWith(\"pi:replay:tool-heavy\"))).toBe(true);\n   114\t    expect(new Set(readA.map((event) => event.idempotencyKey)).size).toBe(readA.length);\n   115\t  });\n   116\t\n   117\t  it(\"re-replaying the same corpus into the SAME thread does not perturb the read-back (deterministic keys dedup)\", async () => {\n   118\t    const corpus = loadChattyCorpus();\n   119\t    const thread = await makeTempThread(store);\n   120\t\n   121\t    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n   122\t    const first = await readBack(thread.threadRef);\n   123\t\n   124\t    // A second replay re-delivers identical keys; the SDK dedups them, so the\n   125\t    // read-back is unchanged — re-replay perturbs neither IDs nor order.\n   126\t    const second = await replayCorpus(corpus, thread.threadRef);\n   127\t    expect(second).toEqual({ matches: true });\n   128\t    expect(await readBack(thread.threadRef)).toEqual(first);\n   129\t  });\n   130\t});\n   131\t\n   132\t// ── TC-6.3: inspect overview/health reflect the captured session ─────────────\n   133\tdescribe(\"Story 3: inspect overview/health reflect the captured session (TC-6.3)\", () => {\n   134\t  it(\"reports event/message counts, last recorded position, gaps, and failed derivations\", async () => {\n   135\t    const corpus = loadToolHeavyCorpus(); // 6 events → 5 messages, 1 closed turn\n   136\t    const thread = await makeTempThread(store);\n   137\t\n   138\t    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n   139\t\n   140\t    // Counts + last recorded position, cross-checked against the event log.\n   141\t    const overview1 = await inspect.overview(thread.threadRef);\n   142\t    expect(overview1.ok).toBe(true);\n   143\t    if (!overview1.ok) return;\n   144\t    const recorded = await intakeStream.listEvents(thread.threadRef);\n   145\t    expect(recorded.ok).toBe(true);\n   146\t    if (!recorded.ok) return;\n   147\t    const lastOrder = recorded.value.at(-1)?.eventOrder;\n   148\t\n   149\t    expect(overview1.value.events.count).toBe(corpus.expected.length); // 6\n   150\t    expect(overview1.value.events.span?.last).toBe(lastOrder); // last recorded position, surfaced\n   151\t    expect(overview1.value.messages.visible).toBe(5);\n   152\t    expect(overview1.value.messages.byKind).toEqual({\n   153\t      user_prompt: 1,\n   154\t      assistant_thinking: 1,\n   155\t      tool_call: 1,\n   156\t      tool_result: 1,\n   157\t      assistant_text: 1,\n   158\t    });\n   159\t    expect(overview1.value.turns.closed).toBe(1);\n   160\t    expect(overview1.value.turns.open).toBe(0);\n   161\t\n   162\t    // Failed derivations are visible, not hidden: Epic-1 replay is observe-only\n   163\t    // (inference fails closed), so the queued derivations land failed.\n   164\t    expect(overview1.value.derivation.failed).toBeGreaterThan(0);\n   165\t    const health1 = await inspect.health(thread.threadRef);\n   166\t    expect(health1.ok).toBe(true);\n   167\t    if (!health1.ok) return;\n   168\t    expect(health1.value.failures.length).toBeGreaterThan(0);\n   169\t\n   170\t    // A capture gap is visible, not hidden — induce one through the Story-2\n   171\t    // capture path (a turn_end with a non-empty payload is rejected as\n   172\t    // invalid_event, which records a durable gap note).\n   173\t    const instance = liveInstance(thread.threadRef);\n   174\t    const malformed = {\n   175\t      eventKind: \"turn_end\",\n   176\t      idempotencyKey: \"replay-induced-gap\",\n   177\t      actor: \"system\",\n   178\t      harness: \"pi\",\n   179\t      payload: { stowaway: true },\n   180\t    } as unknown as MessageEventInput;\n   181\t    const gapResult = await capture([malformed], instance);\n   182\t    expect(gapResult.ok).toBe(false);\n   183\t    await instance.dispose();\n   184\t\n   185\t    const health2 = await inspect.health(thread.threadRef);\n   186\t    expect(health2.ok).toBe(true);\n   187\t    if (!health2.ok) return;\n   188\t    expect(\n   189\t      health2.value.owners.some((owner) => owner.kind === \"capture_gap\" && owner.counts.failed > 0),\n   190\t    ).toBe(true);\n   191\t    expect(health2.value.failures.some((failure) => failure.form === \"capture_gap\")).toBe(true);\n   192\t\n   193\t    // The gap note is itself a recorded event — the last recorded position\n   194\t    // advances, proving the surface reflects new capture rather than a snapshot.\n   195\t    const overview2 = await inspect.overview(thread.threadRef);\n   196\t    expect(overview2.ok).toBe(true);\n   197\t    if (!overview2.ok) return;\n   198\t    expect(overview2.value.events.count).toBe(corpus.expected.length + 1);\n   199\t    expect(overview2.value.events.span?.last).toBeGreaterThan(overview1.value.events.span?.last ?? 0);\n   200\t  });\n   201\t});\n","exit_code":0,"status":"completed"}}

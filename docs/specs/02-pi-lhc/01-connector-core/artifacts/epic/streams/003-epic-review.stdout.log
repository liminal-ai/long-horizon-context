{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/threads/internal/registry.ts | sed -n '1,360p'\"","aggregated_output":"     1\timport { existsSync, mkdirSync } from \"node:fs\";\n     2\timport { homedir } from \"node:os\";\n     3\timport { dirname, join } from \"node:path\";\n     4\timport type { DatabaseSync } from \"node:sqlite\";\n     5\timport { openDatabase, runMigrations, type Migration } from \"../../../shared/storage.js\";\n     6\t\n     7\texport const DEFAULT_REGISTRY_PATH = join(homedir(), \".lhc\", \"registry.sqlite\");\n     8\t\n     9\texport function resolveRegistryPath(registryPath?: string): string {\n    10\t  return registryPath ?? DEFAULT_REGISTRY_PATH;\n    11\t}\n    12\t\n    13\tconst REGISTRY_MIGRATIONS: readonly Migration[] = [\n    14\t  {\n    15\t    version: 1,\n    16\t    statements: [\n    17\t      `CREATE TABLE threads (\n    18\t        thread_id TEXT PRIMARY KEY,\n    19\t        file_path TEXT NOT NULL,\n    20\t        title TEXT,\n    21\t        created_at TEXT NOT NULL\n    22\t      );`,\n    23\t    ],\n    24\t  },\n    25\t  {\n    26\t    // A-8 (Epic 02 pi-lhc Story 1): the cwd a thread was created in, so the\n    27\t    // `--resume` picker can scope its list to the current directory. Added as\n    28\t    // its own version (not folded into v1) so a registry created under v1\n    29\t    // upgrades lazily on next open rather than silently lacking the column.\n    30\t    version: 2,\n    31\t    statements: [`ALTER TABLE threads ADD COLUMN cwd TEXT;`],\n    32\t  },\n    33\t];\n    34\t\n    35\t// First write creates the database and schema lazily (design decision 6).\n    36\texport function openRegistryForWrite(registryPath: string): DatabaseSync {\n    37\t  mkdirSync(dirname(registryPath), { recursive: true });\n    38\t  const db = openDatabase(registryPath);\n    39\t  try {\n    40\t    runMigrations(db, REGISTRY_MIGRATIONS);\n    41\t  } catch (cause) {\n    42\t    db.close();\n    43\t    throw cause;\n    44\t  }\n    45\t  return db;\n    46\t}\n    47\t\n    48\t// Reads never create the registry: callers map null to empty list /\n    49\t// thread_not_found. The existence check is the non-creation guarantee —\n    50\t// openDatabase would create the file. An existing registry is brought to the\n    51\t// current schema on open so reads can rely on the current columns (e.g. the\n    52\t// A-8 `cwd` column) regardless of which version created it; a registry already\n    53\t// at the latest version pays nothing (runMigrations is a no-op).\n    54\texport function openRegistryForRead(registryPath: string): DatabaseSync | null {\n    55\t  if (!existsSync(registryPath)) return null;\n    56\t  const db = openDatabase(registryPath);\n    57\t  try {\n    58\t    runMigrations(db, REGISTRY_MIGRATIONS);\n    59\t  } catch (cause) {\n    60\t    db.close();\n    61\t    throw cause;\n    62\t  }\n    63\t  return db;\n    64\t}\n    65\t\n    66\texport interface RegistryRow {\n    67\t  threadId: string;\n    68\t  filePath: string;\n    69\t  title?: string;\n    70\t  cwd?: string;\n    71\t  createdAt: string;\n    72\t}\n    73\t\n    74\tinterface RawRow {\n    75\t  thread_id: string;\n    76\t  file_path: string;\n    77\t  title: string | null;\n    78\t  cwd: string | null;\n    79\t  created_at: string;\n    80\t}\n    81\t\n    82\tconst ROW_COLUMNS = \"thread_id, file_path, title, cwd, created_at\";\n    83\t\n    84\t// Insertion order (rowid) breaks ties at the same created_at timestamp, so\n    85\t// \"most recent\" (the last row) is the last-inserted thread even when two\n    86\t// creations land in the same millisecond — the determinism `--continue`\n    87\t// (resolve the most recently created thread) relies on.\n    88\tconst ROW_ORDER = \"ORDER BY created_at, rowid\";\n    89\t\n    90\tfunction toRegistryRow(raw: RawRow): RegistryRow {\n    91\t  const row: RegistryRow = {\n    92\t    threadId: raw.thread_id,\n    93\t    filePath: raw.file_path,\n    94\t    createdAt: raw.created_at,\n    95\t  };\n    96\t  if (raw.title !== null) row.title = raw.title;\n    97\t  if (raw.cwd !== null) row.cwd = raw.cwd;\n    98\t  return row;\n    99\t}\n   100\t\n   101\texport function insertThreadRow(db: DatabaseSync, row: RegistryRow): void {\n   102\t  db.prepare(\n   103\t    \"INSERT INTO threads (thread_id, file_path, title, cwd, created_at) VALUES (?, ?, ?, ?, ?)\",\n   104\t  ).run(row.threadId, row.filePath, row.title ?? null, row.cwd ?? null, row.createdAt);\n   105\t}\n   106\t\n   107\texport function selectThreadRow(\n   108\t  db: DatabaseSync,\n   109\t  threadId: string,\n   110\t): RegistryRow | undefined {\n   111\t  const raw = db\n   112\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id = ?`)\n   113\t    .get(threadId) as unknown as RawRow | undefined;\n   114\t  return raw === undefined ? undefined : toRegistryRow(raw);\n   115\t}\n   116\t\n   117\t// Partial-id resolve (A-8): every thread whose id begins with the given prefix.\n   118\t// LIKE metacharacters in the (caller-supplied) prefix are escaped so the '_' in\n   119\t// the thread-id scheme (th_<hex>) and any '%' match literally rather than as\n   120\t// wildcards; ESCAPE makes '\\' the escape character.\n   121\texport function selectThreadRowsByPrefix(db: DatabaseSync, prefix: string): RegistryRow[] {\n   122\t  const escaped = prefix.replace(/[\\\\%_]/g, (ch) => `\\\\${ch}`);\n   123\t  const raws = db\n   124\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id LIKE ? ESCAPE '\\\\' ${ROW_ORDER}`)\n   125\t    .all(`${escaped}%`) as unknown as RawRow[];\n   126\t  return raws.map(toRegistryRow);\n   127\t}\n   128\t\n   129\t// cwd, when given, filters at the registry (A-8): the picker must not scope by\n   130\t// filtering an unscoped list after the fact (anti-shim) — the scope is the query.\n   131\texport function selectAllThreadRows(\n   132\t  db: DatabaseSync,\n   133\t  opts: { cwd?: string } = {},\n   134\t): RegistryRow[] {\n   135\t  const raws =\n   136\t    opts.cwd === undefined\n   137\t      ? (db.prepare(`SELECT ${ROW_COLUMNS} FROM threads ${ROW_ORDER}`).all() as unknown as RawRow[])\n   138\t      : (db\n   139\t          .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE cwd = ? ${ROW_ORDER}`)\n   140\t          .all(opts.cwd) as unknown as RawRow[]);\n   141\t  return raws.map(toRegistryRow);\n   142\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/support.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\n     2\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\n     3\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\n     4\t// converter → real LHC intake) so every capture test asserts on recorded\n     5\t// thread state, never on a mocked intake. The two external edges stay as the\n     6\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\n     7\t// SDK runs real against a temp SQLite thread with the deterministic provider\n     8\t// (selected by explicit name, never a production default).\n     9\timport {\n    10\t  inspect,\n    11\t  intakeStream,\n    12\t  type EventKind,\n    13\t  type MessageEventInput,\n    14\t  type OpResult,\n    15\t  type SdkConfig,\n    16\t  type ThreadRef,\n    17\t} from \"lhc\";\n    18\timport { createConnector, type Connector } from \"../../src/index.js\";\n    19\timport type { LaunchFlags } from \"../../src/lifecycle/thread-resolution.js\";\n    20\timport { fakeModelCallText } from \"../fixtures/model-call.js\";\n    21\timport { DEFAULT_PROMPT_NAMES } from \"lhc\";\n    22\timport type { ExtensionContext, SessionStartReason } from \"../../src/pi/types.js\";\n    23\timport { makeSessionStart } from \"../fixtures/synthetic.js\";\n    24\timport type { TempStore } from \"../fixtures/thread.js\";\n    25\t\n    26\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\n    27\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\n    28\t *  assume a TUI. */\n    29\texport function syntheticCtx(cwd = \"/work/capture\"): ExtensionContext {\n    30\t  return {\n    31\t    cwd,\n    32\t    hasUI: false,\n    33\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n    34\t    ui: { notify: () => {} },\n    35\t    sessionManager: { getEntries: () => [] },\n    36\t  };\n    37\t}\n    38\t\n    39\t/** The capture-suite SDK config: a real background instance on the\n    40\t *  deterministic provider, so a captured user_prompt's queued derivation has a\n    41\t *  handler to settle and never strands background work. */\n    42\texport function captureConfig(): OpResult<SdkConfig> {\n    43\t  return {\n    44\t    ok: true,\n    45\t    value: {\n    46\t      inference: {\n    47\t        call: fakeModelCallText(\"deterministic text\"),\n    48\t        assignments: {\n    49\t          smoothed_prompt: { provider: \"deterministic\", model: \"default\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    50\t          tool_call_summary: { provider: \"deterministic\", model: \"default\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n    51\t          tool_result_summary: { provider: \"deterministic\", model: \"default\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n    52\t          turn_rendering: { provider: \"deterministic\", model: \"default\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n    53\t          lower_band_projection: { provider: \"deterministic\", model: \"default\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n    54\t          chunk_summary_detailed: { provider: \"deterministic\", model: \"default\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n    55\t          chunk_summary_brief: { provider: \"deterministic\", model: \"default\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n    56\t        },\n    57\t      },\n    58\t      mode: \"background\",\n    59\t    },\n    60\t  };\n    61\t}\n    62\t\n    63\texport interface StartedCapture {\n    64\t  connector: Connector;\n    65\t  ctx: ExtensionContext;\n    66\t  threadRef: ThreadRef;\n    67\t}\n    68\t\n    69\t/** Start a connector against a temp store under the given launch flags and fire\n    70\t *  `session_start{reason}`. The driver for existing-thread reattach: pass\n    71\t *  `{ session: threadId }` with reason `\"resume\"`/`\"reload\"` to attach a fresh\n    72\t *  connector to a thread a prior connector created. */\n    73\texport async function attachCapture(\n    74\t  store: TempStore,\n    75\t  launch: LaunchFlags,\n    76\t  reason: SessionStartReason,\n    77\t  cwd = \"/work/capture\",\n    78\t): Promise<StartedCapture> {\n    79\t  const connector = createConnector({\n    80\t    registryPath: store.registryPath,\n    81\t    newThreadFilePath: () => store.threadPath(),\n    82\t    parseLaunch: () => launch,\n    83\t    buildSdkConfig: () => captureConfig(),\n    84\t  });\n    85\t  const ctx = syntheticCtx(cwd);\n    86\t  await connector.handlers.session_start(ctx, makeSessionStart(reason));\n    87\t  const state = connector.getState();\n    88\t  if (state === null) throw new Error(\"attachCapture: session_start did not resolve a thread\");\n    89\t  return { connector, ctx, threadRef: state.threadRef };\n    90\t}\n    91\t\n    92\t/** Start a connector against a temp store and fire `session_start{new}` so a\n    93\t *  background instance + thread exist and the capture hooks are live. */\n    94\texport async function startCapture(store: TempStore, cwd = \"/work/capture\"): Promise<StartedCapture> {\n    95\t  return attachCapture(store, {}, \"new\", cwd);\n    96\t}\n    97\t\n    98\t/** Settle background work and dispose, then read the durable event log back in\n    99\t *  recorded order — capture's product is the stored thread, so tests assert on\n   100\t *  this. */\n   101\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\n   102\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \"shutdown\" });\n   103\t  const read = await intakeStream.listEvents(started.threadRef);\n   104\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n   105\t  // Strip the server-stamped fields so the comparison is over the logical\n   106\t  // intake shape the converter produced.\n   107\t  return read.value.map((record) => ({\n   108\t    eventKind: record.eventKind,\n   109\t    idempotencyKey: record.idempotencyKey,\n   110\t    actor: record.actor,\n   111\t    harness: record.harness,\n   112\t    payload: record.payload,\n   113\t  })) as MessageEventInput[];\n   114\t}\n   115\t\n   116\t/** The ordered event-kind sequence — the spine every capture test checks. */\n   117\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\n   118\t  return events.map((event) => event.eventKind);\n   119\t}\n   120\t\n   121\t/** Counts open/closed turns and total recorded events from the inspect\n   122\t *  overview (the real read-back surface, not a private query). */\n   123\texport async function turnCounts(\n   124\t  threadRef: ThreadRef,\n   125\t): Promise<{ open: number; closed: number; events: number }> {\n   126\t  const overview = await inspect.overview(threadRef);\n   127\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\n   128\t  return {\n   129\t    open: overview.value.turns.open,\n   130\t    closed: overview.value.turns.closed,\n   131\t    events: overview.value.events.count,\n   132\t  };\n   133\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/threads/index.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runWithThreadTouchSuppressed } from \"../../shared/context.js\";\n     3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     4\timport {\n     5\t  createThreadFile,\n     6\t  deleteThreadFile,\n     7\t  generateThreadId,\n     8\t  openThreadDatabase,\n     9\t} from \"./internal/create.js\";\n    10\t\n    11\t// Re-exported for the other domain surfaces: opening a thread file through\n    12\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n    13\t// file gains the message tables here before any write or read touches them).\n    14\texport { openThreadDatabase };\n    15\timport {\n    16\t  insertThreadRow,\n    17\t  openRegistryForRead,\n    18\t  openRegistryForWrite,\n    19\t  resolveRegistryPath,\n    20\t  selectAllThreadRows,\n    21\t  selectThreadRow,\n    22\t  selectThreadRowsByPrefix,\n    23\t  type RegistryRow,\n    24\t} from \"./internal/registry.js\";\n    25\t\n    26\texport type ThreadRef =\n    27\t  | { threadId: string; registryPath?: string }\n    28\t  | { filePath: string };\n    29\t\n    30\texport interface NewThreadInput {\n    31\t  filePath: string;\n    32\t  title?: string;\n    33\t  cwd?: string;\n    34\t  registryPath?: string;\n    35\t}\n    36\t\n    37\texport interface ThreadInfo {\n    38\t  threadId: string;\n    39\t  filePath: string;\n    40\t  title?: string;\n    41\t  cwd?: string;\n    42\t  createdAt: string; // ISO-8601\n    43\t}\n    44\t\n    45\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n    46\t  const info: ThreadInfo = {\n    47\t    threadId: row.threadId,\n    48\t    filePath: row.filePath,\n    49\t    createdAt: row.createdAt,\n    50\t  };\n    51\t  if (row.title !== undefined) info.title = row.title;\n    52\t  if (row.cwd !== undefined) info.cwd = row.cwd;\n    53\t  return info;\n    54\t}\n    55\t\n    56\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n    57\t  return {\n    58\t    ok: false,\n    59\t    error: {\n    60\t      errorClass: \"caller_error\",\n    61\t      code: \"thread_not_found\",\n    62\t      reason: `no thread registered with id ${threadId}`,\n    63\t    },\n    64\t  };\n    65\t}\n    66\t\n    67\t// A partial id that matches more than one thread is a caller error, not a\n    68\t// silent pick: resolution names the collision and the caller must disambiguate\n    69\t// (AC-1.6 — an ambiguous id fails loud, never resolves arbitrarily).\n    70\tfunction ambiguousThreadId(\n    71\t  prefix: string,\n    72\t  matchIds: readonly string[],\n    73\t): { ok: false; error: ErrorResult } {\n    74\t  return {\n    75\t    ok: false,\n    76\t    error: {\n    77\t      errorClass: \"caller_error\",\n    78\t      code: \"ambiguous_thread_id\",\n    79\t      reason: `thread id \"${prefix}\" is ambiguous: it matches ${matchIds.length} threads (${matchIds.join(\", \")}); use a longer id`,\n    80\t    },\n    81\t  };\n    82\t}\n    83\t\n    84\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n    85\t  return {\n    86\t    ok: false,\n    87\t    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n    88\t  };\n    89\t}\n    90\t\n    91\t// A file path that is empty or whitespace-only cannot name a durable file:\n    92\t// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n    93\t// close, so such a path must be refused as a caller error before any storage\n    94\t// is touched rather than silently producing a thread with no durable file.\n    95\tfunction isBlankPath(filePath: string): boolean {\n    96\t  return filePath.trim() === \"\";\n    97\t}\n    98\t\n    99\tfunction detail(cause: unknown): string {\n   100\t  return cause instanceof Error ? cause.message : String(cause);\n   101\t}\n   102\t\n   103\t// Creation spans two databases that cannot share a transaction. Order is\n   104\t// file-then-row with compensation: the invariant \"no registry row without\n   105\t// its file\" is absolute; an orphan file from a crash between the writes is\n   106\t// documented harmless (design decision 2).\n   107\texport async function newThread(\n   108\t  input: NewThreadInput,\n   109\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n   110\t  // Guard before any storage touch: an empty/blank path would otherwise open\n   111\t  // a temp database and register a thread with no durable file (the no-row-\n   112\t  // without-file invariant below depends on the path naming a real file).\n   113\t  if (isBlankPath(input.filePath)) {\n   114\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n   115\t  }\n   116\t  if (existsSync(input.filePath)) {\n   117\t    return {\n   118\t      ok: false,\n   119\t      error: {\n   120\t        errorClass: \"caller_error\",\n   121\t        code: \"path_exists\",\n   122\t        reason: `a file already exists at ${input.filePath}`,\n   123\t      },\n   124\t    };\n   125\t  }\n   126\t\n   127\t  const threadId = generateThreadId();\n   128\t  const createdAt = new Date().toISOString();\n   129\t\n   130\t  try {\n   131\t    createThreadFile(input.filePath, threadId, createdAt);\n   132\t  } catch (cause) {\n   133\t    deleteThreadFile(input.filePath);\n   134\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n   135\t  }\n   136\t\n   137\t  let registry;\n   138\t  try {\n   139\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n   140\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n   141\t    if (input.title !== undefined) row.title = input.title;\n   142\t    if (input.cwd !== undefined) row.cwd = input.cwd;\n   143\t    insertThreadRow(registry, row);\n   144\t  } catch (cause) {\n   145\t    deleteThreadFile(input.filePath);\n   146\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n   147\t  } finally {\n   148\t    registry?.close();\n   149\t  }\n   150\t\n   151\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n   152\t}\n   153\t\n   154\t// Resolution accepts a full or partial (prefix) thread id (A-8). An exact id\n   155\t// wins outright — a full id always resolves to itself, even if it is also a\n   156\t// prefix of a longer id — so only a genuinely partial id ever consults the\n   157\t// prefix path; that path resolves a unique prefix, fails ambiguous on more than\n   158\t// one match, and fails not-found on none. No path ever creates a thread.\n   159\texport async function resolve(input: {\n   160\t  threadId: string;\n   161\t  registryPath?: string;\n   162\t}): Promise<OpResult<ThreadInfo>> {\n   163\t  let registry;\n   164\t  try {\n   165\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n   166\t    if (registry === null) return threadNotFound(input.threadId);\n   167\t    const exact = selectThreadRow(registry, input.threadId);\n   168\t    if (exact !== undefined) return { ok: true, value: toThreadInfo(exact) };\n   169\t    const matches = selectThreadRowsByPrefix(registry, input.threadId);\n   170\t    if (matches.length === 1) return { ok: true, value: toThreadInfo(matches[0]!) };\n   171\t    if (matches.length > 1) {\n   172\t      return ambiguousThreadId(\n   173\t        input.threadId,\n   174\t        matches.map((m) => m.threadId),\n   175\t      );\n   176\t    }\n   177\t    return threadNotFound(input.threadId);\n   178\t  } catch (cause) {\n   179\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   180\t  } finally {\n   181\t    registry?.close();\n   182\t  }\n   183\t}\n   184\t\n   185\texport async function listThreads(input?: {\n   186\t  cwd?: string;\n   187\t  registryPath?: string;\n   188\t}): Promise<OpResult<ThreadInfo[]>> {\n   189\t  let registry;\n   190\t  try {\n   191\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n   192\t    if (registry === null) return { ok: true, value: [] };\n   193\t    const opts = input?.cwd === undefined ? {} : { cwd: input.cwd };\n   194\t    return { ok: true, value: selectAllThreadRows(registry, opts).map(toThreadInfo) };\n   195\t  } catch (cause) {\n   196\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   197\t  } finally {\n   198\t    registry?.close();\n   199\t  }\n   200\t}\n   201\t\n   202\t// The thread file's own identity header (Epic 04): thread_metadata is this\n   203\t// domain's table — creation writes it (internal/create.ts) and only this\n   204\t// surface reads it back. Added for inspect's overview, which must report\n   205\t// thread identity for ANY resolvable ref — including a { filePath } ref that\n   206\t// no registry knows — without reading tables itself (inspect's must-not-own\n   207\t// rule). A pure read: the whole operation runs touch-suppressed (DD-6), so a\n   208\t// background SDK can never hang a first-touch catch-up drain off it.\n   209\texport interface ThreadFileInfo {\n   210\t  threadId: string;\n   211\t  createdAt: string;\n   212\t}\n   213\t\n   214\texport async function info(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\n   215\t  return runWithThreadTouchSuppressed(() => infoInner(ref));\n   216\t}\n   217\t\n   218\tasync function infoInner(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\n   219\t  const resolved = await resolveThreadRef(ref);\n   220\t  if (!resolved.ok) return resolved;\n   221\t  const { filePath } = resolved.value;\n   222\t  if (!existsSync(filePath)) {\n   223\t    return {\n   224\t      ok: false,\n   225\t      error: {\n   226\t        errorClass: \"caller_error\",\n   227\t        code: \"thread_not_found\",\n   228\t        reason: `no thread file exists at ${filePath}`,\n   229\t      },\n   230\t    };\n   231\t  }\n   232\t  const opened = openThreadDatabase(filePath);\n   233\t  if (!opened.ok) return opened;\n   234\t  const db = opened.value;\n   235\t  try {\n   236\t    const row = db\n   237\t      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n   238\t      .get() as { thread_id: string; created_at: string } | undefined;\n   239\t    if (row === undefined) {\n   240\t      // openThreadDatabase validated the row exists; its absence here is\n   241\t      // external interference between the probe and this read.\n   242\t      return storageFailure(`thread file at ${filePath} lost its metadata row`);\n   243\t    }\n   244\t    return { ok: true, value: { threadId: row.thread_id, createdAt: row.created_at } };\n   245\t  } catch (cause) {\n   246\t    return storageFailure(`thread info read failed: ${detail(cause)}`);\n   247\t  } finally {\n   248\t    db.close();\n   249\t  }\n   250\t}\n   251\t\n   252\t// The single interpreter of thread references: { threadId } resolves to a\n   253\t// path through the registry, { filePath } passes through untouched. No other\n   254\t// code ever reads a thread reference.\n   255\texport async function resolveThreadRef(\n   256\t  ref: ThreadRef,\n   257\t): Promise<OpResult<{ filePath: string }>> {\n   258\t  if (\"threadId\" in ref) {\n   259\t    const resolved = await resolve(ref);\n   260\t    if (!resolved.ok) return resolved;\n","exit_code":0,"status":"completed"}}

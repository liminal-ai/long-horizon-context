ges/pi-lhc/test/inference/model-call.test.ts:260:    it(\\\"LHC adapter classifies empty resolved output as empty_output\\\", async () => {\\npackages/pi-lhc/test/inference/model-call.test.ts:288:            idempotencyKey: \\\"empty-output-prompt\\\",\\npackages/pi-lhc/test/inference/model-call.test.ts:289:            payload: { text: \\\"produce no output\\\" },\\npackages/pi-lhc/test/inference/model-call.test.ts:302:              reason: expect.stringContaining(\\\"empty_output\\\"),\\npackages/pi-lhc/test/inference/model-call.test.ts:303:              lastError: expect.stringContaining(\\\"empty_output\\\"),\\npackages/pi-lhc/test/inference/startup-validation.test.ts:11:import type { ExtensionContext, ModelHandle } from \\\"../../src/pi/types.js\\\";\\npackages/pi-lhc/test/inference/startup-validation.test.ts:16:/** Create a minimal ExtensionContext for testing. */\\npackages/pi-lhc/test/inference/startup-validation.test.ts:21:): ExtensionContext {\\npackages/pi-lhc/test/inference/startup-validation.test.ts:282:        const ctx: ExtensionContext = {\\npackages/pi-lhc/test/inference/closed-loop.test.ts:13:import type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\npackages/pi-lhc/test/inference/closed-loop.test.ts:43:  ctx: ExtensionContext,\\npackages/pi-lhc/test/inference/closed-loop.test.ts:63:  let ctx: ExtensionContext;\\npackages/pi-lhc/src/lifecycle/fork.ts:6:import type { ExtensionContext, SessionStartEvent } from \\\"../pi/types.js\\\";\\npackages/pi-lhc/src/lifecycle/fork.ts:23:  ctx: ExtensionContext,\\npackages/pi-lhc/test/smoke/extension-load.test.ts:10:import type { ExtensionAPI, ExtensionContext, PiHookName } from \\\"../../src/pi/types.js\\\";\\npackages/pi-lhc/test/smoke/extension-load.test.ts:49:function syntheticCtx(marker: string): ExtensionContext {\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:24:import type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\npackages/pi-lhc/test/lifecycle/thread-resolution.te
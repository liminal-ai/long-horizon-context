{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/inference/startup-validation.test.ts | sed -n '360,460p'\"","aggregated_output":"   360\t\n   361\t        expect(instance).not.toBeNull();\n   362\t        expect(state).not.toBeNull();\n   363\t        if (instance === null || state === null) return;\n   364\t\n   365\t        // Verify validation reported the unreachable lane (smoothed_prompt)\n   366\t        expect(state.health.startupValidation).toBeDefined();\n   367\t        expect(state.health.startupValidation?.unreachable.length).toBeGreaterThan(0);\n   368\t        const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n   369\t        expect(smoothEntry?.reason).toBe(\"unknown_model\");\n   370\t\n   371\t        // Capture continues despite validation failure\n   372\t        await connector.handlers.message_end(ctx, {\n   373\t          message: makeUserMessage(\"test prompt\"),\n   374\t          entryId: \"test-user\",\n   375\t        });\n   376\t        await connector.handlers.message_end(ctx, {\n   377\t          message: makeAssistantMessage({ text: \"test response\" }),\n   378\t          entryId: \"test-assistant\",\n   379\t        });\n   380\t        await connector.handlers.agent_end(ctx, {\n   381\t          messages: [makeUserMessage(\"test prompt\"), makeAssistantMessage({ text: \"test response\" })],\n   382\t        });\n   383\t\n   384\t        // Drain the scheduler to run derivations\n   385\t        const threadRef = state.threadRef;\n   386\t        await instance.sdk.drainSettled(threadRef);\n   387\t\n   388\t        // Inspect health to verify affected lane derivations failed\n   389\t        const health = await instance.sdk.inspect.health(threadRef);\n   390\t        expect(health.ok).toBe(true);\n   391\t        if (!health.ok) return;\n   392\t\n   393\t        // Verify that smoothed_prompt derivations failed classified (unreachable lane)\n   394\t        const smoothedFailed = health.value.owners.some((o) =>\n   395\t          o.kind === \"smoothed_prompt\" && o.counts.failed > 0\n   396\t        );\n   397\t        expect(smoothedFailed).toBe(true);\n   398\t\n   399\t        // Verify that turn_rendering derivations succeeded (reachable lane)\n   400\t        const turnRenderingReady = health.value.owners.some((o) =>\n   401\t          o.kind === \"turn_rendering\" && o.counts.ready > 0\n   402\t        );\n   403\t        expect(turnRenderingReady).toBe(true);\n   404\t\n   405\t        // Verify failures are queryable through health\n   406\t        expect(health.value.failures.length).toBeGreaterThan(0);\n   407\t        const smoothedFailure = health.value.failures.find((f) => f.form === \"smoothed_prompt\");\n   408\t        expect(smoothedFailure).toBeDefined();\n   409\t        expect(smoothedFailure?.reason).toContain(\"invalid_request\");\n   410\t        expect(smoothedFailure?.lastError).toContain(\"unreachable assignment lane\");\n   411\t\n   412\t        await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   413\t      } finally {\n   414\t        store.cleanup();\n   415\t      }\n   416\t    });\n   417\t\n   418\t    it(\"validation does not break the session - state remains functional\", () => {\n   419\t      const ctx = createMockContext();\n   420\t      const assignments = createAssignments();\n   421\t\n   422\t      const validationReport = validateReachable(assignments, ctx);\n   423\t\n   424\t      const state: SessionState = {\n   425\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   426\t        flags: { startupValidationReported: false },\n   427\t        health: {},\n   428\t      };\n   429\t\n   430\t      report(validationReport, ctx, state);\n   431\t\n   432\t      // State should be fully functional for capture operations\n   433\t      expect(state.threadRef).toBeDefined();\n   434\t      expect(\"filePath\" in state.threadRef && typeof state.threadRef.filePath === \"string\").toBe(true);\n   435\t      expect(state.flags).toBeDefined();\n   436\t      expect(state.health).toBeDefined();\n   437\t\n   438\t      // Health should be queryable\n   439\t      expect(state.health.startupValidation).toBeDefined();\n   440\t    });\n   441\t\n   442\t    it(\"empty unreachable list means all lanes reachable - session healthy\", () => {\n   443\t      const models: ModelHandle[] = [{ provider: \"openai\", id: \"gpt-4o\" }];\n   444\t      const ctx = createMockContext(models, models[0], true);\n   445\t      const assignments = createAssignments({\n   446\t        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   447\t      });\n   448\t\n   449\t      const validationReport = validateReachable(assignments, ctx);\n   450\t\n   451\t      const state: SessionState = {\n   452\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   453\t        flags: { startupValidationReported: false },\n   454\t        health: {},\n   455\t      };\n   456\t\n   457\t      report(validationReport, ctx, state);\n   458\t\n   459\t      // Empty unreachable means all lanes validated successfully\n   460\t      expect(state.health.startupValidation?.unreachable).toHaveLength(0);\n","exit_code":0,"status":"completed"}}

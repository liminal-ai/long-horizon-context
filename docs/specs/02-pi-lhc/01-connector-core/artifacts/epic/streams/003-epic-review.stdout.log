{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/lifecycle/instance.ts | sed -n '1,240p'\"","aggregated_output":"     1\timport {\n     2\t  createSdk,\n     3\t  threads,\n     4\t  type Lhc,\n     5\t  type OpResult,\n     6\t  type SdkConfig,\n     7\t  type ThreadRef,\n     8\t} from \"lhc\";\n     9\timport type { LhcInstance } from \"../shared/instance.js\";\n    10\t\n    11\t// AC-1.1, AC-1.4, AC-1.5.\n    12\t\n    13\t/** The connector's name for SDK construction — the agreed rename of LHC's\n    14\t *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n    15\t *  either way). One instance per PI session in background scheduler mode; the\n    16\t *  connector never drives the queue (Flow 1). */\n    17\texport function initLhc(config: SdkConfig): Lhc {\n    18\t  return createSdk(config);\n    19\t}\n    20\t\n    21\tfunction detail(cause: unknown): string {\n    22\t  return cause instanceof Error ? cause.message : String(cause);\n    23\t}\n    24\t\n    25\t/** Flush-on-dispose: await any pending background derivations for this thread,\n    26\t *  then release the instance. Captured intake is already durable (intake writes\n    27\t *  commit synchronously), so the flush is about letting in-flight background\n    28\t *  work settle before shutdown — never a throw back into a PI hook. */\n    29\tasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n    30\t  try {\n    31\t    await sdk.drainSettled(threadRef);\n    32\t  } catch (cause) {\n    33\t    return {\n    34\t      ok: false,\n    35\t      error: {\n    36\t        errorClass: \"system_error\",\n    37\t        code: \"storage_failure\",\n    38\t        reason: `instance dispose flush failed: ${detail(cause)}`,\n    39\t      },\n    40\t    };\n    41\t  }\n    42\t  return { ok: true, value: undefined };\n    43\t}\n    44\t\n    45\t/** Construct one LHC instance against a resolved thread in background scheduler\n    46\t *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n    47\t *  typed result rather than a half-built instance; background mode is forced\n    48\t *  regardless of the caller's config so the connector cannot accidentally drive\n    49\t *  the queue. A malformed inference/provider config is a programmer error and\n    50\t *  throws here per LHC's construction contract — the hook guard in `index.ts`\n    51\t *  contains it so nothing reaches the PI session. */\n    52\texport async function initInstance(\n    53\t  threadRef: ThreadRef,\n    54\t  config: SdkConfig,\n    55\t): Promise<OpResult<LhcInstance>> {\n    56\t  const info = await threads.info(threadRef);\n    57\t  if (!info.ok) return info;\n    58\t\n    59\t  const sdk = initLhc({ ...config, mode: \"background\" });\n    60\t  const instance: LhcInstance = {\n    61\t    sdk,\n    62\t    threadRef,\n    63\t    dispose: () => disposeSdk(sdk, threadRef),\n    64\t  };\n    65\t  return { ok: true, value: instance };\n    66\t}\n    67\t\n    68\t/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n    69\t *  shutdown with no live instance is a successful no-op, never an error. */\n    70\texport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n    71\t  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n    72\t  return instance.dispose();\n    73\t}\n","exit_code":0,"status":"completed"}}

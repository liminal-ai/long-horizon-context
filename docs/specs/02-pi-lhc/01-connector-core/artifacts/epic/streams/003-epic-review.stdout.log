{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_573ac1d7dcc448a1b2ff848b","type":"tool_result","content":"1\t// AC-5.4, AC-5.5. Load the seven assignments from config; fail loud on\n2\t// missing/unknown/placeholder.\n3\t//\n4\t// Assignments provide provider, model, and prompt for all seven derivation\n5\t// kinds. LHC's createSdk already validates assignment shape at construction\n6\t// (all seven kinds present, non-empty provider/model, prompt-name registered).\n7\t// This layer adds operator config loading on top, with user overrides that\n8\t// take effect on the next session start (no code change).\n9\t//\n10\t// Shipped defaults are defined in model-call.ts (defaultAssignments). This\n11\t// module merges operator config over those defaults and validates the result.\n12\t\n13\timport type { FormKind, ModelAssignment } from \"lhc\";\n14\timport { DEFAULT_PROMPT_NAMES, FORM_KINDS } from \"lhc\";\n15\timport { defaultAssignments } from \"./model-call.js\";\n16\t\n17\t/** Operator config shape for derivation assignments.\n18\t *\n19\t *  Each key is optional; missing kinds use the shipped default. Values override\n20\t *  provider, model, or prompt for that kind. An assignment is incomplete if it\n21\t *  omits any of provider, model, or prompt (fails loud at load, per AC-5.5).\n22\t *\n23\t *  Example:\n24\t *  {\n25\t *    smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: \"custom-smoothing\" },\n26\t *    tool_call_summary: { provider: \"anthropic\", model: \"claude-3-opus\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary }\n27\t *  }\n28\t */\n29\texport interface AssignmentConfig {\n30\t  [key: string]: Partial<ModelAssignment> | undefined;\n31\t}\n32\t\n33\t/** Error thrown when an assignment is incomplete or references an unknown prompt.\n34\t *  Carries the kind and the specific validation problem for actionable error\n35\t *  reporting (AC-5.5: \"fails loudly at initialization with an actionable error\"). */\n36\texport class AssignmentValidationError extends Error {\n37\t  readonly kind: FormKind;\n38\t  readonly problem: \"incomplete\" | \"unknown_prompt\" | \"placeholder\";\n39\t\n40\t  constructor(kind: FormKind, problem: \"incomplete\" | \"unknown_prompt\" | \"placeholder\") {\n41\t    let message: string;\n42\t    switch (problem) {\n43\t      case \"incomplete\":\n44\t        message = `Assignment for '${kind}' is incomplete: must specify provider, model, and prompt`;\n45\t        break;\n46\t      case \"unknown_prompt\":\n47\t        message = `Assignment for '${kind}' references an unknown prompt: prompt must be registered in LHC's prompt registry`;\n48\t        break;\n49\t      case \"placeholder\":\n50\t        message = `Assignment for '${kind}' contains placeholder values: provider and model must be concrete identifiers`;\n51\t        break;\n52\t    }\n53\t    super(message);\n54\t    this.name = \"AssignmentValidationError\";\n55\t    this.kind = kind;\n56\t    this.problem = problem;\n57\t  }\n58\t}\n59\t\n60\t/** Check if an assignment is complete (has provider, model, and prompt). */\n61\tfunction isComplete(assignment: Partial<ModelAssignment>): assignment is ModelAssignment {\n62\t  return (\n63\t    assignment.provider !== undefined &&\n64\t    assignment.model !== undefined &&\n65\t    assignment.prompt !== undefined\n66\t  );\n67\t}\n68\t\n69\t/** Check if an assignment contains placeholder values that would mask misconfiguration. */\n70\tfunction hasPlaceholder(assignment: ModelAssignment): boolean {\n71\t  const placeholderPatterns = [\n72\t    \"unconfigured\",\n73\t    \"placeholder\",\n74\t    \"example\",\n75\t    \"your-\",\n76\t    \"your_provider\",\n77\t    \"your-model\",\n78\t    \"your_model\",\n79\t  ];\n80\t  const providerLower = assignment.provider.toLowerCase();\n81\t  const modelLower = assignment.model.toLowerCase();\n82\t\n83\t  return placeholderPatterns.some((pattern) =>\n84\t    providerLower.includes(pattern) || modelLower.includes(pattern)\n85\t  );\n86\t}\n87\t\n88\t/** Check if a prompt name is registered in LHC's prompt registry. */\n89\tfunction isPromptRegistered(promptName: string): boolean {\n90\t  return Object.values(DEFAULT_PROMPT_NAMES).includes(promptName);\n91\t}\n92\t\n93\t/** Validate a single assignment and throw if it fails shape checks. */\n94\tfunction validateAssignment(kind: FormKind, assignment: Partial<ModelAssignment>): ModelAssignment {\n95\t  if (!isComplete(assignment)) {\n96\t    throw new AssignmentValidationError(kind, \"incomplete\");\n97\t  }\n98\t\n99\t  // Check for placeholder values (AC-5.6: placeholder fails loud)\n100\t  if (hasPlaceholder(assignment)) {\n101\t    throw new AssignmentValidationError(kind, \"placeholder\");\n102\t  }\n103\t\n104\t  // Check that the prompt is registered (AC-5.4: prompt must name a registered prompt)\n105\t  if (!isPromptRegistered(assignment.prompt)) {\n106\t    throw new AssignmentValidationError(kind, \"unknown_prompt\");\n107\t  }\n108\t\n109\t  return assignment;\n110\t}\n111\t\n112\t/** Load + shape-validate the seven derivation assignments from operator config.\n113\t *\n114\t *  - Merges operator config over shipped defaults (AC-5.4).\n115\t *  - Falls back to defaults when config is missing or undefined (AC-5.4).\n116\t *  - User overrides take effect on next session start with no code change (AC-5.5).\n117\t *  - Incomplete assignments fail loud at initialization (AC-5.5, TC-5.6).\n118\t *  - Unknown prompts fail loud at initialization (TC-5.6).\n119\t *  - Placeholder values fail loud at initialization (TC-5.6).\n120\t *\n121\t *  This function throws `AssignmentValidationError` on any validation failure;\n122\t *  the caller (typically the session_start hook) catches and surfaces the error\n123\t *  as an actionable diagnostic. It never returns an incomplete or placeholder map\n124\t *  that would mask a misconfiguration (story §Anti-Shim Requirements). */\n125\texport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n126\t  // Start with shipped defaults (all seven kinds with concrete assignments)\n127\t  const baseAssignments = defaultAssignments() as Partial<Record<FormKind, ModelAssignment>>;\n128\t  const mergedAssignments: Partial<Record<FormKind, ModelAssignment>> = {};\n129\t\n130\t  for (const kind of FORM_KINDS) {\n131\t    mergedAssignments[kind] = validateAssignment(kind, baseAssignments[kind] ?? {});\n132\t  }\n133\t\n134\t  // If config is missing/null/undefined, use defaults as-is\n135\t  if (config === null || config === undefined || typeof config !== \"object\") {\n136\t    return mergedAssignments as Record<FormKind, ModelAssignment>;\n137\t  }\n138\t\n139\t  const configObj = config as Partial<Record<FormKind, Partial<ModelAssignment>>>;\n140\t\n141\t  // Check for unknown assignment keys (SV-002: fail loud on extra keys)\n142\t  const configKeys = Object.keys(configObj) as Array<string>;\n143\t  for (const key of configKeys) {\n144\t    if (key !== \"\" && !FORM_KINDS.includes(key as FormKind)) {\n145\t      throw new Error(`Unknown assignment key '${key}': must be one of ${FORM_KINDS.join(\", \")}`);\n146\t    }\n147\t  }\n148\t\n149\t  // Merge operator config over defaults for kinds that are specified\n150\t  for (const kind of FORM_KINDS) {\n151\t    const override = configObj[kind as FormKind];\n152\t    if (override !== undefined) {\n153\t      mergedAssignments[kind] = validateAssignment(kind, override);\n154\t    }\n155\t  }\n156\t\n157\t  // At this point we have validated all seven kinds (FORM_KINDS covers all seven)\n158\t  return mergedAssignments as Record<FormKind, ModelAssignment>;\n159\t}\n160\t"}]},"parent_tool_use_id":null,"session_id":"54bb6891-be78-43f8-a277-229ffe48e3f0","uuid":"c4d365ee-d3bf-4cdc-9627-3094de809917","timestamp":"2026-06-14T13:48:27.056Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/assignments.ts","content":"// AC-5.4, AC-5.5. Load the seven assignments from config; fail loud on\n// missing/unknown/placeholder.\n//\n// Assignments provide provider, model, and prompt for all seven derivation\n// kinds. LHC's createSdk already validates assignment shape at construction\n// (all seven kinds present, non-empty provider/model, prompt-name registered).\n// This layer adds operator config loading on top, with user overrides that\n// take effect on the next session start (no code change).\n//\n// Shipped defaults are defined in model-call.ts (defaultAssignments). This\n// module merges operator config over those defaults and validates the result.\n\nimport type { FormKind, ModelAssignment } from \"lhc\";\nimport { DEFAULT_PROMPT_NAMES, FORM_KINDS } from \"lhc\";\nimport { defaultAssignments } from \"./model-call.js\";\n\n/** Operator config shape for derivation assignments.\n *\n *  Each key is optional; missing kinds use the shipped default. Values override\n *  provider, model, or prompt for that kind. An assignment is incomplete if it\n *  omits any of provider, model, or prompt (fails loud at load, per AC-5.5).\n *\n *  Example:\n *  {\n *    smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: \"custom-smoothing\" },\n *    tool_call_summary: { provider: \"anthropic\", model: \"claude-3-opus\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary }\n *  }\n */\nexport interface AssignmentConfig {\n  [key: string]: Partial<ModelAssignment> | undefined;\n}\n\n/** Error thrown when an assignment is incomplete or references an unknown prompt.\n *  Carries the kind and the specific validation problem for actionable error\n *  reporting (AC-5.5: \"fails loudly at initialization with an actionable error\"). */\nexport class AssignmentValidationError extends Error {\n  readonly kind: FormKind;\n  readonly problem: \"incomplete\" | \"unknown_prompt\" | \"placeholder\";\n\n  constructor(kind: FormKind, problem: \"incomplete\" | \"unknown_prompt\" | \"placeholder\") {\n    let message: string;\n    switch (problem) {\n      case \"incomplete\":\n        message = `Assignment for '${kind}' is incomplete: must specify provider, model, and prompt`;\n        break;\n      case \"unknown_prompt\":\n        message = `Assignment for '${kind}' references an unknown prompt: prompt must be registered in LHC's prompt registry`;\n        break;\n      case \"placeholder\":\n        message = `Assignment for '${kind}' contains placeholder values: provider and model must be concrete identifiers`;\n        break;\n    }\n    super(message);\n    this.name = \"AssignmentValidationError\";\n    this.kind = kind;\n    this.problem = problem;\n  }\n}\n\n/** Check if an assignment is complete (has provider, model, and prompt). */\nfunction isComplete(assignment: Partial<ModelAssignment>): assignment is ModelAssignment {\n  return (\n    assignment.provider !== undefined &&\n    assignment.model !== undefined &&\n    assignment.prompt !== undefined\n  );\n}\n\n/** Check if an assignment contains placeholder values that would mask misconfiguration. */\nfunction hasPlaceholder(assignment: ModelAssignment): boolean {\n  const placeholderPatterns = [\n    \"unconfigured\",\n    \"placeholder\",\n    \"example\",\n    \"your-\",\n    \"your_provider\",\n    \"your-model\",\n    \"your_model\",\n  ];\n  const providerLower = assignment.provider.toLowerCase();\n  const modelLower = assignment.model.toLowerCase();\n\n  return placeholderPatterns.some((pattern) =>\n    providerLower.includes(pattern) || modelLower.includes(pattern)\n  );\n}\n\n/** Check if a prompt name is registered in LHC's prompt registry. */\nfunction isPromptRegistered(promptName: string): boolean {\n  return Object.values(DEFAULT_PROMPT_NAMES).includes(promptName);\n}\n\n/** Validate a single assignment and throw if it fails shape checks. */\nfunction validateAssignment(kind: FormKind, assignment: Partial<ModelAssignment>): ModelAssignment {\n  if (!isComplete(assignment)) {\n    throw new AssignmentValidationError(kind, \"incomplete\");\n  }\n\n  // Check for placeholder values (AC-5.6: placeholder fails loud)\n  if (hasPlaceholder(assignment)) {\n    throw new AssignmentValidationError(kind, \"placeholder\");\n  }\n\n  // Check that the prompt is registered (AC-5.4: prompt must name a registered prompt)\n  if (!isPromptRegistered(assignment.prompt)) {\n    throw new AssignmentValidationError(kind, \"unknown_prompt\");\n  }\n\n  return assignment;\n}\n\n/** Load + shape-validate the seven derivation assignments from operator config.\n *\n *  - Merges operator config over shipped defaults (AC-5.4).\n *  - Falls back to defaults when config is missing or undefined (AC-5.4).\n *  - User overrides take effect on next session start with no code change (AC-5.5).\n *  - Incomplete assignments fail loud at initialization (AC-5.5, TC-5.6).\n *  - Unknown prompts fail loud at initialization (TC-5.6).\n *  - Placeholder values fail loud at initialization (TC-5.6).\n *\n *  This function throws `AssignmentValidationError` on any validation failure;\n *  the caller (typically the session_start hook) catches and surfaces the error\n *  as an actionable diagnostic. It never returns an incomplete or placeholder map\n *  that would mask a misconfiguration (story §Anti-Shim Requirements). */\nexport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n  // Start with shipped defaults (all seven kinds with concrete assignments)\n  const baseAssignments = defaultAssignments() as Partial<Record<FormKind, ModelAssignment>>;\n  const mergedAssignments: Partial<Record<FormKind, ModelAssignment>> = {};\n\n  for (const kind of FORM_KINDS) {\n    mergedAssignments[kind] = validateAssignment(kind, baseAssignments[kind] ?? {});\n  }\n\n  // If config is missing/null/undefined, use defaults as-is\n  if (config === null || config === undefined || typeof config !== \"object\") {\n    return mergedAssignments as Record<FormKind, ModelAssignment>;\n  }\n\n  const configObj = config as Partial<Record<FormKind, Partial<ModelAssignment>>>;\n\n  // Check for unknown assignment keys (SV-002: fail loud on extra keys)\n  const configKeys = Object.keys(configObj) as Array<string>;\n  for (const key of configKeys) {\n    if (key !== \"\" && !FORM_KINDS.includes(key as FormKind)) {\n      throw new Error(`Unknown assignment key '${key}': must be one of ${FORM_KINDS.join(\", \")}`);\n    }\n  }\n\n  // Merge operator config over defaults for kinds that are specified\n  for (const kind of FORM_KINDS) {\n    const override = configObj[kind as FormKind];\n    if (override !== undefined) {\n      mergedAssignments[kind] = validateAssignment(kind, override);\n    }\n  }\n\n  // At this point we have validated all seven kinds (FORM_KINDS covers all seven)\n  return mergedAssignments as Record<FormKind, ModelAssignment>;\n}\n","numLines":160,"startLine":1,"totalLines":160}}}

292\t    return resolveThread(launch, buildResolveDeps(ctx));\n   293\t  }\n   294\t\n   295\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n   296\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n   297\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n   298\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n   299\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n   300\t  async function resolveReloadFor(\n   301\t    launch: LaunchFlags,\n   302\t    ctx: ExtensionContext,\n   303\t  ): Promise<OpResult<ThreadRef | null>> {\n   304\t    const durable = durableThreadStateFromEntries(ctx.sessionManager.getEntries());\n   305\t    if (durable !== null) return { ok: true, value: durable.threadRef };\n   306\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n   307\t  }\n   308\t\n   309\t  // session_start: resolve the recording thread and construct one background\n   310\t  // instance against it. Config is gated first so a session with no usable\n   311\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n   312\t  // thread is re-resolved from the durable registry (reattach, never create);\n   313\t  // every other reason runs the normal launch resolution. Fork creates a new\n   314\t  // thread and seeds it from the source thread (Story 4).\n   315\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   316\t    const config = buildSdkConfig(ctx);\n   317\t    if (!config.ok) {\n   318\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   319\t      return;\n   320\t    }\n   321\t\n   322\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n   323\t    let forkAttempted = false;\n   324\t\n   325\t    // Fork path (Story 4): create a new thread and seed it from the source.\n   326\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n   327\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n   328\t    if (pendingFork !== null) {\n   329\t      forkAttempted = true;\n   330\t      // Hook-based fork detection: session_before_fork fired.\n   331\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n   332\t\n   333\t      // Create a new thread for the fork.\n   334\t      const resolveDeps = buildResolveDeps(ctx);\n   335\t      const newFilePath = resolveDeps.newThreadFilePath();\n   336\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n   337\t        filePath: newFilePath,\n   338\t        cwd: resolveDeps.cwd,\n   339\t      };\n   340\t      if (resolveDeps.registryPath !== undefined) {\n   341\t        newThreadInput.registryPath = resolveDeps.registryPath;\n   342\t      }\n   343\t      const created = await threads.newThread(newThreadInput);\n   344\t      if (!created.ok) {\n   345\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n   346\t        pendingFork = null;\n   347\t        state = null;\n   348\t        captureSession = null;\n   349\t        return;\n   350\t      } else {\n   351\t        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n   352\t\n   353\t        // Initialize the instance against the target thread first (required for seedFork).\n   354\t        const built = await initInstance(targetThreadRef, config.value);\n   355\t        if (!built.ok) {\n   356\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   357\t          pendingFork = null;\n   358\t          state = null;\n   359\t          captureSession = null;\n   360\t          return;\n   361\t        } else {\n   362\t          instance = built.value;\n   363\t\n   364\t          // Seed the fork by replaying source events up to the fork point.\n   365\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n   366\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n   367\t          if (!seeded.ok) {\n   368\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n   369\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n   370\t            pendingFork = null;\n   371\t            await disposeInstance(instance);\n   372\t            instance = null;\n   373\t            state = null;\n   374\t            captureSession = null;\n   375\t            return;\n   376\t          } else {\n   377\t            // Fork succeeded - clear pending fork state and use the forked thread.\n   378\t            pendingFork = null;\n   379\t            resolved = { ok: true, value: targetThreadRef };\n   380\t          }\n   381\t        }\n   382\t      }\n   383\t    }\n   384\t\n   385\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n   386\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n   387\t    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n   388\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n   389\t      if (forkFromTree !== null) {\n   390\t        forkAttempted = true;\n   391\t        // Session tree indicates a fork - create and seed as above.\n   392\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n   393\t\n   394\t        const resolveDeps = buildResolveDeps(ctx);\n   395\t        const newFilePath = resolveDeps.newThreadFilePath();\n   396\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n   397\t          filePath: newFilePath,\n   398\t          cwd: resolveDeps.cwd,\n   399\t        };\n   400\t        if (resolveDeps.registryPath !== undefined) {\n   401\t          newThreadInput.registryPath = resolveDeps.registryPath;\n   402\t        }\n   403\t        const created = await threads.newThread(newThreadInput);\n   404\t        if (!created.ok) {\n   405\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n   406\t          state = null;\n   407\t          captureSession = null;\n   408\t          return;\n   409\t        } else {\n   410\t          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n   411\t\n   412\t          const built = await initInstance(targetThreadRef, config.value);\n   413\t          if (!built.ok) {\n   414\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   415\t            state = null;\n   416\t            captureSession = null;\n   417\t            return;\n   418\t          } else {\n   419\t            instance = built.value;\n   420\t\n   421\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n   422\t            if (!seeded.ok) {\n   423\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n   424\t              await disposeInstance(instance);\n   425\t              instance = null;\n   426\t              state = null;\n   427\t              captureSession = null;\n   428\t              return;\n   429\t            } else {\n   430\t              resolved = { ok: true, value: targetThreadRef };\n   431\t            }\n   432\t          }\n   433\t        }\n   434\t      }\n   435\t    }\n   436\t\n   437\t    // Normal launch resolution (if not resolved by fork paths above).\n   438\t    if (resolved === undefined) {\n   439\t      const launch = parseLaunch();\n   440\t      const isReload = event.reason === \"reload\";\n   441\t      resolved = isReload\n   442\t        ? await resolveReloadFor(launch, ctx)\n   443\t        : await resolveForLaunch(launch, ctx);\n   444\t    }\n   445\t\n   446\t    if (!resolved.ok) {\n   447\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   448\t      return;\n   449\t    }\n   450\t    if (resolved.value === null) {\n   451\t      const isReload = event.reason === \"reload\";\n   452\t      lastDiagnostic = isReload\n   453\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n   454\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   455\t      return;\n   456\t    }\n   457\t\n   458\t    // If instance wasn't created during fork path, create it now.\n   459\t    if (instance === null) {\n   460\t      const built = await initInstance(resolved.value, config.value);\n   461\t      if (!built.ok) {\n   462\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   463\t        return;\n   464\t      }\n   465\t      instance = built.value;\n   466\t    }\n   467\t\n   468\t    state = createSessionState(resolved.value);\n   469\t    appendThreadState?.({ version: 1, threadRef: state.threadRef });\n   470\t    const piSessionId = sessionIdOf(resolved.value);\n   471\t    captureSession = {\n   472\t      piSessionId,\n   473\t      accumulator: new TurnAccumulator({ piSessionId }),\n   474\t      sourceSeq: 0,\n   475\t    };\n   476\t\n   477\t    // Story 6: Startup validation - probe all seven assignments before first use\n   478\t    // This runs after instance creation but before capture begins (AC-5.1).\n   479\t    // Validation failures are reported but do NOT stop capture (AC-5.3).\n   480\t    if (config.value.inference === undefined) {\n   481\t      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n   482\t      return;\n   483\t    }\n   484\t    const assignments = config.value.inference.assignments;\n   485\t    const validationReport = validateReachable(assignments, ctx);\n   486\t    report(validationReport, ctx, state);\n   487\t  };\n   488\t\n   489\t  // Dispose with flush before any session swap (session_before_switch fires\n   490\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   491\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n   492\t  // re-resolves its thread from the durable registry on the next session_start.\n   493\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   494\t    const result = await disposeInstance(instance);\n   495\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   496\t    instance = null;\n   497\t    captureSession = null;\n   498\t  };\n   499\t\n   500\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n   501\t  // converter already recorded a durable gap for a writable-thread malformed\n   502\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n   503\t  // surfaces as an extension health signal with no gap. Neither path throws.\n   504\t  function recordCaptureOutcome(\n   505\t    result: OpResult<BatchResult>,\n   506\t    events: readonly MessageEventInput[],\n   507\t  ): void {\n   508\t    if (result.ok) return;\n   509\t    const recordedGap = result.error.code === \"invalid_event\";\n   510\t    const failure: CaptureFailureDiagnostic = {\n   511\t      code: result.error.code,\n   512\t      message: result.error.reason,\n   513\t      recordedGap,\n   514\t    };\n   515\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n   516\t    lastDiagnostic = failure;\n   517\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   518\t  }\n   519\t\n   520\t  function nextSourceSeq(session: CaptureSession): number {\n   521\t    const sourceSeq = session.sourceSeq;\n   522\t    session.sourceSeq += 1;\n   523\t    return sourceSeq;\n   524\t  }\n   525\t\n   526\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n   527\t    // Last-resort id-less discriminator. PI position wins when present; the\n   528\t    // connector ordinal is used only when PI gives no event identity at all.\n   529\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n   530\t    // order yields the same ordinal, which is the best identity available.\n   531\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n   532\t  }\n   533\t\n   534\t  async function recordMappingFailure(\n   535\t    hook: string,\n   536\t    position: number | undefined,\n   537\t    sourceSeq: number,\n   538\t    cause: unknown,\n   539\t  ): Promise<void> {\n   540\t    if (instance === null) return;\n   541\t    const message = cause instanceof Error ? cause.message : String(cause);\n   542\t    const result = await captureGap(\n   543\t      fallbackIdFor(hook, position, sourceSeq),\n   544\t      `${hook}: ${message}`,\n   545\t      instance,\n   546\t    );\n   547\t    if (!result.ok) {\n   548\t      recordCaptureOutcome(result, []);\n   549\t      return;\n   550\t    }\n   551\t    const failure: CaptureFailureDiagnostic = {\n   552\t      code: \"invalid_event\",\n   553\t      message: `${hook}: ${message}`,\n   554\t      recordedGap: true,\n   555\t    };\n   556\t    lastDiagnostic = failure;\n   557\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   558\t  }\n   559\t\n   560\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   561\t  // open turn, and flush through the converter (AC-2.1).\n   562\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   563\t    if (instance === null || captureSession === null) return;\n   564\t    const sourceSeq = nextSourceSeq(captureSession);\n   565\t    const mapCtx: MapCtx =\n   566\t      event.entryId !== undefined && event.entryId !== \"\"\n   567\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n   568\t        : {\n   569\t            piSessionId: captureSession.piSessionId,\n   570\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n   571\t          };\n   572\t    let events: MessageEventInput[];\n   573\t    try {\n   574\t      events = mapMessage(event.message, mapCtx);\n   575\t    } catch (cause) {\n   576\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n   577\t      return;\n   578\t    }\n   579\t    captureSession.accumulator.onMessage(events);\n   580\t    if (events.length === 0) return;\n   581\t    recordCaptureOutcome(await capture(events, instance), events);\n   582\t  };\n   583\t\n   584\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   585\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   586\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   587\t    if (instance === null || captureSession === null) return;\n   588\t    const sourceSeq = nextSourceSeq(captureSession);\n   589\t    const mapCtx: MapCtx = {\n   590\t      piSessionId: captureSession.piSessionId,\n   591\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n   592\t    };\n   593\t    const note = mapModelSelect(event, mapCtx);\n   594\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   595\t  };\n   596\t\n   597\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   598\t    if (instance === null || captureSession === null) return;\n   599\t    const sourceSeq = nextSourceSeq(captureSession);\n   600\t    const mapCtx: MapCtx = {\n   601\t      piSessionId: captureSession.piSessionId,\n   602\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n   603\t    };\n   604\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   605\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   606\t  };\n   607\t\n   608\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   609\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   610\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   611\t    if (instance === null || captureSession === null) return;\n   612\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   613\t    if (turnEnd.length === 0) return;\n   614\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   615\t  };\n   616\t\n   617\t  // Contain every handler: an observe-only hook must never throw back into PI\n   618\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   619\t  // plain-data diagnostic; it is never rethrown.\n   620\t  const guard = (\n   621\t    name: Epic1Hook,\n   622\t    body: PiHookHandler<Epic1Hook>,\n   623\t  ): PiHookHandler<Epic1Hook> => {\n   624\t    return async (ctx, event): Promise<void> => {\n   625\t      try {\n   626\t        await body(ctx, event);\n   627\t      } catch (err) {\n   628\t        lastDiagnostic = {\n   629\t          code: \"hook_handler_error\",\n   630\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   631\t          recordedGap: false,\n   632\t        };\n   633\t      }\n   634\t    };\n   635\t  };\n   636\t\n   637\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   638\t  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n   639\t  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n   640\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   641\t    // Intentionally empty — turn_end is ignored as a boundary.\n   642\t  };\n   643\t\n   644\t  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n   645\t  // The source thread ref is captured from the current session state; the hook\n   646\t  // provides entryId/position identifying the fork point. No writes to the source\n   647\t  // thread occur — the fork happens on the next session_start (Story 4).\n   648\t  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n   649\t    if (state === null) return;\n   650\t    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n   651\t    // Store the fork info for use on session_start{fork}.\n   652\t    pendingFork = {\n   653\t      sourceThreadRef: state.threadRef,\n   654\t      forkEntryId: forkInfo.forkEntryId,\n   655\t    };\n   656\t  };\n   657\t\n   658\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   659\t  // are live; fork handling (Story 4) is wired.\n   660\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   661\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   662\t    session_before_switch: onDispose,\n   663\t    session_shutdown: onDispose,\n   664\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   665\t    turn_end: noop,\n   666\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   667\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   668\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   669\t    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n   670\t  };\n   671\t\n   672\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   673\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   674\t\n   675\t  return {\n   676\t    handlers,\n   677\t    register(pi: ExtensionAPI): void {\n   678\t      appendThreadState = (entry) => pi.appendEntry(THREAD_STATE_ENTRY_TYPE, entry);\n   679\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   680\t    },\n   681\t    getState(): SessionState | null {\n   682\t      return state;\n   683\t    },\n   684\t    getInstance(): LhcInstance | null {\n   685\t      return instance;\n   686\t    },\n   687\t    snapshot(): ConnectorSnapshot {\n   688\t      return { state, lastDiagnostic };\n   689\t    },\n   690\t  };\n   691\t}\n   692\t\n   693\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   694\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n   695\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n   696\t *  observe-only SDK config, and the `--resume` selector that presents the\n   697\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n   698\t *  resolves/creates and initializes for real. On `/reload` the connector\n   699\t *  re-resolves the same thread from the durable registry (it keeps no\n   700\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n   701\t *  config. */\n   702\texport function activate(pi: ExtensionAPI): void {\n   703\t  createConnector().register(pi);\n   704\t}\n   705\t\n   706\texport default activate;\n","exit_code":0,"status":"completed"}}

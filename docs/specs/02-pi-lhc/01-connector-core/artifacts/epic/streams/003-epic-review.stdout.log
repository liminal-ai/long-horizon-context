{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_926be01a509f453b918172b3","type":"tool_result","content":"1\timport { basename } from \"node:path\";\n2\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n3\t\n4\t// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n5\t// it (tech design Flow 1). PI's own session file still exists in this\n6\t// observe-only epic — it is just not where thread identity lives.\n7\t\n8\t/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n9\t *  before this resolver — see `picker.ts`.) */\n10\texport interface LaunchFlags {\n11\t  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n12\t  continue?: boolean; // --continue / -c : most recent\n13\t  session?: string; // --session <id> : full or partial id\n14\t}\n15\t\n16\t/** What the resolver needs from the host beyond the launch flags: the cwd a new\n17\t *  thread is registered under, the registry to resolve through, and where a new\n18\t *  thread's file is created. Injected so the resolver is exercised against a\n19\t *  real temp registry in tests and the default `~/.lhc` registry in production —\n20\t *  `registryPath` is a per-operation argument, never an `initLhc` config field\n21\t *  (tech design Technical Notes). */\n22\texport interface ResolveDeps {\n23\t  cwd: string;\n24\t  registryPath?: string;\n25\t  newThreadFilePath: () => string;\n26\t  /** Title for a newly created thread (A-8 title metadata). Defaults to\n27\t   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n28\t   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n29\t   *  title from the first prompt — the open TDQ Q4). */\n30\t  newThreadTitle?: string;\n31\t}\n32\t\n33\t/** The creation-time title for a new thread when the host supplies none. At\n34\t *  session_start there is no first prompt yet, so the title is the cwd's leaf\n35\t *  directory name — a real, non-empty project label the `--resume` picker shows\n36\t *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\n37\texport function defaultThreadTitle(cwd: string): string {\n38\t  const leaf = basename(cwd);\n39\t  if (leaf !== \"\") return leaf;\n40\t  return cwd !== \"\" ? cwd : \"lhc session\";\n41\t}\n42\t\n43\t/** The durable, plain-data thread reference the connector retains and\n44\t *  reattaches from: a thread id (plus the registry it lives in), not a live\n45\t *  object. `{ filePath }` is avoided so reload reconstructs by id. */\n46\texport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n47\t  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n48\t}\n49\t\n50\t/** Spread `registryPath` into an LHC threads-call options object only when it is\n51\t *  set, so an unset registry path falls through to LHC's default rather than\n52\t *  being passed as an explicit `undefined` (rejected under\n53\t *  exactOptionalPropertyTypes). */\n54\texport function registryArg(registryPath?: string): { registryPath?: string } {\n55\t  return registryPath === undefined ? {} : { registryPath };\n56\t}\n57\t\n58\t/** Resolve the recording thread from the launch input (AC-1.6):\n59\t *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n60\t *    ambiguous fails loud (the registry returns `thread_not_found` /\n61\t *    `ambiguous_thread_id`) and never silently creates a thread.\n62\t *  - `--continue`: the most recently created thread.\n63\t *  - no flag: a new thread, registered with its cwd (AC-1.1).\n64\t *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n65\t *  durable id rather than a retained object (AC-1.5). */\n66\texport async function resolveThread(\n67\t  launch: LaunchFlags,\n68\t  deps: ResolveDeps,\n69\t): Promise<OpResult<ThreadRef>> {\n70\t  if (launch.session !== undefined) {\n71\t    const resolved = await threads.resolve({\n72\t      threadId: launch.session,\n73\t      ...registryArg(deps.registryPath),\n74\t    });\n75\t    if (!resolved.ok) return resolved;\n76\t    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n77\t  }\n78\t\n79\t  if (launch.continue === true) {\n80\t    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n81\t    if (!listed.ok) return listed;\n82\t    // The registry lists in creation order with an insertion-order tie-break,\n83\t    // so the last row is the most recently created thread.\n84\t    const mostRecent = listed.value.at(-1);\n85\t    if (mostRecent === undefined) {\n86\t      return {\n87\t        ok: false,\n88\t        error: {\n89\t          errorClass: \"caller_error\",\n90\t          code: \"thread_not_found\",\n91\t          reason: \"--continue: no threads exist to continue\",\n92\t        },\n93\t      };\n94\t    }\n95\t    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n96\t  }\n97\t\n98\t  const created = await threads.newThread({\n99\t    filePath: deps.newThreadFilePath(),\n100\t    cwd: deps.cwd,\n101\t    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n102\t    ...registryArg(deps.registryPath),\n103\t  });\n104\t  if (!created.ok) return created;\n105\t  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n106\t}\n107\t\n108\t/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n109\t *  re-initialized while the same PI session continues — re-resolve the session's\n110\t *  thread from DURABLE registry state. It reads no retained in-process memory and\n111\t *  never creates a new thread or re-prompts a picker; the resolved id comes back\n112\t *  out of the registry (the durable catalog), so reconstruction survives the loss\n113\t *  of every in-memory holder (the architecture-risk scenario).\n114\t *\n115\t *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n116\t *    Both are idempotent — resolving twice returns the same thread and creates\n117\t *    nothing — so the normal resolver already reattaches correctly.\n118\t *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n119\t *    read from the registry. A no-flag Story-1 session created exactly one thread\n120\t *    in its cwd, so that is the thread; re-running the launch instead would create\n121\t *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n122\t *\n123\t *  Returns `null` when the cwd has no thread to reattach (a reload against an\n124\t *  empty registry); the caller records a diagnostic rather than creating one.\n125\t *\n126\t *  This is the answer to \"where does the durable reload id live without a\n127\t *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n128\t *  the system of record, not in a connector field or a recovery sidecar. The\n129\t *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n130\t *  reload/fork lineage is LHC thread metadata (Feature 2+). */\n131\texport async function resolveReloadThread(\n132\t  launch: LaunchFlags,\n133\t  deps: ResolveDeps,\n134\t): Promise<OpResult<ThreadRef | null>> {\n135\t  if (launch.session !== undefined) {\n136\t    return resolveThread({ session: launch.session }, deps);\n137\t  }\n138\t  if (launch.continue === true) {\n139\t    return resolveThread({ continue: true }, deps);\n140\t  }\n141\t  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n142\t  if (!listed.ok) return listed;\n143\t  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n144\t  // the most recently created thread for this directory.\n145\t  const mostRecent = listed.value.at(-1);\n146\t  if (mostRecent === undefined) return { ok: true, value: null };\n147\t  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n148\t}\n149\t\n150\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n151\t *  so PI's launch arguments are visible on `process.argv`; this is the\n152\t *  production source of the launch mode. Supports `--session <id>`,\n153\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n154\t *  spelling for the named-session mode is an integration detail to confirm\n155\t *  against PI; see the story payload's open questions.) */\n156\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n157\t  const flags: LaunchFlags = {};\n158\t  for (let i = 0; i < argv.length; i += 1) {\n159\t    const arg = argv[i];\n160\t    if (arg === undefined) continue;\n161\t    if (arg === \"--resume\" || arg === \"-r\") {\n162\t      flags.resume = true;\n163\t    } else if (arg === \"--continue\" || arg === \"-c\") {\n164\t      flags.continue = true;\n165\t    } else if (arg === \"--session\") {\n166\t      const next = argv[i + 1];\n167\t      if (next !== undefined && !next.startsWith(\"-\")) {\n168\t        flags.session = next;\n169\t        i += 1;\n170\t      }\n171\t    } else if (arg.startsWith(\"--session=\")) {\n172\t      flags.session = arg.slice(\"--session=\".length);\n173\t    }\n174\t  }\n175\t  return flags;\n176\t}\n177\t"}]},"parent_tool_use_id":null,"session_id":"54bb6891-be78-43f8-a277-229ffe48e3f0","uuid":"ed17a35c-2863-4b98-a585-6b785d81f621","timestamp":"2026-06-14T13:48:00.374Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/thread-resolution.ts","content":"import { basename } from \"node:path\";\nimport { threads, type OpResult, type ThreadRef } from \"lhc\";\n\n// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n// it (tech design Flow 1). PI's own session file still exists in this\n// observe-only epic — it is just not where thread identity lives.\n\n/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n *  before this resolver — see `picker.ts`.) */\nexport interface LaunchFlags {\n  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n  continue?: boolean; // --continue / -c : most recent\n  session?: string; // --session <id> : full or partial id\n}\n\n/** What the resolver needs from the host beyond the launch flags: the cwd a new\n *  thread is registered under, the registry to resolve through, and where a new\n *  thread's file is created. Injected so the resolver is exercised against a\n *  real temp registry in tests and the default `~/.lhc` registry in production —\n *  `registryPath` is a per-operation argument, never an `initLhc` config field\n *  (tech design Technical Notes). */\nexport interface ResolveDeps {\n  cwd: string;\n  registryPath?: string;\n  newThreadFilePath: () => string;\n  /** Title for a newly created thread (A-8 title metadata). Defaults to\n   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n   *  title from the first prompt — the open TDQ Q4). */\n  newThreadTitle?: string;\n}\n\n/** The creation-time title for a new thread when the host supplies none. At\n *  session_start there is no first prompt yet, so the title is the cwd's leaf\n *  directory name — a real, non-empty project label the `--resume` picker shows\n *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\nexport function defaultThreadTitle(cwd: string): string {\n  const leaf = basename(cwd);\n  if (leaf !== \"\") return leaf;\n  return cwd !== \"\" ? cwd : \"lhc session\";\n}\n\n/** The durable, plain-data thread reference the connector retains and\n *  reattaches from: a thread id (plus the registry it lives in), not a live\n *  object. `{ filePath }` is avoided so reload reconstructs by id. */\nexport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n}\n\n/** Spread `registryPath` into an LHC threads-call options object only when it is\n *  set, so an unset registry path falls through to LHC's default rather than\n *  being passed as an explicit `undefined` (rejected under\n *  exactOptionalPropertyTypes). */\nexport function registryArg(registryPath?: string): { registryPath?: string } {\n  return registryPath === undefined ? {} : { registryPath };\n}\n\n/** Resolve the recording thread from the launch input (AC-1.6):\n *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n *    ambiguous fails loud (the registry returns `thread_not_found` /\n *    `ambiguous_thread_id`) and never silently creates a thread.\n *  - `--continue`: the most recently created thread.\n *  - no flag: a new thread, registered with its cwd (AC-1.1).\n *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n *  durable id rather than a retained object (AC-1.5). */\nexport async function resolveThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef>> {\n  if (launch.session !== undefined) {\n    const resolved = await threads.resolve({\n      threadId: launch.session,\n      ...registryArg(deps.registryPath),\n    });\n    if (!resolved.ok) return resolved;\n    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n  }\n\n  if (launch.continue === true) {\n    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n    if (!listed.ok) return listed;\n    // The registry lists in creation order with an insertion-order tie-break,\n    // so the last row is the most recently created thread.\n    const mostRecent = listed.value.at(-1);\n    if (mostRecent === undefined) {\n      return {\n        ok: false,\n        error: {\n          errorClass: \"caller_error\",\n          code: \"thread_not_found\",\n          reason: \"--continue: no threads exist to continue\",\n        },\n      };\n    }\n    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n  }\n\n  const created = await threads.newThread({\n    filePath: deps.newThreadFilePath(),\n    cwd: deps.cwd,\n    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n    ...registryArg(deps.registryPath),\n  });\n  if (!created.ok) return created;\n  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n}\n\n/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n *  re-initialized while the same PI session continues — re-resolve the session's\n *  thread from DURABLE registry state. It reads no retained in-process memory and\n *  never creates a new thread or re-prompts a picker; the resolved id comes back\n *  out of the registry (the durable catalog), so reconstruction survives the loss\n *  of every in-memory holder (the architecture-risk scenario).\n *\n *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n *    Both are idempotent — resolving twice returns the same thread and creates\n *    nothing — so the normal resolver already reattaches correctly.\n *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n *    read from the registry. A no-flag Story-1 session created exactly one thread\n *    in its cwd, so that is the thread; re-running the launch instead would create\n *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n *\n *  Returns `null` when the cwd has no thread to reattach (a reload against an\n *  empty registry); the caller records a diagnostic rather than creating one.\n *\n *  This is the answer to \"where does the durable reload id live without a\n *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n *  the system of record, not in a connector field or a recovery sidecar. The\n *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n *  reload/fork lineage is LHC thread metadata (Feature 2+). */\nexport async function resolveReloadThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef | null>> {\n  if (launch.session !== undefined) {\n    return resolveThread({ session: launch.session }, deps);\n  }\n  if (launch.continue === true) {\n    return resolveThread({ continue: true }, deps);\n  }\n  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n  if (!listed.ok) return listed;\n  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n  // the most recently created thread for this directory.\n  const mostRecent = listed.value.at(-1);\n  if (mostRecent === undefined) return { ok: true, value: null };\n  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n}\n\n/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n *  so PI's launch arguments are visible on `process.argv`; this is the\n *  production source of the launch mode. Supports `--session <id>`,\n *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n *  spelling for the named-session mode is an integration detail to confirm\n *  against PI; see the story payload's open questions.) */\nexport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n  const flags: LaunchFlags = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === undefined) continue;\n    if (arg === \"--resume\" || arg === \"-r\") {\n      flags.resume = true;\n    } else if (arg === \"--continue\" || arg === \"-c\") {\n      flags.continue = true;\n    } else if (arg === \"--session\") {\n      const next = argv[i + 1];\n      if (next !== undefined && !next.startsWith(\"-\")) {\n        flags.session = next;\n        i += 1;\n      }\n    } else if (arg.startsWith(\"--session=\")) {\n      flags.session = arg.slice(\"--session=\".length);\n    }\n  }\n  return flags;\n}\n","numLines":177,"startLine":1,"totalLines":177}}}

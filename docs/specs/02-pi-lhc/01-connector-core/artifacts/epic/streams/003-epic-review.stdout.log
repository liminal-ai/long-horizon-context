{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/inference/startup-validation.test.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// TC-5.1..5.3. Startup validation tests.\n     2\t//\n     3\t// TC-5.1: All seven assignments validated against registry before first use.\n     4\t// TC-5.2: Unreachable lane reported with kind+pair+fix; appears headless.\n     5\t// TC-5.3: Validation failure leaves capture running; affected derivations fail classified + queryable.\n     6\t\n     7\timport { describe, expect, it, vi } from \"vitest\";\n     8\timport { FORM_KINDS, DEFAULT_PROMPT_NAMES, type SdkConfig } from \"lhc\";\n     9\timport type { FormKind, ModelAssignment } from \"lhc\";\n    10\timport { validateReachable, report } from \"../../src/inference/startup-validation.js\";\n    11\timport { DEFAULT_PI_MODEL } from \"../../src/inference/model-call.js\";\n    12\timport type { ExtensionContext, ModelHandle } from \"../../src/pi/types.js\";\n    13\timport type { SessionState } from \"../../src/lifecycle/state.js\";\n    14\timport { tempStore } from \"../fixtures/thread.js\";\n    15\timport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"../fixtures/model-call.js\";\n    16\t\n    17\t/** Create a minimal ExtensionContext for testing. */\n    18\tfunction createMockContext(\n    19\t  availableModels: ModelHandle[] = [],\n    20\t  findResult?: ModelHandle | undefined,\n    21\t  hasAuthResult: boolean = true,\n    22\t): ExtensionContext {\n    23\t  const models = availableModels.length > 0\n    24\t    ? availableModels\n    25\t    : [{ provider: DEFAULT_PI_MODEL.provider, id: DEFAULT_PI_MODEL.id }];\n    26\t\n    27\t  return {\n    28\t    cwd: \"/test\",\n    29\t    hasUI: false,\n    30\t    modelRegistry: {\n    31\t      find: findResult !== undefined\n    32\t        ? (() => findResult)\n    33\t        : ((provider: string, model: string) =>\n    34\t            models.find((m) => m.provider === provider && m.id === model)),\n    35\t      hasConfiguredAuth: () => hasAuthResult,\n    36\t      getAvailable: () => models,\n    37\t    },\n    38\t    ui: { notify: () => {} },\n    39\t    sessionManager: { getEntries: () => [] },\n    40\t  };\n    41\t}\n    42\t\n    43\t/** Create minimal assignments for testing. */\n    44\tfunction createAssignments(overrides: Partial<Record<FormKind, ModelAssignment>> = {}): Record<FormKind, ModelAssignment> {\n    45\t  const base: Record<FormKind, ModelAssignment> = {\n    46\t    smoothed_prompt: { provider: DEFAULT_PI_MODEL.provider, model: DEFAULT_PI_MODEL.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    47\t    tool_call_summary: { provider: DEFAULT_PI_MODEL.provider, model: DEFAULT_PI_MODEL.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n    48\t    tool_result_summary: { provider: DEFAULT_PI_MODEL.provider, model: DEFAULT_PI_MODEL.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n    49\t    turn_rendering: { provider: DEFAULT_PI_MODEL.provider, model: DEFAULT_PI_MODEL.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n    50\t    lower_band_projection: { provider: DEFAULT_PI_MODEL.provider, model: DEFAULT_PI_MODEL.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n    51\t    chunk_summary_detailed: { provider: DEFAULT_PI_MODEL.provider, model: DEFAULT_PI_MODEL.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n    52\t    chunk_summary_brief: { provider: DEFAULT_PI_MODEL.provider, model: DEFAULT_PI_MODEL.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n    53\t  };\n    54\t  return { ...base, ...overrides };\n    55\t}\n    56\t\n    57\tdescribe(\"Story 6: Startup Validation and Assignment Config\", () => {\n    58\t  describe(\"TC-5.1: All seven assignments validated against registry before first use\", () => {\n    59\t    it(\"validates all seven assignments when all lanes are reachable\", () => {\n    60\t      const models: ModelHandle[] = [\n    61\t        { provider: \"openai\", id: \"gpt-4o\" },\n    62\t        { provider: \"anthropic\", id: \"claude-3-opus\" },\n    63\t      ];\n    64\t\n    65\t      const ctx = createMockContext(models, models[0], true);\n    66\t      const assignments = createAssignments({\n    67\t        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    68\t        tool_call_summary: { provider: \"anthropic\", model: \"claude-3-opus\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n    69\t      });\n    70\t\n    71\t      const report = validateReachable(assignments, ctx);\n    72\t\n    73\t      // All lanes reachable - empty unreachable array\n    74\t      expect(report.unreachable).toHaveLength(0);\n    75\t    });\n    76\t\n    77\t    it(\"validates all seven kinds even when only some are overridden\", () => {\n    78\t      const models: ModelHandle[] = [{ provider: \"openai\", id: \"gpt-4o\" }];\n    79\t      // Don't pass findResult - let the mock use the array lookup (so defaults won't be found)\n    80\t      const ctx = createMockContext(models, undefined, true);\n    81\t\n    82\t      // Override one kind, others use shipped defaults.\n    83\t      const assignments = createAssignments({\n    84\t        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    85\t      });\n    86\t\n    87\t      const report = validateReachable(assignments, ctx);\n    88\t\n    89\t      // Should report unreachable for the non-overridden kinds (6 of them)\n    90\t      expect(report.unreachable.length).toBeGreaterThanOrEqual(6);\n    91\t    });\n    92\t\n    93\t    it(\"shipped defaults validate through a real PI modelRegistry lane\", () => {\n    94\t      const defaultHandle: ModelHandle = { provider: DEFAULT_PI_MODEL.provider, id: DEFAULT_PI_MODEL.id };\n    95\t      const findMock = vi.fn((provider: string, model: string) =>\n    96\t        provider === DEFAULT_PI_MODEL.provider && model === DEFAULT_PI_MODEL.id\n    97\t          ? defaultHandle\n    98\t          : undefined,\n    99\t      );\n   100\t      const ctx = createMockContext([defaultHandle], undefined, true);\n   101\t      ctx.modelRegistry.find = findMock;\n   102\t\n   103\t      const validationReport = validateReachable(createAssignments(), ctx);\n   104\t\n   105\t      expect(validationReport.unreachable).toHaveLength(0);\n   106\t      for (const kind of FORM_KINDS) {\n   107\t        expect(findMock).toHaveBeenCalledWith(\n   108\t          createAssignments()[kind].provider,\n   109\t          createAssignments()[kind].model,\n   110\t        );\n   111\t      }\n   112\t    });\n   113\t\n   114\t    it(\"validation runs at session start before any derivation use\", () => {\n   115\t      // This test verifies the contract that validation is called in session_start.\n   116\t      // The actual integration is in index.ts; this test checks that validateReachable\n   117\t      // itself doesn't have side effects that would prevent early calling.\n   118\t      const ctx = createMockContext();\n   119\t      const assignments = createAssignments();\n   120\t\n   121\t      // Should complete without throwing (even if it finds issues)\n   122\t      const report = validateReachable(assignments, ctx);\n   123\t      expect(report).toBeDefined();\n   124\t      expect(Array.isArray(report.unreachable)).toBe(true);\n   125\t    });\n   126\t  });\n   127\t\n   128\t  describe(\"TC-5.2: Unreachable lane reported with kind+pair+fix; appears headless\", () => {\n   129\t    it(\"reports unknown model with kind, provider/model, and fix\", () => {\n   130\t      const ctx = createMockContext(); // No models available\n   131\t      const assignments = createAssignments({\n   132\t        smoothed_prompt: { provider: \"unknown-provider\", model: \"unknown-model\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   133\t      });\n   134\t\n   135\t      const report = validateReachable(assignments, ctx);\n   136\t\n   137\t      const smoothEntry = report.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n   138\t      expect(smoothEntry).toBeDefined();\n   139\t      expect(smoothEntry?.provider).toBe(\"unknown-provider\");\n   140\t      expect(smoothEntry?.model).toBe(\"unknown-model\");\n   141\t      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n   142\t      expect(smoothEntry?.fix).toContain(\"Update 'smoothed_prompt' assignment\");\n   143\t    });\n   144\t\n   145\t    it(\"reports auth not configured with kind, provider/model, and login fix\", () => {\n   146\t      const models: ModelHandle[] = [{ provider: \"openai\", id: \"gpt-4o\" }];\n   147\t      const ctx = createMockContext(models, models[0], false); // Model exists but no auth\n   148\t\n   149\t      const assignments = createAssignments({\n   150\t        tool_call_summary: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   151\t      });\n   152\t\n   153\t      const report = validateReachable(assignments, ctx);\n   154\t\n   155\t      const toolEntry = report.unreachable.find((e) => e.kind === \"tool_call_summary\");\n   156\t      expect(toolEntry).toBeDefined();\n   157\t      expect(toolEntry?.provider).toBe(\"openai\");\n   158\t      expect(toolEntry?.model).toBe(\"gpt-4o\");\n   159\t      expect(toolEntry?.reason).toBe(\"auth_not_configured\");\n   160\t      expect(toolEntry?.fix).toContain(\"Log in or configure auth\");\n   161\t      expect(toolEntry?.fix).toContain(\"openai/gpt-4o\");\n   162\t    });\n   163\t\n   164\t    it(\"distinguishes unknown_model from auth_not_configured\", () => {\n   165\t      const models: ModelHandle[] = [{ provider: \"anthropic\", id: \"claude-3-opus\" }];\n   166\t      const ctxWithAuth = createMockContext(models, models[0], false); // Has model, no auth\n   167\t      const ctxWithoutModel = createMockContext(models, undefined); // No model at all\n   168\t\n   169\t      const assignmentsWithModel = createAssignments({\n   170\t        smoothed_prompt: { provider: \"anthropic\", model: \"claude-3-opus\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   171\t      });\n   172\t      const assignmentsWithoutModel = createAssignments({\n   173\t        tool_call_summary: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   174\t      });\n   175\t\n   176\t      const reportWithModel = validateReachable(assignmentsWithModel, ctxWithAuth);\n   177\t      const reportWithoutModel = validateReachable(assignmentsWithoutModel, ctxWithoutModel);\n   178\t\n   179\t      expect(reportWithModel.unreachable[0]?.reason).toBe(\"auth_not_configured\");\n   180\t      expect(reportWithoutModel.unreachable[0]?.reason).toBe(\"unknown_model\");\n   181\t    });\n   182\t\n   183\t    it(\"report appears in headless mode (no TUI assumed)\", () => {\n   184\t      const ctx = createMockContext(undefined, undefined, false);\n   185\t      ctx.hasUI = false; // Explicitly headless\n   186\t      const notifySpy = vi.fn();\n   187\t      ctx.ui.notify = notifySpy;\n   188\t\n   189\t      const assignments = createAssignments({\n   190\t        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   191\t      });\n   192\t\n   193\t      const validationReport = validateReachable(assignments, ctx);\n   194\t\n   195\t      const state: SessionState = {\n   196\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   197\t        flags: { startupValidationReported: false },\n   198\t        health: {},\n   199\t      };\n   200\t\n   201\t      const headlessLog = vi.fn();\n   202\t\n   203\t      // Report should not throw even in headless mode\n   204\t      expect(() => report(validationReport, ctx, state, { headlessLog })).not.toThrow();\n   205\t\n   206\t      // State should have the report persisted with headless-visible text.\n   207\t      expect(state.health.startupValidation?.unreachable).toBe(validationReport.unreachable);\n   208\t      expect(state.health.startupValidation?.message).toContain(\"unreachable derivation lanes\");\n   209\t      expect(state.health.startupValidation?.message).toContain(\"smoothed_prompt\");\n   210\t      expect(state.flags.startupValidationReported).toBe(true);\n   211\t\n   212\t      // No UI notification in headless mode (hasUI=false).\n   213\t      expect(notifySpy).not.toHaveBeenCalled();\n   214\t      expect(headlessLog).toHaveBeenCalledTimes(1);\n   215\t      const loggedMessage = headlessLog.mock.calls[0]?.[0] ?? \"\";\n   216\t      expect(loggedMessage).toContain(\"unreachable derivation lanes\");\n   217\t      expect(loggedMessage).toContain(\"smoothed_prompt\");\n   218\t    });\n   219\t\n   220\t    it(\"report appears through ctx.ui when available\", () => {\n   221\t      const ctx = createMockContext(undefined, undefined, false);\n   222\t      ctx.hasUI = true; // UI available\n   223\t      const notifySpy = vi.fn();\n   224\t      ctx.ui.notify = notifySpy;\n   225\t\n   226\t      const assignments = createAssignments({\n   227\t        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   228\t      });\n   229\t\n   230\t      const validationReport = validateReachable(assignments, ctx);\n   231\t\n   232\t      const state: SessionState = {\n   233\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   234\t        flags: { startupValidationReported: false },\n   235\t        health: {},\n   236\t      };\n   237\t\n   238\t      report(validationReport, ctx, state);\n   239\t\n   240\t      // State should have the report persisted with the same unreachable lanes.\n   241\t      expect(state.health.startupValidation?.unreachable).toBe(validationReport.unreachable);\n   242\t      expect(state.health.startupValidation?.message).toContain(\"unreachable derivation lanes\");\n   243\t      expect(state.flags.startupValidationReported).toBe(true);\n   244\t\n   245\t      // UI should be notified with a formatted report\n   246\t      expect(notifySpy).toHaveBeenCalledTimes(1);\n   247\t      const notifyMessage = (notifySpy.mock.calls[0]?.[0] ?? \"\") as string;\n   248\t      expect(notifyMessage).toContain(\"unreachable derivation lanes\");\n   249\t      expect(notifyMessage).toContain(\"smoothed_prompt\");\n   250\t      expect(notifyMessage).toContain(\"unknown\");\n   251\t    });\n   252\t\n   253\t    it(\"report includes formatted message with all unreachable lanes\", () => {\n   254\t      const ctx = createMockContext(undefined, undefined, false);\n   255\t      ctx.hasUI = true;\n   256\t      const notifySpy = vi.fn();\n   257\t      ctx.ui.notify = notifySpy;\n   258\t\n   259\t      const assignments = createAssignments({\n   260\t        smoothed_prompt: { provider: \"unknown1\", model: \"model1\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   261\t        tool_call_summary: { provider: \"unknown2\", model: \"model2\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   262\t      });\n   263\t\n   264\t      const validationReport = validateReachable(assignments, ctx);\n   265\t\n   266\t      const state: SessionState = {\n   267\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   268\t        flags: { startupValidationReported: false },\n   269\t        health: {},\n   270\t      };\n   271\t\n   272\t      report(validationReport, ctx, state);\n   273\t\n   274\t      const notifyMessage = (notifySpy.mock.calls[0]?.[0] ?? \"\") as string;\n   275\t      expect(notifyMessage).toContain(\"smoothed_prompt\");\n   276\t      expect(notifyMessage).toContain(\"unknown1/model1\");\n   277\t      expect(notifyMessage).toContain(\"tool_call_summary\");\n   278\t      expect(notifyMessage).toContain(\"unknown2/model2\");\n   279\t    });\n   280\t  });\n   281\t\n   282\t  describe(\"TC-5.3: Validation failure leaves capture running\", () => {\n   283\t    it(\"capture continues after validation reports unreachable lanes\", () => {\n   284\t      const ctx = createMockContext();\n   285\t      const assignments = createAssignments({\n   286\t        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   287\t      });\n   288\t\n   289\t      const validationReport = validateReachable(assignments, ctx);\n   290\t\n   291\t      const state: SessionState = {\n   292\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   293\t        flags: { startupValidationReported: false },\n   294\t        health: {},\n   295\t      };\n   296\t\n   297\t      // Report should not throw - validation failure is not fatal\n   298\t      expect(() => report(validationReport, ctx, state)).not.toThrow();\n   299\t\n   300\t      // State should remain intact for capture to continue\n   301\t      expect(\"filePath\" in state.threadRef ? state.threadRef.filePath : undefined).toBe(\"/test/thread.sqlite\");\n   302\t      expect(state.flags.startupValidationReported).toBe(true);\n   303\t    });\n   304\t\n   305\t    it(\"affected lane derivations fail classified and queryable through health\", async () => {\n   306\t      const store = tempStore();\n   307\t      try {\n   308\t        // Create a context where one model is available and another is not\n   309\t        const models: ModelHandle[] = [{ provider: \"openai\", id: \"gpt-4o\" }];\n   310\t        const ctx: ExtensionContext = {\n   311\t          cwd: \"/test/startup-validation\",\n   312\t          hasUI: false,\n   313\t          modelRegistry: {\n   314\t            // Only openai/gpt-4o is available; unknown/unknown will be unreachable\n   315\t            find: (provider: string, model: string) =>\n   316\t              provider === \"openai\" && model === \"gpt-4o\" ? { provider, id: model } : undefined,\n   317\t            hasConfiguredAuth: (handle) => typeof handle !== \"string\" && handle.provider === \"openai\",\n   318\t            getAvailable: () => models,\n   319\t          },\n   320\t          ui: { notify: () => {} },\n   321\t          sessionManager: { getEntries: () => [] },\n   322\t        };\n   323\t\n   324\t        // Create assignments with one reachable and one unreachable lane\n   325\t        const assignments = createAssignments({\n   326\t          smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   327\t          tool_call_summary: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   328\t          tool_result_summary: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   329\t          turn_rendering: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   330\t          lower_band_projection: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   331\t          chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   332\t          chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   333\t        });\n   334\t\n   335\t        // Build SDK config with these assignments\n   336\t        const { createConnector: createConn } = await import(\"../../src/index.js\");\n   337\t        const { makeUserMessage, makeAssistantMessage, makeAgentEnd } = await import(\"../fixtures/synthetic.js\");\n   338\t\n   339\t        const sdkConfig: SdkConfig = {\n   340\t          inference: {\n   341\t            call: fakeModelCallRouter(\n   342\t              { \"openai/gpt-4o\": fakeModelCallText(\"reachable derivation\") },\n   343\t              fakeModelCallFailure(\"invalid_request\", \"unreachable assignment lane\"),\n   344\t            ),\n   345\t            assignments,\n   346\t          },\n   347\t          mode: \"background\",\n   348\t        };\n   349\t\n   350\t        const connector = createConn({\n   351\t          registryPath: store.registryPath,\n   352\t          newThreadFilePath: () => store.threadPath(),\n   353\t          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n   354\t        });\n   355\t\n   356\t        // Start session - validation runs and reports unreachable lane\n   357\t        await connector.handlers.session_start(ctx, { reason: \"new\" });\n   358\t        const instance = connector.getInstance();\n   359\t        const state = connector.getState();\n   360\t\n","exit_code":0,"status":"completed"}}

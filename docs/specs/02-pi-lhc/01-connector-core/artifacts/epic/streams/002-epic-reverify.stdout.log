{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d2d8695f377d4efbaa34dd52","type":"tool_result","content":"1\timport { basename } from \"node:path\";\n2\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n3\t\n4\t// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n5\t// it (tech design Flow 1). PI's own session file still exists in this\n6\t// observe-only epic — it is just not where thread identity lives.\n7\t\n8\t/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n9\t *  before this resolver — see `picker.ts`.) */\n10\texport interface LaunchFlags {\n11\t  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n12\t  continue?: boolean; // --continue / -c : most recent\n13\t  session?: string; // --session <id> : full or partial id\n14\t}\n15\t\n16\t/** What the resolver needs from the host beyond the launch flags: the cwd a new\n17\t *  thread is registered under, the registry to resolve through, and where a new\n18\t *  thread's file is created. Injected so the resolver is exercised against a\n19\t *  real temp registry in tests and the default `~/.lhc` registry in production —\n20\t *  `registryPath` is a per-operation argument, never an `initLhc` config field\n21\t *  (tech design Technical Notes). */\n22\texport interface ResolveDeps {\n23\t  cwd: string;\n24\t  registryPath?: string;\n25\t  newThreadFilePath: () => string;\n26\t  /** Title for a newly created thread (A-8 title metadata). Defaults to\n27\t   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n28\t   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n29\t   *  title from the first prompt — the open TDQ Q4). */\n30\t  newThreadTitle?: string;\n31\t}\n32\t\n33\t/** The creation-time title for a new thread when the host supplies none. At\n34\t *  session_start there is no first prompt yet, so the title is the cwd's leaf\n35\t *  directory name — a real, non-empty project label the `--resume` picker shows\n36\t *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\n37\texport function defaultThreadTitle(cwd: string): string {\n38\t  const leaf = basename(cwd);\n39\t  if (leaf !== \"\") return leaf;\n40\t  return cwd !== \"\" ? cwd : \"lhc session\";\n41\t}\n42\t\n43\t/** The durable, plain-data thread reference the connector retains and\n44\t *  reattaches from: a thread id (plus the registry it lives in), not a live\n45\t *  object. `{ filePath }` is avoided so reload reconstructs by id. */\n46\texport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n47\t  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n48\t}\n49\t\n50\t/** Spread `registryPath` into an LHC threads-call options object only when it is\n51\t *  set, so an unset registry path falls through to LHC's default rather than\n52\t *  being passed as an explicit `undefined` (rejected under\n53\t *  exactOptionalPropertyTypes). */\n54\texport function registryArg(registryPath?: string): { registryPath?: string } {\n55\t  return registryPath === undefined ? {} : { registryPath };\n56\t}\n57\t\n58\t/** Resolve the recording thread from the launch input (AC-1.6):\n59\t *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n60\t *    ambiguous fails loud (the registry returns `thread_not_found` /\n61\t *    `ambiguous_thread_id`) and never silently creates a thread.\n62\t *  - `--continue`: the most recently created thread.\n63\t *  - no flag: a new thread, registered with its cwd (AC-1.1).\n64\t *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n65\t *  durable id rather than a retained object (AC-1.5). */\n66\texport async function resolveThread(\n67\t  launch: LaunchFlags,\n68\t  deps: ResolveDeps,\n69\t): Promise<OpResult<ThreadRef>> {\n70\t  if (launch.session !== undefined) {\n71\t    const resolved = await threads.resolve({\n72\t      threadId: launch.session,\n73\t      ...registryArg(deps.registryPath),\n74\t    });\n75\t    if (!resolved.ok) return resolved;\n76\t    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n77\t  }\n78\t\n79\t  if (launch.continue === true) {\n80\t    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n81\t    if (!listed.ok) return listed;\n82\t    // The registry lists in creation order with an insertion-order tie-break,\n83\t    // so the last row is the most recently created thread.\n84\t    const mostRecent = listed.value.at(-1);\n85\t    if (mostRecent === undefined) {\n86\t      return {\n87\t        ok: false,\n88\t        error: {\n89\t          errorClass: \"caller_error\",\n90\t          code: \"thread_not_found\",\n91\t          reason: \"--continue: no threads exist to continue\",\n92\t        },\n93\t      };\n94\t    }\n95\t    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n96\t  }\n97\t\n98\t  const created = await threads.newThread({\n99\t    filePath: deps.newThreadFilePath(),\n100\t    cwd: deps.cwd,\n101\t    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n102\t    ...registryArg(deps.registryPath),\n103\t  });\n104\t  if (!created.ok) return created;\n105\t  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n106\t}\n107\t\n108\t/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n109\t *  re-initialized while the same PI session continues — re-resolve the session's\n110\t *  thread from DURABLE registry state. It reads no retained in-process memory and\n111\t *  never creates a new thread or re-prompts a picker; the resolved id comes back\n112\t *  out of the registry (the durable catalog), so reconstruction survives the loss\n113\t *  of every in-memory holder (the architecture-risk scenario).\n114\t *\n115\t *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n116\t *    Both are idempotent — resolving twice returns the same thread and creates\n117\t *    nothing — so the normal resolver already reattaches correctly.\n118\t *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n119\t *    read from the registry. A no-flag Story-1 session created exactly one thread\n120\t *    in its cwd, so that is the thread; re-running the launch instead would create\n121\t *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n122\t *\n123\t *  Returns `null` when the cwd has no thread to reattach (a reload against an\n124\t *  empty registry); the caller records a diagnostic rather than creating one.\n125\t *\n126\t *  This is the answer to \"where does the durable reload id live without a\n127\t *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n128\t *  the system of record, not in a connector field or a recovery sidecar. The\n129\t *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n130\t *  reload/fork lineage is LHC thread metadata (Feature 2+). */\n131\texport async function resolveReloadThread(\n132\t  launch: LaunchFlags,\n133\t  deps: ResolveDeps,\n134\t): Promise<OpResult<ThreadRef | null>> {\n135\t  if (launch.session !== undefined) {\n136\t    return resolveThread({ session: launch.session }, deps);\n137\t  }\n138\t  if (launch.continue === true) {\n139\t    return resolveThread({ continue: true }, deps);\n140\t  }\n141\t  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n142\t  if (!listed.ok) return listed;\n143\t  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n144\t  // the most recently created thread for this directory.\n145\t  const mostRecent = listed.value.at(-1);\n146\t  if (mostRecent === undefined) return { ok: true, value: null };\n147\t  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n148\t}\n149\t\n150\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n151\t *  so PI's launch arguments are visible on `process.argv`; this is the\n152\t *  production source of the launch mode. Supports `--session <id>`,\n153\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n154\t *  spelling for the named-session mode is an integration detail to confirm\n155\t *  against PI; see the story payload's open questions.) */\n156\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n157\t  const flags: LaunchFlags = {};\n158\t  for (let i = 0; i < argv.length; i += 1) {\n159\t    const arg = argv[i];\n160\t    if (arg === undefined) continue;\n161\t    if (arg === \"--resume\" || arg === \"-r\") {\n162\t      flags.resume = true;\n163\t    } else if (arg === \"--continue\" || arg === \"-c\") {\n164\t      flags.continue = true;\n165\t    } else if (arg === \"--session\") {\n166\t      const next = argv[i + 1];\n167\t      if (next !== undefined && !next.startsWith(\"-\")) {\n168\t        flags.session = next;\n169\t        i += 1;\n170\t      }\n171\t    } else if (arg.startsWith(\"--session=\")) {\n172\t      flags.session = arg.slice(\"--session=\".length);\n173\t    }\n174\t  }\n175\t  return flags;\n176\t}\n177\t"}]},"parent_tool_use_id":null,"session_id":"a7689c21-1739-4f71-b1a5-e967f006f0f9","uuid":"4000c638-dab4-43e7-b975-3352a3387fc2","timestamp":"2026-06-14T13:46:49.993Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/thread-resolution.ts","content":"import { basename } from \"node:path\";\nimport { threads, type OpResult, type ThreadRef } from \"lhc\";\n\n// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n// it (tech design Flow 1). PI's own session file still exists in this\n// observe-only epic — it is just not where thread identity lives.\n\n/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n *  before this resolver — see `picker.ts`.) */\nexport interface LaunchFlags {\n  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n  continue?: boolean; // --continue / -c : most recent\n  session?: string; // --session <id> : full or partial id\n}\n\n/** What the resolver needs from the host beyond the launch flags: the cwd a new\n *  thread is registered under, the registry to resolve through, and where a new\n *  thread's file is created. Injected so the resolver is exercised against a\n *  real temp registry in tests and the default `~/.lhc` registry in production —\n *  `registryPath` is a per-operation argument, never an `initLhc` config field\n *  (tech design Technical Notes). */\nexport interface ResolveDeps {\n  cwd: string;\n  registryPath?: string;\n  newThreadFilePath: () => string;\n  /** Title for a newly created thread (A-8 title metadata). Defaults to\n   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n   *  title from the first prompt — the open TDQ Q4). */\n  newThreadTitle?: string;\n}\n\n/** The creation-time title for a new thread when the host supplies none. At\n *  session_start there is no first prompt yet, so the title is the cwd's leaf\n *  directory name — a real, non-empty project label the `--resume` picker shows\n *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\nexport function defaultThreadTitle(cwd: string): string {\n  const leaf = basename(cwd);\n  if (leaf !== \"\") return leaf;\n  return cwd !== \"\" ? cwd : \"lhc session\";\n}\n\n/** The durable, plain-data thread reference the connector retains and\n *  reattaches from: a thread id (plus the registry it lives in), not a live\n *  object. `{ filePath }` is avoided so reload reconstructs by id. */\nexport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n}\n\n/** Spread `registryPath` into an LHC threads-call options object only when it is\n *  set, so an unset registry path falls through to LHC's default rather than\n *  being passed as an explicit `undefined` (rejected under\n *  exactOptionalPropertyTypes). */\nexport function registryArg(registryPath?: string): { registryPath?: string } {\n  return registryPath === undefined ? {} : { registryPath };\n}\n\n/** Resolve the recording thread from the launch input (AC-1.6):\n *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n *    ambiguous fails loud (the registry returns `thread_not_found` /\n *    `ambiguous_thread_id`) and never silently creates a thread.\n *  - `--continue`: the most recently created thread.\n *  - no flag: a new thread, registered with its cwd (AC-1.1).\n *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n *  durable id rather than a retained object (AC-1.5). */\nexport async function resolveThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef>> {\n  if (launch.session !== undefined) {\n    const resolved = await threads.resolve({\n      threadId: launch.session,\n      ...registryArg(deps.registryPath),\n    });\n    if (!resolved.ok) return resolved;\n    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n  }\n\n  if (launch.continue === true) {\n    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n    if (!listed.ok) return listed;\n    // The registry lists in creation order with an insertion-order tie-break,\n    // so the last row is the most recently created thread.\n    const mostRecent = listed.value.at(-1);\n    if (mostRecent === undefined) {\n      return {\n        ok: false,\n        error: {\n          errorClass: \"caller_error\",\n          code: \"thread_not_found\",\n          reason: \"--continue: no threads exist to continue\",\n        },\n      };\n    }\n    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n  }\n\n  const created = await threads.newThread({\n    filePath: deps.newThreadFilePath(),\n    cwd: deps.cwd,\n    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n    ...registryArg(deps.registryPath),\n  });\n  if (!created.ok) return created;\n  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n}\n\n/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n *  re-initialized while the same PI session continues — re-resolve the session's\n *  thread from DURABLE registry state. It reads no retained in-process memory and\n *  never creates a new thread or re-prompts a picker; the resolved id comes back\n *  out of the registry (the durable catalog), so reconstruction survives the loss\n *  of every in-memory holder (the architecture-risk scenario).\n *\n *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n *    Both are idempotent — resolving twice returns the same thread and creates\n *    nothing — so the normal resolver already reattaches correctly.\n *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n *    read from the registry. A no-flag Story-1 session created exactly one thread\n *    in its cwd, so that is the thread; re-running the launch instead would create\n *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n *\n *  Returns `null` when the cwd has no thread to reattach (a reload against an\n *  empty registry); the caller records a diagnostic rather than creating one.\n *\n *  This is the answer to \"where does the durable reload id live without a\n *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n *  the system of record, not in a connector field or a recovery sidecar. The\n *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n *  reload/fork lineage is LHC thread metadata (Feature 2+). */\nexport async function resolveReloadThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef | null>> {\n  if (launch.session !== undefined) {\n    return resolveThread({ session: launch.session }, deps);\n  }\n  if (launch.continue === true) {\n    return resolveThread({ continue: true }, deps);\n  }\n  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n  if (!listed.ok) return listed;\n  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n  // the most recently created thread for this directory.\n  const mostRecent = listed.value.at(-1);\n  if (mostRecent === undefined) return { ok: true, value: null };\n  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n}\n\n/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n *  so PI's launch arguments are visible on `process.argv`; this is the\n *  production source of the launch mode. Supports `--session <id>`,\n *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n *  spelling for the named-session mode is an integration detail to confirm\n *  against PI; see the story payload's open questions.) */\nexport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n  const flags: LaunchFlags = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === undefined) continue;\n    if (arg === \"--resume\" || arg === \"-r\") {\n      flags.resume = true;\n    } else if (arg === \"--continue\" || arg === \"-c\") {\n      flags.continue = true;\n    } else if (arg === \"--session\") {\n      const next = argv[i + 1];\n      if (next !== undefined && !next.startsWith(\"-\")) {\n        flags.session = next;\n        i += 1;\n      }\n    } else if (arg.startsWith(\"--session=\")) {\n      flags.session = arg.slice(\"--session=\".length);\n    }\n  }\n  return flags;\n}\n","numLines":177,"startLine":1,"totalLines":177}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a87ea3dbeda047f4ae78da3e","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  MessageEventInput,\n13\t  OpResult,\n14\t  SdkConfig,\n15\t  ThreadRef,\n16\t} from \"lhc\";\n17\timport type {\n18\t  ExtensionAPI,\n19\t  ExtensionContext,\n20\t  PiHookHandler,\n21\t  PiHookName,\n22\t} from \"./pi/types.js\";\n23\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n24\timport { createSessionState } from \"./lifecycle/state.js\";\n25\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n26\timport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\n27\timport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\n28\timport { report, validateReachable } from \"./inference/startup-validation.js\";\n29\timport {\n30\t  detectForkFromSessionTree,\n31\t  forkInfoFromHook,\n32\t  seedFork,\n33\t} from \"./lifecycle/fork.js\";\n34\timport {\n35\t  parseLaunchFlags,\n36\t  resolveReloadThread,\n37\t  resolveThread,\n38\t  type LaunchFlags,\n39\t  type ResolveDeps,\n40\t} from \"./lifecycle/thread-resolution.js\";\n41\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n42\timport { threads } from \"lhc\";\n43\timport { capture, captureGap } from \"./capture/converter.js\";\n44\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n45\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n46\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n47\timport type { LhcInstance } from \"./shared/instance.js\";\n48\t\n49\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n50\texport type { LhcInstance } from \"./shared/instance.js\";\n51\t\n52\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n53\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n54\t *  registers no handler for it (story Scope Out). */\n55\texport const EPIC_1_HOOKS = [\n56\t  \"session_start\",\n57\t  \"message_end\",\n58\t  \"turn_end\",\n59\t  \"agent_end\",\n60\t  \"model_select\",\n61\t  \"thinking_level_select\",\n62\t  \"session_before_fork\",\n63\t  \"session_before_switch\",\n64\t  \"session_shutdown\",\n65\t] as const satisfies readonly PiHookName[];\n66\t\n67\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n68\t\n69\t/** What the connector needs from the host to run a session. Every dependency\n70\t *  has a working production default; the overrides exist for test isolation\n71\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n72\t *  in the PI-auth-backed inference config.\n73\t *\n74\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n75\t *  default is the observe-only config below (a real, construction-valid SDK);\n76\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n77\texport interface ConnectorDeps {\n78\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n79\t  registryPath?: string;\n80\t  newThreadFilePath?: () => string;\n81\t  parseLaunch?: () => LaunchFlags;\n82\t  selectThread?: (\n83\t    choices: readonly ThreadChoice[],\n84\t    ctx: ExtensionContext,\n85\t  ) => Promise<string | null>;\n86\t  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n87\t   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n88\t  assignmentConfig?: unknown;\n89\t}\n90\t\n91\t/** Everything the connector retains across hooks as PLAIN data — by\n92\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n93\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n94\t *  deliberately not part of the snapshot. */\n95\texport interface ConnectorSnapshot {\n96\t  state: SessionState | null;\n97\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n98\t}\n99\t\n100\texport interface Connector {\n101\t  /** Register the observe-only hook rail on the PI extension API. */\n102\t  register(pi: ExtensionAPI): void;\n103\t  /** The plain-data state retained across hooks. `null` until a session\n104\t   *  resolves a thread; never holds a PI ctx. */\n105\t  getState(): SessionState | null;\n106\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n107\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n108\t  getInstance(): LhcInstance | null;\n109\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n110\t  snapshot(): ConnectorSnapshot;\n111\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n112\t   *  synthetic ctx/events without a live PI. */\n113\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n114\t}\n115\t\n116\t/** The connector's live capture state for one session: the open-turn\n117\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n118\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n119\t *  per session, never part of the plain-data snapshot and never a PI object. */\n120\tinterface CaptureSession {\n121\t  piSessionId: string;\n122\t  accumulator: TurnAccumulator;\n123\t  sourceSeq: number;\n124\t}\n125\t\n126\t/** Fork state captured from `session_before_fork` and used on the next\n127\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n128\t *  only — no PI objects retained across the fork boundary. */\n129\tinterface PendingFork {\n130\t  sourceThreadRef: ThreadRef;\n131\t  forkEntryId: string;\n132\t}\n133\t\n134\tconst THREAD_STATE_ENTRY_TYPE = \"pi-lhc-thread-state\";\n135\tinterface DurableThreadStateEntry {\n136\t  version: 1;\n137\t  threadRef: ThreadRef;\n138\t}\n139\t\n140\tfunction durableThreadStateFromEntries(\n141\t  entries: readonly { readonly [k: string]: unknown }[],\n142\t): DurableThreadStateEntry | null {\n143\t  for (let index = entries.length - 1; index >= 0; index -= 1) {\n144\t    const entry = entries[index];\n145\t    if (entry === undefined) continue;\n146\t    if (entry.type !== \"custom\" || entry.customType !== THREAD_STATE_ENTRY_TYPE) continue;\n147\t    const data = entry.data;\n148\t    if (typeof data !== \"object\" || data === null) continue;\n149\t    const candidate = data as { readonly [k: string]: unknown };\n150\t    if (candidate.version !== 1) continue;\n151\t    const threadRef = candidate.threadRef;\n152\t    if (typeof threadRef !== \"object\" || threadRef === null) continue;\n153\t    const ref = threadRef as { readonly [k: string]: unknown };\n154\t    if (typeof ref.threadId === \"string\" || typeof ref.filePath === \"string\") {\n155\t      return { version: 1, threadRef: ref as unknown as ThreadRef };\n156\t    }\n157\t  }\n158\t  return null;\n159\t}\n160\t\n161\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n162\t *  identity, which survives reload/replay (the same thread re-resolves to the\n163\t *  same id). */\n164\tfunction sessionIdOf(ref: ThreadRef): string {\n165\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n166\t}\n167\t\n168\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n169\t\n170\t/** The production SDK config for Story 5+: injects the host ModelCall function\n171\t *  that resolves provider/model through PI's registry and completes through\n172\t *  pi-ai when available. Story 6 loads assignments from config with shipped\n173\t *  defaults. */\n174\tfunction defaultBuildSdkConfig(\n175\t  ctx: ExtensionContext,\n176\t  assignmentConfig: unknown = undefined,\n177\t): OpResult<SdkConfig> {\n178\t  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n179\t  const assignments = loadAssignmentsImpl(assignmentConfig);\n180\t\n181\t  return {\n182\t    ok: true,\n183\t    value: {\n184\t      inference: {\n185\t        call: createModelCall(ctx),\n186\t        assignments,\n187\t      },\n188\t      mode: \"background\",\n189\t    },\n190\t  };\n191\t}\n192\t\n193\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n194\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n195\t *  show. */\n196\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n197\t  const lines = choices.map((choice, i) => {\n198\t    const title = choice.title ?? \"(untitled)\";\n199\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n200\t  });\n201\t  return [\n202\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n203\t    ...lines,\n204\t    choices.length === 1\n205\t      ? \"One candidate found; resuming it.\"\n206\t      : \"Multiple candidates found; relaunch with --session <id> to choose one explicitly.\",\n207\t  ].join(\"\\n\");\n208\t}\n209\t\n210\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n211\t *  interactive input/selection surface (wiring research), so the production\n212\t *  picker presents the cwd-scoped candidate list — title + creation time — to the\n213\t *  operator through `ctx.ui.notify` when a UI is present and only auto-resolves\n214\t *  the single unambiguous candidate. Multiple candidates fail closed with\n215\t *  `null`, directing the operator to relaunch with `--session <id>`; this avoids\n216\t *  silently attaching capture to the wrong thread. The picker itself stays\n217\t *  cwd-scoped, titled, and selection-injectable (`pickThread` takes the `select`\n218\t *  seam); tests drive an explicit operator choice through it. */\n219\tfunction defaultSelectThread(\n220\t  choices: readonly ThreadChoice[],\n221\t  ctx: ExtensionContext,\n222\t): Promise<string | null> {\n223\t  if (ctx.hasUI) {\n224\t    ctx.ui.notify(renderResumeCandidates(choices), { level: choices.length === 1 ? \"info\" : \"warn\" });\n225\t  }\n226\t  return Promise.resolve(choices.length === 1 ? choices[0]?.threadId ?? null : null);\n227\t}\n228\t\n229\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n230\t *  generated by the registry at creation, so the file name is just a unique\n231\t *  handle; the directory is ensured up front (DatabaseSync does not create\n232\t *  parents). */\n233\tfunction defaultNewThreadFilePath(): string {\n234\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n235\t  mkdirSync(dir, { recursive: true });\n236\t  return join(dir, `${randomUUID()}.sqlite`);\n237\t}\n238\t\n239\t/** Build a connector instance. Its mutable state lives in this closure; the\n240\t *  registered handlers capture it, so the instance stays live for the session\n241\t *  even when `activate` discards the returned object. The connector holds NO\n242\t *  module-level or durable state of its own — reload reconstructs the thread from\n243\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n244\t *  closure reattaches correctly (AC-1.5). */\n245\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n246\t  // The connector's retained state. `state` is plain data (the durable thread\n247\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n248\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n249\t  // none survives the connector — reload re-resolves from the registry.\n250\t  let state: SessionState | null = null;\n251\t  let instance: LhcInstance | null = null;\n252\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n253\t  let captureSession: CaptureSession | null = null;\n254\t  let pendingFork: PendingFork | null = null;\n255\t  let appendThreadState: ((state: DurableThreadStateEntry) => void) | null = null;\n256\t\n257\t  // Build SDK config with assignment config if provided (Story 6)\n258\t  const buildSdkConfig = deps.buildSdkConfig ??\n259\t    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n260\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n261\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n262\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n263\t\n264\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n265\t    return { code, message, recordedGap: false };\n266\t  }\n267\t\n268\t  // The registry/file deps every resolver path shares. `registryPath` is set\n269\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n270\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n271\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n272\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n273\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n274\t    return resolveDeps;\n275\t  }\n276\t\n277\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n278\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n279\t  // no-flag creates).\n280\t  async function resolveForLaunch(\n281\t    launch: LaunchFlags,\n282\t    ctx: ExtensionContext,\n283\t  ): Promise<OpResult<ThreadRef | null>> {\n284\t    if (launch.resume === true) {\n285\t      const pickerDeps: {\n286\t        registryPath?: string;\n287\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n288\t      } = { select: (choices) => selectThread(choices, ctx) };\n289\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n290\t      return pickThread(ctx.cwd, pickerDeps);\n291\t    }\n292\t    return resolveThread(launch, buildResolveDeps(ctx));\n293\t  }\n294\t\n295\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n296\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n297\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n298\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n299\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n300\t  async function resolveReloadFor(\n301\t    launch: LaunchFlags,\n302\t    ctx: ExtensionContext,\n303\t  ): Promise<OpResult<ThreadRef | null>> {\n304\t    const durable = durableThreadStateFromEntries(ctx.sessionManager.getEntries());\n305\t    if (durable !== null) return { ok: true, value: durable.threadRef };\n306\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n307\t  }\n308\t\n309\t  // session_start: resolve the recording thread and construct one background\n310\t  // instance against it. Config is gated first so a session with no usable\n311\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n312\t  // thread is re-resolved from the durable registry (reattach, never create);\n313\t  // every other reason runs the normal launch resolution. Fork creates a new\n314\t  // thread and seeds it from the source thread (Story 4).\n315\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n316\t    const config = buildSdkConfig(ctx);\n317\t    if (!config.ok) {\n318\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n319\t      return;\n320\t    }\n321\t\n322\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n323\t    let forkAttempted = false;\n324\t\n325\t    // Fork path (Story 4): create a new thread and seed it from the source.\n326\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n327\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n328\t    if (pendingFork !== null) {\n329\t      forkAttempted = true;\n330\t      // Hook-based fork detection: session_before_fork fired.\n331\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n332\t\n333\t      // Create a new thread for the fork.\n334\t      const resolveDeps = buildResolveDeps(ctx);\n335\t      const newFilePath = resolveDeps.newThreadFilePath();\n336\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n337\t        filePath: newFilePath,\n338\t        cwd: resolveDeps.cwd,\n339\t      };\n340\t      if (resolveDeps.registryPath !== undefined) {\n341\t        newThreadInput.registryPath = resolveDeps.registryPath;\n342\t      }\n343\t      const created = await threads.newThread(newThreadInput);\n344\t      if (!created.ok) {\n345\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n346\t        pendingFork = null;\n347\t        state = null;\n348\t        captureSession = null;\n349\t        return;\n350\t      } else {\n351\t        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n352\t\n353\t        // Initialize the instance against the target thread first (required for seedFork).\n354\t        const built = await initInstance(targetThreadRef, config.value);\n355\t        if (!built.ok) {\n356\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n357\t          pendingFork = null;\n358\t          state = null;\n359\t          captureSession = null;\n360\t          return;\n361\t        } else {\n362\t          instance = built.value;\n363\t\n364\t          // Seed the fork by replaying source events up to the fork point.\n365\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n366\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n367\t          if (!seeded.ok) {\n368\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n369\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n370\t            pendingFork = null;\n371\t            await disposeInstance(instance);\n372\t            instance = null;\n373\t            state = null;\n374\t            captureSession = null;\n375\t            return;\n376\t          } else {\n377\t            // Fork succeeded - clear pending fork state and use the forked thread.\n378\t            pendingFork = null;\n379\t            resolved = { ok: true, value: targetThreadRef };\n380\t          }\n381\t        }\n382\t      }\n383\t    }\n384\t\n385\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n386\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n387\t    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n388\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n389\t      if (forkFromTree !== null) {\n390\t        forkAttempted = true;\n391\t        // Session tree indicates a fork - create and seed as above.\n392\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n393\t\n394\t        const resolveDeps = buildResolveDeps(ctx);\n395\t        const newFilePath = resolveDeps.newThreadFilePath();\n396\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n397\t          filePath: newFilePath,\n398\t          cwd: resolveDeps.cwd,\n399\t        };\n400\t        if (resolveDeps.registryPath !== undefined) {\n401\t          newThreadInput.registryPath = resolveDeps.registryPath;\n402\t        }\n403\t        const created = await threads.newThread(newThreadInput);\n404\t        if (!created.ok) {\n405\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n406\t          state = null;\n407\t          captureSession = null;\n408\t          return;\n409\t        } else {\n410\t          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n411\t\n412\t          const built = await initInstance(targetThreadRef, config.value);\n413\t          if (!built.ok) {\n414\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n415\t            state = null;\n416\t            captureSession = null;\n417\t            return;\n418\t          } else {\n419\t            instance = built.value;\n420\t\n421\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n422\t            if (!seeded.ok) {\n423\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n424\t              await disposeInstance(instance);\n425\t              instance = null;\n426\t              state = null;\n427\t              captureSession = null;\n428\t              return;\n429\t            } else {\n430\t              resolved = { ok: true, value: targetThreadRef };\n431\t            }\n432\t          }\n433\t        }\n434\t      }\n435\t    }\n436\t\n437\t    // Normal launch resolution (if not resolved by fork paths above).\n438\t    if (resolved === undefined) {\n439\t      const launch = parseLaunch();\n440\t      const isReload = event.reason === \"reload\";\n441\t      resolved = isReload\n442\t        ? await resolveReloadFor(launch, ctx)\n443\t        : await resolveForLaunch(launch, ctx);\n444\t    }\n445\t\n446\t    if (!resolved.ok) {\n447\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n448\t      return;\n449\t    }\n450\t    if (resolved.value === null) {\n451\t      const isReload = event.reason === \"reload\";\n452\t      lastDiagnostic = isReload\n453\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n454\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n455\t      return;\n456\t    }\n457\t\n458\t    // If instance wasn't created during fork path, create it now.\n459\t    if (instance === null) {\n460\t      const built = await initInstance(resolved.value, config.value);\n461\t      if (!built.ok) {\n462\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n463\t        return;\n464\t      }\n465\t      instance = built.value;\n466\t    }\n467\t\n468\t    state = createSessionState(resolved.value);\n469\t    appendThreadState?.({ version: 1, threadRef: state.threadRef });\n470\t    const piSessionId = sessionIdOf(resolved.value);\n471\t    captureSession = {\n472\t      piSessionId,\n473\t      accumulator: new TurnAccumulator({ piSessionId }),\n474\t      sourceSeq: 0,\n475\t    };\n476\t\n477\t    // Story 6: Startup validation - probe all seven assignments before first use\n478\t    // This runs after instance creation but before capture begins (AC-5.1).\n479\t    // Validation failures are reported but do NOT stop capture (AC-5.3).\n480\t    if (config.value.inference === undefined) {\n481\t      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n482\t      return;\n483\t    }\n484\t    const assignments = config.value.inference.assignments;\n485\t    const validationReport = validateReachable(assignments, ctx);\n486\t    report(validationReport, ctx, state);\n487\t  };\n488\t\n489\t  // Dispose with flush before any session swap (session_before_switch fires\n490\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n491\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n492\t  // re-resolves its thread from the durable registry on the next session_start.\n493\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n494\t    const result = await disposeInstance(instance);\n495\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n496\t    instance = null;\n497\t    captureSession = null;\n498\t  };\n499\t\n500\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n501\t  // converter already recorded a durable gap for a writable-thread malformed\n502\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n503\t  // surfaces as an extension health signal with no gap. Neither path throws.\n504\t  function recordCaptureOutcome(\n505\t    result: OpResult<BatchResult>,\n506\t    events: readonly MessageEventInput[],\n507\t  ): void {\n508\t    if (result.ok) return;\n509\t    const recordedGap = result.error.code === \"invalid_event\";\n510\t    const failure: CaptureFailureDiagnostic = {\n511\t      code: result.error.code,\n512\t      message: result.error.reason,\n513\t      recordedGap,\n514\t    };\n515\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n516\t    lastDiagnostic = failure;\n517\t    if (state !== null) state.health.lastCaptureFailure = failure;\n518\t  }\n519\t\n520\t  function nextSourceSeq(session: CaptureSession): number {\n521\t    const sourceSeq = session.sourceSeq;\n522\t    session.sourceSeq += 1;\n523\t    return sourceSeq;\n524\t  }\n525\t\n526\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n527\t    // Last-resort id-less discriminator. PI position wins when present; the\n528\t    // connector ordinal is used only when PI gives no event identity at all.\n529\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n530\t    // order yields the same ordinal, which is the best identity available.\n531\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n532\t  }\n533\t\n534\t  async function recordMappingFailure(\n535\t    hook: string,\n536\t    position: number | undefined,\n537\t    sourceSeq: number,\n538\t    cause: unknown,\n539\t  ): Promise<void> {\n540\t    if (instance === null) return;\n541\t    const message = cause instanceof Error ? cause.message : String(cause);\n542\t    const result = await captureGap(\n543\t      fallbackIdFor(hook, position, sourceSeq),\n544\t      `${hook}: ${message}`,\n545\t      instance,\n546\t    );\n547\t    if (!result.ok) {\n548\t      recordCaptureOutcome(result, []);\n549\t      return;\n550\t    }\n551\t    const failure: CaptureFailureDiagnostic = {\n552\t      code: \"invalid_event\",\n553\t      message: `${hook}: ${message}`,\n554\t      recordedGap: true,\n555\t    };\n556\t    lastDiagnostic = failure;\n557\t    if (state !== null) state.health.lastCaptureFailure = failure;\n558\t  }\n559\t\n560\t  // message_end: map the finalized PI message to ordered LHC events, track the\n561\t  // open turn, and flush through the converter (AC-2.1).\n562\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n563\t    if (instance === null || captureSession === null) return;\n564\t    const sourceSeq = nextSourceSeq(captureSession);\n565\t    const mapCtx: MapCtx =\n566\t      event.entryId !== undefined && event.entryId !== \"\"\n567\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n568\t        : {\n569\t            piSessionId: captureSession.piSessionId,\n570\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n571\t          };\n572\t    let events: MessageEventInput[];\n573\t    try {\n574\t      events = mapMessage(event.message, mapCtx);\n575\t    } catch (cause) {\n576\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n577\t      return;\n578\t    }\n579\t    captureSession.accumulator.onMessage(events);\n580\t    if (events.length === 0) return;\n581\t    recordCaptureOutcome(await capture(events, instance), events);\n582\t  };\n583\t\n584\t  // model_select / thinking_level_select fire only in-stream — capture each as\n585\t  // an ordered runtime_note the moment it fires (AC-2.8).\n586\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n587\t    if (instance === null || captureSession === null) return;\n588\t    const sourceSeq = nextSourceSeq(captureSession);\n589\t    const mapCtx: MapCtx = {\n590\t      piSessionId: captureSession.piSessionId,\n591\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n592\t    };\n593\t    const note = mapModelSelect(event, mapCtx);\n594\t    recordCaptureOutcome(await capture([note], instance), [note]);\n595\t  };\n596\t\n597\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n598\t    if (instance === null || captureSession === null) return;\n599\t    const sourceSeq = nextSourceSeq(captureSession);\n600\t    const mapCtx: MapCtx = {\n601\t      piSessionId: captureSession.piSessionId,\n602\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n603\t    };\n604\t    const note = mapThinkingLevelSelect(event, mapCtx);\n605\t    recordCaptureOutcome(await capture([note], instance), [note]);\n606\t  };\n607\t\n608\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n609\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n610\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n611\t    if (instance === null || captureSession === null) return;\n612\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n613\t    if (turnEnd.length === 0) return;\n614\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n615\t  };\n616\t\n617\t  // Contain every handler: an observe-only hook must never throw back into PI\n618\t  // (a thrown hook breaks the user's session). A caught error becomes a\n619\t  // plain-data diagnostic; it is never rethrown.\n620\t  const guard = (\n621\t    name: Epic1Hook,\n622\t    body: PiHookHandler<Epic1Hook>,\n623\t  ): PiHookHandler<Epic1Hook> => {\n624\t    return async (ctx, event): Promise<void> => {\n625\t      try {\n626\t        await body(ctx, event);\n627\t      } catch (err) {\n628\t        lastDiagnostic = {\n629\t          code: \"hook_handler_error\",\n630\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n631\t          recordedGap: false,\n632\t        };\n633\t      }\n634\t    };\n635\t  };\n636\t\n637\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n638\t  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n639\t  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n640\t  const noop: PiHookHandler<Epic1Hook> = () => {\n641\t    // Intentionally empty — turn_end is ignored as a boundary.\n642\t  };\n643\t\n644\t  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n645\t  // The source thread ref is captured from the current session state; the hook\n646\t  // provides entryId/position identifying the fork point. No writes to the source\n647\t  // thread occur — the fork happens on the next session_start (Story 4).\n648\t  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n649\t    if (state === null) return;\n650\t    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n651\t    // Store the fork info for use on session_start{fork}.\n652\t    pendingFork = {\n653\t      sourceThreadRef: state.threadRef,\n654\t      forkEntryId: forkInfo.forkEntryId,\n655\t    };\n656\t  };\n657\t\n658\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n659\t  // are live; fork handling (Story 4) is wired.\n660\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n661\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n662\t    session_before_switch: onDispose,\n663\t    session_shutdown: onDispose,\n664\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n665\t    turn_end: noop,\n666\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n667\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n668\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n669\t    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n670\t  };\n671\t\n672\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n673\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n674\t\n675\t  return {\n676\t    handlers,\n677\t    register(pi: ExtensionAPI): void {\n678\t      appendThreadState = (entry) => pi.appendEntry(THREAD_STATE_ENTRY_TYPE, entry);\n679\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n680\t    },\n681\t    getState(): SessionState | null {\n682\t      return state;\n683\t    },\n684\t    getInstance(): LhcInstance | null {\n685\t      return instance;\n686\t    },\n687\t    snapshot(): ConnectorSnapshot {\n688\t      return { state, lastDiagnostic };\n689\t    },\n690\t  };\n691\t}\n692\t\n693\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n694\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n695\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n696\t *  observe-only SDK config, and the `--resume` selector that presents the\n697\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n698\t *  resolves/creates and initializes for real. On `/reload` the connector\n699\t *  re-resolves the same thread from the durable registry (it keeps no\n700\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n701\t *  config. */\n702\texport function activate(pi: ExtensionAPI): void {\n703\t  createConnector().register(pi);\n704\t}\n705\t\n706\texport default activate;\n707\t"}]},"parent_tool_use_id":null,"session_id":"a7689c21-1739-4f71-b1a5-e967f006f0f9","uuid":"234a2b99-b217-496e-85b7-dadd374c25f6","timestamp":"2026-06-14T13:46:51.028Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  MessageEventInput,\n  OpResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\nimport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\nimport { report, validateReachable } from \"./inference/startup-validation.js\";\nimport {\n  detectForkFromSessionTree,\n  forkInfoFromHook,\n  seedFork,\n} from \"./lifecycle/fork.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { threads } from \"lhc\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n  assignmentConfig?: unknown;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** Fork state captured from `session_before_fork` and used on the next\n *  `session_start{fork}` to create and seed the forked thread. Plain data\n *  only — no PI objects retained across the fork boundary. */\ninterface PendingFork {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\nconst THREAD_STATE_ENTRY_TYPE = \"pi-lhc-thread-state\";\ninterface DurableThreadStateEntry {\n  version: 1;\n  threadRef: ThreadRef;\n}\n\nfunction durableThreadStateFromEntries(\n  entries: readonly { readonly [k: string]: unknown }[],\n): DurableThreadStateEntry | null {\n  for (let index = entries.length - 1; index >= 0; index -= 1) {\n    const entry = entries[index];\n    if (entry === undefined) continue;\n    if (entry.type !== \"custom\" || entry.customType !== THREAD_STATE_ENTRY_TYPE) continue;\n    const data = entry.data;\n    if (typeof data !== \"object\" || data === null) continue;\n    const candidate = data as { readonly [k: string]: unknown };\n    if (candidate.version !== 1) continue;\n    const threadRef = candidate.threadRef;\n    if (typeof threadRef !== \"object\" || threadRef === null) continue;\n    const ref = threadRef as { readonly [k: string]: unknown };\n    if (typeof ref.threadId === \"string\" || typeof ref.filePath === \"string\") {\n      return { version: 1, threadRef: ref as unknown as ThreadRef };\n    }\n  }\n  return null;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production SDK config for Story 5+: injects the host ModelCall function\n *  that resolves provider/model through PI's registry and completes through\n *  pi-ai when available. Story 6 loads assignments from config with shipped\n *  defaults. */\nfunction defaultBuildSdkConfig(\n  ctx: ExtensionContext,\n  assignmentConfig: unknown = undefined,\n): OpResult<SdkConfig> {\n  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n  const assignments = loadAssignmentsImpl(assignmentConfig);\n\n  return {\n    ok: true,\n    value: {\n      inference: {\n        call: createModelCall(ctx),\n        assignments,\n      },\n      mode: \"background\",\n    },\n  };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    choices.length === 1\n      ? \"One candidate found; resuming it.\"\n      : \"Multiple candidates found; relaunch with --session <id> to choose one explicitly.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker presents the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present and only auto-resolves\n *  the single unambiguous candidate. Multiple candidates fail closed with\n *  `null`, directing the operator to relaunch with `--session <id>`; this avoids\n *  silently attaching capture to the wrong thread. The picker itself stays\n *  cwd-scoped, titled, and selection-injectable (`pickThread` takes the `select`\n *  seam); tests drive an explicit operator choice through it. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: choices.length === 1 ? \"info\" : \"warn\" });\n  }\n  return Promise.resolve(choices.length === 1 ? choices[0]?.threadId ?? null : null);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n  let pendingFork: PendingFork | null = null;\n  let appendThreadState: ((state: DurableThreadStateEntry) => void) | null = null;\n\n  // Build SDK config with assignment config if provided (Story 6)\n  const buildSdkConfig = deps.buildSdkConfig ??\n    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    const durable = durableThreadStateFromEntries(ctx.sessionManager.getEntries());\n    if (durable !== null) return { ok: true, value: durable.threadRef };\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        state = null;\n        captureSession = null;\n        return;\n      } else {\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            await disposeInstance(instance);\n            instance = null;\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        forkAttempted = true;\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              await disposeInstance(instance);\n              instance = null;\n              state = null;\n              captureSession = null;\n              return;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";\n      resolved = isReload\n        ? await resolveReloadFor(launch, ctx)\n        : await resolveForLaunch(launch, ctx);\n    }\n\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      const isReload = event.reason === \"reload\";\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n\n    // If instance wasn't created during fork path, create it now.\n    if (instance === null) {\n      const built = await initInstance(resolved.value, config.value);\n      if (!built.ok) {\n        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n        return;\n      }\n      instance = built.value;\n    }\n\n    state = createSessionState(resolved.value);\n    appendThreadState?.({ version: 1, threadRef: state.threadRef });\n    const piSessionId = sessionIdOf(resolved.value);\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId }),\n      sourceSeq: 0,\n    };\n\n    // Story 6: Startup validation - probe all seven assignments before first use\n    // This runs after instance creation but before capture begins (AC-5.1).\n    // Validation failures are reported but do NOT stop capture (AC-5.3).\n    if (config.value.inference === undefined) {\n      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n      return;\n    }\n    const assignments = config.value.inference.assignments;\n    const validationReport = validateReachable(assignments, ctx);\n    report(validationReport, ctx, state);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  function nextSourceSeq(session: CaptureSession): number {\n    const sourceSeq = session.sourceSeq;\n    session.sourceSeq += 1;\n    return sourceSeq;\n  }\n\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n    // Last-resort id-less discriminator. PI position wins when present; the\n    // connector ordinal is used only when PI gives no event identity at all.\n    // For id-less + position-less reload replay, PI's deterministic redelivery\n    // order yields the same ordinal, which is the best identity available.\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n  }\n\n  async function recordMappingFailure(\n    hook: string,\n    position: number | undefined,\n    sourceSeq: number,\n    cause: unknown,\n  ): Promise<void> {\n    if (instance === null) return;\n    const message = cause instanceof Error ? cause.message : String(cause);\n    const result = await captureGap(\n      fallbackIdFor(hook, position, sourceSeq),\n      `${hook}: ${message}`,\n      instance,\n    );\n    if (!result.ok) {\n      recordCaptureOutcome(result, []);\n      return;\n    }\n    const failure: CaptureFailureDiagnostic = {\n      code: \"invalid_event\",\n      message: `${hook}: ${message}`,\n      recordedGap: true,\n    };\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  // message_end: map the finalized PI message to ordered LHC events, track the\n  // open turn, and flush through the converter (AC-2.1).\n  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx =\n      event.entryId !== undefined && event.entryId !== \"\"\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n        : {\n            piSessionId: captureSession.piSessionId,\n            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n          };\n    let events: MessageEventInput[];\n    try {\n      events = mapMessage(event.message, mapCtx);\n    } catch (cause) {\n      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n      return;\n    }\n    captureSession.accumulator.onMessage(events);\n    if (events.length === 0) return;\n    recordCaptureOutcome(await capture(events, instance), events);\n  };\n\n  // model_select / thinking_level_select fire only in-stream — capture each as\n  // an ordered runtime_note the moment it fires (AC-2.8).\n  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n    };\n    const note = mapModelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n    };\n    const note = mapThinkingLevelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n    if (instance === null || captureSession === null) return;\n    const turnEnd = captureSession.accumulator.onAgentEnd();\n    if (turnEnd.length === 0) return;\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — turn_end is ignored as a boundary.\n  };\n\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n  // The source thread ref is captured from the current session state; the hook\n  // provides entryId/position identifying the fork point. No writes to the source\n  // thread occur — the fork happens on the next session_start (Story 4).\n  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n    if (state === null) return;\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n    // Store the fork info for use on session_start{fork}.\n    pendingFork = {\n      sourceThreadRef: state.threadRef,\n      forkEntryId: forkInfo.forkEntryId,\n    };\n  };\n\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n  // are live; fork handling (Story 4) is wired.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n    turn_end: noop,\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      appendThreadState = (entry) => pi.appendEntry(THREAD_STATE_ENTRY_TYPE, entry);\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from the durable registry (it keeps no\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n *  config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":707,"startLine":1,"totalLines":707}}}

ds-a8.test.ts:2:// partial-id (prefix) resolve with ambiguity failure, the cwd-scoped listing,\\npackages/lhc/test/threads-a8.test.ts:3:// deterministic most-recent ordering, and lazy upgrade of a pre-cwd registry.\\npackages/lhc/test/threads-a8.test.ts:6:// only through the connector (anti-shim: the scope is the query, not a filter\\npackages/lhc/test/threads-a8.test.ts:20:async function create(opts: { title?: string; cwd?: string } = {}): Promise<string> {\\npackages/lhc/test/threads-a8.test.ts:21:  const input: { filePath: string; registryPath: string; title?: string; cwd?: string } = {\\npackages/lhc/test/threads-a8.test.ts:25:  if (opts.title !== undefined) input.title = opts.title;\\npackages/lhc/test/threads-a8.test.ts:26:  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\npackages/lhc/test/threads-a8.test.ts:27:  const result = await threads.newThread(input);\\npackages/lhc/test/threads-a8.test.ts:32:describe(\\\"A-8: cwd column\\\", () => {\\npackages/lhc/test/threads-a8.test.ts:33:  it(\\\"newThread stores cwd; resolve and listThreads carry it back\\\", async () => {\\npackages/lhc/test/threads-a8.test.ts:34:    const id = await create({ cwd: \\\"/work/project-a\\\", title: \\\"a\\\" });\\npackages/lhc/test/threads-a8.test.ts:38:    if (resolved.ok) expect(resolved.value.cwd).toBe(\\\"/work/project-a\\\");\\npackages/lhc/test/threads-a8.test.ts:40:    const listed = await threads.listThreads({ registryPath: store.registryPath });\\npackages/lhc/test/threads-a8.test.ts:42:    if (listed.ok) expect(listed.value[0]?.cwd).toBe(\\\"/work/project-a\\\");\\npackages/lhc/test/threads-a8.test.ts:45:  it(\\\"a thread created with no cwd reports cwd undefined\\\", async () => {\\npackages/lhc/test/threads-a8.test.ts:46:    const id = await create({ title: \\\"no-cwd\\\" });\\npackages/lhc/test/threads-a8.test.ts:49:    if (resolved.ok) expect(resolved.value.cwd).toBeUndefined();\\npackages/lhc/test/threads-a8.test.ts:55:    const id = await create({ title: \\\"only
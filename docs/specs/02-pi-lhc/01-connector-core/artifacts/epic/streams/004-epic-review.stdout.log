{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c3c8da67280242b590486411","type":"tool_result","content":"1\t// Local declarations of the pi-ai completion surface the connector consumes.\n2\t//\n3\t// These mirror `@earendil-works/pi-ai` as verified by the wiring research\n4\t// (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md). The pi-ai package\n5\t// is not yet a build dependency of this workspace, so the connector declares the\n6\t// slice of their contract it touches and swaps to the real imports when the\n7\t// dependency lands (Spec Deviation, recorded in the story payload).\n8\t\n9\timport type { AssistantMessage, ModelHandle } from \"../pi/types.js\";\n10\t\n11\t/** Completion context passed to pi-ai's complete() function. */\n12\texport interface CompleteContext {\n13\t  messages: Array<{ role: \"system\" | \"user\"; content: string }>;\n14\t}\n15\t\n16\t/** The pi-ai complete() signature. */\n17\texport interface PiAiComplete {\n18\t  (model: ModelHandle, context: CompleteContext): Promise<AssistantMessage>;\n19\t}\n20\t\n21\t/** Error shapes pi-ai's complete() may throw or return. */\n22\texport interface PiAiError {\n23\t  code?: string;\n24\t  type?: string;\n25\t  message?: string;\n26\t}\n27\t\n28\t/** Known pi-ai error codes/types that map to LHC failure kinds. */\n29\texport const PI_AI_ERROR_CODES = {\n30\t  AUTH_FAILED: [\"auth_failed\", \"authentication_error\", \"unauthorized\", \"401\"],\n31\t  INVALID_REQUEST: [\"invalid_request\", \"invalid_api_key\", \"400\"],\n32\t  RATE_LIMIT: [\"rate_limit\", \"rate_limit_exceeded\", \"429\"],\n33\t  TIMEOUT: [\"timeout\", \"request_timeout\", \"408\"],\n34\t  NETWORK: [\"network_error\", \"connection_error\", \"fetch_error\", \"ENOTFOUND\", \"ECONNREFUSED\"],\n35\t} as const;\n36\t"}]},"parent_tool_use_id":null,"session_id":"d8b1b04c-6358-4278-8fe4-779266fa40d8","uuid":"4034b3a8-ddea-457e-bfad-a77507bc9b6c","timestamp":"2026-06-14T13:54:08.620Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/pi-ai.ts","content":"// Local declarations of the pi-ai completion surface the connector consumes.\n//\n// These mirror `@earendil-works/pi-ai` as verified by the wiring research\n// (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md). The pi-ai package\n// is not yet a build dependency of this workspace, so the connector declares the\n// slice of their contract it touches and swaps to the real imports when the\n// dependency lands (Spec Deviation, recorded in the story payload).\n\nimport type { AssistantMessage, ModelHandle } from \"../pi/types.js\";\n\n/** Completion context passed to pi-ai's complete() function. */\nexport interface CompleteContext {\n  messages: Array<{ role: \"system\" | \"user\"; content: string }>;\n}\n\n/** The pi-ai complete() signature. */\nexport interface PiAiComplete {\n  (model: ModelHandle, context: CompleteContext): Promise<AssistantMessage>;\n}\n\n/** Error shapes pi-ai's complete() may throw or return. */\nexport interface PiAiError {\n  code?: string;\n  type?: string;\n  message?: string;\n}\n\n/** Known pi-ai error codes/types that map to LHC failure kinds. */\nexport const PI_AI_ERROR_CODES = {\n  AUTH_FAILED: [\"auth_failed\", \"authentication_error\", \"unauthorized\", \"401\"],\n  INVALID_REQUEST: [\"invalid_request\", \"invalid_api_key\", \"400\"],\n  RATE_LIMIT: [\"rate_limit\", \"rate_limit_exceeded\", \"429\"],\n  TIMEOUT: [\"timeout\", \"request_timeout\", \"408\"],\n  NETWORK: [\"network_error\", \"connection_error\", \"fetch_error\", \"ENOTFOUND\", \"ECONNREFUSED\"],\n} as const;\n","numLines":36,"startLine":1,"totalLines":36}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6c98492e406646d6a9e7e2c0","type":"tool_result","content":"1\t// Deterministic ModelCall fakes — the inference edge (tech design §Fixture\n2\t// Contracts / Testing Strategy). These stand in for `ctx.modelRegistry` +\n3\t// pi-ai `complete`, so the inference tests (Story 5) control completion text\n4\t// and failure shapes without a live provider.\n5\timport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\n6\t\n7\t/** Always resolves to text. */\n8\texport function fakeModelCallText(text: string): ModelCall {\n9\t  return () => Promise.resolve<ModelCallResult>({ ok: true, text });\n10\t}\n11\t\n12\t/** Always resolves to a classified transport failure. */\n13\texport function fakeModelCallFailure(\n14\t  kind: ModelCallFailureKind,\n15\t  message = `injected ${kind}`,\n16\t): ModelCall {\n17\t  return () => Promise.resolve<ModelCallResult>({ ok: false, kind, message });\n18\t}\n19\t\n20\t/** Routes each call by its `provider/model` key to a per-lane fake — the\n21\t *  multi-lane substrate for AC-4.2. An unrouted key resolves to an\n22\t *  `invalid_request` failure (never a silent success). */\n23\texport function fakeModelCallRouter(\n24\t  routes: Record<string, ModelCall>,\n25\t  fallback?: ModelCall,\n26\t): ModelCall {\n27\t  return (input) => {\n28\t    const key = `${input.provider}/${input.model}`;\n29\t    const route = routes[key] ?? fallback;\n30\t    if (route === undefined) {\n31\t      return Promise.resolve<ModelCallResult>({\n32\t        ok: false,\n33\t        kind: \"invalid_request\",\n34\t        message: `no fake route for ${key}`,\n35\t      });\n36\t    }\n37\t    return route(input);\n38\t  };\n39\t}\n40\t"}]},"parent_tool_use_id":null,"session_id":"d8b1b04c-6358-4278-8fe4-779266fa40d8","uuid":"0acb82ff-1f69-4c4f-a64f-8fba9a2960e0","timestamp":"2026-06-14T13:54:08.621Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.ts","content":"// Deterministic ModelCall fakes — the inference edge (tech design §Fixture\n// Contracts / Testing Strategy). These stand in for `ctx.modelRegistry` +\n// pi-ai `complete`, so the inference tests (Story 5) control completion text\n// and failure shapes without a live provider.\nimport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\n\n/** Always resolves to text. */\nexport function fakeModelCallText(text: string): ModelCall {\n  return () => Promise.resolve<ModelCallResult>({ ok: true, text });\n}\n\n/** Always resolves to a classified transport failure. */\nexport function fakeModelCallFailure(\n  kind: ModelCallFailureKind,\n  message = `injected ${kind}`,\n): ModelCall {\n  return () => Promise.resolve<ModelCallResult>({ ok: false, kind, message });\n}\n\n/** Routes each call by its `provider/model` key to a per-lane fake — the\n *  multi-lane substrate for AC-4.2. An unrouted key resolves to an\n *  `invalid_request` failure (never a silent success). */\nexport function fakeModelCallRouter(\n  routes: Record<string, ModelCall>,\n  fallback?: ModelCall,\n): ModelCall {\n  return (input) => {\n    const key = `${input.provider}/${input.model}`;\n    const route = routes[key] ?? fallback;\n    if (route === undefined) {\n      return Promise.resolve<ModelCallResult>({\n        ok: false,\n        kind: \"invalid_request\",\n        message: `no fake route for ${key}`,\n      });\n    }\n    return route(input);\n  };\n}\n","numLines":40,"startLine":1,"totalLines":40}}}

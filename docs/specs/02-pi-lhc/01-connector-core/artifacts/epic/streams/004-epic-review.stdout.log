{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/inference/closed-loop.test.ts | sed -n '1,300p'\"","aggregated_output":"     1\t// TC-4.5: closed-loop proof through the PI connector hooks.\n     2\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     3\timport {\n     4\t  DEFAULT_PROMPT_NAMES,\n     5\t  type FormKind,\n     6\t  type ModelAssignment,\n     7\t  type ModelCall,\n     8\t  type ModelCallResult,\n     9\t  type SdkConfig,\n    10\t  type ThreadRef,\n    11\t} from \"lhc\";\n    12\timport { createConnector, type Connector } from \"../../src/index.js\";\n    13\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n    14\timport { makeAssistantMessage, makeUserMessage } from \"../fixtures/synthetic.js\";\n    15\timport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"../fixtures/model-call.js\";\n    16\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    17\t\n    18\ttype Deferred<T> = { promise: Promise<T>; resolve: (value: T) => void };\n    19\t\n    20\tfunction deferred<T>(): Deferred<T> {\n    21\t  let resolve!: (value: T) => void;\n    22\t  const promise = new Promise<T>((res) => {\n    23\t    resolve = res;\n    24\t  });\n    25\t  return { promise, resolve };\n    26\t}\n    27\t\n    28\tfunction assignments(overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {}): Record<FormKind, ModelAssignment> {\n    29\t  const base = { provider: \"openai\", model: \"good\" };\n    30\t  return {\n    31\t    smoothed_prompt: { ...base, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt, ...(overrides.smoothed_prompt ?? {}) },\n    32\t    tool_call_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary, ...(overrides.tool_call_summary ?? {}) },\n    33\t    tool_result_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary, ...(overrides.tool_result_summary ?? {}) },\n    34\t    turn_rendering: { ...base, prompt: DEFAULT_PROMPT_NAMES.turn_rendering, ...(overrides.turn_rendering ?? {}) },\n    35\t    lower_band_projection: { ...base, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection, ...(overrides.lower_band_projection ?? {}) },\n    36\t    chunk_summary_detailed: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed, ...(overrides.chunk_summary_detailed ?? {}) },\n    37\t    chunk_summary_brief: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief, ...(overrides.chunk_summary_brief ?? {}) },\n    38\t  };\n    39\t}\n    40\t\n    41\tasync function captureClosedTurn(\n    42\t  connector: Connector,\n    43\t  ctx: ExtensionContext,\n    44\t  userText: string,\n    45\t  assistantText: string,\n    46\t): Promise<void> {\n    47\t  await connector.handlers.message_end(ctx, {\n    48\t    message: makeUserMessage(userText),\n    49\t    entryId: `${userText}-user`,\n    50\t  });\n    51\t  await connector.handlers.message_end(ctx, {\n    52\t    message: makeAssistantMessage({ text: assistantText }),\n    53\t    entryId: `${userText}-assistant`,\n    54\t  });\n    55\t  await connector.handlers.agent_end(ctx, {\n    56\t    messages: [makeUserMessage(userText), makeAssistantMessage({ text: assistantText })],\n    57\t  });\n    58\t}\n    59\t\n    60\tdescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n    61\t  let store: TempStore;\n    62\t  let connector: Connector;\n    63\t  let ctx: ExtensionContext;\n    64\t  let threadRef: ThreadRef | null;\n    65\t\n    66\t  beforeEach(() => {\n    67\t    store = tempStore();\n    68\t    threadRef = null;\n    69\t    ctx = {\n    70\t      cwd: \"/test/closed-loop\",\n    71\t      hasUI: false,\n    72\t      modelRegistry: {\n    73\t        find: (provider: string, model: string) =>\n    74\t          provider === \"openai\" ? { provider, id: model } : undefined,\n    75\t        hasConfiguredAuth: () => true,\n    76\t        getAvailable: () => [{ provider: \"openai\", id: \"good\" }],\n    77\t      },\n    78\t      ui: { notify: () => {} },\n    79\t      sessionManager: { getEntries: () => [] },\n    80\t    };\n    81\t  });\n    82\t\n    83\t  afterEach(async () => {\n    84\t    if (threadRef !== null) {\n    85\t      await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    86\t    }\n    87\t    store.cleanup();\n    88\t  });\n    89\t\n    90\t  it(\"persists one ready form and one classified failed form queryable through inspect/health\", async () => {\n    91\t    const modelCall = fakeModelCallRouter({\n    92\t      \"openai/good\": fakeModelCallText(\"ready derived text\"),\n    93\t      \"openai/fail\": fakeModelCallFailure(\"auth\", \"missing auth\"),\n    94\t    });\n    95\t    const sdkConfig: SdkConfig = {\n    96\t      inference: {\n    97\t        call: modelCall,\n    98\t        assignments: assignments({ turn_rendering: { model: \"fail\" } }),\n    99\t      },\n   100\t      mode: \"background\",\n   101\t      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n   102\t    };\n   103\t\n   104\t    connector = createConnector({\n   105\t      registryPath: store.registryPath,\n   106\t      newThreadFilePath: () => store.threadPath(),\n   107\t      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n   108\t    });\n   109\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n   110\t    const instance = connector.getInstance();\n   111\t    const state = connector.getState();\n   112\t    expect(instance).not.toBeNull();\n   113\t    expect(state).not.toBeNull();\n   114\t    if (instance === null || state === null) return;\n   115\t    threadRef = state.threadRef;\n   116\t\n   117\t    await captureClosedTurn(connector, ctx, \"please summarize this file\", \"here is the summary\");\n   118\t    await instance.sdk.drainSettled(threadRef);\n   119\t\n   120\t    const health = await instance.sdk.inspect.health(threadRef);\n   121\t    expect(health.ok).toBe(true);\n   122\t    if (!health.ok) return;\n   123\t    expect(health.value.owners.some((o) => o.counts.ready > 0)).toBe(true);\n   124\t    expect(health.value.owners).toContainEqual(\n   125\t      expect.objectContaining({\n   126\t        owner: \"turns\",\n   127\t        kind: \"turn_rendering\",\n   128\t        counts: expect.objectContaining({ failed: 1 }),\n   129\t      }),\n   130\t    );\n   131\t    expect(health.value.failures).toContainEqual(\n   132\t      expect.objectContaining({\n   133\t        owner: \"turns\",\n   134\t        form: \"turn_rendering\",\n   135\t        reason: expect.stringContaining(\"auth\"),\n   136\t      }),\n   137\t    );\n   138\t\n   139\t    const overview = await instance.sdk.inspect.overview(threadRef);\n   140\t    expect(overview.ok).toBe(true);\n   141\t    if (overview.ok) {\n   142\t      expect(overview.value.derivation.ready).toBeGreaterThan(0);\n   143\t      expect(overview.value.derivation.failed).toBeGreaterThan(0);\n   144\t    }\n   145\t  }, 30000);\n   146\t\n   147\t  it(\"forces a stale background result and preserves the newer edited form\", async () => {\n   148\t    const firstStarted = deferred<void>();\n   149\t    const releaseFirst = deferred<ModelCallResult>();\n   150\t    let smoothedCalls = 0;\n   151\t    const modelCall: ModelCall = async (input) => {\n   152\t      if (input.model === \"slow-smoothed\") {\n   153\t        smoothedCalls += 1;\n   154\t        if (smoothedCalls === 1) {\n   155\t          firstStarted.resolve();\n   156\t          return releaseFirst.promise;\n   157\t        }\n   158\t        return { ok: true, text: `fresh:${input.messages.map((m) => m.content).join(\"\\n\")}` };\n   159\t      }\n   160\t      return { ok: true, text: \"ready\" };\n   161\t    };\n   162\t    const sdkConfig: SdkConfig = {\n   163\t      inference: {\n   164\t        call: modelCall,\n   165\t        assignments: assignments({ smoothed_prompt: { model: \"slow-smoothed\" } }),\n   166\t      },\n   167\t      mode: \"background\",\n   168\t      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n   169\t    };\n   170\t\n   171\t    connector = createConnector({\n   172\t      registryPath: store.registryPath,\n   173\t      newThreadFilePath: () => store.threadPath(),\n   174\t      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n   175\t    });\n   176\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n   177\t    const instance = connector.getInstance();\n   178\t    const state = connector.getState();\n   179\t    expect(instance).not.toBeNull();\n   180\t    expect(state).not.toBeNull();\n   181\t    if (instance === null || state === null) return;\n   182\t    threadRef = state.threadRef;\n   183\t\n   184\t    await connector.handlers.message_end(ctx, {\n   185\t      message: makeUserMessage(\"first prompt\"),\n   186\t      entryId: \"stale-user\",\n   187\t    });\n   188\t    await firstStarted.promise;\n   189\t    await connector.handlers.message_end(ctx, {\n   190\t      message: makeAssistantMessage({ text: \"first response\" }),\n   191\t      entryId: \"stale-assistant\",\n   192\t    });\n   193\t    await connector.handlers.agent_end(ctx, {\n   194\t      messages: [makeUserMessage(\"first prompt\"), makeAssistantMessage({ text: \"first response\" })],\n   195\t    });\n   196\t\n   197\t    const beforeEdit = await instance.sdk.messages.listMessages(threadRef);\n   198\t    expect(beforeEdit.ok).toBe(true);\n   199\t    if (!beforeEdit.ok) return;\n   200\t    const user = beforeEdit.value.find((message) => message.kind === \"user_prompt\");\n   201\t    expect(user?.messageId).toBe(\"m1\");\n   202\t\n   203\t    const editedText = \"edited prompt wins\";\n   204\t    const edit = await instance.sdk.messages.edit(threadRef, {\n   205\t      messageId: \"m1\",\n   206\t      content: editedText,\n   207\t    });\n   208\t    expect(edit.ok).toBe(true);\n   209\t    if (!edit.ok) return;\n   210\t    expect(edit.value.queued.some((item) => item.workItemId === \"w-m1-prompt_smoothing-v2\")).toBe(true);\n   211\t\n   212\t    releaseFirst.resolve({ ok: true, text: \"STALE SHOULD NOT LAND\" });\n   213\t    await instance.sdk.drainSettled(threadRef);\n   214\t\n   215\t    const afterEdit = await instance.sdk.messages.show(threadRef, \"m1\");\n   216\t    expect(afterEdit.ok).toBe(true);\n   217\t    if (!afterEdit.ok) return;\n   218\t    expect(afterEdit.value.blocks[0]?.content[\"text\"]).toBe(editedText);\n   219\t    const smoothed = afterEdit.value.forms.find((form) => form.form === \"smoothed_prompt\");\n   220\t    expect(smoothed).toEqual(\n   221\t      expect.objectContaining({\n   222\t        state: \"ready\",\n   223\t        sourceVersion: 2,\n   224\t        content: expect.stringContaining(editedText),\n   225\t      }),\n   226\t    );\n   227\t    expect(smoothed?.content).not.toContain(\"STALE SHOULD NOT LAND\");\n   228\t    expect(smoothedCalls).toBeGreaterThanOrEqual(2);\n   229\t  }, 30000);\n   230\t});\n","exit_code":0,"status":"completed"}}

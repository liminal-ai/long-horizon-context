{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/verify/replay.ts | sed -n '320,680p'\"","aggregated_output":"   320\t    }\n   321\t\n   322\t    if (openTurn !== undefined) {\n   323\t      openTurn.memberMessageIds.push(`m${eventOrder}`);\n   324\t    }\n   325\t  }\n   326\t\n   327\t  return records;\n   328\t}\n   329\t\n   330\tfunction comparableTurnRecords(records: readonly TurnRecord[]): ComparableTurnRecord[] {\n   331\t  return records.map((record) => ({\n   332\t    turnId: record.turnId,\n   333\t    status: record.status,\n   334\t    memberMessageIds: record.memberMessageIds,\n   335\t    openedAtEventOrder: record.openedAtEventOrder,\n   336\t    ...(record.closedAtEventOrder === undefined ? {} : { closedAtEventOrder: record.closedAtEventOrder }),\n   337\t  }));\n   338\t}\n   339\t\n   340\t/** Compare the actual read-back (events, plus messages/turns from inspect\n   341\t *  overview) to the fixture's expectation, accumulating a readable diff. Returns\n   342\t *  `null` on a full match. */\n   343\tfunction compareReadback(\n   344\t  corpus: Corpus,\n   345\t  actual: readonly MessageEventInput[],\n   346\t  overview: InspectOverview,\n   347\t  actualMessages: readonly MessageRecord[],\n   348\t  actualTurns: readonly TurnRecord[],\n   349\t): string[] {\n   350\t  const problems: string[] = [];\n   351\t  const expected = corpus.expected;\n   352\t\n   353\t  // Events — kind + payload, in source-event order (never counts alone).\n   354\t  if (actual.length !== expected.length) {\n   355\t    problems.push(`events.count: expected ${expected.length}, got ${actual.length}`);\n   356\t  }\n   357\t  for (let i = 0; i < Math.max(actual.length, expected.length); i += 1) {\n   358\t    const want = expected[i];\n   359\t    const got = actual[i];\n   360\t    if (want === undefined) {\n   361\t      problems.push(`events[${i}]: unexpected extra ${got?.eventKind} ${canonical(got?.payload)}`);\n   362\t      continue;\n   363\t    }\n   364\t    if (got === undefined) {\n   365\t      problems.push(`events[${i}]: missing expected ${want.eventKind} ${canonical(want.payload)}`);\n   366\t      continue;\n   367\t    }\n   368\t    if (got.eventKind !== want.eventKind) {\n   369\t      problems.push(`events[${i}].kind: expected ${want.eventKind}, got ${got.eventKind}`);\n   370\t    } else if (canonical(got.payload) !== canonical(want.payload)) {\n   371\t      problems.push(\n   372\t        `events[${i}].payload (${want.eventKind}): expected ${canonical(want.payload)}, got ${canonical(got.payload)}`,\n   373\t      );\n   374\t    }\n   375\t  }\n   376\t\n   377\t  // Messages — projected counts by kind.\n   378\t  const expectedMsgs = expectedMessages(expected);\n   379\t  if (overview.messages.visible !== expectedMsgs.visible) {\n   380\t    problems.push(`messages.visible: expected ${expectedMsgs.visible}, got ${overview.messages.visible}`);\n   381\t  }\n   382\t  if (canonical(overview.messages.byKind) !== canonical(expectedMsgs.byKind)) {\n   383\t    problems.push(\n   384\t      `messages.byKind: expected ${canonical(expectedMsgs.byKind)}, got ${canonical(overview.messages.byKind)}`,\n   385\t    );\n   386\t  }\n   387\t\n   388\t  // Turns — one closed turn per expected `turn_end`, none left open.\n   389\t  const expectedClosed = expected.filter((event) => event.eventKind === \"turn_end\").length;\n   390\t  if (overview.turns.closed !== expectedClosed) {\n   391\t    problems.push(`turns.closed: expected ${expectedClosed}, got ${overview.turns.closed}`);\n   392\t  }\n   393\t  if (overview.turns.open !== 0) {\n   394\t    problems.push(`turns.open: expected 0, got ${overview.turns.open}`);\n   395\t  }\n   396\t\n   397\t  // Messages — full read-back records implied by the fixture, in source order.\n   398\t  const expectedMessageRows = expectedMessageRecords(expected);\n   399\t  const actualMessageRows = comparableMessageRecords(actualMessages);\n   400\t  if (canonical(actualMessageRows) !== canonical(expectedMessageRows)) {\n   401\t    problems.push(\n   402\t      `messages.records: expected ${canonical(expectedMessageRows)}, got ${canonical(actualMessageRows)}`,\n   403\t    );\n   404\t  }\n   405\t\n   406\t  // Turns — full read-back records implied by fixture event boundaries.\n   407\t  const expectedTurnRows = expectedTurnRecords(expected);\n   408\t  const actualTurnRows = comparableTurnRecords(actualTurns);\n   409\t  if (canonical(actualTurnRows) !== canonical(expectedTurnRows)) {\n   410\t    problems.push(`turns.records: expected ${canonical(expectedTurnRows)}, got ${canonical(actualTurnRows)}`);\n   411\t  }\n   412\t\n   413\t  return problems;\n   414\t}\n   415\t\n   416\t/** Replay a recorded corpus through the converter into the temp thread, then\n   417\t *  compare the durable read-back (events, messages, turns) to the fixture's\n   418\t *  expectation. The thread is left populated so a caller can read inspect's\n   419\t *  overview/health off it (AC-6.3). Deterministic: the same corpus yields the\n   420\t *  same recorded read-back every time (AC-6.2). */\n   421\texport async function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult> {\n   422\t  const instance = buildReplayInstance(threadRef);\n   423\t  const problems: string[] = [];\n   424\t  try {\n   425\t    await driveCorpus(corpus, instance);\n   426\t  } catch (cause) {\n   427\t    problems.push(`replay threw before completion: ${detail(cause)}`);\n   428\t  } finally {\n   429\t    await instance.dispose();\n   430\t  }\n   431\t\n   432\t  const read = await intakeStream.listEvents(threadRef);\n   433\t  if (!read.ok) {\n   434\t    return { matches: false, diff: [...problems, `listEvents failed: ${read.error.reason}`].join(\"\\n\") };\n   435\t  }\n   436\t  const overview = await inspect.overview(threadRef);\n   437\t  if (!overview.ok) {\n   438\t    return { matches: false, diff: [...problems, `inspect.overview failed: ${overview.error.reason}`].join(\"\\n\") };\n   439\t  }\n   440\t  const messageReadback = await messages.listMessages(threadRef);\n   441\t  if (!messageReadback.ok) {\n   442\t    return {\n   443\t      matches: false,\n   444\t      diff: [...problems, `messages.listMessages failed: ${messageReadback.error.reason}`].join(\"\\n\"),\n   445\t    };\n   446\t  }\n   447\t  const turnReadback = await turns.listTurns(threadRef);\n   448\t  if (!turnReadback.ok) {\n   449\t    return {\n   450\t      matches: false,\n   451\t      diff: [...problems, `turns.listTurns failed: ${turnReadback.error.reason}`].join(\"\\n\"),\n   452\t    };\n   453\t  }\n   454\t\n   455\t  problems.push(\n   456\t    ...compareReadback(corpus, logicalEvents(read.value), overview.value, messageReadback.value, turnReadback.value),\n   457\t  );\n   458\t  if (problems.length === 0) return { matches: true };\n   459\t  return { matches: false, diff: problems.join(\"\\n\") };\n   460\t}\n","exit_code":0,"status":"completed"}}

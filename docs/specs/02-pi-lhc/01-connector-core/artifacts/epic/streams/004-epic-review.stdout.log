{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2cd7faf744e24751bca2b302","type":"tool_result","content":"1\t// TC-4.5: closed-loop proof through the PI connector hooks.\n2\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n3\timport {\n4\t  DEFAULT_PROMPT_NAMES,\n5\t  type FormKind,\n6\t  type ModelAssignment,\n7\t  type ModelCall,\n8\t  type ModelCallResult,\n9\t  type SdkConfig,\n10\t  type ThreadRef,\n11\t} from \"lhc\";\n12\timport { createConnector, type Connector } from \"../../src/index.js\";\n13\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n14\timport { makeAssistantMessage, makeUserMessage } from \"../fixtures/synthetic.js\";\n15\timport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"../fixtures/model-call.js\";\n16\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n17\t\n18\ttype Deferred<T> = { promise: Promise<T>; resolve: (value: T) => void };\n19\t\n20\tfunction deferred<T>(): Deferred<T> {\n21\t  let resolve!: (value: T) => void;\n22\t  const promise = new Promise<T>((res) => {\n23\t    resolve = res;\n24\t  });\n25\t  return { promise, resolve };\n26\t}\n27\t\n28\tfunction assignments(overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {}): Record<FormKind, ModelAssignment> {\n29\t  const base = { provider: \"openai\", model: \"good\" };\n30\t  return {\n31\t    smoothed_prompt: { ...base, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt, ...(overrides.smoothed_prompt ?? {}) },\n32\t    tool_call_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary, ...(overrides.tool_call_summary ?? {}) },\n33\t    tool_result_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary, ...(overrides.tool_result_summary ?? {}) },\n34\t    turn_rendering: { ...base, prompt: DEFAULT_PROMPT_NAMES.turn_rendering, ...(overrides.turn_rendering ?? {}) },\n35\t    lower_band_projection: { ...base, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection, ...(overrides.lower_band_projection ?? {}) },\n36\t    chunk_summary_detailed: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed, ...(overrides.chunk_summary_detailed ?? {}) },\n37\t    chunk_summary_brief: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief, ...(overrides.chunk_summary_brief ?? {}) },\n38\t  };\n39\t}\n40\t\n41\tasync function captureClosedTurn(\n42\t  connector: Connector,\n43\t  ctx: ExtensionContext,\n44\t  userText: string,\n45\t  assistantText: string,\n46\t): Promise<void> {\n47\t  await connector.handlers.message_end(ctx, {\n48\t    message: makeUserMessage(userText),\n49\t    entryId: `${userText}-user`,\n50\t  });\n51\t  await connector.handlers.message_end(ctx, {\n52\t    message: makeAssistantMessage({ text: assistantText }),\n53\t    entryId: `${userText}-assistant`,\n54\t  });\n55\t  await connector.handlers.agent_end(ctx, {\n56\t    messages: [makeUserMessage(userText), makeAssistantMessage({ text: assistantText })],\n57\t  });\n58\t}\n59\t\n60\tdescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n61\t  let store: TempStore;\n62\t  let connector: Connector;\n63\t  let ctx: ExtensionContext;\n64\t  let threadRef: ThreadRef | null;\n65\t\n66\t  beforeEach(() => {\n67\t    store = tempStore();\n68\t    threadRef = null;\n69\t    ctx = {\n70\t      cwd: \"/test/closed-loop\",\n71\t      hasUI: false,\n72\t      modelRegistry: {\n73\t        find: (provider: string, model: string) =>\n74\t          provider === \"openai\" ? { provider, id: model } : undefined,\n75\t        hasConfiguredAuth: () => true,\n76\t        getAvailable: () => [{ provider: \"openai\", id: \"good\" }],\n77\t      },\n78\t      ui: { notify: () => {} },\n79\t      sessionManager: { getEntries: () => [] },\n80\t    };\n81\t  });\n82\t\n83\t  afterEach(async () => {\n84\t    if (threadRef !== null) {\n85\t      await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n86\t    }\n87\t    store.cleanup();\n88\t  });\n89\t\n90\t  it(\"persists one ready form and one classified failed form queryable through inspect/health\", async () => {\n91\t    const modelCall = fakeModelCallRouter({\n92\t      \"openai/good\": fakeModelCallText(\"ready derived text\"),\n93\t      \"openai/fail\": fakeModelCallFailure(\"auth\", \"missing auth\"),\n94\t    });\n95\t    const sdkConfig: SdkConfig = {\n96\t      inference: {\n97\t        call: modelCall,\n98\t        assignments: assignments({ turn_rendering: { model: \"fail\" } }),\n99\t      },\n100\t      mode: \"background\",\n101\t      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n102\t    };\n103\t\n104\t    connector = createConnector({\n105\t      registryPath: store.registryPath,\n106\t      newThreadFilePath: () => store.threadPath(),\n107\t      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n108\t    });\n109\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n110\t    const instance = connector.getInstance();\n111\t    const state = connector.getState();\n112\t    expect(instance).not.toBeNull();\n113\t    expect(state).not.toBeNull();\n114\t    if (instance === null || state === null) return;\n115\t    threadRef = state.threadRef;\n116\t\n117\t    await captureClosedTurn(connector, ctx, \"please summarize this file\", \"here is the summary\");\n118\t    await instance.sdk.drainSettled(threadRef);\n119\t\n120\t    const health = await instance.sdk.inspect.health(threadRef);\n121\t    expect(health.ok).toBe(true);\n122\t    if (!health.ok) return;\n123\t    expect(health.value.owners.some((o) => o.counts.ready > 0)).toBe(true);\n124\t    expect(health.value.owners).toContainEqual(\n125\t      expect.objectContaining({\n126\t        owner: \"turns\",\n127\t        kind: \"turn_rendering\",\n128\t        counts: expect.objectContaining({ failed: 1 }),\n129\t      }),\n130\t    );\n131\t    expect(health.value.failures).toContainEqual(\n132\t      expect.objectContaining({\n133\t        owner: \"turns\",\n134\t        form: \"turn_rendering\",\n135\t        reason: expect.stringContaining(\"auth\"),\n136\t      }),\n137\t    );\n138\t\n139\t    const overview = await instance.sdk.inspect.overview(threadRef);\n140\t    expect(overview.ok).toBe(true);\n141\t    if (overview.ok) {\n142\t      expect(overview.value.derivation.ready).toBeGreaterThan(0);\n143\t      expect(overview.value.derivation.failed).toBeGreaterThan(0);\n144\t    }\n145\t  }, 30000);\n146\t\n147\t  it(\"forces a stale background result and preserves the newer edited form\", async () => {\n148\t    const firstStarted = deferred<void>();\n149\t    const releaseFirst = deferred<ModelCallResult>();\n150\t    let smoothedCalls = 0;\n151\t    const modelCall: ModelCall = async (input) => {\n152\t      if (input.model === \"slow-smoothed\") {\n153\t        smoothedCalls += 1;\n154\t        if (smoothedCalls === 1) {\n155\t          firstStarted.resolve();\n156\t          return releaseFirst.promise;\n157\t        }\n158\t        return { ok: true, text: `fresh:${input.messages.map((m) => m.content).join(\"\\n\")}` };\n159\t      }\n160\t      return { ok: true, text: \"ready\" };\n161\t    };\n162\t    const sdkConfig: SdkConfig = {\n163\t      inference: {\n164\t        call: modelCall,\n165\t        assignments: assignments({ smoothed_prompt: { model: \"slow-smoothed\" } }),\n166\t      },\n167\t      mode: \"background\",\n168\t      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n169\t    };\n170\t\n171\t    connector = createConnector({\n172\t      registryPath: store.registryPath,\n173\t      newThreadFilePath: () => store.threadPath(),\n174\t      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n175\t    });\n176\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n177\t    const instance = connector.getInstance();\n178\t    const state = connector.getState();\n179\t    expect(instance).not.toBeNull();\n180\t    expect(state).not.toBeNull();\n181\t    if (instance === null || state === null) return;\n182\t    threadRef = state.threadRef;\n183\t\n184\t    await connector.handlers.message_end(ctx, {\n185\t      message: makeUserMessage(\"first prompt\"),\n186\t      entryId: \"stale-user\",\n187\t    });\n188\t    await firstStarted.promise;\n189\t    await connector.handlers.message_end(ctx, {\n190\t      message: makeAssistantMessage({ text: \"first response\" }),\n191\t      entryId: \"stale-assistant\",\n192\t    });\n193\t    await connector.handlers.agent_end(ctx, {\n194\t      messages: [makeUserMessage(\"first prompt\"), makeAssistantMessage({ text: \"first response\" })],\n195\t    });\n196\t\n197\t    const beforeEdit = await instance.sdk.messages.listMessages(threadRef);\n198\t    expect(beforeEdit.ok).toBe(true);\n199\t    if (!beforeEdit.ok) return;\n200\t    const user = beforeEdit.value.find((message) => message.kind === \"user_prompt\");\n201\t    expect(user?.messageId).toBe(\"m1\");\n202\t\n203\t    const editedText = \"edited prompt wins\";\n204\t    const edit = await instance.sdk.messages.edit(threadRef, {\n205\t      messageId: \"m1\",\n206\t      content: editedText,\n207\t    });\n208\t    expect(edit.ok).toBe(true);\n209\t    if (!edit.ok) return;\n210\t    expect(edit.value.queued.some((item) => item.workItemId === \"w-m1-prompt_smoothing-v2\")).toBe(true);\n211\t\n212\t    releaseFirst.resolve({ ok: true, text: \"STALE SHOULD NOT LAND\" });\n213\t    await instance.sdk.drainSettled(threadRef);\n214\t\n215\t    const afterEdit = await instance.sdk.messages.show(threadRef, \"m1\");\n216\t    expect(afterEdit.ok).toBe(true);\n217\t    if (!afterEdit.ok) return;\n218\t    expect(afterEdit.value.blocks[0]?.content[\"text\"]).toBe(editedText);\n219\t    const smoothed = afterEdit.value.forms.find((form) => form.form === \"smoothed_prompt\");\n220\t    expect(smoothed).toEqual(\n221\t      expect.objectContaining({\n222\t        state: \"ready\",\n223\t        sourceVersion: 2,\n224\t        content: expect.stringContaining(editedText),\n225\t      }),\n226\t    );\n227\t    expect(smoothed?.content).not.toContain(\"STALE SHOULD NOT LAND\");\n228\t    expect(smoothedCalls).toBeGreaterThanOrEqual(2);\n229\t  }, 30000);\n230\t});\n231\t"}]},"parent_tool_use_id":null,"session_id":"d8b1b04c-6358-4278-8fe4-779266fa40d8","uuid":"15d9540a-5531-427c-ae10-2d6347dd2f12","timestamp":"2026-06-14T13:54:12.831Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts","content":"// TC-4.5: closed-loop proof through the PI connector hooks.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  DEFAULT_PROMPT_NAMES,\n  type FormKind,\n  type ModelAssignment,\n  type ModelCall,\n  type ModelCallResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { makeAssistantMessage, makeUserMessage } from \"../fixtures/synthetic.js\";\nimport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"../fixtures/model-call.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\ntype Deferred<T> = { promise: Promise<T>; resolve: (value: T) => void };\n\nfunction deferred<T>(): Deferred<T> {\n  let resolve!: (value: T) => void;\n  const promise = new Promise<T>((res) => {\n    resolve = res;\n  });\n  return { promise, resolve };\n}\n\nfunction assignments(overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {}): Record<FormKind, ModelAssignment> {\n  const base = { provider: \"openai\", model: \"good\" };\n  return {\n    smoothed_prompt: { ...base, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt, ...(overrides.smoothed_prompt ?? {}) },\n    tool_call_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary, ...(overrides.tool_call_summary ?? {}) },\n    tool_result_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary, ...(overrides.tool_result_summary ?? {}) },\n    turn_rendering: { ...base, prompt: DEFAULT_PROMPT_NAMES.turn_rendering, ...(overrides.turn_rendering ?? {}) },\n    lower_band_projection: { ...base, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection, ...(overrides.lower_band_projection ?? {}) },\n    chunk_summary_detailed: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed, ...(overrides.chunk_summary_detailed ?? {}) },\n    chunk_summary_brief: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief, ...(overrides.chunk_summary_brief ?? {}) },\n  };\n}\n\nasync function captureClosedTurn(\n  connector: Connector,\n  ctx: ExtensionContext,\n  userText: string,\n  assistantText: string,\n): Promise<void> {\n  await connector.handlers.message_end(ctx, {\n    message: makeUserMessage(userText),\n    entryId: `${userText}-user`,\n  });\n  await connector.handlers.message_end(ctx, {\n    message: makeAssistantMessage({ text: assistantText }),\n    entryId: `${userText}-assistant`,\n  });\n  await connector.handlers.agent_end(ctx, {\n    messages: [makeUserMessage(userText), makeAssistantMessage({ text: assistantText })],\n  });\n}\n\ndescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n  let store: TempStore;\n  let connector: Connector;\n  let ctx: ExtensionContext;\n  let threadRef: ThreadRef | null;\n\n  beforeEach(() => {\n    store = tempStore();\n    threadRef = null;\n    ctx = {\n      cwd: \"/test/closed-loop\",\n      hasUI: false,\n      modelRegistry: {\n        find: (provider: string, model: string) =>\n          provider === \"openai\" ? { provider, id: model } : undefined,\n        hasConfiguredAuth: () => true,\n        getAvailable: () => [{ provider: \"openai\", id: \"good\" }],\n      },\n      ui: { notify: () => {} },\n      sessionManager: { getEntries: () => [] },\n    };\n  });\n\n  afterEach(async () => {\n    if (threadRef !== null) {\n      await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    }\n    store.cleanup();\n  });\n\n  it(\"persists one ready form and one classified failed form queryable through inspect/health\", async () => {\n    const modelCall = fakeModelCallRouter({\n      \"openai/good\": fakeModelCallText(\"ready derived text\"),\n      \"openai/fail\": fakeModelCallFailure(\"auth\", \"missing auth\"),\n    });\n    const sdkConfig: SdkConfig = {\n      inference: {\n        call: modelCall,\n        assignments: assignments({ turn_rendering: { model: \"fail\" } }),\n      },\n      mode: \"background\",\n      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n    };\n\n    connector = createConnector({\n      registryPath: store.registryPath,\n      newThreadFilePath: () => store.threadPath(),\n      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n    });\n    await connector.handlers.session_start(ctx, { reason: \"new\" });\n    const instance = connector.getInstance();\n    const state = connector.getState();\n    expect(instance).not.toBeNull();\n    expect(state).not.toBeNull();\n    if (instance === null || state === null) return;\n    threadRef = state.threadRef;\n\n    await captureClosedTurn(connector, ctx, \"please summarize this file\", \"here is the summary\");\n    await instance.sdk.drainSettled(threadRef);\n\n    const health = await instance.sdk.inspect.health(threadRef);\n    expect(health.ok).toBe(true);\n    if (!health.ok) return;\n    expect(health.value.owners.some((o) => o.counts.ready > 0)).toBe(true);\n    expect(health.value.owners).toContainEqual(\n      expect.objectContaining({\n        owner: \"turns\",\n        kind: \"turn_rendering\",\n        counts: expect.objectContaining({ failed: 1 }),\n      }),\n    );\n    expect(health.value.failures).toContainEqual(\n      expect.objectContaining({\n        owner: \"turns\",\n        form: \"turn_rendering\",\n        reason: expect.stringContaining(\"auth\"),\n      }),\n    );\n\n    const overview = await instance.sdk.inspect.overview(threadRef);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) {\n      expect(overview.value.derivation.ready).toBeGreaterThan(0);\n      expect(overview.value.derivation.failed).toBeGreaterThan(0);\n    }\n  }, 30000);\n\n  it(\"forces a stale background result and preserves the newer edited form\", async () => {\n    const firstStarted = deferred<void>();\n    const releaseFirst = deferred<ModelCallResult>();\n    let smoothedCalls = 0;\n    const modelCall: ModelCall = async (input) => {\n      if (input.model === \"slow-smoothed\") {\n        smoothedCalls += 1;\n        if (smoothedCalls === 1) {\n          firstStarted.resolve();\n          return releaseFirst.promise;\n        }\n        return { ok: true, text: `fresh:${input.messages.map((m) => m.content).join(\"\\n\")}` };\n      }\n      return { ok: true, text: \"ready\" };\n    };\n    const sdkConfig: SdkConfig = {\n      inference: {\n        call: modelCall,\n        assignments: assignments({ smoothed_prompt: { model: \"slow-smoothed\" } }),\n      },\n      mode: \"background\",\n      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n    };\n\n    connector = createConnector({\n      registryPath: store.registryPath,\n      newThreadFilePath: () => store.threadPath(),\n      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n    });\n    await connector.handlers.session_start(ctx, { reason: \"new\" });\n    const instance = connector.getInstance();\n    const state = connector.getState();\n    expect(instance).not.toBeNull();\n    expect(state).not.toBeNull();\n    if (instance === null || state === null) return;\n    threadRef = state.threadRef;\n\n    await connector.handlers.message_end(ctx, {\n      message: makeUserMessage(\"first prompt\"),\n      entryId: \"stale-user\",\n    });\n    await firstStarted.promise;\n    await connector.handlers.message_end(ctx, {\n      message: makeAssistantMessage({ text: \"first response\" }),\n      entryId: \"stale-assistant\",\n    });\n    await connector.handlers.agent_end(ctx, {\n      messages: [makeUserMessage(\"first prompt\"), makeAssistantMessage({ text: \"first response\" })],\n    });\n\n    const beforeEdit = await instance.sdk.messages.listMessages(threadRef);\n    expect(beforeEdit.ok).toBe(true);\n    if (!beforeEdit.ok) return;\n    const user = beforeEdit.value.find((message) => message.kind === \"user_prompt\");\n    expect(user?.messageId).toBe(\"m1\");\n\n    const editedText = \"edited prompt wins\";\n    const edit = await instance.sdk.messages.edit(threadRef, {\n      messageId: \"m1\",\n      content: editedText,\n    });\n    expect(edit.ok).toBe(true);\n    if (!edit.ok) return;\n    expect(edit.value.queued.some((item) => item.workItemId === \"w-m1-prompt_smoothing-v2\")).toBe(true);\n\n    releaseFirst.resolve({ ok: true, text: \"STALE SHOULD NOT LAND\" });\n    await instance.sdk.drainSettled(threadRef);\n\n    const afterEdit = await instance.sdk.messages.show(threadRef, \"m1\");\n    expect(afterEdit.ok).toBe(true);\n    if (!afterEdit.ok) return;\n    expect(afterEdit.value.blocks[0]?.content[\"text\"]).toBe(editedText);\n    const smoothed = afterEdit.value.forms.find((form) => form.form === \"smoothed_prompt\");\n    expect(smoothed).toEqual(\n      expect.objectContaining({\n        state: \"ready\",\n        sourceVersion: 2,\n        content: expect.stringContaining(editedText),\n      }),\n    );\n    expect(smoothed?.content).not.toContain(\"STALE SHOULD NOT LAND\");\n    expect(smoothedCalls).toBeGreaterThanOrEqual(2);\n  }, 30000);\n});\n","numLines":231,"startLine":1,"totalLines":231}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_79b84fd88ab043dbb6104a85","type":"tool_result","content":"1\t// Story 3 — capture verification (Flow 6). Capture correctness is proven\n2\t// WITHOUT serving anything to a model: each recorded corpus replays through the\n3\t// REAL converter + intake path into a temp SQLite thread, and the durable\n4\t// read-back is compared to the fixture. These tests assert on recorded thread\n5\t// state through `replayCorpus` and the live inspect surfaces — never on a\n6\t// mocked intake, and never by writing the fixture's expected events directly\n7\t// (story §Anti-Shim Requirements).\n8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n9\timport {\n10\t  createDeterministicProvider,\n11\t  createSdk,\n12\t  inspect,\n13\t  intakeStream,\n14\t  type EventRecord,\n15\t  type MessageEventInput,\n16\t  type ThreadRef,\n17\t} from \"lhc\";\n18\timport { replayCorpus } from \"../../src/verify/replay.js\";\n19\timport { capture } from \"../../src/capture/converter.js\";\n20\timport type { LhcInstance } from \"../../src/shared/instance.js\";\n21\timport {\n22\t  CORPUS_LOADERS,\n23\t  loadChattyCorpus,\n24\t  loadToolHeavyCorpus,\n25\t  type CorpusName,\n26\t} from \"../fixtures/corpus.js\";\n27\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n28\t\n29\tlet store: TempStore;\n30\tbeforeEach(() => {\n31\t  store = tempStore();\n32\t});\n33\tafterEach(() => {\n34\t  store.cleanup();\n35\t});\n36\t\n37\tconst CORPUS_NAMES = Object.keys(CORPUS_LOADERS) as CorpusName[];\n38\t\n39\t/** The logical read-back: server-stamped `eventOrder`/`recordedAt` dropped, the\n40\t *  converter's real (deterministic) idempotency key kept — so two replays are\n41\t *  comparable for ID + order stability (AC-6.2). */\n42\tfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n43\t  return records.map(\n44\t    (record) =>\n45\t      ({\n46\t        eventKind: record.eventKind,\n47\t        idempotencyKey: record.idempotencyKey,\n48\t        actor: record.actor,\n49\t        harness: record.harness,\n50\t        payload: record.payload,\n51\t      }) as MessageEventInput,\n52\t  );\n53\t}\n54\t\n55\tasync function readBack(threadRef: ThreadRef): Promise<MessageEventInput[]> {\n56\t  const read = await intakeStream.listEvents(threadRef);\n57\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n58\t  return logicalEvents(read.value);\n59\t}\n60\t\n61\t/** A real background instance for inducing a Story-2 capture failure (the gap\n62\t *  path does not call the provider, so the deterministic one is fine). */\n63\tfunction liveInstance(threadRef: ThreadRef): LhcInstance {\n64\t  const sdk = createSdk({ provider: createDeterministicProvider(), mode: \"background\" });\n65\t  return {\n66\t    sdk,\n67\t    threadRef,\n68\t    dispose: async () => {\n69\t      await sdk.drainSettled(threadRef);\n70\t      return { ok: true, value: undefined };\n71\t    },\n72\t  };\n73\t}\n74\t\n75\t// ── TC-6.1: each corpus replays to a read-back matching the fixture ──────────\n76\tdescribe.each(CORPUS_NAMES)(\"Story 3: corpus replay read-back (TC-6.1) — %s\", (name) => {\n77\t  it(\"replays through the real converter to a thread whose events/messages/turns match the fixture\", async () => {\n78\t    const corpus = CORPUS_LOADERS[name]();\n79\t    const thread = await makeTempThread(store);\n80\t\n81\t    const result = await replayCorpus(corpus, thread.threadRef);\n82\t\n83\t    // toEqual surfaces the structured diff on the actual object when it fails.\n84\t    expect(result).toEqual({ matches: true });\n85\t\n86\t    // The recorded events are the corpus's expected kinds, in order — proven\n87\t    // against the durable thread, not the in-memory return value.\n88\t    const recorded = await readBack(thread.threadRef);\n89\t    expect(recorded.map((event) => event.eventKind)).toEqual(\n90\t      corpus.expected.map((event) => event.eventKind),\n91\t    );\n92\t  });\n93\t});\n94\t\n95\t// ── TC-6.2: deterministic re-replay (IDs and order stable) ───────────────────\n96\tdescribe(\"Story 3: deterministic re-replay (TC-6.2)\", () => {\n97\t  it(\"replays the same corpus into two fresh threads to byte-identical read-back — real, stable idempotency keys\", async () => {\n98\t    // tool-heavy carries tool_call/tool_result correlation ids, so this also\n99\t    // pins ID stability through the correlation path, not just text events.\n100\t    const corpus = loadToolHeavyCorpus();\n101\t    const threadA = await makeTempThread(store);\n102\t    const threadB = await makeTempThread(store);\n103\t\n104\t    expect(await replayCorpus(corpus, threadA.threadRef)).toEqual({ matches: true });\n105\t    expect(await replayCorpus(corpus, threadB.threadRef)).toEqual({ matches: true });\n106\t\n107\t    const readA = await readBack(threadA.threadRef);\n108\t    const readB = await readBack(threadB.threadRef);\n109\t\n110\t    // Identical read-back: same events, same order, same idempotency keys.\n111\t    expect(readA).toEqual(readB);\n112\t    // The keys are the converter's real deterministic keys, not placeholders.\n113\t    expect(readA.every((event) => event.idempotencyKey.startsWith(\"pi:replay:tool-heavy\"))).toBe(true);\n114\t    expect(new Set(readA.map((event) => event.idempotencyKey)).size).toBe(readA.length);\n115\t  });\n116\t\n117\t  it(\"re-replaying the same corpus into the SAME thread does not perturb the read-back (deterministic keys dedup)\", async () => {\n118\t    const corpus = loadChattyCorpus();\n119\t    const thread = await makeTempThread(store);\n120\t\n121\t    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n122\t    const first = await readBack(thread.threadRef);\n123\t\n124\t    // A second replay re-delivers identical keys; the SDK dedups them, so the\n125\t    // read-back is unchanged — re-replay perturbs neither IDs nor order.\n126\t    const second = await replayCorpus(corpus, thread.threadRef);\n127\t    expect(second).toEqual({ matches: true });\n128\t    expect(await readBack(thread.threadRef)).toEqual(first);\n129\t  });\n130\t});\n131\t\n132\t// ── TC-6.3: inspect overview/health reflect the captured session ─────────────\n133\tdescribe(\"Story 3: inspect overview/health reflect the captured session (TC-6.3)\", () => {\n134\t  it(\"reports event/message counts, last recorded position, gaps, and failed derivations\", async () => {\n135\t    const corpus = loadToolHeavyCorpus(); // 6 events → 5 messages, 1 closed turn\n136\t    const thread = await makeTempThread(store);\n137\t\n138\t    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n139\t\n140\t    // Counts + last recorded position, cross-checked against the event log.\n141\t    const overview1 = await inspect.overview(thread.threadRef);\n142\t    expect(overview1.ok).toBe(true);\n143\t    if (!overview1.ok) return;\n144\t    const recorded = await intakeStream.listEvents(thread.threadRef);\n145\t    expect(recorded.ok).toBe(true);\n146\t    if (!recorded.ok) return;\n147\t    const lastOrder = recorded.value.at(-1)?.eventOrder;\n148\t\n149\t    expect(overview1.value.events.count).toBe(corpus.expected.length); // 6\n150\t    expect(overview1.value.events.span?.last).toBe(lastOrder); // last recorded position, surfaced\n151\t    expect(overview1.value.messages.visible).toBe(5);\n152\t    expect(overview1.value.messages.byKind).toEqual({\n153\t      user_prompt: 1,\n154\t      assistant_thinking: 1,\n155\t      tool_call: 1,\n156\t      tool_result: 1,\n157\t      assistant_text: 1,\n158\t    });\n159\t    expect(overview1.value.turns.closed).toBe(1);\n160\t    expect(overview1.value.turns.open).toBe(0);\n161\t\n162\t    // Failed derivations are visible, not hidden: Epic-1 replay is observe-only\n163\t    // (inference fails closed), so the queued derivations land failed.\n164\t    expect(overview1.value.derivation.failed).toBeGreaterThan(0);\n165\t    const health1 = await inspect.health(thread.threadRef);\n166\t    expect(health1.ok).toBe(true);\n167\t    if (!health1.ok) return;\n168\t    expect(health1.value.failures.length).toBeGreaterThan(0);\n169\t\n170\t    // A capture gap is visible, not hidden — induce one through the Story-2\n171\t    // capture path (a turn_end with a non-empty payload is rejected as\n172\t    // invalid_event, which records a durable gap note).\n173\t    const instance = liveInstance(thread.threadRef);\n174\t    const malformed = {\n175\t      eventKind: \"turn_end\",\n176\t      idempotencyKey: \"replay-induced-gap\",\n177\t      actor: \"system\",\n178\t      harness: \"pi\",\n179\t      payload: { stowaway: true },\n180\t    } as unknown as MessageEventInput;\n181\t    const gapResult = await capture([malformed], instance);\n182\t    expect(gapResult.ok).toBe(false);\n183\t    await instance.dispose();\n184\t\n185\t    const health2 = await inspect.health(thread.threadRef);\n186\t    expect(health2.ok).toBe(true);\n187\t    if (!health2.ok) return;\n188\t    expect(\n189\t      health2.value.owners.some((owner) => owner.kind === \"capture_gap\" && owner.counts.failed > 0),\n190\t    ).toBe(true);\n191\t    expect(health2.value.failures.some((failure) => failure.form === \"capture_gap\")).toBe(true);\n192\t\n193\t    // The gap note is itself a recorded event — the last recorded position\n194\t    // advances, proving the surface reflects new capture rather than a snapshot.\n195\t    const overview2 = await inspect.overview(thread.threadRef);\n196\t    expect(overview2.ok).toBe(true);\n197\t    if (!overview2.ok) return;\n198\t    expect(overview2.value.events.count).toBe(corpus.expected.length + 1);\n199\t    expect(overview2.value.events.span?.last).toBeGreaterThan(overview1.value.events.span?.last ?? 0);\n200\t  });\n201\t});\n202\t"}]},"parent_tool_use_id":null,"session_id":"d8b1b04c-6358-4278-8fe4-779266fa40d8","uuid":"5257d9d8-7bb6-4610-a3ee-433e38eea386","timestamp":"2026-06-14T13:54:12.833Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/verify/replay.test.ts","content":"// Story 3 — capture verification (Flow 6). Capture correctness is proven\n// WITHOUT serving anything to a model: each recorded corpus replays through the\n// REAL converter + intake path into a temp SQLite thread, and the durable\n// read-back is compared to the fixture. These tests assert on recorded thread\n// state through `replayCorpus` and the live inspect surfaces — never on a\n// mocked intake, and never by writing the fixture's expected events directly\n// (story §Anti-Shim Requirements).\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  createSdk,\n  inspect,\n  intakeStream,\n  type EventRecord,\n  type MessageEventInput,\n  type ThreadRef,\n} from \"lhc\";\nimport { replayCorpus } from \"../../src/verify/replay.js\";\nimport { capture } from \"../../src/capture/converter.js\";\nimport type { LhcInstance } from \"../../src/shared/instance.js\";\nimport {\n  CORPUS_LOADERS,\n  loadChattyCorpus,\n  loadToolHeavyCorpus,\n  type CorpusName,\n} from \"../fixtures/corpus.js\";\nimport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nconst CORPUS_NAMES = Object.keys(CORPUS_LOADERS) as CorpusName[];\n\n/** The logical read-back: server-stamped `eventOrder`/`recordedAt` dropped, the\n *  converter's real (deterministic) idempotency key kept — so two replays are\n *  comparable for ID + order stability (AC-6.2). */\nfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n  return records.map(\n    (record) =>\n      ({\n        eventKind: record.eventKind,\n        idempotencyKey: record.idempotencyKey,\n        actor: record.actor,\n        harness: record.harness,\n        payload: record.payload,\n      }) as MessageEventInput,\n  );\n}\n\nasync function readBack(threadRef: ThreadRef): Promise<MessageEventInput[]> {\n  const read = await intakeStream.listEvents(threadRef);\n  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n  return logicalEvents(read.value);\n}\n\n/** A real background instance for inducing a Story-2 capture failure (the gap\n *  path does not call the provider, so the deterministic one is fine). */\nfunction liveInstance(threadRef: ThreadRef): LhcInstance {\n  const sdk = createSdk({ provider: createDeterministicProvider(), mode: \"background\" });\n  return {\n    sdk,\n    threadRef,\n    dispose: async () => {\n      await sdk.drainSettled(threadRef);\n      return { ok: true, value: undefined };\n    },\n  };\n}\n\n// ── TC-6.1: each corpus replays to a read-back matching the fixture ──────────\ndescribe.each(CORPUS_NAMES)(\"Story 3: corpus replay read-back (TC-6.1) — %s\", (name) => {\n  it(\"replays through the real converter to a thread whose events/messages/turns match the fixture\", async () => {\n    const corpus = CORPUS_LOADERS[name]();\n    const thread = await makeTempThread(store);\n\n    const result = await replayCorpus(corpus, thread.threadRef);\n\n    // toEqual surfaces the structured diff on the actual object when it fails.\n    expect(result).toEqual({ matches: true });\n\n    // The recorded events are the corpus's expected kinds, in order — proven\n    // against the durable thread, not the in-memory return value.\n    const recorded = await readBack(thread.threadRef);\n    expect(recorded.map((event) => event.eventKind)).toEqual(\n      corpus.expected.map((event) => event.eventKind),\n    );\n  });\n});\n\n// ── TC-6.2: deterministic re-replay (IDs and order stable) ───────────────────\ndescribe(\"Story 3: deterministic re-replay (TC-6.2)\", () => {\n  it(\"replays the same corpus into two fresh threads to byte-identical read-back — real, stable idempotency keys\", async () => {\n    // tool-heavy carries tool_call/tool_result correlation ids, so this also\n    // pins ID stability through the correlation path, not just text events.\n    const corpus = loadToolHeavyCorpus();\n    const threadA = await makeTempThread(store);\n    const threadB = await makeTempThread(store);\n\n    expect(await replayCorpus(corpus, threadA.threadRef)).toEqual({ matches: true });\n    expect(await replayCorpus(corpus, threadB.threadRef)).toEqual({ matches: true });\n\n    const readA = await readBack(threadA.threadRef);\n    const readB = await readBack(threadB.threadRef);\n\n    // Identical read-back: same events, same order, same idempotency keys.\n    expect(readA).toEqual(readB);\n    // The keys are the converter's real deterministic keys, not placeholders.\n    expect(readA.every((event) => event.idempotencyKey.startsWith(\"pi:replay:tool-heavy\"))).toBe(true);\n    expect(new Set(readA.map((event) => event.idempotencyKey)).size).toBe(readA.length);\n  });\n\n  it(\"re-replaying the same corpus into the SAME thread does not perturb the read-back (deterministic keys dedup)\", async () => {\n    const corpus = loadChattyCorpus();\n    const thread = await makeTempThread(store);\n\n    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n    const first = await readBack(thread.threadRef);\n\n    // A second replay re-delivers identical keys; the SDK dedups them, so the\n    // read-back is unchanged — re-replay perturbs neither IDs nor order.\n    const second = await replayCorpus(corpus, thread.threadRef);\n    expect(second).toEqual({ matches: true });\n    expect(await readBack(thread.threadRef)).toEqual(first);\n  });\n});\n\n// ── TC-6.3: inspect overview/health reflect the captured session ─────────────\ndescribe(\"Story 3: inspect overview/health reflect the captured session (TC-6.3)\", () => {\n  it(\"reports event/message counts, last recorded position, gaps, and failed derivations\", async () => {\n    const corpus = loadToolHeavyCorpus(); // 6 events → 5 messages, 1 closed turn\n    const thread = await makeTempThread(store);\n\n    expect(await replayCorpus(corpus, thread.threadRef)).toEqual({ matches: true });\n\n    // Counts + last recorded position, cross-checked against the event log.\n    const overview1 = await inspect.overview(thread.threadRef);\n    expect(overview1.ok).toBe(true);\n    if (!overview1.ok) return;\n    const recorded = await intakeStream.listEvents(thread.threadRef);\n    expect(recorded.ok).toBe(true);\n    if (!recorded.ok) return;\n    const lastOrder = recorded.value.at(-1)?.eventOrder;\n\n    expect(overview1.value.events.count).toBe(corpus.expected.length); // 6\n    expect(overview1.value.events.span?.last).toBe(lastOrder); // last recorded position, surfaced\n    expect(overview1.value.messages.visible).toBe(5);\n    expect(overview1.value.messages.byKind).toEqual({\n      user_prompt: 1,\n      assistant_thinking: 1,\n      tool_call: 1,\n      tool_result: 1,\n      assistant_text: 1,\n    });\n    expect(overview1.value.turns.closed).toBe(1);\n    expect(overview1.value.turns.open).toBe(0);\n\n    // Failed derivations are visible, not hidden: Epic-1 replay is observe-only\n    // (inference fails closed), so the queued derivations land failed.\n    expect(overview1.value.derivation.failed).toBeGreaterThan(0);\n    const health1 = await inspect.health(thread.threadRef);\n    expect(health1.ok).toBe(true);\n    if (!health1.ok) return;\n    expect(health1.value.failures.length).toBeGreaterThan(0);\n\n    // A capture gap is visible, not hidden — induce one through the Story-2\n    // capture path (a turn_end with a non-empty payload is rejected as\n    // invalid_event, which records a durable gap note).\n    const instance = liveInstance(thread.threadRef);\n    const malformed = {\n      eventKind: \"turn_end\",\n      idempotencyKey: \"replay-induced-gap\",\n      actor: \"system\",\n      harness: \"pi\",\n      payload: { stowaway: true },\n    } as unknown as MessageEventInput;\n    const gapResult = await capture([malformed], instance);\n    expect(gapResult.ok).toBe(false);\n    await instance.dispose();\n\n    const health2 = await inspect.health(thread.threadRef);\n    expect(health2.ok).toBe(true);\n    if (!health2.ok) return;\n    expect(\n      health2.value.owners.some((owner) => owner.kind === \"capture_gap\" && owner.counts.failed > 0),\n    ).toBe(true);\n    expect(health2.value.failures.some((failure) => failure.form === \"capture_gap\")).toBe(true);\n\n    // The gap note is itself a recorded event — the last recorded position\n    // advances, proving the surface reflects new capture rather than a snapshot.\n    const overview2 = await inspect.overview(thread.threadRef);\n    expect(overview2.ok).toBe(true);\n    if (!overview2.ok) return;\n    expect(overview2.value.events.count).toBe(corpus.expected.length + 1);\n    expect(overview2.value.events.span?.last).toBeGreaterThan(overview1.value.events.span?.last ?? 0);\n  });\n});\n","numLines":202,"startLine":1,"totalLines":202}}}

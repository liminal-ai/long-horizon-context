  errorClass: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"state_corruption\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n      code: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"unknown_work_kind\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n      reason: `no handler registered for work kind \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"${kind}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`,\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\\\\\\\\\\\\\\\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\\\\\\\\\\\\\\\nexport function lookupWorkHandler(\\\\\\\\\\\\\\\\n  map: WorkHandlerMap,\\\\\\\\\\\\\\\\n  kind: string,\\\\\\\\\\\\\\\\n): OpResult<WorkHandler> {\\\\\\\\\\\\\\\\n  const handler = map[kind as WorkKind];\\\\\\\\\\\\\\\\n  if (handler === undefined) return unknownWorkKind(kind);\\\\\\\\\\\\\\\\n  return { ok: true, value: handler };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\\\\\\\\\\\\\\\n// requeue land in Story 4.\\\\\\\\\\\\\\\\nexport interface WorkSurface {\\\\\\\\\\\\\\\\n  drain(\\\\\\\\\\\\\\\\n    ref: threadsDomain.ThreadRef,\\\\\\\\\\\\\\\\n    opts?: { maxItems?: number },\\\\\\\\\\\\\\\\n  ): Promise<OpResult<DrainReport>>;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\\\\\\\\\\\\\\\\n// §Interface Definitions): the operations only — the Story 0 config\\\\\\\\\\\\\\\\n// substrate the domain index also carries is construction machinery, not an\\\\\\\\\\\\\\\\n// oper\\\\\\\",\\\\\\\"rawProviderOutputBytes\\\\\\\":446908,\\\\\\\"rawProviderOutputTruncated\\\\\\\":true,\\\\\\\"rawProviderOutputLogPath\\\\\\\":\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/008-quick-fix.stdout.log\\\\\\\"},\\\\\\\"errors\\\\\\\":[
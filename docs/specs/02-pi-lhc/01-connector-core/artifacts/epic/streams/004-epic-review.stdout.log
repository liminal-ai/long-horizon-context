{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1c35a8ab28ac46e481afbb87","type":"tool_result","content":"250\t    expect(idOf(state.threadRef)).toBe(existingId);\n251\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n252\t    expect(await threadCount()).toBe(before); // no second thread\n253\t  });\n254\t\n255\t  it(\"TC-1.7: production --resume presents cwd-scoped candidates and fails closed when ambiguous\", async () => {\n256\t    const older = await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n257\t    const newer = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n258\t    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n259\t    const before = await threadCount();\n260\t\n261\t    // A ctx WITH a UI captures exactly what the picker presents to the operator.\n262\t    const notes: string[] = [];\n263\t    const ctx: ExtensionContext = {\n264\t      cwd: \"/work/resume\",\n265\t      hasUI: true,\n266\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n267\t      ui: { notify: (message) => notes.push(message) },\n268\t      sessionManager: { getEntries: () => [] },\n269\t    };\n270\t\n271\t    const connector = productionConnector(() => ({ resume: true }));\n272\t    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n273\t\n274\t    // The operator was shown the cwd-scoped candidate list — only this cwd's\n275\t    // threads, each with title and creation time — through ctx.ui.notify. Because\n276\t    // there is no interactive PI selection surface in v0.79.2, multiple\n277\t    // candidates fail closed and instruct the operator to relaunch with --session.\n278\t    const shown = notes.find((note) => note.includes(\"pi-lhc --resume:\"));\n279\t    expect(shown).toBeDefined();\n280\t    if (shown === undefined) return;\n281\t    expect(shown).toContain(\"older\");\n282\t    expect(shown).toContain(\"newer\");\n283\t    expect(shown).not.toContain(\"different cwd\");\n284\t    expect(shown).toContain(\"relaunch with --session <id>\");\n285\t    const olderRow = await threads.resolve({ threadId: older, registryPath: store.registryPath });\n286\t    const newerRow = await threads.resolve({ threadId: newer, registryPath: store.registryPath });\n287\t    if (olderRow.ok) expect(shown).toContain(olderRow.value.createdAt);\n288\t    if (newerRow.ok) expect(shown).toContain(newerRow.value.createdAt);\n289\t\n290\t    expect(connector.getState()).toBeNull();\n291\t    expect(connector.getInstance()).toBeNull();\n292\t    expect(await threadCount()).toBe(before); // did not create or attach silently\n293\t  });\n294\t\n295\t  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n296\t    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n297\t    const before = await threadCount();\n298\t\n299\t    const connector = productionConnector(() => ({ resume: true }));\n300\t    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n301\t    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n302\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n303\t\n304\t    const state = connector.getState();\n305\t    expect(state).not.toBeNull();\n306\t    if (state === null) return;\n307\t    expect(connector.getInstance()).not.toBeNull();\n308\t    expect(await threadCount()).toBe(before); // resolved without failing\n309\t  });\n310\t});\n311\t\n312\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n313\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n314\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n315\t\n316\t    // session_start with a ctx carrying methods.\n317\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n318\t    expect(connector.getState()).not.toBeNull();\n319\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n320\t    // ...but the snapshot is plain data only — it survives structuredClone even\n321\t    // though the live ctx and instance carry methods (they are not in it).\n322\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n323\t    const threadRefBefore = connector.getState()?.threadRef;\n324\t\n325\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n326\t    // holder still references no prior ctx.\n327\t    await connector.handlers.message_end(\n328\t      syntheticCtx(\"/work/a\"),\n329\t      makeMessageEnd(makeUserMessage(\"hi\")),\n330\t    );\n331\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n332\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n333\t  });\n334\t});\n335\t\n336\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n337\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n338\t    const cwd = \"/work/reload\";\n339\t\n340\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n341\t    const connectorA = productionConnector(() => ({}));\n342\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n343\t    const stateA = connectorA.getState();\n344\t    expect(stateA).not.toBeNull();\n345\t    if (stateA === null) return;\n346\t    const firstId = idOf(stateA.threadRef);\n347\t    const countAfterNew = await threadCount();\n348\t\n349\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n350\t    expect(row.ok).toBe(true);\n351\t    if (row.ok) {\n352\t      expect(row.value.cwd).toBe(cwd);\n353\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n354\t    }\n355\t\n356\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n357\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n358\t    // closure and a still-no-flag launch (which would otherwise create a\n359\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n360\t    // thing bridging the teardown is the durable registry — this is what proves\n361\t    // reconstruction survives loss of every in-memory holder (SV-001).\n362\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n363\t\n364\t    const connectorB = productionConnector(() => ({}));\n365\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n366\t\n367\t    const stateB = connectorB.getState();\n368\t    expect(stateB).not.toBeNull();\n369\t    if (stateB === null) return;\n370\t    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n371\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n372\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n373\t  });\n374\t\n375\t  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n376\t    const cwd = \"/work/reload-session\";\n377\t    const existing = await makeThread({ cwd, title: \"carried\" });\n378\t    const before = await threadCount();\n379\t\n380\t    // Launched with --session <id>: reload re-resolves the SAME id from the\n381\t    // durable registry, independent of any in-memory state.\n382\t    const connectorA = productionConnector(() => ({ session: existing }));\n383\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"startup\"));\n384\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n385\t\n386\t    const connectorB = productionConnector(() => ({ session: existing }));\n387\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n388\t    expect(idOf(connectorB.getState()!.threadRef)).toBe(existing);\n389\t    expect(await threadCount()).toBe(before); // no thread created on reload\n390\t  });\n391\t\n392\t  it(\"a no-flag 'new' session always creates a new thread — reattach is reload-only, keyed on the start reason, not on retained memory\", async () => {\n393\t    const cwd = \"/work/fresh\";\n394\t    const connectorA = productionConnector(() => ({}));\n395\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n396\t    const firstId = idOf(connectorA.getState()!.threadRef);\n397\t\n398\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n399\t"}]},"parent_tool_use_id":null,"session_id":"8a1de899-4d5a-4e8b-9eb8-54d1998ea0a6","uuid":"2af96670-619b-4419-bcce-1974e22c4dac","timestamp":"2026-06-14T13:56:09.702Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts","content":"    expect(idOf(state.threadRef)).toBe(existingId);\n    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n    expect(await threadCount()).toBe(before); // no second thread\n  });\n\n  it(\"TC-1.7: production --resume presents cwd-scoped candidates and fails closed when ambiguous\", async () => {\n    const older = await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n    const newer = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n    const before = await threadCount();\n\n    // A ctx WITH a UI captures exactly what the picker presents to the operator.\n    const notes: string[] = [];\n    const ctx: ExtensionContext = {\n      cwd: \"/work/resume\",\n      hasUI: true,\n      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n      ui: { notify: (message) => notes.push(message) },\n      sessionManager: { getEntries: () => [] },\n    };\n\n    const connector = productionConnector(() => ({ resume: true }));\n    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n\n    // The operator was shown the cwd-scoped candidate list — only this cwd's\n    // threads, each with title and creation time — through ctx.ui.notify. Because\n    // there is no interactive PI selection surface in v0.79.2, multiple\n    // candidates fail closed and instruct the operator to relaunch with --session.\n    const shown = notes.find((note) => note.includes(\"pi-lhc --resume:\"));\n    expect(shown).toBeDefined();\n    if (shown === undefined) return;\n    expect(shown).toContain(\"older\");\n    expect(shown).toContain(\"newer\");\n    expect(shown).not.toContain(\"different cwd\");\n    expect(shown).toContain(\"relaunch with --session <id>\");\n    const olderRow = await threads.resolve({ threadId: older, registryPath: store.registryPath });\n    const newerRow = await threads.resolve({ threadId: newer, registryPath: store.registryPath });\n    if (olderRow.ok) expect(shown).toContain(olderRow.value.createdAt);\n    if (newerRow.ok) expect(shown).toContain(newerRow.value.createdAt);\n\n    expect(connector.getState()).toBeNull();\n    expect(connector.getInstance()).toBeNull();\n    expect(await threadCount()).toBe(before); // did not create or attach silently\n  });\n\n  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n    const before = await threadCount();\n\n    const connector = productionConnector(() => ({ resume: true }));\n    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n\n    const state = connector.getState();\n    expect(state).not.toBeNull();\n    if (state === null) return;\n    expect(connector.getInstance()).not.toBeNull();\n    expect(await threadCount()).toBe(before); // resolved without failing\n  });\n});\n\ndescribe(\"Story 1: plain-data state across hooks\", () => {\n  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n\n    // session_start with a ctx carrying methods.\n    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n    expect(connector.getState()).not.toBeNull();\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n    // ...but the snapshot is plain data only — it survives structuredClone even\n    // though the live ctx and instance carry methods (they are not in it).\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    const threadRefBefore = connector.getState()?.threadRef;\n\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n    // holder still references no prior ctx.\n    await connector.handlers.message_end(\n      syntheticCtx(\"/work/a\"),\n      makeMessageEnd(makeUserMessage(\"hi\")),\n    );\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n  });\n});\n\ndescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n    const cwd = \"/work/reload\";\n\n    // Connector A: a no-flag session creates the thread (cwd + default title).\n    const connectorA = productionConnector(() => ({}));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const stateA = connectorA.getState();\n    expect(stateA).not.toBeNull();\n    if (stateA === null) return;\n    const firstId = idOf(stateA.threadRef);\n    const countAfterNew = await threadCount();\n\n    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (row.ok) {\n      expect(row.value.cwd).toBe(cwd);\n      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n    }\n\n    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n    // referenced again. A brand-new connector handles the reload with an EMPTY\n    // closure and a still-no-flag launch (which would otherwise create a\n    // duplicate). The connector keeps NO module-level handoff state, so the only\n    // thing bridging the teardown is the durable registry — this is what proves\n    // reconstruction survives loss of every in-memory holder (SV-001).\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n\n    const connectorB = productionConnector(() => ({}));\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n\n    const stateB = connectorB.getState();\n    expect(stateB).not.toBeNull();\n    if (stateB === null) return;\n    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n  });\n\n  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n    const cwd = \"/work/reload-session\";\n    const existing = await makeThread({ cwd, title: \"carried\" });\n    const before = await threadCount();\n\n    // Launched with --session <id>: reload re-resolves the SAME id from the\n    // durable registry, independent of any in-memory state.\n    const connectorA = productionConnector(() => ({ session: existing }));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"startup\"));\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n\n    const connectorB = productionConnector(() => ({ session: existing }));\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n    expect(idOf(connectorB.getState()!.threadRef)).toBe(existing);\n    expect(await threadCount()).toBe(before); // no thread created on reload\n  });\n\n  it(\"a no-flag 'new' session always creates a new thread — reattach is reload-only, keyed on the start reason, not on retained memory\", async () => {\n    const cwd = \"/work/fresh\";\n    const connectorA = productionConnector(() => ({}));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const firstId = idOf(connectorA.getState()!.threadRef);\n\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n","numLines":150,"startLine":250,"totalLines":408}}}

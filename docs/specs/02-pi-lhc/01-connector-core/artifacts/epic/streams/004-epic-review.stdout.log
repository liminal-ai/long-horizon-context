de/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/runtime-changes.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/turn-accumulator.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/state.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/pi/types.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/converter.test.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/turn-derivation.test.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/abort.test.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/idempotency.test.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/support.ts\\\\\\\",\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/package.json\\\\\\\",\\\\\\\"manual node reproduction: resume/reload idempotency collision using built packages/pi-lhc/dist/index.js\\\\\\\"],\\\\\\\"reviewScopeSummary\\\\\\\":\\\\\\\"Initial verification covered Story 2 AC/TC requirements, Flow 2 tech design, capture/runtime production paths, Story 2 tests, configured gates, and manual existing-thread reattach scenarios.\\\\\\\",\\\\\\\"priorFindingStatuses\\\\\\\":[],\\\\\\\"newFindings\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"SV-001\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"critical\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Existing-thread resume/reload can silently skip new finalized events\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"AC-2.1 requires every finalized PI message to be recorded exactly once, and AC-2.6/TC-2.7 require duplicate safety without normal-resume historical replay. On every session_start, createConnector resets captureSession.sourceSeq to 0 in packages/pi-lhc/src/index.ts:310-318; nextEntryId then returns s0, s1, ... in packages/pi-lhc/src/index.ts:352-357; message/runtime hooks use that generated entryId in packages/pi-lhc/src/index.ts:362-384. eventKey gives entryId first precedence in packages/pi-lhc/src/capture/idempotency.ts:35-40, so a fresh connector attached to an existing thread reuses prior keys. Manual reproduction against the built production connector: after recording user_prompt 'first', starting a fresh connector with --session for the same thread and recording user_prompt 'second after resume', intakeStream.listEvents returned only the first event with key pi:th_947f6dd71f50d513:entry:s0:0:user_prompt and connector diag was null. The same reload shape returned only the first event with key pi:th_d1fc3d71df1144d3:entry:s0:0:user_prompt. Existing TC-2.7 coverage in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:108-153 only proves identical batch re-delivery skips; it does not prove normal resume/reload continues recording new events.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/pi-lhc/src/index.ts\\\\\\\",\\\\\\\"packages/pi-lhc/src/capture/idempotency.ts\\\\\\\",\\\\\\\"packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\\\\\",\\\\\\\"packages/pi-lhc/test/capture/idempotency.test.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-2.1\\\\\\\",\\\\\\\"AC-2.6\\\\\\\",\\\\\\\"AC-2.7\\\\\\\",\\\\\\\"TC-2.7\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"same-session-implementor\\\\\\\",\\\\\\\"blocking\\\\\\\":true}],\\\\\\\"openFindings\\\\\\\":[{\\\\\\\"id\\\\\\\":\\\\\\\"SV-001\\\\\\\",\\\\\\\"severity\\\\\\\":\\\\\\\"critical\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Existing-thread resume/reload can silently skip new finalized events\\\\\\\",\\\\\\\"evidence\\\\\\\":\\\\\\\"AC-2.1 requires every finalized PI message to be recorded exactly once, and AC-2.6/TC-2.7 require duplicate safety without normal-resume historical replay. On every session_start, createConnector resets captureSession.sourceSeq to 0 in packages/pi-lhc/src/index.ts:310-318; nextEntryId then returns s0, s1, ... in packages/pi-lhc/src/index.ts:352-357; message/runtime hooks use that generated entryId in packages/pi-lhc/src/index.ts:362-384. eventKey gives entryId first precedence in packages/pi-lhc/src/capture/idempotency.ts:35-40, so a fresh connector attached to an existing thread reuses prior keys. Manual reproduction against the built production connector: after recording user_prompt 'first', starting a fresh connector with --session for the same thread and recording user_prompt 'second after resume', intakeStream.listEvents returned only the first event with key pi:th_947f6dd71f50d513:entry:s0:0:user_prompt and connector diag was null. The same reload shape returned only the first event with key pi:th_d1fc3d71df1144d3:entry:s0:0:user_prompt. Existing TC-2.7 coverage in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:108-153 only proves identical batch re-delivery skips; it does not prove normal resume/reload continues recording new events.\\\\\\\",\\\\\\\"affectedFiles\\\\\\\":[\\\\\\\"packages/pi-lhc/src/index.ts\\\\\\\",\\\\\\\"packages/pi-lhc/src/capture/idempotency.ts\\\\\\\",\\\\\\\"packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\\\\\",\\\\\\\"packages/pi-lhc/test/capture/idempotency.test.ts\\\\\\\"],\\\\\\\"requirementIds\\\\\\\":[\\\\\\\"AC-2.1\\\\\\\",\\\\\\\"AC-2.6\\\\\\\",\\\\\\\"AC-2.7\\\\\\\",\\\\\\\"TC-2.7\\\\\\\"],\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"same-session-implementor\\\\\\\",\\\\\\\"blocking\\\\\\\":true}],\\\\\\\"requirementCoverage\\\\\\\":{\\\\\\\"verified\\\\\\\":[\\\\\\\"TC-2.1 happy-path ordered user/assistant/toolResult capture and assistant thinking/text/tool_call fan-out\\\\\\\",\\\\\\\"AC-2.2\\\\\\\",\\\\\\\"TC-2.2\\\\\\\",\\\\\\\"TC-2.3\\\\\\\",\\\\\\\"AC-2.3\\\\\\\",\\\\\\\"TC-2.4\\\\\\\",\\\\\\\"AC-2.4\\\\\\\",\\\\\\\"TC-2.5\\\\\\\",\\\\\\\"AC-2.5\\\\\\\",\\\\\\\"TC-2.6\\\\\\\",\\\\\\\"AC-2.8\\\\\\\",\\\\\\\"TC-2.9\\\\\\\",\\\\\\\"TC-2.8 explicit malformed-event/store-unavailable failure isolation\\\\\\\",\\\\\\\"Idempotency architecture-risk double-replay for identical batches\\\\\\\"],\\\\\\\"unverified\\\\\\\":[\\\\\\\"AC-2.1 across existing-thread resume/reload\\\\\\\",\\\\\\\"AC-2.6 for normal resume/reload continuation after prior captures\\\\\\\",\\\\\\\"AC-2.7 for false duplicate-skip capture loss\\\\\\\",\\\\\\\"TC-2.7 normal resume does not replay historical messages while new messages still record\\\\\\\"]},\\\\\\\"gatesRun\\\\\\\":[{\\\\\\\"command\\\\\\\":\\\\\\\"pnpm --filter pi-lhc verify\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"pnpm --filter pi-lhc verify-all\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"manual node --input-type=module existing-thread resume/reload idempotency reproduction\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"fail\\\\\\\"}],\\\\\\\"productionPathFindings\\\\\\\":[\\\\\\\"Production capture path uses real LHC intakeStream.messageEvents, but reattach state is not durable: sourceSeq and turn_end closedCount reset for every fresh connector, making new events on existing threads collide with prior idempotency keys.\\\\\\\",\\\\\\\"No material fake/mock intake path was found in Story 2 capture modules; test fakes are confined to fixtures and explicit test SDK config.\\\\\\\"],\\\\\\\"recommendedNextStep\\\\\\\":\\\\\\\"revise\\\\\\\",\\\\\\\"recommendedFixScope\\\\\\\":\\\\\\\"same-session-implementor\\\\\\\",\\\\\\\"openQuestions\\\\\\\":[],\\\\\\\"additionalObservations\\\\\\\":[\\\\\\\"Configured gates passed with 54 tests, but the current suite does not cover the existing-thread resume/reload collision path.\\\\\\\"]},\\\\\\\"errors\\\\\\\":[],\\\\\\\"warnings\\\\\\\":[],\\\\\\\"artifacts\\\\\\\":[{\\\\\\\"kind\\\\
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc 'for f in packages/pi-lhc/test/fixtures/pi-corpora/*.jsonl; do echo \"$f\"; nl -ba \"$f\" | sed -n '\"'1,80p'; done\"","aggregated_output":"packages/pi-lhc/test/fixtures/pi-corpora/aborted-turn.jsonl\n     1\t{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"write a long essay\"}]}\n     2\t{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"starting the essay\"},{\"type\":\"text\",\"text\":\"Once upon a\"}],\"stopReason\":\"aborted\"}\npackages/pi-lhc/test/fixtures/pi-corpora/chatty.jsonl\n     1\t{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"what does this repo do?\"}]}\n     2\t{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"it is the LHC SDK\"}]}\n     3\t{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"and the connector?\"}]}\n     4\t{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"it wires PI to LHC\"}]}\npackages/pi-lhc/test/fixtures/pi-corpora/error-result.jsonl\n     1\t{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"read missing.txt\"}]}\n     2\t{\"role\":\"assistant\",\"content\":[{\"type\":\"toolCall\",\"id\":\"call_a|fc_1\",\"name\":\"read_file\",\"arguments\":{\"path\":\"missing.txt\"}}]}\n     3\t{\"role\":\"toolResult\",\"toolCallId\":\"call_a|fc_1\",\"content\":[{\"type\":\"text\",\"text\":\"ENOENT: no such file\"}],\"isError\":true}\n     4\t{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"that file does not exist\"}]}\npackages/pi-lhc/test/fixtures/pi-corpora/parallel-tool.jsonl\n     1\t{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"read both files\"}]}\n     2\t{\"role\":\"assistant\",\"content\":[{\"type\":\"toolCall\",\"id\":\"call_a|fc_1\",\"name\":\"read_file\",\"arguments\":{\"path\":\"a.txt\"}},{\"type\":\"toolCall\",\"id\":\"call_b|fc_2\",\"name\":\"read_file\",\"arguments\":{\"path\":\"b.txt\"}}]}\n     3\t{\"role\":\"toolResult\",\"toolCallId\":\"call_b|fc_2\",\"content\":[{\"type\":\"text\",\"text\":\"b contents\"}],\"isError\":false}\n     4\t{\"role\":\"toolResult\",\"toolCallId\":\"call_a|fc_1\",\"content\":[{\"type\":\"text\",\"text\":\"a contents\"}],\"isError\":false}\n     5\t{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"read both\"}]}\npackages/pi-lhc/test/fixtures/pi-corpora/tool-heavy.jsonl\n     1\t{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"read notes.txt\"}]}\n     2\t{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"I should open the file\"},{\"type\":\"toolCall\",\"id\":\"call_a|fc_1\",\"name\":\"read_file\",\"arguments\":{\"path\":\"notes.txt\"}}]}\n     3\t{\"role\":\"toolResult\",\"toolCallId\":\"call_a|fc_1\",\"content\":[{\"type\":\"text\",\"text\":\"contents of notes.txt\"}],\"isError\":false}\n     4\t{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"the file says hello\"}]}\n","exit_code":0,"status":"completed"}}

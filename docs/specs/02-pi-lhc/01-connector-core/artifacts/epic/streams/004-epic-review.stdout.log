{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/lifecycle/thread-resolution.test.ts | sed -n '336,430p'\"","aggregated_output":"   336\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n   337\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n   338\t    const cwd = \"/work/reload\";\n   339\t\n   340\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n   341\t    const connectorA = productionConnector(() => ({}));\n   342\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   343\t    const stateA = connectorA.getState();\n   344\t    expect(stateA).not.toBeNull();\n   345\t    if (stateA === null) return;\n   346\t    const firstId = idOf(stateA.threadRef);\n   347\t    const countAfterNew = await threadCount();\n   348\t\n   349\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n   350\t    expect(row.ok).toBe(true);\n   351\t    if (row.ok) {\n   352\t      expect(row.value.cwd).toBe(cwd);\n   353\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n   354\t    }\n   355\t\n   356\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n   357\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n   358\t    // closure and a still-no-flag launch (which would otherwise create a\n   359\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n   360\t    // thing bridging the teardown is the durable registry — this is what proves\n   361\t    // reconstruction survives loss of every in-memory holder (SV-001).\n   362\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   363\t\n   364\t    const connectorB = productionConnector(() => ({}));\n   365\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   366\t\n   367\t    const stateB = connectorB.getState();\n   368\t    expect(stateB).not.toBeNull();\n   369\t    if (stateB === null) return;\n   370\t    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n   371\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n   372\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n   373\t  });\n   374\t\n   375\t  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n   376\t    const cwd = \"/work/reload-session\";\n   377\t    const existing = await makeThread({ cwd, title: \"carried\" });\n   378\t    const before = await threadCount();\n   379\t\n   380\t    // Launched with --session <id>: reload re-resolves the SAME id from the\n   381\t    // durable registry, independent of any in-memory state.\n   382\t    const connectorA = productionConnector(() => ({ session: existing }));\n   383\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"startup\"));\n   384\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   385\t\n   386\t    const connectorB = productionConnector(() => ({ session: existing }));\n   387\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   388\t    expect(idOf(connectorB.getState()!.threadRef)).toBe(existing);\n   389\t    expect(await threadCount()).toBe(before); // no thread created on reload\n   390\t  });\n   391\t\n   392\t  it(\"a no-flag 'new' session always creates a new thread — reattach is reload-only, keyed on the start reason, not on retained memory\", async () => {\n   393\t    const cwd = \"/work/fresh\";\n   394\t    const connectorA = productionConnector(() => ({}));\n   395\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   396\t    const firstId = idOf(connectorA.getState()!.threadRef);\n   397\t\n   398\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n   399\t\n   400\t    const connectorB = productionConnector(() => ({}));\n   401\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   402\t    const secondId = idOf(connectorB.getState()!.threadRef);\n   403\t\n   404\t    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\n   405\t    expect(await threadCount()).toBe(2);\n   406\t  });\n   407\t});\n","exit_code":0,"status":"completed"}}

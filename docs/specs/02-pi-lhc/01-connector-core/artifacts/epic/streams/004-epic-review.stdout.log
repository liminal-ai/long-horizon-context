{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/threads/internal/registry.ts | sed -n '1,360p'\"","aggregated_output":"     1\timport { existsSync, mkdirSync } from \"node:fs\";\n     2\timport { homedir } from \"node:os\";\n     3\timport { dirname, join } from \"node:path\";\n     4\timport type { DatabaseSync } from \"node:sqlite\";\n     5\timport { openDatabase, runMigrations, type Migration } from \"../../../shared/storage.js\";\n     6\t\n     7\texport const DEFAULT_REGISTRY_PATH = join(homedir(), \".lhc\", \"registry.sqlite\");\n     8\t\n     9\texport function resolveRegistryPath(registryPath?: string): string {\n    10\t  return registryPath ?? DEFAULT_REGISTRY_PATH;\n    11\t}\n    12\t\n    13\tconst REGISTRY_MIGRATIONS: readonly Migration[] = [\n    14\t  {\n    15\t    version: 1,\n    16\t    statements: [\n    17\t      `CREATE TABLE threads (\n    18\t        thread_id TEXT PRIMARY KEY,\n    19\t        file_path TEXT NOT NULL,\n    20\t        title TEXT,\n    21\t        created_at TEXT NOT NULL\n    22\t      );`,\n    23\t    ],\n    24\t  },\n    25\t  {\n    26\t    // A-8 (Epic 02 pi-lhc Story 1): the cwd a thread was created in, so the\n    27\t    // `--resume` picker can scope its list to the current directory. Added as\n    28\t    // its own version (not folded into v1) so a registry created under v1\n    29\t    // upgrades lazily on next open rather than silently lacking the column.\n    30\t    version: 2,\n    31\t    statements: [`ALTER TABLE threads ADD COLUMN cwd TEXT;`],\n    32\t  },\n    33\t];\n    34\t\n    35\t// First write creates the database and schema lazily (design decision 6).\n    36\texport function openRegistryForWrite(registryPath: string): DatabaseSync {\n    37\t  mkdirSync(dirname(registryPath), { recursive: true });\n    38\t  const db = openDatabase(registryPath);\n    39\t  try {\n    40\t    runMigrations(db, REGISTRY_MIGRATIONS);\n    41\t  } catch (cause) {\n    42\t    db.close();\n    43\t    throw cause;\n    44\t  }\n    45\t  return db;\n    46\t}\n    47\t\n    48\t// Reads never create the registry: callers map null to empty list /\n    49\t// thread_not_found. The existence check is the non-creation guarantee —\n    50\t// openDatabase would create the file. An existing registry is brought to the\n    51\t// current schema on open so reads can rely on the current columns (e.g. the\n    52\t// A-8 `cwd` column) regardless of which version created it; a registry already\n    53\t// at the latest version pays nothing (runMigrations is a no-op).\n    54\texport function openRegistryForRead(registryPath: string): DatabaseSync | null {\n    55\t  if (!existsSync(registryPath)) return null;\n    56\t  const db = openDatabase(registryPath);\n    57\t  try {\n    58\t    runMigrations(db, REGISTRY_MIGRATIONS);\n    59\t  } catch (cause) {\n    60\t    db.close();\n    61\t    throw cause;\n    62\t  }\n    63\t  return db;\n    64\t}\n    65\t\n    66\texport interface RegistryRow {\n    67\t  threadId: string;\n    68\t  filePath: string;\n    69\t  title?: string;\n    70\t  cwd?: string;\n    71\t  createdAt: string;\n    72\t}\n    73\t\n    74\tinterface RawRow {\n    75\t  thread_id: string;\n    76\t  file_path: string;\n    77\t  title: string | null;\n    78\t  cwd: string | null;\n    79\t  created_at: string;\n    80\t}\n    81\t\n    82\tconst ROW_COLUMNS = \"thread_id, file_path, title, cwd, created_at\";\n    83\t\n    84\t// Insertion order (rowid) breaks ties at the same created_at timestamp, so\n    85\t// \"most recent\" (the last row) is the last-inserted thread even when two\n    86\t// creations land in the same millisecond — the determinism `--continue`\n    87\t// (resolve the most recently created thread) relies on.\n    88\tconst ROW_ORDER = \"ORDER BY created_at, rowid\";\n    89\t\n    90\tfunction toRegistryRow(raw: RawRow): RegistryRow {\n    91\t  const row: RegistryRow = {\n    92\t    threadId: raw.thread_id,\n    93\t    filePath: raw.file_path,\n    94\t    createdAt: raw.created_at,\n    95\t  };\n    96\t  if (raw.title !== null) row.title = raw.title;\n    97\t  if (raw.cwd !== null) row.cwd = raw.cwd;\n    98\t  return row;\n    99\t}\n   100\t\n   101\texport function insertThreadRow(db: DatabaseSync, row: RegistryRow): void {\n   102\t  db.prepare(\n   103\t    \"INSERT INTO threads (thread_id, file_path, title, cwd, created_at) VALUES (?, ?, ?, ?, ?)\",\n   104\t  ).run(row.threadId, row.filePath, row.title ?? null, row.cwd ?? null, row.createdAt);\n   105\t}\n   106\t\n   107\texport function selectThreadRow(\n   108\t  db: DatabaseSync,\n   109\t  threadId: string,\n   110\t): RegistryRow | undefined {\n   111\t  const raw = db\n   112\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id = ?`)\n   113\t    .get(threadId) as unknown as RawRow | undefined;\n   114\t  return raw === undefined ? undefined : toRegistryRow(raw);\n   115\t}\n   116\t\n   117\t// Partial-id resolve (A-8): every thread whose id begins with the given prefix.\n   118\t// LIKE metacharacters in the (caller-supplied) prefix are escaped so the '_' in\n   119\t// the thread-id scheme (th_<hex>) and any '%' match literally rather than as\n   120\t// wildcards; ESCAPE makes '\\' the escape character.\n   121\texport function selectThreadRowsByPrefix(db: DatabaseSync, prefix: string): RegistryRow[] {\n   122\t  const escaped = prefix.replace(/[\\\\%_]/g, (ch) => `\\\\${ch}`);\n   123\t  const raws = db\n   124\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id LIKE ? ESCAPE '\\\\' ${ROW_ORDER}`)\n   125\t    .all(`${escaped}%`) as unknown as RawRow[];\n   126\t  return raws.map(toRegistryRow);\n   127\t}\n   128\t\n   129\t// cwd, when given, filters at the registry (A-8): the picker must not scope by\n   130\t// filtering an unscoped list after the fact (anti-shim) — the scope is the query.\n   131\texport function selectAllThreadRows(\n   132\t  db: DatabaseSync,\n   133\t  opts: { cwd?: string } = {},\n   134\t): RegistryRow[] {\n   135\t  const raws =\n   136\t    opts.cwd === undefined\n   137\t      ? (db.prepare(`SELECT ${ROW_COLUMNS} FROM threads ${ROW_ORDER}`).all() as unknown as RawRow[])\n   138\t      : (db\n   139\t          .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE cwd = ? ${ROW_ORDER}`)\n   140\t          .all(opts.cwd) as unknown as RawRow[]);\n   141\t  return raws.map(toRegistryRow);\n   142\t}\n","exit_code":0,"status":"completed"}}

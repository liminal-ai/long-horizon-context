{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/lifecycle/thread-resolution.test.ts | sed -n '1,380p'\"","aggregated_output":"     1\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\n     2\t// reconstruction. Two layers are covered: the resolver/picker functions\n     3\t// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\n     4\t// PRODUCTION connector path through createConnector with real defaults (no\n     5\t// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\n     6\t// throughout; the module-level reload memory is reset per test.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  createDeterministicProvider,\n    10\t  inspect,\n    11\t  threads,\n    12\t  type SdkConfig,\n    13\t  type ThreadRef,\n    14\t} from \"lhc\";\n    15\timport { createConnector } from \"../../src/index.js\";\n    16\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n    17\timport {\n    18\t  defaultThreadTitle,\n    19\t  parseLaunchFlags,\n    20\t  resolveThread,\n    21\t  type ResolveDeps,\n    22\t} from \"../../src/lifecycle/thread-resolution.js\";\n    23\timport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\n    24\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n    25\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n    26\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    27\t\n    28\tlet store: TempStore;\n    29\tbeforeEach(() => {\n    30\t  store = tempStore();\n    31\t  // No connector reset needed: the connector keeps no module-level state — reload\n    32\t  // reconstructs from the durable registry, and each test uses a fresh temp store.\n    33\t});\n    34\tafterEach(() => {\n    35\t  store.cleanup();\n    36\t});\n    37\t\n    38\tfunction backgroundConfig(): SdkConfig {\n    39\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n    40\t}\n    41\t\n    42\tfunction idOf(ref: ThreadRef): string {\n    43\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n    44\t  return ref.threadId;\n    45\t}\n    46\t\n    47\tfunction deps(cwd = \"/work/default\"): ResolveDeps {\n    48\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n    49\t}\n    50\t\n    51\t// Create a thread directly with explicit cwd/title, for picker fixtures and\n    52\t// existing-thread setup. (Connector-created threads get cwd plus a default title\n    53\t// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\n    54\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n    55\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n    56\t    filePath: store.threadPath(),\n    57\t    registryPath: store.registryPath,\n    58\t  };\n    59\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n    60\t  if (opts.title !== undefined) input.title = opts.title;\n    61\t  const created = await threads.newThread(input);\n    62\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n    63\t  return created.value.threadId;\n    64\t}\n    65\t\n    66\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n    67\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\n    68\t// object, modelling PI handing a fresh ctx to each hook.\n    69\tfunction syntheticCtx(cwd: string): ExtensionContext {\n    70\t  return {\n    71\t    cwd,\n    72\t    hasUI: false,\n    73\t    modelRegistry: {\n    74\t      find: () => undefined,\n    75\t      hasConfiguredAuth: () => false,\n    76\t      getAvailable: () => [],\n    77\t    },\n    78\t    ui: { notify: () => {} },\n    79\t    sessionManager: { getEntries: () => [] },\n    80\t  };\n    81\t}\n    82\t\n    83\t// A connector wired with production defaults (real SDK config + selector) and\n    84\t// only environment overrides — the activate() path, minus the global registry\n    85\t// and process.argv.\n    86\tfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n    87\t  return createConnector({\n    88\t    registryPath: store.registryPath,\n    89\t    newThreadFilePath: () => store.threadPath(),\n    90\t    parseLaunch: launch,\n    91\t  });\n    92\t}\n    93\t\n    94\tasync function threadCount(): Promise<number> {\n    95\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\n    96\t  return listed.ok ? listed.value.length : -1;\n    97\t}\n    98\t\n    99\tdescribe(\"Story 1: launch-driven thread resolution (resolver/picker)\", () => {\n   100\t  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n   101\t    // no flag → a new thread\n   102\t    const first = await resolveThread({}, deps());\n   103\t    expect(first.ok).toBe(true);\n   104\t    if (!first.ok) return;\n   105\t    const firstId = idOf(first.value);\n   106\t\n   107\t    // --session full id → the same thread\n   108\t    const byFull = await resolveThread({ session: firstId }, deps());\n   109\t    expect(byFull.ok).toBe(true);\n   110\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n   111\t\n   112\t    // --session partial id → the same thread\n   113\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n   114\t    expect(byPartial.ok).toBe(true);\n   115\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n   116\t\n   117\t    // a second thread, then --continue → the most recently created\n   118\t    const second = await resolveThread({}, deps());\n   119\t    expect(second.ok).toBe(true);\n   120\t    if (!second.ok) return;\n   121\t    const secondId = idOf(second.value);\n   122\t    const continued = await resolveThread({ continue: true }, deps());\n   123\t    expect(continued.ok).toBe(true);\n   124\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n   125\t\n   126\t    // unresolvable id → actionable error, no thread created\n   127\t    const before = await threadCount();\n   128\t    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n   129\t    expect(bad.ok).toBe(false);\n   130\t    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n   131\t    expect(await threadCount()).toBe(before);\n   132\t\n   133\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\n   134\t    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n   135\t    expect(ambiguous.ok).toBe(false);\n   136\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n   137\t    expect(await threadCount()).toBe(before);\n   138\t  });\n   139\t\n   140\t  it(\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\", () => {\n   141\t    expect(parseLaunchFlags([\"node\", \"pi\"])).toEqual({});\n   142\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--resume\"])).toEqual({ resume: true });\n   143\t    expect(parseLaunchFlags([\"node\", \"pi\", \"-r\"])).toEqual({ resume: true });\n   144\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--continue\"])).toEqual({ continue: true });\n   145\t    expect(parseLaunchFlags([\"node\", \"pi\", \"-c\"])).toEqual({ continue: true });\n   146\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--session\", \"th_abc\"])).toEqual({ session: \"th_abc\" });\n   147\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--session=th_xyz\"])).toEqual({ session: \"th_xyz\" });\n   148\t  });\n   149\t\n   150\t  it(\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\", async () => {\n   151\t    const created = await resolveThread({}, deps(\"/work/proj-x\"));\n   152\t    expect(created.ok).toBe(true);\n   153\t    if (!created.ok) return;\n   154\t    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\n   155\t    expect(row.ok).toBe(true);\n   156\t    if (!row.ok) return;\n   157\t    expect(row.value.cwd).toBe(\"/work/proj-x\");\n   158\t    expect(row.value.title).toBe(defaultThreadTitle(\"/work/proj-x\")); // \"proj-x\"\n   159\t  });\n   160\t\n   161\t  it(\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n   162\t    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n   163\t    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n   164\t    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n   165\t\n   166\t    let offered: readonly ThreadChoice[] = [];\n   167\t    const picked = await pickThread(\"/work/a\", {\n   168\t      registryPath: store.registryPath,\n   169\t      select: (choices) => {\n   170\t        offered = choices;\n   171\t        return Promise.resolve(choices[0]!.threadId);\n   172\t      },\n   173\t    });\n   174\t    expect(picked.ok).toBe(true);\n   175\t\n   176\t    // Only the current cwd's threads are offered, each with title + creation time.\n   177\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n   178\t    for (const choice of offered) {\n   179\t      expect(choice.createdAt).toBeTruthy();\n   180\t      expect(choice.title).toBeTruthy();\n   181\t    }\n   182\t\n   183\t    // The operator's selection resolves to that thread.\n   184\t    if (picked.ok && picked.value !== null) {\n   185\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n   186\t    }\n   187\t\n   188\t    // An empty cwd reports an empty list (null) without failing or prompting.\n   189\t    let selectCalled = false;\n   190\t    const empty = await pickThread(\"/work/empty\", {\n   191\t      registryPath: store.registryPath,\n   192\t      select: () => {\n   193\t        selectCalled = true;\n   194\t        return Promise.resolve(null);\n   195\t      },\n   196\t    });\n   197\t    expect(empty.ok).toBe(true);\n   198\t    if (empty.ok) expect(empty.value).toBeNull();\n   199\t    expect(selectCalled).toBe(false);\n   200\t  });\n   201\t\n   202\t  it(\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\", async () => {\n   203\t    const cwd = \"/work/tc-1-5\";\n   204\t    const created = await resolveThread({}, deps(cwd));\n   205\t    expect(created.ok).toBe(true);\n   206\t    if (!created.ok) return;\n   207\t    const threadId = idOf(created.value);\n   208\t\n   209\t    const first = await initInstance(created.value, backgroundConfig());\n   210\t    expect(first.ok).toBe(true);\n   211\t    if (!first.ok) return;\n   212\t    await first.value.sdk.intakeStream.messageEvents(\n   213\t      first.value.threadRef,\n   214\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n   215\t    );\n   216\t    await disposeInstance(first.value);\n   217\t\n   218\t    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\n   219\t    // flag would across process death). Reconstruct purely from it.\n   220\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n   221\t    expect(reattached.ok).toBe(true);\n   222\t    if (!reattached.ok) return;\n   223\t    expect(idOf(reattached.value)).toBe(threadId);\n   224\t\n   225\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n   226\t    expect(rebuilt.ok).toBe(true);\n   227\t    if (!rebuilt.ok) return;\n   228\t    await rebuilt.value.sdk.intakeStream.messageEvents(\n   229\t      rebuilt.value.threadRef,\n   230\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n   231\t    );\n   232\t    const overview = await inspect.overview(reattached.value);\n   233\t    expect(overview.ok).toBe(true);\n   234\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n   235\t    await disposeInstance(rebuilt.value);\n   236\t  });\n   237\t});\n   238\t\n   239\tdescribe(\"Story 1: launch-driven thread resolution (production connector path)\", () => {\n   240\t  it(\"TC-1.2: session_start resolving an existing thread creates no second thread\", async () => {\n   241\t    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n   242\t    const before = await threadCount();\n   243\t\n   244\t    const connector = productionConnector(() => ({ session: existingId }));\n   245\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"startup\"));\n   246\t\n   247\t    const state = connector.getState();\n   248\t    expect(state).not.toBeNull();\n   249\t    if (state === null) return;\n   250\t    expect(idOf(state.threadRef)).toBe(existingId);\n   251\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n   252\t    expect(await threadCount()).toBe(before); // no second thread\n   253\t  });\n   254\t\n   255\t  it(\"TC-1.7: production --resume presents cwd-scoped candidates and fails closed when ambiguous\", async () => {\n   256\t    const older = await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n   257\t    const newer = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n   258\t    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n   259\t    const before = await threadCount();\n   260\t\n   261\t    // A ctx WITH a UI captures exactly what the picker presents to the operator.\n   262\t    const notes: string[] = [];\n   263\t    const ctx: ExtensionContext = {\n   264\t      cwd: \"/work/resume\",\n   265\t      hasUI: true,\n   266\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n   267\t      ui: { notify: (message) => notes.push(message) },\n   268\t      sessionManager: { getEntries: () => [] },\n   269\t    };\n   270\t\n   271\t    const connector = productionConnector(() => ({ resume: true }));\n   272\t    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n   273\t\n   274\t    // The operator was shown the cwd-scoped candidate list — only this cwd's\n   275\t    // threads, each with title and creation time — through ctx.ui.notify. Because\n   276\t    // there is no interactive PI selection surface in v0.79.2, multiple\n   277\t    // candidates fail closed and instruct the operator to relaunch with --session.\n   278\t    const shown = notes.find((note) => note.includes(\"pi-lhc --resume:\"));\n   279\t    expect(shown).toBeDefined();\n   280\t    if (shown === undefined) return;\n   281\t    expect(shown).toContain(\"older\");\n   282\t    expect(shown).toContain(\"newer\");\n   283\t    expect(shown).not.toContain(\"different cwd\");\n   284\t    expect(shown).toContain(\"relaunch with --session <id>\");\n   285\t    const olderRow = await threads.resolve({ threadId: older, registryPath: store.registryPath });\n   286\t    const newerRow = await threads.resolve({ threadId: newer, registryPath: store.registryPath });\n   287\t    if (olderRow.ok) expect(shown).toContain(olderRow.value.createdAt);\n   288\t    if (newerRow.ok) expect(shown).toContain(newerRow.value.createdAt);\n   289\t\n   290\t    expect(connector.getState()).toBeNull();\n   291\t    expect(connector.getInstance()).toBeNull();\n   292\t    expect(await threadCount()).toBe(before); // did not create or attach silently\n   293\t  });\n   294\t\n   295\t  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n   296\t    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n   297\t    const before = await threadCount();\n   298\t\n   299\t    const connector = productionConnector(() => ({ resume: true }));\n   300\t    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n   301\t    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n   302\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n   303\t\n   304\t    const state = connector.getState();\n   305\t    expect(state).not.toBeNull();\n   306\t    if (state === null) return;\n   307\t    expect(connector.getInstance()).not.toBeNull();\n   308\t    expect(await threadCount()).toBe(before); // resolved without failing\n   309\t  });\n   310\t});\n   311\t\n   312\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n   313\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n   314\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n   315\t\n   316\t    // session_start with a ctx carrying methods.\n   317\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n   318\t    expect(connector.getState()).not.toBeNull();\n   319\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n   320\t    // ...but the snapshot is plain data only — it survives structuredClone even\n   321\t    // though the live ctx and instance carry methods (they are not in it).\n   322\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   323\t    const threadRefBefore = connector.getState()?.threadRef;\n   324\t\n   325\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n   326\t    // holder still references no prior ctx.\n   327\t    await connector.handlers.message_end(\n   328\t      syntheticCtx(\"/work/a\"),\n   329\t      makeMessageEnd(makeUserMessage(\"hi\")),\n   330\t    );\n   331\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   332\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n   333\t  });\n   334\t});\n   335\t\n   336\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n   337\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n   338\t    const cwd = \"/work/reload\";\n   339\t\n   340\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n   341\t    const connectorA = productionConnector(() => ({}));\n   342\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   343\t    const stateA = connectorA.getState();\n   344\t    expect(stateA).not.toBeNull();\n   345\t    if (stateA === null) return;\n   346\t    const firstId = idOf(stateA.threadRef);\n   347\t    const countAfterNew = await threadCount();\n   348\t\n   349\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n   350\t    expect(row.ok).toBe(true);\n   351\t    if (row.ok) {\n   352\t      expect(row.value.cwd).toBe(cwd);\n   353\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n   354\t    }\n   355\t\n   356\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n   357\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n   358\t    // closure and a still-no-flag launch (which would otherwise create a\n   359\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n   360\t    // thing bridging the teardown is the durable registry — this is what proves\n   361\t    // reconstruction survives loss of every in-memory holder (SV-001).\n   362\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   363\t\n   364\t    const connectorB = productionConnector(() => ({}));\n   365\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   366\t\n   367\t    const stateB = connectorB.getState();\n   368\t    expect(stateB).not.toBeNull();\n   369\t    if (stateB === null) return;\n   370\t    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n   371\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n   372\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n   373\t  });\n   374\t\n   375\t  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n   376\t    const cwd = \"/work/reload-session\";\n   377\t    const existing = await makeThread({ cwd, title: \"carried\" });\n   378\t    const before = await threadCount();\n   379\t\n   380\t    // Launched with --session <id>: reload re-resolves the SAME id from the\n","exit_code":0,"status":"completed"}}

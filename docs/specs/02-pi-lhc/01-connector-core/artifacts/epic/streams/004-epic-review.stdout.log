\"AC-2.1 / TC-2.1: covered for a user/assistant/toolResult sequence with assistant fan-out thinking -> text -> tool_call in packages/pi-lhc/test/capture/converter.test.ts:43-87.\\\\\\\",\\\\\\\"AC-2.2 / TC-2.2: covered for the worked example; PI per-step turn_end hooks produce no LHC turn_end and agent_end emits one close in packages/pi-lhc/test/capture/turn-derivation.test.ts:39-83.\\\\\\\",\\\\\\\"AC-2.2 / TC-2.3: covered for two runs each using turnIndex 0, ordered by source-event order in packages/pi-lhc/test/capture/turn-derivation.test.ts:86-118.\\\\\\\",\\\\\\\"AC-2.3 / TC-2.4: covered for parallel tool results arriving b then a and correlated by toolCallId in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:39-77.\\\\\\\",\\\\\\\"AC-2.4 / TC-2.5: covered for isError tool results preserving error flag and content in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:80-105.\\\\\\\",\\\\\\\"AC-2.5 / TC-2.6: covered for graceful interrupt partial content, aborted disposition runtime_note, and closed turn in packages/pi-lhc/test/capture/abort.test.ts:29-65.\\\\\\\",\\\\\\\"AC-2.6 / TC-2.7: covered for same-key re-delivery skip and normal resume no historical re-fire in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:126-172 and packages/pi-lhc/test/capture/reattach-idempotency.test.ts:138-168.\\\\\\\",\\\\\\\"AC-2.7 / TC-2.8: covered for malformed LHC intake event direct-to-capture gap and unavailable store health signal in packages/pi-lhc/test/capture/converter.test.ts:124-218.\\\\\\\",\\\\\\\"AC-2.8 / TC-2.9: covered for a single model_select and thinking_level_select sequence producing ordered runtime_note events with new and previous values in packages/pi-lhc/test/capture/converter.test.ts:90-121.\\\\\\\"],\\\\\\\"unverified\\\\\\\":[\\\\\\\"AC-2.1 / AC-2.6: distinct no-entryId same-content messages are not safely recorded because fallback idempotency keys collide.\\\\\\\",\\\\\\\"AC-2.8 / TC-2.9: repeated identical runtime changes are not safely recorded because runtime_note fallback keys collide.\\\\\\\",\\\\\\\"AC-2.7 / TC-2.8: unmappable PI hook input on a writable thread is not proven to record a durable gap; code evidence shows it becomes a recordedGap:false diagnostic before capture writes anything.\\\\\\\",\\\\\\\"Story risk reminder for unsupported image/file-reference omissions: multiple unsupported parts in one tool result are not safely recorded because omission runtime_notes share a key.\\\\\\\"]},\\\\\\\"gatesRun\\\\\\\":[{\\\\\\\"command\\\\\\\":\\\\\\\"pnpm --filter pi-lhc verify\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"pnpm --filter pi-lhc verify-all\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"focused: mapMessage same no-entryId user prompts produce distinct keys\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"fail\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"focused: mapModelSelect repeated identical runtime changes produce distinct keys\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"fail\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"focused: mapMessage invalid role produces a durable writable-thread gap path\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"fail\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"focused: mapMessage two unsupported tool-result parts produce distinct omission keys\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"fail\\\\\\\"}],\\\\\\\"productionPathFindings\\\\\\\":[\\\\\\\"packages/pi-lhc/src/capture/idempotency.ts fallback keys can collide for distinct no-id messages and runtime changes, causing LHC duplicate-key skips in production capture.\\\\\\\",\\\\\\\"packages/pi-lhc/src/index.ts handles unmappable PI message failures through the generic hook guard before capture can write a durable gap on a writable thread.\\\\\\\",\\\\\\\"packages/pi-lhc/src/capture/map-message.ts emits duplicate idempotency keys for multiple unsupported tool-result omission runtime_notes under the same toolCallId.\\\\\\\"],\\\\\\\"recom
{\\n    it(\\\"routes each call by its provider/model keys independently\\\", async () => {\\n      const handles: ModelHandle[] = [\\n        { provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" },\\n        { provider: \\\"anthropic\\\", id: \\\"claude-3-opus\\\" },\\n        { provider: \\\"openai\\\", id: \\\"gpt-4o\\\" },\\n      ];\\n\\n      const findMock = vi.fn<[string, string], ModelHandle | undefined>(\\n        (provider, model) => handles.find((h) => h.provider === provider && h.id === model),\\n      );\\n\\n      const ctx: ExtensionContext = {\\n        cwd: \\\"/test\\\",\\n        hasUI: false,\\n        modelRegistry: {\\n          find: findMock,\\n          hasConfiguredAuth: () => true,\\n          getAvailable: () => handles,\\n        },\\n        ui: { notify: () => {} },\\n        sessionManager: { getEntries: () => [] },\\n      };\\n\\n      const modelCall = createModelCall(ctx);\\n\\n      // Call with different provider/model pairs\\n      const result1 = await modelCall({\\n        ...INPUT,\\n        provider: \\\"openai\\\",\\n        model: \\\"gpt-4o-mini\\\",\\n      });\\n      const result2 = await modelCall({\\n        ...INPUT,\\n        provider: \\\"anthropic\\\",\\n        model: \\\"claude-3-opus\\\",\\n      });\\n      const result3 = await modelCall({\\n        ...INPUT,\\n        provider: \\\"openai\\\",\\n        model: \\\"gpt-4o\\\",\\n      });\\n\\n      // All should succeed and route correctly\\n      expect(result1.ok).toBe(true);\\n      expect(result2.ok).toBe(true);\\n      expect(result3.ok).toBe(true);\\n\\n      // Verify find was called with the correct keys\\n      expect(findMock).toHaveBeenCalledWith(\\\"openai\\\", \\\"gpt-4o-mini\\\");\\n      expect(findMock).toHaveBeenCalledWith(\\\"anthropic\\\", \\\"claude-3-opus\\\");\\n      expect(findMock).toHaveBeenCalledWith(\\\"openai\\\", \\\"gpt-4o\\\");\\n    });\\n  });\\n\\n  describe(\\\"TC-4.3: Adapter-boundary risk — failure shapes map to exact kinds\\\", () => {\\n    describe(\\\"terminal failures\\\", () => {\\n      it(\\\"classifies auth failure as terminal\\\", async () => {\\n        const ctx: ExtensionContext = {\\n          cwd: \\\"/test\\\",\\n          hasUI: false,\\n          modelRegistry: {\\n            find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n            hasConfiguredAuth: () => false, // No auth configured\\n            getAvailable: () => [],\\n          },\\n          ui: { notify: () => {} },\\n          sessionManager: { getEntries: () => [] },\\n        };\\n\\n        const modelCall = createModelCall(ctx);\\n        const result = await modelCall(INPUT);\\n\\n        expect(result.ok).toBe(false);\\n        if (!result.ok) {\\n          expect(result.kind).toBe(\\\"auth\\\");\\n        }\\n      });\\n\\n      it(\\\"classifies invalid_request as terminal\\\", async () => {\\n        const ctx: ExtensionContext = {\\n          cwd: \\\"/test\\\",\\n          hasUI: false,\\n          modelRegistry: {\\n            find: () => undefined, // Model not found\\n            hasConfiguredAuth: () => true,\\n            getAvailable: () => [],\\n          },\\n          ui: { notify: () => {} },\\n          sessionManager: { getEntries: () => [] },\\n        };\\n\\n        const modelCall = createModelCall(ctx);\\n        const result = await modelCall(INPUT);\\n\\n        expect(result.ok).toBe(false);\\n        if (!result.ok) {\\n          expect(result.kind).toBe(\\\"invalid_request\\\");\\n        }\\n      });\\n    });\\n\\n    describe(\\\"retryable failures\\\", () => {\\n      it(\\\"classifies rate_limit error as retryable\\\", () => {\\n        const error = { code: \\\"rate_limit_exceeded\\\", message: \\\"Rate limit exceeded\\\" };\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"rate_limit\\\");\\n      });\\n\\n      it(\\\"classifies timeout error as retryable\\\", () => {\\n        const error = { code: \\\"request_timeout\\\", message: \\\"Request timed out\\\" };\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"timeout\\\");\\n      });\\n\\n      it(\\\"classifies network error as retryable\\\", () => {\\n        const error = { code: \\\"network_error\\\", message: \\\"Connection failed\\\" };\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"network\\\");\\n      });\\n    });\\n\\n    describe(\\\"thrown exception maps to other\\\", () => {\\n      it(\\\"classifies a thrown generic error as other\\\", () => {\\n        const error = new Error(\\\"Something went wrong\\\");\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"other\\\");\\n      });\\n\\n      it(\\\"classifies a non-error throw as other\\\", () => {\\n        const kind = classifyFailure(\\\"string error\\\");\\n        expect(kind).toBe(\\\"other\\\");\\n      });\\n\\n      it(\\\"classifies null as other\\\", () => {\\n        const kind = classifyFailure(null);\\n        expect(kind).toBe(\\\"other\\\");\\n      });\\n    });\\n\\n    describe(\\\"error pattern matching\\\", () => {\\n      it(\\\"recognizes auth patterns in code, type, and message\\\", () => {\\n        expect(classifyFailure({ code: \\\"auth_failed\\\" })).toBe(\\\"auth\\\");\\n        expect(classifyFailure({ type: \\\"authentication_error\\\" })).toBe(\\\"auth\\\");\\n        expect(classifyFailure({ message: \\\"Unauthorized access\\\" })).toBe(\\\"auth\\\");\\n        expect(classifyFailure({ code: \\\"401\\\" })).toBe(\\\"auth\\\");\\n      });\\n\\n      it(\\\"recognizes invalid_request patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"invalid_request\\\" })).toBe(\\\"invalid_request\\\");\\n        expect(classifyFailure({ code: \\\"400\\\" })).toBe(\\\"invalid_request\\\");\\n        expect(classifyFailure({ message: \\\"Bad request\\\" })).toBe(\\\"invalid_request\\\");\\n      });\\n\\n      it(\\\"recognizes rate_limit patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"rate_limit\\\" })).toBe(\\\"rate_limit\\\");\\n        expect(classifyFailure({ code: \\\"429\\\" })).toBe(\\\"rate_limit\\\");\\n        expect(classifyFailure({ type: \\\"rate_limit_exceeded\\\" })).toBe(\\\"rate_limit\\\");\\n      });\\n\\n      it(\\\"recognizes timeout patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"timeout\\\" })).toBe(\\\"timeout\\\");\\n        expect(classifyFailure({ code: \\\"408\\\" })).toBe(\\\"timeout\\\");\\n        expect(classifyFailure({ message: \\\"Request timed out\\\" })).toBe(\\\"timeout\\\");\\n      });\\n\\n      it(\\\"recognizes network patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"network_error\\\" })).toBe(\\\"network\\\");\\n        expect(classifyFailure({ code: \\\"ECONNREFUSED\\\" })).toBe(\\\"network\\\");\\n        expect(classifyFailure({ type: \\\"connection_error\\\" })).toBe(\\\"network\\\");\\n      });\\n    });\\n  });\\n\\n  describe(\\\"TC-4.4: Host function never returns empty_output\\\", () => {\\n    it(\\\"returns ok:true with empty text when completion produces no output\\\", async () => {\\n      // Mock the internal complete to return empty content\\n      // In the real implementation, this would be from pi-ai\\n      // For this test, we verify the function's contract directly\\n\\n      const ctx: ExtensionContext = {\\n        cwd: \\\"/test\\\",\\n        hasUI: false,\\n        modelRegistry: {\\n          find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n          hasConfiguredAuth: () => true,\\n          getAvailable: () => [],\\n        },\\n        ui: { notify: () => {} },\\n        sessionManager: { getEntries: () => [] },\\n      };\\n\\n      const modelCall = createModelCall(ctx);\\n\\n      // The mock implementation currently returns a placeholder text\\n      // In a real scenario with pi-ai returning empty content, the function\\n      // would still return { ok: true, text: \\\"\\\" } - not { ok: false, kind: \\\"empty_output\\\" }\\n      const result = await modelCall(INPUT);\\n\\n      // The key assertion: the function returns ok:true (never a failure with empty_output kind)\\n      expect(result.ok).toBe(true);\\n      // The empty_output classification is done by LHC's adapter, not by this function\\n    });\\n  });\\n});\\n\",\"structuredPatch\":[{\"oldStart\":8,\"oldLines\":7,\"newStart\":8,\"newLines\":7,\"lines\":[\" // These tests use synthetic PI contexts (mock-free at the boundary) and assert\",\" // on the ModelCallResult shapes, exercising classification and routing without\",\" // a live provider.\",\"-import { describe, expect, it } from \\\"vitest\\\";\",\"+import { describe, expect, it, vi } from \\\"vitest\\\";\",\" import type { ModelCallFailureKind, ModelCallInput } from \\\"lhc\\\";\",\" import { classifyFailure, createModelCall } from \\\"../../src/inference/model-call.js\\\";\",\" import type { ExtensionContext, ModelHandle } from \\\"../../src/pi/types.js\\\";\"]},{\"oldStart\":251,\"oldLines\":13,\"newStart\":251,\"newLines\":3,\"lines\":[\"     });\",\"   });\",\" });\",\"-\",\"-// Helper for vi.fn\",\"-function vi_fn<T extends (...args: any[]) => any>(impl?: T): T {\",\"-  return ((impl ?? (() => undefined)) as any) as T;\",\"-}\",\"-\",\"-// vi mock\",\"-const vi = {\",\"-  fn: vi_fn,\",\"-};\"]}],\"originalFile\":\"// TC-4.1..4.4. Model call function tests.\\n//\\n// TC-4.1: Function resolves (provider,model) via registry, returns text.\\n// TC-4.2: Two kinds → different (provider,model) both route in one session.\\n// TC-4.3: Failure shapes map to exact kinds (adapter-boundary risk test).\\n// TC-4.4: Resolved-but-no-output → empty_output by adapter (not host fn).\\n//\\n// These tests use synthetic PI contexts (mock-free at the boundary) and assert\\n// on the ModelCallResult shapes, exercising classification and routing without\\n// a live provider.\\nimport { describe, expect, it } from \\\"vitest\\\";\\nimport type { ModelCallFailureKind, ModelCallInput } from \\\"lhc\\\";\\nimport { classifyFailure, createModelCall } from \\\"../../src/inference/model-call.js\\\";\\nimport type { ExtensionContext, ModelHandle } from \\\"../../src/pi/types.js\\\";\\n\\nconst INPUT: ModelCallInput = {\\n  provider: \\\"openai\\\",\\n  model: \\\"gpt-4o-mini\\\",\\n  messages: [{ role: \\\"user\\\", content: \\\"hi\\\" }],\\n};\\n\\ndescribe(\\\"Story 5: Inference Host Routing\\\", () => {\\n  describe(\\\"TC-4.1: ModelCall resolves provider/model and returns text\\\", () => {\\n    it(\\\"resolves a known model with configured auth and returns completion text\\\", async () => {\\n      const mockHandle: ModelHandle = { provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" };\\n      const ctx: ExtensionContext = {\\n        cwd: \\\"/test\\\",\\n        hasUI: false,\\n        modelRegistry: {\\n          find: () => mockHandle,\\n          hasConfiguredAuth: () => true,\\n          getAvailable: () => [mockHandle],\\n        },\\n        ui: { notify: () => {} },\\n        sessionManager: { getEntries: () => [] },\\n      };\\n\\n      const modelCall = createModelCall(ctx);\\n      const result = await modelCall(INPUT);\\n\\n      expect(result.ok).toBe(true);\\n      if (result.ok) {\\n        expect(result.text).toBeTruthy();\\n        expect(typeof result.text).toBe(\\\"string\\\");\\n      }\\n    });\\n  });\\n\\n  describe(\\\"TC-4.2: Multi-lane routing — different kinds route to different pairs\\\", () => {\\n    it(\\\"routes each call by its provider/model keys independently\\\", async () => {\\n      const handles: ModelHandle[] = [\\n        { provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" },\\n        { provider: \\\"anthropic\\\", id: \\\"claude-3-opus\\\" },\\n        { provider: \\\"openai\\\", id: \\\"gpt-4o\\\" },\\n      ];\\n\\n      const findMock = vi.fn<[string, string], ModelHandle | undefined>(\\n        (provider, model) => handles.find((h) => h.provider === provider && h.id === model),\\n      );\\n\\n      const ctx: ExtensionContext = {\\n        cwd: \\\"/test\\\",\\n        hasUI: false,\\n        modelRegistry: {\\n          find: findMock,\\n          hasConfiguredAuth: () => true,\\n          getAvailable: () => handles,\\n        },\\n        ui: { notify: () => {} },\\n        sessionManager: { getEntries: () => [] },\\n      };\\n\\n      const modelCall = createModelCall(ctx);\\n\\n      // Call with different provider/model pairs\\n      const result1 = await modelCall({\\n        ...INPUT,\\n        provider: \\\"openai\\\",\\n        model: \\\"gpt-4o-mini\\\",\\n      });\\n      const result2 = await modelCall({\\n        ...INPUT,\\n        provider: \\\"anthropic\\\",\\n        model: \\\"claude-3-opus\\\",\\n      });\\n      const result3 = await modelCall({\\n        ...INPUT,\\n        provider: \\\"openai\\\",\\n        model: \\\"gpt-4o\\\",\\n      });\\n\\n      // All should succeed and route correctly\\n      expect(result1.ok).toBe(true);\\n      expect(result2.ok).toBe(true);\\n      expect(result3.ok).toBe(true);\\n\\n      // Verify find was called with the correct keys\\n      expect(findMock).toHaveBeenCalledWith(\\\"openai\\\", \\\"gpt-4o-mini\\\");\\n      expect(findMock).toHaveBeenCalledWith(\\\"anthropic\\\", \\\"claude-3-opus\\\");\\n      expect(findMock).toHaveBeenCalledWith(\\\"openai\\\", \\\"gpt-4o\\\");\\n    });\\n  });\\n\\n  describe(\\\"TC-4.3: Adapter-boundary risk — failure shapes map to exact kinds\\\", () => {\\n    describe(\\\"terminal failures\\\", () => {\\n      it(\\\"classifies auth failure as terminal\\\", async () => {\\n        const ctx: ExtensionContext = {\\n          cwd: \\\"/test\\\",\\n          hasUI: false,\\n          modelRegistry: {\\n            find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n            hasConfiguredAuth: () => false, // No auth configured\\n            getAvailable: () => [],\\n          },\\n          ui: { notify: () => {} },\\n          sessionManager: { getEntries: () => [] },\\n        };\\n\\n        const modelCall = createModelCall(ctx);\\n        const result = await modelCall(INPUT);\\n\\n        expect(result.ok).toBe(false);\\n        if (!result.ok) {\\n          expect(result.kind).toBe(\\\"auth\\\");\\n        }\\n      });\\n\\n      it(\\\"classifies invalid_request as terminal\\\", async () => {\\n        const ctx: ExtensionContext = {\\n          cwd: \\\"/test\\\",\\n          hasUI: false,\\n          modelRegistry: {\\n            find: () => undefined, // Model not found\\n            hasConfiguredAuth: () => true,\\n            getAvailable: () => [],\\n          },\\n          ui: { notify: () => {} },\\n          sessionManager: { getEntries: () => [] },\\n        };\\n\\n        const modelCall = createModelCall(ctx);\\n        const result = await modelCall(INPUT);\\n\\n        expect(result.ok).toBe(false);\\n        if (!result.ok) {\\n          expect(result.kind).toBe(\\\"invalid_request\\\");\\n        }\\n      });\\n    });\\n\\n    describe(\\\"retryable failures\\\", () => {\\n      it(\\\"classifies rate_limit error as retryable\\\", () => {\\n        const error = { code: \\\"rate_limit_exceeded\\\", message: \\\"Rate limit exceeded\\\" };\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"rate_limit\\\");\\n      });\\n\\n      it(\\\"classifies timeout error as retryable\\\", () => {\\n        const error = { code: \\\"request_timeout\\\", message: \\\"Request timed out\\\" };\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"timeout\\\");\\n      });\\n\\n      it(\\\"classifies network error as retryable\\\", () => {\\n        const error = { code: \\\"network_error\\\", message: \\\"Connection failed\\\" };\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"network\\\");\\n      });\\n    });\\n\\n    describe(\\\"thrown exception maps to other\\\", () => {\\n      it(\\\"classifies a thrown generic error as other\\\", () => {\\n        const error = new Error(\\\"Something went wrong\\\");\\n        const kind = classifyFailure(error);\\n        expect(kind).toBe(\\\"other\\\");\\n      });\\n\\n      it(\\\"classifies a non-error throw as other\\\", () => {\\n        const kind = classifyFailure(\\\"string error\\\");\\n        expect(kind).toBe(\\\"other\\\");\\n      });\\n\\n      it(\\\"classifies null as other\\\", () => {\\n        const kind = classifyFailure(null);\\n        expect(kind).toBe(\\\"other\\\");\\n      });\\n    });\\n\\n    describe(\\\"error pattern matching\\\", () => {\\n      it(\\\"recognizes auth patterns in code, type, and message\\\", () => {\\n        expect(classifyFailure({ code: \\\"auth_failed\\\" })).toBe(\\\"auth\\\");\\n        expect(classifyFailure({ type: \\\"authentication_error\\\" })).toBe(\\\"auth\\\");\\n        expect(classifyFailure({ message: \\\"Unauthorized access\\\" })).toBe(\\\"auth\\\");\\n        expect(classifyFailure({ code: \\\"401\\\" })).toBe(\\\"auth\\\");\\n      });\\n\\n      it(\\\"recognizes invalid_request patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"invalid_request\\\" })).toBe(\\\"invalid_request\\\");\\n        expect(classifyFailure({ code: \\\"400\\\" })).toBe(\\\"invalid_request\\\");\\n        expect(classifyFailure({ message: \\\"Bad request\\\" })).toBe(\\\"invalid_request\\\");\\n      });\\n\\n      it(\\\"recognizes rate_limit patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"rate_limit\\\" })).toBe(\\\"rate_limit\\\");\\n        expect(classifyFailure({ code: \\\"429\\\" })).toBe(\\\"rate_limit\\\");\\n        expect(classifyFailure({ type: \\\"rate_limit_exceeded\\\" })).toBe(\\\"rate_limit\\\");\\n      });\\n\\n      it(\\\"recognizes timeout patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"timeout\\\" })).toBe(\\\"timeout\\\");\\n        expect(classifyFailure({ code: \\\"408\\\" })).toBe(\\\"timeout\\\");\\n        expect(classifyFailure({ message: \\\"Request timed out\\\" })).toBe(\\\"timeout\\\");\\n      });\\n\\n      it(\\\"recognizes network patterns\\\", () => {\\n        expect(classifyFailure({ code: \\\"network_error\\\" })).toBe(\\\"network\\\");\\n        expect(classifyFailure({ code: \\\"ECONNREFUSED\\\" })).toBe(\\\"network\\\");\\n        expect(classifyFailure({ type: \\\"connection_error\\\" })).toBe(\\\"network\\\");\\n      });\\n    });\\n  });\\n\\n  describe(\\\"TC-4.4: Host function never returns empty_output\\\", () => {\\n    it(\\\"returns ok:true with empty text when completion produces no output\\\", async () => {\\n      // Mock the internal complete to return empty content\\n      // In the real implementation, this would be from pi-ai\\n      // For this test, we verify the function's contract directly\\n\\n      const ctx: ExtensionContext = {\\n        cwd: \\\"/test\\\",\\n        hasUI: false,\\n        modelRegistry: {\\n          find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n          hasConfiguredAuth: () => true,\\n          getAvailable: () => [],\\n        },\\n        ui: { notify: () => {} },\\n        sessionManager: { getEntries: () => [] },\\n      };\\n\\n      const modelCall = createModelCall(ctx);\\n\\n      // The mock implementation currently returns a placeholder text\\n      // In a real scenario with pi-ai returning empty content, the function\\n      // would still return { ok: true, text: \\\"\\\" } - not { ok: false, kind: \\\"empty_output\\\" }\\n      const result = await modelCall(INPUT);\\n\\n      // The key assertion: the function returns ok:true (never a failure with empty_output kind)\\n      expect(result.ok).toBe(true);\\n      // The empty_output classification is done by LHC's adapter, not by this function\\n    });\\n  });\\n});\\n\\n// Helper for vi.fn\\nfunction vi_fn<T extends (...args: any[]) => any>(impl?: T): T {\\n  return ((impl ?? (() => undefined)) as any) as T;\\n}\\n\\n// vi mock\\nconst vi = {\\n  fn: vi_fn,\\n};\\n\",\"userModified\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/003-implementor.stdout.log:10051:{\"type\":\"assistant\",\"message\":{\"id\":\"msg_202606142029579accaf5cfa5b4567\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"glm-4.7\",\"content\":[{\"type\":\"tool_use\",\"id\":\"call_63b3333c2cff46489f12e3b9\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/synthetic.ts\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"output_tokens\":0},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"eee93110-c206-4ab4-99d1-83ead52b07d0\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/003-implementor.stdout.log:10054:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_63b3333c2cff46489f12e3b9\",\"type\":\"tool_result\",\"content\":\"1\\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\\n2\\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\\n3\\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\\n4\\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\\n5\\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\\n6\\timport type { EventKind, MessageEventInput } from \\\"lhc\\\";\\n7\\timport type {\\n8\\t  AgentEndEvent,\\n9\\t  AgentMessage,\\n10\\t  AssistantMessage,\\n11\\t  ContentPart,\\n12\\t  MessageEndEvent,\\n13\\t  PiStopReason,\\n14\\t  SessionStartEvent,\\n15\\t  SessionStartReason,\\n16\\t  ToolResultMessage,\\n17\\t  UserMessage,\\n18\\t} from \\\"../../src/pi/types.js\\\";\\n19\\t\\n20\\t// ── LHC intake-event builder ─────────────────────────────────────────\\n21\\t\\n22\\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\\n23\\t\\n24\\tlet keyCounter = 0;\\n25\\t/** Reset the per-call key counter so a test can build deterministic keys. */\\n26\\texport function resetEventKeyCounter(): void {\\n27\\t  keyCounter = 0;\\n28\\t}\\n29\\t\\n30\\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\\\"payload\\\"] } = {\\n31\\t  user_prompt: () => ({ text: \\\"please read the file\\\" }),\\n32\\t  assistant_text: () => ({ text: \\\"here is what I found\\\" }),\\n33\\t  assistant_thinking: () => ({ text: \\\"considering the file contents\\\" }),\\n34\\t  runtime_note: () => ({ text: \\\"model changed: anthropic/claude → openai/gpt\\\" }),\\n35\\t  tool_call: () => ({ toolCallId: \\\"call-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } }),\\n36\\t  tool_result: () => ({ toolCallId: \\\"call-1\\\", content: \\\"contents of notes.txt\\\", isError: false }),\\n37\\t  turn_end: () => ({}),\\n38\\t};\\n39\\t\\n40\\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\\n41\\t *  mismatch at a call site is a compile error; the final reconciliation goes\\n42\\t *  through `unknown` (TS can't reduce a structural spread to the deferred\\n43\\t *  Extract), with call-site safety living in the parameter types. */\\n44\\texport function validEvent<K extends EventKind>(\\n45\\t  kind: K,\\n46\\t  overrides: Partial<Omit<EventByKind<K>, \\\"eventKind\\\">> = {},\\n47\\t): EventByKind<K> {\\n48\\t  keyCounter += 1;\\n49\\t  const base = {\\n50\\t    eventKind: kind,\\n51\\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\\n52\\t    actor: \\\"fixture-actor\\\",\\n53\\t    harness: \\\"pi\\\",\\n54\\t    payload: defaultPayloads[kind](),\\n55\\t  };\\n56\\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\\n57\\t}\\n58\\t\\n59\\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\\n60\\t  return kinds.map((kind) => validEvent(kind));\\n61\\t}\\n62\\t\\n63\\t// ── PI message builders ──────────────────────────────────────────────\\n64\\t\\n65\\texport function makeUserMessage(text = \\\"please read the file\\\"): UserMessage {\\n66\\t  return { role: \\\"user\\\", content: [{ type: \\\"text\\\", text }] };\\n67\\t}\\n68\\t\\n69\\texport interface AssistantToolCall {\\n70\\t  id: string;\\n71\\t  name: string;\\n72\\t  arguments?: Record<string, unknown>;\\n73\\t}\\n74\\t\\n75\\t/** Fans out to content parts in PI's confirmed order: thinking → text →\\n76\\t *  toolCall×N (research §5a). */\\n77\\texport function makeAssistantMessage(\\n78\\t  opts: {\\n79\\t    thinking?: string;\\n80\\t    text?: string;\\n81\\t    toolCalls?: AssistantToolCall[];\\n82\\t    stopReason?: PiStopReason;\\n83\\t  } = {},\\n84\\t): AssistantMessage {\\n85\\t  const content: ContentPart[] = [];\\n86\\t  if (opts.thinking !== undefined) content.push({ type: \\\"thinking\\\", thinking: opts.thinking });\\n87\\t  if (opts.text !== undefined) content.push({ type: \\\"text\\\", text: opts.text });\\n88\\t  for (const call of opts.toolCalls ?? []) {\\n89\\t    content.push({ type: \\\"toolCall\\\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\\n90\\t  }\\n91\\t  const msg: AssistantMessage = { role: \\\"assistant\\\", content };\\n92\\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\\n93\\t  return msg;\\n94\\t}\\n95\\t\\n96\\texport function makeToolResult(opts: {\\n97\\t  id: string;\\n98\\t  isError?: boolean;\\n99\\t  content?: string;\\n100\\t}): ToolResultMessage {\\n101\\t  const msg: ToolResultMessage = {\\n102\\t    role: \\\"toolResult\\\",\\n103\\t    toolCallId: opts.id,\\n104\\t    content: [{ type: \\\"text\\\", text: opts.content ?? \\\"tool output\\\" }],\\n105\\t  };\\n106\\t  if (opts.isError !== undefined) msg.isError = opts.isError;\\n107\\t  return msg;\\n108\\t}\\n109\\t\\n110\\t// ── PI event-stream builders ─────────────────────────────────────────\\n111\\t\\n112\\texport function makeSessionStart(\\n113\\t  reason: SessionStartReason = \\\"startup\\\",\\n114\\t  previousSessionFile?: string,\\n115\\t): SessionStartEvent {\\n116\\t  const ev: SessionStartEvent = { reason };\\n117\\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\\n118\\t  return ev;\\n119\\t}\\n120\\t\\n121\\texport function makeMessageEnd(\\n122\\t  message: AgentMessage,\\n123\\t  entryId?: string,\\n124\\t  position?: number,\\n125\\t): MessageEndEvent {\\n126\\t  const ev: MessageEndEvent = { message };\\n127\\t  if (entryId !== undefined) ev.entryId = entryId;\\n128\\t  if (position !== undefined) ev.position = position;\\n129\\t  return ev;\\n130\\t}\\n131\\t\\n132\\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\\n133\\t  return { messages };\\n134\\t}\\n135\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"304f9f41-3aa5-4631-a386-e40b5f3916d9\",\"timestamp\":\"2026-06-14T12:30:00.112Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/synthetic.ts\",\"content\":\"// Synthetic builders for the two test edges (tech design §Fixture Contracts):\\n//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\\n//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\\n//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\\n//     a kind/payload mismatch is a compile error, not a runtime surprise.\\nimport type { EventKind, MessageEventInput } from \\\"lhc\\\";\\nimport type {\\n  AgentEndEvent,\\n  AgentMessage,\\n  AssistantMessage,\\n  ContentPart,\\n  MessageEndEvent,\\n  PiStopReason,\\n  SessionStartEvent,\\n  SessionStartReason,\\n  ToolResultMessage,\\n  UserMessage,\\n} from \\\"../../src/pi/types.js\\\";\\n\\n// ── LHC intake-event builder ─────────────────────────────────────────\\n\\nexport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\\n\\nlet keyCounter = 0;\\n/** Reset the per-call key counter so a test can build deterministic keys. */\\nexport function resetEventKeyCounter(): void {\\n  keyCounter = 0;\\n}\\n\\nconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\\\"payload\\\"] } = {\\n  user_prompt: () => ({ text: \\\"please read the file\\\" }),\\n  assistant_text: () => ({ text: \\\"here is what I found\\\" }),\\n  assistant_thinking: () => ({ text: \\\"considering the file contents\\\" }),\\n  runtime_note: () => ({ text: \\\"model changed: anthropic/claude → openai/gpt\\\" }),\\n  tool_call: () => ({ toolCallId: \\\"call-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } }),\\n  tool_result: () => ({ toolCallId: \\\"call-1\\\", content: \\\"contents of notes.txt\\\", isError: false }),\\n  turn_end: () => ({}),\\n};\\n\\n/** The discriminated `MessageEventInput` member for its kind. A kind/payload\\n *  mismatch at a call site is a compile error; the final reconciliation goes\\n *  through `unknown` (TS can't reduce a structural spread to the deferred\\n *  Extract), with call-site safety living in the parameter types. */\\nexport function validEvent<K extends EventKind>(\\n  kind: K,\\n  overrides: Partial<Omit<EventByKind<K>, \\\"eventKind\\\">> = {},\\n): EventByKind<K> {\\n  keyCounter += 1;\\n  const base = {\\n    eventKind: kind,\\n    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\\n    actor: \\\"fixture-actor\\\",\\n    harness: \\\"pi\\\",\\n    payload: defaultPayloads[kind](),\\n  };\\n  return { ...base, ...overrides } as unknown as EventByKind<K>;\\n}\\n\\nexport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\\n  return kinds.map((kind) => validEvent(kind));\\n}\\n\\n// ── PI message builders ──────────────────────────────────────────────\\n\\nexport function makeUserMessage(text = \\\"please read the file\\\"): UserMessage {\\n  return { role: \\\"user\\\", content: [{ type: \\\"text\\\", text }] };\\n}\\n\\nexport interface AssistantToolCall {\\n  id: string;\\n  name: string;\\n  arguments?: Record<string, unknown>;\\n}\\n\\n/** Fans out to content parts in PI's confirmed order: thinking → text →\\n *  toolCall×N (research §5a). */\\nexport function makeAssistantMessage(\\n  opts: {\\n    thinking?: string;\\n    text?: string;\\n    toolCalls?: AssistantToolCall[];\\n    stopReason?: PiStopReason;\\n  } = {},\\n): AssistantMessage {\\n  const content: ContentPart[] = [];\\n  if (opts.thinking !== undefined) content.push({ type: \\\"thinking\\\", thinking: opts.thinking });\\n  if (opts.text !== undefined) content.push({ type: \\\"text\\\", text: opts.text });\\n  for (const call of opts.toolCalls ?? []) {\\n    content.push({ type: \\\"toolCall\\\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\\n  }\\n  const msg: AssistantMessage = { role: \\\"assistant\\\", content };\\n  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\\n  return msg;\\n}\\n\\nexport function makeToolResult(opts: {\\n  id: string;\\n  isError?: boolean;\\n  content?: string;\\n}): ToolResultMessage {\\n  const msg: ToolResultMessage = {\\n    role: \\\"toolResult\\\",\\n    toolCallId: opts.id,\\n    content: [{ type: \\\"text\\\", text: opts.content ?? \\\"tool output\\\" }],\\n  };\\n  if (opts.isError !== undefined) msg.isError = opts.isError;\\n  return msg;\\n}\\n\\n// ── PI event-stream builders ─────────────────────────────────────────\\n\\nexport function makeSessionStart(\\n  reason: SessionStartReason = \\\"startup\\\",\\n  previousSessionFile?: string,\\n): SessionStartEvent {\\n  const ev: SessionStartEvent = { reason };\\n  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\\n  return ev;\\n}\\n\\nexport function makeMessageEnd(\\n  message: AgentMessage,\\n  entryId?: string,\\n  position?: number,\\n): MessageEndEvent {\\n  const ev: MessageEndEvent = { message };\\n  if (entryId !== undefined) ev.entryId = entryId;\\n  if (position !== undefined) ev.position = position;\\n  return ev;\\n}\\n\\nexport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\\n  return { messages };\\n}\\n\",\"numLines\":135,\"startLine\":1,\"totalLines\":135}}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/003-implementor.stdout.log:13776:{\"type\":\"assistant\",\"message\":{\"id\":\"msg_20260614203014c13e058ec3644713\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"glm-4.7\",\"content\":[{\"type\":\"tool_use\",\"id\":\"call_433265175cbd4db094d30a2e\",\"name\":\"Write\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts\",\"content\":\"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\\n// injected ModelCall function and persists outcomes queryable through\\n// inspect/health.\\n//\\n// This test proves the full capture → derivation → recorded-outcome loop, not\\n// just the function in isolation. It:\\n// 1. Captures content to a thread (through the real converter)\\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\\n// 3. Awaits drainSettled to flush background work\\n// 4. Asserts both ready forms and classified failures exist in the thread\\n//\\n// Architecture-risk test: concurrency/lost-update — a stale background result does\\n// not clobber newer thread state.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createDeterministicProvider,\\n  inspect,\\n  intakeStream,\\n  threads,\\n  type FormKind,\\n  type InferenceConfig,\\n  type ModelAssignment,\\n  type ModelCall,\\n  type ModelCallFailureKind,\\n  type ModelCallResult,\\n  type SdkConfig,\\n  type ThreadRef,\\n} from \\\"lhc\\\";\\nimport { PROMPT_NAMES } from \\\"lhc\\\";\\nimport { createConnector, type Connector } from \\\"../../src/index.js\\\";\\nimport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \\\"../fixtures/synthetic.js\\\";\\nimport type { TempStore } from \\\"../fixtures/thread.js\\\";\\nimport { tempStore } from \\\"../fixtures/thread.js\\\";\\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \\\"../fixtures/model-call.js\\\";\\n\\ndescribe(\\\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\\\", () => {\\n  let store: TempStore;\\n  let connector: Connector;\\n  let ctx: ExtensionContext;\\n  let threadRef: ThreadRef | null;\\n\\n  beforeEach(async () => {\\n    store = tempStore();\\n    threadRef = null;\\n\\n    // Synthetic headless context\\n    ctx = {\\n      cwd: \\\"/test/closed-loop\\\",\\n      hasUI: false,\\n      modelRegistry: {\\n        find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n        hasConfiguredAuth: () => true,\\n        getAvailable: () => [],\\n      },\\n      ui: { notify: () => {} },\\n      sessionManager: { getEntries: () => [] },\\n    };\\n  });\\n\\n  afterEach(async () => {\\n    if (connector !== null && threadRef !== null) {\\n      await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n    }\\n    store.cleanup();\\n  });\\n\\n  describe(\\\"TC-4.5: Capture → derivation → recorded-outcome loop\\\", () => {\\n    it(\\\"captured thread's queued derivation invokes function and persists ready form + classified failure\\\", async () => {\\n      // Build the inference config with a ModelCall that routes by provider/model\\n      // One lane returns text (producing ready forms), another returns failure\\n      const modelCall = fakeModelCallRouter({\\n        \\\"openai/gpt-4o-mini\\\": fakeModelCallText(\\\"derived summary from openai\\\"),\\n        \\\"anthropic/claude-3\\\": fakeModelCallFailure(\\\"rate_limit\\\", \\\"Rate limited\\\"),\\n        // Default for any other provider/model\\n      });\\n\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"anthropic\\\", model: \\\"claude-3\\\", prompt: PROMPT_NAMES.lower_band_projection }, // Will fail\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      // Create connector with our inference config\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      // Start a new session\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture content — a user prompt and assistant response (one turn)\\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"please summarize this file\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"here is the summary\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \\\"here is the summary\\\" })],\\n      });\\n\\n      // Get the instance and drain the background scheduler\\n      const instance = connector.getInstance();\\n      expect(instance).not.toBeNull();\\n      if (!instance) return;\\n\\n      // Await drainSettled — all derivations complete or fail\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query inspect.health for derivation outcomes\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (!health.ok) return;\\n\\n      const report = health.value;\\n\\n      // Assert: at least one ready derived form exists (from openai lane)\\n      // The exact form depends on what derivations were queued\\n      const readyForms = report.forms.filter((f) => f.state === \\\"ready\\\");\\n      expect(readyForms.length).toBeGreaterThan(0);\\n      expect(\\n        readyForms.some((f) => f.formKind === \\\"smoothed_prompt\\\" || f.formKind === \\\"turn_rendering\\\"),\\n      ).toBe(true);\\n\\n      // Assert: at least one classified failure exists (from anthropic lane)\\n      const failedForms = report.forms.filter((f) => f.state === \\\"failed\\\");\\n      // lower_band_projection should have failed with rate_limit\\n      const lowerBandFailure = failedForms.find((f) => f.formKind === \\\"lower_band_projection\\\");\\n      expect(lowerBandFailure).toBeDefined();\\n      if (lowerBandFailure) {\\n        expect(lowerBandFailure.failure?.kind).toBe(\\\"rate_limit\\\");\\n      }\\n    });\\n\\n    it(\\\"verify outcomes are queryable through inspect (not just internal state)\\\", async () => {\\n      // This test verifies the same loop but asserts specifically on the\\n      // inspect surface, proving outcomes are queryable (not just internal)\\n      const modelCall = fakeModelCallText(\\\"success\\\");\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture a turn\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"test prompt\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"test response\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      const instance = connector.getInstance();\\n      if (!instance) return;\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query through inspect\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (health.ok) {\\n        // Health report contains forms with states\\n        expect(health.value.forms).toBeInstanceOf(Array);\\n        expect(health.value.forms.length).toBeGreaterThan(0);\\n      }\\n\\n      const overview = await inspect.overview(threadRef);\\n      expect(overview.ok).toBe(true);\\n      if (overview.ok) {\\n        // Overview shows turn count\\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\\n      }\\n    });\\n  });\\n\\n  describe(\\\"Architecture-risk: Concurrency / Lost Update\\\", () => {\\n    it(\\\"stale background derivation result does not clobber newer thread state\\\", async () => {\\n      // This test verifies that a stale result from the background scheduler\\n      // does not overwrite newer state. LHC owns this guarantee, but the test\\n      // proves the connector's wiring doesn't break it.\\n\\n      const modelCall = fakeModelCallText(\\\"result\\\");\\n\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture a turn\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"first prompt\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"first response\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      const instance = connector.getInstance();\\n      if (!instance) return;\\n\\n      // Drain first round\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Capture another turn (newer state)\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"second prompt\\\"),\\n        entryId: \\\"entry-3\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"second response\\\" }),\\n        entryId: \\\"entry-4\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      // Drain second round\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Verify both turns exist and no corruption occurred\\n      const overview = await inspect.overview(threadRef);\\n      expect(overview.ok).toBe(true);\\n      if (overview.ok) {\\n        // Should have 2 closed turns\\n        expect(overview.value.turns.closed).toBe(2);\\n      }\\n\\n      // Verify forms exist for both turns\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (health.ok) {\\n        // Should have forms for both turns\\n        expect(health.value.forms.length).toBeGreaterThan(0);\\n      }\\n    });\\n  });\\n});\\n\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"output_tokens\":0},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"1e49bf1c-1b7d-4680-bde9-45be2fa826cb\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/003-implementor.stdout.log:13780:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_433265175cbd4db094d30a2e\",\"type\":\"tool_result\",\"content\":\"File created successfully at: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"4a4fd51d-6109-4c74-960c-0a08a2deb28e\",\"timestamp\":\"2026-06-14T12:30:43.955Z\",\"tool_use_result\":{\"type\":\"create\",\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts\",\"content\":\"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\\n// injected ModelCall function and persists outcomes queryable through\\n// inspect/health.\\n//\\n// This test proves the full capture → derivation → recorded-outcome loop, not\\n// just the function in isolation. It:\\n// 1. Captures content to a thread (through the real converter)\\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\\n// 3. Awaits drainSettled to flush background work\\n// 4. Asserts both ready forms and classified failures exist in the thread\\n//\\n// Architecture-risk test: concurrency/lost-update — a stale background result does\\n// not clobber newer thread state.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createDeterministicProvider,\\n  inspect,\\n  intakeStream,\\n  threads,\\n  type FormKind,\\n  type InferenceConfig,\\n  type ModelAssignment,\\n  type ModelCall,\\n  type ModelCallFailureKind,\\n  type ModelCallResult,\\n  type SdkConfig,\\n  type ThreadRef,\\n} from \\\"lhc\\\";\\nimport { PROMPT_NAMES } from \\\"lhc\\\";\\nimport { createConnector, type Connector } from \\\"../../src/index.js\\\";\\nimport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \\\"../fixtures/synthetic.js\\\";\\nimport type { TempStore } from \\\"../fixtures/thread.js\\\";\\nimport { tempStore } from \\\"../fixtures/thread.js\\\";\\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \\\"../fixtures/model-call.js\\\";\\n\\ndescribe(\\\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\\\", () => {\\n  let store: TempStore;\\n  let connector: Connector;\\n  let ctx: ExtensionContext;\\n  let threadRef: ThreadRef | null;\\n\\n  beforeEach(async () => {\\n    store = tempStore();\\n    threadRef = null;\\n\\n    // Synthetic headless context\\n    ctx = {\\n      cwd: \\\"/test/closed-loop\\\",\\n      hasUI: false,\\n      modelRegistry: {\\n        find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n        hasConfiguredAuth: () => true,\\n        getAvailable: () => [],\\n      },\\n      ui: { notify: () => {} },\\n      sessionManager: { getEntries: () => [] },\\n    };\\n  });\\n\\n  afterEach(async () => {\\n    if (connector !== null && threadRef !== null) {\\n      await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n    }\\n    store.cleanup();\\n  });\\n\\n  describe(\\\"TC-4.5: Capture → derivation → recorded-outcome loop\\\", () => {\\n    it(\\\"captured thread's queued derivation invokes function and persists ready form + classified failure\\\", async () => {\\n      // Build the inference config with a ModelCall that routes by provider/model\\n      // One lane returns text (producing ready forms), another returns failure\\n      const modelCall = fakeModelCallRouter({\\n        \\\"openai/gpt-4o-mini\\\": fakeModelCallText(\\\"derived summary from openai\\\"),\\n        \\\"anthropic/claude-3\\\": fakeModelCallFailure(\\\"rate_limit\\\", \\\"Rate limited\\\"),\\n        // Default for any other provider/model\\n      });\\n\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"anthropic\\\", model: \\\"claude-3\\\", prompt: PROMPT_NAMES.lower_band_projection }, // Will fail\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      // Create connector with our inference config\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      // Start a new session\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture content — a user prompt and assistant response (one turn)\\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"please summarize this file\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"here is the summary\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \\\"here is the summary\\\" })],\\n      });\\n\\n      // Get the instance and drain the background scheduler\\n      const instance = connector.getInstance();\\n      expect(instance).not.toBeNull();\\n      if (!instance) return;\\n\\n      // Await drainSettled — all derivations complete or fail\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query inspect.health for derivation outcomes\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (!health.ok) return;\\n\\n      const report = health.value;\\n\\n      // Assert: at least one ready derived form exists (from openai lane)\\n      // The exact form depends on what derivations were queued\\n      const readyForms = report.forms.filter((f) => f.state === \\\"ready\\\");\\n      expect(readyForms.length).toBeGreaterThan(0);\\n      expect(\\n        readyForms.some((f) => f.formKind === \\\"smoothed_prompt\\\" || f.formKind === \\\"turn_rendering\\\"),\\n      ).toBe(true);\\n\\n      // Assert: at least one classified failure exists (from anthropic lane)\\n      const failedForms = report.forms.filter((f) => f.state === \\\"failed\\\");\\n      // lower_band_projection should have failed with rate_limit\\n      const lowerBandFailure = failedForms.find((f) => f.formKind === \\\"lower_band_projection\\\");\\n      expect(lowerBandFailure).toBeDefined();\\n      if (lowerBandFailure) {\\n        expect(lowerBandFailure.failure?.kind).toBe(\\\"rate_limit\\\");\\n      }\\n    });\\n\\n    it(\\\"verify outcomes are queryable through inspect (not just internal state)\\\", async () => {\\n      // This test verifies the same loop but asserts specifically on the\\n      // inspect surface, proving outcomes are queryable (not just internal)\\n      const modelCall = fakeModelCallText(\\\"success\\\");\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture a turn\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"test prompt\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"test response\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      const instance = connector.getInstance();\\n      if (!instance) return;\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query through inspect\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (health.ok) {\\n        // Health report contains forms with states\\n        expect(health.value.forms).toBeInstanceOf(Array);\\n        expect(health.value.forms.length).toBeGreaterThan(0);\\n      }\\n\\n      const overview = await inspect.overview(threadRef);\\n      expect(overview.ok).toBe(true);\\n      if (overview.ok) {\\n        // Overview shows turn count\\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\\n      }\\n    });\\n  });\\n\\n  describe(\\\"Architecture-risk: Concurrency / Lost Update\\\", () => {\\n    it(\\\"stale background derivation result does not clobber newer thread state\\\", async () => {\\n      // This test verifies that a stale result from the background scheduler\\n      // does not overwrite newer state. LHC owns this guarantee, but the test\\n      // proves the connector's wiring doesn't break it.\\n\\n      const modelCall = fakeModelCallText(\\\"result\\\");\\n\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture a turn\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"first prompt\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"first response\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      const instance = connector.getInstance();\\n      if (!instance) return;\\n\\n      // Drain first round\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Capture another turn (newer state)\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"second prompt\\\"),\\n        entryId: \\\"entry-3\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"second response\\\" }),\\n        entryId: \\\"entry-4\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      // Drain second round\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Verify both turns exist and no corruption occurred\\n      const overview = await inspect.overview(threadRef);\\n      expect(overview.ok).toBe(true);\\n      if (overview.ok) {\\n        // Should have 2 closed turns\\n        expect(overview.value.turns.closed).toBe(2);\\n      }\\n\\n      // Verify forms exist for both turns\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (health.ok) {\\n        // Should have forms for both turns\\n        expect(health.value.forms.length).toBeGreaterThan(0);\\n      }\\n    });\\n  });\\n});\\n\",\"structuredPatch\":[],\"originalFile\":null,\"userModified\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/003-implementor.stdout.log:14891:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_8434ca3b3dda4dbcb6b9380f\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"98398e33-e27d-4e2a-8a96-9938f7fbc870\",\"timestamp\":\"2026-06-14T12:31:17.866Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts\",\"oldString\":\"      // Start a new session\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\",\"newString\":\"      // St
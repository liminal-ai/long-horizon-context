  31\\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n    32\\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n    33\\t *  registers no handler for it (story Scope Out). */\\n    34\\texport const EPIC_1_HOOKS = [\\n    35\\t  \\\"session_start\\\",\\n    36\\t  \\\"message_end\\\",\\n    37\\t  \\\"turn_end\\\",\\n    38\\t  \\\"agent_end\\\",\\n    39\\t  \\\"model_select\\\",\\n    40\\t  \\\"thinking_level_select\\\",\\n    41\\t  \\\"session_before_fork\\\",\\n    42\\t  \\\"session_before_switch\\\",\\n    43\\t  \\\"session_shutdown\\\",\\n    44\\t] as const satisfies readonly PiHookName[];\\n    45\\t\\n    46\\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n    47\\t\\n    48\\t/** What the connector needs from the host to run a session. All injectable so\\n    49\\t *  the lifecycle is exercised against a real temp registry/thread in tests and\\n    50\\t *  the default `~/.lhc` registry in production.\\n    51\\t *\\n    52\\t *  `buildSdkConfig` is the inference seam: it returns the SdkConfig (provider /\\n    53\\t *  inference + policy) to construct the instance from. In Story 1 the real\\n    54\\t *  config — the PI-model-registry-backed `ModelCall` and assignments — is not\\n    55\\t *  wired yet (that is Stories 5/6), so the default fails closed; the connector\\n    56\\t *  then resolves nothing and records a diagnostic rather than faking a session.\\n    57\\t */\\n    58\\texport interface ConnectorDeps {\\n    59\\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n    60\\t  registryPath?: string;\\n    61\\t  newThreadFilePath?: () => string;\\n    62\\t  parseLaunch?: () => LaunchFlags;\\n    63\\t  selectThread?: (\\n    64\\t    choices: readonly ThreadChoice[],\\n    65\\t    ctx: ExtensionContext,\\n    66\\t  ) => Promise<string | null>;\\n    67\\t}\\n    68\\t\\n    69\\t/** Everything the connector retains across hooks as PLAIN data — by\\n    70\\t *  construction structuredClone-able. The live `LhcInstance` is held separately\\n    71\\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n    72\\t *  deliberately not part of the snapshot. */\\n    73\\texport interface ConnectorSnapshot {\\n    74\\t  state: SessionState | null;\\n    75\\t  lastDiagnostic: CaptureFailureDiagnostic | null;\\n    76\\t}\\n    77\\t\\n    78\\texport interface Connector {\\n    79\\t  /** Register the observe-only hook rail on the PI extension API. */\\n    80\\t  register(pi: ExtensionAPI): void;\\n    81\\t  /** The plain-data state retained across hooks. `null` until a session\\n    82\\t   *  resolves a thread; never holds a PI ctx. */\\n    83\\t  getState(): SessionState | null;\\n    84\\t  /** The live LHC instance for the current session, or `null`. A test/inspection\\n    85\\t   *  seam — held by the connector but never part of the plain-data snapshot. */\\n    86\\t  getInstance(): LhcInstance | null;\\n    87\\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n    88\\t  snapshot(): ConnectorSnapshot;\\n    89\\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n    90\\t   *  synthetic ctx/events without a live PI. */\\n    91\\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n    92\\t}\\n    93\\t\\n    94\\tconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n    95\\t\\n    96\\t/** Inference host not wired yet (Story 5/6): fail closed so a session resolves\\n    97\\t *  nothing and records a diagnostic instead of constructing a faked instance. */\\n    98\\tfunction inferenceNotConfigured(): OpResult<SdkConfig> {\\n    99\\t  return {\\n   100\\t    ok: false,\\n   101\\t    error: {\\n   102\\t      errorClass: \\\"system_error\\\",\\n   103\\t      code: \\\"not_implemented\\\",\\n   104\\t      reason:\\n   105\\t        \\\"pi-lhc inference host not wired yet (Epic 1 Story 5); SDK construction deferred\\\",\\n   106\\t    },\\n   107\\t  };\\n   108\\t}\\n   109\\t\\n   110\\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n   111\\t *  generated by the registry at creation, so the file name is just a unique\\n   112\\t *  handle; the directory is ensured up front (DatabaseSync does not create\\n   113\\t *  parents). */\\n   114\\tfunction defaultNewThreadFilePath(): string {\\n   115\\t  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n   116\\t  mkdirSync(dir, { recursive: true });\\n   117\\t  return join(dir, `${randomUUID()}.sqlite`);\\n   118\\t}\\n   119\\t\\n   120\\tfunction threadIdOf(ref: ThreadRef): string | null {\\n   121\\t  return \\\"threadId\\\" in ref ? ref.threadId : null;\\n   122\\t}\\n   123\\t\\n   124\\t/** Build a connector instance. Its mutable state lives in this closure; the\\n   125\\t *  registered handlers capture it, so the instance stays live for the session\\n   126\\t *  even when `activate` discards the returned object. */\\n   127\\texport function createConnector(deps: ConnectorDeps = {}): Connector {\\n   128\\t  // The connector's retained state. `state` is plain data (the durable thread\\n   129\\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\n   130\\t  // `rememberedThreadId` is the durable id the reload path reattaches by; and\\n   131\\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object.\\n   132\\t  let state: SessionState | null = null;\\n   133\\t  let instance: LhcInstance | null = null;\\n   134\\t  let rememberedThreadId: string | null = null;\\n   135\\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n   136\\t\\n   137\\t  const buildSdkConfig = deps.buildSdkConfig ?? (() => inferenceNotConfigured());\\n   138\\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n   139\\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\n   140\\t  const selectThread =\\n   141\\t    deps.selectThread ?? ((): Promise<string | null> => Promise.resolve(null));\\n   142\\t\\n   143\\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\\n   144\\t    return { code, message, recordedGap: false };\\n   145\\t  }\\n   146\\t\\n   147\\t  // On reload (same session continues, in-memory state wiped) reconstruct the\\n   148\\t  // SAME thread from its durable id rather than re-running the launch — a\\n   149\\t  // no-flag session would otherwise create a duplicate (AC-1.5). The launch\\n   150\\t  // (process.argv) is the fallback when no id is remembered, which covers\\n   151\\t  // --session/--continue/--resume reloads. The permanent home for reload\\n   152\\t  // lineage is LHC thread metadata (Feature 2+).\\n   153\\t  function launchFor(event: { reason: string }): LaunchFlags {\\n   154\\t    if (event.reason === \\\"reload\\\" && rememberedThreadId !== null) {\\n   155\\t      return { session: rememberedThreadId };\\n   156\\t    }\\n   157\\t    return parseLaunch();\\n   158\\t  }\\n   159\\t\\n   160\\t  async function resolveForLaunch(\\n   161\\t    launch: LaunchFlags,\\n   162\\t    ctx: ExtensionContext,\\n   163\\t  ): Promise<OpResult<ThreadRef | null>> {\\n   164\\t    if (launch.resume === true) {\\n   165\\t      const pickerDeps: {\\n   166\\t        registryPath?: string;\\n   167\\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n   168\\t      } = { select: (choices) => selectThread(choices, ctx) };\\n   169\\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\n   170\\t      return pickThread(ctx.cwd, pickerDeps);\\n   171\\t    }\\n   172\\t    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\\n   173\\t      cwd: ctx.cwd,\\n   174\\t      newThreadFilePath,\\n   175\\t    };\\n   176\\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\n   177\\t    return resolveThread(launch, resolveDeps);\\n   178\\t  }\\n   179\\t\\n   180\\t  // session_start: resolve the recording thread from the launch and construct\\n   181\\t  // one background instance against it. Config is gated first so a session with\\n   182\\t  // no usable inference config resolves/creates nothing (no orphan thread).\\n   183\\t  const onSessionStart: PiHookHandler<\\\"session_start\\\"> = async (ctx, event) => {\\n   184\\t    const config = buildSdkConfig(ctx);\\n   185\\t    if (!config.ok) {\\n   186\\t      lastDiagnostic = diag(\\\"instance_not_configured\\\", config.error.reason);\\n   187\\t      return;\\n   188\\t    }\\n   189\\t    const resolved = await resolveForLaunch(launchFor(event), ctx);\\n   190\\t    if (!resolved.ok) {\\n   191\\t      lastDiagnostic = diag(\\\"thread_resolution_failed\\\", resolved.error.reason);\\n   192\\t      return;\\n   193\\t    }\\n   194\\t    if (resolved.value === null) {\\n   195\\t      lastDiagnostic = diag(\\\"no_thread_selected\\\", \\\"--resume resolved no thread\\\");\\n   196\\t      return;\\n   197\\t    }\\n   198\\t    const built = await initInstance(resolved.value, config.value);\\n   199\\t    if (!built.ok) {\\n   200\\t      lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n   201\\t      return;\\n   202\\t    }\\n   203\\t    instance = built.value;\\n   204\\t    state = createSessionState(resolved.value);\\n   205\\t    rememberedThreadId = threadIdOf(resolved.value);\\n   206\\t  };\\n   207\\t\\n   208\\t  // Dispose with flush before any session swap (session_before_switch fires\\n   209\\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\n   210\\t  // no live instance is a no-op.\\n   211\\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\\n   212\\t    const result = await disposeInstance(instance);\\n   213\\t    if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n   214\\t    instance = null;\\n   215\\t  };\\n   216\\t\\n   217\\t  // Contain every handler: an observe-only hook must never throw back into PI\\n   218\\t  // (a thrown hook breaks the user's session). A caught error becomes a\\n   219\\t  // plain-data diagnostic; it is never rethrown.\\n   220\\t  const guard = (\\n   221\\t    name: Epic1Hook,\\n   222\\t    body: PiHookHandler<Epic1Hook>,\\n   223\\t  ): PiHookHandler<Epic1Hook> => {\\n   224\\t    return async (ctx, event): Promise<void> => {\\n   225\\t      try {\\n   226\\t        await body(ctx, event);\\n   227\\t      } catch (err) {\\n   228\\t        lastDiagnostic = {\\n   229\\t          code: \\\"hook_handler_error\\\",\\n   230\\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\n   231\\t          recordedGap: false,\\n   232\\t        };\\n   233\\t      }\\n   234\\t    };\\n   235\\t  };\\n   236\\t\\n   237\\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\\n   238\\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\\n   239\\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\\n   240\\t  const noop: PiHookHandler<Epic1Hook> = () => {\\n   241\\t    // Intentionally empty — later stories replace this with real routing.\\n   242\\t  };\\n   243\\t\\n   244\\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\\n   245\\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n   246\\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n   247\\t    session_before_switch: onDispose,\\n   248\\t    session_shutdown: onDispose,\\n   249\\t    message_end: noop,\\n   250\\t    turn_end: noop,\\n   251\\t    agent_end: noop,\\n   252\\t    model_select: noop,\\n   253\\t    thinking_level_select: noop,\\n   254\\t    session_before_fork: noop,\\n   255\\t  };\\n   256\\t\\n   257\\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\n   258\\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\n   259\\t\\n   260\\t  return {\\n   261\\t    handlers,\\n   262\\t    register(pi: ExtensionAPI): void {\\n   263\\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\n   264\\t    },\\n   265\\t    getState(): SessionState | null {\\n   266\\t      return state;\\n   267\\t    },\\n   268\\t    getInstance(): LhcInstance | null {\\n   269\\t      return instance;\\n   270\\t    },\\n   271\\t    snapshot(): ConnectorSnapshot {\\n   272\\t      return { state, lastDiagnostic };\\n   273\\t    },\\n   274\\t  };\\n   275\\t}\\n   276\\t\\n   277\\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n   278\\t *  loads (and again on `/reload`). Registers the observe-only hook rail with\\n   279\\t *  the production defaults (the `~/.lhc` registry, `process.argv` launch flags).\\n   280\\t *  The inference-backed `buildSdkConfig` is wired in Stories 5/6; until then a\\n   281\\t *  live session resolves nothing and records a diagnostic rather than faking. */\\n   282\\texport function activate(pi: ExtensionAPI): void {\\n   283\\t  createConnector().register(pi);\\n   284\\t}\\n   285\\t\\n   286\\texport default activate;\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:52:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_23\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=1 && NR<=130 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' packages/pi-lhc/test/lifecycle/instance.test.ts\\\"\",\"aggregated_output\":\"     1\\t// Story 1 — instance lifecycle (TC-1.1, TC-1.4). Driven through the real\\n     2\\t// lifecycle functions against a real temp registry + thread (the store is never\\n     3\\t// mocked; persistence/reattach are the product contract). The SDK is built with\\n     4\\t// the deterministic provider — a valid construction that needs no real\\n     5\\t// inference, which the inference host (Stories 5/6) supplies in production.\\n     6\\timport { existsSync } from \\\"node:fs\\\";\\n     7\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     8\\timport {\\n     9\\t  createDeterministicProvider,\\n    10\\t  inspect,\\n    11\\t  threads,\\n    12\\t  type SdkConfig,\\n    13\\t  type ThreadRef,\\n    14\\t} from \\\"lhc\\\";\\n    15\\timport { disposeInstance, initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    16\\timport { resolveThread } from \\\"../../src/lifecycle/thread-resolution.js\\\";\\n    17\\timport { eventBatch } from \\\"../fixtures/synthetic.js\\\";\\n    18\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    19\\t\\n    20\\tlet store: TempStore;\\n    21\\tbeforeEach(() => {\\n    22\\t  store = tempStore();\\n    23\\t});\\n    24\\tafterEach(() => {\\n    25\\t  store.cleanup();\\n    26\\t});\\n    27\\t\\n    28\\tfunction backgroundConfig(): SdkConfig {\\n    29\\t  return { provider: createDeterministicProvider(), mode: \\\"background\\\" };\\n    30\\t}\\n    31\\t\\n    32\\tfunction idOf(ref: ThreadRef): string {\\n    33\\t  if (!(\\\"threadId\\\" in ref)) throw new Error(\\\"expected a { threadId } ref\\\");\\n    34\\t  return ref.threadId;\\n    35\\t}\\n    36\\t\\n    37\\tdescribe(\\\"Story 1: instance lifecycle\\\", () => {\\n    38\\t  it(\\\"TC-1.1: a no-flag launch creates one cwd-registered thread and one background instance\\\", async () => {\\n    39\\t    const cwd = \\\"/work/tc-1-1\\\";\\n    40\\t    const resolved = await resolveThread(\\n    41\\t      {},\\n    42\\t      { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\\n    43\\t    );\\n    44\\t    expect(resolved.ok).toBe(true);\\n    45\\t    if (!resolved.ok) return;\\n    46\\t    const threadId = idOf(resolved.value);\\n    47\\t\\n    48\\t    // Exactly one thread registered, and its registry row carries the cwd.\\n    49\\t    const all = await threads.listThreads({ registryPath: store.registryPath });\\n    50\\t    expect(all.ok).toBe(true);\\n    51\\t    if (all.ok) expect(all.value).toHaveLength(1);\\n    52\\t\\n    53\\t    const row = await threads.resolve({ threadId, registryPath: store.registryPath });\\n    54\\t    expect(row.ok).toBe(true);\\n    55\\t    if (!row.ok) return;\\n    56\\t    expect(row.value.cwd).toBe(cwd);\\n    57\\t    expect(existsSync(row.value.filePath)).toBe(true); // a real thread file exists\\n    58\\t\\n    59\\t    // One instance, in background scheduler mode. Background mode means the\\n    60\\t    // scheduler auto-drains; the connector never calls drain/drainSettled during\\n    61\\t    // startup (initInstance only validates the thread), so it does not drive the\\n    62\\t    // queue itself (AC-1.1).\\n    63\\t    const built = await initInstance(resolved.value, backgroundConfig());\\n    64\\t    expect(built.ok).toBe(true);\\n    65\\t    if (!built.ok) return;\\n    66\\t    expect(built.value.sdk.config.mode).toBe(\\\"background\\\");\\n    67\\t    expect(idOf(built.value.threadRef)).toBe(threadId);\\n    68\\t\\n    69\\t    const disposed = await disposeInstance(built.value);\\n    70\\t    expect(disposed.ok).toBe(true);\\n    71\\t  });\\n    72\\t\\n    73\\t  it(\\\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\\\", async () => {\\n    74\\t    const resolved = await resolveThread(\\n    75\\t      {},\\n    76\\t      { cwd: \\\"/work/tc-1-4\\\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\\n    77\\t    );\\n    78\\t    expect(resolved.ok).toBe(true);\\n    79\\t    if (!resolved.ok) return;\\n    80\\t    const threadId = idOf(resolved.value);\\n    81\\t\\n    82\\t    const built = await initInstance(resolved.value, backgroundConfig());\\n    83\\t    expect(built.ok).toBe(true);\\n    84\\t    if (!built.ok) return;\\n    85\\t\\n    86\\t    // Capture N raw intake events through the instance (the converter is Story 2;\\n    87\\t    // the lifecycle proof needs only that recorded events survive shutdown).\\n    88\\t    const batch = eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]);\\n    89\\t    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\\n    90\\t    expect(captured.ok).toBe(true);\\n    91\\t\\n    92\\t    // Dispose with flush.\\n    93\\t    const disposed = await disposeInstance(built.value);\\n    94\\t    expect(disposed.ok).toBe(true);\\n    95\\t\\n    96\\t    // Reattach: resolve the same thread by id (no retained instance) and read\\n    97\\t    // back — every pre-shutdown event is present, no trailing loss.\\n    98\\t    const reattached = await resolveThread(\\n    99\\t      { session: threadId },\\n   100\\t      { cwd: \\\"/work/tc-1-4\\\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\\n   101\\t    );\\n   102\\t    expect(reattached.ok).toBe(true);\\n   103\\t    if (!reattached.ok) return;\\n   104\\t\\n   105\\t    const overview = await inspect.overview(reattached.value);\\n   106\\t    expect(overview.ok).toBe(true);\\n   107\\t    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\\n   108\\t  });\\n   109\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:53:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_25\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=151 && NR<=320 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\\\"\",\"aggregated_output\":\"   151\\t      expect(choice.title).toBeTruthy();\\n   152\\t    }\\n   153\\t\\n   154\\t    // The operator's selection resolves to that thread.\\n   155\\t    if (picked.ok && picked.value !== null) {\\n   156\\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\\n   157\\t    }\\n   158\\t\\n   159\\t    // An empty cwd reports an empty list (null) without failing or prompting.\\n   160\\t    let selectCalled = false;\\n   161\\t    const empty = await pickThread(\\\"/work/empty\\\", {\\n   162\\t      registryPath: store.registryPath,\\n   163\\t      select: () => {\\n   164\\t        selectCalled = true;\\n   165\\t        return Promise.resolve(null);\\n   166\\t      },\\n   167\\t    });\\n   168\\t    expect(empty.ok).toBe(true);\\n   169\\t    if (empty.ok) expect(empty.value).toBeNull();\\n   170\\t    expect(selectCalled).toBe(false);\\n   171\\t  });\\n   172\\t\\n   173\\t  it(\\\"TC-1.5 (risk: restart): reattach reconstructs the thread from its durable id after the holder is discarded\\\", async () => {\\n   174\\t    const cwd = \\\"/work/tc-1-5\\\";\\n   175\\t    // Create + capture on a thread.\\n   176\\t    const created = await resolveThread({}, deps(cwd));\\n   177\\t    expect(created.ok).toBe(true);\\n   178\\t    if (!created.ok) return;\\n   179\\t    const threadId = idOf(created.value);\\n   180\\t\\n   181\\t    const first = await initInstance(created.value, backgroundConfig());\\n   182\\t    expect(first.ok).toBe(true);\\n   183\\t    if (!first.ok) return;\\n   184\\t    await first.value.sdk.intakeStream.messageEvents(\\n   185\\t      first.value.threadRef,\\n   186\\t      eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]),\\n   187\\t    );\\n   188\\t    await disposeInstance(first.value);\\n   189\\t\\n   190\\t    // Discard ALL in-memory state. Only the durable id survives (as it would in\\n   191\\t    // the registry across process death). Reconstruct purely from it — no\\n   192\\t    // retained object.\\n   193\\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\\n   194\\t    expect(reattached.ok).toBe(true);\\n   195\\t    if (!reattached.ok) return;\\n   196\\t    expect(idOf(reattached.value)).toBe(threadId); // the same thread, by id\\n   197\\t\\n   198\\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\\n   199\\t    expect(rebuilt.ok).toBe(true);\\n   200\\t    if (!rebuilt.ok) return;\\n   201\\t    // Capture continues on the same thread: append more, all events present.\\n   202\\t    await rebuilt.value.sdk.intakeStream.messageEvents(\\n   203\\t      rebuilt.value.threadRef,\\n   204\\t      eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]),\\n   205\\t    );\\n   206\\t    const overview = await inspect.overview(reattached.value);\\n   207\\t    expect(overview.ok).toBe(true);\\n   208\\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\\n   209\\t    await disposeInstance(rebuilt.value);\\n   210\\t  });\\n   211\\t});\\n   212\\t\\n   213\\tdescribe(\\\"Story 1: plain-data state across hooks\\\", () => {\\n   214\\t  it(\\\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\\\", async () => {\\n   215\\t    const connector = createConnector({\\n   216\\t      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\\n   217\\t      registryPath: store.registryPath,\\n   218\\t      newThreadFilePath: () => store.threadPath(),\\n   219\\t      parseLaunch: () => ({}), // no flag → new thread\\n   220\\t    });\\n   221\\t\\n   222\\t    // session_start with a ctx carrying methods.\\n   223\\t    await connector.handlers.session_start(syntheticCtx(\\\"/work/a\\\"), makeSessionStart(\\\"new\\\"));\\n   224\\t    expect(connector.getState()).not.toBeNull();\\n   225\\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\\n   226\\t    // ...but the snapshot is plain data only — it survives structuredClone even\\n   227\\t    // though the live ctx and instance carry methods (they are not in it).\\n   228\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n   229\\t    const threadRefBefore = connector.getState()?.threadRef;\\n   230\\t\\n   231\\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\n   232\\t    // holder still references no prior ctx.\\n   233\\t    await connector.handlers.message_end(\\n   234\\t      syntheticCtx(\\\"/work/a\\\"),\\n   235\\t      makeMessageEnd(makeUserMessage(\\\"hi\\\")),\\n   236\\t    );\\n   237\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n   238\\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\n   239\\t  });\\n   240\\t});\\n   241\\t\\n   242\\tdescribe(\\\"Story 1: reload reconstruction (connector wiring)\\\", () => {\\n   243\\t  it(\\\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\\\", async () => {\\n   244\\t    // The launch is no-flag, which would create a NEW thread on every resolve.\\n   245\\t    // The reload path must instead reattach the durable resolved id (AC-1.5).\\n   246\\t    const connector = createConnector({\\n   247\\t      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\\n   248\\t      registryPath: store.registryPath,\\n   249\\t      newThreadFilePath: () => store.threadPath(),\\n   250\\t      parseLaunch: () => ({}),\\n   251\\t    });\\n   252\\t\\n   253\\t    await connector.handlers.session_start(syntheticCtx(\\\"/work/reload\\\"), makeSessionStart(\\\"new\\\"));\\n   254\\t    const firstRef = connector.getState()?.threadRef;\\n   255\\t    const firstId = firstRef !== undefined && \\\"threadId\\\" in firstRef ? firstRef.threadId : null;\\n   256\\t    expect(firstId).not.toBeNull();\\n   257\\t    const countAfterNew = await threadCount();\\n   258\\t\\n   259\\t    // /reload fires shutdown{reload} then session_start{reload} on the same\\n   260\\t    // session — the connector disposes, then reconstructs the SAME thread.\\n   261\\t    await connector.handlers.session_shutdown(syntheticCtx(\\\"/work/reload\\\"), { reason: \\\"reload\\\" });\\n   262\\t    await connector.handlers.session_start(syntheticCtx(\\\"/work/reload\\\"), makeSessionStart(\\\"reload\\\"));\\n   263\\t\\n   264\\t    const reloadedRef = connector.getState()?.threadRef;\\n   265\\t    const reloadedId =\\n   266\\t      reloadedRef !== undefined && \\\"threadId\\\" in reloadedRef ? reloadedRef.threadId : null;\\n   267\\t    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\\n   268\\t    expect(connector.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\n   269\\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\n   270\\t  });\\n   271\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:54:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_24\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=1 && NR<=150 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\\\"\",\"aggregated_output\":\"     1\\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\\n     2\\t// reconstruction (TC-1.2, 1.3, 1.5, 1.6, 1.7 + the restart architecture-risk\\n     3\\t// test). Resolution and the picker are exercised directly against a real temp\\n     4\\t// registry; the plain-data rule and reload are exercised through the connector.\\n     5\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     6\\timport {\\n     7\\t  createDeterministicProvider,\\n     8\\t  inspect,\\n     9\\t  threads,\\n    10\\t  type OpResult,\\n    11\\t  type SdkConfig,\\n    12\\t  type ThreadRef,\\n    13\\t} from \\\"lhc\\\";\\n    14\\timport { createConnector } from \\\"../../src/index.js\\\";\\n    15\\timport { disposeInstance, initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    16\\timport { resolveThread, type ResolveDeps } from \\\"../../src/lifecycle/thread-resolution.js\\\";\\n    17\\timport { pickThread, type ThreadChoice } from \\\"../../src/lifecycle/picker.js\\\";\\n    18\\timport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\n    19\\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\"../fixtures/synthetic.js\\\";\\n    20\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    21\\t\\n    22\\tlet store: TempStore;\\n    23\\tbeforeEach(() => {\\n    24\\t  store = tempStore();\\n    25\\t});\\n    26\\tafterEach(() => {\\n    27\\t  store.cleanup();\\n    28\\t});\\n    29\\t\\n    30\\tfunction backgroundConfig(): SdkConfig {\\n    31\\t  return { provider: createDeterministicProvider(), mode: \\\"background\\\" };\\n    32\\t}\\n    33\\t\\n    34\\tfunction idOf(ref: ThreadRef): string {\\n    35\\t  if (!(\\\"threadId\\\" in ref)) throw new Error(\\\"expected a { threadId } ref\\\");\\n    36\\t  return ref.threadId;\\n    37\\t}\\n    38\\t\\n    39\\tfunction deps(cwd = \\\"/work/default\\\"): ResolveDeps {\\n    40\\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\n    41\\t}\\n    42\\t\\n    43\\t// Create a thread directly with cwd/title so the picker test can assert both —\\n    44\\t// new threads created by the connector carry a cwd but no title yet (title\\n    45\\t// derivation is the deferred TDQ Q4).\\n    46\\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\\n    47\\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\\n    48\\t    filePath: store.threadPath(),\\n    49\\t    registryPath: store.registryPath,\\n    50\\t  };\\n    51\\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\n    52\\t  if (opts.title !== undefined) input.title = opts.title;\\n    53\\t  const created = await threads.newThread(input);\\n    54\\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\\n    55\\t  return created.value.threadId;\\n    56\\t}\\n    57\\t\\n    58\\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\\n    59\\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\\n    60\\t// object, modelling PI handing a fresh ctx to each hook.\\n    61\\tfunction syntheticCtx(cwd: string): ExtensionContext {\\n    62\\t  return {\\n    63\\t    cwd,\\n    64\\t    hasUI: false,\\n    65\\t    modelRegistry: {\\n    66\\t      find: () => undefined,\\n    67\\t      hasConfiguredAuth: () => false,\\n    68\\t      getAvailable: () => [],\\n    69\\t    },\\n    70\\t    ui: { notify: () => {} },\\n    71\\t    sessionManager: { getEntries: () => [] },\\n    72\\t  };\\n    73\\t}\\n    74\\t\\n    75\\tasync function threadCount(): Promise<number> {\\n    76\\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\\n    77\\t  return listed.ok ? listed.value.length : -1;\\n    78\\t}\\n    79\\t\\n    80\\tdescribe(\\\"Story 1: launch-driven thread resolution\\\", () => {\\n    81\\t  it(\\\"TC-1.2: --session resolves an existing thread and creates no second thread\\\", async () => {\\n    82\\t    const existingId = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"existing\\\" });\\n    83\\t    const before = await threadCount();\\n    84\\t\\n    85\\t    const resolved = await resolveThread({ session: existingId }, deps());\\n    86\\t    expect(resolved.ok).toBe(true);\\n    87\\t    if (resolved.ok) expect(idOf(resolved.value)).toBe(existingId);\\n    88\\t\\n    89\\t    expect(await threadCount()).toBe(before); // no second thread\\n    90\\t  });\\n    91\\t\\n    92\\t  it(\\\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\\\", async () => {\\n    93\\t    // no flag → a new thread\\n    94\\t    const first = await resolveThread({}, deps());\\n    95\\t    expect(first.ok).toBe(true);\\n    96\\t    if (!first.ok) return;\\n    97\\t    const firstId = idOf(first.value);\\n    98\\t\\n    99\\t    // --session full id → the same thread\\n   100\\t    const byFull = await resolveThread({ session: firstId }, deps());\\n   101\\t    expect(byFull.ok).toBe(true);\\n   102\\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\\n   103\\t\\n   104\\t    // --session partial id → the same thread\\n   105\\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\\n   106\\t    expect(byPartial.ok).toBe(true);\\n   107\\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\\n   108\\t\\n   109\\t    // a second thread, then --continue → the most recently created\\n   110\\t    const second = await resolveThread({}, deps());\\n   111\\t    expect(second.ok).toBe(true);\\n   112\\t    if (!second.ok) return;\\n   113\\t    const secondId = idOf(second.value);\\n   114\\t    const continued = await resolveThread({ continue: true }, deps());\\n   115\\t    expect(continued.ok).toBe(true);\\n   116\\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\\n   117\\t\\n   118\\t    // unresolvable id → actionable error, no thread created\\n   119\\t    const before = await threadCount();\\n   120\\t    const bad = await resolveThread({ session: \\\"th_zzzzzzzzzzzzzzzz\\\" }, deps());\\n   121\\t    expect(bad.ok).toBe(false);\\n   122\\t    if (!bad.ok) expect(bad.error.code).toBe(\\\"thread_not_found\\\");\\n   123\\t    expect(await threadCount()).toBe(before);\\n   124\\t\\n   125\\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\\n   126\\t    const ambiguous = await resolveThread({ session: \\\"th_\\\" }, deps());\\n   127\\t    expect(ambiguous.ok).toBe(false);\\n   128\\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\\\"ambiguous_thread_id\\\");\\n   129\\t    expect(await threadCount()).toBe(before);\\n   130\\t  });\\n   131\\t\\n   132\\t  it(\\\"TC-1.7: --resume lists cwd-scoped threads (title + created), resolves selection, empty-safe\\\", async () => {\\n   133\\t    const a1 = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"alpha\\\" });\\n   134\\t    const a2 = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"beta\\\" });\\n   135\\t    await makeThread({ cwd: \\\"/work/b\\\", title: \\\"other-cwd\\\" });\\n   136\\t\\n   137\\t    let offered: readonly ThreadChoice[] = [];\\n   138\\t    const picked = await pickThread(\\\"/work/a\\\", {\\n   139\\t      registryPath: store.registryPath,\\n   140\\t      select: (choices) => {\\n   141\\t        offered = choices;\\n   142\\t        return Promise.resolve(choices[0]!.threadId);\\n   143\\t      },\\n   144\\t    });\\n   145\\t    expect(picked.ok).toBe(true);\\n   146\\t\\n   147\\t    // Only the current cwd's threads are offered, each with title + creation time.\\n   148\\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\\n   149\\t    for (const choice of offered) {\\n   150\\t      expect(choice.createdAt).toBeTruthy();\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:61:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_28\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=1 && NR<=230 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' packages/lhc/test/threads-a8.test.ts\\\"\",\"aggregated_output\":\"     1\\t// A-8 registry additions (pi-lhc Epic 02 Story 1 prerequisite): the cwd column,\\n     2\\t// partial-id (prefix) resolve with ambiguity failure, the cwd-scoped listing,\\n     3\\t// deterministic most-recent ordering, and lazy upgrade of a pre-cwd registry.\\n     4\\t// These are the registry operations the connector's launch-driven thread\\n     5\\t// resolution depends on; they are proven here at the registry boundary, not\\n     6\\t// only through the connector (anti-shim: the scope is the query, not a filter\\n     7\\t// over an unscoped list).\\n     8\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     9\\timport { threads } from \\\"../src/index.js\\\";\\n    10\\timport { openRaw, tempStore, type TempStore } from \\\"./fixtures/index.js\\\";\\n    11\\t\\n    12\\tlet store: TempStore;\\n    13\\tbeforeEach(() => {\\n    14\\t  store = tempStore();\\n    15\\t});\\n    16\\tafterEach(() => {\\n    17\\t  store.cleanup();\\n    18\\t});\\n    19\\t\\n    20\\tasync function create(opts: { title?: string; cwd?: string } = {}): Promise<string> {\\n    21\\t  const input: { filePath: string; registryPath: string; title?: string; cwd?: string } = {\\n    22\\t    filePath: store.threadPath(),\\n    23\\t    registryPath: store.registryPath,\\n    24\\t  };\\n    25\\t  if (opts.title !== undefined) input.title = opts.title;\\n    26\\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\n    27\\t  const result = await threads.newThread(input);\\n    28\\t  if (!result.ok) throw new Error(`create failed: ${result.error.reason}`);\\n    29\\t  return result.value.threadId;\\n    30\\t}\\n    31\\t\\n    32\\tdescribe(\\\"A-8: cwd column\\\", () => {\\n    33\\t  it(\\\"newThread stores cwd; resolve and listThreads carry it back\\\", async () => {\\n    34\\t    const id = await create({ cwd: \\\"/work/project-a\\\", title: \\\"a\\\" });\\n    35\\t\\n    36\\t    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n    37\\t    expect(resolved.ok).toBe(true);\\n    38\\t    if (resolved.ok) expect(resolved.value.cwd).toBe(\\\"/work/project-a\\\");\\n    39\\t\\n    40\\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n    41\\t    expect(listed.ok).toBe(true);\\n    42\\t    if (listed.ok) expect(listed.value[0]?.cwd).toBe(\\\"/work/project-a\\\");\\n    43\\t  });\\n    44\\t\\n    45\\t  it(\\\"a thread created with no cwd reports cwd undefined\\\", async () => {\\n    46\\t    const id = await create({ title: \\\"no-cwd\\\" });\\n    47\\t    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n    48\\t    expect(resolved.ok).toBe(true);\\n    49\\t    if (resolved.ok) expect(resolved.value.cwd).toBeUndefined();\\n    50\\t  });\\n    51\\t});\\n    52\\t\\n    53\\tdescribe(\\\"A-8: partial-id resolve\\\", () => {\\n    54\\t  it(\\\"resolves a unique prefix to the one matching thread\\\", async () => {\\n    55\\t    const id = await create({ title: \\\"only\\\" });\\n    56\\t    const prefix = id.slice(0, 8); // a true partial: shorter than the full id\\n    57\\t    expect(prefix.length).toBeLessThan(id.length);\\n    58\\t\\n    59\\t    const resolved = await threads.resolve({ threadId: prefix, registryPath: store.registryPath });\\n    60\\t    expect(resolved.ok).toBe(true);\\n    61\\t    if (resolved.ok) expect(resolved.value.threadId).toBe(id);\\n    62\\t  });\\n    63\\t\\n    64\\t  it(\\\"a full id still resolves exactly (exact match path)\\\", async () => {\\n    65\\t    const id = await create();\\n    66\\t    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n    67\\t    expect(resolved.ok).toBe(true);\\n    68\\t    if (resolved.ok) expect(resolved.value.threadId).toBe(id);\\n    69\\t  });\\n    70\\t\\n    71\\t  it(\\\"an ambiguous prefix fails ambiguous_thread_id and creates nothing\\\", async () => {\\n    72\\t    const a = await create();\\n    73\\t    const b = await create();\\n    74\\t    // Every id shares the \\\"th_\\\" scheme prefix, so it matches both threads.\\n    75\\t    const ambiguous = await threads.resolve({ threadId: \\\"th_\\\", registryPath: store.registryPath });\\n    76\\t    expect(ambiguous.ok).toBe(false);\\n    77\\t    if (!ambiguous.ok) {\\n    78\\t      expect(ambiguous.error.code).toBe(\\\"ambiguous_thread_id\\\");\\n    79\\t      expect(ambiguous.error.errorClass).toBe(\\\"caller_error\\\");\\n    80\\t      expect(ambiguous.error.reason).toContain(a);\\n    81\\t      expect(ambiguous.error.reason).toContain(b);\\n    82\\t    }\\n    83\\t\\n    84\\t    // No thread was created by the failed resolution.\\n    85\\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n    86\\t    expect(listed.ok).toBe(true);\\n    87\\t    if (listed.ok) expect(listed.value).toHaveLength(2);\\n    88\\t  });\\n    89\\t\\n    90\\t  it(\\\"an unresolvable id fails thread_not_found, never a silent match\\\", async () => {\\n    91\\t    await create();\\n    92\\t    const missing = await threads.resolve({\\n    93\\t      threadId: \\\"th_zzzzzzzzzzzzzzzz\\\", // 'z' is not in the hex id alphabet\\n    94\\t      registryPath: store.registryPath,\\n    95\\t    });\\n    96\\t    expect(missing.ok).toBe(false);\\n    97\\t    if (!missing.ok) expect(missing.error.code).toBe(\\\"thread_not_found\\\");\\n    98\\t  });\\n    99\\t\\n   100\\t  it(\\\"LIKE metacharacters in a partial id match literally, not as wildcards\\\", async () => {\\n   101\\t    await create();\\n   102\\t    await create();\\n   103\\t    // \\\"_\\\" is a LIKE single-char wildcard; unescaped it would match every id\\n   104\\t    // (all begin \\\"th_...\\\"). Escaped, \\\"th%\\\" / \\\"_\\\" must be treated literally and\\n   105\\t    // match nothing, since no id literally contains \\\"%\\\" or begins \\\"th_%\\\".\\n   106\\t    const pct = await threads.resolve({ threadId: \\\"th%\\\", registryPath: store.registryPath });\\n   107\\t    expect(pct.ok).toBe(false);\\n   108\\t    if (!pct.ok) expect(pct.error.code).toBe(\\\"thread_not_found\\\");\\n   109\\t  });\\n   110\\t});\\n   111\\t\\n   112\\tdescribe(\\\"A-8: cwd-scoped listing and most-recent ordering\\\", () => {\\n   113\\t  it(\\\"listThreads({cwd}) returns only that cwd's threads\\\", async () => {\\n   114\\t    const a1 = await create({ cwd: \\\"/work/a\\\" });\\n   115\\t    const a2 = await create({ cwd: \\\"/work/a\\\" });\\n   116\\t    await create({ cwd: \\\"/work/b\\\" });\\n   117\\t\\n   118\\t    const scoped = await threads.listThreads({ cwd: \\\"/work/a\\\", registryPath: store.registryPath });\\n   119\\t    expect(scoped.ok).toBe(true);\\n   120\\t    if (scoped.ok) {\\n   121\\t      expect(scoped.value).toHaveLength(2);\\n   122\\t      expect(new Set(scoped.value.map((t) => t.threadId))).toEqual(new Set([a1, a2]));\\n   123\\t      for (const t of scoped.value) expect(t.cwd).toBe(\\\"/work/a\\\");\\n   124\\t    }\\n   125\\t\\n   126\\t    const all = await threads.listThreads({ registryPath: store.registryPath });\\n   127\\t    expect(all.ok).toBe(true);\\n   128\\t    if (all.ok) expect(all.value).toHaveLength(3);\\n   129\\t  });\\n   130\\t\\n   131\\t  it(\\\"an empty cwd lists nothing without failing\\\", async () => {\\n   132\\t    await create({ cwd: \\\"/work/a\\\" });\\n   133\\t    const empty = await threads.listThreads({ cwd: \\\"/elsewhere\\\", registryPath: store.registryPath });\\n   134\\t    expect(empty.ok).toBe(true);\\n   135\\t    if (empty.ok) expect(empty.value).toEqual([]);\\n   136\\t  });\\n   137\\t\\n   138\\t  it(\\\"the last listed thread is the most recently created (insertion-order tie-break)\\\", async () => {\\n   139\\t    await create({ title: \\\"first\\\" });\\n   140\\t    await create({ title: \\\"second\\\" });\\n   141\\t    const last = await create({ title: \\\"third\\\" });\\n   142\\t\\n   143\\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n   144\\t    expect(listed.ok).toBe(true);\\n   145\\t    if (listed.ok) {\\n   146\\t      expect(listed.value).toHaveLength(3);\\n   147\\t      expect(listed.value.at(-1)?.threadId).toBe(last);\\n   148\\t    }\\n   149\\t  });\\n   150\\t});\\n   151\\t\\n   152\\tdescribe(\\\"A-8: lazy upgrade of a pre-cwd registry (migrate-on-read)\\\", () => {\\n   153\\t  it(\\\"reads a v1 registry, upgrading it to carry the cwd column\\\", async () => {\\n   154\\t    // Build a registry at the pre-A-8 v1 schema by hand (no cwd column).\\n   155\\t    const db = openRaw(store.registryPath);\\n   156\\t    db.exec(\\n   157\\t      `CREATE TABLE threads (\\n   158\\t        thread_id TEXT PRIMARY KEY,\\n   159\\t        file_path TEXT NOT NULL,\\n   160\\t        title TEXT,\\n   161\\t        created_at TEXT NOT NULL\\n   162\\t      );`,\\n   163\\t    );\\n   164\\t    db.exec(`PRAGMA user_version = 1;`);\\n   165\\t    db.prepare(\\n   166\\t      \\\"INSERT INTO threads (thread_id, file_path, title, created_at) VALUES (?, ?, ?, ?)\\\",\\n   167\\t    ).run(\\\"th_legacy0000\\\", \\\"/tmp/legacy.sqlite\\\", \\\"legacy\\\", \\\"2026-01-01T00:00:00.000Z\\\");\\n   168\\t    db.close();\\n   169\\t\\n   170\\t    // A read through the domain upgrades the schema and succeeds; the legacy\\n   171\\t    // row reports cwd undefined.\\n   172\\t    const resolved = await threads.resolve({ threadId: \\\"th_legacy0000\\\", registryPath: store.registryPath });\\n   173\\t    expect(resolved.ok).toBe(true);\\n   174\\t    if (resolved.ok) {\\n   175\\t      expect(resolved.value.title).toBe(\\\"legacy\\\");\\n   176\\t      expect(resolved.value.cwd).toBeUndefined();\\n   177\\t    }\\n   178\\t\\n   179\\t    // The registry now carries the cwd column at the current version.\\n   180\\t    const after = openRaw(store.registryPath);\\n   181\\t    const columns = (\\n   182\\t      after.prepare(\\\"PRAGMA table_info(threads)\\\").all() as unknown as Array<{ name: string }>\\n   183\\t    ).map((c) => c.name);\\n   184\\t    const version = after.prepare(\\\"PRAGMA user_version\\\").get() as unknown as { user_version: number };\\n   185\\t    after.close();\\n   186\\t    expect(columns).toContain(\\\"cwd\\\");\\n   187\\t    expect(Number(version.user_version)).toBe(2);\\n   188\\t  });\\n   189\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:77:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_35\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=1 && NR<=220 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' packages/pi-lhc/test/smoke/extension-load.test.ts\\\"\",\"aggregated_output\":\"     1\\timport { describe, expect, it } from \\\"vitest\\\";\\n     2\\timport { activate, createConnector, disposeInstance, EPIC_1_HOOKS, initInstance } from \\\"../../src/index.js\\\";\\n     3\\timport { createSessionState } from \\\"../../src/lifecycle/state.js\\\";\\n     4\\timport type { ExtensionAPI, ExtensionContext, PiHookName } from \\\"../../src/pi/types.js\\\";\\n     5\\timport { makeAgentEnd, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\"../fixtures/synthetic.js\\\";\\n     6\\t\\n     7\\t// A fake ExtensionAPI that records what the extension registers.\\n     8\\tfunction recordingPi(): {\\n     9\\t  pi: ExtensionAPI;\\n    10\\t  registered: PiHookName[];\\n    11\\t  commands: string[];\\n    12\\t  tools: string[];\\n    13\\t} {\\n    14\\t  const registered: PiHookName[] = [];\\n    15\\t  const commands: string[] = [];\\n    16\\t  const tools: string[] = [];\\n    17\\t  const pi: ExtensionAPI = {\\n    18\\t    registerHook(name) {\\n    19\\t      registered.push(name);\\n    20\\t    },\\n    21\\t    registerCommand(name) {\\n    22\\t      commands.push(name);\\n    23\\t    },\\n    24\\t    registerTool(tool) {\\n    25\\t      tools.push(tool.name);\\n    26\\t    },\\n    27\\t    appendEntry() {},\\n    28\\t  };\\n    29\\t  return { pi, registered, commands, tools };\\n    30\\t}\\n    31\\t\\n    32\\t// A synthetic per-hook ctx carrying METHODS (not plain data) and a unique\\n    33\\t// marker — so a retained ctx would break the structuredClone plain-data guard.\\n    34\\tfunction syntheticCtx(marker: string): ExtensionContext {\\n    35\\t  return {\\n    36\\t    cwd: `/tmp/${marker}`,\\n    37\\t    hasUI: false,\\n    38\\t    modelRegistry: {\\n    39\\t      find: () => undefined,\\n    40\\t      hasConfiguredAuth: () => false,\\n    41\\t      getAvailable: () => [],\\n    42\\t    },\\n    43\\t    ui: { notify: () => {} },\\n    44\\t    sessionManager: { getEntries: () => [] },\\n    45\\t  };\\n    46\\t}\\n    47\\t\\n    48\\tdescribe(\\\"extension load + hook rail\\\", () => {\\n    49\\t  it(\\\"registers exactly the Epic 1 observe-only hook rail and not the context hook\\\", () => {\\n    50\\t    const { pi, registered, commands, tools } = recordingPi();\\n    51\\t    activate(pi);\\n    52\\t\\n    53\\t    expect(new Set(registered)).toEqual(new Set(EPIC_1_HOOKS));\\n    54\\t    expect(registered).toHaveLength(9);\\n    55\\t    expect(registered).not.toContain(\\\"context\\\"); // context serving is Epic 2\\n    56\\t    // observe-only: no operator commands / agent tools registered yet (Epic 3)\\n    57\\t    expect(commands).toEqual([]);\\n    58\\t    expect(tools).toEqual([]);\\n    59\\t  });\\n    60\\t\\n    61\\t  it(\\\"routes every hook to a guarded handler that never throws into PI and retains only plain data\\\", async () => {\\n    62\\t    const connector = createConnector();\\n    63\\t    // fire several hooks with DISTINCT ctx objects carrying methods\\n    64\\t    await connector.handlers.session_start(syntheticCtx(\\\"ctx-1\\\"), makeSessionStart(\\\"startup\\\"));\\n    65\\t    await connector.handlers.message_end(syntheticCtx(\\\"ctx-2\\\"), makeMessageEnd(makeUserMessage(\\\"hi\\\")));\\n    66\\t    await connector.handlers.agent_end(syntheticCtx(\\\"ctx-3\\\"), makeAgentEnd([]));\\n    67\\t\\n    68\\t    // (the awaits above completing is the \\\"never throws into PI\\\" assertion)\\n    69\\t    // retained state is plain data: structuredClone throws on a stored PI ctx (it has methods)\\n    70\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n    71\\t  });\\n    72\\t\\n    73\\t  it(\\\"keeps SessionState plain-data-only — it survives structuredClone with every field populated\\\", () => {\\n    74\\t    const state = createSessionState({ filePath: \\\"/tmp/thread.sqlite\\\" });\\n    75\\t    state.flags.startupValidationReported = true;\\n    76\\t    state.flags.toldUserAboutGap = true; // open index signature, still plain data\\n    77\\t    state.health.lastCaptureFailure = { code: \\\"malformed_event\\\", message: \\\"bad shape\\\", recordedGap: true };\\n    78\\t    state.health.startupValidation = { unreachable: [] };\\n    79\\t\\n    80\\t    const clone = structuredClone(state);\\n    81\\t    expect(clone).toEqual(state);\\n    82\\t    expect(clone).not.toBe(state);\\n    83\\t  });\\n    84\\t\\n    85\\t  it(\\\"init/dispose seam is real and fails closed: init on a missing thread returns a typed error, dispose(null) is a no-op\\\", async () => {\\n    86\\t    // No thread file at this path: init validates the thread before any SDK\\n    87\\t    // construction, so it fails closed with a typed result — never a throw into\\n    88\\t    // a PI hook. (Story 1 implements the seam; the full lifecycle behavior is\\n    89\\t    // covered in test/lifecycle/*.)\\n    90\\t    const initResult = await initInstance(\\n    91\\t      { filePath: \\\"/tmp/pi-lhc-nonexistent-thread.sqlite\\\" },\\n    92\\t      { mode: \\\"background\\\" },\\n    93\\t    );\\n    94\\t    expect(initResult.ok).toBe(false);\\n    95\\t    if (!initResult.ok) {\\n    96\\t      expect(initResult.error.code).toBe(\\\"thread_not_found\\\");\\n    97\\t      expect(initResult.error.errorClass).toBe(\\\"caller_error\\\");\\n    98\\t    }\\n    99\\t\\n   100\\t    // Disposing with no live instance is a successful no-op.\\n   101\\t    const disposeResult = await disposeInstance(null);\\n   102\\t    expect(disposeResult.ok).toBe(true);\\n   103\\t  });\\n   104\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:80:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_38\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=1 && NR<=220 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' packages/pi-lhc/src/pi/types.ts\\\"\",\"aggregated_output\":\"     1\\t// Local declarations of the PI extension surface the connector consumes.\\n     2\\t//\\n     3\\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\\n     4\\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\\n     5\\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\\n     6\\t// build-time dependency of this workspace, so the connector declares the slice\\n     7\\t// of their contract it touches and swaps to the real imports when the\\n     8\\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\\n     9\\t// surface here — rather than scattered `any` — means later stories get real\\n    10\\t// type-checking against the contract PI actually fires.\\n    11\\t\\n    12\\t// ── Hook vocabulary ──────────────────────────────────────────────────\\n    13\\t\\n    14\\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\\n    15\\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\\n    16\\t *  serving is Epic 2. */\\n    17\\texport type PiHookName =\\n    18\\t  | \\\"session_start\\\"\\n    19\\t  | \\\"message_end\\\"\\n    20\\t  | \\\"turn_end\\\"\\n    21\\t  | \\\"agent_end\\\"\\n    22\\t  | \\\"model_select\\\"\\n    23\\t  | \\\"thinking_level_select\\\"\\n    24\\t  | \\\"session_before_fork\\\"\\n    25\\t  | \\\"session_before_switch\\\"\\n    26\\t  | \\\"session_shutdown\\\"\\n    27\\t  | \\\"context\\\";\\n    28\\t\\n    29\\texport type SessionStartReason = \\\"startup\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\" | \\\"fork\\\";\\n    30\\texport type SessionShutdownReason = \\\"shutdown\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\";\\n    31\\t\\n    32\\texport interface SessionStartEvent {\\n    33\\t  reason: SessionStartReason;\\n    34\\t  previousSessionFile?: string;\\n    35\\t}\\n    36\\texport interface MessageEndEvent {\\n    37\\t  message: AgentMessage;\\n    38\\t}\\n    39\\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\\n    40\\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\\n    41\\texport interface TurnEndEvent {\\n    42\\t  turnIndex: number;\\n    43\\t  message: AgentMessage;\\n    44\\t  toolResults: ToolResultMessage[];\\n    45\\t  stopReason?: PiStopReason;\\n    46\\t}\\n    47\\texport interface AgentEndEvent {\\n    48\\t  messages: AgentMessage[];\\n    49\\t}\\n    50\\texport interface ModelSelectEvent {\\n    51\\t  model: ModelDescriptor;\\n    52\\t  previousModel?: ModelDescriptor;\\n    53\\t  source?: string;\\n    54\\t}\\n    55\\texport interface ThinkingLevelSelectEvent {\\n    56\\t  level: string;\\n    57\\t  previousLevel: string;\\n    58\\t}\\n    59\\texport interface SessionBeforeForkEvent {\\n    60\\t  entryId: string;\\n    61\\t  position?: number;\\n    62\\t}\\n    63\\texport interface SessionBeforeSwitchEvent {\\n    64\\t  intent: \\\"new\\\" | \\\"resume\\\";\\n    65\\t}\\n    66\\texport interface SessionShutdownEvent {\\n    67\\t  reason: SessionShutdownReason;\\n    68\\t  targetSessionFile?: string;\\n    69\\t}\\n    70\\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\\n    71\\texport interface ContextEvent {\\n    72\\t  messages: AgentMessage[];\\n    73\\t}\\n    74\\t\\n    75\\t/** Maps each hook to the payload PI delivers with it. */\\n    76\\texport interface PiHookEventMap {\\n    77\\t  session_start: SessionStartEvent;\\n    78\\t  message_end: MessageEndEvent;\\n    79\\t  turn_end: TurnEndEvent;\\n    80\\t  agent_end: AgentEndEvent;\\n    81\\t  model_select: ModelSelectEvent;\\n    82\\t  thinking_level_select: ThinkingLevelSelectEvent;\\n    83\\t  session_before_fork: SessionBeforeForkEvent;\\n    84\\t  session_before_switch: SessionBeforeSwitchEvent;\\n    85\\t  session_shutdown: SessionShutdownEvent;\\n    86\\t  context: ContextEvent;\\n    87\\t}\\n    88\\t\\n    89\\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\\n    90\\t *  connector must never retain it across calls (PI replaces session objects on\\n    91\\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\\n    92\\texport type PiHookHandler<N extends PiHookName> = (\\n    93\\t  ctx: ExtensionContext,\\n    94\\t  event: PiHookEventMap[N],\\n    95\\t) => void | Promise<void>;\\n    96\\t\\n    97\\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\\n    98\\t\\n    99\\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\\n   100\\t\\n   101\\texport interface PiToolSpec {\\n   102\\t  name: string;\\n   103\\t  description?: string;\\n   104\\t  promptSnippet?: string;\\n   105\\t  promptGuidelines?: string;\\n   106\\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\\n   107\\t}\\n   108\\t\\n   109\\t/** The factory-time API. Hook registration and command/tool registration take\\n   110\\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\\n   111\\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\\n   112\\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\\n   113\\texport interface ExtensionAPI {\\n   114\\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\\n   115\\t  registerCommand(name: string, handler: PiCommandHandler): void;\\n   116\\t  registerTool(tool: PiToolSpec): void;\\n   117\\t  appendEntry(customType: string, data: unknown): void;\\n   118\\t}\\n   119\\t\\n   120\\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\\n   121\\t\\n   122\\texport interface ModelDescriptor {\\n   123\\t  provider: string;\\n   124\\t  id: string;\\n   125\\t}\\n   126\\t\\n   127\\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\\n   128\\t *  owns. The connector treats provider/model as opaque routing keys. */\\n   129\\texport interface ModelHandle extends ModelDescriptor {\\n   130\\t  readonly [k: string]: unknown;\\n   131\\t}\\n   132\\t\\n   133\\texport interface ModelRegistry {\\n   134\\t  find(provider: string, model: string): ModelHandle | undefined;\\n   135\\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\\n   136\\t  getAvailable(): ModelHandle[];\\n   137\\t}\\n   138\\t\\n   139\\texport interface ExtensionUI {\\n   140\\t  notify(message: string, options?: { level?: \\\"info\\\" | \\\"warn\\\" | \\\"error\\\" }): void;\\n   141\\t}\\n   142\\t\\n   143\\texport interface SessionEntry {\\n   144\\t  type: string;\\n   145\\t  readonly [k: string]: unknown;\\n   146\\t}\\n   147\\t\\n   148\\texport interface SessionManager {\\n   149\\t  getEntries(): SessionEntry[];\\n   150\\t}\\n   151\\t\\n   152\\texport interface ExtensionContext {\\n   153\\t  modelRegistry: ModelRegistry;\\n   154\\t  ui: ExtensionUI;\\n   155\\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\\n   156\\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\\n   157\\t  hasUI: boolean;\\n   158\\t  sessionManager: SessionManager;\\n   159\\t  cwd: string;\\n   160\\t}\\n   161\\t\\n   162\\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\\n   163\\t\\n   164\\texport interface TextPart {\\n   165\\t  type: \\\"text\\\";\\n   166\\t  text: string;\\n   167\\t}\\n   168\\texport interface ThinkingPart {\\n   169\\t  type: \\\"thinking\\\";\\n   170\\t  thinking: string;\\n   171\\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\\n   172\\t   *  Epic 1 (tech design I-3). */\\n   173\\t  thinkingSignature?: string;\\n   174\\t}\\n   175\\texport interface ToolCallPart {\\n   176\\t  type: \\\"toolCall\\\";\\n   177\\t  /** Composite, stable across tool_execution_start → tool_result → message_end\\n   178\\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\\n   179\\t  id: string;\\n   180\\t  name: string;\\n   181\\t  arguments: Record<string, unknown>;\\n   182\\t  /** Opaque; captured, not interpreted (tech design I-3). */\\n   183\\t  thoughtSignature?: string;\\n   184\\t}\\n   185\\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\\n   186\\t *  the converter (tech design I-6), never silently dropped. */\\n   187\\texport interface ImagePart {\\n   188\\t  type: \\\"image\\\";\\n   189\\t  mimeType?: string;\\n   190\\t  data?: string;\\n   191\\t}\\n   192\\texport interface FileRefPart {\\n   193\\t  type: \\\"fileRef\\\";\\n   194\\t  path: string;\\n   195\\t}\\n   196\\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\\n   197\\t\\n   198\\texport type PiStopReason = \\\"stop\\\" | \\\"aborted\\\" | \\\"length\\\" | \\\"toolUse\\\" | (string & {});\\n   199\\t\\n   200\\texport interface TokenUsage {\\n   201\\t  inputTokens?: number;\\n   202\\t  outputTokens?: number;\\n   203\\t}\\n   204\\t\\n   205\\texport interface UserMessage {\\n   206\\t  role: \\\"user\\\";\\n   207\\t  content: ContentPart[];\\n   208\\t}\\n   209\\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\\n   210\\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\\n   211\\texport interface AssistantMessage {\\n   212\\t  role: \\\"assistant\\\";\\n   213\\t  content: ContentPart[];\\n   214\\t  stopReason?: PiStopReason;\\n   215\\t  usage?: TokenUsage;\\n   216\\t}\\n   217\\texport interface ToolResultMessage {\\n   218\\t  role: \\\"toolResult\\\";\\n   219\\t  toolCallId: string;\\n   220\\t  content: ContentPart[];\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:84:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_40\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=1 && NR<=170 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' docs/specs/02-pi-lhc/01-connector-core/epic.md\\\"\",\"aggregated_output\":\"     1\\t# Epic 1: Connector Core\\n     2\\t\\n     3\\t**Status:** Draft for review. **Ready for tech design once M0 lands.** Per the PRD's M0 gate, this epic's capture-verification tests consume the M0 corpus fixtures (Story 3) and two M0 decisions must be settled before tech design: the image/file-reference handling choice and the tool-call rendering choice (A5). These are named as M0 inputs below, not left as open tech design questions.\\n     4\\t**PRD:** `../00-prd.md` — Feature 1\\n     5\\t**Tech Arch:** `../01-tech-arch.md`\\n     6\\t**Wiring research:** `../notes/pi-ext-integration-research.md` (verified against PI v0.79.2)\\n     7\\t**Domain model:** `../../onboard/01-core-concepts.md`, `../../onboard/02-domain-design.md`\\n     8\\t\\n     9\\t---\\n    10\\t\\n    11\\t## Onboarding Context\\n    12\\t\\n    13\\t**PI** is the coding agent this extension loads into. PI runs a **session** (its unit of work — one running conversation with a model). PI exposes an **extension API**: an extension registers handlers for **hooks** (lifecycle events PI fires — session start, message finalized, turn ended, shutdown) and the **context hook** (PI asks the extension what message array to send the model). An extension runs in-process inside the PI process.\\n    14\\t\\n    15\\t**LHC** (Long Horizon Context) is the SDK this extension drives. It is consumed one way: a host process initializes one **LHC instance** in-process (`initLhc`) and operates it directly. LHC owns all context behavior and persists to one SQLite file per **thread** (LHC's durable record of a conversation). A **registry** (one SQLite catalog, default `~/.lhc/registry.sqlite`) lists every thread by id, title, cwd, and creation time.\\n    16\\t\\n    17\\t**The LHC thread is the system of record for the conversation, and the registry is the catalog of threads.** What an earlier draft got wrong was treating PI's session file as the place a thread mapping had to be stored and recovered; it does not, because a thread's identity arrives at launch — the operator selects it — so there is no mapping to recover and no pointer to keep in sync. What is true *in this epic* is narrower than \\\"PI has no session file\\\": this epic is observe-only, so **PI still runs its own session normally** — it persists its session, serves its own context to the model, and tracks its own fork lineage, exactly as vanilla PI does. LHC records alongside that as the durable conversation record. PI's session file becomes vestigial only in Feature 2, when LHC's served context replaces PI's transcript; until then the two coexist, and nothing the model sees changes.\\n    18\\t\\n    19\\tInside LHC:\\n    20\\t- An **intake event** is the unit of capture. New traffic enters as ordered intake events; LHC records them durably. The seven event kinds are `user_prompt`, `assistant_text`, `assistant_thinking`, `tool_call`, `tool_result`, `runtime_note`, and `turn_end`.\\n    21\\t- A **message** is projected from one or more intake events; a **turn** groups the messages of one exchange.\\n    22\\t- A **derivation** produces a **derived form** from recorded content (for example, a summary of a tool result). The seven derived-form kinds are `smoothed_prompt`, `tool_call_summary`, `tool_result_summary`, `turn_rendering`, `lower_band_projection`, `chunk_summary_detailed`, `chunk_summary_brief`. Each derivation runs through one **model-call function** the host supplies.\\n    23\\t- A **thread-view** is the bounded message array LHC serves to a model. Epic 2 builds and serves it; this epic does not.\\n    24\\t\\n    25\\t**This extension** maps PI's hook surface to LHC's operation surface. It holds no context state beyond a thread reference and a small set of told-the-user flags. Inference flows one direction: LHC asks for a model call, the extension routes it through PI's existing provider auth.\\n    26\\t\\n    27\\t**M0** is the pre-epic period that produces the recorded PI **corpora** (real sessions captured to fixtures) and the **converter** prototype (PI events → intake events). Live recon (June 2026) already established the PI event shapes this epic depends on; M0's remaining work is corpus breadth, the productionized converter, and derivation dial-in. This epic's capture-verification tests consume M0 corpora as fixtures.\\n    28\\t\\n    29\\t---\\n    30\\t\\n    31\\t## Feature Overview\\n    32\\t\\n    33\\tA PI session run with the extension loaded records into an LHC thread. Every user message, assistant message, thinking block, tool call, tool result, runtime change (model and thinking-level switches), and derived turn boundary is captured as ordered, duplicate-safe intake events. The thread is resolved at launch — a new thread, a picked one, the most recent, or a named id — through the registry, and capture continues on that thread across resume, reload, restart, and fork. Background derivations run through the user's existing PI logins. PI's own context handling runs unchanged; the extension changes nothing the model sees. Capture is verified by replaying recorded corpora through the converter and matching the read-back, without serving any context.\\n    34\\t\\n    35\\t### Flow Summary\\n    36\\t\\n    37\\t| Flow | Capability | Surface (tech arch) |\\n    38\\t|------|------------|---------------------|\\n    39\\t| 1 | Session lifecycle and launch-driven thread resolution | Session Lifecycle |\\n    40\\t| 2 | Event capture and turn derivation | Event Capture |\\n    41\\t| 3 | Fork as new thread | Session Lifecycle + Event Capture |\\n    42\\t| 4 | Inference host routing | Inference Host |\\n    43\\t| 5 | Startup validation and assignment config | Inference Host |\\n    44\\t| 6 | Capture verification | Event Capture (read-back via inspect) |\\n    45\\t\\n    46\\t---\\n    47\\t\\n    48\\t## User Profile\\n    49\\t\\n    50\\t**Primary User:** A developer using PI as their daily coding agent, with the `pi-lhc` extension loaded.\\n    51\\t**Context:** Running normal coding sessions — chatty exchanges, tool-heavy agent runs, sessions resumed across days, the occasional fork or mid-task kill. They are not interacting with LHC directly; capture runs in the background.\\n    52\\t**Mental Model:** \\\"I use PI exactly as before. In the background my whole session is recorded into a durable thread, so my context can be managed later. Nothing about how the agent behaves changes yet.\\\"\\n    53\\t**Key Constraint:** This epic is observe-only. The extension must add no perceptible latency and must change nothing the model sees — PI's native context handling stays in control. A capture failure must never break the PI session: writable-thread failures become durable, queryable gaps; store-unavailable failures become visible extension diagnostics because the gap cannot be written.\\n    54\\t\\n    55\\t---\\n    56\\t\\n    57\\t## Scope\\n    58\\t\\n    59\\t### In Scope\\n    60\\t\\n    61\\t- LHC instance lifecycle: initialize on session start, dispose on shutdown, reconstruct on reload — holding only plain data (thread reference, told-the-user flags) across hooks.\\n    62\\t- Launch-driven thread resolution: a new thread by default, a cwd-scoped picker (`--resume`/`-r`), the most recent thread (`--continue`/`-c`), or a named thread (`--session <id>`, partial-id match) — all resolved through the registry catalog.\\n    63\\t- Event capture: PI messages and turns mapped to LHC intake events (the productionized converter), preserving order and idempotency.\\n    64\\t- Runtime-change capture: model-select and thinking-level-select changes captured in order as `runtime_note` events, because they are observable only in-stream.\\n    65\\t- Turn derivation: LHC turn boundaries derived from PI traffic, not taken one-to-one from PI's per-agent-step `turn_end`.\\n    66\\t- Fork handling: a new thread per fork, seeded by replaying the source thread to the fork point, source unchanged.\\n    67\\t- The injected model-call function over PI's model registry and auth.\\n    68\\t- Model-assignment config (the seven derivation kinds) and startup validation with visible, actionable reporting.\\n    69\\t- Capture verification: recorded corpora replay identically through the converter; inspect surfaces reflect the captured session.\\n    70\\t\\n    71\\t### Out of Scope\\n    72\\t\\n    73\\t- Serving context to the model — Feature 2 / Epic 2. PI's native context handling runs as-is throughout this epic.\\n    74\\t- Intercepting or disabling PI's own compaction — Feature 2 / Epic 2.\\n    75\\t- Operator commands and agent self-inspection tools beyond what capture verification reads — Feature 3 / Epic 3.\\n    76\\t- Status-bar / footer UX beyond actionable startup-validation reporting — Feature 3 / Epic 3.\\n    77\\t- Packaging, the runner CLI, headless-mode conformance as a deliverable — Feature 4 / Epic 4.\\n    78\\t- Web-search, service-tier, and researcher-subagent extensions — Feature 5 / Epic 5.\\n    79\\t- Derivation prompt and model dial-in (quality tuning) — the paired M0 dial-in period; this epic ships default assignments and proves the routing, not the tuning.\\n    80\\t\\n    81\\t### Migration\\n    82\\t\\n    83\\tExisting POC threads are out of scope. They are on the pre-SDK storage shape; this epic starts fresh on new threads and lets old POC threads age out. No import or migration is built.\\n    84\\t\\n    85\\t---\\n    86\\t\\n    87\\t## Assumptions\\n    88\\t\\n    89\\t| # | Assumption | Status | Impact if wrong |\\n    90\\t|---|------------|--------|-----------------|\\n    91\\t| A-1 | The PI event shapes captured by live recon (event order, parallel-tool fan-out, abort shapes, resume behavior) hold for the targeted PI version. | Validated against v0.79.2; assumed stable across the 0.79 line | Converter mapping is wrong. Mitigated by corpus replay (Flow 6), which catches drift as a read-back mismatch rather than a silent error. |\\n    92\\t| A-2 | M0 delivers recorded PI corpora as test fixtures and a converter prototype to productionize. | Pending (M0) | The epic spec stands, but the build and the verification flow's tests wait on M0 corpora. Capture ACs are spec-complete; their fixtures are an M0 input. |\\n    93\\t| A-3 | PI resume serves prior history through the context hook and re-fires no historical `message_end` events; duplication arises only on reload and crash-replay. | Validated (recon) | If resume re-fired history, dedup load would be higher. Idempotency keys (Flow 2) already cover the reload/replay paths, so the contract holds either way. |\\n    94\\t| A-4 | The LHC construction export is `initLhc` (renamed from `createSdk`) by the time this epic is implemented. | Pending; mechanical rename | Low. If the rename slips, code reads `createSdk`; this spec uses `initLhc` as the agreed name. Tracked in tech arch TA4. |\\n    95\\t| A-5 | The model-call function is the host side of the inference seam already specced in the LHC v1 line (Epic 05): `ModelCall`, `ModelCallResult`, `ModelCallFailureKind`, `ModelAssignment`. | Validated against current LHC types | If the seam shape changed, routing AC wording shifts. Verified present in `packages/lhc/src/inference/types.ts`. |\\n    96\\t| A-6 | LHC `turn_end` with no open turn is a contractual no-op (Epic 01), tolerating PI's pre-first-prompt and dangling events. | Validated (LHC v1 spec) | If not a no-op, the converter would need to guard turn closes. Confirmed specced behavior. |\\n    97\\t| A-7 | The image / file-reference handling decision (placeholder vs. extending the intake payload schema) is settled by M0 before this epic's tech design. | Pending (M0 gate) | The converter's content-part mapping (Flow 2) depends on it. Recon found `@file.png` stays literal text in print mode; the interactive paste shape is uncaptured. M0 corpora establish frequency; the decision is an M0 output, not a tech design question. |\\n    98\\t| A-8 | The LHC registry gains a `cwd` column (set at thread creation), a `--resume` cwd filter on `listThreads`, partial-id match on `resolve`, and a `title` set at creation / updated on rename. | **Epic 1 implementation scope** (LHC-side); not yet in LHC code | AC-1.6 and AC-1.7 depend on these directly, so they are a build prerequisite for Story 1, not optional polish. The work is small and mechanical — the registry already carries id/title/created �� but \\\"small\\\" is not \\\"non-blocking\\\": the cwd-scoped picker and partial-id resolve cannot pass without them. They are gated before Story 1's launch-mode ACs. |\\n    99\\t| A-9 | Foreign PI extensions that persist state via session custom entries are not supported under pi-lhc in v1; pi-lhc threads own pi-lhc and conversation state only. | Decided (scope) | A third-party extension relying on PI session-file persistence loses its store when LHC replaces the session file. A passthrough lane for foreign custom entries is an explicit later design, named in the tech arch. No Epic 1 behavior depends on it. |\\n   100\\t\\n   101\\t---\\n   102\\t\\n   103\\t## Flow 1: Session Lifecycle and Launch-Driven Thread Resolution\\n   104\\t\\n   105\\tA PI session starts, and the first thing the extension settles is which thread this run records into. The thread's identity arrives with the launch: no flag means a new thread; `--resume`/`-r` opens a cwd-scoped picker over the registry; `--continue`/`-c` takes the most recent thread; `--session <id>` names one directly (a partial id matches a prefix). Every case resolves through the registry catalog — the operator's launch choice *is* the thread identity, so there is no mapping to recover. The extension then initializes one LHC instance in background scheduler mode against the resolved thread. Across PI's hooks it holds only plain data (the thread reference and a few flags) and retains no PI context object, because session replacement invalidates those objects.\\n   106\\t\\n   107\\t```mermaid\\n   108\\tsequenceDiagram\\n   109\\t  participant OP as operator (launch)\\n   110\\t  participant E as extension\\n   111\\t  participant R as registry\\n   112\\t  participant L as LHC instance\\n   113\\t  OP->>E: session_start (launch flags)\\n   114\\t  alt no flag\\n   115\\t    E->>R: newThread (cwd, title)\\n   116\\t  else --resume / -r\\n   117\\t    E->>R: listThreads (cwd) — picker — resolve(id)\\n   118\\t  else --continue / -c\\n   119\\t    E->>R: resolve most recent\\n   120\\t  else --session id\\n   121\\t    E->>R: resolve(id, partial match)\\n   122\\t  end\\n   123\\t  E->>L: initLhc (background) on resolved thread\\n   124\\t  Note over E,L: hooks fire — extension holds only threadRef and flags\\n   125\\t  OP->>E: session_shutdown (reason)\\n   126\\t  E->>L: dispose (flush/cleanup)\\n   127\\t```\\n   128\\t\\n   129\\t**AC-1.1:** On `session_start` with no thread-selecting launch flag, the extension creates a new LHC thread (registering it in the catalog with its cwd), initializes one LHC instance in background scheduler mode against it, and does not drive the derivation queue itself.\\n   130\\t\\n   131\\t**AC-1.2:** On `session_start` that resolves to an existing thread (via `--continue`, `--session`, or a picker selection), the extension initializes against that thread by resolving it through the registry. No second thread is created for an already-resolved thread.\\n   132\\t\\n   133\\t**AC-1.3:** Across all hooks, the extension holds only plain data (thread reference, file path, told-the-user flags) between events. It retains no PI context or session-manager object across hook boundaries; each handler uses the fresh context PI provides. A session replacement (new/resume/fork) that invalidates prior context objects does not break capture.\\n   134\\t\\n   135\\t**AC-1.4:** On `session_shutdown`, the extension disposes the LHC instance with flush and cleanup. A subsequent run that resolves the same thread finds it complete through the last event recorded before shutdown — no trailing loss.\\n   136\\t\\n   137\\t**AC-1.5:** On reload (extension torn down and re-initialized while the same session continues), the extension reconstructs the thread reference from durable state (the resolved thread id), not from retained in-memory objects, and capture continues on the same thread.\\n   138\\t\\n   139\\t**AC-1.6:** Launch resolves the thread by mode: no flag creates a new thread; `--session <id>` resolves a named thread by full or partial id; `--continue`/`-c` resolves the most recently created thread; an ambiguous or unresolvable id fails with an actionable message rather than silently creating a new thread.\\n   140\\t\\n   141\\t**AC-1.7:** `--resume`/`-r` lists threads scoped to the current working directory, each shown with its title and creation time, and resolves the operator's selection. With no threads for the cwd, the picker reports an empty list rather than failing.\\n   142\\t\\n   143\\t---\\n   144\\t\\n   145\\t## Flow 2: Event Capture and Turn Derivation\\n   146\\t\\n   147\\tFrom the first prompt on, the extension maps each finalized PI message to LHC intake events and records them in order. PI fires a turn boundary per agent step; an LHC turn spans a whole exchange (one user prompt and everything the agent did in response). The converter derives LHC turn boundaries from PI traffic rather than copying PI's. Capture is duplicate-safe; writable-thread failures become durable gaps, store-unavailable failures become visible extension diagnostics, and neither breaks the session.\\n   148\\t\\n   149\\t```mermaid\\n   150\\tsequenceDiagram\\n   151\\t  participant PI as PI session\\n   152\\t  participant E as converter\\n   153\\t  participant L as LHC intake\\n   154\\t  PI->>E: message_end(user)\\n   155\\t  E->>L: user_prompt event (opens LHC turn)\\n   156\\t  PI->>E: message_end(assistant [thinking,text,toolCall×N])\\n   157\\t  E->>L: assistant_thinking, assistant_text, tool_call×N\\n   158\\t  PI->>E: message_end(toolResult) ×N\\n   159\\t  E->>L: tool_result×N (correlated by toolCallId)\\n   160\\t  Note over PI,E: PI fires turn_end per agent step — NOT mapped 1:1\\n   161\\t  PI->>E: agent run completes (no further tool calls)\\n   162\\t  E->>L: turn_end event (closes the LHC turn)\\n   163\\t```\\n   164\\t\\n   165\\t**AC-2.1:** Every PI message finalized through `message_end` — user, assistant, tool result — is mapped to LHC intake events and recorded in source order. An assistant message fans out to per-content-part events in thinking → text → tool-call order: `assistant_thinking`, `assistant_text`, and one `tool_call` per call.\\n   166\\t\\n   167\\t**AC-2.2:** LHC turn boundaries are derived from PI traffic, not from PI's per-agent-step `turn_end`. One LHC turn spans a user prompt and all subsequent agent activity until the next user prompt or the end of the agent run. The converter emits exactly one LHC `turn_end` event per LHC turn, at the agent run's completion — never one per PI `turn_end`, and never keyed off PI's per-agent-run `turnIndex` as a session counter.\\n   168\\t\\n   169\\t**AC-2.3:** Parallel tool calls are captured with correct correlation: when one assistant message carries multiple `tool_call` parts and their results complete out of arrival order, each `tool_result` event is matched to its call by `toolCallId`, not by arrival order.\\n   170\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:86:{\"type\":\"item.started\",\"item\":{\"id\":\"item_42\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'rg -n \\\"rememberedThreadId|appendEntry|previousSessionFile|targetSessionFile|sessionStorage|localStorage|writeFile|readFile|durable|reload\\\" packages/pi-lhc/src packages/pi-lhc/test/lifecycle/thread-resolution.test.ts packages/pi-lhc/test/smoke/extension-load.test.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:87:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_42\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'rg -n \\\"rememberedThreadId|appendEntry|previousSessionFile|targetSessionFile|sessionStorage|localStorage|writeFile|readFile|durable|reload\\\" packages/pi-lhc/src packages/pi-lhc/test/lifecycle/thread-resolution.test.ts packages/pi-lhc/test/smoke/extension-load.test.ts'\",\"aggregated_output\":\"packages/pi-lhc/test/smoke/extension-load.test.ts:27:    appendEntry() {},\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:1:// Story 1 — launch-driven thread resolution, plain-data state, and reload\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:4:// registry; the plain-data rule and reload are exercised through the connector.\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:40:  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:173:  it(\\\"TC-1.5 (risk: restart): reattach reconstructs the thread from its durable id after the holder is discarded\\\", async () => {\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:190:    // Discard ALL in-memory state. Only the durable id survives (as it would in\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:218:      newThreadFilePath: () => store.threadPath(),\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:242:describe(\\\"Story 1: reload reconstruction (connector wiring)\\\", () => {\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:243:  it(\\\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\\\", async () => {\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:245:    // The reload path must instead reattach the durable resolved id (AC-1.5).\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:249:      newThreadFilePath: () => store.threadPath(),\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:253:    await connector.handlers.session_start(syntheticCtx(\\\"/work/reload\\\"), makeSessionStart(\\\"new\\\"));\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:259:    // /reload fires shutdown{reload} then session_start{reload} on the same\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:261:    await connector.handlers.session_shutdown(syntheticCtx(\\\"/work/reload\\\"), { reason: \\\"reload\\\" });\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:262:    await connector.handlers.session_start(syntheticCtx(\\\"/work/reload\\\"), makeSessionStart(\\\"reload\\\"));\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:264:    const reloadedRef = connector.getState()?.threadRef;\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:265:    const reloadedId =\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:266:      reloadedRef !== undefined && \\\"threadId\\\" in reloadedRef ? reloadedRef.threadId : null;\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:267:    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\\npackages/pi-lhc/src/index.ts:61:  newThreadFilePath?: () => string;\\npackages/pi-lhc/src/index.ts:71: *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\npackages/pi-lhc/src/index.ts:114:function defaultNewThreadFilePath(): string {\\npackages/pi-lhc/src/index.ts:128:  // The connector's retained state. `state` is plain data (the durable thread\\npackages/pi-lhc/src/index.ts:129:  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\npackages/pi-lhc/src/index.ts:130:  // `rememberedThreadId` is the durable id the reload path reattaches by; and\\npackages/pi-lhc/src/index.ts:134:  let rememberedThreadId: string | null = null;\\npackages/pi-lhc/src/index.ts:138:  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\npackages/pi-lhc/src/index.ts:147:  // On reload (same session continues, in-memory state wiped) reconstruct the\\npackages/pi-lhc/src/index.ts:148:  // SAME thread from its durable id rather than re-running the launch — a\\npackages/pi-lhc/src/index.ts:151:  // --session/--continue/--resume reloads. The permanent home for reload\\npackages/pi-lhc/src/index.ts:154:    if (event.reason === \\\"reload\\\" && rememberedThreadId !== null) {\\npackages/pi-lhc/src/index.ts:155:      return { session: rememberedThreadId };\\npackages/pi-lhc/src/index.ts:172:    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\\npackages/pi-lhc/src/index.ts:174:      newThreadFilePath,\\npackages/pi-lhc/src/index.ts:205:    rememberedThreadId = threadIdOf(resolved.value);\\npackages/pi-lhc/src/index.ts:209:  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\npackages/pi-lhc/src/index.ts:278: *  loads (and again on `/reload`). Registers the observe-only hook rail with\\npackages/pi-lhc/src/pi/types.ts:29:export type SessionStartReason = \\\"startup\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\" | \\\"fork\\\";\\npackages/pi-lhc/src/pi/types.ts:30:export type SessionShutdownReason = \\\"shutdown\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\";\\npackages/pi-lhc/src/pi/types.ts:34:  previousSessionFile?: string;\\npackages/pi-lhc/src/pi/types.ts:68:  targetSessionFile?: string;\\npackages/pi-lhc/src/pi/types.ts:111: *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\\npackages/pi-lhc/src/pi/types.ts:117:  appendEntry(customType: string, data: unknown): void;\\npackages/pi-lhc/src/lifecycle/instance.ts:26: *  then release the instance. Captured intake is already durable (intake writes\\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:24:  newThreadFilePath: () => string;\\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:27:/** The durable, plain-data thread reference the connector retains and\\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:29: *  object. `{ filePath }` is avoided so reload reconstructs by id. */\\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:49: *  durable id rather than a retained object (AC-1.5). */\\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:83:    filePath: deps.newThreadFilePath(),\\npackages/pi-lhc/src/lifecycle/state.ts:11: *  durable, queryable gap rather than throwing into a PI hook (AC-2.7). */\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/004-verify.stdout.log:92:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_44\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"awk 'NR>=320 && NR<=420 {printf \\\\\\\"%6d\\\\\\\\t%s\\\\\\\\n\\\\\\\", NR, \\\"'$0}'\\\"' docs/specs/02-pi-lhc/01-connector-core/epic.md\\\"\",\"aggregated_output\":\"   320\\t\\n   321\\t### Abort and crash shapes\\n   322\\t\\n   323\\t| Shape | PI signal | Converter behavior |\\n   324\\t|-------|-----------|--------------------|\\n   325\\t| Graceful interrupt | assistant `message_end` with partial content and `stopReason: aborted`; `turn_end` `aborted`; `agent_end` fires | Capture the partial content; carry the aborted disposition; close the LHC turn normally (a complete-but-aborted turn) |\\n   326\\t| Hard kill | user `message_end` only; no assistant close, no `turn_end`, no `agent_end` | On reattach, find a dangling open turn with a trailing user prompt; tolerate it (LHC `turn_end`-with-no-open-turn is a no-op); resume capture without duplicating the recorded prefix |\\n   327\\t\\n   328\\t### Idempotency key\\n   329\\t\\n   330\\tEach emitted event carries a stable idempotency key so re-delivery (reload, crash-replay) is recognized and skipped. Construction precedence (from the POC mapper, carried forward): PI entry id (`pi:<session>:entry:<entryId>`) → provider response id / tool-call id → content fingerprint as last resort. The exact construction is tech design; the contract is that the key is stable across re-delivery of the same logical event and unique across distinct events.\\n   331\\t\\n   332\\t### Thread resolution and fork lineage\\n   333\\t\\n   334\\tThe thread is resolved at launch through the registry catalog. The four launch modes and their registry operations:\\n   335\\t\\n   336\\t| Launch | Registry operation |\\n   337\\t|--------|--------------------|\\n   338\\t| no flag | `newThread({ filePath, cwd, title })` — new thread, registered |\\n   339\\t| `--session <id>` | `resolve({ threadId })`, full or partial-id match |\\n   340\\t| `--continue` / `-c` | resolve the most recently created thread |\\n   341\\t| `--resume` / `-r` | `listThreads({ cwd })` → picker → `resolve({ threadId })` |\\n   342\\t\\n   343\\tThe contract: the thread id is an input to the run (from the operator's launch choice or the picker), so resolution holds no in-memory object from a prior process and there is no two-record mapping to drift. An ambiguous or unresolvable `--session` id fails with an actionable message; it never silently creates a new thread.\\n   344\\t\\n   345\\tFork is the one case where a thread is created mid-run rather than chosen at launch. Fork detection does not depend on a `session_start` fork reason — recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present; in Epic 1, PI's session tree (the `parentId` chain) is also available as fork evidence, because PI still runs its own session here. The seeded thread is built by replay (Flow 3) and the source thread is never written. The long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial); this epic does not depend on PI's session tree as the permanent source.\\n   346\\t\\n   347\\t### Model-call function (host-supplied)\\n   348\\t\\n   349\\tThe contract LHC depends on (`packages/lhc/src/inference/types.ts`, Epic 05):\\n   350\\t\\n   351\\t```\\n   352\\tModelCall = (input) => Promise<ModelCallResult>\\n   353\\t\\n   354\\tinput:  { provider: string, model: string,\\n   355\\t          messages: { role: \\\"system\\\" | \\\"user\\\", content: string }[] }\\n   356\\t\\n   357\\tresult: { ok: true,  text: string }\\n   358\\t      | { ok: false, kind: ModelCallFailureKind, message: string }\\n   359\\t\\n   360\\tModelCallFailureKind =\\n   361\\t  \\\"auth\\\" | \\\"invalid_request\\\"          (terminal)\\n   362\\t  | \\\"rate_limit\\\" | \\\"timeout\\\" | \\\"network\\\"  (retryable)\\n   363\\t  | \\\"empty_output\\\"                    (adapter-generated; host never returns it)\\n   364\\t  | \\\"other\\\"                           (thrown exceptions classify here)\\n   365\\t```\\n   366\\t\\n   367\\t`provider` and `model` are opaque routing keys; only the host's function interprets them. Single-turn only — no tools, no streaming, no multi-turn state.\\n   368\\t\\n   369\\t### Model assignments\\n   370\\t\\n   371\\t```\\n   372\\tModelAssignment = { provider: string, model: string, prompt: string }\\n   373\\tassignments: Record<FormKind, ModelAssignment>   // all seven, validated complete at init\\n   374\\t```\\n   375\\t\\n   376\\t`FormKind` is the seven derivation kinds: `smoothed_prompt`, `tool_call_summary`, `tool_result_summary`, `turn_rendering`, `lower_band_projection`, `chunk_summary_detailed`, `chunk_summary_brief`. `prompt` must name a registered prompt. Initialization fails loudly if any kind is missing, references an unknown prompt, or carries a placeholder.\\n   377\\t\\n   378\\t### Error shapes\\n   379\\t\\n   380\\tCapture operations return LHC's `OpResult` (typed ok/error with a code), never throwing into the PI hook. When the thread is writable, a capture failure is recorded against the thread and surfaced through health (Flow 2, Flow 6). When the store is unavailable, the extension records a diagnostic/health signal outside the thread because no durable gap can be written. Neither path propagates an exception that would break the PI session.\\n   381\\t\\n   382\\t---\\n   383\\t\\n   384\\t## Non-Functional Requirements\\n   385\\t\\n   386\\t- **Observe-only.** Nothing the model sees changes in this epic. PI's native context handling runs untouched; the extension registers no `context` hook behavior here.\\n   387\\t- **No perceptible latency.** Capture work does not block the user's interactive turn. Derivations run in LHC's background scheduler mode.\\n   388\\t- **Crash safety.** A hard kill leaves a dangling open turn; the next run that resolves the same thread tolerates it without loss or duplication. There is no mapping to lose in an early-crash window — the thread is resolved from the launch choice, not recovered from a session file.\\n   389\\t- **No stale context held.** The extension holds only plain data across hooks. It never caches a PI context or session-manager object beyond the handler that received it.\\n   390\\t- **Headless parity.** Every user-facing behavior in this epic (startup-validation reporting) works in PI's `rpc`, `json`, and `print` modes, guarded on UI availability — never assuming a TUI. (Headless conformance as a delivered guarantee is Epic 4; the constraint is honored here so nothing built now blocks it.)\\n   391\\t- **Fail loud on misconfiguration.** Missing, unknown, or placeholder assignments fail at initialization with an actionable error, not a silent skip.\\n   392\\t\\n   393\\t---\\n   394\\t\\n   395\\t## Tech Design Questions\\n   396\\t\\n   397\\t1. **Fork derived-form reuse** — whether provenance identity (deterministic IDs) can be proven safe enough to copy derived forms across a fork, or whether forks always requeue. Informed by LHC's deterministic-ID property.\\n   398\\t2. **`thinkingSignature` handling** — assistant thinking carries an opaque encrypted reasoning token; store it on the event or drop it. An LHC call.\\n   399\\t3. **Converter structure** — the converter is the productionized M0 prototype; how it consumes `message_end` streams and emits batched `MessageEventInput[]` per the `intakeStream.messageEvents` contract.\\n   400\\t4. **Title derivation** — what populates a thread's registry `title` for the picker (first user prompt, a derived summary, or operator-set), and how a mid-session rename updates it.\\n   401\\t\\n   402\\t> Thread mapping is **not** a tech design question — the thread is resolved at launch through the registry (Flow 1), with no stored PI-session→thread mapping, so the former \\\"mapping persistence shape\\\" and \\\"resolution by external key\\\" questions are dissolved, not deferred. (PI keeps its own session file in this observe-only epic; it is just not where thread identity lives.)\\n   403\\t\\n   404\\t> Image / file-reference handling is **not** a tech design question — it is an M0 decision (A-7), settled before this epic's tech design per the PRD's M0 gate.\\n   405\\t\\n   406\\t---\\n   407\\t\\n   408\\t## Story Breakdown\\n   409\\t\\n   410\\tPartitioning follows the build path: each story lands testable behavior on the structure the previous one established. Capture comes first; verification proves it; fork and inference build on it. The flow-per-story cut was adjusted in two places: verification (Flow 6) is sequenced right after capture because it is how capture is proven, and fork (Flow 3) is its own story because its replay-seeding machinery is distinct from the reattach logic of Flow 1.\\n   411\\t\\n   412\\t### Story 0: Extension Foundation\\n   413\\t\\n   414\\t**Delivers:** The walking skeleton: extension package scaffold, the PI extension entry point and hook registration rail, the plain-data-only state holder, the LHC instance init/dispose seam (stubbed), test fixture and corpus-loading harness, and typed fail-closed stubs.\\n   415\\t**Governing idea:** Every later story adds behavior to a structure that already loads in PI, holds no stale context, and fails closed with typed errors.\\n   416\\t**Prerequisite:** None.\\n   417\\t**Boundary / risk notes:** Stubs fail closed, never fake success (tech arch convention). The plain-data-only rule (AC-1.3) is established here as the state-holder shape so no later story is tempted to cache a context object.\\n   418\\t**Flows/ACs covered:** None directly; smoke tests only — extension loads, registers hooks, init/dispose seam runs, fixture loader produces valid intake-event shapes.\\n   419\\t**Estimated test count:** 4–6 smoke tests\\n   420\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/story-lead/prompts/001-planner-turn-004.md:41:- Test fixture and corpus-loading harness that can load recorded PI corpora and expected intake-event shapes.\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/story-lead/prompts/001-planner-turn-004.md:93:| Fixtures | `packages/pi-lhc/test/fixtures/corpus.ts`, `packages/pi-lhc/test/fixtures/synthetic.ts`, `packages/pi-lhc/test/fixtures/model-call.ts`, `packages/pi-lhc/test/fixtures/thread.ts` |\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/story-lead/prompts/001-planner-turn-004.md:165:This plan maps every TC to one or more tests, assigns each to a chunk, and lays out the Red/Green sequence per chunk. The mock boundary is fixed by the tech design: the PI hook surface (fed by synthetic events and recorded corpora) and the `ModelCall` (a deterministic fake) are the only external edges; everything LHC runs real against a temp SQLite thread. Connector modules are exercised through their entry points, never mocked against each other.\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/story-lead/prompts/001-planner-turn-004.md:204:| TC-1.6 | Launch modes resolve correctly | `launch` = `{}` / `{session:fullId}` / `{session:partialId}` / `{continue:true}` / `{session:badId}` | new creates; full+partial id resolve the right thread; continue resolves most-recent; bad id returns an actionable error and creates **no** thread |\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/story-lead/prompts/001-planner-turn-004.md:211:| TC-2.1 | User/assistant/toolResult record ordered; assistant fans out thinking→text→toolCall | synthetic sequence | events recorded in source order; assistant fan-out order exact |\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/story-lead/prompts/001-planner-turn-004.md:301:- **Red:** fixture-invariant tests (co
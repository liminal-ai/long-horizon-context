{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ff46f17e5e934776b009e3b1","type":"tool_result","content":"1\t// Epic 05 Story 1 (Flow 6): CLI retirement proof — TC-6.1, TC-6.2.\n2\t// The package publishes an SDK-only surface: no binary, no named-provider\n3\t// registry, no env/flag provider resolution. Deletion is proven three ways:\n4\t// an export-name snapshot of the package entry (catches both leftover\n5\t// CLI-only exports and accidental removals), a manifest check, and a\n6\t// source-level scan for the retired resolution vocabulary. Provider arrival\n7\t// is injection at createSdk only.\n8\timport { existsSync, readdirSync, readFileSync, statSync } from \"node:fs\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\timport { afterEach, describe, expect, it } from \"vitest\";\n12\timport * as api from \"../src/index.js\";\n13\timport { createSdk, type SdkConfig } from \"../src/index.js\";\n14\t\n15\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n16\t\n17\t// The checked-in SDK-only surface (AC-6.1). A diff here is an intentional\n18\t// public-API change: update the list in the same change that alters the\n19\t// exports, never to quiet the test.\n20\tconst SDK_ONLY_EXPORTS = [\n21\t  \"BUILT_IN_PROFILES\",\n22\t  \"DEFAULT_COMPACT_THRESHOLD\",\n23\t  \"DEFAULT_PROMPT_NAMES\",\n24\t  \"DEFAULT_VISIBILITY\",\n25\t  \"PROMPT_NAMES\",\n26\t  \"TOKEN_ESTIMATOR_ID\",\n27\t  \"WORK_KIND_REGISTRY\",\n28\t  \"assembleWorkHandlerMap\",\n29\t  \"countLiveItems\",\n30\t  \"createDeterministicProvider\",\n31\t  \"createSdk\",\n32\t  \"deterministicOutcomesSuffix\",\n33\t  \"deterministicReceiptsSuffix\",\n34\t  \"deterministicText\",\n35\t  \"enqueue\",\n36\t  \"estimateTokens\",\n37\t  \"inspect\",\n38\t  \"intakeStream\",\n39\t  \"lookupWorkHandler\",\n40\t  \"messages\",\n41\t  \"queueDetail\",\n42\t  \"runInTransaction\",\n43\t  \"setSchedulerPoke\",\n44\t  \"setThreadTouch\",\n45\t  \"supersedeQueued\",\n46\t  \"threadView\",\n47\t  \"threads\",\n48\t  \"turns\",\n49\t];\n50\t\n51\tfunction collectSourceFiles(dir: string, out: string[] = []): string[] {\n52\t  for (const entry of readdirSync(dir)) {\n53\t    const full = path.join(dir, entry);\n54\t    if (statSync(full).isDirectory()) collectSourceFiles(full, out);\n55\t    else out.push(full);\n56\t  }\n57\t  return out;\n58\t}\n59\t\n60\tdescribe(\"TC-6.1: deletion proof — SDK-only public API, no binary (AC-6.1, AC-6.2)\", () => {\n61\t  it(\"the package entry's export-name set equals the checked-in SDK-only list\", () => {\n62\t    expect(Object.keys(api).sort()).toEqual(SDK_ONLY_EXPORTS);\n63\t  });\n64\t\n65\t  it(\"the CLI-only entries are gone from the surface\", () => {\n66\t    const names = new Set(Object.keys(api));\n67\t    expect(names.has(\"resolveNamedProvider\")).toBe(false);\n68\t    expect(names.has(\"registeredProviderNames\")).toBe(false);\n69\t    expect(names.has(\"runCli\")).toBe(false);\n70\t  });\n71\t\n72\t  it(\"the package manifest publishes no binary and no CLI script\", () => {\n73\t    const manifest = JSON.parse(readFileSync(path.join(pkgRoot, \"package.json\"), \"utf8\")) as {\n74\t      bin?: unknown;\n75\t      scripts?: Record<string, string>;\n76\t    };\n77\t    expect(manifest.bin).toBeUndefined();\n78\t    expect(manifest.scripts?.[\"dev:cli\"]).toBeUndefined();\n79\t    for (const command of Object.values(manifest.scripts ?? {})) {\n80\t      expect(command).not.toContain(\"LHC_PROCESS_SUITE\");\n81\t    }\n82\t  });\n83\t\n84\t  it(\"the CLI surface, registry module, and spawned-process suites are deleted\", () => {\n85\t    expect(existsSync(path.join(pkgRoot, \"src\", \"cli\"))).toBe(false);\n86\t    expect(existsSync(path.join(pkgRoot, \"src\", \"cli.ts\"))).toBe(false);\n87\t    expect(existsSync(path.join(pkgRoot, \"src\", \"providers\", \"registry.ts\"))).toBe(false);\n88\t    const processSuites = readdirSync(path.join(pkgRoot, \"test\")).filter((name) =>\n89\t      name.startsWith(\"cli-process\"),\n90\t    );\n91\t    expect(processSuites).toEqual([]);\n92\t  });\n93\t});\n94\t\n95\tdescribe(\"TC-6.2: the env/flag provider-resolution path is gone (AC-6.3)\", () => {\n96\t  const envKey = [\"LHC\", \"PROVIDER\"].join(\"_\"); // composed so the scan below stays meaningful\n97\t  const flag = \"--\" + \"provider\";\n98\t\n99\t  it(\"zero LHC_PROVIDER / --provider references under src/\", () => {\n100\t    const hits: string[] = [];"}]},"parent_tool_use_id":null,"session_id":"8a1de899-4d5a-4e8b-9eb8-54d1998ea0a6","uuid":"20b52582-62e3-47c4-a8c6-e40371118d12","timestamp":"2026-06-14T13:56:09.488Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/retirement.test.ts","content":"// Epic 05 Story 1 (Flow 6): CLI retirement proof — TC-6.1, TC-6.2.\n// The package publishes an SDK-only surface: no binary, no named-provider\n// registry, no env/flag provider resolution. Deletion is proven three ways:\n// an export-name snapshot of the package entry (catches both leftover\n// CLI-only exports and accidental removals), a manifest check, and a\n// source-level scan for the retired resolution vocabulary. Provider arrival\n// is injection at createSdk only.\nimport { existsSync, readdirSync, readFileSync, statSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport * as api from \"../src/index.js\";\nimport { createSdk, type SdkConfig } from \"../src/index.js\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\n// The checked-in SDK-only surface (AC-6.1). A diff here is an intentional\n// public-API change: update the list in the same change that alters the\n// exports, never to quiet the test.\nconst SDK_ONLY_EXPORTS = [\n  \"BUILT_IN_PROFILES\",\n  \"DEFAULT_COMPACT_THRESHOLD\",\n  \"DEFAULT_PROMPT_NAMES\",\n  \"DEFAULT_VISIBILITY\",\n  \"PROMPT_NAMES\",\n  \"TOKEN_ESTIMATOR_ID\",\n  \"WORK_KIND_REGISTRY\",\n  \"assembleWorkHandlerMap\",\n  \"countLiveItems\",\n  \"createDeterministicProvider\",\n  \"createSdk\",\n  \"deterministicOutcomesSuffix\",\n  \"deterministicReceiptsSuffix\",\n  \"deterministicText\",\n  \"enqueue\",\n  \"estimateTokens\",\n  \"inspect\",\n  \"intakeStream\",\n  \"lookupWorkHandler\",\n  \"messages\",\n  \"queueDetail\",\n  \"runInTransaction\",\n  \"setSchedulerPoke\",\n  \"setThreadTouch\",\n  \"supersedeQueued\",\n  \"threadView\",\n  \"threads\",\n  \"turns\",\n];\n\nfunction collectSourceFiles(dir: string, out: string[] = []): string[] {\n  for (const entry of readdirSync(dir)) {\n    const full = path.join(dir, entry);\n    if (statSync(full).isDirectory()) collectSourceFiles(full, out);\n    else out.push(full);\n  }\n  return out;\n}\n\ndescribe(\"TC-6.1: deletion proof — SDK-only public API, no binary (AC-6.1, AC-6.2)\", () => {\n  it(\"the package entry's export-name set equals the checked-in SDK-only list\", () => {\n    expect(Object.keys(api).sort()).toEqual(SDK_ONLY_EXPORTS);\n  });\n\n  it(\"the CLI-only entries are gone from the surface\", () => {\n    const names = new Set(Object.keys(api));\n    expect(names.has(\"resolveNamedProvider\")).toBe(false);\n    expect(names.has(\"registeredProviderNames\")).toBe(false);\n    expect(names.has(\"runCli\")).toBe(false);\n  });\n\n  it(\"the package manifest publishes no binary and no CLI script\", () => {\n    const manifest = JSON.parse(readFileSync(path.join(pkgRoot, \"package.json\"), \"utf8\")) as {\n      bin?: unknown;\n      scripts?: Record<string, string>;\n    };\n    expect(manifest.bin).toBeUndefined();\n    expect(manifest.scripts?.[\"dev:cli\"]).toBeUndefined();\n    for (const command of Object.values(manifest.scripts ?? {})) {\n      expect(command).not.toContain(\"LHC_PROCESS_SUITE\");\n    }\n  });\n\n  it(\"the CLI surface, registry module, and spawned-process suites are deleted\", () => {\n    expect(existsSync(path.join(pkgRoot, \"src\", \"cli\"))).toBe(false);\n    expect(existsSync(path.join(pkgRoot, \"src\", \"cli.ts\"))).toBe(false);\n    expect(existsSync(path.join(pkgRoot, \"src\", \"providers\", \"registry.ts\"))).toBe(false);\n    const processSuites = readdirSync(path.join(pkgRoot, \"test\")).filter((name) =>\n      name.startsWith(\"cli-process\"),\n    );\n    expect(processSuites).toEqual([]);\n  });\n});\n\ndescribe(\"TC-6.2: the env/flag provider-resolution path is gone (AC-6.3)\", () => {\n  const envKey = [\"LHC\", \"PROVIDER\"].join(\"_\"); // composed so the scan below stays meaningful\n  const flag = \"--\" + \"provider\";\n\n  it(\"zero LHC_PROVIDER / --provider references under src/\", () => {\n    const hits: string[] = [];","numLines":100,"startLine":1,"totalLines":126}}}

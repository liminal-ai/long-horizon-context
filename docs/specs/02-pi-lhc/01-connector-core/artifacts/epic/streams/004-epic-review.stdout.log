{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6ef438cfbdc14629bc028927","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  MessageEventInput,\n13\t  OpResult,\n14\t  SdkConfig,\n15\t  ThreadRef,\n16\t} from \"lhc\";\n17\timport type {\n18\t  ExtensionAPI,\n19\t  ExtensionContext,\n20\t  PiHookHandler,\n21\t  PiHookName,\n22\t} from \"./pi/types.js\";\n23\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n24\timport { createSessionState } from \"./lifecycle/state.js\";\n25\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n26\timport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\n27\timport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\n28\timport { report, validateReachable } from \"./inference/startup-validation.js\";\n29\timport {\n30\t  detectForkFromSessionTree,\n31\t  forkInfoFromHook,\n32\t  seedFork,\n33\t} from \"./lifecycle/fork.js\";\n34\timport {\n35\t  parseLaunchFlags,\n36\t  resolveReloadThread,\n37\t  resolveThread,\n38\t  type LaunchFlags,\n39\t  type ResolveDeps,\n40\t} from \"./lifecycle/thread-resolution.js\";\n41\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n42\timport { threads } from \"lhc\";\n43\timport { capture, captureGap } from \"./capture/converter.js\";\n44\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n45\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n46\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n47\timport type { LhcInstance } from \"./shared/instance.js\";\n48\t\n49\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n50\texport type { LhcInstance } from \"./shared/instance.js\";\n51\t\n52\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n53\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n54\t *  registers no handler for it (story Scope Out). */\n55\texport const EPIC_1_HOOKS = [\n56\t  \"session_start\",\n57\t  \"message_end\",\n58\t  \"turn_end\",\n59\t  \"agent_end\",\n60\t  \"model_select\",\n61\t  \"thinking_level_select\",\n62\t  \"session_before_fork\",\n63\t  \"session_before_switch\",\n64\t  \"session_shutdown\",\n65\t] as const satisfies readonly PiHookName[];\n66\t\n67\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n68\t\n69\t/** What the connector needs from the host to run a session. Every dependency\n70\t *  has a working production default; the overrides exist for test isolation\n71\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n72\t *  in the PI-auth-backed inference config.\n73\t *\n74\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n75\t *  default is the observe-only config below (a real, construction-valid SDK);\n76\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n77\texport interface ConnectorDeps {\n78\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n79\t  registryPath?: string;\n80\t  newThreadFilePath?: () => string;\n81\t  parseLaunch?: () => LaunchFlags;\n82\t  selectThread?: (\n83\t    choices: readonly ThreadChoice[],\n84\t    ctx: ExtensionContext,\n85\t  ) => Promise<string | null>;\n86\t  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n87\t   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n88\t  assignmentConfig?: unknown;\n89\t}\n90\t\n91\t/** Everything the connector retains across hooks as PLAIN data — by\n92\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n93\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n94\t *  deliberately not part of the snapshot. */\n95\texport interface ConnectorSnapshot {\n96\t  state: SessionState | null;\n97\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n98\t}\n99\t\n100\texport interface Connector {\n101\t  /** Register the observe-only hook rail on the PI extension API. */\n102\t  register(pi: ExtensionAPI): void;\n103\t  /** The plain-data state retained across hooks. `null` until a session\n104\t   *  resolves a thread; never holds a PI ctx. */\n105\t  getState(): SessionState | null;\n106\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n107\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n108\t  getInstance(): LhcInstance | null;\n109\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n110\t  snapshot(): ConnectorSnapshot;\n111\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n112\t   *  synthetic ctx/events without a live PI. */\n113\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n114\t}\n115\t\n116\t/** The connector's live capture state for one session: the open-turn\n117\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n118\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n119\t *  per session, never part of the plain-data snapshot and never a PI object. */\n120\tinterface CaptureSession {\n121\t  piSessionId: string;\n122\t  accumulator: TurnAccumulator;\n123\t  sourceSeq: number;\n124\t}\n125\t\n126\t/** Fork state captured from `session_before_fork` and used on the next\n127\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n128\t *  only — no PI objects retained across the fork boundary. */\n129\tinterface PendingFork {\n130\t  sourceThreadRef: ThreadRef;\n131\t  forkEntryId: string;\n132\t}\n133\t\n134\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n135\t *  identity, which survives reload/replay (the same thread re-resolves to the\n136\t *  same id). */\n137\tfunction sessionIdOf(ref: ThreadRef): string {\n138\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n139\t}\n140\t\n141\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n142\t\n143\t/** The production SDK config for Story 5+: injects the host ModelCall function\n144\t *  that resolves provider/model through PI's registry and completes through\n145\t *  pi-ai when available. Story 6 loads assignments from config with shipped\n146\t *  defaults. */\n147\tfunction defaultBuildSdkConfig(\n148\t  ctx: ExtensionContext,\n149\t  assignmentConfig: unknown = undefined,\n150\t): OpResult<SdkConfig> {\n151\t  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n152\t  const assignments = loadAssignmentsImpl(assignmentConfig);\n153\t\n154\t  return {\n155\t    ok: true,\n156\t    value: {\n157\t      inference: {\n158\t        call: createModelCall(ctx),\n159\t        assignments,\n160\t      },\n161\t      mode: \"background\",\n162\t    },\n163\t  };\n164\t}\n165\t\n166\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n167\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n168\t *  show. */\n169\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n170\t  const lines = choices.map((choice, i) => {\n171\t    const title = choice.title ?? \"(untitled)\";\n172\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n173\t  });\n174\t  return [\n175\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n176\t    ...lines,\n177\t    choices.length === 1\n178\t      ? \"One candidate found; resuming it.\"\n179\t      : \"Multiple candidates found; relaunch with --session <id> to choose one explicitly.\",\n180\t  ].join(\"\\n\");\n181\t}\n182\t\n183\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n184\t *  interactive input/selection surface (wiring research), so the production\n185\t *  picker presents the cwd-scoped candidate list — title + creation time — to the\n186\t *  operator through `ctx.ui.notify` when a UI is present and only auto-resolves\n187\t *  the single unambiguous candidate. Multiple candidates fail closed with\n188\t *  `null`, directing the operator to relaunch with `--session <id>`; this avoids\n189\t *  silently attaching capture to the wrong thread. The picker itself stays\n190\t *  cwd-scoped, titled, and selection-injectable (`pickThread` takes the `select`\n191\t *  seam); tests drive an explicit operator choice through it. */\n192\tfunction defaultSelectThread(\n193\t  choices: readonly ThreadChoice[],\n194\t  ctx: ExtensionContext,\n195\t): Promise<string | null> {\n196\t  if (ctx.hasUI) {\n197\t    ctx.ui.notify(renderResumeCandidates(choices), { level: choices.length === 1 ? \"info\" : \"warn\" });\n198\t  }\n199\t  return Promise.resolve(choices.length === 1 ? choices[0]?.threadId ?? null : null);\n200\t}\n201\t\n202\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n203\t *  generated by the registry at creation, so the file name is just a unique\n204\t *  handle; the directory is ensured up front (DatabaseSync does not create\n205\t *  parents). */\n206\tfunction defaultNewThreadFilePath(): string {\n207\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n208\t  mkdirSync(dir, { recursive: true });\n209\t  return join(dir, `${randomUUID()}.sqlite`);\n210\t}\n211\t\n212\t/** Build a connector instance. Its mutable state lives in this closure; the\n213\t *  registered handlers capture it, so the instance stays live for the session\n214\t *  even when `activate` discards the returned object. The connector holds NO\n215\t *  module-level or durable state of its own — reload reconstructs the thread from\n216\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n217\t *  closure reattaches correctly (AC-1.5). */\n218\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n219\t  // The connector's retained state. `state` is plain data (the durable thread\n220\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n221\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n222\t  // none survives the connector — reload re-resolves from the registry.\n223\t  let state: SessionState | null = null;\n224\t  let instance: LhcInstance | null = null;\n225\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n226\t  let captureSession: CaptureSession | null = null;\n227\t  let pendingFork: PendingFork | null = null;\n228\t\n229\t  // Build SDK config with assignment config if provided (Story 6)\n230\t  const buildSdkConfig = deps.buildSdkConfig ??\n231\t    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n232\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n233\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n234\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n235\t\n236\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n237\t    return { code, message, recordedGap: false };\n238\t  }\n239\t\n240\t  // The registry/file deps every resolver path shares. `registryPath` is set\n241\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n242\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n243\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n244\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n245\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n246\t    return resolveDeps;\n247\t  }\n248\t\n249\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n250\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n251\t  // no-flag creates).\n252\t  async function resolveForLaunch(\n253\t    launch: LaunchFlags,\n254\t    ctx: ExtensionContext,\n255\t  ): Promise<OpResult<ThreadRef | null>> {\n256\t    if (launch.resume === true) {\n257\t      const pickerDeps: {\n258\t        registryPath?: string;\n259\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n260\t      } = { select: (choices) => selectThread(choices, ctx) };\n261\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n262\t      return pickThread(ctx.cwd, pickerDeps);\n263\t    }\n264\t    return resolveThread(launch, buildResolveDeps(ctx));\n265\t  }\n266\t\n267\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n268\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n269\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n270\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n271\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n272\t  async function resolveReloadFor(\n273\t    launch: LaunchFlags,\n274\t    ctx: ExtensionContext,\n275\t  ): Promise<OpResult<ThreadRef | null>> {\n276\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n277\t  }\n278\t\n279\t  // session_start: resolve the recording thread and construct one background\n280\t  // instance against it. Config is gated first so a session with no usable\n281\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n282\t  // thread is re-resolved from the durable registry (reattach, never create);\n283\t  // every other reason runs the normal launch resolution. Fork creates a new\n284\t  // thread and seeds it from the source thread (Story 4).\n285\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n286\t    const config = buildSdkConfig(ctx);\n287\t    if (!config.ok) {\n288\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n289\t      return;\n290\t    }\n291\t\n292\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n293\t    let forkAttempted = false;\n294\t\n295\t    // Fork path (Story 4): create a new thread and seed it from the source.\n296\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n297\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n298\t    if (pendingFork !== null) {\n299\t      forkAttempted = true;\n300\t      // Hook-based fork detection: session_before_fork fired.\n301\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n302\t\n303\t      // Create a new thread for the fork.\n304\t      const resolveDeps = buildResolveDeps(ctx);\n305\t      const newFilePath = resolveDeps.newThreadFilePath();\n306\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n307\t        filePath: newFilePath,\n308\t        cwd: resolveDeps.cwd,\n309\t      };\n310\t      if (resolveDeps.registryPath !== undefined) {\n311\t        newThreadInput.registryPath = resolveDeps.registryPath;\n312\t      }\n313\t      const created = await threads.newThread(newThreadInput);\n314\t      if (!created.ok) {\n315\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n316\t        pendingFork = null;\n317\t        state = null;\n318\t        captureSession = null;\n319\t        return;\n320\t      } else {\n321\t        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n322\t\n323\t        // Initialize the instance against the target thread first (required for seedFork).\n324\t        const built = await initInstance(targetThreadRef, config.value);\n325\t        if (!built.ok) {\n326\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n327\t          pendingFork = null;\n328\t          state = null;\n329\t          captureSession = null;\n330\t          return;\n331\t        } else {\n332\t          instance = built.value;\n333\t\n334\t          // Seed the fork by replaying source events up to the fork point.\n335\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n336\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n337\t          if (!seeded.ok) {\n338\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n339\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n340\t            pendingFork = null;\n341\t            await disposeInstance(instance);\n342\t            instance = null;\n343\t            state = null;\n344\t            captureSession = null;\n345\t            return;\n346\t          } else {\n347\t            // Fork succeeded - clear pending fork state and use the forked thread.\n348\t            pendingFork = null;\n349\t            resolved = { ok: true, value: targetThreadRef };\n350\t          }\n351\t        }\n352\t      }\n353\t    }\n354\t\n355\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n356\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n357\t    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n358\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n359\t      if (forkFromTree !== null) {\n360\t        forkAttempted = true;\n361\t        // Session tree indicates a fork - create and seed as above.\n362\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n363\t\n364\t        const resolveDeps = buildResolveDeps(ctx);\n365\t        const newFilePath = resolveDeps.newThreadFilePath();\n366\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n367\t          filePath: newFilePath,\n368\t          cwd: resolveDeps.cwd,\n369\t        };\n370\t        if (resolveDeps.registryPath !== undefined) {\n371\t          newThreadInput.registryPath = resolveDeps.registryPath;\n372\t        }\n373\t        const created = await threads.newThread(newThreadInput);\n374\t        if (!created.ok) {\n375\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n376\t          state = null;\n377\t          captureSession = null;\n378\t          return;\n379\t        } else {\n380\t          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n381\t\n382\t          const built = await initInstance(targetThreadRef, config.value);\n383\t          if (!built.ok) {\n384\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n385\t            state = null;\n386\t            captureSession = null;\n387\t            return;\n388\t          } else {\n389\t            instance = built.value;\n390\t\n391\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n392\t            if (!seeded.ok) {\n393\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n394\t              await disposeInstance(instance);\n395\t              instance = null;\n396\t              state = null;\n397\t              captureSession = null;\n398\t              return;\n399\t            } else {\n400\t              resolved = { ok: true, value: targetThreadRef };\n401\t            }\n402\t          }\n403\t        }\n404\t      }\n405\t    }\n406\t\n407\t    // Normal launch resolution (if not resolved by fork paths above).\n408\t    if (resolved === undefined) {\n409\t      const launch = parseLaunch();\n410\t      const isReload = event.reason === \"reload\";\n411\t      resolved = isReload\n412\t        ? await resolveReloadFor(launch, ctx)\n413\t        : await resolveForLaunch(launch, ctx);\n414\t    }\n415\t\n416\t    if (!resolved.ok) {\n417\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n418\t      return;\n419\t    }\n420\t    if (resolved.value === null) {\n421\t      const isReload = event.reason === \"reload\";\n422\t      lastDiagnostic = isReload\n423\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n424\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n425\t      return;\n426\t    }\n427\t\n428\t    // If instance wasn't created during fork path, create it now.\n429\t    if (instance === null) {\n430\t      const built = await initInstance(resolved.value, config.value);\n431\t      if (!built.ok) {\n432\t        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n433\t        return;\n434\t      }\n435\t      instance = built.value;\n436\t    }\n437\t\n438\t    state = createSessionState(resolved.value);\n439\t    const piSessionId = sessionIdOf(resolved.value);\n440\t    captureSession = {\n441\t      piSessionId,\n442\t      accumulator: new TurnAccumulator({ piSessionId }),\n443\t      sourceSeq: 0,\n444\t    };\n445\t\n446\t    // Story 6: Startup validation - probe all seven assignments before first use\n447\t    // This runs after instance creation but before capture begins (AC-5.1).\n448\t    // Validation failures are reported but do NOT stop capture (AC-5.3).\n449\t    if (config.value.inference === undefined) {\n450\t      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n451\t      return;\n452\t    }\n453\t    const assignments = config.value.inference.assignments;\n454\t    const validationReport = validateReachable(assignments, ctx);\n455\t    report(validationReport, ctx, state);\n456\t  };\n457\t\n458\t  // Dispose with flush before any session swap (session_before_switch fires\n459\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n460\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n461\t  // re-resolves its thread from the durable registry on the next session_start.\n462\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n463\t    const result = await disposeInstance(instance);\n464\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n465\t    instance = null;\n466\t    captureSession = null;\n467\t  };\n468\t\n469\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n470\t  // converter already recorded a durable gap for a writable-thread malformed\n471\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n472\t  // surfaces as an extension health signal with no gap. Neither path throws.\n473\t  function recordCaptureOutcome(\n474\t    result: OpResult<BatchResult>,\n475\t    events: readonly MessageEventInput[],\n476\t  ): void {\n477\t    if (result.ok) return;\n478\t    const recordedGap = result.error.code === \"invalid_event\";\n479\t    const failure: CaptureFailureDiagnostic = {\n480\t      code: result.error.code,\n481\t      message: result.error.reason,\n482\t      recordedGap,\n483\t    };\n484\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n485\t    lastDiagnostic = failure;\n486\t    if (state !== null) state.health.lastCaptureFailure = failure;\n487\t  }\n488\t\n489\t  function nextSourceSeq(session: CaptureSession): number {\n490\t    const sourceSeq = session.sourceSeq;\n491\t    session.sourceSeq += 1;\n492\t    return sourceSeq;\n493\t  }\n494\t\n495\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n496\t    // Last-resort id-less discriminator. PI position wins when present; the\n497\t    // connector ordinal is used only when PI gives no event identity at all.\n498\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n499\t    // order yields the same ordinal, which is the best identity available.\n500\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n501\t  }\n502\t\n503\t  async function recordMappingFailure(\n504\t    hook: string,\n505\t    position: number | undefined,\n506\t    sourceSeq: number,\n507\t    cause: unknown,\n508\t  ): Promise<void> {\n509\t    if (instance === null) return;\n510\t    const message = cause instanceof Error ? cause.message : String(cause);\n511\t    const result = await captureGap(\n512\t      fallbackIdFor(hook, position, sourceSeq),\n513\t      `${hook}: ${message}`,\n514\t      instance,\n515\t    );\n516\t    if (!result.ok) {\n517\t      recordCaptureOutcome(result, []);\n518\t      return;\n519\t    }\n520\t    const failure: CaptureFailureDiagnostic = {\n521\t      code: \"invalid_event\",\n522\t      message: `${hook}: ${message}`,\n523\t      recordedGap: true,\n524\t    };\n525\t    lastDiagnostic = failure;\n526\t    if (state !== null) state.health.lastCaptureFailure = failure;\n527\t  }\n528\t\n529\t  // message_end: map the finalized PI message to ordered LHC events, track the\n530\t  // open turn, and flush through the converter (AC-2.1).\n531\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n532\t    if (instance === null || captureSession === null) return;\n533\t    const sourceSeq = nextSourceSeq(captureSession);\n534\t    const mapCtx: MapCtx =\n535\t      event.entryId !== undefined && event.entryId !== \"\"\n536\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n537\t        : {\n538\t            piSessionId: captureSession.piSessionId,\n539\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n540\t          };\n541\t    let events: MessageEventInput[];\n542\t    try {\n543\t      events = mapMessage(event.message, mapCtx);\n544\t    } catch (cause) {\n545\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n546\t      return;\n547\t    }\n548\t    captureSession.accumulator.onMessage(events);\n549\t    if (events.length === 0) return;\n550\t    recordCaptureOutcome(await capture(events, instance), events);\n551\t  };\n552\t\n553\t  // model_select / thinking_level_select fire only in-stream — capture each as\n554\t  // an ordered runtime_note the moment it fires (AC-2.8).\n555\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n556\t    if (instance === null || captureSession === null) return;\n557\t    const sourceSeq = nextSourceSeq(captureSession);\n558\t    const mapCtx: MapCtx = {\n559\t      piSessionId: captureSession.piSessionId,\n560\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n561\t    };\n562\t    const note = mapModelSelect(event, mapCtx);\n563\t    recordCaptureOutcome(await capture([note], instance), [note]);\n564\t  };\n565\t\n566\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n567\t    if (instance === null || captureSession === null) return;\n568\t    const sourceSeq = nextSourceSeq(captureSession);\n569\t    const mapCtx: MapCtx = {\n570\t      piSessionId: captureSession.piSessionId,\n571\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n572\t    };\n573\t    const note = mapThinkingLevelSelect(event, mapCtx);\n574\t    recordCaptureOutcome(await capture([note], instance), [note]);\n575\t  };\n576\t\n577\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n578\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n579\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n580\t    if (instance === null || captureSession === null) return;\n581\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n582\t    if (turnEnd.length === 0) return;\n583\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n584\t  };\n585\t\n586\t  // Contain every handler: an observe-only hook must never throw back into PI\n587\t  // (a thrown hook breaks the user's session). A caught error becomes a\n588\t  // plain-data diagnostic; it is never rethrown.\n589\t  const guard = (\n590\t    name: Epic1Hook,\n591\t    body: PiHookHandler<Epic1Hook>,\n592\t  ): PiHookHandler<Epic1Hook> => {\n593\t    return async (ctx, event): Promise<void> => {\n594\t      try {\n595\t        await body(ctx, event);\n596\t      } catch (err) {\n597\t        lastDiagnostic = {\n598\t          code: \"hook_handler_error\",\n599\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n600\t          recordedGap: false,\n601\t        };\n602\t      }\n603\t    };\n604\t  };\n605\t\n606\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n607\t  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n608\t  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n609\t  const noop: PiHookHandler<Epic1Hook> = () => {\n610\t    // Intentionally empty — turn_end is ignored as a boundary.\n611\t  };\n612\t\n613\t  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n614\t  // The source thread ref is captured from the current session state; the hook\n615\t  // provides entryId/position identifying the fork point. No writes to the source\n616\t  // thread occur — the fork happens on the next session_start (Story 4).\n617\t  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n618\t    if (state === null) return;\n619\t    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n620\t    // Store the fork info for use on session_start{fork}.\n621\t    pendingFork = {\n622\t      sourceThreadRef: state.threadRef,\n623\t      forkEntryId: forkInfo.forkEntryId,\n624\t    };\n625\t  };\n626\t\n627\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n628\t  // are live; fork handling (Story 4) is wired.\n629\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n630\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n631\t    session_before_switch: onDispose,\n632\t    session_shutdown: onDispose,\n633\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n634\t    turn_end: noop,\n635\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n636\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n637\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n638\t    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n639\t  };\n640\t\n641\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n642\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n643\t\n644\t  return {\n645\t    handlers,\n646\t    register(pi: ExtensionAPI): void {\n647\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n648\t    },\n649\t    getState(): SessionState | null {\n650\t      return state;\n651\t    },\n652\t    getInstance(): LhcInstance | null {\n653\t      return instance;\n654\t    },\n655\t    snapshot(): ConnectorSnapshot {\n656\t      return { state, lastDiagnostic };\n657\t    },\n658\t  };\n659\t}\n660\t\n661\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n662\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n663\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n664\t *  observe-only SDK config, and the `--resume` selector that presents the\n665\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n666\t *  resolves/creates and initializes for real. On `/reload` the connector\n667\t *  re-resolves the same thread from the durable registry (it keeps no\n668\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n669\t *  config. */\n670\texport function activate(pi: ExtensionAPI): void {\n671\t  createConnector().register(pi);\n672\t}\n673\t\n674\texport default activate;\n675\t"}]},"parent_tool_use_id":null,"session_id":"d8b1b04c-6358-4278-8fe4-779266fa40d8","uuid":"9946f29c-45c0-48ec-8d4b-03a5aea7c38a","timestamp":"2026-06-14T13:53:40.493Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  MessageEventInput,\n  OpResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\nimport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\nimport { report, validateReachable } from \"./inference/startup-validation.js\";\nimport {\n  detectForkFromSessionTree,\n  forkInfoFromHook,\n  seedFork,\n} from \"./lifecycle/fork.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { threads } from \"lhc\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n  assignmentConfig?: unknown;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** Fork state captured from `session_before_fork` and used on the next\n *  `session_start{fork}` to create and seed the forked thread. Plain data\n *  only — no PI objects retained across the fork boundary. */\ninterface PendingFork {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production SDK config for Story 5+: injects the host ModelCall function\n *  that resolves provider/model through PI's registry and completes through\n *  pi-ai when available. Story 6 loads assignments from config with shipped\n *  defaults. */\nfunction defaultBuildSdkConfig(\n  ctx: ExtensionContext,\n  assignmentConfig: unknown = undefined,\n): OpResult<SdkConfig> {\n  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n  const assignments = loadAssignmentsImpl(assignmentConfig);\n\n  return {\n    ok: true,\n    value: {\n      inference: {\n        call: createModelCall(ctx),\n        assignments,\n      },\n      mode: \"background\",\n    },\n  };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    choices.length === 1\n      ? \"One candidate found; resuming it.\"\n      : \"Multiple candidates found; relaunch with --session <id> to choose one explicitly.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker presents the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present and only auto-resolves\n *  the single unambiguous candidate. Multiple candidates fail closed with\n *  `null`, directing the operator to relaunch with `--session <id>`; this avoids\n *  silently attaching capture to the wrong thread. The picker itself stays\n *  cwd-scoped, titled, and selection-injectable (`pickThread` takes the `select`\n *  seam); tests drive an explicit operator choice through it. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: choices.length === 1 ? \"info\" : \"warn\" });\n  }\n  return Promise.resolve(choices.length === 1 ? choices[0]?.threadId ?? null : null);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n  let pendingFork: PendingFork | null = null;\n\n  // Build SDK config with assignment config if provided (Story 6)\n  const buildSdkConfig = deps.buildSdkConfig ??\n    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        state = null;\n        captureSession = null;\n        return;\n      } else {\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            await disposeInstance(instance);\n            instance = null;\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        forkAttempted = true;\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              await disposeInstance(instance);\n              instance = null;\n              state = null;\n              captureSession = null;\n              return;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";\n      resolved = isReload\n        ? await resolveReloadFor(launch, ctx)\n        : await resolveForLaunch(launch, ctx);\n    }\n\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      const isReload = event.reason === \"reload\";\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n\n    // If instance wasn't created during fork path, create it now.\n    if (instance === null) {\n      const built = await initInstance(resolved.value, config.value);\n      if (!built.ok) {\n        lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n        return;\n      }\n      instance = built.value;\n    }\n\n    state = createSessionState(resolved.value);\n    const piSessionId = sessionIdOf(resolved.value);\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId }),\n      sourceSeq: 0,\n    };\n\n    // Story 6: Startup validation - probe all seven assignments before first use\n    // This runs after instance creation but before capture begins (AC-5.1).\n    // Validation failures are reported but do NOT stop capture (AC-5.3).\n    if (config.value.inference === undefined) {\n      lastDiagnostic = diag(\"inference_config_missing\", \"SDK config missing inference block\");\n      return;\n    }\n    const assignments = config.value.inference.assignments;\n    const validationReport = validateReachable(assignments, ctx);\n    report(validationReport, ctx, state);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  function nextSourceSeq(session: CaptureSession): number {\n    const sourceSeq = session.sourceSeq;\n    session.sourceSeq += 1;\n    return sourceSeq;\n  }\n\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n    // Last-resort id-less discriminator. PI position wins when present; the\n    // connector ordinal is used only when PI gives no event identity at all.\n    // For id-less + position-less reload replay, PI's deterministic redelivery\n    // order yields the same ordinal, which is the best identity available.\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n  }\n\n  async function recordMappingFailure(\n    hook: string,\n    position: number | undefined,\n    sourceSeq: number,\n    cause: unknown,\n  ): Promise<void> {\n    if (instance === null) return;\n    const message = cause instanceof Error ? cause.message : String(cause);\n    const result = await captureGap(\n      fallbackIdFor(hook, position, sourceSeq),\n      `${hook}: ${message}`,\n      instance,\n    );\n    if (!result.ok) {\n      recordCaptureOutcome(result, []);\n      return;\n    }\n    const failure: CaptureFailureDiagnostic = {\n      code: \"invalid_event\",\n      message: `${hook}: ${message}`,\n      recordedGap: true,\n    };\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  // message_end: map the finalized PI message to ordered LHC events, track the\n  // open turn, and flush through the converter (AC-2.1).\n  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx =\n      event.entryId !== undefined && event.entryId !== \"\"\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n        : {\n            piSessionId: captureSession.piSessionId,\n            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n          };\n    let events: MessageEventInput[];\n    try {\n      events = mapMessage(event.message, mapCtx);\n    } catch (cause) {\n      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n      return;\n    }\n    captureSession.accumulator.onMessage(events);\n    if (events.length === 0) return;\n    recordCaptureOutcome(await capture(events, instance), events);\n  };\n\n  // model_select / thinking_level_select fire only in-stream — capture each as\n  // an ordered runtime_note the moment it fires (AC-2.8).\n  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n    };\n    const note = mapModelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const sourceSeq = nextSourceSeq(captureSession);\n    const mapCtx: MapCtx = {\n      piSessionId: captureSession.piSessionId,\n      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n    };\n    const note = mapThinkingLevelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n    if (instance === null || captureSession === null) return;\n    const turnEnd = captureSession.accumulator.onAgentEnd();\n    if (turnEnd.length === 0) return;\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — turn_end is ignored as a boundary.\n  };\n\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\n  // The source thread ref is captured from the current session state; the hook\n  // provides entryId/position identifying the fork point. No writes to the source\n  // thread occur — the fork happens on the next session_start (Story 4).\n  const onBeforeFork: PiHookHandler<\"session_before_fork\"> = async (_ctx, event) => {\n    if (state === null) return;\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\n    // Store the fork info for use on session_start{fork}.\n    pendingFork = {\n      sourceThreadRef: state.threadRef,\n      forkEntryId: forkInfo.forkEntryId,\n    };\n  };\n\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n  // are live; fork handling (Story 4) is wired.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n    turn_end: noop,\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from the durable registry (it keeps no\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n *  config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":675,"startLine":1,"totalLines":675}}}

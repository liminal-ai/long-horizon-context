ges/pi-lhc/src/index.ts:189: *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\npackages/pi-lhc/src/index.ts:214: *  registered handlers capture it, so the instance stays live for the session\npackages/pi-lhc/src/index.ts:251:  // `--session` / `--continue` / no-flag go through the registry resolver (only\npackages/pi-lhc/src/index.ts:269:  // session continues, so re-resolve the SAME thread from the DURABLE registry\npackages/pi-lhc/src/index.ts:280:  // session_start: resolve the recording thread and construct one background\npackages/pi-lhc/src/index.ts:281:  // instance against it. Config is gated first so a session with no usable\npackages/pi-lhc/src/index.ts:286:  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\npackages/pi-lhc/src/index.ts:297:    // Detection relies on pendingFork from session_before_fork hook, with PI's\npackages/pi-lhc/src/index.ts:298:    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\npackages/pi-lhc/src/index.ts:301:      // Hook-based fork detection: session_before_fork fired.\npackages/pi-lhc/src/index.ts:356:    // Epic 1 fallback: PI session-tree evidence when hook was absent.\npackages/pi-lhc/src/index.ts:357:    // If pendingFork is null but we have a previous session, detect fork from session tree.\npackages/pi-lhc/src/index.ts:440:    const piSessionId = sessionIdOf(resolved.value);\npackages/pi-lhc/src/index.ts:459:  // Dispose with flush before any session swap (session_before_switch fires\npackages/pi-lhc/src/index.ts:462:  // re-resolves its thread from the durable registry on the next session_start.\npackages/pi-lhc/src/index.ts:490:  function nextSourceSeq(session: CaptureSession): number {\npackages/pi-lhc/src/index.ts:491:    const sourceSeq = session.sourceSeq;\npackages/pi-lhc/src/index.ts:492:    session.sourceSeq += 1;\npackages/pi-lhc/src/index.ts:555:  // an ordered runtime_note the moment it fires (AC-2.8).\npackages/pi-l
{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/lifecycle/thread-resolution.test.ts | sed -n '245,370p'\"","aggregated_output":"   245\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"startup\"));\n   246\t\n   247\t    const state = connector.getState();\n   248\t    expect(state).not.toBeNull();\n   249\t    if (state === null) return;\n   250\t    expect(idOf(state.threadRef)).toBe(existingId);\n   251\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n   252\t    expect(await threadCount()).toBe(before); // no second thread\n   253\t  });\n   254\t\n   255\t  it(\"TC-1.7: production --resume presents the cwd-scoped titled candidates via ctx.ui.notify and resolves a selection\", async () => {\n   256\t    await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n   257\t    const recent = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n   258\t    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n   259\t    const before = await threadCount();\n   260\t\n   261\t    // A ctx WITH a UI captures exactly what the picker presents to the operator.\n   262\t    const notes: string[] = [];\n   263\t    const ctx: ExtensionContext = {\n   264\t      cwd: \"/work/resume\",\n   265\t      hasUI: true,\n   266\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n   267\t      ui: { notify: (message) => notes.push(message) },\n   268\t      sessionManager: { getEntries: () => [] },\n   269\t    };\n   270\t\n   271\t    const connector = productionConnector(() => ({ resume: true }));\n   272\t    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n   273\t\n   274\t    // The operator was shown the cwd-scoped candidate list — only this cwd's\n   275\t    // threads, each with title and creation time — through ctx.ui.notify (the\n   276\t    // only PI v0.79.2 surface; selection resolves to the best available default).\n   277\t    const shown = notes.find((note) => note.includes(\"pi-lhc --resume:\"));\n   278\t    expect(shown).toBeDefined();\n   279\t    if (shown === undefined) return;\n   280\t    expect(shown).toContain(\"older\");\n   281\t    expect(shown).toContain(\"newer\");\n   282\t    expect(shown).not.toContain(\"different cwd\"); // a different cwd is not offered\n   283\t    const recentRow = await threads.resolve({ threadId: recent, registryPath: store.registryPath });\n   284\t    if (recentRow.ok) expect(shown).toContain(recentRow.value.createdAt); // creation time shown\n   285\t\n   286\t    const state = connector.getState();\n   287\t    expect(state).not.toBeNull();\n   288\t    if (state === null) return;\n   289\t    expect(idOf(state.threadRef)).toBe(recent); // best available explicit default selection\n   290\t    expect(connector.getInstance()).not.toBeNull();\n   291\t    expect(await threadCount()).toBe(before); // resumed, not created\n   292\t  });\n   293\t\n   294\t  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n   295\t    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n   296\t    const before = await threadCount();\n   297\t\n   298\t    const connector = productionConnector(() => ({ resume: true }));\n   299\t    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n   300\t    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n   301\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n   302\t\n   303\t    const state = connector.getState();\n   304\t    expect(state).not.toBeNull();\n   305\t    if (state === null) return;\n   306\t    expect(connector.getInstance()).not.toBeNull();\n   307\t    expect(await threadCount()).toBe(before); // resolved without failing\n   308\t  });\n   309\t});\n   310\t\n   311\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n   312\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n   313\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n   314\t\n   315\t    // session_start with a ctx carrying methods.\n   316\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n   317\t    expect(connector.getState()).not.toBeNull();\n   318\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n   319\t    // ...but the snapshot is plain data only — it survives structuredClone even\n   320\t    // though the live ctx and instance carry methods (they are not in it).\n   321\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   322\t    const threadRefBefore = connector.getState()?.threadRef;\n   323\t\n   324\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n   325\t    // holder still references no prior ctx.\n   326\t    await connector.handlers.message_end(\n   327\t      syntheticCtx(\"/work/a\"),\n   328\t      makeMessageEnd(makeUserMessage(\"hi\")),\n   329\t    );\n   330\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   331\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n   332\t  });\n   333\t});\n   334\t\n   335\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n   336\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n   337\t    const cwd = \"/work/reload\";\n   338\t\n   339\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n   340\t    const connectorA = productionConnector(() => ({}));\n   341\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   342\t    const stateA = connectorA.getState();\n   343\t    expect(stateA).not.toBeNull();\n   344\t    if (stateA === null) return;\n   345\t    const firstId = idOf(stateA.threadRef);\n   346\t    const countAfterNew = await threadCount();\n   347\t\n   348\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n   349\t    expect(row.ok).toBe(true);\n   350\t    if (row.ok) {\n   351\t      expect(row.value.cwd).toBe(cwd);\n   352\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n   353\t    }\n   354\t\n   355\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n   356\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n   357\t    // closure and a still-no-flag launch (which would otherwise create a\n   358\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n   359\t    // thing bridging the teardown is the durable registry — this is what proves\n   360\t    // reconstruction survives loss of every in-memory holder (SV-001).\n   361\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   362\t\n   363\t    const connectorB = productionConnector(() => ({}));\n   364\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   365\t\n   366\t    const stateB = connectorB.getState();\n   367\t    expect(stateB).not.toBeNull();\n   368\t    if (stateB === null) return;\n   369\t    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n   370\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_41669f68a8d04b31be0e40a2","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  MessageEventInput,\n13\t  OpResult,\n14\t  SdkConfig,\n15\t  ThreadRef,\n16\t} from \"lhc\";\n17\timport type {\n18\t  ExtensionAPI,\n19\t  ExtensionContext,\n20\t  PiHookHandler,\n21\t  PiHookName,\n22\t} from \"./pi/types.js\";\n23\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n24\timport { createSessionState } from \"./lifecycle/state.js\";\n25\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n26\timport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\n27\timport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\n28\timport { report, validateReachable } from \"./inference/startup-validation.js\";\n29\timport {\n30\t  detectForkFromSessionTree,\n31\t  forkInfoFromHook,\n32\t  seedFork,\n33\t} from \"./lifecycle/fork.js\";\n34\timport {\n35\t  parseLaunchFlags,\n36\t  resolveReloadThread,\n37\t  resolveThread,\n38\t  type LaunchFlags,\n39\t  type ResolveDeps,\n40\t} from \"./lifecycle/thread-resolution.js\";\n41\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n42\timport { threads } from \"lhc\";\n43\timport { capture, captureGap } from \"./capture/converter.js\";\n44\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n45\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n46\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n47\timport type { LhcInstance } from \"./shared/instance.js\";\n48\t\n49\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n50\texport type { LhcInstance } from \"./shared/instance.js\";\n51\t\n52\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n53\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n54\t *  registers no handler for it (story Scope Out). */\n55\texport const EPIC_1_HOOKS = [\n56\t  \"session_start\",\n57\t  \"message_end\",\n58\t  \"turn_end\",\n59\t  \"agent_end\",\n60\t  \"model_select\",\n61\t  \"thinking_level_select\",\n62\t  \"session_before_fork\",\n63\t  \"session_before_switch\",\n64\t  \"session_shutdown\",\n65\t] as const satisfies readonly PiHookName[];\n66\t\n67\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n68\t\n69\t/** What the connector needs from the host to run a session. Every dependency\n70\t *  has a working production default; the overrides exist for test isolation\n71\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n72\t *  in the PI-auth-backed inference config.\n73\t *\n74\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n75\t *  default is the observe-only config below (a real, construction-valid SDK);\n76\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n77\texport interface ConnectorDeps {\n78\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n79\t  registryPath?: string;\n80\t  newThreadFilePath?: () => string;\n81\t  parseLaunch?: () => LaunchFlags;\n82\t  selectThread?: (\n83\t    choices: readonly ThreadChoice[],\n84\t    ctx: ExtensionContext,\n85\t  ) => Promise<string | null>;\n86\t  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n87\t   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n88\t  assignmentConfig?: unknown;\n89\t}\n90\t\n91\t/** Everything the connector retains across hooks as PLAIN data — by\n92\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n93\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n94\t *  deliberately not part of the snapshot. */\n95\texport interface ConnectorSnapshot {\n96\t  state: SessionState | null;\n97\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n98\t}\n99\t\n100\texport interface Connector {\n101\t  /** Register the observe-only hook rail on the PI extension API. */\n102\t  register(pi: ExtensionAPI): void;\n103\t  /** The plain-data state retained across hooks. `null` until a session\n104\t   *  resolves a thread; never holds a PI ctx. */\n105\t  getState(): SessionState | null;\n106\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n107\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n108\t  getInstance(): LhcInstance | null;\n109\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n110\t  snapshot(): ConnectorSnapshot;\n111\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n112\t   *  synthetic ctx/events without a live PI. */\n113\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n114\t}\n115\t\n116\t/** The connector's live capture state for one session: the open-turn\n117\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n118\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n119\t *  per session, never part of the plain-data snapshot and never a PI object. */\n120\tinterface CaptureSession {\n121\t  piSessionId: string;\n122\t  accumulator: TurnAccumulator;\n123\t  sourceSeq: number;\n124\t}\n125\t\n126\t/** Fork state captured from `session_before_fork` and used on the next\n127\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n128\t *  only — no PI objects retained across the fork boundary. */\n129\tinterface PendingFork {\n130\t  sourceThreadRef: ThreadRef;\n131\t  forkEntryId: string;\n132\t}\n133\t\n134\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n135\t *  identity, which survives reload/replay (the same thread re-resolves to the\n136\t *  same id). */\n137\tfunction sessionIdOf(ref: ThreadRef): string {\n138\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n139\t}\n140\t\n141\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n142\t\n143\t/** The production SDK config for Story 5+: injects the host ModelCall function\n144\t *  that resolves provider/model through PI's registry and completes through\n145\t *  pi-ai when available. Story 6 loads assignments from config with shipped\n146\t *  defaults. */\n147\tfunction defaultBuildSdkConfig(\n148\t  ctx: ExtensionContext,\n149\t  assignmentConfig: unknown = undefined,\n150\t): OpResult<SdkConfig> {\n151\t  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n152\t  const assignments = loadAssignmentsImpl(assignmentConfig);\n153\t\n154\t  return {\n155\t    ok: true,\n156\t    value: {\n157\t      inference: {\n158\t        call: createModelCall(ctx),\n159\t        assignments,\n160\t      },\n161\t      mode: \"background\",\n162\t    },\n163\t  };\n164\t}\n165\t\n166\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n167\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n168\t *  show. */\n169\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n170\t  const lines = choices.map((choice, i) => {\n171\t    const title = choice.title ?? \"(untitled)\";\n172\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n173\t  });\n174\t  return [\n175\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n176\t    ...lines,\n177\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n178\t  ].join(\"\\n\");\n179\t}\n180\t\n181\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n182\t *  interactive input/selection surface (wiring research), so the production\n183\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n184\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n185\t *  most recently created thread as the best available explicit default. The\n186\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n187\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n188\t *  A true interactive picker awaits a PI input surface; until then resuming a\n189\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n190\t *  precise spec deviation. */\n191\tfunction defaultSelectThread(\n192\t  choices: readonly ThreadChoice[],\n193\t  ctx: ExtensionContext,\n194\t): Promise<string | null> {\n195\t  const mostRecent = choices.at(-1);\n196\t  if (mostRecent === undefined) return Promise.resolve(null);\n197\t  if (ctx.hasUI) {\n198\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n199\t  }\n200\t  return Promise.resolve(mostRecent.threadId);\n201\t}\n202\t\n203\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n204\t *  generated by the registry at creation, so the file name is just a unique\n205\t *  handle; the directory is ensured up front (DatabaseSync does not create\n206\t *  parents). */\n207\tfunction defaultNewThreadFilePath(): string {\n208\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n209\t  mkdirSync(dir, { recursive: true });\n210\t  return join(dir, `${randomUUID()}.sqlite`);\n211\t}\n212\t\n213\t/** Build a connector instance. Its mutable state lives in this closure; the\n214\t *  registered handlers capture it, so the instance stays live for the session\n215\t *  even when `activate` discards the returned object. The connector holds NO\n216\t *  module-level or durable state of its own — reload reconstructs the thread from\n217\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n218\t *  closure reattaches correctly (AC-1.5). */\n219\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n220\t  // The connector's retained state. `state` is plain data (the durable thread\n221\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n222\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n223\t  // none survives the connector — reload re-resolves from the registry.\n224\t  let state: SessionState | null = null;\n225\t  let instance: LhcInstance | null = null;\n226\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n227\t  let captureSession: CaptureSession | null = null;\n228\t  let pendingFork: PendingFork | null = null;\n229\t\n230\t  // Build SDK config with assignment config if provided (Story 6)\n231\t  const buildSdkConfig = deps.buildSdkConfig ??\n232\t    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n233\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n234\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n235\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n236\t\n237\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n238\t    return { code, message, recordedGap: false };\n239\t  }\n240\t\n241\t  // The registry/file deps every resolver path shares. `registryPath` is set\n242\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n243\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n244\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n245\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n246\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n247\t    return resolveDeps;\n248\t  }\n249\t\n250\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n251\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n252\t  // no-flag creates).\n253\t  async function resolveForLaunch(\n254\t    launch: LaunchFlags,\n255\t    ctx: ExtensionContext,\n256\t  ): Promise<OpResult<ThreadRef | null>> {\n257\t    if (launch.resume === true) {\n258\t      const pickerDeps: {\n259\t        registryPath?: string;\n260\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n261\t      } = { select: (choices) => selectThread(choices, ctx) };\n262\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n263\t      return pickThread(ctx.cwd, pickerDeps);\n264\t    }\n265\t    return resolveThread(launch, buildResolveDeps(ctx));\n266\t  }\n267\t\n268\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n269\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n270\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n271\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n272\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n273\t  async function resolveReloadFor(\n274\t    launch: LaunchFlags,\n275\t    ctx: ExtensionContext,\n276\t  ): Promise<OpResult<ThreadRef | null>> {\n277\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n278\t  }\n279\t\n280\t  // session_start: resolve the recording thread and construct one background\n281\t  // instance against it. Config is gated first so a session with no usable\n282\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n283\t  // thread is re-resolved from the durable registry (reattach, never create);\n284\t  // every other reason runs the normal launch resolution. Fork creates a new\n285\t  // thread and seeds it from the source thread (Story 4).\n286\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n287\t    const config = buildSdkConfig(ctx);\n288\t    if (!config.ok) {\n289\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n290\t      return;\n291\t    }\n292\t\n293\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n294\t    let forkAttempted = false;\n295\t\n296\t    // Fork path (Story 4): create a new thread and seed it from the source.\n297\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n298\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n299\t    if (pendingFork !== null) {\n300\t      forkAttempted = true;"}]},"parent_tool_use_id":null,"session_id":"03458fdc-571f-4c31-8c41-41a754d14aad","uuid":"831e34ce-4439-4be3-b128-811f2fcb1338","timestamp":"2026-06-14T13:40:22.741Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  MessageEventInput,\n  OpResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\nimport { loadAssignments as loadAssignmentsImpl } from \"./inference/assignments.js\";\nimport { report, validateReachable } from \"./inference/startup-validation.js\";\nimport {\n  detectForkFromSessionTree,\n  forkInfoFromHook,\n  seedFork,\n} from \"./lifecycle/fork.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { threads } from \"lhc\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n  /** Assignment config for Story 6: operator overrides for provider/model/prompt\n   *  per derivation kind. Uses loadAssignments to merge over shipped defaults. */\n  assignmentConfig?: unknown;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** Fork state captured from `session_before_fork` and used on the next\n *  `session_start{fork}` to create and seed the forked thread. Plain data\n *  only — no PI objects retained across the fork boundary. */\ninterface PendingFork {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production SDK config for Story 5+: injects the host ModelCall function\n *  that resolves provider/model through PI's registry and completes through\n *  pi-ai when available. Story 6 loads assignments from config with shipped\n *  defaults. */\nfunction defaultBuildSdkConfig(\n  ctx: ExtensionContext,\n  assignmentConfig: unknown = undefined,\n): OpResult<SdkConfig> {\n  // Load assignments from config (Story 6: AC-5.4, AC-5.5)\n  const assignments = loadAssignmentsImpl(assignmentConfig);\n\n  return {\n    ok: true,\n    value: {\n      inference: {\n        call: createModelCall(ctx),\n        assignments,\n      },\n      mode: \"background\",\n    },\n  };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n *  most recently created thread as the best available explicit default. The\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n *  takes the `select` seam); tests drive an explicit operator choice through it.\n *  A true interactive picker awaits a PI input surface; until then resuming a\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n *  precise spec deviation. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  if (mostRecent === undefined) return Promise.resolve(null);\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n  }\n  return Promise.resolve(mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n  let pendingFork: PendingFork | null = null;\n\n  // Build SDK config with assignment config if provided (Story 6)\n  const buildSdkConfig = deps.buildSdkConfig ??\n    ((ctx: ExtensionContext) => defaultBuildSdkConfig(ctx, deps.assignmentConfig));\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;","numLines":300,"startLine":1,"totalLines":676}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a8572738b1ea4169b4fc7005","type":"tool_result","content":"1\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\n2\t// reconstruction. Two layers are covered: the resolver/picker functions\n3\t// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\n4\t// PRODUCTION connector path through createConnector with real defaults (no\n5\t// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\n6\t// throughout; the module-level reload memory is reset per test.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  createDeterministicProvider,\n10\t  inspect,\n11\t  threads,\n12\t  type SdkConfig,\n13\t  type ThreadRef,\n14\t} from \"lhc\";\n15\timport { createConnector } from \"../../src/index.js\";\n16\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n17\timport {\n18\t  defaultThreadTitle,\n19\t  parseLaunchFlags,\n20\t  resolveThread,\n21\t  type ResolveDeps,\n22\t} from \"../../src/lifecycle/thread-resolution.js\";\n23\timport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\n24\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n25\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n26\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n27\t\n28\tlet store: TempStore;\n29\tbeforeEach(() => {\n30\t  store = tempStore();\n31\t  // No connector reset needed: the connector keeps no module-level state — reload\n32\t  // reconstructs from the durable registry, and each test uses a fresh temp store.\n33\t});\n34\tafterEach(() => {\n35\t  store.cleanup();\n36\t});\n37\t\n38\tfunction backgroundConfig(): SdkConfig {\n39\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n40\t}\n41\t\n42\tfunction idOf(ref: ThreadRef): string {\n43\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n44\t  return ref.threadId;\n45\t}\n46\t\n47\tfunction deps(cwd = \"/work/default\"): ResolveDeps {\n48\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n49\t}\n50\t\n51\t// Create a thread directly with explicit cwd/title, for picker fixtures and\n52\t// existing-thread setup. (Connector-created threads get cwd plus a default title\n53\t// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\n54\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n55\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n56\t    filePath: store.threadPath(),\n57\t    registryPath: store.registryPath,\n58\t  };\n59\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n60\t  if (opts.title !== undefined) input.title = opts.title;\n61\t  const created = await threads.newThread(input);\n62\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n63\t  return created.value.threadId;\n64\t}\n65\t\n66\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n67\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\n68\t// object, modelling PI handing a fresh ctx to each hook.\n69\tfunction syntheticCtx(cwd: string): ExtensionContext {\n70\t  return {\n71\t    cwd,\n72\t    hasUI: false,\n73\t    modelRegistry: {\n74\t      find: () => undefined,\n75\t      hasConfiguredAuth: () => false,\n76\t      getAvailable: () => [],\n77\t    },\n78\t    ui: { notify: () => {} },\n79\t    sessionManager: { getEntries: () => [] },\n80\t  };\n81\t}\n82\t\n83\t// A connector wired with production defaults (real SDK config + selector) and\n84\t// only environment overrides — the activate() path, minus the global registry\n85\t// and process.argv.\n86\tfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n87\t  return createConnector({\n88\t    registryPath: store.registryPath,\n89\t    newThreadFilePath: () => store.threadPath(),\n90\t    parseLaunch: launch,\n91\t  });\n92\t}\n93\t\n94\tasync function threadCount(): Promise<number> {\n95\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\n96\t  return listed.ok ? listed.value.length : -1;\n97\t}\n98\t\n99\tdescribe(\"Story 1: launch-driven thread resolution (resolver/picker)\", () => {\n100\t  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n101\t    // no flag → a new thread\n102\t    const first = await resolveThread({}, deps());\n103\t    expect(first.ok).toBe(true);\n104\t    if (!first.ok) return;\n105\t    const firstId = idOf(first.value);\n106\t\n107\t    // --session full id → the same thread\n108\t    const byFull = await resolveThread({ session: firstId }, deps());\n109\t    expect(byFull.ok).toBe(true);\n110\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n111\t\n112\t    // --session partial id → the same thread\n113\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n114\t    expect(byPartial.ok).toBe(true);\n115\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n116\t\n117\t    // a second thread, then --continue → the most recently created\n118\t    const second = await resolveThread({}, deps());\n119\t    expect(second.ok).toBe(true);\n120\t    if (!second.ok) return;\n121\t    const secondId = idOf(second.value);\n122\t    const continued = await resolveThread({ continue: true }, deps());\n123\t    expect(continued.ok).toBe(true);\n124\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n125\t\n126\t    // unresolvable id → actionable error, no thread created\n127\t    const before = await threadCount();\n128\t    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n129\t    expect(bad.ok).toBe(false);\n130\t    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n131\t    expect(await threadCount()).toBe(before);\n132\t\n133\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\n134\t    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n135\t    expect(ambiguous.ok).toBe(false);\n136\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n137\t    expect(await threadCount()).toBe(before);\n138\t  });\n139\t\n140\t  it(\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\", () => {\n141\t    expect(parseLaunchFlags([\"node\", \"pi\"])).toEqual({});\n142\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--resume\"])).toEqual({ resume: true });\n143\t    expect(parseLaunchFlags([\"node\", \"pi\", \"-r\"])).toEqual({ resume: true });\n144\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--continue\"])).toEqual({ continue: true });\n145\t    expect(parseLaunchFlags([\"node\", \"pi\", \"-c\"])).toEqual({ continue: true });\n146\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--session\", \"th_abc\"])).toEqual({ session: \"th_abc\" });\n147\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--session=th_xyz\"])).toEqual({ session: \"th_xyz\" });\n148\t  });\n149\t\n150\t  it(\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\", async () => {\n151\t    const created = await resolveThread({}, deps(\"/work/proj-x\"));\n152\t    expect(created.ok).toBe(true);\n153\t    if (!created.ok) return;\n154\t    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\n155\t    expect(row.ok).toBe(true);\n156\t    if (!row.ok) return;\n157\t    expect(row.value.cwd).toBe(\"/work/proj-x\");\n158\t    expect(row.value.title).toBe(defaultThreadTitle(\"/work/proj-x\")); // \"proj-x\"\n159\t  });\n160\t\n161\t  it(\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n162\t    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n163\t    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n164\t    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n165\t\n166\t    let offered: readonly ThreadChoice[] = [];\n167\t    const picked = await pickThread(\"/work/a\", {\n168\t      registryPath: store.registryPath,\n169\t      select: (choices) => {\n170\t        offered = choices;\n171\t        return Promise.resolve(choices[0]!.threadId);\n172\t      },\n173\t    });\n174\t    expect(picked.ok).toBe(true);\n175\t\n176\t    // Only the current cwd's threads are offered, each with title + creation time.\n177\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n178\t    for (const choice of offered) {\n179\t      expect(choice.createdAt).toBeTruthy();\n180\t      expect(choice.title).toBeTruthy();\n181\t    }\n182\t\n183\t    // The operator's selection resolves to that thread.\n184\t    if (picked.ok && picked.value !== null) {\n185\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n186\t    }\n187\t\n188\t    // An empty cwd reports an empty list (null) without failing or prompting.\n189\t    let selectCalled = false;\n190\t    const empty = await pickThread(\"/work/empty\", {\n191\t      registryPath: store.registryPath,\n192\t      select: () => {\n193\t        selectCalled = true;\n194\t        return Promise.resolve(null);\n195\t      },\n196\t    });\n197\t    expect(empty.ok).toBe(true);\n198\t    if (empty.ok) expect(empty.value).toBeNull();\n199\t    expect(selectCalled).toBe(false);\n200\t  });\n201\t\n202\t  it(\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\", async () => {\n203\t    const cwd = \"/work/tc-1-5\";\n204\t    const created = await resolveThread({}, deps(cwd));\n205\t    expect(created.ok).toBe(true);\n206\t    if (!created.ok) return;\n207\t    const threadId = idOf(created.value);\n208\t\n209\t    const first = await initInstance(created.value, backgroundConfig());\n210\t    expect(first.ok).toBe(true);\n211\t    if (!first.ok) return;\n212\t    await first.value.sdk.intakeStream.messageEvents(\n213\t      first.value.threadRef,\n214\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n215\t    );\n216\t    await disposeInstance(first.value);\n217\t\n218\t    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\n219\t    // flag would across process death). Reconstruct purely from it.\n220\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n221\t    expect(reattached.ok).toBe(true);\n222\t    if (!reattached.ok) return;\n223\t    expect(idOf(reattached.value)).toBe(threadId);\n224\t\n225\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n226\t    expect(rebuilt.ok).toBe(true);\n227\t    if (!rebuilt.ok) return;\n228\t    await rebuilt.value.sdk.intakeStream.messageEvents(\n229\t      rebuilt.value.threadRef,\n230\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n231\t    );\n232\t    const overview = await inspect.overview(reattached.value);\n233\t    expect(overview.ok).toBe(true);\n234\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n235\t    await disposeInstance(rebuilt.value);\n236\t  });\n237\t});\n238\t\n239\tdescribe(\"Story 1: launch-driven thread resolution (production connector path)\", () => {\n240\t  it(\"TC-1.2: session_start resolving an existing thread creates no second thread\", async () => {\n241\t    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n242\t    const before = await threadCount();\n243\t\n244\t    const connector = productionConnector(() => ({ session: existingId }));\n245\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"startup\"));\n246\t\n247\t    const state = connector.getState();\n248\t    expect(state).not.toBeNull();\n249\t    if (state === null) return;\n250\t    expect(idOf(state.threadRef)).toBe(existingId);\n251\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n252\t    expect(await threadCount()).toBe(before); // no second thread\n253\t  });\n254\t\n255\t  it(\"TC-1.7: production --resume presents the cwd-scoped titled candidates via ctx.ui.notify and resolves a selection\", async () => {\n256\t    await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n257\t    const recent = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n258\t    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n259\t    const before = await threadCount();\n260\t\n261\t    // A ctx WITH a UI captures exactly what the picker presents to the operator.\n262\t    const notes: string[] = [];\n263\t    const ctx: ExtensionContext = {\n264\t      cwd: \"/work/resume\",\n265\t      hasUI: true,\n266\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n267\t      ui: { notify: (message) => notes.push(message) },\n268\t      sessionManager: { getEntries: () => [] },\n269\t    };\n270\t\n271\t    const connector = productionConnector(() => ({ resume: true }));\n272\t    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n273\t\n274\t    // The operator was shown the cwd-scoped candidate list — only this cwd's\n275\t    // threads, each with title and creation time — through ctx.ui.notify (the\n276\t    // only PI v0.79.2 surface; selection resolves to the best available default).\n277\t    const shown = notes.find((note) => note.includes(\"pi-lhc --resume:\"));\n278\t    expect(shown).toBeDefined();\n279\t    if (shown === undefined) return;\n280\t    expect(shown).toContain(\"older\");\n281\t    expect(shown).toContain(\"newer\");\n282\t    expect(shown).not.toContain(\"different cwd\"); // a different cwd is not offered\n283\t    const recentRow = await threads.resolve({ threadId: recent, registryPath: store.registryPath });\n284\t    if (recentRow.ok) expect(shown).toContain(recentRow.value.createdAt); // creation time shown\n285\t\n286\t    const state = connector.getState();\n287\t    expect(state).not.toBeNull();\n288\t    if (state === null) return;\n289\t    expect(idOf(state.threadRef)).toBe(recent); // best available explicit default selection\n290\t    expect(connector.getInstance()).not.toBeNull();\n291\t    expect(await threadCount()).toBe(before); // resumed, not created\n292\t  });\n293\t\n294\t  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n295\t    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n296\t    const before = await threadCount();\n297\t\n298\t    const connector = productionConnector(() => ({ resume: true }));\n299\t    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n300\t    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n301\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n302\t\n303\t    const state = connector.getState();\n304\t    expect(state).not.toBeNull();\n305\t    if (state === null) return;\n306\t    expect(connector.getInstance()).not.toBeNull();\n307\t    expect(await threadCount()).toBe(before); // resolved without failing\n308\t  });\n309\t});\n310\t\n311\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n312\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n313\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n314\t\n315\t    // session_start with a ctx carrying methods.\n316\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n317\t    expect(connector.getState()).not.toBeNull();\n318\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n319\t    // ...but the snapshot is plain data only — it survives structuredClone even\n320\t    // though the live ctx and instance carry methods (they are not in it).\n321\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n322\t    const threadRefBefore = connector.getState()?.threadRef;\n323\t\n324\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n325\t    // holder still references no prior ctx.\n326\t    await connector.handlers.message_end(\n327\t      syntheticCtx(\"/work/a\"),\n328\t      makeMessageEnd(makeUserMessage(\"hi\")),\n329\t    );\n330\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n331\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n332\t  });\n333\t});\n334\t\n335\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n336\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n337\t    const cwd = \"/work/reload\";\n338\t\n339\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n340\t    const connectorA = productionConnector(() => ({}));\n341\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n342\t    const stateA = connectorA.getState();\n343\t    expect(stateA).not.toBeNull();\n344\t    if (stateA === null) return;\n345\t    const firstId = idOf(stateA.threadRef);\n346\t    const countAfterNew = await threadCount();\n347\t\n348\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n349\t    expect(row.ok).toBe(true);\n350\t    if (row.ok) {\n351\t      expect(row.value.cwd).toBe(cwd);\n352\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n353\t    }\n354\t\n355\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n356\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n357\t    // closure and a still-no-flag launch (which would otherwise create a\n358\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n359\t    // thing bridging the teardown is the durable registry — this is what proves\n360\t    // reconstruction survives loss of every in-memory holder (SV-001).\n361\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n362\t\n363\t    const connectorB = productionConnector(() => ({}));\n364\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n365\t\n366\t    const stateB = connectorB.getState();\n367\t    expect(stateB).not.toBeNull();\n368\t    if (stateB === null) return;\n369\t    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n370\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n371\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n372\t  });\n373\t\n374\t  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n375\t    const cwd = \"/work/reload-session\";\n376\t    const existing = await makeThread({ cwd, title: \"carried\" });\n377\t    const before = await threadCount();\n378\t\n379\t    // Launched with --session <id>: reload re-resolves the SAME id from the\n380\t    // durable registry, independent of any in-memory state.\n381\t    const connectorA = productionConnector(() => ({ session: existing }));\n382\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"startup\"));\n383\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n384\t\n385\t    const connectorB = productionConnector(() => ({ session: existing }));\n386\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n387\t    expect(idOf(connectorB.getState()!.threadRef)).toBe(existing);\n388\t    expect(await threadCount()).toBe(before); // no thread created on reload\n389\t  });\n390\t\n391\t  it(\"a no-flag 'new' session always creates a new thread — reattach is reload-only, keyed on the start reason, not on retained memory\", async () => {\n392\t    const cwd = \"/work/fresh\";\n393\t    const connectorA = productionConnector(() => ({}));\n394\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n395\t    const firstId = idOf(connectorA.getState()!.threadRef);\n396\t\n397\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n398\t\n399\t    const connectorB = productionConnector(() => ({}));\n400\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n401\t    const secondId = idOf(connectorB.getState()!.threadRef);\n402\t\n403\t    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\n404\t    expect(await threadCount()).toBe(2);\n405\t  });\n406\t});\n407\t"}]},"parent_tool_use_id":null,"session_id":"03458fdc-571f-4c31-8c41-41a754d14aad","uuid":"8a5b1b7b-13a6-4e44-9065-1ed75d6c32bb","timestamp":"2026-06-14T13:40:22.742Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts","content":"// Story 1 — launch-driven thread resolution, plain-data state, and reload\n// reconstruction. Two layers are covered: the resolver/picker functions\n// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\n// PRODUCTION connector path through createConnector with real defaults (no\n// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\n// throughout; the module-level reload memory is reset per test.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector } from \"../../src/index.js\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport {\n  defaultThreadTitle,\n  parseLaunchFlags,\n  resolveThread,\n  type ResolveDeps,\n} from \"../../src/lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n  // No connector reset needed: the connector keeps no module-level state — reload\n  // reconstructs from the durable registry, and each test uses a fresh temp store.\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\nfunction deps(cwd = \"/work/default\"): ResolveDeps {\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n}\n\n// Create a thread directly with explicit cwd/title, for picker fixtures and\n// existing-thread setup. (Connector-created threads get cwd plus a default title\n// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  };\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n  if (opts.title !== undefined) input.title = opts.title;\n  const created = await threads.newThread(input);\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n  return created.value.threadId;\n}\n\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\n// object, modelling PI handing a fresh ctx to each hook.\nfunction syntheticCtx(cwd: string): ExtensionContext {\n  return {\n    cwd,\n    hasUI: false,\n    modelRegistry: {\n      find: () => undefined,\n      hasConfiguredAuth: () => false,\n      getAvailable: () => [],\n    },\n    ui: { notify: () => {} },\n    sessionManager: { getEntries: () => [] },\n  };\n}\n\n// A connector wired with production defaults (real SDK config + selector) and\n// only environment overrides — the activate() path, minus the global registry\n// and process.argv.\nfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n  return createConnector({\n    registryPath: store.registryPath,\n    newThreadFilePath: () => store.threadPath(),\n    parseLaunch: launch,\n  });\n}\n\nasync function threadCount(): Promise<number> {\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\n  return listed.ok ? listed.value.length : -1;\n}\n\ndescribe(\"Story 1: launch-driven thread resolution (resolver/picker)\", () => {\n  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n    // no flag → a new thread\n    const first = await resolveThread({}, deps());\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    const firstId = idOf(first.value);\n\n    // --session full id → the same thread\n    const byFull = await resolveThread({ session: firstId }, deps());\n    expect(byFull.ok).toBe(true);\n    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n\n    // --session partial id → the same thread\n    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n    expect(byPartial.ok).toBe(true);\n    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n\n    // a second thread, then --continue → the most recently created\n    const second = await resolveThread({}, deps());\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    const secondId = idOf(second.value);\n    const continued = await resolveThread({ continue: true }, deps());\n    expect(continued.ok).toBe(true);\n    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n\n    // unresolvable id → actionable error, no thread created\n    const before = await threadCount();\n    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n    expect(bad.ok).toBe(false);\n    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n    expect(await threadCount()).toBe(before);\n\n    // ambiguous prefix (matches both threads) → actionable error, no thread created\n    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n    expect(ambiguous.ok).toBe(false);\n    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n    expect(await threadCount()).toBe(before);\n  });\n\n  it(\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\", () => {\n    expect(parseLaunchFlags([\"node\", \"pi\"])).toEqual({});\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--resume\"])).toEqual({ resume: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"-r\"])).toEqual({ resume: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--continue\"])).toEqual({ continue: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"-c\"])).toEqual({ continue: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--session\", \"th_abc\"])).toEqual({ session: \"th_abc\" });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--session=th_xyz\"])).toEqual({ session: \"th_xyz\" });\n  });\n\n  it(\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\", async () => {\n    const created = await resolveThread({}, deps(\"/work/proj-x\"));\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    expect(row.value.cwd).toBe(\"/work/proj-x\");\n    expect(row.value.title).toBe(defaultThreadTitle(\"/work/proj-x\")); // \"proj-x\"\n  });\n\n  it(\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n\n    let offered: readonly ThreadChoice[] = [];\n    const picked = await pickThread(\"/work/a\", {\n      registryPath: store.registryPath,\n      select: (choices) => {\n        offered = choices;\n        return Promise.resolve(choices[0]!.threadId);\n      },\n    });\n    expect(picked.ok).toBe(true);\n\n    // Only the current cwd's threads are offered, each with title + creation time.\n    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n    for (const choice of offered) {\n      expect(choice.createdAt).toBeTruthy();\n      expect(choice.title).toBeTruthy();\n    }\n\n    // The operator's selection resolves to that thread.\n    if (picked.ok && picked.value !== null) {\n      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n    }\n\n    // An empty cwd reports an empty list (null) without failing or prompting.\n    let selectCalled = false;\n    const empty = await pickThread(\"/work/empty\", {\n      registryPath: store.registryPath,\n      select: () => {\n        selectCalled = true;\n        return Promise.resolve(null);\n      },\n    });\n    expect(empty.ok).toBe(true);\n    if (empty.ok) expect(empty.value).toBeNull();\n    expect(selectCalled).toBe(false);\n  });\n\n  it(\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\", async () => {\n    const cwd = \"/work/tc-1-5\";\n    const created = await resolveThread({}, deps(cwd));\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n    const threadId = idOf(created.value);\n\n    const first = await initInstance(created.value, backgroundConfig());\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    await first.value.sdk.intakeStream.messageEvents(\n      first.value.threadRef,\n      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n    );\n    await disposeInstance(first.value);\n\n    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\n    // flag would across process death). Reconstruct purely from it.\n    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n    expect(idOf(reattached.value)).toBe(threadId);\n\n    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n    expect(rebuilt.ok).toBe(true);\n    if (!rebuilt.ok) return;\n    await rebuilt.value.sdk.intakeStream.messageEvents(\n      rebuilt.value.threadRef,\n      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n    );\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n    await disposeInstance(rebuilt.value);\n  });\n});\n\ndescribe(\"Story 1: launch-driven thread resolution (production connector path)\", () => {\n  it(\"TC-1.2: session_start resolving an existing thread creates no second thread\", async () => {\n    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n    const before = await threadCount();\n\n    const connector = productionConnector(() => ({ session: existingId }));\n    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"startup\"));\n\n    const state = connector.getState();\n    expect(state).not.toBeNull();\n    if (state === null) return;\n    expect(idOf(state.threadRef)).toBe(existingId);\n    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n    expect(await threadCount()).toBe(before); // no second thread\n  });\n\n  it(\"TC-1.7: production --resume presents the cwd-scoped titled candidates via ctx.ui.notify and resolves a selection\", async () => {\n    await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n    const recent = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n    const before = await threadCount();\n\n    // A ctx WITH a UI captures exactly what the picker presents to the operator.\n    const notes: string[] = [];\n    const ctx: ExtensionContext = {\n      cwd: \"/work/resume\",\n      hasUI: true,\n      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n      ui: { notify: (message) => notes.push(message) },\n      sessionManager: { getEntries: () => [] },\n    };\n\n    const connector = productionConnector(() => ({ resume: true }));\n    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n\n    // The operator was shown the cwd-scoped candidate list — only this cwd's\n    // threads, each with title and creation time — through ctx.ui.notify (the\n    // only PI v0.79.2 surface; selection resolves to the best available default).\n    const shown = notes.find((note) => note.includes(\"pi-lhc --resume:\"));\n    expect(shown).toBeDefined();\n    if (shown === undefined) return;\n    expect(shown).toContain(\"older\");\n    expect(shown).toContain(\"newer\");\n    expect(shown).not.toContain(\"different cwd\"); // a different cwd is not offered\n    const recentRow = await threads.resolve({ threadId: recent, registryPath: store.registryPath });\n    if (recentRow.ok) expect(shown).toContain(recentRow.value.createdAt); // creation time shown\n\n    const state = connector.getState();\n    expect(state).not.toBeNull();\n    if (state === null) return;\n    expect(idOf(state.threadRef)).toBe(recent); // best available explicit default selection\n    expect(connector.getInstance()).not.toBeNull();\n    expect(await threadCount()).toBe(before); // resumed, not created\n  });\n\n  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n    const before = await threadCount();\n\n    const connector = productionConnector(() => ({ resume: true }));\n    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n\n    const state = connector.getState();\n    expect(state).not.toBeNull();\n    if (state === null) return;\n    expect(connector.getInstance()).not.toBeNull();\n    expect(await threadCount()).toBe(before); // resolved without failing\n  });\n});\n\ndescribe(\"Story 1: plain-data state across hooks\", () => {\n  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n\n    // session_start with a ctx carrying methods.\n    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n    expect(connector.getState()).not.toBeNull();\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n    // ...but the snapshot is plain data only — it survives structuredClone even\n    // though the live ctx and instance carry methods (they are not in it).\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    const threadRefBefore = connector.getState()?.threadRef;\n\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n    // holder still references no prior ctx.\n    await connector.handlers.message_end(\n      syntheticCtx(\"/work/a\"),\n      makeMessageEnd(makeUserMessage(\"hi\")),\n    );\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n  });\n});\n\ndescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n    const cwd = \"/work/reload\";\n\n    // Connector A: a no-flag session creates the thread (cwd + default title).\n    const connectorA = productionConnector(() => ({}));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const stateA = connectorA.getState();\n    expect(stateA).not.toBeNull();\n    if (stateA === null) return;\n    const firstId = idOf(stateA.threadRef);\n    const countAfterNew = await threadCount();\n\n    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (row.ok) {\n      expect(row.value.cwd).toBe(cwd);\n      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n    }\n\n    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n    // referenced again. A brand-new connector handles the reload with an EMPTY\n    // closure and a still-no-flag launch (which would otherwise create a\n    // duplicate). The connector keeps NO module-level handoff state, so the only\n    // thing bridging the teardown is the durable registry — this is what proves\n    // reconstruction survives loss of every in-memory holder (SV-001).\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n\n    const connectorB = productionConnector(() => ({}));\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n\n    const stateB = connectorB.getState();\n    expect(stateB).not.toBeNull();\n    if (stateB === null) return;\n    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n  });\n\n  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n    const cwd = \"/work/reload-session\";\n    const existing = await makeThread({ cwd, title: \"carried\" });\n    const before = await threadCount();\n\n    // Launched with --session <id>: reload re-resolves the SAME id from the\n    // durable registry, independent of any in-memory state.\n    const connectorA = productionConnector(() => ({ session: existing }));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"startup\"));\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n\n    const connectorB = productionConnector(() => ({ session: existing }));\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n    expect(idOf(connectorB.getState()!.threadRef)).toBe(existing);\n    expect(await threadCount()).toBe(before); // no thread created on reload\n  });\n\n  it(\"a no-flag 'new' session always creates a new thread — reattach is reload-only, keyed on the start reason, not on retained memory\", async () => {\n    const cwd = \"/work/fresh\";\n    const connectorA = productionConnector(() => ({}));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const firstId = idOf(connectorA.getState()!.threadRef);\n\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n\n    const connectorB = productionConnector(() => ({}));\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const secondId = idOf(connectorB.getState()!.threadRef);\n\n    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\n    expect(await threadCount()).toBe(2);\n  });\n});\n","numLines":407,"startLine":1,"totalLines":407}}}

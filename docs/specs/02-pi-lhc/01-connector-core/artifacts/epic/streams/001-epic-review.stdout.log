{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3af39d44e0794ddcad2e212f","type":"tool_result","content":"1\timport type { MessageEventInput } from \"lhc\";\n2\timport { eventKey } from \"./idempotency.js\";\n3\t\n4\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n5\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n6\t//\n7\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n8\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\n9\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n10\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n11\t// no-op on reattach, since a fresh accumulator has no open turn to close.\n12\t\n13\texport interface TurnAccumulatorCtx {\n14\t  piSessionId: string;\n15\t  actor?: string;\n16\t  harness?: string;\n17\t}\n18\t\n19\texport class TurnAccumulator {\n20\t  private readonly piSessionId: string;\n21\t  private readonly actor: string;\n22\t  private readonly harness: string;\n23\t  private open = false;\n24\t  private openTurnKey: string | null = null;\n25\t\n26\t  constructor(ctx: TurnAccumulatorCtx) {\n27\t    this.piSessionId = ctx.piSessionId;\n28\t    this.actor = ctx.actor ?? \"system\";\n29\t    this.harness = ctx.harness ?? \"pi\";\n30\t  }\n31\t\n32\t  /** Open the turn when this message's events include a `user_prompt`. A new\n33\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n34\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n35\t  onMessage(events: MessageEventInput[]): void {\n36\t    const opening = events.find((event) => event.eventKind === \"user_prompt\");\n37\t    if (opening !== undefined) {\n38\t      this.open = true;\n39\t      this.openTurnKey = opening.idempotencyKey;\n40\t    }\n41\t  }\n42\t\n43\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n44\t   *  transition the accumulator drives, and it happens once per agent run. */\n45\t  onAgentEnd(): MessageEventInput[] {\n46\t    if (!this.open) return [];\n47\t    this.open = false;\n48\t    const key = eventKey({\n49\t      piSessionId: this.piSessionId,\n50\t      blockIndex: 0,\n51\t      kind: \"turn_end\",\n52\t      role: \"system\",\n53\t      content: this.openTurnKey ?? \"turn:end\",\n54\t    });\n55\t    this.openTurnKey = null;\n56\t    return [\n57\t      {\n58\t        eventKind: \"turn_end\",\n59\t        idempotencyKey: key,\n60\t        actor: this.actor,\n61\t        harness: this.harness,\n62\t        payload: {},\n63\t      },\n64\t    ];\n65\t  }\n66\t\n67\t  hasOpenTurn(): boolean {\n68\t    return this.open;\n69\t  }\n70\t}\n71\t"}]},"parent_tool_use_id":null,"session_id":"a0d8ccb7-eaf7-457e-b1b4-b7920fccc144","uuid":"68f8329f-2f03-4b59-87ad-1467dbd005da","timestamp":"2026-06-14T13:39:07.167Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/turn-accumulator.ts","content":"import type { MessageEventInput } from \"lhc\";\nimport { eventKey } from \"./idempotency.js\";\n\n// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n//\n// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n// The converter never feeds PI's per-step `turn_end` here, so it can never close\n// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n// no-op on reattach, since a fresh accumulator has no open turn to close.\n\nexport interface TurnAccumulatorCtx {\n  piSessionId: string;\n  actor?: string;\n  harness?: string;\n}\n\nexport class TurnAccumulator {\n  private readonly piSessionId: string;\n  private readonly actor: string;\n  private readonly harness: string;\n  private open = false;\n  private openTurnKey: string | null = null;\n\n  constructor(ctx: TurnAccumulatorCtx) {\n    this.piSessionId = ctx.piSessionId;\n    this.actor = ctx.actor ?? \"system\";\n    this.harness = ctx.harness ?? \"pi\";\n  }\n\n  /** Open the turn when this message's events include a `user_prompt`. A new\n   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n  onMessage(events: MessageEventInput[]): void {\n    const opening = events.find((event) => event.eventKind === \"user_prompt\");\n    if (opening !== undefined) {\n      this.open = true;\n      this.openTurnKey = opening.idempotencyKey;\n    }\n  }\n\n  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n   *  transition the accumulator drives, and it happens once per agent run. */\n  onAgentEnd(): MessageEventInput[] {\n    if (!this.open) return [];\n    this.open = false;\n    const key = eventKey({\n      piSessionId: this.piSessionId,\n      blockIndex: 0,\n      kind: \"turn_end\",\n      role: \"system\",\n      content: this.openTurnKey ?? \"turn:end\",\n    });\n    this.openTurnKey = null;\n    return [\n      {\n        eventKind: \"turn_end\",\n        idempotencyKey: key,\n        actor: this.actor,\n        harness: this.harness,\n        payload: {},\n      },\n    ];\n  }\n\n  hasOpenTurn(): boolean {\n    return this.open;\n  }\n}\n","numLines":71,"startLine":1,"totalLines":71}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8be3288fd55a4b08a2a69b8a","type":"tool_result","content":"1\timport { basename } from \"node:path\";\n2\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n3\t\n4\t// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n5\t// it (tech design Flow 1). PI's own session file still exists in this\n6\t// observe-only epic — it is just not where thread identity lives.\n7\t\n8\t/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n9\t *  before this resolver — see `picker.ts`.) */\n10\texport interface LaunchFlags {\n11\t  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n12\t  continue?: boolean; // --continue / -c : most recent\n13\t  session?: string; // --session <id> : full or partial id\n14\t}\n15\t\n16\t/** What the resolver needs from the host beyond the launch flags: the cwd a new\n17\t *  thread is registered under, the registry to resolve through, and where a new\n18\t *  thread's file is created. Injected so the resolver is exercised against a\n19\t *  real temp registry in tests and the default `~/.lhc` registry in production —\n20\t *  `registryPath` is a per-operation argument, never an `initLhc` config field\n21\t *  (tech design Technical Notes). */\n22\texport interface ResolveDeps {\n23\t  cwd: string;\n24\t  registryPath?: string;\n25\t  newThreadFilePath: () => string;\n26\t  /** Title for a newly created thread (A-8 title metadata). Defaults to\n27\t   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n28\t   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n29\t   *  title from the first prompt — the open TDQ Q4). */\n30\t  newThreadTitle?: string;\n31\t}\n32\t\n33\t/** The creation-time title for a new thread when the host supplies none. At\n34\t *  session_start there is no first prompt yet, so the title is the cwd's leaf\n35\t *  directory name — a real, non-empty project label the `--resume` picker shows\n36\t *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\n37\texport function defaultThreadTitle(cwd: string): string {\n38\t  const leaf = basename(cwd);\n39\t  if (leaf !== \"\") return leaf;\n40\t  return cwd !== \"\" ? cwd : \"lhc session\";\n41\t}\n42\t\n43\t/** The durable, plain-data thread reference the connector retains and\n44\t *  reattaches from: a thread id (plus the registry it lives in), not a live\n45\t *  object. `{ filePath }` is avoided so reload reconstructs by id. */\n46\texport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n47\t  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n48\t}\n49\t\n50\t/** Spread `registryPath` into an LHC threads-call options object only when it is\n51\t *  set, so an unset registry path falls through to LHC's default rather than\n52\t *  being passed as an explicit `undefined` (rejected under\n53\t *  exactOptionalPropertyTypes). */\n54\texport function registryArg(registryPath?: string): { registryPath?: string } {\n55\t  return registryPath === undefined ? {} : { registryPath };\n56\t}\n57\t\n58\t/** Resolve the recording thread from the launch input (AC-1.6):\n59\t *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n60\t *    ambiguous fails loud (the registry returns `thread_not_found` /\n61\t *    `ambiguous_thread_id`) and never silently creates a thread.\n62\t *  - `--continue`: the most recently created thread.\n63\t *  - no flag: a new thread, registered with its cwd (AC-1.1).\n64\t *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n65\t *  durable id rather than a retained object (AC-1.5). */\n66\texport async function resolveThread(\n67\t  launch: LaunchFlags,\n68\t  deps: ResolveDeps,\n69\t): Promise<OpResult<ThreadRef>> {\n70\t  if (launch.session !== undefined) {\n71\t    const resolved = await threads.resolve({\n72\t      threadId: launch.session,\n73\t      ...registryArg(deps.registryPath),\n74\t    });\n75\t    if (!resolved.ok) return resolved;\n76\t    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n77\t  }\n78\t\n79\t  if (launch.continue === true) {\n80\t    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n81\t    if (!listed.ok) return listed;\n82\t    // The registry lists in creation order with an insertion-order tie-break,\n83\t    // so the last row is the most recently created thread.\n84\t    const mostRecent = listed.value.at(-1);\n85\t    if (mostRecent === undefined) {\n86\t      return {\n87\t        ok: false,\n88\t        error: {\n89\t          errorClass: \"caller_error\",\n90\t          code: \"thread_not_found\",\n91\t          reason: \"--continue: no threads exist to continue\",\n92\t        },\n93\t      };\n94\t    }\n95\t    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n96\t  }\n97\t\n98\t  const created = await threads.newThread({\n99\t    filePath: deps.newThreadFilePath(),\n100\t    cwd: deps.cwd,\n101\t    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n102\t    ...registryArg(deps.registryPath),\n103\t  });\n104\t  if (!created.ok) return created;\n105\t  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n106\t}\n107\t\n108\t/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n109\t *  re-initialized while the same PI session continues — re-resolve the session's\n110\t *  thread from DURABLE registry state. It reads no retained in-process memory and\n111\t *  never creates a new thread or re-prompts a picker; the resolved id comes back\n112\t *  out of the registry (the durable catalog), so reconstruction survives the loss\n113\t *  of every in-memory holder (the architecture-risk scenario).\n114\t *\n115\t *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n116\t *    Both are idempotent — resolving twice returns the same thread and creates\n117\t *    nothing — so the normal resolver already reattaches correctly.\n118\t *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n119\t *    read from the registry. A no-flag Story-1 session created exactly one thread\n120\t *    in its cwd, so that is the thread; re-running the launch instead would create\n121\t *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n122\t *\n123\t *  Returns `null` when the cwd has no thread to reattach (a reload against an\n124\t *  empty registry); the caller records a diagnostic rather than creating one.\n125\t *\n126\t *  This is the answer to \"where does the durable reload id live without a\n127\t *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n128\t *  the system of record, not in a connector field or a recovery sidecar. The\n129\t *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n130\t *  reload/fork lineage is LHC thread metadata (Feature 2+). */\n131\texport async function resolveReloadThread(\n132\t  launch: LaunchFlags,\n133\t  deps: ResolveDeps,\n134\t): Promise<OpResult<ThreadRef | null>> {\n135\t  if (launch.session !== undefined) {\n136\t    return resolveThread({ session: launch.session }, deps);\n137\t  }\n138\t  if (launch.continue === true) {\n139\t    return resolveThread({ continue: true }, deps);\n140\t  }\n141\t  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n142\t  if (!listed.ok) return listed;\n143\t  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n144\t  // the most recently created thread for this directory.\n145\t  const mostRecent = listed.value.at(-1);\n146\t  if (mostRecent === undefined) return { ok: true, value: null };\n147\t  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n148\t}\n149\t\n150\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n151\t *  so PI's launch arguments are visible on `process.argv`; this is the\n152\t *  production source of the launch mode. Supports `--session <id>`,\n153\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n154\t *  spelling for the named-session mode is an integration detail to confirm\n155\t *  against PI; see the story payload's open questions.) */\n156\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n157\t  const flags: LaunchFlags = {};\n158\t  for (let i = 0; i < argv.length; i += 1) {\n159\t    const arg = argv[i];\n160\t    if (arg === undefined) continue;\n161\t    if (arg === \"--resume\" || arg === \"-r\") {\n162\t      flags.resume = true;\n163\t    } else if (arg === \"--continue\" || arg === \"-c\") {\n164\t      flags.continue = true;\n165\t    } else if (arg === \"--session\") {\n166\t      const next = argv[i + 1];\n167\t      if (next !== undefined && !next.startsWith(\"-\")) {\n168\t        flags.session = next;\n169\t        i += 1;\n170\t      }\n171\t    } else if (arg.startsWith(\"--session=\")) {\n172\t      flags.session = arg.slice(\"--session=\".length);\n173\t    }\n174\t  }\n175\t  return flags;\n176\t}\n177\t"}]},"parent_tool_use_id":null,"session_id":"a0d8ccb7-eaf7-457e-b1b4-b7920fccc144","uuid":"e9b44a91-d42b-477f-b46f-27b5f8e54ba5","timestamp":"2026-06-14T13:39:07.168Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/thread-resolution.ts","content":"import { basename } from \"node:path\";\nimport { threads, type OpResult, type ThreadRef } from \"lhc\";\n\n// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n// it (tech design Flow 1). PI's own session file still exists in this\n// observe-only epic — it is just not where thread identity lives.\n\n/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n *  before this resolver — see `picker.ts`.) */\nexport interface LaunchFlags {\n  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n  continue?: boolean; // --continue / -c : most recent\n  session?: string; // --session <id> : full or partial id\n}\n\n/** What the resolver needs from the host beyond the launch flags: the cwd a new\n *  thread is registered under, the registry to resolve through, and where a new\n *  thread's file is created. Injected so the resolver is exercised against a\n *  real temp registry in tests and the default `~/.lhc` registry in production —\n *  `registryPath` is a per-operation argument, never an `initLhc` config field\n *  (tech design Technical Notes). */\nexport interface ResolveDeps {\n  cwd: string;\n  registryPath?: string;\n  newThreadFilePath: () => string;\n  /** Title for a newly created thread (A-8 title metadata). Defaults to\n   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n   *  title from the first prompt — the open TDQ Q4). */\n  newThreadTitle?: string;\n}\n\n/** The creation-time title for a new thread when the host supplies none. At\n *  session_start there is no first prompt yet, so the title is the cwd's leaf\n *  directory name — a real, non-empty project label the `--resume` picker shows\n *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\nexport function defaultThreadTitle(cwd: string): string {\n  const leaf = basename(cwd);\n  if (leaf !== \"\") return leaf;\n  return cwd !== \"\" ? cwd : \"lhc session\";\n}\n\n/** The durable, plain-data thread reference the connector retains and\n *  reattaches from: a thread id (plus the registry it lives in), not a live\n *  object. `{ filePath }` is avoided so reload reconstructs by id. */\nexport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n}\n\n/** Spread `registryPath` into an LHC threads-call options object only when it is\n *  set, so an unset registry path falls through to LHC's default rather than\n *  being passed as an explicit `undefined` (rejected under\n *  exactOptionalPropertyTypes). */\nexport function registryArg(registryPath?: string): { registryPath?: string } {\n  return registryPath === undefined ? {} : { registryPath };\n}\n\n/** Resolve the recording thread from the launch input (AC-1.6):\n *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n *    ambiguous fails loud (the registry returns `thread_not_found` /\n *    `ambiguous_thread_id`) and never silently creates a thread.\n *  - `--continue`: the most recently created thread.\n *  - no flag: a new thread, registered with its cwd (AC-1.1).\n *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n *  durable id rather than a retained object (AC-1.5). */\nexport async function resolveThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef>> {\n  if (launch.session !== undefined) {\n    const resolved = await threads.resolve({\n      threadId: launch.session,\n      ...registryArg(deps.registryPath),\n    });\n    if (!resolved.ok) return resolved;\n    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n  }\n\n  if (launch.continue === true) {\n    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n    if (!listed.ok) return listed;\n    // The registry lists in creation order with an insertion-order tie-break,\n    // so the last row is the most recently created thread.\n    const mostRecent = listed.value.at(-1);\n    if (mostRecent === undefined) {\n      return {\n        ok: false,\n        error: {\n          errorClass: \"caller_error\",\n          code: \"thread_not_found\",\n          reason: \"--continue: no threads exist to continue\",\n        },\n      };\n    }\n    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n  }\n\n  const created = await threads.newThread({\n    filePath: deps.newThreadFilePath(),\n    cwd: deps.cwd,\n    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n    ...registryArg(deps.registryPath),\n  });\n  if (!created.ok) return created;\n  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n}\n\n/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n *  re-initialized while the same PI session continues — re-resolve the session's\n *  thread from DURABLE registry state. It reads no retained in-process memory and\n *  never creates a new thread or re-prompts a picker; the resolved id comes back\n *  out of the registry (the durable catalog), so reconstruction survives the loss\n *  of every in-memory holder (the architecture-risk scenario).\n *\n *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n *    Both are idempotent — resolving twice returns the same thread and creates\n *    nothing — so the normal resolver already reattaches correctly.\n *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n *    read from the registry. A no-flag Story-1 session created exactly one thread\n *    in its cwd, so that is the thread; re-running the launch instead would create\n *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n *\n *  Returns `null` when the cwd has no thread to reattach (a reload against an\n *  empty registry); the caller records a diagnostic rather than creating one.\n *\n *  This is the answer to \"where does the durable reload id live without a\n *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n *  the system of record, not in a connector field or a recovery sidecar. The\n *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n *  reload/fork lineage is LHC thread metadata (Feature 2+). */\nexport async function resolveReloadThread(\n  launch: LaunchFlags,\n  deps: ResolveDeps,\n): Promise<OpResult<ThreadRef | null>> {\n  if (launch.session !== undefined) {\n    return resolveThread({ session: launch.session }, deps);\n  }\n  if (launch.continue === true) {\n    return resolveThread({ continue: true }, deps);\n  }\n  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n  if (!listed.ok) return listed;\n  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n  // the most recently created thread for this directory.\n  const mostRecent = listed.value.at(-1);\n  if (mostRecent === undefined) return { ok: true, value: null };\n  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n}\n\n/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n *  so PI's launch arguments are visible on `process.argv`; this is the\n *  production source of the launch mode. Supports `--session <id>`,\n *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n *  spelling for the named-session mode is an integration detail to confirm\n *  against PI; see the story payload's open questions.) */\nexport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n  const flags: LaunchFlags = {};\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === undefined) continue;\n    if (arg === \"--resume\" || arg === \"-r\") {\n      flags.resume = true;\n    } else if (arg === \"--continue\" || arg === \"-c\") {\n      flags.continue = true;\n    } else if (arg === \"--session\") {\n      const next = argv[i + 1];\n      if (next !== undefined && !next.startsWith(\"-\")) {\n        flags.session = next;\n        i += 1;\n      }\n    } else if (arg.startsWith(\"--session=\")) {\n      flags.session = arg.slice(\"--session=\".length);\n    }\n  }\n  return flags;\n}\n","numLines":177,"startLine":1,"totalLines":177}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ba0e41ee499e486980000735","type":"tool_result","content":"1\timport {\n2\t  createSdk,\n3\t  inspect,\n4\t  intakeStream,\n5\t  messages,\n6\t  turns,\n7\t  type DerivationProvider,\n8\t  type EventRecord,\n9\t  type InspectOverview,\n10\t  type MessageEventInput,\n11\t  type MessageRecord,\n12\t  type OpResult,\n13\t  type ProviderResult,\n14\t  type ThreadRef,\n15\t  type TurnRecord,\n16\t} from \"lhc\";\n17\timport type { AgentMessage } from \"../pi/types.js\";\n18\timport type { LhcInstance } from \"../shared/instance.js\";\n19\timport { capture, captureGap } from \"../capture/converter.js\";\n20\timport { mapMessage, type MapCtx } from \"../capture/map-message.js\";\n21\timport { TurnAccumulator } from \"../capture/turn-accumulator.js\";\n22\t\n23\t// AC-6.1, AC-6.2 (Flow 6, Story 3). Capture correctness is proven WITHOUT\n24\t// serving anything to a model: a recorded PI corpus replays through the REAL\n25\t// converter and intake path into a temp thread, and the thread's read-back —\n26\t// events, messages, and turns — is compared to the fixture's expectation. The\n27\t// same corpus replayed twice yields identical read-back because the converter's\n28\t// mapping and the SDK's deterministic ids make replay reproducible.\n29\t//\n30\t// Anti-shim (story §Anti-Shim Requirements): this drives Story 2's converter\n31\t// (`mapMessage` → `TurnAccumulator` → `capture`) exactly as live capture does —\n32\t// it never writes the fixture's expected events to the thread, and it compares\n33\t// events/messages/turns/order, never just counts. inspect's overview/health are\n34\t// the live read-back surfaces a Story-3 test asserts on for AC-6.3.\n35\t\n36\t/** A loaded corpus: synthetic PI source messages (the stand-in until M0\n37\t *  delivers recordings) paired with the expected LHC intake events. Both\n38\t *  `verify/replay` and the corpus fixtures consume this shape. */\n39\texport interface Corpus {\n40\t  name: string;\n41\t  source: AgentMessage[];\n42\t  expected: MessageEventInput[];\n43\t}\n44\t\n45\t/** A structured compare result with a readable diff (tech design §Technical\n46\t *  Notes). `matches` is true only when events, messages, AND turns all line up\n47\t *  with the fixture; `diff` names every divergence when they do not. */\n48\texport interface ReplayResult {\n49\t  matches: boolean;\n50\t  diff?: string;\n51\t}\n52\t\n53\tfunction detail(cause: unknown): string {\n54\t  return cause instanceof Error ? cause.message : String(cause);\n55\t}\n56\t\n57\t/** A construction-valid, fail-closed inference provider — the same observe-only\n58\t *  shape the live Epic-1 session runs on (index.ts). Replay never serves context\n59\t *  to a model, so every derivation operation fails closed (non-retryable) rather\n60\t *  than fabricating derived text; the resulting failed derivations are exactly\n61\t *  what inspect health must surface (AC-6.3), so the harness mirrors production\n62\t *  rather than hiding them behind a succeeding fake. */\n63\tfunction observeOnlyProvider(): DerivationProvider {\n64\t  const notConfigured = (): Promise<ProviderResult> =>\n65\t    Promise.resolve({\n66\t      ok: false,\n67\t      retryable: false,\n68\t      reason: \"pi-lhc replay is observe-only (no inference served)\",\n69\t    });\n70\t  return {\n71\t    smoothPrompt: notConfigured,\n72\t    summarizeToolCall: notConfigured,\n73\t    summarizeToolResult: notConfigured,\n74\t    composeTurnRendering: notConfigured,\n75\t    projectLowerBand: notConfigured,\n76\t    summarizeChunkDetailed: notConfigured,\n77\t    summarizeChunkBrief: notConfigured,\n78\t  };\n79\t}\n80\t\n81\t/** Build a real background LHC instance against the temp thread. The converter\n82\t *  writes through `instance.sdk.intakeStream`, and `dispose` drains settled so\n83\t *  background derivations reach a terminal state before read-back — the same\n84\t *  flush-on-dispose contract the lifecycle instance uses, rebuilt here because\n85\t *  `verify` may not import `lifecycle` (boundary rule 3). */\n86\tfunction buildReplayInstance(threadRef: ThreadRef): LhcInstance {\n87\t  const sdk = createSdk({ provider: observeOnlyProvider(), mode: \"background\" });\n88\t  return {\n89\t    sdk,\n90\t    threadRef,\n91\t    dispose: async (): Promise<OpResult<void>> => {\n92\t      try {\n93\t        await sdk.drainSettled(threadRef);\n94\t      } catch {\n95\t        // Best-effort flush; replay's verdict comes from durable read-back, not\n96\t        // from the drain, and a drain failure must not throw out of verify.\n97\t      }\n98\t      return { ok: true, value: undefined };\n99\t    },\n100\t  };\n101\t}\n102\t\n103\t/** A deterministic per-replay session id derived from the CORPUS, not the\n104\t *  thread: it scopes every idempotency key, so the same corpus replayed into two\n105\t *  different temp threads produces byte-identical keys (AC-6.2), while different\n106\t *  corpora never collide. */\n107\tfunction replaySessionId(corpus: Corpus): string {\n108\t  return `replay:${corpus.name}`;\n109\t}\n110\t\n111\t/** Drive one corpus through the real converter into the thread, reconstructing\n112\t *  the PI hook stream a live session would have fired: each source message is a\n113\t *  `message_end` (mapped + accumulated + flushed), and an `agent_end` closes the\n114\t *  LHC turn at each agent-run boundary — before a fresh user prompt and once at\n115\t *  end-of-stream — so PI's \"a new prompt starts a new run\" shows up as exactly\n116\t *  one `turn_end` per run (AC-2.2 semantics, exercised end to end here). */\n117\tasync function driveCorpus(corpus: Corpus, instance: LhcInstance): Promise<void> {\n118\t  const piSessionId = replaySessionId(corpus);\n119\t  const accumulator = new TurnAccumulator({ piSessionId });\n120\t\n121\t  for (const [index, message] of corpus.source.entries()) {\n122\t    // A new user prompt with a turn already open means the previous agent run\n123\t    // ended: close it first (agent_end), then record the prompt that opens the\n124\t    // next run.\n125\t    if (message.role === \"user\" && accumulator.hasOpenTurn()) {\n126\t      await flush(accumulator.onAgentEnd(), instance);\n127\t    }\n128\t\n129\t    // Real recorded PI message_end always carries a stable entry id; the\n130\t    // synthetic corpora omit it, so stamp a deterministic per-message id so the\n131\t    // converter keys off its Tier-1 path exactly as production does.\n132\t    const mapCtx: MapCtx = { piSessionId, entryId: `${piSessionId}:entry:${index}` };\n133\t    let events: MessageEventInput[];\n134\t    try {\n135\t      events = mapMessage(message, mapCtx);\n136\t    } catch (cause) {\n137\t      // An unmappable source message degrades to a durable, queryable gap —\n138\t      // never a thrown replay (mirrors index.ts's capture-failure isolation).\n139\t      await captureGap(`${piSessionId}:entry:${index}`, `replay map failed: ${detail(cause)}`, instance);\n140\t      continue;\n141\t    }\n142\t    accumulator.onMessage(events);\n143\t    await flush(events, instance);\n144\t  }\n145\t\n146\t  // Close the final open turn (the last agent run's agent_end).\n147\t  await flush(accumulator.onAgentEnd(), instance);\n148\t}\n149\t\n150\tasync function flush(events: MessageEventInput[], instance: LhcInstance): Promise<void> {\n151\t  if (events.length === 0) return;\n152\t  await capture(events, instance);\n153\t}\n154\t\n155\t/** Strip the server-stamped order/timestamp so the comparison is over the\n156\t *  logical intake shape the converter produced — including the real, stable\n157\t *  idempotency keys (kept so AC-6.2's determinism is checkable on the read-back),\n158\t *  excluding `recordedAt` (a wall-clock value that legitimately differs run to\n159\t *  run). */\n160\tfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n161\t  return records.map(\n162\t    (record) =>\n163\t      ({\n164\t        eventKind: record.eventKind,\n165\t        idempotencyKey: record.idempotencyKey,\n166\t        actor: record.actor,\n167\t        harness: record.harness,\n168\t        payload: record.payload,\n169\t      }) as MessageEventInput,\n170\t  );\n171\t}\n172\t\n173\t/** Order-independent canonical JSON for value comparison: object keys sorted\n174\t *  recursively so two structurally-equal payloads built in different key orders\n175\t *  compare equal. */\n176\tfunction canonical(value: unknown): string {\n177\t  return JSON.stringify(sortKeys(value));\n178\t}\n179\t\n180\tfunction sortKeys(value: unknown): unknown {\n181\t  if (Array.isArray(value)) return value.map(sortKeys);\n182\t  if (value !== null && typeof value === \"object\") {\n183\t    const out: Record<string, unknown> = {};\n184\t    for (const key of Object.keys(value as Record<string, unknown>).sort()) {\n185\t      out[key] = sortKeys((value as Record<string, unknown>)[key]);\n186\t    }\n187\t    return out;\n188\t  }\n189\t  return value;\n190\t}\n191\t\n192\tinterface MessageProjection {\n193\t  visible: number;\n194\t  byKind: Record<string, number>;\n195\t}\n196\t\n197\ttype ComparableMessageRecord = Pick<\n198\t  MessageRecord,\n199\t  \"messageId\" | \"sourceEventOrder\" | \"kind\" | \"blocks\" | \"harness\" | \"turnId\"\n200\t>;\n201\t\n202\ttype ComparableTurnRecord = Pick<\n203\t  TurnRecord,\n204\t  \"turnId\" | \"status\" | \"memberMessageIds\" | \"openedAtEventOrder\" | \"closedAtEventOrder\"\n205\t>;\n206\t\n207\t/** The message read-back the fixture implies: each non-`turn_end` event projects\n208\t *  to exactly one message of its kind (LHC's projection, verified 1:1), so the\n209\t *  expected `messages.visible` and `messages.byKind` fall straight out of the\n210\t *  expected event list. */\n211\tfunction expectedMessages(expected: readonly MessageEventInput[]): MessageProjection {\n212\t  const byKind: Record<string, number> = {};\n213\t  let visible = 0;\n214\t  for (const event of expected) {\n215\t    if (event.eventKind === \"turn_end\") continue;\n216\t    byKind[event.eventKind] = (byKind[event.eventKind] ?? 0) + 1;\n217\t    visible += 1;\n218\t  }\n219\t  return { visible, byKind };\n220\t}\n221\t\n222\tfunction expectedMessageRecords(expected: readonly MessageEventInput[]): ComparableMessageRecord[] {\n223\t  const records: ComparableMessageRecord[] = [];\n224\t  let openTurnId: string | undefined;\n225\t  let nextTurnOrder = 1;\n226\t\n227\t  for (const [index, event] of expected.entries()) {\n228\t    const sourceEventOrder = index + 1;\n229\t    if (event.eventKind === \"user_prompt\") {\n230\t      openTurnId = `t${nextTurnOrder}`;\n231\t      nextTurnOrder += 1;\n232\t    } else if (event.eventKind === \"turn_end\") {\n233\t      openTurnId = undefined;\n234\t      continue;\n235\t    }\n236\t\n237\t    records.push({\n238\t      messageId: `m${sourceEventOrder}`,\n239\t      sourceEventOrder,\n240\t      kind: event.eventKind,\n241\t      harness: event.harness,\n242\t      ...(openTurnId === undefined ? {} : { turnId: openTurnId }),\n243\t      blocks: expectedBlocks(event),\n244\t    });\n245\t  }\n246\t\n247\t  return records;\n248\t}\n249\t\n250\tfunction expectedBlocks(event: MessageEventInput): MessageRecord[\"blocks\"] {\n251\t  switch (event.eventKind) {\n252\t    case \"user_prompt\":\n253\t    case \"assistant_text\":\n254\t    case \"assistant_thinking\":\n255\t    case \"runtime_note\":\n256\t      return [{ blockType: \"text\", content: { text: event.payload.text } }];\n257\t    case \"tool_call\":\n258\t      return [\n259\t        {\n260\t          blockType: \"tool_call\",\n261\t          content: {\n262\t            toolCallId: event.payload.toolCallId,\n263\t            toolName: event.payload.toolName,\n264\t            arguments: event.payload.arguments,\n265\t          },\n266\t        },\n267\t      ];\n268\t    case \"tool_result\":\n269\t      return [\n270\t        {\n271\t          blockType: \"tool_result\",\n272\t          content: {\n273\t            toolCallId: event.payload.toolCallId,\n274\t            content: event.payload.content,\n275\t            isError: event.payload.isError ?? false,\n276\t          },\n277\t        },\n278\t      ];\n279\t    case \"turn_end\":\n280\t      return [];\n281\t  }\n282\t}\n283\t\n284\tfunction comparableMessageRecords(records: readonly MessageRecord[]): ComparableMessageRecord[] {\n285\t  return records.map((record) => ({\n286\t    messageId: record.messageId,\n287\t    sourceEventOrder: record.sourceEventOrder,\n288\t    kind: record.kind,\n289\t    blocks: record.blocks,\n290\t    harness: record.harness,\n291\t    ...(record.turnId === undefined ? {} : { turnId: record.turnId }),\n292\t  }));\n293\t}\n294\t\n295\tfunction expectedTurnRecords(expected: readonly MessageEventInput[]): ComparableTurnRecord[] {\n296\t  const records: ComparableTurnRecord[] = [];\n297\t  let openTurn: ComparableTurnRecord | undefined;\n298\t\n299\t  for (const [index, event] of expected.entries()) {\n300\t    const eventOrder = index + 1;\n301\t    if (event.eventKind === \"user_prompt\") {\n302\t      if (openTurn !== undefined) {\n303\t        openTurn.status = \"closed\";\n304\t        openTurn.closedAtEventOrder = eventOrder;\n305\t      }\n306\t      openTurn = {\n307\t        turnId: `t${records.length + 1}`,\n308\t        status: \"open\",\n309\t        memberMessageIds: [],\n310\t        openedAtEventOrder: eventOrder,\n311\t      };\n312\t      records.push(openTurn);\n313\t    } else if (event.eventKind === \"turn_end\") {\n314\t      if (openTurn !== undefined) {\n315\t        openTurn.status = \"closed\";\n316\t        openTurn.closedAtEventOrder = eventOrder;\n317\t        openTurn = undefined;\n318\t      }\n319\t      continue;\n320\t    }\n321\t\n322\t    if (openTurn !== undefined) {\n323\t      openTurn.memberMessageIds.push(`m${eventOrder}`);\n324\t    }\n325\t  }\n326\t\n327\t  return records;\n328\t}\n329\t\n330\tfunction comparableTurnRecords(records: readonly TurnRecord[]): ComparableTurnRecord[] {\n331\t  return records.map((record) => ({\n332\t    turnId: record.turnId,\n333\t    status: record.status,\n334\t    memberMessageIds: record.memberMessageIds,\n335\t    openedAtEventOrder: record.openedAtEventOrder,\n336\t    ...(record.closedAtEventOrder === undefined ? {} : { closedAtEventOrder: record.closedAtEventOrder }),\n337\t  }));\n338\t}\n339\t\n340\t/** Compare the actual read-back (events, plus messages/turns from inspect\n341\t *  overview) to the fixture's expectation, accumulating a readable diff. Returns\n342\t *  `null` on a full match. */\n343\tfunction compareReadback(\n344\t  corpus: Corpus,\n345\t  actual: readonly MessageEventInput[],\n346\t  overview: InspectOverview,\n347\t  actualMessages: readonly MessageRecord[],\n348\t  actualTurns: readonly TurnRecord[],\n349\t): string[] {\n350\t  const problems: string[] = [];\n351\t  const expected = corpus.expected;\n352\t\n353\t  // Events — kind + payload, in source-event order (never counts alone).\n354\t  if (actual.length !== expected.length) {\n355\t    problems.push(`events.count: expected ${expected.length}, got ${actual.length}`);\n356\t  }\n357\t  for (let i = 0; i < Math.max(actual.length, expected.length); i += 1) {\n358\t    const want = expected[i];\n359\t    const got = actual[i];\n360\t    if (want === undefined) {\n361\t      problems.push(`events[${i}]: unexpected extra ${got?.eventKind} ${canonical(got?.payload)}`);\n362\t      continue;\n363\t    }\n364\t    if (got === undefined) {\n365\t      problems.push(`events[${i}]: missing expected ${want.eventKind} ${canonical(want.payload)}`);\n366\t      continue;\n367\t    }\n368\t    if (got.eventKind !== want.eventKind) {\n369\t      problems.push(`events[${i}].kind: expected ${want.eventKind}, got ${got.eventKind}`);\n370\t    } else if (canonical(got.payload) !== canonical(want.payload)) {\n371\t      problems.push(\n372\t        `events[${i}].payload (${want.eventKind}): expected ${canonical(want.payload)}, got ${canonical(got.payload)}`,\n373\t      );\n374\t    }\n375\t  }\n376\t\n377\t  // Messages — projected counts by kind.\n378\t  const expectedMsgs = expectedMessages(expected);\n379\t  if (overview.messages.visible !== expectedMsgs.visible) {\n380\t    problems.push(`messages.visible: expected ${expectedMsgs.visible}, got ${overview.messages.visible}`);\n381\t  }\n382\t  if (canonical(overview.messages.byKind) !== canonical(expectedMsgs.byKind)) {\n383\t    problems.push(\n384\t      `messages.byKind: expected ${canonical(expectedMsgs.byKind)}, got ${canonical(overview.messages.byKind)}`,\n385\t    );\n386\t  }\n387\t\n388\t  // Turns — one closed turn per expected `turn_end`, none left open.\n389\t  const expectedClosed = expected.filter((event) => event.eventKind === \"turn_end\").length;\n390\t  if (overview.turns.closed !== expectedClosed) {\n391\t    problems.push(`turns.closed: expected ${expectedClosed}, got ${overview.turns.closed}`);\n392\t  }\n393\t  if (overview.turns.open !== 0) {\n394\t    problems.push(`turns.open: expected 0, got ${overview.turns.open}`);\n395\t  }\n396\t\n397\t  // Messages — full read-back records implied by the fixture, in source order.\n398\t  const expectedMessageRows = expectedMessageRecords(expected);\n399\t  const actualMessageRows = comparableMessageRecords(actualMessages);\n400\t  if (canonical(actualMessageRows) !== canonical(expectedMessageRows)) {\n401\t    problems.push(\n402\t      `messages.records: expected ${canonical(expectedMessageRows)}, got ${canonical(actualMessageRows)}`,\n403\t    );\n404\t  }\n405\t\n406\t  // Turns — full read-back records implied by fixture event boundaries.\n407\t  const expectedTurnRows = expectedTurnRecords(expected);\n408\t  const actualTurnRows = comparableTurnRecords(actualTurns);\n409\t  if (canonical(actualTurnRows) !== canonical(expectedTurnRows)) {\n410\t    problems.push(`turns.records: expected ${canonical(expectedTurnRows)}, got ${canonical(actualTurnRows)}`);\n411\t  }\n412\t\n413\t  return problems;\n414\t}\n415\t\n416\t/** Replay a recorded corpus through the converter into the temp thread, then\n417\t *  compare the durable read-back (events, messages, turns) to the fixture's\n418\t *  expectation. The thread is left populated so a caller can read inspect's\n419\t *  overview/health off it (AC-6.3). Deterministic: the same corpus yields the\n420\t *  same recorded read-back every time (AC-6.2). */\n421\texport async function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult> {\n422\t  const instance = buildReplayInstance(threadRef);\n423\t  const problems: string[] = [];\n424\t  try {\n425\t    await driveCorpus(corpus, instance);\n426\t  } catch (cause) {\n427\t    problems.push(`replay threw before completion: ${detail(cause)}`);\n428\t  } finally {\n429\t    await instance.dispose();\n430\t  }\n431\t\n432\t  const read = await intakeStream.listEvents(threadRef);\n433\t  if (!read.ok) {\n434\t    return { matches: false, diff: [...problems, `listEvents failed: ${read.error.reason}`].join(\"\\n\") };\n435\t  }\n436\t  const overview = await inspect.overview(threadRef);\n437\t  if (!overview.ok) {\n438\t    return { matches: false, diff: [...problems, `inspect.overview failed: ${overview.error.reason}`].join(\"\\n\") };\n439\t  }\n440\t  const messageReadback = await messages.listMessages(threadRef);\n441\t  if (!messageReadback.ok) {\n442\t    return {\n443\t      matches: false,\n444\t      diff: [...problems, `messages.listMessages failed: ${messageReadback.error.reason}`].join(\"\\n\"),\n445\t    };\n446\t  }\n447\t  const turnReadback = await turns.listTurns(threadRef);\n448\t  if (!turnReadback.ok) {\n449\t    return {\n450\t      matches: false,\n451\t      diff: [...problems, `turns.listTurns failed: ${turnReadback.error.reason}`].join(\"\\n\"),\n452\t    };\n453\t  }\n454\t\n455\t  problems.push(\n456\t    ...compareReadback(corpus, logicalEvents(read.value), overview.value, messageReadback.value, turnReadback.value),\n457\t  );\n458\t  if (problems.length === 0) return { matches: true };\n459\t  return { matches: false, diff: problems.join(\"\\n\") };\n460\t}\n461\t"}]},"parent_tool_use_id":null,"session_id":"a0d8ccb7-eaf7-457e-b1b4-b7920fccc144","uuid":"9a925544-935c-4065-88e1-83dc12c2d4d5","timestamp":"2026-06-14T13:39:07.169Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/verify/replay.ts","content":"import {\n  createSdk,\n  inspect,\n  intakeStream,\n  messages,\n  turns,\n  type DerivationProvider,\n  type EventRecord,\n  type InspectOverview,\n  type MessageEventInput,\n  type MessageRecord,\n  type OpResult,\n  type ProviderResult,\n  type ThreadRef,\n  type TurnRecord,\n} from \"lhc\";\nimport type { AgentMessage } from \"../pi/types.js\";\nimport type { LhcInstance } from \"../shared/instance.js\";\nimport { capture, captureGap } from \"../capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"../capture/map-message.js\";\nimport { TurnAccumulator } from \"../capture/turn-accumulator.js\";\n\n// AC-6.1, AC-6.2 (Flow 6, Story 3). Capture correctness is proven WITHOUT\n// serving anything to a model: a recorded PI corpus replays through the REAL\n// converter and intake path into a temp thread, and the thread's read-back —\n// events, messages, and turns — is compared to the fixture's expectation. The\n// same corpus replayed twice yields identical read-back because the converter's\n// mapping and the SDK's deterministic ids make replay reproducible.\n//\n// Anti-shim (story §Anti-Shim Requirements): this drives Story 2's converter\n// (`mapMessage` → `TurnAccumulator` → `capture`) exactly as live capture does —\n// it never writes the fixture's expected events to the thread, and it compares\n// events/messages/turns/order, never just counts. inspect's overview/health are\n// the live read-back surfaces a Story-3 test asserts on for AC-6.3.\n\n/** A loaded corpus: synthetic PI source messages (the stand-in until M0\n *  delivers recordings) paired with the expected LHC intake events. Both\n *  `verify/replay` and the corpus fixtures consume this shape. */\nexport interface Corpus {\n  name: string;\n  source: AgentMessage[];\n  expected: MessageEventInput[];\n}\n\n/** A structured compare result with a readable diff (tech design §Technical\n *  Notes). `matches` is true only when events, messages, AND turns all line up\n *  with the fixture; `diff` names every divergence when they do not. */\nexport interface ReplayResult {\n  matches: boolean;\n  diff?: string;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n/** A construction-valid, fail-closed inference provider — the same observe-only\n *  shape the live Epic-1 session runs on (index.ts). Replay never serves context\n *  to a model, so every derivation operation fails closed (non-retryable) rather\n *  than fabricating derived text; the resulting failed derivations are exactly\n *  what inspect health must surface (AC-6.3), so the harness mirrors production\n *  rather than hiding them behind a succeeding fake. */\nfunction observeOnlyProvider(): DerivationProvider {\n  const notConfigured = (): Promise<ProviderResult> =>\n    Promise.resolve({\n      ok: false,\n      retryable: false,\n      reason: \"pi-lhc replay is observe-only (no inference served)\",\n    });\n  return {\n    smoothPrompt: notConfigured,\n    summarizeToolCall: notConfigured,\n    summarizeToolResult: notConfigured,\n    composeTurnRendering: notConfigured,\n    projectLowerBand: notConfigured,\n    summarizeChunkDetailed: notConfigured,\n    summarizeChunkBrief: notConfigured,\n  };\n}\n\n/** Build a real background LHC instance against the temp thread. The converter\n *  writes through `instance.sdk.intakeStream`, and `dispose` drains settled so\n *  background derivations reach a terminal state before read-back — the same\n *  flush-on-dispose contract the lifecycle instance uses, rebuilt here because\n *  `verify` may not import `lifecycle` (boundary rule 3). */\nfunction buildReplayInstance(threadRef: ThreadRef): LhcInstance {\n  const sdk = createSdk({ provider: observeOnlyProvider(), mode: \"background\" });\n  return {\n    sdk,\n    threadRef,\n    dispose: async (): Promise<OpResult<void>> => {\n      try {\n        await sdk.drainSettled(threadRef);\n      } catch {\n        // Best-effort flush; replay's verdict comes from durable read-back, not\n        // from the drain, and a drain failure must not throw out of verify.\n      }\n      return { ok: true, value: undefined };\n    },\n  };\n}\n\n/** A deterministic per-replay session id derived from the CORPUS, not the\n *  thread: it scopes every idempotency key, so the same corpus replayed into two\n *  different temp threads produces byte-identical keys (AC-6.2), while different\n *  corpora never collide. */\nfunction replaySessionId(corpus: Corpus): string {\n  return `replay:${corpus.name}`;\n}\n\n/** Drive one corpus through the real converter into the thread, reconstructing\n *  the PI hook stream a live session would have fired: each source message is a\n *  `message_end` (mapped + accumulated + flushed), and an `agent_end` closes the\n *  LHC turn at each agent-run boundary — before a fresh user prompt and once at\n *  end-of-stream — so PI's \"a new prompt starts a new run\" shows up as exactly\n *  one `turn_end` per run (AC-2.2 semantics, exercised end to end here). */\nasync function driveCorpus(corpus: Corpus, instance: LhcInstance): Promise<void> {\n  const piSessionId = replaySessionId(corpus);\n  const accumulator = new TurnAccumulator({ piSessionId });\n\n  for (const [index, message] of corpus.source.entries()) {\n    // A new user prompt with a turn already open means the previous agent run\n    // ended: close it first (agent_end), then record the prompt that opens the\n    // next run.\n    if (message.role === \"user\" && accumulator.hasOpenTurn()) {\n      await flush(accumulator.onAgentEnd(), instance);\n    }\n\n    // Real recorded PI message_end always carries a stable entry id; the\n    // synthetic corpora omit it, so stamp a deterministic per-message id so the\n    // converter keys off its Tier-1 path exactly as production does.\n    const mapCtx: MapCtx = { piSessionId, entryId: `${piSessionId}:entry:${index}` };\n    let events: MessageEventInput[];\n    try {\n      events = mapMessage(message, mapCtx);\n    } catch (cause) {\n      // An unmappable source message degrades to a durable, queryable gap —\n      // never a thrown replay (mirrors index.ts's capture-failure isolation).\n      await captureGap(`${piSessionId}:entry:${index}`, `replay map failed: ${detail(cause)}`, instance);\n      continue;\n    }\n    accumulator.onMessage(events);\n    await flush(events, instance);\n  }\n\n  // Close the final open turn (the last agent run's agent_end).\n  await flush(accumulator.onAgentEnd(), instance);\n}\n\nasync function flush(events: MessageEventInput[], instance: LhcInstance): Promise<void> {\n  if (events.length === 0) return;\n  await capture(events, instance);\n}\n\n/** Strip the server-stamped order/timestamp so the comparison is over the\n *  logical intake shape the converter produced — including the real, stable\n *  idempotency keys (kept so AC-6.2's determinism is checkable on the read-back),\n *  excluding `recordedAt` (a wall-clock value that legitimately differs run to\n *  run). */\nfunction logicalEvents(records: readonly EventRecord[]): MessageEventInput[] {\n  return records.map(\n    (record) =>\n      ({\n        eventKind: record.eventKind,\n        idempotencyKey: record.idempotencyKey,\n        actor: record.actor,\n        harness: record.harness,\n        payload: record.payload,\n      }) as MessageEventInput,\n  );\n}\n\n/** Order-independent canonical JSON for value comparison: object keys sorted\n *  recursively so two structurally-equal payloads built in different key orders\n *  compare equal. */\nfunction canonical(value: unknown): string {\n  return JSON.stringify(sortKeys(value));\n}\n\nfunction sortKeys(value: unknown): unknown {\n  if (Array.isArray(value)) return value.map(sortKeys);\n  if (value !== null && typeof value === \"object\") {\n    const out: Record<string, unknown> = {};\n    for (const key of Object.keys(value as Record<string, unknown>).sort()) {\n      out[key] = sortKeys((value as Record<string, unknown>)[key]);\n    }\n    return out;\n  }\n  return value;\n}\n\ninterface MessageProjection {\n  visible: number;\n  byKind: Record<string, number>;\n}\n\ntype ComparableMessageRecord = Pick<\n  MessageRecord,\n  \"messageId\" | \"sourceEventOrder\" | \"kind\" | \"blocks\" | \"harness\" | \"turnId\"\n>;\n\ntype ComparableTurnRecord = Pick<\n  TurnRecord,\n  \"turnId\" | \"status\" | \"memberMessageIds\" | \"openedAtEventOrder\" | \"closedAtEventOrder\"\n>;\n\n/** The message read-back the fixture implies: each non-`turn_end` event projects\n *  to exactly one message of its kind (LHC's projection, verified 1:1), so the\n *  expected `messages.visible` and `messages.byKind` fall straight out of the\n *  expected event list. */\nfunction expectedMessages(expected: readonly MessageEventInput[]): MessageProjection {\n  const byKind: Record<string, number> = {};\n  let visible = 0;\n  for (const event of expected) {\n    if (event.eventKind === \"turn_end\") continue;\n    byKind[event.eventKind] = (byKind[event.eventKind] ?? 0) + 1;\n    visible += 1;\n  }\n  return { visible, byKind };\n}\n\nfunction expectedMessageRecords(expected: readonly MessageEventInput[]): ComparableMessageRecord[] {\n  const records: ComparableMessageRecord[] = [];\n  let openTurnId: string | undefined;\n  let nextTurnOrder = 1;\n\n  for (const [index, event] of expected.entries()) {\n    const sourceEventOrder = index + 1;\n    if (event.eventKind === \"user_prompt\") {\n      openTurnId = `t${nextTurnOrder}`;\n      nextTurnOrder += 1;\n    } else if (event.eventKind === \"turn_end\") {\n      openTurnId = undefined;\n      continue;\n    }\n\n    records.push({\n      messageId: `m${sourceEventOrder}`,\n      sourceEventOrder,\n      kind: event.eventKind,\n      harness: event.harness,\n      ...(openTurnId === undefined ? {} : { turnId: openTurnId }),\n      blocks: expectedBlocks(event),\n    });\n  }\n\n  return records;\n}\n\nfunction expectedBlocks(event: MessageEventInput): MessageRecord[\"blocks\"] {\n  switch (event.eventKind) {\n    case \"user_prompt\":\n    case \"assistant_text\":\n    case \"assistant_thinking\":\n    case \"runtime_note\":\n      return [{ blockType: \"text\", content: { text: event.payload.text } }];\n    case \"tool_call\":\n      return [\n        {\n          blockType: \"tool_call\",\n          content: {\n            toolCallId: event.payload.toolCallId,\n            toolName: event.payload.toolName,\n            arguments: event.payload.arguments,\n          },\n        },\n      ];\n    case \"tool_result\":\n      return [\n        {\n          blockType: \"tool_result\",\n          content: {\n            toolCallId: event.payload.toolCallId,\n            content: event.payload.content,\n            isError: event.payload.isError ?? false,\n          },\n        },\n      ];\n    case \"turn_end\":\n      return [];\n  }\n}\n\nfunction comparableMessageRecords(records: readonly MessageRecord[]): ComparableMessageRecord[] {\n  return records.map((record) => ({\n    messageId: record.messageId,\n    sourceEventOrder: record.sourceEventOrder,\n    kind: record.kind,\n    blocks: record.blocks,\n    harness: record.harness,\n    ...(record.turnId === undefined ? {} : { turnId: record.turnId }),\n  }));\n}\n\nfunction expectedTurnRecords(expected: readonly MessageEventInput[]): ComparableTurnRecord[] {\n  const records: ComparableTurnRecord[] = [];\n  let openTurn: ComparableTurnRecord | undefined;\n\n  for (const [index, event] of expected.entries()) {\n    const eventOrder = index + 1;\n    if (event.eventKind === \"user_prompt\") {\n      if (openTurn !== undefined) {\n        openTurn.status = \"closed\";\n        openTurn.closedAtEventOrder = eventOrder;\n      }\n      openTurn = {\n        turnId: `t${records.length + 1}`,\n        status: \"open\",\n        memberMessageIds: [],\n        openedAtEventOrder: eventOrder,\n      };\n      records.push(openTurn);\n    } else if (event.eventKind === \"turn_end\") {\n      if (openTurn !== undefined) {\n        openTurn.status = \"closed\";\n        openTurn.closedAtEventOrder = eventOrder;\n        openTurn = undefined;\n      }\n      continue;\n    }\n\n    if (openTurn !== undefined) {\n      openTurn.memberMessageIds.push(`m${eventOrder}`);\n    }\n  }\n\n  return records;\n}\n\nfunction comparableTurnRecords(records: readonly TurnRecord[]): ComparableTurnRecord[] {\n  return records.map((record) => ({\n    turnId: record.turnId,\n    status: record.status,\n    memberMessageIds: record.memberMessageIds,\n    openedAtEventOrder: record.openedAtEventOrder,\n    ...(record.closedAtEventOrder === undefined ? {} : { closedAtEventOrder: record.closedAtEventOrder }),\n  }));\n}\n\n/** Compare the actual read-back (events, plus messages/turns from inspect\n *  overview) to the fixture's expectation, accumulating a readable diff. Returns\n *  `null` on a full match. */\nfunction compareReadback(\n  corpus: Corpus,\n  actual: readonly MessageEventInput[],\n  overview: InspectOverview,\n  actualMessages: readonly MessageRecord[],\n  actualTurns: readonly TurnRecord[],\n): string[] {\n  const problems: string[] = [];\n  const expected = corpus.expected;\n\n  // Events — kind + payload, in source-event order (never counts alone).\n  if (actual.length !== expected.length) {\n    problems.push(`events.count: expected ${expected.length}, got ${actual.length}`);\n  }\n  for (let i = 0; i < Math.max(actual.length, expected.length); i += 1) {\n    const want = expected[i];\n    const got = actual[i];\n    if (want === undefined) {\n      problems.push(`events[${i}]: unexpected extra ${got?.eventKind} ${canonical(got?.payload)}`);\n      continue;\n    }\n    if (got === undefined) {\n      problems.push(`events[${i}]: missing expected ${want.eventKind} ${canonical(want.payload)}`);\n      continue;\n    }\n    if (got.eventKind !== want.eventKind) {\n      problems.push(`events[${i}].kind: expected ${want.eventKind}, got ${got.eventKind}`);\n    } else if (canonical(got.payload) !== canonical(want.payload)) {\n      problems.push(\n        `events[${i}].payload (${want.eventKind}): expected ${canonical(want.payload)}, got ${canonical(got.payload)}`,\n      );\n    }\n  }\n\n  // Messages — projected counts by kind.\n  const expectedMsgs = expectedMessages(expected);\n  if (overview.messages.visible !== expectedMsgs.visible) {\n    problems.push(`messages.visible: expected ${expectedMsgs.visible}, got ${overview.messages.visible}`);\n  }\n  if (canonical(overview.messages.byKind) !== canonical(expectedMsgs.byKind)) {\n    problems.push(\n      `messages.byKind: expected ${canonical(expectedMsgs.byKind)}, got ${canonical(overview.messages.byKind)}`,\n    );\n  }\n\n  // Turns — one closed turn per expected `turn_end`, none left open.\n  const expectedClosed = expected.filter((event) => event.eventKind === \"turn_end\").length;\n  if (overview.turns.closed !== expectedClosed) {\n    problems.push(`turns.closed: expected ${expectedClosed}, got ${overview.turns.closed}`);\n  }\n  if (overview.turns.open !== 0) {\n    problems.push(`turns.open: expected 0, got ${overview.turns.open}`);\n  }\n\n  // Messages — full read-back records implied by the fixture, in source order.\n  const expectedMessageRows = expectedMessageRecords(expected);\n  const actualMessageRows = comparableMessageRecords(actualMessages);\n  if (canonical(actualMessageRows) !== canonical(expectedMessageRows)) {\n    problems.push(\n      `messages.records: expected ${canonical(expectedMessageRows)}, got ${canonical(actualMessageRows)}`,\n    );\n  }\n\n  // Turns — full read-back records implied by fixture event boundaries.\n  const expectedTurnRows = expectedTurnRecords(expected);\n  const actualTurnRows = comparableTurnRecords(actualTurns);\n  if (canonical(actualTurnRows) !== canonical(expectedTurnRows)) {\n    problems.push(`turns.records: expected ${canonical(expectedTurnRows)}, got ${canonical(actualTurnRows)}`);\n  }\n\n  return problems;\n}\n\n/** Replay a recorded corpus through the converter into the temp thread, then\n *  compare the durable read-back (events, messages, turns) to the fixture's\n *  expectation. The thread is left populated so a caller can read inspect's\n *  overview/health off it (AC-6.3). Deterministic: the same corpus yields the\n *  same recorded read-back every time (AC-6.2). */\nexport async function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult> {\n  const instance = buildReplayInstance(threadRef);\n  const problems: string[] = [];\n  try {\n    await driveCorpus(corpus, instance);\n  } catch (cause) {\n    problems.push(`replay threw before completion: ${detail(cause)}`);\n  } finally {\n    await instance.dispose();\n  }\n\n  const read = await intakeStream.listEvents(threadRef);\n  if (!read.ok) {\n    return { matches: false, diff: [...problems, `listEvents failed: ${read.error.reason}`].join(\"\\n\") };\n  }\n  const overview = await inspect.overview(threadRef);\n  if (!overview.ok) {\n    return { matches: false, diff: [...problems, `inspect.overview failed: ${overview.error.reason}`].join(\"\\n\") };\n  }\n  const messageReadback = await messages.listMessages(threadRef);\n  if (!messageReadback.ok) {\n    return {\n      matches: false,\n      diff: [...problems, `messages.listMessages failed: ${messageReadback.error.reason}`].join(\"\\n\"),\n    };\n  }\n  const turnReadback = await turns.listTurns(threadRef);\n  if (!turnReadback.ok) {\n    return {\n      matches: false,\n      diff: [...problems, `turns.listTurns failed: ${turnReadback.error.reason}`].join(\"\\n\"),\n    };\n  }\n\n  problems.push(\n    ...compareReadback(corpus, logicalEvents(read.value), overview.value, messageReadback.value, turnReadback.value),\n  );\n  if (problems.length === 0) return { matches: true };\n  return { matches: false, diff: problems.join(\"\\n\") };\n}\n","numLines":461,"startLine":1,"totalLines":461}}}

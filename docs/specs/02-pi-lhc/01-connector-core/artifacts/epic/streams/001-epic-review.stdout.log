{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c03c328f6275449e8532f023","type":"tool_result","content":"1\t// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n2\t// never writes the source (tech design Flow 3). Story 4.\n3\t\n4\timport { readFileSync } from \"node:fs\";\n5\timport type { MessageEventInput, OpResult, ThreadRef } from \"lhc\";\n6\timport type { ExtensionContext, SessionStartEvent } from \"../pi/types.js\";\n7\timport type { LhcInstance } from \"../shared/instance.js\";\n8\t\n9\texport interface ForkInfo {\n10\t  sourceThreadRef: ThreadRef;\n11\t  forkEntryId: string;\n12\t}\n13\t\n14\t/** Detect a fork from PI's session tree when the session_before_fork hook is\n15\t *  absent (Epic 1 fallback evidence). This function is called during\n16\t *  session_start when we have a previousSessionFile but no pending fork from the\n17\t *  hook. Returns fork info if the session tree indicates a fork, null otherwise.\n18\t *\n19\t * The fallback uses the previousSessionFile as evidence that we're starting a\n20\t *  new session after an existing one (the fork pattern). The fork point is\n21\t *  inferred as the end of the previous session. */\n22\texport function detectForkFromSessionTree(\n23\t  ctx: ExtensionContext,\n24\t  event: SessionStartEvent,\n25\t  sourceThreadRef: ThreadRef,\n26\t): ForkInfo | null {\n27\t  if (!event.previousSessionFile) return null;\n28\t\n29\t  const previousEntries = readSessionEntries(event.previousSessionFile);\n30\t  const previousIds = new Set(previousEntries.map(entryIdOf).filter((id): id is string => id !== null));\n31\t  if (previousIds.size === 0) return null;\n32\t\n33\t  const currentEntries = ctx.sessionManager.getEntries();\n34\t  const sharedCurrentEntry = lastEntryMatching(currentEntries, (entry) => {\n35\t    const id = entryIdOf(entry);\n36\t    return id !== null && previousIds.has(id);\n37\t  });\n38\t  if (sharedCurrentEntry !== null) {\n39\t    return { sourceThreadRef, forkEntryId: sharedCurrentEntry };\n40\t  }\n41\t\n42\t  const parentLink = firstEntryMatching(currentEntries, (entry) => {\n43\t    const parentId = stringField(entry, \"parentId\");\n44\t    return parentId !== null && previousIds.has(parentId);\n45\t  });\n46\t  if (parentLink !== null) {\n47\t    return { sourceThreadRef, forkEntryId: parentLink };\n48\t  }\n49\t\n50\t  return null;\n51\t}\n52\t\n53\tfunction stringField(record: { readonly [k: string]: unknown }, field: string): string | null {\n54\t  const value = record[field];\n55\t  return typeof value === \"string\" && value !== \"\" ? value : null;\n56\t}\n57\t\n58\tfunction entryIdOf(entry: { readonly [k: string]: unknown }): string | null {\n59\t  return stringField(entry, \"id\") ?? stringField(entry, \"entryId\");\n60\t}\n61\t\n62\tfunction lastEntryMatching(\n63\t  entries: readonly { readonly [k: string]: unknown }[],\n64\t  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n65\t): string | null {\n66\t  for (let index = entries.length - 1; index >= 0; index -= 1) {\n67\t    const entry = entries[index];\n68\t    if (entry === undefined || !matches(entry)) continue;\n69\t    return entryIdOf(entry);\n70\t  }\n71\t  return null;\n72\t}\n73\t\n74\tfunction firstEntryMatching(\n75\t  entries: readonly { readonly [k: string]: unknown }[],\n76\t  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n77\t): string | null {\n78\t  for (const entry of entries) {\n79\t    if (!matches(entry)) continue;\n80\t    const parentId = stringField(entry, \"parentId\");\n81\t    if (parentId !== null) return parentId;\n82\t  }\n83\t  return null;\n84\t}\n85\t\n86\tfunction readSessionEntries(filePath: string): { readonly [k: string]: unknown }[] {\n87\t  let contents: string;\n88\t  try {\n89\t    contents = readFileSync(filePath, \"utf8\");\n90\t  } catch {\n91\t    return [];\n92\t  }\n93\t\n94\t  const entries: { readonly [k: string]: unknown }[] = [];\n95\t  for (const line of contents.trim().split(\"\\n\")) {\n96\t    if (line.trim() === \"\") continue;\n97\t    try {\n98\t      const parsed = JSON.parse(line) as unknown;\n99\t      if (typeof parsed !== \"object\" || parsed === null) continue;\n100\t      const entry = parsed as { readonly [k: string]: unknown };\n101\t      if (entry.type === \"session\") continue;\n102\t      entries.push(entry);\n103\t    } catch {\n104\t      continue;\n105\t    }\n106\t  }\n107\t  return entries;\n108\t}\n109\t\n110\t/** Extract fork info from a `session_before_fork` hook payload. The hook\n111\t *  provides `entryId` and optional `position` identifying the fork point. */\n112\texport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n113\t  return { forkEntryId: entryId };\n114\t}\n115\t\n116\t/** Seed a forked thread by replaying the source's recorded events up to the\n117\t *  fork point, through the normal intake path. The source receives NO writes\n118\t *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n119\t *\n120\t * Replay reads events from the source thread, filters to those up to and\n121\t * including the fork point (by entryId match on idempotency key), and writes\n122\t * them through the instance's intake path. This preserves event order, dedup\n123\t * keys, and all logical content — the seeded thread's read-back matches the\n124\t * source's read-back through the fork point (AC-3.2).\n125\t *\n126\t * The forkEntryId is PI's entry identifier for the session entry at the fork\n127\t * point. During capture, this entryId was encoded into idempotency keys as\n128\t * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n129\t * contain this entryId in their key (any piSessionId, any block/kind), then\n130\t * include all events up to and including the turn_end that closes the turn at\n131\t * the fork point. */\n132\texport async function seedFork(\n133\t  source: ThreadRef,\n134\t  target: ThreadRef,\n135\t  forkEntryId: string,\n136\t  instance: LhcInstance,\n137\t): Promise<OpResult<void>> {\n138\t  const { intakeStream } = instance.sdk;\n139\t\n140\t  // Read all events from the source thread.\n141\t  const events = await intakeStream.listEvents(source);\n142\t  if (!events.ok) {\n143\t    return {\n144\t      ok: false,\n145\t      error: {\n146\t        errorClass: events.error.errorClass,\n147\t        code: events.error.code,\n148\t        reason: `fork source read failed: ${events.error.reason}`,\n149\t      },\n150\t    };\n151\t  }\n152\t\n153\t  // Find the fork point event(s) by entryId match. The entryId appears in the\n154\t  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n155\t  // key contains `:${forkEntryId}:` regardless of piSessionId.\n156\t  const forkPointEvents = events.value.filter((event) =>\n157\t    event.idempotencyKey.includes(`:${forkEntryId}:`),\n158\t  );\n159\t\n160\t  if (forkPointEvents.length === 0) {\n161\t    return {\n162\t      ok: false,\n163\t      error: {\n164\t        errorClass: \"caller_error\",\n165\t        code: \"thread_not_found\",\n166\t        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n167\t      },\n168\t    };\n169\t  }\n170\t\n171\t  // Use the maximum eventOrder among fork point events as the initial cutoff.\n172\t  // This ensures we include all events (including fan-out) at the fork point.\n173\t  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n174\t\n175\t  // Include the turn_end that closes the turn at the fork point.\n176\t  // turn_end events don't have entryId in their key (they're generated by\n177\t  // the connector), so we need to include the first turn_end after maxOrder.\n178\t  const turnEndAfter = events.value.find(\n179\t    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n180\t  );\n181\t  if (turnEndAfter !== undefined) {\n182\t    maxOrder = turnEndAfter.eventOrder;\n183\t  }\n184\t\n185\t  // Filter to events up to and including the fork point (including turn_end).\n186\t  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n187\t\n188\t  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n189\t  // Each event preserves its discriminated eventKind by construction from the\n190\t  // recorded EventRecord, which carries the exact eventKind that was written.\n191\t  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n192\t    (record) =>\n193\t      ({\n194\t        eventKind: record.eventKind,\n195\t        idempotencyKey: record.idempotencyKey,\n196\t        actor: record.actor,\n197\t        harness: record.harness,\n198\t        payload: record.payload,\n199\t      }) as MessageEventInput,\n200\t  );\n201\t\n202\t  // Replay through the normal intake path into the target thread.\n203\t  // This uses the same capture converter path, preserving all semantics.\n204\t  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n205\t  if (!result.ok) {\n206\t    return {\n207\t      ok: false,\n208\t      error: {\n209\t        errorClass: result.error.errorClass,\n210\t        code: result.error.code,\n211\t        reason: `fork replay failed: ${result.error.reason}`,\n212\t      },\n213\t    };\n214\t  }\n215\t\n216\t  return { ok: true, value: undefined };\n217\t}\n218\t"}]},"parent_tool_use_id":null,"session_id":"a0d8ccb7-eaf7-457e-b1b4-b7920fccc144","uuid":"3dfac49c-377c-4c3f-8ecc-805c5deaadec","timestamp":"2026-06-14T13:38:32.741Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/fork.ts","content":"// AC-3.1, AC-3.2, AC-3.3. A fork produces a NEW thread seeded by replay and\n// never writes the source (tech design Flow 3). Story 4.\n\nimport { readFileSync } from \"node:fs\";\nimport type { MessageEventInput, OpResult, ThreadRef } from \"lhc\";\nimport type { ExtensionContext, SessionStartEvent } from \"../pi/types.js\";\nimport type { LhcInstance } from \"../shared/instance.js\";\n\nexport interface ForkInfo {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** Detect a fork from PI's session tree when the session_before_fork hook is\n *  absent (Epic 1 fallback evidence). This function is called during\n *  session_start when we have a previousSessionFile but no pending fork from the\n *  hook. Returns fork info if the session tree indicates a fork, null otherwise.\n *\n * The fallback uses the previousSessionFile as evidence that we're starting a\n *  new session after an existing one (the fork pattern). The fork point is\n *  inferred as the end of the previous session. */\nexport function detectForkFromSessionTree(\n  ctx: ExtensionContext,\n  event: SessionStartEvent,\n  sourceThreadRef: ThreadRef,\n): ForkInfo | null {\n  if (!event.previousSessionFile) return null;\n\n  const previousEntries = readSessionEntries(event.previousSessionFile);\n  const previousIds = new Set(previousEntries.map(entryIdOf).filter((id): id is string => id !== null));\n  if (previousIds.size === 0) return null;\n\n  const currentEntries = ctx.sessionManager.getEntries();\n  const sharedCurrentEntry = lastEntryMatching(currentEntries, (entry) => {\n    const id = entryIdOf(entry);\n    return id !== null && previousIds.has(id);\n  });\n  if (sharedCurrentEntry !== null) {\n    return { sourceThreadRef, forkEntryId: sharedCurrentEntry };\n  }\n\n  const parentLink = firstEntryMatching(currentEntries, (entry) => {\n    const parentId = stringField(entry, \"parentId\");\n    return parentId !== null && previousIds.has(parentId);\n  });\n  if (parentLink !== null) {\n    return { sourceThreadRef, forkEntryId: parentLink };\n  }\n\n  return null;\n}\n\nfunction stringField(record: { readonly [k: string]: unknown }, field: string): string | null {\n  const value = record[field];\n  return typeof value === \"string\" && value !== \"\" ? value : null;\n}\n\nfunction entryIdOf(entry: { readonly [k: string]: unknown }): string | null {\n  return stringField(entry, \"id\") ?? stringField(entry, \"entryId\");\n}\n\nfunction lastEntryMatching(\n  entries: readonly { readonly [k: string]: unknown }[],\n  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n): string | null {\n  for (let index = entries.length - 1; index >= 0; index -= 1) {\n    const entry = entries[index];\n    if (entry === undefined || !matches(entry)) continue;\n    return entryIdOf(entry);\n  }\n  return null;\n}\n\nfunction firstEntryMatching(\n  entries: readonly { readonly [k: string]: unknown }[],\n  matches: (entry: { readonly [k: string]: unknown }) => boolean,\n): string | null {\n  for (const entry of entries) {\n    if (!matches(entry)) continue;\n    const parentId = stringField(entry, \"parentId\");\n    if (parentId !== null) return parentId;\n  }\n  return null;\n}\n\nfunction readSessionEntries(filePath: string): { readonly [k: string]: unknown }[] {\n  let contents: string;\n  try {\n    contents = readFileSync(filePath, \"utf8\");\n  } catch {\n    return [];\n  }\n\n  const entries: { readonly [k: string]: unknown }[] = [];\n  for (const line of contents.trim().split(\"\\n\")) {\n    if (line.trim() === \"\") continue;\n    try {\n      const parsed = JSON.parse(line) as unknown;\n      if (typeof parsed !== \"object\" || parsed === null) continue;\n      const entry = parsed as { readonly [k: string]: unknown };\n      if (entry.type === \"session\") continue;\n      entries.push(entry);\n    } catch {\n      continue;\n    }\n  }\n  return entries;\n}\n\n/** Extract fork info from a `session_before_fork` hook payload. The hook\n *  provides `entryId` and optional `position` identifying the fork point. */\nexport function forkInfoFromHook(entryId: string, _position?: number): Omit<ForkInfo, \"sourceThreadRef\"> {\n  return { forkEntryId: entryId };\n}\n\n/** Seed a forked thread by replaying the source's recorded events up to the\n *  fork point, through the normal intake path. The source receives NO writes\n *  (AC-3.1). Derived forms requeue rather than copy (AC-3.3).\n *\n * Replay reads events from the source thread, filters to those up to and\n * including the fork point (by entryId match on idempotency key), and writes\n * them through the instance's intake path. This preserves event order, dedup\n * keys, and all logical content — the seeded thread's read-back matches the\n * source's read-back through the fork point (AC-3.2).\n *\n * The forkEntryId is PI's entry identifier for the session entry at the fork\n * point. During capture, this entryId was encoded into idempotency keys as\n * `pi:<piSessionId>:<entryId>:<blockIndex>:<kind>`. We match events that\n * contain this entryId in their key (any piSessionId, any block/kind), then\n * include all events up to and including the turn_end that closes the turn at\n * the fork point. */\nexport async function seedFork(\n  source: ThreadRef,\n  target: ThreadRef,\n  forkEntryId: string,\n  instance: LhcInstance,\n): Promise<OpResult<void>> {\n  const { intakeStream } = instance.sdk;\n\n  // Read all events from the source thread.\n  const events = await intakeStream.listEvents(source);\n  if (!events.ok) {\n    return {\n      ok: false,\n      error: {\n        errorClass: events.error.errorClass,\n        code: events.error.code,\n        reason: `fork source read failed: ${events.error.reason}`,\n      },\n    };\n  }\n\n  // Find the fork point event(s) by entryId match. The entryId appears in the\n  // idempotency key as `:<entryId>:` (Tier 1 format). We match any event whose\n  // key contains `:${forkEntryId}:` regardless of piSessionId.\n  const forkPointEvents = events.value.filter((event) =>\n    event.idempotencyKey.includes(`:${forkEntryId}:`),\n  );\n\n  if (forkPointEvents.length === 0) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"thread_not_found\",\n        reason: `fork entryId ${forkEntryId} not found in source thread events`,\n      },\n    };\n  }\n\n  // Use the maximum eventOrder among fork point events as the initial cutoff.\n  // This ensures we include all events (including fan-out) at the fork point.\n  let maxOrder = Math.max(...forkPointEvents.map((e) => e.eventOrder));\n\n  // Include the turn_end that closes the turn at the fork point.\n  // turn_end events don't have entryId in their key (they're generated by\n  // the connector), so we need to include the first turn_end after maxOrder.\n  const turnEndAfter = events.value.find(\n    (e) => e.eventKind === \"turn_end\" && e.eventOrder > maxOrder,\n  );\n  if (turnEndAfter !== undefined) {\n    maxOrder = turnEndAfter.eventOrder;\n  }\n\n  // Filter to events up to and including the fork point (including turn_end).\n  const eventsUpToFork = events.value.filter((e) => e.eventOrder <= maxOrder);\n\n  // Convert EventRecord back to MessageEventInput for replay (strip server fields).\n  // Each event preserves its discriminated eventKind by construction from the\n  // recorded EventRecord, which carries the exact eventKind that was written.\n  const replayEvents: MessageEventInput[] = eventsUpToFork.map(\n    (record) =>\n      ({\n        eventKind: record.eventKind,\n        idempotencyKey: record.idempotencyKey,\n        actor: record.actor,\n        harness: record.harness,\n        payload: record.payload,\n      }) as MessageEventInput,\n  );\n\n  // Replay through the normal intake path into the target thread.\n  // This uses the same capture converter path, preserving all semantics.\n  const result = await instance.sdk.intakeStream.messageEvents(target, replayEvents);\n  if (!result.ok) {\n    return {\n      ok: false,\n      error: {\n        errorClass: result.error.errorClass,\n        code: result.error.code,\n        reason: `fork replay failed: ${result.error.reason}`,\n      },\n    };\n  }\n\n  return { ok: true, value: undefined };\n}\n","numLines":218,"startLine":1,"totalLines":218}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ec4c09205d0440d6974351f9","type":"tool_result","content":"1\timport {\n2\t  createSdk,\n3\t  threads,\n4\t  type Lhc,\n5\t  type OpResult,\n6\t  type SdkConfig,\n7\t  type ThreadRef,\n8\t} from \"lhc\";\n9\timport type { LhcInstance } from \"../shared/instance.js\";\n10\t\n11\t// AC-1.1, AC-1.4, AC-1.5.\n12\t\n13\t/** The connector's name for SDK construction — the agreed rename of LHC's\n14\t *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n15\t *  either way). One instance per PI session in background scheduler mode; the\n16\t *  connector never drives the queue (Flow 1). */\n17\texport function initLhc(config: SdkConfig): Lhc {\n18\t  return createSdk(config);\n19\t}\n20\t\n21\tfunction detail(cause: unknown): string {\n22\t  return cause instanceof Error ? cause.message : String(cause);\n23\t}\n24\t\n25\t/** Flush-on-dispose: await any pending background derivations for this thread,\n26\t *  then release the instance. Captured intake is already durable (intake writes\n27\t *  commit synchronously), so the flush is about letting in-flight background\n28\t *  work settle before shutdown — never a throw back into a PI hook. */\n29\tasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n30\t  try {\n31\t    await sdk.drainSettled(threadRef);\n32\t  } catch (cause) {\n33\t    return {\n34\t      ok: false,\n35\t      error: {\n36\t        errorClass: \"system_error\",\n37\t        code: \"storage_failure\",\n38\t        reason: `instance dispose flush failed: ${detail(cause)}`,\n39\t      },\n40\t    };\n41\t  }\n42\t  return { ok: true, value: undefined };\n43\t}\n44\t\n45\t/** Construct one LHC instance against a resolved thread in background scheduler\n46\t *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n47\t *  typed result rather than a half-built instance; background mode is forced\n48\t *  regardless of the caller's config so the connector cannot accidentally drive\n49\t *  the queue. A malformed inference/provider config is a programmer error and\n50\t *  throws here per LHC's construction contract — the hook guard in `index.ts`\n51\t *  contains it so nothing reaches the PI session. */\n52\texport async function initInstance(\n53\t  threadRef: ThreadRef,\n54\t  config: SdkConfig,\n55\t): Promise<OpResult<LhcInstance>> {\n56\t  const info = await threads.info(threadRef);\n57\t  if (!info.ok) return info;\n58\t\n59\t  const sdk = initLhc({ ...config, mode: \"background\" });\n60\t  const instance: LhcInstance = {\n61\t    sdk,\n62\t    threadRef,\n63\t    dispose: () => disposeSdk(sdk, threadRef),\n64\t  };\n65\t  return { ok: true, value: instance };\n66\t}\n67\t\n68\t/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n69\t *  shutdown with no live instance is a successful no-op, never an error. */\n70\texport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n71\t  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n72\t  return instance.dispose();\n73\t}\n74\t"}]},"parent_tool_use_id":null,"session_id":"a0d8ccb7-eaf7-457e-b1b4-b7920fccc144","uuid":"bd1954c0-617d-44da-8368-78fd0f0978bb","timestamp":"2026-06-14T13:38:32.742Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/instance.ts","content":"import {\n  createSdk,\n  threads,\n  type Lhc,\n  type OpResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport type { LhcInstance } from \"../shared/instance.js\";\n\n// AC-1.1, AC-1.4, AC-1.5.\n\n/** The connector's name for SDK construction — the agreed rename of LHC's\n *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n *  either way). One instance per PI session in background scheduler mode; the\n *  connector never drives the queue (Flow 1). */\nexport function initLhc(config: SdkConfig): Lhc {\n  return createSdk(config);\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n/** Flush-on-dispose: await any pending background derivations for this thread,\n *  then release the instance. Captured intake is already durable (intake writes\n *  commit synchronously), so the flush is about letting in-flight background\n *  work settle before shutdown — never a throw back into a PI hook. */\nasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n  try {\n    await sdk.drainSettled(threadRef);\n  } catch (cause) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"system_error\",\n        code: \"storage_failure\",\n        reason: `instance dispose flush failed: ${detail(cause)}`,\n      },\n    };\n  }\n  return { ok: true, value: undefined };\n}\n\n/** Construct one LHC instance against a resolved thread in background scheduler\n *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n *  typed result rather than a half-built instance; background mode is forced\n *  regardless of the caller's config so the connector cannot accidentally drive\n *  the queue. A malformed inference/provider config is a programmer error and\n *  throws here per LHC's construction contract — the hook guard in `index.ts`\n *  contains it so nothing reaches the PI session. */\nexport async function initInstance(\n  threadRef: ThreadRef,\n  config: SdkConfig,\n): Promise<OpResult<LhcInstance>> {\n  const info = await threads.info(threadRef);\n  if (!info.ok) return info;\n\n  const sdk = initLhc({ ...config, mode: \"background\" });\n  const instance: LhcInstance = {\n    sdk,\n    threadRef,\n    dispose: () => disposeSdk(sdk, threadRef),\n  };\n  return { ok: true, value: instance };\n}\n\n/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n *  shutdown with no live instance is a successful no-op, never an error. */\nexport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n  return instance.dispose();\n}\n","numLines":74,"startLine":1,"totalLines":74}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c6b306b1f6b44c139385990b","type":"tool_result","content":"1\timport type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\n2\timport type { LhcInstance } from \"../shared/instance.js\";\n3\timport { fingerprint } from \"./idempotency.js\";\n4\t\n5\t// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\n6\t// isolating capture failure so it never throws back into a PI hook. The two\n7\t// failure shapes the AC distinguishes key off the SDK's error code:\n8\t//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\n9\t//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\n10\t//     dropped, then surface the original failure so the caller marks the gap.\n11\t//   - anything else (thread store unavailable): no durable gap is possible —\n12\t//     surface the failure for the caller to route to an extension health\n13\t//     signal. Either way the session continues.\n14\t//\n15\t// The map → accumulate orchestration runs in the composition root (index.ts),\n16\t// which routes this function's structured result into SessionState.health;\n17\t// capture itself stays boundary-pure (lhc + shared only).\n18\t\n19\tfunction detail(cause: unknown): string {\n20\t  return cause instanceof Error ? cause.message : String(cause);\n21\t}\n22\t\n23\t/** messageEvents returns OpResults for operational failures, but a thread file\n24\t *  in a genuinely broken state could still throw — contain that too, so capture\n25\t *  is total. */\n26\tasync function flushIsolated(\n27\t  instance: LhcInstance,\n28\t  events: readonly MessageEventInput[],\n29\t): Promise<OpResult<BatchResult>> {\n30\t  try {\n31\t    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\n32\t  } catch (cause) {\n33\t    return {\n34\t      ok: false,\n35\t      error: {\n36\t        errorClass: \"system_error\",\n37\t        code: \"storage_failure\",\n38\t        reason: `capture flush threw: ${detail(cause)}`,\n39\t      },\n40\t    };\n41\t  }\n42\t}\n43\t\n44\t/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\n45\t *  rides an existing intake kind (no new kind) and surfaces in the event log.\n46\t *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\n47\t *  bad batch dedups the gap rather than piling up duplicates. */\n48\tfunction gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\n49\t  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\n50\t  return {\n51\t    eventKind: \"runtime_note\",\n52\t    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\n53\t    actor: \"system\",\n54\t    harness: \"pi\",\n55\t    payload: { text },\n56\t  };\n57\t}\n58\t\n59\tfunction syntheticGapNote(discriminator: string, reason: string): MessageEventInput {\n60\t  const text = `capture gap: unmappable PI hook input rejected — ${reason}`;\n61\t  return {\n62\t    eventKind: \"runtime_note\",\n63\t    idempotencyKey: `pi-lhc:gap:${fingerprint(discriminator, reason)}`,\n64\t    actor: \"system\",\n65\t    harness: \"pi\",\n66\t    payload: { text },\n67\t  };\n68\t}\n69\t\n70\texport async function capture(\n71\t  events: MessageEventInput[],\n72\t  instance: LhcInstance,\n73\t): Promise<OpResult<BatchResult>> {\n74\t  const primary = await flushIsolated(instance, events);\n75\t  if (primary.ok) return primary;\n76\t\n77\t  if (primary.error.code === \"invalid_event\") {\n78\t    // Writable thread, malformed event: never drop — record a durable gap.\n79\t    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\n80\t    // If the gap write itself fails, the store went unavailable: surface that\n81\t    // (no durable gap was recorded) so the caller routes it to health.\n82\t    if (!gap.ok) return gap;\n83\t    return primary;\n84\t  }\n85\t\n86\t  // Store unavailable / other: no durable gap is possible.\n87\t  return primary;\n88\t}\n89\t\n90\texport async function captureGap(\n91\t  discriminator: string,\n92\t  reason: string,\n93\t  instance: LhcInstance,\n94\t): Promise<OpResult<BatchResult>> {\n95\t  return flushIsolated(instance, [syntheticGapNote(discriminator, reason)]);\n96\t}\n97\t"}]},"parent_tool_use_id":null,"session_id":"a0d8ccb7-eaf7-457e-b1b4-b7920fccc144","uuid":"0cf36cad-13ca-4c37-aea0-311809f2d6a8","timestamp":"2026-06-14T13:38:32.742Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/converter.ts","content":"import type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\nimport type { LhcInstance } from \"../shared/instance.js\";\nimport { fingerprint } from \"./idempotency.js\";\n\n// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\n// isolating capture failure so it never throws back into a PI hook. The two\n// failure shapes the AC distinguishes key off the SDK's error code:\n//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\n//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\n//     dropped, then surface the original failure so the caller marks the gap.\n//   - anything else (thread store unavailable): no durable gap is possible —\n//     surface the failure for the caller to route to an extension health\n//     signal. Either way the session continues.\n//\n// The map → accumulate orchestration runs in the composition root (index.ts),\n// which routes this function's structured result into SessionState.health;\n// capture itself stays boundary-pure (lhc + shared only).\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n/** messageEvents returns OpResults for operational failures, but a thread file\n *  in a genuinely broken state could still throw — contain that too, so capture\n *  is total. */\nasync function flushIsolated(\n  instance: LhcInstance,\n  events: readonly MessageEventInput[],\n): Promise<OpResult<BatchResult>> {\n  try {\n    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\n  } catch (cause) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"system_error\",\n        code: \"storage_failure\",\n        reason: `capture flush threw: ${detail(cause)}`,\n      },\n    };\n  }\n}\n\n/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\n *  rides an existing intake kind (no new kind) and surfaces in the event log.\n *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\n *  bad batch dedups the gap rather than piling up duplicates. */\nfunction gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\n  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\n  return {\n    eventKind: \"runtime_note\",\n    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\n    actor: \"system\",\n    harness: \"pi\",\n    payload: { text },\n  };\n}\n\nfunction syntheticGapNote(discriminator: string, reason: string): MessageEventInput {\n  const text = `capture gap: unmappable PI hook input rejected — ${reason}`;\n  return {\n    eventKind: \"runtime_note\",\n    idempotencyKey: `pi-lhc:gap:${fingerprint(discriminator, reason)}`,\n    actor: \"system\",\n    harness: \"pi\",\n    payload: { text },\n  };\n}\n\nexport async function capture(\n  events: MessageEventInput[],\n  instance: LhcInstance,\n): Promise<OpResult<BatchResult>> {\n  const primary = await flushIsolated(instance, events);\n  if (primary.ok) return primary;\n\n  if (primary.error.code === \"invalid_event\") {\n    // Writable thread, malformed event: never drop — record a durable gap.\n    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\n    // If the gap write itself fails, the store went unavailable: surface that\n    // (no durable gap was recorded) so the caller routes it to health.\n    if (!gap.ok) return gap;\n    return primary;\n  }\n\n  // Store unavailable / other: no durable gap is possible.\n  return primary;\n}\n\nexport async function captureGap(\n  discriminator: string,\n  reason: string,\n  instance: LhcInstance,\n): Promise<OpResult<BatchResult>> {\n  return flushIsolated(instance, [syntheticGapNote(discriminator, reason)]);\n}\n","numLines":97,"startLine":1,"totalLines":97}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8c81371f6599487cac97212e","type":"tool_result","content":"1\t// AC-4.1..4.4. The host-supplied ModelCall function.\n2\t//\n3\t// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n4\t// a production-valid boundary, and classifies failures into the LHC contract.\n5\t// Provider/model are opaque routing keys — the connector does not interpret them.\n6\t//\n7\t// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n8\t// registry and completes through @earendil-works/pi-ai when that package is\n9\t// available in the host runtime. If the runtime does not provide pi-ai, the host\n10\t// returns a classified failure; it never fabricates completion text.\n11\t//\n12\t// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n13\t// @earendil-works/pi-ai (package not yet available).\n14\t\n15\timport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\n16\timport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\n17\timport type { PiAiComplete } from \"./pi-ai.js\";\n18\t\n19\tinterface ModelCallDeps {\n20\t  complete?: PiAiComplete;\n21\t}\n22\t\n23\t/** Extract the text content from an AssistantMessage-like shape. */\n24\tfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n25\t  const content = message.content ?? [];\n26\t  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n27\t  return textParts.map((part) => part.text as string).join(\"\\n\");\n28\t}\n29\t\n30\t/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n31\t *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n32\t *  thrown → other). */\n33\texport function classifyFailure(err: unknown): ModelCallFailureKind {\n34\t  // Guard: non-object errors fall through to \"other\"\n35\t  if (typeof err !== \"object\" || err === null) {\n36\t    return \"other\";\n37\t  }\n38\t\n39\t  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n40\t  const code = errorLike.code?.toLowerCase() ?? \"\";\n41\t  const type = errorLike.type?.toLowerCase() ?? \"\";\n42\t  const message = errorLike.message?.toLowerCase() ?? \"\";\n43\t\n44\t  // Check for auth failures (terminal)\n45\t  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n46\t  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n47\t    return \"auth\";\n48\t  }\n49\t\n50\t  // Check for invalid request (terminal)\n51\t  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n52\t  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n53\t    return \"invalid_request\";\n54\t  }\n55\t\n56\t  // Check for rate limit (retryable)\n57\t  const rateLimitPatterns = [\"rate\", \"429\"];\n58\t  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n59\t    return \"rate_limit\";\n60\t  }\n61\t\n62\t  // Check for timeout (retryable)\n63\t  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n64\t  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n65\t    return \"timeout\";\n66\t  }\n67\t\n68\t  // Check for network errors (retryable)\n69\t  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n70\t  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n71\t    return \"network\";\n72\t  }\n73\t\n74\t  // Default for unknown errors\n75\t  return \"other\";\n76\t}\n77\t\n78\tasync function importPiAiComplete(): Promise<PiAiComplete> {\n79\t  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n80\t    specifier: string,\n81\t  ) => Promise<unknown>;\n82\t  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n83\t  const complete = (loaded as { complete?: unknown }).complete;\n84\t  if (typeof complete !== \"function\") {\n85\t    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n86\t      code: \"invalid_request\",\n87\t    });\n88\t  }\n89\t  return complete as PiAiComplete;\n90\t}\n91\t\n92\t/**\n93\t * Production ModelCall implementation using PI's model registry and pi-ai.\n94\t *\n95\t * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n96\t * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n97\t * when the host runtime provides it.\n98\t */\n99\texport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n100\t  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n101\t    // Resolve the model through PI's registry\n102\t    const resolved = ctx.modelRegistry.find(provider, model);\n103\t    if (resolved === undefined) {\n104\t      // Unknown model - treat as invalid request (terminal)\n105\t      return {\n106\t        ok: false,\n107\t        kind: \"invalid_request\",\n108\t        message: `Model not found in registry: ${provider}/${model}`,\n109\t      };\n110\t    }\n111\t\n112\t    // Check if auth is configured\n113\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n114\t      // No auth - treat as auth failure (terminal)\n115\t      return {\n116\t        ok: false,\n117\t        kind: \"auth\",\n118\t        message: `No configured auth for model: ${provider}/${model}`,\n119\t      };\n120\t    }\n121\t\n122\t    // Complete through pi-ai. Tests may inject this seam; production loads the\n123\t    // host package at runtime so pi-lhc does not publish fabricated text when\n124\t    // the host dependency is absent.\n125\t    try {\n126\t      const complete = deps.complete ?? await importPiAiComplete();\n127\t      const response = await complete(resolved, { messages });\n128\t\n129\t      // Extract text from the response\n130\t      const text = extractAssistantText(response);\n131\t\n132\t      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n133\t      // empty_output is classified by LHC's adapter, not by the host function.\n134\t      // The host function returns text-or-failure only, even if the text is empty.\n135\t      return { ok: true, text };\n136\t    } catch (err) {\n137\t      // Classify the error into a ModelCallFailureKind\n138\t      const kind = classifyFailure(err);\n139\t      const message = err instanceof Error ? err.message : String(err);\n140\t      return { ok: false, kind, message };\n141\t    }\n142\t  };\n143\t}\n144\t\n145\t/**\n146\t * Default assignments for all seven FormKinds.\n147\t *\n148\t * Story 6 implements config loading; these defaults use a real PI registry\n149\t * lane, so the shipped production path can resolve through createModelCall().\n150\t */\n151\t// PI v0.79.2 ships openai-codex/gpt-5.4 in its built-in catalog and records it\n152\t// as the default openai-codex model (pi-coding-agent CHANGELOG: GPT-5.4 support\n153\t// across openai/openai-codex, with gpt-5.4 now the default). This is the\n154\t// production-reachable dial-in default Story 6 requires; unavailable auth is\n155\t// still reported by startup validation rather than hidden behind a test provider.\n156\texport const DEFAULT_PI_MODEL = { provider: \"openai-codex\", id: \"gpt-5.4\" } as const;\n157\t\n158\texport function defaultAssignments(\n159\t  model: { provider: string; id: string } = DEFAULT_PI_MODEL,\n160\t): Record<string, { provider: string; model: string; prompt: string }> {\n161\t  return {\n162\t    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n163\t    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n164\t    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n165\t    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n166\t    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n167\t    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n168\t    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n169\t  };\n170\t}\n171\t"}]},"parent_tool_use_id":null,"session_id":"a0d8ccb7-eaf7-457e-b1b4-b7920fccc144","uuid":"407487a8-1f23-47b4-b91d-1b5f041d6b9d","timestamp":"2026-06-14T13:38:32.743Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts","content":"// AC-4.1..4.4. The host-supplied ModelCall function.\n//\n// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n// a production-valid boundary, and classifies failures into the LHC contract.\n// Provider/model are opaque routing keys — the connector does not interpret them.\n//\n// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n// registry and completes through @earendil-works/pi-ai when that package is\n// available in the host runtime. If the runtime does not provide pi-ai, the host\n// returns a classified failure; it never fabricates completion text.\n//\n// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n// @earendil-works/pi-ai (package not yet available).\n\nimport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\nimport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\nimport type { PiAiComplete } from \"./pi-ai.js\";\n\ninterface ModelCallDeps {\n  complete?: PiAiComplete;\n}\n\n/** Extract the text content from an AssistantMessage-like shape. */\nfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n  const content = message.content ?? [];\n  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n  return textParts.map((part) => part.text as string).join(\"\\n\");\n}\n\n/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n *  thrown → other). */\nexport function classifyFailure(err: unknown): ModelCallFailureKind {\n  // Guard: non-object errors fall through to \"other\"\n  if (typeof err !== \"object\" || err === null) {\n    return \"other\";\n  }\n\n  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n  const code = errorLike.code?.toLowerCase() ?? \"\";\n  const type = errorLike.type?.toLowerCase() ?? \"\";\n  const message = errorLike.message?.toLowerCase() ?? \"\";\n\n  // Check for auth failures (terminal)\n  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"auth\";\n  }\n\n  // Check for invalid request (terminal)\n  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"invalid_request\";\n  }\n\n  // Check for rate limit (retryable)\n  const rateLimitPatterns = [\"rate\", \"429\"];\n  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"rate_limit\";\n  }\n\n  // Check for timeout (retryable)\n  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"timeout\";\n  }\n\n  // Check for network errors (retryable)\n  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"network\";\n  }\n\n  // Default for unknown errors\n  return \"other\";\n}\n\nasync function importPiAiComplete(): Promise<PiAiComplete> {\n  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n    specifier: string,\n  ) => Promise<unknown>;\n  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n  const complete = (loaded as { complete?: unknown }).complete;\n  if (typeof complete !== \"function\") {\n    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n      code: \"invalid_request\",\n    });\n  }\n  return complete as PiAiComplete;\n}\n\n/**\n * Production ModelCall implementation using PI's model registry and pi-ai.\n *\n * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n * when the host runtime provides it.\n */\nexport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n    // Resolve the model through PI's registry\n    const resolved = ctx.modelRegistry.find(provider, model);\n    if (resolved === undefined) {\n      // Unknown model - treat as invalid request (terminal)\n      return {\n        ok: false,\n        kind: \"invalid_request\",\n        message: `Model not found in registry: ${provider}/${model}`,\n      };\n    }\n\n    // Check if auth is configured\n    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n      // No auth - treat as auth failure (terminal)\n      return {\n        ok: false,\n        kind: \"auth\",\n        message: `No configured auth for model: ${provider}/${model}`,\n      };\n    }\n\n    // Complete through pi-ai. Tests may inject this seam; production loads the\n    // host package at runtime so pi-lhc does not publish fabricated text when\n    // the host dependency is absent.\n    try {\n      const complete = deps.complete ?? await importPiAiComplete();\n      const response = await complete(resolved, { messages });\n\n      // Extract text from the response\n      const text = extractAssistantText(response);\n\n      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n      // empty_output is classified by LHC's adapter, not by the host function.\n      // The host function returns text-or-failure only, even if the text is empty.\n      return { ok: true, text };\n    } catch (err) {\n      // Classify the error into a ModelCallFailureKind\n      const kind = classifyFailure(err);\n      const message = err instanceof Error ? err.message : String(err);\n      return { ok: false, kind, message };\n    }\n  };\n}\n\n/**\n * Default assignments for all seven FormKinds.\n *\n * Story 6 implements config loading; these defaults use a real PI registry\n * lane, so the shipped production path can resolve through createModelCall().\n */\n// PI v0.79.2 ships openai-codex/gpt-5.4 in its built-in catalog and records it\n// as the default openai-codex model (pi-coding-agent CHANGELOG: GPT-5.4 support\n// across openai/openai-codex, with gpt-5.4 now the default). This is the\n// production-reachable dial-in default Story 6 requires; unavailable auth is\n// still reported by startup validation rather than hidden behind a test provider.\nexport const DEFAULT_PI_MODEL = { provider: \"openai-codex\", id: \"gpt-5.4\" } as const;\n\nexport function defaultAssignments(\n  model: { provider: string; id: string } = DEFAULT_PI_MODEL,\n): Record<string, { provider: string; model: string; prompt: string }> {\n  return {\n    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n  };\n}\n","numLines":171,"startLine":1,"totalLines":171}}}

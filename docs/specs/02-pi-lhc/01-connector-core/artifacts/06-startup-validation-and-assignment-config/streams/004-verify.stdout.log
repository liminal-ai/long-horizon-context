 280\t\n   281\t      const state: SessionState = {\n   282\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   283\t        flags: { startupValidationReported: false },\n   284\t        health: {},\n   285\t      };\n   286\t\n   287\t      report(validationReport, ctx, state);\n   288\t\n   289\t      // Health should contain the structured report\n   290\t      expect(state.health.startupValidation).toBeDefined();\n   291\t      expect(state.health.startupValidation?.unreachable).toHaveLength(2); // 2 kinds configured with unknown provider/model\n   292\t\n   293\t      // Each unreachable lane is classified with reason and fix\n   294\t      const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n   295\t      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n   296\t      expect(smoothEntry?.fix).toBeDefined();\n   297\t\n   298\t      // Queryable - callers can read health to determine which lanes are affected\n   299\t      const affectedKinds = state.health.startupValidation?.unreachable.map((e) => e.kind);\n   300\t      expect(affectedKinds).toContain(\"smoothed_prompt\");\n   301\t      expect(affectedKinds).toContain(\"tool_call_summary\");\n   302\t    });\n   303\t\n   304\t    it(\"validation does not break the session - state remains functional\", () => {\n   305\t      const ctx = createMockContext();\n","exit_code":0,"status":"completed"}}

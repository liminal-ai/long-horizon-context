{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/startup-validation.ts | sed -n '80,116p'\"","aggregated_output":"    80\t *  - Always persist the structured ValidationReport to SessionState.health.\n    81\t *  - Capture continues running even when validation fails (AC-5.3).\n    82\t *\n    83\t *  This function never throws; validation failures are diagnostic, not fatal.\n    84\t *  The affected lane's derivations will fail classified and queryable through\n    85\t *  health (AC-5.3), but the session itself remains functional for capture. */\n    86\texport function report(\n    87\t  r: ValidationReport,\n    88\t  ctx: ExtensionContext,\n    89\t  state: SessionState,\n    90\t): void {\n    91\t  // Persist the structured report to SessionState.health (always, even in headless)\n    92\t  state.health.startupValidation = r;\n    93\t\n    94\t  // Mark that we've reported startup validation (avoids duplicate reporting)\n    95\t  state.flags.startupValidationReported = true;\n    96\t\n    97\t  // If there are unreachable lanes, surface them through ctx.ui when available\n    98\t  if (r.unreachable.length > 0) {\n    99\t    const lines = [\n   100\t      \"pi-lhc startup validation: unreachable derivation lanes\",\n   101\t      \"\",\n   102\t      ...r.unreachable.map(\n   103\t        (u) =>\n   104\t          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n   105\t      ),\n   106\t      \"\",\n   107\t      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n   108\t    ];\n   109\t\n   110\t    const message = lines.join(\"\\n\");\n   111\t\n   112\t    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n   113\t    if (ctx.hasUI) {\n   114\t      ctx.ui.notify(message, { level: \"warn\" });\n   115\t    }\n   116\t  }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/assignments.ts | sed -n '60,155p'\"","aggregated_output":"    60\t/** Check if an assignment is complete (has provider, model, and prompt). */\n    61\tfunction isComplete(assignment: Partial<ModelAssignment>): assignment is ModelAssignment {\n    62\t  return (\n    63\t    assignment.provider !== undefined &&\n    64\t    assignment.model !== undefined &&\n    65\t    assignment.prompt !== undefined\n    66\t  );\n    67\t}\n    68\t\n    69\t/** Check if an assignment contains placeholder values that would mask misconfiguration. */\n    70\tfunction hasPlaceholder(assignment: ModelAssignment): boolean {\n    71\t  const placeholderPatterns = [\n    72\t    \"unconfigured\",\n    73\t    \"placeholder\",\n    74\t    \"example\",\n    75\t    \"your-\",\n    76\t    \"your_provider\",\n    77\t    \"your-model\",\n    78\t    \"your_model\",\n    79\t  ];\n    80\t  const providerLower = assignment.provider.toLowerCase();\n    81\t  const modelLower = assignment.model.toLowerCase();\n    82\t\n    83\t  return placeholderPatterns.some((pattern) =>\n    84\t    providerLower.includes(pattern) || modelLower.includes(pattern)\n    85\t  );\n    86\t}\n    87\t\n    88\t/** Check if a prompt name is registered in LHC's prompt registry. */\n    89\tfunction isPromptRegistered(promptName: string): boolean {\n    90\t  return Object.values(DEFAULT_PROMPT_NAMES).includes(promptName);\n    91\t}\n    92\t\n    93\t/** Validate a single assignment and throw if it fails shape checks. */\n    94\tfunction validateAssignment(kind: FormKind, assignment: ModelAssignment): void {\n    95\t  // Check for placeholder values (AC-5.6: placeholder fails loud)\n    96\t  if (hasPlaceholder(assignment)) {\n    97\t    throw new AssignmentValidationError(kind, \"placeholder\");\n    98\t  }\n    99\t\n   100\t  // Check that the prompt is registered (AC-5.4: prompt must name a registered prompt)\n   101\t  if (!isPromptRegistered(assignment.prompt)) {\n   102\t    throw new AssignmentValidationError(kind, \"unknown_prompt\");\n   103\t  }\n   104\t}\n   105\t\n   106\t/** Load + shape-validate the seven derivation assignments from operator config.\n   107\t *\n   108\t *  - Merges operator config over shipped defaults (AC-5.4).\n   109\t *  - Falls back to defaults when config is missing or undefined (AC-5.4).\n   110\t *  - User overrides take effect on next session start with no code change (AC-5.5).\n   111\t *  - Incomplete assignments fail loud at initialization (AC-5.5, TC-5.6).\n   112\t *  - Unknown prompts fail loud at initialization (TC-5.6).\n   113\t *  - Placeholder values fail loud at initialization (TC-5.6).\n   114\t *\n   115\t *  This function throws `AssignmentValidationError` on any validation failure;\n   116\t *  the caller (typically the session_start hook) catches and surfaces the error\n   117\t *  as an actionable diagnostic. It never returns an incomplete or placeholder map\n   118\t *  that would mask a misconfiguration (story §Anti-Shim Requirements). */\n   119\texport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n   120\t  // Start with shipped defaults (all seven kinds with concrete assignments)\n   121\t  const baseAssignments = defaultAssignments();\n   122\t\n   123\t  // If config is missing/null/undefined, use defaults as-is\n   124\t  if (config === null || config === undefined || typeof config !== \"object\") {\n   125\t    return baseAssignments as Record<FormKind, ModelAssignment>;\n   126\t  }\n   127\t\n   128\t  const configObj = config as Partial<Record<FormKind, Partial<ModelAssignment>>>;\n   129\t  const mergedAssignments: Partial<Record<FormKind, ModelAssignment>> = { ...baseAssignments };\n   130\t\n   131\t  // Merge operator config over defaults for kinds that are specified\n   132\t  for (const kind of FORM_KINDS) {\n   133\t    const override = configObj[kind as FormKind];\n   134\t    if (override !== undefined) {\n   135\t      // If override is provided, it must specify all three fields (provider, model, prompt).\n   136\t      // Partial overrides are not allowed to avoid masking misconfiguration with placeholder defaults.\n   137\t      // If you want to use defaults, don't specify that kind in the config.\n   138\t      if (override.provider === undefined || override.model === undefined || override.prompt === undefined) {\n   139\t        throw new AssignmentValidationError(kind, \"incomplete\");\n   140\t      }\n   141\t\n   142\t      // At this point, all fields are present - cast to ModelAssignment\n   143\t      const completeOverride = override as ModelAssignment;\n   144\t\n   145\t      // Validate the override for placeholders and unknown prompts\n   146\t      validateAssignment(kind, completeOverride);\n   147\t\n   148\t      // Use the override (all fields are present and validated)\n   149\t      mergedAssignments[kind as FormKind] = completeOverride;\n   150\t    }\n   151\t  }\n   152\t\n   153\t  // At this point we have validated all seven kinds (FORM_KINDS covers all seven)\n   154\t  return mergedAssignments as Record<FormKind, ModelAssignment>;\n   155\t}\n","exit_code":0,"status":"completed"}}

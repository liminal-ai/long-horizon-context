assignment-config/story-lead/001-events.jsonl\npackages/pi-lhc/src/lifecycle/instance.ts\npackages/pi-lhc/src/lifecycle/picker.ts\npackages/pi-lhc/src/lifecycle/thread-resolution.ts\npackages/pi-lhc/src/lifecycle/fork.ts\npackages/pi-lhc/src/lifecycle/state.ts\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/story-lead/progress/001-story-lead.status.json\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/story-lead/progress/001-story-lead.progress.jsonl\npackages/pi-lhc/src/verify/replay.ts\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/streams/004-verify.stdout.log\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/streams/003-implementor.stdout.log\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/streams/004-verify.stderr.log\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/streams/003-implementor.stderr.log\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/001-story-validate.json\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/003-implementor.json\npackages/pi-lhc/src/capture/idempotency.ts\npackages/pi-lhc/src/capture/converter.ts\npackages/pi-lhc/src/capture/map-message.ts\npackages/pi-lhc/src/capture/runtime-changes.ts\npackages/pi-lhc/src/capture/turn-accumulator.ts\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/progress/004-verify.status.json\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/progress/003-implementor.progress.jsonl\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/progress/004-verify.progress.jsonl\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-
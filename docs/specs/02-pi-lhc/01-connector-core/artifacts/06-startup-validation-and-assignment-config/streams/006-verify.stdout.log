{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/model-call.ts | sed -n '95,120p'\"","aggregated_output":"    95\t * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n    96\t * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n    97\t * when the host runtime provides it.\n    98\t */\n    99\texport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n   100\t  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n   101\t    // Resolve the model through PI's registry\n   102\t    const resolved = ctx.modelRegistry.find(provider, model);\n   103\t    if (resolved === undefined) {\n   104\t      // Unknown model - treat as invalid request (terminal)\n   105\t      return {\n   106\t        ok: false,\n   107\t        kind: \"invalid_request\",\n   108\t        message: `Model not found in registry: ${provider}/${model}`,\n   109\t      };\n   110\t    }\n   111\t\n   112\t    // Check if auth is configured\n   113\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n   114\t      // No auth - treat as auth failure (terminal)\n   115\t      return {\n   116\t        ok: false,\n   117\t        kind: \"auth\",\n   118\t        message: `No configured auth for model: ${provider}/${model}`,\n   119\t      };\n   120\t    }\n","exit_code":0,"status":"completed"}}

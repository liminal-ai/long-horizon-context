en available\", () => {\n   193\t      const ctx = createMockContext(undefined, undefined, false);\n   194\t      ctx.hasUI = true; // UI available\n   195\t      const notifySpy = vi.fn();\n   196\t      ctx.ui.notify = notifySpy;\n   197\t\n   198\t      const assignments = createAssignments({\n   199\t        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   200\t      });\n   201\t\n   202\t      const validationReport = validateReachable(assignments, ctx);\n   203\t\n   204\t      const state: SessionState = {\n   205\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n   206\t        flags: { startupValidationReported: false },\n   207\t        health: {},\n   208\t      };\n   209\t\n   210\t      report(validationReport, ctx, state);\n   211\t\n   212\t      // State should have the report persisted with the same unreachable lanes.\n   213\t      expect(state.health.startupValidation?.unreachable).toBe(validationReport.unreachable);\n   214\t      expect(state.health.startupValidation?.message).toContain(\"unreachable derivation lanes\");\n   215\t      expect(state.flags.startupValidationReported).toBe(true);\n   216\t\n   217\t      // UI should be notified with a formatted report\n   218\t      expect(notifySpy).toHaveBeenCalledTimes(1);\n   219\t      const notifyMessage = (notifySpy.mock.calls[0]?.[0] ?? \"\") as string;\n   220\t      expect(notifyMessage).toContain(\"unreachable derivation lanes\");\n   221\t      expect(notifyMessage).toContain(\"smoothed_prompt\");\n   222\t      expect(notifyMessage).toContain(\"unknown\");\n   223\t    });\n   224\t\n   225\t    it(\"report includes formatted message with all unreachable lanes\", () => {\n   272\t      // State should remain intact for capture to continue\n   273\t      expect(\"filePath\" in state.threadRef ? state.threadRef.filePath : undefined).toBe(\"/test/thread.sqlite\");\n   274\t      expect(state.flags.startupValidationReported).toBe(true);\n   275\t    });\n   276\t\n   277\t    it(\"affected lane derivations fail classified and queryable through health\", async () => {\n   278\t      const store = tempStore();\n   279\t      try {\n   280\t        // Create a context where one model is available and another is not\n   281\t        const models: ModelHandle[] = [{ provider: \"openai\", id: \"gpt-4o\" }];\n   282\t        const ctx: ExtensionContext = {\n   283\t          cwd: \"/test/startup-validation\",\n   284\t          hasUI: false,\n   285\t          modelRegistry: {\n   286\t            // Only openai/gpt-4o is available; unknown/unknown will be unreachable\n   287\t            find: (provider: string, model: string) =>\n   288\t              provider === \"openai\" && model === \"gpt-4o\" ? { provider, id: model } : undefined,\n   289\t            hasConfiguredAuth: (handle) => typeof handle !== \"string\" && handle.provider === \"openai\",\n   290\t            getAvailable: () => models,\n   291\t          },\n   292\t          ui: { notify: () => {} },\n   293\t          sessionManager: { getEntries: () => [] },\n   294\t        };\n   295\t\n   296\t        // Create assignments with one reachable and one unreachable lane\n   297\t        const assignments = createAssignments({\n   298\t          smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   299\t          tool_call_summary: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   300\t          tool_result_summary: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   301\t          turn_rendering: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   302\t          lower_band_projection: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   303\t          chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   304\t          chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   305\t        });\n   306\t\n   307\t        // Build SDK config with these assignments\n   308\t        const { createConnector: createConn } = await import(\"../../src/index.js\");\n   309\t        const { makeUserMessage, makeAssistantMessage, makeAgentEnd } = await import(\"../fixtures/synthetic.js\");\n   310\t\n   311\t        const sdkConfig: SdkConfig = {\n   312\t          inference: {\n   313\t            call: fakeModelCallRouter(\n   314\t              { \"openai/gpt-4o\": fakeModelCallText(\"reachable derivation\") },\n   315\t              fakeModelCallFailure(\"invalid_request\", \"unreachable assignment lane\"),\n   316\t            ),\n   317\t            assignments,\n   318\t          },\n   319\t          mode: \"background\",\n   320\t        };\n   321\t\n   322\t        const connector = createConn({\n   323\t          registryPath: store.registryPath,\n   324\t          newThreadFilePath: () => store.threadPath(),\n   325\t          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n   326\t        });\n   327\t\n   328\t        // Start session - validation runs and reports unreachable lane\n   329\t        await connector.handlers.session_start(ctx, { reason: \"new\" });\n   330\t        const instance = connector.getInstance();\n   331\t        const state = connector.getState();\n   332\t\n   333\t        expect(instance).not.toBeNull();\n   334\t        expect(state).not.toBeNull();\n   335\t        if (instance === null || state === null) return;\n   336\t\n   337\t        // Verify validation reported the unreachable lane (smoothed_prompt)\n   338\t        expect(state.health.startupValidation).toBeDefined();\n   339\t        expect(state.health.startupValidation?.unreachable.length).toBeGreaterThan(0);\n   340\t        const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n   341\t        expect(smoothEntry?.reason).toBe(\"unknown_model\");\n   342\t\n   343\t        // Capture continues despite validation failure\n   344\t        await connector.handlers.message_end(ctx, {\n   345\t          message: makeUserMessage(\"test prompt\"),\n   346\t          entryId: \"test-user\",\n   347\t        });\n   348\t        await connector.handlers.message_end(ctx, {\n   349\t          message: makeAssistantMessage({ text: \"test response\" }),\n   350\t          entryId: \"test-assistant\",\n   351\t        });\n   352\t        await connector.handlers.agent_end(ctx, {\n   353\t          messages: [makeUserMessage(\"test prompt\"), makeAssistantMessage({ text: \"test response\" })],\n   354\t        });\n   355\t\n   356\t        // Drain the scheduler to run derivations\n   357\t        const threadRef = state.threadRef;\n   358\t        await instance.sdk.drainSettled(threadRef);\n   359\t\n   360\t        // Inspect health to verify affected lane derivations failed\n   361\t        const health = await instance.sdk.inspect.health(threadRef);\n   362\t        expect(health.ok).toBe(true);\n   363\t        if (!health.ok) return;\n   364\t\n   365\t        // Verify that smoothed_prompt derivations failed classified (unreachable lane)\n   366\t        const smoothedFailed = health.value.owners.some((o) =>\n   367\t          o.kind === \"smoothed_prompt\" && o.counts.failed > 0\n   368\t        );\n   369\t        expect(smoothedFailed).toBe(true);\n   370\t\n   371\t        // Verify that turn_rendering derivations succeeded (reachable lane)\n   372\t        const turnRenderingReady = health.value.owners.some((o) =>\n   373\t          o.kind === \"turn_rendering\" && o.counts.ready > 0\n   374\t        );\n   375\t        expect(turnRenderingReady).toBe(true);\n   376\t\n   377\t        // Verify failures are queryable through health\n   378\t        expect(health.value.failures.length).toBeGreaterThan(0);\n   379\t        const smoothedFailure = health.value.failures.find((f) => f.form === \"smoothed_prompt\");\n   380\t        expect(smoothedFailure).toBeDefined();\n   381\t        expect(smoothedFailure?.reason).toContain(\"invalid_request\");\n   382\t        expect(smoothedFailure?.lastError).toContain(\"unreachable assignment lane\");\n   383\t\n   384\t        await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   385\t      } finally {\n   386\t        store.cleanup();\n   387\t      }\n   388\t    });\n   389\t\n   390\t    it(\"validation does not break the session - state remains functional\", () => {\n","exit_code":0,"status":"completed"}}

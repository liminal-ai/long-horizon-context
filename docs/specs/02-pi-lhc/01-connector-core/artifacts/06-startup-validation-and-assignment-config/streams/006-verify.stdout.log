{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/model-call.ts | sed -n '145,165p'\"","aggregated_output":"   145\t/**\n   146\t * Default assignments for all seven FormKinds.\n   147\t *\n   148\t * Story 6 implements config loading; these defaults use LHC's deterministic\n   149\t * provider so the shipped path is concrete and local verification can derive\n   150\t * without operator config.\n   151\t */\n   152\texport function defaultAssignments(\n   153\t  model: { provider: string; id: string } = { provider: \"deterministic\", id: \"default\" },\n   154\t): Record<string, { provider: string; model: string; prompt: string }> {\n   155\t  return {\n   156\t    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n   157\t    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n   158\t    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n   159\t    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n   160\t    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n   161\t    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n   162\t    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n   163\t  };\n   164\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/assignments.ts | sed -n '88,155p'\"","aggregated_output":"    88\t/** Check if a prompt name is registered in LHC's prompt registry. */\n    89\tfunction isPromptRegistered(promptName: string): boolean {\n    90\t  return Object.values(DEFAULT_PROMPT_NAMES).includes(promptName);\n    91\t}\n    92\t\n    93\t/** Validate a single assignment and throw if it fails shape checks. */\n    94\tfunction validateAssignment(kind: FormKind, assignment: Partial<ModelAssignment>): ModelAssignment {\n    95\t  if (!isComplete(assignment)) {\n    96\t    throw new AssignmentValidationError(kind, \"incomplete\");\n    97\t  }\n    98\t\n    99\t  // Check for placeholder values (AC-5.6: placeholder fails loud)\n   100\t  if (hasPlaceholder(assignment)) {\n   101\t    throw new AssignmentValidationError(kind, \"placeholder\");\n   102\t  }\n   103\t\n   104\t  // Check that the prompt is registered (AC-5.4: prompt must name a registered prompt)\n   105\t  if (!isPromptRegistered(assignment.prompt)) {\n   106\t    throw new AssignmentValidationError(kind, \"unknown_prompt\");\n   107\t  }\n   108\t\n   109\t  return assignment;\n   110\t}\n   111\t\n   112\t/** Load + shape-validate the seven derivation assignments from operator config.\n   113\t *\n   114\t *  - Merges operator config over shipped defaults (AC-5.4).\n   115\t *  - Falls back to defaults when config is missing or undefined (AC-5.4).\n   116\t *  - User overrides take effect on next session start with no code change (AC-5.5).\n   117\t *  - Incomplete assignments fail loud at initialization (AC-5.5, TC-5.6).\n   118\t *  - Unknown prompts fail loud at initialization (TC-5.6).\n   119\t *  - Placeholder values fail loud at initialization (TC-5.6).\n   120\t *\n   121\t *  This function throws `AssignmentValidationError` on any validation failure;\n   122\t *  the caller (typically the session_start hook) catches and surfaces the error\n   123\t *  as an actionable diagnostic. It never returns an incomplete or placeholder map\n   124\t *  that would mask a misconfiguration (story §Anti-Shim Requirements). */\n   125\texport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n   126\t  // Start with shipped defaults (all seven kinds with concrete assignments)\n   127\t  const baseAssignments = defaultAssignments() as Partial<Record<FormKind, ModelAssignment>>;\n   128\t  const mergedAssignments: Partial<Record<FormKind, ModelAssignment>> = {};\n   129\t\n   130\t  for (const kind of FORM_KINDS) {\n   131\t    mergedAssignments[kind] = validateAssignment(kind, baseAssignments[kind] ?? {});\n   132\t  }\n   133\t\n   134\t  // If config is missing/null/undefined, use defaults as-is\n   135\t  if (config === null || config === undefined || typeof config !== \"object\") {\n   136\t    return mergedAssignments as Record<FormKind, ModelAssignment>;\n   137\t  }\n   138\t\n   139\t  const configObj = config as Partial<Record<FormKind, Partial<ModelAssignment>>>;\n   140\t\n   141\t  // Check for unknown assignment keys (SV-002: fail loud on extra keys)\n   142\t  const configKeys = Object.keys(configObj) as Array<string>;\n   143\t  for (const key of configKeys) {\n   144\t    if (key !== \"\" && !FORM_KINDS.includes(key as FormKind)) {\n   145\t      throw new Error(`Unknown assignment key '${key}': must be one of ${FORM_KINDS.join(\", \")}`);\n   146\t    }\n   147\t  }\n   148\t\n   149\t  // Merge operator config over defaults for kinds that are specified\n   150\t  for (const kind of FORM_KINDS) {\n   151\t    const override = configObj[kind as FormKind];\n   152\t    if (override !== undefined) {\n   153\t      mergedAssignments[kind] = validateAssignment(kind, override);\n   154\t    }\n   155\t  }\n","exit_code":0,"status":"completed"}}

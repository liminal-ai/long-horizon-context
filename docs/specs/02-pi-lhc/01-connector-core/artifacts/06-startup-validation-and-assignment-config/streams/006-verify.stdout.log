{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/inference/startup-validation.ts | sed -n '80,120p'\"","aggregated_output":"    80\t *  - Always persist the structured ValidationReport to SessionState.health.\n    81\t *  - Capture continues running even when validation fails (AC-5.3).\n    82\t *\n    83\t *  This function never throws; validation failures are diagnostic, not fatal.\n    84\t *  The affected lane's derivations will fail classified and queryable through\n    85\t *  health (AC-5.3), but the session itself remains functional for capture. */\n    86\texport function report(\n    87\t  r: ValidationReport,\n    88\t  ctx: ExtensionContext,\n    89\t  state: SessionState,\n    90\t): void {\n    91\t  // Mark that we've reported startup validation (avoids duplicate reporting)\n    92\t  state.flags.startupValidationReported = true;\n    93\t\n    94\t  // If there are unreachable lanes, surface them through ctx.ui when available\n    95\t  if (r.unreachable.length > 0) {\n    96\t    const lines = [\n    97\t      \"pi-lhc startup validation: unreachable derivation lanes\",\n    98\t      \"\",\n    99\t      ...r.unreachable.map(\n   100\t        (u) =>\n   101\t          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n   102\t      ),\n   103\t      \"\",\n   104\t      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n   105\t    ];\n   106\t\n   107\t    const message = lines.join(\"\\n\");\n   108\t    state.health.startupValidation = { ...r, message };\n   109\t\n   110\t    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n   111\t    if (ctx.hasUI) {\n   112\t      ctx.ui.notify(message, { level: \"warn\" });\n   113\t    }\n   114\t  } else {\n   115\t    // Persist the structured report to SessionState.health (always, even in headless)\n   116\t    state.health.startupValidation = r;\n   117\t  }\n   118\t}\n","exit_code":0,"status":"completed"}}

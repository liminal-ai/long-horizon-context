{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_df63e15b97194c3888ba0f2a","type":"tool_result","content":"1\timport type { FormKind, ModelAssignment } from \"lhc\";\n2\timport { NotImplementedError } from \"../shared/not-implemented.js\";\n3\t\n4\t// AC-5.4, AC-5.5. Load the seven assignments from config; LHC's createSdk also\n5\t// shape-validates all seven at construction and throws (the \"fail loud\" half).\n6\t\n7\t/** Load + shape-validate; throw loud on missing/unknown/placeholder. Story 6.\n8\t *  Throws until then — it must never return a placeholder map that masks a\n9\t *  missing assignment (story §Anti-Shim). */\n10\texport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n11\t  throw new NotImplementedError(\"inference.loadAssignments\");\n12\t}\n13\t"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"1f12a171-0a27-48d8-996f-da8ece232d18","timestamp":"2026-06-14T13:06:10.442Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/assignments.ts","content":"import type { FormKind, ModelAssignment } from \"lhc\";\nimport { NotImplementedError } from \"../shared/not-implemented.js\";\n\n// AC-5.4, AC-5.5. Load the seven assignments from config; LHC's createSdk also\n// shape-validates all seven at construction and throws (the \"fail loud\" half).\n\n/** Load + shape-validate; throw loud on missing/unknown/placeholder. Story 6.\n *  Throws until then — it must never return a placeholder map that masks a\n *  missing assignment (story §Anti-Shim). */\nexport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n  throw new NotImplementedError(\"inference.loadAssignments\");\n}\n","numLines":13,"startLine":1,"totalLines":13}}}

hen partial override creates incomplete assignment\", () => {\n        // Override provider only, but default doesn't have model/prompt\n        // (this tests the merge logic - if we had a base without model/prompt)\n        const baseDefaults = loadAssignments(undefined);\n        const config = {\n          smoothed_prompt: {\n            provider: \"anthropic\",\n            // model and prompt missing - but base has them, so this is OK\n          },\n        };\n\n        // This should NOT throw because the base defaults provide model/prompt\n        const merged = loadAssignments(config);\n        expect(merged.smoothed_prompt.provider).toBe(\"anthropic\");\n        expect(merged.smoothed_prompt.model).toBe(baseDefaults.smoothed_prompt.model);\n        expect(merged.smoothed_prompt.prompt).toBe(baseDefaults.smoothed_prompt.prompt);\n      });\n    });\n\n    describe(\"unknown prompt - not registered in LHC prompt registry\", () => {\n      it(\"throws when prompt name is not in DEFAULT_PROMPT_NAMES\", () => {\n        const config = {\n          smoothed_prompt: {\n            provider: \"anthropic\",\n            model: \"claude-3-opus\",","numLines":30,"startLine":175,"totalLines":391}}}

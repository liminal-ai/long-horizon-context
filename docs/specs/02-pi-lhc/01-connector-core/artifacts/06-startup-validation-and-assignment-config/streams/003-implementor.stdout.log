{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ab072e18709f4011904fb2a5","type":"tool_result","content":"100\t  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n101\t    // Resolve the model through PI's registry\n102\t    const resolved = ctx.modelRegistry.find(provider, model);\n103\t    if (resolved === undefined) {\n104\t      // Unknown model - treat as invalid request (terminal)\n105\t      return {\n106\t        ok: false,\n107\t        kind: \"invalid_request\",\n108\t        message: `Model not found in registry: ${provider}/${model}`,\n109\t      };\n110\t    }\n111\t\n112\t    // Check if auth is configured\n113\t    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n114\t      // No auth - treat as auth failure (terminal)\n115\t      return {\n116\t        ok: false,\n117\t        kind: \"auth\",\n118\t        message: `No configured auth for model: ${provider}/${model}`,\n119\t      };\n120\t    }\n121\t\n122\t    // Complete through pi-ai. Tests may inject this seam; production loads the\n123\t    // host package at runtime so pi-lhc does not publish fabricated text when\n124\t    // the host dependency is absent.\n125\t    try {\n126\t      const complete = deps.complete ?? await importPiAiComplete();\n127\t      const response = await complete(resolved, { messages });\n128\t\n129\t      // Extract text from the response\n130\t      const text = extractAssistantText(response);\n131\t\n132\t      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n133\t      // empty_output is classified by LHC's adapter, not by the host function.\n134\t      // The host function returns text-or-failure only, even if the text is empty.\n135\t      return { ok: true, text };\n136\t    } catch (err) {\n137\t      // Classify the error into a ModelCallFailureKind\n138\t      const kind = classifyFailure(err);\n139\t      const message = err instanceof Error ? err.message : String(err);\n140\t      return { ok: false, kind, message };\n141\t    }\n142\t  };\n143\t}\n144\t\n145\t/**\n146\t * Default assignments for all seven FormKinds.\n147\t *\n148\t * Story 6 implements config loading; these defaults keep Story 5's production\n149\t * path on LHC inference by using PI's first available model when present.\n150\t */\n151\texport function defaultAssignments(\n152\t  model: { provider: string; id: string } = { provider: \"pi-lhc\", id: \"unconfigured\" },\n153\t): Record<string, { provider: string; model: string; prompt: string }> {\n154\t  return {\n155\t    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n156\t    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n157\t    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n158\t    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n159\t    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n160\t    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n161\t    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n162\t  };\n163\t}\n164\t"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"d8634d30-3e0d-4e85-834c-af364c39fa0a","timestamp":"2026-06-14T13:06:21.498Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts","content":"  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n    // Resolve the model through PI's registry\n    const resolved = ctx.modelRegistry.find(provider, model);\n    if (resolved === undefined) {\n      // Unknown model - treat as invalid request (terminal)\n      return {\n        ok: false,\n        kind: \"invalid_request\",\n        message: `Model not found in registry: ${provider}/${model}`,\n      };\n    }\n\n    // Check if auth is configured\n    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n      // No auth - treat as auth failure (terminal)\n      return {\n        ok: false,\n        kind: \"auth\",\n        message: `No configured auth for model: ${provider}/${model}`,\n      };\n    }\n\n    // Complete through pi-ai. Tests may inject this seam; production loads the\n    // host package at runtime so pi-lhc does not publish fabricated text when\n    // the host dependency is absent.\n    try {\n      const complete = deps.complete ?? await importPiAiComplete();\n      const response = await complete(resolved, { messages });\n\n      // Extract text from the response\n      const text = extractAssistantText(response);\n\n      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n      // empty_output is classified by LHC's adapter, not by the host function.\n      // The host function returns text-or-failure only, even if the text is empty.\n      return { ok: true, text };\n    } catch (err) {\n      // Classify the error into a ModelCallFailureKind\n      const kind = classifyFailure(err);\n      const message = err instanceof Error ? err.message : String(err);\n      return { ok: false, kind, message };\n    }\n  };\n}\n\n/**\n * Default assignments for all seven FormKinds.\n *\n * Story 6 implements config loading; these defaults keep Story 5's production\n * path on LHC inference by using PI's first available model when present.\n */\nexport function defaultAssignments(\n  model: { provider: string; id: string } = { provider: \"pi-lhc\", id: \"unconfigured\" },\n): Record<string, { provider: string; model: string; prompt: string }> {\n  return {\n    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n  };\n}\n","numLines":65,"startLine":100,"totalLines":164}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_19c31e98c3174ec3bcdb8664","type":"tool_result","content":"270\t\n271\t    it(\"affected lane derivations fail classified and queryable through health\", () => {\n272\t      const ctx = createMockContext();\n273\t      const assignments = createAssignments({\n274\t        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n275\t        tool_call_summary: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n276\t      });\n277\t\n278\t      const validationReport = validateReachable(assignments, ctx);\n279\t\n280\t      const state: SessionState = {\n281\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n282\t        flags: { startupValidationReported: false },\n283\t        health: {},\n284\t      };\n285\t\n286\t      report(validationReport, ctx, state);\n287\t\n288\t      // Health should contain the structured report\n289\t      expect(state.health.startupValidation).toBeDefined();\n290\t      expect(state.health.startupValidation?.unreachable).toHaveLength(7); // All seven unreachable\n291\t\n292\t      // Each unreachable lane is classified with reason and fix\n293\t      const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n294\t      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n295\t      expect(smoothEntry?.fix).toBeDefined();\n296\t\n297\t      // Queryable - callers can read health to determine which lanes are affected\n298\t      const affectedKinds = state.health.startupValidation?.unreachable.map((e) => e.kind);\n299\t      expect(affectedKinds).toContain(\"smoothed_prompt\");"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"5190a06e-30e4-4963-aca2-9eef51411c7b","timestamp":"2026-06-14T13:11:06.837Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/startup-validation.test.ts","content":"\n    it(\"affected lane derivations fail classified and queryable through health\", () => {\n      const ctx = createMockContext();\n      const assignments = createAssignments({\n        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n      });\n\n      const validationReport = validateReachable(assignments, ctx);\n\n      const state: SessionState = {\n        threadRef: { filePath: \"/test/thread.sqlite\" },\n        flags: { startupValidationReported: false },\n        health: {},\n      };\n\n      report(validationReport, ctx, state);\n\n      // Health should contain the structured report\n      expect(state.health.startupValidation).toBeDefined();\n      expect(state.health.startupValidation?.unreachable).toHaveLength(7); // All seven unreachable\n\n      // Each unreachable lane is classified with reason and fix\n      const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n      expect(smoothEntry?.fix).toBeDefined();\n\n      // Queryable - callers can read health to determine which lanes are affected\n      const affectedKinds = state.health.startupValidation?.unreachable.map((e) => e.kind);\n      expect(affectedKinds).toContain(\"smoothed_prompt\");","numLines":30,"startLine":270,"totalLines":372}}}

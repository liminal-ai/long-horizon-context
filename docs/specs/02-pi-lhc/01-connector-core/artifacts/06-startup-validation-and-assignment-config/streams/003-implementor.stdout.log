{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f6d489dca9474a9fa6d1945d","type":"tool_result","content":"150\t\n151\t      const reportWithModel = validateReachable(assignmentsWithModel, ctxWithAuth);\n152\t      const reportWithoutModel = validateReachable(assignmentsWithoutModel, ctxWithoutModel);\n153\t\n154\t      expect(reportWithModel.unreachable[0].reason).toBe(\"auth_not_configured\");\n155\t      expect(reportWithoutModel.unreachable[0].reason).toBe(\"unknown_model\");\n156\t    });\n157\t\n158\t    it(\"report appears in headless mode (no TUI assumed)\", () => {\n159\t      const ctx = createMockContext(undefined, undefined, false);\n160\t      ctx.hasUI = false; // Explicitly headless\n161\t      const notifySpy = vi.fn();\n162\t      ctx.ui.notify = notifySpy;\n163\t\n164\t      const assignments = createAssignments({\n165\t        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n166\t      });\n167\t\n168\t      const validationReport = validateReachable(assignments, ctx);\n169\t\n170\t      const state: SessionState = {\n171\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n172\t        flags: { startupValidationReported: false },\n173\t        health: {},\n174\t      };\n175\t\n176\t      // Report should not throw even in headless mode\n177\t      expect(() => report(validationReport, ctx, state)).not.toThrow();\n178\t\n179\t      // State should have the report persisted (headless-safe)"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"04ecf6e9-e4c6-403b-a27b-a2fc7b77e743","timestamp":"2026-06-14T13:10:14.228Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/startup-validation.test.ts","content":"\n      const reportWithModel = validateReachable(assignmentsWithModel, ctxWithAuth);\n      const reportWithoutModel = validateReachable(assignmentsWithoutModel, ctxWithoutModel);\n\n      expect(reportWithModel.unreachable[0].reason).toBe(\"auth_not_configured\");\n      expect(reportWithoutModel.unreachable[0].reason).toBe(\"unknown_model\");\n    });\n\n    it(\"report appears in headless mode (no TUI assumed)\", () => {\n      const ctx = createMockContext(undefined, undefined, false);\n      ctx.hasUI = false; // Explicitly headless\n      const notifySpy = vi.fn();\n      ctx.ui.notify = notifySpy;\n\n      const assignments = createAssignments({\n        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n      });\n\n      const validationReport = validateReachable(assignments, ctx);\n\n      const state: SessionState = {\n        threadRef: { filePath: \"/test/thread.sqlite\" },\n        flags: { startupValidationReported: false },\n        health: {},\n      };\n\n      // Report should not throw even in headless mode\n      expect(() => report(validationReport, ctx, state)).not.toThrow();\n\n      // State should have the report persisted (headless-safe)","numLines":30,"startLine":150,"totalLines":372}}}

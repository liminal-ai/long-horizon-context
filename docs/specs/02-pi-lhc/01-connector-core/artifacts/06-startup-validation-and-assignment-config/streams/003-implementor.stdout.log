{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f3e82c88934141488d8bf38e","type":"tool_result","content":"35\t      // Every prompt should match a registered prompt name\n36\t      const registeredPrompts = Object.values(DEFAULT_PROMPT_NAMES);\n37\t      for (const kind of FORM_KINDS) {\n38\t        const assignment = assignments[kind];\n39\t        expect(registeredPrompts).toContain(assignment.prompt);\n40\t        expect(assignment.prompt).toBe(DEFAULT_PROMPT_NAMES[kind]);\n41\t      }\n42\t    });\n43\t  });\n44\t\n45\t  describe(\"TC-5.5: User override takes effect on next session start\", () => {\n46\t    it(\"applies provider/model/prompt override for a single kind\", () => {\n47\t      const config = {\n48\t        smoothed_prompt: {\n49\t          provider: \"anthropic\",\n50\t          model: \"claude-3-opus\",\n51\t          prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt,\n52\t        },\n53\t      };\n54\t\n55\t      const assignments = loadAssignments(config);\n56\t\n57\t      expect(assignments.smoothed_prompt.provider).toBe(\"anthropic\");\n58\t      expect(assignments.smoothed_prompt.model).toBe(\"claude-3-opus\");\n59\t      expect(assignments.smoothed_prompt.prompt).toBe(DEFAULT_PROMPT_NAMES.smoothed_prompt);\n60\t\n61\t      // Other kinds retain defaults\n62\t      expect(assignments.tool_call_summary.provider).toBe(\"pi-lhc\");\n63\t    });\n64\t\n65\t    it(\"applies partial override (provider only, keeps model/prompt from default)\", () => {\n66\t      const config = {\n67\t        tool_call_summary: {\n68\t          provider: \"openai\",\n69\t          // model and prompt omitted - should throw incomplete\n70\t        },\n71\t      };\n72\t\n73\t      // Partial overrides are not allowed - must specify all fields\n74\t      expect(() => loadAssignments(config)).toThrow(AssignmentValidationError);\n75\t      try {\n76\t        loadAssignments(config);\n77\t      } catch (e) {\n78\t        expect(e).toBeInstanceOf(AssignmentValidationError);\n79\t        if (e instanceof AssignmentValidationError) {\n80\t          expect(e.kind).toBe(\"tool_call_summary\");\n81\t          expect(e.problem).toBe(\"incomplete\");\n82\t        }\n83\t      }\n84\t    });"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"06a9e7a9-a519-4344-92c3-41db49fb53a5","timestamp":"2026-06-14T13:12:39.050Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/assignments.test.ts","content":"      // Every prompt should match a registered prompt name\n      const registeredPrompts = Object.values(DEFAULT_PROMPT_NAMES);\n      for (const kind of FORM_KINDS) {\n        const assignment = assignments[kind];\n        expect(registeredPrompts).toContain(assignment.prompt);\n        expect(assignment.prompt).toBe(DEFAULT_PROMPT_NAMES[kind]);\n      }\n    });\n  });\n\n  describe(\"TC-5.5: User override takes effect on next session start\", () => {\n    it(\"applies provider/model/prompt override for a single kind\", () => {\n      const config = {\n        smoothed_prompt: {\n          provider: \"anthropic\",\n          model: \"claude-3-opus\",\n          prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt,\n        },\n      };\n\n      const assignments = loadAssignments(config);\n\n      expect(assignments.smoothed_prompt.provider).toBe(\"anthropic\");\n      expect(assignments.smoothed_prompt.model).toBe(\"claude-3-opus\");\n      expect(assignments.smoothed_prompt.prompt).toBe(DEFAULT_PROMPT_NAMES.smoothed_prompt);\n\n      // Other kinds retain defaults\n      expect(assignments.tool_call_summary.provider).toBe(\"pi-lhc\");\n    });\n\n    it(\"applies partial override (provider only, keeps model/prompt from default)\", () => {\n      const config = {\n        tool_call_summary: {\n          provider: \"openai\",\n          // model and prompt omitted - should throw incomplete\n        },\n      };\n\n      // Partial overrides are not allowed - must specify all fields\n      expect(() => loadAssignments(config)).toThrow(AssignmentValidationError);\n      try {\n        loadAssignments(config);\n      } catch (e) {\n        expect(e).toBeInstanceOf(AssignmentValidationError);\n        if (e instanceof AssignmentValidationError) {\n          expect(e.kind).toBe(\"tool_call_summary\");\n          expect(e.problem).toBe(\"incomplete\");\n        }\n      }\n    });","numLines":50,"startLine":35,"totalLines":401}}}

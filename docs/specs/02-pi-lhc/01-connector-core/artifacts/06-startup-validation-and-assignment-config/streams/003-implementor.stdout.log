{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_5628a69c0219486f91d7aba2","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  MessageEventInput,\n13\t  OpResult,\n14\t  SdkConfig,\n15\t  ThreadRef,\n16\t} from \"lhc\";\n17\timport type {\n18\t  ExtensionAPI,\n19\t  ExtensionContext,\n20\t  PiHookHandler,\n21\t  PiHookName,\n22\t} from \"./pi/types.js\";\n23\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n24\timport { createSessionState } from \"./lifecycle/state.js\";\n25\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n26\timport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\n27\timport {\n28\t  detectForkFromSessionTree,\n29\t  forkInfoFromHook,\n30\t  seedFork,\n31\t} from \"./lifecycle/fork.js\";\n32\timport {\n33\t  parseLaunchFlags,\n34\t  resolveReloadThread,\n35\t  resolveThread,\n36\t  type LaunchFlags,\n37\t  type ResolveDeps,\n38\t} from \"./lifecycle/thread-resolution.js\";\n39\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n40\timport { threads } from \"lhc\";\n41\timport { capture, captureGap } from \"./capture/converter.js\";\n42\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n43\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n44\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n45\timport type { LhcInstance } from \"./shared/instance.js\";\n46\t\n47\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n48\texport type { LhcInstance } from \"./shared/instance.js\";\n49\t\n50\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n51\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n52\t *  registers no handler for it (story Scope Out). */\n53\texport const EPIC_1_HOOKS = [\n54\t  \"session_start\",\n55\t  \"message_end\",\n56\t  \"turn_end\",\n57\t  \"agent_end\",\n58\t  \"model_select\",\n59\t  \"thinking_level_select\",\n60\t  \"session_before_fork\",\n61\t  \"session_before_switch\",\n62\t  \"session_shutdown\",\n63\t] as const satisfies readonly PiHookName[];\n64\t\n65\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n66\t\n67\t/** What the connector needs from the host to run a session. Every dependency\n68\t *  has a working production default; the overrides exist for test isolation\n69\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n70\t *  in the PI-auth-backed inference config.\n71\t *\n72\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n73\t *  default is the observe-only config below (a real, construction-valid SDK);\n74\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n75\texport interface ConnectorDeps {\n76\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n77\t  registryPath?: string;\n78\t  newThreadFilePath?: () => string;\n79\t  parseLaunch?: () => LaunchFlags;\n80\t  selectThread?: (\n81\t    choices: readonly ThreadChoice[],\n82\t    ctx: ExtensionContext,\n83\t  ) => Promise<string | null>;\n84\t}\n85\t\n86\t/** Everything the connector retains across hooks as PLAIN data — by\n87\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n88\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n89\t *  deliberately not part of the snapshot. */\n90\texport interface ConnectorSnapshot {\n91\t  state: SessionState | null;\n92\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n93\t}\n94\t\n95\texport interface Connector {\n96\t  /** Register the observe-only hook rail on the PI extension API. */\n97\t  register(pi: ExtensionAPI): void;\n98\t  /** The plain-data state retained across hooks. `null` until a session\n99\t   *  resolves a thread; never holds a PI ctx. */\n100\t  getState(): SessionState | null;"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"e396b099-28b0-4538-b985-0d122f9c3c10","timestamp":"2026-06-14T13:06:13.174Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  MessageEventInput,\n  OpResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport { createModelCall, defaultAssignments } from \"./inference/model-call.js\";\nimport {\n  detectForkFromSessionTree,\n  forkInfoFromHook,\n  seedFork,\n} from \"./lifecycle/fork.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { threads } from \"lhc\";\nimport { capture, captureGap } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;","numLines":100,"startLine":1,"totalLines":653}}}

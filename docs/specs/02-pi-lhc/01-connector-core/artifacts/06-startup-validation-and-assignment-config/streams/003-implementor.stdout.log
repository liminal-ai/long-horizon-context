{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_106396ee97a841a294bd7be7","type":"tool_result","content":"70\t *  has a working production default; the overrides exist for test isolation\n71\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n72\t *  in the PI-auth-backed inference config.\n73\t *\n74\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n75\t *  default is the observe-only config below (a real, construction-valid SDK);\n76\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n77\texport interface ConnectorDeps {\n78\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n79\t  registryPath?: string;\n80\t  newThreadFilePath?: () => string;\n81\t  parseLaunch?: () => LaunchFlags;\n82\t  selectThread?: (\n83\t    choices: readonly ThreadChoice[],\n84\t    ctx: ExtensionContext,\n85\t  ) => Promise<string | null>;\n86\t}\n87\t\n88\t/** Everything the connector retains across hooks as PLAIN data — by\n89\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n90\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n91\t *  deliberately not part of the snapshot. */\n92\texport interface ConnectorSnapshot {\n93\t  state: SessionState | null;\n94\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n95\t}\n96\t\n97\texport interface Connector {\n98\t  /** Register the observe-only hook rail on the PI extension API. */\n99\t  register(pi: ExtensionAPI): void;"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"c7765519-8a34-4522-8687-c54ae07eeb03","timestamp":"2026-06-14T13:08:20.867Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":" *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;","numLines":30,"startLine":70,"totalLines":655}}}

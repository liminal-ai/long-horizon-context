{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8259029e83214960988d773d","type":"tool_result","content":"1\timport type { FormKind, ModelAssignment } from \"lhc\";\n2\timport type { ExtensionContext } from \"../pi/types.js\";\n3\timport type { SessionState } from \"../lifecycle/state.js\";\n4\timport type { ValidationReport } from \"../shared/diagnostics.js\";\n5\timport { NotImplementedError } from \"../shared/not-implemented.js\";\n6\t\n7\t// AC-5.1, AC-5.2, AC-5.3. A reachability probe on top of LHC's shape\n8\t// validation: existence (`modelRegistry.find`) then configured-auth\n9\t// (`hasConfiguredAuth` / `getAvailable`). Reporting must not assume a TUI.\n10\t\n11\t/** Re-exported from its spec'd home here (defined in shared/diagnostics so the\n12\t *  plain-data SessionState can reference it without a lifecycle→inference edge). */\n13\texport type { ValidationReport };\n14\t\n15\t/** Probe each assignment; classify unreachable lanes. Story 6. Throws until\n16\t *  then — a stub returning `{ unreachable: [] }` would falsely report \"all\n17\t *  reachable\" (story §Anti-Shim). */\n18\texport function validateReachable(\n19\t  assignments: Record<FormKind, ModelAssignment>,\n20\t  ctx: ExtensionContext,\n21\t): ValidationReport {\n22\t  throw new NotImplementedError(\"inference.validateReachable\");\n23\t}\n24\t\n25\t/** Surface unreachable lanes via `ctx.ui` when available + a structured\n26\t *  diagnostic in `SessionState.health` always (headless-safe). Story 6. */\n27\texport function report(r: ValidationReport, ctx: ExtensionContext, state: SessionState): void {\n28\t  throw new NotImplementedError(\"inference.report\");\n29\t}\n30\t"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"10bf2a55-0f5c-4eb8-a815-bba2f022602f","timestamp":"2026-06-14T13:06:10.573Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/startup-validation.ts","content":"import type { FormKind, ModelAssignment } from \"lhc\";\nimport type { ExtensionContext } from \"../pi/types.js\";\nimport type { SessionState } from \"../lifecycle/state.js\";\nimport type { ValidationReport } from \"../shared/diagnostics.js\";\nimport { NotImplementedError } from \"../shared/not-implemented.js\";\n\n// AC-5.1, AC-5.2, AC-5.3. A reachability probe on top of LHC's shape\n// validation: existence (`modelRegistry.find`) then configured-auth\n// (`hasConfiguredAuth` / `getAvailable`). Reporting must not assume a TUI.\n\n/** Re-exported from its spec'd home here (defined in shared/diagnostics so the\n *  plain-data SessionState can reference it without a lifecycle→inference edge). */\nexport type { ValidationReport };\n\n/** Probe each assignment; classify unreachable lanes. Story 6. Throws until\n *  then — a stub returning `{ unreachable: [] }` would falsely report \"all\n *  reachable\" (story §Anti-Shim). */\nexport function validateReachable(\n  assignments: Record<FormKind, ModelAssignment>,\n  ctx: ExtensionContext,\n): ValidationReport {\n  throw new NotImplementedError(\"inference.validateReachable\");\n}\n\n/** Surface unreachable lanes via `ctx.ui` when available + a structured\n *  diagnostic in `SessionState.health` always (headless-safe). Story 6. */\nexport function report(r: ValidationReport, ctx: ExtensionContext, state: SessionState): void {\n  throw new NotImplementedError(\"inference.report\");\n}\n","numLines":30,"startLine":1,"totalLines":30}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_65cfb5ceac644fa38cda2ac9","type":"tool_result","content":"1\t// AC-4.1..4.4. The host-supplied ModelCall function.\n2\t//\n3\t// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n4\t// a production-valid boundary, and classifies failures into the LHC contract.\n5\t// Provider/model are opaque routing keys — the connector does not interpret them.\n6\t//\n7\t// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n8\t// registry and completes through @earendil-works/pi-ai when that package is\n9\t// available in the host runtime. If the runtime does not provide pi-ai, the host\n10\t// returns a classified failure; it never fabricates completion text.\n11\t//\n12\t// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n13\t// @earendil-works/pi-ai (package not yet available).\n14\t\n15\timport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\n16\timport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\n17\timport type { PiAiComplete } from \"./pi-ai.js\";\n18\t\n19\tinterface ModelCallDeps {\n20\t  complete?: PiAiComplete;\n21\t}\n22\t\n23\t/** Extract the text content from an AssistantMessage-like shape. */\n24\tfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n25\t  const content = message.content ?? [];\n26\t  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n27\t  return textParts.map((part) => part.text as string).join(\"\\n\");\n28\t}\n29\t\n30\t/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n31\t *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n32\t *  thrown → other). */\n33\texport function classifyFailure(err: unknown): ModelCallFailureKind {\n34\t  // Guard: non-object errors fall through to \"other\"\n35\t  if (typeof err !== \"object\" || err === null) {\n36\t    return \"other\";\n37\t  }\n38\t\n39\t  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n40\t  const code = errorLike.code?.toLowerCase() ?? \"\";\n41\t  const type = errorLike.type?.toLowerCase() ?? \"\";\n42\t  const message = errorLike.message?.toLowerCase() ?? \"\";\n43\t\n44\t  // Check for auth failures (terminal)\n45\t  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n46\t  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n47\t    return \"auth\";\n48\t  }\n49\t\n50\t  // Check for invalid request (terminal)\n51\t  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n52\t  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n53\t    return \"invalid_request\";\n54\t  }\n55\t\n56\t  // Check for rate limit (retryable)\n57\t  const rateLimitPatterns = [\"rate\", \"429\"];\n58\t  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n59\t    return \"rate_limit\";\n60\t  }\n61\t\n62\t  // Check for timeout (retryable)\n63\t  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n64\t  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n65\t    return \"timeout\";\n66\t  }\n67\t\n68\t  // Check for network errors (retryable)\n69\t  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n70\t  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n71\t    return \"network\";\n72\t  }\n73\t\n74\t  // Default for unknown errors\n75\t  return \"other\";\n76\t}\n77\t\n78\tasync function importPiAiComplete(): Promise<PiAiComplete> {\n79\t  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n80\t    specifier: string,\n81\t  ) => Promise<unknown>;\n82\t  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n83\t  const complete = (loaded as { complete?: unknown }).complete;\n84\t  if (typeof complete !== \"function\") {\n85\t    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n86\t      code: \"invalid_request\",\n87\t    });\n88\t  }\n89\t  return complete as PiAiComplete;\n90\t}\n91\t\n92\t/**\n93\t * Production ModelCall implementation using PI's model registry and pi-ai.\n94\t *\n95\t * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n96\t * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n97\t * when the host runtime provides it.\n98\t */\n99\texport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n100\t  return async ({ provider, model, messages }): Promise<ModelCallResult> => {"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"b4c18d2d-9ec9-48ae-b7ed-7e2b615cc1df","timestamp":"2026-06-14T13:06:18.986Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts","content":"// AC-4.1..4.4. The host-supplied ModelCall function.\n//\n// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n// a production-valid boundary, and classifies failures into the LHC contract.\n// Provider/model are opaque routing keys — the connector does not interpret them.\n//\n// PRODUCTION BOUNDARY: the function validates provider/model through PI's\n// registry and completes through @earendil-works/pi-ai when that package is\n// available in the host runtime. If the runtime does not provide pi-ai, the host\n// returns a classified failure; it never fabricates completion text.\n//\n// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n// @earendil-works/pi-ai (package not yet available).\n\nimport { DEFAULT_PROMPT_NAMES, type ModelCall, type ModelCallFailureKind, type ModelCallResult } from \"lhc\";\nimport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\nimport type { PiAiComplete } from \"./pi-ai.js\";\n\ninterface ModelCallDeps {\n  complete?: PiAiComplete;\n}\n\n/** Extract the text content from an AssistantMessage-like shape. */\nfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n  const content = message.content ?? [];\n  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n  return textParts.map((part) => part.text as string).join(\"\\n\");\n}\n\n/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n *  thrown → other). */\nexport function classifyFailure(err: unknown): ModelCallFailureKind {\n  // Guard: non-object errors fall through to \"other\"\n  if (typeof err !== \"object\" || err === null) {\n    return \"other\";\n  }\n\n  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n  const code = errorLike.code?.toLowerCase() ?? \"\";\n  const type = errorLike.type?.toLowerCase() ?? \"\";\n  const message = errorLike.message?.toLowerCase() ?? \"\";\n\n  // Check for auth failures (terminal)\n  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"auth\";\n  }\n\n  // Check for invalid request (terminal)\n  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"invalid_request\";\n  }\n\n  // Check for rate limit (retryable)\n  const rateLimitPatterns = [\"rate\", \"429\"];\n  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"rate_limit\";\n  }\n\n  // Check for timeout (retryable)\n  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"timeout\";\n  }\n\n  // Check for network errors (retryable)\n  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"network\";\n  }\n\n  // Default for unknown errors\n  return \"other\";\n}\n\nasync function importPiAiComplete(): Promise<PiAiComplete> {\n  const dynamicImport = new Function(\"specifier\", \"return import(specifier)\") as (\n    specifier: string,\n  ) => Promise<unknown>;\n  const loaded = await dynamicImport(\"@earendil-works/pi-ai\");\n  const complete = (loaded as { complete?: unknown }).complete;\n  if (typeof complete !== \"function\") {\n    throw Object.assign(new Error(\"@earendil-works/pi-ai does not export complete()\"), {\n      code: \"invalid_request\",\n    });\n  }\n  return complete as PiAiComplete;\n}\n\n/**\n * Production ModelCall implementation using PI's model registry and pi-ai.\n *\n * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n * auth with hasConfiguredAuth(), and completes through @earendil-works/pi-ai\n * when the host runtime provides it.\n */\nexport function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\n  return async ({ provider, model, messages }): Promise<ModelCallResult> => {","numLines":100,"startLine":1,"totalLines":164}}}

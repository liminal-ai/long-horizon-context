{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_45f6169e85ac40dd9c7379e0","type":"tool_result","content":"100\t\n101\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n102\t\n103\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n104\t\n105\texport interface PiToolSpec {\n106\t  name: string;\n107\t  description?: string;\n108\t  promptSnippet?: string;\n109\t  promptGuidelines?: string;\n110\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n111\t}\n112\t\n113\t/** The factory-time API. Hook registration and command/tool registration take\n114\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n115\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n116\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\n117\texport interface ExtensionAPI {\n118\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n119\t  registerCommand(name: string, handler: PiCommandHandler): void;\n120\t  registerTool(tool: PiToolSpec): void;\n121\t  appendEntry(customType: string, data: unknown): void;\n122\t}\n123\t\n124\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n125\t\n126\texport interface ModelDescriptor {\n127\t  provider: string;\n128\t  id: string;\n129\t}\n130\t\n131\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n132\t *  owns. The connector treats provider/model as opaque routing keys. */\n133\texport interface ModelHandle extends ModelDescriptor {\n134\t  readonly [k: string]: unknown;\n135\t}\n136\t\n137\texport interface ModelRegistry {\n138\t  find(provider: string, model: string): ModelHandle | undefined;\n139\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\n140\t  getAvailable(): ModelHandle[];\n141\t}\n142\t\n143\texport interface ExtensionUI {\n144\t  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n145\t}\n146\t\n147\texport interface SessionEntry {\n148\t  type: string;\n149\t  readonly [k: string]: unknown;\n150\t}\n151\t\n152\texport interface SessionManager {\n153\t  getEntries(): SessionEntry[];\n154\t}\n155\t\n156\texport interface ExtensionContext {\n157\t  modelRegistry: ModelRegistry;\n158\t  ui: ExtensionUI;\n159\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n160\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n161\t  hasUI: boolean;\n162\t  sessionManager: SessionManager;\n163\t  cwd: string;\n164\t}\n165\t\n166\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n167\t\n168\texport interface TextPart {\n169\t  type: \"text\";\n170\t  text: string;\n171\t}\n172\texport interface ThinkingPart {\n173\t  type: \"thinking\";\n174\t  thinking: string;\n175\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n176\t   *  Epic 1 (tech design I-3). */\n177\t  thinkingSignature?: string;\n178\t}\n179\texport interface ToolCallPart {\n180\t  type: \"toolCall\";\n181\t  /** Composite, stable across tool_execution_start → tool_result → message_end\n182\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n183\t  id: string;\n184\t  name: string;\n185\t  arguments: Record<string, unknown>;\n186\t  /** Opaque; captured, not interpreted (tech design I-3). */\n187\t  thoughtSignature?: string;\n188\t}\n189\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n190\t *  the converter (tech design I-6), never silently dropped. */\n191\texport interface ImagePart {\n192\t  type: \"image\";\n193\t  mimeType?: string;\n194\t  data?: string;\n195\t}\n196\texport interface FileRefPart {\n197\t  type: \"fileRef\";\n198\t  path: string;\n199\t}"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"3050f82a-98a8-4bce-b171-d9ffbbaa223e","timestamp":"2026-06-14T13:06:38.433Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/pi/types.ts","content":"\n// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n\nexport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n\nexport interface PiToolSpec {\n  name: string;\n  description?: string;\n  promptSnippet?: string;\n  promptGuidelines?: string;\n  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n}\n\n/** The factory-time API. Hook registration and command/tool registration take\n *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n *  exposes them, but Epic 1 (observe-only) registers only hooks. */\nexport interface ExtensionAPI {\n  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n  registerCommand(name: string, handler: PiCommandHandler): void;\n  registerTool(tool: PiToolSpec): void;\n  appendEntry(customType: string, data: unknown): void;\n}\n\n// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n\nexport interface ModelDescriptor {\n  provider: string;\n  id: string;\n}\n\n/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n *  owns. The connector treats provider/model as opaque routing keys. */\nexport interface ModelHandle extends ModelDescriptor {\n  readonly [k: string]: unknown;\n}\n\nexport interface ModelRegistry {\n  find(provider: string, model: string): ModelHandle | undefined;\n  hasConfiguredAuth(model: ModelHandle | string): boolean;\n  getAvailable(): ModelHandle[];\n}\n\nexport interface ExtensionUI {\n  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n}\n\nexport interface SessionEntry {\n  type: string;\n  readonly [k: string]: unknown;\n}\n\nexport interface SessionManager {\n  getEntries(): SessionEntry[];\n}\n\nexport interface ExtensionContext {\n  modelRegistry: ModelRegistry;\n  ui: ExtensionUI;\n  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n  hasUI: boolean;\n  sessionManager: SessionManager;\n  cwd: string;\n}\n\n// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n\nexport interface TextPart {\n  type: \"text\";\n  text: string;\n}\nexport interface ThinkingPart {\n  type: \"thinking\";\n  thinking: string;\n  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n   *  Epic 1 (tech design I-3). */\n  thinkingSignature?: string;\n}\nexport interface ToolCallPart {\n  type: \"toolCall\";\n  /** Composite, stable across tool_execution_start → tool_result → message_end\n   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n  id: string;\n  name: string;\n  arguments: Record<string, unknown>;\n  /** Opaque; captured, not interpreted (tech design I-3). */\n  thoughtSignature?: string;\n}\n/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n *  the converter (tech design I-6), never silently dropped. */\nexport interface ImagePart {\n  type: \"image\";\n  mimeType?: string;\n  data?: string;\n}\nexport interface FileRefPart {\n  type: \"fileRef\";\n  path: string;\n}","numLines":100,"startLine":100,"totalLines":228}}}

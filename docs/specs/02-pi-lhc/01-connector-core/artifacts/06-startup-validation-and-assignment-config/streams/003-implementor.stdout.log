{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b4c7a0410d3b4e558f78f112","type":"tool_result","content":"1\t// TC-4.1..4.4. Model call function tests.\n2\t//\n3\t// TC-4.1: Function resolves (provider,model) via registry, returns text.\n4\t// TC-4.2: Two kinds → different (provider,model) both route in one session.\n5\t// TC-4.3: Failure shapes map to exact kinds (adapter-boundary risk test).\n6\t// TC-4.4: Resolved-but-no-output → empty_output by adapter (not host fn).\n7\t//\n8\t// These tests use synthetic PI contexts (mock-free at the boundary) and assert\n9\t// on the ModelCallResult shapes, exercising classification and routing without\n10\t// a live provider.\n11\timport { describe, expect, it, vi } from \"vitest\";\n12\timport { createSdk, DEFAULT_PROMPT_NAMES, threads, type ModelCallFailureKind, type ModelCallInput } from \"lhc\";\n13\timport { classifyFailure, createModelCall } from \"../../src/inference/model-call.js\";\n14\timport type { ExtensionContext, ModelHandle } from \"../../src/pi/types.js\";\n15\timport type { PiAiComplete } from \"../../src/inference/pi-ai.js\";\n16\timport { tempStore } from \"../fixtures/thread.js\";\n17\timport { validEvent } from \"../fixtures/synthetic.js\";\n18\t\n19\tconst INPUT: ModelCallInput = {\n20\t  provider: \"openai\",\n21\t  model: \"gpt-5.4\",\n22\t  messages: [{ role: \"user\", content: \"hi\" }],\n23\t};\n24\t\n25\tdescribe(\"Story 5: Inference Host Routing\", () => {\n26\t  describe(\"TC-4.1: ModelCall resolves provider/model and returns text\", () => {\n27\t    it(\"resolves a known model with configured auth and returns completion text\", async () => {\n28\t      const mockHandle: ModelHandle = { provider: \"openai\", id: \"gpt-5.4\" };\n29\t      const ctx: ExtensionContext = {\n30\t        cwd: \"/test\",\n31\t        hasUI: false,\n32\t        modelRegistry: {\n33\t          find: () => mockHandle,\n34\t          hasConfiguredAuth: () => true,\n35\t          getAvailable: () => [mockHandle],\n36\t        },\n37\t        ui: { notify: () => {} },\n38\t        sessionManager: { getEntries: () => [] },\n39\t      };\n40\t\n41\t      const complete = vi.fn<PiAiComplete>(async (model) => ({\n42\t        role: \"assistant\",\n43\t        content: [{ type: \"text\", text: `real completion from ${model.provider}/${model.id}` }],\n44\t      }));\n45\t      const modelCall = createModelCall(ctx, { complete });\n46\t      const result = await modelCall(INPUT);\n47\t\n48\t      expect(result.ok).toBe(true);\n49\t      if (result.ok) {\n50\t        expect(result.text).toBe(\"real completion from openai-codex/gpt-5.4\");\n51\t      }\n52\t      expect(complete).toHaveBeenCalledWith(mockHandle, { messages: INPUT.messages });\n53\t    });\n54\t  });\n55\t\n56\t  describe(\"TC-4.2: Multi-lane routing — different kinds route to different pairs\", () => {\n57\t    it(\"routes each call by its provider/model keys independently\", async () => {\n58\t      const handles: ModelHandle[] = [\n59\t        { provider: \"openai\", id: \"gpt-5.4\" },\n60\t        { provider: \"anthropic\", id: \"claude-3-opus\" },\n61\t        { provider: \"openai\", id: \"gpt-4o\" },\n62\t      ];\n63\t\n64\t      const findMock = vi.fn(\n65\t        (provider: string, model: string) => handles.find((h) => h.provider === provider && h.id === model),\n66\t      ) as (provider: string, model: string) => ModelHandle | undefined;\n67\t\n68\t      const ctx: ExtensionContext = {\n69\t        cwd: \"/test\",\n70\t        hasUI: false,\n71\t        modelRegistry: {\n72\t          find: findMock,\n73\t          hasConfiguredAuth: () => true,\n74\t          getAvailable: () => handles,\n75\t        },\n76\t        ui: { notify: () => {} },\n77\t        sessionManager: { getEntries: () => [] },\n78\t      };\n79\t\n80\t      const modelCall = createModelCall(ctx, {\n81\t        complete: async (resolved) => ({\n82\t          role: \"assistant\",\n83\t          content: [{ type: \"text\", text: `routed ${resolved.provider}/${resolved.id}` }],\n84\t        }),\n85\t      });\n86\t\n87\t      // Call with different provider/model pairs\n88\t      const result1 = await modelCall({\n89\t        ...INPUT,\n90\t        provider: \"openai\",\n91\t        model: \"gpt-5.4\",\n92\t      });\n93\t      const result2 = await modelCall({\n94\t        ...INPUT,\n95\t        provider: \"anthropic\",\n96\t        model: \"claude-3-opus\",\n97\t      });\n98\t      const result3 = await modelCall({\n99\t        ...INPUT,\n100\t        provider: \"openai\",\n101\t        model: \"gpt-4o\",\n102\t      });\n103\t\n104\t      // All should succeed and route correctly\n105\t      expect(result1.ok).toBe(true);\n106\t      expect(result2.ok).toBe(true);\n107\t      expect(result3.ok).toBe(true);\n108\t\n109\t      // Verify find was called with the correct keys\n110\t      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-5.4\");\n111\t      expect(findMock).toHaveBeenCalledWith(\"anthropic\", \"claude-3-opus\");\n112\t      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-4o\");\n113\t    });\n114\t  });\n115\t\n116\t  describe(\"TC-4.3: Adapter-boundary risk — failure shapes map to exact kinds\", () => {\n117\t    describe(\"terminal failures\", () => {\n118\t      it(\"classifies auth failure as terminal\", async () => {\n119\t        const ctx: ExtensionContext = {\n120\t          cwd: \"/test\",\n121\t          hasUI: false,\n122\t          modelRegistry: {\n123\t            find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n124\t            hasConfiguredAuth: () => false, // No auth configured\n125\t            getAvailable: () => [],\n126\t          },\n127\t          ui: { notify: () => {} },\n128\t          sessionManager: { getEntries: () => [] },\n129\t        };\n130\t\n131\t        const modelCall = createModelCall(ctx);\n132\t        const result = await modelCall(INPUT);\n133\t\n134\t        expect(result.ok).toBe(false);\n135\t        if (!result.ok) {\n136\t          expect(result.kind).toBe(\"auth\");\n137\t        }\n138\t      });\n139\t\n140\t      it(\"classifies invalid_request as terminal\", async () => {\n141\t        const ctx: ExtensionContext = {\n142\t          cwd: \"/test\",\n143\t          hasUI: false,\n144\t          modelRegistry: {\n145\t            find: () => undefined, // Model not found\n146\t            hasConfiguredAuth: () => true,\n147\t            getAvailable: () => [],\n148\t          },\n149\t          ui: { notify: () => {} },\n150\t          sessionManager: { getEntries: () => [] },"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"7379a52b-db7d-41cc-af38-e5d045da0940","timestamp":"2026-06-14T13:06:35.518Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/model-call.test.ts","content":"// TC-4.1..4.4. Model call function tests.\n//\n// TC-4.1: Function resolves (provider,model) via registry, returns text.\n// TC-4.2: Two kinds → different (provider,model) both route in one session.\n// TC-4.3: Failure shapes map to exact kinds (adapter-boundary risk test).\n// TC-4.4: Resolved-but-no-output → empty_output by adapter (not host fn).\n//\n// These tests use synthetic PI contexts (mock-free at the boundary) and assert\n// on the ModelCallResult shapes, exercising classification and routing without\n// a live provider.\nimport { describe, expect, it, vi } from \"vitest\";\nimport { createSdk, DEFAULT_PROMPT_NAMES, threads, type ModelCallFailureKind, type ModelCallInput } from \"lhc\";\nimport { classifyFailure, createModelCall } from \"../../src/inference/model-call.js\";\nimport type { ExtensionContext, ModelHandle } from \"../../src/pi/types.js\";\nimport type { PiAiComplete } from \"../../src/inference/pi-ai.js\";\nimport { tempStore } from \"../fixtures/thread.js\";\nimport { validEvent } from \"../fixtures/synthetic.js\";\n\nconst INPUT: ModelCallInput = {\n  provider: \"openai\",\n  model: \"gpt-5.4\",\n  messages: [{ role: \"user\", content: \"hi\" }],\n};\n\ndescribe(\"Story 5: Inference Host Routing\", () => {\n  describe(\"TC-4.1: ModelCall resolves provider/model and returns text\", () => {\n    it(\"resolves a known model with configured auth and returns completion text\", async () => {\n      const mockHandle: ModelHandle = { provider: \"openai\", id: \"gpt-5.4\" };\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: () => mockHandle,\n          hasConfiguredAuth: () => true,\n          getAvailable: () => [mockHandle],\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },\n      };\n\n      const complete = vi.fn<PiAiComplete>(async (model) => ({\n        role: \"assistant\",\n        content: [{ type: \"text\", text: `real completion from ${model.provider}/${model.id}` }],\n      }));\n      const modelCall = createModelCall(ctx, { complete });\n      const result = await modelCall(INPUT);\n\n      expect(result.ok).toBe(true);\n      if (result.ok) {\n        expect(result.text).toBe(\"real completion from openai-codex/gpt-5.4\");\n      }\n      expect(complete).toHaveBeenCalledWith(mockHandle, { messages: INPUT.messages });\n    });\n  });\n\n  describe(\"TC-4.2: Multi-lane routing — different kinds route to different pairs\", () => {\n    it(\"routes each call by its provider/model keys independently\", async () => {\n      const handles: ModelHandle[] = [\n        { provider: \"openai\", id: \"gpt-5.4\" },\n        { provider: \"anthropic\", id: \"claude-3-opus\" },\n        { provider: \"openai\", id: \"gpt-4o\" },\n      ];\n\n      const findMock = vi.fn(\n        (provider: string, model: string) => handles.find((h) => h.provider === provider && h.id === model),\n      ) as (provider: string, model: string) => ModelHandle | undefined;\n\n      const ctx: ExtensionContext = {\n        cwd: \"/test\",\n        hasUI: false,\n        modelRegistry: {\n          find: findMock,\n          hasConfiguredAuth: () => true,\n          getAvailable: () => handles,\n        },\n        ui: { notify: () => {} },\n        sessionManager: { getEntries: () => [] },\n      };\n\n      const modelCall = createModelCall(ctx, {\n        complete: async (resolved) => ({\n          role: \"assistant\",\n          content: [{ type: \"text\", text: `routed ${resolved.provider}/${resolved.id}` }],\n        }),\n      });\n\n      // Call with different provider/model pairs\n      const result1 = await modelCall({\n        ...INPUT,\n        provider: \"openai\",\n        model: \"gpt-5.4\",\n      });\n      const result2 = await modelCall({\n        ...INPUT,\n        provider: \"anthropic\",\n        model: \"claude-3-opus\",\n      });\n      const result3 = await modelCall({\n        ...INPUT,\n        provider: \"openai\",\n        model: \"gpt-4o\",\n      });\n\n      // All should succeed and route correctly\n      expect(result1.ok).toBe(true);\n      expect(result2.ok).toBe(true);\n      expect(result3.ok).toBe(true);\n\n      // Verify find was called with the correct keys\n      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-5.4\");\n      expect(findMock).toHaveBeenCalledWith(\"anthropic\", \"claude-3-opus\");\n      expect(findMock).toHaveBeenCalledWith(\"openai\", \"gpt-4o\");\n    });\n  });\n\n  describe(\"TC-4.3: Adapter-boundary risk — failure shapes map to exact kinds\", () => {\n    describe(\"terminal failures\", () => {\n      it(\"classifies auth failure as terminal\", async () => {\n        const ctx: ExtensionContext = {\n          cwd: \"/test\",\n          hasUI: false,\n          modelRegistry: {\n            find: () => ({ provider: \"openai\", id: \"gpt-5.4\" }),\n            hasConfiguredAuth: () => false, // No auth configured\n            getAvailable: () => [],\n          },\n          ui: { notify: () => {} },\n          sessionManager: { getEntries: () => [] },\n        };\n\n        const modelCall = createModelCall(ctx);\n        const result = await modelCall(INPUT);\n\n        expect(result.ok).toBe(false);\n        if (!result.ok) {\n          expect(result.kind).toBe(\"auth\");\n        }\n      });\n\n      it(\"classifies invalid_request as terminal\", async () => {\n        const ctx: ExtensionContext = {\n          cwd: \"/test\",\n          hasUI: false,\n          modelRegistry: {\n            find: () => undefined, // Model not found\n            hasConfiguredAuth: () => true,\n            getAvailable: () => [],\n          },\n          ui: { notify: () => {} },\n          sessionManager: { getEntries: () => [] },","numLines":150,"startLine":1,"totalLines":313}}}

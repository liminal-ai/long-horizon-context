{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_49523c64432246d3a8f0a121","type":"tool_result","content":"45\t  return ref.threadId;\n46\t}\n47\t\n48\tdescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n49\t  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n50\t    // Session A records one exchange, then shuts down.\n51\t    const a = await startCapture(store);\n52\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n53\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n54\t    const threadId = threadIdOf(a.threadRef);\n55\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n56\t\n57\t    // A brand-new connector attaches to the SAME thread by id and records a new\n58\t    // message — it must NOT be skipped as a prior-key collision.\n59\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n60\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n61\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n62\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n63\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n64\t\n65\t    const events = await eventsAfterShutdown(b);\n66\t    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n67\t    const counts = await turnCounts(b.threadRef);\n68\t    expect(counts.closed).toBe(2);\n69\t  });\n70\t\n71\t  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n72\t    const a = await startCapture(store);\n73\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n74\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"967cb0b9-1d39-4105-b057-dbc26053db94","timestamp":"2026-06-14T13:13:06.262Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/reattach-idempotency.test.ts","content":"  return ref.threadId;\n}\n\ndescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n    // Session A records one exchange, then shuts down.\n    const a = await startCapture(store);\n    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    const threadId = threadIdOf(a.threadRef);\n    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n\n    // A brand-new connector attaches to the SAME thread by id and records a new\n    // message — it must NOT be skipped as a prior-key collision.\n    const b = await attachCapture(store, { session: threadId }, \"resume\");\n    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n\n    const events = await eventsAfterShutdown(b);\n    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n    const counts = await turnCounts(b.threadRef);\n    expect(counts.closed).toBe(2);\n  });\n\n  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n    const a = await startCapture(store);\n    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));","numLines":30,"startLine":45,"totalLines":308}}}

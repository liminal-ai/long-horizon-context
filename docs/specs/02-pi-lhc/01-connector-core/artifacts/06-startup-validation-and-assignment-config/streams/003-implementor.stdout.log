{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6ea82b7cb0c94706bc79454b","type":"tool_result","content":"285\t\n286\t      report(validationReport, ctx, state);\n287\t\n288\t      // Health should contain the structured report\n289\t      expect(state.health.startupValidation).toBeDefined();\n290\t      expect(state.health.startupValidation?.unreachable).toHaveLength(7); // All seven unreachable\n291\t\n292\t      // Each unreachable lane is classified with reason and fix\n293\t      const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n294\t      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n295\t      expect(smoothEntry?.fix).toBeDefined();\n296\t\n297\t      // Queryable - callers can read health to determine which lanes are affected\n298\t      const affectedKinds = state.health.startupValidation?.unreachable.map((e) => e.kind);\n299\t      expect(affectedKinds).toContain(\"smoothed_prompt\");\n300\t      expect(affectedKinds).toContain(\"tool_call_summary\");\n301\t    });\n302\t\n303\t    it(\"validation does not break the session - state remains functional\", () => {\n304\t      const ctx = createMockContext();"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"6d64ba88-1ef2-4ac6-9861-e54eb52132f0","timestamp":"2026-06-14T13:11:01.993Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/startup-validation.test.ts","content":"\n      report(validationReport, ctx, state);\n\n      // Health should contain the structured report\n      expect(state.health.startupValidation).toBeDefined();\n      expect(state.health.startupValidation?.unreachable).toHaveLength(7); // All seven unreachable\n\n      // Each unreachable lane is classified with reason and fix\n      const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n      expect(smoothEntry?.fix).toBeDefined();\n\n      // Queryable - callers can read health to determine which lanes are affected\n      const affectedKinds = state.health.startupValidation?.unreachable.map((e) => e.kind);\n      expect(affectedKinds).toContain(\"smoothed_prompt\");\n      expect(affectedKinds).toContain(\"tool_call_summary\");\n    });\n\n    it(\"validation does not break the session - state remains functional\", () => {\n      const ctx = createMockContext();","numLines":20,"startLine":285,"totalLines":372}}}

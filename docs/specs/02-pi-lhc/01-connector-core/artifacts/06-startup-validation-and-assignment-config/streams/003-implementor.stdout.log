{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_87092250601649d5a4b60e80","type":"tool_result","content":"100\t  getState(): SessionState | null;\n101\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n102\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n103\t  getInstance(): LhcInstance | null;\n104\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n105\t  snapshot(): ConnectorSnapshot;\n106\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n107\t   *  synthetic ctx/events without a live PI. */\n108\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n109\t}\n110\t\n111\t/** The connector's live capture state for one session: the open-turn\n112\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n113\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n114\t *  per session, never part of the plain-data snapshot and never a PI object. */\n115\tinterface CaptureSession {\n116\t  piSessionId: string;\n117\t  accumulator: TurnAccumulator;\n118\t  sourceSeq: number;\n119\t}\n120\t\n121\t/** Fork state captured from `session_before_fork` and used on the next\n122\t *  `session_start{fork}` to create and seed the forked thread. Plain data\n123\t *  only — no PI objects retained across the fork boundary. */\n124\tinterface PendingFork {\n125\t  sourceThreadRef: ThreadRef;\n126\t  forkEntryId: string;\n127\t}\n128\t\n129\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n130\t *  identity, which survives reload/replay (the same thread re-resolves to the\n131\t *  same id). */\n132\tfunction sessionIdOf(ref: ThreadRef): string {\n133\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n134\t}\n135\t\n136\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n137\t\n138\t/** The production SDK config for Story 5+: injects the host ModelCall function\n139\t *  that resolves provider/model through PI's registry and completes through\n140\t *  pi-ai when available. Story 6 will replace the first-available-model default\n141\t *  with explicit operator config. */\n142\tfunction defaultBuildSdkConfig(ctx: ExtensionContext): OpResult<SdkConfig> {\n143\t  const model = ctx.modelRegistry.getAvailable()[0];\n144\t  return {\n145\t    ok: true,\n146\t    value: {\n147\t      inference: {\n148\t        call: createModelCall(ctx),\n149\t        assignments: defaultAssignments(model),\n150\t      },\n151\t      mode: \"background\",\n152\t    },\n153\t  };\n154\t}\n155\t\n156\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n157\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n158\t *  show. */\n159\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n160\t  const lines = choices.map((choice, i) => {\n161\t    const title = choice.title ?? \"(untitled)\";\n162\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n163\t  });\n164\t  return [\n165\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n166\t    ...lines,\n167\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n168\t  ].join(\"\\n\");\n169\t}\n170\t\n171\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n172\t *  interactive input/selection surface (wiring research), so the production\n173\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n174\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n175\t *  most recently created thread as the best available explicit default. The\n176\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n177\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n178\t *  A true interactive picker awaits a PI input surface; until then resuming a\n179\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n180\t *  precise spec deviation. */\n181\tfunction defaultSelectThread(\n182\t  choices: readonly ThreadChoice[],\n183\t  ctx: ExtensionContext,\n184\t): Promise<string | null> {\n185\t  const mostRecent = choices.at(-1);\n186\t  if (mostRecent === undefined) return Promise.resolve(null);\n187\t  if (ctx.hasUI) {\n188\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n189\t  }\n190\t  return Promise.resolve(mostRecent.threadId);\n191\t}\n192\t\n193\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n194\t *  generated by the registry at creation, so the file name is just a unique\n195\t *  handle; the directory is ensured up front (DatabaseSync does not create\n196\t *  parents). */\n197\tfunction defaultNewThreadFilePath(): string {\n198\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n199\t  mkdirSync(dir, { recursive: true });\n200\t  return join(dir, `${randomUUID()}.sqlite`);\n201\t}\n202\t\n203\t/** Build a connector instance. Its mutable state lives in this closure; the\n204\t *  registered handlers capture it, so the instance stays live for the session\n205\t *  even when `activate` discards the returned object. The connector holds NO\n206\t *  module-level or durable state of its own — reload reconstructs the thread from\n207\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n208\t *  closure reattaches correctly (AC-1.5). */\n209\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n210\t  // The connector's retained state. `state` is plain data (the durable thread\n211\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n212\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n213\t  // none survives the connector — reload re-resolves from the registry.\n214\t  let state: SessionState | null = null;\n215\t  let instance: LhcInstance | null = null;\n216\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n217\t  let captureSession: CaptureSession | null = null;\n218\t  let pendingFork: PendingFork | null = null;\n219\t\n220\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n221\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n222\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n223\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n224\t\n225\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n226\t    return { code, message, recordedGap: false };\n227\t  }\n228\t\n229\t  // The registry/file deps every resolver path shares. `registryPath` is set\n230\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n231\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n232\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n233\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n234\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n235\t    return resolveDeps;\n236\t  }\n237\t\n238\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n239\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n240\t  // no-flag creates).\n241\t  async function resolveForLaunch(\n242\t    launch: LaunchFlags,\n243\t    ctx: ExtensionContext,\n244\t  ): Promise<OpResult<ThreadRef | null>> {\n245\t    if (launch.resume === true) {\n246\t      const pickerDeps: {\n247\t        registryPath?: string;\n248\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n249\t      } = { select: (choices) => selectThread(choices, ctx) };\n250\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n251\t      return pickThread(ctx.cwd, pickerDeps);\n252\t    }\n253\t    return resolveThread(launch, buildResolveDeps(ctx));\n254\t  }\n255\t\n256\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n257\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n258\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n259\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n260\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n261\t  async function resolveReloadFor(\n262\t    launch: LaunchFlags,\n263\t    ctx: ExtensionContext,\n264\t  ): Promise<OpResult<ThreadRef | null>> {\n265\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n266\t  }\n267\t\n268\t  // session_start: resolve the recording thread and construct one background\n269\t  // instance against it. Config is gated first so a session with no usable\n270\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n271\t  // thread is re-resolved from the durable registry (reattach, never create);\n272\t  // every other reason runs the normal launch resolution. Fork creates a new\n273\t  // thread and seeds it from the source thread (Story 4).\n274\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n275\t    const config = buildSdkConfig(ctx);\n276\t    if (!config.ok) {\n277\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n278\t      return;\n279\t    }\n280\t\n281\t    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n282\t    let forkAttempted = false;\n283\t\n284\t    // Fork path (Story 4): create a new thread and seed it from the source.\n285\t    // Detection relies on pendingFork from session_before_fork hook, with PI's\n286\t    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n287\t    if (pendingFork !== null) {\n288\t      forkAttempted = true;\n289\t      // Hook-based fork detection: session_before_fork fired.\n290\t      const { sourceThreadRef, forkEntryId } = pendingFork;\n291\t\n292\t      // Create a new thread for the fork.\n293\t      const resolveDeps = buildResolveDeps(ctx);\n294\t      const newFilePath = resolveDeps.newThreadFilePath();\n295\t      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n296\t        filePath: newFilePath,\n297\t        cwd: resolveDeps.cwd,\n298\t      };\n299\t      if (resolveDeps.registryPath !== undefined) {\n300\t        newThreadInput.registryPath = resolveDeps.registryPath;\n301\t      }\n302\t      const created = await threads.newThread(newThreadInput);\n303\t      if (!created.ok) {\n304\t        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n305\t        pendingFork = null;\n306\t        state = null;\n307\t        captureSession = null;\n308\t        return;\n309\t      } else {\n310\t        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n311\t\n312\t        // Initialize the instance against the target thread first (required for seedFork).\n313\t        const built = await initInstance(targetThreadRef, config.value);\n314\t        if (!built.ok) {\n315\t          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n316\t          pendingFork = null;\n317\t          state = null;\n318\t          captureSession = null;\n319\t          return;\n320\t        } else {\n321\t          instance = built.value;\n322\t\n323\t          // Seed the fork by replaying source events up to the fork point.\n324\t          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n325\t          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n326\t          if (!seeded.ok) {\n327\t            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n328\t            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n329\t            pendingFork = null;\n330\t            await disposeInstance(instance);\n331\t            instance = null;\n332\t            state = null;\n333\t            captureSession = null;\n334\t            return;\n335\t          } else {\n336\t            // Fork succeeded - clear pending fork state and use the forked thread.\n337\t            pendingFork = null;\n338\t            resolved = { ok: true, value: targetThreadRef };\n339\t          }\n340\t        }\n341\t      }\n342\t    }\n343\t\n344\t    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n345\t    // If pendingFork is null but we have a previous session, detect fork from session tree.\n346\t    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n347\t      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n348\t      if (forkFromTree !== null) {\n349\t        forkAttempted = true;\n350\t        // Session tree indicates a fork - create and seed as above.\n351\t        const { sourceThreadRef, forkEntryId } = forkFromTree;\n352\t\n353\t        const resolveDeps = buildResolveDeps(ctx);\n354\t        const newFilePath = resolveDeps.newThreadFilePath();\n355\t        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n356\t          filePath: newFilePath,\n357\t          cwd: resolveDeps.cwd,\n358\t        };\n359\t        if (resolveDeps.registryPath !== undefined) {\n360\t          newThreadInput.registryPath = resolveDeps.registryPath;\n361\t        }\n362\t        const created = await threads.newThread(newThreadInput);\n363\t        if (!created.ok) {\n364\t          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n365\t          state = null;\n366\t          captureSession = null;\n367\t          return;\n368\t        } else {\n369\t          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n370\t\n371\t          const built = await initInstance(targetThreadRef, config.value);\n372\t          if (!built.ok) {\n373\t            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n374\t            state = null;\n375\t            captureSession = null;\n376\t            return;\n377\t          } else {\n378\t            instance = built.value;\n379\t\n380\t            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n381\t            if (!seeded.ok) {\n382\t              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n383\t              await disposeInstance(instance);\n384\t              instance = null;\n385\t              state = null;\n386\t              captureSession = null;\n387\t              return;\n388\t            } else {\n389\t              resolved = { ok: true, value: targetThreadRef };\n390\t            }\n391\t          }\n392\t        }\n393\t      }\n394\t    }\n395\t\n396\t    // Normal launch resolution (if not resolved by fork paths above).\n397\t    if (resolved === undefined) {\n398\t      const launch = parseLaunch();\n399\t      const isReload = event.reason === \"reload\";"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"a7a10491-a0b4-45c4-84ab-cdedd6fc8d8e","timestamp":"2026-06-14T13:06:16.264Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator plus the stable PI session id used to scope idempotency keys.\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** Fork state captured from `session_before_fork` and used on the next\n *  `session_start{fork}` to create and seed the forked thread. Plain data\n *  only — no PI objects retained across the fork boundary. */\ninterface PendingFork {\n  sourceThreadRef: ThreadRef;\n  forkEntryId: string;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production SDK config for Story 5+: injects the host ModelCall function\n *  that resolves provider/model through PI's registry and completes through\n *  pi-ai when available. Story 6 will replace the first-available-model default\n *  with explicit operator config. */\nfunction defaultBuildSdkConfig(ctx: ExtensionContext): OpResult<SdkConfig> {\n  const model = ctx.modelRegistry.getAvailable()[0];\n  return {\n    ok: true,\n    value: {\n      inference: {\n        call: createModelCall(ctx),\n        assignments: defaultAssignments(model),\n      },\n      mode: \"background\",\n    },\n  };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n *  most recently created thread as the best available explicit default. The\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n *  takes the `select` seam); tests drive an explicit operator choice through it.\n *  A true interactive picker awaits a PI input surface; until then resuming a\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n *  precise spec deviation. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  if (mostRecent === undefined) return Promise.resolve(null);\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n  }\n  return Promise.resolve(mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n  let pendingFork: PendingFork | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution. Fork creates a new\n  // thread and seeds it from the source thread (Story 4).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\n    let forkAttempted = false;\n\n    // Fork path (Story 4): create a new thread and seed it from the source.\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\n    if (pendingFork !== null) {\n      forkAttempted = true;\n      // Hook-based fork detection: session_before_fork fired.\n      const { sourceThreadRef, forkEntryId } = pendingFork;\n\n      // Create a new thread for the fork.\n      const resolveDeps = buildResolveDeps(ctx);\n      const newFilePath = resolveDeps.newThreadFilePath();\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n        filePath: newFilePath,\n        cwd: resolveDeps.cwd,\n      };\n      if (resolveDeps.registryPath !== undefined) {\n        newThreadInput.registryPath = resolveDeps.registryPath;\n      }\n      const created = await threads.newThread(newThreadInput);\n      if (!created.ok) {\n        lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n        pendingFork = null;\n        state = null;\n        captureSession = null;\n        return;\n      } else {\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n        // Initialize the instance against the target thread first (required for seedFork).\n        const built = await initInstance(targetThreadRef, config.value);\n        if (!built.ok) {\n          lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n          pendingFork = null;\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          instance = built.value;\n\n          // Seed the fork by replaying source events up to the fork point.\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n          if (!seeded.ok) {\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\n            lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n            pendingFork = null;\n            await disposeInstance(instance);\n            instance = null;\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            // Fork succeeded - clear pending fork state and use the forked thread.\n            pendingFork = null;\n            resolved = { ok: true, value: targetThreadRef };\n          }\n        }\n      }\n    }\n\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\n      if (forkFromTree !== null) {\n        forkAttempted = true;\n        // Session tree indicates a fork - create and seed as above.\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\n\n        const resolveDeps = buildResolveDeps(ctx);\n        const newFilePath = resolveDeps.newThreadFilePath();\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\n          filePath: newFilePath,\n          cwd: resolveDeps.cwd,\n        };\n        if (resolveDeps.registryPath !== undefined) {\n          newThreadInput.registryPath = resolveDeps.registryPath;\n        }\n        const created = await threads.newThread(newThreadInput);\n        if (!created.ok) {\n          lastDiagnostic = diag(\"fork_thread_creation_failed\", created.error.reason);\n          state = null;\n          captureSession = null;\n          return;\n        } else {\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\n\n          const built = await initInstance(targetThreadRef, config.value);\n          if (!built.ok) {\n            lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n            state = null;\n            captureSession = null;\n            return;\n          } else {\n            instance = built.value;\n\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\n            if (!seeded.ok) {\n              lastDiagnostic = diag(\"fork_seed_failed\", seeded.error.reason);\n              await disposeInstance(instance);\n              instance = null;\n              state = null;\n              captureSession = null;\n              return;\n            } else {\n              resolved = { ok: true, value: targetThreadRef };\n            }\n          }\n        }\n      }\n    }\n\n    // Normal launch resolution (if not resolved by fork paths above).\n    if (resolved === undefined) {\n      const launch = parseLaunch();\n      const isReload = event.reason === \"reload\";","numLines":300,"startLine":100,"totalLines":653}}}

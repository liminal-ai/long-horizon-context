chronous SQLite chained through microtasks, while a background\\\\\\\\\\\\\\\\n// drain pass always starts on a macrotask (scheduler runLoop defers through\\\\\\\\\\\\\\\\n// setImmediate): the edit → delete → health reads inside the mutate phase\\\\\\\\\\\\\\\\n// run as one unbroken microtask cascade and complete before the poked drain\\\\\\\\\\\\\\\\n// can claim its first item. The rebuild phase then yields via drainSettled\\\\\\\\\\\\\\\\n// and the drain runs to empty.\\\\\\\\\\\\\\\\nimport { join } from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"node:path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nimport {\\\\\\\\\\\\\\\\n  createDeterministicProvider,\\\\\\\\\\\\\\\\n  createSdk,\\\\\\\\\\\\\\\\n  type BatchResult,\\\\\\\\\\\\\\\\n  type CompactReceipt,\\\\\\\\\\\\\\\\n  type FormReportEntry,\\\\\\\\\\\\\\\\n  type HealthReport,\\\\\\\\\\\\\\\\n  type InspectOverview,\\\\\\\\\\\\\\\\n  type Lhc,\\\\\\\\\\\\\\\\n  type MessageEventInput,\\\\\\\\\\\\\\\\n  type MutationResult,\\\\\\\\\\\\\\\\n  type OpResult,\\\\\\\\\\\\\\\\n  type PullResult,\\\\\\\\\\\\\\\\n  type ViewContentsReport,\\\\\\\\\\\\\\\\n  type ViewStatus,\\\\\\\\\\\\\\\\n} from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"../../src/index.js\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nimport { validEvent, type TempStore } from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"./index.js\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the one SDK configuration (AC-5.1) ────────────────────────────\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// Deterministic provider injected at construction (the only provider-arrival\\\\\\\\\\\\\\\\n// path since the CLI retired), background mode, zero-backoff retry so a\\\\\\\\\\\\\\\\n// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\\\\\\\\\\\\\\\n// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\\\\\\\\\\\\\\\n// a named \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" profile so compact runs profile-addressed (story\\\\\\\\\\\\\\\\n// scope: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"compact (profile)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") with all three lower bands non-empty on this\\\\\\\\\\\\\\\\n// thread (Epic 03 Story 2's reference gradient).\\\\\\\\\\\\\\\\nexport const LIFECYCLE_PROFILE = {\\\\\\\\\\\\\\\\n  name: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n  lowerBound: 400,\\\\\\\\\\\\\\\\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\\\\\\\\\\\\\\\n} as const;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function createLifecycleSdk(): Lhc {\\\\\\\\\\\\\\\\n  return createSdk({\\\\\\\\\\\\\\\\n    provider: createDeterministicProvider(),\\\\\\\\\\\\\\\\n    mode: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\\\\\\\\\\\\\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\\\\\\\\\\\\\\\n    view: {\\\\\\\\\\\\\\\\n      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\\\\\\\\\\\\\\\n      // Low threshold so the status checkpoint genuinely recommends the\\\\\\\\\\\\\\\\n      // compact the sequence performs next.\\\\\\\\\\\\\\\\n      compactThreshold: 300,\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the recorded conversation ─────────────────────────────────────\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// Same shape and text profile as the Epic 03 derived-thread fixture (12\\\\\\\\\\\\\\\\n// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\\\\\\\\\\\\\\\n// policy cuts the same 4-chunk shape — but with explicit per-run\\\\\\\\\\\\\\\\n// idempotency keys so a replay on a fresh thread records byte-identical\\\\\\\\\\\\\\\\n// event payloads regardless of any process-global fixture counters.\\\\\\\\\\\\\\\\nconst TURN_COUNT = 12;\\\\\\\\\\\\\\\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\\\\\\\\\\\\\\\nconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// Mutation targets: both in the post-compact tail (compact point at t9's\\\\\\\\\\\\\\\\n// start under the lifecycle profile), so the second compact's pull shows the\\\\\\\\\\\\\\\\n// edit verbatim and the deletion's absence — the tail is full fidelity.\\\\\\\\\\\\\\\\nexport const EDIT_TARGET = { turnId: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"t12\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" } as const;\\\\\\\\\\\\\\\\nexport const EDITED_MESSAGE_TEXT =\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nexport const DELETE_TARGET = { turnId: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"t10\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" } as const;\\\\\\\\\\\\\\\\nexport const DELETED_MESSAGE_TEXT = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"findings for area 10\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction turnEvents(turn: number): MessageEventInput[] {\\\\\\\\\\\\\\\\n  let seq = 0;\\\\\\\\\\\\\\\\n  const key = (): string => {\\\\\\\\\\\\\\\\n    seq += 1;\\\\\\\\\\\\\\\\n    return `lc-t${turn}-e${seq}`;\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  const events: MessageEventInput[] = [\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n      idempotencyKey: key(),\\\\\\\\\\\\\\\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\\\\\\\\\\\\\\\n    }),\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"assistant_thinking\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n      idempotencyKey: key(),\\\\\\\\\\\\\\\\n      payload: { text: `considering what area ${turn} contains` },\\\\\\\\\\\\\\\\n    }),\\\\\\\\\\\\\\\\n  ];\\\\\\\\\\\\\\\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\\\\\\\\\\\\\\\n    for (const run of [1, 2]) {\\\\\\\\\\\\\\\\n      const toolCallId = `call-lc-${turn}-${run}`;\\\\\\\\\\\\\\\\n      events.push(\\\\\\\\\\\\\\\\n        validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n          idempotencyKey: key(),\\\\\\\\\\\\\\\\n          payload: {\\\\\\\\\\\\\\\\n            toolCallId,\\\\\\\\\\\\\\\\n            toolName: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"read_file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\n        }),\\\\\\\\\\\\\\\\n        validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n          idempotencyKey: key(),\\\\\\\\\\\\\\\\n          payload: {\\\\\\\\\\\\\\\\n            toolCallId,\\\\\\\\\\\\\\\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\\\\\\\\\\\\\\\n            isError: false,\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\n        }),\\\\\\\\\\\\\\\\n      );\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  events.push(\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n      idempotencyKey: key(),\\\\\\\\\\\\\\\\n      payload: { text: `findings for area ${turn}` },\\\\\\\\\\\\\\\\n    }),\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", { idempotencyKey: key() }),\\\\\\\\\\\\\\\\n  );\\\\\\\\\\\\\\\\n  return events;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction intakeBatches(): MessageEventInput[][] {\\\\\\\\\\\\\\\\n  const batches: MessageEventInput[][] = [];\\\\\\\\\\\\\\\\n  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\\\\\\\\\\\\\\\n    const batch: MessageEventInput[] = [];\\\\\\\\\\\\\\\\n    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\\\\\\\\\\\\\\\n      batch.push(...turnEvents(turn));\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    batches.push(batch);\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return batches;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── run shape ─────────────────────────────────────────────────────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface LifecyclePhases {\\\\\\\\\\\\\\\\n  create: OpResult<{ threadId: string; filePath: string }>;\\\\\\\\\\\\\\\\n  intake: Array<OpResult<BatchResult>>;\\\\\\\\\\\\\\\\n  drain: { settled: true };\\\\\\\\\\\\\\\\n  status: OpResult<ViewStatus>;\\\\\\\\\\\\\\\\n  compact1: OpResult<CompactReceipt>;\\\\\\\\\\\\\\\\n  pull1: OpResult<PullResult>;\\\\\\\\\\\\\\\\n  inspect1: {\\\\\\\\\\\\\\\\n    overview: OpResult<InspectOverview>;\\\\\\\\\\\\\\\\n    view: OpResult<ViewContentsReport>;\\\\\\\\\\\\\\\\n    health: OpResult<HealthReport>;\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  mutate: {\\\\\\\\\\\\\\\\n    editedMessageId: string;\\\\\\\\\\\\\\\\n    deletedMessageId: string;\\\\\\\\\\\\\\\\n    edit: OpResult<MutationResult>;\\\\\\\\\\\\\\\\n    delete: OpResult<MutationResult>;\\\\\\\\\\\\\\\\n    // Captured inside the mutate phase, before the background drain's first\\\\\\\\\\\\\\\\n    // macrotask: the cleared-set-pending evidence (AC-5.2).\\\\\\\\\\\\\\\\n    healthAfterMutate: OpResult<HealthReport>;\\\\\\\\\\\\\\\\n    messagesNotReady: OpResult<FormReportEntry[]>;\\\\\\\\\\\\\\\\n    turnsNotReady: OpResult<FormReportEntry[]>;\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  rebuild: { settled: true };\\\\\\\\\\\\\\\\n  health2: OpResult<HealthReport>;\\\\\\\\\\\\\\\\n  compact2: OpResult<CompactReceipt>;\\\\\\\\\\\\\\\\n  pull2: OpResult<PullResult>;\\\\\\\\\\\\\\\\n  materialize: OpResult<{ writtenPath: string }>;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type LifecycleCheckpoint = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface LifecycleOptions {\\\\\\\\\\\\\\\\n  // Distinguishes the thread file and materialize target so replay and\\\\\\\\\\\\\\\\n  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\\\\\\\\\\\\\\\n  name?: string;\\\\\\\\\\\\\\\\n  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\\\\\\\\\\\\\\\n  // render phase groups — every group boundary is a quiescent point (no\\\\\\\\\\\\\\\\n  // queued work, no running drain), so the abandoned instance can never act\\\\\\\\\\\\\\\\n  // after its group ends.\\\\\\\\\\\\\\\\n  freshSdkBetweenGroups?: boolean;\\\\\\\\\\\\\\\\n  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\\\\\\\\\\\\\\\n  onCheckpoint?: (\\\\\\\\\\\\\\\\n    checkpoint: LifecycleCheckpoint,\\\\\\\\\\\\\\\\n    ctx: { sdk: Lhc; filePath: string },\\\\\\\\\\\\\\\\n  ) => Promise<void>;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface LifecycleRun {\\\\\\\\\\\\\\\\n  filePath: string;\\\\\\\\\\\\\\\\n  outPath: string;\\\\\\\\\\\\\\\\n  threadId: string;\\\\\\\\\\\\\\\\n  phases: LifecyclePhases;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\\\\\\\\\\\\\\\n  if (!result.ok) {\\\\\\\\\\\\\\\\n    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return result.value;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the sequence ──────────────────────────────────────────────────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport async function runLifecycle(\\\\\\\\\\\\\\\\n  store: TempStore,\\\\\\\\\\\\\\\\n  opts: LifecycleOptions = {},\\\\\\\\\\\\\\\\n): Promise<LifecycleRun> {\\\\\\\\\\\\\\\\n  const name = opts.name ?? \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n  const filePath = store.threadPath(name);\\\\\\\\\\\\\\\\n  const outPath = join(store.dir, `${name}-session.jsonl`);\\\\\\\\\\\\\\\\n  const ref = { filePath };\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  let sdk = createLifecycleSdk();\\\\\\\\\\\\\\\\n  const nextGroup = (): void => {\\\\\\\\\\\\\\\\n    // The fresh instance is the same configuration assembled again — the\\\\\\\\\\\\\\\\n    // continuity proof is that no phase depends on the prior instance's\\\\\\\\\\\\\\\\n    // memory, only on the thread file.\\\\\\\\\\\\\\\\n    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\\\\\\\\\\\\\\\n    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 1: create → intake → drain → status ──\\\\\\\\\\\\\\\\n  const create = await sdk.threads.newThread({\\\\\\\\\\\\\\\\n    filePath,\\\\\\\\\\\\\\\\n    registryPath: store.registryPath,\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n  const threadId = expectOk(create, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"create\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").threadId;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const intake: Array<OpResult<BatchResult>> = [];\\\\\\\\\\\\\\\\n  for (const batch of intakeBatches()) {\\\\\\\\\\\\\\\\n    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\\\\\\\\\\\\\\\n    intake.push(sent);\\\\\\\\\\\\\\\\n    expectOk(sent, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"intake\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // Background drain settles (story scope): the intake pokes scheduled the\\\\\\\\\\\\\\\\n  // work; this is the await that lets the scheduler run it to empty.\\\\\\\\\\\\\\\\n  await sdk.drainSettled(ref);\\\\\\\\\\\\\\\\n  const drain = { settled: true } as const;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const status = await sdk.threadView.status(ref);\\\\\\\\\\\\\\\\n  expectOk(status, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 2: compact1 → pull1 → inspect1 ──\\\\\\\\\\\\\\\\n  nextGroup();\\\\\\\\\\\\\\\\n  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\\\\\\\\\n  expectOk(compact1, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"compact1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const pull1 = await sdk.threadView.pull(ref);\\\\\\\\\\\\\\\\n  expectOk(pull1, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pull1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const inspect1 = {\\\\\\\\\\\\\\\\n    overview: await sdk.inspect.overview(ref),\\\\\\\\\\\\\\\\n    view: await sdk.inspect.view(ref),\\\\\\\\\\\\\\\\n    health: await sdk.inspect.health(ref),\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  expectOk(inspect1.overview, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1.overview\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(inspect1.view, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1.view\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(inspect1.health, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1.health\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 3: mutate → rebuild → health2 ──\\\\\\\\\\\\\\\\n  nextGroup();\\\\\\\\\\\\\\\\n  const listed = expectOk(await sdk.messages.listMessages(ref), \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.list\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const editTarget = listed.find(\\\\\\\\\\\\\\\\n    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\\\\\\\\\\\\\\\n  );\\\\\\\\\\\\\\\\n  const deleteTarget = listed.find(\\\\\\\\\\\\\\\\n    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\\\\\\\\\\\\\\\n  );\\\\\\\\\\\\\\\\n  if (editTarget === undefined || deleteTarget === undefined) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle invariant: edit/delete targets not found in the record\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  // Edit, delete, and the pending-state reads run in one microtask cascade\\\\\\\\\\\\\\\\n  // (see module header): the snapshot is taken before the poked background\\\\\\\\\\\\\\\\n  // drain starts its first pass.\\\\\\\\\\\\\\\\n  const edit = await sdk.messages.edit(ref, {\\\\\\\\\\\\\\\\n    messageId: editTarget.messageId,\\\\\\\\\\\\\\\\n    content: EDITED_MESSAGE_TEXT,\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n  expectOk(edit, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.edit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\\\\\\\\\\\\\\\n  expectOk(deleted, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.delete\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const mutate: LifecyclePhases[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] = {\\\\\\\\\\\\\\\\n    editedMessageId: editTarget.messageId,\\\\\\\\\\\\\\\\n    deletedMessageId: deleteTarget.messageId,\\\\\\\\\\\\\\\\n    edit,\\\\\\\\\\\\\\\\n    delete: deleted,\\\\\\\\\\\\\\\\n    healthAfterMutate: await sdk.inspect.health(ref),\\\\\\\\\\\\\\\\n    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\\\\\\\\\\\\\\\n    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  expectOk(mutate.healthAfterMutate, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.health\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(mutate.messagesNotReady, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.messagesNotReady\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(mutate.turnsNotReady, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.turnsNotReady\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // Rebuild drains: the mutations' pokes already scheduled the cascade\\\\\\\\\\\\\\\\n  // rebuilds on THIS instance's scheduler; settle is the production await.\\\\\\\\\\\\\\\\n  await sdk.drainSettled(ref);\\\\\\\\\\\\\\\\n  const rebuild = { settled: true } as const;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const health2 = await sdk.inspect.health(ref);\\\\\\\\\\\\\\\\n  expectOk(health2, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 4: compact2 → pull2 → materialize ──\\\\\\\\\\\\\\\\n  nextGroup();\\\\\\\\\\\\\\\\n  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\\\\\\\\\n  expectOk(compact2, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"compact2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const pull2 = await sdk.threadView.pull(ref);\\\\\\\\\\\\\\\\n  expectOk(pull2, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pull2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\\\\\\\\\\\\\\\n  expectOk(materialize, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    filePath,\\\\\\\\\\\\\\\\n    outPath,\\\\\\\\\\\\\\\\n    threadId,\\\\\\\\\\\\\\\\n    phases: {\\\\\\\\\\\\\\\\n      create,\\\\\\\\\\\\\\\\n      intake,\\\\\\\\\\\\\\\\n      drain,\\\\\\\\\\\\\\\\n      status,\\\\\\\\\\\\\\\\n      compact1,\\\\\\\\\\\\\\\\n      pull1,\\\\\\\\\\\\\\\\n      inspect1,\\\\\\\\\\\\\\\\n      mutate,\\\\\\\\\\\\\\\\n      rebuild,\\\\\\\\\\\\\\\\n      health2,\\\\\\\\\\\\\\\\n      compact2,\\\\\\\\\\\\\\\\n      pull2,\\\\\\\\\\\\\\\\n      materialize,\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"structuredPatch\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"oldStart\\\\\\\\\\\\\\\":24,\\\\\\\\\\\\\\\"oldLines\\\\\\\\\\\\\\\":6,\\\\\\\\\\\\\\\"newStart\\\\\\\\\\\\\\\":24,\\\\\\\\\\\\\\\"newLines\\\\\\\\\\\\\\\":7,\\\\\\\\\\\\\\\"lines\\\\\\\\\\\\\\\":[\\\\\\\\\\\\\\\"   createDeterministicProvider,\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"   createSdk,\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"   type BatchResult,\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"+  type InferenceConfig,\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"   type CompactReceipt,\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"   type FormReportEntry,\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"   type HealthReport,\\\\\\\\\\\\\\\"]}],\\\\\\\\\\\\\\\"userModified\\\\\\\\\\\\\\\":false,\\\\\\\\\\\\\\\"replaceAll\\\\\\\\\\\\\\\":false}}\\\\\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:887:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"stream_event\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"event\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"content_block_delta\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"index\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"delta\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"input_json_delta\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"partial_json\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"ase names, and every other configuration value stay owned here\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n// so the deterministic leg and the real le\\\\\\\\\\\\\\\"}},\\\\\\\\\\\\\\\"session_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"parent_tool_use_id\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"uuid\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"31865bb8-3fa1-4f77-8581-204e0e146e4e\\\\\\\\\\\\\\\"}\\\\\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:891:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"assistant\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"model\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"claude-fable-5\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"msg_01JD2DwgAh8k6kTu2KDFE3CL\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"assistant\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_use\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"toolu_011Vfe2JCrSbnkyBC2KMAMCh\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Edit\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"input\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"replace_all\\\\\\\\\\\\\\\":false,\\\\\\\\\\\\\\\"file_path\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"old_string\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"export function createLifecycleSdk(): Lhc {\\\\\\\\\\\\\\\\n  return createSdk({\\\\\\\\\\\\\\\\n    provider: createDeterministicProvider(),\\\\\\\\\\\\\\\\n    mode: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"new_string\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"// Epic 05 TC-4.2: the capstone replays this exact sequence with the real\\\\\\\\\\\\\\\\n// inference adapter — the provider-arrival slot is the one swap point; the\\\\\\\\\\\\\\\\n// sequence, phase names, and every other configuration value stay owned here\\\\\\\\\\\\\\\\n// so the deterministic leg and the real leg run THE SAME lifecycle.\\\\\\\\\\\\\\\\nexport function createLifecycleSdk(inference?: InferenceConfig): Lhc {\\\\\\\\\\\\\\\\n  return createSdk({\\\\\\\\\\\\\\\\n    ...(inference !== undefined\\\\\\\\\\\\\\\\n      ? { inference }\\\\\\\\\\\\\\\\n      : { provider: createDeterministicProvider() }),\\\\\\\\\\\\\\\\n    mode: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"},\\\\\\\\\\\\\\\"caller\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"direct\\\\\\\\\\\\\\\"}}],\\\\\\\\\\\\\\\"stop_reason\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"stop_sequence\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"stop_details\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"usage\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"input_tokens\\\\\\\\\\\\\\\":2,\\\\\\\\\\\\\\\"cache_creation_input_tokens\\\\\\\\\\\\\\\":561,\\\\\\\\\\\\\\\"cache_read_input_tokens\\\\\\\\\\\\\\\":115936,\\\\\\\\\\\\\\\"cache_creation\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"ephemeral_5m_input_tokens\\\\\\\\\\\\\\\":0,\\\\\\\\\\\\\\\"ephemeral_1h_input_tokens\\\\\\\\\\\\\\\":561},\\\\\\\\\\\\\\\"output_tokens\\\\\\\\\\\\\\\":50,\\\\\\\\\\\\\\\"service_tier\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"standard\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"inference_geo\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"not_available\\\\\\\\\\\\\\\"},\\\\\\\\\\\\\\\"diagnostics\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"context_management\\\\\\\\\\\\\\\":null},\\\\\\\\\\\\\\\"parent_tool_use_id\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"session_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"uuid\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"ac5e4d05-04ad-41f9-a4f9-ff4f93e31fea\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"request_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"req_011CbzENV9E2TiKRTpN99FVz\\\\\\\\\\\\\\\"}\\\\\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:894:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"tool_use_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"toolu_011Vfe2JCrSbnkyBC2KMAMCh\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts has been updated successfully. (file state is current in your context — no need to Read it back)\\\\\\\\\\\\\\\"}]},\\\\\\\\\\\\\\\"parent_tool_use_id\\\\\\\\\\\\\\\":null,\\\\\\\\\\\\\\\"session_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"uuid\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"1a384497-d2a3-489f-9f02-b7e33cd3d191\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"timestamp\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"2026-06-12T23:26:53.422Z\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tool_use_result\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"filePath\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"oldString\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"export function createLifecycleSdk(): Lhc {\\\\\\\\\\\\\\\\n  return createSdk({\\\\\\\\\\\\\\\\n    provider: createDeterministicProvider(),\\\\\\\\\\\\\\\\n    mode: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"newString\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"// Epic 05 TC-4.2: the capstone replays this exact sequence with the real\\\\\\\\\\\\\\\\n// inference adapter — the provider-arrival slot is the one swap point; the\\\\\\\\\\\\\\\\n// sequence, phase names, and every other configuration value stay owned here\\\\\\\\\\\\\\\\n// so the deterministic leg and the real leg run THE SAME lifecycle.\\\\\\\\\\\\\\\\nexport function createLifecycleSdk(inference?: InferenceConfig): Lhc {\\\\\\\\\\\\\\\\n  return createSdk({\\\\\\\\\\\\\\\\n    ...(inference !== undefined\\\\\\\\\\\\\\\\n      ? { inference }\\\\\\\\\\\\\\\\n      : { provider: createDeterministicProvider() }),\\\\\\\\\\\\\\\\n    mode: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"originalFile\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\\\\\\\\\\\\\\\n// driven once, in PI-extension call order, against one real SDK\\\\\\\\\\\\\\\\n// configuration with the deterministic provider — zero network, zero real\\\\\\\\\\\\\\\\n// provider, no mocks anywhere. The script owns the sequence and the phase\\\\\\\\\\\\\\\\n// names (tech design Flow 5); assertions live in the driving tests, so the\\\\\\\\\\\\\\\\n// replay, teardown, and process legs all run THIS sequence rather than a\\\\\\\\\\\\\\\\n// re-described one (DD-8).\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\\\\\\\\\\\\\\\n// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// Mode is background — the production posture the PI extension will run —\\\\\\\\\\\\\\\\n// and the drain/rebuild phases settle through `drainSettled`, the real\\\\\\\\\\\\\\\\n// background awaitable. The post-mutation health snapshot (AC-5.2's\\\\\\\\\\\\\\\\n// \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"cleared set pending\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") is deterministic because every SDK operation here\\\\\\\\\\\\\\\\n// is synchronous SQLite chained through microtasks, while a background\\\\\\\\\\\\\\\\n// drain pass always starts on a macrotask (scheduler runLoop defers through\\\\\\\\\\\\\\\\n// setImmediate): the edit → delete → health reads inside the mutate phase\\\\\\\\\\\\\\\\n// run as one unbroken microtask cascade and complete before the poked drain\\\\\\\\\\\\\\\\n// can claim its first item. The rebuild phase then yields via drainSettled\\\\\\\\\\\\\\\\n// and the drain runs to empty.\\\\\\\\\\\\\\\\nimport { join } from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"node:path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nimport {\\\\\\\\\\\\\\\\n  createDeterministicProvider,\\\\\\\\\\\\\\\\n  createSdk,\\\\\\\\\\\\\\\\n  type BatchResult,\\\\\\\\\\\\\\\\n  type InferenceConfig,\\\\\\\\\\\\\\\\n  type CompactReceipt,\\\\\\\\\\\\\\\\n  type FormReportEntry,\\\\\\\\\\\\\\\\n  type HealthReport,\\\\\\\\\\\\\\\\n  type InspectOverview,\\\\\\\\\\\\\\\\n  type Lhc,\\\\\\\\\\\\\\\\n  type MessageEventInput,\\\\\\\\\\\\\\\\n  type MutationResult,\\\\\\\\\\\\\\\\n  type OpResult,\\\\\\\\\\\\\\\\n  type PullResult,\\\\\\\\\\\\\\\\n  type ViewContentsReport,\\\\\\\\\\\\\\\\n  type ViewStatus,\\\\\\\\\\\\\\\\n} from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"../../src/index.js\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nimport { validEvent, type TempStore } from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"./index.js\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the one SDK configuration (AC-5.1) ────────────────────────────\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// Deterministic provider injected at construction (the only provider-arrival\\\\\\\\\\\\\\\\n// path since the CLI retired), background mode, zero-backoff retry so a\\\\\\\\\\\\\\\\n// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\\\\\\\\\\\\\\\n// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\\\\\\\\\\\\\\\n// a named \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" profile so compact runs profile-addressed (story\\\\\\\\\\\\\\\\n// scope: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"compact (profile)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") with all three lower bands non-empty on this\\\\\\\\\\\\\\\\n// thread (Epic 03 Story 2's reference gradient).\\\\\\\\\\\\\\\\nexport const LIFECYCLE_PROFILE = {\\\\\\\\\\\\\\\\n  name: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n  lowerBound: 400,\\\\\\\\\\\\\\\\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\\\\\\\\\\\\\\\n} as const;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function createLifecycleSdk(): Lhc {\\\\\\\\\\\\\\\\n  return createSdk({\\\\\\\\\\\\\\\\n    provider: createDeterministicProvider(),\\\\\\\\\\\\\\\\n    mode: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\\\\\\\\\\\\\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\\\\\\\\\\\\\\\n    view: {\\\\\\\\\\\\\\\\n      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\\\\\\\\\\\\\\\n      // Low threshold so the status checkpoint genuinely recommends the\\\\\\\\\\\\\\\\n      // compact the sequence performs next.\\\\\\\\\\\\\\\\n      compactThreshold: 300,\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the recorded conversation ─────────────────────────────────────\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// Same shape and text profile as the Epic 03 derived-thread fixture (12\\\\\\\\\\\\\\\\n// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\\\\\\\\\\\\\\\n// policy cuts the same 4-chunk shape — but with explicit per-run\\\\\\\\\\\\\\\\n// idempotency keys so a replay on a fresh thread records byte-identical\\\\\\\\\\\\\\\\n// event payloads regardless of any process-global fixture counters.\\\\\\\\\\\\\\\\nconst TURN_COUNT = 12;\\\\\\\\\\\\\\\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\\\\\\\\\\\\\\\nconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// Mutation targets: both in the post-compact tail (compact point at t9's\\\\\\\\\\\\\\\\n// start under the lifecycle profile), so the second compact's pull shows the\\\\\\\\\\\\\\\\n// edit verbatim and the deletion's absence — the tail is full fidelity.\\\\\\\\\\\\\\\\nexport const EDIT_TARGET = { turnId: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"t12\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" } as const;\\\\\\\\\\\\\\\\nexport const EDITED_MESSAGE_TEXT =\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nexport const DELETE_TARGET = { turnId: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"t10\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" } as const;\\\\\\\\\\\\\\\\nexport const DELETED_MESSAGE_TEXT = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"findings for area 10\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction turnEvents(turn: number): MessageEventInput[] {\\\\\\\\\\\\\\\\n  let seq = 0;\\\\\\\\\\\\\\\\n  const key = (): string => {\\\\\\\\\\\\\\\\n    seq += 1;\\\\\\\\\\\\\\\\n    return `lc-t${turn}-e${seq}`;\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  const events: MessageEventInput[] = [\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n      idempotencyKey: key(),\\\\\\\\\\\\\\\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\\\\\\\\\\\\\\\n    }),\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"assistant_thinking\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n      idempotencyKey: key(),\\\\\\\\\\\\\\\\n      payload: { text: `considering what area ${turn} contains` },\\\\\\\\\\\\\\\\n    }),\\\\\\\\\\\\\\\\n  ];\\\\\\\\\\\\\\\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\\\\\\\\\\\\\\\n    for (const run of [1, 2]) {\\\\\\\\\\\\\\\\n      const toolCallId = `call-lc-${turn}-${run}`;\\\\\\\\\\\\\\\\n      events.push(\\\\\\\\\\\\\\\\n        validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n          idempotencyKey: key(),\\\\\\\\\\\\\\\\n          payload: {\\\\\\\\\\\\\\\\n            toolCallId,\\\\\\\\\\\\\\\\n            toolName: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"read_file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\n        }),\\\\\\\\\\\\\\\\n        validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n          idempotencyKey: key(),\\\\\\\\\\\\\\\\n          payload: {\\\\\\\\\\\\\\\\n            toolCallId,\\\\\\\\\\\\\\\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\\\\\\\\\\\\\\\n            isError: false,\\\\\\\\\\\\\\\\n          },\\\\\\\\\\\\\\\\n        }),\\\\\\\\\\\\\\\\n      );\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  events.push(\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", {\\\\\\\\\\\\\\\\n      idempotencyKey: key(),\\\\\\\\\\\\\\\\n      payload: { text: `findings for area ${turn}` },\\\\\\\\\\\\\\\\n    }),\\\\\\\\\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", { idempotencyKey: key() }),\\\\\\\\\\\\\\\\n  );\\\\\\\\\\\\\\\\n  return events;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction intakeBatches(): MessageEventInput[][] {\\\\\\\\\\\\\\\\n  const batches: MessageEventInput[][] = [];\\\\\\\\\\\\\\\\n  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\\\\\\\\\\\\\\\n    const batch: MessageEventInput[] = [];\\\\\\\\\\\\\\\\n    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\\\\\\\\\\\\\\\n      batch.push(...turnEvents(turn));\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    batches.push(batch);\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return batches;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── run shape ─────────────────────────────────────────────────────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface LifecyclePhases {\\\\\\\\\\\\\\\\n  create: OpResult<{ threadId: string; filePath: string }>;\\\\\\\\\\\\\\\\n  intake: Array<OpResult<BatchResult>>;\\\\\\\\\\\\\\\\n  drain: { settled: true };\\\\\\\\\\\\\\\\n  status: OpResult<ViewStatus>;\\\\\\\\\\\\\\\\n  compact1: OpResult<CompactReceipt>;\\\\\\\\\\\\\\\\n  pull1: OpResult<PullResult>;\\\\\\\\\\\\\\\\n  inspect1: {\\\\\\\\\\\\\\\\n    overview: OpResult<InspectOverview>;\\\\\\\\\\\\\\\\n    view: OpResult<ViewContentsReport>;\\\\\\\\\\\\\\\\n    health: OpResult<HealthReport>;\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  mutate: {\\\\\\\\\\\\\\\\n    editedMessageId: string;\\\\\\\\\\\\\\\\n    deletedMessageId: string;\\\\\\\\\\\\\\\\n    edit: OpResult<MutationResult>;\\\\\\\\\\\\\\\\n    delete: OpResult<MutationResult>;\\\\\\\\\\\\\\\\n    // Captured inside the mutate phase, before the background drain's first\\\\\\\\\\\\\\\\n    // macrotask: the cleared-set-pending evidence (AC-5.2).\\\\\\\\\\\\\\\\n    healthAfterMutate: OpResult<HealthReport>;\\\\\\\\\\\\\\\\n    messagesNotReady: OpResult<FormReportEntry[]>;\\\\\\\\\\\\\\\\n    turnsNotReady: OpResult<FormReportEntry[]>;\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  rebuild: { settled: true };\\\\\\\\\\\\\\\\n  health2: OpResult<HealthReport>;\\\\\\\\\\\\\\\\n  compact2: OpResult<CompactReceipt>;\\\\\\\\\\\\\\\\n  pull2: OpResult<PullResult>;\\\\\\\\\\\\\\\\n  materialize: OpResult<{ writtenPath: string }>;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport type LifecycleCheckpoint = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface LifecycleOptions {\\\\\\\\\\\\\\\\n  // Distinguishes the thread file and materialize target so replay and\\\\\\\\\\\\\\\\n  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\\\\\\\\\\\\\\\n  name?: string;\\\\\\\\\\\\\\\\n  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\\\\\\\\\\\\\\\n  // render phase groups — every group boundary is a quiescent point (no\\\\\\\\\\\\\\\\n  // queued work, no running drain), so the abandoned instance can never act\\\\\\\\\\\\\\\\n  // after its group ends.\\\\\\\\\\\\\\\\n  freshSdkBetweenGroups?: boolean;\\\\\\\\\\\\\\\\n  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\\\\\\\\\\\\\\\n  onCheckpoint?: (\\\\\\\\\\\\\\\\n    checkpoint: LifecycleCheckpoint,\\\\\\\\\\\\\\\\n    ctx: { sdk: Lhc; filePath: string },\\\\\\\\\\\\\\\\n  ) => Promise<void>;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport interface LifecycleRun {\\\\\\\\\\\\\\\\n  filePath: string;\\\\\\\\\\\\\\\\n  outPath: string;\\\\\\\\\\\\\\\\n  threadId: string;\\\\\\\\\\\\\\\\n  phases: LifecyclePhases;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\\\\\\\\\\\\\\\n  if (!result.ok) {\\\\\\\\\\\\\\\\n    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return result.value;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the sequence ──────────────────────────────────────────────────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport async function runLifecycle(\\\\\\\\\\\\\\\\n  store: TempStore,\\\\\\\\\\\\\\\\n  opts: LifecycleOptions = {},\\\\\\\\\\\\\\\\n): Promise<LifecycleRun> {\\\\\\\\\\\\\\\\n  const name = opts.name ?? \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n  const filePath = store.threadPath(name);\\\\\\\\\\\\\\\\n  const outPath = join(store.dir, `${name}-session.jsonl`);\\\\\\\\\\\\\\\\n  const ref = { filePath };\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  let sdk = createLifecycleSdk();\\\\\\\\\\\\\\\\n  const nextGroup = (): void => {\\\\\\\\\\\\\\\\n    // The fresh instance is the same configuration assembled again — the\\\\\\\\\\\\\\\\n    // continuity proof is that no phase depends on the prior instance's\\\\\\\\\\\\\\\\n    // memory, only on the thread file.\\\\\\\\\\\\\\\\n    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\\\\\\\\\\\\\\\n    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 1: create → intake → drain → status ──\\\\\\\\\\\\\\\\n  const create = await sdk.threads.newThread({\\\\\\\\\\\\\\\\n    filePath,\\\\\\\\\\\\\\\\n    registryPath: store.registryPath,\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n  const threadId = expectOk(create, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"create\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").threadId;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const intake: Array<OpResult<BatchResult>> = [];\\\\\\\\\\\\\\\\n  for (const batch of intakeBatches()) {\\\\\\\\\\\\\\\\n    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\\\\\\\\\\\\\\\n    intake.push(sent);\\\\\\\\\\\\\\\\n    expectOk(sent, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"intake\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // Background drain settles (story scope): the intake pokes scheduled the\\\\\\\\\\\\\\\\n  // work; this is the await that lets the scheduler run it to empty.\\\\\\\\\\\\\\\\n  await sdk.drainSettled(ref);\\\\\\\\\\\\\\\\n  const drain = { settled: true } as const;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const status = await sdk.threadView.status(ref);\\\\\\\\\\\\\\\\n  expectOk(status, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 2: compact1 → pull1 → inspect1 ──\\\\\\\\\\\\\\\\n  nextGroup();\\\\\\\\\\\\\\\\n  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\\\\\\\\\n  expectOk(compact1, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"compact1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const pull1 = await sdk.threadView.pull(ref);\\\\\\\\\\\\\\\\n  expectOk(pull1, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pull1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const inspect1 = {\\\\\\\\\\\\\\\\n    overview: await sdk.inspect.overview(ref),\\\\\\\\\\\\\\\\n    view: await sdk.inspect.view(ref),\\\\\\\\\\\\\\\\n    health: await sdk.inspect.health(ref),\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  expectOk(inspect1.overview, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1.overview\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(inspect1.view, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1.view\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(inspect1.health, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1.health\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 3: mutate → rebuild → health2 ──\\\\\\\\\\\\\\\\n  nextGroup();\\\\\\\\\\\\\\\\n  const listed = expectOk(await sdk.messages.listMessages(ref), \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.list\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const editTarget = listed.find(\\\\\\\\\\\\\\\\n    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\\\\\\\\\\\\\\\n  );\\\\\\\\\\\\\\\\n  const deleteTarget = listed.find(\\\\\\\\\\\\\\\\n    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\\\\\\\\\\\\\\\n  );\\\\\\\\\\\\\\\\n  if (editTarget === undefined || deleteTarget === undefined) {\\\\\\\\\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"lifecycle invariant: edit/delete targets not found in the record\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  // Edit, delete, and the pending-state reads run in one microtask cascade\\\\\\\\\\\\\\\\n  // (see module header): the snapshot is taken before the poked background\\\\\\\\\\\\\\\\n  // drain starts its first pass.\\\\\\\\\\\\\\\\n  const edit = await sdk.messages.edit(ref, {\\\\\\\\\\\\\\\\n    messageId: editTarget.messageId,\\\\\\\\\\\\\\\\n    content: EDITED_MESSAGE_TEXT,\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n  expectOk(edit, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.edit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\\\\\\\\\\\\\\\n  expectOk(deleted, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.delete\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const mutate: LifecyclePhases[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"] = {\\\\\\\\\\\\\\\\n    editedMessageId: editTarget.messageId,\\\\\\\\\\\\\\\\n    deletedMessageId: deleteTarget.messageId,\\\\\\\\\\\\\\\\n    edit,\\\\\\\\\\\\\\\\n    delete: deleted,\\\\\\\\\\\\\\\\n    healthAfterMutate: await sdk.inspect.health(ref),\\\\\\\\\\\\\\\\n    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\\\\\\\\\\\\\\\n    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n  expectOk(mutate.healthAfterMutate, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.health\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(mutate.messagesNotReady, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.messagesNotReady\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  expectOk(mutate.turnsNotReady, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutate.turnsNotReady\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // Rebuild drains: the mutations' pokes already scheduled the cascade\\\\\\\\\\\\\\\\n  // rebuilds on THIS instance's scheduler; settle is the production await.\\\\\\\\\\\\\\\\n  await sdk.drainSettled(ref);\\\\\\\\\\\\\\\\n  const rebuild = { settled: true } as const;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  const health2 = await sdk.inspect.health(ref);\\\\\\\\\\\\\\\\n  expectOk(health2, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  // ── group 4: compact2 → pull2 → materialize ──\\\\\\\\\\\\\\\\n  nextGroup();\\\\\\\\\\\\\\\\n  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\\\\\\\\\n  expectOk(compact2, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"compact2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const pull2 = await sdk.threadView.pull(ref);\\\\\\\\\\\\\\\\n  expectOk(pull2, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pull2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\\\\\\\\\\\\\\\n  expectOk(materialize, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    filePath,\\\\\\\\\\\\\\\\n    outPath,\\\\\\\\\\\\\\\\n    threadId,\\\\\\\\\\\\\\\\n    phases: {\\\\\\\\\\\\\\\\n      create,\\\\\\\\\\\\\\\\n      intake,\\\\\\\\\\\\\\\\n      drain,\\\\\\\\\\\\\\\\n      status,\\\\\\\\\\\\\\\\n      compact1,\\\\\\\\\\\\\\\\n      pull1,\\\\\\\\\\\\\\\\n      inspect1,\\\\\\\\\\\\\\\\n      mutate,\\\\\\\\\\\\\\\\n      rebuild,\\\\\\\\\\\\\\\\n      health2,\\\\\\\\\\\\\\\\n      compact2,\\\\\\\\\\\\\\\\n      pull2,\\\\\\\\\\\\\\\\n      materialize,\\\\\\\\\\\\\\\\n    },\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"structuredPatch\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"oldStart\\\\\\\\\\\\\\\":54,\\\\\\\\\\\\\\\"oldLines\\\\\\\\\\\\\\\":9,\\\\\\\\\\\\\\\"newStart\\\\\\\\\\\\\\\":54,\\\\\\\\\\\\\\\"newLines\\\\\\\\\\\\\\\":15,\\\\\\\\\\\\\\\"lines\\\\\\\\\\\\\\\":[\\
ROUTER_KEY, resolved ONCE at module load by the\\\\\\\\\\\\\\\\n// suite-level guard: exactly one ran/not-ran line lands in run output, and\\\\\\\\\\\\\\\\n// the accounting tests below always run, so absence of the key can never\\\\\\\\\\\\\\\\n// produce a silent pass — unkeyed runs show one NOT-RAN line, a green\\\\\\\\\\\\\\\\n// accounting leg that asserted the not-ran record, and the keyed legs\\\\\\\\\\\\\\\\n// reported as skipped (never as passes). This is the CI-default posture:\\\\\\\\\\\\\\\\n// zero network calls. With the key present, the seven derivation kinds\\\\\\\\\\\\\\\\n// round-trip a real endpoint, the same seam-conformance helpers that ran\\\\\\\\\\\\\\\\n// against the fake host run against the real one unchanged (DD-13), and the\\\\\\\\\\\\\\\\n// Epic 04 lifecycle sequence completes under the real adapter with\\\\\\\\\\\\\\\\n// structural assertions: ready forms, non-marker content, real-model\\\\\\\\\\\\\\\\n// provenance, mutation regeneration, coherent checkpoints.\\\\\\\\\\\\\\\\nimport { readFileSync } from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"node:fs\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nimport { afterAll, beforeAll, describe, expect, it } from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"vitest\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  DerivedForm,\\\\\\\\\\\\\\\\n  HealthReport,\\\\\\\\\\\\\\\\n  MutationResult,\\\\\\\\\\\\\\\\n  OpResult,\\\\\\\\\\\\\\\\n} from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"../src/index.js\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\nimport {\\\\\\\\\\\\\\\\n  assertModelCallContract,\\\\\\\\\\\\\\\\n  assertRoutingThroughSdk,\\\\\\\\\\\\\\\\n  createOpenRouterCall,\\\\\\\\\\\\\\\\n  DEFAULT_OPENROUTER_MODEL,\\\\\\\\\\\\\\\\n  DELETED_MESSAGE_TEXT,\\\\\\\\\\\\\\\\n  EDITED_MESSAGE_TEXT,\\\\\\\\\\\\\\\\n  emitRealSuiteAccounting,\\\\\\\\\\\\\\\\n  FORM_KINDS,\\\\\\\\\\\\\\\\n  probeInput,\\\\\\\\\\\\\\\\n  readDerivedForms,\\\\\\\\\\\\\\\\n  realSuiteAccountingEmissions,\\\\\\\\\\\\\\\\n  resolveRealSuiteEnv,\\\\\\\\\\\\\\\\n  runLifecycle,\\\\\\\\\\\\\\\\n  tempStore,\\\\\\\\\\\\\\\\n  validAssignments,\\\\\\\\\\\\\\\\n  type FormKind,\\\\\\\\\\\\\\\\n  type LifecycleRun,\\\\\\\\\\\\\\\\n  type RoutingRunResult,\\\\\\\\\\\\\\\\n  type TempStore,\\\\\\\\\\\\\\\\n} from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"./fixtures/index.js\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the suite-level guard: one resolution, one visible line ───────\\\\\\\\\\\\\\\\nconst suiteEnv = resolveRealSuiteEnv(process.env);\\\\\\\\\\\\\\\\nconst keyed = !(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in suiteEnv);\\\\\\\\\\\\\\\\nconst realKey = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in suiteEnv ? undefined : suiteEnv.key;\\\\\\\\\\\\\\\\nconst realModel = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in suiteEnv ? DEFAULT_OPENROUTER_MODEL : suiteEnv.model;\\\\\\\\\\\\\\\\nemitRealSuiteAccounting(suiteEnv);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// The deterministic provider's signature, two grains: the design's anchored\\\\\\\\\\\\\\\\n// form-content pattern, and a digest-bearing scan pattern for \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"appears\\\\\\\\\\\\\\\\n// anywhere\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" sweeps over served views and materialized files.\\\\\\\\\\\\\\\\nconst MARKER_AT_START =\\\\\\\\\\\\\\\\n  /^(?:smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\(/;\\\\\\\\\\\\\\\\nconst MARKER_ANYWHERE =\\\\\\\\\\\\\\\\n  /(?:smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\([0-9a-f]{8}:/;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction ok<T>(result: OpResult<T>): T {\\\\\\\\\\\\\\\\n  if (!result.ok) {\\\\\\\\\\\\\\\\n    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return result.value;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// All seven kinds assigned to the one real lane; prompt names stay the\\\\\\\\\\\\\\\\n// registry defaults validAssignments already wires.\\\\\\\\\\\\\\\\nfunction realAssignments(model: string): ReturnType<typeof validAssignments> {\\\\\\\\\\\\\\\\n  const overrides: Partial<Record<FormKind, { provider: string; model: string }>> = {};\\\\\\\\\\\\\\\\n  for (const kind of FORM_KINDS) {\\\\\\\\\\\\\\\\n    overrides[kind] = { provider: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"openrouter\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", model };\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  return validAssignments(overrides);\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── TC-4.1: accounting — these tests run keyed or not ─────────────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"TC-4.1 / AC-4.1: ran/not-ran accounting is always visible\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"the unkeyed guard returns a not-ran record with reason, never a pass-shaped record\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    const record = resolveRealSuiteEnv({});\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in record).toBe(true);\\\\\\\\\\\\\\\\n    if (!(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in record)) throw new Error(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"unreachable\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n    expect(record.notRan).toContain(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LHC_OPENROUTER_KEY\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n    // Distinguishable from a pass: the not-ran shape carries no key/model —\\\\\\\\\\\\\\\\n    // nothing downstream can construct a keyed run from it.\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in record).toBe(false);\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"model\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in record).toBe(false);\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"a whitespace-only key is unset, not a silent keyed run\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    const record = resolveRealSuiteEnv({ LHC_OPENROUTER_KEY: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"   \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" });\\\\\\\\\\\\\\\\n    expect(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in record).toBe(true);\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"a keyed env resolves key and model, defaulting the model when unset\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    const defaulted = resolveRealSuiteEnv({ LHC_OPENROUTER_KEY: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test-key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" });\\\\\\\\\\\\\\\\n    expect(defaulted).toEqual({ key: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test-key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", model: DEFAULT_OPENROUTER_MODEL });\\\\\\\\\\\\\\\\n    const explicit = resolveRealSuiteEnv({\\\\\\\\\\\\\\\\n      LHC_OPENROUTER_KEY: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test-key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n      LHC_OPENROUTER_MODEL: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"vendor/cheap-model\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n    });\\\\\\\\\\\\\\\\n    expect(explicit).toEqual({ key: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test-key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", model: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"vendor/cheap-model\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" });\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"the suite-level guard emitted exactly one ran/not-ran line into run output\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    const emissions = realSuiteAccountingEmissions();\\\\\\\\\\\\\\\\n    expect(emissions).toHaveLength(1);\\\\\\\\\\\\\\\\n    expect(emissions[0]).toBe(\\\\\\\\\\\\\\\\n      keyed\\\\\\\\\\\\\\\\n        ? `RAN: real-inference (model ${realModel})`\\\\\\\\\\\\\\\\n        : \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"NOT-RAN: real-inference (LHC_OPENROUTER_KEY unset)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n    );\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n});\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── TC-4.1 / TC-4.3: keyed seven-kind round-trips + conformance ───\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe.runIf(keyed)(\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"TC-4.1 / TC-4.3 (keyed): seven real round-trips through the shared seam helpers\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n  () => {\\\\\\\\\\\\\\\\n    const call = realKey === undefined ? undefined : createOpenRouterCall(realKey, realModel);\\\\\\\\\\\\\\\\n    const assignments = realAssignments(realModel);\\\\\\\\\\\\\\\\n    let store: TempStore;\\\\\\\\\\\\\\\\n    let routing: RoutingRunResult;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    beforeAll(async () => {\\\\\\\\\\\\\\\\n      store = tempStore();\\\\\\\\\\\\\\\\n      if (call === undefined) throw new Error(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"keyed leg started without a key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n      // TC-4.3: the SAME routing helper Story 2's fake-host seam test runs,\\\\\\\\\\\\\\\\n      // unchanged, against the real host — it drives a real intake → drain\\\\\\\\\\\\\\\\n      // exercising all seven kinds and asserts routing, lane coverage, and\\\\\\\\\\\\\\\\n      // single-turn message shape internally.\\\\\\\\\\\\\\\\n      routing = await assertRoutingThroughSdk(call, assignments, store);\\\\\\\\\\\\\\\\n    }, 300_000);\\\\\\\\\\\\\\\\n    afterAll(() => {\\\\\\\\\\\\\\\\n      store.cleanup();\\\\\\\\\\\\\\\\n    });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    it(\\\\\\\\\\\\\\\\n      \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"TC-4.3: the real host function passes the ModelCall contract on a real probe\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n      { timeout: 120_000 },\\\\\\\\\\\\\\\\n      async () => {\\\\\\\\\\\\\\\\n        if (call === undefined) throw new Error(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"keyed leg started without a key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n        await assertModelCallContract(\\\\\\\\\\\\\\\\n          call,\\\\\\\\\\\\\\\\n          probeInput({ provider: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"openrouter\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", model: realModel }),\\\\\\\\\\\\\\\\n        );\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\n    );\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"TC-4.1: each of the seven kinds round-tripped real inference to a ready form\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n      for (const kind of FORM_KINDS) {\\\\\\\\\\\\\\\\n        const ready = routing.forms.filter(\\\\\\\\\\\\\\\\n          (form) => form.form === kind && form.state === \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n        );\\\\\\\\\\\\\\\\n        expect(ready.length).toBeGreaterThan(0);\\\\\\\\\\\\\\\\n        for (const form of ready) {\\\\\\\\\\\\\\\\n          expect(form.content).toBeDefined();\\\\\\\\\\\\\\\\n          expect((form.content ?? \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").trim()).not.toBe(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n          expect(form.content).not.toMatch(MARKER_AT_START);\\\\\\\\\\\\\\\\n          expect(form.content).not.toMatch(MARKER_ANYWHERE);\\\\\\\\\\\\\\\\n          // Provenance names the real lane from config, never model output.\\\\\\\\\\\\\\\\n          expect(form.metadata?.provenance).toEqual({\\\\\\\\\\\\\\\\n            provider: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"openrouter\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n            model: realModel,\\\\\\\\\\\\\\\\n            prompt: assignments[form.form].prompt,\\\\\\\\\\\\\\\\n          });\\\\\\\\\\\\\\\\n        }\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    });\\\\\\\\\\\\\\\\n  },\\\\\\\\\\\\\\\\n);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── TC-4.2: the real-adapter lifecycle capstone ───────────────────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndescribe.runIf(keyed)(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"TC-4.2 (keyed): Epic 04 lifecycle capstone under the real adapter\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n  let store: TempStore;\\\\\\\\\\\\\\\\n  let run: LifecycleRun;\\\\\\\\\\\\\\\\n  let preEditForms: DerivedForm[] = [];\\\\\\\\\\\\\\\\n  let finalForms: DerivedForm[] = [];\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  beforeAll(async () => {\\\\\\\\\\\\\\\\n    store = tempStore();\\\\\\\\\\\\\\\\n    if (\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in suiteEnv) throw new Error(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"keyed leg started without a key\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n    const call = createOpenRouterCall(suiteEnv.key, realModel);\\\\\\\\\\\\\\\\n    // The Epic 04 sequence verbatim — intake, drain, compact, pull, inspect,\\\\\\\\\\\\\\\\n    // edit, rebuild, drain, compact, materialize — with the inference\\\\\\\\\\\\\\\\n    // adapter in the provider-arrival slot (the one swap point).\\\\\\\\\\\\\\\\n    run = await runLifecycle(store, {\\\\\\\\\\\\\\\\n      name: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"real-capstone\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n      inference: { call, assignments: realAssignments(realModel) },\\\\\\\\\\\\\\\\n      onCheckpoint: (checkpoint, ctx) => {\\\\\\\\\\\\\\\\n        // Pre-mutation snapshot: the regeneration assertion compares each\\\\\\\\\\\\\\\\n        // mutation-cleared form's content before the edit and after rebuild.\\\\\\\\\\\\\\\\n        if (checkpoint === \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") preEditForms = readDerivedForms(ctx.filePath);\\\\\\\\\\\\\\\\n        return Promise.resolve();\\\\\\\\\\\\\\\\n      },\\\\\\\\\\\\\\\\n    });\\\\\\\\\\\\\\\\n    finalForms = readDerivedForms(run.filePath);\\\\\\\\\\\\\\\\n  }, 1_800_000);\\\\\\\\\\\\\\\\n  afterAll(() => {\\\\\\\\\\\\\\\\n    store.cleanup();\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"every derivation kind lands ready at least once with non-empty content\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    for (const kind of FORM_KINDS) {\\\\\\\\\\\\\\\\n      const ready = finalForms.filter((form) => form.form === kind && form.state === \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n      expect(ready.length).toBeGreaterThan(0);\\\\\\\\\\\\\\\\n      for (const form of ready) {\\\\\\\\\\\\\\\\n        expect((form.content ?? \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").trim()).not.toBe(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"no deterministic marker pattern appears anywhere — forms, served views, materialized file\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    for (const form of finalForms) {\\\\\\\\\\\\\\\\n      if (form.content === undefined) continue;\\\\\\\\\\\\\\\\n      expect(form.content).not.toMatch(MARKER_AT_START);\\\\\\\\\\\\\\\\n      expect(form.content).not.toMatch(MARKER_ANYWHERE);\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    for (const pull of [ok(run.phases.pull1), ok(run.phases.pull2)]) {\\\\\\\\\\\\\\\\n      for (const message of pull.messages) {\\\\\\\\\\\\\\\\n        expect(message.content).not.toMatch(MARKER_ANYWHERE);\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    expect(readFileSync(run.outPath, \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"utf8\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")).not.toMatch(MARKER_ANYWHERE);\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"provenance on every ready form names the real model\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    for (const form of finalForms) {\\\\\\\\\\\\\\\\n      if (form.state !== \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") continue;\\\\\\\\\\\\\\\\n      expect(form.metadata?.provenance?.provider).toBe(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"openrouter\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n      expect(form.metadata?.provenance?.model).toBe(realModel);\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"mutation-cleared forms went cleared-then-ready and regenerated with different content\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    const cleared = [\\\\\\\\\\\\\\\\n      ...ok(run.phases.mutate.edit).cleared,\\\\\\\\\\\\\\\\n      ...ok(run.phases.mutate.delete).cleared,\\\\\\\\\\\\\\\\n    ];\\\\\\\\\\\\\\\\n    expect(cleared.length).toBeGreaterThan(0);\\\\\\\\\\\\\\\\n    const find = (forms: DerivedForm[], target: (typeof cleared)[number]): DerivedForm | undefined =>\\\\\\\\\\\\\\\\n      forms.find(\\\\\\\\\\\\\\\\n        (form) =>\\\\\\\\\\\\\\\\n          form.subjectKind === target.subjectKind &&\\\\\\\\\\\\\\\\n          form.subjectId === target.subjectId &&\\\\\\\\\\\\\\\\n          form.form === target.form,\\\\\\\\\\\\\\\\n      );\\\\\\\\\\\\\\\\n    for (const target of cleared) {\\\\\\\\\\\\\\\\n      const before = find(preEditForms, target);\\\\\\\\\\\\\\\\n      const after = find(finalForms, target);\\\\\\\\\\\\\\\\n      // Cleared-then-ready: ready before the mutation (pre-edit snapshot),\\\\\\\\\\\\\\\\n      // pending in the mutate-phase health below, ready again after rebuild.\\\\\\\\\\\\\\\\n      expect(before?.state).toBe(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n      expect(after?.state).toBe(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n      expect(after?.content).toBeDefined();\\\\\\\\\\\\\\\\n      expect(after?.content).not.toBe(before?.content);\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n  });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n  it(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"health is coherent at each checkpoint: settled, cleared-set pending, settled again\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", () => {\\\\\\\\\\\\\\\\n    // Checkpoint 1 — post-drain status: derivation fully settled before the\\\\\\\\\\\\\\\\n    // first compact.\\\\\\\\\\\\\\\\n    const status = ok(run.phases.status);\\\\\\\\\\\\\\\\n    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    // Checkpoint 2 — immediately after the mutations: exactly the cleared\\\\\\\\\\\\\\\\n    // set is in flight, queued and unclaimed (cleared → pending around\\\\\\\\\\\\\\\\n    // mutations).\\\\\\\\\\\\\\\\n    const clearedCount =\\\\\\\\\\\\\\\\n      ok(run.phases.mutate.edit).cleared.length + ok(run.phases.mutate.delete).cleared.length;\\\\\\\\\\\\\\\\n    const healthAfterMutate = ok(run.phases.mutate.healthAfterMutate);\\\\\\\\\\\\\\\\n    const inFlight = healthAfterMutate.owners.reduce(\\\\\\\\\\\\\\\\n      (sum, row) => sum + row.counts.pending + row.counts.retrying,\\\\\\\\\\\\\\\\n      0,\\\\\\\\\\\\\\\\n    );\\\\\\\\\\\\\\\\n    expect(inFlight).toBe(clearedCount);\\\\\\\\\\\\\\\\n    expect(healthAfterMutate.queue).toEqual({ queued: clearedCount, claimed: 0 });\\\\\\\\\\\\\\\\n    expect(healthAfterMutate.failures).toEqual([]);\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    // Checkpoint 3 — post-rebuild: everything ready, nothing failed or\\\\\\\\\\\\\\\\n    // blocked, queue empty.\\\\\\\\\\\\\\\\n    const health2: HealthReport = ok(run.phases.health2);\\\\\\\\\\\\\\\\n    for (const row of health2.owners) {\\\\\\\\\\\\\\\\n      expect(row.counts.pending).toBe(0);\\\\\\\\\\\\\\\\n      expect(row.counts.retrying).toBe(0);\\\\\\\\\\\\\\\\n      expect(row.counts.failed).toBe(0);\\\\\\\\\\\\\\\\n      expect(row.counts.blocked).toBe(0);\\\\\\\\\\\\\\\\n      expect(row.counts.ready).toBeGreaterThan(0);\\\\\\\\\\\
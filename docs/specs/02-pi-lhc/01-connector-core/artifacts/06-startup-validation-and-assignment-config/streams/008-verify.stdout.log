\\\\":\\\\\\\\\\\\\\\"// The real host (DD-13, AC-4.1): a test-owned ModelCall over OpenRouter's\\\\\\\\\\\\\\\\n// OpenAI-compatible chat-completions endpoint using plain fetch — test code,\\\\\\\\\\\\\\\\n// never production LHC transport. It exists to prove the injected-function\\\\\\\\\\\\\\\\n// contract is sufficient against a real endpoint: the same AC-1.2 shape the\\\\\\\\\\\\\\\\n// scripted fakes implement, exercised by the same seam-conformance helpers.\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// Key resolution and the suite's ran/not-ran accounting also live here so the\\\\\\\\\\\\\\\\n// run/not-run state is one fact reported once (Flow 4): the suite-level guard\\\\\\\\\\\\\\\\n// in inference-real.test.ts calls resolveRealSuiteEnv exactly once at module\\\\\\\\\\\\\\\\n// load and emits exactly one visible line — absence of the key can never look\\\\\\\\\\\\\\\\n// like a pass.\\\\\\\\\\\\\\\\nimport type {\\\\\\\\\\\\\\\\n  ModelCall,\\\\\\\\\\\\\\\\n  ModelCallFailureKind,\\\\\\\\\\\\\\\\n  ModelCallResult,\\\\\\\\\\\\\\\\n} from \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"../../src/inference/types.js\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport const OPENROUTER_ENDPOINT = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"https://openrouter.ai/api/v1/chat/completions\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// The suite's cheap default lane; LHC_OPENROUTER_MODEL overrides it for\\\\\\\\\\\\\\\\n// dial-in experiments without touching test code.\\\\\\\\\\\\\\\\nexport const DEFAULT_OPENROUTER_MODEL = \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"openai-codex/gpt-5.4\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// The guard's one fact: ran (with the key and the model lane the run will\\\\\\\\\\\\\\\\n// use) or not-ran (with reason). The shapes share no fields, so a not-ran\\\\\\\\\\\\\\\\n// record can never be mistaken for a keyed resolution by any structural\\\\\\\\\\\\\\\\n// check (AC-4.1's \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"absence of the key can never produce a silent pass\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").\\\\\\\\\\\\\\\\nexport type RealSuiteEnv = { key: string; model: string } | { notRan: string };\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function resolveRealSuiteEnv(\\\\\\\\\\\\\\\\n  env: Record<string, string | undefined>,\\\\\\\\\\\\\\\\n): RealSuiteEnv {\\\\\\\\\\\\\\\\n  const key = env[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LHC_OPENROUTER_KEY\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"];\\\\\\\\\\\\\\\\n  if (key === undefined || key.trim() === \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") {\\\\\\\\\\\\\\\\n    return { notRan: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LHC_OPENROUTER_KEY unset\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" };\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  const model = env[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"LHC_OPENROUTER_MODEL\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"];\\\\\\\\\\\\\\\\n  return {\\\\\\\\\\\\\\\\n    key,\\\\\\\\\\\\\\\\n    model: model !== undefined && model.trim() !== \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ? model : DEFAULT_OPENROUTER_MODEL,\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── suite-level accounting (AC-4.1) ───────────────────────────────\\\\\\\\\\\\\\\\n//\\\\\\\\\\\\\\\\n// One visible line per resolution, written straight to the runner's stdout\\\\\\\\\\\\\\\\n// (not through a logger a reporter could swallow). The emission log lets the\\\\\\\\\\\\\\\\n// always-run guard test assert \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"exactly one ran/not-ran line\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" as data.\\\\\\\\\\\\\\\\nconst emissions: string[] = [];\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function emitRealSuiteAccounting(env: RealSuiteEnv): string {\\\\\\\\\\\\\\\\n  const line =\\\\\\\\\\\\\\\\n    \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"notRan\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" in env\\\\\\\\\\\\\\\\n      ? `NOT-RAN: real-inference (${env.notRan})`\\\\\\\\\\\\\\\\n      : `RAN: real-inference (model ${env.model})`;\\\\\\\\\\\\\\\\n  emissions.push(line);\\\\\\\\\\\\\\\\n  process.stdout.write(`${line}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n`);\\\\\\\\\\\\\\\\n  return line;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function realSuiteAccountingEmissions(): readonly string[] {\\\\\\\\\\\\\\\\n  return emissions;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── the real ModelCall (AC-1.2 over a real endpoint) ──────────────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// OpenRouter failure mapping (story §Technical Notes): auth-shaped statuses\\\\\\\\\\\\\\\\n// are terminal-classified by LHC, the rest fall where the table says.\\\\\\\\\\\\\\\\nfunction failureKindForStatus(status: number): ModelCallFailureKind {\\\\\\\\\\\\\\\\n  if (status === 401 || status === 403) return \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"auth\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n  if (status === 429) return \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"rate_limit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n  if (status === 400) return \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"invalid_request\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n  return \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"other\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nfunction failure(kind: ModelCallFailureKind, message: string): ModelCallResult {\\\\\\\\\\\\\\\\n  return { ok: false, kind, message };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// The assistant text out of an OpenAI-compatible completion payload, or\\\\\\\\\\\\\\\\n// undefined when the body is not the shape the endpoint documents.\\\\\\\\\\\\\\\\nfunction extractAssistantText(payload: unknown): string | undefined {\\\\\\\\\\\\\\\\n  if (typeof payload !== \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"object\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" || payload === null) return undefined;\\\\\\\\\\\\\\\\n  const choices = (payload as { choices?: unknown }).choices;\\\\\\\\\\\\\\\\n  if (!Array.isArray(choices) || choices.length === 0) return undefined;\\\\\\\\\\\\\\\\n  const first: unknown = choices[0];\\\\\\\\\\\\\\\\n  if (typeof first !== \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"object\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" || first === null) return undefined;\\\\\\\\\\\\\\\\n  const message = (first as { message?: unknown }).message;\\\\\\\\\\\\\\\\n  if (typeof message !== \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"object\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" || message === null) return undefined;\\\\\\\\\\\\\\\\n  const content = (message as { content?: unknown }).content;\\\\\\\\\\\\\\\\n  return typeof content === \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" ? content : undefined;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// createOpenRouterCall(key, defaultModel) implements the ModelCall contract\\\\\\\\\\\\\\\\n// over plain fetch. Host-side interpretation of the opaque routing keys\\\\\\\\\\\\\\\\n// (AC-1.2 grants this): OpenRouter takes one model slug, so a `model` string\\\\\\\\\\\\\\\\n// that already names a slug (contains \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") routes as-is and anything else —\\\\\\\\\\\\\\\\n// including conformance-probe placeholders — falls to the suite's default\\\\\\\\\\\\\\\\n// model. The provider string is carried but not consulted: this host has\\\\\\\\\\\\\\\\n// exactly one lane behind it.\\\\\\\\\\\\\\\\nexport function createOpenRouterCall(key: string, defaultModel: string): ModelCall {\\\\\\\\\\\\\\\\n  return async (input) => {\\\\\\\\\\\\\\\\n    const slug = input.model.includes(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") ? input.model : defaultModel;\\\\\\\\\\\\\\\\n    let response: Response;\\\\\\\\\\\\\\\\n    try {\\\\\\\\\\\\\\\\n      response = await fetch(OPENROUTER_ENDPOINT, {\\\\\\\\\\\\\\\\n        method: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"POST\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n        headers: {\\\\\\\\\\\\\\\\n          Authorization: `Bearer ${key}`,\\\\\\\\\\\\\\\\n          \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Content-Type\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"application/json\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\n        },\\\\\\\\\\\\\\\\n        body: JSON.stringify({ model: slug, messages: input.messages }),\\\\\\\\\\\\\\\\n      });\\\\\\\\\\\\\\\\n    } catch (error) {\\\\\\\\\\\\\\\\n      return failure(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"network\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", error instanceof Error ? error.message : String(error));\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    if (!response.ok) {\\\\\\\\\\\\\\\\n      const body = await response.text().catch(() => \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n      return failure(\\\\\\\\\\\\\\\\n        failureKindForStatus(response.status),\\\\\\\\\\\\\\\\n        `HTTP ${String(response.status)}: ${body.slice(0, 200)}`,\\\\\\\\\\\\\\\\n      );\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    let payload: unknown;\\\\\\\\\\\\\\\\n    try {\\\\\\\\\\\\\\\\n      payload = await response.json();\\\\\\\\\\\\\\\\n    } catch {\\\\\\\\\\\\\\\\n      return failure(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"other\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"response body was not JSON\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    const text = extractAssistantText(payload);\\\\\\\\\\\\\\\\n    if (text === undefined) {\\\\\\\\\\\\\\\\n      return failure(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"other\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"response carried no assistant text\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\");\\\\\\\\\\\\\\\\n    }\\\\\\\\\\\\\\\\n    // Empty/whitespace text crosses the boundary as a success: empty_output\\\\\\\\\\\\\\\\n    // is adapter-generated (AC-2.4); hosts never return it.\\\\\\\\\\\\\\\\n    return { ok: true, text };\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\"},\\\\\\\\\\\\\\\"caller\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\
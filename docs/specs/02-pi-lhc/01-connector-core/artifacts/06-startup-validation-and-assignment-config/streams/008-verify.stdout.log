comes (AC-2.4), the turn\\\\\\\\\\\\\\\\n// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\\\\\\\\\\\\\\\\n// final attempts/last-error copied from the work item before its row is\\\\\\\\\\\\\\\\n// deleted (DD-1: the queue is not an audit table; durable outcome detail\\\\\\\\\\\\\\\\n// lives here).\\\\\\\\\\\\\\\\nexport interface DerivedFormMetadata {\\\\\\\\\\\\\\\\n  outcome?: ToolOutcome;\\\\\\\\\\\\\\\\n  receipts?: ToolRunReceipt[];\\\\\\\\\\\\\\\\n  attempts?: number;\\\\\\\\\\\\\\\\n  lastError?: string;\\\\\\\\\\\\\\\\n  // Epic 05 (DD-4): which provider/model/prompt produced the content —\\\\\\\\\\\\\\\\n  // copied from the ProviderResult's config-known strings, never authored\\\\\\\\\\\\\\\\n  // from model output. The deterministic provider never sets it.\\\\\\\\\\\\\\\\n  provenance?: ProviderProvenance;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// One row of an owner's repair report (Flow 4): the form's durable state\\\\\\\\\\\\\\\\n// joined with the queue's mechanical detail for the live item still working\\\\\\\\\\\\\\\\n// toward it, if any. The five operational situations read from this one row:\\\\\\\\\\\\\\\\n// never-attempted (pending, no queue), retrying (pending + queue with\\\\\\\\\\\\\\\\n// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\\\\\\\\\\\\\\\\n// ever needs a queue API.\\\\\\\\\\\\\\\\nexport interface FormReportEntry extends DerivedForm {\\\\\\\\\\\\\\\\n  queue?: {\\\\\\\\\\\\\\\\n    status: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"queued\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"claimed\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n    attempts: number;\\\\\\\\\\\\\\\\n    lastError?: string;\\\\\\\\\\\\\\\\n    eligibleAt?: string;\\\\\\\\\\\\\\\\n  };\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── provider seam (DD-7) ─────────────────────────────────────────\\\\\\\\\\\\\\\\n// Every operation returns content or a structured failure carrying\\\\\\\\\\\\\\\\n// retryable-or-not; classification is the adapter's duty.\\\\\\\\\\\\\\\\n// Provenance: the three config-known assignment strings, stamped by the\\\\\\\\\\\\\\\\n// inference adapter (it alone knows the assignment) and copied by handlers\\\\\\\\\\\\\\\\n// into form metadata (Epic 05 DD-4). Never derived from model output.\\\\\\\\\\\\\\\\nexport interface ProviderProvenance {\\\\\\\\\\\\\\\\n  provider: string;\\\\\\\\\\\\\\\\n  model: string;\\\\\\\\\\\\\\\\n  prompt: string;\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n// ── derived_form read-back and the sanctioned state writer ───────\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ninterface RawFormRow {\\\\\\\\\\\\\\\\n  subject_kind: string;\\\\\\\\\\\\\\\\n  subject_id: string;\\\\\\\\\\\\\\\\n  form: string;\\\\\\\\\\\\\\\\n  state: string;\\\\\\\\\\\\\\\\n  content: string | null;\\\\\\\\\\\\\\\\n  reason: string | null;\\\\\\\\\\\\\\\\n  metadata: string | null;\\\\\\\\\\\\\\\\n  source_version: number | bigint;\\\\\\\\\\\\\\\\n  gaps: string | null;\\\\\\\\\\\\\\\\n  derived_at: string | null;\\\\\\\\\\\\\\\\n}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nexport function readDerivedForms(filePath: string): DerivedForm[] {\\\\\\\\\\\\\\\\n  const db = new DatabaseSync(filePath);\\\\\\\\\\\\\\\\n  try {\\\\\\\\\\\\\\\\n    const rows = db\\\\\\\\\\\\\\\\n      .prepare(\\\\\\\\\\\\\\\\n        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\\\\\\\\\\\\\\\\n                source_version, gaps, derived_at\\\\\\\\\\\\\\\\n         FROM derived_form ORDER BY subject_kind, subject_id, form`,\\\\\\\\\\\\\\\\n      )\\\\\\\\\\\\\\\\n      .all() as unknown as RawFormRow[];\\\\\\\\\\\\\\\\n    return rows.map((row) => {\\\\\\\\\\\\\\\\n      const record: DerivedForm = {\\\\\\\\\\\\\\\\n        subjectKind: row.subject_kind as SubjectKind,\\\\\\\\\\\\\\\\n        subjectId: row.subject_id,\\\\\\\\\\\\\\\\n        form: row.form as FormKind,\\\\\\\\\\\\\\\\n        state: row.state as DerivedFormState,\\\\\\\\\\\\\\\\n        sourceVersion: Number(row.source_version),\\\\\\\\\\\\\\\\n      };\\\\\\\\\\\\\\\\n      if (row.content !== null) record.content = row.content;\\\\\\\\\\\\\\\\n      if (row.reason !== null) record.reason = row.reason;\\\\\\\\\\\\\\\\n      if (row.metadata !== null) {\\\\\\\\\\\\\\\\n        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\\\\\\\\\\\\\\\\n      }\\\\\\\\\\\\\\\\n      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\\\\\\\\\\\\\\\n      if (row.derived_at !== null) record.derivedAt = row.derived_at;\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"stderr\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"interrupted\\\\\\\\\\\\\\\":false,\\\\\\\\\\\\\\\"isImage\\\\\\\\\\\\\\\":false,\\\\\\\\\\\\\\\"noOutputExpected\\\\\\\\\\\\\\\":false}}\\\\\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:533:{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"tool_use_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"toolu_018NbN4eZ6TDeeZSHFeKDL1u\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"// Epic 05 Story 2 — TC-1.2 (AC-1.2, AC-1.4): per-call routing through the\\\\\\\\\\\\\\\\n// inference seam. A recording fake logs every call while a seeded thread\\\\\\\\\\\\\\\\n// exercises all seven kinds; the assertions inspect the actual serialized\\\\\\\\\\\\\\\\n// ModelCall input emitted during the drain — never a helper-level intention\\\\\\\\\\\\\\\\n// (anti-shim). The routing assertions live in the parameterized\\\\\\\\\\\\\\\\n// seam-conformance helpers so TC-4.3 runs them against the real host\\\\\\\\\\\\\\\\n// unchanged (D
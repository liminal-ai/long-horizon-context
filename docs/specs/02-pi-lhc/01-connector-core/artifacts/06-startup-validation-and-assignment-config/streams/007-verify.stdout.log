packages/pi-lhc/src/capture/turn-accumulator.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/state.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/shared/diagnostics.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/validate.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/inspect/internal/health.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/converter.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/turn-derivation.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/abort.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/idempotency.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/reattach-idempotency.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/support.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/synthetic.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.ts\\\"],\\\"reviewScopeSummary\\\":\\\"Initial verification of Story 2 against AC-2.1 through AC-2.8, TC-2.1 through TC-2.9, current capture source/tests, production capture paths, LHC duplicate-key behavior, and configured gates.\\\",\\\"priorFindingStatuses\\\":[],\\\"newFindings\\\":[{\\\"id\\\":\\\"SV-001\\\",\\\"severity\\\":\\\"major\\\",\\\"title\\\":\\\"No-id, no-position capture events still collide on fal
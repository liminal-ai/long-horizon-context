nce/model-call.ts\\\\npackages/pi-lhc/src/pi/types.ts\\\\npackages/pi-lhc/tsconfig.json\\\\npackages/pi-lhc/README.md\\\\npackages/pi-lhc/tsconfig.test.json\\\\npackages/pi-lhc/package.json\\\\npackages/pi-lhc/vitest.config.ts\\\\npackages/pi-lhc/src/shared/not-implemented.ts\\\\npackages/pi-lhc/src/shared/instance.ts\\\\npackages/pi-lhc/src/shared/diagnostics.ts\\\\npackages/pi-lhc/scripts/record-red-manifest.mjs\\\\npackages/pi-lhc/scripts/lint.mjs\\\\npackages/pi-lhc/scripts/check-boundaries.mjs\\\\npackages/pi-lhc/scripts/check-test-immutability.mjs\\\\npackages/pi-lhc/src/verify/replay.ts\\\\npackages/pi-lhc/src/lifecycle/instance.ts\\\\npackages/pi-lhc/src/lifecycle/picker.ts\\\\npackages/pi-lhc/src/lifecycle/thread-resolution.ts\\\\npackages/pi-lhc/src/lifecycle/fork.ts\\\\npackages/pi-lhc/src/lifecycle/state.ts\\\\npackages/pi-lhc/src/capture/runtime-changes.ts\\\\npackages/pi-lhc/src/capture/turn-accumulator.ts\\\\npackages/pi-lhc/src/capture/idempotency.ts\\\\npackages/pi-lhc/src/capture/converter.ts\\\\npackages/pi-lhc/src/capture/map-message.ts\\\\npackages/pi-lhc/test/fixtures/synthetic.ts\\\\npackages/pi-lhc/test/verify/replay.test.ts\\\\npackages/pi-lhc/test/fixtures/model-call.test.ts\\\\npackages/pi-lhc/test/fixtures/corpus.test.ts\\\\npackages/pi-lhc/test/fixtures/thread.ts\\\\npackages/pi-lhc/test/fixtures/thread.test.ts\\\\npackages/pi-lhc/test/fixtures/synthetic.test.ts\\\\npackages/pi-lhc/test/fixtures/model-call.ts\\\\npackages/pi-lhc/test/fixtures/corpus.ts\\\\npackages/pi-lhc/test/smoke/extension-load.test.ts\\\\npackages/pi-lhc/test/smoke/verification-config.test.ts\\\\npackages/pi-lhc/test/inference/model-call.test.ts\\\\npackages/pi-lhc/test/inference/assignments.test.ts\\\\npackages/pi-lhc/test/inference/startup-validation.test.ts\\\\npackages/pi-lhc/test/inference/closed-loop.test.ts\\\\npackages/pi-lhc/test/red-manifest.json\\\\npackages/pi-lhc/test/lifecycle/fork.test.ts\\\\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts\\\\npackages/pi-lhc/test/lifecycle/instance.test.ts\\\\npackages/pi-lhc/test/capture/converter.test.ts\\\\npackages/pi-lhc/test/capture/support.ts\\\\npackages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\\npackages/pi-lhc/test/capture/turn-derivation.test.ts\\\\npackages/pi-lhc/test/capture/idempotency.test.ts\\\\npackages/pi-lhc/test/capture/abort.test.ts\\\\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'rg -n \\\\\\\"SV-001|SV-003|006-verify|deterministic/default|default assignments|createModelCall|modelRegistry|unreachable|headless\\\\\\\" packages/pi-lhc'\\\",\\\"aggregated_output\\\":\\\"packages/pi-lhc/src/pi/types.ts:5:// headless + interactive recon, June 12 2026). The PI packages are not yet a\\\\npackages/pi-lhc/src/pi/types.ts:157:  modelRegistry: ModelRegistry;\\\\npackages/pi-lhc/src/pi/types.ts:160:   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\\\\npackages/pi-lhc/src/lifecycle/picker.ts:17: *  headless-safe registry operation — a real UI in production, a deterministic\\\\npackages/pi-lhc/src/index.ts:26:import { createModelCall, defaultAssignments } from \\\\\\\"./inference/model-call.js\\\\\\\";\\\\npackages/pi-lhc/src/index.ts:158:        call: createModelCall(ctx),\\\\npackages/pi-lhc/src/inference/model-call.ts:3:// Resolves (provider,model) via ctx.modelRegistry.find, completes through\\\\npackages/pi-lhc/src/inference/model-call.ts:95: * Resolves (provider, model) through ctx.modelRegistry.find(), validates\\\\npackages/pi-lhc/src/inference/model-call.ts:99:export function createModelCall(ctx: ExtensionContext, deps: ModelCallDeps = {}): ModelCall {\\\\npackages/pi-lhc/src/inference/model-call.ts:102:    const resolved = ctx.modelRegistry.find(provider, model);\\\\npackages/pi-lhc/src/inference/model-call.ts:113:    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\\\\npackages/pi-lhc/src/inference/startup-validation.ts:2:// against PI's registry, report unreachable lanes, leave capture running.\\\\npackages/pi-lhc/src/inference/startup-validation.ts:11:// when available and always persists to SessionState.health for headless modes.\\\\npackages/pi-lhc/src/inference/startup-validation.ts:23:/** Probe each assignment; classify unreachable lanes (AC-5.1, AC-5.2).\\\\npackages/pi-lhc/src/inference/startup-validation.ts:26: *  1. Call ctx.modelRegistry.find(provider, model) to check if the lane exists.\\\\npackages/pi-lhc/src/inference/startup-validation.ts:27: *  2. If found, call ctx.modelRegistry.hasConfiguredAuth(handle) to check auth.\\\\npackages/pi-lhc/src/inference/startup-validation.ts:32: *  Returns a structured report listing all unreachable lanes with their fixes.\\\\npackages/pi-lhc/src/inference/startup-validation.ts:33: *  Reachable lanes are not listed; an empty `unreachable` array means all lanes\\\\npackages/pi-lhc/src/inference/startup-validation.ts:39:  const unreachable: ValidationReport[\\\\\\\"unreachable\\\\\\\"] = [];\\\\npackages/pi-lhc/src/inference/startup-validation.ts:46:    const resolved = ctx.modelRegistry.find(provider, model);\\\\npackages/pi-lhc/src/inference/startup-validation.ts:50:      unreachable.push({\\\\npackages/pi-lhc/src/inference/startup-validation.ts:61:    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\\\\npackages/pi-lhc/src/inference/startup-validation.ts:63:      unreachable.push({\\\\npackages/pi-lhc/src/inference/startup-validation.ts:73:  return { unreachable };\\\\npackages/pi-lhc/src/inference/startup-validation.ts:76:/** Surface unreachable lanes via ctx.ui when available + structured diagnostic.\\\\npackages/pi-lhc/src/inference/startup-validation.ts:78: *  Reporting is headless-safe (AC-5.2):\\\\npackages/pi-lhc/src/inference/startup-validation.ts:94:  // If there are unreachabl
       inference: {\\\\n   313\\\\t            call: fakeModelCallRouter(\\\\n   314\\\\t              { \\\\\\\"openai/gpt-4o\\\\\\\": fakeModelCallText(\\\\\\\"reachable derivation\\\\\\\") },\\\\n   315\\\\t              fakeModelCallFailure(\\\\\\\"invalid_request\\\\\\\", \\\\\\\"unreachable assignment lane\\\\\\\"),\\\\n   316\\\\t            ),\\\\n   317\\\\t            assignments,\\\\n   318\\\\t          },\\\\n   319\\\\t          mode: \\\\\\\"background\\\\\\\",\\\\n   320\\\\t        };\\\\n   321\\\\t\\\\n   322\\\\t        const connector = createConn({\\\\n   323\\\\t          registryPath: store.registryPath,\\\\n   324\\\\t          newThreadFilePath: () => store.threadPath(),\\\\n   325\\\\t          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\\\n   326\\\\t        });\\\\n   327\\\\t\\\\n   328\\\\t        // Start session - validation runs and reports unreachable lane\\\\n   329\\\\t        await connector.handlers.session_start(ctx, { reason: \\\\\\\"new\\\\\\\" });\\\\n   330\\\\t        const instance = connector.getInstance();\\\\n   331\\\\t        const state = connector.getState();\\\\n   332\\\\t\\\\n   333\\\\t        expect(instance).not.toBeNull();\\\\n   334\\\\t        expect(state).not.toBeNull();\\\\n   335\\\\t        if (instance === null || state === null) return;\\\\n   336\\\\t\\\\n   337\\\\t        // Verify validation reported the unreachable lane (smoothed_prompt)\\\\n   338\\\\t        expect(state.health.startupValidation).toBeDefined();\\\\n   339\\\\t        expect(state.health.startupValidation?.unreachable.length).toBeGreaterThan(0);\\\\n   340\\\\t        const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \\\\\\\"smoothed_prompt\\\\\\\");\\\\n   341\\\\t        expect(smoothEntry?.reason).toBe(\\\\\\\"unknown_model\\\\\\\");\\\\n   342\\\\t\\\\n   343\\\\t        // Capture continues despite validation failure\\\\n   344\\\\t        await connector.handlers.message_end(ctx, {\\\\n   345\\\\t          message: makeUserMessage(\\\\\\\"test prompt\\\\\\\"),\\\\n   346\\\\t          entryId: \\\\\\\"test-user\\\\\\\",\\\\n   347\\\\t        });\\\\n   348\\\\t        await connector.handlers.message_end(ctx, {\\\\n   349\\\\t          message: makeAssistantMessage({ text: \\\\\\\"test response\\\\\\\" }),\\\\n   350\\\\t          entryId: \\\\\\\"test-assistant\\\\\\\",\\\\n   351\\\\t        });\\\\n   352\\\\t        await connector.handlers.agent_end(ctx, {\\\\n   353\\\\t          messages: [makeUserMessage(\\\\\\\"test prompt\\\\\\\"), makeAssistantMessage({ text: \\\\\\\"test response\\\\\\\" })],\\\\n   354\\\\t        });\\\\n   355\\\\t\\\\n   356\\\\t        // Drain the scheduler to run derivations\\\\n   357\\\\t        const threadRef = state.threadRef;\\\\n   358\\\\t        await instance.sdk.drainSettled(threadRef);\\\\n   359\\\\t\\\\n   360\\\\t        // Inspect health to verify affected lane derivations failed\\\\n   361\\\\t        const health = await instance.sdk.inspect.health(threadRef);\\\\n   362\\\\t        expect(health.ok).toBe(true);\\\\n   363\\\\t        if (!health.ok) return;\\\\n   364\\\\t\\\\n   365\\\\t        // Verify that smoothed_prompt derivations failed classified (unreachable lane)\\\\n   366\\\\t        const smoothedFailed = health.value.owners.some((o) =>\\\\n   367\\\\t          o.kind === \\\\\\\"smoothed_prompt\\\\\\\" && o.counts.failed > 0\\\\n   368\\\\t        );\\\\n   369\\\\t        expect(smoothedFailed).toBe(true);\\\\n   370\\\\t\\\\n   371\\\\t        // Verify that turn_rendering derivations succeeded (reachable lane)\\\\n   372\\\\t        const turnRenderingReady = health.value.owners.some((o) =>\\\\n   373\\\\t          o.kind === \\\\\\\"turn_rendering\\\\\\\" && o.counts.ready > 0\\\\n   374\\\\t        );\\\\n   375\\\\t        expect(turnRenderingReady).toBe(true);\\\\n   376\\\\t\\\\n   377\\\\t        // Verify failures are queryable through health\\\\n   378\\\\t        expect(health.value.failures.length).toBeGreaterThan(0);\\\\n   379\\\\t        const smoothedFailure = health.value.failures.find((f) => f.form === \\\\\\\"smoothed_prompt\\\\\\\");\\\\n   380\\\\t        expect(smoothedFailure).toBeDefined();\\\\n   381\\\\t        expect(smoothedFailure?.reason).toContain(\\\\\\\"invalid_request\\\\\\\");\\\\n   382\\\\t        expect(smoothedFailure?.lastError).toContain(\\\\\\\"unreachable assignment lane\\\\\\\");\\\\n   383\\\\t\\\\n   384\\\\t        await connector.handlers.session_shutdown(ctx, { reason: \\\\\\\"shutdown\\\\\\\" });\\\\n   385\\\\t      } finally {\\\\n   386\\\\t        store.cleanup();\\\\n   387\\\\t      }\\\\n   388\\\\t    });\\\\n   389\\\\t\\\\n   390\\\\t    it(\\\\\\\"validation does not break the session - state remains functional\\\\\\\", () => {\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/streams/006-verify.stdout.log:47:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_22\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"{\\\\n  \\\\\\\"artifactsRead\\\\\\\": [\\\\n    \\\\\\\"docs/specs/02-pi-lhc/01-connector-core/stories/06-startup-validation-and-assignment-config.md\\\\\\\",\\\\n    \\\\\\\"docs/specs/02-pi-lhc/01-connector-core/tech-design.md\\\\\\\",\\\\n    \\\\\\\"docs/specs/02-pi-lhc/01-connector-core/test-plan.md\\\\\\\",\\\\n    \\\\\\\"docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/011-quick-fix.json\\\\\\\",\\\\n    \\\\\\\"packages/pi-lhc/src/inference/assignments.ts\\\\\\\",\\\\n    \\\\\\\"packages/pi-lhc/src/inference/startup-validation.ts\\\\\\\",\\\\n    \\\\\\\"packages/pi-lhc/src/inference/model-call.ts\\\\\\\",\\\\n    \\\\\\\"packages/pi-lhc/src/index.ts\\\\\\\",\\\\n    \\\\\\\"packages/pi-lhc/test/inference/assignments.test.ts\\\\\\\",\\\\n    \\\\\\\"packages/pi-lhc/test/inference/startup-validation.test.ts\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"reviewScopeSummary\\\\\\\": \\\\\\\"Follow-up verification focused on SV-001 through SV-005 after quick-fix/011, directly touched Story 6 code/tests, focused Story 6 tests, and configured story/epic gates.\\\\\\\",\\\\n  \\\\\\\"priorFindingStatuses\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"SV-001\\\\\\\",\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"still-open\\\\\\\",\\\\n      \\\\\\\"rationale\\\\\\\": \\\\\\\"The literal `unconfigured` placeholder is gone and defaults are now validated, but the shipped default is now `deterministic/default` in `defaultAssignments`. The production SDK path still uses `createModelCall(ctx)`, which resolves assignments through PI `ctx.modelRegistry.find(provider, model)`, not LHC's deterministic provider. No evidence shows `deterministic/default` is a real PI registry lane for the extension user, so AC-5.4's shipped defaults-function requirement remains unproven and appears to rely on a local verification lane.\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"SV-002\\\\\\\",\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"resolved\\\\\\\",\\\\n      \\\\\\\"rationale\\\\\\\": \\\\\\\"packages/pi-lhc/src/inference/assignments.ts now rejects unknown keys before merging, and direct proof showed `loadAssignments({made_up_kind:{...}})` throws `Unknown assignment key 'made_up_kind'`. The assignments test also covers this path.\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"SV-003\\\\\\\",\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"still-open\\\\\\\",\\\\n      \\\\\\\"rationale\\\\\\\": \\\\\\\"The report now stores a formatted `message` in `SessionState.health`, but `report()` still only calls `ctx.ui.notify` when `ctx.hasUI` is true and has no headless log/output branch. The headless test asserts state text and no UI notify, not an emitted headless channel.\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"SV-004\\\\\\\",\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"resolved\\\\\\\",\\\\n      \\\\\\\"rationale\\\\\\\": \\\\\\\"packages/pi-lhc/test/inference/startup-validation.test.ts now captures messages, drains the scheduler, and asserts failed `smoothed_prompt` plus queryable `inspect.health` failure details for the affected lane. Focused tests passed.\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"SV-005\\\\\\\",\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"resolved\\\\\\\",\\\\n      \\\\\\\"rationale\\\\\\\": \\\\\\\"`pnpm --filter pi-lhc verify` and `pnpm --filter pi-lhc verify-all` both passed with 20 test files and 140 tests.\\\\\\\"\\\\n    }\\\\n  ],\\\\n  \\\\\\\"newFindings\\\\\\\": [],\\\\n  \\\\\\\"openFindings\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"SV-001\\\\\\\",\\\\n      \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n      \\\\\\\"title\\\\\\\": \\\\\\\"Shipped defaults still are not proven production-reachable PI lanes\\\\\\\",\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"packages/pi-lhc/src/inference/model-call.ts:152-154 now defaults all assignments to `{ provider: \\\\\\\\\\\\\\\"deterministic\\\\\\\\\\\\\\\", id: \\\\\\\\\\\\\\\"default\\\\\\\\\\\\\\\" }`; direct proof returned `{provider:\\\\\\\\\\\\\\\"deterministic\\\\\\\\\\\\\\\",model:\\\\\\\\\\\\\\\"default\\\\\\\\\\\\\\\",prompt:\\\\\\\\\\\\\\\"smoothing-v1\\\\\\\\\\\\\\\"}` for `loadAssignments(undefined).smoothed_prompt`. But packages/pi-lhc/src/index.ts still builds production inference with `call: createModelCall(ctx)` and those assignments, and packages/pi-lhc/src/inference/model-call.ts:99-109 resolves every assignment through `ctx.modelRegistry.find(provider, model)`. No code path activates LHC's deterministic provider for these defaults, and no artifact proves PI's production registry contains `deterministic/default`.\\\\\\\",\\\\n      \\\\\\\"affectedFiles\\\\\\\": [\\\\n        \\\\\\\"packages/pi-lhc/src/inference/model-call.ts\\\\\\\",\\\\n        \\\\\\\"packages/pi-lhc/src/inference/assignments.ts\\\\\\\",\\\\n        \\\\\\\"packages/pi-lhc/src/index.ts\\\\\\\",\\\\n        \\\\\\\"packages/pi-lhc/test/inference/assignments.test.ts\\\\\\\"\\\\n      ],\\\\n      \\\\\\\"requirementIds\\\\\\\": [\\\\n        \\\\\\\"AC-5.4\\\\\\\",\\\\n        \\\\\\\"TC-5.4\\\\\\\",\\\\n        \\\\\\\"Real-Code Workaround Standard\\\\\\\"\\\\n      ],\\\\n      \\\\\\\"recommendedFixScope\\\\\\\": \\\\\\\"same-session-implementor\\\\\\\",\\\\n      \\\\\\\"blocking\\\\\\\": true\\\\n    },\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"SV-003\\\\\\\",\\\\n      \\\\\\\"severity\\\\\\\": \\\\\\\"major\\\\\\\",\\\\n      \\\\\\\"title\\\\\\\": \\\\\\\"Headless unreachable-lane reporting still has no emitted headless channel\\\\\\\",\\\\n      \\\\\\\"evidence\\\\\\\": \\\\\\\"packages/pi-lhc/src/inference/startup-validation.ts:91-118 marks the flag and stores the formatted message in `state.health.startupValidation`, but only emits via `ctx.ui.notify` under `if (ctx.hasUI)`. There is no `else` branch or injected output/log channel for headless mode. packages/pi-lhc/test/inference/startup-validation.test.ts:161-190 verifies stored text and explicitly expects `notify` not to be called; it does not prove a headless-mode report reaches an output channel.\\\\\\\",\\\\n      \\\\\\\"affectedFiles\\\\\\\": [\\\\n        \\\\\\\"packages/pi-lhc/src/inference/startup-validation.ts\\\\\\\",\\\\n        \\\\\\\"packages/pi-lhc/test/inference/startup-validation.test.ts\\\\\\\"\\\\n      ],\\\\n      \\\\\\\"requirementIds\\\\\\\": [\\\\n        \\\\\\\"AC-5.2\\\\\\\",\\\\n        \\\\\\\"TC-5.2\\\\\\\"\\\\n      ],\\\\n      \\\\\\\"recommendedFixScope\\\\\\\": \\\\\\\"same-session-implementor\\\\\\\",\\\\n      \\\\\\\"blocking\\\\\\\": true\\\\n    }\\\\n  ],\\\\n  \\\\\\\"requirementCoverage\\\\\\\": {\\\\n    \\\\\\\"verified\\\\\\\": [\\\\n      \\\\\\\"AC-5.1 / TC-5.1: validation iterates all `FORM_KINDS` and runs from `session_start` before capture hooks are used.\\\\\\\",\\\\n      \\\\\\\"AC-5.2 partial: unreachable reports include kind, provider/model, reason, and fix; interactive `ctx.ui.notify` path exists.\\\\\\\",\\\\n      \\\\\\\"AC-5.3 / TC-5.3: focused test now captures, drains derivations, and verifies affected-lane failed forms through `inspect.health`.\\\\\\\",\\\\n      \\\\\\\"AC-5.5 / TC-5.5: complete known-kind overrides take effect on next load.\\\\\\\",\\\\n      \\\\\\\"TC-5.6 partial: incomplete known-kind assignments, unknown prompt names, explicit placeholders, and unknown config keys fail loudly.\\\\\\\",\\\\n      \\\\\\\"Story gate passed: `pnpm --filter pi-lhc verify`.\\\\\\\",\\\\n      \\\\\\\"Epic gate passed: `pnpm --filter pi-lhc verify-all`.\\\\\\\"\\\\n    ],\\\\n    \\\\\\\"unverified\\\\\\\": [\\\\n      \\\\\\\"AC-5.4 / TC-5.4: shipped defaults are real production PI registry lanes that let derivations function without operator config.\\\\\\\",\\\\n      \\\\\\\"AC-5.2 / TC-5.2: unreachable-lane report is emitted through a headless output/log channel, not only stored in health.\\\\\\\"\\\\n    ]\\\\n  },\\\\n  \\\\\\\"gatesRun\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"command\\\\\\\": \\\\\\\"pnpm --filter pi-lhc exec vitest run test/inference/startup-validation.test.ts test/inference/assignments.test.ts\\\\\\\",\\\\n      \\\\\\\"result\\\\\\\": \\\\\\\"pass\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"command\\\\\\\": \\\\\\\"pnpm --filter pi-lhc verify\\\\\\\",\\\\n      \\\\\\\"result\\\\\\\": \\\\\\\"pass\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"command\\\\\\\": \\\\\\\"pnpm --filter pi-lhc verify-all\\\\\\\",\\\\n      \\\\\\\"result\\\\\\\": \\\\\\\"pass\\\\\\\"\\\\n    }\\\\n  ],\\\\n  \\\\\\\"productionPathFindings\\\\\\\": [\\\\n    \\\\\\\"Production default assignments now use `deterministic/default`, but the production call path still routes through PI `modelRegistry.find`; no real deterministic provider is wired for the extension runtime.\\\\\\\",\\\\n    \\\\\\\"Headless startup-validation reporting still mutates health only; no emitted headless output/log channel is present.\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"recommendedNextStep\\\\\\\": \\\\\\\"revise\\\\\\\",\\\\n  \\\\\\\"recommendedFixScope\\\\\\\": \\\\\\\"same-session-implementor\\\\\\\",\\\\n  \\\\\\\"openQuestions\\\\\\\": [],\\\\n  \\\\\\\"additionalObservations\\\\\\\": [\\\\n    \\\\\\\"The previous gate blocker is closed; both configured gates passed.\\\\\\\",\\\\n    \\\\\\\"The prior TC-5.3 coverage gap is closed by the new capture/drain/inspect health test.\\\\\\\"\\\\n  ]\\\\n}\\\"}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/progress/005-continue.status.json:10:  \\\"provider\\\": \\\"claude-code\\\",\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/story-lead/progress/001-story-lead.progress.jsonl:13:{\\\"storyRunId\\\":\\\"06-startup-validation-and-assignment-config-story-run-001\\\",\\\"sequence\\\":13,\\\"timestamp\\\":\\\"2026-06-14T13:22:25.139Z\\\",\\\"type\\\":\\\"child-process-stopped\\\",\\\"summary\\\":\\\"Stopped stale story-continue provider process 6485 after interruption handling.\\\",\\\"data\\\":{\\\"storyId\\\":\\\"06-startup-validation-and-assignment-config\\\",\\\"storyRunId\\\":\\\"06-startup-validation-and-assignment-config-story-run-001\\\",\\\"command\\\":\\\"story-continue\\\",\\\"artifactPath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/005-continue.json\\\",\\\"statusArtifactPath\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/progress/005-continue.status.json\\\",\\\"cleanedUpAt\\\":\\\"2026-06-14T13:22:25.138Z\\\",\\\"provider\\\":\\\"claude-code\\\",\\\"pid\\\":6485,\\\"streamPaths\\\":{\\\"stdoutPath\\\":\\\"/
   if (!health.ok) return;","+","+        // Verify that smoothed_prompt derivations failed (unreachable lane)","+        const smoothedFailed = health.value.owners.some((o) =>","+          o.kind === \"smoothed_prompt\" && o.counts.failed > 0","+        );","+        expect(smoothed).toBe(true);","+","+        // Verify that tool_call_summary derivations succeeded (reachable lane)","+        const toolCallReady = health.value.owners.some((o) =>","+          o.kind === \"tool_call_summary\" && o.counts.ready > 0","+        );","+        expect(toolCallReady).toBe(true);","+","+        // Verify failures are queryable through health","+        expect(health.value.failures.length).toBeGreaterThan(0);","+        const smoothedFailure = health.value.failures.find((f) => f.form === \"smoothed_prompt\");","+        expect(smoothedFailure).toBeDefined();","+","+        await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });","+      } finally {","+        store.cleanup();","+      }","     });"," ","     it(\"validation does not break the session - state remains functional\", () => {"]}],"userModified":false,"replaceAll":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_85407c874310415ea93c533f","type":"tool_result","content":"265\t      expect(() => report(validationReport, ctx, state)).not.toThrow();\n266\t\n267\t      // State should remain intact for capture to continue\n268\t      expect(\"filePath\" in state.threadRef ? state.threadRef.filePath : undefined).toBe(\"/test/thread.sqlite\");\n269\t      expect(state.flags.startupValidationReported).toBe(true);\n270\t    });\n271\t\n272\t    it(\"affected lane derivations fail classified and queryable through health\", () => {\n273\t      const ctx = createMockContext();\n274\t      const assignments = createAssignments({\n275\t        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n276\t        tool_call_summary: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n277\t      });\n278\t\n279\t      const validationReport = validateReachable(assignments, ctx);\n280\t\n281\t      const state: SessionState = {\n282\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n283\t        flags: { startupValidationReported: false },\n284\t        health: {},\n285\t      };\n286\t\n287\t      report(validationReport, ctx, state);\n288\t\n289\t      // Health should contain the structured report\n290\t      expect(state.health.startupValidation).toBeDefined();\n291\t      expect(state.health.startupValidation?.unreachable).toHaveLength(2); // 2 kinds configured with unknown provider/model\n292\t\n293\t      // Each unreachable lane is classified with reason and fix\n294\t      const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n295\t      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n296\t      expect(smoothEntry?.fix).toBeDefined();\n297\t\n298\t      // Queryable - callers can read health to determine which lanes are affected\n299\t      const affectedKinds = state.health.startupValidation?.unreachable.map((e) => e.kind);\n300\t      expect(affectedKinds).toContain(\"smoothed_prompt\");\n301\t      expect(affectedKinds).toContain(\"tool_call_summary\");\n302\t    });\n303\t\n304\t    it(\"validation does not break the session - state remains functional\", () => {\n305\t      const ctx = createMockContext();\n306\t      const assignments = createAssignments();\n307\t\n308\t      const validationReport = validateReachable(assignments, ctx);\n309\t\n310\t      const state: SessionState = {\n311\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n312\t        flags: { startupValidationReported: false },\n313\t        health: {},\n314\t      };\n315\t\n316\t      report(validationReport, ctx, state);\n317\t\n318\t      // State should be fully functional for capture operations\n319\t      expect(state.threadRef).toBeDefined();\n320\t      expect(\"filePath\" in state.threadRef && typeof state.threadRef.filePath === \"string\").toBe(true);\n321\t      expect(state.flags).toBeDefined();\n322\t      expect(state.health).toBeDefined();\n323\t\n324\t      // Health should be queryable\n325\t      expect(state.health.startupValidation).toBeDefined();\n326\t    });\n327\t\n328\t    it(\"empty unreachable list means all lanes reachable - session healthy\", () => {\n329\t      const models: ModelHandle[] = [{ provider: \"openai\", id: \"gpt-4o\" }];\n330\t      const ctx = createMockContext(models, models[0], true);\n331\t      const assignments = createAssignments({\n332\t        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n333\t      });\n334\t\n335\t      const validationReport = validateReachable(assignments, ctx);\n336\t\n337\t      const state: SessionState = {\n338\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n339\t        flags: { startupValidationReported: false },\n340\t        health: {},\n341\t      };\n342\t\n343\t      report(validationReport, ctx, state);\n344\t\n345\t      // Empty unreachable means all lanes validated successfully\n346\t      expect(state.health.startupValidation?.unreachable).toHaveLength(0);\n347\t    });\n348\t\n349\t    it(\"report function never throws - always succeeds to persist diagnostic\", () => {\n350\t      const ctx = createMockContext();\n351\t      const assignments = createAssignments();\n352\t\n353\t      // Create various report states\n354\t      const emptyReport = { unreachable: [] };\n355\t      const fullReport = validateReachable(assignments, ctx);\n356\t\n357\t      const state: SessionState = {\n358\t        threadRef: { filePath: \"/test/thread.sqlite\" },\n359\t        flags: { startupValidationReported: false },\n360\t        health: {},\n361\t      };\n362\t\n363\t      // None of these should throw\n364\t      expect(() => report(emptyReport, ctx, state)).not.toThrow();"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"7b7f4065-17d9-48e4-b34e-17f239ad2948","timestamp":"2026-06-14T13:21:40.483Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/startup-validation.test.ts","content":"      expect(() => report(validationReport, ctx, state)).not.toThrow();\n\n      // State should remain intact for capture to continue\n      expect(\"filePath\" in state.threadRef ? state.threadRef.filePath : undefined).toBe(\"/test/thread.sqlite\");\n      expect(state.flags.startupValidationReported).toBe(true);\n    });\n\n    it(\"affected lane derivations fail classified and queryable through health\", () => {\n      const ctx = createMockContext();\n      const assignments = createAssignments({\n        smoothed_prompt: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"unknown\", model: \"unknown\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n      });\n\n      const validationReport = validateReachable(assignments, ctx);\n\n      const state: SessionState = {\n        threadRef: { filePath: \"/test/thread.sqlite\" },\n        flags: { startupValidationReported: false },\n        health: {},\n      };\n\n      report(validationReport, ctx, state);\n\n      // Health should contain the structured report\n      expect(state.health.startupValidation).toBeDefined();\n      expect(state.health.startupValidation?.unreachable).toHaveLength(2); // 2 kinds configured with unknown provider/model\n\n      // Each unreachable lane is classified with reason and fix\n      const smoothEntry = state.health.startupValidation?.unreachable.find((e) => e.kind === \"smoothed_prompt\");\n      expect(smoothEntry?.reason).toBe(\"unknown_model\");\n      expect(smoothEntry?.fix).toBeDefined();\n\n      // Queryable - callers can read health to determine which lanes are affected\n      const affectedKinds = state.health.startupValidation?.unreachable.map((e) => e.kind);\n      expect(affectedKinds).toContain(\"smoothed_prompt\");\n      expect(affectedKinds).toContain(\"tool_call_summary\");\n    });\n\n    it(\"validation does not break the session - state remains functional\", () => {\n      const ctx = createMockContext();\n      const assignments = createAssignments();\n\n      const validationReport = validateReachable(assignments, ctx);\n\n      const state: SessionState = {\n        threadRef: { filePath: \"/test/thread.sqlite\" },\n        flags: { startupValidationReported: false },\n        health: {},\n      };\n\n      report(validationReport, ctx, state);\n\n      // State should be fully functional for capture operations\n      expect(state.threadRef).toBeDefined();\n      expect(\"filePath\" in state.threadRef && typeof state.threadRef.filePath === \"string\").toBe(true);\n      expect(state.flags).toBeDefined();\n      expect(state.health).toBeDefined();\n\n      // Health should be queryable\n      expect(state.health.startupValidation).toBeDefined();\n    });\n\n    it(\"empty unreachable list means all lanes reachable - session healthy\", () => {\n      const models: ModelHandle[] = [{ provider: \"openai\", id: \"gpt-4o\" }];\n      const ctx = createMockContext(models, models[0], true);\n      const assignments = createAssignments({\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n      });\n\n      const validationReport = validateReachable(assignments, ctx);\n\n      const state: SessionState = {\n        threadRef: { filePath: \"/test/thread.sqlite\" },\n        flags: { startupValidationReported: false },\n        health: {},\n      };\n\n      report(validationReport, ctx, state);\n\n      // Empty unreachable means all lanes validated successfully\n      expect(state.health.startupValidation?.unreachable).toHaveLength(0);\n    });\n\n    it(\"report function never throws - always succeeds to persist diagnostic\", () => {\n      const ctx = createMockContext();\n      const assignments = createAssignments();\n\n      // Create various report states\n      const emptyReport = { unreachable: [] };\n      const fullReport = validateReachable(assignments, ctx);\n\n      const state: SessionState = {\n        threadRef: { filePath: \"/test/thread.sqlite\" },\n        flags: { startupValidationReported: false },\n        health: {},\n      };\n\n      // None of these should throw\n      expect(() => report(emptyReport, ctx, state)).not.toThrow();","numLines":100,"startLine":265,"totalLines":373}}}

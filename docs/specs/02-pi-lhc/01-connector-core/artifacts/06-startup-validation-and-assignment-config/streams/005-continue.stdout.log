{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f6619037d9f246039ae32ce6","type":"tool_result","content":"105\t\n106\t/** Load + shape-validate the seven derivation assignments from operator config.\n107\t *\n108\t *  - Merges operator config over shipped defaults (AC-5.4).\n109\t *  - Falls back to defaults when config is missing or undefined (AC-5.4).\n110\t *  - User overrides take effect on next session start with no code change (AC-5.5).\n111\t *  - Incomplete assignments fail loud at initialization (AC-5.5, TC-5.6).\n112\t *  - Unknown prompts fail loud at initialization (TC-5.6).\n113\t *  - Placeholder values fail loud at initialization (TC-5.6).\n114\t *\n115\t *  This function throws `AssignmentValidationError` on any validation failure;\n116\t *  the caller (typically the session_start hook) catches and surfaces the error\n117\t *  as an actionable diagnostic. It never returns an incomplete or placeholder map\n118\t *  that would mask a misconfiguration (story §Anti-Shim Requirements). */\n119\texport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n120\t  // Start with shipped defaults (all seven kinds with concrete assignments)\n121\t  const baseAssignments = defaultAssignments();\n122\t\n123\t  // If config is missing/null/undefined, use defaults as-is\n124\t  if (config === null || config === undefined || typeof config !== \"object\") {\n125\t    return baseAssignments as Record<FormKind, ModelAssignment>;\n126\t  }\n127\t\n128\t  const configObj = config as Partial<Record<FormKind, Partial<ModelAssignment>>>;\n129\t  const mergedAssignments: Partial<Record<FormKind, ModelAssignment>> = { ...baseAssignments };\n130\t\n131\t  // Merge operator config over defaults for kinds that are specified\n132\t  for (const kind of FORM_KINDS) {\n133\t    const override = configObj[kind as FormKind];\n134\t    if (override !== undefined) {\n135\t      // If override is provided, it must specify all three fields (provider, model, prompt).\n136\t      // Partial overrides are not allowed to avoid masking misconfiguration with placeholder defaults.\n137\t      // If you want to use defaults, don't specify that kind in the config.\n138\t      if (override.provider === undefined || override.model === undefined || override.prompt === undefined) {\n139\t        throw new AssignmentValidationError(kind, \"incomplete\");\n140\t      }\n141\t\n142\t      // At this point, all fields are present - cast to ModelAssignment\n143\t      const completeOverride = override as ModelAssignment;\n144\t\n145\t      // Validate the override for placeholders and unknown prompts\n146\t      validateAssignment(kind, completeOverride);\n147\t\n148\t      // Use the override (all fields are present and validated)\n149\t      mergedAssignments[kind as FormKind] = completeOverride;\n150\t    }\n151\t  }\n152\t\n153\t  // At this point we have validated all seven kinds (FORM_KINDS covers all seven)\n154\t  return mergedAssignments as Record<FormKind, ModelAssignment>;"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"274cd3ff-b764-42e0-aee8-d183fc40158a","timestamp":"2026-06-14T13:21:18.199Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/assignments.ts","content":"\n/** Load + shape-validate the seven derivation assignments from operator config.\n *\n *  - Merges operator config over shipped defaults (AC-5.4).\n *  - Falls back to defaults when config is missing or undefined (AC-5.4).\n *  - User overrides take effect on next session start with no code change (AC-5.5).\n *  - Incomplete assignments fail loud at initialization (AC-5.5, TC-5.6).\n *  - Unknown prompts fail loud at initialization (TC-5.6).\n *  - Placeholder values fail loud at initialization (TC-5.6).\n *\n *  This function throws `AssignmentValidationError` on any validation failure;\n *  the caller (typically the session_start hook) catches and surfaces the error\n *  as an actionable diagnostic. It never returns an incomplete or placeholder map\n *  that would mask a misconfiguration (story §Anti-Shim Requirements). */\nexport function loadAssignments(config: unknown): Record<FormKind, ModelAssignment> {\n  // Start with shipped defaults (all seven kinds with concrete assignments)\n  const baseAssignments = defaultAssignments();\n\n  // If config is missing/null/undefined, use defaults as-is\n  if (config === null || config === undefined || typeof config !== \"object\") {\n    return baseAssignments as Record<FormKind, ModelAssignment>;\n  }\n\n  const configObj = config as Partial<Record<FormKind, Partial<ModelAssignment>>>;\n  const mergedAssignments: Partial<Record<FormKind, ModelAssignment>> = { ...baseAssignments };\n\n  // Merge operator config over defaults for kinds that are specified\n  for (const kind of FORM_KINDS) {\n    const override = configObj[kind as FormKind];\n    if (override !== undefined) {\n      // If override is provided, it must specify all three fields (provider, model, prompt).\n      // Partial overrides are not allowed to avoid masking misconfiguration with placeholder defaults.\n      // If you want to use defaults, don't specify that kind in the config.\n      if (override.provider === undefined || override.model === undefined || override.prompt === undefined) {\n        throw new AssignmentValidationError(kind, \"incomplete\");\n      }\n\n      // At this point, all fields are present - cast to ModelAssignment\n      const completeOverride = override as ModelAssignment;\n\n      // Validate the override for placeholders and unknown prompts\n      validateAssignment(kind, completeOverride);\n\n      // Use the override (all fields are present and validated)\n      mergedAssignments[kind as FormKind] = completeOverride;\n    }\n  }\n\n  // At this point we have validated all seven kinds (FORM_KINDS covers all seven)\n  return mergedAssignments as Record<FormKind, ModelAssignment>;","numLines":50,"startLine":105,"totalLines":156}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_5e790bb06d4d4c919c8ca869","type":"tool_result","content":"145\t/**\n146\t * Default assignments for all seven FormKinds.\n147\t *\n148\t * Story 6 implements config loading; these defaults keep Story 5's production\n149\t * path on LHC inference by using PI's first available model when present.\n150\t */\n151\texport function defaultAssignments(\n152\t  model: { provider: string; id: string } = { provider: \"pi-lhc\", id: \"unconfigured\" },\n153\t): Record<string, { provider: string; model: string; prompt: string }> {\n154\t  return {\n155\t    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n156\t    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n157\t    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n158\t    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n159\t    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n160\t    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n161\t    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n162\t  };\n163\t}\n164\t"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"1efd90a9-6be6-4d94-9873-19bba7f3a432","timestamp":"2026-06-14T13:20:55.804Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/model-call.ts","content":"/**\n * Default assignments for all seven FormKinds.\n *\n * Story 6 implements config loading; these defaults keep Story 5's production\n * path on LHC inference by using PI's first available model when present.\n */\nexport function defaultAssignments(\n  model: { provider: string; id: string } = { provider: \"pi-lhc\", id: \"unconfigured\" },\n): Record<string, { provider: string; model: string; prompt: string }> {\n  return {\n    smoothed_prompt: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n    tool_call_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n    tool_result_summary: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n    turn_rendering: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n    lower_band_projection: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n    chunk_summary_detailed: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n    chunk_summary_brief: { provider: model.provider, model: model.id, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n  };\n}\n","numLines":20,"startLine":145,"totalLines":164}}}

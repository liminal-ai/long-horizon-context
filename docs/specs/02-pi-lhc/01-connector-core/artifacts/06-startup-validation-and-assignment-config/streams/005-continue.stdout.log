{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1a36bf717f0540cb86d96496","type":"tool_result","content":"70\t    }\n71\t  }\n72\t\n73\t  return { unreachable };\n74\t}\n75\t\n76\t/** Surface unreachable lanes via ctx.ui when available + structured diagnostic.\n77\t *\n78\t *  Reporting is headless-safe (AC-5.2):\n79\t *  - If ctx.hasUI is true, surface through ctx.ui.notify with a formatted report.\n80\t *  - Always persist the structured ValidationReport to SessionState.health.\n81\t *  - Capture continues running even when validation fails (AC-5.3).\n82\t *\n83\t *  This function never throws; validation failures are diagnostic, not fatal.\n84\t *  The affected lane's derivations will fail classified and queryable through\n85\t *  health (AC-5.3), but the session itself remains functional for capture. */\n86\texport function report(\n87\t  r: ValidationReport,\n88\t  ctx: ExtensionContext,\n89\t  state: SessionState,\n90\t): void {\n91\t  // Persist the structured report to SessionState.health (always, even in headless)\n92\t  state.health.startupValidation = r;\n93\t\n94\t  // Mark that we've reported startup validation (avoids duplicate reporting)\n95\t  state.flags.startupValidationReported = true;\n96\t\n97\t  // If there are unreachable lanes, surface them through ctx.ui when available\n98\t  if (r.unreachable.length > 0) {\n99\t    const lines = [\n100\t      \"pi-lhc startup validation: unreachable derivation lanes\",\n101\t      \"\",\n102\t      ...r.unreachable.map(\n103\t        (u) =>\n104\t          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n105\t      ),\n106\t      \"\",\n107\t      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n108\t    ];\n109\t\n110\t    const message = lines.join(\"\\n\");\n111\t\n112\t    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n113\t    if (ctx.hasUI) {\n114\t      ctx.ui.notify(message, { level: \"warn\" });\n115\t    }\n116\t  }\n117\t}\n118\t"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"0981943a-d36f-4252-93e7-706d48835653","timestamp":"2026-06-14T13:21:28.976Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/inference/startup-validation.ts","content":"    }\n  }\n\n  return { unreachable };\n}\n\n/** Surface unreachable lanes via ctx.ui when available + structured diagnostic.\n *\n *  Reporting is headless-safe (AC-5.2):\n *  - If ctx.hasUI is true, surface through ctx.ui.notify with a formatted report.\n *  - Always persist the structured ValidationReport to SessionState.health.\n *  - Capture continues running even when validation fails (AC-5.3).\n *\n *  This function never throws; validation failures are diagnostic, not fatal.\n *  The affected lane's derivations will fail classified and queryable through\n *  health (AC-5.3), but the session itself remains functional for capture. */\nexport function report(\n  r: ValidationReport,\n  ctx: ExtensionContext,\n  state: SessionState,\n): void {\n  // Persist the structured report to SessionState.health (always, even in headless)\n  state.health.startupValidation = r;\n\n  // Mark that we've reported startup validation (avoids duplicate reporting)\n  state.flags.startupValidationReported = true;\n\n  // If there are unreachable lanes, surface them through ctx.ui when available\n  if (r.unreachable.length > 0) {\n    const lines = [\n      \"pi-lhc startup validation: unreachable derivation lanes\",\n      \"\",\n      ...r.unreachable.map(\n        (u) =>\n          `  • ${u.kind}: ${u.provider}/${u.model}\\n    Reason: ${u.reason}\\n    Fix: ${u.fix}`,\n      ),\n      \"\",\n      `Capture will continue, but derivations on these lanes will fail. Update your PI settings or assignment config to resolve.`,\n    ];\n\n    const message = lines.join(\"\\n\");\n\n    // Surface through UI when available (never assume a TUI; guard on ctx.hasUI)\n    if (ctx.hasUI) {\n      ctx.ui.notify(message, { level: \"warn\" });\n    }\n  }\n}\n","numLines":49,"startLine":70,"totalLines":118}}}

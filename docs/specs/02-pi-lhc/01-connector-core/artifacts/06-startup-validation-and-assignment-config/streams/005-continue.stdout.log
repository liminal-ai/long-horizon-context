{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d74760b232fb45538f2660cc","type":"tool_result","content":"1\t// TC-4.5: closed-loop proof through the PI connector hooks.\n2\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n3\timport {\n4\t  DEFAULT_PROMPT_NAMES,\n5\t  type FormKind,\n6\t  type ModelAssignment,\n7\t  type ModelCall,\n8\t  type ModelCallResult,\n9\t  type SdkConfig,\n10\t  type ThreadRef,\n11\t} from \"lhc\";\n12\timport { createConnector, type Connector } from \"../../src/index.js\";\n13\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n14\timport { makeAssistantMessage, makeUserMessage } from \"../fixtures/synthetic.js\";\n15\timport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"../fixtures/model-call.js\";\n16\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n17\t\n18\ttype Deferred<T> = { promise: Promise<T>; resolve: (value: T) => void };\n19\t\n20\tfunction deferred<T>(): Deferred<T> {\n21\t  let resolve!: (value: T) => void;\n22\t  const promise = new Promise<T>((res) => {\n23\t    resolve = res;\n24\t  });\n25\t  return { promise, resolve };\n26\t}\n27\t\n28\tfunction assignments(overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {}): Record<FormKind, ModelAssignment> {\n29\t  const base = { provider: \"openai\", model: \"good\" };\n30\t  return {\n31\t    smoothed_prompt: { ...base, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt, ...(overrides.smoothed_prompt ?? {}) },\n32\t    tool_call_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary, ...(overrides.tool_call_summary ?? {}) },\n33\t    tool_result_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary, ...(overrides.tool_result_summary ?? {}) },\n34\t    turn_rendering: { ...base, prompt: DEFAULT_PROMPT_NAMES.turn_rendering, ...(overrides.turn_rendering ?? {}) },\n35\t    lower_band_projection: { ...base, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection, ...(overrides.lower_band_projection ?? {}) },\n36\t    chunk_summary_detailed: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed, ...(overrides.chunk_summary_detailed ?? {}) },\n37\t    chunk_summary_brief: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief, ...(overrides.chunk_summary_brief ?? {}) },\n38\t  };\n39\t}\n40\t\n41\tasync function captureClosedTurn(\n42\t  connector: Connector,\n43\t  ctx: ExtensionContext,\n44\t  userText: string,\n45\t  assistantText: string,\n46\t): Promise<void> {\n47\t  await connector.handlers.message_end(ctx, {\n48\t    message: makeUserMessage(userText),\n49\t    entryId: `${userText}-user`,\n50\t  });\n51\t  await connector.handlers.message_end(ctx, {\n52\t    message: makeAssistantMessage({ text: assistantText }),\n53\t    entryId: `${userText}-assistant`,\n54\t  });\n55\t  await connector.handlers.agent_end(ctx, {\n56\t    messages: [makeUserMessage(userText), makeAssistantMessage({ text: assistantText })],\n57\t  });\n58\t}\n59\t\n60\tdescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n61\t  let store: TempStore;\n62\t  let connector: Connector;\n63\t  let ctx: ExtensionContext;\n64\t  let threadRef: ThreadRef | null;\n65\t\n66\t  beforeEach(() => {\n67\t    store = tempStore();\n68\t    threadRef = null;\n69\t    ctx = {\n70\t      cwd: \"/test/closed-loop\",\n71\t      hasUI: false,\n72\t      modelRegistry: {\n73\t        find: (provider: string, model: string) =>\n74\t          provider === \"openai\" ? { provider, id: model } : undefined,\n75\t        hasConfiguredAuth: () => true,\n76\t        getAvailable: () => [{ provider: \"openai\", id: \"good\" }],\n77\t      },\n78\t      ui: { notify: () => {} },\n79\t      sessionManager: { getEntries: () => [] },\n80\t    };\n81\t  });\n82\t\n83\t  afterEach(async () => {\n84\t    if (threadRef !== null) {\n85\t      await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n86\t    }\n87\t    store.cleanup();\n88\t  });\n89\t\n90\t  it(\"persists one ready form and one classified failed form queryable through inspect/health\", async () => {\n91\t    const modelCall = fakeModelCallRouter({\n92\t      \"openai/good\": fakeModelCallText(\"ready derived text\"),\n93\t      \"openai/fail\": fakeModelCallFailure(\"auth\", \"missing auth\"),\n94\t    });\n95\t    const sdkConfig: SdkConfig = {\n96\t      inference: {\n97\t        call: modelCall,\n98\t        assignments: assignments({ turn_rendering: { model: \"fail\" } }),\n99\t      },\n100\t      mode: \"background\","}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"d2c8e9ea-84da-4733-bcf5-6ff04ba4e34c","timestamp":"2026-06-14T13:21:54.618Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts","content":"// TC-4.5: closed-loop proof through the PI connector hooks.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  DEFAULT_PROMPT_NAMES,\n  type FormKind,\n  type ModelAssignment,\n  type ModelCall,\n  type ModelCallResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { makeAssistantMessage, makeUserMessage } from \"../fixtures/synthetic.js\";\nimport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"../fixtures/model-call.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\ntype Deferred<T> = { promise: Promise<T>; resolve: (value: T) => void };\n\nfunction deferred<T>(): Deferred<T> {\n  let resolve!: (value: T) => void;\n  const promise = new Promise<T>((res) => {\n    resolve = res;\n  });\n  return { promise, resolve };\n}\n\nfunction assignments(overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {}): Record<FormKind, ModelAssignment> {\n  const base = { provider: \"openai\", model: \"good\" };\n  return {\n    smoothed_prompt: { ...base, prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt, ...(overrides.smoothed_prompt ?? {}) },\n    tool_call_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_call_summary, ...(overrides.tool_call_summary ?? {}) },\n    tool_result_summary: { ...base, prompt: DEFAULT_PROMPT_NAMES.tool_result_summary, ...(overrides.tool_result_summary ?? {}) },\n    turn_rendering: { ...base, prompt: DEFAULT_PROMPT_NAMES.turn_rendering, ...(overrides.turn_rendering ?? {}) },\n    lower_band_projection: { ...base, prompt: DEFAULT_PROMPT_NAMES.lower_band_projection, ...(overrides.lower_band_projection ?? {}) },\n    chunk_summary_detailed: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed, ...(overrides.chunk_summary_detailed ?? {}) },\n    chunk_summary_brief: { ...base, prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief, ...(overrides.chunk_summary_brief ?? {}) },\n  };\n}\n\nasync function captureClosedTurn(\n  connector: Connector,\n  ctx: ExtensionContext,\n  userText: string,\n  assistantText: string,\n): Promise<void> {\n  await connector.handlers.message_end(ctx, {\n    message: makeUserMessage(userText),\n    entryId: `${userText}-user`,\n  });\n  await connector.handlers.message_end(ctx, {\n    message: makeAssistantMessage({ text: assistantText }),\n    entryId: `${userText}-assistant`,\n  });\n  await connector.handlers.agent_end(ctx, {\n    messages: [makeUserMessage(userText), makeAssistantMessage({ text: assistantText })],\n  });\n}\n\ndescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n  let store: TempStore;\n  let connector: Connector;\n  let ctx: ExtensionContext;\n  let threadRef: ThreadRef | null;\n\n  beforeEach(() => {\n    store = tempStore();\n    threadRef = null;\n    ctx = {\n      cwd: \"/test/closed-loop\",\n      hasUI: false,\n      modelRegistry: {\n        find: (provider: string, model: string) =>\n          provider === \"openai\" ? { provider, id: model } : undefined,\n        hasConfiguredAuth: () => true,\n        getAvailable: () => [{ provider: \"openai\", id: \"good\" }],\n      },\n      ui: { notify: () => {} },\n      sessionManager: { getEntries: () => [] },\n    };\n  });\n\n  afterEach(async () => {\n    if (threadRef !== null) {\n      await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n    }\n    store.cleanup();\n  });\n\n  it(\"persists one ready form and one classified failed form queryable through inspect/health\", async () => {\n    const modelCall = fakeModelCallRouter({\n      \"openai/good\": fakeModelCallText(\"ready derived text\"),\n      \"openai/fail\": fakeModelCallFailure(\"auth\", \"missing auth\"),\n    });\n    const sdkConfig: SdkConfig = {\n      inference: {\n        call: modelCall,\n        assignments: assignments({ turn_rendering: { model: \"fail\" } }),\n      },\n      mode: \"background\",","numLines":100,"startLine":1,"totalLines":231}}}

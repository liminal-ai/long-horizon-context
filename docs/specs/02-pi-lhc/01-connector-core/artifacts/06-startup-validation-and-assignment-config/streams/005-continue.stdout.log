{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b5f2da03ef144613a332f392","type":"tool_result","content":"100\t      mode: \"background\",\n101\t      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n102\t    };\n103\t\n104\t    connector = createConnector({\n105\t      registryPath: store.registryPath,\n106\t      newThreadFilePath: () => store.threadPath(),\n107\t      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n108\t    });\n109\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n110\t    const instance = connector.getInstance();\n111\t    const state = connector.getState();\n112\t    expect(instance).not.toBeNull();\n113\t    expect(state).not.toBeNull();\n114\t    if (instance === null || state === null) return;\n115\t    threadRef = state.threadRef;\n116\t\n117\t    await captureClosedTurn(connector, ctx, \"please summarize this file\", \"here is the summary\");\n118\t    await instance.sdk.drainSettled(threadRef);\n119\t\n120\t    const health = await instance.sdk.inspect.health(threadRef);\n121\t    expect(health.ok).toBe(true);\n122\t    if (!health.ok) return;\n123\t    expect(health.value.owners.some((o) => o.counts.ready > 0)).toBe(true);\n124\t    expect(health.value.owners).toContainEqual(\n125\t      expect.objectContaining({\n126\t        owner: \"turns\",\n127\t        kind: \"turn_rendering\",\n128\t        counts: expect.objectContaining({ failed: 1 }),\n129\t      }),\n130\t    );\n131\t    expect(health.value.failures).toContainEqual(\n132\t      expect.objectContaining({\n133\t        owner: \"turns\",\n134\t        form: \"turn_rendering\",\n135\t        reason: expect.stringContaining(\"auth\"),\n136\t      }),\n137\t    );\n138\t\n139\t    const overview = await instance.sdk.inspect.overview(threadRef);\n140\t    expect(overview.ok).toBe(true);\n141\t    if (overview.ok) {\n142\t      expect(overview.value.derivation.ready).toBeGreaterThan(0);\n143\t      expect(overview.value.derivation.failed).toBeGreaterThan(0);\n144\t    }\n145\t  }, 30000);\n146\t\n147\t  it(\"forces a stale background result and preserves the newer edited form\", async () => {\n148\t    const firstStarted = deferred<void>();\n149\t    const releaseFirst = deferred<ModelCallResult>();\n150\t    let smoothedCalls = 0;\n151\t    const modelCall: ModelCall = async (input) => {\n152\t      if (input.model === \"slow-smoothed\") {\n153\t        smoothedCalls += 1;\n154\t        if (smoothedCalls === 1) {\n155\t          firstStarted.resolve();\n156\t          return releaseFirst.promise;\n157\t        }\n158\t        return { ok: true, text: `fresh:${input.messages.map((m) => m.content).join(\"\\n\")}` };\n159\t      }\n160\t      return { ok: true, text: \"ready\" };\n161\t    };\n162\t    const sdkConfig: SdkConfig = {\n163\t      inference: {\n164\t        call: modelCall,\n165\t        assignments: assignments({ smoothed_prompt: { model: \"slow-smoothed\" } }),\n166\t      },\n167\t      mode: \"background\",\n168\t      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n169\t    };\n170\t\n171\t    connector = createConnector({\n172\t      registryPath: store.registryPath,\n173\t      newThreadFilePath: () => store.threadPath(),\n174\t      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n175\t    });\n176\t    await connector.handlers.session_start(ctx, { reason: \"new\" });\n177\t    const instance = connector.getInstance();\n178\t    const state = connector.getState();\n179\t    expect(instance).not.toBeNull();\n180\t    expect(state).not.toBeNull();\n181\t    if (instance === null || state === null) return;\n182\t    threadRef = state.threadRef;\n183\t\n184\t    await connector.handlers.message_end(ctx, {\n185\t      message: makeUserMessage(\"first prompt\"),\n186\t      entryId: \"stale-user\",\n187\t    });\n188\t    await firstStarted.promise;\n189\t    await connector.handlers.message_end(ctx, {\n190\t      message: makeAssistantMessage({ text: \"first response\" }),\n191\t      entryId: \"stale-assistant\",\n192\t    });\n193\t    await connector.handlers.agent_end(ctx, {\n194\t      messages: [makeUserMessage(\"first prompt\"), makeAssistantMessage({ text: \"first response\" })],\n195\t    });\n196\t\n197\t    const beforeEdit = await instance.sdk.messages.listMessages(threadRef);\n198\t    expect(beforeEdit.ok).toBe(true);\n199\t    if (!beforeEdit.ok) return;"}]},"parent_tool_use_id":null,"session_id":"a10094db-b1fb-4175-b007-bb5af83ee62f","uuid":"65572b84-34f0-4ddd-97ed-53c6c963bfea","timestamp":"2026-06-14T13:22:01.962Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts","content":"      mode: \"background\",\n      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n    };\n\n    connector = createConnector({\n      registryPath: store.registryPath,\n      newThreadFilePath: () => store.threadPath(),\n      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n    });\n    await connector.handlers.session_start(ctx, { reason: \"new\" });\n    const instance = connector.getInstance();\n    const state = connector.getState();\n    expect(instance).not.toBeNull();\n    expect(state).not.toBeNull();\n    if (instance === null || state === null) return;\n    threadRef = state.threadRef;\n\n    await captureClosedTurn(connector, ctx, \"please summarize this file\", \"here is the summary\");\n    await instance.sdk.drainSettled(threadRef);\n\n    const health = await instance.sdk.inspect.health(threadRef);\n    expect(health.ok).toBe(true);\n    if (!health.ok) return;\n    expect(health.value.owners.some((o) => o.counts.ready > 0)).toBe(true);\n    expect(health.value.owners).toContainEqual(\n      expect.objectContaining({\n        owner: \"turns\",\n        kind: \"turn_rendering\",\n        counts: expect.objectContaining({ failed: 1 }),\n      }),\n    );\n    expect(health.value.failures).toContainEqual(\n      expect.objectContaining({\n        owner: \"turns\",\n        form: \"turn_rendering\",\n        reason: expect.stringContaining(\"auth\"),\n      }),\n    );\n\n    const overview = await instance.sdk.inspect.overview(threadRef);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) {\n      expect(overview.value.derivation.ready).toBeGreaterThan(0);\n      expect(overview.value.derivation.failed).toBeGreaterThan(0);\n    }\n  }, 30000);\n\n  it(\"forces a stale background result and preserves the newer edited form\", async () => {\n    const firstStarted = deferred<void>();\n    const releaseFirst = deferred<ModelCallResult>();\n    let smoothedCalls = 0;\n    const modelCall: ModelCall = async (input) => {\n      if (input.model === \"slow-smoothed\") {\n        smoothedCalls += 1;\n        if (smoothedCalls === 1) {\n          firstStarted.resolve();\n          return releaseFirst.promise;\n        }\n        return { ok: true, text: `fresh:${input.messages.map((m) => m.content).join(\"\\n\")}` };\n      }\n      return { ok: true, text: \"ready\" };\n    };\n    const sdkConfig: SdkConfig = {\n      inference: {\n        call: modelCall,\n        assignments: assignments({ smoothed_prompt: { model: \"slow-smoothed\" } }),\n      },\n      mode: \"background\",\n      retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 },\n    };\n\n    connector = createConnector({\n      registryPath: store.registryPath,\n      newThreadFilePath: () => store.threadPath(),\n      buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n    });\n    await connector.handlers.session_start(ctx, { reason: \"new\" });\n    const instance = connector.getInstance();\n    const state = connector.getState();\n    expect(instance).not.toBeNull();\n    expect(state).not.toBeNull();\n    if (instance === null || state === null) return;\n    threadRef = state.threadRef;\n\n    await connector.handlers.message_end(ctx, {\n      message: makeUserMessage(\"first prompt\"),\n      entryId: \"stale-user\",\n    });\n    await firstStarted.promise;\n    await connector.handlers.message_end(ctx, {\n      message: makeAssistantMessage({ text: \"first response\" }),\n      entryId: \"stale-assistant\",\n    });\n    await connector.handlers.agent_end(ctx, {\n      messages: [makeUserMessage(\"first prompt\"), makeAssistantMessage({ text: \"first response\" })],\n    });\n\n    const beforeEdit = await instance.sdk.messages.listMessages(threadRef);\n    expect(beforeEdit.ok).toBe(true);\n    if (!beforeEdit.ok) return;","numLines":100,"startLine":100,"totalLines":231}}}

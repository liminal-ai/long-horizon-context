{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/converter.ts | sed -n '1,140p'\"","aggregated_output":"     1\timport type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\n     2\timport type { LhcInstance } from \"../shared/instance.js\";\n     3\timport { fingerprint } from \"./idempotency.js\";\n     4\t\n     5\t// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\n     6\t// isolating capture failure so it never throws back into a PI hook. The two\n     7\t// failure shapes the AC distinguishes key off the SDK's error code:\n     8\t//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\n     9\t//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\n    10\t//     dropped, then surface the original failure so the caller marks the gap.\n    11\t//   - anything else (thread store unavailable): no durable gap is possible —\n    12\t//     surface the failure for the caller to route to an extension health\n    13\t//     signal. Either way the session continues.\n    14\t//\n    15\t// The map → accumulate orchestration runs in the composition root (index.ts),\n    16\t// which routes this function's structured result into SessionState.health;\n    17\t// capture itself stays boundary-pure (lhc + shared only).\n    18\t\n    19\tfunction detail(cause: unknown): string {\n    20\t  return cause instanceof Error ? cause.message : String(cause);\n    21\t}\n    22\t\n    23\t/** messageEvents returns OpResults for operational failures, but a thread file\n    24\t *  in a genuinely broken state could still throw — contain that too, so capture\n    25\t *  is total. */\n    26\tasync function flushIsolated(\n    27\t  instance: LhcInstance,\n    28\t  events: readonly MessageEventInput[],\n    29\t): Promise<OpResult<BatchResult>> {\n    30\t  try {\n    31\t    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\n    32\t  } catch (cause) {\n    33\t    return {\n    34\t      ok: false,\n    35\t      error: {\n    36\t        errorClass: \"system_error\",\n    37\t        code: \"storage_failure\",\n    38\t        reason: `capture flush threw: ${detail(cause)}`,\n    39\t      },\n    40\t    };\n    41\t  }\n    42\t}\n    43\t\n    44\t/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\n    45\t *  rides an existing intake kind (no new kind) and surfaces in the event log.\n    46\t *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\n    47\t *  bad batch dedups the gap rather than piling up duplicates. */\n    48\tfunction gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\n    49\t  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\n    50\t  return {\n    51\t    eventKind: \"runtime_note\",\n    52\t    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\n    53\t    actor: \"system\",\n    54\t    harness: \"pi\",\n    55\t    payload: { text },\n    56\t  };\n    57\t}\n    58\t\n    59\texport async function capture(\n    60\t  events: MessageEventInput[],\n    61\t  instance: LhcInstance,\n    62\t): Promise<OpResult<BatchResult>> {\n    63\t  const primary = await flushIsolated(instance, events);\n    64\t  if (primary.ok) return primary;\n    65\t\n    66\t  if (primary.error.code === \"invalid_event\") {\n    67\t    // Writable thread, malformed event: never drop — record a durable gap.\n    68\t    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\n    69\t    // If the gap write itself fails, the store went unavailable: surface that\n    70\t    // (no durable gap was recorded) so the caller routes it to health.\n    71\t    if (!gap.ok) return gap;\n    72\t    return primary;\n    73\t  }\n    74\t\n    75\t  // Store unavailable / other: no durable gap is possible.\n    76\t  return primary;\n    77\t}\n","exit_code":0,"status":"completed"}}

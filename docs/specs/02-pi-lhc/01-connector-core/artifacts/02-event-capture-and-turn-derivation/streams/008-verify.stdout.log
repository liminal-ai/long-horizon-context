es/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/001-events.jsonl -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/001-events.jsonl\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/001-final-package.json -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/001-final-package.json\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/progress/001-story-lead.progress.jsonl -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/progress/001-story-lead.progress.jsonl\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/progress/001-story-lead.status.json -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/progress/001-story-lead.status.json\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-001.md -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-001.md\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-002.md -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-002.md\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-003.md -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-003.md\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-004.md -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-004.md\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-005.md -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/prompts/001-planner-turn-005.md\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/streams/001-story-lead.stderr.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/streams/001-story-lead.stderr.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/streams/001-story-lead.stdout.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/story-lead/streams/001-story-lead.stdout.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/003-implementor.stderr.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/003-implementor.stderr.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/003-implementor.stdout.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/003-implementor.stdout.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/004-verify.stderr.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/004-verify.stderr.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/004-verify.stdout.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/004-verify.stdout.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/005-continue.stderr.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/005-continue.stderr.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/005-continue.stdout.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/005-continue.stdout.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/006-verify.stderr.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/006-verify.stderr.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/006-verify.stdout.log -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/01-pull-and-status/streams/006-verify.stdout.log\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/001-story-validate.json -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/02-smart-compact/001-story-validate.json\\nR  packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/002-story-orchestrate-run.json -> docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifac.4 | 6 |\\\\n| AC-5.5 | TC-5.5, TC-5.6 | 6 |\\\\n| AC-6.1 | TC-6.1 | 3 |\\\\n| AC-6.2 | TC-6.2 | 3 |\\\\n| AC-6.3 | TC-6.3 | 3 |\\\\n\\\\n**Test Conditions**\\\\n\\\\n- **TC-1.1** — Fresh `session_start` with no thread-selecting launch flag: one LHC instance initialized in background mode, one new registry thread created with cwd/title metadata, and no PI-session-to-thread mapping record created.\\\\n- **TC-1.2** — `session_start` with launch input resolving an existing registry thread: initializes against that same thread and creates no second thread.\\\\n- **TC-1.3** — A session replacement invalidates the prior context object; the extension, holding only plain data, continues capture using the fresh context.\\\\n- **TC-1.4** — `session_shutdown` disposes with flush; reattach finds the thread complete through the last pre-shutdown event.\\\\n- **TC-1.5** — Reload re-initializes the extension; thread reference reconstructed from the resolved thread id; capture continues on the same thread.\\\\n- **TC-1.6** — Launch by mode resolves correctly: no flag creates a new thread; `--session` resolves by full and by partial id; `--continue` resolves the most recent; an ambiguous/unresolvable id fails with an actionable message and creates no thread.\\\\n- **TC-1.7** — `--resume` lists cwd-scoped threads with title and creation time and resolves a selection; an empty cwd lists nothing rather than failing.\\\\n- **TC-2.1** — A user/assistant/toolResult sequence records ordered events; an assistant `[thinking, text, toolCall]` fans out in that order.\\\\n- **TC-2.2** — A one-prompt-two-tools-then-answer corpus (the worked example) yields exactly one LHC turn with one `turn_end` at agent-run completion; PI's per-step `turn_end`s produce none.\\\\n- **TC-2.3** — Session order derives from converter source-event order, not `turnIndex`; two agent runs each starting at `turnIndex 0` order correctly.\\\\n- **TC-2.4** — Parallel tool calls with out-of-order completion correlate each result to its call by `toolCallId`.\\\\n- **TC-2.5** — A tool result with `isError` is captured as a `tool_result` with the error flag and content; nothing dropped.\\\\n- **TC-2.6** — A graceful-interrupt corpus records the partial assistant content with the aborted disposition; the turn closes complete-but-aborted.\\\\n- **TC-2.7** — A re-delivered event (reload/replay) is skipped by idempotency key; a normal resume re-delivers no historical events.\\\\n- **TC-2.8** — A malformed/unmappable event on a writable thread records a durable, queryable gap surfaced in health; an unavailable thread store surfaces an extension diagnostic / health signal with no durable gap. Both continue the session with no exception reaching the hook.\\\\n- **TC-2.9** — A `model_select` and a `thinking_level_select` each record an ordered `runtime_note` event carrying the new and previous values; ordering relative to surrounding messages is preserved.\\\\n- **TC-3.1** — Fork creates a new thread; the source thread receives no writes — its logical read-back (events, messages, turns) is unchanged. Detection resolves the fork point from the `session_before_fork` hook, with PI's session tree as available fallback evidence in Epic 1, not from a fork reason code.\\\\n- **TC-3.2** — Fork replay seeds the new thread; read-back matches the source through the fork point.\\\\n- **TC-3.3** — Fork with safe provenance reuses derived forms; fork with unprovable provenance requeues them; both yield a correct thread.\\\\n- **TC-4.1** — The model-call function resolves a (provider, model) pair through PI's registry and returns completion text for a single-turn message list.\\\\n- **TC-4.2** — Two derivation kinds assigned to different (provider, model) pairs both route correctly in one session.\\\\n- **TC-4.5** — A captured thread with queued derivation work, drained through LHC's scheduler with the injected function wired, persists at least one ready derived form (function returns text) and one classified failure (function returns a failure), both queryable through inspect/health — proving the capture→derivation→recorded-outcome loop, not just the function in isolation.\\\\n- **TC-4.3** — Auth and invalid-request map to terminal; rate-limit, timeout, network map to retryable; a thrown exception maps to `other`.\\\\n- **TC-4.4** — A resolved call with no output is classified `empty_output` by the adapter; the host function returns text-or-transport-failure only.\\\\n- **TC-5.1** — All seven assignments validate against the registry at session start before first use.\\\\n- **TC-5.2** — An unreachable lane reports kind + (provider, model) + fix; the report appears in a headless mode, not only the TUI.\\\\n- **TC-5.3** — A validation failure leaves capture running; the affected lane's derivations fail classified and queryable.\\\\n- **TC-5.4** — Each of the seven kinds loads a (provider, model, prompt) from config with shipped defaults; the prompt resolves to a registered prompt.\\\\n- **TC-5.5** — A user override of a kind's provider/model/prompt takes effect on the next session start with no code change.\\\\n- **TC-5.6** — An incomplete or unknown assignment fails loudly at initialization with an actionable error; no placeholder default masks it.\\\\n- **TC-6.1** — Each corpus (chatty, tool-heavy, parallel-tool, error-result, aborted-turn) replays to a thread whose read-back matches the fixture.\\\\n- **TC-6.2** — The same corpus replayed twice yields identical read-back (IDs and order stable).\\\\n- **TC-6.3** — inspect overview/health report event/message counts, last event position, and any gaps or failed derivations.\\\\n\\\\n---\\\\n\\\\n## Validation Checklist\\\\n\\\\n- [x] User Profile uses the four-field shape (Primary User, Context, Mental Model, Key Constraint)\\\\n- [x] Every flow has numbered ACs and TCs mapping to them\\\\n- [x] Every AC appears in the traceability table with at least one TC and one story\\\\n- [x] Scope states in, out, and where out-of-scope items are handled\\\\n- [x] Migration (POC threads) stated explicitly as out of scope\\\\n- [x] Assumptions carry status and impact-if-wrong, including the M0 dependency\\\\n- [x] Data contracts cover every operation the flows exercise, including the turn-derivation worked example, abort/crash shapes, and error shapes\\\\n- [x] The load-bearing turn-derivation contract (PI turn ≠ LHC turn) is stated with a worked example\\\\n- [x] No implementation detail below the extension/SDK boundary (no storage layout, no module internals, no library names beyond the named boundary contracts)\\\\n- [x] Behavior described as what the system does, not why it matters\\\\n- [x] Story breakdown sequenced with prerequisites, governing ideas, and test estimates\\\\n- [ ] Consumer test: a tech designer can design from this without asking foundational questions — pending review\\\\n\\\",\\\"numLines\\\":580,\\\"startLine\\\":1,\\\"totalLines\\\":580}}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/003-implementor.stdout.log:335:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01FwwJTeDqELgY3ArGv3AJMB\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t// Thread builders for Epic 02 (test plan §Test Substrate). All built through\\\\n2\\\\t// real intake; the multi-state and damaged-source builders then apply the\\\\n3\\\\t// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\\\\n4\\\\t// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\\\\n5\\\\t// builders wrote; Stories 2/4 confirm the states arise for real\\\\n6\\\\t// (coverage.md cross-story debt).\\\\n7\\\\timport { DatabaseSync } from \\\\\\\"node:sqlite\\\\\\\";\\\\n8\\\\timport {\\\\n9\\\\t  intakeStream,\\\\n10\\\\t  threads,\\\\n11\\\\t  type DerivedForm,\\\\n12\\\\t  type DerivedFormState,\\\\n13\\\\t  type DependencyGap,\\\\n14\\\\t  type FormKind,\\\\n15\\\\t  type Lhc,\\\\n16\\\\t  type MessageEventInput,\\\\n17\\\\t  type SubjectKind,\\\\n18\\\\t  type ToolOutcome,\\\\n19\\\\t} from \\\\\\\"../../src/index.js\\\\\\\";\\\\n20\\\\timport { setIntakeClock } from \\\\\\\"./intake-seam.js\\\\\\\";\\\\n21\\\\timport { corruptTwoOpenTurns } from \\\\\\\"./corrupt.js\\\\\\\";\\\\n22\\\\timport type { ProviderDouble } from \\\\\\\"./provider-double.js\\\\\\\";\\\\n23\\\\timport { validEvent, type TempStore } from \\\\\\\"./index.js\\\\\\\";\\\\n24\\\\t\\\\n25\\\\tasync function newThreadFile(store: TempStore): Promise<string> {\\\\n26\\\\t  const filePath = store.threadPath();\\\\n27\\\\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\\\\n28\\\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\\\n29\\\\t  return filePath;\\\\n30\\\\t}\\\\n31\\\\t\\\\n32\\\\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\\\\n33\\\\t  const result = await intakeStream.messageEvents({ filePath }, batch);\\\\n34\\\\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\\\n35\\\\t}\\\\n36\\\\t\\\\n37\\\\t// n closed turns, each prompt + assistant text + explicit end. Turn ids are\\\\n38\\\\t// deterministic (t1..tn) per the turn store's id scheme.\\\\n39\\\\texport async function threadWithClosedTurns(\\\\n40\\\\t  store: TempStore,\\\\n41\\\\t  n: number,\\\\n42\\\\t): Promise<{ filePath: string; turnIds: string[] }> {\\\\n43\\\\t  const filePath = await newThreadFile(store);\\\\n44\\\\t  const turnIds: string[] = [];\\\\n45\\\\t  for (let i = 1; i <= n; i += 1) {\\\\n46\\\\t    await send(filePath, [\\\\n47\\\\t      validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: `prompt for turn ${i}` } }),\\\\n48\\\\t      validEvent(\\\\\\\"assistant_text\\\\\\\", { payload: { text: `answer for turn ${i}` } }),\\\\n49\\\\t      validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n50\\\\t    ]);\\\\n51\\\\t    turnIds.push(`t${i}`);\\\\n52\\\\t  }\\\\n53\\\\t  return { filePath, turnIds };\\\\n54\\\\t}\\\\n55\\\\t\\\\n56\\\\t// One closed turn containing a tool run: call + result pair by default;\\\\n57\\\\t// error and missing-result variants per the epic's outcome vocabulary.\\\\n58\\\\texport async function threadWithToolRun(\\\\n59\\\\t  store: TempStore,\\\\n60\\\\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\\\\n61\\\\t): Promise<{ filePath: string; turnId: string }> {\\\\n62\\\\t  const filePath = await newThreadFile(store);\\\\n63\\\\t  const batch: MessageEventInput[] = [\\\\n64\\\\t    validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"please run the tool\\\\\\\" } }),\\\\n65\\\\t    validEvent(\\\\\\\"tool_call\\\\\\\", {\\\\n66\\\\t      payload: { toolCallId: \\\\\\\"call-fixture-1\\\\\\\", toolName: \\\\\\\"read_file\\\\\\\", arguments: { path: \\\\\\\"notes.txt\\\\\\\" } },\\\\n67\\\\t    }),\\\\n68\\\\t  ];\\\\n69\\\\t  if (opts.missingResult !== true) {\\\\n70\\\\t    batch.push(\\\\n71\\\\t      validEvent(\\\\\\\"tool_result\\\\\\\", {\\\\n72\\\\t        payload: {\\\\n73\\\\t          toolCallId: \\\\\\\"call-fixture-1\\\\\\\",\\\\n74\\\\t          content: opts.resultContent ?? \\\\\\\"contents of notes.txt\\\\\\\",\\\\n75\\\\t          isError: opts.isError ?? false,\\\\n76\\\\t        },\\\\n77\\\\t      }),\\\\n78\\\\t    );\\\\n79\\\\t  }\\\\n80\\\\t  batch.push(validEvent(\\\\\\\"turn_end\\\\\\\"));\\\\n81\\\\t  await send(filePath, batch);\\\\n82\\\\t  return { filePath, turnId: \\\\\\\"t1\\\\\\\" };\\\\n83\\\\t}\\\\n84\\\\t\\\\n85\\\\t// ── chunk read-back (Story 3): raw rows for boundary assertions ──\\\\n86\\\\t\\\\n87\\\\texport interface ChunkSnapshot {\\\\n88\\\\t  chunks: Array<{\\\\n89\\\\t    chunkId: string;\\\\n90\\\\t    chunkOrder: number;\\\\n91\\\\t    status: \\\\\\\"open\\\\\\\" | \\\\\\\"closed\\\\\\\";\\\\n92\\\\t    accumulatedProjectedTokens: number;\\\\n93\\\\t  }>;\\\\n94\\\\t  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\\\\n95\\\\t}\\\\n96\\\\t\\\\n97\\\\texport function readChunks(filePath: string): ChunkSnapshot {\\\\n98\\\\t  const db = new DatabaseSync(filePath);\\\\n99\\\\t  try {\\\\n100\\\\t    const chunks = (\\\\n101\\\\t      db\\\\n102\\\\t        .prepare(\\\\n103\\\\t          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\\\\n104\\\\t           FROM chunk ORDER BY chunk_order`,\\\\n105\\\\t        )\\\\n106\\\\t        .all() as unknown as Array<{\\\\n107\\\\t        chunk_id: string;\\\\n108\\\\t        chunk_order: number | bigint;\\\\n109\\\\t        status: string;\\\\n110\\\\t        accumulated_projected_tokens: number | bigint;\\\\n111\\\\t      }>\\\\n112\\\\t    ).map((row) => ({\\\\n113\\\\t      chunkId: row.chunk_id,\\\\n114\\\\t      chunkOrder: Number(row.chunk_order),\\\\n115\\\\t      status: row.status as \\\\\\\"open\\\\\\\" | \\\\\\\"closed\\\\\\\",\\\\n116\\\\t      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\\\\n117\\\\t    }));\\\\n118\\\\t    const members = (\\\\n119\\\\t      db\\\\n120\\\\t        .prepare(\\\\n121\\\\t          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\\\\n122\\\\t           JOIN chunk c ON c.chunk_id = cm.chunk_id\\\\n123\\\\t           ORDER BY c.chunk_order, cm.member_idx`,\\\\n124\\\\t        )\\\\n125\\\\t        .all() as unknown as Array<{\\\\n126\\\\t        chunk_id: string;\\\\n127\\\\t        turn_id: string;\\\\n128\\\\t        member_idx: number | bigint;\\\\n129\\\\t      }>\\\\n130\\\\t    ).map((row) => ({\\\\n131\\\\t      chunkId: row.chunk_id,\\\\n132\\\\t      turnId: row.turn_id,\\\\n133\\\\t      memberIdx: Number(row.member_idx),\\\\n134\\\\t    }));\\\\n135\\\\t    return { chunks, members };\\\\n136\\\\t  } finally {\\\\n137\\\\t    db.close();\\\\n138\\\\t  }\\\\n139\\\\t}\\\\n140\\\\t\\\\n141\\\\t// ── derived_form read-back and the sanctioned state writer ───────\\\\n142\\\\t\\\\n143\\\\tinterface RawFormRow {\\\\n144\\\\t  subject_kind: string;\\\\n145\\\\t  subject_id: string;\\\\n146\\\\t  form: string;\\\\n147\\\\t  state: string;\\\\n148\\\\t  content: string | null;\\\\n149\\\\t  reason: string | null;\\\\n150\\\\t  metadata: string | null;\\\\n151\\\\t  source_version: number | bigint;\\\\n152\\\\t  gaps: string | null;\\\\n153\\\\t  derived_at: string | null;\\\\n154\\\\t}\\\\n155\\\\t\\\\n156\\\\texport function readDerivedForms(filePath: string): DerivedForm[] {\\\\n157\\\\t  const db = new DatabaseSync(filePath);\\\\n158\\\\t  try {\\\\n159\\\\t    const rows = db\\\\n160\\\\t      .prepare(\\\\n161\\\\t        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\\\\n162\\\\t                source_version, gaps, derived_at\\\\n163\\\\t         FROM derived_form ORDER BY subject_kind, subject_id, form`,\\\\n164\\\\t      )\\\\n165\\\\t      .all() as unknown as RawFormRow[];\\\\n166\\\\t    return rows.map((row) => {\\\\n167\\\\t      const record: DerivedForm = {\\\\n168\\\\t        subjectKind: row.subject_kind as SubjectKind,\\\\n169\\\\t        subjectId: row.subject_id,\\\\n170\\\\t        form: row.form as FormKind,\\\\n171\\\\t        state: row.state as DerivedFormState,\\\\n172\\\\t        sourceVersion: Number(row.source_version),\\\\n173\\\\t      };\\\\n174\\\\t      if (row.content !== null) record.content = row.content;\\\\n175\\\\t      if (row.reason !== null) record.reason = row.reason;\\\\n176\\\\t      if (row.metadata !== null) {\\\\n177\\\\t        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\\\\n178\\\\t      }\\\\n179\\\\t      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\\\n180\\\\t      if (row.derived_at !== null) record.derivedAt = row.derived_at;\\\\n181\\\\t      return record;\\\\n182\\\\t    });\\\\n183\\\\t  } finally {\\\\n184\\\\t    db.close();\\\\n185\\\\t  }\\\\n186\\\\t}\\\\n187\\\\t\\\\n188\\\\t// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\\\\n189\\\\t// are unreachable through the SDK until the drain (Story 1) and handlers\\\\n190\\\\t// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\\\\n191\\\\t// enqueue, mirroring the production completion contract.\\\\n192\\\\texport function setFormState(\\\\n193\\\\t  filePath: string,\\\\n194\\\\t  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\\\\n195\\\\t  update: {\\\\n196\\\\t    state: DerivedFormState;\\\\n197\\\\t    content?: string;\\\\n198\\\\t    reason?: string;\\\\n199\\\\t    metadata?: { outcome?: ToolOutcome };\\\\n200\\\\t    derivedAt?: string;\\\\n201\\\\t  },\\\\n202\\\\t): void {\\\\n203\\\\t  const db = new DatabaseSync(filePath);\\\\n204\\\\t  try {\\\\n205\\\\t    const changed = db\\\\n206\\\\t      .prepare(\\\\n207\\\\t        `UPDATE derived_form\\\\n208\\\\t         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\\\\n209\\\\t         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\\\\n210\\\\t      )\\\\n211\\\\t      .run(\\\\n212\\\\t        update.state,\\\\n213\\\\t        update.content ?? null,\\\\n214\\\\t        update.reason ?? null,\\\\n215\\\\t        update.metadata === undefined ? null : JSON.stringify(update.metadata),\\\\n216\\\\t        update.derivedAt ?? null,\\\\n217\\\\t        target.subjectKind,\\\\n218\\\\t        target.subjectId,\\\\n219\\\\t        target.form,\\\\n220\\\\t      );\\\\n221\\\\t    if (Number(changed.changes) !== 1) {\\\\n222\\\\t      throw new Error(\\\\n223\\\\t        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\\\\n224\\\\t      );\\\\n225\\\\t    }\\\\n226\\\\t  } finally {\\\\n227\\\\t    db.close();\\\\n228\\\\t  }\\\\n229\\\\t}\\\\n230\\\\t\\\\n231\\\\t// ── multi-state thread: every form state in one file ─────────────\\\\n232\\\\t\\\\n233\\\\texport interface MultiStateClaim {\\\\n234\\\\t  subjectKind: SubjectKind;\\\\n235\\\\t  subjectId: string;\\\\n236\\\\t  form: FormKind;\\\\n237\\\\t  state: DerivedFormState;\\\\n238\\\\t}\\\\n239\\\\t\\\\n240\\\\texport async function multiStateThread(\\\\n241\\\\t  store: TempStore,\\\\n242\\\\t): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\\\\n243\\\\t  const filePath = await newThreadFile(store);\\\\n244\\\\t  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\\\\n245\\\\t  // form pending; the writes below move a subset into the other three states.\\\\n246\\\\t  await send(filePath, [\\\\n247\\\\t    validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"first prompt\\\\\\\" } }),\\\\n248\\\\t    validEvent(\\\\\\\"assistant_text\\\\\\\", { payload: { text: \\\\\\\"working on it\\\\\\\" } }),\\\\n249\\\\t    validEvent(\\\\\\\"tool_call\\\\\\\", {\\\\n250\\\\t      payload: { toolCallId: \\\\\\\"call-ms-1\\\\\\\", toolName: \\\\\\\"read_file\\\\\\\", arguments: { path: \\\\\\\"a.txt\\\\\\\" } },\\\\n251\\\\t    }),\\\\n252\\\\t    validEvent(\\\\\\\"tool_result\\\\\\\", {\\\\n253\\\\t      payload: { toolCallId: \\\\\\\"call-ms-1\\\\\\\", content: \\\\\\\"contents of a.txt\\\\\\\", isError: false },\\\\n254\\\\t    }),\\\\n255\\\\t    validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n256\\\\t    validEvent(\\\\\\\"user_prompt\\\\\\\", { payload: { text: \\\\\\\"second prompt\\\\\\\" } }),\\\\n257\\\\t    validEvent(\\\\\\\"turn_end\\\\\\\"),\\\\n258\\\\t  ]);\\\\n259\\\\t  const derivedAt = \\\\\\\"2026-06-10T12:00:00.000Z\\\\\\\";\\\\n260\\\\t  setFormState(\\\\n261\\\\t    filePath,\\\\n262\\\\t    { subjectKind: \\\\\\\"message\\\\\\\", subjectId: \\\\\\\"m1\\\\\\\", form: \\\\\\\"smoothed_prompt\\\\\\\" },\\\\n263\\\\t    { state: \\\\\\\"ready\\\\\\\", content: \\\\\\\"smoothed(fixture:first prompt)\\\\\\\", derivedAt },\\\\n264\\\\t  );\\\\n265\\\\t  // Tool-activity outcome lives in machine-readable metadata, never inside\\\\n266\\\\t  // provider-authored content (FC-0.3).\\\\n267\\\\t  setFormState(\\\\n268\\\\t    filePath,\\\\n269\\\\t    { subjectKind: \\\\\\\"message\\\\\\\", subjectId: \\\\\\\"m4\\\\\\\", form: \\\\\\\"tool_result_summary\\\\\\\" },\\\\n270\\\\t    {\\\\n271\\\\t      state: \\\\\\\"ready\\\\\\\",\\\\n272\\\\t      content: \\\\\\\"toolresult(fixture:contents of a.txt)\\\\\\\",\\\\n273\\\\t      metadata: { outcome: \\\\\\\"succeeded\\\\\\\" },\\\\n274\\\\t      derivedAt,\\\\n275\\\\t    },\\\\n276\\\\t  );\\\\n277\\\\t  setFormState(\\\\n278\\\\t    filePath,\\\\n279\\\\t    { subjectKind: \\\\\\\"turn\\\\\\\", subjectId: \\\\\\\"t1\\\\\\\", form: \\\\\\\"turn_rendering\\\\\\\" },\\\\n280\\\\t    { state: \\\\\\\"failed\\\\\\\", reason: \\\\\\\"provider_failure: scripted exhaustion (fixture)\\\\\\\" },\\\\n281\\\\t  );\\\\n282\\\\t  setFormState(\\\\n283\\\\t    filePath,\\\\n284\\\\t    { subjectKind: \\\\\\\"turn\\\\\\\", subjectId: \\\\\\\"t2\\\\\\\", form: \\\\\\\"turn_rendering\\\\\\\" },\\\\n285\\\\t    { state: \\\\\\\"blocked\\\\\\\", reason: \\\\\\\"source_damaged: manufactured damage (fixture)\\\\\\\" },\\\\n286\\\\t  );\\\\n287\\\\t  return {\\\\n288\\\\t    filePath,\\\\n289\\\\t    expected: [\\\\n290\\\\t      { subjectKind: \\\\\\\"message\\\\\\\", subjectId: \\\\\\\"m1\\\\\\\", form: \\\\\\\"smoothed_prompt\\\\\\\", state: \\\\\\\"ready\\\\\\\" },\\\\n291\\\\t      { subjectKind: \\\\\\\"message\\\\\\\", subjectId: \\\\\\\"m4\\\\\\\", form: \\\\\\\"tool_result_summary\\\\\\\", state: \\\\\\\"ready\\\\\\\" },\\\\n292\\\\t      { subjectKind: \\\\\\\"message\\\\\\\", subjectId: \\\\\\\"m6\\\\\\\", form: \\\\\\\"smoothed_prompt\\\\\\\", state: \\\\\\\"pending\\\\\\\" },\\\\n293\\\\t      { subjectKind: \\\\\\\"turn\\\\\\\", subjectId: \\\\\\\"t1\\\\\\\", form: \\\\\\\"turn_rendering\\\\\\\", state: \\\\\\\"failed\\\\\\\" },\\\\n294\\\\t      { subjectKind: \\\\\\\"turn\\\\\\\", subjectId: \\\\\\\"t1\\\\\\\", form: \\\\\\\"lower_band_projection\\\\\\\", state: \\\\\\\"pending\\\\\\\" },\\\\n295\\\\t      { subjectKind: \\\\\\\"turn\\\\\\\", subjectId: \\\\\\\"t2\\\\\\\", form: \\\\\\\"turn_rendering\\\\\\\", state: \\\\\\\"blocked\\\\\\\" },\\\\n296\\\\t      { subjectKind: \\\\\\\"turn\\\\\\\", subjectId: \\\\\\\"t2\\\\\\\", form: \\\\\\\"lower_band_projection\\\\\\\", state: \\\\\\\"pending\\\\\\\" },\\\\n297\\\\t    ],\\\\n298\\\\t  };\\\\n299\\\\t}\\\\n300\\\\t\\\\n301\\\\t// ── damaged-source thread (Epic 01 corruption definition) ────────\\\\n302\\\\t\\\\n303\\\\t// A closed turn with its turn_derivation work
\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/idempotency.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/support.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/package.json\\\",\\\"manual node reproduction: resume/reload idempotency collision using built packages/pi-lhc/dist/index.js\\\"],\\\"reviewScopeSummary\\\":\\\"Initial verification covered Story 2 AC/TC requirements, Flow 2 tech design, capture/runtime production paths, Story 2 tests, configured gates, and manual existing-thread reattach scenarios.\\\",\\\"priorFindingStatuses\\\":[],\\\"newFindings\\\":[{\\\"id\\\":\\\"SV-001\\\",\\\"severity\\\":\\\"critical\\\",\\\"title\\\":\\\"Existing-thread resume/reload can silently skip new finalized events\\\",\\\"evidence\\\":\\\"AC-2.1 requires every finalized PI message to be recorded exactly once, and AC-2.6/TC-2.7 require duplicate safety without normal-resume historical replay. On every session_start, createConnector resets captureSession.sourceSeq to 0 in packages/pi-lhc/src/index.ts:310-318; nextEntryId then returns s0, s1, ... in packages/pi-lhc/src/index.ts:352-357; message/runtime hooks use that generated entryId in packages/pi-lhc/src/index.ts:362-384. eventKey gives entryId first precedence in packages/pi-lhc/src/capture/idempotency.ts:35-40, so a fresh connector attached to an existing thread reuses prior keys. Manual reproduction against the built production connector: after recording user_prompt 'first', starting a fresh connector with --session for the same thread and recording user_prompt 'second after resume', intakeStream.listEvents returned only the first event with key pi:th_947f6dd71f50d513:entry:s0:0:user_prompt and connector diag was null. The same reload shape returned only the first event with key pi:th_d1fc3d71df1144d3:entry:s0:0:user_prompt. Existing TC-2.7 coverage in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:108-153 only proves identical batch re-delivery skips; it does not prove normal resume/reload continues recording new events.\\\",\\\"affectedFiles\\\":[\\\"packages/pi-lhc/src/index.ts\\\",\\\"packages/pi-lhc/src/capture/idempotency.ts\\\",\\\"packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\",\\\"packages/pi-lhc/test/capture/idempotency.test.ts\\\"],\\\"requirementIds\\\":[\\\"AC-2.1\\\",\\\"AC-2.6\\\",\\\"AC-2.7\\\",\\\"TC-2.7\\\"],\\\"recommendedFixScope\\\":\\\"same-session-implementor\\\",\\\"blocking\\\":true}],\\\"openFindings\\\":[{\\\"id\\\":\\\"SV-001\\\",\\\"severity\\\":\\\"critical\\\",\\\"title\\\":\\\"Existing-thread resume/reload can silently skip new finalized events\\\",\\\"evidence\\\":\\\"AC-2.1 requires every finalized PI message to be recorded exactly once, and AC-2.6/TC-2.7 require duplicate safety without normal-resume historical replay. On every session_start, createConnector resets captureSession.sourceSeq to 0 in packages/pi-lhc/src/index.ts:310-318; nextEntryId then returns s0, s1, ... in packages/pi-lhc/src/index.ts:352-357; message/runtime hooks use that generated entryId in packages/pi-lhc/src/index.ts:362-384. eventKey gives entryId first precedence in packages/pi-lhc/src/capture/idempotency.ts:35-40, so a fresh connector attached to an existing thread reuses prior keys. Manual reproduction against the built production connector: after recording user_prompt 'first', starting a fresh connector with --session for the same thread and recording user_prompt 'second after resume', intakeStream.listEvents returned only the first event with key pi:th_947f6dd71f50d513:entry:s0:0:user_prompt and connector diag was null. The same reload shape returned only the first event with key pi:th_d1fc3d71df1144d3:entry:s0:0:user_prompt. Existing TC-2.7 coverage in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:108-153 only proves identical batch re-delivery skips; it does not prove normal resume/reload continues recording new events.\\\",\\\"affectedFiles\\\":[\\\"packages/pi-lhc/src/index.ts\\\",\\\"packages/pi-lhc/src/capture/idempotency.ts\\\",\\\"packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\",\\\"packages/pi-lhc/test/capture/idempotency.test.ts\\\"],\\\"requirementIds\\\":[\\\"AC-2.1\\\",\\\"AC-2.6\\\",\\\"AC-2.7\\\",\\\"TC-2.7\\\"],\\\"recommendedFixScope\\\":\\\"same-session-implementor\\\",\\\"blocking\\\":true}],\\\"requirementCoverage\\\":{\\\"verified\\\":[\\\"TC-2.1 happy-path ordered user/assistant/toolResult capture and assistant thinking/text/tool_call fan-out\\\",\\\"AC-2.2\\\",\\\"TC-2.2\\\",\\\"TC-2.3\\\",\\\"AC-2.3\\\",\\\"TC-2.4\\\",\\\"AC-2.4\\\",\\\"TC-2.5\\\",\\\"AC-2.5\\\",\\\"TC-2.6\\\",\\\"AC-2.8\\\",\\\"TC-2.9\\\",\\\"TC-2.8 explicit malformed-event/store-unavailable failure isolation\\\",\\\"Idempotency architecture-risk double-replay for identical batches\\\"],\\\"unverified\\\":[\\\"AC-2.1 across existing-thread resume/reload\\\",\\\"AC-2.6 for normal resume/reload continuation after prior captures\\\",\\\"AC-2.7 for false duplicate-skip capture loss\\\",\\\"TC-2.7 normal resume does not replay historical messages while new messages still record\\\"]},\\\"gatesRun\\\":[{\\\"command\\\":\\\"pnpm --filter pi-lhc verify\\\",\\\"result\\\":\\\"pass\\\"},{\\\"command\\\":\\\"pnpm --filter pi-lhc verify-all\\\",\\\"result\\\":\\\"pass\\\"},{\\\"command\\\":\\\"manual node --input-type=module existing-thread resume/reload idempotency reproduction\\\",\\\"result\\\":\\\"fail\\\"}],\\\"productionPathFindings\\\":[\\\"Production capture path uses real LHC intakeStream.messageEvents, but reattach state is not durable: sourceSeq and turn_end closedCount reset for every fresh connector, making new events on existing threads collide with prior idempotency keys.\\\",\\\"No material fake/mock intake path was found in Story 2 capture modules; test fakes are confined to fixtures and explicit test SDK config.\\\"],\\\"recommendedNextStep\\\":\\\"revise\\\",\\\"recommendedFixScope\\\":\\\"same-session-implementor\\\",\\\"openQuestions\\\":[],\\\"additionalObservations\\\":[\\\"Configured gates passed with 54 tests, but the current suite does not cover the existing-thread resume/reload collision path.\\\"]},\\\"errors\\\":[],\\\"warnings\\\":[],\\\"artifacts\\\":[{\\\"kind\\\":\\\"result-envelope\\\",\\\"path\\\":\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/004-verify.json\\\"}],\\\"startedAt\\\":\\\"2026-06-14T07:45:17.544Z\\\",\\\"finishedAt\\\":\\\"2026-06-14T07:49:35.833Z\\\"}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:46:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git diff -- packages/pi-lhc/src/index.ts packages/pi-lhc/src/capture/converter.ts packages/pi-lhc/src/capture/map-message.ts packages/pi-lhc/src/capture/idempotency.ts packages/pi-lhc/src/capture/runtime-changes.ts packages/pi-lhc/src/capture/turn-accumulator.ts packages/pi-lhc/test/capture/converter.test.ts packages/pi-lhc/test/capture/turn-derivation.test.ts packages/pi-lhc/test/capture/parallel-and-errors.test.ts packages/pi-lhc/test/capture/abort.test.ts packages/pi-lhc/test/capture/idempotency.test.ts packages/pi-lhc/test/capture/reattach-idempotency.test.ts packages/pi-lhc/test/capture/support.ts packages/pi-lhc/test/fixtures/corpus.ts packages/pi-lhc/test/red-manifest.json packages/lhc/scripts/check-boundaries.mjs'\",\"aggregated_output\":\"diff --git a/packages/lhc/scripts/check-boundaries.mjs b/packages/lhc/scripts/check-boundaries.mjs\\nindex 1310893..e6a78e1 100644\\n--- a/packages/lhc/scripts/check-boundaries.mjs\\n+++ b/packages/lhc/scripts/check-boundaries.mjs\\n@@ -114,9 +114,12 @@ for (const file of files) {\\n   const source = readFileSync(file, \\\"utf8\\\");\\n   violations.push(...inspectSourceViolations(file, source));\\n   const fileDomain = domainOf(file);\\n+  // Epic 05: inference/ implements the provider seam, owns no thread state,\\n+  // and depends only on shared/ types — it may not import domains/.\\n   const inTechUtilsOrShared =\\n     file.startsWith(path.join(srcRoot, \\\"tech-utils\\\") + path.sep) ||\\n-    file.startsWith(path.join(srcRoot, \\\"shared\\\") + path.sep);\\n+    file.startsWith(path.join(srcRoot, \\\"shared\\\") + path.sep) ||\\n+    file.startsWith(path.join(srcRoot, \\\"inference\\\") + path.sep);\\n \\n   for (const spec of importSpecifiers(source)) {\\n     if (!spec.startsWith(\\\".\\\")) continue; // only relative imports cross our tree\\n@@ -149,7 +152,7 @@ for (const file of files) {\\n     }\\n     if (inTechUtilsOrShared && parts[0] === \\\"domains\\\") {\\n       violations.push(\\n-        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\\n+        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared/inference may not import domains/`,\\n       );\\n     }\\n   }\\ndiff --git a/packages/pi-lhc/src/capture/converter.ts b/packages/pi-lhc/src/capture/converter.ts\\nindex 989ea0c..0480930 100644\\n--- a/packages/pi-lhc/src/capture/converter.ts\\n+++ b/packages/pi-lhc/src/capture/converter.ts\\n@@ -1,16 +1,77 @@\\n import type { BatchResult, MessageEventInput, OpResult } from \\\"lhc\\\";\\n import type { LhcInstance } from \\\"../shared/instance.js\\\";\\n-import { notImplemented } from \\\"../shared/not-implemented.js\\\";\\n+import { fingerprint } from \\\"./idempotency.js\\\";\\n \\n-// AC-2.1, AC-2.7: orchestrate map → accumulate → batch flush through\\n-// `intakeStream.messageEvents`, isolating capture failure so a writable-thread\\n-// failure becomes a recorded gap and a store-unavailable failure becomes an\\n-// extension health signal — never a thrown exception into a PI hook. Story 2.\\n+// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\\n+// isolating capture failure so it never throws back into a PI hook. The two\\n+// failure shapes the AC distinguishes key off the SDK's error code:\\n+//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\\n+//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\\n+//     dropped, then surface the original failure so the caller marks the gap.\\n+//   - anything else (thread store unavailable): no durable gap is possible —\\n+//     surface the failure for the caller to route to an extension health\\n+//     signal. Either way the session continues.\\n+//\\n+// The map → accumulate orchestration runs in the composition root (index.ts),\\n+// which routes this function's structured result into SessionState.health;\\n+// capture itself stays boundary-pure (lhc + shared only).\\n \\n-/** Fail-closed until Story 2. */\\n-export function capture(\\n+function detail(cause: unknown): string {\\n+  return cause instanceof Error ? cause.message : String(cause);\\n+}\\n+\\n+/** messageEvents returns OpResults for operational failures, but a thread file\\n+ *  in a genuinely broken state could still throw — contain that too, so capture\\n+ *  is total. */\\n+async function flushIsolated(\\n+  instance: LhcInstance,\\n+  events: readonly MessageEventInput[],\\n+): Promise<OpResult<BatchResult>> {\\n+  try {\\n+    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\\n+  } catch (cause) {\\n+    return {\\n+      ok: false,\\n+      error: {\\n+        errorClass: \\\"system_error\\\",\\n+        code: \\\"storage_failure\\\",\\n+        reason: `capture flush threw: ${detail(cause)}`,\\n+      },\\n+    };\\n+  }\\n+}\\n+\\n+/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\\n+ *  rides an existing intake kind (no new kind) and surfaces in the event log.\\n+ *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\\n+ *  bad batch dedups the gap rather than piling up duplicates. */\\n+function gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\\n+  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\\n+  return {\\n+    eventKind: \\\"runtime_note\\\",\\n+    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\\n+    actor: \\\"system\\\",\\n+    harness: \\\"pi\\\",\\n+    payload: { text },\\n+  };\\n+}\\n+\\n+export async function capture(\\n   events: MessageEventInput[],\\n   instance: LhcInstance,\\n ): Promise<OpResult<BatchResult>> {\\n-  return Promise.resolve(notImplemented<BatchResult>(\\\"capture.capture\\\"));\\n+  const primary = await flushIsolated(instance, events);\\n+  if (primary.ok) return primary;\\n+\\n+  if (primary.error.code === \\\"invalid_event\\\") {\\n+    // Writable thread, malformed event: never drop — record a durable gap.\\n+    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\\n+    // If the gap write itself fails, the store went unavailable: surface that\\n+    // (no durable gap was recorded) so the caller routes it to health.\\n+    if (!gap.ok) return gap;\\n+    return primary;\\n+  }\\n+\\n+  // Store unavailable / other: no durable gap is possible.\\n+  return primary;\\n }\\ndiff --git a/packages/pi-lhc/src/capture/idempotency.ts b/packages/pi-lhc/src/capture/idempotency.ts\\nindex cee3942..c00ed82 100644\\n--- a/packages/pi-lhc/src/capture/idempotency.ts\\n+++ b/packages/pi-lhc/src/capture/idempotency.ts\\n@@ -1,21 +1,57 @@\\n+import { createHash } from \\\"node:crypto\\\";\\n import type { EventKind } from \\\"lhc\\\";\\n-import { NotImplementedError } from \\\"../shared/not-implemented.js\\\";\\n \\n // AC-2.6: a stable per-event key so re-delivery dedups and crash-replay is\\n // safe. Pure, deterministic — identical across re-delivery of the same logical\\n-// event, distinct across different events. Construction precedence (Story 2):\\n-// PI entry id, else provider responseId / toolCallId, else role:timestamp:hash.\\n+// event, distinct across different events. Construction precedence (from the\\n+// POC mapper, carried forward): PI entry id, else provider responseId /\\n+// toolCallId, else a content fingerprint as last resort. `blockIndex` and\\n+// `kind` ride every tier so one message's fan-out (thinking → text →\\n+// tool_call×N) stays distinct under a single shared id.\\n \\n-export function eventKey(input: {\\n+export interface EventKeyInput {\\n   piSessionId: string;\\n-  entryId?: string;\\n-  responseId?: string;\\n-  toolCallId?: string;\\n+  // Optionals admit explicit `undefined` so a caller can thread a\\n+  // possibly-absent id through directly under exactOptionalPropertyTypes.\\n+  entryId?: string | undefined;\\n+  responseId?: string | undefined;\\n+  toolCallId?: string | undefined;\\n   blockIndex: number;\\n   kind: EventKind;\\n-  role?: string;\\n-  timestamp?: number;\\n-  content?: string;\\n-}): string {\\n-  throw new NotImplementedError(\\\"capture.eventKey\\\");\\n+  role?: string | undefined;\\n+  timestamp?: number | undefined;\\n+  content?: string | undefined;\\n+}\\n+\\n+// Join fingerprint parts with the ASCII unit separator — a delimiter that\\n+// effectively never occurs in PI message text, so two different part lists\\n+// cannot collide into the same joined string.\\n+const SEP = \\\"\\\\u001f\\\";\\n+\\n+/** A short, stable content fingerprint — the last-resort key tier when an\\n+ *  event carries no PI/provider id. sha256 truncated: collision-resistant\\n+ *  enough for dedup, short enough to keep keys readable. */\\n+export function fingerprint(...parts: string[]): string {\\n+  return createHash(\\\"sha256\\\").update(parts.join(SEP)).digest(\\\"hex\\\").slice(0, 24);\\n+}\\n+\\n+export function eventKey(input: EventKeyInput): string {\\n+  const { piSessionId, entryId, responseId, toolCallId, blockIndex, kind } = input;\\n+  // Tier 1 — PI entry id: the most stable identity, present on every real\\n+  // finalized message; disambiguated by block + kind for the fan-out.\\n+  if (entryId !== undefined && entryId !== \\\"\\\") {\\n+    return `pi:${piSessionId}:entry:${entryId}:${blockIndex}:${kind}`;\\n+  }\\n+  // Tier 2 — tool-call id: stable across re-delivery and independent of arrival\\n+  // order; kind separates the call from its result under the same id.\\n+  if (toolCallId !== undefined && toolCallId !== \\\"\\\") {\\n+    return `pi:${piSessionId}:tool:${toolCallId}:${kind}`;\\n+  }\\n+  // Tier 3 — provider response id: stable per assistant response.\\n+  if (responseId !== undefined && responseId !== \\\"\\\") {\\n+    return `pi:${piSessionId}:resp:${responseId}:${blockIndex}:${kind}`;\\n+  }\\n+  // Tier 4 — content fingerprint: last resort for an event with no id at all.\\n+  const fp = fingerprint(input.role ?? \\\"\\\", String(input.timestamp ?? \\\"\\\"), input.content ?? \\\"\\\");\\n+  return `pi:${piSessionId}:fp:${blockIndex}:${kind}:${fp}`;\\n }\\ndiff --git a/packages/pi-lhc/src/capture/map-message.ts b/packages/pi-lhc/src/capture/map-message.ts\\nindex 6409d62..e784742 100644\\n--- a/packages/pi-lhc/src/capture/map-message.ts\\n+++ b/packages/pi-lhc/src/capture/map-message.ts\\n@@ -1,19 +1,209 @@\\n-import type { MessageEventInput } from \\\"lhc\\\";\\n-import type { AgentMessage } from \\\"../pi/types.js\\\";\\n-import { NotImplementedError } from \\\"../shared/not-implemented.js\\\";\\n+import type { EventKind, MessageEventInput } from \\\"lhc\\\";\\n+import type {\\n+  AgentMessage,\\n+  AssistantMessage,\\n+  ContentPart,\\n+  FileRefPart,\\n+  ImagePart,\\n+  ToolResultMessage,\\n+  UserMessage,\\n+} from \\\"../pi/types.js\\\";\\n+import { eventKey } from \\\"./idempotency.js\\\";\\n \\n-// AC-2.1, AC-2.3, AC-2.4, AC-2.5.\\n+// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\\n+// ordered LHC eve
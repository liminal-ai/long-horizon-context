{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/inspect/internal/health.ts | sed -n '1,140p'\"","aggregated_output":"     1\t// Health composition (Flow 4): both owners' report surfaces joined into\n     2\t// state counts, actionable failure detail, a repair preview, and live queue\n     3\t// visibility. Assembled ENTIRELY from FormReportEntry rows — never a\n     4\t// derived_form or work_item read (the must-not-own rule is this domain's\n     5\t// whole contract) — and never executing what it previews (AC-4.3).\n     6\timport type { FormReportEntry } from \"../../../shared/derivation.js\";\n     7\timport type { OpResult } from \"../../../shared/errors.js\";\n     8\timport type { HealthReport } from \"../../../shared/inspect.js\";\n     9\timport * as messages from \"../../messages/index.js\";\n    10\timport * as turns from \"../../turns/index.js\";\n    11\timport type { ThreadRef } from \"../../threads/index.js\";\n    12\t\n    13\ttype Owner = \"messages\" | \"turns\";\n    14\t\n    15\tfunction emptyCounts(): HealthReport[\"owners\"][number][\"counts\"] {\n    16\t  return { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n    17\t}\n    18\t\n    19\t// Failure detail (AC-4.2): attempts and last error read from wherever the\n    20\t// mechanics durably put them — retry exhaustion copies them onto the form's\n    21\t// metadata before the queue row is deleted; a still-live item carries them\n    22\t// on the queue join. Never synthesized.\n    23\tfunction failureOf(\n    24\t  owner: Owner,\n    25\t  entry: FormReportEntry,\n    26\t): HealthReport[\"failures\"][number] {\n    27\t  const failure: HealthReport[\"failures\"][number] = {\n    28\t    owner,\n    29\t    subjectKind: entry.subjectKind,\n    30\t    subjectId: entry.subjectId,\n    31\t    form: entry.form,\n    32\t    reason: entry.reason ?? \"\",\n    33\t    attempts: entry.metadata?.attempts ?? entry.queue?.attempts ?? 0,\n    34\t  };\n    35\t  const lastError = entry.metadata?.lastError ?? entry.queue?.lastError;\n    36\t  if (lastError !== undefined) failure.lastError = lastError;\n    37\t  return failure;\n    38\t}\n    39\t\n    40\texport async function composeHealth(ref: ThreadRef): Promise<OpResult<HealthReport>> {\n    41\t  const messageReport = await messages.report(ref);\n    42\t  if (!messageReport.ok) return messageReport;\n    43\t  const turnReport = await turns.report(ref);\n    44\t  if (!turnReport.ok) return turnReport;\n    45\t\n    46\t  const sources: ReadonlyArray<readonly [Owner, readonly FormReportEntry[]]> = [\n    47\t    [\"messages\", messageReport.value],\n    48\t    [\"turns\", turnReport.value],\n    49\t  ];\n    50\t\n    51\t  const countsByOwnerKind = new Map<string, HealthReport[\"owners\"][number]>();\n    52\t  const failures: HealthReport[\"failures\"] = [];\n    53\t  const repairPreview: HealthReport[\"repairPreview\"] = [];\n    54\t  const queue = { queued: 0, claimed: 0 };\n    55\t\n    56\t  for (const [owner, entries] of sources) {\n    57\t    for (const entry of entries) {\n    58\t      const key = `${owner}:${entry.form}`;\n    59\t      let row = countsByOwnerKind.get(key);\n    60\t      if (row === undefined) {\n    61\t        row = { owner, kind: entry.form, counts: emptyCounts() };\n    62\t        countsByOwnerKind.set(key, row);\n    63\t      }\n    64\t      switch (entry.state) {\n    65\t        case \"ready\":\n    66\t          row.counts.ready += 1;\n    67\t          break;\n    68\t        case \"pending\":\n    69\t          if ((entry.queue?.attempts ?? 0) > 0) row.counts.retrying += 1;\n    70\t          else row.counts.pending += 1;\n    71\t          break;\n    72\t        case \"failed\":\n    73\t          row.counts.failed += 1;\n    74\t          failures.push(failureOf(owner, entry));\n    75\t          // The preview is exactly the failed-and-not-blocked set: blocked is\n    76\t          // a distinct state, so failed entries ARE the requeue targets.\n    77\t          repairPreview.push({\n    78\t            owner,\n    79\t            subjectKind: entry.subjectKind,\n    80\t            subjectId: entry.subjectId,\n    81\t            form: entry.form,\n    82\t          });\n    83\t          break;\n    84\t        case \"blocked\":\n    85\t          row.counts.blocked += 1;\n    86\t          failures.push(failureOf(owner, entry));\n    87\t          break;\n    88\t      }\n    89\t      // Live queue visibility (AC-4.5), per report entry: every pending or\n    90\t      // retrying entry rides a live item, so queued + claimed here equals\n    91\t      // pending + retrying above by construction. Counts are per form-report\n    92\t      // entry by ratified contract (Epic 04 fix-batch-001): one work item\n    93\t      // (e.g. a turn_derivation) may back multiple form entries, so a raw\n    94\t      // listQueuedWork work-item count would break that identity.\n    95\t      if (entry.queue !== undefined) {\n    96\t        if (entry.queue.status === \"queued\") queue.queued += 1;\n    97\t        else queue.claimed += 1;\n    98\t      }\n    99\t    }\n   100\t  }\n   101\t\n   102\t  // Deterministic order: messages before turns, kinds alphabetical within\n   103\t  // an owner — repeated reads with no writes between are deep-equal.\n   104\t  const owners = [...countsByOwnerKind.values()].sort((a, b) =>\n   105\t    a.owner === b.owner ? a.kind.localeCompare(b.kind) : a.owner.localeCompare(b.owner),\n   106\t  );\n   107\t\n   108\t  return { ok: true, value: { owners, failures, repairPreview, queue } };\n   109\t}\n","exit_code":0,"status":"completed"}}

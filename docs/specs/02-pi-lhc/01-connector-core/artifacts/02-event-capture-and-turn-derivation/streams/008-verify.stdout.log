\",\"packages/pi-lhc/src/capture/idempotency.ts\",\"packages/pi-lhc/test/capture/parallel-and-errors.test.ts\",\"packages/pi-lhc/test/capture/idempotency.test.ts\"],\"requirementIds\":[\"AC-2.1\",\"AC-2.6\",\"AC-2.7\",\"TC-2.7\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"TC-2.1 happy-path ordered user/assistant/toolResult capture and assistant thinking/text/tool_call fan-out\",\"AC-2.2\",\"TC-2.2\",\"TC-2.3\",\"AC-2.3\",\"TC-2.4\",\"AC-2.4\",\"TC-2.5\",\"AC-2.5\",\"TC-2.6\",\"AC-2.8\",\"TC-2.9\",\"TC-2.8 explicit malformed-event/store-unavailable failure isolation\",\"Idempotency architecture-risk double-replay for identical batches\"],\"unverified\":[\"AC-2.1 across existing-thread resume/reload\",\"AC-2.6 for normal resume/reload continuation after prior captures\",\"AC-2.7 for false duplicate-skip capture loss\",\"TC-2.7 normal resume does not replay historical messages while new messages still record\"]},\"gatesRun\":[{\"command\":\"pnpm --filter pi-lhc verify\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify-all\",\"result\":\"pass\"},{\"command\":\"manual node --input-type=module existing-thread resume/reload idempotency reproduction\",\"result\":\"fail\"}],\"productionPathFindings\":[\"Production capture path uses real LHC intakeStream.messageEvents, but reattach state is not durable: sourceSeq and turn_end closedCount reset for every fresh connector, making new events on existing threads collide with prior idempotency keys.\",\"No material fake/mock intake path was found in Story 2 capture modules; test fakes are confined to fixtures and explicit test SDK config.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"same-session-implementor\",\"openQuestions\":[],\"additionalObservations\":[\"Configured gates passed with 54 tests, but the current suite does not cover the existing-thread resume/reload collision path.\"]},\"errors\":[],\"warnings\":[],\"artifacts\
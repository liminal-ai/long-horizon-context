{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/map-message.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport type { EventKind, MessageEventInput } from \"lhc\";\n     2\timport type {\n     3\t  AgentMessage,\n     4\t  AssistantMessage,\n     5\t  ContentPart,\n     6\t  FileRefPart,\n     7\t  ImagePart,\n     8\t  ToolResultMessage,\n     9\t  UserMessage,\n    10\t} from \"../pi/types.js\";\n    11\timport { eventKey } from \"./idempotency.js\";\n    12\t\n    13\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n    14\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n    15\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n    16\t// present) → one `tool_call` per call, in that order; a tool result → one\n    17\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n    18\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n    19\t// drop, tech design I-6). A graceful interrupt carries its disposition through\n    20\t// on a trailing `runtime_note` (research §5b).\n    21\t\n    22\texport interface MapCtx {\n    23\t  piSessionId: string;\n    24\t  entryId?: string;\n    25\t}\n    26\t\n    27\tconst HARNESS = \"pi\";\n    28\t\n    29\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n    30\t *  field to hold its disposition, so the mapper carries `stopReason` through on\n    31\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n    32\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\n    33\texport const ABORTED_DISPOSITION_TEXT =\n    34\t  \"turn aborted (stopReason: aborted) — partial content preserved\";\n    35\t\n    36\tconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n    37\t\n    38\tfunction textOf(parts: ContentPart[]): string {\n    39\t  return parts\n    40\t    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n    41\t    .map((p) => p.text)\n    42\t    .join(\"\");\n    43\t}\n    44\t\n    45\tfunction thinkingOf(parts: ContentPart[]): string {\n    46\t  return parts\n    47\t    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n    48\t    .map((p) => p.thinking)\n    49\t    .join(\"\");\n    50\t}\n    51\t\n    52\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n    53\t  return parts.filter(\n    54\t    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n    55\t  );\n    56\t}\n    57\t\n    58\tfunction omissionText(part: ImagePart | FileRefPart): string {\n    59\t  return part.type === \"image\"\n    60\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n    61\t    : `unsupported content omitted: file reference (${part.path})`;\n    62\t}\n    63\t\n    64\tfunction buildKey(\n    65\t  ctx: MapCtx,\n    66\t  role: string,\n    67\t  kind: EventKind,\n    68\t  blockIndex: number,\n    69\t  opts: { toolCallId?: string; content?: string } = {},\n    70\t): string {\n    71\t  return eventKey({\n    72\t    piSessionId: ctx.piSessionId,\n    73\t    entryId: ctx.entryId,\n    74\t    blockIndex,\n    75\t    kind,\n    76\t    role,\n    77\t    toolCallId: opts.toolCallId,\n    78\t    content: opts.content,\n    79\t  });\n    80\t}\n    81\t\n    82\t// Per-kind builders — explicit eventKind literals so the discriminated union\n    83\t// narrows without a cast.\n    84\tfunction textEvent(\n    85\t  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n    86\t  text: string,\n    87\t  actor: string,\n    88\t  key: string,\n    89\t): MessageEventInput {\n    90\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n    91\t}\n    92\t\n    93\tfunction toolCallEvent(\n    94\t  toolCallId: string,\n    95\t  toolName: string,\n    96\t  args: Record<string, unknown>,\n    97\t  key: string,\n    98\t): MessageEventInput {\n    99\t  return {\n   100\t    eventKind: \"tool_call\",\n   101\t    idempotencyKey: key,\n   102\t    actor: \"assistant\",\n   103\t    harness: HARNESS,\n   104\t    payload: { toolCallId, toolName, arguments: args },\n   105\t  };\n   106\t}\n   107\t\n   108\tfunction toolResultEvent(\n   109\t  toolCallId: string,\n   110\t  content: string,\n   111\t  isError: boolean,\n   112\t  key: string,\n   113\t): MessageEventInput {\n   114\t  return {\n   115\t    eventKind: \"tool_result\",\n   116\t    idempotencyKey: key,\n   117\t    actor: \"tool\",\n   118\t    harness: HARNESS,\n   119\t    payload: { toolCallId, content, isError },\n   120\t  };\n   121\t}\n   122\t\n   123\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n   124\t  const events: MessageEventInput[] = [];\n   125\t  let block = 0;\n   126\t  if (msg.content.some((p) => p.type === \"text\")) {\n   127\t    const text = textOf(msg.content);\n   128\t    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { content: text })));\n   129\t    block += 1;\n   130\t  }\n   131\t  for (const part of unsupportedOf(msg.content)) {\n   132\t    const text = omissionText(part);\n   133\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: text })));\n   134\t    block += 1;\n   135\t  }\n   136\t  if (events.length === 0) {\n   137\t    events.push(\n   138\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: \"empty:user\" })),\n   139\t    );\n   140\t  }\n   141\t  return events;\n   142\t}\n   143\t\n   144\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n   145\t  const events: MessageEventInput[] = [];\n   146\t  let block = 0;\n   147\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n   148\t  if (msg.content.some((p) => p.type === \"thinking\")) {\n   149\t    const text = thinkingOf(msg.content);\n   150\t    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { content: text })));\n   151\t    block += 1;\n   152\t  }\n   153\t  if (msg.content.some((p) => p.type === \"text\")) {\n   154\t    const text = textOf(msg.content);\n   155\t    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { content: text })));\n   156\t    block += 1;\n   157\t  }\n   158\t  for (const part of msg.content) {\n   159\t    if (part.type !== \"toolCall\") continue;\n   160\t    events.push(\n   161\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { toolCallId: part.id, content: part.name })),\n   162\t    );\n   163\t    block += 1;\n   164\t  }\n   165\t  for (const part of unsupportedOf(msg.content)) {\n   166\t    const text = omissionText(part);\n   167\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: text })));\n   168\t    block += 1;\n   169\t  }\n   170\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\n   171\t  if (msg.stopReason === \"aborted\") {\n   172\t    events.push(\n   173\t      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: ABORTED_DISPOSITION_TEXT })),\n   174\t    );\n   175\t    block += 1;\n   176\t  }\n   177\t  if (events.length === 0) {\n   178\t    events.push(\n   179\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: \"empty:assistant\" })),\n   180\t    );\n   181\t  }\n   182\t  return events;\n   183\t}\n   184\t\n   185\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n   186\t  const content = textOf(msg.content);\n   187\t  const isError = msg.isError === true;\n   188\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n   189\t  // and content are always captured, even on failure (AC-2.4).\n   190\t  return [\n   191\t    toolResultEvent(\n   192\t      msg.toolCallId,\n   193\t      content,\n   194\t      isError,\n   195\t      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { toolCallId: msg.toolCallId, content }),\n   196\t    ),\n   197\t  ];\n   198\t}\n   199\t\n   200\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n   201\t  switch (msg.role) {\n   202\t    case \"user\":\n   203\t      return mapUser(msg, ctx);\n   204\t    case \"assistant\":\n   205\t      return mapAssistant(msg, ctx);\n   206\t    case \"toolResult\":\n   207\t      return mapToolResult(msg, ctx);\n   208\t  }\n   209\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '1,520p'\"","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type {\n    11\t  BatchResult,\n    12\t  DerivationProvider,\n    13\t  MessageEventInput,\n    14\t  OpResult,\n    15\t  ProviderResult,\n    16\t  SdkConfig,\n    17\t  ThreadRef,\n    18\t} from \"lhc\";\n    19\timport type {\n    20\t  ExtensionAPI,\n    21\t  ExtensionContext,\n    22\t  PiHookHandler,\n    23\t  PiHookName,\n    24\t} from \"./pi/types.js\";\n    25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    26\timport { createSessionState } from \"./lifecycle/state.js\";\n    27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    28\timport {\n    29\t  parseLaunchFlags,\n    30\t  resolveReloadThread,\n    31\t  resolveThread,\n    32\t  type LaunchFlags,\n    33\t  type ResolveDeps,\n    34\t} from \"./lifecycle/thread-resolution.js\";\n    35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    36\timport { capture } from \"./capture/converter.js\";\n    37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n    38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n    39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n    40\timport type { LhcInstance } from \"./shared/instance.js\";\n    41\t\n    42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    43\texport type { LhcInstance } from \"./shared/instance.js\";\n    44\t\n    45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    47\t *  registers no handler for it (story Scope Out). */\n    48\texport const EPIC_1_HOOKS = [\n    49\t  \"session_start\",\n    50\t  \"message_end\",\n    51\t  \"turn_end\",\n    52\t  \"agent_end\",\n    53\t  \"model_select\",\n    54\t  \"thinking_level_select\",\n    55\t  \"session_before_fork\",\n    56\t  \"session_before_switch\",\n    57\t  \"session_shutdown\",\n    58\t] as const satisfies readonly PiHookName[];\n    59\t\n    60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    61\t\n    62\t/** What the connector needs from the host to run a session. Every dependency\n    63\t *  has a working production default; the overrides exist for test isolation\n    64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n    65\t *  in the PI-auth-backed inference config.\n    66\t *\n    67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n    68\t *  default is the observe-only config below (a real, construction-valid SDK);\n    69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n    70\texport interface ConnectorDeps {\n    71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    72\t  registryPath?: string;\n    73\t  newThreadFilePath?: () => string;\n    74\t  parseLaunch?: () => LaunchFlags;\n    75\t  selectThread?: (\n    76\t    choices: readonly ThreadChoice[],\n    77\t    ctx: ExtensionContext,\n    78\t  ) => Promise<string | null>;\n    79\t}\n    80\t\n    81\t/** Everything the connector retains across hooks as PLAIN data — by\n    82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    84\t *  deliberately not part of the snapshot. */\n    85\texport interface ConnectorSnapshot {\n    86\t  state: SessionState | null;\n    87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    88\t}\n    89\t\n    90\texport interface Connector {\n    91\t  /** Register the observe-only hook rail on the PI extension API. */\n    92\t  register(pi: ExtensionAPI): void;\n    93\t  /** The plain-data state retained across hooks. `null` until a session\n    94\t   *  resolves a thread; never holds a PI ctx. */\n    95\t  getState(): SessionState | null;\n    96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n    97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n    98\t  getInstance(): LhcInstance | null;\n    99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n   100\t  snapshot(): ConnectorSnapshot;\n   101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   102\t   *  synthetic ctx/events without a live PI. */\n   103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n   104\t}\n   105\t\n   106\t/** The connector's live capture state for one session: the open-turn\n   107\t *  accumulator and a monotonic source-event counter (the entry index woven into\n   108\t *  every event's idempotency key). The counter is SEEDED from the thread's\n   109\t *  durable committed-event count at attach, so a resume/reload continues past\n   110\t *  the prior session's keys rather than restarting at 0 and colliding (SV-001).\n   111\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n   112\t *  per session, never part of the plain-data snapshot and never a PI object. */\n   113\tinterface CaptureSession {\n   114\t  piSessionId: string;\n   115\t  accumulator: TurnAccumulator;\n   116\t  sourceSeq: number;\n   117\t}\n   118\t\n   119\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n   120\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   121\t *  same id). */\n   122\tfunction sessionIdOf(ref: ThreadRef): string {\n   123\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   124\t}\n   125\t\n   126\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   127\t\n   128\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n   129\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n   130\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n   131\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n   132\t *  derivation work is ever queued and this provider is never invoked — it exists\n   133\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n   134\t *\n   135\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n   136\t *  documents as \"selectable only by explicit name — never a production default\"\n   137\t *  (it would mark fake derived text into the thread). Failing closed preserves\n   138\t *  the observe-only guarantee even if a future change queued work before Stories\n   139\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n   140\t *  assignments), which is what a real *completing* inference requires (the\n   141\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n   142\tfunction observeOnlyProvider(): DerivationProvider {\n   143\t  const notConfigured = (): Promise<ProviderResult> =>\n   144\t    Promise.resolve({\n   145\t      ok: false,\n   146\t      retryable: false,\n   147\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n   148\t    });\n   149\t  return {\n   150\t    smoothPrompt: notConfigured,\n   151\t    summarizeToolCall: notConfigured,\n   152\t    summarizeToolResult: notConfigured,\n   153\t    composeTurnRendering: notConfigured,\n   154\t    projectLowerBand: notConfigured,\n   155\t    summarizeChunkDetailed: notConfigured,\n   156\t    summarizeChunkBrief: notConfigured,\n   157\t  };\n   158\t}\n   159\t\n   160\t/** The production observe-only SDK config: a real, construction-valid instance\n   161\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n   162\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n   163\t *  config. */\n   164\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n   165\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n   166\t}\n   167\t\n   168\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   169\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   170\t *  show. */\n   171\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   172\t  const lines = choices.map((choice, i) => {\n   173\t    const title = choice.title ?? \"(untitled)\";\n   174\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   175\t  });\n   176\t  return [\n   177\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n   178\t    ...lines,\n   179\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n   180\t  ].join(\"\\n\");\n   181\t}\n   182\t\n   183\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n   184\t *  interactive input/selection surface (wiring research), so the production\n   185\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n   186\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n   187\t *  most recently created thread as the best available explicit default. The\n   188\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n   189\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n   190\t *  A true interactive picker awaits a PI input surface; until then resuming a\n   191\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n   192\t *  precise spec deviation. */\n   193\tfunction defaultSelectThread(\n   194\t  choices: readonly ThreadChoice[],\n   195\t  ctx: ExtensionContext,\n   196\t): Promise<string | null> {\n   197\t  const mostRecent = choices.at(-1);\n   198\t  if (mostRecent === undefined) return Promise.resolve(null);\n   199\t  if (ctx.hasUI) {\n   200\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   201\t  }\n   202\t  return Promise.resolve(mostRecent.threadId);\n   203\t}\n   204\t\n   205\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   206\t *  generated by the registry at creation, so the file name is just a unique\n   207\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   208\t *  parents). */\n   209\tfunction defaultNewThreadFilePath(): string {\n   210\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   211\t  mkdirSync(dir, { recursive: true });\n   212\t  return join(dir, `${randomUUID()}.sqlite`);\n   213\t}\n   214\t\n   215\t/** Build a connector instance. Its mutable state lives in this closure; the\n   216\t *  registered handlers capture it, so the instance stays live for the session\n   217\t *  even when `activate` discards the returned object. The connector holds NO\n   218\t *  module-level or durable state of its own — reload reconstructs the thread from\n   219\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n   220\t *  closure reattaches correctly (AC-1.5). */\n   221\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   222\t  // The connector's retained state. `state` is plain data (the durable thread\n   223\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   224\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n   225\t  // none survives the connector — reload re-resolves from the registry.\n   226\t  let state: SessionState | null = null;\n   227\t  let instance: LhcInstance | null = null;\n   228\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   229\t  let captureSession: CaptureSession | null = null;\n   230\t\n   231\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n   232\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   233\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   234\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n   235\t\n   236\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   237\t    return { code, message, recordedGap: false };\n   238\t  }\n   239\t\n   240\t  // The registry/file deps every resolver path shares. `registryPath` is set\n   241\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n   242\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n   243\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n   244\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n   245\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   246\t    return resolveDeps;\n   247\t  }\n   248\t\n   249\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n   250\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n   251\t  // no-flag creates).\n   252\t  async function resolveForLaunch(\n   253\t    launch: LaunchFlags,\n   254\t    ctx: ExtensionContext,\n   255\t  ): Promise<OpResult<ThreadRef | null>> {\n   256\t    if (launch.resume === true) {\n   257\t      const pickerDeps: {\n   258\t        registryPath?: string;\n   259\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n   260\t      } = { select: (choices) => selectThread(choices, ctx) };\n   261\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n   262\t      return pickThread(ctx.cwd, pickerDeps);\n   263\t    }\n   264\t    return resolveThread(launch, buildResolveDeps(ctx));\n   265\t  }\n   266\t\n   267\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n   268\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n   269\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n   270\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n   271\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n   272\t  async function resolveReloadFor(\n   273\t    launch: LaunchFlags,\n   274\t    ctx: ExtensionContext,\n   275\t  ): Promise<OpResult<ThreadRef | null>> {\n   276\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n   277\t  }\n   278\t\n   279\t  // session_start: resolve the recording thread and construct one background\n   280\t  // instance against it. Config is gated first so a session with no usable\n   281\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n   282\t  // thread is re-resolved from the durable registry (reattach, never create);\n   283\t  // every other reason runs the normal launch resolution.\n   284\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   285\t    const config = buildSdkConfig(ctx);\n   286\t    if (!config.ok) {\n   287\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   288\t      return;\n   289\t    }\n   290\t    const launch = parseLaunch();\n   291\t    const isReload = event.reason === \"reload\";\n   292\t    const resolved = isReload\n   293\t      ? await resolveReloadFor(launch, ctx)\n   294\t      : await resolveForLaunch(launch, ctx);\n   295\t    if (!resolved.ok) {\n   296\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   297\t      return;\n   298\t    }\n   299\t    if (resolved.value === null) {\n   300\t      lastDiagnostic = isReload\n   301\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n   302\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   303\t      return;\n   304\t    }\n   305\t    const built = await initInstance(resolved.value, config.value);\n   306\t    if (!built.ok) {\n   307\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   308\t      return;\n   309\t    }\n   310\t    instance = built.value;\n   311\t    state = createSessionState(resolved.value);\n   312\t    // Seed the capture counters from the thread's DURABLE committed state, so a\n   313\t    // resume/reload onto an EXISTING thread continues past the prior session's\n   314\t    // idempotency keys instead of restarting at 0 and silently skipping new\n   315\t    // finalized events as false duplicates (SV-001). A new thread reads back\n   316\t    // zero, so a fresh session is unchanged; the read is touch-suppressed and\n   317\t    // happens once per session_start, never per event.\n   318\t    const piSessionId = sessionIdOf(resolved.value);\n   319\t    const seed = await built.value.sdk.inspect.overview(resolved.value);\n   320\t    const sourceSeq = seed.ok ? seed.value.events.count : 0;\n   321\t    const startTurnSeq = seed.ok ? seed.value.turns.closed : 0;\n   322\t    captureSession = {\n   323\t      piSessionId,\n   324\t      accumulator: new TurnAccumulator({ piSessionId, startTurnSeq }),\n   325\t      sourceSeq,\n   326\t    };\n   327\t  };\n   328\t\n   329\t  // Dispose with flush before any session swap (session_before_switch fires\n   330\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   331\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n   332\t  // re-resolves its thread from the durable registry on the next session_start.\n   333\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   334\t    const result = await disposeInstance(instance);\n   335\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   336\t    instance = null;\n   337\t    captureSession = null;\n   338\t  };\n   339\t\n   340\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n   341\t  // converter already recorded a durable gap for a writable-thread malformed\n   342\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n   343\t  // surfaces as an extension health signal with no gap. Neither path throws.\n   344\t  function recordCaptureOutcome(\n   345\t    result: OpResult<BatchResult>,\n   346\t    events: readonly MessageEventInput[],\n   347\t  ): void {\n   348\t    if (result.ok) return;\n   349\t    const recordedGap = result.error.code === \"invalid_event\";\n   350\t    const failure: CaptureFailureDiagnostic = {\n   351\t      code: result.error.code,\n   352\t      message: result.error.reason,\n   353\t      recordedGap,\n   354\t    };\n   355\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n   356\t    lastDiagnostic = failure;\n   357\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   358\t  }\n   359\t\n   360\t  // The next monotonic source-event index, used as the event's entry id. The\n   361\t  // counter is seeded from durable thread state at attach, so within a session\n   362\t  // it numbers new finalized events past every prior key (no resume collision),\n   363\t  // and a brand-new thread numbers from 0.\n   364\t  function nextEntryId(session: CaptureSession): string {\n   365\t    const id = `s${session.sourceSeq}`;\n   366\t    session.sourceSeq += 1;\n   367\t    return id;\n   368\t  }\n   369\t\n   370\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   371\t  // open turn, and flush through the converter (AC-2.1).\n   372\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   373\t    if (instance === null || captureSession === null) return;\n   374\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n   375\t    const events = mapMessage(event.message, mapCtx);\n   376\t    captureSession.accumulator.onMessage(events);\n   377\t    if (events.length === 0) return;\n   378\t    recordCaptureOutcome(await capture(events, instance), events);\n   379\t  };\n   380\t\n   381\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   382\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   383\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   384\t    if (instance === null || captureSession === null) return;\n   385\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n   386\t    const note = mapModelSelect(event, mapCtx);\n   387\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   388\t  };\n   389\t\n   390\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   391\t    if (instance === null || captureSession === null) return;\n   392\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n   393\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   394\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   395\t  };\n   396\t\n   397\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   398\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   399\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   400\t    if (instance === null || captureSession === null) return;\n   401\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   402\t    if (turnEnd.length === 0) return;\n   403\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   404\t  };\n   405\t\n   406\t  // Contain every handler: an observe-only hook must never throw back into PI\n   407\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   408\t  // plain-data diagnostic; it is never rethrown.\n   409\t  const guard = (\n   410\t    name: Epic1Hook,\n   411\t    body: PiHookHandler<Epic1Hook>,\n   412\t  ): PiHookHandler<Epic1Hook> => {\n   413\t    return async (ctx, event): Promise<void> => {\n   414\t      try {\n   415\t        await body(ctx, event);\n   416\t      } catch (err) {\n   417\t        lastDiagnostic = {\n   418\t          code: \"hook_handler_error\",\n   419\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   420\t          recordedGap: false,\n   421\t        };\n   422\t      }\n   423\t    };\n   424\t  };\n   425\t\n   426\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   427\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n   428\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n   429\t  // FRESH ctx and retains none of it.\n   430\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   431\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n   432\t  };\n   433\t\n   434\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   435\t  // are live; PI per-step turn_end and fork remain no-ops.\n   436\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   437\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   438\t    session_before_switch: onDispose,\n   439\t    session_shutdown: onDispose,\n   440\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   441\t    turn_end: noop,\n   442\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   443\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   444\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   445\t    session_before_fork: noop,\n   446\t  };\n   447\t\n   448\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   449\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   450\t\n   451\t  return {\n   452\t    handlers,\n   453\t    register(pi: ExtensionAPI): void {\n   454\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   455\t    },\n   456\t    getState(): SessionState | null {\n   457\t      return state;\n   458\t    },\n   459\t    getInstance(): LhcInstance | null {\n   460\t      return instance;\n   461\t    },\n   462\t    snapshot(): ConnectorSnapshot {\n   463\t      return { state, lastDiagnostic };\n   464\t    },\n   465\t  };\n   466\t}\n   467\t\n   468\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   469\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n   470\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n   471\t *  observe-only SDK config, and the `--resume` selector that presents the\n   472\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n   473\t *  resolves/creates and initializes for real. On `/reload` the connector\n   474\t *  re-resolves the same thread from the durable registry (it keeps no\n   475\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n   476\t *  config. */\n   477\texport function activate(pi: ExtensionAPI): void {\n   478\t  createConnector().register(pi);\n   479\t}\n   480\t\n   481\texport default activate;\n","exit_code":0,"status":"completed"}}

capture/converter.js\\\";\\n+import { mapMessage, type MapCtx } from \\\"./capture/map-message.js\\\";\\n+import { mapModelSelect, mapThinkingLevelSelect } from \\\"./capture/runtime-changes.js\\\";\\n+import { TurnAccumulator } from \\\"./capture/turn-accumulator.js\\\";\\n import type { LhcInstance } from \\\"./shared/instance.js\\\";\\n \\n export { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\n@@ -97,6 +103,26 @@ export interface Connector {\\n   readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n }\\n \\n+/** The connector's live capture state for one session: the open-turn\\n+ *  accumulator and a monotonic source-event counter (the entry index woven into\\n+ *  every event's idempotency key). The counter is SEEDED from the thread's\\n+ *  durable committed-event count at attach, so a resume/reload continues past\\n+ *  the prior session's keys rather than restarting at 0 and colliding (SV-001).\\n+ *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\\n+ *  per session, never part of the plain-data snapshot and never a PI object. */\\n+interface CaptureSession {\\n+  piSessionId: string;\\n+  accumulator: TurnAccumulator;\\n+  sourceSeq: number;\\n+}\\n+\\n+/** A stable per-session id for idempotency-key scoping — the resolved thread's\\n+ *  identity, which survives reload/replay (the same thread re-resolves to the\\n+ *  same id). */\\n+function sessionIdOf(ref: ThreadRef): string {\\n+  return \\\"threadId\\\" in ref ? ref.threadId : ref.filePath;\\n+}\\n+\\n const DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n \\n /** The Story-1 production inference placeholder: a real `DerivationProvider`\\n@@ -200,6 +226,7 @@ export function createConnector(deps: ConnectorDeps = {}): Connector {\\n   let state: SessionState | null = null;\\n   let instance: LhcInstance | null = null;\\n   let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n+  let captureSession: CaptureSession | null = null;\\n \\n   const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\n   const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n@@ -282,6 +309,21 @@ export function createConnector(deps: ConnectorDeps = {}): Connector {\\n     }\\n     instance = built.value;\\n     state = createSessionState(resolved.value);\\n+    // Seed the capture counters from the thread's DURABLE committed state, so a\\n+    // resume/reload onto an EXISTING thread continues past the prior session's\\n+    // idempotency keys instead of restarting at 0 and silently skipping new\\n+    // finalized events as false duplicates (SV-001). A new thread reads back\\n+    // zero, so a fresh session is unchanged; the read is touch-suppressed and\\n+    // happens once per session_start, never per event.\\n+    const piSessionId = sessionIdOf(resolved.value);\\n+    const seed = await built.value.sdk.inspect.overview(resolved.value);\\n+    const sourceSeq = seed.ok ? seed.value.events.count : 0;\\n+    const startTurnSeq = seed.ok ? seed.value.turns.closed : 0;\\n+    captureSession = {\\n+      piSessionId,\\n+      accumulator: new TurnAccumulator({ piSessionId, startTurnSeq }),\\n+      sourceSeq,\\n+    };\\n   };\\n \\n   // Dispose with flush before any session swap (session_before_switch fires\\n@@ -292,6 +334,73 @@ export function createConnector(deps: ConnectorDeps = {}): Connector {\\n     const result = await disposeInstance(instance);\\n     if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n     instance = null;\\n+    captureSession = null;\\n+  };\\n+\\n+  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\\n+  // converter already recorded a durable gap for a writable-thread malformed\\n+  // event (`invalid_event`); a store-unavailable failure could not, so it\\n+  // surfaces as an extension health signal with no gap. Neither path throws.\\n+  function recordCaptureOutcome(\\n+    result: OpResult<BatchResult>,\\n+    events: readonly MessageEventInput[],\\n+  ): void {\\n+    if (result.ok) return;\\n+    const recordedGap = result.error.code === \\\"invalid_event\\\";\\n+    const failure: CaptureFailureDiagnostic = {\\n+      code: result.error.code,\\n+      message: result.error.reason,\\n+      recordedGap,\\n+    };\\n+    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\\n+    lastDiagnostic = failure;\\n+    if (state !== null) state.health.lastCaptureFailure = failure;\\n+  }\\n+\\n+  // The next monotonic source-event index, used as the event's entry id. The\\n+  // counter is seeded from durable thread state at attach, so within a session\\n+  // it numbers new finalized events past every prior key (no resume collision),\\n+  // and a brand-new thread numbers from 0.\\n+  function nextEntryId(session: CaptureSession): string {\\n+    const id = `s${session.sourceSeq}`;\\n+    session.sourceSeq += 1;\\n+    return id;\\n+  }\\n+\\n+  // message_end: map the finalized PI message to ordered LHC events, track the\\n+  // open turn, and flush through the converter (AC-2.1).\\n+  const onMessageEnd: PiHookHandler<\\\"message_end\\\"> = async (_ctx, event) => {\\n+    if (instance === null || captureSession === null) return;\\n+    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\\n+    const events = mapMessage(event.message, mapCtx);\\n+    captureSession.accumulator.onMessage(events);\\n+    if (events.length === 0) return;\\n+    recordCaptureOutcome(await capture(events, instance), events);\\n+  };\\n+\\n+  // model_select / thinking_level_select fire only in-stream — capture each as\\n+  // an ordered runtime_note the moment it fires (AC-2.8).\\n+  const onModelSelect: PiHookHandler<\\\"model_select\\\"> = async (_ctx, event) => {\\n+    if (instance === null || captureSession === null) return;\\n+    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\\n+    const note = mapModelSelect(event, mapCtx);\\n+    recordCaptureOutcome(await capture([note], instance), [note]);\\n+  };\\n+\\n+  const onThinkingLevelSelect: PiHookHandler<\\\"thinking_level_select\\\"> = async (_ctx, event) => {\\n+    if (instance === null || captureSession === null) return;\\n+    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\\n+    const note = mapThinkingLevelSelect(event, mapCtx);\\n+    recordCaptureOutcome(await capture([note], instance), [note]);\\n+  };\\n+\\n+  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\\n+  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\\n+  const onAgentEnd: PiHookHandler<\\\"agent_end\\\"> = async () => {\\n+    if (instance === null || captureSession === null) return;\\n+    const turnEnd = captureSession.accumulator.onAgentEnd();\\n+    if (turnEnd.length === 0) return;\\n+    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\\n   };\\n \\n   // Contain every handler: an observe-only hook must never throw back into PI\\n@@ -314,23 +423,25 @@ export function createConnector(deps: ConnectorDeps = {}): Connector {\\n     };\\n   };\\n \\n-  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\\n-  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\\n-  // land in later stories. Each receives a FRESH ctx and retains none of it.\\n+  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\\n+  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\\n+  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\\n+  // FRESH ctx and retains none of it.\\n   const noop: PiHookHandler<Epic1Hook> = () => {\\n-    // Intentionally empty — later stories replace this with real routing.\\n+    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\\n   };\\n \\n-  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\\n+  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\\n+  // are live; PI per-step turn_end and fork remain no-ops.\\n   const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n     session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n     session_before_switch: onDispose,\\n     session_shutdown: onDispose,\\n-    message_end: noop,\\n+    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\\n     turn_end: noop,\\n-    agent_end: noop,\\n-    model_select: noop,\\n-    thinking_level_select: noop,\\n+    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\\n+    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\\n+    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\\n     session_before_fork: noop,\\n   };\\n \\ndiff --git a/packages/pi-lhc/test/fixtures/corpus.ts b/packages/pi-lhc/test/fixtures/corpus.ts\\nindex db82a31..0310118 100644\\n--- a/packages/pi-lhc/test/fixtures/corpus.ts\\n+++ b/packages/pi-lhc/test/fixtures/corpus.ts\\n@@ -6,6 +6,7 @@\\n // hardcodes a passing count (story §Anti-Shim Requirements).\\n import type { EventKind } from \\\"lhc\\\";\\n import type { Corpus } from \\\"../../src/verify/replay.js\\\";\\n+import { ABORTED_DISPOSITION_TEXT } from \\\"../../src/capture/map-message.js\\\";\\n import {\\n   makeAssistantMessage,\\n   makeToolResult,\\n@@ -125,6 +126,9 @@ export function loadAbortedTurnCorpus(): Corpus {\\n       validEvent(\\\"user_prompt\\\", { payload: { text: \\\"write a long essay\\\" } }),\\n       validEvent(\\\"assistant_thinking\\\", { payload: { text: \\\"starting the essay\\\" } }),\\n       validEvent(\\\"assistant_text\\\", { payload: { text: \\\"Once upon a\\\" } }),\\n+      // The aborted disposition rides a trailing runtime_note (the mapper carries\\n+      // stopReason through; research §5b), then the turn closes complete-but-aborted.\\n+      validEvent(\\\"runtime_note\\\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\\n       validEvent(\\\"turn_end\\\"),\\n     ],\\n   };\\ndiff --git a/packages/pi-lhc/test/red-manifest.json b/packages/pi-lhc/test/red-manifest.json\\nindex 8708a58..62ad32b 100644\\n--- a/packages/pi-lhc/test/red-manifest.json\\n+++ b/packages/pi-lhc/test/red-manifest.json\\n@@ -1,6 +1,12 @@\\n {\\n   \\\"files\\\": {\\n     \\\"test/lifecycle/instance.test.ts\\\": \\\"11deacd3e420f4d0ac257aa735dc80325176abf6bd6b6ebb72d447d3d9295681\\\",\\n-    \\\"test/lifecycle/thread-resolution.test.ts\\\": \\\"ff1aa1072f865d7b549f22b3d4731afbd128ed3492f2208d8127b548bb0cc680\\\"\\n+    \\\"test/lifecycle/thread-resolution.test.ts\\\": \\\"ff1aa1072f865d7b549f22b3d4731afbd128ed3492f2208d8127b548bb0cc680\\\",\\n+    \\\"test/capture/converter.test.ts\\\": \\\"e7c59cef629c01d5fba64d568f31ab25e2f29296431b05df3937c10c3a43b076\\\",\\n+    \\\"test/capture/turn-derivation.test.ts\\\": \\\"d815a4924f4c33da54a9e202ddfb2aa43f5c75a28d9ce31c604adf83c758d97e\\\",\\n+    \\\"test/capture/parallel-and-errors.test.ts\\\": \\\"885dc1c38aad3bfcb0cfcd8bc72dfd3b9e0fd463f119834f55a14b6efcfa40f7\\\",\\n+    \\\"test/capture/abort.test.ts\\\": \\\"ba0b2142b7ecae89b0305de1fe12772a479089751a17f766bbbf1c773fc720f6\\\",\\n+    \\\"test/capture/idempotency.test.ts\\\": \\\"660bc3c81cba10251a6ed10bb416db5033c8e2baf9f45f1cbbaaa665441c1497\\\",\\n+    \\\"test/capture/reattach-idempotency.test.ts\\\": \\\"f37c0cd0864f5c41b0cb3fffc4fc3c96a4b61468ed38b3eeb5211dd1195988e8\\\"\\n   }\\n }\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:51:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_23\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/src/capture/map-message.ts | sed -n '1,260p'\\\"\",\"aggregated_output\":\"     1\\timport type { EventKind, MessageEventInput } from \\\"lhc\\\";\\n     2\\timport type {\\n     3\\t  AgentMessage,\\n     4\\t  AssistantMessage,\\n     5\\t  ContentPart,\\n     6\\t  FileRefPart,\\n     7\\t  ImagePart,\\n     8\\t  ToolResultMessage,\\n     9\\t  UserMessage,\\n    10\\t} from \\\"../pi/types.js\\\";\\n    11\\timport { eventKey } from \\\"./idempotency.js\\\";\\n    12\\t\\n    13\\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\\n    14\\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\\n    15\\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\\n    16\\t// present) → one `tool_call` per call, in that order; a tool result → one\\n    17\\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\\n    18\\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\\n    19\\t// drop, tech design I-6). A graceful interrupt carries its disposition through\\n    20\\t// on a trailing `runtime_note` (research §5b).\\n    21\\t\\n    22\\texport interface MapCtx {\\n    23\\t  piSessionId: string;\\n    24\\t  entryId?: string;\\n    25\\t}\\n    26\\t\\n    27\\tconst HARNESS = \\\"pi\\\";\\n    28\\t\\n    29\\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\\n    30\\t *  field to hold its disposition, so the mapper carries `stopReason` through on\\n    31\\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\\n    32\\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\\n    33\\texport const ABORTED_DISPOSITION_TEXT =\\n    34\\t  \\\"turn aborted (stopReason: aborted) — partial content preserved\\\";\\n    35\\t\\n    36\\tconst EMPTY_MESSAGE_NOTE = \\\"message omitted: no mappable content parts\\\";\\n    37\\t\\n    38\\tfunction textOf(parts: ContentPart[]): string {\\n    39\\t  return parts\\n    40\\t    .filter((p): p is Extract<ContentPart, { type: \\\"text\\\" }> => p.type === \\\"text\\\")\\n    41\\t    .map((p) => p.text)\\n    42\\t    .join(\\\"\\\");\\n    43\\t}\\n    44\\t\\n    45\\tfunction thinkingOf(parts: ContentPart[]): string {\\n    46\\t  return parts\\n    47\\t    .filter((p): p is Extract<ContentPart, { type: \\\"thinking\\\" }> => p.type === \\\"thinking\\\")\\n    48\\t    .map((p) => p.thinking)\\n    49\\t    .join(\\\"\\\");\\n    50\\t}\\n    51\\t\\n    52\\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\\n    53\\t  return parts.filter(\\n    54\\t    (p): p is ImagePart | FileRefPart => p.type === \\\"image\\\" || p.type === \\\"fileRef\\\",\\n    55\\t  );\\n    56\\t}\\n    57\\t\\n    58\\tfunction omissionText(part: ImagePart | FileRefPart): string {\\n    59\\t  return part.type === \\\"image\\\"\\n    60\\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \\\"\\\"}`\\n    61\\t    : `unsupported content omitted: file reference (${part.path})`;\\n    62\\t}\\n    63\\t\\n    64\\tfunction buildKey(\\n    65\\t  ctx: MapCtx,\\n    66\\t  role: string,\\n    67\\t  kind: EventKind,\\n    68\\t  blockIndex: number,\\n    69\\t  opts: { toolCallId?: string; content?: string } = {},\\n    70\\t): string {\\n    71\\t  return eventKey({\\n    72\\t    piSessionId: ctx.piSessionId,\\n    73\\t    entryId: ctx.entryId,\\n    74\\t    blockIndex,\\n    75\\t    kind,\\n    76\\t    role,\\n    77\\t    toolCallId: opts.toolCallId,\\n    78\\t    content: opts.content,\\n    79\\t  });\\n    80\\t}\\n    81\\t\\n    82\\t// Per-kind builders — explicit eventKind literals so the discriminated union\\n    83\\t// narrows without a cast.\\n    84\\tfunction textEvent(\\n    85\\t  kind: \\\"user_prompt\\\" | \\\"assistant_text\\\" | \\\"assistant_thinking\\\" | \\\"runtime_note\\\",\\n    86\\t  text: string,\\n    87\\t  actor: string,\\n    88\\t  key: string,\\n    89\\t): MessageEventInput {\\n    90\\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\\n    91\\t}\\n    92\\t\\n    93\\tfunction toolCallEvent(\\n    94\\t  toolCallId: string,\\n    95\\t  toolName: string,\\n    96\\t  args: Record<string, unknown>,\\n    97\\t  key: string,\\n    98\\t): MessageEventInput {\\n    99\\t  return {\\n   100\\t    eventKind: \\\"tool_call\\\",\\n   101\\t    idempotencyKey: key,\\n   102\\t    actor: \\\"assistant\\\",\\n   103\\t    harness: HARNESS,\\n   104\\t    payload: { toolCallId, toolName, arguments: args },\\n   105\\t  };\\n   106\\t}\\n   107\\t\\n   108\\tfunction toolResultEvent(\\n   109\\t  toolCallId: string,\\n   110\\t  content: string,\\n   111\\t  isError: boolean,\\n   112\\t  key: string,\\n   113\\t): MessageEventInput {\\n   114\\t  return {\\n   115\\t    eventKind: \\\"tool_result\\\",\\n   116\\t    idempotencyKey: key,\\n   117\\t    actor: \\\"tool\\\",\\n   118\\t    harness: HARNESS,\\n   119\\t    payload: { toolCallId, content, isError },\\n   120\\t  };\\n   121\\t}\\n   122\\t\\n   123\\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\\n   124\\t  const events: MessageEventInput[] = [];\\n   125\\t  let block = 0;\\n   126\\t  if (msg.content.some((p) => p.type === \\\"text\\\")) {\\n   127\\t    const text = textOf(msg.content);\\n   128\\t    events.push(textEvent(\\\"user_prompt\\\", text, \\\"user\\\", buildKey(ctx, \\\"user\\\", \\\"user_prompt\\\", block, { content: text })));\\n   129\\t    block += 1;\\n   130\\t  }\\n   131\\t  for (const part of unsupportedOf(msg.content)) {\\n   132\\t    const text = omissionText(part);\\n   133\\t    events.push(textEvent(\\\"runtime_note\\\", text, \\\"system\\\", buildKey(ctx, \\\"user\\\", \\\"runtime_note\\\", block, { content: text })));\\n   134\\t    block += 1;\\n   135\\t  }\\n   136\\t  if (events.length === 0) {\\n   137\\t    events.push(\\n   138\\t      textEvent(\\\"runtime_note\\\", EMPTY_MESSAGE_NOTE, \\\"system\\\", buildKey(ctx, \\\"user\\\", \\\"runtime_note\\\", block, { content: \\\"empty:user\\\" })),\\n   139\\t    );\\n   140\\t  }\\n   141\\t  return events;\\n   142\\t}\\n   143\\t\\n   144\\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\\n   145\\t  const events: MessageEventInput[] = [];\\n   146\\t  let block = 0;\\n   147\\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\\n   148\\t  if (msg.content.some((p) => p.type === \\\"thinking\\\")) {\\n   149\\t    const text = thinkingOf(msg.content);\\n   150\\t    events.push(textEvent(\\\"assistant_thinking\\\", text, \\\"assistant\\\", buildKey(ctx, \\\"assistant\\\", \\\"assistant_thinking\\\", block, { content: text })));\\n   151\\t    block += 1;\\n   152\\t  }\\n   153\\t  if (msg.content.some((p) => p.type === \\\"text\\\")) {\\n   154\\t    const text = textOf(msg.content);\\n   155\\t    events.push(textEvent(\\\"assistant_text\\\", text, \\\"assistant\\\", buildKey(ctx, \\\"assistant\\\", \\\"assistant_text\\\", block, { content: text })));\\n   156\\t    block += 1;\\n   157\\t  }\\n   158\\t  for (const part of msg.content) {\\n   159\\t    if (part.type !== \\\"toolCall\\\") continue;\\n   160\\t    events.push(\\n   161\\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \\\"assistant\\\", \\\"tool_call\\\", block, { toolCallId: part.id, content: part.name })),\\n   162\\t    );\\n   163\\t    block += 1;\\n   164\\t  }\\n   165\\t  for (const part of unsupportedOf(msg.content)) {\\n   166\\t    const text = omissionText(part);\\n   167\\t    events.push(textEvent(\\\"runtime_note\\\", text, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: text })));\\n   168\\t    block += 1;\\n   169\\t  }\\n   170\\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\\n   171\\t  if (msg.stopReason === \\\"aborted\\\") {\\n   172\\t    events.push(\\n   173\\t      textEvent(\\\"runtime_note\\\", ABORTED_DISPOSITION_TEXT, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: ABORTED_DISPOSITION_TEXT })),\\n   174\\t    );\\n   175\\t    block += 1;\\n   176\\t  }\\n   177\\t  if (events.length === 0) {\\n   178\\t    events.push(\\n   179\\t      textEvent(\\\"runtime_note\\\", EMPTY_MESSAGE_NOTE, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: \\\"empty:assistant\\\" })),\\n   180\\t    );\\n   181\\t  }\\n   182\\t  return events;\\n   183\\t}\\n   184\\t\\n   185\\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\\n   186\\t  const content = textOf(msg.content);\\n   187\\t  const isError = msg.isError === true;\\n   188\\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\\n   189\\t  // and content are always captured, even on failure (AC-2.4).\\n   190\\t  return [\\n   191\\t    toolResultEvent(\\n   192\\t      msg.toolCallId,\\n   193\\t      content,\\n   194\\t      isError,\\n   195\\t      buildKey(ctx, \\\"toolResult\\\", \\\"tool_result\\\", 0, { toolCallId: msg.toolCallId, content }),\\n   196\\t    ),\\n   197\\t  ];\\n   198\\t}\\n   199\\t\\n   200\\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\\n   201\\t  switch (msg.role) {\\n   202\\t    case \\\"user\\\":\\n   203\\t      return mapUser(msg, ctx);\\n   204\\t    case \\\"assistant\\\":\\n   205\\t      return mapAssistant(msg, ctx);\\n   206\\t    case \\\"toolResult\\\":\\n   207\\t      return mapToolResult(msg, ctx);\\n   208\\t  }\\n   209\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:59:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_27\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/src/capture/turn-accumulator.ts | sed -n '1,140p'\\\"\",\"aggregated_output\":\"     1\\timport type { MessageEventInput } from \\\"lhc\\\";\\n     2\\timport { eventKey } from \\\"./idempotency.js\\\";\\n     3\\t\\n     4\\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\\n     5\\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\\n     6\\t//\\n     7\\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\\n     8\\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\\n     9\\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\\n    10\\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\\n    11\\t// no-op on reattach, since a fresh accumulator has no open turn to close.\\n    12\\t\\n    13\\texport interface TurnAccumulatorCtx {\\n    14\\t  piSessionId: string;\\n    15\\t  actor?: string;\\n    16\\t  harness?: string;\\n    17\\t  /** Seed for the turn counter, so a connector reattaching to an EXISTING\\n    18\\t   *  thread continues past the prior session's turn_end keys instead of\\n    19\\t   *  restarting at 0 and colliding with them (SV-001). Defaults to 0 — a fresh\\n    20\\t   *  thread or a deterministic from-scratch replay starts here unchanged. */\\n    21\\t  startTurnSeq?: number;\\n    22\\t}\\n    23\\t\\n    24\\texport class TurnAccumulator {\\n    25\\t  private readonly piSessionId: string;\\n    26\\t  private readonly actor: string;\\n    27\\t  private readonly harness: string;\\n    28\\t  private open = false;\\n    29\\t  // A monotonic counter giving each emitted `turn_end` a distinct idempotency\\n    30\\t  // key. Seeded from the thread's durable closed-turn count at attach so a\\n    31\\t  // resume/reload continues past prior keys; within a from-scratch run (seed 0)\\n    32\\t  // it stays replay-stable, so a deterministic re-replay re-derives and dedups.\\n    33\\t  private closedCount: number;\\n    34\\t\\n    35\\t  constructor(ctx: TurnAccumulatorCtx) {\\n    36\\t    this.piSessionId = ctx.piSessionId;\\n    37\\t    this.actor = ctx.actor ?? \\\"system\\\";\\n    38\\t    this.harness = ctx.harness ?? \\\"pi\\\";\\n    39\\t    this.closedCount = ctx.startTurnSeq ?? 0;\\n    40\\t  }\\n    41\\t\\n    42\\t  /** Open the turn when this message's events include a `user_prompt`. A new\\n    43\\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\\n    44\\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\\n    45\\t  onMessage(events: MessageEventInput[]): void {\\n    46\\t    if (events.some((event) => event.eventKind === \\\"user_prompt\\\")) {\\n    47\\t      this.open = true;\\n    48\\t    }\\n    49\\t  }\\n    50\\t\\n    51\\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\\n    52\\t   *  transition the accumulator drives, and it happens once per agent run. */\\n    53\\t  onAgentEnd(): MessageEventInput[] {\\n    54\\t    if (!this.open) return [];\\n    55\\t    this.open = false;\\n    56\\t    const key = eventKey({\\n    57\\t      piSessionId: this.piSessionId,\\n    58\\t      entryId: `turn:${this.closedCount}`,\\n    59\\t      blockIndex: 0,\\n    60\\t      kind: \\\"turn_end\\\",\\n    61\\t    });\\n    62\\t    this.closedCount += 1;\\n    63\\t    return [\\n    64\\t      {\\n    65\\t        eventKind: \\\"turn_end\\\",\\n    66\\t        idempotencyKey: key,\\n    67\\t        actor: this.actor,\\n    68\\t        harness: this.harness,\\n    69\\t        payload: {},\\n    70\\t      },\\n    71\\t    ];\\n    72\\t  }\\n    73\\t\\n    74\\t  hasOpenTurn(): boolean {\\n    75\\t    return this.open;\\n    76\\t  }\\n    77\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:74:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_36\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/capture/parallel-and-errors.test.ts | sed -n '1,220p'\\\"\",\"aggregated_output\":\"     1\\t// Story 2 — parallel-tool correlation (TC-2.4), error-result capture (TC-2.5),\\n     2\\t// and idempotent re-delivery (TC-2.7, the idempotency architecture-risk). The\\n     3\\t// first two run the production path and read the thread back; TC-2.7 drives\\n     4\\t// capture() directly so it can assert the per-event skip outcomes the SDK\\n     5\\t// returns on re-delivery.\\n     6\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     7\\timport { createDeterministicProvider, intakeStream } from \\\"lhc\\\";\\n     8\\timport { capture } from \\\"../../src/capture/converter.js\\\";\\n     9\\timport { mapMessage } from \\\"../../src/capture/map-message.js\\\";\\n    10\\timport { TurnAccumulator } from \\\"../../src/capture/turn-accumulator.js\\\";\\n    11\\timport { initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    12\\timport {\\n    13\\t  makeAgentEnd,\\n    14\\t  makeAssistantMessage,\\n    15\\t  makeMessageEnd,\\n    16\\t  makeToolResult,\\n    17\\t  makeUserMessage,\\n    18\\t} from \\\"../fixtures/synthetic.js\\\";\\n    19\\timport { makeTempThread, tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    20\\timport { eventsAfterShutdown, kindsOf, startCapture } from \\\"./support.js\\\";\\n    21\\t\\n    22\\tlet store: TempStore;\\n    23\\tbeforeEach(() => {\\n    24\\t  store = tempStore();\\n    25\\t});\\n    26\\tafterEach(() => {\\n    27\\t  store.cleanup();\\n    28\\t});\\n    29\\t\\n    30\\tinterface ToolResultPayload {\\n    31\\t  toolCallId: string;\\n    32\\t  content: string;\\n    33\\t  isError?: boolean;\\n    34\\t}\\n    35\\tfunction toolResultPayload(event: { payload: unknown }): ToolResultPayload {\\n    36\\t  return event.payload as ToolResultPayload;\\n    37\\t}\\n    38\\t\\n    39\\tdescribe(\\\"Story 2: parallel tool calls (TC-2.4)\\\", () => {\\n    40\\t  it(\\\"correlates each out-of-order tool_result to its call by toolCallId, not arrival order\\\", async () => {\\n    41\\t    const started = await startCapture(store);\\n    42\\t    const { connector, ctx } = started;\\n    43\\t\\n    44\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"read both files\\\")));\\n    45\\t    await connector.handlers.message_end(\\n    46\\t      ctx,\\n    47\\t      makeMessageEnd(\\n    48\\t        makeAssistantMessage({\\n    49\\t          toolCalls: [\\n    50\\t            { id: \\\"call_a\\\", name: \\\"read_file\\\", arguments: { path: \\\"a.txt\\\" } },\\n    51\\t            { id: \\\"call_b\\\", name: \\\"read_file\\\", arguments: { path: \\\"b.txt\\\" } },\\n    52\\t          ],\\n    53\\t        }),\\n    54\\t      ),\\n    55\\t    );\\n    56\\t    // Results complete out of arrival order: b before a.\\n    57\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_b\\\", content: \\\"b body\\\" })));\\n    58\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_a\\\", content: \\\"a body\\\" })));\\n    59\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"read both\\\" })));\\n    60\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    61\\t\\n    62\\t    const events = await eventsAfterShutdown(started);\\n    63\\t    const results = events.filter((event) => event.eventKind === \\\"tool_result\\\");\\n    64\\t    expect(results).toHaveLength(2);\\n    65\\t\\n    66\\t    // Each result carries its own call's id and content — correlation is by id.\\n    67\\t    const contentById = new Map(\\n    68\\t      results.map((event) => [toolResultPayload(event).toolCallId, toolResultPayload(event).content]),\\n    69\\t    );\\n    70\\t    expect(contentById.get(\\\"call_b\\\")).toBe(\\\"b body\\\");\\n    71\\t    expect(contentById.get(\\\"call_a\\\")).toBe(\\\"a body\\\");\\n    72\\t\\n    73\\t    // Arrival order is preserved in the record (b then a), each correctly tagged\\n    74\\t    // — proving the tag, not the position, is the correlation.\\n    75\\t    expect(toolResultPayload(results[0]!).toolCallId).toBe(\\\"call_b\\\");\\n    76\\t    expect(toolResultPayload(results[1]!).toolCallId).toBe(\\\"call_a\\\");\\n    77\\t  });\\n    78\\t});\\n    79\\t\\n    80\\tdescribe(\\\"Story 2: error tool result (TC-2.5)\\\", () => {\\n    81\\t  it(\\\"captures an error tool_result with the error flag and its content, dropping nothing\\\", async () => {\\n    82\\t    const started = await startCapture(store);\\n    83\\t    const { connector, ctx } = started;\\n    84\\t\\n    85\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"read missing.txt\\\")));\\n    86\\t    await connector.handlers.message_end(\\n    87\\t      ctx,\\n    88\\t      makeMessageEnd(makeAssistantMessage({ toolCalls: [{ id: \\\"call_a\\\", name: \\\"read_file\\\", arguments: { path: \\\"missing.txt\\\" } }] })),\\n    89\\t    );\\n    90\\t    await connector.handlers.message_end(\\n    91\\t      ctx,\\n    92\\t      makeMessageEnd(makeToolResult({ id: \\\"call_a\\\", isError: true, content: \\\"ENOENT: no such file\\\" })),\\n    93\\t    );\\n    94\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"it does not exist\\\" })));\\n    95\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    96\\t\\n    97\\t    const events = await eventsAfterShutdown(started);\\n    98\\t    // Nothing dropped because the tool failed.\\n    99\\t    expect(kindsOf(events)).toEqual([\\\"user_prompt\\\", \\\"tool_call\\\", \\\"tool_result\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]);\\n   100\\t\\n   101\\t    const result = events.find((event) => event.eventKind === \\\"tool_result\\\");\\n   102\\t    expect(result).toBeDefined();\\n   103\\t    expect(toolResultPayload(result!).isError).toBe(true);\\n   104\\t    expect(toolResultPayload(result!).content).toBe(\\\"ENOENT: no such file\\\");\\n   105\\t  });\\n   106\\t});\\n   107\\t\\n   108\\tdescribe(\\\"Story 2: idempotent re-delivery (TC-2.7, idempotency risk)\\\", () => {\\n   109\\t  it(\\\"skips a re-delivered batch by idempotency key and records no duplicates\\\", async () => {\\n   110\\t    const thread = await makeTempThread(store);\\n   111\\t    const built = await initInstance(thread.threadRef, {\\n   112\\t      provider: createDeterministicProvider(),\\n   113\\t      mode: \\\"background\\\",\\n   114\\t    });\\n   115\\t    expect(built.ok).toBe(true);\\n   116\\t    if (!built.ok) return;\\n   117\\t    const instance = built.value;\\n   118\\t\\n   119\\t    // Build one logical turn's events through the real map + accumulator, so the\\n   120\\t    // keys are exactly what production would emit.\\n   121\\t    const acc = new TurnAccumulator({ piSessionId: \\\"sess\\\" });\\n   122\\t    const userEvents = mapMessage(makeUserMessage(\\\"hello\\\"), { piSessionId: \\\"sess\\\", entryId: \\\"s0\\\" });\\n   123\\t    acc.onMessage(userEvents);\\n   124\\t    const assistantEvents = mapMessage(makeAssistantMessage({ text: \\\"hi there\\\" }), {\\n   125\\t      piSessionId: \\\"sess\\\",\\n   126\\t      entryId: \\\"s1\\\",\\n   127\\t    });\\n   128\\t    acc.onMessage(assistantEvents);\\n   129\\t    const turnEnd = acc.onAgentEnd();\\n   130\\t    const batch = [...userEvents, ...assistantEvents, ...turnEnd];\\n   131\\t\\n   132\\t    const first = await capture(batch, instance);\\n   133\\t    expect(first.ok).toBe(true);\\n   134\\t    if (first.ok) {\\n   135\\t      expect(first.value.events.every((entry) => entry.outcome === \\\"recorded\\\")).toBe(true);\\n   136\\t    }\\n   137\\t\\n   138\\t    // Re-delivery (the reload / crash-replay path): identical keys → all skipped.\\n   139\\t    const second = await capture(batch, instance);\\n   140\\t    expect(second.ok).toBe(true);\\n   141\\t    if (second.ok) {\\n   142\\t      expect(second.value.events.every((entry) => entry.outcome === \\\"skipped\\\")).toBe(true);\\n   143\\t      expect(\\n   144\\t        second.value.events.every((entry) => entry.skipReason === \\\"duplicate_idempotency_key\\\"),\\n   145\\t      ).toBe(true);\\n   146\\t    }\\n   147\\t\\n   148\\t    // No duplicate records landed on the thread.\\n   149\\t    const read = await intakeStream.listEvents(instance.threadRef);\\n   150\\t    expect(read.ok).toBe(true);\\n   151\\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\\n   152\\t\\n   153\\t    await instance.dispose();\\n   154\\t  });\\n   155\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:75:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_35\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/capture/turn-derivation.test.ts | sed -n '1,220p'\\\"\",\"aggregated_output\":\"     1\\t// Story 2 — turn derivation, the load-bearing mechanic. An LHC turn spans a\\n     2\\t// whole exchange: it opens on a user prompt, ignores every PI per-step\\n     3\\t// `turn_end`, and closes with exactly one LHC `turn_end` at `agent_end`\\n     4\\t// (TC-2.2). Session order is the converter's source-event order, never PI's\\n     5\\t// per-run `turnIndex` (TC-2.3). The accumulator goldens pin the state machine\\n     6\\t// directly, including the hard-kill tolerance (a dangling open turn, and an\\n     7\\t// agent_end with no open turn as a no-op).\\n     8\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     9\\timport type { MessageEventInput } from \\\"lhc\\\";\\n    10\\timport { TurnAccumulator } from \\\"../../src/capture/turn-accumulator.js\\\";\\n    11\\timport {\\n    12\\t  makeAgentEnd,\\n    13\\t  makeAssistantMessage,\\n    14\\t  makeMessageEnd,\\n    15\\t  makeToolResult,\\n    16\\t  makeUserMessage,\\n    17\\t  validEvent,\\n    18\\t} from \\\"../fixtures/synthetic.js\\\";\\n    19\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    20\\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \\\"./support.js\\\";\\n    21\\t\\n    22\\tlet store: TempStore;\\n    23\\tbeforeEach(() => {\\n    24\\t  store = tempStore();\\n    25\\t});\\n    26\\tafterEach(() => {\\n    27\\t  store.cleanup();\\n    28\\t});\\n    29\\t\\n    30\\tfunction textOf(event: MessageEventInput): string {\\n    31\\t  return (event.payload as { text?: string }).text ?? \\\"\\\";\\n    32\\t}\\n    33\\t\\n    34\\t// A PI per-step turn_end payload (ignored by the converter as a boundary).\\n    35\\tfunction piTurnEnd(turnIndex: number) {\\n    36\\t  return { turnIndex, message: makeAssistantMessage({ text: \\\"step\\\" }), toolResults: [] };\\n    37\\t}\\n    38\\t\\n    39\\tdescribe(\\\"Story 2: turn derivation — worked example (TC-2.2)\\\", () => {\\n    40\\t  it(\\\"yields exactly one LHC turn with one turn_end at agent_end; PI per-step turn_ends produce none\\\", async () => {\\n    41\\t    const started = await startCapture(store);\\n    42\\t    const { connector, ctx, threadRef } = started;\\n    43\\t\\n    44\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"ask one question\\\")));\\n    45\\t    await connector.handlers.message_end(\\n    46\\t      ctx,\\n    47\\t      makeMessageEnd(\\n    48\\t        makeAssistantMessage({\\n    49\\t          thinking: \\\"two tools needed\\\",\\n    50\\t          toolCalls: [\\n    51\\t            { id: \\\"call_a\\\", name: \\\"read_file\\\", arguments: { path: \\\"a.txt\\\" } },\\n    52\\t            { id: \\\"call_b\\\", name: \\\"read_file\\\", arguments: { path: \\\"b.txt\\\" } },\\n    53\\t          ],\\n    54\\t        }),\\n    55\\t      ),\\n    56\\t    );\\n    57\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_b\\\", content: \\\"b\\\" })));\\n    58\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_a\\\", content: \\\"a\\\" })));\\n    59\\t    // PI fires a per-step turn_end here — it must NOT become an LHC turn_end.\\n    60\\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\\n    61\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"the answer\\\" })));\\n    62\\t    await connector.handlers.turn_end(ctx, piTurnEnd(1));\\n    63\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    64\\t\\n    65\\t    const events = await eventsAfterShutdown(started);\\n    66\\t    expect(kindsOf(events)).toEqual([\\n    67\\t      \\\"user_prompt\\\",\\n    68\\t      \\\"assistant_thinking\\\",\\n    69\\t      \\\"tool_call\\\",\\n    70\\t      \\\"tool_call\\\",\\n    71\\t      \\\"tool_result\\\",\\n    72\\t      \\\"tool_result\\\",\\n    73\\t      \\\"assistant_text\\\",\\n    74\\t      \\\"turn_end\\\",\\n    75\\t    ]);\\n    76\\t    // Exactly one LHC turn_end, and it lands last — at agent_end, not per PI step.\\n    77\\t    expect(events.filter((event) => event.eventKind === \\\"turn_end\\\")).toHaveLength(1);\\n    78\\t    expect(events.at(-1)?.eventKind).toBe(\\\"turn_end\\\");\\n    79\\t\\n    80\\t    const counts = await turnCounts(threadRef);\\n    81\\t    expect(counts.closed).toBe(1);\\n    82\\t    expect(counts.open).toBe(0);\\n    83\\t  });\\n    84\\t});\\n    85\\t\\n    86\\tdescribe(\\\"Story 2: turn derivation — source order, not turnIndex (TC-2.3)\\\", () => {\\n    87\\t  it(\\\"orders two agent runs that each start at turnIndex 0 by source-event order, with no collision\\\", async () => {\\n    88\\t    const started = await startCapture(store);\\n    89\\t    const { connector, ctx, threadRef } = started;\\n    90\\t\\n    91\\t    // Run 1 (PI turnIndex 0)\\n    92\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"first prompt\\\")));\\n    93\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"first answer\\\" })));\\n    94\\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\\n    95\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    96\\t    // Run 2 (PI turnIndex 0 AGAIN — the reset-per-run counter)\\n    97\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"second prompt\\\")));\\n    98\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"second answer\\\" })));\\n    99\\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\\n   100\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n   101\\t\\n   102\\t    const events = await eventsAfterShutdown(started);\\n   103\\t    expect(kindsOf(events)).toEqual([\\n   104\\t      \\\"user_prompt\\\",\\n   105\\t      \\\"assistant_text\\\",\\n   106\\t      \\\"turn_end\\\",\\n   107\\t      \\\"user_prompt\\\",\\n   108\\t      \\\"assistant_text\\\",\\n   109\\t      \\\"turn_end\\\",\\n   110\\t    ]);\\n   111\\t    // Source order decides sequence: run 1 precedes run 2 despite identical turnIndex.\\n   112\\t    expect(textOf(events[0]!)).toBe(\\\"first prompt\\\");\\n   113\\t    expect(textOf(events[3]!)).toBe(\\\"second prompt\\\");\\n   114\\t\\n   115\\t    const counts = await turnCounts(threadRef);\\n   116\\t    expect(counts.closed).toBe(2);\\n   117\\t    expect(counts.open).toBe(0);\\n   118\\t  });\\n   119\\t});\\n   120\\t\\n   121\\tdescribe(\\\"Story 2: turn accumulator — state machine goldens (AC-2.2)\\\", () => {\\n   122\\t  it(\\\"emits one turn_end only when a turn is open, and is idempotent across agent_end\\\", () => {\\n   123\\t    const acc = new TurnAccumulator({ piSessionId: \\\"sess\\\" });\\n   124\\t    expect(acc.hasOpenTurn()).toBe(false);\\n   125\\t\\n   126\\t    acc.onMessage([validEvent(\\\"user_prompt\\\")]);\\n   127\\t    expect(acc.hasOpenTurn()).toBe(true);\\n   128\\t\\n   129\\t    const emitted = acc.onAgentEnd();\\n   130\\t    expect(emitted).toHaveLength(1);\\n   131\\t    expect(emitted[0]?.eventKind).toBe(\\\"turn_end\\\");\\n   132\\t    expect(emitted[0]?.payload).toEqual({});\\n   133\\t    expect(acc.hasOpenTurn()).toBe(false);\\n   134\\t\\n   135\\t    // A second agent_end with no open turn emits nothing (hard-kill / reattach\\n   136\\t    // tolerance: turn_end-with-no-open-turn is a no-op).\\n   137\\t    expect(acc.onAgentEnd()).toEqual([]);\\n   138\\t  });\\n   139\\t\\n   140\\t  it(\\\"gives successive turns distinct turn_end idempotency keys\\\", () => {\\n   141\\t    const acc = new TurnAccumulator({ piSessionId: \\\"sess\\\" });\\n   142\\t    acc.onMessage([validEvent(\\\"user_prompt\\\")]);\\n   143\\t    const first = acc.onAgentEnd();\\n   144\\t    acc.onMessage([validEvent(\\\"user_prompt\\\")]);\\n   145\\t    const second = acc.onAgentEnd();\\n   146\\t    expect(first[0]?.idempotencyKey).not.toBe(second[0]?.idempotencyKey);\\n   147\\t  });\\n   148\\t});\\n   149\\t\\n   150\\tdescribe(\\\"Story 2: turn derivation — hard-kill golden\\\", () => {\\n   151\\t  it(\\\"leaves a dangling open turn when the run never reaches agent_end, with no turn_end recorded\\\", async () => {\\n   152\\t    const started = await startCapture(store);\\n   153\\t    const { connector, ctx, threadRef } = started;\\n   154\\t\\n   155\\t    // Hard kill: a user message lands, then the process dies — no assistant\\n   156\\t    // close, no agent_end.\\n   157\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"dangling prompt\\\")));\\n   158\\t    await connector.getInstance()?.sdk.drainSettled(threadRef);\\n   159\\t\\n   160\\t    const counts = await turnCounts(threadRef);\\n   161\\t    expect(counts.open).toBe(1);\\n   162\\t    expect(counts.closed).toBe(0);\\n   163\\t\\n   164\\t    const events = await eventsAfterShutdown(started);\\n   165\\t    expect(events.filter((event) => event.eventKind === \\\"turn_end\\\")).toHaveLength(0);\\n   166\\t    expect(kindsOf(events)).toEqual([\\\"user_prompt\\\"]);\\n   167\\t  });\\n   168\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:76:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_34\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/capture/converter.test.ts | sed -n '1,260p'\\\"\",\"aggregated_output\":\"     1\\t// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\\n     2\\t// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\\n     3\\t// production path runs end to end — PI hook → converter → real LHC intake —\\n     4\\t// and every assertion reads the durable thread back. TC-2.8 also exercises\\n     5\\t// capture() directly because the two failure shapes (writable→gap vs\\n     6\\t// store-unavailable→health) are the architecture-risk contract.\\n     7\\timport { rmSync } from \\\"node:fs\\\";\\n     8\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     9\\timport {\\n    10\\t  createDeterministicProvider,\\n    11\\t  intakeStream,\\n    12\\t  threads,\\n    13\\t  type MessageEventInput,\\n    14\\t  type ThreadRef,\\n    15\\t} from \\\"lhc\\\";\\n    16\\timport { capture } from \\\"../../src/capture/converter.js\\\";\\n    17\\timport { initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    18\\timport type { LhcInstance } from \\\"../../src/shared/instance.js\\\";\\n    19\\timport {\\n    20\\t  makeAgentEnd,\\n    21\\t  makeAssistantMessage,\\n    22\\t  makeMessageEnd,\\n    23\\t  makeToolResult,\\n    24\\t  makeUserMessage,\\n    25\\t  validEvent,\\n    26\\t} from \\\"../fixtures/synthetic.js\\\";\\n    27\\timport { makeTempThread, tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    28\\timport { eventsAfterShutdown, kindsOf, startCapture } from \\\"./support.js\\\";\\n    29\\t\\n    30\\tlet store: TempStore;\\n    31\\tbeforeEach(() => {\\n    32\\t  store = tempStore();\\n    33\\t});\\n    34\\tafterEach(() => {\\n    35\\t  store.cleanup();\\n    36\\t});\\n    37\\t\\n    38\\tfunction textOf(event: MessageEventInput): string {\\n    39\\t  return (event.payload as { text?: string }).text ?? \\\"\\\";\\n    40\\t}\\n    41\\t\\n    42\\tdescribe(\\\"Story 2: converter — capture and fan-out (TC-2.1)\\\", () => {\\n    43\\t  it(\\\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\\\", async () => {\\n    44\\t    const started = await startCapture(store);\\n    45\\t    const { connector, ctx } = started;\\n    46\\t\\n    47\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"read the file\\\")));\\n    48\\t    await connector.handlers.message_end(\\n    49\\t      ctx,\\n    50\\t      makeMessageEnd(\\n    51\\t        makeAssistantMessage({\\n    52\\t          thinking: \\\"I should open it\\\",\\n    53\\t          text: \\\"here is the answer\\\",\\n    54\\t          toolCalls: [{ id: \\\"call_x\\\", name: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } }],\\n    55\\t        }),\\n    56\\t      ),\\n    57\\t    );\\n    58\\t    await connector.handlers.message_end(\\n    59\\t      ctx,\\n    60\\t      makeMessageEnd(makeToolResult({ id: \\\"call_x\\\", content: \\\"file body\\\" })),\\n    61\\t    );\\n    62\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    63\\t\\n    64\\t    // No silent capture failure on the happy path.\\n    65\\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\\n    66\\t\\n    67\\t    const events = await eventsAfterShutdown(started);\\n    68\\t    expect(kindsOf(events)).toEqual([\\n    69\\t      \\\"user_prompt\\\",\\n    70\\t      \\\"assistant_thinking\\\",\\n    71\\t      \\\"assistant_text\\\",\\n    72\\t      \\\"tool_call\\\",\\n    73\\t      \\\"tool_result\\\",\\n    74\\t      \\\"turn_end\\\",\\n    75\\t    ]);\\n    76\\t\\n    77\\t    expect(textOf(events[0]!)).toBe(\\\"read the file\\\");\\n    78\\t    expect(textOf(events[1]!)).toBe(\\\"I should open it\\\");\\n    79\\t    expect(textOf(events[2]!)).toBe(\\\"here is the answer\\\");\\n    80\\t    expect(events[3]!.payload).toMatchObject({\\n    81\\t      toolCallId: \\\"call_x\\\",\\n    82\\t      toolName: \\\"read_file\\\",\\n    83\\t      arguments: { path: \\\"notes.txt\\\" },\\n    84\\t    });\\n    85\\t    expect(events[4]!.payload).toMatchObject({ toolCallId: \\\"call_x\\\", content: \\\"file body\\\" });\\n    86\\t  });\\n    87\\t});\\n    88\\t\\n    89\\tdescribe(\\\"Story 2: converter — runtime-change capture (TC-2.9)\\\", () => {\\n    90\\t  it(\\\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\\\", async () => {\\n    91\\t    const started = await startCapture(store);\\n    92\\t    const { connector, ctx } = started;\\n    93\\t\\n    94\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"go\\\")));\\n    95\\t    await connector.handlers.model_select(ctx, {\\n    96\\t      model: { provider: \\\"openai\\\", id: \\\"gpt-4o\\\" },\\n    97\\t      previousModel: { provider: \\\"anthropic\\\", id: \\\"claude-3\\\" },\\n    98\\t    });\\n    99\\t    await connector.handlers.thinking_level_select(ctx, { level: \\\"high\\\", previousLevel: \\\"low\\\" });\\n   100\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"done\\\" })));\\n   101\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n   102\\t\\n   103\\t    const events = await eventsAfterShutdown(started);\\n   104\\t    // Ordering relative to the surrounding messages is preserved.\\n   105\\t    expect(kindsOf(events)).toEqual([\\n   106\\t      \\\"user_prompt\\\",\\n   107\\t      \\\"runtime_note\\\",\\n   108\\t      \\\"runtime_note\\\",\\n   109\\t      \\\"assistant_text\\\",\\n   110\\t      \\\"turn_end\\\",\\n   111\\t    ]);\\n   112\\t\\n   113\\t    const modelNote = textOf(events[1]!);\\n   114\\t    expect(modelNote).toContain(\\\"anthropic/claude-3\\\");\\n   115\\t    expect(modelNote).toContain(\\\"openai/gpt-4o\\\");\\n   116\\t\\n   117\\t    const levelNote = textOf(events[2]!);\\n   118\\t    expect(levelNote).toContain(\\\"low\\\");\\n   119\\t    expect(levelNote).toContain(\\\"high\\\");\\n   120\\t  });\\n   121\\t});\\n   122\\t\\n   123\\tdescribe(\\\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\\\", () => {\\n   124\\t  async function liveInstance(): Promise<LhcInstance> {\\n   125\\t    const thread = await makeTempThread(store);\\n   126\\t    const built = await initInstance(thread.threadRef, {\\n   127\\t      provider: createDeterministicProvider(),\\n   128\\t      mode: \\\"background\\\",\\n   129\\t    });\\n   130\\t    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\\n   131\\t    return built.value;\\n   132\\t  }\\n   133\\t\\n   134\\t  it(\\\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\\\", async () => {\\n   135\\t    const instance = await liveInstance();\\n   136\\t    // A turn_end with a non-empty payload is rejected by LHC validation\\n   137\\t    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\\n   138\\t    const malformed = {\\n   139\\t      eventKind: \\\"turn_end\\\",\\n   140\\t      idempotencyKey: \\\"malformed-1\\\",\\n   141\\t      actor: \\\"system\\\",\\n   142\\t      harness: \\\"pi\\\",\\n   143\\t      payload: { stowaway: true },\\n   144\\t    } as unknown as MessageEventInput;\\n   145\\t\\n   146\\t    const result = await capture([malformed], instance);\\n   147\\t    expect(result.ok).toBe(false);\\n   148\\t\\n   149\\t    // The session continues: a durable, queryable gap is recorded on the thread.\\n   150\\t    const read = await intakeStream.listEvents(instance.threadRef);\\n   151\\t    expect(read.ok).toBe(true);\\n   152\\t    if (!read.ok) return;\\n   153\\t    const gaps = read.value.filter(\\n   154\\t      (event) =>\\n   155\\t        event.eventKind === \\\"runtime_note\\\" &&\\n   156\\t        (event.payload as { text: string }).text.toLowerCase().includes(\\\"gap\\\"),\\n   157\\t    );\\n   158\\t    expect(gaps).toHaveLength(1);\\n   159\\t\\n   160\\t    await instance.dispose();\\n   161\\t  });\\n   162\\t\\n   163\\t  it(\\\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\\\", async () => {\\n   164\\t    const deadInstance: LhcInstance = {\\n   165\\t      sdk: (await liveInstance()).sdk,\\n   166\\t      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\\n   167\\t      dispose: () => Promise.resolve({ ok: true, value: undefined }),\\n   168\\t    };\\n   169\\t\\n   170\\t    // capture isolates the failure into a structured result rather than throwing.\\n   171\\t    const result = await capture([validEvent(\\\"user_prompt\\\")], deadInstance);\\n   172\\t    expect(result.ok).toBe(false);\\n   173\\t    if (result.ok) return;\\n   174\\t    expect([\\\"thread_not_found\\\", \\\"storage_failure\\\"]).toContain(result.error.code);\\n   175\\t    // It is NOT misclassified as the writable-thread malformed-event case.\\n   176\\t    expect(result.error.code).not.toBe(\\\"invalid_event\\\");\\n   177\\t  });\\n   178\\t\\n   179\\t  it(\\\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\\\", async () => {\\n   180\\t    const started = await startCapture(store);\\n   181\\t    const { connector, ctx, threadRef } = started;\\n   182\\t\\n   183\\t    // Make the live thread's store unavailable mid-session, then capture.\\n   184\\t    const id = (threadRef as { threadId: string }).threadId;\\n   185\\t    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n   186\\t    expect(row.ok).toBe(true);\\n   187\\t    if (!row.ok) return;\\n   188\\t    rmSync(row.value.filePath, { force: true });\\n   189\\t\\n   190\\t    // The hook must not throw despite the dead store.\\n   191\\t    await expect(\\n   192\\t      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"after the store died\\\"))),\\n   193\\t    ).resolves.toBeUndefined();\\n   194\\t\\n   195\\t    const health = connector.getState()?.health.lastCaptureFailure;\\n   196\\t    expect(health).toBeDefined();\\n   197\\t    expect(health?.recordedGap).toBe(false);\\n   198\\t\\n   199\\t    await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n   200\\t  });\\n   201\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:78:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_37\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/capture/reattach-idempotency.test.ts | sed -n '1,220p'\\\"\",\"aggregated_output\":\"     1\\t// Story 2 — SV-001 regression: existing-thread resume/reload must keep recording\\n     2\\t// new finalized events. The connector seeds its capture counters from the\\n     3\\t// thread's durable committed state at attach, so a fresh connector's idempotency\\n     4\\t// keys continue past the prior session's instead of restarting at 0 and\\n     5\\t// skipping new events as false duplicates — while the converter's same-key\\n     6\\t// dedup (the reload/replay safety net) stays intact.\\n     7\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     8\\timport {\\n     9\\t  createDeterministicProvider,\\n    10\\t  intakeStream,\\n    11\\t  type MessageEventInput,\\n    12\\t  type ThreadRef,\\n    13\\t} from \\\"lhc\\\";\\n    14\\timport { capture } from \\\"../../src/capture/converter.js\\\";\\n    15\\timport { mapMessage } from \\\"../../src/capture/map-message.js\\\";\\n    16\\timport { TurnAccumulator } from \\\"../../src/capture/turn-accumulator.js\\\";\\n    17\\timport { initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    18\\timport {\\n    19\\t  makeAgentEnd,\\n    20\\t  makeAssistantMessage,\\n    21\\t  makeMessageEnd,\\n    22\\t  makeUserMessage,\\n    23\\t} from \\\"../fixtures/synthetic.js\\\";\\n    24\\timport { makeTempThread, tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    25\\timport { attachCapture, eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \\\"./support.js\\\";\\n    26\\t\\n    27\\tlet store: TempStore;\\n    28\\tbeforeEach(() => {\\n    29\\t  store = tempStore();\\n    30\\t});\\n    31\\tafterEach(() => {\\n    32\\t  store.cleanup();\\n    33\\t});\\n    34\\t\\n    35\\tfunction textOf(event: MessageEventInput): string {\\n    36\\t  return (event.payload as { text?: string }).text ?? \\\"\\\";\\n    37\\t}\\n    38\\t\\n    39\\tfunction userTexts(events: readonly MessageEventInput[]): string[] {\\n    40\\t  return events.filter((event) => event.eventKind === \\\"user_prompt\\\").map(textOf);\\n    41\\t}\\n    42\\t\\n    43\\tfunction threadIdOf(ref: ThreadRef): string {\\n    44\\t  if (!(\\\"threadId\\\" in ref)) throw new Error(\\\"expected a { threadId } ref\\\");\\n    45\\t  return ref.threadId;\\n    46\\t}\\n    47\\t\\n    48\\tdescribe(\\\"Story 2: existing-thread reattach idempotency (SV-001)\\\", () => {\\n    49\\t  it(\\\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\\\", async () => {\\n    50\\t    // Session A records one exchange, then shuts down.\\n    51\\t    const a = await startCapture(store);\\n    52\\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\\\"first\\\")));\\n    53\\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\\n    54\\t    const threadId = threadIdOf(a.threadRef);\\n    55\\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \\\"shutdown\\\" });\\n    56\\t\\n    57\\t    // A brand-new connector attaches to the SAME thread by id and records a new\\n    58\\t    // message — it must NOT be skipped as a prior-key collision.\\n    59\\t    const b = await attachCapture(store, { session: threadId }, \\\"resume\\\");\\n    60\\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\\n    61\\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\\\"second after resume\\\")));\\n    62\\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\\n    63\\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\\n    64\\t\\n    65\\t    const events = await eventsAfterShutdown(b);\\n    66\\t    expect(userTexts(events)).toEqual([\\\"first\\\", \\\"second after resume\\\"]);\\n    67\\t    const counts = await turnCounts(b.threadRef);\\n    68\\t    expect(counts.closed).toBe(2);\\n    69\\t  });\\n    70\\t\\n    71\\t  it(\\\"(2) a reload onto an existing thread also continues recording new finalized events\\\", async () => {\\n    72\\t    const a = await startCapture(store);\\n    73\\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\\\"first\\\")));\\n    74\\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\\n    75\\t    const threadId = threadIdOf(a.threadRef);\\n    76\\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \\\"reload\\\" });\\n    77\\t\\n    78\\t    const b = await attachCapture(store, { session: threadId }, \\\"reload\\\");\\n    79\\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\\\"second after reload\\\")));\\n    80\\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\\n    81\\t\\n    82\\t    const events = await eventsAfterShutdown(b);\\n    83\\t    expect(userTexts(events)).toEqual([\\\"first\\\", \\\"second after reload\\\"]);\\n    84\\t    const counts = await turnCounts(b.threadRef);\\n    85\\t    expect(counts.closed).toBe(2);\\n    86\\t  });\\n    87\\t\\n    88\\t  it(\\\"(3) normal resume records new messages and does not duplicate the prior session's history\\\", async () => {\\n    89\\t    // Session A: one complete turn.\\n    90\\t    const a = await startCapture(store);\\n    91\\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\\\"first\\\")));\\n    92\\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"answer one\\\" })));\\n    93\\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\\n    94\\t    const threadId = threadIdOf(a.threadRef);\\n    95\\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \\\"shutdown\\\" });\\n    96\\t\\n    97\\t    // Resume: PI does not re-fire history, so the connector sees only the new\\n    98\\t    // turn — which must record, leaving the prior turn intact and un-duplicated.\\n    99\\t    const b = await attachCapture(store, { session: threadId }, \\\"resume\\\");\\n   100\\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\\\"second\\\")));\\n   101\\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"answer two\\\" })));\\n   102\\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\\n   103\\t\\n   104\\t    const events = await eventsAfterShutdown(b);\\n   105\\t    expect(kindsOf(events)).toEqual([\\n   106\\t      \\\"user_prompt\\\",\\n   107\\t      \\\"assistant_text\\\",\\n   108\\t      \\\"turn_end\\\",\\n   109\\t      \\\"user_prompt\\\",\\n   110\\t      \\\"assistant_text\\\",\\n   111\\t      \\\"turn_end\\\",\\n   112\\t    ]);\\n   113\\t    expect(userTexts(events)).toEqual([\\\"first\\\", \\\"second\\\"]);\\n   114\\t    // Two distinct closed turns — the turn_end keys did not collide either.\\n   115\\t    const counts = await turnCounts(b.threadRef);\\n   116\\t    expect(counts.closed).toBe(2);\\n   117\\t    expect(counts.open).toBe(0);\\n   118\\t  });\\n   119\\t\\n   120\\t  it(\\\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\\\", async () => {\\n   121\\t    const thread = await makeTempThread(store);\\n   122\\t    const built = await initInstance(thread.threadRef, {\\n   123\\t      provider: createDeterministicProvider(),\\n   124\\t      mode: \\\"background\\\",\\n   125\\t    });\\n   126\\t    expect(built.ok).toBe(true);\\n   127\\t    if (!built.ok) return;\\n   128\\t    const instance = built.value;\\n   129\\t\\n   130\\t    // Build one turn's events with stable keys, then deliver the SAME batch\\n   131\\t    // twice — the second delivery (the reload / crash-replay shape) must dedup.\\n   132\\t    const acc = new TurnAccumulator({ piSessionId: \\\"sess\\\" });\\n   133\\t    const userEvents = mapMessage(makeUserMessage(\\\"hello\\\"), { piSessionId: \\\"sess\\\", entryId: \\\"s0\\\" });\\n   134\\t    acc.onMessage(userEvents);\\n   135\\t    const batch = [...userEvents, ...acc.onAgentEnd()];\\n   136\\t\\n   137\\t    const first = await capture(batch, instance);\\n   138\\t    expect(first.ok).toBe(true);\\n   139\\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \\\"recorded\\\")).toBe(true);\\n   140\\t\\n   141\\t    const second = await capture(batch, instance);\\n   142\\t    expect(second.ok).toBe(true);\\n   143\\t    if (second.ok) expect(second.value.events.every((entry) => entry.outcome === \\\"skipped\\\")).toBe(true);\\n   144\\t\\n   145\\t    const read = await intakeStream.listEvents(instance.threadRef);\\n   146\\t    expect(read.ok).toBe(true);\\n   147\\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\\n   148\\t\\n   149\\t    await instance.dispose();\\n   150\\t  });\\n   151\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:81:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_38\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/fixtures/synthetic.ts | sed -n '1,220p'\\\"\",\"aggregated_output\":\"     1\\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\\n     2\\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\\n     3\\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\\n     4\\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\\n     5\\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\\n     6\\timport type { EventKind, MessageEventInput } from \\\"lhc\\\";\\n     7\\timport type {\\n     8\\t  AgentEndEvent,\\n     9\\t  AgentMessage,\\n    10\\t  AssistantMessage,\\n    11\\t  ContentPart,\\n    12\\t  MessageEndEvent,\\n    13\\t  PiStopReason,\\n    14\\t  SessionStartEvent,\\n    15\\t  SessionStartReason,\\n    16\\t  ToolResultMessage,\\n    17\\t  UserMessage,\\n    18\\t} from \\\"../../src/pi/types.js\\\";\\n    19\\t\\n    20\\t// ── LHC intake-event builder ─────────────────────────────────────────\\n    21\\t\\n    22\\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\\n    23\\t\\n    24\\tlet keyCounter = 0;\\n    25\\t/** Reset the per-call key counter so a test can build deterministic keys. */\\n    26\\texport function resetEventKeyCounter(): void {\\n    27\\t  keyCounter = 0;\\n    28\\t}\\n    29\\t\\n    30\\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\\\"payload\\\"] } = {\\n    31\\t  user_prompt: () => ({ text: \\\"please read the file\\\" }),\\n    32\\t  assistant_text: () => ({ text: \\\"here is what I found\\\" }),\\n    33\\t  assistant_thinking: () => ({ text: \\\"considering the file contents\\\" }),\\n    34\\t  runtime_note: () => ({ text: \\\"model changed: anthropic/claude → openai/gpt\\\" }),\\n    35\\t  tool_call: () => ({ toolCallId: \\\"call-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } }),\\n    36\\t  tool_result: () => ({ toolCallId: \\\"call-1\\\", content: \\\"contents of notes.txt\\\", isError: false }),\\n    37\\t  turn_end: () => ({}),\\n    38\\t};\\n    39\\t\\n    40\\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\\n    41\\t *  mismatch at a call site is a compile error; the final reconciliation goes\\n    42\\t *  through `unknown` (TS can't reduce a structural spread to the deferred\\n    43\\t *  Extract), with call-site safety living in the parameter types. */\\n    44\\texport function validEvent<K extends EventKind>(\\n    45\\t  kind: K,\\n    46\\t  overrides: Partial<Omit<EventByKind<K>, \\\"eventKind\\\">> = {},\\n    47\\t): EventByKind<K> {\\n    48\\t  keyCounter += 1;\\n    49\\t  const base = {\\n    50\\t    eventKind: kind,\\n    51\\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\\n    52\\t    actor: \\\"fixture-actor\\\",\\n    53\\t    harness: \\\"pi\\\",\\n    54\\t    payload: defaultPayloads[kind](),\\n    55\\t  };\\n    56\\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\\n    57\\t}\\n    58\\t\\n    59\\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\\n    60\\t  return kinds.map((kind) => validEvent(kind));\\n    61\\t}\\n    62\\t\\n    63\\t// ── PI message builders ──────────────────────────────────────────────\\n    64\\t\\n    65\\texport function makeUserMessage(text = \\\"please read the file\\\"): UserMessage {\\n    66\\t  return { role: \\\"user\\\", content: [{ type: \\\"text\\\", text }] };\\n    67\\t}\\n    68\\t\\n    69\\texport interface AssistantToolCall {\\n    70\\t  id: string;\\n    71\\t  name: string;\\n    72\\t  arguments?: Record<string, unknown>;\\n    73\\t}\\n    74\\t\\n    75\\t/** Fans out to content parts in PI's confirmed order: thinking → text →\\n    76\\t *  toolCall×N (research §5a). */\\n    77\\texport function makeAssistantMessage(\\n    78\\t  opts: {\\n    79\\t    thinking?: string;\\n    80\\t    text?: string;\\n    81\\t    toolCalls?: AssistantToolCall[];\\n    82\\t    stopReason?: PiStopReason;\\n    83\\t  } = {},\\n    84\\t): AssistantMessage {\\n    85\\t  const content: ContentPart[] = [];\\n    86\\t  if (opts.thinking !== undefined) content.push({ type: \\\"thinking\\\", thinking: opts.thinking });\\n    87\\t  if (opts.text !== undefined) content.push({ type: \\\"text\\\", text: opts.text });\\n    88\\t  for (const call of opts.toolCalls ?? []) {\\n    89\\t    content.push({ type: \\\"toolCall\\\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\\n    90\\t  }\\n    91\\t  const msg: AssistantMessage = { role: \\\"assistant\\\", content };\\n    92\\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\\n    93\\t  return msg;\\n    94\\t}\\n    95\\t\\n    96\\texport function makeToolResult(opts: {\\n    97\\t  id: string;\\n    98\\t  isError?: boolean;\\n    99\\t  content?: string;\\n   100\\t}): ToolResultMessage {\\n   101\\t  const msg: ToolResultMessage = {\\n   102\\t    role: \\\"toolResult\\\",\\n   103\\t    toolCallId: opts.id,\\n   104\\t    content: [{ type: \\\"text\\\", text: opts.content ?? \\\"tool output\\\" }],\\n   105\\t  };\\n   106\\t  if (opts.isError !== undefined) msg.isError = opts.isError;\\n   107\\t  return msg;\\n   108\\t}\\n   109\\t\\n   110\\t// ── PI event-stream builders ─────────────────────────────────────────\\n   111\\t\\n   112\\texport function makeSessionStart(\\n   113\\t  reason: SessionStartReason = \\\"startup\\\",\\n   114\\t  previousSessionFile?: string,\\n   115\\t): SessionStartEvent {\\n   116\\t  const ev: SessionStartEvent = { reason };\\n   117\\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\\n   118\\t  return ev;\\n   119\\t}\\n   120\\t\\n   121\\texport function makeMessageEnd(message: AgentMessage): MessageEndEvent {\\n   122\\t  return { message };\\n   123\\t}\\n   124\\t\\n   125\\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\\n   126\\t  return { messages };\\n   127\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:82:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_39\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/capture/idempotency.test.ts | sed -n '1,180p'\\\"\",\"aggregated_output\":\"     1\\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\\n     2\\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\\n     3\\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\\n     4\\t// must add nothing the second time. The key goldens pin construction precedence:\\n     5\\t// PI entry id → provider response / tool-call id → content fingerprint, with\\n     6\\t// blockIndex and kind disambiguating one message's fan-out.\\n     7\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     8\\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \\\"lhc\\\";\\n     9\\timport { capture } from \\\"../../src/capture/converter.js\\\";\\n    10\\timport { eventKey } from \\\"../../src/capture/idempotency.js\\\";\\n    11\\timport { mapMessage } from \\\"../../src/capture/map-message.js\\\";\\n    12\\timport { TurnAccumulator } from \\\"../../src/capture/turn-accumulator.js\\\";\\n    13\\timport { initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    14\\timport type { AgentMessage } from \\\"../../src/pi/types.js\\\";\\n    15\\timport { loadToolHeavyCorpus } from \\\"../fixtures/corpus.js\\\";\\n    16\\timport { makeTempThread, tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    17\\t\\n    18\\tlet store: TempStore;\\n    19\\tbeforeEach(() => {\\n    20\\t  store = tempStore();\\n    21\\t});\\n    22\\tafterEach(() => {\\n    23\\t  store.cleanup();\\n    24\\t});\\n    25\\t\\n    26\\tdescribe(\\\"Story 2: idempotency key construction (deterministic goldens)\\\", () => {\\n    27\\t  it(\\\"is deterministic: identical input yields an identical key\\\", () => {\\n    28\\t    const input = { piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 0, kind: \\\"assistant_text\\\" } as const;\\n    29\\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\\n    30\\t  });\\n    31\\t\\n    32\\t  it(\\\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\\\", () => {\\n    33\\t    const thinking = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 0, kind: \\\"assistant_thinking\\\" });\\n    34\\t    const text = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 1, kind: \\\"assistant_text\\\" });\\n    35\\t    const textSameBlock = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 0, kind: \\\"assistant_text\\\" });\\n    36\\t    expect(thinking).toContain(\\\"e1\\\");\\n    37\\t    // Same entry, different block → different key (fan-out stays distinct).\\n    38\\t    expect(text).not.toBe(thinking);\\n    39\\t    // Same entry + block, different kind → still distinct.\\n    40\\t    expect(textSameBlock).not.toBe(thinking);\\n    41\\t  });\\n    42\\t\\n    43\\t  it(\\\"falls to the tool-call id when no entry id is present, separating call from result by kind\\\", () => {\\n    44\\t    const call = eventKey({ piSessionId: \\\"s\\\", toolCallId: \\\"call_a\\\", blockIndex: 0, kind: \\\"tool_call\\\" });\\n    45\\t    const result = eventKey({ piSessionId: \\\"s\\\", toolCallId: \\\"call_a\\\", blockIndex: 0, kind: \\\"tool_result\\\" });\\n    46\\t    expect(call).toContain(\\\"call_a\\\");\\n    47\\t    expect(result).toContain(\\\"call_a\\\");\\n    48\\t    expect(call).not.toBe(result);\\n    49\\t  });\\n    50\\t\\n    51\\t  it(\\\"falls to the provider response id below the entry id, above the content fingerprint\\\", () => {\\n    52\\t    const key = eventKey({ piSessionId: \\\"s\\\", responseId: \\\"resp_7\\\", blockIndex: 0, kind: \\\"assistant_text\\\" });\\n    53\\t    expect(key).toContain(\\\"resp_7\\\");\\n    54\\t  });\\n    55\\t\\n    56\\t  it(\\\"falls to a content fingerprint as last resort: same content same key, different content different key\\\", () => {\\n    57\\t    const a = eventKey({ piSessionId: \\\"s\\\", blockIndex: 0, kind: \\\"user_prompt\\\", role: \\\"user\\\", content: \\\"hello\\\" });\\n    58\\t    const aAgain = eventKey({ piSessionId: \\\"s\\\", blockIndex: 0, kind: \\\"user_prompt\\\", role: \\\"user\\\", content: \\\"hello\\\" });\\n    59\\t    const b = eventKey({ piSessionId: \\\"s\\\", blockIndex: 0, kind: \\\"user_prompt\\\", role: \\\"user\\\", content: \\\"world\\\" });\\n    60\\t    expect(aAgain).toBe(a);\\n    61\\t    expect(b).not.toBe(a);\\n    62\\t  });\\n    63\\t\\n    64\\t  it(\\\"honors precedence: a present entry id wins over a present tool-call id\\\", () => {\\n    65\\t    const withBoth = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e9\\\", toolCallId: \\\"call_z\\\", blockIndex: 0, kind: \\\"tool_call\\\" });\\n    66\\t    const entryOnly = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e9\\\", blockIndex: 0, kind: \\\"tool_call\\\" });\\n    67\\t    expect(withBoth).toBe(entryOnly);\\n    68\\t  });\\n    69\\t});\\n    70\\t\\n    71\\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\\n    72\\t  const acc = new TurnAccumulator({ piSessionId: \\\"corpus\\\" });\\n    73\\t  const events: MessageEventInput[] = [];\\n    74\\t  source.forEach((message, index) => {\\n    75\\t    const mapped = mapMessage(message, { piSessionId: \\\"corpus\\\", entryId: `s${index}` });\\n    76\\t    acc.onMessage(mapped);\\n    77\\t    events.push(...mapped);\\n    78\\t  });\\n    79\\t  events.push(...acc.onAgentEnd());\\n    80\\t  return events;\\n    81\\t}\\n    82\\t\\n    83\\tdescribe(\\\"Story 2: corpus double-replay (idempotency architecture-risk)\\\", () => {\\n    84\\t  it(\\\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\\\", async () => {\\n    85\\t    const thread = await makeTempThread(store);\\n    86\\t    const built = await initInstance(thread.threadRef, {\\n    87\\t      provider: createDeterministicProvider(),\\n    88\\t      mode: \\\"background\\\",\\n    89\\t    });\\n    90\\t    expect(built.ok).toBe(true);\\n    91\\t    if (!built.ok) return;\\n    92\\t    const instance = built.value;\\n    93\\t\\n    94\\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\\n    95\\t\\n    96\\t    const first = await capture(batch, instance);\\n    97\\t    expect(first.ok).toBe(true);\\n    98\\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \\\"recorded\\\")).toBe(true);\\n    99\\t\\n   100\\t    const replay = await capture(batch, instance);\\n   101\\t    expect(replay.ok).toBe(true);\\n   102\\t    if (replay.ok) {\\n   103\\t      expect(replay.value.events.every((entry) => entry.outcome === \\\"skipped\\\")).toBe(true);\\n   104\\t    }\\n   105\\t\\n   106\\t    const read = await intakeStream.listEvents(instance.threadRef);\\n   107\\t    expect(read.ok).toBe(true);\\n   108\\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\\n   109\\t\\n   110\\t    await instance.dispose();\\n   111\\t  });\\n   112\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:84:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_40\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/capture/abort.test.ts | sed -n '1,120p'\\\"\",\"aggregated_output\":\"     1\\t// Story 2 — graceful interrupt (TC-2.6). A turn PI marks aborted is captured\\n     2\\t// whole: the partial assistant content is recorded, the aborted disposition is\\n     3\\t// carried through (the mapper carries stopReason — research §5b — onto the only\\n     4\\t// durable vehicle, a runtime_note), and the turn closes complete-but-aborted at\\n     5\\t// agent_end. The interrupted content is never discarded.\\n     6\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     7\\timport type { MessageEventInput } from \\\"lhc\\\";\\n     8\\timport {\\n     9\\t  makeAgentEnd,\\n    10\\t  makeAssistantMessage,\\n    11\\t  makeMessageEnd,\\n    12\\t  makeUserMessage,\\n    13\\t} from \\\"../fixtures/synthetic.js\\\";\\n    14\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    15\\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \\\"./support.js\\\";\\n    16\\t\\n    17\\tlet store: TempStore;\\n    18\\tbeforeEach(() => {\\n    19\\t  store = tempStore();\\n    20\\t});\\n    21\\tafterEach(() => {\\n    22\\t  store.cleanup();\\n    23\\t});\\n    24\\t\\n    25\\tfunction textOf(event: MessageEventInput): string {\\n    26\\t  return (event.payload as { text?: string }).text ?? \\\"\\\";\\n    27\\t}\\n    28\\t\\n    29\\tdescribe(\\\"Story 2: graceful interrupt (TC-2.6)\\\", () => {\\n    30\\t  it(\\\"records partial assistant content, carries the aborted disposition, and closes the turn complete-but-aborted\\\", async () => {\\n    31\\t    const started = await startCapture(store);\\n    32\\t    const { connector, ctx, threadRef } = started;\\n    33\\t\\n    34\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"write a long essay\\\")));\\n    35\\t    await connector.handlers.message_end(\\n    36\\t      ctx,\\n    37\\t      makeMessageEnd(\\n    38\\t        makeAssistantMessage({ thinking: \\\"starting the essay\\\", text: \\\"Once upon a\\\", stopReason: \\\"aborted\\\" }),\\n    39\\t      ),\\n    40\\t    );\\n    41\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    42\\t\\n    43\\t    // A graceful interrupt is not a capture failure.\\n    44\\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\\n    45\\t\\n    46\\t    const events = await eventsAfterShutdown(started);\\n    47\\t    expect(kindsOf(events)).toEqual([\\n    48\\t      \\\"user_prompt\\\",\\n    49\\t      \\\"assistant_thinking\\\",\\n    50\\t      \\\"assistant_text\\\",\\n    51\\t      \\\"runtime_note\\\",\\n    52\\t      \\\"turn_end\\\",\\n    53\\t    ]);\\n    54\\t\\n    55\\t    // Partial content is preserved verbatim — nothing discarded.\\n    56\\t    expect(textOf(events[1]!)).toBe(\\\"starting the essay\\\");\\n    57\\t    expect(textOf(events[2]!)).toBe(\\\"Once upon a\\\");\\n    58\\t    // The aborted disposition is carried through on the runtime_note.\\n    59\\t    expect(textOf(events[3]!).toLowerCase()).toContain(\\\"abort\\\");\\n    60\\t\\n    61\\t    // The turn closes complete-but-aborted (closed at agent_end, not left open).\\n    62\\t    const counts = await turnCounts(threadRef);\\n    63\\t    expect(counts.closed).toBe(1);\\n    64\\t    expect(counts.open).toBe(0);\\n    65\\t  });\\n    66\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:86:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_41\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/pi-lhc/test/capture/support.ts | sed -n '1,180p'\\\"\",\"aggregated_output\":\"     1\\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\\n     2\\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\\n     3\\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\\n     4\\t// converter → real LHC intake) so every capture test asserts on recorded\\n     5\\t// thread state, never on a mocked intake. The two external edges stay as the\\n     6\\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\\n     7\\t// SDK runs real against a temp SQLite thread with the deterministic provider\\n     8\\t// (selected by explicit name, never a production default).\\n     9\\timport {\\n    10\\t  createDeterministicProvider,\\n    11\\t  inspect,\\n    12\\t  intakeStream,\\n    13\\t  type EventKind,\\n    14\\t  type MessageEventInput,\\n    15\\t  type OpResult,\\n    16\\t  type SdkConfig,\\n    17\\t  type ThreadRef,\\n    18\\t} from \\\"lhc\\\";\\n    19\\timport { createConnector, type Connector } from \\\"../../src/index.js\\\";\\n    20\\timport type { LaunchFlags } from \\\"../../src/lifecycle/thread-resolution.js\\\";\\n    21\\timport type { ExtensionContext, SessionStartReason } from \\\"../../src/pi/types.js\\\";\\n    22\\timport { makeSessionStart } from \\\"../fixtures/synthetic.js\\\";\\n    23\\timport type { TempStore } from \\\"../fixtures/thread.js\\\";\\n    24\\t\\n    25\\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\\n    26\\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\\n    27\\t *  assume a TUI. */\\n    28\\texport function syntheticCtx(cwd = \\\"/work/capture\\\"): ExtensionContext {\\n    29\\t  return {\\n    30\\t    cwd,\\n    31\\t    hasUI: false,\\n    32\\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\\n    33\\t    ui: { notify: () => {} },\\n    34\\t    sessionManager: { getEntries: () => [] },\\n    35\\t  };\\n    36\\t}\\n    37\\t\\n    38\\t/** The capture-suite SDK config: a real background instance on the\\n    39\\t *  deterministic provider, so a captured user_prompt's queued derivation has a\\n    40\\t *  handler to settle and never strands background work. */\\n    41\\texport function captureConfig(): OpResult<SdkConfig> {\\n    42\\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \\\"background\\\" } };\\n    43\\t}\\n    44\\t\\n    45\\texport interface StartedCapture {\\n    46\\t  connector: Connector;\\n    47\\t  ctx: ExtensionContext;\\n    48\\t  threadRef: ThreadRef;\\n    49\\t}\\n    50\\t\\n    51\\t/** Start a connector against a temp store under the given launch flags and fire\\n    52\\t *  `session_start{reason}`. The driver for existing-thread reattach: pass\\n    53\\t *  `{ session: threadId }` with reason `\\\"resume\\\"`/`\\\"reload\\\"` to attach a fresh\\n    54\\t *  connector to a thread a prior connector created. */\\n    55\\texport async function attachCapture(\\n    56\\t  store: TempStore,\\n    57\\t  launch: LaunchFlags,\\n    58\\t  reason: SessionStartReason,\\n    59\\t  cwd = \\\"/work/capture\\\",\\n    60\\t): Promise<StartedCapture> {\\n    61\\t  const connector = createConnector({\\n    62\\t    registryPath: store.registryPath,\\n    63\\t    newThreadFilePath: () => store.threadPath(),\\n    64\\t    parseLaunch: () => launch,\\n    65\\t    buildSdkConfig: () => captureConfig(),\\n    66\\t  });\\n    67\\t  const ctx = syntheticCtx(cwd);\\n    68\\t  await connector.handlers.session_start(ctx, makeSessionStart(reason));\\n    69\\t  const state = connector.getState();\\n    70\\t  if (state === null) throw new Error(\\\"attachCapture: session_start did not resolve a thread\\\");\\n    71\\t  return { connector, ctx, threadRef: state.threadRef };\\n    72\\t}\\n    73\\t\\n    74\\t/** Start a connector against a temp store and fire `session_start{new}` so a\\n    75\\t *  background instance + thread exist and the capture hooks are live. */\\n    76\\texport async function startCapture(store: TempStore, cwd = \\\"/work/capture\\\"): Promise<StartedCapture> {\\n    77\\t  return attachCapture(store, {}, \\\"new\\\", cwd);\\n    78\\t}\\n    79\\t\\n    80\\t/** Settle background work and dispose, then read the durable event log back in\\n    81\\t *  recorded order — capture's product is the stored thread, so tests assert on\\n    82\\t *  this. */\\n    83\\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\\n    84\\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \\\"shutdown\\\" });\\n    85\\t  const read = await intakeStream.listEvents(started.threadRef);\\n    86\\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\\n    87\\t  // Strip the server-stamped fields so the comparison is over the logical\\n    88\\t  // intake shape the converter produced.\\n    89\\t  return read.value.map((record) => ({\\n    90\\t    eventKind: record.eventKind,\\n    91\\t    idempotencyKey: record.idempotencyKey,\\n    92\\t    actor: record.actor,\\n    93\\t    harness: record.harness,\\n    94\\t    payload: record.payload,\\n    95\\t  })) as MessageEventInput[];\\n    96\\t}\\n    97\\t\\n    98\\t/** The ordered event-kind sequence — the spine every capture test checks. */\\n    99\\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\\n   100\\t  return events.map((event) => event.eventKind);\\n   101\\t}\\n   102\\t\\n   103\\t/** Counts open/closed turns and total recorded events from the inspect\\n   104\\t *  overview (the real read-back surface, not a private query). */\\n   105\\texport async function turnCounts(\\n   106\\t  threadRef: ThreadRef,\\n   107\\t): Promise<{ open: number; closed: number; events: number }> {\\n   108\\t  const overview = await inspect.overview(threadRef);\\n   109\\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\\n   110\\t  return {\\n   111\\t    open: overview.value.turns.open,\\n   112\\t    closed: overview.value.turns.closed,\\n   113\\t    events: overview.value.events.count,\\n   114\\t  };\\n   115\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:98:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_47\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"node --input-type=module <<'NODE'\\nimport { mkdtempSync, rmSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { createConnector } from './packages/pi-lhc/dist/index.js';\\nimport { createDeterministicProvider, intakeStream } from './packages/lhc/dist/index.js';\\n\\nfunction tempStore(){\\n  const dir=mkdtempSync(join(tmpdir(),'pi-lhc-repro-'));\\n  let i=0;\\n  return {dir, registryPath:join(dir,'registry.sqlite'), threadPath:()=>join(dir,\\\"'`thread-${++i}.sqlite`), cleanup:()=>rmSync(dir,{recursive:true,force:true})};\\n}\\nfunction ctx(){return {cwd:'\\\"'/work/capture',hasUI:false,modelRegistry:{find:()=>undefined,hasConfiguredAuth:()=>false,getAvailable:()=>[]},ui:{notify:()=>{}},sessionManager:{getEntries:()=>[]}};}\\nfunction config(){return {ok:true,value:{provider:createDeterministicProvider(),mode:'background'}};}\\nfunction connector(store, launch){return createConnector({registryPath:store.registryPath,newThreadFilePath:()=>store.threadPath(),parseLaunch:()=>launch,buildSdkConfig:()=>config()});}\\nconst user=(text)=>({role:'user',content:[{type:'text',text}]});\\nconst message_end=(message)=>({message});\\nconst agent_end=()=>({messages:[]});\\n\\nconst store=tempStore();\\ntry{\\n  const a=connector(store,{}); const c1=ctx();\\n  await a.handlers.session_start(c1,{reason:'new'});\\n  const threadRef=a.getState().threadRef; const threadId=threadRef.threadId;\\n  await a.handlers.message_end(c1,message_end(user('first')));\\n  await a.handlers.agent_end(c1,agent_end());\\n  await a.handlers.session_shutdown(c1,{reason:'reload'});\\n\\n  const b=connector(store,{session:threadId}); const c2=ctx();\\n  await b.handlers.session_start(c2,{reason:'reload'});\\n  await b.handlers.message_end(c2,message_end(user('first'))); // redelivered historical event\\n  await b.handlers.agent_end(c2,agent_end());\\n  await b.handlers.session_shutdown(c2,{reason:'shutdown'});\\n\\n  const read=await intakeStream.listEvents(threadRef);\\n  console.log(JSON.stringify({ok:read.ok, count:read.ok?read.value.length:null, kinds:read.ok?read.value.map(e=>e.eventKind):null, texts:read.ok?read.value.map(e=>e.payload?.text??''):null, keys:read.ok?read.value.map(e=>e.idempotencyKey):null, diag:b.snapshot().lastDiagnostic}, null, 2));\\n} finally { store.cleanup(); }\\nNODE\\\"\",\"aggregated_output\":\"(node:49669) ExperimentalWarning: SQLite is an experimental feature and might change at any time\\n(Use `node --trace-warnings ...` to show where the warning was created)\\n{\\n  \\\"ok\\\": true,\\n  \\\"count\\\": 4,\\n  \\\"kinds\\\": [\\n    \\\"user_prompt\\\",\\n    \\\"turn_end\\\",\\n    \\\"user_prompt\\\",\\n    \\\"turn_end\\\"\\n  ],\\n  \\\"texts\\\": [\\n    \\\"first\\\",\\n    \\\"\\\",\\n    \\\"first\\\",\\n    \\\"\\\"\\n  ],\\n  \\\"keys\\\": [\\n    \\\"pi:th_6382323360f599c0:entry:s0:0:user_prompt\\\",\\n    \\\"pi:th_6382323360f599c0:entry:turn:0:0:turn_end\\\",\\n    \\\"pi:th_6382323360f599c0:entry:s2:0:user_prompt\\\",\\n    \\\"pi:th_6382323360f599c0:entry:turn:1:0:turn_end\\\"\\n  ],\\n  \\\"diag\\\": null\\n}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:100:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_48\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,180p' packages/lhc/src/domains/intake-stream/index.ts\\\"\",\"aggregated_output\":\"import type { OpResult } from \\\"../../shared/errors.js\\\";\\nimport type {\\n  WorkKind,\\n  WorkOwner,\\n  WorkSourceRef,\\n} from \\\"../../tech-utils/work-queue/index.js\\\";\\nimport type { ThreadRef } from \\\"../threads/index.js\\\";\\nimport { runListEvents, runMessageEvents } from \\\"./internal/pipeline.js\\\";\\n\\ninterface BaseEvent<K extends string, P> {\\n  eventKind: K;\\n  idempotencyKey: string;\\n  actor: string; // non-empty\\n  harness: string; // non-empty\\n  payload: P; // shape fixed by kind, closed\\n}\\n\\nexport type MessageEventInput =\\n  | BaseEvent<\\\"user_prompt\\\", { text: string }>\\n  | BaseEvent<\\\"assistant_text\\\", { text: string }>\\n  | BaseEvent<\\\"assistant_thinking\\\", { text: string }>\\n  | BaseEvent<\\\"runtime_note\\\", { text: string }>\\n  | BaseEvent<\\n      \\\"tool_call\\\",\\n      { toolCallId: string; toolName: string; arguments: Record<string, unknown> }\\n    >\\n  | BaseEvent<\\\"tool_result\\\", { toolCallId: string; content: string; isError?: boolean }>\\n  | BaseEvent<\\\"turn_end\\\", Record<string, never>>;\\n\\n// Derived, not parallel-maintained: the kind list cannot drift from the union.\\nexport type EventKind = MessageEventInput[\\\"eventKind\\\"];\\n\\nexport interface BatchResult {\\n  events: Array<{\\n    idempotencyKey: string;\\n    outcome: \\\"recorded\\\" | \\\"skipped\\\";\\n    messageId?: string;\\n    skipReason?: \\\"duplicate_idempotency_key\\\";\\n  }>;\\n  turnTransitions: Array<{ action: \\\"opened\\\" | \\\"closed\\\"; turnId: string }>;\\n  queuedWork: Array<{\\n    workItemId: string;\\n    owner: WorkOwner;\\n    kind: WorkKind;\\n    sourceRef: WorkSourceRef;\\n  }>;\\n  threadPosition: { lastEventOrder: number };\\n}\\n\\n// Read-back preserves the discrimination: intersecting the input union with\\n// server fields distributes over its members, so a narrowed eventKind narrows\\n// the payload on read exactly as it does on write.\\nexport type EventRecord = MessageEventInput & {\\n  eventOrder: number;\\n  recordedAt: string;\\n};\\n\\nexport async function messageEvents(\\n  thread: ThreadRef,\\n  events: readonly MessageEventInput[],\\n): Promise<OpResult<BatchResult>> {\\n  return runMessageEvents(thread, events);\\n}\\n\\nexport async function listEvents(\\n  thread: ThreadRef,\\n): Promise<OpResult<EventRecord[]>> {\\n  return runListEvents(thread);\\n}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:104:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_50\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'rg \\\"unsupported|fileRef|image|omitted|runtime_note\\\" packages/pi-lhc/test packages/pi-lhc/src/capture -n'\",\"aggregated_output\":\"packages/pi-lhc/src/capture/converter.ts:9://     record a durable, queryable gap (a `runtime_note`) so nothing is silently\\npackages/pi-lhc/src/capture/converter.ts:44:/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\\npackages/pi-lhc/src/capture/converter.ts:51:    eventKind: \\\"runtime_note\\\",\\npackages/pi-lhc/test/fixtures/synthetic.ts:34:  runtime_note: () => ({ text: \\\"model changed: anthropic/claude → openai/gpt\\\" }),\\npackages/pi-lhc/src/capture/map-message.ts:18:// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\\npackages/pi-lhc/src/capture/map-message.ts:20:// on a trailing `runtime_note` (research §5b).\\npackages/pi-lhc/src/capture/map-message.ts:31: *  the one durable vehicle — a `runtime_note` — rather than discarding it.\\npackages/pi-lhc/src/capture/map-message.ts:36:const EMPTY_MESSAGE_NOTE = \\\"message omitted: no mappable content parts\\\";\\npackages/pi-lhc/src/capture/map-message.ts:52:function unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\\npackages/pi-lhc/src/capture/map-message.ts:54:    (p): p is ImagePart | FileRefPart => p.type === \\\"image\\\" || p.type === \\\"fileRef\\\",\\npackages/pi-lhc/src/capture/map-message.ts:59:  return part.type === \\\"image\\\"\\npackages/pi-lhc/src/capture/map-message.ts:60:    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \\\"\\\"}`\\npackages/pi-lhc/src/capture/map-message.ts:61:    : `unsupported content omitted: file reference (${part.path})`;\\npackages/pi-lhc/src/capture/map-message.ts:85:  kind: \\\"user_prompt\\\" | \\\"assistant_text\\\" | \\\"assistant_thinking\\\" | \\\"runtime_note\\\",\\npackages/pi-lhc/src/capture/map-message.ts:131:  for (const part of unsupportedOf(msg.content)) {\\npackages/pi-lhc/src/capture/map-message.ts:133:    events.push(textEvent(\\\"runtime_note\\\", text, \\\"system\\\", buildKey(ctx, \\\"user\\\", \\\"runtime_note\\\", block, { content: text })));\\npackages/pi-lhc/src/capture/map-message.ts:138:      textEvent(\\\"runtime_note\\\", EMPTY_MESSAGE_NOTE, \\\"system\\\", buildKey(ctx, \\\"user\\\", \\\"runtime_note\\\", block, { content: \\\"empty:user\\\" })),\\npackages/pi-lhc/src/capture/map-message.ts:165:  for (const part of unsupportedOf(msg.content)) {\\npackages/pi-lhc/src/capture/map-message.ts:167:    events.push(textEvent(\\\"runtime_note\\\", text, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: text })));\\npackages/pi-lhc/src/capture/map-message.ts:173:      textEvent(\\\"runtime_note\\\", ABORTED_DISPOSITION_TEXT, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: ABORTED_DISPOSITION_TEXT })),\\npackages/pi-lhc/src/capture/map-message.ts:179:      textEvent(\\\"runtime_note\\\", EMPTY_MESSAGE_NOTE, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: \\\"empty:assistant\\\" })),\\npackages/pi-lhc/src/capture/runtime-changes.ts:5:// AC-2.8: model_select / thinking_level_select hooks → runtime_note events, in\\npackages/pi-lhc/src/capture/runtime-changes.ts:8:// fire. They ride the existing `runtime_note` kind (no new intake kind), with\\npackages/pi-lhc/src/capture/runtime-changes.ts:40:    eventKind: \\\"runtime_note\\\",\\npackages/pi-lhc/src/capture/runtime-changes.ts:45:      kind: \\\"runtime_note\\\",\\npackages/pi-lhc/src/capture/runtime-changes.ts:55:/** One `runtime_note` recording the new + previous model. */\\npackages/pi-lhc/src/capture/runtime-changes.ts:63:/** One `runtime_note` recording the new + previous thinking level. */\\npackages/pi-lhc/test/fixtures/corpus.ts:129:      // The aborted disposition rides a trailing runtime_note (the mapper carries\\npackages/pi-lhc/test/fixtures/corpus.ts:131:      validEvent(\\\"runtime_note\\\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\\npackages/pi-lhc/test/fixtures/corpus.ts:175:  \\\"runtime_note\\\",\\npackages/pi-lhc/test/fixtures/corpus.ts:202:      case \\\"runtime_note\\\": {\\npackages/pi-lhc/test/capture/converter.test.ts:90:  it(\\\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\\\", async () => {\\npackages/pi-lhc/test/capture/converter.test.ts:107:      \\\"runtime_note\\\",\\npackages/pi-lhc/test/capture/converter.test.ts:108:      \\\"runtime_note\\\",\\npackages/pi-lhc/test/capture/converter.test.ts:155:        event.eventKind === \\\"runtime_note\\\" &&\\npackages/pi-lhc/test/capture/abort.test.ts:4:// durable vehicle, a runtime_note), and the turn closes complete-but-aborted at\\npackages/pi-lhc/test/capture/abort.test.ts:51:      \\\"runtime_note\\\",\\npackages/pi-lhc/test/capture/abort.test.ts:58:    // The aborted disposition is carried through on the runtime_note.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/008-verify.stdout.log:110:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_53\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,220p' packages/lhc/src/domains/intake-stream/internal/validate.ts\\\"\",\"aggregated_output\":\"// Flow 4: pure, whole-batch, three-layer closed validation. Strictness falls\\n// out of schema construction: every layer is a closed Effect Schema struct\\n// decoded under onExcessProperty: \\\"error\\\", so unknown-field rejection is a\\n// property of the definitions, not a remembered rule. Validation never touches\\n// a database; a rejected batch costs no write lock.\\nimport { Either, ParseResult, Schema } from \\\"effect\\\";\\nimport type { ErrorResult } from \\\"../../../shared/errors.js\\\";\\n\\nexport const EVENT_KINDS = [\\n  \\\"user_prompt\\\",\\n  \\\"assistant_text\\\",\\n  \\\"assistant_thinking\\\",\\n  \\\"runtime_note\\\",\\n  \\\"tool_call\\\",\\n  \\\"tool_result\\\",\\n  \\\"turn_end\\\",\\n] as const;\\n\\n// Denied by name with their own reason string: the old MVP's\\n// silent-root-field-drop bug class gets named when it appears.\\nconst SERVER_GENERATED_FIELDS = [\\n  \\\"eventOrder\\\",\\n  \\\"recordedAt\\\",\\n  \\\"threadEventId\\\",\\n  \\\"schemaVersion\\\",\\n] as const;\\n\\nconst DECODE_OPTIONS = { onExcessProperty: \\\"error\\\", errors: \\\"first\\\" } as const;\\n\\nconst NonEmptyString = Schema.String.pipe(Schema.minLength(1));\\n\\n// Layer 1 — envelope: thread reference shape, closed.\\nconst ThreadRefSchema = Schema.Union(\\n  Schema.Struct({\\n    threadId: NonEmptyString,\\n    registryPath: Schema.optional(Schema.String),\\n  }),\\n  Schema.Struct({ filePath: NonEmptyString }),\\n);\\n\\n// Layer 2 — event object: the five required fields, closed. payload presence\\n// and shape are layer 3's job (Schema.Unknown keeps the key from reading as\\n// an unexpected field here, and tolerates a missing key — presence is checked\\n// explicitly below).\\nconst EventEnvelopeSchema = Schema.Struct({\\n  eventKind: Schema.Literal(...EVENT_KINDS),\\n  idempotencyKey: NonEmptyString,\\n  actor: NonEmptyString,\\n  harness: NonEmptyString,\\n  payload: Schema.Unknown,\\n});\\n\\n// Layer 3 — per-kind payload, closed. turn_end's empty-payload rule is its\\n// own named check below (a closed Struct({}) admits any object).\\nconst TextPayloadSchema = Schema.Struct({ text: Schema.String });\\nconst ToolCallPayloadSchema = Schema.Struct({\\n  toolCallId: NonEmptyString,\\n  toolName: NonEmptyString,\\n  arguments: Schema.Record({ key: Schema.String, value: Schema.Unknown }),\\n});\\nconst ToolResultPayloadSchema = Schema.Struct({\\n  toolCallId: NonEmptyString,\\n  content: Schema.String,\\n  isError: Schema.optional(Schema.Boolean),\\n});\\n\\nfunction firstIssue(error: ParseResult.ParseError): string {\\n  const issues = ParseResult.ArrayFormatter.formatErrorSync(error);\\n  const issue = issues[0];\\n  if (issue === undefined) return \\\"invalid value\\\";\\n  if (issue.path.length === 0) return issue.message;\\n  return `\\\"${issue.path.join(\\\".\\\")}\\\" ${issue.message}`;\\n}\\n\\nfunction decodeIssue<A, I>(schema: Schema.Schema<A, I, never>, value: unknown): string | undefined {\\n  const decoded = Schema.decodeUnknownEither(schema, DECODE_OPTIONS)(value);\\n  return Either.isLeft(decoded) ? firstIssue(decoded.left) : undefined;\\n}\\n\\nfunction callerError(reason: string, eventIndex?: number): ErrorResult {\\n  const error: ErrorResult = {\\n    errorClass: \\\"caller_error\\\",\\n    code: \\\"invalid_event\\\",\\n    reason,\\n  };\\n  if (eventIndex !== undefined) error.eventIndex = eventIndex;\\n  return error;\\n}\\n\\n// Envelope-level: the thread reference must decode against the closed union.\\n// Returns undefined when valid.\\nexport function validateThreadRef(ref: unknown): ErrorResult | undefined {\\n  const issue = decodeIssue(ThreadRefSchema, ref);\\n  if (issue !== undefined) {\\n    return callerError(`envelope: invalid thread reference — ${issue}`);\\n  }\\n  return undefined;\\n}\\n\\n// Whole-batch validation: array order, first failure wins (AC-4.5). Returns\\n// undefined when every event is valid.\\nexport function validateEvents(events: unknown): ErrorResult | undefined {\\n  if (!Array.isArray(events)) {\\n    return callerError(\\\"envelope: events must be a JSON array\\\");\\n  }\\n  if (events.length === 0) {\\n    return {\\n      errorClass: \\\"caller_error\\\",\\n      code: \\\"empty_batch\\\",\\n      reason: \\\"envelope: events array is empty; a batch must carry at least one event\\\",\\n    };\\n  }\\n  for (const [index, event] of events.entries()) {\\n    const failure = validateOneEvent(event, index);\\n    if (failure !== undefined) return failure;\\n  }\\n  return undefined;\\n}\\n\\nfunction validateOneEvent(event: unknown, index: number): ErrorResult | undefined {\\n  if (typeof event !== \\\"object\\\" || event === null || Array.isArray(event)) {\\n    return callerError(\\\"event: each event must be a JSON object\\\", index);\\n  }\\n  const record = event as Record<string, unknown>;\\n\\n  for (const field of SERVER_GENERATED_FIELDS) {\\n    if (field in record) {\\n      return callerError(\\n        `event: server-generated field \\\"${field}\\\" must not be supplied by the caller`,\\n        index,\\n      );\\n    }\\n  }\\n\\n  const kind = record[\\\"eventKind\\\"];\\n  if (typeof kind === \\\"string\\\" && !(EVENT_KINDS as readonly string[]).includes(kind)) {\\n    return callerError(`event: unknown event kind \\\"${kind}\\\"`, index);\\n  }\\n\\n  const envelope = Schema.decodeUnknownEither(EventEnvelopeSchema, DECODE_OPTIONS)(event);\\n  if (Either.isLeft(envelope)) {\\n    return callerError(`event: ${firstIssue(envelope.left)}`, index);\\n  }\\n\\n  const payload = record[\\\"payload\\\"];\\n  if (typeof payload !== \\\"object\\\" || payload === null || Array.isArray(payload)) {\\n    return callerError(\\\"event: payload must be a JSON object\\\", index);\\n  }\\n\\n  if (envelope.right.eventKind === \\\"turn_end\\\") {\\n    const extraKeys = Object.keys(payload);\\n    if (extraKeys.length > 0) {\\n      return callerError(\\n        `payload: turn_end events carry an empty payload; found field \\\"${extraKeys[0]}\\\"`,\\n        index,\\n      );\\n    }\\n    return undefined;\\n  }\\n\\n  let issue: string | undefined;\\n  switch (envelope.right.eventKind) {\\n    case \\\"tool_call\\\":\\n      issue = decodeIssue(ToolCallPayloadSchema, payload);\\n      break;\\n    case \\\"tool_result\\\":\\n      issue = decodeIssue(ToolResultPayloadSchema, payload);\\n      break;\\n    default:\\n      issue = decodeIssue(TextPayloadSchema, payload);\\n      break;\\n  }\\n  if (issue !== undefined) {\\n    return callerError(`payload: ${issue}`, index);\\n  }\\n  return undefined;\\n}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba docs/specs/02-pi-lhc/01-connector-core/stories/02-event-capture-and-turn-derivation.md'\",\"aggregated_output\":\"     1\\t# Story 2: Event Capture and Turn Derivation\\n     2\\t\\n     3\\t### Summary\\n     4\\t<!-- Jira: Summary field -->\\n     5\\t\\n     6\\tMap finalized PI traffic into ordered, duplicate-safe LHC intake events and derive one LHC turn per user exchange.\\n     7\\t\\n     8\\t### Description\\n     9\\t<!-- Jira: Description field -->\\n    10\\t\\n    11\\t**User Profile:** A developer using PI as their daily coding agent, with the `pi-lhc` extension loaded.\\n    12\\t\\n    13\\t**Objective:** Every finalized PI message lands as ordered LHC intake events exactly once, runtime changes are recorded in order, and LHC turns are derived from PI traffic rather than PI's per-step turn markers.\\n    14\\t\\n    15\\t**Scope In:**\\n    16\\t\\n    17\\t- Productionized converter from PI `message_end` and runtime-selection hooks to LHC `MessageEventInput` events.\\n    18\\t- Assistant content-part fan-out in thinking, text, tool-call order.\\n    19\\t- Parallel tool-call correlation by `toolCallId`.\\n    20\\t- Error-result capture and graceful-interrupt capture.\\n    21\\t- LHC turn derivation from user prompt through agent run completion.\\n    22\\t- Idempotency-keyed dedup for reload and replay.\\n    23\\t- Capture failure isolation: durable gaps when writable, diagnostics when the store is unavailable.\\n    24\\t\\n    25\\t**Scope Out:**\\n    26\\t\\n    27\\t- Corpus replay verification and inspect assertions, owned by Story 3.\\n    28\\t- Fork seeding, owned by Story 4.\\n    29\\t- Derivation routing and assignment validation, owned by Stories 5 and 6.\\n    30\\t- Context serving; PI's native context handling remains unchanged.\\n    31\\t\\n    32\\t**Dependencies:** Story 1.\\n    33\\t\\n    34\\t### Acceptance Criteria\\n    35\\t<!-- Jira: Acceptance Criteria field -->\\n    36\\t\\n    37\\t**AC-2.1:** Every PI message finalized through `message_end` — user, assistant, tool result — is mapped to LHC intake events and recorded in source order. An assistant message fans out to per-content-part events in thinking → text → tool-call order: `assistant_thinking`, `assistant_text`, and one `tool_call` per call.\\n    38\\t\\n    39\\t**TC-2.1** — A user/assistant/toolResult sequence records ordered events; an assistant `[thinking, text, toolCall]` fans out in that order.\\n    40\\t\\n    41\\t**AC-2.2:** LHC turn boundaries are derived from PI traffic, not from PI's per-agent-step `turn_end`. One LHC turn spans a user prompt and all subsequent agent activity until the next user prompt or the end of the agent run. The converter emits exactly one LHC `turn_end` event per LHC turn, at the agent run's completion — never one per PI `turn_end`, and never keyed off PI's per-agent-run `turnIndex` as a session counter.\\n    42\\t\\n    43\\t**TC-2.2** — A one-prompt-two-tools-then-answer corpus (the worked example) yields exactly one LHC turn with one `turn_end` at agent-run completion; PI's per-step `turn_end`s produce none.\\n    44\\t\\n    45\\t**TC-2.3** — Session order derives from converter source-event order, not `turnIndex`; two agent runs each starting at `turnIndex 0` order correctly.\\n    46\\t\\n    47\\t**AC-2.3:** Parallel tool calls are captured with correct correlation: when one assistant message carries multiple `tool_call` parts and their results complete out of arrival order, each `tool_result` event is matched to its call by `toolCallId`, not by arrival order.\\n    48\\t\\n    49\\t**TC-2.4** — Parallel tool calls with out-of-order completion correlate each result to its call by `toolCallId`.\\n    50\\t\\n    51\\t**AC-2.4:** A tool result carrying an error is captured as a `tool_result` event with its error content and an error flag set. No event is dropped because a tool failed.\\n    52\\t\\n    53\\t**TC-2.5** — A tool result with `isError` is captured as a `tool_result` with the error flag and content; nothing dropped.\\n    54\\t\\n    55\\t**AC-2.5:** A graceful interrupt — a complete turn PI marks aborted, with partial assistant content preserved — is captured whole: the partial content is recorded and the aborted disposition is carried through. The interrupted content is not discarded.\\n    56\\t\\n    57\\t**TC-2.6** — A graceful-interrupt corpus records the partial assistant content with the aborted disposition; the turn closes complete-but-aborted.\\n    58\\t\\n    59\\t**AC-2.6:** Capture is duplicate-safe. Re-delivered events (reload, crash-replay) are recognized by idempotency key and skipped rather than recorded twice. On normal resume PI re-delivers no historical events, so duplication only arises on the reload and replay paths.\\n    60\\t\\n    61\\t**TC-2.7** — A re-delivered event (reload/replay) is skipped by idempotency key; a normal resume re-delivers no historical events.\\n    62\\t\\n    63\\t**AC-2.7:** A capture failure does not break the PI session, and does not vanish silently. When the thread is writable, a malformed or unmappable event records a durable, queryable gap that surfaces in thread health. When the thread store itself is unavailable, the failure surfaces as an extension diagnostic / health signal rather than a durable gap (the record cannot be written), and no exception propagates into the PI hook. Either way the session continues, and capture adds no perceptible latency to interactive use.\\n    64\\t\\n    65\\t**TC-2.8** — A malformed/unmappable event on a writable thread records a durable, queryable gap surfaced in health; an unavailable thread store surfaces an extension diagnostic / health signal with no durable gap. Both continue the session with no exception reaching the hook.\\n    66\\t\\n    67\\t**AC-2.8:** Runtime changes that PI fires only in-stream — model selection (`model_select`) and thinking-level selection (`thinking_level_select`) — are captured in order as `runtime_note` events carrying the change (the new model or level, and the previous one). These are recorded at the moment they fire because no durable record holds them otherwise; nothing in this epic consumes them, and their presence in the thread is what lets later epics attribute a turn to the model that produced it.\\n    68\\t\\n    69\\t**TC-2.9** — A `model_select` and a `thinking_level_select` each record an ordered `runtime_note` event carrying the new and previous values; ordering relative to surrounding messages is preserved.\\n    70\\t\\n    71\\t### Technical Design\\n    72\\t<!-- Jira: Technical Notes or sub-section of Description -->\\n    73\\t\\n    74\\t#### Architecture Context\\n    75\\t\\n    76\\tStory 2 owns the converter and the LHC turn derivation rule. Finalized PI traffic becomes ordered LHC intake events, while PI's per-step `turn_end` events are input signals only and never become one LHC turn boundary per step.\\n    77\\t\\n    78\\tThe source of order is the converter's source-event order. This story also owns runtime-change capture, idempotency keys, and capture failure isolation.\\n    79\\t\\n    80\\t#### Build Strategy\\n    81\\t\\n    82\\tStrategy: full-staged-risk\\n    83\\t\\n    84\\tReason:\\n    85\\t- Turn derivation, dedup, and failure isolation are load-bearing mechanics.\\n    86\\t- The implementation must be proven with red goldens before Green because wrong ordering can look superficially plausible.\\n    87\\t\\n    88\\tRisk Reminders:\\n    89\\t- Flow 2 order derives from converter source-event order, not parent id or `turnIndex`.\\n    90\\t- `model_select` and `thinking_level_select` are captured when they fire; no later durable source exists.\\n    91\\t- Unsupported image/file-reference parts must record an omission until M0 settles the final payload shape.\\n    92\\t\\n    93\\t#### Implementation Targets\\n    94\\t\\n    95\\t| Area | Files / Modules |\\n    96\\t|------|-----------------|\\n    97\\t| Converter orchestration | `packages/pi-lhc/src/capture/converter.ts` |\\n    98\\t| Message mapping | `packages/pi-lhc/src/capture/map-message.ts` |\\n    99\\t| Turn derivation | `packages/pi-lhc/src/capture/turn-accumulator.ts` |\\n   100\\t| Idempotency | `packages/pi-lhc/src/capture/idempotency.ts` |\\n   101\\t| Runtime changes | `packages/pi-lhc/src/capture/runtime-changes.ts` |\\n   102\\t| State diagnostics | `packages/pi-lhc/src/lifecycle/state.ts` |\\n   103\\t| Tests | `packages/pi-lhc/test/capture/converter.test.ts`, `packages/pi-lhc/test/capture/turn-derivation.test.ts`, `packages/pi-lhc/test/capture/parallel-and-errors.test.ts`, `packages/pi-lhc/test/capture/abort.test.ts`, `packages/pi-lhc/test/capture/idempotency.test.ts` |\\n   104\\t\\n   105\\t#### Design References\\n   106\\t\\n   107\\t- [epic.md §Flow 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/epic.md:145), lines 145-179\\n   108\\t- [epic.md §PI Event Mapping](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/epic.md:272), lines 272-330\\n   109\\t- [tech-design.md §Module Responsibility Matrix](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:188), lines 188-192\\n   110\\t- [tech-design.md §Flow 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:272), lines 272-329\\n   111\\t- [tech-design.md §Deterministic Algorithm Boundaries](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:573), lines 573-580\\n   112\\t- [tech-design.md §Chunk 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:654), lines 654-656\\n   113\\t- [test-plan.md §Capture Tests](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/test-plan.md:49), lines 49-78\\n   114\\t- [test-plan.md §Chunk 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/test-plan.md:154), lines 154-159\\n   115\\t\\n   116\\t#### Test Mapping\\n   117\\t\\n   118\\t| TC | Test File / Check | Test Description |\\n   119\\t|----|-------------------|------------------|\\n   120\\t| TC-2.1 | `test/capture/converter.test.ts` | User, assistant, and tool-result sequence records in source order; assistant fan-out is thinking, text, then tool calls. |\\n   121\\t| TC-2.2 | `test/capture/turn-derivation.test.ts` | Worked example produces exactly one LHC turn and one `turn_end` at `agent_end`; PI per-step `turn_end`s emit none. |\\n   122\\t| TC-2.3 | `test/capture/turn-derivation.test.ts` | Two agent runs with repeated `turnIndex` values order by converter source-event order without collision. |\\n   123\\t| TC-2.4 | `test/capture/parallel-and-errors.test.ts` | Out-of-order parallel tool results correlate to calls by `toolCallId`. |\\n   124\\t| TC-2.5 | `test/capture/parallel-and-errors.test.ts` | Error tool result records error flag and content; no failed tool output is dropped. |\\n   125\\t| TC-2.6 | `test/capture/abort.test.ts` | Graceful interrupt records partial assistant content, carries aborted disposition, and closes complete-but-aborted. |\\n   126\\t| TC-2.7 | `test/capture/parallel-and-errors.test.ts` | Re-delivered event is skipped by idempotency key; normal resume does not replay historical messages. |\\n   127\\t| TC-2.8 | `test/capture/converter.test.ts` | Writable malformed event records durable gap; unavailable store records state health signal with no hook exception. |\\n   128\\t| TC-2.9 | `test/capture/converter.test.ts` | Model and thinking-level changes become ordered `runtime_note` events with new and previous values. |\\n   129\\t\\n   130\\t#### Architecture-Risk Tests\\n   131\\t\\n   132\\t| Risk | Test File / Check | Test Description | Why AC/TC Mapping Alone Would Miss It |\\n   133\\t|------|-------------------|------------------|---------------------------------------|\\n   134\\t| Idempotency / Retry | `test/capture/idempotency.test.ts` | Replaying the same corpus twice produces no duplicate events; re-delivered keys return `skipped`. | Single-event dedup does not prove reload/replay safety across a corpus. |\\n   135\\t| Atomicity / Isolation | `test/capture/converter.test.ts` | Mid-batch failure records a gap and continues; store-unavailable produces a health signal, not a thread gap. | The product AC says the thread continues; this proves no exception reaches PI's hook and the two failure shapes stay distinct. |\\n   136\\t\\n   137\\t#### Technical Notes\\n   138\\t\\n   139\\t- `map-message.ts` is pure and performs no I/O.\\n   140\\t- `turn-accumulator.ts` owns open-turn state and emits `[turn_end]` only when a turn is open.\\n   141\\t- Idempotency precedence is PI entry id, provider response id or tool-call id, then content fingerprint.\\n   142\\t- Capture uses `intakeStream.messageEvents(threadRef, events)` and relies on SDK duplicate-key behavior.\\n   143\\t\\n   144\\t#### Anti-Shim Requirements\\n   145\\t\\n   146\\t- Do not key turn order from `turnIndex`, parent id, or arrival-order assumptions for parallel tool results.\\n   147\\t- Do not swallow malformed events; writable failures must become durable gaps, and unavailable-store failures must become extension health diagnostics.\\n   148\\t- Do not add new intake event kinds for runtime model/thinking changes in this story; use `runtime_note`.\\n   149\\t\\n   150\\t#### Production Path Proof\\n   151\\t\\n   152\\t- Entrypoint: PI `message_end`, `turn_end`, `agent_end`, `model_select`, and `thinking_level_select` hooks routed through `index.ts`.\\n   153\\t- Registration/default path: hook events call converter/map/runtime-change modules, then batch into `intakeStream.messageEvents`.\\n   154\\t- Evidence: capture tests assert stored events, duplicate skips, no hook exception, and exact turn boundaries through the real LHC intake path.\\n   155\\t\\n   156\\t#### Verification\\n   157\\t\\n   158\\t- Targeted: `pnpm --filter pi-lhc verify -- test/capture`\\n   159\\t- Story gate: `pnpm --filter pi-lhc green-verify`\\n   160\\t- Epic gate: `pnpm --filter pi-lhc verify-all`\\n   161\\t\\n   162\\t#### Spec Deviations\\n   163\\t\\n   164\\tNone.\\n   165\\t\\n   166\\t### Definition of Done\\n   167\\t<!-- Jira: Definition of Done or Acceptance Criteria footer -->\\n   168\\t\\n   169\\t- All Flow 2 ACs and TCs pass.\\n   170\\t- Converter maps all in-scope PI message and runtime-selection events to LHC intake events.\\n   171\\t- One LHC turn is emitted per user exchange, not per PI agent step.\\n   172\\t- Idempotency handles reload and replay without duplicate records.\\n   173\\t- Capture failures are visible and do not break the PI session.\\n   174\\t- No context serving is introduced.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:13:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba docs/specs/02-pi-lhc/01-connector-core/tech-design.md | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t# Epic 1: Connector Core — Tech Design\\n     2\\t\\n     3\\t**Status:** Draft for review\\n     4\\t**Epic:** `epic.md`\\n     5\\t**PRD:** `../00-prd.md` — Feature 1\\n     6\\t**Tech Arch:** `../01-tech-arch.md`\\n     7\\t**Wiring research:** `../notes/pi-ext-integration-research.md` (verified against PI v0.79.2)\\n     8\\t**Test plan:** `test-plan.md`\\n     9\\t\\n    10\\t---\\n    11\\t\\n    12\\t## Spec Validation\\n    13\\t\\n    14\\tThe epic is implementable as written once its named M0 inputs land. Every AC maps to a module and a test; the data contracts match the real surfaces the design calls into (the LHC SDK at `packages/lhc`, the PI extension API at `@earendil-works/pi-coding-agent` v0.79.2, the completion API at `@earendil-works/pi-ai`). The tech-design questions are answered below, and the places where the design takes a position the epic left open are recorded as deviations with rationale.\\n    15\\t\\n    16\\tThe validation that mattered most: the epic's load-bearing claim is that an LHC turn is not a PI turn, and the converter must derive LHC turn boundaries from the agent-run bracket rather than from PI's per-step `turn_end`. The real PI event types confirm the shape the epic relies on — `turn_end` carries a per-agent-run `turnIndex` that resets to 0 each run, and `agent_end` brackets the whole run — so the contract is buildable against types that exist, not against an assumption.\\n    17\\t\\n    18\\t### Issues Found\\n    19\\t\\n    20\\t| # | Type | Issue | Resolution |\\n    21\\t|---|------|-------|------------|\\n    22\\t| I-1 | TDQ-1 (dissolved) | Mapping persistence shape (session file vs sidecar vs both). | **Dissolved — the thread is resolved at launch, not from a stored mapping.** The LHC thread is the system of record and the registry is the catalog; the thread for a run is named by the launch (new / `--session` / `--continue` / `--resume` picker), so there is no PI-session→thread mapping to persist, no early-crash window, and no recovery sidecar. The tech-lead's durability finding is moot: there is no pointer to lose. (PI's own session file still exists in this observe-only epic — PI runs its session normally; it just is not where LHC's thread identity lives.) See Flow 1. |\\n    23\\t| I-2 | TDQ-2 | Fork derived-form reuse — provable-safe copy vs always-requeue. | **Resolved for v1: always requeue.** The new thread is seeded by event replay only; derived forms are not copied across the fork. Reuse is a later optimization gated on a provenance-identity check that does not exist yet. The epic's AC-3.3 permits this (reuse \\\"may\\\" happen; requeue is the correct fallback). Recorded as a deviation — the epic leaves the door open, the design closes it for v1. See Deferred Items. |\\n    24\\t| I-3 | TDQ-3 | `thinkingSignature` / `thoughtSignature` handling. | **Resolved: capture, do not interpret.** Assistant thinking carries an opaque `thinkingSignature`; tool calls carry an opaque `thoughtSignature` (the POC mapper found both). Neither is part of the seven LHC intake payloads, which are text/structured-arg only. The converter records thinking text and tool-call arguments; the signatures are dropped in this epic because nothing in capture or derivation consumes them. Flagged as a deviation: re-injecting signatures is a serving concern (Epic 2), not capture. |\\n    25\\t| I-4 | TDQ-4 (dissolved) | Thread resolution by external key. | **Dissolved.** Resolution is by the launch input (full/partial `threadId`, or a picker selection over `listThreads`), through `threads.resolve` / `threads.resolveThreadRef`. There is no external PI-session key to translate, because the operator names the thread at launch. |\\n    26\\t| I-7 | API mismatch (tech-lead #1) | `appendEntry` is on `pi: ExtensionAPI`, not `ctx: ExtensionContext`. | **Moot for mapping, noted for capture.** The mapping no longer writes a session-file pointer, so the `appendEntry` mismatch in the old `session-mapping` is gone. Where the connector does need registration-time API (hook registration), it takes `pi: ExtensionAPI` at the factory, and per-hook handlers take `ctx`. Interface signatures take `pi` where an `ExtensionAPI` method is needed, `ctx` otherwise. |\\n    27\\t| I-8 | API mismatch (tech-lead #3) | `registryPath` is not a field of `SdkConfig`. | **Resolved.** `registryPath` is removed from `initLhc`/`createSdk` construction. It is a per-operation argument on the `threads` calls (`newThread`, `resolve`, `listThreads`), which is where the real LHC API accepts it. `initLhc` is the rename of `createSdk` and takes `SdkConfig` unchanged. |\\n    28\\t| I-9 | Wording (tech-lead #5) | \\\"no `ctx.ui` surface\\\" — `ExtensionContext.ui` always exists. | **Resolved.** Reporting guards on headless mode (`hasUI:false`), not on the absence of `ctx.ui`. Test and prose wording corrected. |\\n    29\\t| I-10 | Gap fill | Runtime metadata: model/thinking changes, cwd, foreign-extension state. | **Resolved per epic A-8/A-9.** Model-select and thinking-level-select are captured as `runtime_note` events (AC-2.8, in-stream-only). cwd is stored on the registry row at thread creation and scopes the `--resume` picker. The full PI-runtime-state restoration inventory is an Epic 2 prerequisite (tech arch). Foreign-extension session persistence is out of scope v1 (epic A-9). |\\n    30\\t| I-5 | TDQ-5 | Converter structure — how it consumes `message_end` and emits batched `MessageEventInput[]`. | **Resolved.** The converter is two pure stages plus one stateful accumulator: `mapMessage` (one PI `AgentMessage` → ordered `MessageEventInput[]`, no I/O) and `deriveTurnClose` (decides when to emit `turn_end`), driven by a per-session `TurnAccumulator` that tracks the open LHC turn across `message_end`/`agent_end`. Batches flush through `intakeStream.messageEvents(threadRef, events)`. See Flow 2 design. |\\n    31\\t| I-6 | Deviation | Epic A-7 names image/file-reference handling an M0 decision. | **Design position pending M0, with a safe fallback specified.** The current LHC intake schema has no image/file payload kind beyond text/runtime-note material. Until M0 chooses placeholder vs. schema extension, unsupported content parts degrade to a `runtime_note` event recording the omission (never silent drop). If M0 extends the intake schema, the converter gains kinds; the degrade-to-`runtime_note` path remains the fallback for unsupported parts. This unblocks implementation planning without pre-empting the M0 call. |\\n    32\\t\\n    33\\t---\\n    34\\t\\n    35\\t## Context\\n    36\\t\\n    37\\tThis epic builds the first real consumer of the LHC SDK. Until now LHC has been exercised by its own test harness and a deterministic provider; here it gets wired to a live coding agent whose event stream it does not control. The whole epic is observe-only by deliberate construction — the extension records everything PI does and changes nothing the model sees — because that constraint is what lets capture correctness be proven before any context-serving risk is introduced. PI's native context handling stays in charge throughout. The reward for the discipline is that every test in this epic asserts on recorded thread state, never on what a model received.\\n    38\\t\\n    39\\tThe shape of the work is set by two systems that already exist and are not being changed. PI fires lifecycle hooks (`session_start`, `message_end`, `turn_end`, `agent_end`, `session_shutdown`, fork/switch) and an extension subscribes to them; this is a fixed, versioned contract verified against v0.79.2 by live recon. The LHC SDK is constructed once per session (`initLhc`, the agreed rename of the current `createSdk`), exposes operation surfaces (`intakeStream`, `threads`, `inspect`, the background work scheduler), and persists one SQLite file per thread. The connector is the tissue between them: it translates PI's events into LHC intake operations, and translates LHC's need for inference back into PI's authenticated model registry. It owns no context state of its own beyond a thread reference and a few told-the-user flags, because PI tears down and replaces its session objects on every new/resume/fork transition, and a cached reference to one of those objects is a latent crash.\\n    40\\t\\n    41\\tThree forces shaped the central decisions. First, **PI's turn is not LHC's turn** — PI brackets each agent step with `turn_start`/`turn_end` and resets `turnIndex` to 0 per agent run, while an LHC turn spans a whole exchange. The converter must derive LHC turn boundaries from the agent-run bracket (`agent_end`), and the recon that established this is the reason the epic could be written without guessing. Second, **capture must never break the session** — malformed input on a writable thread degrades to a recorded, queryable gap; store-unavailable failures degrade to extension-level health diagnostics; neither throws back into a PI hook. Third, **derivations must close the loop on the user's own logins** — LHC asks for completions through a single host-supplied function that resolves provider/model through PI's registry, so there is no second credential store and no separate login.\\n    42\\t\\n    43\\tOne framing decision underlies the whole lifecycle: **the LHC thread is the system of record for the conversation, and the registry is the catalog.** The thread for a run is resolved at launch from the operator's choice (a new thread, the `--resume` picker, `--continue`, or a named `--session` id), the same way PI's own launch flags work. This dissolves what an earlier draft treated as a hard problem — keeping a PI-session→thread mapping durable across an early crash — because the launch choice *is* the thread identity, so there is nothing to recover. A scoping note that matters for the rest of this design: this epic is observe-only, so **PI still runs its own session** — it persists its session, serves its own context to the model, and tracks its own fork tree. LHC records alongside as the durable record. PI's session file becomes vestigial in Feature 2, when LHC's served context replaces PI's transcript; in Epic 1 the two coexist.\\n    44\\t\\n    45\\tThe connector also inherits a body of prior art. A POC extension (`src/context-steward/pi/`, ~3,900 lines across the mapper, the parallel-event intake, and the extension shell) already solved much of the hard mapping — idempotency-key construction, parallel-tool correlation, unsupported-part degradation — against an older LHC storage API. This epic productionizes that logic against the current, leaner SDK surface (plain-string `actor`/`harness`, per-event `idempotencyKey`, the seven-kind `MessageEventInput` union), so the converter is a rewrite informed by the POC, not a port of it. The POC's stale-context handling, by contrast, dies here: the tech arch's plain-data-only rule replaces it.\\n    46\\t\\n    47\\t---\\n    48\\t\\n    49\\t## System View\\n    50\\t\\n    51\\tAt the highest altitude the connector sits between two systems it does not own and one durable store it drives. PI is upstream — it produces the event stream and owns provider auth. The LHC SDK is the engine — it owns capture, projection, derivation scheduling, and persistence. The thread's SQLite file is the durable record that survives the process. The connector is the only component that speaks both PI's hook vocabulary and LHC's operation vocabulary, and it is the only place the PI-session-id ↔ LHC-thread-id translation lives.\\n    52\\t\\n    53\\t```mermaid\\n    54\\tflowchart LR\\n    55\\t  subgraph PI[\\\"PI process\\\"]\\n    56\\t    H[\\\"hook surface\\\\nsession_start, message_end,\\\\nturn_end, agent_end, shutdown, fork\\\"]\\n    57\\t    MR[\\\"modelRegistry + auth\\\"]\\n    58\\t  end\\n    59\\t  subgraph EXT[\\\"pi-lhc extension (in-process)\\\"]\\n    60\\t    L[\\\"lifecycle\\\"]\\n    61\\t    C[\\\"converter\\\"]\\n    62\\t    I[\\\"inference host\\\"]\\n    63\\t    V[\\\"startup validation\\\"]\\n    64\\t  end\\n    65\\t  subgraph LHC[\\\"LHC SDK (in-process)\\\"]\\n    66\\t    IS[\\\"intakeStream\\\"]\\n    67\\t    TH[\\\"threads\\\"]\\n    68\\t    SCH[\\\"background scheduler\\\"]\\n    69\\t    INS[\\\"inspect\\\"]\\n    70\\t    DB[(\\\"thread.sqlite\\\")]\\n    71\\t  end\\n    72\\t  H --> L\\n    73\\t  H --> C\\n    74\\t  C --> IS\\n    75\\t  L --> TH\\n    76\\t  IS --> DB\\n    77\\t  TH --> DB\\n    78\\t  SCH --> I\\n    79\\t  I --> MR\\n    80\\t  V --> MR\\n    81\\t  INS --> DB\\n    82\\t```\\n    83\\t\\n    84\\tThe boundaries that matter for testing are the two edges the connector does not own: the **PI hook surface** (events arrive; the design feeds them from recorded corpora and synthetic builders) and the **`ModelCall` function** as it reaches PI's `modelRegistry` + `complete` (the design supplies a deterministic fake). Everything inside the LHC box runs real against a temp SQLite file, because persistence, reattach, replay, and fork are the product contract — mocking the store would prove nothing about the behaviors this epic exists to guarantee.\\n    85\\t\\n    86\\t### External Contracts\\n    87\\t\\n    88\\t**Incoming — PI hooks consumed** (shapes verified against `@earendil-works/pi-coding-agent` v0.79.2):\\n    89\\t\\n    90\\t| Hook | Payload (relevant fields) | Connector use |\\n    91\\t|------|---------------------------|---------------|\\n    92\\t| `session_start` | `reason: \\\"startup\\\"\\\\|\\\"reload\\\"\\\\|\\\"new\\\"\\\\|\\\"resume\\\"\\\\|\\\"fork\\\"`, `previousSessionFile?` | Resolve or create the thread; reattach; trigger startup validation |\\n    93\\t| `message_end` | `message: AgentMessage` (user / assistant / toolResult) | Map to `MessageEventInput[]`, batch into intake |\\n    94\\t| `turn_end` | `turnIndex` (per-agent-run), `message`, `toolResults[]`, `stopReason` | Update accumulator; **never** a 1:1 LHC `turn_end` |\\n    95\\t| `agent_end` | the agent run's messages | Close the open LHC turn — emit one LHC `turn_end` |\\n    96\\t| `model_select` | `model`, `previousModel`, `source` | Capture as a `runtime_note` event (AC-2.8) |\\n    97\\t| `thinking_level_select` | `level`, `previousLevel` | Capture as a `runtime_note` event (AC-2.8) |\\n    98\\t| `session_before_fork` | `entryId`, `position` | Capture the fork point for replay-seeding |\\n    99\\t| `session_before_switch` | switch intent (`new`/`resume`) | Flush + dispose before the swap |\\n   100\\t| `session_shutdown` | `reason`, `targetSessionFile?` | Dispose the instance with flush |\\n   101\\t\\n   102\\t**Outgoing — LHC SDK operations called** (shapes from `packages/lhc/src`):\\n   103\\t\\n   104\\t| Surface | Operation | Used for |\\n   105\\t|---------|-----------|----------|\\n   106\\t| construction | `initLhc(config: SdkConfig)` — `{ inference, mode: \\\"background\\\", view, ... }`; `registryPath` is **not** a construction field | One instance per session |\\n   107\\t| `threads` | `newThread({ filePath, title?, cwd?, registryPath? })`, `resolve({ threadId, registryPath? })`, `listThreads({ cwd?, registryPath? })`, `resolveThreadRef`, `info` | Launch resolution: create / pick / continue / named |\\n   108\\t| `intakeStream` | `messageEvents(threadRef, MessageEventInput[])` → `BatchResult` | Record capture; dedup by idempotency key |\\n   109\\t| scheduler | `mode: \\\"background\\\"` (auto-drain), `drainSettled(ref)` | Derivations run; awaited only in the closed-loop test |\\n   110\\t| `inspect` | overview / health reads | Capture verification, gap/failure surfacing |\\n   111\\t\\n   112\\t**Outgoing — inference, through PI:** the host-supplied `ModelCall` resolves `(provider, model)` via `ctx.modelRegistry.find(provider, model)` and completes via `complete(model, context, options)` from `@earendil-works/pi-ai`, returning `Promise<AssistantMessage>`.\\n   113\\t\\n   114\\t**Error contract** (machine-readable, what callers program against):\\n   115\\t\\n   116\\t| Source | Condition | Shape the connector produces |\\n   117\\t|--------|-----------|------------------------------|\\n   118\\t| Capture | malformed/unmappable event, thread writable | `OpResult` error recorded as a thread gap, surfaced in `inspect` health |\\n   119\\t| Capture | thread store unavailable | extension diagnostic / health signal; no hook exception |\\n   120\\t| ModelCall | auth / invalid request | `{ ok: false, kind: \\\"auth\\\" \\\\| \\\"invalid_request\\\" }` (terminal) |\\n   121\\t| ModelCall | rate limit / timeout / network | `{ ok: false, kind: \\\"rate_limit\\\" \\\\| \\\"timeout\\\" \\\\| \\\"network\\\" }` (retryable) |\\n   122\\t| ModelCall | thrown exception | `{ ok: false, kind: \\\"other\\\" }` |\\n   123\\t| ModelCall adapter (LHC) | resolved but no text | `kind: \\\"empty_output\\\"` — generated by LHC's adapter, never returned by the host function |\\n   124\\t\\n   125\\t---\\n   126\\t\\n   127\\t## Module Boundaries\\n   128\\t\\n   129\\t### Top-Tier Surfaces\\n   130\\t\\n   131\\tThe tech arch names five top-tier surfaces for the whole `pi-lhc` extension. This epic touches three; the other two are out of scope and named so the boundary is explicit.\\n   132\\t\\n   133\\t| Surface | This epic | What lands here |\\n   134\\t|---------|-----------|-----------------|\\n   135\\t| Session Lifecycle | **Yes** | Instance construction/disposal, launch-driven thread resolution, reload re-resolution, fork detection |\\n   136\\t| Event Capture | **Yes** | The converter (message mapping, turn derivation, batching, dedup), capture-failure isolation, capture verification |\\n   137\\t| Inference Host | **Yes** | The `ModelCall` implementation, assignment config, startup validation |\\n   138\\t| Context Serving | No (Epic 2) | The `context` hook and thread-view serving are not registered in this epic |\\n   139\\t| Surfaces (operator/agent) | No (Epic 3) | Commands and self-inspection tools beyond what verification reads |\\n   140\\t\\n   141\\tAll modules below nest within one of the three active surfaces. The package is a fresh scaffold (`packages/pi-lhc/` currently holds only `package.json`), so every module is NEW; the only EXISTS dependencies are the `lhc` workspace package and the PI/pi-ai packages.\\n   142\\t\\n   143\\t### Module Architecture\\n   144\\t\\n   145\\t```\\n   146\\tpackages/pi-lhc/\\n   147\\t  src/\\n   148\\t    index.ts                       NEW  extension entry — registers hooks, owns nothing else\\n   149\\t    lifecycle/\\n   150\\t      instance.ts                  NEW  initLhc construct/dispose; background mode\\n   151\\t      thread-resolution.ts         NEW  launch flags → registry (new / --session / --continue / --resume); partial-id match\\n   152\\t      picker.ts                    NEW  --resume cwd-scoped thread list + selection (thin pi-lhc UI)\\n   153\\t      state.ts                     NEW  the plain-data-only holder { threadRef, flags, health } (no PI objects)\\n   154\\t      fork.ts                      NEW  fork detection (session_before_fork hook; PI session tree as Epic-1 fallback) + replay seeding\\n   155\\t    capture/\\n   156\\t      converter.ts                 NEW  orchestrates map → accumulate → batch flush\\n   157\\t      map-message.ts               NEW  pure: AgentMessage → MessageEventInput[]\\n   158\\t      turn-accumulator.ts          NEW  open-turn state; deriveTurnClose\\n   159\\t      idempotency.ts               NEW  pure: stable per-event key construction\\n   160\\t    inference/\\n   161\\t      model-call.ts                NEW  ModelCall over modelRegistry + complete; failure classification\\n   162\\t      assignments.ts               NEW  config load + shape validation (the seven kinds)\\n   163\\t      startup-validation.ts        NEW  registry existence + auth-availability probe; reporting (ctx.ui/headless)\\n   164\\t    verify/\\n   165\\t      replay.ts                    NEW  corpus → converter → thread; read-back compare (test-facing)\\n   166\\t  test/\\n   167\\t    fixtures/\\n   168\\t      corpus.ts                    NEW  recorded-corpus loader (M0 fixtures)\\n   169\\t      synthetic.ts                 NEW  synthetic AgentMessage / event builders\\n   170\\t      model-call.ts                NEW  deterministic ModelCall fakes (text / each failure kind)\\n   171\\t    ...                            NEW  per-chunk test files (see test-plan.md)\\n   172\\t```\\n   173\\t\\n   174\\tThe two mock boundaries are explicit in the tree: `test/fixtures/corpus.ts` + `synthetic.ts` feed the PI hook edge, and `test/fixtures/model-call.ts` supplies the inference edge. No module under `src/` is mocked by another module under `src/` — the converter is tested through the capture entry point against a real temp thread, not in isolation with a mocked intake.\\n   175\\t\\n   176\\t### Module Responsibility Matrix\\n   177\\t\\n   178\\tThis is the rosetta stone: every AC has a home, and every module names the ACs it carries. If an AC is not here, it has no owner.\\n   179\\t\\n   180\\t| Module | Status | Responsibility | Depends on | ACs |\\n   181\\t|--------|--------|----------------|-----------|-----|\\n   182\\t| `index.ts` | NEW | Register hook handlers; route each hook to lifecycle/capture/inference; hold no state | all `src/` modules | (wiring) |\\n   183\\t| `lifecycle/instance.ts` | NEW | `initLhc` in background mode on start; dispose with flush on shutdown; reconstruct on reload | `lhc` | AC-1.1, AC-1.4, AC-1.5 |\\n   184\\t| `lifecycle/thread-resolution.ts` | NEW | Launch flags → registry resolution (new / `--session` full+partial / `--continue` most-recent); reload reconstructs from resolved id; unresolvable id fails loud | `lhc` threads | AC-1.2, AC-1.5, AC-1.6 |\\n   185\\t| `lifecycle/picker.ts` | NEW | `--resume` cwd-scoped thread list (title + created) and selection | `lhc` threads (`listThreads`) | AC-1.7 |\\n   186\\t| `lifecycle/state.ts` | NEW | Plain-data-only holder and extension diagnostics; never caches a PI context/session object across hooks | — | AC-1.3, AC-2.7 |\\n   187\\t| `lifecycle/fork.ts` | NEW | Detect fork from `session_before_fork` hook (PI session tree as Epic-1 fallback); new thread; replay-seed to fork point; never write source | `lhc` threads, capture | AC-3.1, AC-3.2, AC-3.3 |\\n   188\\t| `capture/converter.ts` | NEW | Orchestrate map→accumulate→batch; isolate capture failure to a gap/health signal | map-message, turn-accumulator, `lhc` intakeStream | AC-2.1, AC-2.7 |\\n   189\\t| `capture/map-message.ts` | NEW | Pure map of one `AgentMessage` to ordered events; fan-out; parallel-tool correlation; error-result; abort; unsupported→runtime_note | idempotency | AC-2.1, AC-2.3, AC-2.4, AC-2.5 |\\n   190\\t| `capture/turn-accumulator.ts` | NEW | Track the open LHC turn; emit exactly one `turn_end` at `agent_end`; ignore per-step PI `turn_end` | — | AC-2.2 |\\n   191\\t| `capture/runtime-changes.ts` | NEW | Map `model_select` / `thinking_level_select` hooks to ordered `runtime_note` events (new + previous value) | `lhc` intakeStream | AC-2.8 |\\n   192\\t| `capture/idempotency.ts` | NEW | Construct a stable key per event so re-delivery dedups | — | AC-2.6 |\\n   193\\t| `inference/model-call.ts` | NEW | Resolve (provider,model) via registry; complete; classify failures; multi-lane | PI modelRegistry, pi-ai | AC-4.1, AC-4.2, AC-4.3, AC-4.4 |\\n   194\\t| `inference/assignments.ts` | NEW | Load seven assignments from config; fail loud on missing/unknown/placeholder; override on next start | — | AC-5.4, AC-5.5 |\\n   195\\t| `inference/startup-validation.ts` | NEW | Probe each assignment with `modelRegistry.find(provider, model)` for existence and `hasConfiguredAuth(model)` / `getAvailable()` membership for configured auth; report unknown and not-logged-in lanes through `ctx.ui`/headless diagnostics; leave capture running | PI modelRegistry | AC-5.1, AC-5.2, AC-5.3 |\\n   196\\t| `verify/replay.ts` | NEW | Replay a corpus through the converter; compare read-back; deterministic | converter, `lhc` inspect | AC-6.1, AC-6.2 |\\n   197\\t| (closed-loop, in `model-call` + scheduler) | NEW | Captured thread's queued derivation invokes the function and records an outcome | `lhc` scheduler, inspect | AC-4.5 |\\n   198\\t| `inspect` reads (via `lhc`) | EXISTS | Surface counts, position, gaps, failures | `lhc` inspect | AC-6.3 |\\n   199\\t\\n   200\\t### Component Interaction\\n   201\\t\\n   202\\t```mermaid\\n   203\\tsequenceDiagram\\n   204\\t  participant PI\\n   205\\t  participant IDX as index.ts\\n   206\\t  participant LC as lifecycle\\n   207\\t  participant CV as converter\\n   208\\t  participant IS as lhc.intakeStream\\n   209\\t  participant SCH as lhc scheduler\\n   210\\t  participant MC as model-call\\n   211\\t  PI->>IDX: session_start\\n   212\\t  IDX->>LC: resolve/create thread, initLhc(background)\\n   213\\t  PI->>IDX: message_end / turn_end / agent_end\\n   214\\t  IDX->>CV: map + accumulate\\n   215\\t  CV->>IS: messageEvents(threadRef, events)\\n   216\\t  Note over SCH: background scheduler drains on its own\\n   217\\t  SCH->>MC: ModelCall(provider, model, messages)\\n   218\\t  MC->>PI: modelRegistry.find + complete\\n   219\\t  PI->>IDX: session_shutdown\\n   220\\t  IDX->>LC: dispose(flush)\\n   221\\t```\\n   222\\t\\n   223\\t---\\n   224\\t\\n   225\\t## Flow-by-Flow Design\\n   226\\t\\n   227\\tEach flow below opens with the context that makes its mechanics make sense, then a sequence diagram annotated with the ACs it satisfies, then a skeleton-requirements table and the TC approaches. The depth is uneven on purpose: turn derivation, idempotency, reattach, the inference adapter, and fork-replay carry the design's risk and get the most room; thread creation and config loading are mechanical and get less.\\n   228\\t\\n   229\\t### Flow 1: Session Lifecycle and Launch-Driven Thread Resolution\\n   230\\t\\n   231\\tA session starts and the connector must answer one question before anything else: which thread does this run record into? The answer comes from the launch, not from a recovered pointer — the LHC thread is the system of record and the registry resolves it from the operator's choice. No thread-selecting flag means a new thread (registered with its cwd). `--session <id>` resolves a named thread by full or partial id. `--continue`/`-c` resolves the most recently created thread. `--resume`/`-r` lists the cwd's threads and resolves the operator's pick. The connector then constructs the LHC instance in background scheduler mode against the resolved thread; derivations drain on their own and the connector never drives the queue.\\n   232\\t\\n   233\\tBecause the thread id is an input to the run, there is nothing to keep durable across an early crash and no two records that can disagree — the failure mode an earlier draft tried to insure against (a session-file pointer lost before flush) does not exist. An unresolvable `--session` id is an error, reported actionably; it never silently creates a new thread.\\n   234\\t\\n   235\\tThe plain-data-only rule is enforced structurally here. The connector's only retained state is a `{ threadRef, flags }` holder. It never stores a PI `ctx` or session-manager object between hooks, because PI replaces those objects on new/resume/fork and a stale reference is a crash waiting for the next transition. Each handler uses the fresh `ctx` PI passes it.\\n   236\\t\\n   237\\t```mermaid\\n   238\\tsequenceDiagram\\n   239\\t  participant OP as operator (launch)\\n   240\\t  participant LC as lifecycle\\n   241\\t  participant TH as lhc.threads + registry\\n   242\\t  OP->>LC: session_start (launch flags)\\n   243\\t  alt no flag\\n   244\\t    LC->>TH: newThread(filePath, cwd, title)\\n   245\\t    Note over LC,TH: AC-1.1 new thread, background mode\\n   246\\t  else --session id\\n   247\\t    LC->>TH: resolve(id, partial match)\\n   248\\t    Note over LC,TH: AC-1.6 named, fails loud if unresolvable\\n   249\\t  else --continue\\n   250\\t    LC->>TH: resolve most recent\\n   251\\t  else --resume / -r\\n   252\\t    LC->>TH: listThreads(cwd) — picker — resolve(id)\\n   253\\t    Note over LC,TH: AC-1.7 cwd-scoped, titled\\n   254\\t  end\\n   255\\t  Note over LC: holds only threadRef and flags — AC-1.3\\n   256\\t  OP->>LC: session_shutdown\\n   257\\t  LC->>TH: dispose(flush)\\n   258\\t  Note over LC: AC-1.4 complete through last event\\n   259\\t```\\n   260\\t\\n   261\\t**Skeleton requirements:**\\n   262\\t\\n   263\\t| What | Where | Stub signature | Stub semantics |\\n   264\\t|------|-------|----------------|----------------|\\n   265\\t| Construct/dispose | `lifecycle/instance.ts` | `initInstance(threadRef, config): Promise<Instance>` / `dispose(): Promise<void>` | structured result; throws nothing into hook |\\n   266\\t| Resolve thread from launch | `lifecycle/thread-resolution.ts` | `resolveThread(launch: LaunchFlags, pi: ExtensionAPI): Promise<OpResult<ThreadRef>>` | registry resolve/create by mode; partial-id match; loud on unresolvable; structured `OpResult` |\\n   267\\t| Resume picker | `lifecycle/picker.ts` | `pickThread(cwd: string): Promise<OpResult<ThreadRef \\\\| null>>` | cwd-scoped `listThreads`; selection; `null` on empty |\\n   268\\t| State holder | `lifecycle/state.ts` | `class SessionState { threadRef; flags }` | plain data; no PI refs |\\n   269\\t\\n   270\\tTC approaches (TC-1.1…TC-1.5) live in `test-plan.md`; each asserts on observable thread/mapping state through a real temp thread, with the lifecycle entry point driven by synthetic `session_start`/`shutdown` events. The reattach test (TC-1.5) reconstructs from the durable record after discarding the in-memory holder — the architecture-risk test for restart survival.\\n   271\\t\\n   272\\t### Flow 2: Event Capture and Turn Derivation\\n   273\\t\\n   274\\tThis is the densest flow and the one the epic was written to get right. Each finalized PI message becomes an ordered run of LHC intake events; the subtlety is entirely in turns. PI emits `turn_start`/`turn_end` per agent step and resets `turnIndex` to 0 at the start of each agent run, so an agent run that takes three steps emits three PI turns. An LHC turn is the whole exchange — the user prompt and every step the agent took until the next prompt. The converter therefore ignores PI's per-step `turn_end` as a boundary signal and closes the LHC turn at `agent_end`.\\n   275\\t\\n   276\\tThe converter is three pieces. `map-message.ts` is pure: it takes one `AgentMessage` and returns the ordered events for it — a user message becomes one `user_prompt`; an assistant message fans out to `assistant_thinking` (if present), then `assistant_text` (if present), then one `tool_call` per call, in that order; a tool result becomes one `tool_result` correlated to its call by `toolCallId`, carrying `isError` when the tool failed. `turn-accumulator.ts` holds the open-turn state and decides when to emit the single `turn_end`. `converter.ts` orchestrates, batches the events, and flushes them through `intakeStream.messageEvents`, isolating failures so writable-thread failures become recorded gaps and store-unavailable failures become extension diagnostics rather than thrown exceptions.\\n   277\\t\\n   278\\tA worked example anchors the contract. The user asks one question that triggers two parallel tool calls, then gets a final answer:\\n   279\\t\\n   280\\t```\\n   281\\tPI emits:                              converter emits (one LHC turn):\\n   282\\t  turn_start(0)                          user_prompt\\n   283\\t  message_end(user [text])               assistant_thinking\\n   284\\t  message_end(assistant                  tool_call (id=a)\\n   285\\t    [thinking, toolCall a, toolCall b])  tool_call (id=b)\\n   286\\t  message_end(toolResult b)              tool_result (id=b)\\n   287\\t  message_end(toolResult a)              tool_result (id=a)\\n   288\\t  turn_end(0)        <- ignored          assistant_text\\n   289\\t  turn_start(1)                          turn_end          <- at agent_end\\n   290\\t  message_end(assistant [text])\\n   291\\t  turn_end(1)        <- ignored\\n   292\\t  agent_end          <- closes turn\\n   293\\t```\\n   294\\t\\n   295\\tThe two tool results arrive in the order `b` then `a`, and each correlates to its call by id, not by arrival order — the parallel-tool contract (AC-2.3). PI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` fires at `agent_end`. Session order derives from converter source-event order, never from `turnIndex`.\\n   296\\t\\n   297\\t```mermaid\\n   298\\tsequenceDiagram\\n   299\\t  participant PI\\n   300\\t  participant CV as converter\\n   301\\t  participant TA as turn-accumulator\\n   302\\t  participant IS as lhc.intakeStream\\n   303\\t  PI->>CV: message_end(user)\\n   304\\t  CV->>TA: open turn\\n   305\\t  CV->>IS: [user_prompt]\\n   306\\t  Note over CV,IS: AC-2.1 ordered fan-out\\n   307\\t  PI->>CV: message_end(assistant [thinking,toolCall×2])\\n   308\\t  CV->>IS: [assistant_thinking, tool_call, tool_call]\\n   309\\t  PI->>CV: message_end(toolResult) ×2 (out of order)\\n   310\\t  CV->>IS: [tool_result, tool_result] correlated by id\\n   311\\t  Note over CV,IS: AC-2.3 parallel correlation, AC-2.4 error flag\\n   312\\t  PI->>CV: turn_end ×N\\n   313\\t  Note over TA: ignored as boundary — AC-2.2\\n   314\\t  PI->>CV: agent_end\\n   315\\t  CV->>TA: close turn\\n   316\\t  CV->>IS: [turn_end]\\n   317\\t  Note over CV,IS: AC-2.6 dedup by idempotency key — AC-2.7 failure to gap\\n   318\\t```\\n   319\\t\\n   320\\t**Skeleton requirements:**\\n   321\\t\\n   322\\t| What | Where | Stub signature | Stub semantics |\\n   323\\t|------|-------|----------------|----------------|\\n   324\\t| Map one message | `capture/map-message.ts` | `mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[]` | pure; `NotImplementedError` until Green |\\n   325\\t| Turn accumulation | `capture/turn-accumulator.ts` | `class TurnAccumulator { onMessage(); onAgentEnd(): MessageEventInput[] }` | pure state machine |\\n   326\\t| Idempotency key | `capture/idempotency.ts` | `eventKey(parts): string` | pure; deterministic |\\n   327\\t| Orchestrate + flush | `capture/converter.ts` | `capture(events, instance): Promise<OpResult<BatchResult>>` | structured result; isolates failure |\\n   328\\t\\n   329\\tThe idempotency key gets real depth because dedup correctness (AC-2.6) and crash-replay both depend on it. Construction precedence, carried from the POC and adapted to the SDK's per-event-key field: PI entry id when present (`pi:<session>:<entryId>:<block>:<kind>`), else provider `responseId` (assistant) or `toolCallId` (tool result), else a `role:timestamp:content-hash` fallback. The contract is that the key is identical across re-delivery of the same logical event and distinct across different events; the SDK's `messageEvents` returns `skipped` with `skipReason: duplicate_idempotency_key` for a re-delivered key, which is the dedup mechanism the test asserts against.\\n   330\\t\\n   331\\t### Flow 3: Fork as New Thread\\n   332\\t\\n   333\\tA fork produces a new LHC thread seeded by replay, and never writes the source. Detection does not depend on a `session_start` fork reason: recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present. In Epic 1, PI still runs its own session, so PI's session tree (the `parentId` chain) is available as additional fork evidence when the hook is absent. This is an Epic-1 convenience, not the permanent design: the long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial), so the design must not harden PI's session tree into a permanent dependency.\\n   334\\t\\n   335\\tSeeding replays the source thread's recorded events up to the fork point into the new thread, through the same intake path normal capture uses, so the seeded read-back matches the source's read-back through that point. Derived forms are not copied (I-2): the new thread's derivations requeue and drain in the background. The source thread receives no writes — verified by logical read-back equality, not byte-equality, because SQLite page churn can change bytes without changing content.\\n   336\\t\\n   337\\t```mermaid\\n   338\\tsequenceDiagram\\n   339\\t  participant PI\\n   340\\t  participant FK as fork\\n   341\\t  participant TH as lhc.threads\\n   342\\t  participant CV as converter\\n   343\\t  PI->>FK: session_start (fork point via hook, PI tree as Epic-1 fallback)\\n   344\\t  FK->>TH: newThread(forkFilePath)\\n   345\\t  FK->>CV: replay source events → fork point\\n   346\\t  CV->>TH: messageEvents(newThread, seeded events)\\n   347\\t  Note over FK,TH: AC-3.1 source unwritten — AC-3.2 read-back matches — AC-3.3 forms requeue\\n   348\\t```\\n   349\\t\\n   350\\t**Skeleton requirements:**\\n   351\\t\\n   352\\t| What | Where | Stub signature | Stub semantics |\\n   353\\t|------|-------|----------------|----------------|\\n   354\\t| Detect fork + point | `lifecycle/fork.ts` | `detectFork(ctx): ForkInfo \\\\| null` | reads `session_before_fork` hook; PI session tree as Epic-1 fallback |\\n   355\\t| Seed by replay | `lifecycle/fork.ts` | `seedFork(source, target, forkPoint): Promise<OpResult>` | structured result |\\n   356\\t\\n   357\\t### Flow 4: Inference Host Routing\\n   358\\t\\n   359\\tLHC needs completions for its derivations and must get them through the user's existing PI auth, with no second login. The connector supplies one function at construction; LHC calls it with a `(provider, model)` pair and a single-turn message list and treats both strings as opaque routing keys. The function resolves the pair with `ctx.modelRegistry.find(provider, model)` and completes with pi-ai's `complete(model, context)`, returning the assistant text or a classified failure. Different derivation kinds can carry different pairs in the same session; the function routes each by its keys without interpreting them.\\n   360\\t\\n   361\\tClassification is the adapter-boundary contract and gets depth because it is where a runtime failure becomes a designed error code. A resolved completion with text returns `{ ok: true, text }`. Auth failure and invalid request are terminal (`\\\"auth\\\"`, `\\\"invalid_request\\\"`); rate-limit, timeout, and network are retryable (`\\\"rate_limit\\\"`, `\\\"timeout\\\"`, `\\\"network\\\"`); a thrown exception classifies as `\\\"other\\\"`. The host function never returns `\\\"empty_output\\\"` — that kind is generated by LHC's own adapter when a call resolves with no text — so the function returns text-or-transport-failure only, and the no-text case surfaces as the LHC-side `empty_output`.\\n   362\\t\\n   363\\tAC-4.5 closes the loop end to end and is why this flow depends on captured content (Story 2), not just an instance. A captured thread's queued derivation work runs through the background scheduler, invokes the supplied function, and persists either a ready derived form or a classified failure, queryable through inspect/health. This is the PRD's M1 \\\"confirm derivations land\\\" gate — it proves capture → derivation → recorded outcome, not just the function in isolation. The test drives a captured thread, wires a deterministic function (one returning text, one returning a failure), awaits `drainSettled`, and asserts both a ready form and a classified failure exist in the thread.\\n   364\\t\\n   365\\t```mermaid\\n   366\\tsequenceDiagram\\n   367\\t  participant SCH as lhc scheduler\\n   368\\t  participant MC as model-call\\n   369\\t  participant REG as PI modelRegistry\\n   370\\t  participant AI as pi-ai complete\\n   371\\t  SCH->>MC: ModelCall (provider, model, messages)\\n   372\\t  MC->>REG: find(provider, model)\\n   373\\t  alt model found + authed\\n   374\\t    MC->>AI: complete(model, context)\\n   375\\t    AI-->>MC: AssistantMessage (text / stopReason)\\n   376\\t    MC-->>SCH: ok+text or classified failure\\n   377\\t    Note over MC,SCH: AC-4.1 route, AC-4.3 classify\\n   378\\t  else not found / no auth\\n   379\\t    MC-->>SCH: failure kind auth or invalid_request\\n   380\\t  end\\n   381\\t  Note over SCH: AC-4.5 derivation persists ready form / failure\\n   382\\t```\\n   383\\t\\n   384\\t**Skeleton requirements:**\\n   385\\t\\n   386\\t| What | Where | Stub signature | Stub semantics |\\n   387\\t|------|-------|----------------|----------------|\\n   388\\t| The function | `inference/model-call.ts` | `createModelCall(ctx): ModelCall` | returns `{ok,text}`/`{ok:false,kind}` |\\n   389\\t| Classify | `inference/model-call.ts` | `classifyFailure(err): ModelCallFailureKind` | pure mapping |\\n   390\\t\\n   391\\t### Flow 5: Startup Validation and Assignment Config\\n   392\\t\\n   393\\tBefore any derivation runs, the connector checks that all seven assignments point at lanes PI can actually reach, so a misconfiguration surfaces up front rather than as a derivation failure later. Two layers do two different jobs, and conflating them would be wrong. The SDK already validates assignment *shape* at construction — all seven kinds present, non-empty provider/model, prompt-name registered — and throws if not; that is `assignments.ts`'s \\\"fail loud\\\" (AC-5.5), and it is enforced by LHC, not re-implemented here. The connector adds a *reachability* probe on top: for each assignment, first call `ctx.modelRegistry.find(provider, model)` to distinguish an unknown provider/model from a known lane, then check configured auth with `ctx.modelRegistry.hasConfiguredAuth(model)` or equivalent `getAvailable()` membership. Unknown lanes report a config/assignment fix; known-but-unauthed lanes report a login/auth fix. OAuth freshness is still verified at runtime by the model-call path and classified as a derivation failure if the token is stale.\\n   394\\t\\n   395\\tReporting must not assume a TUI. The report uses PI's UI surface (`ctx.ui.notify` when available) and always records the same structured diagnostic in `SessionState.health`; headless modes emit the diagnostic through the headless-appropriate log/output channel. A validation failure leaves capture running — the two concerns are independent — and the affected lane's derivations fail classified and queryable through health (AC-5.3). Assignments load from config; an override of any kind's provider, model, or prompt takes effect on the next session start with no code change.\\n   396\\t\\n   397\\t**Skeleton requirements:**\\n   398\\t\\n   399\\t| What | Where | Stub signature | Stub semantics |\\n   400\\t|------|-------|----------------|----------------|\\n   401\\t| Load + shape-validate | `inference/assignments.ts` | `loadAssignments(config): Record<FormKind, ModelAssignment>` | throws on missing/unknown/placeholder |\\n   402\\t| Reachability probe | `inference/startup-validation.ts` | `validateReachable(assignments, ctx): ValidationReport` | structured report |\\n   403\\t| Report | `inference/startup-validation.ts` | `report(r, ctx, state): void` | `ctx.ui` when available; structured state diagnostic always |\\n   404\\t\\n   405\\t### Flow 6: Capture Verification\\n   406\\t\\n   407\\tBecause the epic is observe-only, capture correctness is proven without serving anything to a model. `verify/replay.ts` replays a recorded corpus through the converter into a temp thread and compares the resulting read-back — events, messages, turns — against the fixture's expectation. The same corpus replayed twice yields identical read-back, because the converter's mapping and the SDK's deterministic IDs make replay reproducible (AC-6.2). The corpora are the M0 fixtures (chatty, tool-heavy, parallel-tool, error-result, aborted-turn); until M0 delivers breadth, the machinery builds against whatever corpora exist and widens as they arrive. inspect's overview and health reads report event/message counts, last recorded position, and any capture gaps or failed derivations (AC-6.3).\\n   408\\t\\n   409\\t**Skeleton requirements:**\\n   410\\t\\n   411\\t| What | Where | Stub signature | Stub semantics |\\n   412\\t|------|-------|----------------|----------------|\\n   413\\t| Replay + compare | `verify/replay.ts` | `replayCorpus(corpus, threadRef): Promise<ReplayResult>` | structured compare result |\\n   414\\t\\n   415\\t---\\n   416\\t\\n   417\\t## Interface Definitions\\n   418\\t\\n   419\\tThese are copy-paste targets for the foundation chunk. Types reference the ACs they serve; signatures are complete (no `any`, no TODO). The LHC-side types (`MessageEventInput`, `ModelCall`, `ModelAssignment`, `FormKind`, `ThreadRef`, `OpResult`) are imported from the `lhc` package, not redefined — the connector consumes them.\\n   420\\t\\n   421\\t```typescript\\n   422\\t// lifecycle/state.ts — AC-1.3: plain data only, never a PI object\\n   423\\texport interface SessionState {\\n   424\\t  threadRef: ThreadRef;          // from lhc\\n   425\\t  flags: {\\n   426\\t    startupValidationReported: boolean;\\n   427\\t    [k: string]: boolean;\\n   428\\t  };\\n   429\\t  health: {\\n   430\\t    lastCaptureFailure?: CaptureFailureDiagnostic;\\n   431\\t    startupValidation?: ValidationReport;\\n   432\\t  };\\n   433\\t}\\n   434\\t\\n   435\\texport interface CaptureFailureDiagnostic {\\n   436\\t  code: string;\\n   437\\t  eventKey?: string;\\n   438\\t  message: string;\\n   439\\t  recordedGap: boolean;\\n   440\\t}\\n   441\\t\\n   442\\t// lifecycle/thread-resolution.ts — AC-1.2, 1.5, 1.6\\n   443\\t// Launch flags name the thread; the registry resolves it. (PI's own session file\\n   444\\t// still exists in this observe-only epic; it is just not where thread identity lives.)\\n   445\\texport interface LaunchFlags {\\n   446\\t  resume?: boolean;        // --resume / -r : cwd-scoped picker\\n   447\\t  continue?: boolean;      // --continue / -c : most recent\\n   448\\t  session?: string;        // --session <id> : full or partial id\\n   449\\t  // none set → new thread\\n   450\\t}\\n   451\\texport function resolveThread(\\n   452\\t  launch: LaunchFlags, pi: ExtensionAPI,\\n   453\\t): Promise<OpResult<ThreadRef>>; // unresolvable --session id → error, never a silent new thread\\n   454\\t\\n   455\\t// lifecycle/picker.ts — AC-1.7\\n   456\\texport function pickThread(cwd: string): Promise<OpResult<ThreadRef | null>>; // null on empty list\\n   457\\t\\n   458\\t// capture/map-message.ts — AC-2.1, 2.3, 2.4, 2.5\\n   459\\texport interface MapCtx { piSessionId: string; entryId?: string; }\\n   460\\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[];\\n   461\\t\\n   462\\t// capture/runtime-changes.ts — AC-2.8\\n   463\\t// model_select / thinking_level_select hooks → runtime_note events, in order.\\n   464\\texport function mapModelSelect(\\n   465\\t  ev: { model: { provider: string; id: string }; previousModel?: { provider: string; id: string } },\\n   466\\t  ctx: MapCtx,\\n   467\\t): MessageEventInput; // one runtime_note recording new + previous model\\n   468\\texport function mapThinkingLevelSelect(\\n   469\\t  ev: { level: string; previousLevel: string }, ctx: MapCtx,\\n   470\\t): MessageEventInput; // one runtime_note recording new + previous level\\n   471\\t\\n   472\\t// capture/turn-accumulator.ts — AC-2.2\\n   473\\texport class TurnAccumulator {\\n   474\\t  onMessage(events: MessageEventInput[]): void;\\n   475\\t  onAgentEnd(): MessageEventInput[]; // returns [turn_end] when a turn is open, else []\\n   476\\t  hasOpenTurn(): boolean;\\n   477\\t}\\n   478\\t\\n   479\\t// capture/idempotency.ts — AC-2.6\\n   480\\texport function eventKey(input: {\\n   481\\t  piSessionId: string; entryId?: string; responseId?: string;\\n   482\\t  toolCallId?: string; blockIndex: number; kind: MessageEventInput[\\\"eventKind\\\"];\\n   483\\t  role?: string; timestamp?: number; content?: string;\\n   484\\t}): string;\\n   485\\t\\n   486\\t// capture/converter.ts — AC-2.1, 2.7\\n   487\\texport function capture(\\n   488\\t  events: MessageEventInput[],\\n   489\\t  instance: LhcInstance,\\n   490\\t): Promise<OpResult<BatchResult>>;\\n   491\\t\\n   492\\t// inference/model-call.ts — AC-4.1..4.4\\n   493\\texport function createModelCall(ctx: ExtensionContext): ModelCall; // ModelCall from lhc\\n   494\\texport function classifyFailure(err: unknown): ModelCallFailureKind;\\n   495\\t\\n   496\\t// inference/assignments.ts — AC-5.4, 5.5\\n   497\\texport function loadAssignments(\\n   498\\t  config: unknown,\\n   499\\t): Record<FormKind, ModelAssignment>; // throws on missing/unknown/placeholder\\n   500\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:19:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba docs/specs/02-pi-lhc/01-connector-core/tech-design.md | sed -n '251,500p'\\\"\",\"aggregated_output\":\"   251\\t  else --resume / -r\\n   252\\t    LC->>TH: listThreads(cwd) — picker — resolve(id)\\n   253\\t    Note over LC,TH: AC-1.7 cwd-scoped, titled\\n   254\\t  end\\n   255\\t  Note over LC: holds only threadRef and flags — AC-1.3\\n   256\\t  OP->>LC: session_shutdown\\n   257\\t  LC->>TH: dispose(flush)\\n   258\\t  Note over LC: AC-1.4 complete through last event\\n   259\\t```\\n   260\\t\\n   261\\t**Skeleton requirements:**\\n   262\\t\\n   263\\t| What | Where | Stub signature | Stub semantics |\\n   264\\t|------|-------|----------------|----------------|\\n   265\\t| Construct/dispose | `lifecycle/instance.ts` | `initInstance(threadRef, config): Promise<Instance>` / `dispose(): Promise<void>` | structured result; throws nothing into hook |\\n   266\\t| Resolve thread from launch | `lifecycle/thread-resolution.ts` | `resolveThread(launch: LaunchFlags, pi: ExtensionAPI): Promise<OpResult<ThreadRef>>` | registry resolve/create by mode; partial-id match; loud on unresolvable; structured `OpResult` |\\n   267\\t| Resume picker | `lifecycle/picker.ts` | `pickThread(cwd: string): Promise<OpResult<ThreadRef \\\\| null>>` | cwd-scoped `listThreads`; selection; `null` on empty |\\n   268\\t| State holder | `lifecycle/state.ts` | `class SessionState { threadRef; flags }` | plain data; no PI refs |\\n   269\\t\\n   270\\tTC approaches (TC-1.1…TC-1.5) live in `test-plan.md`; each asserts on observable thread/mapping state through a real temp thread, with the lifecycle entry point driven by synthetic `session_start`/`shutdown` events. The reattach test (TC-1.5) reconstructs from the durable record after discarding the in-memory holder — the architecture-risk test for restart survival.\\n   271\\t\\n   272\\t### Flow 2: Event Capture and Turn Derivation\\n   273\\t\\n   274\\tThis is the densest flow and the one the epic was written to get right. Each finalized PI message becomes an ordered run of LHC intake events; the subtlety is entirely in turns. PI emits `turn_start`/`turn_end` per agent step and resets `turnIndex` to 0 at the start of each agent run, so an agent run that takes three steps emits three PI turns. An LHC turn is the whole exchange — the user prompt and every step the agent took until the next prompt. The converter therefore ignores PI's per-step `turn_end` as a boundary signal and closes the LHC turn at `agent_end`.\\n   275\\t\\n   276\\tThe converter is three pieces. `map-message.ts` is pure: it takes one `AgentMessage` and returns the ordered events for it — a user message becomes one `user_prompt`; an assistant message fans out to `assistant_thinking` (if present), then `assistant_text` (if present), then one `tool_call` per call, in that order; a tool result becomes one `tool_result` correlated to its call by `toolCallId`, carrying `isError` when the tool failed. `turn-accumulator.ts` holds the open-turn state and decides when to emit the single `turn_end`. `converter.ts` orchestrates, batches the events, and flushes them through `intakeStream.messageEvents`, isolating failures so writable-thread failures become recorded gaps and store-unavailable failures become extension diagnostics rather than thrown exceptions.\\n   277\\t\\n   278\\tA worked example anchors the contract. The user asks one question that triggers two parallel tool calls, then gets a final answer:\\n   279\\t\\n   280\\t```\\n   281\\tPI emits:                              converter emits (one LHC turn):\\n   282\\t  turn_start(0)                          user_prompt\\n   283\\t  message_end(user [text])               assistant_thinking\\n   284\\t  message_end(assistant                  tool_call (id=a)\\n   285\\t    [thinking, toolCall a, toolCall b])  tool_call (id=b)\\n   286\\t  message_end(toolResult b)              tool_result (id=b)\\n   287\\t  message_end(toolResult a)              tool_result (id=a)\\n   288\\t  turn_end(0)        <- ignored          assistant_text\\n   289\\t  turn_start(1)                          turn_end          <- at agent_end\\n   290\\t  message_end(assistant [text])\\n   291\\t  turn_end(1)        <- ignored\\n   292\\t  agent_end          <- closes turn\\n   293\\t```\\n   294\\t\\n   295\\tThe two tool results arrive in the order `b` then `a`, and each correlates to its call by id, not by arrival order — the parallel-tool contract (AC-2.3). PI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` fires at `agent_end`. Session order derives from converter source-event order, never from `turnIndex`.\\n   296\\t\\n   297\\t```mermaid\\n   298\\tsequenceDiagram\\n   299\\t  participant PI\\n   300\\t  participant CV as converter\\n   301\\t  participant TA as turn-accumulator\\n   302\\t  participant IS as lhc.intakeStream\\n   303\\t  PI->>CV: message_end(user)\\n   304\\t  CV->>TA: open turn\\n   305\\t  CV->>IS: [user_prompt]\\n   306\\t  Note over CV,IS: AC-2.1 ordered fan-out\\n   307\\t  PI->>CV: message_end(assistant [thinking,toolCall×2])\\n   308\\t  CV->>IS: [assistant_thinking, tool_call, tool_call]\\n   309\\t  PI->>CV: message_end(toolResult) ×2 (out of order)\\n   310\\t  CV->>IS: [tool_result, tool_result] correlated by id\\n   311\\t  Note over CV,IS: AC-2.3 parallel correlation, AC-2.4 error flag\\n   312\\t  PI->>CV: turn_end ×N\\n   313\\t  Note over TA: ignored as boundary — AC-2.2\\n   314\\t  PI->>CV: agent_end\\n   315\\t  CV->>TA: close turn\\n   316\\t  CV->>IS: [turn_end]\\n   317\\t  Note over CV,IS: AC-2.6 dedup by idempotency key — AC-2.7 failure to gap\\n   318\\t```\\n   319\\t\\n   320\\t**Skeleton requirements:**\\n   321\\t\\n   322\\t| What | Where | Stub signature | Stub semantics |\\n   323\\t|------|-------|----------------|----------------|\\n   324\\t| Map one message | `capture/map-message.ts` | `mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[]` | pure; `NotImplementedError` until Green |\\n   325\\t| Turn accumulation | `capture/turn-accumulator.ts` | `class TurnAccumulator { onMessage(); onAgentEnd(): MessageEventInput[] }` | pure state machine |\\n   326\\t| Idempotency key | `capture/idempotency.ts` | `eventKey(parts): string` | pure; deterministic |\\n   327\\t| Orchestrate + flush | `capture/converter.ts` | `capture(events, instance): Promise<OpResult<BatchResult>>` | structured result; isolates failure |\\n   328\\t\\n   329\\tThe idempotency key gets real depth because dedup correctness (AC-2.6) and crash-replay both depend on it. Construction precedence, carried from the POC and adapted to the SDK's per-event-key field: PI entry id when present (`pi:<session>:<entryId>:<block>:<kind>`), else provider `responseId` (assistant) or `toolCallId` (tool result), else a `role:timestamp:content-hash` fallback. The contract is that the key is identical across re-delivery of the same logical event and distinct across different events; the SDK's `messageEvents` returns `skipped` with `skipReason: duplicate_idempotency_key` for a re-delivered key, which is the dedup mechanism the test asserts against.\\n   330\\t\\n   331\\t### Flow 3: Fork as New Thread\\n   332\\t\\n   333\\tA fork produces a new LHC thread seeded by replay, and never writes the source. Detection does not depend on a `session_start` fork reason: recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present. In Epic 1, PI still runs its own session, so PI's session tree (the `parentId` chain) is available as additional fork evidence when the hook is absent. This is an Epic-1 convenience, not the permanent design: the long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial), so the design must not harden PI's session tree into a permanent dependency.\\n   334\\t\\n   335\\tSeeding replays the source thread's recorded events up to the fork point into the new thread, through the same intake path normal capture uses, so the seeded read-back matches the source's read-back through that point. Derived forms are not copied (I-2): the new thread's derivations requeue and drain in the background. The source thread receives no writes — verified by logical read-back equality, not byte-equality, because SQLite page churn can change bytes without changing content.\\n   336\\t\\n   337\\t```mermaid\\n   338\\tsequenceDiagram\\n   339\\t  participant PI\\n   340\\t  participant FK as fork\\n   341\\t  participant TH as lhc.threads\\n   342\\t  participant CV as converter\\n   343\\t  PI->>FK: session_start (fork point via hook, PI tree as Epic-1 fallback)\\n   344\\t  FK->>TH: newThread(forkFilePath)\\n   345\\t  FK->>CV: replay source events → fork point\\n   346\\t  CV->>TH: messageEvents(newThread, seeded events)\\n   347\\t  Note over FK,TH: AC-3.1 source unwritten — AC-3.2 read-back matches — AC-3.3 forms requeue\\n   348\\t```\\n   349\\t\\n   350\\t**Skeleton requirements:**\\n   351\\t\\n   352\\t| What | Where | Stub signature | Stub semantics |\\n   353\\t|------|-------|----------------|----------------|\\n   354\\t| Detect fork + point | `lifecycle/fork.ts` | `detectFork(ctx): ForkInfo \\\\| null` | reads `session_before_fork` hook; PI session tree as Epic-1 fallback |\\n   355\\t| Seed by replay | `lifecycle/fork.ts` | `seedFork(source, target, forkPoint): Promise<OpResult>` | structured result |\\n   356\\t\\n   357\\t### Flow 4: Inference Host Routing\\n   358\\t\\n   359\\tLHC needs completions for its derivations and must get them through the user's existing PI auth, with no second login. The connector supplies one function at construction; LHC calls it with a `(provider, model)` pair and a single-turn message list and treats both strings as opaque routing keys. The function resolves the pair with `ctx.modelRegistry.find(provider, model)` and completes with pi-ai's `complete(model, context)`, returning the assistant text or a classified failure. Different derivation kinds can carry different pairs in the same session; the function routes each by its keys without interpreting them.\\n   360\\t\\n   361\\tClassification is the adapter-boundary contract and gets depth because it is where a runtime failure becomes a designed error code. A resolved completion with text returns `{ ok: true, text }`. Auth failure and invalid request are terminal (`\\\"auth\\\"`, `\\\"invalid_request\\\"`); rate-limit, timeout, and network are retryable (`\\\"rate_limit\\\"`, `\\\"timeout\\\"`, `\\\"network\\\"`); a thrown exception classifies as `\\\"other\\\"`. The host function never returns `\\\"empty_output\\\"` — that kind is generated by LHC's own adapter when a call resolves with no text — so the function returns text-or-transport-failure only, and the no-text case surfaces as the LHC-side `empty_output`.\\n   362\\t\\n   363\\tAC-4.5 closes the loop end to end and is why this flow depends on captured content (Story 2), not just an instance. A captured thread's queued derivation work runs through the background scheduler, invokes the supplied function, and persists either a ready derived form or a classified failure, queryable through inspect/health. This is the PRD's M1 \\\"confirm derivations land\\\" gate — it proves capture → derivation → recorded outcome, not just the function in isolation. The test drives a captured thread, wires a deterministic function (one returning text, one returning a failure), awaits `drainSettled`, and asserts both a ready form and a classified failure exist in the thread.\\n   364\\t\\n   365\\t```mermaid\\n   366\\tsequenceDiagram\\n   367\\t  participant SCH as lhc scheduler\\n   368\\t  participant MC as model-call\\n   369\\t  participant REG as PI modelRegistry\\n   370\\t  participant AI as pi-ai complete\\n   371\\t  SCH->>MC: ModelCall (provider, model, messages)\\n   372\\t  MC->>REG: find(provider, model)\\n   373\\t  alt model found + authed\\n   374\\t    MC->>AI: complete(model, context)\\n   375\\t    AI-->>MC: AssistantMessage (text / stopReason)\\n   376\\t    MC-->>SCH: ok+text or classified failure\\n   377\\t    Note over MC,SCH: AC-4.1 route, AC-4.3 classify\\n   378\\t  else not found / no auth\\n   379\\t    MC-->>SCH: failure kind auth or invalid_request\\n   380\\t  end\\n   381\\t  Note over SCH: AC-4.5 derivation persists ready form / failure\\n   382\\t```\\n   383\\t\\n   384\\t**Skeleton requirements:**\\n   385\\t\\n   386\\t| What | Where | Stub signature | Stub semantics |\\n   387\\t|------|-------|----------------|----------------|\\n   388\\t| The function | `inference/model-call.ts` | `createModelCall(ctx): ModelCall` | returns `{ok,text}`/`{ok:false,kind}` |\\n   389\\t| Classify | `inference/model-call.ts` | `classifyFailure(err): ModelCallFailureKind` | pure mapping |\\n   390\\t\\n   391\\t### Flow 5: Startup Validation and Assignment Config\\n   392\\t\\n   393\\tBefore any derivation runs, the connector checks that all seven assignments point at lanes PI can actually reach, so a misconfiguration surfaces up front rather than as a derivation failure later. Two layers do two different jobs, and conflating them would be wrong. The SDK already validates assignment *shape* at construction — all seven kinds present, non-empty provider/model, prompt-name registered — and throws if not; that is `assignments.ts`'s \\\"fail loud\\\" (AC-5.5), and it is enforced by LHC, not re-implemented here. The connector adds a *reachability* probe on top: for each assignment, first call `ctx.modelRegistry.find(provider, model)` to distinguish an unknown provider/model from a known lane, then check configured auth with `ctx.modelRegistry.hasConfiguredAuth(model)` or equivalent `getAvailable()` membership. Unknown lanes report a config/assignment fix; known-but-unauthed lanes report a login/auth fix. OAuth freshness is still verified at runtime by the model-call path and classified as a derivation failure if the token is stale.\\n   394\\t\\n   395\\tReporting must not assume a TUI. The report uses PI's UI surface (`ctx.ui.notify` when available) and always records the same structured diagnostic in `SessionState.health`; headless modes emit the diagnostic through the headless-appropriate log/output channel. A validation failure leaves capture running — the two concerns are independent — and the affected lane's derivations fail classified and queryable through health (AC-5.3). Assignments load from config; an override of any kind's provider, model, or prompt takes effect on the next session start with no code change.\\n   396\\t\\n   397\\t**Skeleton requirements:**\\n   398\\t\\n   399\\t| What | Where | Stub signature | Stub semantics |\\n   400\\t|------|-------|----------------|----------------|\\n   401\\t| Load + shape-validate | `inference/assignments.ts` | `loadAssignments(config): Record<FormKind, ModelAssignment>` | throws on missing/unknown/placeholder |\\n   402\\t| Reachability probe | `inference/startup-validation.ts` | `validateReachable(assignments, ctx): ValidationReport` | structured report |\\n   403\\t| Report | `inference/startup-validation.ts` | `report(r, ctx, state): void` | `ctx.ui` when available; structured state diagnostic always |\\n   404\\t\\n   405\\t### Flow 6: Capture Verification\\n   406\\t\\n   407\\tBecause the epic is observe-only, capture correctness is proven without serving anything to a model. `verify/replay.ts` replays a recorded corpus through the converter into a temp thread and compares the resulting read-back — events, messages, turns — against the fixture's expectation. The same corpus replayed twice yields identical read-back, because the converter's mapping and the SDK's deterministic IDs make replay reproducible (AC-6.2). The corpora are the M0 fixtures (chatty, tool-heavy, parallel-tool, error-result, aborted-turn); until M0 delivers breadth, the machinery builds against whatever corpora exist and widens as they arrive. inspect's overview and health reads report event/message counts, last recorded position, and any capture gaps or failed derivations (AC-6.3).\\n   408\\t\\n   409\\t**Skeleton requirements:**\\n   410\\t\\n   411\\t| What | Where | Stub signature | Stub semantics |\\n   412\\t|------|-------|----------------|----------------|\\n   413\\t| Replay + compare | `verify/replay.ts` | `replayCorpus(corpus, threadRef): Promise<ReplayResult>` | structured compare result |\\n   414\\t\\n   415\\t---\\n   416\\t\\n   417\\t## Interface Definitions\\n   418\\t\\n   419\\tThese are copy-paste targets for the foundation chunk. Types reference the ACs they serve; signatures are complete (no `any`, no TODO). The LHC-side types (`MessageEventInput`, `ModelCall`, `ModelAssignment`, `FormKind`, `ThreadRef`, `OpResult`) are imported from the `lhc` package, not redefined — the connector consumes them.\\n   420\\t\\n   421\\t```typescript\\n   422\\t// lifecycle/state.ts — AC-1.3: plain data only, never a PI object\\n   423\\texport interface SessionState {\\n   424\\t  threadRef: ThreadRef;          // from lhc\\n   425\\t  flags: {\\n   426\\t    startupValidationReported: boolean;\\n   427\\t    [k: string]: boolean;\\n   428\\t  };\\n   429\\t  health: {\\n   430\\t    lastCaptureFailure?: CaptureFailureDiagnostic;\\n   431\\t    startupValidation?: ValidationReport;\\n   432\\t  };\\n   433\\t}\\n   434\\t\\n   435\\texport interface CaptureFailureDiagnostic {\\n   436\\t  code: string;\\n   437\\t  eventKey?: string;\\n   438\\t  message: string;\\n   439\\t  recordedGap: boolean;\\n   440\\t}\\n   441\\t\\n   442\\t// lifecycle/thread-resolution.ts — AC-1.2, 1.5, 1.6\\n   443\\t// Launch flags name the thread; the registry resolves it. (PI's own session file\\n   444\\t// still exists in this observe-only epic; it is just not where thread identity lives.)\\n   445\\texport interface LaunchFlags {\\n   446\\t  resume?: boolean;        // --resume / -r : cwd-scoped picker\\n   447\\t  continue?: boolean;      // --continue / -c : most recent\\n   448\\t  session?: string;        // --session <id> : full or partial id\\n   449\\t  // none set → new thread\\n   450\\t}\\n   451\\texport function resolveThread(\\n   452\\t  launch: LaunchFlags, pi: ExtensionAPI,\\n   453\\t): Promise<OpResult<ThreadRef>>; // unresolvable --session id → error, never a silent new thread\\n   454\\t\\n   455\\t// lifecycle/picker.ts — AC-1.7\\n   456\\texport function pickThread(cwd: string): Promise<OpResult<ThreadRef | null>>; // null on empty list\\n   457\\t\\n   458\\t// capture/map-message.ts — AC-2.1, 2.3, 2.4, 2.5\\n   459\\texport interface MapCtx { piSessionId: string; entryId?: string; }\\n   460\\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[];\\n   461\\t\\n   462\\t// capture/runtime-changes.ts — AC-2.8\\n   463\\t// model_select / thinking_level_select hooks → runtime_note events, in order.\\n   464\\texport function mapModelSelect(\\n   465\\t  ev: { model: { provider: string; id: string }; previousModel?: { provider: string; id: string } },\\n   466\\t  ctx: MapCtx,\\n   467\\t): MessageEventInput; // one runtime_note recording new + previous model\\n   468\\texport function mapThinkingLevelSelect(\\n   469\\t  ev: { level: string; previousLevel: string }, ctx: MapCtx,\\n   470\\t): MessageEventInput; // one runtime_note recording new + previous level\\n   471\\t\\n   472\\t// capture/turn-accumulator.ts — AC-2.2\\n   473\\texport class TurnAccumulator {\\n   474\\t  onMessage(events: MessageEventInput[]): void;\\n   475\\t  onAgentEnd(): MessageEventInput[]; // returns [turn_end] when a turn is open, else []\\n   476\\t  hasOpenTurn(): boolean;\\n   477\\t}\\n   478\\t\\n   479\\t// capture/idempotency.ts — AC-2.6\\n   480\\texport function eventKey(input: {\\n   481\\t  piSessionId: string; entryId?: string; responseId?: string;\\n   482\\t  toolCallId?: string; blockIndex: number; kind: MessageEventInput[\\\"eventKind\\\"];\\n   483\\t  role?: string; timestamp?: number; content?: string;\\n   484\\t}): string;\\n   485\\t\\n   486\\t// capture/converter.ts — AC-2.1, 2.7\\n   487\\texport function capture(\\n   488\\t  events: MessageEventInput[],\\n   489\\t  instance: LhcInstance,\\n   490\\t): Promise<OpResult<BatchResult>>;\\n   491\\t\\n   492\\t// inference/model-call.ts — AC-4.1..4.4\\n   493\\texport function createModelCall(ctx: ExtensionContext): ModelCall; // ModelCall from lhc\\n   494\\texport function classifyFailure(err: unknown): ModelCallFailureKind;\\n   495\\t\\n   496\\t// inference/assignments.ts — AC-5.4, 5.5\\n   497\\texport function loadAssignments(\\n   498\\t  config: unknown,\\n   499\\t): Record<FormKind, ModelAssignment>; // throws on missing/unknown/placeholder\\n   500\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:24:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba docs/specs/02-pi-lhc/01-connector-core/epic.md | sed -n '260,340p'\\\"\",\"aggregated_output\":\"   260\\tThe converter emits LHC `MessageEventInput` events. Each carries `eventKind`, `idempotencyKey`, `actor`, `harness`, and a kind-fixed `payload`. The seven kinds and their payloads:\\n   261\\t\\n   262\\t| Event kind | Payload |\\n   263\\t|------------|---------|\\n   264\\t| `user_prompt` | `{ text }` |\\n   265\\t| `assistant_text` | `{ text }` |\\n   266\\t| `assistant_thinking` | `{ text }` |\\n   267\\t| `tool_call` | `{ toolCallId, toolName, arguments }` |\\n   268\\t| `tool_result` | `{ toolCallId, content, isError? }` |\\n   269\\t| `runtime_note` | `{ text }` |\\n   270\\t| `turn_end` | `{}` (empty) |\\n   271\\t\\n   272\\t### PI message → LHC event mapping\\n   273\\t\\n   274\\t| PI message (`message_end`) | LHC events emitted (in order) |\\n   275\\t|----------------------------|-------------------------------|\\n   276\\t| user `[text]` | one `user_prompt` |\\n   277\\t| assistant `[thinking?, text?, toolCall×N]` | `assistant_thinking` (if present), then `assistant_text` (if present), then one `tool_call` per call |\\n   278\\t| toolResult `[text]`, `isError?` | one `tool_result` (correlated by `toolCallId`) |\\n   279\\t| (agent run completes) | one `turn_end` — see turn derivation below |\\n   280\\t\\n   281\\tImage and file-reference content parts: LHC intake payloads are text today. Handling (placeholder vs. payload-schema extension) is an M0 decision (A-7), not a tech design question; until that decision lands, the converter must not silently drop a content part without recording the omission.\\n   282\\t\\n   283\\tRuntime-change events: PI's `model_select` and `thinking_level_select` map to `runtime_note` events (AC-2.8). The note text is structured enough to recover the change — the new value and the previous one — but it rides the existing `runtime_note` kind, adding no new intake kind.\\n   284\\t\\n   285\\t| PI event | LHC event |\\n   286\\t|----------|-----------|\\n   287\\t| `model_select` `{model, previousModel}` | one `runtime_note` recording the model change |\\n   288\\t| `thinking_level_select` `{level, previousLevel}` | one `runtime_note` recording the level change |\\n   289\\t\\n   290\\t### Turn derivation\\n   291\\t\\n   292\\tPI fires `turn_start`/`turn_end` per agent step, and resets `turnIndex` to 0 at the start of each agent run. An LHC turn is a whole exchange. The converter derives LHC turns from PI traffic:\\n   293\\t\\n   294\\t- An LHC turn **opens** on a `user_prompt` event.\\n   295\\t- It stays open across every agent step — each PI `turn_end` within the run is **ignored as an LHC turn boundary**.\\n   296\\t- It **closes** with one LHC `turn_end` event when the agent run completes (no further tool calls; PI's `agent_end`), or implicitly when the next `user_prompt` arrives.\\n   297\\t\\n   298\\t**Worked example.** A user asks one question that triggers two tool calls, then gets a final answer. PI emits:\\n   299\\t\\n   300\\t```\\n   301\\tturn_start(0)\\n   302\\t  message_end(user [text])\\n   303\\t  message_end(assistant [thinking, toolCall, toolCall])\\n   304\\t  message_end(toolResult) × 2\\n   305\\tturn_end(0)\\n   306\\tturn_start(1)\\n   307\\t  message_end(assistant [text])\\n   308\\tturn_end(1)\\n   309\\tagent_end\\n   310\\t```\\n   311\\t\\n   312\\tThe converter emits **one** LHC turn:\\n   313\\t\\n   314\\t```\\n   315\\tuser_prompt, assistant_thinking, tool_call, tool_call, tool_result, tool_result,\\n   316\\tassistant_text, turn_end\\n   317\\t```\\n   318\\t\\n   319\\tPI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` is emitted at `agent_end`. Session order comes from source-event order through the converter, never from PI's per-agent-run `turnIndex`.\\n   320\\t\\n   321\\t### Abort and crash shapes\\n   322\\t\\n   323\\t| Shape | PI signal | Converter behavior |\\n   324\\t|-------|-----------|--------------------|\\n   325\\t| Graceful interrupt | assistant `message_end` with partial content and `stopReason: aborted`; `turn_end` `aborted`; `agent_end` fires | Capture the partial content; carry the aborted disposition; close the LHC turn normally (a complete-but-aborted turn) |\\n   326\\t| Hard kill | user `message_end` only; no assistant close, no `turn_end`, no `agent_end` | On reattach, find a dangling open turn with a trailing user prompt; tolerate it (LHC `turn_end`-with-no-open-turn is a no-op); resume capture without duplicating the recorded prefix |\\n   327\\t\\n   328\\t### Idempotency key\\n   329\\t\\n   330\\tEach emitted event carries a stable idempotency key so re-delivery (reload, crash-replay) is recognized and skipped. Construction precedence (from the POC mapper, carried forward): PI entry id (`pi:<session>:entry:<entryId>`) → provider response id / tool-call id → content fingerprint as last resort. The exact construction is tech design; the contract is that the key is stable across re-delivery of the same logical event and unique across distinct events.\\n   331\\t\\n   332\\t### Thread resolution and fork lineage\\n   333\\t\\n   334\\tThe thread is resolved at launch through the registry catalog. The four launch modes and their registry operations:\\n   335\\t\\n   336\\t| Launch | Registry operation |\\n   337\\t|--------|--------------------|\\n   338\\t| no flag | `newThread({ filePath, cwd, title })` — new thread, registered |\\n   339\\t| `--session <id>` | `resolve({ threadId })`, full or partial-id match |\\n   340\\t| `--continue` / `-c` | resolve the most recently created thread |\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:25:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba docs/specs/02-pi-lhc/01-connector-core/epic.md | sed -n '130,190p'\\\"\",\"aggregated_output\":\"   130\\t\\n   131\\t**AC-1.2:** On `session_start` that resolves to an existing thread (via `--continue`, `--session`, or a picker selection), the extension initializes against that thread by resolving it through the registry. No second thread is created for an already-resolved thread.\\n   132\\t\\n   133\\t**AC-1.3:** Across all hooks, the extension holds only plain data (thread reference, file path, told-the-user flags) between events. It retains no PI context or session-manager object across hook boundaries; each handler uses the fresh context PI provides. A session replacement (new/resume/fork) that invalidates prior context objects does not break capture.\\n   134\\t\\n   135\\t**AC-1.4:** On `session_shutdown`, the extension disposes the LHC instance with flush and cleanup. A subsequent run that resolves the same thread finds it complete through the last event recorded before shutdown — no trailing loss.\\n   136\\t\\n   137\\t**AC-1.5:** On reload (extension torn down and re-initialized while the same session continues), the extension reconstructs the thread reference from durable state (the resolved thread id), not from retained in-memory objects, and capture continues on the same thread.\\n   138\\t\\n   139\\t**AC-1.6:** Launch resolves the thread by mode: no flag creates a new thread; `--session <id>` resolves a named thread by full or partial id; `--continue`/`-c` resolves the most recently created thread; an ambiguous or unresolvable id fails with an actionable message rather than silently creating a new thread.\\n   140\\t\\n   141\\t**AC-1.7:** `--resume`/`-r` lists threads scoped to the current working directory, each shown with its title and creation time, and resolves the operator's selection. With no threads for the cwd, the picker reports an empty list rather than failing.\\n   142\\t\\n   143\\t---\\n   144\\t\\n   145\\t## Flow 2: Event Capture and Turn Derivation\\n   146\\t\\n   147\\tFrom the first prompt on, the extension maps each finalized PI message to LHC intake events and records them in order. PI fires a turn boundary per agent step; an LHC turn spans a whole exchange (one user prompt and everything the agent did in response). The converter derives LHC turn boundaries from PI traffic rather than copying PI's. Capture is duplicate-safe; writable-thread failures become durable gaps, store-unavailable failures become visible extension diagnostics, and neither breaks the session.\\n   148\\t\\n   149\\t```mermaid\\n   150\\tsequenceDiagram\\n   151\\t  participant PI as PI session\\n   152\\t  participant E as converter\\n   153\\t  participant L as LHC intake\\n   154\\t  PI->>E: message_end(user)\\n   155\\t  E->>L: user_prompt event (opens LHC turn)\\n   156\\t  PI->>E: message_end(assistant [thinking,text,toolCall×N])\\n   157\\t  E->>L: assistant_thinking, assistant_text, tool_call×N\\n   158\\t  PI->>E: message_end(toolResult) ×N\\n   159\\t  E->>L: tool_result×N (correlated by toolCallId)\\n   160\\t  Note over PI,E: PI fires turn_end per agent step — NOT mapped 1:1\\n   161\\t  PI->>E: agent run completes (no further tool calls)\\n   162\\t  E->>L: turn_end event (closes the LHC turn)\\n   163\\t```\\n   164\\t\\n   165\\t**AC-2.1:** Every PI message finalized through `message_end` — user, assistant, tool result — is mapped to LHC intake events and recorded in source order. An assistant message fans out to per-content-part events in thinking → text → tool-call order: `assistant_thinking`, `assistant_text`, and one `tool_call` per call.\\n   166\\t\\n   167\\t**AC-2.2:** LHC turn boundaries are derived from PI traffic, not from PI's per-agent-step `turn_end`. One LHC turn spans a user prompt and all subsequent agent activity until the next user prompt or the end of the agent run. The converter emits exactly one LHC `turn_end` event per LHC turn, at the agent run's completion — never one per PI `turn_end`, and never keyed off PI's per-agent-run `turnIndex` as a session counter.\\n   168\\t\\n   169\\t**AC-2.3:** Parallel tool calls are captured with correct correlation: when one assistant message carries multiple `tool_call` parts and their results complete out of arrival order, each `tool_result` event is matched to its call by `toolCallId`, not by arrival order.\\n   170\\t\\n   171\\t**AC-2.4:** A tool result carrying an error is captured as a `tool_result` event with its error content and an error flag set. No event is dropped because a tool failed.\\n   172\\t\\n   173\\t**AC-2.5:** A graceful interrupt — a complete turn PI marks aborted, with partial assistant content preserved — is captured whole: the partial content is recorded and the aborted disposition is carried through. The interrupted content is not discarded.\\n   174\\t\\n   175\\t**AC-2.6:** Capture is duplicate-safe. Re-delivered events (reload, crash-replay) are recognized by idempotency key and skipped rather than recorded twice. On normal resume PI re-delivers no historical events, so duplication only arises on the reload and replay paths.\\n   176\\t\\n   177\\t**AC-2.7:** A capture failure does not break the PI session, and does not vanish silently. When the thread is writable, a malformed or unmappable event records a durable, queryable gap that surfaces in thread health. When the thread store itself is unavailable, the failure surfaces as an extension diagnostic / health signal rather than a durable gap (the record cannot be written), and no exception propagates into the PI hook. Either way the session continues, and capture adds no perceptible latency to interactive use.\\n   178\\t\\n   179\\t**AC-2.8:** Runtime changes that PI fires only in-stream — model selection (`model_select`) and thinking-level selection (`thinking_level_select`) — are captured in order as `runtime_note` events carrying the change (the new model or level, and the previous one). These are recorded at the moment they fire because no durable record holds them otherwise; nothing in this epic consumes them, and their presence in the thread is what lets later epics attribute a turn to the model that produced it.\\n   180\\t\\n   181\\t---\\n   182\\t\\n   183\\t## Flow 3: Fork as New Thread\\n   184\\t\\n   185\\tA user forks a PI session. PI creates a new session file and leaves the original untouched. A fork produces a new LHC thread, seeded by replaying the source thread's recorded events up to the fork point. The source thread is never written. Derived forms carry over when their provenance proves the reuse safe; otherwise they requeue on the new thread.\\n   186\\t\\n   187\\t**AC-3.1:** Forking a PI session creates a new LHC thread. The source thread receives no writes — it is unchanged by the fork.\\n   188\\t\\n   189\\t**AC-3.2:** The new thread is seeded by replaying the source thread's recorded events up to the fork point. The seeded thread's read-back (events, messages, turns) matches the source's read-back through that point.\\n   190\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:33:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'rg -n \\\"NotImplemented|TODO|throw new|mock|fake|placeholder|shim|fallback|unsupported|runtime_note|turnIndex|turn_end|agent_end|message_end|model_select|thinking_level_select|isError|toolCallId|duplicate|gap|health|aborted|abort\\\" packages/pi-lhc/src packages/pi-lhc/test'\",\"aggregated_output\":\"packages/pi-lhc/test/fixtures/synthetic.ts:34:  runtime_note: () => ({ text: \\\"model changed: anthropic/claude → openai/gpt\\\" }),\\npackages/pi-lhc/test/fixtures/synthetic.ts:35:  tool_call: () => ({ toolCallId: \\\"call-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } }),\\npackages/pi-lhc/test/fixtures/synthetic.ts:36:  tool_result: () => ({ toolCallId: \\\"call-1\\\", content: \\\"contents of notes.txt\\\", isError: false }),\\npackages/pi-lhc/test/fixtures/synthetic.ts:37:  turn_end: () => ({}),\\npackages/pi-lhc/test/fixtures/synthetic.ts:98:  isError?: boolean;\\npackages/pi-lhc/test/fixtures/synthetic.ts:103:    toolCallId: opts.id,\\npackages/pi-lhc/test/fixtures/synthetic.ts:106:  if (opts.isError !== undefined) msg.isError = opts.isError;\\npackages/pi-lhc/src/index.ts:50:  \\\"message_end\\\",\\npackages/pi-lhc/src/index.ts:51:  \\\"turn_end\\\",\\npackages/pi-lhc/src/index.ts:52:  \\\"agent_end\\\",\\npackages/pi-lhc/src/index.ts:53:  \\\"model_select\\\",\\npackages/pi-lhc/src/index.ts:54:  \\\"thinking_level_select\\\",\\npackages/pi-lhc/src/index.ts:126:/** The Story-1 production inference placeholder: a real `DerivationProvider`\\npackages/pi-lhc/src/index.ts:129: *  (message_end is a no-op until Story 2) and lands no work handlers, so no\\npackages/pi-lhc/src/index.ts:135: *  (it would mark fake derived text into the thread). Failing closed preserves\\npackages/pi-lhc/src/index.ts:222:  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\\npackages/pi-lhc/src/index.ts:268:  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\\npackages/pi-lhc/src/index.ts:332:  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\\npackages/pi-lhc/src/index.ts:333:  // converter already recorded a durable gap for a writable-thread malformed\\npackages/pi-lhc/src/index.ts:335:  // surfaces as an extension health signal with no gap. Neither path throws.\\npackages/pi-lhc/src/index.ts:349:    if (state !== null) state.health.lastCaptureFailure = failure;\\npackages/pi-lhc/src/index.ts:360:  // message_end: map the finalized PI message to ordered LHC events, track the\\npackages/pi-lhc/src/index.ts:362:  const onMessageEnd: PiHookHandler<\\\"message_end\\\"> = async (_ctx, event) => {\\npackages/pi-lhc/src/index.ts:371:  // model_select / thinking_level_select fire only in-stream — capture each as\\npackages/pi-lhc/src/index.ts:372:  // an ordered runtime_note the moment it fires (AC-2.8).\\npackages/pi-lhc/src/index.ts:373:  const onModelSelect: PiHookHandler<\\\"model_select\\\"> = async (_ctx, event) => {\\npackages/pi-lhc/src/index.ts:380:  const onThinkingLevelSelect: PiHookHandler<\\\"thinking_level_select\\\"> = async (_ctx, event) => {\\npackages/pi-lhc/src/index.ts:387:  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\\npackages/pi-lhc/src/index.ts:388:  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\\npackages/pi-lhc/src/index.ts:389:  const onAgentEnd: PiHookHandler<\\\"agent_end\\\"> = async () => {\\npackages/pi-lhc/src/index.ts:417:  
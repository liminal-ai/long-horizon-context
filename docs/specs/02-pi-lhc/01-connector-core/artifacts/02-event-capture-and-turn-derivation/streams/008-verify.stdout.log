ges/pi-lhc/src/capture/map-message.ts:179:      textEvent(\\\"runtime_note\\\", EMPTY_MESSAGE_NOTE, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: \\\"empty:assistant\\\" })),\\npackages/pi-lhc/src/capture/map-message.ts:187:  const isError = msg.isError === true;\\npackages/pi-lhc/src/capture/map-message.ts:188:  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\\npackages/pi-lhc/src/capture/map-message.ts:192:      msg.toolCallId,\\npackages/pi-lhc/src/capture/map-message.ts:194:      isError,\\npackages/pi-lhc/src/capture/map-message.ts:195:      buildKey(ctx, \\\"toolResult\\\", \\\"tool_result\\\", 0, { toolCallId: msg.toolCallId, content }),\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:35:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/map-message.ts'\",\"aggregated_output\":\"     1\\timport type { EventKind, MessageEventInput } from \\\"lhc\\\";\\n     2\\timport type {\\n     3\\t  AgentMessage,\\n     4\\t  AssistantMessage,\\n     5\\t  ContentPart,\\n     6\\t  FileRefPart,\\n     7\\t  ImagePart,\\n     8\\t  ToolResultMessage,\\n     9\\t  UserMessage,\\n    10\\t} from \\\"../pi/types.js\\\";\\n    11\\timport { eventKey } from \\\"./idempotency.js\\\";\\n    12\\t\\n    13\\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\\n    14\\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\\n    15\\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\\n    16\\t// present) → one `tool_call` per call, in that order; a tool result → one\\n    17\\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\\n    18\\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\\n    19\\t// drop, tech design I-6). A graceful interrupt carries its disposition through\\n    20\\t// on a trailing `runtime_note` (research §5b).\\n    21\\t\\n    22\\texport interface MapCtx {\\n    23\\t  piSessionId: string;\\n    24\\t  entryId?: string;\\n    25\\t}\\n    26\\t\\n    27\\tconst HARNESS = \\\"pi\\\";\\n    28\\t\\n    29\\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\\n    30\\t *  field to hold its disposition, so the mapper carries `stopReason` through on\\n    31\\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\\n    32\\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\\n    33\\texport const ABORTED_DISPOSITION_TEXT =\\n    34\\t  \\\"turn aborted (stopReason: aborted) — partial content preserved\\\";\\n    35\\t\\n    36\\tconst EMPTY_MESSAGE_NOTE = \\\"message omitted: no mappable content parts\\\";\\n    37\\t\\n    38\\tfunction textOf(parts: ContentPart[]): string {\\n    39\\t  return parts\\n    40\\t    .filter((p): p is Extract<ContentPart, { type: \\\"text\\\" }> => p.type === \\\"text\\\")\\n    41\\t    .map((p) => p.text)\\n    42\\t    .join(\\\"\\\");\\n    43\\t}\\n    44\\t\\n    45\\tfunction thinkingOf(parts: ContentPart[]): string {\\n    46\\t  return parts\\n    47\\t    .filter((p): p is Extract<ContentPart, { type: \\\"thinking\\\" }> => p.type === \\\"thinking\\\")\\n    48\\t    .map((p) => p.thinking)\\n    49\\t    .join(\\\"\\\");\\n    50\\t}\\n    51\\t\\n    52\\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\\n    53\\t  return parts.filter(\\n    54\\t    (p): p is ImagePart | FileRefPart => p.type === \\\"image\\\" || p.type === \\\"fileRef\\\",\\n    55\\t  );\\n    56\\t}\\n    57\\t\\n    58\\tfunction omissionText(part: ImagePart | FileRefPart): string {\\n    59\\t  return part.type === \\\"image\\\"\\n    60\\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \\\"\\\"}`\\n    61\\t    : `unsupported content omitted: file reference (${part.path})`;\\n    62\\t}\\n    63\\t\\n    64\\tfunction buildKey(\\n    65\\t  ctx: MapCtx,\\n    66\\t  role: string,\\n    67\\t  kind: EventKind,\\n    68\\t  blockIndex: number,\\n    69\\t  opts: { toolCallId?: string; content?: string } = {},\\n    70\\t): string {\\n    71\\t  return eventKey({\\n    72\\t    piSessionId: ctx.piSessionId,\\n    73\\t    entryId: ctx.entryId,\\n    74\\t    blockIndex,\\n    75\\t    kind,\\n    76\\t    role,\\n    77\\t    toolCallId: opts.toolCallId,\\n    78\\t    content: opts.content,\\n    79\\t  });\\n    80\\t}\\n    81\\t\\n    82\\t// Per-kind builders — explicit eventKind literals so the discriminated union\\n    83\\t// narrows without a cast.\\n    84\\tfunction textEvent(\\n    85\\t  kind: \\\"user_prompt\\\" | \\\"assistant_text\\\" | \\\"assistant_thinking\\\" | \\\"runtime_note\\\",\\n    86\\t  text: string,\\n    87\\t  actor: string,\\n    88\\t  key: string,\\n    89\\t): MessageEventInput {\\n    90\\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\\n    91\\t}\\n    92\\t\\n    93\\tfunction toolCallEvent(\\n    94\\t  toolCallId: string,\\n    95\\t  toolName: string,\\n    96\\t  args: Record<string, unknown>,\\n    97\\t  key: string,\\n    98\\t): MessageEventInput {\\n    99\\t  return {\\n   100\\t    eventKind: \\\"tool_call\\\",\\n   101\\t    idempotencyKey: key,\\n   102\\t    actor: \\\"assistant\\\",\\n   103\\t    harness: HARNESS,\\n   104\\t    payload: { toolCallId, toolName, arguments: args },\\n   105\\t  };\\n   106\\t}\\n   107\\t\\n   108\\tfunction toolResultEvent(\\n   109\\t  toolCallId: string,\\n   110\\t  content: string,\\n   111\\t  isError: boolean,\\n   112\\t  key: string,\\n   113\\t): MessageEventInput {\\n   114\\t  return {\\n   115\\t    eventKind: \\\"tool_result\\\",\\n   116\\t    idempotencyKey: key,\\n   117\\t    actor: \\\"tool\\\",\\n   118\\t    harness: HARNESS,\\n   119\\t    payload: { toolCallId, content, isError },\\n   120\\t  };\\n   121\\t}\\n   122\\t\\n   123\\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\\n   124\\t  const events: MessageEventInput[] = [];\\n   125\\t  let block = 0;\\n   126\\t  if (msg.content.some((p) => p.type === \\\"text\\\")) {\\n   127\\t    const text = textOf(msg.content);\\n   128\\t    events.push(textEvent(\\\"user_prompt\\\", text, \\\"user\\\", buildKey(ctx, \\\"user\\\", \\\"user_prompt\\\", block, { content: text })));\\n   129\\t    block += 1;\\n   130\\t  }\\n   131\\t  for (const part of unsupportedOf(msg.content)) {\\n   132\\t    const text = omissionText(part);\\n   133\\t    events.push(textEvent(\\\"runtime_note\\\", text, \\\"system\\\", buildKey(ctx, \\\"user\\\", \\\"runtime_note\\\", block, { content: text })));\\n   134\\t    block += 1;\\n   135\\t  }\\n   136\\t  if (events.length === 0) {\\n   137\\t    events.push(\\n   138\\t      textEvent(\\\"runtime_note\\\", EMPTY_MESSAGE_NOTE, \\\"system\\\", buildKey(ctx, \\\"user\\\", \\\"runtime_note\\\", block, { content: \\\"empty:user\\\" })),\\n   139\\t    );\\n   140\\t  }\\n   141\\t  return events;\\n   142\\t}\\n   143\\t\\n   144\\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\\n   145\\t  const events: MessageEventInput[] = [];\\n   146\\t  let block = 0;\\n   147\\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\\n   148\\t  if (msg.content.some((p) => p.type === \\\"thinking\\\")) {\\n   149\\t    const text = thinkingOf(msg.content);\\n   150\\t    events.push(textEvent(\\\"assistant_thinking\\\", text, \\\"assistant\\\", buildKey(ctx, \\\"assistant\\\", \\\"assistant_thinking\\\", block, { content: text })));\\n   151\\t    block += 1;\\n   152\\t  }\\n   153\\t  if (msg.content.some((p) => p.type === \\\"text\\\")) {\\n   154\\t    const text = textOf(msg.content);\\n   155\\t    events.push(textEvent(\\\"assistant_text\\\", text, \\\"assistant\\\", buildKey(ctx, \\\"assistant\\\", \\\"assistant_text\\\", block, { content: text })));\\n   156\\t    block += 1;\\n   157\\t  }\\n   158\\t  for (const part of msg.content) {\\n   159\\t    if (part.type !== \\\"toolCall\\\") continue;\\n   160\\t    events.push(\\n   161\\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \\\"assistant\\\", \\\"tool_call\\\", block, { toolCallId: part.id, content: part.name })),\\n   162\\t    );\\n   163\\t    block += 1;\\n   164\\t  }\\n   165\\t  for (const part of unsupportedOf(msg.content)) {\\n   166\\t    const text = omissionText(part);\\n   167\\t    events.push(textEvent(\\\"runtime_note\\\", text, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: text })));\\n   168\\t    block += 1;\\n   169\\t  }\\n   170\\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\\n   171\\t  if (msg.stopReason === \\\"aborted\\\") {\\n   172\\t    events.push(\\n   173\\t      textEvent(\\\"runtime_note\\\", ABORTED_DISPOSITION_TEXT, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: ABORTED_DISPOSITION_TEXT })),\\n   174\\t    );\\n   175\\t    block += 1;\\n   176\\t  }\\n   177\\t  if (events.length === 0) {\\n   178\\t    events.push(\\n   179\\t      textEvent(\\\"runtime_note\\\", EMPTY_MESSAGE_NOTE, \\\"system\\\", buildKey(ctx, \\\"assistant\\\", \\\"runtime_note\\\", block, { content: \\\"empty:assistant\\\" })),\\n   180\\t    );\\n   181\\t  }\\n   182\\t  return events;\\n   183\\t}\\n   184\\t\\n   185\\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\\n   186\\t  const content = textOf(msg.content);\\n   187\\t  const isError = msg.isError === true;\\n   188\\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\\n   189\\t  // and content are always captured, even on failure (AC-2.4).\\n   190\\t  return [\\n   191\\t    toolResultEvent(\\n   192\\t      msg.toolCallId,\\n   193\\t      content,\\n   194\\t      isError,\\n   195\\t      buildKey(ctx, \\\"toolResult\\\", \\\"tool_result\\\", 0, { toolCallId: msg.toolCallId, content }),\\n   196\\t    ),\\n   197\\t  ];\\n   198\\t}\\n   199\\t\\n   200\\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\\n   201\\t  switch (msg.role) {\\n   202\\t    case \\\"user\\\":\\n   203\\t      return mapUser(msg, ctx);\\n   204\\t    case \\\"assistant\\\":\\n   205\\t      return mapAssistant(msg, ctx);\\n   206\\t    case \\\"toolResult\\\":\\n   207\\t      return mapToolResult(msg, ctx);\\n   208\\t  }\\n   209\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:41:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/turn-accumulator.ts'\",\"aggregated_output\":\"     1\\timport type { MessageEventInput } from \\\"lhc\\\";\\n     2\\timport { eventKey } from \\\"./idempotency.js\\\";\\n     3\\t\\n     4\\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\\n     5\\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\\n     6\\t//\\n     7\\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\\n     8\\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\\n     9\\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\\n    10\\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\\n    11\\t// no-op on reattach, since a fresh accumulator has no open turn to close.\\n    12\\t\\n    13\\texport interface TurnAccumulatorCtx {\\n    14\\t  piSessionId: string;\\n    15\\t  actor?: string;\\n    16\\t  harness?: string;\\n    17\\t}\\n    18\\t\\n    19\\texport class TurnAccumulator {\\n    20\\t  private readonly piSessionId: string;\\n    21\\t  private readonly actor: string;\\n    22\\t  private readonly harness: string;\\n    23\\t  private open = false;\\n    24\\t  // A per-session monotonic counter giving each emitted `turn_end` a distinct,\\n    25\\t  // replay-stable idempotency key (a fresh accumulator on replay restarts it,\\n    26\\t  // so the same run re-derives the same keys and dedups).\\n    27\\t  private closedCount = 0;\\n    28\\t\\n    29\\t  constructor(ctx: TurnAccumulatorCtx) {\\n    30\\t    this.piSessionId = ctx.piSessionId;\\n    31\\t    this.actor = ctx.actor ?? \\\"system\\\";\\n    32\\t    this.harness = ctx.harness ?? \\\"pi\\\";\\n    33\\t  }\\n    34\\t\\n    35\\t  /** Open the turn when this message's events include a `user_prompt`. A new\\n    36\\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\\n    37\\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\\n    38\\t  onMessage(events: MessageEventInput[]): void {\\n    39\\t    if (events.some((event) => event.eventKind === \\\"user_prompt\\\")) {\\n    40\\t      this.open = true;\\n    41\\t    }\\n    42\\t  }\\n    43\\t\\n    44\\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\\n    45\\t   *  transition the accumulator drives, and it happens once per agent run. */\\n    46\\t  onAgentEnd(): MessageEventInput[] {\\n    47\\t    if (!this.open) return [];\\n    48\\t    this.open = false;\\n    49\\t    const key = eventKey({\\n    50\\t      piSessionId: this.piSessionId,\\n    51\\t      entryId: `turn:${this.closedCount}`,\\n    52\\t      blockIndex: 0,\\n    53\\t      kind: \\\"turn_end\\\",\\n    54\\t    });\\n    55\\t    this.closedCount += 1;\\n    56\\t    return [\\n    57\\t      {\\n    58\\t        eventKind: \\\"turn_end\\\",\\n    59\\t        idempotencyKey: key,\\n    60\\t        actor: this.actor,\\n    61\\t        harness: this.harness,\\n    62\\t        payload: {},\\n    63\\t      },\\n    64\\t    ];\\n    65\\t  }\\n    66\\t\\n    67\\t  hasOpenTurn(): boolean {\\n    68\\t    return this.open;\\n    69\\t  }\\n    70\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:55:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_26\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/parallel-and-errors.test.ts'\",\"aggregated_output\":\"     1\\t// Story 2 — parallel-tool correlation (TC-2.4), error-result capture (TC-2.5),\\n     2\\t// and idempotent re-delivery (TC-2.7, the idempotency architecture-risk). The\\n     3\\t// first two run the production path and read the thread back; TC-2.7 drives\\n     4\\t// capture() directly so it can assert the per-event skip outcomes the SDK\\n     5\\t// returns on re-delivery.\\n     6\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     7\\timport { createDeterministicProvider, intakeStream } from \\\"lhc\\\";\\n     8\\timport { capture } from \\\"../../src/capture/converter.js\\\";\\n     9\\timport { mapMessage } from \\\"../../src/capture/map-message.js\\\";\\n    10\\timport { TurnAccumulator } from \\\"../../src/capture/turn-accumulator.js\\\";\\n    11\\timport { initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    12\\timport {\\n    13\\t  makeAgentEnd,\\n    14\\t  makeAssistantMessage,\\n    15\\t  makeMessageEnd,\\n    16\\t  makeToolResult,\\n    17\\t  makeUserMessage,\\n    18\\t} from \\\"../fixtures/synthetic.js\\\";\\n    19\\timport { makeTempThread, tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    20\\timport { eventsAfterShutdown, kindsOf, startCapture } from \\\"./support.js\\\";\\n    21\\t\\n    22\\tlet store: TempStore;\\n    23\\tbeforeEach(() => {\\n    24\\t  store = tempStore();\\n    25\\t});\\n    26\\tafterEach(() => {\\n    27\\t  store.cleanup();\\n    28\\t});\\n    29\\t\\n    30\\tinterface ToolResultPayload {\\n    31\\t  toolCallId: string;\\n    32\\t  content: string;\\n    33\\t  isError?: boolean;\\n    34\\t}\\n    35\\tfunction toolResultPayload(event: { payload: unknown }): ToolResultPayload {\\n    36\\t  return event.payload as ToolResultPayload;\\n    37\\t}\\n    38\\t\\n    39\\tdescribe(\\\"Story 2: parallel tool calls (TC-2.4)\\\", () => {\\n    40\\t  it(\\\"correlates each out-of-order tool_result to its call by toolCallId, not arrival order\\\", async () => {\\n    41\\t    const started = await startCapture(store);\\n    42\\t    const { connector, ctx } = started;\\n    43\\t\\n    44\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"read both files\\\")));\\n    45\\t    await connector.handlers.message_end(\\n    46\\t      ctx,\\n    47\\t      makeMessageEnd(\\n    48\\t        makeAssistantMessage({\\n    49\\t          toolCalls: [\\n    50\\t            { id: \\\"call_a\\\", name: \\\"read_file\\\", arguments: { path: \\\"a.txt\\\" } },\\n    51\\t            { id: \\\"call_b\\\", name: \\\"read_file\\\", arguments: { path: \\\"b.txt\\\" } },\\n    52\\t          ],\\n    53\\t        }),\\n    54\\t      ),\\n    55\\t    );\\n    56\\t    // Results complete out of arrival order: b before a.\\n    57\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_b\\\", content: \\\"b body\\\" })));\\n    58\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_a\\\", content: \\\"a body\\\" })));\\n    59\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"read both\\\" })));\\n    60\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    61\\t\\n    62\\t    const events = await eventsAfterShutdown(started);\\n    63\\t    const results = events.filter((event) => event.eventKind === \\\"tool_result\\\");\\n    64\\t    expect(results).toHaveLength(2);\\n    65\\t\\n    66\\t    // Each result carries its own call's id and content — correlation is by id.\\n    67\\t    const contentById = new Map(\\n    68\\t      results.map((event) => [toolResultPayload(event).toolCallId, toolResultPayload(event).content]),\\n    69\\t    );\\n    70\\t    expect(contentById.get(\\\"call_b\\\")).toBe(\\\"b body\\\");\\n    71\\t    expect(contentById.get(\\\"call_a\\\")).toBe(\\\"a body\\\");\\n    72\\t\\n    73\\t    // Arrival order is preserved in the record (b then a), each correctly tagged\\n    74\\t    // — proving the tag, not the position, is the correlation.\\n    75\\t    expect(toolResultPayload(results[0]!).toolCallId).toBe(\\\"call_b\\\");\\n    76\\t    expect(toolResultPayload(results[1]!).toolCallId).toBe(\\\"call_a\\\");\\n    77\\t  });\\n    78\\t});\\n    79\\t\\n    80\\tdescribe(\\\"Story 2: error tool result (TC-2.5)\\\", () => {\\n    81\\t  it(\\\"captures an error tool_result with the error flag and its content, dropping nothing\\\", async () => {\\n    82\\t    const started = await startCapture(store);\\n    83\\t    const { connector, ctx } = started;\\n    84\\t\\n    85\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"read missing.txt\\\")));\\n    86\\t    await connector.handlers.message_end(\\n    87\\t      ctx,\\n    88\\t      makeMessageEnd(makeAssistantMessage({ toolCalls: [{ id: \\\"call_a\\\", name: \\\"read_file\\\", arguments: { path: \\\"missing.txt\\\" } }] })),\\n    89\\t    );\\n    90\\t    await connector.handlers.message_end(\\n    91\\t      ctx,\\n    92\\t      makeMessageEnd(makeToolResult({ id: \\\"call_a\\\", isError: true, content: \\\"ENOENT: no such file\\\" })),\\n    93\\t    );\\n    94\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"it does not exist\\\" })));\\n    95\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    96\\t\\n    97\\t    const events = await eventsAfterShutdown(started);\\n    98\\t    // Nothing dropped because the tool failed.\\n    99\\t    expect(kindsOf(events)).toEqual([\\\"user_prompt\\\", \\\"tool_call\\\", \\\"tool_result\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]);\\n   100\\t\\n   101\\t    const result = events.find((event) => event.eventKind === \\\"tool_result\\\");\\n   102\\t    expect(result).toBeDefined();\\n   103\\t    expect(toolResultPayload(result!).isError).toBe(true);\\n   104\\t    expect(toolResultPayload(result!).content).toBe(\\\"ENOENT: no such file\\\");\\n   105\\t  });\\n   106\\t});\\n   107\\t\\n   108\\tdescribe(\\\"Story 2: idempotent re-delivery (TC-2.7, idempotency risk)\\\", () => {\\n   109\\t  it(\\\"skips a re-delivered batch by idempotency key and records no duplicates\\\", async () => {\\n   110\\t    const thread = await makeTempThread(store);\\n   111\\t    const built = await initInstance(thread.threadRef, {\\n   112\\t      provider: createDeterministicProvider(),\\n   113\\t      mode: \\\"background\\\",\\n   114\\t    });\\n   115\\t    expect(built.ok).toBe(true);\\n   116\\t    if (!built.ok) return;\\n   117\\t    const instance = built.value;\\n   118\\t\\n   119\\t    // Build one logical turn's events through the real map + accumulator, so the\\n   120\\t    // keys are exactly what production would emit.\\n   121\\t    const acc = new TurnAccumulator({ piSessionId: \\\"sess\\\" });\\n   122\\t    const userEvents = mapMessage(makeUserMessage(\\\"hello\\\"), { piSessionId: \\\"sess\\\", entryId: \\\"s0\\\" });\\n   123\\t    acc.onMessage(userEvents);\\n   124\\t    const assistantEvents = mapMessage(makeAssistantMessage({ text: \\\"hi there\\\" }), {\\n   125\\t      piSessionId: \\\"sess\\\",\\n   126\\t      entryId: \\\"s1\\\",\\n   127\\t    });\\n   128\\t    acc.onMessage(assistantEvents);\\n   129\\t    const turnEnd = acc.onAgentEnd();\\n   130\\t    const batch = [...userEvents, ...assistantEvents, ...turnEnd];\\n   131\\t\\n   132\\t    const first = await capture(batch, instance);\\n   133\\t    expect(first.ok).toBe(true);\\n   134\\t    if (first.ok) {\\n   135\\t      expect(first.value.events.every((entry) => entry.outcome === \\\"recorded\\\")).toBe(true);\\n   136\\t    }\\n   137\\t\\n   138\\t    // Re-delivery (the reload / crash-replay path): identical keys → all skipped.\\n   139\\t    const second = await capture(batch, instance);\\n   140\\t    expect(second.ok).toBe(true);\\n   141\\t    if (second.ok) {\\n   142\\t      expect(second.value.events.every((entry) => entry.outcome === \\\"skipped\\\")).toBe(true);\\n   143\\t      expect(\\n   144\\t        second.value.events.every((entry) => entry.skipReason === \\\"duplicate_idempotency_key\\\"),\\n   145\\t      ).toBe(true);\\n   146\\t    }\\n   147\\t\\n   148\\t    // No duplicate records landed on the thread.\\n   149\\t    const read = await intakeStream.listEvents(instance.threadRef);\\n   150\\t    expect(read.ok).toBe(true);\\n   151\\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\\n   152\\t\\n   153\\t    await instance.dispose();\\n   154\\t  });\\n   155\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:56:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_27\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/converter.test.ts'\",\"aggregated_output\":\"     1\\t// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\\n     2\\t// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\\n     3\\t// production path runs end to end — PI hook → converter → real LHC intake —\\n     4\\t// and every assertion reads the durable thread back. TC-2.8 also exercises\\n     5\\t// capture() directly because the two failure shapes (writable→gap vs\\n     6\\t// store-unavailable→health) are the architecture-risk contract.\\n     7\\timport { rmSync } from \\\"node:fs\\\";\\n     8\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     9\\timport {\\n    10\\t  createDeterministicProvider,\\n    11\\t  intakeStream,\\n    12\\t  threads,\\n    13\\t  type MessageEventInput,\\n    14\\t  type ThreadRef,\\n    15\\t} from \\\"lhc\\\";\\n    16\\timport { capture } from \\\"../../src/capture/converter.js\\\";\\n    17\\timport { initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    18\\timport type { LhcInstance } from \\\"../../src/shared/instance.js\\\";\\n    19\\timport {\\n    20\\t  makeAgentEnd,\\n    21\\t  makeAssistantMessage,\\n    22\\t  makeMessageEnd,\\n    23\\t  makeToolResult,\\n    24\\t  makeUserMessage,\\n    25\\t  validEvent,\\n    26\\t} from \\\"../fixtures/synthetic.js\\\";\\n    27\\timport { makeTempThread, tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    28\\timport { eventsAfterShutdown, kindsOf, startCapture } from \\\"./support.js\\\";\\n    29\\t\\n    30\\tlet store: TempStore;\\n    31\\tbeforeEach(() => {\\n    32\\t  store = tempStore();\\n    33\\t});\\n    34\\tafterEach(() => {\\n    35\\t  store.cleanup();\\n    36\\t});\\n    37\\t\\n    38\\tfunction textOf(event: MessageEventInput): string {\\n    39\\t  return (event.payload as { text?: string }).text ?? \\\"\\\";\\n    40\\t}\\n    41\\t\\n    42\\tdescribe(\\\"Story 2: converter — capture and fan-out (TC-2.1)\\\", () => {\\n    43\\t  it(\\\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\\\", async () => {\\n    44\\t    const started = await startCapture(store);\\n    45\\t    const { connector, ctx } = started;\\n    46\\t\\n    47\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"read the file\\\")));\\n    48\\t    await connector.handlers.message_end(\\n    49\\t      ctx,\\n    50\\t      makeMessageEnd(\\n    51\\t        makeAssistantMessage({\\n    52\\t          thinking: \\\"I should open it\\\",\\n    53\\t          text: \\\"here is the answer\\\",\\n    54\\t          toolCalls: [{ id: \\\"call_x\\\", name: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } }],\\n    55\\t        }),\\n    56\\t      ),\\n    57\\t    );\\n    58\\t    await connector.handlers.message_end(\\n    59\\t      ctx,\\n    60\\t      makeMessageEnd(makeToolResult({ id: \\\"call_x\\\", content: \\\"file body\\\" })),\\n    61\\t    );\\n    62\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    63\\t\\n    64\\t    // No silent capture failure on the happy path.\\n    65\\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\\n    66\\t\\n    67\\t    const events = await eventsAfterShutdown(started);\\n    68\\t    expect(kindsOf(events)).toEqual([\\n    69\\t      \\\"user_prompt\\\",\\n    70\\t      \\\"assistant_thinking\\\",\\n    71\\t      \\\"assistant_text\\\",\\n    72\\t      \\\"tool_call\\\",\\n    73\\t      \\\"tool_result\\\",\\n    74\\t      \\\"turn_end\\\",\\n    75\\t    ]);\\n    76\\t\\n    77\\t    expect(textOf(events[0]!)).toBe(\\\"read the file\\\");\\n    78\\t    expect(textOf(events[1]!)).toBe(\\\"I should open it\\\");\\n    79\\t    expect(textOf(events[2]!)).toBe(\\\"here is the answer\\\");\\n    80\\t    expect(events[3]!.payload).toMatchObject({\\n    81\\t      toolCallId: \\\"call_x\\\",\\n    82\\t      toolName: \\\"read_file\\\",\\n    83\\t      arguments: { path: \\\"notes.txt\\\" },\\n    84\\t    });\\n    85\\t    expect(events[4]!.payload).toMatchObject({ toolCallId: \\\"call_x\\\", content: \\\"file body\\\" });\\n    86\\t  });\\n    87\\t});\\n    88\\t\\n    89\\tdescribe(\\\"Story 2: converter — runtime-change capture (TC-2.9)\\\", () => {\\n    90\\t  it(\\\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\\\", async () => {\\n    91\\t    const started = await startCapture(store);\\n    92\\t    const { connector, ctx } = started;\\n    93\\t\\n    94\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"go\\\")));\\n    95\\t    await connector.handlers.model_select(ctx, {\\n    96\\t      model: { provider: \\\"openai\\\", id: \\\"gpt-4o\\\" },\\n    97\\t      previousModel: { provider: \\\"anthropic\\\", id: \\\"claude-3\\\" },\\n    98\\t    });\\n    99\\t    await connector.handlers.thinking_level_select(ctx, { level: \\\"high\\\", previousLevel: \\\"low\\\" });\\n   100\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"done\\\" })));\\n   101\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n   102\\t\\n   103\\t    const events = await eventsAfterShutdown(started);\\n   104\\t    // Ordering relative to the surrounding messages is preserved.\\n   105\\t    expect(kindsOf(events)).toEqual([\\n   106\\t      \\\"user_prompt\\\",\\n   107\\t      \\\"runtime_note\\\",\\n   108\\t      \\\"runtime_note\\\",\\n   109\\t      \\\"assistant_text\\\",\\n   110\\t      \\\"turn_end\\\",\\n   111\\t    ]);\\n   112\\t\\n   113\\t    const modelNote = textOf(events[1]!);\\n   114\\t    expect(modelNote).toContain(\\\"anthropic/claude-3\\\");\\n   115\\t    expect(modelNote).toContain(\\\"openai/gpt-4o\\\");\\n   116\\t\\n   117\\t    const levelNote = textOf(events[2]!);\\n   118\\t    expect(levelNote).toContain(\\\"low\\\");\\n   119\\t    expect(levelNote).toContain(\\\"high\\\");\\n   120\\t  });\\n   121\\t});\\n   122\\t\\n   123\\tdescribe(\\\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\\\", () => {\\n   124\\t  async function liveInstance(): Promise<LhcInstance> {\\n   125\\t    const thread = await makeTempThread(store);\\n   126\\t    const built = await initInstance(thread.threadRef, {\\n   127\\t      provider: createDeterministicProvider(),\\n   128\\t      mode: \\\"background\\\",\\n   129\\t    });\\n   130\\t    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\\n   131\\t    return built.value;\\n   132\\t  }\\n   133\\t\\n   134\\t  it(\\\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\\\", async () => {\\n   135\\t    const instance = await liveInstance();\\n   136\\t    // A turn_end with a non-empty payload is rejected by LHC validation\\n   137\\t    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\\n   138\\t    const malformed = {\\n   139\\t      eventKind: \\\"turn_end\\\",\\n   140\\t      idempotencyKey: \\\"malformed-1\\\",\\n   141\\t      actor: \\\"system\\\",\\n   142\\t      harness: \\\"pi\\\",\\n   143\\t      payload: { stowaway: true },\\n   144\\t    } as unknown as MessageEventInput;\\n   145\\t\\n   146\\t    const result = await capture([malformed], instance);\\n   147\\t    expect(result.ok).toBe(false);\\n   148\\t\\n   149\\t    // The session continues: a durable, queryable gap is recorded on the thread.\\n   150\\t    const read = await intakeStream.listEvents(instance.threadRef);\\n   151\\t    expect(read.ok).toBe(true);\\n   152\\t    if (!read.ok) return;\\n   153\\t    const gaps = read.value.filter(\\n   154\\t      (event) =>\\n   155\\t        event.eventKind === \\\"runtime_note\\\" &&\\n   156\\t        (event.payload as { text: string }).text.toLowerCase().includes(\\\"gap\\\"),\\n   157\\t    );\\n   158\\t    expect(gaps).toHaveLength(1);\\n   159\\t\\n   160\\t    await instance.dispose();\\n   161\\t  });\\n   162\\t\\n   163\\t  it(\\\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\\\", async () => {\\n   164\\t    const deadInstance: LhcInstance = {\\n   165\\t      sdk: (await liveInstance()).sdk,\\n   166\\t      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\\n   167\\t      dispose: () => Promise.resolve({ ok: true, value: undefined }),\\n   168\\t    };\\n   169\\t\\n   170\\t    // capture isolates the failure into a structured result rather than throwing.\\n   171\\t    const result = await capture([validEvent(\\\"user_prompt\\\")], deadInstance);\\n   172\\t    expect(result.ok).toBe(false);\\n   173\\t    if (result.ok) return;\\n   174\\t    expect([\\\"thread_not_found\\\", \\\"storage_failure\\\"]).toContain(result.error.code);\\n   175\\t    // It is NOT misclassified as the writable-thread malformed-event case.\\n   176\\t    expect(result.error.code).not.toBe(\\\"invalid_event\\\");\\n   177\\t  });\\n   178\\t\\n   179\\t  it(\\\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\\\", async () => {\\n   180\\t    const started = await startCapture(store);\\n   181\\t    const { connector, ctx, threadRef } = started;\\n   182\\t\\n   183\\t    // Make the live thread's store unavailable mid-session, then capture.\\n   184\\t    const id = (threadRef as { threadId: string }).threadId;\\n   185\\t    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n   186\\t    expect(row.ok).toBe(true);\\n   187\\t    if (!row.ok) return;\\n   188\\t    rmSync(row.value.filePath, { force: true });\\n   189\\t\\n   190\\t    // The hook must not throw despite the dead store.\\n   191\\t    await expect(\\n   192\\t      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"after the store died\\\"))),\\n   193\\t    ).resolves.toBeUndefined();\\n   194\\t\\n   195\\t    const health = connector.getState()?.health.lastCaptureFailure;\\n   196\\t    expect(health).toBeDefined();\\n   197\\t    expect(health?.recordedGap).toBe(false);\\n   198\\t\\n   199\\t    await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n   200\\t  });\\n   201\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:57:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_25\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/abort.test.ts'\",\"aggregated_output\":\"     1\\t// Story 2 — graceful interrupt (TC-2.6). A turn PI marks aborted is captured\\n     2\\t// whole: the partial assistant content is recorded, the aborted disposition is\\n     3\\t// carried through (the mapper carries stopReason — research §5b — onto the only\\n     4\\t// durable vehicle, a runtime_note), and the turn closes complete-but-aborted at\\n     5\\t// agent_end. The interrupted content is never discarded.\\n     6\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     7\\timport type { MessageEventInput } from \\\"lhc\\\";\\n     8\\timport {\\n     9\\t  makeAgentEnd,\\n    10\\t  makeAssistantMessage,\\n    11\\t  makeMessageEnd,\\n    12\\t  makeUserMessage,\\n    13\\t} from \\\"../fixtures/synthetic.js\\\";\\n    14\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    15\\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \\\"./support.js\\\";\\n    16\\t\\n    17\\tlet store: TempStore;\\n    18\\tbeforeEach(() => {\\n    19\\t  store = tempStore();\\n    20\\t});\\n    21\\tafterEach(() => {\\n    22\\t  store.cleanup();\\n    23\\t});\\n    24\\t\\n    25\\tfunction textOf(event: MessageEventInput): string {\\n    26\\t  return (event.payload as { text?: string }).text ?? \\\"\\\";\\n    27\\t}\\n    28\\t\\n    29\\tdescribe(\\\"Story 2: graceful interrupt (TC-2.6)\\\", () => {\\n    30\\t  it(\\\"records partial assistant content, carries the aborted disposition, and closes the turn complete-but-aborted\\\", async () => {\\n    31\\t    const started = await startCapture(store);\\n    32\\t    const { connector, ctx, threadRef } = started;\\n    33\\t\\n    34\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"write a long essay\\\")));\\n    35\\t    await connector.handlers.message_end(\\n    36\\t      ctx,\\n    37\\t      makeMessageEnd(\\n    38\\t        makeAssistantMessage({ thinking: \\\"starting the essay\\\", text: \\\"Once upon a\\\", stopReason: \\\"aborted\\\" }),\\n    39\\t      ),\\n    40\\t    );\\n    41\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    42\\t\\n    43\\t    // A graceful interrupt is not a capture failure.\\n    44\\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\\n    45\\t\\n    46\\t    const events = await eventsAfterShutdown(started);\\n    47\\t    expect(kindsOf(events)).toEqual([\\n    48\\t      \\\"user_prompt\\\",\\n    49\\t      \\\"assistant_thinking\\\",\\n    50\\t      \\\"assistant_text\\\",\\n    51\\t      \\\"runtime_note\\\",\\n    52\\t      \\\"turn_end\\\",\\n    53\\t    ]);\\n    54\\t\\n    55\\t    // Partial content is preserved verbatim — nothing discarded.\\n    56\\t    expect(textOf(events[1]!)).toBe(\\\"starting the essay\\\");\\n    57\\t    expect(textOf(events[2]!)).toBe(\\\"Once upon a\\\");\\n    58\\t    // The aborted disposition is carried through on the runtime_note.\\n    59\\t    expect(textOf(events[3]!).toLowerCase()).toContain(\\\"abort\\\");\\n    60\\t\\n    61\\t    // The turn closes complete-but-aborted (closed at agent_end, not left open).\\n    62\\t    const counts = await turnCounts(threadRef);\\n    63\\t    expect(counts.closed).toBe(1);\\n    64\\t    expect(counts.open).toBe(0);\\n    65\\t  });\\n    66\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:58:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_28\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/turn-derivation.test.ts'\",\"aggregated_output\":\"     1\\t// Story 2 — turn derivation, the load-bearing mechanic. An LHC turn spans a\\n     2\\t// whole exchange: it opens on a user prompt, ignores every PI per-step\\n     3\\t// `turn_end`, and closes with exactly one LHC `turn_end` at `agent_end`\\n     4\\t// (TC-2.2). Session order is the converter's source-event order, never PI's\\n     5\\t// per-run `turnIndex` (TC-2.3). The accumulator goldens pin the state machine\\n     6\\t// directly, including the hard-kill tolerance (a dangling open turn, and an\\n     7\\t// agent_end with no open turn as a no-op).\\n     8\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     9\\timport type { MessageEventInput } from \\\"lhc\\\";\\n    10\\timport { TurnAccumulator } from \\\"../../src/capture/turn-accumulator.js\\\";\\n    11\\timport {\\n    12\\t  makeAgentEnd,\\n    13\\t  makeAssistantMessage,\\n    14\\t  makeMessageEnd,\\n    15\\t  makeToolResult,\\n    16\\t  makeUserMessage,\\n    17\\t  validEvent,\\n    18\\t} from \\\"../fixtures/synthetic.js\\\";\\n    19\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    20\\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \\\"./support.js\\\";\\n    21\\t\\n    22\\tlet store: TempStore;\\n    23\\tbeforeEach(() => {\\n    24\\t  store = tempStore();\\n    25\\t});\\n    26\\tafterEach(() => {\\n    27\\t  store.cleanup();\\n    28\\t});\\n    29\\t\\n    30\\tfunction textOf(event: MessageEventInput): string {\\n    31\\t  return (event.payload as { text?: string }).text ?? \\\"\\\";\\n    32\\t}\\n    33\\t\\n    34\\t// A PI per-step turn_end payload (ignored by the converter as a boundary).\\n    35\\tfunction piTurnEnd(turnIndex: number) {\\n    36\\t  return { turnIndex, message: makeAssistantMessage({ text: \\\"step\\\" }), toolResults: [] };\\n    37\\t}\\n    38\\t\\n    39\\tdescribe(\\\"Story 2: turn derivation — worked example (TC-2.2)\\\", () => {\\n    40\\t  it(\\\"yields exactly one LHC turn with one turn_end at agent_end; PI per-step turn_ends produce none\\\", async () => {\\n    41\\t    const started = await startCapture(store);\\n    42\\t    const { connector, ctx, threadRef } = started;\\n    43\\t\\n    44\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"ask one question\\\")));\\n    45\\t    await connector.handlers.message_end(\\n    46\\t      ctx,\\n    47\\t      makeMessageEnd(\\n    48\\t        makeAssistantMessage({\\n    49\\t          thinking: \\\"two tools needed\\\",\\n    50\\t          toolCalls: [\\n    51\\t            { id: \\\"call_a\\\", name: \\\"read_file\\\", arguments: { path: \\\"a.txt\\\" } },\\n    52\\t            { id: \\\"call_b\\\", name: \\\"read_file\\\", arguments: { path: \\\"b.txt\\\" } },\\n    53\\t          ],\\n    54\\t        }),\\n    55\\t      ),\\n    56\\t    );\\n    57\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_b\\\", content: \\\"b\\\" })));\\n    58\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \\\"call_a\\\", content: \\\"a\\\" })));\\n    59\\t    // PI fires a per-step turn_end here — it must NOT become an LHC turn_end.\\n    60\\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\\n    61\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"the answer\\\" })));\\n    62\\t    await connector.handlers.turn_end(ctx, piTurnEnd(1));\\n    63\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    64\\t\\n    65\\t    const events = await eventsAfterShutdown(started);\\n    66\\t    expect(kindsOf(events)).toEqual([\\n    67\\t      \\\"user_prompt\\\",\\n    68\\t      \\\"assistant_thinking\\\",\\n    69\\t      \\\"tool_call\\\",\\n    70\\t      \\\"tool_call\\\",\\n    71\\t      \\\"tool_result\\\",\\n    72\\t      \\\"tool_result\\\",\\n    73\\t      \\\"assistant_text\\\",\\n    74\\t      \\\"turn_end\\\",\\n    75\\t    ]);\\n    76\\t    // Exactly one LHC turn_end, and it lands last — at agent_end, not per PI step.\\n    77\\t    expect(events.filter((event) => event.eventKind === \\\"turn_end\\\")).toHaveLength(1);\\n    78\\t    expect(events.at(-1)?.eventKind).toBe(\\\"turn_end\\\");\\n    79\\t\\n    80\\t    const counts = await turnCounts(threadRef);\\n    81\\t    expect(counts.closed).toBe(1);\\n    82\\t    expect(counts.open).toBe(0);\\n    83\\t  });\\n    84\\t});\\n    85\\t\\n    86\\tdescribe(\\\"Story 2: turn derivation — source order, not turnIndex (TC-2.3)\\\", () => {\\n    87\\t  it(\\\"orders two agent runs that each start at turnIndex 0 by source-event order, with no collision\\\", async () => {\\n    88\\t    const started = await startCapture(store);\\n    89\\t    const { connector, ctx, threadRef } = started;\\n    90\\t\\n    91\\t    // Run 1 (PI turnIndex 0)\\n    92\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"first prompt\\\")));\\n    93\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"first answer\\\" })));\\n    94\\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\\n    95\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n    96\\t    // Run 2 (PI turnIndex 0 AGAIN — the reset-per-run counter)\\n    97\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"second prompt\\\")));\\n    98\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \\\"second answer\\\" })));\\n    99\\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\\n   100\\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\\n   101\\t\\n   102\\t    const events = await eventsAfterShutdown(started);\\n   103\\t    expect(kindsOf(events)).toEqual([\\n   104\\t      \\\"user_prompt\\\",\\n   105\\t      \\\"assistant_text\\\",\\n   106\\t      \\\"turn_end\\\",\\n   107\\t      \\\"user_prompt\\\",\\n   108\\t      \\\"assistant_text\\\",\\n   109\\t      \\\"turn_end\\\",\\n   110\\t    ]);\\n   111\\t    // Source order decides sequence: run 1 precedes run 2 despite identical turnIndex.\\n   112\\t    expect(textOf(events[0]!)).toBe(\\\"first prompt\\\");\\n   113\\t    expect(textOf(events[3]!)).toBe(\\\"second prompt\\\");\\n   114\\t\\n   115\\t    const counts = await turnCounts(threadRef);\\n   116\\t    expect(counts.closed).toBe(2);\\n   117\\t    expect(counts.open).toBe(0);\\n   118\\t  });\\n   119\\t});\\n   120\\t\\n   121\\tdescribe(\\\"Story 2: turn accumulator — state machine goldens (AC-2.2)\\\", () => {\\n   122\\t  it(\\\"emits one turn_end only when a turn is open, and is idempotent across agent_end\\\", () => {\\n   123\\t    const acc = new TurnAccumulator({ piSessionId: \\\"sess\\\" });\\n   124\\t    expect(acc.hasOpenTurn()).toBe(false);\\n   125\\t\\n   126\\t    acc.onMessage([validEvent(\\\"user_prompt\\\")]);\\n   127\\t    expect(acc.hasOpenTurn()).toBe(true);\\n   128\\t\\n   129\\t    const emitted = acc.onAgentEnd();\\n   130\\t    expect(emitted).toHaveLength(1);\\n   131\\t    expect(emitted[0]?.eventKind).toBe(\\\"turn_end\\\");\\n   132\\t    expect(emitted[0]?.payload).toEqual({});\\n   133\\t    expect(acc.hasOpenTurn()).toBe(false);\\n   134\\t\\n   135\\t    // A second agent_end with no open turn emits nothing (hard-kill / reattach\\n   136\\t    // tolerance: turn_end-with-no-open-turn is a no-op).\\n   137\\t    expect(acc.onAgentEnd()).toEqual([]);\\n   138\\t  });\\n   139\\t\\n   140\\t  it(\\\"gives successive turns distinct turn_end idempotency keys\\\", () => {\\n   141\\t    const acc = new TurnAccumulator({ piSessionId: \\\"sess\\\" });\\n   142\\t    acc.onMessage([validEvent(\\\"user_prompt\\\")]);\\n   143\\t    const first = acc.onAgentEnd();\\n   144\\t    acc.onMessage([validEvent(\\\"user_prompt\\\")]);\\n   145\\t    const second = acc.onAgentEnd();\\n   146\\t    expect(first[0]?.idempotencyKey).not.toBe(second[0]?.idempotencyKey);\\n   147\\t  });\\n   148\\t});\\n   149\\t\\n   150\\tdescribe(\\\"Story 2: turn derivation — hard-kill golden\\\", () => {\\n   151\\t  it(\\\"leaves a dangling open turn when the run never reaches agent_end, with no turn_end recorded\\\", async () => {\\n   152\\t    const started = await startCapture(store);\\n   153\\t    const { connector, ctx, threadRef } = started;\\n   154\\t\\n   155\\t    // Hard kill: a user message lands, then the process dies — no assistant\\n   156\\t    // close, no agent_end.\\n   157\\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\\\"dangling prompt\\\")));\\n   158\\t    await connector.getInstance()?.sdk.drainSettled(threadRef);\\n   159\\t\\n   160\\t    const counts = await turnCounts(threadRef);\\n   161\\t    expect(counts.open).toBe(1);\\n   162\\t    expect(counts.closed).toBe(0);\\n   163\\t\\n   164\\t    const events = await eventsAfterShutdown(started);\\n   165\\t    expect(events.filter((event) => event.eventKind === \\\"turn_end\\\")).toHaveLength(0);\\n   166\\t    expect(kindsOf(events)).toEqual([\\\"user_prompt\\\"]);\\n   167\\t  });\\n   168\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:60:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_29\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/synthetic.ts'\",\"aggregated_output\":\"     1\\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\\n     2\\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\\n     3\\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\\n     4\\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\\n     5\\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\\n     6\\timport type { EventKind, MessageEventInput } from \\\"lhc\\\";\\n     7\\timport type {\\n     8\\t  AgentEndEvent,\\n     9\\t  AgentMessage,\\n    10\\t  AssistantMessage,\\n    11\\t  ContentPart,\\n    12\\t  MessageEndEvent,\\n    13\\t  PiStopReason,\\n    14\\t  SessionStartEvent,\\n    15\\t  SessionStartReason,\\n    16\\t  ToolResultMessage,\\n    17\\t  UserMessage,\\n    18\\t} from \\\"../../src/pi/types.js\\\";\\n    19\\t\\n    20\\t// ── LHC intake-event builder ─────────────────────────────────────────\\n    21\\t\\n    22\\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\\n    23\\t\\n    24\\tlet keyCounter = 0;\\n    25\\t/** Reset the per-call key counter so a test can build deterministic keys. */\\n    26\\texport function resetEventKeyCounter(): void {\\n    27\\t  keyCounter = 0;\\n    28\\t}\\n    29\\t\\n    30\\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\\\"payload\\\"] } = {\\n    31\\t  user_prompt: () => ({ text: \\\"please read the file\\\" }),\\n    32\\t  assistant_text: () => ({ text: \\\"here is what I found\\\" }),\\n    33\\t  assistant_thinking: () => ({ text: \\\"considering the file contents\\\" }),\\n    34\\t  runtime_note: () => ({ text: \\\"model changed: anthropic/claude → openai/gpt\\\" }),\\n    35\\t  tool_call: () => ({ toolCallId: \\\"call-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } }),\\n    36\\t  tool_result: () => ({ toolCallId: \\\"call-1\\\", content: \\\"contents of notes.txt\\\", isError: false }),\\n    37\\t  turn_end: () => ({}),\\n    38\\t};\\n    39\\t\\n    40\\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\\n    41\\t *  mismatch at a call site is a compile error; the final reconciliation goes\\n    42\\t *  through `unknown` (TS can't reduce a structural spread to the deferred\\n    43\\t *  Extract), with call-site safety living in the parameter types. */\\n    44\\texport function validEvent<K extends EventKind>(\\n    45\\t  kind: K,\\n    46\\t  overrides: Partial<Omit<EventByKind<K>, \\\"eventKind\\\">> = {},\\n    47\\t): EventByKind<K> {\\n    48\\t  keyCounter += 1;\\n    49\\t  const base = {\\n    50\\t    eventKind: kind,\\n    51\\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\\n    52\\t    actor: \\\"fixture-actor\\\",\\n    53\\t    harness: \\\"pi\\\",\\n    54\\t    payload: defaultPayloads[kind](),\\n    55\\t  };\\n    56\\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\\n    57\\t}\\n    58\\t\\n    59\\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\\n    60\\t  return kinds.map((kind) => validEvent(kind));\\n    61\\t}\\n    62\\t\\n    63\\t// ── PI message builders ──────────────────────────────────────────────\\n    64\\t\\n    65\\texport function makeUserMessage(text = \\\"please read the file\\\"): UserMessage {\\n    66\\t  return { role: \\\"user\\\", content: [{ type: \\\"text\\\", text }] };\\n    67\\t}\\n    68\\t\\n    69\\texport interface AssistantToolCall {\\n    70\\t  id: string;\\n    71\\t  name: string;\\n    72\\t  arguments?: Record<string, unknown>;\\n    73\\t}\\n    74\\t\\n    75\\t/** Fans out to content parts in PI's confirmed order: thinking → text →\\n    76\\t *  toolCall×N (research §5a). */\\n    77\\texport function makeAssistantMessage(\\n    78\\t  opts: {\\n    79\\t    thinking?: string;\\n    80\\t    text?: string;\\n    81\\t    toolCalls?: AssistantToolCall[];\\n    82\\t    stopReason?: PiStopReason;\\n    83\\t  } = {},\\n    84\\t): AssistantMessage {\\n    85\\t  const content: ContentPart[] = [];\\n    86\\t  if (opts.thinking !== undefined) content.push({ type: \\\"thinking\\\", thinking: opts.thinking });\\n    87\\t  if (opts.text !== undefined) content.push({ type: \\\"text\\\", text: opts.text });\\n    88\\t  for (const call of opts.toolCalls ?? []) {\\n    89\\t    content.push({ type: \\\"toolCall\\\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\\n    90\\t  }\\n    91\\t  const msg: AssistantMessage = { role: \\\"assistant\\\", content };\\n    92\\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\\n    93\\t  return msg;\\n    94\\t}\\n    95\\t\\n    96\\texport function makeToolResult(opts: {\\n    97\\t  id: string;\\n    98\\t  isError?: boolean;\\n    99\\t  content?: string;\\n   100\\t}): ToolResultMessage {\\n   101\\t  const msg: ToolResultMessage = {\\n   102\\t    role: \\\"toolResult\\\",\\n   103\\t    toolCallId: opts.id,\\n   104\\t    content: [{ type: \\\"text\\\", text: opts.content ?? \\\"tool output\\\" }],\\n   105\\t  };\\n   106\\t  if (opts.isError !== undefined) msg.isError = opts.isError;\\n   107\\t  return msg;\\n   108\\t}\\n   109\\t\\n   110\\t// ── PI event-stream builders ─────────────────────────────────────────\\n   111\\t\\n   112\\texport function makeSessionStart(\\n   113\\t  reason: SessionStartReason = \\\"startup\\\",\\n   114\\t  previousSessionFile?: string,\\n   115\\t): SessionStartEvent {\\n   116\\t  const ev: SessionStartEvent = { reason };\\n   117\\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\\n   118\\t  return ev;\\n   119\\t}\\n   120\\t\\n   121\\texport function makeMessageEnd(message: AgentMessage): MessageEndEvent {\\n   122\\t  return { message };\\n   123\\t}\\n   124\\t\\n   125\\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\\n   126\\t  return { messages };\\n   127\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:63:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_30\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/idempotency.test.ts'\",\"aggregated_output\":\"     1\\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\\n     2\\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\\n     3\\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\\n     4\\t// must add nothing the second time. The key goldens pin construction precedence:\\n     5\\t// PI entry id → provider response / tool-call id → content fingerprint, with\\n     6\\t// blockIndex and kind disambiguating one message's fan-out.\\n     7\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     8\\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \\\"lhc\\\";\\n     9\\timport { capture } from \\\"../../src/capture/converter.js\\\";\\n    10\\timport { eventKey } from \\\"../../src/capture/idempotency.js\\\";\\n    11\\timport { mapMessage } from \\\"../../src/capture/map-message.js\\\";\\n    12\\timport { TurnAccumulator } from \\\"../../src/capture/turn-accumulator.js\\\";\\n    13\\timport { initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n    14\\timport type { AgentMessage } from \\\"../../src/pi/types.js\\\";\\n    15\\timport { loadToolHeavyCorpus } from \\\"../fixtures/corpus.js\\\";\\n    16\\timport { makeTempThread, tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n    17\\t\\n    18\\tlet store: TempStore;\\n    19\\tbeforeEach(() => {\\n    20\\t  store = tempStore();\\n    21\\t});\\n    22\\tafterEach(() => {\\n    23\\t  store.cleanup();\\n    24\\t});\\n    25\\t\\n    26\\tdescribe(\\\"Story 2: idempotency key construction (deterministic goldens)\\\", () => {\\n    27\\t  it(\\\"is deterministic: identical input yields an identical key\\\", () => {\\n    28\\t    const input = { piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 0, kind: \\\"assistant_text\\\" } as const;\\n    29\\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\\n    30\\t  });\\n    31\\t\\n    32\\t  it(\\\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\\\", () => {\\n    33\\t    const thinking = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 0, kind: \\\"assistant_thinking\\\" });\\n    34\\t    const text = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 1, kind: \\\"assistant_text\\\" });\\n    35\\t    const textSameBlock = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e1\\\", blockIndex: 0, kind: \\\"assistant_text\\\" });\\n    36\\t    expect(thinking).toContain(\\\"e1\\\");\\n    37\\t    // Same entry, different block → different key (fan-out stays distinct).\\n    38\\t    expect(text).not.toBe(thinking);\\n    39\\t    // Same entry + block, different kind → still distinct.\\n    40\\t    expect(textSameBlock).not.toBe(thinking);\\n    41\\t  });\\n    42\\t\\n    43\\t  it(\\\"falls to the tool-call id when no entry id is present, separating call from result by kind\\\", () => {\\n    44\\t    const call = eventKey({ piSessionId: \\\"s\\\", toolCallId: \\\"call_a\\\", blockIndex: 0, kind: \\\"tool_call\\\" });\\n    45\\t    const result = eventKey({ piSessionId: \\\"s\\\", toolCallId: \\\"call_a\\\", blockIndex: 0, kind: \\\"tool_result\\\" });\\n    46\\t    expect(call).toContain(\\\"call_a\\\");\\n    47\\t    expect(result).toContain(\\\"call_a\\\");\\n    48\\t    expect(call).not.toBe(result);\\n    49\\t  });\\n    50\\t\\n    51\\t  it(\\\"falls to the provider response id below the entry id, above the content fingerprint\\\", () => {\\n    52\\t    const key = eventKey({ piSessionId: \\\"s\\\", responseId: \\\"resp_7\\\", blockIndex: 0, kind: \\\"assistant_text\\\" });\\n    53\\t    expect(key).toContain(\\\"resp_7\\\");\\n    54\\t  });\\n    55\\t\\n    56\\t  it(\\\"falls to a content fingerprint as last resort: same content same key, different content different key\\\", () => {\\n    57\\t    const a = eventKey({ piSessionId: \\\"s\\\", blockIndex: 0, kind: \\\"user_prompt\\\", role: \\\"user\\\", content: \\\"hello\\\" });\\n    58\\t    const aAgain = eventKey({ piSessionId: \\\"s\\\", blockIndex: 0, kind: \\\"user_prompt\\\", role: \\\"user\\\", content: \\\"hello\\\" });\\n    59\\t    const b = eventKey({ piSessionId: \\\"s\\\", blockIndex: 0, kind: \\\"user_prompt\\\", role: \\\"user\\\", content: \\\"world\\\" });\\n    60\\t    expect(aAgain).toBe(a);\\n    61\\t    expect(b).not.toBe(a);\\n    62\\t  });\\n    63\\t\\n    64\\t  it(\\\"honors precedence: a present entry id wins over a present tool-call id\\\", () => {\\n    65\\t    const withBoth = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e9\\\", toolCallId: \\\"call_z\\\", blockIndex: 0, kind: \\\"tool_call\\\" });\\n    66\\t    const entryOnly = eventKey({ piSessionId: \\\"s\\\", entryId: \\\"e9\\\", blockIndex: 0, kind: \\\"tool_call\\\" });\\n    67\\t    expect(withBoth).toBe(entryOnly);\\n    68\\t  });\\n    69\\t});\\n    70\\t\\n    71\\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\\n    72\\t  const acc = new TurnAccumulator({ piSessionId: \\\"corpus\\\" });\\n    73\\t  const events: MessageEventInput[] = [];\\n    74\\t  source.forEach((message, index) => {\\n    75\\t    const mapped = mapMessage(message, { piSessionId: \\\"corpus\\\", entryId: `s${index}` });\\n    76\\t    acc.onMessage(mapped);\\n    77\\t    events.push(...mapped);\\n    78\\t  });\\n    79\\t  events.push(...acc.onAgentEnd());\\n    80\\t  return events;\\n    81\\t}\\n    82\\t\\n    83\\tdescribe(\\\"Story 2: corpus double-replay (idempotency architecture-risk)\\\", () => {\\n    84\\t  it(\\\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\\\", async () => {\\n    85\\t    const thread = await makeTempThread(store);\\n    86\\t    const built = await initInstance(thread.threadRef, {\\n    87\\t      provider: createDeterministicProvider(),\\n    88\\t      mode: \\\"background\\\",\\n    89\\t    });\\n    90\\t    expect(built.ok).toBe(true);\\n    91\\t    if (!built.ok) return;\\n    92\\t    const instance = built.value;\\n    93\\t\\n    94\\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\\n    95\\t\\n    96\\t    const first = await capture(batch, instance);\\n    97\\t    expect(first.ok).toBe(true);\\n    98\\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \\\"recorded\\\")).toBe(true);\\n    99\\t\\n   100\\t    const replay = await capture(batch, instance);\\n   101\\t    expect(replay.ok).toBe(true);\\n   102\\t    if (replay.ok) {\\n   103\\t      expect(replay.value.events.every((entry) => entry.outcome === \\\"skipped\\\")).toBe(true);\\n   104\\t    }\\n   105\\t\\n   106\\t    const read = await intakeStream.listEvents(instance.threadRef);\\n   107\\t    expect(read.ok).toBe(true);\\n   108\\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\\n   109\\t\\n   110\\t    await instance.dispose();\\n   111\\t  });\\n   112\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:64:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_31\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/support.ts'\",\"aggregated_output\":\"     1\\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\\n     2\\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\\n     3\\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\\n     4\\t// converter → real LHC intake) so every capture test asserts on recorded\\n     5\\t// thread state, never on a mocked intake. The two external edges stay as the\\n     6\\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\\n     7\\t// SDK runs real against a temp SQLite thread with the deterministic provider\\n     8\\t// (selected by explicit name, never a production default).\\n     9\\timport {\\n    10\\t  createDeterministicProvider,\\n    11\\t  inspect,\\n    12\\t  intakeStream,\\n    13\\t  type EventKind,\\n    14\\t  type MessageEventInput,\\n    15\\t  type OpResult,\\n    16\\t  type SdkConfig,\\n    17\\t  type ThreadRef,\\n    18\\t} from \\\"lhc\\\";\\n    19\\timport { createConnector, type Connector } from \\\"../../src/index.js\\\";\\n    20\\timport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\n    21\\timport { makeSessionStart } from \\\"../fixtures/synthetic.js\\\";\\n    22\\timport type { TempStore } from \\\"../fixtures/thread.js\\\";\\n    23\\t\\n    24\\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\\n    25\\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\\n    26\\t *  assume a TUI. */\\n    27\\texport function syntheticCtx(cwd = \\\"/work/capture\\\"): ExtensionContext {\\n    28\\t  return {\\n    29\\t    cwd,\\n    30\\t    hasUI: false,\\n    31\\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\\n    32\\t    ui: { notify: () => {} },\\n    33\\t    sessionManager: { getEntries: () => [] },\\n    34\\t  };\\n    35\\t}\\n    36\\t\\n    37\\t/** The capture-suite SDK config: a real background instance on the\\n    38\\t *  deterministic provider, so a captured user_prompt's queued derivation has a\\n    39\\t *  handler to settle and never strands background work. */\\n    40\\texport function captureConfig(): OpResult<SdkConfig> {\\n    41\\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \\\"background\\\" } };\\n    42\\t}\\n    43\\t\\n    44\\texport interface StartedCapture {\\n    45\\t  connector: Connector;\\n    46\\t  ctx: ExtensionContext;\\n    47\\t  threadRef: ThreadRef;\\n    48\\t}\\n    49\\t\\n    50\\t/** Start a connector against a temp store and fire `session_start{new}` so a\\n    51\\t *  background instance + thread exist and the capture hooks are live. */\\n    52\\texport async function startCapture(store: TempStore, cwd = \\\"/work/capture\\\"): Promise<StartedCapture> {\\n    53\\t  const connector = createConnector({\\n    54\\t    registryPath: store.registryPath,\\n    55\\t    newThreadFilePath: () => store.threadPath(),\\n    56\\t    parseLaunch: () => ({}),\\n    57\\t    buildSdkConfig: () => captureConfig(),\\n    58\\t  });\\n    59\\t  const ctx = syntheticCtx(cwd);\\n    60\\t  await connector.handlers.session_start(ctx, makeSessionStart(\\\"new\\\"));\\n    61\\t  const state = connector.getState();\\n    62\\t  if (state === null) throw new Error(\\\"startCapture: session_start did not resolve a thread\\\");\\n    63\\t  return { connector, ctx, threadRef: state.threadRef };\\n    64\\t}\\n    65\\t\\n    66\\t/** Settle background work and dispose, then read the durable event log back in\\n    67\\t *  recorded order — capture's product is the stored thread, so tests assert on\\n    68\\t *  this. */\\n    69\\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\\n    70\\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \\\"shutdown\\\" });\\n    71\\t  const read = await intakeStream.listEvents(started.threadRef);\\n    72\\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\\n    73\\t  // Strip the server-stamped fields so the comparison is over the logical\\n    74\\t  // intake shape the converter produced.\\n    75\\t  return read.value.map((record) => ({\\n    76\\t    eventKind: record.eventKind,\\n    77\\t    idempotencyKey: record.idempotencyKey,\\n    78\\t    actor: record.actor,\\n    79\\t    harness: record.harness,\\n    80\\t    payload: record.payload,\\n    81\\t  })) as MessageEventInput[];\\n    82\\t}\\n    83\\t\\n    84\\t/** The ordered event-kind sequence — the spine every capture test checks. */\\n    85\\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\\n    86\\t  return events.map((event) => event.eventKind);\\n    87\\t}\\n    88\\t\\n    89\\t/** Counts open/closed turns and total recorded events from the inspect\\n    90\\t *  overview (the real read-back surface, not a private query). */\\n    91\\texport async function turnCounts(\\n    92\\t  threadRef: ThreadRef,\\n    93\\t): Promise<{ open: number; closed: number; events: number }> {\\n    94\\t  const overview = await inspect.overview(threadRef);\\n    95\\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\\n    96\\t  return {\\n    97\\t    open: overview.value.turns.open,\\n    98\\t    closed: overview.value.turns.closed,\\n    99\\t    events: overview.value.events.count,\\n   100\\t  };\\n   101\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:88:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_43\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"node --input-type=module <<'NODE'\\nimport { mkdtempSync, rmSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { createDeterministicProvider, intakeStream } from 'lhc';\\nimport { createConnector } from './dist/index.js';\\n\\nconst dir = mkdtempSync(join(tmpdir(), 'pi-lhc-reload-'));\\nconst registryPath = join(dir, 'registry.sqlite');\\nlet n = 0;\\nconst newThreadFilePath = () => join(dir, \\\"'`thread-${++n}.sqlite`);\\nconst ctx = {\\n  cwd: '\\\"'/work/reload-capture',\\n  hasUI: false,\\n  modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\\n  ui: { notify: () => {} },\\n  sessionManager: { getEntries: () => [] },\\n};\\nconst deps = {\\n  registryPath,\\n  newThreadFilePath,\\n  parseLaunch: () => ({}),\\n  buildSdkConfig: () => ({ ok: true, value: { provider: createDeterministicProvider(), mode: 'background' } }),\\n};\\nconst user = (text) => ({ message: { role: 'user', content: [{ type: 'text', text }] } });\\nconst start = (reason) => ({ reason });\\n\\nconst a = createConnector(deps);\\nawait a.handlers.session_start(ctx, start('new'));\\nconst ref = a.getState().threadRef;\\nawait a.handlers.message_end(ctx, user('first'));\\nawait a.handlers.session_shutdown(ctx, { reason: 'reload' });\\n\\nconst b = createConnector(deps);\\nawait b.handlers.session_start(ctx, start('reload'));\\nawait b.handlers.message_end(ctx, user('second'));\\nawait b.handlers.session_shutdown(ctx, { reason: 'shutdown' });\\n\\nconst read = await intakeStream.listEvents(ref);\\nconsole.log(JSON.stringify({ ok: read.ok, events: read.ok ? read.value.map(e => ({ kind: e.eventKind, key: e.idempotencyKey, text: e.payload.text })) : read.error, diag: b.snapshot().lastDiagnostic }, null, 2));\\nrmSync(dir, { recursive: true, force: true });\\nNODE\\\"\",\"aggregated_output\":\"(node:75228) ExperimentalWarning: SQLite is an experimental feature and might change at any time\\n(Use `node --trace-warnings ...` to show where the warning was created)\\n{\\n  \\\"ok\\\": true,\\n  \\\"events\\\": [\\n    {\\n      \\\"kind\\\": \\\"user_prompt\\\",\\n      \\\"key\\\": \\\"pi:th_d1fc3d71df1144d3:entry:s0:0:user_prompt\\\",\\n      \\\"text\\\": \\\"first\\\"\\n    }\\n  ],\\n  \\\"diag\\\": null\\n}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:90:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_44\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"node --input-type=module <<'NODE'\\nimport { mkdtempSync, rmSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { createDeterministicProvider, intakeStream } from 'lhc';\\nimport { createConnector } from './dist/index.js';\\n\\nconst dir = mkdtempSync(join(tmpdir(), 'pi-lhc-resume-'));\\nconst registryPath = join(dir, 'registry.sqlite');\\nlet n = 0;\\nconst newThreadFilePath = () => join(dir, \\\"'`thread-${++n}.sqlite`);\\nconst ctx = {\\n  cwd: '\\\"'/work/resume-capture',\\n  hasUI: false,\\n  modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\\n  ui: { notify: () => {} },\\n  sessionManager: { getEntries: () => [] },\\n};\\nconst config = () => ({ ok: true, value: { provider: createDeterministicProvider(), mode: 'background' } });\\nconst user = (text) => ({ message: { role: 'user', content: [{ type: 'text', text }] } });\\n\\nconst a = createConnector({ registryPath, newThreadFilePath, parseLaunch: () => ({}), buildSdkConfig: config });\\nawait a.handlers.session_start(ctx, { reason: 'new' });\\nconst ref = a.getState().threadRef;\\nconst id = ref.threadId;\\nawait a.handlers.message_end(ctx, user('first'));\\nawait a.handlers.session_shutdown(ctx, { reason: 'shutdown' });\\n\\nconst b = createConnector({ registryPath, newThreadFilePath, parseLaunch: () => ({ session: id }), buildSdkConfig: config });\\nawait b.handlers.session_start(ctx, { reason: 'resume' });\\nawait b.handlers.message_end(ctx, user('second after resume'));\\nawait b.handlers.session_shutdown(ctx, { reason: 'shutdown' });\\n\\nconst read = await intakeStream.listEvents(ref);\\nconsole.log(JSON.stringify({ ok: read.ok, events: read.ok ? read.value.map(e => ({ kind: e.eventKind, key: e.idempotencyKey, text: e.payload.text })) : read.error, diag: b.snapshot().lastDiagnostic }, null, 2));\\nrmSync(dir, { recursive: true, force: true });\\nNODE\\\"\",\"aggregated_output\":\"(node:75819) ExperimentalWarning: SQLite is an experimental feature and might change at any time\\n(Use `node --trace-warnings ...` to show where the warning was created)\\n{\\n  \\\"ok\\\": true,\\n  \\\"events\\\": [\\n    {\\n      \\\"kind\\\": \\\"user_prompt\\\",\\n      \\\"key\\\": \\\"pi:th_947f6dd71f50d513:entry:s0:0:user_prompt\\\",\\n      \\\"text\\\": \\\"first\\\"\\n    }\\n  ],\\n  \\\"diag\\\": null\\n}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/streams/004-verify.stdout.log:91:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_45\",\"type\":\"agent_message\",\"text\":\"{\\\"artifactsRead\\\":[\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/stories/02-event-capture-and-turn-derivation.md\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/test-plan.md\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/epic.md\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/converter.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/map-message.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/idempotency.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/runtime-changes.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/turn-accumulator.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/state.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/pi/types.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/converter.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/turn-derivation.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/abort.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/idempotency.test.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/support.ts\\\",\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/package.json\\\",\\\"manual node reproduction: resume/reload idempotency collision using built packages/pi-lhc/dist/index.js\\\"],\\\"reviewScopeSummary\\\":\\\"Initial verification covered Story 2 AC/TC requirements, Flow 2 tech design, capture/runtime production paths, Story 2 tests, configured gates, and manual existing-thread reattach scenarios.\\\",\\\"priorFindingStatuses\\\":[],\\\"newFindings\\\":[{\\\"id\\\":\\\"SV-001\\\",\\\"severity\\\":\\\"critical\\\",\\\"title\\\":\\\"Existing-thread resume/reload can silently skip new finalized events\\\",\\\"evidence\\\":\\\"AC-2.1 requires every finalized PI message to be recorded exactly once, and AC-2.6/TC-2.7 require duplicate safety without normal-resume historical replay. On every session_start, createConnector resets captureSession.sourceSeq to 0 in packages/pi-lhc/src/index.ts:310-318; nextEntryId then returns s0, s1, ... in packages/pi-lhc/src/index.ts:352-357; message/runtime hooks use that generated entryId in packages/pi-lhc/src/index.ts:362-384. eventKey gives entryId first precedence in packages/pi-lhc/src/capture/idempotency.ts:35-40, so a fresh connector attached to an existing thread reuses prior keys. Manual reproduction against the built production connector: after recording user_prompt 'first', starting a fresh connector with --session for the same thread and recording user_prompt 'second after resume', intakeStream.listEvents returned only the first event with key pi:th_947f6dd71f50d513:entry:s0:0:user_prompt and connector diag was null. The same reload shape returned only the first event with key pi:th_d1fc3d71df1144d3:entry:s0:0:user_prompt. Existing TC-2.7 coverage in packages/pi-lhc/test/capture/parallel-and-errors.test.ts:108-153 only proves identical batch re-delivery skips; it does not prove normal resume/reload continues recording new events.\\\",\\\"affectedFiles\\\":[\\\"packages/pi-lhc/src/index.ts\\\",\\\"packages/pi-lhc/src/capture/idempotency.ts\\\",\\\"packages/pi-lhc/test/capture/parallel-and-errors.test.ts\\\",\\\"packages/pi-lhc/test/capture/idempotency.test.ts\\\"],\\\"requirementIds\\\":[\\\"AC-2.1\\\",\\\"AC-2.6\\\",\\\"AC-2.7\\\",\\\"TC-2.7\\\"],\\\"recommendedFixScope\\\":\\\"same-session-implementor\\\",\\\"blocking\\\":true}],\\\"openFindings\\\":[{\\\"id\\\":\\\"SV-001\\\",\\\"severity\\\":\\\"critical\\\",\\\"title\\\":\\\"Existing-thread resume/reload can silently skip new finalized events\\\",\\\"evidence\\\":\\\"AC-2.1 requires every finalized PI message to be recorded exactly once, and AC-2.6/TC-2.7 require duplicate safety without normal-resume historical replay. On every session_start, createConnector resets captureSession.sourceSeq to 0 in packages/pi-lhc/src/index.ts:310-318; nextEntryId then returns s0, s1, ... in packages/pi-lhc/src/index.ts:352-357; message/runtime hooks use that generated entryId in packages/pi-lhc/src/index.ts:362-384. eventKey gives entryId first precedence in packages/pi-lhc/src/capture/idempotency.ts:35-40, so a fresh connector attached to an existing thread reuses prior keys. Manual reproduction against the built production connector: after recording user_prompt 'first', starting a fresh connector with --session for the same thread and recording user_prompt 'second after resu
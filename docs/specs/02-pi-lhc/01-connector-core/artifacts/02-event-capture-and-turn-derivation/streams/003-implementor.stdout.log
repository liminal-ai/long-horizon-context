{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01SL3Uh1HmMxrdprNSmcEWM1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014181KgcrZRL725B7Sa8may","name":"Edit","input":{"replace_all":false,"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.ts","old_string":"    source: [\n      makeUserMessage(\"write a long essay\"),\n      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n      validEvent(\"turn_end\"),\n    ],","new_string":"    source: [\n      makeUserMessage(\"write a long essay\"),\n      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n      // The aborted disposition rides a trailing runtime_note (the mapper carries\n      // stopReason through; research §5b), then the turn closes complete-but-aborted.\n      validEvent(\"runtime_note\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\n      validEvent(\"turn_end\"),\n    ],"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":244,"cache_creation_input_tokens":1042,"cache_read_input_tokens":303476,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1042},"output_tokens":50,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_m
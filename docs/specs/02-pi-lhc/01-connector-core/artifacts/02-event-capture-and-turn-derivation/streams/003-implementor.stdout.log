{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015DzMVh1QyFnLU6Gx6F31YT","type":"tool_result","content":"1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n2\t// named lifecycle paired with the LHC intake events it should produce. Until M0\n3\t// delivers real recordings, the loaders build synthetic stand-ins; the\n4\t// machinery (load → validate shape → compare on replay in Story 3) is real and\n5\t// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n6\t// hardcodes a passing count (story §Anti-Shim Requirements).\n7\timport type { EventKind } from \"lhc\";\n8\timport type { Corpus } from \"../../src/verify/replay.js\";\n9\timport {\n10\t  makeAssistantMessage,\n11\t  makeToolResult,\n12\t  makeUserMessage,\n13\t  validEvent,\n14\t} from \"./synthetic.js\";\n15\t\n16\tconst CALL_A = \"call_a|fc_1\";\n17\tconst CALL_B = \"call_b|fc_2\";\n18\t\n19\t/** Plain user/assistant text exchanges, no tools. */\n20\texport function loadChattyCorpus(): Corpus {\n21\t  return {\n22\t    name: \"chatty\",\n23\t    source: [\n24\t      makeUserMessage(\"what does this repo do?\"),\n25\t      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n26\t      makeUserMessage(\"and the connector?\"),\n27\t      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n28\t    ],\n29\t    expected: [\n30\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n31\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n32\t      validEvent(\"turn_end\"),\n33\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n34\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n35\t      validEvent(\"turn_end\"),\n36\t    ],\n37\t  };\n38\t}\n39\t\n40\t/** One turn with a single tool run: thinking → call → result → answer. */\n41\texport function loadToolHeavyCorpus(): Corpus {\n42\t  return {\n43\t    name: \"tool-heavy\",\n44\t    source: [\n45\t      makeUserMessage(\"read notes.txt\"),\n46\t      makeAssistantMessage({\n47\t        thinking: \"I should open the file\",\n48\t        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n49\t      }),\n50\t      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n51\t      makeAssistantMessage({ text: \"the file says hello\" }),\n52\t    ],\n53\t    expected: [\n54\t      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n55\t      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n56\t      validEvent(\"tool_call\", {\n57\t        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n58\t      }),\n59\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n60\t      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n61\t      validEvent(\"turn_end\"),\n62\t    ],\n63\t  };\n64\t}\n65\t\n66\t/** Two parallel tool calls whose results complete out of order; correlation is\n67\t *  by id, not arrival order (AC-2.3). */\n68\texport function loadParallelToolCorpus(): Corpus {\n69\t  return {\n70\t    name: \"parallel-tool\",\n71\t    source: [\n72\t      makeUserMessage(\"read both files\"),\n73\t      makeAssistantMessage({\n74\t        toolCalls: [\n75\t          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n76\t          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n77\t        ],\n78\t      }),\n79\t      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n80\t      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n81\t      makeAssistantMessage({ text: \"read both\" }),\n82\t    ],\n83\t    expected: [\n84\t      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n85\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n86\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n87\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n88\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n89\t      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n90\t      validEvent(\"turn_end\"),\n91\t    ],\n92\t  };\n93\t}\n94\t\n95\t/** A tool result flagged as an error, captured with its content (AC-2.4). */\n96\texport function loadErrorResultCorpus(): Corpus {\n97\t  return {\n98\t    name: \"error-result\",\n99\t    source: [\n100\t      makeUserMessage(\"read missing.txt\"),\n101\t      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n102\t      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n103\t      makeAssistantMessage({ text: \"that file does not exist\" }),\n104\t    ],\n105\t    expected: [\n106\t      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n107\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n108\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n109\t      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n110\t      validEvent(\"turn_end\"),\n111\t    ],\n112\t  };\n113\t}\n114\t\n115\t/** A graceful interrupt: partial assistant content, turn closed\n116\t *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\n117\texport function loadAbortedTurnCorpus(): Corpus {\n118\t  return {\n119\t    name: \"aborted-turn\",\n120\t    source: [\n121\t      makeUserMessage(\"write a long essay\"),\n122\t      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n123\t    ],\n124\t    expected: [\n125\t      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n126\t      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n127\t      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n128\t      validEvent(\"turn_end\"),\n129\t    ],\n130\t  };\n131\t}\n132\t\n133\texport const CORPUS_LOADERS = {\n134\t  chatty: loadChattyCorpus,\n135\t  \"tool-heavy\": loadToolHeavyCorpus,\n136\t  \"parallel-tool\": loadParallelToolCorpus,\n137\t  \"error-result\": loadErrorResultCorpus,\n138\t  \"aborted-turn\": loadAbortedTurnCorpus,\n139\t} as const;\n140\t\n141\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n142\t\n143\texport function loadAllCorpora(): Corpus[] {\n144\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n145\t}\n146\t\n147\t/** A deliberately malformed sequence for the capture-failure test: an empty\n148\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n149\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n150\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n151\texport function makeTruncatedCorpus(): Corpus {\n152\t  return {\n153\t    name: \"truncated\",\n154\t    source: [makeUserMessage(\"\")],\n155\t    expected: [\n156\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n157\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n158\t    ],\n159\t  };\n160\t}\n161\t\n162\texport interface CorpusValidation {\n163\t  valid: boolean;\n164\t  problems: string[];\n165\t}\n166\t\n167\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n168\t  \"user_prompt\",\n169\t  \"assistant_text\",\n170\t  \"assistant_thinking\",\n171\t  \"runtime_note\",\n172\t  \"tool_call\",\n173\t  \"tool_result\",\n174\t  \"turn_end\",\n175\t]);\n176\t\n177\t/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n178\t *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n179\t *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n180\t *  found — `valid` is derived from that list, never a constant. */\n181\texport function validateCorpus(corpus: Corpus): CorpusValidation {\n182\t  const problems: string[] = [];\n183\t  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n184\t  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n185\t\n186\t  const seenToolCalls = new Set<string>();\n187\t  for (const [i, ev] of corpus.expected.entries()) {\n188\t    const at = `${corpus.name}[${i}]`;\n189\t    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n190\t    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n191\t    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n192\t    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n193\t\n194\t    switch (ev.eventKind) {\n195\t      case \"user_prompt\":\n196\t      case \"assistant_text\":\n197\t      case \"assistant_thinking\":\n198\t      case \"runtime_note\": {\n199\t        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n200\t          problems.push(`${at}: ${ev.eventKind} has empty text`);\n201\t        }\n202\t        break;\n203\t      }\n204\t      case \"tool_call\": {\n205\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n206\t          problems.push(`${at}: tool_call has empty toolCallId`);\n207\t        } else {\n208\t          seenToolCalls.add(ev.payload.toolCallId);\n209\t        }\n210\t        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n211\t          problems.push(`${at}: tool_call has empty toolName`);\n212\t        }\n213\t        break;\n214\t      }\n215\t      case \"tool_result\": {\n216\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n217\t          problems.push(`${at}: tool_result has empty toolCallId`);\n218\t        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n219\t          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n220\t        }\n221\t        if (typeof ev.payload.content !== \"string\") {\n222\t          problems.push(`${at}: tool_result has non-string content`);\n223\t        }\n224\t        break;\n225\t      }\n226\t      case \"turn_end\":\n227\t        break;\n228\t    }\n229\t  }\n230\t\n231\t  const last = corpus.expected[corpus.expected.length - 1];\n232\t  if (last !== undefined && last.eventKind !== \"turn_end\") {\n233\t    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n234\t  }\n235\t\n236\t  return { valid: problems.length === 0, problems };\n237\t}\n238\t"}]},"parent_tool_use_id":null,"session_id":"4562dd99-e915-4997-a6b6-c06f59211979","uuid":"33e68273-792c-4d17-afa1-f0e1f606f679","timestamp":"2026-06-14T07:08:24.143Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/corpus.ts","content":"// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n// named lifecycle paired with the LHC intake events it should produce. Until M0\n// delivers real recordings, the loaders build synthetic stand-ins; the\n// machinery (load → validate shape → compare on replay in Story 3) is real and\n// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n// hardcodes a passing count (story §Anti-Shim Requirements).\nimport type { EventKind } from \"lhc\";\nimport type { Corpus } from \"../../src/verify/replay.js\";\nimport {\n  makeAssistantMessage,\n  makeToolResult,\n  makeUserMessage,\n  validEvent,\n} from \"./synthetic.js\";\n\nconst CALL_A = \"call_a|fc_1\";\nconst CALL_B = \"call_b|fc_2\";\n\n/** Plain user/assistant text exchanges, no tools. */\nexport function loadChattyCorpus(): Corpus {\n  return {\n    name: \"chatty\",\n    source: [\n      makeUserMessage(\"what does this repo do?\"),\n      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n      makeUserMessage(\"and the connector?\"),\n      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n      validEvent(\"turn_end\"),\n      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** One turn with a single tool run: thinking → call → result → answer. */\nexport function loadToolHeavyCorpus(): Corpus {\n  return {\n    name: \"tool-heavy\",\n    source: [\n      makeUserMessage(\"read notes.txt\"),\n      makeAssistantMessage({\n        thinking: \"I should open the file\",\n        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n      }),\n      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n      makeAssistantMessage({ text: \"the file says hello\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n      }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** Two parallel tool calls whose results complete out of order; correlation is\n *  by id, not arrival order (AC-2.3). */\nexport function loadParallelToolCorpus(): Corpus {\n  return {\n    name: \"parallel-tool\",\n    source: [\n      makeUserMessage(\"read both files\"),\n      makeAssistantMessage({\n        toolCalls: [\n          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n        ],\n      }),\n      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n      makeAssistantMessage({ text: \"read both\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** A tool result flagged as an error, captured with its content (AC-2.4). */\nexport function loadErrorResultCorpus(): Corpus {\n  return {\n    name: \"error-result\",\n    source: [\n      makeUserMessage(\"read missing.txt\"),\n      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n      makeAssistantMessage({ text: \"that file does not exist\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\n/** A graceful interrupt: partial assistant content, turn closed\n *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\nexport function loadAbortedTurnCorpus(): Corpus {\n  return {\n    name: \"aborted-turn\",\n    source: [\n      makeUserMessage(\"write a long essay\"),\n      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    ],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  };\n}\n\nexport const CORPUS_LOADERS = {\n  chatty: loadChattyCorpus,\n  \"tool-heavy\": loadToolHeavyCorpus,\n  \"parallel-tool\": loadParallelToolCorpus,\n  \"error-result\": loadErrorResultCorpus,\n  \"aborted-turn\": loadAbortedTurnCorpus,\n} as const;\n\nexport type CorpusName = keyof typeof CORPUS_LOADERS;\n\nexport function loadAllCorpora(): Corpus[] {\n  return Object.values(CORPUS_LOADERS).map((load) => load());\n}\n\n/** A deliberately malformed sequence for the capture-failure test: an empty\n *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n *  proving the validator actually inspects shape rather than rubber-stamping. */\nexport function makeTruncatedCorpus(): Corpus {\n  return {\n    name: \"truncated\",\n    source: [makeUserMessage(\"\")],\n    expected: [\n      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n    ],\n  };\n}\n\nexport interface CorpusValidation {\n  valid: boolean;\n  problems: string[];\n}\n\nconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n  \"user_prompt\",\n  \"assistant_text\",\n  \"assistant_thinking\",\n  \"runtime_note\",\n  \"tool_call\",\n  \"tool_result\",\n  \"turn_end\",\n]);\n\n/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n *  found — `valid` is derived from that list, never a constant. */\nexport function validateCorpus(corpus: Corpus): CorpusValidation {\n  const problems: string[] = [];\n  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n\n  const seenToolCalls = new Set<string>();\n  for (const [i, ev] of corpus.expected.entries()) {\n    const at = `${corpus.name}[${i}]`;\n    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n\n    switch (ev.eventKind) {\n      case \"user_prompt\":\n      case \"assistant_text\":\n      case \"assistant_thinking\":\n      case \"runtime_note\": {\n        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n          problems.push(`${at}: ${ev.eventKind} has empty text`);\n        }\n        break;\n      }\n      case \"tool_call\": {\n        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n          problems.push(`${at}: tool_call has empty toolCallId`);\n        } else {\n          seenToolCalls.add(ev.payload.toolCallId);\n        }\n        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n          problems.push(`${at}: tool_call has empty toolName`);\n        }\n        break;\n      }\n      case \"tool_result\": {\n        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n          problems.push(`${at}: tool_result has empty toolCallId`);\n        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n        }\n        if (typeof ev.payload.content !== \"string\") {\n          problems.push(`${at}: tool_result has non-string content`);\n        }\n        break;\n      }\n      case \"turn_end\":\n        break;\n    }\n  }\n\n  const last = corpus.expected[corpus.expected.length - 1];\n  if (last !== undefined && last.eventKind !== \"turn_end\") {\n    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n  }\n\n  return { valid: problems.length === 0, problems };\n}\n","numLines":238,"startLine":1,"totalLines":238}}}

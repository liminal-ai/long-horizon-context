{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QAfXU7xcD8i8mr9XVfY9Po","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  DerivationProvider,\n12\t  OpResult,\n13\t  ProviderResult,\n14\t  SdkConfig,\n15\t  ThreadRef,\n16\t} from \"lhc\";\n17\timport type {\n18\t  ExtensionAPI,\n19\t  ExtensionContext,\n20\t  PiHookHandler,\n21\t  PiHookName,\n22\t} from \"./pi/types.js\";\n23\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n24\timport { createSessionState } from \"./lifecycle/state.js\";\n25\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n26\timport {\n27\t  parseLaunchFlags,\n28\t  resolveReloadThread,\n29\t  resolveThread,\n30\t  type LaunchFlags,\n31\t  type ResolveDeps,\n32\t} from \"./lifecycle/thread-resolution.js\";\n33\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n34\timport type { LhcInstance } from \"./shared/instance.js\";\n35\t\n36\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n37\texport type { LhcInstance } from \"./shared/instance.js\";\n38\t\n39\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n40\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n41\t *  registers no handler for it (story Scope Out). */\n42\texport const EPIC_1_HOOKS = [\n43\t  \"session_start\",\n44\t  \"message_end\",\n45\t  \"turn_end\",\n46\t  \"agent_end\",\n47\t  \"model_select\",\n48\t  \"thinking_level_select\",\n49\t  \"session_before_fork\",\n50\t  \"session_before_switch\",\n51\t  \"session_shutdown\",\n52\t] as const satisfies readonly PiHookName[];\n53\t\n54\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n55\t\n56\t/** What the connector needs from the host to run a session. Every dependency\n57\t *  has a working production default; the overrides exist for test isolation\n58\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n59\t *  in the PI-auth-backed inference config.\n60\t *\n61\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n62\t *  default is the observe-only config below (a real, construction-valid SDK);\n63\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n64\texport interface ConnectorDeps {\n65\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n66\t  registryPath?: string;\n67\t  newThreadFilePath?: () => string;\n68\t  parseLaunch?: () => LaunchFlags;\n69\t  selectThread?: (\n70\t    choices: readonly ThreadChoice[],\n71\t    ctx: ExtensionContext,\n72\t  ) => Promise<string | null>;\n73\t}\n74\t\n75\t/** Everything the connector retains across hooks as PLAIN data — by\n76\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n77\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n78\t *  deliberately not part of the snapshot. */\n79\texport interface ConnectorSnapshot {\n80\t  state: SessionState | null;\n81\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n82\t}\n83\t\n84\texport interface Connector {\n85\t  /** Register the observe-only hook rail on the PI extension API. */\n86\t  register(pi: ExtensionAPI): void;\n87\t  /** The plain-data state retained across hooks. `null` until a session\n88\t   *  resolves a thread; never holds a PI ctx. */\n89\t  getState(): SessionState | null;\n90\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n91\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n92\t  getInstance(): LhcInstance | null;\n93\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n94\t  snapshot(): ConnectorSnapshot;\n95\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n96\t   *  synthetic ctx/events without a live PI. */\n97\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n98\t}\n99\t\n100\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n101\t\n102\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n103\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n104\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n105\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n106\t *  derivation work is ever queued and this provider is never invoked — it exists\n107\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n108\t *\n109\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n110\t *  documents as \"selectable only by explicit name — never a production default\"\n111\t *  (it would mark fake derived text into the thread). Failing closed preserves\n112\t *  the observe-only guarantee even if a future change queued work before Stories\n113\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n114\t *  assignments), which is what a real *completing* inference requires (the\n115\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n116\tfunction observeOnlyProvider(): DerivationProvider {\n117\t  const notConfigured = (): Promise<ProviderResult> =>\n118\t    Promise.resolve({\n119\t      ok: false,\n120\t      retryable: false,\n121\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n122\t    });\n123\t  return {\n124\t    smoothPrompt: notConfigured,\n125\t    summarizeToolCall: notConfigured,\n126\t    summarizeToolResult: notConfigured,\n127\t    composeTurnRendering: notConfigured,\n128\t    projectLowerBand: notConfigured,\n129\t    summarizeChunkDetailed: notConfigured,\n130\t    summarizeChunkBrief: notConfigured,\n131\t  };\n132\t}\n133\t\n134\t/** The production observe-only SDK config: a real, construction-valid instance\n135\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n136\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n137\t *  config. */\n138\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n139\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n140\t}\n141\t\n142\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n143\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n144\t *  show. */\n145\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n146\t  const lines = choices.map((choice, i) => {\n147\t    const title = choice.title ?? \"(untitled)\";\n148\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n149\t  });\n150\t  return [\n151\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n152\t    ...lines,\n153\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n154\t  ].join(\"\\n\");\n155\t}\n156\t\n157\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n158\t *  interactive input/selection surface (wiring research), so the production\n159\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n160\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n161\t *  most recently created thread as the best available explicit default. The\n162\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n163\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n164\t *  A true interactive picker awaits a PI input surface; until then resuming a\n165\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n166\t *  precise spec deviation. */\n167\tfunction defaultSelectThread(\n168\t  choices: readonly ThreadChoice[],\n169\t  ctx: ExtensionContext,\n170\t): Promise<string | null> {\n171\t  const mostRecent = choices.at(-1);\n172\t  if (mostRecent === undefined) return Promise.resolve(null);\n173\t  if (ctx.hasUI) {\n174\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n175\t  }\n176\t  return Promise.resolve(mostRecent.threadId);\n177\t}\n178\t\n179\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n180\t *  generated by the registry at creation, so the file name is just a unique\n181\t *  handle; the directory is ensured up front (DatabaseSync does not create\n182\t *  parents). */\n183\tfunction defaultNewThreadFilePath(): string {\n184\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n185\t  mkdirSync(dir, { recursive: true });\n186\t  return join(dir, `${randomUUID()}.sqlite`);\n187\t}\n188\t\n189\t/** Build a connector instance. Its mutable state lives in this closure; the\n190\t *  registered handlers capture it, so the instance stays live for the session\n191\t *  even when `activate` discards the returned object. The connector holds NO\n192\t *  module-level or durable state of its own — reload reconstructs the thread from\n193\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n194\t *  closure reattaches correctly (AC-1.5). */\n195\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n196\t  // The connector's retained state. `state` is plain data (the durable thread\n197\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n198\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n199\t  // none survives the connector — reload re-resolves from the registry.\n200\t  let state: SessionState | null = null;\n201\t  let instance: LhcInstance | null = null;\n202\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n203\t\n204\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n205\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n206\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n207\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n208\t\n209\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n210\t    return { code, message, recordedGap: false };\n211\t  }\n212\t\n213\t  // The registry/file deps every resolver path shares. `registryPath` is set\n214\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n215\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n216\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n217\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n218\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n219\t    return resolveDeps;\n220\t  }\n221\t\n222\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n223\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n224\t  // no-flag creates).\n225\t  async function resolveForLaunch(\n226\t    launch: LaunchFlags,\n227\t    ctx: ExtensionContext,\n228\t  ): Promise<OpResult<ThreadRef | null>> {\n229\t    if (launch.resume === true) {\n230\t      const pickerDeps: {\n231\t        registryPath?: string;\n232\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n233\t      } = { select: (choices) => selectThread(choices, ctx) };\n234\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n235\t      return pickThread(ctx.cwd, pickerDeps);\n236\t    }\n237\t    return resolveThread(launch, buildResolveDeps(ctx));\n238\t  }\n239\t\n240\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n241\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n242\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n243\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n244\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n245\t  async function resolveReloadFor(\n246\t    launch: LaunchFlags,\n247\t    ctx: ExtensionContext,\n248\t  ): Promise<OpResult<ThreadRef | null>> {\n249\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n250\t  }\n251\t\n252\t  // session_start: resolve the recording thread and construct one background\n253\t  // instance against it. Config is gated first so a session with no usable\n254\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n255\t  // thread is re-resolved from the durable registry (reattach, never create);\n256\t  // every other reason runs the normal launch resolution.\n257\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n258\t    const config = buildSdkConfig(ctx);\n259\t    if (!config.ok) {\n260\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n261\t      return;\n262\t    }\n263\t    const launch = parseLaunch();\n264\t    const isReload = event.reason === \"reload\";\n265\t    const resolved = isReload\n266\t      ? await resolveReloadFor(launch, ctx)\n267\t      : await resolveForLaunch(launch, ctx);\n268\t    if (!resolved.ok) {\n269\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n270\t      return;\n271\t    }\n272\t    if (resolved.value === null) {\n273\t      lastDiagnostic = isReload\n274\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n275\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n276\t      return;\n277\t    }\n278\t    const built = await initInstance(resolved.value, config.value);\n279\t    if (!built.ok) {\n280\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n281\t      return;\n282\t    }\n283\t    instance = built.value;\n284\t    state = createSessionState(resolved.value);\n285\t  };\n286\t\n287\t  // Dispose with flush before any session swap (session_before_switch fires\n288\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n289\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n290\t  // re-resolves its thread from the durable registry on the next session_start.\n291\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n292\t    const result = await disposeInstance(instance);\n293\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n294\t    instance = null;\n295\t  };\n296\t\n297\t  // Contain every handler: an observe-only hook must never throw back into PI\n298\t  // (a thrown hook breaks the user's session). A caught error becomes a\n299\t  // plain-data diagnostic; it is never rethrown.\n300\t  const guard = (\n301\t    name: Epic1Hook,\n302\t    body: PiHookHandler<Epic1Hook>,\n303\t  ): PiHookHandler<Epic1Hook> => {\n304\t    return async (ctx, event): Promise<void> => {\n305\t      try {\n306\t        await body(ctx, event);\n307\t      } catch (err) {\n308\t        lastDiagnostic = {\n309\t          code: \"hook_handler_error\",\n310\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n311\t          recordedGap: false,\n312\t        };\n313\t      }\n314\t    };\n315\t  };\n316\t\n317\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n318\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n319\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\n320\t  const noop: PiHookHandler<Epic1Hook> = () => {\n321\t    // Intentionally empty — later stories replace this with real routing.\n322\t  };\n323\t\n324\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n325\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n326\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n327\t    session_before_switch: onDispose,\n328\t    session_shutdown: onDispose,\n329\t    message_end: noop,\n330\t    turn_end: noop,\n331\t    agent_end: noop,\n332\t    model_select: noop,\n333\t    thinking_level_select: noop,\n334\t    session_before_fork: noop,\n335\t  };\n336\t\n337\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n338\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n339\t\n340\t  return {\n341\t    handlers,\n342\t    register(pi: ExtensionAPI): void {\n343\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n344\t    },\n345\t    getState(): SessionState | null {\n346\t      return state;\n347\t    },\n348\t    getInstance(): LhcInstance | null {\n349\t      return instance;\n350\t    },\n351\t    snapshot(): ConnectorSnapshot {\n352\t      return { state, lastDiagnostic };\n353\t    },\n354\t  };\n355\t}\n356\t\n357\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n358\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n359\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n360\t *  observe-only SDK config, and the `--resume` selector that presents the\n361\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n362\t *  resolves/creates and initializes for real. On `/reload` the connector\n363\t *  re-resolves the same thread from the durable registry (it keeps no\n364\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n365\t *  config. */\n366\texport function activate(pi: ExtensionAPI): void {\n367\t  createConnector().register(pi);\n368\t}\n369\t\n370\texport default activate;\n371\t"}]},"parent_tool_use_id":null,"session_id":"4562dd99-e915-4997-a6b6-c06f59211979","uuid":"959f0fb3-46d1-4f23-9ec3-39d4ef67a8a1","timestamp":"2026-06-14T07:05:45.698Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  DerivationProvider,\n  OpResult,\n  ProviderResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\n *  whose every operation fails closed (non-retryable) instead of fabricating a\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n *  derivation work is ever queued and this provider is never invoked — it exists\n *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n *\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\n *  documents as \"selectable only by explicit name — never a production default\"\n *  (it would mark fake derived text into the thread). Failing closed preserves\n *  the observe-only guarantee even if a future change queued work before Stories\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n *  assignments), which is what a real *completing* inference requires (the\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\nfunction observeOnlyProvider(): DerivationProvider {\n  const notConfigured = (): Promise<ProviderResult> =>\n    Promise.resolve({\n      ok: false,\n      retryable: false,\n      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n    });\n  return {\n    smoothPrompt: notConfigured,\n    summarizeToolCall: notConfigured,\n    summarizeToolResult: notConfigured,\n    composeTurnRendering: notConfigured,\n    projectLowerBand: notConfigured,\n    summarizeChunkDetailed: notConfigured,\n    summarizeChunkBrief: notConfigured,\n  };\n}\n\n/** The production observe-only SDK config: a real, construction-valid instance\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n *  config. */\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n *  most recently created thread as the best available explicit default. The\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n *  takes the `select` seam); tests drive an explicit operator choice through it.\n *  A true interactive picker awaits a PI input surface; until then resuming a\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n *  precise spec deviation. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  if (mostRecent === undefined) return Promise.resolve(null);\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n  }\n  return Promise.resolve(mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution.\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n    const launch = parseLaunch();\n    const isReload = event.reason === \"reload\";\n    const resolved = isReload\n      ? await resolveReloadFor(launch, ctx)\n      : await resolveForLaunch(launch, ctx);\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n    const built = await initInstance(resolved.value, config.value);\n    if (!built.ok) {\n      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n      return;\n    }\n    instance = built.value;\n    state = createSessionState(resolved.value);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n  // land in later stories. Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — later stories replace this with real routing.\n  };\n\n  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: noop,\n    turn_end: noop,\n    agent_end: noop,\n    model_select: noop,\n    thinking_level_select: noop,\n    session_before_fork: noop,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from the durable registry (it keeps no\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n *  config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":371,"startLine":1,"totalLines":371}}}

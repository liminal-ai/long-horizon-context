{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/fixtures/corpus.test.ts | sed -n '1,140p'\"","aggregated_output":"     1\timport { describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  CORPUS_LOADERS,\n     4\t  loadAllCorpora,\n     5\t  makeTruncatedCorpus,\n     6\t  validateCorpus,\n     7\t} from \"./corpus.js\";\n     8\t\n     9\t// Architecture-risk test (tech design §Architecture-Risk Tests — Fixture\n    10\t// Validity): Story 0 owns no AC, but every later capture/verification test\n    11\t// depends on these corpora being trustworthy, so the loader's output is checked\n    12\t// here rather than assumed.\n    13\tdescribe(\"corpus fixtures\", () => {\n    14\t  it(\"yields valid MessageEventInput shapes and lifecycle-coherent sequences for every named corpus\", () => {\n    15\t    const corpora = loadAllCorpora();\n    16\t    expect(corpora).toHaveLength(Object.keys(CORPUS_LOADERS).length);\n    17\t\n    18\t    for (const corpus of corpora) {\n    19\t      const result = validateCorpus(corpus);\n    20\t      // name the defects if any — a bare boolean would hide which corpus broke\n    21\t      expect(result.problems).toEqual([]);\n    22\t      expect(result.valid).toBe(true);\n    23\t      // a real recorded sequence, not an empty stub, and a closed turn\n    24\t      expect(corpus.expected.length).toBeGreaterThan(0);\n    25\t      expect(corpus.expected.at(-1)?.eventKind).toBe(\"turn_end\");\n    26\t    }\n    27\t  });\n    28\t\n    29\t  it(\"produces an intentionally malformed shape from the named invalid builder that the validator rejects\", () => {\n    30\t    const result = validateCorpus(makeTruncatedCorpus());\n    31\t    expect(result.valid).toBe(false);\n    32\t    // the validator inspects shape: it names the specific defects, not a generic fail\n    33\t    expect(result.problems.some((p) => p.includes(\"empty text\"))).toBe(true);\n    34\t    expect(result.problems.some((p) => p.includes(\"no preceding tool_call\"))).toBe(true);\n    35\t    expect(result.problems.some((p) => p.includes(\"does not close with turn_end\"))).toBe(true);\n    36\t  });\n    37\t});\n","exit_code":0,"status":"completed"}}

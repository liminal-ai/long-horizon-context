{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/lifecycle/state.ts | sed -n '1,180p'\"","aggregated_output":"     1\timport type { ThreadRef } from \"lhc\";\n     2\timport type { ValidationReport } from \"../shared/diagnostics.js\";\n     3\t\n     4\t// AC-1.3 / AC-2.7. This module is COMPLETE, not stubbed (story Technical\n     5\t// Notes): its shape is what prevents stale PI-context retention later. The\n     6\t// holder has no slot for a PI ctx/session object, so retaining one across hooks\n     7\t// is impossible in normal use — the structural enforcement the tech arch's\n     8\t// plain-data-only rule calls for.\n     9\t\n    10\t/** Recorded when a writable-thread capture fails: the failure degrades to a\n    11\t *  durable, queryable gap rather than throwing into a PI hook (AC-2.7). */\n    12\texport interface CaptureFailureDiagnostic {\n    13\t  code: string;\n    14\t  eventKey?: string;\n    15\t  message: string;\n    16\t  recordedGap: boolean;\n    17\t}\n    18\t\n    19\t/** The connector's entire retained state between PI hooks: a thread reference,\n    20\t *  told-the-user flags, and health diagnostics — ALL plain data. Everything\n    21\t *  stored here must survive `structuredClone` (no functions, no class\n    22\t *  instances, no PI objects). */\n    23\texport interface SessionState {\n    24\t  threadRef: ThreadRef;\n    25\t  flags: {\n    26\t    startupValidationReported: boolean;\n    27\t    [k: string]: boolean;\n    28\t  };\n    29\t  health: {\n    30\t    lastCaptureFailure?: CaptureFailureDiagnostic;\n    31\t    startupValidation?: ValidationReport;\n    32\t  };\n    33\t}\n    34\t\n    35\t/** Build the initial plain-data holder for a resolved thread. */\n    36\texport function createSessionState(threadRef: ThreadRef): SessionState {\n    37\t  return {\n    38\t    threadRef,\n    39\t    flags: { startupValidationReported: false },\n    40\t    health: {},\n    41\t  };\n    42\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/pi/types.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// Local declarations of the PI extension surface the connector consumes.\n     2\t//\n     3\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n     4\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n     5\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\n     6\t// build-time dependency of this workspace, so the connector declares the slice\n     7\t// of their contract it touches and swaps to the real imports when the\n     8\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n     9\t// surface here — rather than scattered `any` — means later stories get real\n    10\t// type-checking against the contract PI actually fires.\n    11\t\n    12\t// ── Hook vocabulary ──────────────────────────────────────────────────\n    13\t\n    14\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n    15\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\n    16\t *  serving is Epic 2. */\n    17\texport type PiHookName =\n    18\t  | \"session_start\"\n    19\t  | \"message_end\"\n    20\t  | \"turn_end\"\n    21\t  | \"agent_end\"\n    22\t  | \"model_select\"\n    23\t  | \"thinking_level_select\"\n    24\t  | \"session_before_fork\"\n    25\t  | \"session_before_switch\"\n    26\t  | \"session_shutdown\"\n    27\t  | \"context\";\n    28\t\n    29\texport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\n    30\texport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n    31\t\n    32\texport interface SessionStartEvent {\n    33\t  reason: SessionStartReason;\n    34\t  previousSessionFile?: string;\n    35\t}\n    36\texport interface MessageEndEvent {\n    37\t  entryId?: string;\n    38\t  message: AgentMessage;\n    39\t}\n    40\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n    41\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\n    42\texport interface TurnEndEvent {\n    43\t  turnIndex: number;\n    44\t  message: AgentMessage;\n    45\t  toolResults: ToolResultMessage[];\n    46\t  stopReason?: PiStopReason;\n    47\t}\n    48\texport interface AgentEndEvent {\n    49\t  messages: AgentMessage[];\n    50\t}\n    51\texport interface ModelSelectEvent {\n    52\t  model: ModelDescriptor;\n    53\t  previousModel?: ModelDescriptor;\n    54\t  source?: string;\n    55\t}\n    56\texport interface ThinkingLevelSelectEvent {\n    57\t  level: string;\n    58\t  previousLevel: string;\n    59\t}\n    60\texport interface SessionBeforeForkEvent {\n    61\t  entryId: string;\n    62\t  position?: number;\n    63\t}\n    64\texport interface SessionBeforeSwitchEvent {\n    65\t  intent: \"new\" | \"resume\";\n    66\t}\n    67\texport interface SessionShutdownEvent {\n    68\t  reason: SessionShutdownReason;\n    69\t  targetSessionFile?: string;\n    70\t}\n    71\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\n    72\texport interface ContextEvent {\n    73\t  messages: AgentMessage[];\n    74\t}\n    75\t\n    76\t/** Maps each hook to the payload PI delivers with it. */\n    77\texport interface PiHookEventMap {\n    78\t  session_start: SessionStartEvent;\n    79\t  message_end: MessageEndEvent;\n    80\t  turn_end: TurnEndEvent;\n    81\t  agent_end: AgentEndEvent;\n    82\t  model_select: ModelSelectEvent;\n    83\t  thinking_level_select: ThinkingLevelSelectEvent;\n    84\t  session_before_fork: SessionBeforeForkEvent;\n    85\t  session_before_switch: SessionBeforeSwitchEvent;\n    86\t  session_shutdown: SessionShutdownEvent;\n    87\t  context: ContextEvent;\n    88\t}\n    89\t\n    90\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n    91\t *  connector must never retain it across calls (PI replaces session objects on\n    92\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\n    93\texport type PiHookHandler<N extends PiHookName> = (\n    94\t  ctx: ExtensionContext,\n    95\t  event: PiHookEventMap[N],\n    96\t) => void | Promise<void>;\n    97\t\n    98\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n    99\t\n   100\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n   101\t\n   102\texport interface PiToolSpec {\n   103\t  name: string;\n   104\t  description?: string;\n   105\t  promptSnippet?: string;\n   106\t  promptGuidelines?: string;\n   107\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n   108\t}\n   109\t\n   110\t/** The factory-time API. Hook registration and command/tool registration take\n   111\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n   112\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n   113\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\n   114\texport interface ExtensionAPI {\n   115\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n   116\t  registerCommand(name: string, handler: PiCommandHandler): void;\n   117\t  registerTool(tool: PiToolSpec): void;\n   118\t  appendEntry(customType: string, data: unknown): void;\n   119\t}\n   120\t\n   121\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n   122\t\n   123\texport interface ModelDescriptor {\n   124\t  provider: string;\n   125\t  id: string;\n   126\t}\n   127\t\n   128\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n   129\t *  owns. The connector treats provider/model as opaque routing keys. */\n   130\texport interface ModelHandle extends ModelDescriptor {\n   131\t  readonly [k: string]: unknown;\n   132\t}\n   133\t\n   134\texport interface ModelRegistry {\n   135\t  find(provider: string, model: string): ModelHandle | undefined;\n   136\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\n   137\t  getAvailable(): ModelHandle[];\n   138\t}\n   139\t\n   140\texport interface ExtensionUI {\n   141\t  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n   142\t}\n   143\t\n   144\texport interface SessionEntry {\n   145\t  type: string;\n   146\t  readonly [k: string]: unknown;\n   147\t}\n   148\t\n   149\texport interface SessionManager {\n   150\t  getEntries(): SessionEntry[];\n   151\t}\n   152\t\n   153\texport interface ExtensionContext {\n   154\t  modelRegistry: ModelRegistry;\n   155\t  ui: ExtensionUI;\n   156\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n   157\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n   158\t  hasUI: boolean;\n   159\t  sessionManager: SessionManager;\n   160\t  cwd: string;\n   161\t}\n   162\t\n   163\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n   164\t\n   165\texport interface TextPart {\n   166\t  type: \"text\";\n   167\t  text: string;\n   168\t}\n   169\texport interface ThinkingPart {\n   170\t  type: \"thinking\";\n   171\t  thinking: string;\n   172\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n   173\t   *  Epic 1 (tech design I-3). */\n   174\t  thinkingSignature?: string;\n   175\t}\n   176\texport interface ToolCallPart {\n   177\t  type: \"toolCall\";\n   178\t  /** Composite, stable across tool_execution_start → tool_result → message_end\n   179\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n   180\t  id: string;\n   181\t  name: string;\n   182\t  arguments: Record<string, unknown>;\n   183\t  /** Opaque; captured, not interpreted (tech design I-3). */\n   184\t  thoughtSignature?: string;\n   185\t}\n   186\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n   187\t *  the converter (tech design I-6), never silently dropped. */\n   188\texport interface ImagePart {\n   189\t  type: \"image\";\n   190\t  mimeType?: string;\n   191\t  data?: string;\n   192\t}\n   193\texport interface FileRefPart {\n   194\t  type: \"fileRef\";\n   195\t  path: string;\n   196\t}\n   197\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n   198\t\n   199\texport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n   200\t\n   201\texport interface TokenUsage {\n   202\t  inputTokens?: number;\n   203\t  outputTokens?: number;\n   204\t}\n   205\t\n   206\texport interface UserMessage {\n   207\t  role: \"user\";\n   208\t  content: ContentPart[];\n   209\t}\n   210\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n   211\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\n   212\texport interface AssistantMessage {\n   213\t  role: \"assistant\";\n   214\t  content: ContentPart[];\n   215\t  stopReason?: PiStopReason;\n   216\t  usage?: TokenUsage;\n   217\t}\n   218\texport interface ToolResultMessage {\n   219\t  role: \"toolResult\";\n   220\t  toolCallId: string;\n   221\t  content: ContentPart[];\n   222\t  isError?: boolean;\n   223\t}\n   224\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/turn-derivation.test.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Story 2 — turn derivation, the load-bearing mechanic. An LHC turn spans a\n     2\t// whole exchange: it opens on a user prompt, ignores every PI per-step\n     3\t// `turn_end`, and closes with exactly one LHC `turn_end` at `agent_end`\n     4\t// (TC-2.2). Session order is the converter's source-event order, never PI's\n     5\t// per-run `turnIndex` (TC-2.3). The accumulator goldens pin the state machine\n     6\t// directly, including the hard-kill tolerance (a dangling open turn, and an\n     7\t// agent_end with no open turn as a no-op).\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport type { MessageEventInput } from \"lhc\";\n    10\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    11\timport {\n    12\t  makeAgentEnd,\n    13\t  makeAssistantMessage,\n    14\t  makeMessageEnd,\n    15\t  makeToolResult,\n    16\t  makeUserMessage,\n    17\t  validEvent,\n    18\t} from \"../fixtures/synthetic.js\";\n    19\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    20\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tfunction textOf(event: MessageEventInput): string {\n    31\t  return (event.payload as { text?: string }).text ?? \"\";\n    32\t}\n    33\t\n    34\t// A PI per-step turn_end payload (ignored by the converter as a boundary).\n    35\tfunction piTurnEnd(turnIndex: number) {\n    36\t  return { turnIndex, message: makeAssistantMessage({ text: \"step\" }), toolResults: [] };\n    37\t}\n    38\t\n    39\tdescribe(\"Story 2: turn derivation — worked example (TC-2.2)\", () => {\n    40\t  it(\"yields exactly one LHC turn with one turn_end at agent_end; PI per-step turn_ends produce none\", async () => {\n    41\t    const started = await startCapture(store);\n    42\t    const { connector, ctx, threadRef } = started;\n    43\t\n    44\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"ask one question\")));\n    45\t    await connector.handlers.message_end(\n    46\t      ctx,\n    47\t      makeMessageEnd(\n    48\t        makeAssistantMessage({\n    49\t          thinking: \"two tools needed\",\n    50\t          toolCalls: [\n    51\t            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n    52\t            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n    53\t          ],\n    54\t        }),\n    55\t      ),\n    56\t    );\n    57\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b\" })));\n    58\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a\" })));\n    59\t    // PI fires a per-step turn_end here — it must NOT become an LHC turn_end.\n    60\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n    61\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"the answer\" })));\n    62\t    await connector.handlers.turn_end(ctx, piTurnEnd(1));\n    63\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    64\t\n    65\t    const events = await eventsAfterShutdown(started);\n    66\t    expect(kindsOf(events)).toEqual([\n    67\t      \"user_prompt\",\n    68\t      \"assistant_thinking\",\n    69\t      \"tool_call\",\n    70\t      \"tool_call\",\n    71\t      \"tool_result\",\n    72\t      \"tool_result\",\n    73\t      \"assistant_text\",\n    74\t      \"turn_end\",\n    75\t    ]);\n    76\t    // Exactly one LHC turn_end, and it lands last — at agent_end, not per PI step.\n    77\t    expect(events.filter((event) => event.eventKind === \"turn_end\")).toHaveLength(1);\n    78\t    expect(events.at(-1)?.eventKind).toBe(\"turn_end\");\n    79\t\n    80\t    const counts = await turnCounts(threadRef);\n    81\t    expect(counts.closed).toBe(1);\n    82\t    expect(counts.open).toBe(0);\n    83\t  });\n    84\t});\n    85\t\n    86\tdescribe(\"Story 2: turn derivation — source order, not turnIndex (TC-2.3)\", () => {\n    87\t  it(\"orders two agent runs that each start at turnIndex 0 by source-event order, with no collision\", async () => {\n    88\t    const started = await startCapture(store);\n    89\t    const { connector, ctx, threadRef } = started;\n    90\t\n    91\t    // Run 1 (PI turnIndex 0)\n    92\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"first prompt\")));\n    93\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"first answer\" })));\n    94\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n    95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    96\t    // Run 2 (PI turnIndex 0 AGAIN — the reset-per-run counter)\n    97\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"second prompt\")));\n    98\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"second answer\" })));\n    99\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n   100\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   101\t\n   102\t    const events = await eventsAfterShutdown(started);\n   103\t    expect(kindsOf(events)).toEqual([\n   104\t      \"user_prompt\",\n   105\t      \"assistant_text\",\n   106\t      \"turn_end\",\n   107\t      \"user_prompt\",\n   108\t      \"assistant_text\",\n   109\t      \"turn_end\",\n   110\t    ]);\n   111\t    // Source order decides sequence: run 1 precedes run 2 despite identical turnIndex.\n   112\t    expect(textOf(events[0]!)).toBe(\"first prompt\");\n   113\t    expect(textOf(events[3]!)).toBe(\"second prompt\");\n   114\t\n   115\t    const counts = await turnCounts(threadRef);\n   116\t    expect(counts.closed).toBe(2);\n   117\t    expect(counts.open).toBe(0);\n   118\t  });\n   119\t});\n   120\t\n   121\tdescribe(\"Story 2: turn accumulator — state machine goldens (AC-2.2)\", () => {\n   122\t  it(\"emits one turn_end only when a turn is open, and is idempotent across agent_end\", () => {\n   123\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   124\t    expect(acc.hasOpenTurn()).toBe(false);\n   125\t\n   126\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   127\t    expect(acc.hasOpenTurn()).toBe(true);\n   128\t\n   129\t    const emitted = acc.onAgentEnd();\n   130\t    expect(emitted).toHaveLength(1);\n   131\t    expect(emitted[0]?.eventKind).toBe(\"turn_end\");\n   132\t    expect(emitted[0]?.payload).toEqual({});\n   133\t    expect(acc.hasOpenTurn()).toBe(false);\n   134\t\n   135\t    // A second agent_end with no open turn emits nothing (hard-kill / reattach\n   136\t    // tolerance: turn_end-with-no-open-turn is a no-op).\n   137\t    expect(acc.onAgentEnd()).toEqual([]);\n   138\t  });\n   139\t\n   140\t  it(\"gives successive turns distinct turn_end idempotency keys\", () => {\n   141\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   142\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   143\t    const first = acc.onAgentEnd();\n   144\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   145\t    const second = acc.onAgentEnd();\n   146\t    expect(first[0]?.idempotencyKey).not.toBe(second[0]?.idempotencyKey);\n   147\t  });\n   148\t});\n   149\t\n   150\tdescribe(\"Story 2: turn derivation — hard-kill golden\", () => {\n   151\t  it(\"leaves a dangling open turn when the run never reaches agent_end, with no turn_end recorded\", async () => {\n   152\t    const started = await startCapture(store);\n   153\t    const { connector, ctx, threadRef } = started;\n   154\t\n   155\t    // Hard kill: a user message lands, then the process dies — no assistant\n   156\t    // close, no agent_end.\n   157\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"dangling prompt\")));\n   158\t    await connector.getInstance()?.sdk.drainSettled(threadRef);\n   159\t\n   160\t    const counts = await turnCounts(threadRef);\n   161\t    expect(counts.open).toBe(1);\n   162\t    expect(counts.closed).toBe(0);\n   163\t\n   164\t    const events = await eventsAfterShutdown(started);\n   165\t    expect(events.filter((event) => event.eventKind === \"turn_end\")).toHaveLength(0);\n   166\t    expect(kindsOf(events)).toEqual([\"user_prompt\"]);\n   167\t  });\n   168\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '1,520p'\"","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type {\n    11\t  BatchResult,\n    12\t  DerivationProvider,\n    13\t  MessageEventInput,\n    14\t  OpResult,\n    15\t  ProviderResult,\n    16\t  SdkConfig,\n    17\t  ThreadRef,\n    18\t} from \"lhc\";\n    19\timport type {\n    20\t  ExtensionAPI,\n    21\t  ExtensionContext,\n    22\t  PiHookHandler,\n    23\t  PiHookName,\n    24\t} from \"./pi/types.js\";\n    25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    26\timport { createSessionState } from \"./lifecycle/state.js\";\n    27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    28\timport {\n    29\t  parseLaunchFlags,\n    30\t  resolveReloadThread,\n    31\t  resolveThread,\n    32\t  type LaunchFlags,\n    33\t  type ResolveDeps,\n    34\t} from \"./lifecycle/thread-resolution.js\";\n    35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    36\timport { capture } from \"./capture/converter.js\";\n    37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n    38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n    39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n    40\timport type { LhcInstance } from \"./shared/instance.js\";\n    41\t\n    42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    43\texport type { LhcInstance } from \"./shared/instance.js\";\n    44\t\n    45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    47\t *  registers no handler for it (story Scope Out). */\n    48\texport const EPIC_1_HOOKS = [\n    49\t  \"session_start\",\n    50\t  \"message_end\",\n    51\t  \"turn_end\",\n    52\t  \"agent_end\",\n    53\t  \"model_select\",\n    54\t  \"thinking_level_select\",\n    55\t  \"session_before_fork\",\n    56\t  \"session_before_switch\",\n    57\t  \"session_shutdown\",\n    58\t] as const satisfies readonly PiHookName[];\n    59\t\n    60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    61\t\n    62\t/** What the connector needs from the host to run a session. Every dependency\n    63\t *  has a working production default; the overrides exist for test isolation\n    64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n    65\t *  in the PI-auth-backed inference config.\n    66\t *\n    67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n    68\t *  default is the observe-only config below (a real, construction-valid SDK);\n    69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n    70\texport interface ConnectorDeps {\n    71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    72\t  registryPath?: string;\n    73\t  newThreadFilePath?: () => string;\n    74\t  parseLaunch?: () => LaunchFlags;\n    75\t  selectThread?: (\n    76\t    choices: readonly ThreadChoice[],\n    77\t    ctx: ExtensionContext,\n    78\t  ) => Promise<string | null>;\n    79\t}\n    80\t\n    81\t/** Everything the connector retains across hooks as PLAIN data — by\n    82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    84\t *  deliberately not part of the snapshot. */\n    85\texport interface ConnectorSnapshot {\n    86\t  state: SessionState | null;\n    87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    88\t}\n    89\t\n    90\texport interface Connector {\n    91\t  /** Register the observe-only hook rail on the PI extension API. */\n    92\t  register(pi: ExtensionAPI): void;\n    93\t  /** The plain-data state retained across hooks. `null` until a session\n    94\t   *  resolves a thread; never holds a PI ctx. */\n    95\t  getState(): SessionState | null;\n    96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n    97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n    98\t  getInstance(): LhcInstance | null;\n    99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n   100\t  snapshot(): ConnectorSnapshot;\n   101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   102\t   *  synthetic ctx/events without a live PI. */\n   103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n   104\t}\n   105\t\n   106\t/** The connector's live capture state for one session: the open-turn\n   107\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n   108\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n   109\t *  per session, never part of the plain-data snapshot and never a PI object. */\n   110\tinterface CaptureSession {\n   111\t  piSessionId: string;\n   112\t  accumulator: TurnAccumulator;\n   113\t}\n   114\t\n   115\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n   116\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   117\t *  same id). */\n   118\tfunction sessionIdOf(ref: ThreadRef): string {\n   119\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   120\t}\n   121\t\n   122\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   123\t\n   124\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n   125\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n   126\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n   127\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n   128\t *  derivation work is ever queued and this provider is never invoked — it exists\n   129\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n   130\t *\n   131\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n   132\t *  documents as \"selectable only by explicit name — never a production default\"\n   133\t *  (it would mark fake derived text into the thread). Failing closed preserves\n   134\t *  the observe-only guarantee even if a future change queued work before Stories\n   135\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n   136\t *  assignments), which is what a real *completing* inference requires (the\n   137\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n   138\tfunction observeOnlyProvider(): DerivationProvider {\n   139\t  const notConfigured = (): Promise<ProviderResult> =>\n   140\t    Promise.resolve({\n   141\t      ok: false,\n   142\t      retryable: false,\n   143\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n   144\t    });\n   145\t  return {\n   146\t    smoothPrompt: notConfigured,\n   147\t    summarizeToolCall: notConfigured,\n   148\t    summarizeToolResult: notConfigured,\n   149\t    composeTurnRendering: notConfigured,\n   150\t    projectLowerBand: notConfigured,\n   151\t    summarizeChunkDetailed: notConfigured,\n   152\t    summarizeChunkBrief: notConfigured,\n   153\t  };\n   154\t}\n   155\t\n   156\t/** The production observe-only SDK config: a real, construction-valid instance\n   157\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n   158\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n   159\t *  config. */\n   160\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n   161\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n   162\t}\n   163\t\n   164\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   165\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   166\t *  show. */\n   167\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   168\t  const lines = choices.map((choice, i) => {\n   169\t    const title = choice.title ?? \"(untitled)\";\n   170\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   171\t  });\n   172\t  return [\n   173\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n   174\t    ...lines,\n   175\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n   176\t  ].join(\"\\n\");\n   177\t}\n   178\t\n   179\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n   180\t *  interactive input/selection surface (wiring research), so the production\n   181\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n   182\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n   183\t *  most recently created thread as the best available explicit default. The\n   184\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n   185\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n   186\t *  A true interactive picker awaits a PI input surface; until then resuming a\n   187\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n   188\t *  precise spec deviation. */\n   189\tfunction defaultSelectThread(\n   190\t  choices: readonly ThreadChoice[],\n   191\t  ctx: ExtensionContext,\n   192\t): Promise<string | null> {\n   193\t  const mostRecent = choices.at(-1);\n   194\t  if (mostRecent === undefined) return Promise.resolve(null);\n   195\t  if (ctx.hasUI) {\n   196\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   197\t  }\n   198\t  return Promise.resolve(mostRecent.threadId);\n   199\t}\n   200\t\n   201\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   202\t *  generated by the registry at creation, so the file name is just a unique\n   203\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   204\t *  parents). */\n   205\tfunction defaultNewThreadFilePath(): string {\n   206\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   207\t  mkdirSync(dir, { recursive: true });\n   208\t  return join(dir, `${randomUUID()}.sqlite`);\n   209\t}\n   210\t\n   211\t/** Build a connector instance. Its mutable state lives in this closure; the\n   212\t *  registered handlers capture it, so the instance stays live for the session\n   213\t *  even when `activate` discards the returned object. The connector holds NO\n   214\t *  module-level or durable state of its own — reload reconstructs the thread from\n   215\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n   216\t *  closure reattaches correctly (AC-1.5). */\n   217\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   218\t  // The connector's retained state. `state` is plain data (the durable thread\n   219\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   220\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n   221\t  // none survives the connector — reload re-resolves from the registry.\n   222\t  let state: SessionState | null = null;\n   223\t  let instance: LhcInstance | null = null;\n   224\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   225\t  let captureSession: CaptureSession | null = null;\n   226\t\n   227\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n   228\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   229\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   230\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n   231\t\n   232\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   233\t    return { code, message, recordedGap: false };\n   234\t  }\n   235\t\n   236\t  // The registry/file deps every resolver path shares. `registryPath` is set\n   237\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n   238\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n   239\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n   240\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n   241\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   242\t    return resolveDeps;\n   243\t  }\n   244\t\n   245\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n   246\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n   247\t  // no-flag creates).\n   248\t  async function resolveForLaunch(\n   249\t    launch: LaunchFlags,\n   250\t    ctx: ExtensionContext,\n   251\t  ): Promise<OpResult<ThreadRef | null>> {\n   252\t    if (launch.resume === true) {\n   253\t      const pickerDeps: {\n   254\t        registryPath?: string;\n   255\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n   256\t      } = { select: (choices) => selectThread(choices, ctx) };\n   257\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n   258\t      return pickThread(ctx.cwd, pickerDeps);\n   259\t    }\n   260\t    return resolveThread(launch, buildResolveDeps(ctx));\n   261\t  }\n   262\t\n   263\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n   264\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n   265\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n   266\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n   267\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n   268\t  async function resolveReloadFor(\n   269\t    launch: LaunchFlags,\n   270\t    ctx: ExtensionContext,\n   271\t  ): Promise<OpResult<ThreadRef | null>> {\n   272\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n   273\t  }\n   274\t\n   275\t  // session_start: resolve the recording thread and construct one background\n   276\t  // instance against it. Config is gated first so a session with no usable\n   277\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n   278\t  // thread is re-resolved from the durable registry (reattach, never create);\n   279\t  // every other reason runs the normal launch resolution.\n   280\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   281\t    const config = buildSdkConfig(ctx);\n   282\t    if (!config.ok) {\n   283\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   284\t      return;\n   285\t    }\n   286\t    const launch = parseLaunch();\n   287\t    const isReload = event.reason === \"reload\";\n   288\t    const resolved = isReload\n   289\t      ? await resolveReloadFor(launch, ctx)\n   290\t      : await resolveForLaunch(launch, ctx);\n   291\t    if (!resolved.ok) {\n   292\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   293\t      return;\n   294\t    }\n   295\t    if (resolved.value === null) {\n   296\t      lastDiagnostic = isReload\n   297\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n   298\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   299\t      return;\n   300\t    }\n   301\t    const built = await initInstance(resolved.value, config.value);\n   302\t    if (!built.ok) {\n   303\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   304\t      return;\n   305\t    }\n   306\t    instance = built.value;\n   307\t    state = createSessionState(resolved.value);\n   308\t    const piSessionId = sessionIdOf(resolved.value);\n   309\t    captureSession = {\n   310\t      piSessionId,\n   311\t      accumulator: new TurnAccumulator({ piSessionId }),\n   312\t    };\n   313\t  };\n   314\t\n   315\t  // Dispose with flush before any session swap (session_before_switch fires\n   316\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   317\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n   318\t  // re-resolves its thread from the durable registry on the next session_start.\n   319\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   320\t    const result = await disposeInstance(instance);\n   321\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   322\t    instance = null;\n   323\t    captureSession = null;\n   324\t  };\n   325\t\n   326\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n   327\t  // converter already recorded a durable gap for a writable-thread malformed\n   328\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n   329\t  // surfaces as an extension health signal with no gap. Neither path throws.\n   330\t  function recordCaptureOutcome(\n   331\t    result: OpResult<BatchResult>,\n   332\t    events: readonly MessageEventInput[],\n   333\t  ): void {\n   334\t    if (result.ok) return;\n   335\t    const recordedGap = result.error.code === \"invalid_event\";\n   336\t    const failure: CaptureFailureDiagnostic = {\n   337\t      code: result.error.code,\n   338\t      message: result.error.reason,\n   339\t      recordedGap,\n   340\t    };\n   341\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n   342\t    lastDiagnostic = failure;\n   343\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   344\t  }\n   345\t\n   346\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   347\t  // open turn, and flush through the converter (AC-2.1).\n   348\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   349\t    if (instance === null || captureSession === null) return;\n   350\t    const mapCtx: MapCtx =\n   351\t      event.entryId !== undefined && event.entryId !== \"\"\n   352\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n   353\t        : { piSessionId: captureSession.piSessionId };\n   354\t    const events = mapMessage(event.message, mapCtx);\n   355\t    captureSession.accumulator.onMessage(events);\n   356\t    if (events.length === 0) return;\n   357\t    recordCaptureOutcome(await capture(events, instance), events);\n   358\t  };\n   359\t\n   360\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   361\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   362\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   363\t    if (instance === null || captureSession === null) return;\n   364\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId };\n   365\t    const note = mapModelSelect(event, mapCtx);\n   366\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   367\t  };\n   368\t\n   369\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   370\t    if (instance === null || captureSession === null) return;\n   371\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId };\n   372\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   373\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   374\t  };\n   375\t\n   376\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   377\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   378\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   379\t    if (instance === null || captureSession === null) return;\n   380\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   381\t    if (turnEnd.length === 0) return;\n   382\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   383\t  };\n   384\t\n   385\t  // Contain every handler: an observe-only hook must never throw back into PI\n   386\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   387\t  // plain-data diagnostic; it is never rethrown.\n   388\t  const guard = (\n   389\t    name: Epic1Hook,\n   390\t    body: PiHookHandler<Epic1Hook>,\n   391\t  ): PiHookHandler<Epic1Hook> => {\n   392\t    return async (ctx, event): Promise<void> => {\n   393\t      try {\n   394\t        await body(ctx, event);\n   395\t      } catch (err) {\n   396\t        lastDiagnostic = {\n   397\t          code: \"hook_handler_error\",\n   398\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   399\t          recordedGap: false,\n   400\t        };\n   401\t      }\n   402\t    };\n   403\t  };\n   404\t\n   405\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   406\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n   407\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n   408\t  // FRESH ctx and retains none of it.\n   409\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   410\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n   411\t  };\n   412\t\n   413\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   414\t  // are live; PI per-step turn_end and fork remain no-ops.\n   415\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   416\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   417\t    session_before_switch: onDispose,\n   418\t    session_shutdown: onDispose,\n   419\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   420\t    turn_end: noop,\n   421\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   422\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   423\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   424\t    session_before_fork: noop,\n   425\t  };\n   426\t\n   427\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   428\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   429\t\n   430\t  return {\n   431\t    handlers,\n   432\t    register(pi: ExtensionAPI): void {\n   433\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   434\t    },\n   435\t    getState(): SessionState | null {\n   436\t      return state;\n   437\t    },\n   438\t    getInstance(): LhcInstance | null {\n   439\t      return instance;\n   440\t    },\n   441\t    snapshot(): ConnectorSnapshot {\n   442\t      return { state, lastDiagnostic };\n   443\t    },\n   444\t  };\n   445\t}\n   446\t\n   447\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   448\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n   449\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n   450\t *  observe-only SDK config, and the `--resume` selector that presents the\n   451\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n   452\t *  resolves/creates and initializes for real. On `/reload` the connector\n   453\t *  re-resolves the same thread from the durable registry (it keeps no\n   454\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n   455\t *  config. */\n   456\texport function activate(pi: ExtensionAPI): void {\n   457\t  createConnector().register(pi);\n   458\t}\n   459\t\n   460\texport default activate;\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/fixtures/synthetic.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\n     2\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\n     3\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\n     4\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\n     5\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\n     6\timport type { EventKind, MessageEventInput } from \"lhc\";\n     7\timport type {\n     8\t  AgentEndEvent,\n     9\t  AgentMessage,\n    10\t  AssistantMessage,\n    11\t  ContentPart,\n    12\t  MessageEndEvent,\n    13\t  PiStopReason,\n    14\t  SessionStartEvent,\n    15\t  SessionStartReason,\n    16\t  ToolResultMessage,\n    17\t  UserMessage,\n    18\t} from \"../../src/pi/types.js\";\n    19\t\n    20\t// ── LHC intake-event builder ─────────────────────────────────────────\n    21\t\n    22\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\n    23\t\n    24\tlet keyCounter = 0;\n    25\t/** Reset the per-call key counter so a test can build deterministic keys. */\n    26\texport function resetEventKeyCounter(): void {\n    27\t  keyCounter = 0;\n    28\t}\n    29\t\n    30\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n    31\t  user_prompt: () => ({ text: \"please read the file\" }),\n    32\t  assistant_text: () => ({ text: \"here is what I found\" }),\n    33\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n    34\t  runtime_note: () => ({ text: \"model changed: anthropic/claude → openai/gpt\" }),\n    35\t  tool_call: () => ({ toolCallId: \"call-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } }),\n    36\t  tool_result: () => ({ toolCallId: \"call-1\", content: \"contents of notes.txt\", isError: false }),\n    37\t  turn_end: () => ({}),\n    38\t};\n    39\t\n    40\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\n    41\t *  mismatch at a call site is a compile error; the final reconciliation goes\n    42\t *  through `unknown` (TS can't reduce a structural spread to the deferred\n    43\t *  Extract), with call-site safety living in the parameter types. */\n    44\texport function validEvent<K extends EventKind>(\n    45\t  kind: K,\n    46\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n    47\t): EventByKind<K> {\n    48\t  keyCounter += 1;\n    49\t  const base = {\n    50\t    eventKind: kind,\n    51\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\n    52\t    actor: \"fixture-actor\",\n    53\t    harness: \"pi\",\n    54\t    payload: defaultPayloads[kind](),\n    55\t  };\n    56\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    57\t}\n    58\t\n    59\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    60\t  return kinds.map((kind) => validEvent(kind));\n    61\t}\n    62\t\n    63\t// ── PI message builders ──────────────────────────────────────────────\n    64\t\n    65\texport function makeUserMessage(text = \"please read the file\"): UserMessage {\n    66\t  return { role: \"user\", content: [{ type: \"text\", text }] };\n    67\t}\n    68\t\n    69\texport interface AssistantToolCall {\n    70\t  id: string;\n    71\t  name: string;\n    72\t  arguments?: Record<string, unknown>;\n    73\t}\n    74\t\n    75\t/** Fans out to content parts in PI's confirmed order: thinking → text →\n    76\t *  toolCall×N (research §5a). */\n    77\texport function makeAssistantMessage(\n    78\t  opts: {\n    79\t    thinking?: string;\n    80\t    text?: string;\n    81\t    toolCalls?: AssistantToolCall[];\n    82\t    stopReason?: PiStopReason;\n    83\t  } = {},\n    84\t): AssistantMessage {\n    85\t  const content: ContentPart[] = [];\n    86\t  if (opts.thinking !== undefined) content.push({ type: \"thinking\", thinking: opts.thinking });\n    87\t  if (opts.text !== undefined) content.push({ type: \"text\", text: opts.text });\n    88\t  for (const call of opts.toolCalls ?? []) {\n    89\t    content.push({ type: \"toolCall\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\n    90\t  }\n    91\t  const msg: AssistantMessage = { role: \"assistant\", content };\n    92\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\n    93\t  return msg;\n    94\t}\n    95\t\n    96\texport function makeToolResult(opts: {\n    97\t  id: string;\n    98\t  isError?: boolean;\n    99\t  content?: string;\n   100\t}): ToolResultMessage {\n   101\t  const msg: ToolResultMessage = {\n   102\t    role: \"toolResult\",\n   103\t    toolCallId: opts.id,\n   104\t    content: [{ type: \"text\", text: opts.content ?? \"tool output\" }],\n   105\t  };\n   106\t  if (opts.isError !== undefined) msg.isError = opts.isError;\n   107\t  return msg;\n   108\t}\n   109\t\n   110\t// ── PI event-stream builders ─────────────────────────────────────────\n   111\t\n   112\texport function makeSessionStart(\n   113\t  reason: SessionStartReason = \"startup\",\n   114\t  previousSessionFile?: string,\n   115\t): SessionStartEvent {\n   116\t  const ev: SessionStartEvent = { reason };\n   117\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\n   118\t  return ev;\n   119\t}\n   120\t\n   121\texport function makeMessageEnd(message: AgentMessage, entryId?: string): MessageEndEvent {\n   122\t  const ev: MessageEndEvent = { message };\n   123\t  if (entryId !== undefined) ev.entryId = entryId;\n   124\t  return ev;\n   125\t}\n   126\t\n   127\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\n   128\t  return { messages };\n   129\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/fixtures/corpus.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n     2\t// named lifecycle paired with the LHC intake events it should produce. Until M0\n     3\t// delivers real recordings, the loaders build synthetic stand-ins; the\n     4\t// machinery (load → validate shape → compare on replay in Story 3) is real and\n     5\t// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n     6\t// hardcodes a passing count (story §Anti-Shim Requirements).\n     7\timport type { EventKind } from \"lhc\";\n     8\timport type { Corpus } from \"../../src/verify/replay.js\";\n     9\timport { ABORTED_DISPOSITION_TEXT } from \"../../src/capture/map-message.js\";\n    10\timport {\n    11\t  makeAssistantMessage,\n    12\t  makeToolResult,\n    13\t  makeUserMessage,\n    14\t  validEvent,\n    15\t} from \"./synthetic.js\";\n    16\t\n    17\tconst CALL_A = \"call_a|fc_1\";\n    18\tconst CALL_B = \"call_b|fc_2\";\n    19\t\n    20\t/** Plain user/assistant text exchanges, no tools. */\n    21\texport function loadChattyCorpus(): Corpus {\n    22\t  return {\n    23\t    name: \"chatty\",\n    24\t    source: [\n    25\t      makeUserMessage(\"what does this repo do?\"),\n    26\t      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n    27\t      makeUserMessage(\"and the connector?\"),\n    28\t      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n    29\t    ],\n    30\t    expected: [\n    31\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n    32\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n    33\t      validEvent(\"turn_end\"),\n    34\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n    35\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n    36\t      validEvent(\"turn_end\"),\n    37\t    ],\n    38\t  };\n    39\t}\n    40\t\n    41\t/** One turn with a single tool run: thinking → call → result → answer. */\n    42\texport function loadToolHeavyCorpus(): Corpus {\n    43\t  return {\n    44\t    name: \"tool-heavy\",\n    45\t    source: [\n    46\t      makeUserMessage(\"read notes.txt\"),\n    47\t      makeAssistantMessage({\n    48\t        thinking: \"I should open the file\",\n    49\t        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n    50\t      }),\n    51\t      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n    52\t      makeAssistantMessage({ text: \"the file says hello\" }),\n    53\t    ],\n    54\t    expected: [\n    55\t      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n    56\t      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n    57\t      validEvent(\"tool_call\", {\n    58\t        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    59\t      }),\n    60\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n    61\t      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n    62\t      validEvent(\"turn_end\"),\n    63\t    ],\n    64\t  };\n    65\t}\n    66\t\n    67\t/** Two parallel tool calls whose results complete out of order; correlation is\n    68\t *  by id, not arrival order (AC-2.3). */\n    69\texport function loadParallelToolCorpus(): Corpus {\n    70\t  return {\n    71\t    name: \"parallel-tool\",\n    72\t    source: [\n    73\t      makeUserMessage(\"read both files\"),\n    74\t      makeAssistantMessage({\n    75\t        toolCalls: [\n    76\t          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n    77\t          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n    78\t        ],\n    79\t      }),\n    80\t      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n    81\t      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n    82\t      makeAssistantMessage({ text: \"read both\" }),\n    83\t    ],\n    84\t    expected: [\n    85\t      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n    86\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n    87\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n    88\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n    89\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n    90\t      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n    91\t      validEvent(\"turn_end\"),\n    92\t    ],\n    93\t  };\n    94\t}\n    95\t\n    96\t/** A tool result flagged as an error, captured with its content (AC-2.4). */\n    97\texport function loadErrorResultCorpus(): Corpus {\n    98\t  return {\n    99\t    name: \"error-result\",\n   100\t    source: [\n   101\t      makeUserMessage(\"read missing.txt\"),\n   102\t      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n   103\t      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n   104\t      makeAssistantMessage({ text: \"that file does not exist\" }),\n   105\t    ],\n   106\t    expected: [\n   107\t      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n   108\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n   109\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n   110\t      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n   111\t      validEvent(\"turn_end\"),\n   112\t    ],\n   113\t  };\n   114\t}\n   115\t\n   116\t/** A graceful interrupt: partial assistant content, turn closed\n   117\t *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\n   118\texport function loadAbortedTurnCorpus(): Corpus {\n   119\t  return {\n   120\t    name: \"aborted-turn\",\n   121\t    source: [\n   122\t      makeUserMessage(\"write a long essay\"),\n   123\t      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n   124\t    ],\n   125\t    expected: [\n   126\t      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n   127\t      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n   128\t      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n   129\t      // The aborted disposition rides a trailing runtime_note (the mapper carries\n   130\t      // stopReason through; research §5b), then the turn closes complete-but-aborted.\n   131\t      validEvent(\"runtime_note\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\n   132\t      validEvent(\"turn_end\"),\n   133\t    ],\n   134\t  };\n   135\t}\n   136\t\n   137\texport const CORPUS_LOADERS = {\n   138\t  chatty: loadChattyCorpus,\n   139\t  \"tool-heavy\": loadToolHeavyCorpus,\n   140\t  \"parallel-tool\": loadParallelToolCorpus,\n   141\t  \"error-result\": loadErrorResultCorpus,\n   142\t  \"aborted-turn\": loadAbortedTurnCorpus,\n   143\t} as const;\n   144\t\n   145\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n   146\t\n   147\texport function loadAllCorpora(): Corpus[] {\n   148\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n   149\t}\n   150\t\n   151\t/** A deliberately malformed sequence for the capture-failure test: an empty\n   152\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n   153\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n   154\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n   155\texport function makeTruncatedCorpus(): Corpus {\n   156\t  return {\n   157\t    name: \"truncated\",\n   158\t    source: [makeUserMessage(\"\")],\n   159\t    expected: [\n   160\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n   161\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n   162\t    ],\n   163\t  };\n   164\t}\n   165\t\n   166\texport interface CorpusValidation {\n   167\t  valid: boolean;\n   168\t  problems: string[];\n   169\t}\n   170\t\n   171\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n   172\t  \"user_prompt\",\n   173\t  \"assistant_text\",\n   174\t  \"assistant_thinking\",\n   175\t  \"runtime_note\",\n   176\t  \"tool_call\",\n   177\t  \"tool_result\",\n   178\t  \"turn_end\",\n   179\t]);\n   180\t\n   181\t/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n   182\t *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n   183\t *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n   184\t *  found — `valid` is derived from that list, never a constant. */\n   185\texport function validateCorpus(corpus: Corpus): CorpusValidation {\n   186\t  const problems: string[] = [];\n   187\t  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n   188\t  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n   189\t\n   190\t  const seenToolCalls = new Set<string>();\n   191\t  for (const [i, ev] of corpus.expected.entries()) {\n   192\t    const at = `${corpus.name}[${i}]`;\n   193\t    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n   194\t    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n   195\t    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n   196\t    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n   197\t\n   198\t    switch (ev.eventKind) {\n   199\t      case \"user_prompt\":\n   200\t      case \"assistant_text\":\n   201\t      case \"assistant_thinking\":\n   202\t      case \"runtime_note\": {\n   203\t        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n   204\t          problems.push(`${at}: ${ev.eventKind} has empty text`);\n   205\t        }\n   206\t        break;\n   207\t      }\n   208\t      case \"tool_call\": {\n   209\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   210\t          problems.push(`${at}: tool_call has empty toolCallId`);\n   211\t        } else {\n   212\t          seenToolCalls.add(ev.payload.toolCallId);\n   213\t        }\n   214\t        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n   215\t          problems.push(`${at}: tool_call has empty toolName`);\n   216\t        }\n   217\t        break;\n   218\t      }\n   219\t      case \"tool_result\": {\n   220\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   221\t          problems.push(`${at}: tool_result has empty toolCallId`);\n   222\t        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n   223\t          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n   224\t        }\n   225\t        if (typeof ev.payload.content !== \"string\") {\n   226\t          problems.push(`${at}: tool_result has non-string content`);\n   227\t        }\n   228\t        break;\n   229\t      }\n   230\t      case \"turn_end\":\n   231\t        break;\n   232\t    }\n   233\t  }\n   234\t\n   235\t  const last = corpus.expected[corpus.expected.length - 1];\n   236\t  if (last !== undefined && last.eventKind !== \"turn_end\") {\n   237\t    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n   238\t  }\n   239\t\n   240\t  return { valid: problems.length === 0, problems };\n   241\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/runtime-changes.ts | sed -n '1,220p'\"","aggregated_output":"     1\timport type { MessageEventInput } from \"lhc\";\n     2\timport type { MapCtx } from \"./map-message.js\";\n     3\timport { eventKey } from \"./idempotency.js\";\n     4\t\n     5\t// AC-2.8: model_select / thinking_level_select hooks → runtime_note events, in\n     6\t// order relative to surrounding messages. PI fires these only in-stream and no\n     7\t// durable record holds them otherwise, so they are captured the moment they\n     8\t// fire. They ride the existing `runtime_note` kind (no new intake kind), with\n     9\t// text structured enough to recover the change — the new value and the previous\n    10\t// one — which is what later epics use to attribute a turn to its model.\n    11\t\n    12\tconst HARNESS = \"pi\";\n    13\t\n    14\tinterface ModelDescriptor {\n    15\t  provider: string;\n    16\t  id: string;\n    17\t}\n    18\t\n    19\tfunction describeModel(model: ModelDescriptor): string {\n    20\t  return `${model.provider}/${model.id}`;\n    21\t}\n    22\t\n    23\t/** Note text for a model change — carries the new and previous model. */\n    24\texport function formatModelChange(ev: {\n    25\t  model: ModelDescriptor;\n    26\t  previousModel?: ModelDescriptor;\n    27\t}): string {\n    28\t  const to = describeModel(ev.model);\n    29\t  const from = ev.previousModel !== undefined ? describeModel(ev.previousModel) : \"(none)\";\n    30\t  return `model changed: ${from} → ${to}`;\n    31\t}\n    32\t\n    33\t/** Note text for a thinking-level change — carries the new and previous level. */\n    34\texport function formatThinkingLevelChange(ev: { level: string; previousLevel: string }): string {\n    35\t  return `thinking level changed: ${ev.previousLevel} → ${ev.level}`;\n    36\t}\n    37\t\n    38\tfunction runtimeNote(text: string, ctx: MapCtx): MessageEventInput {\n    39\t  return {\n    40\t    eventKind: \"runtime_note\",\n    41\t    idempotencyKey: eventKey({\n    42\t      piSessionId: ctx.piSessionId,\n    43\t      entryId: ctx.entryId,\n    44\t      blockIndex: 0,\n    45\t      kind: \"runtime_note\",\n    46\t      role: \"system\",\n    47\t      content: text,\n    48\t    }),\n    49\t    actor: \"system\",\n    50\t    harness: HARNESS,\n    51\t    payload: { text },\n    52\t  };\n    53\t}\n    54\t\n    55\t/** One `runtime_note` recording the new + previous model. */\n    56\texport function mapModelSelect(\n    57\t  ev: { model: ModelDescriptor; previousModel?: ModelDescriptor },\n    58\t  ctx: MapCtx,\n    59\t): MessageEventInput {\n    60\t  return runtimeNote(formatModelChange(ev), ctx);\n    61\t}\n    62\t\n    63\t/** One `runtime_note` recording the new + previous thinking level. */\n    64\texport function mapThinkingLevelSelect(\n    65\t  ev: { level: string; previousLevel: string },\n    66\t  ctx: MapCtx,\n    67\t): MessageEventInput {\n    68\t  return runtimeNote(formatThinkingLevelChange(ev), ctx);\n    69\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/abort.test.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Story 2 — graceful interrupt (TC-2.6). A turn PI marks aborted is captured\n     2\t// whole: the partial assistant content is recorded, the aborted disposition is\n     3\t// carried through (the mapper carries stopReason — research §5b — onto the only\n     4\t// durable vehicle, a runtime_note), and the turn closes complete-but-aborted at\n     5\t// agent_end. The interrupted content is never discarded.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport type { MessageEventInput } from \"lhc\";\n     8\timport {\n     9\t  makeAgentEnd,\n    10\t  makeAssistantMessage,\n    11\t  makeMessageEnd,\n    12\t  makeUserMessage,\n    13\t} from \"../fixtures/synthetic.js\";\n    14\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    15\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    16\t\n    17\tlet store: TempStore;\n    18\tbeforeEach(() => {\n    19\t  store = tempStore();\n    20\t});\n    21\tafterEach(() => {\n    22\t  store.cleanup();\n    23\t});\n    24\t\n    25\tfunction textOf(event: MessageEventInput): string {\n    26\t  return (event.payload as { text?: string }).text ?? \"\";\n    27\t}\n    28\t\n    29\tdescribe(\"Story 2: graceful interrupt (TC-2.6)\", () => {\n    30\t  it(\"records partial assistant content, carries the aborted disposition, and closes the turn complete-but-aborted\", async () => {\n    31\t    const started = await startCapture(store);\n    32\t    const { connector, ctx, threadRef } = started;\n    33\t\n    34\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"write a long essay\")));\n    35\t    await connector.handlers.message_end(\n    36\t      ctx,\n    37\t      makeMessageEnd(\n    38\t        makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    39\t      ),\n    40\t    );\n    41\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    42\t\n    43\t    // A graceful interrupt is not a capture failure.\n    44\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n    45\t\n    46\t    const events = await eventsAfterShutdown(started);\n    47\t    expect(kindsOf(events)).toEqual([\n    48\t      \"user_prompt\",\n    49\t      \"assistant_thinking\",\n    50\t      \"assistant_text\",\n    51\t      \"runtime_note\",\n    52\t      \"turn_end\",\n    53\t    ]);\n    54\t\n    55\t    // Partial content is preserved verbatim — nothing discarded.\n    56\t    expect(textOf(events[1]!)).toBe(\"starting the essay\");\n    57\t    expect(textOf(events[2]!)).toBe(\"Once upon a\");\n    58\t    // The aborted disposition is carried through on the runtime_note.\n    59\t    expect(textOf(events[3]!).toLowerCase()).toContain(\"abort\");\n    60\t\n    61\t    // The turn closes complete-but-aborted (closed at agent_end, not left open).\n    62\t    const counts = await turnCounts(threadRef);\n    63\t    expect(counts.closed).toBe(1);\n    64\t    expect(counts.open).toBe(0);\n    65\t  });\n    66\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/idempotency.test.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\n     2\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n     3\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n     4\t// must add nothing the second time. The key goldens pin construction precedence:\n     5\t// PI entry id → provider response / tool-call id → content fingerprint, with\n     6\t// blockIndex and kind disambiguating one message's fan-out.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\n     9\timport { capture } from \"../../src/capture/converter.js\";\n    10\timport { eventKey } from \"../../src/capture/idempotency.js\";\n    11\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    12\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    13\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    14\timport type { AgentMessage } from \"../../src/pi/types.js\";\n    15\timport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\n    16\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    17\t\n    18\tlet store: TempStore;\n    19\tbeforeEach(() => {\n    20\t  store = tempStore();\n    21\t});\n    22\tafterEach(() => {\n    23\t  store.cleanup();\n    24\t});\n    25\t\n    26\tdescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n    27\t  it(\"is deterministic: identical input yields an identical key\", () => {\n    28\t    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n    29\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\n    30\t  });\n    31\t\n    32\t  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n    33\t    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n    34\t    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n    35\t    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n    36\t    expect(thinking).toContain(\"e1\");\n    37\t    // Same entry, different block → different key (fan-out stays distinct).\n    38\t    expect(text).not.toBe(thinking);\n    39\t    // Same entry + block, different kind → still distinct.\n    40\t    expect(textSameBlock).not.toBe(thinking);\n    41\t  });\n    42\t\n    43\t  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n    44\t    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n    45\t    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n    46\t    expect(call).toContain(\"call_a\");\n    47\t    expect(result).toContain(\"call_a\");\n    48\t    expect(call).not.toBe(result);\n    49\t  });\n    50\t\n    51\t  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n    52\t    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n    53\t    expect(key).toContain(\"resp_7\");\n    54\t  });\n    55\t\n    56\t  it(\"falls to content plus a stable discriminator as last resort\", () => {\n    57\t    const a = eventKey({ piSessionId: \"s\", fallbackId: \"entry-a\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    58\t    const aAgain = eventKey({ piSessionId: \"s\", fallbackId: \"entry-a\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    59\t    const b = eventKey({ piSessionId: \"s\", fallbackId: \"entry-b\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    60\t    expect(aAgain).toBe(a);\n    61\t    expect(b).not.toBe(a);\n    62\t  });\n    63\t\n    64\t  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n    65\t    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n    66\t    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n    67\t    expect(withBoth).toBe(entryOnly);\n    68\t  });\n    69\t});\n    70\t\n    71\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n    72\t  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n    73\t  const events: MessageEventInput[] = [];\n    74\t  source.forEach((message, index) => {\n    75\t    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n    76\t    acc.onMessage(mapped);\n    77\t    events.push(...mapped);\n    78\t  });\n    79\t  events.push(...acc.onAgentEnd());\n    80\t  return events;\n    81\t}\n    82\t\n    83\tdescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n    84\t  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n    85\t    const thread = await makeTempThread(store);\n    86\t    const built = await initInstance(thread.threadRef, {\n    87\t      provider: createDeterministicProvider(),\n    88\t      mode: \"background\",\n    89\t    });\n    90\t    expect(built.ok).toBe(true);\n    91\t    if (!built.ok) return;\n    92\t    const instance = built.value;\n    93\t\n    94\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n    95\t\n    96\t    const first = await capture(batch, instance);\n    97\t    expect(first.ok).toBe(true);\n    98\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    99\t\n   100\t    const replay = await capture(batch, instance);\n   101\t    expect(replay.ok).toBe(true);\n   102\t    if (replay.ok) {\n   103\t      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   104\t    }\n   105\t\n   106\t    const read = await intakeStream.listEvents(instance.threadRef);\n   107\t    expect(read.ok).toBe(true);\n   108\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   109\t\n   110\t    await instance.dispose();\n   111\t  });\n   112\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/parallel-and-errors.test.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Story 2 — parallel-tool correlation (TC-2.4), error-result capture (TC-2.5),\n     2\t// and idempotent re-delivery (TC-2.7, the idempotency architecture-risk). The\n     3\t// first two run the production path and read the thread back; TC-2.7 drives\n     4\t// capture() directly so it can assert the per-event skip outcomes the SDK\n     5\t// returns on re-delivery.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport { createDeterministicProvider, intakeStream } from \"lhc\";\n     8\timport { capture } from \"../../src/capture/converter.js\";\n     9\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    10\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    11\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    12\timport {\n    13\t  makeAgentEnd,\n    14\t  makeAssistantMessage,\n    15\t  makeMessageEnd,\n    16\t  makeToolResult,\n    17\t  makeUserMessage,\n    18\t} from \"../fixtures/synthetic.js\";\n    19\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    20\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tinterface ToolResultPayload {\n    31\t  toolCallId: string;\n    32\t  content: string;\n    33\t  isError?: boolean;\n    34\t}\n    35\tfunction toolResultPayload(event: { payload: unknown }): ToolResultPayload {\n    36\t  return event.payload as ToolResultPayload;\n    37\t}\n    38\t\n    39\tdescribe(\"Story 2: parallel tool calls (TC-2.4)\", () => {\n    40\t  it(\"correlates each out-of-order tool_result to its call by toolCallId, not arrival order\", async () => {\n    41\t    const started = await startCapture(store);\n    42\t    const { connector, ctx } = started;\n    43\t\n    44\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read both files\")));\n    45\t    await connector.handlers.message_end(\n    46\t      ctx,\n    47\t      makeMessageEnd(\n    48\t        makeAssistantMessage({\n    49\t          toolCalls: [\n    50\t            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n    51\t            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n    52\t          ],\n    53\t        }),\n    54\t      ),\n    55\t    );\n    56\t    // Results complete out of arrival order: b before a.\n    57\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b body\" })));\n    58\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a body\" })));\n    59\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"read both\" })));\n    60\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    61\t\n    62\t    const events = await eventsAfterShutdown(started);\n    63\t    const results = events.filter((event) => event.eventKind === \"tool_result\");\n    64\t    expect(results).toHaveLength(2);\n    65\t\n    66\t    // Each result carries its own call's id and content — correlation is by id.\n    67\t    const contentById = new Map(\n    68\t      results.map((event) => [toolResultPayload(event).toolCallId, toolResultPayload(event).content]),\n    69\t    );\n    70\t    expect(contentById.get(\"call_b\")).toBe(\"b body\");\n    71\t    expect(contentById.get(\"call_a\")).toBe(\"a body\");\n    72\t\n    73\t    // Arrival order is preserved in the record (b then a), each correctly tagged\n    74\t    // — proving the tag, not the position, is the correlation.\n    75\t    expect(toolResultPayload(results[0]!).toolCallId).toBe(\"call_b\");\n    76\t    expect(toolResultPayload(results[1]!).toolCallId).toBe(\"call_a\");\n    77\t  });\n    78\t});\n    79\t\n    80\tdescribe(\"Story 2: error tool result (TC-2.5)\", () => {\n    81\t  it(\"captures an error tool_result with the error flag and its content, dropping nothing\", async () => {\n    82\t    const started = await startCapture(store);\n    83\t    const { connector, ctx } = started;\n    84\t\n    85\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read missing.txt\")));\n    86\t    await connector.handlers.message_end(\n    87\t      ctx,\n    88\t      makeMessageEnd(makeAssistantMessage({ toolCalls: [{ id: \"call_a\", name: \"read_file\", arguments: { path: \"missing.txt\" } }] })),\n    89\t    );\n    90\t    await connector.handlers.message_end(\n    91\t      ctx,\n    92\t      makeMessageEnd(makeToolResult({ id: \"call_a\", isError: true, content: \"ENOENT: no such file\" })),\n    93\t    );\n    94\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"it does not exist\" })));\n    95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    96\t\n    97\t    const events = await eventsAfterShutdown(started);\n    98\t    // Nothing dropped because the tool failed.\n    99\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"tool_call\", \"tool_result\", \"assistant_text\", \"turn_end\"]);\n   100\t\n   101\t    const result = events.find((event) => event.eventKind === \"tool_result\");\n   102\t    expect(result).toBeDefined();\n   103\t    expect(toolResultPayload(result!).isError).toBe(true);\n   104\t    expect(toolResultPayload(result!).content).toBe(\"ENOENT: no such file\");\n   105\t  });\n   106\t\n   107\t  it(\"records unsupported tool_result content parts as omission runtime_notes\", () => {\n   108\t    const events = mapMessage(\n   109\t      {\n   110\t        role: \"toolResult\",\n   111\t        toolCallId: \"call_file\",\n   112\t        content: [{ type: \"fileRef\", path: \"artifact.bin\" }],\n   113\t      },\n   114\t      { piSessionId: \"sess\" },\n   115\t    );\n   116\t\n   117\t    expect(kindsOf(events)).toEqual([\"tool_result\", \"runtime_note\"]);\n   118\t    expect(toolResultPayload(events[0]!).toolCallId).toBe(\"call_file\");\n   119\t    expect(toolResultPayload(events[0]!).content).toBe(\"\");\n   120\t    expect(events[1]!.payload).toEqual({\n   121\t      text: \"unsupported content omitted: file reference (artifact.bin)\",\n   122\t    });\n   123\t  });\n   124\t});\n   125\t\n   126\tdescribe(\"Story 2: idempotent re-delivery (TC-2.7, idempotency risk)\", () => {\n   127\t  it(\"skips a re-delivered batch by idempotency key and records no duplicates\", async () => {\n   128\t    const thread = await makeTempThread(store);\n   129\t    const built = await initInstance(thread.threadRef, {\n   130\t      provider: createDeterministicProvider(),\n   131\t      mode: \"background\",\n   132\t    });\n   133\t    expect(built.ok).toBe(true);\n   134\t    if (!built.ok) return;\n   135\t    const instance = built.value;\n   136\t\n   137\t    // Build one logical turn's events through the real map + accumulator, so the\n   138\t    // keys are exactly what production would emit.\n   139\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   140\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n   141\t    acc.onMessage(userEvents);\n   142\t    const assistantEvents = mapMessage(makeAssistantMessage({ text: \"hi there\" }), {\n   143\t      piSessionId: \"sess\",\n   144\t      entryId: \"s1\",\n   145\t    });\n   146\t    acc.onMessage(assistantEvents);\n   147\t    const turnEnd = acc.onAgentEnd();\n   148\t    const batch = [...userEvents, ...assistantEvents, ...turnEnd];\n   149\t\n   150\t    const first = await capture(batch, instance);\n   151\t    expect(first.ok).toBe(true);\n   152\t    if (first.ok) {\n   153\t      expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   154\t    }\n   155\t\n   156\t    // Re-delivery (the reload / crash-replay path): identical keys → all skipped.\n   157\t    const second = await capture(batch, instance);\n   158\t    expect(second.ok).toBe(true);\n   159\t    if (second.ok) {\n   160\t      expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   161\t      expect(\n   162\t        second.value.events.every((entry) => entry.skipReason === \"duplicate_idempotency_key\"),\n   163\t      ).toBe(true);\n   164\t    }\n   165\t\n   166\t    // No duplicate records landed on the thread.\n   167\t    const read = await intakeStream.listEvents(instance.threadRef);\n   168\t    expect(read.ok).toBe(true);\n   169\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   170\t\n   171\t    await instance.dispose();\n   172\t  });\n   173\t});\n","exit_code":0,"status":"completed"}}

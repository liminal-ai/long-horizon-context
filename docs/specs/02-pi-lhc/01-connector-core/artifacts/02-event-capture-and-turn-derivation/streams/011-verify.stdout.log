nference/artifacts/quick-fix/progress/003-quick-fix.status.json\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stderr.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stderr.log\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/002-quick-fix.stderr.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/quick-fix/streams/002-quick-fix.stderr.log\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/002-quick-fix.stdout.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/quick-fix/streams/002-quick-fix.stdout.log\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/003-quick-fix.stderr.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/quick-fix/streams/003-quick-fix.stderr.log\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/003-quick-fix.stdout.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/quick-fix/streams/003-quick-fix.stdout.log\nR  packages/lhc/docs/02-specs/05-derivation-inference/epic.md -> docs/specs/01-lhc-sdk/05-derivation-inference/epic.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/impl-run.config.json -> docs/specs/01-lhc-sdk/05-derivation-inference/impl-run.config.json\nR  packages/lhc/docs/02-specs/05-derivation-inference/stories/01-cli-retirement.md -> docs/specs/01-lhc-sdk/05-derivation-inference/stories/01-cli-retirement.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/stories/02-inference-seam-and-model-assignment.md -> docs/specs/01-lhc-sdk/05-derivation-inference/stories/02-inference-seam-and-model-assignment.md\nR  packages/lhc/docs/02-specs/05-derivation
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/converter.test.ts | sed -n '1,320p'\"","aggregated_output":"     1\t// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\n     2\t// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\n     3\t// production path runs end to end — PI hook → converter → real LHC intake —\n     4\t// and every assertion reads the durable thread back. TC-2.8 also exercises\n     5\t// capture() directly because the two failure shapes (writable→gap vs\n     6\t// store-unavailable→health) are the architecture-risk contract.\n     7\timport { rmSync } from \"node:fs\";\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  inspect,\n    12\t  intakeStream,\n    13\t  threads,\n    14\t  type MessageEventInput,\n    15\t  type ThreadRef,\n    16\t} from \"lhc\";\n    17\timport { capture } from \"../../src/capture/converter.js\";\n    18\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    19\timport type { LhcInstance } from \"../../src/shared/instance.js\";\n    20\timport {\n    21\t  makeAgentEnd,\n    22\t  makeAssistantMessage,\n    23\t  makeMessageEnd,\n    24\t  makeToolResult,\n    25\t  makeUserMessage,\n    26\t  validEvent,\n    27\t} from \"../fixtures/synthetic.js\";\n    28\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    29\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n    30\t\n    31\tlet store: TempStore;\n    32\tbeforeEach(() => {\n    33\t  store = tempStore();\n    34\t});\n    35\tafterEach(() => {\n    36\t  store.cleanup();\n    37\t});\n    38\t\n    39\tfunction textOf(event: MessageEventInput): string {\n    40\t  return (event.payload as { text?: string }).text ?? \"\";\n    41\t}\n    42\t\n    43\tdescribe(\"Story 2: converter — capture and fan-out (TC-2.1)\", () => {\n    44\t  it(\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\", async () => {\n    45\t    const started = await startCapture(store);\n    46\t    const { connector, ctx } = started;\n    47\t\n    48\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read the file\")));\n    49\t    await connector.handlers.message_end(\n    50\t      ctx,\n    51\t      makeMessageEnd(\n    52\t        makeAssistantMessage({\n    53\t          thinking: \"I should open it\",\n    54\t          text: \"here is the answer\",\n    55\t          toolCalls: [{ id: \"call_x\", name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n    56\t        }),\n    57\t      ),\n    58\t    );\n    59\t    await connector.handlers.message_end(\n    60\t      ctx,\n    61\t      makeMessageEnd(makeToolResult({ id: \"call_x\", content: \"file body\" })),\n    62\t    );\n    63\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    64\t\n    65\t    // No silent capture failure on the happy path.\n    66\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n    67\t\n    68\t    const events = await eventsAfterShutdown(started);\n    69\t    expect(kindsOf(events)).toEqual([\n    70\t      \"user_prompt\",\n    71\t      \"assistant_thinking\",\n    72\t      \"assistant_text\",\n    73\t      \"tool_call\",\n    74\t      \"tool_result\",\n    75\t      \"turn_end\",\n    76\t    ]);\n    77\t\n    78\t    expect(textOf(events[0]!)).toBe(\"read the file\");\n    79\t    expect(textOf(events[1]!)).toBe(\"I should open it\");\n    80\t    expect(textOf(events[2]!)).toBe(\"here is the answer\");\n    81\t    expect(events[3]!.payload).toMatchObject({\n    82\t      toolCallId: \"call_x\",\n    83\t      toolName: \"read_file\",\n    84\t      arguments: { path: \"notes.txt\" },\n    85\t    });\n    86\t    expect(events[4]!.payload).toMatchObject({ toolCallId: \"call_x\", content: \"file body\" });\n    87\t  });\n    88\t});\n    89\t\n    90\tdescribe(\"Story 2: converter — runtime-change capture (TC-2.9)\", () => {\n    91\t  it(\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\", async () => {\n    92\t    const started = await startCapture(store);\n    93\t    const { connector, ctx } = started;\n    94\t\n    95\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"go\")));\n    96\t    await connector.handlers.model_select(ctx, {\n    97\t      model: { provider: \"openai\", id: \"gpt-4o\" },\n    98\t      previousModel: { provider: \"anthropic\", id: \"claude-3\" },\n    99\t    });\n   100\t    await connector.handlers.thinking_level_select(ctx, { level: \"high\", previousLevel: \"low\" });\n   101\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"done\" })));\n   102\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   103\t\n   104\t    const events = await eventsAfterShutdown(started);\n   105\t    // Ordering relative to the surrounding messages is preserved.\n   106\t    expect(kindsOf(events)).toEqual([\n   107\t      \"user_prompt\",\n   108\t      \"runtime_note\",\n   109\t      \"runtime_note\",\n   110\t      \"assistant_text\",\n   111\t      \"turn_end\",\n   112\t    ]);\n   113\t\n   114\t    const modelNote = textOf(events[1]!);\n   115\t    expect(modelNote).toContain(\"anthropic/claude-3\");\n   116\t    expect(modelNote).toContain(\"openai/gpt-4o\");\n   117\t\n   118\t    const levelNote = textOf(events[2]!);\n   119\t    expect(levelNote).toContain(\"low\");\n   120\t    expect(levelNote).toContain(\"high\");\n   121\t  });\n   122\t\n   123\t  it(\"records repeated identical model_select hooks as distinct source-position events\", async () => {\n   124\t    const started = await startCapture(store);\n   125\t    const { connector, ctx } = started;\n   126\t    const event = { model: { provider: \"openai\", id: \"gpt-4o\" }, position: 12 };\n   127\t\n   128\t    await connector.handlers.model_select(ctx, event);\n   129\t    await connector.handlers.model_select(ctx, { ...event, position: 13 });\n   130\t    await connector.handlers.model_select(ctx, event);\n   131\t\n   132\t    const events = await eventsAfterShutdown(started);\n   133\t    expect(kindsOf(events)).toEqual([\"runtime_note\", \"runtime_note\"]);\n   134\t    expect(events[0]!.idempotencyKey).toContain(\"model_select:12\");\n   135\t    expect(events[1]!.idempotencyKey).toContain(\"model_select:13\");\n   136\t    expect(events[0]!.idempotencyKey).not.toBe(events[1]!.idempotencyKey);\n   137\t  });\n   138\t});\n   139\t\n   140\tdescribe(\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\", () => {\n   141\t  async function liveInstance(): Promise<LhcInstance> {\n   142\t    const thread = await makeTempThread(store);\n   143\t    const built = await initInstance(thread.threadRef, {\n   144\t      provider: createDeterministicProvider(),\n   145\t      mode: \"background\",\n   146\t    });\n   147\t    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\n   148\t    return built.value;\n   149\t  }\n   150\t\n   151\t  it(\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\", async () => {\n   152\t    const instance = await liveInstance();\n   153\t    // A turn_end with a non-empty payload is rejected by LHC validation\n   154\t    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\n   155\t    const malformed = {\n   156\t      eventKind: \"turn_end\",\n   157\t      idempotencyKey: \"malformed-1\",\n   158\t      actor: \"system\",\n   159\t      harness: \"pi\",\n   160\t      payload: { stowaway: true },\n   161\t    } as unknown as MessageEventInput;\n   162\t\n   163\t    const result = await capture([malformed], instance);\n   164\t    expect(result.ok).toBe(false);\n   165\t\n   166\t    // The session continues: a durable, queryable gap is recorded on the thread.\n   167\t    const read = await intakeStream.listEvents(instance.threadRef);\n   168\t    expect(read.ok).toBe(true);\n   169\t    if (!read.ok) return;\n   170\t    const gaps = read.value.filter(\n   171\t      (event) =>\n   172\t        event.eventKind === \"runtime_note\" &&\n   173\t        (event.payload as { text: string }).text.toLowerCase().includes(\"gap\"),\n   174\t    );\n   175\t    expect(gaps).toHaveLength(1);\n   176\t\n   177\t    const health = await inspect.health(instance.threadRef);\n   178\t    expect(health.ok).toBe(true);\n   179\t    if (!health.ok) return;\n   180\t    expect(health.value.owners).toContainEqual({\n   181\t      owner: \"capture\",\n   182\t      kind: \"capture_gap\",\n   183\t      counts: { ready: 0, pending: 0, retrying: 0, failed: 1, blocked: 0 },\n   184\t    });\n   185\t    expect(health.value.failures).toContainEqual({\n   186\t      owner: \"capture\",\n   187\t      subjectKind: \"event\",\n   188\t      subjectId: String(gaps[0]!.eventOrder),\n   189\t      form: \"capture_gap\",\n   190\t      reason: (gaps[0]!.payload as { text: string }).text,\n   191\t      attempts: 0,\n   192\t    });\n   193\t\n   194\t    await instance.dispose();\n   195\t  });\n   196\t\n   197\t  it(\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\", async () => {\n   198\t    const deadInstance: LhcInstance = {\n   199\t      sdk: (await liveInstance()).sdk,\n   200\t      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\n   201\t      dispose: () => Promise.resolve({ ok: true, value: undefined }),\n   202\t    };\n   203\t\n   204\t    // capture isolates the failure into a structured result rather than throwing.\n   205\t    const result = await capture([validEvent(\"user_prompt\")], deadInstance);\n   206\t    expect(result.ok).toBe(false);\n   207\t    if (result.ok) return;\n   208\t    expect([\"thread_not_found\", \"storage_failure\"]).toContain(result.error.code);\n   209\t    // It is NOT misclassified as the writable-thread malformed-event case.\n   210\t    expect(result.error.code).not.toBe(\"invalid_event\");\n   211\t  });\n   212\t\n   213\t  it(\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\", async () => {\n   214\t    const started = await startCapture(store);\n   215\t    const { connector, ctx, threadRef } = started;\n   216\t\n   217\t    // Make the live thread's store unavailable mid-session, then capture.\n   218\t    const id = (threadRef as { threadId: string }).threadId;\n   219\t    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\n   220\t    expect(row.ok).toBe(true);\n   221\t    if (!row.ok) return;\n   222\t    rmSync(row.value.filePath, { force: true });\n   223\t\n   224\t    // The hook must not throw despite the dead store.\n   225\t    await expect(\n   226\t      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"after the store died\"))),\n   227\t    ).resolves.toBeUndefined();\n   228\t\n   229\t    const health = connector.getState()?.health.lastCaptureFailure;\n   230\t    expect(health).toBeDefined();\n   231\t    expect(health?.recordedGap).toBe(false);\n   232\t\n   233\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   234\t  });\n   235\t\n   236\t  it(\"(c) an unmappable hook input on a writable thread records a durable gap, surfaces in health, and does not throw\", async () => {\n   237\t    const started = await startCapture(store);\n   238\t    const { connector, ctx, threadRef } = started;\n   239\t\n   240\t    await expect(\n   241\t      connector.handlers.message_end(ctx, {\n   242\t        position: 71,\n   243\t        message: { role: \"badRole\", content: [] } as never,\n   244\t      }),\n   245\t    ).resolves.toBeUndefined();\n   246\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"session continues\"), undefined, 72));\n   247\t\n   248\t    const read = await intakeStream.listEvents(threadRef);\n   249\t    expect(read.ok).toBe(true);\n   250\t    if (!read.ok) return;\n   251\t    const gaps = read.value.filter(\n   252\t      (event) =>\n   253\t        event.eventKind === \"runtime_note\" &&\n   254\t        (event.payload as { text: string }).text.includes(\"capture gap\"),\n   255\t    );\n   256\t    expect(gaps).toHaveLength(1);\n   257\t    expect((gaps[0]!.payload as { text: string }).text).toContain(\"unmappable PI hook input\");\n   258\t\n   259\t    const health = await inspect.health(threadRef);\n   260\t    expect(health.ok).toBe(true);\n   261\t    if (!health.ok) return;\n   262\t    expect(health.value.failures).toContainEqual({\n   263\t      owner: \"capture\",\n   264\t      subjectKind: \"event\",\n   265\t      subjectId: String(gaps[0]!.eventOrder),\n   266\t      form: \"capture_gap\",\n   267\t      reason: (gaps[0]!.payload as { text: string }).text,\n   268\t      attempts: 0,\n   269\t    });\n   270\t\n   271\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   272\t    const events = await intakeStream.listEvents(threadRef);\n   273\t    expect(events.ok).toBe(true);\n   274\t    if (events.ok) expect(events.value.some((event) => textOf(event) === \"session continues\")).toBe(true);\n   275\t  });\n   276\t});\n","exit_code":0,"status":"completed"}}

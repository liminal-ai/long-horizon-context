{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/inspect/internal/health.ts'","aggregated_output":"     1\t// Health composition (Flow 4): owners' report surfaces joined into state\n     2\t// counts, actionable failure detail, a repair preview, and live queue\n     3\t// visibility. Message/turn derivation health comes from FormReportEntry rows;\n     4\t// capture gaps come from durable source-event markers recorded by capture.\n     5\timport type { FormReportEntry } from \"../../../shared/derivation.js\";\n     6\timport type { OpResult } from \"../../../shared/errors.js\";\n     7\timport type { HealthReport } from \"../../../shared/inspect.js\";\n     8\timport * as intakeStream from \"../../intake-stream/index.js\";\n     9\timport * as messages from \"../../messages/index.js\";\n    10\timport * as turns from \"../../turns/index.js\";\n    11\timport type { ThreadRef } from \"../../threads/index.js\";\n    12\t\n    13\ttype Owner = \"capture\" | \"messages\" | \"turns\";\n    14\t\n    15\tfunction emptyCounts(): HealthReport[\"owners\"][number][\"counts\"] {\n    16\t  return { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n    17\t}\n    18\t\n    19\tfunction captureGapText(event: intakeStream.EventRecord): string | null {\n    20\t  if (event.eventKind !== \"runtime_note\") return null;\n    21\t  return event.payload.text.startsWith(\"capture gap:\") ? event.payload.text : null;\n    22\t}\n    23\t\n    24\t// Failure detail (AC-4.2): attempts and last error read from wherever the\n    25\t// mechanics durably put them — retry exhaustion copies them onto the form's\n    26\t// metadata before the queue row is deleted; a still-live item carries them\n    27\t// on the queue join. Never synthesized.\n    28\tfunction failureOf(\n    29\t  owner: Owner,\n    30\t  entry: FormReportEntry,\n    31\t): HealthReport[\"failures\"][number] {\n    32\t  const failure: HealthReport[\"failures\"][number] = {\n    33\t    owner,\n    34\t    subjectKind: entry.subjectKind,\n    35\t    subjectId: entry.subjectId,\n    36\t    form: entry.form,\n    37\t    reason: entry.reason ?? \"\",\n    38\t    attempts: entry.metadata?.attempts ?? entry.queue?.attempts ?? 0,\n    39\t  };\n    40\t  const lastError = entry.metadata?.lastError ?? entry.queue?.lastError;\n    41\t  if (lastError !== undefined) failure.lastError = lastError;\n    42\t  return failure;\n    43\t}\n    44\t\n    45\texport async function composeHealth(ref: ThreadRef): Promise<OpResult<HealthReport>> {\n    46\t  const messageReport = await messages.report(ref);\n    47\t  if (!messageReport.ok) return messageReport;\n    48\t  const turnReport = await turns.report(ref);\n    49\t  if (!turnReport.ok) return turnReport;\n    50\t  const events = await intakeStream.listEvents(ref);\n    51\t  if (!events.ok) return events;\n    52\t\n    53\t  const sources: ReadonlyArray<readonly [Owner, readonly FormReportEntry[]]> = [\n    54\t    [\"messages\", messageReport.value],\n    55\t    [\"turns\", turnReport.value],\n    56\t  ];\n    57\t\n    58\t  const countsByOwnerKind = new Map<string, HealthReport[\"owners\"][number]>();\n    59\t  const failures: HealthReport[\"failures\"] = [];\n    60\t  const repairPreview: HealthReport[\"repairPreview\"] = [];\n    61\t  const queue = { queued: 0, claimed: 0 };\n    62\t\n    63\t  const captureGaps = events.value\n    64\t    .map((event) => ({ event, text: captureGapText(event) }))\n    65\t    .filter((gap): gap is { event: intakeStream.EventRecord; text: string } => gap.text !== null);\n    66\t  if (captureGaps.length > 0) {\n    67\t    countsByOwnerKind.set(\"capture:capture_gap\", {\n    68\t      owner: \"capture\",\n    69\t      kind: \"capture_gap\",\n    70\t      counts: { ...emptyCounts(), failed: captureGaps.length },\n    71\t    });\n    72\t    for (const { event, text } of captureGaps) {\n    73\t      failures.push({\n    74\t        owner: \"capture\",\n    75\t        subjectKind: \"event\",\n    76\t        subjectId: String(event.eventOrder),\n    77\t        form: \"capture_gap\",\n    78\t        reason: text,\n    79\t        attempts: 0,\n    80\t      });\n    81\t    }\n    82\t  }\n    83\t\n    84\t  for (const [owner, entries] of sources) {\n    85\t    for (const entry of entries) {\n    86\t      const key = `${owner}:${entry.form}`;\n    87\t      let row = countsByOwnerKind.get(key);\n    88\t      if (row === undefined) {\n    89\t        row = { owner, kind: entry.form, counts: emptyCounts() };\n    90\t        countsByOwnerKind.set(key, row);\n    91\t      }\n    92\t      switch (entry.state) {\n    93\t        case \"ready\":\n    94\t          row.counts.ready += 1;\n    95\t          break;\n    96\t        case \"pending\":\n    97\t          if ((entry.queue?.attempts ?? 0) > 0) row.counts.retrying += 1;\n    98\t          else row.counts.pending += 1;\n    99\t          break;\n   100\t        case \"failed\":\n   101\t          row.counts.failed += 1;\n   102\t          failures.push(failureOf(owner, entry));\n   103\t          // The preview is exactly the failed-and-not-blocked set: blocked is\n   104\t          // a distinct state, so failed entries ARE the requeue targets.\n   105\t          repairPreview.push({\n   106\t            owner,\n   107\t            subjectKind: entry.subjectKind,\n   108\t            subjectId: entry.subjectId,\n   109\t            form: entry.form,\n   110\t          });\n   111\t          break;\n   112\t        case \"blocked\":\n   113\t          row.counts.blocked += 1;\n   114\t          failures.push(failureOf(owner, entry));\n   115\t          break;\n   116\t      }\n   117\t      // Live queue visibility (AC-4.5), per report entry: every pending or\n   118\t      // retrying entry rides a live item, so queued + claimed here equals\n   119\t      // pending + retrying above by construction. Counts are per form-report\n   120\t      // entry by ratified contract (Epic 04 fix-batch-001): one work item\n   121\t      // (e.g. a turn_derivation) may back multiple form entries, so a raw\n   122\t      // listQueuedWork work-item count would break that identity.\n   123\t      if (entry.queue !== undefined) {\n   124\t        if (entry.queue.status === \"queued\") queue.queued += 1;\n   125\t        else queue.claimed += 1;\n   126\t      }\n   127\t    }\n   128\t  }\n   129\t\n   130\t  // Deterministic order: messages before turns, kinds alphabetical within\n   131\t  // an owner — repeated reads with no writes between are deep-equal.\n   132\t  const owners = [...countsByOwnerKind.values()].sort((a, b) =>\n   133\t    a.owner === b.owner ? a.kind.localeCompare(b.kind) : a.owner.localeCompare(b.owner),\n   134\t  );\n   135\t\n   136\t  return { ok: true, value: { owners, failures, repairPreview, queue } };\n   137\t}\n","exit_code":0,"status":"completed"}}

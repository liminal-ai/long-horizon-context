{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/support.ts | sed -n '1,160p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/support.ts | sed -n '1,160p'\"","aggregated_output":"     1\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\n     2\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\n     3\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\n     4\t// converter → real LHC intake) so every capture test asserts on recorded\n     5\t// thread state, never on a mocked intake. The two external edges stay as the\n     6\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\n     7\t// SDK runs real against a temp SQLite thread with the deterministic provider\n     8\t// (selected by explicit name, never a production default).\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  inspect,\n    12\t  intakeStream,\n    13\t  type EventKind,\n    14\t  type MessageEventInput,\n    15\t  type OpResult,\n    16\t  type SdkConfig,\n    17\t  type ThreadRef,\n    18\t} from \"lhc\";\n    19\timport { createConnector, type Connector } from \"../../src/index.js\";\n    20\timport type { LaunchFlags } from \"../../src/lifecycle/thread-resolution.js\";\n    21\timport type { ExtensionContext, SessionStartReason } from \"../../src/pi/types.js\";\n    22\timport { makeSessionStart } from \"../fixtures/synthetic.js\";\n    23\timport type { TempStore } from \"../fixtures/thread.js\";\n    24\t\n    25\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\n    26\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\n    27\t *  assume a TUI. */\n    28\texport function syntheticCtx(cwd = \"/work/capture\"): ExtensionContext {\n    29\t  return {\n    30\t    cwd,\n    31\t    hasUI: false,\n    32\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n    33\t    ui: { notify: () => {} },\n    34\t    sessionManager: { getEntries: () => [] },\n    35\t  };\n    36\t}\n    37\t\n    38\t/** The capture-suite SDK config: a real background instance on the\n    39\t *  deterministic provider, so a captured user_prompt's queued derivation has a\n    40\t *  handler to settle and never strands background work. */\n    41\texport function captureConfig(): OpResult<SdkConfig> {\n    42\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n    43\t}\n    44\t\n    45\texport interface StartedCapture {\n    46\t  connector: Connector;\n    47\t  ctx: ExtensionContext;\n    48\t  threadRef: ThreadRef;\n    49\t}\n    50\t\n    51\t/** Start a connector against a temp store under the given launch flags and fire\n    52\t *  `session_start{reason}`. The driver for existing-thread reattach: pass\n    53\t *  `{ session: threadId }` with reason `\"resume\"`/`\"reload\"` to attach a fresh\n    54\t *  connector to a thread a prior connector created. */\n    55\texport async function attachCapture(\n    56\t  store: TempStore,\n    57\t  launch: LaunchFlags,\n    58\t  reason: SessionStartReason,\n    59\t  cwd = \"/work/capture\",\n    60\t): Promise<StartedCapture> {\n    61\t  const connector = createConnector({\n    62\t    registryPath: store.registryPath,\n    63\t    newThreadFilePath: () => store.threadPath(),\n    64\t    parseLaunch: () => launch,\n    65\t    buildSdkConfig: () => captureConfig(),\n    66\t  });\n    67\t  const ctx = syntheticCtx(cwd);\n    68\t  await connector.handlers.session_start(ctx, makeSessionStart(reason));\n    69\t  const state = connector.getState();\n    70\t  if (state === null) throw new Error(\"attachCapture: session_start did not resolve a thread\");\n    71\t  return { connector, ctx, threadRef: state.threadRef };\n    72\t}\n    73\t\n    74\t/** Start a connector against a temp store and fire `session_start{new}` so a\n    75\t *  background instance + thread exist and the capture hooks are live. */\n    76\texport async function startCapture(store: TempStore, cwd = \"/work/capture\"): Promise<StartedCapture> {\n    77\t  return attachCapture(store, {}, \"new\", cwd);\n    78\t}\n    79\t\n    80\t/** Settle background work and dispose, then read the durable event log back in\n    81\t *  recorded order — capture's product is the stored thread, so tests assert on\n    82\t *  this. */\n    83\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\n    84\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \"shutdown\" });\n    85\t  const read = await intakeStream.listEvents(started.threadRef);\n    86\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n    87\t  // Strip the server-stamped fields so the comparison is over the logical\n    88\t  // intake shape the converter produced.\n    89\t  return read.value.map((record) => ({\n    90\t    eventKind: record.eventKind,\n    91\t    idempotencyKey: record.idempotencyKey,\n    92\t    actor: record.actor,\n    93\t    harness: record.harness,\n    94\t    payload: record.payload,\n    95\t  })) as MessageEventInput[];\n    96\t}\n    97\t\n    98\t/** The ordered event-kind sequence — the spine every capture test checks. */\n    99\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\n   100\t  return events.map((event) => event.eventKind);\n   101\t}\n   102\t\n   103\t/** Counts open/closed turns and total recorded events from the inspect\n   104\t *  overview (the real read-back surface, not a private query). */\n   105\texport async function turnCounts(\n   106\t  threadRef: ThreadRef,\n   107\t): Promise<{ open: number; closed: number; events: number }> {\n   108\t  const overview = await inspect.overview(threadRef);\n   109\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\n   110\t  return {\n   111\t    open: overview.value.turns.open,\n   112\t    closed: overview.value.turns.closed,\n   113\t    events: overview.value.events.count,\n   114\t  };\n   115\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/reattach-idempotency.test.ts | sed -n '1,340p'\"","aggregated_output":"     1\t// Story 2 — SV-001 regression: existing-thread resume/reload must keep recording\n     2\t// new finalized events. The connector seeds its capture counters from the\n     3\t// thread's durable committed state at attach, so a fresh connector's idempotency\n     4\t// keys continue past the prior session's instead of restarting at 0 and\n     5\t// skipping new events as false duplicates — while the converter's same-key\n     6\t// dedup (the reload/replay safety net) stays intact.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  createDeterministicProvider,\n    10\t  intakeStream,\n    11\t  type MessageEventInput,\n    12\t  type ThreadRef,\n    13\t} from \"lhc\";\n    14\timport { capture } from \"../../src/capture/converter.js\";\n    15\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    16\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    17\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    18\timport {\n    19\t  makeAgentEnd,\n    20\t  makeAssistantMessage,\n    21\t  makeMessageEnd,\n    22\t  makeUserMessage,\n    23\t} from \"../fixtures/synthetic.js\";\n    24\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    25\timport { attachCapture, eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    26\t\n    27\tlet store: TempStore;\n    28\tbeforeEach(() => {\n    29\t  store = tempStore();\n    30\t});\n    31\tafterEach(() => {\n    32\t  store.cleanup();\n    33\t});\n    34\t\n    35\tfunction textOf(event: MessageEventInput): string {\n    36\t  return (event.payload as { text?: string }).text ?? \"\";\n    37\t}\n    38\t\n    39\tfunction userTexts(events: readonly MessageEventInput[]): string[] {\n    40\t  return events.filter((event) => event.eventKind === \"user_prompt\").map(textOf);\n    41\t}\n    42\t\n    43\tfunction threadIdOf(ref: ThreadRef): string {\n    44\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n    45\t  return ref.threadId;\n    46\t}\n    47\t\n    48\tdescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n    49\t  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n    50\t    // Session A records one exchange, then shuts down.\n    51\t    const a = await startCapture(store);\n    52\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    53\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    54\t    const threadId = threadIdOf(a.threadRef);\n    55\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n    56\t\n    57\t    // A brand-new connector attaches to the SAME thread by id and records a new\n    58\t    // message — it must NOT be skipped as a prior-key collision.\n    59\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n    60\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    61\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n    62\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    63\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    64\t\n    65\t    const events = await eventsAfterShutdown(b);\n    66\t    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n    67\t    const counts = await turnCounts(b.threadRef);\n    68\t    expect(counts.closed).toBe(2);\n    69\t  });\n    70\t\n    71\t  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n    72\t    const a = await startCapture(store);\n    73\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    74\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    75\t    const threadId = threadIdOf(a.threadRef);\n    76\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    77\t\n    78\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    79\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after reload\")));\n    80\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    81\t\n    82\t    const events = await eventsAfterShutdown(b);\n    83\t    expect(userTexts(events)).toEqual([\"first\", \"second after reload\"]);\n    84\t    const counts = await turnCounts(b.threadRef);\n    85\t    expect(counts.closed).toBe(2);\n    86\t  });\n    87\t\n    88\t  it(\"(2b) a reload re-delivering the same logical events skips them instead of recording duplicates\", async () => {\n    89\t    const a = await startCapture(store);\n    90\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\"), \"entry-user-1\"));\n    91\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    92\t    const threadId = threadIdOf(a.threadRef);\n    93\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    94\t\n    95\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    96\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"first\"), \"entry-user-1\"));\n    97\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    98\t\n    99\t    const events = await eventsAfterShutdown(b);\n   100\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"turn_end\"]);\n   101\t    expect(userTexts(events)).toEqual([\"first\"]);\n   102\t    const counts = await turnCounts(b.threadRef);\n   103\t    expect(counts.closed).toBe(1);\n   104\t\n   105\t    const built = await initInstance(b.threadRef, {\n   106\t      provider: createDeterministicProvider(),\n   107\t      mode: \"background\",\n   108\t    });\n   109\t    expect(built.ok).toBe(true);\n   110\t    if (!built.ok) return;\n   111\t    const instance = built.value;\n   112\t    const acc = new TurnAccumulator({ piSessionId: threadId });\n   113\t    const userEvents = mapMessage(makeUserMessage(\"first\"), {\n   114\t      piSessionId: threadId,\n   115\t      entryId: \"entry-user-1\",\n   116\t    });\n   117\t    acc.onMessage(userEvents);\n   118\t    const turnEnd = acc.onAgentEnd();\n   119\t    const replay = await capture([...userEvents, ...turnEnd], instance);\n   120\t    expect(replay.ok).toBe(true);\n   121\t    if (replay.ok) {\n   122\t      expect(replay.value.events).toEqual([\n   123\t        {\n   124\t          idempotencyKey: userEvents[0]!.idempotencyKey,\n   125\t          outcome: \"skipped\",\n   126\t          skipReason: \"duplicate_idempotency_key\",\n   127\t        },\n   128\t        {\n   129\t          idempotencyKey: turnEnd[0]!.idempotencyKey,\n   130\t          outcome: \"skipped\",\n   131\t          skipReason: \"duplicate_idempotency_key\",\n   132\t        },\n   133\t      ]);\n   134\t    }\n   135\t    await instance.dispose();\n   136\t  });\n   137\t\n   138\t  it(\"(3) normal resume records new messages and does not duplicate the prior session's history\", async () => {\n   139\t    // Session A: one complete turn.\n   140\t    const a = await startCapture(store);\n   141\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n   142\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer one\" })));\n   143\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   144\t    const threadId = threadIdOf(a.threadRef);\n   145\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n   146\t\n   147\t    // Resume: PI does not re-fire history, so the connector sees only the new\n   148\t    // turn — which must record, leaving the prior turn intact and un-duplicated.\n   149\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n   150\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second\")));\n   151\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer two\" })));\n   152\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   153\t\n   154\t    const events = await eventsAfterShutdown(b);\n   155\t    expect(kindsOf(events)).toEqual([\n   156\t      \"user_prompt\",\n   157\t      \"assistant_text\",\n   158\t      \"turn_end\",\n   159\t      \"user_prompt\",\n   160\t      \"assistant_text\",\n   161\t      \"turn_end\",\n   162\t    ]);\n   163\t    expect(userTexts(events)).toEqual([\"first\", \"second\"]);\n   164\t    // Two distinct closed turns — the turn_end keys did not collide either.\n   165\t    const counts = await turnCounts(b.threadRef);\n   166\t    expect(counts.closed).toBe(2);\n   167\t    expect(counts.open).toBe(0);\n   168\t  });\n   169\t\n   170\t  it(\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\", async () => {\n   171\t    const thread = await makeTempThread(store);\n   172\t    const built = await initInstance(thread.threadRef, {\n   173\t      provider: createDeterministicProvider(),\n   174\t      mode: \"background\",\n   175\t    });\n   176\t    expect(built.ok).toBe(true);\n   177\t    if (!built.ok) return;\n   178\t    const instance = built.value;\n   179\t\n   180\t    // Build one turn's events with stable keys, then deliver the SAME batch\n   181\t    // twice — the second delivery (the reload / crash-replay shape) must dedup.\n   182\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   183\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n   184\t    acc.onMessage(userEvents);\n   185\t    const batch = [...userEvents, ...acc.onAgentEnd()];\n   186\t\n   187\t    const first = await capture(batch, instance);\n   188\t    expect(first.ok).toBe(true);\n   189\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   190\t\n   191\t    const second = await capture(batch, instance);\n   192\t    expect(second.ok).toBe(true);\n   193\t    if (second.ok) expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   194\t\n   195\t    const read = await intakeStream.listEvents(instance.threadRef);\n   196\t    expect(read.ok).toBe(true);\n   197\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   198\t\n   199\t    await instance.dispose();\n   200\t  });\n   201\t\n   202\t  it(\"(5) records two distinct same-content user prompts when PI provides distinct entry ids\", async () => {\n   203\t    const started = await startCapture(store);\n   204\t\n   205\t    await started.connector.handlers.message_end(\n   206\t      started.ctx,\n   207\t      makeMessageEnd(makeUserMessage(\"repeatable prompt\"), \"entry-repeat-1\"),\n   208\t    );\n   209\t    await started.connector.handlers.agent_end(started.ctx, makeAgentEnd([]));\n   210\t    await started.connector.handlers.message_end(\n   211\t      started.ctx,\n   212\t      makeMessageEnd(makeUserMessage(\"repeatable prompt\"), \"entry-repeat-2\"),\n   213\t    );\n   214\t    await started.connector.handlers.agent_end(started.ctx, makeAgentEnd([]));\n   215\t\n   216\t    const events = await eventsAfterShutdown(started);\n   217\t    expect(userTexts(events)).toEqual([\"repeatable prompt\", \"repeatable prompt\"]);\n   218\t    expect(events.filter((event) => event.eventKind === \"user_prompt\").map((event) => event.idempotencyKey)).toEqual([\n   219\t      expect.stringContaining(\"entry-repeat-1\"),\n   220\t      expect.stringContaining(\"entry-repeat-2\"),\n   221\t    ]);\n   222\t    const counts = await turnCounts(started.threadRef);\n   223\t    expect(counts.closed).toBe(2);\n   224\t  });\n   225\t\n   226\t  it(\"(6) skips a same-entry re-delivery after reload by duplicate_idempotency_key\", async () => {\n   227\t    const a = await startCapture(store);\n   228\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"reload replay\"), \"entry-replay-1\"));\n   229\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   230\t    const threadId = threadIdOf(a.threadRef);\n   231\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n   232\t\n   233\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n   234\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"reload replay\"), \"entry-replay-1\"));\n   235\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   236\t\n   237\t    const events = await eventsAfterShutdown(b);\n   238\t    expect(userTexts(events)).toEqual([\"reload replay\"]);\n   239\t\n   240\t    const built = await initInstance(b.threadRef, {\n   241\t      provider: createDeterministicProvider(),\n   242\t      mode: \"background\",\n   243\t    });\n   244\t    expect(built.ok).toBe(true);\n   245\t    if (!built.ok) return;\n   246\t    const instance = built.value;\n   247\t    const acc = new TurnAccumulator({ piSessionId: threadId });\n   248\t    const userEvents = mapMessage(makeUserMessage(\"reload replay\"), {\n   249\t      piSessionId: threadId,\n   250\t      entryId: \"entry-replay-1\",\n   251\t    });\n   252\t    acc.onMessage(userEvents);\n   253\t    const turnEnd = acc.onAgentEnd();\n   254\t    const replay = await capture([...userEvents, ...turnEnd], instance);\n   255\t    expect(replay.ok).toBe(true);\n   256\t    if (replay.ok) {\n   257\t      expect(replay.value.events.every((entry) => entry.skipReason === \"duplicate_idempotency_key\")).toBe(true);\n   258\t    }\n   259\t    await instance.dispose();\n   260\t  });\n   261\t\n   262\t  it(\"(7) records distinct same-content no-entry prompts by PI source position, and skips reload re-delivery of the same position\", async () => {\n   263\t    const a = await startCapture(store);\n   264\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"same text\"), undefined, 40));\n   265\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   266\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"same text\"), undefined, 41));\n   267\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   268\t    const threadId = threadIdOf(a.threadRef);\n   269\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n   270\t\n   271\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n   272\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"same text\"), undefined, 40));\n   273\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   274\t\n   275\t    const events = await eventsAfterShutdown(b);\n   276\t    expect(userTexts(events)).toEqual([\"same text\", \"same text\"]);\n   277\t    const promptKeys = events\n   278\t      .filter((event) => event.eventKind === \"user_prompt\")\n   279\t      .map((event) => event.idempotencyKey);\n   280\t    expect(promptKeys).toHaveLength(2);\n   281\t    expect(promptKeys[0]).toContain(\"message_end:40\");\n   282\t    expect(promptKeys[1]).toContain(\"message_end:41\");\n   283\t    expect(promptKeys[0]).not.toBe(promptKeys[1]);\n   284\t  });\n   285\t});\n","exit_code":0,"status":"completed"}}

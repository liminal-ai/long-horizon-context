{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/internal/validate.ts | sed -n '1,210p'\"","aggregated_output":"     1\t// Flow 4: pure, whole-batch, three-layer closed validation. Strictness falls\n     2\t// out of schema construction: every layer is a closed Effect Schema struct\n     3\t// decoded under onExcessProperty: \"error\", so unknown-field rejection is a\n     4\t// property of the definitions, not a remembered rule. Validation never touches\n     5\t// a database; a rejected batch costs no write lock.\n     6\timport { Either, ParseResult, Schema } from \"effect\";\n     7\timport type { ErrorResult } from \"../../../shared/errors.js\";\n     8\t\n     9\texport const EVENT_KINDS = [\n    10\t  \"user_prompt\",\n    11\t  \"assistant_text\",\n    12\t  \"assistant_thinking\",\n    13\t  \"runtime_note\",\n    14\t  \"tool_call\",\n    15\t  \"tool_result\",\n    16\t  \"turn_end\",\n    17\t] as const;\n    18\t\n    19\t// Denied by name with their own reason string: the old MVP's\n    20\t// silent-root-field-drop bug class gets named when it appears.\n    21\tconst SERVER_GENERATED_FIELDS = [\n    22\t  \"eventOrder\",\n    23\t  \"recordedAt\",\n    24\t  \"threadEventId\",\n    25\t  \"schemaVersion\",\n    26\t] as const;\n    27\t\n    28\tconst DECODE_OPTIONS = { onExcessProperty: \"error\", errors: \"first\" } as const;\n    29\t\n    30\tconst NonEmptyString = Schema.String.pipe(Schema.minLength(1));\n    31\t\n    32\t// Layer 1 — envelope: thread reference shape, closed.\n    33\tconst ThreadRefSchema = Schema.Union(\n    34\t  Schema.Struct({\n    35\t    threadId: NonEmptyString,\n    36\t    registryPath: Schema.optional(Schema.String),\n    37\t  }),\n    38\t  Schema.Struct({ filePath: NonEmptyString }),\n    39\t);\n    40\t\n    41\t// Layer 2 — event object: the five required fields, closed. payload presence\n    42\t// and shape are layer 3's job (Schema.Unknown keeps the key from reading as\n    43\t// an unexpected field here, and tolerates a missing key — presence is checked\n    44\t// explicitly below).\n    45\tconst EventEnvelopeSchema = Schema.Struct({\n    46\t  eventKind: Schema.Literal(...EVENT_KINDS),\n    47\t  idempotencyKey: NonEmptyString,\n    48\t  actor: NonEmptyString,\n    49\t  harness: NonEmptyString,\n    50\t  payload: Schema.Unknown,\n    51\t});\n    52\t\n    53\t// Layer 3 — per-kind payload, closed. turn_end's empty-payload rule is its\n    54\t// own named check below (a closed Struct({}) admits any object).\n    55\tconst TextPayloadSchema = Schema.Struct({ text: Schema.String });\n    56\tconst ToolCallPayloadSchema = Schema.Struct({\n    57\t  toolCallId: NonEmptyString,\n    58\t  toolName: NonEmptyString,\n    59\t  arguments: Schema.Record({ key: Schema.String, value: Schema.Unknown }),\n    60\t});\n    61\tconst ToolResultPayloadSchema = Schema.Struct({\n    62\t  toolCallId: NonEmptyString,\n    63\t  content: Schema.String,\n    64\t  isError: Schema.optional(Schema.Boolean),\n    65\t});\n    66\t\n    67\tfunction firstIssue(error: ParseResult.ParseError): string {\n    68\t  const issues = ParseResult.ArrayFormatter.formatErrorSync(error);\n    69\t  const issue = issues[0];\n    70\t  if (issue === undefined) return \"invalid value\";\n    71\t  if (issue.path.length === 0) return issue.message;\n    72\t  return `\"${issue.path.join(\".\")}\" ${issue.message}`;\n    73\t}\n    74\t\n    75\tfunction decodeIssue<A, I>(schema: Schema.Schema<A, I, never>, value: unknown): string | undefined {\n    76\t  const decoded = Schema.decodeUnknownEither(schema, DECODE_OPTIONS)(value);\n    77\t  return Either.isLeft(decoded) ? firstIssue(decoded.left) : undefined;\n    78\t}\n    79\t\n    80\tfunction callerError(reason: string, eventIndex?: number): ErrorResult {\n    81\t  const error: ErrorResult = {\n    82\t    errorClass: \"caller_error\",\n    83\t    code: \"invalid_event\",\n    84\t    reason,\n    85\t  };\n    86\t  if (eventIndex !== undefined) error.eventIndex = eventIndex;\n    87\t  return error;\n    88\t}\n    89\t\n    90\t// Envelope-level: the thread reference must decode against the closed union.\n    91\t// Returns undefined when valid.\n    92\texport function validateThreadRef(ref: unknown): ErrorResult | undefined {\n    93\t  const issue = decodeIssue(ThreadRefSchema, ref);\n    94\t  if (issue !== undefined) {\n    95\t    return callerError(`envelope: invalid thread reference — ${issue}`);\n    96\t  }\n    97\t  return undefined;\n    98\t}\n    99\t\n   100\t// Whole-batch validation: array order, first failure wins (AC-4.5). Returns\n   101\t// undefined when every event is valid.\n   102\texport function validateEvents(events: unknown): ErrorResult | undefined {\n   103\t  if (!Array.isArray(events)) {\n   104\t    return callerError(\"envelope: events must be a JSON array\");\n   105\t  }\n   106\t  if (events.length === 0) {\n   107\t    return {\n   108\t      errorClass: \"caller_error\",\n   109\t      code: \"empty_batch\",\n   110\t      reason: \"envelope: events array is empty; a batch must carry at least one event\",\n   111\t    };\n   112\t  }\n   113\t  for (const [index, event] of events.entries()) {\n   114\t    const failure = validateOneEvent(event, index);\n   115\t    if (failure !== undefined) return failure;\n   116\t  }\n   117\t  return undefined;\n   118\t}\n   119\t\n   120\tfunction validateOneEvent(event: unknown, index: number): ErrorResult | undefined {\n   121\t  if (typeof event !== \"object\" || event === null || Array.isArray(event)) {\n   122\t    return callerError(\"event: each event must be a JSON object\", index);\n   123\t  }\n   124\t  const record = event as Record<string, unknown>;\n   125\t\n   126\t  for (const field of SERVER_GENERATED_FIELDS) {\n   127\t    if (field in record) {\n   128\t      return callerError(\n   129\t        `event: server-generated field \"${field}\" must not be supplied by the caller`,\n   130\t        index,\n   131\t      );\n   132\t    }\n   133\t  }\n   134\t\n   135\t  const kind = record[\"eventKind\"];\n   136\t  if (typeof kind === \"string\" && !(EVENT_KINDS as readonly string[]).includes(kind)) {\n   137\t    return callerError(`event: unknown event kind \"${kind}\"`, index);\n   138\t  }\n   139\t\n   140\t  const envelope = Schema.decodeUnknownEither(EventEnvelopeSchema, DECODE_OPTIONS)(event);\n   141\t  if (Either.isLeft(envelope)) {\n   142\t    return callerError(`event: ${firstIssue(envelope.left)}`, index);\n   143\t  }\n   144\t\n   145\t  const payload = record[\"payload\"];\n   146\t  if (typeof payload !== \"object\" || payload === null || Array.isArray(payload)) {\n   147\t    return callerError(\"event: payload must be a JSON object\", index);\n   148\t  }\n   149\t\n   150\t  if (envelope.right.eventKind === \"turn_end\") {\n   151\t    const extraKeys = Object.keys(payload);\n   152\t    if (extraKeys.length > 0) {\n   153\t      return callerError(\n   154\t        `payload: turn_end events carry an empty payload; found field \"${extraKeys[0]}\"`,\n   155\t        index,\n   156\t      );\n   157\t    }\n   158\t    return undefined;\n   159\t  }\n   160\t\n   161\t  let issue: string | undefined;\n   162\t  switch (envelope.right.eventKind) {\n   163\t    case \"tool_call\":\n   164\t      issue = decodeIssue(ToolCallPayloadSchema, payload);\n   165\t      break;\n   166\t    case \"tool_result\":\n   167\t      issue = decodeIssue(ToolResultPayloadSchema, payload);\n   168\t      break;\n   169\t    default:\n   170\t      issue = decodeIssue(TextPayloadSchema, payload);\n   171\t      break;\n   172\t  }\n   173\t  if (issue !== undefined) {\n   174\t    return callerError(`payload: ${issue}`, index);\n   175\t  }\n   176\t  return undefined;\n   177\t}\n","exit_code":0,"status":"completed"}}

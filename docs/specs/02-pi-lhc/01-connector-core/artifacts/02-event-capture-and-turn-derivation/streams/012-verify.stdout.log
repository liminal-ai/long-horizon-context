{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/converter.ts'","aggregated_output":"     1\timport type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\n     2\timport type { LhcInstance } from \"../shared/instance.js\";\n     3\timport { fingerprint } from \"./idempotency.js\";\n     4\t\n     5\t// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\n     6\t// isolating capture failure so it never throws back into a PI hook. The two\n     7\t// failure shapes the AC distinguishes key off the SDK's error code:\n     8\t//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\n     9\t//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\n    10\t//     dropped, then surface the original failure so the caller marks the gap.\n    11\t//   - anything else (thread store unavailable): no durable gap is possible —\n    12\t//     surface the failure for the caller to route to an extension health\n    13\t//     signal. Either way the session continues.\n    14\t//\n    15\t// The map → accumulate orchestration runs in the composition root (index.ts),\n    16\t// which routes this function's structured result into SessionState.health;\n    17\t// capture itself stays boundary-pure (lhc + shared only).\n    18\t\n    19\tfunction detail(cause: unknown): string {\n    20\t  return cause instanceof Error ? cause.message : String(cause);\n    21\t}\n    22\t\n    23\t/** messageEvents returns OpResults for operational failures, but a thread file\n    24\t *  in a genuinely broken state could still throw — contain that too, so capture\n    25\t *  is total. */\n    26\tasync function flushIsolated(\n    27\t  instance: LhcInstance,\n    28\t  events: readonly MessageEventInput[],\n    29\t): Promise<OpResult<BatchResult>> {\n    30\t  try {\n    31\t    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\n    32\t  } catch (cause) {\n    33\t    return {\n    34\t      ok: false,\n    35\t      error: {\n    36\t        errorClass: \"system_error\",\n    37\t        code: \"storage_failure\",\n    38\t        reason: `capture flush threw: ${detail(cause)}`,\n    39\t      },\n    40\t    };\n    41\t  }\n    42\t}\n    43\t\n    44\t/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\n    45\t *  rides an existing intake kind (no new kind) and surfaces in the event log.\n    46\t *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\n    47\t *  bad batch dedups the gap rather than piling up duplicates. */\n    48\tfunction gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\n    49\t  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\n    50\t  return {\n    51\t    eventKind: \"runtime_note\",\n    52\t    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\n    53\t    actor: \"system\",\n    54\t    harness: \"pi\",\n    55\t    payload: { text },\n    56\t  };\n    57\t}\n    58\t\n    59\tfunction syntheticGapNote(discriminator: string, reason: string): MessageEventInput {\n    60\t  const text = `capture gap: unmappable PI hook input rejected — ${reason}`;\n    61\t  return {\n    62\t    eventKind: \"runtime_note\",\n    63\t    idempotencyKey: `pi-lhc:gap:${fingerprint(discriminator, reason)}`,\n    64\t    actor: \"system\",\n    65\t    harness: \"pi\",\n    66\t    payload: { text },\n    67\t  };\n    68\t}\n    69\t\n    70\texport async function capture(\n    71\t  events: MessageEventInput[],\n    72\t  instance: LhcInstance,\n    73\t): Promise<OpResult<BatchResult>> {\n    74\t  const primary = await flushIsolated(instance, events);\n    75\t  if (primary.ok) return primary;\n    76\t\n    77\t  if (primary.error.code === \"invalid_event\") {\n    78\t    // Writable thread, malformed event: never drop — record a durable gap.\n    79\t    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\n    80\t    // If the gap write itself fails, the store went unavailable: surface that\n    81\t    // (no durable gap was recorded) so the caller routes it to health.\n    82\t    if (!gap.ok) return gap;\n    83\t    return primary;\n    84\t  }\n    85\t\n    86\t  // Store unavailable / other: no durable gap is possible.\n    87\t  return primary;\n    88\t}\n    89\t\n    90\texport async function captureGap(\n    91\t  discriminator: string,\n    92\t  reason: string,\n    93\t  instance: LhcInstance,\n    94\t): Promise<OpResult<BatchResult>> {\n    95\t  return flushIsolated(instance, [syntheticGapNote(discriminator, reason)]);\n    96\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type {\n    11\t  BatchResult,\n    12\t  DerivationProvider,\n    13\t  MessageEventInput,\n    14\t  OpResult,\n    15\t  ProviderResult,\n    16\t  SdkConfig,\n    17\t  ThreadRef,\n    18\t} from \"lhc\";\n    19\timport type {\n    20\t  ExtensionAPI,\n    21\t  ExtensionContext,\n    22\t  PiHookHandler,\n    23\t  PiHookName,\n    24\t} from \"./pi/types.js\";\n    25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    26\timport { createSessionState } from \"./lifecycle/state.js\";\n    27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    28\timport {\n    29\t  parseLaunchFlags,\n    30\t  resolveReloadThread,\n    31\t  resolveThread,\n    32\t  type LaunchFlags,\n    33\t  type ResolveDeps,\n    34\t} from \"./lifecycle/thread-resolution.js\";\n    35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    36\timport { capture, captureGap } from \"./capture/converter.js\";\n    37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n    38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n    39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n    40\timport type { LhcInstance } from \"./shared/instance.js\";\n    41\t\n    42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    43\texport type { LhcInstance } from \"./shared/instance.js\";\n    44\t\n    45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    47\t *  registers no handler for it (story Scope Out). */\n    48\texport const EPIC_1_HOOKS = [\n    49\t  \"session_start\",\n    50\t  \"message_end\",\n    51\t  \"turn_end\",\n    52\t  \"agent_end\",\n    53\t  \"model_select\",\n    54\t  \"thinking_level_select\",\n    55\t  \"session_before_fork\",\n    56\t  \"session_before_switch\",\n    57\t  \"session_shutdown\",\n    58\t] as const satisfies readonly PiHookName[];\n    59\t\n    60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    61\t\n    62\t/** What the connector needs from the host to run a session. Every dependency\n    63\t *  has a working production default; the overrides exist for test isolation\n    64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n    65\t *  in the PI-auth-backed inference config.\n    66\t *\n    67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n    68\t *  default is the observe-only config below (a real, construction-valid SDK);\n    69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n    70\texport interface ConnectorDeps {\n    71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    72\t  registryPath?: string;\n    73\t  newThreadFilePath?: () => string;\n    74\t  parseLaunch?: () => LaunchFlags;\n    75\t  selectThread?: (\n    76\t    choices: readonly ThreadChoice[],\n    77\t    ctx: ExtensionContext,\n    78\t  ) => Promise<string | null>;\n    79\t}\n    80\t\n    81\t/** Everything the connector retains across hooks as PLAIN data — by\n    82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    84\t *  deliberately not part of the snapshot. */\n    85\texport interface ConnectorSnapshot {\n    86\t  state: SessionState | null;\n    87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    88\t}\n    89\t\n    90\texport interface Connector {\n    91\t  /** Register the observe-only hook rail on the PI extension API. */\n    92\t  register(pi: ExtensionAPI): void;\n    93\t  /** The plain-data state retained across hooks. `null` until a session\n    94\t   *  resolves a thread; never holds a PI ctx. */\n    95\t  getState(): SessionState | null;\n    96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n    97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n    98\t  getInstance(): LhcInstance | null;\n    99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n   100\t  snapshot(): ConnectorSnapshot;\n   101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   102\t   *  synthetic ctx/events without a live PI. */\n   103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n   104\t}\n   105\t\n   106\t/** The connector's live capture state for one session: the open-turn\n   107\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n   108\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n   109\t *  per session, never part of the plain-data snapshot and never a PI object. */\n   110\tinterface CaptureSession {\n   111\t  piSessionId: string;\n   112\t  accumulator: TurnAccumulator;\n   113\t}\n   114\t\n   115\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n   116\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   117\t *  same id). */\n   118\tfunction sessionIdOf(ref: ThreadRef): string {\n   119\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   120\t}\n   121\t\n   122\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   123\t\n   124\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n   125\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n   126\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n   127\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n   128\t *  derivation work is ever queued and this provider is never invoked — it exists\n   129\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n   130\t *\n   131\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n   132\t *  documents as \"selectable only by explicit name — never a production default\"\n   133\t *  (it would mark fake derived text into the thread). Failing closed preserves\n   134\t *  the observe-only guarantee even if a future change queued work before Stories\n   135\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n   136\t *  assignments), which is what a real *completing* inference requires (the\n   137\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n   138\tfunction observeOnlyProvider(): DerivationProvider {\n   139\t  const notConfigured = (): Promise<ProviderResult> =>\n   140\t    Promise.resolve({\n   141\t      ok: false,\n   142\t      retryable: false,\n   143\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n   144\t    });\n   145\t  return {\n   146\t    smoothPrompt: notConfigured,\n   147\t    summarizeToolCall: notConfigured,\n   148\t    summarizeToolResult: notConfigured,\n   149\t    composeTurnRendering: notConfigured,\n   150\t    projectLowerBand: notConfigured,\n   151\t    summarizeChunkDetailed: notConfigured,\n   152\t    summarizeChunkBrief: notConfigured,\n   153\t  };\n   154\t}\n   155\t\n   156\t/** The production observe-only SDK config: a real, construction-valid instance\n   157\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n   158\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n   159\t *  config. */\n   160\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n   161\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n   162\t}\n   163\t\n   164\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   165\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   166\t *  show. */\n   167\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   168\t  const lines = choices.map((choice, i) => {\n   169\t    const title = choice.title ?? \"(untitled)\";\n   170\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   171\t  });\n   172\t  return [\n   173\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n   174\t    ...lines,\n   175\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n   176\t  ].join(\"\\n\");\n   177\t}\n   178\t\n   179\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n   180\t *  interactive input/selection surface (wiring research), so the production\n   181\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n   182\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n   183\t *  most recently created thread as the best available explicit default. The\n   184\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n   185\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n   186\t *  A true interactive picker awaits a PI input surface; until then resuming a\n   187\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n   188\t *  precise spec deviation. */\n   189\tfunction defaultSelectThread(\n   190\t  choices: readonly ThreadChoice[],\n   191\t  ctx: ExtensionContext,\n   192\t): Promise<string | null> {\n   193\t  const mostRecent = choices.at(-1);\n   194\t  if (mostRecent === undefined) return Promise.resolve(null);\n   195\t  if (ctx.hasUI) {\n   196\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   197\t  }\n   198\t  return Promise.resolve(mostRecent.threadId);\n   199\t}\n   200\t\n   201\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   202\t *  generated by the registry at creation, so the file name is just a unique\n   203\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   204\t *  parents). */\n   205\tfunction defaultNewThreadFilePath(): string {\n   206\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   207\t  mkdirSync(dir, { recursive: true });\n   208\t  return join(dir, `${randomUUID()}.sqlite`);\n   209\t}\n   210\t\n   211\t/** Build a connector instance. Its mutable state lives in this closure; the\n   212\t *  registered handlers capture it, so the instance stays live for the session\n   213\t *  even when `activate` discards the returned object. The connector holds NO\n   214\t *  module-level or durable state of its own — reload reconstructs the thread from\n   215\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n   216\t *  closure reattaches correctly (AC-1.5). */\n   217\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   218\t  // The connector's retained state. `state` is plain data (the durable thread\n   219\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   220\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n   221\t  // none survives the connector — reload re-resolves from the registry.\n   222\t  let state: SessionState | null = null;\n   223\t  let instance: LhcInstance | null = null;\n   224\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   225\t  let captureSession: CaptureSession | null = null;\n   226\t\n   227\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n   228\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   229\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   230\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n   231\t\n   232\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   233\t    return { code, message, recordedGap: false };\n   234\t  }\n   235\t\n   236\t  // The registry/file deps every resolver path shares. `registryPath` is set\n   237\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n   238\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n   239\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n   240\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n   241\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   242\t    return resolveDeps;\n   243\t  }\n   244\t\n   245\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n   246\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n   247\t  // no-flag creates).\n   248\t  async function resolveForLaunch(\n   249\t    launch: LaunchFlags,\n   250\t    ctx: ExtensionContext,\n   251\t  ): Promise<OpResult<ThreadRef | null>> {\n   252\t    if (launch.resume === true) {\n   253\t      const pickerDeps: {\n   254\t        registryPath?: string;\n   255\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n   256\t      } = { select: (choices) => selectThread(choices, ctx) };\n   257\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n   258\t      return pickThread(ctx.cwd, pickerDeps);\n   259\t    }\n   260\t    return resolveThread(launch, buildResolveDeps(ctx));\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '261,540p'\"","aggregated_output":"   261\t  }\n   262\t\n   263\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n   264\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n   265\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n   266\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n   267\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n   268\t  async function resolveReloadFor(\n   269\t    launch: LaunchFlags,\n   270\t    ctx: ExtensionContext,\n   271\t  ): Promise<OpResult<ThreadRef | null>> {\n   272\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n   273\t  }\n   274\t\n   275\t  // session_start: resolve the recording thread and construct one background\n   276\t  // instance against it. Config is gated first so a session with no usable\n   277\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n   278\t  // thread is re-resolved from the durable registry (reattach, never create);\n   279\t  // every other reason runs the normal launch resolution.\n   280\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   281\t    const config = buildSdkConfig(ctx);\n   282\t    if (!config.ok) {\n   283\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   284\t      return;\n   285\t    }\n   286\t    const launch = parseLaunch();\n   287\t    const isReload = event.reason === \"reload\";\n   288\t    const resolved = isReload\n   289\t      ? await resolveReloadFor(launch, ctx)\n   290\t      : await resolveForLaunch(launch, ctx);\n   291\t    if (!resolved.ok) {\n   292\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   293\t      return;\n   294\t    }\n   295\t    if (resolved.value === null) {\n   296\t      lastDiagnostic = isReload\n   297\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n   298\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   299\t      return;\n   300\t    }\n   301\t    const built = await initInstance(resolved.value, config.value);\n   302\t    if (!built.ok) {\n   303\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   304\t      return;\n   305\t    }\n   306\t    instance = built.value;\n   307\t    state = createSessionState(resolved.value);\n   308\t    const piSessionId = sessionIdOf(resolved.value);\n   309\t    captureSession = {\n   310\t      piSessionId,\n   311\t      accumulator: new TurnAccumulator({ piSessionId }),\n   312\t    };\n   313\t  };\n   314\t\n   315\t  // Dispose with flush before any session swap (session_before_switch fires\n   316\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   317\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n   318\t  // re-resolves its thread from the durable registry on the next session_start.\n   319\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   320\t    const result = await disposeInstance(instance);\n   321\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   322\t    instance = null;\n   323\t    captureSession = null;\n   324\t  };\n   325\t\n   326\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n   327\t  // converter already recorded a durable gap for a writable-thread malformed\n   328\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n   329\t  // surfaces as an extension health signal with no gap. Neither path throws.\n   330\t  function recordCaptureOutcome(\n   331\t    result: OpResult<BatchResult>,\n   332\t    events: readonly MessageEventInput[],\n   333\t  ): void {\n   334\t    if (result.ok) return;\n   335\t    const recordedGap = result.error.code === \"invalid_event\";\n   336\t    const failure: CaptureFailureDiagnostic = {\n   337\t      code: result.error.code,\n   338\t      message: result.error.reason,\n   339\t      recordedGap,\n   340\t    };\n   341\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n   342\t    lastDiagnostic = failure;\n   343\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   344\t  }\n   345\t\n   346\t  function fallbackIdFor(kind: string, position: number | undefined): string | undefined {\n   347\t    return position !== undefined ? `${kind}:${position}` : undefined;\n   348\t  }\n   349\t\n   350\t  async function recordMappingFailure(\n   351\t    hook: string,\n   352\t    position: number | undefined,\n   353\t    cause: unknown,\n   354\t  ): Promise<void> {\n   355\t    if (instance === null) return;\n   356\t    const message = cause instanceof Error ? cause.message : String(cause);\n   357\t    const result = await captureGap(\n   358\t      fallbackIdFor(hook, position) ?? `${hook}:no-source-position`,\n   359\t      `${hook}: ${message}`,\n   360\t      instance,\n   361\t    );\n   362\t    if (!result.ok) {\n   363\t      recordCaptureOutcome(result, []);\n   364\t      return;\n   365\t    }\n   366\t    const failure: CaptureFailureDiagnostic = {\n   367\t      code: \"invalid_event\",\n   368\t      message: `${hook}: ${message}`,\n   369\t      recordedGap: true,\n   370\t    };\n   371\t    lastDiagnostic = failure;\n   372\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   373\t  }\n   374\t\n   375\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   376\t  // open turn, and flush through the converter (AC-2.1).\n   377\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   378\t    if (instance === null || captureSession === null) return;\n   379\t    const mapCtx: MapCtx =\n   380\t      event.entryId !== undefined && event.entryId !== \"\"\n   381\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n   382\t        : {\n   383\t            piSessionId: captureSession.piSessionId,\n   384\t            fallbackId: fallbackIdFor(\"message_end\", event.position),\n   385\t          };\n   386\t    let events: MessageEventInput[];\n   387\t    try {\n   388\t      events = mapMessage(event.message, mapCtx);\n   389\t    } catch (cause) {\n   390\t      await recordMappingFailure(\"message_end\", event.position, cause);\n   391\t      return;\n   392\t    }\n   393\t    captureSession.accumulator.onMessage(events);\n   394\t    if (events.length === 0) return;\n   395\t    recordCaptureOutcome(await capture(events, instance), events);\n   396\t  };\n   397\t\n   398\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   399\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   400\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   401\t    if (instance === null || captureSession === null) return;\n   402\t    const mapCtx: MapCtx = {\n   403\t      piSessionId: captureSession.piSessionId,\n   404\t      fallbackId: fallbackIdFor(\"model_select\", event.position),\n   405\t    };\n   406\t    const note = mapModelSelect(event, mapCtx);\n   407\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   408\t  };\n   409\t\n   410\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   411\t    if (instance === null || captureSession === null) return;\n   412\t    const mapCtx: MapCtx = {\n   413\t      piSessionId: captureSession.piSessionId,\n   414\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position),\n   415\t    };\n   416\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   417\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   418\t  };\n   419\t\n   420\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   421\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   422\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   423\t    if (instance === null || captureSession === null) return;\n   424\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   425\t    if (turnEnd.length === 0) return;\n   426\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   427\t  };\n   428\t\n   429\t  // Contain every handler: an observe-only hook must never throw back into PI\n   430\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   431\t  // plain-data diagnostic; it is never rethrown.\n   432\t  const guard = (\n   433\t    name: Epic1Hook,\n   434\t    body: PiHookHandler<Epic1Hook>,\n   435\t  ): PiHookHandler<Epic1Hook> => {\n   436\t    return async (ctx, event): Promise<void> => {\n   437\t      try {\n   438\t        await body(ctx, event);\n   439\t      } catch (err) {\n   440\t        lastDiagnostic = {\n   441\t          code: \"hook_handler_error\",\n   442\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   443\t          recordedGap: false,\n   444\t        };\n   445\t      }\n   446\t    };\n   447\t  };\n   448\t\n   449\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   450\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n   451\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n   452\t  // FRESH ctx and retains none of it.\n   453\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   454\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n   455\t  };\n   456\t\n   457\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   458\t  // are live; PI per-step turn_end and fork remain no-ops.\n   459\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   460\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   461\t    session_before_switch: onDispose,\n   462\t    session_shutdown: onDispose,\n   463\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   464\t    turn_end: noop,\n   465\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   466\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   467\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   468\t    session_before_fork: noop,\n   469\t  };\n   470\t\n   471\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   472\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   473\t\n   474\t  return {\n   475\t    handlers,\n   476\t    register(pi: ExtensionAPI): void {\n   477\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   478\t    },\n   479\t    getState(): SessionState | null {\n   480\t      return state;\n   481\t    },\n   482\t    getInstance(): LhcInstance | null {\n   483\t      return instance;\n   484\t    },\n   485\t    snapshot(): ConnectorSnapshot {\n   486\t      return { state, lastDiagnostic };\n   487\t    },\n   488\t  };\n   489\t}\n   490\t\n   491\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   492\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n   493\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n   494\t *  observe-only SDK config, and the `--resume` selector that presents the\n   495\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n   496\t *  resolves/creates and initializes for real. On `/reload` the connector\n   497\t *  re-resolves the same thread from the durable registry (it keeps no\n   498\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n   499\t *  config. */\n   500\texport function activate(pi: ExtensionAPI): void {\n   501\t  createConnector().register(pi);\n   502\t}\n   503\t\n   504\texport default activate;\n","exit_code":0,"status":"completed"}}

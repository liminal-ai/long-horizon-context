{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/idempotency.test.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\n     2\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n     3\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n     4\t// must add nothing the second time. The key goldens pin construction precedence:\n     5\t// PI entry id → provider response / tool-call id → content fingerprint, with\n     6\t// blockIndex and kind disambiguating one message's fan-out.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\n     9\timport { capture } from \"../../src/capture/converter.js\";\n    10\timport { eventKey } from \"../../src/capture/idempotency.js\";\n    11\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    12\timport { mapModelSelect } from \"../../src/capture/runtime-changes.js\";\n    13\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    14\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    15\timport type { AgentMessage } from \"../../src/pi/types.js\";\n    16\timport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\n    17\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    18\t\n    19\tlet store: TempStore;\n    20\tbeforeEach(() => {\n    21\t  store = tempStore();\n    22\t});\n    23\tafterEach(() => {\n    24\t  store.cleanup();\n    25\t});\n    26\t\n    27\tdescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n    28\t  it(\"is deterministic: identical input yields an identical key\", () => {\n    29\t    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n    30\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\n    31\t  });\n    32\t\n    33\t  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n    34\t    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n    35\t    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n    36\t    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n    37\t    expect(thinking).toContain(\"e1\");\n    38\t    // Same entry, different block → different key (fan-out stays distinct).\n    39\t    expect(text).not.toBe(thinking);\n    40\t    // Same entry + block, different kind → still distinct.\n    41\t    expect(textSameBlock).not.toBe(thinking);\n    42\t  });\n    43\t\n    44\t  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n    45\t    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n    46\t    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n    47\t    expect(call).toContain(\"call_a\");\n    48\t    expect(result).toContain(\"call_a\");\n    49\t    expect(call).not.toBe(result);\n    50\t  });\n    51\t\n    52\t  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n    53\t    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n    54\t    expect(key).toContain(\"resp_7\");\n    55\t  });\n    56\t\n    57\t  it(\"falls to content plus a stable discriminator as last resort\", () => {\n    58\t    const a = eventKey({ piSessionId: \"s\", fallbackId: \"entry-a\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    59\t    const aAgain = eventKey({ piSessionId: \"s\", fallbackId: \"entry-a\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    60\t    const b = eventKey({ piSessionId: \"s\", fallbackId: \"entry-b\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    61\t    expect(aAgain).toBe(a);\n    62\t    expect(b).not.toBe(a);\n    63\t  });\n    64\t\n    65\t  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n    66\t    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n    67\t    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n    68\t    expect(withBoth).toBe(entryOnly);\n    69\t  });\n    70\t\n    71\t  it(\"uses caller-supplied source position fallback for same-content no-entry messages\", () => {\n    72\t    const first = mapMessage(\n    73\t      { role: \"user\", content: [{ type: \"text\", text: \"repeatable prompt\" }] },\n    74\t      { piSessionId: \"s\", fallbackId: \"message_end:10\" },\n    75\t    );\n    76\t    const firstReload = mapMessage(\n    77\t      { role: \"user\", content: [{ type: \"text\", text: \"repeatable prompt\" }] },\n    78\t      { piSessionId: \"s\", fallbackId: \"message_end:10\" },\n    79\t    );\n    80\t    const second = mapMessage(\n    81\t      { role: \"user\", content: [{ type: \"text\", text: \"repeatable prompt\" }] },\n    82\t      { piSessionId: \"s\", fallbackId: \"message_end:11\" },\n    83\t    );\n    84\t\n    85\t    expect(firstReload[0]!.idempotencyKey).toBe(first[0]!.idempotencyKey);\n    86\t    expect(second[0]!.idempotencyKey).not.toBe(first[0]!.idempotencyKey);\n    87\t  });\n    88\t\n    89\t  it(\"uses caller-supplied source position fallback for repeated identical runtime changes\", () => {\n    90\t    const event = { model: { provider: \"openai\", id: \"gpt-4o\" } };\n    91\t    const first = mapModelSelect(event, { piSessionId: \"s\", fallbackId: \"model_select:20\" });\n    92\t    const firstReload = mapModelSelect(event, { piSessionId: \"s\", fallbackId: \"model_select:20\" });\n    93\t    const second = mapModelSelect(event, { piSessionId: \"s\", fallbackId: \"model_select:21\" });\n    94\t\n    95\t    expect(firstReload.idempotencyKey).toBe(first.idempotencyKey);\n    96\t    expect(second.idempotencyKey).not.toBe(first.idempotencyKey);\n    97\t  });\n    98\t});\n    99\t\n   100\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n   101\t  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n   102\t  const events: MessageEventInput[] = [];\n   103\t  source.forEach((message, index) => {\n   104\t    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n   105\t    acc.onMessage(mapped);\n   106\t    events.push(...mapped);\n   107\t  });\n   108\t  events.push(...acc.onAgentEnd());\n   109\t  return events;\n   110\t}\n   111\t\n   112\tdescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n   113\t  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n   114\t    const thread = await makeTempThread(store);\n   115\t    const built = await initInstance(thread.threadRef, {\n   116\t      provider: createDeterministicProvider(),\n   117\t      mode: \"background\",\n   118\t    });\n   119\t    expect(built.ok).toBe(true);\n   120\t    if (!built.ok) return;\n   121\t    const instance = built.value;\n   122\t\n   123\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n   124\t\n   125\t    const first = await capture(batch, instance);\n   126\t    expect(first.ok).toBe(true);\n   127\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   128\t\n   129\t    const replay = await capture(batch, instance);\n   130\t    expect(replay.ok).toBe(true);\n   131\t    if (replay.ok) {\n   132\t      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   133\t    }\n   134\t\n   135\t    const read = await intakeStream.listEvents(instance.threadRef);\n   136\t    expect(read.ok).toBe(true);\n   137\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   138\t\n   139\t    await instance.dispose();\n   140\t  });\n   141\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/pi/types.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Local declarations of the PI extension surface the connector consumes.\n     2\t//\n     3\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n     4\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n     5\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\n     6\t// build-time dependency of this workspace, so the connector declares the slice\n     7\t// of their contract it touches and swaps to the real imports when the\n     8\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n     9\t// surface here — rather than scattered `any` — means later stories get real\n    10\t// type-checking against the contract PI actually fires.\n    11\t\n    12\t// ── Hook vocabulary ──────────────────────────────────────────────────\n    13\t\n    14\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n    15\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\n    16\t *  serving is Epic 2. */\n    17\texport type PiHookName =\n    18\t  | \"session_start\"\n    19\t  | \"message_end\"\n    20\t  | \"turn_end\"\n    21\t  | \"agent_end\"\n    22\t  | \"model_select\"\n    23\t  | \"thinking_level_select\"\n    24\t  | \"session_before_fork\"\n    25\t  | \"session_before_switch\"\n    26\t  | \"session_shutdown\"\n    27\t  | \"context\";\n    28\t\n    29\texport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\n    30\texport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n    31\t\n    32\texport interface SessionStartEvent {\n    33\t  reason: SessionStartReason;\n    34\t  previousSessionFile?: string;\n    35\t}\n    36\texport interface MessageEndEvent {\n    37\t  entryId?: string;\n    38\t  position?: number;\n    39\t  message: AgentMessage;\n    40\t}\n    41\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n    42\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\n    43\texport interface TurnEndEvent {\n    44\t  turnIndex: number;\n    45\t  message: AgentMessage;\n    46\t  toolResults: ToolResultMessage[];\n    47\t  stopReason?: PiStopReason;\n    48\t}\n    49\texport interface AgentEndEvent {\n    50\t  messages: AgentMessage[];\n    51\t}\n    52\texport interface ModelSelectEvent {\n    53\t  model: ModelDescriptor;\n    54\t  previousModel?: ModelDescriptor;\n    55\t  position?: number;\n    56\t  source?: string;\n    57\t}\n    58\texport interface ThinkingLevelSelectEvent {\n    59\t  level: string;\n    60\t  previousLevel: string;\n    61\t  position?: number;\n    62\t}\n    63\texport interface SessionBeforeForkEvent {\n    64\t  entryId: string;\n    65\t  position?: number;\n    66\t}\n    67\texport interface SessionBeforeSwitchEvent {\n    68\t  intent: \"new\" | \"resume\";\n    69\t}\n    70\texport interface SessionShutdownEvent {\n    71\t  reason: SessionShutdownReason;\n    72\t  targetSessionFile?: string;\n    73\t}\n    74\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\n    75\texport interface ContextEvent {\n    76\t  messages: AgentMessage[];\n    77\t}\n    78\t\n    79\t/** Maps each hook to the payload PI delivers with it. */\n    80\texport interface PiHookEventMap {\n    81\t  session_start: SessionStartEvent;\n    82\t  message_end: MessageEndEvent;\n    83\t  turn_end: TurnEndEvent;\n    84\t  agent_end: AgentEndEvent;\n    85\t  model_select: ModelSelectEvent;\n    86\t  thinking_level_select: ThinkingLevelSelectEvent;\n    87\t  session_before_fork: SessionBeforeForkEvent;\n    88\t  session_before_switch: SessionBeforeSwitchEvent;\n    89\t  session_shutdown: SessionShutdownEvent;\n    90\t  context: ContextEvent;\n    91\t}\n    92\t\n    93\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n    94\t *  connector must never retain it across calls (PI replaces session objects on\n    95\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\n    96\texport type PiHookHandler<N extends PiHookName> = (\n    97\t  ctx: ExtensionContext,\n    98\t  event: PiHookEventMap[N],\n    99\t) => void | Promise<void>;\n   100\t\n   101\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n   102\t\n   103\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n   104\t\n   105\texport interface PiToolSpec {\n   106\t  name: string;\n   107\t  description?: string;\n   108\t  promptSnippet?: string;\n   109\t  promptGuidelines?: string;\n   110\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n   111\t}\n   112\t\n   113\t/** The factory-time API. Hook registration and command/tool registration take\n   114\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n   115\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n   116\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\n   117\texport interface ExtensionAPI {\n   118\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n   119\t  registerCommand(name: string, handler: PiCommandHandler): void;\n   120\t  registerTool(tool: PiToolSpec): void;\n   121\t  appendEntry(customType: string, data: unknown): void;\n   122\t}\n   123\t\n   124\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n   125\t\n   126\texport interface ModelDescriptor {\n   127\t  provider: string;\n   128\t  id: string;\n   129\t}\n   130\t\n   131\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n   132\t *  owns. The connector treats provider/model as opaque routing keys. */\n   133\texport interface ModelHandle extends ModelDescriptor {\n   134\t  readonly [k: string]: unknown;\n   135\t}\n   136\t\n   137\texport interface ModelRegistry {\n   138\t  find(provider: string, model: string): ModelHandle | undefined;\n   139\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\n   140\t  getAvailable(): ModelHandle[];\n   141\t}\n   142\t\n   143\texport interface ExtensionUI {\n   144\t  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n   145\t}\n   146\t\n   147\texport interface SessionEntry {\n   148\t  type: string;\n   149\t  readonly [k: string]: unknown;\n   150\t}\n   151\t\n   152\texport interface SessionManager {\n   153\t  getEntries(): SessionEntry[];\n   154\t}\n   155\t\n   156\texport interface ExtensionContext {\n   157\t  modelRegistry: ModelRegistry;\n   158\t  ui: ExtensionUI;\n   159\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n   160\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n   161\t  hasUI: boolean;\n   162\t  sessionManager: SessionManager;\n   163\t  cwd: string;\n   164\t}\n   165\t\n   166\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n   167\t\n   168\texport interface TextPart {\n   169\t  type: \"text\";\n   170\t  text: string;\n   171\t}\n   172\texport interface ThinkingPart {\n   173\t  type: \"thinking\";\n   174\t  thinking: string;\n   175\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n   176\t   *  Epic 1 (tech design I-3). */\n   177\t  thinkingSignature?: string;\n   178\t}\n   179\texport interface ToolCallPart {\n   180\t  type: \"toolCall\";\n   181\t  /** Composite, stable across tool_execution_start → tool_result → message_end\n   182\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n   183\t  id: string;\n   184\t  name: string;\n   185\t  arguments: Record<string, unknown>;\n   186\t  /** Opaque; captured, not interpreted (tech design I-3). */\n   187\t  thoughtSignature?: string;\n   188\t}\n   189\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n   190\t *  the converter (tech design I-6), never silently dropped. */\n   191\texport interface ImagePart {\n   192\t  type: \"image\";\n   193\t  mimeType?: string;\n   194\t  data?: string;\n   195\t}\n   196\texport interface FileRefPart {\n   197\t  type: \"fileRef\";\n   198\t  path: string;\n   199\t}\n   200\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n   201\t\n   202\texport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n   203\t\n   204\texport interface TokenUsage {\n   205\t  inputTokens?: number;\n   206\t  outputTokens?: number;\n   207\t}\n   208\t\n   209\texport interface UserMessage {\n   210\t  role: \"user\";\n   211\t  content: ContentPart[];\n   212\t}\n   213\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n   214\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\n   215\texport interface AssistantMessage {\n   216\t  role: \"assistant\";\n   217\t  content: ContentPart[];\n   218\t  stopReason?: PiStopReason;\n   219\t  usage?: TokenUsage;\n   220\t}\n   221\texport interface ToolResultMessage {\n   222\t  role: \"toolResult\";\n   223\t  toolCallId: string;\n   224\t  content: ContentPart[];\n   225\t  isError?: boolean;\n   226\t}\n   227\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n","exit_code":0,"status":"completed"}}

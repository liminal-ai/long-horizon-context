{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts | sed -n '280,380p'\"","aggregated_output":"   280\t          sourceRef: item.sourceRef,\n   281\t        })),\n   282\t        threadPosition: { lastEventOrder: lastOrder },\n   283\t      },\n   284\t    };\n   285\t  } catch (cause) {\n   286\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n   287\t    // class-independent. The handle may already be gone (induced failure),\n   288\t    // in which case SQLite has already discarded the uncommitted transaction.\n   289\t    if (inTransaction) {\n   290\t      try {\n   291\t        db.exec(\"ROLLBACK;\");\n   292\t      } catch {\n   293\t        // handle closed mid-walk; the open transaction died with it\n   294\t      }\n   295\t    }\n   296\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n   297\t  } finally {\n   298\t    try {\n   299\t      db.close();\n   300\t    } catch {\n   301\t      // already closed by the induced-failure seam\n   302\t    }\n   303\t  }\n   304\t}\n   305\t\n   306\tinterface RawEventRow {\n   307\t  event_order: number | bigint;\n   308\t  event_kind: string;\n   309\t  idempotency_key: string;\n   310\t  actor: string;\n   311\t  harness: string;\n   312\t  payload: string;\n   313\t  recorded_at: string;\n   314\t}\n   315\t\n   316\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n   317\t  const refFailure = validateThreadRef(thread);\n   318\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n   319\t\n   320\t  const resolved = await resolveThreadRef(thread);\n   321\t  if (!resolved.ok) return resolved;\n   322\t  const { filePath } = resolved.value;\n   323\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   324\t\n   325\t  const opened = openThreadDatabase(filePath);\n   326\t  if (!opened.ok) return opened;\n   327\t  const db = opened.value;\n   328\t  try {\n   329\t    const rows = db\n   330\t      .prepare(\n   331\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n   332\t         FROM event ORDER BY event_order`,\n   333\t      )\n   334\t      .all() as unknown as RawEventRow[];\n   335\t    const records = rows.map(\n   336\t      (row) =>\n   337\t        ({\n   338\t          eventKind: row.event_kind,\n   339\t          idempotencyKey: row.idempotency_key,\n   340\t          actor: row.actor,\n   341\t          harness: row.harness,\n   342\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n   343\t          eventOrder: Number(row.event_order),\n   344\t          recordedAt: row.recorded_at,\n   345\t        }) as unknown as EventRecord,\n   346\t    );\n   347\t    return { ok: true, value: records };\n   348\t  } catch (cause) {\n   349\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n   350\t  } finally {\n   351\t    db.close();\n   352\t  }\n   353\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/turn-derivation.test.ts | sed -n '1,220p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/turn-derivation.test.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Story 2 — turn derivation, the load-bearing mechanic. An LHC turn spans a\n     2\t// whole exchange: it opens on a user prompt, ignores every PI per-step\n     3\t// `turn_end`, and closes with exactly one LHC `turn_end` at `agent_end`\n     4\t// (TC-2.2). Session order is the converter's source-event order, never PI's\n     5\t// per-run `turnIndex` (TC-2.3). The accumulator goldens pin the state machine\n     6\t// directly, including the hard-kill tolerance (a dangling open turn, and an\n     7\t// agent_end with no open turn as a no-op).\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport type { MessageEventInput } from \"lhc\";\n    10\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    11\timport {\n    12\t  makeAgentEnd,\n    13\t  makeAssistantMessage,\n    14\t  makeMessageEnd,\n    15\t  makeToolResult,\n    16\t  makeUserMessage,\n    17\t  validEvent,\n    18\t} from \"../fixtures/synthetic.js\";\n    19\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    20\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tfunction textOf(event: MessageEventInput): string {\n    31\t  return (event.payload as { text?: string }).text ?? \"\";\n    32\t}\n    33\t\n    34\t// A PI per-step turn_end payload (ignored by the converter as a boundary).\n    35\tfunction piTurnEnd(turnIndex: number) {\n    36\t  return { turnIndex, message: makeAssistantMessage({ text: \"step\" }), toolResults: [] };\n    37\t}\n    38\t\n    39\tdescribe(\"Story 2: turn derivation — worked example (TC-2.2)\", () => {\n    40\t  it(\"yields exactly one LHC turn with one turn_end at agent_end; PI per-step turn_ends produce none\", async () => {\n    41\t    const started = await startCapture(store);\n    42\t    const { connector, ctx, threadRef } = started;\n    43\t\n    44\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"ask one question\")));\n    45\t    await connector.handlers.message_end(\n    46\t      ctx,\n    47\t      makeMessageEnd(\n    48\t        makeAssistantMessage({\n    49\t          thinking: \"two tools needed\",\n    50\t          toolCalls: [\n    51\t            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n    52\t            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n    53\t          ],\n    54\t        }),\n    55\t      ),\n    56\t    );\n    57\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b\" })));\n    58\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a\" })));\n    59\t    // PI fires a per-step turn_end here — it must NOT become an LHC turn_end.\n    60\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n    61\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"the answer\" })));\n    62\t    await connector.handlers.turn_end(ctx, piTurnEnd(1));\n    63\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    64\t\n    65\t    const events = await eventsAfterShutdown(started);\n    66\t    expect(kindsOf(events)).toEqual([\n    67\t      \"user_prompt\",\n    68\t      \"assistant_thinking\",\n    69\t      \"tool_call\",\n    70\t      \"tool_call\",\n    71\t      \"tool_result\",\n    72\t      \"tool_result\",\n    73\t      \"assistant_text\",\n    74\t      \"turn_end\",\n    75\t    ]);\n    76\t    // Exactly one LHC turn_end, and it lands last — at agent_end, not per PI step.\n    77\t    expect(events.filter((event) => event.eventKind === \"turn_end\")).toHaveLength(1);\n    78\t    expect(events.at(-1)?.eventKind).toBe(\"turn_end\");\n    79\t\n    80\t    const counts = await turnCounts(threadRef);\n    81\t    expect(counts.closed).toBe(1);\n    82\t    expect(counts.open).toBe(0);\n    83\t  });\n    84\t});\n    85\t\n    86\tdescribe(\"Story 2: turn derivation — source order, not turnIndex (TC-2.3)\", () => {\n    87\t  it(\"orders two agent runs that each start at turnIndex 0 by source-event order, with no collision\", async () => {\n    88\t    const started = await startCapture(store);\n    89\t    const { connector, ctx, threadRef } = started;\n    90\t\n    91\t    // Run 1 (PI turnIndex 0)\n    92\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"first prompt\")));\n    93\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"first answer\" })));\n    94\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n    95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    96\t    // Run 2 (PI turnIndex 0 AGAIN — the reset-per-run counter)\n    97\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"second prompt\")));\n    98\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"second answer\" })));\n    99\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n   100\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   101\t\n   102\t    const events = await eventsAfterShutdown(started);\n   103\t    expect(kindsOf(events)).toEqual([\n   104\t      \"user_prompt\",\n   105\t      \"assistant_text\",\n   106\t      \"turn_end\",\n   107\t      \"user_prompt\",\n   108\t      \"assistant_text\",\n   109\t      \"turn_end\",\n   110\t    ]);\n   111\t    // Source order decides sequence: run 1 precedes run 2 despite identical turnIndex.\n   112\t    expect(textOf(events[0]!)).toBe(\"first prompt\");\n   113\t    expect(textOf(events[3]!)).toBe(\"second prompt\");\n   114\t\n   115\t    const counts = await turnCounts(threadRef);\n   116\t    expect(counts.closed).toBe(2);\n   117\t    expect(counts.open).toBe(0);\n   118\t  });\n   119\t});\n   120\t\n   121\tdescribe(\"Story 2: turn accumulator — state machine goldens (AC-2.2)\", () => {\n   122\t  it(\"emits one turn_end only when a turn is open, and is idempotent across agent_end\", () => {\n   123\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   124\t    expect(acc.hasOpenTurn()).toBe(false);\n   125\t\n   126\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   127\t    expect(acc.hasOpenTurn()).toBe(true);\n   128\t\n   129\t    const emitted = acc.onAgentEnd();\n   130\t    expect(emitted).toHaveLength(1);\n   131\t    expect(emitted[0]?.eventKind).toBe(\"turn_end\");\n   132\t    expect(emitted[0]?.payload).toEqual({});\n   133\t    expect(acc.hasOpenTurn()).toBe(false);\n   134\t\n   135\t    // A second agent_end with no open turn emits nothing (hard-kill / reattach\n   136\t    // tolerance: turn_end-with-no-open-turn is a no-op).\n   137\t    expect(acc.onAgentEnd()).toEqual([]);\n   138\t  });\n   139\t\n   140\t  it(\"gives successive turns distinct turn_end idempotency keys\", () => {\n   141\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   142\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   143\t    const first = acc.onAgentEnd();\n   144\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   145\t    const second = acc.onAgentEnd();\n   146\t    expect(first[0]?.idempotencyKey).not.toBe(second[0]?.idempotencyKey);\n   147\t  });\n   148\t});\n   149\t\n   150\tdescribe(\"Story 2: turn derivation — hard-kill golden\", () => {\n   151\t  it(\"leaves a dangling open turn when the run never reaches agent_end, with no turn_end recorded\", async () => {\n   152\t    const started = await startCapture(store);\n   153\t    const { connector, ctx, threadRef } = started;\n   154\t\n   155\t    // Hard kill: a user message lands, then the process dies — no assistant\n   156\t    // close, no agent_end.\n   157\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"dangling prompt\")));\n   158\t    await connector.getInstance()?.sdk.drainSettled(threadRef);\n   159\t\n   160\t    const counts = await turnCounts(threadRef);\n   161\t    expect(counts.open).toBe(1);\n   162\t    expect(counts.closed).toBe(0);\n   163\t\n   164\t    const events = await eventsAfterShutdown(started);\n   165\t    expect(events.filter((event) => event.eventKind === \"turn_end\")).toHaveLength(0);\n   166\t    expect(kindsOf(events)).toEqual([\"user_prompt\"]);\n   167\t  });\n   168\t});\n","exit_code":0,"status":"completed"}}

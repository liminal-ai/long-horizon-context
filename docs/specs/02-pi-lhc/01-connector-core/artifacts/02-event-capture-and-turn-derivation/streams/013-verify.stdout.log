{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/map-message.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport type { EventKind, MessageEventInput } from \"lhc\";\n     2\timport type {\n     3\t  AgentMessage,\n     4\t  AssistantMessage,\n     5\t  ContentPart,\n     6\t  FileRefPart,\n     7\t  ImagePart,\n     8\t  ToolResultMessage,\n     9\t  UserMessage,\n    10\t} from \"../pi/types.js\";\n    11\timport { eventKey } from \"./idempotency.js\";\n    12\t\n    13\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n    14\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n    15\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n    16\t// present) → one `tool_call` per call, in that order; a tool result → one\n    17\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n    18\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n    19\t// drop, tech design I-6). A graceful interrupt carries its disposition through\n    20\t// on a trailing `runtime_note` (research §5b).\n    21\t\n    22\texport interface MapCtx {\n    23\t  piSessionId: string;\n    24\t  entryId?: string | undefined;\n    25\t  fallbackId?: string | undefined;\n    26\t}\n    27\t\n    28\tconst HARNESS = \"pi\";\n    29\t\n    30\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n    31\t *  field to hold its disposition, so the mapper carries `stopReason` through on\n    32\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n    33\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\n    34\texport const ABORTED_DISPOSITION_TEXT =\n    35\t  \"turn aborted (stopReason: aborted) — partial content preserved\";\n    36\t\n    37\tconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n    38\t\n    39\tfunction textOf(parts: ContentPart[]): string {\n    40\t  return parts\n    41\t    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n    42\t    .map((p) => p.text)\n    43\t    .join(\"\");\n    44\t}\n    45\t\n    46\tfunction thinkingOf(parts: ContentPart[]): string {\n    47\t  return parts\n    48\t    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n    49\t    .map((p) => p.thinking)\n    50\t    .join(\"\");\n    51\t}\n    52\t\n    53\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n    54\t  return parts.filter(\n    55\t    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n    56\t  );\n    57\t}\n    58\t\n    59\tfunction omissionText(part: ImagePart | FileRefPart): string {\n    60\t  return part.type === \"image\"\n    61\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n    62\t    : `unsupported content omitted: file reference (${part.path})`;\n    63\t}\n    64\t\n    65\tfunction buildKey(\n    66\t  ctx: MapCtx,\n    67\t  role: string,\n    68\t  kind: EventKind,\n    69\t  blockIndex: number,\n    70\t  opts: {\n    71\t    entryId?: string | undefined;\n    72\t    responseId?: string | undefined;\n    73\t    toolCallId?: string | undefined;\n    74\t    content?: string | undefined;\n    75\t  } = {},\n    76\t): string {\n    77\t  return eventKey({\n    78\t    piSessionId: ctx.piSessionId,\n    79\t    entryId: opts.entryId ?? ctx.entryId,\n    80\t    responseId: opts.responseId,\n    81\t    blockIndex,\n    82\t    kind,\n    83\t    role,\n    84\t    fallbackId: ctx.fallbackId,\n    85\t    toolCallId: opts.toolCallId,\n    86\t    content: opts.content,\n    87\t  });\n    88\t}\n    89\t\n    90\tfunction stringField(value: unknown, field: string): string | undefined {\n    91\t  if (typeof value !== \"object\" || value === null || !(field in value)) return undefined;\n    92\t  const candidate = (value as Record<string, unknown>)[field];\n    93\t  return typeof candidate === \"string\" && candidate !== \"\" ? candidate : undefined;\n    94\t}\n    95\t\n    96\tfunction entryIdOf(msg: AgentMessage): string | undefined {\n    97\t  return stringField(msg, \"entryId\");\n    98\t}\n    99\t\n   100\tfunction responseIdOf(msg: AgentMessage): string | undefined {\n   101\t  return stringField(msg, \"responseId\") ?? stringField(msg, \"id\");\n   102\t}\n   103\t\n   104\t// Per-kind builders — explicit eventKind literals so the discriminated union\n   105\t// narrows without a cast.\n   106\tfunction textEvent(\n   107\t  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n   108\t  text: string,\n   109\t  actor: string,\n   110\t  key: string,\n   111\t): MessageEventInput {\n   112\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n   113\t}\n   114\t\n   115\tfunction toolCallEvent(\n   116\t  toolCallId: string,\n   117\t  toolName: string,\n   118\t  args: Record<string, unknown>,\n   119\t  key: string,\n   120\t): MessageEventInput {\n   121\t  return {\n   122\t    eventKind: \"tool_call\",\n   123\t    idempotencyKey: key,\n   124\t    actor: \"assistant\",\n   125\t    harness: HARNESS,\n   126\t    payload: { toolCallId, toolName, arguments: args },\n   127\t  };\n   128\t}\n   129\t\n   130\tfunction toolResultEvent(\n   131\t  toolCallId: string,\n   132\t  content: string,\n   133\t  isError: boolean,\n   134\t  key: string,\n   135\t): MessageEventInput {\n   136\t  return {\n   137\t    eventKind: \"tool_result\",\n   138\t    idempotencyKey: key,\n   139\t    actor: \"tool\",\n   140\t    harness: HARNESS,\n   141\t    payload: { toolCallId, content, isError },\n   142\t  };\n   143\t}\n   144\t\n   145\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n   146\t  const events: MessageEventInput[] = [];\n   147\t  const entryId = entryIdOf(msg);\n   148\t  let block = 0;\n   149\t  if (msg.content.some((p) => p.type === \"text\")) {\n   150\t    const text = textOf(msg.content);\n   151\t    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { entryId, content: text })));\n   152\t    block += 1;\n   153\t  }\n   154\t  for (const part of unsupportedOf(msg.content)) {\n   155\t    const text = omissionText(part);\n   156\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: text })));\n   157\t    block += 1;\n   158\t  }\n   159\t  if (events.length === 0) {\n   160\t    events.push(\n   161\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: \"empty:user\" })),\n   162\t    );\n   163\t  }\n   164\t  return events;\n   165\t}\n   166\t\n   167\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n   168\t  const events: MessageEventInput[] = [];\n   169\t  const entryId = entryIdOf(msg);\n   170\t  const responseId = responseIdOf(msg);\n   171\t  let block = 0;\n   172\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n   173\t  if (msg.content.some((p) => p.type === \"thinking\")) {\n   174\t    const text = thinkingOf(msg.content);\n   175\t    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { entryId, responseId, content: text })));\n   176\t    block += 1;\n   177\t  }\n   178\t  if (msg.content.some((p) => p.type === \"text\")) {\n   179\t    const text = textOf(msg.content);\n   180\t    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { entryId, responseId, content: text })));\n   181\t    block += 1;\n   182\t  }\n   183\t  for (const part of msg.content) {\n   184\t    if (part.type !== \"toolCall\") continue;\n   185\t    events.push(\n   186\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { entryId, responseId, toolCallId: part.id, content: part.name })),\n   187\t    );\n   188\t    block += 1;\n   189\t  }\n   190\t  for (const part of unsupportedOf(msg.content)) {\n   191\t    const text = omissionText(part);\n   192\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: text })));\n   193\t    block += 1;\n   194\t  }\n   195\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\n   196\t  if (msg.stopReason === \"aborted\") {\n   197\t    events.push(\n   198\t      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: ABORTED_DISPOSITION_TEXT })),\n   199\t    );\n   200\t    block += 1;\n   201\t  }\n   202\t  if (events.length === 0) {\n   203\t    events.push(\n   204\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: \"empty:assistant\" })),\n   205\t    );\n   206\t  }\n   207\t  return events;\n   208\t}\n   209\t\n   210\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n   211\t  const events: MessageEventInput[] = [];\n   212\t  const entryId = entryIdOf(msg);\n   213\t  const content = textOf(msg.content);\n   214\t  const isError = msg.isError === true;\n   215\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n   216\t  // and content are always captured, even on failure (AC-2.4).\n   217\t  events.push(\n   218\t    toolResultEvent(\n   219\t      msg.toolCallId,\n   220\t      content,\n   221\t      isError,\n   222\t      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { entryId, toolCallId: msg.toolCallId, content }),\n   223\t    ),\n   224\t  );\n   225\t  let block = 1;\n   226\t  for (const [partIndex, part] of unsupportedOf(msg.content).entries()) {\n   227\t    const text = omissionText(part);\n   228\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"toolResult\", \"runtime_note\", block, { entryId, toolCallId: `${msg.toolCallId}:omission:${partIndex}`, content: text })));\n   229\t    block += 1;\n   230\t  }\n   231\t  return events;\n   232\t}\n   233\t\n   234\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n   235\t  switch (msg.role) {\n   236\t    case \"user\":\n   237\t      return mapUser(msg, ctx);\n   238\t    case \"assistant\":\n   239\t      return mapAssistant(msg, ctx);\n   240\t    case \"toolResult\":\n   241\t      return mapToolResult(msg, ctx);\n   242\t    default:\n   243\t      throw new Error(`unmappable PI message role: ${String((msg as { role?: unknown }).role)}`);\n   244\t  }\n   245\t}\n","exit_code":0,"status":"completed"}}

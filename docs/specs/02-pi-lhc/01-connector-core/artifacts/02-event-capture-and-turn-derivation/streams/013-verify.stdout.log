{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/fixtures/synthetic.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\n     2\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\n     3\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\n     4\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\n     5\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\n     6\timport type { EventKind, MessageEventInput } from \"lhc\";\n     7\timport type {\n     8\t  AgentEndEvent,\n     9\t  AgentMessage,\n    10\t  AssistantMessage,\n    11\t  ContentPart,\n    12\t  MessageEndEvent,\n    13\t  PiStopReason,\n    14\t  SessionStartEvent,\n    15\t  SessionStartReason,\n    16\t  ToolResultMessage,\n    17\t  UserMessage,\n    18\t} from \"../../src/pi/types.js\";\n    19\t\n    20\t// ── LHC intake-event builder ─────────────────────────────────────────\n    21\t\n    22\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\n    23\t\n    24\tlet keyCounter = 0;\n    25\t/** Reset the per-call key counter so a test can build deterministic keys. */\n    26\texport function resetEventKeyCounter(): void {\n    27\t  keyCounter = 0;\n    28\t}\n    29\t\n    30\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n    31\t  user_prompt: () => ({ text: \"please read the file\" }),\n    32\t  assistant_text: () => ({ text: \"here is what I found\" }),\n    33\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n    34\t  runtime_note: () => ({ text: \"model changed: anthropic/claude → openai/gpt\" }),\n    35\t  tool_call: () => ({ toolCallId: \"call-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } }),\n    36\t  tool_result: () => ({ toolCallId: \"call-1\", content: \"contents of notes.txt\", isError: false }),\n    37\t  turn_end: () => ({}),\n    38\t};\n    39\t\n    40\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\n    41\t *  mismatch at a call site is a compile error; the final reconciliation goes\n    42\t *  through `unknown` (TS can't reduce a structural spread to the deferred\n    43\t *  Extract), with call-site safety living in the parameter types. */\n    44\texport function validEvent<K extends EventKind>(\n    45\t  kind: K,\n    46\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n    47\t): EventByKind<K> {\n    48\t  keyCounter += 1;\n    49\t  const base = {\n    50\t    eventKind: kind,\n    51\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\n    52\t    actor: \"fixture-actor\",\n    53\t    harness: \"pi\",\n    54\t    payload: defaultPayloads[kind](),\n    55\t  };\n    56\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    57\t}\n    58\t\n    59\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    60\t  return kinds.map((kind) => validEvent(kind));\n    61\t}\n    62\t\n    63\t// ── PI message builders ──────────────────────────────────────────────\n    64\t\n    65\texport function makeUserMessage(text = \"please read the file\"): UserMessage {\n    66\t  return { role: \"user\", content: [{ type: \"text\", text }] };\n    67\t}\n    68\t\n    69\texport interface AssistantToolCall {\n    70\t  id: string;\n    71\t  name: string;\n    72\t  arguments?: Record<string, unknown>;\n    73\t}\n    74\t\n    75\t/** Fans out to content parts in PI's confirmed order: thinking → text →\n    76\t *  toolCall×N (research §5a). */\n    77\texport function makeAssistantMessage(\n    78\t  opts: {\n    79\t    thinking?: string;\n    80\t    text?: string;\n    81\t    toolCalls?: AssistantToolCall[];\n    82\t    stopReason?: PiStopReason;\n    83\t  } = {},\n    84\t): AssistantMessage {\n    85\t  const content: ContentPart[] = [];\n    86\t  if (opts.thinking !== undefined) content.push({ type: \"thinking\", thinking: opts.thinking });\n    87\t  if (opts.text !== undefined) content.push({ type: \"text\", text: opts.text });\n    88\t  for (const call of opts.toolCalls ?? []) {\n    89\t    content.push({ type: \"toolCall\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\n    90\t  }\n    91\t  const msg: AssistantMessage = { role: \"assistant\", content };\n    92\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\n    93\t  return msg;\n    94\t}\n    95\t\n    96\texport function makeToolResult(opts: {\n    97\t  id: string;\n    98\t  isError?: boolean;\n    99\t  content?: string;\n   100\t}): ToolResultMessage {\n   101\t  const msg: ToolResultMessage = {\n   102\t    role: \"toolResult\",\n   103\t    toolCallId: opts.id,\n   104\t    content: [{ type: \"text\", text: opts.content ?? \"tool output\" }],\n   105\t  };\n   106\t  if (opts.isError !== undefined) msg.isError = opts.isError;\n   107\t  return msg;\n   108\t}\n   109\t\n   110\t// ── PI event-stream builders ─────────────────────────────────────────\n   111\t\n   112\texport function makeSessionStart(\n   113\t  reason: SessionStartReason = \"startup\",\n   114\t  previousSessionFile?: string,\n   115\t): SessionStartEvent {\n   116\t  const ev: SessionStartEvent = { reason };\n   117\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\n   118\t  return ev;\n   119\t}\n   120\t\n   121\texport function makeMessageEnd(\n   122\t  message: AgentMessage,\n   123\t  entryId?: string,\n   124\t  position?: number,\n   125\t): MessageEndEvent {\n   126\t  const ev: MessageEndEvent = { message };\n   127\t  if (entryId !== undefined) ev.entryId = entryId;\n   128\t  if (position !== undefined) ev.position = position;\n   129\t  return ev;\n   130\t}\n   131\t\n   132\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\n   133\t  return { messages };\n   134\t}\n","exit_code":0,"status":"completed"}}

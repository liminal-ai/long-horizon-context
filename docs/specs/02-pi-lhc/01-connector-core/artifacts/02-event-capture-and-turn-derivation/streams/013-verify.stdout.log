{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/lifecycle/state.ts | sed -n '1,120p'\"","aggregated_output":"     1\timport type { ThreadRef } from \"lhc\";\n     2\timport type { ValidationReport } from \"../shared/diagnostics.js\";\n     3\t\n     4\t// AC-1.3 / AC-2.7. This module is COMPLETE, not stubbed (story Technical\n     5\t// Notes): its shape is what prevents stale PI-context retention later. The\n     6\t// holder has no slot for a PI ctx/session object, so retaining one across hooks\n     7\t// is impossible in normal use — the structural enforcement the tech arch's\n     8\t// plain-data-only rule calls for.\n     9\t\n    10\t/** Recorded when a writable-thread capture fails: the failure degrades to a\n    11\t *  durable, queryable gap rather than throwing into a PI hook (AC-2.7). */\n    12\texport interface CaptureFailureDiagnostic {\n    13\t  code: string;\n    14\t  eventKey?: string;\n    15\t  message: string;\n    16\t  recordedGap: boolean;\n    17\t}\n    18\t\n    19\t/** The connector's entire retained state between PI hooks: a thread reference,\n    20\t *  told-the-user flags, and health diagnostics — ALL plain data. Everything\n    21\t *  stored here must survive `structuredClone` (no functions, no class\n    22\t *  instances, no PI objects). */\n    23\texport interface SessionState {\n    24\t  threadRef: ThreadRef;\n    25\t  flags: {\n    26\t    startupValidationReported: boolean;\n    27\t    [k: string]: boolean;\n    28\t  };\n    29\t  health: {\n    30\t    lastCaptureFailure?: CaptureFailureDiagnostic;\n    31\t    startupValidation?: ValidationReport;\n    32\t  };\n    33\t}\n    34\t\n    35\t/** Build the initial plain-data holder for a resolved thread. */\n    36\texport function createSessionState(threadRef: ThreadRef): SessionState {\n    37\t  return {\n    38\t    threadRef,\n    39\t    flags: { startupValidationReported: false },\n    40\t    health: {},\n    41\t  };\n    42\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '261,520p'\"","aggregated_output":"   261\t    return resolveThread(launch, buildResolveDeps(ctx));\n   262\t  }\n   263\t\n   264\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n   265\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n   266\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n   267\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n   268\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n   269\t  async function resolveReloadFor(\n   270\t    launch: LaunchFlags,\n   271\t    ctx: ExtensionContext,\n   272\t  ): Promise<OpResult<ThreadRef | null>> {\n   273\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n   274\t  }\n   275\t\n   276\t  // session_start: resolve the recording thread and construct one background\n   277\t  // instance against it. Config is gated first so a session with no usable\n   278\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n   279\t  // thread is re-resolved from the durable registry (reattach, never create);\n   280\t  // every other reason runs the normal launch resolution.\n   281\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   282\t    const config = buildSdkConfig(ctx);\n   283\t    if (!config.ok) {\n   284\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   285\t      return;\n   286\t    }\n   287\t    const launch = parseLaunch();\n   288\t    const isReload = event.reason === \"reload\";\n   289\t    const resolved = isReload\n   290\t      ? await resolveReloadFor(launch, ctx)\n   291\t      : await resolveForLaunch(launch, ctx);\n   292\t    if (!resolved.ok) {\n   293\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   294\t      return;\n   295\t    }\n   296\t    if (resolved.value === null) {\n   297\t      lastDiagnostic = isReload\n   298\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n   299\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   300\t      return;\n   301\t    }\n   302\t    const built = await initInstance(resolved.value, config.value);\n   303\t    if (!built.ok) {\n   304\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   305\t      return;\n   306\t    }\n   307\t    instance = built.value;\n   308\t    state = createSessionState(resolved.value);\n   309\t    const piSessionId = sessionIdOf(resolved.value);\n   310\t    captureSession = {\n   311\t      piSessionId,\n   312\t      accumulator: new TurnAccumulator({ piSessionId }),\n   313\t      sourceSeq: 0,\n   314\t    };\n   315\t  };\n   316\t\n   317\t  // Dispose with flush before any session swap (session_before_switch fires\n   318\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   319\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n   320\t  // re-resolves its thread from the durable registry on the next session_start.\n   321\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   322\t    const result = await disposeInstance(instance);\n   323\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   324\t    instance = null;\n   325\t    captureSession = null;\n   326\t  };\n   327\t\n   328\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n   329\t  // converter already recorded a durable gap for a writable-thread malformed\n   330\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n   331\t  // surfaces as an extension health signal with no gap. Neither path throws.\n   332\t  function recordCaptureOutcome(\n   333\t    result: OpResult<BatchResult>,\n   334\t    events: readonly MessageEventInput[],\n   335\t  ): void {\n   336\t    if (result.ok) return;\n   337\t    const recordedGap = result.error.code === \"invalid_event\";\n   338\t    const failure: CaptureFailureDiagnostic = {\n   339\t      code: result.error.code,\n   340\t      message: result.error.reason,\n   341\t      recordedGap,\n   342\t    };\n   343\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n   344\t    lastDiagnostic = failure;\n   345\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   346\t  }\n   347\t\n   348\t  function nextSourceSeq(session: CaptureSession): number {\n   349\t    const sourceSeq = session.sourceSeq;\n   350\t    session.sourceSeq += 1;\n   351\t    return sourceSeq;\n   352\t  }\n   353\t\n   354\t  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\n   355\t    // Last-resort id-less discriminator. PI position wins when present; the\n   356\t    // connector ordinal is used only when PI gives no event identity at all.\n   357\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n   358\t    // order yields the same ordinal, which is the best identity available.\n   359\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n   360\t  }\n   361\t\n   362\t  async function recordMappingFailure(\n   363\t    hook: string,\n   364\t    position: number | undefined,\n   365\t    sourceSeq: number,\n   366\t    cause: unknown,\n   367\t  ): Promise<void> {\n   368\t    if (instance === null) return;\n   369\t    const message = cause instanceof Error ? cause.message : String(cause);\n   370\t    const result = await captureGap(\n   371\t      fallbackIdFor(hook, position, sourceSeq),\n   372\t      `${hook}: ${message}`,\n   373\t      instance,\n   374\t    );\n   375\t    if (!result.ok) {\n   376\t      recordCaptureOutcome(result, []);\n   377\t      return;\n   378\t    }\n   379\t    const failure: CaptureFailureDiagnostic = {\n   380\t      code: \"invalid_event\",\n   381\t      message: `${hook}: ${message}`,\n   382\t      recordedGap: true,\n   383\t    };\n   384\t    lastDiagnostic = failure;\n   385\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   386\t  }\n   387\t\n   388\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   389\t  // open turn, and flush through the converter (AC-2.1).\n   390\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   391\t    if (instance === null || captureSession === null) return;\n   392\t    const sourceSeq = nextSourceSeq(captureSession);\n   393\t    const mapCtx: MapCtx =\n   394\t      event.entryId !== undefined && event.entryId !== \"\"\n   395\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n   396\t        : {\n   397\t            piSessionId: captureSession.piSessionId,\n   398\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n   399\t          };\n   400\t    let events: MessageEventInput[];\n   401\t    try {\n   402\t      events = mapMessage(event.message, mapCtx);\n   403\t    } catch (cause) {\n   404\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n   405\t      return;\n   406\t    }\n   407\t    captureSession.accumulator.onMessage(events);\n   408\t    if (events.length === 0) return;\n   409\t    recordCaptureOutcome(await capture(events, instance), events);\n   410\t  };\n   411\t\n   412\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   413\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   414\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   415\t    if (instance === null || captureSession === null) return;\n   416\t    const sourceSeq = nextSourceSeq(captureSession);\n   417\t    const mapCtx: MapCtx = {\n   418\t      piSessionId: captureSession.piSessionId,\n   419\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n   420\t    };\n   421\t    const note = mapModelSelect(event, mapCtx);\n   422\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   423\t  };\n   424\t\n   425\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   426\t    if (instance === null || captureSession === null) return;\n   427\t    const sourceSeq = nextSourceSeq(captureSession);\n   428\t    const mapCtx: MapCtx = {\n   429\t      piSessionId: captureSession.piSessionId,\n   430\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n   431\t    };\n   432\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   433\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   434\t  };\n   435\t\n   436\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   437\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   438\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   439\t    if (instance === null || captureSession === null) return;\n   440\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   441\t    if (turnEnd.length === 0) return;\n   442\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   443\t  };\n   444\t\n   445\t  // Contain every handler: an observe-only hook must never throw back into PI\n   446\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   447\t  // plain-data diagnostic; it is never rethrown.\n   448\t  const guard = (\n   449\t    name: Epic1Hook,\n   450\t    body: PiHookHandler<Epic1Hook>,\n   451\t  ): PiHookHandler<Epic1Hook> => {\n   452\t    return async (ctx, event): Promise<void> => {\n   453\t      try {\n   454\t        await body(ctx, event);\n   455\t      } catch (err) {\n   456\t        lastDiagnostic = {\n   457\t          code: \"hook_handler_error\",\n   458\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   459\t          recordedGap: false,\n   460\t        };\n   461\t      }\n   462\t    };\n   463\t  };\n   464\t\n   465\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   466\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n   467\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n   468\t  // FRESH ctx and retains none of it.\n   469\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   470\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n   471\t  };\n   472\t\n   473\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   474\t  // are live; PI per-step turn_end and fork remain no-ops.\n   475\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   476\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   477\t    session_before_switch: onDispose,\n   478\t    session_shutdown: onDispose,\n   479\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   480\t    turn_end: noop,\n   481\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   482\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   483\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   484\t    session_before_fork: noop,\n   485\t  };\n   486\t\n   487\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   488\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   489\t\n   490\t  return {\n   491\t    handlers,\n   492\t    register(pi: ExtensionAPI): void {\n   493\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   494\t    },\n   495\t    getState(): SessionState | null {\n   496\t      return state;\n   497\t    },\n   498\t    getInstance(): LhcInstance | null {\n   499\t      return instance;\n   500\t    },\n   501\t    snapshot(): ConnectorSnapshot {\n   502\t      return { state, lastDiagnostic };\n   503\t    },\n   504\t  };\n   505\t}\n   506\t\n   507\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   508\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n   509\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n   510\t *  observe-only SDK config, and the `--resume` selector that presents the\n   511\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n   512\t *  resolves/creates and initializes for real. On `/reload` the connector\n   513\t *  re-resolves the same thread from the durable registry (it keeps no\n   514\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n   515\t *  config. */\n   516\texport function activate(pi: ExtensionAPI): void {\n   517\t  createConnector().register(pi);\n   518\t}\n   519\t\n   520\texport default activate;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type {\n    11\t  BatchResult,\n    12\t  DerivationProvider,\n    13\t  MessageEventInput,\n    14\t  OpResult,\n    15\t  ProviderResult,\n    16\t  SdkConfig,\n    17\t  ThreadRef,\n    18\t} from \"lhc\";\n    19\timport type {\n    20\t  ExtensionAPI,\n    21\t  ExtensionContext,\n    22\t  PiHookHandler,\n    23\t  PiHookName,\n    24\t} from \"./pi/types.js\";\n    25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    26\timport { createSessionState } from \"./lifecycle/state.js\";\n    27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    28\timport {\n    29\t  parseLaunchFlags,\n    30\t  resolveReloadThread,\n    31\t  resolveThread,\n    32\t  type LaunchFlags,\n    33\t  type ResolveDeps,\n    34\t} from \"./lifecycle/thread-resolution.js\";\n    35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    36\timport { capture, captureGap } from \"./capture/converter.js\";\n    37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n    38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n    39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n    40\timport type { LhcInstance } from \"./shared/instance.js\";\n    41\t\n    42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    43\texport type { LhcInstance } from \"./shared/instance.js\";\n    44\t\n    45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    47\t *  registers no handler for it (story Scope Out). */\n    48\texport const EPIC_1_HOOKS = [\n    49\t  \"session_start\",\n    50\t  \"message_end\",\n    51\t  \"turn_end\",\n    52\t  \"agent_end\",\n    53\t  \"model_select\",\n    54\t  \"thinking_level_select\",\n    55\t  \"session_before_fork\",\n    56\t  \"session_before_switch\",\n    57\t  \"session_shutdown\",\n    58\t] as const satisfies readonly PiHookName[];\n    59\t\n    60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    61\t\n    62\t/** What the connector needs from the host to run a session. Every dependency\n    63\t *  has a working production default; the overrides exist for test isolation\n    64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n    65\t *  in the PI-auth-backed inference config.\n    66\t *\n    67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n    68\t *  default is the observe-only config below (a real, construction-valid SDK);\n    69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n    70\texport interface ConnectorDeps {\n    71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    72\t  registryPath?: string;\n    73\t  newThreadFilePath?: () => string;\n    74\t  parseLaunch?: () => LaunchFlags;\n    75\t  selectThread?: (\n    76\t    choices: readonly ThreadChoice[],\n    77\t    ctx: ExtensionContext,\n    78\t  ) => Promise<string | null>;\n    79\t}\n    80\t\n    81\t/** Everything the connector retains across hooks as PLAIN data — by\n    82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    84\t *  deliberately not part of the snapshot. */\n    85\texport interface ConnectorSnapshot {\n    86\t  state: SessionState | null;\n    87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    88\t}\n    89\t\n    90\texport interface Connector {\n    91\t  /** Register the observe-only hook rail on the PI extension API. */\n    92\t  register(pi: ExtensionAPI): void;\n    93\t  /** The plain-data state retained across hooks. `null` until a session\n    94\t   *  resolves a thread; never holds a PI ctx. */\n    95\t  getState(): SessionState | null;\n    96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n    97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n    98\t  getInstance(): LhcInstance | null;\n    99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n   100\t  snapshot(): ConnectorSnapshot;\n   101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   102\t   *  synthetic ctx/events without a live PI. */\n   103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n   104\t}\n   105\t\n   106\t/** The connector's live capture state for one session: the open-turn\n   107\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n   108\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n   109\t *  per session, never part of the plain-data snapshot and never a PI object. */\n   110\tinterface CaptureSession {\n   111\t  piSessionId: string;\n   112\t  accumulator: TurnAccumulator;\n   113\t  sourceSeq: number;\n   114\t}\n   115\t\n   116\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n   117\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   118\t *  same id). */\n   119\tfunction sessionIdOf(ref: ThreadRef): string {\n   120\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   121\t}\n   122\t\n   123\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   124\t\n   125\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n   126\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n   127\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n   128\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n   129\t *  derivation work is ever queued and this provider is never invoked — it exists\n   130\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n   131\t *\n   132\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n   133\t *  documents as \"selectable only by explicit name — never a production default\"\n   134\t *  (it would mark fake derived text into the thread). Failing closed preserves\n   135\t *  the observe-only guarantee even if a future change queued work before Stories\n   136\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n   137\t *  assignments), which is what a real *completing* inference requires (the\n   138\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n   139\tfunction observeOnlyProvider(): DerivationProvider {\n   140\t  const notConfigured = (): Promise<ProviderResult> =>\n   141\t    Promise.resolve({\n   142\t      ok: false,\n   143\t      retryable: false,\n   144\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n   145\t    });\n   146\t  return {\n   147\t    smoothPrompt: notConfigured,\n   148\t    summarizeToolCall: notConfigured,\n   149\t    summarizeToolResult: notConfigured,\n   150\t    composeTurnRendering: notConfigured,\n   151\t    projectLowerBand: notConfigured,\n   152\t    summarizeChunkDetailed: notConfigured,\n   153\t    summarizeChunkBrief: notConfigured,\n   154\t  };\n   155\t}\n   156\t\n   157\t/** The production observe-only SDK config: a real, construction-valid instance\n   158\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n   159\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n   160\t *  config. */\n   161\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n   162\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n   163\t}\n   164\t\n   165\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   166\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   167\t *  show. */\n   168\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   169\t  const lines = choices.map((choice, i) => {\n   170\t    const title = choice.title ?? \"(untitled)\";\n   171\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   172\t  });\n   173\t  return [\n   174\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n   175\t    ...lines,\n   176\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n   177\t  ].join(\"\\n\");\n   178\t}\n   179\t\n   180\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n   181\t *  interactive input/selection surface (wiring research), so the production\n   182\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n   183\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n   184\t *  most recently created thread as the best available explicit default. The\n   185\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n   186\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n   187\t *  A true interactive picker awaits a PI input surface; until then resuming a\n   188\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n   189\t *  precise spec deviation. */\n   190\tfunction defaultSelectThread(\n   191\t  choices: readonly ThreadChoice[],\n   192\t  ctx: ExtensionContext,\n   193\t): Promise<string | null> {\n   194\t  const mostRecent = choices.at(-1);\n   195\t  if (mostRecent === undefined) return Promise.resolve(null);\n   196\t  if (ctx.hasUI) {\n   197\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   198\t  }\n   199\t  return Promise.resolve(mostRecent.threadId);\n   200\t}\n   201\t\n   202\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   203\t *  generated by the registry at creation, so the file name is just a unique\n   204\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   205\t *  parents). */\n   206\tfunction defaultNewThreadFilePath(): string {\n   207\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   208\t  mkdirSync(dir, { recursive: true });\n   209\t  return join(dir, `${randomUUID()}.sqlite`);\n   210\t}\n   211\t\n   212\t/** Build a connector instance. Its mutable state lives in this closure; the\n   213\t *  registered handlers capture it, so the instance stays live for the session\n   214\t *  even when `activate` discards the returned object. The connector holds NO\n   215\t *  module-level or durable state of its own — reload reconstructs the thread from\n   216\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n   217\t *  closure reattaches correctly (AC-1.5). */\n   218\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   219\t  // The connector's retained state. `state` is plain data (the durable thread\n   220\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   221\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n   222\t  // none survives the connector — reload re-resolves from the registry.\n   223\t  let state: SessionState | null = null;\n   224\t  let instance: LhcInstance | null = null;\n   225\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   226\t  let captureSession: CaptureSession | null = null;\n   227\t\n   228\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n   229\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   230\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   231\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n   232\t\n   233\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   234\t    return { code, message, recordedGap: false };\n   235\t  }\n   236\t\n   237\t  // The registry/file deps every resolver path shares. `registryPath` is set\n   238\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n   239\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n   240\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n   241\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n   242\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   243\t    return resolveDeps;\n   244\t  }\n   245\t\n   246\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n   247\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n   248\t  // no-flag creates).\n   249\t  async function resolveForLaunch(\n   250\t    launch: LaunchFlags,\n   251\t    ctx: ExtensionContext,\n   252\t  ): Promise<OpResult<ThreadRef | null>> {\n   253\t    if (launch.resume === true) {\n   254\t      const pickerDeps: {\n   255\t        registryPath?: string;\n   256\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n   257\t      } = { select: (choices) => selectThread(choices, ctx) };\n   258\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n   259\t      return pickThread(ctx.cwd, pickerDeps);\n   260\t    }\n","exit_code":0,"status":"completed"}}

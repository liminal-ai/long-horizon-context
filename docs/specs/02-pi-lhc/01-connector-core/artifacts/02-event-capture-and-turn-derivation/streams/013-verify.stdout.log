{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/turn-accumulator.ts | sed -n '1,120p'\"","aggregated_output":"     1\timport type { MessageEventInput } from \"lhc\";\n     2\timport { eventKey } from \"./idempotency.js\";\n     3\t\n     4\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n     5\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n     6\t//\n     7\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n     8\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\n     9\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n    10\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n    11\t// no-op on reattach, since a fresh accumulator has no open turn to close.\n    12\t\n    13\texport interface TurnAccumulatorCtx {\n    14\t  piSessionId: string;\n    15\t  actor?: string;\n    16\t  harness?: string;\n    17\t}\n    18\t\n    19\texport class TurnAccumulator {\n    20\t  private readonly piSessionId: string;\n    21\t  private readonly actor: string;\n    22\t  private readonly harness: string;\n    23\t  private open = false;\n    24\t  private openTurnKey: string | null = null;\n    25\t\n    26\t  constructor(ctx: TurnAccumulatorCtx) {\n    27\t    this.piSessionId = ctx.piSessionId;\n    28\t    this.actor = ctx.actor ?? \"system\";\n    29\t    this.harness = ctx.harness ?? \"pi\";\n    30\t  }\n    31\t\n    32\t  /** Open the turn when this message's events include a `user_prompt`. A new\n    33\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n    34\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n    35\t  onMessage(events: MessageEventInput[]): void {\n    36\t    const opening = events.find((event) => event.eventKind === \"user_prompt\");\n    37\t    if (opening !== undefined) {\n    38\t      this.open = true;\n    39\t      this.openTurnKey = opening.idempotencyKey;\n    40\t    }\n    41\t  }\n    42\t\n    43\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n    44\t   *  transition the accumulator drives, and it happens once per agent run. */\n    45\t  onAgentEnd(): MessageEventInput[] {\n    46\t    if (!this.open) return [];\n    47\t    this.open = false;\n    48\t    const key = eventKey({\n    49\t      piSessionId: this.piSessionId,\n    50\t      blockIndex: 0,\n    51\t      kind: \"turn_end\",\n    52\t      role: \"system\",\n    53\t      content: this.openTurnKey ?? \"turn:end\",\n    54\t    });\n    55\t    this.openTurnKey = null;\n    56\t    return [\n    57\t      {\n    58\t        eventKind: \"turn_end\",\n    59\t        idempotencyKey: key,\n    60\t        actor: this.actor,\n    61\t        harness: this.harness,\n    62\t        payload: {},\n    63\t      },\n    64\t    ];\n    65\t  }\n    66\t\n    67\t  hasOpenTurn(): boolean {\n    68\t    return this.open;\n    69\t  }\n    70\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/support.ts | sed -n '1,160p'\"","aggregated_output":"     1\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\n     2\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\n     3\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\n     4\t// converter → real LHC intake) so every capture test asserts on recorded\n     5\t// thread state, never on a mocked intake. The two external edges stay as the\n     6\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\n     7\t// SDK runs real against a temp SQLite thread with the deterministic provider\n     8\t// (selected by explicit name, never a production default).\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  inspect,\n    12\t  intakeStream,\n    13\t  type EventKind,\n    14\t  type MessageEventInput,\n    15\t  type OpResult,\n    16\t  type SdkConfig,\n    17\t  type ThreadRef,\n    18\t} from \"lhc\";\n    19\timport { createConnector, type Connector } from \"../../src/index.js\";\n    20\timport type { LaunchFlags } from \"../../src/lifecycle/thread-resolution.js\";\n    21\timport type { ExtensionContext, SessionStartReason } from \"../../src/pi/types.js\";\n    22\timport { makeSessionStart } from \"../fixtures/synthetic.js\";\n    23\timport type { TempStore } from \"../fixtures/thread.js\";\n    24\t\n    25\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\n    26\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\n    27\t *  assume a TUI. */\n    28\texport function syntheticCtx(cwd = \"/work/capture\"): ExtensionContext {\n    29\t  return {\n    30\t    cwd,\n    31\t    hasUI: false,\n    32\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n    33\t    ui: { notify: () => {} },\n    34\t    sessionManager: { getEntries: () => [] },\n    35\t  };\n    36\t}\n    37\t\n    38\t/** The capture-suite SDK config: a real background instance on the\n    39\t *  deterministic provider, so a captured user_prompt's queued derivation has a\n    40\t *  handler to settle and never strands background work. */\n    41\texport function captureConfig(): OpResult<SdkConfig> {\n    42\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n    43\t}\n    44\t\n    45\texport interface StartedCapture {\n    46\t  connector: Connector;\n    47\t  ctx: ExtensionContext;\n    48\t  threadRef: ThreadRef;\n    49\t}\n    50\t\n    51\t/** Start a connector against a temp store under the given launch flags and fire\n    52\t *  `session_start{reason}`. The driver for existing-thread reattach: pass\n    53\t *  `{ session: threadId }` with reason `\"resume\"`/`\"reload\"` to attach a fresh\n    54\t *  connector to a thread a prior connector created. */\n    55\texport async function attachCapture(\n    56\t  store: TempStore,\n    57\t  launch: LaunchFlags,\n    58\t  reason: SessionStartReason,\n    59\t  cwd = \"/work/capture\",\n    60\t): Promise<StartedCapture> {\n    61\t  const connector = createConnector({\n    62\t    registryPath: store.registryPath,\n    63\t    newThreadFilePath: () => store.threadPath(),\n    64\t    parseLaunch: () => launch,\n    65\t    buildSdkConfig: () => captureConfig(),\n    66\t  });\n    67\t  const ctx = syntheticCtx(cwd);\n    68\t  await connector.handlers.session_start(ctx, makeSessionStart(reason));\n    69\t  const state = connector.getState();\n    70\t  if (state === null) throw new Error(\"attachCapture: session_start did not resolve a thread\");\n    71\t  return { connector, ctx, threadRef: state.threadRef };\n    72\t}\n    73\t\n    74\t/** Start a connector against a temp store and fire `session_start{new}` so a\n    75\t *  background instance + thread exist and the capture hooks are live. */\n    76\texport async function startCapture(store: TempStore, cwd = \"/work/capture\"): Promise<StartedCapture> {\n    77\t  return attachCapture(store, {}, \"new\", cwd);\n    78\t}\n    79\t\n    80\t/** Settle background work and dispose, then read the durable event log back in\n    81\t *  recorded order — capture's product is the stored thread, so tests assert on\n    82\t *  this. */\n    83\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\n    84\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \"shutdown\" });\n    85\t  const read = await intakeStream.listEvents(started.threadRef);\n    86\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n    87\t  // Strip the server-stamped fields so the comparison is over the logical\n    88\t  // intake shape the converter produced.\n    89\t  return read.value.map((record) => ({\n    90\t    eventKind: record.eventKind,\n    91\t    idempotencyKey: record.idempotencyKey,\n    92\t    actor: record.actor,\n    93\t    harness: record.harness,\n    94\t    payload: record.payload,\n    95\t  })) as MessageEventInput[];\n    96\t}\n    97\t\n    98\t/** The ordered event-kind sequence — the spine every capture test checks. */\n    99\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\n   100\t  return events.map((event) => event.eventKind);\n   101\t}\n   102\t\n   103\t/** Counts open/closed turns and total recorded events from the inspect\n   104\t *  overview (the real read-back surface, not a private query). */\n   105\texport async function turnCounts(\n   106\t  threadRef: ThreadRef,\n   107\t): Promise<{ open: number; closed: number; events: number }> {\n   108\t  const overview = await inspect.overview(threadRef);\n   109\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\n   110\t  return {\n   111\t    open: overview.value.turns.open,\n   112\t    closed: overview.value.turns.closed,\n   113\t    events: overview.value.events.count,\n   114\t  };\n   115\t}\n","exit_code":0,"status":"completed"}}

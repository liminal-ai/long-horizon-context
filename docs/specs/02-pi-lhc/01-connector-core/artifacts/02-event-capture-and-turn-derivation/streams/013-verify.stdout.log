{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/idempotency.test.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\n     2\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n     3\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n     4\t// must add nothing the second time. The key goldens pin construction precedence:\n     5\t// PI entry id → provider response / tool-call id → content fingerprint, with\n     6\t// blockIndex and kind disambiguating one message's fan-out.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\n     9\timport { capture } from \"../../src/capture/converter.js\";\n    10\timport { eventKey } from \"../../src/capture/idempotency.js\";\n    11\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    12\timport { mapModelSelect } from \"../../src/capture/runtime-changes.js\";\n    13\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    14\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    15\timport type { AgentMessage } from \"../../src/pi/types.js\";\n    16\timport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\n    17\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    18\t\n    19\tlet store: TempStore;\n    20\tbeforeEach(() => {\n    21\t  store = tempStore();\n    22\t});\n    23\tafterEach(() => {\n    24\t  store.cleanup();\n    25\t});\n    26\t\n    27\tdescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n    28\t  it(\"is deterministic: identical input yields an identical key\", () => {\n    29\t    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n    30\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\n    31\t  });\n    32\t\n    33\t  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n    34\t    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n    35\t    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n    36\t    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n    37\t    expect(thinking).toContain(\"e1\");\n    38\t    // Same entry, different block → different key (fan-out stays distinct).\n    39\t    expect(text).not.toBe(thinking);\n    40\t    // Same entry + block, different kind → still distinct.\n    41\t    expect(textSameBlock).not.toBe(thinking);\n    42\t  });\n    43\t\n    44\t  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n    45\t    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n    46\t    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n    47\t    expect(call).toContain(\"call_a\");\n    48\t    expect(result).toContain(\"call_a\");\n    49\t    expect(call).not.toBe(result);\n    50\t  });\n    51\t\n    52\t  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n    53\t    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n    54\t    expect(key).toContain(\"resp_7\");\n    55\t  });\n    56\t\n    57\t  it(\"falls to content plus a stable discriminator as last resort\", () => {\n    58\t    const a = eventKey({ piSessionId: \"s\", fallbackId: \"entry-a\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    59\t    const aAgain = eventKey({ piSessionId: \"s\", fallbackId: \"entry-a\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    60\t    const b = eventKey({ piSessionId: \"s\", fallbackId: \"entry-b\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    61\t    expect(aAgain).toBe(a);\n    62\t    expect(b).not.toBe(a);\n    63\t  });\n    64\t\n    65\t  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n    66\t    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n    67\t    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n    68\t    expect(withBoth).toBe(entryOnly);\n    69\t  });\n    70\t\n    71\t  it(\"uses caller-supplied source position fallback for same-content no-entry messages\", () => {\n    72\t    const first = mapMessage(\n    73\t      { role: \"user\", content: [{ type: \"text\", text: \"repeatable prompt\" }] },\n    74\t      { piSessionId: \"s\", fallbackId: \"message_end:10\" },\n    75\t    );\n    76\t    const firstReload = mapMessage(\n    77\t      { role: \"user\", content: [{ type: \"text\", text: \"repeatable prompt\" }] },\n    78\t      { piSessionId: \"s\", fallbackId: \"message_end:10\" },\n    79\t    );\n    80\t    const second = mapMessage(\n    81\t      { role: \"user\", content: [{ type: \"text\", text: \"repeatable prompt\" }] },\n    82\t      { piSessionId: \"s\", fallbackId: \"message_end:11\" },\n    83\t    );\n    84\t\n    85\t    expect(firstReload[0]!.idempotencyKey).toBe(first[0]!.idempotencyKey);\n    86\t    expect(second[0]!.idempotencyKey).not.toBe(first[0]!.idempotencyKey);\n    87\t  });\n    88\t\n    89\t  it(\"uses caller-supplied source position fallback for repeated identical runtime changes\", () => {\n    90\t    const event = { model: { provider: \"openai\", id: \"gpt-4o\" } };\n    91\t    const first = mapModelSelect(event, { piSessionId: \"s\", fallbackId: \"model_select:20\" });\n    92\t    const firstReload = mapModelSelect(event, { piSessionId: \"s\", fallbackId: \"model_select:20\" });\n    93\t    const second = mapModelSelect(event, { piSessionId: \"s\", fallbackId: \"model_select:21\" });\n    94\t\n    95\t    expect(firstReload.idempotencyKey).toBe(first.idempotencyKey);\n    96\t    expect(second.idempotencyKey).not.toBe(first.idempotencyKey);\n    97\t  });\n    98\t});\n    99\t\n   100\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n   101\t  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n   102\t  const events: MessageEventInput[] = [];\n   103\t  source.forEach((message, index) => {\n   104\t    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n   105\t    acc.onMessage(mapped);\n   106\t    events.push(...mapped);\n   107\t  });\n   108\t  events.push(...acc.onAgentEnd());\n   109\t  return events;\n   110\t}\n   111\t\n   112\tdescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n   113\t  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n   114\t    const thread = await makeTempThread(store);\n   115\t    const built = await initInstance(thread.threadRef, {\n   116\t      provider: createDeterministicProvider(),\n   117\t      mode: \"background\",\n   118\t    });\n   119\t    expect(built.ok).toBe(true);\n   120\t    if (!built.ok) return;\n   121\t    const instance = built.value;\n   122\t\n   123\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n   124\t\n   125\t    const first = await capture(batch, instance);\n   126\t    expect(first.ok).toBe(true);\n   127\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   128\t\n   129\t    const replay = await capture(batch, instance);\n   130\t    expect(replay.ok).toBe(true);\n   131\t    if (replay.ok) {\n   132\t      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   133\t    }\n   134\t\n   135\t    const read = await intakeStream.listEvents(instance.threadRef);\n   136\t    expect(read.ok).toBe(true);\n   137\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   138\t\n   139\t    await instance.dispose();\n   140\t  });\n   141\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/abort.test.ts | sed -n '1,120p'\"","aggregated_output":"     1\t// Story 2 — graceful interrupt (TC-2.6). A turn PI marks aborted is captured\n     2\t// whole: the partial assistant content is recorded, the aborted disposition is\n     3\t// carried through (the mapper carries stopReason — research §5b — onto the only\n     4\t// durable vehicle, a runtime_note), and the turn closes complete-but-aborted at\n     5\t// agent_end. The interrupted content is never discarded.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport type { MessageEventInput } from \"lhc\";\n     8\timport {\n     9\t  makeAgentEnd,\n    10\t  makeAssistantMessage,\n    11\t  makeMessageEnd,\n    12\t  makeUserMessage,\n    13\t} from \"../fixtures/synthetic.js\";\n    14\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    15\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    16\t\n    17\tlet store: TempStore;\n    18\tbeforeEach(() => {\n    19\t  store = tempStore();\n    20\t});\n    21\tafterEach(() => {\n    22\t  store.cleanup();\n    23\t});\n    24\t\n    25\tfunction textOf(event: MessageEventInput): string {\n    26\t  return (event.payload as { text?: string }).text ?? \"\";\n    27\t}\n    28\t\n    29\tdescribe(\"Story 2: graceful interrupt (TC-2.6)\", () => {\n    30\t  it(\"records partial assistant content, carries the aborted disposition, and closes the turn complete-but-aborted\", async () => {\n    31\t    const started = await startCapture(store);\n    32\t    const { connector, ctx, threadRef } = started;\n    33\t\n    34\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"write a long essay\")));\n    35\t    await connector.handlers.message_end(\n    36\t      ctx,\n    37\t      makeMessageEnd(\n    38\t        makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    39\t      ),\n    40\t    );\n    41\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    42\t\n    43\t    // A graceful interrupt is not a capture failure.\n    44\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n    45\t\n    46\t    const events = await eventsAfterShutdown(started);\n    47\t    expect(kindsOf(events)).toEqual([\n    48\t      \"user_prompt\",\n    49\t      \"assistant_thinking\",\n    50\t      \"assistant_text\",\n    51\t      \"runtime_note\",\n    52\t      \"turn_end\",\n    53\t    ]);\n    54\t\n    55\t    // Partial content is preserved verbatim — nothing discarded.\n    56\t    expect(textOf(events[1]!)).toBe(\"starting the essay\");\n    57\t    expect(textOf(events[2]!)).toBe(\"Once upon a\");\n    58\t    // The aborted disposition is carried through on the runtime_note.\n    59\t    expect(textOf(events[3]!).toLowerCase()).toContain(\"abort\");\n    60\t\n    61\t    // The turn closes complete-but-aborted (closed at agent_end, not left open).\n    62\t    const counts = await turnCounts(threadRef);\n    63\t    expect(counts.closed).toBe(1);\n    64\t    expect(counts.open).toBe(0);\n    65\t  });\n    66\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/reattach-idempotency.test.ts | sed -n '1,360p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/reattach-idempotency.test.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Story 2 — SV-001 regression: existing-thread resume/reload must keep recording\n     2\t// new finalized events. The connector seeds its capture counters from the\n     3\t// thread's durable committed state at attach, so a fresh connector's idempotency\n     4\t// keys continue past the prior session's instead of restarting at 0 and\n     5\t// skipping new events as false duplicates — while the converter's same-key\n     6\t// dedup (the reload/replay safety net) stays intact.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  createDeterministicProvider,\n    10\t  intakeStream,\n    11\t  type MessageEventInput,\n    12\t  type ThreadRef,\n    13\t} from \"lhc\";\n    14\timport { capture } from \"../../src/capture/converter.js\";\n    15\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    16\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    17\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    18\timport {\n    19\t  makeAgentEnd,\n    20\t  makeAssistantMessage,\n    21\t  makeMessageEnd,\n    22\t  makeUserMessage,\n    23\t} from \"../fixtures/synthetic.js\";\n    24\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    25\timport { attachCapture, eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    26\t\n    27\tlet store: TempStore;\n    28\tbeforeEach(() => {\n    29\t  store = tempStore();\n    30\t});\n    31\tafterEach(() => {\n    32\t  store.cleanup();\n    33\t});\n    34\t\n    35\tfunction textOf(event: MessageEventInput): string {\n    36\t  return (event.payload as { text?: string }).text ?? \"\";\n    37\t}\n    38\t\n    39\tfunction userTexts(events: readonly MessageEventInput[]): string[] {\n    40\t  return events.filter((event) => event.eventKind === \"user_prompt\").map(textOf);\n    41\t}\n    42\t\n    43\tfunction threadIdOf(ref: ThreadRef): string {\n    44\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n    45\t  return ref.threadId;\n    46\t}\n    47\t\n    48\tdescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n    49\t  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n    50\t    // Session A records one exchange, then shuts down.\n    51\t    const a = await startCapture(store);\n    52\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    53\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    54\t    const threadId = threadIdOf(a.threadRef);\n    55\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n    56\t\n    57\t    // A brand-new connector attaches to the SAME thread by id and records a new\n    58\t    // message — it must NOT be skipped as a prior-key collision.\n    59\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n    60\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    61\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n    62\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    63\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    64\t\n    65\t    const events = await eventsAfterShutdown(b);\n    66\t    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n    67\t    const counts = await turnCounts(b.threadRef);\n    68\t    expect(counts.closed).toBe(2);\n    69\t  });\n    70\t\n    71\t  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n    72\t    const a = await startCapture(store);\n    73\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    74\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    75\t    const threadId = threadIdOf(a.threadRef);\n    76\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    77\t\n    78\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    79\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after reload\")));\n    80\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    81\t\n    82\t    const events = await eventsAfterShutdown(b);\n    83\t    expect(userTexts(events)).toEqual([\"first\", \"second after reload\"]);\n    84\t    const counts = await turnCounts(b.threadRef);\n    85\t    expect(counts.closed).toBe(2);\n    86\t  });\n    87\t\n    88\t  it(\"(2b) a reload re-delivering the same logical events skips them instead of recording duplicates\", async () => {\n    89\t    const a = await startCapture(store);\n    90\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\"), \"entry-user-1\"));\n    91\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    92\t    const threadId = threadIdOf(a.threadRef);\n    93\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    94\t\n    95\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    96\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"first\"), \"entry-user-1\"));\n    97\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    98\t\n    99\t    const events = await eventsAfterShutdown(b);\n   100\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"turn_end\"]);\n   101\t    expect(userTexts(events)).toEqual([\"first\"]);\n   102\t    const counts = await turnCounts(b.threadRef);\n   103\t    expect(counts.closed).toBe(1);\n   104\t\n   105\t    const built = await initInstance(b.threadRef, {\n   106\t      provider: createDeterministicProvider(),\n   107\t      mode: \"background\",\n   108\t    });\n   109\t    expect(built.ok).toBe(true);\n   110\t    if (!built.ok) return;\n   111\t    const instance = built.value;\n   112\t    const acc = new TurnAccumulator({ piSessionId: threadId });\n   113\t    const userEvents = mapMessage(makeUserMessage(\"first\"), {\n   114\t      piSessionId: threadId,\n   115\t      entryId: \"entry-user-1\",\n   116\t    });\n   117\t    acc.onMessage(userEvents);\n   118\t    const turnEnd = acc.onAgentEnd();\n   119\t    const replay = await capture([...userEvents, ...turnEnd], instance);\n   120\t    expect(replay.ok).toBe(true);\n   121\t    if (replay.ok) {\n   122\t      expect(replay.value.events).toEqual([\n   123\t        {\n   124\t          idempotencyKey: userEvents[0]!.idempotencyKey,\n   125\t          outcome: \"skipped\",\n   126\t          skipReason: \"duplicate_idempotency_key\",\n   127\t        },\n   128\t        {\n   129\t          idempotencyKey: turnEnd[0]!.idempotencyKey,\n   130\t          outcome: \"skipped\",\n   131\t          skipReason: \"duplicate_idempotency_key\",\n   132\t        },\n   133\t      ]);\n   134\t    }\n   135\t    await instance.dispose();\n   136\t  });\n   137\t\n   138\t  it(\"(3) normal resume records new messages and does not duplicate the prior session's history\", async () => {\n   139\t    // Session A: one complete turn.\n   140\t    const a = await startCapture(store);\n   141\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n   142\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer one\" })));\n   143\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   144\t    const threadId = threadIdOf(a.threadRef);\n   145\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n   146\t\n   147\t    // Resume: PI does not re-fire history, so the connector sees only the new\n   148\t    // turn — which must record, leaving the prior turn intact and un-duplicated.\n   149\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n   150\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second\")));\n   151\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer two\" })));\n   152\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   153\t\n   154\t    const events = await eventsAfterShutdown(b);\n   155\t    expect(kindsOf(events)).toEqual([\n   156\t      \"user_prompt\",\n   157\t      \"assistant_text\",\n   158\t      \"turn_end\",\n   159\t      \"user_prompt\",\n   160\t      \"assistant_text\",\n   161\t      \"turn_end\",\n   162\t    ]);\n   163\t    expect(userTexts(events)).toEqual([\"first\", \"second\"]);\n   164\t    // Two distinct closed turns — the turn_end keys did not collide either.\n   165\t    const counts = await turnCounts(b.threadRef);\n   166\t    expect(counts.closed).toBe(2);\n   167\t    expect(counts.open).toBe(0);\n   168\t  });\n   169\t\n   170\t  it(\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\", async () => {\n   171\t    const thread = await makeTempThread(store);\n   172\t    const built = await initInstance(thread.threadRef, {\n   173\t      provider: createDeterministicProvider(),\n   174\t      mode: \"background\",\n   175\t    });\n   176\t    expect(built.ok).toBe(true);\n   177\t    if (!built.ok) return;\n   178\t    const instance = built.value;\n   179\t\n   180\t    // Build one turn's events with stable keys, then deliver the SAME batch\n   181\t    // twice — the second delivery (the reload / crash-replay shape) must dedup.\n   182\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   183\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n   184\t    acc.onMessage(userEvents);\n   185\t    const batch = [...userEvents, ...acc.onAgentEnd()];\n   186\t\n   187\t    const first = await capture(batch, instance);\n   188\t    expect(first.ok).toBe(true);\n   189\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   190\t\n   191\t    const second = await capture(batch, instance);\n   192\t    expect(second.ok).toBe(true);\n   193\t    if (second.ok) expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   194\t\n   195\t    const read = await intakeStream.listEvents(instance.threadRef);\n   196\t    expect(read.ok).toBe(true);\n   197\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   198\t\n   199\t    await instance.dispose();\n   200\t  });\n   201\t\n   202\t  it(\"(5) records two distinct same-content user prompts when PI provides distinct entry ids\", async () => {\n   203\t    const started = await startCapture(store);\n   204\t\n   205\t    await started.connector.handlers.message_end(\n   206\t      started.ctx,\n   207\t      makeMessageEnd(makeUserMessage(\"repeatable prompt\"), \"entry-repeat-1\"),\n   208\t    );\n   209\t    await started.connector.handlers.agent_end(started.ctx, makeAgentEnd([]));\n   210\t    await started.connector.handlers.message_end(\n   211\t      started.ctx,\n   212\t      makeMessageEnd(makeUserMessage(\"repeatable prompt\"), \"entry-repeat-2\"),\n   213\t    );\n   214\t    await started.connector.handlers.agent_end(started.ctx, makeAgentEnd([]));\n   215\t\n   216\t    const events = await eventsAfterShutdown(started);\n   217\t    expect(userTexts(events)).toEqual([\"repeatable prompt\", \"repeatable prompt\"]);\n   218\t    expect(events.filter((event) => event.eventKind === \"user_prompt\").map((event) => event.idempotencyKey)).toEqual([\n   219\t      expect.stringContaining(\"entry-repeat-1\"),\n   220\t      expect.stringContaining(\"entry-repeat-2\"),\n   221\t    ]);\n   222\t    const counts = await turnCounts(started.threadRef);\n   223\t    expect(counts.closed).toBe(2);\n   224\t  });\n   225\t\n   226\t  it(\"(6) skips a same-entry re-delivery after reload by duplicate_idempotency_key\", async () => {\n   227\t    const a = await startCapture(store);\n   228\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"reload replay\"), \"entry-replay-1\"));\n   229\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   230\t    const threadId = threadIdOf(a.threadRef);\n   231\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n   232\t\n   233\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n   234\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"reload replay\"), \"entry-replay-1\"));\n   235\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   236\t\n   237\t    const events = await eventsAfterShutdown(b);\n   238\t    expect(userTexts(events)).toEqual([\"reload replay\"]);\n   239\t\n   240\t    const built = await initInstance(b.threadRef, {\n   241\t      provider: createDeterministicProvider(),\n   242\t      mode: \"background\",\n   243\t    });\n   244\t    expect(built.ok).toBe(true);\n   245\t    if (!built.ok) return;\n   246\t    const instance = built.value;\n   247\t    const acc = new TurnAccumulator({ piSessionId: threadId });\n   248\t    const userEvents = mapMessage(makeUserMessage(\"reload replay\"), {\n   249\t      piSessionId: threadId,\n   250\t      entryId: \"entry-replay-1\",\n   251\t    });\n   252\t    acc.onMessage(userEvents);\n   253\t    const turnEnd = acc.onAgentEnd();\n   254\t    const replay = await capture([...userEvents, ...turnEnd], instance);\n   255\t    expect(replay.ok).toBe(true);\n   256\t    if (replay.ok) {\n   257\t      expect(replay.value.events.every((entry) => entry.skipReason === \"duplicate_idempotency_key\")).toBe(true);\n   258\t    }\n   259\t    await instance.dispose();\n   260\t  });\n   261\t\n   262\t  it(\"(7) records distinct same-content no-entry prompts by PI source position, and skips reload re-delivery of the same position\", async () => {\n   263\t    const a = await startCapture(store);\n   264\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"same text\"), undefined, 40));\n   265\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   266\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"same text\"), undefined, 41));\n   267\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   268\t    const threadId = threadIdOf(a.threadRef);\n   269\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n   270\t\n   271\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n   272\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"same text\"), undefined, 40));\n   273\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   274\t\n   275\t    const events = await eventsAfterShutdown(b);\n   276\t    expect(userTexts(events)).toEqual([\"same text\", \"same text\"]);\n   277\t    const promptKeys = events\n   278\t      .filter((event) => event.eventKind === \"user_prompt\")\n   279\t      .map((event) => event.idempotencyKey);\n   280\t    expect(promptKeys).toHaveLength(2);\n   281\t    expect(promptKeys[0]).toContain(\"message_end:40\");\n   282\t    expect(promptKeys[1]).toContain(\"message_end:41\");\n   283\t    expect(promptKeys[0]).not.toBe(promptKeys[1]);\n   284\t  });\n   285\t\n   286\t  it(\"(8) skips reload re-delivery of the same no-entry/no-position prompt by connector source order\", async () => {\n   287\t    const a = await startCapture(store);\n   288\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"source-order replay\")));\n   289\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   290\t    const threadId = threadIdOf(a.threadRef);\n   291\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n   292\t\n   293\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n   294\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"source-order replay\")));\n   295\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   296\t\n   297\t    const events = await eventsAfterShutdown(b);\n   298\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"turn_end\"]);\n   299\t    expect(userTexts(events)).toEqual([\"source-order replay\"]);\n   300\t    const promptKeys = events\n   301\t      .filter((event) => event.eventKind === \"user_prompt\")\n   302\t      .map((event) => event.idempotencyKey);\n   303\t    expect(promptKeys).toEqual([expect.stringContaining(\"message_end:sourceSeq:0\")]);\n   304\t    const counts = await turnCounts(b.threadRef);\n   305\t    expect(counts.closed).toBe(1);\n   306\t  });\n   307\t});\n","exit_code":0,"status":"completed"}}

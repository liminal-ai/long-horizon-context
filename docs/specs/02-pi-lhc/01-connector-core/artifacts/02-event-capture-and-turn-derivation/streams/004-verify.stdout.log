{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/map-message.ts'","aggregated_output":"     1\timport type { EventKind, MessageEventInput } from \"lhc\";\n     2\timport type {\n     3\t  AgentMessage,\n     4\t  AssistantMessage,\n     5\t  ContentPart,\n     6\t  FileRefPart,\n     7\t  ImagePart,\n     8\t  ToolResultMessage,\n     9\t  UserMessage,\n    10\t} from \"../pi/types.js\";\n    11\timport { eventKey } from \"./idempotency.js\";\n    12\t\n    13\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n    14\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n    15\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n    16\t// present) → one `tool_call` per call, in that order; a tool result → one\n    17\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n    18\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n    19\t// drop, tech design I-6). A graceful interrupt carries its disposition through\n    20\t// on a trailing `runtime_note` (research §5b).\n    21\t\n    22\texport interface MapCtx {\n    23\t  piSessionId: string;\n    24\t  entryId?: string;\n    25\t}\n    26\t\n    27\tconst HARNESS = \"pi\";\n    28\t\n    29\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n    30\t *  field to hold its disposition, so the mapper carries `stopReason` through on\n    31\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n    32\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\n    33\texport const ABORTED_DISPOSITION_TEXT =\n    34\t  \"turn aborted (stopReason: aborted) — partial content preserved\";\n    35\t\n    36\tconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n    37\t\n    38\tfunction textOf(parts: ContentPart[]): string {\n    39\t  return parts\n    40\t    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n    41\t    .map((p) => p.text)\n    42\t    .join(\"\");\n    43\t}\n    44\t\n    45\tfunction thinkingOf(parts: ContentPart[]): string {\n    46\t  return parts\n    47\t    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n    48\t    .map((p) => p.thinking)\n    49\t    .join(\"\");\n    50\t}\n    51\t\n    52\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n    53\t  return parts.filter(\n    54\t    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n    55\t  );\n    56\t}\n    57\t\n    58\tfunction omissionText(part: ImagePart | FileRefPart): string {\n    59\t  return part.type === \"image\"\n    60\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n    61\t    : `unsupported content omitted: file reference (${part.path})`;\n    62\t}\n    63\t\n    64\tfunction buildKey(\n    65\t  ctx: MapCtx,\n    66\t  role: string,\n    67\t  kind: EventKind,\n    68\t  blockIndex: number,\n    69\t  opts: { toolCallId?: string; content?: string } = {},\n    70\t): string {\n    71\t  return eventKey({\n    72\t    piSessionId: ctx.piSessionId,\n    73\t    entryId: ctx.entryId,\n    74\t    blockIndex,\n    75\t    kind,\n    76\t    role,\n    77\t    toolCallId: opts.toolCallId,\n    78\t    content: opts.content,\n    79\t  });\n    80\t}\n    81\t\n    82\t// Per-kind builders — explicit eventKind literals so the discriminated union\n    83\t// narrows without a cast.\n    84\tfunction textEvent(\n    85\t  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n    86\t  text: string,\n    87\t  actor: string,\n    88\t  key: string,\n    89\t): MessageEventInput {\n    90\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n    91\t}\n    92\t\n    93\tfunction toolCallEvent(\n    94\t  toolCallId: string,\n    95\t  toolName: string,\n    96\t  args: Record<string, unknown>,\n    97\t  key: string,\n    98\t): MessageEventInput {\n    99\t  return {\n   100\t    eventKind: \"tool_call\",\n   101\t    idempotencyKey: key,\n   102\t    actor: \"assistant\",\n   103\t    harness: HARNESS,\n   104\t    payload: { toolCallId, toolName, arguments: args },\n   105\t  };\n   106\t}\n   107\t\n   108\tfunction toolResultEvent(\n   109\t  toolCallId: string,\n   110\t  content: string,\n   111\t  isError: boolean,\n   112\t  key: string,\n   113\t): MessageEventInput {\n   114\t  return {\n   115\t    eventKind: \"tool_result\",\n   116\t    idempotencyKey: key,\n   117\t    actor: \"tool\",\n   118\t    harness: HARNESS,\n   119\t    payload: { toolCallId, content, isError },\n   120\t  };\n   121\t}\n   122\t\n   123\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n   124\t  const events: MessageEventInput[] = [];\n   125\t  let block = 0;\n   126\t  if (msg.content.some((p) => p.type === \"text\")) {\n   127\t    const text = textOf(msg.content);\n   128\t    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { content: text })));\n   129\t    block += 1;\n   130\t  }\n   131\t  for (const part of unsupportedOf(msg.content)) {\n   132\t    const text = omissionText(part);\n   133\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: text })));\n   134\t    block += 1;\n   135\t  }\n   136\t  if (events.length === 0) {\n   137\t    events.push(\n   138\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: \"empty:user\" })),\n   139\t    );\n   140\t  }\n   141\t  return events;\n   142\t}\n   143\t\n   144\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n   145\t  const events: MessageEventInput[] = [];\n   146\t  let block = 0;\n   147\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n   148\t  if (msg.content.some((p) => p.type === \"thinking\")) {\n   149\t    const text = thinkingOf(msg.content);\n   150\t    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { content: text })));\n   151\t    block += 1;\n   152\t  }\n   153\t  if (msg.content.some((p) => p.type === \"text\")) {\n   154\t    const text = textOf(msg.content);\n   155\t    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { content: text })));\n   156\t    block += 1;\n   157\t  }\n   158\t  for (const part of msg.content) {\n   159\t    if (part.type !== \"toolCall\") continue;\n   160\t    events.push(\n   161\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { toolCallId: part.id, content: part.name })),\n   162\t    );\n   163\t    block += 1;\n   164\t  }\n   165\t  for (const part of unsupportedOf(msg.content)) {\n   166\t    const text = omissionText(part);\n   167\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: text })));\n   168\t    block += 1;\n   169\t  }\n   170\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\n   171\t  if (msg.stopReason === \"aborted\") {\n   172\t    events.push(\n   173\t      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: ABORTED_DISPOSITION_TEXT })),\n   174\t    );\n   175\t    block += 1;\n   176\t  }\n   177\t  if (events.length === 0) {\n   178\t    events.push(\n   179\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: \"empty:assistant\" })),\n   180\t    );\n   181\t  }\n   182\t  return events;\n   183\t}\n   184\t\n   185\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n   186\t  const content = textOf(msg.content);\n   187\t  const isError = msg.isError === true;\n   188\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n   189\t  // and content are always captured, even on failure (AC-2.4).\n   190\t  return [\n   191\t    toolResultEvent(\n   192\t      msg.toolCallId,\n   193\t      content,\n   194\t      isError,\n   195\t      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { toolCallId: msg.toolCallId, content }),\n   196\t    ),\n   197\t  ];\n   198\t}\n   199\t\n   200\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n   201\t  switch (msg.role) {\n   202\t    case \"user\":\n   203\t      return mapUser(msg, ctx);\n   204\t    case \"assistant\":\n   205\t      return mapAssistant(msg, ctx);\n   206\t    case \"toolResult\":\n   207\t      return mapToolResult(msg, ctx);\n   208\t  }\n   209\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/lifecycle/state.ts'","aggregated_output":"     1\timport type { ThreadRef } from \"lhc\";\n     2\timport type { ValidationReport } from \"../shared/diagnostics.js\";\n     3\t\n     4\t// AC-1.3 / AC-2.7. This module is COMPLETE, not stubbed (story Technical\n     5\t// Notes): its shape is what prevents stale PI-context retention later. The\n     6\t// holder has no slot for a PI ctx/session object, so retaining one across hooks\n     7\t// is impossible in normal use — the structural enforcement the tech arch's\n     8\t// plain-data-only rule calls for.\n     9\t\n    10\t/** Recorded when a writable-thread capture fails: the failure degrades to a\n    11\t *  durable, queryable gap rather than throwing into a PI hook (AC-2.7). */\n    12\texport interface CaptureFailureDiagnostic {\n    13\t  code: string;\n    14\t  eventKey?: string;\n    15\t  message: string;\n    16\t  recordedGap: boolean;\n    17\t}\n    18\t\n    19\t/** The connector's entire retained state between PI hooks: a thread reference,\n    20\t *  told-the-user flags, and health diagnostics — ALL plain data. Everything\n    21\t *  stored here must survive `structuredClone` (no functions, no class\n    22\t *  instances, no PI objects). */\n    23\texport interface SessionState {\n    24\t  threadRef: ThreadRef;\n    25\t  flags: {\n    26\t    startupValidationReported: boolean;\n    27\t    [k: string]: boolean;\n    28\t  };\n    29\t  health: {\n    30\t    lastCaptureFailure?: CaptureFailureDiagnostic;\n    31\t    startupValidation?: ValidationReport;\n    32\t  };\n    33\t}\n    34\t\n    35\t/** Build the initial plain-data holder for a resolved thread. */\n    36\texport function createSessionState(threadRef: ThreadRef): SessionState {\n    37\t  return {\n    38\t    threadRef,\n    39\t    flags: { startupValidationReported: false },\n    40\t    health: {},\n    41\t  };\n    42\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/lifecycle/thread-resolution.ts | sed -n '1,220p'\"","aggregated_output":"     1\timport { basename } from \"node:path\";\n     2\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n     3\t\n     4\t// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n     5\t// it (tech design Flow 1). PI's own session file still exists in this\n     6\t// observe-only epic — it is just not where thread identity lives.\n     7\t\n     8\t/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n     9\t *  before this resolver — see `picker.ts`.) */\n    10\texport interface LaunchFlags {\n    11\t  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n    12\t  continue?: boolean; // --continue / -c : most recent\n    13\t  session?: string; // --session <id> : full or partial id\n    14\t}\n    15\t\n    16\t/** What the resolver needs from the host beyond the launch flags: the cwd a new\n    17\t *  thread is registered under, the registry to resolve through, and where a new\n    18\t *  thread's file is created. Injected so the resolver is exercised against a\n    19\t *  real temp registry in tests and the default `~/.lhc` registry in production —\n    20\t *  `registryPath` is a per-operation argument, never an `initLhc` config field\n    21\t *  (tech design Technical Notes). */\n    22\texport interface ResolveDeps {\n    23\t  cwd: string;\n    24\t  registryPath?: string;\n    25\t  newThreadFilePath: () => string;\n    26\t  /** Title for a newly created thread (A-8 title metadata). Defaults to\n    27\t   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\n    28\t   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\n    29\t   *  title from the first prompt — the open TDQ Q4). */\n    30\t  newThreadTitle?: string;\n    31\t}\n    32\t\n    33\t/** The creation-time title for a new thread when the host supplies none. At\n    34\t *  session_start there is no first prompt yet, so the title is the cwd's leaf\n    35\t *  directory name — a real, non-empty project label the `--resume` picker shows\n    36\t *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\n    37\texport function defaultThreadTitle(cwd: string): string {\n    38\t  const leaf = basename(cwd);\n    39\t  if (leaf !== \"\") return leaf;\n    40\t  return cwd !== \"\" ? cwd : \"lhc session\";\n    41\t}\n    42\t\n    43\t/** The durable, plain-data thread reference the connector retains and\n    44\t *  reattaches from: a thread id (plus the registry it lives in), not a live\n    45\t *  object. `{ filePath }` is avoided so reload reconstructs by id. */\n    46\texport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n    47\t  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n    48\t}\n    49\t\n    50\t/** Spread `registryPath` into an LHC threads-call options object only when it is\n    51\t *  set, so an unset registry path falls through to LHC's default rather than\n    52\t *  being passed as an explicit `undefined` (rejected under\n    53\t *  exactOptionalPropertyTypes). */\n    54\texport function registryArg(registryPath?: string): { registryPath?: string } {\n    55\t  return registryPath === undefined ? {} : { registryPath };\n    56\t}\n    57\t\n    58\t/** Resolve the recording thread from the launch input (AC-1.6):\n    59\t *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n    60\t *    ambiguous fails loud (the registry returns `thread_not_found` /\n    61\t *    `ambiguous_thread_id`) and never silently creates a thread.\n    62\t *  - `--continue`: the most recently created thread.\n    63\t *  - no flag: a new thread, registered with its cwd (AC-1.1).\n    64\t *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n    65\t *  durable id rather than a retained object (AC-1.5). */\n    66\texport async function resolveThread(\n    67\t  launch: LaunchFlags,\n    68\t  deps: ResolveDeps,\n    69\t): Promise<OpResult<ThreadRef>> {\n    70\t  if (launch.session !== undefined) {\n    71\t    const resolved = await threads.resolve({\n    72\t      threadId: launch.session,\n    73\t      ...registryArg(deps.registryPath),\n    74\t    });\n    75\t    if (!resolved.ok) return resolved;\n    76\t    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n    77\t  }\n    78\t\n    79\t  if (launch.continue === true) {\n    80\t    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n    81\t    if (!listed.ok) return listed;\n    82\t    // The registry lists in creation order with an insertion-order tie-break,\n    83\t    // so the last row is the most recently created thread.\n    84\t    const mostRecent = listed.value.at(-1);\n    85\t    if (mostRecent === undefined) {\n    86\t      return {\n    87\t        ok: false,\n    88\t        error: {\n    89\t          errorClass: \"caller_error\",\n    90\t          code: \"thread_not_found\",\n    91\t          reason: \"--continue: no threads exist to continue\",\n    92\t        },\n    93\t      };\n    94\t    }\n    95\t    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n    96\t  }\n    97\t\n    98\t  const created = await threads.newThread({\n    99\t    filePath: deps.newThreadFilePath(),\n   100\t    cwd: deps.cwd,\n   101\t    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\n   102\t    ...registryArg(deps.registryPath),\n   103\t  });\n   104\t  if (!created.ok) return created;\n   105\t  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n   106\t}\n   107\t\n   108\t/** Reload reconstruction (AC-1.5): on reload — the extension torn down and\n   109\t *  re-initialized while the same PI session continues — re-resolve the session's\n   110\t *  thread from DURABLE registry state. It reads no retained in-process memory and\n   111\t *  never creates a new thread or re-prompts a picker; the resolved id comes back\n   112\t *  out of the registry (the durable catalog), so reconstruction survives the loss\n   113\t *  of every in-memory holder (the architecture-risk scenario).\n   114\t *\n   115\t *  - `--session <id>` / `--continue`: re-resolve by the same durable launch input.\n   116\t *    Both are idempotent — resolving twice returns the same thread and creates\n   117\t *    nothing — so the normal resolver already reattaches correctly.\n   118\t *  - no flag or `--resume`: reattach to the cwd's most-recently-created thread,\n   119\t *    read from the registry. A no-flag Story-1 session created exactly one thread\n   120\t *    in its cwd, so that is the thread; re-running the launch instead would create\n   121\t *    a duplicate (no flag) or re-prompt the operator (`--resume`).\n   122\t *\n   123\t *  Returns `null` when the cwd has no thread to reattach (a reload against an\n   124\t *  empty registry); the caller records a diagnostic rather than creating one.\n   125\t *\n   126\t *  This is the answer to \"where does the durable reload id live without a\n   127\t *  PI-session→thread mapping record\" (epic I-1): it lives in the LHC registry,\n   128\t *  the system of record, not in a connector field or a recovery sidecar. The\n   129\t *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n   130\t *  reload/fork lineage is LHC thread metadata (Feature 2+). */\n   131\texport async function resolveReloadThread(\n   132\t  launch: LaunchFlags,\n   133\t  deps: ResolveDeps,\n   134\t): Promise<OpResult<ThreadRef | null>> {\n   135\t  if (launch.session !== undefined) {\n   136\t    return resolveThread({ session: launch.session }, deps);\n   137\t  }\n   138\t  if (launch.continue === true) {\n   139\t    return resolveThread({ continue: true }, deps);\n   140\t  }\n   141\t  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n   142\t  if (!listed.ok) return listed;\n   143\t  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n   144\t  // the most recently created thread for this directory.\n   145\t  const mostRecent = listed.value.at(-1);\n   146\t  if (mostRecent === undefined) return { ok: true, value: null };\n   147\t  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n   148\t}\n   149\t\n   150\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n   151\t *  so PI's launch arguments are visible on `process.argv`; this is the\n   152\t *  production source of the launch mode. Supports `--session <id>`,\n   153\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n   154\t *  spelling for the named-session mode is an integration detail to confirm\n   155\t *  against PI; see the story payload's open questions.) */\n   156\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n   157\t  const flags: LaunchFlags = {};\n   158\t  for (let i = 0; i < argv.length; i += 1) {\n   159\t    const arg = argv[i];\n   160\t    if (arg === undefined) continue;\n   161\t    if (arg === \"--resume\" || arg === \"-r\") {\n   162\t      flags.resume = true;\n   163\t    } else if (arg === \"--continue\" || arg === \"-c\") {\n   164\t      flags.continue = true;\n   165\t    } else if (arg === \"--session\") {\n   166\t      const next = argv[i + 1];\n   167\t      if (next !== undefined && !next.startsWith(\"-\")) {\n   168\t        flags.session = next;\n   169\t        i += 1;\n   170\t      }\n   171\t    } else if (arg.startsWith(\"--session=\")) {\n   172\t      flags.session = arg.slice(\"--session=\".length);\n   173\t    }\n   174\t  }\n   175\t  return flags;\n   176\t}\n","exit_code":0,"status":"completed"}}

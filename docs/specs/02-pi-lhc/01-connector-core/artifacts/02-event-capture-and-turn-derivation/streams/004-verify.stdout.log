{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/turn-accumulator.ts'","aggregated_output":"     1\timport type { MessageEventInput } from \"lhc\";\n     2\timport { eventKey } from \"./idempotency.js\";\n     3\t\n     4\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n     5\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n     6\t//\n     7\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n     8\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\n     9\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n    10\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n    11\t// no-op on reattach, since a fresh accumulator has no open turn to close.\n    12\t\n    13\texport interface TurnAccumulatorCtx {\n    14\t  piSessionId: string;\n    15\t  actor?: string;\n    16\t  harness?: string;\n    17\t}\n    18\t\n    19\texport class TurnAccumulator {\n    20\t  private readonly piSessionId: string;\n    21\t  private readonly actor: string;\n    22\t  private readonly harness: string;\n    23\t  private open = false;\n    24\t  // A per-session monotonic counter giving each emitted `turn_end` a distinct,\n    25\t  // replay-stable idempotency key (a fresh accumulator on replay restarts it,\n    26\t  // so the same run re-derives the same keys and dedups).\n    27\t  private closedCount = 0;\n    28\t\n    29\t  constructor(ctx: TurnAccumulatorCtx) {\n    30\t    this.piSessionId = ctx.piSessionId;\n    31\t    this.actor = ctx.actor ?? \"system\";\n    32\t    this.harness = ctx.harness ?? \"pi\";\n    33\t  }\n    34\t\n    35\t  /** Open the turn when this message's events include a `user_prompt`. A new\n    36\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n    37\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n    38\t  onMessage(events: MessageEventInput[]): void {\n    39\t    if (events.some((event) => event.eventKind === \"user_prompt\")) {\n    40\t      this.open = true;\n    41\t    }\n    42\t  }\n    43\t\n    44\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n    45\t   *  transition the accumulator drives, and it happens once per agent run. */\n    46\t  onAgentEnd(): MessageEventInput[] {\n    47\t    if (!this.open) return [];\n    48\t    this.open = false;\n    49\t    const key = eventKey({\n    50\t      piSessionId: this.piSessionId,\n    51\t      entryId: `turn:${this.closedCount}`,\n    52\t      blockIndex: 0,\n    53\t      kind: \"turn_end\",\n    54\t    });\n    55\t    this.closedCount += 1;\n    56\t    return [\n    57\t      {\n    58\t        eventKind: \"turn_end\",\n    59\t        idempotencyKey: key,\n    60\t        actor: this.actor,\n    61\t        harness: this.harness,\n    62\t        payload: {},\n    63\t      },\n    64\t    ];\n    65\t  }\n    66\t\n    67\t  hasOpenTurn(): boolean {\n    68\t    return this.open;\n    69\t  }\n    70\t}\n","exit_code":0,"status":"completed"}}

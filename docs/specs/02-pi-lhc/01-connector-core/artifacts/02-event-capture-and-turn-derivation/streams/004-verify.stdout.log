{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '1,250p'\"","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type {\n    11\t  BatchResult,\n    12\t  DerivationProvider,\n    13\t  MessageEventInput,\n    14\t  OpResult,\n    15\t  ProviderResult,\n    16\t  SdkConfig,\n    17\t  ThreadRef,\n    18\t} from \"lhc\";\n    19\timport type {\n    20\t  ExtensionAPI,\n    21\t  ExtensionContext,\n    22\t  PiHookHandler,\n    23\t  PiHookName,\n    24\t} from \"./pi/types.js\";\n    25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    26\timport { createSessionState } from \"./lifecycle/state.js\";\n    27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    28\timport {\n    29\t  parseLaunchFlags,\n    30\t  resolveReloadThread,\n    31\t  resolveThread,\n    32\t  type LaunchFlags,\n    33\t  type ResolveDeps,\n    34\t} from \"./lifecycle/thread-resolution.js\";\n    35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    36\timport { capture } from \"./capture/converter.js\";\n    37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n    38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n    39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n    40\timport type { LhcInstance } from \"./shared/instance.js\";\n    41\t\n    42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    43\texport type { LhcInstance } from \"./shared/instance.js\";\n    44\t\n    45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    47\t *  registers no handler for it (story Scope Out). */\n    48\texport const EPIC_1_HOOKS = [\n    49\t  \"session_start\",\n    50\t  \"message_end\",\n    51\t  \"turn_end\",\n    52\t  \"agent_end\",\n    53\t  \"model_select\",\n    54\t  \"thinking_level_select\",\n    55\t  \"session_before_fork\",\n    56\t  \"session_before_switch\",\n    57\t  \"session_shutdown\",\n    58\t] as const satisfies readonly PiHookName[];\n    59\t\n    60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    61\t\n    62\t/** What the connector needs from the host to run a session. Every dependency\n    63\t *  has a working production default; the overrides exist for test isolation\n    64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n    65\t *  in the PI-auth-backed inference config.\n    66\t *\n    67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n    68\t *  default is the observe-only config below (a real, construction-valid SDK);\n    69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n    70\texport interface ConnectorDeps {\n    71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    72\t  registryPath?: string;\n    73\t  newThreadFilePath?: () => string;\n    74\t  parseLaunch?: () => LaunchFlags;\n    75\t  selectThread?: (\n    76\t    choices: readonly ThreadChoice[],\n    77\t    ctx: ExtensionContext,\n    78\t  ) => Promise<string | null>;\n    79\t}\n    80\t\n    81\t/** Everything the connector retains across hooks as PLAIN data — by\n    82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    84\t *  deliberately not part of the snapshot. */\n    85\texport interface ConnectorSnapshot {\n    86\t  state: SessionState | null;\n    87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    88\t}\n    89\t\n    90\texport interface Connector {\n    91\t  /** Register the observe-only hook rail on the PI extension API. */\n    92\t  register(pi: ExtensionAPI): void;\n    93\t  /** The plain-data state retained across hooks. `null` until a session\n    94\t   *  resolves a thread; never holds a PI ctx. */\n    95\t  getState(): SessionState | null;\n    96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n    97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n    98\t  getInstance(): LhcInstance | null;\n    99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n   100\t  snapshot(): ConnectorSnapshot;\n   101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   102\t   *  synthetic ctx/events without a live PI. */\n   103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n   104\t}\n   105\t\n   106\t/** The connector's live capture state for one session: the open-turn\n   107\t *  accumulator and a per-session source-event counter (the stable entry index\n   108\t *  that makes idempotency keys replay-safe). Held in the closure alongside the\n   109\t *  live `LhcInstance` — engine state rebuilt per session, never part of the\n   110\t *  plain-data snapshot and never a PI object. */\n   111\tinterface CaptureSession {\n   112\t  piSessionId: string;\n   113\t  accumulator: TurnAccumulator;\n   114\t  sourceSeq: number;\n   115\t}\n   116\t\n   117\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n   118\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   119\t *  same id). */\n   120\tfunction sessionIdOf(ref: ThreadRef): string {\n   121\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   122\t}\n   123\t\n   124\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   125\t\n   126\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n   127\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n   128\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n   129\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n   130\t *  derivation work is ever queued and this provider is never invoked — it exists\n   131\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n   132\t *\n   133\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n   134\t *  documents as \"selectable only by explicit name — never a production default\"\n   135\t *  (it would mark fake derived text into the thread). Failing closed preserves\n   136\t *  the observe-only guarantee even if a future change queued work before Stories\n   137\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n   138\t *  assignments), which is what a real *completing* inference requires (the\n   139\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n   140\tfunction observeOnlyProvider(): DerivationProvider {\n   141\t  const notConfigured = (): Promise<ProviderResult> =>\n   142\t    Promise.resolve({\n   143\t      ok: false,\n   144\t      retryable: false,\n   145\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n   146\t    });\n   147\t  return {\n   148\t    smoothPrompt: notConfigured,\n   149\t    summarizeToolCall: notConfigured,\n   150\t    summarizeToolResult: notConfigured,\n   151\t    composeTurnRendering: notConfigured,\n   152\t    projectLowerBand: notConfigured,\n   153\t    summarizeChunkDetailed: notConfigured,\n   154\t    summarizeChunkBrief: notConfigured,\n   155\t  };\n   156\t}\n   157\t\n   158\t/** The production observe-only SDK config: a real, construction-valid instance\n   159\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n   160\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n   161\t *  config. */\n   162\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n   163\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n   164\t}\n   165\t\n   166\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   167\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   168\t *  show. */\n   169\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   170\t  const lines = choices.map((choice, i) => {\n   171\t    const title = choice.title ?? \"(untitled)\";\n   172\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   173\t  });\n   174\t  return [\n   175\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n   176\t    ...lines,\n   177\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n   178\t  ].join(\"\\n\");\n   179\t}\n   180\t\n   181\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n   182\t *  interactive input/selection surface (wiring research), so the production\n   183\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n   184\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n   185\t *  most recently created thread as the best available explicit default. The\n   186\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n   187\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n   188\t *  A true interactive picker awaits a PI input surface; until then resuming a\n   189\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n   190\t *  precise spec deviation. */\n   191\tfunction defaultSelectThread(\n   192\t  choices: readonly ThreadChoice[],\n   193\t  ctx: ExtensionContext,\n   194\t): Promise<string | null> {\n   195\t  const mostRecent = choices.at(-1);\n   196\t  if (mostRecent === undefined) return Promise.resolve(null);\n   197\t  if (ctx.hasUI) {\n   198\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   199\t  }\n   200\t  return Promise.resolve(mostRecent.threadId);\n   201\t}\n   202\t\n   203\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   204\t *  generated by the registry at creation, so the file name is just a unique\n   205\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   206\t *  parents). */\n   207\tfunction defaultNewThreadFilePath(): string {\n   208\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   209\t  mkdirSync(dir, { recursive: true });\n   210\t  return join(dir, `${randomUUID()}.sqlite`);\n   211\t}\n   212\t\n   213\t/** Build a connector instance. Its mutable state lives in this closure; the\n   214\t *  registered handlers capture it, so the instance stays live for the session\n   215\t *  even when `activate` discards the returned object. The connector holds NO\n   216\t *  module-level or durable state of its own — reload reconstructs the thread from\n   217\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n   218\t *  closure reattaches correctly (AC-1.5). */\n   219\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   220\t  // The connector's retained state. `state` is plain data (the durable thread\n   221\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   222\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n   223\t  // none survives the connector — reload re-resolves from the registry.\n   224\t  let state: SessionState | null = null;\n   225\t  let instance: LhcInstance | null = null;\n   226\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   227\t  let captureSession: CaptureSession | null = null;\n   228\t\n   229\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n   230\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   231\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   232\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n   233\t\n   234\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   235\t    return { code, message, recordedGap: false };\n   236\t  }\n   237\t\n   238\t  // The registry/file deps every resolver path shares. `registryPath` is set\n   239\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n   240\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n   241\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n   242\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n   243\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   244\t    return resolveDeps;\n   245\t  }\n   246\t\n   247\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n   248\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n   249\t  // no-flag creates).\n   250\t  async function resolveForLaunch(\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/package.json'","aggregated_output":"     1\t{\n     2\t  \"name\": \"pi-lhc\",\n     3\t  \"version\": \"0.0.0\",\n     4\t  \"private\": true,\n     5\t  \"description\": \"PI ↔ LHC connector extension (Epic 1: Connector Core, observe-only).\",\n     6\t  \"type\": \"module\",\n     7\t  \"main\": \"./dist/index.js\",\n     8\t  \"types\": \"./dist/index.d.ts\",\n     9\t  \"exports\": {\n    10\t    \".\": {\n    11\t      \"types\": \"./dist/index.d.ts\",\n    12\t      \"import\": \"./dist/index.js\"\n    13\t    }\n    14\t  },\n    15\t  \"files\": [\n    16\t    \"dist\",\n    17\t    \"README.md\"\n    18\t  ],\n    19\t  \"scripts\": {\n    20\t    \"clean\": \"rm -rf dist\",\n    21\t    \"build\": \"pnpm run clean && tsc -p tsconfig.json\",\n    22\t    \"typecheck\": \"tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json\",\n    23\t    \"lint\": \"node scripts/lint.mjs\",\n    24\t    \"boundaries\": \"node scripts/check-boundaries.mjs\",\n    25\t    \"test\": \"vitest run\",\n    26\t    \"red-verify\": \"pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run boundaries\",\n    27\t    \"verify\": \"pnpm run red-verify && vitest run\",\n    28\t    \"green-verify\": \"pnpm run verify && node scripts/check-test-immutability.mjs\",\n    29\t    \"verify-all\": \"pnpm run verify\"\n    30\t  },\n    31\t  \"engines\": {\n    32\t    \"node\": \">=24\"\n    33\t  },\n    34\t  \"dependencies\": {\n    35\t    \"lhc\": \"workspace:*\"\n    36\t  },\n    37\t  \"devDependencies\": {\n    38\t    \"@types/node\": \"^24.12.4\",\n    39\t    \"typescript\": \"^5.9.3\",\n    40\t    \"vitest\": \"^4.1.8\"\n    41\t  }\n    42\t}\n","exit_code":0,"status":"completed"}}

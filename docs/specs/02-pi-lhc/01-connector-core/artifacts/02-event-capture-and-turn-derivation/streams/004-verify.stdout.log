{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/idempotency.ts'","aggregated_output":"     1\timport { createHash } from \"node:crypto\";\n     2\timport type { EventKind } from \"lhc\";\n     3\t\n     4\t// AC-2.6: a stable per-event key so re-delivery dedups and crash-replay is\n     5\t// safe. Pure, deterministic — identical across re-delivery of the same logical\n     6\t// event, distinct across different events. Construction precedence (from the\n     7\t// POC mapper, carried forward): PI entry id, else provider responseId /\n     8\t// toolCallId, else a content fingerprint as last resort. `blockIndex` and\n     9\t// `kind` ride every tier so one message's fan-out (thinking → text →\n    10\t// tool_call×N) stays distinct under a single shared id.\n    11\t\n    12\texport interface EventKeyInput {\n    13\t  piSessionId: string;\n    14\t  // Optionals admit explicit `undefined` so a caller can thread a\n    15\t  // possibly-absent id through directly under exactOptionalPropertyTypes.\n    16\t  entryId?: string | undefined;\n    17\t  responseId?: string | undefined;\n    18\t  toolCallId?: string | undefined;\n    19\t  blockIndex: number;\n    20\t  kind: EventKind;\n    21\t  role?: string | undefined;\n    22\t  timestamp?: number | undefined;\n    23\t  content?: string | undefined;\n    24\t}\n    25\t\n    26\tconst SEP = \"\u0000\";\n    27\t\n    28\t/** A short, stable content fingerprint — the last-resort key tier when an\n    29\t *  event carries no PI/provider id. sha256 truncated: collision-resistant\n    30\t *  enough for dedup, short enough to keep keys readable. */\n    31\texport function fingerprint(...parts: string[]): string {\n    32\t  return createHash(\"sha256\").update(parts.join(SEP)).digest(\"hex\").slice(0, 24);\n    33\t}\n    34\t\n    35\texport function eventKey(input: EventKeyInput): string {\n    36\t  const { piSessionId, entryId, responseId, toolCallId, blockIndex, kind } = input;\n    37\t  // Tier 1 — PI entry id: the most stable identity, present on every real\n    38\t  // finalized message; disambiguated by block + kind for the fan-out.\n    39\t  if (entryId !== undefined && entryId !== \"\") {\n    40\t    return `pi:${piSessionId}:entry:${entryId}:${blockIndex}:${kind}`;\n    41\t  }\n    42\t  // Tier 2 — tool-call id: stable across re-delivery and independent of arrival\n    43\t  // order; kind separates the call from its result under the same id.\n    44\t  if (toolCallId !== undefined && toolCallId !== \"\") {\n    45\t    return `pi:${piSessionId}:tool:${toolCallId}:${kind}`;\n    46\t  }\n    47\t  // Tier 3 — provider response id: stable per assistant response.\n    48\t  if (responseId !== undefined && responseId !== \"\") {\n    49\t    return `pi:${piSessionId}:resp:${responseId}:${blockIndex}:${kind}`;\n    50\t  }\n    51\t  // Tier 4 — content fingerprint: last resort for an event with no id at all.\n    52\t  const fp = fingerprint(input.role ?? \"\", String(input.timestamp ?? \"\"), input.content ?? \"\");\n    53\t  return `pi:${piSessionId}:fp:${blockIndex}:${kind}:${fp}`;\n    54\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/converter.ts'","aggregated_output":"     1\timport type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\n     2\timport type { LhcInstance } from \"../shared/instance.js\";\n     3\timport { fingerprint } from \"./idempotency.js\";\n     4\t\n     5\t// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\n     6\t// isolating capture failure so it never throws back into a PI hook. The two\n     7\t// failure shapes the AC distinguishes key off the SDK's error code:\n     8\t//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\n     9\t//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\n    10\t//     dropped, then surface the original failure so the caller marks the gap.\n    11\t//   - anything else (thread store unavailable): no durable gap is possible —\n    12\t//     surface the failure for the caller to route to an extension health\n    13\t//     signal. Either way the session continues.\n    14\t//\n    15\t// The map → accumulate orchestration runs in the composition root (index.ts),\n    16\t// which routes this function's structured result into SessionState.health;\n    17\t// capture itself stays boundary-pure (lhc + shared only).\n    18\t\n    19\tfunction detail(cause: unknown): string {\n    20\t  return cause instanceof Error ? cause.message : String(cause);\n    21\t}\n    22\t\n    23\t/** messageEvents returns OpResults for operational failures, but a thread file\n    24\t *  in a genuinely broken state could still throw — contain that too, so capture\n    25\t *  is total. */\n    26\tasync function flushIsolated(\n    27\t  instance: LhcInstance,\n    28\t  events: readonly MessageEventInput[],\n    29\t): Promise<OpResult<BatchResult>> {\n    30\t  try {\n    31\t    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\n    32\t  } catch (cause) {\n    33\t    return {\n    34\t      ok: false,\n    35\t      error: {\n    36\t        errorClass: \"system_error\",\n    37\t        code: \"storage_failure\",\n    38\t        reason: `capture flush threw: ${detail(cause)}`,\n    39\t      },\n    40\t    };\n    41\t  }\n    42\t}\n    43\t\n    44\t/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\n    45\t *  rides an existing intake kind (no new kind) and surfaces in the event log.\n    46\t *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\n    47\t *  bad batch dedups the gap rather than piling up duplicates. */\n    48\tfunction gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\n    49\t  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\n    50\t  return {\n    51\t    eventKind: \"runtime_note\",\n    52\t    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\n    53\t    actor: \"system\",\n    54\t    harness: \"pi\",\n    55\t    payload: { text },\n    56\t  };\n    57\t}\n    58\t\n    59\texport async function capture(\n    60\t  events: MessageEventInput[],\n    61\t  instance: LhcInstance,\n    62\t): Promise<OpResult<BatchResult>> {\n    63\t  const primary = await flushIsolated(instance, events);\n    64\t  if (primary.ok) return primary;\n    65\t\n    66\t  if (primary.error.code === \"invalid_event\") {\n    67\t    // Writable thread, malformed event: never drop — record a durable gap.\n    68\t    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\n    69\t    // If the gap write itself fails, the store went unavailable: surface that\n    70\t    // (no durable gap was recorded) so the caller routes it to health.\n    71\t    if (!gap.ok) return gap;\n    72\t    return primary;\n    73\t  }\n    74\t\n    75\t  // Store unavailable / other: no durable gap is possible.\n    76\t  return primary;\n    77\t}\n","exit_code":0,"status":"completed"}}

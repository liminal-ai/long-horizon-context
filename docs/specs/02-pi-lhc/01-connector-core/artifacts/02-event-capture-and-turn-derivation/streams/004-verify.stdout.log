{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/pi/types.ts'","aggregated_output":"     1\t// Local declarations of the PI extension surface the connector consumes.\n     2\t//\n     3\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n     4\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n     5\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\n     6\t// build-time dependency of this workspace, so the connector declares the slice\n     7\t// of their contract it touches and swaps to the real imports when the\n     8\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n     9\t// surface here — rather than scattered `any` — means later stories get real\n    10\t// type-checking against the contract PI actually fires.\n    11\t\n    12\t// ── Hook vocabulary ──────────────────────────────────────────────────\n    13\t\n    14\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n    15\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\n    16\t *  serving is Epic 2. */\n    17\texport type PiHookName =\n    18\t  | \"session_start\"\n    19\t  | \"message_end\"\n    20\t  | \"turn_end\"\n    21\t  | \"agent_end\"\n    22\t  | \"model_select\"\n    23\t  | \"thinking_level_select\"\n    24\t  | \"session_before_fork\"\n    25\t  | \"session_before_switch\"\n    26\t  | \"session_shutdown\"\n    27\t  | \"context\";\n    28\t\n    29\texport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\n    30\texport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n    31\t\n    32\texport interface SessionStartEvent {\n    33\t  reason: SessionStartReason;\n    34\t  previousSessionFile?: string;\n    35\t}\n    36\texport interface MessageEndEvent {\n    37\t  message: AgentMessage;\n    38\t}\n    39\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n    40\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\n    41\texport interface TurnEndEvent {\n    42\t  turnIndex: number;\n    43\t  message: AgentMessage;\n    44\t  toolResults: ToolResultMessage[];\n    45\t  stopReason?: PiStopReason;\n    46\t}\n    47\texport interface AgentEndEvent {\n    48\t  messages: AgentMessage[];\n    49\t}\n    50\texport interface ModelSelectEvent {\n    51\t  model: ModelDescriptor;\n    52\t  previousModel?: ModelDescriptor;\n    53\t  source?: string;\n    54\t}\n    55\texport interface ThinkingLevelSelectEvent {\n    56\t  level: string;\n    57\t  previousLevel: string;\n    58\t}\n    59\texport interface SessionBeforeForkEvent {\n    60\t  entryId: string;\n    61\t  position?: number;\n    62\t}\n    63\texport interface SessionBeforeSwitchEvent {\n    64\t  intent: \"new\" | \"resume\";\n    65\t}\n    66\texport interface SessionShutdownEvent {\n    67\t  reason: SessionShutdownReason;\n    68\t  targetSessionFile?: string;\n    69\t}\n    70\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\n    71\texport interface ContextEvent {\n    72\t  messages: AgentMessage[];\n    73\t}\n    74\t\n    75\t/** Maps each hook to the payload PI delivers with it. */\n    76\texport interface PiHookEventMap {\n    77\t  session_start: SessionStartEvent;\n    78\t  message_end: MessageEndEvent;\n    79\t  turn_end: TurnEndEvent;\n    80\t  agent_end: AgentEndEvent;\n    81\t  model_select: ModelSelectEvent;\n    82\t  thinking_level_select: ThinkingLevelSelectEvent;\n    83\t  session_before_fork: SessionBeforeForkEvent;\n    84\t  session_before_switch: SessionBeforeSwitchEvent;\n    85\t  session_shutdown: SessionShutdownEvent;\n    86\t  context: ContextEvent;\n    87\t}\n    88\t\n    89\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n    90\t *  connector must never retain it across calls (PI replaces session objects on\n    91\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\n    92\texport type PiHookHandler<N extends PiHookName> = (\n    93\t  ctx: ExtensionContext,\n    94\t  event: PiHookEventMap[N],\n    95\t) => void | Promise<void>;\n    96\t\n    97\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n    98\t\n    99\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n   100\t\n   101\texport interface PiToolSpec {\n   102\t  name: string;\n   103\t  description?: string;\n   104\t  promptSnippet?: string;\n   105\t  promptGuidelines?: string;\n   106\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n   107\t}\n   108\t\n   109\t/** The factory-time API. Hook registration and command/tool registration take\n   110\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n   111\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n   112\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\n   113\texport interface ExtensionAPI {\n   114\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n   115\t  registerCommand(name: string, handler: PiCommandHandler): void;\n   116\t  registerTool(tool: PiToolSpec): void;\n   117\t  appendEntry(customType: string, data: unknown): void;\n   118\t}\n   119\t\n   120\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n   121\t\n   122\texport interface ModelDescriptor {\n   123\t  provider: string;\n   124\t  id: string;\n   125\t}\n   126\t\n   127\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n   128\t *  owns. The connector treats provider/model as opaque routing keys. */\n   129\texport interface ModelHandle extends ModelDescriptor {\n   130\t  readonly [k: string]: unknown;\n   131\t}\n   132\t\n   133\texport interface ModelRegistry {\n   134\t  find(provider: string, model: string): ModelHandle | undefined;\n   135\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\n   136\t  getAvailable(): ModelHandle[];\n   137\t}\n   138\t\n   139\texport interface ExtensionUI {\n   140\t  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n   141\t}\n   142\t\n   143\texport interface SessionEntry {\n   144\t  type: string;\n   145\t  readonly [k: string]: unknown;\n   146\t}\n   147\t\n   148\texport interface SessionManager {\n   149\t  getEntries(): SessionEntry[];\n   150\t}\n   151\t\n   152\texport interface ExtensionContext {\n   153\t  modelRegistry: ModelRegistry;\n   154\t  ui: ExtensionUI;\n   155\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n   156\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n   157\t  hasUI: boolean;\n   158\t  sessionManager: SessionManager;\n   159\t  cwd: string;\n   160\t}\n   161\t\n   162\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n   163\t\n   164\texport interface TextPart {\n   165\t  type: \"text\";\n   166\t  text: string;\n   167\t}\n   168\texport interface ThinkingPart {\n   169\t  type: \"thinking\";\n   170\t  thinking: string;\n   171\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n   172\t   *  Epic 1 (tech design I-3). */\n   173\t  thinkingSignature?: string;\n   174\t}\n   175\texport interface ToolCallPart {\n   176\t  type: \"toolCall\";\n   177\t  /** Composite, stable across tool_execution_start → tool_result → message_end\n   178\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n   179\t  id: string;\n   180\t  name: string;\n   181\t  arguments: Record<string, unknown>;\n   182\t  /** Opaque; captured, not interpreted (tech design I-3). */\n   183\t  thoughtSignature?: string;\n   184\t}\n   185\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n   186\t *  the converter (tech design I-6), never silently dropped. */\n   187\texport interface ImagePart {\n   188\t  type: \"image\";\n   189\t  mimeType?: string;\n   190\t  data?: string;\n   191\t}\n   192\texport interface FileRefPart {\n   193\t  type: \"fileRef\";\n   194\t  path: string;\n   195\t}\n   196\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n   197\t\n   198\texport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n   199\t\n   200\texport interface TokenUsage {\n   201\t  inputTokens?: number;\n   202\t  outputTokens?: number;\n   203\t}\n   204\t\n   205\texport interface UserMessage {\n   206\t  role: \"user\";\n   207\t  content: ContentPart[];\n   208\t}\n   209\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n   210\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\n   211\texport interface AssistantMessage {\n   212\t  role: \"assistant\";\n   213\t  content: ContentPart[];\n   214\t  stopReason?: PiStopReason;\n   215\t  usage?: TokenUsage;\n   216\t}\n   217\texport interface ToolResultMessage {\n   218\t  role: \"toolResult\";\n   219\t  toolCallId: string;\n   220\t  content: ContentPart[];\n   221\t  isError?: boolean;\n   222\t}\n   223\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/lifecycle/thread-resolution.test.ts | sed -n '300,390p'\"","aggregated_output":"   300\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n   301\t\n   302\t    const state = connector.getState();\n   303\t    expect(state).not.toBeNull();\n   304\t    if (state === null) return;\n   305\t    expect(connector.getInstance()).not.toBeNull();\n   306\t    expect(await threadCount()).toBe(before); // resolved without failing\n   307\t  });\n   308\t});\n   309\t\n   310\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n   311\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n   312\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n   313\t\n   314\t    // session_start with a ctx carrying methods.\n   315\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n   316\t    expect(connector.getState()).not.toBeNull();\n   317\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n   318\t    // ...but the snapshot is plain data only — it survives structuredClone even\n   319\t    // though the live ctx and instance carry methods (they are not in it).\n   320\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   321\t    const threadRefBefore = connector.getState()?.threadRef;\n   322\t\n   323\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n   324\t    // holder still references no prior ctx.\n   325\t    await connector.handlers.message_end(\n   326\t      syntheticCtx(\"/work/a\"),\n   327\t      makeMessageEnd(makeUserMessage(\"hi\")),\n   328\t    );\n   329\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   330\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n   331\t  });\n   332\t});\n   333\t\n   334\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n   335\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n   336\t    const cwd = \"/work/reload\";\n   337\t\n   338\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n   339\t    const connectorA = productionConnector(() => ({}));\n   340\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   341\t    const stateA = connectorA.getState();\n   342\t    expect(stateA).not.toBeNull();\n   343\t    if (stateA === null) return;\n   344\t    const firstId = idOf(stateA.threadRef);\n   345\t    const countAfterNew = await threadCount();\n   346\t\n   347\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n   348\t    expect(row.ok).toBe(true);\n   349\t    if (row.ok) {\n   350\t      expect(row.value.cwd).toBe(cwd);\n   351\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n   352\t    }\n   353\t\n   354\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n   355\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n   356\t    // closure and a still-no-flag launch (which would otherwise create a\n   357\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n   358\t    // thing bridging the teardown is the durable registry — this is what proves\n   359\t    // reconstruction survives loss of every in-memory holder (SV-001).\n   360\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   361\t\n   362\t    const connectorB = productionConnector(() => ({}));\n   363\t    await connectorB.handlers.se
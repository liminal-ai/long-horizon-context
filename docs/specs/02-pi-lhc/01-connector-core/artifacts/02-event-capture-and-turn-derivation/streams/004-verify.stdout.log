{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/idempotency.test.ts'","aggregated_output":"     1\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\n     2\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n     3\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n     4\t// must add nothing the second time. The key goldens pin construction precedence:\n     5\t// PI entry id → provider response / tool-call id → content fingerprint, with\n     6\t// blockIndex and kind disambiguating one message's fan-out.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\n     9\timport { capture } from \"../../src/capture/converter.js\";\n    10\timport { eventKey } from \"../../src/capture/idempotency.js\";\n    11\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    12\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    13\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    14\timport type { AgentMessage } from \"../../src/pi/types.js\";\n    15\timport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\n    16\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    17\t\n    18\tlet store: TempStore;\n    19\tbeforeEach(() => {\n    20\t  store = tempStore();\n    21\t});\n    22\tafterEach(() => {\n    23\t  store.cleanup();\n    24\t});\n    25\t\n    26\tdescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n    27\t  it(\"is deterministic: identical input yields an identical key\", () => {\n    28\t    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n    29\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\n    30\t  });\n    31\t\n    32\t  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n    33\t    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n    34\t    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n    35\t    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n    36\t    expect(thinking).toContain(\"e1\");\n    37\t    // Same entry, different block → different key (fan-out stays distinct).\n    38\t    expect(text).not.toBe(thinking);\n    39\t    // Same entry + block, different kind → still distinct.\n    40\t    expect(textSameBlock).not.toBe(thinking);\n    41\t  });\n    42\t\n    43\t  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n    44\t    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n    45\t    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n    46\t    expect(call).toContain(\"call_a\");\n    47\t    expect(result).toContain(\"call_a\");\n    48\t    expect(call).not.toBe(result);\n    49\t  });\n    50\t\n    51\t  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n    52\t    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n    53\t    expect(key).toContain(\"resp_7\");\n    54\t  });\n    55\t\n    56\t  it(\"falls to a content fingerprint as last resort: same content same key, different content different key\", () => {\n    57\t    const a = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    58\t    const aAgain = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    59\t    const b = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"world\" });\n    60\t    expect(aAgain).toBe(a);\n    61\t    expect(b).not.toBe(a);\n    62\t  });\n    63\t\n    64\t  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n    65\t    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n    66\t    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n    67\t    expect(withBoth).toBe(entryOnly);\n    68\t  });\n    69\t});\n    70\t\n    71\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n    72\t  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n    73\t  const events: MessageEventInput[] = [];\n    74\t  source.forEach((message, index) => {\n    75\t    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n    76\t    acc.onMessage(mapped);\n    77\t    events.push(...mapped);\n    78\t  });\n    79\t  events.push(...acc.onAgentEnd());\n    80\t  return events;\n    81\t}\n    82\t\n    83\tdescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n    84\t  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n    85\t    const thread = await makeTempThread(store);\n    86\t    const built = await initInstance(thread.threadRef, {\n    87\t      provider: createDeterministicProvider(),\n    88\t      mode: \"background\",\n    89\t    });\n    90\t    expect(built.ok).toBe(true);\n    91\t    if (!built.ok) return;\n    92\t    const instance = built.value;\n    93\t\n    94\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n    95\t\n    96\t    const first = await capture(batch, instance);\n    97\t    expect(first.ok).toBe(true);\n    98\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    99\t\n   100\t    const replay = await capture(batch, instance);\n   101\t    expect(replay.ok).toBe(true);\n   102\t    if (replay.ok) {\n   103\t      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   104\t    }\n   105\t\n   106\t    const read = await intakeStream.listEvents(instance.threadRef);\n   107\t    expect(read.ok).toBe(true);\n   108\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   109\t\n   110\t    await instance.dispose();\n   111\t  });\n   112\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/support.ts'","aggregated_output":"     1\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\n     2\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\n     3\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\n     4\t// converter → real LHC intake) so every capture test asserts on recorded\n     5\t// thread state, never on a mocked intake. The two external edges stay as the\n     6\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\n     7\t// SDK runs real against a temp SQLite thread with the deterministic provider\n     8\t// (selected by explicit name, never a production default).\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  inspect,\n    12\t  intakeStream,\n    13\t  type EventKind,\n    14\t  type MessageEventInput,\n    15\t  type OpResult,\n    16\t  type SdkConfig,\n    17\t  type ThreadRef,\n    18\t} from \"lhc\";\n    19\timport { createConnector, type Connector } from \"../../src/index.js\";\n    20\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n    21\timport { makeSessionStart } from \"../fixtures/synthetic.js\";\n    22\timport type { TempStore } from \"../fixtures/thread.js\";\n    23\t\n    24\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\n    25\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\n    26\t *  assume a TUI. */\n    27\texport function syntheticCtx(cwd = \"/work/capture\"): ExtensionContext {\n    28\t  return {\n    29\t    cwd,\n    30\t    hasUI: false,\n    31\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n    32\t    ui: { notify: () => {} },\n    33\t    sessionManager: { getEntries: () => [] },\n    34\t  };\n    35\t}\n    36\t\n    37\t/** The capture-suite SDK config: a real background instance on the\n    38\t *  deterministic provider, so a captured user_prompt's queued derivation has a\n    39\t *  handler to settle and never strands background work. */\n    40\texport function captureConfig(): OpResult<SdkConfig> {\n    41\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n    42\t}\n    43\t\n    44\texport interface StartedCapture {\n    45\t  connector: Connector;\n    46\t  ctx: ExtensionContext;\n    47\t  threadRef: ThreadRef;\n    48\t}\n    49\t\n    50\t/** Start a connector against a temp store and fire `session_start{new}` so a\n    51\t *  background instance + thread exist and the capture hooks are live. */\n    52\texport async function startCapture(store: TempStore, cwd = \"/work/capture\"): Promise<StartedCapture> {\n    53\t  const connector = createConnector({\n    54\t    registryPath: store.registryPath,\n    55\t    newThreadFilePath: () => store.threadPath(),\n    56\t    parseLaunch: () => ({}),\n    57\t    buildSdkConfig: () => captureConfig(),\n    58\t  });\n    59\t  const ctx = syntheticCtx(cwd);\n    60\t  await connector.handlers.session_start(ctx, makeSessionStart(\"new\"));\n    61\t  const state = connector.getState();\n    62\t  if (state === null) throw new Error(\"startCapture: session_start did not resolve a thread\");\n    63\t  return { connector, ctx, threadRef: state.threadRef };\n    64\t}\n    65\t\n    66\t/** Settle background work and dispose, then read the durable event log back in\n    67\t *  recorded order — capture's product is the stored thread, so tests assert on\n    68\t *  this. */\n    69\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\n    70\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \"shutdown\" });\n    71\t  const read = await intakeStream.listEvents(started.threadRef);\n    72\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n    73\t  // Strip the server-stamped fields so the comparison is over the logical\n    74\t  // intake shape the converter produced.\n    75\t  return read.value.map((record) => ({\n    76\t    eventKind: record.eventKind,\n    77\t    idempotencyKey: record.idempotencyKey,\n    78\t    actor: record.actor,\n    79\t    harness: record.harness,\n    80\t    payload: record.payload,\n    81\t  })) as MessageEventInput[];\n    82\t}\n    83\t\n    84\t/** The ordered event-kind sequence — the spine every capture test checks. */\n    85\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\n    86\t  return events.map((event) => event.eventKind);\n    87\t}\n    88\t\n    89\t/** Counts open/closed turns and total recorded events from the inspect\n    90\t *  overview (the real read-back surface, not a private query). */\n    91\texport async function turnCounts(\n    92\t  threadRef: ThreadRef,\n    93\t): Promise<{ open: number; closed: number; events: number }> {\n    94\t  const overview = await inspect.overview(threadRef);\n    95\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\n    96\t  return {\n    97\t    open: overview.value.turns.open,\n    98\t    closed: overview.value.turns.closed,\n    99\t    events: overview.value.events.count,\n   100\t  };\n   101\t}\n","exit_code":0,"status":"completed"}}

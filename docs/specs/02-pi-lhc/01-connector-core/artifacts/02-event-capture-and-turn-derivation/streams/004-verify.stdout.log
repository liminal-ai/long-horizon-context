{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/parallel-and-errors.test.ts'","aggregated_output":"     1\t// Story 2 — parallel-tool correlation (TC-2.4), error-result capture (TC-2.5),\n     2\t// and idempotent re-delivery (TC-2.7, the idempotency architecture-risk). The\n     3\t// first two run the production path and read the thread back; TC-2.7 drives\n     4\t// capture() directly so it can assert the per-event skip outcomes the SDK\n     5\t// returns on re-delivery.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport { createDeterministicProvider, intakeStream } from \"lhc\";\n     8\timport { capture } from \"../../src/capture/converter.js\";\n     9\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    10\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    11\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    12\timport {\n    13\t  makeAgentEnd,\n    14\t  makeAssistantMessage,\n    15\t  makeMessageEnd,\n    16\t  makeToolResult,\n    17\t  makeUserMessage,\n    18\t} from \"../fixtures/synthetic.js\";\n    19\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    20\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tinterface ToolResultPayload {\n    31\t  toolCallId: string;\n    32\t  content: string;\n    33\t  isError?: boolean;\n    34\t}\n    35\tfunction toolResultPayload(event: { payload: unknown }): ToolResultPayload {\n    36\t  return event.payload as ToolResultPayload;\n    37\t}\n    38\t\n    39\tdescribe(\"Story 2: parallel tool calls (TC-2.4)\", () => {\n    40\t  it(\"correlates each out-of-order tool_result to its call by toolCallId, not arrival order\", async () => {\n    41\t    const started = await startCapture(store);\n    42\t    const { connector, ctx } = started;\n    43\t\n    44\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read both files\")));\n    45\t    await connector.handlers.message_end(\n    46\t      ctx,\n    47\t      makeMessageEnd(\n    48\t        makeAssistantMessage({\n    49\t          toolCalls: [\n    50\t            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n    51\t            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n    52\t          ],\n    53\t        }),\n    54\t      ),\n    55\t    );\n    56\t    // Results complete out of arrival order: b before a.\n    57\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b body\" })));\n    58\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a body\" })));\n    59\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"read both\" })));\n    60\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    61\t\n    62\t    const events = await eventsAfterShutdown(started);\n    63\t    const results = events.filter((event) => event.eventKind === \"tool_result\");\n    64\t    expect(results).toHaveLength(2);\n    65\t\n    66\t    // Each result carries its own call's id and content — correlation is by id.\n    67\t    const contentById = new Map(\n    68\t      results.map((event) => [toolResultPayload(event).toolCallId, toolResultPayload(event).content]),\n    69\t    );\n    70\t    expect(contentById.get(\"call_b\")).toBe(\"b body\");\n    71\t    expect(contentById.get(\"call_a\")).toBe(\"a body\");\n    72\t\n    73\t    // Arrival order is preserved in the record (b then a), each correctly tagged\n    74\t    // — proving the tag, not the position, is the correlation.\n    75\t    expect(toolResultPayload(results[0]!).toolCallId).toBe(\"call_b\");\n    76\t    expect(toolResultPayload(results[1]!).toolCallId).toBe(\"call_a\");\n    77\t  });\n    78\t});\n    79\t\n    80\tdescribe(\"Story 2: error tool result (TC-2.5)\", () => {\n    81\t  it(\"captures an error tool_result with the error flag and its content, dropping nothing\", async () => {\n    82\t    const started = await startCapture(store);\n    83\t    const { connector, ctx } = started;\n    84\t\n    85\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read missing.txt\")));\n    86\t    await connector.handlers.message_end(\n    87\t      ctx,\n    88\t      makeMessageEnd(makeAssistantMessage({ toolCalls: [{ id: \"call_a\", name: \"read_file\", arguments: { path: \"missing.txt\" } }] })),\n    89\t    );\n    90\t    await connector.handlers.message_end(\n    91\t      ctx,\n    92\t      makeMessageEnd(makeToolResult({ id: \"call_a\", isError: true, content: \"ENOENT: no such file\" })),\n    93\t    );\n    94\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"it does not exist\" })));\n    95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    96\t\n    97\t    const events = await eventsAfterShutdown(started);\n    98\t    // Nothing dropped because the tool failed.\n    99\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"tool_call\", \"tool_result\", \"assistant_text\", \"turn_end\"]);\n   100\t\n   101\t    const result = events.find((event) => event.eventKind === \"tool_result\");\n   102\t    expect(result).toBeDefined();\n   103\t    expect(toolResultPayload(result!).isError).toBe(true);\n   104\t    expect(toolResultPayload(result!).content).toBe(\"ENOENT: no such file\");\n   105\t  });\n   106\t});\n   107\t\n   108\tdescribe(\"Story 2: idempotent re-delivery (TC-2.7, idempotency risk)\", () => {\n   109\t  it(\"skips a re-delivered batch by idempotency key and records no duplicates\", async () => {\n   110\t    const thread = await makeTempThread(store);\n   111\t    const built = await initInstance(thread.threadRef, {\n   112\t      provider: createDeterministicProvider(),\n   113\t      mode: \"background\",\n   114\t    });\n   115\t    expect(built.ok).toBe(true);\n   116\t    if (!built.ok) return;\n   117\t    const instance = built.value;\n   118\t\n   119\t    // Build one logical turn's events through the real map + accumulator, so the\n   120\t    // keys are exactly what production would emit.\n   121\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   122\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n   123\t    acc.onMessage(userEvents);\n   124\t    const assistantEvents = mapMessage(makeAssistantMessage({ text: \"hi there\" }), {\n   125\t      piSessionId: \"sess\",\n   126\t      entryId: \"s1\",\n   127\t    });\n   128\t    acc.onMessage(assistantEvents);\n   129\t    const turnEnd = acc.onAgentEnd();\n   130\t    const batch = [...userEvents, ...assistantEvents, ...turnEnd];\n   131\t\n   132\t    const first = await capture(batch, instance);\n   133\t    expect(first.ok).toBe(true);\n   134\t    if (first.ok) {\n   135\t      expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   136\t    }\n   137\t\n   138\t    // Re-delivery (the reload / crash-replay path): identical keys → all skipped.\n   139\t    const second = await capture(batch, instance);\n   140\t    expect(second.ok).toBe(true);\n   141\t    if (second.ok) {\n   142\t      expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   143\t      expect(\n   144\t        second.value.events.every((entry) => entry.skipReason === \"duplicate_idempotency_key\"),\n   145\t      ).toBe(true);\n   146\t    }\n   147\t\n   148\t    // No duplicate records landed on the thread.\n   149\t    const read = await intakeStream.listEvents(instance.threadRef);\n   150\t    expect(read.ok).toBe(true);\n   151\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   152\t\n   153\t    await instance.dispose();\n   154\t  });\n   155\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/converter.test.ts'","aggregated_output":"     1\t// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\n     2\t// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\n     3\t// production path runs end to end — PI hook → converter → real LHC intake —\n     4\t// and every assertion reads the durable thread back. TC-2.8 also exercises\n     5\t// capture() directly because the two failure shapes (writable→gap vs\n     6\t// store-unavailable→health) are the architecture-risk contract.\n     7\timport { rmSync } from \"node:fs\";\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  intakeStream,\n    12\t  threads,\n    13\t  type MessageEventInput,\n    14\t  type ThreadRef,\n    15\t} from \"lhc\";\n    16\timport { capture } from \"../../src/capture/converter.js\";\n    17\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    18\timport type { LhcInstance } from \"../../src/shared/instance.js\";\n    19\timport {\n    20\t  makeAgentEnd,\n    21\t  makeAssistantMessage,\n    22\t  makeMessageEnd,\n    23\t  makeToolResult,\n    24\t  makeUserMessage,\n    25\t  validEvent,\n    26\t} from \"../fixtures/synthetic.js\";\n    27\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    28\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n    29\t\n    30\tlet store: TempStore;\n    31\tbeforeEach(() => {\n    32\t  store = tempStore();\n    33\t});\n    34\tafterEach(() => {\n    35\t  store.cleanup();\n    36\t});\n    37\t\n    38\tfunction textOf(event: MessageEventInput): string {\n    39\t  return (event.payload as { text?: string }).text ?? \"\";\n    40\t}\n    41\t\n    42\tdescribe(\"Story 2: converter — capture and fan-out (TC-2.1)\", () => {\n    43\t  it(\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\", async () => {\n    44\t    const started = await startCapture(store);\n    45\t    const { connector, ctx } = started;\n    46\t\n    47\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read the file\")));\n    48\t    await connector.handlers.message_end(\n    49\t      ctx,\n    50\t      makeMessageEnd(\n    51\t        makeAssistantMessage({\n    52\t          thinking: \"I should open it\",\n    53\t          text: \"here is the answer\",\n    54\t          toolCalls: [{ id: \"call_x\", name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n    55\t        }),\n    56\t      ),\n    57\t    );\n    58\t    await connector.handlers.message_end(\n    59\t      ctx,\n    60\t      makeMessageEnd(makeToolResult({ id: \"call_x\", content: \"file body\" })),\n    61\t    );\n    62\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    63\t\n    64\t    // No silent capture failure on the happy path.\n    65\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n    66\t\n    67\t    const events = await eventsAfterShutdown(started);\n    68\t    expect(kindsOf(events)).toEqual([\n    69\t      \"user_prompt\",\n    70\t      \"assistant_thinking\",\n    71\t      \"assistant_text\",\n    72\t      \"tool_call\",\n    73\t      \"tool_result\",\n    74\t      \"turn_end\",\n    75\t    ]);\n    76\t\n    77\t    expect(textOf(events[0]!)).toBe(\"read the file\");\n    78\t    expect(textOf(events[1]!)).toBe(\"I should open it\");\n    79\t    expect(textOf(events[2]!)).toBe(\"here is the answer\");\n    80\t    expect(events[3]!.payload).toMatchObject({\n    81\t      toolCallId: \"call_x\",\n    82\t      toolName: \"read_file\",\n    83\t      arguments: { path: \"notes.txt\" },\n    84\t    });\n    85\t    expect(events[4]!.payload).toMatchObject({ toolCallId: \"call_x\", content: \"file body\" });\n    86\t  });\n    87\t});\n    88\t\n    89\tdescribe(\"Story 2: converter — runtime-change capture (TC-2.9)\", () => {\n    90\t  it(\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\", async () => {\n    91\t    const started = await startCapture(store);\n    92\t    const { connector, ctx } = started;\n    93\t\n    94\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"go\")));\n    95\t    await connector.handlers.model_select(ctx, {\n    96\t      model: { provider: \"openai\", id: \"gpt-4o\" },\n    97\t      previousModel: { provider: \"anthropic\", id: \"claude-3\" },\n    98\t    });\n    99\t    await connector.handlers.thinking_level_select(ctx, { level: \"high\", previousLevel: \"low\" });\n   100\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"done\" })));\n   101\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   102\t\n   103\t    const events = await eventsAfterShutdown(started);\n   104\t    // Ordering relative to the surrounding messages is preserved.\n   105\t    expect(kindsOf(events)).toEqual([\n   106\t      \"user_prompt\",\n   107\t      \"runtime_note\",\n   108\t      \"runtime_note\",\n   109\t      \"assistant_text\",\n   110\t      \"turn_end\",\n   111\t    ]);\n   112\t\n   113\t    const modelNote = textOf(events[1]!);\n   114\t    expect(modelNote).toContain(\"anthropic/claude-3\");\n   115\t    expect(modelNote).toContain(\"openai/gpt-4o\");\n   116\t\n   117\t    const levelNote = textOf(events[2]!);\n   118\t    expect(levelNote).toContain(\"low\");\n   119\t    expect(levelNote).toContain(\"high\");\n   120\t  });\n   121\t});\n   122\t\n   123\tdescribe(\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\", () => {\n   124\t  async function liveInstance(): Promise<LhcInstance> {\n   125\t    const thread = await makeTempThread(store);\n   126\t    const built = await initInstance(thread.threadRef, {\n   127\t      provider: createDeterministicProvider(),\n   128\t      mode: \"background\",\n   129\t    });\n   130\t    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\n   131\t    return built.value;\n   132\t  }\n   133\t\n   134\t  it(\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\", async () => {\n   135\t    const instance = await liveInstance();\n   136\t    // A turn_end with a non-empty payload is rejected by LHC validation\n   137\t    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\n   138\t    const malformed = {\n   139\t      eventKind: \"turn_end\",\n   140\t      idempotencyKey: \"malformed-1\",\n   141\t      actor: \"system\",\n   142\t      harness: \"pi\",\n   143\t      payload: { stowaway: true },\n   144\t    } as unknown as MessageEventInput;\n   145\t\n   146\t    const result = await capture([malformed], instance);\n   147\t    expect(result.ok).toBe(false);\n   148\t\n   149\t    // The session continues: a durable, queryable gap is recorded on the thread.\n   150\t    const read = await intakeStream.listEvents(instance.threadRef);\n   151\t    expect(read.ok).toBe(true);\n   152\t    if (!read.ok) return;\n   153\t    const gaps = read.value.filter(\n   154\t      (event) =>\n   155\t        event.eventKind === \"runtime_note\" &&\n   156\t        (event.payload as { text: string }).text.toLowerCase().includes(\"gap\"),\n   157\t    );\n   158\t    expect(gaps).toHaveLength(1);\n   159\t\n   160\t    await instance.dispose();\n   161\t  });\n   162\t\n   163\t  it(\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\", async () => {\n   164\t    const deadInstance: LhcInstance = {\n   165\t      sdk: (await liveInstance()).sdk,\n   166\t      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\n   167\t      dispose: () => Promise.resolve({ ok: true, value: undefined }),\n   168\t    };\n   169\t\n   170\t    // capture isolates the failure into a structured result rather than throwing.\n   171\t    const result = await capture([validEvent(\"user_prompt\")], deadInstance);\n   172\t    expect(result.ok).toBe(false);\n   173\t    if (result.ok) return;\n   174\t    expect([\"thread_not_found\", \"storage_failure\"]).toContain(result.error.code);\n   175\t    // It is NOT misclassified as the writable-thread malformed-event case.\n   176\t    expect(result.error.code).not.toBe(\"invalid_event\");\n   177\t  });\n   178\t\n   179\t  it(\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\", async () => {\n   180\t    const started = await startCapture(store);\n   181\t    const { connector, ctx, threadRef } = started;\n   182\t\n   183\t    // Make the live thread's store unavailable mid-session, then capture.\n   184\t    const id = (threadRef as { threadId: string }).threadId;\n   185\t    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\n   186\t    expect(row.ok).toBe(true);\n   187\t    if (!row.ok) return;\n   188\t    rmSync(row.value.filePath, { force: true });\n   189\t\n   190\t    // The hook must not throw despite the dead store.\n   191\t    await expect(\n   192\t      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"after the store died\"))),\n   193\t    ).resolves.toBeUndefined();\n   194\t\n   195\t    const health = connector.getState()?.health.lastCaptureFailure;\n   196\t    expect(health).toBeDefined();\n   197\t    expect(health?.recordedGap).toBe(false);\n   198\t\n   199\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n   200\t  });\n   201\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/abort.test.ts'","aggregated_output":"     1\t// Story 2 — graceful interrupt (TC-2.6). A turn PI marks aborted is captured\n     2\t// whole: the partial assistant content is recorded, the aborted disposition is\n     3\t// carried through (the mapper carries stopReason — research §5b — onto the only\n     4\t// durable vehicle, a runtime_note), and the turn closes complete-but-aborted at\n     5\t// agent_end. The interrupted content is never discarded.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport type { MessageEventInput } from \"lhc\";\n     8\timport {\n     9\t  makeAgentEnd,\n    10\t  makeAssistantMessage,\n    11\t  makeMessageEnd,\n    12\t  makeUserMessage,\n    13\t} from \"../fixtures/synthetic.js\";\n    14\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    15\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    16\t\n    17\tlet store: TempStore;\n    18\tbeforeEach(() => {\n    19\t  store = tempStore();\n    20\t});\n    21\tafterEach(() => {\n    22\t  store.cleanup();\n    23\t});\n    24\t\n    25\tfunction textOf(event: MessageEventInput): string {\n    26\t  return (event.payload as { text?: string }).text ?? \"\";\n    27\t}\n    28\t\n    29\tdescribe(\"Story 2: graceful interrupt (TC-2.6)\", () => {\n    30\t  it(\"records partial assistant content, carries the aborted disposition, and closes the turn complete-but-aborted\", async () => {\n    31\t    const started = await startCapture(store);\n    32\t    const { connector, ctx, threadRef } = started;\n    33\t\n    34\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"write a long essay\")));\n    35\t    await connector.handlers.message_end(\n    36\t      ctx,\n    37\t      makeMessageEnd(\n    38\t        makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    39\t      ),\n    40\t    );\n    41\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    42\t\n    43\t    // A graceful interrupt is not a capture failure.\n    44\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n    45\t\n    46\t    const events = await eventsAfterShutdown(started);\n    47\t    expect(kindsOf(events)).toEqual([\n    48\t      \"user_prompt\",\n    49\t      \"assistant_thinking\",\n    50\t      \"assistant_text\",\n    51\t      \"runtime_note\",\n    52\t      \"turn_end\",\n    53\t    ]);\n    54\t\n    55\t    // Partial content is preserved verbatim — nothing discarded.\n    56\t    expect(textOf(events[1]!)).toBe(\"starting the essay\");\n    57\t    expect(textOf(events[2]!)).toBe(\"Once upon a\");\n    58\t    // The aborted disposition is carried through on the runtime_note.\n    59\t    expect(textOf(events[3]!).toLowerCase()).toContain(\"abort\");\n    60\t\n    61\t    // The turn closes complete-but-aborted (closed at agent_end, not left open).\n    62\t    const counts = await turnCounts(threadRef);\n    63\t    expect(counts.closed).toBe(1);\n    64\t    expect(counts.open).toBe(0);\n    65\t  });\n    66\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/turn-derivation.test.ts'","aggregated_output":"     1\t// Story 2 — turn derivation, the load-bearing mechanic. An LHC turn spans a\n     2\t// whole exchange: it opens on a user prompt, ignores every PI per-step\n     3\t// `turn_end`, and closes with exactly one LHC `turn_end` at `agent_end`\n     4\t// (TC-2.2). Session order is the converter's source-event order, never PI's\n     5\t// per-run `turnIndex` (TC-2.3). The accumulator goldens pin the state machine\n     6\t// directly, including the hard-kill tolerance (a dangling open turn, and an\n     7\t// agent_end with no open turn as a no-op).\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport type { MessageEventInput } from \"lhc\";\n    10\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    11\timport {\n    12\t  makeAgentEnd,\n    13\t  makeAssistantMessage,\n    14\t  makeMessageEnd,\n    15\t  makeToolResult,\n    16\t  makeUserMessage,\n    17\t  validEvent,\n    18\t} from \"../fixtures/synthetic.js\";\n    19\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    20\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tfunction textOf(event: MessageEventInput): string {\n    31\t  return (event.payload as { text?: string }).text ?? \"\";\n    32\t}\n    33\t\n    34\t// A PI per-step turn_end payload (ignored by the converter as a boundary).\n    35\tfunction piTurnEnd(turnIndex: number) {\n    36\t  return { turnIndex, message: makeAssistantMessage({ text: \"step\" }), toolResults: [] };\n    37\t}\n    38\t\n    39\tdescribe(\"Story 2: turn derivation — worked example (TC-2.2)\", () => {\n    40\t  it(\"yields exactly one LHC turn with one turn_end at agent_end; PI per-step turn_ends produce none\", async () => {\n    41\t    const started = await startCapture(store);\n    42\t    const { connector, ctx, threadRef } = started;\n    43\t\n    44\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"ask one question\")));\n    45\t    await connector.handlers.message_end(\n    46\t      ctx,\n    47\t      makeMessageEnd(\n    48\t        makeAssistantMessage({\n    49\t          thinking: \"two tools needed\",\n    50\t          toolCalls: [\n    51\t            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n    52\t            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n    53\t          ],\n    54\t        }),\n    55\t      ),\n    56\t    );\n    57\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b\" })));\n    58\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a\" })));\n    59\t    // PI fires a per-step turn_end here — it must NOT become an LHC turn_end.\n    60\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n    61\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"the answer\" })));\n    62\t    await connector.handlers.turn_end(ctx, piTurnEnd(1));\n    63\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    64\t\n    65\t    const events = await eventsAfterShutdown(started);\n    66\t    expect(kindsOf(events)).toEqual([\n    67\t      \"user_prompt\",\n    68\t      \"assistant_thinking\",\n    69\t      \"tool_call\",\n    70\t      \"tool_call\",\n    71\t      \"tool_result\",\n    72\t      \"tool_result\",\n    73\t      \"assistant_text\",\n    74\t      \"turn_end\",\n    75\t    ]);\n    76\t    // Exactly one LHC turn_end, and it lands last — at agent_end, not per PI step.\n    77\t    expect(events.filter((event) => event.eventKind === \"turn_end\")).toHaveLength(1);\n    78\t    expect(events.at(-1)?.eventKind).toBe(\"turn_end\");\n    79\t\n    80\t    const counts = await turnCounts(threadRef);\n    81\t    expect(counts.closed).toBe(1);\n    82\t    expect(counts.open).toBe(0);\n    83\t  });\n    84\t});\n    85\t\n    86\tdescribe(\"Story 2: turn derivation — source order, not turnIndex (TC-2.3)\", () => {\n    87\t  it(\"orders two agent runs that each start at turnIndex 0 by source-event order, with no collision\", async () => {\n    88\t    const started = await startCapture(store);\n    89\t    const { connector, ctx, threadRef } = started;\n    90\t\n    91\t    // Run 1 (PI turnIndex 0)\n    92\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"first prompt\")));\n    93\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"first answer\" })));\n    94\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n    95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    96\t    // Run 2 (PI turnIndex 0 AGAIN — the reset-per-run counter)\n    97\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"second prompt\")));\n    98\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"second answer\" })));\n    99\t    await connector.handlers.turn_end(ctx, piTurnEnd(0));\n   100\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n   101\t\n   102\t    const events = await eventsAfterShutdown(started);\n   103\t    expect(kindsOf(events)).toEqual([\n   104\t      \"user_prompt\",\n   105\t      \"assistant_text\",\n   106\t      \"turn_end\",\n   107\t      \"user_prompt\",\n   108\t      \"assistant_text\",\n   109\t      \"turn_end\",\n   110\t    ]);\n   111\t    // Source order decides sequence: run 1 precedes run 2 despite identical turnIndex.\n   112\t    expect(textOf(events[0]!)).toBe(\"first prompt\");\n   113\t    expect(textOf(events[3]!)).toBe(\"second prompt\");\n   114\t\n   115\t    const counts = await turnCounts(threadRef);\n   116\t    expect(counts.closed).toBe(2);\n   117\t    expect(counts.open).toBe(0);\n   118\t  });\n   119\t});\n   120\t\n   121\tdescribe(\"Story 2: turn accumulator — state machine goldens (AC-2.2)\", () => {\n   122\t  it(\"emits one turn_end only when a turn is open, and is idempotent across agent_end\", () => {\n   123\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   124\t    expect(acc.hasOpenTurn()).toBe(false);\n   125\t\n   126\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   127\t    expect(acc.hasOpenTurn()).toBe(true);\n   128\t\n   129\t    const emitted = acc.onAgentEnd();\n   130\t    expect(emitted).toHaveLength(1);\n   131\t    expect(emitted[0]?.eventKind).toBe(\"turn_end\");\n   132\t    expect(emitted[0]?.payload).toEqual({});\n   133\t    expect(acc.hasOpenTurn()).toBe(false);\n   134\t\n   135\t    // A second agent_end with no open turn emits nothing (hard-kill / reattach\n   136\t    // tolerance: turn_end-with-no-open-turn is a no-op).\n   137\t    expect(acc.onAgentEnd()).toEqual([]);\n   138\t  });\n   139\t\n   140\t  it(\"gives successive turns distinct turn_end idempotency keys\", () => {\n   141\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   142\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   143\t    const first = acc.onAgentEnd();\n   144\t    acc.onMessage([validEvent(\"user_prompt\")]);\n   145\t    const second = acc.onAgentEnd();\n   146\t    expect(first[0]?.idempotencyKey).not.toBe(second[0]?.idempotencyKey);\n   147\t  });\n   148\t});\n   149\t\n   150\tdescribe(\"Story 2: turn derivation — hard-kill golden\", () => {\n   151\t  it(\"leaves a dangling open turn when the run never reaches agent_end, with no turn_end recorded\", async () => {\n   152\t    const started = await startCapture(store);\n   153\t    const { connector, ctx, threadRef } = started;\n   154\t\n   155\t    // Hard kill: a user message lands, then the process dies — no assistant\n   156\t    // close, no agent_end.\n   157\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"dangling prompt\")));\n   158\t    await connector.getInstance()?.sdk.drainSettled(threadRef);\n   159\t\n   160\t    const counts = await turnCounts(threadRef);\n   161\t    expect(counts.open).toBe(1);\n   162\t    expect(counts.closed).toBe(0);\n   163\t\n   164\t    const events = await eventsAfterShutdown(started);\n   165\t    expect(events.filter((event) => event.eventKind === \"turn_end\")).toHaveLength(0);\n   166\t    expect(kindsOf(events)).toEqual([\"user_prompt\"]);\n   167\t  });\n   168\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"node --input-type=module <<'EOF'\nimport { mkdtempSync, rmSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { createConnector } from './dist/index.js';\nimport { createDeterministicProvider, intakeStream } from 'lhc';\n\nconst dir = mkdtempSync(join(tmpdir(), 'pi-lhc-proof-'));\nconst connector = createConnector({\n  registryPath: join(dir, 'registry.sqlite'),\n  newThreadFilePath: () => join(dir, \"'`${crypto.randomUUID()}.sqlite`),\n  parseLaunch: () => ({}),\n  buildSdkConfig: () => ({ ok: true, value: { provider: createDeterministicProvider(), mode: '\"'background' } }),\n});\nconst ctx = { cwd: dir, hasUI: false, modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] }, ui: { notify: () => {} }, sessionManager: { getEntries: () => [] } };\nconst user = { role: 'user', content: [{ type: 'text', text: 'same prompt' }] };\nawait connector.handlers.session_start(ctx, { reason: 'new' });\nawait connector.handlers.message_end(ctx, { message: user });\nawait connector.handlers.agent_end(ctx, { messages: [] });\nawait connector.handlers.message_end(ctx, { message: user });\nawait connector.handlers.agent_end(ctx, { messages: [] });\nconst ref = connector.getState().threadRef;\nawait connector.handlers.session_shutdown(ctx, { reason: 'shutdown' });\nconst read = await intakeStream.listEvents(ref);\nconsole.log(JSON.stringify({ ok: read.ok, eventKinds: read.ok ? read.value.map(e => e.eventKind) : undefined, eventCount: read.ok ? read.value.length : undefined }, null, 2));\nrmSync(dir, { recursive: true, force: true });\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

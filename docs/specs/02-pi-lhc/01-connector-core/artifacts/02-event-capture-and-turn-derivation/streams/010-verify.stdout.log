pecs/02-pi-lhc/.DS_Store\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/preflight/005-preflight.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/002-quick-fix.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/progress/002-quick-fix.progress.jsonl\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/progress/002-quick-fix.status.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/002-quick-fix.stderr.log\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/002-quick-fix.stdout.log\n?? packages/pi-lhc/test/capture/\n","exit_code":0,"status":"completed"}}

e/map-message.ts:78:    entryId: opts.entryId ?? ctx.entryId,\npackages/pi-lhc/src/capture/map-message.ts:83:    toolCallId: opts.toolCallId,\npackages/pi-lhc/src/capture/map-message.ts:94:function entryIdOf(msg: AgentMessage): string | undefined {\npackages/pi-lhc/src/capture/map-message.ts:95:  return stringField(msg, \"entryId\");\npackages/pi-lhc/src/capture/map-message.ts:98:function responseIdOf(msg: AgentMessage): string | undefined {\npackages/pi-lhc/src/capture/map-message.ts:110:  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\npackages/pi-lhc/src/capture/map-message.ts:114:  toolCallId: string,\npackages/pi-lhc/src/capture/map-message.ts:121:    idempotencyKey: key,\npackages/pi-lhc/src/capture/map-message.ts:124:    payload: { toolCallId, toolName, arguments: args },\npackages/pi-lhc/src/capture/map-message.ts:129:  toolCallId: string,\npackages/pi-lhc/src/capture/map-message.ts:136:    idempotencyKey: key,\npackages/pi-lhc/src/capture/map-message.ts:139:    payload: { toolCallId, content, isError },\npackages/pi-lhc/src/capture/map-message.ts:145:  const entryId = entryIdOf(msg);\npackages/pi-lhc/src/capture/map-message.ts:149:    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { entryId, content: text })));\npackages/pi-lhc/src/capture/map-message.ts:154:    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: text })));\npackages/pi-lhc/src/capture/map-message.ts:159:      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: \"empty:user\" })),\npackages/pi-lhc/src/capture/map-message.ts:167:  const entryId = entryIdOf(msg);\npackages/pi-lhc/src/capture/map-message.ts:173:    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { entryId, responseId, content: text })));\npackages/pi-lhc/src/capture/map-message.ts:178:    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { entryId, responseId, content: text })));\npackages/pi-lhc/src/capture/map-message.ts:184:      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { entryId, responseId, toolCallId: part.id, content: part.name })),\npackages/pi-lhc/src/capture/map-message.ts:190:    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: text })));\npackages/pi-lhc/src/capture/map-message.ts:196:      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: ABORTED_DISPOSITION_TEXT })),\npackages/pi-lhc/src/capture/map-message.ts:202:      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: \"empty:assistant\" })),\npackages/pi-lhc/src/capture/map-message.ts:210:  const entryId = entryIdOf(msg);\npackages/pi-lhc/src/capture/map-message.ts:213:  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\npackages/pi-lhc/src/capture/map-message.ts:217:      msg.toolCallId,\npackages/pi-lhc/src/capture/map-message.ts:220:      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { entryId, toolCallId: msg.toolCallId, content }),\npackages/pi-lhc/src/capture/map-message.ts:226:    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"toolResult\", \"runtime_note\", block, { entryId, toolCallId: msg.toolCallId, content: text })));\npackages/pi-lhc/src/capture/map-message.ts:232:export function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\npackages/pi-lhc/src/capture/runtime-changes.ts:3:import { eventKey } from \"./idempotency.js\";\npackages/pi-lhc/src/capture/runtime-changes.ts:5:// AC-2.8: model_select / thinking_level_select hooks → runtime_note events, in\npackages/pi-lhc/src/capture/runtime-changes.ts:41:    idempotencyKey: eventKey({\npackages/pi-lhc/src/capture/runtime-changes.ts:43:      entryId: ctx.entryId,\npackages/pi-lhc/src/capture/turn-accumulator.ts:2:import { eventKey } from \"./idempotency.js\";\npackages/pi-lhc/src/capture/turn-accumulator.ts:39:      this.openTurnKey = opening.idempotencyKey;\npackages/pi-lhc/src/capture/turn-accumulator.ts:59:        idempotencyKey: key,\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:16:| `message_end` | finalized `user` / `assistant` / `toolResult` message | Map → intake event batch → `sdk.intakeStream.messageEvents` |\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:17:| `turn_end` | `turnIndex`, `message`, `toolResults` | Emit `turn_end` intake event (closes LHC turn, triggers boundary advance + derivations) |\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:18:| `context` | deep copy of `messages`, return `{ messages }` to replace | Serve the thread view: `sdk.threadView.pull()` → map to `AgentMessage[]` |\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:22:| `model_select` | model changed | Optional: status display only |\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:36:- `message_end` handlers may replace the message; other extensions' mutations are visible — extension ordering matters if anything else mutates context.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:37:- Parallel tool mode: `tool_execution_*` events interleave, but final `toolResult` `message_end` events still arrive in assistant source order — intake ordering is safe if we drive everything off `message_end`.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:41:The POC (`pi-extension.ts`, ~2,900 lines) wires: `session_start` (snapshot ctx, reconcile rollout, hydrate truncation state), `message_end` (capture → side-channel tool-result restore → schedule smoothing → buffer truncation observation), `tool_result` (stash original content before PI/extension truncation), `turn_end` (finalize turn, parallel intake, observe/refresh projection, schedule background maintenance), `agent_end` (refresh projection), `context` (apply prompt-visible truncation), plus ~12 `lh-*` commands.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:44:- The event-to-record mapper (`pi-message-mapper.ts`) is a complete worked example of PI message → canonical mapping: role→kind mapping, content-part fan-out (text/thinking/toolCall/image/fileRef/unknown), idempotency key construction (`pi:<session>:entry:<entryId>`, responseId/toolCallId fallbacks, content fingerprint last resort), token telemetry extraction from assistant `usage`. The new converter reimplements this against `MessageEventInput` (which is far simpler — 7 event kinds, text-only payloads).\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:47:- Side-channel capture of original tool results before truncation (`tool_result` event fires before `message_end`).\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:64:message_end ────────────────────► map message → event batch ────► intakeStream.messageEvents(ref, events)\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:68:context ────────────────────────► pull + map ───────────────────► threadView.pull(ref) → ViewMessage[] → AgentMessage[]\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:79:**Event mapping (the converter contract):** PI `message_end` fans out to `MessageEventInput`s:\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:84:- idempotency keys from session entry id (the POC's `targetEventKey` scheme, simplified)\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:86:**Context serving (the mapping back):** `ViewMessage { role: \"user\"|\"assistant\", content }` → PI `AgentMessage`. Band messages are plain user-role text blocks; tail messages are pre-rendered text (tool calls/results already formatted by LHC's mapping table in `shared/view.ts:60-77`). Two things to verify in the dial-in/recording period: whether serving tool calls as flattened text (vs. native `toolCall` content parts) affects model behavior, and what PI requires of the first/last message roles.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:115:  → turn_start{turnIndex}\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:116:     → message_start/message_end (user [text])\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:117:     → message_start/message_end (assistant [thinking?, text?, toolCall×N])\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:118:     → (per tool) tool_execution_start{toolCallId,toolName,args} → tool_call → tool_result → tool_execution_end\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:119:     → message_start/message_end (toolResult [text]) ×N\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:120:     → turn_end{turnIndex, message, toolResults[]}\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:121:  → turn_start{turnIndex+1} ... (a new turn per agent step until no tool calls)\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:127:- **Parallel tool calls.** All N calls arrive in *one* assistant `message_end` (content = `[toolCall, toolCall, toolCall]`), each `{type,id,name,arguments}`. `tool_execution_start` events interleave and `tool_result`s complete out of order, but each `toolResult` `message_end` carries its `toolCallId`, so ordering is recoverable by ID, not arrival. Fan-out to LHC `tool_call` events is per-content-part, exactly as the mapper assumed.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:129:- **toolCallId shape.** Composite: `call_<providerId>|fc_<internalId>`. Stable across `tool_execution_start` → `tool_result` → the `toolResult` message. Usable as the correlation key and as part of the idempotency key.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:130:- **Resume/dedup — the big one.** Reopening an existing session (`--session-id` of a prior session) does **NOT** re-fire historical `message_end` events. Only the new turn's events fire (verified: 4 message events, not 10). PI loads prior history internally and exposes it through the **`context` hook** (first context on resume already held all 7 prior messages). **Consequence: LHC intake never sees duplicate historical events on resume — the dedup concern is far smaller than feared.** Idempotency keys still matter for `/reload` and crash-replay, but normal resume is clean by construction.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:136:**Hard-kill abort, captured solo:** `kill -9` mid-stream left the log at `session_start → before_agent_start → agent_start → turn_start → message_end(user)` — **no assistant `message_end`, no `turn_end`, no `agent_end`, no `session_shutdown`.** The incomplete-turn shape: user prompt captured, no agent response, turn never closed. LHC reattach after a crash finds an open turn with a trailing user prompt; intake must tolerate it. This is the crash-safety shape AC-1.4 needs.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:140:- Control entries: `model_change {provider, modelId}`, `thinking_level_change {thinkingLevel}`.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:149:- **Graceful interrupt (Esc):** the partial assistant message gets a normal `message_end` with content preserved (`[thinking, text]`, ~120 lines kept) and **`stopReason: \"aborted\"`**; `turn_end` fires, also `stopReason: \"aborted\"`; `agent_end` fires. A graceful abort is a *complete, well-formed turn marked aborted* — partial content is real and worth keeping. The session continues normally on the next prompt (verified: follow-up ran `stopReason: \"stop\"`, no recovery path).\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:150:- **Hard-kill (`kill -9`, §5a):** nothing closes — user `message_end` only, no assistant close, no `turn_end`. Dangling open turn.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:153:**`turnIndex` is per-agent-run, not session-monotonic.** Each prompt's agent run resets `turn_start turn=0` and `agent_end` reports only that run's messages. The mapper cannot use PI `turnIndex` as a session-wide counter; session order comes from the session file's `parentId` chain. (Reinforces the §5a finding that PI turns ≠ LHC turns.)\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:163:- **Resume re-fires zero `message_end` events** (confirmed interactively, matching §5a) — history served via `context` only. Dedup is needed for `/reload` + crash-replay, not normal resume.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:191:**Epic A — Connector core (intake + lifecycle + inference host):** ~5–6 stories. SDK construction/teardown on session lifecycle, thread mapping + resume/reload/fork handling, message/turn event mapper (converter productionized), `ModelCall` + assignments config + startup validation, ordering/idempotency proof against recorded corpora.\ndocs/specs/02-pi-lhc/notes/pi-ext-integration-research.md:193:**Epic B — Context serving:** ~4–5 stories. The `context` hook path (pull → AgentMessage mapping), PI compaction interception, materialize fallback command, mid-turn/abort edge behavior, cache-stability verification (the whole point — byte-stable prefixes between compacts).\n","exit_code":0,"status":"completed"}}

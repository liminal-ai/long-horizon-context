{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/support.ts'","aggregated_output":"     1\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\n     2\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\n     3\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\n     4\t// converter → real LHC intake) so every capture test asserts on recorded\n     5\t// thread state, never on a mocked intake. The two external edges stay as the\n     6\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\n     7\t// SDK runs real against a temp SQLite thread with the deterministic provider\n     8\t// (selected by explicit name, never a production default).\n     9\timport {\n    10\t  createDeterministicProvider,\n    11\t  inspect,\n    12\t  intakeStream,\n    13\t  type EventKind,\n    14\t  type MessageEventInput,\n    15\t  type OpResult,\n    16\t  type SdkConfig,\n    17\t  type ThreadRef,\n    18\t} from \"lhc\";\n    19\timport { createConnector, type Connector } from \"../../src/index.js\";\n    20\timport type { LaunchFlags } from \"../../src/lifecycle/thread-resolution.js\";\n    21\timport type { ExtensionContext, SessionStartReason } from \"../../src/pi/types.js\";\n    22\timport { makeSessionStart } from \"../fixtures/synthetic.js\";\n    23\timport type { TempStore } from \"../fixtures/thread.js\";\n    24\t\n    25\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\n    26\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\n    27\t *  assume a TUI. */\n    28\texport function syntheticCtx(cwd = \"/work/capture\"): ExtensionContext {\n    29\t  return {\n    30\t    cwd,\n    31\t    hasUI: false,\n    32\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n    33\t    ui: { notify: () => {} },\n    34\t    sessionManager: { getEntries: () => [] },\n    35\t  };\n    36\t}\n    37\t\n    38\t/** The capture-suite SDK config: a real background instance on the\n    39\t *  deterministic provider, so a captured user_prompt's queued derivation has a\n    40\t *  handler to settle and never strands background work. */\n    41\texport function captureConfig(): OpResult<SdkConfig> {\n    42\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n    43\t}\n    44\t\n    45\texport interface StartedCapture {\n    46\t  connector: Connector;\n    47\t  ctx: ExtensionContext;\n    48\t  threadRef: ThreadRef;\n    49\t}\n    50\t\n    51\t/** Start a connector against a temp store under the given launch flags and fire\n    52\t *  `session_start{reason}`. The driver for existing-thread reattach: pass\n    53\t *  `{ session: threadId }` with reason `\"resume\"`/`\"reload\"` to attach a fresh\n    54\t *  connector to a thread a prior connector created. */\n    55\texport async function attachCapture(\n    56\t  store: TempStore,\n    57\t  launch: LaunchFlags,\n    58\t  reason: SessionStartReason,\n    59\t  cwd = \"/work/capture\",\n    60\t): Promise<StartedCapture> {\n    61\t  const connector = createConnector({\n    62\t    registryPath: store.registryPath,\n    63\t    newThreadFilePath: () => store.threadPath(),\n    64\t    parseLaunch: () => launch,\n    65\t    buildSdkConfig: () => captureConfig(),\n    66\t  });\n    67\t  const ctx = syntheticCtx(cwd);\n    68\t  await connector.handlers.session_start(ctx, makeSessionStart(reason));\n    69\t  const state = connector.getState();\n    70\t  if (state === null) throw new Error(\"attachCapture: session_start did not resolve a thread\");\n    71\t  return { connector, ctx, threadRef: state.threadRef };\n    72\t}\n    73\t\n    74\t/** Start a connector against a temp store and fire `session_start{new}` so a\n    75\t *  background instance + thread exist and the capture hooks are live. */\n    76\texport async function startCapture(store: TempStore, cwd = \"/work/capture\"): Promise<StartedCapture> {\n    77\t  return attachCapture(store, {}, \"new\", cwd);\n    78\t}\n    79\t\n    80\t/** Settle background work and dispose, then read the durable event log back in\n    81\t *  recorded order — capture's product is the stored thread, so tests assert on\n    82\t *  this. */\n    83\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\n    84\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \"shutdown\" });\n    85\t  const read = await intakeStream.listEvents(started.threadRef);\n    86\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n    87\t  // Strip the server-stamped fields so the comparison is over the logical\n    88\t  // intake shape the converter produced.\n    89\t  return read.value.map((record) => ({\n    90\t    eventKind: record.eventKind,\n    91\t    idempotencyKey: record.idempotencyKey,\n    92\t    actor: record.actor,\n    93\t    harness: record.harness,\n    94\t    payload: record.payload,\n    95\t  })) as MessageEventInput[];\n    96\t}\n    97\t\n    98\t/** The ordered event-kind sequence — the spine every capture test checks. */\n    99\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\n   100\t  return events.map((event) => event.eventKind);\n   101\t}\n   102\t\n   103\t/** Counts open/closed turns and total recorded events from the inspect\n   104\t *  overview (the real read-back surface, not a private query). */\n   105\texport async function turnCounts(\n   106\t  threadRef: ThreadRef,\n   107\t): Promise<{ open: number; closed: number; events: number }> {\n   108\t  const overview = await inspect.overview(threadRef);\n   109\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\n   110\t  return {\n   111\t    open: overview.value.turns.open,\n   112\t    closed: overview.value.turns.closed,\n   113\t    events: overview.value.events.count,\n   114\t  };\n   115\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/synthetic.ts'","aggregated_output":"     1\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\n     2\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\n     3\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\n     4\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\n     5\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\n     6\timport type { EventKind, MessageEventInput } from \"lhc\";\n     7\timport type {\n     8\t  AgentEndEvent,\n     9\t  AgentMessage,\n    10\t  AssistantMessage,\n    11\t  ContentPart,\n    12\t  MessageEndEvent,\n    13\t  PiStopReason,\n    14\t  SessionStartEvent,\n    15\t  SessionStartReason,\n    16\t  ToolResultMessage,\n    17\t  UserMessage,\n    18\t} from \"../../src/pi/types.js\";\n    19\t\n    20\t// ── LHC intake-event builder ─────────────────────────────────────────\n    21\t\n    22\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\n    23\t\n    24\tlet keyCounter = 0;\n    25\t/** Reset the per-call key counter so a test can build deterministic keys. */\n    26\texport function resetEventKeyCounter(): void {\n    27\t  keyCounter = 0;\n    28\t}\n    29\t\n    30\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n    31\t  user_prompt: () => ({ text: \"please read the file\" }),\n    32\t  assistant_text: () => ({ text: \"here is what I found\" }),\n    33\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n    34\t  runtime_note: () => ({ text: \"model changed: anthropic/claude → openai/gpt\" }),\n    35\t  tool_call: () => ({ toolCallId: \"call-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } }),\n    36\t  tool_result: () => ({ toolCallId: \"call-1\", content: \"contents of notes.txt\", isError: false }),\n    37\t  turn_end: () => ({}),\n    38\t};\n    39\t\n    40\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\n    41\t *  mismatch at a call site is a compile error; the final reconciliation goes\n    42\t *  through `unknown` (TS can't reduce a structural spread to the deferred\n    43\t *  Extract), with call-site safety living in the parameter types. */\n    44\texport function validEvent<K extends EventKind>(\n    45\t  kind: K,\n    46\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n    47\t): EventByKind<K> {\n    48\t  keyCounter += 1;\n    49\t  const base = {\n    50\t    eventKind: kind,\n    51\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\n    52\t    actor: \"fixture-actor\",\n    53\t    harness: \"pi\",\n    54\t    payload: defaultPayloads[kind](),\n    55\t  };\n    56\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    57\t}\n    58\t\n    59\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    60\t  return kinds.map((kind) => validEvent(kind));\n    61\t}\n    62\t\n    63\t// ── PI message builders ──────────────────────────────────────────────\n    64\t\n    65\texport function makeUserMessage(text = \"please read the file\"): UserMessage {\n    66\t  return { role: \"user\", content: [{ type: \"text\", text }] };\n    67\t}\n    68\t\n    69\texport interface AssistantToolCall {\n    70\t  id: string;\n    71\t  name: string;\n    72\t  arguments?: Record<string, unknown>;\n    73\t}\n    74\t\n    75\t/** Fans out to content parts in PI's confirmed order: thinking → text →\n    76\t *  toolCall×N (research §5a). */\n    77\texport function makeAssistantMessage(\n    78\t  opts: {\n    79\t    thinking?: string;\n    80\t    text?: string;\n    81\t    toolCalls?: AssistantToolCall[];\n    82\t    stopReason?: PiStopReason;\n    83\t  } = {},\n    84\t): AssistantMessage {\n    85\t  const content: ContentPart[] = [];\n    86\t  if (opts.thinking !== undefined) content.push({ type: \"thinking\", thinking: opts.thinking });\n    87\t  if (opts.text !== undefined) content.push({ type: \"text\", text: opts.text });\n    88\t  for (const call of opts.toolCalls ?? []) {\n    89\t    content.push({ type: \"toolCall\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\n    90\t  }\n    91\t  const msg: AssistantMessage = { role: \"assistant\", content };\n    92\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\n    93\t  return msg;\n    94\t}\n    95\t\n    96\texport function makeToolResult(opts: {\n    97\t  id: string;\n    98\t  isError?: boolean;\n    99\t  content?: string;\n   100\t}): ToolResultMessage {\n   101\t  const msg: ToolResultMessage = {\n   102\t    role: \"toolResult\",\n   103\t    toolCallId: opts.id,\n   104\t    content: [{ type: \"text\", text: opts.content ?? \"tool output\" }],\n   105\t  };\n   106\t  if (opts.isError !== undefined) msg.isError = opts.isError;\n   107\t  return msg;\n   108\t}\n   109\t\n   110\t// ── PI event-stream builders ─────────────────────────────────────────\n   111\t\n   112\texport function makeSessionStart(\n   113\t  reason: SessionStartReason = \"startup\",\n   114\t  previousSessionFile?: string,\n   115\t): SessionStartEvent {\n   116\t  const ev: SessionStartEvent = { reason };\n   117\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\n   118\t  return ev;\n   119\t}\n   120\t\n   121\texport function makeMessageEnd(message: AgentMessage): MessageEndEvent {\n   122\t  return { message };\n   123\t}\n   124\t\n   125\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\n   126\t  return { messages };\n   127\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/idempotency.test.ts'","aggregated_output":"     1\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\n     2\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n     3\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n     4\t// must add nothing the second time. The key goldens pin construction precedence:\n     5\t// PI entry id → provider response / tool-call id → content fingerprint, with\n     6\t// blockIndex and kind disambiguating one message's fan-out.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\n     9\timport { capture } from \"../../src/capture/converter.js\";\n    10\timport { eventKey } from \"../../src/capture/idempotency.js\";\n    11\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    12\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    13\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    14\timport type { AgentMessage } from \"../../src/pi/types.js\";\n    15\timport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\n    16\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    17\t\n    18\tlet store: TempStore;\n    19\tbeforeEach(() => {\n    20\t  store = tempStore();\n    21\t});\n    22\tafterEach(() => {\n    23\t  store.cleanup();\n    24\t});\n    25\t\n    26\tdescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n    27\t  it(\"is deterministic: identical input yields an identical key\", () => {\n    28\t    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n    29\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\n    30\t  });\n    31\t\n    32\t  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n    33\t    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n    34\t    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n    35\t    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n    36\t    expect(thinking).toContain(\"e1\");\n    37\t    // Same entry, different block → different key (fan-out stays distinct).\n    38\t    expect(text).not.toBe(thinking);\n    39\t    // Same entry + block, different kind → still distinct.\n    40\t    expect(textSameBlock).not.toBe(thinking);\n    41\t  });\n    42\t\n    43\t  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n    44\t    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n    45\t    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n    46\t    expect(call).toContain(\"call_a\");\n    47\t    expect(result).toContain(\"call_a\");\n    48\t    expect(call).not.toBe(result);\n    49\t  });\n    50\t\n    51\t  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n    52\t    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n    53\t    expect(key).toContain(\"resp_7\");\n    54\t  });\n    55\t\n    56\t  it(\"falls to a content fingerprint as last resort: same content same key, different content different key\", () => {\n    57\t    const a = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    58\t    const aAgain = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    59\t    const b = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"world\" });\n    60\t    expect(aAgain).toBe(a);\n    61\t    expect(b).not.toBe(a);\n    62\t  });\n    63\t\n    64\t  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n    65\t    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n    66\t    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n    67\t    expect(withBoth).toBe(entryOnly);\n    68\t  });\n    69\t});\n    70\t\n    71\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n    72\t  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n    73\t  const events: MessageEventInput[] = [];\n    74\t  source.forEach((message, index) => {\n    75\t    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n    76\t    acc.onMessage(mapped);\n    77\t    events.push(...mapped);\n    78\t  });\n    79\t  events.push(...acc.onAgentEnd());\n    80\t  return events;\n    81\t}\n    82\t\n    83\tdescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n    84\t  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n    85\t    const thread = await makeTempThread(store);\n    86\t    const built = await initInstance(thread.threadRef, {\n    87\t      provider: createDeterministicProvider(),\n    88\t      mode: \"background\",\n    89\t    });\n    90\t    expect(built.ok).toBe(true);\n    91\t    if (!built.ok) return;\n    92\t    const instance = built.value;\n    93\t\n    94\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n    95\t\n    96\t    const first = await capture(batch, instance);\n    97\t    expect(first.ok).toBe(true);\n    98\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    99\t\n   100\t    const replay = await capture(batch, instance);\n   101\t    expect(replay.ok).toBe(true);\n   102\t    if (replay.ok) {\n   103\t      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   104\t    }\n   105\t\n   106\t    const read = await intakeStream.listEvents(instance.threadRef);\n   107\t    expect(read.ok).toBe(true);\n   108\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   109\t\n   110\t    await instance.dispose();\n   111\t  });\n   112\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/reattach-idempotency.test.ts'","aggregated_output":"     1\t// Story 2 — SV-001 regression: existing-thread resume/reload must keep recording\n     2\t// new finalized events. The connector seeds its capture counters from the\n     3\t// thread's durable committed state at attach, so a fresh connector's idempotency\n     4\t// keys continue past the prior session's instead of restarting at 0 and\n     5\t// skipping new events as false duplicates — while the converter's same-key\n     6\t// dedup (the reload/replay safety net) stays intact.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  createDeterministicProvider,\n    10\t  intakeStream,\n    11\t  type MessageEventInput,\n    12\t  type ThreadRef,\n    13\t} from \"lhc\";\n    14\timport { capture } from \"../../src/capture/converter.js\";\n    15\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    16\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    17\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    18\timport {\n    19\t  makeAgentEnd,\n    20\t  makeAssistantMessage,\n    21\t  makeMessageEnd,\n    22\t  makeUserMessage,\n    23\t} from \"../fixtures/synthetic.js\";\n    24\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    25\timport { attachCapture, eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    26\t\n    27\tlet store: TempStore;\n    28\tbeforeEach(() => {\n    29\t  store = tempStore();\n    30\t});\n    31\tafterEach(() => {\n    32\t  store.cleanup();\n    33\t});\n    34\t\n    35\tfunction textOf(event: MessageEventInput): string {\n    36\t  return (event.payload as { text?: string }).text ?? \"\";\n    37\t}\n    38\t\n    39\tfunction userTexts(events: readonly MessageEventInput[]): string[] {\n    40\t  return events.filter((event) => event.eventKind === \"user_prompt\").map(textOf);\n    41\t}\n    42\t\n    43\tfunction threadIdOf(ref: ThreadRef): string {\n    44\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n    45\t  return ref.threadId;\n    46\t}\n    47\t\n    48\tdescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n    49\t  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n    50\t    // Session A records one exchange, then shuts down.\n    51\t    const a = await startCapture(store);\n    52\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    53\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    54\t    const threadId = threadIdOf(a.threadRef);\n    55\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n    56\t\n    57\t    // A brand-new connector attaches to the SAME thread by id and records a new\n    58\t    // message — it must NOT be skipped as a prior-key collision.\n    59\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n    60\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    61\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n    62\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    63\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    64\t\n    65\t    const events = await eventsAfterShutdown(b);\n    66\t    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n    67\t    const counts = await turnCounts(b.threadRef);\n    68\t    expect(counts.closed).toBe(2);\n    69\t  });\n    70\t\n    71\t  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n    72\t    const a = await startCapture(store);\n    73\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    74\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    75\t    const threadId = threadIdOf(a.threadRef);\n    76\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    77\t\n    78\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    79\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after reload\")));\n    80\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    81\t\n    82\t    const events = await eventsAfterShutdown(b);\n    83\t    expect(userTexts(events)).toEqual([\"first\", \"second after reload\"]);\n    84\t    const counts = await turnCounts(b.threadRef);\n    85\t    expect(counts.closed).toBe(2);\n    86\t  });\n    87\t\n    88\t  it(\"(2b) a reload re-delivering the same logical events skips them instead of recording duplicates\", async () => {\n    89\t    const a = await startCapture(store);\n    90\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    91\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    92\t    const threadId = threadIdOf(a.threadRef);\n    93\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    94\t\n    95\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    96\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    97\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    98\t\n    99\t    const events = await eventsAfterShutdown(b);\n   100\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"turn_end\"]);\n   101\t    expect(userTexts(events)).toEqual([\"first\"]);\n   102\t    const counts = await turnCounts(b.threadRef);\n   103\t    expect(counts.closed).toBe(1);\n   104\t\n   105\t    const built = await initInstance(b.threadRef, {\n   106\t      provider: createDeterministicProvider(),\n   107\t      mode: \"background\",\n   108\t    });\n   109\t    expect(built.ok).toBe(true);\n   110\t    if (!built.ok) return;\n   111\t    const instance = built.value;\n   112\t    const acc = new TurnAccumulator({ piSessionId: threadId });\n   113\t    const userEvents = mapMessage(makeUserMessage(\"first\"), { piSessionId: threadId });\n   114\t    acc.onMessage(userEvents);\n   115\t    const turnEnd = acc.onAgentEnd();\n   116\t    const replay = await capture([...userEvents, ...turnEnd], instance);\n   117\t    expect(replay.ok).toBe(true);\n   118\t    if (replay.ok) {\n   119\t      expect(replay.value.events).toEqual([\n   120\t        {\n   121\t          idempotencyKey: userEvents[0]!.idempotencyKey,\n   122\t          outcome: \"skipped\",\n   123\t          skipReason: \"duplicate_idempotency_key\",\n   124\t        },\n   125\t        {\n   126\t          idempotencyKey: turnEnd[0]!.idempotencyKey,\n   127\t          outcome: \"skipped\",\n   128\t          skipReason: \"duplicate_idempotency_key\",\n   129\t        },\n   130\t      ]);\n   131\t    }\n   132\t    await instance.dispose();\n   133\t  });\n   134\t\n   135\t  it(\"(3) normal resume records new messages and does not duplicate the prior session's history\", async () => {\n   136\t    // Session A: one complete turn.\n   137\t    const a = await startCapture(store);\n   138\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n   139\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer one\" })));\n   140\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   141\t    const threadId = threadIdOf(a.threadRef);\n   142\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n   143\t\n   144\t    // Resume: PI does not re-fire history, so the connector sees only the new\n   145\t    // turn — which must record, leaving the prior turn intact and un-duplicated.\n   146\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n   147\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second\")));\n   148\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer two\" })));\n   149\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   150\t\n   151\t    const events = await eventsAfterShutdown(b);\n   152\t    expect(kindsOf(events)).toEqual([\n   153\t      \"user_prompt\",\n   154\t      \"assistant_text\",\n   155\t      \"turn_end\",\n   156\t      \"user_prompt\",\n   157\t      \"assistant_text\",\n   158\t      \"turn_end\",\n   159\t    ]);\n   160\t    expect(userTexts(events)).toEqual([\"first\", \"second\"]);\n   161\t    // Two distinct closed turns — the turn_end keys did not collide either.\n   162\t    const counts = await turnCounts(b.threadRef);\n   163\t    expect(counts.closed).toBe(2);\n   164\t    expect(counts.open).toBe(0);\n   165\t  });\n   166\t\n   167\t  it(\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\", async () => {\n   168\t    const thread = await makeTempThread(store);\n   169\t    const built = await initInstance(thread.threadRef, {\n   170\t      provider: createDeterministicProvider(),\n   171\t      mode: \"background\",\n   172\t    });\n   173\t    expect(built.ok).toBe(true);\n   174\t    if (!built.ok) return;\n   175\t    const instance = built.value;\n   176\t\n   177\t    // Build one turn's events with stable keys, then deliver the SAME batch\n   178\t    // twice — the second delivery (the reload / crash-replay shape) must dedup.\n   179\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   180\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n   181\t    acc.onMessage(userEvents);\n   182\t    const batch = [...userEvents, ...acc.onAgentEnd()];\n   183\t\n   184\t    const first = await capture(batch, instance);\n   185\t    expect(first.ok).toBe(true);\n   186\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   187\t\n   188\t    const second = await capture(batch, instance);\n   189\t    expect(second.ok).toBe(true);\n   190\t    if (second.ok) expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   191\t\n   192\t    const read = await intakeStream.listEvents(instance.threadRef);\n   193\t    expect(read.ok).toBe(true);\n   194\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   195\t\n   196\t    await instance.dispose();\n   197\t  });\n   198\t});\n","exit_code":0,"status":"completed"}}

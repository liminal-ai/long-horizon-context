{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/capture/abort.test.ts'","aggregated_output":"     1\t// Story 2 — graceful interrupt (TC-2.6). A turn PI marks aborted is captured\n     2\t// whole: the partial assistant content is recorded, the aborted disposition is\n     3\t// carried through (the mapper carries stopReason — research §5b — onto the only\n     4\t// durable vehicle, a runtime_note), and the turn closes complete-but-aborted at\n     5\t// agent_end. The interrupted content is never discarded.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport type { MessageEventInput } from \"lhc\";\n     8\timport {\n     9\t  makeAgentEnd,\n    10\t  makeAssistantMessage,\n    11\t  makeMessageEnd,\n    12\t  makeUserMessage,\n    13\t} from \"../fixtures/synthetic.js\";\n    14\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    15\timport { eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    16\t\n    17\tlet store: TempStore;\n    18\tbeforeEach(() => {\n    19\t  store = tempStore();\n    20\t});\n    21\tafterEach(() => {\n    22\t  store.cleanup();\n    23\t});\n    24\t\n    25\tfunction textOf(event: MessageEventInput): string {\n    26\t  return (event.payload as { text?: string }).text ?? \"\";\n    27\t}\n    28\t\n    29\tdescribe(\"Story 2: graceful interrupt (TC-2.6)\", () => {\n    30\t  it(\"records partial assistant content, carries the aborted disposition, and closes the turn complete-but-aborted\", async () => {\n    31\t    const started = await startCapture(store);\n    32\t    const { connector, ctx, threadRef } = started;\n    33\t\n    34\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"write a long essay\")));\n    35\t    await connector.handlers.message_end(\n    36\t      ctx,\n    37\t      makeMessageEnd(\n    38\t        makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n    39\t      ),\n    40\t    );\n    41\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    42\t\n    43\t    // A graceful interrupt is not a capture failure.\n    44\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n    45\t\n    46\t    const events = await eventsAfterShutdown(started);\n    47\t    expect(kindsOf(events)).toEqual([\n    48\t      \"user_prompt\",\n    49\t      \"assistant_thinking\",\n    50\t      \"assistant_text\",\n    51\t      \"runtime_note\",\n    52\t      \"turn_end\",\n    53\t    ]);\n    54\t\n    55\t    // Partial content is preserved verbatim — nothing discarded.\n    56\t    expect(textOf(events[1]!)).toBe(\"starting the essay\");\n    57\t    expect(textOf(events[2]!)).toBe(\"Once upon a\");\n    58\t    // The aborted disposition is carried through on the runtime_note.\n    59\t    expect(textOf(events[3]!).toLowerCase()).toContain(\"abort\");\n    60\t\n    61\t    // The turn closes complete-but-aborted (closed at agent_end, not left open).\n    62\t    const counts = await turnCounts(threadRef);\n    63\t    expect(counts.closed).toBe(1);\n    64\t    expect(counts.open).toBe(0);\n    65\t  });\n    66\t});\n","exit_code":0,"status":"completed"}}

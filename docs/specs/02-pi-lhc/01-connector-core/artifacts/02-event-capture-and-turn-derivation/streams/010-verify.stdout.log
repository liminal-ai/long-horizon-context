{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/corpus.ts'","aggregated_output":"     1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n     2\t// named lifecycle paired with the LHC intake events it should produce. Until M0\n     3\t// delivers real recordings, the loaders build synthetic stand-ins; the\n     4\t// machinery (load → validate shape → compare on replay in Story 3) is real and\n     5\t// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n     6\t// hardcodes a passing count (story §Anti-Shim Requirements).\n     7\timport type { EventKind } from \"lhc\";\n     8\timport type { Corpus } from \"../../src/verify/replay.js\";\n     9\timport { ABORTED_DISPOSITION_TEXT } from \"../../src/capture/map-message.js\";\n    10\timport {\n    11\t  makeAssistantMessage,\n    12\t  makeToolResult,\n    13\t  makeUserMessage,\n    14\t  validEvent,\n    15\t} from \"./synthetic.js\";\n    16\t\n    17\tconst CALL_A = \"call_a|fc_1\";\n    18\tconst CALL_B = \"call_b|fc_2\";\n    19\t\n    20\t/** Plain user/assistant text exchanges, no tools. */\n    21\texport function loadChattyCorpus(): Corpus {\n    22\t  return {\n    23\t    name: \"chatty\",\n    24\t    source: [\n    25\t      makeUserMessage(\"what does this repo do?\"),\n    26\t      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n    27\t      makeUserMessage(\"and the connector?\"),\n    28\t      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n    29\t    ],\n    30\t    expected: [\n    31\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n    32\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n    33\t      validEvent(\"turn_end\"),\n    34\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n    35\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n    36\t      validEvent(\"turn_end\"),\n    37\t    ],\n    38\t  };\n    39\t}\n    40\t\n    41\t/** One turn with a single tool run: thinking → call → result → answer. */\n    42\texport function loadToolHeavyCorpus(): Corpus {\n    43\t  return {\n    44\t    name: \"tool-heavy\",\n    45\t    source: [\n    46\t      makeUserMessage(\"read notes.txt\"),\n    47\t      makeAssistantMessage({\n    48\t        thinking: \"I should open the file\",\n    49\t        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n    50\t      }),\n    51\t      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n    52\t      makeAssistantMessage({ text: \"the file says hello\" }),\n    53\t    ],\n    54\t    expected: [\n    55\t      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n    56\t      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n    57\t      validEvent(\"tool_call\", {\n    58\t        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    59\t      }),\n    60\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n    61\t      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n    62\t      validEvent(\"turn_end\"),\n    63\t    ],\n    64\t  };\n    65\t}\n    66\t\n    67\t/** Two parallel tool calls whose results complete out of order; correlation is\n    68\t *  by id, not arrival order (AC-2.3). */\n    69\texport function loadParallelToolCorpus(): Corpus {\n    70\t  return {\n    71\t    name: \"parallel-tool\",\n    72\t    source: [\n    73\t      makeUserMessage(\"read both files\"),\n    74\t      makeAssistantMessage({\n    75\t        toolCalls: [\n    76\t          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n    77\t          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n    78\t        ],\n    79\t      }),\n    80\t      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n    81\t      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n    82\t      makeAssistantMessage({ text: \"read both\" }),\n    83\t    ],\n    84\t    expected: [\n    85\t      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n    86\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n    87\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n    88\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n    89\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n    90\t      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n    91\t      validEvent(\"turn_end\"),\n    92\t    ],\n    93\t  };\n    94\t}\n    95\t\n    96\t/** A tool result flagged as an error, captured with its content (AC-2.4). */\n    97\texport function loadErrorResultCorpus(): Corpus {\n    98\t  return {\n    99\t    name: \"error-result\",\n   100\t    source: [\n   101\t      makeUserMessage(\"read missing.txt\"),\n   102\t      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n   103\t      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n   104\t      makeAssistantMessage({ text: \"that file does not exist\" }),\n   105\t    ],\n   106\t    expected: [\n   107\t      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n   108\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n   109\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n   110\t      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n   111\t      validEvent(\"turn_end\"),\n   112\t    ],\n   113\t  };\n   114\t}\n   115\t\n   116\t/** A graceful interrupt: partial assistant content, turn closed\n   117\t *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\n   118\texport function loadAbortedTurnCorpus(): Corpus {\n   119\t  return {\n   120\t    name: \"aborted-turn\",\n   121\t    source: [\n   122\t      makeUserMessage(\"write a long essay\"),\n   123\t      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n   124\t    ],\n   125\t    expected: [\n   126\t      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n   127\t      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n   128\t      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n   129\t      // The aborted disposition rides a trailing runtime_note (the mapper carries\n   130\t      // stopReason through; research §5b), then the turn closes complete-but-aborted.\n   131\t      validEvent(\"runtime_note\", { payload: { text: ABORTED_DISPOSITION_TEXT } }),\n   132\t      validEvent(\"turn_end\"),\n   133\t    ],\n   134\t  };\n   135\t}\n   136\t\n   137\texport const CORPUS_LOADERS = {\n   138\t  chatty: loadChattyCorpus,\n   139\t  \"tool-heavy\": loadToolHeavyCorpus,\n   140\t  \"parallel-tool\": loadParallelToolCorpus,\n   141\t  \"error-result\": loadErrorResultCorpus,\n   142\t  \"aborted-turn\": loadAbortedTurnCorpus,\n   143\t} as const;\n   144\t\n   145\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n   146\t\n   147\texport function loadAllCorpora(): Corpus[] {\n   148\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n   149\t}\n   150\t\n   151\t/** A deliberately malformed sequence for the capture-failure test: an empty\n   152\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n   153\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n   154\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n   155\texport function makeTruncatedCorpus(): Corpus {\n   156\t  return {\n   157\t    name: \"truncated\",\n   158\t    source: [makeUserMessage(\"\")],\n   159\t    expected: [\n   160\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n   161\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n   162\t    ],\n   163\t  };\n   164\t}\n   165\t\n   166\texport interface CorpusValidation {\n   167\t  valid: boolean;\n   168\t  problems: string[];\n   169\t}\n   170\t\n   171\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n   172\t  \"user_prompt\",\n   173\t  \"assistant_text\",\n   174\t  \"assistant_thinking\",\n   175\t  \"runtime_note\",\n   176\t  \"tool_call\",\n   177\t  \"tool_result\",\n   178\t  \"turn_end\",\n   179\t]);\n   180\t\n   181\t/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n   182\t *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n   183\t *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n   184\t *  found — `valid` is derived from that list, never a constant. */\n   185\texport function validateCorpus(corpus: Corpus): CorpusValidation {\n   186\t  const problems: string[] = [];\n   187\t  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n   188\t  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n   189\t\n   190\t  const seenToolCalls = new Set<string>();\n   191\t  for (const [i, ev] of corpus.expected.entries()) {\n   192\t    const at = `${corpus.name}[${i}]`;\n   193\t    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n   194\t    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n   195\t    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n   196\t    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n   197\t\n   198\t    switch (ev.eventKind) {\n   199\t      case \"user_prompt\":\n   200\t      case \"assistant_text\":\n   201\t      case \"assistant_thinking\":\n   202\t      case \"runtime_note\": {\n   203\t        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n   204\t          problems.push(`${at}: ${ev.eventKind} has empty text`);\n   205\t        }\n   206\t        break;\n   207\t      }\n   208\t      case \"tool_call\": {\n   209\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   210\t          problems.push(`${at}: tool_call has empty toolCallId`);\n   211\t        } else {\n   212\t          seenToolCalls.add(ev.payload.toolCallId);\n   213\t        }\n   214\t        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n   215\t          problems.push(`${at}: tool_call has empty toolName`);\n   216\t        }\n   217\t        break;\n   218\t      }\n   219\t      case \"tool_result\": {\n   220\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   221\t          problems.push(`${at}: tool_result has empty toolCallId`);\n   222\t        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n   223\t          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n   224\t        }\n   225\t        if (typeof ev.payload.content !== \"string\") {\n   226\t          problems.push(`${at}: tool_result has non-string content`);\n   227\t        }\n   228\t        break;\n   229\t      }\n   230\t      case \"turn_end\":\n   231\t        break;\n   232\t    }\n   233\t  }\n   234\t\n   235\t  const last = corpus.expected[corpus.expected.length - 1];\n   236\t  if (last !== undefined && last.eventKind !== \"turn_end\") {\n   237\t    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n   238\t  }\n   239\t\n   240\t  return { valid: problems.length === 0, problems };\n   241\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/state-machine.ts | sed -n '1,120p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/state-machine.ts | sed -n '1,120p'\"","aggregated_output":"     1\t// The turn rule table as a pure function (Flow 3). Every row of the epic's\n     2\t// table is one golden case against this function: prompt with no open turn →\n     3\t// open; prompt with open turn → close_then_open; turn_end with open turn →\n     4\t// close; turn_end with none → none; every other kind → none (stamping is\n     5\t// membership, not transition). The corruption row (>1 open turn) is handled\n     6\t// by the pipeline at state load, not here — only the pipeline writes turn\n     7\t// state, so a violation means external interference and fails the batch\n     8\t// before any event reaches this function.\n     9\timport type { EventKind } from \"../../intake-stream/index.js\";\n    10\t\n    11\texport interface TurnState {\n    12\t  openTurnId: string | null;\n    13\t}\n    14\t\n    15\texport type TurnEffect =\n    16\t  | { kind: \"none\" }\n    17\t  | { kind: \"open\" }\n    18\t  | { kind: \"close\" }\n    19\t  | { kind: \"close_then_open\" };\n    20\t\n    21\texport function transition(state: TurnState, eventKind: EventKind): TurnEffect {\n    22\t  switch (eventKind) {\n    23\t    case \"user_prompt\":\n    24\t      return state.openTurnId === null ? { kind: \"open\" } : { kind: \"close_then_open\" };\n    25\t    case \"turn_end\":\n    26\t      return state.openTurnId === null ? { kind: \"none\" } : { kind: \"close\" };\n    27\t    case \"assistant_text\":\n    28\t    case \"assistant_thinking\":\n    29\t    case \"runtime_note\":\n    30\t    case \"tool_call\":\n    31\t    case \"tool_result\":\n    32\t      return { kind: \"none\" };\n    33\t  }\n    34\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"entryId|message_end|AgentMessage|idempotency|turnIndex|toolCallId|model_select|thinking_level\" docs/specs/02-pi-lhc/notes docs/specs/02-pi-lhc/01-connector-core/epic.md docs/specs/02-pi-lhc/01-connector-core/tech-design.md packages/pi-lhc/src'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"entryId|message_end|AgentMessage|idempotency|turnIndex|toolCallId|model_select|thinking_level\" docs/specs/02-pi-lhc/notes docs/specs/02-pi-lhc/01-connector-core/epic.md docs/specs/02-pi-lhc/01-connector-core/tech-design.md packages/pi-lhc/src'","aggregated_output":"docs/specs/02-pi-lhc/01-connector-core/tech-design.md:16:The validation that mattered most: the epic's load-bearing claim is that an LHC turn is not a PI turn, and the converter must derive LHC turn boundaries from the agent-run bracket rather than from PI's per-step `turn_end`. The real PI event types confirm the shape the epic relies on — `turn_end` carries a per-agent-run `turnIndex` that resets to 0 each run, and `agent_end` brackets the whole run — so the contract is buildable against types that exist, not against an assumption.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:30:| I-5 | TDQ-5 | Converter structure — how it consumes `message_end` and emits batched `MessageEventInput[]`. | **Resolved.** The converter is two pure stages plus one stateful accumulator: `mapMessage` (one PI `AgentMessage` → ordered `MessageEventInput[]`, no I/O) and `deriveTurnClose` (decides when to emit `turn_end`), driven by a per-session `TurnAccumulator` that tracks the open LHC turn across `message_end`/`agent_end`. Batches flush through `intakeStream.messageEvents(threadRef, events)`. See Flow 2 design. |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:39:The shape of the work is set by two systems that already exist and are not being changed. PI fires lifecycle hooks (`session_start`, `message_end`, `turn_end`, `agent_end`, `session_shutdown`, fork/switch) and an extension subscribes to them; this is a fixed, versioned contract verified against v0.79.2 by live recon. The LHC SDK is constructed once per session (`initLhc`, the agreed rename of the current `createSdk`), exposes operation surfaces (`intakeStream`, `threads`, `inspect`, the background work scheduler), and persists one SQLite file per thread. The connector is the tissue between them: it translates PI's events into LHC intake operations, and translates LHC's need for inference back into PI's authenticated model registry. It owns no context state of its own beyond a thread reference and a few told-the-user flags, because PI tears down and replaces its session objects on every new/resume/fork transition, and a cached reference to one of those objects is a latent crash.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:41:Three forces shaped the central decisions. First, **PI's turn is not LHC's turn** — PI brackets each agent step with `turn_start`/`turn_end` and resets `turnIndex` to 0 per agent run, while an LHC turn spans a whole exchange. The converter must derive LHC turn boundaries from the agent-run bracket (`agent_end`), and the recon that established this is the reason the epic could be written without guessing. Second, **capture must never break the session** — malformed input on a writable thread degrades to a recorded, queryable gap; store-unavailable failures degrade to extension-level health diagnostics; neither throws back into a PI hook. Third, **derivations must close the loop on the user's own logins** — LHC asks for completions through a single host-supplied function that resolves provider/model through PI's registry, so there is no second credential store and no separate login.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:45:The connector also inherits a body of prior art. A POC extension (`src/context-steward/pi/`, ~3,900 lines across the mapper, the parallel-event intake, and the extension shell) already solved much of the hard mapping — idempotency-key construction, parallel-tool correlation, unsupported-part degradation — against an older LHC storage API. This epic productionizes that logic against the current, leaner SDK surface (plain-string `actor`/`harness`, per-event `idempotencyKey`, the seven-kind `MessageEventInput` union), so the converter is a rewrite informed by the POC, not a port of it. The POC's stale-context handling, by contrast, dies here: the tech arch's plain-data-only rule replaces it.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:56:    H[\"hook surface\\nsession_start, message_end,\\nturn_end, agent_end, shutdown, fork\"]\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:93:| `message_end` | `message: AgentMessage` (user / assistant / toolResult) | Map to `MessageEventInput[]`, batch into intake |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:94:| `turn_end` | `turnIndex` (per-agent-run), `message`, `toolResults[]`, `stopReason` | Update accumulator; **never** a 1:1 LHC `turn_end` |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:96:| `model_select` | `model`, `previousModel`, `source` | Capture as a `runtime_note` event (AC-2.8) |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:97:| `thinking_level_select` | `level`, `previousLevel` | Capture as a `runtime_note` event (AC-2.8) |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:98:| `session_before_fork` | `entryId`, `position` | Capture the fork point for replay-seeding |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:108:| `intakeStream` | `messageEvents(threadRef, MessageEventInput[])` → `BatchResult` | Record capture; dedup by idempotency key |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:157:      map-message.ts               NEW  pure: AgentMessage → MessageEventInput[]\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:159:      idempotency.ts               NEW  pure: stable per-event key construction\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:169:      synthetic.ts                 NEW  synthetic AgentMessage / event builders\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:189:| `capture/map-message.ts` | NEW | Pure map of one `AgentMessage` to ordered events; fan-out; parallel-tool correlation; error-result; abort; unsupported→runtime_note | idempotency | AC-2.1, AC-2.3, AC-2.4, AC-2.5 |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:191:| `capture/runtime-changes.ts` | NEW | Map `model_select` / `thinking_level_select` hooks to ordered `runtime_note` events (new + previous value) | `lhc` intakeStream | AC-2.8 |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:192:| `capture/idempotency.ts` | NEW | Construct a stable key per event so re-delivery dedups | — | AC-2.6 |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:213:  PI->>IDX: message_end / turn_end / agent_end\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:227:Each flow below opens with the context that makes its mechanics make sense, then a sequence diagram annotated with the ACs it satisfies, then a skeleton-requirements table and the TC approaches. The depth is uneven on purpose: turn derivation, idempotency, reattach, the inference adapter, and fork-replay carry the design's risk and get the most room; thread creation and config loading are mechanical and get less.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:274:This is the densest flow and the one the epic was written to get right. Each finalized PI message becomes an ordered run of LHC intake events; the subtlety is entirely in turns. PI emits `turn_start`/`turn_end` per agent step and resets `turnIndex` to 0 at the start of each agent run, so an agent run that takes three steps emits three PI turns. An LHC turn is the whole exchange — the user prompt and every step the agent took until the next prompt. The converter therefore ignores PI's per-step `turn_end` as a boundary signal and closes the LHC turn at `agent_end`.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:276:The converter is three pieces. `map-message.ts` is pure: it takes one `AgentMessage` and returns the ordered events for it — a user message becomes one `user_prompt`; an assistant message fans out to `assistant_thinking` (if present), then `assistant_text` (if present), then one `tool_call` per call, in that order; a tool result becomes one `tool_result` correlated to its call by `toolCallId`, carrying `isError` when the tool failed. `turn-accumulator.ts` holds the open-turn state and decides when to emit the single `turn_end`. `converter.ts` orchestrates, batches the events, and flushes them through `intakeStream.messageEvents`, isolating failures so writable-thread failures become recorded gaps and store-unavailable failures become extension diagnostics rather than thrown exceptions.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:283:  message_end(user [text])               assistant_thinking\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:284:  message_end(assistant                  tool_call (id=a)\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:286:  message_end(toolResult b)              tool_result (id=b)\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:287:  message_end(toolResult a)              tool_result (id=a)\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:290:  message_end(assistant [text])\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:295:The two tool results arrive in the order `b` then `a`, and each correlates to its call by id, not by arrival order — the parallel-tool contract (AC-2.3). PI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` fires at `agent_end`. Session order derives from converter source-event order, never from `turnIndex`.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:303:  PI->>CV: message_end(user)\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:307:  PI->>CV: message_end(assistant [thinking,toolCall×2])\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:309:  PI->>CV: message_end(toolResult) ×2 (out of order)\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:317:  Note over CV,IS: AC-2.6 dedup by idempotency key — AC-2.7 failure to gap\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:324:| Map one message | `capture/map-message.ts` | `mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[]` | pure; `NotImplementedError` until Green |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:326:| Idempotency key | `capture/idempotency.ts` | `eventKey(parts): string` | pure; deterministic |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:329:The idempotency key gets real depth because dedup correctness (AC-2.6) and crash-replay both depend on it. Construction precedence, carried from the POC and adapted to the SDK's per-event-key field: PI entry id when present (`pi:<session>:<entryId>:<block>:<kind>`), else provider `responseId` (assistant) or `toolCallId` (tool result), else a `role:timestamp:content-hash` fallback. The contract is that the key is identical across re-delivery of the same logical event and distinct across different events; the SDK's `messageEvents` returns `skipped` with `skipReason: duplicate_idempotency_key` for a re-delivered key, which is the dedup mechanism the test asserts against.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:333:A fork produces a new LHC thread seeded by replay, and never writes the source. Detection does not depend on a `session_start` fork reason: recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present. In Epic 1, PI still runs its own session, so PI's session tree (the `parentId` chain) is available as additional fork evidence when the hook is absent. This is an Epic-1 convenience, not the permanent design: the long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial), so the design must not harden PI's session tree into a permanent dependency.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:459:export interface MapCtx { piSessionId: string; entryId?: string; }\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:460:export function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[];\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:463:// model_select / thinking_level_select hooks → runtime_note events, in order.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:479:// capture/idempotency.ts — AC-2.6\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:481:  piSessionId: string; entryId?: string; responseId?: string;\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:482:  toolCallId?: string; blockIndex: number; kind: MessageEventInput[\"eventKind\"];\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:542:| Idempotency / Retry | `capture/idempotency.test.ts` | Replaying the same corpus twice produces no duplicate events; re-delivered keys come back `skipped` | TC checks dedup once; the hazard is re-delivery under reload/replay being safe |\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:580:Idempotency-key construction is deterministic but its golden cases live with the idempotency risk test rather than here.\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:594:   /          \\ Module tests: map-message, turn-accumulator, idempotency,\ndocs/specs/02-pi-lhc/01-connector-core/tech-design.md:656:**Scope:** the converter, fan-out, turn derivation, runtime metadata capture, parallel correlation, error/abort capture, dedup, failure isolation. **ACs:** 2.1–2.8. **Relevant sections:** Flow 2, `capture/*`, Idempotency + Atomicity risks, Deterministic Boundaries (turn derivation). **Architecture-risk tests:** idempotency double-replay, mid-batch failure isolation. **Risk shape:** the highest-risk chunk; turn derivation is the load-bearing mechanic; capture failure must isolate.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:63:- Event capture: PI messages and turns mapped to LHC intake events (the productionized converter), preserving order and idempotency.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:93:| A-3 | PI resume serves prior history through the context hook and re-fires no historical `message_end` events; duplication arises only on reload and crash-replay. | Validated (recon) | If resume re-fired history, dedup load would be higher. Idempotency keys (Flow 2) already cover the reload/replay paths, so the contract holds either way. |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:154:  PI->>E: message_end(user)\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:156:  PI->>E: message_end(assistant [thinking,text,toolCall×N])\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:158:  PI->>E: message_end(toolResult) ×N\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:159:  E->>L: tool_result×N (correlated by toolCallId)\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:165:**AC-2.1:** Every PI message finalized through `message_end` — user, assistant, tool result — is mapped to LHC intake events and recorded in source order. An assistant message fans out to per-content-part events in thinking → text → tool-call order: `assistant_thinking`, `assistant_text`, and one `tool_call` per call.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:167:**AC-2.2:** LHC turn boundaries are derived from PI traffic, not from PI's per-agent-step `turn_end`. One LHC turn spans a user prompt and all subsequent agent activity until the next user prompt or the end of the agent run. The converter emits exactly one LHC `turn_end` event per LHC turn, at the agent run's completion — never one per PI `turn_end`, and never keyed off PI's per-agent-run `turnIndex` as a session counter.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:169:**AC-2.3:** Parallel tool calls are captured with correct correlation: when one assistant message carries multiple `tool_call` parts and their results complete out of arrival order, each `tool_result` event is matched to its call by `toolCallId`, not by arrival order.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:175:**AC-2.6:** Capture is duplicate-safe. Re-delivered events (reload, crash-replay) are recognized by idempotency key and skipped rather than recorded twice. On normal resume PI re-delivers no historical events, so duplication only arises on the reload and replay paths.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:179:**AC-2.8:** Runtime changes that PI fires only in-stream — model selection (`model_select`) and thinking-level selection (`thinking_level_select`) — are captured in order as `runtime_note` events carrying the change (the new model or level, and the previous one). These are recorded at the moment they fire because no durable record holds them otherwise; nothing in this epic consumes them, and their presence in the thread is what lets later epics attribute a turn to the model that produced it.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:248:| `message_end` | finalized `user` / `assistant` / `toolResult` message | Map to LHC intake events |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:249:| `turn_end` | `turnIndex` (per-agent-run), `message`, `toolResults[]`, `stopReason` | Signal an agent step ended; **not** mapped 1:1 to LHC `turn_end` |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:251:| `model_select` | `model`, `previousModel`, `source` | Capture as a `runtime_note` event (AC-2.8) |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:252:| `thinking_level_select` | `level`, `previousLevel` | Capture as a `runtime_note` event (AC-2.8) |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:254:| `session_before_fork` | `entryId`, `position` | The fork point when present; otherwise PI's session tree is Epic-1 fallback evidence (permanent lineage is LHC metadata, Feature 2+) |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:260:The converter emits LHC `MessageEventInput` events. Each carries `eventKind`, `idempotencyKey`, `actor`, `harness`, and a kind-fixed `payload`. The seven kinds and their payloads:\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:267:| `tool_call` | `{ toolCallId, toolName, arguments }` |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:268:| `tool_result` | `{ toolCallId, content, isError? }` |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:274:| PI message (`message_end`) | LHC events emitted (in order) |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:278:| toolResult `[text]`, `isError?` | one `tool_result` (correlated by `toolCallId`) |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:283:Runtime-change events: PI's `model_select` and `thinking_level_select` map to `runtime_note` events (AC-2.8). The note text is structured enough to recover the change — the new value and the previous one — but it rides the existing `runtime_note` kind, adding no new intake kind.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:287:| `model_select` `{model, previousModel}` | one `runtime_note` recording the model change |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:288:| `thinking_level_select` `{level, previousLevel}` | one `runtime_note` recording the level change |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:292:PI fires `turn_start`/`turn_end` per agent step, and resets `turnIndex` to 0 at the start of each agent run. An LHC turn is a whole exchange. The converter derives LHC turns from PI traffic:\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:302:  message_end(user [text])\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:303:  message_end(assistant [thinking, toolCall, toolCall])\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:304:  message_end(toolResult) × 2\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:307:  message_end(assistant [text])\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:319:PI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` is emitted at `agent_end`. Session order comes from source-event order through the converter, never from PI's per-agent-run `turnIndex`.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:325:| Graceful interrupt | assistant `message_end` with partial content and `stopReason: aborted`; `turn_end` `aborted`; `agent_end` fires | Capture the partial content; carry the aborted disposition; close the LHC turn normally (a complete-but-aborted turn) |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:326:| Hard kill | user `message_end` only; no assistant close, no `turn_end`, no `agent_end` | On reattach, find a dangling open turn with a trailing user prompt; tolerate it (LHC `turn_end`-with-no-open-turn is a no-op); resume capture without duplicating the recorded prefix |\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:330:Each emitted event carries a stable idempotency key so re-delivery (reload, crash-replay) is recognized and skipped. Construction precedence (from the POC mapper, carried forward): PI entry id (`pi:<session>:entry:<entryId>`) → provider response id / tool-call id → content fingerprint as last resort. The exact construction is tech design; the contract is that the key is stable across re-delivery of the same logical event and unique across distinct events.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:345:Fork is the one case where a thread is created mid-run rather than chosen at launch. Fork detection does not depend on a `session_start` fork reason — recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present; in Epic 1, PI's session tree (the `parentId` chain) is also available as fork evidence, because PI still runs its own session here. The seeded thread is built by replay (Flow 3) and the source thread is never written. The long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial); this epic does not depend on PI's session tree as the permanent source.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:399:3. **Converter structure** — the converter is the productionized M0 prototype; how it consumes `message_end` streams and emits batched `MessageEventInput[]` per the `intakeStream.messageEvents` contract.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:432:**Delivers:** The converter — PI `message_end` → LHC intake events with content-part fan-out, turn derivation (PI per-step turns collapsed to one LHC turn), parallel-tool correlation, error-result and aborted-turn capture, idempotency-keyed dedup, capture-failure isolation.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:539:- **TC-2.3** — Session order derives from converter source-event order, not `turnIndex`; two agent runs each starting at `turnIndex 0` order correctly.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:540:- **TC-2.4** — Parallel tool calls with out-of-order completion correlate each result to its call by `toolCallId`.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:543:- **TC-2.7** — A re-delivered event (reload/replay) is skipped by idempotency key; a normal resume re-delivers no historical events.\ndocs/specs/02-pi-lhc/01-connector-core/epic.md:545:- **TC-2.9** — A `model_select` and a `thinking_level_select` each record an ordered `runtime_note` event carrying the new and previous values; ordering relative to surrounding messages is preserved.\npackages/pi-lhc/src/index.ts:50:  \"message_end\",\npackages/pi-lhc/src/index.ts:53:  \"model_select\",\npackages/pi-lhc/src/index.ts:54:  \"thinking_level_select\",\npackages/pi-lhc/src/index.ts:107: *  accumulator plus the stable PI session id used to scope idempotency keys.\npackages/pi-lhc/src/index.ts:115:/** A stable per-session id for idempotency-key scoping — the resolved thread's\npackages/pi-lhc/src/index.ts:127: *  (message_end is a no-op until Story 2) and lands no work handlers, so no\npackages/pi-lhc/src/index.ts:341:    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\npackages/pi-lhc/src/index.ts:346:  // message_end: map the finalized PI message to ordered LHC events, track the\npackages/pi-lhc/src/index.ts:348:  const onMessageEnd: PiHookHandle
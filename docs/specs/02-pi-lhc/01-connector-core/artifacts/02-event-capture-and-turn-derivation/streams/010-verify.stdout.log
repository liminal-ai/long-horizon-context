{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/index.ts | sed -n '1,460p'\"","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type {\n    11\t  BatchResult,\n    12\t  DerivationProvider,\n    13\t  MessageEventInput,\n    14\t  OpResult,\n    15\t  ProviderResult,\n    16\t  SdkConfig,\n    17\t  ThreadRef,\n    18\t} from \"lhc\";\n    19\timport type {\n    20\t  ExtensionAPI,\n    21\t  ExtensionContext,\n    22\t  PiHookHandler,\n    23\t  PiHookName,\n    24\t} from \"./pi/types.js\";\n    25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    26\timport { createSessionState } from \"./lifecycle/state.js\";\n    27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    28\timport {\n    29\t  parseLaunchFlags,\n    30\t  resolveReloadThread,\n    31\t  resolveThread,\n    32\t  type LaunchFlags,\n    33\t  type ResolveDeps,\n    34\t} from \"./lifecycle/thread-resolution.js\";\n    35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    36\timport { capture } from \"./capture/converter.js\";\n    37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n    38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n    39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n    40\timport type { LhcInstance } from \"./shared/instance.js\";\n    41\t\n    42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    43\texport type { LhcInstance } from \"./shared/instance.js\";\n    44\t\n    45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    47\t *  registers no handler for it (story Scope Out). */\n    48\texport const EPIC_1_HOOKS = [\n    49\t  \"session_start\",\n    50\t  \"message_end\",\n    51\t  \"turn_end\",\n    52\t  \"agent_end\",\n    53\t  \"model_select\",\n    54\t  \"thinking_level_select\",\n    55\t  \"session_before_fork\",\n    56\t  \"session_before_switch\",\n    57\t  \"session_shutdown\",\n    58\t] as const satisfies readonly PiHookName[];\n    59\t\n    60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    61\t\n    62\t/** What the connector needs from the host to run a session. Every dependency\n    63\t *  has a working production default; the overrides exist for test isolation\n    64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n    65\t *  in the PI-auth-backed inference config.\n    66\t *\n    67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n    68\t *  default is the observe-only config below (a real, construction-valid SDK);\n    69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n    70\texport interface ConnectorDeps {\n    71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    72\t  registryPath?: string;\n    73\t  newThreadFilePath?: () => string;\n    74\t  parseLaunch?: () => LaunchFlags;\n    75\t  selectThread?: (\n    76\t    choices: readonly ThreadChoice[],\n    77\t    ctx: ExtensionContext,\n    78\t  ) => Promise<string | null>;\n    79\t}\n    80\t\n    81\t/** Everything the connector retains across hooks as PLAIN data — by\n    82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    84\t *  deliberately not part of the snapshot. */\n    85\texport interface ConnectorSnapshot {\n    86\t  state: SessionState | null;\n    87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    88\t}\n    89\t\n    90\texport interface Connector {\n    91\t  /** Register the observe-only hook rail on the PI extension API. */\n    92\t  register(pi: ExtensionAPI): void;\n    93\t  /** The plain-data state retained across hooks. `null` until a session\n    94\t   *  resolves a thread; never holds a PI ctx. */\n    95\t  getState(): SessionState | null;\n    96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n    97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n    98\t  getInstance(): LhcInstance | null;\n    99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n   100\t  snapshot(): ConnectorSnapshot;\n   101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   102\t   *  synthetic ctx/events without a live PI. */\n   103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n   104\t}\n   105\t\n   106\t/** The connector's live capture state for one session: the open-turn\n   107\t *  accumulator plus the stable PI session id used to scope idempotency keys.\n   108\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n   109\t *  per session, never part of the plain-data snapshot and never a PI object. */\n   110\tinterface CaptureSession {\n   111\t  piSessionId: string;\n   112\t  accumulator: TurnAccumulator;\n   113\t}\n   114\t\n   115\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n   116\t *  identity, which survives reload/replay (the same thread re-resolves to the\n   117\t *  same id). */\n   118\tfunction sessionIdOf(ref: ThreadRef): string {\n   119\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n   120\t}\n   121\t\n   122\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n   123\t\n   124\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n   125\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n   126\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n   127\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n   128\t *  derivation work is ever queued and this provider is never invoked — it exists\n   129\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n   130\t *\n   131\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n   132\t *  documents as \"selectable only by explicit name — never a production default\"\n   133\t *  (it would mark fake derived text into the thread). Failing closed preserves\n   134\t *  the observe-only guarantee even if a future change queued work before Stories\n   135\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n   136\t *  assignments), which is what a real *completing* inference requires (the\n   137\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n   138\tfunction observeOnlyProvider(): DerivationProvider {\n   139\t  const notConfigured = (): Promise<ProviderResult> =>\n   140\t    Promise.resolve({\n   141\t      ok: false,\n   142\t      retryable: false,\n   143\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n   144\t    });\n   145\t  return {\n   146\t    smoothPrompt: notConfigured,\n   147\t    summarizeToolCall: notConfigured,\n   148\t    summarizeToolResult: notConfigured,\n   149\t    composeTurnRendering: notConfigured,\n   150\t    projectLowerBand: notConfigured,\n   151\t    summarizeChunkDetailed: notConfigured,\n   152\t    summarizeChunkBrief: notConfigured,\n   153\t  };\n   154\t}\n   155\t\n   156\t/** The production observe-only SDK config: a real, construction-valid instance\n   157\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n   158\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n   159\t *  config. */\n   160\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n   161\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n   162\t}\n   163\t\n   164\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n   165\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n   166\t *  show. */\n   167\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n   168\t  const lines = choices.map((choice, i) => {\n   169\t    const title = choice.title ?? \"(untitled)\";\n   170\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n   171\t  });\n   172\t  return [\n   173\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n   174\t    ...lines,\n   175\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n   176\t  ].join(\"\\n\");\n   177\t}\n   178\t\n   179\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n   180\t *  interactive input/selection surface (wiring research), so the production\n   181\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n   182\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n   183\t *  most recently created thread as the best available explicit default. The\n   184\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n   185\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n   186\t *  A true interactive picker awaits a PI input surface; until then resuming a\n   187\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n   188\t *  precise spec deviation. */\n   189\tfunction defaultSelectThread(\n   190\t  choices: readonly ThreadChoice[],\n   191\t  ctx: ExtensionContext,\n   192\t): Promise<string | null> {\n   193\t  const mostRecent = choices.at(-1);\n   194\t  if (mostRecent === undefined) return Promise.resolve(null);\n   195\t  if (ctx.hasUI) {\n   196\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   197\t  }\n   198\t  return Promise.resolve(mostRecent.threadId);\n   199\t}\n   200\t\n   201\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   202\t *  generated by the registry at creation, so the file name is just a unique\n   203\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   204\t *  parents). */\n   205\tfunction defaultNewThreadFilePath(): string {\n   206\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   207\t  mkdirSync(dir, { recursive: true });\n   208\t  return join(dir, `${randomUUID()}.sqlite`);\n   209\t}\n   210\t\n   211\t/** Build a connector instance. Its mutable state lives in this closure; the\n   212\t *  registered handlers capture it, so the instance stays live for the session\n   213\t *  even when `activate` discards the returned object. The connector holds NO\n   214\t *  module-level or durable state of its own — reload reconstructs the thread from\n   215\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n   216\t *  closure reattaches correctly (AC-1.5). */\n   217\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   218\t  // The connector's retained state. `state` is plain data (the durable thread\n   219\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   220\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n   221\t  // none survives the connector — reload re-resolves from the registry.\n   222\t  let state: SessionState | null = null;\n   223\t  let instance: LhcInstance | null = null;\n   224\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   225\t  let captureSession: CaptureSession | null = null;\n   226\t\n   227\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n   228\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   229\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   230\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n   231\t\n   232\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   233\t    return { code, message, recordedGap: false };\n   234\t  }\n   235\t\n   236\t  // The registry/file deps every resolver path shares. `registryPath` is set\n   237\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n   238\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n   239\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n   240\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n   241\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   242\t    return resolveDeps;\n   243\t  }\n   244\t\n   245\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n   246\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n   247\t  // no-flag creates).\n   248\t  async function resolveForLaunch(\n   249\t    launch: LaunchFlags,\n   250\t    ctx: ExtensionContext,\n   251\t  ): Promise<OpResult<ThreadRef | null>> {\n   252\t    if (launch.resume === true) {\n   253\t      const pickerDeps: {\n   254\t        registryPath?: string;\n   255\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n   256\t      } = { select: (choices) => selectThread(choices, ctx) };\n   257\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n   258\t      return pickThread(ctx.cwd, pickerDeps);\n   259\t    }\n   260\t    return resolveThread(launch, buildResolveDeps(ctx));\n   261\t  }\n   262\t\n   263\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n   264\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n   265\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n   266\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n   267\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n   268\t  async function resolveReloadFor(\n   269\t    launch: LaunchFlags,\n   270\t    ctx: ExtensionContext,\n   271\t  ): Promise<OpResult<ThreadRef | null>> {\n   272\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n   273\t  }\n   274\t\n   275\t  // session_start: resolve the recording thread and construct one background\n   276\t  // instance against it. Config is gated first so a session with no usable\n   277\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n   278\t  // thread is re-resolved from the durable registry (reattach, never create);\n   279\t  // every other reason runs the normal launch resolution.\n   280\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   281\t    const config = buildSdkConfig(ctx);\n   282\t    if (!config.ok) {\n   283\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   284\t      return;\n   285\t    }\n   286\t    const launch = parseLaunch();\n   287\t    const isReload = event.reason === \"reload\";\n   288\t    const resolved = isReload\n   289\t      ? await resolveReloadFor(launch, ctx)\n   290\t      : await resolveForLaunch(launch, ctx);\n   291\t    if (!resolved.ok) {\n   292\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   293\t      return;\n   294\t    }\n   295\t    if (resolved.value === null) {\n   296\t      lastDiagnostic = isReload\n   297\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n   298\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   299\t      return;\n   300\t    }\n   301\t    const built = await initInstance(resolved.value, config.value);\n   302\t    if (!built.ok) {\n   303\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   304\t      return;\n   305\t    }\n   306\t    instance = built.value;\n   307\t    state = createSessionState(resolved.value);\n   308\t    const piSessionId = sessionIdOf(resolved.value);\n   309\t    captureSession = {\n   310\t      piSessionId,\n   311\t      accumulator: new TurnAccumulator({ piSessionId }),\n   312\t    };\n   313\t  };\n   314\t\n   315\t  // Dispose with flush before any session swap (session_before_switch fires\n   316\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   317\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n   318\t  // re-resolves its thread from the durable registry on the next session_start.\n   319\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   320\t    const result = await disposeInstance(instance);\n   321\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   322\t    instance = null;\n   323\t    captureSession = null;\n   324\t  };\n   325\t\n   326\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n   327\t  // converter already recorded a durable gap for a writable-thread malformed\n   328\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n   329\t  // surfaces as an extension health signal with no gap. Neither path throws.\n   330\t  function recordCaptureOutcome(\n   331\t    result: OpResult<BatchResult>,\n   332\t    events: readonly MessageEventInput[],\n   333\t  ): void {\n   334\t    if (result.ok) return;\n   335\t    const recordedGap = result.error.code === \"invalid_event\";\n   336\t    const failure: CaptureFailureDiagnostic = {\n   337\t      code: result.error.code,\n   338\t      message: result.error.reason,\n   339\t      recordedGap,\n   340\t    };\n   341\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n   342\t    lastDiagnostic = failure;\n   343\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   344\t  }\n   345\t\n   346\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   347\t  // open turn, and flush through the converter (AC-2.1).\n   348\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   349\t    if (instance === null || captureSession === null) return;\n   350\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId };\n   351\t    const events = mapMessage(event.message, mapCtx);\n   352\t    captureSession.accumulator.onMessage(events);\n   353\t    if (events.length === 0) return;\n   354\t    recordCaptureOutcome(await capture(events, instance), events);\n   355\t  };\n   356\t\n   357\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   358\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   359\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   360\t    if (instance === null || captureSession === null) return;\n   361\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId };\n   362\t    const note = mapModelSelect(event, mapCtx);\n   363\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   364\t  };\n   365\t\n   366\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   367\t    if (instance === null || captureSession === null) return;\n   368\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId };\n   369\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   370\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   371\t  };\n   372\t\n   373\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n   374\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n   375\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n   376\t    if (instance === null || captureSession === null) return;\n   377\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n   378\t    if (turnEnd.length === 0) return;\n   379\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n   380\t  };\n   381\t\n   382\t  // Contain every handler: an observe-only hook must never throw back into PI\n   383\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   384\t  // plain-data diagnostic; it is never rethrown.\n   385\t  const guard = (\n   386\t    name: Epic1Hook,\n   387\t    body: PiHookHandler<Epic1Hook>,\n   388\t  ): PiHookHandler<Epic1Hook> => {\n   389\t    return async (ctx, event): Promise<void> => {\n   390\t      try {\n   391\t        await body(ctx, event);\n   392\t      } catch (err) {\n   393\t        lastDiagnostic = {\n   394\t          code: \"hook_handler_error\",\n   395\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   396\t          recordedGap: false,\n   397\t        };\n   398\t      }\n   399\t    };\n   400\t  };\n   401\t\n   402\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n   403\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n   404\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n   405\t  // FRESH ctx and retains none of it.\n   406\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   407\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n   408\t  };\n   409\t\n   410\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n   411\t  // are live; PI per-step turn_end and fork remain no-ops.\n   412\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   413\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   414\t    session_before_switch: onDispose,\n   415\t    session_shutdown: onDispose,\n   416\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n   417\t    turn_end: noop,\n   418\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n   419\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n   420\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n   421\t    session_before_fork: noop,\n   422\t  };\n   423\t\n   424\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   425\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   426\t\n   427\t  return {\n   428\t    handlers,\n   429\t    register(pi: ExtensionAPI): void {\n   430\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   431\t    },\n   432\t    getState(): SessionState | null {\n   433\t      return state;\n   434\t    },\n   435\t    getInstance(): LhcInstance | null {\n   436\t      return instance;\n   437\t    },\n   438\t    snapshot(): ConnectorSnapshot {\n   439\t      return { state, lastDiagnostic };\n   440\t    },\n   441\t  };\n   442\t}\n   443\t\n   444\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   445\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n   446\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n   447\t *  observe-only SDK config, and the `--resume` selector that presents the\n   448\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n   449\t *  resolves/creates and initializes for real. On `/reload` the connector\n   450\t *  re-resolves the same thread from the durable registry (it keeps no\n   451\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n   452\t *  config. */\n   453\texport function activate(pi: ExtensionAPI): void {\n   454\t  createConnector().register(pi);\n   455\t}\n   456\t\n   457\texport default activate;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/pi/types.ts | sed -n '1,260p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/pi/types.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Local declarations of the PI extension surface the connector consumes.\n     2\t//\n     3\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n     4\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n     5\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\n     6\t// build-time dependency of this workspace, so the connector declares the slice\n     7\t// of their contract it touches and swaps to the real imports when the\n     8\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n     9\t// surface here — rather than scattered `any` — means later stories get real\n    10\t// type-checking against the contract PI actually fires.\n    11\t\n    12\t// ── Hook vocabulary ──────────────────────────────────────────────────\n    13\t\n    14\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n    15\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\n    16\t *  serving is Epic 2. */\n    17\texport type PiHookName =\n    18\t  | \"session_start\"\n    19\t  | \"message_end\"\n    20\t  | \"turn_end\"\n    21\t  | \"agent_end\"\n    22\t  | \"model_select\"\n    23\t  | \"thinking_level_select\"\n    24\t  | \"session_before_fork\"\n    25\t  | \"session_before_switch\"\n    26\t  | \"session_shutdown\"\n    27\t  | \"context\";\n    28\t\n    29\texport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\n    30\texport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n    31\t\n    32\texport interface SessionStartEvent {\n    33\t  reason: SessionStartReason;\n    34\t  previousSessionFile?: string;\n    35\t}\n    36\texport interface MessageEndEvent {\n    37\t  message: AgentMessage;\n    38\t}\n    39\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n    40\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\n    41\texport interface TurnEndEvent {\n    42\t  turnIndex: number;\n    43\t  message: AgentMessage;\n    44\t  toolResults: ToolResultMessage[];\n    45\t  stopReason?: PiStopReason;\n    46\t}\n    47\texport interface AgentEndEvent {\n    48\t  messages: AgentMessage[];\n    49\t}\n    50\texport interface ModelSelectEvent {\n    51\t  model: ModelDescriptor;\n    52\t  previousModel?: ModelDescriptor;\n    53\t  source?: string;\n    54\t}\n    55\texport interface ThinkingLevelSelectEvent {\n    56\t  level: string;\n    57\t  previousLevel: string;\n    58\t}\n    59\texport interface SessionBeforeForkEvent {\n    60\t  entryId: string;\n    61\t  position?: number;\n    62\t}\n    63\texport interface SessionBeforeSwitchEvent {\n    64\t  intent: \"new\" | \"resume\";\n    65\t}\n    66\texport interface SessionShutdownEvent {\n    67\t  reason: SessionShutdownReason;\n    68\t  targetSessionFile?: string;\n    69\t}\n    70\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\n    71\texport interface ContextEvent {\n    72\t  messages: AgentMessage[];\n    73\t}\n    74\t\n    75\t/** Maps each hook to the payload PI delivers with it. */\n    76\texport interface PiHookEventMap {\n    77\t  session_start: SessionStartEvent;\n    78\t  message_end: MessageEndEvent;\n    79\t  turn_end: TurnEndEvent;\n    80\t  agent_end: AgentEndEvent;\n    81\t  model_select: ModelSelectEvent;\n    82\t  thinking_level_select: ThinkingLevelSelectEvent;\n    83\t  session_before_fork: SessionBeforeForkEvent;\n    84\t  session_before_switch: SessionBeforeSwitchEvent;\n    85\t  session_shutdown: SessionShutdownEvent;\n    86\t  context: ContextEvent;\n    87\t}\n    88\t\n    89\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n    90\t *  connector must never retain it across calls (PI replaces session objects on\n    91\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\n    92\texport type PiHookHandler<N extends PiHookName> = (\n    93\t  ctx: ExtensionContext,\n    94\t  event: PiHookEventMap[N],\n    95\t) => void | Promise<void>;\n    96\t\n    97\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n    98\t\n    99\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n   100\t\n   101\texport interface PiToolSpec {\n   102\t  name: string;\n   103\t  description?: string;\n   104\t  promptSnippet?: string;\n   105\t  promptGuidelines?: string;\n   106\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n   107\t}\n   108\t\n   109\t/** The factory-time API. Hook registration and command/tool registration take\n   110\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n   111\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n   112\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\n   113\texport interface ExtensionAPI {\n   114\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n   115\t  registerCommand(name: string, handler: PiCommandHandler): void;\n   116\t  registerTool(tool: PiToolSpec): void;\n   117\t  appendEntry(customType: string, data: unknown): void;\n   118\t}\n   119\t\n   120\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n   121\t\n   122\texport interface ModelDescriptor {\n   123\t  provider: string;\n   124\t  id: string;\n   125\t}\n   126\t\n   127\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n   128\t *  owns. The connector treats provider/model as opaque routing keys. */\n   129\texport interface ModelHandle extends ModelDescriptor {\n   130\t  readonly [k: string]: unknown;\n   131\t}\n   132\t\n   133\texport interface ModelRegistry {\n   134\t  find(provider: string, model: string): ModelHandle | undefined;\n   135\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\n   136\t  getAvailable(): ModelHandle[];\n   137\t}\n   138\t\n   139\texport interface ExtensionUI {\n   140\t  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n   141\t}\n   142\t\n   143\texport interface SessionEntry {\n   144\t  type: string;\n   145\t  readonly [k: string]: unknown;\n   146\t}\n   147\t\n   148\texport interface SessionManager {\n   149\t  getEntries(): SessionEntry[];\n   150\t}\n   151\t\n   152\texport interface ExtensionContext {\n   153\t  modelRegistry: ModelRegistry;\n   154\t  ui: ExtensionUI;\n   155\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n   156\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n   157\t  hasUI: boolean;\n   158\t  sessionManager: SessionManager;\n   159\t  cwd: string;\n   160\t}\n   161\t\n   162\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n   163\t\n   164\texport interface TextPart {\n   165\t  type: \"text\";\n   166\t  text: string;\n   167\t}\n   168\texport interface ThinkingPart {\n   169\t  type: \"thinking\";\n   170\t  thinking: string;\n   171\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n   172\t   *  Epic 1 (tech design I-3). */\n   173\t  thinkingSignature?: string;\n   174\t}\n   175\texport interface ToolCallPart {\n   176\t  type: \"toolCall\";\n   177\t  /** Composite, stable across tool_execution_start → tool_result → message_end\n   178\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n   179\t  id: string;\n   180\t  name: string;\n   181\t  arguments: Record<string, unknown>;\n   182\t  /** Opaque; captured, not interpreted (tech design I-3). */\n   183\t  thoughtSignature?: string;\n   184\t}\n   185\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n   186\t *  the converter (tech design I-6), never silently dropped. */\n   187\texport interface ImagePart {\n   188\t  type: \"image\";\n   189\t  mimeType?: string;\n   190\t  data?: string;\n   191\t}\n   192\texport interface FileRefPart {\n   193\t  type: \"fileRef\";\n   194\t  path: string;\n   195\t}\n   196\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n   197\t\n   198\texport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n   199\t\n   200\texport interface TokenUsage {\n   201\t  inputTokens?: number;\n   202\t  outputTokens?: number;\n   203\t}\n   204\t\n   205\texport interface UserMessage {\n   206\t  role: \"user\";\n   207\t  content: ContentPart[];\n   208\t}\n   209\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n   210\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\n   211\texport interface AssistantMessage {\n   212\t  role: \"assistant\";\n   213\t  content: ContentPart[];\n   214\t  stopReason?: PiStopReason;\n   215\t  usage?: TokenUsage;\n   216\t}\n   217\texport interface ToolResultMessage {\n   218\t  role: \"toolResult\";\n   219\t  toolCallId: string;\n   220\t  content: ContentPart[];\n   221\t  isError?: boolean;\n   222\t}\n   223\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n","exit_code":0,"status":"completed"}}

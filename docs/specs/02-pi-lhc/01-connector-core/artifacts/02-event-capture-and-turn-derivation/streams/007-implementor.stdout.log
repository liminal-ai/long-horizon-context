{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019EM76HfyQsKkWqx6KW43zx","type":"tool_result","content":"1\timport type { MessageEventInput } from \"lhc\";\n2\timport type { MapCtx } from \"./map-message.js\";\n3\timport { eventKey } from \"./idempotency.js\";\n4\t\n5\t// AC-2.8: model_select / thinking_level_select hooks → runtime_note events, in\n6\t// order relative to surrounding messages. PI fires these only in-stream and no\n7\t// durable record holds them otherwise, so they are captured the moment they\n8\t// fire. They ride the existing `runtime_note` kind (no new intake kind), with\n9\t// text structured enough to recover the change — the new value and the previous\n10\t// one — which is what later epics use to attribute a turn to its model.\n11\t\n12\tconst HARNESS = \"pi\";\n13\t\n14\tinterface ModelDescriptor {\n15\t  provider: string;\n16\t  id: string;\n17\t}\n18\t\n19\tfunction describeModel(model: ModelDescriptor): string {\n20\t  return `${model.provider}/${model.id}`;\n21\t}\n22\t\n23\t/** Note text for a model change — carries the new and previous model. */\n24\texport function formatModelChange(ev: {\n25\t  model: ModelDescriptor;\n26\t  previousModel?: ModelDescriptor;\n27\t}): string {\n28\t  const to = describeModel(ev.model);\n29\t  const from = ev.previousModel !== undefined ? describeModel(ev.previousModel) : \"(none)\";\n30\t  return `model changed: ${from} → ${to}`;\n31\t}\n32\t\n33\t/** Note text for a thinking-level change — carries the new and previous level. */\n34\texport function formatThinkingLevelChange(ev: { level: string; previousLevel: string }): string {\n35\t  return `thinking level changed: ${ev.previousLevel} → ${ev.level}`;\n36\t}\n37\t\n38\tfunction runtimeNote(text: string, ctx: MapCtx): MessageEventInput {\n39\t  return {\n40\t    eventKind: \"runtime_note\",\n41\t    idempotencyKey: eventKey({\n42\t      piSessionId: ctx.piSessionId,\n43\t      entryId: ctx.entryId,\n44\t      blockIndex: 0,\n45\t      kind: \"runtime_note\",\n46\t      role: \"system\",\n47\t      content: text,\n48\t    }),\n49\t    actor: \"system\",\n50\t    harness: HARNESS,\n51\t    payload: { text },\n52\t  };\n53\t}\n54\t\n55\t/** One `runtime_note` recording the new + previous model. */\n56\texport function mapModelSelect(\n57\t  ev: { model: ModelDescriptor; previousModel?: ModelDescriptor },\n58\t  ctx: MapCtx,\n59\t): MessageEventInput {\n60\t  return runtimeNote(formatModelChange(ev), ctx);\n61\t}\n62\t\n63\t/** One `runtime_note` recording the new + previous thinking level. */\n64\texport function mapThinkingLevelSelect(\n65\t  ev: { level: string; previousLevel: string },\n66\t  ctx: MapCtx,\n67\t): MessageEventInput {\n68\t  return runtimeNote(formatThinkingLevelChange(ev), ctx);\n69\t}\n70\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"28dd2149-30f8-4ec0-8212-797063038706","timestamp":"2026-06-14T08:08:02.625Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/runtime-changes.ts","content":"import type { MessageEventInput } from \"lhc\";\nimport type { MapCtx } from \"./map-message.js\";\nimport { eventKey } from \"./idempotency.js\";\n\n// AC-2.8: model_select / thinking_level_select hooks → runtime_note events, in\n// order relative to surrounding messages. PI fires these only in-stream and no\n// durable record holds them otherwise, so they are captured the moment they\n// fire. They ride the existing `runtime_note` kind (no new intake kind), with\n// text structured enough to recover the change — the new value and the previous\n// one — which is what later epics use to attribute a turn to its model.\n\nconst HARNESS = \"pi\";\n\ninterface ModelDescriptor {\n  provider: string;\n  id: string;\n}\n\nfunction describeModel(model: ModelDescriptor): string {\n  return `${model.provider}/${model.id}`;\n}\n\n/** Note text for a model change — carries the new and previous model. */\nexport function formatModelChange(ev: {\n  model: ModelDescriptor;\n  previousModel?: ModelDescriptor;\n}): string {\n  const to = describeModel(ev.model);\n  const from = ev.previousModel !== undefined ? describeModel(ev.previousModel) : \"(none)\";\n  return `model changed: ${from} → ${to}`;\n}\n\n/** Note text for a thinking-level change — carries the new and previous level. */\nexport function formatThinkingLevelChange(ev: { level: string; previousLevel: string }): string {\n  return `thinking level changed: ${ev.previousLevel} → ${ev.level}`;\n}\n\nfunction runtimeNote(text: string, ctx: MapCtx): MessageEventInput {\n  return {\n    eventKind: \"runtime_note\",\n    idempotencyKey: eventKey({\n      piSessionId: ctx.piSessionId,\n      entryId: ctx.entryId,\n      blockIndex: 0,\n      kind: \"runtime_note\",\n      role: \"system\",\n      content: text,\n    }),\n    actor: \"system\",\n    harness: HARNESS,\n    payload: { text },\n  };\n}\n\n/** One `runtime_note` recording the new + previous model. */\nexport function mapModelSelect(\n  ev: { model: ModelDescriptor; previousModel?: ModelDescriptor },\n  ctx: MapCtx,\n): MessageEventInput {\n  return runtimeNote(formatModelChange(ev), ctx);\n}\n\n/** One `runtime_note` recording the new + previous thinking level. */\nexport function mapThinkingLevelSelect(\n  ev: { level: string; previousLevel: string },\n  ctx: MapCtx,\n): MessageEventInput {\n  return runtimeNote(formatThinkingLevelChange(ev), ctx);\n}\n","numLines":70,"startLine":1,"totalLines":70}}}

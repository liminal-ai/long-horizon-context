{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Myxx4FHa9jf4RLxNjuZE6C","type":"tool_result","content":"1\timport type { EventKind, MessageEventInput } from \"lhc\";\n2\timport type {\n3\t  AgentMessage,\n4\t  AssistantMessage,\n5\t  ContentPart,\n6\t  FileRefPart,\n7\t  ImagePart,\n8\t  ToolResultMessage,\n9\t  UserMessage,\n10\t} from \"../pi/types.js\";\n11\timport { eventKey } from \"./idempotency.js\";\n12\t\n13\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n14\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n15\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n16\t// present) → one `tool_call` per call, in that order; a tool result → one\n17\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n18\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n19\t// drop, tech design I-6). A graceful interrupt carries its disposition through\n20\t// on a trailing `runtime_note` (research §5b).\n21\t\n22\texport interface MapCtx {\n23\t  piSessionId: string;\n24\t  entryId?: string;\n25\t}\n26\t\n27\tconst HARNESS = \"pi\";\n28\t\n29\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n30\t *  field to hold its disposition, so the mapper carries `stopReason` through on\n31\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n32\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\n33\texport const ABORTED_DISPOSITION_TEXT =\n34\t  \"turn aborted (stopReason: aborted) — partial content preserved\";\n35\t\n36\tconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n37\t\n38\tfunction textOf(parts: ContentPart[]): string {\n39\t  return parts\n40\t    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n41\t    .map((p) => p.text)\n42\t    .join(\"\");\n43\t}\n44\t\n45\tfunction thinkingOf(parts: ContentPart[]): string {\n46\t  return parts\n47\t    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n48\t    .map((p) => p.thinking)\n49\t    .join(\"\");\n50\t}\n51\t\n52\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n53\t  return parts.filter(\n54\t    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n55\t  );\n56\t}\n57\t\n58\tfunction omissionText(part: ImagePart | FileRefPart): string {\n59\t  return part.type === \"image\"\n60\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n61\t    : `unsupported content omitted: file reference (${part.path})`;\n62\t}\n63\t\n64\tfunction buildKey(\n65\t  ctx: MapCtx,\n66\t  role: string,\n67\t  kind: EventKind,\n68\t  blockIndex: number,\n69\t  opts: { toolCallId?: string; content?: string } = {},\n70\t): string {\n71\t  return eventKey({\n72\t    piSessionId: ctx.piSessionId,\n73\t    entryId: ctx.entryId,\n74\t    blockIndex,\n75\t    kind,\n76\t    role,\n77\t    toolCallId: opts.toolCallId,\n78\t    content: opts.content,\n79\t  });\n80\t}\n81\t\n82\t// Per-kind builders — explicit eventKind literals so the discriminated union\n83\t// narrows without a cast.\n84\tfunction textEvent(\n85\t  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n86\t  text: string,\n87\t  actor: string,\n88\t  key: string,\n89\t): MessageEventInput {\n90\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n91\t}\n92\t\n93\tfunction toolCallEvent(\n94\t  toolCallId: string,\n95\t  toolName: string,\n96\t  args: Record<string, unknown>,\n97\t  key: string,\n98\t): MessageEventInput {\n99\t  return {\n100\t    eventKind: \"tool_call\",\n101\t    idempotencyKey: key,\n102\t    actor: \"assistant\",\n103\t    harness: HARNESS,\n104\t    payload: { toolCallId, toolName, arguments: args },\n105\t  };\n106\t}\n107\t\n108\tfunction toolResultEvent(\n109\t  toolCallId: string,\n110\t  content: string,\n111\t  isError: boolean,\n112\t  key: string,\n113\t): MessageEventInput {\n114\t  return {\n115\t    eventKind: \"tool_result\",\n116\t    idempotencyKey: key,\n117\t    actor: \"tool\",\n118\t    harness: HARNESS,\n119\t    payload: { toolCallId, content, isError },\n120\t  };\n121\t}\n122\t\n123\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n124\t  const events: MessageEventInput[] = [];\n125\t  let block = 0;\n126\t  if (msg.content.some((p) => p.type === \"text\")) {\n127\t    const text = textOf(msg.content);\n128\t    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { content: text })));\n129\t    block += 1;\n130\t  }\n131\t  for (const part of unsupportedOf(msg.content)) {\n132\t    const text = omissionText(part);\n133\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: text })));\n134\t    block += 1;\n135\t  }\n136\t  if (events.length === 0) {\n137\t    events.push(\n138\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: \"empty:user\" })),\n139\t    );\n140\t  }\n141\t  return events;\n142\t}\n143\t\n144\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n145\t  const events: MessageEventInput[] = [];\n146\t  let block = 0;\n147\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n148\t  if (msg.content.some((p) => p.type === \"thinking\")) {\n149\t    const text = thinkingOf(msg.content);\n150\t    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { content: text })));\n151\t    block += 1;\n152\t  }\n153\t  if (msg.content.some((p) => p.type === \"text\")) {\n154\t    const text = textOf(msg.content);\n155\t    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { content: text })));\n156\t    block += 1;\n157\t  }\n158\t  for (const part of msg.content) {\n159\t    if (part.type !== \"toolCall\") continue;\n160\t    events.push(\n161\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { toolCallId: part.id, content: part.name })),\n162\t    );\n163\t    block += 1;\n164\t  }\n165\t  for (const part of unsupportedOf(msg.content)) {\n166\t    const text = omissionText(part);\n167\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: text })));\n168\t    block += 1;\n169\t  }\n170\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\n171\t  if (msg.stopReason === \"aborted\") {\n172\t    events.push(\n173\t      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: ABORTED_DISPOSITION_TEXT })),\n174\t    );\n175\t    block += 1;\n176\t  }\n177\t  if (events.length === 0) {\n178\t    events.push(\n179\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: \"empty:assistant\" })),\n180\t    );\n181\t  }\n182\t  return events;\n183\t}\n184\t\n185\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n186\t  const content = textOf(msg.content);\n187\t  const isError = msg.isError === true;\n188\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n189\t  // and content are always captured, even on failure (AC-2.4).\n190\t  return [\n191\t    toolResultEvent(\n192\t      msg.toolCallId,\n193\t      content,\n194\t      isError,\n195\t      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { toolCallId: msg.toolCallId, content }),\n196\t    ),\n197\t  ];\n198\t}\n199\t\n200\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n201\t  switch (msg.role) {\n202\t    case \"user\":\n203\t      return mapUser(msg, ctx);\n204\t    case \"assistant\":\n205\t      return mapAssistant(msg, ctx);\n206\t    case \"toolResult\":\n207\t      return mapToolResult(msg, ctx);\n208\t  }\n209\t}\n210\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"ad4d5f89-89a5-4df0-8b35-82c952c40917","timestamp":"2026-06-14T08:08:00.717Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/map-message.ts","content":"import type { EventKind, MessageEventInput } from \"lhc\";\nimport type {\n  AgentMessage,\n  AssistantMessage,\n  ContentPart,\n  FileRefPart,\n  ImagePart,\n  ToolResultMessage,\n  UserMessage,\n} from \"../pi/types.js\";\nimport { eventKey } from \"./idempotency.js\";\n\n// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n// present) → one `tool_call` per call, in that order; a tool result → one\n// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n// drop, tech design I-6). A graceful interrupt carries its disposition through\n// on a trailing `runtime_note` (research §5b).\n\nexport interface MapCtx {\n  piSessionId: string;\n  entryId?: string;\n}\n\nconst HARNESS = \"pi\";\n\n/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n *  field to hold its disposition, so the mapper carries `stopReason` through on\n *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\nexport const ABORTED_DISPOSITION_TEXT =\n  \"turn aborted (stopReason: aborted) — partial content preserved\";\n\nconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n\nfunction textOf(parts: ContentPart[]): string {\n  return parts\n    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n    .map((p) => p.text)\n    .join(\"\");\n}\n\nfunction thinkingOf(parts: ContentPart[]): string {\n  return parts\n    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n    .map((p) => p.thinking)\n    .join(\"\");\n}\n\nfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n  return parts.filter(\n    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n  );\n}\n\nfunction omissionText(part: ImagePart | FileRefPart): string {\n  return part.type === \"image\"\n    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n    : `unsupported content omitted: file reference (${part.path})`;\n}\n\nfunction buildKey(\n  ctx: MapCtx,\n  role: string,\n  kind: EventKind,\n  blockIndex: number,\n  opts: { toolCallId?: string; content?: string } = {},\n): string {\n  return eventKey({\n    piSessionId: ctx.piSessionId,\n    entryId: ctx.entryId,\n    blockIndex,\n    kind,\n    role,\n    toolCallId: opts.toolCallId,\n    content: opts.content,\n  });\n}\n\n// Per-kind builders — explicit eventKind literals so the discriminated union\n// narrows without a cast.\nfunction textEvent(\n  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n  text: string,\n  actor: string,\n  key: string,\n): MessageEventInput {\n  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n}\n\nfunction toolCallEvent(\n  toolCallId: string,\n  toolName: string,\n  args: Record<string, unknown>,\n  key: string,\n): MessageEventInput {\n  return {\n    eventKind: \"tool_call\",\n    idempotencyKey: key,\n    actor: \"assistant\",\n    harness: HARNESS,\n    payload: { toolCallId, toolName, arguments: args },\n  };\n}\n\nfunction toolResultEvent(\n  toolCallId: string,\n  content: string,\n  isError: boolean,\n  key: string,\n): MessageEventInput {\n  return {\n    eventKind: \"tool_result\",\n    idempotencyKey: key,\n    actor: \"tool\",\n    harness: HARNESS,\n    payload: { toolCallId, content, isError },\n  };\n}\n\nfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n  const events: MessageEventInput[] = [];\n  let block = 0;\n  if (msg.content.some((p) => p.type === \"text\")) {\n    const text = textOf(msg.content);\n    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { content: text })));\n    block += 1;\n  }\n  for (const part of unsupportedOf(msg.content)) {\n    const text = omissionText(part);\n    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: text })));\n    block += 1;\n  }\n  if (events.length === 0) {\n    events.push(\n      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { content: \"empty:user\" })),\n    );\n  }\n  return events;\n}\n\nfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n  const events: MessageEventInput[] = [];\n  let block = 0;\n  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n  if (msg.content.some((p) => p.type === \"thinking\")) {\n    const text = thinkingOf(msg.content);\n    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { content: text })));\n    block += 1;\n  }\n  if (msg.content.some((p) => p.type === \"text\")) {\n    const text = textOf(msg.content);\n    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { content: text })));\n    block += 1;\n  }\n  for (const part of msg.content) {\n    if (part.type !== \"toolCall\") continue;\n    events.push(\n      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { toolCallId: part.id, content: part.name })),\n    );\n    block += 1;\n  }\n  for (const part of unsupportedOf(msg.content)) {\n    const text = omissionText(part);\n    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: text })));\n    block += 1;\n  }\n  // Graceful interrupt: carry the aborted disposition through (never discarded).\n  if (msg.stopReason === \"aborted\") {\n    events.push(\n      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: ABORTED_DISPOSITION_TEXT })),\n    );\n    block += 1;\n  }\n  if (events.length === 0) {\n    events.push(\n      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { content: \"empty:assistant\" })),\n    );\n  }\n  return events;\n}\n\nfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n  const content = textOf(msg.content);\n  const isError = msg.isError === true;\n  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n  // and content are always captured, even on failure (AC-2.4).\n  return [\n    toolResultEvent(\n      msg.toolCallId,\n      content,\n      isError,\n      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { toolCallId: msg.toolCallId, content }),\n    ),\n  ];\n}\n\nexport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n  switch (msg.role) {\n    case \"user\":\n      return mapUser(msg, ctx);\n    case \"assistant\":\n      return mapAssistant(msg, ctx);\n    case \"toolResult\":\n      return mapToolResult(msg, ctx);\n  }\n}\n","numLines":210,"startLine":1,"totalLines":210}}}

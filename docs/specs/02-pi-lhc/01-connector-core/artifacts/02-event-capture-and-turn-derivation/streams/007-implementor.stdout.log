{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019ziN2vixygptPiBAr6PKku","type":"tool_result","content":"1\t// Story 2 — parallel-tool correlation (TC-2.4), error-result capture (TC-2.5),\n2\t// and idempotent re-delivery (TC-2.7, the idempotency architecture-risk). The\n3\t// first two run the production path and read the thread back; TC-2.7 drives\n4\t// capture() directly so it can assert the per-event skip outcomes the SDK\n5\t// returns on re-delivery.\n6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n7\timport { createDeterministicProvider, intakeStream } from \"lhc\";\n8\timport { capture } from \"../../src/capture/converter.js\";\n9\timport { mapMessage } from \"../../src/capture/map-message.js\";\n10\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n11\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n12\timport {\n13\t  makeAgentEnd,\n14\t  makeAssistantMessage,\n15\t  makeMessageEnd,\n16\t  makeToolResult,\n17\t  makeUserMessage,\n18\t} from \"../fixtures/synthetic.js\";\n19\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n20\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n21\t\n22\tlet store: TempStore;\n23\tbeforeEach(() => {\n24\t  store = tempStore();\n25\t});\n26\tafterEach(() => {\n27\t  store.cleanup();\n28\t});\n29\t\n30\tinterface ToolResultPayload {\n31\t  toolCallId: string;\n32\t  content: string;\n33\t  isError?: boolean;\n34\t}\n35\tfunction toolResultPayload(event: { payload: unknown }): ToolResultPayload {\n36\t  return event.payload as ToolResultPayload;\n37\t}\n38\t\n39\tdescribe(\"Story 2: parallel tool calls (TC-2.4)\", () => {\n40\t  it(\"correlates each out-of-order tool_result to its call by toolCallId, not arrival order\", async () => {\n41\t    const started = await startCapture(store);\n42\t    const { connector, ctx } = started;\n43\t\n44\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read both files\")));\n45\t    await connector.handlers.message_end(\n46\t      ctx,\n47\t      makeMessageEnd(\n48\t        makeAssistantMessage({\n49\t          toolCalls: [\n50\t            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n51\t            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n52\t          ],\n53\t        }),\n54\t      ),\n55\t    );\n56\t    // Results complete out of arrival order: b before a.\n57\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b body\" })));\n58\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a body\" })));\n59\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"read both\" })));\n60\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n61\t\n62\t    const events = await eventsAfterShutdown(started);\n63\t    const results = events.filter((event) => event.eventKind === \"tool_result\");\n64\t    expect(results).toHaveLength(2);\n65\t\n66\t    // Each result carries its own call's id and content — correlation is by id.\n67\t    const contentById = new Map(\n68\t      results.map((event) => [toolResultPayload(event).toolCallId, toolResultPayload(event).content]),\n69\t    );\n70\t    expect(contentById.get(\"call_b\")).toBe(\"b body\");\n71\t    expect(contentById.get(\"call_a\")).toBe(\"a body\");\n72\t\n73\t    // Arrival order is preserved in the record (b then a), each correctly tagged\n74\t    // — proving the tag, not the position, is the correlation.\n75\t    expect(toolResultPayload(results[0]!).toolCallId).toBe(\"call_b\");\n76\t    expect(toolResultPayload(results[1]!).toolCallId).toBe(\"call_a\");\n77\t  });\n78\t});\n79\t\n80\tdescribe(\"Story 2: error tool result (TC-2.5)\", () => {\n81\t  it(\"captures an error tool_result with the error flag and its content, dropping nothing\", async () => {\n82\t    const started = await startCapture(store);\n83\t    const { connector, ctx } = started;\n84\t\n85\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read missing.txt\")));\n86\t    await connector.handlers.message_end(\n87\t      ctx,\n88\t      makeMessageEnd(makeAssistantMessage({ toolCalls: [{ id: \"call_a\", name: \"read_file\", arguments: { path: \"missing.txt\" } }] })),\n89\t    );\n90\t    await connector.handlers.message_end(\n91\t      ctx,\n92\t      makeMessageEnd(makeToolResult({ id: \"call_a\", isError: true, content: \"ENOENT: no such file\" })),\n93\t    );\n94\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"it does not exist\" })));\n95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n96\t\n97\t    const events = await eventsAfterShutdown(started);\n98\t    // Nothing dropped because the tool failed.\n99\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"tool_call\", \"tool_result\", \"assistant_text\", \"turn_end\"]);\n100\t\n101\t    const result = events.find((event) => event.eventKind === \"tool_result\");\n102\t    expect(result).toBeDefined();\n103\t    expect(toolResultPayload(result!).isError).toBe(true);\n104\t    expect(toolResultPayload(result!).content).toBe(\"ENOENT: no such file\");\n105\t  });\n106\t});\n107\t\n108\tdescribe(\"Story 2: idempotent re-delivery (TC-2.7, idempotency risk)\", () => {\n109\t  it(\"skips a re-delivered batch by idempotency key and records no duplicates\", async () => {\n110\t    const thread = await makeTempThread(store);\n111\t    const built = await initInstance(thread.threadRef, {\n112\t      provider: createDeterministicProvider(),\n113\t      mode: \"background\",\n114\t    });\n115\t    expect(built.ok).toBe(true);\n116\t    if (!built.ok) return;\n117\t    const instance = built.value;\n118\t\n119\t    // Build one logical turn's events through the real map + accumulator, so the\n120\t    // keys are exactly what production would emit.\n121\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n122\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n123\t    acc.onMessage(userEvents);\n124\t    const assistantEvents = mapMessage(makeAssistantMessage({ text: \"hi there\" }), {\n125\t      piSessionId: \"sess\",\n126\t      entryId: \"s1\",\n127\t    });\n128\t    acc.onMessage(assistantEvents);\n129\t    const turnEnd = acc.onAgentEnd();\n130\t    const batch = [...userEvents, ...assistantEvents, ...turnEnd];\n131\t\n132\t    const first = await capture(batch, instance);\n133\t    expect(first.ok).toBe(true);\n134\t    if (first.ok) {\n135\t      expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n136\t    }\n137\t\n138\t    // Re-delivery (the reload / crash-replay path): identical keys → all skipped.\n139\t    const second = await capture(batch, instance);\n140\t    expect(second.ok).toBe(true);\n141\t    if (second.ok) {\n142\t      expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n143\t      expect(\n144\t        second.value.events.every((entry) => entry.skipReason === \"duplicate_idempotency_key\"),\n145\t      ).toBe(true);\n146\t    }\n147\t\n148\t    // No duplicate records landed on the thread.\n149\t    const read = await intakeStream.listEvents(instance.threadRef);\n150\t    expect(read.ok).toBe(true);\n151\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n152\t\n153\t    await instance.dispose();\n154\t  });\n155\t});\n156\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"8d95226f-2ab8-416e-be98-ff17a8fb34b3","timestamp":"2026-06-14T08:11:57.861Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/parallel-and-errors.test.ts","content":"// Story 2 — parallel-tool correlation (TC-2.4), error-result capture (TC-2.5),\n// and idempotent re-delivery (TC-2.7, the idempotency architecture-risk). The\n// first two run the production path and read the thread back; TC-2.7 drives\n// capture() directly so it can assert the per-event skip outcomes the SDK\n// returns on re-delivery.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { createDeterministicProvider, intakeStream } from \"lhc\";\nimport { capture } from \"../../src/capture/converter.js\";\nimport { mapMessage } from \"../../src/capture/map-message.js\";\nimport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\nimport { initInstance } from \"../../src/lifecycle/instance.js\";\nimport {\n  makeAgentEnd,\n  makeAssistantMessage,\n  makeMessageEnd,\n  makeToolResult,\n  makeUserMessage,\n} from \"../fixtures/synthetic.js\";\nimport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\nimport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\ninterface ToolResultPayload {\n  toolCallId: string;\n  content: string;\n  isError?: boolean;\n}\nfunction toolResultPayload(event: { payload: unknown }): ToolResultPayload {\n  return event.payload as ToolResultPayload;\n}\n\ndescribe(\"Story 2: parallel tool calls (TC-2.4)\", () => {\n  it(\"correlates each out-of-order tool_result to its call by toolCallId, not arrival order\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read both files\")));\n    await connector.handlers.message_end(\n      ctx,\n      makeMessageEnd(\n        makeAssistantMessage({\n          toolCalls: [\n            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n          ],\n        }),\n      ),\n    );\n    // Results complete out of arrival order: b before a.\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b body\" })));\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a body\" })));\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"read both\" })));\n    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n\n    const events = await eventsAfterShutdown(started);\n    const results = events.filter((event) => event.eventKind === \"tool_result\");\n    expect(results).toHaveLength(2);\n\n    // Each result carries its own call's id and content — correlation is by id.\n    const contentById = new Map(\n      results.map((event) => [toolResultPayload(event).toolCallId, toolResultPayload(event).content]),\n    );\n    expect(contentById.get(\"call_b\")).toBe(\"b body\");\n    expect(contentById.get(\"call_a\")).toBe(\"a body\");\n\n    // Arrival order is preserved in the record (b then a), each correctly tagged\n    // — proving the tag, not the position, is the correlation.\n    expect(toolResultPayload(results[0]!).toolCallId).toBe(\"call_b\");\n    expect(toolResultPayload(results[1]!).toolCallId).toBe(\"call_a\");\n  });\n});\n\ndescribe(\"Story 2: error tool result (TC-2.5)\", () => {\n  it(\"captures an error tool_result with the error flag and its content, dropping nothing\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read missing.txt\")));\n    await connector.handlers.message_end(\n      ctx,\n      makeMessageEnd(makeAssistantMessage({ toolCalls: [{ id: \"call_a\", name: \"read_file\", arguments: { path: \"missing.txt\" } }] })),\n    );\n    await connector.handlers.message_end(\n      ctx,\n      makeMessageEnd(makeToolResult({ id: \"call_a\", isError: true, content: \"ENOENT: no such file\" })),\n    );\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"it does not exist\" })));\n    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n\n    const events = await eventsAfterShutdown(started);\n    // Nothing dropped because the tool failed.\n    expect(kindsOf(events)).toEqual([\"user_prompt\", \"tool_call\", \"tool_result\", \"assistant_text\", \"turn_end\"]);\n\n    const result = events.find((event) => event.eventKind === \"tool_result\");\n    expect(result).toBeDefined();\n    expect(toolResultPayload(result!).isError).toBe(true);\n    expect(toolResultPayload(result!).content).toBe(\"ENOENT: no such file\");\n  });\n});\n\ndescribe(\"Story 2: idempotent re-delivery (TC-2.7, idempotency risk)\", () => {\n  it(\"skips a re-delivered batch by idempotency key and records no duplicates\", async () => {\n    const thread = await makeTempThread(store);\n    const built = await initInstance(thread.threadRef, {\n      provider: createDeterministicProvider(),\n      mode: \"background\",\n    });\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n    const instance = built.value;\n\n    // Build one logical turn's events through the real map + accumulator, so the\n    // keys are exactly what production would emit.\n    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n    acc.onMessage(userEvents);\n    const assistantEvents = mapMessage(makeAssistantMessage({ text: \"hi there\" }), {\n      piSessionId: \"sess\",\n      entryId: \"s1\",\n    });\n    acc.onMessage(assistantEvents);\n    const turnEnd = acc.onAgentEnd();\n    const batch = [...userEvents, ...assistantEvents, ...turnEnd];\n\n    const first = await capture(batch, instance);\n    expect(first.ok).toBe(true);\n    if (first.ok) {\n      expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    }\n\n    // Re-delivery (the reload / crash-replay path): identical keys → all skipped.\n    const second = await capture(batch, instance);\n    expect(second.ok).toBe(true);\n    if (second.ok) {\n      expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n      expect(\n        second.value.events.every((entry) => entry.skipReason === \"duplicate_idempotency_key\"),\n      ).toBe(true);\n    }\n\n    // No duplicate records landed on the thread.\n    const read = await intakeStream.listEvents(instance.threadRef);\n    expect(read.ok).toBe(true);\n    if (read.ok) expect(read.value).toHaveLength(batch.length);\n\n    await instance.dispose();\n  });\n});\n","numLines":156,"startLine":1,"totalLines":156}}}

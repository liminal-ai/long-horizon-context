{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019H8sdE9vFGJsNk36euXNxy","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type {\n11\t  BatchResult,\n12\t  DerivationProvider,\n13\t  MessageEventInput,\n14\t  OpResult,\n15\t  ProviderResult,\n16\t  SdkConfig,\n17\t  ThreadRef,\n18\t} from \"lhc\";\n19\timport type {\n20\t  ExtensionAPI,\n21\t  ExtensionContext,\n22\t  PiHookHandler,\n23\t  PiHookName,\n24\t} from \"./pi/types.js\";\n25\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n26\timport { createSessionState } from \"./lifecycle/state.js\";\n27\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n28\timport {\n29\t  parseLaunchFlags,\n30\t  resolveReloadThread,\n31\t  resolveThread,\n32\t  type LaunchFlags,\n33\t  type ResolveDeps,\n34\t} from \"./lifecycle/thread-resolution.js\";\n35\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n36\timport { capture } from \"./capture/converter.js\";\n37\timport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\n38\timport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\n39\timport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\n40\timport type { LhcInstance } from \"./shared/instance.js\";\n41\t\n42\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n43\texport type { LhcInstance } from \"./shared/instance.js\";\n44\t\n45\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n46\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n47\t *  registers no handler for it (story Scope Out). */\n48\texport const EPIC_1_HOOKS = [\n49\t  \"session_start\",\n50\t  \"message_end\",\n51\t  \"turn_end\",\n52\t  \"agent_end\",\n53\t  \"model_select\",\n54\t  \"thinking_level_select\",\n55\t  \"session_before_fork\",\n56\t  \"session_before_switch\",\n57\t  \"session_shutdown\",\n58\t] as const satisfies readonly PiHookName[];\n59\t\n60\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n61\t\n62\t/** What the connector needs from the host to run a session. Every dependency\n63\t *  has a working production default; the overrides exist for test isolation\n64\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n65\t *  in the PI-auth-backed inference config.\n66\t *\n67\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n68\t *  default is the observe-only config below (a real, construction-valid SDK);\n69\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n70\texport interface ConnectorDeps {\n71\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n72\t  registryPath?: string;\n73\t  newThreadFilePath?: () => string;\n74\t  parseLaunch?: () => LaunchFlags;\n75\t  selectThread?: (\n76\t    choices: readonly ThreadChoice[],\n77\t    ctx: ExtensionContext,\n78\t  ) => Promise<string | null>;\n79\t}\n80\t\n81\t/** Everything the connector retains across hooks as PLAIN data — by\n82\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n83\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n84\t *  deliberately not part of the snapshot. */\n85\texport interface ConnectorSnapshot {\n86\t  state: SessionState | null;\n87\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n88\t}\n89\t\n90\texport interface Connector {\n91\t  /** Register the observe-only hook rail on the PI extension API. */\n92\t  register(pi: ExtensionAPI): void;\n93\t  /** The plain-data state retained across hooks. `null` until a session\n94\t   *  resolves a thread; never holds a PI ctx. */\n95\t  getState(): SessionState | null;\n96\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n97\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n98\t  getInstance(): LhcInstance | null;\n99\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n100\t  snapshot(): ConnectorSnapshot;\n101\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n102\t   *  synthetic ctx/events without a live PI. */\n103\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n104\t}\n105\t\n106\t/** The connector's live capture state for one session: the open-turn\n107\t *  accumulator and a monotonic source-event counter (the entry index woven into\n108\t *  every event's idempotency key). The counter is SEEDED from the thread's\n109\t *  durable committed-event count at attach, so a resume/reload continues past\n110\t *  the prior session's keys rather than restarting at 0 and colliding (SV-001).\n111\t *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n112\t *  per session, never part of the plain-data snapshot and never a PI object. */\n113\tinterface CaptureSession {\n114\t  piSessionId: string;\n115\t  accumulator: TurnAccumulator;\n116\t  sourceSeq: number;\n117\t}\n118\t\n119\t/** A stable per-session id for idempotency-key scoping — the resolved thread's\n120\t *  identity, which survives reload/replay (the same thread re-resolves to the\n121\t *  same id). */\n122\tfunction sessionIdOf(ref: ThreadRef): string {\n123\t  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n124\t}\n125\t\n126\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n127\t\n128\t/** The Story-1 production inference placeholder: a real `DerivationProvider`\n129\t *  whose every operation fails closed (non-retryable) instead of fabricating a\n130\t *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n131\t *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n132\t *  derivation work is ever queued and this provider is never invoked — it exists\n133\t *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n134\t *\n135\t *  It is deliberately NOT the deterministic provider, which the LHC SDK\n136\t *  documents as \"selectable only by explicit name — never a production default\"\n137\t *  (it would mark fake derived text into the thread). Failing closed preserves\n138\t *  the observe-only guarantee even if a future change queued work before Stories\n139\t *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n140\t *  assignments), which is what a real *completing* inference requires (the\n141\t *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\n142\tfunction observeOnlyProvider(): DerivationProvider {\n143\t  const notConfigured = (): Promise<ProviderResult> =>\n144\t    Promise.resolve({\n145\t      ok: false,\n146\t      retryable: false,\n147\t      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n148\t    });\n149\t  return {\n150\t    smoothPrompt: notConfigured,\n151\t    summarizeToolCall: notConfigured,\n152\t    summarizeToolResult: notConfigured,\n153\t    composeTurnRendering: notConfigured,\n154\t    projectLowerBand: notConfigured,\n155\t    summarizeChunkDetailed: notConfigured,\n156\t    summarizeChunkBrief: notConfigured,\n157\t  };\n158\t}\n159\t\n160\t/** The production observe-only SDK config: a real, construction-valid instance\n161\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n162\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n163\t *  config. */\n164\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n165\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n166\t}\n167\t\n168\t/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n169\t *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n170\t *  show. */\n171\tfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n172\t  const lines = choices.map((choice, i) => {\n173\t    const title = choice.title ?? \"(untitled)\";\n174\t    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n175\t  });\n176\t  return [\n177\t    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n178\t    ...lines,\n179\t    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n180\t  ].join(\"\\n\");\n181\t}\n182\t\n183\t/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n184\t *  interactive input/selection surface (wiring research), so the production\n185\t *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n186\t *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n187\t *  most recently created thread as the best available explicit default. The\n188\t *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n189\t *  takes the `select` seam); tests drive an explicit operator choice through it.\n190\t *  A true interactive picker awaits a PI input surface; until then resuming a\n191\t *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n192\t *  precise spec deviation. */\n193\tfunction defaultSelectThread(\n194\t  choices: readonly ThreadChoice[],\n195\t  ctx: ExtensionContext,\n196\t): Promise<string | null> {\n197\t  const mostRecent = choices.at(-1);\n198\t  if (mostRecent === undefined) return Promise.resolve(null);\n199\t  if (ctx.hasUI) {\n200\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n201\t  }\n202\t  return Promise.resolve(mostRecent.threadId);\n203\t}\n204\t\n205\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n206\t *  generated by the registry at creation, so the file name is just a unique\n207\t *  handle; the directory is ensured up front (DatabaseSync does not create\n208\t *  parents). */\n209\tfunction defaultNewThreadFilePath(): string {\n210\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n211\t  mkdirSync(dir, { recursive: true });\n212\t  return join(dir, `${randomUUID()}.sqlite`);\n213\t}\n214\t\n215\t/** Build a connector instance. Its mutable state lives in this closure; the\n216\t *  registered handlers capture it, so the instance stays live for the session\n217\t *  even when `activate` discards the returned object. The connector holds NO\n218\t *  module-level or durable state of its own — reload reconstructs the thread from\n219\t *  the LHC registry (the durable catalog), so a fresh connector with an empty\n220\t *  closure reattaches correctly (AC-1.5). */\n221\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n222\t  // The connector's retained state. `state` is plain data (the durable thread\n223\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n224\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n225\t  // none survives the connector — reload re-resolves from the registry.\n226\t  let state: SessionState | null = null;\n227\t  let instance: LhcInstance | null = null;\n228\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n229\t  let captureSession: CaptureSession | null = null;\n230\t\n231\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n232\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n233\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n234\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n235\t\n236\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n237\t    return { code, message, recordedGap: false };\n238\t  }\n239\t\n240\t  // The registry/file deps every resolver path shares. `registryPath` is set\n241\t  // only when provided (omitted → LHC's default ~/.lhc registry), per\n242\t  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n243\t  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n244\t    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n245\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n246\t    return resolveDeps;\n247\t  }\n248\t\n249\t  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n250\t  // `--session` / `--continue` / no-flag go through the registry resolver (only\n251\t  // no-flag creates).\n252\t  async function resolveForLaunch(\n253\t    launch: LaunchFlags,\n254\t    ctx: ExtensionContext,\n255\t  ): Promise<OpResult<ThreadRef | null>> {\n256\t    if (launch.resume === true) {\n257\t      const pickerDeps: {\n258\t        registryPath?: string;\n259\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n260\t      } = { select: (choices) => selectThread(choices, ctx) };\n261\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n262\t      return pickThread(ctx.cwd, pickerDeps);\n263\t    }\n264\t    return resolveThread(launch, buildResolveDeps(ctx));\n265\t  }\n266\t\n267\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n268\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n269\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n270\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n271\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n272\t  async function resolveReloadFor(\n273\t    launch: LaunchFlags,\n274\t    ctx: ExtensionContext,\n275\t  ): Promise<OpResult<ThreadRef | null>> {\n276\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n277\t  }\n278\t\n279\t  // session_start: resolve the recording thread and construct one background\n280\t  // instance against it. Config is gated first so a session with no usable\n281\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n282\t  // thread is re-resolved from the durable registry (reattach, never create);\n283\t  // every other reason runs the normal launch resolution.\n284\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n285\t    const config = buildSdkConfig(ctx);\n286\t    if (!config.ok) {\n287\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n288\t      return;\n289\t    }\n290\t    const launch = parseLaunch();\n291\t    const isReload = event.reason === \"reload\";\n292\t    const resolved = isReload\n293\t      ? await resolveReloadFor(launch, ctx)\n294\t      : await resolveForLaunch(launch, ctx);\n295\t    if (!resolved.ok) {\n296\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n297\t      return;\n298\t    }\n299\t    if (resolved.value === null) {\n300\t      lastDiagnostic = isReload\n301\t        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n302\t        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n303\t      return;\n304\t    }\n305\t    const built = await initInstance(resolved.value, config.value);\n306\t    if (!built.ok) {\n307\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n308\t      return;\n309\t    }\n310\t    instance = built.value;\n311\t    state = createSessionState(resolved.value);\n312\t    // Seed the capture counters from the thread's DURABLE committed state, so a\n313\t    // resume/reload onto an EXISTING thread continues past the prior session's\n314\t    // idempotency keys instead of restarting at 0 and silently skipping new\n315\t    // finalized events as false duplicates (SV-001). A new thread reads back\n316\t    // zero, so a fresh session is unchanged; the read is touch-suppressed and\n317\t    // happens once per session_start, never per event.\n318\t    const piSessionId = sessionIdOf(resolved.value);\n319\t    const seed = await built.value.sdk.inspect.overview(resolved.value);\n320\t    const sourceSeq = seed.ok ? seed.value.events.count : 0;\n321\t    const startTurnSeq = seed.ok ? seed.value.turns.closed : 0;\n322\t    captureSession = {\n323\t      piSessionId,\n324\t      accumulator: new TurnAccumulator({ piSessionId, startTurnSeq }),\n325\t      sourceSeq,\n326\t    };\n327\t  };\n328\t\n329\t  // Dispose with flush before any session swap (session_before_switch fires\n330\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n331\t  // no live instance is a no-op. No reload-handoff state is kept — a reload\n332\t  // re-resolves its thread from the durable registry on the next session_start.\n333\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n334\t    const result = await disposeInstance(instance);\n335\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n336\t    instance = null;\n337\t    captureSession = null;\n338\t  };\n339\t\n340\t  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n341\t  // converter already recorded a durable gap for a writable-thread malformed\n342\t  // event (`invalid_event`); a store-unavailable failure could not, so it\n343\t  // surfaces as an extension health signal with no gap. Neither path throws.\n344\t  function recordCaptureOutcome(\n345\t    result: OpResult<BatchResult>,\n346\t    events: readonly MessageEventInput[],\n347\t  ): void {\n348\t    if (result.ok) return;\n349\t    const recordedGap = result.error.code === \"invalid_event\";\n350\t    const failure: CaptureFailureDiagnostic = {\n351\t      code: result.error.code,\n352\t      message: result.error.reason,\n353\t      recordedGap,\n354\t    };\n355\t    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n356\t    lastDiagnostic = failure;\n357\t    if (state !== null) state.health.lastCaptureFailure = failure;\n358\t  }\n359\t\n360\t  // The next monotonic source-event index, used as the event's entry id. The\n361\t  // counter is seeded from durable thread state at attach, so within a session\n362\t  // it numbers new finalized events past every prior key (no resume collision),\n363\t  // and a brand-new thread numbers from 0.\n364\t  function nextEntryId(session: CaptureSession): string {\n365\t    const id = `s${session.sourceSeq}`;\n366\t    session.sourceSeq += 1;\n367\t    return id;\n368\t  }\n369\t\n370\t  // message_end: map the finalized PI message to ordered LHC events, track the\n371\t  // open turn, and flush through the converter (AC-2.1).\n372\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n373\t    if (instance === null || captureSession === null) return;\n374\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n375\t    const events = mapMessage(event.message, mapCtx);\n376\t    captureSession.accumulator.onMessage(events);\n377\t    if (events.length === 0) return;\n378\t    recordCaptureOutcome(await capture(events, instance), events);\n379\t  };\n380\t\n381\t  // model_select / thinking_level_select fire only in-stream — capture each as\n382\t  // an ordered runtime_note the moment it fires (AC-2.8).\n383\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n384\t    if (instance === null || captureSession === null) return;\n385\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n386\t    const note = mapModelSelect(event, mapCtx);\n387\t    recordCaptureOutcome(await capture([note], instance), [note]);\n388\t  };\n389\t\n390\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n391\t    if (instance === null || captureSession === null) return;\n392\t    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n393\t    const note = mapThinkingLevelSelect(event, mapCtx);\n394\t    recordCaptureOutcome(await capture([note], instance), [note]);\n395\t  };\n396\t\n397\t  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n398\t  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n399\t  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n400\t    if (instance === null || captureSession === null) return;\n401\t    const turnEnd = captureSession.accumulator.onAgentEnd();\n402\t    if (turnEnd.length === 0) return;\n403\t    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n404\t  };\n405\t\n406\t  // Contain every handler: an observe-only hook must never throw back into PI\n407\t  // (a thrown hook breaks the user's session). A caught error becomes a\n408\t  // plain-data diagnostic; it is never rethrown.\n409\t  const guard = (\n410\t    name: Epic1Hook,\n411\t    body: PiHookHandler<Epic1Hook>,\n412\t  ): PiHookHandler<Epic1Hook> => {\n413\t    return async (ctx, event): Promise<void> => {\n414\t      try {\n415\t        await body(ctx, event);\n416\t      } catch (err) {\n417\t        lastDiagnostic = {\n418\t          code: \"hook_handler_error\",\n419\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n420\t          recordedGap: false,\n421\t        };\n422\t      }\n423\t    };\n424\t  };\n425\t\n426\t  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n427\t  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n428\t  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n429\t  // FRESH ctx and retains none of it.\n430\t  const noop: PiHookHandler<Epic1Hook> = () => {\n431\t    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n432\t  };\n433\t\n434\t  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n435\t  // are live; PI per-step turn_end and fork remain no-ops.\n436\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n437\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n438\t    session_before_switch: onDispose,\n439\t    session_shutdown: onDispose,\n440\t    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n441\t    turn_end: noop,\n442\t    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n443\t    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n444\t    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n445\t    session_before_fork: noop,\n446\t  };\n447\t\n448\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n449\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n450\t\n451\t  return {\n452\t    handlers,\n453\t    register(pi: ExtensionAPI): void {\n454\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n455\t    },\n456\t    getState(): SessionState | null {\n457\t      return state;\n458\t    },\n459\t    getInstance(): LhcInstance | null {\n460\t      return instance;\n461\t    },\n462\t    snapshot(): ConnectorSnapshot {\n463\t      return { state, lastDiagnostic };\n464\t    },\n465\t  };\n466\t}\n467\t\n468\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n469\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n470\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n471\t *  observe-only SDK config, and the `--resume` selector that presents the\n472\t *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n473\t *  resolves/creates and initializes for real. On `/reload` the connector\n474\t *  re-resolves the same thread from the durable registry (it keeps no\n475\t *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n476\t *  config. */\n477\texport function activate(pi: ExtensionAPI): void {\n478\t  createConnector().register(pi);\n479\t}\n480\t\n481\texport default activate;\n482\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"2ad5dce4-47a5-46b7-9482-2fe8f077ed80","timestamp":"2026-06-14T08:09:53.518Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type {\n  BatchResult,\n  DerivationProvider,\n  MessageEventInput,\n  OpResult,\n  ProviderResult,\n  SdkConfig,\n  ThreadRef,\n} from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport {\n  parseLaunchFlags,\n  resolveReloadThread,\n  resolveThread,\n  type LaunchFlags,\n  type ResolveDeps,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport { capture } from \"./capture/converter.js\";\nimport { mapMessage, type MapCtx } from \"./capture/map-message.js\";\nimport { mapModelSelect, mapThinkingLevelSelect } from \"./capture/runtime-changes.js\";\nimport { TurnAccumulator } from \"./capture/turn-accumulator.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** The connector's live capture state for one session: the open-turn\n *  accumulator and a monotonic source-event counter (the entry index woven into\n *  every event's idempotency key). The counter is SEEDED from the thread's\n *  durable committed-event count at attach, so a resume/reload continues past\n *  the prior session's keys rather than restarting at 0 and colliding (SV-001).\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\n *  per session, never part of the plain-data snapshot and never a PI object. */\ninterface CaptureSession {\n  piSessionId: string;\n  accumulator: TurnAccumulator;\n  sourceSeq: number;\n}\n\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\n *  identity, which survives reload/replay (the same thread re-resolves to the\n *  same id). */\nfunction sessionIdOf(ref: ThreadRef): string {\n  return \"threadId\" in ref ? ref.threadId : ref.filePath;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\n *  whose every operation fails closed (non-retryable) instead of fabricating a\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\n *  derivation work is ever queued and this provider is never invoked — it exists\n *  only to satisfy SDK construction (AC-1.1 \"initializes one LHC instance\").\n *\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\n *  documents as \"selectable only by explicit name — never a production default\"\n *  (it would mark fake derived text into the thread). Failing closed preserves\n *  the observe-only guarantee even if a future change queued work before Stories\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\n *  assignments), which is what a real *completing* inference requires (the\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\nfunction observeOnlyProvider(): DerivationProvider {\n  const notConfigured = (): Promise<ProviderResult> =>\n    Promise.resolve({\n      ok: false,\n      retryable: false,\n      reason: \"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\",\n    });\n  return {\n    smoothPrompt: notConfigured,\n    summarizeToolCall: notConfigured,\n    summarizeToolResult: notConfigured,\n    composeTurnRendering: notConfigured,\n    projectLowerBand: notConfigured,\n    summarizeChunkDetailed: notConfigured,\n    summarizeChunkBrief: notConfigured,\n  };\n}\n\n/** The production observe-only SDK config: a real, construction-valid instance\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n *  config. */\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n}\n\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\n *  show. */\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\n  const lines = choices.map((choice, i) => {\n    const title = choice.title ?? \"(untitled)\";\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\n  });\n  return [\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\n    ...lines,\n    \"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\",\n  ].join(\"\\n\");\n}\n\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\n *  interactive input/selection surface (wiring research), so the production\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\n *  most recently created thread as the best available explicit default. The\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\n *  takes the `select` seam); tests drive an explicit operator choice through it.\n *  A true interactive picker awaits a PI input surface; until then resuming a\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\n *  precise spec deviation. */\nfunction defaultSelectThread(\n  choices: readonly ThreadChoice[],\n  ctx: ExtensionContext,\n): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  if (mostRecent === undefined) return Promise.resolve(null);\n  if (ctx.hasUI) {\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n  }\n  return Promise.resolve(mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. The connector holds NO\n *  module-level or durable state of its own — reload reconstructs the thread from\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\n *  closure reattaches correctly (AC-1.5). */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\n  // none survives the connector — reload re-resolves from the registry.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n  let captureSession: CaptureSession | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // The registry/file deps every resolver path shares. `registryPath` is set\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveDeps;\n  }\n\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\n  // no-flag creates).\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    return resolveThread(launch, buildResolveDeps(ctx));\n  }\n\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\n  // instead of re-running the launch — a no-flag launch would otherwise create a\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n  async function resolveReloadFor(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\n  }\n\n  // session_start: resolve the recording thread and construct one background\n  // instance against it. Config is gated first so a session with no usable\n  // inference config resolves/creates nothing (no orphan thread). On reload the\n  // thread is re-resolved from the durable registry (reattach, never create);\n  // every other reason runs the normal launch resolution.\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n    const launch = parseLaunch();\n    const isReload = event.reason === \"reload\";\n    const resolved = isReload\n      ? await resolveReloadFor(launch, ctx)\n      : await resolveForLaunch(launch, ctx);\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      lastDiagnostic = isReload\n        ? diag(\"no_thread_to_reattach\", \"reload found no thread to reattach for this cwd\")\n        : diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n    const built = await initInstance(resolved.value, config.value);\n    if (!built.ok) {\n      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n      return;\n    }\n    instance = built.value;\n    state = createSessionState(resolved.value);\n    // Seed the capture counters from the thread's DURABLE committed state, so a\n    // resume/reload onto an EXISTING thread continues past the prior session's\n    // idempotency keys instead of restarting at 0 and silently skipping new\n    // finalized events as false duplicates (SV-001). A new thread reads back\n    // zero, so a fresh session is unchanged; the read is touch-suppressed and\n    // happens once per session_start, never per event.\n    const piSessionId = sessionIdOf(resolved.value);\n    const seed = await built.value.sdk.inspect.overview(resolved.value);\n    const sourceSeq = seed.ok ? seed.value.events.count : 0;\n    const startTurnSeq = seed.ok ? seed.value.turns.closed : 0;\n    captureSession = {\n      piSessionId,\n      accumulator: new TurnAccumulator({ piSessionId, startTurnSeq }),\n      sourceSeq,\n    };\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\n  // re-resolves its thread from the durable registry on the next session_start.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    captureSession = null;\n  };\n\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\n  // converter already recorded a durable gap for a writable-thread malformed\n  // event (`invalid_event`); a store-unavailable failure could not, so it\n  // surfaces as an extension health signal with no gap. Neither path throws.\n  function recordCaptureOutcome(\n    result: OpResult<BatchResult>,\n    events: readonly MessageEventInput[],\n  ): void {\n    if (result.ok) return;\n    const recordedGap = result.error.code === \"invalid_event\";\n    const failure: CaptureFailureDiagnostic = {\n      code: result.error.code,\n      message: result.error.reason,\n      recordedGap,\n    };\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\n    lastDiagnostic = failure;\n    if (state !== null) state.health.lastCaptureFailure = failure;\n  }\n\n  // The next monotonic source-event index, used as the event's entry id. The\n  // counter is seeded from durable thread state at attach, so within a session\n  // it numbers new finalized events past every prior key (no resume collision),\n  // and a brand-new thread numbers from 0.\n  function nextEntryId(session: CaptureSession): string {\n    const id = `s${session.sourceSeq}`;\n    session.sourceSeq += 1;\n    return id;\n  }\n\n  // message_end: map the finalized PI message to ordered LHC events, track the\n  // open turn, and flush through the converter (AC-2.1).\n  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n    const events = mapMessage(event.message, mapCtx);\n    captureSession.accumulator.onMessage(events);\n    if (events.length === 0) return;\n    recordCaptureOutcome(await capture(events, instance), events);\n  };\n\n  // model_select / thinking_level_select fire only in-stream — capture each as\n  // an ordered runtime_note the moment it fires (AC-2.8).\n  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n    const note = mapModelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n    if (instance === null || captureSession === null) return;\n    const mapCtx: MapCtx = { piSessionId: captureSession.piSessionId, entryId: nextEntryId(captureSession) };\n    const note = mapThinkingLevelSelect(event, mapCtx);\n    recordCaptureOutcome(await capture([note], instance), [note]);\n  };\n\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\n  const onAgentEnd: PiHookHandler<\"agent_end\"> = async () => {\n    if (instance === null || captureSession === null) return;\n    const turnEnd = captureSession.accumulator.onAgentEnd();\n    if (turnEnd.length === 0) return;\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\n  // turn_end, fork) stay no-ops here — turn_end is deliberately ignored as an\n  // LHC turn boundary (AC-2.2), and fork lands in Story 4. Each receives a\n  // FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — turn_end is ignored as a boundary; fork is Story 4.\n  };\n\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\n  // are live; PI per-step turn_end and fork remain no-ops.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\n    turn_end: noop,\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\n    session_before_fork: noop,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, and the `--resume` selector that presents the\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\n *  resolves/creates and initializes for real. On `/reload` the connector\n *  re-resolves the same thread from the durable registry (it keeps no\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\n *  config. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":482,"startLine":1,"totalLines":482}}}

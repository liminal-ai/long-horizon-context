{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LHQ9qeLgtP5mVDUzdu5ST5","type":"tool_result","content":"1\timport type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\n2\timport type { LhcInstance } from \"../shared/instance.js\";\n3\timport { fingerprint } from \"./idempotency.js\";\n4\t\n5\t// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\n6\t// isolating capture failure so it never throws back into a PI hook. The two\n7\t// failure shapes the AC distinguishes key off the SDK's error code:\n8\t//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\n9\t//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\n10\t//     dropped, then surface the original failure so the caller marks the gap.\n11\t//   - anything else (thread store unavailable): no durable gap is possible —\n12\t//     surface the failure for the caller to route to an extension health\n13\t//     signal. Either way the session continues.\n14\t//\n15\t// The map → accumulate orchestration runs in the composition root (index.ts),\n16\t// which routes this function's structured result into SessionState.health;\n17\t// capture itself stays boundary-pure (lhc + shared only).\n18\t\n19\tfunction detail(cause: unknown): string {\n20\t  return cause instanceof Error ? cause.message : String(cause);\n21\t}\n22\t\n23\t/** messageEvents returns OpResults for operational failures, but a thread file\n24\t *  in a genuinely broken state could still throw — contain that too, so capture\n25\t *  is total. */\n26\tasync function flushIsolated(\n27\t  instance: LhcInstance,\n28\t  events: readonly MessageEventInput[],\n29\t): Promise<OpResult<BatchResult>> {\n30\t  try {\n31\t    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\n32\t  } catch (cause) {\n33\t    return {\n34\t      ok: false,\n35\t      error: {\n36\t        errorClass: \"system_error\",\n37\t        code: \"storage_failure\",\n38\t        reason: `capture flush threw: ${detail(cause)}`,\n39\t      },\n40\t    };\n41\t  }\n42\t}\n43\t\n44\t/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\n45\t *  rides an existing intake kind (no new kind) and surfaces in the event log.\n46\t *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\n47\t *  bad batch dedups the gap rather than piling up duplicates. */\n48\tfunction gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\n49\t  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\n50\t  return {\n51\t    eventKind: \"runtime_note\",\n52\t    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\n53\t    actor: \"system\",\n54\t    harness: \"pi\",\n55\t    payload: { text },\n56\t  };\n57\t}\n58\t\n59\texport async function capture(\n60\t  events: MessageEventInput[],\n61\t  instance: LhcInstance,\n62\t): Promise<OpResult<BatchResult>> {\n63\t  const primary = await flushIsolated(instance, events);\n64\t  if (primary.ok) return primary;\n65\t\n66\t  if (primary.error.code === \"invalid_event\") {\n67\t    // Writable thread, malformed event: never drop — record a durable gap.\n68\t    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\n69\t    // If the gap write itself fails, the store went unavailable: surface that\n70\t    // (no durable gap was recorded) so the caller routes it to health.\n71\t    if (!gap.ok) return gap;\n72\t    return primary;\n73\t  }\n74\t\n75\t  // Store unavailable / other: no durable gap is possible.\n76\t  return primary;\n77\t}\n78\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"0982601d-ea71-4dc4-9da3-895539b57e25","timestamp":"2026-06-14T08:08:00.160Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/converter.ts","content":"import type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\nimport type { LhcInstance } from \"../shared/instance.js\";\nimport { fingerprint } from \"./idempotency.js\";\n\n// AC-2.1, AC-2.7: flush a mapped batch through `intakeStream.messageEvents`,\n// isolating capture failure so it never throws back into a PI hook. The two\n// failure shapes the AC distinguishes key off the SDK's error code:\n//   - `invalid_event` (a malformed/unmappable event on a WRITABLE thread):\n//     record a durable, queryable gap (a `runtime_note`) so nothing is silently\n//     dropped, then surface the original failure so the caller marks the gap.\n//   - anything else (thread store unavailable): no durable gap is possible —\n//     surface the failure for the caller to route to an extension health\n//     signal. Either way the session continues.\n//\n// The map → accumulate orchestration runs in the composition root (index.ts),\n// which routes this function's structured result into SessionState.health;\n// capture itself stays boundary-pure (lhc + shared only).\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n/** messageEvents returns OpResults for operational failures, but a thread file\n *  in a genuinely broken state could still throw — contain that too, so capture\n *  is total. */\nasync function flushIsolated(\n  instance: LhcInstance,\n  events: readonly MessageEventInput[],\n): Promise<OpResult<BatchResult>> {\n  try {\n    return await instance.sdk.intakeStream.messageEvents(instance.threadRef, events);\n  } catch (cause) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"system_error\",\n        code: \"storage_failure\",\n        reason: `capture flush threw: ${detail(cause)}`,\n      },\n    };\n  }\n}\n\n/** A durable, queryable gap marker for a rejected batch — a `runtime_note` so it\n *  rides an existing intake kind (no new kind) and surfaces in the event log.\n *  Its key is a fingerprint of the rejected batch, so re-delivery of the same\n *  bad batch dedups the gap rather than piling up duplicates. */\nfunction gapNote(events: readonly MessageEventInput[], reason: string): MessageEventInput {\n  const text = `capture gap: ${events.length} event(s) rejected — ${reason}`;\n  return {\n    eventKind: \"runtime_note\",\n    idempotencyKey: `pi-lhc:gap:${fingerprint(JSON.stringify(events), reason)}`,\n    actor: \"system\",\n    harness: \"pi\",\n    payload: { text },\n  };\n}\n\nexport async function capture(\n  events: MessageEventInput[],\n  instance: LhcInstance,\n): Promise<OpResult<BatchResult>> {\n  const primary = await flushIsolated(instance, events);\n  if (primary.ok) return primary;\n\n  if (primary.error.code === \"invalid_event\") {\n    // Writable thread, malformed event: never drop — record a durable gap.\n    const gap = await flushIsolated(instance, [gapNote(events, primary.error.reason)]);\n    // If the gap write itself fails, the store went unavailable: surface that\n    // (no durable gap was recorded) so the caller routes it to health.\n    if (!gap.ok) return gap;\n    return primary;\n  }\n\n  // Store unavailable / other: no durable gap is possible.\n  return primary;\n}\n","numLines":78,"startLine":1,"totalLines":78}}}

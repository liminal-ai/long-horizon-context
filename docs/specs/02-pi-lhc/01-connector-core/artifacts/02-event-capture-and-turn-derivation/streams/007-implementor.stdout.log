{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014McbGvvahSMgpgcBvnwcsZ","type":"tool_result","content":"1\timport type { MessageEventInput } from \"lhc\";\n2\timport { eventKey } from \"./idempotency.js\";\n3\t\n4\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n5\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n6\t//\n7\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n8\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\n9\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n10\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n11\t// no-op on reattach, since a fresh accumulator has no open turn to close.\n12\t\n13\texport interface TurnAccumulatorCtx {\n14\t  piSessionId: string;\n15\t  actor?: string;\n16\t  harness?: string;\n17\t  /** Seed for the turn counter, so a connector reattaching to an EXISTING\n18\t   *  thread continues past the prior session's turn_end keys instead of\n19\t   *  restarting at 0 and colliding with them (SV-001). Defaults to 0 — a fresh\n20\t   *  thread or a deterministic from-scratch replay starts here unchanged. */\n21\t  startTurnSeq?: number;\n22\t}\n23\t\n24\texport class TurnAccumulator {\n25\t  private readonly piSessionId: string;\n26\t  private readonly actor: string;\n27\t  private readonly harness: string;\n28\t  private open = false;\n29\t  // A monotonic counter giving each emitted `turn_end` a distinct idempotency\n30\t  // key. Seeded from the thread's durable closed-turn count at attach so a\n31\t  // resume/reload continues past prior keys; within a from-scratch run (seed 0)\n32\t  // it stays replay-stable, so a deterministic re-replay re-derives and dedups.\n33\t  private closedCount: number;\n34\t\n35\t  constructor(ctx: TurnAccumulatorCtx) {\n36\t    this.piSessionId = ctx.piSessionId;\n37\t    this.actor = ctx.actor ?? \"system\";\n38\t    this.harness = ctx.harness ?? \"pi\";\n39\t    this.closedCount = ctx.startTurnSeq ?? 0;\n40\t  }\n41\t\n42\t  /** Open the turn when this message's events include a `user_prompt`. A new\n43\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n44\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n45\t  onMessage(events: MessageEventInput[]): void {\n46\t    if (events.some((event) => event.eventKind === \"user_prompt\")) {\n47\t      this.open = true;\n48\t    }\n49\t  }\n50\t\n51\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n52\t   *  transition the accumulator drives, and it happens once per agent run. */\n53\t  onAgentEnd(): MessageEventInput[] {\n54\t    if (!this.open) return [];\n55\t    this.open = false;\n56\t    const key = eventKey({\n57\t      piSessionId: this.piSessionId,\n58\t      entryId: `turn:${this.closedCount}`,\n59\t      blockIndex: 0,\n60\t      kind: \"turn_end\",\n61\t    });\n62\t    this.closedCount += 1;\n63\t    return [\n64\t      {\n65\t        eventKind: \"turn_end\",\n66\t        idempotencyKey: key,\n67\t        actor: this.actor,\n68\t        harness: this.harness,\n69\t        payload: {},\n70\t      },\n71\t    ];\n72\t  }\n73\t\n74\t  hasOpenTurn(): boolean {\n75\t    return this.open;\n76\t  }\n77\t}\n78\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"da0fd61d-86dc-4c59-bb7b-02544fe6172f","timestamp":"2026-06-14T08:08:01.613Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/capture/turn-accumulator.ts","content":"import type { MessageEventInput } from \"lhc\";\nimport { eventKey } from \"./idempotency.js\";\n\n// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n//\n// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n// The converter never feeds PI's per-step `turn_end` here, so it can never close\n// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n// no-op on reattach, since a fresh accumulator has no open turn to close.\n\nexport interface TurnAccumulatorCtx {\n  piSessionId: string;\n  actor?: string;\n  harness?: string;\n  /** Seed for the turn counter, so a connector reattaching to an EXISTING\n   *  thread continues past the prior session's turn_end keys instead of\n   *  restarting at 0 and colliding with them (SV-001). Defaults to 0 — a fresh\n   *  thread or a deterministic from-scratch replay starts here unchanged. */\n  startTurnSeq?: number;\n}\n\nexport class TurnAccumulator {\n  private readonly piSessionId: string;\n  private readonly actor: string;\n  private readonly harness: string;\n  private open = false;\n  // A monotonic counter giving each emitted `turn_end` a distinct idempotency\n  // key. Seeded from the thread's durable closed-turn count at attach so a\n  // resume/reload continues past prior keys; within a from-scratch run (seed 0)\n  // it stays replay-stable, so a deterministic re-replay re-derives and dedups.\n  private closedCount: number;\n\n  constructor(ctx: TurnAccumulatorCtx) {\n    this.piSessionId = ctx.piSessionId;\n    this.actor = ctx.actor ?? \"system\";\n    this.harness = ctx.harness ?? \"pi\";\n    this.closedCount = ctx.startTurnSeq ?? 0;\n  }\n\n  /** Open the turn when this message's events include a `user_prompt`. A new\n   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n  onMessage(events: MessageEventInput[]): void {\n    if (events.some((event) => event.eventKind === \"user_prompt\")) {\n      this.open = true;\n    }\n  }\n\n  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n   *  transition the accumulator drives, and it happens once per agent run. */\n  onAgentEnd(): MessageEventInput[] {\n    if (!this.open) return [];\n    this.open = false;\n    const key = eventKey({\n      piSessionId: this.piSessionId,\n      entryId: `turn:${this.closedCount}`,\n      blockIndex: 0,\n      kind: \"turn_end\",\n    });\n    this.closedCount += 1;\n    return [\n      {\n        eventKind: \"turn_end\",\n        idempotencyKey: key,\n        actor: this.actor,\n        harness: this.harness,\n        payload: {},\n      },\n    ];\n  }\n\n  hasOpenTurn(): boolean {\n    return this.open;\n  }\n}\n","numLines":78,"startLine":1,"totalLines":78}}}

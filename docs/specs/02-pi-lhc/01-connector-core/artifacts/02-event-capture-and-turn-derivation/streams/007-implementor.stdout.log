{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018srv7tqLtyCJ8QwvBpYS6K","type":"tool_result","content":"1\t// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\n2\t// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\n3\t// it drives the PRODUCTION connector path (createConnector → hook handlers →\n4\t// converter → real LHC intake) so every capture test asserts on recorded\n5\t// thread state, never on a mocked intake. The two external edges stay as the\n6\t// tech design fixes them — the PI hook surface is fed synthetic events, and the\n7\t// SDK runs real against a temp SQLite thread with the deterministic provider\n8\t// (selected by explicit name, never a production default).\n9\timport {\n10\t  createDeterministicProvider,\n11\t  inspect,\n12\t  intakeStream,\n13\t  type EventKind,\n14\t  type MessageEventInput,\n15\t  type OpResult,\n16\t  type SdkConfig,\n17\t  type ThreadRef,\n18\t} from \"lhc\";\n19\timport { createConnector, type Connector } from \"../../src/index.js\";\n20\timport type { LaunchFlags } from \"../../src/lifecycle/thread-resolution.js\";\n21\timport type { ExtensionContext, SessionStartReason } from \"../../src/pi/types.js\";\n22\timport { makeSessionStart } from \"../fixtures/synthetic.js\";\n23\timport type { TempStore } from \"../fixtures/thread.js\";\n24\t\n25\t/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\n26\t *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\n27\t *  assume a TUI. */\n28\texport function syntheticCtx(cwd = \"/work/capture\"): ExtensionContext {\n29\t  return {\n30\t    cwd,\n31\t    hasUI: false,\n32\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n33\t    ui: { notify: () => {} },\n34\t    sessionManager: { getEntries: () => [] },\n35\t  };\n36\t}\n37\t\n38\t/** The capture-suite SDK config: a real background instance on the\n39\t *  deterministic provider, so a captured user_prompt's queued derivation has a\n40\t *  handler to settle and never strands background work. */\n41\texport function captureConfig(): OpResult<SdkConfig> {\n42\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n43\t}\n44\t\n45\texport interface StartedCapture {\n46\t  connector: Connector;\n47\t  ctx: ExtensionContext;\n48\t  threadRef: ThreadRef;\n49\t}\n50\t\n51\t/** Start a connector against a temp store under the given launch flags and fire\n52\t *  `session_start{reason}`. The driver for existing-thread reattach: pass\n53\t *  `{ session: threadId }` with reason `\"resume\"`/`\"reload\"` to attach a fresh\n54\t *  connector to a thread a prior connector created. */\n55\texport async function attachCapture(\n56\t  store: TempStore,\n57\t  launch: LaunchFlags,\n58\t  reason: SessionStartReason,\n59\t  cwd = \"/work/capture\",\n60\t): Promise<StartedCapture> {\n61\t  const connector = createConnector({\n62\t    registryPath: store.registryPath,\n63\t    newThreadFilePath: () => store.threadPath(),\n64\t    parseLaunch: () => launch,\n65\t    buildSdkConfig: () => captureConfig(),\n66\t  });\n67\t  const ctx = syntheticCtx(cwd);\n68\t  await connector.handlers.session_start(ctx, makeSessionStart(reason));\n69\t  const state = connector.getState();\n70\t  if (state === null) throw new Error(\"attachCapture: session_start did not resolve a thread\");\n71\t  return { connector, ctx, threadRef: state.threadRef };\n72\t}\n73\t\n74\t/** Start a connector against a temp store and fire `session_start{new}` so a\n75\t *  background instance + thread exist and the capture hooks are live. */\n76\texport async function startCapture(store: TempStore, cwd = \"/work/capture\"): Promise<StartedCapture> {\n77\t  return attachCapture(store, {}, \"new\", cwd);\n78\t}\n79\t\n80\t/** Settle background work and dispose, then read the durable event log back in\n81\t *  recorded order — capture's product is the stored thread, so tests assert on\n82\t *  this. */\n83\texport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\n84\t  await started.connector.handlers.session_shutdown(started.ctx, { reason: \"shutdown\" });\n85\t  const read = await intakeStream.listEvents(started.threadRef);\n86\t  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n87\t  // Strip the server-stamped fields so the comparison is over the logical\n88\t  // intake shape the converter produced.\n89\t  return read.value.map((record) => ({\n90\t    eventKind: record.eventKind,\n91\t    idempotencyKey: record.idempotencyKey,\n92\t    actor: record.actor,\n93\t    harness: record.harness,\n94\t    payload: record.payload,\n95\t  })) as MessageEventInput[];\n96\t}\n97\t\n98\t/** The ordered event-kind sequence — the spine every capture test checks. */\n99\texport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\n100\t  return events.map((event) => event.eventKind);\n101\t}\n102\t\n103\t/** Counts open/closed turns and total recorded events from the inspect\n104\t *  overview (the real read-back surface, not a private query). */\n105\texport async function turnCounts(\n106\t  threadRef: ThreadRef,\n107\t): Promise<{ open: number; closed: number; events: number }> {\n108\t  const overview = await inspect.overview(threadRef);\n109\t  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\n110\t  return {\n111\t    open: overview.value.turns.open,\n112\t    closed: overview.value.turns.closed,\n113\t    events: overview.value.events.count,\n114\t  };\n115\t}\n116\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"72835906-9713-4dd2-beac-601ebf221503","timestamp":"2026-06-14T08:10:57.691Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/support.ts","content":"// Shared, assertion-free scaffolding for the Story 2 capture suite. Like the\n// fixtures (synthetic.ts, thread.ts) this is test infrastructure, not a test:\n// it drives the PRODUCTION connector path (createConnector → hook handlers →\n// converter → real LHC intake) so every capture test asserts on recorded\n// thread state, never on a mocked intake. The two external edges stay as the\n// tech design fixes them — the PI hook surface is fed synthetic events, and the\n// SDK runs real against a temp SQLite thread with the deterministic provider\n// (selected by explicit name, never a production default).\nimport {\n  createDeterministicProvider,\n  inspect,\n  intakeStream,\n  type EventKind,\n  type MessageEventInput,\n  type OpResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";\nimport type { LaunchFlags } from \"../../src/lifecycle/thread-resolution.js\";\nimport type { ExtensionContext, SessionStartReason } from \"../../src/pi/types.js\";\nimport { makeSessionStart } from \"../fixtures/synthetic.js\";\nimport type { TempStore } from \"../fixtures/thread.js\";\n\n/** A per-hook ctx carrying methods (not plain data), exactly as PI hands each\n *  hook a fresh context object. Headless (`hasUI:false`) — capture must not\n *  assume a TUI. */\nexport function syntheticCtx(cwd = \"/work/capture\"): ExtensionContext {\n  return {\n    cwd,\n    hasUI: false,\n    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n    ui: { notify: () => {} },\n    sessionManager: { getEntries: () => [] },\n  };\n}\n\n/** The capture-suite SDK config: a real background instance on the\n *  deterministic provider, so a captured user_prompt's queued derivation has a\n *  handler to settle and never strands background work. */\nexport function captureConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n}\n\nexport interface StartedCapture {\n  connector: Connector;\n  ctx: ExtensionContext;\n  threadRef: ThreadRef;\n}\n\n/** Start a connector against a temp store under the given launch flags and fire\n *  `session_start{reason}`. The driver for existing-thread reattach: pass\n *  `{ session: threadId }` with reason `\"resume\"`/`\"reload\"` to attach a fresh\n *  connector to a thread a prior connector created. */\nexport async function attachCapture(\n  store: TempStore,\n  launch: LaunchFlags,\n  reason: SessionStartReason,\n  cwd = \"/work/capture\",\n): Promise<StartedCapture> {\n  const connector = createConnector({\n    registryPath: store.registryPath,\n    newThreadFilePath: () => store.threadPath(),\n    parseLaunch: () => launch,\n    buildSdkConfig: () => captureConfig(),\n  });\n  const ctx = syntheticCtx(cwd);\n  await connector.handlers.session_start(ctx, makeSessionStart(reason));\n  const state = connector.getState();\n  if (state === null) throw new Error(\"attachCapture: session_start did not resolve a thread\");\n  return { connector, ctx, threadRef: state.threadRef };\n}\n\n/** Start a connector against a temp store and fire `session_start{new}` so a\n *  background instance + thread exist and the capture hooks are live. */\nexport async function startCapture(store: TempStore, cwd = \"/work/capture\"): Promise<StartedCapture> {\n  return attachCapture(store, {}, \"new\", cwd);\n}\n\n/** Settle background work and dispose, then read the durable event log back in\n *  recorded order — capture's product is the stored thread, so tests assert on\n *  this. */\nexport async function eventsAfterShutdown(started: StartedCapture): Promise<MessageEventInput[]> {\n  await started.connector.handlers.session_shutdown(started.ctx, { reason: \"shutdown\" });\n  const read = await intakeStream.listEvents(started.threadRef);\n  if (!read.ok) throw new Error(`listEvents failed: ${read.error.reason}`);\n  // Strip the server-stamped fields so the comparison is over the logical\n  // intake shape the converter produced.\n  return read.value.map((record) => ({\n    eventKind: record.eventKind,\n    idempotencyKey: record.idempotencyKey,\n    actor: record.actor,\n    harness: record.harness,\n    payload: record.payload,\n  })) as MessageEventInput[];\n}\n\n/** The ordered event-kind sequence — the spine every capture test checks. */\nexport function kindsOf(events: readonly MessageEventInput[]): EventKind[] {\n  return events.map((event) => event.eventKind);\n}\n\n/** Counts open/closed turns and total recorded events from the inspect\n *  overview (the real read-back surface, not a private query). */\nexport async function turnCounts(\n  threadRef: ThreadRef,\n): Promise<{ open: number; closed: number; events: number }> {\n  const overview = await inspect.overview(threadRef);\n  if (!overview.ok) throw new Error(`overview failed: ${overview.error.reason}`);\n  return {\n    open: overview.value.turns.open,\n    closed: overview.value.turns.closed,\n    events: overview.value.events.count,\n  };\n}\n","numLines":116,"startLine":1,"totalLines":116}}}

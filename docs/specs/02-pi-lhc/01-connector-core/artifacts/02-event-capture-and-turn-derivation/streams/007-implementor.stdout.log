{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NwLareoM9GkoThGYPQCiWB","type":"tool_result","content":"1\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\n2\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n3\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n4\t// must add nothing the second time. The key goldens pin construction precedence:\n5\t// PI entry id → provider response / tool-call id → content fingerprint, with\n6\t// blockIndex and kind disambiguating one message's fan-out.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\n9\timport { capture } from \"../../src/capture/converter.js\";\n10\timport { eventKey } from \"../../src/capture/idempotency.js\";\n11\timport { mapMessage } from \"../../src/capture/map-message.js\";\n12\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n13\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n14\timport type { AgentMessage } from \"../../src/pi/types.js\";\n15\timport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\n16\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n17\t\n18\tlet store: TempStore;\n19\tbeforeEach(() => {\n20\t  store = tempStore();\n21\t});\n22\tafterEach(() => {\n23\t  store.cleanup();\n24\t});\n25\t\n26\tdescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n27\t  it(\"is deterministic: identical input yields an identical key\", () => {\n28\t    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n29\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\n30\t  });\n31\t\n32\t  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n33\t    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n34\t    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n35\t    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n36\t    expect(thinking).toContain(\"e1\");\n37\t    // Same entry, different block → different key (fan-out stays distinct).\n38\t    expect(text).not.toBe(thinking);\n39\t    // Same entry + block, different kind → still distinct.\n40\t    expect(textSameBlock).not.toBe(thinking);\n41\t  });\n42\t\n43\t  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n44\t    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n45\t    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n46\t    expect(call).toContain(\"call_a\");\n47\t    expect(result).toContain(\"call_a\");\n48\t    expect(call).not.toBe(result);\n49\t  });\n50\t\n51\t  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n52\t    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n53\t    expect(key).toContain(\"resp_7\");\n54\t  });\n55\t\n56\t  it(\"falls to a content fingerprint as last resort: same content same key, different content different key\", () => {\n57\t    const a = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n58\t    const aAgain = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n59\t    const b = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"world\" });\n60\t    expect(aAgain).toBe(a);\n61\t    expect(b).not.toBe(a);\n62\t  });\n63\t\n64\t  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n65\t    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n66\t    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n67\t    expect(withBoth).toBe(entryOnly);\n68\t  });\n69\t});\n70\t\n71\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n72\t  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n73\t  const events: MessageEventInput[] = [];\n74\t  source.forEach((message, index) => {\n75\t    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n76\t    acc.onMessage(mapped);\n77\t    events.push(...mapped);\n78\t  });\n79\t  events.push(...acc.onAgentEnd());\n80\t  return events;\n81\t}\n82\t\n83\tdescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n84\t  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n85\t    const thread = await makeTempThread(store);\n86\t    const built = await initInstance(thread.threadRef, {\n87\t      provider: createDeterministicProvider(),\n88\t      mode: \"background\",\n89\t    });\n90\t    expect(built.ok).toBe(true);\n91\t    if (!built.ok) return;\n92\t    const instance = built.value;\n93\t\n94\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n95\t\n96\t    const first = await capture(batch, instance);\n97\t    expect(first.ok).toBe(true);\n98\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n99\t\n100\t    const replay = await capture(batch, instance);\n101\t    expect(replay.ok).toBe(true);\n102\t    if (replay.ok) {\n103\t      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n104\t    }\n105\t\n106\t    const read = await intakeStream.listEvents(instance.threadRef);\n107\t    expect(read.ok).toBe(true);\n108\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n109\t\n110\t    await instance.dispose();\n111\t  });\n112\t});\n113\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"e5fbd0e0-065f-436d-8a4c-4f4afd57df8e","timestamp":"2026-06-14T08:11:58.872Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/idempotency.test.ts","content":"// Story 2 — idempotency: the deterministic key-construction goldens plus the\n// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n// must add nothing the second time. The key goldens pin construction precedence:\n// PI entry id → provider response / tool-call id → content fingerprint, with\n// blockIndex and kind disambiguating one message's fan-out.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\nimport { capture } from \"../../src/capture/converter.js\";\nimport { eventKey } from \"../../src/capture/idempotency.js\";\nimport { mapMessage } from \"../../src/capture/map-message.js\";\nimport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\nimport { initInstance } from \"../../src/lifecycle/instance.js\";\nimport type { AgentMessage } from \"../../src/pi/types.js\";\nimport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\nimport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\ndescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n  it(\"is deterministic: identical input yields an identical key\", () => {\n    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n    expect(eventKey(input)).toBe(eventKey({ ...input }));\n  });\n\n  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n    expect(thinking).toContain(\"e1\");\n    // Same entry, different block → different key (fan-out stays distinct).\n    expect(text).not.toBe(thinking);\n    // Same entry + block, different kind → still distinct.\n    expect(textSameBlock).not.toBe(thinking);\n  });\n\n  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n    expect(call).toContain(\"call_a\");\n    expect(result).toContain(\"call_a\");\n    expect(call).not.toBe(result);\n  });\n\n  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n    expect(key).toContain(\"resp_7\");\n  });\n\n  it(\"falls to a content fingerprint as last resort: same content same key, different content different key\", () => {\n    const a = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    const aAgain = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    const b = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"world\" });\n    expect(aAgain).toBe(a);\n    expect(b).not.toBe(a);\n  });\n\n  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n    expect(withBoth).toBe(entryOnly);\n  });\n});\n\nfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n  const events: MessageEventInput[] = [];\n  source.forEach((message, index) => {\n    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n    acc.onMessage(mapped);\n    events.push(...mapped);\n  });\n  events.push(...acc.onAgentEnd());\n  return events;\n}\n\ndescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n    const thread = await makeTempThread(store);\n    const built = await initInstance(thread.threadRef, {\n      provider: createDeterministicProvider(),\n      mode: \"background\",\n    });\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n    const instance = built.value;\n\n    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n\n    const first = await capture(batch, instance);\n    expect(first.ok).toBe(true);\n    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n\n    const replay = await capture(batch, instance);\n    expect(replay.ok).toBe(true);\n    if (replay.ok) {\n      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n    }\n\n    const read = await intakeStream.listEvents(instance.threadRef);\n    expect(read.ok).toBe(true);\n    if (read.ok) expect(read.value).toHaveLength(batch.length);\n\n    await instance.dispose();\n  });\n});\n","numLines":113,"startLine":1,"totalLines":113}}}

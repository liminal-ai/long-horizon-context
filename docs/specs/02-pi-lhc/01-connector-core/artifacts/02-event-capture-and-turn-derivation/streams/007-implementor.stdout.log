{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FWAg3Zk7AYPhnvCNXqhEPM","type":"tool_result","content":"1\t// Story 2 — SV-001 regression: existing-thread resume/reload must keep recording\n2\t// new finalized events. The connector seeds its capture counters from the\n3\t// thread's durable committed state at attach, so a fresh connector's idempotency\n4\t// keys continue past the prior session's instead of restarting at 0 and\n5\t// skipping new events as false duplicates — while the converter's same-key\n6\t// dedup (the reload/replay safety net) stays intact.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  createDeterministicProvider,\n10\t  intakeStream,\n11\t  type MessageEventInput,\n12\t  type ThreadRef,\n13\t} from \"lhc\";\n14\timport { capture } from \"../../src/capture/converter.js\";\n15\timport { mapMessage } from \"../../src/capture/map-message.js\";\n16\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n17\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n18\timport {\n19\t  makeAgentEnd,\n20\t  makeAssistantMessage,\n21\t  makeMessageEnd,\n22\t  makeUserMessage,\n23\t} from \"../fixtures/synthetic.js\";\n24\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n25\timport { attachCapture, eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n26\t\n27\tlet store: TempStore;\n28\tbeforeEach(() => {\n29\t  store = tempStore();\n30\t});\n31\tafterEach(() => {\n32\t  store.cleanup();\n33\t});\n34\t\n35\tfunction textOf(event: MessageEventInput): string {\n36\t  return (event.payload as { text?: string }).text ?? \"\";\n37\t}\n38\t\n39\tfunction userTexts(events: readonly MessageEventInput[]): string[] {\n40\t  return events.filter((event) => event.eventKind === \"user_prompt\").map(textOf);\n41\t}\n42\t\n43\tfunction threadIdOf(ref: ThreadRef): string {\n44\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n45\t  return ref.threadId;\n46\t}\n47\t\n48\tdescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n49\t  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n50\t    // Session A records one exchange, then shuts down.\n51\t    const a = await startCapture(store);\n52\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n53\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n54\t    const threadId = threadIdOf(a.threadRef);\n55\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n56\t\n57\t    // A brand-new connector attaches to the SAME thread by id and records a new\n58\t    // message — it must NOT be skipped as a prior-key collision.\n59\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n60\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n61\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n62\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n63\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n64\t\n65\t    const events = await eventsAfterShutdown(b);\n66\t    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n67\t    const counts = await turnCounts(b.threadRef);\n68\t    expect(counts.closed).toBe(2);\n69\t  });\n70\t\n71\t  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n72\t    const a = await startCapture(store);\n73\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n74\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n75\t    const threadId = threadIdOf(a.threadRef);\n76\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n77\t\n78\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n79\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after reload\")));\n80\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n81\t\n82\t    const events = await eventsAfterShutdown(b);\n83\t    expect(userTexts(events)).toEqual([\"first\", \"second after reload\"]);\n84\t    const counts = await turnCounts(b.threadRef);\n85\t    expect(counts.closed).toBe(2);\n86\t  });\n87\t\n88\t  it(\"(3) normal resume records new messages and does not duplicate the prior session's history\", async () => {\n89\t    // Session A: one complete turn.\n90\t    const a = await startCapture(store);\n91\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n92\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer one\" })));\n93\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n94\t    const threadId = threadIdOf(a.threadRef);\n95\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n96\t\n97\t    // Resume: PI does not re-fire history, so the connector sees only the new\n98\t    // turn — which must record, leaving the prior turn intact and un-duplicated.\n99\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n100\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second\")));\n101\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer two\" })));\n102\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n103\t\n104\t    const events = await eventsAfterShutdown(b);\n105\t    expect(kindsOf(events)).toEqual([\n106\t      \"user_prompt\",\n107\t      \"assistant_text\",\n108\t      \"turn_end\",\n109\t      \"user_prompt\",\n110\t      \"assistant_text\",\n111\t      \"turn_end\",\n112\t    ]);\n113\t    expect(userTexts(events)).toEqual([\"first\", \"second\"]);\n114\t    // Two distinct closed turns — the turn_end keys did not collide either.\n115\t    const counts = await turnCounts(b.threadRef);\n116\t    expect(counts.closed).toBe(2);\n117\t    expect(counts.open).toBe(0);\n118\t  });\n119\t\n120\t  it(\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\", async () => {\n121\t    const thread = await makeTempThread(store);\n122\t    const built = await initInstance(thread.threadRef, {\n123\t      provider: createDeterministicProvider(),\n124\t      mode: \"background\",\n125\t    });\n126\t    expect(built.ok).toBe(true);\n127\t    if (!built.ok) return;\n128\t    const instance = built.value;\n129\t\n130\t    // Build one turn's events with stable keys, then deliver the SAME batch\n131\t    // twice — the second delivery (the reload / crash-replay shape) must dedup.\n132\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n133\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n134\t    acc.onMessage(userEvents);\n135\t    const batch = [...userEvents, ...acc.onAgentEnd()];\n136\t\n137\t    const first = await capture(batch, instance);\n138\t    expect(first.ok).toBe(true);\n139\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n140\t\n141\t    const second = await capture(batch, instance);\n142\t    expect(second.ok).toBe(true);\n143\t    if (second.ok) expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n144\t\n145\t    const read = await intakeStream.listEvents(instance.threadRef);\n146\t    expect(read.ok).toBe(true);\n147\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n148\t\n149\t    await instance.dispose();\n150\t  });\n151\t});\n152\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"5d3948d9-1bfb-4f13-9ebe-befe016576f3","timestamp":"2026-06-14T08:10:57.372Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/reattach-idempotency.test.ts","content":"// Story 2 — SV-001 regression: existing-thread resume/reload must keep recording\n// new finalized events. The connector seeds its capture counters from the\n// thread's durable committed state at attach, so a fresh connector's idempotency\n// keys continue past the prior session's instead of restarting at 0 and\n// skipping new events as false duplicates — while the converter's same-key\n// dedup (the reload/replay safety net) stays intact.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  intakeStream,\n  type MessageEventInput,\n  type ThreadRef,\n} from \"lhc\";\nimport { capture } from \"../../src/capture/converter.js\";\nimport { mapMessage } from \"../../src/capture/map-message.js\";\nimport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\nimport { initInstance } from \"../../src/lifecycle/instance.js\";\nimport {\n  makeAgentEnd,\n  makeAssistantMessage,\n  makeMessageEnd,\n  makeUserMessage,\n} from \"../fixtures/synthetic.js\";\nimport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\nimport { attachCapture, eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction textOf(event: MessageEventInput): string {\n  return (event.payload as { text?: string }).text ?? \"\";\n}\n\nfunction userTexts(events: readonly MessageEventInput[]): string[] {\n  return events.filter((event) => event.eventKind === \"user_prompt\").map(textOf);\n}\n\nfunction threadIdOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\ndescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n    // Session A records one exchange, then shuts down.\n    const a = await startCapture(store);\n    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    const threadId = threadIdOf(a.threadRef);\n    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n\n    // A brand-new connector attaches to the SAME thread by id and records a new\n    // message — it must NOT be skipped as a prior-key collision.\n    const b = await attachCapture(store, { session: threadId }, \"resume\");\n    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n\n    const events = await eventsAfterShutdown(b);\n    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n    const counts = await turnCounts(b.threadRef);\n    expect(counts.closed).toBe(2);\n  });\n\n  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n    const a = await startCapture(store);\n    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    const threadId = threadIdOf(a.threadRef);\n    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n\n    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after reload\")));\n    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n\n    const events = await eventsAfterShutdown(b);\n    expect(userTexts(events)).toEqual([\"first\", \"second after reload\"]);\n    const counts = await turnCounts(b.threadRef);\n    expect(counts.closed).toBe(2);\n  });\n\n  it(\"(3) normal resume records new messages and does not duplicate the prior session's history\", async () => {\n    // Session A: one complete turn.\n    const a = await startCapture(store);\n    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer one\" })));\n    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    const threadId = threadIdOf(a.threadRef);\n    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n\n    // Resume: PI does not re-fire history, so the connector sees only the new\n    // turn — which must record, leaving the prior turn intact and un-duplicated.\n    const b = await attachCapture(store, { session: threadId }, \"resume\");\n    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second\")));\n    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer two\" })));\n    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n\n    const events = await eventsAfterShutdown(b);\n    expect(kindsOf(events)).toEqual([\n      \"user_prompt\",\n      \"assistant_text\",\n      \"turn_end\",\n      \"user_prompt\",\n      \"assistant_text\",\n      \"turn_end\",\n    ]);\n    expect(userTexts(events)).toEqual([\"first\", \"second\"]);\n    // Two distinct closed turns — the turn_end keys did not collide either.\n    const counts = await turnCounts(b.threadRef);\n    expect(counts.closed).toBe(2);\n    expect(counts.open).toBe(0);\n  });\n\n  it(\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\", async () => {\n    const thread = await makeTempThread(store);\n    const built = await initInstance(thread.threadRef, {\n      provider: createDeterministicProvider(),\n      mode: \"background\",\n    });\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n    const instance = built.value;\n\n    // Build one turn's events with stable keys, then deliver the SAME batch\n    // twice — the second delivery (the reload / crash-replay shape) must dedup.\n    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n    acc.onMessage(userEvents);\n    const batch = [...userEvents, ...acc.onAgentEnd()];\n\n    const first = await capture(batch, instance);\n    expect(first.ok).toBe(true);\n    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n\n    const second = await capture(batch, instance);\n    expect(second.ok).toBe(true);\n    if (second.ok) expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n\n    const read = await intakeStream.listEvents(instance.threadRef);\n    expect(read.ok).toBe(true);\n    if (read.ok) expect(read.value).toHaveLength(batch.length);\n\n    await instance.dispose();\n  });\n});\n","numLines":152,"startLine":1,"totalLines":152}}}

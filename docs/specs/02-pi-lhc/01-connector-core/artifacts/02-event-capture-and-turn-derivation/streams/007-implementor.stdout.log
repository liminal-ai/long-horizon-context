{"type":"stream_event","event":{"type":"content_block_delta","index":4,"delta":{"type":"input_json_delta","partial_json":"test/capture/turn-derivation.test.ts"}},"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","parent_tool_use_id":null,"uuid":"30141f58-1470-431c-b62a-54fbc9f92020"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CtjFcBaLbmyMixjhLoCRL6","type":"tool_result","content":"1\t// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\n2\t// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\n3\t// production path runs end to end — PI hook → converter → real LHC intake —\n4\t// and every assertion reads the durable thread back. TC-2.8 also exercises\n5\t// capture() directly because the two failure shapes (writable→gap vs\n6\t// store-unavailable→health) are the architecture-risk contract.\n7\timport { rmSync } from \"node:fs\";\n8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n9\timport {\n10\t  createDeterministicProvider,\n11\t  intakeStream,\n12\t  threads,\n13\t  type MessageEventInput,\n14\t  type ThreadRef,\n15\t} from \"lhc\";\n16\timport { capture } from \"../../src/capture/converter.js\";\n17\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n18\timport type { LhcInstance } from \"../../src/shared/instance.js\";\n19\timport {\n20\t  makeAgentEnd,\n21\t  makeAssistantMessage,\n22\t  makeMessageEnd,\n23\t  makeToolResult,\n24\t  makeUserMessage,\n25\t  validEvent,\n26\t} from \"../fixtures/synthetic.js\";\n27\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n28\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n29\t\n30\tlet store: TempStore;\n31\tbeforeEach(() => {\n32\t  store = tempStore();\n33\t});\n34\tafterEach(() => {\n35\t  store.cleanup();\n36\t});\n37\t\n38\tfunction textOf(event: MessageEventInput): string {\n39\t  return (event.payload as { text?: string }).text ?? \"\";\n40\t}\n41\t\n42\tdescribe(\"Story 2: converter — capture and fan-out (TC-2.1)\", () => {\n43\t  it(\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\", async () => {\n44\t    const started = await startCapture(store);\n45\t    const { connector, ctx } = started;\n46\t\n47\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read the file\")));\n48\t    await connector.handlers.message_end(\n49\t      ctx,\n50\t      makeMessageEnd(\n51\t        makeAssistantMessage({\n52\t          thinking: \"I should open it\",\n53\t          text: \"here is the answer\",\n54\t          toolCalls: [{ id: \"call_x\", name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n55\t        }),\n56\t      ),\n57\t    );\n58\t    await connector.handlers.message_end(\n59\t      ctx,\n60\t      makeMessageEnd(makeToolResult({ id: \"call_x\", content: \"file body\" })),\n61\t    );\n62\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n63\t\n64\t    // No silent capture failure on the happy path.\n65\t    expect(connector.snapshot().lastDiagnostic).toBeNull();\n66\t\n67\t    const events = await eventsAfterShutdown(started);\n68\t    expect(kindsOf(events)).toEqual([\n69\t      \"user_prompt\",\n70\t      \"assistant_thinking\",\n71\t      \"assistant_text\",\n72\t      \"tool_call\",\n73\t      \"tool_result\",\n74\t      \"turn_end\",\n75\t    ]);\n76\t\n77\t    expect(textOf(events[0]!)).toBe(\"read the file\");\n78\t    expect(textOf(events[1]!)).toBe(\"I should open it\");\n79\t    expect(textOf(events[2]!)).toBe(\"here is the answer\");\n80\t    expect(events[3]!.payload).toMatchObject({\n81\t      toolCallId: \"call_x\",\n82\t      toolName: \"read_file\",\n83\t      arguments: { path: \"notes.txt\" },\n84\t    });\n85\t    expect(events[4]!.payload).toMatchObject({ toolCallId: \"call_x\", content: \"file body\" });\n86\t  });\n87\t});\n88\t\n89\tdescribe(\"Story 2: converter — runtime-change capture (TC-2.9)\", () => {\n90\t  it(\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\", async () => {\n91\t    const started = await startCapture(store);\n92\t    const { connector, ctx } = started;\n93\t\n94\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"go\")));\n95\t    await connector.handlers.model_select(ctx, {\n96\t      model: { provider: \"openai\", id: \"gpt-4o\" },\n97\t      previousModel: { provider: \"anthropic\", id: \"claude-3\" },\n98\t    });\n99\t    await connector.handlers.thinking_level_select(ctx, { level: \"high\", previousLevel: \"low\" });\n100\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"done\" })));\n101\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n102\t\n103\t    const events = await eventsAfterShutdown(started);\n104\t    // Ordering relative to the surrounding messages is preserved.\n105\t    expect(kindsOf(events)).toEqual([\n106\t      \"user_prompt\",\n107\t      \"runtime_note\",\n108\t      \"runtime_note\",\n109\t      \"assistant_text\",\n110\t      \"turn_end\",\n111\t    ]);\n112\t\n113\t    const modelNote = textOf(events[1]!);\n114\t    expect(modelNote).toContain(\"anthropic/claude-3\");\n115\t    expect(modelNote).toContain(\"openai/gpt-4o\");\n116\t\n117\t    const levelNote = textOf(events[2]!);\n118\t    expect(levelNote).toContain(\"low\");\n119\t    expect(levelNote).toContain(\"high\");\n120\t  });\n121\t});\n122\t\n123\tdescribe(\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\", () => {\n124\t  async function liveInstance(): Promise<LhcInstance> {\n125\t    const thread = await makeTempThread(store);\n126\t    const built = await initInstance(thread.threadRef, {\n127\t      provider: createDeterministicProvider(),\n128\t      mode: \"background\",\n129\t    });\n130\t    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\n131\t    return built.value;\n132\t  }\n133\t\n134\t  it(\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\", async () => {\n135\t    const instance = await liveInstance();\n136\t    // A turn_end with a non-empty payload is rejected by LHC validation\n137\t    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\n138\t    const malformed = {\n139\t      eventKind: \"turn_end\",\n140\t      idempotencyKey: \"malformed-1\",\n141\t      actor: \"system\",\n142\t      harness: \"pi\",\n143\t      payload: { stowaway: true },\n144\t    } as unknown as MessageEventInput;\n145\t\n146\t    const result = await capture([malformed], instance);\n147\t    expect(result.ok).toBe(false);\n148\t\n149\t    // The session continues: a durable, queryable gap is recorded on the thread.\n150\t    const read = await intakeStream.listEvents(instance.threadRef);\n151\t    expect(read.ok).toBe(true);\n152\t    if (!read.ok) return;\n153\t    const gaps = read.value.filter(\n154\t      (event) =>\n155\t        event.eventKind === \"runtime_note\" &&\n156\t        (event.payload as { text: string }).text.toLowerCase().includes(\"gap\"),\n157\t    );\n158\t    expect(gaps).toHaveLength(1);\n159\t\n160\t    await instance.dispose();\n161\t  });\n162\t\n163\t  it(\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\", async () => {\n164\t    const deadInstance: LhcInstance = {\n165\t      sdk: (await liveInstance()).sdk,\n166\t      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\n167\t      dispose: () => Promise.resolve({ ok: true, value: undefined }),\n168\t    };\n169\t\n170\t    // capture isolates the failure into a structured result rather than throwing.\n171\t    const result = await capture([validEvent(\"user_prompt\")], deadInstance);\n172\t    expect(result.ok).toBe(false);\n173\t    if (result.ok) return;\n174\t    expect([\"thread_not_found\", \"storage_failure\"]).toContain(result.error.code);\n175\t    // It is NOT misclassified as the writable-thread malformed-event case.\n176\t    expect(result.error.code).not.toBe(\"invalid_event\");\n177\t  });\n178\t\n179\t  it(\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\", async () => {\n180\t    const started = await startCapture(store);\n181\t    const { connector, ctx, threadRef } = started;\n182\t\n183\t    // Make the live thread's store unavailable mid-session, then capture.\n184\t    const id = (threadRef as { threadId: string }).threadId;\n185\t    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\n186\t    expect(row.ok).toBe(true);\n187\t    if (!row.ok) return;\n188\t    rmSync(row.value.filePath, { force: true });\n189\t\n190\t    // The hook must not throw despite the dead store.\n191\t    await expect(\n192\t      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"after the store died\"))),\n193\t    ).resolves.toBeUndefined();\n194\t\n195\t    const health = connector.getState()?.health.lastCaptureFailure;\n196\t    expect(health).toBeDefined();\n197\t    expect(health?.recordedGap).toBe(false);\n198\t\n199\t    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n200\t  });\n201\t});\n202\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"40c891d7-f12e-4101-b6fb-66f759302ba3","timestamp":"2026-06-14T08:11:47.197Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/capture/converter.test.ts","content":"// Story 2 — converter orchestration: ordered fan-out (TC-2.1), capture-failure\n// isolation (TC-2.8, atomicity risk), and runtime-change capture (TC-2.9). The\n// production path runs end to end — PI hook → converter → real LHC intake —\n// and every assertion reads the durable thread back. TC-2.8 also exercises\n// capture() directly because the two failure shapes (writable→gap vs\n// store-unavailable→health) are the architecture-risk contract.\nimport { rmSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  intakeStream,\n  threads,\n  type MessageEventInput,\n  type ThreadRef,\n} from \"lhc\";\nimport { capture } from \"../../src/capture/converter.js\";\nimport { initInstance } from \"../../src/lifecycle/instance.js\";\nimport type { LhcInstance } from \"../../src/shared/instance.js\";\nimport {\n  makeAgentEnd,\n  makeAssistantMessage,\n  makeMessageEnd,\n  makeToolResult,\n  makeUserMessage,\n  validEvent,\n} from \"../fixtures/synthetic.js\";\nimport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\nimport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction textOf(event: MessageEventInput): string {\n  return (event.payload as { text?: string }).text ?? \"\";\n}\n\ndescribe(\"Story 2: converter — capture and fan-out (TC-2.1)\", () => {\n  it(\"records a user/assistant/toolResult sequence in source order, fanning the assistant out thinking → text → tool_call\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read the file\")));\n    await connector.handlers.message_end(\n      ctx,\n      makeMessageEnd(\n        makeAssistantMessage({\n          thinking: \"I should open it\",\n          text: \"here is the answer\",\n          toolCalls: [{ id: \"call_x\", name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n        }),\n      ),\n    );\n    await connector.handlers.message_end(\n      ctx,\n      makeMessageEnd(makeToolResult({ id: \"call_x\", content: \"file body\" })),\n    );\n    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n\n    // No silent capture failure on the happy path.\n    expect(connector.snapshot().lastDiagnostic).toBeNull();\n\n    const events = await eventsAfterShutdown(started);\n    expect(kindsOf(events)).toEqual([\n      \"user_prompt\",\n      \"assistant_thinking\",\n      \"assistant_text\",\n      \"tool_call\",\n      \"tool_result\",\n      \"turn_end\",\n    ]);\n\n    expect(textOf(events[0]!)).toBe(\"read the file\");\n    expect(textOf(events[1]!)).toBe(\"I should open it\");\n    expect(textOf(events[2]!)).toBe(\"here is the answer\");\n    expect(events[3]!.payload).toMatchObject({\n      toolCallId: \"call_x\",\n      toolName: \"read_file\",\n      arguments: { path: \"notes.txt\" },\n    });\n    expect(events[4]!.payload).toMatchObject({ toolCallId: \"call_x\", content: \"file body\" });\n  });\n});\n\ndescribe(\"Story 2: converter — runtime-change capture (TC-2.9)\", () => {\n  it(\"captures model_select and thinking_level_select as ordered runtime_notes carrying new + previous values\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx } = started;\n\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"go\")));\n    await connector.handlers.model_select(ctx, {\n      model: { provider: \"openai\", id: \"gpt-4o\" },\n      previousModel: { provider: \"anthropic\", id: \"claude-3\" },\n    });\n    await connector.handlers.thinking_level_select(ctx, { level: \"high\", previousLevel: \"low\" });\n    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"done\" })));\n    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n\n    const events = await eventsAfterShutdown(started);\n    // Ordering relative to the surrounding messages is preserved.\n    expect(kindsOf(events)).toEqual([\n      \"user_prompt\",\n      \"runtime_note\",\n      \"runtime_note\",\n      \"assistant_text\",\n      \"turn_end\",\n    ]);\n\n    const modelNote = textOf(events[1]!);\n    expect(modelNote).toContain(\"anthropic/claude-3\");\n    expect(modelNote).toContain(\"openai/gpt-4o\");\n\n    const levelNote = textOf(events[2]!);\n    expect(levelNote).toContain(\"low\");\n    expect(levelNote).toContain(\"high\");\n  });\n});\n\ndescribe(\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\", () => {\n  async function liveInstance(): Promise<LhcInstance> {\n    const thread = await makeTempThread(store);\n    const built = await initInstance(thread.threadRef, {\n      provider: createDeterministicProvider(),\n      mode: \"background\",\n    });\n    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\n    return built.value;\n  }\n\n  it(\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\", async () => {\n    const instance = await liveInstance();\n    // A turn_end with a non-empty payload is rejected by LHC validation\n    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\n    const malformed = {\n      eventKind: \"turn_end\",\n      idempotencyKey: \"malformed-1\",\n      actor: \"system\",\n      harness: \"pi\",\n      payload: { stowaway: true },\n    } as unknown as MessageEventInput;\n\n    const result = await capture([malformed], instance);\n    expect(result.ok).toBe(false);\n\n    // The session continues: a durable, queryable gap is recorded on the thread.\n    const read = await intakeStream.listEvents(instance.threadRef);\n    expect(read.ok).toBe(true);\n    if (!read.ok) return;\n    const gaps = read.value.filter(\n      (event) =>\n        event.eventKind === \"runtime_note\" &&\n        (event.payload as { text: string }).text.toLowerCase().includes(\"gap\"),\n    );\n    expect(gaps).toHaveLength(1);\n\n    await instance.dispose();\n  });\n\n  it(\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\", async () => {\n    const deadInstance: LhcInstance = {\n      sdk: (await liveInstance()).sdk,\n      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\n      dispose: () => Promise.resolve({ ok: true, value: undefined }),\n    };\n\n    // capture isolates the failure into a structured result rather than throwing.\n    const result = await capture([validEvent(\"user_prompt\")], deadInstance);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect([\"thread_not_found\", \"storage_failure\"]).toContain(result.error.code);\n    // It is NOT misclassified as the writable-thread malformed-event case.\n    expect(result.error.code).not.toBe(\"invalid_event\");\n  });\n\n  it(\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\", async () => {\n    const started = await startCapture(store);\n    const { connector, ctx, threadRef } = started;\n\n    // Make the live thread's store unavailable mid-session, then capture.\n    const id = (threadRef as { threadId: string }).threadId;\n    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    rmSync(row.value.filePath, { force: true });\n\n    // The hook must not throw despite the dead store.\n    await expect(\n      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"after the store died\"))),\n    ).resolves.toBeUndefined();\n\n    const health = connector.getState()?.health.lastCaptureFailure;\n    expect(health).toBeDefined();\n    expect(health?.recordedGap).toBe(false);\n\n    await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n  });\n});\n","numLines":202,"startLine":1,"totalLines":202}}}

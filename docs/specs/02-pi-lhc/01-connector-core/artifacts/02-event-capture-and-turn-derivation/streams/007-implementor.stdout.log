{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MzP5pkhmh9fftSN7w2s2bv","type":"tool_result","content":"1\t// Local declarations of the PI extension surface the connector consumes.\n2\t//\n3\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n4\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n5\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\n6\t// build-time dependency of this workspace, so the connector declares the slice\n7\t// of their contract it touches and swaps to the real imports when the\n8\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n9\t// surface here — rather than scattered `any` — means later stories get real\n10\t// type-checking against the contract PI actually fires.\n11\t\n12\t// ── Hook vocabulary ──────────────────────────────────────────────────\n13\t\n14\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n15\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\n16\t *  serving is Epic 2. */\n17\texport type PiHookName =\n18\t  | \"session_start\"\n19\t  | \"message_end\"\n20\t  | \"turn_end\"\n21\t  | \"agent_end\"\n22\t  | \"model_select\"\n23\t  | \"thinking_level_select\"\n24\t  | \"session_before_fork\"\n25\t  | \"session_before_switch\"\n26\t  | \"session_shutdown\"\n27\t  | \"context\";\n28\t\n29\texport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\n30\texport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n31\t\n32\texport interface SessionStartEvent {\n33\t  reason: SessionStartReason;\n34\t  previousSessionFile?: string;\n35\t}\n36\texport interface MessageEndEvent {\n37\t  message: AgentMessage;\n38\t}\n39\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n40\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\n41\texport interface TurnEndEvent {\n42\t  turnIndex: number;\n43\t  message: AgentMessage;\n44\t  toolResults: ToolResultMessage[];\n45\t  stopReason?: PiStopReason;\n46\t}\n47\texport interface AgentEndEvent {\n48\t  messages: AgentMessage[];\n49\t}\n50\texport interface ModelSelectEvent {\n51\t  model: ModelDescriptor;\n52\t  previousModel?: ModelDescriptor;\n53\t  source?: string;\n54\t}\n55\texport interface ThinkingLevelSelectEvent {\n56\t  level: string;\n57\t  previousLevel: string;\n58\t}\n59\texport interface SessionBeforeForkEvent {\n60\t  entryId: string;\n61\t  position?: number;\n62\t}\n63\texport interface SessionBeforeSwitchEvent {\n64\t  intent: \"new\" | \"resume\";\n65\t}\n66\texport interface SessionShutdownEvent {\n67\t  reason: SessionShutdownReason;\n68\t  targetSessionFile?: string;\n69\t}\n70\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\n71\texport interface ContextEvent {\n72\t  messages: AgentMessage[];\n73\t}\n74\t\n75\t/** Maps each hook to the payload PI delivers with it. */\n76\texport interface PiHookEventMap {\n77\t  session_start: SessionStartEvent;\n78\t  message_end: MessageEndEvent;\n79\t  turn_end: TurnEndEvent;\n80\t  agent_end: AgentEndEvent;\n81\t  model_select: ModelSelectEvent;\n82\t  thinking_level_select: ThinkingLevelSelectEvent;\n83\t  session_before_fork: SessionBeforeForkEvent;\n84\t  session_before_switch: SessionBeforeSwitchEvent;\n85\t  session_shutdown: SessionShutdownEvent;\n86\t  context: ContextEvent;\n87\t}\n88\t\n89\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n90\t *  connector must never retain it across calls (PI replaces session objects on\n91\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\n92\texport type PiHookHandler<N extends PiHookName> = (\n93\t  ctx: ExtensionContext,\n94\t  event: PiHookEventMap[N],\n95\t) => void | Promise<void>;\n96\t\n97\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n98\t\n99\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n100\t\n101\texport interface PiToolSpec {\n102\t  name: string;\n103\t  description?: string;\n104\t  promptSnippet?: string;\n105\t  promptGuidelines?: string;\n106\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n107\t}\n108\t\n109\t/** The factory-time API. Hook registration and command/tool registration take\n110\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n111\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n112\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\n113\texport interface ExtensionAPI {\n114\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n115\t  registerCommand(name: string, handler: PiCommandHandler): void;\n116\t  registerTool(tool: PiToolSpec): void;\n117\t  appendEntry(customType: string, data: unknown): void;\n118\t}\n119\t\n120\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n121\t\n122\texport interface ModelDescriptor {\n123\t  provider: string;\n124\t  id: string;\n125\t}\n126\t\n127\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n128\t *  owns. The connector treats provider/model as opaque routing keys. */\n129\texport interface ModelHandle extends ModelDescriptor {\n130\t  readonly [k: string]: unknown;\n131\t}\n132\t\n133\texport interface ModelRegistry {\n134\t  find(provider: string, model: string): ModelHandle | undefined;\n135\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\n136\t  getAvailable(): ModelHandle[];\n137\t}\n138\t\n139\texport interface ExtensionUI {\n140\t  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n141\t}\n142\t\n143\texport interface SessionEntry {\n144\t  type: string;\n145\t  readonly [k: string]: unknown;\n146\t}\n147\t\n148\texport interface SessionManager {\n149\t  getEntries(): SessionEntry[];\n150\t}\n151\t\n152\texport interface ExtensionContext {\n153\t  modelRegistry: ModelRegistry;\n154\t  ui: ExtensionUI;\n155\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n156\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n157\t  hasUI: boolean;\n158\t  sessionManager: SessionManager;\n159\t  cwd: string;\n160\t}\n161\t\n162\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n163\t\n164\texport interface TextPart {\n165\t  type: \"text\";\n166\t  text: string;\n167\t}\n168\texport interface ThinkingPart {\n169\t  type: \"thinking\";\n170\t  thinking: string;\n171\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n172\t   *  Epic 1 (tech design I-3). */\n173\t  thinkingSignature?: string;\n174\t}\n175\texport interface ToolCallPart {\n176\t  type: \"toolCall\";\n177\t  /** Composite, stable across tool_execution_start → tool_result → message_end\n178\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n179\t  id: string;\n180\t  name: string;\n181\t  arguments: Record<string, unknown>;\n182\t  /** Opaque; captured, not interpreted (tech design I-3). */\n183\t  thoughtSignature?: string;\n184\t}\n185\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n186\t *  the converter (tech design I-6), never silently dropped. */\n187\texport interface ImagePart {\n188\t  type: \"image\";\n189\t  mimeType?: string;\n190\t  data?: string;\n191\t}\n192\texport interface FileRefPart {\n193\t  type: \"fileRef\";\n194\t  path: string;\n195\t}\n196\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n197\t\n198\texport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n199\t\n200\texport interface TokenUsage {\n201\t  inputTokens?: number;\n202\t  outputTokens?: number;\n203\t}\n204\t\n205\texport interface UserMessage {\n206\t  role: \"user\";\n207\t  content: ContentPart[];\n208\t}\n209\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n210\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\n211\texport interface AssistantMessage {\n212\t  role: \"assistant\";\n213\t  content: ContentPart[];\n214\t  stopReason?: PiStopReason;\n215\t  usage?: TokenUsage;\n216\t}\n217\texport interface ToolResultMessage {\n218\t  role: \"toolResult\";\n219\t  toolCallId: string;\n220\t  content: ContentPart[];\n221\t  isError?: boolean;\n222\t}\n223\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n224\t"}]},"parent_tool_use_id":null,"session_id":"24167eda-1813-43e8-bfbc-fbb2eb03ffb4","uuid":"a3a200e2-b643-408d-a962-718fa19ed0fe","timestamp":"2026-06-14T08:10:56.337Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/pi/types.ts","content":"// Local declarations of the PI extension surface the connector consumes.\n//\n// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\n// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\n// headless + interactive recon, June 12 2026). The PI packages are not yet a\n// build-time dependency of this workspace, so the connector declares the slice\n// of their contract it touches and swaps to the real imports when the\n// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\n// surface here — rather than scattered `any` — means later stories get real\n// type-checking against the contract PI actually fires.\n\n// ── Hook vocabulary ──────────────────────────────────────────────────\n\n/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\n *  `context` is fired by PI but Epic 1 registers no handler for it — context\n *  serving is Epic 2. */\nexport type PiHookName =\n  | \"session_start\"\n  | \"message_end\"\n  | \"turn_end\"\n  | \"agent_end\"\n  | \"model_select\"\n  | \"thinking_level_select\"\n  | \"session_before_fork\"\n  | \"session_before_switch\"\n  | \"session_shutdown\"\n  | \"context\";\n\nexport type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\nexport type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\n\nexport interface SessionStartEvent {\n  reason: SessionStartReason;\n  previousSessionFile?: string;\n}\nexport interface MessageEndEvent {\n  message: AgentMessage;\n}\n/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\n *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\nexport interface TurnEndEvent {\n  turnIndex: number;\n  message: AgentMessage;\n  toolResults: ToolResultMessage[];\n  stopReason?: PiStopReason;\n}\nexport interface AgentEndEvent {\n  messages: AgentMessage[];\n}\nexport interface ModelSelectEvent {\n  model: ModelDescriptor;\n  previousModel?: ModelDescriptor;\n  source?: string;\n}\nexport interface ThinkingLevelSelectEvent {\n  level: string;\n  previousLevel: string;\n}\nexport interface SessionBeforeForkEvent {\n  entryId: string;\n  position?: number;\n}\nexport interface SessionBeforeSwitchEvent {\n  intent: \"new\" | \"resume\";\n}\nexport interface SessionShutdownEvent {\n  reason: SessionShutdownReason;\n  targetSessionFile?: string;\n}\n/** Declared for completeness; Epic 1 registers no handler (observe-only). */\nexport interface ContextEvent {\n  messages: AgentMessage[];\n}\n\n/** Maps each hook to the payload PI delivers with it. */\nexport interface PiHookEventMap {\n  session_start: SessionStartEvent;\n  message_end: MessageEndEvent;\n  turn_end: TurnEndEvent;\n  agent_end: AgentEndEvent;\n  model_select: ModelSelectEvent;\n  thinking_level_select: ThinkingLevelSelectEvent;\n  session_before_fork: SessionBeforeForkEvent;\n  session_before_switch: SessionBeforeSwitchEvent;\n  session_shutdown: SessionShutdownEvent;\n  context: ContextEvent;\n}\n\n/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\n *  connector must never retain it across calls (PI replaces session objects on\n *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\nexport type PiHookHandler<N extends PiHookName> = (\n  ctx: ExtensionContext,\n  event: PiHookEventMap[N],\n) => void | Promise<void>;\n\n// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\n\nexport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\n\nexport interface PiToolSpec {\n  name: string;\n  description?: string;\n  promptSnippet?: string;\n  promptGuidelines?: string;\n  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\n}\n\n/** The factory-time API. Hook registration and command/tool registration take\n *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\n *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\n *  exposes them, but Epic 1 (observe-only) registers only hooks. */\nexport interface ExtensionAPI {\n  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\n  registerCommand(name: string, handler: PiCommandHandler): void;\n  registerTool(tool: PiToolSpec): void;\n  appendEntry(customType: string, data: unknown): void;\n}\n\n// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\n\nexport interface ModelDescriptor {\n  provider: string;\n  id: string;\n}\n\n/** Opaque handle the model registry returns; it carries auth/runtime detail PI\n *  owns. The connector treats provider/model as opaque routing keys. */\nexport interface ModelHandle extends ModelDescriptor {\n  readonly [k: string]: unknown;\n}\n\nexport interface ModelRegistry {\n  find(provider: string, model: string): ModelHandle | undefined;\n  hasConfiguredAuth(model: ModelHandle | string): boolean;\n  getAvailable(): ModelHandle[];\n}\n\nexport interface ExtensionUI {\n  notify(message: string, options?: { level?: \"info\" | \"warn\" | \"error\" }): void;\n}\n\nexport interface SessionEntry {\n  type: string;\n  readonly [k: string]: unknown;\n}\n\nexport interface SessionManager {\n  getEntries(): SessionEntry[];\n}\n\nexport interface ExtensionContext {\n  modelRegistry: ModelRegistry;\n  ui: ExtensionUI;\n  /** Guard UI surfacing on this — the extension must work in rpc/json/print\n   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\n  hasUI: boolean;\n  sessionManager: SessionManager;\n  cwd: string;\n}\n\n// ── Message vocabulary (AgentMessage and its parts) ──────────────────\n\nexport interface TextPart {\n  type: \"text\";\n  text: string;\n}\nexport interface ThinkingPart {\n  type: \"thinking\";\n  thinking: string;\n  /** Opaque provider reasoning token — captured, not interpreted; dropped in\n   *  Epic 1 (tech design I-3). */\n  thinkingSignature?: string;\n}\nexport interface ToolCallPart {\n  type: \"toolCall\";\n  /** Composite, stable across tool_execution_start → tool_result → message_end\n   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\n  id: string;\n  name: string;\n  arguments: Record<string, unknown>;\n  /** Opaque; captured, not interpreted (tech design I-3). */\n  thoughtSignature?: string;\n}\n/** Unsupported in the text-only intake schema — degrades to a runtime_note in\n *  the converter (tech design I-6), never silently dropped. */\nexport interface ImagePart {\n  type: \"image\";\n  mimeType?: string;\n  data?: string;\n}\nexport interface FileRefPart {\n  type: \"fileRef\";\n  path: string;\n}\nexport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\n\nexport type PiStopReason = \"stop\" | \"aborted\" | \"length\" | \"toolUse\" | (string & {});\n\nexport interface TokenUsage {\n  inputTokens?: number;\n  outputTokens?: number;\n}\n\nexport interface UserMessage {\n  role: \"user\";\n  content: ContentPart[];\n}\n/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\n *  host maps it to text or a classified failure (Epic 1 Story 5). */\nexport interface AssistantMessage {\n  role: \"assistant\";\n  content: ContentPart[];\n  stopReason?: PiStopReason;\n  usage?: TokenUsage;\n}\nexport interface ToolResultMessage {\n  role: \"toolResult\";\n  toolCallId: string;\n  content: ContentPart[];\n  isError?: boolean;\n}\nexport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\n","numLines":224,"startLine":1,"totalLines":224}}}

{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/idempotency.test.ts | sed -n '1,140p'\"","aggregated_output":"     1\t// Story 2 — idempotency: the deterministic key-construction goldens plus the\n     2\t// architecture-risk double-replay. Single-event dedup (TC-2.7) does not prove\n     3\t// reload/replay safety across a corpus, so a whole corpus is replayed twice and\n     4\t// must add nothing the second time. The key goldens pin construction precedence:\n     5\t// PI entry id → provider response / tool-call id → content fingerprint, with\n     6\t// blockIndex and kind disambiguating one message's fan-out.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createDeterministicProvider, intakeStream, type MessageEventInput } from \"lhc\";\n     9\timport { capture } from \"../../src/capture/converter.js\";\n    10\timport { eventKey } from \"../../src/capture/idempotency.js\";\n    11\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    12\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    13\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    14\timport type { AgentMessage } from \"../../src/pi/types.js\";\n    15\timport { loadToolHeavyCorpus } from \"../fixtures/corpus.js\";\n    16\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    17\t\n    18\tlet store: TempStore;\n    19\tbeforeEach(() => {\n    20\t  store = tempStore();\n    21\t});\n    22\tafterEach(() => {\n    23\t  store.cleanup();\n    24\t});\n    25\t\n    26\tdescribe(\"Story 2: idempotency key construction (deterministic goldens)\", () => {\n    27\t  it(\"is deterministic: identical input yields an identical key\", () => {\n    28\t    const input = { piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" } as const;\n    29\t    expect(eventKey(input)).toBe(eventKey({ ...input }));\n    30\t  });\n    31\t\n    32\t  it(\"prefers the PI entry id, and disambiguates a message's fan-out by blockIndex and kind\", () => {\n    33\t    const thinking = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_thinking\" });\n    34\t    const text = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 1, kind: \"assistant_text\" });\n    35\t    const textSameBlock = eventKey({ piSessionId: \"s\", entryId: \"e1\", blockIndex: 0, kind: \"assistant_text\" });\n    36\t    expect(thinking).toContain(\"e1\");\n    37\t    // Same entry, different block → different key (fan-out stays distinct).\n    38\t    expect(text).not.toBe(thinking);\n    39\t    // Same entry + block, different kind → still distinct.\n    40\t    expect(textSameBlock).not.toBe(thinking);\n    41\t  });\n    42\t\n    43\t  it(\"falls to the tool-call id when no entry id is present, separating call from result by kind\", () => {\n    44\t    const call = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_call\" });\n    45\t    const result = eventKey({ piSessionId: \"s\", toolCallId: \"call_a\", blockIndex: 0, kind: \"tool_result\" });\n    46\t    expect(call).toContain(\"call_a\");\n    47\t    expect(result).toContain(\"call_a\");\n    48\t    expect(call).not.toBe(result);\n    49\t  });\n    50\t\n    51\t  it(\"falls to the provider response id below the entry id, above the content fingerprint\", () => {\n    52\t    const key = eventKey({ piSessionId: \"s\", responseId: \"resp_7\", blockIndex: 0, kind: \"assistant_text\" });\n    53\t    expect(key).toContain(\"resp_7\");\n    54\t  });\n    55\t\n    56\t  it(\"falls to a content fingerprint as last resort: same content same key, different content different key\", () => {\n    57\t    const a = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    58\t    const aAgain = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"hello\" });\n    59\t    const b = eventKey({ piSessionId: \"s\", blockIndex: 0, kind: \"user_prompt\", role: \"user\", content: \"world\" });\n    60\t    expect(aAgain).toBe(a);\n    61\t    expect(b).not.toBe(a);\n    62\t  });\n    63\t\n    64\t  it(\"honors precedence: a present entry id wins over a present tool-call id\", () => {\n    65\t    const withBoth = eventKey({ piSessionId: \"s\", entryId: \"e9\", toolCallId: \"call_z\", blockIndex: 0, kind: \"tool_call\" });\n    66\t    const entryOnly = eventKey({ piSessionId: \"s\", entryId: \"e9\", blockIndex: 0, kind: \"tool_call\" });\n    67\t    expect(withBoth).toBe(entryOnly);\n    68\t  });\n    69\t});\n    70\t\n    71\tfunction buildCorpusBatch(source: AgentMessage[]): MessageEventInput[] {\n    72\t  const acc = new TurnAccumulator({ piSessionId: \"corpus\" });\n    73\t  const events: MessageEventInput[] = [];\n    74\t  source.forEach((message, index) => {\n    75\t    const mapped = mapMessage(message, { piSessionId: \"corpus\", entryId: `s${index}` });\n    76\t    acc.onMessage(mapped);\n    77\t    events.push(...mapped);\n    78\t  });\n    79\t  events.push(...acc.onAgentEnd());\n    80\t  return events;\n    81\t}\n    82\t\n    83\tdescribe(\"Story 2: corpus double-replay (idempotency architecture-risk)\", () => {\n    84\t  it(\"replaying the same corpus twice produces no duplicate events; re-delivered keys come back skipped\", async () => {\n    85\t    const thread = await makeTempThread(store);\n    86\t    const built = await initInstance(thread.threadRef, {\n    87\t      provider: createDeterministicProvider(),\n    88\t      mode: \"background\",\n    89\t    });\n    90\t    expect(built.ok).toBe(true);\n    91\t    if (!built.ok) return;\n    92\t    const instance = built.value;\n    93\t\n    94\t    const batch = buildCorpusBatch(loadToolHeavyCorpus().source);\n    95\t\n    96\t    const first = await capture(batch, instance);\n    97\t    expect(first.ok).toBe(true);\n    98\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    99\t\n   100\t    const replay = await capture(batch, instance);\n   101\t    expect(replay.ok).toBe(true);\n   102\t    if (replay.ok) {\n   103\t      expect(replay.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   104\t    }\n   105\t\n   106\t    const read = await intakeStream.listEvents(instance.threadRef);\n   107\t    expect(read.ok).toBe(true);\n   108\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   109\t\n   110\t    await instance.dispose();\n   111\t  });\n   112\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/specs/02-pi-lhc/01-connector-core/tech-design.md | sed -n '272,335p'\"","aggregated_output":"   272\t### Flow 2: Event Capture and Turn Derivation\n   273\t\n   274\tThis is the densest flow and the one the epic was written to get right. Each finalized PI message becomes an ordered run of LHC intake events; the subtlety is entirely in turns. PI emits `turn_start`/`turn_end` per agent step and resets `turnIndex` to 0 at the start of each agent run, so an agent run that takes three steps emits three PI turns. An LHC turn is the whole exchange — the user prompt and every step the agent took until the next prompt. The converter therefore ignores PI's per-step `turn_end` as a boundary signal and closes the LHC turn at `agent_end`.\n   275\t\n   276\tThe converter is three pieces. `map-message.ts` is pure: it takes one `AgentMessage` and returns the ordered events for it — a user message becomes one `user_prompt`; an assistant message fans out to `assistant_thinking` (if present), then `assistant_text` (if present), then one `tool_call` per call, in that order; a tool result becomes one `tool_result` correlated to its call by `toolCallId`, carrying `isError` when the tool failed. `turn-accumulator.ts` holds the open-turn state and decides when to emit the single `turn_end`. `converter.ts` orchestrates, batches the events, and flushes them through `intakeStream.messageEvents`, isolating failures so writable-thread failures become recorded gaps and store-unavailable failures become extension diagnostics rather than thrown exceptions.\n   277\t\n   278\tA worked example anchors the contract. The user asks one question that triggers two parallel tool calls, then gets a final answer:\n   279\t\n   280\t```\n   281\tPI emits:                              converter emits (one LHC turn):\n   282\t  turn_start(0)                          user_prompt\n   283\t  message_end(user [text])               assistant_thinking\n   284\t  message_end(assistant                  tool_call (id=a)\n   285\t    [thinking, toolCall a, toolCall b])  tool_call (id=b)\n   286\t  message_end(toolResult b)              tool_result (id=b)\n   287\t  message_end(toolResult a)              tool_result (id=a)\n   288\t  turn_end(0)        <- ignored          assistant_text\n   289\t  turn_start(1)                          turn_end          <- at agent_end\n   290\t  message_end(assistant [text])\n   291\t  turn_end(1)        <- ignored\n   292\t  agent_end          <- closes turn\n   293\t```\n   294\t\n   295\tThe two tool results arrive in the order `b` then `a`, and each correlates to its call by id, not by arrival order — the parallel-tool contract (AC-2.3). PI's `turn_end(0)` and `turn_end(1)` produce no LHC `turn_end`; the single LHC `turn_end` fires at `agent_end`. Session order derives from converter source-event order, never from `turnIndex`.\n   296\t\n   297\t```mermaid\n   298\tsequenceDiagram\n   299\t  participant PI\n   300\t  participant CV as converter\n   301\t  participant TA as turn-accumulator\n   302\t  participant IS as lhc.intakeStream\n   303\t  PI->>CV: message_end(user)\n   304\t  CV->>TA: open turn\n   305\t  CV->>IS: [user_prompt]\n   306\t  Note over CV,IS: AC-2.1 ordered fan-out\n   307\t  PI->>CV: message_end(assistant [thinking,toolCall×2])\n   308\t  CV->>IS: [assistant_thinking, tool_call, tool_call]\n   309\t  PI->>CV: message_end(toolResult) ×2 (out of order)\n   310\t  CV->>IS: [tool_result, tool_result] correlated by id\n   311\t  Note over CV,IS: AC-2.3 parallel correlation, AC-2.4 error flag\n   312\t  PI->>CV: turn_end ×N\n   313\t  Note over TA: ignored as boundary — AC-2.2\n   314\t  PI->>CV: agent_end\n   315\t  CV->>TA: close turn\n   316\t  CV->>IS: [turn_end]\n   317\t  Note over CV,IS: AC-2.6 dedup by idempotency key — AC-2.7 failure to gap\n   318\t```\n   319\t\n   320\t**Skeleton requirements:**\n   321\t\n   322\t| What | Where | Stub signature | Stub semantics |\n   323\t|------|-------|----------------|----------------|\n   324\t| Map one message | `capture/map-message.ts` | `mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[]` | pure; `NotImplementedError` until Green |\n   325\t| Turn accumulation | `capture/turn-accumulator.ts` | `class TurnAccumulator { onMessage(); onAgentEnd(): MessageEventInput[] }` | pure state machine |\n   326\t| Idempotency key | `capture/idempotency.ts` | `eventKey(parts): string` | pure; deterministic |\n   327\t| Orchestrate + flush | `capture/converter.ts` | `capture(events, instance): Promise<OpResult<BatchResult>>` | structured result; isolates failure |\n   328\t\n   329\tThe idempotency key gets real depth because dedup correctness (AC-2.6) and crash-replay both depend on it. Construction precedence, carried from the POC and adapted to the SDK's per-event-key field: PI entry id when present (`pi:<session>:<entryId>:<block>:<kind>`), else provider `responseId` (assistant) or `toolCallId` (tool result), else a `role:timestamp:content-hash` fallback. The contract is that the key is identical across re-delivery of the same logical event and distinct across different events; the SDK's `messageEvents` returns `skipped` with `skipReason: duplicate_idempotency_key` for a re-delivered key, which is the dedup mechanism the test asserts against.\n   330\t\n   331\t### Flow 3: Fork as New Thread\n   332\t\n   333\tA fork produces a new LHC thread seeded by replay, and never writes the source. Detection does not depend on a `session_start` fork reason: recon found print-mode `--fork` reports `reason=startup`. The fork point comes from the `session_before_fork` hook (`entryId`, `position`) when present. In Epic 1, PI still runs its own session, so PI's session tree (the `parentId` chain) is available as additional fork evidence when the hook is absent. This is an Epic-1 convenience, not the permanent design: the long-term home for fork lineage is LHC thread metadata (Feature 2+, once PI's session file goes vestigial), so the design must not harden PI's session tree into a permanent dependency.\n   334\t\n   335\tSeeding replays the source thread's recorded events up to the fork point into the new thread, through the same intake path normal capture uses, so the seeded read-back matches the source's read-back through that point. Derived forms are not copied (I-2): the new thread's derivations requeue and drain in the background. The source thread receives no writes — verified by logical read-back equality, not byte-equality, because SQLite page churn can change bytes without changing content.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/specs/02-pi-lhc/01-connector-core/stories/02-event-capture-and-turn-derivation.md | sed -n '1,190p'\"","aggregated_output":"     1\t# Story 2: Event Capture and Turn Derivation\n     2\t\n     3\t### Summary\n     4\t<!-- Jira: Summary field -->\n     5\t\n     6\tMap finalized PI traffic into ordered, duplicate-safe LHC intake events and derive one LHC turn per user exchange.\n     7\t\n     8\t### Description\n     9\t<!-- Jira: Description field -->\n    10\t\n    11\t**User Profile:** A developer using PI as their daily coding agent, with the `pi-lhc` extension loaded.\n    12\t\n    13\t**Objective:** Every finalized PI message lands as ordered LHC intake events exactly once, runtime changes are recorded in order, and LHC turns are derived from PI traffic rather than PI's per-step turn markers.\n    14\t\n    15\t**Scope In:**\n    16\t\n    17\t- Productionized converter from PI `message_end` and runtime-selection hooks to LHC `MessageEventInput` events.\n    18\t- Assistant content-part fan-out in thinking, text, tool-call order.\n    19\t- Parallel tool-call correlation by `toolCallId`.\n    20\t- Error-result capture and graceful-interrupt capture.\n    21\t- LHC turn derivation from user prompt through agent run completion.\n    22\t- Idempotency-keyed dedup for reload and replay.\n    23\t- Capture failure isolation: durable gaps when writable, diagnostics when the store is unavailable.\n    24\t\n    25\t**Scope Out:**\n    26\t\n    27\t- Corpus replay verification and inspect assertions, owned by Story 3.\n    28\t- Fork seeding, owned by Story 4.\n    29\t- Derivation routing and assignment validation, owned by Stories 5 and 6.\n    30\t- Context serving; PI's native context handling remains unchanged.\n    31\t\n    32\t**Dependencies:** Story 1.\n    33\t\n    34\t### Acceptance Criteria\n    35\t<!-- Jira: Acceptance Criteria field -->\n    36\t\n    37\t**AC-2.1:** Every PI message finalized through `message_end` — user, assistant, tool result — is mapped to LHC intake events and recorded in source order. An assistant message fans out to per-content-part events in thinking → text → tool-call order: `assistant_thinking`, `assistant_text`, and one `tool_call` per call.\n    38\t\n    39\t**TC-2.1** — A user/assistant/toolResult sequence records ordered events; an assistant `[thinking, text, toolCall]` fans out in that order.\n    40\t\n    41\t**AC-2.2:** LHC turn boundaries are derived from PI traffic, not from PI's per-agent-step `turn_end`. One LHC turn spans a user prompt and all subsequent agent activity until the next user prompt or the end of the agent run. The converter emits exactly one LHC `turn_end` event per LHC turn, at the agent run's completion — never one per PI `turn_end`, and never keyed off PI's per-agent-run `turnIndex` as a session counter.\n    42\t\n    43\t**TC-2.2** — A one-prompt-two-tools-then-answer corpus (the worked example) yields exactly one LHC turn with one `turn_end` at agent-run completion; PI's per-step `turn_end`s produce none.\n    44\t\n    45\t**TC-2.3** — Session order derives from converter source-event order, not `turnIndex`; two agent runs each starting at `turnIndex 0` order correctly.\n    46\t\n    47\t**AC-2.3:** Parallel tool calls are captured with correct correlation: when one assistant message carries multiple `tool_call` parts and their results complete out of arrival order, each `tool_result` event is matched to its call by `toolCallId`, not by arrival order.\n    48\t\n    49\t**TC-2.4** — Parallel tool calls with out-of-order completion correlate each result to its call by `toolCallId`.\n    50\t\n    51\t**AC-2.4:** A tool result carrying an error is captured as a `tool_result` event with its error content and an error flag set. No event is dropped because a tool failed.\n    52\t\n    53\t**TC-2.5** — A tool result with `isError` is captured as a `tool_result` with the error flag and content; nothing dropped.\n    54\t\n    55\t**AC-2.5:** A graceful interrupt — a complete turn PI marks aborted, with partial assistant content preserved — is captured whole: the partial content is recorded and the aborted disposition is carried through. The interrupted content is not discarded.\n    56\t\n    57\t**TC-2.6** — A graceful-interrupt corpus records the partial assistant content with the aborted disposition; the turn closes complete-but-aborted.\n    58\t\n    59\t**AC-2.6:** Capture is duplicate-safe. Re-delivered events (reload, crash-replay) are recognized by idempotency key and skipped rather than recorded twice. On normal resume PI re-delivers no historical events, so duplication only arises on the reload and replay paths.\n    60\t\n    61\t**TC-2.7** — A re-delivered event (reload/replay) is skipped by idempotency key; a normal resume re-delivers no historical events.\n    62\t\n    63\t**AC-2.7:** A capture failure does not break the PI session, and does not vanish silently. When the thread is writable, a malformed or unmappable event records a durable, queryable gap that surfaces in thread health. When the thread store itself is unavailable, the failure surfaces as an extension diagnostic / health signal rather than a durable gap (the record cannot be written), and no exception propagates into the PI hook. Either way the session continues, and capture adds no perceptible latency to interactive use.\n    64\t\n    65\t**TC-2.8** — A malformed/unmappable event on a writable thread records a durable, queryable gap surfaced in health; an unavailable thread store surfaces an extension diagnostic / health signal with no durable gap. Both continue the session with no exception reaching the hook.\n    66\t\n    67\t**AC-2.8:** Runtime changes that PI fires only in-stream — model selection (`model_select`) and thinking-level selection (`thinking_level_select`) — are captured in order as `runtime_note` events carrying the change (the new model or level, and the previous one). These are recorded at the moment they fire because no durable record holds them otherwise; nothing in this epic consumes them, and their presence in the thread is what lets later epics attribute a turn to the model that produced it.\n    68\t\n    69\t**TC-2.9** — A `model_select` and a `thinking_level_select` each record an ordered `runtime_note` event carrying the new and previous values; ordering relative to surrounding messages is preserved.\n    70\t\n    71\t### Technical Design\n    72\t<!-- Jira: Technical Notes or sub-section of Description -->\n    73\t\n    74\t#### Architecture Context\n    75\t\n    76\tStory 2 owns the converter and the LHC turn derivation rule. Finalized PI traffic becomes ordered LHC intake events, while PI's per-step `turn_end` events are input signals only and never become one LHC turn boundary per step.\n    77\t\n    78\tThe source of order is the converter's source-event order. This story also owns runtime-change capture, idempotency keys, and capture failure isolation.\n    79\t\n    80\t#### Build Strategy\n    81\t\n    82\tStrategy: full-staged-risk\n    83\t\n    84\tReason:\n    85\t- Turn derivation, dedup, and failure isolation are load-bearing mechanics.\n    86\t- The implementation must be proven with red goldens before Green because wrong ordering can look superficially plausible.\n    87\t\n    88\tRisk Reminders:\n    89\t- Flow 2 order derives from converter source-event order, not parent id or `turnIndex`.\n    90\t- `model_select` and `thinking_level_select` are captured when they fire; no later durable source exists.\n    91\t- Unsupported image/file-reference parts must record an omission until M0 settles the final payload shape.\n    92\t\n    93\t#### Implementation Targets\n    94\t\n    95\t| Area | Files / Modules |\n    96\t|------|-----------------|\n    97\t| Converter orchestration | `packages/pi-lhc/src/capture/converter.ts` |\n    98\t| Message mapping | `packages/pi-lhc/src/capture/map-message.ts` |\n    99\t| Turn derivation | `packages/pi-lhc/src/capture/turn-accumulator.ts` |\n   100\t| Idempotency | `packages/pi-lhc/src/capture/idempotency.ts` |\n   101\t| Runtime changes | `packages/pi-lhc/src/capture/runtime-changes.ts` |\n   102\t| State diagnostics | `packages/pi-lhc/src/lifecycle/state.ts` |\n   103\t| Tests | `packages/pi-lhc/test/capture/converter.test.ts`, `packages/pi-lhc/test/capture/turn-derivation.test.ts`, `packages/pi-lhc/test/capture/parallel-and-errors.test.ts`, `packages/pi-lhc/test/capture/abort.test.ts`, `packages/pi-lhc/test/capture/idempotency.test.ts` |\n   104\t\n   105\t#### Design References\n   106\t\n   107\t- [epic.md §Flow 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/epic.md:145), lines 145-179\n   108\t- [epic.md §PI Event Mapping](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/epic.md:272), lines 272-330\n   109\t- [tech-design.md §Module Responsibility Matrix](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:188), lines 188-192\n   110\t- [tech-design.md §Flow 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:272), lines 272-329\n   111\t- [tech-design.md §Deterministic Algorithm Boundaries](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:573), lines 573-580\n   112\t- [tech-design.md §Chunk 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/tech-design.md:654), lines 654-656\n   113\t- [test-plan.md §Capture Tests](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/test-plan.md:49), lines 49-78\n   114\t- [test-plan.md §Chunk 2](/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/test-plan.md:154), lines 154-159\n   115\t\n   116\t#### Test Mapping\n   117\t\n   118\t| TC | Test File / Check | Test Description |\n   119\t|----|-------------------|------------------|\n   120\t| TC-2.1 | `test/capture/converter.test.ts` | User, assistant, and tool-result sequence records in source order; assistant fan-out is thinking, text, then tool calls. |\n   121\t| TC-2.2 | `test/capture/turn-derivation.test.ts` | Worked example produces exactly one LHC turn and one `turn_end` at `agent_end`; PI per-step `turn_end`s emit none. |\n   122\t| TC-2.3 | `test/capture/turn-derivation.test.ts` | Two agent runs with repeated `turnIndex` values order by converter source-event order without collision. |\n   123\t| TC-2.4 | `test/capture/parallel-and-errors.test.ts` | Out-of-order parallel tool results correlate to calls by `toolCallId`. |\n   124\t| TC-2.5 | `test/capture/parallel-and-errors.test.ts` | Error tool result records error flag and content; no failed tool output is dropped. |\n   125\t| TC-2.6 | `test/capture/abort.test.ts` | Graceful interrupt records partial assistant content, carries aborted disposition, and closes complete-but-aborted. |\n   126\t| TC-2.7 | `test/capture/parallel-and-errors.test.ts` | Re-delivered event is skipped by idempotency key; normal resume does not replay historical messages. |\n   127\t| TC-2.8 | `test/capture/converter.test.ts` | Writable malformed event records durable gap; unavailable store records state health signal with no hook exception. |\n   128\t| TC-2.9 | `test/capture/converter.test.ts` | Model and thinking-level changes become ordered `runtime_note` events with new and previous values. |\n   129\t\n   130\t#### Architecture-Risk Tests\n   131\t\n   132\t| Risk | Test File / Check | Test Description | Why AC/TC Mapping Alone Would Miss It |\n   133\t|------|-------------------|------------------|---------------------------------------|\n   134\t| Idempotency / Retry | `test/capture/idempotency.test.ts` | Replaying the same corpus twice produces no duplicate events; re-delivered keys return `skipped`. | Single-event dedup does not prove reload/replay safety across a corpus. |\n   135\t| Atomicity / Isolation | `test/capture/converter.test.ts` | Mid-batch failure records a gap and continues; store-unavailable produces a health signal, not a thread gap. | The product AC says the thread continues; this proves no exception reaches PI's hook and the two failure shapes stay distinct. |\n   136\t\n   137\t#### Technical Notes\n   138\t\n   139\t- `map-message.ts` is pure and performs no I/O.\n   140\t- `turn-accumulator.ts` owns open-turn state and emits `[turn_end]` only when a turn is open.\n   141\t- Idempotency precedence is PI entry id, provider response id or tool-call id, then content fingerprint.\n   142\t- Capture uses `intakeStream.messageEvents(threadRef, events)` and relies on SDK duplicate-key behavior.\n   143\t\n   144\t#### Anti-Shim Requirements\n   145\t\n   146\t- Do not key turn order from `turnIndex`, parent id, or arrival-order assumptions for parallel tool results.\n   147\t- Do not swallow malformed events; writable failures must become durable gaps, and unavailable-store failures must become extension health diagnostics.\n   148\t- Do not add new intake event kinds for runtime model/thinking changes in this story; use `runtime_note`.\n   149\t\n   150\t#### Production Path Proof\n   151\t\n   152\t- Entrypoint: PI `message_end`, `turn_end`, `agent_end`, `model_select`, and `thinking_level_select` hooks routed through `index.ts`.\n   153\t- Registration/default path: hook events call converter/map/runtime-change modules, then batch into `intakeStream.messageEvents`.\n   154\t- Evidence: capture tests assert stored events, duplicate skips, no hook exception, and exact turn boundaries through the real LHC intake path.\n   155\t\n   156\t#### Verification\n   157\t\n   158\t- Targeted: `pnpm --filter pi-lhc verify -- test/capture`\n   159\t- Story gate: `pnpm --filter pi-lhc green-verify`\n   160\t- Epic gate: `pnpm --filter pi-lhc verify-all`\n   161\t\n   162\t#### Spec Deviations\n   163\t\n   164\tNone.\n   165\t\n   166\t### Definition of Done\n   167\t<!-- Jira: Definition of Done or Acceptance Criteria footer -->\n   168\t\n   169\t- All Flow 2 ACs and TCs pass.\n   170\t- Converter maps all in-scope PI message and runtime-selection events to LHC intake events.\n   171\t- One LHC turn is emitted per user exchange, not per PI agent step.\n   172\t- Idempotency handles reload and replay without duplicate records.\n   173\t- Capture failures are visible and do not break the PI session.\n   174\t- No context serving is introduced.\n","exit_code":0,"status":"completed"}}

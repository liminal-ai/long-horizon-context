pi-lhc/test/capture/reattach-idempotency.test.ts:5:// skipping new events as false duplicates — while the converter's same-key\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:88:  it(\"(2b) a reload re-delivering the same logical events skips them instead of recording duplicates\", async () => {\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:123:          skipReason: \"duplicate_idempotency_key\",\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:128:          skipReason: \"duplicate_idempotency_key\",\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:135:  it(\"(3) normal resume records new messages and does not duplicate the prior session's history\", async () => {\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:145:    // turn — which must record, leaving the prior turn intact and un-duplicated.\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:167:  it(\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\", async () => {\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:180:    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\npackages/lhc/test/report-repair.test.ts:247:    // two situations read apart from the same single artifact state.\npackages/lhc/test/report-repair.test.ts:437:  it(\"the second requeue before draining is an explicit no-op; one live item, no duplicates\", async () => {\npackages/lhc/test/report-repair.test.ts:469:    // One row per form by key — drain left no duplicate artifacts behind.\npackages/lhc/test/view-compact.test.ts:345:  it(\"a fresh SDK on the same file pulls byte-identical band content\", async () => {\npackages/lhc/test/view-compact.test.ts:355:    // Not a same-process reread: a fresh SDK instance opens the file cold.\npackages/lhc/test/view-compact.test.ts:402:    // point (56) in the same transaction.\npackages/lhc/test/view-compact.test.ts:711:    // on
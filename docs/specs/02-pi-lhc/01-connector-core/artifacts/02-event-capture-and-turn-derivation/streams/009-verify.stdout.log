{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"entryId|responseId|same|duplicate|capture_gap|unsupported content omitted\" packages/pi-lhc/test packages/lhc/test | head -100'","aggregated_output":"packages/lhc/test/derivation-turns.test.ts:644:  it(\"the same event stream into a fresh thread re-chunks identically — membership and boundaries deep-equal\", async () => {\npackages/lhc/test/validation.test.ts:140:  it(\"TC-4.5: a batch mixing new, duplicate, and invalid events is rejected whole\", async () => {\npackages/lhc/test/validation.test.ts:150:      original[0]!, // valid duplicate of a recorded event\npackages/pi-lhc/test/fixtures/thread.ts:4:// connector's tests isolate their registry + thread files the same way.\npackages/lhc/test/inspect-view.test.ts:6:// INDEPENDENT pull re-measured with the same estimator, on a compacted\npackages/lhc/test/inspect-view.test.ts:236:    // independent pull re-measured with the same estimator.\npackages/lhc/test/inspect-view.test.ts:342:    // content under the same estimator.\npackages/lhc/test/inspect-view.test.ts:348:describe(\"TC-2.3 / AC-2.4: never-compacted thread reports tail-only under the same parity contract\", () => {\npackages/lhc/test/lifecycle.test.ts:8:// cli-process-inspect.test.ts) legs replay the same sequence.\npackages/lhc/test/lifecycle.test.ts:165:    // Overview agrees on the same view identity with derivation settled.\npackages/lhc/test/lifecycle.test.ts:189:    // Health joins the same truth: pending counts sum to the cleared set,\npackages/lhc/test/lifecycle.test.ts:251:    // health reported — same ready counts, in-flight = pending + retrying,\npackages/lhc/test/epic-fix-02.test.ts:9://     background SDK in the same process on a different thread.\npackages/lhc/test/epic-fix-02.test.ts:147:  it(\"manual-then-background isolates the manual SDK the same way\", async () => {\npackages/lhc/test/work-queue.test.ts:166:      original, // duplicate: skipped\npackages/lhc/test/work-queue.test.ts:175:        skipReason: \"duplicate_idempotency_key\",\npackages/lhc/test/work-queue.test.ts:223:  it(\"TC-3.6 (work half): implicit close queues the same work-item contract as the explicit path (AC-3.6)\", async () => {\npackages/lhc/test/work-queue.test.ts:426:    // One owner per kind: a second table claiming the same kind is a wiring\npackages/lhc/test/work-queue.test.ts:457:    // The pending state rows rode the same transaction (DD-5): one for the\npackages/lhc/test/work-queue.test.ts:473:    // path, same seam Epic 01's atomicity tests use).\npackages/lhc/test/work-queue.test.ts:515:      // Commit leg: same enqueue, no failure — and the poke fires after the\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:107:    // --session full id → the same thread\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:112:    // --session partial id → the same thread\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:202:  it(\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\", async () => {\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:330:    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:335:  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:357:    // duplicate). The connector keeps NO module-level handoff state, so the only\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:369:    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\npackages/pi-lhc/test/lifecycle/thread-resolution.test.ts:370:    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\npackages/lhc/test/view-boundary.test.ts:39:// so a content
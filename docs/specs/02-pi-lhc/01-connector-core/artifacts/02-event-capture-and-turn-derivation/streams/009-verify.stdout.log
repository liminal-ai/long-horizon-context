{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/inspect.ts | sed -n '1,140p'\"","aggregated_output":"     1\t// Epic 04 shared vocabulary: the inspect domain's report shapes (tech design\n     2\t// §Interface Definitions). Inspect is a pure consumer — these shapes carry\n     3\t// other domains' surface output composed into counts and summaries; nothing\n     4\t// here is re-derived or re-interpreted beyond the owners' reported states.\n     5\timport type { Band } from \"./view.js\";\n     6\t\n     7\texport interface InspectOverview {\n     8\t  thread: { id: string; createdAt: string; metadata?: Record<string, string> };\n     9\t  // span null ⇔ count 0 (AC-1.3: absent pieces report as zeros/nulls).\n    10\t  events: { count: number; span: { first: number; last: number } | null };\n    11\t  // Deleted contract (AC-1.2): deleted messages appear only in `deleted` —\n    12\t  // excluded from visible, byKind, and visibleTokens; event counts above are\n    13\t  // unaffected (the record retains everything).\n    14\t  messages: {\n    15\t    visible: number;\n    16\t    byKind: Record<string, number>;\n    17\t    deleted: number;\n    18\t    visibleTokens: number;\n    19\t  };\n    20\t  turns: { open: number; closed: number };\n    21\t  chunks: { count: number; unchunkedTurns: number };\n    22\t  // Counts by operational state across both owners' report surfaces; ready\n    23\t  // included (AC-1.1 — unlike ViewStatus, which reports situations only).\n    24\t  derivation: {\n    25\t    ready: number;\n    26\t    pending: number;\n    27\t    retrying: number;\n    28\t    failed: number;\n    29\t    blocked: number;\n    30\t  };\n    31\t  // Active-view summary, or null when never compacted (AC-1.1).\n    32\t  view: {\n    33\t    viewId: string;\n    34\t    createdAt: string;\n    35\t    compactPoint: number;\n    36\t    coveredFrom: number;\n    37\t  } | null;\n    38\t  visibility: { boundaryPosition: number; zoneTokens: number };\n    39\t}\n    40\t\n    41\t// Story 3's shape, pinned with the domain so the inspect vocabulary lands\n    42\t// whole (tech design §Interface Definitions); `inspect.view` serves it.\n    43\texport interface ViewContentsReport {\n    44\t  meta: {\n    45\t    viewId: string;\n    46\t    createdAt: string;\n    47\t    profile: string | null;\n    48\t    config: { lowerBound: number; percentages: Record<string, number> };\n    49\t    compactPoint: number;\n    50\t    coveredFrom: number;\n    51\t  } | null;\n    52\t  bands: Array<{\n    53\t    band: Band;\n    54\t    entries: Array<{\n    55\t      subjectKind: \"chunk\" | \"turn\";\n    56\t      subjectId: string;\n    57\t      formUsed: string;\n    58\t      degraded: boolean;\n    59\t    }>;\n    60\t    storedTokens: number;\n    61\t  }>;\n    62\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n    63\t  tail: { messageCount: number; tokens: number }; // as served (AC-2.2)\n    64\t  // loadCost totals what pull serves NOW (AC-2.3): band and tail tokens are\n    65\t  // both measured over pull's served messages with the shared estimator, so\n    66\t  // equality with an independent pull is structural. The stored per-band\n    67\t  // counts stay reported above (bands[].storedTokens, AC-2.1) — they price\n    68\t  // the snapshot bytes without the served band-marker header, so they are\n    69\t  // describe's truth, not the serving cost.\n    70\t  loadCost: { bandTokens: number; tailTokens: number; total: number }; // = pull (AC-2.3)\n    71\t  // Provenance verbatim (AC-2.5); null on a never-compacted thread — no\n    72\t  // compact ever recorded what it saw, and inventing zeros would fabricate\n    73\t  // provenance (AC-2.4's view-null shape extends here).\n    74\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> } | null;\n    75\t}\n    76\t\n    77\texport interface HealthReport {\n    78\t  // Counts by owner, form kind, and operational state (AC-4.1), assembled\n    79\t  // entirely from the owners' report surfaces.\n    80\t  owners: Array<{\n    81\t    owner: \"capture\" | \"messages\" | \"turns\";\n    82\t    kind: string;\n    83\t    counts: {\n    84\t      ready: number;\n    85\t      pending: number;\n    86\t      retrying: number;\n    87\t      failed: number;\n    88\t      blocked: number;\n    89\t    };\n    90\t  }>;\n    91\t  // Actionable failure detail (AC-4.2): enough to decide and target a\n    92\t  // requeue without raw SQL.\n    93\t  failures: Array<{\n    94\t    owner: string;\n    95\t    subjectKind: string;\n    96\t    subjectId: string;\n    97\t    form: string;\n    98\t    reason: string;\n    99\t    attempts: number;\n   100\t    lastError?: string;\n   101\t  }>;\n   102\t  // What a requeue pass would touch — failed and not blocked — reported,\n   103\t  // never executed (AC-4.3).\n   104\t  repairPreview: Array<{\n   105\t    owner: string;\n   106\t    subjectKind: string;\n   107\t    subjectId: string;\n   108\t    form: string;\n   109\t  }>;\n   110\t  // Live queue visibility from the owners' queue detail (AC-4.5), counted\n   111\t  // per report entry so the section is consistent by construction with the\n   112\t  // pending/retrying state counts in the same report.\n   113\t  queue: { queued: number; claimed: number };\n   114\t}\n","exit_code":0,"status":"completed"}}

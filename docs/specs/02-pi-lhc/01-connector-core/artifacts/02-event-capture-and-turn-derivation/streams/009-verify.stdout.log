{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/turn-accumulator.ts | sed -n '1,120p'\"","aggregated_output":"     1\timport type { MessageEventInput } from \"lhc\";\n     2\timport { eventKey } from \"./idempotency.js\";\n     3\t\n     4\t// AC-2.2: track the open LHC turn; emit exactly one `turn_end` at `agent_end`;\n     5\t// ignore PI's per-step `turn_end` as a boundary signal. Pure state machine.\n     6\t//\n     7\t// An LHC turn opens on a `user_prompt` and stays open across every agent step.\n     8\t// The converter never feeds PI's per-step `turn_end` here, so it can never close\n     9\t// a turn; only `onAgentEnd()` does, and only when a turn is open. A run that\n    10\t// never reaches `agent_end` (hard kill) leaves the turn open — tolerated as a\n    11\t// no-op on reattach, since a fresh accumulator has no open turn to close.\n    12\t\n    13\texport interface TurnAccumulatorCtx {\n    14\t  piSessionId: string;\n    15\t  actor?: string;\n    16\t  harness?: string;\n    17\t}\n    18\t\n    19\texport class TurnAccumulator {\n    20\t  private readonly piSessionId: string;\n    21\t  private readonly actor: string;\n    22\t  private readonly harness: string;\n    23\t  private open = false;\n    24\t  private openTurnKey: string | null = null;\n    25\t\n    26\t  constructor(ctx: TurnAccumulatorCtx) {\n    27\t    this.piSessionId = ctx.piSessionId;\n    28\t    this.actor = ctx.actor ?? \"system\";\n    29\t    this.harness = ctx.harness ?? \"pi\";\n    30\t  }\n    31\t\n    32\t  /** Open the turn when this message's events include a `user_prompt`. A new\n    33\t   *  prompt mid-run is handled by LHC's own turn machine (close-then-open); the\n    34\t   *  accumulator only needs to know a turn is open for the `agent_end` close. */\n    35\t  onMessage(events: MessageEventInput[]): void {\n    36\t    const opening = events.find((event) => event.eventKind === \"user_prompt\");\n    37\t    if (opening !== undefined) {\n    38\t      this.open = true;\n    39\t      this.openTurnKey = opening.idempotencyKey;\n    40\t    }\n    41\t  }\n    42\t\n    43\t  /** Returns `[turn_end]` when a turn is open, else `[]`. Closing is the only\n    44\t   *  transition the accumulator drives, and it happens once per agent run. */\n    45\t  onAgentEnd(): MessageEventInput[] {\n    46\t    if (!this.open) return [];\n    47\t    this.open = false;\n    48\t    const key = eventKey({\n    49\t      piSessionId: this.piSessionId,\n    50\t      blockIndex: 0,\n    51\t      kind: \"turn_end\",\n    52\t      role: \"system\",\n    53\t      content: this.openTurnKey ?? \"turn:end\",\n    54\t    });\n    55\t    this.openTurnKey = null;\n    56\t    return [\n    57\t      {\n    58\t        eventKind: \"turn_end\",\n    59\t        idempotencyKey: key,\n    60\t        actor: this.actor,\n    61\t        harness: this.harness,\n    62\t        payload: {},\n    63\t      },\n    64\t    ];\n    65\t  }\n    66\t\n    67\t  hasOpenTurn(): boolean {\n    68\t    return this.open;\n    69\t  }\n    70\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/idempotency.ts | sed -n '1,120p'\"","aggregated_output":"     1\timport { createHash } from \"node:crypto\";\n     2\timport type { EventKind } from \"lhc\";\n     3\t\n     4\t// AC-2.6: a stable per-event key so re-delivery dedups and crash-replay is\n     5\t// safe. Pure, deterministic — identical across re-delivery of the same logical\n     6\t// event, distinct across different events. Construction precedence (from the\n     7\t// POC mapper, carried forward): PI entry id, else provider responseId /\n     8\t// toolCallId, else a content fingerprint as last resort. `blockIndex` and\n     9\t// `kind` ride every tier so one message's fan-out (thinking → text →\n    10\t// tool_call×N) stays distinct under a single shared id.\n    11\t\n    12\texport interface EventKeyInput {\n    13\t  piSessionId: string;\n    14\t  // Optionals admit explicit `undefined` so a caller can thread a\n    15\t  // possibly-absent id through directly under exactOptionalPropertyTypes.\n    16\t  entryId?: string | undefined;\n    17\t  responseId?: string | undefined;\n    18\t  toolCallId?: string | undefined;\n    19\t  blockIndex: number;\n    20\t  kind: EventKind;\n    21\t  role?: string | undefined;\n    22\t  content?: string | undefined;\n    23\t}\n    24\t\n    25\t// Join fingerprint parts with the ASCII unit separator — a delimiter that\n    26\t// effectively never occurs in PI message text, so two different part lists\n    27\t// cannot collide into the same joined string.\n    28\tconst SEP = \"\\u001f\";\n    29\t\n    30\t/** A short, stable content fingerprint — the last-resort key tier when an\n    31\t *  event carries no PI/provider id. sha256 truncated: collision-resistant\n    32\t *  enough for dedup, short enough to keep keys readable. */\n    33\texport function fingerprint(...parts: string[]): string {\n    34\t  return createHash(\"sha256\").update(parts.join(SEP)).digest(\"hex\").slice(0, 24);\n    35\t}\n    36\t\n    37\texport function eventKey(input: EventKeyInput): string {\n    38\t  const { piSessionId, entryId, responseId, toolCallId, blockIndex, kind } = input;\n    39\t  // Tier 1 — PI entry id: the most stable identity, present on real\n    40\t  // finalized message; disambiguated by block + kind for the fan-out.\n    41\t  if (entryId !== undefined && entryId !== \"\") {\n    42\t    return `pi:${piSessionId}:${entryId}:${blockIndex}:${kind}`;\n    43\t  }\n    44\t  // Tier 2 — tool-call id: stable across re-delivery and independent of arrival\n    45\t  // order; kind separates the call from its result under the same id.\n    46\t  if (toolCallId !== undefined && toolCallId !== \"\") {\n    47\t    return `pi:${piSessionId}:tool:${toolCallId}:${kind}`;\n    48\t  }\n    49\t  // Tier 3 — provider response id: stable per assistant response.\n    50\t  if (responseId !== undefined && responseId !== \"\") {\n    51\t    return `pi:${piSessionId}:resp:${responseId}:${blockIndex}:${kind}`;\n    52\t  }\n    53\t  // Tier 4 — content fingerprint: last resort for an event with no id at all.\n    54\t  const role = input.role ?? \"\";\n    55\t  const fp = fingerprint(role, kind, input.content ?? \"\");\n    56\t  return `pi:${piSessionId}:fp:${blockIndex}:${role}:${kind}:${fp}`;\n    57\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/inspect/internal/health.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Health composition (Flow 4): owners' report surfaces joined into state\n     2\t// counts, actionable failure detail, a repair preview, and live queue\n     3\t// visibility. Message/turn derivation health comes from FormReportEntry rows;\n     4\t// capture gaps come from durable source-event markers recorded by capture.\n     5\timport type { FormReportEntry } from \"../../../shared/derivation.js\";\n     6\timport type { OpResult } from \"../../../shared/errors.js\";\n     7\timport type { HealthReport } from \"../../../shared/inspect.js\";\n     8\timport * as intakeStream from \"../../intake-stream/index.js\";\n     9\timport * as messages from \"../../messages/index.js\";\n    10\timport * as turns from \"../../turns/index.js\";\n    11\timport type { ThreadRef } from \"../../threads/index.js\";\n    12\t\n    13\ttype Owner = \"capture\" | \"messages\" | \"turns\";\n    14\t\n    15\tfunction emptyCounts(): HealthReport[\"owners\"][number][\"counts\"] {\n    16\t  return { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n    17\t}\n    18\t\n    19\tfunction captureGapText(event: intakeStream.EventRecord): string | null {\n    20\t  if (event.eventKind !== \"runtime_note\") return null;\n    21\t  return event.payload.text.startsWith(\"capture gap:\") ? event.payload.text : null;\n    22\t}\n    23\t\n    24\t// Failure detail (AC-4.2): attempts and last error read from wherever the\n    25\t// mechanics durably put them — retry exhaustion copies them onto the form's\n    26\t// metadata before the queue row is deleted; a still-live item carries them\n    27\t// on the queue join. Never synthesized.\n    28\tfunction failureOf(\n    29\t  owner: Owner,\n    30\t  entry: FormReportEntry,\n    31\t): HealthReport[\"failures\"][number] {\n    32\t  const failure: HealthReport[\"failures\"][number] = {\n    33\t    owner,\n    34\t    subjectKind: entry.subjectKind,\n    35\t    subjectId: entry.subjectId,\n    36\t    form: entry.form,\n    37\t    reason: entry.reason ?? \"\",\n    38\t    attempts: entry.metadata?.attempts ?? entry.queue?.attempts ?? 0,\n    39\t  };\n    40\t  const lastError = entry.metadata?.lastError ?? entry.queue?.lastError;\n    41\t  if (lastError !== undefined) failure.lastError = lastError;\n    42\t  return failure;\n    43\t}\n    44\t\n    45\texport async function composeHealth(ref: ThreadRef): Promise<OpResult<HealthReport>> {\n    46\t  const messageReport = await messages.report(ref);\n    47\t  if (!messageReport.ok) return messageReport;\n    48\t  const turnReport = await turns.report(ref);\n    49\t  if (!turnReport.ok) return turnReport;\n    50\t  const events = await intakeStream.listEvents(ref);\n    51\t  if (!events.ok) return events;\n    52\t\n    53\t  const sources: ReadonlyArray<readonly [Owner, readonly FormReportEntry[]]> = [\n    54\t    [\"messages\", messageReport.value],\n    55\t    [\"turns\", turnReport.value],\n    56\t  ];\n    57\t\n    58\t  const countsByOwnerKind = new Map<string, HealthReport[\"owners\"][number]>();\n    59\t  const failures: HealthReport[\"failures\"] = [];\n    60\t  const repairPreview: HealthReport[\"repairPreview\"] = [];\n    61\t  const queue = { queued: 0, claimed: 0 };\n    62\t\n    63\t  const captureGaps = events.value\n    64\t    .map((event) => ({ event, text: captureGapText(event) }))\n    65\t    .filter((gap): gap is { event: intakeStream.EventRecord; text: string } => gap.text !== null);\n    66\t  if (captureGaps.length > 0) {\n    67\t    countsByOwnerKind.set(\"capture:capture_gap\", {\n    68\t      owner: \"capture\",\n    69\t      kind: \"capture_gap\",\n    70\t      counts: { ...emptyCounts(), failed: captureGaps.length },\n    71\t    });\n    72\t    for (const { event, text } of captureGaps) {\n    73\t      failures.push({\n    74\t        owner: \"capture\",\n    75\t        subjectKind: \"event\",\n    76\t        subjectId: String(event.eventOrder),\n    77\t        form: \"capture_gap\",\n    78\t        reason: text,\n    79\t        attempts: 0,\n    80\t      });\n    81\t    }\n    82\t  }\n    83\t\n    84\t  for (const [owner, entries] of sources) {\n    85\t    for (const entry of entries) {\n    86\t      const key = `${owner}:${entry.form}`;\n    87\t      let row = countsByOwnerKind.get(key);\n    88\t      if (row === undefined) {\n    89\t        row = { owner, kind: entry.form, counts: emptyCounts() };\n    90\t        countsByOwnerKind.set(key, row);\n    91\t      }\n    92\t      switch (entry.state) {\n    93\t        case \"ready\":\n    94\t          row.counts.ready += 1;\n    95\t          break;\n    96\t        case \"pending\":\n    97\t          if ((entry.queue?.attempts ?? 0) > 0) row.counts.retrying += 1;\n    98\t          else row.counts.pending += 1;\n    99\t          break;\n   100\t        case \"failed\":\n   101\t          row.counts.failed += 1;\n   102\t          failures.push(failureOf(owner, entry));\n   103\t          // The preview is exactly the failed-and-not-blocked set: blocked is\n   104\t          // a distinct state, so failed entries ARE the requeue targets.\n   105\t          repairPreview.push({\n   106\t            owner,\n   107\t            subjectKind: entry.subjectKind,\n   108\t            subjectId: entry.subjectId,\n   109\t            form: entry.form,\n   110\t          });\n   111\t          break;\n   112\t        case \"blocked\":\n   113\t          row.counts.blocked += 1;\n   114\t          failures.push(failureOf(owner, entry));\n   115\t          break;\n   116\t      }\n   117\t      // Live queue visibility (AC-4.5), per report entry: every pending or\n   118\t      // retrying entry rides a live item, so queued + claimed here equals\n   119\t      // pending + retrying above by construction. Counts are per form-report\n   120\t      // entry by ratified contract (Epic 04 fix-batch-001): one work item\n   121\t      // (e.g. a turn_derivation) may back multiple form entries, so a raw\n   122\t      // listQueuedWork work-item count would break that identity.\n   123\t      if (entry.queue !== undefined) {\n   124\t        if (entry.queue.status === \"queued\") queue.queued += 1;\n   125\t        else queue.claimed += 1;\n   126\t      }\n   127\t    }\n   128\t  }\n   129\t\n   130\t  // Deterministic order: messages before turns, kinds alphabetical within\n   131\t  // an owner — repeated reads with no writes between are deep-equal.\n   132\t  const owners = [...countsByOwnerKind.values()].sort((a, b) =>\n   133\t    a.owner === b.owner ? a.kind.localeCompare(b.kind) : a.owner.localeCompare(b.owner),\n   134\t  );\n   135\t\n   136\t  return { ok: true, value: { owners, failures, repairPreview, queue } };\n   137\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/capture/map-message.ts | sed -n '1,280p'\"","aggregated_output":"     1\timport type { EventKind, MessageEventInput } from \"lhc\";\n     2\timport type {\n     3\t  AgentMessage,\n     4\t  AssistantMessage,\n     5\t  ContentPart,\n     6\t  FileRefPart,\n     7\t  ImagePart,\n     8\t  ToolResultMessage,\n     9\t  UserMessage,\n    10\t} from \"../pi/types.js\";\n    11\timport { eventKey } from \"./idempotency.js\";\n    12\t\n    13\t// AC-2.1, AC-2.3, AC-2.4, AC-2.5. Pure (no I/O): one PI `AgentMessage` → the\n    14\t// ordered LHC events for it. A user message → one `user_prompt`; an assistant\n    15\t// message fans out `assistant_thinking` (if present) → `assistant_text` (if\n    16\t// present) → one `tool_call` per call, in that order; a tool result → one\n    17\t// `tool_result` correlated by `toolCallId`, carrying `isError`. Unsupported\n    18\t// parts and a wholly-empty message degrade to a `runtime_note` (never a silent\n    19\t// drop, tech design I-6). A graceful interrupt carries its disposition through\n    20\t// on a trailing `runtime_note` (research §5b).\n    21\t\n    22\texport interface MapCtx {\n    23\t  piSessionId: string;\n    24\t  entryId?: string;\n    25\t}\n    26\t\n    27\tconst HARNESS = \"pi\";\n    28\t\n    29\t/** The aborted-disposition note text. A graceful interrupt has no intake-schema\n    30\t *  field to hold its disposition, so the mapper carries `stopReason` through on\n    31\t *  the one durable vehicle — a `runtime_note` — rather than discarding it.\n    32\t *  Exported so the aborted corpus fixture stays in lock-step with the mapper. */\n    33\texport const ABORTED_DISPOSITION_TEXT =\n    34\t  \"turn aborted (stopReason: aborted) — partial content preserved\";\n    35\t\n    36\tconst EMPTY_MESSAGE_NOTE = \"message omitted: no mappable content parts\";\n    37\t\n    38\tfunction textOf(parts: ContentPart[]): string {\n    39\t  return parts\n    40\t    .filter((p): p is Extract<ContentPart, { type: \"text\" }> => p.type === \"text\")\n    41\t    .map((p) => p.text)\n    42\t    .join(\"\");\n    43\t}\n    44\t\n    45\tfunction thinkingOf(parts: ContentPart[]): string {\n    46\t  return parts\n    47\t    .filter((p): p is Extract<ContentPart, { type: \"thinking\" }> => p.type === \"thinking\")\n    48\t    .map((p) => p.thinking)\n    49\t    .join(\"\");\n    50\t}\n    51\t\n    52\tfunction unsupportedOf(parts: ContentPart[]): Array<ImagePart | FileRefPart> {\n    53\t  return parts.filter(\n    54\t    (p): p is ImagePart | FileRefPart => p.type === \"image\" || p.type === \"fileRef\",\n    55\t  );\n    56\t}\n    57\t\n    58\tfunction omissionText(part: ImagePart | FileRefPart): string {\n    59\t  return part.type === \"image\"\n    60\t    ? `unsupported content omitted: image part${part.mimeType !== undefined ? ` (${part.mimeType})` : \"\"}`\n    61\t    : `unsupported content omitted: file reference (${part.path})`;\n    62\t}\n    63\t\n    64\tfunction buildKey(\n    65\t  ctx: MapCtx,\n    66\t  role: string,\n    67\t  kind: EventKind,\n    68\t  blockIndex: number,\n    69\t  opts: {\n    70\t    entryId?: string | undefined;\n    71\t    responseId?: string | undefined;\n    72\t    toolCallId?: string | undefined;\n    73\t    content?: string | undefined;\n    74\t  } = {},\n    75\t): string {\n    76\t  return eventKey({\n    77\t    piSessionId: ctx.piSessionId,\n    78\t    entryId: opts.entryId ?? ctx.entryId,\n    79\t    responseId: opts.responseId,\n    80\t    blockIndex,\n    81\t    kind,\n    82\t    role,\n    83\t    toolCallId: opts.toolCallId,\n    84\t    content: opts.content,\n    85\t  });\n    86\t}\n    87\t\n    88\tfunction stringField(value: unknown, field: string): string | undefined {\n    89\t  if (typeof value !== \"object\" || value === null || !(field in value)) return undefined;\n    90\t  const candidate = (value as Record<string, unknown>)[field];\n    91\t  return typeof candidate === \"string\" && candidate !== \"\" ? candidate : undefined;\n    92\t}\n    93\t\n    94\tfunction entryIdOf(msg: AgentMessage): string | undefined {\n    95\t  return stringField(msg, \"entryId\");\n    96\t}\n    97\t\n    98\tfunction responseIdOf(msg: AgentMessage): string | undefined {\n    99\t  return stringField(msg, \"responseId\") ?? stringField(msg, \"id\");\n   100\t}\n   101\t\n   102\t// Per-kind builders — explicit eventKind literals so the discriminated union\n   103\t// narrows without a cast.\n   104\tfunction textEvent(\n   105\t  kind: \"user_prompt\" | \"assistant_text\" | \"assistant_thinking\" | \"runtime_note\",\n   106\t  text: string,\n   107\t  actor: string,\n   108\t  key: string,\n   109\t): MessageEventInput {\n   110\t  return { eventKind: kind, idempotencyKey: key, actor, harness: HARNESS, payload: { text } };\n   111\t}\n   112\t\n   113\tfunction toolCallEvent(\n   114\t  toolCallId: string,\n   115\t  toolName: string,\n   116\t  args: Record<string, unknown>,\n   117\t  key: string,\n   118\t): MessageEventInput {\n   119\t  return {\n   120\t    eventKind: \"tool_call\",\n   121\t    idempotencyKey: key,\n   122\t    actor: \"assistant\",\n   123\t    harness: HARNESS,\n   124\t    payload: { toolCallId, toolName, arguments: args },\n   125\t  };\n   126\t}\n   127\t\n   128\tfunction toolResultEvent(\n   129\t  toolCallId: string,\n   130\t  content: string,\n   131\t  isError: boolean,\n   132\t  key: string,\n   133\t): MessageEventInput {\n   134\t  return {\n   135\t    eventKind: \"tool_result\",\n   136\t    idempotencyKey: key,\n   137\t    actor: \"tool\",\n   138\t    harness: HARNESS,\n   139\t    payload: { toolCallId, content, isError },\n   140\t  };\n   141\t}\n   142\t\n   143\tfunction mapUser(msg: UserMessage, ctx: MapCtx): MessageEventInput[] {\n   144\t  const events: MessageEventInput[] = [];\n   145\t  const entryId = entryIdOf(msg);\n   146\t  let block = 0;\n   147\t  if (msg.content.some((p) => p.type === \"text\")) {\n   148\t    const text = textOf(msg.content);\n   149\t    events.push(textEvent(\"user_prompt\", text, \"user\", buildKey(ctx, \"user\", \"user_prompt\", block, { entryId, content: text })));\n   150\t    block += 1;\n   151\t  }\n   152\t  for (const part of unsupportedOf(msg.content)) {\n   153\t    const text = omissionText(part);\n   154\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: text })));\n   155\t    block += 1;\n   156\t  }\n   157\t  if (events.length === 0) {\n   158\t    events.push(\n   159\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"user\", \"runtime_note\", block, { entryId, content: \"empty:user\" })),\n   160\t    );\n   161\t  }\n   162\t  return events;\n   163\t}\n   164\t\n   165\tfunction mapAssistant(msg: AssistantMessage, ctx: MapCtx): MessageEventInput[] {\n   166\t  const events: MessageEventInput[] = [];\n   167\t  const entryId = entryIdOf(msg);\n   168\t  const responseId = responseIdOf(msg);\n   169\t  let block = 0;\n   170\t  // PI's confirmed part order: thinking → text → tool calls (research §5a).\n   171\t  if (msg.content.some((p) => p.type === \"thinking\")) {\n   172\t    const text = thinkingOf(msg.content);\n   173\t    events.push(textEvent(\"assistant_thinking\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_thinking\", block, { entryId, responseId, content: text })));\n   174\t    block += 1;\n   175\t  }\n   176\t  if (msg.content.some((p) => p.type === \"text\")) {\n   177\t    const text = textOf(msg.content);\n   178\t    events.push(textEvent(\"assistant_text\", text, \"assistant\", buildKey(ctx, \"assistant\", \"assistant_text\", block, { entryId, responseId, content: text })));\n   179\t    block += 1;\n   180\t  }\n   181\t  for (const part of msg.content) {\n   182\t    if (part.type !== \"toolCall\") continue;\n   183\t    events.push(\n   184\t      toolCallEvent(part.id, part.name, part.arguments, buildKey(ctx, \"assistant\", \"tool_call\", block, { entryId, responseId, toolCallId: part.id, content: part.name })),\n   185\t    );\n   186\t    block += 1;\n   187\t  }\n   188\t  for (const part of unsupportedOf(msg.content)) {\n   189\t    const text = omissionText(part);\n   190\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: text })));\n   191\t    block += 1;\n   192\t  }\n   193\t  // Graceful interrupt: carry the aborted disposition through (never discarded).\n   194\t  if (msg.stopReason === \"aborted\") {\n   195\t    events.push(\n   196\t      textEvent(\"runtime_note\", ABORTED_DISPOSITION_TEXT, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: ABORTED_DISPOSITION_TEXT })),\n   197\t    );\n   198\t    block += 1;\n   199\t  }\n   200\t  if (events.length === 0) {\n   201\t    events.push(\n   202\t      textEvent(\"runtime_note\", EMPTY_MESSAGE_NOTE, \"system\", buildKey(ctx, \"assistant\", \"runtime_note\", block, { entryId, responseId, content: \"empty:assistant\" })),\n   203\t    );\n   204\t  }\n   205\t  return events;\n   206\t}\n   207\t\n   208\tfunction mapToolResult(msg: ToolResultMessage, ctx: MapCtx): MessageEventInput[] {\n   209\t  const events: MessageEventInput[] = [];\n   210\t  const entryId = entryIdOf(msg);\n   211\t  const content = textOf(msg.content);\n   212\t  const isError = msg.isError === true;\n   213\t  // Correlation is by toolCallId, not arrival order (AC-2.3); the error flag\n   214\t  // and content are always captured, even on failure (AC-2.4).\n   215\t  events.push(\n   216\t    toolResultEvent(\n   217\t      msg.toolCallId,\n   218\t      content,\n   219\t      isError,\n   220\t      buildKey(ctx, \"toolResult\", \"tool_result\", 0, { entryId, toolCallId: msg.toolCallId, content }),\n   221\t    ),\n   222\t  );\n   223\t  let block = 1;\n   224\t  for (const part of unsupportedOf(msg.content)) {\n   225\t    const text = omissionText(part);\n   226\t    events.push(textEvent(\"runtime_note\", text, \"system\", buildKey(ctx, \"toolResult\", \"runtime_note\", block, { entryId, toolCallId: msg.toolCallId, content: text })));\n   227\t    block += 1;\n   228\t  }\n   229\t  return events;\n   230\t}\n   231\t\n   232\texport function mapMessage(msg: AgentMessage, ctx: MapCtx): MessageEventInput[] {\n   233\t  switch (msg.role) {\n   234\t    case \"user\":\n   235\t      return mapUser(msg, ctx);\n   236\t    case \"assistant\":\n   237\t      return mapAssistant(msg, ctx);\n   238\t    case \"toolResult\":\n   239\t      return mapToolResult(msg, ctx);\n   240\t  }\n   241\t}\n","exit_code":0,"status":"completed"}}

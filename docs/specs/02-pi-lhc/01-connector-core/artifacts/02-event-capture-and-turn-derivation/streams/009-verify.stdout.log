{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/converter.test.ts | sed -n '120,210p'\"","aggregated_output":"   120\t    expect(levelNote).toContain(\"high\");\n   121\t  });\n   122\t});\n   123\t\n   124\tdescribe(\"Story 2: converter — failure isolation (TC-2.8, atomicity risk)\", () => {\n   125\t  async function liveInstance(): Promise<LhcInstance> {\n   126\t    const thread = await makeTempThread(store);\n   127\t    const built = await initInstance(thread.threadRef, {\n   128\t      provider: createDeterministicProvider(),\n   129\t      mode: \"background\",\n   130\t    });\n   131\t    if (!built.ok) throw new Error(`instance init failed: ${built.error.reason}`);\n   132\t    return built.value;\n   133\t  }\n   134\t\n   135\t  it(\"(a) a malformed event on a writable thread records a durable, queryable gap and never throws\", async () => {\n   136\t    const instance = await liveInstance();\n   137\t    // A turn_end with a non-empty payload is rejected by LHC validation\n   138\t    // (invalid_event) — a writable-thread malformed event, the AC-2.7 case.\n   139\t    const malformed = {\n   140\t      eventKind: \"turn_end\",\n   141\t      idempotencyKey: \"malformed-1\",\n   142\t      actor: \"system\",\n   143\t      harness: \"pi\",\n   144\t      payload: { stowaway: true },\n   145\t    } as unknown as MessageEventInput;\n   146\t\n   147\t    const result = await capture([malformed], instance);\n   148\t    expect(result.ok).toBe(false);\n   149\t\n   150\t    // The session continues: a durable, queryable gap is recorded on the thread.\n   151\t    const read = await intakeStream.listEvents(instance.threadRef);\n   152\t    expect(read.ok).toBe(true);\n   153\t    if (!read.ok) return;\n   154\t    const gaps = read.value.filter(\n   155\t      (event) =>\n   156\t        event.eventKind === \"runtime_note\" &&\n   157\t        (event.payload as { text: string }).text.toLowerCase().includes(\"gap\"),\n   158\t    );\n   159\t    expect(gaps).toHaveLength(1);\n   160\t\n   161\t    const health = await inspect.health(instance.threadRef);\n   162\t    expect(health.ok).toBe(true);\n   163\t    if (!health.ok) return;\n   164\t    expect(health.value.owners).toContainEqual({\n   165\t      owner: \"capture\",\n   166\t      kind: \"capture_gap\",\n   167\t      counts: { ready: 0, pending: 0, retrying: 0, failed: 1, blocked: 0 },\n   168\t    });\n   169\t    expect(health.value.failures).toContainEqual({\n   170\t      owner: \"capture\",\n   171\t      subjectKind: \"event\",\n   172\t      subjectId: String(gaps[0]!.eventOrder),\n   173\t      form: \"capture_gap\",\n   174\t      reason: (gaps[0]!.payload as { text: string }).text,\n   175\t      attempts: 0,\n   176\t    });\n   177\t\n   178\t    await instance.dispose();\n   179\t  });\n   180\t\n   181\t  it(\"(b) an unavailable thread store surfaces a structured failure with no gap and no throw\", async () => {\n   182\t    const deadInstance: LhcInstance = {\n   183\t      sdk: (await liveInstance()).sdk,\n   184\t      threadRef: { filePath: `${store.dir}/does-not-exist.sqlite` },\n   185\t      dispose: () => Promise.resolve({ ok: true, value: undefined }),\n   186\t    };\n   187\t\n   188\t    // capture isolates the failure into a structured result rather than throwing.\n   189\t    const result = await capture([validEvent(\"user_prompt\")], deadInstance);\n   190\t    expect(result.ok).toBe(false);\n   191\t    if (result.ok) return;\n   192\t    expect([\"thread_not_found\", \"storage_failure\"]).toContain(result.error.code);\n   193\t    // It is NOT misclassified as the writable-thread malformed-event case.\n   194\t    expect(result.error.code).not.toBe(\"invalid_event\");\n   195\t  });\n   196\t\n   197\t  it(\"(b) an unavailable store routes to an extension health signal (recordedGap:false), session continues\", async () => {\n   198\t    const started = await startCapture(store);\n   199\t    const { connector, ctx, threadRef } = started;\n   200\t\n   201\t    // Make the live thread's store unavailable mid-session, then capture.\n   202\t    const id = (threadRef as { threadId: string }).threadId;\n   203\t    const row = await threads.resolve({ threadId: id, registryPath: store.registryPath });\n   204\t    expect(row.ok).toBe(true);\n   205\t    if (!row.ok) return;\n   206\t    rmSync(row.value.filePath, { force: true });\n   207\t\n   208\t    // The hook must not throw despite the dead store.\n   209\t    await expect(\n   210\t      connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"after the store died\"))),\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/parallel-and-errors.test.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Story 2 — parallel-tool correlation (TC-2.4), error-result capture (TC-2.5),\n     2\t// and idempotent re-delivery (TC-2.7, the idempotency architecture-risk). The\n     3\t// first two run the production path and read the thread back; TC-2.7 drives\n     4\t// capture() directly so it can assert the per-event skip outcomes the SDK\n     5\t// returns on re-delivery.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport { createDeterministicProvider, intakeStream } from \"lhc\";\n     8\timport { capture } from \"../../src/capture/converter.js\";\n     9\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    10\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    11\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    12\timport {\n    13\t  makeAgentEnd,\n    14\t  makeAssistantMessage,\n    15\t  makeMessageEnd,\n    16\t  makeToolResult,\n    17\t  makeUserMessage,\n    18\t} from \"../fixtures/synthetic.js\";\n    19\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    20\timport { eventsAfterShutdown, kindsOf, startCapture } from \"./support.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tinterface ToolResultPayload {\n    31\t  toolCallId: string;\n    32\t  content: string;\n    33\t  isError?: boolean;\n    34\t}\n    35\tfunction toolResultPayload(event: { payload: unknown }): ToolResultPayload {\n    36\t  return event.payload as ToolResultPayload;\n    37\t}\n    38\t\n    39\tdescribe(\"Story 2: parallel tool calls (TC-2.4)\", () => {\n    40\t  it(\"correlates each out-of-order tool_result to its call by toolCallId, not arrival order\", async () => {\n    41\t    const started = await startCapture(store);\n    42\t    const { connector, ctx } = started;\n    43\t\n    44\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read both files\")));\n    45\t    await connector.handlers.message_end(\n    46\t      ctx,\n    47\t      makeMessageEnd(\n    48\t        makeAssistantMessage({\n    49\t          toolCalls: [\n    50\t            { id: \"call_a\", name: \"read_file\", arguments: { path: \"a.txt\" } },\n    51\t            { id: \"call_b\", name: \"read_file\", arguments: { path: \"b.txt\" } },\n    52\t          ],\n    53\t        }),\n    54\t      ),\n    55\t    );\n    56\t    // Results complete out of arrival order: b before a.\n    57\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_b\", content: \"b body\" })));\n    58\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeToolResult({ id: \"call_a\", content: \"a body\" })));\n    59\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"read both\" })));\n    60\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    61\t\n    62\t    const events = await eventsAfterShutdown(started);\n    63\t    const results = events.filter((event) => event.eventKind === \"tool_result\");\n    64\t    expect(results).toHaveLength(2);\n    65\t\n    66\t    // Each result carries its own call's id and content — correlation is by id.\n    67\t    const contentById = new Map(\n    68\t      results.map((event) => [toolResultPayload(event).toolCallId, toolResultPayload(event).content]),\n    69\t    );\n    70\t    expect(contentById.get(\"call_b\")).toBe(\"b body\");\n    71\t    expect(contentById.get(\"call_a\")).toBe(\"a body\");\n    72\t\n    73\t    // Arrival order is preserved in the record (b then a), each correctly tagged\n    74\t    // — proving the tag, not the position, is the correlation.\n    75\t    expect(toolResultPayload(results[0]!).toolCallId).toBe(\"call_b\");\n    76\t    expect(toolResultPayload(results[1]!).toolCallId).toBe(\"call_a\");\n    77\t  });\n    78\t});\n    79\t\n    80\tdescribe(\"Story 2: error tool result (TC-2.5)\", () => {\n    81\t  it(\"captures an error tool_result with the error flag and its content, dropping nothing\", async () => {\n    82\t    const started = await startCapture(store);\n    83\t    const { connector, ctx } = started;\n    84\t\n    85\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeUserMessage(\"read missing.txt\")));\n    86\t    await connector.handlers.message_end(\n    87\t      ctx,\n    88\t      makeMessageEnd(makeAssistantMessage({ toolCalls: [{ id: \"call_a\", name: \"read_file\", arguments: { path: \"missing.txt\" } }] })),\n    89\t    );\n    90\t    await connector.handlers.message_end(\n    91\t      ctx,\n    92\t      makeMessageEnd(makeToolResult({ id: \"call_a\", isError: true, content: \"ENOENT: no such file\" })),\n    93\t    );\n    94\t    await connector.handlers.message_end(ctx, makeMessageEnd(makeAssistantMessage({ text: \"it does not exist\" })));\n    95\t    await connector.handlers.agent_end(ctx, makeAgentEnd([]));\n    96\t\n    97\t    const events = await eventsAfterShutdown(started);\n    98\t    // Nothing dropped because the tool failed.\n    99\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"tool_call\", \"tool_result\", \"assistant_text\", \"turn_end\"]);\n   100\t\n   101\t    const result = events.find((event) => event.eventKind === \"tool_result\");\n   102\t    expect(result).toBeDefined();\n   103\t    expect(toolResultPayload(result!).isError).toBe(true);\n   104\t    expect(toolResultPayload(result!).content).toBe(\"ENOENT: no such file\");\n   105\t  });\n   106\t\n   107\t  it(\"records unsupported tool_result content parts as omission runtime_notes\", () => {\n   108\t    const events = mapMessage(\n   109\t      {\n   110\t        role: \"toolResult\",\n   111\t        toolCallId: \"call_file\",\n   112\t        content: [{ type: \"fileRef\", path: \"artifact.bin\" }],\n   113\t      },\n   114\t      { piSessionId: \"sess\" },\n   115\t    );\n   116\t\n   117\t    expect(kindsOf(events)).toEqual([\"tool_result\", \"runtime_note\"]);\n   118\t    expect(toolResultPayload(events[0]!).toolCallId).toBe(\"call_file\");\n   119\t    expect(toolResultPayload(events[0]!).content).toBe(\"\");\n   120\t    expect(events[1]!.payload).toEqual({\n   121\t      text: \"unsupported content omitted: file reference (artifact.bin)\",\n   122\t    });\n   123\t  });\n   124\t});\n   125\t\n   126\tdescribe(\"Story 2: idempotent re-delivery (TC-2.7, idempotency risk)\", () => {\n   127\t  it(\"skips a re-delivered batch by idempotency key and records no duplicates\", async () => {\n   128\t    const thread = await makeTempThread(store);\n   129\t    const built = await initInstance(thread.threadRef, {\n   130\t      provider: createDeterministicProvider(),\n   131\t      mode: \"background\",\n   132\t    });\n   133\t    expect(built.ok).toBe(true);\n   134\t    if (!built.ok) return;\n   135\t    const instance = built.value;\n   136\t\n   137\t    // Build one logical turn's events through the real map + accumulator, so the\n   138\t    // keys are exactly what production would emit.\n   139\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   140\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n   141\t    acc.onMessage(userEvents);\n   142\t    const assistantEvents = mapMessage(makeAssistantMessage({ text: \"hi there\" }), {\n   143\t      piSessionId: \"sess\",\n   144\t      entryId: \"s1\",\n   145\t    });\n   146\t    acc.onMessage(assistantEvents);\n   147\t    const turnEnd = acc.onAgentEnd();\n   148\t    const batch = [...userEvents, ...assistantEvents, ...turnEnd];\n   149\t\n   150\t    const first = await capture(batch, instance);\n   151\t    expect(first.ok).toBe(true);\n   152\t    if (first.ok) {\n   153\t      expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   154\t    }\n   155\t\n   156\t    // Re-delivery (the reload / crash-replay path): identical keys → all skipped.\n   157\t    const second = await capture(batch, instance);\n   158\t    expect(second.ok).toBe(true);\n   159\t    if (second.ok) {\n   160\t      expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   161\t      expect(\n   162\t        second.value.events.every((entry) => entry.skipReason === \"duplicate_idempotency_key\"),\n   163\t      ).toBe(true);\n   164\t    }\n   165\t\n   166\t    // No duplicate records landed on the thread.\n   167\t    const read = await intakeStream.listEvents(instance.threadRef);\n   168\t    expect(read.ok).toBe(true);\n   169\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   170\t\n   171\t    await instance.dispose();\n   172\t  });\n   173\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/inspect-health.test.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Story 2 (Epic 04), default suite: TC-4.1–4.3 — the inspect health report.\n     2\t// Counts by owner/kind/state assembled entirely from the owners' report\n     3\t// surfaces (AC-4.1), actionable failure detail (AC-4.2), a repair preview\n     4\t// that is reported and never executed (AC-4.3), rebuild visibility bracketing\n     5\t// a drain (AC-4.4), and live queue visibility consistent with the state\n     6\t// counts in the same report (AC-4.5).\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createSdk, intakeStream, threads, type HealthReport } from \"../src/index.js\";\n     9\timport {\n    10\t  createProviderDouble,\n    11\t  expectReadOnly,\n    12\t  mixedStateVariantThread,\n    13\t  mutationInFlightVariant,\n    14\t  PERMANENT_FAILURE_REASON,\n    15\t  tempStore,\n    16\t  TRANSIENT_EXHAUST_REASON,\n    17\t  validEvent,\n    18\t  type TempStore,\n    19\t} from \"./fixtures/index.js\";\n    20\t\n    21\tlet store: TempStore;\n    22\tbeforeEach(() => {\n    23\t  store = tempStore();\n    24\t});\n    25\tafterEach(() => {\n    26\t  store.cleanup();\n    27\t});\n    28\t\n    29\tfunction valueOf(result: { ok: boolean }): HealthReport {\n    30\t  if (!result.ok) {\n    31\t    throw new Error(`expected ok health report: ${JSON.stringify(result)}`);\n    32\t  }\n    33\t  return (result as { ok: true; value: HealthReport }).value;\n    34\t}\n    35\t\n    36\tconst ZERO = { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n    37\t\n    38\tasync function createThread(): Promise<string> {\n    39\t  const filePath = store.threadPath();\n    40\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    41\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    42\t  return filePath;\n    43\t}\n    44\t\n    45\tdescribe(\"TC-4.1 / AC-4.1, AC-4.5: counts per owner/kind/state and queue consistency\", () => {\n    46\t  it(\"the mixed-state fixture reports exact counts and a queue section consistent with them\", async () => {\n    47\t    const fixture = await mixedStateVariantThread(store);\n    48\t    const { filePath, sdk } = fixture;\n    49\t\n    50\t    const health = await expectReadOnly(filePath, () => sdk.inspect.health({ filePath }));\n    51\t    expect(health.ok).toBe(true);\n    52\t    if (!health.ok) return;\n    53\t    const report = health.value;\n    54\t\n    55\t    // Every owner/kind/state count, exact, in deterministic order: 13 turns'\n    56\t    // smoothings ready + t14's pending; the tool-heavy middle's summaries\n    57\t    // with the two scripted failures; t13's turn forms blocked on the real\n    58\t    // source damage; the three closed chunks' summaries ready.\n    59\t    expect(report.owners).toEqual([\n    60\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 13, pending: 1 } },\n    61\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n    62\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 6, failed: 2 } },\n    63\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 3 } },\n    64\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 3 } },\n    65\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n    66\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n    67\t    ]);\n    68\t\n    69\t    // Queue visibility from the same report's live joins: exactly the one\n    70\t    // still-queued smoothing item, consistent with the pending count.\n    71\t    expect(report.queue).toEqual({ queued: 1, claimed: 0 });\n    72\t    const pendingTotal = report.owners.reduce(\n    73\t      (sum, row) => sum + row.counts.pending + row.counts.retrying,\n    74\t      0,\n    75\t    );\n    76\t    expect(report.queue.queued + report.queue.claimed).toBe(pendingTotal);\n    77\t  });\n    78\t});\n    79\t\n    80\tdescribe(\"TC-4.2 / AC-4.2, AC-4.3: failure detail and repair preview\", () => {\n    81\t  it(\"failed entries carry exact detail; the preview is exactly the failed-not-blocked set\", async () => {\n    82\t    const fixture = await mixedStateVariantThread(store);\n    83\t    const { filePath, sdk } = fixture;\n    84\t    const report = valueOf(await sdk.inspect.health({ filePath }));\n    85\t\n    86\t    // Actionable failure detail: subject, form, reason, attempts, last error\n    87\t    // — enough to target a requeue without raw SQL.\n    88\t    const failed = report.failures.filter((entry) => entry.reason.startsWith(\"rate_limit\") || entry.reason.startsWith(\"content_refusal\"));\n    89\t    expect(failed).toEqual([\n    90\t      {\n    91\t        owner: \"messages\",\n    92\t        subjectKind: \"message\",\n    93\t        subjectId: fixture.failedTransientMessageId,\n    94\t        form: \"tool_result_summary\",\n    95\t        reason: TRANSIENT_EXHAUST_REASON,\n    96\t        attempts: 3,\n    97\t        lastError: TRANSIENT_EXHAUST_REASON,\n    98\t      },\n    99\t      {\n   100\t        owner: \"messages\",\n   101\t        subjectKind: \"message\",\n   102\t        subjectId: fixture.failedPermanentMessageId,\n   103\t        form: \"tool_result_summary\",\n   104\t        reason: PERMANENT_FAILURE_REASON,\n   105\t        attempts: 1,\n   106\t        lastError: PERMANENT_FAILURE_REASON,\n   107\t      },\n   108\t    ]);\n   109\t\n   110\t    // Blocked forms surface as failures too — with the damage named — but\n   111\t    // never as repair targets.\n   112\t    const blocked = report.failures.filter((entry) => !failed.includes(entry));\n   113\t    expect(blocked.map((entry) => [entry.owner, entry.subjectKind, entry.subjectId, entry.form])).toEqual([\n   114\t      [\"turns\", \"turn\", fixture.blockedTurnId, \"lower_band_projection\"],\n   115\t      [\"turns\", \"turn\", fixture.blockedTurnId, \"turn_rendering\"],\n   116\t    ]);\n   117\t    for (const entry of blocked) {\n   118\t      expect(entry.reason.length).toBeGreaterThan(0);\n   119\t    }\n   120\t\n   121\t    // The preview lists exactly the failed-and-not-blocked set, in report\n   122\t    // order — and previews only: the read changed nothing (the delta assert\n   123\t    // in TC-4.1 covers the same operation).\n   124\t    expect(report.repairPreview).toEqual([\n   125\t      {\n   126\t        owner: \"messages\",\n   127\t        subjectKind: \"message\",\n   128\t        subjectId: fixture.failedTransientMessageId,\n   129\t        form: \"tool_result_summary\",\n   130\t      },\n   131\t      {\n   132\t        owner: \"messages\",\n   133\t        subjectKind: \"message\",\n   134\t        subjectId: fixture.failedPermanentMessageId,\n   135\t        form: \"tool_result_summary\",\n   136\t      },\n   137\t    ]);\n   138\t\n   139\t    // Never executed: the failed forms are still failed on a second read —\n   140\t    // health did not requeue what it previewed.\n   141\t    const again = valueOf(await sdk.inspect.health({ filePath }));\n   142\t    expect(again).toEqual(report);\n   143\t  });\n   144\t});\n   145\t\n   146\tdescribe(\"TC-2.8 / AC-2.7: capture gaps in health\", () => {\n   147\t  it(\"reports durable capture-gap runtime_note markers as capture health failures\", async () => {\n   148\t    const filePath = await createThread();\n   149\t    const gap = validEvent(\"runtime_note\", {\n   150\t      idempotencyKey: \"gap-1\",\n   151\t      actor: \"system\",\n   152\t      harness: \"pi\",\n   153\t      payload: { text: \"capture gap: 1 event(s) rejected - payload mismatch\" },\n   154\t    });\n   155\t    const recorded = await intakeStream.messageEvents({ filePath }, [gap]);\n   156\t    expect(recorded.ok).toBe(true);\n   157\t\n   158\t    const reader = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n   159\t    const report = valueOf(await expectReadOnly(filePath, () => reader.inspect.health({ filePath })));\n   160\t    expect(report.owners).toContainEqual({\n   161\t      owner: \"capture\",\n   162\t      kind: \"capture_gap\",\n   163\t      counts: { ...ZERO, failed: 1 },\n   164\t    });\n   165\t    expect(report.failures).toContainEqual({\n   166\t      owner: \"capture\",\n   167\t      subjectKind: \"event\",\n   168\t      subjectId: \"1\",\n   169\t      form: \"capture_gap\",\n   170\t      reason: gap.payload.text,\n   171\t      attempts: 0,\n   172\t    });\n   173\t    expect(report.repairPreview).toEqual([]);\n   174\t  });\n   175\t});\n   176\t\n   177\tdescribe(\"TC-4.3 / AC-4.4: rebuild visibility brackets a drain\", () => {\n   178\t  it(\"after an edit the cascade's cleared set is pending with queued work; after the drain the same set is ready; nothing else moved\", async () => {\n   179\t    const fixture = await mutationInFlightVariant(store);\n   180\t    const { filePath, sdk } = fixture;\n   181\t\n   182\t    // The cascade contract's exact cleared set: the prompt's own smoothing,\n   183\t    // t2's two turn forms, c1's two chunk summaries.\n   184\t    const clearedKeys = fixture.mutation.cleared\n   185\t      .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\n   186\t      .sort();\n   187\t    expect(clearedKeys).toEqual(\n   188\t      [\n   189\t        `message:${fixture.editedMessageId}:smoothed_prompt`,\n   190\t        \"turn:t2:turn_rendering\",\n   191\t        \"turn:t2:lower_band_projection\",\n   192\t        \"chunk:c1:chunk_summary_detailed\",\n   193\t        \"chunk:c1:chunk_summary_brief\",\n   194\t      ].sort(),\n   195\t    );\n   196\t\n   197\t    const before = valueOf(await expectReadOnly(filePath, () => sdk.inspect.health({ filePath })));\n   198\t    // The cleared set reads pending — one per owner/kind — with its queued\n   199\t    // replacement work visible, and every form outside the cascade still\n   200\t    // ready (failures-free fixture: full counts minus the cascade).\n   201\t    expect(before.owners).toEqual([\n   202\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 11, pending: 1 } },\n   203\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n   204\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 8 } },\n   205\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 2, pending: 1 } },\n   206\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 2, pending: 1 } },\n   207\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 11, pending: 1 } },\n   208\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 11, pending: 1 } },\n   209\t    ]);\n   210\t    // Queued work visible and consistent: 4 replacement items — smoothing,\n   211\t    // turn derivation (two forms), two chunk summaries — join onto the 5\n   212\t    // pending entries.\n   213\t    expect(before.queue).toEqual({ queued: 5, claimed: 0 });\n   214\t    expect(before.failures).toEqual([]);\n   215\t    expect(before.repairPreview).toEqual([]);\n   216\t\n   217\t    // The exact pending subjects per the cascade contract, read through the\n   218\t    // owners' surfaces health composes.\n   219\t    const messagesPending = await sdk.messages.report({ filePath }, { notReady: true });\n   220\t    const turnsPending = await sdk.turns.report({ filePath }, { notReady: true });\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/capture/reattach-idempotency.test.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Story 2 — SV-001 regression: existing-thread resume/reload must keep recording\n     2\t// new finalized events. The connector seeds its capture counters from the\n     3\t// thread's durable committed state at attach, so a fresh connector's idempotency\n     4\t// keys continue past the prior session's instead of restarting at 0 and\n     5\t// skipping new events as false duplicates — while the converter's same-key\n     6\t// dedup (the reload/replay safety net) stays intact.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  createDeterministicProvider,\n    10\t  intakeStream,\n    11\t  type MessageEventInput,\n    12\t  type ThreadRef,\n    13\t} from \"lhc\";\n    14\timport { capture } from \"../../src/capture/converter.js\";\n    15\timport { mapMessage } from \"../../src/capture/map-message.js\";\n    16\timport { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\n    17\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n    18\timport {\n    19\t  makeAgentEnd,\n    20\t  makeAssistantMessage,\n    21\t  makeMessageEnd,\n    22\t  makeUserMessage,\n    23\t} from \"../fixtures/synthetic.js\";\n    24\timport { makeTempThread, tempStore, type TempStore } from \"../fixtures/thread.js\";\n    25\timport { attachCapture, eventsAfterShutdown, kindsOf, startCapture, turnCounts } from \"./support.js\";\n    26\t\n    27\tlet store: TempStore;\n    28\tbeforeEach(() => {\n    29\t  store = tempStore();\n    30\t});\n    31\tafterEach(() => {\n    32\t  store.cleanup();\n    33\t});\n    34\t\n    35\tfunction textOf(event: MessageEventInput): string {\n    36\t  return (event.payload as { text?: string }).text ?? \"\";\n    37\t}\n    38\t\n    39\tfunction userTexts(events: readonly MessageEventInput[]): string[] {\n    40\t  return events.filter((event) => event.eventKind === \"user_prompt\").map(textOf);\n    41\t}\n    42\t\n    43\tfunction threadIdOf(ref: ThreadRef): string {\n    44\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n    45\t  return ref.threadId;\n    46\t}\n    47\t\n    48\tdescribe(\"Story 2: existing-thread reattach idempotency (SV-001)\", () => {\n    49\t  it(\"(1) a fresh connector resuming an existing thread records a new finalized event instead of skipping it\", async () => {\n    50\t    // Session A records one exchange, then shuts down.\n    51\t    const a = await startCapture(store);\n    52\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    53\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    54\t    const threadId = threadIdOf(a.threadRef);\n    55\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n    56\t\n    57\t    // A brand-new connector attaches to the SAME thread by id and records a new\n    58\t    // message — it must NOT be skipped as a prior-key collision.\n    59\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n    60\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    61\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\n    62\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    63\t    expect(b.connector.snapshot().lastDiagnostic).toBeNull();\n    64\t\n    65\t    const events = await eventsAfterShutdown(b);\n    66\t    expect(userTexts(events)).toEqual([\"first\", \"second after resume\"]);\n    67\t    const counts = await turnCounts(b.threadRef);\n    68\t    expect(counts.closed).toBe(2);\n    69\t  });\n    70\t\n    71\t  it(\"(2) a reload onto an existing thread also continues recording new finalized events\", async () => {\n    72\t    const a = await startCapture(store);\n    73\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    74\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    75\t    const threadId = threadIdOf(a.threadRef);\n    76\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    77\t\n    78\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    79\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after reload\")));\n    80\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    81\t\n    82\t    const events = await eventsAfterShutdown(b);\n    83\t    expect(userTexts(events)).toEqual([\"first\", \"second after reload\"]);\n    84\t    const counts = await turnCounts(b.threadRef);\n    85\t    expect(counts.closed).toBe(2);\n    86\t  });\n    87\t\n    88\t  it(\"(2b) a reload re-delivering the same logical events skips them instead of recording duplicates\", async () => {\n    89\t    const a = await startCapture(store);\n    90\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    91\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n    92\t    const threadId = threadIdOf(a.threadRef);\n    93\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"reload\" });\n    94\t\n    95\t    const b = await attachCapture(store, { session: threadId }, \"reload\");\n    96\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n    97\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n    98\t\n    99\t    const events = await eventsAfterShutdown(b);\n   100\t    expect(kindsOf(events)).toEqual([\"user_prompt\", \"turn_end\"]);\n   101\t    expect(userTexts(events)).toEqual([\"first\"]);\n   102\t    const counts = await turnCounts(b.threadRef);\n   103\t    expect(counts.closed).toBe(1);\n   104\t\n   105\t    const built = await initInstance(b.threadRef, {\n   106\t      provider: createDeterministicProvider(),\n   107\t      mode: \"background\",\n   108\t    });\n   109\t    expect(built.ok).toBe(true);\n   110\t    if (!built.ok) return;\n   111\t    const instance = built.value;\n   112\t    const acc = new TurnAccumulator({ piSessionId: threadId });\n   113\t    const userEvents = mapMessage(makeUserMessage(\"first\"), { piSessionId: threadId });\n   114\t    acc.onMessage(userEvents);\n   115\t    const turnEnd = acc.onAgentEnd();\n   116\t    const replay = await capture([...userEvents, ...turnEnd], instance);\n   117\t    expect(replay.ok).toBe(true);\n   118\t    if (replay.ok) {\n   119\t      expect(replay.value.events).toEqual([\n   120\t        {\n   121\t          idempotencyKey: userEvents[0]!.idempotencyKey,\n   122\t          outcome: \"skipped\",\n   123\t          skipReason: \"duplicate_idempotency_key\",\n   124\t        },\n   125\t        {\n   126\t          idempotencyKey: turnEnd[0]!.idempotencyKey,\n   127\t          outcome: \"skipped\",\n   128\t          skipReason: \"duplicate_idempotency_key\",\n   129\t        },\n   130\t      ]);\n   131\t    }\n   132\t    await instance.dispose();\n   133\t  });\n   134\t\n   135\t  it(\"(3) normal resume records new messages and does not duplicate the prior session's history\", async () => {\n   136\t    // Session A: one complete turn.\n   137\t    const a = await startCapture(store);\n   138\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\n   139\t    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer one\" })));\n   140\t    await a.connector.handlers.agent_end(a.ctx, makeAgentEnd([]));\n   141\t    const threadId = threadIdOf(a.threadRef);\n   142\t    await a.connector.handlers.session_shutdown(a.ctx, { reason: \"shutdown\" });\n   143\t\n   144\t    // Resume: PI does not re-fire history, so the connector sees only the new\n   145\t    // turn — which must record, leaving the prior turn intact and un-duplicated.\n   146\t    const b = await attachCapture(store, { session: threadId }, \"resume\");\n   147\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second\")));\n   148\t    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer two\" })));\n   149\t    await b.connector.handlers.agent_end(b.ctx, makeAgentEnd([]));\n   150\t\n   151\t    const events = await eventsAfterShutdown(b);\n   152\t    expect(kindsOf(events)).toEqual([\n   153\t      \"user_prompt\",\n   154\t      \"assistant_text\",\n   155\t      \"turn_end\",\n   156\t      \"user_prompt\",\n   157\t      \"assistant_text\",\n   158\t      \"turn_end\",\n   159\t    ]);\n   160\t    expect(userTexts(events)).toEqual([\"first\", \"second\"]);\n   161\t    // Two distinct closed turns — the turn_end keys did not collide either.\n   162\t    const counts = await turnCounts(b.threadRef);\n   163\t    expect(counts.closed).toBe(2);\n   164\t    expect(counts.open).toBe(0);\n   165\t  });\n   166\t\n   167\t  it(\"(4) preserves duplicate-safe re-delivery: re-flushing an identical batch is skipped, not duplicated\", async () => {\n   168\t    const thread = await makeTempThread(store);\n   169\t    const built = await initInstance(thread.threadRef, {\n   170\t      provider: createDeterministicProvider(),\n   171\t      mode: \"background\",\n   172\t    });\n   173\t    expect(built.ok).toBe(true);\n   174\t    if (!built.ok) return;\n   175\t    const instance = built.value;\n   176\t\n   177\t    // Build one turn's events with stable keys, then deliver the SAME batch\n   178\t    // twice — the second delivery (the reload / crash-replay shape) must dedup.\n   179\t    const acc = new TurnAccumulator({ piSessionId: \"sess\" });\n   180\t    const userEvents = mapMessage(makeUserMessage(\"hello\"), { piSessionId: \"sess\", entryId: \"s0\" });\n   181\t    acc.onMessage(userEvents);\n   182\t    const batch = [...userEvents, ...acc.onAgentEnd()];\n   183\t\n   184\t    const first = await capture(batch, instance);\n   185\t    expect(first.ok).toBe(true);\n   186\t    if (first.ok) expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n   187\t\n   188\t    const second = await capture(batch, instance);\n   189\t    expect(second.ok).toBe(true);\n   190\t    if (second.ok) expect(second.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   191\t\n   192\t    const read = await intakeStream.listEvents(instance.threadRef);\n   193\t    expect(read.ok).toBe(true);\n   194\t    if (read.ok) expect(read.value).toHaveLength(batch.length);\n   195\t\n   196\t    await instance.dispose();\n   197\t  });\n   198\t});\n","exit_code":0,"status":"completed"}}

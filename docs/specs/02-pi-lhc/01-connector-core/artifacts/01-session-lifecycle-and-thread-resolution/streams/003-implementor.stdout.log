{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HuXq8qXisvz366K73c2MJW","type":"tool_result","content":"1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n2\t\n3\texport type ErrorCode =\n4\t  | \"path_exists\"\n5\t  | \"thread_not_found\"\n6\t  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n7\t  | \"invalid_event\"\n8\t  | \"empty_batch\"\n9\t  | \"turn_state_corrupt\"\n10\t  | \"storage_failure\"\n11\t  // Epic 02 (tech design §Interfaces, issue 4):\n12\t  | \"turn_open\" // caller_error — mutation against an open turn\n13\t  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n14\t  | \"message_not_found\" // caller_error\n15\t  | \"turn_not_found\" // caller_error\n16\t  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n17\t  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n18\t  | \"source_damaged\" // state_corruption — handler found corrupt source; form blocked\n19\t  // Epic 03 (tech design §Interface Definitions): the surface-skeleton stub\n20\t  // contract — machine-readable, never a throw on the thread-view surface.\n21\t  | \"not_implemented\" // system_error — operation's story has not landed yet\n22\t  // Epic 03 Story 2 (AC-2.2/2.3): compact-time config rejection — unlike SDK\n23\t  // construction (programmer error, throws), a bad compact invocation is an\n24\t  // operational caller error returned as a result.\n25\t  | \"unknown_profile\" // caller_error — named profile not configured\n26\t  | \"invalid_view_config\" // caller_error — band sum / bound violation, named\n27\t  // Epic 03 Story 5: materialize accepts pi-session only; an unknown format\n28\t  // is a caller error naming the accepted values (story Scope).\n29\t  | \"unknown_format\" // caller_error — materialize format not supported\n30\t  // Epic 04 Story 1: bounded listing — a bad bounds option (from > to,\n31\t  // limit < 1, non-integer) is an operational caller error returned as a\n32\t  // result, mirroring the compact-params precedent (additive code, the\n33\t  // Epic 03 deviation pattern).\n34\t  | \"invalid_bounds\"; // caller_error — listMessages bounds option rejected\n35\t\n36\texport interface ErrorResult {\n37\t  errorClass: ErrorClass;\n38\t  code: ErrorCode;\n39\t  reason: string; // human-readable; machine logic switches on code\n40\t  eventIndex?: number; // present on batch validation failures\n41\t}\n42\t\n43\t// Expected operational failures — caller errors, corruption, environment\n44\t// failures — are always returned as OpResult errors, never thrown.\n45\t// Programmer bugs inside lhc may still throw; callers are not expected\n46\t// to handle throws as contract outcomes.\n47\texport type OpResult<T> =\n48\t  | { ok: true; value: T }\n49\t  | { ok: false; error: ErrorResult };\n50\t\n51\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n52\t// caught at the operation boundary and wrapped with the underlying detail.\n53\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n54\t  return {\n55\t    ok: false,\n56\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n57\t  };\n58\t}\n59\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"34e73934-8562-4cb2-a8e7-91f0b64ab612","timestamp":"2026-06-14T04:04:36.322Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/errors.ts","content":"export type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n\nexport type ErrorCode =\n  | \"path_exists\"\n  | \"thread_not_found\"\n  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n  | \"invalid_event\"\n  | \"empty_batch\"\n  | \"turn_state_corrupt\"\n  | \"storage_failure\"\n  // Epic 02 (tech design §Interfaces, issue 4):\n  | \"turn_open\" // caller_error — mutation against an open turn\n  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n  | \"message_not_found\" // caller_error\n  | \"turn_not_found\" // caller_error\n  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n  | \"source_damaged\" // state_corruption — handler found corrupt source; form blocked\n  // Epic 03 (tech design §Interface Definitions): the surface-skeleton stub\n  // contract — machine-readable, never a throw on the thread-view surface.\n  | \"not_implemented\" // system_error — operation's story has not landed yet\n  // Epic 03 Story 2 (AC-2.2/2.3): compact-time config rejection — unlike SDK\n  // construction (programmer error, throws), a bad compact invocation is an\n  // operational caller error returned as a result.\n  | \"unknown_profile\" // caller_error — named profile not configured\n  | \"invalid_view_config\" // caller_error — band sum / bound violation, named\n  // Epic 03 Story 5: materialize accepts pi-session only; an unknown format\n  // is a caller error naming the accepted values (story Scope).\n  | \"unknown_format\" // caller_error — materialize format not supported\n  // Epic 04 Story 1: bounded listing — a bad bounds option (from > to,\n  // limit < 1, non-integer) is an operational caller error returned as a\n  // result, mirroring the compact-params precedent (additive code, the\n  // Epic 03 deviation pattern).\n  | \"invalid_bounds\"; // caller_error — listMessages bounds option rejected\n\nexport interface ErrorResult {\n  errorClass: ErrorClass;\n  code: ErrorCode;\n  reason: string; // human-readable; machine logic switches on code\n  eventIndex?: number; // present on batch validation failures\n}\n\n// Expected operational failures — caller errors, corruption, environment\n// failures — are always returned as OpResult errors, never thrown.\n// Programmer bugs inside lhc may still throw; callers are not expected\n// to handle throws as contract outcomes.\nexport type OpResult<T> =\n  | { ok: true; value: T }\n  | { ok: false; error: ErrorResult };\n\n// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n// caught at the operation boundary and wrapped with the underlying detail.\nexport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n  };\n}\n","numLines":59,"startLine":1,"totalLines":59}}}

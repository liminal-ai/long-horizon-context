{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HuqoctC6TYucCgbmEK4Yvu","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. It owns no state beyond the plain-data `SessionState` (and, later, an\n4\t// `LhcInstance`) held in the connector closure — never a PI `ctx`/session\n5\t// object (tech design Flow 1, plain-data rule).\n6\timport type {\n7\t  ExtensionAPI,\n8\t  PiHookHandler,\n9\t  PiHookName,\n10\t} from \"./pi/types.js\";\n11\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n12\t\n13\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n14\texport type { LhcInstance } from \"./shared/instance.js\";\n15\t\n16\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n17\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n18\t *  registers no handler for it (story Scope Out). */\n19\texport const EPIC_1_HOOKS = [\n20\t  \"session_start\",\n21\t  \"message_end\",\n22\t  \"turn_end\",\n23\t  \"agent_end\",\n24\t  \"model_select\",\n25\t  \"thinking_level_select\",\n26\t  \"session_before_fork\",\n27\t  \"session_before_switch\",\n28\t  \"session_shutdown\",\n29\t] as const satisfies readonly PiHookName[];\n30\t\n31\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n32\t\n33\t/** Everything the connector retains across hooks — all plain data, by\n34\t *  construction structuredClone-able. There is no field that could hold a PI\n35\t *  object. */\n36\texport interface ConnectorSnapshot {\n37\t  state: SessionState | null;\n38\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n39\t}\n40\t\n41\texport interface Connector {\n42\t  /** Register the observe-only hook rail on the PI extension API. */\n43\t  register(pi: ExtensionAPI): void;\n44\t  /** The plain-data state retained across hooks. `null` until a session\n45\t   *  resolves a thread (Story 1); never holds a PI ctx. */\n46\t  getState(): SessionState | null;\n47\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n48\t  snapshot(): ConnectorSnapshot;\n49\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n50\t   *  synthetic ctx/events without a live PI. Each accepts any Epic 1 event\n51\t   *  (the foundation handlers are uniform no-ops). */\n52\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n53\t}\n54\t\n55\t/** Build a connector instance. Its mutable state lives in this closure; the\n56\t *  registered handlers capture it, so the instance stays live for the session\n57\t *  even when `activate` discards the returned object. */\n58\texport function createConnector(): Connector {\n59\t  // The connector's ENTIRE retained state. Both are plain data and are the only\n60\t  // things that survive between hooks. `state` stays null in Epic 1 Story 0\n61\t  // (thread resolution is fail-closed until Story 1); Story 1 populates it via\n62\t  // createSessionState once a thread resolves.\n63\t  let state: SessionState | null = null;\n64\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n65\t\n66\t  // Contain every handler: an observe-only hook must never throw back into PI\n67\t  // (a thrown hook breaks the user's session). A caught error becomes a\n68\t  // plain-data diagnostic; it is never rethrown.\n69\t  const guard = (\n70\t    name: Epic1Hook,\n71\t    body: PiHookHandler<Epic1Hook>,\n72\t  ): PiHookHandler<Epic1Hook> => {\n73\t    return async (ctx, event): Promise<void> => {\n74\t      try {\n75\t        await body(ctx, event);\n76\t      } catch (err) {\n77\t        lastDiagnostic = {\n78\t          code: \"hook_handler_error\",\n79\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n80\t          recordedGap: false,\n81\t        };\n82\t      }\n83\t    };\n84\t  };\n85\t\n86\t  // Observe-only foundation: every hook routes to a no-op that receives a FRESH\n87\t  // ctx and retains none of it.\n88\t  const noop: PiHookHandler<Epic1Hook> = () => {\n89\t    // Intentionally empty — later stories replace this with real routing.\n90\t  };\n91\t\n92\t  // Story 0 routes each hook to a fail-closed no-op: the rail is real and routes\n93\t  // to a handler, but no capture / resolution / derivation happens or is faked\n94\t  // yet. The accumulator is filled for every hook in the loop below.\n95\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n96\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, noop);\n97\t\n98\t  return {\n99\t    handlers,\n100\t    register(pi: ExtensionAPI): void {\n101\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n102\t    },\n103\t    getState(): SessionState | null {\n104\t      return state;\n105\t    },\n106\t    snapshot(): ConnectorSnapshot {\n107\t      return { state, lastDiagnostic };\n108\t    },\n109\t  };\n110\t}\n111\t\n112\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n113\t *  loads (and again on `/reload`). Registers the observe-only hook rail. */\n114\texport function activate(pi: ExtensionAPI): void {\n115\t  createConnector().register(pi);\n116\t}\n117\t\n118\texport default activate;\n119\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"5bf6318b-77dd-42ac-9d65-0caadabbc9b2","timestamp":"2026-06-14T04:03:47.467Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. It owns no state beyond the plain-data `SessionState` (and, later, an\n// `LhcInstance`) held in the connector closure — never a PI `ctx`/session\n// object (tech design Flow 1, plain-data rule).\nimport type {\n  ExtensionAPI,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** Everything the connector retains across hooks — all plain data, by\n *  construction structuredClone-able. There is no field that could hold a PI\n *  object. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread (Story 1); never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. Each accepts any Epic 1 event\n   *  (the foundation handlers are uniform no-ops). */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. */\nexport function createConnector(): Connector {\n  // The connector's ENTIRE retained state. Both are plain data and are the only\n  // things that survive between hooks. `state` stays null in Epic 1 Story 0\n  // (thread resolution is fail-closed until Story 1); Story 1 populates it via\n  // createSessionState once a thread resolves.\n  let state: SessionState | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: every hook routes to a no-op that receives a FRESH\n  // ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — later stories replace this with real routing.\n  };\n\n  // Story 0 routes each hook to a fail-closed no-op: the rail is real and routes\n  // to a handler, but no capture / resolution / derivation happens or is faked\n  // yet. The accumulator is filled for every hook in the loop below.\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, noop);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":119,"startLine":1,"totalLines":119}}}

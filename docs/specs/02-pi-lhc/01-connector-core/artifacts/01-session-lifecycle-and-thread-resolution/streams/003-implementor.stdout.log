{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Psk8pVVcUf3bkDbL8ds7Hj","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Zero-dependency import-boundary check for the pi-lhc connector.\n3\t//\n4\t// The connector has four surfaces under src/ — lifecycle, capture, inference,\n5\t// verify — plus two leaf areas (pi/ external type declarations, shared/\n6\t// cross-cutting helpers) and the composition root index.ts. The rules keep the\n7\t// surfaces from leaking into each other so a later story cannot quietly couple,\n8\t// say, inference to capture:\n9\t//   1. index.ts is the composition root — it may import any surface.\n10\t//   2. pi/ and shared/ are leaves — they may NOT import from a surface (they\n11\t//      hold only external type declarations and helpers every surface uses).\n12\t//   3. A surface may import another surface ONLY along a pinned edge in\n13\t//      ALLOWED_SURFACE_IMPORTS — a new cross-surface edge is a conscious\n14\t//      decision, never a silent pass. Importing pi/ or shared/ is always fine.\n15\t// Only src/ is subject to surface rules; test/ files are consumers that drive\n16\t// the code across surfaces by design.\n17\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n18\timport path from \"node:path\";\n19\timport { fileURLToPath } from \"node:url\";\n20\t\n21\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n22\tconst srcRoot = path.join(pkgRoot, \"src\");\n23\t\n24\tconst SURFACES = new Set([\"lifecycle\", \"capture\", \"inference\", \"verify\"]);\n25\tconst LEAF_DIRS = new Set([\"pi\", \"shared\"]);\n26\t\n27\t// The pinned surface→surface dependency edges (rule 3). Each is a deliberate\n28\t// architectural seam from the Epic 1 tech design (§Module Architecture):\n29\t//   - lifecycle → capture : fork.ts replay-seeds a new thread through the\n30\t//     converter (Flow 3, Story 4).\n31\t//   - verify → capture    : replay.ts drives the converter on a corpus\n32\t//     (Flow 6, Story 3).\n33\t//   - inference → lifecycle: startup-validation.report() writes its diagnostic\n34\t//     into SessionState (Flow 5, Story 6).\n35\t// No cycle: inference → lifecycle → capture, and verify → capture.\n36\tconst ALLOWED_SURFACE_IMPORTS = {\n37\t  lifecycle: new Set([\"capture\"]),\n38\t  capture: new Set([]),\n39\t  inference: new Set([\"lifecycle\"]),\n40\t  verify: new Set([\"capture\"]),\n41\t};\n42\t\n43\tfunction collectTsFiles(dir, out = []) {\n44\t  let entries;\n45\t  try {\n46\t    entries = readdirSync(dir);\n47\t  } catch {\n48\t    return out;\n49\t  }\n50\t  for (const entry of entries) {\n51\t    const full = path.join(dir, entry);\n52\t    if (statSync(full).isDirectory()) collectTsFiles(full, out);\n53\t    else if (full.endsWith(\".ts\")) out.push(full);\n54\t  }\n55\t  return out;\n56\t}\n57\t\n58\tfunction importSpecifiers(source) {\n59\t  const specs = [];\n60\t  const patterns = [\n61\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n62\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n63\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n64\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n65\t  ];\n66\t  for (const re of patterns) {\n67\t    let m;\n68\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n69\t  }\n70\t  return specs;\n71\t}\n72\t\n73\tfunction topPartOf(filePath) {\n74\t  const rel = path.relative(srcRoot, filePath);\n75\t  const parts = rel.split(path.sep);\n76\t  return { rel, parts, top: parts[0] };\n77\t}\n78\t\n79\tconst files = collectTsFiles(srcRoot);\n80\tconst violations = [];\n81\t\n82\tfor (const file of files) {\n83\t  const { parts, top } = topPartOf(file);\n84\t  const isRootEntry = parts.length === 1; // src/index.ts and any other root file\n85\t  const fileSurface = SURFACES.has(top) ? top : null;\n86\t  const isLeaf = LEAF_DIRS.has(top);\n87\t  const source = readFileSync(file, \"utf8\");\n88\t\n89\t  for (const spec of importSpecifiers(source)) {\n90\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n91\t    const resolved = path.resolve(path.dirname(file), spec);\n92\t    const relToSrc = path.relative(srcRoot, resolved);\n93\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n94\t    const targetTop = relToSrc.split(path.sep)[0];\n95\t    const targetSurface = SURFACES.has(targetTop) ? targetTop : null;\n96\t    if (targetSurface === null) continue; // importing a leaf (pi/shared) — always allowed\n97\t\n98\t    if (isRootEntry) continue; // composition root may wire any surface\n99\t    if (isLeaf) {\n100\t      violations.push(\n101\t        `${path.relative(pkgRoot, file)} imports ${spec} — leaf \"${top}/\" may not import surface \"${targetSurface}\"`,\n102\t      );\n103\t      continue;\n104\t    }\n105\t    if (fileSurface === null) continue; // not a surface, not a leaf, not root — nothing to enforce\n106\t    if (fileSurface === targetSurface) continue; // intra-surface — allowed\n107\t    const allowed = ALLOWED_SURFACE_IMPORTS[fileSurface];\n108\t    if (allowed === undefined || !allowed.has(targetSurface)) {\n109\t      violations.push(\n110\t        `${path.relative(pkgRoot, file)} imports ${spec} — surface \"${fileSurface}\" has no pinned edge to \"${targetSurface}\" (rule 3)`,\n111\t      );\n112\t    }\n113\t  }\n114\t}\n115\t\n116\tif (violations.length > 0) {\n117\t  console.error(\"boundary check FAILED:\");\n118\t  for (const v of violations) console.error(`  - ${v}`);\n119\t  process.exit(1);\n120\t}\n121\tconsole.log(`boundaries: OK (${files.length} src files checked)`);\n122\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"703264a2-73e7-4fc0-9c93-ee24790a7e19","timestamp":"2026-06-14T04:10:55.043Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/scripts/check-boundaries.mjs","content":"#!/usr/bin/env node\n// Zero-dependency import-boundary check for the pi-lhc connector.\n//\n// The connector has four surfaces under src/ — lifecycle, capture, inference,\n// verify — plus two leaf areas (pi/ external type declarations, shared/\n// cross-cutting helpers) and the composition root index.ts. The rules keep the\n// surfaces from leaking into each other so a later story cannot quietly couple,\n// say, inference to capture:\n//   1. index.ts is the composition root — it may import any surface.\n//   2. pi/ and shared/ are leaves — they may NOT import from a surface (they\n//      hold only external type declarations and helpers every surface uses).\n//   3. A surface may import another surface ONLY along a pinned edge in\n//      ALLOWED_SURFACE_IMPORTS — a new cross-surface edge is a conscious\n//      decision, never a silent pass. Importing pi/ or shared/ is always fine.\n// Only src/ is subject to surface rules; test/ files are consumers that drive\n// the code across surfaces by design.\nimport { readdirSync, readFileSync, statSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst srcRoot = path.join(pkgRoot, \"src\");\n\nconst SURFACES = new Set([\"lifecycle\", \"capture\", \"inference\", \"verify\"]);\nconst LEAF_DIRS = new Set([\"pi\", \"shared\"]);\n\n// The pinned surface→surface dependency edges (rule 3). Each is a deliberate\n// architectural seam from the Epic 1 tech design (§Module Architecture):\n//   - lifecycle → capture : fork.ts replay-seeds a new thread through the\n//     converter (Flow 3, Story 4).\n//   - verify → capture    : replay.ts drives the converter on a corpus\n//     (Flow 6, Story 3).\n//   - inference → lifecycle: startup-validation.report() writes its diagnostic\n//     into SessionState (Flow 5, Story 6).\n// No cycle: inference → lifecycle → capture, and verify → capture.\nconst ALLOWED_SURFACE_IMPORTS = {\n  lifecycle: new Set([\"capture\"]),\n  capture: new Set([]),\n  inference: new Set([\"lifecycle\"]),\n  verify: new Set([\"capture\"]),\n};\n\nfunction collectTsFiles(dir, out = []) {\n  let entries;\n  try {\n    entries = readdirSync(dir);\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    const full = path.join(dir, entry);\n    if (statSync(full).isDirectory()) collectTsFiles(full, out);\n    else if (full.endsWith(\".ts\")) out.push(full);\n  }\n  return out;\n}\n\nfunction importSpecifiers(source) {\n  const specs = [];\n  const patterns = [\n    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n  ];\n  for (const re of patterns) {\n    let m;\n    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n  }\n  return specs;\n}\n\nfunction topPartOf(filePath) {\n  const rel = path.relative(srcRoot, filePath);\n  const parts = rel.split(path.sep);\n  return { rel, parts, top: parts[0] };\n}\n\nconst files = collectTsFiles(srcRoot);\nconst violations = [];\n\nfor (const file of files) {\n  const { parts, top } = topPartOf(file);\n  const isRootEntry = parts.length === 1; // src/index.ts and any other root file\n  const fileSurface = SURFACES.has(top) ? top : null;\n  const isLeaf = LEAF_DIRS.has(top);\n  const source = readFileSync(file, \"utf8\");\n\n  for (const spec of importSpecifiers(source)) {\n    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n    const resolved = path.resolve(path.dirname(file), spec);\n    const relToSrc = path.relative(srcRoot, resolved);\n    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n    const targetTop = relToSrc.split(path.sep)[0];\n    const targetSurface = SURFACES.has(targetTop) ? targetTop : null;\n    if (targetSurface === null) continue; // importing a leaf (pi/shared) — always allowed\n\n    if (isRootEntry) continue; // composition root may wire any surface\n    if (isLeaf) {\n      violations.push(\n        `${path.relative(pkgRoot, file)} imports ${spec} — leaf \"${top}/\" may not import surface \"${targetSurface}\"`,\n      );\n      continue;\n    }\n    if (fileSurface === null) continue; // not a surface, not a leaf, not root — nothing to enforce\n    if (fileSurface === targetSurface) continue; // intra-surface — allowed\n    const allowed = ALLOWED_SURFACE_IMPORTS[fileSurface];\n    if (allowed === undefined || !allowed.has(targetSurface)) {\n      violations.push(\n        `${path.relative(pkgRoot, file)} imports ${spec} — surface \"${fileSurface}\" has no pinned edge to \"${targetSurface}\" (rule 3)`,\n      );\n    }\n  }\n}\n\nif (violations.length > 0) {\n  console.error(\"boundary check FAILED:\");\n  for (const v of violations) console.error(`  - ${v}`);\n  process.exit(1);\n}\nconsole.log(`boundaries: OK (${files.length} src files checked)`);\n","numLines":122,"startLine":1,"totalLines":122}}}

{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01R8Wi1fmD5GDkYAW4A8sQDR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012MvbYX8tEKxKQyhN8QrFd8","name":"Write","input":{"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/instance.test.ts","content":"// Story 1 — instance lifecycle (TC-1.1, TC-1.4). Driven through the real\n// lifecycle functions against a real temp registry + thread (the store is never\n// mocked; persistence/reattach are the product contract). The SDK is built with\n// the deterministic provider — a valid construction that needs no real\n// inference, which the inference host (Stories 5/6) supplies in production.\nimport { existsSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport { resolveThread } from \"../../src/lifecycle/thread-resolution.js\";\nimport { eventBatch } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\ndescribe(\"Story 1: instance lifecycle\", () => {\n  it(\"TC-1.1: a no-flag launch creates one cwd-registered thread and one background instance\", async () => {\n    const cwd = \"/work/tc-1-1\";\n    const resolved = await resolveThread(\n      {},\n      { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    // Exactly one thread registered, and its registry row carries the cwd.\n    const all = await threads.listThreads({ registryPath: store.registryPath });\n    expect(all.ok).toBe(true);\n    if (all.ok) expect(all.value).toHaveLength(1);\n\n    const row = await threads.resolve({ threadId, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    expect(row.value.cwd).toBe(cwd);\n    expect(existsSync(row.value.filePath)).toBe(true); // a real thread file exists\n\n    // One instance, in background scheduler mode. Background mode means the\n    // scheduler auto-drains; the connector never calls drain/drainSettled during\n    // startup (initInstance only validates the thread), so it does not drive the\n    // queue itself (AC-1.1).\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n    expect(built.value.sdk.config.mode).toBe(\"background\");\n    expect(idOf(built.value.threadRef)).toBe(threadId);\n\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n  });\n\n  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n    const resolved = await resolveThread(\n      {},\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n\n    // Capture N raw intake events through the instance (the converter is Story 2;\n    // the lifecycle proof needs only that recorded events survive shutdown).\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n    expect(captured.ok).toBe(true);\n\n    // Dispose with flush.\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n\n    // Reattach: resolve the same thread by id (no retained instance) and read\n    // back — every pre-shutdown event is present, no trailing loss.\n    const reattached = await resolveThread(\n      { session: threadId },\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10880,"cache_read_input_tokens":287371,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10880},"output_tokens":36,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"c0058d55-4e45-422d-8442-80e75d4dcf87","request_id":"req_011Cc2Xh5AqyuAjpLHt75FTB"}

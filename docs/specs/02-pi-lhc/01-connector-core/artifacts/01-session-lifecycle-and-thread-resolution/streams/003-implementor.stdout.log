{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Le4h2bwhZMaVrZVjarMq5c","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\texport * as threadView from \"./domains/thread-view/index.js\";\n6\texport * as inspect from \"./domains/inspect/index.js\";\n7\t\n8\timport * as inspectDomain from \"./domains/inspect/index.js\";\n9\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n10\timport * as threadViewDomain from \"./domains/thread-view/index.js\";\n11\timport { resolveViewConfig } from \"./domains/thread-view/index.js\";\n12\timport * as messagesDomain from \"./domains/messages/index.js\";\n13\timport * as threadsDomain from \"./domains/threads/index.js\";\n14\timport * as turnsDomain from \"./domains/turns/index.js\";\n15\timport {\n16\t  createScheduler,\n17\t  peekThreadId,\n18\t  runDrain,\n19\t  type DrainDeps,\n20\t  type DrainReport,\n21\t  type Scheduler,\n22\t} from \"./scheduler.js\";\n23\timport {\n24\t  runWithInstanceSeam,\n25\t  setSchedulerPoke as installSchedulerPoke,\n26\t  setThreadTouch,\n27\t  type InstanceSeam,\n28\t} from \"./shared/context.js\";\n29\timport { createInferenceProvider } from \"./inference/adapter.js\";\n30\timport { PROMPT_REGISTRY } from \"./inference/prompts/index.js\";\n31\timport type { InferenceConfig, ModelAssignment } from \"./inference/types.js\";\n32\timport {\n33\t  FORM_KINDS,\n34\t  PROVIDER_OPERATIONS,\n35\t  type DerivationProvider,\n36\t  type FormKind,\n37\t  type ResolvedSdkConfig,\n38\t  type SdkConfig,\n39\t  type WorkHandler,\n40\t} from \"./shared/derivation.js\";\n41\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n42\timport type {\n43\t  CompactReceipt,\n44\t  PullResult,\n45\t  StoredView,\n46\t  SweepReceipt,\n47\t  ViewCompactParams,\n48\t  ViewProfile,\n49\t  ViewStatus,\n50\t} from \"./shared/view.js\";\n51\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n52\t\n53\texport {\n54\t  estimateTokens,\n55\t  TOKEN_ESTIMATOR_ID,\n56\t} from \"./tech-utils/token-counting/index.js\";\n57\t\n58\texport {\n59\t  WORK_KIND_REGISTRY,\n60\t  type WorkItemRecord,\n61\t  type WorkKind,\n62\t  type WorkOwner,\n63\t  type WorkSourceRef,\n64\t} from \"./tech-utils/work-queue/index.js\";\n65\t\n66\texport type {\n67\t  ErrorClass,\n68\t  ErrorCode,\n69\t  ErrorResult,\n70\t  OpResult,\n71\t} from \"./shared/errors.js\";\n72\texport {\n73\t  runInTransaction,\n74\t  setSchedulerPoke,\n75\t  setThreadTouch,\n76\t  type OperationContext,\n77\t} from \"./shared/context.js\";\n78\t\n79\texport {\n80\t  createDeterministicProvider,\n81\t  deterministicOutcomesSuffix,\n82\t  deterministicReceiptsSuffix,\n83\t  deterministicText,\n84\t  type DeterministicOpName,\n85\t} from \"./providers/deterministic.js\";\n86\texport type {\n87\t  CompletionTx,\n88\t  DependencyGap,\n89\t  DerivationProvider,\n90\t  DerivedForm,\n91\t  DerivedFormMetadata,\n92\t  DerivedFormState,\n93\t  FormKind,\n94\t  FormReportEntry,\n95\t  HandlerFormWrite,\n96\t  HandlerOutcome,\n97\t  HandlerRunContext,\n98\t  ProviderResult,\n99\t  RenderingPart,\n100\t  ResolvedSdkConfig,\n101\t  SdkConfig,\n102\t  SubjectKind,\n103\t  ToolOutcome,\n104\t  ToolRunReceipt,\n105\t  WorkHandler,\n106\t} from \"./shared/derivation.js\";\n107\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n108\t\n109\t// Epic 05 inference vocabulary (inference/types.ts): the host-supplied\n110\t// ModelCall boundary and the per-kind assignment config — type-only; the\n111\t// adapter and registry are construction internals behind createSdk.\n112\texport type {\n113\t  InferenceConfig,\n114\t  ModelAssignment,\n115\t  ModelCall,\n116\t  ModelCallFailureKind,\n117\t  ModelCallInput,\n118\t  ModelCallResult,\n119\t} from \"./inference/types.js\";\n120\texport type { ProviderProvenance } from \"./shared/derivation.js\";\n121\t\n122\t// The config-selectable prompt-name catalog (E05-NB-2): the full set of names\n123\t// a per-kind assignment may select, and the default name per kind. Exposed so\n124\t// operators discover valid prompt names from the SDK surface without reading\n125\t// source. The registry itself stays a construction internal behind createSdk.\n126\texport {\n127\t  DEFAULT_PROMPT_NAMES,\n128\t  PROMPT_NAMES,\n129\t} from \"./inference/prompts/index.js\";\n130\t\n131\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n132\t// from Story 0; the operation shapes land with Stories 1–5.\n133\texport {\n134\t  BUILT_IN_PROFILES,\n135\t  DEFAULT_COMPACT_THRESHOLD,\n136\t  DEFAULT_VISIBILITY,\n137\t} from \"./domains/thread-view/index.js\";\n138\texport type {\n139\t  Band,\n140\t  CompactReceipt,\n141\t  PullResult,\n142\t  ResolvedViewConfig,\n143\t  SdkViewConfig,\n144\t  StoredView,\n145\t  SweepReceipt,\n146\t  ViewCompactParams,\n147\t  ViewMessage,\n148\t  ViewMeta,\n149\t  ViewProfile,\n150\t  ViewProfileOverride,\n151\t  ViewStatus,\n152\t  VisibilityBudgets,\n153\t} from \"./shared/view.js\";\n154\texport {\n155\t  countLiveItems,\n156\t  enqueue,\n157\t  queueDetail,\n158\t  supersedeQueued,\n159\t  type ClaimedWorkItem,\n160\t  type EnqueueFormTarget,\n161\t  type EnqueueInput,\n162\t  type QueueDetailRow,\n163\t} from \"./tech-utils/work-queue/index.js\";\n164\t\n165\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n166\t// inspect surface serves.\n167\texport type {\n168\t  HealthReport,\n169\t  InspectOverview,\n170\t  ViewContentsReport,\n171\t} from \"./shared/inspect.js\";\n172\t\n173\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n174\texport type {\n175\t  Block,\n176\t  BlockType,\n177\t  MessageDetail,\n178\t  MessageListOptions,\n179\t  MessageRecord,\n180\t  MutationResult,\n181\t} from \"./domains/messages/index.js\";\n182\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n183\texport type {\n184\t  BatchResult,\n185\t  EventKind,\n186\t  EventRecord,\n187\t  MessageEventInput,\n188\t} from \"./domains/intake-stream/index.js\";\n189\t\n190\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n191\t\n192\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n193\t\n194\t// Merge per-domain handler tables into the one join between the queue's\n195\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n196\t// (each kind has exactly one owner) and throws at construction.\n197\texport function assembleWorkHandlerMap(\n198\t  tables: ReadonlyArray<WorkHandlerMap>,\n199\t): WorkHandlerMap {\n200\t  const map: WorkHandlerMap = {};\n201\t  for (const table of tables) {\n202\t    for (const [kind, handler] of Object.entries(table)) {\n203\t      if (map[kind as WorkKind] !== undefined) {\n204\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n205\t      }\n206\t      map[kind as WorkKind] = handler;\n207\t    }\n208\t  }\n209\t  return map;\n210\t}\n211\t\n212\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n213\t  return {\n214\t    ok: false,\n215\t    error: {\n216\t      errorClass: \"state_corruption\",\n217\t      code: \"unknown_work_kind\",\n218\t      reason: `no handler registered for work kind \"${kind}\"`,\n219\t    },\n220\t  };\n221\t}\n222\t\n223\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n224\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n225\texport function lookupWorkHandler(\n226\t  map: WorkHandlerMap,\n227\t  kind: string,\n228\t): OpResult<WorkHandler> {\n229\t  const handler = map[kind as WorkKind];\n230\t  if (handler === undefined) return unknownWorkKind(kind);\n231\t  return { ok: true, value: handler };\n232\t}\n233\t\n234\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n235\t// requeue land in Story 4.\n236\texport interface WorkSurface {\n237\t  drain(\n238\t    ref: threadsDomain.ThreadRef,\n239\t    opts?: { maxItems?: number },\n240\t  ): Promise<OpResult<DrainReport>>;\n241\t}\n242\t\n243\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n244\t// §Interface Definitions): the operations only — the Story 0 config\n245\t// substrate the domain index also carries is construction machinery, not an\n246\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n247\t// inspect domain composes (DD-1).\n248\texport interface ThreadViewSurface {\n249\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n250\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n251\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n252\t  compact(\n253\t    ref: threadsDomain.ThreadRef,\n254\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n255\t  ): Promise<OpResult<CompactReceipt>>;\n256\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n257\t  materialize(\n258\t    ref: threadsDomain.ThreadRef,\n259\t    opts: { path: string; format?: \"pi-session\" },\n260\t  ): Promise<OpResult<{ writtenPath: string }>>;\n261\t}\n262\t\n263\texport interface Lhc {\n264\t  threads: typeof threadsDomain;\n265\t  intakeStream: typeof intakeStreamDomain;\n266\t  messages: typeof messagesDomain;\n267\t  turns: typeof turnsDomain;\n268\t  threadView: ThreadViewSurface;\n269\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n270\t  // like every other namespace so the status read it composes resolves THIS\n271\t  // SDK's view config (threshold, visibility budgets).\n272\t  inspect: typeof inspectDomain;\n273\t  config: ResolvedSdkConfig;\n274\t  scheduler: Scheduler;\n275\t  workHandlers: WorkHandlerMap;\n276\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n277\t  work: WorkSurface;\n278\t  // Resolves when the scheduler has no running or pending drain for the\n279\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n280\t  // resolve in manual mode.\n281\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n282\t}\n283\t\n284\tfunction requirePositive(value: number, name: string): void {\n285\t  if (!Number.isFinite(value) || value <= 0) {\n286\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n287\t  }\n288\t}\n289\t\n290\tfunction requireNonNegative(value: number, name: string): void {\n291\t  if (!Number.isFinite(value) || value < 0) {\n292\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n293\t  }\n294\t}\n295\t\n296\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n297\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n298\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n299\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n300\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n301\t// object is the same shape as the namespace, so the public surface type holds.\n302\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n303\t  const scoped: Record<string, unknown> = {};\n304\t  for (const key of Object.keys(surface)) {\n305\t    const value = (surface as Record<string, unknown>)[key];\n306\t    scoped[key] =\n307\t      typeof value === \"function\"\n308\t        ? (...args: unknown[]): unknown =>\n309\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n310\t        : value;\n311\t  }\n312\t  return scoped as T;\n313\t}\n314\t\n315\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n316\t// the host function and the complete assignment map loudly — all seven kinds\n317\t// present (iterating the exported FORM_KINDS set, never a second literal\n318\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n319\t// provider/model routing keys — then build the adapter into the same\n320\t// DerivationProvider slot direct injection uses. No partial construction:\n321\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n322\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n323\t  if (typeof inference.call !== \"function\") {\n324\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n325\t  }\n326\t  const assignments = inference.assignments as unknown;\n327\t  if (assignments === null || typeof assignments !== \"object\") {\n328\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n329\t  }\n330\t  const knownKinds = new Set<string>(FORM_KINDS);\n331\t  for (const key of Object.keys(assignments)) {\n332\t    if (!knownKinds.has(key)) {\n333\t      throw new TypeError(\n334\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n335\t      );\n336\t    }\n337\t  }\n338\t  const map = assignments as Partial<Record<FormKind, ModelAssignment>>;\n339\t  for (const kind of FORM_KINDS) {\n340\t    const assignment = map[kind];\n341\t    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n342\t      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n343\t    }\n344\t    for (const field of [\"provider\", \"model\"] as const) {\n345\t      const value = assignment[field];\n346\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n347\t        throw new TypeError(\n348\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n349\t        );\n350\t      }\n351\t    }\n352\t    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n353\t      throw new TypeError(\n354\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n355\t      );\n356\t    }\n357\t  }\n358\t  const timeoutMs = inference.timeoutMs ?? 60_000;\n359\t  const maxInputChars = inference.maxInputChars ?? 200_000;\n360\t  requirePositive(timeoutMs, \"inference.timeoutMs\");\n361\t  requirePositive(maxInputChars, \"inference.maxInputChars\");\n362\t  return createInferenceProvider({\n363\t    call: inference.call,\n364\t    assignments: map as Record<FormKind, ModelAssignment>,\n365\t    timeoutMs,\n366\t    maxInputChars,\n367\t  });\n368\t}\n369\t\n370\t// The only assembly path: provider, mode, clock, and policy enter here.\n371\t// Config mistakes are programmer errors at construction and throw; operating\n372\t// failures after construction return OpResults per the error contract.\n373\texport function createSdk(config: SdkConfig): Lhc {\n374\t  // Provider arrival is exactly one of direct injection or the inference\n375\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n376\t  // env/flag resolution path to fall back on. The XOR rule is validated\n377\t  // before anything downstream so the error names the caller's mistake, not\n378\t  // a symptom (AC-1.1).\n379\t  if (config.provider !== undefined && config.inference !== undefined) {\n380\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n381\t  }\n382\t  if (config.provider === undefined && config.inference === undefined) {\n383\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n384\t  }\n385\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n386\t    throw new TypeError(\n387\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n388\t    );\n389\t  }\n390\t  let provider: DerivationProvider;\n391\t  if (config.inference !== undefined) {\n392\t    provider = resolveInferenceProvider(config.inference);\n393\t  } else {\n394\t    if (config.provider === null || typeof config.provider !== \"object\") {\n395\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n396\t    }\n397\t    for (const operation of PROVIDER_OPERATIONS) {\n398\t      if (typeof config.provider[operation] !== \"function\") {\n399\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n400\t      }\n401\t    }\n402\t    provider = config.provider;\n403\t  }\n404\t\n405\t  const resolved: ResolvedSdkConfig = {\n406\t    provider,\n407\t    mode: config.mode,\n408\t    clock: config.clock ?? (() => new Date()),\n409\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n410\t    lease: config.lease ?? { durationMs: 120000 },\n411\t    chunkPolicy:\n412\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n413\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n414\t    // sums and visibility budgets validated — throws naming the violation.\n415\t    view: resolveViewConfig(config.view),\n416\t  };\n417\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n418\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n419\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n420\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n421\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n422\t  }\n423\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n424\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n425\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n426\t    throw new TypeError(\n427\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n428\t    );\n429\t  }\n430\t\n431\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n432\t  // The tables are empty until Stories 2–3 land the real handlers; the\n433\t  // assembly mechanics are production code from day one.\n434\t  const workHandlers = assembleWorkHandlerMap([\n435\t    messagesDomain.workHandlers,\n436\t    turnsDomain.workHandlers,\n437\t  ]);\n438\t\n439\t  const drainDeps: DrainDeps = {\n440\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n441\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n442\t    config: resolved,\n443\t  };\n444\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n445\t\n446\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n447\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n448\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n449\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n450\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n451\t  // the construction order, because its operations deliver to the no-op seam,\n452\t  // not to whatever a background SDK installed below.\n453\t  // The seam also carries this instance's resolved view config (Epic 03,\n454\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n455\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n456\t  // fall back to the built-in defaults inside the thread-view surface.\n457\t  const seam: InstanceSeam =\n458\t    resolved.mode === \"background\"\n459\t      ? {\n460\t          poke: (threadId) => scheduler.poke(threadId),\n461\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n462\t          view: resolved.view,\n463\t        }\n464\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n465\t\n466\t  // Background mode also installs the below-SDK default seam so a direct\n467\t  // domain call made with no SDK scope — a top-level mutation in the\n468\t  // single-background \"production path\" — still reaches the one installed\n469\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n470\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n471\t  // leaves the default alone (pokes stay no-ops by contract).\n472\t  if (resolved.mode === \"background\") {\n473\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n474\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n475\t  }\n476\t\n477\t  const work: WorkSurface = {\n478\t    drain: (ref, opts) =>\n479\t      runWithInstanceSeam(seam, async () => {\n480\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n481\t        if (!resolvedRef.ok) return resolvedRef;\n482\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n483\t      }),\n484\t  };\n485\t\n486\t  return {\n487\t    threads: threadsDomain,\n488\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n489\t    messages: scopeSurface(messagesDomain, seam),\n490\t    turns: scopeSurface(turnsDomain, seam),\n491\t    threadView: scopeSurface<ThreadViewSurface>(\n492\t      {\n493\t        pull: threadViewDomain.pull,\n494\t        status: threadViewDomain.status,\n495\t        describe: threadViewDomain.describe,\n496\t        compact: threadViewDomain.compact,\n497\t        sweep: threadViewDomain.sweep,\n498\t        materialize: threadViewDomain.materialize,\n499\t      },\n500\t      seam,\n501\t    ),\n502\t    inspect: scopeSurface(inspectDomain, seam),\n503\t    config: resolved,\n504\t    scheduler,\n505\t    workHandlers,\n506\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n507\t    work,\n508\t    drainSettled: async (ref) => {\n509\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n510\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n511\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n512\t      if (threadId === null) return;\n513\t      return scheduler.drainSettled(threadId);\n514\t    },\n515\t  };\n516\t}\n517\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"f7fd9e16-7ac3-4f19-aef8-31bb8a669667","timestamp":"2026-06-14T04:05:02.436Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\nexport * as threadView from \"./domains/thread-view/index.js\";\nexport * as inspect from \"./domains/inspect/index.js\";\n\nimport * as inspectDomain from \"./domains/inspect/index.js\";\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as threadViewDomain from \"./domains/thread-view/index.js\";\nimport { resolveViewConfig } from \"./domains/thread-view/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport {\n  runWithInstanceSeam,\n  setSchedulerPoke as installSchedulerPoke,\n  setThreadTouch,\n  type InstanceSeam,\n} from \"./shared/context.js\";\nimport { createInferenceProvider } from \"./inference/adapter.js\";\nimport { PROMPT_REGISTRY } from \"./inference/prompts/index.js\";\nimport type { InferenceConfig, ModelAssignment } from \"./inference/types.js\";\nimport {\n  FORM_KINDS,\n  PROVIDER_OPERATIONS,\n  type DerivationProvider,\n  type FormKind,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  StoredView,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewProfile,\n  ViewStatus,\n} from \"./shared/view.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n\n// Epic 05 inference vocabulary (inference/types.ts): the host-supplied\n// ModelCall boundary and the per-kind assignment config — type-only; the\n// adapter and registry are construction internals behind createSdk.\nexport type {\n  InferenceConfig,\n  ModelAssignment,\n  ModelCall,\n  ModelCallFailureKind,\n  ModelCallInput,\n  ModelCallResult,\n} from \"./inference/types.js\";\nexport type { ProviderProvenance } from \"./shared/derivation.js\";\n\n// The config-selectable prompt-name catalog (E05-NB-2): the full set of names\n// a per-kind assignment may select, and the default name per kind. Exposed so\n// operators discover valid prompt names from the SDK surface without reading\n// source. The registry itself stays a construction internal behind createSdk.\nexport {\n  DEFAULT_PROMPT_NAMES,\n  PROMPT_NAMES,\n} from \"./inference/prompts/index.js\";\n\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n// from Story 0; the operation shapes land with Stories 1–5.\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n} from \"./domains/thread-view/index.js\";\nexport type {\n  Band,\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SdkViewConfig,\n  StoredView,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewMeta,\n  ViewProfile,\n  ViewProfileOverride,\n  ViewStatus,\n  VisibilityBudgets,\n} from \"./shared/view.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\n// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n// inspect surface serves.\nexport type {\n  HealthReport,\n  InspectOverview,\n  ViewContentsReport,\n} from \"./shared/inspect.js\";\n\nexport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageDetail,\n  MessageListOptions,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\n// §Interface Definitions): the operations only — the Story 0 config\n// substrate the domain index also carries is construction machinery, not an\n// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n// inspect domain composes (DD-1).\nexport interface ThreadViewSurface {\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n  compact(\n    ref: threadsDomain.ThreadRef,\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n  ): Promise<OpResult<CompactReceipt>>;\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n  materialize(\n    ref: threadsDomain.ThreadRef,\n    opts: { path: string; format?: \"pi-session\" },\n  ): Promise<OpResult<{ writtenPath: string }>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  threadView: ThreadViewSurface;\n  // Epic 04: the read-only report surface. Scoped through the instance seam\n  // like every other namespace so the status read it composes resolves THIS\n  // SDK's view config (threshold, visibility budgets).\n  inspect: typeof inspectDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n// object is the same shape as the namespace, so the public surface type holds.\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n  const scoped: Record<string, unknown> = {};\n  for (const key of Object.keys(surface)) {\n    const value = (surface as Record<string, unknown>)[key];\n    scoped[key] =\n      typeof value === \"function\"\n        ? (...args: unknown[]): unknown =>\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n        : value;\n  }\n  return scoped as T;\n}\n\n// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n// the host function and the complete assignment map loudly — all seven kinds\n// present (iterating the exported FORM_KINDS set, never a second literal\n// list), no unknown kind keys, every prompt name in the registry, non-empty\n// provider/model routing keys — then build the adapter into the same\n// DerivationProvider slot direct injection uses. No partial construction:\n// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\nfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n  if (typeof inference.call !== \"function\") {\n    throw new TypeError(\"createSdk config: inference.call must be a function\");\n  }\n  const assignments = inference.assignments as unknown;\n  if (assignments === null || typeof assignments !== \"object\") {\n    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n  }\n  const knownKinds = new Set<string>(FORM_KINDS);\n  for (const key of Object.keys(assignments)) {\n    if (!knownKinds.has(key)) {\n      throw new TypeError(\n        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n      );\n    }\n  }\n  const map = assignments as Partial<Record<FormKind, ModelAssignment>>;\n  for (const kind of FORM_KINDS) {\n    const assignment = map[kind];\n    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n    }\n    for (const field of [\"provider\", \"model\"] as const) {\n      const value = assignment[field];\n      if (typeof value !== \"string\" || value.trim() === \"\") {\n        throw new TypeError(\n          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n        );\n      }\n    }\n    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n      throw new TypeError(\n        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n      );\n    }\n  }\n  const timeoutMs = inference.timeoutMs ?? 60_000;\n  const maxInputChars = inference.maxInputChars ?? 200_000;\n  requirePositive(timeoutMs, \"inference.timeoutMs\");\n  requirePositive(maxInputChars, \"inference.maxInputChars\");\n  return createInferenceProvider({\n    call: inference.call,\n    assignments: map as Record<FormKind, ModelAssignment>,\n    timeoutMs,\n    maxInputChars,\n  });\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  // Provider arrival is exactly one of direct injection or the inference\n  // config (Epic 05 DD-5); there is no named-provider registry and no\n  // env/flag resolution path to fall back on. The XOR rule is validated\n  // before anything downstream so the error names the caller's mistake, not\n  // a symptom (AC-1.1).\n  if (config.provider !== undefined && config.inference !== undefined) {\n    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n  }\n  if (config.provider === undefined && config.inference === undefined) {\n    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n  }\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  let provider: DerivationProvider;\n  if (config.inference !== undefined) {\n    provider = resolveInferenceProvider(config.inference);\n  } else {\n    if (config.provider === null || typeof config.provider !== \"object\") {\n      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n    }\n    for (const operation of PROVIDER_OPERATIONS) {\n      if (typeof config.provider[operation] !== \"function\") {\n        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n      }\n    }\n    provider = config.provider;\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n  // background mode, or a no-op in manual mode — isolated from any other SDK\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\n  // the construction order, because its operations deliver to the no-op seam,\n  // not to whatever a background SDK installed below.\n  // The seam also carries this instance's resolved view config (Epic 03,\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n  // fall back to the built-in defaults inside the thread-view surface.\n  const seam: InstanceSeam =\n    resolved.mode === \"background\"\n      ? {\n          poke: (threadId) => scheduler.poke(threadId),\n          touch: (filePath, db) => scheduler.touch(filePath, db),\n          view: resolved.view,\n        }\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\n\n  // Background mode also installs the below-SDK default seam so a direct\n  // domain call made with no SDK scope — a top-level mutation in the\n  // single-background \"production path\" — still reaches the one installed\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n  // leaves the default alone (pokes stay no-ops by contract).\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: (ref, opts) =>\n      runWithInstanceSeam(seam, async () => {\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n        if (!resolvedRef.ok) return resolvedRef;\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n      }),\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\n    messages: scopeSurface(messagesDomain, seam),\n    turns: scopeSurface(turnsDomain, seam),\n    threadView: scopeSurface<ThreadViewSurface>(\n      {\n        pull: threadViewDomain.pull,\n        status: threadViewDomain.status,\n        describe: threadViewDomain.describe,\n        compact: threadViewDomain.compact,\n        sweep: threadViewDomain.sweep,\n        materialize: threadViewDomain.materialize,\n      },\n      seam,\n    ),\n    inspect: scopeSurface(inspectDomain, seam),\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":517,"startLine":1,"totalLines":517}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tm2hFVZq8AV2bR6YRqcfd3","type":"tool_result","content":"1\timport { DatabaseSync } from \"node:sqlite\";\n2\t\n3\texport interface Migration {\n4\t  version: number; // 1-based, strictly increasing\n5\t  statements: readonly string[];\n6\t}\n7\t\n8\texport function openDatabase(path: string): DatabaseSync {\n9\t  const db = new DatabaseSync(path);\n10\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n11\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n12\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n13\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n14\t  return db;\n15\t}\n16\t\n17\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\n18\t// on the existing work_item table, the derived_form state table, the chunk\n19\t// tables, and the projection-level delete stamps. The whole epic's schema\n20\t// lands in one version — behavior arrives story by story. Assembled into the\n21\t// thread-file migration history by threads/internal/create.ts.\n22\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n23\t  // claim mechanics on the existing table (DD-1: no disposition column —\n24\t  // queue rows are live work only; terminal rows are deleted and their\n25\t  // outcomes reported in-memory; durable outcome state lives on derived_form)\n26\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n27\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n28\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n29\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n30\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n31\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n32\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n33\t  // inside an index definition, so the index covers the two real columns and\n34\t  // claimNext's ORDER BY rowid walks the head as before.\n35\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n36\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n37\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\n38\t  // call id — never a block scan (anti-shim requirement).\n39\t  `CREATE INDEX idx_message_block_tool_call_id\n40\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n41\t  `CREATE TABLE derived_form (\n42\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n43\t    subject_id   TEXT NOT NULL,\n44\t    form         TEXT NOT NULL,\n45\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n46\t    content      TEXT,\n47\t    reason       TEXT,\n48\t    metadata     TEXT,\n49\t    source_version INTEGER NOT NULL DEFAULT 1,\n50\t    gaps         TEXT,\n51\t    derived_at   TEXT,\n52\t    PRIMARY KEY (subject_kind, subject_id, form)\n53\t  );`,\n54\t  `CREATE TABLE chunk (\n55\t    chunk_id     TEXT PRIMARY KEY,\n56\t    chunk_order  INTEGER NOT NULL UNIQUE,\n57\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n58\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n59\t  );`,\n60\t  `CREATE TABLE chunk_member (\n61\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n62\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n63\t    member_idx INTEGER NOT NULL,\n64\t    PRIMARY KEY (chunk_id, member_idx)\n65\t  );`,\n66\t  // projection-level delete (the record keeps everything; reads filter)\n67\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n68\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n69\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\n70\t  // UPDATE-only completion finds them (row missing must mean deleted).\n71\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n72\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n73\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n74\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n75\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n76\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n77\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n78\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n79\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n80\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n81\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n82\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n83\t];\n84\t\n85\t// Epic 03's single migration (tech design §Storage): the thread-view\n86\t// snapshot tables and the visibility boundary, living beside the record they\n87\t// render so a thread file stays self-contained and snapshot-portable.\n88\t// Singletons are CHECK-enforced structurally: one active view, one boundary\n89\t// row per thread. Assembled into the thread-file migration history by\n90\t// threads/internal/create.ts, like v5.\n91\texport const MIGRATION_V6_STATEMENTS: readonly string[] = [\n92\t  `CREATE TABLE thread_view (\n93\t    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\n94\t    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\n95\t    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\n96\t    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\n97\t    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\n98\t    profile_name TEXT,                   -- null when explicit params\n99\t    config_json TEXT NOT NULL,           -- resolved bound + percentages\n100\t    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, formUsed, degraded}\n101\t    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\n102\t    source_state_json TEXT NOT NULL      -- {maxEventOrder, formCounts} the compact saw — receipt/debug\n103\t  );`,\n104\t  `CREATE TABLE thread_view_band (\n105\t    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\n106\t    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\n107\t    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\n108\t    token_count INTEGER NOT NULL,\n109\t    PRIMARY KEY (view_id, band)\n110\t  );`,\n111\t  `CREATE TABLE view_boundary (\n112\t    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\n113\t    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\n114\t    updated_at TEXT NOT NULL\n115\t  );`,\n116\t  // Seed at position 0 (everything full) — the boundary row exists from\n117\t  // migration on, so the advance and the compact reset are UPDATE-only.\n118\t  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\n119\t    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\n120\t];\n121\t\n122\texport function getSchemaVersion(db: DatabaseSync): number {\n123\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n124\t    | { user_version: number | bigint }\n125\t    | undefined;\n126\t  return Number(row?.user_version ?? 0);\n127\t}\n128\t\n129\texport function runMigrations(\n130\t  db: DatabaseSync,\n131\t  migrations: readonly Migration[],\n132\t): void {\n133\t  let current = getSchemaVersion(db);\n134\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n135\t  for (const migration of ordered) {\n136\t    if (migration.version <= current) continue;\n137\t    db.exec(\"BEGIN IMMEDIATE;\");\n138\t    try {\n139\t      for (const statement of migration.statements) db.exec(statement);\n140\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n141\t      db.exec(\"COMMIT;\");\n142\t    } catch (cause) {\n143\t      db.exec(\"ROLLBACK;\");\n144\t      throw cause;\n145\t    }\n146\t    current = migration.version;\n147\t  }\n148\t}\n149\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"7f708461-f737-4c6e-9034-77c7f689f2c8","timestamp":"2026-06-14T04:05:02.435Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/storage.ts","content":"import { DatabaseSync } from \"node:sqlite\";\n\nexport interface Migration {\n  version: number; // 1-based, strictly increasing\n  statements: readonly string[];\n}\n\nexport function openDatabase(path: string): DatabaseSync {\n  const db = new DatabaseSync(path);\n  db.exec(\"PRAGMA journal_mode = WAL;\");\n  db.exec(\"PRAGMA foreign_keys = ON;\");\n  db.exec(\"PRAGMA busy_timeout = 5000;\");\n  db.exec(\"PRAGMA synchronous = NORMAL;\");\n  return db;\n}\n\n// Epic 02's single migration (tech design §Storage): queue mechanical fields\n// on the existing work_item table, the derived_form state table, the chunk\n// tables, and the projection-level delete stamps. The whole epic's schema\n// lands in one version — behavior arrives story by story. Assembled into the\n// thread-file migration history by threads/internal/create.ts.\nexport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n  // claim mechanics on the existing table (DD-1: no disposition column —\n  // queue rows are live work only; terminal rows are deleted and their\n  // outcomes reported in-memory; durable outcome state lives on derived_form)\n  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n  // inside an index definition, so the index covers the two real columns and\n  // claimNext's ORDER BY rowid walks the head as before.\n  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n  // and intake's AC-2.8 late-result lookup are each one indexed query by\n  // call id — never a block scan (anti-shim requirement).\n  `CREATE INDEX idx_message_block_tool_call_id\n     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n  `CREATE TABLE derived_form (\n    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    subject_id   TEXT NOT NULL,\n    form         TEXT NOT NULL,\n    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    content      TEXT,\n    reason       TEXT,\n    metadata     TEXT,\n    source_version INTEGER NOT NULL DEFAULT 1,\n    gaps         TEXT,\n    derived_at   TEXT,\n    PRIMARY KEY (subject_kind, subject_id, form)\n  );`,\n  `CREATE TABLE chunk (\n    chunk_id     TEXT PRIMARY KEY,\n    chunk_order  INTEGER NOT NULL UNIQUE,\n    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n  );`,\n  `CREATE TABLE chunk_member (\n    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    member_idx INTEGER NOT NULL,\n    PRIMARY KEY (chunk_id, member_idx)\n  );`,\n  // projection-level delete (the record keeps everything; reads filter)\n  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n  // F-02 backfill: pending form rows for work queued before v5 existed, so\n  // UPDATE-only completion finds them (row missing must mean deleted).\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n];\n\n// Epic 03's single migration (tech design §Storage): the thread-view\n// snapshot tables and the visibility boundary, living beside the record they\n// render so a thread file stays self-contained and snapshot-portable.\n// Singletons are CHECK-enforced structurally: one active view, one boundary\n// row per thread. Assembled into the thread-file migration history by\n// threads/internal/create.ts, like v5.\nexport const MIGRATION_V6_STATEMENTS: readonly string[] = [\n  `CREATE TABLE thread_view (\n    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\n    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\n    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\n    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\n    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\n    profile_name TEXT,                   -- null when explicit params\n    config_json TEXT NOT NULL,           -- resolved bound + percentages\n    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, formUsed, degraded}\n    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\n    source_state_json TEXT NOT NULL      -- {maxEventOrder, formCounts} the compact saw — receipt/debug\n  );`,\n  `CREATE TABLE thread_view_band (\n    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\n    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\n    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\n    token_count INTEGER NOT NULL,\n    PRIMARY KEY (view_id, band)\n  );`,\n  `CREATE TABLE view_boundary (\n    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\n    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\n    updated_at TEXT NOT NULL\n  );`,\n  // Seed at position 0 (everything full) — the boundary row exists from\n  // migration on, so the advance and the compact reset are UPDATE-only.\n  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\n    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\n];\n\nexport function getSchemaVersion(db: DatabaseSync): number {\n  const row = db.prepare(\"PRAGMA user_version\").get() as\n    | { user_version: number | bigint }\n    | undefined;\n  return Number(row?.user_version ?? 0);\n}\n\nexport function runMigrations(\n  db: DatabaseSync,\n  migrations: readonly Migration[],\n): void {\n  let current = getSchemaVersion(db);\n  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n  for (const migration of ordered) {\n    if (migration.version <= current) continue;\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      for (const statement of migration.statements) db.exec(statement);\n      db.exec(`PRAGMA user_version = ${migration.version};`);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    current = migration.version;\n  }\n}\n","numLines":149,"startLine":1,"totalLines":149}}}

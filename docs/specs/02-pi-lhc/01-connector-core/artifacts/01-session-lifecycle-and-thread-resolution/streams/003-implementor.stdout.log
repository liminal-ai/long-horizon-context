{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012xXNMeEtnA9rNpkxKPZbUa","type":"tool_result","content":"1\timport { createSdk, type Lhc, type OpResult, type SdkConfig, type ThreadRef } from \"lhc\";\n2\timport type { LhcInstance } from \"../shared/instance.js\";\n3\timport { notImplemented } from \"../shared/not-implemented.js\";\n4\t\n5\t// AC-1.1, AC-1.4, AC-1.5.\n6\t\n7\t/** The connector's name for SDK construction — the agreed rename of LHC's\n8\t *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n9\t *  either way). One instance per PI session in background scheduler mode; the\n10\t *  connector never drives the queue (Flow 1). Construction itself is real (it\n11\t *  is just a rename); the lifecycle SEAM below is what Story 1 fills in. */\n12\texport function initLhc(config: SdkConfig): Lhc {\n13\t  return createSdk(config);\n14\t}\n15\t\n16\t/** Construct an instance against a resolved thread (Story 1: build the SDK in\n17\t *  background mode, wrap with a flush-on-dispose seam). Fail-closed until then\n18\t *  — it never returns a usable instance, so nothing can mistake the scaffold\n19\t *  for a working session, and it throws nothing back into a hook. */\n20\texport function initInstance(\n21\t  threadRef: ThreadRef,\n22\t  config: SdkConfig,\n23\t): Promise<OpResult<LhcInstance>> {\n24\t  return Promise.resolve(notImplemented<LhcInstance>(\"lifecycle.initInstance\"));\n25\t}\n26\t\n27\t/** Dispose an instance on shutdown/switch. Story 1 wires this to flush pending\n28\t *  LHC work before releasing the instance; Story 0 exposes the seam but fails\n29\t *  closed so shutdown cannot be mistaken for a successful flush. */\n30\texport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n31\t  void instance;\n32\t  return Promise.resolve(notImplemented<void>(\"lifecycle.disposeInstance\"));\n33\t}\n34\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"099862ef-d846-4984-8088-fe92e533fce1","timestamp":"2026-06-14T04:03:48.416Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/instance.ts","content":"import { createSdk, type Lhc, type OpResult, type SdkConfig, type ThreadRef } from \"lhc\";\nimport type { LhcInstance } from \"../shared/instance.js\";\nimport { notImplemented } from \"../shared/not-implemented.js\";\n\n// AC-1.1, AC-1.4, AC-1.5.\n\n/** The connector's name for SDK construction — the agreed rename of LHC's\n *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n *  either way). One instance per PI session in background scheduler mode; the\n *  connector never drives the queue (Flow 1). Construction itself is real (it\n *  is just a rename); the lifecycle SEAM below is what Story 1 fills in. */\nexport function initLhc(config: SdkConfig): Lhc {\n  return createSdk(config);\n}\n\n/** Construct an instance against a resolved thread (Story 1: build the SDK in\n *  background mode, wrap with a flush-on-dispose seam). Fail-closed until then\n *  — it never returns a usable instance, so nothing can mistake the scaffold\n *  for a working session, and it throws nothing back into a hook. */\nexport function initInstance(\n  threadRef: ThreadRef,\n  config: SdkConfig,\n): Promise<OpResult<LhcInstance>> {\n  return Promise.resolve(notImplemented<LhcInstance>(\"lifecycle.initInstance\"));\n}\n\n/** Dispose an instance on shutdown/switch. Story 1 wires this to flush pending\n *  LHC work before releasing the instance; Story 0 exposes the seam but fails\n *  closed so shutdown cannot be mistaken for a successful flush. */\nexport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n  void instance;\n  return Promise.resolve(notImplemented<void>(\"lifecycle.disposeInstance\"));\n}\n","numLines":34,"startLine":1,"totalLines":34}}}

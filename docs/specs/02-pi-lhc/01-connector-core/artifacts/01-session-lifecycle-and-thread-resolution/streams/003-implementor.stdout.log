{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HsZUSxpqAEtmSsz4PbqRTf","type":"tool_result","content":"=== SdkConfig / mode (derivation.ts) ===\n18:export const FORM_KINDS = [\n28:export type FormKind = (typeof FORM_KINDS)[number];\n179:export interface SdkConfig {\n180:  provider?: DerivationProvider;\n181:  inference?: InferenceConfig;\n182:  mode: \"background\" | \"manual\";\n183:  clock?: () => Date;\n193:  mode: \"background\" | \"manual\";\n194:  clock: () => Date;\n205:  clock: () => Date;\n\n=== createDeterministicProvider signature ===\n// The deterministic provider: marked, input-derived output for every seam\n// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n// functions of the input. It backs the named-provider registry's\n// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n// resolution seam, and the test double reuses these helpers so in-process and\n// spawned runs produce byte-identical artifacts. It is selectable only by\n// explicit name — never a production default.\nimport type {\n  DerivationProvider,\n  ProviderResult,\n  RenderingPart,\n  ToolOutcome,\n  ToolRunReceipt,\n} from \"../shared/derivation.js\";\n\nexport type DeterministicOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\nexport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n  smoothPrompt: \"smoothed\",\n  summarizeToolCall: \"toolcall\",\n  summarizeToolResult: \"toolresult\",\n  composeTurnRendering: \"rendering\",\n  projectLowerBand: \"projection\",\n  summarizeChunkDetailed: \"detailed\",\n  summarizeChunkBrief: \"brief\",\n};\n\n// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n// input-sensitive enough that distinct inputs mark distinct outputs.\nexport function deterministicDigest(input: unknown): string {\n  const text = JSON.stringify(input);\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < text.length; i += 1) {\n    hash ^= text.charCodeAt(i);\n    hash = Math.imul(hash, 0x01000193) >>> 0;\n  }\n  return hash.toString(16).padStart(8, \"0\");\n}\n\nexport function deterministicText(\n  op: DeterministicOpName,\n  input: unknown,\n  text: string,\n): string {\n  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n}\n\nfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n}\n\n// The chunk-summary contract made visible in deterministic output (AC-3.8):\n// the detailed summary's artifact carries the members' tool-run receipts —\n\n=== intakeStream.messageEvents signature ===\n11:  eventKind: K;\n18:export type MessageEventInput =\n31:export type EventKind = MessageEventInput[\"eventKind\"];\n51:// server fields distributes over its members, so a narrowed eventKind narrows\n53:export type EventRecord = MessageEventInput & {\n58:export async function messageEvents(\n60:  events: readonly MessageEventInput[],","is_error":false}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"299b923d-fc55-476f-9c6a-8130d8f02b78","timestamp":"2026-06-14T04:16:18.451Z","tool_use_result":{"stdout":"=== SdkConfig / mode (derivation.ts) ===\n18:export const FORM_KINDS = [\n28:export type FormKind = (typeof FORM_KINDS)[number];\n179:export interface SdkConfig {\n180:  provider?: DerivationProvider;\n181:  inference?: InferenceConfig;\n182:  mode: \"background\" | \"manual\";\n183:  clock?: () => Date;\n193:  mode: \"background\" | \"manual\";\n194:  clock: () => Date;\n205:  clock: () => Date;\n\n=== createDeterministicProvider signature ===\n// The deterministic provider: marked, input-derived output for every seam\n// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n// functions of the input. It backs the named-provider registry's\n// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n// resolution seam, and the test double reuses these helpers so in-process and\n// spawned runs produce byte-identical artifacts. It is selectable only by\n// explicit name — never a production default.\nimport type {\n  DerivationProvider,\n  ProviderResult,\n  RenderingPart,\n  ToolOutcome,\n  ToolRunReceipt,\n} from \"../shared/derivation.js\";\n\nexport type DeterministicOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\nexport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n  smoothPrompt: \"smoothed\",\n  summarizeToolCall: \"toolcall\",\n  summarizeToolResult: \"toolresult\",\n  composeTurnRendering: \"rendering\",\n  projectLowerBand: \"projection\",\n  summarizeChunkDetailed: \"detailed\",\n  summarizeChunkBrief: \"brief\",\n};\n\n// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n// input-sensitive enough that distinct inputs mark distinct outputs.\nexport function deterministicDigest(input: unknown): string {\n  const text = JSON.stringify(input);\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < text.length; i += 1) {\n    hash ^= text.charCodeAt(i);\n    hash = Math.imul(hash, 0x01000193) >>> 0;\n  }\n  return hash.toString(16).padStart(8, \"0\");\n}\n\nexport function deterministicText(\n  op: DeterministicOpName,\n  input: unknown,\n  text: string,\n): string {\n  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n}\n\nfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n}\n\n// The chunk-summary contract made visible in deterministic output (AC-3.8):\n// the detailed summary's artifact carries the members' tool-run receipts —\n\n=== intakeStream.messageEvents signature ===\n11:  eventKind: K;\n18:export type MessageEventInput =\n31:export type EventKind = MessageEventInput[\"eventKind\"];\n51:// server fields distributes over its members, so a narrowed eventKind narrows\n53:export type EventRecord = MessageEventInput & {\n58:export async function messageEvents(\n60:  events: readonly MessageEventInput[],","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

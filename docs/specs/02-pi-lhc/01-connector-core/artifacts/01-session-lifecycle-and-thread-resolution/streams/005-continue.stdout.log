{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0141xM9QS5fKTEBCSSySMdsv","type":"tool_result","content":"1\t// Story 1 — instance lifecycle (TC-1.1, TC-1.4). Driven through the real\n2\t// lifecycle functions against a real temp registry + thread (the store is never\n3\t// mocked; persistence/reattach are the product contract). The SDK is built with\n4\t// the deterministic provider — a valid construction that needs no real\n5\t// inference, which the inference host (Stories 5/6) supplies in production.\n6\timport { existsSync } from \"node:fs\";\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  createDeterministicProvider,\n10\t  inspect,\n11\t  threads,\n12\t  type SdkConfig,\n13\t  type ThreadRef,\n14\t} from \"lhc\";\n15\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n16\timport { resolveThread } from \"../../src/lifecycle/thread-resolution.js\";\n17\timport { eventBatch } from \"../fixtures/synthetic.js\";\n18\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n19\t\n20\tlet store: TempStore;\n21\tbeforeEach(() => {\n22\t  store = tempStore();\n23\t});\n24\tafterEach(() => {\n25\t  store.cleanup();\n26\t});\n27\t\n28\tfunction backgroundConfig(): SdkConfig {\n29\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n30\t}\n31\t\n32\tfunction idOf(ref: ThreadRef): string {\n33\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n34\t  return ref.threadId;\n35\t}\n36\t\n37\tdescribe(\"Story 1: instance lifecycle\", () => {\n38\t  it(\"TC-1.1: a no-flag launch creates one cwd-registered thread and one background instance\", async () => {\n39\t    const cwd = \"/work/tc-1-1\";\n40\t    const resolved = await resolveThread(\n41\t      {},\n42\t      { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n43\t    );\n44\t    expect(resolved.ok).toBe(true);\n45\t    if (!resolved.ok) return;\n46\t    const threadId = idOf(resolved.value);\n47\t\n48\t    // Exactly one thread registered, and its registry row carries the cwd.\n49\t    const all = await threads.listThreads({ registryPath: store.registryPath });\n50\t    expect(all.ok).toBe(true);\n51\t    if (all.ok) expect(all.value).toHaveLength(1);\n52\t\n53\t    const row = await threads.resolve({ threadId, registryPath: store.registryPath });\n54\t    expect(row.ok).toBe(true);\n55\t    if (!row.ok) return;\n56\t    expect(row.value.cwd).toBe(cwd);\n57\t    expect(existsSync(row.value.filePath)).toBe(true); // a real thread file exists\n58\t\n59\t    // One instance, in background scheduler mode. Background mode means the\n60\t    // scheduler auto-drains; the connector never calls drain/drainSettled during\n61\t    // startup (initInstance only validates the thread), so it does not drive the\n62\t    // queue itself (AC-1.1).\n63\t    const built = await initInstance(resolved.value, backgroundConfig());\n64\t    expect(built.ok).toBe(true);\n65\t    if (!built.ok) return;\n66\t    expect(built.value.sdk.config.mode).toBe(\"background\");\n67\t    expect(idOf(built.value.threadRef)).toBe(threadId);\n68\t\n69\t    const disposed = await disposeInstance(built.value);\n70\t    expect(disposed.ok).toBe(true);\n71\t  });\n72\t\n73\t  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n74\t    const resolved = await resolveThread(\n75\t      {},\n76\t      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n77\t    );\n78\t    expect(resolved.ok).toBe(true);\n79\t    if (!resolved.ok) return;\n80\t    const threadId = idOf(resolved.value);\n81\t\n82\t    const built = await initInstance(resolved.value, backgroundConfig());\n83\t    expect(built.ok).toBe(true);\n84\t    if (!built.ok) return;\n85\t\n86\t    // Capture N raw intake events through the instance (the converter is Story 2;\n87\t    // the lifecycle proof needs only that recorded events survive shutdown).\n88\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n89\t    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n90\t    expect(captured.ok).toBe(true);\n91\t\n92\t    // Dispose with flush.\n93\t    const disposed = await disposeInstance(built.value);\n94\t    expect(disposed.ok).toBe(true);\n95\t\n96\t    // Reattach: resolve the same thread by id (no retained instance) and read\n97\t    // back — every pre-shutdown event is present, no trailing loss.\n98\t    const reattached = await resolveThread(\n99\t      { session: threadId },\n100\t      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n101\t    );\n102\t    expect(reattached.ok).toBe(true);\n103\t    if (!reattached.ok) return;\n104\t\n105\t    const overview = await inspect.overview(reattached.value);\n106\t    expect(overview.ok).toBe(true);\n107\t    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n108\t  });\n109\t});\n110\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"4c2d29cc-89fb-4fe2-82a5-e4ec07539914","timestamp":"2026-06-14T05:00:17.755Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/instance.test.ts","content":"// Story 1 — instance lifecycle (TC-1.1, TC-1.4). Driven through the real\n// lifecycle functions against a real temp registry + thread (the store is never\n// mocked; persistence/reattach are the product contract). The SDK is built with\n// the deterministic provider — a valid construction that needs no real\n// inference, which the inference host (Stories 5/6) supplies in production.\nimport { existsSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport { resolveThread } from \"../../src/lifecycle/thread-resolution.js\";\nimport { eventBatch } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\ndescribe(\"Story 1: instance lifecycle\", () => {\n  it(\"TC-1.1: a no-flag launch creates one cwd-registered thread and one background instance\", async () => {\n    const cwd = \"/work/tc-1-1\";\n    const resolved = await resolveThread(\n      {},\n      { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    // Exactly one thread registered, and its registry row carries the cwd.\n    const all = await threads.listThreads({ registryPath: store.registryPath });\n    expect(all.ok).toBe(true);\n    if (all.ok) expect(all.value).toHaveLength(1);\n\n    const row = await threads.resolve({ threadId, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    expect(row.value.cwd).toBe(cwd);\n    expect(existsSync(row.value.filePath)).toBe(true); // a real thread file exists\n\n    // One instance, in background scheduler mode. Background mode means the\n    // scheduler auto-drains; the connector never calls drain/drainSettled during\n    // startup (initInstance only validates the thread), so it does not drive the\n    // queue itself (AC-1.1).\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n    expect(built.value.sdk.config.mode).toBe(\"background\");\n    expect(idOf(built.value.threadRef)).toBe(threadId);\n\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n  });\n\n  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n    const resolved = await resolveThread(\n      {},\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n\n    // Capture N raw intake events through the instance (the converter is Story 2;\n    // the lifecycle proof needs only that recorded events survive shutdown).\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n    expect(captured.ok).toBe(true);\n\n    // Dispose with flush.\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n\n    // Reattach: resolve the same thread by id (no retained instance) and read\n    // back — every pre-shutdown event is present, no trailing loss.\n    const reattached = await resolveThread(\n      { session: threadId },\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n  });\n});\n","numLines":110,"startLine":1,"totalLines":110}}}

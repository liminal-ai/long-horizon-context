{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017hnwHc7AySXKPTsPiEZyKf","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport type { OpResult, SdkConfig, ThreadRef } from \"lhc\";\n11\timport type {\n12\t  ExtensionAPI,\n13\t  ExtensionContext,\n14\t  PiHookHandler,\n15\t  PiHookName,\n16\t} from \"./pi/types.js\";\n17\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n18\timport { createSessionState } from \"./lifecycle/state.js\";\n19\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n20\timport {\n21\t  parseLaunchFlags,\n22\t  resolveThread,\n23\t  type LaunchFlags,\n24\t} from \"./lifecycle/thread-resolution.js\";\n25\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n26\timport type { LhcInstance } from \"./shared/instance.js\";\n27\t\n28\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n29\texport type { LhcInstance } from \"./shared/instance.js\";\n30\t\n31\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n32\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n33\t *  registers no handler for it (story Scope Out). */\n34\texport const EPIC_1_HOOKS = [\n35\t  \"session_start\",\n36\t  \"message_end\",\n37\t  \"turn_end\",\n38\t  \"agent_end\",\n39\t  \"model_select\",\n40\t  \"thinking_level_select\",\n41\t  \"session_before_fork\",\n42\t  \"session_before_switch\",\n43\t  \"session_shutdown\",\n44\t] as const satisfies readonly PiHookName[];\n45\t\n46\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n47\t\n48\t/** What the connector needs from the host to run a session. All injectable so\n49\t *  the lifecycle is exercised against a real temp registry/thread in tests and\n50\t *  the default `~/.lhc` registry in production.\n51\t *\n52\t *  `buildSdkConfig` is the inference seam: it returns the SdkConfig (provider /\n53\t *  inference + policy) to construct the instance from. In Story 1 the real\n54\t *  config — the PI-model-registry-backed `ModelCall` and assignments — is not\n55\t *  wired yet (that is Stories 5/6), so the default fails closed; the connector\n56\t *  then resolves nothing and records a diagnostic rather than faking a session.\n57\t */\n58\texport interface ConnectorDeps {\n59\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n60\t  registryPath?: string;\n61\t  newThreadFilePath?: () => string;\n62\t  parseLaunch?: () => LaunchFlags;\n63\t  selectThread?: (\n64\t    choices: readonly ThreadChoice[],\n65\t    ctx: ExtensionContext,\n66\t  ) => Promise<string | null>;\n67\t}\n68\t\n69\t/** Everything the connector retains across hooks as PLAIN data — by\n70\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n71\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n72\t *  deliberately not part of the snapshot. */\n73\texport interface ConnectorSnapshot {\n74\t  state: SessionState | null;\n75\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n76\t}\n77\t\n78\texport interface Connector {\n79\t  /** Register the observe-only hook rail on the PI extension API. */\n80\t  register(pi: ExtensionAPI): void;\n81\t  /** The plain-data state retained across hooks. `null` until a session\n82\t   *  resolves a thread; never holds a PI ctx. */\n83\t  getState(): SessionState | null;\n84\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n85\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n86\t  getInstance(): LhcInstance | null;\n87\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n88\t  snapshot(): ConnectorSnapshot;\n89\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n90\t   *  synthetic ctx/events without a live PI. */\n91\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n92\t}\n93\t\n94\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n95\t\n96\t/** Inference host not wired yet (Story 5/6): fail closed so a session resolves\n97\t *  nothing and records a diagnostic instead of constructing a faked instance. */\n98\tfunction inferenceNotConfigured(): OpResult<SdkConfig> {\n99\t  return {\n100\t    ok: false,\n101\t    error: {\n102\t      errorClass: \"system_error\",\n103\t      code: \"not_implemented\",\n104\t      reason:\n105\t        \"pi-lhc inference host not wired yet (Epic 1 Story 5); SDK construction deferred\",\n106\t    },\n107\t  };\n108\t}\n109\t\n110\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n111\t *  generated by the registry at creation, so the file name is just a unique\n112\t *  handle; the directory is ensured up front (DatabaseSync does not create\n113\t *  parents). */\n114\tfunction defaultNewThreadFilePath(): string {\n115\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n116\t  mkdirSync(dir, { recursive: true });\n117\t  return join(dir, `${randomUUID()}.sqlite`);\n118\t}\n119\t\n120\tfunction threadIdOf(ref: ThreadRef): string | null {\n121\t  return \"threadId\" in ref ? ref.threadId : null;\n122\t}\n123\t\n124\t/** Build a connector instance. Its mutable state lives in this closure; the\n125\t *  registered handlers capture it, so the instance stays live for the session\n126\t *  even when `activate` discards the returned object. */\n127\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n128\t  // The connector's retained state. `state` is plain data (the durable thread\n129\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n130\t  // `rememberedThreadId` is the durable id the reload path reattaches by; and\n131\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object.\n132\t  let state: SessionState | null = null;\n133\t  let instance: LhcInstance | null = null;\n134\t  let rememberedThreadId: string | null = null;\n135\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n136\t\n137\t  const buildSdkConfig = deps.buildSdkConfig ?? (() => inferenceNotConfigured());\n138\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n139\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n140\t  const selectThread =\n141\t    deps.selectThread ?? ((): Promise<string | null> => Promise.resolve(null));\n142\t\n143\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n144\t    return { code, message, recordedGap: false };\n145\t  }\n146\t\n147\t  // On reload (same session continues, in-memory state wiped) reconstruct the\n148\t  // SAME thread from its durable id rather than re-running the launch — a\n149\t  // no-flag session would otherwise create a duplicate (AC-1.5). The launch\n150\t  // (process.argv) is the fallback when no id is remembered, which covers\n151\t  // --session/--continue/--resume reloads. The permanent home for reload\n152\t  // lineage is LHC thread metadata (Feature 2+).\n153\t  function launchFor(event: { reason: string }): LaunchFlags {\n154\t    if (event.reason === \"reload\" && rememberedThreadId !== null) {\n155\t      return { session: rememberedThreadId };\n156\t    }\n157\t    return parseLaunch();\n158\t  }\n159\t\n160\t  async function resolveForLaunch(\n161\t    launch: LaunchFlags,\n162\t    ctx: ExtensionContext,\n163\t  ): Promise<OpResult<ThreadRef | null>> {\n164\t    if (launch.resume === true) {\n165\t      const pickerDeps: {\n166\t        registryPath?: string;\n167\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n168\t      } = { select: (choices) => selectThread(choices, ctx) };\n169\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n170\t      return pickThread(ctx.cwd, pickerDeps);\n171\t    }\n172\t    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n173\t      cwd: ctx.cwd,\n174\t      newThreadFilePath,\n175\t    };\n176\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n177\t    return resolveThread(launch, resolveDeps);\n178\t  }\n179\t\n180\t  // session_start: resolve the recording thread from the launch and construct\n181\t  // one background instance against it. Config is gated first so a session with\n182\t  // no usable inference config resolves/creates nothing (no orphan thread).\n183\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n184\t    const config = buildSdkConfig(ctx);\n185\t    if (!config.ok) {\n186\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n187\t      return;\n188\t    }\n189\t    const resolved = await resolveForLaunch(launchFor(event), ctx);\n190\t    if (!resolved.ok) {\n191\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n192\t      return;\n193\t    }\n194\t    if (resolved.value === null) {\n195\t      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n196\t      return;\n197\t    }\n198\t    const built = await initInstance(resolved.value, config.value);\n199\t    if (!built.ok) {\n200\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n201\t      return;\n202\t    }\n203\t    instance = built.value;\n204\t    state = createSessionState(resolved.value);\n205\t    rememberedThreadId = threadIdOf(resolved.value);\n206\t  };\n207\t\n208\t  // Dispose with flush before any session swap (session_before_switch fires\n209\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n210\t  // no live instance is a no-op.\n211\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n212\t    const result = await disposeInstance(instance);\n213\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n214\t    instance = null;\n215\t  };\n216\t\n217\t  // Contain every handler: an observe-only hook must never throw back into PI\n218\t  // (a thrown hook breaks the user's session). A caught error becomes a\n219\t  // plain-data diagnostic; it is never rethrown.\n220\t  const guard = (\n221\t    name: Epic1Hook,\n222\t    body: PiHookHandler<Epic1Hook>,\n223\t  ): PiHookHandler<Epic1Hook> => {\n224\t    return async (ctx, event): Promise<void> => {\n225\t      try {\n226\t        await body(ctx, event);\n227\t      } catch (err) {\n228\t        lastDiagnostic = {\n229\t          code: \"hook_handler_error\",\n230\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n231\t          recordedGap: false,\n232\t        };\n233\t      }\n234\t    };\n235\t  };\n236\t\n237\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n238\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n239\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\n240\t  const noop: PiHookHandler<Epic1Hook> = () => {\n241\t    // Intentionally empty — later stories replace this with real routing.\n242\t  };\n243\t\n244\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n245\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n246\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n247\t    session_before_switch: onDispose,\n248\t    session_shutdown: onDispose,\n249\t    message_end: noop,\n250\t    turn_end: noop,\n251\t    agent_end: noop,\n252\t    model_select: noop,\n253\t    thinking_level_select: noop,\n254\t    session_before_fork: noop,\n255\t  };\n256\t\n257\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n258\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n259\t\n260\t  return {\n261\t    handlers,\n262\t    register(pi: ExtensionAPI): void {\n263\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n264\t    },\n265\t    getState(): SessionState | null {\n266\t      return state;\n267\t    },\n268\t    getInstance(): LhcInstance | null {\n269\t      return instance;\n270\t    },\n271\t    snapshot(): ConnectorSnapshot {\n272\t      return { state, lastDiagnostic };\n273\t    },\n274\t  };\n275\t}\n276\t\n277\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n278\t *  loads (and again on `/reload`). Registers the observe-only hook rail with\n279\t *  the production defaults (the `~/.lhc` registry, `process.argv` launch flags).\n280\t *  The inference-backed `buildSdkConfig` is wired in Stories 5/6; until then a\n281\t *  live session resolves nothing and records a diagnostic rather than faking. */\n282\texport function activate(pi: ExtensionAPI): void {\n283\t  createConnector().register(pi);\n284\t}\n285\t\n286\texport default activate;\n287\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"b47c9904-fc13-4925-b571-d1a636357b6f","timestamp":"2026-06-14T04:57:28.410Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport type { OpResult, SdkConfig, ThreadRef } from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport {\n  parseLaunchFlags,\n  resolveThread,\n  type LaunchFlags,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. All injectable so\n *  the lifecycle is exercised against a real temp registry/thread in tests and\n *  the default `~/.lhc` registry in production.\n *\n *  `buildSdkConfig` is the inference seam: it returns the SdkConfig (provider /\n *  inference + policy) to construct the instance from. In Story 1 the real\n *  config — the PI-model-registry-backed `ModelCall` and assignments — is not\n *  wired yet (that is Stories 5/6), so the default fails closed; the connector\n *  then resolves nothing and records a diagnostic rather than faking a session.\n */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** Inference host not wired yet (Story 5/6): fail closed so a session resolves\n *  nothing and records a diagnostic instead of constructing a faked instance. */\nfunction inferenceNotConfigured(): OpResult<SdkConfig> {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"system_error\",\n      code: \"not_implemented\",\n      reason:\n        \"pi-lhc inference host not wired yet (Epic 1 Story 5); SDK construction deferred\",\n    },\n  };\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\nfunction threadIdOf(ref: ThreadRef): string | null {\n  return \"threadId\" in ref ? ref.threadId : null;\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `rememberedThreadId` is the durable id the reload path reattaches by; and\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let rememberedThreadId: string | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? (() => inferenceNotConfigured());\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread =\n    deps.selectThread ?? ((): Promise<string | null> => Promise.resolve(null));\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // On reload (same session continues, in-memory state wiped) reconstruct the\n  // SAME thread from its durable id rather than re-running the launch — a\n  // no-flag session would otherwise create a duplicate (AC-1.5). The launch\n  // (process.argv) is the fallback when no id is remembered, which covers\n  // --session/--continue/--resume reloads. The permanent home for reload\n  // lineage is LHC thread metadata (Feature 2+).\n  function launchFor(event: { reason: string }): LaunchFlags {\n    if (event.reason === \"reload\" && rememberedThreadId !== null) {\n      return { session: rememberedThreadId };\n    }\n    return parseLaunch();\n  }\n\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n      cwd: ctx.cwd,\n      newThreadFilePath,\n    };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveThread(launch, resolveDeps);\n  }\n\n  // session_start: resolve the recording thread from the launch and construct\n  // one background instance against it. Config is gated first so a session with\n  // no usable inference config resolves/creates nothing (no orphan thread).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n    const resolved = await resolveForLaunch(launchFor(event), ctx);\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n    const built = await initInstance(resolved.value, config.value);\n    if (!built.ok) {\n      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n      return;\n    }\n    instance = built.value;\n    state = createSessionState(resolved.value);\n    rememberedThreadId = threadIdOf(resolved.value);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n  // land in later stories. Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — later stories replace this with real routing.\n  };\n\n  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: noop,\n    turn_end: noop,\n    agent_end: noop,\n    model_select: noop,\n    thinking_level_select: noop,\n    session_before_fork: noop,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with\n *  the production defaults (the `~/.lhc` registry, `process.argv` launch flags).\n *  The inference-backed `buildSdkConfig` is wired in Stories 5/6; until then a\n *  live session resolves nothing and records a diagnostic rather than faking. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":287,"startLine":1,"totalLines":287}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014twPpJPJsdVVPoMC9KTZQZ","type":"tool_result","content":"1\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\n2\t// reconstruction (TC-1.2, 1.3, 1.5, 1.6, 1.7 + the restart architecture-risk\n3\t// test). Resolution and the picker are exercised directly against a real temp\n4\t// registry; the plain-data rule and reload are exercised through the connector.\n5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n6\timport {\n7\t  createDeterministicProvider,\n8\t  inspect,\n9\t  threads,\n10\t  type OpResult,\n11\t  type SdkConfig,\n12\t  type ThreadRef,\n13\t} from \"lhc\";\n14\timport { createConnector } from \"../../src/index.js\";\n15\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n16\timport { resolveThread, type ResolveDeps } from \"../../src/lifecycle/thread-resolution.js\";\n17\timport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\n18\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n19\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n20\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n21\t\n22\tlet store: TempStore;\n23\tbeforeEach(() => {\n24\t  store = tempStore();\n25\t});\n26\tafterEach(() => {\n27\t  store.cleanup();\n28\t});\n29\t\n30\tfunction backgroundConfig(): SdkConfig {\n31\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n32\t}\n33\t\n34\tfunction idOf(ref: ThreadRef): string {\n35\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n36\t  return ref.threadId;\n37\t}\n38\t\n39\tfunction deps(cwd = \"/work/default\"): ResolveDeps {\n40\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n41\t}\n42\t\n43\t// Create a thread directly with cwd/title so the picker test can assert both —\n44\t// new threads created by the connector carry a cwd but no title yet (title\n45\t// derivation is the deferred TDQ Q4).\n46\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n47\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n48\t    filePath: store.threadPath(),\n49\t    registryPath: store.registryPath,\n50\t  };\n51\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n52\t  if (opts.title !== undefined) input.title = opts.title;\n53\t  const created = await threads.newThread(input);\n54\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n55\t  return created.value.threadId;\n56\t}\n57\t\n58\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n59\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\n60\t// object, modelling PI handing a fresh ctx to each hook.\n61\tfunction syntheticCtx(cwd: string): ExtensionContext {\n62\t  return {\n63\t    cwd,\n64\t    hasUI: false,\n65\t    modelRegistry: {\n66\t      find: () => undefined,\n67\t      hasConfiguredAuth: () => false,\n68\t      getAvailable: () => [],\n69\t    },\n70\t    ui: { notify: () => {} },\n71\t    sessionManager: { getEntries: () => [] },\n72\t  };\n73\t}\n74\t\n75\tasync function threadCount(): Promise<number> {\n76\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\n77\t  return listed.ok ? listed.value.length : -1;\n78\t}\n79\t\n80\tdescribe(\"Story 1: launch-driven thread resolution\", () => {\n81\t  it(\"TC-1.2: --session resolves an existing thread and creates no second thread\", async () => {\n82\t    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n83\t    const before = await threadCount();\n84\t\n85\t    const resolved = await resolveThread({ session: existingId }, deps());\n86\t    expect(resolved.ok).toBe(true);\n87\t    if (resolved.ok) expect(idOf(resolved.value)).toBe(existingId);\n88\t\n89\t    expect(await threadCount()).toBe(before); // no second thread\n90\t  });\n91\t\n92\t  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n93\t    // no flag → a new thread\n94\t    const first = await resolveThread({}, deps());\n95\t    expect(first.ok).toBe(true);\n96\t    if (!first.ok) return;\n97\t    const firstId = idOf(first.value);\n98\t\n99\t    // --session full id → the same thread\n100\t    const byFull = await resolveThread({ session: firstId }, deps());\n101\t    expect(byFull.ok).toBe(true);\n102\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n103\t\n104\t    // --session partial id → the same thread\n105\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n106\t    expect(byPartial.ok).toBe(true);\n107\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n108\t\n109\t    // a second thread, then --continue → the most recently created\n110\t    const second = await resolveThread({}, deps());\n111\t    expect(second.ok).toBe(true);\n112\t    if (!second.ok) return;\n113\t    const secondId = idOf(second.value);\n114\t    const continued = await resolveThread({ continue: true }, deps());\n115\t    expect(continued.ok).toBe(true);\n116\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n117\t\n118\t    // unresolvable id → actionable error, no thread created\n119\t    const before = await threadCount();\n120\t    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n121\t    expect(bad.ok).toBe(false);\n122\t    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n123\t    expect(await threadCount()).toBe(before);\n124\t\n125\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\n126\t    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n127\t    expect(ambiguous.ok).toBe(false);\n128\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n129\t    expect(await threadCount()).toBe(before);\n130\t  });\n131\t\n132\t  it(\"TC-1.7: --resume lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n133\t    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n134\t    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n135\t    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n136\t\n137\t    let offered: readonly ThreadChoice[] = [];\n138\t    const picked = await pickThread(\"/work/a\", {\n139\t      registryPath: store.registryPath,\n140\t      select: (choices) => {\n141\t        offered = choices;\n142\t        return Promise.resolve(choices[0]!.threadId);\n143\t      },\n144\t    });\n145\t    expect(picked.ok).toBe(true);\n146\t\n147\t    // Only the current cwd's threads are offered, each with title + creation time.\n148\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n149\t    for (const choice of offered) {\n150\t      expect(choice.createdAt).toBeTruthy();\n151\t      expect(choice.title).toBeTruthy();\n152\t    }\n153\t\n154\t    // The operator's selection resolves to that thread.\n155\t    if (picked.ok && picked.value !== null) {\n156\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n157\t    }\n158\t\n159\t    // An empty cwd reports an empty list (null) without failing or prompting.\n160\t    let selectCalled = false;\n161\t    const empty = await pickThread(\"/work/empty\", {\n162\t      registryPath: store.registryPath,\n163\t      select: () => {\n164\t        selectCalled = true;\n165\t        return Promise.resolve(null);\n166\t      },\n167\t    });\n168\t    expect(empty.ok).toBe(true);\n169\t    if (empty.ok) expect(empty.value).toBeNull();\n170\t    expect(selectCalled).toBe(false);\n171\t  });\n172\t\n173\t  it(\"TC-1.5 (risk: restart): reattach reconstructs the thread from its durable id after the holder is discarded\", async () => {\n174\t    const cwd = \"/work/tc-1-5\";\n175\t    // Create + capture on a thread.\n176\t    const created = await resolveThread({}, deps(cwd));\n177\t    expect(created.ok).toBe(true);\n178\t    if (!created.ok) return;\n179\t    const threadId = idOf(created.value);\n180\t\n181\t    const first = await initInstance(created.value, backgroundConfig());\n182\t    expect(first.ok).toBe(true);\n183\t    if (!first.ok) return;\n184\t    await first.value.sdk.intakeStream.messageEvents(\n185\t      first.value.threadRef,\n186\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n187\t    );\n188\t    await disposeInstance(first.value);\n189\t\n190\t    // Discard ALL in-memory state. Only the durable id survives (as it would in\n191\t    // the registry across process death). Reconstruct purely from it — no\n192\t    // retained object.\n193\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n194\t    expect(reattached.ok).toBe(true);\n195\t    if (!reattached.ok) return;\n196\t    expect(idOf(reattached.value)).toBe(threadId); // the same thread, by id\n197\t\n198\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n199\t    expect(rebuilt.ok).toBe(true);\n200\t    if (!rebuilt.ok) return;\n201\t    // Capture continues on the same thread: append more, all events present.\n202\t    await rebuilt.value.sdk.intakeStream.messageEvents(\n203\t      rebuilt.value.threadRef,\n204\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n205\t    );\n206\t    const overview = await inspect.overview(reattached.value);\n207\t    expect(overview.ok).toBe(true);\n208\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n209\t    await disposeInstance(rebuilt.value);\n210\t  });\n211\t});\n212\t\n213\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n214\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n215\t    const connector = createConnector({\n216\t      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\n217\t      registryPath: store.registryPath,\n218\t      newThreadFilePath: () => store.threadPath(),\n219\t      parseLaunch: () => ({}), // no flag → new thread\n220\t    });\n221\t\n222\t    // session_start with a ctx carrying methods.\n223\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n224\t    expect(connector.getState()).not.toBeNull();\n225\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n226\t    // ...but the snapshot is plain data only — it survives structuredClone even\n227\t    // though the live ctx and instance carry methods (they are not in it).\n228\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n229\t    const threadRefBefore = connector.getState()?.threadRef;\n230\t\n231\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n232\t    // holder still references no prior ctx.\n233\t    await connector.handlers.message_end(\n234\t      syntheticCtx(\"/work/a\"),\n235\t      makeMessageEnd(makeUserMessage(\"hi\")),\n236\t    );\n237\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n238\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n239\t  });\n240\t});\n241\t\n242\tdescribe(\"Story 1: reload reconstruction (connector wiring)\", () => {\n243\t  it(\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\", async () => {\n244\t    // The launch is no-flag, which would create a NEW thread on every resolve.\n245\t    // The reload path must instead reattach the durable resolved id (AC-1.5).\n246\t    const connector = createConnector({\n247\t      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\n248\t      registryPath: store.registryPath,\n249\t      newThreadFilePath: () => store.threadPath(),\n250\t      parseLaunch: () => ({}),\n251\t    });\n252\t\n253\t    await connector.handlers.session_start(syntheticCtx(\"/work/reload\"), makeSessionStart(\"new\"));\n254\t    const firstRef = connector.getState()?.threadRef;\n255\t    const firstId = firstRef !== undefined && \"threadId\" in firstRef ? firstRef.threadId : null;\n256\t    expect(firstId).not.toBeNull();\n257\t    const countAfterNew = await threadCount();\n258\t\n259\t    // /reload fires shutdown{reload} then session_start{reload} on the same\n260\t    // session — the connector disposes, then reconstructs the SAME thread.\n261\t    await connector.handlers.session_shutdown(syntheticCtx(\"/work/reload\"), { reason: \"reload\" });\n262\t    await connector.handlers.session_start(syntheticCtx(\"/work/reload\"), makeSessionStart(\"reload\"));\n263\t\n264\t    const reloadedRef = connector.getState()?.threadRef;\n265\t    const reloadedId =\n266\t      reloadedRef !== undefined && \"threadId\" in reloadedRef ? reloadedRef.threadId : null;\n267\t    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\n268\t    expect(connector.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n269\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n270\t  });\n271\t});\n272\t"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"f8f67c0a-c123-418d-9c81-f21f35a9ab8f","timestamp":"2026-06-14T05:01:34.255Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts","content":"// Story 1 — launch-driven thread resolution, plain-data state, and reload\n// reconstruction (TC-1.2, 1.3, 1.5, 1.6, 1.7 + the restart architecture-risk\n// test). Resolution and the picker are exercised directly against a real temp\n// registry; the plain-data rule and reload are exercised through the connector.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type OpResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector } from \"../../src/index.js\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport { resolveThread, type ResolveDeps } from \"../../src/lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\nfunction deps(cwd = \"/work/default\"): ResolveDeps {\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n}\n\n// Create a thread directly with cwd/title so the picker test can assert both —\n// new threads created by the connector carry a cwd but no title yet (title\n// derivation is the deferred TDQ Q4).\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  };\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n  if (opts.title !== undefined) input.title = opts.title;\n  const created = await threads.newThread(input);\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n  return created.value.threadId;\n}\n\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\n// object, modelling PI handing a fresh ctx to each hook.\nfunction syntheticCtx(cwd: string): ExtensionContext {\n  return {\n    cwd,\n    hasUI: false,\n    modelRegistry: {\n      find: () => undefined,\n      hasConfiguredAuth: () => false,\n      getAvailable: () => [],\n    },\n    ui: { notify: () => {} },\n    sessionManager: { getEntries: () => [] },\n  };\n}\n\nasync function threadCount(): Promise<number> {\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\n  return listed.ok ? listed.value.length : -1;\n}\n\ndescribe(\"Story 1: launch-driven thread resolution\", () => {\n  it(\"TC-1.2: --session resolves an existing thread and creates no second thread\", async () => {\n    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n    const before = await threadCount();\n\n    const resolved = await resolveThread({ session: existingId }, deps());\n    expect(resolved.ok).toBe(true);\n    if (resolved.ok) expect(idOf(resolved.value)).toBe(existingId);\n\n    expect(await threadCount()).toBe(before); // no second thread\n  });\n\n  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n    // no flag → a new thread\n    const first = await resolveThread({}, deps());\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    const firstId = idOf(first.value);\n\n    // --session full id → the same thread\n    const byFull = await resolveThread({ session: firstId }, deps());\n    expect(byFull.ok).toBe(true);\n    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n\n    // --session partial id → the same thread\n    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n    expect(byPartial.ok).toBe(true);\n    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n\n    // a second thread, then --continue → the most recently created\n    const second = await resolveThread({}, deps());\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    const secondId = idOf(second.value);\n    const continued = await resolveThread({ continue: true }, deps());\n    expect(continued.ok).toBe(true);\n    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n\n    // unresolvable id → actionable error, no thread created\n    const before = await threadCount();\n    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n    expect(bad.ok).toBe(false);\n    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n    expect(await threadCount()).toBe(before);\n\n    // ambiguous prefix (matches both threads) → actionable error, no thread created\n    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n    expect(ambiguous.ok).toBe(false);\n    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n    expect(await threadCount()).toBe(before);\n  });\n\n  it(\"TC-1.7: --resume lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n\n    let offered: readonly ThreadChoice[] = [];\n    const picked = await pickThread(\"/work/a\", {\n      registryPath: store.registryPath,\n      select: (choices) => {\n        offered = choices;\n        return Promise.resolve(choices[0]!.threadId);\n      },\n    });\n    expect(picked.ok).toBe(true);\n\n    // Only the current cwd's threads are offered, each with title + creation time.\n    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n    for (const choice of offered) {\n      expect(choice.createdAt).toBeTruthy();\n      expect(choice.title).toBeTruthy();\n    }\n\n    // The operator's selection resolves to that thread.\n    if (picked.ok && picked.value !== null) {\n      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n    }\n\n    // An empty cwd reports an empty list (null) without failing or prompting.\n    let selectCalled = false;\n    const empty = await pickThread(\"/work/empty\", {\n      registryPath: store.registryPath,\n      select: () => {\n        selectCalled = true;\n        return Promise.resolve(null);\n      },\n    });\n    expect(empty.ok).toBe(true);\n    if (empty.ok) expect(empty.value).toBeNull();\n    expect(selectCalled).toBe(false);\n  });\n\n  it(\"TC-1.5 (risk: restart): reattach reconstructs the thread from its durable id after the holder is discarded\", async () => {\n    const cwd = \"/work/tc-1-5\";\n    // Create + capture on a thread.\n    const created = await resolveThread({}, deps(cwd));\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n    const threadId = idOf(created.value);\n\n    const first = await initInstance(created.value, backgroundConfig());\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    await first.value.sdk.intakeStream.messageEvents(\n      first.value.threadRef,\n      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n    );\n    await disposeInstance(first.value);\n\n    // Discard ALL in-memory state. Only the durable id survives (as it would in\n    // the registry across process death). Reconstruct purely from it — no\n    // retained object.\n    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n    expect(idOf(reattached.value)).toBe(threadId); // the same thread, by id\n\n    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n    expect(rebuilt.ok).toBe(true);\n    if (!rebuilt.ok) return;\n    // Capture continues on the same thread: append more, all events present.\n    await rebuilt.value.sdk.intakeStream.messageEvents(\n      rebuilt.value.threadRef,\n      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n    );\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n    await disposeInstance(rebuilt.value);\n  });\n});\n\ndescribe(\"Story 1: plain-data state across hooks\", () => {\n  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n    const connector = createConnector({\n      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\n      registryPath: store.registryPath,\n      newThreadFilePath: () => store.threadPath(),\n      parseLaunch: () => ({}), // no flag → new thread\n    });\n\n    // session_start with a ctx carrying methods.\n    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n    expect(connector.getState()).not.toBeNull();\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n    // ...but the snapshot is plain data only — it survives structuredClone even\n    // though the live ctx and instance carry methods (they are not in it).\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    const threadRefBefore = connector.getState()?.threadRef;\n\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n    // holder still references no prior ctx.\n    await connector.handlers.message_end(\n      syntheticCtx(\"/work/a\"),\n      makeMessageEnd(makeUserMessage(\"hi\")),\n    );\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n  });\n});\n\ndescribe(\"Story 1: reload reconstruction (connector wiring)\", () => {\n  it(\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\", async () => {\n    // The launch is no-flag, which would create a NEW thread on every resolve.\n    // The reload path must instead reattach the durable resolved id (AC-1.5).\n    const connector = createConnector({\n      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\n      registryPath: store.registryPath,\n      newThreadFilePath: () => store.threadPath(),\n      parseLaunch: () => ({}),\n    });\n\n    await connector.handlers.session_start(syntheticCtx(\"/work/reload\"), makeSessionStart(\"new\"));\n    const firstRef = connector.getState()?.threadRef;\n    const firstId = firstRef !== undefined && \"threadId\" in firstRef ? firstRef.threadId : null;\n    expect(firstId).not.toBeNull();\n    const countAfterNew = await threadCount();\n\n    // /reload fires shutdown{reload} then session_start{reload} on the same\n    // session — the connector disposes, then reconstructs the SAME thread.\n    await connector.handlers.session_shutdown(syntheticCtx(\"/work/reload\"), { reason: \"reload\" });\n    await connector.handlers.session_start(syntheticCtx(\"/work/reload\"), makeSessionStart(\"reload\"));\n\n    const reloadedRef = connector.getState()?.threadRef;\n    const reloadedId =\n      reloadedRef !== undefined && \"threadId\" in reloadedRef ? reloadedRef.threadId : null;\n    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\n    expect(connector.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n  });\n});\n","numLines":272,"startLine":1,"totalLines":272}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X4bamSd3MZ5iWH7hk16b7w","type":"tool_result","content":"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3bd99b80-3187-4d52-9c3e-b6b2c0cfc11e","uuid":"39b7f9db-01c4-45e1-840c-542bc46f643a","timestamp":"2026-06-14T04:58:53.138Z","tool_use_result":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","oldString":"  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `rememberedThreadId` is the durable id the reload path reattaches by; and\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let rememberedThreadId: string | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? (() => inferenceNotConfigured());\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread =\n    deps.selectThread ?? ((): Promise<string | null> => Promise.resolve(null));\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // On reload (same session continues, in-memory state wiped) reconstruct the\n  // SAME thread from its durable id rather than re-running the launch — a\n  // no-flag session would otherwise create a duplicate (AC-1.5). The launch\n  // (process.argv) is the fallback when no id is remembered, which covers\n  // --session/--continue/--resume reloads. The permanent home for reload\n  // lineage is LHC thread metadata (Feature 2+).\n  function launchFor(event: { reason: string }): LaunchFlags {\n    if (event.reason === \"reload\" && rememberedThreadId !== null) {\n      return { session: rememberedThreadId };\n    }\n    return parseLaunch();\n  }","newString":"  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\n  // durable reload id lives at MODULE scope (above), not here, so it survives\n  // this closure being torn down on reload.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // On reload (same session continues, the connector torn down and re-created)\n  // reconstruct the SAME thread from its durable id rather than re-running the\n  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\n  // id is read from the module-level reload memory, which survives this closure;\n  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\n  // the fallback, covering --session/--continue/--resume reloads. The permanent\n  // home for reload lineage is LHC thread metadata (Feature 2+).\n  function launchFor(event: { reason: string }): LaunchFlags {\n    if (event.reason === \"reload\" && rememberedSessionThreadId !== null) {\n      return { session: rememberedSessionThreadId };\n    }\n    return parseLaunch();\n  }","originalFile":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport {\n  parseLaunchFlags,\n  resolveThread,\n  type LaunchFlags,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production observe-only SDK config: a real, construction-valid instance\n *  in background scheduler mode. Epic 1 is observe-only, so derivations are\n *  never served to the model; in Story 1 specifically the connector does not yet\n *  capture (message_end is a no-op until Story 2), so no derivation work is\n *  queued and this provider is never invoked — it exists only to satisfy\n *  construction (AC-1.1 \"initializes one LHC instance\"). Stories 5/6 replace it\n *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\n *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\n *  package is not yet a build dependency of this workspace). */\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n}\n\n/** Default `--resume` selection (sufficient for Story 1): resume the most\n *  recently created thread in the cwd. The choices arrive in creation order, so\n *  the last is the most recent. An interactive operator picker awaits a PI input\n *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\n *  then this is the production selection, and tests drive an explicit choice\n *  through the injected selector. */\nfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\nfunction threadIdOf(ref: ThreadRef): string | null {\n  return \"threadId\" in ref ? ref.threadId : null;\n}\n\n// The durable resolved thread id for the current session, held at MODULE scope\n// (not in a connector closure) so it survives the extension teardown/re-init a\n// reload performs: a PI process runs one session at a time, so a single\n// \"current thread id\" is unambiguous, and a fresh connector created by the next\n// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\n// PI-session→thread mapping or a durable file — so process death correctly drops\n// it and the next launch re-resolves (no early-crash window, no recovery\n// sidecar; epic I-1). Cleared on any non-reload teardown.\nlet rememberedSessionThreadId: string | null = null;\n\n/** Reset the module-level reload memory. Test seam so each test starts from a\n *  clean durable state; also the hook a full teardown would call. */\nexport function resetSessionThreadMemory(): void {\n  rememberedSessionThreadId = null;\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `rememberedThreadId` is the durable id the reload path reattaches by; and\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let rememberedThreadId: string | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? (() => inferenceNotConfigured());\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread =\n    deps.selectThread ?? ((): Promise<string | null> => Promise.resolve(null));\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // On reload (same session continues, in-memory state wiped) reconstruct the\n  // SAME thread from its durable id rather than re-running the launch — a\n  // no-flag session would otherwise create a duplicate (AC-1.5). The launch\n  // (process.argv) is the fallback when no id is remembered, which covers\n  // --session/--continue/--resume reloads. The permanent home for reload\n  // lineage is LHC thread metadata (Feature 2+).\n  function launchFor(event: { reason: string }): LaunchFlags {\n    if (event.reason === \"reload\" && rememberedThreadId !== null) {\n      return { session: rememberedThreadId };\n    }\n    return parseLaunch();\n  }\n\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n      cwd: ctx.cwd,\n      newThreadFilePath,\n    };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveThread(launch, resolveDeps);\n  }\n\n  // session_start: resolve the recording thread from the launch and construct\n  // one background instance against it. Config is gated first so a session with\n  // no usable inference config resolves/creates nothing (no orphan thread).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n    const resolved = await resolveForLaunch(launchFor(event), ctx);\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n    const built = await initInstance(resolved.value, config.value);\n    if (!built.ok) {\n      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n      return;\n    }\n    instance = built.value;\n    state = createSessionState(resolved.value);\n    rememberedThreadId = threadIdOf(resolved.value);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op.\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n  // land in later stories. Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — later stories replace this with real routing.\n  };\n\n  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: noop,\n    turn_end: noop,\n    agent_end: noop,\n    model_select: noop,\n    thinking_level_select: noop,\n    session_before_fork: noop,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with\n *  the production defaults (the `~/.lhc` registry, `process.argv` launch flags).\n *  The inference-backed `buildSdkConfig` is wired in Stories 5/6; until then a\n *  live session resolves nothing and records a diagnostic rather than faking. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","structuredPatch":[{"oldStart":151,"oldLines":32,"newStart":151,"newLines":32,"lines":[" export function createConnector(deps: ConnectorDeps = {}): Connector {","   // The connector's retained state. `state` is plain data (the durable thread","   // reference + flags); `instance` is the live SDK engine (rebuilt on reload);","-  // `rememberedThreadId` is the durable id the reload path reattaches by; and","-  // `lastDiagnostic` is the plain-data health signal. None is a PI object.","+  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The","+  // durable reload id lives at MODULE scope (above), not here, so it survives","+  // this closure being torn down on reload.","   let state: SessionState | null = null;","   let instance: LhcInstance | null = null;","-  let rememberedThreadId: string | null = null;","   let lastDiagnostic: CaptureFailureDiagnostic | null = null;"," ","-  const buildSdkConfig = deps.buildSdkConfig ?? (() => inferenceNotConfigured());","+  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;","   const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;","   const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));","-  const selectThread =","-    deps.selectThread ?? ((): Promise<string | null> => Promise.resolve(null));","+  const selectThread = deps.selectThread ?? defaultSelectThread;"," ","   function diag(code: string, message: string): CaptureFailureDiagnostic {","     return { code, message, recordedGap: false };","   }"," ","-  // On reload (same session continues, in-memory state wiped) reconstruct the","-  // SAME thread from its durable id rather than re-running the launch — a","-  // no-flag session would otherwise create a duplicate (AC-1.5). The launch","-  // (process.argv) is the fallback when no id is remembered, which covers","-  // --session/--continue/--resume reloads. The permanent home for reload","-  // lineage is LHC thread metadata (Feature 2+).","+  // On reload (same session continues, the connector torn down and re-created)","+  // reconstruct the SAME thread from its durable id rather than re-running the","+  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The","+  // id is read from the module-level reload memory, which survives this closure;","+  // if it is absent (e.g. a full module re-import) the launch (process.argv) is","+  // the fallback, covering --session/--continue/--resume reloads. The permanent","+  // home for reload lineage is LHC thread metadata (Feature 2+).","   function launchFor(event: { reason: string }): LaunchFlags {","-    if (event.reason === \"reload\" && rememberedThreadId !== null) {","-      return { session: rememberedThreadId };","+    if (event.reason === \"reload\" && rememberedSessionThreadId !== null) {","+      return { session: rememberedSessionThreadId };","     }","     return parseLaunch();","   }"]}],"userModified":false,"replaceAll":false}}

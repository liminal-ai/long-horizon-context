.registryPath });\n    expect(all.ok).toBe(true);\n    if (all.ok) expect(all.value).toHaveLength(1);\n\n    const row = await threads.resolve({\n      threadId: idOf(state.threadRef),\n      registryPath: store.registryPath,\n    });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    expect(row.value.cwd).toBe(cwd);\n    expect(row.value.title).toBe(defaultThreadTitle(cwd)); // \"tc-1-1\"\n    expect(existsSync(row.value.filePath)).toBe(true);\n\n    // Observe-only: the connector did not capture or drive the derivation queue\n    // on start (capture is Story 2) — the instance only auto-drains in the\n    // background, which has nothing to do here.\n    const overview = await inspect.overview(state.threadRef);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(0);\n\n    // Shutdown disposes the live instance.\n    await connector.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n    expect(connector.getInstance()).toBeNull();\n  });\n\n  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n    const resolved = await resolveThread(\n      {},\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n\n    // Capture N raw intake events through the instance (the converter is Story 2;\n    // the lifecycle proof needs only that recorded events survive shutdown).\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n    expect(captured.ok).toBe(true);\n\n    // Dispose with flush.\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n\n    // Reattach: resolve the same thread by id (no retained instance) and read\n    // back — every pre-shutdown event is present, no trailing loss.\n    const reattached = await resolveThread(\n      { session: threadId },\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n  });\n});\n","structuredPatch":[{"oldStart":1,"oldLines":8,"newStart":1,"newLines":11,"lines":["-// Story 1 — instance lifecycle (TC-1.1, TC-1.4). Driven through the real","-// lifecycle functions against a real temp registry + thread (the store is never","-// mocked; persistence/reattach are the product contract). The SDK is built with","-// the deterministic provider — a valid construction that needs no real","-// inference, which the inference host (Stories 5/6) supplies in production.","+// Story 1 — instance lifecycle. TC-1.1 drives the PRODUCTION connector path:","+// createConnector with only environment overrides (temp registry/thread-file,","+// scripted launch) and the REAL default SDK config + selector — proving","+// session_start resolves, creates a cwd/title-registered thread, and initializes","+// one background instance with no placeholder injection. TC-1.4 proves shutdown","+// flush + reattach at the instance level (Story 1 does not capture through hooks","+// yet, so events are written directly through the instance). Real temp","+// registry/thread throughout (the store is never mocked)."," import { existsSync } from \"node:fs\";"," import { afterEach, beforeEach, describe, expect, it } from \"vitest\";"," import {"]},{"oldStart":12,"oldLines":14,"newStart":15,"newLines":17,"lines":["   type SdkConfig,","   type ThreadRef,"," } from \"lhc\";","+import { createConnector, resetSessionThreadMemory } from \"../../src/index.js\";"," import { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";","-import { resolveThread } from \"../../src/lifecycle/thread-resolution.js\";","-import { eventBatch } from \"../fixtures/synthetic.js\";","+import { defaultThreadTitle, resolveThread } from \"../../src/lifecycle/thread-resolution.js\";","+import type { ExtensionContext } from \"../../src/pi/types.js\";","+import { eventBatch, makeSessionStart } from \"../fixtures/synthetic.js\";"," import { tempStore, type TempStore } from \"../fixtures/thread.js\";"," "," let store: TempStore;"," beforeEach(() => {","   store = tempStore();","+  resetSessionThreadMemory();"," });"," afterEach(() => {","   store.cleanup();"]},{"oldStart":34,"oldLines":40,"newStart":40,"newLines":66,"lines":["   return ref.threadId;"," }"," ","+// A per-hook ctx carrying methods (not plain data), like PI hands each hook.","+function syntheticCtx(cwd: string): ExtensionContext {","+  return {","+    cwd,","+    hasUI: false,","+    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },","+    ui: { notify: () => {} },","+    sessionManager: { getEntries: () => [] },","+  };","+}","+"," describe(\"Story 1: instance lifecycle\", () => {","-  it(\"TC-1.1: a no-flag launch creates one cwd-registered thread and one background instance\", async () => {","+  it(\"TC-1.1: a no-flag session_start (production defaults) creates one cwd/title thread and one background instance\", async () => {","     const cwd = \"/work/tc-1-1\";","-    const resolved = await resolveThread(","-      {},","-      { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },","-    );","-    expect(resolved.ok).toBe(true);","-    if (!resolved.ok) return;","-    const threadId = idOf(resolved.value);","+    // Only environment overrides are injected; buildSdkConfig and selectThread","+    // use the real production defaults, so this exercises the activate path's","+    // lifecycle, not a placeholder branch.","+    const connector = createConnector({","+      registryPath: store.registryPath,","+      newThreadFilePath: () => store.threadPath(),","+      parseLaunch: () => ({}),","+    });"," ","-    // Exactly one thread registered, and its registry row carries the cwd.","+    await connector.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));","+","+    // A real instance was constructed in background scheduler mode (no","+    // fail-closed early return).","+    const instance = connector.getInstance();","+    expect(instance).not.toBeNull();","+    expect(instance?.sdk.config.mode).toBe(\"background\");","+","+    const state = connector.getState();","+    expect(state).not.toBeNull();","+    if (state === null) return;","+","+    // Exactly one thread, registered with BOTH cwd and title metadata (A-8 / TC-1.1).","     const all = await threads.listThreads({ registryPath: store.registryPath });","     expect(all.ok).toBe(true);","     if (all.ok) expect(all.value).toHaveLength(1);"," ","-    const row = await threads.resolve({ threadId, registryPath: store.registryPath });","+    const row = await threads.resolve({","+      threadId: idOf(state.threadRef),","+      registryPath: store.registryPath,","+    });","     expect(row.ok).toBe(true);","     if (!row.ok) return;","     expect(row.value.cwd).toBe(cwd);","-    expect(existsSync(row.value.filePath)).toBe(true); // a real thread file exists","+    expect(row.value.title).toBe(defaultThreadTitle(cwd)); // \"tc-1-1\"","+    expect(existsSync(row.value.filePath)).toBe(true);"," ","-    // One instance, in background scheduler mode. Background mode means the","-    // scheduler auto-drains; the connector never calls drain/drainSettled during","-    // startup (initInstance only validates the thread), so it does not drive the","-    // queue itself (AC-1.1).","-    const built = await initInstance(resolved.value, backgroundConfig());","-    expect(built.ok).toBe(true);","-    if (!built.ok) return;","-    expect(built.value.sdk.config.mode).toBe(\"background\");","-    expect(idOf(built.value.threadRef)).toBe(threadId);","+    // Observe-only: the connector did not capture or drive the derivation queue","+    // on start (capture is Story 2) — the instance only auto-drains in the","+    // background, which has nothing to do here.","+    const overview = await inspect.overview(state.threadRef);","+    expect(overview.ok).toBe(true);","+    if (overview.ok) expect(overview.value.events.count).toBe(0);"," ","-    const disposed = await disposeInstance(built.value);","-    expect(disposed.ok).toBe(true);","+    // Shutdown disposes the live instance.","+    await connector.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });","+    expect(connector.getInstance()).toBeNull();","   });"," ","   it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {"]}],"originalFile":"// Story 1 — instance lifecycle (TC-1.1, TC-1.4). Driven through the real\n// lifecycle functions against a real temp registry + thread (the store is never\n// mocked; persistence/reattach are the product contract). The SDK is built with\n// the deterministic provider — a valid construction that needs no real\n// inference, which the inference host (Stories 5/6) supplies in production.\nimport { existsSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport { resolveThread } from \"../../src/lifecycle/thread-resolution.js\";\nimport { eventBatch } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\ndescribe(\"Story 1: instance lifecycle\", () => {\n  it(\"TC-1.1: a no-flag launch creates one cwd-registered thread and one background instance\", async () => {\n    const cwd = \"/work/tc-1-1\";\n    const resolved = await resolveThread(\n      {},\n      { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    // Exactly one thread registered, and its registry row carries the cwd.\n    const all = await threads.listThreads({ registryPath: store.registryPath });\n    expect(all.ok).toBe(true);\n    if (all.ok) expect(all.value).toHaveLength(1);\n\n    const row = await threads.resolve({ threadId, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    expect(row.value.cwd).toBe(cwd);\n    expect(existsSync(row.value.filePath)).toBe(true); // a real thread file exists\n\n    // One instance, in background scheduler mode. Background mode means the\n    // scheduler auto-drains; the connector never calls drain/drainSettled during\n    // startup (initInstance only validates the thread), so it does not drive the\n    // queue itself (AC-1.1).\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n    expect(built.value.sdk.config.mode).toBe(\"background\");\n    expect(idOf(built.value.threadRef)).toBe(threadId);\n\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n  });\n\n  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n    const resolved = await resolveThread(\n      {},\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(resolved.ok).toBe(true);\n    if (!resolved.ok) return;\n    const threadId = idOf(resolved.value);\n\n    const built = await initInstance(resolved.value, backgroundConfig());\n    expect(built.ok).toBe(true);\n    if (!built.ok) return;\n\n    // Capture N raw intake events through the instance (the converter is Story 2;\n    // the lifecycle proof needs only that recorded events survive shutdown).\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n    expect(captured.ok).toBe(true);\n\n    // Dispose with flush.\n    const disposed = await disposeInstance(built.value);\n    expect(disposed.ok).toBe(true);\n\n    // Reattach: resolve the same thread by id (no retained instance) and read\n    // back — every pre-shutdown event is present, no trailing loss.\n    const reattached = await resolveThread(\n      { session: threadId },\n      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    );\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n  });\n});\n","userModified":false}}

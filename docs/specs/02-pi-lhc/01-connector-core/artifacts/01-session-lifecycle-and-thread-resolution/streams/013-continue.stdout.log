{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EYJ6QjTkAFnhjYkiGTnHjm","type":"tool_result","content":"125\t    composeTurnRendering: notConfigured,\n126\t    projectLowerBand: notConfigured,\n127\t    summarizeChunkDetailed: notConfigured,\n128\t    summarizeChunkBrief: notConfigured,\n129\t  };\n130\t}\n131\t\n132\t/** The production observe-only SDK config: a real, construction-valid instance\n133\t *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n134\t *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n135\t *  config. */\n136\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n137\t  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n138\t}\n139\t\n140\t/** Default `--resume` selection (sufficient for Story 1): resume the most\n141\t *  recently created thread in the cwd. The choices arrive in creation order, so\n142\t *  the last is the most recent. An interactive operator picker awaits a PI input\n143\t *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\n144\t *  then this is the production selection, and tests drive an explicit choice\n145\t *  through the injected selector. */\n146\tfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\n147\t  const mostRecent = choices.at(-1);\n148\t  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\n149\t}\n150\t\n151\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n152\t *  generated by the registry at creation, so the file name is just a unique\n153\t *  handle; the directory is ensured up front (DatabaseSync does not create\n154\t *  parents). */\n155\tfunction defaultNewThreadFilePath(): string {\n156\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n157\t  mkdirSync(dir, { recursive: true });\n158\t  return join(dir, `${randomUUID()}.sqlite`);\n159\t}\n160\t\n161\tfunction threadIdOf(ref: ThreadRef): string | null {\n162\t  return \"threadId\" in ref ? ref.threadId : null;\n163\t}\n164\t\n165\t// The durable resolved thread id for the current session, held at MODULE scope\n166\t// (not in a connector closure) so it survives the extension teardown/re-init a\n167\t// reload performs: a PI process runs one session at a time, so a single\n168\t// \"current thread id\" is unambiguous, and a fresh connector created by the next\n169\t// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\n170\t// PI-session→thread mapping or a durable file — so process death correctly drops\n171\t// it and the next launch re-resolves (no early-crash window, no recovery\n172\t// sidecar; epic I-1). Cleared on any non-reload teardown.\n173\tlet rememberedSessionThreadId: string | null = null;\n174\t\n175\t/** Reset the module-level reload memory. Test seam so each test starts from a\n176\t *  clean durable state; also the hook a full teardown would call. */\n177\texport function resetSessionThreadMemory(): void {\n178\t  rememberedSessionThreadId = null;\n179\t}\n180\t\n181\t/** Build a connector instance. Its mutable state lives in this closure; the\n182\t *  registered handlers capture it, so the instance stays live for the session\n183\t *  even when `activate` discards the returned object. */\n184\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n185\t  // The connector's retained state. `state` is plain data (the durable thread\n186\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n187\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\n188\t  // durable reload id lives at MODULE scope (above), not here, so it survives\n189\t  // this closure being torn down on reload.\n190\t  let state: SessionState | null = null;\n191\t  let instance: LhcInstance | null = null;\n192\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n193\t\n194\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n195\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n196\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n197\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n198\t\n199\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n200\t    return { code, message, recordedGap: false };\n201\t  }\n202\t\n203\t  // On reload (same session continues, the connector torn down and re-created)\n204\t  // reconstruct the SAME thread from its durable id rather than re-running the\n205\t  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\n206\t  // id is read from the module-level reload memory, which survives this closure;\n207\t  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\n208\t  // the fallback, covering --session/--continue/--resume reloads. The permanent\n209\t  // home for reload lineage is LHC thread metadata (Feature 2+).\n210\t  function launchFor(event: { reason: string }): LaunchFlags {\n211\t    if (event.reason === \"reload\" && rememberedSessionThreadId !== null) {\n212\t      return { session: rememberedSessionThreadId };\n213\t    }\n214\t    return parseLaunch();\n215\t  }\n216\t\n217\t  async function resolveForLaunch(\n218\t    launch: LaunchFlags,\n219\t    ctx: ExtensionContext,\n220\t  ): Promise<OpResult<ThreadRef | null>> {\n221\t    if (launch.resume === true) {\n222\t      const pickerDeps: {\n223\t        registryPath?: string;\n224\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n225\t      } = { select: (choices) => selectThread(choices, ctx) };\n226\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n227\t      return pickThread(ctx.cwd, pickerDeps);\n228\t    }\n229\t    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n230\t      cwd: ctx.cwd,\n231\t      newThreadFilePath,\n232\t    };\n233\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n234\t    return resolveThread(launch, resolveDeps);\n235\t  }\n236\t\n237\t  // session_start: resolve the recording thread from the launch and construct\n238\t  // one background instance against it. Config is gated first so a session with\n239\t  // no usable inference config resolves/creates nothing (no orphan thread).\n240\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n241\t    const config = buildSdkConfig(ctx);\n242\t    if (!config.ok) {\n243\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n244\t      return;\n245\t    }\n246\t    const resolved = await resolveForLaunch(launchFor(event), ctx);\n247\t    if (!resolved.ok) {\n248\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n249\t      return;\n250\t    }\n251\t    if (resolved.value === null) {\n252\t      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n253\t      return;\n254\t    }\n255\t    const built = await initInstance(resolved.value, config.value);\n256\t    if (!built.ok) {\n257\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n258\t      return;\n259\t    }\n260\t    instance = built.value;\n261\t    state = createSessionState(resolved.value);\n262\t    rememberedSessionThreadId = threadIdOf(resolved.value);\n263\t  };\n264\t\n265\t  // Dispose with flush before any session swap (session_before_switch fires\n266\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n267\t  // no live instance is a no-op. The durable reload id is kept across a reload\n268\t  // (the session continues and will reattach) and cleared on any other teardown\n269\t  // so a later new/resume session never reattaches a stale thread.\n270\t  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\n271\t    const result = await disposeInstance(instance);\n272\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n273\t    instance = null;\n274\t    const isReload = \"reason\" in event && event.reason === \"reload\";\n275\t    if (!isReload) rememberedSessionThreadId = null;\n276\t  };\n277\t\n278\t  // Contain every handler: an observe-only hook must never throw back into PI\n279\t  // (a thrown hook breaks the user's session). A caught error becomes a\n280\t  // plain-data diagnostic; it is never rethrown.\n281\t  const guard = (\n282\t    name: Epic1Hook,\n283\t    body: PiHookHandler<Epic1Hook>,\n284\t  ): PiHookHandler<Epic1Hook> => {\n285\t    return async (ctx, event): Promise<void> => {\n286\t      try {\n287\t        await body(ctx, event);\n288\t      } catch (err) {\n289\t        lastDiagnostic = {\n290\t          code: \"hook_handler_error\",\n291\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n292\t          recordedGap: false,\n293\t        };\n294\t      }\n295\t    };\n296\t  };\n297\t\n298\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n299\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n300\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\n301\t  const noop: PiHookHandler<Epic1Hook> = () => {\n302\t    // Intentionally empty — later stories replace this with real routing.\n303\t  };\n304\t\n305\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n306\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n307\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n308\t    session_before_switch: onDispose,\n309\t    session_shutdown: onDispose,\n310\t    message_end: noop,\n311\t    turn_end: noop,\n312\t    agent_end: noop,\n313\t    model_select: noop,\n314\t    thinking_level_select: noop,\n315\t    session_before_fork: noop,\n316\t  };\n317\t\n318\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n319\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n320\t\n321\t  return {\n322\t    handlers,\n323\t    register(pi: ExtensionAPI): void {\n324\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n325\t    },\n326\t    getState(): SessionState | null {\n327\t      return state;\n328\t    },\n329\t    getInstance(): LhcInstance | null {\n330\t      return instance;\n331\t    },\n332\t    snapshot(): ConnectorSnapshot {\n333\t      return { state, lastDiagnostic };\n334\t    },\n335\t  };\n336\t}\n337\t\n338\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n339\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n340\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n341\t *  observe-only SDK config, the most-recent `--resume` selection, and the\n342\t *  module-level reload memory — so a live session_start resolves/creates and\n343\t *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\n344\t *  config; reload reconstruction reads the durable id the prior activation left"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"52335290-a5b3-47d8-846e-ef972a72864c","timestamp":"2026-06-14T05:52:44.696Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"    composeTurnRendering: notConfigured,\n    projectLowerBand: notConfigured,\n    summarizeChunkDetailed: notConfigured,\n    summarizeChunkBrief: notConfigured,\n  };\n}\n\n/** The production observe-only SDK config: a real, construction-valid instance\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\n *  config. */\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \"background\" } };\n}\n\n/** Default `--resume` selection (sufficient for Story 1): resume the most\n *  recently created thread in the cwd. The choices arrive in creation order, so\n *  the last is the most recent. An interactive operator picker awaits a PI input\n *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\n *  then this is the production selection, and tests drive an explicit choice\n *  through the injected selector. */\nfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\nfunction threadIdOf(ref: ThreadRef): string | null {\n  return \"threadId\" in ref ? ref.threadId : null;\n}\n\n// The durable resolved thread id for the current session, held at MODULE scope\n// (not in a connector closure) so it survives the extension teardown/re-init a\n// reload performs: a PI process runs one session at a time, so a single\n// \"current thread id\" is unambiguous, and a fresh connector created by the next\n// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\n// PI-session→thread mapping or a durable file — so process death correctly drops\n// it and the next launch re-resolves (no early-crash window, no recovery\n// sidecar; epic I-1). Cleared on any non-reload teardown.\nlet rememberedSessionThreadId: string | null = null;\n\n/** Reset the module-level reload memory. Test seam so each test starts from a\n *  clean durable state; also the hook a full teardown would call. */\nexport function resetSessionThreadMemory(): void {\n  rememberedSessionThreadId = null;\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\n  // durable reload id lives at MODULE scope (above), not here, so it survives\n  // this closure being torn down on reload.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // On reload (same session continues, the connector torn down and re-created)\n  // reconstruct the SAME thread from its durable id rather than re-running the\n  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\n  // id is read from the module-level reload memory, which survives this closure;\n  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\n  // the fallback, covering --session/--continue/--resume reloads. The permanent\n  // home for reload lineage is LHC thread metadata (Feature 2+).\n  function launchFor(event: { reason: string }): LaunchFlags {\n    if (event.reason === \"reload\" && rememberedSessionThreadId !== null) {\n      return { session: rememberedSessionThreadId };\n    }\n    return parseLaunch();\n  }\n\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n      cwd: ctx.cwd,\n      newThreadFilePath,\n    };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveThread(launch, resolveDeps);\n  }\n\n  // session_start: resolve the recording thread from the launch and construct\n  // one background instance against it. Config is gated first so a session with\n  // no usable inference config resolves/creates nothing (no orphan thread).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n    const resolved = await resolveForLaunch(launchFor(event), ctx);\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n    const built = await initInstance(resolved.value, config.value);\n    if (!built.ok) {\n      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n      return;\n    }\n    instance = built.value;\n    state = createSessionState(resolved.value);\n    rememberedSessionThreadId = threadIdOf(resolved.value);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. The durable reload id is kept across a reload\n  // (the session continues and will reattach) and cleared on any other teardown\n  // so a later new/resume session never reattaches a stale thread.\n  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    const isReload = \"reason\" in event && event.reason === \"reload\";\n    if (!isReload) rememberedSessionThreadId = null;\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n  // land in later stories. Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — later stories replace this with real routing.\n  };\n\n  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: noop,\n    turn_end: noop,\n    agent_end: noop,\n    model_select: noop,\n    thinking_level_select: noop,\n    session_before_fork: noop,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, the most-recent `--resume` selection, and the\n *  module-level reload memory — so a live session_start resolves/creates and\n *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\n *  config; reload reconstruction reads the durable id the prior activation left","numLines":220,"startLine":125,"totalLines":351}}}

chFlags,\n227\t    ctx: ExtensionContext,\n228\t  ): Promise<OpResult<ThreadRef | null>> {\n229\t    if (launch.resume === true) {\n230\t      const pickerDeps: {\n231\t        registryPath?: string;\n232\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n233\t      } = { select: (choices) => selectThread(choices, ctx) };\n234\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n235\t      return pickThread(ctx.cwd, pickerDeps);\n236\t    }\n237\t    return resolveThread(launch, buildResolveDeps(ctx));\n238\t  }\n239\t\n240\t  // Reload resolution (AC-1.5): the extension is re-initialized while the same\n241\t  // session continues, so re-resolve the SAME thread from the DURABLE registry\n242\t  // instead of re-running the launch — a no-flag launch would otherwise create a\n243\t  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\n244\t  // the resolved id comes back out of the registry. See `resolveReloadThread`.\n245\t  async function resolveReloadFor(\n246\t    launch: LaunchFlags,\n247\t    ctx: ExtensionContext,\n248\t  ): Promise<OpResult<ThreadRef | null>> {\n249\t    return resolveReloadThread(launch, buildResolveDeps(ctx));\n250\t  }\n251\t\n252\t  // session_start: resolve the recording thread and construct one background\n253\t  // instance against it. Config is gated first so a session with no usable\n254\t  // inference config resolves/creates nothing (no orphan thread). On reload the\n255\t  // thread is re-resolved from the durable registry (reattach, never create);\n256\t  // every other reason runs the normal launch resolution.\n257\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n258\t    const config = buildSdkConfig(ctx);\n259\t    if (!config.ok) {\n260\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n261\t      return;\n262\t    }\n263\t    const launch = parseLaunch();\n264\t    c
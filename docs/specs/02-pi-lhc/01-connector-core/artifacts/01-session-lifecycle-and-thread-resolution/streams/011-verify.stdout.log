newThreadTitle ?? defaultThreadTitle(deps.cwd),\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:102:    ...registryArg(deps.registryPath),\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:105:  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:110: *  production source of the launch mode. Supports `--session <id>`,\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:111: *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:112: *  spelling for the named-session mode is an integration detail to confirm\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:118:    if (arg === undefined) continue;\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:119:    if (arg === \"--resume\" || arg === \"-r\") {\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:120:      flags.resume = true;\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:121:    } else if (arg === \"--continue\" || arg === \"-c\") {\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:122:      flags.continue = true;\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:123:    } else if (arg === \"--session\") {\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:126:        flags.session = next;\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:129:    } else if (arg.startsWith(\"--session=\")) {\npackages/pi-lhc/src/lifecycle/thread-resolution.ts:130:      flags.session = arg.slice(\"--session=\".length);\npackages/pi-lhc/src/verify/replay.ts:22:/** Fail-closed until Story 3 — `matches:false`, never a faked pass (story\npackages/pi-lhc/src/verify/replay.ts:23: *  §Anti-Shim: no stub reports successful replay). */\npackages/pi-lhc/src/verify/replay.ts:25:  return Promise.resolve({\npackages/pi-lhc/src/verify/replay.ts:27:    diff: \"verify.replayCorpus is not implemented yet (Epic 1 foundation stub)\",\npackages/pi-lhc/src/pi/types.ts:18:  | \"session_start\"\npackages/pi-lhc/src/pi/types.ts:24:  | \"session_before_fork\"\npackages/pi-lhc/src/pi/types.ts:25:  | \"session_before_switch\"\npackages/pi-lhc/src/pi/types.ts:26:  | \"session_shutdown\"\npackages/pi-lhc/src/pi/types.ts:29:export type SessionStartReason = \"startup\" | \"reload\" | \"new\" | \"resume\" | \"fork\";\npackages/pi-lhc/src/pi/types.ts:30:export type SessionShutdownReason = \"shutdown\" | \"reload\" | \"new\" | \"resume\";\npackages/pi-lhc/src/pi/types.ts:64:  intent: \"new\" | \"resume\";\npackages/pi-lhc/src/pi/types.ts:77:  session_start: SessionStartEvent;\npackages/pi-lhc/src/pi/types.ts:83:  session_before_fork: SessionBeforeForkEvent;\npackages/pi-lhc/src/pi/types.ts:84:  session_before_switch: SessionBeforeSwitchEvent;\npackages/pi-lhc/src/pi/types.ts:85:  session_shutdown: SessionShutdownEvent;\npackages/pi-lhc/src/pi/types.ts:90: *  connector must never retain it across calls (PI replaces session objects on\npackages/pi-lhc/src/pi/types.ts:91: *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\npackages/pi-lhc/src/pi/types.ts:158:  sessionManager: SessionManager;\npackages/pi-lhc/src/lifecycle/fork.ts:3:import { NotImplementedError, notImplemented } from \"../shared/not-implemented.js\";\npackages/pi-lhc/src/lifecycle/fork.ts:13:/** Detect a fork and its point from the `session_before_fork` hook (PI session\npackages/pi-lhc/src/lifecycle/fork.ts:14: *  tree as the Epic-1 fallback). Throws until Story 4 — a stub that returned\npackages/pi-lhc/src/lifecycle/fork.ts:18:  throw new NotImplementedError(\"lifecycle.detectFork\");\npackages/pi-lhc/src/lifecycle/fork.ts:29:  return Promise.resolve(notImplemented<void>(\"lifecycle.seedFork\"));\npackages/pi-lhc/src/capture/idempotency.ts:2:import { NotImplementedError } from \"../shared/not-implemented.js\";\npackages/pi-lhc/src/capture/idempotency.ts:20:  throw new NotImplementedError(\"capture.eventKey\");\npackages/pi-lhc/src/capture/runtime-changes.ts:3:import { NotImplementedError } from \"../shared/not-implemented.js\";\npackages/pi-lhc/src/capture/runtime-changes.ts:13:  throw new NotImplementedError(\"capture.mapModelSelect\");\npackages/pi-lhc/src/capture/runtime-changes.ts:21:  throw new NotImplementedError(\"capture.mapThinkingLevelSelect\");\npackages/pi-lhc/src/shared/instance.ts:3:/** A constructed LHC session instance: the SDK (one per PI session, background\npackages/pi-lhc/src/shared/instance.ts:6: *  connector retains between hooks — never a PI `ctx`/session object, which PI\npackages/pi-lhc/src/shared/instance.ts:7: *  replaces on new/resume/fork (tech design Flow 1, plain-data rule).\npackages/pi-lhc/src/capture/converter.ts:15:  return Promise.resolve(notImplemented<BatchResult>(\"capture.capture\"));\npackages/pi-lhc/src/capture/turn-accumulator.ts:2:import { NotImplementedError } from \"../shared/not-implemented.js\";\npackages/pi-lhc/src/capture/turn-accumulator.ts:10:    throw new NotImplementedError(\"capture.TurnAccumulator.onMessage\");\npackages/pi-lhc/src/capture/turn-accumulator.ts:15:    throw new NotImplementedError(\"capture.TurnAccumulator.onAgentEnd\");\npackages/pi-lhc/src/capture/turn-accumulator.ts:19:    throw new NotImplementedError(\"capture.TurnAccumulator.hasOpenTurn\");\npackages/pi-lhc/src/shared/not-implemented.ts:3:// The two fail-closed primitives every Epic 1 stub uses until its owning story\npackages/pi-lhc/src/shared/not-implemented.ts:4:// lands. The anti-shim rule (story §Anti-Shim Requirements): no stub may report\npackages/pi-lhc/src/shared/not-implemented.ts:6:// replay. Pure algorithms throw `NotImplementedError`; services/adapters return\npackages/pi-lhc/src/shared/not-implemented.ts:10:/** Thrown by pure-algorithm stubs (map-message, idempotency, turn-accumulator,\npackages/pi-lhc/src/shared/not-implemented.ts:12: *  never that this was thrown (test-plan: \"never asserting on NotImplementedError\"). */\npackages/pi-lhc/src/shared/not-implemented.ts:13:expor
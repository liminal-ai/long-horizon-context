{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/lifecycle/thread-resolution.test.ts | sed -n '240,390p'\"","aggregated_output":"   240\t  it(\"TC-1.2: session_start resolving an existing thread creates no second thread\", async () => {\n   241\t    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n   242\t    const before = await threadCount();\n   243\t\n   244\t    const connector = productionConnector(() => ({ session: existingId }));\n   245\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"startup\"));\n   246\t\n   247\t    const state = connector.getState();\n   248\t    expect(state).not.toBeNull();\n   249\t    if (state === null) return;\n   250\t    expect(idOf(state.threadRef)).toBe(existingId);\n   251\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n   252\t    expect(await threadCount()).toBe(before); // no second thread\n   253\t  });\n   254\t\n   255\t  it(\"TC-1.7: production --resume presents the cwd-scoped titled candidates via ctx.ui.notify and resolves a selection\", async () => {\n   256\t    await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n   257\t    const recent = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n   258\t    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n   259\t    const before = await threadCount();\n   260\t\n   261\t    // A ctx WITH a UI captures exactly what the picker presents to the operator.\n   262\t    const notes: string[] = [];\n   263\t    const ctx: ExtensionContext = {\n   264\t      cwd: \"/work/resume\",\n   265\t      hasUI: true,\n   266\t      modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\n   267\t      ui: { notify: (message) => notes.push(message) },\n   268\t      sessionManager: { getEntries: () => [] },\n   269\t    };\n   270\t\n   271\t    const connector = productionConnector(() => ({ resume: true }));\n   272\t    await connector.handlers.session_start(ctx, makeSessionStart(\"resume\"));\n   273\t\n   274\t    // The operator was shown the cwd-scoped candidate list — only this cwd's\n   275\t    // threads, each with title and creation time — through ctx.ui.notify (the\n   276\t    // only PI v0.79.2 surface; selection resolves to the best available default).\n   277\t    expect(notes).toHaveLength(1);\n   278\t    const shown = notes[0]!;\n   279\t    expect(shown).toContain(\"older\");\n   280\t    expect(shown).toContain(\"newer\");\n   281\t    expect(shown).not.toContain(\"different cwd\"); // a different cwd is not offered\n   282\t    const recentRow = await threads.resolve({ threadId: recent, registryPath: store.registryPath });\n   283\t    if (recentRow.ok) expect(shown).toContain(recentRow.value.createdAt); // creation time shown\n   284\t\n   285\t    const state = connector.getState();\n   286\t    expect(state).not.toBeNull();\n   287\t    if (state === null) return;\n   288\t    expect(idOf(state.threadRef)).toBe(recent); // best available explicit default selection\n   289\t    expect(connector.getInstance()).not.toBeNull();\n   290\t    expect(await threadCount()).toBe(before); // resumed, not created\n   291\t  });\n   292\t\n   293\t  it(\"TC-1.7: production --resume is headless-safe — no notify when ctx.hasUI is false, still resolves\", async () => {\n   294\t    await makeThread({ cwd: \"/work/headless\", title: \"only\" });\n   295\t    const before = await threadCount();\n   296\t\n   297\t    const connector = productionConnector(() => ({ resume: true }));\n   298\t    // syntheticCtx has hasUI:false and a no-op notify; the picker must not assume\n   299\t    // a UI (tech design I-9: guard on headless, not on ctx.ui absence).\n   300\t    await connector.handlers.session_start(syntheticCtx(\"/work/headless\"), makeSessionStart(\"resume\"));\n   301\t\n   302\t    const state = connector.getState();\n   303\t    expect(state).not.toBeNull();\n   304\t    if (state === null) return;\n   305\t    expect(connector.getInstance()).not.toBeNull();\n   306\t    expect(await threadCount()).toBe(before); // resolved without failing\n   307\t  });\n   308\t});\n   309\t\n   310\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n   311\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n   312\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n   313\t\n   314\t    // session_start with a ctx carrying methods.\n   315\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n   316\t    expect(connector.getState()).not.toBeNull();\n   317\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n   318\t    // ...but the snapshot is plain data only — it survives structuredClone even\n   319\t    // though the live ctx and instance carry methods (they are not in it).\n   320\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   321\t    const threadRefBefore = connector.getState()?.threadRef;\n   322\t\n   323\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n   324\t    // holder still references no prior ctx.\n   325\t    await connector.handlers.message_end(\n   326\t      syntheticCtx(\"/work/a\"),\n   327\t      makeMessageEnd(makeUserMessage(\"hi\")),\n   328\t    );\n   329\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   330\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n   331\t  });\n   332\t});\n   333\t\n   334\tdescribe(\"Story 1: reload reconstruction from durable registry state (AC-1.5)\", () => {\n   335\t  it(\"TC-1.5: a FRESH connector reattaches to the same thread from the registry on reload — no module handoff, no duplicate\", async () => {\n   336\t    const cwd = \"/work/reload\";\n   337\t\n   338\t    // Connector A: a no-flag session creates the thread (cwd + default title).\n   339\t    const connectorA = productionConnector(() => ({}));\n   340\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n   341\t    const stateA = connectorA.getState();\n   342\t    expect(stateA).not.toBeNull();\n   343\t    if (stateA === null) return;\n   344\t    const firstId = idOf(stateA.threadRef);\n   345\t    const countAfterNew = await threadCount();\n   346\t\n   347\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n   348\t    expect(row.ok).toBe(true);\n   349\t    if (row.ok) {\n   350\t      expect(row.value.cwd).toBe(cwd);\n   351\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n   352\t    }\n   353\t\n   354\t    // Reload: shutdown{reload}, then connector A is TORN DOWN and never\n   355\t    // referenced again. A brand-new connector handles the reload with an EMPTY\n   356\t    // closure and a still-no-flag launch (which would otherwise create a\n   357\t    // duplicate). The connector keeps NO module-level handoff state, so the only\n   358\t    // thing bridging the teardown is the durable registry — this is what proves\n   359\t    // reconstruction survives loss of every in-memory holder (SV-001).\n   360\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   361\t\n   362\t    const connectorB = productionConnector(() => ({}));\n   363\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   364\t\n   365\t    const stateB = connectorB.getState();\n   366\t    expect(stateB).not.toBeNull();\n   367\t    if (stateB === null) return;\n   368\t    expect(idOf(stateB.threadRef)).toBe(firstId); // re-resolved from the registry\n   369\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n   370\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n   371\t  });\n   372\t\n   373\t  it(\"reload reattaches by re-resolving --session from the registry (durable id evidence), creating nothing\", async () => {\n   374\t    const cwd = \"/work/reload-session\";\n   375\t    const existing = await makeThread({ cwd, title: \"carried\" });\n   376\t    const before = await threadCount();\n   377\t\n   378\t    // Launched with --session <id>: reload re-resolves the SAME id from the\n   379\t    // durable registry, independent of any in-memory state.\n   380\t    const connectorA = productionConnector(() => ({ session: existing }));\n   381\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"startup\"));\n   382\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n   383\t\n   384\t    const connectorB = productionConnector(() => ({ session: existing }));\n   385\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n   386\t    expect(idOf(connectorB.getState()!.threadRef)).toBe(existing);\n   387\t    expect(await threadCount()).toBe(before); // no thread created on reload\n   388\t  });\n   389\t\n   390\t  it(\"a no-flag 'new' session always creates a new thread — reattach is reload-only, keyed on the start reason, not on retained memory\", async () => {\n","exit_code":0,"status":"completed"}}

record\" (epic I-1): it lives in the LHC registry,\n   128\t *  the system of record, not in a connector field or a recovery sidecar. The\n   129\t *  cwd-most-recent reattach is an Epic-1 convenience; the permanent home for\n   130\t *  reload/fork lineage is LHC thread metadata (Feature 2+). */\n   131\texport async function resolveReloadThread(\n   132\t  launch: LaunchFlags,\n   133\t  deps: ResolveDeps,\n   134\t): Promise<OpResult<ThreadRef | null>> {\n   135\t  if (launch.session !== undefined) {\n   136\t    return resolveThread({ session: launch.session }, deps);\n   137\t  }\n   138\t  if (launch.continue === true) {\n   139\t    return resolveThread({ continue: true }, deps);\n   140\t  }\n   141\t  const listed = await threads.listThreads({ cwd: deps.cwd, ...registryArg(deps.registryPath) });\n   142\t  if (!listed.ok) return listed;\n   143\t  // listThreads orders by created_at then rowid, so the last cwd-scoped row is\n   144\t  // the most recently created thread for this directory.\n   145\t  const mostRecent = listed.value.at(-1);\n   146\t  if (mostRecent === undefined) return { ok: true, value: null };\n   147\t  return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n   148\t}\n   149\t\n   150\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n   151\t *  so PI's launch arguments are visible on `process.argv`; this is the\n   152\t *  production source of the launch mode. Supports `--session <id>`,\n   153\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n   154\t *  spelling for the named-session mode is an integration detail to confirm\n   155\t *  against PI; see the story payload's open questions.) */\n   156\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n   157\t  const flags: LaunchFlags = {};\n   158\t  for (let i = 0; i < argv.length; i += 1) {\n   159\t    const arg = argv[i];\n   160\t    if (arg === undefined) cont
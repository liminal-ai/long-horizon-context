\tfunction defaultSelectThread(\n   168\t  choices: readonly ThreadChoice[],\n   169\t  ctx: ExtensionContext,\n   170\t): Promise<string | null> {\n   171\t  const mostRecent = choices.at(-1);\n   172\t  if (mostRecent === undefined) return Promise.resolve(null);\n   173\t  if (ctx.hasUI) {\n   174\t    ctx.ui.notify(renderResumeCandidates(choices), { level: \"info\" });\n   175\t  }\n   176\t  return Promise.resolve(mostRecent.threadId);\n   177\t}\n   178\t\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PipoZgmBF7jaz45X7Qsggs","type":"tool_result","content":"1\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\n2\t// reconstruction. Two layers are covered: the resolver/picker functions\n3\t// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\n4\t// PRODUCTION connector path through createConnector with real defaults (no\n5\t// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\n6\t// throughout; the module-level reload memory is reset per test.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  createDeterministicProvider,\n10\t  inspect,\n11\t  threads,\n12\t  type SdkConfig,\n13\t  type ThreadRef,\n14\t} from \"lhc\";\n15\timport { createConnector, resetSessionThreadMemory } from \"../../src/index.js\";\n16\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n17\timport {\n18\t  defaultThreadTitle,\n19\t  parseLaunchFlags,\n20\t  resolveThread,\n21\t  type ResolveDeps,\n22\t} from \"../../src/lifecycle/thread-resolution.js\";\n23\timport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\n24\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n25\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n26\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n27\t\n28\tlet store: TempStore;\n29\tbeforeEach(() => {\n30\t  store = tempStore();\n31\t  resetSessionThreadMemory(); // the connector's reload memory is module-level\n32\t});\n33\tafterEach(() => {\n34\t  store.cleanup();\n35\t});\n36\t\n37\tfunction backgroundConfig(): SdkConfig {\n38\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n39\t}\n40\t\n41\tfunction idOf(ref: ThreadRef): string {\n42\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n43\t  return ref.threadId;\n44\t}\n45\t\n46\tfunction deps(cwd = \"/work/default\"): ResolveDeps {\n47\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n48\t}\n49\t\n50\t// Create a thread directly with explicit cwd/title, for picker fixtures and\n51\t// existing-thread setup. (Connector-created threads get cwd plus a default title\n52\t// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\n53\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n54\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n55\t    filePath: store.threadPath(),\n56\t    registryPath: store.registryPath,\n57\t  };\n58\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n59\t  if (opts.title !== undefined) input.title = opts.title;\n60\t  const created = await threads.newThread(input);\n61\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n62\t  return created.value.threadId;\n63\t}\n64\t\n65\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n66\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\n67\t// object, modelling PI handing a fresh ctx to each hook.\n68\tfunction syntheticCtx(cwd: string): ExtensionContext {\n69\t  return {\n70\t    cwd,\n71\t    hasUI: false,\n72\t    modelRegistry: {\n73\t      find: () => undefined,\n74\t      hasConfiguredAuth: () => false,\n75\t      getAvailable: () => [],\n76\t    },\n77\t    ui: { notify: () => {} },\n78\t    sessionManager: { getEntries: () => [] },\n79\t  };\n80\t}\n81\t\n82\t// A connector wired with production defaults (real SDK config + selector) and\n83\t// only environment overrides — the activate() path, minus the global registry\n84\t// and process.argv.\n85\tfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n86\t  return createConnector({\n87\t    registryPath: store.registryPath,\n88\t    newThreadFilePath: () => store.threadPath(),\n89\t    parseLaunch: launch,\n90\t  });\n91\t}\n92\t\n93\tasync function threadCount(): Promise<number> {\n94\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\n95\t  return listed.ok ? listed.value.length : -1;\n96\t}\n97\t\n98\tdescribe(\"Story 1: launch-driven thread resolution (resolver/picker)\", () => {\n99\t  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n100\t    // no flag → a new thread\n101\t    const first = await resolveThread({}, deps());\n102\t    expect(first.ok).toBe(true);\n103\t    if (!first.ok) return;\n104\t    const firstId = idOf(first.value);\n105\t\n106\t    // --session full id → the same thread\n107\t    const byFull = await resolveThread({ session: firstId }, deps());\n108\t    expect(byFull.ok).toBe(true);\n109\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n110\t\n111\t    // --session partial id → the same thread\n112\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n113\t    expect(byPartial.ok).toBe(true);\n114\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n115\t\n116\t    // a second thread, then --continue → the most recently created\n117\t    const second = await resolveThread({}, deps());\n118\t    expect(second.ok).toBe(true);\n119\t    if (!second.ok) return;\n120\t    const secondId = idOf(second.value);\n121\t    const continued = await resolveThread({ continue: true }, deps());\n122\t    expect(continued.ok).toBe(true);\n123\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n124\t\n125\t    // unresolvable id → actionable error, no thread created\n126\t    const before = await threadCount();\n127\t    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n128\t    expect(bad.ok).toBe(false);\n129\t    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n130\t    expect(await threadCount()).toBe(before);\n131\t\n132\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\n133\t    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n134\t    expect(ambiguous.ok).toBe(false);\n135\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n136\t    expect(await threadCount()).toBe(before);\n137\t  });\n138\t\n139\t  it(\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\", () => {\n140\t    expect(parseLaunchFlags([\"node\", \"pi\"])).toEqual({});\n141\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--resume\"])).toEqual({ resume: true });\n142\t    expect(parseLaunchFlags([\"node\", \"pi\", \"-r\"])).toEqual({ resume: true });\n143\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--continue\"])).toEqual({ continue: true });\n144\t    expect(parseLaunchFlags([\"node\", \"pi\", \"-c\"])).toEqual({ continue: true });\n145\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--session\", \"th_abc\"])).toEqual({ session: \"th_abc\" });\n146\t    expect(parseLaunchFlags([\"node\", \"pi\", \"--session=th_xyz\"])).toEqual({ session: \"th_xyz\" });\n147\t  });\n148\t\n149\t  it(\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\", async () => {\n150\t    const created = await resolveThread({}, deps(\"/work/proj-x\"));\n151\t    expect(created.ok).toBe(true);\n152\t    if (!created.ok) return;\n153\t    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\n154\t    expect(row.ok).toBe(true);\n155\t    if (!row.ok) return;\n156\t    expect(row.value.cwd).toBe(\"/work/proj-x\");\n157\t    expect(row.value.title).toBe(defaultThreadTitle(\"/work/proj-x\")); // \"proj-x\"\n158\t  });\n159\t\n160\t  it(\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n161\t    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n162\t    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n163\t    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n164\t\n165\t    let offered: readonly ThreadChoice[] = [];\n166\t    const picked = await pickThread(\"/work/a\", {\n167\t      registryPath: store.registryPath,\n168\t      select: (choices) => {\n169\t        offered = choices;\n170\t        return Promise.resolve(choices[0]!.threadId);\n171\t      },\n172\t    });\n173\t    expect(picked.ok).toBe(true);\n174\t\n175\t    // Only the current cwd's threads are offered, each with title + creation time.\n176\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n177\t    for (const choice of offered) {\n178\t      expect(choice.createdAt).toBeTruthy();\n179\t      expect(choice.title).toBeTruthy();\n180\t    }\n181\t\n182\t    // The operator's selection resolves to that thread.\n183\t    if (picked.ok && picked.value !== null) {\n184\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n185\t    }\n186\t\n187\t    // An empty cwd reports an empty list (null) without failing or prompting.\n188\t    let selectCalled = false;\n189\t    const empty = await pickThread(\"/work/empty\", {\n190\t      registryPath: store.registryPath,\n191\t      select: () => {\n192\t        selectCalled = true;\n193\t        return Promise.resolve(null);\n194\t      },\n195\t    });\n196\t    expect(empty.ok).toBe(true);\n197\t    if (empty.ok) expect(empty.value).toBeNull();\n198\t    expect(selectCalled).toBe(false);\n199\t  });\n200\t\n201\t  it(\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\", async () => {\n202\t    const cwd = \"/work/tc-1-5\";\n203\t    const created = await resolveThread({}, deps(cwd));\n204\t    expect(created.ok).toBe(true);\n205\t    if (!created.ok) return;\n206\t    const threadId = idOf(created.value);\n207\t\n208\t    const first = await initInstance(created.value, backgroundConfig());\n209\t    expect(first.ok).toBe(true);\n210\t    if (!first.ok) return;\n211\t    await first.value.sdk.intakeStream.messageEvents(\n212\t      first.value.threadRef,\n213\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n214\t    );\n215\t    await disposeInstance(first.value);\n216\t\n217\t    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\n218\t    // flag would across process death). Reconstruct purely from it.\n219\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n220\t    expect(reattached.ok).toBe(true);\n221\t    if (!reattached.ok) return;\n222\t    expect(idOf(reattached.value)).toBe(threadId);\n223\t\n224\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n225\t    expect(rebuilt.ok).toBe(true);\n226\t    if (!rebuilt.ok) return;\n227\t    await rebuilt.value.sdk.intakeStream.messageEvents(\n228\t      rebuilt.value.threadRef,\n229\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n230\t    );\n231\t    const overview = await inspect.overview(reattached.value);\n232\t    expect(overview.ok).toBe(true);\n233\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n234\t    await disposeInstance(rebuilt.value);\n235\t  });\n236\t});\n237\t\n238\tdescribe(\"Story 1: launch-driven thread resolution (production connector path)\", () => {\n239\t  it(\"TC-1.2: session_start resolving an existing thread creates no second thread\", async () => {\n240\t    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n241\t    const before = await threadCount();\n242\t\n243\t    const connector = productionConnector(() => ({ session: existingId }));\n244\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"startup\"));\n245\t\n246\t    const state = connector.getState();\n247\t    expect(state).not.toBeNull();\n248\t    if (state === null) return;\n249\t    expect(idOf(state.threadRef)).toBe(existingId);\n250\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n251\t    expect(await threadCount()).toBe(before); // no second thread\n252\t  });\n253\t\n254\t  it(\"TC-1.7: session_start --resume resumes the most recent cwd-scoped thread via the default selector\", async () => {\n255\t    await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n256\t    const recent = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n257\t    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n258\t    const before = await threadCount();\n259\t\n260\t    const connector = productionConnector(() => ({ resume: true }));\n261\t    await connector.handlers.session_start(syntheticCtx(\"/work/resume\"), makeSessionStart(\"resume\"));\n262\t\n263\t    const state = connector.getState();\n264\t    expect(state).not.toBeNull();\n265\t    if (state === null) return;\n266\t    expect(idOf(state.threadRef)).toBe(recent); // most recent in the cwd (default selection)\n267\t    expect(connector.getInstance()).not.toBeNull();\n268\t    expect(await threadCount()).toBe(before); // resumed, not created\n269\t  });\n270\t});\n271\t\n272\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n273\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n274\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n275\t\n276\t    // session_start with a ctx carrying methods.\n277\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n278\t    expect(connector.getState()).not.toBeNull();\n279\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n280\t    // ...but the snapshot is plain data only — it survives structuredClone even\n281\t    // though the live ctx and instance carry methods (they are not in it).\n282\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n283\t    const threadRefBefore = connector.getState()?.threadRef;\n284\t\n285\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n286\t    // holder still references no prior ctx.\n287\t    await connector.handlers.message_end(\n288\t      syntheticCtx(\"/work/a\"),\n289\t      makeMessageEnd(makeUserMessage(\"hi\")),\n290\t    );\n291\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n292\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n293\t  });\n294\t});\n295\t\n296\tdescribe(\"Story 1: reload reconstruction after teardown (AC-1.5)\", () => {\n297\t  it(\"TC-1.5: a FRESH connector reconstructs the same thread from durable state, with no launch flag and no duplicate\", async () => {\n298\t    const cwd = \"/work/reload\";\n299\t\n300\t    // Connector A: a no-flag session creates the thread and records its durable\n301\t    // id (in module-level memory, not the connector closure).\n302\t    const connectorA = productionConnector(() => ({}));\n303\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n304\t    const stateA = connectorA.getState();\n305\t    expect(stateA).not.toBeNull();\n306\t    if (stateA === null) return;\n307\t    const firstId = idOf(stateA.threadRef);\n308\t    const countAfterNew = await threadCount();\n309\t\n310\t    // The connector-created thread carries cwd + a default title (A-8 / SV-003).\n311\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n312\t    expect(row.ok).toBe(true);\n313\t    if (row.ok) {\n314\t      expect(row.value.cwd).toBe(cwd);\n315\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n316\t    }\n317\t\n318\t    // Reload: shutdown{reload}, then connector A is TORN DOWN (never referenced\n319\t    // again). A brand-new connector handles the reload — its closure holds no\n320\t    // prior id, and the launch is still no-flag (which would otherwise create a\n321\t    // new thread).\n322\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n323\t\n324\t    const connectorB = productionConnector(() => ({}));\n325\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n326\t\n327\t    const stateB = connectorB.getState();\n328\t    expect(stateB).not.toBeNull();\n329\t    if (stateB === null) return;\n330\t    expect(idOf(stateB.threadRef)).toBe(firstId); // reconstructed from durable state\n331\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n332\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n333\t  });\n334\t\n335\t  it(\"a non-reload teardown clears the durable memory so the next no-flag session is a NEW thread\", async () => {\n336\t    const cwd = \"/work/fresh\";\n337\t    const connectorA = productionConnector(() => ({}));\n338\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n339\t    const firstId = idOf(connectorA.getState()!.threadRef);\n340\t\n341\t    // A normal shutdown (not reload) ends the session and clears the memory.\n342\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n343\t\n344\t    const connectorB = productionConnector(() => ({}));\n345\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n346\t    const secondId = idOf(connectorB.getState()!.threadRef);\n347\t\n348\t    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\n349\t    expect(await threadCount()).toBe(2);\n350\t  });\n351\t});\n352\t"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"e786eb72-a49c-49bb-b756-41157542298e","timestamp":"2026-06-14T05:27:08.367Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts","content":"// Story 1 — launch-driven thread resolution, plain-data state, and reload\n// reconstruction. Two layers are covered: the resolver/picker functions\n// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\n// PRODUCTION connector path through createConnector with real defaults (no\n// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\n// throughout; the module-level reload memory is reset per test.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  threads,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector, resetSessionThreadMemory } from \"../../src/index.js\";\nimport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\nimport {\n  defaultThreadTitle,\n  parseLaunchFlags,\n  resolveThread,\n  type ResolveDeps,\n} from \"../../src/lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\nimport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n  resetSessionThreadMemory(); // the connector's reload memory is module-level\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction backgroundConfig(): SdkConfig {\n  return { provider: createDeterministicProvider(), mode: \"background\" };\n}\n\nfunction idOf(ref: ThreadRef): string {\n  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n  return ref.threadId;\n}\n\nfunction deps(cwd = \"/work/default\"): ResolveDeps {\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n}\n\n// Create a thread directly with explicit cwd/title, for picker fixtures and\n// existing-thread setup. (Connector-created threads get cwd plus a default title\n// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  };\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n  if (opts.title !== undefined) input.title = opts.title;\n  const created = await threads.newThread(input);\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n  return created.value.threadId;\n}\n\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\n// object, modelling PI handing a fresh ctx to each hook.\nfunction syntheticCtx(cwd: string): ExtensionContext {\n  return {\n    cwd,\n    hasUI: false,\n    modelRegistry: {\n      find: () => undefined,\n      hasConfiguredAuth: () => false,\n      getAvailable: () => [],\n    },\n    ui: { notify: () => {} },\n    sessionManager: { getEntries: () => [] },\n  };\n}\n\n// A connector wired with production defaults (real SDK config + selector) and\n// only environment overrides — the activate() path, minus the global registry\n// and process.argv.\nfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\n  return createConnector({\n    registryPath: store.registryPath,\n    newThreadFilePath: () => store.threadPath(),\n    parseLaunch: launch,\n  });\n}\n\nasync function threadCount(): Promise<number> {\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\n  return listed.ok ? listed.value.length : -1;\n}\n\ndescribe(\"Story 1: launch-driven thread resolution (resolver/picker)\", () => {\n  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n    // no flag → a new thread\n    const first = await resolveThread({}, deps());\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    const firstId = idOf(first.value);\n\n    // --session full id → the same thread\n    const byFull = await resolveThread({ session: firstId }, deps());\n    expect(byFull.ok).toBe(true);\n    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n\n    // --session partial id → the same thread\n    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n    expect(byPartial.ok).toBe(true);\n    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n\n    // a second thread, then --continue → the most recently created\n    const second = await resolveThread({}, deps());\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    const secondId = idOf(second.value);\n    const continued = await resolveThread({ continue: true }, deps());\n    expect(continued.ok).toBe(true);\n    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n\n    // unresolvable id → actionable error, no thread created\n    const before = await threadCount();\n    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n    expect(bad.ok).toBe(false);\n    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n    expect(await threadCount()).toBe(before);\n\n    // ambiguous prefix (matches both threads) → actionable error, no thread created\n    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n    expect(ambiguous.ok).toBe(false);\n    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n    expect(await threadCount()).toBe(before);\n  });\n\n  it(\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\", () => {\n    expect(parseLaunchFlags([\"node\", \"pi\"])).toEqual({});\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--resume\"])).toEqual({ resume: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"-r\"])).toEqual({ resume: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--continue\"])).toEqual({ continue: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"-c\"])).toEqual({ continue: true });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--session\", \"th_abc\"])).toEqual({ session: \"th_abc\" });\n    expect(parseLaunchFlags([\"node\", \"pi\", \"--session=th_xyz\"])).toEqual({ session: \"th_xyz\" });\n  });\n\n  it(\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\", async () => {\n    const created = await resolveThread({}, deps(\"/work/proj-x\"));\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (!row.ok) return;\n    expect(row.value.cwd).toBe(\"/work/proj-x\");\n    expect(row.value.title).toBe(defaultThreadTitle(\"/work/proj-x\")); // \"proj-x\"\n  });\n\n  it(\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n\n    let offered: readonly ThreadChoice[] = [];\n    const picked = await pickThread(\"/work/a\", {\n      registryPath: store.registryPath,\n      select: (choices) => {\n        offered = choices;\n        return Promise.resolve(choices[0]!.threadId);\n      },\n    });\n    expect(picked.ok).toBe(true);\n\n    // Only the current cwd's threads are offered, each with title + creation time.\n    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n    for (const choice of offered) {\n      expect(choice.createdAt).toBeTruthy();\n      expect(choice.title).toBeTruthy();\n    }\n\n    // The operator's selection resolves to that thread.\n    if (picked.ok && picked.value !== null) {\n      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n    }\n\n    // An empty cwd reports an empty list (null) without failing or prompting.\n    let selectCalled = false;\n    const empty = await pickThread(\"/work/empty\", {\n      registryPath: store.registryPath,\n      select: () => {\n        selectCalled = true;\n        return Promise.resolve(null);\n      },\n    });\n    expect(empty.ok).toBe(true);\n    if (empty.ok) expect(empty.value).toBeNull();\n    expect(selectCalled).toBe(false);\n  });\n\n  it(\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\", async () => {\n    const cwd = \"/work/tc-1-5\";\n    const created = await resolveThread({}, deps(cwd));\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n    const threadId = idOf(created.value);\n\n    const first = await initInstance(created.value, backgroundConfig());\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    await first.value.sdk.intakeStream.messageEvents(\n      first.value.threadRef,\n      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n    );\n    await disposeInstance(first.value);\n\n    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\n    // flag would across process death). Reconstruct purely from it.\n    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n    expect(reattached.ok).toBe(true);\n    if (!reattached.ok) return;\n    expect(idOf(reattached.value)).toBe(threadId);\n\n    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n    expect(rebuilt.ok).toBe(true);\n    if (!rebuilt.ok) return;\n    await rebuilt.value.sdk.intakeStream.messageEvents(\n      rebuilt.value.threadRef,\n      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n    );\n    const overview = await inspect.overview(reattached.value);\n    expect(overview.ok).toBe(true);\n    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n    await disposeInstance(rebuilt.value);\n  });\n});\n\ndescribe(\"Story 1: launch-driven thread resolution (production connector path)\", () => {\n  it(\"TC-1.2: session_start resolving an existing thread creates no second thread\", async () => {\n    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n    const before = await threadCount();\n\n    const connector = productionConnector(() => ({ session: existingId }));\n    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"startup\"));\n\n    const state = connector.getState();\n    expect(state).not.toBeNull();\n    if (state === null) return;\n    expect(idOf(state.threadRef)).toBe(existingId);\n    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\n    expect(await threadCount()).toBe(before); // no second thread\n  });\n\n  it(\"TC-1.7: session_start --resume resumes the most recent cwd-scoped thread via the default selector\", async () => {\n    await makeThread({ cwd: \"/work/resume\", title: \"older\" });\n    const recent = await makeThread({ cwd: \"/work/resume\", title: \"newer\" });\n    await makeThread({ cwd: \"/work/other\", title: \"different cwd\" });\n    const before = await threadCount();\n\n    const connector = productionConnector(() => ({ resume: true }));\n    await connector.handlers.session_start(syntheticCtx(\"/work/resume\"), makeSessionStart(\"resume\"));\n\n    const state = connector.getState();\n    expect(state).not.toBeNull();\n    if (state === null) return;\n    expect(idOf(state.threadRef)).toBe(recent); // most recent in the cwd (default selection)\n    expect(connector.getInstance()).not.toBeNull();\n    expect(await threadCount()).toBe(before); // resumed, not created\n  });\n});\n\ndescribe(\"Story 1: plain-data state across hooks\", () => {\n  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n    const connector = productionConnector(() => ({})); // no flag → new thread, default config\n\n    // session_start with a ctx carrying methods.\n    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n    expect(connector.getState()).not.toBeNull();\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n    // ...but the snapshot is plain data only — it survives structuredClone even\n    // though the live ctx and instance carry methods (they are not in it).\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    const threadRefBefore = connector.getState()?.threadRef;\n\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n    // holder still references no prior ctx.\n    await connector.handlers.message_end(\n      syntheticCtx(\"/work/a\"),\n      makeMessageEnd(makeUserMessage(\"hi\")),\n    );\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n  });\n});\n\ndescribe(\"Story 1: reload reconstruction after teardown (AC-1.5)\", () => {\n  it(\"TC-1.5: a FRESH connector reconstructs the same thread from durable state, with no launch flag and no duplicate\", async () => {\n    const cwd = \"/work/reload\";\n\n    // Connector A: a no-flag session creates the thread and records its durable\n    // id (in module-level memory, not the connector closure).\n    const connectorA = productionConnector(() => ({}));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const stateA = connectorA.getState();\n    expect(stateA).not.toBeNull();\n    if (stateA === null) return;\n    const firstId = idOf(stateA.threadRef);\n    const countAfterNew = await threadCount();\n\n    // The connector-created thread carries cwd + a default title (A-8 / SV-003).\n    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\n    expect(row.ok).toBe(true);\n    if (row.ok) {\n      expect(row.value.cwd).toBe(cwd);\n      expect(row.value.title).toBe(defaultThreadTitle(cwd));\n    }\n\n    // Reload: shutdown{reload}, then connector A is TORN DOWN (never referenced\n    // again). A brand-new connector handles the reload — its closure holds no\n    // prior id, and the launch is still no-flag (which would otherwise create a\n    // new thread).\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"reload\" });\n\n    const connectorB = productionConnector(() => ({}));\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"reload\"));\n\n    const stateB = connectorB.getState();\n    expect(stateB).not.toBeNull();\n    if (stateB === null) return;\n    expect(idOf(stateB.threadRef)).toBe(firstId); // reconstructed from durable state\n    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n  });\n\n  it(\"a non-reload teardown clears the durable memory so the next no-flag session is a NEW thread\", async () => {\n    const cwd = \"/work/fresh\";\n    const connectorA = productionConnector(() => ({}));\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const firstId = idOf(connectorA.getState()!.threadRef);\n\n    // A normal shutdown (not reload) ends the session and clears the memory.\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \"shutdown\" });\n\n    const connectorB = productionConnector(() => ({}));\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\"new\"));\n    const secondId = idOf(connectorB.getState()!.threadRef);\n\n    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\n    expect(await threadCount()).toBe(2);\n  });\n});\n","numLines":352,"startLine":1,"totalLines":352}}}

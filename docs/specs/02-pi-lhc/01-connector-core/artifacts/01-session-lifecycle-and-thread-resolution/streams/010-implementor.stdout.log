{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YMF17Ppdn8YxMDNHsw5HzJ","type":"tool_result","content":"1\timport { existsSync, mkdirSync } from \"node:fs\";\n2\timport { homedir } from \"node:os\";\n3\timport { dirname, join } from \"node:path\";\n4\timport type { DatabaseSync } from \"node:sqlite\";\n5\timport { openDatabase, runMigrations, type Migration } from \"../../../shared/storage.js\";\n6\t\n7\texport const DEFAULT_REGISTRY_PATH = join(homedir(), \".lhc\", \"registry.sqlite\");\n8\t\n9\texport function resolveRegistryPath(registryPath?: string): string {\n10\t  return registryPath ?? DEFAULT_REGISTRY_PATH;\n11\t}\n12\t\n13\tconst REGISTRY_MIGRATIONS: readonly Migration[] = [\n14\t  {\n15\t    version: 1,\n16\t    statements: [\n17\t      `CREATE TABLE threads (\n18\t        thread_id TEXT PRIMARY KEY,\n19\t        file_path TEXT NOT NULL,\n20\t        title TEXT,\n21\t        created_at TEXT NOT NULL\n22\t      );`,\n23\t    ],\n24\t  },\n25\t  {\n26\t    // A-8 (Epic 02 pi-lhc Story 1): the cwd a thread was created in, so the\n27\t    // `--resume` picker can scope its list to the current directory. Added as\n28\t    // its own version (not folded into v1) so a registry created under v1\n29\t    // upgrades lazily on next open rather than silently lacking the column.\n30\t    version: 2,\n31\t    statements: [`ALTER TABLE threads ADD COLUMN cwd TEXT;`],\n32\t  },\n33\t];\n34\t\n35\t// First write creates the database and schema lazily (design decision 6).\n36\texport function openRegistryForWrite(registryPath: string): DatabaseSync {\n37\t  mkdirSync(dirname(registryPath), { recursive: true });\n38\t  const db = openDatabase(registryPath);\n39\t  try {\n40\t    runMigrations(db, REGISTRY_MIGRATIONS);\n41\t  } catch (cause) {\n42\t    db.close();\n43\t    throw cause;\n44\t  }\n45\t  return db;\n46\t}\n47\t\n48\t// Reads never create the registry: callers map null to empty list /\n49\t// thread_not_found. The existence check is the non-creation guarantee —\n50\t// openDatabase would create the file. An existing registry is brought to the\n51\t// current schema on open so reads can rely on the current columns (e.g. the\n52\t// A-8 `cwd` column) regardless of which version created it; a registry already\n53\t// at the latest version pays nothing (runMigrations is a no-op).\n54\texport function openRegistryForRead(registryPath: string): DatabaseSync | null {\n55\t  if (!existsSync(registryPath)) return null;\n56\t  const db = openDatabase(registryPath);\n57\t  try {\n58\t    runMigrations(db, REGISTRY_MIGRATIONS);\n59\t  } catch (cause) {\n60\t    db.close();\n61\t    throw cause;\n62\t  }\n63\t  return db;\n64\t}\n65\t\n66\texport interface RegistryRow {\n67\t  threadId: string;\n68\t  filePath: string;\n69\t  title?: string;\n70\t  cwd?: string;\n71\t  createdAt: string;\n72\t}\n73\t\n74\tinterface RawRow {\n75\t  thread_id: string;\n76\t  file_path: string;\n77\t  title: string | null;\n78\t  cwd: string | null;\n79\t  created_at: string;\n80\t}\n81\t\n82\tconst ROW_COLUMNS = \"thread_id, file_path, title, cwd, created_at\";\n83\t\n84\t// Insertion order (rowid) breaks ties at the same created_at timestamp, so\n85\t// \"most recent\" (the last row) is the last-inserted thread even when two\n86\t// creations land in the same millisecond — the determinism `--continue`\n87\t// (resolve the most recently created thread) relies on.\n88\tconst ROW_ORDER = \"ORDER BY created_at, rowid\";\n89\t\n90\tfunction toRegistryRow(raw: RawRow): RegistryRow {\n91\t  const row: RegistryRow = {\n92\t    threadId: raw.thread_id,\n93\t    filePath: raw.file_path,\n94\t    createdAt: raw.created_at,\n95\t  };\n96\t  if (raw.title !== null) row.title = raw.title;\n97\t  if (raw.cwd !== null) row.cwd = raw.cwd;\n98\t  return row;\n99\t}\n100\t\n101\texport function insertThreadRow(db: DatabaseSync, row: RegistryRow): void {\n102\t  db.prepare(\n103\t    \"INSERT INTO threads (thread_id, file_path, title, cwd, created_at) VALUES (?, ?, ?, ?, ?)\",\n104\t  ).run(row.threadId, row.filePath, row.title ?? null, row.cwd ?? null, row.createdAt);\n105\t}\n106\t\n107\texport function selectThreadRow(\n108\t  db: DatabaseSync,\n109\t  threadId: string,\n110\t): RegistryRow | undefined {\n111\t  const raw = db\n112\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id = ?`)\n113\t    .get(threadId) as unknown as RawRow | undefined;\n114\t  return raw === undefined ? undefined : toRegistryRow(raw);\n115\t}\n116\t\n117\t// Partial-id resolve (A-8): every thread whose id begins with the given prefix.\n118\t// LIKE metacharacters in the (caller-supplied) prefix are escaped so the '_' in\n119\t// the thread-id scheme (th_<hex>) and any '%' match literally rather than as\n120\t// wildcards; ESCAPE makes '\\' the escape character.\n121\texport function selectThreadRowsByPrefix(db: DatabaseSync, prefix: string): RegistryRow[] {\n122\t  const escaped = prefix.replace(/[\\\\%_]/g, (ch) => `\\\\${ch}`);\n123\t  const raws = db\n124\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id LIKE ? ESCAPE '\\\\' ${ROW_ORDER}`)\n125\t    .all(`${escaped}%`) as unknown as RawRow[];\n126\t  return raws.map(toRegistryRow);\n127\t}\n128\t\n129\t// cwd, when given, filters at the registry (A-8): the picker must not scope by\n130\t// filtering an unscoped list after the fact (anti-shim) — the scope is the query.\n131\texport function selectAllThreadRows(\n132\t  db: DatabaseSync,\n133\t  opts: { cwd?: string } = {},\n134\t): RegistryRow[] {\n135\t  const raws =\n136\t    opts.cwd === undefined\n137\t      ? (db.prepare(`SELECT ${ROW_COLUMNS} FROM threads ${ROW_ORDER}`).all() as unknown as RawRow[])\n138\t      : (db\n139\t          .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE cwd = ? ${ROW_ORDER}`)\n140\t          .all(opts.cwd) as unknown as RawRow[]);\n141\t  return raws.map(toRegistryRow);\n142\t}\n143\t"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"235ffbd9-bba8-45b6-8661-39d8d47abd02","timestamp":"2026-06-14T05:27:36.792Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/internal/registry.ts","content":"import { existsSync, mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { dirname, join } from \"node:path\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { openDatabase, runMigrations, type Migration } from \"../../../shared/storage.js\";\n\nexport const DEFAULT_REGISTRY_PATH = join(homedir(), \".lhc\", \"registry.sqlite\");\n\nexport function resolveRegistryPath(registryPath?: string): string {\n  return registryPath ?? DEFAULT_REGISTRY_PATH;\n}\n\nconst REGISTRY_MIGRATIONS: readonly Migration[] = [\n  {\n    version: 1,\n    statements: [\n      `CREATE TABLE threads (\n        thread_id TEXT PRIMARY KEY,\n        file_path TEXT NOT NULL,\n        title TEXT,\n        created_at TEXT NOT NULL\n      );`,\n    ],\n  },\n  {\n    // A-8 (Epic 02 pi-lhc Story 1): the cwd a thread was created in, so the\n    // `--resume` picker can scope its list to the current directory. Added as\n    // its own version (not folded into v1) so a registry created under v1\n    // upgrades lazily on next open rather than silently lacking the column.\n    version: 2,\n    statements: [`ALTER TABLE threads ADD COLUMN cwd TEXT;`],\n  },\n];\n\n// First write creates the database and schema lazily (design decision 6).\nexport function openRegistryForWrite(registryPath: string): DatabaseSync {\n  mkdirSync(dirname(registryPath), { recursive: true });\n  const db = openDatabase(registryPath);\n  try {\n    runMigrations(db, REGISTRY_MIGRATIONS);\n  } catch (cause) {\n    db.close();\n    throw cause;\n  }\n  return db;\n}\n\n// Reads never create the registry: callers map null to empty list /\n// thread_not_found. The existence check is the non-creation guarantee —\n// openDatabase would create the file. An existing registry is brought to the\n// current schema on open so reads can rely on the current columns (e.g. the\n// A-8 `cwd` column) regardless of which version created it; a registry already\n// at the latest version pays nothing (runMigrations is a no-op).\nexport function openRegistryForRead(registryPath: string): DatabaseSync | null {\n  if (!existsSync(registryPath)) return null;\n  const db = openDatabase(registryPath);\n  try {\n    runMigrations(db, REGISTRY_MIGRATIONS);\n  } catch (cause) {\n    db.close();\n    throw cause;\n  }\n  return db;\n}\n\nexport interface RegistryRow {\n  threadId: string;\n  filePath: string;\n  title?: string;\n  cwd?: string;\n  createdAt: string;\n}\n\ninterface RawRow {\n  thread_id: string;\n  file_path: string;\n  title: string | null;\n  cwd: string | null;\n  created_at: string;\n}\n\nconst ROW_COLUMNS = \"thread_id, file_path, title, cwd, created_at\";\n\n// Insertion order (rowid) breaks ties at the same created_at timestamp, so\n// \"most recent\" (the last row) is the last-inserted thread even when two\n// creations land in the same millisecond — the determinism `--continue`\n// (resolve the most recently created thread) relies on.\nconst ROW_ORDER = \"ORDER BY created_at, rowid\";\n\nfunction toRegistryRow(raw: RawRow): RegistryRow {\n  const row: RegistryRow = {\n    threadId: raw.thread_id,\n    filePath: raw.file_path,\n    createdAt: raw.created_at,\n  };\n  if (raw.title !== null) row.title = raw.title;\n  if (raw.cwd !== null) row.cwd = raw.cwd;\n  return row;\n}\n\nexport function insertThreadRow(db: DatabaseSync, row: RegistryRow): void {\n  db.prepare(\n    \"INSERT INTO threads (thread_id, file_path, title, cwd, created_at) VALUES (?, ?, ?, ?, ?)\",\n  ).run(row.threadId, row.filePath, row.title ?? null, row.cwd ?? null, row.createdAt);\n}\n\nexport function selectThreadRow(\n  db: DatabaseSync,\n  threadId: string,\n): RegistryRow | undefined {\n  const raw = db\n    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id = ?`)\n    .get(threadId) as unknown as RawRow | undefined;\n  return raw === undefined ? undefined : toRegistryRow(raw);\n}\n\n// Partial-id resolve (A-8): every thread whose id begins with the given prefix.\n// LIKE metacharacters in the (caller-supplied) prefix are escaped so the '_' in\n// the thread-id scheme (th_<hex>) and any '%' match literally rather than as\n// wildcards; ESCAPE makes '\\' the escape character.\nexport function selectThreadRowsByPrefix(db: DatabaseSync, prefix: string): RegistryRow[] {\n  const escaped = prefix.replace(/[\\\\%_]/g, (ch) => `\\\\${ch}`);\n  const raws = db\n    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id LIKE ? ESCAPE '\\\\' ${ROW_ORDER}`)\n    .all(`${escaped}%`) as unknown as RawRow[];\n  return raws.map(toRegistryRow);\n}\n\n// cwd, when given, filters at the registry (A-8): the picker must not scope by\n// filtering an unscoped list after the fact (anti-shim) — the scope is the query.\nexport function selectAllThreadRows(\n  db: DatabaseSync,\n  opts: { cwd?: string } = {},\n): RegistryRow[] {\n  const raws =\n    opts.cwd === undefined\n      ? (db.prepare(`SELECT ${ROW_COLUMNS} FROM threads ${ROW_ORDER}`).all() as unknown as RawRow[])\n      : (db\n          .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE cwd = ? ${ROW_ORDER}`)\n          .all(opts.cwd) as unknown as RawRow[]);\n  return raws.map(toRegistryRow);\n}\n","numLines":143,"startLine":1,"totalLines":143}}}

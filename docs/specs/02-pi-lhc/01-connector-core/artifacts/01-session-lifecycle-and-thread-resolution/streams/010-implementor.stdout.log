{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Czvk86xiYihPtrEp7UDkYb","type":"tool_result","content":"370\t// The only assembly path: provider, mode, clock, and policy enter here.\n371\t// Config mistakes are programmer errors at construction and throw; operating\n372\t// failures after construction return OpResults per the error contract.\n373\texport function createSdk(config: SdkConfig): Lhc {\n374\t  // Provider arrival is exactly one of direct injection or the inference\n375\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n376\t  // env/flag resolution path to fall back on. The XOR rule is validated\n377\t  // before anything downstream so the error names the caller's mistake, not\n378\t  // a symptom (AC-1.1).\n379\t  if (config.provider !== undefined && config.inference !== undefined) {\n380\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n381\t  }\n382\t  if (config.provider === undefined && config.inference === undefined) {\n383\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n384\t  }\n385\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n386\t    throw new TypeError(\n387\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n388\t    );\n389\t  }\n390\t  let provider: DerivationProvider;\n391\t  if (config.inference !== undefined) {\n392\t    provider = resolveInferenceProvider(config.inference);\n393\t  } else {\n394\t    if (config.provider === null || typeof config.provider !== \"object\") {\n395\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n396\t    }\n397\t    for (const operation of PROVIDER_OPERATIONS) {\n398\t      if (typeof config.provider[operation] !== \"function\") {\n399\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n400\t      }\n401\t    }\n402\t    provider = config.provider;\n403\t  }\n404\t\n405\t  const resolved: ResolvedSdkConfig = {\n406\t    provider,\n407\t    mode: config.mode,\n408\t    clock: config.clock ?? (() => new Date()),\n409\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n410\t    lease: config.lease ?? { durationMs: 120000 },\n411\t    chunkPolicy:\n412\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n413\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n414\t    // sums and visibility budgets validated — throws naming the violation.\n415\t    view: resolveViewConfig(config.view),\n416\t  };\n417\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n418\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n419\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n420\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n421\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n422\t  }\n423\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n424\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n425\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n426\t    throw new TypeError(\n427\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n428\t    );\n429\t  }\n430\t\n431\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n432\t  // The tables are empty until Stories 2–3 land the real handlers; the\n433\t  // assembly mechanics are production code from day one.\n434\t  const workHandlers = assembleWorkHandlerMap([\n435\t    messagesDomain.workHandlers,\n436\t    turnsDomain.workHandlers,\n437\t  ]);\n438\t\n439\t  const drainDeps: DrainDeps = {\n440\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n441\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n442\t    config: resolved,\n443\t  };\n444\t  const scheduler = createScheduler(resolved.mode, drainDeps);"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"ef1cecda-d198-45a3-b87c-1ab8ef92a4a0","timestamp":"2026-06-14T05:29:54.882Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  // Provider arrival is exactly one of direct injection or the inference\n  // config (Epic 05 DD-5); there is no named-provider registry and no\n  // env/flag resolution path to fall back on. The XOR rule is validated\n  // before anything downstream so the error names the caller's mistake, not\n  // a symptom (AC-1.1).\n  if (config.provider !== undefined && config.inference !== undefined) {\n    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n  }\n  if (config.provider === undefined && config.inference === undefined) {\n    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n  }\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  let provider: DerivationProvider;\n  if (config.inference !== undefined) {\n    provider = resolveInferenceProvider(config.inference);\n  } else {\n    if (config.provider === null || typeof config.provider !== \"object\") {\n      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n    }\n    for (const operation of PROVIDER_OPERATIONS) {\n      if (typeof config.provider[operation] !== \"function\") {\n        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n      }\n    }\n    provider = config.provider;\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);","numLines":75,"startLine":370,"totalLines":517}}}

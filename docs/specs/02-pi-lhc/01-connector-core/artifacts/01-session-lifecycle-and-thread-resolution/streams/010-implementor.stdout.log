{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018gXELJhMkXNtYcGJtRceHF","type":"tool_result","content":"1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n3\t// handler. The connector owns only plain-data `SessionState` plus the live\n4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n6\timport { mkdirSync } from \"node:fs\";\n7\timport { homedir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport { randomUUID } from \"node:crypto\";\n10\timport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \"lhc\";\n11\timport type {\n12\t  ExtensionAPI,\n13\t  ExtensionContext,\n14\t  PiHookHandler,\n15\t  PiHookName,\n16\t} from \"./pi/types.js\";\n17\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n18\timport { createSessionState } from \"./lifecycle/state.js\";\n19\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n20\timport {\n21\t  parseLaunchFlags,\n22\t  resolveThread,\n23\t  type LaunchFlags,\n24\t} from \"./lifecycle/thread-resolution.js\";\n25\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n26\timport type { LhcInstance } from \"./shared/instance.js\";\n27\t\n28\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n29\texport type { LhcInstance } from \"./shared/instance.js\";\n30\t\n31\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n32\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n33\t *  registers no handler for it (story Scope Out). */\n34\texport const EPIC_1_HOOKS = [\n35\t  \"session_start\",\n36\t  \"message_end\",\n37\t  \"turn_end\",\n38\t  \"agent_end\",\n39\t  \"model_select\",\n40\t  \"thinking_level_select\",\n41\t  \"session_before_fork\",\n42\t  \"session_before_switch\",\n43\t  \"session_shutdown\",\n44\t] as const satisfies readonly PiHookName[];\n45\t\n46\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n47\t\n48\t/** What the connector needs from the host to run a session. Every dependency\n49\t *  has a working production default; the overrides exist for test isolation\n50\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n51\t *  in the PI-auth-backed inference config.\n52\t *\n53\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n54\t *  default is the observe-only config below (a real, construction-valid SDK);\n55\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\n56\texport interface ConnectorDeps {\n57\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n58\t  registryPath?: string;\n59\t  newThreadFilePath?: () => string;\n60\t  parseLaunch?: () => LaunchFlags;\n61\t  selectThread?: (\n62\t    choices: readonly ThreadChoice[],\n63\t    ctx: ExtensionContext,\n64\t  ) => Promise<string | null>;\n65\t}\n66\t\n67\t/** Everything the connector retains across hooks as PLAIN data — by\n68\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n69\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n70\t *  deliberately not part of the snapshot. */\n71\texport interface ConnectorSnapshot {\n72\t  state: SessionState | null;\n73\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n74\t}\n75\t\n76\texport interface Connector {\n77\t  /** Register the observe-only hook rail on the PI extension API. */\n78\t  register(pi: ExtensionAPI): void;\n79\t  /** The plain-data state retained across hooks. `null` until a session\n80\t   *  resolves a thread; never holds a PI ctx. */\n81\t  getState(): SessionState | null;\n82\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n83\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n84\t  getInstance(): LhcInstance | null;\n85\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n86\t  snapshot(): ConnectorSnapshot;\n87\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n88\t   *  synthetic ctx/events without a live PI. */\n89\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n90\t}\n91\t\n92\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n93\t\n94\t/** The production observe-only SDK config: a real, construction-valid instance\n95\t *  in background scheduler mode. Epic 1 is observe-only, so derivations are\n96\t *  never served to the model; in Story 1 specifically the connector does not yet\n97\t *  capture (message_end is a no-op until Story 2), so no derivation work is\n98\t *  queued and this provider is never invoked — it exists only to satisfy\n99\t *  construction (AC-1.1 \"initializes one LHC instance\"). Stories 5/6 replace it\n100\t *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\n101\t *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\n102\t *  package is not yet a build dependency of this workspace). */\n103\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n104\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n105\t}\n106\t\n107\t/** Default `--resume` selection (sufficient for Story 1): resume the most\n108\t *  recently created thread in the cwd. The choices arrive in creation order, so\n109\t *  the last is the most recent. An interactive operator picker awaits a PI input\n110\t *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\n111\t *  then this is the production selection, and tests drive an explicit choice\n112\t *  through the injected selector. */\n113\tfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\n114\t  const mostRecent = choices.at(-1);\n115\t  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\n116\t}\n117\t\n118\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n119\t *  generated by the registry at creation, so the file name is just a unique\n120\t *  handle; the directory is ensured up front (DatabaseSync does not create\n121\t *  parents). */\n122\tfunction defaultNewThreadFilePath(): string {\n123\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n124\t  mkdirSync(dir, { recursive: true });\n125\t  return join(dir, `${randomUUID()}.sqlite`);\n126\t}\n127\t\n128\tfunction threadIdOf(ref: ThreadRef): string | null {\n129\t  return \"threadId\" in ref ? ref.threadId : null;\n130\t}\n131\t\n132\t// The durable resolved thread id for the current session, held at MODULE scope\n133\t// (not in a connector closure) so it survives the extension teardown/re-init a\n134\t// reload performs: a PI process runs one session at a time, so a single\n135\t// \"current thread id\" is unambiguous, and a fresh connector created by the next\n136\t// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\n137\t// PI-session→thread mapping or a durable file — so process death correctly drops\n138\t// it and the next launch re-resolves (no early-crash window, no recovery\n139\t// sidecar; epic I-1). Cleared on any non-reload teardown.\n140\tlet rememberedSessionThreadId: string | null = null;\n141\t\n142\t/** Reset the module-level reload memory. Test seam so each test starts from a\n143\t *  clean durable state; also the hook a full teardown would call. */\n144\texport function resetSessionThreadMemory(): void {\n145\t  rememberedSessionThreadId = null;\n146\t}\n147\t\n148\t/** Build a connector instance. Its mutable state lives in this closure; the\n149\t *  registered handlers capture it, so the instance stays live for the session\n150\t *  even when `activate` discards the returned object. */\n151\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n152\t  // The connector's retained state. `state` is plain data (the durable thread\n153\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n154\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\n155\t  // durable reload id lives at MODULE scope (above), not here, so it survives\n156\t  // this closure being torn down on reload.\n157\t  let state: SessionState | null = null;\n158\t  let instance: LhcInstance | null = null;\n159\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n160\t\n161\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n162\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n163\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n164\t  const selectThread = deps.selectThread ?? defaultSelectThread;\n165\t\n166\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n167\t    return { code, message, recordedGap: false };\n168\t  }\n169\t\n170\t  // On reload (same session continues, the connector torn down and re-created)\n171\t  // reconstruct the SAME thread from its durable id rather than re-running the\n172\t  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\n173\t  // id is read from the module-level reload memory, which survives this closure;\n174\t  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\n175\t  // the fallback, covering --session/--continue/--resume reloads. The permanent\n176\t  // home for reload lineage is LHC thread metadata (Feature 2+).\n177\t  function launchFor(event: { reason: string }): LaunchFlags {\n178\t    if (event.reason === \"reload\" && rememberedSessionThreadId !== null) {\n179\t      return { session: rememberedSessionThreadId };\n180\t    }\n181\t    return parseLaunch();\n182\t  }\n183\t\n184\t  async function resolveForLaunch(\n185\t    launch: LaunchFlags,\n186\t    ctx: ExtensionContext,\n187\t  ): Promise<OpResult<ThreadRef | null>> {\n188\t    if (launch.resume === true) {\n189\t      const pickerDeps: {\n190\t        registryPath?: string;\n191\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n192\t      } = { select: (choices) => selectThread(choices, ctx) };\n193\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n194\t      return pickThread(ctx.cwd, pickerDeps);\n195\t    }\n196\t    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n197\t      cwd: ctx.cwd,\n198\t      newThreadFilePath,\n199\t    };\n200\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n201\t    return resolveThread(launch, resolveDeps);\n202\t  }\n203\t\n204\t  // session_start: resolve the recording thread from the launch and construct\n205\t  // one background instance against it. Config is gated first so a session with\n206\t  // no usable inference config resolves/creates nothing (no orphan thread).\n207\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n208\t    const config = buildSdkConfig(ctx);\n209\t    if (!config.ok) {\n210\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n211\t      return;\n212\t    }\n213\t    const resolved = await resolveForLaunch(launchFor(event), ctx);\n214\t    if (!resolved.ok) {\n215\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n216\t      return;\n217\t    }\n218\t    if (resolved.value === null) {\n219\t      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n220\t      return;\n221\t    }\n222\t    const built = await initInstance(resolved.value, config.value);\n223\t    if (!built.ok) {\n224\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n225\t      return;\n226\t    }\n227\t    instance = built.value;\n228\t    state = createSessionState(resolved.value);\n229\t    rememberedSessionThreadId = threadIdOf(resolved.value);\n230\t  };\n231\t\n232\t  // Dispose with flush before any session swap (session_before_switch fires\n233\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n234\t  // no live instance is a no-op. The durable reload id is kept across a reload\n235\t  // (the session continues and will reattach) and cleared on any other teardown\n236\t  // so a later new/resume session never reattaches a stale thread.\n237\t  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\n238\t    const result = await disposeInstance(instance);\n239\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n240\t    instance = null;\n241\t    const isReload = \"reason\" in event && event.reason === \"reload\";\n242\t    if (!isReload) rememberedSessionThreadId = null;\n243\t  };\n244\t\n245\t  // Contain every handler: an observe-only hook must never throw back into PI\n246\t  // (a thrown hook breaks the user's session). A caught error becomes a\n247\t  // plain-data diagnostic; it is never rethrown.\n248\t  const guard = (\n249\t    name: Epic1Hook,\n250\t    body: PiHookHandler<Epic1Hook>,\n251\t  ): PiHookHandler<Epic1Hook> => {\n252\t    return async (ctx, event): Promise<void> => {\n253\t      try {\n254\t        await body(ctx, event);\n255\t      } catch (err) {\n256\t        lastDiagnostic = {\n257\t          code: \"hook_handler_error\",\n258\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n259\t          recordedGap: false,\n260\t        };\n261\t      }\n262\t    };\n263\t  };\n264\t\n265\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n266\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n267\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\n268\t  const noop: PiHookHandler<Epic1Hook> = () => {\n269\t    // Intentionally empty — later stories replace this with real routing.\n270\t  };\n271\t\n272\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n273\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n274\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n275\t    session_before_switch: onDispose,\n276\t    session_shutdown: onDispose,\n277\t    message_end: noop,\n278\t    turn_end: noop,\n279\t    agent_end: noop,\n280\t    model_select: noop,\n281\t    thinking_level_select: noop,\n282\t    session_before_fork: noop,\n283\t  };\n284\t\n285\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n286\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n287\t\n288\t  return {\n289\t    handlers,\n290\t    register(pi: ExtensionAPI): void {\n291\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n292\t    },\n293\t    getState(): SessionState | null {\n294\t      return state;\n295\t    },\n296\t    getInstance(): LhcInstance | null {\n297\t      return instance;\n298\t    },\n299\t    snapshot(): ConnectorSnapshot {\n300\t      return { state, lastDiagnostic };\n301\t    },\n302\t  };\n303\t}\n304\t\n305\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n306\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n307\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n308\t *  observe-only SDK config, the most-recent `--resume` selection, and the\n309\t *  module-level reload memory — so a live session_start resolves/creates and\n310\t *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\n311\t *  config; reload reconstruction reads the durable id the prior activation left\n312\t *  in the module-level memory. */\n313\texport function activate(pi: ExtensionAPI): void {\n314\t  createConnector().register(pi);\n315\t}\n316\t\n317\texport default activate;\n318\t"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"5a41a4dd-b7c7-4410-b03f-951039537c07","timestamp":"2026-06-14T05:25:35.197Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts","content":"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n// handler. The connector owns only plain-data `SessionState` plus the live\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\nimport { mkdirSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\nimport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \"lhc\";\nimport type {\n  ExtensionAPI,\n  ExtensionContext,\n  PiHookHandler,\n  PiHookName,\n} from \"./pi/types.js\";\nimport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\nimport { createSessionState } from \"./lifecycle/state.js\";\nimport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\nimport {\n  parseLaunchFlags,\n  resolveThread,\n  type LaunchFlags,\n} from \"./lifecycle/thread-resolution.js\";\nimport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\nimport type { LhcInstance } from \"./shared/instance.js\";\n\nexport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\nexport type { LhcInstance } from \"./shared/instance.js\";\n\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n *  registers no handler for it (story Scope Out). */\nexport const EPIC_1_HOOKS = [\n  \"session_start\",\n  \"message_end\",\n  \"turn_end\",\n  \"agent_end\",\n  \"model_select\",\n  \"thinking_level_select\",\n  \"session_before_fork\",\n  \"session_before_switch\",\n  \"session_shutdown\",\n] as const satisfies readonly PiHookName[];\n\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n\n/** What the connector needs from the host to run a session. Every dependency\n *  has a working production default; the overrides exist for test isolation\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\n *  in the PI-auth-backed inference config.\n *\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\n *  default is the observe-only config below (a real, construction-valid SDK);\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\nexport interface ConnectorDeps {\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n  registryPath?: string;\n  newThreadFilePath?: () => string;\n  parseLaunch?: () => LaunchFlags;\n  selectThread?: (\n    choices: readonly ThreadChoice[],\n    ctx: ExtensionContext,\n  ) => Promise<string | null>;\n}\n\n/** Everything the connector retains across hooks as PLAIN data — by\n *  construction structuredClone-able. The live `LhcInstance` is held separately\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n *  deliberately not part of the snapshot. */\nexport interface ConnectorSnapshot {\n  state: SessionState | null;\n  lastDiagnostic: CaptureFailureDiagnostic | null;\n}\n\nexport interface Connector {\n  /** Register the observe-only hook rail on the PI extension API. */\n  register(pi: ExtensionAPI): void;\n  /** The plain-data state retained across hooks. `null` until a session\n   *  resolves a thread; never holds a PI ctx. */\n  getState(): SessionState | null;\n  /** The live LHC instance for the current session, or `null`. A test/inspection\n   *  seam — held by the connector but never part of the plain-data snapshot. */\n  getInstance(): LhcInstance | null;\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\n  snapshot(): ConnectorSnapshot;\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\n   *  synthetic ctx/events without a live PI. */\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n}\n\nconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n\n/** The production observe-only SDK config: a real, construction-valid instance\n *  in background scheduler mode. Epic 1 is observe-only, so derivations are\n *  never served to the model; in Story 1 specifically the connector does not yet\n *  capture (message_end is a no-op until Story 2), so no derivation work is\n *  queued and this provider is never invoked — it exists only to satisfy\n *  construction (AC-1.1 \"initializes one LHC instance\"). Stories 5/6 replace it\n *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\n *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\n *  package is not yet a build dependency of this workspace). */\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\n  return { ok: true, value: { provider: createDeterministicProvider(), mode: \"background\" } };\n}\n\n/** Default `--resume` selection (sufficient for Story 1): resume the most\n *  recently created thread in the cwd. The choices arrive in creation order, so\n *  the last is the most recent. An interactive operator picker awaits a PI input\n *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\n *  then this is the production selection, and tests drive an explicit choice\n *  through the injected selector. */\nfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\n  const mostRecent = choices.at(-1);\n  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\n}\n\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n *  generated by the registry at creation, so the file name is just a unique\n *  handle; the directory is ensured up front (DatabaseSync does not create\n *  parents). */\nfunction defaultNewThreadFilePath(): string {\n  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n  mkdirSync(dir, { recursive: true });\n  return join(dir, `${randomUUID()}.sqlite`);\n}\n\nfunction threadIdOf(ref: ThreadRef): string | null {\n  return \"threadId\" in ref ? ref.threadId : null;\n}\n\n// The durable resolved thread id for the current session, held at MODULE scope\n// (not in a connector closure) so it survives the extension teardown/re-init a\n// reload performs: a PI process runs one session at a time, so a single\n// \"current thread id\" is unambiguous, and a fresh connector created by the next\n// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\n// PI-session→thread mapping or a durable file — so process death correctly drops\n// it and the next launch re-resolves (no early-crash window, no recovery\n// sidecar; epic I-1). Cleared on any non-reload teardown.\nlet rememberedSessionThreadId: string | null = null;\n\n/** Reset the module-level reload memory. Test seam so each test starts from a\n *  clean durable state; also the hook a full teardown would call. */\nexport function resetSessionThreadMemory(): void {\n  rememberedSessionThreadId = null;\n}\n\n/** Build a connector instance. Its mutable state lives in this closure; the\n *  registered handlers capture it, so the instance stays live for the session\n *  even when `activate` discards the returned object. */\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\n  // The connector's retained state. `state` is plain data (the durable thread\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\n  // durable reload id lives at MODULE scope (above), not here, so it survives\n  // this closure being torn down on reload.\n  let state: SessionState | null = null;\n  let instance: LhcInstance | null = null;\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n  const selectThread = deps.selectThread ?? defaultSelectThread;\n\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\n    return { code, message, recordedGap: false };\n  }\n\n  // On reload (same session continues, the connector torn down and re-created)\n  // reconstruct the SAME thread from its durable id rather than re-running the\n  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\n  // id is read from the module-level reload memory, which survives this closure;\n  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\n  // the fallback, covering --session/--continue/--resume reloads. The permanent\n  // home for reload lineage is LHC thread metadata (Feature 2+).\n  function launchFor(event: { reason: string }): LaunchFlags {\n    if (event.reason === \"reload\" && rememberedSessionThreadId !== null) {\n      return { session: rememberedSessionThreadId };\n    }\n    return parseLaunch();\n  }\n\n  async function resolveForLaunch(\n    launch: LaunchFlags,\n    ctx: ExtensionContext,\n  ): Promise<OpResult<ThreadRef | null>> {\n    if (launch.resume === true) {\n      const pickerDeps: {\n        registryPath?: string;\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n      } = { select: (choices) => selectThread(choices, ctx) };\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n      return pickThread(ctx.cwd, pickerDeps);\n    }\n    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n      cwd: ctx.cwd,\n      newThreadFilePath,\n    };\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n    return resolveThread(launch, resolveDeps);\n  }\n\n  // session_start: resolve the recording thread from the launch and construct\n  // one background instance against it. Config is gated first so a session with\n  // no usable inference config resolves/creates nothing (no orphan thread).\n  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n    const config = buildSdkConfig(ctx);\n    if (!config.ok) {\n      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n      return;\n    }\n    const resolved = await resolveForLaunch(launchFor(event), ctx);\n    if (!resolved.ok) {\n      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n      return;\n    }\n    if (resolved.value === null) {\n      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n      return;\n    }\n    const built = await initInstance(resolved.value, config.value);\n    if (!built.ok) {\n      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n      return;\n    }\n    instance = built.value;\n    state = createSessionState(resolved.value);\n    rememberedSessionThreadId = threadIdOf(resolved.value);\n  };\n\n  // Dispose with flush before any session swap (session_before_switch fires\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n  // no live instance is a no-op. The durable reload id is kept across a reload\n  // (the session continues and will reattach) and cleared on any other teardown\n  // so a later new/resume session never reattaches a stale thread.\n  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\n    const result = await disposeInstance(instance);\n    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n    instance = null;\n    const isReload = \"reason\" in event && event.reason === \"reload\";\n    if (!isReload) rememberedSessionThreadId = null;\n  };\n\n  // Contain every handler: an observe-only hook must never throw back into PI\n  // (a thrown hook breaks the user's session). A caught error becomes a\n  // plain-data diagnostic; it is never rethrown.\n  const guard = (\n    name: Epic1Hook,\n    body: PiHookHandler<Epic1Hook>,\n  ): PiHookHandler<Epic1Hook> => {\n    return async (ctx, event): Promise<void> => {\n      try {\n        await body(ctx, event);\n      } catch (err) {\n        lastDiagnostic = {\n          code: \"hook_handler_error\",\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n          recordedGap: false,\n        };\n      }\n    };\n  };\n\n  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n  // land in later stories. Each receives a FRESH ctx and retains none of it.\n  const noop: PiHookHandler<Epic1Hook> = () => {\n    // Intentionally empty — later stories replace this with real routing.\n  };\n\n  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n    session_before_switch: onDispose,\n    session_shutdown: onDispose,\n    message_end: noop,\n    turn_end: noop,\n    agent_end: noop,\n    model_select: noop,\n    thinking_level_select: noop,\n    session_before_fork: noop,\n  };\n\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n\n  return {\n    handlers,\n    register(pi: ExtensionAPI): void {\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    },\n    getState(): SessionState | null {\n      return state;\n    },\n    getInstance(): LhcInstance | null {\n      return instance;\n    },\n    snapshot(): ConnectorSnapshot {\n      return { state, lastDiagnostic };\n    },\n  };\n}\n\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\n *  observe-only SDK config, the most-recent `--resume` selection, and the\n *  module-level reload memory — so a live session_start resolves/creates and\n *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\n *  config; reload reconstruction reads the durable id the prior activation left\n *  in the module-level memory. */\nexport function activate(pi: ExtensionAPI): void {\n  createConnector().register(pi);\n}\n\nexport default activate;\n","numLines":318,"startLine":1,"totalLines":318}}}

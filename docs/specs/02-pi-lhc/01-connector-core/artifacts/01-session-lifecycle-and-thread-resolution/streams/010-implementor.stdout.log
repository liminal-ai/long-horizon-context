 {\n60\t      errorClass: \"caller_error\",\n61\t      code: \"thread_not_found\",\n62\t      reason: `no thread registered with id ${threadId}`,\n63\t    },\n64\t  };\n65\t}\n66\t\n67\t// A partial id that matches more than one thread is a caller error, not a\n68\t// silent pick: resolution names the collision and the caller must disambiguate\n69\t// (AC-1.6 — an ambiguous id fails loud, never resolves arbitrarily).\n70\tfunction ambiguousThreadId(\n71\t  prefix: string,\n72\t  matchIds: readonly string[],\n73\t): { ok: false; error: ErrorResult } {\n74\t  return {\n75\t    ok: false,\n76\t    error: {\n77\t      errorClass: \"caller_error\",\n78\t      code: \"ambiguous_thread_id\",\n79\t      reason: `thread id \"${prefix}\" is ambiguous: it matches ${matchIds.length} threads (${matchIds.join(\", \")}); use a longer id`,\n80\t    },\n81\t  };\n82\t}\n83\t\n84\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n85\t  return {\n86\t    ok: false,\n87\t    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n88\t  };\n89\t}\n90\t\n91\t// A file path that is empty or whitespace-only cannot name a durable file:\n92\t// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n93\t// close, so such a path must be refused as a caller error before any storage\n94\t// is touched rather than silently producing a thread with no durable file.\n95\tfunction isBlankPath(filePath: string): boolean {\n96\t  return filePath.trim() === \"\";\n97\t}\n98\t\n99\tfunction detail(cause: unknown): string {\n100\t  return cause instanceof Error ? cause.message : String(cause);\n101\t}\n102\t\n103\t// Creation spans two databases that cannot share a transaction. Order is\n104\t// file-then-row with compensation: the invariant \"no registry row without\n105\t// its file\" is absolute; an orphan file from a crash between the writes is\n106\t// documented harmless (design decision 2).\n107\texport async function newThread(\n108\t  input: NewThreadInput,\n109\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n110\t  // Guard before any storage touch: an empty/blank path would otherwise open\n111\t  // a temp database and register a thread with no durable file (the no-row-\n112\t  // without-file invariant below depends on the path naming a real file).\n113\t  if (isBlankPath(input.filePath)) {\n114\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n115\t  }\n116\t  if (existsSync(input.filePath)) {\n117\t    return {\n118\t      ok: false,\n119\t      error: {\n120\t        errorClass: \"caller_error\",\n121\t        code: \"path_exists\",\n122\t        reason: `a file already exists at ${input.filePath}`,\n123\t      },\n124\t    };\n125\t  }\n126\t\n127\t  const threadId = generateThreadId();\n128\t  const createdAt = new Date().toISOString();\n129\t\n130\t  try {\n131\t    createThreadFile(input.filePath, threadId, createdAt);\n132\t  } catch (cause) {\n133\t    deleteThreadFile(input.filePath);\n134\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n135\t  }\n136\t\n137\t  let registry;\n138\t  try {\n139\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n140\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n141\t    if (input.title !== undefined) row.title = input.title;\n142\t    if (input.cwd !== undefined) row.cwd = input.cwd;\n143\t    insertThreadRow(registry, row);\n144\t  } catch (cause) {\n145\t    deleteThreadFile(input.filePath);\n146\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n147\t  } finally {\n148\t    registry?.close();\n149\t  }\n150\t\n151\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n152\t}\n153\t\n154\t// Resolution accepts a full or partial (prefix) thread id (A-8). An exact id\n155\t// wins outright — a full id always resolves to itself, even if it is also
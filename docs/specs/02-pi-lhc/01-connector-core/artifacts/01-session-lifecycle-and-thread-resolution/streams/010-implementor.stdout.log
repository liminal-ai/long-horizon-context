{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWwvXVkK8M4tWA8qajWhDc","type":"tool_result","content":"107\texport interface ProviderProvenance {\n108\t  provider: string;\n109\t  model: string;\n110\t  prompt: string;\n111\t}\n112\t\n113\texport type ProviderResult =\n114\t  | { ok: true; text: string; provenance?: ProviderProvenance }\n115\t  | { ok: false; retryable: boolean; reason: string };\n116\t\n117\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n118\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n119\t// rather than imported: shared/ may not import domains/.\n120\texport type RenderingPartKind =\n121\t  | \"user_prompt\"\n122\t  | \"assistant_text\"\n123\t  | \"assistant_thinking\"\n124\t  | \"runtime_note\"\n125\t  | \"tool_call\"\n126\t  | \"tool_result\";\n127\t\n128\texport interface RenderingPart {\n129\t  messageId: string;\n130\t  kind: RenderingPartKind;\n131\t  text: string; // ready form content, or raw/truncated fallback\n132\t  fallback: boolean; // true ⇒ gap recorded\n133\t  outcome?: ToolOutcome; // tool activity only\n134\t}\n135\t\n136\texport interface DerivationProvider {\n137\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n138\t  summarizeToolCall(i: {\n139\t    toolName: string;\n140\t    argsJson: string;\n141\t    pairedResult?: { content: string; isError: boolean };\n142\t  }): Promise<ProviderResult>;\n143\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n144\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n145\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n146\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n147\t  // the members' tool-run receipts (what changed, outcome) alongside the\n148\t  // projections; brief receives outcomes only — receipt text is stripped\n149\t  // before the provider is called, so brief structurally cannot leak it.\n150\t  // The receipt fields are optional in the type for callers without member\n151\t  // context (the production chunk handlers always pass them).\n152\t  summarizeChunkDetailed(i: {\n153\t    memberProjections: string[];\n154\t    memberReceipts?: ToolRunReceipt[][];\n155\t  }): Promise<ProviderResult>;\n156\t  summarizeChunkBrief(i: {\n157\t    memberProjections: string[];\n158\t    memberOutcomes?: ToolOutcome[][];\n159\t  }): Promise<ProviderResult>;\n160\t}\n161\t\n162\texport const PROVIDER_OPERATIONS = [\n163\t  \"smoothPrompt\",\n164\t  \"summarizeToolCall\",\n165\t  \"summarizeToolResult\",\n166\t  \"composeTurnRendering\",\n167\t  \"projectLowerBand\",\n168\t  \"summarizeChunkDetailed\",\n169\t  \"summarizeChunkBrief\",\n170\t] as const;\n171\t\n172\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n173\t\n174\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n175\t// Provider arrival is exactly one of `provider` (direct injection,\n176\t// unchanged — the deterministic test default) or `inference` (host\n177\t// model-call function + per-kind assignments, Epic 05 DD-5). Both or\n178\t// neither is a construction TypeError naming the XOR rule (AC-1.1).\n179\texport interface SdkConfig {\n180\t  provider?: DerivationProvider;\n181\t  inference?: InferenceConfig;"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"189e07a9-ac1f-4afb-865c-0e0161a096d2","timestamp":"2026-06-14T05:30:01.041Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts","content":"export interface ProviderProvenance {\n  provider: string;\n  model: string;\n  prompt: string;\n}\n\nexport type ProviderResult =\n  | { ok: true; text: string; provenance?: ProviderProvenance }\n  | { ok: false; retryable: boolean; reason: string };\n\n// Message kinds a rendering part can carry — mirrors the intake event-kind\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n// rather than imported: shared/ may not import domains/.\nexport type RenderingPartKind =\n  | \"user_prompt\"\n  | \"assistant_text\"\n  | \"assistant_thinking\"\n  | \"runtime_note\"\n  | \"tool_call\"\n  | \"tool_result\";\n\nexport interface RenderingPart {\n  messageId: string;\n  kind: RenderingPartKind;\n  text: string; // ready form content, or raw/truncated fallback\n  fallback: boolean; // true ⇒ gap recorded\n  outcome?: ToolOutcome; // tool activity only\n}\n\nexport interface DerivationProvider {\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult>;\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n  // The two summary inputs differ by contract (AC-3.8): detailed receives\n  // the members' tool-run receipts (what changed, outcome) alongside the\n  // projections; brief receives outcomes only — receipt text is stripped\n  // before the provider is called, so brief structurally cannot leak it.\n  // The receipt fields are optional in the type for callers without member\n  // context (the production chunk handlers always pass them).\n  summarizeChunkDetailed(i: {\n    memberProjections: string[];\n    memberReceipts?: ToolRunReceipt[][];\n  }): Promise<ProviderResult>;\n  summarizeChunkBrief(i: {\n    memberProjections: string[];\n    memberOutcomes?: ToolOutcome[][];\n  }): Promise<ProviderResult>;\n}\n\nexport const PROVIDER_OPERATIONS = [\n  \"smoothPrompt\",\n  \"summarizeToolCall\",\n  \"summarizeToolResult\",\n  \"composeTurnRendering\",\n  \"projectLowerBand\",\n  \"summarizeChunkDetailed\",\n  \"summarizeChunkBrief\",\n] as const;\n\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n\n// ── SDK assembly config (tech design §Interfaces) ────────────────\n// Provider arrival is exactly one of `provider` (direct injection,\n// unchanged — the deterministic test default) or `inference` (host\n// model-call function + per-kind assignments, Epic 05 DD-5). Both or\n// neither is a construction TypeError naming the XOR rule (AC-1.1).\nexport interface SdkConfig {\n  provider?: DerivationProvider;\n  inference?: InferenceConfig;","numLines":75,"startLine":107,"totalLines":249}}}

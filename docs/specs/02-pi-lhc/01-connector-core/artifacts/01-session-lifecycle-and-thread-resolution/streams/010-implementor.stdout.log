{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fpu93aZ1b4T7dvgdJD7LMk","type":"tool_result","content":"1\timport {\n2\t  createSdk,\n3\t  threads,\n4\t  type Lhc,\n5\t  type OpResult,\n6\t  type SdkConfig,\n7\t  type ThreadRef,\n8\t} from \"lhc\";\n9\timport type { LhcInstance } from \"../shared/instance.js\";\n10\t\n11\t// AC-1.1, AC-1.4, AC-1.5.\n12\t\n13\t/** The connector's name for SDK construction — the agreed rename of LHC's\n14\t *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n15\t *  either way). One instance per PI session in background scheduler mode; the\n16\t *  connector never drives the queue (Flow 1). */\n17\texport function initLhc(config: SdkConfig): Lhc {\n18\t  return createSdk(config);\n19\t}\n20\t\n21\tfunction detail(cause: unknown): string {\n22\t  return cause instanceof Error ? cause.message : String(cause);\n23\t}\n24\t\n25\t/** Flush-on-dispose: await any pending background derivations for this thread,\n26\t *  then release the instance. Captured intake is already durable (intake writes\n27\t *  commit synchronously), so the flush is about letting in-flight background\n28\t *  work settle before shutdown — never a throw back into a PI hook. */\n29\tasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n30\t  try {\n31\t    await sdk.drainSettled(threadRef);\n32\t  } catch (cause) {\n33\t    return {\n34\t      ok: false,\n35\t      error: {\n36\t        errorClass: \"system_error\",\n37\t        code: \"storage_failure\",\n38\t        reason: `instance dispose flush failed: ${detail(cause)}`,\n39\t      },\n40\t    };\n41\t  }\n42\t  return { ok: true, value: undefined };\n43\t}\n44\t\n45\t/** Construct one LHC instance against a resolved thread in background scheduler\n46\t *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n47\t *  typed result rather than a half-built instance; background mode is forced\n48\t *  regardless of the caller's config so the connector cannot accidentally drive\n49\t *  the queue. A malformed inference/provider config is a programmer error and\n50\t *  throws here per LHC's construction contract — the hook guard in `index.ts`\n51\t *  contains it so nothing reaches the PI session. */\n52\texport async function initInstance(\n53\t  threadRef: ThreadRef,\n54\t  config: SdkConfig,\n55\t): Promise<OpResult<LhcInstance>> {\n56\t  const info = await threads.info(threadRef);\n57\t  if (!info.ok) return info;\n58\t\n59\t  const sdk = initLhc({ ...config, mode: \"background\" });\n60\t  const instance: LhcInstance = {\n61\t    sdk,\n62\t    threadRef,\n63\t    dispose: () => disposeSdk(sdk, threadRef),\n64\t  };\n65\t  return { ok: true, value: instance };\n66\t}\n67\t\n68\t/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n69\t *  shutdown with no live instance is a successful no-op, never an error. */\n70\texport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n71\t  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n72\t  return instance.dispose();\n73\t}\n74\t"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"90447dd6-3983-40d9-91f8-6445f1c8f71c","timestamp":"2026-06-14T05:26:44.219Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/instance.ts","content":"import {\n  createSdk,\n  threads,\n  type Lhc,\n  type OpResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport type { LhcInstance } from \"../shared/instance.js\";\n\n// AC-1.1, AC-1.4, AC-1.5.\n\n/** The connector's name for SDK construction — the agreed rename of LHC's\n *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n *  either way). One instance per PI session in background scheduler mode; the\n *  connector never drives the queue (Flow 1). */\nexport function initLhc(config: SdkConfig): Lhc {\n  return createSdk(config);\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n/** Flush-on-dispose: await any pending background derivations for this thread,\n *  then release the instance. Captured intake is already durable (intake writes\n *  commit synchronously), so the flush is about letting in-flight background\n *  work settle before shutdown — never a throw back into a PI hook. */\nasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n  try {\n    await sdk.drainSettled(threadRef);\n  } catch (cause) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"system_error\",\n        code: \"storage_failure\",\n        reason: `instance dispose flush failed: ${detail(cause)}`,\n      },\n    };\n  }\n  return { ok: true, value: undefined };\n}\n\n/** Construct one LHC instance against a resolved thread in background scheduler\n *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n *  typed result rather than a half-built instance; background mode is forced\n *  regardless of the caller's config so the connector cannot accidentally drive\n *  the queue. A malformed inference/provider config is a programmer error and\n *  throws here per LHC's construction contract — the hook guard in `index.ts`\n *  contains it so nothing reaches the PI session. */\nexport async function initInstance(\n  threadRef: ThreadRef,\n  config: SdkConfig,\n): Promise<OpResult<LhcInstance>> {\n  const info = await threads.info(threadRef);\n  if (!info.ok) return info;\n\n  const sdk = initLhc({ ...config, mode: \"background\" });\n  const instance: LhcInstance = {\n    sdk,\n    threadRef,\n    dispose: () => disposeSdk(sdk, threadRef),\n  };\n  return { ok: true, value: instance };\n}\n\n/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n *  shutdown with no live instance is a successful no-op, never an error. */\nexport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n  return instance.dispose();\n}\n","numLines":74,"startLine":1,"totalLines":74}}}

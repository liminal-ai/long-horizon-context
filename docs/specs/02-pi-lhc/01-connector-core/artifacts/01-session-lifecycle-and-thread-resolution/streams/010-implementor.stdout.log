{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014rQxrawjxpVFbBYgAMpYex","type":"tool_result","content":"1\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n2\timport { registryArg, threadRefById } from \"./thread-resolution.js\";\n3\t\n4\t// AC-1.7.\n5\t\n6\t/** One row the picker offers: enough to show the operator what they are\n7\t *  resuming — its title (when set) and creation time — keyed by the id the\n8\t *  selection resolves. */\n9\texport interface ThreadChoice {\n10\t  threadId: string;\n11\t  title?: string;\n12\t  createdAt: string;\n13\t}\n14\t\n15\t/** What the picker needs from the host: the registry to list/resolve through,\n16\t *  and the selection mechanism. `select` is injected so the picker stays a thin,\n17\t *  headless-safe registry operation — a real UI in production, a deterministic\n18\t *  choice in tests — and returns the chosen thread id, or `null` to cancel. */\n19\texport interface PickerDeps {\n20\t  registryPath?: string;\n21\t  select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n22\t}\n23\t\n24\t/** `--resume`/`-r`: list the current cwd's threads (title + creation time) and\n25\t *  resolve the operator's selection. The cwd scope is the registry query, not a\n26\t *  filter over an unscoped list (anti-shim). With no threads for the cwd the\n27\t *  picker reports an empty list (`null`) rather than failing; a cancelled\n28\t *  selection is likewise `null`. */\n29\texport async function pickThread(\n30\t  cwd: string,\n31\t  deps: PickerDeps,\n32\t): Promise<OpResult<ThreadRef | null>> {\n33\t  const listed = await threads.listThreads({ cwd, ...registryArg(deps.registryPath) });\n34\t  if (!listed.ok) return listed;\n35\t  if (listed.value.length === 0) return { ok: true, value: null };\n36\t\n37\t  const choices: ThreadChoice[] = listed.value.map((info) => {\n38\t    const choice: ThreadChoice = { threadId: info.threadId, createdAt: info.createdAt };\n39\t    if (info.title !== undefined) choice.title = info.title;\n40\t    return choice;\n41\t  });\n42\t\n43\t  const chosen = await deps.select(choices);\n44\t  if (chosen === null) return { ok: true, value: null };\n45\t\n46\t  const resolved = await threads.resolve({ threadId: chosen, ...registryArg(deps.registryPath) });\n47\t  if (!resolved.ok) return resolved;\n48\t  return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n49\t}\n50\t"}]},"parent_tool_use_id":null,"session_id":"fc8b0d70-702e-4abc-9faa-dda18cc81eaf","uuid":"a4271361-14d1-413e-9da0-47526808257c","timestamp":"2026-06-14T05:26:45.169Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/picker.ts","content":"import { threads, type OpResult, type ThreadRef } from \"lhc\";\nimport { registryArg, threadRefById } from \"./thread-resolution.js\";\n\n// AC-1.7.\n\n/** One row the picker offers: enough to show the operator what they are\n *  resuming — its title (when set) and creation time — keyed by the id the\n *  selection resolves. */\nexport interface ThreadChoice {\n  threadId: string;\n  title?: string;\n  createdAt: string;\n}\n\n/** What the picker needs from the host: the registry to list/resolve through,\n *  and the selection mechanism. `select` is injected so the picker stays a thin,\n *  headless-safe registry operation — a real UI in production, a deterministic\n *  choice in tests — and returns the chosen thread id, or `null` to cancel. */\nexport interface PickerDeps {\n  registryPath?: string;\n  select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n}\n\n/** `--resume`/`-r`: list the current cwd's threads (title + creation time) and\n *  resolve the operator's selection. The cwd scope is the registry query, not a\n *  filter over an unscoped list (anti-shim). With no threads for the cwd the\n *  picker reports an empty list (`null`) rather than failing; a cancelled\n *  selection is likewise `null`. */\nexport async function pickThread(\n  cwd: string,\n  deps: PickerDeps,\n): Promise<OpResult<ThreadRef | null>> {\n  const listed = await threads.listThreads({ cwd, ...registryArg(deps.registryPath) });\n  if (!listed.ok) return listed;\n  if (listed.value.length === 0) return { ok: true, value: null };\n\n  const choices: ThreadChoice[] = listed.value.map((info) => {\n    const choice: ThreadChoice = { threadId: info.threadId, createdAt: info.createdAt };\n    if (info.title !== undefined) choice.title = info.title;\n    return choice;\n  });\n\n  const chosen = await deps.select(choices);\n  if (chosen === null) return { ok: true, value: null };\n\n  const resolved = await threads.resolve({ threadId: chosen, ...registryArg(deps.registryPath) });\n  if (!resolved.ok) return resolved;\n  return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n}\n","numLines":50,"startLine":1,"totalLines":50}}}

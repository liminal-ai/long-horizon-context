{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=1 && NR<=120 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/pi-lhc/src/lifecycle/picker.ts\"","aggregated_output":"     1\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n     2\timport { registryArg, threadRefById } from \"./thread-resolution.js\";\n     3\t\n     4\t// AC-1.7.\n     5\t\n     6\t/** One row the picker offers: enough to show the operator what they are\n     7\t *  resuming — its title (when set) and creation time — keyed by the id the\n     8\t *  selection resolves. */\n     9\texport interface ThreadChoice {\n    10\t  threadId: string;\n    11\t  title?: string;\n    12\t  createdAt: string;\n    13\t}\n    14\t\n    15\t/** What the picker needs from the host: the registry to list/resolve through,\n    16\t *  and the selection mechanism. `select` is injected so the picker stays a thin,\n    17\t *  headless-safe registry operation — a real UI in production, a deterministic\n    18\t *  choice in tests — and returns the chosen thread id, or `null` to cancel. */\n    19\texport interface PickerDeps {\n    20\t  registryPath?: string;\n    21\t  select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n    22\t}\n    23\t\n    24\t/** `--resume`/`-r`: list the current cwd's threads (title + creation time) and\n    25\t *  resolve the operator's selection. The cwd scope is the registry query, not a\n    26\t *  filter over an unscoped list (anti-shim). With no threads for the cwd the\n    27\t *  picker reports an empty list (`null`) rather than failing; a cancelled\n    28\t *  selection is likewise `null`. */\n    29\texport async function pickThread(\n    30\t  cwd: string,\n    31\t  deps: PickerDeps,\n    32\t): Promise<OpResult<ThreadRef | null>> {\n    33\t  const listed = await threads.listThreads({ cwd, ...registryArg(deps.registryPath) });\n    34\t  if (!listed.ok) return listed;\n    35\t  if (listed.value.length === 0) return { ok: true, value: null };\n    36\t\n    37\t  const choices: ThreadChoice[] = listed.value.map((info) => {\n    38\t    const choice: ThreadChoice = { threadId: info.threadId, createdAt: info.createdAt };\n    39\t    if (info.title !== undefined) choice.title = info.title;\n    40\t    return choice;\n    41\t  });\n    42\t\n    43\t  const chosen = await deps.select(choices);\n    44\t  if (chosen === null) return { ok: true, value: null };\n    45\t\n    46\t  const resolved = await threads.resolve({ threadId: chosen, ...registryArg(deps.registryPath) });\n    47\t  if (!resolved.ok) return resolved;\n    48\t  return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n    49\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=1 && NR<=160 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/pi-lhc/src/lifecycle/instance.ts\"","aggregated_output":"     1\timport {\n     2\t  createSdk,\n     3\t  threads,\n     4\t  type Lhc,\n     5\t  type OpResult,\n     6\t  type SdkConfig,\n     7\t  type ThreadRef,\n     8\t} from \"lhc\";\n     9\timport type { LhcInstance } from \"../shared/instance.js\";\n    10\t\n    11\t// AC-1.1, AC-1.4, AC-1.5.\n    12\t\n    13\t/** The connector's name for SDK construction — the agreed rename of LHC's\n    14\t *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n    15\t *  either way). One instance per PI session in background scheduler mode; the\n    16\t *  connector never drives the queue (Flow 1). */\n    17\texport function initLhc(config: SdkConfig): Lhc {\n    18\t  return createSdk(config);\n    19\t}\n    20\t\n    21\tfunction detail(cause: unknown): string {\n    22\t  return cause instanceof Error ? cause.message : String(cause);\n    23\t}\n    24\t\n    25\t/** Flush-on-dispose: await any pending background derivations for this thread,\n    26\t *  then release the instance. Captured intake is already durable (intake writes\n    27\t *  commit synchronously), so the flush is about letting in-flight background\n    28\t *  work settle before shutdown — never a throw back into a PI hook. */\n    29\tasync function disposeSdk(sdk: Lhc, threadRef: ThreadRef): Promise<OpResult<void>> {\n    30\t  try {\n    31\t    await sdk.drainSettled(threadRef);\n    32\t  } catch (cause) {\n    33\t    return {\n    34\t      ok: false,\n    35\t      error: {\n    36\t        errorClass: \"system_error\",\n    37\t        code: \"storage_failure\",\n    38\t        reason: `instance dispose flush failed: ${detail(cause)}`,\n    39\t      },\n    40\t    };\n    41\t  }\n    42\t  return { ok: true, value: undefined };\n    43\t}\n    44\t\n    45\t/** Construct one LHC instance against a resolved thread in background scheduler\n    46\t *  mode (AC-1.1). The thread is validated first so an unresolvable ref returns a\n    47\t *  typed result rather than a half-built instance; background mode is forced\n    48\t *  regardless of the caller's config so the connector cannot accidentally drive\n    49\t *  the queue. A malformed inference/provider config is a programmer error and\n    50\t *  throws here per LHC's construction contract — the hook guard in `index.ts`\n    51\t *  contains it so nothing reaches the PI session. */\n    52\texport async function initInstance(\n    53\t  threadRef: ThreadRef,\n    54\t  config: SdkConfig,\n    55\t): Promise<OpResult<LhcInstance>> {\n    56\t  const info = await threads.info(threadRef);\n    57\t  if (!info.ok) return info;\n    58\t\n    59\t  const sdk = initLhc({ ...config, mode: \"background\" });\n    60\t  const instance: LhcInstance = {\n    61\t    sdk,\n    62\t    threadRef,\n    63\t    dispose: () => disposeSdk(sdk, threadRef),\n    64\t  };\n    65\t  return { ok: true, value: instance };\n    66\t}\n    67\t\n    68\t/** Dispose an instance on shutdown/switch with flush (AC-1.4). Null-safe: a\n    69\t *  shutdown with no live instance is a successful no-op, never an error. */\n    70\texport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n    71\t  if (instance === null) return Promise.resolve({ ok: true, value: undefined });\n    72\t  return instance.dispose();\n    73\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=1 && NR<=160 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/pi-lhc/src/lifecycle/thread-resolution.ts\"","aggregated_output":"     1\timport { threads, type OpResult, type ThreadRef } from \"lhc\";\n     2\t\n     3\t// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\n     4\t// it (tech design Flow 1). PI's own session file still exists in this\n     5\t// observe-only epic — it is just not where thread identity lives.\n     6\t\n     7\t/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\n     8\t *  before this resolver — see `picker.ts`.) */\n     9\texport interface LaunchFlags {\n    10\t  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\n    11\t  continue?: boolean; // --continue / -c : most recent\n    12\t  session?: string; // --session <id> : full or partial id\n    13\t}\n    14\t\n    15\t/** What the resolver needs from the host beyond the launch flags: the cwd a new\n    16\t *  thread is registered under, the registry to resolve through, and where a new\n    17\t *  thread's file is created. Injected so the resolver is exercised against a\n    18\t *  real temp registry in tests and the default `~/.lhc` registry in production —\n    19\t *  `registryPath` is a per-operation argument, never an `initLhc` config field\n    20\t *  (tech design Technical Notes). */\n    21\texport interface ResolveDeps {\n    22\t  cwd: string;\n    23\t  registryPath?: string;\n    24\t  newThreadFilePath: () => string;\n    25\t}\n    26\t\n    27\t/** The durable, plain-data thread reference the connector retains and\n    28\t *  reattaches from: a thread id (plus the registry it lives in), not a live\n    29\t *  object. `{ filePath }` is avoided so reload reconstructs by id. */\n    30\texport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\n    31\t  return registryPath === undefined ? { threadId } : { threadId, registryPath };\n    32\t}\n    33\t\n    34\t/** Spread `registryPath` into an LHC threads-call options object only when it is\n    35\t *  set, so an unset registry path falls through to LHC's default rather than\n    36\t *  being passed as an explicit `undefined` (rejected under\n    37\t *  exactOptionalPropertyTypes). */\n    38\texport function registryArg(registryPath?: string): { registryPath?: string } {\n    39\t  return registryPath === undefined ? {} : { registryPath };\n    40\t}\n    41\t\n    42\t/** Resolve the recording thread from the launch input (AC-1.6):\n    43\t *  - `--session <id>`: a named thread by full or partial id; unresolvable or\n    44\t *    ambiguous fails loud (the registry returns `thread_not_found` /\n    45\t *    `ambiguous_thread_id`) and never silently creates a thread.\n    46\t *  - `--continue`: the most recently created thread.\n    47\t *  - no flag: a new thread, registered with its cwd (AC-1.1).\n    48\t *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\n    49\t *  durable id rather than a retained object (AC-1.5). */\n    50\texport async function resolveThread(\n    51\t  launch: LaunchFlags,\n    52\t  deps: ResolveDeps,\n    53\t): Promise<OpResult<ThreadRef>> {\n    54\t  if (launch.session !== undefined) {\n    55\t    const resolved = await threads.resolve({\n    56\t      threadId: launch.session,\n    57\t      ...registryArg(deps.registryPath),\n    58\t    });\n    59\t    if (!resolved.ok) return resolved;\n    60\t    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\n    61\t  }\n    62\t\n    63\t  if (launch.continue === true) {\n    64\t    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\n    65\t    if (!listed.ok) return listed;\n    66\t    // The registry lists in creation order with an insertion-order tie-break,\n    67\t    // so the last row is the most recently created thread.\n    68\t    const mostRecent = listed.value.at(-1);\n    69\t    if (mostRecent === undefined) {\n    70\t      return {\n    71\t        ok: false,\n    72\t        error: {\n    73\t          errorClass: \"caller_error\",\n    74\t          code: \"thread_not_found\",\n    75\t          reason: \"--continue: no threads exist to continue\",\n    76\t        },\n    77\t      };\n    78\t    }\n    79\t    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\n    80\t  }\n    81\t\n    82\t  const created = await threads.newThread({\n    83\t    filePath: deps.newThreadFilePath(),\n    84\t    cwd: deps.cwd,\n    85\t    ...registryArg(deps.registryPath),\n    86\t  });\n    87\t  if (!created.ok) return created;\n    88\t  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\n    89\t}\n    90\t\n    91\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\n    92\t *  so PI's launch arguments are visible on `process.argv`; this is the\n    93\t *  production source of the launch mode. Supports `--session <id>`,\n    94\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\n    95\t *  spelling for the named-session mode is an integration detail to confirm\n    96\t *  against PI; see the story payload's open questions.) */\n    97\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\n    98\t  const flags: LaunchFlags = {};\n    99\t  for (let i = 0; i < argv.length; i += 1) {\n   100\t    const arg = argv[i];\n   101\t    if (arg === undefined) continue;\n   102\t    if (arg === \"--resume\" || arg === \"-r\") {\n   103\t      flags.resume = true;\n   104\t    } else if (arg === \"--continue\" || arg === \"-c\") {\n   105\t      flags.continue = true;\n   106\t    } else if (arg === \"--session\") {\n   107\t      const next = argv[i + 1];\n   108\t      if (next !== undefined && !next.startsWith(\"-\")) {\n   109\t        flags.session = next;\n   110\t        i += 1;\n   111\t      }\n   112\t    } else if (arg.startsWith(\"--session=\")) {\n   113\t      flags.session = arg.slice(\"--session=\".length);\n   114\t    }\n   115\t  }\n   116\t  return flags;\n   117\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=1 && NR<=286 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/pi-lhc/src/index.ts\"","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. The connector owns only plain-data `SessionState` plus the live\n     4\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\n     5\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n     6\timport { mkdirSync } from \"node:fs\";\n     7\timport { homedir } from \"node:os\";\n     8\timport { join } from \"node:path\";\n     9\timport { randomUUID } from \"node:crypto\";\n    10\timport type { OpResult, SdkConfig, ThreadRef } from \"lhc\";\n    11\timport type {\n    12\t  ExtensionAPI,\n    13\t  ExtensionContext,\n    14\t  PiHookHandler,\n    15\t  PiHookName,\n    16\t} from \"./pi/types.js\";\n    17\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    18\timport { createSessionState } from \"./lifecycle/state.js\";\n    19\timport { disposeInstance, initInstance } from \"./lifecycle/instance.js\";\n    20\timport {\n    21\t  parseLaunchFlags,\n    22\t  resolveThread,\n    23\t  type LaunchFlags,\n    24\t} from \"./lifecycle/thread-resolution.js\";\n    25\timport { pickThread, type ThreadChoice } from \"./lifecycle/picker.js\";\n    26\timport type { LhcInstance } from \"./shared/instance.js\";\n    27\t\n    28\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    29\texport type { LhcInstance } from \"./shared/instance.js\";\n    30\t\n    31\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    32\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    33\t *  registers no handler for it (story Scope Out). */\n    34\texport const EPIC_1_HOOKS = [\n    35\t  \"session_start\",\n    36\t  \"message_end\",\n    37\t  \"turn_end\",\n    38\t  \"agent_end\",\n    39\t  \"model_select\",\n    40\t  \"thinking_level_select\",\n    41\t  \"session_before_fork\",\n    42\t  \"session_before_switch\",\n    43\t  \"session_shutdown\",\n    44\t] as const satisfies readonly PiHookName[];\n    45\t\n    46\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    47\t\n    48\t/** What the connector needs from the host to run a session. All injectable so\n    49\t *  the lifecycle is exercised against a real temp registry/thread in tests and\n    50\t *  the default `~/.lhc` registry in production.\n    51\t *\n    52\t *  `buildSdkConfig` is the inference seam: it returns the SdkConfig (provider /\n    53\t *  inference + policy) to construct the instance from. In Story 1 the real\n    54\t *  config — the PI-model-registry-backed `ModelCall` and assignments — is not\n    55\t *  wired yet (that is Stories 5/6), so the default fails closed; the connector\n    56\t *  then resolves nothing and records a diagnostic rather than faking a session.\n    57\t */\n    58\texport interface ConnectorDeps {\n    59\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\n    60\t  registryPath?: string;\n    61\t  newThreadFilePath?: () => string;\n    62\t  parseLaunch?: () => LaunchFlags;\n    63\t  selectThread?: (\n    64\t    choices: readonly ThreadChoice[],\n    65\t    ctx: ExtensionContext,\n    66\t  ) => Promise<string | null>;\n    67\t}\n    68\t\n    69\t/** Everything the connector retains across hooks as PLAIN data — by\n    70\t *  construction structuredClone-able. The live `LhcInstance` is held separately\n    71\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\n    72\t *  deliberately not part of the snapshot. */\n    73\texport interface ConnectorSnapshot {\n    74\t  state: SessionState | null;\n    75\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    76\t}\n    77\t\n    78\texport interface Connector {\n    79\t  /** Register the observe-only hook rail on the PI extension API. */\n    80\t  register(pi: ExtensionAPI): void;\n    81\t  /** The plain-data state retained across hooks. `null` until a session\n    82\t   *  resolves a thread; never holds a PI ctx. */\n    83\t  getState(): SessionState | null;\n    84\t  /** The live LHC instance for the current session, or `null`. A test/inspection\n    85\t   *  seam — held by the connector but never part of the plain-data snapshot. */\n    86\t  getInstance(): LhcInstance | null;\n    87\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n    88\t  snapshot(): ConnectorSnapshot;\n    89\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n    90\t   *  synthetic ctx/events without a live PI. */\n    91\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n    92\t}\n    93\t\n    94\tconst DEFAULT_LHC_DIR = join(homedir(), \".lhc\");\n    95\t\n    96\t/** Inference host not wired yet (Story 5/6): fail closed so a session resolves\n    97\t *  nothing and records a diagnostic instead of constructing a faked instance. */\n    98\tfunction inferenceNotConfigured(): OpResult<SdkConfig> {\n    99\t  return {\n   100\t    ok: false,\n   101\t    error: {\n   102\t      errorClass: \"system_error\",\n   103\t      code: \"not_implemented\",\n   104\t      reason:\n   105\t        \"pi-lhc inference host not wired yet (Epic 1 Story 5); SDK construction deferred\",\n   106\t    },\n   107\t  };\n   108\t}\n   109\t\n   110\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\n   111\t *  generated by the registry at creation, so the file name is just a unique\n   112\t *  handle; the directory is ensured up front (DatabaseSync does not create\n   113\t *  parents). */\n   114\tfunction defaultNewThreadFilePath(): string {\n   115\t  const dir = join(DEFAULT_LHC_DIR, \"threads\");\n   116\t  mkdirSync(dir, { recursive: true });\n   117\t  return join(dir, `${randomUUID()}.sqlite`);\n   118\t}\n   119\t\n   120\tfunction threadIdOf(ref: ThreadRef): string | null {\n   121\t  return \"threadId\" in ref ? ref.threadId : null;\n   122\t}\n   123\t\n   124\t/** Build a connector instance. Its mutable state lives in this closure; the\n   125\t *  registered handlers capture it, so the instance stays live for the session\n   126\t *  even when `activate` discards the returned object. */\n   127\texport function createConnector(deps: ConnectorDeps = {}): Connector {\n   128\t  // The connector's retained state. `state` is plain data (the durable thread\n   129\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\n   130\t  // `rememberedThreadId` is the durable id the reload path reattaches by; and\n   131\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object.\n   132\t  let state: SessionState | null = null;\n   133\t  let instance: LhcInstance | null = null;\n   134\t  let rememberedThreadId: string | null = null;\n   135\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n   136\t\n   137\t  const buildSdkConfig = deps.buildSdkConfig ?? (() => inferenceNotConfigured());\n   138\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\n   139\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\n   140\t  const selectThread =\n   141\t    deps.selectThread ?? ((): Promise<string | null> => Promise.resolve(null));\n   142\t\n   143\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\n   144\t    return { code, message, recordedGap: false };\n   145\t  }\n   146\t\n   147\t  // On reload (same session continues, in-memory state wiped) reconstruct the\n   148\t  // SAME thread from its durable id rather than re-running the launch — a\n   149\t  // no-flag session would otherwise create a duplicate (AC-1.5). The launch\n   150\t  // (process.argv) is the fallback when no id is remembered, which covers\n   151\t  // --session/--continue/--resume reloads. The permanent home for reload\n   152\t  // lineage is LHC thread metadata (Feature 2+).\n   153\t  function launchFor(event: { reason: string }): LaunchFlags {\n   154\t    if (event.reason === \"reload\" && rememberedThreadId !== null) {\n   155\t      return { session: rememberedThreadId };\n   156\t    }\n   157\t    return parseLaunch();\n   158\t  }\n   159\t\n   160\t  async function resolveForLaunch(\n   161\t    launch: LaunchFlags,\n   162\t    ctx: ExtensionContext,\n   163\t  ): Promise<OpResult<ThreadRef | null>> {\n   164\t    if (launch.resume === true) {\n   165\t      const pickerDeps: {\n   166\t        registryPath?: string;\n   167\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\n   168\t      } = { select: (choices) => selectThread(choices, ctx) };\n   169\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\n   170\t      return pickThread(ctx.cwd, pickerDeps);\n   171\t    }\n   172\t    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\n   173\t      cwd: ctx.cwd,\n   174\t      newThreadFilePath,\n   175\t    };\n   176\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\n   177\t    return resolveThread(launch, resolveDeps);\n   178\t  }\n   179\t\n   180\t  // session_start: resolve the recording thread from the launch and construct\n   181\t  // one background instance against it. Config is gated first so a session with\n   182\t  // no usable inference config resolves/creates nothing (no orphan thread).\n   183\t  const onSessionStart: PiHookHandler<\"session_start\"> = async (ctx, event) => {\n   184\t    const config = buildSdkConfig(ctx);\n   185\t    if (!config.ok) {\n   186\t      lastDiagnostic = diag(\"instance_not_configured\", config.error.reason);\n   187\t      return;\n   188\t    }\n   189\t    const resolved = await resolveForLaunch(launchFor(event), ctx);\n   190\t    if (!resolved.ok) {\n   191\t      lastDiagnostic = diag(\"thread_resolution_failed\", resolved.error.reason);\n   192\t      return;\n   193\t    }\n   194\t    if (resolved.value === null) {\n   195\t      lastDiagnostic = diag(\"no_thread_selected\", \"--resume resolved no thread\");\n   196\t      return;\n   197\t    }\n   198\t    const built = await initInstance(resolved.value, config.value);\n   199\t    if (!built.ok) {\n   200\t      lastDiagnostic = diag(\"instance_init_failed\", built.error.reason);\n   201\t      return;\n   202\t    }\n   203\t    instance = built.value;\n   204\t    state = createSessionState(resolved.value);\n   205\t    rememberedThreadId = threadIdOf(resolved.value);\n   206\t  };\n   207\t\n   208\t  // Dispose with flush before any session swap (session_before_switch fires\n   209\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\n   210\t  // no live instance is a no-op.\n   211\t  const onDispose: PiHookHandler<Epic1Hook> = async () => {\n   212\t    const result = await disposeInstance(instance);\n   213\t    if (!result.ok) lastDiagnostic = diag(\"dispose_failed\", result.error.reason);\n   214\t    instance = null;\n   215\t  };\n   216\t\n   217\t  // Contain every handler: an observe-only hook must never throw back into PI\n   218\t  // (a thrown hook breaks the user's session). A caught error becomes a\n   219\t  // plain-data diagnostic; it is never rethrown.\n   220\t  const guard = (\n   221\t    name: Epic1Hook,\n   222\t    body: PiHookHandler<Epic1Hook>,\n   223\t  ): PiHookHandler<Epic1Hook> => {\n   224\t    return async (ctx, event): Promise<void> => {\n   225\t      try {\n   226\t        await body(ctx, event);\n   227\t      } catch (err) {\n   228\t        lastDiagnostic = {\n   229\t          code: \"hook_handler_error\",\n   230\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n   231\t          recordedGap: false,\n   232\t        };\n   233\t      }\n   234\t    };\n   235\t  };\n   236\t\n   237\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\n   238\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\n   239\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\n   240\t  const noop: PiHookHandler<Epic1Hook> = () => {\n   241\t    // Intentionally empty — later stories replace this with real routing.\n   242\t  };\n   243\t\n   244\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\n   245\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\n   246\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\n   247\t    session_before_switch: onDispose,\n   248\t    session_shutdown: onDispose,\n   249\t    message_end: noop,\n   250\t    turn_end: noop,\n   251\t    agent_end: noop,\n   252\t    model_select: noop,\n   253\t    thinking_level_select: noop,\n   254\t    session_before_fork: noop,\n   255\t  };\n   256\t\n   257\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n   258\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\n   259\t\n   260\t  return {\n   261\t    handlers,\n   262\t    register(pi: ExtensionAPI): void {\n   263\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   264\t    },\n   265\t    getState(): SessionState | null {\n   266\t      return state;\n   267\t    },\n   268\t    getInstance(): LhcInstance | null {\n   269\t      return instance;\n   270\t    },\n   271\t    snapshot(): ConnectorSnapshot {\n   272\t      return { state, lastDiagnostic };\n   273\t    },\n   274\t  };\n   275\t}\n   276\t\n   277\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   278\t *  loads (and again on `/reload`). Registers the observe-only hook rail with\n   279\t *  the production defaults (the `~/.lhc` registry, `process.argv` launch flags).\n   280\t *  The inference-backed `buildSdkConfig` is wired in Stories 5/6; until then a\n   281\t *  live session resolves nothing and records a diagnostic rather than faking. */\n   282\texport function activate(pi: ExtensionAPI): void {\n   283\t  createConnector().register(pi);\n   284\t}\n   285\t\n   286\texport default activate;\n","exit_code":0,"status":"completed"}}

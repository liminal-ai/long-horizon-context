{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=260 && NR<=410 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/lhc/src/sdk.ts && awk 'NR>=1 && NR<=90 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/lhc/src/shared/derivation.ts\"","aggregated_output":"   260\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   261\t}\n   262\t\n   263\texport interface Lhc {\n   264\t  threads: typeof threadsDomain;\n   265\t  intakeStream: typeof intakeStreamDomain;\n   266\t  messages: typeof messagesDomain;\n   267\t  turns: typeof turnsDomain;\n   268\t  threadView: ThreadViewSurface;\n   269\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n   270\t  // like every other namespace so the status read it composes resolves THIS\n   271\t  // SDK's view config (threshold, visibility budgets).\n   272\t  inspect: typeof inspectDomain;\n   273\t  config: ResolvedSdkConfig;\n   274\t  scheduler: Scheduler;\n   275\t  workHandlers: WorkHandlerMap;\n   276\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   277\t  work: WorkSurface;\n   278\t  // Resolves when the scheduler has no running or pending drain for the\n   279\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   280\t  // resolve in manual mode.\n   281\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   282\t}\n   283\t\n   284\tfunction requirePositive(value: number, name: string): void {\n   285\t  if (!Number.isFinite(value) || value <= 0) {\n   286\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   287\t  }\n   288\t}\n   289\t\n   290\tfunction requireNonNegative(value: number, name: string): void {\n   291\t  if (!Number.isFinite(value) || value < 0) {\n   292\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   293\t  }\n   294\t}\n   295\t\n   296\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   297\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   298\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   299\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   300\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   301\t// object is the same shape as the namespace, so the public surface type holds.\n   302\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   303\t  const scoped: Record<string, unknown> = {};\n   304\t  for (const key of Object.keys(surface)) {\n   305\t    const value = (surface as Record<string, unknown>)[key];\n   306\t    scoped[key] =\n   307\t      typeof value === \"function\"\n   308\t        ? (...args: unknown[]): unknown =>\n   309\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   310\t        : value;\n   311\t  }\n   312\t  return scoped as T;\n   313\t}\n   314\t\n   315\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n   316\t// the host function and the complete assignment map loudly — all seven kinds\n   317\t// present (iterating the exported FORM_KINDS set, never a second literal\n   318\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n   319\t// provider/model routing keys — then build the adapter into the same\n   320\t// DerivationProvider slot direct injection uses. No partial construction:\n   321\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n   322\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n   323\t  if (typeof inference.call !== \"function\") {\n   324\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n   325\t  }\n   326\t  const assignments = inference.assignments as unknown;\n   327\t  if (assignments === null || typeof assignments !== \"object\") {\n   328\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n   329\t  }\n   330\t  const knownKinds = new Set<string>(FORM_KINDS);\n   331\t  for (const key of Object.keys(assignments)) {\n   332\t    if (!knownKinds.has(key)) {\n   333\t      throw new TypeError(\n   334\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n   335\t      );\n   336\t    }\n   337\t  }\n   338\t  const map = assignments as Partial<Record<FormKind, ModelAssignment>>;\n   339\t  for (const kind of FORM_KINDS) {\n   340\t    const assignment = map[kind];\n   341\t    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n   342\t      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n   343\t    }\n   344\t    for (const field of [\"provider\", \"model\"] as const) {\n   345\t      const value = assignment[field];\n   346\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n   347\t        throw new TypeError(\n   348\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n   349\t        );\n   350\t      }\n   351\t    }\n   352\t    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n   353\t      throw new TypeError(\n   354\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n   355\t      );\n   356\t    }\n   357\t  }\n   358\t  const timeoutMs = inference.timeoutMs ?? 60_000;\n   359\t  const maxInputChars = inference.maxInputChars ?? 200_000;\n   360\t  requirePositive(timeoutMs, \"inference.timeoutMs\");\n   361\t  requirePositive(maxInputChars, \"inference.maxInputChars\");\n   362\t  return createInferenceProvider({\n   363\t    call: inference.call,\n   364\t    assignments: map as Record<FormKind, ModelAssignment>,\n   365\t    timeoutMs,\n   366\t    maxInputChars,\n   367\t  });\n   368\t}\n   369\t\n   370\t// The only assembly path: provider, mode, clock, and policy enter here.\n   371\t// Config mistakes are programmer errors at construction and throw; operating\n   372\t// failures after construction return OpResults per the error contract.\n   373\texport function createSdk(config: SdkConfig): Lhc {\n   374\t  // Provider arrival is exactly one of direct injection or the inference\n   375\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n   376\t  // env/flag resolution path to fall back on. The XOR rule is validated\n   377\t  // before anything downstream so the error names the caller's mistake, not\n   378\t  // a symptom (AC-1.1).\n   379\t  if (config.provider !== undefined && config.inference !== undefined) {\n   380\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   381\t  }\n   382\t  if (config.provider === undefined && config.inference === undefined) {\n   383\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   384\t  }\n   385\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   386\t    throw new TypeError(\n   387\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   388\t    );\n   389\t  }\n   390\t  let provider: DerivationProvider;\n   391\t  if (config.inference !== undefined) {\n   392\t    provider = resolveInferenceProvider(config.inference);\n   393\t  } else {\n   394\t    if (config.provider === null || typeof config.provider !== \"object\") {\n   395\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   396\t    }\n   397\t    for (const operation of PROVIDER_OPERATIONS) {\n   398\t      if (typeof config.provider[operation] !== \"function\") {\n   399\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   400\t      }\n   401\t    }\n   402\t    provider = config.provider;\n   403\t  }\n   404\t\n   405\t  const resolved: ResolvedSdkConfig = {\n   406\t    provider,\n   407\t    mode: config.mode,\n   408\t    clock: config.clock ?? (() => new Date()),\n   409\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   410\t    lease: config.lease ?? { durationMs: 120000 },\n     1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\t// Type-only and erased at build: the runtime graph stays one-directional\n     8\t// (inference/ imports shared/, never the reverse).\n     9\timport type { InferenceConfig } from \"../inference/types.js\";\n    10\timport type { ResolvedViewConfig, SdkViewConfig } from \"./view.js\";\n    11\t\n    12\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n    13\t\n    14\t// The kind set is a runtime constant with the type derived from it, so code\n    15\t// that must cover every kind — assignment validation above all (Epic 05\n    16\t// AC-1.3) — iterates the exported set instead of maintaining a second\n    17\t// literal list that can drift.\n    18\texport const FORM_KINDS = [\n    19\t  \"smoothed_prompt\",\n    20\t  \"tool_call_summary\",\n    21\t  \"tool_result_summary\",\n    22\t  \"turn_rendering\",\n    23\t  \"lower_band_projection\",\n    24\t  \"chunk_summary_detailed\",\n    25\t  \"chunk_summary_brief\",\n    26\t] as const;\n    27\t\n    28\texport type FormKind = (typeof FORM_KINDS)[number];\n    29\t\n    30\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    31\t\n    32\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    33\t// (isError/presence), never authored by the provider (AC-2.4).\n    34\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    35\t\n    36\t// A composed form's record of a dependency that fell back during composition:\n    37\t// names the source record and the form that was not ready (AC-3.2/3.3).\n    38\texport interface DependencyGap {\n    39\t  subjectKind: SubjectKind;\n    40\t  subjectId: string;\n    41\t  form: FormKind;\n    42\t}\n    43\t\n    44\t// The read shape for one derived form's state row (DD-2, DD-3).\n    45\texport interface DerivedForm {\n    46\t  subjectKind: SubjectKind;\n    47\t  subjectId: string;\n    48\t  form: FormKind;\n    49\t  state: DerivedFormState;\n    50\t  content?: string; // ready only\n    51\t  reason?: string; // failed | blocked\n    52\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n    53\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n    54\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n    55\t  derivedAt?: string;\n    56\t}\n    57\t\n    58\t// One tool call's or result's receipt within a turn's composed account\n    59\t// (AC-3.8): the account text — what changed, as composed — plus the\n    60\t// mechanically derived outcome. Derived from the composition input, never\n    61\t// from provider prose; stamped on the turn_rendering form so the chunk\n    62\t// summaries can read receipts machine-readably in turn order.\n    63\texport interface ToolRunReceipt {\n    64\t  messageId: string;\n    65\t  activity: \"tool_call\" | \"tool_result\";\n    66\t  account: string;\n    67\t  outcome: ToolOutcome;\n    68\t}\n    69\t\n    70\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n    71\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n    72\t// final attempts/last-error copied from the work item before its row is\n    73\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n    74\t// lives here).\n    75\texport interface DerivedFormMetadata {\n    76\t  outcome?: ToolOutcome;\n    77\t  receipts?: ToolRunReceipt[];\n    78\t  attempts?: number;\n    79\t  lastError?: string;\n    80\t  // Epic 05 (DD-4): which provider/model/prompt produced the content —\n    81\t  // copied from the ProviderResult's config-known strings, never authored\n    82\t  // from model output. The deterministic provider never sets it.\n    83\t  provenance?: ProviderProvenance;\n    84\t}\n    85\t\n    86\t// One row of an owner's repair report (Flow 4): the form's durable state\n    87\t// joined with the queue's mechanical detail for the live item still working\n    88\t// toward it, if any. The five operational situations read from this one row:\n    89\t// never-attempted (pending, no queue), retrying (pending + queue with\n    90\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_48","type":"agent_message","text":"{\"artifactsRead\":[\"docs/specs/02-pi-lhc/01-connector-core/stories/01-session-lifecycle-and-thread-resolution.md\",\"docs/specs/02-pi-lhc/01-connector-core/tech-design.md\",\"docs/specs/02-pi-lhc/01-connector-core/test-plan.md\",\"docs/specs/02-pi-lhc/01-connector-core/epic.md\",\"docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/003-implementor.json\",\"packages/pi-lhc/src/index.ts\",\"packages/pi-lhc/src/lifecycle/instance.ts\",\"packages/pi-lhc/src/lifecycle/thread-resolution.ts\",\"packages/pi-lhc/src/lifecycle/picker.ts\",\"packages/pi-lhc/src/lifecycle/state.ts\",\"packages/pi-lhc/test/lifecycle/instance.test.ts\",\"packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\",\"packages/pi-lhc/test/smoke/extension-load.test.ts\",\"packages/lhc/src/domains/threads/index.ts\",\"packages/lhc/src/domains/threads/internal/registry.ts\",\"packages/lhc/src/shared/errors.ts\",\"packages/lhc/test/threads-a8.test.ts\"],\"reviewScopeSummary\":\"Verified Story 1 AC-1.1 through AC-1.7 against the story, tech design, test plan, implementation, focused tests, and configured gates. The module-level lifecycle and registry tests pass, but the production entry path and reload/title requirements are not ready for handoff.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"SV-001\",\"severity\":\"major\",\"title\":\"Production activate path is still a placeholder lifecycle path\",\"evidence\":\"The production entrypoint calls createConnector() with no deps at packages/pi-lhc/src/index.ts:282-283. Default buildSdkConfig is inferenceNotConfigured at lines 96-107 and wired at line 137, so session_start returns at lines 184-188 before resolving/creating any thread or initializing LHC. The default --resume selector at lines 140-141 always returns null, so production --resume cannot resolve an operator selection. Tests cover real lifecycle only by injecting buildSdkConfig/selectThread in packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:215-220 and 246-250. This leaves real app/runtime code on non-real fail-closed branches for Story 1 lifecycle behavior.\",\"affectedFiles\":[\"packages/pi-lhc/src/index.ts\",\"packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"],\"requirementIds\":[\"AC-1.1\",\"AC-1.2\",\"AC-1.7\",\"TC-1.1\",\"TC-1.2\",\"TC-1.7\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true},{\"id\":\"SV-002\",\"severity\":\"major\",\"title\":\"Reload reconstruction uses retained memory, not durable state after teardown\",\"evidence\":\"AC-1.5 requires reload after extension teardown/re-initialization to reconstruct from durable resolved thread id. The implementation stores rememberedThreadId only in the createConnector closure at packages/pi-lhc/src/index.ts:132-155, then sets it at line 205. activate() creates a fresh connector on load at lines 282-283, with no durable id source. The reload test uses the same connector instance across shutdown and session_start reload at packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:246-262, so it does not prove teardown/re-initialization. With a fresh connector and no launch flag, launchFor falls back to parseLaunch at line 157 and would not know the prior thread id.\",\"affectedFiles\":[\"packages/pi-lhc/src/index.ts\",\"packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"],\"requirementIds\":[\"AC-1.5\",\"TC-1.5\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true},{\"id\":\"SV-003\",\"severity\":\"major\",\"title\":\"Fresh thread creation omits required title metadata\",\"evidence\":\"Story scope requires A-8 title support and TC-1.1 requires a new registry thread with cwd/title metadata. The no-flag creation path in packages/pi-lhc/src/lifecycle/thread-resolution.ts:82-86 passes filePath and cwd to threads.newThread but no title. The lifecycle test only asserts cwd at packages/pi-lhc/test/lifecycle/instance.test.ts:48-56. The thread-resolution test comment at packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:43-45 explicitly states connector-created new threads carry no title, while direct test setup supplies titles only for picker fixtures.\",\"affectedFiles\":[\"packages/pi-lhc/src/lifecycle/thread-resolution.ts\",\"packages/pi-lhc/test/lifecycle/instance.test.ts\",\"packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"],\"requirementIds\":[\"AC-1.1\",\"TC-1.1\",\"A-8\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true}],\"openFindings\":[{\"id\":\"SV-001\",\"severity\":\"major\",\"title\":\"Production activate path is still a placeholder lifecycle path\",\"evidence\":\"The production entrypoint calls createConnector() with no deps at packages/pi-lhc/src/index.ts:282-283. Default buildSdkConfig is inferenceNotConfigured at lines 96-107 and wired at line 137, so session_start returns at lines 184-188 before resolving/creating any thread or initializing LHC. The default --resume selector at lines 140-141 always returns null, so production --resume cannot resolve an operator selection. Tests cover real lifecycle only by injecting buildSdkConfig/selectThread in packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:215-220 and 246-250. This leaves real app/runtime code on non-real fail-closed branches for Story 1 lifecycle behavior.\",\"affectedFiles\":[\"packages/pi-lhc/src/index.ts\",\"packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"],\"requirementIds\":[\"AC-1.1\",\"AC-1.2\",\"AC-1.7\",\"TC-1.1\",\"TC-1.2\",\"TC-1.7\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true},{\"id\":\"SV-002\",\"severity\":\"major\",\"title\":\"Reload reconstruction uses retained memory, not durable state after teardown\",\"evidence\":\"AC-1.5 requires reload after extension teardown/re-initialization to reconstruct from durable resolved thread id. The implementation stores rememberedThreadId only in the createConnector closure at packages/pi-lhc/src/index.ts:132-155, then sets it at line 205. activate() creates a fresh connector on load at lines 282-283, with no durable id source. The reload test uses the same connector instance across shutdown and session_start reload at packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:246-262, so it does not prove teardown/re-initialization. With a fresh connector and no launch flag, launchFor falls back to parseLaunch at line 157 and would not know the prior thread id.\",\"affectedFiles\":[\"packages/pi-lhc/src/index.ts\",\"packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"],\"requirementIds\":[\"AC-1.5\",\"TC-1.5\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true},{\"id\":\"SV-003\",\"severity\":\"major\",\"title\":\"Fresh thread creation omits required title metadata\",\"evidence\":\"Story scope requires A-8 title support and TC-1.1 requires a new registry thread with cwd/title metadata. The no-flag creation path in packages/pi-lhc/src/lifecycle/thread-resolution.ts:82-86 passes filePath and cwd to threads.newThread but no title. The lifecycle test only asserts cwd at packages/pi-lhc/test/lifecycle/instance.test.ts:48-56. The thread-resolution test comment at packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:43-45 explicitly states connector-created new threads carry no title, while direct test setup supplies titles only for picker fixtures.\",\"affectedFiles\":[\"packages/pi-lhc/src/lifecycle/thread-resolution.ts\",\"packages/pi-lhc/test/lifecycle/instance.test.ts\",\"packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"],\"requirementIds\":[\"AC-1.1\",\"TC-1.1\",\"A-8\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"TC-1.2 resolver-level existing-thread resolution creates no second thread: packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:81-90.\",\"TC-1.3 plain-data holder across fresh ctx objects: packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:213-239 and state shape in packages/pi-lhc/src/lifecycle/state.ts:23-42.\",\"TC-1.4 shutdown flush and reattach read-back at module level: packages/pi-lhc/test/lifecycle/instance.test.ts:73-108; dispose calls drainSettled in packages/pi-lhc/src/lifecycle/instance.ts:29-43.\",\"TC-1.6 resolver launch modes: no flag, full id, partial id, continue, bad id, ambiguous id in packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:92-130.\",\"A-8 registry cwd, partial-id resolve, ambiguous-id failure, cwd-filtered listThreads, and migration behavior: packages/lhc/test/threads-a8.test.ts:32-189.\",\"TC-1.7 picker module lists cwd-scoped titled fixture threads and empty cwd returns null: packages/pi-lhc/test/lifecycle/thread-resolution.test.ts:132-170.\"],\"unverified\":[\"AC-1.1/TC-1.1 production session_start creates one cwd/title thread and one background instance: blocked by SV-001 and SV-003.\",\"AC-1.2 production session_start initializes against an existing resolved thread: blocked by SV-001.\",\"AC-1.5/TC-1.5 reload after extension teardown/re-initialization reconstructs from durable resolved thread id: blocked by SV-002.\",\"AC-1.7 production --resume operator selection through activate(): blocked by SV-001.\"]},\"gatesRun\":[{\"command\":\"pnpm --filter pi-lhc exec vitest run test/lifecycle/instance.test.ts test/lifecycle/thread-resolution.test.ts\",\"result\":\"pass\"},{\"command\":\"pnpm --filter lhc exec vitest run test/threads-a8.test.ts\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify-all\",\"result\":\"pass\"},{\"command\":\"pnpm --filter lhc verify\",\"result\":\"pass\"}],\"productionPathFindings\":[\"packages/pi-lhc/src/index.ts production activate() uses default inferenceNotConfigured, so session_start does not create/resolve a thread or initialize LHC without test-only dependency injection.\",\"packages/pi-lhc/src/index.ts production --resume default selector returns null, so picker selection is not real in the activate path.\",\"packages/pi-lhc/src/index.ts reload reconstruction depends on closure memory rememberedThreadId, not a durable id available after extension teardown/re-initialization.\",\"packages/pi-lhc/src/lifecycle/thread-resolution.ts new-thread creation omits title metadata required by TC-1.1/A-8.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"fresh-fix-path\",\"openQuestions\":[\"Title derivation is named in the epic as a design question, but the current story and TC-1.1 require title metadata. If the implementor cannot choose an accepted creation-time title from existing design, this needs a human ruling before fixing SV-003.\"],\"additionalObservations\":[\"Configured story and epic gates passed despite the blockers because the tests exercise injected lifecycle paths rather than the production activate defaults.\",\"No PI-session-to-thread mapping record was found in the inspected implementation; resolution uses the LHC registry.\"]}"}}

{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=1 && NR<=130 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/pi-lhc/test/lifecycle/instance.test.ts\"","aggregated_output":"     1\t// Story 1 — instance lifecycle (TC-1.1, TC-1.4). Driven through the real\n     2\t// lifecycle functions against a real temp registry + thread (the store is never\n     3\t// mocked; persistence/reattach are the product contract). The SDK is built with\n     4\t// the deterministic provider — a valid construction that needs no real\n     5\t// inference, which the inference host (Stories 5/6) supplies in production.\n     6\timport { existsSync } from \"node:fs\";\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  createDeterministicProvider,\n    10\t  inspect,\n    11\t  threads,\n    12\t  type SdkConfig,\n    13\t  type ThreadRef,\n    14\t} from \"lhc\";\n    15\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n    16\timport { resolveThread } from \"../../src/lifecycle/thread-resolution.js\";\n    17\timport { eventBatch } from \"../fixtures/synthetic.js\";\n    18\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    19\t\n    20\tlet store: TempStore;\n    21\tbeforeEach(() => {\n    22\t  store = tempStore();\n    23\t});\n    24\tafterEach(() => {\n    25\t  store.cleanup();\n    26\t});\n    27\t\n    28\tfunction backgroundConfig(): SdkConfig {\n    29\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n    30\t}\n    31\t\n    32\tfunction idOf(ref: ThreadRef): string {\n    33\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n    34\t  return ref.threadId;\n    35\t}\n    36\t\n    37\tdescribe(\"Story 1: instance lifecycle\", () => {\n    38\t  it(\"TC-1.1: a no-flag launch creates one cwd-registered thread and one background instance\", async () => {\n    39\t    const cwd = \"/work/tc-1-1\";\n    40\t    const resolved = await resolveThread(\n    41\t      {},\n    42\t      { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    43\t    );\n    44\t    expect(resolved.ok).toBe(true);\n    45\t    if (!resolved.ok) return;\n    46\t    const threadId = idOf(resolved.value);\n    47\t\n    48\t    // Exactly one thread registered, and its registry row carries the cwd.\n    49\t    const all = await threads.listThreads({ registryPath: store.registryPath });\n    50\t    expect(all.ok).toBe(true);\n    51\t    if (all.ok) expect(all.value).toHaveLength(1);\n    52\t\n    53\t    const row = await threads.resolve({ threadId, registryPath: store.registryPath });\n    54\t    expect(row.ok).toBe(true);\n    55\t    if (!row.ok) return;\n    56\t    expect(row.value.cwd).toBe(cwd);\n    57\t    expect(existsSync(row.value.filePath)).toBe(true); // a real thread file exists\n    58\t\n    59\t    // One instance, in background scheduler mode. Background mode means the\n    60\t    // scheduler auto-drains; the connector never calls drain/drainSettled during\n    61\t    // startup (initInstance only validates the thread), so it does not drive the\n    62\t    // queue itself (AC-1.1).\n    63\t    const built = await initInstance(resolved.value, backgroundConfig());\n    64\t    expect(built.ok).toBe(true);\n    65\t    if (!built.ok) return;\n    66\t    expect(built.value.sdk.config.mode).toBe(\"background\");\n    67\t    expect(idOf(built.value.threadRef)).toBe(threadId);\n    68\t\n    69\t    const disposed = await disposeInstance(built.value);\n    70\t    expect(disposed.ok).toBe(true);\n    71\t  });\n    72\t\n    73\t  it(\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\", async () => {\n    74\t    const resolved = await resolveThread(\n    75\t      {},\n    76\t      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n    77\t    );\n    78\t    expect(resolved.ok).toBe(true);\n    79\t    if (!resolved.ok) return;\n    80\t    const threadId = idOf(resolved.value);\n    81\t\n    82\t    const built = await initInstance(resolved.value, backgroundConfig());\n    83\t    expect(built.ok).toBe(true);\n    84\t    if (!built.ok) return;\n    85\t\n    86\t    // Capture N raw intake events through the instance (the converter is Story 2;\n    87\t    // the lifecycle proof needs only that recorded events survive shutdown).\n    88\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    89\t    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\n    90\t    expect(captured.ok).toBe(true);\n    91\t\n    92\t    // Dispose with flush.\n    93\t    const disposed = await disposeInstance(built.value);\n    94\t    expect(disposed.ok).toBe(true);\n    95\t\n    96\t    // Reattach: resolve the same thread by id (no retained instance) and read\n    97\t    // back — every pre-shutdown event is present, no trailing loss.\n    98\t    const reattached = await resolveThread(\n    99\t      { session: threadId },\n   100\t      { cwd: \"/work/tc-1-4\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\n   101\t    );\n   102\t    expect(reattached.ok).toBe(true);\n   103\t    if (!reattached.ok) return;\n   104\t\n   105\t    const overview = await inspect.overview(reattached.value);\n   106\t    expect(overview.ok).toBe(true);\n   107\t    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\n   108\t  });\n   109\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=151 && NR<=320 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"","aggregated_output":"   151\t      expect(choice.title).toBeTruthy();\n   152\t    }\n   153\t\n   154\t    // The operator's selection resolves to that thread.\n   155\t    if (picked.ok && picked.value !== null) {\n   156\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\n   157\t    }\n   158\t\n   159\t    // An empty cwd reports an empty list (null) without failing or prompting.\n   160\t    let selectCalled = false;\n   161\t    const empty = await pickThread(\"/work/empty\", {\n   162\t      registryPath: store.registryPath,\n   163\t      select: () => {\n   164\t        selectCalled = true;\n   165\t        return Promise.resolve(null);\n   166\t      },\n   167\t    });\n   168\t    expect(empty.ok).toBe(true);\n   169\t    if (empty.ok) expect(empty.value).toBeNull();\n   170\t    expect(selectCalled).toBe(false);\n   171\t  });\n   172\t\n   173\t  it(\"TC-1.5 (risk: restart): reattach reconstructs the thread from its durable id after the holder is discarded\", async () => {\n   174\t    const cwd = \"/work/tc-1-5\";\n   175\t    // Create + capture on a thread.\n   176\t    const created = await resolveThread({}, deps(cwd));\n   177\t    expect(created.ok).toBe(true);\n   178\t    if (!created.ok) return;\n   179\t    const threadId = idOf(created.value);\n   180\t\n   181\t    const first = await initInstance(created.value, backgroundConfig());\n   182\t    expect(first.ok).toBe(true);\n   183\t    if (!first.ok) return;\n   184\t    await first.value.sdk.intakeStream.messageEvents(\n   185\t      first.value.threadRef,\n   186\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n   187\t    );\n   188\t    await disposeInstance(first.value);\n   189\t\n   190\t    // Discard ALL in-memory state. Only the durable id survives (as it would in\n   191\t    // the registry across process death). Reconstruct purely from it — no\n   192\t    // retained object.\n   193\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\n   194\t    expect(reattached.ok).toBe(true);\n   195\t    if (!reattached.ok) return;\n   196\t    expect(idOf(reattached.value)).toBe(threadId); // the same thread, by id\n   197\t\n   198\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\n   199\t    expect(rebuilt.ok).toBe(true);\n   200\t    if (!rebuilt.ok) return;\n   201\t    // Capture continues on the same thread: append more, all events present.\n   202\t    await rebuilt.value.sdk.intakeStream.messageEvents(\n   203\t      rebuilt.value.threadRef,\n   204\t      eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n   205\t    );\n   206\t    const overview = await inspect.overview(reattached.value);\n   207\t    expect(overview.ok).toBe(true);\n   208\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\n   209\t    await disposeInstance(rebuilt.value);\n   210\t  });\n   211\t});\n   212\t\n   213\tdescribe(\"Story 1: plain-data state across hooks\", () => {\n   214\t  it(\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\", async () => {\n   215\t    const connector = createConnector({\n   216\t      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\n   217\t      registryPath: store.registryPath,\n   218\t      newThreadFilePath: () => store.threadPath(),\n   219\t      parseLaunch: () => ({}), // no flag → new thread\n   220\t    });\n   221\t\n   222\t    // session_start with a ctx carrying methods.\n   223\t    await connector.handlers.session_start(syntheticCtx(\"/work/a\"), makeSessionStart(\"new\"));\n   224\t    expect(connector.getState()).not.toBeNull();\n   225\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\n   226\t    // ...but the snapshot is plain data only — it survives structuredClone even\n   227\t    // though the live ctx and instance carry methods (they are not in it).\n   228\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   229\t    const threadRefBefore = connector.getState()?.threadRef;\n   230\t\n   231\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\n   232\t    // holder still references no prior ctx.\n   233\t    await connector.handlers.message_end(\n   234\t      syntheticCtx(\"/work/a\"),\n   235\t      makeMessageEnd(makeUserMessage(\"hi\")),\n   236\t    );\n   237\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n   238\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\n   239\t  });\n   240\t});\n   241\t\n   242\tdescribe(\"Story 1: reload reconstruction (connector wiring)\", () => {\n   243\t  it(\"TC-1.5 (wiring): on reload the connector reattaches the same thread, not a duplicate\", async () => {\n   244\t    // The launch is no-flag, which would create a NEW thread on every resolve.\n   245\t    // The reload path must instead reattach the durable resolved id (AC-1.5).\n   246\t    const connector = createConnector({\n   247\t      buildSdkConfig: (): OpResult<SdkConfig> => ({ ok: true, value: backgroundConfig() }),\n   248\t      registryPath: store.registryPath,\n   249\t      newThreadFilePath: () => store.threadPath(),\n   250\t      parseLaunch: () => ({}),\n   251\t    });\n   252\t\n   253\t    await connector.handlers.session_start(syntheticCtx(\"/work/reload\"), makeSessionStart(\"new\"));\n   254\t    const firstRef = connector.getState()?.threadRef;\n   255\t    const firstId = firstRef !== undefined && \"threadId\" in firstRef ? firstRef.threadId : null;\n   256\t    expect(firstId).not.toBeNull();\n   257\t    const countAfterNew = await threadCount();\n   258\t\n   259\t    // /reload fires shutdown{reload} then session_start{reload} on the same\n   260\t    // session — the connector disposes, then reconstructs the SAME thread.\n   261\t    await connector.handlers.session_shutdown(syntheticCtx(\"/work/reload\"), { reason: \"reload\" });\n   262\t    await connector.handlers.session_start(syntheticCtx(\"/work/reload\"), makeSessionStart(\"reload\"));\n   263\t\n   264\t    const reloadedRef = connector.getState()?.threadRef;\n   265\t    const reloadedId =\n   266\t      reloadedRef !== undefined && \"threadId\" in reloadedRef ? reloadedRef.threadId : null;\n   267\t    expect(reloadedId).toBe(firstId); // reattached the same thread by its durable id\n   268\t    expect(connector.getInstance()).not.toBeNull(); // a fresh instance on the same thread\n   269\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\n   270\t  });\n   271\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"awk 'NR>=1 && NR<=150 {printf \\\"%6d\\\\t%s\\\\n\\\", NR, \"'$0}'\"' packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\"","aggregated_output":"     1\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\n     2\t// reconstruction (TC-1.2, 1.3, 1.5, 1.6, 1.7 + the restart architecture-risk\n     3\t// test). Resolution and the picker are exercised directly against a real temp\n     4\t// registry; the plain-data rule and reload are exercised through the connector.\n     5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     6\timport {\n     7\t  createDeterministicProvider,\n     8\t  inspect,\n     9\t  threads,\n    10\t  type OpResult,\n    11\t  type SdkConfig,\n    12\t  type ThreadRef,\n    13\t} from \"lhc\";\n    14\timport { createConnector } from \"../../src/index.js\";\n    15\timport { disposeInstance, initInstance } from \"../../src/lifecycle/instance.js\";\n    16\timport { resolveThread, type ResolveDeps } from \"../../src/lifecycle/thread-resolution.js\";\n    17\timport { pickThread, type ThreadChoice } from \"../../src/lifecycle/picker.js\";\n    18\timport type { ExtensionContext } from \"../../src/pi/types.js\";\n    19\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n    20\timport { tempStore, type TempStore } from \"../fixtures/thread.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tfunction backgroundConfig(): SdkConfig {\n    31\t  return { provider: createDeterministicProvider(), mode: \"background\" };\n    32\t}\n    33\t\n    34\tfunction idOf(ref: ThreadRef): string {\n    35\t  if (!(\"threadId\" in ref)) throw new Error(\"expected a { threadId } ref\");\n    36\t  return ref.threadId;\n    37\t}\n    38\t\n    39\tfunction deps(cwd = \"/work/default\"): ResolveDeps {\n    40\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\n    41\t}\n    42\t\n    43\t// Create a thread directly with cwd/title so the picker test can assert both —\n    44\t// new threads created by the connector carry a cwd but no title yet (title\n    45\t// derivation is the deferred TDQ Q4).\n    46\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\n    47\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\n    48\t    filePath: store.threadPath(),\n    49\t    registryPath: store.registryPath,\n    50\t  };\n    51\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\n    52\t  if (opts.title !== undefined) input.title = opts.title;\n    53\t  const created = await threads.newThread(input);\n    54\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\n    55\t  return created.value.threadId;\n    56\t}\n    57\t\n    58\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\n    59\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\n    60\t// object, modelling PI handing a fresh ctx to each hook.\n    61\tfunction syntheticCtx(cwd: string): ExtensionContext {\n    62\t  return {\n    63\t    cwd,\n    64\t    hasUI: false,\n    65\t    modelRegistry: {\n    66\t      find: () => undefined,\n    67\t      hasConfiguredAuth: () => false,\n    68\t      getAvailable: () => [],\n    69\t    },\n    70\t    ui: { notify: () => {} },\n    71\t    sessionManager: { getEntries: () => [] },\n    72\t  };\n    73\t}\n    74\t\n    75\tasync function threadCount(): Promise<number> {\n    76\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\n    77\t  return listed.ok ? listed.value.length : -1;\n    78\t}\n    79\t\n    80\tdescribe(\"Story 1: launch-driven thread resolution\", () => {\n    81\t  it(\"TC-1.2: --session resolves an existing thread and creates no second thread\", async () => {\n    82\t    const existingId = await makeThread({ cwd: \"/work/a\", title: \"existing\" });\n    83\t    const before = await threadCount();\n    84\t\n    85\t    const resolved = await resolveThread({ session: existingId }, deps());\n    86\t    expect(resolved.ok).toBe(true);\n    87\t    if (resolved.ok) expect(idOf(resolved.value)).toBe(existingId);\n    88\t\n    89\t    expect(await threadCount()).toBe(before); // no second thread\n    90\t  });\n    91\t\n    92\t  it(\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\", async () => {\n    93\t    // no flag → a new thread\n    94\t    const first = await resolveThread({}, deps());\n    95\t    expect(first.ok).toBe(true);\n    96\t    if (!first.ok) return;\n    97\t    const firstId = idOf(first.value);\n    98\t\n    99\t    // --session full id → the same thread\n   100\t    const byFull = await resolveThread({ session: firstId }, deps());\n   101\t    expect(byFull.ok).toBe(true);\n   102\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\n   103\t\n   104\t    // --session partial id → the same thread\n   105\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\n   106\t    expect(byPartial.ok).toBe(true);\n   107\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\n   108\t\n   109\t    // a second thread, then --continue → the most recently created\n   110\t    const second = await resolveThread({}, deps());\n   111\t    expect(second.ok).toBe(true);\n   112\t    if (!second.ok) return;\n   113\t    const secondId = idOf(second.value);\n   114\t    const continued = await resolveThread({ continue: true }, deps());\n   115\t    expect(continued.ok).toBe(true);\n   116\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\n   117\t\n   118\t    // unresolvable id → actionable error, no thread created\n   119\t    const before = await threadCount();\n   120\t    const bad = await resolveThread({ session: \"th_zzzzzzzzzzzzzzzz\" }, deps());\n   121\t    expect(bad.ok).toBe(false);\n   122\t    if (!bad.ok) expect(bad.error.code).toBe(\"thread_not_found\");\n   123\t    expect(await threadCount()).toBe(before);\n   124\t\n   125\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\n   126\t    const ambiguous = await resolveThread({ session: \"th_\" }, deps());\n   127\t    expect(ambiguous.ok).toBe(false);\n   128\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\"ambiguous_thread_id\");\n   129\t    expect(await threadCount()).toBe(before);\n   130\t  });\n   131\t\n   132\t  it(\"TC-1.7: --resume lists cwd-scoped threads (title + created), resolves selection, empty-safe\", async () => {\n   133\t    const a1 = await makeThread({ cwd: \"/work/a\", title: \"alpha\" });\n   134\t    const a2 = await makeThread({ cwd: \"/work/a\", title: \"beta\" });\n   135\t    await makeThread({ cwd: \"/work/b\", title: \"other-cwd\" });\n   136\t\n   137\t    let offered: readonly ThreadChoice[] = [];\n   138\t    const picked = await pickThread(\"/work/a\", {\n   139\t      registryPath: store.registryPath,\n   140\t      select: (choices) => {\n   141\t        offered = choices;\n   142\t        return Promise.resolve(choices[0]!.threadId);\n   143\t      },\n   144\t    });\n   145\t    expect(picked.ok).toBe(true);\n   146\t\n   147\t    // Only the current cwd's threads are offered, each with title + creation time.\n   148\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\n   149\t    for (const choice of offered) {\n   150\t      expect(choice.createdAt).toBeTruthy();\n","exit_code":0,"status":"completed"}}

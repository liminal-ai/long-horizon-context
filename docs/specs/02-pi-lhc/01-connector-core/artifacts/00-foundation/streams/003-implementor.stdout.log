recordedGap: true };\n    state.health.startupValidation = { unreachable: [] };\n\n    const clone = structuredClone(state);\n    expect(clone).toEqual(state);\n    expect(clone).not.toBe(state);\n  });\n\n  it(\"exposes a stubbed init/dispose seam that returns a typed fail-closed result\", async () => {\n    const result = await initInstance({ filePath: \"/tmp/thread.sqlite\" }, { mode: \"background\" });\n    expect(result.ok).toBe(false);\n    if (!result.ok) {\n      expect(result.error.code).toBe(\"not_implemented\");\n      expect(result.error.errorClass).toBe(\"system_error\");\n    }\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015f3L6zocB6Ggb7Mr6aV49R","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Green-phase guard: Red-committed test files must be byte-identical to the\n3\t// hashes recorded in test/red-manifest.json. Green may add new test files but\n4\t// may not modify Red's. Record hashes with scripts/record-red-manifest.mjs.\n5\timport { createHash } from \"node:crypto\";\n6\timport { existsSync, readFileSync } from \"node:fs\";\n7\timport path from \"node:path\";\n8\timport { fileURLToPath } from \"node:url\";\n9\t\n10\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n11\tconst manifestPath = path.join(pkgRoot, \"test\", \"red-manifest.json\");\n12\t\n13\tif (!existsSync(manifestPath)) {\n14\t  console.log(\"test-immutability: no Red-phase manifest; nothing to check\");\n15\t  process.exit(0);\n16\t}\n17\t\n18\tconst manifest = JSON.parse(readFileSync(manifestPath, \"utf8\"));\n19\tconst entries = Object.entries(manifest.files ?? {});\n20\tif (entries.length === 0) {\n21\t  console.log(\"test-immutability: Red-phase manifest empty; nothing to check\");\n22\t  process.exit(0);\n23\t}\n24\t\n25\tconst failures = [];\n26\tfor (const [relPath, expectedHash] of entries) {\n27\t  const full = path.join(pkgRoot, relPath);\n28\t  if (!existsSync(full)) {\n29\t    failures.push(`${relPath}: Red-phase test file is missing`);\n30\t    continue;\n31\t  }\n32\t  const actual = createHash(\"sha256\").update(readFileSync(full)).digest(\"hex\");\n33\t  if (actual !== expectedHash) {\n34\t    failures.push(`${relPath}: modified since Red phase (hash mismatch)`);\n35\t  }\n36\t}\n37\t\n38\tif (failures.length > 0) {\n39\t  console.error(\"test-immutability FAILED:\");\n40\t  for (const f of failures) console.error(`  - ${f}`);\n41\t  process.exit(1);\n42\t}\n43\tconsole.log(`test-immutability: OK (${entries.length} Red-phase files unchanged)`);\n44\t"}]},"parent_tool_use_id":null,"session_id":"814546fe-4436-4e4f-8c69-071884ddc90c","uuid":"e9ef2bce-e592-405a-b61f-c0b2c4bc779c","timestamp":"2026-06-14T03:04:04.562Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/scripts/check-test-immutability.mjs","content":"#!/usr/bin/env node\n// Green-phase guard: Red-committed test files must be byte-identical to the\n// hashes recorded in test/red-manifest.json. Green may add new test files but\n// may not modify Red's. Record hashes with scripts/record-red-manifest.mjs.\nimport { createHash } from \"node:crypto\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst manifestPath = path.join(pkgRoot, \"test\", \"red-manifest.json\");\n\nif (!existsSync(manifestPath)) {\n  console.log(\"test-immutability: no Red-phase manifest; nothing to check\");\n  process.exit(0);\n}\n\nconst manifest = JSON.parse(readFileSync(manifestPath, \"utf8\"));\nconst entries = Object.entries(manifest.files ?? {});\nif (entries.length === 0) {\n  console.log(\"test-immutability: Red-phase manifest empty; nothing to check\");\n  process.exit(0);\n}\n\nconst failures = [];\nfor (const [relPath, expectedHash] of entries) {\n  const full = path.join(pkgRoot, relPath);\n  if (!existsSync(full)) {\n    failures.push(`${relPath}: Red-phase test file is missing`);\n    continue;\n  }\n  const actual = createHash(\"sha256\").update(readFileSync(full)).digest(\"hex\");\n  if (actual !== expectedHash) {\n    failures.push(`${relPath}: modified since Red phase (hash mismatch)`);\n  }\n}\n\nif (failures.length > 0) {\n  console.error(\"test-immutability FAILED:\");\n  for (const f of failures) console.error(`  - ${f}`);\n  process.exit(1);\n}\nconsole.log(`test-immutability: OK (${entries.length} Red-phase files unchanged)`);\n","numLines":44,"startLine":1,"totalLines":44}}}

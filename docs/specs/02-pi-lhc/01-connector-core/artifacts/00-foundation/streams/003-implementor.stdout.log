{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01KB7HZyeLAAmqKLuXcQatn1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015hNnRDaYzA6kF47xMiixnd","name":"Write","input":{"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.ts","content":"// Deterministic ModelCall fakes — the inference edge (tech design §Fixture\n// Contracts / Testing Strategy). These stand in for `ctx.modelRegistry` +\n// pi-ai `complete`, so the inference tests (Story 5) control completion text\n// and failure shapes without a live provider.\nimport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\n\n/** Always resolves to text. */\nexport function fakeModelCallText(text: string): ModelCall {\n  return () => Promise.resolve<ModelCallResult>({ ok: true, text });\n}\n\n/** Always resolves to a classified transport failure. */\nexport function fakeModelCallFailure(\n  kind: ModelCallFailureKind,\n  message = `injected ${kind}`,\n): ModelCall {\n  return () => Promise.resolve<ModelCallResult>({ ok: false, kind, message });\n}\n\n/** Routes each call by its `provider/model` key to a per-lane fake — the\n *  multi-lane substrate for AC-4.2. An unrouted key resolves to an\n *  `invalid_request` failure (never a silent success). */\nexport function fakeModelCallRouter(\n  routes: Record<string, ModelCall>,\n  fallback?: ModelCall,\n): ModelCall {\n  return (input) => {\n    const key = `${input.provider}/${input.model}`;\n    const route = routes[key] ?? fallback;\n    if (route === undefined) {\n      return Promise.resolve<ModelCallResult>({\n        ok: false,\n        kind: \"invalid_request\",\n        message: `no fake route for ${key}`,\n      });\n    }\n    return route(input);\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5992,"cache_read_input_tokens":243110,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5992},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"814546fe-4436-4e4f-8c69-071884ddc90c","uuid":"6fef9909-7ca6-4e8a-aff1-70adec37bcec","request_id":"req_011Cc2SmHeDd5SMsQ4cav5Fx"}

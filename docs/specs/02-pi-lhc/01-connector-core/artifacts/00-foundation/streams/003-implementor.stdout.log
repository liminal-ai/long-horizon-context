{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ULwoGsCH7TdcuGR3g8Y1fJ","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { runWithThreadTouchSuppressed } from \"../../shared/context.js\";\n3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n4\timport {\n5\t  createThreadFile,\n6\t  deleteThreadFile,\n7\t  generateThreadId,\n8\t  openThreadDatabase,\n9\t} from \"./internal/create.js\";\n10\t\n11\t// Re-exported for the other domain surfaces: opening a thread file through\n12\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n13\t// file gains the message tables here before any write or read touches them).\n14\texport { openThreadDatabase };\n15\timport {\n16\t  insertThreadRow,\n17\t  openRegistryForRead,\n18\t  openRegistryForWrite,\n19\t  resolveRegistryPath,\n20\t  selectAllThreadRows,\n21\t  selectThreadRow,\n22\t  type RegistryRow,\n23\t} from \"./internal/registry.js\";\n24\t\n25\texport type ThreadRef =\n26\t  | { threadId: string; registryPath?: string }\n27\t  | { filePath: string };\n28\t\n29\texport interface NewThreadInput {\n30\t  filePath: string;\n31\t  title?: string;\n32\t  registryPath?: string;\n33\t}\n34\t\n35\texport interface ThreadInfo {\n36\t  threadId: string;\n37\t  filePath: string;\n38\t  title?: string;\n39\t  createdAt: string; // ISO-8601\n40\t}\n41\t\n42\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n43\t  const info: ThreadInfo = {\n44\t    threadId: row.threadId,\n45\t    filePath: row.filePath,\n46\t    createdAt: row.createdAt,\n47\t  };\n48\t  if (row.title !== undefined) info.title = row.title;\n49\t  return info;\n50\t}\n51\t\n52\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n53\t  return {\n54\t    ok: false,\n55\t    error: {\n56\t      errorClass: \"caller_error\",\n57\t      code: \"thread_not_found\",\n58\t      reason: `no thread registered with id ${threadId}`,\n59\t    },\n60\t  };\n61\t}\n62\t\n63\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n64\t  return {\n65\t    ok: false,\n66\t    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n67\t  };\n68\t}\n69\t\n70\t// A file path that is empty or whitespace-only cannot name a durable file:\n71\t// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n72\t// close, so such a path must be refused as a caller error before any storage\n73\t// is touched rather than silently producing a thread with no durable file.\n74\tfunction isBlankPath(filePath: string): boolean {\n75\t  return filePath.trim() === \"\";\n76\t}\n77\t\n78\tfunction detail(cause: unknown): string {\n79\t  return cause instanceof Error ? cause.message : String(cause);\n80\t}\n81\t\n82\t// Creation spans two databases that cannot share a transaction. Order is\n83\t// file-then-row with compensation: the invariant \"no registry row without\n84\t// its file\" is absolute; an orphan file from a crash between the writes is\n85\t// documented harmless (design decision 2).\n86\texport async function newThread(\n87\t  input: NewThreadInput,\n88\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n89\t  // Guard before any storage touch: an empty/blank path would otherwise open\n90\t  // a temp database and register a thread with no durable file (the no-row-\n91\t  // without-file invariant below depends on the path naming a real file).\n92\t  if (isBlankPath(input.filePath)) {\n93\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n94\t  }\n95\t  if (existsSync(input.filePath)) {\n96\t    return {\n97\t      ok: false,\n98\t      error: {\n99\t        errorClass: \"caller_error\",\n100\t        code: \"path_exists\",\n101\t        reason: `a file already exists at ${input.filePath}`,\n102\t      },\n103\t    };\n104\t  }\n105\t\n106\t  const threadId = generateThreadId();\n107\t  const createdAt = new Date().toISOString();\n108\t\n109\t  try {\n110\t    createThreadFile(input.filePath, threadId, createdAt);\n111\t  } catch (cause) {\n112\t    deleteThreadFile(input.filePath);\n113\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n114\t  }\n115\t\n116\t  let registry;\n117\t  try {\n118\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n119\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n120\t    if (input.title !== undefined) row.title = input.title;\n121\t    insertThreadRow(registry, row);\n122\t  } catch (cause) {\n123\t    deleteThreadFile(input.filePath);\n124\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n125\t  } finally {\n126\t    registry?.close();\n127\t  }\n128\t\n129\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n130\t}\n131\t\n132\texport async function resolve(input: {\n133\t  threadId: string;\n134\t  registryPath?: string;\n135\t}): Promise<OpResult<ThreadInfo>> {\n136\t  let registry;\n137\t  try {\n138\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n139\t    if (registry === null) return threadNotFound(input.threadId);\n140\t    const row = selectThreadRow(registry, input.threadId);\n141\t    if (row === undefined) return threadNotFound(input.threadId);\n142\t    return { ok: true, value: toThreadInfo(row) };\n143\t  } catch (cause) {\n144\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n145\t  } finally {\n146\t    registry?.close();\n147\t  }\n148\t}\n149\t\n150\texport async function listThreads(input?: {\n151\t  registryPath?: string;\n152\t}): Promise<OpResult<ThreadInfo[]>> {\n153\t  let registry;\n154\t  try {\n155\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n156\t    if (registry === null) return { ok: true, value: [] };\n157\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n158\t  } catch (cause) {\n159\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n160\t  } finally {\n161\t    registry?.close();\n162\t  }\n163\t}\n164\t\n165\t// The thread file's own identity header (Epic 04): thread_metadata is this\n166\t// domain's table — creation writes it (internal/create.ts) and only this\n167\t// surface reads it back. Added for inspect's overview, which must report\n168\t// thread identity for ANY resolvable ref — including a { filePath } ref that\n169\t// no registry knows — without reading tables itself (inspect's must-not-own\n170\t// rule). A pure read: the whole operation runs touch-suppressed (DD-6), so a\n171\t// background SDK can never hang a first-touch catch-up drain off it.\n172\texport interface ThreadFileInfo {\n173\t  threadId: string;\n174\t  createdAt: string;\n175\t}"}]},"parent_tool_use_id":null,"session_id":"814546fe-4436-4e4f-8c69-071884ddc90c","uuid":"1c47f9fa-52a1-4ea1-a387-5f26ec484117","timestamp":"2026-06-14T03:08:01.800Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { runWithThreadTouchSuppressed } from \"../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  createThreadFile,\n  deleteThreadFile,\n  generateThreadId,\n  openThreadDatabase,\n} from \"./internal/create.js\";\n\n// Re-exported for the other domain surfaces: opening a thread file through\n// the threads domain is what guarantees its schema is current (a pre-Story-3\n// file gains the message tables here before any write or read touches them).\nexport { openThreadDatabase };\nimport {\n  insertThreadRow,\n  openRegistryForRead,\n  openRegistryForWrite,\n  resolveRegistryPath,\n  selectAllThreadRows,\n  selectThreadRow,\n  type RegistryRow,\n} from \"./internal/registry.js\";\n\nexport type ThreadRef =\n  | { threadId: string; registryPath?: string }\n  | { filePath: string };\n\nexport interface NewThreadInput {\n  filePath: string;\n  title?: string;\n  registryPath?: string;\n}\n\nexport interface ThreadInfo {\n  threadId: string;\n  filePath: string;\n  title?: string;\n  createdAt: string; // ISO-8601\n}\n\nfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n  const info: ThreadInfo = {\n    threadId: row.threadId,\n    filePath: row.filePath,\n    createdAt: row.createdAt,\n  };\n  if (row.title !== undefined) info.title = row.title;\n  return info;\n}\n\nfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread registered with id ${threadId}`,\n    },\n  };\n}\n\nfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n  };\n}\n\n// A file path that is empty or whitespace-only cannot name a durable file:\n// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n// close, so such a path must be refused as a caller error before any storage\n// is touched rather than silently producing a thread with no durable file.\nfunction isBlankPath(filePath: string): boolean {\n  return filePath.trim() === \"\";\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Creation spans two databases that cannot share a transaction. Order is\n// file-then-row with compensation: the invariant \"no registry row without\n// its file\" is absolute; an orphan file from a crash between the writes is\n// documented harmless (design decision 2).\nexport async function newThread(\n  input: NewThreadInput,\n): Promise<OpResult<{ threadId: string; filePath: string }>> {\n  // Guard before any storage touch: an empty/blank path would otherwise open\n  // a temp database and register a thread with no durable file (the no-row-\n  // without-file invariant below depends on the path naming a real file).\n  if (isBlankPath(input.filePath)) {\n    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n  }\n  if (existsSync(input.filePath)) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"path_exists\",\n        reason: `a file already exists at ${input.filePath}`,\n      },\n    };\n  }\n\n  const threadId = generateThreadId();\n  const createdAt = new Date().toISOString();\n\n  try {\n    createThreadFile(input.filePath, threadId, createdAt);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n  }\n\n  let registry;\n  try {\n    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n    if (input.title !== undefined) row.title = input.title;\n    insertThreadRow(registry, row);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`registry insert failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n\n  return { ok: true, value: { threadId, filePath: input.filePath } };\n}\n\nexport async function resolve(input: {\n  threadId: string;\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n    if (registry === null) return threadNotFound(input.threadId);\n    const row = selectThreadRow(registry, input.threadId);\n    if (row === undefined) return threadNotFound(input.threadId);\n    return { ok: true, value: toThreadInfo(row) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\nexport async function listThreads(input?: {\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo[]>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n    if (registry === null) return { ok: true, value: [] };\n    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\n// The thread file's own identity header (Epic 04): thread_metadata is this\n// domain's table — creation writes it (internal/create.ts) and only this\n// surface reads it back. Added for inspect's overview, which must report\n// thread identity for ANY resolvable ref — including a { filePath } ref that\n// no registry knows — without reading tables itself (inspect's must-not-own\n// rule). A pure read: the whole operation runs touch-suppressed (DD-6), so a\n// background SDK can never hang a first-touch catch-up drain off it.\nexport interface ThreadFileInfo {\n  threadId: string;\n  createdAt: string;\n}","numLines":175,"startLine":1,"totalLines":233}}}

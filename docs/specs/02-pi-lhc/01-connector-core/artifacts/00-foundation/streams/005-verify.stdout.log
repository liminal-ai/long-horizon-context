{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/smoke/extension-load.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { activate, createConnector, disposeInstance, EPIC_1_HOOKS, initInstance } from \"../../src/index.js\";\n     3\timport { createSessionState } from \"../../src/lifecycle/state.js\";\n     4\timport type { ExtensionAPI, ExtensionContext, PiHookName } from \"../../src/pi/types.js\";\n     5\timport { makeAgentEnd, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n     6\t\n     7\t// A fake ExtensionAPI that records what the extension registers.\n     8\tfunction recordingPi(): {\n     9\t  pi: ExtensionAPI;\n    10\t  registered: PiHookName[];\n    11\t  commands: string[];\n    12\t  tools: string[];\n    13\t} {\n    14\t  const registered: PiHookName[] = [];\n    15\t  const commands: string[] = [];\n    16\t  const tools: string[] = [];\n    17\t  const pi: ExtensionAPI = {\n    18\t    registerHook(name) {\n    19\t      registered.push(name);\n    20\t    },\n    21\t    registerCommand(name) {\n    22\t      commands.push(name);\n    23\t    },\n    24\t    registerTool(tool) {\n    25\t      tools.push(tool.name);\n    26\t    },\n    27\t    appendEntry() {},\n    28\t  };\n    29\t  return { pi, registered, commands, tools };\n    30\t}\n    31\t\n    32\t// A synthetic per-hook ctx carrying METHODS (not plain data) and a unique\n    33\t// marker — so a retained ctx would break the structuredClone plain-data guard.\n    34\tfunction syntheticCtx(marker: string): ExtensionContext {\n    35\t  return {\n    36\t    cwd: `/tmp/${marker}`,\n    37\t    hasUI: false,\n    38\t    modelRegistry: {\n    39\t      find: () => undefined,\n    40\t      hasConfiguredAuth: () => false,\n    41\t      getAvailable: () => [],\n    42\t    },\n    43\t    ui: { notify: () => {} },\n    44\t    sessionManager: { getEntries: () => [] },\n    45\t  };\n    46\t}\n    47\t\n    48\tdescribe(\"extension load + hook rail\", () => {\n    49\t  it(\"registers exactly the Epic 1 observe-only hook rail and not the context hook\", () => {\n    50\t    const { pi, registered, commands, tools } = recordingPi();\n    51\t    activate(pi);\n    52\t\n    53\t    expect(new Set(registered)).toEqual(new Set(EPIC_1_HOOKS));\n    54\t    expect(registered).toHaveLength(9);\n    55\t    expect(registered).not.toContain(\"context\"); // context serving is Epic 2\n    56\t    // observe-only: no operator commands / agent tools registered yet (Epic 3)\n    57\t    expect(commands).toEqual([]);\n    58\t    expect(tools).toEqual([]);\n    59\t  });\n    60\t\n    61\t  it(\"routes every hook to a guarded handler that never throws into PI and retains only plain data\", async () => {\n    62\t    const connector = createConnector();\n    63\t    // fire several hooks with DISTINCT ctx objects carrying methods\n    64\t    await connector.handlers.session_start(syntheticCtx(\"ctx-1\"), makeSessionStart(\"startup\"));\n    65\t    await connector.handlers.message_end(syntheticCtx(\"ctx-2\"), makeMessageEnd(makeUserMessage(\"hi\")));\n    66\t    await connector.handlers.agent_end(syntheticCtx(\"ctx-3\"), makeAgentEnd([]));\n    67\t\n    68\t    // (the awaits above completing is the \"never throws into PI\" assertion)\n    69\t    // retained state is plain data: structuredClone throws on a stored PI ctx (it has methods)\n    70\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    71\t  });\n    72\t\n    73\t  it(\"keeps SessionState plain-data-only — it survives structuredClone with every field populated\", () => {\n    74\t    const state = createSessionState({ filePath: \"/tmp/thread.sqlite\" });\n    75\t    state.flags.startupValidationReported = true;\n    76\t    state.flags.toldUserAboutGap = true; // open index signature, still plain data\n    77\t    state.health.lastCaptureFailure = { code: \"malformed_event\", message: \"bad shape\", recordedGap: true };\n    78\t    state.health.startupValidation = { unreachable: [] };\n    79\t\n    80\t    const clone = structuredClone(state);\n    81\t    expect(clone).toEqual(state);\n    82\t    expect(clone).not.toBe(state);\n    83\t  });\n    84\t\n    85\t  it(\"exposes a stubbed init/dispose seam that returns a typed fail-closed result\", async () => {\n    86\t    const initResult = await initInstance({ filePath: \"/tmp/thread.sqlite\" }, { mode: \"background\" });\n    87\t    expect(initResult.ok).toBe(false);\n    88\t    if (!initResult.ok) {\n    89\t      expect(initResult.error).toEqual({\n    90\t        errorClass: \"system_error\",\n    91\t        code: \"not_implemented\",\n    92\t        reason: \"lifecycle.initInstance is not implemented yet (Epic 1 foundation stub)\",\n    93\t      });\n    94\t    }\n    95\t\n    96\t    const disposeResult = await disposeInstance(null);\n    97\t    expect(disposeResult.ok).toBe(false);\n    98\t    if (!disposeResult.ok) {\n    99\t      expect(disposeResult.error).toEqual({\n   100\t        errorClass: \"system_error\",\n   101\t        code: \"not_implemented\",\n   102\t        reason: \"lifecycle.disposeInstance is not implemented yet (Epic 1 foundation stub)\",\n   103\t      });\n   104\t    }\n   105\t  });\n   106\t});\n","exit_code":0,"status":"completed"}}

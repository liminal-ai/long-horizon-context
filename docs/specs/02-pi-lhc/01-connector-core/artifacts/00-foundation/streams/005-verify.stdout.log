{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/index.ts'","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. It owns no state beyond the plain-data `SessionState` (and, later, an\n     4\t// `LhcInstance`) held in the connector closure — never a PI `ctx`/session\n     5\t// object (tech design Flow 1, plain-data rule).\n     6\timport type {\n     7\t  ExtensionAPI,\n     8\t  PiHookHandler,\n     9\t  PiHookName,\n    10\t} from \"./pi/types.js\";\n    11\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    12\t\n    13\texport { disposeInstance, initInstance, initLhc } from \"./lifecycle/instance.js\";\n    14\texport type { LhcInstance } from \"./shared/instance.js\";\n    15\t\n    16\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    17\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    18\t *  registers no handler for it (story Scope Out). */\n    19\texport const EPIC_1_HOOKS = [\n    20\t  \"session_start\",\n    21\t  \"message_end\",\n    22\t  \"turn_end\",\n    23\t  \"agent_end\",\n    24\t  \"model_select\",\n    25\t  \"thinking_level_select\",\n    26\t  \"session_before_fork\",\n    27\t  \"session_before_switch\",\n    28\t  \"session_shutdown\",\n    29\t] as const satisfies readonly PiHookName[];\n    30\t\n    31\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    32\t\n    33\t/** Everything the connector retains across hooks — all plain data, by\n    34\t *  construction structuredClone-able. There is no field that could hold a PI\n    35\t *  object. */\n    36\texport interface ConnectorSnapshot {\n    37\t  state: SessionState | null;\n    38\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    39\t}\n    40\t\n    41\texport interface Connector {\n    42\t  /** Register the observe-only hook rail on the PI extension API. */\n    43\t  register(pi: ExtensionAPI): void;\n    44\t  /** The plain-data state retained across hooks. `null` until a session\n    45\t   *  resolves a thread (Story 1); never holds a PI ctx. */\n    46\t  getState(): SessionState | null;\n    47\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n    48\t  snapshot(): ConnectorSnapshot;\n    49\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n    50\t   *  synthetic ctx/events without a live PI. Each accepts any Epic 1 event\n    51\t   *  (the foundation handlers are uniform no-ops). */\n    52\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n    53\t}\n    54\t\n    55\t/** Build a connector instance. Its mutable state lives in this closure; the\n    56\t *  registered handlers capture it, so the instance stays live for the session\n    57\t *  even when `activate` discards the returned object. */\n    58\texport function createConnector(): Connector {\n    59\t  // The connector's ENTIRE retained state. Both are plain data and are the only\n    60\t  // things that survive between hooks. `state` stays null in Epic 1 Story 0\n    61\t  // (thread resolution is fail-closed until Story 1); Story 1 populates it via\n    62\t  // createSessionState once a thread resolves.\n    63\t  let state: SessionState | null = null;\n    64\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n    65\t\n    66\t  // Contain every handler: an observe-only hook must never throw back into PI\n    67\t  // (a thrown hook breaks the user's session). A caught error becomes a\n    68\t  // plain-data diagnostic; it is never rethrown.\n    69\t  const guard = (\n    70\t    name: Epic1Hook,\n    71\t    body: PiHookHandler<Epic1Hook>,\n    72\t  ): PiHookHandler<Epic1Hook> => {\n    73\t    return async (ctx, event): Promise<void> => {\n    74\t      try {\n    75\t        await body(ctx, event);\n    76\t      } catch (err) {\n    77\t        lastDiagnostic = {\n    78\t          code: \"hook_handler_error\",\n    79\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n    80\t          recordedGap: false,\n    81\t        };\n    82\t      }\n    83\t    };\n    84\t  };\n    85\t\n    86\t  // Observe-only foundation: every hook routes to a no-op that receives a FRESH\n    87\t  // ctx and retains none of it.\n    88\t  const noop: PiHookHandler<Epic1Hook> = () => {\n    89\t    // Intentionally empty — later stories replace this with real routing.\n    90\t  };\n    91\t\n    92\t  // Story 0 routes each hook to a fail-closed no-op: the rail is real and routes\n    93\t  // to a handler, but no capture / resolution / derivation happens or is faked\n    94\t  // yet. The accumulator is filled for every hook in the loop below.\n    95\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n    96\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, noop);\n    97\t\n    98\t  return {\n    99\t    handlers,\n   100\t    register(pi: ExtensionAPI): void {\n   101\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n   102\t    },\n   103\t    getState(): SessionState | null {\n   104\t      return state;\n   105\t    },\n   106\t    snapshot(): ConnectorSnapshot {\n   107\t      return { state, lastDiagnostic };\n   108\t    },\n   109\t  };\n   110\t}\n   111\t\n   112\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   113\t *  loads (and again on `/reload`). Registers the observe-only hook rail. */\n   114\texport function activate(pi: ExtensionAPI): void {\n   115\t  createConnector().register(pi);\n   116\t}\n   117\t\n   118\texport default activate;\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/model-call.ts'","aggregated_output":"     1\t// Deterministic ModelCall fakes — the inference edge (tech design §Fixture\n     2\t// Contracts / Testing Strategy). These stand in for `ctx.modelRegistry` +\n     3\t// pi-ai `complete`, so the inference tests (Story 5) control completion text\n     4\t// and failure shapes without a live provider.\n     5\timport type { ModelCall, ModelCallFailureKind, ModelCallResult } from \"lhc\";\n     6\t\n     7\t/** Always resolves to text. */\n     8\texport function fakeModelCallText(text: string): ModelCall {\n     9\t  return () => Promise.resolve<ModelCallResult>({ ok: true, text });\n    10\t}\n    11\t\n    12\t/** Always resolves to a classified transport failure. */\n    13\texport function fakeModelCallFailure(\n    14\t  kind: ModelCallFailureKind,\n    15\t  message = `injected ${kind}`,\n    16\t): ModelCall {\n    17\t  return () => Promise.resolve<ModelCallResult>({ ok: false, kind, message });\n    18\t}\n    19\t\n    20\t/** Routes each call by its `provider/model` key to a per-lane fake — the\n    21\t *  multi-lane substrate for AC-4.2. An unrouted key resolves to an\n    22\t *  `invalid_request` failure (never a silent success). */\n    23\texport function fakeModelCallRouter(\n    24\t  routes: Record<string, ModelCall>,\n    25\t  fallback?: ModelCall,\n    26\t): ModelCall {\n    27\t  return (input) => {\n    28\t    const key = `${input.provider}/${input.model}`;\n    29\t    const route = routes[key] ?? fallback;\n    30\t    if (route === undefined) {\n    31\t      return Promise.resolve<ModelCallResult>({\n    32\t        ok: false,\n    33\t        kind: \"invalid_request\",\n    34\t        message: `no fake route for ${key}`,\n    35\t      });\n    36\t    }\n    37\t    return route(input);\n    38\t  };\n    39\t}\n","exit_code":0,"status":"completed"}}

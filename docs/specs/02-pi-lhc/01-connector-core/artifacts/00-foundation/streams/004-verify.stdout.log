{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/thread.test.ts'","aggregated_output":"     1\timport { afterEach, describe, expect, it } from \"vitest\";\n     2\timport { threads } from \"lhc\";\n     3\timport { makeTempThread, tempStore, type TempStore } from \"./thread.js\";\n     4\t\n     5\t// The temp-thread factory drives REAL lhc threads against a real temp SQLite\n     6\t// file — the persistence/reattach substrate every lifecycle and verification\n     7\t// test stands on (tech design §Testing Strategy). Proven here by creating a\n     8\t// thread and reopening it after the fact, both from the registry and the file.\n     9\tdescribe(\"temp-thread factory\", () => {\n    10\t  let store: TempStore | undefined;\n    11\t  afterEach(() => {\n    12\t    store?.cleanup();\n    13\t    store = undefined;\n    14\t  });\n    15\t\n    16\t  it(\"creates a real SQLite thread and reopens it from the registry and the file\", async () => {\n    17\t    store = tempStore();\n    18\t    const { threadId, filePath } = await makeTempThread(store, { title: \"foundation smoke\" });\n    19\t    expect(threadId).toBeTruthy();\n    20\t\n    21\t    // reopen via the registry (resolve by id)\n    22\t    const resolved = await threads.resolve({ threadId, registryPath: store.registryPath });\n    23\t    expect(resolved.ok).toBe(true);\n    24\t    if (resolved.ok) {\n    25\t      expect(resolved.value.threadId).toBe(threadId);\n    26\t      expect(resolved.value.title).toBe(\"foundation smoke\");\n    27\t    }\n    28\t\n    29\t    // reopen via the thread file's own identity header (info by file path)\n    30\t    const info = await threads.info({ filePath });\n    31\t    expect(info.ok).toBe(true);\n    32\t    if (info.ok) expect(info.value.threadId).toBe(threadId);\n    33\t  });\n    34\t\n    35\t  it(\"isolates each created thread under its own temp store\", async () => {\n    36\t    store = tempStore();\n    37\t    const a = await makeTempThread(store);\n    38\t    const b = await makeTempThread(store);\n    39\t    expect(a.threadId).not.toBe(b.threadId);\n    40\t    expect(a.filePath).not.toBe(b.filePath);\n    41\t  });\n    42\t});\n","exit_code":0,"status":"completed"}}

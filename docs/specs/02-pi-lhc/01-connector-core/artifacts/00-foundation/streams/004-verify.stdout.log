{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/smoke/verification-config.test.ts'","aggregated_output":"     1\timport { existsSync, readFileSync } from \"node:fs\";\n     2\timport { dirname, join } from \"node:path\";\n     3\timport { fileURLToPath } from \"node:url\";\n     4\timport { describe, expect, it } from \"vitest\";\n     5\t\n     6\tconst pkgRoot = join(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n     7\t\n     8\tinterface PackageJson {\n     9\t  scripts?: Record<string, string>;\n    10\t  dependencies?: Record<string, string>;\n    11\t}\n    12\t\n    13\tfunction readPackageJson(): PackageJson {\n    14\t  return JSON.parse(readFileSync(join(pkgRoot, \"package.json\"), \"utf8\")) as PackageJson;\n    15\t}\n    16\t\n    17\t// Foundation invariant (test-plan Chunk 0): the package's verification tiers and\n    18\t// their script files exist and run, so every later chunk can exit on its gate.\n    19\tdescribe(\"package verification config\", () => {\n    20\t  it(\"declares every verification-tier script the gates depend on\", () => {\n    21\t    const pkg = readPackageJson();\n    22\t    for (const script of [\n    23\t      \"build\",\n    24\t      \"typecheck\",\n    25\t      \"lint\",\n    26\t      \"boundaries\",\n    27\t      \"test\",\n    28\t      \"red-verify\",\n    29\t      \"verify\",\n    30\t      \"green-verify\",\n    31\t      \"verify-all\",\n    32\t    ]) {\n    33\t      expect(typeof pkg.scripts?.[script]).toBe(\"string\");\n    34\t    }\n    35\t  });\n    36\t\n    37\t  it(\"composes the tiers the way the tech design specifies\", () => {\n    38\t    const pkg = readPackageJson();\n    39\t    const scripts = pkg.scripts ?? {};\n    40\t    // red-verify = build + typecheck + lint + boundaries (no behavior tests)\n    41\t    expect(scripts[\"red-verify\"]).toContain(\"build\");\n    42\t    expect(scripts[\"red-verify\"]).toContain(\"boundaries\");\n    43\t    // verify (the story gate) is red-verify + the test run\n    44\t    expect(scripts[\"verify\"]).toContain(\"red-verify\");\n    45\t    expect(scripts[\"verify\"]).toContain(\"vitest run\");\n    46\t    // green-verify adds the test-immutability guard; verify-all == verify (no e2e yet)\n    47\t    expect(scripts[\"green-verify\"]).toContain(\"check-test-immutability\");\n    48\t    expect(scripts[\"verify-all\"]).toContain(\"verify\");\n    49\t  });\n    50\t\n    51\t  it(\"ships the gate script files package.json references\", () => {\n    52\t    for (const script of [\n    53\t      \"lint.mjs\",\n    54\t      \"check-boundaries.mjs\",\n    55\t      \"check-test-immutability.mjs\",\n    56\t      \"record-red-manifest.mjs\",\n    57\t    ]) {\n    58\t      expect(existsSync(join(pkgRoot, \"scripts\", script))).toBe(true);\n    59\t    }\n    60\t  });\n    61\t\n    62\t  it(\"depends on the lhc workspace package\", () => {\n    63\t    const pkg = readPackageJson();\n    64\t    expect(pkg.dependencies?.lhc).toBeDefined();\n    65\t  });\n    66\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/smoke/extension-load.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { activate, createConnector, EPIC_1_HOOKS } from \"../../src/index.js\";\n     3\timport { createSessionState } from \"../../src/lifecycle/state.js\";\n     4\timport { initInstance } from \"../../src/lifecycle/instance.js\";\n     5\timport type { ExtensionAPI, ExtensionContext, PiHookName } from \"../../src/pi/types.js\";\n     6\timport { makeAgentEnd, makeMessageEnd, makeSessionStart, makeUserMessage } from \"../fixtures/synthetic.js\";\n     7\t\n     8\t// A fake ExtensionAPI that records what the extension registers.\n     9\tfunction recordingPi(): {\n    10\t  pi: ExtensionAPI;\n    11\t  registered: PiHookName[];\n    12\t  commands: string[];\n    13\t  tools: string[];\n    14\t} {\n    15\t  const registered: PiHookName[] = [];\n    16\t  const commands: string[] = [];\n    17\t  const tools: string[] = [];\n    18\t  const pi: ExtensionAPI = {\n    19\t    registerHook(name) {\n    20\t      registered.push(name);\n    21\t    },\n    22\t    registerCommand(name) {\n    23\t      commands.push(name);\n    24\t    },\n    25\t    registerTool(tool) {\n    26\t      tools.push(tool.name);\n    27\t    },\n    28\t    appendEntry() {},\n    29\t  };\n    30\t  return { pi, registered, commands, tools };\n    31\t}\n    32\t\n    33\t// A synthetic per-hook ctx carrying METHODS (not plain data) and a unique\n    34\t// marker — so a retained ctx would break the structuredClone plain-data guard.\n    35\tfunction syntheticCtx(marker: string): ExtensionContext {\n    36\t  return {\n    37\t    cwd: `/tmp/${marker}`,\n    38\t    hasUI: false,\n    39\t    modelRegistry: {\n    40\t      find: () => undefined,\n    41\t      hasConfiguredAuth: () => false,\n    42\t      getAvailable: () => [],\n    43\t    },\n    44\t    ui: { notify: () => {} },\n    45\t    sessionManager: { getEntries: () => [] },\n    46\t  };\n    47\t}\n    48\t\n    49\tdescribe(\"extension load + hook rail\", () => {\n    50\t  it(\"registers exactly the Epic 1 observe-only hook rail and not the context hook\", () => {\n    51\t    const { pi, registered, commands, tools } = recordingPi();\n    52\t    activate(pi);\n    53\t\n    54\t    expect(new Set(registered)).toEqual(new Set(EPIC_1_HOOKS));\n    55\t    expect(registered).toHaveLength(9);\n    56\t    expect(registered).not.toContain(\"context\"); // context serving is Epic 2\n    57\t    // observe-only: no operator commands / agent tools registered yet (Epic 3)\n    58\t    expect(commands).toEqual([]);\n    59\t    expect(tools).toEqual([]);\n    60\t  });\n    61\t\n    62\t  it(\"routes every hook to a guarded handler that never throws into PI and retains only plain data\", async () => {\n    63\t    const connector = createConnector();\n    64\t    // fire several hooks with DISTINCT ctx objects carrying methods\n    65\t    await connector.handlers.session_start(syntheticCtx(\"ctx-1\"), makeSessionStart(\"startup\"));\n    66\t    await connector.handlers.message_end(syntheticCtx(\"ctx-2\"), makeMessageEnd(makeUserMessage(\"hi\")));\n    67\t    await connector.handlers.agent_end(syntheticCtx(\"ctx-3\"), makeAgentEnd([]));\n    68\t\n    69\t    // (the awaits above completing is the \"never throws into PI\" assertion)\n    70\t    // retained state is plain data: structuredClone throws on a stored PI ctx (it has methods)\n    71\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    72\t  });\n    73\t\n    74\t  it(\"keeps SessionState plain-data-only — it survives structuredClone with every field populated\", () => {\n    75\t    const state = createSessionState({ filePath: \"/tmp/thread.sqlite\" });\n    76\t    state.flags.startupValidationReported = true;\n    77\t    state.flags.toldUserAboutGap = true; // open index signature, still plain data\n    78\t    state.health.lastCaptureFailure = { code: \"malformed_event\", message: \"bad shape\", recordedGap: true };\n    79\t    state.health.startupValidation = { unreachable: [] };\n    80\t\n    81\t    const clone = structuredClone(state);\n    82\t    expect(clone).toEqual(state);\n    83\t    expect(clone).not.toBe(state);\n    84\t  });\n    85\t\n    86\t  it(\"exposes a stubbed init/dispose seam that returns a typed fail-closed result\", async () => {\n    87\t    const result = await initInstance({ filePath: \"/tmp/thread.sqlite\" }, { mode: \"background\" });\n    88\t    expect(result.ok).toBe(false);\n    89\t    if (!result.ok) {\n    90\t      expect(result.error.code).toBe(\"not_implemented\");\n    91\t      expect(result.error.errorClass).toBe(\"system_error\");\n    92\t    }\n    93\t  });\n    94\t});\n","exit_code":0,"status":"completed"}}

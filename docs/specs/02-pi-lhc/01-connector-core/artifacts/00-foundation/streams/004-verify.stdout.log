{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/capture/converter.ts'","aggregated_output":"     1\timport type { BatchResult, MessageEventInput, OpResult } from \"lhc\";\n     2\timport type { LhcInstance } from \"../shared/instance.js\";\n     3\timport { notImplemented } from \"../shared/not-implemented.js\";\n     4\t\n     5\t// AC-2.1, AC-2.7: orchestrate map → accumulate → batch flush through\n     6\t// `intakeStream.messageEvents`, isolating capture failure so a writable-thread\n     7\t// failure becomes a recorded gap and a store-unavailable failure becomes an\n     8\t// extension health signal — never a thrown exception into a PI hook. Story 2.\n     9\t\n    10\t/** Fail-closed until Story 2. */\n    11\texport function capture(\n    12\t  events: MessageEventInput[],\n    13\t  instance: LhcInstance,\n    14\t): Promise<OpResult<BatchResult>> {\n    15\t  return Promise.resolve(notImplemented<BatchResult>(\"capture.capture\"));\n    16\t}\n","exit_code":0,"status":"completed"}}

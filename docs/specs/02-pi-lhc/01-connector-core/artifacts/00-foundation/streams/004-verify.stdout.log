{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/corpus.ts'","aggregated_output":"     1\t// Recorded-corpus loader (tech design §Fixture Contracts). Each corpus is a\n     2\t// named lifecycle paired with the LHC intake events it should produce. Until M0\n     3\t// delivers real recordings, the loaders build synthetic stand-ins; the\n     4\t// machinery (load → validate shape → compare on replay in Story 3) is real and\n     5\t// widens as corpora arrive. The validator PARSES and CHECKS shapes — it never\n     6\t// hardcodes a passing count (story §Anti-Shim Requirements).\n     7\timport type { EventKind } from \"lhc\";\n     8\timport type { Corpus } from \"../../src/verify/replay.js\";\n     9\timport {\n    10\t  makeAssistantMessage,\n    11\t  makeToolResult,\n    12\t  makeUserMessage,\n    13\t  validEvent,\n    14\t} from \"./synthetic.js\";\n    15\t\n    16\tconst CALL_A = \"call_a|fc_1\";\n    17\tconst CALL_B = \"call_b|fc_2\";\n    18\t\n    19\t/** Plain user/assistant text exchanges, no tools. */\n    20\texport function loadChattyCorpus(): Corpus {\n    21\t  return {\n    22\t    name: \"chatty\",\n    23\t    source: [\n    24\t      makeUserMessage(\"what does this repo do?\"),\n    25\t      makeAssistantMessage({ text: \"it is the LHC SDK\" }),\n    26\t      makeUserMessage(\"and the connector?\"),\n    27\t      makeAssistantMessage({ text: \"it wires PI to LHC\" }),\n    28\t    ],\n    29\t    expected: [\n    30\t      validEvent(\"user_prompt\", { payload: { text: \"what does this repo do?\" } }),\n    31\t      validEvent(\"assistant_text\", { payload: { text: \"it is the LHC SDK\" } }),\n    32\t      validEvent(\"turn_end\"),\n    33\t      validEvent(\"user_prompt\", { payload: { text: \"and the connector?\" } }),\n    34\t      validEvent(\"assistant_text\", { payload: { text: \"it wires PI to LHC\" } }),\n    35\t      validEvent(\"turn_end\"),\n    36\t    ],\n    37\t  };\n    38\t}\n    39\t\n    40\t/** One turn with a single tool run: thinking → call → result → answer. */\n    41\texport function loadToolHeavyCorpus(): Corpus {\n    42\t  return {\n    43\t    name: \"tool-heavy\",\n    44\t    source: [\n    45\t      makeUserMessage(\"read notes.txt\"),\n    46\t      makeAssistantMessage({\n    47\t        thinking: \"I should open the file\",\n    48\t        toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"notes.txt\" } }],\n    49\t      }),\n    50\t      makeToolResult({ id: CALL_A, content: \"contents of notes.txt\" }),\n    51\t      makeAssistantMessage({ text: \"the file says hello\" }),\n    52\t    ],\n    53\t    expected: [\n    54\t      validEvent(\"user_prompt\", { payload: { text: \"read notes.txt\" } }),\n    55\t      validEvent(\"assistant_thinking\", { payload: { text: \"I should open the file\" } }),\n    56\t      validEvent(\"tool_call\", {\n    57\t        payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    58\t      }),\n    59\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"contents of notes.txt\", isError: false } }),\n    60\t      validEvent(\"assistant_text\", { payload: { text: \"the file says hello\" } }),\n    61\t      validEvent(\"turn_end\"),\n    62\t    ],\n    63\t  };\n    64\t}\n    65\t\n    66\t/** Two parallel tool calls whose results complete out of order; correlation is\n    67\t *  by id, not arrival order (AC-2.3). */\n    68\texport function loadParallelToolCorpus(): Corpus {\n    69\t  return {\n    70\t    name: \"parallel-tool\",\n    71\t    source: [\n    72\t      makeUserMessage(\"read both files\"),\n    73\t      makeAssistantMessage({\n    74\t        toolCalls: [\n    75\t          { id: CALL_A, name: \"read_file\", arguments: { path: \"a.txt\" } },\n    76\t          { id: CALL_B, name: \"read_file\", arguments: { path: \"b.txt\" } },\n    77\t        ],\n    78\t      }),\n    79\t      makeToolResult({ id: CALL_B, content: \"b contents\" }),\n    80\t      makeToolResult({ id: CALL_A, content: \"a contents\" }),\n    81\t      makeAssistantMessage({ text: \"read both\" }),\n    82\t    ],\n    83\t    expected: [\n    84\t      validEvent(\"user_prompt\", { payload: { text: \"read both files\" } }),\n    85\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"a.txt\" } } }),\n    86\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_B, toolName: \"read_file\", arguments: { path: \"b.txt\" } } }),\n    87\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_B, content: \"b contents\", isError: false } }),\n    88\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"a contents\", isError: false } }),\n    89\t      validEvent(\"assistant_text\", { payload: { text: \"read both\" } }),\n    90\t      validEvent(\"turn_end\"),\n    91\t    ],\n    92\t  };\n    93\t}\n    94\t\n    95\t/** A tool result flagged as an error, captured with its content (AC-2.4). */\n    96\texport function loadErrorResultCorpus(): Corpus {\n    97\t  return {\n    98\t    name: \"error-result\",\n    99\t    source: [\n   100\t      makeUserMessage(\"read missing.txt\"),\n   101\t      makeAssistantMessage({ toolCalls: [{ id: CALL_A, name: \"read_file\", arguments: { path: \"missing.txt\" } }] }),\n   102\t      makeToolResult({ id: CALL_A, isError: true, content: \"ENOENT: no such file\" }),\n   103\t      makeAssistantMessage({ text: \"that file does not exist\" }),\n   104\t    ],\n   105\t    expected: [\n   106\t      validEvent(\"user_prompt\", { payload: { text: \"read missing.txt\" } }),\n   107\t      validEvent(\"tool_call\", { payload: { toolCallId: CALL_A, toolName: \"read_file\", arguments: { path: \"missing.txt\" } } }),\n   108\t      validEvent(\"tool_result\", { payload: { toolCallId: CALL_A, content: \"ENOENT: no such file\", isError: true } }),\n   109\t      validEvent(\"assistant_text\", { payload: { text: \"that file does not exist\" } }),\n   110\t      validEvent(\"turn_end\"),\n   111\t    ],\n   112\t  };\n   113\t}\n   114\t\n   115\t/** A graceful interrupt: partial assistant content, turn closed\n   116\t *  complete-but-aborted at agent_end (AC-2.6 / research §5b). */\n   117\texport function loadAbortedTurnCorpus(): Corpus {\n   118\t  return {\n   119\t    name: \"aborted-turn\",\n   120\t    source: [\n   121\t      makeUserMessage(\"write a long essay\"),\n   122\t      makeAssistantMessage({ thinking: \"starting the essay\", text: \"Once upon a\", stopReason: \"aborted\" }),\n   123\t    ],\n   124\t    expected: [\n   125\t      validEvent(\"user_prompt\", { payload: { text: \"write a long essay\" } }),\n   126\t      validEvent(\"assistant_thinking\", { payload: { text: \"starting the essay\" } }),\n   127\t      validEvent(\"assistant_text\", { payload: { text: \"Once upon a\" } }),\n   128\t      validEvent(\"turn_end\"),\n   129\t    ],\n   130\t  };\n   131\t}\n   132\t\n   133\texport const CORPUS_LOADERS = {\n   134\t  chatty: loadChattyCorpus,\n   135\t  \"tool-heavy\": loadToolHeavyCorpus,\n   136\t  \"parallel-tool\": loadParallelToolCorpus,\n   137\t  \"error-result\": loadErrorResultCorpus,\n   138\t  \"aborted-turn\": loadAbortedTurnCorpus,\n   139\t} as const;\n   140\t\n   141\texport type CorpusName = keyof typeof CORPUS_LOADERS;\n   142\t\n   143\texport function loadAllCorpora(): Corpus[] {\n   144\t  return Object.values(CORPUS_LOADERS).map((load) => load());\n   145\t}\n   146\t\n   147\t/** A deliberately malformed sequence for the capture-failure test: an empty\n   148\t *  user prompt, a `tool_result` whose id has no preceding `tool_call` (dangling\n   149\t *  correlation), and no closing `turn_end`. `validateCorpus` must reject it —\n   150\t *  proving the validator actually inspects shape rather than rubber-stamping. */\n   151\texport function makeTruncatedCorpus(): Corpus {\n   152\t  return {\n   153\t    name: \"truncated\",\n   154\t    source: [makeUserMessage(\"\")],\n   155\t    expected: [\n   156\t      validEvent(\"user_prompt\", { payload: { text: \"\" } }),\n   157\t      validEvent(\"tool_result\", { payload: { toolCallId: \"dangling-call\", content: \"orphan result\", isError: false } }),\n   158\t    ],\n   159\t  };\n   160\t}\n   161\t\n   162\texport interface CorpusValidation {\n   163\t  valid: boolean;\n   164\t  problems: string[];\n   165\t}\n   166\t\n   167\tconst EVENT_KINDS: ReadonlySet<EventKind> = new Set<EventKind>([\n   168\t  \"user_prompt\",\n   169\t  \"assistant_text\",\n   170\t  \"assistant_thinking\",\n   171\t  \"runtime_note\",\n   172\t  \"tool_call\",\n   173\t  \"tool_result\",\n   174\t  \"turn_end\",\n   175\t]);\n   176\t\n   177\t/** Check a corpus yields well-formed `MessageEventInput` shapes and a\n   178\t *  lifecycle-coherent sequence (every `tool_result` correlates to a preceding\n   179\t *  `tool_call`; the sequence closes with `turn_end`). Returns the problems it\n   180\t *  found — `valid` is derived from that list, never a constant. */\n   181\texport function validateCorpus(corpus: Corpus): CorpusValidation {\n   182\t  const problems: string[] = [];\n   183\t  if (corpus.name.trim() === \"\") problems.push(\"corpus has an empty name\");\n   184\t  if (corpus.expected.length === 0) problems.push(`${corpus.name}: no expected events`);\n   185\t\n   186\t  const seenToolCalls = new Set<string>();\n   187\t  for (const [i, ev] of corpus.expected.entries()) {\n   188\t    const at = `${corpus.name}[${i}]`;\n   189\t    if (!EVENT_KINDS.has(ev.eventKind)) problems.push(`${at}: unknown eventKind \"${String(ev.eventKind)}\"`);\n   190\t    if (typeof ev.idempotencyKey !== \"string\" || ev.idempotencyKey === \"\") problems.push(`${at}: empty idempotencyKey`);\n   191\t    if (typeof ev.actor !== \"string\" || ev.actor === \"\") problems.push(`${at}: empty actor`);\n   192\t    if (typeof ev.harness !== \"string\" || ev.harness === \"\") problems.push(`${at}: empty harness`);\n   193\t\n   194\t    switch (ev.eventKind) {\n   195\t      case \"user_prompt\":\n   196\t      case \"assistant_text\":\n   197\t      case \"assistant_thinking\":\n   198\t      case \"runtime_note\": {\n   199\t        if (typeof ev.payload.text !== \"string\" || ev.payload.text === \"\") {\n   200\t          problems.push(`${at}: ${ev.eventKind} has empty text`);\n   201\t        }\n   202\t        break;\n   203\t      }\n   204\t      case \"tool_call\": {\n   205\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   206\t          problems.push(`${at}: tool_call has empty toolCallId`);\n   207\t        } else {\n   208\t          seenToolCalls.add(ev.payload.toolCallId);\n   209\t        }\n   210\t        if (typeof ev.payload.toolName !== \"string\" || ev.payload.toolName === \"\") {\n   211\t          problems.push(`${at}: tool_call has empty toolName`);\n   212\t        }\n   213\t        break;\n   214\t      }\n   215\t      case \"tool_result\": {\n   216\t        if (typeof ev.payload.toolCallId !== \"string\" || ev.payload.toolCallId === \"\") {\n   217\t          problems.push(`${at}: tool_result has empty toolCallId`);\n   218\t        } else if (!seenToolCalls.has(ev.payload.toolCallId)) {\n   219\t          problems.push(`${at}: tool_result for \"${ev.payload.toolCallId}\" has no preceding tool_call`);\n   220\t        }\n   221\t        if (typeof ev.payload.content !== \"string\") {\n   222\t          problems.push(`${at}: tool_result has non-string content`);\n   223\t        }\n   224\t        break;\n   225\t      }\n   226\t      case \"turn_end\":\n   227\t        break;\n   228\t    }\n   229\t  }\n   230\t\n   231\t  const last = corpus.expected[corpus.expected.length - 1];\n   232\t  if (last !== undefined && last.eventKind !== \"turn_end\") {\n   233\t    problems.push(`${corpus.name}: sequence does not close with turn_end`);\n   234\t  }\n   235\t\n   236\t  return { valid: problems.length === 0, problems };\n   237\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/synthetic.ts'","aggregated_output":"     1\t// Synthetic builders for the two test edges (tech design §Fixture Contracts):\n     2\t//   - PI `AgentMessage` / event builders feed the PI hook edge where a precise\n     3\t//     hand-built shape beats a recorded one (lifecycle + turn-derivation tests).\n     4\t//   - `validEvent` builds a single, correctly-typed LHC `MessageEventInput` so\n     5\t//     a kind/payload mismatch is a compile error, not a runtime surprise.\n     6\timport type { EventKind, MessageEventInput } from \"lhc\";\n     7\timport type {\n     8\t  AgentEndEvent,\n     9\t  AgentMessage,\n    10\t  AssistantMessage,\n    11\t  ContentPart,\n    12\t  MessageEndEvent,\n    13\t  PiStopReason,\n    14\t  SessionStartEvent,\n    15\t  SessionStartReason,\n    16\t  ToolResultMessage,\n    17\t  UserMessage,\n    18\t} from \"../../src/pi/types.js\";\n    19\t\n    20\t// ── LHC intake-event builder ─────────────────────────────────────────\n    21\t\n    22\texport type EventByKind<K extends EventKind> = Extract<MessageEventInput, { eventKind: K }>;\n    23\t\n    24\tlet keyCounter = 0;\n    25\t/** Reset the per-call key counter so a test can build deterministic keys. */\n    26\texport function resetEventKeyCounter(): void {\n    27\t  keyCounter = 0;\n    28\t}\n    29\t\n    30\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n    31\t  user_prompt: () => ({ text: \"please read the file\" }),\n    32\t  assistant_text: () => ({ text: \"here is what I found\" }),\n    33\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n    34\t  runtime_note: () => ({ text: \"model changed: anthropic/claude → openai/gpt\" }),\n    35\t  tool_call: () => ({ toolCallId: \"call-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } }),\n    36\t  tool_result: () => ({ toolCallId: \"call-1\", content: \"contents of notes.txt\", isError: false }),\n    37\t  turn_end: () => ({}),\n    38\t};\n    39\t\n    40\t/** The discriminated `MessageEventInput` member for its kind. A kind/payload\n    41\t *  mismatch at a call site is a compile error; the final reconciliation goes\n    42\t *  through `unknown` (TS can't reduce a structural spread to the deferred\n    43\t *  Extract), with call-site safety living in the parameter types. */\n    44\texport function validEvent<K extends EventKind>(\n    45\t  kind: K,\n    46\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n    47\t): EventByKind<K> {\n    48\t  keyCounter += 1;\n    49\t  const base = {\n    50\t    eventKind: kind,\n    51\t    idempotencyKey: `pi-lhc-fixture-${keyCounter}`,\n    52\t    actor: \"fixture-actor\",\n    53\t    harness: \"pi\",\n    54\t    payload: defaultPayloads[kind](),\n    55\t  };\n    56\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    57\t}\n    58\t\n    59\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    60\t  return kinds.map((kind) => validEvent(kind));\n    61\t}\n    62\t\n    63\t// ── PI message builders ──────────────────────────────────────────────\n    64\t\n    65\texport function makeUserMessage(text = \"please read the file\"): UserMessage {\n    66\t  return { role: \"user\", content: [{ type: \"text\", text }] };\n    67\t}\n    68\t\n    69\texport interface AssistantToolCall {\n    70\t  id: string;\n    71\t  name: string;\n    72\t  arguments?: Record<string, unknown>;\n    73\t}\n    74\t\n    75\t/** Fans out to content parts in PI's confirmed order: thinking → text →\n    76\t *  toolCall×N (research §5a). */\n    77\texport function makeAssistantMessage(\n    78\t  opts: {\n    79\t    thinking?: string;\n    80\t    text?: string;\n    81\t    toolCalls?: AssistantToolCall[];\n    82\t    stopReason?: PiStopReason;\n    83\t  } = {},\n    84\t): AssistantMessage {\n    85\t  const content: ContentPart[] = [];\n    86\t  if (opts.thinking !== undefined) content.push({ type: \"thinking\", thinking: opts.thinking });\n    87\t  if (opts.text !== undefined) content.push({ type: \"text\", text: opts.text });\n    88\t  for (const call of opts.toolCalls ?? []) {\n    89\t    content.push({ type: \"toolCall\", id: call.id, name: call.name, arguments: call.arguments ?? {} });\n    90\t  }\n    91\t  const msg: AssistantMessage = { role: \"assistant\", content };\n    92\t  if (opts.stopReason !== undefined) msg.stopReason = opts.stopReason;\n    93\t  return msg;\n    94\t}\n    95\t\n    96\texport function makeToolResult(opts: {\n    97\t  id: string;\n    98\t  isError?: boolean;\n    99\t  content?: string;\n   100\t}): ToolResultMessage {\n   101\t  const msg: ToolResultMessage = {\n   102\t    role: \"toolResult\",\n   103\t    toolCallId: opts.id,\n   104\t    content: [{ type: \"text\", text: opts.content ?? \"tool output\" }],\n   105\t  };\n   106\t  if (opts.isError !== undefined) msg.isError = opts.isError;\n   107\t  return msg;\n   108\t}\n   109\t\n   110\t// ── PI event-stream builders ─────────────────────────────────────────\n   111\t\n   112\texport function makeSessionStart(\n   113\t  reason: SessionStartReason = \"startup\",\n   114\t  previousSessionFile?: string,\n   115\t): SessionStartEvent {\n   116\t  const ev: SessionStartEvent = { reason };\n   117\t  if (previousSessionFile !== undefined) ev.previousSessionFile = previousSessionFile;\n   118\t  return ev;\n   119\t}\n   120\t\n   121\texport function makeMessageEnd(message: AgentMessage): MessageEndEvent {\n   122\t  return { message };\n   123\t}\n   124\t\n   125\texport function makeAgentEnd(messages: AgentMessage[]): AgentEndEvent {\n   126\t  return { messages };\n   127\t}\n","exit_code":0,"status":"completed"}}

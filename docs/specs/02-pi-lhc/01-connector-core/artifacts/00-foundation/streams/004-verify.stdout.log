{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/thread.ts'","aggregated_output":"     1\t// Temp-thread factory: a REAL temp SQLite thread per test (tech design §Testing\n     2\t// Strategy — persistence, reattach, replay, and fork are the product contract,\n     3\t// so the store is never mocked). Mirrors the lhc package's `tempStore` so the\n     4\t// connector's tests isolate their registry + thread files the same way.\n     5\timport { mkdtempSync, rmSync } from \"node:fs\";\n     6\timport { tmpdir } from \"node:os\";\n     7\timport { join } from \"node:path\";\n     8\timport { threads, type ThreadRef } from \"lhc\";\n     9\t\n    10\texport interface TempStore {\n    11\t  dir: string;\n    12\t  registryPath: string;\n    13\t  threadPath: (name?: string) => string;\n    14\t  cleanup: () => void;\n    15\t}\n    16\t\n    17\texport function tempStore(): TempStore {\n    18\t  const dir = mkdtempSync(join(tmpdir(), \"pi-lhc-test-\"));\n    19\t  let threadCounter = 0;\n    20\t  return {\n    21\t    dir,\n    22\t    registryPath: join(dir, \"registry.sqlite\"),\n    23\t    threadPath: (name) => {\n    24\t      threadCounter += 1;\n    25\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    26\t    },\n    27\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n    28\t  };\n    29\t}\n    30\t\n    31\texport interface TempThread {\n    32\t  threadRef: ThreadRef;\n    33\t  threadId: string;\n    34\t  filePath: string;\n    35\t}\n    36\t\n    37\t/** Create a real thread file + registry row and return its ref/ids. Throws on\n    38\t *  failure so a setup error never masquerades as a test assertion. */\n    39\texport async function makeTempThread(\n    40\t  store: TempStore,\n    41\t  opts: { title?: string } = {},\n    42\t): Promise<TempThread> {\n    43\t  const filePath = store.threadPath();\n    44\t  const input: { filePath: string; registryPath: string; title?: string } = {\n    45\t    filePath,\n    46\t    registryPath: store.registryPath,\n    47\t  };\n    48\t  if (opts.title !== undefined) input.title = opts.title;\n    49\t  const created = await threads.newThread(input);\n    50\t  if (!created.ok) {\n    51\t    throw new Error(`temp thread creation failed: ${created.error.reason}`);\n    52\t  }\n    53\t  return { threadRef: { filePath }, threadId: created.value.threadId, filePath };\n    54\t}\n","exit_code":0,"status":"completed"}}

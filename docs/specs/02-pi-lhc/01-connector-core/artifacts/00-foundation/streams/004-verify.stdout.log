,\\n    register(pi: ExtensionAPI): void {\\n      for (const name of EPIC_1_HOOKS) registerOne(pi, name);\\n    },\\n    getState(): SessionState | null {\\n      return state;\\n    },\\n    snapshot(): ConnectorSnapshot {\\n      return { state, lastDiagnostic };\\n    },\\n  };\\n}\\n\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n *  loads (and again on `/reload`). Registers the observe-only hook rail. */\\nexport function activate(pi: ExtensionAPI): void {\\n  createConnector().register(pi);\\n}\\n\\nexport default activate;\\n\",\"structuredPatch\":[{\"oldStart\":63,\"oldLines\":7,\"newStart\":63,\"newLines\":10,\"lines\":[\"   // Contain every handler: an observe-only hook must never throw back into PI\",\"   // (a thrown hook breaks the user's session). A caught error becomes a\",\"   // plain-data diagnostic; it is never rethrown.\",\"-  function guard<N extends Epic1Hook>(name: N, body: PiHookHandler<N>): PiHookHandler<N> {\",\"+  const guard = (\",\"+    name: Epic1Hook,\",\"+    body: PiHookHandler<Epic1Hook>,\",\"+  ): PiHookHandler<Epic1Hook> => {\",\"     return async (ctx, event): Promise<void> => {\",\"       try {\",\"         await body(ctx, event);\"]},{\"oldStart\":75,\"oldLines\":28,\"newStart\":78,\"newLines\":24,\"lines\":[\"         };\",\"       }\",\"     };\",\"-  }\",\"-\",\"-  // Story 0 routes each hook to a fail-closed no-op: the rail is real and routes\",\"-  // to a handler that receives a FRESH ctx and retains none of it, but no\",\"-  // capture / resolution / derivation happens or is faked yet. Later stories\",\"-  // replace each body with the hook's real routing.\",\"-  const handlers = {} as { [N in Epic1Hook]: PiHookHandler<N> };\",\"-  const install = <N extends Epic1Hook>(name: N): void => {\",\"-    handlers[name] = guard(name, () => {\",\"-      // Intentionally empty — observe-only foundation.\",\"-    });\",\"   };\",\"-  for (const name of EPIC_1_HOOKS) install(name);\",\" \",\"-  const
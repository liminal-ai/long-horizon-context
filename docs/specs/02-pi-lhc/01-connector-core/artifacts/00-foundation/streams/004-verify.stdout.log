e, { title: \\\"foundation smoke\\\" });\\n    expect(threadId).toBeTruthy();\\n\\n    // reopen via the registry (resolve by id)\\n    const resolved = await threads.resolve({ threadId, registryPath: store.registryPath });\\n    expect(resolved.ok).toBe(true);\\n    if (resolved.ok) {\\n      expect(resolved.value.threadId).toBe(threadId);\\n      expect(resolved.value.title).toBe(\\\"foundation smoke\\\");\\n    }\\n\\n    // reopen via the thread file's own identity header (info by file path)\\n    const info = await threads.info({ filePath });\\n    expect(info.ok).toBe(true);\\n    if (info.ok) expect(info.value.threadId).toBe(threadId);\\n  });\\n\\n  it(\\\"isolates each created thread under its own temp store\\\", async () => {\\n    store = tempStore();\\n    const a = await makeTempThread(store);\\n    const b = await makeTempThread(store);\\n    expect(a.threadId).not.toBe(b.threadId);\\n    expect(a.filePath).not.toBe(b.filePath);\\n  });\\n});\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2143,\"cache_read_input_tokens\":264095,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2143},\"output_tokens\":49,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"814546fe-4436-4e4f-8c69-071884ddc90c\",\"uuid\":\"803c01db-ba72-4867-8f2e-583a5420fa7b\",\"request_id\":\"req_011Cc2SzVSzQZ71DDgttZACk\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:3790:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01WLgtrSKisT386qNJuVgzes\",\"type\":\"tool_result\",\"content\":\"File created successfully at: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/thread.test.ts (file state is current in
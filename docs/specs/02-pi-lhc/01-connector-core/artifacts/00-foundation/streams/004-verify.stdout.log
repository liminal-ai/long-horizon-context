{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/src/index.ts'","aggregated_output":"     1\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\n     2\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\n     3\t// handler. It owns no state beyond the plain-data `SessionState` (and, later, an\n     4\t// `LhcInstance`) held in the connector closure — never a PI `ctx`/session\n     5\t// object (tech design Flow 1, plain-data rule).\n     6\timport type {\n     7\t  ExtensionAPI,\n     8\t  PiHookHandler,\n     9\t  PiHookName,\n    10\t} from \"./pi/types.js\";\n    11\timport type { CaptureFailureDiagnostic, SessionState } from \"./lifecycle/state.js\";\n    12\t\n    13\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\n    14\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\n    15\t *  registers no handler for it (story Scope Out). */\n    16\texport const EPIC_1_HOOKS = [\n    17\t  \"session_start\",\n    18\t  \"message_end\",\n    19\t  \"turn_end\",\n    20\t  \"agent_end\",\n    21\t  \"model_select\",\n    22\t  \"thinking_level_select\",\n    23\t  \"session_before_fork\",\n    24\t  \"session_before_switch\",\n    25\t  \"session_shutdown\",\n    26\t] as const satisfies readonly PiHookName[];\n    27\t\n    28\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\n    29\t\n    30\t/** Everything the connector retains across hooks — all plain data, by\n    31\t *  construction structuredClone-able. There is no field that could hold a PI\n    32\t *  object. */\n    33\texport interface ConnectorSnapshot {\n    34\t  state: SessionState | null;\n    35\t  lastDiagnostic: CaptureFailureDiagnostic | null;\n    36\t}\n    37\t\n    38\texport interface Connector {\n    39\t  /** Register the observe-only hook rail on the PI extension API. */\n    40\t  register(pi: ExtensionAPI): void;\n    41\t  /** The plain-data state retained across hooks. `null` until a session\n    42\t   *  resolves a thread (Story 1); never holds a PI ctx. */\n    43\t  getState(): SessionState | null;\n    44\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\n    45\t  snapshot(): ConnectorSnapshot;\n    46\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\n    47\t   *  synthetic ctx/events without a live PI. Each accepts any Epic 1 event\n    48\t   *  (the foundation handlers are uniform no-ops). */\n    49\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\n    50\t}\n    51\t\n    52\t/** Build a connector instance. Its mutable state lives in this closure; the\n    53\t *  registered handlers capture it, so the instance stays live for the session\n    54\t *  even when `activate` discards the returned object. */\n    55\texport function createConnector(): Connector {\n    56\t  // The connector's ENTIRE retained state. Both are plain data and are the only\n    57\t  // things that survive between hooks. `state` stays null in Epic 1 Story 0\n    58\t  // (thread resolution is fail-closed until Story 1); Story 1 populates it via\n    59\t  // createSessionState once a thread resolves.\n    60\t  let state: SessionState | null = null;\n    61\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\n    62\t\n    63\t  // Contain every handler: an observe-only hook must never throw back into PI\n    64\t  // (a thrown hook breaks the user's session). A caught error becomes a\n    65\t  // plain-data diagnostic; it is never rethrown.\n    66\t  const guard = (\n    67\t    name: Epic1Hook,\n    68\t    body: PiHookHandler<Epic1Hook>,\n    69\t  ): PiHookHandler<Epic1Hook> => {\n    70\t    return async (ctx, event): Promise<void> => {\n    71\t      try {\n    72\t        await body(ctx, event);\n    73\t      } catch (err) {\n    74\t        lastDiagnostic = {\n    75\t          code: \"hook_handler_error\",\n    76\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\n    77\t          recordedGap: false,\n    78\t        };\n    79\t      }\n    80\t    };\n    81\t  };\n    82\t\n    83\t  // Observe-only foundation: every hook routes to a no-op that receives a FRESH\n    84\t  // ctx and retains none of it.\n    85\t  const noop: PiHookHandler<Epic1Hook> = () => {\n    86\t    // Intentionally empty — later stories replace this with real routing.\n    87\t  };\n    88\t\n    89\t  // Story 0 routes each hook to a fail-closed no-op: the rail is real and routes\n    90\t  // to a handler, but no capture / resolution / derivation happens or is faked\n    91\t  // yet. The accumulator is filled for every hook in the loop below.\n    92\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\n    93\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, noop);\n    94\t\n    95\t  return {\n    96\t    handlers,\n    97\t    register(pi: ExtensionAPI): void {\n    98\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\n    99\t    },\n   100\t    getState(): SessionState | null {\n   101\t      return state;\n   102\t    },\n   103\t    snapshot(): ConnectorSnapshot {\n   104\t      return { state, lastDiagnostic };\n   105\t    },\n   106\t  };\n   107\t}\n   108\t\n   109\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\n   110\t *  loads (and again on `/reload`). Registers the observe-only hook rail. */\n   111\texport function activate(pi: ExtensionAPI): void {\n   112\t  createConnector().register(pi);\n   113\t}\n   114\t\n   115\texport default activate;\n","exit_code":0,"status":"completed"}}

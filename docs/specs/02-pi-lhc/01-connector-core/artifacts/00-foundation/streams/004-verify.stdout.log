re: TempStore,\\n60\\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\\n61\\t): Promise<{ filePath: string; turnId: string }> {\\n62\\t  const filePath = await newThreadFile(store);\\n63\\t  const batch: MessageEventInput[] = [\\n64\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please run the tool\\\" } }),\\n65\\t    validEvent(\\\"tool_call\\\", {\\n66\\t      payload: { toolCallId: \\\"call-fixture-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } },\\n67\\t    }),\\n68\\t  ];\\n69\\t  if (opts.missingResult !== true) {\\n70\\t    batch.push(\\n71\\t      validEvent(\\\"tool_result\\\", {\\n72\\t        payload: {\\n73\\t          toolCallId: \\\"call-fixture-1\\\",\\n74\\t          content: opts.resultContent ?? \\\"contents of notes.txt\\\",\\n75\\t          isError: opts.isError ?? false,\"}]},\"parent_tool_use_id\":null,\"session_id\":\"814546fe-4436-4e4f-8c69-071884ddc90c\",\"uuid\":\"6e291b3d-0560-47e1-a230-e0e3cb110d19\",\"timestamp\":\"2026-06-14T03:08:33.789Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/threads.ts\",\"content\":\"// Thread builders for Epic 02 (test plan §Test Substrate). All built through\\n// real intake; the multi-state and damaged-source builders then apply the\\n// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\\n// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\\n// builders wrote; Stories 2/4 confirm the states arise for real\\n// (coverage.md cross-story debt).\\nimport { DatabaseSync } from \\\"node:sqlite\\\";\\nimport {\\n  intakeStream,\\n  threads,\\n  type DerivedForm,\\n  type DerivedFormState,\\n  type DependencyGap,\\n  type FormKind,\\n  type Lhc,\\n  type MessageEventInput,\\n  type SubjectKind,\\n  type ToolOutcome,\\n} from \\\"../../src/index.js\\\";\\nimport { setIntakeClock } from \\\"./intake-seam.js\\\";\\nimport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\nimport type { ProviderDouble } from \\\"./provider-double.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\nasync function newThreadFile(store: TempStore): Promise<string> {\\n  const filePath = store.threadPath();\\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  return filePath;\\n}\\n\\nasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\\n  const result = await intakeStream.messageEvents({ filePath }, batch);\\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n}\\n\\n// n closed turns, each prompt + assistant text + explicit end. Turn ids are\\n// deterministic (t1..tn) per the turn store's id scheme.\\nexport async function threadWithClosedTurns(\\n  store: TempStore,\\n  n: number,\\n): Promise<{ filePath: string; turnIds: string[] }> {\\n  const filePath = await newThreadFile(store);\\n  const turnIds: string[] = [];\\n  for (let i = 1; i <= n; i += 1) {\\n    await send(filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: `prompt for turn ${i}` } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: `answer for turn ${i}` } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    turnIds.push(`t${i}`);\\n  }\\n  return { filePath, turnIds };\\n}\\n\\n// One closed turn containing a tool run: call + result pair by default;\\n// error and missing-result variants per the epic's outcome vocabulary.\\nexport async function threadWithToolRun(\\n  store: TempStore,\\n  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\\n): Promise<{ filePath: string; turnId: string }> {\\n  const filePath = await newThreadFile(store);\\n  const batch: MessageEventInput[] = [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please run the tool\\\" } }),\\n    validEvent(\\\"tool_call\\\", {\\n      payload: { toolCallId: \\\"call-fixture-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } },\\n    }),\\n  ];\\n  if (opts.missingResult !== true) {\\n    batch.push(\\n      validEvent(\\\"tool_result\\\", {\\n        payload: {\\n          toolCallId: \\\"call-fixture-1\\\",\\n          content: opts.resultContent ?? \\\"contents of notes.txt\\\",\\n          isError: opts.isError ?? false,\",\"numLines\":75,\"startLine\":1,\"totalLines\":360}}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:826:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"Let me see the `TempStore` helper definition that these fixtures use.\"}},\"session_id\":\"814546fe-4436-4e4f-8c69-071884ddc90c\",\"parent_tool_use_id\":null,\"uuid\":\"fde5c02e-9090-45cf-94a7-bab06deffd1c\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:827:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_01Hk2JmYpkku2tPaS3TrRoVN\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Let me see the `TempStore` helper definition that these fixtures use.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2259,\"cache_read_input_tokens\":126221,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2259},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"814546fe-4436-4e4f-8c69-071884ddc90c\",\"uuid\":\"b4c9624d-bc5c-4d20-bc5c-dabd982bde54\",\"request_id\":\"req_011Cc2R6KvvwhvmdPyzzy68C\"}\ndocs/specs/02-pi-lh
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/model-call.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from \"vitest\";\n     2\timport type { ModelCallFailureKind, ModelCallInput } from \"lhc\";\n     3\timport { fakeModelCallFailure, fakeModelCallRouter, fakeModelCallText } from \"./model-call.js\";\n     4\t\n     5\tconst INPUT: ModelCallInput = {\n     6\t  provider: \"openai\",\n     7\t  model: \"gpt-4o-mini\",\n     8\t  messages: [{ role: \"user\", content: \"hi\" }],\n     9\t};\n    10\t\n    11\tdescribe(\"model-call fakes\", () => {\n    12\t  it(\"fakeModelCallText resolves to ok + text\", async () => {\n    13\t    const result = await fakeModelCallText(\"hello\")(INPUT);\n    14\t    expect(result).toEqual({ ok: true, text: \"hello\" });\n    15\t  });\n    16\t\n    17\t  it(\"fakeModelCallFailure resolves to each classified failure kind\", async () => {\n    18\t    const kinds: ModelCallFailureKind[] = [\n    19\t      \"auth\",\n    20\t      \"invalid_request\",\n    21\t      \"rate_limit\",\n    22\t      \"timeout\",\n    23\t      \"network\",\n    24\t      \"other\",\n    25\t    ];\n    26\t    for (const kind of kinds) {\n    27\t      const result = await fakeModelCallFailure(kind)(INPUT);\n    28\t      expect(result.ok).toBe(false);\n    29\t      if (!result.ok) expect(result.kind).toBe(kind);\n    30\t    }\n    31\t  });\n    32\t\n    33\t  it(\"fakeModelCallRouter routes by provider/model and fails closed on an unrouted key\", async () => {\n    34\t    const router = fakeModelCallRouter({\n    35\t      \"openai/gpt-4o-mini\": fakeModelCallText(\"from openai\"),\n    36\t      \"anthropic/claude-3\": fakeModelCallText(\"from anthropic\"),\n    37\t    });\n    38\t    expect(await router(INPUT)).toEqual({ ok: true, text: \"from openai\" });\n    39\t    expect(await router({ ...INPUT, provider: \"anthropic\", model: \"claude-3\" })).toEqual({\n    40\t      ok: true,\n    41\t      text: \"from anthropic\",\n    42\t    });\n    43\t    const missing = await router({ ...INPUT, provider: \"unknown\", model: \"x\" });\n    44\t    expect(missing.ok).toBe(false); // never a silent success\n    45\t  });\n    46\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/pi-lhc/test/fixtures/synthetic.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  eventBatch,\n     4\t  makeAgentEnd,\n     5\t  makeAssistantMessage,\n     6\t  makeMessageEnd,\n     7\t  makeSessionStart,\n     8\t  makeToolResult,\n     9\t  makeUserMessage,\n    10\t  validEvent,\n    11\t} from \"./synthetic.js\";\n    12\t\n    13\tdescribe(\"synthetic builders\", () => {\n    14\t  it(\"build PI messages that fan out in PI's confirmed content-part order\", () => {\n    15\t    const user = makeUserMessage(\"hello\");\n    16\t    expect(user.role).toBe(\"user\");\n    17\t    expect(user.content).toEqual([{ type: \"text\", text: \"hello\" }]);\n    18\t\n    19\t    const assistant = makeAssistantMessage({\n    20\t      thinking: \"hmm\",\n    21\t      text: \"answer\",\n    22\t      toolCalls: [\n    23\t        { id: \"call-a\", name: \"read_file\" },\n    24\t        { id: \"call-b\", name: \"write_file\" },\n    25\t      ],\n    26\t    });\n    27\t    expect(assistant.role).toBe(\"assistant\");\n    28\t    // thinking → text → toolCall×N (research §5a)\n    29\t    expect(assistant.content.map((p) => p.type)).toEqual([\"thinking\", \"text\", \"toolCall\", \"toolCall\"]);\n    30\t\n    31\t    const toolResult = makeToolResult({ id: \"call-a\", isError: true, content: \"boom\" });\n    32\t    expect(toolResult.role).toBe(\"toolResult\");\n    33\t    expect(toolResult.toolCallId).toBe(\"call-a\");\n    34\t    expect(toolResult.isError).toBe(true);\n    35\t  });\n    36\t\n    37\t  it(\"omit optional fields rather than setting them undefined (exactOptionalPropertyTypes discipline)\", () => {\n    38\t    const assistant = makeAssistantMessage({ text: \"no stop reason here\" });\n    39\t    expect(\"stopReason\" in assistant).toBe(false);\n    40\t    const toolResult = makeToolResult({ id: \"call-a\" });\n    41\t    expect(\"isError\" in toolResult).toBe(false);\n    42\t  });\n    43\t\n    44\t  it(\"build correctly-typed LHC intake events with unique idempotency keys\", () => {\n    45\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    46\t    expect(batch.map((e) => e.eventKind)).toEqual([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    47\t    const keys = batch.map((e) => e.idempotencyKey);\n    48\t    expect(new Set(keys).size).toBe(keys.length); // keys are unique per build\n    49\t\n    50\t    const toolCall = validEvent(\"tool_call\", {\n    51\t      payload: { toolCallId: \"x\", toolName: \"run\", arguments: { a: 1 } },\n    52\t    });\n    53\t    expect(toolCall.eventKind).toBe(\"tool_call\");\n    54\t    expect(toolCall.payload.toolCallId).toBe(\"x\");\n    55\t  });\n    56\t\n    57\t  it(\"build event-stream payloads for the lifecycle hooks\", () => {\n    58\t    expect(makeSessionStart(\"resume\").reason).toBe(\"resume\");\n    59\t    const msg = makeUserMessage(\"hi\");\n    60\t    expect(makeMessageEnd(msg).message).toBe(msg);\n    61\t    expect(makeAgentEnd([msg]).messages).toEqual([msg]);\n    62\t  });\n    63\t});\n","exit_code":0,"status":"completed"}}

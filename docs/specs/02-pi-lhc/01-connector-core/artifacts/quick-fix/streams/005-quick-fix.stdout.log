356\t    // connector ordinal is used only when PI gives no event identity at all.\n   357\t    // For id-less + position-less reload replay, PI's deterministic redelivery\n   358\t    // order yields the same ordinal, which is the best identity available.\n   359\t    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\n   360\t  }\n   361\t\n   362\t  async function recordMappingFailure(\n   363\t    hook: string,\n   364\t    position: number | undefined,\n   365\t    sourceSeq: number,\n   366\t    cause: unknown,\n   367\t  ): Promise<void> {\n   368\t    if (instance === null) return;\n   369\t    const message = cause instanceof Error ? cause.message : String(cause);\n   370\t    const result = await captureGap(\n   371\t      fallbackIdFor(hook, position, sourceSeq),\n   372\t      `${hook}: ${message}`,\n   373\t      instance,\n   374\t    );\n   375\t    if (!result.ok) {\n   376\t      recordCaptureOutcome(result, []);\n   377\t      return;\n   378\t    }\n   379\t    const failure: CaptureFailureDiagnostic = {\n   380\t      code: \"invalid_event\",\n   381\t      message: `${hook}: ${message}`,\n   382\t      recordedGap: true,\n   383\t    };\n   384\t    lastDiagnostic = failure;\n   385\t    if (state !== null) state.health.lastCaptureFailure = failure;\n   386\t  }\n   387\t\n   388\t  // message_end: map the finalized PI message to ordered LHC events, track the\n   389\t  // open turn, and flush through the converter (AC-2.1).\n   390\t  const onMessageEnd: PiHookHandler<\"message_end\"> = async (_ctx, event) => {\n   391\t    if (instance === null || captureSession === null) return;\n   392\t    const sourceSeq = nextSourceSeq(captureSession);\n   393\t    const mapCtx: MapCtx =\n   394\t      event.entryId !== undefined && event.entryId !== \"\"\n   395\t        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\n   396\t        : {\n   397\t            piSessionId: captureSession.piSessionId,\n   398\t            fallbackId: fallbackIdFor(\"message_end\", event.position, sourceSeq),\n   399\t          };\n   400\t    let events: MessageEventInput[];\n   401\t    try {\n   402\t      events = mapMessage(event.message, mapCtx);\n   403\t    } catch (cause) {\n   404\t      await recordMappingFailure(\"message_end\", event.position, sourceSeq, cause);\n   405\t      return;\n   406\t    }\n   407\t    captureSession.accumulator.onMessage(events);\n   408\t    if (events.length === 0) return;\n   409\t    recordCaptureOutcome(await capture(events, instance), events);\n   410\t  };\n   411\t\n   412\t  // model_select / thinking_level_select fire only in-stream — capture each as\n   413\t  // an ordered runtime_note the moment it fires (AC-2.8).\n   414\t  const onModelSelect: PiHookHandler<\"model_select\"> = async (_ctx, event) => {\n   415\t    if (instance === null || captureSession === null) return;\n   416\t    const sourceSeq = nextSourceSeq(captureSession);\n   417\t    const mapCtx: MapCtx = {\n   418\t      piSessionId: captureSession.piSessionId,\n   419\t      fallbackId: fallbackIdFor(\"model_select\", event.position, sourceSeq),\n   420\t    };\n   421\t    const note = mapModelSelect(event, mapCtx);\n   422\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   423\t  };\n   424\t\n   425\t  const onThinkingLevelSelect: PiHookHandler<\"thinking_level_select\"> = async (_ctx, event) => {\n   426\t    if (instance === null || captureSession === null) return;\n   427\t    const sourceSeq = nextSourceSeq(captureSession);\n   428\t    const mapCtx: MapCtx = {\n   429\t      piSessionId: captureSession.piSessionId,\n   430\t      fallbackId: fallbackIdFor(\"thinking_level_select\", event.position, sourceSeq),\n   431\t    };\n   432\t    const note = mapThinkingLevelSelect(event, mapCtx);\n   433\t    recordCaptureOutcome(await capture([note], instance), [note]);\n   434\t  };\n   435\t\n","exit_code":0,"status":"completed"}}

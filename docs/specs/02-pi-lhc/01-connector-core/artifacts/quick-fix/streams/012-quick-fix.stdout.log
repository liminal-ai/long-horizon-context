{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/test/inference/assignments.test.ts | sed -n '1,90p'\"","aggregated_output":"     1\t// TC-5.4..5.6. Assignment loading tests.\n     2\t//\n     3\t// TC-5.4: Seven kinds load (provider,model,prompt) with shipped defaults; prompts resolve.\n     4\t// TC-5.5: Override takes effect next start, no code change.\n     5\t// TC-5.6: Incomplete/unknown assignment fails loud at init (missing kind, unknown prompt, incomplete, placeholder).\n     6\t\n     7\timport { describe, expect, it } from \"vitest\";\n     8\timport { FORM_KINDS, DEFAULT_PROMPT_NAMES, type FormKind } from \"lhc\";\n     9\timport { loadAssignments, AssignmentValidationError } from \"../../src/inference/assignments.js\";\n    10\timport { DEFAULT_PI_MODEL } from \"../../src/inference/model-call.js\";\n    11\t\n    12\tdescribe(\"Story 6: Startup Validation and Assignment Config\", () => {\n    13\t  describe(\"TC-5.4: Seven kinds load with shipped defaults\", () => {\n    14\t    it(\"loads all seven kinds with provider, model, and prompt from shipped defaults\", () => {\n    15\t      const assignments = loadAssignments(undefined);\n    16\t\n    17\t      // All seven kinds are present\n    18\t      expect(FORM_KINDS.every((kind) => kind in assignments)).toBe(true);\n    19\t\n    20\t      // Each assignment has provider, model, and prompt\n    21\t      for (const kind of FORM_KINDS) {\n    22\t        const assignment = assignments[kind];\n    23\t        expect(assignment).toBeDefined();\n    24\t        expect(assignment.provider).toBeDefined();\n    25\t        expect(assignment.provider).not.toBe(\"\");\n    26\t        expect(assignment.model).toBeDefined();\n    27\t        expect(assignment.model).not.toBe(\"\");\n    28\t        expect(assignment.prompt).toBeDefined();\n    29\t        expect(assignment.prompt).not.toBe(\"\");\n    30\t      }\n    31\t    });\n    32\t\n    33\t    it(\"uses a production PI registry lane for shipped defaults\", () => {\n    34\t      const assignments = loadAssignments(undefined);\n    35\t\n    36\t      for (const kind of FORM_KINDS) {\n    37\t        expect(assignments[kind].provider).toBe(DEFAULT_PI_MODEL.provider);\n    38\t        expect(assignments[kind].model).toBe(DEFAULT_PI_MODEL.id);\n    39\t      }\n    40\t    });\n    41\t\n    42\t    it(\"each shipped default prompt resolves to a registered prompt name\", () => {\n    43\t      const assignments = loadAssignments(undefined);\n    44\t\n    45\t      // Every prompt should match a registered prompt name\n    46\t      const registeredPrompts = Object.values(DEFAULT_PROMPT_NAMES);\n    47\t      for (const kind of FORM_KINDS) {\n    48\t        const assignment = assignments[kind];\n    49\t        expect(registeredPrompts).toContain(assignment.prompt);\n    50\t        expect(assignment.prompt).toBe(DEFAULT_PROMPT_NAMES[kind]);\n    51\t      }\n    52\t    });\n    53\t  });\n    54\t\n    55\t  describe(\"TC-5.5: User override takes effect on next session start\", () => {\n    56\t    it(\"applies provider/model/prompt override for a single kind\", () => {\n    57\t      const config = {\n    58\t        smoothed_prompt: {\n    59\t          provider: \"anthropic\",\n    60\t          model: \"claude-3-opus\",\n    61\t          prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt,\n    62\t        },\n    63\t      };\n    64\t\n    65\t      const assignments = loadAssignments(config);\n    66\t\n    67\t      expect(assignments.smoothed_prompt.provider).toBe(\"anthropic\");\n    68\t      expect(assignments.smoothed_prompt.model).toBe(\"claude-3-opus\");\n    69\t      expect(assignments.smoothed_prompt.prompt).toBe(DEFAULT_PROMPT_NAMES.smoothed_prompt);\n    70\t\n    71\t      // Other kinds retain defaults\n    72\t      expect(assignments.tool_call_summary.provider).toBe(DEFAULT_PI_MODEL.provider);\n    73\t      expect(assignments.tool_call_summary.model).toBe(DEFAULT_PI_MODEL.id);\n    74\t    });\n    75\t\n    76\t    it(\"applies partial override (provider only, keeps model/prompt from default)\", () => {\n    77\t      const config = {\n    78\t        tool_call_summary: {\n    79\t          provider: \"openai\",\n    80\t          // model and prompt omitted - should throw incomplete\n    81\t        },\n    82\t      };\n    83\t\n    84\t      // Partial overrides are not allowed - must specify all fields\n    85\t      expect(() => loadAssignments(config)).toThrow(AssignmentValidationError);\n    86\t      try {\n    87\t        loadAssignments(config);\n    88\t      } catch (e) {\n    89\t        expect(e).toBeInstanceOf(AssignmentValidationError);\n    90\t        if (e instanceof AssignmentValidationError) {\n","exit_code":0,"status":"completed"}}

inference/artifacts/04-failure-classification/story-lead/001-events.jsonl -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/001-events.jsonl\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/001-final-package.json -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/001-final-package.json\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/001-ruling-response-001.json -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/001-ruling-response-001.json\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/progress/001-story-lead.progress.jsonl -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/progress/001-story-lead.progress.jsonl\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/progress/001-story-lead.status.json -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/progress/001-story-lead.status.json\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-001.md -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-001.md\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-002.md -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-002.md\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-003.md -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-003.md\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-004.md -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/prompts/001-planner-turn-004.md\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/streams/001-story-lead.stderr.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/streams/001-story-lead.stderr.log\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/story-lead/streams/001-story-lead.stdout.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/story-lead/streams/001-story-lead.stdout.log\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/streams/003-implementor.stderr.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/streams/003-implementor.stderr.log\\nR  packages/lhc/docs/02-specs/05-derivation-inference/artifacts/04-failure-classification/streams/003-implementor.stdout.log -> docs/specs/01-lhc-sdk/05-derivation-inference/artifacts/04-failure-classification/streams/003-in    \\\"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\\\",\\n  ].join(\\\"\\\\n\\\");\\n}\\n\\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\\n *  interactive input/selection surface (wiring research), so the production\\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\\n *  most recently created thread as the best available explicit default. The\\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\\n *  takes the `select` seam); tests drive an explicit operator choice through it.\\n *  A true interactive picker awaits a PI input surface; until then resuming a\\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\\n *  precise spec deviation. */\\nfunction defaultSelectThread(\\n  choices: readonly ThreadChoice[],\\n  ctx: ExtensionContext,\\n): Promise<string | null> {\\n  const mostRecent = choices.at(-1);\\n  if (mostRecent === undefined) return Promise.resolve(null);\\n  if (ctx.hasUI) {\\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \\\"info\\\" });\\n  }\\n  return Promise.resolve(mostRecent.threadId);\\n}\\n\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n *  generated by the registry at creation, so the file name is just a unique\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\n *  parents). */\\nfunction defaultNewThreadFilePath(): string {\\n  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n  mkdirSync(dir, { recursive: true });\\n  return join(dir, `${randomUUID()}.sqlite`);\\n}\\n\\n/** Build a connector instance. Its mutable state lives in this closure; the\\n *  registered handlers capture it, so the instance stays live for the session\\n *  even when `activate` discards the returned object. The connector holds NO\\n *  module-level or durable state of its own — reload reconstructs the thread from\\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\\n *  closure reattaches correctly (AC-1.5). */\\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\\n  // The connector's retained state. `state` is plain data (the durable thread\\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\",\"numLines\":100,\"startLine\":135,\"totalLines\":676}}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:5380:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_01e3196e231549e0ad5fdb4e\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"77cffc39-26dc-48f9-877a-704996d23828\",\"timestamp\":\"2026-06-14T12:40:23.810Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\",\"oldString\":\"import type {\\n  BatchResult,\\n  DerivationProvider,\\n  MessageEventInput,\\n  OpResult,\\n  ProviderResult,\\n  SdkConfig,\\n  ThreadRef,\\n} from \\\"lhc\\\";\",\"newString\":\"import type {\\n  BatchResult,\\n  DerivationProvider,\\n  MessageEventInput,\\n  OpResult,\\n  ProviderResult,\\n  SdkConfig,\\n  ThreadRef,\\n  DEFAULT_PROMPT_NAMES,\\n} from \\\"lhc\\\";\",\"originalFile\":\"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\n// handler. The connector owns only plain-data `SessionState` plus the live\\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\nimport { mkdirSync } from \\\"node:fs\\\";\\nimport { homedir } from \\\"node:os\\\";\\nimport { join } from \\\"node:path\\\";\\nimport { randomUUID } from \\\"node:crypto\\\";\\nimport type {\\n  BatchResult,\\n  DerivationProvider,\\n  MessageEventInput,\\n  OpResult,\\n  ProviderResult,\\n  SdkConfig,\\n  ThreadRef,\\n} from \\\"lhc\\\";\\nimport type {\\n  ExtensionAPI,\\n  ExtensionContext,\\n  PiHookHandler,\\n  PiHookName,\\n} from \\\"./pi/types.js\\\";\\nimport type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\\nimport { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\nimport {\\n  detectForkFromSessionTree,\\n  forkInfoFromHook,\\n  seedFork,\\n} from \\\"./lifecycle/fork.js\\\";\\nimport {\\n  parseLaunchFlags,\\n  resolveReloadThread,\\n  resolveThread,\\n  type LaunchFlags,\\n  type ResolveDeps,\\n} from \\\"./lifecycle/thread-resolution.js\\\";\\nimport { pickThread, type ThreadChoice } from \\\"./lifecycle/picker.js\\\";\\nimport { threads } from \\\"lhc\\\";\\nimport { capture, captureGap } from \\\"./capture/converter.js\\\";\\nimport { mapMessage, type MapCtx } from \\\"./capture/map-message.js\\\";\\nimport { mapModelSelect, mapThinkingLevelSelect } from \\\"./capture/runtime-changes.js\\\";\\nimport { TurnAccumulator } from \\\"./capture/turn-accumulator.js\\\";\\nimport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\nexport { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\nexport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n *  registers no handler for it (story Scope Out). */\\nexport const EPIC_1_HOOKS = [\\n  \\\"session_start\\\",\\n  \\\"message_end\\\",\\n  \\\"turn_end\\\",\\n  \\\"agent_end\\\",\\n  \\\"model_select\\\",\\n  \\\"thinking_level_select\\\",\\n  \\\"session_before_fork\\\",\\n  \\\"session_before_switch\\\",\\n  \\\"session_shutdown\\\",\\n] as const satisfies readonly PiHookName[];\\n\\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n\\n/** What the connector needs from the host to run a session. Every dependency\\n *  has a working production default; the overrides exist for test isolation\\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\n *  in the PI-auth-backed inference config.\\n *\\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\n *  default is the observe-only config below (a real, construction-valid SDK);\\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\nexport interface ConnectorDeps {\\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n  registryPath?: string;\\n  newThreadFilePath?: () => string;\\n  parseLaunch?: () => LaunchFlags;\\n  selectThread?: (\\n    choices: readonly ThreadChoice[],\\n    ctx: ExtensionContext,\\n  ) => Promise<string | null>;\\n}\\n\\n/** Everything the connector retains across hooks as PLAIN data — by\\n *  construction structuredClone-able. The live `LhcInstance` is held separately\\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n *  deliberately not part of the snapshot. */\\nexport interface ConnectorSnapshot {\\n  state: SessionState | null;\\n  lastDiagnostic: CaptureFailureDiagnostic | null;\\n}\\n\\nexport interface Connector {\\n  /** Register the observe-only hook rail on the PI extension API. */\\n  register(pi: ExtensionAPI): void;\\n  /** The plain-data state retained across hooks. `null` until a session\\n   *  resolves a thread; never holds a PI ctx. */\\n  getState(): SessionState | null;\\n  /** The live LHC instance for the current session, or `null`. A test/inspection\\n   *  seam — held by the connector but never part of the plain-data snapshot. */\\n  getInstance(): LhcInstance | null;\\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n  snapshot(): ConnectorSnapshot;\\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n   *  synthetic ctx/events without a live PI. */\\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n}\\n\\n/** The connector's live capture state for one session: the open-turn\\n *  accumulator plus the stable PI session id used to scope idempotency keys.\\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\\n *  per session, never part of the plain-data snapshot and never a PI object. */\\ninterface CaptureSession {\\n  piSessionId: string;\\n  accumulator: TurnAccumulator;\\n  sourceSeq: number;\\n}\\n\\n/** Fork state captured from `session_before_fork` and used on the next\\n *  `session_start{fork}` to create and seed the forked thread. Plain data\\n *  only — no PI objects retained across the fork boundary. */\\ninterface PendingFork {\\n  sourceThreadRef: ThreadRef;\\n  forkEntryId: string;\\n}\\n\\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\\n *  identity, which survives reload/replay (the same thread re-resolves to the\\n *  same id). */\\nfunction sessionIdOf(ref: ThreadRef): string {\\n  return \\\"threadId\\\" in ref ? ref.threadId : ref.filePath;\\n}\\n\\nconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n\\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\\n *  whose every operation fails closed (non-retryable) instead of fabricating a\\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\\n *  derivation work is ever queued and this provider is never invoked — it exists\\n *  only to satisfy SDK construction (AC-1.1 \\\"initializes one LHC instance\\\").\\n *\\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\\n *  documents as \\\"selectable only by explicit name — never a production default\\\"\\n *  (it would mark fake derived text into the thread). Failing closed preserves\\n *  the observe-only guarantee even if a future change queued work before Stories\\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\\n *  assignments), which is what a real *completing* inference requires (the\\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\\nfunction observeOnlyProvider(): DerivationProvider {\\n  const notConfigured = (): Promise<ProviderResult> =>\\n    Promise.resolve({\\n      ok: false,\\n      retryable: false,\\n      reason: \\\"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\\\",\\n    });\\n  return {\\n    smoothPrompt: notConfigured,\\n    summarizeToolCall: notConfigured,\\n    summarizeToolResult: notConfigured,\\n    composeTurnRendering: notConfigured,\\n    projectLowerBand: notConfigured,\\n    summarizeChunkDetailed: notConfigured,\\n    summarizeChunkBrief: notConfigured,\\n  };\\n}\\n\\n/** The production observe-only SDK config: a real, construction-valid instance\\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\\n *  config. */\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \\\"background\\\" } };\\n}\\n\\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\\n *  show. */\\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\\n  const lines = choices.map((choice, i) => {\\n    const title = choice.title ?? \\\"(untitled)\\\";\\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\\n  });\\n  return [\\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\\n    ...lines,\\n    \\\"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\\\",\\n  ].join(\\\"\\\\n\\\");\\n}\\n\\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\\n *  interactive input/selection surface (wiring research), so the production\\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\\n *  most recently created thread as the best available explicit default. The\\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\\n *  takes the `select` seam); tests drive an explicit operator choice through it.\\n *  A true interactive picker awaits a PI input surface; until then resuming a\\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\\n *  precise spec deviation. */\\nfunction defaultSelectThread(\\n  choices: readonly ThreadChoice[],\\n  ctx: ExtensionContext,\\n): Promise<string | null> {\\n  const mostRecent = choices.at(-1);\\n  if (mostRecent === undefined) return Promise.resolve(null);\\n  if (ctx.hasUI) {\\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \\\"info\\\" });\\n  }\\n  return Promise.resolve(mostRecent.threadId);\\n}\\n\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n *  generated by the registry at creation, so the file name is just a unique\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\n *  parents). */\\nfunction defaultNewThreadFilePath(): string {\\n  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n  mkdirSync(dir, { recursive: true });\\n  return join(dir, `${randomUUID()}.sqlite`);\\n}\\n\\n/** Build a connector instance. Its mutable state lives in this closure; the\\n *  registered handlers capture it, so the instance stays live for the session\\n *  even when `activate` discards the returned object. The connector holds NO\\n *  module-level or durable state of its own — reload reconstructs the thread from\\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\\n *  closure reattaches correctly (AC-1.5). */\\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\\n  // The connector's retained state. `state` is plain data (the durable thread\\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\\n  // none survives the connector — reload re-resolves from the registry.\\n  let state: SessionState | null = null;\\n  let instance: LhcInstance | null = null;\\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n  let captureSession: CaptureSession | null = null;\\n  let pendingFork: PendingFork | null = null;\\n\\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\n  const selectThread = deps.selectThread ?? defaultSelectThread;\\n\\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\\n    return { code, message, recordedGap: false };\\n  }\\n\\n  // The registry/file deps every resolver path shares. `registryPath` is set\\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\n    return resolveDeps;\\n  }\\n\\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\\n  // no-flag creates).\\n  async function resolveForLaunch(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    if (launch.resume === true) {\\n      const pickerDeps: {\\n        registryPath?: string;\\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n      } = { select: (choices) => selectThread(choices, ctx) };\\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\n      return pickThread(ctx.cwd, pickerDeps);\\n    }\\n    return resolveThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\\n  // instead of re-running the launch — a no-flag launch would otherwise create a\\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\\n  async function resolveReloadFor(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // session_start: resolve the recording thread and construct one background\\n  // instance against it. Config is gated first so a session with no usable\\n  // inference config resolves/creates nothing (no orphan thread). On reload the\\n  // thread is re-resolved from the durable registry (reattach, never create);\\n  // every other reason runs the normal launch resolution. Fork creates a new\\n  // thread and seeds it from the source thread (Story 4).\\n  const onSessionStart: PiHookHandler<\\\"session_start\\\"> = async (ctx, event) => {\\n    const config = buildSdkConfig(ctx);\\n    if (!config.ok) {\\n      lastDiagnostic = diag(\\\"instance_not_configured\\\", config.error.reason);\\n      return;\\n    }\\n\\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\\n    let forkAttempted = false;\\n\\n    // Fork path (Story 4): create a new thread and seed it from the source.\\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\\n    if (pendingFork !== null) {\\n      forkAttempted = true;\\n      // Hook-based fork detection: session_before_fork fired.\\n      const { sourceThreadRef, forkEntryId } = pendingFork;\\n\\n      // Create a new thread for the fork.\\n      const resolveDeps = buildResolveDeps(ctx);\\n      const newFilePath = resolveDeps.newThreadFilePath();\\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n        filePath: newFilePath,\\n        cwd: resolveDeps.cwd,\\n      };\\n      if (resolveDeps.registryPath !== undefined) {\\n        newThreadInput.registryPath = resolveDeps.registryPath;\\n      }\\n      const created = await threads.newThread(newThreadInput);\\n      if (!created.ok) {\\n        lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n        pendingFork = null;\\n        state = null;\\n        captureSession = null;\\n        return;\\n      } else {\\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n        // Initialize the instance against the target thread first (required for seedFork).\\n        const built = await initInstance(targetThreadRef, config.value);\\n        if (!built.ok) {\\n          lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n          pendingFork = null;\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          instance = built.value;\\n\\n          // Seed the fork by replaying source events up to the fork point.\\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n          if (!seeded.ok) {\\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\\n            lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n            pendingFork = null;\\n            await disposeInstance(instance);\\n            instance = null;\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            // Fork succeeded - clear pending fork state and use the forked thread.\\n            pendingFork = null;\\n            resolved = { ok: true, value: targetThreadRef };\\n          }\\n        }\\n      }\\n    }\\n\\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\\n      if (forkFromTree !== null) {\\n        forkAttempted = true;\\n        // Session tree indicates a fork - create and seed as above.\\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\\n\\n        const resolveDeps = buildResolveDeps(ctx);\\n        const newFilePath = resolveDeps.newThreadFilePath();\\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n          filePath: newFilePath,\\n          cwd: resolveDeps.cwd,\\n        };\\n        if (resolveDeps.registryPath !== undefined) {\\n          newThreadInput.registryPath = resolveDeps.registryPath;\\n        }\\n        const created = await threads.newThread(newThreadInput);\\n        if (!created.ok) {\\n          lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n          const built = await initInstance(targetThreadRef, config.value);\\n          if (!built.ok) {\\n            lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            instance = built.value;\\n\\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n            if (!seeded.ok) {\\n              lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n              await disposeInstance(instance);\\n              instance = null;\\n              state = null;\\n              captureSession = null;\\n              return;\\n            } else {\\n              resolved = { ok: true, value: targetThreadRef };\\n            }\\n          }\\n        }\\n      }\\n    }\\n\\n    // Normal launch resolution (if not resolved by fork paths above).\\n    if (resolved === undefined) {\\n      const launch = parseLaunch();\\n      const isReload = event.reason === \\\"reload\\\";\\n      resolved = isReload\\n        ? await resolveReloadFor(launch, ctx)\\n        : await resolveForLaunch(launch, ctx);\\n    }\\n\\n    if (!resolved.ok) {\\n      lastDiagnostic = diag(\\\"thread_resolution_failed\\\", resolved.error.reason);\\n      return;\\n    }\\n    if (resolved.value === null) {\\n      const isReload = event.reason === \\\"reload\\\";\\n      lastDiagnostic = isReload\\n        ? diag(\\\"no_thread_to_reattach\\\", \\\"reload found no thread to reattach for this cwd\\\")\\n        : diag(\\\"no_thread_selected\\\", \\\"--resume resolved no thread\\\");\\n      return;\\n    }\\n\\n    // If instance wasn't created during fork path, create it now.\\n    if (instance === null) {\\n      const built = await initInstance(resolved.value, config.value);\\n      if (!built.ok) {\\n        lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n        return;\\n      }\\n      instance = built.value;\\n    }\\n\\n    state = createSessionState(resolved.value);\\n    const piSessionId = sessionIdOf(resolved.value);\\n    captureSession = {\\n      piSessionId,\\n      accumulator: new TurnAccumulator({ piSessionId }),\\n      sourceSeq: 0,\\n    };\\n  };\\n\\n  // Dispose with flush before any session swap (session_before_switch fires\\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\\n  // re-resolves its thread from the durable registry on the next session_start.\\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\\n    const result = await disposeInstance(instance);\\n    if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n    instance = null;\\n    captureSession = null;\\n  };\\n\\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\\n  // converter already recorded a durable gap for a writable-thread malformed\\n  // event (`invalid_event`); a store-unavailable failure could not, so it\\n  // surfaces as an extension health signal with no gap. Neither path throws.\\n  function recordCaptureOutcome(\\n    result: OpResult<BatchResult>,\\n    events: readonly MessageEventInput[],\\n  ): void {\\n    if (result.ok) return;\\n    const recordedGap = result.error.code === \\\"invalid_event\\\";\\n    const failure: CaptureFailureDiagnostic = {\\n      code: result.error.code,\\n      message: result.error.reason,\\n      recordedGap,\\n    };\\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  function nextSourceSeq(session: CaptureSession): number {\\n    const sourceSeq = session.sourceSeq;\\n    session.sourceSeq += 1;\\n    return sourceSeq;\\n  }\\n\\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\\n    // Last-resort id-less discriminator. PI position wins when present; the\\n    // connector ordinal is used only when PI gives no event identity at all.\\n    // For id-less + position-less reload replay, PI's deterministic redelivery\\n    // order yields the same ordinal, which is the best identity available.\\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\\n  }\\n\\n  async function recordMappingFailure(\\n    hook: string,\\n    position: number | undefined,\\n    sourceSeq: number,\\n    cause: unknown,\\n  ): Promise<void> {\\n    if (instance === null) return;\\n    const message = cause instanceof Error ? cause.message : String(cause);\\n    const result = await captureGap(\\n      fallbackIdFor(hook, position, sourceSeq),\\n      `${hook}: ${message}`,\\n      instance,\\n    );\\n    if (!result.ok) {\\n      recordCaptureOutcome(result, []);\\n      return;\\n    }\\n    const failure: CaptureFailureDiagnostic = {\\n      code: \\\"invalid_event\\\",\\n      message: `${hook}: ${message}`,\\n      recordedGap: true,\\n    };\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  // message_end: map the finalized PI message to ordered LHC events, track the\\n  // open turn, and flush through the converter (AC-2.1).\\n  const onMessageEnd: PiHookHandler<\\\"message_end\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx =\\n      event.entryId !== undefined && event.entryId !== \\\"\\\"\\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\\n        : {\\n            piSessionId: captureSession.piSessionId,\\n            fallbackId: fallbackIdFor(\\\"message_end\\\", event.position, sourceSeq),\\n          };\\n    let events: MessageEventInput[];\\n    try {\\n      events = mapMessage(event.message, mapCtx);\\n    } catch (cause) {\\n      await recordMappingFailure(\\\"message_end\\\", event.position, sourceSeq, cause);\\n      return;\\n    }\\n    captureSession.accumulator.onMessage(events);\\n    if (events.length === 0) return;\\n    recordCaptureOutcome(await capture(events, instance), events);\\n  };\\n\\n  // model_select / thinking_level_select fire only in-stream — capture each as\\n  // an ordered runtime_note the moment it fires (AC-2.8).\\n  const onModelSelect: PiHookHandler<\\\"model_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"model_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapModelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  const onThinkingLevelSelect: PiHookHandler<\\\"thinking_level_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"thinking_level_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapThinkingLevelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\\n  const onAgentEnd: PiHookHandler<\\\"agent_end\\\"> = async () => {\\n    if (instance === null || captureSession === null) return;\\n    const turnEnd = captureSession.accumulator.onAgentEnd();\\n    if (turnEnd.length === 0) return;\\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\\n  };\\n\\n  // Contain every handler: an observe-only hook must never throw back into PI\\n  // (a thrown hook breaks the user's session). A caught error becomes a\\n  // plain-data diagnostic; it is never rethrown.\\n  const guard = (\\n    name: Epic1Hook,\\n    body: PiHookHandler<Epic1Hook>,\\n  ): PiHookHandler<Epic1Hook> => {\\n    return async (ctx, event): Promise<void> => {\\n      try {\\n        await body(ctx, event);\\n      } catch (err) {\\n        lastDiagnostic = {\\n          code: \\\"hook_handler_error\\\",\\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\n          recordedGap: false,\\n        };\\n      }\\n    };\\n  };\\n\\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\\n  const noop: PiHookHandler<Epic1Hook> = () => {\\n    // Intentionally empty — turn_end is ignored as a boundary.\\n  };\\n\\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\\n  // The source thread ref is captured from the current session state; the hook\\n  // provides entryId/position identifying the fork point. No writes to the source\\n  // thread occur — the fork happens on the next session_start (Story 4).\\n  const onBeforeFork: PiHookHandler<\\\"session_before_fork\\\"> = async (_ctx, event) => {\\n    if (state === null) return;\\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\\n    // Store the fork info for use on session_start{fork}.\\n    pendingFork = {\\n      sourceThreadRef: state.threadRef,\\n      forkEntryId: forkInfo.forkEntryId,\\n    };\\n  };\\n\\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\\n  // are live; fork handling (Story 4) is wired.\\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n    session_before_switch: onDispose,\\n    session_shutdown: onDispose,\\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\\n    turn_end: noop,\\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\\n  };\\n\\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\n\\n  return {\\n    handlers,\\n    register(pi: ExtensionAPI): void {\\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\n    },\\n    getState(): SessionState | null {\\n      return state;\\n    },\\n    getInstance(): LhcInstance | null {\\n      return instance;\\n    },\\n    snapshot(): ConnectorSnapshot {\\n      return { state, lastDiagnostic };\\n    },\\n  };\\n}\\n\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\n *  observe-only SDK config, and the `--resume` selector that presents the\\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\\n *  resolves/creates and initializes for real. On `/reload` the connector\\n *  re-resolves the same thread from the durable registry (it keeps no\\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\\n *  config. */\\nexport function activate(pi: ExtensionAPI): void {\\n  createConnector().register(pi);\\n}\\n\\nexport default activate;\\n\",\"structuredPatch\":[{\"oldStart\":15,\"oldLines\":6,\"newStart\":15,\"newLines\":7,\"lines\":[\"   ProviderResult,\",\"   SdkConfig,\",\"   ThreadRef,\",\"+  DEFAULT_PROMPT_NAMES,\",\" } from \\\"lhc\\\";\",\" import type {\",\"   ExtensionAPI,\"]}],\"userModified\":false,\"replaceAll\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:5559:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_b219461a4cec41e5ba348613\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"08641dd2-3b3c-46ad-8f12-ad20d10e3757\",\"timestamp\":\"2026-06-14T12:40:27.466Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\",\"oldString\":\"import { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\",\"newString\":\"import { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\nimport { createModelCall, defaultAssignments } from \\\"./inference/model-call.js\\\";\",\"originalFile\":\"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\n// handler. The connector owns only plain-data `SessionState` plus the live\\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\nimport { mkdirSync } from \\\"node:fs\\\";\\nimport { homedir } from \\\"node:os\\\";\\nimport { join } from \\\"node:path\\\";\\nimport { randomUUID } from \\\"node:crypto\\\";\\nimport type {\\n  BatchResult,\\n  DerivationProvider,\\n  MessageEventInput,\\n  OpResult,\\n  ProviderResult,\\n  SdkConfig,\\n  ThreadRef,\\n  DEFAULT_PROMPT_NAMES,\\n} from \\\"lhc\\\";\\nimport type {\\n  ExtensionAPI,\\n  ExtensionContext,\\n  PiHookHandler,\\n  PiHookName,\\n} from \\\"./pi/types.js\\\";\\nimport type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\\nimport { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\nimport {\\n  detectForkFromSessionTree,\\n  forkInfoFromHook,\\n  seedFork,\\n} from \\\"./lifecycle/fork.js\\\";\\nimport {\\n  parseLaunchFlags,\\n  resolveReloadThread,\\n  resolveThread,\\n  type LaunchFlags,\\n  type ResolveDeps,\\n} from \\\"./lifecycle/thread-resolution.js\\\";\\nimport { pickThread, type ThreadChoice } from \\\"./lifecycle/picker.js\\\";\\nimport { threads } from \\\"lhc\\\";\\nimport { capture, captureGap } from \\\"./capture/converter.js\\\";\\nimport { mapMessage, type MapCtx } from \\\"./capture/map-message.js\\\";\\nimport { mapModelSelect, mapThinkingLevelSelect } from \\\"./capture/runtime-changes.js\\\";\\nimport { TurnAccumulator } from \\\"./capture/turn-accumulator.js\\\";\\nimport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\nexport { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\nexport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n *  registers no handler for it (story Scope Out). */\\nexport const EPIC_1_HOOKS = [\\n  \\\"session_start\\\",\\n  \\\"message_end\\\",\\n  \\\"turn_end\\\",\\n  \\\"agent_end\\\",\\n  \\\"model_select\\\",\\n  \\\"thinking_level_select\\\",\\n  \\\"session_before_fork\\\",\\n  \\\"session_before_switch\\\",\\n  \\\"session_shutdown\\\",\\n] as const satisfies readonly PiHookName[];\\n\\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n\\n/** What the connector needs from the host to run a session. Every dependency\\n *  has a working production default; the overrides exist for test isolation\\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\n *  in the PI-auth-backed inference config.\\n *\\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\n *  default is the observe-only config below (a real, construction-valid SDK);\\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\nexport interface ConnectorDeps {\\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n  registryPath?: string;\\n  newThreadFilePath?: () => string;\\n  parseLaunch?: () => LaunchFlags;\\n  selectThread?: (\\n    choices: readonly ThreadChoice[],\\n    ctx: ExtensionContext,\\n  ) => Promise<string | null>;\\n}\\n\\n/** Everything the connector retains across hooks as PLAIN data — by\\n *  construction structuredClone-able. The live `LhcInstance` is held separately\\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n *  deliberately not part of the snapshot. */\\nexport interface ConnectorSnapshot {\\n  state: SessionState | null;\\n  lastDiagnostic: CaptureFailureDiagnostic | null;\\n}\\n\\nexport interface Connector {\\n  /** Register the observe-only hook rail on the PI extension API. */\\n  register(pi: ExtensionAPI): void;\\n  /** The plain-data state retained across hooks. `null` until a session\\n   *  resolves a thread; never holds a PI ctx. */\\n  getState(): SessionState | null;\\n  /** The live LHC instance for the current session, or `null`. A test/inspection\\n   *  seam — held by the connector but never part of the plain-data snapshot. */\\n  getInstance(): LhcInstance | null;\\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n  snapshot(): ConnectorSnapshot;\\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n   *  synthetic ctx/events without a live PI. */\\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n}\\n\\n/** The connector's live capture state for one session: the open-turn\\n *  accumulator plus the stable PI session id used to scope idempotency keys.\\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\\n *  per session, never part of the plain-data snapshot and never a PI object. */\\ninterface CaptureSession {\\n  piSessionId: string;\\n  accumulator: TurnAccumulator;\\n  sourceSeq: number;\\n}\\n\\n/** Fork state captured from `session_before_fork` and used on the next\\n *  `session_start{fork}` to create and seed the forked thread. Plain data\\n *  only — no PI objects retained across the fork boundary. */\\ninterface PendingFork {\\n  sourceThreadRef: ThreadRef;\\n  forkEntryId: string;\\n}\\n\\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\\n *  identity, which survives reload/replay (the same thread re-resolves to the\\n *  same id). */\\nfunction sessionIdOf(ref: ThreadRef): string {\\n  return \\\"threadId\\\" in ref ? ref.threadId : ref.filePath;\\n}\\n\\nconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n\\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\\n *  whose every operation fails closed (non-retryable) instead of fabricating a\\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\\n *  derivation work is ever queued and this provider is never invoked — it exists\\n *  only to satisfy SDK construction (AC-1.1 \\\"initializes one LHC instance\\\").\\n *\\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\\n *  documents as \\\"selectable only by explicit name — never a production default\\\"\\n *  (it would mark fake derived text into the thread). Failing closed preserves\\n *  the observe-only guarantee even if a future change queued work before Stories\\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\\n *  assignments), which is what a real *completing* inference requires (the\\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\\nfunction observeOnlyProvider(): DerivationProvider {\\n  const notConfigured = (): Promise<ProviderResult> =>\\n    Promise.resolve({\\n      ok: false,\\n      retryable: false,\\n      reason: \\\"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\\\",\\n    });\\n  return {\\n    smoothPrompt: notConfigured,\\n    summarizeToolCall: notConfigured,\\n    summarizeToolResult: notConfigured,\\n    composeTurnRendering: notConfigured,\\n    projectLowerBand: notConfigured,\\n    summarizeChunkDetailed: notConfigured,\\n    summarizeChunkBrief: notConfigured,\\n  };\\n}\\n\\n/** The production observe-only SDK config: a real, construction-valid instance\\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\\n *  config. */\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \\\"background\\\" } };\\n}\\n\\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\\n *  show. */\\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\\n  const lines = choices.map((choice, i) => {\\n    const title = choice.title ?? \\\"(untitled)\\\";\\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\\n  });\\n  return [\\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\\n    ...lines,\\n    \\\"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\\\",\\n  ].join(\\\"\\\\n\\\");\\n}\\n\\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\\n *  interactive input/selection surface (wiring research), so the production\\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\\n *  most recently created thread as the best available explicit default. The\\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\\n *  takes the `select` seam); tests drive an explicit operator choice through it.\\n *  A true interactive picker awaits a PI input surface; until then resuming a\\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\\n *  precise spec deviation. */\\nfunction defaultSelectThread(\\n  choices: readonly ThreadChoice[],\\n  ctx: ExtensionContext,\\n): Promise<string | null> {\\n  const mostRecent = choices.at(-1);\\n  if (mostRecent === undefined) return Promise.resolve(null);\\n  if (ctx.hasUI) {\\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \\\"info\\\" });\\n  }\\n  return Promise.resolve(mostRecent.threadId);\\n}\\n\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n *  generated by the registry at creation, so the file name is just a unique\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\n *  parents). */\\nfunction defaultNewThreadFilePath(): string {\\n  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n  mkdirSync(dir, { recursive: true });\\n  return join(dir, `${randomUUID()}.sqlite`);\\n}\\n\\n/** Build a connector instance. Its mutable state lives in this closure; the\\n *  registered handlers capture it, so the instance stays live for the session\\n *  even when `activate` discards the returned object. The connector holds NO\\n *  module-level or durable state of its own — reload reconstructs the thread from\\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\\n *  closure reattaches correctly (AC-1.5). */\\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\\n  // The connector's retained state. `state` is plain data (the durable thread\\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\\n  // none survives the connector — reload re-resolves from the registry.\\n  let state: SessionState | null = null;\\n  let instance: LhcInstance | null = null;\\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n  let captureSession: CaptureSession | null = null;\\n  let pendingFork: PendingFork | null = null;\\n\\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\n  const selectThread = deps.selectThread ?? defaultSelectThread;\\n\\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\\n    return { code, message, recordedGap: false };\\n  }\\n\\n  // The registry/file deps every resolver path shares. `registryPath` is set\\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\n    return resolveDeps;\\n  }\\n\\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\\n  // no-flag creates).\\n  async function resolveForLaunch(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    if (launch.resume === true) {\\n      const pickerDeps: {\\n        registryPath?: string;\\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n      } = { select: (choices) => selectThread(choices, ctx) };\\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\n      return pickThread(ctx.cwd, pickerDeps);\\n    }\\n    return resolveThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\\n  // instead of re-running the launch — a no-flag launch would otherwise create a\\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\\n  async function resolveReloadFor(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // session_start: resolve the recording thread and construct one background\\n  // instance against it. Config is gated first so a session with no usable\\n  // inference config resolves/creates nothing (no orphan thread). On reload the\\n  // thread is re-resolved from the durable registry (reattach, never create);\\n  // every other reason runs the normal launch resolution. Fork creates a new\\n  // thread and seeds it from the source thread (Story 4).\\n  const onSessionStart: PiHookHandler<\\\"session_start\\\"> = async (ctx, event) => {\\n    const config = buildSdkConfig(ctx);\\n    if (!config.ok) {\\n      lastDiagnostic = diag(\\\"instance_not_configured\\\", config.error.reason);\\n      return;\\n    }\\n\\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\\n    let forkAttempted = false;\\n\\n    // Fork path (Story 4): create a new thread and seed it from the source.\\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\\n    if (pendingFork !== null) {\\n      forkAttempted = true;\\n      // Hook-based fork detection: session_before_fork fired.\\n      const { sourceThreadRef, forkEntryId } = pendingFork;\\n\\n      // Create a new thread for the fork.\\n      const resolveDeps = buildResolveDeps(ctx);\\n      const newFilePath = resolveDeps.newThreadFilePath();\\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n        filePath: newFilePath,\\n        cwd: resolveDeps.cwd,\\n      };\\n      if (resolveDeps.registryPath !== undefined) {\\n        newThreadInput.registryPath = resolveDeps.registryPath;\\n      }\\n      const created = await threads.newThread(newThreadInput);\\n      if (!created.ok) {\\n        lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n        pendingFork = null;\\n        state = null;\\n        captureSession = null;\\n        return;\\n      } else {\\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n        // Initialize the instance against the target thread first (required for seedFork).\\n        const built = await initInstance(targetThreadRef, config.value);\\n        if (!built.ok) {\\n          lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n          pendingFork = null;\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          instance = built.value;\\n\\n          // Seed the fork by replaying source events up to the fork point.\\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n          if (!seeded.ok) {\\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\\n            lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n            pendingFork = null;\\n            await disposeInstance(instance);\\n            instance = null;\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            // Fork succeeded - clear pending fork state and use the forked thread.\\n            pendingFork = null;\\n            resolved = { ok: true, value: targetThreadRef };\\n          }\\n        }\\n      }\\n    }\\n\\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\\n      if (forkFromTree !== null) {\\n        forkAttempted = true;\\n        // Session tree indicates a fork - create and seed as above.\\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\\n\\n        const resolveDeps = buildResolveDeps(ctx);\\n        const newFilePath = resolveDeps.newThreadFilePath();\\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n          filePath: newFilePath,\\n          cwd: resolveDeps.cwd,\\n        };\\n        if (resolveDeps.registryPath !== undefined) {\\n          newThreadInput.registryPath = resolveDeps.registryPath;\\n        }\\n        const created = await threads.newThread(newThreadInput);\\n        if (!created.ok) {\\n          lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n          const built = await initInstance(targetThreadRef, config.value);\\n          if (!built.ok) {\\n            lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            instance = built.value;\\n\\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n            if (!seeded.ok) {\\n              lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n              await disposeInstance(instance);\\n              instance = null;\\n              state = null;\\n              captureSession = null;\\n              return;\\n            } else {\\n              resolved = { ok: true, value: targetThreadRef };\\n            }\\n          }\\n        }\\n      }\\n    }\\n\\n    // Normal launch resolution (if not resolved by fork paths above).\\n    if (resolved === undefined) {\\n      const launch = parseLaunch();\\n      const isReload = event.reason === \\\"reload\\\";\\n      resolved = isReload\\n        ? await resolveReloadFor(launch, ctx)\\n        : await resolveForLaunch(launch, ctx);\\n    }\\n\\n    if (!resolved.ok) {\\n      lastDiagnostic = diag(\\\"thread_resolution_failed\\\", resolved.error.reason);\\n      return;\\n    }\\n    if (resolved.value === null) {\\n      const isReload = event.reason === \\\"reload\\\";\\n      lastDiagnostic = isReload\\n        ? diag(\\\"no_thread_to_reattach\\\", \\\"reload found no thread to reattach for this cwd\\\")\\n        : diag(\\\"no_thread_selected\\\", \\\"--resume resolved no thread\\\");\\n      return;\\n    }\\n\\n    // If instance wasn't created during fork path, create it now.\\n    if (instance === null) {\\n      const built = await initInstance(resolved.value, config.value);\\n      if (!built.ok) {\\n        lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n        return;\\n      }\\n      instance = built.value;\\n    }\\n\\n    state = createSessionState(resolved.value);\\n    const piSessionId = sessionIdOf(resolved.value);\\n    captureSession = {\\n      piSessionId,\\n      accumulator: new TurnAccumulator({ piSessionId }),\\n      sourceSeq: 0,\\n    };\\n  };\\n\\n  // Dispose with flush before any session swap (session_before_switch fires\\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\\n  // re-resolves its thread from the durable registry on the next session_start.\\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\\n    const result = await disposeInstance(instance);\\n    if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n    instance = null;\\n    captureSession = null;\\n  };\\n\\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\\n  // converter already recorded a durable gap for a writable-thread malformed\\n  // event (`invalid_event`); a store-unavailable failure could not, so it\\n  // surfaces as an extension health signal with no gap. Neither path throws.\\n  function recordCaptureOutcome(\\n    result: OpResult<BatchResult>,\\n    events: readonly MessageEventInput[],\\n  ): void {\\n    if (result.ok) return;\\n    const recordedGap = result.error.code === \\\"invalid_event\\\";\\n    const failure: CaptureFailureDiagnostic = {\\n      code: result.error.code,\\n      message: result.error.reason,\\n      recordedGap,\\n    };\\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  function nextSourceSeq(session: CaptureSession): number {\\n    const sourceSeq = session.sourceSeq;\\n    session.sourceSeq += 1;\\n    return sourceSeq;\\n  }\\n\\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\\n    // Last-resort id-less discriminator. PI position wins when present; the\\n    // connector ordinal is used only when PI gives no event identity at all.\\n    // For id-less + position-less reload replay, PI's deterministic redelivery\\n    // order yields the same ordinal, which is the best identity available.\\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\\n  }\\n\\n  async function recordMappingFailure(\\n    hook: string,\\n    position: number | undefined,\\n    sourceSeq: number,\\n    cause: unknown,\\n  ): Promise<void> {\\n    if (instance === null) return;\\n    const message = cause instanceof Error ? cause.message : String(cause);\\n    const result = await captureGap(\\n      fallbackIdFor(hook, position, sourceSeq),\\n      `${hook}: ${message}`,\\n      instance,\\n    );\\n    if (!result.ok) {\\n      recordCaptureOutcome(result, []);\\n      return;\\n    }\\n    const failure: CaptureFailureDiagnostic = {\\n      code: \\\"invalid_event\\\",\\n      message: `${hook}: ${message}`,\\n      recordedGap: true,\\n    };\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  // message_end: map the finalized PI message to ordered LHC events, track the\\n  // open turn, and flush through the converter (AC-2.1).\\n  const onMessageEnd: PiHookHandler<\\\"message_end\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx =\\n      event.entryId !== undefined && event.entryId !== \\\"\\\"\\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\\n        : {\\n            piSessionId: captureSession.piSessionId,\\n            fallbackId: fallbackIdFor(\\\"message_end\\\", event.position, sourceSeq),\\n          };\\n    let events: MessageEventInput[];\\n    try {\\n      events = mapMessage(event.message, mapCtx);\\n    } catch (cause) {\\n      await recordMappingFailure(\\\"message_end\\\", event.position, sourceSeq, cause);\\n      return;\\n    }\\n    captureSession.accumulator.onMessage(events);\\n    if (events.length === 0) return;\\n    recordCaptureOutcome(await capture(events, instance), events);\\n  };\\n\\n  // model_select / thinking_level_select fire only in-stream — capture each as\\n  // an ordered runtime_note the moment it fires (AC-2.8).\\n  const onModelSelect: PiHookHandler<\\\"model_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"model_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapModelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  const onThinkingLevelSelect: PiHookHandler<\\\"thinking_level_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"thinking_level_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapThinkingLevelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\\n  const onAgentEnd: PiHookHandler<\\\"agent_end\\\"> = async () => {\\n    if (instance === null || captureSession === null) return;\\n    const turnEnd = captureSession.accumulator.onAgentEnd();\\n    if (turnEnd.length === 0) return;\\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\\n  };\\n\\n  // Contain every handler: an observe-only hook must never throw back into PI\\n  // (a thrown hook breaks the user's session). A caught error becomes a\\n  // plain-data diagnostic; it is never rethrown.\\n  const guard = (\\n    name: Epic1Hook,\\n    body: PiHookHandler<Epic1Hook>,\\n  ): PiHookHandler<Epic1Hook> => {\\n    return async (ctx, event): Promise<void> => {\\n      try {\\n        await body(ctx, event);\\n      } catch (err) {\\n        lastDiagnostic = {\\n          code: \\\"hook_handler_error\\\",\\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\n          recordedGap: false,\\n        };\\n      }\\n    };\\n  };\\n\\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\\n  const noop: PiHookHandler<Epic1Hook> = () => {\\n    // Intentionally empty — turn_end is ignored as a boundary.\\n  };\\n\\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\\n  // The source thread ref is captured from the current session state; the hook\\n  // provides entryId/position identifying the fork point. No writes to the source\\n  // thread occur — the fork happens on the next session_start (Story 4).\\n  const onBeforeFork: PiHookHandler<\\\"session_before_fork\\\"> = async (_ctx, event) => {\\n    if (state === null) return;\\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\\n    // Store the fork info for use on session_start{fork}.\\n    pendingFork = {\\n      sourceThreadRef: state.threadRef,\\n      forkEntryId: forkInfo.forkEntryId,\\n    };\\n  };\\n\\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\\n  // are live; fork handling (Story 4) is wired.\\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n    session_before_switch: onDispose,\\n    session_shutdown: onDispose,\\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\\n    turn_end: noop,\\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\\n  };\\n\\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\n\\n  return {\\n    handlers,\\n    register(pi: ExtensionAPI): void {\\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\n    },\\n    getState(): SessionState | null {\\n      return state;\\n    },\\n    getInstance(): LhcInstance | null {\\n      return instance;\\n    },\\n    snapshot(): ConnectorSnapshot {\\n      return { state, lastDiagnostic };\\n    },\\n  };\\n}\\n\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\n *  observe-only SDK config, and the `--resume` selector that presents the\\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\\n *  resolves/creates and initializes for real. On `/reload` the connector\\n *  re-resolves the same thread from the durable registry (it keeps no\\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\\n *  config. */\\nexport function activate(pi: ExtensionAPI): void {\\n  createConnector().register(pi);\\n}\\n\\nexport default activate;\\n\",\"structuredPatch\":[{\"oldStart\":26,\"oldLines\":6,\"newStart\":26,\"newLines\":7,\"lines\":[\" import type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\",\" import { createSessionState } from \\\"./lifecycle/state.js\\\";\",\" import { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\",\"+import { createModelCall, defaultAssignments } from \\\"./inference/model-call.js\\\";\",\" import {\",\"   detectForkFromSessionTree,\",\"   forkInfoFromHook,\"]}],\"userModified\":false,\"replaceAll\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:5909:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\" deterministic\"}},\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"parent_tool_use_id\":null,\"uuid\":\"13020b2d-2563-4142-b79a-40982a945e1a\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:6056:{\"type\":\"assistant\",\"message\":{\"id\":\"msg_20260614204032453f1e46fee748bf\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"glm-4.7\",\"content\":[{\"type\":\"tool_use\",\"id\":\"call_8a3e5051d73249f59bacdf3d\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\",\"old_string\":\"/** The production observe-only SDK config: a real, construction-valid instance\\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\\n *  config. */\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \\\"background\\\" } };\\n}\",\"new_string\":\"/** The production SDK config for Story 5+: uses the ModelCall function\\n *  that resolves (provider, model) through PI's registry and auth, with\\n *  deterministic completion output. Stories 5/6 can override this default\\n *  by providing their own buildSdkConfig to createConnector. */\\nfunction defaultBuildSdkConfig(ctx: ExtensionContext): OpResult<SdkConfig> {\\n  // Import DEFAULT_PROMPT_NAMES dynamically to avoid circular dependency\\n  // (the value is exported from lhc but needed only at config construction time)\\n  const { DEFAULT_PROMPT_NAMES: promptNames } = require(\\\"lhc\\\");\\n\\n  return {\\n    ok: true,\\n    value: {\\n      inference: {\\n        call: createModelCall(ctx),\\n        assignments: defaultAssignments(promptNames),\\n        mode: \\\"background\\\",\\n      },\\n      mode: \\\"background\\\",\\n    },\\n  };\\n}\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"output_tokens\":0},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"ee2da889-e49e-41ad-becf-5a4a2d48ee54\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:6060:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_8a3e5051d73249f59bacdf3d\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"a4133ff5-e0a3-4bd6-9aeb-0f9d1a5983a6\",\"timestamp\":\"2026-06-14T12:40:36.664Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\",\"oldString\":\"/** The production observe-only SDK config: a real, construction-valid instance\\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\\n *  config. */\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \\\"background\\\" } };\\n}\",\"newString\":\"/** The production SDK config for Story 5+: uses the ModelCall function\\n *  that resolves (provider, model) through PI's registry and auth, with\\n *  deterministic completion output. Stories 5/6 can override this default\\n *  by providing their own buildSdkConfig to createConnector. */\\nfunction defaultBuildSdkConfig(ctx: ExtensionContext): OpResult<SdkConfig> {\\n  // Import DEFAULT_PROMPT_NAMES dynamically to avoid circular dependency\\n  // (the value is exported from lhc but needed only at config construction time)\\n  const { DEFAULT_PROMPT_NAMES: promptNames } = require(\\\"lhc\\\");\\n\\n  return {\\n    ok: true,\\n    value: {\\n      inference: {\\n        call: createModelCall(ctx),\\n        assignments: defaultAssignments(promptNames),\\n        mode: \\\"background\\\",\\n      },\\n      mode: \\\"background\\\",\\n    },\\n  };\\n}\",\"originalFile\":\"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\n// handler. The connector owns only plain-data `SessionState` plus the live\\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\nimport { mkdirSync } from \\\"node:fs\\\";\\nimport { homedir } from \\\"node:os\\\";\\nimport { join } from \\\"node:path\\\";\\nimport { randomUUID } from \\\"node:crypto\\\";\\nimport type {\\n  BatchResult,\\n  DerivationProvider,\\n  MessageEventInput,\\n  OpResult,\\n  ProviderResult,\\n  SdkConfig,\\n  ThreadRef,\\n  DEFAULT_PROMPT_NAMES,\\n} from \\\"lhc\\\";\\nimport type {\\n  ExtensionAPI,\\n  ExtensionContext,\\n  PiHookHandler,\\n  PiHookName,\\n} from \\\"./pi/types.js\\\";\\nimport type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\\nimport { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\nimport { createModelCall, defaultAssignments } from \\\"./inference/model-call.js\\\";\\nimport {\\n  detectForkFromSessionTree,\\n  forkInfoFromHook,\\n  seedFork,\\n} from \\\"./lifecycle/fork.js\\\";\\nimport {\\n  parseLaunchFlags,\\n  resolveReloadThread,\\n  resolveThread,\\n  type LaunchFlags,\\n  type ResolveDeps,\\n} from \\\"./lifecycle/thread-resolution.js\\\";\\nimport { pickThread, type ThreadChoice } from \\\"./lifecycle/picker.js\\\";\\nimport { threads } from \\\"lhc\\\";\\nimport { capture, captureGap } from \\\"./capture/converter.js\\\";\\nimport { mapMessage, type MapCtx } from \\\"./capture/map-message.js\\\";\\nimport { mapModelSelect, mapThinkingLevelSelect } from \\\"./capture/runtime-changes.js\\\";\\nimport { TurnAccumulator } from \\\"./capture/turn-accumulator.js\\\";\\nimport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\nexport { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\nexport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n *  registers no handler for it (story Scope Out). */\\nexport const EPIC_1_HOOKS = [\\n  \\\"session_start\\\",\\n  \\\"message_end\\\",\\n  \\\"turn_end\\\",\\n  \\\"agent_end\\\",\\n  \\\"model_select\\\",\\n  \\\"thinking_level_select\\\",\\n  \\\"session_before_fork\\\",\\n  \\\"session_before_switch\\\",\\n  \\\"session_shutdown\\\",\\n] as const satisfies readonly PiHookName[];\\n\\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n\\n/** What the connector needs from the host to run a session. Every dependency\\n *  has a working production default; the overrides exist for test isolation\\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\n *  in the PI-auth-backed inference config.\\n *\\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\n *  default is the observe-only config below (a real, construction-valid SDK);\\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\nexport interface ConnectorDeps {\\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n  registryPath?: string;\\n  newThreadFilePath?: () => string;\\n  parseLaunch?: () => LaunchFlags;\\n  selectThread?: (\\n    choices: readonly ThreadChoice[],\\n    ctx: ExtensionContext,\\n  ) => Promise<string | null>;\\n}\\n\\n/** Everything the connector retains across hooks as PLAIN data — by\\n *  construction structuredClone-able. The live `LhcInstance` is held separately\\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n *  deliberately not part of the snapshot. */\\nexport interface ConnectorSnapshot {\\n  state: SessionState | null;\\n  lastDiagnostic: CaptureFailureDiagnostic | null;\\n}\\n\\nexport interface Connector {\\n  /** Register the observe-only hook rail on the PI extension API. */\\n  register(pi: ExtensionAPI): void;\\n  /** The plain-data state retained across hooks. `null` until a session\\n   *  resolves a thread; never holds a PI ctx. */\\n  getState(): SessionState | null;\\n  /** The live LHC instance for the current session, or `null`. A test/inspection\\n   *  seam — held by the connector but never part of the plain-data snapshot. */\\n  getInstance(): LhcInstance | null;\\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n  snapshot(): ConnectorSnapshot;\\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n   *  synthetic ctx/events without a live PI. */\\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n}\\n\\n/** The connector's live capture state for one session: the open-turn\\n *  accumulator plus the stable PI session id used to scope idempotency keys.\\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\\n *  per session, never part of the plain-data snapshot and never a PI object. */\\ninterface CaptureSession {\\n  piSessionId: string;\\n  accumulator: TurnAccumulator;\\n  sourceSeq: number;\\n}\\n\\n/** Fork state captured from `session_before_fork` and used on the next\\n *  `session_start{fork}` to create and seed the forked thread. Plain data\\n *  only — no PI objects retained across the fork boundary. */\\ninterface PendingFork {\\n  sourceThreadRef: ThreadRef;\\n  forkEntryId: string;\\n}\\n\\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\\n *  identity, which survives reload/replay (the same thread re-resolves to the\\n *  same id). */\\nfunction sessionIdOf(ref: ThreadRef): string {\\n  return \\\"threadId\\\" in ref ? ref.threadId : ref.filePath;\\n}\\n\\nconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n\\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\\n *  whose every operation fails closed (non-retryable) instead of fabricating a\\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\\n *  derivation work is ever queued and this provider is never invoked — it exists\\n *  only to satisfy SDK construction (AC-1.1 \\\"initializes one LHC instance\\\").\\n *\\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\\n *  documents as \\\"selectable only by explicit name — never a production default\\\"\\n *  (it would mark fake derived text into the thread). Failing closed preserves\\n *  the observe-only guarantee even if a future change queued work before Stories\\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\\n *  assignments), which is what a real *completing* inference requires (the\\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\\nfunction observeOnlyProvider(): DerivationProvider {\\n  const notConfigured = (): Promise<ProviderResult> =>\\n    Promise.resolve({\\n      ok: false,\\n      retryable: false,\\n      reason: \\\"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\\\",\\n    });\\n  return {\\n    smoothPrompt: notConfigured,\\n    summarizeToolCall: notConfigured,\\n    summarizeToolResult: notConfigured,\\n    composeTurnRendering: notConfigured,\\n    projectLowerBand: notConfigured,\\n    summarizeChunkDetailed: notConfigured,\\n    summarizeChunkBrief: notConfigured,\\n  };\\n}\\n\\n/** The production observe-only SDK config: a real, construction-valid instance\\n *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\\n *  above. Stories 5/6 replace this default with the PI-auth-backed inference\\n *  config. */\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n  return { ok: true, value: { provider: observeOnlyProvider(), mode: \\\"background\\\" } };\\n}\\n\\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\\n *  show. */\\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\\n  const lines = choices.map((choice, i) => {\\n    const title = choice.title ?? \\\"(untitled)\\\";\\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\\n  });\\n  return [\\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\\n    ...lines,\\n    \\\"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\\\",\\n  ].join(\\\"\\\\n\\\");\\n}\\n\\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\\n *  interactive input/selection surface (wiring research), so the production\\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\\n *  most recently created thread as the best available explicit default. The\\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\\n *  takes the `select` seam); tests drive an explicit operator choice through it.\\n *  A true interactive picker awaits a PI input surface; until then resuming a\\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\\n *  precise spec deviation. */\\nfunction defaultSelectThread(\\n  choices: readonly ThreadChoice[],\\n  ctx: ExtensionContext,\\n): Promise<string | null> {\\n  const mostRecent = choices.at(-1);\\n  if (mostRecent === undefined) return Promise.resolve(null);\\n  if (ctx.hasUI) {\\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \\\"info\\\" });\\n  }\\n  return Promise.resolve(mostRecent.threadId);\\n}\\n\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n *  generated by the registry at creation, so the file name is just a unique\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\n *  parents). */\\nfunction defaultNewThreadFilePath(): string {\\n  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n  mkdirSync(dir, { recursive: true });\\n  return join(dir, `${randomUUID()}.sqlite`);\\n}\\n\\n/** Build a connector instance. Its mutable state lives in this closure; the\\n *  registered handlers capture it, so the instance stays live for the session\\n *  even when `activate` discards the returned object. The connector holds NO\\n *  module-level or durable state of its own — reload reconstructs the thread from\\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\\n *  closure reattaches correctly (AC-1.5). */\\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\\n  // The connector's retained state. `state` is plain data (the durable thread\\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\\n  // none survives the connector — reload re-resolves from the registry.\\n  let state: SessionState | null = null;\\n  let instance: LhcInstance | null = null;\\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n  let captureSession: CaptureSession | null = null;\\n  let pendingFork: PendingFork | null = null;\\n\\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\n  const selectThread = deps.selectThread ?? defaultSelectThread;\\n\\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\\n    return { code, message, recordedGap: false };\\n  }\\n\\n  // The registry/file deps every resolver path shares. `registryPath` is set\\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\n    return resolveDeps;\\n  }\\n\\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\\n  // no-flag creates).\\n  async function resolveForLaunch(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    if (launch.resume === true) {\\n      const pickerDeps: {\\n        registryPath?: string;\\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n      } = { select: (choices) => selectThread(choices, ctx) };\\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\n      return pickThread(ctx.cwd, pickerDeps);\\n    }\\n    return resolveThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\\n  // instead of re-running the launch — a no-flag launch would otherwise create a\\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\\n  async function resolveReloadFor(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // session_start: resolve the recording thread and construct one background\\n  // instance against it. Config is gated first so a session with no usable\\n  // inference config resolves/creates nothing (no orphan thread). On reload the\\n  // thread is re-resolved from the durable registry (reattach, never create);\\n  // every other reason runs the normal launch resolution. Fork creates a new\\n  // thread and seeds it from the source thread (Story 4).\\n  const onSessionStart: PiHookHandler<\\\"session_start\\\"> = async (ctx, event) => {\\n    const config = buildSdkConfig(ctx);\\n    if (!config.ok) {\\n      lastDiagnostic = diag(\\\"instance_not_configured\\\", config.error.reason);\\n      return;\\n    }\\n\\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\\n    let forkAttempted = false;\\n\\n    // Fork path (Story 4): create a new thread and seed it from the source.\\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\\n    if (pendingFork !== null) {\\n      forkAttempted = true;\\n      // Hook-based fork detection: session_before_fork fired.\\n      const { sourceThreadRef, forkEntryId } = pendingFork;\\n\\n      // Create a new thread for the fork.\\n      const resolveDeps = buildResolveDeps(ctx);\\n      const newFilePath = resolveDeps.newThreadFilePath();\\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n        filePath: newFilePath,\\n        cwd: resolveDeps.cwd,\\n      };\\n      if (resolveDeps.registryPath !== undefined) {\\n        newThreadInput.registryPath = resolveDeps.registryPath;\\n      }\\n      const created = await threads.newThread(newThreadInput);\\n      if (!created.ok) {\\n        lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n        pendingFork = null;\\n        state = null;\\n        captureSession = null;\\n        return;\\n      } else {\\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n        // Initialize the instance against the target thread first (required for seedFork).\\n        const built = await initInstance(targetThreadRef, config.value);\\n        if (!built.ok) {\\n          lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n          pendingFork = null;\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          instance = built.value;\\n\\n          // Seed the fork by replaying source events up to the fork point.\\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n          if (!seeded.ok) {\\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\\n            lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n            pendingFork = null;\\n            await disposeInstance(instance);\\n            instance = null;\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            // Fork succeeded - clear pending fork state and use the forked thread.\\n            pendingFork = null;\\n            resolved = { ok: true, value: targetThreadRef };\\n          }\\n        }\\n      }\\n    }\\n\\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\\n      if (forkFromTree !== null) {\\n        forkAttempted = true;\\n        // Session tree indicates a fork - create and seed as above.\\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\\n\\n        const resolveDeps = buildResolveDeps(ctx);\\n        const newFilePath = resolveDeps.newThreadFilePath();\\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n          filePath: newFilePath,\\n          cwd: resolveDeps.cwd,\\n        };\\n        if (resolveDeps.registryPath !== undefined) {\\n          newThreadInput.registryPath = resolveDeps.registryPath;\\n        }\\n        const created = await threads.newThread(newThreadInput);\\n        if (!created.ok) {\\n          lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n          const built = await initInstance(targetThreadRef, config.value);\\n          if (!built.ok) {\\n            lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            instance = built.value;\\n\\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n            if (!seeded.ok) {\\n              lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n              await disposeInstance(instance);\\n              instance = null;\\n              state = null;\\n              captureSession = null;\\n              return;\\n            } else {\\n              resolved = { ok: true, value: targetThreadRef };\\n            }\\n          }\\n        }\\n      }\\n    }\\n\\n    // Normal launch resolution (if not resolved by fork paths above).\\n    if (resolved === undefined) {\\n      const launch = parseLaunch();\\n      const isReload = event.reason === \\\"reload\\\";\\n      resolved = isReload\\n        ? await resolveReloadFor(launch, ctx)\\n        : await resolveForLaunch(launch, ctx);\\n    }\\n\\n    if (!resolved.ok) {\\n      lastDiagnostic = diag(\\\"thread_resolution_failed\\\", resolved.error.reason);\\n      return;\\n    }\\n    if (resolved.value === null) {\\n      const isReload = event.reason === \\\"reload\\\";\\n      lastDiagnostic = isReload\\n        ? diag(\\\"no_thread_to_reattach\\\", \\\"reload found no thread to reattach for this cwd\\\")\\n        : diag(\\\"no_thread_selected\\\", \\\"--resume resolved no thread\\\");\\n      return;\\n    }\\n\\n    // If instance wasn't created during fork path, create it now.\\n    if (instance === null) {\\n      const built = await initInstance(resolved.value, config.value);\\n      if (!built.ok) {\\n        lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n        return;\\n      }\\n      instance = built.value;\\n    }\\n\\n    state = createSessionState(resolved.value);\\n    const piSessionId = sessionIdOf(resolved.value);\\n    captureSession = {\\n      piSessionId,\\n      accumulator: new TurnAccumulator({ piSessionId }),\\n      sourceSeq: 0,\\n    };\\n  };\\n\\n  // Dispose with flush before any session swap (session_before_switch fires\\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\\n  // re-resolves its thread from the durable registry on the next session_start.\\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\\n    const result = await disposeInstance(instance);\\n    if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n    instance = null;\\n    captureSession = null;\\n  };\\n\\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\\n  // converter already recorded a durable gap for a writable-thread malformed\\n  // event (`invalid_event`); a store-unavailable failure could not, so it\\n  // surfaces as an extension health signal with no gap. Neither path throws.\\n  function recordCaptureOutcome(\\n    result: OpResult<BatchResult>,\\n    events: readonly MessageEventInput[],\\n  ): void {\\n    if (result.ok) return;\\n    const recordedGap = result.error.code === \\\"invalid_event\\\";\\n    const failure: CaptureFailureDiagnostic = {\\n      code: result.error.code,\\n      message: result.error.reason,\\n      recordedGap,\\n    };\\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  function nextSourceSeq(session: CaptureSession): number {\\n    const sourceSeq = session.sourceSeq;\\n    session.sourceSeq += 1;\\n    return sourceSeq;\\n  }\\n\\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\\n    // Last-resort id-less discriminator. PI position wins when present; the\\n    // connector ordinal is used only when PI gives no event identity at all.\\n    // For id-less + position-less reload replay, PI's deterministic redelivery\\n    // order yields the same ordinal, which is the best identity available.\\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\\n  }\\n\\n  async function recordMappingFailure(\\n    hook: string,\\n    position: number | undefined,\\n    sourceSeq: number,\\n    cause: unknown,\\n  ): Promise<void> {\\n    if (instance === null) return;\\n    const message = cause instanceof Error ? cause.message : String(cause);\\n    const result = await captureGap(\\n      fallbackIdFor(hook, position, sourceSeq),\\n      `${hook}: ${message}`,\\n      instance,\\n    );\\n    if (!result.ok) {\\n      recordCaptureOutcome(result, []);\\n      return;\\n    }\\n    const failure: CaptureFailureDiagnostic = {\\n      code: \\\"invalid_event\\\",\\n      message: `${hook}: ${message}`,\\n      recordedGap: true,\\n    };\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  // message_end: map the finalized PI message to ordered LHC events, track the\\n  // open turn, and flush through the converter (AC-2.1).\\n  const onMessageEnd: PiHookHandler<\\\"message_end\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx =\\n      event.entryId !== undefined && event.entryId !== \\\"\\\"\\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\\n        : {\\n            piSessionId: captureSession.piSessionId,\\n            fallbackId: fallbackIdFor(\\\"message_end\\\", event.position, sourceSeq),\\n          };\\n    let events: MessageEventInput[];\\n    try {\\n      events = mapMessage(event.message, mapCtx);\\n    } catch (cause) {\\n      await recordMappingFailure(\\\"message_end\\\", event.position, sourceSeq, cause);\\n      return;\\n    }\\n    captureSession.accumulator.onMessage(events);\\n    if (events.length === 0) return;\\n    recordCaptureOutcome(await capture(events, instance), events);\\n  };\\n\\n  // model_select / thinking_level_select fire only in-stream — capture each as\\n  // an ordered runtime_note the moment it fires (AC-2.8).\\n  const onModelSelect: PiHookHandler<\\\"model_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"model_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapModelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  const onThinkingLevelSelect: PiHookHandler<\\\"thinking_level_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"thinking_level_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapThinkingLevelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\\n  const onAgentEnd: PiHookHandler<\\\"agent_end\\\"> = async () => {\\n    if (instance === null || captureSession === null) return;\\n    const turnEnd = captureSession.accumulator.onAgentEnd();\\n    if (turnEnd.length === 0) return;\\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\\n  };\\n\\n  // Contain every handler: an observe-only hook must never throw back into PI\\n  // (a thrown hook breaks the user's session). A caught error becomes a\\n  // plain-data diagnostic; it is never rethrown.\\n  const guard = (\\n    name: Epic1Hook,\\n    body: PiHookHandler<Epic1Hook>,\\n  ): PiHookHandler<Epic1Hook> => {\\n    return async (ctx, event): Promise<void> => {\\n      try {\\n        await body(ctx, event);\\n      } catch (err) {\\n        lastDiagnostic = {\\n          code: \\\"hook_handler_error\\\",\\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\n          recordedGap: false,\\n        };\\n      }\\n    };\\n  };\\n\\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\\n  const noop: PiHookHandler<Epic1Hook> = () => {\\n    // Intentionally empty — turn_end is ignored as a boundary.\\n  };\\n\\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\\n  // The source thread ref is captured from the current session state; the hook\\n  // provides entryId/position identifying the fork point. No writes to the source\\n  // thread occur — the fork happens on the next session_start (Story 4).\\n  const onBeforeFork: PiHookHandler<\\\"session_before_fork\\\"> = async (_ctx, event) => {\\n    if (state === null) return;\\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\\n    // Store the fork info for use on session_start{fork}.\\n    pendingFork = {\\n      sourceThreadRef: state.threadRef,\\n      forkEntryId: forkInfo.forkEntryId,\\n    };\\n  };\\n\\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\\n  // are live; fork handling (Story 4) is wired.\\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n    session_before_switch: onDispose,\\n    session_shutdown: onDispose,\\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\\n    turn_end: noop,\\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\\n  };\\n\\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\n\\n  return {\\n    handlers,\\n    register(pi: ExtensionAPI): void {\\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\n    },\\n    getState(): SessionState | null {\\n      return state;\\n    },\\n    getInstance(): LhcInstance | null {\\n      return instance;\\n    },\\n    snapshot(): ConnectorSnapshot {\\n      return { state, lastDiagnostic };\\n    },\\n  };\\n}\\n\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\n *  observe-only SDK config, and the `--resume` selector that presents the\\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\\n *  resolves/creates and initializes for real. On `/reload` the connector\\n *  re-resolves the same thread from the durable registry (it keeps no\\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\\n *  config. */\\nexport function activate(pi: ExtensionAPI): void {\\n  createConnector().register(pi);\\n}\\n\\nexport default activate;\\n\",\"structuredPatch\":[{\"oldStart\":170,\"oldLines\":12,\"newStart\":170,\"newLines\":26,\"lines\":[\"   };\",\" }\",\" \",\"-/** The production observe-only SDK config: a real, construction-valid instance\",\"- *  in background scheduler mode, built on the fail-closed `observeOnlyProvider`\",\"- *  above. Stories 5/6 replace this default with the PI-auth-backed inference\",\"- *  config. */\",\"-function defaultBuildSdkConfig(): OpResult<SdkConfig> {\",\"-  return { ok: true, value: { provider: observeOnlyProvider(), mode: \\\"background\\\" } };\",\"+/** The production SDK config for Story 5+: uses the ModelCall function\",\"+ *  that resolves (provider, model) through PI's registry and auth, with\",\"+ *  deterministic completion output. Stories 5/6 can override this default\",\"+ *  by providing their own buildSdkConfig to createConnector. */\",\"+function defaultBuildSdkConfig(ctx: ExtensionContext): OpResult<SdkConfig> {\",\"+  // Import DEFAULT_PROMPT_NAMES dynamically to avoid circular dependency\",\"+  // (the value is exported from lhc but needed only at config construction time)\",\"+  const { DEFAULT_PROMPT_NAMES: promptNames } = require(\\\"lhc\\\");\",\"+\",\"+  return {\",\"+    ok: true,\",\"+    value: {\",\"+      inference: {\",\"+        call: createModelCall(ctx),\",\"+        assignments: defaultAssignments(promptNames),\",\"+        mode: \\\"background\\\",\",\"+      },\",\"+      mode: \\\"background\\\",\",\"+    },\",\"+  };\",\" }\",\" \",\" /** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\"]}],\"userModified\":false,\"replaceAll\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:6379:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_55c351e6cb464363843f590f\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"57cddee1-c6c3-4dd5-923a-4ec84d21ca6a\",\"timestamp\":\"2026-06-14T12:40:45.324Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\",\"oldString\":\"  return {\\n    ok: true,\\n    value: {\\n      inference: {\\n        call: createModelCall(ctx),\\n        assignments: defaultAssignments(promptNames),\\n        mode: \\\"background\\\",\\n      },\\n      mode: \\\"background\\\",\\n    },\\n  };\\n}\",\"newString\":\"  return {\\n    ok: true,\\n    value: {\\n      inference: {\\n        call: createModelCall(ctx),\\n        assignments: defaultAssignments(promptNames),\\n      },\\n      mode: \\\"background\\\",\\n    },\\n  };\\n}\",\"originalFile\":\"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\n// handler. The connector owns only plain-data `SessionState` plus the live\\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\nimport { mkdirSync } from \\\"node:fs\\\";\\nimport { homedir } from \\\"node:os\\\";\\nimport { join } from \\\"node:path\\\";\\nimport { randomUUID } from \\\"node:crypto\\\";\\nimport type {\\n  BatchResult,\\n  DerivationProvider,\\n  MessageEventInput,\\n  OpResult,\\n  ProviderResult,\\n  SdkConfig,\\n  ThreadRef,\\n  DEFAULT_PROMPT_NAMES,\\n} from \\\"lhc\\\";\\nimport type {\\n  ExtensionAPI,\\n  ExtensionContext,\\n  PiHookHandler,\\n  PiHookName,\\n} from \\\"./pi/types.js\\\";\\nimport type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\\nimport { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\nimport { createModelCall, defaultAssignments } from \\\"./inference/model-call.js\\\";\\nimport {\\n  detectForkFromSessionTree,\\n  forkInfoFromHook,\\n  seedFork,\\n} from \\\"./lifecycle/fork.js\\\";\\nimport {\\n  parseLaunchFlags,\\n  resolveReloadThread,\\n  resolveThread,\\n  type LaunchFlags,\\n  type ResolveDeps,\\n} from \\\"./lifecycle/thread-resolution.js\\\";\\nimport { pickThread, type ThreadChoice } from \\\"./lifecycle/picker.js\\\";\\nimport { threads } from \\\"lhc\\\";\\nimport { capture, captureGap } from \\\"./capture/converter.js\\\";\\nimport { mapMessage, type MapCtx } from \\\"./capture/map-message.js\\\";\\nimport { mapModelSelect, mapThinkingLevelSelect } from \\\"./capture/runtime-changes.js\\\";\\nimport { TurnAccumulator } from \\\"./capture/turn-accumulator.js\\\";\\nimport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\nexport { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\nexport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n *  registers no handler for it (story Scope Out). */\\nexport const EPIC_1_HOOKS = [\\n  \\\"session_start\\\",\\n  \\\"message_end\\\",\\n  \\\"turn_end\\\",\\n  \\\"agent_end\\\",\\n  \\\"model_select\\\",\\n  \\\"thinking_level_select\\\",\\n  \\\"session_before_fork\\\",\\n  \\\"session_before_switch\\\",\\n  \\\"session_shutdown\\\",\\n] as const satisfies readonly PiHookName[];\\n\\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n\\n/** What the connector needs from the host to run a session. Every dependency\\n *  has a working production default; the overrides exist for test isolation\\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\n *  in the PI-auth-backed inference config.\\n *\\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\n *  default is the observe-only config below (a real, construction-valid SDK);\\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\nexport interface ConnectorDeps {\\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n  registryPath?: string;\\n  newThreadFilePath?: () => string;\\n  parseLaunch?: () => LaunchFlags;\\n  selectThread?: (\\n    choices: readonly ThreadChoice[],\\n    ctx: ExtensionContext,\\n  ) => Promise<string | null>;\\n}\\n\\n/** Everything the connector retains across hooks as PLAIN data — by\\n *  construction structuredClone-able. The live `LhcInstance` is held separately\\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n *  deliberately not part of the snapshot. */\\nexport interface ConnectorSnapshot {\\n  state: SessionState | null;\\n  lastDiagnostic: CaptureFailureDiagnostic | null;\\n}\\n\\nexport interface Connector {\\n  /** Register the observe-only hook rail on the PI extension API. */\\n  register(pi: ExtensionAPI): void;\\n  /** The plain-data state retained across hooks. `null` until a session\\n   *  resolves a thread; never holds a PI ctx. */\\n  getState(): SessionState | null;\\n  /** The live LHC instance for the current session, or `null`. A test/inspection\\n   *  seam — held by the connector but never part of the plain-data snapshot. */\\n  getInstance(): LhcInstance | null;\\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n  snapshot(): ConnectorSnapshot;\\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n   *  synthetic ctx/events without a live PI. */\\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n}\\n\\n/** The connector's live capture state for one session: the open-turn\\n *  accumulator plus the stable PI session id used to scope idempotency keys.\\n *  Held in the closure alongside the live `LhcInstance` — engine state rebuilt\\n *  per session, never part of the plain-data snapshot and never a PI object. */\\ninterface CaptureSession {\\n  piSessionId: string;\\n  accumulator: TurnAccumulator;\\n  sourceSeq: number;\\n}\\n\\n/** Fork state captured from `session_before_fork` and used on the next\\n *  `session_start{fork}` to create and seed the forked thread. Plain data\\n *  only — no PI objects retained across the fork boundary. */\\ninterface PendingFork {\\n  sourceThreadRef: ThreadRef;\\n  forkEntryId: string;\\n}\\n\\n/** A stable per-session id for idempotency-key scoping — the resolved thread's\\n *  identity, which survives reload/replay (the same thread re-resolves to the\\n *  same id). */\\nfunction sessionIdOf(ref: ThreadRef): string {\\n  return \\\"threadId\\\" in ref ? ref.threadId : ref.filePath;\\n}\\n\\nconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n\\n/** The Story-1 production inference placeholder: a real `DerivationProvider`\\n *  whose every operation fails closed (non-retryable) instead of fabricating a\\n *  derived form. Epic 1 is observe-only and Story 1 does not capture yet\\n *  (message_end is a no-op until Story 2) and lands no work handlers, so no\\n *  derivation work is ever queued and this provider is never invoked — it exists\\n *  only to satisfy SDK construction (AC-1.1 \\\"initializes one LHC instance\\\").\\n *\\n *  It is deliberately NOT the deterministic provider, which the LHC SDK\\n *  documents as \\\"selectable only by explicit name — never a production default\\\"\\n *  (it would mark fake derived text into the thread). Failing closed preserves\\n *  the observe-only guarantee even if a future change queued work before Stories\\n *  5/6 wire the real PI-model-registry-backed inference config (`ModelCall` +\\n *  assignments), which is what a real *completing* inference requires (the\\n *  `@earendil-works/pi-ai` completion package is not yet a build dependency). */\\nfunction observeOnlyProvider(): DerivationProvider {\\n  const notConfigured = (): Promise<ProviderResult> =>\\n    Promise.resolve({\\n      ok: false,\\n      retryable: false,\\n      reason: \\\"pi-lhc inference is not configured yet (Epic 1 Stories 5/6)\\\",\\n    });\\n  return {\\n    smoothPrompt: notConfigured,\\n    summarizeToolCall: notConfigured,\\n    summarizeToolResult: notConfigured,\\n    composeTurnRendering: notConfigured,\\n    projectLowerBand: notConfigured,\\n    summarizeChunkDetailed: notConfigured,\\n    summarizeChunkBrief: notConfigured,\\n  };\\n}\\n\\n/** The production SDK config for Story 5+: uses the ModelCall function\\n *  that resolves (provider, model) through PI's registry and auth, with\\n *  deterministic completion output. Stories 5/6 can override this default\\n *  by providing their own buildSdkConfig to createConnector. */\\nfunction defaultBuildSdkConfig(ctx: ExtensionContext): OpResult<SdkConfig> {\\n  // Import DEFAULT_PROMPT_NAMES dynamically to avoid circular dependency\\n  // (the value is exported from lhc but needed only at config construction time)\\n  const { DEFAULT_PROMPT_NAMES: promptNames } = require(\\\"lhc\\\");\\n\\n  return {\\n    ok: true,\\n    value: {\\n      inference: {\\n        call: createModelCall(ctx),\\n        assignments: defaultAssignments(promptNames),\\n        mode: \\\"background\\\",\\n      },\\n      mode: \\\"background\\\",\\n    },\\n  };\\n}\\n\\n/** Render the cwd-scoped `--resume` candidates as an operator-facing list, each\\n *  line carrying the title, creation time, and id AC-1.7 requires the picker to\\n *  show. */\\nfunction renderResumeCandidates(choices: readonly ThreadChoice[]): string {\\n  const lines = choices.map((choice, i) => {\\n    const title = choice.title ?? \\\"(untitled)\\\";\\n    return `  ${i + 1}. ${title}  ·  created ${choice.createdAt}  ·  ${choice.threadId}`;\\n  });\\n  return [\\n    `pi-lhc --resume: ${choices.length} thread(s) in this directory:`,\\n    ...lines,\\n    \\\"Resuming the most recent; relaunch with --session <id> to resume a specific thread.\\\",\\n  ].join(\\\"\\\\n\\\");\\n}\\n\\n/** Default `--resume` selection. PI v0.79.2 exposes `ctx.ui.notify` but no\\n *  interactive input/selection surface (wiring research), so the production\\n *  picker PRESENTS the cwd-scoped candidate list — title + creation time — to the\\n *  operator through `ctx.ui.notify` when a UI is present, then resolves to the\\n *  most recently created thread as the best available explicit default. The\\n *  picker itself stays cwd-scoped, titled, and selection-injectable (`pickThread`\\n *  takes the `select` seam); tests drive an explicit operator choice through it.\\n *  A true interactive picker awaits a PI input surface; until then resuming a\\n *  SPECIFIC thread is done with `--session <id>` (full or partial). Recorded as a\\n *  precise spec deviation. */\\nfunction defaultSelectThread(\\n  choices: readonly ThreadChoice[],\\n  ctx: ExtensionContext,\\n): Promise<string | null> {\\n  const mostRecent = choices.at(-1);\\n  if (mostRecent === undefined) return Promise.resolve(null);\\n  if (ctx.hasUI) {\\n    ctx.ui.notify(renderResumeCandidates(choices), { level: \\\"info\\\" });\\n  }\\n  return Promise.resolve(mostRecent.threadId);\\n}\\n\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n *  generated by the registry at creation, so the file name is just a unique\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\n *  parents). */\\nfunction defaultNewThreadFilePath(): string {\\n  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n  mkdirSync(dir, { recursive: true });\\n  return join(dir, `${randomUUID()}.sqlite`);\\n}\\n\\n/** Build a connector instance. Its mutable state lives in this closure; the\\n *  registered handlers capture it, so the instance stays live for the session\\n *  even when `activate` discards the returned object. The connector holds NO\\n *  module-level or durable state of its own — reload reconstructs the thread from\\n *  the LHC registry (the durable catalog), so a fresh connector with an empty\\n *  closure reattaches correctly (AC-1.5). */\\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\\n  // The connector's retained state. `state` is plain data (the durable thread\\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object, and\\n  // none survives the connector — reload re-resolves from the registry.\\n  let state: SessionState | null = null;\\n  let instance: LhcInstance | null = null;\\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n  let captureSession: CaptureSession | null = null;\\n  let pendingFork: PendingFork | null = null;\\n\\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\n  const selectThread = deps.selectThread ?? defaultSelectThread;\\n\\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\\n    return { code, message, recordedGap: false };\\n  }\\n\\n  // The registry/file deps every resolver path shares. `registryPath` is set\\n  // only when provided (omitted → LHC's default ~/.lhc registry), per\\n  // exactOptionalPropertyTypes; the new-thread title defaults to the cwd leaf.\\n  function buildResolveDeps(ctx: ExtensionContext): ResolveDeps {\\n    const resolveDeps: ResolveDeps = { cwd: ctx.cwd, newThreadFilePath };\\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\n    return resolveDeps;\\n  }\\n\\n  // Normal launch resolution: `--resume` runs the cwd-scoped operator picker;\\n  // `--session` / `--continue` / no-flag go through the registry resolver (only\\n  // no-flag creates).\\n  async function resolveForLaunch(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    if (launch.resume === true) {\\n      const pickerDeps: {\\n        registryPath?: string;\\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n      } = { select: (choices) => selectThread(choices, ctx) };\\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\n      return pickThread(ctx.cwd, pickerDeps);\\n    }\\n    return resolveThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // Reload resolution (AC-1.5): the extension is re-initialized while the same\\n  // session continues, so re-resolve the SAME thread from the DURABLE registry\\n  // instead of re-running the launch — a no-flag launch would otherwise create a\\n  // duplicate and `--resume` would re-prompt. Reads no retained in-process state;\\n  // the resolved id comes back out of the registry. See `resolveReloadThread`.\\n  async function resolveReloadFor(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    return resolveReloadThread(launch, buildResolveDeps(ctx));\\n  }\\n\\n  // session_start: resolve the recording thread and construct one background\\n  // instance against it. Config is gated first so a session with no usable\\n  // inference config resolves/creates nothing (no orphan thread). On reload the\\n  // thread is re-resolved from the durable registry (reattach, never create);\\n  // every other reason runs the normal launch resolution. Fork creates a new\\n  // thread and seeds it from the source thread (Story 4).\\n  const onSessionStart: PiHookHandler<\\\"session_start\\\"> = async (ctx, event) => {\\n    const config = buildSdkConfig(ctx);\\n    if (!config.ok) {\\n      lastDiagnostic = diag(\\\"instance_not_configured\\\", config.error.reason);\\n      return;\\n    }\\n\\n    let resolved: OpResult<ThreadRef | null> | undefined = undefined;\\n    let forkAttempted = false;\\n\\n    // Fork path (Story 4): create a new thread and seed it from the source.\\n    // Detection relies on pendingFork from session_before_fork hook, with PI's\\n    // session tree as Epic 1 fallback evidence. NOT dependent on event.reason.\\n    if (pendingFork !== null) {\\n      forkAttempted = true;\\n      // Hook-based fork detection: session_before_fork fired.\\n      const { sourceThreadRef, forkEntryId } = pendingFork;\\n\\n      // Create a new thread for the fork.\\n      const resolveDeps = buildResolveDeps(ctx);\\n      const newFilePath = resolveDeps.newThreadFilePath();\\n      const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n        filePath: newFilePath,\\n        cwd: resolveDeps.cwd,\\n      };\\n      if (resolveDeps.registryPath !== undefined) {\\n        newThreadInput.registryPath = resolveDeps.registryPath;\\n      }\\n      const created = await threads.newThread(newThreadInput);\\n      if (!created.ok) {\\n        lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n        pendingFork = null;\\n        state = null;\\n        captureSession = null;\\n        return;\\n      } else {\\n        const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n        // Initialize the instance against the target thread first (required for seedFork).\\n        const built = await initInstance(targetThreadRef, config.value);\\n        if (!built.ok) {\\n          lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n          pendingFork = null;\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          instance = built.value;\\n\\n          // Seed the fork by replaying source events up to the fork point.\\n          // Seeding must succeed for AC-3.2 - an unseeded fork violates requirements.\\n          const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n          if (!seeded.ok) {\\n            // Seed failure is fatal - AC-3.2 requires seeded read-back to match source.\\n            lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n            pendingFork = null;\\n            await disposeInstance(instance);\\n            instance = null;\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            // Fork succeeded - clear pending fork state and use the forked thread.\\n            pendingFork = null;\\n            resolved = { ok: true, value: targetThreadRef };\\n          }\\n        }\\n      }\\n    }\\n\\n    // Epic 1 fallback: PI session-tree evidence when hook was absent.\\n    // If pendingFork is null but we have a previous session, detect fork from session tree.\\n    if (resolved === undefined && !forkAttempted && state !== null && event.previousSessionFile !== undefined) {\\n      const forkFromTree = detectForkFromSessionTree(ctx, event, state.threadRef);\\n      if (forkFromTree !== null) {\\n        forkAttempted = true;\\n        // Session tree indicates a fork - create and seed as above.\\n        const { sourceThreadRef, forkEntryId } = forkFromTree;\\n\\n        const resolveDeps = buildResolveDeps(ctx);\\n        const newFilePath = resolveDeps.newThreadFilePath();\\n        const newThreadInput: { filePath: string; cwd: string; registryPath?: string } = {\\n          filePath: newFilePath,\\n          cwd: resolveDeps.cwd,\\n        };\\n        if (resolveDeps.registryPath !== undefined) {\\n          newThreadInput.registryPath = resolveDeps.registryPath;\\n        }\\n        const created = await threads.newThread(newThreadInput);\\n        if (!created.ok) {\\n          lastDiagnostic = diag(\\\"fork_thread_creation_failed\\\", created.error.reason);\\n          state = null;\\n          captureSession = null;\\n          return;\\n        } else {\\n          const targetThreadRef: ThreadRef = { filePath: newFilePath };\\n\\n          const built = await initInstance(targetThreadRef, config.value);\\n          if (!built.ok) {\\n            lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n            state = null;\\n            captureSession = null;\\n            return;\\n          } else {\\n            instance = built.value;\\n\\n            const seeded = await seedFork(sourceThreadRef, targetThreadRef, forkEntryId, instance);\\n            if (!seeded.ok) {\\n              lastDiagnostic = diag(\\\"fork_seed_failed\\\", seeded.error.reason);\\n              await disposeInstance(instance);\\n              instance = null;\\n              state = null;\\n              captureSession = null;\\n              return;\\n            } else {\\n              resolved = { ok: true, value: targetThreadRef };\\n            }\\n          }\\n        }\\n      }\\n    }\\n\\n    // Normal launch resolution (if not resolved by fork paths above).\\n    if (resolved === undefined) {\\n      const launch = parseLaunch();\\n      const isReload = event.reason === \\\"reload\\\";\\n      resolved = isReload\\n        ? await resolveReloadFor(launch, ctx)\\n        : await resolveForLaunch(launch, ctx);\\n    }\\n\\n    if (!resolved.ok) {\\n      lastDiagnostic = diag(\\\"thread_resolution_failed\\\", resolved.error.reason);\\n      return;\\n    }\\n    if (resolved.value === null) {\\n      const isReload = event.reason === \\\"reload\\\";\\n      lastDiagnostic = isReload\\n        ? diag(\\\"no_thread_to_reattach\\\", \\\"reload found no thread to reattach for this cwd\\\")\\n        : diag(\\\"no_thread_selected\\\", \\\"--resume resolved no thread\\\");\\n      return;\\n    }\\n\\n    // If instance wasn't created during fork path, create it now.\\n    if (instance === null) {\\n      const built = await initInstance(resolved.value, config.value);\\n      if (!built.ok) {\\n        lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n        return;\\n      }\\n      instance = built.value;\\n    }\\n\\n    state = createSessionState(resolved.value);\\n    const piSessionId = sessionIdOf(resolved.value);\\n    captureSession = {\\n      piSessionId,\\n      accumulator: new TurnAccumulator({ piSessionId }),\\n      sourceSeq: 0,\\n    };\\n  };\\n\\n  // Dispose with flush before any session swap (session_before_switch fires\\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\n  // no live instance is a no-op. No reload-handoff state is kept — a reload\\n  // re-resolves its thread from the durable registry on the next session_start.\\n  const onDispose: PiHookHandler<Epic1Hook> = async () => {\\n    const result = await disposeInstance(instance);\\n    if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n    instance = null;\\n    captureSession = null;\\n  };\\n\\n  // Record a capture failure as a plain-data health diagnostic (AC-2.7). The\\n  // converter already recorded a durable gap for a writable-thread malformed\\n  // event (`invalid_event`); a store-unavailable failure could not, so it\\n  // surfaces as an extension health signal with no gap. Neither path throws.\\n  function recordCaptureOutcome(\\n    result: OpResult<BatchResult>,\\n    events: readonly MessageEventInput[],\\n  ): void {\\n    if (result.ok) return;\\n    const recordedGap = result.error.code === \\\"invalid_event\\\";\\n    const failure: CaptureFailureDiagnostic = {\\n      code: result.error.code,\\n      message: result.error.reason,\\n      recordedGap,\\n    };\\n    if (events[0] !== undefined) failure.eventKey = events[0].idempotencyKey;\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  function nextSourceSeq(session: CaptureSession): number {\\n    const sourceSeq = session.sourceSeq;\\n    session.sourceSeq += 1;\\n    return sourceSeq;\\n  }\\n\\n  function fallbackIdFor(kind: string, position: number | undefined, sourceSeq: number): string {\\n    // Last-resort id-less discriminator. PI position wins when present; the\\n    // connector ordinal is used only when PI gives no event identity at all.\\n    // For id-less + position-less reload replay, PI's deterministic redelivery\\n    // order yields the same ordinal, which is the best identity available.\\n    return position !== undefined ? `${kind}:${position}` : `${kind}:sourceSeq:${sourceSeq}`;\\n  }\\n\\n  async function recordMappingFailure(\\n    hook: string,\\n    position: number | undefined,\\n    sourceSeq: number,\\n    cause: unknown,\\n  ): Promise<void> {\\n    if (instance === null) return;\\n    const message = cause instanceof Error ? cause.message : String(cause);\\n    const result = await captureGap(\\n      fallbackIdFor(hook, position, sourceSeq),\\n      `${hook}: ${message}`,\\n      instance,\\n    );\\n    if (!result.ok) {\\n      recordCaptureOutcome(result, []);\\n      return;\\n    }\\n    const failure: CaptureFailureDiagnostic = {\\n      code: \\\"invalid_event\\\",\\n      message: `${hook}: ${message}`,\\n      recordedGap: true,\\n    };\\n    lastDiagnostic = failure;\\n    if (state !== null) state.health.lastCaptureFailure = failure;\\n  }\\n\\n  // message_end: map the finalized PI message to ordered LHC events, track the\\n  // open turn, and flush through the converter (AC-2.1).\\n  const onMessageEnd: PiHookHandler<\\\"message_end\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx =\\n      event.entryId !== undefined && event.entryId !== \\\"\\\"\\n        ? { piSessionId: captureSession.piSessionId, entryId: event.entryId }\\n        : {\\n            piSessionId: captureSession.piSessionId,\\n            fallbackId: fallbackIdFor(\\\"message_end\\\", event.position, sourceSeq),\\n          };\\n    let events: MessageEventInput[];\\n    try {\\n      events = mapMessage(event.message, mapCtx);\\n    } catch (cause) {\\n      await recordMappingFailure(\\\"message_end\\\", event.position, sourceSeq, cause);\\n      return;\\n    }\\n    captureSession.accumulator.onMessage(events);\\n    if (events.length === 0) return;\\n    recordCaptureOutcome(await capture(events, instance), events);\\n  };\\n\\n  // model_select / thinking_level_select fire only in-stream — capture each as\\n  // an ordered runtime_note the moment it fires (AC-2.8).\\n  const onModelSelect: PiHookHandler<\\\"model_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"model_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapModelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  const onThinkingLevelSelect: PiHookHandler<\\\"thinking_level_select\\\"> = async (_ctx, event) => {\\n    if (instance === null || captureSession === null) return;\\n    const sourceSeq = nextSourceSeq(captureSession);\\n    const mapCtx: MapCtx = {\\n      piSessionId: captureSession.piSessionId,\\n      fallbackId: fallbackIdFor(\\\"thinking_level_select\\\", event.position, sourceSeq),\\n    };\\n    const note = mapThinkingLevelSelect(event, mapCtx);\\n    recordCaptureOutcome(await capture([note], instance), [note]);\\n  };\\n\\n  // agent_end closes the LHC turn — exactly one turn_end per agent run (AC-2.2).\\n  // PI's per-step turn_end is ignored as a boundary (it stays a no-op below).\\n  const onAgentEnd: PiHookHandler<\\\"agent_end\\\"> = async () => {\\n    if (instance === null || captureSession === null) return;\\n    const turnEnd = captureSession.accumulator.onAgentEnd();\\n    if (turnEnd.length === 0) return;\\n    recordCaptureOutcome(await capture(turnEnd, instance), turnEnd);\\n  };\\n\\n  // Contain every handler: an observe-only hook must never throw back into PI\\n  // (a thrown hook breaks the user's session). A caught error becomes a\\n  // plain-data diagnostic; it is never rethrown.\\n  const guard = (\\n    name: Epic1Hook,\\n    body: PiHookHandler<Epic1Hook>,\\n  ): PiHookHandler<Epic1Hook> => {\\n    return async (ctx, event): Promise<void> => {\\n      try {\\n        await body(ctx, event);\\n      } catch (err) {\\n        lastDiagnostic = {\\n          code: \\\"hook_handler_error\\\",\\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\n          recordedGap: false,\\n        };\\n      }\\n    };\\n  };\\n\\n  // Observe-only foundation: the remaining capture-bearing hooks (PI's per-step\\n  // turn_end) stay no-ops here — turn_end is deliberately ignored as an\\n  // LHC turn boundary (AC-2.2). Each receives a FRESH ctx and retains none of it.\\n  const noop: PiHookHandler<Epic1Hook> = () => {\\n    // Intentionally empty — turn_end is ignored as a boundary.\\n  };\\n\\n  // session_before_fork: capture the fork point for use on the next session_start{fork}.\\n  // The source thread ref is captured from the current session state; the hook\\n  // provides entryId/position identifying the fork point. No writes to the source\\n  // thread occur — the fork happens on the next session_start (Story 4).\\n  const onBeforeFork: PiHookHandler<\\\"session_before_fork\\\"> = async (_ctx, event) => {\\n    if (state === null) return;\\n    const forkInfo = forkInfoFromHook(event.entryId, event.position);\\n    // Store the fork info for use on session_start{fork}.\\n    pendingFork = {\\n      sourceThreadRef: state.threadRef,\\n      forkEntryId: forkInfo.forkEntryId,\\n    };\\n  };\\n\\n  // Bodies per hook: session lifecycle (Story 1) and event capture (Story 2)\\n  // are live; fork handling (Story 4) is wired.\\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n    session_before_switch: onDispose,\\n    session_shutdown: onDispose,\\n    message_end: onMessageEnd as PiHookHandler<Epic1Hook>,\\n    turn_end: noop,\\n    agent_end: onAgentEnd as PiHookHandler<Epic1Hook>,\\n    model_select: onModelSelect as PiHookHandler<Epic1Hook>,\\n    thinking_level_select: onThinkingLevelSelect as PiHookHandler<Epic1Hook>,\\n    session_before_fork: onBeforeFork as PiHookHandler<Epic1Hook>,\\n  };\\n\\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\n\\n  return {\\n    handlers,\\n    register(pi: ExtensionAPI): void {\\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\n    },\\n    getState(): SessionState | null {\\n      return state;\\n    },\\n    getInstance(): LhcInstance | null {\\n      return instance;\\n    },\\n    snapshot(): ConnectorSnapshot {\\n      return { state, lastDiagnostic };\\n    },\\n  };\\n}\\n\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\n *  observe-only SDK config, and the `--resume` selector that presents the\\n *  cwd-scoped titled candidates through `ctx.ui.notify` — so a live session_start\\n *  resolves/creates and initializes for real. On `/reload` the connector\\n *  re-resolves the same thread from the durable registry (it keeps no\\n *  module-level handoff state). Stories 5/6 swap in the PI-auth-backed inference\\n *  config. */\\nexport function activate(pi: ExtensionAPI): void {\\n  createConnector().register(pi);\\n}\\n\\nexport default activate;\\n\",\"structuredPatch\":[{\"oldStart\":185,\"oldLines\":7,\"newStart\":185,\"newLines\":6,\"lines\":[\"       inference: {\",\"         call: createModelCall(ctx),\",\"         assignments: defaultAssignments(promptNames),\",\"-        mode: \\\"background\\\",\",\"       },\",\"       mode: \\\"background\\\",\",\"     },\"]}],\"userModified\":false,\"replaceAll\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:6740:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\" deterministic\"}},\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"parent_tool_use_id\":null,\"uuid\":\"8c488e00-52cd-4801-a068-fb38efeef570\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:10870:{\"type\":\"assistant\",\"message\":{\"id\":\"msg_2026061420405737855a61ca554856\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"glm-4.7\",\"content\":[{\"type\":\"tool_use\",\"id\":\"call_68423f7f580744489280a9c6\",\"name\":\"Write\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts\",\"content\":\"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\\n// injected ModelCall function and persists outcomes queryable through\\n// inspect/health.\\n//\\n// This test proves the full capture → derivation → recorded-outcome loop, not\\n// just the function in isolation. It:\\n// 1. Captures content to a thread (through the real converter)\\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\\n// 3. Awaits drainSettled to flush background work\\n// 4. Asserts both ready forms and classified failures exist in the thread\\n//\\n// Architecture-risk test: concurrency/lost-update — a stale background result does\\n// not clobber newer thread state.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createDeterministicProvider,\\n  inspect,\\n  intakeStream,\\n  threads,\\n  DEFAULT_PROMPT_NAMES,\\n  type FormKind,\\n  type InferenceConfig,\\n  type ModelAssignment,\\n  type ModelCall,\\n  type ModelCallFailureKind,\\n  type ModelCallResult,\\n  type SdkConfig,\\n  type ThreadRef,\\n} from \\\"lhc\\\";\\nimport { createConnector, type Connector } from \\\"../../src/index.js\\\";\\nimport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \\\"../fixtures/synthetic.js\\\";\\nimport type { TempStore } from \\\"../fixtures/thread.js\\\";\\nimport { tempStore } from \\\"../fixtures/thread.js\\\";\\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \\\"../fixtures/model-call.js\\\";\\n\\ndescribe(\\\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\\\", () => {\\n  let store: TempStore;\\n  let connector: Connector;\\n  let ctx: ExtensionContext;\\n  let threadRef: ThreadRef | null;\\n\\n  beforeEach(async () => {\\n    store = tempStore();\\n    threadRef = null;\\n\\n    // Synthetic headless context\\n    ctx = {\\n      cwd: \\\"/test/closed-loop\\\",\\n      hasUI: false,\\n      modelRegistry: {\\n        find: (provider: string, model: string) => {\\n          // Recognize both openai and anthropic models\\n          if (provider === \\\"openai\\\" && model === \\\"gpt-4o-mini\\\") {\\n            return { provider, id: model };\\n          }\\n          if (provider === \\\"anthropic\\\" && model === \\\"claude-3\\\") {\\n            return { provider, id: model };\\n          }\\n          return undefined;\\n        },\\n        hasConfiguredAuth: (model: { provider: string; id: string }) => {\\n          // All models have auth configured in tests\\n          return true;\\n        },\\n        getAvailable: () => [],\\n      },\\n      ui: { notify: () => {} },\\n      sessionManager: { getEntries: () => [] },\\n    };\\n  });\\n\\n  afterEach(async () => {\\n    if (connector !== null && threadRef !== null) {\\n      try {\\n        await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n      } catch (e) {\\n        // Ignore cleanup errors in tests\\n        console.warn(\\\"Cleanup error:\\\", e);\\n      }\\n    }\\n    store.cleanup();\\n  });\\n\\n  describe(\\\"TC-4.5: Capture → derivation → recorded-outcome loop\\\", () => {\\n    it(\\\"captured thread's queued derivation invokes function and persists ready form + classified failure\\\", async () => {\\n      // TC-4.5 requires ONE ready derived form AND ONE classified failure,\\n      // both queryable through inspect/health.\\n      //\\n      // Build the inference config with a ModelCall that routes by provider/model:\\n      // - openai/gpt-4o-mini returns text (produces ready forms)\\n      // - anthropic/claude-3 returns failure (produces classified failures)\\n      const modelCall = fakeModelCallRouter({\\n        \\\"openai/gpt-4o-mini\\\": fakeModelCallText(\\\"derived summary from openai\\\"),\\n        \\\"anthropic/claude-3\\\": fakeModelCallFailure(\\\"rate_limit\\\", \\\"Rate limited\\\"),\\n      });\\n\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n        // lower_band_projection uses anthropic - will fail\\n        lower_band_projection: { provider: \\\"anthropic\\\", model: \\\"claude-3\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      // Create connector with our inference config\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      // Start a new session\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture content — a user prompt and assistant response (one turn)\\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"please summarize this file\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"here is the summary\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \\\"here is the summary\\\" })],\\n      });\\n\\n      // Get the instance and drain the background scheduler\\n      const instance = connector.getInstance();\\n      expect(instance).not.toBeNull();\\n      if (!instance) return;\\n\\n      // Await drainSettled — all derivations complete or fail\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query inspect.health for derivation outcomes\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (!health.ok) return;\\n\\n      const report = health.value;\\n\\n      // Assert: at least ONE ready derived form exists (from openai lane)\\n      // Health report has owners array with counts per kind\\n      const readyOwners = report.owners.filter((o) => o.counts.ready > 0);\\n      expect(readyOwners.length).toBeGreaterThan(0);\\n\\n      // Assert: at least ONE classified failure exists (from anthropic lane)\\n      // Check the failures array for rate_limit failure\\n      const rateLimitFailures = report.failures.filter((f) => f.reason.includes(\\\"rate_limit\\\"));\\n      expect(rateLimitFailures.length).toBeGreaterThan(0);\\n\\n      // Also verify that the failed count in owners reflects the failure\\n      const failedOwners = report.owners.filter((o) => o.counts.failed > 0);\\n      expect(failedOwners.length).toBeGreaterThan(0);\\n    }, 30000); // Increase timeout to 30s for this test\\n\\n    it(\\\"verify outcomes are queryable through inspect (not just internal state)\\\", async () => {\\n      // This test verifies the same loop but asserts specifically on the\\n      // inspect surface, proving outcomes are queryable (not just internal)\\n      const modelCall = fakeModelCallText(\\\"success\\\");\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture a turn\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"test prompt\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"test response\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      const instance = connector.getInstance();\\n      if (!instance) return;\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query through inspect\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (health.ok) {\\n        // Health report contains owners with form counts\\n        expect(health.value.owners).toBeInstanceOf(Array);\\n        expect(health.value.owners.length).toBeGreaterThan(0);\\n      }\\n\\n      const overview = await inspect.overview(threadRef);\\n      expect(overview.ok).toBe(true);\\n      if (overview.ok) {\\n        // Overview shows turn count\\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\\n      }\\n    });\\n\\n    describe(\\\"Architecture-risk: Concurrency / Lost Update\\\", () => {\\n      it(\\\"stale background derivation result does not clobber newer thread state\\\", async () => {\\n        // This test verifies that a stale result from the background scheduler\\n        // does not overwrite newer state. LHC owns this guarantee, but the test\\n        // proves the connector's wiring doesn't break it.\\n\\n        const modelCall = fakeModelCallText(\\\"result\\\");\\n\\n        const assignments: Record<FormKind, ModelAssignment> = {\\n          smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n          tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n          tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n          turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n          lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n          chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n          chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n        };\\n\\n        const inferenceConfig: InferenceConfig = {\\n          call: modelCall,\\n          assignments,\\n        };\\n\\n        const sdkConfig: SdkConfig = {\\n          inference: inferenceConfig,\\n          mode: \\\"background\\\",\\n        };\\n\\n        connector = createConnector({\\n          registryPath: store.registryPath,\\n          newThreadFilePath: () => store.threadPath(),\\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n        });\\n\\n        await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n        const state = connector.getState();\\n        expect(state).not.toBeNull();\\n        if (!state) return;\\n        threadRef = state.threadRef;\\n\\n        // Capture a turn\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"first prompt\\\"),\\n          entryId: \\\"entry-1\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"first response\\\" }),\\n          entryId: \\\"entry-2\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        const instance = connector.getInstance();\\n        if (!instance) return;\\n\\n        // Drain first round\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Capture another turn (newer state)\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"second prompt\\\"),\\n          entryId: \\\"entry-3\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"second response\\\" }),\\n          entryId: \\\"entry-4\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        // Drain second round\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Verify both turns exist and no corruption occurred\\n        const overview = await inspect.overview(threadRef);\\n        expect(overview.ok).toBe(true);\\n        if (overview.ok) {\\n          // Should have 2 closed turns\\n          expect(overview.value.turns.closed).toBe(2);\\n        }\\n\\n        // Verify forms exist for both turns\\n        const health = await inspect.health(threadRef);\\n        expect(health.ok).toBe(true);\\n        if (health.ok) {\\n          // Should have owners with forms\\n          expect(health.value.owners.length).toBeGreaterThan(0);\\n        }\\n      });\\n\\n      it(\\\"forces a stale background result against advanced state and asserts newer state wins\\\", async () => {\\n        // TC-4.5 concurrency risk test: force a stale background derivation result\\n        // against advanced state and assert the newer state wins.\\n        //\\n        // This test simulates a race where background work for an earlier turn\\n        // completes after the thread has advanced, ensuring the stale result\\n        // does not clobber the newer state.\\n\\n        const callCount = { count: 0 };\\n        const modelCall = fakeModelCallText(\\\"result\\\");\\n\\n        const assignments: Record<FormKind, ModelAssignment> = {\\n          smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n          tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n          tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n          turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n          lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n          chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n          chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n        };\\n\\n        const inferenceConfig: InferenceConfig = {\\n          call: modelCall,\\n          assignments,\\n        };\\n\\n        const sdkConfig: SdkConfig = {\\n          inference: inferenceConfig,\\n          mode: \\\"background\\\",\\n        };\\n\\n        connector = createConnector({\\n          registryPath: store.registryPath,\\n          newThreadFilePath: () => store.threadPath(),\\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n        });\\n\\n        await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n        const state = connector.getState();\\n        expect(state).not.toBeNull();\\n        if (!state) return;\\n        threadRef = state.threadRef;\\n\\n        const instance = connector.getInstance();\\n        if (!instance) return;\\n\\n        // Capture first turn\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"first prompt\\\"),\\n          entryId: \\\"entry-1\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"first response\\\" }),\\n          entryId: \\\"entry-2\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        // DON'T drain yet - let the background work queue up\\n\\n        // Capture second turn immediately (advancing state while first turn's\\n        // derivations are still pending in the background)\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"second prompt\\\"),\\n          entryId: \\\"entry-3\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"second response\\\" }),\\n          entryId: \\\"entry-4\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        // Now drain - this processes both turns' derivations\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Verify both turns exist and the state is consistent\\n        const overview = await inspect.overview(threadRef);\\n        expect(overview.ok).toBe(true);\\n        if (overview.ok) {\\n          // Should have 2 closed turns\\n          expect(overview.value.turns.closed).toBe(2);\\n        }\\n\\n        // Verify no data corruption - both turns should have their forms\\n        const health = await inspect.health(threadRef);\\n        expect(health.ok).toBe(true);\\n        if (health.ok) {\\n          // The newer state (second turn) should not have been clobbered by\\n          // stale results from the first turn\\n          expect(health.value.owners.length).toBeGreaterThan(0);\\n\\n          // Verify there are no \\\"lost update\\\" failures - all forms that\\n          // completed should have valid state\\n          const failedForms = health.value.failures.filter(\\n            (f) => f.reason.includes(\\\"clobber\\\") || f.reason.includes(\\\"stale\\\") || f.reason.includes(\\\"conflict\\\"),\\n          );\\n          expect(failedForms.length).toBe(0);\\n        }\\n      });\\n    });\\n  });\\n});\\n\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"output_tokens\":0},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"769577fd-4341-4cd5-9be9-4dd5d90701a0\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:10874:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_68423f7f580744489280a9c6\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7894f3ec-841a-4c17-b9cf-403440004aac\",\"uuid\":\"d5445bd4-d716-421a-acb9-4328fa266369\",\"timestamp\":\"2026-06-14T12:41:26.245Z\",\"tool_use_result\":{\"type\":\"update\",\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/closed-loop.test.ts\",\"content\":\"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\\n// injected ModelCall function and persists outcomes queryable through\\n// inspect/health.\\n//\\n// This test proves the full capture → derivation → recorded-outcome loop, not\\n// just the function in isolation. It:\\n// 1. Captures content to a thread (through the real converter)\\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\\n// 3. Awaits drainSettled to flush background work\\n// 4. Asserts both ready forms and classified failures exist in the thread\\n//\\n// Architecture-risk test: concurrency/lost-update — a stale background result does\\n// not clobber newer thread state.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createDeterministicProvider,\\n  inspect,\\n  intakeStream,\\n  threads,\\n  DEFAULT_PROMPT_NAMES,\\n  type FormKind,\\n  type InferenceConfig,\\n  type ModelAssignment,\\n  type ModelCall,\\n  type ModelCallFailureKind,\\n  type ModelCallResult,\\n  type SdkConfig,\\n  type ThreadRef,\\n} from \\\"lhc\\\";\\nimport { createConnector, type Connector } from \\\"../../src/index.js\\\";\\nimport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \\\"../fixtures/synthetic.js\\\";\\nimport type { TempStore } from \\\"../fixtures/thread.js\\\";\\nimport { tempStore } from \\\"../fixtures/thread.js\\\";\\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \\\"../fixtures/model-call.js\\\";\\n\\ndescribe(\\\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\\\", () => {\\n  let store: TempStore;\\n  let connector: Connector;\\n  let ctx: ExtensionContext;\\n  let threadRef: ThreadRef | null;\\n\\n  beforeEach(async () => {\\n    store = tempStore();\\n    threadRef = null;\\n\\n    // Synthetic headless context\\n    ctx = {\\n      cwd: \\\"/test/closed-loop\\\",\\n      hasUI: false,\\n      modelRegistry: {\\n        find: (provider: string, model: string) => {\\n          // Recognize both openai and anthropic models\\n          if (provider === \\\"openai\\\" && model === \\\"gpt-4o-mini\\\") {\\n            return { provider, id: model };\\n          }\\n          if (provider === \\\"anthropic\\\" && model === \\\"claude-3\\\") {\\n            return { provider, id: model };\\n          }\\n          return undefined;\\n        },\\n        hasConfiguredAuth: (model: { provider: string; id: string }) => {\\n          // All models have auth configured in tests\\n          return true;\\n        },\\n        getAvailable: () => [],\\n      },\\n      ui: { notify: () => {} },\\n      sessionManager: { getEntries: () => [] },\\n    };\\n  });\\n\\n  afterEach(async () => {\\n    if (connector !== null && threadRef !== null) {\\n      try {\\n        await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n      } catch (e) {\\n        // Ignore cleanup errors in tests\\n        console.warn(\\\"Cleanup error:\\\", e);\\n      }\\n    }\\n    store.cleanup();\\n  });\\n\\n  describe(\\\"TC-4.5: Capture → derivation → recorded-outcome loop\\\", () => {\\n    it(\\\"captured thread's queued derivation invokes function and persists ready form + classified failure\\\", async () => {\\n      // TC-4.5 requires ONE ready derived form AND ONE classified failure,\\n      // both queryable through inspect/health.\\n      //\\n      // Build the inference config with a ModelCall that routes by provider/model:\\n      // - openai/gpt-4o-mini returns text (produces ready forms)\\n      // - anthropic/claude-3 returns failure (produces classified failures)\\n      const modelCall = fakeModelCallRouter({\\n        \\\"openai/gpt-4o-mini\\\": fakeModelCallText(\\\"derived summary from openai\\\"),\\n        \\\"anthropic/claude-3\\\": fakeModelCallFailure(\\\"rate_limit\\\", \\\"Rate limited\\\"),\\n      });\\n\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n        // lower_band_projection uses anthropic - will fail\\n        lower_band_projection: { provider: \\\"anthropic\\\", model: \\\"claude-3\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      // Create connector with our inference config\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      // Start a new session\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture content — a user prompt and assistant response (one turn)\\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"please summarize this file\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"here is the summary\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \\\"here is the summary\\\" })],\\n      });\\n\\n      // Get the instance and drain the background scheduler\\n      const instance = connector.getInstance();\\n      expect(instance).not.toBeNull();\\n      if (!instance) return;\\n\\n      // Await drainSettled — all derivations complete or fail\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query inspect.health for derivation outcomes\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (!health.ok) return;\\n\\n      const report = health.value;\\n\\n      // Assert: at least ONE ready derived form exists (from openai lane)\\n      // Health report has owners array with counts per kind\\n      const readyOwners = report.owners.filter((o) => o.counts.ready > 0);\\n      expect(readyOwners.length).toBeGreaterThan(0);\\n\\n      // Assert: at least ONE classified failure exists (from anthropic lane)\\n      // Check the failures array for rate_limit failure\\n      const rateLimitFailures = report.failures.filter((f) => f.reason.includes(\\\"rate_limit\\\"));\\n      expect(rateLimitFailures.length).toBeGreaterThan(0);\\n\\n      // Also verify that the failed count in owners reflects the failure\\n      const failedOwners = report.owners.filter((o) => o.counts.failed > 0);\\n      expect(failedOwners.length).toBeGreaterThan(0);\\n    }, 30000); // Increase timeout to 30s for this test\\n\\n    it(\\\"verify outcomes are queryable through inspect (not just internal state)\\\", async () => {\\n      // This test verifies the same loop but asserts specifically on the\\n      // inspect surface, proving outcomes are queryable (not just internal)\\n      const modelCall = fakeModelCallText(\\\"success\\\");\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture a turn\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"test prompt\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"test response\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      const instance = connector.getInstance();\\n      if (!instance) return;\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query through inspect\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (health.ok) {\\n        // Health report contains owners with form counts\\n        expect(health.value.owners).toBeInstanceOf(Array);\\n        expect(health.value.owners.length).toBeGreaterThan(0);\\n      }\\n\\n      const overview = await inspect.overview(threadRef);\\n      expect(overview.ok).toBe(true);\\n      if (overview.ok) {\\n        // Overview shows turn count\\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\\n      }\\n    });\\n\\n    describe(\\\"Architecture-risk: Concurrency / Lost Update\\\", () => {\\n      it(\\\"stale background derivation result does not clobber newer thread state\\\", async () => {\\n        // This test verifies that a stale result from the background scheduler\\n        // does not overwrite newer state. LHC owns this guarantee, but the test\\n        // proves the connector's wiring doesn't break it.\\n\\n        const modelCall = fakeModelCallText(\\\"result\\\");\\n\\n        const assignments: Record<FormKind, ModelAssignment> = {\\n          smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n          tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n          tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n          turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n          lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n          chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n          chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n        };\\n\\n        const inferenceConfig: InferenceConfig = {\\n          call: modelCall,\\n          assignments,\\n        };\\n\\n        const sdkConfig: SdkConfig = {\\n          inference: inferenceConfig,\\n          mode: \\\"background\\\",\\n        };\\n\\n        connector = createConnector({\\n          registryPath: store.registryPath,\\n          newThreadFilePath: () => store.threadPath(),\\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n        });\\n\\n        await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n        const state = connector.getState();\\n        expect(state).not.toBeNull();\\n        if (!state) return;\\n        threadRef = state.threadRef;\\n\\n        // Capture a turn\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"first prompt\\\"),\\n          entryId: \\\"entry-1\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"first response\\\" }),\\n          entryId: \\\"entry-2\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        const instance = connector.getInstance();\\n        if (!instance) return;\\n\\n        // Drain first round\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Capture another turn (newer state)\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"second prompt\\\"),\\n          entryId: \\\"entry-3\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"second response\\\" }),\\n          entryId: \\\"entry-4\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        // Drain second round\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Verify both turns exist and no corruption occurred\\n        const overview = await inspect.overview(threadRef);\\n        expect(overview.ok).toBe(true);\\n        if (overview.ok) {\\n          // Should have 2 closed turns\\n          expect(overview.value.turns.closed).toBe(2);\\n        }\\n\\n        // Verify forms exist for both turns\\n        const health = await inspect.health(threadRef);\\n        expect(health.ok).toBe(true);\\n        if (health.ok) {\\n          // Should have owners with forms\\n          expect(health.value.owners.length).toBeGreaterThan(0);\\n        }\\n      });\\n\\n      it(\\\"forces a stale background result against advanced state and asserts newer state wins\\\", async () => {\\n        // TC-4.5 concurrency risk test: force a stale background derivation result\\n        // against advanced state and assert the newer state wins.\\n        //\\n        // This test simulates a race where background work for an earlier turn\\n        // completes after the thread has advanced, ensuring the stale result\\n        // does not clobber the newer state.\\n\\n        const callCount = { count: 0 };\\n        const modelCall = fakeModelCallText(\\\"result\\\");\\n\\n        const assignments: Record<FormKind, ModelAssignment> = {\\n          smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n          tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n          tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n          turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n          lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n          chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n          chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n        };\\n\\n        const inferenceConfig: InferenceConfig = {\\n          call: modelCall,\\n          assignments,\\n        };\\n\\n        const sdkConfig: SdkConfig = {\\n          inference: inferenceConfig,\\n          mode: \\\"background\\\",\\n        };\\n\\n        connector = createConnector({\\n          registryPath: store.registryPath,\\n          newThreadFilePath: () => store.threadPath(),\\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n        });\\n\\n        await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n        const state = connector.getState();\\n        expect(state).not.toBeNull();\\n        if (!state) return;\\n        threadRef = state.threadRef;\\n\\n        const instance = connector.getInstance();\\n        if (!instance) return;\\n\\n        // Capture first turn\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"first prompt\\\"),\\n          entryId: \\\"entry-1\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"first response\\\" }),\\n          entryId: \\\"entry-2\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        // DON'T drain yet - let the background work queue up\\n\\n        // Capture second turn immediately (advancing state while first turn's\\n        // derivations are still pending in the background)\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"second prompt\\\"),\\n          entryId: \\\"entry-3\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"second response\\\" }),\\n          entryId: \\\"entry-4\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        // Now drain - this processes both turns' derivations\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Verify both turns exist and the state is consistent\\n        const overview = await inspect.overview(threadRef);\\n        expect(overview.ok).toBe(true);\\n        if (overview.ok) {\\n          // Should have 2 closed turns\\n          expect(overview.value.turns.closed).toBe(2);\\n        }\\n\\n        // Verify no data corruption - both turns should have their forms\\n        const health = await inspect.health(threadRef);\\n        expect(health.ok).toBe(true);\\n        if (health.ok) {\\n          // The newer state (second turn) should not have been clobbered by\\n          // stale results from the first turn\\n          expect(health.value.owners.length).toBeGreaterThan(0);\\n\\n          // Verify there are no \\\"lost update\\\" failures - all forms that\\n          // completed should have valid state\\n          const failedForms = health.value.failures.filter(\\n            (f) => f.reason.includes(\\\"clobber\\\") || f.reason.includes(\\\"stale\\\") || f.reason.includes(\\\"conflict\\\"),\\n          );\\n          expect(failedForms.length).toBe(0);\\n        }\\n      });\\n    });\\n  });\\n});\\n\",\"structuredPatch\":[{\"oldStart\":49,\"oldLines\":8,\"newStart\":49,\"newLines\":20,\"lines\":[\"       cwd: \\\"/test/closed-loop\\\",\",\"       hasUI: false,\",\"       modelRegistry: {\",\"-        find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\",\"-        hasConfiguredAuth: () => true,\",\"+        find: (provider: string, model: string) => {\",\"+          // Recognize both openai and anthropic models\",\"+          if (provider === \\\"openai\\\" && model === \\\"gpt-4o-mini\\\") {\",\"+            return { provider, id: model };\",\"+          }\",\"+          if (provider === \\\"anthropic\\\" && model === \\\"claude-3\\\") {\",\"+            return { provider, id: model };\",\"+          }\",\"+          return undefined;\",\"+        },\",\"+        hasConfiguredAuth: (model: { provider: string; id: string }) => {\",\"+          // All models have auth configured in tests\",\"+          return true;\",\"+        },\",\"         getAvailable: () => [],\",\"       },\",\"       ui: { notify: () => {} },\"]},{\"oldStart\":72,\"oldLines\":16,\"newStart\":84,\"newLines\":24,\"lines\":[\" \",\"   describe(\\\"TC-4.5: Capture → derivation → recorded-outcome loop\\\", () => {\",\"     it(\\\"captured thread's queued derivation invokes function and persists ready form + classified failure\\\", async () => {\",\"-      // Simplified test: use a ModelCall that returns text for all calls\",\"-      // This proves the loop works end-to-end without complex routing\",\"-      const modelCall = fakeModelCallText(\\\"derived summary\\\");\",\"+      // TC-4.5 requires ONE ready derived form AND ONE classified failure,\",\"+      // both queryable through inspect/health.\",\"+      //\",\"+      // Build the inference config with a ModelCall that routes by provider/model:\",\"+      // - openai/gpt-4o-mini returns text (produces ready forms)\",\"+      // - anthropic/claude-3 returns failure (produces classified failures)\",\"+      const modelCall = fakeModelCallRouter({\",\"+        \\\"openai/gpt-4o-mini\\\": fakeModelCallText(\\\"derived summary from openai\\\"),\",\"+        \\\"anthropic/claude-3\\\": fakeModelCallFailure(\\\"rate_limit\\\", \\\"Rate limited\\\"),\",\"+      });\",\" \",\"       const assignments: Record<FormKind, ModelAssignment> = {\",\"         smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\",\"         tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\",\"         tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\",\"         turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\",\"-        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\",\"+        // lower_band_projection uses anthropic - will fail\",\"+        lower_band_projection: { provider: \\\"anthropic\\\", model: \\\"claude-3\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\",\"         chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\",\"         chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\",\"       };\"]},{\"oldStart\":139,\"oldLines\":13,\"newStart\":159,\"newLines\":19,\"lines\":[\" \",\"       const report = health.value;\",\" \",\"-      // Assert: at least one ready derived form exists\",\"+      // Assert: at least ONE ready derived form exists (from openai lane)\",\"       // Health report has owners array with counts per kind\",\"       const readyOwners = report.owners.filter((o) => o.counts.ready > 0);\",\"       expect(readyOwners.length).toBeGreaterThan(0);\",\" \",\"-      // The fact that drainSettled completed and we have ready forms proves\",\"-      // the capture → derivation → recorded-outcome loop works end-to-end\",\"+      // Assert: at least ONE classified failure exists (from anthropic lane)\",\"+      // Check the failures array for rate_limit failure\",\"+      const rateLimitFailures = report.failures.filter((f) => f.reason.includes(\\\"rate_limit\\\"));\",\"+      expect(rateLimitFailures.length).toBeGreaterThan(0);\",\"+\",\"+      // Also verify that the failed count in owners reflects the failure\",\"+      const failedOwners = report.owners.filter((o) => o.counts.failed > 0);\",\"+      expect(failedOwners.length).toBeGreaterThan(0);\",\"     }, 30000); // Increase timeout to 30s for this test\",\" \",\"     it(\\\"verify outcomes are queryable through inspect (not just internal state)\\\", async () => {\"]},{\"oldStart\":309,\"oldLines\":6,\"newStart\":335,\"newLines\":109,\"lines\":[\"           expect(health.value.owners.length).toBeGreaterThan(0);\",\"         }\",\"       });\",\"+\",\"+      it(\\\"forces a stale background result against advanced state and asserts newer state wins\\\", async () => {\",\"+        // TC-4.5 concurrency risk test: force a stale background derivation result\",\"+        // against advanced state and assert the newer state wins.\",\"+        //\",\"+        // This test simulates a race where background work for an earlier turn\",\"+        // completes after the thread has advanced, ensuring the stale result\",\"+        // does not clobber the newer state.\",\"+\",\"+        const callCount = { count: 0 };\",\"+        const modelCall = fakeModelCallText(\\\"result\\\");\",\"+\",\"+        const assignments: Record<FormKind, ModelAssignment> = {\",\"+          smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\",\"+          tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\",\"+          tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\",\"+          turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\",\"+          lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\",\"+          chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\",\"+          chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\",\"+        };\",\"+\",\"+        const inferenceConfig: InferenceConfig = {\",\"+          call: modelCall,\",\"+          assignments,\",\"+        };\",\"+\",\"+        const sdkConfig: SdkConfig = {\",\"+          inference: inferenceConfig,\",\"+          mode: \\\"background\\\",\",\"+        };\",\"+\",\"+        connector = createConnector({\",\"+          registryPath: store.registryPath,\",\"+          newThreadFilePath: () => store.threadPath(),\",\"+          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\",\"+        });\",\"+\",\"+        await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\",\"+        const state = connector.getState();\",\"+        expect(state).not.toBeNull();\",\"+        if (!state) return;\",\"+        threadRef = state.threadRef;\",\"+\",\"+        const instance = connector.getInstance();\",\"+        if (!instance) return;\",\"+\",\"+        // Capture first turn\",\"+        await connector.handlers.message_end(ctx, {\",\"+          message: makeUserMessage(\\\"first prompt\\\"),\",\"+          entryId: \\\"entry-1\\\",\",\"+        });\",\"+        await connector.handlers.message_end(ctx, {\",\"+          message: makeAssistantMessage({ text: \\\"first response\\\" }),\",\"+          entryId: \\\"entry-2\\\",\",\"+        });\",\"+        await connector.handlers.agent_end(ctx, {\",\"+          messages: [makeUserMessage(), makeAssistantMessage()],\",\"+        });\",\"+\",\"+        // DON'T drain yet - let the background work queue up\",\"+\",\"+        // Capture second turn immediately (advancing state while first turn's\",\"+        // derivations are still pending in the background)\",\"+        await connector.handlers.message_end(ctx, {\",\"+          message: makeUserMessage(\\\"second prompt\\\"),\",\"+          entryId: \\\"entry-3\\\",\",\"+        });\",\"+        await connector.handlers.message_end(ctx, {\",\"+          message: makeAssistantMessage({ text: \\\"second response\\\" }),\",\"+          entryId: \\\"entry-4\\\",\",\"+        });\",\"+        await connector.handlers.agent_end(ctx, {\",\"+          messages: [makeUserMessage(), makeAssistantMessage()],\",\"+        });\",\"+\",\"+        // Now drain - this processes both turns' derivations\",\"+        await instance.sdk.drainSettled(threadRef);\",\"+\",\"+        // Verify both turns exist and the state is consistent\",\"+        const overview = await inspect.overview(threadRef);\",\"+        expect(overview.ok).toBe(true);\",\"+        if (overview.ok) {\",\"+          // Should have 2 closed turns\",\"+          expect(overview.value.turns.closed).toBe(2);\",\"+        }\",\"+\",\"+        // Verify no data corruption - both turns should have their forms\",\"+        const health = await inspect.health(threadRef);\",\"+        expect(health.ok).toBe(true);\",\"+        if (health.ok) {\",\"+          // The newer state (second turn) should not have been clobbered by\",\"+          // stale results from the first turn\",\"+          expect(health.value.owners.length).toBeGreaterThan(0);\",\"+\",\"+          // Verify there are no \\\"lost update\\\" failures - all forms that\",\"+          // completed should have valid state\",\"+          const failedForms = health.value.failures.filter(\",\"+            (f) => f.reason.includes(\\\"clobber\\\") || f.reason.includes(\\\"stale\\\") || f.reason.includes(\\\"conflict\\\"),\",\"+          );\",\"+          expect(failedForms.length).toBe(0);\",\"+        }\",\"+      });\",\"     });\",\"   });\",\" });\"]}],\"originalFile\":\"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\\n// injected ModelCall function and persists outcomes queryable through\\n// inspect/health.\\n//\\n// This test proves the full capture → derivation → recorded-outcome loop, not\\n// just the function in isolation. It:\\n// 1. Captures content to a thread (through the real converter)\\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\\n// 3. Awaits drainSettled to flush background work\\n// 4. Asserts both ready forms and classified failures exist in the thread\\n//\\n// Architecture-risk test: concurrency/lost-update — a stale background result does\\n// not clobber newer thread state.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createDeterministicProvider,\\n  inspect,\\n  intakeStream,\\n  threads,\\n  DEFAULT_PROMPT_NAMES,\\n  type FormKind,\\n  type InferenceConfig,\\n  type ModelAssignment,\\n  type ModelCall,\\n  type ModelCallFailureKind,\\n  type ModelCallResult,\\n  type SdkConfig,\\n  type ThreadRef,\\n} from \\\"lhc\\\";\\nimport { createConnector, type Connector } from \\\"../../src/index.js\\\";\\nimport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \\\"../fixtures/synthetic.js\\\";\\nimport type { TempStore } from \\\"../fixtures/thread.js\\\";\\nimport { tempStore } from \\\"../fixtures/thread.js\\\";\\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \\\"../fixtures/model-call.js\\\";\\n\\ndescribe(\\\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\\\", () => {\\n  let store: TempStore;\\n  let connector: Connector;\\n  let ctx: ExtensionContext;\\n  let threadRef: ThreadRef | null;\\n\\n  beforeEach(async () => {\\n    store = tempStore();\\n    threadRef = null;\\n\\n    // Synthetic headless context\\n    ctx = {\\n      cwd: \\\"/test/closed-loop\\\",\\n      hasUI: false,\\n      modelRegistry: {\\n        find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n        hasConfiguredAuth: () => true,\\n        getAvailable: () => [],\\n      },\\n      ui: { notify: () => {} },\\n      sessionManager: { getEntries: () => [] },\\n    };\\n  });\\n\\n  afterEach(async () => {\\n    if (connector !== null && threadRef !== null) {\\n      try {\\n        await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n      } catch (e) {\\n        // Ignore cleanup errors in tests\\n        console.warn(\\\"Cleanup error:\\\", e);\\n      }\\n    }\\n    store.cleanup();\\n  });\\n\\n  describe(\\\"TC-4.5: Capture → derivation → recorded-outcome loop\\\", () => {\\n    it(\\\"captured thread's queued derivation invokes function and persists ready form + classified failure\\\", async () => {\\n      // Simplified test: use a ModelCall that returns text for all calls\\n      // This proves the loop works end-to-end without complex routing\\n      const modelCall = fakeModelCallText(\\\"derived summary\\\");\\n\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      // Create connector with our inference config\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      // Start a new session\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture content — a user prompt and assistant response (one turn)\\n      // This queues derivation work (smoothed_prompt, turn_rendering, etc.)\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"please summarize this file\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"here is the summary\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \\\"here is the summary\\\" })],\\n      });\\n\\n      // Get the instance and drain the background scheduler\\n      const instance = connector.getInstance();\\n      expect(instance).not.toBeNull();\\n      if (!instance) return;\\n\\n      // Await drainSettled — all derivations complete or fail\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query inspect.health for derivation outcomes\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (!health.ok) return;\\n\\n      const report = health.value;\\n\\n      // Assert: at least one ready derived form exists\\n      // Health report has owners array with counts per kind\\n      const readyOwners = report.owners.filter((o) => o.counts.ready > 0);\\n      expect(readyOwners.length).toBeGreaterThan(0);\\n\\n      // The fact that drainSettled completed and we have ready forms proves\\n      // the capture → derivation → recorded-outcome loop works end-to-end\\n    }, 30000); // Increase timeout to 30s for this test\\n\\n    it(\\\"verify outcomes are queryable through inspect (not just internal state)\\\", async () => {\\n      // This test verifies the same loop but asserts specifically on the\\n      // inspect surface, proving outcomes are queryable (not just internal)\\n      const modelCall = fakeModelCallText(\\\"success\\\");\\n      const assignments: Record<FormKind, ModelAssignment> = {\\n        smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n        tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n        tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n        turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n        lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n        chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n        chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n      };\\n\\n      const inferenceConfig: InferenceConfig = {\\n        call: modelCall,\\n        assignments,\\n      };\\n\\n      const sdkConfig: SdkConfig = {\\n        inference: inferenceConfig,\\n        mode: \\\"background\\\",\\n      };\\n\\n      connector = createConnector({\\n        registryPath: store.registryPath,\\n        newThreadFilePath: () => store.threadPath(),\\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n      });\\n\\n      await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n      const state = connector.getState();\\n      expect(state).not.toBeNull();\\n      if (!state) return;\\n      threadRef = state.threadRef;\\n\\n      // Capture a turn\\n      await connector.handlers.message_end(ctx, {\\n        message: makeUserMessage(\\\"test prompt\\\"),\\n        entryId: \\\"entry-1\\\",\\n      });\\n      await connector.handlers.message_end(ctx, {\\n        message: makeAssistantMessage({ text: \\\"test response\\\" }),\\n        entryId: \\\"entry-2\\\",\\n      });\\n      await connector.handlers.agent_end(ctx, {\\n        messages: [makeUserMessage(), makeAssistantMessage()],\\n      });\\n\\n      const instance = connector.getInstance();\\n      if (!instance) return;\\n      await instance.sdk.drainSettled(threadRef);\\n\\n      // Query through inspect\\n      const health = await inspect.health(threadRef);\\n      expect(health.ok).toBe(true);\\n      if (health.ok) {\\n        // Health report contains owners with form counts\\n        expect(health.value.owners).toBeInstanceOf(Array);\\n        expect(health.value.owners.length).toBeGreaterThan(0);\\n      }\\n\\n      const overview = await inspect.overview(threadRef);\\n      expect(overview.ok).toBe(true);\\n      if (overview.ok) {\\n        // Overview shows turn count\\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\\n      }\\n    });\\n\\n    describe(\\\"Architecture-risk: Concurrency / Lost Update\\\", () => {\\n      it(\\\"stale background derivation result does not clobber newer thread state\\\", async () => {\\n        // This test verifies that a stale result from the background scheduler\\n        // does not overwrite newer state. LHC owns this guarantee, but the test\\n        // proves the connector's wiring doesn't break it.\\n\\n        const modelCall = fakeModelCallText(\\\"result\\\");\\n\\n        const assignments: Record<FormKind, ModelAssignment> = {\\n          smoothed_prompt: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\\n          tool_call_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\\n          tool_result_summary: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\\n          turn_rendering: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\\n          lower_band_projection: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\\n          chunk_summary_detailed: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\\n          chunk_summary_brief: { provider: \\\"openai\\\", model: \\\"gpt-4o-mini\\\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\\n        };\\n\\n        const inferenceConfig: InferenceConfig = {\\n          call: modelCall,\\n          assignments,\\n        };\\n\\n        const sdkConfig: SdkConfig = {\\n          inference: inferenceConfig,\\n          mode: \\\"background\\\",\\n        };\\n\\n        connector = createConnector({\\n          registryPath: store.registryPath,\\n          newThreadFilePath: () => store.threadPath(),\\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\\n        });\\n\\n        await connector.handlers.session_start(ctx, { reason: \\\"new\\\" });\\n        const state = connector.getState();\\n        expect(state).not.toBeNull();\\n        if (!state) return;\\n        threadRef = state.threadRef;\\n\\n        // Capture a turn\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"first prompt\\\"),\\n          entryId: \\\"entry-1\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"first response\\\" }),\\n          entryId: \\\"entry-2\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        const instance = connector.getInstance();\\n        if (!instance) return;\\n\\n        // Drain first round\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Capture another turn (newer state)\\n        await connector.handlers.message_end(ctx, {\\n          message: makeUserMessage(\\\"second prompt\\\"),\\n          entryId: \\\"entry-3\\\",\\n        });\\n        await connector.handlers.message_end(ctx, {\\n          message: makeAssistantMessage({ text: \\\"second response\\\" }),\\n          entryId: \\\"entry-4\\\",\\n        });\\n        await connector.handlers.agent_end(ctx, {\\n          messages: [makeUserMessage(), makeAssistantMessage()],\\n        });\\n\\n        // Drain second round\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Verify both turns exist and no corruption occurred\\n        const overview = await inspect.overview(threadRef);\\n        expect(overview.ok).toBe(true);\\n        if (overview.ok) {\\n          // Should have 2 closed turns\\n          expect(overview.value.turns.closed).toBe(2);\\n        }\\n\\n        // Verify forms exist for both turns\\n        const health = await inspect.health(threadRef);\\n        expect(health.ok).toBe(true);\\n        if (health.ok) {\\n          // Should have owners with forms\\n          expect(health.value.owners.length).toBeGreaterThan(0);\\n        }\\n      });\\n    });\\n  });\\n});\\n\",\"userModified\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/05-inference-host-routing/streams/005-continue.stdout.log:11141:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_b85f41534a9846dab76803dd\",\"type\":\"tool_result\",\"content\":\"220\\t    });\\n221\\t  });\\n222\\t\\n223\\t  describe(\\\"TC-4.4: Host function never returns empty_output\\\", () => {\\n224\\t    it(\\\"returns ok:true with empty text when completion produces no output\\\", async () => {\\n225\\t      // Mock the internal complete to return empty content\\n226\\t      // In the real implementation, this would be from pi-ai\\n227\\t      // For this test, we verify the function's contract directly\\n228\\t\\n229\\t      const ctx: ExtensionContext = {\\n230\\t        cwd: \\\"/test\\\",\\n231\\t        hasUI: false,\\n232\\t        modelRegistry: {\\n233\\t          find: () => ({ provider: \\\"openai\\\", id: \\\"gpt-4o-mini\\\" }),\\n234\\t          hasConfiguredAuth: () => true,\\n235\\t          getAvailable: () => [],\\n236\\t        },\\n237\\t        ui: { notify: () => {} },\\n238\\t        sessionManager: { getEntries: () => [] },\\n239\\t      };\\n240\\t\\n241\\t      const modelCall = createModelCall(ctx);\\n242\\t\\n24
\\n        const threadRef = state.threadRef;\\n        await instance.sdk.drainSettled(threadRef);\\n\\n        // Inspect health to verify affected lane derivations failed\\n        const health = await instance.sdk.inspect.health(threadRef);\\n        expect(health.ok).toBe(true);\\n        if (!health.ok) return;\\n\\n        // Verify that smoothed_prompt derivations failed (unreachable lane)\\n        const smoothedFailed = health.value.owners.some((o) =>\\n          o.kind === \\\"smoothed_prompt\\\" && o.counts.failed > 0\\n        );\\n        expect(smoothed).toBe(true);\\n\\n        // Verify that tool_call_summary derivations succeeded (reachable lane)\\n        const toolCallReady = health.value.owners.some((o) =>\\n          o.kind === \\\"tool_call_summary\\\" && o.counts.ready > 0\\n        );\\n        expect(toolCallReady).toBe(true);\\n\\n        // Verify failures are queryable through health\\n        expect(health.value.failures.length).toBeGreaterThan(0);\\n        const smoothedFailure = health.value.failures.find((f) => f.form === \\\"smoothed_prompt\\\");\\n        expect(smoothedFailure).toBeDefined();\\n\\n        await connector.handlers.session_shutdown(ctx, { reason: \\\"shutdown\\\" });\\n      } finally {\\n        store.cleanup();\\n      }\\n    });\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"output_tokens\":0},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"a10094db-b1fb-4175-b007-bb5af83ee62f\",\"uuid\":\"a2295e01-6a51-482b-b5e5-55652b8d5e1e\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/06-startup-validation-and-assignment-config/streams/005-continue.stdout.log:7840:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_c1cd119cea0641c99c638fca\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/inference/startup-validation.test.ts has been updated successful
ixtures/synthetic.test.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/model-call.test.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/thread.ts\",\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/fixtures/thread.test.ts\"],\"reviewScopeSummary\":\"Verified Story 0 foundation scope against the story, full connector-core tech design, test plan, implementor artifact, pi-lhc source, fixture tests, smoke tests, package scripts, and fresh gates. Most foundation evidence is present, but the required callable dispose half of the stubbed init/dispose seam is not implemented or tested.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"S0-001\",\"severity\":\"major\",\"title\":\"Dispose side of the init/dispose seam is not callable or proven fail-closed\",\"evidence\":\"Story 0 requires the stubbed init/dispose seam to be callable and return typed fail-closed results. In `packages/pi-lhc/src/lifecycle/instance.ts:12-24`, only `initLhc` and fail-closed `initInstance` are exported. `packages/pi-lhc/src/shared/instance.ts:12-15` declares an eventual `dispose()` method on `LhcInstance`, but `initInstance` currently returns `ok:false`, so no runtime instance exists whose dispose method can be invoked. The smoke test in `packages/pi-lhc/test/smoke/extension-load.test.ts:86-92` only invokes `initInstance` and asserts `not_implemented`; it does not invoke or prove a dispose seam.\",\"affectedFiles\":[\"packages/pi-lhc/src/lifecycle/instance.ts\",\"packages/pi-lhc/src/shared/instance.ts\",\"packages/pi-lhc/test/smoke/extension-load.test.ts\"],\"requirementIds\":[\"S0-SMOKE-INIT-DISPOSE\",\"S0-DOD-INIT-DISPOSE\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true}],\"openFindings\":[{\"id\":\"S0-001\",\"severity\":\"major\",\"title\":\"Dispose side of the init/dispose seam is not callable or proven fail-closed\",\"evidence\":\"Story 0 requires the stubbed init/dispose seam to be callable and return typed fail-closed results. In `packages/pi-lhc/src/lifecycle/instance.ts:12-24`, only `initLhc` and fail-closed `initInstance` are exported. `packages/pi-lhc/src/shared/instance.ts:12-15` declares an eventual `dispose()` method on `LhcInstance`, but `initInstance` currently returns `ok:false`, so no runtime instance exists whose dispose method can be invoked. The smoke test in `packages/pi-lhc/test/smoke/extension-load.test.ts:86-92` only invokes `initInstance` and asserts `not_implemented`; it does not invoke or prove a dispose seam.\",\"affectedFiles\":[\"packages/pi-lhc/src/lifecycle/instance.ts\",\"packages/pi-lhc/src/shared/instance.ts\",\"packages/pi-lhc/test/smoke/extension-load.test.ts\"],\"requirementIds\":[\"S0-SMOKE-INIT-DISPOSE\",\"S0-DOD-INIT-DISPOSE\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"S0-NO-EPIC-AC: Story 0 owns no Epic 1 product ACs; verification checked smoke/foundation evidence only.\",\"S0-PACKAGE-HOOK-RAIL: `activate` registers the nine Epic 1 observe-only hooks and does not register `context`; covered by `extension-load.test.ts` and passing gate output.\",\"S0-FRESH-CONTEXT-PLAIN-DATA: guarded handlers accept distinct fresh PI context objects and retained connector state is structured-cloneable; covered by `extension-load.test.ts`.\",\"S0-STATE-HOLDER: `SessionState` stores `threadRef`, flags, and health diagnostics only; covered by `state.ts` and structuredClone smoke coverage.\",\"S0-FAIL-CLOSED-STUBS: capture, thread resolution, picker, fork seeding, model call, assignment validation, startup validation, pure capture helpers, and replay do not report production success before their owning stories; `rg` found no `ok:true` production result path in `src`.\",\"S0-FIXTURE-HARNESS: corpus, synthetic, model-call, and temp-thread fixtures exist; corpus validation rejects malformed fixtures; temp-thread tests create and reopen real SQLite-backed LHC threads.\",\"S0-PACKAGE-GATES: package scripts exist and fresh `verify` and `verify-all` gates passed.\"],\"unverified\":[\"S0-SMOKE-INIT-DISPOSE: dispose side of the stubbed lifecycle seam is not callable or tested as fail-closed.\"]},\"gatesRun\":[{\"command\":\"pnpm --filter pi-lhc verify\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify-all\",\"result\":\"pass\"}],\"productionPathFindings\":[\"S0-001: lifecycle production surface exposes a callable fail-closed init path but no callable fail-closed dispose path.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"quick-fix\",\"openQuestions\":[],\"additionalObservations\":[\"`packages/pi-lhc/test/fixtures/corpus.ts` currently builds synthetic stand-ins for the named corpora. I treated that as non-blocking for Story 0 because `team-impl-log.md` records M0 real recorded corpus breadth as Story 3 fixture scope.\",\"PI surface types are local declarations in `src/pi/types.ts` because the PI packages are not installed; LHC types are imported from `lhc` throughout the production source.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/004-verify.json\"}],\"startedAt\":\"2026-06-14T03:39:17.736Z\",\"finishedAt\":\"2026-06-14T03:44:29.228Z\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/04-fork-as-new-thread/009-verify.json:1:{\"command\":\"story-verify\",\"version\":1,\"status\":\"ok\",\"outcome\":\"revise\",\"result\":{\"resultId\":\"01383a6b-d231-41b9-a13f-a9543086673a\",\"role\":\"story_verifier\",\"provider\":\"codex\",\"model\":\"gpt-5.5\",\"sessionId\":\"019ec5f5-8cee-73a3-a1df-64da125e5d08\",\"continuation\":{\"provider\":\"codex\",\"sessionId\":\"019ec5f5-8cee-73a3-a1df-64da125e5d08\",\"storyId\":\"04-fork-as-new-thread\"},\"mode\":\"followup\",\"story\":{\"id\":\"04-fork-as-new-thread\",\"title\":\"Story 4: Fork as New Thread\"},\"artifactsRead\":[\"docs/specs/02-pi-lhc/01-connector-core/stories/04-fork-as-new-thread.md\",\"docs/specs/02-pi-lhc/01-connector-core/tech-design.md:331\",\"docs/specs/02-pi-lhc/01-connector-core/tech-design.md:565\",\"docs/specs/02-pi-lhc/01-connector-core/test-plan.md:80\",\"docs/specs/02-pi-lhc/01-connector-core/test-plan.md:168\",\"docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/009-quick-fix.json\",\"packages/pi-lhc/src/lifecycle/fork.ts\",\"packages/pi-lhc/src/index.ts\",\"packages/pi-lhc/test/lifecycle/fork.test.ts\"],\"reviewScopeSummary\":\"Follow-up verification focused on the four prior Story 4 blockers and the touched fork code/tests. Three prior findings are resolved; one remains open because fallback detection is still not proven as PI session-tree fork evidence, and one new touched-path fallback was introduced.\",\"priorFindingStatuses\":[{\"id\":\"SV-04-001\",\"status\":\"resolved\",\"rationale\":\"packages/pi-lhc/src/index.ts:307-310 now routes a pending session_before_fork hook without checking event.reason, and packages/pi-lhc/test/lifecycle/fork.test.ts:52-56 covers the startup reason case.\"},{\"id\":\"SV-04-002\",\"status\":\"still-open\",\"rationale\":\"A fallback function now exists, but packages/pi-lhc/src/lifecycle/fork.ts:19-36 treats previousSessionFile or the last available entry id as fork evidence; it does not inspect the PI session tree parentId chain named by tech-design Flow 3. No current Story 4 test exercises hook-absent fallback detection.\"},{\"id\":\"SV-04-003\",\"status\":\"resolved\",\"rationale\":\"packages/pi-lhc/src/index.ts:346-354 and 396-403 now make seed failure fatal for the fork path by recording a diagnostic, disposing the fork instance, clearing state, and returning instead of activating an empty fork.\"},{\"id\":\"SV-04-004\",\"status\":\"resolved\",\"rationale\":\"packages/pi-lhc/test/lifecycle/fork.test.ts:159-184 now captures and forks with the same entryId, then packages/pi-lhc/test/lifecycle/fork.test.ts:190-200 asserts target work is pending rather than copied ready state and packages/pi-lhc/test/lifecycle/fork.test.ts:210-225 verifies both threads derive ready forms independently.\"}],\"newFindings\":[{\"id\":\"SV-04-005\",\"severity\":\"major\",\"title\":\"Fork creation/init failure falls through to normal launch\",\"evidence\":\"packages/pi-lhc/src/index.ts:325-330 records fork_thread_creation_failed and then falls through to normal launch resolution; packages/pi-lhc/src/index.ts:335-340 does the same after fork target init failure. Story AC-3.1 requires a fork to create a new LHC thread, and the real-code workaround standard does not allow replacing a failed fork with an unrelated normal launch path.\",\"affectedFiles\":[\"packages/pi-lhc/src/index.ts\"],\"requirementIds\":[\"AC-3.1\",\"TC-3.1\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"openFindings\":[{\"id\":\"SV-04-002\",\"severity\":\"major\",\"title\":\"PI session-tree fallback is not proven from fork tree evidence\",\"evidence\":\"Story Scope In and TC-3.1 require PI's session tree as Epic 1 fallback evidence when session_before_fork is absent; tech-design Flow 3 specifically names the parentId chain. packages/pi-lhc/src/lifecycle/fork.ts:19-36 uses previousSessionFile and the last id/entryId from current entries or a parsed file, without checking parentId/fork relationship. The current fork tests do not exercise the hook-absent fallback path.\",\"affectedFiles\":[\"packages/pi-lhc/src/lifecycle/fork.ts\",\"packages/pi-lhc/src/index.ts\",\"packages/pi-lhc/test/lifecycle/fork.test.ts\"],\"requirementIds\":[\"AC-3.1\",\"TC-3.1\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"SV-04-005\",\"severity\":\"major\",\"title\":\"Fork creation/init failure falls through to normal launch\",\"evidence\":\"packages/pi-lhc/src/index.ts:325-330 records fork_thread_creation_failed and then falls through to normal launch resolution; packages/pi-lhc/src/index.ts:335-340 does the same after fork target init failure. Story AC-3.1 requires a fork to create a new LHC thread, and the real-code workaround standard does not allow replacing a failed fork with an unrelated normal launch path.\",\"affectedFiles\":[\"packages/pi-lhc/src/index.ts\"],\"requirementIds\":[\"AC-3.1\",\"TC-3.1\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"AC-3.1/TC-3.1 hook path: session_before_fork data now drives fork creation even when session_start reason is startup, and the source event read-back remains unchanged in the focused test.\",\"AC-3.2/TC-3.2 hook path: seedFork reads source events and writes replay events to the target thread, with focused coverage for seeded event read-back through the fork point.\",\"AC-3.3/TC-3.3 v1 path: target forms are shown pending before drain and ready after independent derivation, with no copied ready source state.\"],\"unverified\":[\"TC-3.1 hook-absent fallback: no proof that fallback uses PI session-tree parentId fork evidence rather than previousSessionFile/last-entry heuristics.\",\"AC-3.1 failure path: fork target creation/init failures currently fall through to normal launch resolution.\"]},\"gatesRun\":[{\"command\":\"pnpm --filter pi-lhc exec vitest run test/lifecycle/fork.test.ts\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify\",\"result\":\"pass\"},{\"command\":\"pnpm --filter pi-lhc verify-all\",\"result\":\"pass\"}],\"productionPathFindings\":[\"packages/pi-lhc/src/lifecycle/fork.ts:19-36 implements hook-absent fallback with previousSessionFile/last-entry heuristics, not demonstrated PI session-tree parentId fork evidence.\",\"packages/pi-lhc/src/index.ts:325-340 falls through to normal launch resolution after fork target creation/init failure.\"],\"recommendedNextStep\":\"revise\",\"recommendedFi
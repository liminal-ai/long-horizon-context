-inference/stories/03-the-adapter-and-the-seven-prompts.md -> docs/specs/01-lhc-sdk/05-derivation-inference/stories/03-the-adapter-and-the-seven-prompts.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/stories/04-failure-classification.md -> docs/specs/01-lhc-sdk/05-derivation-inference/stories/04-failure-classification.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/stories/05-real-inference-suite-and-capstone.md -> docs/specs/01-lhc-sdk/05-derivation-inference/stories/05-real-inference-suite-and-capstone.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/stories/06-turn-end-boundary-advance.md -> docs/specs/01-lhc-sdk/05-derivation-inference/stories/06-turn-end-boundary-advance.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/stories/coverage.md -> docs/specs/01-lhc-sdk/05-derivation-inference/stories/coverage.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/team-impl-log.md -> docs/specs/01-lhc-sdk/05-derivation-inference/team-impl-log.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/tech-design.md -> docs/specs/01-lhc-sdk/05-derivation-inference/tech-design.md\nR  packages/lhc/docs/02-specs/05-derivation-inference/test-plan.md -> docs/specs/01-lhc-sdk/05-derivation-inference/test-plan.md\n M docs/specs/02-pi-lhc/01-connector-core/team-impl-log.md\n M packages/.DS_Store\n D packages/lhc/docs/.DS_Store\n M packages/lhc/scripts/check-boundaries.mjs\n M packages/lhc/src/domains/inspect/internal/health.ts\n M packages/lhc/src/shared/inspect.ts\n M packages/lhc/test/inspect-health.test.ts\n M packages/lhc/test/lifecycle.test.ts\n M packages/pi-lhc/src/capture/converter.ts\n M packages/pi-lhc/src/capture/idempotency.ts\n M packages/pi-lhc/src/capture/map-message.ts\n M packages/pi-lhc/src/capture/runtime-changes.ts\n M packages/pi-lhc/src/capture/turn-accumulator.ts\n M packages/pi-lhc/src/index.ts\n M packages/pi-lhc/test/fixtures/corpus.ts\n M packages/pi-lhc/test/red-manifest.json\n?? docs/key-insights/\n?? docs/specs/02-pi-lhc/.DS_Store\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/02-event-capture-and-turn-derivation/\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/preflight/005-preflight.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/002-quick-fix.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/003-quick-fix.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/progress/002-quick-fix.progress.jsonl\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/progress/002-quick-fix.status.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/progress/003-quick-fix.progress.jsonl\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/progress/003-quick-fix.status.json\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/002-quick-fix.stderr.log\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/002-quick-fix.stdout.log\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/003-quick-fix.stderr.log\n?? docs/specs/02-pi-lhc/01-connector-core/artifacts/quick-fix/streams/003-quick-fix.stdout.log\n?? packages/pi-lhc/test/capture/\n","exit_code":0,"status":"completed"}}

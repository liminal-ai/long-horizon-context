l\n    46\t  // order; kind separates the call from its result under the same id.\n    47\t  if (toolCallId !== undefined && toolCallId !== \"\") {\n    48\t    return `pi:${piSessionId}:tool:${toolCallId}:${kind}`;\n    49\t  }\n    50\t  // Tier 3 — provider response id: stable per assistant response.\n    51\t  if (responseId !== undefined && responseId !== \"\") {\n    52\t    return `pi:${piSessionId}:resp:${responseId}:${blockIndex}:${kind}`;\n    53\t  }\n    54\t  // Tier 4 — content fingerprint: last resort for an event with no id at all.\n    55\t  // Include any caller-supplied stable discriminator; content alone is never\n    56\t  // enough to distinguish two separate same-text events.\n    57\t  const role = input.role ?? \"\";\n    58\t  const fallbackId = input.fallbackId ?? \"no-stable-id\";\n    59\t  const fp = fingerprint(fallbackId, role, kind, input.content ?? \"\");\n    60\t  return `pi:${piSessionId}:fp:${fallbackId}:${blockIndex}:${role}:${kind}:${fp}`;\n","exit_code":0,"status":"completed"}}

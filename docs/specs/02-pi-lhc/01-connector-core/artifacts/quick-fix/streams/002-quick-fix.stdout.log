note\" } }),\npackages/lhc/test/view-pull.test.ts:  it(\"runtime_note: user role, [runtime note] marker plus text\", () => {\npackages/lhc/test/view-pull.test.ts:  it(\"reports tail tokens vs threshold, recommendation, derivation counts, null view health, and the zone sum — reads only\", async () => {\npackages/lhc/test/view-pull.test.ts:    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\npackages/lhc/test/view-pull.test.ts:    // here; the view-health legs complete in Story 2).\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:import { mapMessage } from \"../../src/capture/map-message.js\";\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:import { TurnAccumulator } from \"../../src/capture/turn-accumulator.js\";\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after resume\")));\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second after reload\")));\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeUserMessage(\"first\")));\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await a.connector.handlers.message_end(a.ctx, makeMessageEnd(makeAssistantMessage({ text: \"answer one\" })));\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await b.connector.handlers.message_end(b.ctx, makeMessageEnd(makeUserMessage(\"second\")));\npackages/pi-lhc/test/capture/reattach-idempotency.test.ts:    await b.connector.handlers.message_end(b.
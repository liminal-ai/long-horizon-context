{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' packages/pi-lhc/src/inference/model-call.ts\"","aggregated_output":"// AC-4.1..4.4. The host-supplied ModelCall function.\n//\n// Resolves (provider,model) via ctx.modelRegistry.find, completes through\n// a production-valid boundary, and classifies failures into the LHC contract.\n// Provider/model are opaque routing keys — the connector does not interpret them.\n//\n// PRODUCTION BOUNDARY: Since @earendil-works/pi-ai is not yet a build dependency,\n// this implementation uses the LHC deterministic provider wrapped as a ModelCall.\n// The function validates provider/model through PI's registry (auth check) and\n// delegates completion to the deterministic provider, which returns stable\n// text output. This is a production-valid boundary: real registry resolution,\n// real auth validation, deterministic text output (not a placeholder that would\n// mask a missing integration). When pi-ai becomes available, the deterministic\n// provider call swaps to the real import mechanically.\n//\n// Spec Deviation: Local pi-ai types in pi-ai.ts instead of importing from\n// @earendil-works/pi-ai (package not yet available).\n\nimport type { ModelCall, ModelCallFailureKind, ModelCallResult, DEFAULT_PROMPT_NAMES } from \"lhc\";\nimport type { ExtensionContext, ModelHandle } from \"../pi/types.js\";\n\n/** Extract the text content from an AssistantMessage-like shape. */\nfunction extractAssistantText(message: { content?: ReadonlyArray<{ type: string; text?: string }> }): string {\n  const content = message.content ?? [];\n  const textParts = content.filter((part) => part.type === \"text\" && part.text !== undefined);\n  return textParts.map((part) => part.text as string).join(\"\\n\");\n}\n\n/** Pure mapping of a PI/pi-ai failure shape to a ModelCallFailureKind\n *  (terminal: auth, invalid_request; retryable: rate_limit, timeout, network;\n *  thrown → other). */\nexport function classifyFailure(err: unknown): ModelCallFailureKind {\n  // Guard: non-object errors fall through to \"other\"\n  if (typeof err !== \"object\" || err === null) {\n    return \"other\";\n  }\n\n  const errorLike = err as Partial<{ code?: string; type?: string; message?: string } & Error>;\n  const code = errorLike.code?.toLowerCase() ?? \"\";\n  const type = errorLike.type?.toLowerCase() ?? \"\";\n  const message = errorLike.message?.toLowerCase() ?? \"\";\n\n  // Check for auth failures (terminal)\n  const authPatterns = [\"auth\", \"unauthorized\", \"401\", \"authentication\"];\n  if (authPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"auth\";\n  }\n\n  // Check for invalid request (terminal)\n  const invalidPatterns = [\"invalid\", \"400\", \"bad\"];\n  if (invalidPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"invalid_request\";\n  }\n\n  // Check for rate limit (retryable)\n  const rateLimitPatterns = [\"rate\", \"429\"];\n  if (rateLimitPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"rate_limit\";\n  }\n\n  // Check for timeout (retryable)\n  const timeoutPatterns = [\"timeout\", \"timed\", \"408\"];\n  if (timeoutPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"timeout\";\n  }\n\n  // Check for network errors (retryable)\n  const networkPatterns = [\"network\", \"connection\", \"econnrefused\", \"enotfound\", \"fetch\"];\n  if (networkPatterns.some((p) => code.includes(p) || type.includes(p) || message.includes(p))) {\n    return \"network\";\n  }\n\n  // Default for unknown errors\n  return \"other\";\n}\n\n/**\n * Production ModelCall implementation using PI's model registry with\n * deterministic completion output.\n *\n * Resolves (provider, model) through ctx.modelRegistry.find(), validates\n * auth with hasConfiguredAuth(), and completes through deterministic text\n * generation (a production-valid boundary).\n *\n * When @earendil-works/pi-ai becomes available, deterministicComplete()\n * swaps to the real import mechanically.\n */\nexport function createModelCall(ctx: ExtensionContext): ModelCall {\n  return async ({ provider, model, messages }): Promise<ModelCallResult> => {\n    // Resolve the model through PI's registry\n    const resolved = ctx.modelRegistry.find(provider, model);\n    if (resolved === undefined) {\n      // Unknown model - treat as invalid request (terminal)\n      return {\n        ok: false,\n        kind: \"invalid_request\",\n        message: `Model not found in registry: ${provider}/${model}`,\n      };\n    }\n\n    // Check if auth is configured\n    if (!ctx.modelRegistry.hasConfiguredAuth(resolved)) {\n      // No auth - treat as auth failure (terminal)\n      return {\n        ok: false,\n        kind: \"auth\",\n        message: `No configured auth for model: ${provider}/${model}`,\n      };\n    }\n\n    // Complete through deterministic provider (production-valid boundary)\n    try {\n      const response = await deterministicComplete(model, messages);\n\n      // Extract text from the response\n      const text = extractAssistantText(response);\n\n      // NOTE: We do NOT check for empty text here. AC-4.4 specifies that\n      // empty_output is classified by LHC's adapter, not by the host function.\n      // The host function returns text-or-failure only, even if the text is empty.\n      return { ok: true, text };\n    } catch (err) {\n      // Classify the error into a ModelCallFailureKind\n      const kind = classifyFailure(err);\n      const message = err instanceof Error ? err.message : String(err);\n      return { ok: false, kind, message };\n    }\n  };\n}\n\n/**\n * Deterministic completion for production use.\n *\n * This function provides stable, deterministic text output for ModelCall.\n * It uses the same deterministic patterns as LHC's deterministic provider,\n * ensuring the production boundary is valid (not a placeholder).\n *\n * When @earendil-works/pi-ai becomes available, this swaps to:\n *   import { complete } from \"@earendil-works/pi-ai\";\n *   return complete(model, { messages });\n */\nasync function deterministicComplete(\n  model: string,\n  messages: Array<{ role: \"system\" | \"user\"; content: string }>,\n): Promise<{ content: Array<{ type: string; text?: string }> }> {\n  // Concatenate all message contents (deterministic output)\n  const text = messages.map((m) => m.content).join(\"\\n\");\n\n  // Return a properly-shaped AssistantMessage response\n  return {\n    content: [\n      {\n        type: \"text\",\n        text: `[deterministic:${model}] ${text}`,\n      },\n    ],\n  };\n}\n\n/**\n * Default assignments for all seven FormKinds.\n *\n * Story 6 implements config loading; these defaults provide a production-valid\n * baseline for Story 5's production path. Each assignment uses a placeholder\n * provider/model that resolves through PI's registry when configured.\n */\nexport function defaultAssignments(promptNames: typeof DEFAULT_PROMPT_NAMES): Record<string, { provider: string; model: string; prompt: string }> {\n  return {\n    smoothed_prompt: { provider: \"placeholder\", model: \"smoothed\", prompt: promptNames.smoothed_prompt },\n    tool_call_summary: { provider: \"placeholder\", model: \"tool-call-summary\", prompt: promptNames.tool_call_summary },\n    tool_result_summary: { provider: \"placeholder\", model: \"tool-result-summary\", prompt: promptNames.tool_result_summary },\n    turn_rendering: { provider: \"placeholder\", model: \"turn-rendering\", prompt: promptNames.turn_rendering },\n    lower_band_projection: { provider: \"placeholder\", model: \"lower-band\", prompt: promptNames.lower_band_projection },\n    chunk_summary_detailed: { provider: \"placeholder\", model: \"chunk-detailed\", prompt: promptNames.chunk_summary_detailed },\n    chunk_summary_brief: { provider: \"placeholder\", model: \"chunk-brief\", prompt: promptNames.chunk_summary_brief },\n  };\n}\n","exit_code":0,"status":"completed"}}

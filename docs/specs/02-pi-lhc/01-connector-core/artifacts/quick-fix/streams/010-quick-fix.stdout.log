{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,380p' packages/pi-lhc/test/inference/closed-loop.test.ts\"","aggregated_output":"// TC-4.5: Closed-loop proof — captured thread's queued derivation invokes the\n// injected ModelCall function and persists outcomes queryable through\n// inspect/health.\n//\n// This test proves the full capture → derivation → recorded-outcome loop, not\n// just the function in isolation. It:\n// 1. Captures content to a thread (through the real converter)\n// 2. Wires a deterministic ModelCall (one returns text, one returns failure)\n// 3. Awaits drainSettled to flush background work\n// 4. Asserts both ready forms and classified failures exist in the thread\n//\n// Architecture-risk test: concurrency/lost-update — a stale background result does\n// not clobber newer thread state.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createDeterministicProvider,\n  inspect,\n  intakeStream,\n  threads,\n  DEFAULT_PROMPT_NAMES,\n  type FormKind,\n  type InferenceConfig,\n  type ModelAssignment,\n  type ModelCall,\n  type ModelCallFailureKind,\n  type ModelCallResult,\n  type SdkConfig,\n  type ThreadRef,\n} from \"lhc\";\nimport { createConnector, type Connector } from \"../../src/index.js\";\nimport type { ExtensionContext } from \"../../src/pi/types.js\";\nimport { makeUserMessage, makeAssistantMessage, makeAgentEnd } from \"../fixtures/synthetic.js\";\nimport type { TempStore } from \"../fixtures/thread.js\";\nimport { tempStore } from \"../fixtures/thread.js\";\nimport { fakeModelCallRouter, fakeModelCallText, fakeModelCallFailure } from \"../fixtures/model-call.js\";\n\ndescribe(\"Story 5: Inference Host Routing — Closed Loop (TC-4.5)\", () => {\n  let store: TempStore;\n  let connector: Connector;\n  let ctx: ExtensionContext;\n  let threadRef: ThreadRef | null;\n\n  beforeEach(async () => {\n    store = tempStore();\n    threadRef = null;\n\n    // Synthetic headless context\n    ctx = {\n      cwd: \"/test/closed-loop\",\n      hasUI: false,\n      modelRegistry: {\n        find: (provider: string, model: string) => {\n          // Recognize both openai and anthropic models\n          if (provider === \"openai\" && model === \"gpt-4o-mini\") {\n            return { provider, id: model };\n          }\n          if (provider === \"anthropic\" && model === \"claude-3\") {\n            return { provider, id: model };\n          }\n          return undefined;\n        },\n        hasConfiguredAuth: (model: { provider: string; id: string }) => {\n          // All models have auth configured in tests\n          return true;\n        },\n        getAvailable: () => [],\n      },\n      ui: { notify: () => {} },\n      sessionManager: { getEntries: () => [] },\n    };\n  });\n\n  afterEach(async () => {\n    if (connector !== null && threadRef !== null) {\n      try {\n        await connector.handlers.session_shutdown(ctx, { reason: \"shutdown\" });\n      } catch (e) {\n        // Ignore cleanup errors in tests\n        console.warn(\"Cleanup error:\", e);\n      }\n    }\n    store.cleanup();\n  });\n\n  describe(\"TC-4.5: Capture → derivation → recorded-outcome loop\", () => {\n    it(\"captured thread's queued derivation invokes function and persists ready form + classified failure\", async () => {\n      // TC-4.5 requires ONE ready derived form AND ONE classified failure,\n      // both queryable through inspect/health.\n      //\n      // Simplified approach: Use a ModelCall that returns failure for one\n      // specific provider/model pair, and text for others.\n\n      const modelCall = fakeModelCallText(\"derived text\");\n\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      // Create connector with our inference config\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      // Start a new session\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture content — a user prompt and assistant response (one turn)\n      // This queues derivation work\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"please summarize this file\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"here is the summary\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage({ text: \"here is the summary\" })],\n      });\n\n      // Get the instance and drain the background scheduler\n      const instance = connector.getInstance();\n      expect(instance).not.toBeNull();\n      if (!instance) return;\n\n      // Await drainSettled — all derivations complete or fail\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query inspect.health for derivation outcomes\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (!health.ok) return;\n\n      const report = health.value;\n\n      // Assert: at least ONE ready derived form exists\n      // Health report has owners array with counts per kind\n      const readyOwners = report.owners.filter((o) => o.counts.ready > 0);\n      expect(readyOwners.length).toBeGreaterThan(0);\n\n      // The loop is proven: capture → derivation → recorded outcome\n      // (ready forms exist and are queryable through inspect/health)\n    }, 30000); // Increase timeout to 30s for this test\n\n    it(\"persists classified failure when ModelCall returns failure\", async () => {\n      // This test verifies that when a ModelCall returns a failure,\n      // the failure is persisted and queryable through inspect/health.\n\n      const modelCall = fakeModelCallFailure(\"rate_limit\", \"Rate limited\");\n\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture a turn\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"test prompt\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"test response\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage()],\n      });\n\n      const instance = connector.getInstance();\n      if (!instance) return;\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query health and verify failures are recorded\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (health.ok) {\n        // Should have failed forms\n        const failedOwners = health.value.owners.filter((o) => o.counts.failed > 0);\n        expect(failedOwners.length).toBeGreaterThan(0);\n\n        // Should have rate_limit failures\n        const rateLimitFailures = health.value.failures.filter(\n          (f) => f.reason.includes(\"rate_limit\"),\n        );\n        expect(rateLimitFailures.length).toBeGreaterThan(0);\n      }\n    });\n\n    it(\"verify outcomes are queryable through inspect (not just internal state)\", async () => {\n      // This test verifies the same loop but asserts specifically on the\n      // inspect surface, proving outcomes are queryable (not just internal)\n      const modelCall = fakeModelCallText(\"success\");\n      const assignments: Record<FormKind, ModelAssignment> = {\n        smoothed_prompt: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n        tool_call_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n        tool_result_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n        turn_rendering: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n        lower_band_projection: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n        chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n        chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n      };\n\n      const inferenceConfig: InferenceConfig = {\n        call: modelCall,\n        assignments,\n      };\n\n      const sdkConfig: SdkConfig = {\n        inference: inferenceConfig,\n        mode: \"background\",\n      };\n\n      connector = createConnector({\n        registryPath: store.registryPath,\n        newThreadFilePath: () => store.threadPath(),\n        buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n      });\n\n      await connector.handlers.session_start(ctx, { reason: \"new\" });\n      const state = connector.getState();\n      expect(state).not.toBeNull();\n      if (!state) return;\n      threadRef = state.threadRef;\n\n      // Capture a turn\n      await connector.handlers.message_end(ctx, {\n        message: makeUserMessage(\"test prompt\"),\n        entryId: \"entry-1\",\n      });\n      await connector.handlers.message_end(ctx, {\n        message: makeAssistantMessage({ text: \"test response\" }),\n        entryId: \"entry-2\",\n      });\n      await connector.handlers.agent_end(ctx, {\n        messages: [makeUserMessage(), makeAssistantMessage()],\n      });\n\n      const instance = connector.getInstance();\n      if (!instance) return;\n      await instance.sdk.drainSettled(threadRef);\n\n      // Query through inspect\n      const health = await inspect.health(threadRef);\n      expect(health.ok).toBe(true);\n      if (health.ok) {\n        // Health report contains owners with form counts\n        expect(health.value.owners).toBeInstanceOf(Array);\n        expect(health.value.owners.length).toBeGreaterThan(0);\n      }\n\n      const overview = await inspect.overview(threadRef);\n      expect(overview.ok).toBe(true);\n      if (overview.ok) {\n        // Overview shows turn count\n        expect(overview.value.turns.closed).toBeGreaterThan(0);\n      }\n    });\n\n    describe(\"Architecture-risk: Concurrency / Lost Update\", () => {\n      it(\"stale background derivation result does not clobber newer thread state\", async () => {\n        // This test verifies that a stale result from the background scheduler\n        // does not overwrite newer state. LHC owns this guarantee, but the test\n        // proves the connector's wiring doesn't break it.\n\n        const modelCall = fakeModelCallText(\"result\");\n\n        const assignments: Record<FormKind, ModelAssignment> = {\n          smoothed_prompt: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt },\n          tool_call_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_call_summary },\n          tool_result_summary: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.tool_result_summary },\n          turn_rendering: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.turn_rendering },\n          lower_band_projection: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.lower_band_projection },\n          chunk_summary_detailed: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_detailed },\n          chunk_summary_brief: { provider: \"openai\", model: \"gpt-4o-mini\", prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief },\n        };\n\n        const inferenceConfig: InferenceConfig = {\n          call: modelCall,\n          assignments,\n        };\n\n        const sdkConfig: SdkConfig = {\n          inference: inferenceConfig,\n          mode: \"background\",\n        };\n\n        connector = createConnector({\n          registryPath: store.registryPath,\n          newThreadFilePath: () => store.threadPath(),\n          buildSdkConfig: () => ({ ok: true, value: sdkConfig }),\n        });\n\n        await connector.handlers.session_start(ctx, { reason: \"new\" });\n        const state = connector.getState();\n        expect(state).not.toBeNull();\n        if (!state) return;\n        threadRef = state.threadRef;\n\n        // Capture a turn\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"first prompt\"),\n          entryId: \"entry-1\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"first response\" }),\n          entryId: \"entry-2\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        const instance = connector.getInstance();\n        if (!instance) return;\n\n        // Drain first round\n        await instance.sdk.drainSettled(threadRef);\n\n        // Capture another turn (newer state)\n        await connector.handlers.message_end(ctx, {\n          message: makeUserMessage(\"second prompt\"),\n          entryId: \"entry-3\",\n        });\n        await connector.handlers.message_end(ctx, {\n          message: makeAssistantMessage({ text: \"second response\" }),\n          entryId: \"entry-4\",\n        });\n        await connector.handlers.agent_end(ctx, {\n          messages: [makeUserMessage(), makeAssistantMessage()],\n        });\n\n        // Drain second round\n","exit_code":0,"status":"completed"}}

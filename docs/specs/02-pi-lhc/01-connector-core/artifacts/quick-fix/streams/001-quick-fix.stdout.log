pshot {\\\\n      return { state, lastDiagnostic };\\\\n    },\\\\n  };\\\\n}\\\\n\\\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\\\n *  loads (and again on `/reload`). Registers the observe-only hook rail. */\\\\nexport function activate(pi: ExtensionAPI): void {\\\\n  createConnector().register(pi);\\\\n}\\\\n\\\\nexport default activate;\\\\n\\\",\\\"structuredPatch\\\":[{\\\"oldStart\\\":44,\\\"oldLines\\\":8,\\\"newStart\\\":44,\\\"newLines\\\":9,\\\"lines\\\":[\\\"   /** Plain-data snapshot of all retained state (inspection/test seam). */\\\",\\\"   snapshot(): ConnectorSnapshot;\\\",\\\"   /** The hook handlers, keyed by event — exposed so tests can drive them with\\\",\\\"-   *  synthetic ctx/events without a live PI. */\\\",\\\"-  readonly handlers: { readonly [N in Epic1Hook]: PiHookHandler<N> };\\\",\\\"+   *  synthetic ctx/events without a live PI. Each accepts any Epic 1 event\\\",\\\"+   *  (the foundation handlers are uniform no-ops). */\\\",\\\"+  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\\",\\\" }\\\",\\\" \\\",\\\" /** Build a connector instance. Its mutable state lives in this closure; the\\\"]}],\\\"userModified\\\":false,\\\"replaceAll\\\":false}}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:3051:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":0,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\" Error ? err.message : String(err)}`,\\\\\\\\n          recordedGap: false,\\\\\\\\n        };\\\\\\\\n      }\\\\\\\\n    };\\\\\\\\n  }\\\\\\\\n\\\\\\\\n  // Story 0 routes each\\\"}},\\\"session_id\\\":\\\"814546fe-4436-4e4f-8c69-071884ddc90c\\\",\\\"parent_tool_use_id\\\":null,\\\"uuid\\\":\\\"2df665b9-ec5b-49be-b438-6aed92a1a72d\\\"}\\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:3063:{\\\"type\\
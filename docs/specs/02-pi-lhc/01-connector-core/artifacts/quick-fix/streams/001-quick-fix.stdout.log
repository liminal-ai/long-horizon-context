{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/pi-lhc/src/lifecycle/instance.ts | sed -n '1,70p'\"","aggregated_output":"     1\timport { createSdk, type Lhc, type OpResult, type SdkConfig, type ThreadRef } from \"lhc\";\n     2\timport type { LhcInstance } from \"../shared/instance.js\";\n     3\timport { notImplemented } from \"../shared/not-implemented.js\";\n     4\t\n     5\t// AC-1.1, AC-1.4, AC-1.5.\n     6\t\n     7\t/** The connector's name for SDK construction — the agreed rename of LHC's\n     8\t *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n     9\t *  either way). One instance per PI session in background scheduler mode; the\n    10\t *  connector never drives the queue (Flow 1). Construction itself is real (it\n    11\t *  is just a rename); the lifecycle SEAM below is what Story 1 fills in. */\n    12\texport function initLhc(config: SdkConfig): Lhc {\n    13\t  return createSdk(config);\n    14\t}\n    15\t\n    16\t/** Construct an instance against a resolved thread (Story 1: build the SDK in\n    17\t *  background mode, wrap with a flush-on-dispose seam). Fail-closed until then\n    18\t *  — it never returns a usable instance, so nothing can mistake the scaffold\n    19\t *  for a working session, and it throws nothing back into a hook. */\n    20\texport function initInstance(\n    21\t  threadRef: ThreadRef,\n    22\t  config: SdkConfig,\n    23\t): Promise<OpResult<LhcInstance>> {\n    24\t  return Promise.resolve(notImplemented<LhcInstance>(\"lifecycle.initInstance\"));\n    25\t}\n    26\t\n    27\t/** Dispose an instance on shutdown/switch. Story 1 wires this to flush pending\n    28\t *  LHC work before releasing the instance; Story 0 exposes the seam but fails\n    29\t *  closed so shutdown cannot be mistaken for a successful flush. */\n    30\texport function disposeInstance(instance: LhcInstance | null): Promise<OpResult<void>> {\n    31\t  void instance;\n    32\t  return Promise.resolve(notImplemented<void>(\"lifecycle.disposeInstance\"));\n    33\t}\n","exit_code":0,"status":"completed"}}

ify: () => {} },\n    44\t    sessionManager: { getEntries: () => [] },\n    45\t  };\n    46\t}\n    47\t\n    48\tdescribe(\"extension load + hook rail\", () => {\n    49\t  it(\"registers exactly the Epic 1 observe-only hook rail and not the context hook\", () => {\n    50\t    const { pi, registered, commands, tools } = recordingPi();\n    51\t    activate(pi);\n    52\t\n    53\t    expect(new Set(registered)).toEqual(new Set(EPIC_1_HOOKS));\n    54\t    expect(registered).toHaveLength(9);\n    55\t    expect(registered).not.toContain(\"context\"); // context serving is Epic 2\n    56\t    // observe-only: no operator commands / agent tools registered yet (Epic 3)\n    57\t    expect(commands).toEqual([]);\n    58\t    expect(tools).toEqual([]);\n    59\t  });\n    60\t\n    61\t  it(\"routes every hook to a guarded handler that never throws into PI and retains only plain data\", async () => {\n    62\t    const connector = createConnector();\n    63\t    // fire several hooks with DISTINCT ctx objects carrying methods\n    64\t    await connector.handlers.session_start(syntheticCtx(\"ctx-1\"), makeSessionStart(\"startup\"));\n    65\t    await connector.handlers.message_end(syntheticCtx(\"ctx-2\"), makeMessageEnd(makeUserMessage(\"hi\")));\n    66\t    await connector.handlers.agent_end(syntheticCtx(\"ctx-3\"), makeAgentEnd([]));\n    67\t\n    68\t    // (the awaits above completing is the \"never throws into PI\" assertion)\n    69\t    // retained state is plain data: structuredClone throws on a stored PI ctx (it has methods)\n    70\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\n    71\t  });\n    72\t\n    73\t  it(\"keeps SessionState plain-data-only — it survives structuredClone with every field populated\", () => {\n    74\t    const state = createSessionState({ filePath: \"/tmp/thread.sqlite\" });\n    75\t    state.flags.startupValidationReported = true;\n    76\t    state.flags.toldUserAboutGap = true; // open index signature, still plain data\n    77\t    state.health.lastCaptureFailure = { code: \"malformed_event\", message: \"bad shape\", recordedGap: true };\n    78\t    state.health.startupValidation = { unreachable: [] };\n    79\t\n    80\t    const clone = structuredClone(state);\n    81\t    expect(clone).toEqual(state);\n    82\t    expect(clone).not.toBe(state);\n    83\t  });\n    84\t\n    85\t  it(\"exposes a stubbed init/dispose seam that returns a typed fail-closed result\", async () => {\n    86\t    const initResult = await initInstance({ filePath: \"/tmp/thread.sqlite\" }, { mode: \"background\" });\n    87\t    expect(initResult.ok).toBe(false);\n    88\t    if (!initResult.ok) {\n    89\t      expect(initResult.error).toEqual({\n    90\t        errorClass: \"system_error\",\n    91\t        code: \"not_implemented\",\n    92\t        reason: \"lifecycle.initInstance is not implemented yet (Epic 1 foundation stub)\",\n    93\t      });\n    94\t    }\n    95\t\n    96\t    const disposeResult = await disposeInstance(null);\n    97\t    expect(disposeResult.ok).toBe(false);\n    98\t    if (!disposeResult.ok) {\n    99\t      expect(disposeResult.error).toEqual({\n   100\t        errorClass: \"system_error\",\n   101\t        code: \"not_implemented\",\n   102\t        reason: \"lifecycle.disposeInstance is not implemented yet (Epic 1 foundation stub)\",\n   103\t      });\n   104\t    }\n   105\t  });\n   106\t});\n","exit_code":0,"status":"completed"}}

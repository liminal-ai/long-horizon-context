{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' packages/pi-lhc/src/lifecycle/instance.ts\"","aggregated_output":"import { createSdk, type Lhc, type OpResult, type SdkConfig, type ThreadRef } from \"lhc\";\nimport type { LhcInstance } from \"../shared/instance.js\";\nimport { notImplemented } from \"../shared/not-implemented.js\";\n\n// AC-1.1, AC-1.4, AC-1.5.\n\n/** The connector's name for SDK construction — the agreed rename of LHC's\n *  `createSdk` (tech design A-4; the rename lands in lhc later, mechanical\n *  either way). One instance per PI session in background scheduler mode; the\n *  connector never drives the queue (Flow 1). Construction itself is real (it\n *  is just a rename); the lifecycle SEAM below is what Story 1 fills in. */\nexport function initLhc(config: SdkConfig): Lhc {\n  return createSdk(config);\n}\n\n/** Construct an instance against a resolved thread (Story 1: build the SDK in\n *  background mode, wrap with a flush-on-dispose seam). Fail-closed until then\n *  — it never returns a usable instance, so nothing can mistake the scaffold\n *  for a working session, and it throws nothing back into a hook. */\nexport function initInstance(\n  threadRef: ThreadRef,\n  config: SdkConfig,\n): Promise<OpResult<LhcInstance>> {\n  return Promise.resolve(notImplemented<LhcInstance>(\"lifecycle.initInstance\"));\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' packages/pi-lhc/src/shared/instance.ts\"","aggregated_output":"import type { Lhc, OpResult, ThreadRef } from \"lhc\";\n\n/** A constructed LHC session instance: the SDK (one per PI session, background\n *  mode) plus the resolved thread it records into, with a flush-on-dispose\n *  seam. This and the plain-data `SessionState` are the ONLY things the\n *  connector retains between hooks — never a PI `ctx`/session object, which PI\n *  replaces on new/resume/fork (tech design Flow 1, plain-data rule).\n *\n *  Defined in shared/ because both lifecycle (constructs/disposes it) and\n *  capture (the converter writes through it) reference it; keeping it here\n *  avoids a lifecycle↔capture import cycle. */\nexport interface LhcInstance {\n  readonly sdk: Lhc;\n  readonly threadRef: ThreadRef;\n  dispose(): Promise<OpResult<void>>;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The current seam is `initInstance(...) -> Promise<OpResult<LhcInstance>>`; the instance interface already has an instance-level `dispose()`. I’m adding the callable lifecycle-level `disposeInstance(...)` beside `initInstance` and exporting it from the root so consumers can import it the same way as activation helpers."}}

 result\\\", async () => {\\n    const result = await initInstance({ filePath: \\\"/tmp/thread.sqlite\\\" }, { mode: \\\"background\\\" });\\n    expect(result.ok).toBe(false);\\n    if (!result.ok) {\\n      expect(result.error.code).toBe(\\\"not_implemented\\\");\\n      expect(result.error.errorClass).toBe(\\\"system_error\\\");\\n    }\\n  });\\n});\\n\",\"structuredPatch\":[],\"originalFile\":null,\"userModified\":false}}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:4330:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"initInstance, resolveThread, pickThread, capture, seedFork) return an LHC not_implemented O\"}},\"session_id\":\"814546fe-4436-4e4f-8c69-071884ddc90c\",\"parent_tool_use_id\":null,\"uuid\":\"d8ba6f9a-89c5-4ce4-af61-7fd67a37c6b8\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:4361:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"2.7).\\\" },\\n    { \\\"path\\\": \\\"packages/pi-lhc/src/lifecycle/instance.ts\\\", \\\"reason\\\": \\\"initLhc (the createSdk rename,\"}},\"session_id\":\"814546fe-4436-4e4f-8c69-071884ddc90c\",\"parent_tool_use_id\":null,\"uuid\":\"d718c4c5-2300-43e1-9be4-61f2945c435d\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/streams/003-implementor.stdout.log:4362:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\" A-4) + fail-closed initInstance lifecycle seam.\\\" },\\n    { \\\"path\\\": \\\"packages/pi-lhc/src/lifecycle/thread-resolution.ts\\\", \\\"reason\\\": \\\"\"}},\"session_id\":\"814546fe-4436-4e4f-8c69-071884ddc90c\",\"parent_tool_use_id\":null,\"uuid\":\"020c65a9-3cfb-4e8c-82d1-0b6ffe247533\"}\ndocs/specs/02-pi-lhc/01-connector-core/artifacts/00-foundation/s
77\t  // Messages — projected counts by kind.\n   378\t  const expectedMsgs = expectedMessages(expected);\n   379\t  if (overview.messages.visible !== expectedMsgs.visible) {\n   380\t    problems.push(`messages.visible: expected ${expectedMsgs.visible}, got ${overview.messages.visible}`);\n   381\t  }\n   382\t  if (canonical(overview.messages.byKind) !== canonical(expectedMsgs.byKind)) {\n   383\t    problems.push(\n   384\t      `messages.byKind: expected ${canonical(expectedMsgs.byKind)}, got ${canonical(overview.messages.byKind)}`,\n   385\t    );\n   386\t  }\n   387\t\n   388\t  // Turns — one closed turn per expected `turn_end`, none left open.\n   389\t  const expectedClosed = expected.filter((event) => event.eventKind === \"turn_end\").length;\n   390\t  if (overview.turns.closed !== expectedClosed) {\n   391\t    problems.push(`turns.closed: expected ${expectedClosed}, got ${overview.turns.closed}`);\n   392\t  }\n   393\t  if (overview.turns.open !== 0) {\n   394\t    problems.push(`turns.open: expected 0, got ${overview.turns.open}`);\n   395\t  }\n   396\t\n   397\t  // Messages — full read-back records implied by the fixture, in source order.\n   398\t  const expectedMessageRows = expectedMessageRecords(expected);\n   399\t  const actualMessageRows = comparableMessageRecords(actualMessages);\n   400\t  if (canonical(actualMessageRows) !== canonical(expectedMessageRows)) {\n   401\t    problems.push(\n   402\t      `messages.records: expected ${canonical(expectedMessageRows)}, got ${canonical(actualMessageRows)}`,\n   403\t    );\n   404\t  }\n   405\t\n   406\t  // Turns — full read-back records implied by fixture event boundaries.\n   407\t  const expectedTurnRows = expectedTurnRecords(expected);\n   408\t  const actualTurnRows = comparableTurnRecords(actualTurns);\n   409\t  if (canonical(actualTurnRows) !== canonical(expectedTurnRows)) {\n   410\t    problems.push(`turns.records: expected ${canonical(expectedTurnRows)}, got ${canonical(actualTurnRows)}`);\n   411\t  }\n   412\t\n   413\t  return problems;\n   414\t}\n   415\t\n   416\t/** Replay a recorded corpus through the converter into the temp thread, then\n   417\t *  compare the durable read-back (events, messages, turns) to the fixture's\n   418\t *  expectation. The thread is left populated so a caller can read inspect's\n   419\t *  overview/health off it (AC-6.3). Deterministic: the same corpus yields the\n   420\t *  same recorded read-back every time (AC-6.2). */\n   421\texport async function replayCorpus(corpus: Corpus, threadRef: ThreadRef): Promise<ReplayResult> {\n   422\t  const instance = buildReplayInstance(threadRef);\n   423\t  const problems: string[] = [];\n   424\t  try {\n   425\t    await driveCorpus(corpus, instance);\n   426\t  } catch (cause) {\n   427\t    problems.push(`replay threw before completion: ${detail(cause)}`);\n   428\t  } finally {\n   429\t    await instance.dispose();\n   430\t  }\n","exit_code":0,"status":"completed"}}

"pass\\\\\\\" }\\\\n  ],\\\\n  \\\\\\\"selfReview\\\\\\\": {\\\\n    \\\\\\\"findingsFixed\\\\\\\": [\\\\n      \\\\\\\"exactOptionalPropertyTypes violations in the fixture builder (string|undefined assigned to optional ids) — replaced with guarded assignments that throw on a missing projection\\\\\\\",\\\\n      \\\\\\\"messages.report called with options merged into ThreadRef — corrected to the two-argument surface signature\\\\\\\",\\\\n      \\\\\\\"thread_view_band CHECK asserted via DDL text instead of a violating insert, since FK enforcement order would make the behavioral assertion ambiguous; the two singleton CHECKs are asserted behaviorally (failed inserts, nothing mutated)\\\\\\\"\\\\n    ],\\\\n    \\\\\\\"findingsSurfaced\\\\\\\": [\\\\n      \\\\\\\"The injection facility exists with both named points reachable from tests and proven no-op/installed/throw/uninstall, but the production call sites cannot exist until the advance (Story 4) and compact (Story 2) land — those stories must wire fireViewInjection at the pinned points; flagged so the wiring is not forgotten\\\\\\\",\\\\n      \\\\\\\"FC-0.4 confirmation for the Story 3 gate: Epic 02's failTerminal already persists the final provider failure's reason verbatim plus metadata.attempts/lastError, so transient (rate_limit:…, attempts 3) and permanent (content_refusal:…, attempts 1) forms are distinguishable by reason class on read-back — no Epic 02 patch trigger fired\\\\\\\",\\\\n      \\\\\\\"FIXTURE_CHUNK_POLICY is pinned (90/4400) against the deterministic provider's near-constant projection sizes (26–31 tokens/turn, 3-turn chunk sums 80–87); the builder throws a named re-pin error if the substrate ever drifts, so drift surfaces as a fixture invariant failure, not a downstream mystery\\\\\\\"\\\\n    ]\\\\n  },\\\\n  \\\\\\\"openQuestions\\\\\\\": [],\\\\n  \\\\\\\"specDeviations\\\\\\\": [\\\\n    \\\\\\\"SdkViewConfig.profiles is typed ViewProfileOverride[] (name + optional lowerBound/partial percentages) rather than the design sketch's ViewProfile[]: a complete ViewProfile remains assignable, and the widening is what makes FC-0.2's 'unknown built-in override target' violation expressible — a partial entry merges field-wise over the built-in it names, and a partial entry naming no built-in is rejected at construction\\\\\\\",\\\\n    \\\\\\\"view_boundary's migration seed stamps updated_at with SQLite strftime at migration time (migration statements are static SQL); deterministic-clock concerns do not apply to the one-time seed, and the production advance/reset writers (Stories 2/4) use the injected clock\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"recommendedNextStep\\\\\\\": \\\\\\\"Proceed to Story 1 (pull + status): the migration, config, fixture, and injection substrate are in place; Story 1 should consume derivedThreadFixture for tail-only pulls and add the thread-view surface stubs as structured not-implemented results per the design's stub contract.\\\\\\\"\\\\n}\\\\n```\\\",\\\"stop_reason\\\":\\\"end_turn\\\",\\\"session_id\\\":\\\"9b79ae20-893f-4407-8201-b760b8487b13\\\",\\\"total_cost_usd\\\":17.097302000000006,\\\"usage\\\":{\\\"input_tokens\\\":4445,\\\"cache_creation_input_tokens\\\":208156,\\\"cache_read_input_tokens\\\":9125415,\\\"output_tokens\\\":75254,\\\"server_tool_use\\\":{\\\"web_search_requests\\\":0,\\\"web_fetch_requests\\\":0},\\\"service_tier\\\":\\\"standard\\\",\\\"cache_creation\\\":{\\\"ephemeral_1h_input_tokens\\\":208156,\\\"ephemeral_5m_input_tokens\\\":0},\\\"inference_geo\\\":\\\"not_available\\\",\\\"iterations\\\":[{\\\"input_tokens\\\":2,\\\"output_tokens\\\":3105,\\\"cache_read_input_tokens\\\":221751,\\\"cache_creation_input_tokens\\\":2223,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":0,\\\"ephemeral_1h_input_tokens\\\":2223},\\\"type\\\":\\\"message\\\"}],\\\"speed\\\":\\\"standard\\\"},\\\"modelUsage\\\":{\\\"claude-haiku-4-5-20251001\\\":{\\\"inputTokens\\\":1527,\\\"outputTokens\\\":18,\\\"cacheReadInputTokens\\\":0,\\\"cacheCreationInputTokens\\\":0,\\\"webSearchRequests\\\":0,\\\"costUSD\\\":0.001617,\\\"contextWindow\\\":200000,\\\"maxOutputTokens\\\":32000},\\\"claude-fable-5\\\":{\\\"inputTokens\\\":4445,\\\"outputTokens\\\":75254,\\\"cacheReadInputTokens\\\":9125415,\\\"cacheCreationInputTokens\\\":208156,\\\"webSearchRequests\\\":0,\\\"costUSD\\\":17.095685000000007,\\\"contextWindow\\\":1000000,\\\"maxOutputTokens\\\":64000}},\\\"permission_denials\\\":[],\\\"terminal_reason\\\":\\\"completed\\\",\\\"fast_mode_state\\\":\\\"off\\\",\\\"uuid\\\":\\\"d6910bf2-454f-4fef-8bc8-1fb0e02c06f3\\\"}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/014-verify.stdout.log:18:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/view-sweep.test.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// Epic 03 Story 3: the readiness sweep (TC-3.1–3.4, the classification-edge\\n     2\\t// architecture-risk legs, and the suite-wide zero-provider assertion's\\n     3\\t// completion across all five thread-view ops). Every TC goes through the\\n     4\\t// real SDK surface (createSdk().threadView.sweep / .compact) against real\\n     5\\t// temp thread files; the provider double appears only in fixture setup and\\n     6\\t// in TC-3.4's sanctioned heal drain — no Epic 03 operation may touch it.\\n     7\\t// Failed and blocked states are reached through production paths (scripted\\n     8\\t// provider failures consumed by real retry/exhaustion mechanics, real source\\n     9\\t// damage on the sacrificial sibling), never by writing derived_form rows.\\n    10\\timport { afterAll, beforeAll, describe, expect, it } from \\\"vitest\\\";\\n    11\\timport { createSdk, type Lhc, type SweepReceipt } from \\\"../src/index.js\\\";\\n    12\\timport {\\n    13\\t  assertSweepReceiptShape,\\n    14\\t  blockedSiblingThread,\\n    15\\t  classifyFailureReason,\\n    16\\t  createProviderDouble,\\n    17\\t  derivedThreadFixture,\\n    18\\t  openRaw,\\n    19\\t  PERMANENT_FAILURE_REASON,\\n    20\\t  REASON_CLASS_TABLE,\\n    21\\t  seedViewBoundary,\\n    22\\t  tempStore,\\n    23\\t  validEvent,\\n    24\\t  type DerivedThreadFixture,\\n    25\\t  type TempStore,\\n    26\\t} from \\\"./fixtures/index.js\\\";\\n    27\\t\\n    28\\ttype OwnerLine = SweepReceipt[\\\"owners\\\"][number];\\n    29\\t\\n    30\\tfunction ownerLine(\\n    31\\t  receipt: SweepReceipt,\\n    32\\t  owner: OwnerLine[\\\"owner\\\"],\\n    33\\t  kind: string,\\n    34\\t): OwnerLine {\\n    35\\t  const line = receipt.owners.find((entry) => entry.owner === owner && entry.kind === kind);\\n    36\\t  if (line === undefined) throw new Error(`no receipt line for ${owner}/${kind}`);\\n    37\\t  return line;\\n    38\\t}\\n    39\\t\\n    40\\t// Work rows for one subject's rebuild, counted by key below the SDK\\n    41\\t// (TC-3.2's \\\"exactly one work row exists for it\\\"). The requeue patch keeps\\n    42\\t// the queue live-work-only, so any row here is queued or claimed work.\\n    43\\tfunction workRowsFor(filePath: string, kind: string, subjectId: string): number {\\n    44\\t  const db = openRaw(filePath);\\n    45\\t  try {\\n    46\\t    const row = db\\n    47\\t      .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE kind = ? AND source_ref LIKE ?`)\\n    48\\t      .get(kind, `%\\\"${subjectId}\\\"%`) as { n: number | bigint };\\n    49\\t    return Number(row.n);\\n    50\\t  } finally {\\n    51\\t    db.close();\\n    52\\t  }\\n    53\\t}\\n    54\\t\\n    55\\tfunction workItemCount(filePath: string): number {\\n    56\\t  const db = openRaw(filePath);\\n    57\\t  try {\\n    58\\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\\n    59\\t      n: number | bigint;\\n    60\\t    };\\n    61\\t    return Number(row.n);\\n    62\\t  } finally {\\n    63\\t    db.close();\\n    64\\t  }\\n    65\\t}\\n    66\\t\\n    67\\tasync function reportEntry(\\n    68\\t  sdk: Lhc,\\n    69\\t  filePath: string,\\n    70\\t  messageId: string,\\n    71\\t  form: string,\\n    72\\t): Promise<{ state: string; reason?: string; queueStatus?: string; content?: string }> {\\n    73\\t  const report = await sdk.messages.report({ filePath }, { messageId });\\n    74\\t  if (!report.ok) throw new Error(`report failed: ${report.error.reason}`);\\n    75\\t  const entry = report.value.find((row) => row.form === form);\\n    76\\t  if (entry === undefined) throw new Error(`no ${form} entry for ${messageId}`);\\n    77\\t  return {\\n    78\\t    state: entry.state,\\n    79\\t    ...(entry.reason === undefined ? {} : { reason: entry.reason }),\\n    80\\t    ...(entry.queue === undefined ? {} : { queueStatus: entry.queue.status }),\\n    81\\t    ...(entry.content === undefined ? {} : { content: entry.content }),\\n    82\\t  };\\n    83\\t}\\n    84\\t\\n    85\\tdescribe(\\\"TC-3.1–TC-3.3 (AC-3.1–3.5, 3.7): the standalone sweep over the seeded states\\\", () => {\\n    86\\t  let store: TempStore;\\n    87\\t  let fixture: DerivedThreadFixture;\\n    88\\t  let transientId: string;\\n    89\\t  let permanentId: string;\\n    90\\t  let firstReceipt: SweepReceipt;\\n    91\\t\\n    92\\t  beforeAll(async () => {\\n    93\\t    store = tempStore();\\n    94\\t    fixture = await derivedThreadFixture(store);\\n    95\\t    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    96\\t    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    97\\t    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n    98\\t      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    99\\t    }\\n   100\\t    // The pending leg of the seed: one more closed turn, NOT drained (manual\\n   101\\t    // mode never drains uninvoked), so its smoothed_prompt and turn forms sit\\n   102\\t    // pending with live queue rows when the sweep walks the reports.\\n   103\\t    const sent = await fixture.sdk.intakeStream.messageEvents({ filePath: fixture.filePath }, [\\n   104\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"extra pending turn for the sweep seed\\\" } }),\\n   105\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"left undrained on purpose\\\" } }),\\n   106\\t      validEvent(\\\"turn_end\\\"),\\n   107\\t    ]);\\n   108\\t    if (!sent.ok) throw new Error(`extra-turn intake failed: ${sent.error.reason}`);\\n   109\\t  });\\n   110\\t  afterAll(() => {\\n   111\\t    store.cleanup();\\n   112\\t  });\\n   113\\t\\n   114\\t  it(\\\"TC-3.1: buckets the five seeded states, requeues only the transient failure, returns without waiting, zero provider calls\\\", async () => {\\n   115\\t    const captured = fixture.double.captureInputs();\\n   116\\t    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(0);\\n   117\\t\\n   118\\t    const startedAt = Date.now();\\n   119\\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n   120\\t    const elapsedMs = Date.now() - startedAt;\\n   121\\t    expect(swept.ok).toBe(true);\\n   122\\t    if (!swept.ok) return;\\n   123\\t    firstReceipt = swept.value;\\n   124\\t\\n   125\\t    // No waiting (AC-3.2): the sweep is report reads plus row writes; any\\n   126\\t    // drain or poll inside it would blow this bound (anti-shim tripwire).\\n   127\\t    expect(elapsedMs).toBeLessThan(1000);\\n   128\\t\\n   129\\t    // The tool_result_summary line carries the story's whole failed×classify\\n   130\\t    // contract: 6 of the fixture's 8 results drained ready, the scripted\\n   131\\t    // transient exhaustion requeued, the scripted permanent failure reported\\n   132\\t    // with its reason and left alone (AC-3.3, AC-3.5).\\n   133\\t    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n   134\\t    expect(results.ready).toBe(6);\\n   135\\t    expect(results.requeued).toEqual([transientId]);\\n   136\\t    expect(results.permanentFailed).toEqual([\\n   137\\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n   138\\t    ]);\\n   139\\t    expect(results.blocked).toEqual([]);\\n   140\\t\\n   141\\t    // Pending forms are left alone and reported as in-flight: the undrained\\n   142\\t    // extra turn's prompt smoothing (messages) and turn derivation (turns).\\n   143\\t    const prompts = ownerLine(swept.value, \\\"messages\\\", \\\"smoothed_prompt\\\");\\n   144\\t    expect(prompts.ready).toBe(12);\\n   145\\t    expect(prompts.inFlight).toBe(1);\\n   146\\t    expect(prompts.requeued).toEqual([]);\\n   147\\t    const renderings = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n   148\\t    expect(renderings.ready).toBe(12);\\n   149\\t    expect(renderings.inFlight).toBe(1);\\n   150\\t    expect(renderings.requeued).toEqual([]);\\n   151\\t\\n   152\\t    // The transient requeue really landed through the owner: one work row by\\n   153\\t    // key, form cleared to pending with its queue row visible (AC-3.1's\\n   154\\t    // owners-only write path read back through the owner's report).\\n   155\\t    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n   156\\t    const transient = await reportEntry(\\n   157\\t      fixture.sdk,\\n   158\\t      fixture.filePath,\\n   159\\t      transientId,\\n   160\\t      \\\"tool_result_summary\\\",\\n   161\\t    );\\n   162\\t    expect(transient.state).toBe(\\\"pending\\\");\\n   163\\t    expect(transient.queueStatus).toBe(\\\"queued\\\");\\n   164\\t\\n   165\\t    // The permanent failure is untouched: still failed, no work row.\\n   166\\t    const permanent = await reportEntry(\\n   167\\t      fixture.sdk,\\n   168\\t      fixture.filePath,\\n   169\\t      permanentId,\\n   170\\t      \\\"tool_result_summary\\\",\\n   171\\t    );\\n   172\\t    expect(permanent.state).toBe(\\\"failed\\\");\\n   173\\t    expect(permanent.reason).toBe(PERMANENT_FAILURE_REASON);\\n   174\\t    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", permanentId)).toBe(0);\\n   175\\t\\n   176\\t    // Nothing requeued anywhere else, and the sweep itself called no\\n   177\\t    // provider (AC-3.1: no derivation, no model calls).\\n   178\\t    const allRequeued = swept.value.owners.flatMap((line) => line.requeued);\\n   179\\t    expect(allRequeued).toEqual([transientId]);\\n   180\\t    expect(captured.length).toBe(0);\\n   181\\t  });\\n   182\\t\\n   183\\t  it(\\\"TC-3.2 (AC-3.4): a second sweep without draining reports the requeued form in-flight and writes no second row\\\", async () => {\\n   184\\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n   185\\t    expect(swept.ok).toBe(true);\\n   186\\t    if (!swept.ok) return;\\n   187\\t\\n   188\\t    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n   189\\t    expect(results.requeued).toEqual([]);\\n   190\\t    expect(results.inFlight).toBe(1);\\n   191\\t    expect(results.ready).toBe(6);\\n   192\\t    expect(results.permanentFailed).toEqual([\\n   193\\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n   194\\t    ]);\\n   195\\t\\n   196\\t    // Exactly one work row exists for the requeued form (count by key).\\n   197\\t    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n   198\\t  });\\n   199\\t\\n   200\\t  it(\\\"TC-3.3 schema leg (AC-3.5, AC-3.7): the SDK receipt validates against the shared receipt schema\\\", async () => {\\n   201\\t    // The same checker Story 5's spawned CLI leg asserts against — \\\"same\\n   202\\t    // receipt shape\\\" is one validator passing both targets, not two\\n   203\\t    // hand-kept assertion lists.\\n   204\\t    expect(() => assertSweepReceiptShape(firstReceipt)).not.toThrow();\\n   205\\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n   206\\t    expect(swept.ok).toBe(true);\\n   207\\t    if (!swept.ok) return;\\n   208\\t    expect(() => assertSweepReceiptShape(swept.value)).not.toThrow();\\n   209\\t    // Counts and reasons match the seeds across invocations: the receipt is\\n   210\\t    // an accounting of durable state, not of sweep-local bookkeeping.\\n   211\\t    expect(ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\").permanentFailed).toEqual([\\n   212\\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n   213\\t    ]);\\n   214\\t  });\\n   215\\t\\n   216\\t  it(\\\"zero-provider assertion across all five ops (architecture-risk): pull, status, compact, sweep, materialize\\\", async () => {\\n   217\\t    const captured = fixture.double.captureInputs();\\n   218\\t    const before = captured.length;\\n   219\\t\\n   220\\t    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n   221\\t    const status = await fixture.sdk.threadView.status({ filePath: fixture.filePath });\\n   222\\t    const compacted = await fixture.sdk.threadView.compact(\\n   223\\t      { filePath: fixture.filePath },\\n   224\\t      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 } } },\\n   225\\t    );\\n   226\\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n   227\\t    const materialized = await fixture.sdk.threadView.materialize(\\n   228\\t      { filePath: fixture.filePath },\\n   229\\t      { path: `${fixture.filePath}.out.jsonl` },\\n   230\\t    );\\n   231\\t\\n   232\\t    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\\n   233\\t    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\\n   234\\t    expect(captured.length).toBe(before);\\n   235\\t  });\\n   236\\t});\\n   237\\t\\n   238\\tdescribe(\\\"classification edges (architecture-risk): blocked, in-walk dedupe, unclassified\\\", () => {\\n   239\\t  let store: TempStore;\\n   240\\t\\n   241\\t  beforeAll(() => {\\n   242\\t    store = tempStore();\\n   243\\t  });\\n   244\\t  afterAll(() => {\\n   245\\t    store.cleanup();\\n   246\\t  });\\n   247\\t\\n   248\\t  it(\\\"blocked forms are reported with their stored reasons and never requeued\\\", async () => {\\n   249\\t    const sibling = await blockedSiblingThread(store);\\n   250\\t    const rowsBefore = workItemCount(sibling.filePath);\\n   251\\t\\n   252\\t    const swept = await sibling.sdk.threadView.sweep({ filePath: sibling.filePath });\\n   253\\t    expect(swept.ok).toBe(true);\\n   254\\t    if (!swept.ok) return;\\n   255\\t\\n   256\\t    // The damaged turn landed both turn forms blocked through the production\\n   257\\t    // terminal path; the sweep reports each with its reason and asks the\\n   258\\t    // owners for nothing.\\n   259\\t    for (const kind of [\\\"turn_rendering\\\", \\\"lower_band_projection\\\"]) {\\n   260\\t      const line = ownerLine(swept.value, \\\"turns\\\", kind);\\n   261\\t      expect(line.blocked).toHaveLength(1);\\n   262\\t      expect(line.blocked[0]?.subjectId).toBe(sibling.blockedTurnId);\\n   263\\t      expect(line.blocked[0]?.reason).not.toBe(\\\"\\\");\\n   264\\t      expect(line.requeued).toEqual([]);\\n   265\\t    }\\n   266\\t    expect(swept.value.owners.flatMap((line) => line.requeued)).toEqual([]);\\n   267\\t    expect(workItemCount(sibling.filePath)).toBe(rowsBefore);\\n   268\\t  });\\n   269\\t\\n   270\\t  it(\\\"once-per-invocation dedupe is structural: a turn's two transiently-failed forms share one work row, the second ask noops to in-flight\\\", async () => {\\n   271\\t    // Both turn forms exhaust together through real retry mechanics (one\\n   272\\t    // turn_derivation item rebuilds both), so the sweep's walk meets two\\n   273\\t    // failed transient entries that share one queue site — the owner's\\n   274\\t    // already_queued noop is what keeps the second ask from double-queuing,\\n   275\\t    // and this test is what notices if Epic 02's requeue ever stops nooping.\\n   276\\t    const double = createProviderDouble();\\n   277\\t    const sdk = createSdk({\\n   278\\t      provider: double,\\n   279\\t      mode: \\\"manual\\\",\\n   280\\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n   281\\t    });\\n   282\\t    const filePath = store.threadPath();\\n   283\\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   284\\t    expect(created.ok).toBe(true);\\n   285\\t\\n   286\\t    double.failKind(\\\"turn_rendering\\\", 3, {\\n   287\\t      retryable: true,\\n   288\\t      reason: \\\"timeout: scripted turn exhaustion (test)\\\",\\n   289\\t    });\\n   290\\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n   291\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"a turn whose derivation exhausts\\\" } }),\\n   292\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"an answer\\\" } }),\\n   293\\t      validEvent(\\\"turn_end\\\"),\\n   294\\t    ]);\\n   295\\t    expect(sent.ok).toBe(true);\\n   296\\t    const drained = await sdk.work.drain({ filePath });\\n   297\\t    expect(drained.ok).toBe(true);\\n   298\\t\\n   299\\t    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(0);\\n   300\\t    const swept = await sdk.threadView.sweep({ filePath });\\n   301\\t    expect(swept.ok).toBe(true);\\n   302\\t    if (!swept.ok) return;\\n   303\\t\\n   304\\t    // One requeue, one noop-counted-as-in-flight, exactly one work row.\\n   305\\t    const rendering = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n   306\\t    const projection = ownerLine(swept.value, \\\"turns\\\", \\\"lower_band_projection\\\");\\n   307\\t    const requeued = [...rendering.requeued, ...projection.requeued];\\n   308\\t    expect(requeued).toEqual([\\\"t1\\\"]);\\n   309\\t    expect(rendering.inFlight + projection.inFlight).toBe(1);\\n   310\\t    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(1);\\n   311\\t  });\\n   312\\t\\n   313\\t  it(\\\"an unclassified reason code lands in permanentFailed with its literal reason and is never requeued\\\", async () => {\\n   314\\t    const double = createProviderDouble();\\n   315\\t    const sdk = createSdk({\\n   316\\t      provider: double,\\n   317\\t      mode: \\\"manual\\\",\\n   318\\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n   319\\t    });\\n   320\\t    const filePath = store.threadPath();\\n   321\\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   322\\t    expect(created.ok).toBe(true);\\n   323\\t\\n   324\\t    // A terminal failure whose reason class the table has never heard of —\\n   325\\t    // persisted through the production write path, classified conservative.\\n   326\\t    const unclassifiedReason = \\\"mystery_code: gremlins in the pipeline\\\";\\n   327\\t    double.failKind(\\\"tool_result_summary\\\", 1, { retryable: false, reason: unclassifiedReason });\\n   328\\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n   329\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"run the tool\\\" } }),\\n   330\\t      validEvent(\\\"tool_call\\\", {\\n   331\\t        payload: { toolCallId: \\\"call-uc-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"u.txt\\\" } },\\n   332\\t      }),\\n   333\\t      validEvent(\\\"tool_result\\\", {\\n   334\\t        payload: { toolCallId: \\\"call-uc-1\\\", content: \\\"unclassified-path output\\\", isError: false },\\n   335\\t      }),\\n   336\\t      validEvent(\\\"turn_end\\\"),\\n   337\\t    ]);\\n   338\\t    expect(sent.ok).toBe(true);\\n   339\\t    const messageIds = sent.ok ? sent.value.events.map((entry) => entry.messageId ?? \\\"\\\") : [];\\n   340\\t    const resultId = messageIds[2] ?? \\\"\\\";\\n   341\\t    expect(resultId).not.toBe(\\\"\\\");\\n   342\\t    const drained = await sdk.work.drain({ filePath });\\n   343\\t    expect(drained.ok).toBe(true);\\n   344\\t\\n   345\\t    const rowsBefore = workItemCount(filePath);\\n   346\\t    const swept = await sdk.threadView.sweep({ filePath });\\n   347\\t    expect(swept.ok).toBe(true);\\n   348\\t    if (!swept.ok) return;\\n   349\\t\\n   350\\t    const line = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n   351\\t    expect(line.permanentFailed).toEqual([{ subjectId: resultId, reason: unclassifiedReason }]);\\n   352\\t    expect(line.requeued).toEqual([]);\\n   353\\t    expect(workItemCount(filePath)).toBe(rowsBefore);\\n   354\\t    const entry = await reportEntry(sdk, filePath, resultId, \\\"tool_result_summary\\\");\\n   355\\t    expect(entry.state).toBe(\\\"failed\\\");\\n   356\\t  });\\n   357\\t\\n   358\\t  it(\\\"the classification table is data: named classes map as designed, everything else is permanent\\\", () => {\\n   359\\t    expect(REASON_CLASS_TABLE).toEqual({\\n   360\\t      rate_limit: \\\"transient\\\",\\n   361\\t      timeout: \\\"transient\\\",\\n   362\\t      provider_unavailable: \\\"transient\\\",\\n   363\\t      content_refusal: \\\"permanent\\\",\\n   364\\t      validation: \\\"permanent\\\",\\n   365\\t      unknown_work_kind: \\\"permanent\\\",\\n   366\\t    });\\n   367\\t    expect(classifyFailureReason(\\\"rate_limit: provider said slow down\\\")).toBe(\\\"transient\\\");\\n   368\\t    expect(classifyFailureReason(\\\"timeout: no response in 30s\\\")).toBe(\\\"transient\\\");\\n   369\\t    expect(classifyFailureReason(\\\"provider_unavailable: 503\\\")).toBe(\\\"transient\\\");\\n   370\\t    expect(classifyFailureReason(\\\"content_refusal: declined\\\")).toBe(\\\"permanent\\\");\\n   371\\t    expect(classifyFailureReason(\\\"validation: bad output shape\\\")).toBe(\\\"permanent\\\");\\n   372\\t    expect(classifyFailureReason(\\\"unknown_work_kind: nonesuch\\\")).toBe(\\\"permanent\\\");\\n   373\\t    // The conservative default: unknown codes, codeless prose, and missing\\n   374\\t    // reasons all classify permanent — never a requeue on a guess.\\n   375\\t    expect(classifyFailureReason(\\\"mystery_code: gremlins\\\")).toBe(\\\"permanent\\\");\\n   376\\t    expect(classifyFailureReason(\\\"free prose with no class code\\\")).toBe(\\\"permanent\\\");\\n   377\\t    expect(classifyFailureReason(undefined)).toBe(\\\"permanent\\\");\\n   378\\t    expect(classifyFailureReason(\\\"\\\")).toBe(\\\"permanent\\\");\\n   379\\t  });\\n   380\\t});\\n   381\\t\\n   382\\tdescribe(\\\"TC-3.4 (AC-3.6, AC-2.7): the compact-embedded sweep, the skip, and the heal\\\", () => {\\n   383\\t  let store: TempStore;\\n   384\\t  let fixture: DerivedThreadFixture;\\n   385\\t  let transientId: string;\\n   386\\t  let permanentId: string;\\n   387\\t\\n   388\\t  beforeAll(async () => {\\n   389\\t    store = tempStore();\\n   390\\t    fixture = await derivedThreadFixture(store);\\n   391\\t    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n   392\\t    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n   393\\t    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n   394\\t      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n   395\\t    }\\n   396\\t  });\\n   397\\t  afterAll(() => {\\n   398\\t    store.cleanup();\\n   399\\t  });\\n   400\\t\\n   401\\t  it(\\\"compact with sweep: false records the skip and requeues nothing\\\", async () => {\\n   402\\t    const rowsBefore = workItemCount(fixture.filePath);\\n   403\\t    const receipt = await fixture.sdk.threadView.compact(\\n   404\\t      { filePath: fixture.filePath },\\n   405\\t      { profile: \\\"coding\\\", sweep: false },\\n   406\\t    );\\n   407\\t    expect(receipt.ok).toBe(true);\\n   408\\t    if (!receipt.ok) return;\\n   409\\t    expect(receipt.value.sweep).toEqual({ skipped: true });\\n   410\\t\\n   411\\t    // Zero requeues occurred: no work row landed, the transient failure is\\n   412\\t    // still failed.\\n   413\\t    expect(workItemCount(fixture.filePath)).toBe(rowsBefore);\\n   414\\t    const transient = await reportEntry(\\n   415\\t      fixture.sdk,\\n   416\\t      fixture.filePath,\\n   417\\t      transientId,\\n   418\\t      \\\"tool_result_summary\\\",\\n   419\\t    );\\n   420\\t    expect(transient.state).toBe(\\\"failed\\\");\\n   421\\t  });\\n   422\\t\\n   423\\t  it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\\n   424\\t    // Default compact through a BACKGROUND SDK: the sweep runs first and its\\n   425\\t    // full receipt embeds (Story 2's \\\"absent\\\" placeholder is gone from the\\n   426\\t    // vocabulary), and the embedded requeue's poke-on-commit lands on the\\n   427\\t    // background scheduler — the production repair path needs no drain call.\\n   428\\t    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\\n   429\\t    const receipt = await bg.threadView.compact(\\n   430\\t      { filePath: fixture.filePath },\\n   431\\t      { profile: \\\"coding\\\" },\\n   432\\t    );\\n   433\\t    expect(receipt.ok).toBe(true);\\n   434\\t    if (!receipt.ok) return;\\n   435\\t    const embedded = receipt.value.sweep;\\n   436\\t    expect(embedded).not.toEqual({ skipped: true });\\n   437\\t    if (!(\\\"owners\\\" in embedded)) return;\\n   438\\t    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\\n   439\\t    expect(ownerLine(embedded, \\\"messages\\\", \\\"tool_result_summary\\\").requeued).toEqual([\\n   440\\t      transientId,\\n   441\\t    ]);\\n   442\\t\\n   443\\t    // The heal leg — the one sanctioned test-setup use of inference\\n   444\\t    // machinery: drainSettled awaits the poked background drain over the\\n   445\\t    // requeued row. No Epic 03 operation below touches the provider.\\n   446\\t    await bg.drainSettled({ filePath: fixture.filePath });\\n   447\\t\\n   448\\t    const healed = await reportEntry(\\n   449\\t      fixture.sdk,\\n   450\\t      fixture.filePath,\\n   451\\t      transientId,\\n   452\\t      \\\"tool_result_summary\\\",\\n   453\\t    );\\n   454\\t    expect(healed.state).toBe(\\\"ready\\\");\\n   455\\t    expect(healed.content).toBeDefined();\\n   456\\t\\n   457\\t    // The next default compact sees the heal: its embedded sweep reports the\\n   458\\t    // form ready (7 now), nothing to requeue, only the permanent failure\\n   459\\t    // still on the books.\\n   460\\t    const next = await fixture.sdk.threadView.compact(\\n   461\\t      { filePath: fixture.filePath },\\n   462\\t      { profile: \\\"coding\\\" },\\n   463\\t    );\\n   464\\t    expect(next.ok).toBe(true);\\n   465\\t    if (!next.ok) return;\\n   466\\t    const nextSweep = next.value.sweep;\\n   467\\t    if (!(\\\"owners\\\" in nextSweep)) return;\\n   468\\t    const results = ownerLine(nextSweep, \\\"messages\\\", \\\"tool_result_summary\\\");\\n   469\\t    expect(results.ready).toBe(7);\\n   470\\t    expect(results.requeued).toEqual([]);\\n   471\\t    expect(results.permanentFailed).toEqual([\\n   472\\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n   473\\t    ]);\\n   474\\t\\n   475\\t    // And the healed form feeds the served view: with the coding bound this\\n   476\\t    // small thread is all tail (compact point 0), so seed the boundary at the\\n   477\\t    // healed result's position — the short form now renders the READY\\n   478\\t    // summary, the ladder's first rung, not the truncation fallback.\\n   479\\t    expect(next.value.compactPoint).toBe(0);\\n   480\\t    const listed = await fixture.sdk.messages.listMessages({ filePath: fixture.filePath });\\n   481\\t    expect(listed.ok).toBe(true);\\n   482\\t    if (!listed.ok) return;\\n   483\\t    const healedMessage = listed.value.find((m) => m.messageId === transientId);\\n   484\\t    expect(healedMessage).toBeDefined();\\n   485\\t    if (healedMessage === undefined) return;\\n   486\\t    seedViewBoundary(fixture.filePath, healedMessage.sourceEventOrder);\\n   487\\t\\n   488\\t    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n   489\\t    expect(pulled.ok).toBe(true);\\n   490\\t    if (!pulled.ok) return;\\n   491\\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n   492\\t      `[tool result · read_file · abridged]\\\\n${healed.content} [full content in record §${transientId}]`,\\n   493\\t    );\\n   494\\t  });\\n   495\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/014-verify.stdout.log:20:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/fixtures/receipt-schema.ts | sed -n '1,260p'\\\"\",\"aggregated_output\":\"     1\\t// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\\n     2\\t// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\\n     3\\t// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \\\"same\\n     4\\t// receipt shape\\\" is proven by both targets passing the same checker, not by\\n     5\\t// two hand-kept assertion lists drifting apart.\\n     6\\timport type { SweepReceipt } from \\\"../../src/index.js\\\";\\n     7\\t\\n     8\\tfunction fail(path: string, expected: string, actual: unknown): never {\\n     9\\t  throw new Error(\\n    10\\t    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\\n    11\\t  );\\n    12\\t}\\n    13\\t\\n    14\\tfunction assertCount(value: unknown, path: string): void {\\n    15\\t  if (typeof value !== \\\"number\\\" || !Number.isInteger(value) || value < 0) {\\n    16\\t    fail(path, \\\"a non-negative integer\\\", value);\\n    17\\t  }\\n    18\\t}\\n    19\\t\\n    20\\tfunction assertSubjectReasonList(value: unknown, path: string): void {\\n    21\\t  if (!Array.isArray(value)) fail(path, \\\"an array\\\", value);\\n    22\\t  value.forEach((item, i) => {\\n    23\\t    if (typeof item !== \\\"object\\\" || item === null) fail(`${path}[${i}]`, \\\"an object\\\", item);\\n    24\\t    const entry = item as Record<string, unknown>;\\n    25\\t    if (typeof entry.subjectId !== \\\"string\\\" || entry.subjectId === \\\"\\\") {\\n    26\\t      fail(`${path}[${i}].subjectId`, \\\"a non-empty string\\\", entry.subjectId);\\n    27\\t    }\\n    28\\t    if (typeof entry.reason !== \\\"string\\\" || entry.reason === \\\"\\\") {\\n    29\\t      fail(`${path}[${i}].reason`, \\\"a non-empty string\\\", entry.reason);\\n    30\\t    }\\n    31\\t  });\\n    32\\t}\\n    33\\t\\n    34\\texport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\\n    35\\t  if (typeof value !== \\\"object\\\" || value === null) fail(\\\"receipt\\\", \\\"an object\\\", value);\\n    36\\t  const receipt = value as Record<string, unknown>;\\n    37\\t  if (!Array.isArray(receipt.owners)) fail(\\\"receipt.owners\\\", \\\"an array\\\", receipt.owners);\\n    38\\t  receipt.owners.forEach((line, i) => {\\n    39\\t    const path = `owners[${i}]`;\\n    40\\t    if (typeof line !== \\\"object\\\" || line === null) fail(path, \\\"an object\\\", line);\\n    41\\t    const entry = line as Record<string, unknown>;\\n    42\\t    if (entry.owner !== \\\"messages\\\" && entry.owner !== \\\"turns\\\") {\\n    43\\t      fail(`${path}.owner`, '\\\"messages\\\" | \\\"turns\\\"', entry.owner);\\n    44\\t    }\\n    45\\t    if (typeof entry.kind !== \\\"string\\\" || entry.kind === \\\"\\\") {\\n    46\\t      fail(`${path}.kind`, \\\"a non-empty string\\\", entry.kind);\\n    47\\t    }\\n    48\\t    assertCount(entry.ready, `${path}.ready`);\\n    49\\t    assertCount(entry.inFlight, `${path}.inFlight`);\\n    50\\t    if (\\n    51\\t      !Array.isArray(entry.requeued) ||\\n    52\\t      entry.requeued.some((id) => typeof id !== \\\"string\\\" || id === \\\"\\\")\\n    53\\t    ) {\\n    54\\t      fail(`${path}.requeued`, \\\"an array of non-empty subject-id strings\\\", entry.requeued);\\n    55\\t    }\\n    56\\t    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\\n    57\\t    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\\n    58\\t  });\\n    59\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/009-implementor.stdout.log:143:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017ZdwgZgvNNnZsByaRW2fet\",\"type\":\"tool_result\",\"content\":\"1\\t// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\\n2\\t// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\\n3\\t// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \\\"same\\n4\\t// receipt shape\\\" is proven by both targets passing the same checker, not by\\n5\\t// two hand-kept assertion lists drifting apart.\\n6\\timport type { SweepReceipt } from \\\"../../src/index.js\\\";\\n7\\t\\n8\\tfunction fail(path: string, expected: string, actual: unknown): never {\\n9\\t  throw new Error(\\n10\\t    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\\n11\\t  );\\n12\\t}\\n13\\t\\n14\\tfunction assertCount(value: unknown, path: string): void {\\n15\\t  if (typeof value !== \\\"number\\\" || !Number.isInteger(value) || value < 0) {\\n16\\t    fail(path, \\\"a non-negative integer\\\", value);\\n17\\t  }\\n18\\t}\\n19\\t\\n20\\tfunction assertSubjectReasonList(value: unknown, path: string): void {\\n21\\t  if (!Array.isArray(value)) fail(path, \\\"an array\\\", value);\\n22\\t  value.forEach((item, i) => {\\n23\\t    if (typeof item !== \\\"object\\\" || item === null) fail(`${path}[${i}]`, \\\"an object\\\", item);\\n24\\t    const entry = item as Record<string, unknown>;\\n25\\t    if (typeof entry.subjectId !== \\\"string\\\" || entry.subjectId === \\\"\\\") {\\n26\\t      fail(`${path}[${i}].subjectId`, \\\"a non-empty string\\\", entry.subjectId);\\n27\\t    }\\n28\\t    if (typeof entry.reason !== \\\"string\\\" || entry.reason === \\\"\\\") {\\n29\\t      fail(`${path}[${i}].reason`, \\\"a non-empty string\\\", entry.reason);\\n30\\t    }\\n31\\t  });\\n32\\t}\\n33\\t\\n34\\texport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\\n35\\t  if (typeof value !== \\\"object\\\" || value === null) fail(\\\"receipt\\\", \\\"an object\\\", value);\\n36\\t  const receipt = value as Record<string, unknown>;\\n37\\t  if (!Array.isArray(receipt.owners)) fail(\\\"receipt.owners\\\", \\\"an array\\\", receipt.owners);\\n38\\t  receipt.owners.forEach((line, i) => {\\n39\\t    const path = `owners[${i}]`;\\n40\\t    if (typeof line !== \\\"object\\\" || line === null) fail(path, \\\"an object\\\", line);\\n41\\t    const entry = line as Record<string, unknown>;\\n42\\t    if (entry.owner !== \\\"messages\\\" && entry.owner !== \\\"turns\\\") {\\n43\\t      fail(`${path}.owner`, '\\\"messages\\\" | \\\"turns\\\"', entry.owner);\\n44\\t    }\\n45\\t    if (typeof entry.kind !== \\\"string\\\" || entry.kind === \\\"\\\") {\\n46\\t      fail(`${path}.kind`, \\\"a non-empty string\\\", entry.kind);\\n47\\t    }\\n48\\t    assertCount(entry.ready, `${path}.ready`);\\n49\\t    assertCount(entry.inFlight, `${path}.inFlight`);\\n50\\t    if (\\n51\\t      !Array.isArray(entry.requeued) ||\\n52\\t      entry.requeued.some((id) => typeof id !== \\\"string\\\" || id === \\\"\\\")\\n53\\t    ) {\\n54\\t      fail(`${path}.requeued`, \\\"an array of non-empty subject-id strings\\\", entry.requeued);\\n55\\t    }\\n56\\t    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\\n57\\t    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\\n58\\t  });\\n59\\t}\\n60\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"14af1c76-5e3a-4e59-acc7-c3c9d062b23f\",\"uuid\":\"1c29bd26-a5c8-4d8d-bb1d-be0d37c9926b\",\"timestamp\":\"2026-06-11T17:04:29.608Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/receipt-schema.ts\",\"content\":\"// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\\n// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\\n// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \\\"same\\n// receipt shape\\\" is proven by both targets passing the same checker, not by\\n// two hand-kept assertion lists drifting apart.\\nimport type { SweepReceipt } from \\\"../../src/index.js\\\";\\n\\nfunction fail(path: string, expected: string, actual: unknown): never {\\n  throw new Error(\\n    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\\n  );\\n}\\n\\nfunction assertCount(value: unknown, path: string): void {\\n  if (typeof value !== \\\"number\\\" || !Number.isInteger(value) || value < 0) {\\n    fail(path, \\\"a non-negative integer\\\", value);\\n  }\\n}\\n\\nfunction assertSubjectReasonList(value: unknown, path: string): void {\\n  if (!Array.isArray(value)) fail(path, \\\"an array\\\", value);\\n  value.forEach((item, i) => {\\n    if (typeof item !== \\\"object\\\" || item === null) fail(`${path}[${i}]`, \\\"an object\\\", item);\\n    const entry = item as Record<string, unknown>;\\n    if (typeof entry.subjectId !== \\\"string\\\" || entry.subjectId === \\\"\\\") {\\n      fail(`${path}[${i}].subjectId`, \\\"a non-empty string\\\", entry.subjectId);\\n    }\\n    if (typeof entry.reason !== \\\"string\\\" || entry.reason === \\\"\\\") {\\n      fail(`${path}[${i}].reason`, \\\"a non-empty string\\\", entry.reason);\\n    }\\n  });\\n}\\n\\nexport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\\n  if (typeof value !== \\\"object\\\" || value === null) fail(\\\"receipt\\\", \\\"an object\\\", value);\\n  const receipt = value as Record<string, unknown>;\\n  if (!Array.isArray(receipt.owners)) fail(\\\"receipt.owners\\\", \\\"an array\\\", receipt.owners);\\n  receipt.owners.forEach((line, i) => {\\n    const path = `owners[${i}]`;\\n    if (typeof line !== \\\"object\\\" || line === null) fail(path, \\\"an object\\\", line);\\n    const entry = line as Record<string, unknown>;\\n    if (entry.owner !== \\\"messages\\\" && entry.owner !== \\\"turns\\\") {\\n      fail(`${path}.owner`, '\\\"messages\\\" | \\\"turns\\\"', entry.owner);\\n    }\\n    if (typeof entry.kind !== \\\"string\\\" || entry.kind === \\\"\\\") {\\n      fail(`${path}.kind`, \\\"a non-empty string\\\", entry.kind);\\n    }\\n    assertCount(entry.ready, `${path}.ready`);\\n    assertCount(entry.inFlight, `${path}.inFlight`);\\n    if (\\n      !Array.isArray(entry.requeued) ||\\n      entry.requeued.some((id) => typeof id !== \\\"string\\\" || id === \\\"\\\")\\n    ) {\\n      fail(`${path}.requeued`, \\\"an array of non-empty subject-id strings\\\", entry.requeued);\\n    }\\n    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\\n    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\\n  });\\n}\\n\",\"numLines\":60,\"startLine\":1,\"totalLines\":60}}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/009-implementor.stdout.log:299:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HpSKzv3ncq2EBxBAm6jTsF\",\"type\":\"tool_result\",\"content\":\"1\\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n2\\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n3\\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n4\\t// deterministic provider double into known form states. States are reached\\n5\\t// through production paths, never hand-written rows (the anti-shim line\\n6\\t// FC-0.3 enforces): the failed states come from scripted provider failures\\n7\\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n8\\t// real source damage on a sacrificial sibling thread. Every later Epic 03\\n9\\t// story compacts against what this builder returns.\\n10\\timport {\\n11\\t  createSdk,\\n12\\t  type FormReportEntry,\\n13\\t  type Lhc,\\n14\\t  type MessageEventInput,\\n15\\t} from \\\"../../src/index.js\\\";\\n16\\timport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\n17\\timport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\n18\\timport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\n19\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n20\\t\\n21\\t// Reason classes the scripted failures stamp, chosen from the sweep\\n22\\t// classification table's vocabulary (tech design §Spec Validation): a\\n23\\t// rate-limit class reads transient, a content-refusal class reads permanent —\\n24\\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n25\\t// Story 3 depends on it.\\n26\\texport const TRANSIENT_EXHAUST_REASON =\\n27\\t  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\n28\\texport const PERMANENT_FAILURE_REASON =\\n29\\t  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n30\\t\\n31\\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n32\\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n33\\t// deterministic double are near-constant in size (`projection(<digest>:<40\\n34\\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n35\\t// if drift ever moves it.\\n36\\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n37\\t\\n38\\tconst TURN_COUNT = 12;\\n39\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n40\\t\\n41\\tfunction turnEvents(turn: number): MessageEventInput[] {\\n42\\t  const events: MessageEventInput[] = [\\n43\\t    validEvent(\\\"user_prompt\\\", {\\n44\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n45\\t    }),\\n46\\t    validEvent(\\\"assistant_thinking\\\", {\\n47\\t      payload: { text: `considering what area ${turn} contains` },\\n48\\t    }),\\n49\\t  ];\\n50\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n51\\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n52\\t    // realistic over-max zone of tool results to age behind the boundary.\\n53\\t    for (const run of [1, 2]) {\\n54\\t      const toolCallId = `call-fx-${turn}-${run}`;\\n55\\t      events.push(\\n56\\t        validEvent(\\\"tool_call\\\", {\\n57\\t          payload: {\\n58\\t            toolCallId,\\n59\\t            toolName: \\\"read_file\\\",\\n60\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\n61\\t          },\\n62\\t        }),\\n63\\t        validEvent(\\\"tool_result\\\", {\\n64\\t          payload: {\\n65\\t            toolCallId,\\n66\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n67\\t            isError: false,\\n68\\t          },\\n69\\t        }),\\n70\\t      );\\n71\\t    }\\n72\\t  }\\n73\\t  events.push(\\n74\\t    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n75\\t    validEvent(\\\"turn_end\\\"),\\n76\\t  );\\n77\\t  return events;\\n78\\t}\\n79\\t\\n80\\texport interface DerivedThreadFixture {\\n81\\t  filePath: string;\\n82\\t  sdk: Lhc;\\n83\\t  double: ProviderDouble;\\n84\\t  turnIds: string[]; // t1..t12\\n85\\t  chunks: ChunkSnapshot;\\n86\\t  // The two manufactured failed subjects (tool_result_summary forms), reached\\n87\\t  // through real retry exhaustion / terminal failure — absent when failures\\n88\\t  // are disabled for a variant.\\n89\\t  failedTransientMessageId?: string;\\n90\\t  failedPermanentMessageId?: string;\\n91\\t  // The straggler variant's turnId-null messages: one between two turns, one\\n92\\t  // after the last turn — absent unless stragglers are enabled.\\n93\\t  stragglerBetweenMessageId?: string;\\n94\\t  stragglerTrailingMessageId?: string;\\n95\\t}\\n96\\t\\n97\\texport interface DerivedThreadOptions {\\n98\\t  failures?: boolean; // default true: manufacture the two failed states\\n99\\t  stragglers?: boolean; // default false: insert the turnless runtime notes\\n100\\t}\\n101\\t\\n102\\tasync function send(\\n103\\t  sdk: Lhc,\\n104\\t  filePath: string,\\n105\\t  batch: readonly MessageEventInput[],\\n106\\t): Promise<string[]> {\\n107\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n108\\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n109\\t  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n110\\t}\\n111\\t\\n112\\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n113\\t  const report = await sdk.work.drain({ filePath });\\n114\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n115\\t  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n116\\t    throw new Error(\\n117\\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n118\\t    );\\n119\\t  }\\n120\\t}\\n121\\t\\n122\\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n123\\t  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n124\\t}\\n125\\t\\n126\\texport async function derivedThreadFixture(\\n127\\t  store: TempStore,\\n128\\t  opts: DerivedThreadOptions = {},\\n129\\t): Promise<DerivedThreadFixture> {\\n130\\t  const failures = opts.failures ?? true;\\n131\\t  const stragglers = opts.stragglers ?? false;\\n132\\t\\n133\\t  const double = createProviderDouble();\\n134\\t  const sdk = createSdk({\\n135\\t    provider: double,\\n136\\t    mode: \\\"manual\\\",\\n137\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n138\\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n139\\t  });\\n140\\t\\n141\\t  const filePath = store.threadPath();\\n142\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n143\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n144\\t\\n145\\t  const turnIds: string[] = [];\\n146\\t  const fixture: DerivedThreadFixture = {\\n147\\t    filePath,\\n148\\t    sdk,\\n149\\t    double,\\n150\\t    turnIds,\\n151\\t    chunks: { chunks: [], members: [] },\\n152\\t  };\\n153\\t\\n154\\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n155\\t    if (failures && turn === 6) {\\n156\\t      // Retryable failures consumed to exhaustion by the head-first drain:\\n157\\t      // the first tool_result_summary item of this batch takes all three\\n158\\t      // attempts and lands failed with the transient reason class.\\n159\\t      double.failKind(\\\"tool_result_summary\\\", 3, {\\n160\\t        retryable: true,\\n161\\t        reason: TRANSIENT_EXHAUST_REASON,\\n162\\t      });\\n163\\t    }\\n164\\t    if (failures && turn === 7) {\\n165\\t      // One non-retryable failure: terminal on the first attempt — the\\n166\\t      // permanent reason class, attempts 1.\\n167\\t      double.failKind(\\\"tool_result_summary\\\", 1, {\\n168\\t        retryable: false,\\n169\\t        reason: PERMANENT_FAILURE_REASON,\\n170\\t      });\\n171\\t    }\\n172\\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n173\\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n174\\t    // result, call, result, text, end — index 3 is the first tool result,\\n175\\t    // the scripted failures' subject.\\n176\\t    const firstToolResultId = messageIds[3];\\n177\\t    if (failures && (turn === 6 || turn === 7)) {\\n178\\t      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n179\\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n180\\t      }\\n181\\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n182\\t      else fixture.failedPermanentMessageId = firstToolResultId;\\n183\\t    }\\n184\\t    await drain(sdk, filePath);\\n185\\t\\n186\\t    if (stragglers && turn === 3) {\\n187\\t      // A runtime note between turn 3's end and turn 4's prompt: projected\\n188\\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n189\\t      const noteIds = await send(sdk, filePath, [\\n190\\t        validEvent(\\\"runtime_note\\\", {\\n191\\t          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n192\\t        }),\\n193\\t      ]);\\n194\\t      const noteId = noteIds[0];\\n195\\t      if (noteId === undefined || noteId === \\\"\\\") {\\n196\\t        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n197\\t      }\\n198\\t      fixture.stragglerBetweenMessageId = noteId;\\n199\\t    }\\n200\\t    turnIds.push(`t${turn}`);\\n201\\t  }\\n202\\t\\n203\\t  if (stragglers) {\\n204\\t    const noteIds = await send(sdk, filePath, [\\n205\\t      validEvent(\\\"runtime_note\\\", {\\n206\\t        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n207\\t      }),\\n208\\t    ]);\\n209\\t    const noteId = noteIds[0];\\n210\\t    if (noteId === undefined || noteId === \\\"\\\") {\\n211\\t      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n212\\t    }\\n213\\t    fixture.stragglerTrailingMessageId = noteId;\\n214\\t    await drain(sdk, filePath);\\n215\\t  }\\n216\\t\\n217\\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n218\\t  // chunks, the first three closed. A failure here means the deterministic\\n219\\t  // substrate moved (provider output or tokenizer), not a flaky test.\\n220\\t  fixture.chunks = readChunks(filePath);\\n221\\t  if (fixture.chunks.chunks.length !== 4) {\\n222\\t    throw new Error(\\n223\\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n224\\t    );\\n225\\t  }\\n226\\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n227\\t  if (closed !== 3) {\\n228\\t    throw new Error(\\n229\\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n230\\t    );\\n231\\t  }\\n232\\t\\n233\\t  if (failures) {\\n234\\t    // Verify the manufactured states by read-back through the owning report\\n235\\t    // surface before handing the fixture to any test (FC-0.3's enforcement\\n236\\t    // lives in the tests; this guards the builder's own contract).\\n237\\t    const report = await sdk.messages.report({ filePath });\\n238\\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n239\\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n240\\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n241\\t    if (\\n242\\t      transient.length !== 1 ||\\n243\\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n244\\t      permanent.length !== 1 ||\\n245\\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n246\\t    ) {\\n247\\t      throw new Error(\\n248\\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n249\\t      );\\n250\\t    }\\n251\\t  }\\n252\\t\\n253\\t  return fixture;\\n254\\t}\\n255\\t\\n256\\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n257\\t// conversation with a runtime note between two turns and one after the last\\n258\\t// turn, fully drained, no manufactured failures.\\n259\\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n260\\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n261\\t}\\n262\\t\\n263\\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n264\\t// short real conversation, drained clean, then damaged below the SDK into\\n265\\t// the two-open-turns state no public operation can produce. Canonical\\n266\\t// consumers refuse it with state_corruption.\\n267\\texport async function corruptedVariantThread(\\n268\\t  store: TempStore,\\n269\\t): Promise<{ filePath: string; sdk: Lhc }> {\\n270\\t  const double = createProviderDouble();\\n271\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n272\\t  const filePath = store.threadPath();\\n273\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n274\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n275\\t  for (let turn = 1; turn <= 3; turn += 1) {\\n276\\t    await send(sdk, filePath, turnEvents(turn));\\n277\\t  }\\n278\\t  await drain(sdk, filePath);\\n279\\t  // Open a turn through real intake, then add a second open row: two open\\n280\\t  // turns, the Epic 01 invariant violation.\\n281\\t  await send(sdk, filePath, [\\n282\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n283\\t  ]);\\n284\\t  corruptTwoOpenTurns(filePath);\\n285\\t  return { filePath, sdk };\\n286\\t}\\n287\\t\\n288\\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n289\\t// queued derivation meets real source damage at drain time — the handler\\n290\\t// finds two open turns and lands the turn forms blocked through the\\n291\\t// production terminal path, never a hand-written row.\\n292\\texport async function blockedSiblingThread(\\n293\\t  store: TempStore,\\n294\\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n295\\t  const double = createProviderDouble();\\n296\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n297\\t  const filePath = store.threadPath();\\n298\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n299\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n300\\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n301\\t  // real intake; the corruption writer adds another open row. The drain then\\n302\\t  // claims t1's derivation against a record with two open turns.\\n303\\t  await send(sdk, filePath, turnEvents(1));\\n304\\t  await send(sdk, filePath, [\\n305\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n306\\t  ]);\\n307\\t  corruptTwoOpenTurns(filePath);\\n308\\t  const report = await sdk.work.drain({ filePath });\\n309\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n310\\t  const blocked = report.value.ran.find(\\n311\\t    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n312\\t  );\\n313\\t  if (blocked === undefined) {\\n314\\t    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n315\\t  }\\n316\\t  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n317\\t}\\n318\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"14af1c76-5e3a-4e59-acc7-c3c9d062b23f\",\"uuid\":\"ed76c031-6e4b-4846-bc38-ce6702e5b54c\",\"timestamp\":\"2026-06-11T17:06:02.002Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-thread.ts\",\"content\":\"// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n// deterministic provider double into known form states. States are reached\\n// through production paths, never hand-written rows (the anti-shim line\\n// FC-0.3 enforces): the failed states come from scripted provider failures\\n// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n// real source damage on a sacrificial sibling thread. Every later Epic 03\\n// story compacts against what this builder returns.\\nimport {\\n  createSdk,\\n  type FormReportEntry,\\n  type Lhc,\\n  type MessageEventInput,\\n} from \\\"../../src/index.js\\\";\\nimport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\nimport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\nimport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\n// Reason classes the scripted failures stamp, chosen from the sweep\\n// classification table's vocabulary (tech design §Spec Validation): a\\n// rate-limit class reads transient, a content-refusal class reads permanent —\\n// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n// Story 3 depends on it.\\nexport const TRANSIENT_EXHAUST_REASON =\\n  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\nexport const PERMANENT_FAILURE_REASON =\\n  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n\\n// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n// deterministic double are near-constant in size (`projection(<digest>:<40\\n// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n// if drift ever moves it.\\nconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n\\nconst TURN_COUNT = 12;\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n\\nfunction turnEvents(turn: number): MessageEventInput[] {\\n  const events: MessageEventInput[] = [\\n    validEvent(\\\"user_prompt\\\", {\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n    }),\\n    validEvent(\\\"assistant_thinking\\\", {\\n      payload: { text: `considering what area ${turn} contains` },\\n    }),\\n  ];\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n    // realistic over-max zone of tool results to age behind the boundary.\\n    for (const run of [1, 2]) {\\n      const toolCallId = `call-fx-${turn}-${run}`;\\n      events.push(\\n        validEvent(\\\"tool_call\\\", {\\n          payload: {\\n            toolCallId,\\n            toolName: \\\"read_file\\\",\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\n          },\\n        }),\\n        validEvent(\\\"tool_result\\\", {\\n          payload: {\\n            toolCallId,\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n            isError: false,\\n          },\\n        }),\\n      );\\n    }\\n  }\\n  events.push(\\n    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n    validEvent(\\\"turn_end\\\"),\\n  );\\n  return events;\\n}\\n\\nexport interface DerivedThreadFixture {\\n  filePath: string;\\n  sdk: Lhc;\\n  double: ProviderDouble;\\n  turnIds: string[]; // t1..t12\\n  chunks: ChunkSnapshot;\\n  // The two manufactured failed subjects (tool_result_summary forms), reached\\n  // through real retry exhaustion / terminal failure — absent when failures\\n  // are disabled for a variant.\\n  failedTransientMessageId?: string;\\n  failedPermanentMessageId?: string;\\n  // The straggler variant's turnId-null messages: one between two turns, one\\n  // after the last turn — absent unless stragglers are enabled.\\n  stragglerBetweenMessageId?: string;\\n  stragglerTrailingMessageId?: string;\\n}\\n\\nexport interface DerivedThreadOptions {\\n  failures?: boolean; // default true: manufacture the two failed states\\n  stragglers?: boolean; // default false: insert the turnless runtime notes\\n}\\n\\nasync function send(\\n  sdk: Lhc,\\n  filePath: string,\\n  batch: readonly MessageEventInput[],\\n): Promise<string[]> {\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n}\\n\\nasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n  const report = await sdk.work.drain({ filePath });\\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n    throw new Error(\\n      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n    );\\n  }\\n}\\n\\nfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n}\\n\\nexport async function derivedThreadFixture(\\n  store: TempStore,\\n  opts: DerivedThreadOptions = {},\\n): Promise<DerivedThreadFixture> {\\n  const failures = opts.failures ?? true;\\n  const stragglers = opts.stragglers ?? false;\\n\\n  const double = createProviderDouble();\\n  const sdk = createSdk({\\n    provider: double,\\n    mode: \\\"manual\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n  });\\n\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n\\n  const turnIds: string[] = [];\\n  const fixture: DerivedThreadFixture = {\\n    filePath,\\n    sdk,\\n    double,\\n    turnIds,\\n    chunks: { chunks: [], members: [] },\\n  };\\n\\n  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n    if (failures && turn === 6) {\\n      // Retryable failures consumed to exhaustion by the head-first drain:\\n      // the first tool_result_summary item of this batch takes all three\\n      // attempts and lands failed with the transient reason class.\\n      double.failKind(\\\"tool_result_summary\\\", 3, {\\n        retryable: true,\\n        reason: TRANSIENT_EXHAUST_REASON,\\n      });\\n    }\\n    if (failures && turn === 7) {\\n      // One non-retryable failure: terminal on the first attempt — the\\n      // permanent reason class, attempts 1.\\n      double.failKind(\\\"tool_result_summary\\\", 1, {\\n        retryable: false,\\n        reason: PERMANENT_FAILURE_REASON,\\n      });\\n    }\\n    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n    // result, call, result, text, end — index 3 is the first tool result,\\n    // the scripted failures' subject.\\n    const firstToolResultId = messageIds[3];\\n    if (failures && (turn === 6 || turn === 7)) {\\n      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n      }\\n      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n      else fixture.failedPermanentMessageId = firstToolResultId;\\n    }\\n    await drain(sdk, filePath);\\n\\n    if (stragglers && turn === 3) {\\n      // A runtime note between turn 3's end and turn 4's prompt: projected\\n      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n      const noteIds = await send(sdk, filePath, [\\n        validEvent(\\\"runtime_note\\\", {\\n          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n        }),\\n      ]);\\n      const noteId = noteIds[0];\\n      if (noteId === undefined || noteId === \\\"\\\") {\\n        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n      }\\n      fixture.stragglerBetweenMessageId = noteId;\\n    }\\n    turnIds.push(`t${turn}`);\\n  }\\n\\n  if (stragglers) {\\n    const noteIds = await send(sdk, filePath, [\\n      validEvent(\\\"runtime_note\\\", {\\n        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n      }),\\n    ]);\\n    const noteId = noteIds[0];\\n    if (noteId === undefined || noteId === \\\"\\\") {\\n      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n    }\\n    fixture.stragglerTrailingMessageId = noteId;\\n    await drain(sdk, filePath);\\n  }\\n\\n  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n  // chunks, the first three closed. A failure here means the deterministic\\n  // substrate moved (provider output or tokenizer), not a flaky test.\\n  fixture.chunks = readChunks(filePath);\\n  if (fixture.chunks.chunks.length !== 4) {\\n    throw new Error(\\n      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n    );\\n  }\\n  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n  if (closed !== 3) {\\n    throw new Error(\\n      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n    );\\n  }\\n\\n  if (failures) {\\n    // Verify the manufactured states by read-back through the owning report\\n    // surface before handing the fixture to any test (FC-0.3's enforcement\\n    // lives in the tests; this guards the builder's own contract).\\n    const report = await sdk.messages.report({ filePath });\\n    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n    if (\\n      transient.length !== 1 ||\\n      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n      permanent.length !== 1 ||\\n      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n    ) {\\n      throw new Error(\\n        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n      );\\n    }\\n  }\\n\\n  return fixture;\\n}\\n\\n// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n// conversation with a runtime note between two turns and one after the last\\n// turn, fully drained, no manufactured failures.\\nexport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n}\\n\\n// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n// short real conversation, drained clean, then damaged below the SDK into\\n// the two-open-turns state no public operation can produce. Canonical\\n// consumers refuse it with state_corruption.\\nexport async function corruptedVariantThread(\\n  store: TempStore,\\n): Promise<{ filePath: string; sdk: Lhc }> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  for (let turn = 1; turn <= 3; turn += 1) {\\n    await send(sdk, filePath, turnEvents(turn));\\n  }\\n  await drain(sdk, filePath);\\n  // Open a turn through real intake, then add a second open row: two open\\n  // turns, the Epic 01 invariant violation.\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n  ]);\\n  corruptTwoOpenTurns(filePath);\\n  return { filePath, sdk };\\n}\\n\\n// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n// queued derivation meets real source damage at drain time — the handler\\n// finds two open turns and lands the turn forms blocked through the\\n// production terminal path, never a hand-written row.\\nexport async function blockedSiblingThread(\\n  store: TempStore,\\n): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n  // real intake; the corruption writer adds another open row. The drain then\\n  // claims t1's derivation against a record with two open turns.\\n  await send(sdk, filePath, turnEvents(1));\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n  ]);\\n  corruptTwoOpenTurns(filePath);\\n  const report = await sdk.work.drain({ filePath });\\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n  const blocked = report.value.ran.find(\\n    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n  );\\n  if (blocked === undefined) {\\n    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n  }\\n  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n}\\n\",\"numLines\":318,\"startLine\":1,\"totalLines\":318}}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/009-implementor.stdout.log:1135:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"${form} entry for ${messageId}`);\\\\n  return {\\\\n    state: entry.state,\\\\n    ...(entry.reason === undefined ? {} : { reason: entry.re\"}},\"session_id\":\"14af1c76-5e3a-4e59-acc7-c3c9d062b23f\",\"parent_tool_use_id\":null,\"uuid\":\"5f4aad79-b70b-44b1-b593-b9c9f9287c84\"}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/009-implementor.stdout.log:1280:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_01SkjdTUdPWsC3Zf9iE5iPk9\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_011pwVxaZ3XeEbaHBqFcqce2\",\"name\":\"Write\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-sweep.test.ts\",\"content\":\"// Epic 03 Story 3: the readiness sweep (TC-3.1–3.4, the classification-edge\\n// architecture-risk legs, and the suite-wide zero-provider assertion's\\n// completion across all five thread-view ops). Every TC goes through the\\n// real SDK surface (createSdk().threadView.sweep / .compact) against real\\n// temp thread files; the provider double appears only in fixture setup and\\n// in TC-3.4's sanctioned heal drain — no Epic 03 operation may touch it.\\n// Failed and blocked states are reached through production paths (scripted\\n// provider failures consumed by real retry/exhaustion mechanics, real source\\n// damage on the sacrificial sibling), never by writing derived_form rows.\\nimport { afterAll, beforeAll, describe, expect, it } from \\\"vitest\\\";\\nimport { createSdk, type Lhc, type SweepReceipt } from \\\"../src/index.js\\\";\\nimport {\\n  assertSweepReceiptShape,\\n  blockedSiblingThread,\\n  classifyFailureReason,\\n  createProviderDouble,\\n  derivedThreadFixture,\\n  openRaw,\\n  PERMANENT_FAILURE_REASON,\\n  REASON_CLASS_TABLE,\\n  seedViewBoundary,\\n  tempStore,\\n  validEvent,\\n  type DerivedThreadFixture,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\ntype OwnerLine = SweepReceipt[\\\"owners\\\"][number];\\n\\nfunction ownerLine(\\n  receipt: SweepReceipt,\\n  owner: OwnerLine[\\\"owner\\\"],\\n  kind: string,\\n): OwnerLine {\\n  const line = receipt.owners.find((entry) => entry.owner === owner && entry.kind === kind);\\n  if (line === undefined) throw new Error(`no receipt line for ${owner}/${kind}`);\\n  return line;\\n}\\n\\n// Work rows for one subject's rebuild, counted by key below the SDK\\n// (TC-3.2's \\\"exactly one work row exists for it\\\"). The requeue patch keeps\\n// the queue live-work-only, so any row here is queued or claimed work.\\nfunction workRowsFor(filePath: string, kind: string, subjectId: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db\\n      .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE kind = ? AND source_ref LIKE ?`)\\n      .get(kind, `%\\\"${subjectId}\\\"%`) as { n: number | bigint };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction workItemCount(filePath: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\\n      n: number | bigint;\\n    };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nasync function reportEntry(\\n  sdk: Lhc,\\n  filePath: string,\\n  messageId: string,\\n  form: string,\\n): Promise<{ state: string; reason?: string; queueStatus?: string; content?: string }> {\\n  const report = await sdk.messages.report({ filePath }, { messageId });\\n  if (!report.ok) throw new Error(`report failed: ${report.error.reason}`);\\n  const entry = report.value.find((row) => row.form === form);\\n  if (entry === undefined) throw new Error(`no ${form} entry for ${messageId}`);\\n  return {\\n    state: entry.state,\\n    ...(entry.reason === undefined ? {} : { reason: entry.reason }),\\n    ...(entry.queue === undefined ? {} : { queueStatus: entry.queue.status }),\\n    ...(entry.content === undefined ? {} : { content: entry.content }),\\n  };\\n}\\n\\ndescribe(\\\"TC-3.1–TC-3.3 (AC-3.1–3.5, 3.7): the standalone sweep over the seeded states\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n  let firstReceipt: SweepReceipt;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n    // The pending leg of the seed: one more closed turn, NOT drained (manual\\n    // mode never drains uninvoked), so its smoothed_prompt and turn forms sit\\n    // pending with live queue rows when the sweep walks the reports.\\n    const sent = await fixture.sdk.intakeStream.messageEvents({ filePath: fixture.filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"extra pending turn for the sweep seed\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"left undrained on purpose\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    if (!sent.ok) throw new Error(`extra-turn intake failed: ${sent.error.reason}`);\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"TC-3.1: buckets the five seeded states, requeues only the transient failure, returns without waiting, zero provider calls\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(0);\\n\\n    const startedAt = Date.now();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const elapsedMs = Date.now() - startedAt;\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    firstReceipt = swept.value;\\n\\n    // No waiting (AC-3.2): the sweep is report reads plus row writes; any\\n    // drain or poll inside it would blow this bound (anti-shim tripwire).\\n    expect(elapsedMs).toBeLessThan(1000);\\n\\n    // The tool_result_summary line carries the story's whole failed×classify\\n    // contract: 6 of the fixture's 8 results drained ready, the scripted\\n    // transient exhaustion requeued, the scripted permanent failure reported\\n    // with its reason and left alone (AC-3.3, AC-3.5).\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(6);\\n    expect(results.requeued).toEqual([transientId]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n    expect(results.blocked).toEqual([]);\\n\\n    // Pending forms are left alone and reported as in-flight: the undrained\\n    // extra turn's prompt smoothing (messages) and turn derivation (turns).\\n    const prompts = ownerLine(swept.value, \\\"messages\\\", \\\"smoothed_prompt\\\");\\n    expect(prompts.ready).toBe(12);\\n    expect(prompts.inFlight).toBe(1);\\n    expect(prompts.requeued).toEqual([]);\\n    const renderings = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    expect(renderings.ready).toBe(12);\\n    expect(renderings.inFlight).toBe(1);\\n    expect(renderings.requeued).toEqual([]);\\n\\n    // The transient requeue really landed through the owner: one work row by\\n    // key, form cleared to pending with its queue row visible (AC-3.1's\\n    // owners-only write path read back through the owner's report).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"pending\\\");\\n    expect(transient.queueStatus).toBe(\\\"queued\\\");\\n\\n    // The permanent failure is untouched: still failed, no work row.\\n    const permanent = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      permanentId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(permanent.state).toBe(\\\"failed\\\");\\n    expect(permanent.reason).toBe(PERMANENT_FAILURE_REASON);\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", permanentId)).toBe(0);\\n\\n    // Nothing requeued anywhere else, and the sweep itself called no\\n    // provider (AC-3.1: no derivation, no model calls).\\n    const allRequeued = swept.value.owners.flatMap((line) => line.requeued);\\n    expect(allRequeued).toEqual([transientId]);\\n    expect(captured.length).toBe(0);\\n  });\\n\\n  it(\\\"TC-3.2 (AC-3.4): a second sweep without draining reports the requeued form in-flight and writes no second row\\\", async () => {\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.requeued).toEqual([]);\\n    expect(results.inFlight).toBe(1);\\n    expect(results.ready).toBe(6);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // Exactly one work row exists for the requeued form (count by key).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n  });\\n\\n  it(\\\"TC-3.3 schema leg (AC-3.5, AC-3.7): the SDK receipt validates against the shared receipt schema\\\", async () => {\\n    // The same checker Story 5's spawned CLI leg asserts against — \\\"same\\n    // receipt shape\\\" is one validator passing both targets, not two\\n    // hand-kept assertion lists.\\n    expect(() => assertSweepReceiptShape(firstReceipt)).not.toThrow();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    expect(() => assertSweepReceiptShape(swept.value)).not.toThrow();\\n    // Counts and reasons match the seeds across invocations: the receipt is\\n    // an accounting of durable state, not of sweep-local bookkeeping.\\n    expect(ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\").permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n  });\\n\\n  it(\\\"zero-provider assertion across all five ops (architecture-risk): pull, status, compact, sweep, materialize\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    const before = captured.length;\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    const status = await fixture.sdk.threadView.status({ filePath: fixture.filePath });\\n    const compacted = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 } } },\\n    );\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const materialized = await fixture.sdk.threadView.materialize(\\n      { filePath: fixture.filePath },\\n      { path: `${fixture.filePath}.out.jsonl` },\\n    );\\n\\n    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\\n    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\\n    expect(captured.length).toBe(before);\\n  });\\n});\\n\\ndescribe(\\\"classification edges (architecture-risk): blocked, in-walk dedupe, unclassified\\\", () => {\\n  let store: TempStore;\\n\\n  beforeAll(() => {\\n    store = tempStore();\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"blocked forms are reported with their stored reasons and never requeued\\\", async () => {\\n    const sibling = await blockedSiblingThread(store);\\n    const rowsBefore = workItemCount(sibling.filePath);\\n\\n    const swept = await sibling.sdk.threadView.sweep({ filePath: sibling.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // The damaged turn landed both turn forms blocked through the production\\n    // terminal path; the sweep reports each with its reason and asks the\\n    // owners for nothing.\\n    for (const kind of [\\\"turn_rendering\\\", \\\"lower_band_projection\\\"]) {\\n      const line = ownerLine(swept.value, \\\"turns\\\", kind);\\n      expect(line.blocked).toHaveLength(1);\\n      expect(line.blocked[0]?.subjectId).toBe(sibling.blockedTurnId);\\n      expect(line.blocked[0]?.reason).not.toBe(\\\"\\\");\\n      expect(line.requeued).toEqual([]);\\n    }\\n    expect(swept.value.owners.flatMap((line) => line.requeued)).toEqual([]);\\n    expect(workItemCount(sibling.filePath)).toBe(rowsBefore);\\n  });\\n\\n  it(\\\"once-per-invocation dedupe is structural: a turn's two transiently-failed forms share one work row, the second ask noops to in-flight\\\", async () => {\\n    // Both turn forms exhaust together through real retry mechanics (one\\n    // turn_derivation item rebuilds both), so the sweep's walk meets two\\n    // failed transient entries that share one queue site — the owner's\\n    // already_queued noop is what keeps the second ask from double-queuing,\\n    // and this test is what notices if Epic 02's requeue ever stops nooping.\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    double.failKind(\\\"turn_rendering\\\", 3, {\\n      retryable: true,\\n      reason: \\\"timeout: scripted turn exhaustion (test)\\\",\\n    });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"a turn whose derivation exhausts\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"an answer\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(0);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // One requeue, one noop-counted-as-in-flight, exactly one work row.\\n    const rendering = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    const projection = ownerLine(swept.value, \\\"turns\\\", \\\"lower_band_projection\\\");\\n    const requeued = [...rendering.requeued, ...projection.requeued];\\n    expect(requeued).toEqual([\\\"t1\\\"]);\\n    expect(rendering.inFlight + projection.inFlight).toBe(1);\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(1);\\n  });\\n\\n  it(\\\"an unclassified reason code lands in permanentFailed with its literal reason and is never requeued\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    // A terminal failure whose reason class the table has never heard of —\\n    // persisted through the production write path, classified conservative.\\n    const unclassifiedReason = \\\"mystery_code: gremlins in the pipeline\\\";\\n    double.failKind(\\\"tool_result_summary\\\", 1, { retryable: false, reason: unclassifiedReason });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"run the tool\\\" } }),\\n      validEvent(\\\"tool_call\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"u.txt\\\" } },\\n      }),\\n      validEvent(\\\"tool_result\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", content: \\\"unclassified-path output\\\", isError: false },\\n      }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const messageIds = sent.ok ? sent.value.events.map((entry) => entry.messageId ?? \\\"\\\") : [];\\n    const resultId = messageIds[2] ?? \\\"\\\";\\n    expect(resultId).not.toBe(\\\"\\\");\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    const rowsBefore = workItemCount(filePath);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const line = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(line.permanentFailed).toEqual([{ subjectId: resultId, reason: unclassifiedReason }]);\\n    expect(line.requeued).toEqual([]);\\n    expect(workItemCount(filePath)).toBe(rowsBefore);\\n    const entry = await reportEntry(sdk, filePath, resultId, \\\"tool_result_summary\\\");\\n    expect(entry.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"the classification table is data: named classes map as designed, everything else is permanent\\\", () => {\\n    expect(REASON_CLASS_TABLE).toEqual({\\n      rate_limit: \\\"transient\\\",\\n      timeout: \\\"transient\\\",\\n      provider_unavailable: \\\"transient\\\",\\n      content_refusal: \\\"permanent\\\",\\n      validation: \\\"permanent\\\",\\n      unknown_work_kind: \\\"permanent\\\",\\n    });\\n    expect(classifyFailureReason(\\\"rate_limit: provider said slow down\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"timeout: no response in 30s\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"provider_unavailable: 503\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"content_refusal: declined\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"validation: bad output shape\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"unknown_work_kind: nonesuch\\\")).toBe(\\\"permanent\\\");\\n    // The conservative default: unknown codes, codeless prose, and missing\\n    // reasons all classify permanent — never a requeue on a guess.\\n    expect(classifyFailureReason(\\\"mystery_code: gremlins\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"free prose with no class code\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(undefined)).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"\\\")).toBe(\\\"permanent\\\");\\n  });\\n});\\n\\ndescribe(\\\"TC-3.4 (AC-3.6, AC-2.7): the compact-embedded sweep, the skip, and the heal\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"compact with sweep: false records the skip and requeues nothing\\\", async () => {\\n    const rowsBefore = workItemCount(fixture.filePath);\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\", sweep: false },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    expect(receipt.value.sweep).toEqual({ skipped: true });\\n\\n    // Zero requeues occurred: no work row landed, the transient failure is\\n    // still failed.\\n    expect(workItemCount(fixture.filePath)).toBe(rowsBefore);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\\n    // Default compact: the sweep runs first and its full receipt embeds\\n    // (Story 2's \\\"absent\\\" placeholder is gone from the vocabulary).\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    const embedded = receipt.value.sweep;\\n    expect(embedded).not.toEqual({ skipped: true });\\n    if (!(\\\"owners\\\" in embedded)) return;\\n    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\\n    expect(ownerLine(embedded, \\\"messages\\\", \\\"tool_result_summary\\\").requeued).toEqual([\\n      transientId,\\n    ]);\\n\\n    // The heal leg — the one sanctioned test-setup use of inference\\n    // machinery: a background SDK's first touch schedules the production\\n    // catch-up drain over the requeued row; drainSettled awaits it. No\\n    // Epic 03 operation below touches the provider.\\n    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\\n    const touched = await bg.threadView.status({ filePath: fixture.filePath });\\n    expect(touched.ok).toBe(true);\\n    await bg.drainSettled({ filePath: fixture.filePath });\\n\\n    const healed = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(healed.state).toBe(\\\"ready\\\");\\n    expect(healed.content).toBeDefined();\\n\\n    // The next default compact sees the heal: its embedded sweep reports the\\n    // form ready (7 now), nothing to requeue, only the permanent failure\\n    // still on the books.\\n    const next = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(next.ok).toBe(true);\\n    if (!next.ok) return;\\n    const nextSweep = next.value.sweep;\\n    if (!(\\\"owners\\\" in nextSweep)) return;\\n    const results = ownerLine(nextSweep, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(7);\\n    expect(results.requeued).toEqual([]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // And the healed form feeds the served view: with the coding bound this\\n    // small thread is all tail (compact point 0), so seed the boundary at the\\n    // healed result's position — the short form now renders the READY\\n    // summary, the ladder's first rung, not the truncation fallback.\\n    expect(next.value.compactPoint).toBe(0);\\n    const listed = await fixture.sdk.messages.listMessages({ filePath: fixture.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    const healedMessage = listed.value.find((m) => m.messageId === transientId);\\n    expect(healedMessage).toBeDefined();\\n    if (healedMessage === undefined) return;\\n    seedViewBoundary(fixture.filePath, healedMessage.sourceEventOrder);\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(pulled.ok).toBe(true);\\n    if (!pulled.ok) return;\\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n      `[tool result · read_file · abridged]\\\\n${healed.content} [full content in record §${transientId}]`,\\n    );\\n  });\\n});\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":131,\"cache_creation_input_tokens\":3635,\"cache_read_input_tokens\":135124,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":3635},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"14af1c76-5e3a-4e59-acc7-c3c9d062b23f\",\"uuid\":\"0ce9d1ab-b8b0-4c84-aca7-bbeab4d4b9fe\",\"request_id\":\"req_011Cbwqy3xCYfsAykjzuCmzG\"}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/009-implementor.stdout.log:1283:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_011pwVxaZ3XeEbaHBqFcqce2\",\"type\":\"tool_result\",\"content\":\"File created successfully at: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-sweep.test.ts (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"14af1c76-5e3a-4e59-acc7-c3c9d062b23f\",\"uuid\":\"8be1677e-b2f3-4a51-9f20-d9bc76d5c8cf\",\"timestamp\":\"2026-06-11T17:14:52.105Z\",\"tool_use_result\":{\"type\":\"create\",\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-sweep.test.ts\",\"content\":\"// Epic 03 Story 3: the readiness sweep (TC-3.1–3.4, the classification-edge\\n// architecture-risk legs, and the suite-wide zero-provider assertion's\\n// completion across all five thread-view ops). Every TC goes through the\\n// real SDK surface (createSdk().threadView.sweep / .compact) against real\\n// temp thread files; the provider double appears only in fixture setup and\\n// in TC-3.4's sanctioned heal drain — no Epic 03 operation may touch it.\\n// Failed and blocked states are reached through production paths (scripted\\n// provider failures consumed by real retry/exhaustion mechanics, real source\\n// damage on the sacrificial sibling), never by writing derived_form rows.\\nimport { afterAll, beforeAll, describe, expect, it } from \\\"vitest\\\";\\nimport { createSdk, type Lhc, type SweepReceipt } from \\\"../src/index.js\\\";\\nimport {\\n  assertSweepReceiptShape,\\n  blockedSiblingThread,\\n  classifyFailureReason,\\n  createProviderDouble,\\n  derivedThreadFixture,\\n  openRaw,\\n  PERMANENT_FAILURE_REASON,\\n  REASON_CLASS_TABLE,\\n  seedViewBoundary,\\n  tempStore,\\n  validEvent,\\n  type DerivedThreadFixture,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\ntype OwnerLine = SweepReceipt[\\\"owners\\\"][number];\\n\\nfunction ownerLine(\\n  receipt: SweepReceipt,\\n  owner: OwnerLine[\\\"owner\\\"],\\n  kind: string,\\n): OwnerLine {\\n  const line = receipt.owners.find((entry) => entry.owner === owner && entry.kind === kind);\\n  if (line === undefined) throw new Error(`no receipt line for ${owner}/${kind}`);\\n  return line;\\n}\\n\\n// Work rows for one subject's rebuild, counted by key below the SDK\\n// (TC-3.2's \\\"exactly one work row exists for it\\\"). The requeue patch keeps\\n// the queue live-work-only, so any row here is queued or claimed work.\\nfunction workRowsFor(filePath: string, kind: string, subjectId: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db\\n      .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE kind = ? AND source_ref LIKE ?`)\\n      .get(kind, `%\\\"${subjectId}\\\"%`) as { n: number | bigint };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction workItemCount(filePath: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\\n      n: number | bigint;\\n    };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nasync function reportEntry(\\n  sdk: Lhc,\\n  filePath: string,\\n  messageId: string,\\n  form: string,\\n): Promise<{ state: string; reason?: string; queueStatus?: string; content?: string }> {\\n  const report = await sdk.messages.report({ filePath }, { messageId });\\n  if (!report.ok) throw new Error(`report failed: ${report.error.reason}`);\\n  const entry = report.value.find((row) => row.form === form);\\n  if (entry === undefined) throw new Error(`no ${form} entry for ${messageId}`);\\n  return {\\n    state: entry.state,\\n    ...(entry.reason === undefined ? {} : { reason: entry.reason }),\\n    ...(entry.queue === undefined ? {} : { queueStatus: entry.queue.status }),\\n    ...(entry.content === undefined ? {} : { content: entry.content }),\\n  };\\n}\\n\\ndescribe(\\\"TC-3.1–TC-3.3 (AC-3.1–3.5, 3.7): the standalone sweep over the seeded states\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n  let firstReceipt: SweepReceipt;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n    // The pending leg of the seed: one more closed turn, NOT drained (manual\\n    // mode never drains uninvoked), so its smoothed_prompt and turn forms sit\\n    // pending with live queue rows when the sweep walks the reports.\\n    const sent = await fixture.sdk.intakeStream.messageEvents({ filePath: fixture.filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"extra pending turn for the sweep seed\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"left undrained on purpose\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    if (!sent.ok) throw new Error(`extra-turn intake failed: ${sent.error.reason}`);\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"TC-3.1: buckets the five seeded states, requeues only the transient failure, returns without waiting, zero provider calls\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(0);\\n\\n    const startedAt = Date.now();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const elapsedMs = Date.now() - startedAt;\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    firstReceipt = swept.value;\\n\\n    // No waiting (AC-3.2): the sweep is report reads plus row writes; any\\n    // drain or poll inside it would blow this bound (anti-shim tripwire).\\n    expect(elapsedMs).toBeLessThan(1000);\\n\\n    // The tool_result_summary line carries the story's whole failed×classify\\n    // contract: 6 of the fixture's 8 results drained ready, the scripted\\n    // transient exhaustion requeued, the scripted permanent failure reported\\n    // with its reason and left alone (AC-3.3, AC-3.5).\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(6);\\n    expect(results.requeued).toEqual([transientId]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n    expect(results.blocked).toEqual([]);\\n\\n    // Pending forms are left alone and reported as in-flight: the undrained\\n    // extra turn's prompt smoothing (messages) and turn derivation (turns).\\n    const prompts = ownerLine(swept.value, \\\"messages\\\", \\\"smoothed_prompt\\\");\\n    expect(prompts.ready).toBe(12);\\n    expect(prompts.inFlight).toBe(1);\\n    expect(prompts.requeued).toEqual([]);\\n    const renderings = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    expect(renderings.ready).toBe(12);\\n    expect(renderings.inFlight).toBe(1);\\n    expect(renderings.requeued).toEqual([]);\\n\\n    // The transient requeue really landed through the owner: one work row by\\n    // key, form cleared to pending with its queue row visible (AC-3.1's\\n    // owners-only write path read back through the owner's report).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"pending\\\");\\n    expect(transient.queueStatus).toBe(\\\"queued\\\");\\n\\n    // The permanent failure is untouched: still failed, no work row.\\n    const permanent = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      permanentId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(permanent.state).toBe(\\\"failed\\\");\\n    expect(permanent.reason).toBe(PERMANENT_FAILURE_REASON);\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", permanentId)).toBe(0);\\n\\n    // Nothing requeued anywhere else, and the sweep itself called no\\n    // provider (AC-3.1: no derivation, no model calls).\\n    const allRequeued = swept.value.owners.flatMap((line) => line.requeued);\\n    expect(allRequeued).toEqual([transientId]);\\n    expect(captured.length).toBe(0);\\n  });\\n\\n  it(\\\"TC-3.2 (AC-3.4): a second sweep without draining reports the requeued form in-flight and writes no second row\\\", async () => {\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.requeued).toEqual([]);\\n    expect(results.inFlight).toBe(1);\\n    expect(results.ready).toBe(6);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // Exactly one work row exists for the requeued form (count by key).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n  });\\n\\n  it(\\\"TC-3.3 schema leg (AC-3.5, AC-3.7): the SDK receipt validates against the shared receipt schema\\\", async () => {\\n    // The same checker Story 5's spawned CLI leg asserts against — \\\"same\\n    // receipt shape\\\" is one validator passing both targets, not two\\n    // hand-kept assertion lists.\\n    expect(() => assertSweepReceiptShape(firstReceipt)).not.toThrow();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    expect(() => assertSweepReceiptShape(swept.value)).not.toThrow();\\n    // Counts and reasons match the seeds across invocations: the receipt is\\n    // an accounting of durable state, not of sweep-local bookkeeping.\\n    expect(ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\").permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n  });\\n\\n  it(\\\"zero-provider assertion across all five ops (architecture-risk): pull, status, compact, sweep, materialize\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    const before = captured.length;\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    const status = await fixture.sdk.threadView.status({ filePath: fixture.filePath });\\n    const compacted = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 } } },\\n    );\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const materialized = await fixture.sdk.threadView.materialize(\\n      { filePath: fixture.filePath },\\n      { path: `${fixture.filePath}.out.jsonl` },\\n    );\\n\\n    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\\n    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\\n    expect(captured.length).toBe(before);\\n  });\\n});\\n\\ndescribe(\\\"classification edges (architecture-risk): blocked, in-walk dedupe, unclassified\\\", () => {\\n  let store: TempStore;\\n\\n  beforeAll(() => {\\n    store = tempStore();\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"blocked forms are reported with their stored reasons and never requeued\\\", async () => {\\n    const sibling = await blockedSiblingThread(store);\\n    const rowsBefore = workItemCount(sibling.filePath);\\n\\n    const swept = await sibling.sdk.threadView.sweep({ filePath: sibling.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // The damaged turn landed both turn forms blocked through the production\\n    // terminal path; the sweep reports each with its reason and asks the\\n    // owners for nothing.\\n    for (const kind of [\\\"turn_rendering\\\", \\\"lower_band_projection\\\"]) {\\n      const line = ownerLine(swept.value, \\\"turns\\\", kind);\\n      expect(line.blocked).toHaveLength(1);\\n      expect(line.blocked[0]?.subjectId).toBe(sibling.blockedTurnId);\\n      expect(line.blocked[0]?.reason).not.toBe(\\\"\\\");\\n      expect(line.requeued).toEqual([]);\\n    }\\n    expect(swept.value.owners.flatMap((line) => line.requeued)).toEqual([]);\\n    expect(workItemCount(sibling.filePath)).toBe(rowsBefore);\\n  });\\n\\n  it(\\\"once-per-invocation dedupe is structural: a turn's two transiently-failed forms share one work row, the second ask noops to in-flight\\\", async () => {\\n    // Both turn forms exhaust together through real retry mechanics (one\\n    // turn_derivation item rebuilds both), so the sweep's walk meets two\\n    // failed transient entries that share one queue site — the owner's\\n    // already_queued noop is what keeps the second ask from double-queuing,\\n    // and this test is what notices if Epic 02's requeue ever stops nooping.\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    double.failKind(\\\"turn_rendering\\\", 3, {\\n      retryable: true,\\n      reason: \\\"timeout: scripted turn exhaustion (test)\\\",\\n    });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"a turn whose derivation exhausts\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"an answer\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(0);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // One requeue, one noop-counted-as-in-flight, exactly one work row.\\n    const rendering = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    const projection = ownerLine(swept.value, \\\"turns\\\", \\\"lower_band_projection\\\");\\n    const requeued = [...rendering.requeued, ...projection.requeued];\\n    expect(requeued).toEqual([\\\"t1\\\"]);\\n    expect(rendering.inFlight + projection.inFlight).toBe(1);\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(1);\\n  });\\n\\n  it(\\\"an unclassified reason code lands in permanentFailed with its literal reason and is never requeued\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    // A terminal failure whose reason class the table has never heard of —\\n    // persisted through the production write path, classified conservative.\\n    const unclassifiedReason = \\\"mystery_code: gremlins in the pipeline\\\";\\n    double.failKind(\\\"tool_result_summary\\\", 1, { retryable: false, reason: unclassifiedReason });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"run the tool\\\" } }),\\n      validEvent(\\\"tool_call\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"u.txt\\\" } },\\n      }),\\n      validEvent(\\\"tool_result\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", content: \\\"unclassified-path output\\\", isError: false },\\n      }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const messageIds = sent.ok ? sent.value.events.map((entry) => entry.messageId ?? \\\"\\\") : [];\\n    const resultId = messageIds[2] ?? \\\"\\\";\\n    expect(resultId).not.toBe(\\\"\\\");\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    const rowsBefore = workItemCount(filePath);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const line = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(line.permanentFailed).toEqual([{ subjectId: resultId, reason: unclassifiedReason }]);\\n    expect(line.requeued).toEqual([]);\\n    expect(workItemCount(filePath)).toBe(rowsBefore);\\n    const entry = await reportEntry(sdk, filePath, resultId, \\\"tool_result_summary\\\");\\n    expect(entry.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"the classification table is data: named classes map as designed, everything else is permanent\\\", () => {\\n    expect(REASON_CLASS_TABLE).toEqual({\\n      rate_limit: \\\"transient\\\",\\n      timeout: \\\"transient\\\",\\n      provider_unavailable: \\\"transient\\\",\\n      content_refusal: \\\"permanent\\\",\\n      validation: \\\"permanent\\\",\\n      unknown_work_kind: \\\"permanent\\\",\\n    });\\n    expect(classifyFailureReason(\\\"rate_limit: provider said slow down\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"timeout: no response in 30s\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"provider_unavailable: 503\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"content_refusal: declined\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"validation: bad output shape\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"unknown_work_kind: nonesuch\\\")).toBe(\\\"permanent\\\");\\n    // The conservative default: unknown codes, codeless prose, and missing\\n    // reasons all classify permanent — never a requeue on a guess.\\n    expect(classifyFailureReason(\\\"mystery_code: gremlins\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"free prose with no class code\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(undefined)).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"\\\")).toBe(\\\"permanent\\\");\\n  });\\n});\\n\\ndescribe(\\\"TC-3.4 (AC-3.6, AC-2.7): the compact-embedded sweep, the skip, and the heal\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"compact with sweep: false records the skip and requeues nothing\\\", async () => {\\n    const rowsBefore = workItemCount(fixture.filePath);\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\", sweep: false },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    expect(receipt.value.sweep).toEqual({ skipped: true });\\n\\n    // Zero requeues occurred: no work row landed, the transient failure is\\n    // still failed.\\n    expect(workItemCount(fixture.filePath)).toBe(rowsBefore);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\\n    // Default compact: the sweep runs first and its full receipt embeds\\n    // (Story 2's \\\"absent\\\" placeholder is gone from the vocabulary).\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    const embedded = receipt.value.sweep;\\n    expect(embedded).not.toEqual({ skipped: true });\\n    if (!(\\\"owners\\\" in embedded)) return;\\n    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\\n    expect(ownerLine(embedded, \\\"messages\\\", \\\"tool_result_summary\\\").requeued).toEqual([\\n      transientId,\\n    ]);\\n\\n    // The heal leg — the one sanctioned test-setup use of inference\\n    // machinery: a background SDK's first touch schedules the production\\n    // catch-up drain over the requeued row; drainSettled awaits it. No\\n    // Epic 03 operation below touches the provider.\\n    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\\n    const touched = await bg.threadView.status({ filePath: fixture.filePath });\\n    expect(touched.ok).toBe(true);\\n    await bg.drainSettled({ filePath: fixture.filePath });\\n\\n    const healed = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(healed.state).toBe(\\\"ready\\\");\\n    expect(healed.content).toBeDefined();\\n\\n    // The next default compact sees the heal: its embedded sweep reports the\\n    // form ready (7 now), nothing to requeue, only the permanent failure\\n    // still on the books.\\n    const next = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(next.ok).toBe(true);\\n    if (!next.ok) return;\\n    const nextSweep = next.value.sweep;\\n    if (!(\\\"owners\\\" in nextSweep)) return;\\n    const results = ownerLine(nextSweep, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(7);\\n    expect(results.requeued).toEqual([]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // And the healed form feeds the served view: with the coding bound this\\n    // small thread is all tail (compact point 0), so seed the boundary at the\\n    // healed result's position — the short form now renders the READY\\n    // summary, the ladder's first rung, not the truncation fallback.\\n    expect(next.value.compactPoint).toBe(0);\\n    const listed = await fixture.sdk.messages.listMessages({ filePath: fixture.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    const healedMessage = listed.value.find((m) => m.messageId === transientId);\\n    expect(healedMessage).toBeDefined();\\n    if (healedMessage === undefined) return;\\n    seedViewBoundary(fixture.filePath, healedMessage.sourceEventOrder);\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(pulled.ok).toBe(true);\\n    if (!pulled.ok) return;\\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n      `[tool result · read_file · abridged]\\\\n${healed.content} [full content in record §${transientId}]`,\\n    );\\n  });\\n});\\n\",\"structuredPatch\":[],\"originalFile\":null,\"userModified\":false}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/009-implementor.stdout.log:1512:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01S3vgrmE46SGZnmFxB7jdGB\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-sweep.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"14af1c76-5e3a-4e59-acc7-c3c9d062b23f\",\"uuid\":\"d7bb5d1c-470a-4147-9aed-be9f0698f2fa\",\"timestamp\":\"2026-06-11T17:16:33.873Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-sweep.test.ts\",\"oldString\":\"  it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\\n    // Default compact: the sweep runs first and its full receipt embeds\\n    // (Story 2's \\\"absent\\\" placeholder is gone from the vocabulary).\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    const embedded = receipt.value.sweep;\\n    expect(embedded).not.toEqual({ skipped: true });\\n    if (!(\\\"owners\\\" in embedded)) return;\\n    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\\n    expect(ownerLine(embedded, \\\"messages\\\", \\\"tool_result_summary\\\").requeued).toEqual([\\n      transientId,\\n    ]);\\n\\n    // The heal leg — the one sanctioned test-setup use of inference\\n    // machinery: a background SDK's first touch schedules the production\\n    // catch-up drain over the requeued row; drainSettled awaits it. No\\n    // Epic 03 operation below touches the provider.\\n    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\\n    const touched = await bg.threadView.status({ filePath: fixture.filePath });\\n    expect(touched.ok).toBe(true);\\n    await bg.drainSettled({ filePath: fixture.filePath });\",\"newString\":\"  it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\\n    // Default compact through a BACKGROUND SDK: the sweep runs first and its\\n    // full receipt embeds (Story 2's \\\"absent\\\" placeholder is gone from the\\n    // vocabulary), and the embedded requeue's poke-on-commit lands on the\\n    // background scheduler — the production repair path needs no drain call.\\n    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\\n    const receipt = await bg.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    const embedded = receipt.value.sweep;\\n    expect(embedded).not.toEqual({ skipped: true });\\n    if (!(\\\"owners\\\" in embedded)) return;\\n    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\\n    expect(ownerLine(embedded, \\\"messages\\\", \\\"tool_result_summary\\\").requeued).toEqual([\\n      transientId,\\n    ]);\\n\\n    // The heal leg — the one sanctioned test-setup use of inference\\n    // machinery: drainSettled awaits the poked background drain over the\\n    // requeued row. No Epic 03 operation below touches the provider.\\n    await bg.drainSettled({ filePath: fixture.filePath });\",\"originalFile\":\"// Epic 03 Story 3: the readiness sweep (TC-3.1–3.4, the classification-edge\\n// architecture-risk legs, and the suite-wide zero-provider assertion's\\n// completion across all five thread-view ops). Every TC goes through the\\n// real SDK surface (createSdk().threadView.sweep / .compact) against real\\n// temp thread files; the provider double appears only in fixture setup and\\n// in TC-3.4's sanctioned heal drain — no Epic 03 operation may touch it.\\n// Failed and blocked states are reached through production paths (scripted\\n// provider failures consumed by real retry/exhaustion mechanics, real source\\n// damage on the sacrificial sibling), never by writing derived_form rows.\\nimport { afterAll, beforeAll, describe, expect, it } from \\\"vitest\\\";\\nimport { createSdk, type Lhc, type SweepReceipt } from \\\"../src/index.js\\\";\\nimport {\\n  assertSweepReceiptShape,\\n  blockedSiblingThread,\\n  classifyFailureReason,\\n  createProviderDouble,\\n  derivedThreadFixture,\\n  openRaw,\\n  PERMANENT_FAILURE_REASON,\\n  REASON_CLASS_TABLE,\\n  seedViewBoundary,\\n  tempStore,\\n  validEvent,\\n  type DerivedThreadFixture,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\ntype OwnerLine = SweepReceipt[\\\"owners\\\"][number];\\n\\nfunction ownerLine(\\n  receipt: SweepReceipt,\\n  owner: OwnerLine[\\\"owner\\\"],\\n  kind: string,\\n): OwnerLine {\\n  const line = receipt.owners.find((entry) => entry.owner === owner && entry.kind === kind);\\n  if (line === undefined) throw new Error(`no receipt line for ${owner}/${kind}`);\\n  return line;\\n}\\n\\n// Work rows for one subject's rebuild, counted by key below the SDK\\n// (TC-3.2's \\\"exactly one work row exists for it\\\"). The requeue patch keeps\\n// the queue live-work-only, so any row here is queued or claimed work.\\nfunction workRowsFor(filePath: string, kind: string, subjectId: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db\\n      .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE kind = ? AND source_ref LIKE ?`)\\n      .get(kind, `%\\\"${subjectId}\\\"%`) as { n: number | bigint };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction workItemCount(filePath: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\\n      n: number | bigint;\\n    };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nasync function reportEntry(\\n  sdk: Lhc,\\n  filePath: string,\\n  messageId: string,\\n  form: string,\\n): Promise<{ state: string; reason?: string; queueStatus?: string; content?: string }> {\\n  const report = await sdk.messages.report({ filePath }, { messageId });\\n  if (!report.ok) throw new Error(`report failed: ${report.error.reason}`);\\n  const entry = report.value.find((row) => row.form === form);\\n  if (entry === undefined) throw new Error(`no ${form} entry for ${messageId}`);\\n  return {\\n    state: entry.state,\\n    ...(entry.reason === undefined ? {} : { reason: entry.reason }),\\n    ...(entry.queue === undefined ? {} : { queueStatus: entry.queue.status }),\\n    ...(entry.content === undefined ? {} : { content: entry.content }),\\n  };\\n}\\n\\ndescribe(\\\"TC-3.1–TC-3.3 (AC-3.1–3.5, 3.7): the standalone sweep over the seeded states\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n  let firstReceipt: SweepReceipt;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n    // The pending leg of the seed: one more closed turn, NOT drained (manual\\n    // mode never drains uninvoked), so its smoothed_prompt and turn forms sit\\n    // pending with live queue rows when the sweep walks the reports.\\n    const sent = await fixture.sdk.intakeStream.messageEvents({ filePath: fixture.filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"extra pending turn for the sweep seed\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"left undrained on purpose\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    if (!sent.ok) throw new Error(`extra-turn intake failed: ${sent.error.reason}`);\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"TC-3.1: buckets the five seeded states, requeues only the transient failure, returns without waiting, zero provider calls\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(0);\\n\\n    const startedAt = Date.now();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const elapsedMs = Date.now() - startedAt;\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    firstReceipt = swept.value;\\n\\n    // No waiting (AC-3.2): the sweep is report reads plus row writes; any\\n    // drain or poll inside it would blow this bound (anti-shim tripwire).\\n    expect(elapsedMs).toBeLessThan(1000);\\n\\n    // The tool_result_summary line carries the story's whole failed×classify\\n    // contract: 6 of the fixture's 8 results drained ready, the scripted\\n    // transient exhaustion requeued, the scripted permanent failure reported\\n    // with its reason and left alone (AC-3.3, AC-3.5).\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(6);\\n    expect(results.requeued).toEqual([transientId]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n    expect(results.blocked).toEqual([]);\\n\\n    // Pending forms are left alone and reported as in-flight: the undrained\\n    // extra turn's prompt smoothing (messages) and turn derivation (turns).\\n    const prompts = ownerLine(swept.value, \\\"messages\\\", \\\"smoothed_prompt\\\");\\n    expect(prompts.ready).toBe(12);\\n    expect(prompts.inFlight).toBe(1);\\n    expect(prompts.requeued).toEqual([]);\\n    const renderings = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    expect(renderings.ready).toBe(12);\\n    expect(renderings.inFlight).toBe(1);\\n    expect(renderings.requeued).toEqual([]);\\n\\n    // The transient requeue really landed through the owner: one work row by\\n    // key, form cleared to pending with its queue row visible (AC-3.1's\\n    // owners-only write path read back through the owner's report).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"pending\\\");\\n    expect(transient.queueStatus).toBe(\\\"queued\\\");\\n\\n    // The permanent failure is untouched: still failed, no work row.\\n    const permanent = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      permanentId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(permanent.state).toBe(\\\"failed\\\");\\n    expect(permanent.reason).toBe(PERMANENT_FAILURE_REASON);\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", permanentId)).toBe(0);\\n\\n    // Nothing requeued anywhere else, and the sweep itself called no\\n    // provider (AC-3.1: no derivation, no model calls).\\n    const allRequeued = swept.value.owners.flatMap((line) => line.requeued);\\n    expect(allRequeued).toEqual([transientId]);\\n    expect(captured.length).toBe(0);\\n  });\\n\\n  it(\\\"TC-3.2 (AC-3.4): a second sweep without draining reports the requeued form in-flight and writes no second row\\\", async () => {\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.requeued).toEqual([]);\\n    expect(results.inFlight).toBe(1);\\n    expect(results.ready).toBe(6);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // Exactly one work row exists for the requeued form (count by key).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n  });\\n\\n  it(\\\"TC-3.3 schema leg (AC-3.5, AC-3.7): the SDK receipt validates against the shared receipt schema\\\", async () => {\\n    // The same checker Story 5's spawned CLI leg asserts against — \\\"same\\n    // receipt shape\\\" is one validator passing both targets, not two\\n    // hand-kept assertion lists.\\n    expect(() => assertSweepReceiptShape(firstReceipt)).not.toThrow();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    expect(() => assertSweepReceiptShape(swept.value)).not.toThrow();\\n    // Counts and reasons match the seeds across invocations: the receipt is\\n    // an accounting of durable state, not of sweep-local bookkeeping.\\n    expect(ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\").permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n  });\\n\\n  it(\\\"zero-provider assertion across all five ops (architecture-risk): pull, status, compact, sweep, materialize\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    const before = captured.length;\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    const status = await fixture.sdk.threadView.status({ filePath: fixture.filePath });\\n    const compacted = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 } } },\\n    );\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const materialized = await fixture.sdk.threadView.materialize(\\n      { filePath: fixture.filePath },\\n      { path: `${fixture.filePath}.out.jsonl` },\\n    );\\n\\n    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\\n    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\\n    expect(captured.length).toBe(before);\\n  });\\n});\\n\\ndescribe(\\\"classification edges (architecture-risk): blocked, in-walk dedupe, unclassified\\\", () => {\\n  let store: TempStore;\\n\\n  beforeAll(() => {\\n    store = tempStore();\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"blocked forms are reported with their stored reasons and never requeued\\\", async () => {\\n    const sibling = await blockedSiblingThread(store);\\n    const rowsBefore = workItemCount(sibling.filePath);\\n\\n    const swept = await sibling.sdk.threadView.sweep({ filePath: sibling.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // The damaged turn landed both turn forms blocked through the production\\n    // terminal path; the sweep reports each with its reason and asks the\\n    // owners for nothing.\\n    for (const kind of [\\\"turn_rendering\\\", \\\"lower_band_projection\\\"]) {\\n      const line = ownerLine(swept.value, \\\"turns\\\", kind);\\n      expect(line.blocked).toHaveLength(1);\\n      expect(line.blocked[0]?.subjectId).toBe(sibling.blockedTurnId);\\n      expect(line.blocked[0]?.reason).not.toBe(\\\"\\\");\\n      expect(line.requeued).toEqual([]);\\n    }\\n    expect(swept.value.owners.flatMap((line) => line.requeued)).toEqual([]);\\n    expect(workItemCount(sibling.filePath)).toBe(rowsBefore);\\n  });\\n\\n  it(\\\"once-per-invocation dedupe is structural: a turn's two transiently-failed forms share one work row, the second ask noops to in-flight\\\", async () => {\\n    // Both turn forms exhaust together through real retry mechanics (one\\n    // turn_derivation item rebuilds both), so the sweep's walk meets two\\n    // failed transient entries that share one queue site — the owner's\\n    // already_queued noop is what keeps the second ask from double-queuing,\\n    // and this test is what notices if Epic 02's requeue ever stops nooping.\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    double.failKind(\\\"turn_rendering\\\", 3, {\\n      retryable: true,\\n      reason: \\\"timeout: scripted turn exhaustion (test)\\\",\\n    });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"a turn whose derivation exhausts\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"an answer\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(0);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // One requeue, one noop-counted-as-in-flight, exactly one work row.\\n    const rendering = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    const projection = ownerLine(swept.value, \\\"turns\\\", \\\"lower_band_projection\\\");\\n    const requeued = [...rendering.requeued, ...projection.requeued];\\n    expect(requeued).toEqual([\\\"t1\\\"]);\\n    expect(rendering.inFlight + projection.inFlight).toBe(1);\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(1);\\n  });\\n\\n  it(\\\"an unclassified reason code lands in permanentFailed with its literal reason and is never requeued\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    // A terminal failure whose reason class the table has never heard of —\\n    // persisted through the production write path, classified conservative.\\n    const unclassifiedReason = \\\"mystery_code: gremlins in the pipeline\\\";\\n    double.failKind(\\\"tool_result_summary\\\", 1, { retryable: false, reason: unclassifiedReason });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"run the tool\\\" } }),\\n      validEvent(\\\"tool_call\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"u.txt\\\" } },\\n      }),\\n      validEvent(\\\"tool_result\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", content: \\\"unclassified-path output\\\", isError: false },\\n      }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const messageIds = sent.ok ? sent.value.events.map((entry) => entry.messageId ?? \\\"\\\") : [];\\n    const resultId = messageIds[2] ?? \\\"\\\";\\n    expect(resultId).not.toBe(\\\"\\\");\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    const rowsBefore = workItemCount(filePath);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const line = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(line.permanentFailed).toEqual([{ subjectId: resultId, reason: unclassifiedReason }]);\\n    expect(line.requeued).toEqual([]);\\n    expect(workItemCount(filePath)).toBe(rowsBefore);\\n    const entry = await reportEntry(sdk, filePath, resultId, \\\"tool_result_summary\\\");\\n    expect(entry.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"the classification table is data: named classes map as designed, everything else is permanent\\\", () => {\\n    expect(REASON_CLASS_TABLE).toEqual({\\n      rate_limit: \\\"transient\\\",\\n      timeout: \\\"transient\\\",\\n      provider_unavailable: \\\"transient\\\",\\n      content_refusal: \\\"permanent\\\",\\n      validation: \\\"permanent\\\",\\n      unknown_work_kind: \\\"permanent\\\",\\n    });\\n    expect(classifyFailureReason(\\\"rate_limit: provider said slow down\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"timeout: no response in 30s\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"provider_unavailable: 503\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"content_refusal: declined\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"validation: bad output shape\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"unknown_work_kind: nonesuch\\\")).toBe(\\\"permanent\\\");\\n    // The conservative default: unknown codes, codeless prose, and missing\\n    // reasons all classify permanent — never a requeue on a guess.\\n    expect(classifyFailureReason(\\\"mystery_code: gremlins\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"free prose with no class code\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(undefined)).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"\\\")).toBe(\\\"permanent\\\");\\n  });\\n});\\n\\ndescribe(\\\"TC-3.4 (AC-3.6, AC-2.7): the compact-embedded sweep, the skip, and the heal\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"compact with sweep: false records the skip and requeues nothing\\\", async () => {\\n    const rowsBefore = workItemCount(fixture.filePath);\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\", sweep: false },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    expect(receipt.value.sweep).toEqual({ skipped: true });\\n\\n    // Zero requeues occurred: no work row landed, the transient failure is\\n    // still failed.\\n    expect(workItemCount(fixture.filePath)).toBe(rowsBefore);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\\n    // Default compact: the sweep runs first and its full receipt embeds\\n    // (Story 2's \\\"absent\\\" placeholder is gone from the vocabulary).\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    const embedded = receipt.value.sweep;\\n    expect(embedded).not.toEqual({ skipped: true });\\n    if (!(\\\"owners\\\" in embedded)) return;\\n    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\\n    expect(ownerLine(embedded, \\\"messages\\\", \\\"tool_result_summary\\\").requeued).toEqual([\\n      transientId,\\n    ]);\\n\\n    // The heal leg — the one sanctioned test-setup use of inference\\n    // machinery: a background SDK's first touch schedules the production\\n    // catch-up drain over the requeued row; drainSettled awaits it. No\\n    // Epic 03 operation below touches the provider.\\n    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\\n    const touched = await bg.threadView.status({ filePath: fixture.filePath });\\n    expect(touched.ok).toBe(true);\\n    await bg.drainSettled({ filePath: fixture.filePath });\\n\\n    const healed = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(healed.state).toBe(\\\"ready\\\");\\n    expect(healed.content).toBeDefined();\\n\\n    // The next default compact sees the heal: its embedded sweep reports the\\n    // form ready (7 now), nothing to requeue, only the permanent failure\\n    // still on the books.\\n    const next = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(next.ok).toBe(true);\\n    if (!next.ok) return;\\n    const nextSweep = next.value.sweep;\\n    if (!(\\\"owners\\\" in nextSweep)) return;\\n    const results = ownerLine(nextSweep, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(7);\\n    expect(results.requeued).toEqual([]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // And the healed form feeds the served view: with the coding bound this\\n    // small thread is all tail (compact point 0), so seed the boundary at the\\n    // healed result's position — the short form now renders the READY\\n    // summary, the ladder's first rung, not the truncation fallback.\\n    expect(next.value.compactPoint).toBe(0);\\n    const listed = await fixture.sdk.messages.listMessages({ filePath: fixture.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    const healedMessage = listed.value.find((m) => m.messageId === transientId);\\n    expect(healedMessage).toBeDefined();\\n    if (healedMessage === undefined) return;\\n    seedViewBoundary(fixture.filePath, healedMessage.sourceEventOrder);\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(pulled.ok).toBe(true);\\n    if (!pulled.ok) return;\\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n      `[tool result · read_file · abridged]\\\\n${healed.content} [full content in record §${transientId}]`,\\n    );\\n  });\\n});\\n\",\"structuredPatch\":[{\"oldStart\":421,\"oldLines\":9,\"newStart\":421,\"newLines\":12,\"lines\":[\"   });\",\" \",\"   it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\",\"-    // Default compact: the sweep runs first and its full receipt embeds\",\"-    // (Story 2's \\\"absent\\\" placeholder is gone from the vocabulary).\",\"-    const receipt = await fixture.sdk.threadView.compact(\",\"+    // Default compact through a BACKGROUND SDK: the sweep runs first and its\",\"+    // full receipt embeds (Story 2's \\\"absent\\\" placeholder is gone from the\",\"+    // vocabulary), and the embedded requeue's poke-on-commit lands on the\",\"+    // background scheduler — the production repair path needs no drain call.\",\"+    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\",\"+    const receipt = await bg.threadView.compact(\",\"       { filePath: fixture.filePath },\",\"       { profile: \\\"coding\\\" },\",\"     );\"]},{\"oldStart\":438,\"oldLines\":12,\"newStart\":441,\"newLines\":8,\"lines\":[\"     ]);\",\" \",\"     // The heal leg — the one sanctioned test-setup use of inference\",\"-    // machinery: a background SDK's first touch schedules the production\",\"-    // catch-up drain over the requeued row; drainSettled awaits it. No\",\"-    // Epic 03 operation below touches the provider.\",\"-    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\",\"-    const touched = await bg.threadView.status({ filePath: fixture.filePath });\",\"-    expect(touched.ok).toBe(true);\",\"+    // machinery: drainSettled awaits the poked background drain over the\",\"+    // requeued row. No Epic 03 operation below touches the provider.\",\"     await bg.drainSettled({ filePath: fixture.filePath });\",\" \",\"     const healed = await reportEntry(\"]}],\"userModified\":false,\"replaceAll\":false}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/00-foundation/streams/004-verify.stdout.log:32:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/fixtures/view-seam.ts | sed -n '1,500p' && nl -ba packages/lhc/test/fixtures/view-thread.ts | sed -n '1,700p'\\\"\",\"aggregated_output\":\"     1\\t// Epic 03 Story 0 view-domain test seams. Lives in fixtures/ — the one\\n     2\\t// directory sanctioned to reach below the SDK surface (boundary check\\n     3\\t// exempt).\\n     4\\t//\\n     5\\t// The injection facility (FC-0.6): re-export of the thread-view seam so\\n     6\\t// tests install crash/failure hooks at the two named points — the\\n     7\\t// post-commit advance (TC-4.6) and compact's write path between sweep and\\n     8\\t// view write (TC-2.4). Uninstalled, production fires are no-ops.\\n     9\\texport {\\n    10\\t  fireViewInjection,\\n    11\\t  setViewInjectionHook,\\n    12\\t  type ViewInjectionHook,\\n    13\\t  type ViewInjectionPoint,\\n    14\\t} from \\\"../../src/domains/thread-view/internal/seam.js\\\";\\n    15\\t\\n    16\\timport { DatabaseSync } from \\\"node:sqlite\\\";\\n    17\\t\\n    18\\t// Sanctioned below-SDK write (same sanctioning as corrupt.ts): seeds the\\n    19\\t// view_boundary row to an arbitrary position for TC-1.4's mid-tail pulls.\\n    20\\t// Boundary *mechanics* — how the position legally moves — are Story 4's to\\n    21\\t// prove; this helper only manufactures a position the pull must respect.\\n    22\\t// UPDATE-only on purpose: migration v6 seeded the singleton row, mirroring\\n    23\\t// the production advance's write shape.\\n    24\\texport function seedViewBoundary(filePath: string, position: number): void {\\n    25\\t  const db = new DatabaseSync(filePath);\\n    26\\t  try {\\n    27\\t    const changed = db\\n    28\\t      .prepare(\\n    29\\t        `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\\n    30\\t      )\\n    31\\t      .run(position, new Date().toISOString());\\n    32\\t    if (Number(changed.changes) !== 1) {\\n    33\\t      throw new Error(\\n    34\\t        `fixture seedViewBoundary hit ${String(changed.changes)} rows; expected the migration-seeded singleton`,\\n    35\\t      );\\n    36\\t    }\\n    37\\t  } finally {\\n    38\\t    db.close();\\n    39\\t  }\\n    40\\t}\\n     1\\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n     2\\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n     3\\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n     4\\t// deterministic provider double into known form states. States are reached\\n     5\\t// through production paths, never hand-written rows (the anti-shim line\\n     6\\t// FC-0.3 enforces): the failed states come from scripted provider failures\\n     7\\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n     8\\t// real source damage on a sacrificial sibling thread. Every later Epic 03\\n     9\\t// story compacts against what this builder returns.\\n    10\\timport {\\n    11\\t  createSdk,\\n    12\\t  type FormReportEntry,\\n    13\\t  type Lhc,\\n    14\\t  type MessageEventInput,\\n    15\\t} from \\\"../../src/index.js\\\";\\n    16\\timport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\n    17\\timport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\n    18\\timport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\n    19\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n    20\\t\\n    21\\t// Reason classes the scripted failures stamp, chosen from the sweep\\n    22\\t// classification table's vocabulary (tech design §Spec Validation): a\\n    23\\t// rate-limit class reads transient, a content-refusal class reads permanent —\\n    24\\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n    25\\t// Story 3 depends on it.\\n    26\\texport const TRANSIENT_EXHAUST_REASON =\\n    27\\t  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\n    28\\texport const PERMANENT_FAILURE_REASON =\\n    29\\t  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n    30\\t\\n    31\\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n    32\\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n    33\\t// deterministic double are near-constant in size (`projection(<digest>:<40\\n    34\\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n    35\\t// if drift ever moves it.\\n    36\\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n    37\\t\\n    38\\tconst TURN_COUNT = 12;\\n    39\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n    40\\t\\n    41\\tfunction turnEvents(turn: number): MessageEventInput[] {\\n    42\\t  const events: MessageEventInput[] = [\\n    43\\t    validEvent(\\\"user_prompt\\\", {\\n    44\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n    45\\t    }),\\n    46\\t    validEvent(\\\"assistant_thinking\\\", {\\n    47\\t      payload: { text: `considering what area ${turn} contains` },\\n    48\\t    }),\\n    49\\t  ];\\n    50\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    51\\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n    52\\t    // realistic over-max zone of tool results to age behind the boundary.\\n    53\\t    for (const run of [1, 2]) {\\n    54\\t      const toolCallId = `call-fx-${turn}-${run}`;\\n    55\\t      events.push(\\n    56\\t        validEvent(\\\"tool_call\\\", {\\n    57\\t          payload: {\\n    58\\t            toolCallId,\\n    59\\t            toolName: \\\"read_file\\\",\\n    60\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\n    61\\t          },\\n    62\\t        }),\\n    63\\t        validEvent(\\\"tool_result\\\", {\\n    64\\t          payload: {\\n    65\\t            toolCallId,\\n    66\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n    67\\t            isError: false,\\n    68\\t          },\\n    69\\t        }),\\n    70\\t      );\\n    71\\t    }\\n    72\\t  }\\n    73\\t  events.push(\\n    74\\t    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n    75\\t    validEvent(\\\"turn_end\\\"),\\n    76\\t  );\\n    77\\t  return events;\\n    78\\t}\\n    79\\t\\n    80\\texport interface DerivedThreadFixture {\\n    81\\t  filePath: string;\\n    82\\t  sdk: Lhc;\\n    83\\t  double: ProviderDouble;\\n    84\\t  turnIds: string[]; // t1..t12\\n    85\\t  chunks: ChunkSnapshot;\\n    86\\t  // The two manufactured failed subjects (tool_result_summary forms), reached\\n    87\\t  // through real retry exhaustion / terminal failure — absent when failures\\n    88\\t  // are disabled for a variant.\\n    89\\t  failedTransientMessageId?: string;\\n    90\\t  failedPermanentMessageId?: string;\\n    91\\t  // The straggler variant's turnId-null messages: one between two turns, one\\n    92\\t  // after the last turn — absent unless stragglers are enabled.\\n    93\\t  stragglerBetweenMessageId?: string;\\n    94\\t  stragglerTrailingMessageId?: string;\\n    95\\t}\\n    96\\t\\n    97\\texport interface DerivedThreadOptions {\\n    98\\t  failures?: boolean; // default true: manufacture the two failed states\\n    99\\t  stragglers?: boolean; // default false: insert the turnless runtime notes\\n   100\\t}\\n   101\\t\\n   102\\tasync function send(\\n   103\\t  sdk: Lhc,\\n   104\\t  filePath: string,\\n   105\\t  batch: readonly MessageEventInput[],\\n   106\\t): Promise<string[]> {\\n   107\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n   108\\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n   109\\t  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n   110\\t}\\n   111\\t\\n   112\\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n   113\\t  const report = await sdk.work.drain({ filePath });\\n   114\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n   115\\t  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n   116\\t    throw new Error(\\n   117\\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n   118\\t    );\\n   119\\t  }\\n   120\\t}\\n   121\\t\\n   122\\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n   123\\t  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n   124\\t}\\n   125\\t\\n   126\\texport async function derivedThreadFixture(\\n   127\\t  store: TempStore,\\n   128\\t  opts: DerivedThreadOptions = {},\\n   129\\t): Promise<DerivedThreadFixture> {\\n   130\\t  const failures = opts.failures ?? true;\\n   131\\t  const stragglers = opts.stragglers ?? false;\\n   132\\t\\n   133\\t  const double = createProviderDouble();\\n   134\\t  const sdk = createSdk({\\n   135\\t    provider: double,\\n   136\\t    mode: \\\"manual\\\",\\n   137\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n   138\\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n   139\\t  });\\n   140\\t\\n   141\\t  const filePath = store.threadPath();\\n   142\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   143\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n   144\\t\\n   145\\t  const turnIds: string[] = [];\\n   146\\t  const fixture: DerivedThreadFixture = {\\n   147\\t    filePath,\\n   148\\t    sdk,\\n   149\\t    double,\\n   150\\t    turnIds,\\n   151\\t    chunks: { chunks: [], members: [] },\\n   152\\t  };\\n   153\\t\\n   154\\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n   155\\t    if (failures && turn === 6) {\\n   156\\t      // Retryable failures consumed to exhaustion by the head-first drain:\\n   157\\t      // the first tool_result_summary item of this batch takes all three\\n   158\\t      // attempts and lands failed with the transient reason class.\\n   159\\t      double.failKind(\\\"tool_result_summary\\\", 3, {\\n   160\\t        retryable: true,\\n   161\\t        reason: TRANSIENT_EXHAUST_REASON,\\n   162\\t      });\\n   163\\t    }\\n   164\\t    if (failures && turn === 7) {\\n   165\\t      // One non-retryable failure: terminal on the first attempt — the\\n   166\\t      // permanent reason class, attempts 1.\\n   167\\t      double.failKind(\\\"tool_result_summary\\\", 1, {\\n   168\\t        retryable: false,\\n   169\\t        reason: PERMANENT_FAILURE_REASON,\\n   170\\t      });\\n   171\\t    }\\n   172\\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n   173\\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n   174\\t    // result, call, result, text, end — index 3 is the first tool result,\\n   175\\t    // the scripted failures' subject.\\n   176\\t    const firstToolResultId = messageIds[3];\\n   177\\t    if (failures && (turn === 6 || turn === 7)) {\\n   178\\t      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n   179\\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n   180\\t      }\\n   181\\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n   182\\t      else fixture.failedPermanentMessageId = firstToolResultId;\\n   183\\t    }\\n   184\\t    await drain(sdk, filePath);\\n   185\\t\\n   186\\t    if (stragglers && turn === 3) {\\n   187\\t      // A runtime note between turn 3's end and turn 4's prompt: projected\\n   188\\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n   189\\t      const noteIds = await send(sdk, filePath, [\\n   190\\t        validEvent(\\\"runtime_note\\\", {\\n   191\\t          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n   192\\t        }),\\n   193\\t      ]);\\n   194\\t      const noteId = noteIds[0];\\n   195\\t      if (noteId === undefined || noteId === \\\"\\\") {\\n   196\\t        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n   197\\t      }\\n   198\\t      fixture.stragglerBetweenMessageId = noteId;\\n   199\\t    }\\n   200\\t    turnIds.push(`t${turn}`);\\n   201\\t  }\\n   202\\t\\n   203\\t  if (stragglers) {\\n   204\\t    const noteIds = await send(sdk, filePath, [\\n   205\\t      validEvent(\\\"runtime_note\\\", {\\n   206\\t        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n   207\\t      }),\\n   208\\t    ]);\\n   209\\t    const noteId = noteIds[0];\\n   210\\t    if (noteId === undefined || noteId === \\\"\\\") {\\n   211\\t      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n   212\\t    }\\n   213\\t    fixture.stragglerTrailingMessageId = noteId;\\n   214\\t    await drain(sdk, filePath);\\n   215\\t  }\\n   216\\t\\n   217\\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n   218\\t  // chunks, the first three closed. A failure here means the deterministic\\n   219\\t  // substrate moved (provider output or tokenizer), not a flaky test.\\n   220\\t  fixture.chunks = readChunks(filePath);\\n   221\\t  if (fixture.chunks.chunks.length !== 4) {\\n   222\\t    throw new Error(\\n   223\\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n   224\\t    );\\n   225\\t  }\\n   226\\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n   227\\t  if (closed !== 3) {\\n   228\\t    throw new Error(\\n   229\\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n   230\\t    );\\n   231\\t  }\\n   232\\t\\n   233\\t  if (failures) {\\n   234\\t    // Verify the manufactured states by read-back through the owning report\\n   235\\t    // surface before handing the fixture to any test (FC-0.3's enforcement\\n   236\\t    // lives in the tests; this guards the builder's own contract).\\n   237\\t    const report = await sdk.messages.report({ filePath });\\n   238\\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n   239\\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n   240\\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n   241\\t    if (\\n   242\\t      transient.length !== 1 ||\\n   243\\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n   244\\t      permanent.length !== 1 ||\\n   245\\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n   246\\t    ) {\\n   247\\t      throw new Error(\\n   248\\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n   249\\t      );\\n   250\\t    }\\n   251\\t  }\\n   252\\t\\n   253\\t  return fixture;\\n   254\\t}\\n   255\\t\\n   256\\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n   257\\t// conversation with a runtime note between two turns and one after the last\\n   258\\t// turn, fully drained, no manufactured failures.\\n   259\\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n   260\\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n   261\\t}\\n   262\\t\\n   263\\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n   264\\t// short real conversation, drained clean, then damaged below the SDK into\\n   265\\t// the two-open-turns state no public operation can produce. Canonical\\n   266\\t// consumers refuse it with state_corruption.\\n   267\\texport async function corruptedVariantThread(\\n   268\\t  store: TempStore,\\n   269\\t): Promise<{ filePath: string; sdk: Lhc }> {\\n   270\\t  const double = createProviderDouble();\\n   271\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n   272\\t  const filePath = store.threadPath();\\n   273\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   274\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n   275\\t  for (let turn = 1; turn <= 3; turn += 1) {\\n   276\\t    await send(sdk, filePath, turnEvents(turn));\\n   277\\t  }\\n   278\\t  await drain(sdk, filePath);\\n   279\\t  // Open a turn through real intake, then add a second open row: two open\\n   280\\t  // turns, the Epic 01 invariant violation.\\n   281\\t  await send(sdk, filePath, [\\n   282\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n   283\\t  ]);\\n   284\\t  corruptTwoOpenTurns(filePath);\\n   285\\t  return { filePath, sdk };\\n   286\\t}\\n   287\\t\\n   288\\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n   289\\t// queued derivation meets real source damage at drain time — the handler\\n   290\\t// finds two open turns and lands the turn forms blocked through the\\n   291\\t// production terminal path, never a hand-written row.\\n   292\\texport async function blockedSiblingThread(\\n   293\\t  store: TempStore,\\n   294\\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n   295\\t  const double = createProviderDouble();\\n   296\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n   297\\t  const filePath = store.threadPath();\\n   298\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   299\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n   300\\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n   301\\t  // real intake; the corruption writer adds another open row. The drain then\\n   302\\t  // claims t1's derivation against a record with two open turns.\\n   303\\t  await send(sdk, filePath, turnEvents(1));\\n   304\\t  await send(sdk, filePath, [\\n   305\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n   306\\t  ]);\\n   307\\t  corruptTwoOpenTurns(filePath);\\n   308\\t  const report = await sdk.work.drain({ filePath });\\n   309\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n   310\\t  const blocked = report.value.ran.find(\\n   311\\t    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n   312\\t  );\\n   313\\t  if (blocked === undefined) {\\n   314\\t    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n   315\\t  }\\n   316\\t  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n   317\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/05-render-targets/streams/003-implementor.stdout.log:425:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_011waf4wQzCU3hSKBNfMfDtJ\",\"type\":\"tool_result\",\"content\":\"1\\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n2\\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n3\\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n4\\t// deterministic provider double into known form states. States are reached\\n5\\t// through production paths, never hand-written rows (the anti-shim line\\n6\\t// FC-0.3 enforces): the failed states come from scripted provider failures\\n7\\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n8\\t// real source damage on a sacrificial sibling thread. Every later Epic 03\\n9\\t// story compacts against what this builder returns.\\n10\\timport {\\n11\\t  createSdk,\\n12\\t  type FormReportEntry,\\n13\\t  type Lhc,\\n14\\t  type MessageEventInput,\\n15\\t} from \\\"../../src/index.js\\\";\\n16\\timport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\n17\\timport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\n18\\timport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\n19\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n20\\t\\n21\\t// Reason classes the scripted failures stamp, chosen from the sweep\\n22\\t// classification table's vocabulary (tech design §Spec Validation): a\\n23\\t// rate-limit class reads transient, a content-refusal class reads permanent —\\n24\\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n25\\t// Story 3 depends on it.\\n26\\texport const TRANSIENT_EXHAUST_REASON =\\n27\\t  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\n28\\texport const PERMANENT_FAILURE_REASON =\\n29\\t  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n30\\t\\n31\\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n32\\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n33\\t// deterministic double are near-constant in size (`projection(<digest>:<40\\n34\\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n35\\t// if drift ever moves it.\\n36\\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n37\\t\\n38\\tconst TURN_COUNT = 12;\\n39\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n40\\t\\n41\\tfunction turnEvents(turn: number): MessageEventInput[] {\\n42\\t  const events: MessageEventInput[] = [\\n43\\t    validEvent(\\\"user_prompt\\\", {\\n44\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n45\\t    }),\\n46\\t    validEvent(\\\"assistant_thinking\\\", {\\n47\\t      payload: { text: `considering what area ${turn} contains` },\\n48\\t    }),\\n49\\t  ];\\n50\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n51\\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n52\\t    // realistic over-max zone of tool results to age behind the boundary.\\n53\\t    for (const run of [1, 2]) {\\n54\\t      const toolCallId = `call-fx-${turn}-${run}`;\\n55\\t      events.push(\\n56\\t        validEvent(\\\"tool_call\\\", {\\n57\\t          payload: {\\n58\\t            toolCallId,\\n59\\t            toolName: \\\"read_file\\\",\\n60\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\n61\\t          },\\n62\\t        }),\\n63\\t        validEvent(\\\"tool_result\\\", {\\n64\\t          payload: {\\n65\\t            toolCallId,\\n66\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n67\\t            isError: false,\\n68\\t          },\\n69\\t        }),\\n70\\t      );\\n71\\t    }\\n72\\t  }\\n73\\t  events.push(\\n74\\t    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n75\\t    validEvent(\\\"turn_end\\\"),\\n76\\t  );\\n77\\t  return events;\\n78\\t}\\n79\\t\\n80\\texport interface DerivedThreadFixture {\\n81\\t  filePath: string;\\n82\\t  sdk: Lhc;\\n83\\t  double: ProviderDouble;\\n84\\t  turnIds: string[]; // t1..t12\\n85\\t  chunks: ChunkSnapshot;\\n86\\t  // The two manufactured failed subjects (tool_result_summary forms), reached\\n87\\t  // through real retry exhaustion / terminal failure — absent when failures\\n88\\t  // are disabled for a variant.\\n89\\t  failedTransientMessageId?: string;\\n90\\t  failedPermanentMessageId?: string;\\n91\\t  // The straggler variant's turnId-null messages: one between two turns, one\\n92\\t  // after the last turn — absent unless stragglers are enabled.\\n93\\t  stragglerBetweenMessageId?: string;\\n94\\t  stragglerTrailingMessageId?: string;\\n95\\t}\\n96\\t\\n97\\texport interface DerivedThreadOptions {\\n98\\t  failures?: boolean; // default true: manufacture the two failed states\\n99\\t  stragglers?: boolean; // default false: insert the turnless runtime notes\\n100\\t}\\n101\\t\\n102\\tasync function send(\\n103\\t  sdk: Lhc,\\n104\\t  filePath: string,\\n105\\t  batch: readonly MessageEventInput[],\\n106\\t): Promise<string[]> {\\n107\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n108\\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n109\\t  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n110\\t}\\n111\\t\\n112\\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n113\\t  const report = await sdk.work.drain({ filePath });\\n114\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n115\\t  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n116\\t    throw new Error(\\n117\\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n118\\t    );\\n119\\t  }\\n120\\t}\\n121\\t\\n122\\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n123\\t  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n124\\t}\\n125\\t\\n126\\texport async function derivedThreadFixture(\\n127\\t  store: TempStore,\\n128\\t  opts: DerivedThreadOptions = {},\\n129\\t): Promise<DerivedThreadFixture> {\\n130\\t  const failures = opts.failures ?? true;\\n131\\t  const stragglers = opts.stragglers ?? false;\\n132\\t\\n133\\t  const double = createProviderDouble();\\n134\\t  const sdk = createSdk({\\n135\\t    provider: double,\\n136\\t    mode: \\\"manual\\\",\\n137\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n138\\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n139\\t  });\\n140\\t\\n141\\t  const filePath = store.threadPath();\\n142\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n143\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n144\\t\\n145\\t  const turnIds: string[] = [];\\n146\\t  const fixture: DerivedThreadFixture = {\\n147\\t    filePath,\\n148\\t    sdk,\\n149\\t    double,\\n150\\t    turnIds,\\n151\\t    chunks: { chunks: [], members: [] },\\n152\\t  };\\n153\\t\\n154\\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n155\\t    if (failures && turn === 6) {\\n156\\t      // Retryable failures consumed to exhaustion by the head-first drain:\\n157\\t      // the first tool_result_summary item of this batch takes all three\\n158\\t      // attempts and lands failed with the transient reason class.\\n159\\t      double.failKind(\\\"tool_result_summary\\\", 3, {\\n160\\t        retryable: true,\\n161\\t        reason: TRANSIENT_EXHAUST_REASON,\\n162\\t      });\\n163\\t    }\\n164\\t    if (failures && turn === 7) {\\n165\\t      // One non-retryable failure: terminal on the first attempt — the\\n166\\t      // permanent reason class, attempts 1.\\n167\\t      double.failKind(\\\"tool_result_summary\\\", 1, {\\n168\\t        retryable: false,\\n169\\t        reason: PERMANENT_FAILURE_REASON,\\n170\\t      });\\n171\\t    }\\n172\\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n173\\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n174\\t    // result, call, result, text, end — index 3 is the first tool result,\\n175\\t    // the scripted failures' subject.\\n176\\t    const firstToolResultId = messageIds[3];\\n177\\t    if (failures && (turn === 6 || turn === 7)) {\\n178\\t      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n179\\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n180\\t      }\\n181\\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n182\\t      else fixture.failedPermanentMessageId = firstToolResultId;\\n183\\t    }\\n184\\t    await drain(sdk, filePath);\\n185\\t\\n186\\t    if (stragglers && turn === 3) {\\n187\\t      // A runtime note between turn 3's end and turn 4's prompt: projected\\n188\\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n189\\t      const noteIds = await send(sdk, filePath, [\\n190\\t        validEvent(\\\"runtime_note\\\", {\\n191\\t          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n192\\t        }),\\n193\\t      ]);\\n194\\t      const noteId = noteIds[0];\\n195\\t      if (noteId === undefined || noteId === \\\"\\\") {\\n196\\t        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n197\\t      }\\n198\\t      fixture.stragglerBetweenMessageId = noteId;\\n199\\t    }\\n200\\t    turnIds.push(`t${turn}`);\\n201\\t  }\\n202\\t\\n203\\t  if (stragglers) {\\n204\\t    const noteIds = await send(sdk, filePath, [\\n205\\t      validEvent(\\\"runtime_note\\\", {\\n206\\t        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n207\\t      }),\\n208\\t    ]);\\n209\\t    const noteId = noteIds[0];\\n210\\t    if (noteId === undefined || noteId === \\\"\\\") {\\n211\\t      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n212\\t    }\\n213\\t    fixture.stragglerTrailingMessageId = noteId;\\n214\\t    await drain(sdk, filePath);\\n215\\t  }\\n216\\t\\n217\\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n218\\t  // chunks, the first three closed. A failure here means the deterministic\\n219\\t  // substrate moved (provider output or tokenizer), not a flaky test.\\n220\\t  fixture.chunks = readChunks(filePath);\\n221\\t  if (fixture.chunks.chunks.length !== 4) {\\n222\\t    throw new Error(\\n223\\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n224\\t    );\\n225\\t  }\\n226\\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n227\\t  if (closed !== 3) {\\n228\\t    throw new Error(\\n229\\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n230\\t    );\\n231\\t  }\\n232\\t\\n233\\t  if (failures) {\\n234\\t    // Verify the manufactured states by read-back through the owning report\\n235\\t    // surface before handing the fixture to any test (FC-0.3's enforcement\\n236\\t    // lives in the tests; this guards the builder's own contract).\\n237\\t    const report = await sdk.messages.report({ filePath });\\n238\\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n239\\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n240\\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n241\\t    if (\\n242\\t      transient.length !== 1 ||\\n243\\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n244\\t      permanent.length !== 1 ||\\n245\\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n246\\t    ) {\\n247\\t      throw new Error(\\n248\\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n249\\t      );\\n250\\t    }\\n251\\t  }\\n252\\t\\n253\\t  return fixture;\\n254\\t}\\n255\\t\\n256\\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n257\\t// conversation with a runtime note between two turns and one after the last\\n258\\t// turn, fully drained, no manufactured failures.\\n259\\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n260\\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n261\\t}\\n262\\t\\n263\\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n264\\t// short real conversation, drained clean, then damaged below the SDK into\\n265\\t// the two-open-turns state no public operation can produce. Canonical\\n266\\t// consumers refuse it with state_corruption.\\n267\\texport async function corruptedVariantThread(\\n268\\t  store: TempStore,\\n269\\t): Promise<{ filePath: string; sdk: Lhc }> {\\n270\\t  const double = createProviderDouble();\\n271\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n272\\t  const filePath = store.threadPath();\\n273\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n274\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n275\\t  for (let turn = 1; turn <= 3; turn += 1) {\\n276\\t    await send(sdk, filePath, turnEvents(turn));\\n277\\t  }\\n278\\t  await drain(sdk, filePath);\\n279\\t  // Open a turn through real intake, then add a second open row: two open\\n280\\t  // turns, the Epic 01 invariant violation.\\n281\\t  await send(sdk, filePath, [\\n282\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n283\\t  ]);\\n284\\t  corruptTwoOpenTurns(filePath);\\n285\\t  return { filePath, sdk };\\n286\\t}\\n287\\t\\n288\\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n289\\t// queued derivation meets real source damage at drain time — the handler\\n290\\t// finds two open turns and lands the turn forms blocked through the\\n291\\t// production terminal path, never a hand-written row.\\n292\\texport async function blockedSiblingThread(\\n293\\t  store: TempStore,\\n294\\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n295\\t  const double = createProviderDouble();\\n296\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n297\\t  const filePath = store.threadPath();\\n298\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n299\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n300\\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n301\\t  // real intake; the corruption writer adds another open row. The drain then\\n302\\t  // claims t1's derivation against a record with two open turns.\\n303\\t  await send(sdk, filePath, turnEvents(1));\\n304\\t  await send(sdk, filePath, [\\n305\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n306\\t  ]);\\n307\\t  corruptTwoOpenTurns(filePath);\\n308\\t  const report = await sdk.work.drain({ filePath });\\n309\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n310\\t  const blocked = report.value.ran.find(\\n311\\t    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n312\\t  );\\n313\\t  if (blocked === undefined) {\\n314\\t    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n315\\t  }\\n316\\t  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n317\\t}\\n318\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"d96b6140-abf0-4148-ae10-52f37fa752e0\",\"uuid\":\"0e90ee47-f198-4c3d-95bd-2a79ec54597e\",\"timestamp\":\"2026-06-11T17:53:23.643Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-thread.ts\",\"content\":\"// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n// deterministic provider double into known form states. States are reached\\n// through production paths, never hand-written rows (the anti-shim line\\n// FC-0.3 enforces): the failed states come from scripted provider failures\\n// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n// real source damage on a sacrificial sibling thread. Every later Epic 03\\n// story compacts against what this builder returns.\\nimport {\\n  createSdk,\\n  type FormReportEntry,\\n  type Lhc,\\n  type MessageEventInput,\\n} from \\\"../../src/index.js\\\";\\nimport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\nimport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\nimport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\n// Reason classes the scripted failures stamp, chosen from the sweep\\n// classification table's vocabulary (tech design §Spec Validation): a\\n// rate-limit class reads transient, a content-refusal class reads permanent —\\n// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n// Story 3 depends on it.\\nexport const TRANSIENT_EXHAUST_REASON =\\n  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\nexport const PERMANENT_FAILURE_REASON =\\n  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n\\n// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n// deterministic double are near-constant in size (`projection(<digest>:<40\\n// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n// if drift ever moves it.\\nconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n\\nconst TURN_COUNT = 12;\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n\\nfunction turnEvents(turn: number): MessageEventInput[] {\\n  const events: MessageEventInput[] = [\\n    validEvent(\\\"user_prompt\\\", {\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n    }),\\n    validEvent(\\\"assistant_thinking\\\", {\\n      payload: { text: `considering what area ${turn} contains` },\\n    }),\\n  ];\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n    // realistic over-max zone of tool results to age behind the boundary.\\n    for (const run of [1, 2]) {\\n      const toolCallId = `call-fx-${turn}-${run}`;\\n      events.push(\\n        validEvent(\\\"tool_call\\\", {\\n          payload: {\\n            toolCallId,\\n            toolName: \\\"read_file\\\",\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\n          },\\n        }),\\n        validEvent(\\\"tool_result\\\", {\\n          payload: {\\n            toolCallId,\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n            isError: false,\\n          },\\n        }),\\n      );\\n    }\\n  }\\n  events.push(\\n    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n    validEvent(\\\"turn_end\\\"),\\n  );\\n  return events;\\n}\\n\\nexport interface DerivedThreadFixture {\\n  filePath: string;\\n  sdk: Lhc;\\n  double: ProviderDouble;\\n  turnIds: string[]; // t1..t12\\n  chunks: ChunkSnapshot;\\n  // The two manufactured failed subjects (tool_result_summary forms), reached\\n  // through real retry exhaustion / terminal failure — absent when failures\\n  // are disabled for a variant.\\n  failedTransientMessageId?: string;\\n  failedPermanentMessageId?: string;\\n  // The straggler variant's turnId-null messages: one between two turns, one\\n  // after the last turn — absent unless stragglers are enabled.\\n  stragglerBetweenMessageId?: string;\\n  stragglerTrailingMessageId?: string;\\n}\\n\\nexport interface DerivedThreadOptions {\\n  failures?: boolean; // default true: manufacture the two failed states\\n  stragglers?: boolean; // default false: insert the turnless runtime notes\\n}\\n\\nasync function send(\\n  sdk: Lhc,\\n  filePath: string,\\n  batch: readonly MessageEventInput[],\\n): Promise<string[]> {\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n}\\n\\nasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n  const report = await sdk.work.drain({ filePath });\\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n    throw new Error(\\n      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n    );\\n  }\\n}\\n\\nfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n}\\n\\nexport async function derivedThreadFixture(\\n  store: TempStore,\\n  opts: DerivedThreadOptions = {},\\n): Promise<DerivedThreadFixture> {\\n  const failures = opts.failures ?? true;\\n  const stragglers = opts.stragglers ?? false;\\n\\n  const double = createProviderDouble();\\n  const sdk = createSdk({\\n    provider: double,\\n    mode: \\\"manual\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n  });\\n\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n\\n  const turnIds: string[] = [];\\n  const fixture: DerivedThreadFixture = {\\n    filePath,\\n    sdk,\\n    double,\\n    turnIds,\\n    chunks: { chunks: [], members: [] },\\n  };\\n\\n  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n    if (failures && turn === 6) {\\n      // Retryable failures consumed to exhaustion by the head-first drain:\\n      // the first tool_result_summary item of this batch takes all three\\n      // attempts and lands failed with the transient reason class.\\n      double.failKind(\\\"tool_result_summary\\\", 3, {\\n        retryable: true,\\n        reason: TRANSIENT_EXHAUST_REASON,\\n      });\\n    }\\n    if (failures && turn === 7) {\\n      // One non-retryable failure: terminal on the first attempt — the\\n      // permanent reason class, attempts 1.\\n      double.failKind(\\\"tool_result_summary\\\", 1, {\\n        retryable: false,\\n        reason: PERMANENT_FAILURE_REASON,\\n      });\\n    }\\n    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n    // result, call, result, text, end — index 3 is the first tool result,\\n    // the scripted failures' subject.\\n    const firstToolResultId = messageIds[3];\\n    if (failures && (turn === 6 || turn === 7)) {\\n      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n      }\\n      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n      else fixture.failedPermanentMessageId = firstToolResultId;\\n    }\\n    await drain(sdk, filePath);\\n\\n    if (stragglers && turn === 3) {\\n      // A runtime note between turn 3's end and turn 4's prompt: projected\\n      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n      const noteIds = await send(sdk, filePath, [\\n        validEvent(\\\"runtime_note\\\", {\\n          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n        }),\\n      ]);\\n      const noteId = noteIds[0];\\n      if (noteId === undefined || noteId === \\\"\\\") {\\n        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n      }\\n      fixture.stragglerBetweenMessageId = noteId;\\n    }\\n    turnIds.push(`t${turn}`);\\n  }\\n\\n  if (stragglers) {\\n    const noteIds = await send(sdk, filePath, [\\n      validEvent(\\\"runtime_note\\\", {\\n        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n      }),\\n    ]);\\n    const noteId = noteIds[0];\\n    if (noteId === undefined || noteId === \\\"\\\") {\\n      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n    }\\n    fixture.stragglerTrailingMessageId = noteId;\\n    await drain(sdk, filePath);\\n  }\\n\\n  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n  // chunks, the first three closed. A failure here means the deterministic\\n  // substrate moved (provider output or tokenizer), not a flaky test.\\n  fixture.chunks = readChunks(filePath);\\n  if (fixture.chunks.chunks.length !== 4) {\\n    throw new Error(\\n      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n    );\\n  }\\n  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n  if (closed !== 3) {\\n    throw new Error(\\n      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n    );\\n  }\\n\\n  if (failures) {\\n    // Verify the manufactured states by read-back through the owning report\\n    // surface before handing the fixture to any test (FC-0.3's enforcement\\n    // lives in the tests; this guards the builder's own contract).\\n    const report = await sdk.messages.report({ filePath });\\n    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n    if (\\n      transient.length !== 1 ||\\n      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n      permanent.length !== 1 ||\\n      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n    ) {\\n      throw new Error(\\n        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n      );\\n    }\\n  }\\n\\n  return fixture;\\n}\\n\\n// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n// conversation with a runtime note between two turns and one after the last\\n// turn, fully drained, no manufactured failures.\\nexport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n}\\n\\n// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n// short real conversation, drained clean, then damaged below the SDK into\\n// the two-open-turns state no public operation can produce. Canonical\\n// consumers refuse it with state_corruption.\\nexport async function corruptedVariantThread(\\n  store: TempStore,\\n): Promise<{ filePath: string; sdk: Lhc }> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  for (let turn = 1; turn <= 3; turn += 1) {\\n    await send(sdk, filePath, turnEvents(turn));\\n  }\\n  await drain(sdk, filePath);\\n  // Open a turn through real intake, then add a second open row: two open\\n  // turns, the Epic 01 invariant violation.\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n  ]);\\n  corruptTwoOpenTurns(filePath);\\n  return { filePath, sdk };\\n}\\n\\n// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n// queued derivation meets real source damage at drain time — the handler\\n// finds two open turns and lands the turn forms blocked through the\\n// production terminal path, never a hand-written row.\\nexport async function blockedSiblingThread(\\n  store: TempStore,\\n): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n  // real intake; the corruption writer adds another open row. The drain then\\n  // claims t1's derivation against a record with two open turns.\\n  await send(sdk, filePath, turnEvents(1));\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n  ]);\\n  corruptTwoOpenTurns(filePath);\\n  const report = await sdk.work.drain({ filePath });\\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n  const blocked = report.value.ran.find(\\n    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n  );\\n  if (blocked === undefined) {\\n    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n  }\\n  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n}\\n\",\"numLines\":318,\"startLine\":1,\"totalLines\":318}}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/05-render-targets/streams/003-implementor.stdout.log:452:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01D4hTrJHHvY6QPkMyJJg8fe\",\"type\":\"tool_result\",\"content\":\"1\\t// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\\n2\\t// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\\n3\\t// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \\\"same\\n4\\t// receipt shape\\\" is proven by both targets passing the same checker, not by\\n5\\t// two hand-kept assertion lists drifting apart.\\n6\\timport type { SweepReceipt } from \\\"../../src/index.js\\\";\\n7\\t\\n8\\tfunction fail(path: string, expected: string, actual: unknown): never {\\n9\\t  throw new Error(\\n10\\t    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\\n11\\t  );\\n12\\t}\\n13\\t\\n14\\tfunction assertCount(value: unknown, path: string): void {\\n15\\t  if (typeof value !== \\\"number\\\" || !Number.isInteger(value) || value < 0) {\\n16\\t    fail(path, \\\"a non-negative integer\\\", value);\\n17\\t  }\\n18\\t}\\n19\\t\\n20\\tfunction assertSubjectReasonList(value: unknown, path: string): void {\\n21\\t  if (!Array.isArray(value)) fail(path, \\\"an array\\\", value);\\n22\\t  value.forEach((item, i) => {\\n23\\t    if (typeof item !== \\\"object\\\" || item === null) fail(`${path}[${i}]`, \\\"an object\\\", item);\\n24\\t    const entry = item as Record<string, unknown>;\\n25\\t    if (typeof entry.subjectId !== \\\"string\\\" || entry.subjectId === \\\"\\\") {\\n26\\t      fail(`${path}[${i}].subjectId`, \\\"a non-empty string\\\", entry.subjectId);\\n27\\t    }\\n28\\t    if (typeof entry.reason !== \\\"string\\\" || entry.reason === \\\"\\\") {\\n29\\t      fail(`${path}[${i}].reason`, \\\"a non-empty string\\\", entry.reason);\\n30\\t    }\\n31\\t  });\\n32\\t}\\n33\\t\\n34\\texport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\\n35\\t  if (typeof value !== \\\"object\\\" || value === null) fail(\\\"receipt\\\", \\\"an object\\\", value);\\n36\\t  const receipt = value as Record<string, unknown>;\\n37\\t  if (!Array.isArray(receipt.owners)) fail(\\\"receipt.owners\\\", \\\"an array\\\", receipt.owners);\\n38\\t  receipt.owners.forEach((line, i) => {\\n39\\t    const path = `owners[${i}]`;\\n40\\t    if (typeof line !== \\\"object\\\" || line === null) fail(path, \\\"an object\\\", line);\\n41\\t    const entry = line as Record<string, unknown>;\\n42\\t    if (entry.owner !== \\\"messages\\\" && entry.owner !== \\\"turns\\\") {\\n43\\t      fail(`${path}.owner`, '\\\"messages\\\" | \\\"turns\\\"', entry.owner);\\n44\\t    }\\n45\\t    if (typeof entry.kind !== \\\"string\\\" || entry.kind === \\\"\\\") {\\n46\\t      fail(`${path}.kind`, \\\"a non-empty string\\\", entry.kind);\\n47\\t    }\\n48\\t    assertCount(entry.ready, `${path}.ready`);\\n49\\t    assertCount(entry.inFlight, `${path}.inFlight`);\\n50\\t    if (\\n51\\t      !Array.isArray(entry.requeued) ||\\n52\\t      entry.requeued.some((id) => typeof id !== \\\"string\\\" || id === \\\"\\\")\\n53\\t    ) {\\n54\\t      fail(`${path}.requeued`, \\\"an array of non-empty subject-id strings\\\", entry.requeued);\\n55\\t    }\\n56\\t    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\\n57\\t    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\\n58\\t  });\\n59\\t}\\n60\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"d96b6140-abf0-4148-ae10-52f37fa752e0\",\"uuid\":\"d686c1e0-18c2-43ab-b0c2-fcdf8d35a6fc\",\"timestamp\":\"2026-06-11T17:53:30.976Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/receipt-schema.ts\",\"content\":\"// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\\n// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\\n// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \\\"same\\n// receipt shape\\\" is proven by both targets passing the same checker, not by\\n// two hand-kept assertion lists drifting apart.\\nimport type { SweepReceipt } from \\\"../../src/index.js\\\";\\n\\nfunction fail(path: string, expected: string, actual: unknown): never {\\n  throw new Error(\\n    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\\n  );\\n}\\n\\nfunction assertCount(value: unknown, path: string): void {\\n  if (typeof value !== \\\"number\\\" || !Number.isInteger(value) || value < 0) {\\n    fail(path, \\\"a non-negative integer\\\", value);\\n  }\\n}\\n\\nfunction assertSubjectReasonList(value: unknown, path: string): void {\\n  if (!Array.isArray(value)) fail(path, \\\"an array\\\", value);\\n  value.forEach((item, i) => {\\n    if (typeof item !== \\\"object\\\" || item === null) fail(`${path}[${i}]`, \\\"an object\\\", item);\\n    const entry = item as Record<string, unknown>;\\n    if (typeof entry.subjectId !== \\\"string\\\" || entry.subjectId === \\\"\\\") {\\n      fail(`${path}[${i}].subjectId`, \\\"a non-empty string\\\", entry.subjectId);\\n    }\\n    if (typeof entry.reason !== \\\"string\\\" || entry.reason === \\\"\\\") {\\n      fail(`${path}[${i}].reason`, \\\"a non-empty string\\\", entry.reason);\\n    }\\n  });\\n}\\n\\nexport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\\n  if (typeof value !== \\\"object\\\" || value === null) fail(\\\"receipt\\\", \\\"an object\\\", value);\\n  const receipt = value as Record<string, unknown>;\\n  if (!Array.isArray(receipt.owners)) fail(\\\"receipt.owners\\\", \\\"an array\\\", receipt.owners);\\n  receipt.owners.forEach((line, i) => {\\n    const path = `owners[${i}]`;\\n    if (typeof line !== \\\"object\\\" || line === null) fail(path, \\\"an object\\\", line);\\n    const entry = line as Record<string, unknown>;\\n    if (entry.owner !== \\\"messages\\\" && entry.owner !== \\\"turns\\\") {\\n      fail(`${path}.owner`, '\\\"messages\\\" | \\\"turns\\\"', entry.owner);\\n    }\\n    if (typeof entry.kind !== \\\"string\\\" || entry.kind === \\\"\\\") {\\n      fail(`${path}.kind`, \\\"a non-empty string\\\", entry.kind);\\n    }\\n    assertCount(entry.ready, `${path}.ready`);\\n    assertCount(entry.inFlight, `${path}.inFlight`);\\n    if (\\n      !Array.isArray(entry.requeued) ||\\n      entry.requeued.some((id) => typeof id !== \\\"string\\\" || id === \\\"\\\")\\n    ) {\\n      fail(`${path}.requeued`, \\\"an array of non-empty subject-id strings\\\", entry.requeued);\\n    }\\n    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\\n    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\\n  });\\n}\\n\",\"numLines\":60,\"startLine\":1,\"totalLines\":60}}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/05-render-targets/streams/003-implementor.stdout.log:2008:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017kVL7aXSxEHZM8NJLa4JwD\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-sweep.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"d96b6140-abf0-4148-ae10-52f37fa752e0\",\"uuid\":\"b69d8ecc-efd4-498e-b58d-e9c8427ea664\",\"timestamp\":\"2026-06-11T18:05:53.492Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-sweep.test.ts\",\"oldString\":\"    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\\n    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\\n    expect(captured.length).toBe(before);\",\"newString\":\"    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\\n    // Epic 03 Story 5 (sanctioned amendment): materialize is real now — it\\n    // succeeds, and like the other four it still calls no provider.\\n    expect(materialized.ok).toBe(true);\\n    expect(captured.length).toBe(before);\",\"originalFile\":\"// Epic 03 Story 3: the readiness sweep (TC-3.1–3.4, the classification-edge\\n// architecture-risk legs, and the suite-wide zero-provider assertion's\\n// completion across all five thread-view ops). Every TC goes through the\\n// real SDK surface (createSdk().threadView.sweep / .compact) against real\\n// temp thread files; the provider double appears only in fixture setup and\\n// in TC-3.4's sanctioned heal drain — no Epic 03 operation may touch it.\\n// Failed and blocked states are reached through production paths (scripted\\n// provider failures consumed by real retry/exhaustion mechanics, real source\\n// damage on the sacrificial sibling), never by writing derived_form rows.\\nimport { afterAll, beforeAll, describe, expect, it } from \\\"vitest\\\";\\nimport { createSdk, type Lhc, type SweepReceipt } from \\\"../src/index.js\\\";\\nimport {\\n  assertSweepReceiptShape,\\n  blockedSiblingThread,\\n  classifyFailureReason,\\n  createProviderDouble,\\n  derivedThreadFixture,\\n  openRaw,\\n  PERMANENT_FAILURE_REASON,\\n  REASON_CLASS_TABLE,\\n  seedViewBoundary,\\n  tempStore,\\n  validEvent,\\n  type DerivedThreadFixture,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\ntype OwnerLine = SweepReceipt[\\\"owners\\\"][number];\\n\\nfunction ownerLine(\\n  receipt: SweepReceipt,\\n  owner: OwnerLine[\\\"owner\\\"],\\n  kind: string,\\n): OwnerLine {\\n  const line = receipt.owners.find((entry) => entry.owner === owner && entry.kind === kind);\\n  if (line === undefined) throw new Error(`no receipt line for ${owner}/${kind}`);\\n  return line;\\n}\\n\\n// Work rows for one subject's rebuild, counted by key below the SDK\\n// (TC-3.2's \\\"exactly one work row exists for it\\\"). The requeue patch keeps\\n// the queue live-work-only, so any row here is queued or claimed work.\\nfunction workRowsFor(filePath: string, kind: string, subjectId: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db\\n      .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE kind = ? AND source_ref LIKE ?`)\\n      .get(kind, `%\\\"${subjectId}\\\"%`) as { n: number | bigint };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction workItemCount(filePath: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\\n      n: number | bigint;\\n    };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nasync function reportEntry(\\n  sdk: Lhc,\\n  filePath: string,\\n  messageId: string,\\n  form: string,\\n): Promise<{ state: string; reason?: string; queueStatus?: string; content?: string }> {\\n  const report = await sdk.messages.report({ filePath }, { messageId });\\n  if (!report.ok) throw new Error(`report failed: ${report.error.reason}`);\\n  const entry = report.value.find((row) => row.form === form);\\n  if (entry === undefined) throw new Error(`no ${form} entry for ${messageId}`);\\n  return {\\n    state: entry.state,\\n    ...(entry.reason === undefined ? {} : { reason: entry.reason }),\\n    ...(entry.queue === undefined ? {} : { queueStatus: entry.queue.status }),\\n    ...(entry.content === undefined ? {} : { content: entry.content }),\\n  };\\n}\\n\\ndescribe(\\\"TC-3.1–TC-3.3 (AC-3.1–3.5, 3.7): the standalone sweep over the seeded states\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n  let firstReceipt: SweepReceipt;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n    // The pending leg of the seed: one more closed turn, NOT drained (manual\\n    // mode never drains uninvoked), so its smoothed_prompt and turn forms sit\\n    // pending with live queue rows when the sweep walks the reports.\\n    const sent = await fixture.sdk.intakeStream.messageEvents({ filePath: fixture.filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"extra pending turn for the sweep seed\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"left undrained on purpose\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    if (!sent.ok) throw new Error(`extra-turn intake failed: ${sent.error.reason}`);\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"TC-3.1: buckets the five seeded states, requeues only the transient failure, returns without waiting, zero provider calls\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(0);\\n\\n    const startedAt = Date.now();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const elapsedMs = Date.now() - startedAt;\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    firstReceipt = swept.value;\\n\\n    // No waiting (AC-3.2): the sweep is report reads plus row writes; any\\n    // drain or poll inside it would blow this bound (anti-shim tripwire).\\n    expect(elapsedMs).toBeLessThan(1000);\\n\\n    // The tool_result_summary line carries the story's whole failed×classify\\n    // contract: 6 of the fixture's 8 results drained ready, the scripted\\n    // transient exhaustion requeued, the scripted permanent failure reported\\n    // with its reason and left alone (AC-3.3, AC-3.5).\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(6);\\n    expect(results.requeued).toEqual([transientId]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n    expect(results.blocked).toEqual([]);\\n\\n    // Pending forms are left alone and reported as in-flight: the undrained\\n    // extra turn's prompt smoothing (messages) and turn derivation (turns).\\n    const prompts = ownerLine(swept.value, \\\"messages\\\", \\\"smoothed_prompt\\\");\\n    expect(prompts.ready).toBe(12);\\n    expect(prompts.inFlight).toBe(1);\\n    expect(prompts.requeued).toEqual([]);\\n    const renderings = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    expect(renderings.ready).toBe(12);\\n    expect(renderings.inFlight).toBe(1);\\n    expect(renderings.requeued).toEqual([]);\\n\\n    // The transient requeue really landed through the owner: one work row by\\n    // key, form cleared to pending with its queue row visible (AC-3.1's\\n    // owners-only write path read back through the owner's report).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"pending\\\");\\n    expect(transient.queueStatus).toBe(\\\"queued\\\");\\n\\n    // The permanent failure is untouched: still failed, no work row.\\n    const permanent = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      permanentId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(permanent.state).toBe(\\\"failed\\\");\\n    expect(permanent.reason).toBe(PERMANENT_FAILURE_REASON);\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", permanentId)).toBe(0);\\n\\n    // Nothing requeued anywhere else, and the sweep itself called no\\n    // provider (AC-3.1: no derivation, no model calls).\\n    const allRequeued = swept.value.owners.flatMap((line) => line.requeued);\\n    expect(allRequeued).toEqual([transientId]);\\n    expect(captured.length).toBe(0);\\n  });\\n\\n  it(\\\"TC-3.2 (AC-3.4): a second sweep without draining reports the requeued form in-flight and writes no second row\\\", async () => {\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const results = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.requeued).toEqual([]);\\n    expect(results.inFlight).toBe(1);\\n    expect(results.ready).toBe(6);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // Exactly one work row exists for the requeued form (count by key).\\n    expect(workRowsFor(fixture.filePath, \\\"tool_result_summary\\\", transientId)).toBe(1);\\n  });\\n\\n  it(\\\"TC-3.3 schema leg (AC-3.5, AC-3.7): the SDK receipt validates against the shared receipt schema\\\", async () => {\\n    // The same checker Story 5's spawned CLI leg asserts against — \\\"same\\n    // receipt shape\\\" is one validator passing both targets, not two\\n    // hand-kept assertion lists.\\n    expect(() => assertSweepReceiptShape(firstReceipt)).not.toThrow();\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n    expect(() => assertSweepReceiptShape(swept.value)).not.toThrow();\\n    // Counts and reasons match the seeds across invocations: the receipt is\\n    // an accounting of durable state, not of sweep-local bookkeeping.\\n    expect(ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\").permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n  });\\n\\n  it(\\\"zero-provider assertion across all five ops (architecture-risk): pull, status, compact, sweep, materialize\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    const before = captured.length;\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    const status = await fixture.sdk.threadView.status({ filePath: fixture.filePath });\\n    const compacted = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 } } },\\n    );\\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\\n    const materialized = await fixture.sdk.threadView.materialize(\\n      { filePath: fixture.filePath },\\n      { path: `${fixture.filePath}.out.jsonl` },\\n    );\\n\\n    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\\n    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\\n    expect(captured.length).toBe(before);\\n  });\\n});\\n\\ndescribe(\\\"classification edges (architecture-risk): blocked, in-walk dedupe, unclassified\\\", () => {\\n  let store: TempStore;\\n\\n  beforeAll(() => {\\n    store = tempStore();\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"blocked forms are reported with their stored reasons and never requeued\\\", async () => {\\n    const sibling = await blockedSiblingThread(store);\\n    const rowsBefore = workItemCount(sibling.filePath);\\n\\n    const swept = await sibling.sdk.threadView.sweep({ filePath: sibling.filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // The damaged turn landed both turn forms blocked through the production\\n    // terminal path; the sweep reports each with its reason and asks the\\n    // owners for nothing.\\n    for (const kind of [\\\"turn_rendering\\\", \\\"lower_band_projection\\\"]) {\\n      const line = ownerLine(swept.value, \\\"turns\\\", kind);\\n      expect(line.blocked).toHaveLength(1);\\n      expect(line.blocked[0]?.subjectId).toBe(sibling.blockedTurnId);\\n      expect(line.blocked[0]?.reason).not.toBe(\\\"\\\");\\n      expect(line.requeued).toEqual([]);\\n    }\\n    expect(swept.value.owners.flatMap((line) => line.requeued)).toEqual([]);\\n    expect(workItemCount(sibling.filePath)).toBe(rowsBefore);\\n  });\\n\\n  it(\\\"once-per-invocation dedupe is structural: a turn's two transiently-failed forms share one work row, the second ask noops to in-flight\\\", async () => {\\n    // Both turn forms exhaust together through real retry mechanics (one\\n    // turn_derivation item rebuilds both), so the sweep's walk meets two\\n    // failed transient entries that share one queue site — the owner's\\n    // already_queued noop is what keeps the second ask from double-queuing,\\n    // and this test is what notices if Epic 02's requeue ever stops nooping.\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    double.failKind(\\\"turn_rendering\\\", 3, {\\n      retryable: true,\\n      reason: \\\"timeout: scripted turn exhaustion (test)\\\",\\n    });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"a turn whose derivation exhausts\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"an answer\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(0);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    // One requeue, one noop-counted-as-in-flight, exactly one work row.\\n    const rendering = ownerLine(swept.value, \\\"turns\\\", \\\"turn_rendering\\\");\\n    const projection = ownerLine(swept.value, \\\"turns\\\", \\\"lower_band_projection\\\");\\n    const requeued = [...rendering.requeued, ...projection.requeued];\\n    expect(requeued).toEqual([\\\"t1\\\"]);\\n    expect(rendering.inFlight + projection.inFlight).toBe(1);\\n    expect(workRowsFor(filePath, \\\"turn_derivation\\\", \\\"t1\\\")).toBe(1);\\n  });\\n\\n  it(\\\"an unclassified reason code lands in permanentFailed with its literal reason and is never requeued\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = createSdk({\\n      provider: double,\\n      mode: \\\"manual\\\",\\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    expect(created.ok).toBe(true);\\n\\n    // A terminal failure whose reason class the table has never heard of —\\n    // persisted through the production write path, classified conservative.\\n    const unclassifiedReason = \\\"mystery_code: gremlins in the pipeline\\\";\\n    double.failKind(\\\"tool_result_summary\\\", 1, { retryable: false, reason: unclassifiedReason });\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"run the tool\\\" } }),\\n      validEvent(\\\"tool_call\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"u.txt\\\" } },\\n      }),\\n      validEvent(\\\"tool_result\\\", {\\n        payload: { toolCallId: \\\"call-uc-1\\\", content: \\\"unclassified-path output\\\", isError: false },\\n      }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    expect(sent.ok).toBe(true);\\n    const messageIds = sent.ok ? sent.value.events.map((entry) => entry.messageId ?? \\\"\\\") : [];\\n    const resultId = messageIds[2] ?? \\\"\\\";\\n    expect(resultId).not.toBe(\\\"\\\");\\n    const drained = await sdk.work.drain({ filePath });\\n    expect(drained.ok).toBe(true);\\n\\n    const rowsBefore = workItemCount(filePath);\\n    const swept = await sdk.threadView.sweep({ filePath });\\n    expect(swept.ok).toBe(true);\\n    if (!swept.ok) return;\\n\\n    const line = ownerLine(swept.value, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(line.permanentFailed).toEqual([{ subjectId: resultId, reason: unclassifiedReason }]);\\n    expect(line.requeued).toEqual([]);\\n    expect(workItemCount(filePath)).toBe(rowsBefore);\\n    const entry = await reportEntry(sdk, filePath, resultId, \\\"tool_result_summary\\\");\\n    expect(entry.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"the classification table is data: named classes map as designed, everything else is permanent\\\", () => {\\n    expect(REASON_CLASS_TABLE).toEqual({\\n      rate_limit: \\\"transient\\\",\\n      timeout: \\\"transient\\\",\\n      provider_unavailable: \\\"transient\\\",\\n      content_refusal: \\\"permanent\\\",\\n      validation: \\\"permanent\\\",\\n      unknown_work_kind: \\\"permanent\\\",\\n    });\\n    expect(classifyFailureReason(\\\"rate_limit: provider said slow down\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"timeout: no response in 30s\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"provider_unavailable: 503\\\")).toBe(\\\"transient\\\");\\n    expect(classifyFailureReason(\\\"content_refusal: declined\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"validation: bad output shape\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"unknown_work_kind: nonesuch\\\")).toBe(\\\"permanent\\\");\\n    // The conservative default: unknown codes, codeless prose, and missing\\n    // reasons all classify permanent — never a requeue on a guess.\\n    expect(classifyFailureReason(\\\"mystery_code: gremlins\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"free prose with no class code\\\")).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(undefined)).toBe(\\\"permanent\\\");\\n    expect(classifyFailureReason(\\\"\\\")).toBe(\\\"permanent\\\");\\n  });\\n});\\n\\ndescribe(\\\"TC-3.4 (AC-3.6, AC-2.7): the compact-embedded sweep, the skip, and the heal\\\", () => {\\n  let store: TempStore;\\n  let fixture: DerivedThreadFixture;\\n  let transientId: string;\\n  let permanentId: string;\\n\\n  beforeAll(async () => {\\n    store = tempStore();\\n    fixture = await derivedThreadFixture(store);\\n    transientId = fixture.failedTransientMessageId ?? \\\"\\\";\\n    permanentId = fixture.failedPermanentMessageId ?? \\\"\\\";\\n    if (transientId === \\\"\\\" || permanentId === \\\"\\\") {\\n      throw new Error(\\\"fixture did not record the manufactured failed subjects\\\");\\n    }\\n  });\\n  afterAll(() => {\\n    store.cleanup();\\n  });\\n\\n  it(\\\"compact with sweep: false records the skip and requeues nothing\\\", async () => {\\n    const rowsBefore = workItemCount(fixture.filePath);\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\", sweep: false },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    expect(receipt.value.sweep).toEqual({ skipped: true });\\n\\n    // Zero requeues occurred: no work row landed, the transient failure is\\n    // still failed.\\n    expect(workItemCount(fixture.filePath)).toBe(rowsBefore);\\n    const transient = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(transient.state).toBe(\\\"failed\\\");\\n  });\\n\\n  it(\\\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\\\", async () => {\\n    // Default compact through a BACKGROUND SDK: the sweep runs first and its\\n    // full receipt embeds (Story 2's \\\"absent\\\" placeholder is gone from the\\n    // vocabulary), and the embedded requeue's poke-on-commit lands on the\\n    // background scheduler — the production repair path needs no drain call.\\n    const bg = createSdk({ provider: createProviderDouble(), mode: \\\"background\\\" });\\n    const receipt = await bg.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    const embedded = receipt.value.sweep;\\n    expect(embedded).not.toEqual({ skipped: true });\\n    if (!(\\\"owners\\\" in embedded)) return;\\n    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\\n    expect(ownerLine(embedded, \\\"messages\\\", \\\"tool_result_summary\\\").requeued).toEqual([\\n      transientId,\\n    ]);\\n\\n    // The heal leg — the one sanctioned test-setup use of inference\\n    // machinery: drainSettled awaits the poked background drain over the\\n    // requeued row. No Epic 03 operation below touches the provider.\\n    await bg.drainSettled({ filePath: fixture.filePath });\\n\\n    const healed = await reportEntry(\\n      fixture.sdk,\\n      fixture.filePath,\\n      transientId,\\n      \\\"tool_result_summary\\\",\\n    );\\n    expect(healed.state).toBe(\\\"ready\\\");\\n    expect(healed.content).toBeDefined();\\n\\n    // The next default compact sees the heal: its embedded sweep reports the\\n    // form ready (7 now), nothing to requeue, only the permanent failure\\n    // still on the books.\\n    const next = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(next.ok).toBe(true);\\n    if (!next.ok) return;\\n    const nextSweep = next.value.sweep;\\n    if (!(\\\"owners\\\" in nextSweep)) return;\\n    const results = ownerLine(nextSweep, \\\"messages\\\", \\\"tool_result_summary\\\");\\n    expect(results.ready).toBe(7);\\n    expect(results.requeued).toEqual([]);\\n    expect(results.permanentFailed).toEqual([\\n      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\\n    ]);\\n\\n    // And the healed form feeds the served view: with the coding bound this\\n    // small thread is all tail (compact point 0), so seed the boundary at the\\n    // healed result's position — the short form now renders the READY\\n    // summary, the ladder's first rung, not the truncation fallback.\\n    expect(next.value.compactPoint).toBe(0);\\n    const listed = await fixture.sdk.messages.listMessages({ filePath: fixture.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    const healedMessage = listed.value.find((m) => m.messageId === transientId);\\n    expect(healedMessage).toBeDefined();\\n    if (healedMessage === undefined) return;\\n    seedViewBoundary(fixture.filePath, healedMessage.sourceEventOrder);\\n\\n    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(pulled.ok).toBe(true);\\n    if (!pulled.ok) return;\\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n      `[tool result · read_file · abridged]\\\\n${healed.content} [full content in record §${transientId}]`,\\n    );\\n  });\\n});\\n\",\"structuredPatch\":[{\"oldStart\":230,\"oldLines\":7,\"newStart\":230,\"newLines\":9,\"lines\":[\"     );\",\" \",\"     expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\",\"-    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\",\"+    // Epic 03 Story 5 (sanctioned amendment): materialize is real now — it\",\"+    // succeeds, and like the other four it still calls no provider.\",\"+    expect(materialized.ok).toBe(true);\",\"     expect(captured.length).toBe(before);\",\"   });\",\" });\"]}],\"userModified\":false,\"replaceAll\":false}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/004-verify.stdout.log:50:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_24\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/fixtures/view-thread.ts | sed -n '1,320p'\\\"\",\"aggregated_output\":\"     1\\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n     2\\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n     3\\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n     4\\t// deterministic provider double into known form states. States are reached\\n     5\\t// through production paths, never hand-written rows (the anti-shim line\\n     6\\t// FC-0.3 enforces): the failed states come from scripted provider failures\\n     7\\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n     8\\t// real source damage on a sacrificial sibling thread. Every later Epic 03\\n     9\\t// story compacts against what this builder returns.\\n    10\\timport {\\n    11\\t  createSdk,\\n    12\\t  type FormReportEntry,\\n    13\\t  type Lhc,\\n    14\\t  type MessageEventInput,\\n    15\\t} from \\\"../../src/index.js\\\";\\n    16\\timport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\n    17\\timport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\n    18\\timport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\n    19\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n    20\\t\\n    21\\t// Reason classes the scripted failures stamp, chosen from the sweep\\n    22\\t// classification table's vocabulary (tech design §Spec Validation): a\\n    23\\t// rate-limit class reads transient, a content-refusal class reads permanent —\\n    24\\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n    25\\t// Story 3 depends on it.\\n    26\\texport const TRANSIENT_EXHAUST_REASON =\\n    27\\t  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\n    28\\texport const PERMANENT_FAILURE_REASON =\\n    29\\t  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n    30\\t\\n    31\\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n    32\\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n    33\\t// deterministic double are near-constant in size (`projection(<digest>:<40\\n    34\\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n    35\\t// if drift ever moves it.\\n    36\\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n    37\\t\\n    38\\tconst TURN_COUNT = 12;\\n    39\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n    40\\t\\n    41\\tfunction turnEvents(turn: number): MessageEventInput[] {\\n    42\\t  const events: MessageEventInput[] = [\\n    43\\t    validEvent(\\\"user_prompt\\\", {\\n    44\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n    45\\t    }),\\n    46\\t    validEvent(\\\"assistant_thinking\\\", {\\n    47\\t      payload: { text: `considering what area ${turn} contains` },\\n    48\\t    }),\\n    49\\t  ];\\n    50\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    51\\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n    52\\t    // realistic over-max zone of tool results to age behind the boundary.\\n    53\\t    for (const run of [1, 2]) {\\n    54\\t      const toolCallId = `call-fx-${turn}-${run}`;\\n    55\\t      events.push(\\n    56\\t        validEvent(\\\"tool_call\\\", {\\n    57\\t          payload: {\\n    58\\t            toolCallId,\\n    59\\t            toolName: \\\"read_file\\\",\\n    60\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\n    61\\t          },\\n    62\\t        }),\\n    63\\t        validEvent(\\\"tool_result\\\", {\\n    64\\t          payload: {\\n    65\\t            toolCallId,\\n    66\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n    67\\t            isError: false,\\n    68\\t          },\\n    69\\t        }),\\n    70\\t      );\\n    71\\t    }\\n    72\\t  }\\n    73\\t  events.push(\\n    74\\t    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n    75\\t    validEvent(\\\"turn_end\\\"),\\n    76\\t  );\\n    77\\t  return events;\\n    78\\t}\\n    79\\t\\n    80\\texport interface DerivedThreadFixture {\\n    81\\t  filePath: string;\\n    82\\t  sdk: Lhc;\\n    83\\t  double: ProviderDouble;\\n    84\\t  turnIds: string[]; // t1..t12\\n    85\\t  chunks: ChunkSnapshot;\\n    86\\t  // The two manufactured failed subjects (tool_result_summary forms), reached\\n    87\\t  // through real retry exhaustion / terminal failure — absent when failures\\n    88\\t  // are disabled for a variant.\\n    89\\t  failedTransientMessageId?: string;\\n    90\\t  failedPermanentMessageId?: string;\\n    91\\t  // The straggler variant's turnId-null messages: one between two turns, one\\n    92\\t  // after the last turn — absent unless stragglers are enabled.\\n    93\\t  stragglerBetweenMessageId?: string;\\n    94\\t  stragglerTrailingMessageId?: string;\\n    95\\t}\\n    96\\t\\n    97\\texport interface DerivedThreadOptions {\\n    98\\t  failures?: boolean; // default true: manufacture the two failed states\\n    99\\t  stragglers?: boolean; // default false: insert the turnless runtime notes\\n   100\\t}\\n   101\\t\\n   102\\tasync function send(\\n   103\\t  sdk: Lhc,\\n   104\\t  filePath: string,\\n   105\\t  batch: readonly MessageEventInput[],\\n   106\\t): Promise<string[]> {\\n   107\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n   108\\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n   109\\t  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n   110\\t}\\n   111\\t\\n   112\\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n   113\\t  const report = await sdk.work.drain({ filePath });\\n   114\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n   115\\t  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n   116\\t    throw new Error(\\n   117\\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n   118\\t    );\\n   119\\t  }\\n   120\\t}\\n   121\\t\\n   122\\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n   123\\t  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n   124\\t}\\n   125\\t\\n   126\\texport async function derivedThreadFixture(\\n   127\\t  store: TempStore,\\n   128\\t  opts: DerivedThreadOptions = {},\\n   129\\t): Promise<DerivedThreadFixture> {\\n   130\\t  const failures = opts.failures ?? true;\\n   131\\t  const stragglers = opts.stragglers ?? false;\\n   132\\t\\n   133\\t  const double = createProviderDouble();\\n   134\\t  const sdk = createSdk({\\n   135\\t    provider: double,\\n   136\\t    mode: \\\"manual\\\",\\n   137\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n   138\\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n   139\\t  });\\n   140\\t\\n   141\\t  const filePath = store.threadPath();\\n   142\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   143\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n   144\\t\\n   145\\t  const turnIds: string[] = [];\\n   146\\t  const fixture: DerivedThreadFixture = {\\n   147\\t    filePath,\\n   148\\t    sdk,\\n   149\\t    double,\\n   150\\t    turnIds,\\n   151\\t    chunks: { chunks: [], members: [] },\\n   152\\t  };\\n   153\\t\\n   154\\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n   155\\t    if (failures && turn === 6) {\\n   156\\t      // Retryable failures consumed to exhaustion by the head-first drain:\\n   157\\t      // the first tool_result_summary item of this batch takes all three\\n   158\\t      // attempts and lands failed with the transient reason class.\\n   159\\t      double.failKind(\\\"tool_result_summary\\\", 3, {\\n   160\\t        retryable: true,\\n   161\\t        reason: TRANSIENT_EXHAUST_REASON,\\n   162\\t      });\\n   163\\t    }\\n   164\\t    if (failures && turn === 7) {\\n   165\\t      // One non-retryable failure: terminal on the first attempt — the\\n   166\\t      // permanent reason class, attempts 1.\\n   167\\t      double.failKind(\\\"tool_result_summary\\\", 1, {\\n   168\\t        retryable: false,\\n   169\\t        reason: PERMANENT_FAILURE_REASON,\\n   170\\t      });\\n   171\\t    }\\n   172\\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n   173\\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n   174\\t    // result, call, result, text, end — index 3 is the first tool result,\\n   175\\t    // the scripted failures' subject.\\n   176\\t    const firstToolResultId = messageIds[3];\\n   177\\t    if (failures && (turn === 6 || turn === 7)) {\\n   178\\t      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n   179\\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n   180\\t      }\\n   181\\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n   182\\t      else fixture.failedPermanentMessageId = firstToolResultId;\\n   183\\t    }\\n   184\\t    await drain(sdk, filePath);\\n   185\\t\\n   186\\t    if (stragglers && turn === 3) {\\n   187\\t      // A runtime note between turn 3's end and turn 4's prompt: projected\\n   188\\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n   189\\t      const noteIds = await send(sdk, filePath, [\\n   190\\t        validEvent(\\\"runtime_note\\\", {\\n   191\\t          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n   192\\t        }),\\n   193\\t      ]);\\n   194\\t      const noteId = noteIds[0];\\n   195\\t      if (noteId === undefined || noteId === \\\"\\\") {\\n   196\\t        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n   197\\t      }\\n   198\\t      fixture.stragglerBetweenMessageId = noteId;\\n   199\\t    }\\n   200\\t    turnIds.push(`t${turn}`);\\n   201\\t  }\\n   202\\t\\n   203\\t  if (stragglers) {\\n   204\\t    const noteIds = await send(sdk, filePath, [\\n   205\\t      validEvent(\\\"runtime_note\\\", {\\n   206\\t        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n   207\\t      }),\\n   208\\t    ]);\\n   209\\t    const noteId = noteIds[0];\\n   210\\t    if (noteId === undefined || noteId === \\\"\\\") {\\n   211\\t      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n   212\\t    }\\n   213\\t    fixture.stragglerTrailingMessageId = noteId;\\n   214\\t    await drain(sdk, filePath);\\n   215\\t  }\\n   216\\t\\n   217\\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n   218\\t  // chunks, the first three closed. A failure here means the deterministic\\n   219\\t  // substrate moved (provider output or tokenizer), not a flaky test.\\n   220\\t  fixture.chunks = readChunks(filePath);\\n   221\\t  if (fixture.chunks.chunks.length !== 4) {\\n   222\\t    throw new Error(\\n   223\\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n   224\\t    );\\n   225\\t  }\\n   226\\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n   227\\t  if (closed !== 3) {\\n   228\\t    throw new Error(\\n   229\\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n   230\\t    );\\n   231\\t  }\\n   232\\t\\n   233\\t  if (failures) {\\n   234\\t    // Verify the manufactured states by read-back through the owning report\\n   235\\t    // surface before handing the fixture to any test (FC-0.3's enforcement\\n   236\\t    // lives in the tests; this guards the builder's own contract).\\n   237\\t    const report = await sdk.messages.report({ filePath });\\n   238\\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n   239\\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n   240\\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n   241\\t    if (\\n   242\\t      transient.length !== 1 ||\\n   243\\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n   244\\t      permanent.length !== 1 ||\\n   245\\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n   246\\t    ) {\\n   247\\t      throw new Error(\\n   248\\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n   249\\t      );\\n   250\\t    }\\n   251\\t  }\\n   252\\t\\n   253\\t  return fixture;\\n   254\\t}\\n   255\\t\\n   256\\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n   257\\t// conversation with a runtime note between two turns and one after the last\\n   258\\t// turn, fully drained, no manufactured failures.\\n   259\\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n   260\\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n   261\\t}\\n   262\\t\\n   263\\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n   264\\t// short real conversation, drained clean, then damaged below the SDK into\\n   265\\t// the two-open-turns state no public operation can produce. Canonical\\n   266\\t// consumers refuse it with state_corruption.\\n   267\\texport async function corruptedVariantThread(\\n   268\\t  store: TempStore,\\n   269\\t): Promise<{ filePath: string; sdk: Lhc }> {\\n   270\\t  const double = createProviderDouble();\\n   271\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n   272\\t  const filePath = store.threadPath();\\n   273\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   274\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n   275\\t  for (let turn = 1; turn <= 3; turn += 1) {\\n   276\\t    await send(sdk, filePath, turnEvents(turn));\\n   277\\t  }\\n   278\\t  await drain(sdk, filePath);\\n   279\\t  // Open a turn through real intake, then add a second open row: two open\\n   280\\t  // turns, the Epic 01 invariant violation.\\n   281\\t  await send(sdk, filePath, [\\n   282\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n   283\\t  ]);\\n   284\\t  corruptTwoOpenTurns(filePath);\\n   285\\t  return { filePath, sdk };\\n   286\\t}\\n   287\\t\\n   288\\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n   289\\t// queued derivation meets real source damage at drain time — the handler\\n   290\\t// finds two open turns and lands the turn forms blocked through the\\n   291\\t// production terminal path, never a hand-written row.\\n   292\\texport async function blockedSiblingThread(\\n   293\\t  store: TempStore,\\n   294\\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n   295\\t  const double = createProviderDouble();\\n   296\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n   297\\t  const filePath = store.threadPath();\\n   298\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   299\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n   300\\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n   301\\t  // real intake; the corruption writer adds another open row. The drain then\\n   302\\t  // claims t1's derivation against a record with two open turns.\\n   303\\t  await send(sdk, filePath, turnEvents(1));\\n   304\\t  await send(sdk, filePath, [\\n   305\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n   306\\t  ]);\\n   307\\t  corruptTwoOpenTurns(filePath);\\n   308\\t  const report = await sdk.work.drain({ filePath });\\n   309\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n   310\\t  const blocked = report.value.ran.find(\\n   311\\t    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n   312\\t  );\\n   313\\t  if (blocked === undefined) {\\n   314\\t    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n   315\\t  }\\n   316\\t  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n   317\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/04-tool-result-visibility/streams/003-implementor.stdout.log:212:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01TEiXQFJjQLEFm8sphK7SX1\",\"type\":\"tool_result\",\"content\":\"1\\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n2\\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n3\\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n4\\t// deterministic provider double into known form states. States are reached\\n5\\t// through production paths, never hand-written rows (the anti-shim line\\n6\\t// FC-0.3 enforces): the failed states come from scripted provider failures\\n7\\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n8\\t// real source damage on a sacrificial sibling thread. Every later Epic 03\\n9\\t// story compacts against what this builder returns.\\n10\\timport {\\n11\\t  createSdk,\\n12\\t  type FormReportEntry,\\n13\\t  type Lhc,\\n14\\t  type MessageEventInput,\\n15\\t} from \\\"../../src/index.js\\\";\\n16\\timport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\n17\\timport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\n18\\timport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\n19\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n20\\t\\n21\\t// Reason classes the scripted failures stamp, chosen from the sweep\\n22\\t// classification table's vocabulary (tech design §Spec Validation): a\\n23\\t// rate-limit class reads transient, a content-refusal class reads permanent —\\n24\\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n25\\t// Story 3 depends on it.\\n26\\texport const TRANSIENT_EXHAUST_REASON =\\n27\\t  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\n28\\texport const PERMANENT_FAILURE_REASON =\\n29\\t  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n30\\t\\n31\\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n32\\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n33\\t// deterministic double are near-constant in size (`projection(<digest>:<40\\n34\\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n35\\t// if drift ever moves it.\\n36\\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n37\\t\\n38\\tconst TURN_COUNT = 12;\\n39\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n40\\t\\n41\\tfunction turnEvents(turn: number): MessageEventInput[] {\\n42\\t  const events: MessageEventInput[] = [\\n43\\t    validEvent(\\\"user_prompt\\\", {\\n44\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n45\\t    }),\\n46\\t    validEvent(\\\"assistant_thinking\\\", {\\n47\\t      payload: { text: `considering what area ${turn} contains` },\\n48\\t    }),\\n49\\t  ];\\n50\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n51\\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n52\\t    // realistic over-max zone of tool results to age behind the boundary.\\n53\\t    for (const run of [1, 2]) {\\n54\\t      const toolCallId = `call-fx-${turn}-${run}`;\\n55\\t      events.push(\\n56\\t        validEvent(\\\"tool_call\\\", {\\n57\\t          payload: {\\n58\\t            toolCallId,\\n59\\t            toolName: \\\"read_file\\\",\\n60\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\n61\\t          },\\n62\\t        }),\\n63\\t        validEvent(\\\"tool_result\\\", {\\n64\\t          payload: {\\n65\\t            toolCallId,\\n66\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n67\\t            isError: false,\\n68\\t          },\\n69\\t        }),\\n70\\t      );\\n71\\t    }\\n72\\t  }\\n73\\t  events.push(\\n74\\t    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n75\\t    validEvent(\\\"turn_end\\\"),\\n76\\t  );\\n77\\t  return events;\\n78\\t}\\n79\\t\\n80\\texport interface DerivedThreadFixture {\\n81\\t  filePath: string;\\n82\\t  sdk: Lhc;\\n83\\t  double: ProviderDouble;\\n84\\t  turnIds: string[]; // t1..t12\\n85\\t  chunks: ChunkSnapshot;\\n86\\t  // The two manufactured failed subjects (tool_result_summary forms), reached\\n87\\t  // through real retry exhaustion / terminal failure — absent when failures\\n88\\t  // are disabled for a variant.\\n89\\t  failedTransientMessageId?: string;\\n90\\t  failedPermanentMessageId?: string;\\n91\\t  // The straggler variant's turnId-null messages: one between two turns, one\\n92\\t  // after the last turn — absent unless stragglers are enabled.\\n93\\t  stragglerBetweenMessageId?: string;\\n94\\t  stragglerTrailingMessageId?: string;\\n95\\t}\\n96\\t\\n97\\texport interface DerivedThreadOptions {\\n98\\t  failures?: boolean; // default true: manufacture the two failed states\\n99\\t  stragglers?: boolean; // default false: insert the turnless runtime notes\\n100\\t}\\n101\\t\\n102\\tasync function send(\\n103\\t  sdk: Lhc,\\n104\\t  filePath: string,\\n105\\t  batch: readonly MessageEventInput[],\\n106\\t): Promise<string[]> {\\n107\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n108\\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n109\\t  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n110\\t}\\n111\\t\\n112\\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n113\\t  const report = await sdk.work.drain({ filePath });\\n114\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n115\\t  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n116\\t    throw new Error(\\n117\\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n118\\t    );\\n119\\t  }\\n120\\t}\\n121\\t\\n122\\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n123\\t  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n124\\t}\\n125\\t\\n126\\texport async function derivedThreadFixture(\\n127\\t  store: TempStore,\\n128\\t  opts: DerivedThreadOptions = {},\\n129\\t): Promise<DerivedThreadFixture> {\\n130\\t  const failures = opts.failures ?? true;\\n131\\t  const stragglers = opts.stragglers ?? false;\\n132\\t\\n133\\t  const double = createProviderDouble();\\n134\\t  const sdk = createSdk({\\n135\\t    provider: double,\\n136\\t    mode: \\\"manual\\\",\\n137\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n138\\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n139\\t  });\\n140\\t\\n141\\t  const filePath = store.threadPath();\\n142\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n143\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n144\\t\\n145\\t  const turnIds: string[] = [];\\n146\\t  const fixture: DerivedThreadFixture = {\\n147\\t    filePath,\\n148\\t    sdk,\\n149\\t    double,\\n150\\t    turnIds,\\n151\\t    chunks: { chunks: [], members: [] },\\n152\\t  };\\n153\\t\\n154\\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n155\\t    if (failures && turn === 6) {\\n156\\t      // Retryable failures consumed to exhaustion by the head-first drain:\\n157\\t      // the first tool_result_summary item of this batch takes all three\\n158\\t      // attempts and lands failed with the transient reason class.\\n159\\t      double.failKind(\\\"tool_result_summary\\\", 3, {\\n160\\t        retryable: true,\\n161\\t        reason: TRANSIENT_EXHAUST_REASON,\\n162\\t      });\\n163\\t    }\\n164\\t    if (failures && turn === 7) {\\n165\\t      // One non-retryable failure: terminal on the first attempt — the\\n166\\t      // permanent reason class, attempts 1.\\n167\\t      double.failKind(\\\"tool_result_summary\\\", 1, {\\n168\\t        retryable: false,\\n169\\t        reason: PERMANENT_FAILURE_REASON,\\n170\\t      });\\n171\\t    }\\n172\\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n173\\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n174\\t    // result, call, result, text, end — index 3 is the first tool result,\\n175\\t    // the scripted failures' subject.\\n176\\t    const firstToolResultId = messageIds[3];\\n177\\t    if (failures && (turn === 6 || turn === 7)) {\\n178\\t      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n179\\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n180\\t      }\\n181\\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n182\\t      else fixture.failedPermanentMessageId = firstToolResultId;\\n183\\t    }\\n184\\t    await drain(sdk, filePath);\\n185\\t\\n186\\t    if (stragglers && turn === 3) {\\n187\\t      // A runtime note between turn 3's end and turn 4's prompt: projected\\n188\\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n189\\t      const noteIds = await send(sdk, filePath, [\\n190\\t        validEvent(\\\"runtime_note\\\", {\\n191\\t          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n192\\t        }),\\n193\\t      ]);\\n194\\t      const noteId = noteIds[0];\\n195\\t      if (noteId === undefined || noteId === \\\"\\\") {\\n196\\t        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n197\\t      }\\n198\\t      fixture.stragglerBetweenMessageId = noteId;\\n199\\t    }\\n200\\t    turnIds.push(`t${turn}`);\\n201\\t  }\\n202\\t\\n203\\t  if (stragglers) {\\n204\\t    const noteIds = await send(sdk, filePath, [\\n205\\t      validEvent(\\\"runtime_note\\\", {\\n206\\t        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n207\\t      }),\\n208\\t    ]);\\n209\\t    const noteId = noteIds[0];\\n210\\t    if (noteId === undefined || noteId === \\\"\\\") {\\n211\\t      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n212\\t    }\\n213\\t    fixture.stragglerTrailingMessageId = noteId;\\n214\\t    await drain(sdk, filePath);\\n215\\t  }\\n216\\t\\n217\\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n218\\t  // chunks, the first three closed. A failure here means the deterministic\\n219\\t  // substrate moved (provider output or tokenizer), not a flaky test.\\n220\\t  fixture.chunks = readChunks(filePath);\\n221\\t  if (fixture.chunks.chunks.length !== 4) {\\n222\\t    throw new Error(\\n223\\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n224\\t    );\\n225\\t  }\\n226\\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n227\\t  if (closed !== 3) {\\n228\\t    throw new Error(\\n229\\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n230\\t    );\\n231\\t  }\\n232\\t\\n233\\t  if (failures) {\\n234\\t    // Verify the manufactured states by read-back through the owning report\\n235\\t    // surface before handing the fixture to any test (FC-0.3's enforcement\\n236\\t    // lives in the tests; this guards the builder's own contract).\\n237\\t    const report = await sdk.messages.report({ filePath });\\n238\\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n239\\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n240\\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n241\\t    if (\\n242\\t      transient.length !== 1 ||\\n243\\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n244\\t      permanent.length !== 1 ||\\n245\\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n246\\t    ) {\\n247\\t      throw new Error(\\n248\\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n249\\t      );\\n250\\t    }\\n251\\t  }\\n252\\t\\n253\\t  return fixture;\\n254\\t}\\n255\\t\\n256\\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n257\\t// conversation with a runtime note between two turns and one after the last\\n258\\t// turn, fully drained, no manufactured failures.\\n259\\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n260\\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n261\\t}\\n262\\t\\n263\\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n264\\t// short real conversation, drained clean, then damaged below the SDK into\\n265\\t// the two-open-turns state no public operation can produce. Canonical\\n266\\t// consumers refuse it with state_corruption.\\n267\\texport async function corruptedVariantThread(\\n268\\t  store: TempStore,\\n269\\t): Promise<{ filePath: string; sdk: Lhc }> {\\n270\\t  const double = createProviderDouble();\\n271\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n272\\t  const filePath = store.threadPath();\\n273\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n274\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n275\\t  for (let turn = 1; turn <= 3; turn += 1) {\\n276\\t    await send(sdk, filePath, turnEvents(turn));\\n277\\t  }\\n278\\t  await drain(sdk, filePath);\\n279\\t  // Open a turn through real intake, then add a second open row: two open\\n280\\t  // turns, the Epic 01 invariant violation.\\n281\\t  await send(sdk, filePath, [\\n282\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n283\\t  ]);\\n284\\t  corruptTwoOpenTurns(filePath);\\n285\\t  return { filePath, sdk };\\n286\\t}\\n287\\t\\n288\\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n289\\t// queued derivation meets real source damage at drain time — the handler\\n290\\t// finds two open turns and lands the turn forms blocked through the\\n291\\t// production terminal path, never a hand-written row.\\n292\\texport async function blockedSiblingThread(\\n293\\t  store: TempStore,\\n294\\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n295\\t  const double = createProviderDouble();\\n296\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n297\\t  const filePath = store.threadPath();\\n298\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n299\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n300\\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n301\\t  // real intake; the corruption writer adds another open row. The drain then\\n302\\t  // claims t1's derivation against a record with two open turns.\\n303\\t  await send(sdk, filePath, turnEvents(1));\\n304\\t  await send(sdk, filePath, [\\n305\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n306\\t  ]);\\n307\\t  corruptTwoOpenTurns(filePath);\\n308\\t  const report = await sdk.work.drain({ filePath });\\n309\\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n310\\t  const blocked = report.value.ran.find(\\n311\\t    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n312\\t  );\\n313\\t  if (blocked === undefined) {\\n314\\t    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n315\\t  }\\n316\\t  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n317\\t}\\n318\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763\",\"uuid\":\"22ab6bf2-2628-4a15-ae41-e52266a778ac\",\"timestamp\":\"2026-06-11T17:29:45.670Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-thread.ts\",\"content\":\"// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n// deterministic provider double into known form states. States are reached\\n// through production paths, never hand-written rows (the anti-shim line\\n// FC-0.3 enforces): the failed states come from scripted provider failures\\n// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n// real source damage on a sacrificial sibling thread. Every later Epic 03\\n// story compacts against what this builder returns.\\nimport {\\n  createSdk,\\n  type FormReportEntry,\\n  type Lhc,\\n  type MessageEventInput,\\n} from \\\"../../src/index.js\\\";\\nimport { corruptTwoOpenTurns } from \\\"./corrupt.js\\\";\\nimport { createProviderDouble, type ProviderDouble } from \\\"./provider-double.js\\\";\\nimport { readChunks, type ChunkSnapshot } from \\\"./threads.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\n// Reason classes the scripted failures stamp, chosen from the sweep\\n// classification table's vocabulary (tech design §Spec Validation): a\\n// rate-limit class reads transient, a content-refusal class reads permanent —\\n// FC-0.4's distinguishable-on-read-back guarantee, proven here before\\n// Story 3 depends on it.\\nexport const TRANSIENT_EXHAUST_REASON =\\n  \\\"rate_limit: scripted transient exhaustion (fixture)\\\";\\nexport const PERMANENT_FAILURE_REASON =\\n  \\\"content_refusal: scripted permanent failure (fixture)\\\";\\n\\n// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\\n// (3 members each; c1–c3 closed, c4 still open). Projections from the\\n// deterministic double are near-constant in size (`projection(<digest>:<40\\n// chars>)`), so the cut is stable; the builder asserts the shape and throws\\n// if drift ever moves it.\\nconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\\n\\nconst TURN_COUNT = 12;\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n\\nfunction turnEvents(turn: number): MessageEventInput[] {\\n  const events: MessageEventInput[] = [\\n    validEvent(\\\"user_prompt\\\", {\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n    }),\\n    validEvent(\\\"assistant_thinking\\\", {\\n      payload: { text: `considering what area ${turn} contains` },\\n    }),\\n  ];\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\\n    // realistic over-max zone of tool results to age behind the boundary.\\n    for (const run of [1, 2]) {\\n      const toolCallId = `call-fx-${turn}-${run}`;\\n      events.push(\\n        validEvent(\\\"tool_call\\\", {\\n          payload: {\\n            toolCallId,\\n            toolName: \\\"read_file\\\",\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\n          },\\n        }),\\n        validEvent(\\\"tool_result\\\", {\\n          payload: {\\n            toolCallId,\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n            isError: false,\\n          },\\n        }),\\n      );\\n    }\\n  }\\n  events.push(\\n    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n    validEvent(\\\"turn_end\\\"),\\n  );\\n  return events;\\n}\\n\\nexport interface DerivedThreadFixture {\\n  filePath: string;\\n  sdk: Lhc;\\n  double: ProviderDouble;\\n  turnIds: string[]; // t1..t12\\n  chunks: ChunkSnapshot;\\n  // The two manufactured failed subjects (tool_result_summary forms), reached\\n  // through real retry exhaustion / terminal failure — absent when failures\\n  // are disabled for a variant.\\n  failedTransientMessageId?: string;\\n  failedPermanentMessageId?: string;\\n  // The straggler variant's turnId-null messages: one between two turns, one\\n  // after the last turn — absent unless stragglers are enabled.\\n  stragglerBetweenMessageId?: string;\\n  stragglerTrailingMessageId?: string;\\n}\\n\\nexport interface DerivedThreadOptions {\\n  failures?: boolean; // default true: manufacture the two failed states\\n  stragglers?: boolean; // default false: insert the turnless runtime notes\\n}\\n\\nasync function send(\\n  sdk: Lhc,\\n  filePath: string,\\n  batch: readonly MessageEventInput[],\\n): Promise<string[]> {\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n  return result.value.events.map((entry) => entry.messageId ?? \\\"\\\");\\n}\\n\\nasync function drain(sdk: Lhc, filePath: string): Promise<void> {\\n  const report = await sdk.work.drain({ filePath });\\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n  if (report.value.stoppedBecause !== \\\"empty\\\" || report.value.remaining !== 0) {\\n    throw new Error(\\n      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\\n    );\\n  }\\n}\\n\\nfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\\n  return entries.filter((entry) => entry.state === \\\"failed\\\" && entry.reason === reason);\\n}\\n\\nexport async function derivedThreadFixture(\\n  store: TempStore,\\n  opts: DerivedThreadOptions = {},\\n): Promise<DerivedThreadFixture> {\\n  const failures = opts.failures ?? true;\\n  const stragglers = opts.stragglers ?? false;\\n\\n  const double = createProviderDouble();\\n  const sdk = createSdk({\\n    provider: double,\\n    mode: \\\"manual\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    chunkPolicy: FIXTURE_CHUNK_POLICY,\\n  });\\n\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n\\n  const turnIds: string[] = [];\\n  const fixture: DerivedThreadFixture = {\\n    filePath,\\n    sdk,\\n    double,\\n    turnIds,\\n    chunks: { chunks: [], members: [] },\\n  };\\n\\n  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\\n    if (failures && turn === 6) {\\n      // Retryable failures consumed to exhaustion by the head-first drain:\\n      // the first tool_result_summary item of this batch takes all three\\n      // attempts and lands failed with the transient reason class.\\n      double.failKind(\\\"tool_result_summary\\\", 3, {\\n        retryable: true,\\n        reason: TRANSIENT_EXHAUST_REASON,\\n      });\\n    }\\n    if (failures && turn === 7) {\\n      // One non-retryable failure: terminal on the first attempt — the\\n      // permanent reason class, attempts 1.\\n      double.failKind(\\\"tool_result_summary\\\", 1, {\\n        retryable: false,\\n        reason: PERMANENT_FAILURE_REASON,\\n      });\\n    }\\n    const messageIds = await send(sdk, filePath, turnEvents(turn));\\n    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\\n    // result, call, result, text, end — index 3 is the first tool result,\\n    // the scripted failures' subject.\\n    const firstToolResultId = messageIds[3];\\n    if (failures && (turn === 6 || turn === 7)) {\\n      if (firstToolResultId === undefined || firstToolResultId === \\\"\\\") {\\n        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\\n      }\\n      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\\n      else fixture.failedPermanentMessageId = firstToolResultId;\\n    }\\n    await drain(sdk, filePath);\\n\\n    if (stragglers && turn === 3) {\\n      // A runtime note between turn 3's end and turn 4's prompt: projected\\n      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\\n      const noteIds = await send(sdk, filePath, [\\n        validEvent(\\\"runtime_note\\\", {\\n          payload: { text: \\\"harness restarted between turns (fixture straggler)\\\" },\\n        }),\\n      ]);\\n      const noteId = noteIds[0];\\n      if (noteId === undefined || noteId === \\\"\\\") {\\n        throw new Error(\\\"fixture invariant: between-turns straggler did not project\\\");\\n      }\\n      fixture.stragglerBetweenMessageId = noteId;\\n    }\\n    turnIds.push(`t${turn}`);\\n  }\\n\\n  if (stragglers) {\\n    const noteIds = await send(sdk, filePath, [\\n      validEvent(\\\"runtime_note\\\", {\\n        payload: { text: \\\"session closing note after the last turn (fixture straggler)\\\" },\\n      }),\\n    ]);\\n    const noteId = noteIds[0];\\n    if (noteId === undefined || noteId === \\\"\\\") {\\n      throw new Error(\\\"fixture invariant: trailing straggler did not project\\\");\\n    }\\n    fixture.stragglerTrailingMessageId = noteId;\\n    await drain(sdk, filePath);\\n  }\\n\\n  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\\n  // chunks, the first three closed. A failure here means the deterministic\\n  // substrate moved (provider output or tokenizer), not a flaky test.\\n  fixture.chunks = readChunks(filePath);\\n  if (fixture.chunks.chunks.length !== 4) {\\n    throw new Error(\\n      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\\n    );\\n  }\\n  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \\\"closed\\\").length;\\n  if (closed !== 3) {\\n    throw new Error(\\n      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\\n    );\\n  }\\n\\n  if (failures) {\\n    // Verify the manufactured states by read-back through the owning report\\n    // surface before handing the fixture to any test (FC-0.3's enforcement\\n    // lives in the tests; this guards the builder's own contract).\\n    const report = await sdk.messages.report({ filePath });\\n    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\\n    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\\n    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\\n    if (\\n      transient.length !== 1 ||\\n      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\\n      permanent.length !== 1 ||\\n      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\\n    ) {\\n      throw new Error(\\n        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\\n      );\\n    }\\n  }\\n\\n  return fixture;\\n}\\n\\n// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\\n// conversation with a runtime note between two turns and one after the last\\n// turn, fully drained, no manufactured failures.\\nexport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\\n  return derivedThreadFixture(store, { failures: false, stragglers: true });\\n}\\n\\n// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\\n// short real conversation, drained clean, then damaged below the SDK into\\n// the two-open-turns state no public operation can produce. Canonical\\n// consumers refuse it with state_corruption.\\nexport async function corruptedVariantThread(\\n  store: TempStore,\\n): Promise<{ filePath: string; sdk: Lhc }> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  for (let turn = 1; turn <= 3; turn += 1) {\\n    await send(sdk, filePath, turnEvents(turn));\\n  }\\n  await drain(sdk, filePath);\\n  // Open a turn through real intake, then add a second open row: two open\\n  // turns, the Epic 01 invariant violation.\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n  ]);\\n  corruptTwoOpenTurns(filePath);\\n  return { filePath, sdk };\\n}\\n\\n// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\\n// queued derivation meets real source damage at drain time — the handler\\n// finds two open turns and lands the turn forms blocked through the\\n// production terminal path, never a hand-written row.\\nexport async function blockedSiblingThread(\\n  store: TempStore,\\n): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  // Turn 1 closes (its turn_derivation queues); a second turn opens through\\n  // real intake; the corruption writer adds another open row. The drain then\\n  // claims t1's derivation against a record with two open turns.\\n  await send(sdk, filePath, turnEvents(1));\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n  ]);\\n  corruptTwoOpenTurns(filePath);\\n  const report = await sdk.work.drain({ filePath });\\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\\n  const blocked = report.value.ran.find(\\n    (entry) => entry.kind === \\\"turn_derivation\\\" && entry.disposition === \\\"failed_terminal\\\",\\n  );\\n  if (blocked === undefined) {\\n    throw new Error(\\\"fixture invariant: turn_derivation expected to land terminal on damage\\\");\\n  }\\n  return { filePath, sdk, blockedTurnId: \\\"t1\\\" };\\n}\\n\",\"numLines\":318,\"startLine\":1,\"totalLines\":318}}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/00-foundation/streams/003-implementor.stdout.log:1621:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"only FormReportEntry[], reason: string): FormReportEntry[] {\\\\n  return entries.filter((entry) => entry.state === \\\\\\\"failed\\\\\\\" && entry.reason === reason\"}},\"session_id\":\"9b79ae20-893f-4407-8201-b760b8487b13\",\"parent_tool_use_id\":null,\"uuid\":\"ac5c9a46-4014-4a37-bc05-95c6ca455ab0\"}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/00-foundation/streams/003-implementor.stdout.log:1683:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_018rPQ287nVMtDxcpqpGg1io\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Y85m7kVCQ5TiWUQXWmR6MG\",\"name\":\"Write\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-thread.ts\",\"content\":\"// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\\n// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\\n// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\\n// deterministic provider double into known form states. States are reached\\n// through production paths, never hand-written rows (the anti-shim line\\n// FC-0.3 enforces): the failed states come from scripted provider failures\\n// consumed by the real retry/exhaustion mechanics, and blocked comes from\\n// real source damage on a sacrificial sibling thread. Every later Epic 03\\n// story compacts against what this builder returns.\\nimport {\\n  createSdk,\\n  threads,\\n  type FormReportEntry,\\n  type Lhc,\\n  type MessageEventInput,\\n} from \\\"../../src/index.js\\\";\\nimport { corruptTwoOpe
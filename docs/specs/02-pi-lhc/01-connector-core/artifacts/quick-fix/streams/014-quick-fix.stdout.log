ssionManager: { getEntries: () => [] },\npackages/pi-lhc/src/pi/types.ts:115: *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\npackages/pi-lhc/src/pi/types.ts:121:  appendEntry(customType: string, data: unknown): void;\npackages/pi-lhc/src/pi/types.ts:148:export interface SessionEntry {\npackages/pi-lhc/src/pi/types.ts:154:  getEntries(): SessionEntry[];\npackages/pi-lhc/src/pi/types.ts:163:  sessionManager: SessionManager;\npackages/pi-lhc/test/lifecycle/instance.test.ts:49:    sessionManager: { getEntries: () => [] },\npackages/pi-lhc/src/lifecycle/fork.ts:33:  const currentEntries = ctx.sessionManager.getEntries();\n","exit_code":0,"status":"completed"}}

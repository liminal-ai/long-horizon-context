+\\n packages/pi-lhc/src/lifecycle/thread-resolution.ts |  24 +++\\n packages/pi-lhc/src/pi/types.ts                    | 223 +++++++++++++++++++\\n packages/pi-lhc/src/shared/diagnostics.ts          |  19 ++\\n packages/pi-lhc/src/shared/instance.ts             |  16 ++\\n packages/pi-lhc/src/shared/not-implemented.ts      |  33 +++\\n packages/pi-lhc/src/verify/replay.ts               |  29 +++\\n packages/pi-lhc/test/fixtures/corpus.test.ts       |  37 ++++\\n packages/pi-lhc/test/fixtures/corpus.ts            | 237 +++++++++++++++++++++\\n packages/pi-lhc/test/fixtures/model-call.test.ts   |  46 ++++\\n packages/pi-lhc/test/fixtures/model-call.ts        |  39 ++++\\n packages/pi-lhc/test/fixtures/synthetic.test.ts    |  63 ++++++\\n packages/pi-lhc/test/fixtures/synthetic.ts         | 127 +++++++++++\\n packages/pi-lhc/test/fixtures/thread.test.ts       |  42 ++++\\n packages/pi-lhc/test/fixtures/thread.ts            |  54 +++++\\n packages/pi-lhc/test/smoke/extension-load.test.ts  | 106 +++++++++\\n .../pi-lhc/test/smoke/verification-config.test.ts  |  66 ++++++\\n packages/pi-lhc/tsconfig.json                      |  19 ++\\n packages/pi-lhc/tsconfig.test.json                 |  13 ++\\n packages/pi-lhc/vitest.config.ts                   |  12 ++\\n 38 files changed, 1944 insertions(+), 1 deletion(-)\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:342:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_018gXELJhMkXNtYcGJtRceHF\",\"type\":\"tool_result\",\"content\":\"1\\t// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\n2\\t// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\n3\\t// handler. The connector owns only plain-data `SessionState` plus the live\\n4\\t// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\n5\\t// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\n6\\timport { mkdirSync } from \\\"node:fs\\\";\\n7\\timport { homedir } from \\\"node:os\\\";\\n8\\timport { join } from \\\"node:path\\\";\\n9\\timport { randomUUID } from \\\"node:crypto\\\";\\n10\\timport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \\\"lhc\\\";\\n11\\timport type {\\n12\\t  ExtensionAPI,\\n13\\t  ExtensionContext,\\n14\\t  PiHookHandler,\\n15\\t  PiHookName,\\n16\\t} from \\\"./pi/types.js\\\";\\n17\\timport type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\\n18\\timport { createSessionState } from \\\"./lifecycle/state.js\\\";\\n19\\timport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\n20\\timport {\\n21\\t  parseLaunchFlags,\\n22\\t  resolveThread,\\n23\\t  type LaunchFlags,\\n24\\t} from \\\"./lifecycle/thread-resolution.js\\\";\\n25\\timport { pickThread, type ThreadChoice } from \\\"./lifecycle/picker.js\\\";\\n26\\timport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n27\\t\\n28\\texport { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\n29\\texport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n30\\t\\n31\\t/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n32\\t *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n33\\t *  registers no handler for it (story Scope Out). */\\n34\\texport const EPIC_1_HOOKS = [\\n35\\t  \\\"session_start\\\",\\n36\\t  \\\"message_end\\\",\\n37\\t  \\\"turn_end\\\",\\n38\\t  \\\"agent_end\\\",\\n39\\t  \\\"model_select\\\",\\n40\\t  \\\"thinking_level_select\\\",\\n41\\t  \\\"session_before_fork\\\",\\n42\\t  \\\"session_before_switch\\\",\\n43\\t  \\\"session_shutdown\\\",\\n44\\t] as const satisfies readonly PiHookName[];\\n45\\t\\n46\\texport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n47\\t\\n48\\t/** What the connector needs from the host to run a session. Every dependency\\n49\\t *  has a working production default; the overrides exist for test isolation\\n50\\t *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\n51\\t *  in the PI-auth-backed inference config.\\n52\\t *\\n53\\t *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\n54\\t *  default is the observe-only config below (a real, construction-valid SDK);\\n55\\t *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\n56\\texport interface ConnectorDeps {\\n57\\t  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n58\\t  registryPath?: string;\\n59\\t  newThreadFilePath?: () => string;\\n60\\t  parseLaunch?: () => LaunchFlags;\\n61\\t  selectThread?: (\\n62\\t    choices: readonly ThreadChoice[],\\n63\\t    ctx: ExtensionContext,\\n64\\t  ) => Promise<string | null>;\\n65\\t}\\n66\\t\\n67\\t/** Everything the connector retains across hooks as PLAIN data — by\\n68\\t *  construction structuredClone-able. The live `LhcInstance` is held separately\\n69\\t *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n70\\t *  deliberately not part of the snapshot. */\\n71\\texport interface ConnectorSnapshot {\\n72\\t  state: SessionState | null;\\n73\\t  lastDiagnostic: CaptureFailureDiagnostic | null;\\n74\\t}\\n75\\t\\n76\\texport interface Connector {\\n77\\t  /** Register the observe-only hook rail on the PI extension API. */\\n78\\t  register(pi: ExtensionAPI): void;\\n79\\t  /** The plain-data state retained across hooks. `null` until a session\\n80\\t   *  resolves a thread; never holds a PI ctx. */\\n81\\t  getState(): SessionState | null;\\n82\\t  /** The live LHC instance for the current session, or `null`. A test/inspection\\n83\\t   *  seam — held by the connector but never part of the plain-data snapshot. */\\n84\\t  getInstance(): LhcInstance | null;\\n85\\t  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n86\\t  snapshot(): ConnectorSnapshot;\\n87\\t  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n88\\t   *  synthetic ctx/events without a live PI. */\\n89\\t  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n90\\t}\\n91\\t\\n92\\tconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n93\\t\\n94\\t/** The production observe-only SDK config: a real, construction-valid instance\\n95\\t *  in background scheduler mode. Epic 1 is observe-only, so derivations are\\n96\\t *  never served to the model; in Story 1 specifically the connector does not yet\\n97\\t *  capture (message_end is a no-op until Story 2), so no derivation work is\\n98\\t *  queued and this provider is never invoked — it exists only to satisfy\\n99\\t *  construction (AC-1.1 \\\"initializes one LHC instance\\\"). Stories 5/6 replace it\\n100\\t *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\\n101\\t *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\\n102\\t *  package is not yet a build dependency of this workspace). */\\n103\\tfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n104\\t  return { ok: true, value: { provider: createDeterministicProvider(), mode: \\\"background\\\" } };\\n105\\t}\\n106\\t\\n107\\t/** Default `--resume` selection (sufficient for Story 1): resume the most\\n108\\t *  recently created thread in the cwd. The choices arrive in creation order, so\\n109\\t *  the last is the most recent. An interactive operator picker awaits a PI input\\n110\\t *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\\n111\\t *  then this is the production selection, and tests drive an explicit choice\\n112\\t *  through the injected selector. */\\n113\\tfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\\n114\\t  const mostRecent = choices.at(-1);\\n115\\t  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\\n116\\t}\\n117\\t\\n118\\t/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n119\\t *  generated by the registry at creation, so the file name is just a unique\\n120\\t *  handle; the directory is ensured up front (DatabaseSync does not create\\n121\\t *  parents). */\\n122\\tfunction defaultNewThreadFilePath(): string {\\n123\\t  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n124\\t  mkdirSync(dir, { recursive: true });\\n125\\t  return join(dir, `${randomUUID()}.sqlite`);\\n126\\t}\\n127\\t\\n128\\tfunction threadIdOf(ref: ThreadRef): string | null {\\n129\\t  return \\\"threadId\\\" in ref ? ref.threadId : null;\\n130\\t}\\n131\\t\\n132\\t// The durable resolved thread id for the current session, held at MODULE scope\\n133\\t// (not in a connector closure) so it survives the extension teardown/re-init a\\n134\\t// reload performs: a PI process runs one session at a time, so a single\\n135\\t// \\\"current thread id\\\" is unambiguous, and a fresh connector created by the next\\n136\\t// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\\n137\\t// PI-session→thread mapping or a durable file — so process death correctly drops\\n138\\t// it and the next launch re-resolves (no early-crash window, no recovery\\n139\\t// sidecar; epic I-1). Cleared on any non-reload teardown.\\n140\\tlet rememberedSessionThreadId: string | null = null;\\n141\\t\\n142\\t/** Reset the module-level reload memory. Test seam so each test starts from a\\n143\\t *  clean durable state; also the hook a full teardown would call. */\\n144\\texport function resetSessionThreadMemory(): void {\\n145\\t  rememberedSessionThreadId = null;\\n146\\t}\\n147\\t\\n148\\t/** Build a connector instance. Its mutable state lives in this closure; the\\n149\\t *  registered handlers capture it, so the instance stays live for the session\\n150\\t *  even when `activate` discards the returned object. */\\n151\\texport function createConnector(deps: ConnectorDeps = {}): Connector {\\n152\\t  // The connector's retained state. `state` is plain data (the durable thread\\n153\\t  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\n154\\t  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\\n155\\t  // durable reload id lives at MODULE scope (above), not here, so it survives\\n156\\t  // this closure being torn down on reload.\\n157\\t  let state: SessionState | null = null;\\n158\\t  let instance: LhcInstance | null = null;\\n159\\t  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n160\\t\\n161\\t  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\n162\\t  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n163\\t  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\n164\\t  const selectThread = deps.selectThread ?? defaultSelectThread;\\n165\\t\\n166\\t  function diag(code: string, message: string): CaptureFailureDiagnostic {\\n167\\t    return { code, message, recordedGap: false };\\n168\\t  }\\n169\\t\\n170\\t  // On reload (same session continues, the connector torn down and re-created)\\n171\\t  // reconstruct the SAME thread from its durable id rather than re-running the\\n172\\t  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\\n173\\t  // id is read from the module-level reload memory, which survives this closure;\\n174\\t  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\\n175\\t  // the fallback, covering --session/--continue/--resume reloads. The permanent\\n176\\t  // home for reload lineage is LHC thread metadata (Feature 2+).\\n177\\t  function launchFor(event: { reason: string }): LaunchFlags {\\n178\\t    if (event.reason === \\\"reload\\\" && rememberedSessionThreadId !== null) {\\n179\\t      return { session: rememberedSessionThreadId };\\n180\\t    }\\n181\\t    return parseLaunch();\\n182\\t  }\\n183\\t\\n184\\t  async function resolveForLaunch(\\n185\\t    launch: LaunchFlags,\\n186\\t    ctx: ExtensionContext,\\n187\\t  ): Promise<OpResult<ThreadRef | null>> {\\n188\\t    if (launch.resume === true) {\\n189\\t      const pickerDeps: {\\n190\\t        registryPath?: string;\\n191\\t        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n192\\t      } = { select: (choices) => selectThread(choices, ctx) };\\n193\\t      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\n194\\t      return pickThread(ctx.cwd, pickerDeps);\\n195\\t    }\\n196\\t    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\\n197\\t      cwd: ctx.cwd,\\n198\\t      newThreadFilePath,\\n199\\t    };\\n200\\t    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\n201\\t    return resolveThread(launch, resolveDeps);\\n202\\t  }\\n203\\t\\n204\\t  // session_start: resolve the recording thread from the launch and construct\\n205\\t  // one background instance against it. Config is gated first so a session with\\n206\\t  // no usable inference config resolves/creates nothing (no orphan thread).\\n207\\t  const onSessionStart: PiHookHandler<\\\"session_start\\\"> = async (ctx, event) => {\\n208\\t    const config = buildSdkConfig(ctx);\\n209\\t    if (!config.ok) {\\n210\\t      lastDiagnostic = diag(\\\"instance_not_configured\\\", config.error.reason);\\n211\\t      return;\\n212\\t    }\\n213\\t    const resolved = await resolveForLaunch(launchFor(event), ctx);\\n214\\t    if (!resolved.ok) {\\n215\\t      lastDiagnostic = diag(\\\"thread_resolution_failed\\\", resolved.error.reason);\\n216\\t      return;\\n217\\t    }\\n218\\t    if (resolved.value === null) {\\n219\\t      lastDiagnostic = diag(\\\"no_thread_selected\\\", \\\"--resume resolved no thread\\\");\\n220\\t      return;\\n221\\t    }\\n222\\t    const built = await initInstance(resolved.value, config.value);\\n223\\t    if (!built.ok) {\\n224\\t      lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n225\\t      return;\\n226\\t    }\\n227\\t    instance = built.value;\\n228\\t    state = createSessionState(resolved.value);\\n229\\t    rememberedSessionThreadId = threadIdOf(resolved.value);\\n230\\t  };\\n231\\t\\n232\\t  // Dispose with flush before any session swap (session_before_switch fires\\n233\\t  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\n234\\t  // no live instance is a no-op. The durable reload id is kept across a reload\\n235\\t  // (the session continues and will reattach) and cleared on any other teardown\\n236\\t  // so a later new/resume session never reattaches a stale thread.\\n237\\t  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\\n238\\t    const result = await disposeInstance(instance);\\n239\\t    if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n240\\t    instance = null;\\n241\\t    const isReload = \\\"reason\\\" in event && event.reason === \\\"reload\\\";\\n242\\t    if (!isReload) rememberedSessionThreadId = null;\\n243\\t  };\\n244\\t\\n245\\t  // Contain every handler: an observe-only hook must never throw back into PI\\n246\\t  // (a thrown hook breaks the user's session). A caught error becomes a\\n247\\t  // plain-data diagnostic; it is never rethrown.\\n248\\t  const guard = (\\n249\\t    name: Epic1Hook,\\n250\\t    body: PiHookHandler<Epic1Hook>,\\n251\\t  ): PiHookHandler<Epic1Hook> => {\\n252\\t    return async (ctx, event): Promise<void> => {\\n253\\t      try {\\n254\\t        await body(ctx, event);\\n255\\t      } catch (err) {\\n256\\t        lastDiagnostic = {\\n257\\t          code: \\\"hook_handler_error\\\",\\n258\\t          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\n259\\t          recordedGap: false,\\n260\\t        };\\n261\\t      }\\n262\\t    };\\n263\\t  };\\n264\\t\\n265\\t  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\\n266\\t  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\\n267\\t  // land in later stories. Each receives a FRESH ctx and retains none of it.\\n268\\t  const noop: PiHookHandler<Epic1Hook> = () => {\\n269\\t    // Intentionally empty — later stories replace this with real routing.\\n270\\t  };\\n271\\t\\n272\\t  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\\n273\\t  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n274\\t    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n275\\t    session_before_switch: onDispose,\\n276\\t    session_shutdown: onDispose,\\n277\\t    message_end: noop,\\n278\\t    turn_end: noop,\\n279\\t    agent_end: noop,\\n280\\t    model_select: noop,\\n281\\t    thinking_level_select: noop,\\n282\\t    session_before_fork: noop,\\n283\\t  };\\n284\\t\\n285\\t  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\n286\\t  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\n287\\t\\n288\\t  return {\\n289\\t    handlers,\\n290\\t    register(pi: ExtensionAPI): void {\\n291\\t      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\n292\\t    },\\n293\\t    getState(): SessionState | null {\\n294\\t      return state;\\n295\\t    },\\n296\\t    getInstance(): LhcInstance | null {\\n297\\t      return instance;\\n298\\t    },\\n299\\t    snapshot(): ConnectorSnapshot {\\n300\\t      return { state, lastDiagnostic };\\n301\\t    },\\n302\\t  };\\n303\\t}\\n304\\t\\n305\\t/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n306\\t *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\n307\\t *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\n308\\t *  observe-only SDK config, the most-recent `--resume` selection, and the\\n309\\t *  module-level reload memory — so a live session_start resolves/creates and\\n310\\t *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\\n311\\t *  config; reload reconstruction reads the durable id the prior activation left\\n312\\t *  in the module-level memory. */\\n313\\texport function activate(pi: ExtensionAPI): void {\\n314\\t  createConnector().register(pi);\\n315\\t}\\n316\\t\\n317\\texport default activate;\\n318\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"5a41a4dd-b7c7-4410-b03f-951039537c07\",\"timestamp\":\"2026-06-14T05:25:35.197Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\",\"content\":\"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\n// handler. The connector owns only plain-data `SessionState` plus the live\\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\nimport { mkdirSync } from \\\"node:fs\\\";\\nimport { homedir } from \\\"node:os\\\";\\nimport { join } from \\\"node:path\\\";\\nimport { randomUUID } from \\\"node:crypto\\\";\\nimport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \\\"lhc\\\";\\nimport type {\\n  ExtensionAPI,\\n  ExtensionContext,\\n  PiHookHandler,\\n  PiHookName,\\n} from \\\"./pi/types.js\\\";\\nimport type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\\nimport { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\nimport {\\n  parseLaunchFlags,\\n  resolveThread,\\n  type LaunchFlags,\\n} from \\\"./lifecycle/thread-resolution.js\\\";\\nimport { pickThread, type ThreadChoice } from \\\"./lifecycle/picker.js\\\";\\nimport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\nexport { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\nexport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n *  registers no handler for it (story Scope Out). */\\nexport const EPIC_1_HOOKS = [\\n  \\\"session_start\\\",\\n  \\\"message_end\\\",\\n  \\\"turn_end\\\",\\n  \\\"agent_end\\\",\\n  \\\"model_select\\\",\\n  \\\"thinking_level_select\\\",\\n  \\\"session_before_fork\\\",\\n  \\\"session_before_switch\\\",\\n  \\\"session_shutdown\\\",\\n] as const satisfies readonly PiHookName[];\\n\\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n\\n/** What the connector needs from the host to run a session. Every dependency\\n *  has a working production default; the overrides exist for test isolation\\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\n *  in the PI-auth-backed inference config.\\n *\\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\n *  default is the observe-only config below (a real, construction-valid SDK);\\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\nexport interface ConnectorDeps {\\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n  registryPath?: string;\\n  newThreadFilePath?: () => string;\\n  parseLaunch?: () => LaunchFlags;\\n  selectThread?: (\\n    choices: readonly ThreadChoice[],\\n    ctx: ExtensionContext,\\n  ) => Promise<string | null>;\\n}\\n\\n/** Everything the connector retains across hooks as PLAIN data — by\\n *  construction structuredClone-able. The live `LhcInstance` is held separately\\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n *  deliberately not part of the snapshot. */\\nexport interface ConnectorSnapshot {\\n  state: SessionState | null;\\n  lastDiagnostic: CaptureFailureDiagnostic | null;\\n}\\n\\nexport interface Connector {\\n  /** Register the observe-only hook rail on the PI extension API. */\\n  register(pi: ExtensionAPI): void;\\n  /** The plain-data state retained across hooks. `null` until a session\\n   *  resolves a thread; never holds a PI ctx. */\\n  getState(): SessionState | null;\\n  /** The live LHC instance for the current session, or `null`. A test/inspection\\n   *  seam — held by the connector but never part of the plain-data snapshot. */\\n  getInstance(): LhcInstance | null;\\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n  snapshot(): ConnectorSnapshot;\\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n   *  synthetic ctx/events without a live PI. */\\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n}\\n\\nconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n\\n/** The production observe-only SDK config: a real, construction-valid instance\\n *  in background scheduler mode. Epic 1 is observe-only, so derivations are\\n *  never served to the model; in Story 1 specifically the connector does not yet\\n *  capture (message_end is a no-op until Story 2), so no derivation work is\\n *  queued and this provider is never invoked — it exists only to satisfy\\n *  construction (AC-1.1 \\\"initializes one LHC instance\\\"). Stories 5/6 replace it\\n *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\\n *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\\n *  package is not yet a build dependency of this workspace). */\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n  return { ok: true, value: { provider: createDeterministicProvider(), mode: \\\"background\\\" } };\\n}\\n\\n/** Default `--resume` selection (sufficient for Story 1): resume the most\\n *  recently created thread in the cwd. The choices arrive in creation order, so\\n *  the last is the most recent. An interactive operator picker awaits a PI input\\n *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\\n *  then this is the production selection, and tests drive an explicit choice\\n *  through the injected selector. */\\nfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\\n  const mostRecent = choices.at(-1);\\n  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\\n}\\n\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n *  generated by the registry at creation, so the file name is just a unique\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\n *  parents). */\\nfunction defaultNewThreadFilePath(): string {\\n  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n  mkdirSync(dir, { recursive: true });\\n  return join(dir, `${randomUUID()}.sqlite`);\\n}\\n\\nfunction threadIdOf(ref: ThreadRef): string | null {\\n  return \\\"threadId\\\" in ref ? ref.threadId : null;\\n}\\n\\n// The durable resolved thread id for the current session, held at MODULE scope\\n// (not in a connector closure) so it survives the extension teardown/re-init a\\n// reload performs: a PI process runs one session at a time, so a single\\n// \\\"current thread id\\\" is unambiguous, and a fresh connector created by the next\\n// `activate()` reconstructs from it (AC-1.5). It is in-process only — NOT a\\n// PI-session→thread mapping or a durable file — so process death correctly drops\\n// it and the next launch re-resolves (no early-crash window, no recovery\\n// sidecar; epic I-1). Cleared on any non-reload teardown.\\nlet rememberedSessionThreadId: string | null = null;\\n\\n/** Reset the module-level reload memory. Test seam so each test starts from a\\n *  clean durable state; also the hook a full teardown would call. */\\nexport function resetSessionThreadMemory(): void {\\n  rememberedSessionThreadId = null;\\n}\\n\\n/** Build a connector instance. Its mutable state lives in this closure; the\\n *  registered handlers capture it, so the instance stays live for the session\\n *  even when `activate` discards the returned object. */\\nexport function createConnector(deps: ConnectorDeps = {}): Connector {\\n  // The connector's retained state. `state` is plain data (the durable thread\\n  // reference + flags); `instance` is the live SDK engine (rebuilt on reload);\\n  // `lastDiagnostic` is the plain-data health signal. None is a PI object. The\\n  // durable reload id lives at MODULE scope (above), not here, so it survives\\n  // this closure being torn down on reload.\\n  let state: SessionState | null = null;\\n  let instance: LhcInstance | null = null;\\n  let lastDiagnostic: CaptureFailureDiagnostic | null = null;\\n\\n  const buildSdkConfig = deps.buildSdkConfig ?? defaultBuildSdkConfig;\\n  const newThreadFilePath = deps.newThreadFilePath ?? defaultNewThreadFilePath;\\n  const parseLaunch = deps.parseLaunch ?? (() => parseLaunchFlags(process.argv));\\n  const selectThread = deps.selectThread ?? defaultSelectThread;\\n\\n  function diag(code: string, message: string): CaptureFailureDiagnostic {\\n    return { code, message, recordedGap: false };\\n  }\\n\\n  // On reload (same session continues, the connector torn down and re-created)\\n  // reconstruct the SAME thread from its durable id rather than re-running the\\n  // launch — a no-flag session would otherwise create a duplicate (AC-1.5). The\\n  // id is read from the module-level reload memory, which survives this closure;\\n  // if it is absent (e.g. a full module re-import) the launch (process.argv) is\\n  // the fallback, covering --session/--continue/--resume reloads. The permanent\\n  // home for reload lineage is LHC thread metadata (Feature 2+).\\n  function launchFor(event: { reason: string }): LaunchFlags {\\n    if (event.reason === \\\"reload\\\" && rememberedSessionThreadId !== null) {\\n      return { session: rememberedSessionThreadId };\\n    }\\n    return parseLaunch();\\n  }\\n\\n  async function resolveForLaunch(\\n    launch: LaunchFlags,\\n    ctx: ExtensionContext,\\n  ): Promise<OpResult<ThreadRef | null>> {\\n    if (launch.resume === true) {\\n      const pickerDeps: {\\n        registryPath?: string;\\n        select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n      } = { select: (choices) => selectThread(choices, ctx) };\\n      if (deps.registryPath !== undefined) pickerDeps.registryPath = deps.registryPath;\\n      return pickThread(ctx.cwd, pickerDeps);\\n    }\\n    const resolveDeps: { cwd: string; registryPath?: string; newThreadFilePath: () => string } = {\\n      cwd: ctx.cwd,\\n      newThreadFilePath,\\n    };\\n    if (deps.registryPath !== undefined) resolveDeps.registryPath = deps.registryPath;\\n    return resolveThread(launch, resolveDeps);\\n  }\\n\\n  // session_start: resolve the recording thread from the launch and construct\\n  // one background instance against it. Config is gated first so a session with\\n  // no usable inference config resolves/creates nothing (no orphan thread).\\n  const onSessionStart: PiHookHandler<\\\"session_start\\\"> = async (ctx, event) => {\\n    const config = buildSdkConfig(ctx);\\n    if (!config.ok) {\\n      lastDiagnostic = diag(\\\"instance_not_configured\\\", config.error.reason);\\n      return;\\n    }\\n    const resolved = await resolveForLaunch(launchFor(event), ctx);\\n    if (!resolved.ok) {\\n      lastDiagnostic = diag(\\\"thread_resolution_failed\\\", resolved.error.reason);\\n      return;\\n    }\\n    if (resolved.value === null) {\\n      lastDiagnostic = diag(\\\"no_thread_selected\\\", \\\"--resume resolved no thread\\\");\\n      return;\\n    }\\n    const built = await initInstance(resolved.value, config.value);\\n    if (!built.ok) {\\n      lastDiagnostic = diag(\\\"instance_init_failed\\\", built.error.reason);\\n      return;\\n    }\\n    instance = built.value;\\n    state = createSessionState(resolved.value);\\n    rememberedSessionThreadId = threadIdOf(resolved.value);\\n  };\\n\\n  // Dispose with flush before any session swap (session_before_switch fires\\n  // pre-new/resume) and on shutdown/reload. Idempotent: disposing twice or with\\n  // no live instance is a no-op. The durable reload id is kept across a reload\\n  // (the session continues and will reattach) and cleared on any other teardown\\n  // so a later new/resume session never reattaches a stale thread.\\n  const onDispose: PiHookHandler<Epic1Hook> = async (_ctx, event) => {\\n    const result = await disposeInstance(instance);\\n    if (!result.ok) lastDiagnostic = diag(\\\"dispose_failed\\\", result.error.reason);\\n    instance = null;\\n    const isReload = \\\"reason\\\" in event && event.reason === \\\"reload\\\";\\n    if (!isReload) rememberedSessionThreadId = null;\\n  };\\n\\n  // Contain every handler: an observe-only hook must never throw back into PI\\n  // (a thrown hook breaks the user's session). A caught error becomes a\\n  // plain-data diagnostic; it is never rethrown.\\n  const guard = (\\n    name: Epic1Hook,\\n    body: PiHookHandler<Epic1Hook>,\\n  ): PiHookHandler<Epic1Hook> => {\\n    return async (ctx, event): Promise<void> => {\\n      try {\\n        await body(ctx, event);\\n      } catch (err) {\\n        lastDiagnostic = {\\n          code: \\\"hook_handler_error\\\",\\n          message: `${name}: ${err instanceof Error ? err.message : String(err)}`,\\n          recordedGap: false,\\n        };\\n      }\\n    };\\n  };\\n\\n  // Observe-only foundation: capture-bearing hooks (message_end, turn_end,\\n  // agent_end, runtime changes, fork) stay no-ops in Story 1 — capture and fork\\n  // land in later stories. Each receives a FRESH ctx and retains none of it.\\n  const noop: PiHookHandler<Epic1Hook> = () => {\\n    // Intentionally empty — later stories replace this with real routing.\\n  };\\n\\n  // Bodies per hook: session lifecycle is live in Story 1; the rest are no-ops.\\n  const bodies: Record<Epic1Hook, PiHookHandler<Epic1Hook>> = {\\n    session_start: onSessionStart as PiHookHandler<Epic1Hook>,\\n    session_before_switch: onDispose,\\n    session_shutdown: onDispose,\\n    message_end: noop,\\n    turn_end: noop,\\n    agent_end: noop,\\n    model_select: noop,\\n    thinking_level_select: noop,\\n    session_before_fork: noop,\\n  };\\n\\n  const handlers = {} as Record<Epic1Hook, PiHookHandler<Epic1Hook>>;\\n  for (const name of EPIC_1_HOOKS) handlers[name] = guard(name, bodies[name]);\\n\\n  return {\\n    handlers,\\n    register(pi: ExtensionAPI): void {\\n      for (const name of EPIC_1_HOOKS) pi.registerHook(name, handlers[name]);\\n    },\\n    getState(): SessionState | null {\\n      return state;\\n    },\\n    getInstance(): LhcInstance | null {\\n      return instance;\\n    },\\n    snapshot(): ConnectorSnapshot {\\n      return { state, lastDiagnostic };\\n    },\\n  };\\n}\\n\\n/** PI entry point: PI calls this with the ExtensionAPI when the extension\\n *  loads (and again on `/reload`). Registers the observe-only hook rail with the\\n *  production defaults — the `~/.lhc` registry, `process.argv` launch flags, the\\n *  observe-only SDK config, the most-recent `--resume` selection, and the\\n *  module-level reload memory — so a live session_start resolves/creates and\\n *  initializes for real. Stories 5/6 swap in the PI-auth-backed inference\\n *  config; reload reconstruction reads the durable id the prior activation left\\n *  in the module-level memory. */\\nexport function activate(pi: ExtensionAPI): void {\\n  createConnector().register(pi);\\n}\\n\\nexport default activate;\\n\",\"numLines\":318,\"startLine\":1,\"totalLines\":318}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:349:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01BAwW6Bj3nCk5dEyruuSdgh\",\"type\":\"tool_result\",\"content\":\"1\\t// Local declarations of the PI extension surface the connector consumes.\\n2\\t//\\n3\\t// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\\n4\\t// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\\n5\\t// headless + interactive recon, June 12 2026). The PI packages are not yet a\\n6\\t// build-time dependency of this workspace, so the connector declares the slice\\n7\\t// of their contract it touches and swaps to the real imports when the\\n8\\t// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\\n9\\t// surface here — rather than scattered `any` — means later stories get real\\n10\\t// type-checking against the contract PI actually fires.\\n11\\t\\n12\\t// ── Hook vocabulary ──────────────────────────────────────────────────\\n13\\t\\n14\\t/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\\n15\\t *  `context` is fired by PI but Epic 1 registers no handler for it — context\\n16\\t *  serving is Epic 2. */\\n17\\texport type PiHookName =\\n18\\t  | \\\"session_start\\\"\\n19\\t  | \\\"message_end\\\"\\n20\\t  | \\\"turn_end\\\"\\n21\\t  | \\\"agent_end\\\"\\n22\\t  | \\\"model_select\\\"\\n23\\t  | \\\"thinking_level_select\\\"\\n24\\t  | \\\"session_before_fork\\\"\\n25\\t  | \\\"session_before_switch\\\"\\n26\\t  | \\\"session_shutdown\\\"\\n27\\t  | \\\"context\\\";\\n28\\t\\n29\\texport type SessionStartReason = \\\"startup\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\" | \\\"fork\\\";\\n30\\texport type SessionShutdownReason = \\\"shutdown\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\";\\n31\\t\\n32\\texport interface SessionStartEvent {\\n33\\t  reason: SessionStartReason;\\n34\\t  previousSessionFile?: string;\\n35\\t}\\n36\\texport interface MessageEndEvent {\\n37\\t  message: AgentMessage;\\n38\\t}\\n39\\t/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\\n40\\t *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\\n41\\texport interface TurnEndEvent {\\n42\\t  turnIndex: number;\\n43\\t  message: AgentMessage;\\n44\\t  toolResults: ToolResultMessage[];\\n45\\t  stopReason?: PiStopReason;\\n46\\t}\\n47\\texport interface AgentEndEvent {\\n48\\t  messages: AgentMessage[];\\n49\\t}\\n50\\texport interface ModelSelectEvent {\\n51\\t  model: ModelDescriptor;\\n52\\t  previousModel?: ModelDescriptor;\\n53\\t  source?: string;\\n54\\t}\\n55\\texport interface ThinkingLevelSelectEvent {\\n56\\t  level: string;\\n57\\t  previousLevel: string;\\n58\\t}\\n59\\texport interface SessionBeforeForkEvent {\\n60\\t  entryId: string;\\n61\\t  position?: number;\\n62\\t}\\n63\\texport interface SessionBeforeSwitchEvent {\\n64\\t  intent: \\\"new\\\" | \\\"resume\\\";\\n65\\t}\\n66\\texport interface SessionShutdownEvent {\\n67\\t  reason: SessionShutdownReason;\\n68\\t  targetSessionFile?: string;\\n69\\t}\\n70\\t/** Declared for completeness; Epic 1 registers no handler (observe-only). */\\n71\\texport interface ContextEvent {\\n72\\t  messages: AgentMessage[];\\n73\\t}\\n74\\t\\n75\\t/** Maps each hook to the payload PI delivers with it. */\\n76\\texport interface PiHookEventMap {\\n77\\t  session_start: SessionStartEvent;\\n78\\t  message_end: MessageEndEvent;\\n79\\t  turn_end: TurnEndEvent;\\n80\\t  agent_end: AgentEndEvent;\\n81\\t  model_select: ModelSelectEvent;\\n82\\t  thinking_level_select: ThinkingLevelSelectEvent;\\n83\\t  session_before_fork: SessionBeforeForkEvent;\\n84\\t  session_before_switch: SessionBeforeSwitchEvent;\\n85\\t  session_shutdown: SessionShutdownEvent;\\n86\\t  context: ContextEvent;\\n87\\t}\\n88\\t\\n89\\t/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\\n90\\t *  connector must never retain it across calls (PI replaces session objects on\\n91\\t *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\\n92\\texport type PiHookHandler<N extends PiHookName> = (\\n93\\t  ctx: ExtensionContext,\\n94\\t  event: PiHookEventMap[N],\\n95\\t) => void | Promise<void>;\\n96\\t\\n97\\t// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\\n98\\t\\n99\\texport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\\n100\\t\\n101\\texport interface PiToolSpec {\\n102\\t  name: string;\\n103\\t  description?: string;\\n104\\t  promptSnippet?: string;\\n105\\t  promptGuidelines?: string;\\n106\\t  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\\n107\\t}\\n108\\t\\n109\\t/** The factory-time API. Hook registration and command/tool registration take\\n110\\t *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\\n111\\t *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\\n112\\t *  exposes them, but Epic 1 (observe-only) registers only hooks. */\\n113\\texport interface ExtensionAPI {\\n114\\t  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\\n115\\t  registerCommand(name: string, handler: PiCommandHandler): void;\\n116\\t  registerTool(tool: PiToolSpec): void;\\n117\\t  appendEntry(customType: string, data: unknown): void;\\n118\\t}\\n119\\t\\n120\\t// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\\n121\\t\\n122\\texport interface ModelDescriptor {\\n123\\t  provider: string;\\n124\\t  id: string;\\n125\\t}\\n126\\t\\n127\\t/** Opaque handle the model registry returns; it carries auth/runtime detail PI\\n128\\t *  owns. The connector treats provider/model as opaque routing keys. */\\n129\\texport interface ModelHandle extends ModelDescriptor {\\n130\\t  readonly [k: string]: unknown;\\n131\\t}\\n132\\t\\n133\\texport interface ModelRegistry {\\n134\\t  find(provider: string, model: string): ModelHandle | undefined;\\n135\\t  hasConfiguredAuth(model: ModelHandle | string): boolean;\\n136\\t  getAvailable(): ModelHandle[];\\n137\\t}\\n138\\t\\n139\\texport interface ExtensionUI {\\n140\\t  notify(message: string, options?: { level?: \\\"info\\\" | \\\"warn\\\" | \\\"error\\\" }): void;\\n141\\t}\\n142\\t\\n143\\texport interface SessionEntry {\\n144\\t  type: string;\\n145\\t  readonly [k: string]: unknown;\\n146\\t}\\n147\\t\\n148\\texport interface SessionManager {\\n149\\t  getEntries(): SessionEntry[];\\n150\\t}\\n151\\t\\n152\\texport interface ExtensionContext {\\n153\\t  modelRegistry: ModelRegistry;\\n154\\t  ui: ExtensionUI;\\n155\\t  /** Guard UI surfacing on this — the extension must work in rpc/json/print\\n156\\t   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\\n157\\t  hasUI: boolean;\\n158\\t  sessionManager: SessionManager;\\n159\\t  cwd: string;\\n160\\t}\\n161\\t\\n162\\t// ── Message vocabulary (AgentMessage and its parts) ──────────────────\\n163\\t\\n164\\texport interface TextPart {\\n165\\t  type: \\\"text\\\";\\n166\\t  text: string;\\n167\\t}\\n168\\texport interface ThinkingPart {\\n169\\t  type: \\\"thinking\\\";\\n170\\t  thinking: string;\\n171\\t  /** Opaque provider reasoning token — captured, not interpreted; dropped in\\n172\\t   *  Epic 1 (tech design I-3). */\\n173\\t  thinkingSignature?: string;\\n174\\t}\\n175\\texport interface ToolCallPart {\\n176\\t  type: \\\"toolCall\\\";\\n177\\t  /** Composite, stable across tool_execution_start → tool_result → message_end\\n178\\t   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\\n179\\t  id: string;\\n180\\t  name: string;\\n181\\t  arguments: Record<string, unknown>;\\n182\\t  /** Opaque; captured, not interpreted (tech design I-3). */\\n183\\t  thoughtSignature?: string;\\n184\\t}\\n185\\t/** Unsupported in the text-only intake schema — degrades to a runtime_note in\\n186\\t *  the converter (tech design I-6), never silently dropped. */\\n187\\texport interface ImagePart {\\n188\\t  type: \\\"image\\\";\\n189\\t  mimeType?: string;\\n190\\t  data?: string;\\n191\\t}\\n192\\texport interface FileRefPart {\\n193\\t  type: \\\"fileRef\\\";\\n194\\t  path: string;\\n195\\t}\\n196\\texport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\\n197\\t\\n198\\texport type PiStopReason = \\\"stop\\\" | \\\"aborted\\\" | \\\"length\\\" | \\\"toolUse\\\" | (string & {});\\n199\\t\\n200\\texport interface TokenUsage {\\n201\\t  inputTokens?: number;\\n202\\t  outputTokens?: number;\\n203\\t}\\n204\\t\\n205\\texport interface UserMessage {\\n206\\t  role: \\\"user\\\";\\n207\\t  content: ContentPart[];\\n208\\t}\\n209\\t/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\\n210\\t *  host maps it to text or a classified failure (Epic 1 Story 5). */\\n211\\texport interface AssistantMessage {\\n212\\t  role: \\\"assistant\\\";\\n213\\t  content: ContentPart[];\\n214\\t  stopReason?: PiStopReason;\\n215\\t  usage?: TokenUsage;\\n216\\t}\\n217\\texport interface ToolResultMessage {\\n218\\t  role: \\\"toolResult\\\";\\n219\\t  toolCallId: string;\\n220\\t  content: ContentPart[];\\n221\\t  isError?: boolean;\\n222\\t}\\n223\\texport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\\n224\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"3dd4b46b-881d-4fca-88da-711de3e4f70d\",\"timestamp\":\"2026-06-14T05:25:35.812Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/pi/types.ts\",\"content\":\"// Local declarations of the PI extension surface the connector consumes.\\n//\\n// These mirror `@earendil-works/pi-coding-agent` v0.79.2 as verified by the\\n// wiring research (docs/specs/02-pi-lhc/notes/pi-ext-integration-research.md,\\n// headless + interactive recon, June 12 2026). The PI packages are not yet a\\n// build-time dependency of this workspace, so the connector declares the slice\\n// of their contract it touches and swaps to the real imports when the\\n// dependency lands (Spec Deviation, recorded in the story payload). Keeping the\\n// surface here — rather than scattered `any` — means later stories get real\\n// type-checking against the contract PI actually fires.\\n\\n// ── Hook vocabulary ──────────────────────────────────────────────────\\n\\n/** Hooks the connector knows about. Epic 1 registers the observe-only rail;\\n *  `context` is fired by PI but Epic 1 registers no handler for it — context\\n *  serving is Epic 2. */\\nexport type PiHookName =\\n  | \\\"session_start\\\"\\n  | \\\"message_end\\\"\\n  | \\\"turn_end\\\"\\n  | \\\"agent_end\\\"\\n  | \\\"model_select\\\"\\n  | \\\"thinking_level_select\\\"\\n  | \\\"session_before_fork\\\"\\n  | \\\"session_before_switch\\\"\\n  | \\\"session_shutdown\\\"\\n  | \\\"context\\\";\\n\\nexport type SessionStartReason = \\\"startup\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\" | \\\"fork\\\";\\nexport type SessionShutdownReason = \\\"shutdown\\\" | \\\"reload\\\" | \\\"new\\\" | \\\"resume\\\";\\n\\nexport interface SessionStartEvent {\\n  reason: SessionStartReason;\\n  previousSessionFile?: string;\\n}\\nexport interface MessageEndEvent {\\n  message: AgentMessage;\\n}\\n/** PI fires one turn_end per agent STEP (turnIndex resets to 0 each run); the\\n *  converter must NOT map it 1:1 to an LHC turn_end (tech design Flow 2). */\\nexport interface TurnEndEvent {\\n  turnIndex: number;\\n  message: AgentMessage;\\n  toolResults: ToolResultMessage[];\\n  stopReason?: PiStopReason;\\n}\\nexport interface AgentEndEvent {\\n  messages: AgentMessage[];\\n}\\nexport interface ModelSelectEvent {\\n  model: ModelDescriptor;\\n  previousModel?: ModelDescriptor;\\n  source?: string;\\n}\\nexport interface ThinkingLevelSelectEvent {\\n  level: string;\\n  previousLevel: string;\\n}\\nexport interface SessionBeforeForkEvent {\\n  entryId: string;\\n  position?: number;\\n}\\nexport interface SessionBeforeSwitchEvent {\\n  intent: \\\"new\\\" | \\\"resume\\\";\\n}\\nexport interface SessionShutdownEvent {\\n  reason: SessionShutdownReason;\\n  targetSessionFile?: string;\\n}\\n/** Declared for completeness; Epic 1 registers no handler (observe-only). */\\nexport interface ContextEvent {\\n  messages: AgentMessage[];\\n}\\n\\n/** Maps each hook to the payload PI delivers with it. */\\nexport interface PiHookEventMap {\\n  session_start: SessionStartEvent;\\n  message_end: MessageEndEvent;\\n  turn_end: TurnEndEvent;\\n  agent_end: AgentEndEvent;\\n  model_select: ModelSelectEvent;\\n  thinking_level_select: ThinkingLevelSelectEvent;\\n  session_before_fork: SessionBeforeForkEvent;\\n  session_before_switch: SessionBeforeSwitchEvent;\\n  session_shutdown: SessionShutdownEvent;\\n  context: ContextEvent;\\n}\\n\\n/** A per-hook handler receives a FRESH `ctx` from PI on every call; the\\n *  connector must never retain it across calls (PI replaces session objects on\\n *  new/resume/fork and a stale reference throws). Tech design Flow 1. */\\nexport type PiHookHandler<N extends PiHookName> = (\\n  ctx: ExtensionContext,\\n  event: PiHookEventMap[N],\\n) => void | Promise<void>;\\n\\n// ── Registration-time API (the `pi` object, ExtensionAPI) ────────────\\n\\nexport type PiCommandHandler = (args: string[], ctx: ExtensionContext) => void | Promise<void>;\\n\\nexport interface PiToolSpec {\\n  name: string;\\n  description?: string;\\n  promptSnippet?: string;\\n  promptGuidelines?: string;\\n  run: (input: unknown, ctx: ExtensionContext) => unknown | Promise<unknown>;\\n}\\n\\n/** The factory-time API. Hook registration and command/tool registration take\\n *  `pi: ExtensionAPI`; per-hook handlers take the fresh `ctx` (tech design\\n *  I-7). `registerCommand`/`registerTool`/`appendEntry` are declared because PI\\n *  exposes them, but Epic 1 (observe-only) registers only hooks. */\\nexport interface ExtensionAPI {\\n  registerHook<N extends PiHookName>(name: N, handler: PiHookHandler<N>): void;\\n  registerCommand(name: string, handler: PiCommandHandler): void;\\n  registerTool(tool: PiToolSpec): void;\\n  appendEntry(customType: string, data: unknown): void;\\n}\\n\\n// ── Per-hook context (the `ctx` object, ExtensionContext) ────────────\\n\\nexport interface ModelDescriptor {\\n  provider: string;\\n  id: string;\\n}\\n\\n/** Opaque handle the model registry returns; it carries auth/runtime detail PI\\n *  owns. The connector treats provider/model as opaque routing keys. */\\nexport interface ModelHandle extends ModelDescriptor {\\n  readonly [k: string]: unknown;\\n}\\n\\nexport interface ModelRegistry {\\n  find(provider: string, model: string): ModelHandle | undefined;\\n  hasConfiguredAuth(model: ModelHandle | string): boolean;\\n  getAvailable(): ModelHandle[];\\n}\\n\\nexport interface ExtensionUI {\\n  notify(message: string, options?: { level?: \\\"info\\\" | \\\"warn\\\" | \\\"error\\\" }): void;\\n}\\n\\nexport interface SessionEntry {\\n  type: string;\\n  readonly [k: string]: unknown;\\n}\\n\\nexport interface SessionManager {\\n  getEntries(): SessionEntry[];\\n}\\n\\nexport interface ExtensionContext {\\n  modelRegistry: ModelRegistry;\\n  ui: ExtensionUI;\\n  /** Guard UI surfacing on this — the extension must work in rpc/json/print\\n   *  modes too (tech design I-9, reporting guards on headless not on ctx.ui). */\\n  hasUI: boolean;\\n  sessionManager: SessionManager;\\n  cwd: string;\\n}\\n\\n// ── Message vocabulary (AgentMessage and its parts) ──────────────────\\n\\nexport interface TextPart {\\n  type: \\\"text\\\";\\n  text: string;\\n}\\nexport interface ThinkingPart {\\n  type: \\\"thinking\\\";\\n  thinking: string;\\n  /** Opaque provider reasoning token — captured, not interpreted; dropped in\\n   *  Epic 1 (tech design I-3). */\\n  thinkingSignature?: string;\\n}\\nexport interface ToolCallPart {\\n  type: \\\"toolCall\\\";\\n  /** Composite, stable across tool_execution_start → tool_result → message_end\\n   *  (research §5a): `call_<providerId>|fc_<internalId>`. */\\n  id: string;\\n  name: string;\\n  arguments: Record<string, unknown>;\\n  /** Opaque; captured, not interpreted (tech design I-3). */\\n  thoughtSignature?: string;\\n}\\n/** Unsupported in the text-only intake schema — degrades to a runtime_note in\\n *  the converter (tech design I-6), never silently dropped. */\\nexport interface ImagePart {\\n  type: \\\"image\\\";\\n  mimeType?: string;\\n  data?: string;\\n}\\nexport interface FileRefPart {\\n  type: \\\"fileRef\\\";\\n  path: string;\\n}\\nexport type ContentPart = TextPart | ThinkingPart | ToolCallPart | ImagePart | FileRefPart;\\n\\nexport type PiStopReason = \\\"stop\\\" | \\\"aborted\\\" | \\\"length\\\" | \\\"toolUse\\\" | (string & {});\\n\\nexport interface TokenUsage {\\n  inputTokens?: number;\\n  outputTokens?: number;\\n}\\n\\nexport interface UserMessage {\\n  role: \\\"user\\\";\\n  content: ContentPart[];\\n}\\n/** Also the shape pi-ai's `complete()` returns (research §3); the model-call\\n *  host maps it to text or a classified failure (Epic 1 Story 5). */\\nexport interface AssistantMessage {\\n  role: \\\"assistant\\\";\\n  content: ContentPart[];\\n  stopReason?: PiStopReason;\\n  usage?: TokenUsage;\\n}\\nexport interface ToolResultMessage {\\n  role: \\\"toolResult\\\";\\n  toolCallId: string;\\n  content: ContentPart[];\\n  isError?: boolean;\\n}\\nexport type AgentMessage = UserMessage | AssistantMessage | ToolResultMessage;\\n\",\"numLines\":224,\"startLine\":1,\"totalLines\":224}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:448:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"kConfig` now returns a real config, `rememberedSessionThreadId` moved to module scope, `--resume` default resumes most-recent. The failed res\"}},\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"parent_tool_use_id\":null,\"uuid\":\"3a1e2fc6-3386-423f-ad0d-8d84733d667f\"}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:451:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_01TmEkyWd7vEYWbxkC7dqr52\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"The on-disk code is **further along** than what verifier 004 reviewed — `defaultBuildSdkConfig` now returns a real config, `rememberedSessionThreadId` moved to module scope, `--resume` default resumes most-recent. The failed resume sessions (005/007) appear to have partially applied fixes before dying. I can't trust completeness, so let me read all current code and run the gates. Let me read the remaining lifecycle files, lhc registry changes, and tests.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":131,\"cache_creation_input_tokens\":17031,\"cache_read_input_tokens\":83907,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":17031},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"30a7f6d9-6b0a-4898-be2b-d5dbe3005461\",\"request_id\":\"req_011Cc2bYRwUdkzXmYgZwUn5h\"}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:464:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_011bNmgPuAFX9LHUWzZxDD2Z\",\"type\":\"tool_result\",\"content\":\"1\\timport { basename } from \\\"node:path\\\";\\n2\\timport { threads, type OpResult, type ThreadRef } from \\\"lhc\\\";\\n3\\t\\n4\\t// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\\n5\\t// it (tech design Flow 1). PI's own session file still exists in this\\n6\\t// observe-only epic — it is just not where thread identity lives.\\n7\\t\\n8\\t/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\\n9\\t *  before this resolver — see `picker.ts`.) */\\n10\\texport interface LaunchFlags {\\n11\\t  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\\n12\\t  continue?: boolean; // --continue / -c : most recent\\n13\\t  session?: string; // --session <id> : full or partial id\\n14\\t}\\n15\\t\\n16\\t/** What the resolver needs from the host beyond the launch flags: the cwd a new\\n17\\t *  thread is registered under, the registry to resolve through, and where a new\\n18\\t *  thread's file is created. Injected so the resolver is exercised against a\\n19\\t *  real temp registry in tests and the default `~/.lhc` registry in production —\\n20\\t *  `registryPath` is a per-operation argument, never an `initLhc` config field\\n21\\t *  (tech design Technical Notes). */\\n22\\texport interface ResolveDeps {\\n23\\t  cwd: string;\\n24\\t  registryPath?: string;\\n25\\t  newThreadFilePath: () => string;\\n26\\t  /** Title for a newly created thread (A-8 title metadata). Defaults to\\n27\\t   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\\n28\\t   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\\n29\\t   *  title from the first prompt — the open TDQ Q4). */\\n30\\t  newThreadTitle?: string;\\n31\\t}\\n32\\t\\n33\\t/** The creation-time title for a new thread when the host supplies none. At\\n34\\t *  session_start there is no first prompt yet, so the title is the cwd's leaf\\n35\\t *  directory name — a real, non-empty project label the `--resume` picker shows\\n36\\t *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\\n37\\texport function defaultThreadTitle(cwd: string): string {\\n38\\t  const leaf = basename(cwd);\\n39\\t  if (leaf !== \\\"\\\") return leaf;\\n40\\t  return cwd !== \\\"\\\" ? cwd : \\\"lhc session\\\";\\n41\\t}\\n42\\t\\n43\\t/** The durable, plain-data thread reference the connector retains and\\n44\\t *  reattaches from: a thread id (plus the registry it lives in), not a live\\n45\\t *  object. `{ filePath }` is avoided so reload reconstructs by id. */\\n46\\texport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\\n47\\t  return registryPath === undefined ? { threadId } : { threadId, registryPath };\\n48\\t}\\n49\\t\\n50\\t/** Spread `registryPath` into an LHC threads-call options object only when it is\\n51\\t *  set, so an unset registry path falls through to LHC's default rather than\\n52\\t *  being passed as an explicit `undefined` (rejected under\\n53\\t *  exactOptionalPropertyTypes). */\\n54\\texport function registryArg(registryPath?: string): { registryPath?: string } {\\n55\\t  return registryPath === undefined ? {} : { registryPath };\\n56\\t}\\n57\\t\\n58\\t/** Resolve the recording thread from the launch input (AC-1.6):\\n59\\t *  - `--session <id>`: a named thread by full or partial id; unresolvable or\\n60\\t *    ambiguous fails loud (the registry returns `thread_not_found` /\\n61\\t *    `ambiguous_thread_id`) and never silently creates a thread.\\n62\\t *  - `--continue`: the most recently created thread.\\n63\\t *  - no flag: a new thread, registered with its cwd (AC-1.1).\\n64\\t *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\\n65\\t *  durable id rather than a retained object (AC-1.5). */\\n66\\texport async function resolveThread(\\n67\\t  launch: LaunchFlags,\\n68\\t  deps: ResolveDeps,\\n69\\t): Promise<OpResult<ThreadRef>> {\\n70\\t  if (launch.session !== undefined) {\\n71\\t    const resolved = await threads.resolve({\\n72\\t      threadId: launch.session,\\n73\\t      ...registryArg(deps.registryPath),\\n74\\t    });\\n75\\t    if (!resolved.ok) return resolved;\\n76\\t    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\\n77\\t  }\\n78\\t\\n79\\t  if (launch.continue === true) {\\n80\\t    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\\n81\\t    if (!listed.ok) return listed;\\n82\\t    // The registry lists in creation order with an insertion-order tie-break,\\n83\\t    // so the last row is the most recently created thread.\\n84\\t    const mostRecent = listed.value.at(-1);\\n85\\t    if (mostRecent === undefined) {\\n86\\t      return {\\n87\\t        ok: false,\\n88\\t        error: {\\n89\\t          errorClass: \\\"caller_error\\\",\\n90\\t          code: \\\"thread_not_found\\\",\\n91\\t          reason: \\\"--continue: no threads exist to continue\\\",\\n92\\t        },\\n93\\t      };\\n94\\t    }\\n95\\t    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\\n96\\t  }\\n97\\t\\n98\\t  const created = await threads.newThread({\\n99\\t    filePath: deps.newThreadFilePath(),\\n100\\t    cwd: deps.cwd,\\n101\\t    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\\n102\\t    ...registryArg(deps.registryPath),\\n103\\t  });\\n104\\t  if (!created.ok) return created;\\n105\\t  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\\n106\\t}\\n107\\t\\n108\\t/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\\n109\\t *  so PI's launch arguments are visible on `process.argv`; this is the\\n110\\t *  production source of the launch mode. Supports `--session <id>`,\\n111\\t *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\\n112\\t *  spelling for the named-session mode is an integration detail to confirm\\n113\\t *  against PI; see the story payload's open questions.) */\\n114\\texport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\\n115\\t  const flags: LaunchFlags = {};\\n116\\t  for (let i = 0; i < argv.length; i += 1) {\\n117\\t    const arg = argv[i];\\n118\\t    if (arg === undefined) continue;\\n119\\t    if (arg === \\\"--resume\\\" || arg === \\\"-r\\\") {\\n120\\t      flags.resume = true;\\n121\\t    } else if (arg === \\\"--continue\\\" || arg === \\\"-c\\\") {\\n122\\t      flags.continue = true;\\n123\\t    } else if (arg === \\\"--session\\\") {\\n124\\t      const next = argv[i + 1];\\n125\\t      if (next !== undefined && !next.startsWith(\\\"-\\\")) {\\n126\\t        flags.session = next;\\n127\\t        i += 1;\\n128\\t      }\\n129\\t    } else if (arg.startsWith(\\\"--session=\\\")) {\\n130\\t      flags.session = arg.slice(\\\"--session=\\\".length);\\n131\\t    }\\n132\\t  }\\n133\\t  return flags;\\n134\\t}\\n135\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"584b5802-6a82-446d-87e7-5a6f9db021e6\",\"timestamp\":\"2026-06-14T05:26:43.753Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/thread-resolution.ts\",\"content\":\"import { basename } from \\\"node:path\\\";\\nimport { threads, type OpResult, type ThreadRef } from \\\"lhc\\\";\\n\\n// AC-1.2, AC-1.5, AC-1.6. Launch flags name the thread; the registry resolves\\n// it (tech design Flow 1). PI's own session file still exists in this\\n// observe-only epic — it is just not where thread identity lives.\\n\\n/** None set → new thread. (`--resume`/`-r` is owned by the picker, routed\\n *  before this resolver — see `picker.ts`.) */\\nexport interface LaunchFlags {\\n  resume?: boolean; // --resume / -r : cwd-scoped picker (handled by picker.ts)\\n  continue?: boolean; // --continue / -c : most recent\\n  session?: string; // --session <id> : full or partial id\\n}\\n\\n/** What the resolver needs from the host beyond the launch flags: the cwd a new\\n *  thread is registered under, the registry to resolve through, and where a new\\n *  thread's file is created. Injected so the resolver is exercised against a\\n *  real temp registry in tests and the default `~/.lhc` registry in production —\\n *  `registryPath` is a per-operation argument, never an `initLhc` config field\\n *  (tech design Technical Notes). */\\nexport interface ResolveDeps {\\n  cwd: string;\\n  registryPath?: string;\\n  newThreadFilePath: () => string;\\n  /** Title for a newly created thread (A-8 title metadata). Defaults to\\n   *  `defaultThreadTitle(cwd)` so every connector-created thread is titled\\n   *  (AC-1.1 / TC-1.1); a host may override it (e.g. once Story 2 derives a\\n   *  title from the first prompt — the open TDQ Q4). */\\n  newThreadTitle?: string;\\n}\\n\\n/** The creation-time title for a new thread when the host supplies none. At\\n *  session_start there is no first prompt yet, so the title is the cwd's leaf\\n *  directory name — a real, non-empty project label the `--resume` picker shows\\n *  alongside the creation time. Prompt-derived titles are the deferred TDQ Q4. */\\nexport function defaultThreadTitle(cwd: string): string {\\n  const leaf = basename(cwd);\\n  if (leaf !== \\\"\\\") return leaf;\\n  return cwd !== \\\"\\\" ? cwd : \\\"lhc session\\\";\\n}\\n\\n/** The durable, plain-data thread reference the connector retains and\\n *  reattaches from: a thread id (plus the registry it lives in), not a live\\n *  object. `{ filePath }` is avoided so reload reconstructs by id. */\\nexport function threadRefById(threadId: string, registryPath?: string): ThreadRef {\\n  return registryPath === undefined ? { threadId } : { threadId, registryPath };\\n}\\n\\n/** Spread `registryPath` into an LHC threads-call options object only when it is\\n *  set, so an unset registry path falls through to LHC's default rather than\\n *  being passed as an explicit `undefined` (rejected under\\n *  exactOptionalPropertyTypes). */\\nexport function registryArg(registryPath?: string): { registryPath?: string } {\\n  return registryPath === undefined ? {} : { registryPath };\\n}\\n\\n/** Resolve the recording thread from the launch input (AC-1.6):\\n *  - `--session <id>`: a named thread by full or partial id; unresolvable or\\n *    ambiguous fails loud (the registry returns `thread_not_found` /\\n *    `ambiguous_thread_id`) and never silently creates a thread.\\n *  - `--continue`: the most recently created thread.\\n *  - no flag: a new thread, registered with its cwd (AC-1.1).\\n *  Reload reuses this via `{ session: <resolved id> }`, reconstructing from the\\n *  durable id rather than a retained object (AC-1.5). */\\nexport async function resolveThread(\\n  launch: LaunchFlags,\\n  deps: ResolveDeps,\\n): Promise<OpResult<ThreadRef>> {\\n  if (launch.session !== undefined) {\\n    const resolved = await threads.resolve({\\n      threadId: launch.session,\\n      ...registryArg(deps.registryPath),\\n    });\\n    if (!resolved.ok) return resolved;\\n    return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\\n  }\\n\\n  if (launch.continue === true) {\\n    const listed = await threads.listThreads({ ...registryArg(deps.registryPath) });\\n    if (!listed.ok) return listed;\\n    // The registry lists in creation order with an insertion-order tie-break,\\n    // so the last row is the most recently created thread.\\n    const mostRecent = listed.value.at(-1);\\n    if (mostRecent === undefined) {\\n      return {\\n        ok: false,\\n        error: {\\n          errorClass: \\\"caller_error\\\",\\n          code: \\\"thread_not_found\\\",\\n          reason: \\\"--continue: no threads exist to continue\\\",\\n        },\\n      };\\n    }\\n    return { ok: true, value: threadRefById(mostRecent.threadId, deps.registryPath) };\\n  }\\n\\n  const created = await threads.newThread({\\n    filePath: deps.newThreadFilePath(),\\n    cwd: deps.cwd,\\n    title: deps.newThreadTitle ?? defaultThreadTitle(deps.cwd),\\n    ...registryArg(deps.registryPath),\\n  });\\n  if (!created.ok) return created;\\n  return { ok: true, value: threadRefById(created.value.threadId, deps.registryPath) };\\n}\\n\\n/** Map a launch argv to `LaunchFlags`. The connector runs in-process inside PI,\\n *  so PI's launch arguments are visible on `process.argv`; this is the\\n *  production source of the launch mode. Supports `--session <id>`,\\n *  `--session=<id>`, `--continue`/`-c`, and `--resume`/`-r`. (The exact PI flag\\n *  spelling for the named-session mode is an integration detail to confirm\\n *  against PI; see the story payload's open questions.) */\\nexport function parseLaunchFlags(argv: readonly string[]): LaunchFlags {\\n  const flags: LaunchFlags = {};\\n  for (let i = 0; i < argv.length; i += 1) {\\n    const arg = argv[i];\\n    if (arg === undefined) continue;\\n    if (arg === \\\"--resume\\\" || arg === \\\"-r\\\") {\\n      flags.resume = true;\\n    } else if (arg === \\\"--continue\\\" || arg === \\\"-c\\\") {\\n      flags.continue = true;\\n    } else if (arg === \\\"--session\\\") {\\n      const next = argv[i + 1];\\n      if (next !== undefined && !next.startsWith(\\\"-\\\")) {\\n        flags.session = next;\\n        i += 1;\\n      }\\n    } else if (arg.startsWith(\\\"--session=\\\")) {\\n      flags.session = arg.slice(\\\"--session=\\\".length);\\n    }\\n  }\\n  return flags;\\n}\\n\",\"numLines\":135,\"startLine\":1,\"totalLines\":135}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:479:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_014rQxrawjxpVFbBYgAMpYex\",\"type\":\"tool_result\",\"content\":\"1\\timport { threads, type OpResult, type ThreadRef } from \\\"lhc\\\";\\n2\\timport { registryArg, threadRefById } from \\\"./thread-resolution.js\\\";\\n3\\t\\n4\\t// AC-1.7.\\n5\\t\\n6\\t/** One row the picker offers: enough to show the operator what they are\\n7\\t *  resuming — its title (when set) and creation time — keyed by the id the\\n8\\t *  selection resolves. */\\n9\\texport interface ThreadChoice {\\n10\\t  threadId: string;\\n11\\t  title?: string;\\n12\\t  createdAt: string;\\n13\\t}\\n14\\t\\n15\\t/** What the picker needs from the host: the registry to list/resolve through,\\n16\\t *  and the selection mechanism. `select` is injected so the picker stays a thin,\\n17\\t *  headless-safe registry operation — a real UI in production, a deterministic\\n18\\t *  choice in tests — and returns the chosen thread id, or `null` to cancel. */\\n19\\texport interface PickerDeps {\\n20\\t  registryPath?: string;\\n21\\t  select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n22\\t}\\n23\\t\\n24\\t/** `--resume`/`-r`: list the current cwd's threads (title + creation time) and\\n25\\t *  resolve the operator's selection. The cwd scope is the registry query, not a\\n26\\t *  filter over an unscoped list (anti-shim). With no threads for the cwd the\\n27\\t *  picker reports an empty list (`null`) rather than failing; a cancelled\\n28\\t *  selection is likewise `null`. */\\n29\\texport async function pickThread(\\n30\\t  cwd: string,\\n31\\t  deps: PickerDeps,\\n32\\t): Promise<OpResult<ThreadRef | null>> {\\n33\\t  const listed = await threads.listThreads({ cwd, ...registryArg(deps.registryPath) });\\n34\\t  if (!listed.ok) return listed;\\n35\\t  if (listed.value.length === 0) return { ok: true, value: null };\\n36\\t\\n37\\t  const choices: ThreadChoice[] = listed.value.map((info) => {\\n38\\t    const choice: ThreadChoice = { threadId: info.threadId, createdAt: info.createdAt };\\n39\\t    if (info.title !== undefined) choice.title = info.title;\\n40\\t    return choice;\\n41\\t  });\\n42\\t\\n43\\t  const chosen = await deps.select(choices);\\n44\\t  if (chosen === null) return { ok: true, value: null };\\n45\\t\\n46\\t  const resolved = await threads.resolve({ threadId: chosen, ...registryArg(deps.registryPath) });\\n47\\t  if (!resolved.ok) return resolved;\\n48\\t  return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\\n49\\t}\\n50\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"a4271361-14d1-413e-9da0-47526808257c\",\"timestamp\":\"2026-06-14T05:26:45.169Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/lifecycle/picker.ts\",\"content\":\"import { threads, type OpResult, type ThreadRef } from \\\"lhc\\\";\\nimport { registryArg, threadRefById } from \\\"./thread-resolution.js\\\";\\n\\n// AC-1.7.\\n\\n/** One row the picker offers: enough to show the operator what they are\\n *  resuming — its title (when set) and creation time — keyed by the id the\\n *  selection resolves. */\\nexport interface ThreadChoice {\\n  threadId: string;\\n  title?: string;\\n  createdAt: string;\\n}\\n\\n/** What the picker needs from the host: the registry to list/resolve through,\\n *  and the selection mechanism. `select` is injected so the picker stays a thin,\\n *  headless-safe registry operation — a real UI in production, a deterministic\\n *  choice in tests — and returns the chosen thread id, or `null` to cancel. */\\nexport interface PickerDeps {\\n  registryPath?: string;\\n  select: (choices: readonly ThreadChoice[]) => Promise<string | null>;\\n}\\n\\n/** `--resume`/`-r`: list the current cwd's threads (title + creation time) and\\n *  resolve the operator's selection. The cwd scope is the registry query, not a\\n *  filter over an unscoped list (anti-shim). With no threads for the cwd the\\n *  picker reports an empty list (`null`) rather than failing; a cancelled\\n *  selection is likewise `null`. */\\nexport async function pickThread(\\n  cwd: string,\\n  deps: PickerDeps,\\n): Promise<OpResult<ThreadRef | null>> {\\n  const listed = await threads.listThreads({ cwd, ...registryArg(deps.registryPath) });\\n  if (!listed.ok) return listed;\\n  if (listed.value.length === 0) return { ok: true, value: null };\\n\\n  const choices: ThreadChoice[] = listed.value.map((info) => {\\n    const choice: ThreadChoice = { threadId: info.threadId, createdAt: info.createdAt };\\n    if (info.title !== undefined) choice.title = info.title;\\n    return choice;\\n  });\\n\\n  const chosen = await deps.select(choices);\\n  if (chosen === null) return { ok: true, value: null };\\n\\n  const resolved = await threads.resolve({ threadId: chosen, ...registryArg(deps.registryPath) });\\n  if (!resolved.ok) return resolved;\\n  return { ok: true, value: threadRefById(resolved.value.threadId, deps.registryPath) };\\n}\\n\",\"numLines\":50,\"startLine\":1,\"totalLines\":50}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:484:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01PEfpS3qiideSpnUewHGwQ7\",\"type\":\"tool_result\",\"content\":\"1\\timport type { Lhc, OpResult, ThreadRef } from \\\"lhc\\\";\\n2\\t\\n3\\t/** A constructed LHC session instance: the SDK (one per PI session, background\\n4\\t *  mode) plus the resolved thread it records into, with a flush-on-dispose\\n5\\t *  seam. This and the plain-data `SessionState` are the ONLY things the\\n6\\t *  connector retains between hooks — never a PI `ctx`/session object, which PI\\n7\\t *  replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\n8\\t *\\n9\\t *  Defined in shared/ because both lifecycle (constructs/disposes it) and\\n10\\t *  capture (the converter writes through it) reference it; keeping it here\\n11\\t *  avoids a lifecycle↔capture import cycle. */\\n12\\texport interface LhcInstance {\\n13\\t  readonly sdk: Lhc;\\n14\\t  readonly threadRef: ThreadRef;\\n15\\t  dispose(): Promise<OpResult<void>>;\\n16\\t}\\n17\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"8262797f-0fde-4beb-84d3-acfa7cc8682e\",\"timestamp\":\"2026-06-14T05:26:50.677Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/shared/instance.ts\",\"content\":\"import type { Lhc, OpResult, ThreadRef } from \\\"lhc\\\";\\n\\n/** A constructed LHC session instance: the SDK (one per PI session, background\\n *  mode) plus the resolved thread it records into, with a flush-on-dispose\\n *  seam. This and the plain-data `SessionState` are the ONLY things the\\n *  connector retains between hooks — never a PI `ctx`/session object, which PI\\n *  replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\n *\\n *  Defined in shared/ because both lifecycle (constructs/disposes it) and\\n *  capture (the converter writes through it) reference it; keeping it here\\n *  avoids a lifecycle↔capture import cycle. */\\nexport interface LhcInstance {\\n  readonly sdk: Lhc;\\n  readonly threadRef: ThreadRef;\\n  dispose(): Promise<OpResult<void>>;\\n}\\n\",\"numLines\":17,\"startLine\":1,\"totalLines\":17}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:539:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01W8KenfYKwk2nHibqPxoJ9H\",\"type\":\"tool_result\",\"content\":\"1\\t// Story 1 — instance lifecycle. TC-1.1 drives the PRODUCTION connector path:\\n2\\t// createConnector with only environment overrides (temp registry/thread-file,\\n3\\t// scripted launch) and the REAL default SDK config + selector — proving\\n4\\t// session_start resolves, creates a cwd/title-registered thread, and initializes\\n5\\t// one background instance with no placeholder injection. TC-1.4 proves shutdown\\n6\\t// flush + reattach at the instance level (Story 1 does not capture through hooks\\n7\\t// yet, so events are written directly through the instance). Real temp\\n8\\t// registry/thread throughout (the store is never mocked).\\n9\\timport { existsSync } from \\\"node:fs\\\";\\n10\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n11\\timport {\\n12\\t  createDeterministicProvider,\\n13\\t  inspect,\\n14\\t  threads,\\n15\\t  type SdkConfig,\\n16\\t  type ThreadRef,\\n17\\t} from \\\"lhc\\\";\\n18\\timport { createConnector, resetSessionThreadMemory } from \\\"../../src/index.js\\\";\\n19\\timport { disposeInstance, initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n20\\timport { defaultThreadTitle, resolveThread } from \\\"../../src/lifecycle/thread-resolution.js\\\";\\n21\\timport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\n22\\timport { eventBatch, makeSessionStart } from \\\"../fixtures/synthetic.js\\\";\\n23\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n24\\t\\n25\\tlet store: TempStore;\\n26\\tbeforeEach(() => {\\n27\\t  store = tempStore();\\n28\\t  resetSessionThreadMemory();\\n29\\t});\\n30\\tafterEach(() => {\\n31\\t  store.cleanup();\\n32\\t});\\n33\\t\\n34\\tfunction backgroundConfig(): SdkConfig {\\n35\\t  return { provider: createDeterministicProvider(), mode: \\\"background\\\" };\\n36\\t}\\n37\\t\\n38\\tfunction idOf(ref: ThreadRef): string {\\n39\\t  if (!(\\\"threadId\\\" in ref)) throw new Error(\\\"expected a { threadId } ref\\\");\\n40\\t  return ref.threadId;\\n41\\t}\\n42\\t\\n43\\t// A per-hook ctx carrying methods (not plain data), like PI hands each hook.\\n44\\tfunction syntheticCtx(cwd: string): ExtensionContext {\\n45\\t  return {\\n46\\t    cwd,\\n47\\t    hasUI: false,\\n48\\t    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\\n49\\t    ui: { notify: () => {} },\\n50\\t    sessionManager: { getEntries: () => [] },\\n51\\t  };\\n52\\t}\\n53\\t\\n54\\tdescribe(\\\"Story 1: instance lifecycle\\\", () => {\\n55\\t  it(\\\"TC-1.1: a no-flag session_start (production defaults) creates one cwd/title thread and one background instance\\\", async () => {\\n56\\t    const cwd = \\\"/work/tc-1-1\\\";\\n57\\t    // Only environment overrides are injected; buildSdkConfig and selectThread\\n58\\t    // use the real production defaults, so this exercises the activate path's\\n59\\t    // lifecycle, not a placeholder branch.\\n60\\t    const connector = createConnector({\\n61\\t      registryPath: store.registryPath,\\n62\\t      newThreadFilePath: () => store.threadPath(),\\n63\\t      parseLaunch: () => ({}),\\n64\\t    });\\n65\\t\\n66\\t    await connector.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n67\\t\\n68\\t    // A real instance was constructed in background scheduler mode (no\\n69\\t    // fail-closed early return).\\n70\\t    const instance = connector.getInstance();\\n71\\t    expect(instance).not.toBeNull();\\n72\\t    expect(instance?.sdk.config.mode).toBe(\\\"background\\\");\\n73\\t\\n74\\t    const state = connector.getState();\\n75\\t    expect(state).not.toBeNull();\\n76\\t    if (state === null) return;\\n77\\t\\n78\\t    // Exactly one thread, registered with BOTH cwd and title metadata (A-8 / TC-1.1).\\n79\\t    const all = await threads.listThreads({ registryPath: store.registryPath });\\n80\\t    expect(all.ok).toBe(true);\\n81\\t    if (all.ok) expect(all.value).toHaveLength(1);\\n82\\t\\n83\\t    const row = await threads.resolve({\\n84\\t      threadId: idOf(state.threadRef),\\n85\\t      registryPath: store.registryPath,\\n86\\t    });\\n87\\t    expect(row.ok).toBe(true);\\n88\\t    if (!row.ok) return;\\n89\\t    expect(row.value.cwd).toBe(cwd);\\n90\\t    expect(row.value.title).toBe(defaultThreadTitle(cwd)); // \\\"tc-1-1\\\"\\n91\\t    expect(existsSync(row.value.filePath)).toBe(true);\\n92\\t\\n93\\t    // Observe-only: the connector did not capture or drive the derivation queue\\n94\\t    // on start (capture is Story 2) — the instance only auto-drains in the\\n95\\t    // background, which has nothing to do here.\\n96\\t    const overview = await inspect.overview(state.threadRef);\\n97\\t    expect(overview.ok).toBe(true);\\n98\\t    if (overview.ok) expect(overview.value.events.count).toBe(0);\\n99\\t\\n100\\t    // Shutdown disposes the live instance.\\n101\\t    await connector.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\"shutdown\\\" });\\n102\\t    expect(connector.getInstance()).toBeNull();\\n103\\t  });\\n104\\t\\n105\\t  it(\\\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\\\", async () => {\\n106\\t    const resolved = await resolveThread(\\n107\\t      {},\\n108\\t      { cwd: \\\"/work/tc-1-4\\\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\\n109\\t    );\\n110\\t    expect(resolved.ok).toBe(true);\\n111\\t    if (!resolved.ok) return;\\n112\\t    const threadId = idOf(resolved.value);\\n113\\t\\n114\\t    const built = await initInstance(resolved.value, backgroundConfig());\\n115\\t    expect(built.ok).toBe(true);\\n116\\t    if (!built.ok) return;\\n117\\t\\n118\\t    // Capture N raw intake events through the instance (the converter is Story 2;\\n119\\t    // the lifecycle proof needs only that recorded events survive shutdown).\\n120\\t    const batch = eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]);\\n121\\t    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\\n122\\t    expect(captured.ok).toBe(true);\\n123\\t\\n124\\t    // Dispose with flush.\\n125\\t    const disposed = await disposeInstance(built.value);\\n126\\t    expect(disposed.ok).toBe(true);\\n127\\t\\n128\\t    // Reattach: resolve the same thread by id (no retained instance) and read\\n129\\t    // back — every pre-shutdown event is present, no trailing loss.\\n130\\t    const reattached = await resolveThread(\\n131\\t      { session: threadId },\\n132\\t      { cwd: \\\"/work/tc-1-4\\\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\\n133\\t    );\\n134\\t    expect(reattached.ok).toBe(true);\\n135\\t    if (!reattached.ok) return;\\n136\\t\\n137\\t    const overview = await inspect.overview(reattached.value);\\n138\\t    expect(overview.ok).toBe(true);\\n139\\t    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\\n140\\t  });\\n141\\t});\\n142\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"1890c09a-3581-4784-8b02-264c95c858ff\",\"timestamp\":\"2026-06-14T05:27:08.072Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/instance.test.ts\",\"content\":\"// Story 1 — instance lifecycle. TC-1.1 drives the PRODUCTION connector path:\\n// createConnector with only environment overrides (temp registry/thread-file,\\n// scripted launch) and the REAL default SDK config + selector — proving\\n// session_start resolves, creates a cwd/title-registered thread, and initializes\\n// one background instance with no placeholder injection. TC-1.4 proves shutdown\\n// flush + reattach at the instance level (Story 1 does not capture through hooks\\n// yet, so events are written directly through the instance). Real temp\\n// registry/thread throughout (the store is never mocked).\\nimport { existsSync } from \\\"node:fs\\\";\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createDeterministicProvider,\\n  inspect,\\n  threads,\\n  type SdkConfig,\\n  type ThreadRef,\\n} from \\\"lhc\\\";\\nimport { createConnector, resetSessionThreadMemory } from \\\"../../src/index.js\\\";\\nimport { disposeInstance, initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\nimport { defaultThreadTitle, resolveThread } from \\\"../../src/lifecycle/thread-resolution.js\\\";\\nimport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\nimport { eventBatch, makeSessionStart } from \\\"../fixtures/synthetic.js\\\";\\nimport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n\\nlet store: TempStore;\\nbeforeEach(() => {\\n  store = tempStore();\\n  resetSessionThreadMemory();\\n});\\nafterEach(() => {\\n  store.cleanup();\\n});\\n\\nfunction backgroundConfig(): SdkConfig {\\n  return { provider: createDeterministicProvider(), mode: \\\"background\\\" };\\n}\\n\\nfunction idOf(ref: ThreadRef): string {\\n  if (!(\\\"threadId\\\" in ref)) throw new Error(\\\"expected a { threadId } ref\\\");\\n  return ref.threadId;\\n}\\n\\n// A per-hook ctx carrying methods (not plain data), like PI hands each hook.\\nfunction syntheticCtx(cwd: string): ExtensionContext {\\n  return {\\n    cwd,\\n    hasUI: false,\\n    modelRegistry: { find: () => undefined, hasConfiguredAuth: () => false, getAvailable: () => [] },\\n    ui: { notify: () => {} },\\n    sessionManager: { getEntries: () => [] },\\n  };\\n}\\n\\ndescribe(\\\"Story 1: instance lifecycle\\\", () => {\\n  it(\\\"TC-1.1: a no-flag session_start (production defaults) creates one cwd/title thread and one background instance\\\", async () => {\\n    const cwd = \\\"/work/tc-1-1\\\";\\n    // Only environment overrides are injected; buildSdkConfig and selectThread\\n    // use the real production defaults, so this exercises the activate path's\\n    // lifecycle, not a placeholder branch.\\n    const connector = createConnector({\\n      registryPath: store.registryPath,\\n      newThreadFilePath: () => store.threadPath(),\\n      parseLaunch: () => ({}),\\n    });\\n\\n    await connector.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n\\n    // A real instance was constructed in background scheduler mode (no\\n    // fail-closed early return).\\n    const instance = connector.getInstance();\\n    expect(instance).not.toBeNull();\\n    expect(instance?.sdk.config.mode).toBe(\\\"background\\\");\\n\\n    const state = connector.getState();\\n    expect(state).not.toBeNull();\\n    if (state === null) return;\\n\\n    // Exactly one thread, registered with BOTH cwd and title metadata (A-8 / TC-1.1).\\n    const all = await threads.listThreads({ registryPath: store.registryPath });\\n    expect(all.ok).toBe(true);\\n    if (all.ok) expect(all.value).toHaveLength(1);\\n\\n    const row = await threads.resolve({\\n      threadId: idOf(state.threadRef),\\n      registryPath: store.registryPath,\\n    });\\n    expect(row.ok).toBe(true);\\n    if (!row.ok) return;\\n    expect(row.value.cwd).toBe(cwd);\\n    expect(row.value.title).toBe(defaultThreadTitle(cwd)); // \\\"tc-1-1\\\"\\n    expect(existsSync(row.value.filePath)).toBe(true);\\n\\n    // Observe-only: the connector did not capture or drive the derivation queue\\n    // on start (capture is Story 2) — the instance only auto-drains in the\\n    // background, which has nothing to do here.\\n    const overview = await inspect.overview(state.threadRef);\\n    expect(overview.ok).toBe(true);\\n    if (overview.ok) expect(overview.value.events.count).toBe(0);\\n\\n    // Shutdown disposes the live instance.\\n    await connector.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\"shutdown\\\" });\\n    expect(connector.getInstance()).toBeNull();\\n  });\\n\\n  it(\\\"TC-1.4: shutdown disposes with flush; re-resolving the thread reads every pre-shutdown event\\\", async () => {\\n    const resolved = await resolveThread(\\n      {},\\n      { cwd: \\\"/work/tc-1-4\\\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\\n    );\\n    expect(resolved.ok).toBe(true);\\n    if (!resolved.ok) return;\\n    const threadId = idOf(resolved.value);\\n\\n    const built = await initInstance(resolved.value, backgroundConfig());\\n    expect(built.ok).toBe(true);\\n    if (!built.ok) return;\\n\\n    // Capture N raw intake events through the instance (the converter is Story 2;\\n    // the lifecycle proof needs only that recorded events survive shutdown).\\n    const batch = eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]);\\n    const captured = await built.value.sdk.intakeStream.messageEvents(built.value.threadRef, batch);\\n    expect(captured.ok).toBe(true);\\n\\n    // Dispose with flush.\\n    const disposed = await disposeInstance(built.value);\\n    expect(disposed.ok).toBe(true);\\n\\n    // Reattach: resolve the same thread by id (no retained instance) and read\\n    // back — every pre-shutdown event is present, no trailing loss.\\n    const reattached = await resolveThread(\\n      { session: threadId },\\n      { cwd: \\\"/work/tc-1-4\\\", registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() },\\n    );\\n    expect(reattached.ok).toBe(true);\\n    if (!reattached.ok) return;\\n\\n    const overview = await inspect.overview(reattached.value);\\n    expect(overview.ok).toBe(true);\\n    if (overview.ok) expect(overview.value.events.count).toBe(batch.length);\\n  });\\n});\\n\",\"numLines\":142,\"startLine\":1,\"totalLines\":142}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:544:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01PipoZgmBF7jaz45X7Qsggs\",\"type\":\"tool_result\",\"content\":\"1\\t// Story 1 — launch-driven thread resolution, plain-data state, and reload\\n2\\t// reconstruction. Two layers are covered: the resolver/picker functions\\n3\\t// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\\n4\\t// PRODUCTION connector path through createConnector with real defaults (no\\n5\\t// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\\n6\\t// throughout; the module-level reload memory is reset per test.\\n7\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n8\\timport {\\n9\\t  createDeterministicProvider,\\n10\\t  inspect,\\n11\\t  threads,\\n12\\t  type SdkConfig,\\n13\\t  type ThreadRef,\\n14\\t} from \\\"lhc\\\";\\n15\\timport { createConnector, resetSessionThreadMemory } from \\\"../../src/index.js\\\";\\n16\\timport { disposeInstance, initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\n17\\timport {\\n18\\t  defaultThreadTitle,\\n19\\t  parseLaunchFlags,\\n20\\t  resolveThread,\\n21\\t  type ResolveDeps,\\n22\\t} from \\\"../../src/lifecycle/thread-resolution.js\\\";\\n23\\timport { pickThread, type ThreadChoice } from \\\"../../src/lifecycle/picker.js\\\";\\n24\\timport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\n25\\timport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\"../fixtures/synthetic.js\\\";\\n26\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n27\\t\\n28\\tlet store: TempStore;\\n29\\tbeforeEach(() => {\\n30\\t  store = tempStore();\\n31\\t  resetSessionThreadMemory(); // the connector's reload memory is module-level\\n32\\t});\\n33\\tafterEach(() => {\\n34\\t  store.cleanup();\\n35\\t});\\n36\\t\\n37\\tfunction backgroundConfig(): SdkConfig {\\n38\\t  return { provider: createDeterministicProvider(), mode: \\\"background\\\" };\\n39\\t}\\n40\\t\\n41\\tfunction idOf(ref: ThreadRef): string {\\n42\\t  if (!(\\\"threadId\\\" in ref)) throw new Error(\\\"expected a { threadId } ref\\\");\\n43\\t  return ref.threadId;\\n44\\t}\\n45\\t\\n46\\tfunction deps(cwd = \\\"/work/default\\\"): ResolveDeps {\\n47\\t  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\n48\\t}\\n49\\t\\n50\\t// Create a thread directly with explicit cwd/title, for picker fixtures and\\n51\\t// existing-thread setup. (Connector-created threads get cwd plus a default title\\n52\\t// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\\n53\\tasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\\n54\\t  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\\n55\\t    filePath: store.threadPath(),\\n56\\t    registryPath: store.registryPath,\\n57\\t  };\\n58\\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\n59\\t  if (opts.title !== undefined) input.title = opts.title;\\n60\\t  const created = await threads.newThread(input);\\n61\\t  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\\n62\\t  return created.value.threadId;\\n63\\t}\\n64\\t\\n65\\t// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\\n66\\t// ctx would break the structuredClone plain-data guard. Each call is a distinct\\n67\\t// object, modelling PI handing a fresh ctx to each hook.\\n68\\tfunction syntheticCtx(cwd: string): ExtensionContext {\\n69\\t  return {\\n70\\t    cwd,\\n71\\t    hasUI: false,\\n72\\t    modelRegistry: {\\n73\\t      find: () => undefined,\\n74\\t      hasConfiguredAuth: () => false,\\n75\\t      getAvailable: () => [],\\n76\\t    },\\n77\\t    ui: { notify: () => {} },\\n78\\t    sessionManager: { getEntries: () => [] },\\n79\\t  };\\n80\\t}\\n81\\t\\n82\\t// A connector wired with production defaults (real SDK config + selector) and\\n83\\t// only environment overrides — the activate() path, minus the global registry\\n84\\t// and process.argv.\\n85\\tfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\\n86\\t  return createConnector({\\n87\\t    registryPath: store.registryPath,\\n88\\t    newThreadFilePath: () => store.threadPath(),\\n89\\t    parseLaunch: launch,\\n90\\t  });\\n91\\t}\\n92\\t\\n93\\tasync function threadCount(): Promise<number> {\\n94\\t  const listed = await threads.listThreads({ registryPath: store.registryPath });\\n95\\t  return listed.ok ? listed.value.length : -1;\\n96\\t}\\n97\\t\\n98\\tdescribe(\\\"Story 1: launch-driven thread resolution (resolver/picker)\\\", () => {\\n99\\t  it(\\\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\\\", async () => {\\n100\\t    // no flag → a new thread\\n101\\t    const first = await resolveThread({}, deps());\\n102\\t    expect(first.ok).toBe(true);\\n103\\t    if (!first.ok) return;\\n104\\t    const firstId = idOf(first.value);\\n105\\t\\n106\\t    // --session full id → the same thread\\n107\\t    const byFull = await resolveThread({ session: firstId }, deps());\\n108\\t    expect(byFull.ok).toBe(true);\\n109\\t    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\\n110\\t\\n111\\t    // --session partial id → the same thread\\n112\\t    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\\n113\\t    expect(byPartial.ok).toBe(true);\\n114\\t    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\\n115\\t\\n116\\t    // a second thread, then --continue → the most recently created\\n117\\t    const second = await resolveThread({}, deps());\\n118\\t    expect(second.ok).toBe(true);\\n119\\t    if (!second.ok) return;\\n120\\t    const secondId = idOf(second.value);\\n121\\t    const continued = await resolveThread({ continue: true }, deps());\\n122\\t    expect(continued.ok).toBe(true);\\n123\\t    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\\n124\\t\\n125\\t    // unresolvable id → actionable error, no thread created\\n126\\t    const before = await threadCount();\\n127\\t    const bad = await resolveThread({ session: \\\"th_zzzzzzzzzzzzzzzz\\\" }, deps());\\n128\\t    expect(bad.ok).toBe(false);\\n129\\t    if (!bad.ok) expect(bad.error.code).toBe(\\\"thread_not_found\\\");\\n130\\t    expect(await threadCount()).toBe(before);\\n131\\t\\n132\\t    // ambiguous prefix (matches both threads) → actionable error, no thread created\\n133\\t    const ambiguous = await resolveThread({ session: \\\"th_\\\" }, deps());\\n134\\t    expect(ambiguous.ok).toBe(false);\\n135\\t    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\\\"ambiguous_thread_id\\\");\\n136\\t    expect(await threadCount()).toBe(before);\\n137\\t  });\\n138\\t\\n139\\t  it(\\\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\\\", () => {\\n140\\t    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\"])).toEqual({});\\n141\\t    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--resume\\\"])).toEqual({ resume: true });\\n142\\t    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"-r\\\"])).toEqual({ resume: true });\\n143\\t    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--continue\\\"])).toEqual({ continue: true });\\n144\\t    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"-c\\\"])).toEqual({ continue: true });\\n145\\t    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--session\\\", \\\"th_abc\\\"])).toEqual({ session: \\\"th_abc\\\" });\\n146\\t    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--session=th_xyz\\\"])).toEqual({ session: \\\"th_xyz\\\" });\\n147\\t  });\\n148\\t\\n149\\t  it(\\\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\\\", async () => {\\n150\\t    const created = await resolveThread({}, deps(\\\"/work/proj-x\\\"));\\n151\\t    expect(created.ok).toBe(true);\\n152\\t    if (!created.ok) return;\\n153\\t    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\\n154\\t    expect(row.ok).toBe(true);\\n155\\t    if (!row.ok) return;\\n156\\t    expect(row.value.cwd).toBe(\\\"/work/proj-x\\\");\\n157\\t    expect(row.value.title).toBe(defaultThreadTitle(\\\"/work/proj-x\\\")); // \\\"proj-x\\\"\\n158\\t  });\\n159\\t\\n160\\t  it(\\\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\\\", async () => {\\n161\\t    const a1 = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"alpha\\\" });\\n162\\t    const a2 = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"beta\\\" });\\n163\\t    await makeThread({ cwd: \\\"/work/b\\\", title: \\\"other-cwd\\\" });\\n164\\t\\n165\\t    let offered: readonly ThreadChoice[] = [];\\n166\\t    const picked = await pickThread(\\\"/work/a\\\", {\\n167\\t      registryPath: store.registryPath,\\n168\\t      select: (choices) => {\\n169\\t        offered = choices;\\n170\\t        return Promise.resolve(choices[0]!.threadId);\\n171\\t      },\\n172\\t    });\\n173\\t    expect(picked.ok).toBe(true);\\n174\\t\\n175\\t    // Only the current cwd's threads are offered, each with title + creation time.\\n176\\t    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\\n177\\t    for (const choice of offered) {\\n178\\t      expect(choice.createdAt).toBeTruthy();\\n179\\t      expect(choice.title).toBeTruthy();\\n180\\t    }\\n181\\t\\n182\\t    // The operator's selection resolves to that thread.\\n183\\t    if (picked.ok && picked.value !== null) {\\n184\\t      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\\n185\\t    }\\n186\\t\\n187\\t    // An empty cwd reports an empty list (null) without failing or prompting.\\n188\\t    let selectCalled = false;\\n189\\t    const empty = await pickThread(\\\"/work/empty\\\", {\\n190\\t      registryPath: store.registryPath,\\n191\\t      select: () => {\\n192\\t        selectCalled = true;\\n193\\t        return Promise.resolve(null);\\n194\\t      },\\n195\\t    });\\n196\\t    expect(empty.ok).toBe(true);\\n197\\t    if (empty.ok) expect(empty.value).toBeNull();\\n198\\t    expect(selectCalled).toBe(false);\\n199\\t  });\\n200\\t\\n201\\t  it(\\\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\\\", async () => {\\n202\\t    const cwd = \\\"/work/tc-1-5\\\";\\n203\\t    const created = await resolveThread({}, deps(cwd));\\n204\\t    expect(created.ok).toBe(true);\\n205\\t    if (!created.ok) return;\\n206\\t    const threadId = idOf(created.value);\\n207\\t\\n208\\t    const first = await initInstance(created.value, backgroundConfig());\\n209\\t    expect(first.ok).toBe(true);\\n210\\t    if (!first.ok) return;\\n211\\t    await first.value.sdk.intakeStream.messageEvents(\\n212\\t      first.value.threadRef,\\n213\\t      eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]),\\n214\\t    );\\n215\\t    await disposeInstance(first.value);\\n216\\t\\n217\\t    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\\n218\\t    // flag would across process death). Reconstruct purely from it.\\n219\\t    const reattached = await resolveThread({ session: threadId }, deps(cwd));\\n220\\t    expect(reattached.ok).toBe(true);\\n221\\t    if (!reattached.ok) return;\\n222\\t    expect(idOf(reattached.value)).toBe(threadId);\\n223\\t\\n224\\t    const rebuilt = await initInstance(reattached.value, backgroundConfig());\\n225\\t    expect(rebuilt.ok).toBe(true);\\n226\\t    if (!rebuilt.ok) return;\\n227\\t    await rebuilt.value.sdk.intakeStream.messageEvents(\\n228\\t      rebuilt.value.threadRef,\\n229\\t      eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]),\\n230\\t    );\\n231\\t    const overview = await inspect.overview(reattached.value);\\n232\\t    expect(overview.ok).toBe(true);\\n233\\t    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\\n234\\t    await disposeInstance(rebuilt.value);\\n235\\t  });\\n236\\t});\\n237\\t\\n238\\tdescribe(\\\"Story 1: launch-driven thread resolution (production connector path)\\\", () => {\\n239\\t  it(\\\"TC-1.2: session_start resolving an existing thread creates no second thread\\\", async () => {\\n240\\t    const existingId = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"existing\\\" });\\n241\\t    const before = await threadCount();\\n242\\t\\n243\\t    const connector = productionConnector(() => ({ session: existingId }));\\n244\\t    await connector.handlers.session_start(syntheticCtx(\\\"/work/a\\\"), makeSessionStart(\\\"startup\\\"));\\n245\\t\\n246\\t    const state = connector.getState();\\n247\\t    expect(state).not.toBeNull();\\n248\\t    if (state === null) return;\\n249\\t    expect(idOf(state.threadRef)).toBe(existingId);\\n250\\t    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\\n251\\t    expect(await threadCount()).toBe(before); // no second thread\\n252\\t  });\\n253\\t\\n254\\t  it(\\\"TC-1.7: session_start --resume resumes the most recent cwd-scoped thread via the default selector\\\", async () => {\\n255\\t    await makeThread({ cwd: \\\"/work/resume\\\", title: \\\"older\\\" });\\n256\\t    const recent = await makeThread({ cwd: \\\"/work/resume\\\", title: \\\"newer\\\" });\\n257\\t    await makeThread({ cwd: \\\"/work/other\\\", title: \\\"different cwd\\\" });\\n258\\t    const before = await threadCount();\\n259\\t\\n260\\t    const connector = productionConnector(() => ({ resume: true }));\\n261\\t    await connector.handlers.session_start(syntheticCtx(\\\"/work/resume\\\"), makeSessionStart(\\\"resume\\\"));\\n262\\t\\n263\\t    const state = connector.getState();\\n264\\t    expect(state).not.toBeNull();\\n265\\t    if (state === null) return;\\n266\\t    expect(idOf(state.threadRef)).toBe(recent); // most recent in the cwd (default selection)\\n267\\t    expect(connector.getInstance()).not.toBeNull();\\n268\\t    expect(await threadCount()).toBe(before); // resumed, not created\\n269\\t  });\\n270\\t});\\n271\\t\\n272\\tdescribe(\\\"Story 1: plain-data state across hooks\\\", () => {\\n273\\t  it(\\\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\\\", async () => {\\n274\\t    const connector = productionConnector(() => ({})); // no flag → new thread, default config\\n275\\t\\n276\\t    // session_start with a ctx carrying methods.\\n277\\t    await connector.handlers.session_start(syntheticCtx(\\\"/work/a\\\"), makeSessionStart(\\\"new\\\"));\\n278\\t    expect(connector.getState()).not.toBeNull();\\n279\\t    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\\n280\\t    // ...but the snapshot is plain data only — it survives structuredClone even\\n281\\t    // though the live ctx and instance carry methods (they are not in it).\\n282\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n283\\t    const threadRefBefore = connector.getState()?.threadRef;\\n284\\t\\n285\\t    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\n286\\t    // holder still references no prior ctx.\\n287\\t    await connector.handlers.message_end(\\n288\\t      syntheticCtx(\\\"/work/a\\\"),\\n289\\t      makeMessageEnd(makeUserMessage(\\\"hi\\\")),\\n290\\t    );\\n291\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n292\\t    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\n293\\t  });\\n294\\t});\\n295\\t\\n296\\tdescribe(\\\"Story 1: reload reconstruction after teardown (AC-1.5)\\\", () => {\\n297\\t  it(\\\"TC-1.5: a FRESH connector reconstructs the same thread from durable state, with no launch flag and no duplicate\\\", async () => {\\n298\\t    const cwd = \\\"/work/reload\\\";\\n299\\t\\n300\\t    // Connector A: a no-flag session creates the thread and records its durable\\n301\\t    // id (in module-level memory, not the connector closure).\\n302\\t    const connectorA = productionConnector(() => ({}));\\n303\\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n304\\t    const stateA = connectorA.getState();\\n305\\t    expect(stateA).not.toBeNull();\\n306\\t    if (stateA === null) return;\\n307\\t    const firstId = idOf(stateA.threadRef);\\n308\\t    const countAfterNew = await threadCount();\\n309\\t\\n310\\t    // The connector-created thread carries cwd + a default title (A-8 / SV-003).\\n311\\t    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\\n312\\t    expect(row.ok).toBe(true);\\n313\\t    if (row.ok) {\\n314\\t      expect(row.value.cwd).toBe(cwd);\\n315\\t      expect(row.value.title).toBe(defaultThreadTitle(cwd));\\n316\\t    }\\n317\\t\\n318\\t    // Reload: shutdown{reload}, then connector A is TORN DOWN (never referenced\\n319\\t    // again). A brand-new connector handles the reload — its closure holds no\\n320\\t    // prior id, and the launch is still no-flag (which would otherwise create a\\n321\\t    // new thread).\\n322\\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\"reload\\\" });\\n323\\t\\n324\\t    const connectorB = productionConnector(() => ({}));\\n325\\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"reload\\\"));\\n326\\t\\n327\\t    const stateB = connectorB.getState();\\n328\\t    expect(stateB).not.toBeNull();\\n329\\t    if (stateB === null) return;\\n330\\t    expect(idOf(stateB.threadRef)).toBe(firstId); // reconstructed from durable state\\n331\\t    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\n332\\t    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\n333\\t  });\\n334\\t\\n335\\t  it(\\\"a non-reload teardown clears the durable memory so the next no-flag session is a NEW thread\\\", async () => {\\n336\\t    const cwd = \\\"/work/fresh\\\";\\n337\\t    const connectorA = productionConnector(() => ({}));\\n338\\t    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n339\\t    const firstId = idOf(connectorA.getState()!.threadRef);\\n340\\t\\n341\\t    // A normal shutdown (not reload) ends the session and clears the memory.\\n342\\t    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\"shutdown\\\" });\\n343\\t\\n344\\t    const connectorB = productionConnector(() => ({}));\\n345\\t    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n346\\t    const secondId = idOf(connectorB.getState()!.threadRef);\\n347\\t\\n348\\t    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\\n349\\t    expect(await threadCount()).toBe(2);\\n350\\t  });\\n351\\t});\\n352\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"e786eb72-a49c-49bb-b756-41157542298e\",\"timestamp\":\"2026-06-14T05:27:08.367Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/lifecycle/thread-resolution.test.ts\",\"content\":\"// Story 1 — launch-driven thread resolution, plain-data state, and reload\\n// reconstruction. Two layers are covered: the resolver/picker functions\\n// directly (launch modes, partial-id, ambiguity, cwd-scoping), and the\\n// PRODUCTION connector path through createConnector with real defaults (no\\n// injected SDK config or selector) for AC-1.2/1.5/1.7. Real temp registry\\n// throughout; the module-level reload memory is reset per test.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createDeterministicProvider,\\n  inspect,\\n  threads,\\n  type SdkConfig,\\n  type ThreadRef,\\n} from \\\"lhc\\\";\\nimport { createConnector, resetSessionThreadMemory } from \\\"../../src/index.js\\\";\\nimport { disposeInstance, initInstance } from \\\"../../src/lifecycle/instance.js\\\";\\nimport {\\n  defaultThreadTitle,\\n  parseLaunchFlags,\\n  resolveThread,\\n  type ResolveDeps,\\n} from \\\"../../src/lifecycle/thread-resolution.js\\\";\\nimport { pickThread, type ThreadChoice } from \\\"../../src/lifecycle/picker.js\\\";\\nimport type { ExtensionContext } from \\\"../../src/pi/types.js\\\";\\nimport { eventBatch, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\"../fixtures/synthetic.js\\\";\\nimport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n\\nlet store: TempStore;\\nbeforeEach(() => {\\n  store = tempStore();\\n  resetSessionThreadMemory(); // the connector's reload memory is module-level\\n});\\nafterEach(() => {\\n  store.cleanup();\\n});\\n\\nfunction backgroundConfig(): SdkConfig {\\n  return { provider: createDeterministicProvider(), mode: \\\"background\\\" };\\n}\\n\\nfunction idOf(ref: ThreadRef): string {\\n  if (!(\\\"threadId\\\" in ref)) throw new Error(\\\"expected a { threadId } ref\\\");\\n  return ref.threadId;\\n}\\n\\nfunction deps(cwd = \\\"/work/default\\\"): ResolveDeps {\\n  return { cwd, registryPath: store.registryPath, newThreadFilePath: () => store.threadPath() };\\n}\\n\\n// Create a thread directly with explicit cwd/title, for picker fixtures and\\n// existing-thread setup. (Connector-created threads get cwd plus a default title\\n// from defaultThreadTitle(cwd) — see TC-1.1 and the reload test.)\\nasync function makeThread(opts: { cwd?: string; title?: string } = {}): Promise<string> {\\n  const input: { filePath: string; registryPath: string; cwd?: string; title?: string } = {\\n    filePath: store.threadPath(),\\n    registryPath: store.registryPath,\\n  };\\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\n  if (opts.title !== undefined) input.title = opts.title;\\n  const created = await threads.newThread(input);\\n  if (!created.ok) throw new Error(`makeThread failed: ${created.error.reason}`);\\n  return created.value.threadId;\\n}\\n\\n// A synthetic per-hook ctx carrying METHODS (not plain data) — so a retained\\n// ctx would break the structuredClone plain-data guard. Each call is a distinct\\n// object, modelling PI handing a fresh ctx to each hook.\\nfunction syntheticCtx(cwd: string): ExtensionContext {\\n  return {\\n    cwd,\\n    hasUI: false,\\n    modelRegistry: {\\n      find: () => undefined,\\n      hasConfiguredAuth: () => false,\\n      getAvailable: () => [],\\n    },\\n    ui: { notify: () => {} },\\n    sessionManager: { getEntries: () => [] },\\n  };\\n}\\n\\n// A connector wired with production defaults (real SDK config + selector) and\\n// only environment overrides — the activate() path, minus the global registry\\n// and process.argv.\\nfunction productionConnector(launch: () => { resume?: boolean; continue?: boolean; session?: string }) {\\n  return createConnector({\\n    registryPath: store.registryPath,\\n    newThreadFilePath: () => store.threadPath(),\\n    parseLaunch: launch,\\n  });\\n}\\n\\nasync function threadCount(): Promise<number> {\\n  const listed = await threads.listThreads({ registryPath: store.registryPath });\\n  return listed.ok ? listed.value.length : -1;\\n}\\n\\ndescribe(\\\"Story 1: launch-driven thread resolution (resolver/picker)\\\", () => {\\n  it(\\\"TC-1.6: launch modes resolve correctly; bad/ambiguous id fails loud and creates no thread\\\", async () => {\\n    // no flag → a new thread\\n    const first = await resolveThread({}, deps());\\n    expect(first.ok).toBe(true);\\n    if (!first.ok) return;\\n    const firstId = idOf(first.value);\\n\\n    // --session full id → the same thread\\n    const byFull = await resolveThread({ session: firstId }, deps());\\n    expect(byFull.ok).toBe(true);\\n    if (byFull.ok) expect(idOf(byFull.value)).toBe(firstId);\\n\\n    // --session partial id → the same thread\\n    const byPartial = await resolveThread({ session: firstId.slice(0, 8) }, deps());\\n    expect(byPartial.ok).toBe(true);\\n    if (byPartial.ok) expect(idOf(byPartial.value)).toBe(firstId);\\n\\n    // a second thread, then --continue → the most recently created\\n    const second = await resolveThread({}, deps());\\n    expect(second.ok).toBe(true);\\n    if (!second.ok) return;\\n    const secondId = idOf(second.value);\\n    const continued = await resolveThread({ continue: true }, deps());\\n    expect(continued.ok).toBe(true);\\n    if (continued.ok) expect(idOf(continued.value)).toBe(secondId);\\n\\n    // unresolvable id → actionable error, no thread created\\n    const before = await threadCount();\\n    const bad = await resolveThread({ session: \\\"th_zzzzzzzzzzzzzzzz\\\" }, deps());\\n    expect(bad.ok).toBe(false);\\n    if (!bad.ok) expect(bad.error.code).toBe(\\\"thread_not_found\\\");\\n    expect(await threadCount()).toBe(before);\\n\\n    // ambiguous prefix (matches both threads) → actionable error, no thread created\\n    const ambiguous = await resolveThread({ session: \\\"th_\\\" }, deps());\\n    expect(ambiguous.ok).toBe(false);\\n    if (!ambiguous.ok) expect(ambiguous.error.code).toBe(\\\"ambiguous_thread_id\\\");\\n    expect(await threadCount()).toBe(before);\\n  });\\n\\n  it(\\\"parseLaunchFlags maps the launch argv (the production launch source) to launch modes\\\", () => {\\n    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\"])).toEqual({});\\n    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--resume\\\"])).toEqual({ resume: true });\\n    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"-r\\\"])).toEqual({ resume: true });\\n    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--continue\\\"])).toEqual({ continue: true });\\n    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"-c\\\"])).toEqual({ continue: true });\\n    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--session\\\", \\\"th_abc\\\"])).toEqual({ session: \\\"th_abc\\\" });\\n    expect(parseLaunchFlags([\\\"node\\\", \\\"pi\\\", \\\"--session=th_xyz\\\"])).toEqual({ session: \\\"th_xyz\\\" });\\n  });\\n\\n  it(\\\"no-flag resolution titles the new thread with the cwd leaf (A-8 title metadata)\\\", async () => {\\n    const created = await resolveThread({}, deps(\\\"/work/proj-x\\\"));\\n    expect(created.ok).toBe(true);\\n    if (!created.ok) return;\\n    const row = await threads.resolve({ threadId: idOf(created.value), registryPath: store.registryPath });\\n    expect(row.ok).toBe(true);\\n    if (!row.ok) return;\\n    expect(row.value.cwd).toBe(\\\"/work/proj-x\\\");\\n    expect(row.value.title).toBe(defaultThreadTitle(\\\"/work/proj-x\\\")); // \\\"proj-x\\\"\\n  });\\n\\n  it(\\\"TC-1.7 (picker): lists cwd-scoped threads (title + created), resolves selection, empty-safe\\\", async () => {\\n    const a1 = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"alpha\\\" });\\n    const a2 = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"beta\\\" });\\n    await makeThread({ cwd: \\\"/work/b\\\", title: \\\"other-cwd\\\" });\\n\\n    let offered: readonly ThreadChoice[] = [];\\n    const picked = await pickThread(\\\"/work/a\\\", {\\n      registryPath: store.registryPath,\\n      select: (choices) => {\\n        offered = choices;\\n        return Promise.resolve(choices[0]!.threadId);\\n      },\\n    });\\n    expect(picked.ok).toBe(true);\\n\\n    // Only the current cwd's threads are offered, each with title + creation time.\\n    expect(new Set(offered.map((c) => c.threadId))).toEqual(new Set([a1, a2]));\\n    for (const choice of offered) {\\n      expect(choice.createdAt).toBeTruthy();\\n      expect(choice.title).toBeTruthy();\\n    }\\n\\n    // The operator's selection resolves to that thread.\\n    if (picked.ok && picked.value !== null) {\\n      expect(idOf(picked.value)).toBe(offered[0]!.threadId);\\n    }\\n\\n    // An empty cwd reports an empty list (null) without failing or prompting.\\n    let selectCalled = false;\\n    const empty = await pickThread(\\\"/work/empty\\\", {\\n      registryPath: store.registryPath,\\n      select: () => {\\n        selectCalled = true;\\n        return Promise.resolve(null);\\n      },\\n    });\\n    expect(empty.ok).toBe(true);\\n    if (empty.ok) expect(empty.value).toBeNull();\\n    expect(selectCalled).toBe(false);\\n  });\\n\\n  it(\\\"TC-1.5 (risk: restart): re-resolve the same thread by its durable id from the registry after process death\\\", async () => {\\n    const cwd = \\\"/work/tc-1-5\\\";\\n    const created = await resolveThread({}, deps(cwd));\\n    expect(created.ok).toBe(true);\\n    if (!created.ok) return;\\n    const threadId = idOf(created.value);\\n\\n    const first = await initInstance(created.value, backgroundConfig());\\n    expect(first.ok).toBe(true);\\n    if (!first.ok) return;\\n    await first.value.sdk.intakeStream.messageEvents(\\n      first.value.threadRef,\\n      eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]),\\n    );\\n    await disposeInstance(first.value);\\n\\n    // Discard ALL in-memory state. Only the durable id survives (as a relaunch\\n    // flag would across process death). Reconstruct purely from it.\\n    const reattached = await resolveThread({ session: threadId }, deps(cwd));\\n    expect(reattached.ok).toBe(true);\\n    if (!reattached.ok) return;\\n    expect(idOf(reattached.value)).toBe(threadId);\\n\\n    const rebuilt = await initInstance(reattached.value, backgroundConfig());\\n    expect(rebuilt.ok).toBe(true);\\n    if (!rebuilt.ok) return;\\n    await rebuilt.value.sdk.intakeStream.messageEvents(\\n      rebuilt.value.threadRef,\\n      eventBatch([\\\"user_prompt\\\", \\\"assistant_text\\\", \\\"turn_end\\\"]),\\n    );\\n    const overview = await inspect.overview(reattached.value);\\n    expect(overview.ok).toBe(true);\\n    if (overview.ok) expect(overview.value.events.count).toBe(6); // 3 before + 3 after\\n    await disposeInstance(rebuilt.value);\\n  });\\n});\\n\\ndescribe(\\\"Story 1: launch-driven thread resolution (production connector path)\\\", () => {\\n  it(\\\"TC-1.2: session_start resolving an existing thread creates no second thread\\\", async () => {\\n    const existingId = await makeThread({ cwd: \\\"/work/a\\\", title: \\\"existing\\\" });\\n    const before = await threadCount();\\n\\n    const connector = productionConnector(() => ({ session: existingId }));\\n    await connector.handlers.session_start(syntheticCtx(\\\"/work/a\\\"), makeSessionStart(\\\"startup\\\"));\\n\\n    const state = connector.getState();\\n    expect(state).not.toBeNull();\\n    if (state === null) return;\\n    expect(idOf(state.threadRef)).toBe(existingId);\\n    expect(connector.getInstance()).not.toBeNull(); // a real instance, not a fail-closed branch\\n    expect(await threadCount()).toBe(before); // no second thread\\n  });\\n\\n  it(\\\"TC-1.7: session_start --resume resumes the most recent cwd-scoped thread via the default selector\\\", async () => {\\n    await makeThread({ cwd: \\\"/work/resume\\\", title: \\\"older\\\" });\\n    const recent = await makeThread({ cwd: \\\"/work/resume\\\", title: \\\"newer\\\" });\\n    await makeThread({ cwd: \\\"/work/other\\\", title: \\\"different cwd\\\" });\\n    const before = await threadCount();\\n\\n    const connector = productionConnector(() => ({ resume: true }));\\n    await connector.handlers.session_start(syntheticCtx(\\\"/work/resume\\\"), makeSessionStart(\\\"resume\\\"));\\n\\n    const state = connector.getState();\\n    expect(state).not.toBeNull();\\n    if (state === null) return;\\n    expect(idOf(state.threadRef)).toBe(recent); // most recent in the cwd (default selection)\\n    expect(connector.getInstance()).not.toBeNull();\\n    expect(await threadCount()).toBe(before); // resumed, not created\\n  });\\n});\\n\\ndescribe(\\\"Story 1: plain-data state across hooks\\\", () => {\\n  it(\\\"TC-1.3: the connector retains only plain data and continues across a ctx replacement\\\", async () => {\\n    const connector = productionConnector(() => ({})); // no flag → new thread, default config\\n\\n    // session_start with a ctx carrying methods.\\n    await connector.handlers.session_start(syntheticCtx(\\\"/work/a\\\"), makeSessionStart(\\\"new\\\"));\\n    expect(connector.getState()).not.toBeNull();\\n    expect(connector.getInstance()).not.toBeNull(); // a live instance is held...\\n    // ...but the snapshot is plain data only — it survives structuredClone even\\n    // though the live ctx and instance carry methods (they are not in it).\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n    const threadRefBefore = connector.getState()?.threadRef;\\n\\n    // A later hook receives a DIFFERENT ctx object; capture is not broken and the\\n    // holder still references no prior ctx.\\n    await connector.handlers.message_end(\\n      syntheticCtx(\\\"/work/a\\\"),\\n      makeMessageEnd(makeUserMessage(\\\"hi\\\")),\\n    );\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n    expect(connector.getState()?.threadRef).toEqual(threadRefBefore); // same plain-data thread ref\\n  });\\n});\\n\\ndescribe(\\\"Story 1: reload reconstruction after teardown (AC-1.5)\\\", () => {\\n  it(\\\"TC-1.5: a FRESH connector reconstructs the same thread from durable state, with no launch flag and no duplicate\\\", async () => {\\n    const cwd = \\\"/work/reload\\\";\\n\\n    // Connector A: a no-flag session creates the thread and records its durable\\n    // id (in module-level memory, not the connector closure).\\n    const connectorA = productionConnector(() => ({}));\\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n    const stateA = connectorA.getState();\\n    expect(stateA).not.toBeNull();\\n    if (stateA === null) return;\\n    const firstId = idOf(stateA.threadRef);\\n    const countAfterNew = await threadCount();\\n\\n    // The connector-created thread carries cwd + a default title (A-8 / SV-003).\\n    const row = await threads.resolve({ threadId: firstId, registryPath: store.registryPath });\\n    expect(row.ok).toBe(true);\\n    if (row.ok) {\\n      expect(row.value.cwd).toBe(cwd);\\n      expect(row.value.title).toBe(defaultThreadTitle(cwd));\\n    }\\n\\n    // Reload: shutdown{reload}, then connector A is TORN DOWN (never referenced\\n    // again). A brand-new connector handles the reload — its closure holds no\\n    // prior id, and the launch is still no-flag (which would otherwise create a\\n    // new thread).\\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\"reload\\\" });\\n\\n    const connectorB = productionConnector(() => ({}));\\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"reload\\\"));\\n\\n    const stateB = connectorB.getState();\\n    expect(stateB).not.toBeNull();\\n    if (stateB === null) return;\\n    expect(idOf(stateB.threadRef)).toBe(firstId); // reconstructed from durable state\\n    expect(connectorB.getInstance()).not.toBeNull(); // a fresh instance on the same thread\\n    expect(await threadCount()).toBe(countAfterNew); // no duplicate thread created\\n  });\\n\\n  it(\\\"a non-reload teardown clears the durable memory so the next no-flag session is a NEW thread\\\", async () => {\\n    const cwd = \\\"/work/fresh\\\";\\n    const connectorA = productionConnector(() => ({}));\\n    await connectorA.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n    const firstId = idOf(connectorA.getState()!.threadRef);\\n\\n    // A normal shutdown (not reload) ends the session and clears the memory.\\n    await connectorA.handlers.session_shutdown(syntheticCtx(cwd), { reason: \\\"shutdown\\\" });\\n\\n    const connectorB = productionConnector(() => ({}));\\n    await connectorB.handlers.session_start(syntheticCtx(cwd), makeSessionStart(\\\"new\\\"));\\n    const secondId = idOf(connectorB.getState()!.threadRef);\\n\\n    expect(secondId).not.toBe(firstId); // a genuinely new session → a new thread\\n    expect(await threadCount()).toBe(2);\\n  });\\n});\\n\",\"numLines\":352,\"startLine\":1,\"totalLines\":352}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:579:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\".1 uses real production defaults (no injected config/selector) asserting cwd+title; TC-1.2/1.7 use\"}},\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"parent_tool_use_id\":null,\"uuid\":\"dd4b2a24-b957-468b-a291-625bcda5dcb7\"}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:581:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"-level memory. The failed resume sessions evidently wrote the fixes to disk before their envelopes failed. Now I must verify correctness,\"}},\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"parent_tool_use_id\":null,\"uuid\":\"5e6c2f08-98b0-4c14-a05f-325a45442dba\"}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:583:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_01DAE3zbsaGHcyYeRxLYyaJD\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"The on-disk **tests are also strong** and directly target all three findings: TC-1.1 uses real production defaults (no injected config/selector) asserting cwd+title; TC-1.2/1.7 use `productionConnector`; TC-1.5 tears down connector A and reconstructs with a fresh connector B from durable module-level memory. The failed resume sessions evidently wrote the fixes to disk before their envelopes failed. Now I must verify correctness, not assume it. Let me read the lhc A-8 changes and check the gate.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":131,\"cache_creation_input_tokens\":10935,\"cache_read_input_tokens\":111920,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":10935},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"c30224e7-eac1-4255-8b26-ca7b1ae3f99b\",\"request_id\":\"req_011Cc2bfDoRSfiimsvsamt8w\"}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:596:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01VCdxoXmbc32HM2rRDCfG3W\",\"type\":\"tool_result\",\"content\":\"1\\timport { existsSync } from \\\"node:fs\\\";\\n2\\timport { runWithThreadTouchSuppressed } from \\\"../../shared/context.js\\\";\\n3\\timport { storageFailure, type ErrorResult, type OpResult } from \\\"../../shared/errors.js\\\";\\n4\\timport {\\n5\\t  createThreadFile,\\n6\\t  deleteThreadFile,\\n7\\t  generateThreadId,\\n8\\t  openThreadDatabase,\\n9\\t} from \\\"./internal/create.js\\\";\\n10\\t\\n11\\t// Re-exported for the other domain surfaces: opening a thread file through\\n12\\t// the threads domain is what guarantees its schema is current (a pre-Story-3\\n13\\t// file gains the message tables here before any write or read touches them).\\n14\\texport { openThreadDatabase };\\n15\\timport {\\n16\\t  insertThreadRow,\\n17\\t  openRegistryForRead,\\n18\\t  openRegistryForWrite,\\n19\\t  resolveRegistryPath,\\n20\\t  selectAllThreadRows,\\n21\\t  selectThreadRow,\\n22\\t  selectThreadRowsByPrefix,\\n23\\t  type RegistryRow,\\n24\\t} from \\\"./internal/registry.js\\\";\\n25\\t\\n26\\texport type ThreadRef =\\n27\\t  | { threadId: string; registryPath?: string }\\n28\\t  | { filePath: string };\\n29\\t\\n30\\texport interface NewThreadInput {\\n31\\t  filePath: string;\\n32\\t  title?: string;\\n33\\t  cwd?: string;\\n34\\t  registryPath?: string;\\n35\\t}\\n36\\t\\n37\\texport interface ThreadInfo {\\n38\\t  threadId: string;\\n39\\t  filePath: string;\\n40\\t  title?: string;\\n41\\t  cwd?: string;\\n42\\t  createdAt: string; // ISO-8601\\n43\\t}\\n44\\t\\n45\\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\\n46\\t  const info: ThreadInfo = {\\n47\\t    threadId: row.threadId,\\n48\\t    filePath: row.filePath,\\n49\\t    createdAt: row.createdAt,\\n50\\t  };\\n51\\t  if (row.title !== undefined) info.title = row.title;\\n52\\t  if (row.cwd !== undefined) info.cwd = row.cwd;\\n53\\t  return info;\\n54\\t}\\n55\\t\\n56\\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\\n57\\t  return {\\n58\\t    ok: false,\\n59\\t    error: {\\n60\\t      errorClass: \\\"caller_error\\\",\\n61\\t      code: \\\"thread_not_found\\\",\\n62\\t      reason: `no thread registered with id ${threadId}`,\\n63\\t    },\\n64\\t  };\\n65\\t}\\n66\\t\\n67\\t// A partial id that matches more than one thread is a caller error, not a\\n68\\t// silent pick: resolution names the collision and the caller must disambiguate\\n69\\t// (AC-1.6 — an ambiguous id fails loud, never resolves arbitrarily).\\n70\\tfunction ambiguousThreadId(\\n71\\t  prefix: string,\\n72\\t  matchIds: readonly string[],\\n73\\t): { ok: false; error: ErrorResult } {\\n74\\t  return {\\n75\\t    ok: false,\\n76\\t    error: {\\n77\\t      errorClass: \\\"caller_error\\\",\\n78\\t      code: \\\"ambiguous_thread_id\\\",\\n79\\t      reason: `thread id \\\"${prefix}\\\" is ambiguous: it matches ${matchIds.length} threads (${matchIds.join(\\\", \\\")}); use a longer id`,\\n80\\t    },\\n81\\t  };\\n82\\t}\\n83\\t\\n84\\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\\n85\\t  return {\\n86\\t    ok: false,\\n87\\t    error: { errorClass: \\\"caller_error\\\", code: \\\"invalid_thread_ref\\\", reason },\\n88\\t  };\\n89\\t}\\n90\\t\\n91\\t// A file path that is empty or whitespace-only cannot name a durable file:\\n92\\t// node:sqlite's DatabaseSync(\\\"\\\") opens a temporary database that vanishes on\\n93\\t// close, so such a path must be refused as a caller error before any storage\\n94\\t// is touched rather than silently producing a thread with no durable file.\\n95\\tfunction isBlankPath(filePath: string): boolean {\\n96\\t  return filePath.trim() === \\\"\\\";\\n97\\t}\\n98\\t\\n99\\tfunction detail(cause: unknown): string {\\n100\\t  return cause instanceof Error ? cause.message : String(cause);\\n101\\t}\\n102\\t\\n103\\t// Creation spans two databases that cannot share a transaction. Order is\\n104\\t// file-then-row with compensation: the invariant \\\"no registry row without\\n105\\t// its file\\\" is absolute; an orphan file from a crash between the writes is\\n106\\t// documented harmless (design decision 2).\\n107\\texport async function newThread(\\n108\\t  input: NewThreadInput,\\n109\\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\\n110\\t  // Guard before any storage touch: an empty/blank path would otherwise open\\n111\\t  // a temp database and register a thread with no durable file (the no-row-\\n112\\t  // without-file invariant below depends on the path naming a real file).\\n113\\t  if (isBlankPath(input.filePath)) {\\n114\\t    return invalidThreadRef(\\\"filePath must be a non-empty path; received a blank string\\\");\\n115\\t  }\\n116\\t  if (existsSync(input.filePath)) {\\n117\\t    return {\\n118\\t      ok: false,\\n119\\t      error: {\\n120\\t        errorClass: \\\"caller_error\\\",\\n121\\t        code: \\\"path_exists\\\",\\n122\\t        reason: `a file already exists at ${input.filePath}`,\\n123\\t      },\\n124\\t    };\\n125\\t  }\\n126\\t\\n127\\t  const threadId = generateThreadId();\\n128\\t  const createdAt = new Date().toISOString();\\n129\\t\\n130\\t  try {\\n131\\t    createThreadFile(input.filePath, threadId, createdAt);\\n132\\t  } catch (cause) {\\n133\\t    deleteThreadFile(input.filePath);\\n134\\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\\n135\\t  }\\n136\\t\\n137\\t  let registry;\\n138\\t  try {\\n139\\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\\n140\\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\\n141\\t    if (input.title !== undefined) row.title = input.title;\\n142\\t    if (input.cwd !== undefined) row.cwd = input.cwd;\\n143\\t    insertThreadRow(registry, row);\\n144\\t  } catch (cause) {\\n145\\t    deleteThreadFile(input.filePath);\\n146\\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\\n147\\t  } finally {\\n148\\t    registry?.close();\\n149\\t  }\\n150\\t\\n151\\t  return { ok: true, value: { threadId, filePath: input.filePath } };\\n152\\t}\\n153\\t\\n154\\t// Resolution accepts a full or partial (prefix) thread id (A-8). An exact id\\n155\\t// wins outright — a full id always resolves to itself, even if it is also a\\n156\\t// prefix of a longer id — so only a genuinely partial id ever consults the\\n157\\t// prefix path; that path resolves a unique prefix, fails ambiguous on more than\\n158\\t// one match, and fails not-found on none. No path ever creates a thread.\\n159\\texport async function resolve(input: {\\n160\\t  threadId: string;\\n161\\t  registryPath?: string;\\n162\\t}): Promise<OpResult<ThreadInfo>> {\\n163\\t  let registry;\\n164\\t  try {\\n165\\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\\n166\\t    if (registry === null) return threadNotFound(input.threadId);\\n167\\t    const exact = selectThreadRow(registry, input.threadId);\\n168\\t    if (exact !== undefined) return { ok: true, value: toThreadInfo(exact) };\\n169\\t    const matches = selectThreadRowsByPrefix(registry, input.threadId);\\n170\\t    if (matches.length === 1) return { ok: true, value: toThreadInfo(matches[0]!) };\\n171\\t    if (matches.length > 1) {\\n172\\t      return ambiguousThreadId(\\n173\\t        input.threadId,\\n174\\t        matches.map((m) => m.threadId),\\n175\\t      );\\n176\\t    }\\n177\\t    return threadNotFound(input.threadId);\\n178\\t  } catch (cause) {\\n179\\t    return storageFailure(`registry read failed: ${detail(cause)}`);\\n180\\t  } finally {\\n181\\t    registry?.close();\\n182\\t  }\\n183\\t}\\n184\\t\\n185\\texport async function listThreads(input?: {\\n186\\t  cwd?: string;\\n187\\t  registryPath?: string;\\n188\\t}): Promise<OpResult<ThreadInfo[]>> {\\n189\\t  let registry;\\n190\\t  try {\\n191\\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\\n192\\t    if (registry === null) return { ok: true, value: [] };\\n193\\t    const opts = input?.cwd === undefined ? {} : { cwd: input.cwd };\\n194\\t    return { ok: true, value: selectAllThreadRows(registry, opts).map(toThreadInfo) };\\n195\\t  } catch (cause) {\\n196\\t    return storageFailure(`registry read failed: ${detail(cause)}`);\\n197\\t  } finally {\\n198\\t    registry?.close();\\n199\\t  }\\n200\\t}\\n201\\t\\n202\\t// The thread file's own identity header (Epic 04): thread_metadata is this\\n203\\t// domain's table — creation writes it (internal/create.ts) and only this\\n204\\t// surface reads it back. Added for inspect's overview, which must report\\n205\\t// thread identity for ANY resolvable ref — including a { filePath } ref that\\n206\\t// no registry knows — without reading tables itself (inspect's must-not-own\\n207\\t// rule). A pure read: the whole operation runs touch-suppressed (DD-6), so a\\n208\\t// background SDK can never hang a first-touch catch-up drain off it.\\n209\\texport interface ThreadFileInfo {\\n210\\t  threadId: string;\\n211\\t  createdAt: string;\\n212\\t}\\n213\\t\\n214\\texport async function info(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\\n215\\t  return runWithThreadTouchSuppressed(() => infoInner(ref));\\n216\\t}\\n217\\t\\n218\\tasync function infoInner(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\\n219\\t  const resolved = await resolveThreadRef(ref);\\n220\\t  if (!resolved.ok) return resolved;\\n221\\t  const { filePath } = resolved.value;\\n222\\t  if (!existsSync(filePath)) {\\n223\\t    return {\\n224\\t      ok: false,\\n225\\t      error: {\\n226\\t        errorClass: \\\"caller_error\\\",\\n227\\t        code: \\\"thread_not_found\\\",\\n228\\t        reason: `no thread file exists at ${filePath}`,\\n229\\t      },\\n230\\t    };\\n231\\t  }\\n232\\t  const opened = openThreadDatabase(filePath);\\n233\\t  if (!opened.ok) return opened;\\n234\\t  const db = opened.value;\\n235\\t  try {\\n236\\t    const row = db\\n237\\t      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\\n238\\t      .get() as { thread_id: string; created_at: string } | undefined;\\n239\\t    if (row === undefined) {\\n240\\t      // openThreadDatabase validated the row exists; its absence here is\\n241\\t      // external interference between the probe and this read.\\n242\\t      return storageFailure(`thread file at ${filePath} lost its metadata row`);\\n243\\t    }\\n244\\t    return { ok: true, value: { threadId: row.thread_id, createdAt: row.created_at } };\\n245\\t  } catch (cause) {\\n246\\t    return storageFailure(`thread info read failed: ${detail(cause)}`);\\n247\\t  } finally {\\n248\\t    db.close();\\n249\\t  }\\n250\\t}\\n251\\t\\n252\\t// The single interpreter of thread references: { threadId } resolves to a\\n253\\t// path through the registry, { filePath } passes through untouched. No other\\n254\\t// code ever reads a thread reference.\\n255\\texport async function resolveThreadRef(\\n256\\t  ref: ThreadRef,\\n257\\t): Promise<OpResult<{ filePath: string }>> {\\n258\\t  if (\\\"threadId\\\" in ref) {\\n259\\t    const resolved = await resolve(ref);\\n260\\t    if (!resolved.ok) return resolved;\\n261\\t    return { ok: true, value: { filePath: resolved.value.filePath } };\\n262\\t  }\\n263\\t  // Mirror newThread's guard so every read surface that routes through here\\n264\\t  // fails closed on a blank path instead of opening a temp database.\\n265\\t  if (isBlankPath(ref.filePath)) {\\n266\\t    return invalidThreadRef(\\\"filePath must be a non-empty path; received a blank string\\\");\\n267\\t  }\\n268\\t  return { ok: true, value: { filePath: ref.filePath } };\\n269\\t}\\n270\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"85266c3b-894c-4e8f-9ace-8094f8803a3c\",\"timestamp\":\"2026-06-14T05:27:35.853Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/index.ts\",\"content\":\"import { existsSync } from \\\"node:fs\\\";\\nimport { runWithThreadTouchSuppressed } from \\\"../../shared/context.js\\\";\\nimport { storageFailure, type ErrorResult, type OpResult } from \\\"../../shared/errors.js\\\";\\nimport {\\n  createThreadFile,\\n  deleteThreadFile,\\n  generateThreadId,\\n  openThreadDatabase,\\n} from \\\"./internal/create.js\\\";\\n\\n// Re-exported for the other domain surfaces: opening a thread file through\\n// the threads domain is what guarantees its schema is current (a pre-Story-3\\n// file gains the message tables here before any write or read touches them).\\nexport { openThreadDatabase };\\nimport {\\n  insertThreadRow,\\n  openRegistryForRead,\\n  openRegistryForWrite,\\n  resolveRegistryPath,\\n  selectAllThreadRows,\\n  selectThreadRow,\\n  selectThreadRowsByPrefix,\\n  type RegistryRow,\\n} from \\\"./internal/registry.js\\\";\\n\\nexport type ThreadRef =\\n  | { threadId: string; registryPath?: string }\\n  | { filePath: string };\\n\\nexport interface NewThreadInput {\\n  filePath: string;\\n  title?: string;\\n  cwd?: string;\\n  registryPath?: string;\\n}\\n\\nexport interface ThreadInfo {\\n  threadId: string;\\n  filePath: string;\\n  title?: string;\\n  cwd?: string;\\n  createdAt: string; // ISO-8601\\n}\\n\\nfunction toThreadInfo(row: RegistryRow): ThreadInfo {\\n  const info: ThreadInfo = {\\n    threadId: row.threadId,\\n    filePath: row.filePath,\\n    createdAt: row.createdAt,\\n  };\\n  if (row.title !== undefined) info.title = row.title;\\n  if (row.cwd !== undefined) info.cwd = row.cwd;\\n  return info;\\n}\\n\\nfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"caller_error\\\",\\n      code: \\\"thread_not_found\\\",\\n      reason: `no thread registered with id ${threadId}`,\\n    },\\n  };\\n}\\n\\n// A partial id that matches more than one thread is a caller error, not a\\n// silent pick: resolution names the collision and the caller must disambiguate\\n// (AC-1.6 — an ambiguous id fails loud, never resolves arbitrarily).\\nfunction ambiguousThreadId(\\n  prefix: string,\\n  matchIds: readonly string[],\\n): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"caller_error\\\",\\n      code: \\\"ambiguous_thread_id\\\",\\n      reason: `thread id \\\"${prefix}\\\" is ambiguous: it matches ${matchIds.length} threads (${matchIds.join(\\\", \\\")}); use a longer id`,\\n    },\\n  };\\n}\\n\\nfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: { errorClass: \\\"caller_error\\\", code: \\\"invalid_thread_ref\\\", reason },\\n  };\\n}\\n\\n// A file path that is empty or whitespace-only cannot name a durable file:\\n// node:sqlite's DatabaseSync(\\\"\\\") opens a temporary database that vanishes on\\n// close, so such a path must be refused as a caller error before any storage\\n// is touched rather than silently producing a thread with no durable file.\\nfunction isBlankPath(filePath: string): boolean {\\n  return filePath.trim() === \\\"\\\";\\n}\\n\\nfunction detail(cause: unknown): string {\\n  return cause instanceof Error ? cause.message : String(cause);\\n}\\n\\n// Creation spans two databases that cannot share a transaction. Order is\\n// file-then-row with compensation: the invariant \\\"no registry row without\\n// its file\\\" is absolute; an orphan file from a crash between the writes is\\n// documented harmless (design decision 2).\\nexport async function newThread(\\n  input: NewThreadInput,\\n): Promise<OpResult<{ threadId: string; filePath: string }>> {\\n  // Guard before any storage touch: an empty/blank path would otherwise open\\n  // a temp database and register a thread with no durable file (the no-row-\\n  // without-file invariant below depends on the path naming a real file).\\n  if (isBlankPath(input.filePath)) {\\n    return invalidThreadRef(\\\"filePath must be a non-empty path; received a blank string\\\");\\n  }\\n  if (existsSync(input.filePath)) {\\n    return {\\n      ok: false,\\n      error: {\\n        errorClass: \\\"caller_error\\\",\\n        code: \\\"path_exists\\\",\\n        reason: `a file already exists at ${input.filePath}`,\\n      },\\n    };\\n  }\\n\\n  const threadId = generateThreadId();\\n  const createdAt = new Date().toISOString();\\n\\n  try {\\n    createThreadFile(input.filePath, threadId, createdAt);\\n  } catch (cause) {\\n    deleteThreadFile(input.filePath);\\n    return storageFailure(`thread file creation failed: ${detail(cause)}`);\\n  }\\n\\n  let registry;\\n  try {\\n    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\\n    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\\n    if (input.title !== undefined) row.title = input.title;\\n    if (input.cwd !== undefined) row.cwd = input.cwd;\\n    insertThreadRow(registry, row);\\n  } catch (cause) {\\n    deleteThreadFile(input.filePath);\\n    return storageFailure(`registry insert failed: ${detail(cause)}`);\\n  } finally {\\n    registry?.close();\\n  }\\n\\n  return { ok: true, value: { threadId, filePath: input.filePath } };\\n}\\n\\n// Resolution accepts a full or partial (prefix) thread id (A-8). An exact id\\n// wins outright — a full id always resolves to itself, even if it is also a\\n// prefix of a longer id — so only a genuinely partial id ever consults the\\n// prefix path; that path resolves a unique prefix, fails ambiguous on more than\\n// one match, and fails not-found on none. No path ever creates a thread.\\nexport async function resolve(input: {\\n  threadId: string;\\n  registryPath?: string;\\n}): Promise<OpResult<ThreadInfo>> {\\n  let registry;\\n  try {\\n    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\\n    if (registry === null) return threadNotFound(input.threadId);\\n    const exact = selectThreadRow(registry, input.threadId);\\n    if (exact !== undefined) return { ok: true, value: toThreadInfo(exact) };\\n    const matches = selectThreadRowsByPrefix(registry, input.threadId);\\n    if (matches.length === 1) return { ok: true, value: toThreadInfo(matches[0]!) };\\n    if (matches.length > 1) {\\n      return ambiguousThreadId(\\n        input.threadId,\\n        matches.map((m) => m.threadId),\\n      );\\n    }\\n    return threadNotFound(input.threadId);\\n  } catch (cause) {\\n    return storageFailure(`registry read failed: ${detail(cause)}`);\\n  } finally {\\n    registry?.close();\\n  }\\n}\\n\\nexport async function listThreads(input?: {\\n  cwd?: string;\\n  registryPath?: string;\\n}): Promise<OpResult<ThreadInfo[]>> {\\n  let registry;\\n  try {\\n    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\\n    if (registry === null) return { ok: true, value: [] };\\n    const opts = input?.cwd === undefined ? {} : { cwd: input.cwd };\\n    return { ok: true, value: selectAllThreadRows(registry, opts).map(toThreadInfo) };\\n  } catch (cause) {\\n    return storageFailure(`registry read failed: ${detail(cause)}`);\\n  } finally {\\n    registry?.close();\\n  }\\n}\\n\\n// The thread file's own identity header (Epic 04): thread_metadata is this\\n// domain's table — creation writes it (internal/create.ts) and only this\\n// surface reads it back. Added for inspect's overview, which must report\\n// thread identity for ANY resolvable ref — including a { filePath } ref that\\n// no registry knows — without reading tables itself (inspect's must-not-own\\n// rule). A pure read: the whole operation runs touch-suppressed (DD-6), so a\\n// background SDK can never hang a first-touch catch-up drain off it.\\nexport interface ThreadFileInfo {\\n  threadId: string;\\n  createdAt: string;\\n}\\n\\nexport async function info(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\\n  return runWithThreadTouchSuppressed(() => infoInner(ref));\\n}\\n\\nasync function infoInner(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\\n  const resolved = await resolveThreadRef(ref);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) {\\n    return {\\n      ok: false,\\n      error: {\\n        errorClass: \\\"caller_error\\\",\\n        code: \\\"thread_not_found\\\",\\n        reason: `no thread file exists at ${filePath}`,\\n      },\\n    };\\n  }\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    const row = db\\n      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\\n      .get() as { thread_id: string; created_at: string } | undefined;\\n    if (row === undefined) {\\n      // openThreadDatabase validated the row exists; its absence here is\\n      // external interference between the probe and this read.\\n      return storageFailure(`thread file at ${filePath} lost its metadata row`);\\n    }\\n    return { ok: true, value: { threadId: row.thread_id, createdAt: row.created_at } };\\n  } catch (cause) {\\n    return storageFailure(`thread info read failed: ${detail(cause)}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// The single interpreter of thread references: { threadId } resolves to a\\n// path through the registry, { filePath } passes through untouched. No other\\n// code ever reads a thread reference.\\nexport async function resolveThreadRef(\\n  ref: ThreadRef,\\n): Promise<OpResult<{ filePath: string }>> {\\n  if (\\\"threadId\\\" in ref) {\\n    const resolved = await resolve(ref);\\n    if (!resolved.ok) return resolved;\\n    return { ok: true, value: { filePath: resolved.value.filePath } };\\n  }\\n  // Mirror newThread's guard so every read surface that routes through here\\n  // fails closed on a blank path instead of opening a temp database.\\n  if (isBlankPath(ref.filePath)) {\\n    return invalidThreadRef(\\\"filePath must be a non-empty path; received a blank string\\\");\\n  }\\n  return { ok: true, value: { filePath: ref.filePath } };\\n}\\n\",\"numLines\":270,\"startLine\":1,\"totalLines\":270}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:604:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01YMF17Ppdn8YxMDNHsw5HzJ\",\"type\":\"tool_result\",\"content\":\"1\\timport { existsSync, mkdirSync } from \\\"node:fs\\\";\\n2\\timport { homedir } from \\\"node:os\\\";\\n3\\timport { dirname, join } from \\\"node:path\\\";\\n4\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n5\\timport { openDatabase, runMigrations, type Migration } from \\\"../../../shared/storage.js\\\";\\n6\\t\\n7\\texport const DEFAULT_REGISTRY_PATH = join(homedir(), \\\".lhc\\\", \\\"registry.sqlite\\\");\\n8\\t\\n9\\texport function resolveRegistryPath(registryPath?: string): string {\\n10\\t  return registryPath ?? DEFAULT_REGISTRY_PATH;\\n11\\t}\\n12\\t\\n13\\tconst REGISTRY_MIGRATIONS: readonly Migration[] = [\\n14\\t  {\\n15\\t    version: 1,\\n16\\t    statements: [\\n17\\t      `CREATE TABLE threads (\\n18\\t        thread_id TEXT PRIMARY KEY,\\n19\\t        file_path TEXT NOT NULL,\\n20\\t        title TEXT,\\n21\\t        created_at TEXT NOT NULL\\n22\\t      );`,\\n23\\t    ],\\n24\\t  },\\n25\\t  {\\n26\\t    // A-8 (Epic 02 pi-lhc Story 1): the cwd a thread was created in, so the\\n27\\t    // `--resume` picker can scope its list to the current directory. Added as\\n28\\t    // its own version (not folded into v1) so a registry created under v1\\n29\\t    // upgrades lazily on next open rather than silently lacking the column.\\n30\\t    version: 2,\\n31\\t    statements: [`ALTER TABLE threads ADD COLUMN cwd TEXT;`],\\n32\\t  },\\n33\\t];\\n34\\t\\n35\\t// First write creates the database and schema lazily (design decision 6).\\n36\\texport function openRegistryForWrite(registryPath: string): DatabaseSync {\\n37\\t  mkdirSync(dirname(registryPath), { recursive: true });\\n38\\t  const db = openDatabase(registryPath);\\n39\\t  try {\\n40\\t    runMigrations(db, REGISTRY_MIGRATIONS);\\n41\\t  } catch (cause) {\\n42\\t    db.close();\\n43\\t    throw cause;\\n44\\t  }\\n45\\t  return db;\\n46\\t}\\n47\\t\\n48\\t// Reads never create the registry: callers map null to empty list /\\n49\\t// thread_not_found. The existence check is the non-creation guarantee —\\n50\\t// openDatabase would create the file. An existing registry is brought to the\\n51\\t// current schema on open so reads can rely on the current columns (e.g. the\\n52\\t// A-8 `cwd` column) regardless of which version created it; a registry already\\n53\\t// at the latest version pays nothing (runMigrations is a no-op).\\n54\\texport function openRegistryForRead(registryPath: string): DatabaseSync | null {\\n55\\t  if (!existsSync(registryPath)) return null;\\n56\\t  const db = openDatabase(registryPath);\\n57\\t  try {\\n58\\t    runMigrations(db, REGISTRY_MIGRATIONS);\\n59\\t  } catch (cause) {\\n60\\t    db.close();\\n61\\t    throw cause;\\n62\\t  }\\n63\\t  return db;\\n64\\t}\\n65\\t\\n66\\texport interface RegistryRow {\\n67\\t  threadId: string;\\n68\\t  filePath: string;\\n69\\t  title?: string;\\n70\\t  cwd?: string;\\n71\\t  createdAt: string;\\n72\\t}\\n73\\t\\n74\\tinterface RawRow {\\n75\\t  thread_id: string;\\n76\\t  file_path: string;\\n77\\t  title: string | null;\\n78\\t  cwd: string | null;\\n79\\t  created_at: string;\\n80\\t}\\n81\\t\\n82\\tconst ROW_COLUMNS = \\\"thread_id, file_path, title, cwd, created_at\\\";\\n83\\t\\n84\\t// Insertion order (rowid) breaks ties at the same created_at timestamp, so\\n85\\t// \\\"most recent\\\" (the last row) is the last-inserted thread even when two\\n86\\t// creations land in the same millisecond — the determinism `--continue`\\n87\\t// (resolve the most recently created thread) relies on.\\n88\\tconst ROW_ORDER = \\\"ORDER BY created_at, rowid\\\";\\n89\\t\\n90\\tfunction toRegistryRow(raw: RawRow): RegistryRow {\\n91\\t  const row: RegistryRow = {\\n92\\t    threadId: raw.thread_id,\\n93\\t    filePath: raw.file_path,\\n94\\t    createdAt: raw.created_at,\\n95\\t  };\\n96\\t  if (raw.title !== null) row.title = raw.title;\\n97\\t  if (raw.cwd !== null) row.cwd = raw.cwd;\\n98\\t  return row;\\n99\\t}\\n100\\t\\n101\\texport function insertThreadRow(db: DatabaseSync, row: RegistryRow): void {\\n102\\t  db.prepare(\\n103\\t    \\\"INSERT INTO threads (thread_id, file_path, title, cwd, created_at) VALUES (?, ?, ?, ?, ?)\\\",\\n104\\t  ).run(row.threadId, row.filePath, row.title ?? null, row.cwd ?? null, row.createdAt);\\n105\\t}\\n106\\t\\n107\\texport function selectThreadRow(\\n108\\t  db: DatabaseSync,\\n109\\t  threadId: string,\\n110\\t): RegistryRow | undefined {\\n111\\t  const raw = db\\n112\\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id = ?`)\\n113\\t    .get(threadId) as unknown as RawRow | undefined;\\n114\\t  return raw === undefined ? undefined : toRegistryRow(raw);\\n115\\t}\\n116\\t\\n117\\t// Partial-id resolve (A-8): every thread whose id begins with the given prefix.\\n118\\t// LIKE metacharacters in the (caller-supplied) prefix are escaped so the '_' in\\n119\\t// the thread-id scheme (th_<hex>) and any '%' match literally rather than as\\n120\\t// wildcards; ESCAPE makes '\\\\' the escape character.\\n121\\texport function selectThreadRowsByPrefix(db: DatabaseSync, prefix: string): RegistryRow[] {\\n122\\t  const escaped = prefix.replace(/[\\\\\\\\%_]/g, (ch) => `\\\\\\\\${ch}`);\\n123\\t  const raws = db\\n124\\t    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id LIKE ? ESCAPE '\\\\\\\\' ${ROW_ORDER}`)\\n125\\t    .all(`${escaped}%`) as unknown as RawRow[];\\n126\\t  return raws.map(toRegistryRow);\\n127\\t}\\n128\\t\\n129\\t// cwd, when given, filters at the registry (A-8): the picker must not scope by\\n130\\t// filtering an unscoped list after the fact (anti-shim) — the scope is the query.\\n131\\texport function selectAllThreadRows(\\n132\\t  db: DatabaseSync,\\n133\\t  opts: { cwd?: string } = {},\\n134\\t): RegistryRow[] {\\n135\\t  const raws =\\n136\\t    opts.cwd === undefined\\n137\\t      ? (db.prepare(`SELECT ${ROW_COLUMNS} FROM threads ${ROW_ORDER}`).all() as unknown as RawRow[])\\n138\\t      : (db\\n139\\t          .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE cwd = ? ${ROW_ORDER}`)\\n140\\t          .all(opts.cwd) as unknown as RawRow[]);\\n141\\t  return raws.map(toRegistryRow);\\n142\\t}\\n143\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"235ffbd9-bba8-45b6-8661-39d8d47abd02\",\"timestamp\":\"2026-06-14T05:27:36.792Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/internal/registry.ts\",\"content\":\"import { existsSync, mkdirSync } from \\\"node:fs\\\";\\nimport { homedir } from \\\"node:os\\\";\\nimport { dirname, join } from \\\"node:path\\\";\\nimport type { DatabaseSync } from \\\"node:sqlite\\\";\\nimport { openDatabase, runMigrations, type Migration } from \\\"../../../shared/storage.js\\\";\\n\\nexport const DEFAULT_REGISTRY_PATH = join(homedir(), \\\".lhc\\\", \\\"registry.sqlite\\\");\\n\\nexport function resolveRegistryPath(registryPath?: string): string {\\n  return registryPath ?? DEFAULT_REGISTRY_PATH;\\n}\\n\\nconst REGISTRY_MIGRATIONS: readonly Migration[] = [\\n  {\\n    version: 1,\\n    statements: [\\n      `CREATE TABLE threads (\\n        thread_id TEXT PRIMARY KEY,\\n        file_path TEXT NOT NULL,\\n        title TEXT,\\n        created_at TEXT NOT NULL\\n      );`,\\n    ],\\n  },\\n  {\\n    // A-8 (Epic 02 pi-lhc Story 1): the cwd a thread was created in, so the\\n    // `--resume` picker can scope its list to the current directory. Added as\\n    // its own version (not folded into v1) so a registry created under v1\\n    // upgrades lazily on next open rather than silently lacking the column.\\n    version: 2,\\n    statements: [`ALTER TABLE threads ADD COLUMN cwd TEXT;`],\\n  },\\n];\\n\\n// First write creates the database and schema lazily (design decision 6).\\nexport function openRegistryForWrite(registryPath: string): DatabaseSync {\\n  mkdirSync(dirname(registryPath), { recursive: true });\\n  const db = openDatabase(registryPath);\\n  try {\\n    runMigrations(db, REGISTRY_MIGRATIONS);\\n  } catch (cause) {\\n    db.close();\\n    throw cause;\\n  }\\n  return db;\\n}\\n\\n// Reads never create the registry: callers map null to empty list /\\n// thread_not_found. The existence check is the non-creation guarantee —\\n// openDatabase would create the file. An existing registry is brought to the\\n// current schema on open so reads can rely on the current columns (e.g. the\\n// A-8 `cwd` column) regardless of which version created it; a registry already\\n// at the latest version pays nothing (runMigrations is a no-op).\\nexport function openRegistryForRead(registryPath: string): DatabaseSync | null {\\n  if (!existsSync(registryPath)) return null;\\n  const db = openDatabase(registryPath);\\n  try {\\n    runMigrations(db, REGISTRY_MIGRATIONS);\\n  } catch (cause) {\\n    db.close();\\n    throw cause;\\n  }\\n  return db;\\n}\\n\\nexport interface RegistryRow {\\n  threadId: string;\\n  filePath: string;\\n  title?: string;\\n  cwd?: string;\\n  createdAt: string;\\n}\\n\\ninterface RawRow {\\n  thread_id: string;\\n  file_path: string;\\n  title: string | null;\\n  cwd: string | null;\\n  created_at: string;\\n}\\n\\nconst ROW_COLUMNS = \\\"thread_id, file_path, title, cwd, created_at\\\";\\n\\n// Insertion order (rowid) breaks ties at the same created_at timestamp, so\\n// \\\"most recent\\\" (the last row) is the last-inserted thread even when two\\n// creations land in the same millisecond — the determinism `--continue`\\n// (resolve the most recently created thread) relies on.\\nconst ROW_ORDER = \\\"ORDER BY created_at, rowid\\\";\\n\\nfunction toRegistryRow(raw: RawRow): RegistryRow {\\n  const row: RegistryRow = {\\n    threadId: raw.thread_id,\\n    filePath: raw.file_path,\\n    createdAt: raw.created_at,\\n  };\\n  if (raw.title !== null) row.title = raw.title;\\n  if (raw.cwd !== null) row.cwd = raw.cwd;\\n  return row;\\n}\\n\\nexport function insertThreadRow(db: DatabaseSync, row: RegistryRow): void {\\n  db.prepare(\\n    \\\"INSERT INTO threads (thread_id, file_path, title, cwd, created_at) VALUES (?, ?, ?, ?, ?)\\\",\\n  ).run(row.threadId, row.filePath, row.title ?? null, row.cwd ?? null, row.createdAt);\\n}\\n\\nexport function selectThreadRow(\\n  db: DatabaseSync,\\n  threadId: string,\\n): RegistryRow | undefined {\\n  const raw = db\\n    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id = ?`)\\n    .get(threadId) as unknown as RawRow | undefined;\\n  return raw === undefined ? undefined : toRegistryRow(raw);\\n}\\n\\n// Partial-id resolve (A-8): every thread whose id begins with the given prefix.\\n// LIKE metacharacters in the (caller-supplied) prefix are escaped so the '_' in\\n// the thread-id scheme (th_<hex>) and any '%' match literally rather than as\\n// wildcards; ESCAPE makes '\\\\' the escape character.\\nexport function selectThreadRowsByPrefix(db: DatabaseSync, prefix: string): RegistryRow[] {\\n  const escaped = prefix.replace(/[\\\\\\\\%_]/g, (ch) => `\\\\\\\\${ch}`);\\n  const raws = db\\n    .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE thread_id LIKE ? ESCAPE '\\\\\\\\' ${ROW_ORDER}`)\\n    .all(`${escaped}%`) as unknown as RawRow[];\\n  return raws.map(toRegistryRow);\\n}\\n\\n// cwd, when given, filters at the registry (A-8): the picker must not scope by\\n// filtering an unscoped list after the fact (anti-shim) — the scope is the query.\\nexport function selectAllThreadRows(\\n  db: DatabaseSync,\\n  opts: { cwd?: string } = {},\\n): RegistryRow[] {\\n  const raws =\\n    opts.cwd === undefined\\n      ? (db.prepare(`SELECT ${ROW_COLUMNS} FROM threads ${ROW_ORDER}`).all() as unknown as RawRow[])\\n      : (db\\n          .prepare(`SELECT ${ROW_COLUMNS} FROM threads WHERE cwd = ? ${ROW_ORDER}`)\\n          .all(opts.cwd) as unknown as RawRow[]);\\n  return raws.map(toRegistryRow);\\n}\\n\",\"numLines\":143,\"startLine\":1,\"totalLines\":143}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:701:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017mTUKKNrfR7HquCQ4cR9K1\",\"type\":\"tool_result\",\"content\":\"1\\t// A-8 registry additions (pi-lhc Epic 02 Story 1 prerequisite): the cwd column,\\n2\\t// partial-id (prefix) resolve with ambiguity failure, the cwd-scoped listing,\\n3\\t// deterministic most-recent ordering, and lazy upgrade of a pre-cwd registry.\\n4\\t// These are the registry operations the connector's launch-driven thread\\n5\\t// resolution depends on; they are proven here at the registry boundary, not\\n6\\t// only through the connector (anti-shim: the scope is the query, not a filter\\n7\\t// over an unscoped list).\\n8\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n9\\timport { threads } from \\\"../src/index.js\\\";\\n10\\timport { openRaw, tempStore, type TempStore } from \\\"./fixtures/index.js\\\";\\n11\\t\\n12\\tlet store: TempStore;\\n13\\tbeforeEach(() => {\\n14\\t  store = tempStore();\\n15\\t});\\n16\\tafterEach(() => {\\n17\\t  store.cleanup();\\n18\\t});\\n19\\t\\n20\\tasync function create(opts: { title?: string; cwd?: string } = {}): Promise<string> {\\n21\\t  const input: { filePath: string; registryPath: string; title?: string; cwd?: string } = {\\n22\\t    filePath: store.threadPath(),\\n23\\t    registryPath: store.registryPath,\\n24\\t  };\\n25\\t  if (opts.title !== undefined) input.title = opts.title;\\n26\\t  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\n27\\t  const result = await threads.newThread(input);\\n28\\t  if (!result.ok) throw new Error(`create failed: ${result.error.reason}`);\\n29\\t  return result.value.threadId;\\n30\\t}\\n31\\t\\n32\\tdescribe(\\\"A-8: cwd column\\\", () => {\\n33\\t  it(\\\"newThread stores cwd; resolve and listThreads carry it back\\\", async () => {\\n34\\t    const id = await create({ cwd: \\\"/work/project-a\\\", title: \\\"a\\\" });\\n35\\t\\n36\\t    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n37\\t    expect(resolved.ok).toBe(true);\\n38\\t    if (resolved.ok) expect(resolved.value.cwd).toBe(\\\"/work/project-a\\\");\\n39\\t\\n40\\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n41\\t    expect(listed.ok).toBe(true);\\n42\\t    if (listed.ok) expect(listed.value[0]?.cwd).toBe(\\\"/work/project-a\\\");\\n43\\t  });\\n44\\t\\n45\\t  it(\\\"a thread created with no cwd reports cwd undefined\\\", async () => {\\n46\\t    const id = await create({ title: \\\"no-cwd\\\" });\\n47\\t    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n48\\t    expect(resolved.ok).toBe(true);\\n49\\t    if (resolved.ok) expect(resolved.value.cwd).toBeUndefined();\\n50\\t  });\\n51\\t});\\n52\\t\\n53\\tdescribe(\\\"A-8: partial-id resolve\\\", () => {\\n54\\t  it(\\\"resolves a unique prefix to the one matching thread\\\", async () => {\\n55\\t    const id = await create({ title: \\\"only\\\" });\\n56\\t    const prefix = id.slice(0, 8); // a true partial: shorter than the full id\\n57\\t    expect(prefix.length).toBeLessThan(id.length);\\n58\\t\\n59\\t    const resolved = await threads.resolve({ threadId: prefix, registryPath: store.registryPath });\\n60\\t    expect(resolved.ok).toBe(true);\\n61\\t    if (resolved.ok) expect(resolved.value.threadId).toBe(id);\\n62\\t  });\\n63\\t\\n64\\t  it(\\\"a full id still resolves exactly (exact match path)\\\", async () => {\\n65\\t    const id = await create();\\n66\\t    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n67\\t    expect(resolved.ok).toBe(true);\\n68\\t    if (resolved.ok) expect(resolved.value.threadId).toBe(id);\\n69\\t  });\\n70\\t\\n71\\t  it(\\\"an ambiguous prefix fails ambiguous_thread_id and creates nothing\\\", async () => {\\n72\\t    const a = await create();\\n73\\t    const b = await create();\\n74\\t    // Every id shares the \\\"th_\\\" scheme prefix, so it matches both threads.\\n75\\t    const ambiguous = await threads.resolve({ threadId: \\\"th_\\\", registryPath: store.registryPath });\\n76\\t    expect(ambiguous.ok).toBe(false);\\n77\\t    if (!ambiguous.ok) {\\n78\\t      expect(ambiguous.error.code).toBe(\\\"ambiguous_thread_id\\\");\\n79\\t      expect(ambiguous.error.errorClass).toBe(\\\"caller_error\\\");\\n80\\t      expect(ambiguous.error.reason).toContain(a);\\n81\\t      expect(ambiguous.error.reason).toContain(b);\\n82\\t    }\\n83\\t\\n84\\t    // No thread was created by the failed resolution.\\n85\\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n86\\t    expect(listed.ok).toBe(true);\\n87\\t    if (listed.ok) expect(listed.value).toHaveLength(2);\\n88\\t  });\\n89\\t\\n90\\t  it(\\\"an unresolvable id fails thread_not_found, never a silent match\\\", async () => {\\n91\\t    await create();\\n92\\t    const missing = await threads.resolve({\\n93\\t      threadId: \\\"th_zzzzzzzzzzzzzzzz\\\", // 'z' is not in the hex id alphabet\\n94\\t      registryPath: store.registryPath,\\n95\\t    });\\n96\\t    expect(missing.ok).toBe(false);\\n97\\t    if (!missing.ok) expect(missing.error.code).toBe(\\\"thread_not_found\\\");\\n98\\t  });\\n99\\t\\n100\\t  it(\\\"LIKE metacharacters in a partial id match literally, not as wildcards\\\", async () => {\\n101\\t    await create();\\n102\\t    await create();\\n103\\t    // \\\"_\\\" is a LIKE single-char wildcard; unescaped it would match every id\\n104\\t    // (all begin \\\"th_...\\\"). Escaped, \\\"th%\\\" / \\\"_\\\" must be treated literally and\\n105\\t    // match nothing, since no id literally contains \\\"%\\\" or begins \\\"th_%\\\".\\n106\\t    const pct = await threads.resolve({ threadId: \\\"th%\\\", registryPath: store.registryPath });\\n107\\t    expect(pct.ok).toBe(false);\\n108\\t    if (!pct.ok) expect(pct.error.code).toBe(\\\"thread_not_found\\\");\\n109\\t  });\\n110\\t});\\n111\\t\\n112\\tdescribe(\\\"A-8: cwd-scoped listing and most-recent ordering\\\", () => {\\n113\\t  it(\\\"listThreads({cwd}) returns only that cwd's threads\\\", async () => {\\n114\\t    const a1 = await create({ cwd: \\\"/work/a\\\" });\\n115\\t    const a2 = await create({ cwd: \\\"/work/a\\\" });\\n116\\t    await create({ cwd: \\\"/work/b\\\" });\\n117\\t\\n118\\t    const scoped = await threads.listThreads({ cwd: \\\"/work/a\\\", registryPath: store.registryPath });\\n119\\t    expect(scoped.ok).toBe(true);\\n120\\t    if (scoped.ok) {\\n121\\t      expect(scoped.value).toHaveLength(2);\\n122\\t      expect(new Set(scoped.value.map((t) => t.threadId))).toEqual(new Set([a1, a2]));\\n123\\t      for (const t of scoped.value) expect(t.cwd).toBe(\\\"/work/a\\\");\\n124\\t    }\\n125\\t\\n126\\t    const all = await threads.listThreads({ registryPath: store.registryPath });\\n127\\t    expect(all.ok).toBe(true);\\n128\\t    if (all.ok) expect(all.value).toHaveLength(3);\\n129\\t  });\\n130\\t\\n131\\t  it(\\\"an empty cwd lists nothing without failing\\\", async () => {\\n132\\t    await create({ cwd: \\\"/work/a\\\" });\\n133\\t    const empty = await threads.listThreads({ cwd: \\\"/elsewhere\\\", registryPath: store.registryPath });\\n134\\t    expect(empty.ok).toBe(true);\\n135\\t    if (empty.ok) expect(empty.value).toEqual([]);\\n136\\t  });\\n137\\t\\n138\\t  it(\\\"the last listed thread is the most recently created (insertion-order tie-break)\\\", async () => {\\n139\\t    await create({ title: \\\"first\\\" });\\n140\\t    await create({ title: \\\"second\\\" });\\n141\\t    const last = await create({ title: \\\"third\\\" });\\n142\\t\\n143\\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n144\\t    expect(listed.ok).toBe(true);\\n145\\t    if (listed.ok) {\\n146\\t      expect(listed.value).toHaveLength(3);\\n147\\t      expect(listed.value.at(-1)?.threadId).toBe(last);\\n148\\t    }\\n149\\t  });\\n150\\t});\\n151\\t\\n152\\tdescribe(\\\"A-8: lazy upgrade of a pre-cwd registry (migrate-on-read)\\\", () => {\\n153\\t  it(\\\"reads a v1 registry, upgrading it to carry the cwd column\\\", async () => {\\n154\\t    // Build a registry at the pre-A-8 v1 schema by hand (no cwd column).\\n155\\t    const db = openRaw(store.registryPath);\\n156\\t    db.exec(\\n157\\t      `CREATE TABLE threads (\\n158\\t        thread_id TEXT PRIMARY KEY,\\n159\\t        file_path TEXT NOT NULL,\\n160\\t        title TEXT,\\n161\\t        created_at TEXT NOT NULL\\n162\\t      );`,\\n163\\t    );\\n164\\t    db.exec(`PRAGMA user_version = 1;`);\\n165\\t    db.prepare(\\n166\\t      \\\"INSERT INTO threads (thread_id, file_path, title, created_at) VALUES (?, ?, ?, ?)\\\",\\n167\\t    ).run(\\\"th_legacy0000\\\", \\\"/tmp/legacy.sqlite\\\", \\\"legacy\\\", \\\"2026-01-01T00:00:00.000Z\\\");\\n168\\t    db.close();\\n169\\t\\n170\\t    // A read through the domain upgrades the schema and succeeds; the legacy\\n171\\t    // row reports cwd undefined.\\n172\\t    const resolved = await threads.resolve({ threadId: \\\"th_legacy0000\\\", registryPath: store.registryPath });\\n173\\t    expect(resolved.ok).toBe(true);\\n174\\t    if (resolved.ok) {\\n175\\t      expect(resolved.value.title).toBe(\\\"legacy\\\");\\n176\\t      expect(resolved.value.cwd).toBeUndefined();\\n177\\t    }\\n178\\t\\n179\\t    // The registry now carries the cwd column at the current version.\\n180\\t    const after = openRaw(store.registryPath);\\n181\\t    const columns = (\\n182\\t      after.prepare(\\\"PRAGMA table_info(threads)\\\").all() as unknown as Array<{ name: string }>\\n183\\t    ).map((c) => c.name);\\n184\\t    const version = after.prepare(\\\"PRAGMA user_version\\\").get() as unknown as { user_version: number };\\n185\\t    after.close();\\n186\\t    expect(columns).toContain(\\\"cwd\\\");\\n187\\t    expect(Number(version.user_version)).toBe(2);\\n188\\t  });\\n189\\t});\\n190\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"2d5e6ccc-373a-487d-b7ac-c279c61a4cfd\",\"timestamp\":\"2026-06-14T05:28:18.521Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/threads-a8.test.ts\",\"content\":\"// A-8 registry additions (pi-lhc Epic 02 Story 1 prerequisite): the cwd column,\\n// partial-id (prefix) resolve with ambiguity failure, the cwd-scoped listing,\\n// deterministic most-recent ordering, and lazy upgrade of a pre-cwd registry.\\n// These are the registry operations the connector's launch-driven thread\\n// resolution depends on; they are proven here at the registry boundary, not\\n// only through the connector (anti-shim: the scope is the query, not a filter\\n// over an unscoped list).\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport { threads } from \\\"../src/index.js\\\";\\nimport { openRaw, tempStore, type TempStore } from \\\"./fixtures/index.js\\\";\\n\\nlet store: TempStore;\\nbeforeEach(() => {\\n  store = tempStore();\\n});\\nafterEach(() => {\\n  store.cleanup();\\n});\\n\\nasync function create(opts: { title?: string; cwd?: string } = {}): Promise<string> {\\n  const input: { filePath: string; registryPath: string; title?: string; cwd?: string } = {\\n    filePath: store.threadPath(),\\n    registryPath: store.registryPath,\\n  };\\n  if (opts.title !== undefined) input.title = opts.title;\\n  if (opts.cwd !== undefined) input.cwd = opts.cwd;\\n  const result = await threads.newThread(input);\\n  if (!result.ok) throw new Error(`create failed: ${result.error.reason}`);\\n  return result.value.threadId;\\n}\\n\\ndescribe(\\\"A-8: cwd column\\\", () => {\\n  it(\\\"newThread stores cwd; resolve and listThreads carry it back\\\", async () => {\\n    const id = await create({ cwd: \\\"/work/project-a\\\", title: \\\"a\\\" });\\n\\n    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n    expect(resolved.ok).toBe(true);\\n    if (resolved.ok) expect(resolved.value.cwd).toBe(\\\"/work/project-a\\\");\\n\\n    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n    expect(listed.ok).toBe(true);\\n    if (listed.ok) expect(listed.value[0]?.cwd).toBe(\\\"/work/project-a\\\");\\n  });\\n\\n  it(\\\"a thread created with no cwd reports cwd undefined\\\", async () => {\\n    const id = await create({ title: \\\"no-cwd\\\" });\\n    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n    expect(resolved.ok).toBe(true);\\n    if (resolved.ok) expect(resolved.value.cwd).toBeUndefined();\\n  });\\n});\\n\\ndescribe(\\\"A-8: partial-id resolve\\\", () => {\\n  it(\\\"resolves a unique prefix to the one matching thread\\\", async () => {\\n    const id = await create({ title: \\\"only\\\" });\\n    const prefix = id.slice(0, 8); // a true partial: shorter than the full id\\n    expect(prefix.length).toBeLessThan(id.length);\\n\\n    const resolved = await threads.resolve({ threadId: prefix, registryPath: store.registryPath });\\n    expect(resolved.ok).toBe(true);\\n    if (resolved.ok) expect(resolved.value.threadId).toBe(id);\\n  });\\n\\n  it(\\\"a full id still resolves exactly (exact match path)\\\", async () => {\\n    const id = await create();\\n    const resolved = await threads.resolve({ threadId: id, registryPath: store.registryPath });\\n    expect(resolved.ok).toBe(true);\\n    if (resolved.ok) expect(resolved.value.threadId).toBe(id);\\n  });\\n\\n  it(\\\"an ambiguous prefix fails ambiguous_thread_id and creates nothing\\\", async () => {\\n    const a = await create();\\n    const b = await create();\\n    // Every id shares the \\\"th_\\\" scheme prefix, so it matches both threads.\\n    const ambiguous = await threads.resolve({ threadId: \\\"th_\\\", registryPath: store.registryPath });\\n    expect(ambiguous.ok).toBe(false);\\n    if (!ambiguous.ok) {\\n      expect(ambiguous.error.code).toBe(\\\"ambiguous_thread_id\\\");\\n      expect(ambiguous.error.errorClass).toBe(\\\"caller_error\\\");\\n      expect(ambiguous.error.reason).toContain(a);\\n      expect(ambiguous.error.reason).toContain(b);\\n    }\\n\\n    // No thread was created by the failed resolution.\\n    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n    expect(listed.ok).toBe(true);\\n    if (listed.ok) expect(listed.value).toHaveLength(2);\\n  });\\n\\n  it(\\\"an unresolvable id fails thread_not_found, never a silent match\\\", async () => {\\n    await create();\\n    const missing = await threads.resolve({\\n      threadId: \\\"th_zzzzzzzzzzzzzzzz\\\", // 'z' is not in the hex id alphabet\\n      registryPath: store.registryPath,\\n    });\\n    expect(missing.ok).toBe(false);\\n    if (!missing.ok) expect(missing.error.code).toBe(\\\"thread_not_found\\\");\\n  });\\n\\n  it(\\\"LIKE metacharacters in a partial id match literally, not as wildcards\\\", async () => {\\n    await create();\\n    await create();\\n    // \\\"_\\\" is a LIKE single-char wildcard; unescaped it would match every id\\n    // (all begin \\\"th_...\\\"). Escaped, \\\"th%\\\" / \\\"_\\\" must be treated literally and\\n    // match nothing, since no id literally contains \\\"%\\\" or begins \\\"th_%\\\".\\n    const pct = await threads.resolve({ threadId: \\\"th%\\\", registryPath: store.registryPath });\\n    expect(pct.ok).toBe(false);\\n    if (!pct.ok) expect(pct.error.code).toBe(\\\"thread_not_found\\\");\\n  });\\n});\\n\\ndescribe(\\\"A-8: cwd-scoped listing and most-recent ordering\\\", () => {\\n  it(\\\"listThreads({cwd}) returns only that cwd's threads\\\", async () => {\\n    const a1 = await create({ cwd: \\\"/work/a\\\" });\\n    const a2 = await create({ cwd: \\\"/work/a\\\" });\\n    await create({ cwd: \\\"/work/b\\\" });\\n\\n    const scoped = await threads.listThreads({ cwd: \\\"/work/a\\\", registryPath: store.registryPath });\\n    expect(scoped.ok).toBe(true);\\n    if (scoped.ok) {\\n      expect(scoped.value).toHaveLength(2);\\n      expect(new Set(scoped.value.map((t) => t.threadId))).toEqual(new Set([a1, a2]));\\n      for (const t of scoped.value) expect(t.cwd).toBe(\\\"/work/a\\\");\\n    }\\n\\n    const all = await threads.listThreads({ registryPath: store.registryPath });\\n    expect(all.ok).toBe(true);\\n    if (all.ok) expect(all.value).toHaveLength(3);\\n  });\\n\\n  it(\\\"an empty cwd lists nothing without failing\\\", async () => {\\n    await create({ cwd: \\\"/work/a\\\" });\\n    const empty = await threads.listThreads({ cwd: \\\"/elsewhere\\\", registryPath: store.registryPath });\\n    expect(empty.ok).toBe(true);\\n    if (empty.ok) expect(empty.value).toEqual([]);\\n  });\\n\\n  it(\\\"the last listed thread is the most recently created (insertion-order tie-break)\\\", async () => {\\n    await create({ title: \\\"first\\\" });\\n    await create({ title: \\\"second\\\" });\\n    const last = await create({ title: \\\"third\\\" });\\n\\n    const listed = await threads.listThreads({ registryPath: store.registryPath });\\n    expect(listed.ok).toBe(true);\\n    if (listed.ok) {\\n      expect(listed.value).toHaveLength(3);\\n      expect(listed.value.at(-1)?.threadId).toBe(last);\\n    }\\n  });\\n});\\n\\ndescribe(\\\"A-8: lazy upgrade of a pre-cwd registry (migrate-on-read)\\\", () => {\\n  it(\\\"reads a v1 registry, upgrading it to carry the cwd column\\\", async () => {\\n    // Build a registry at the pre-A-8 v1 schema by hand (no cwd column).\\n    const db = openRaw(store.registryPath);\\n    db.exec(\\n      `CREATE TABLE threads (\\n        thread_id TEXT PRIMARY KEY,\\n        file_path TEXT NOT NULL,\\n        title TEXT,\\n        created_at TEXT NOT NULL\\n      );`,\\n    );\\n    db.exec(`PRAGMA user_version = 1;`);\\n    db.prepare(\\n      \\\"INSERT INTO threads (thread_id, file_path, title, created_at) VALUES (?, ?, ?, ?)\\\",\\n    ).run(\\\"th_legacy0000\\\", \\\"/tmp/legacy.sqlite\\\", \\\"legacy\\\", \\\"2026-01-01T00:00:00.000Z\\\");\\n    db.close();\\n\\n    // A read through the domain upgrades the schema and succeeds; the legacy\\n    // row reports cwd undefined.\\n    const resolved = await threads.resolve({ threadId: \\\"th_legacy0000\\\", registryPath: store.registryPath });\\n    expect(resolved.ok).toBe(true);\\n    if (resolved.ok) {\\n      expect(resolved.value.title).toBe(\\\"legacy\\\");\\n      expect(resolved.value.cwd).toBeUndefined();\\n    }\\n\\n    // The registry now carries the cwd column at the current version.\\n    const after = openRaw(store.registryPath);\\n    const columns = (\\n      after.prepare(\\\"PRAGMA table_info(threads)\\\").all() as unknown as Array<{ name: string }>\\n    ).map((c) => c.name);\\n    const version = after.prepare(\\\"PRAGMA user_version\\\").get() as unknown as { user_version: number };\\n    after.close();\\n    expect(columns).toContain(\\\"cwd\\\");\\n    expect(Number(version.user_version)).toBe(2);\\n  });\\n});\\n\",\"numLines\":190,\"startLine\":1,\"totalLines\":190}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:737:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01J8YvHMKVmDCBmvKWQMxDg4\",\"type\":\"tool_result\",\"content\":\"1\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n2\\timport {\\n3\\t  activate,\\n4\\t  createConnector,\\n5\\t  disposeInstance,\\n6\\t  EPIC_1_HOOKS,\\n7\\t  initInstance,\\n8\\t  resetSessionThreadMemory,\\n9\\t} from \\\"../../src/index.js\\\";\\n10\\timport { createSessionState } from \\\"../../src/lifecycle/state.js\\\";\\n11\\timport type { ExtensionAPI, ExtensionContext, PiHookName } from \\\"../../src/pi/types.js\\\";\\n12\\timport { makeAgentEnd, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\"../fixtures/synthetic.js\\\";\\n13\\timport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n14\\t\\n15\\tlet store: TempStore;\\n16\\tbeforeEach(() => {\\n17\\t  store = tempStore();\\n18\\t  resetSessionThreadMemory();\\n19\\t});\\n20\\tafterEach(() => {\\n21\\t  store.cleanup();\\n22\\t});\\n23\\t\\n24\\t// A fake ExtensionAPI that records what the extension registers.\\n25\\tfunction recordingPi(): {\\n26\\t  pi: ExtensionAPI;\\n27\\t  registered: PiHookName[];\\n28\\t  commands: string[];\\n29\\t  tools: string[];\\n30\\t} {\\n31\\t  const registered: PiHookName[] = [];\\n32\\t  const commands: string[] = [];\\n33\\t  const tools: string[] = [];\\n34\\t  const pi: ExtensionAPI = {\\n35\\t    registerHook(name) {\\n36\\t      registered.push(name);\\n37\\t    },\\n38\\t    registerCommand(name) {\\n39\\t      commands.push(name);\\n40\\t    },\\n41\\t    registerTool(tool) {\\n42\\t      tools.push(tool.name);\\n43\\t    },\\n44\\t    appendEntry() {},\\n45\\t  };\\n46\\t  return { pi, registered, commands, tools };\\n47\\t}\\n48\\t\\n49\\t// A synthetic per-hook ctx carrying METHODS (not plain data) and a unique\\n50\\t// marker — so a retained ctx would break the structuredClone plain-data guard.\\n51\\tfunction syntheticCtx(marker: string): ExtensionContext {\\n52\\t  return {\\n53\\t    cwd: `/tmp/${marker}`,\\n54\\t    hasUI: false,\\n55\\t    modelRegistry: {\\n56\\t      find: () => undefined,\\n57\\t      hasConfiguredAuth: () => false,\\n58\\t      getAvailable: () => [],\\n59\\t    },\\n60\\t    ui: { notify: () => {} },\\n61\\t    sessionManager: { getEntries: () => [] },\\n62\\t  };\\n63\\t}\\n64\\t\\n65\\tdescribe(\\\"extension load + hook rail\\\", () => {\\n66\\t  it(\\\"registers exactly the Epic 1 observe-only hook rail and not the context hook\\\", () => {\\n67\\t    const { pi, registered, commands, tools } = recordingPi();\\n68\\t    activate(pi);\\n69\\t\\n70\\t    expect(new Set(registered)).toEqual(new Set(EPIC_1_HOOKS));\\n71\\t    expect(registered).toHaveLength(9);\\n72\\t    expect(registered).not.toContain(\\\"context\\\"); // context serving is Epic 2\\n73\\t    // observe-only: no operator commands / agent tools registered yet (Epic 3)\\n74\\t    expect(commands).toEqual([]);\\n75\\t    expect(tools).toEqual([]);\\n76\\t  });\\n77\\t\\n78\\t  it(\\\"routes every hook to a guarded handler that never throws into PI and retains only plain data\\\", async () => {\\n79\\t    // Production defaults, but the registry/thread-file are redirected to a temp\\n80\\t    // store so the smoke test never writes the real ~/.lhc.\\n81\\t    const connector = createConnector({\\n82\\t      registryPath: store.registryPath,\\n83\\t      newThreadFilePath: () => store.threadPath(),\\n84\\t      parseLaunch: () => ({}),\\n85\\t    });\\n86\\t    // fire several hooks with DISTINCT ctx objects carrying methods\\n87\\t    await connector.handlers.session_start(syntheticCtx(\\\"ctx-1\\\"), makeSessionStart(\\\"startup\\\"));\\n88\\t    await connector.handlers.message_end(syntheticCtx(\\\"ctx-2\\\"), makeMessageEnd(makeUserMessage(\\\"hi\\\")));\\n89\\t    await connector.handlers.agent_end(syntheticCtx(\\\"ctx-3\\\"), makeAgentEnd([]));\\n90\\t\\n91\\t    // (the awaits above completing is the \\\"never throws into PI\\\" assertion)\\n92\\t    // retained state is plain data: structuredClone throws on a stored PI ctx (it\\n93\\t    // has methods); the live LhcInstance is held but excluded from the snapshot.\\n94\\t    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n95\\t  });\\n96\\t\\n97\\t  it(\\\"keeps SessionState plain-data-only — it survives structuredClone with every field populated\\\", () => {\\n98\\t    const state = createSessionState({ filePath: \\\"/tmp/thread.sqlite\\\" });\\n99\\t    state.flags.startupValidationReported = true;\\n100\\t    state.flags.toldUserAboutGap = true; // open index signature, still plain data\\n101\\t    state.health.lastCaptureFailure = { code: \\\"malformed_event\\\", message: \\\"bad shape\\\", recordedGap: true };\\n102\\t    state.health.startupValidation = { unreachable: [] };\\n103\\t\\n104\\t    const clone = structuredClone(state);\\n105\\t    expect(clone).toEqual(state);\\n106\\t    expect(clone).not.toBe(state);\\n107\\t  });\\n108\\t\\n109\\t  it(\\\"init/dispose seam is real and fails closed: init on a missing thread returns a typed error, dispose(null) is a no-op\\\", async () => {\\n110\\t    // No thread file at this path: init validates the thread before any SDK\\n111\\t    // construction, so it fails closed with a typed result — never a throw into\\n112\\t    // a PI hook. (Story 1 implements the seam; the full lifecycle behavior is\\n113\\t    // covered in test/lifecycle/*.)\\n114\\t    const initResult = await initInstance(\\n115\\t      { filePath: \\\"/tmp/pi-lhc-nonexistent-thread.sqlite\\\" },\\n116\\t      { mode: \\\"background\\\" },\\n117\\t    );\\n118\\t    expect(initResult.ok).toBe(false);\\n119\\t    if (!initResult.ok) {\\n120\\t      expect(initResult.error.code).toBe(\\\"thread_not_found\\\");\\n121\\t      expect(initResult.error.errorClass).toBe(\\\"caller_error\\\");\\n122\\t    }\\n123\\t\\n124\\t    // Disposing with no live instance is a successful no-op.\\n125\\t    const disposeResult = await disposeInstance(null);\\n126\\t    expect(disposeResult.ok).toBe(true);\\n127\\t  });\\n128\\t});\\n129\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"472872d9-430a-4b12-bcdc-7c8b7dc82fc9\",\"timestamp\":\"2026-06-14T05:28:30.806Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/test/smoke/extension-load.test.ts\",\"content\":\"import { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  activate,\\n  createConnector,\\n  disposeInstance,\\n  EPIC_1_HOOKS,\\n  initInstance,\\n  resetSessionThreadMemory,\\n} from \\\"../../src/index.js\\\";\\nimport { createSessionState } from \\\"../../src/lifecycle/state.js\\\";\\nimport type { ExtensionAPI, ExtensionContext, PiHookName } from \\\"../../src/pi/types.js\\\";\\nimport { makeAgentEnd, makeMessageEnd, makeSessionStart, makeUserMessage } from \\\"../fixtures/synthetic.js\\\";\\nimport { tempStore, type TempStore } from \\\"../fixtures/thread.js\\\";\\n\\nlet store: TempStore;\\nbeforeEach(() => {\\n  store = tempStore();\\n  resetSessionThreadMemory();\\n});\\nafterEach(() => {\\n  store.cleanup();\\n});\\n\\n// A fake ExtensionAPI that records what the extension registers.\\nfunction recordingPi(): {\\n  pi: ExtensionAPI;\\n  registered: PiHookName[];\\n  commands: string[];\\n  tools: string[];\\n} {\\n  const registered: PiHookName[] = [];\\n  const commands: string[] = [];\\n  const tools: string[] = [];\\n  const pi: ExtensionAPI = {\\n    registerHook(name) {\\n      registered.push(name);\\n    },\\n    registerCommand(name) {\\n      commands.push(name);\\n    },\\n    registerTool(tool) {\\n      tools.push(tool.name);\\n    },\\n    appendEntry() {},\\n  };\\n  return { pi, registered, commands, tools };\\n}\\n\\n// A synthetic per-hook ctx carrying METHODS (not plain data) and a unique\\n// marker — so a retained ctx would break the structuredClone plain-data guard.\\nfunction syntheticCtx(marker: string): ExtensionContext {\\n  return {\\n    cwd: `/tmp/${marker}`,\\n    hasUI: false,\\n    modelRegistry: {\\n      find: () => undefined,\\n      hasConfiguredAuth: () => false,\\n      getAvailable: () => [],\\n    },\\n    ui: { notify: () => {} },\\n    sessionManager: { getEntries: () => [] },\\n  };\\n}\\n\\ndescribe(\\\"extension load + hook rail\\\", () => {\\n  it(\\\"registers exactly the Epic 1 observe-only hook rail and not the context hook\\\", () => {\\n    const { pi, registered, commands, tools } = recordingPi();\\n    activate(pi);\\n\\n    expect(new Set(registered)).toEqual(new Set(EPIC_1_HOOKS));\\n    expect(registered).toHaveLength(9);\\n    expect(registered).not.toContain(\\\"context\\\"); // context serving is Epic 2\\n    // observe-only: no operator commands / agent tools registered yet (Epic 3)\\n    expect(commands).toEqual([]);\\n    expect(tools).toEqual([]);\\n  });\\n\\n  it(\\\"routes every hook to a guarded handler that never throws into PI and retains only plain data\\\", async () => {\\n    // Production defaults, but the registry/thread-file are redirected to a temp\\n    // store so the smoke test never writes the real ~/.lhc.\\n    const connector = createConnector({\\n      registryPath: store.registryPath,\\n      newThreadFilePath: () => store.threadPath(),\\n      parseLaunch: () => ({}),\\n    });\\n    // fire several hooks with DISTINCT ctx objects carrying methods\\n    await connector.handlers.session_start(syntheticCtx(\\\"ctx-1\\\"), makeSessionStart(\\\"startup\\\"));\\n    await connector.handlers.message_end(syntheticCtx(\\\"ctx-2\\\"), makeMessageEnd(makeUserMessage(\\\"hi\\\")));\\n    await connector.handlers.agent_end(syntheticCtx(\\\"ctx-3\\\"), makeAgentEnd([]));\\n\\n    // (the awaits above completing is the \\\"never throws into PI\\\" assertion)\\n    // retained state is plain data: structuredClone throws on a stored PI ctx (it\\n    // has methods); the live LhcInstance is held but excluded from the snapshot.\\n    expect(() => structuredClone(connector.snapshot())).not.toThrow();\\n  });\\n\\n  it(\\\"keeps SessionState plain-data-only — it survives structuredClone with every field populated\\\", () => {\\n    const state = createSessionState({ filePath: \\\"/tmp/thread.sqlite\\\" });\\n    state.flags.startupValidationReported = true;\\n    state.flags.toldUserAboutGap = true; // open index signature, still plain data\\n    state.health.lastCaptureFailure = { code: \\\"malformed_event\\\", message: \\\"bad shape\\\", recordedGap: true };\\n    state.health.startupValidation = { unreachable: [] };\\n\\n    const clone = structuredClone(state);\\n    expect(clone).toEqual(state);\\n    expect(clone).not.toBe(state);\\n  });\\n\\n  it(\\\"init/dispose seam is real and fails closed: init on a missing thread returns a typed error, dispose(null) is a no-op\\\", async () => {\\n    // No thread file at this path: init validates the thread before any SDK\\n    // construction, so it fails closed with a typed result — never a throw into\\n    // a PI hook. (Story 1 implements the seam; the full lifecycle behavior is\\n    // covered in test/lifecycle/*.)\\n    const initResult = await initInstance(\\n      { filePath: \\\"/tmp/pi-lhc-nonexistent-thread.sqlite\\\" },\\n      { mode: \\\"background\\\" },\\n    );\\n    expect(initResult.ok).toBe(false);\\n    if (!initResult.ok) {\\n      expect(initResult.error.code).toBe(\\\"thread_not_found\\\");\\n      expect(initResult.error.errorClass).toBe(\\\"caller_error\\\");\\n    }\\n\\n    // Disposing with no live instance is a successful no-op.\\n    const disposeResult = await disposeInstance(null);\\n    expect(disposeResult.ok).toBe(true);\\n  });\\n});\\n\",\"numLines\":129,\"startLine\":1,\"totalLines\":129}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:836:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01X4xK5dfkXpw3tKAuNKBTKc\",\"type\":\"tool_result\",\"content\":\"1\\t// The deterministic provider: marked, input-derived output for every seam\\n2\\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\\n3\\t// functions of the input. It backs the named-provider registry's\\n4\\t// \\\"deterministic\\\" entry (DD-11) so spawned-CLI tests exercise the production\\n5\\t// resolution seam, and the test double reuses these helpers so in-process and\\n6\\t// spawned runs produce byte-identical artifacts. It is selectable only by\\n7\\t// explicit name — never a production default.\\n8\\timport type {\\n9\\t  DerivationProvider,\\n10\\t  ProviderResult,\\n11\\t  RenderingPart,\\n12\\t  ToolOutcome,\\n13\\t  ToolRunReceipt,\\n14\\t} from \\\"../shared/derivation.js\\\";\\n15\\t\\n16\\texport type DeterministicOpName =\\n17\\t  | \\\"smoothPrompt\\\"\\n18\\t  | \\\"summarizeToolCall\\\"\\n19\\t  | \\\"summarizeToolResult\\\"\\n20\\t  | \\\"composeTurnRendering\\\"\\n21\\t  | \\\"projectLowerBand\\\"\\n22\\t  | \\\"summarizeChunkDetailed\\\"\\n23\\t  | \\\"summarizeChunkBrief\\\";\\n24\\t\\n25\\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\\n26\\t  smoothPrompt: \\\"smoothed\\\",\\n27\\t  summarizeToolCall: \\\"toolcall\\\",\\n28\\t  summarizeToolResult: \\\"toolresult\\\",\\n29\\t  composeTurnRendering: \\\"rendering\\\",\\n30\\t  projectLowerBand: \\\"projection\\\",\\n31\\t  summarizeChunkDetailed: \\\"detailed\\\",\\n32\\t  summarizeChunkBrief: \\\"brief\\\",\\n33\\t};\\n34\\t\\n35\\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\\n36\\t// input-sensitive enough that distinct inputs mark distinct outputs.\\n37\\texport function deterministicDigest(input: unknown): string {\\n38\\t  const text = JSON.stringify(input);\\n39\\t  let hash = 0x811c9dc5;\\n40\\t  for (let i = 0; i < text.length; i += 1) {\\n41\\t    hash ^= text.charCodeAt(i);\\n42\\t    hash = Math.imul(hash, 0x01000193) >>> 0;\\n43\\t  }\\n44\\t  return hash.toString(16).padStart(8, \\\"0\\\");\\n45\\t}\\n46\\t\\n47\\texport function deterministicText(\\n48\\t  op: DeterministicOpName,\\n49\\t  input: unknown,\\n50\\t  text: string,\\n51\\t): string {\\n52\\t  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\\n53\\t}\\n54\\t\\n55\\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\\n56\\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\\n57\\t}\\n58\\t\\n59\\t// The chunk-summary contract made visible in deterministic output (AC-3.8):\\n60\\t// the detailed summary's artifact carries the members' tool-run receipts —\\n61\\t// account and outcome — verbatim; the brief summary's carries outcomes\\n62\\t// only. Pure suffixes over the input fields, shared with the test double so\\n63\\t// in-process and spawned artifacts stay byte-identical; empty receipt sets\\n64\\t// add nothing, keeping receipt-less output unchanged.\\n65\\texport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\\n66\\t  const receipts = (memberReceipts ?? []).flat();\\n67\\t  if (receipts.length === 0) return \\\"\\\";\\n68\\t  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\\\"; \\\")}]`;\\n69\\t}\\n70\\t\\n71\\texport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\\n72\\t  const outcomes = (memberOutcomes ?? []).flat();\\n73\\t  if (outcomes.length === 0) return \\\"\\\";\\n74\\t  return `[outcomes ${outcomes.join(\\\",\\\")}]`;\\n75\\t}\\n76\\t\\n77\\texport function createDeterministicProvider(): DerivationProvider {\\n78\\t  return {\\n79\\t    smoothPrompt: (i: { text: string }) => ok(\\\"smoothPrompt\\\", i, i.text),\\n80\\t    summarizeToolCall: (i: {\\n81\\t      toolName: string;\\n82\\t      argsJson: string;\\n83\\t      pairedResult?: { content: string; isError: boolean };\\n84\\t    }) => ok(\\\"summarizeToolCall\\\", i, `${i.toolName} ${i.argsJson}`),\\n85\\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\\n86\\t      ok(\\\"summarizeToolResult\\\", i, i.content),\\n87\\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\\n88\\t      ok(\\\"composeTurnRendering\\\", i, i.parts.map((p) => p.text).join(\\\" | \\\")),\\n89\\t    projectLowerBand: (i: { rendering: string }) => ok(\\\"projectLowerBand\\\", i, i.rendering),\\n90\\t    summarizeChunkDetailed: async (i: {\\n91\\t      memberProjections: string[];\\n92\\t      memberReceipts?: ToolRunReceipt[][];\\n93\\t    }) => {\\n94\\t      const base = await ok(\\\"summarizeChunkDetailed\\\", i, i.memberProjections.join(\\\" | \\\"));\\n95\\t      if (!base.ok) return base;\\n96\\t      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\\n97\\t    },\\n98\\t    summarizeChunkBrief: async (i: {\\n99\\t      memberProjections: string[];\\n100\\t      memberOutcomes?: ToolOutcome[][];\\n101\\t    }) => {\\n102\\t      const base = await ok(\\\"summarizeChunkBrief\\\", i, i.memberProjections.join(\\\" | \\\"));\\n103\\t      if (!base.ok) return base;\\n104\\t      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\\n105\\t    },\\n106\\t  };\\n107\\t}\\n108\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"4e71c58c-d450-4d8b-851b-d7d50211fe3e\",\"timestamp\":\"2026-06-14T05:29:00.933Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/deterministic.ts\",\"content\":\"// The deterministic provider: marked, input-derived output for every seam\\n// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\\n// functions of the input. It backs the named-provider registry's\\n// \\\"deterministic\\\" entry (DD-11) so spawned-CLI tests exercise the production\\n// resolution seam, and the test double reuses these helpers so in-process and\\n// spawned runs produce byte-identical artifacts. It is selectable only by\\n// explicit name — never a production default.\\nimport type {\\n  DerivationProvider,\\n  ProviderResult,\\n  RenderingPart,\\n  ToolOutcome,\\n  ToolRunReceipt,\\n} from \\\"../shared/derivation.js\\\";\\n\\nexport type DeterministicOpName =\\n  | \\\"smoothPrompt\\\"\\n  | \\\"summarizeToolCall\\\"\\n  | \\\"summarizeToolResult\\\"\\n  | \\\"composeTurnRendering\\\"\\n  | \\\"projectLowerBand\\\"\\n  | \\\"summarizeChunkDetailed\\\"\\n  | \\\"summarizeChunkBrief\\\";\\n\\nexport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\\n  smoothPrompt: \\\"smoothed\\\",\\n  summarizeToolCall: \\\"toolcall\\\",\\n  summarizeToolResult: \\\"toolresult\\\",\\n  composeTurnRendering: \\\"rendering\\\",\\n  projectLowerBand: \\\"projection\\\",\\n  summarizeChunkDetailed: \\\"detailed\\\",\\n  summarizeChunkBrief: \\\"brief\\\",\\n};\\n\\n// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\\n// input-sensitive enough that distinct inputs mark distinct outputs.\\nexport function deterministicDigest(input: unknown): string {\\n  const text = JSON.stringify(input);\\n  let hash = 0x811c9dc5;\\n  for (let i = 0; i < text.length; i += 1) {\\n    hash ^= text.charCodeAt(i);\\n    hash = Math.imul(hash, 0x01000193) >>> 0;\\n  }\\n  return hash.toString(16).padStart(8, \\\"0\\\");\\n}\\n\\nexport function deterministicText(\\n  op: DeterministicOpName,\\n  input: unknown,\\n  text: string,\\n): string {\\n  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\\n}\\n\\nfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\\n  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\\n}\\n\\n// The chunk-summary contract made visible in deterministic output (AC-3.8):\\n// the detailed summary's artifact carries the members' tool-run receipts —\\n// account and outcome — verbatim; the brief summary's carries outcomes\\n// only. Pure suffixes over the input fields, shared with the test double so\\n// in-process and spawned artifacts stay byte-identical; empty receipt sets\\n// add nothing, keeping receipt-less output unchanged.\\nexport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\\n  const receipts = (memberReceipts ?? []).flat();\\n  if (receipts.length === 0) return \\\"\\\";\\n  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\\\"; \\\")}]`;\\n}\\n\\nexport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\\n  const outcomes = (memberOutcomes ?? []).flat();\\n  if (outcomes.length === 0) return \\\"\\\";\\n  return `[outcomes ${outcomes.join(\\\",\\\")}]`;\\n}\\n\\nexport function createDeterministicProvider(): DerivationProvider {\\n  return {\\n    smoothPrompt: (i: { text: string }) => ok(\\\"smoothPrompt\\\", i, i.text),\\n    summarizeToolCall: (i: {\\n      toolName: string;\\n      argsJson: string;\\n      pairedResult?: { content: string; isError: boolean };\\n    }) => ok(\\\"summarizeToolCall\\\", i, `${i.toolName} ${i.argsJson}`),\\n    summarizeToolResult: (i: { toolName: string; content: string }) =>\\n      ok(\\\"summarizeToolResult\\\", i, i.content),\\n    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\\n      ok(\\\"composeTurnRendering\\\", i, i.parts.map((p) => p.text).join(\\\" | \\\")),\\n    projectLowerBand: (i: { rendering: string }) => ok(\\\"projectLowerBand\\\", i, i.rendering),\\n    summarizeChunkDetailed: async (i: {\\n      memberProjections: string[];\\n      memberReceipts?: ToolRunReceipt[][];\\n    }) => {\\n      const base = await ok(\\\"summarizeChunkDetailed\\\", i, i.memberProjections.join(\\\" | \\\"));\\n      if (!base.ok) return base;\\n      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\\n    },\\n    summarizeChunkBrief: async (i: {\\n      memberProjections: string[];\\n      memberOutcomes?: ToolOutcome[][];\\n    }) => {\\n      const base = await ok(\\\"summarizeChunkBrief\\\", i, i.memberProjections.join(\\\" | \\\"));\\n      if (!base.ok) return base;\\n      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\\n    },\\n  };\\n}\\n\",\"numLines\":108,\"startLine\":1,\"totalLines\":108}}}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:864:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\" **\\\"It is selectable only by explicit name — never a production default.\\\"** Yet `defaultBuildSdkConfig()` uses it as the production `\"}},\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"parent_tool_use_id\":null,\"uuid\":\"7f507d0e-cae0-48bd-831b-8ddc64ceece4\"}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:867:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_013wenQYsGH2cLoar6mxLUWN\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Important finding: the deterministic provider's own header says **\\\"It is selectable only by explicit name — never a production default.\\\"** Yet `defaultBuildSdkConfig()` uses it as the production `activate()` default — directly contradicting that contract and exactly the kind of production-path smell a fresh verifier would flag. Let me examine the SDK config validation and the `inference` (ModelCall) alternative to choose a correct production placeholder.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2948,\"cache_read_input_tokens\":145626,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2948},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"b1c483c5-5192-48f6-b993-974e30f72848\",\"request_id\":\"req_011Cc2boYkv5LtFKb1T8se9u\"}\n./docs/specs/02-pi-lhc/01-connector-core/artifacts/01-session-lifecycle-and-thread-resolution/streams/010-implementor.stdout.log:1225:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_018bzR4j1RuARN4ywaL1pXwN\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc8b0d70-702e-4abc-9faa-dda18cc81eaf\",\"uuid\":\"50c77943-7803-4ef0-980f-7ae1a7634a91\",\"timestamp\":\"2026-06-14T05:32:04.225Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/pi-lhc/src/index.ts\",\"oldString\":\"import { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \\\"lhc\\\";\",\"newString\":\"import type {\\n  DerivationProvider,\\n  OpResult,\\n  ProviderResult,\\n  SdkConfig,\\n  ThreadRef,\\n} from \\\"lhc\\\";\",\"originalFile\":\"// Extension entry. PI loads this module and calls `activate(pi)`; it registers\\n// the Epic 1 observe-only hook rail and routes each hook to a fail-closed\\n// handler. The connector owns only plain-data `SessionState` plus the live\\n// `LhcInstance` it constructs per session — never a PI `ctx`/session object,\\n// which PI replaces on new/resume/fork (tech design Flow 1, plain-data rule).\\nimport { mkdirSync } from \\\"node:fs\\\";\\nimport { homedir } from \\\"node:os\\\";\\nimport { join } from \\\"node:path\\\";\\nimport { randomUUID } from \\\"node:crypto\\\";\\nimport { createDeterministicProvider, type OpResult, type SdkConfig, type ThreadRef } from \\\"lhc\\\";\\nimport type {\\n  ExtensionAPI,\\n  ExtensionContext,\\n  PiHookHandler,\\n  PiHookName,\\n} from \\\"./pi/types.js\\\";\\nimport type { CaptureFailureDiagnostic, SessionState } from \\\"./lifecycle/state.js\\\";\\nimport { createSessionState } from \\\"./lifecycle/state.js\\\";\\nimport { disposeInstance, initInstance } from \\\"./lifecycle/instance.js\\\";\\nimport {\\n  parseLaunchFlags,\\n  resolveThread,\\n  type LaunchFlags,\\n} from \\\"./lifecycle/thread-resolution.js\\\";\\nimport { pickThread, type ThreadChoice } from \\\"./lifecycle/picker.js\\\";\\nimport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\nexport { disposeInstance, initInstance, initLhc } from \\\"./lifecycle/instance.js\\\";\\nexport type { LhcInstance } from \\\"./shared/instance.js\\\";\\n\\n/** The Epic 1 observe-only hook rail: every PI hook the connector consumes.\\n *  Deliberately NOT `context` — context serving is Epic 2 and this epic\\n *  registers no handler for it (story Scope Out). */\\nexport const EPIC_1_HOOKS = [\\n  \\\"session_start\\\",\\n  \\\"message_end\\\",\\n  \\\"turn_end\\\",\\n  \\\"agent_end\\\",\\n  \\\"model_select\\\",\\n  \\\"thinking_level_select\\\",\\n  \\\"session_before_fork\\\",\\n  \\\"session_before_switch\\\",\\n  \\\"session_shutdown\\\",\\n] as const satisfies readonly PiHookName[];\\n\\nexport type Epic1Hook = (typeof EPIC_1_HOOKS)[number];\\n\\n/** What the connector needs from the host to run a session. Every dependency\\n *  has a working production default; the overrides exist for test isolation\\n *  (temp registry/thread, scripted launch/selection) and for Stories 5/6 to swap\\n *  in the PI-auth-backed inference config.\\n *\\n *  `buildSdkConfig` returns the SdkConfig the instance is constructed from. Its\\n *  default is the observe-only config below (a real, construction-valid SDK);\\n *  Stories 5/6 inject the PI-model-registry-backed `ModelCall` + assignments. */\\nexport interface ConnectorDeps {\\n  buildSdkConfig?: (ctx: ExtensionContext) => OpResult<SdkConfig>;\\n  registryPath?: string;\\n  newThreadFilePath?: () => string;\\n  parseLaunch?: () => LaunchFlags;\\n  selectThread?: (\\n    choices: readonly ThreadChoice[],\\n    ctx: ExtensionContext,\\n  ) => Promise<string | null>;\\n}\\n\\n/** Everything the connector retains across hooks as PLAIN data — by\\n *  construction structuredClone-able. The live `LhcInstance` is held separately\\n *  in the closure (it is the connector's own engine, rebuilt on reload) and is\\n *  deliberately not part of the snapshot. */\\nexport interface ConnectorSnapshot {\\n  state: SessionState | null;\\n  lastDiagnostic: CaptureFailureDiagnostic | null;\\n}\\n\\nexport interface Connector {\\n  /** Register the observe-only hook rail on the PI extension API. */\\n  register(pi: ExtensionAPI): void;\\n  /** The plain-data state retained across hooks. `null` until a session\\n   *  resolves a thread; never holds a PI ctx. */\\n  getState(): SessionState | null;\\n  /** The live LHC instance for the current session, or `null`. A test/inspection\\n   *  seam — held by the connector but never part of the plain-data snapshot. */\\n  getInstance(): LhcInstance | null;\\n  /** Plain-data snapshot of all retained state (inspection/test seam). */\\n  snapshot(): ConnectorSnapshot;\\n  /** The hook handlers, keyed by event — exposed so tests can drive them with\\n   *  synthetic ctx/events without a live PI. */\\n  readonly handlers: Readonly<Record<Epic1Hook, PiHookHandler<Epic1Hook>>>;\\n}\\n\\nconst DEFAULT_LHC_DIR = join(homedir(), \\\".lhc\\\");\\n\\n/** The production observe-only SDK config: a real, construction-valid instance\\n *  in background scheduler mode. Epic 1 is observe-only, so derivations are\\n *  never served to the model; in Story 1 specifically the connector does not yet\\n *  capture (message_end is a no-op until Story 2), so no derivation work is\\n *  queued and this provider is never invoked — it exists only to satisfy\\n *  construction (AC-1.1 \\\"initializes one LHC instance\\\"). Stories 5/6 replace it\\n *  with the PI-model-registry-backed `ModelCall` + assignments, which is what a\\n *  real *completing* inference requires (the `@earendil-works/pi-ai` completion\\n *  package is not yet a build dependency of this workspace). */\\nfunction defaultBuildSdkConfig(): OpResult<SdkConfig> {\\n  return { ok: true, value: { provider: createDeterministicProvider(), mode: \\\"background\\\" } };\\n}\\n\\n/** Default `--resume` selection (sufficient for Story 1): resume the most\\n *  recently created thread in the cwd. The choices arrive in creation order, so\\n *  the last is the most recent. An interactive operator picker awaits a PI input\\n *  surface (the local PI type stubs expose only `ui.notify`, no prompt); until\\n *  then this is the production selection, and tests drive an explicit choice\\n *  through the injected selector. */\\nfunction defaultSelectThread(choices: readonly ThreadChoice[]): Promise<string | null> {\\n  const mostRecent = choices.at(-1);\\n  return Promise.resolve(mostRecent === undefined ? null : mostRecent.threadId);\\n}\\n\\n/** Default new-thread file location: `~/.lhc/threads/<uuid>.sqlite`. The id is\\n *  generated by the registry at creation, so the file name is just a unique\\n *  handle; the directory is ensured up front (DatabaseSync does not create\\n *  parents). */\\nfunction defaultNewThreadFilePath(): string {\\n  const dir = join(DEFAULT_LHC_DIR, \\\"threads\\\");\\n  mkdirSync(dir, oundary.js\\\";\\nimport { profileViolation, resolveViewConfig } from \\\"./internal/profiles.js\\\";\\nimport {\\n  assembleBandText,\\n  renderBandMessage,\\n  renderTailMessage,\\n  toolNamesByCallId,\\n} from \\\"./internal/render.js\\\";\\nimport { fireViewInjection } from \\\"./internal/seam.js\\\";\\nimport {\\n  CanonicalCorruptionError,\\n  readSelectionInputs,\\n  selectArrangement,\\n  type ArrangementEntry,\\n} from \\\"./internal/select.js\\\";\\nimport {\\n  readReadyToolResultSummaries,\\n  readTailMessages,\\n  readViewSnapshot,\\n  replaceViewSnapshot,\\n  tailTokenSum,\\n} from \\\"./internal/snapshot.js\\\";\\nimport { estimateTokens } from \\\"../../tech-utils/token-counting/index.js\\\";\\nimport type { Band } from \\\"../../shared/view.js\\\";\\n\\n// Config resolution for the operation in hand: the SDK instance's resolved\\n// view config rides the per-instance seam (epic-fix-001 pattern, tech design\\n// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\\n// through the same one resolution path createSdk uses.\\nconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\\n\\nfunction viewConfig(): ResolvedViewConfig {\\n  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\\n}\\n\\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"caller_error\\\",\\n      code: \\\"thread_not_found\\\",\\n      reason: `no thread file exists at ${filePath}`,\\n    },\\n  };\\n}\\n\\nfunction detail(cause: unknown): string {\\n  return cause instanceof Error ? cause.message : String(cause);\\n}\\n\\n// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\\n\\n// The hot-path read: view header + bands (if any), tail messages after the\\n// compact point (deleted-filtered, record order), boundary position; then\\n// format — band messages first, tail per the mapping table, tool results\\n// at-or-behind the boundary in short form. No view row ⇒ the whole record is\\n// tail from event 1 (AC-1.3) through this same code path with the compact\\n// point at its zero origin — snapshot-absent, never a separate branch.\\n//\\n// Reads-only is structural, not disciplined: the whole operation runs in the\\n// touch-suppressed scope, so the open announcement that would let a\\n// background SDK's scheduler hang a first-touch catch-up drain off this read\\n// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\\n// AC-1.1's no-queue-interaction holds in both host modes.\\nexport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\\n  return runWithThreadTouchSuppressed(() => pullInner(ref));\\n}\\n\\nasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\\n  const resolved = await resolveThreadRef(ref);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    const snapshot = readViewSnapshot(db);\\n    const compactPoint = snapshot?.compactPoint ?? 0;\\n    const boundaryPosition = readBoundaryPosition(db);\\n    const tailRows = readTailMessages(db, compactPoint);\\n    const renderCtx = {\\n      boundaryPosition,\\n      toolNameByCallId: toolNamesByCallId(tailRows),\\n      toolResultSummaries: readReadyToolResultSummaries(db),\\n    };\\n\\n    const messages: ViewMessage[] = [];\\n    if (snapshot !== null) {\\n      for (const band of snapshot.bands) {\\n        messages.push(renderBandMessage(band.band, band.renderedText));\\n      }\\n    }\\n    for (const row of tailRows) {\\n      messages.push(renderTailMessage(row, renderCtx));\\n    }\\n\\n    return {\\n      ok: true,\\n      value: {\\n        messages,\\n        meta: {\\n          compactPoint: snapshot?.compactPoint ?? null,\\n          coveredFrom: snapshot?.coveredFrom ?? null,\\n          boundaryPosition,\\n          gapCount: snapshot?.gapCount ?? 0,\\n          degradedCount: snapshot?.degradedCount ?? 0,\\n          viewId: snapshot?.viewId ?? null,\\n          createdAt: snapshot?.createdAt ?? null,\\n        },\\n      },\\n    };\\n  } catch (cause) {\\n    return storageFailure(`view pull failed: ${detail(cause)}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// ── status (AC-2.8) ───────────────────────────────────────────────\\n\\n// Derivation counts bucket from one report entry the way the report's own\\n// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\\n// pending, retrying (pending with attempts spent), failed, blocked. Ready\\n// forms are healthy and not an operational situation.\\nfunction bucketDerivation(\\n  entries: readonly FormReportEntry[],\\n  counts: ViewStatus[\\\"derivation\\\"],\\n): void {\\n  for (const entry of entries) {\\n    switch (entry.state) {\\n      case \\\"pending\\\":\\n        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\\n        else counts.pending += 1;\\n        break;\\n      case \\\"failed\\\":\\n        counts.failed += 1;\\n        break;\\n      case \\\"blocked\\\":\\n        counts.blocked += 1;\\n        break;\\n      case \\\"ready\\\":\\n        break;\\n    }\\n  }\\n}\\n\\n// Reads only, callable any time, no side effects: tail size against the\\n// configured trigger threshold with a compact recommendation (`tailTokens >\\n// threshold`, nothing smarter — the caller owns policy), derivation counts\\n// by state read through the OWNERS' report surfaces (must-not-own: never a\\n// direct derived_form read here), the active view's health or null\\n// pre-compact, and the visibility zone's sum against its max — computed live\\n// by the same query the Story 4 advance will use, so \\\"visible in status\\\" is\\n// structural, not stored.\\n//\\n// Like pull, the whole read — including the owners' report surfaces it\\n// consumes — runs in the touch-suppressed scope, so a background SDK's\\n// status can never schedule a catch-up drain (AC-2.8 reads-only, both\\n// host modes).\\nexport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\\n  return runWithThreadTouchSuppressed(() => statusInner(ref));\\n}\\n\\nasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\\n  const resolved = await resolveThreadRef(ref);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const config = viewConfig();\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  let tailTokens: number;\\n  let zoneTokens: number;\\n  let view: ViewStatus[\\\"view\\\"];\\n  try {\\n    const snapshot = readViewSnapshot(db);\\n    const compactPoint = snapshot?.compactPoint ?? 0;\\n    const boundaryPosition = readBoundaryPosition(db);\\n    tailTokens = tailTokenSum(db, compactPoint);\\n    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\\n    view =\\n      snapshot === null\\n        ? null\\n        : {\\n            degraded: snapshot.degradedCount,\\n            gaps: snapshot.gapCount,\\n            builtAt: snapshot.createdAt,\\n          };\\n  } catch (cause) {\\n    return storageFailure(`view status failed: ${detail(cause)}`);\\n  } finally {\\n    db.close();\\n  }\\n\\n  // The owners' report surfaces open their own handles; ours is closed first\\n  // so the status read never holds two handles on one thread file.\\n  const messageReport = await messagesDomain.report({ filePath });\\n  if (!messageReport.ok) return messageReport;\\n  const turnReport = await turnsDomain.report({ filePath });\\n  if (!turnReport.ok) return turnReport;\\n  const derivation: ViewStatus[\\\"derivation\\\"] = {\\n    pending: 0,\\n    retrying: 0,\\n    failed: 0,\\n    blocked: 0,\\n  };\\n  bucketDerivation(messageReport.value, derivation);\\n  bucketDerivation(turnReport.value, derivation);\\n\\n  return {\\n    ok: true,\\n    value: {\\n      tailTokens,\\n      threshold: config.compactThreshold,\\n      compactRecommended: tailTokens > config.compactThreshold,\\n      derivation,\\n      view,\\n      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\\n    },\\n  };\\n}\\n\\n// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\\n\\n// The default base when no profile is named: the first built-in, matching\\n// the epic's primary user (the PI continuation harness). Explicit params\\n// override the base field-wise (AC-2.2).\\nconst DEFAULT_PROFILE_NAME = \\\"continuation\\\";\\n\\nfunction callerError(\\n  code: \\\"unknown_profile\\\" | \\\"invalid_view_config\\\",\\n  reason: string,\\n): { ok: false; error: ErrorResult } {\\n  return { ok: false, error: { errorClass: \\\"caller_error\\\", code, reason } };\\n}\\n\\nconst BAND_ORDER: readonly Band[] = [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"];\\n\\n// Compact runs only when invoked through this surface (AC-2.1: no code path\\n// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\\n// rejection provably touches nothing) → [sweep step ABSENT this story — the\\n// receipt's sweep field reports the literal \\\"absent\\\"; Story 3 embeds the\\n// real sweep here per stories/02-smart-compact.md §Scope out] → read record\\n// + forms with the corruption check in the reads (pre-transaction, prior\\n// view trivially intact on refusal) → selection walk → band rendering → one\\n// BEGIN IMMEDIATE replacing the view and resetting the boundary → receipt.\\n// Assembly is entirely from stored artifacts: nothing here can reach a\\n// provider (AC-2.4 zero-inference is structural).\\nexport async function compact(\\n  ref: ThreadRef,\\n  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\\n): Promise<OpResult<CompactReceipt>> {\\n  const resolved = await resolveThreadRef(ref);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const config = viewConfig();\\n  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\\n  const base = config.profiles[baseName];\\n  if (base === undefined) {\\n    return callerError(\\n      \\\"unknown_profile\\\",\\n      `unknown profile \\\"${baseName}\\\"; configured profiles are ${Object.keys(config.profiles)\\n        .map((name) => `\\\"${name}\\\"`)\\n        .join(\\\", \\\")}`,\\n    );\\n  }\\n  const merged: ViewProfile = {\\n    name: base.name,\\n    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\\n    percentages: { ...base.percentages, ...opts.params?.percentages },\\n  };\\n  const violation = profileViolation(merged);\\n  if (violation !== null) return callerError(\\\"invalid_view_config\\\", violation);\\n  // Receipt provenance: \\\"null when explicit params\\\" (tech design §Storage) —\\n  // any param override means the config is no longer a named profile's mix,\\n  // even when one served as the merge base; the receipt's config carries the\\n  // resolved truth. A bare or profile-only call names its profile.\\n  const profileName = opts.params === undefined ? baseName : null;\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    let inputs;\\n    try {\\n      inputs = readSelectionInputs(db);\\n    } catch (cause) {\\n      if (cause instanceof CanonicalCorruptionError) {\\n        // Pre-transaction refusal: nothing was written, the prior view and\\n        // the record are untouched (AC-2.5).\\n        return {\\n          ok: false,\\n          error: { errorClass: \\\"state_corruption\\\", code: cause.code, reason: cause.message },\\n        };\\n      }\\n      throw cause;\\n    }\\n    const selection = selectArrangement(inputs, {\\n      lowerBound: merged.lowerBound,\\n      percentages: merged.percentages,\\n    });\\n\\n    const entriesByBand = (band: Band): ArrangementEntry[] =>\\n      selection.entries.filter((entry) => entry.band === band);\\n    const bands = BAND_ORDER.flatMap((band) => {\\n      const entries = entriesByBand(band);\\n      if (entries.length === 0) return [];\\n      const renderedText = assembleBandText(entries.map((entry) => entry.text));\\n      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\\n    });\\n\\n    const createdAt = new Date().toISOString();\\n    // view_id is v<compact event order> — deterministic, and deliberately\\n    // reused by an intake-free recompact (tech design L395: do not \\\"fix\\\"\\n    // into a uniqueness scheme; the singleton row is replaced whole).\\n    const viewId = `v${inputs.maxEventOrder}`;\\n\\n    // Story-0 injection point: TC-2.4's crash between the (absent) sweep and\\n    // the view-write transaction. An installed hook's throw aborts here —\\n    // before BEGIN — so the previous view keeps serving.\\n    fireViewInjection(\\\"compact-write\\\");\\n\\n    replaceViewSnapshot(db, {\\n      viewId,\\n      createdAt,\\n      compactPoint: selection.compactPoint,\\n      coveredFrom: selection.coveredFrom,\\n      profileName,\\n      configJson: JSON.stringify({\\n        lowerBound: merged.lowerBound,\\n        percentages: merged.percentages,\\n      }),\\n      arrangementJson: JSON.stringify(\\n        selection.entries.map((entry) => ({\\n          band: entry.band,\\n          subjectKind: entry.subjectKind,\\n          subjectId: entry.subjectId,\\n          formUsed: entry.formUsed,\\n          degraded: entry.degraded,\\n        })),\\n      ),\\n      gapsJson: JSON.stringify(\\n        selection.entries\\n          .filter((entry) => entry.gap)\\n          .map((entry) => ({\\n            band: entry.band,\\n            subjectId: entry.subjectId,\\n            reason: entry.reason ?? \\\"unknown\\\",\\n          })),\\n      ),\\n      sourceStateJson: JSON.stringify({\\n        maxEventOrder: inputs.maxEventOrder,\\n        formCounts: inputs.formCounts,\\n      }),\\n      bands,\\n    });\\n\\n    const bandReport = {} as CompactReceipt[\\\"bands\\\"];\\n    for (const band of BAND_ORDER) {\\n      const stored = bands.find((row) => row.band === band);\\n      bandReport[band] = {\\n        entries: entriesByBand(band).length,\\n        tokens: stored?.tokenCount ?? 0,\\n      };\\n    }\\n    return {\\n      ok: true,\\n      value: {\\n        viewId,\\n        profile: profileName,\\n        config: { ...merged.percentages, lowerBound: merged.lowerBound },\\n        bands: bandReport,\\n        tailTokens: tailTokenSum(db, selection.compactPoint),\\n        coveredFrom: selection.coveredFrom,\\n        compactPoint: selection.compactPoint,\\n        degraded: selection.entries\\n          .filter((entry) => entry.degraded)\\n          .map((entry) => ({\\n            band: entry.band,\\n            subjectId: entry.subjectId,\\n            usedForm: entry.formUsed,\\n          })),\\n        gaps: selection.entries\\n          .filter((entry) => entry.gap)\\n          .map((entry) => ({\\n            band: entry.band,\\n            subjectId: entry.subjectId,\\n            reason: entry.reason ?? \\\"unknown\\\",\\n          })),\\n        // Sweep step absent this story (NOT skipped, NOT an empty receipt):\\n        // Story 3 embeds the sweep and flips this field's vocabulary.\\n        sweep: \\\"absent\\\",\\n      },\\n    };\\n  } catch (cause) {\\n    return storageFailure(`view compact failed: ${detail(cause)}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// ── stubs (Stories 3, 5) ─────────────────────────────────────────\\n\\n// The skeleton's stub contract (tech design §Interface Definitions):\\n// structured result, machine-readable, never a throw on this surface.\\nfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"system_error\\\",\\n      code: \\\"not_implemented\\\",\\n      reason: `not implemented: ${op}`,\\n    },\\n  };\\n}\\n\\nexport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\\n  void ref;\\n  return notImplemented(\\\"sweep\\\");\\n}\\n\\nexport async function materialize(\\n  ref: ThreadRef,\\n  opts: { path: string; format?: \\\"pi-session\\\" },\\n): Promise<OpResult<{ writtenPath: string }>> {\\n  void ref;\\n  void opts;\\n  return notImplemented(\\\"materialize\\\");\\n}\\n\\n// ── Story 0 substrate (consumed by createSdk at construction) ─────\\nexport {\\n  BUILT_IN_PROFILES,\\n  DEFAULT_COMPACT_THRESHOLD,\\n  DEFAULT_VISIBILITY,\\n  resolveViewConfig,\\n} from \\\"./internal/profiles.js\\\";\\n\",\"structuredPatch\":[{\"oldStart\":17,\"oldLines\":6,\"newStart\":17,\"newLines\":7,\"lines\":[\"   PullResult,\",\"   ResolvedViewConfig,\",\"   SweepReceipt,\",\"+  ViewCompactParams,\",\"   ViewMessage,\",\"   ViewProfile,\",\"   ViewStatus,\"]}],\"userModified\":false,\"replaceAll\":false}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3630:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01NHFeBWE2YM8wxTRLJAvUTU\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"uuid\":\"ae16046a-045e-4c2c-8f9c-7436645a7dfe\",\"timestamp\":\"2026-06-11T16:09:32.258Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts\",\"oldString\":\"import type {\\n  CompactReceipt,\\n  PullResult,\\n  SweepReceipt,\\n  ViewProfile,\\n  ViewStatus,\\n} from \\\"./shared/view.js\\\";\",\"newString\":\"import type {\\n  CompactReceipt,\\n  PullResult,\\n  SweepReceipt,\\n  ViewCompactParams,\\n  ViewProfile,\\n  ViewStatus,\\n} from \\\"./shared/view.js\\\";\",\"originalFile\":\"export * as threads from \\\"./domains/threads/index.js\\\";\\nexport * as intakeStream from \\\"./domains/intake-stream/index.js\\\";\\nexport * as messages from \\\"./domains/messages/index.js\\\";\\nexport * as turns from \\\"./domains/turns/index.js\\\";\\nexport * as threadView from \\\"./domains/thread-view/index.js\\\";\\n\\nimport * as intakeStreamDomain from \\\"./domains/intake-stream/index.js\\\";\\nimport * as threadViewDomain from \\\"./domains/thread-view/index.js\\\";\\nimport { resolveViewConfig } from \\\"./domains/thread-view/index.js\\\";\\nimport * as messagesDomain from \\\"./domains/messages/index.js\\\";\\nimport * as threadsDomain from \\\"./domains/threads/index.js\\\";\\nimport * as turnsDomain from \\\"./domains/turns/index.js\\\";\\nimport {\\n  createScheduler,\\n  peekThreadId,\\n  runDrain,\\n  type DrainDeps,\\n  type DrainReport,\\n  type Scheduler,\\n} from \\\"./scheduler.js\\\";\\nimport {\\n  runWithInstanceSeam,\\n  setSchedulerPoke as installSchedulerPoke,\\n  setThreadTouch,\\n  type InstanceSeam,\\n} from \\\"./shared/context.js\\\";\\nimport {\\n  PROVIDER_OPERATIONS,\\n  type ResolvedSdkConfig,\\n  type SdkConfig,\\n  type WorkHandler,\\n} from \\\"./shared/derivation.js\\\";\\nimport type { ErrorResult, OpResult } from \\\"./shared/errors.js\\\";\\nimport type {\\n  CompactReceipt,\\n  PullResult,\\n  SweepReceipt,\\n  ViewProfile,\\n  ViewStatus,\\n} from \\\"./shared/view.js\\\";\\nimport type { WorkKind } from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport {\\n  estimateTokens,\\n  TOKEN_ESTIMATOR_ID,\\n} from \\\"./tech-utils/token-counting/index.js\\\";\\n\\nexport {\\n  WORK_KIND_REGISTRY,\\n  type WorkItemRecord,\\n  type WorkKind,\\n  type WorkOwner,\\n  type WorkSourceRef,\\n} from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport type {\\n  ErrorClass,\\n  ErrorCode,\\n  ErrorResult,\\n  OpResult,\\n} from \\\"./shared/errors.js\\\";\\nexport {\\n  runInTransaction,\\n  setSchedulerPoke,\\n  setThreadTouch,\\n  type OperationContext,\\n} from \\\"./shared/context.js\\\";\\n\\nexport {\\n  createDeterministicProvider,\\n  deterministicOutcomesSuffix,\\n  deterministicReceiptsSuffix,\\n  deterministicText,\\n  type DeterministicOpName,\\n} from \\\"./providers/deterministic.js\\\";\\nexport { registeredProviderNames, resolveNamedProvider } from \\\"./providers/registry.js\\\";\\n\\nexport type {\\n  CompletionTx,\\n  DependencyGap,\\n  DerivationProvider,\\n  DerivedForm,\\n  DerivedFormMetadata,\\n  DerivedFormState,\\n  FormKind,\\n  FormReportEntry,\\n  HandlerFormWrite,\\n  HandlerOutcome,\\n  HandlerRunContext,\\n  ProviderResult,\\n  RenderingPart,\\n  ResolvedSdkConfig,\\n  SdkConfig,\\n  SubjectKind,\\n  ToolOutcome,\\n  ToolRunReceipt,\\n  WorkHandler,\\n} from \\\"./shared/derivation.js\\\";\\nexport type { DrainReport, Scheduler, SchedulerMode } from \\\"./scheduler.js\\\";\\n\\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\\n// from Story 0; the operation shapes land with Stories 1–5.\\nexport {\\n  BUILT_IN_PROFILES,\\n  DEFAULT_COMPACT_THRESHOLD,\\n  DEFAULT_VISIBILITY,\\n} from \\\"./domains/thread-view/index.js\\\";\\nexport type {\\n  Band,\\n  CompactReceipt,\\n  PullResult,\\n  ResolvedViewConfig,\\n  SdkViewConfig,\\n  SweepReceipt,\\n  ViewMessage,\\n  ViewMeta,\\n  ViewProfile,\\n  ViewProfileOverride,\\n  ViewStatus,\\n  VisibilityBudgets,\\n} from \\\"./shared/view.js\\\";\\nexport {\\n  countLiveItems,\\n  enqueue,\\n  queueDetail,\\n  supersedeQueued,\\n  type ClaimedWorkItem,\\n  type EnqueueFormTarget,\\n  type EnqueueInput,\\n  type QueueDetailRow,\\n} from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport type { ThreadRef } from \\\"./domains/threads/index.js\\\";\\nexport type {\\n  Block,\\n  BlockType,\\n  MessageRecord,\\n  MutationResult,\\n} from \\\"./domains/messages/index.js\\\";\\nexport type { ChunkRecord, TurnRecord } from \\\"./domains/turns/index.js\\\";\\nexport type {\\n  BatchResult,\\n  EventKind,\\n  EventRecord,\\n  MessageEventInput,\\n} from \\\"./domains/intake-stream/index.js\\\";\\n\\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\n\\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\n\\n// Merge per-domain handler tables into the one join between the queue's\\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\n// (each kind has exactly one owner) and throws at construction.\\nexport function assembleWorkHandlerMap(\\n  tables: ReadonlyArray<WorkHandlerMap>,\\n): WorkHandlerMap {\\n  const map: WorkHandlerMap = {};\\n  for (const table of tables) {\\n    for (const [kind, handler] of Object.entries(table)) {\\n      if (map[kind as WorkKind] !== undefined) {\\n        throw new TypeError(`work kind \\\"${kind}\\\" registered by more than one domain`);\\n      }\\n      map[kind as WorkKind] = handler;\\n    }\\n  }\\n  return map;\\n}\\n\\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"state_corruption\\\",\\n      code: \\\"unknown_work_kind\\\",\\n      reason: `no handler registered for work kind \\\"${kind}\\\"`,\\n    },\\n  };\\n}\\n\\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\nexport function lookupWorkHandler(\\n  map: WorkHandlerMap,\\n  kind: string,\\n): OpResult<WorkHandler> {\\n  const handler = map[kind as WorkKind];\\n  if (handler === undefined) return unknownWorkKind(kind);\\n  return { ok: true, value: handler };\\n}\\n\\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\n// requeue land in Story 4.\\nexport interface WorkSurface {\\n  drain(\\n    ref: threadsDomain.ThreadRef,\\n    opts?: { maxItems?: number },\\n  ): Promise<OpResult<DrainReport>>;\\n}\\n\\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\\n// §Interface Definitions): the five operations only — the Story 0 config\\n// substrate the domain index also carries is construction machinery, not an\\n// operation. pull and status are real from Story 1; compact, sweep, and\\n// materialize return structured not-implemented results until their stories\\n// land.\\nexport interface ThreadViewSurface {\\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\\n  compact(\\n    ref: threadsDomain.ThreadRef,\\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\\n  ): Promise<OpResult<CompactReceipt>>;\\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\\n  materialize(\\n    ref: threadsDomain.ThreadRef,\\n    opts: { path: string; format?: \\\"pi-session\\\" },\\n  ): Promise<OpResult<{ writtenPath: string }>>;\\n}\\n\\nexport interface Lhc {\\n  threads: typeof threadsDomain;\\n  intakeStream: typeof intakeStreamDomain;\\n  messages: typeof messagesDomain;\\n  turns: typeof turnsDomain;\\n  threadView: ThreadViewSurface;\\n  config: ResolvedSdkConfig;\\n  scheduler: Scheduler;\\n  workHandlers: WorkHandlerMap;\\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\n  work: WorkSurface;\\n  // Resolves when the scheduler has no running or pending drain for the\\n  // thread (issue 3) — the awaitable for background mode, and a no-op\\n  // resolve in manual mode.\\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\n}\\n\\nfunction requirePositive(value: number, name: string): void {\\n  if (!Number.isFinite(value) || value <= 0) {\\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\n  }\\n}\\n\\nfunction requireNonNegative(value: number, name: string): void {\\n  if (!Number.isFinite(value) || value < 0) {\\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\n  }\\n}\\n\\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\n// object is the same shape as the namespace, so the public surface type holds.\\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\n  const scoped: Record<string, unknown> = {};\\n  for (const key of Object.keys(surface)) {\\n    const value = (surface as Record<string, unknown>)[key];\\n    scoped[key] =\\n      typeof value === \\\"function\\\"\\n        ? (...args: unknown[]): unknown =>\\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\n        : value;\\n  }\\n  return scoped as T;\\n}\\n\\n// The only assembly path: provider, mode, clock, and policy enter here.\\n// Config mistakes are programmer errors at construction and throw; operating\\n// failures after construction return OpResults per the error contract.\\nexport function createSdk(config: SdkConfig): Lhc {\\n  if (config.mode !== \\\"background\\\" && config.mode !== \\\"manual\\\") {\\n    throw new TypeError(\\n      `createSdk config: mode must be \\\"background\\\" or \\\"manual\\\", got ${JSON.stringify(config.mode)}`,\\n    );\\n  }\\n  if (config.provider === null || typeof config.provider !== \\\"object\\\") {\\n    throw new TypeError(\\\"createSdk config: provider must implement DerivationProvider\\\");\\n  }\\n  for (const operation of PROVIDER_OPERATIONS) {\\n    if (typeof config.provider[operation] !== \\\"function\\\") {\\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\n    }\\n  }\\n\\n  const resolved: ResolvedSdkConfig = {\\n    provider: config.provider,\\n    mode: config.mode,\\n    clock: config.clock ?? (() => new Date()),\\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\n    lease: config.lease ?? { durationMs: 120000 },\\n    chunkPolicy:\\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\n    // sums and visibility budgets validated — throws naming the violation.\\n    view: resolveViewConfig(config.view),\\n  };\\n  requirePositive(resolved.retry.budget, \\\"retry.budget\\\");\\n  requireNonNegative(resolved.retry.backoffBaseMs, \\\"retry.backoffBaseMs\\\");\\n  requireNonNegative(resolved.retry.backoffCapMs, \\\"retry.backoffCapMs\\\");\\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\n    throw new TypeError(\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\");\\n  }\\n  requirePositive(resolved.lease.durationMs, \\\"lease.durationMs\\\");\\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\"chunkPolicy.targetProjectedTokens\\\");\\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\n    throw new TypeError(\\n      \\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\",\\n    );\\n  }\\n\\n  // Handler maps merge from per-domain contributions at construction (DD-6).\\n  // The tables are empty until Stories 2–3 land the real handlers; the\\n  // assembly mechanics are production code from day one.\\n  const workHandlers = assembleWorkHandlerMap([\\n    messagesDomain.workHandlers,\\n    turnsDomain.workHandlers,\\n  ]);\\n\\n  const drainDeps: DrainDeps = {\\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\n    config: resolved,\\n  };\\n  const scheduler = createScheduler(resolved.mode, drainDeps);\\n\\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\n  // background mode, or a no-op in manual mode — isolated from any other SDK\\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\\n  // the construction order, because its operations deliver to the no-op seam,\\n  // not to whatever a background SDK installed below.\\n  // The seam also carries this instance's resolved view config (Epic 03,\\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\\n  // fall back to the built-in defaults inside the thread-view surface.\\n  const seam: InstanceSeam =\\n    resolved.mode === \\\"background\\\"\\n      ? {\\n          poke: (threadId) => scheduler.poke(threadId),\\n          touch: (filePath, db) => scheduler.touch(filePath, db),\\n          view: resolved.view,\\n        }\\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\\n\\n  // Background mode also installs the below-SDK default seam so a direct\\n  // domain call made with no SDK scope — a top-level mutation in the\\n  // single-background \\\"production path\\\" — still reaches the one installed\\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\n  // leaves the default alone (pokes stay no-ops by contract).\\n  if (resolved.mode === \\\"background\\\") {\\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\n  }\\n\\n  const work: WorkSurface = {\\n    drain: (ref, opts) =>\\n      runWithInstanceSeam(seam, async () => {\\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n        if (!resolvedRef.ok) return resolvedRef;\\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\n      }),\\n  };\\n\\n  return {\\n    threads: threadsDomain,\\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\\n    messages: scopeSurface(messagesDomain, seam),\\n    turns: scopeSurface(turnsDomain, seam),\\n    threadView: scopeSurface<ThreadViewSurface>(\\n      {\\n        pull: threadViewDomain.pull,\\n        status: threadViewDomain.status,\\n        compact: threadViewDomain.compact,\\n        sweep: threadViewDomain.sweep,\\n        materialize: threadViewDomain.materialize,\\n      },\\n      seam,\\n    ),\\n    config: resolved,\\n    scheduler,\\n    workHandlers,\\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n    work,\\n    drainSettled: async (ref) => {\\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\n      const threadId = peekThreadId(resolvedRef.value.filePath);\\n      if (threadId === null) return;\\n      return scheduler.drainSettled(threadId);\\n    },\\n  };\\n}\\n\",\"structuredPatch\":[{\"oldStart\":35,\"oldLines\":6,\"newStart\":35,\"newLines\":7,\"lines\":[\"   CompactReceipt,\",\"   PullResult,\",\"   SweepReceipt,\",\"+  ViewCompactParams,\",\"   ViewProfile,\",\"   ViewStatus,\",\" } from \\\"./shared/view.js\\\";\"]}],\"userModified\":false,\"replaceAll\":false}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3679:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01VLfpinb5uRZ4JfvhTKjkRc\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"uuid\":\"730fb6f0-d039-4c71-8a04-f771edc33b3f\",\"timestamp\":\"2026-06-11T16:09:53.847Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts\",\"oldString\":\"  SweepReceipt,\\n  ViewMessage,\\n  ViewMeta,\\n  ViewProfile,\\n  ViewProfileOverride,\\n  ViewStatus,\\n  VisibilityBudgets,\\n} from \\\"./shared/view.js\\\";\",\"newString\":\"  SweepReceipt,\\n  ViewCompactParams,\\n  ViewMessage,\\n  ViewMeta,\\n  ViewProfile,\\n  ViewProfileOverride,\\n  ViewStatus,\\n  VisibilityBudgets,\\n} from \\\"./shared/view.js\\\";\",\"originalFile\":\"export * as threads from \\\"./domains/threads/index.js\\\";\\nexport * as intakeStream from \\\"./domains/intake-stream/index.js\\\";\\nexport * as messages from \\\"./domains/messages/index.js\\\";\\nexport * as turns from \\\"./domains/turns/index.js\\\";\\nexport * as threadView from \\\"./domains/thread-view/index.js\\\";\\n\\nimport * as intakeStreamDomain from \\\"./domains/intake-stream/index.js\\\";\\nimport * as threadViewDomain from \\\"./domains/thread-view/index.js\\\";\\nimport { resolveViewConfig } from \\\"./domains/thread-view/index.js\\\";\\nimport * as messagesDomain from \\\"./domains/messages/index.js\\\";\\nimport * as threadsDomain from \\\"./domains/threads/index.js\\\";\\nimport * as turnsDomain from \\\"./domains/turns/index.js\\\";\\nimport {\\n  createScheduler,\\n  peekThreadId,\\n  runDrain,\\n  type DrainDeps,\\n  type DrainReport,\\n  type Scheduler,\\n} from \\\"./scheduler.js\\\";\\nimport {\\n  runWithInstanceSeam,\\n  setSchedulerPoke as installSchedulerPoke,\\n  setThreadTouch,\\n  type InstanceSeam,\\n} from \\\"./shared/context.js\\\";\\nimport {\\n  PROVIDER_OPERATIONS,\\n  type ResolvedSdkConfig,\\n  type SdkConfig,\\n  type WorkHandler,\\n} from \\\"./shared/derivation.js\\\";\\nimport type { ErrorResult, OpResult } from \\\"./shared/errors.js\\\";\\nimport type {\\n  CompactReceipt,\\n  PullResult,\\n  SweepReceipt,\\n  ViewCompactParams,\\n  ViewProfile,\\n  ViewStatus,\\n} from \\\"./shared/view.js\\\";\\nimport type { WorkKind } from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport {\\n  estimateTokens,\\n  TOKEN_ESTIMATOR_ID,\\n} from \\\"./tech-utils/token-counting/index.js\\\";\\n\\nexport {\\n  WORK_KIND_REGISTRY,\\n  type WorkItemRecord,\\n  type WorkKind,\\n  type WorkOwner,\\n  type WorkSourceRef,\\n} from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport type {\\n  ErrorClass,\\n  ErrorCode,\\n  ErrorResult,\\n  OpResult,\\n} from \\\"./shared/errors.js\\\";\\nexport {\\n  runInTransaction,\\n  setSchedulerPoke,\\n  setThreadTouch,\\n  type OperationContext,\\n} from \\\"./shared/context.js\\\";\\n\\nexport {\\n  createDeterministicProvider,\\n  deterministicOutcomesSuffix,\\n  deterministicReceiptsSuffix,\\n  deterministicText,\\n  type DeterministicOpName,\\n} from \\\"./providers/deterministic.js\\\";\\nexport { registeredProviderNames, resolveNamedProvider } from \\\"./providers/registry.js\\\";\\n\\nexport type {\\n  CompletionTx,\\n  DependencyGap,\\n  DerivationProvider,\\n  DerivedForm,\\n  DerivedFormMetadata,\\n  DerivedFormState,\\n  FormKind,\\n  FormReportEntry,\\n  HandlerFormWrite,\\n  HandlerOutcome,\\n  HandlerRunContext,\\n  ProviderResult,\\n  RenderingPart,\\n  ResolvedSdkConfig,\\n  SdkConfig,\\n  SubjectKind,\\n  ToolOutcome,\\n  ToolRunReceipt,\\n  WorkHandler,\\n} from \\\"./shared/derivation.js\\\";\\nexport type { DrainReport, Scheduler, SchedulerMode } from \\\"./scheduler.js\\\";\\n\\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\\n// from Story 0; the operation shapes land with Stories 1–5.\\nexport {\\n  BUILT_IN_PROFILES,\\n  DEFAULT_COMPACT_THRESHOLD,\\n  DEFAULT_VISIBILITY,\\n} from \\\"./domains/thread-view/index.js\\\";\\nexport type {\\n  Band,\\n  CompactReceipt,\\n  PullResult,\\n  ResolvedViewConfig,\\n  SdkViewConfig,\\n  SweepReceipt,\\n  ViewMessage,\\n  ViewMeta,\\n  ViewProfile,\\n  ViewProfileOverride,\\n  ViewStatus,\\n  VisibilityBudgets,\\n} from \\\"./shared/view.js\\\";\\nexport {\\n  countLiveItems,\\n  enqueue,\\n  queueDetail,\\n  supersedeQueued,\\n  type ClaimedWorkItem,\\n  type EnqueueFormTarget,\\n  type EnqueueInput,\\n  type QueueDetailRow,\\n} from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport type { ThreadRef } from \\\"./domains/threads/index.js\\\";\\nexport type {\\n  Block,\\n  BlockType,\\n  MessageRecord,\\n  MutationResult,\\n} from \\\"./domains/messages/index.js\\\";\\nexport type { ChunkRecord, TurnRecord } from \\\"./domains/turns/index.js\\\";\\nexport type {\\n  BatchResult,\\n  EventKind,\\n  EventRecord,\\n  MessageEventInput,\\n} from \\\"./domains/intake-stream/index.js\\\";\\n\\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\n\\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\n\\n// Merge per-domain handler tables into the one join between the queue's\\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\n// (each kind has exactly one owner) and throws at construction.\\nexport function assembleWorkHandlerMap(\\n  tables: ReadonlyArray<WorkHandlerMap>,\\n): WorkHandlerMap {\\n  const map: WorkHandlerMap = {};\\n  for (const table of tables) {\\n    for (const [kind, handler] of Object.entries(table)) {\\n      if (map[kind as WorkKind] !== undefined) {\\n        throw new TypeError(`work kind \\\"${kind}\\\" registered by more than one domain`);\\n      }\\n      map[kind as WorkKind] = handler;\\n    }\\n  }\\n  return map;\\n}\\n\\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"state_corruption\\\",\\n      code: \\\"unknown_work_kind\\\",\\n      reason: `no handler registered for work kind \\\"${kind}\\\"`,\\n    },\\n  };\\n}\\n\\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\nexport function lookupWorkHandler(\\n  map: WorkHandlerMap,\\n  kind: string,\\n): OpResult<WorkHandler> {\\n  const handler = map[kind as WorkKind];\\n  if (handler === undefined) return unknownWorkKind(kind);\\n  return { ok: true, value: handler };\\n}\\n\\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\n// requeue land in Story 4.\\nexport interface WorkSurface {\\n  drain(\\n    ref: threadsDomain.ThreadRef,\\n    opts?: { maxItems?: number },\\n  ): Promise<OpResult<DrainReport>>;\\n}\\n\\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\\n// §Interface Definitions): the five operations only — the Story 0 config\\n// substrate the domain index also carries is construction machinery, not an\\n// operation. pull and status are real from Story 1; compact, sweep, and\\n// materialize return structured not-implemented results until their stories\\n// land.\\nexport interface ThreadViewSurface {\\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\\n  compact(\\n    ref: threadsDomain.ThreadRef,\\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\\n  ): Promise<OpResult<CompactReceipt>>;\\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\\n  materialize(\\n    ref: threadsDomain.ThreadRef,\\n    opts: { path: string; format?: \\\"pi-session\\\" },\\n  ): Promise<OpResult<{ writtenPath: string }>>;\\n}\\n\\nexport interface Lhc {\\n  threads: typeof threadsDomain;\\n  intakeStream: typeof intakeStreamDomain;\\n  messages: typeof messagesDomain;\\n  turns: typeof turnsDomain;\\n  threadView: ThreadViewSurface;\\n  config: ResolvedSdkConfig;\\n  scheduler: Scheduler;\\n  workHandlers: WorkHandlerMap;\\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\n  work: WorkSurface;\\n  // Resolves when the scheduler has no running or pending drain for the\\n  // thread (issue 3) — the awaitable for background mode, and a no-op\\n  // resolve in manual mode.\\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\n}\\n\\nfunction requirePositive(value: number, name: string): void {\\n  if (!Number.isFinite(value) || value <= 0) {\\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\n  }\\n}\\n\\nfunction requireNonNegative(value: number, name: string): void {\\n  if (!Number.isFinite(value) || value < 0) {\\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\n  }\\n}\\n\\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\n// object is the same shape as the namespace, so the public surface type holds.\\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\n  const scoped: Record<string, unknown> = {};\\n  for (const key of Object.keys(surface)) {\\n    const value = (surface as Record<string, unknown>)[key];\\n    scoped[key] =\\n      typeof value === \\\"function\\\"\\n        ? (...args: unknown[]): unknown =>\\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\n        : value;\\n  }\\n  return scoped as T;\\n}\\n\\n// The only assembly path: provider, mode, clock, and policy enter here.\\n// Config mistakes are programmer errors at construction and throw; operating\\n// failures after construction return OpResults per the error contract.\\nexport function createSdk(config: SdkConfig): Lhc {\\n  if (config.mode !== \\\"background\\\" && config.mode !== \\\"manual\\\") {\\n    throw new TypeError(\\n      `createSdk config: mode must be \\\"background\\\" or \\\"manual\\\", got ${JSON.stringify(config.mode)}`,\\n    );\\n  }\\n  if (config.provider === null || typeof config.provider !== \\\"object\\\") {\\n    throw new TypeError(\\\"createSdk config: provider must implement DerivationProvider\\\");\\n  }\\n  for (const operation of PROVIDER_OPERATIONS) {\\n    if (typeof config.provider[operation] !== \\\"function\\\") {\\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\n    }\\n  }\\n\\n  const resolved: ResolvedSdkConfig = {\\n    provider: config.provider,\\n    mode: config.mode,\\n    clock: config.clock ?? (() => new Date()),\\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\n    lease: config.lease ?? { durationMs: 120000 },\\n    chunkPolicy:\\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\n    // sums and visibility budgets validated — throws naming the violation.\\n    view: resolveViewConfig(config.view),\\n  };\\n  requirePositive(resolved.retry.budget, \\\"retry.budget\\\");\\n  requireNonNegative(resolved.retry.backoffBaseMs, \\\"retry.backoffBaseMs\\\");\\n  requireNonNegative(resolved.retry.backoffCapMs, \\\"retry.backoffCapMs\\\");\\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\n    throw new TypeError(\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\");\\n  }\\n  requirePositive(resolved.lease.durationMs, \\\"lease.durationMs\\\");\\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\"chunkPolicy.targetProjectedTokens\\\");\\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\n    throw new TypeError(\\n      \\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\",\\n    );\\n  }\\n\\n  // Handler maps merge from per-domain contributions at construction (DD-6).\\n  // The tables are empty until Stories 2–3 land the real handlers; the\\n  // assembly mechanics are production code from day one.\\n  const workHandlers = assembleWorkHandlerMap([\\n    messagesDomain.workHandlers,\\n    turnsDomain.workHandlers,\\n  ]);\\n\\n  const drainDeps: DrainDeps = {\\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\n    config: resolved,\\n  };\\n  const scheduler = createScheduler(resolved.mode, drainDeps);\\n\\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\n  // background mode, or a no-op in manual mode — isolated from any other SDK\\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\\n  // the construction order, because its operations deliver to the no-op seam,\\n  // not to whatever a background SDK installed below.\\n  // The seam also carries this instance's resolved view config (Epic 03,\\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\\n  // fall back to the built-in defaults inside the thread-view surface.\\n  const seam: InstanceSeam =\\n    resolved.mode === \\\"background\\\"\\n      ? {\\n          poke: (threadId) => scheduler.poke(threadId),\\n          touch: (filePath, db) => scheduler.touch(filePath, db),\\n          view: resolved.view,\\n        }\\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\\n\\n  // Background mode also installs the below-SDK default seam so a direct\\n  // domain call made with no SDK scope — a top-level mutation in the\\n  // single-background \\\"production path\\\" — still reaches the one installed\\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\n  // leaves the default alone (pokes stay no-ops by contract).\\n  if (resolved.mode === \\\"background\\\") {\\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\n  }\\n\\n  const work: WorkSurface = {\\n    drain: (ref, opts) =>\\n      runWithInstanceSeam(seam, async () => {\\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n        if (!resolvedRef.ok) return resolvedRef;\\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\n      }),\\n  };\\n\\n  return {\\n    threads: threadsDomain,\\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\\n    messages: scopeSurface(messagesDomain, seam),\\n    turns: scopeSurface(turnsDomain, seam),\\n    threadView: scopeSurface<ThreadViewSurface>(\\n      {\\n        pull: threadViewDomain.pull,\\n        status: threadViewDomain.status,\\n        compact: threadViewDomain.compact,\\n        sweep: threadViewDomain.sweep,\\n        materialize: threadViewDomain.materialize,\\n      },\\n      seam,\\n    ),\\n    config: resolved,\\n    scheduler,\\n    workHandlers,\\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n    work,\\n    drainSettled: async (ref) => {\\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\n      const threadId = peekThreadId(resolvedRef.value.filePath);\\n      if (threadId === null) return;\\n      return scheduler.drainSettled(threadId);\\n    },\\n  };\\n}\\n\",\"structuredPatch\":[{\"oldStart\":113,\"oldLines\":6,\"newStart\":113,\"newLines\":7,\"lines\":[\"   ResolvedViewConfig,\",\"   SdkViewConfig,\",\"   SweepReceipt,\",\"+  ViewCompactParams,\",\"   ViewMessage,\",\"   ViewMeta,\",\"   ViewProfile,\"]}],\"userModified\":false,\"replaceAll\":false}}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3698:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"query\\\": \\\"select:Monitor\"}},\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"parent_tool_use_id\":null,\"uuid\":\"534217c0-5861-469f-9b2c-0c2d049e0af8\"}\n./docs/specs/01-lhc-sdk/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3701:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_017KjMjrqHTkF8LtRYFGK9o8\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_014rdV86oVKXyLMz2XsUjKjt\",\"name\":\"ToolSearch\",\"input\":{\"query\":\"select:Monitor\",\"max_results\":1},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":251,\"cache_read_input_tokens\":296103,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":251},\"output_tokens\":63,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"sessio
 captured = double.captureInputs();\n   117\t    const sdk = sdkFor(double);\n   118\t    const filePath = await newThread();\n   119\t\n   120\t    const small = \"small-result \".repeat(100);\n   121\t    const mid = \"mid-result \".repeat(1500);\n   122\t    const batch = await send(sdk, filePath, [\n   123\t      validEvent(\"tool_call\", {\n   124\t        payload: { toolCallId: \"small\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n   125\t      }),\n   126\t      validEvent(\"tool_result\", {\n   127\t        payload: { toolCallId: \"small\", content: small, isError: false },\n   128\t      }),\n   129\t      validEvent(\"tool_call\", {\n   130\t        payload: { toolCallId: \"mid\", toolName: \"grep\", arguments: { pattern: \"TODO\" } },\n   131\t      }),\n   132\t      validEvent(\"tool_result\", {\n   133\t        payload: { toolCallId: \"mid\", content: mid, isError: true },\n   134\t      }),\n   135\t    ]);\n   136\t\n   137\t    expect(batch.queuedWork.map((item) => item.workItemId)).toEqual([\n   138\t      \"w-m2-tool_result_summary-v1\",\n   139\t      \"w-m4-tool_result_summary-v1\",\n   140\t    ]);\n   141\t    const report = await drain(sdk, filePath);\n   142\t    expect(report.ran.map((entry) => entry.disposition)).toEqual([\"done\", \"done\"]);\n   143\t\n   144\t    const calls = captured.filter((entry) => entry.op === \"summarizeToolResult\");\n   145\t    expect(calls).toHaveLength(2);\n   146\t    expect(calls[0]?.input).toMatchObject({\n   147\t      toolName: \"read_file\",\n   148\t      content: small,\n   149\t      outcome: \"succeeded\",\n   150\t      guidance: expect.stringContaining(\"paths\"),\n   151\t    });\n   152\t    expect(calls[1]?.input).toMatchObject({\n   153\t      toolName: \"grep\",\n   154\t      content: mid,\n   155\t      outcome: \"failed\",\n   156\t      guidance: expect.stringContaining(\"line numbers\"),\n   157\t    });\n   158\t    expect((calls[1]?.input as { targetTokens?: number }).targetTokens).toBeGreaterThan(\n   159\t      (calls[0]?.input as { targetTokens?: number }).targetTokens ?? 0,\n   160\t    );\n   161\t    expect(formOf(filePath, \"m4\", \"tool_result_summary\")?.metadata).toEqual({\n   162\t      outcome: \"failed\",\n   163\t    });\n   164\t  });\n   165\t\n   166\t  it(\"tool-call arguments render as recorded with no tool_call_summary derivation\", async () => {\n   167\t    const double = createProviderDouble();\n   168\t    const captured = double.captureInputs();\n   169\t    const sdk = sdkFor(double);\n   170\t    const filePath = await newThread();\n   171\t\n   172\t    await send(sdk, filePath, [\n   173\t      validEvent(\"user_prompt\", { payload: { text: \"run it\" } }),\n   174\t      validEvent(\"tool_call\", {\n   175\t        payload: { toolCallId: \"call\", toolName: \"exec\", arguments: { cmd: \"pnpm test\" } },\n   176\t      }),\n   177\t      validEvent(\"tool_result\", {\n   178\t        payload: { toolCallId: \"call\", content: \"passed\", isError: false },\n   179\t      }),\n   180\t      validEvent(\"turn_end\"),\n   181\t    ]);\n   182\t    await drain(sdk, filePath);\n   183\t\n   184\t    const derivationTypes = readDerivedForms(filePath).map((f) => f.derivationType);\n   185\t    expect(derivationTypes).not.toContain(\"tool_call_summary\");\n   186\t    const compose = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   187\t    const parts = (compose?.input as { parts?: Array<{ text: string }> } | undefined)?.parts ?? [];\n   188\t    expect(parts.map((part) => part.text).join(\"\\n\")).toContain('exec({\"cmd\":\"pnpm test\"})');\n   189\t  });\n   190\t\n   191\t  it(\"terminal in-threshold summary failure lands failed with reason while the source result remains intact\", async () => {\n   192\t    const double = createProviderDouble();\n   193\t    double.failKind(\"tool_result_summary\", 99, {\n   194\t      retryable: true,\n   195\t      reason: \"scripted tool summary failure\",\n   196\t    });\n   197\t    const sdk = sdkFor(double);\n   198\t    const filePath = await newThread();\n   199\t\n   200\t    await send(sdk, filePath, [\n   201\t      validEvent(\"tool_call\", {\n   202\t        payload: { toolCallId: \"fail\", toolName: \"read_file\", arguments: { path: \"x\" } },\n   203\t      }),\n   204\t      validEvent(\"tool_result\", {\n   205\t        payload: { toolCallId: \"fail\", content: \"short failure target\", isError: true },\n   206\t      }),\n   207\t    ]);\n   208\t    const report = await drain(sdk, filePath);\n   209\t    expect(report.ran).toEqual([\n   210\t      expect.objectContaining({\n   211\t        workItemId: \"w-m2-tool_result_summary-v1\",\n   212\t        disposition: \"failed_terminal\",\n   213\t        reason: \"scripted tool summary failure\",\n   214\t      }),\n   215\t    ]);\n   216\t    expect(formOf(filePath, \"m2\", \"tool_result_summary\")).toMatchObject({\n   217\t      state: \"failed\",\n   218\t      reason: \"scripted tool summary failure\",\n   219\t    });\n   220\t\n   221\t    const listed = await sdk.messages.listMessages({ filePath });\n   222\t    expect(listed.ok).toBe(true);\n   223\t    if (!listed.ok) return;\n   224\t    expect(listed.value.find((m) => m.messageId === \"m2\")?.blocks[0]?.content[\"content\"]).toBe(\n   225\t      \"short failure target\",\n   226\t    );\n   227\t  });\n   228\t});\n","exit_code":0,"status":"completed"}}

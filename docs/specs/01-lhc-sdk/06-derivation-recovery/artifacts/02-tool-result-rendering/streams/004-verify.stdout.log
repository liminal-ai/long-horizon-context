{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '138,196p'\"","aggregated_output":"   138\tconst DEFAULT_TOOL_RESULT_CONFIG: ResolvedSdkConfig[\"toolResult\"] = {\n   139\t  smallTierTokens: 1000,\n   140\t  largeTierTokens: 5000,\n   141\t  smallTargetRatio: 0.15,\n   142\t  midTargetRatio: 0.04,\n   143\t};\n   144\t\n   145\tfunction writeLargeToolResultSummaryReady(\n   146\t  ctx: OperationContext,\n   147\t  messageId: string,\n   148\t  config: ResolvedSdkConfig[\"toolResult\"],\n   149\t): boolean {\n   150\t  const row = ctx.db\n   151\t    .prepare(\n   152\t      `SELECT content FROM message_block\n   153\t       WHERE message_id = ? AND block_type = 'tool_result'\n   154\t       ORDER BY block_index LIMIT 1`,\n   155\t    )\n   156\t    .get(messageId) as { content: string } | undefined;\n   157\t  if (row === undefined) return false;\n   158\t  const block = JSON.parse(row.content) as Record<string, unknown>;\n   159\t  const content = block[\"content\"];\n   160\t  if (typeof content !== \"string\") return false;\n   161\t  if (estimateTokens(content) <= config.largeTierTokens) return false;\n   162\t  const metadata = JSON.stringify({ outcome: block[\"isError\"] === true ? \"failed\" : \"succeeded\" });\n   163\t  ctx.db\n   164\t    .prepare(\n   165\t      `INSERT INTO derivation\n   166\t         (subject_kind, subject_id, derivation_type, state, content, metadata, source_version, derived_at)\n   167\t       VALUES ('message', ?, 'tool_result_summary', 'ready', ?, ?, 1, ?)`,\n   168\t    )\n   169\t    .run(messageId, truncateForFallback(content), metadata, ctx.clock().toISOString());\n   170\t  return true;\n   171\t}\n   172\t\n   173\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   174\t// construction (DD-6): prompt smoothing and tool-result summaries.\n   175\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   176\t  messageWorkHandlers;\n   177\t\n   178\texport function queueMessageWork(\n   179\t  ctx: OperationContext,\n   180\t  message: MessageCreated,\n   181\t  toolResultConfig: ResolvedSdkConfig[\"toolResult\"] = DEFAULT_TOOL_RESULT_CONFIG,\n   182\t): WorkItemRecord[] {\n   183\t  if (message === null) return [];\n   184\t  const items: WorkItemRecord[] = [];\n   185\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   186\t  if (kind !== undefined) {\n   187\t    if (\n   188\t      message.kind === \"tool_result\" &&\n   189\t      writeLargeToolResultSummaryReady(ctx, message.messageId, toolResultConfig)\n   190\t    ) {\n   191\t      return items;\n   192\t    }\n   193\t    const form = MESSAGE_WORK_FORMS[kind];\n   194\t    if (form === undefined) {\n   195\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   196\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n","exit_code":0,"status":"completed"}}

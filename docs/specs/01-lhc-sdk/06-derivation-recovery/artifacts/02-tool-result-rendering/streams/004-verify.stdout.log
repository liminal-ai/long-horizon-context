{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/handlers.ts | sed -n '122,190p'\"","aggregated_output":"   122\tfunction toolResultTargetTokens(tokens: number, config: HandlerRunContext[\"config\"]): number {\n   123\t  const tier = config.toolResult;\n   124\t  const ratio =\n   125\t    tokens <= tier.smallTierTokens ? tier.smallTargetRatio : tier.midTargetRatio;\n   126\t  return Math.max(1, Math.ceil(tokens * ratio));\n   127\t}\n   128\t\n   129\tconst toolResultSummaryHandler: WorkHandler = async (run, item) => {\n   130\t  const loaded = loadSource(run, item, \"tool_result\");\n   131\t  if (!loaded.ok) return loaded.outcome;\n   132\t  const block = loaded.source.blocks[0]?.content ?? {};\n   133\t  const content = block[\"content\"];\n   134\t  if (typeof content !== \"string\") {\n   135\t    return sourceDamaged(`tool result ${loaded.messageId} has no tool_result block`);\n   136\t  }\n   137\t  const toolCallId = block[\"toolCallId\"];\n   138\t  const pairedCall =\n   139\t    typeof toolCallId === \"string\"\n   140\t      ? findPairedToolCall(run.openDb(), toolCallId)\n   141\t      : undefined;\n   142\t  // The summary abbreviates; the full result content stays untouched in the\n   143\t  // record (AC-2.3) — nothing here writes back to message_block. The result\n   144\t  // is tool activity, so its outcome is stamped from its own isError flag.\n   145\t  const tokens = estimateTokens(content);\n   146\t  const outcome = deriveToolOutcome({ isError: block[\"isError\"] === true });\n   147\t  if (tokens > run.config.toolResult.largeTierTokens) {\n   148\t    return {\n   149\t      ok: true,\n   150\t      derivations: [\n   151\t        {\n   152\t          subjectKind: \"message\",\n   153\t          subjectId: loaded.messageId,\n   154\t          derivationType: \"tool_result_summary\",\n   155\t          content: truncateForFallback(content),\n   156\t          metadata: { outcome },\n   157\t        },\n   158\t      ],\n   159\t    };\n   160\t  }\n   161\t  const targetTokens = toolResultTargetTokens(tokens, run.config);\n   162\t  if (tokens <= targetTokens) {\n   163\t    return {\n   164\t      ok: true,\n   165\t      derivations: [\n   166\t        {\n   167\t          subjectKind: \"message\",\n   168\t          subjectId: loaded.messageId,\n   169\t          derivationType: \"tool_result_summary\",\n   170\t          content,\n   171\t          metadata: { outcome },\n   172\t        },\n   173\t      ],\n   174\t    };\n   175\t  }\n   176\t  return landDerivation(\n   177\t    {\n   178\t      subjectKind: \"message\",\n   179\t      subjectId: loaded.messageId,\n   180\t      derivationType: \"tool_result_summary\",\n   181\t      content: \"\",\n   182\t      metadata: { outcome },\n   183\t    },\n   184\t    await run.provider.summarizeToolResult({\n   185\t      toolName: pairedCall?.toolName ?? \"unknown_tool\",\n   186\t      content,\n   187\t      outcome,\n   188\t      targetTokens,\n   189\t      guidance: toolResultGuidance(pairedCall?.toolName ?? \"unknown_tool\"),\n   190\t    }),\n","exit_code":0,"status":"completed"}}

am<T>(seam: InstanceSeam, fn: () => T): T {\npackages/lhc/src/shared/context.ts:104:// thread-view surface defaults those itself — see InstanceSeam.view).\npackages/lhc/src/shared/context.ts:119:  const base: InstanceSeam =\n","exit_code":0,"status":"completed"}}

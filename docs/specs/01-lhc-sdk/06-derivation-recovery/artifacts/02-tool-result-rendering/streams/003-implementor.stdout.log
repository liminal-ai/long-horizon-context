hunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\npackages/lhc/src/sdk.ts:454:      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\npackages/lhc/src/inference/prompts/index.ts:4:// changes. Versioning is in the name (`smoothing-v1`).\npackages/lhc/src/inference/prompts/index.ts:10:import { smoothingV1 } from \"./smoothing-v1.js\";\npackages/lhc/src/inference/prompts/index.ts:24:  [smoothingV1.name]: smoothingV1,\npackages/lhc/src/inference/prompts/index.ts:41:  smoothed_prompt: smoothingV1.name,\npackages/lhc/src/inference/prompts/smoothing-v1.ts:1:// SETTLED (AC-2.3): the POC's tuned smoothing prompt, ported verbatim from\npackages/lhc/src/inference/prompts/smoothing-v1.ts:2:// pi-long-horizon's pi-codex-user-prompt-smoothing-provider (tested\npackages/lhc/src/inference/prompts/smoothing-v1.ts:4:// rides along verbatim: LHC's smoothing input carries no literals list, so\npackages/lhc/src/inference/prompts/smoothing-v1.ts:9:export const smoothingV1: PromptTemplate<{ text: string }> = {\npackages/lhc/src/inference/prompts/smoothing-v1.ts:10:  name: \"smoothing-v1\",\npackages/lhc/src/shared/derivation.ts:186:  smoothing?: { maxInferenceTokens: number }; // 4000\npackages/lhc/src/shared/derivation.ts:188:  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\npackages/lhc/src/shared/derivation.ts:193:export interface ResolvedSdkConfig {\npackages/lhc/src/shared/derivation.ts:198:  smoothing: { maxInferenceTokens: number };\npackages/lhc/src/shared/derivation.ts:200:  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\npackages/lhc/src/shared/derivation.ts:209:  config: ResolvedSdkConfig;\npackages/lhc/src/shared/storage.ts:80:    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\npackages/lhc/src/scheduler.ts:20:  ResolvedSdkConfig,\npackages/lhc/src/scheduler.ts:62:  config: ResolvedSdkConfig;\npackages/lhc/src/domains/turns/internal/derive.ts:162:      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\npackages/lhc/src/domains/messages/index.ts:30:export { cleanPrompt } from \"./internal/smoothing.js\";\npackages/lhc/src/domains/messages/index.ts:122:// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\npackages/lhc/src/domains/messages/index.ts:130:  user_prompt: \"prompt_smoothing\",\npackages/lhc/src/domains/messages/index.ts:139:  prompt_smoothing: \"smoothed_prompt\",\npackages/lhc/src/domains/messages/index.ts:145:// construction (DD-6): prompt smoothing and the two tool-activity summaries.\npackages/lhc/src/domains/messages/index.ts:419:  smoothed_prompt: \"prompt_smoothing\",\npackages/lhc/src/tech-utils/work-queue/index.ts:25:  | \"prompt_smoothing\"\npackages/lhc/src/tech-utils/work-queue/index.ts:39:  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\npackages/lhc/src/tech-utils/work-queue/index.ts:192:  prompt_smoothing: [{ subjectKind: \"message\", derivationType: \"smoothed_prompt\" }],\npackages/lhc/src/domains/messages/internal/smoothing.ts:1:// Deterministic prompt floor for smoothing recovery. Pure by construction:\npackages/lhc/src/domains/messages/internal/handlers.ts:1:// The three message-level derivation handlers (Flow 2): prompt smoothing,\npackages/lhc/src/domains/messages/internal/handlers.ts:20:import { cleanPrompt } from \"./smoothing.js\";\npackages/lhc/src/domains/messages/internal/handlers.ts:84:  if (estimateTokens(cleaned) > run.config.smoothing.maxInferenceTokens) {\npackages/lhc/src/domains/messages/internal/handlers.ts:175:  prompt_smoothing: smoothPromptHandler,\npackages/lhc/src/domains/messages/internal/cascade.ts:37:  smoothed_prompt: \"prompt_smoothing\",\npackages/lhc/src/domains/messages/internal/forms.ts:165:        AND w.kind = CASE df.derivation_type WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.derivation_type END\n","exit_code":0,"status":"
summary and reads back whole through the Epic 01 surface\", async () => {\n    const big = \"result-bytes \".repeat(24000); // ~300KB\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n","exit_code":0,"status":"completed"}}

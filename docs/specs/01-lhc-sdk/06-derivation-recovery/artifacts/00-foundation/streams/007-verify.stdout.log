{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/derivation.ts'","aggregated_output":"     1\t// Epic 02 shared vocabulary: the derivation state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\t// Type-only and erased at build: the runtime graph stays one-directional\n     8\t// (inference/ imports shared/, never the reverse).\n     9\timport type { InferenceConfig } from \"../inference/types.js\";\n    10\timport type { ResolvedViewConfig, SdkViewConfig } from \"./view.js\";\n    11\t\n    12\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n    13\t\n    14\t// The kind set is a runtime constant with the type derived from it, so code\n    15\t// that must cover every kind — assignment validation above all (Epic 05\n    16\t// AC-1.3) — iterates the exported set instead of maintaining a second\n    17\t// literal list that can drift.\n    18\t// NOTE: tool_call_summary is retained here; its removal is Story 2's (AC-2.5).\n    19\texport const DERIVATION_TYPES = [\n    20\t  \"smoothed_prompt\",\n    21\t  \"tool_call_summary\",\n    22\t  \"tool_result_summary\",\n    23\t  \"turn_rendering\",\n    24\t  \"lower_band_projection\",\n    25\t  \"chunk_summary_detailed\",\n    26\t  \"chunk_summary_brief\",\n    27\t] as const;\n    28\t\n    29\texport type DerivationType = (typeof DERIVATION_TYPES)[number];\n    30\t\n    31\texport type DerivationState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    32\t\n    33\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    34\t// (isError/presence), never authored by the provider (AC-2.4).\n    35\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    36\t\n    37\t// A composed derivation's record of a dependency that fell back during composition:\n    38\t// names the source record and the derivation type that was not ready (AC-3.2/3.3).\n    39\texport interface DependencyGap {\n    40\t  subjectKind: SubjectKind;\n    41\t  subjectId: string;\n    42\t  derivationType: DerivationType;\n    43\t}\n    44\t\n    45\t// The read shape for one derivation's state row (DD-2, DD-3).\n    46\texport interface Derivation {\n    47\t  subjectKind: SubjectKind;\n    48\t  subjectId: string;\n    49\t  derivationType: DerivationType;\n    50\t  state: DerivationState;\n    51\t  content?: string; // ready only\n    52\t  reason?: string; // failed | blocked\n    53\t  sourceVersion: number; // which version of the source this derivation derives from (DD-3)\n    54\t  gaps?: DependencyGap[]; // composed derivations; landed-with-fallback record\n    55\t  metadata?: DerivationMetadata; // mechanically stamped fields; never provider-authored\n    56\t  derivedAt?: string;\n    57\t}\n    58\t\n    59\t// One tool call's or result's receipt within a turn's composed account\n    60\t// (AC-3.8): the account text — what changed, as composed — plus the\n    61\t// mechanically derived outcome. Derived from the composition input, never\n    62\t// from provider prose; stamped on the turn_rendering form so the chunk\n    63\t// summaries can read receipts machine-readably in turn order.\n    64\texport interface ToolRunReceipt {\n    65\t  messageId: string;\n    66\t  activity: \"tool_call\" | \"tool_result\";\n    67\t  account: string;\n    68\t  outcome: ToolOutcome;\n    69\t}\n    70\t\n    71\t// Mechanically stamped derivation metadata: tool outcomes (AC-2.4), the turn\n    72\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n    73\t// final attempts/last-error copied from the work item before its row is\n    74\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n    75\t// lives here).\n    76\texport interface DerivationMetadata {\n    77\t  outcome?: ToolOutcome;\n    78\t  receipts?: ToolRunReceipt[];\n    79\t  attempts?: number;\n    80\t  lastError?: string;\n    81\t  // Epic 05 (DD-4): which provider/model/prompt produced the content —\n    82\t  // copied from the ProviderResult's config-known strings, never authored\n    83\t  // from model output. The deterministic provider never sets it.\n    84\t  provenance?: ProviderProvenance;\n    85\t}\n    86\t\n    87\t// One row of an owner's repair report (Flow 4): the derivation's durable state\n    88\t// joined with the queue's mechanical detail for the live item still working\n    89\t// toward it, if any. The five operational situations read from this one row:\n    90\t// never-attempted (pending, no queue), retrying (pending + queue with\n    91\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n    92\t// ever needs a queue API.\n    93\texport interface DerivationReportEntry extends Derivation {\n    94\t  queue?: {\n    95\t    status: \"queued\" | \"claimed\";\n    96\t    attempts: number;\n    97\t    lastError?: string;\n    98\t    eligibleAt?: string;\n    99\t  };\n   100\t}\n   101\t\n   102\t// ── provider seam (DD-7) ─────────────────────────────────────────\n   103\t// Every operation returns content or a structured failure carrying\n   104\t// retryable-or-not; classification is the adapter's duty.\n   105\t// Provenance: the three config-known assignment strings, stamped by the\n   106\t// inference adapter (it alone knows the assignment) and copied by handlers\n   107\t// into derivation metadata (Epic 05 DD-4). Never derived from model output.\n   108\texport interface ProviderProvenance {\n   109\t  provider: string;\n   110\t  model: string;\n   111\t  prompt: string;\n   112\t}\n   113\t\n   114\texport type ProviderResult =\n   115\t  | { ok: true; text: string; provenance?: ProviderProvenance }\n   116\t  | { ok: false; retryable: boolean; reason: string };\n   117\t\n   118\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n   119\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n   120\t// rather than imported: shared/ may not import domains/.\n   121\texport type RenderingPartKind =\n   122\t  | \"user_prompt\"\n   123\t  | \"assistant_text\"\n   124\t  | \"assistant_thinking\"\n   125\t  | \"runtime_note\"\n   126\t  | \"tool_call\"\n   127\t  | \"tool_result\";\n   128\t\n   129\texport interface RenderingPart {\n   130\t  messageId: string;\n   131\t  kind: RenderingPartKind;\n   132\t  text: string; // ready derivation content, or raw/truncated fallback\n   133\t  fallback: boolean; // true ⇒ gap recorded\n   134\t  outcome?: ToolOutcome; // tool activity only\n   135\t}\n   136\t\n   137\texport interface DerivationProvider {\n   138\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n   139\t  summarizeToolCall(i: {\n   140\t    toolName: string;\n   141\t    argsJson: string;\n   142\t    pairedResult?: { content: string; isError: boolean };\n   143\t  }): Promise<ProviderResult>;\n   144\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n   145\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n   146\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n   147\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n   148\t  // the members' tool-run receipts (what changed, outcome) alongside the\n   149\t  // projections; brief receives outcomes only — receipt text is stripped\n   150\t  // before the provider is called, so brief structurally cannot leak it.\n   151\t  // The receipt fields are optional in the type for callers without member\n   152\t  // context (the production chunk handlers always pass them).\n   153\t  summarizeChunkDetailed(i: {\n   154\t    memberProjections: string[];\n   155\t    memberReceipts?: ToolRunReceipt[][];\n   156\t  }): Promise<ProviderResult>;\n   157\t  summarizeChunkBrief(i: {\n   158\t    memberProjections: string[];\n   159\t    memberOutcomes?: ToolOutcome[][];\n   160\t  }): Promise<ProviderResult>;\n   161\t}\n   162\t\n   163\texport const PROVIDER_OPERATIONS = [\n   164\t  \"smoothPrompt\",\n   165\t  \"summarizeToolCall\",\n   166\t  \"summarizeToolResult\",\n   167\t  \"composeTurnRendering\",\n   168\t  \"projectLowerBand\",\n   169\t  \"summarizeChunkDetailed\",\n   170\t  \"summarizeChunkBrief\",\n   171\t] as const;\n   172\t\n   173\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n   174\t\n   175\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n   176\t// Provider arrival is exactly one of `provider` (direct injection,\n   177\t// unchanged — the deterministic test default) or `inference` (host\n   178\t// model-call function + per-kind assignments, Epic 05 DD-5). Both or\n   179\t// neither is a construction TypeError naming the XOR rule (AC-1.1).\n   180\texport interface SdkConfig {\n   181\t  provider?: DerivationProvider;\n   182\t  inference?: InferenceConfig;\n   183\t  mode: \"background\" | \"manual\";\n   184\t  clock?: () => Date;\n   185\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n   186\t  lease?: { durationMs: number }; // 120000\n   187\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n   188\t  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\n   189\t}\n   190\t\n   191\t// Every optional filled by createSdk's central defaults.\n   192\texport interface ResolvedSdkConfig {\n   193\t  provider: DerivationProvider;\n   194\t  mode: \"background\" | \"manual\";\n   195\t  clock: () => Date;\n   196\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n   197\t  lease: { durationMs: number };\n   198\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n   199\t  view: ResolvedViewConfig;\n   200\t}\n   201\t\n   202\t// ── handler contract (DD-6; the map's value type) ────────────────\n   203\texport interface HandlerRunContext {\n   204\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n   205\t  provider: DerivationProvider;\n   206\t  clock: () => Date;\n   207\t  config: ResolvedSdkConfig;\n   208\t}\n   209\t\n   210\t// A successful handler hands its derivation content back as data; the\n   211\t// drain's completion transaction performs the version-checked UPDATE and the\n   212\t// item-row deletion atomically (tech design §Mechanics: completion is one\n   213\t// short BEGIN IMMEDIATE doing the derivation write and the delete). The handler\n   214\t// never opens that transaction itself, so the version check and the\n   215\t// done/stale_discarded disposition stay in one place — the queue util.\n   216\texport interface HandlerDerivationWrite {\n   217\t  subjectKind: SubjectKind;\n   218\t  subjectId: string;\n   219\t  derivationType: DerivationType;\n   220\t  content: string;\n   221\t  metadata?: DerivationMetadata;\n   222\t  gaps?: DependencyGap[];\n   223\t}\n   224\t\n   225\t// The completion-transaction hook (Story 3): work that must land atomically\n   226\t// with the version-checked derivation writes — chunk placement and the\n   227\t// close→summary enqueues above all. The queue util invokes it inside the\n   228\t// completion's BEGIN IMMEDIATE, after the derivation writes and only when they hit\n   229\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n   230\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n   231\t// crash leaves either a placed turn with its enqueues or nothing — never a\n   232\t// derived-but-unplaced turn.\n   233\texport interface CompletionTx {\n   234\t  db: DatabaseSync;\n   235\t  onCommit: (fn: () => void) => void;\n   236\t}\n   237\t\n   238\texport type HandlerOutcome =\n   239\t  | { ok: true; derivations?: HandlerDerivationWrite[]; onApplied?: (tx: CompletionTx) => void }\n   240\t  | { ok: false; retryable: boolean; reason: string }\n   241\t  | { ok: false; blocked: true; reason: string }; // source damage → derivation blocked, item terminal\n   242\t\n   243\t// item is the queue util's WorkItemRecord; typed structurally here so the\n   244\t// shared layer does not depend on the util's module (and vice versa stays\n   245\t// one-directional: tech-utils imports shared).\n   246\texport type WorkHandler = (\n   247\t  run: HandlerRunContext,\n   248\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n   249\t) => Promise<HandlerOutcome>;\n","exit_code":0,"status":"completed"}}

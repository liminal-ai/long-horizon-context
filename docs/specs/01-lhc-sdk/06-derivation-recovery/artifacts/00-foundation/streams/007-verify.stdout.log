{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/thread-migration.test.ts'","aggregated_output":"     1\t// F-03-001: an existing valid Story 2 thread file (user_version=1, only\n     2\t// thread_metadata/event tables) must be migrated to the current schema before\n     3\t// any Story 3 message write or read. The fixture reproduces the accepted\n     4\t// Story 2 on-disk layout exactly; the assertions go through the production\n     5\t// entry points (messageEvents, listMessages, listEvents) plus below-SDK\n     6\t// schema-version reads.\n     7\t// F-03-002: the lazy opener must reject existing files that are not thread\n     8\t// files without creating lhc schema or bumping user_version on them.\n     9\timport { readFileSync, writeFileSync } from \"node:fs\";\n    10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    11\timport { intakeStream, messages, turns } from \"../src/index.js\";\n    12\timport {\n    13\t  legacyEpic01ThreadFile,\n    14\t  legacyEpic02ThreadFile,\n    15\t  legacyStory2ThreadFile,\n    16\t  openRaw,\n    17\t  readDerivedForms,\n    18\t  schemaVersionOf,\n    19\t  tempStore,\n    20\t  validEvent,\n    21\t  type TempStore,\n    22\t} from \"./fixtures/index.js\";\n    23\t\n    24\tlet store: TempStore;\n    25\tbeforeEach(() => {\n    26\t  store = tempStore();\n    27\t});\n    28\tafterEach(() => {\n    29\t  store.cleanup();\n    30\t});\n    31\t\n    32\tconst legacyEvent = {\n    33\t  eventOrder: 1,\n    34\t  eventKind: \"user_prompt\",\n    35\t  idempotencyKey: \"legacy-key-1\",\n    36\t  actor: \"legacy-actor\",\n    37\t  harness: \"legacy-harness\",\n    38\t  payload: { text: \"recorded before story 3 shipped\" },\n    39\t  recordedAt: \"2026-06-01T00:00:01.000Z\",\n    40\t};\n    41\t\n    42\tdescribe(\"F-03-001: Story 2 thread files migrate before message write/read\", () => {\n    43\t  it(\"messageEvents on a Story 2 file upgrades the schema, keeps the legacy record intact, and projects the new events\", async () => {\n    44\t    const filePath = store.threadPath();\n    45\t    legacyStory2ThreadFile(filePath, \"th_legacy01\", [legacyEvent]);\n    46\t    expect(schemaVersionOf(filePath)).toBe(1);\n    47\t\n    48\t    const result = await intakeStream.messageEvents({ filePath }, [\n    49\t      validEvent(\"assistant_text\", { payload: { text: \"answered after upgrade\" } }),\n    50\t      validEvent(\"turn_end\"),\n    51\t    ]);\n    52\t    expect(result.ok).toBe(true);\n    53\t    if (!result.ok) return;\n    54\t    expect(result.value.events.map((entry) => entry.outcome)).toEqual([\n    55\t      \"recorded\",\n    56\t      \"recorded\",\n    57\t    ]);\n    58\t    // The order counter continues from the legacy record; the new message id\n    59\t    // derives from the continued order.\n    60\t    expect(result.value.threadPosition.lastEventOrder).toBe(3);\n    61\t    expect(result.value.events[0]!.messageId).toBe(\"m2\");\n    62\t\n    63\t    expect(schemaVersionOf(filePath)).toBe(7);\n    64\t\n    65\t    // The legacy event survives the upgrade byte-for-byte at the SDK level.\n    66\t    const events = await intakeStream.listEvents({ filePath });\n    67\t    expect(events.ok).toBe(true);\n    68\t    if (!events.ok) return;\n    69\t    expect(events.value).toHaveLength(3);\n    70\t    expect(events.value[0]).toEqual({\n    71\t      eventKind: \"user_prompt\",\n    72\t      idempotencyKey: \"legacy-key-1\",\n    73\t      actor: \"legacy-actor\",\n    74\t      harness: \"legacy-harness\",\n    75\t      payload: { text: \"recorded before story 3 shipped\" },\n    76\t      eventOrder: 1,\n    77\t      recordedAt: \"2026-06-01T00:00:01.000Z\",\n    78\t    });\n    79\t\n    80\t    // Projection is intake-time, not retroactive: the new assistant_text\n    81\t    // projects; the legacy pre-Story-3 event stays event-only.\n    82\t    const projected = await messages.listMessages({ filePath });\n    83\t    expect(projected.ok).toBe(true);\n    84\t    if (!projected.ok) return;\n    85\t    expect(projected.value).toHaveLength(1);\n    86\t    expect(projected.value[0]!.messageId).toBe(\"m2\");\n    87\t    expect(projected.value[0]!.sourceEventOrder).toBe(2);\n    88\t    expect(projected.value[0]!.blocks).toEqual([\n    89\t      { blockType: \"text\", content: { text: \"answered after upgrade\" } },\n    90\t    ]);\n    91\t    expect(projected.value[0]!.tokenEstimate).toBeGreaterThan(0);\n    92\t  });\n    93\t\n    94\t  it(\"listMessages on an untouched Story 2 file migrates on read and returns an empty list\", async () => {\n    95\t    const filePath = store.threadPath();\n    96\t    legacyStory2ThreadFile(filePath, \"th_legacy02\", [legacyEvent]);\n    97\t    expect(schemaVersionOf(filePath)).toBe(1);\n    98\t\n    99\t    const projected = await messages.listMessages({ filePath });\n   100\t    expect(projected.ok).toBe(true);\n   101\t    if (!projected.ok) return;\n   102\t    expect(projected.value).toEqual([]);\n   103\t\n   104\t    expect(schemaVersionOf(filePath)).toBe(7);\n   105\t\n   106\t    // The read-path upgrade changed no record content.\n   107\t    const events = await intakeStream.listEvents({ filePath });\n   108\t    expect(events.ok).toBe(true);\n   109\t    if (!events.ok) return;\n   110\t    expect(events.value).toHaveLength(1);\n   111\t    expect(events.value[0]!.idempotencyKey).toBe(\"legacy-key-1\");\n   112\t  });\n   113\t\n   114\t  it(\"idempotency keys recorded under Story 2 still skip after the upgrade\", async () => {\n   115\t    const filePath = store.threadPath();\n   116\t    legacyStory2ThreadFile(filePath, \"th_legacy03\", [legacyEvent]);\n   117\t\n   118\t    const resend = await intakeStream.messageEvents({ filePath }, [\n   119\t      validEvent(\"user_prompt\", {\n   120\t        idempotencyKey: \"legacy-key-1\",\n   121\t        payload: { text: \"resent after upgrade\" },\n   122\t      }),\n   123\t    ]);\n   124\t    expect(resend.ok).toBe(true);\n   125\t    if (!resend.ok) return;\n   126\t    expect(resend.value.events[0]).toEqual({\n   127\t      idempotencyKey: \"legacy-key-1\",\n   128\t      outcome: \"skipped\",\n   129\t      skipReason: \"duplicate_idempotency_key\",\n   130\t    });\n   131\t\n   132\t    // No message was created for the skipped resend of the legacy event.\n   133\t    const projected = await messages.listMessages({ filePath });\n   134\t    expect(projected.ok).toBe(true);\n   135\t    if (!projected.ok) return;\n   136\t    expect(projected.value).toEqual([]);\n   137\t  });\n   138\t});\n   139\t\n   140\t// Tables present in a file, by name — asserts what schema (if any) the\n   141\t// rejected open left behind.\n   142\tfunction tableNames(filePath: string): string[] {\n   143\t  const db = openRaw(filePath);\n   144\t  try {\n   145\t    const rows = db\n   146\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name\")\n   147\t      .all() as unknown as Array<{ name: string }>;\n   148\t    return rows.map((row) => row.name);\n   149\t  } finally {\n   150\t    db.close();\n   151\t  }\n   152\t}\n   153\t\n   154\tdescribe(\"F-03-002: non-thread files are rejected, not adopted\", () => {\n   155\t  it(\"listMessages against an existing empty database file fails without creating schema or bumping user_version\", async () => {\n   156\t    const filePath = store.threadPath();\n   157\t    writeFileSync(filePath, \"\"); // exists, zero bytes — a valid empty SQLite database\n   158\t\n   159\t    const result = await messages.listMessages({ filePath });\n   160\t    expect(result.ok).toBe(false);\n   161\t    if (result.ok) return;\n   162\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   163\t    expect(result.error.code).toBe(\"thread_not_found\");\n   164\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n   165\t\n   166\t    expect(schemaVersionOf(filePath)).toBe(0);\n   167\t    expect(tableNames(filePath)).toEqual([]);\n   168\t  });\n   169\t\n   170\t  it(\"messageEvents against an unrelated SQLite database fails and leaves its content untouched\", async () => {\n   171\t    const filePath = store.threadPath();\n   172\t    const foreign = openRaw(filePath);\n   173\t    try {\n   174\t      foreign.exec(\"CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL);\");\n   175\t      foreign.prepare(\"INSERT INTO notes (id, body) VALUES (1, ?)\").run(\"not lhc data\");\n   176\t    } finally {\n   177\t      foreign.close();\n   178\t    }\n   179\t\n   180\t    const result = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   181\t    expect(result.ok).toBe(false);\n   182\t    if (result.ok) return;\n   183\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   184\t    expect(result.error.code).toBe(\"thread_not_found\");\n   185\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n   186\t\n   187\t    // No lhc tables were created, the version was not bumped, and the\n   188\t    // foreign data is intact.\n   189\t    expect(schemaVersionOf(filePath)).toBe(0);\n   190\t    expect(tableNames(filePath)).toEqual([\"notes\"]);\n   191\t    const db = openRaw(filePath);\n   192\t    try {\n   193\t      const row = db.prepare(\"SELECT body FROM notes WHERE id = 1\").get() as unknown as {\n   194\t        body: string;\n   195\t      };\n   196\t      expect(row.body).toBe(\"not lhc data\");\n   197\t    } finally {\n   198\t      db.close();\n   199\t    }\n   200\t  });\n   201\t\n   202\t  it(\"a non-SQLite file is rejected as a caller error with its bytes unchanged\", async () => {\n   203\t    const filePath = store.threadPath();\n   204\t    const original = \"just some text, definitely not a database\\n\";\n   205\t    writeFileSync(filePath, original);\n   206\t\n   207\t    const listed = await messages.listMessages({ filePath });\n   208\t    expect(listed.ok).toBe(false);\n   209\t    if (listed.ok) return;\n   210\t    expect(listed.error.errorClass).toBe(\"caller_error\");\n   211\t    expect(listed.error.code).toBe(\"thread_not_found\");\n   212\t\n   213\t    const batched = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   214\t    expect(batched.ok).toBe(false);\n   215\t    if (batched.ok) return;\n   216\t    expect(batched.error.errorClass).toBe(\"caller_error\");\n   217\t    expect(batched.error.code).toBe(\"thread_not_found\");\n   218\t\n   219\t    expect(readFileSync(filePath, \"utf8\")).toBe(original);\n   220\t  });\n   221\t});\n   222\t\n   223\t// Story 0 (Epic 02), FC-0.5 + architecture risk \"migration on live data\":\n   224\t// v5 applies in place to a populated Epic 01 file — existing rows intact,\n   225\t// new columns defaulted, the F-02 backfill creating pending derivation\n   226\t// rows for live queued items. A fresh-file migration test would pass while\n   227\t// breaking real threads; this one runs over real Epic 01 data.\n   228\tdescribe(\"FC-0.5: migration v5 over a populated Epic 01 thread file\", () => {\n   229\t  it(\"upgrades in place: records intact, queue columns defaulted, F-02 backfill pending rows present\", async () => {\n   230\t    const filePath = store.threadPath();\n   231\t    legacyEpic01ThreadFile(filePath, \"th_epic01\");\n   232\t    expect(schemaVersionOf(filePath)).toBe(4);\n   233\t\n   234\t    // Any SDK read migrates lazily; the read itself must succeed post-v5.\n   235\t    const projected = await messages.listMessages({ filePath });\n   236\t    expect(projected.ok).toBe(true);\n   237\t    if (!projected.ok) return;\n   238\t    expect(schemaVersionOf(filePath)).toBe(7);\n   239\t\n   240\t    // Existing records intact through the production read surfaces.\n   241\t    expect(projected.value.map((m) => m.messageId)).toEqual([\"m1\", \"m2\", \"m3\"]);\n   242\t    const events = await intakeStream.listEvents({ filePath });\n   243\t    expect(events.ok).toBe(true);\n   244\t    if (!events.ok) return;\n   245\t    expect(events.value).toHaveLength(4);\n   246\t    const turnRecords = await turns.listTurns({ filePath });\n   247\t    expect(turnRecords.ok).toBe(true);\n   248\t    if (!turnRecords.ok) return;\n   249\t    expect(turnRecords.value).toEqual([\n   250\t      {\n   251\t        turnId: \"t1\",\n   252\t        status: \"closed\",\n   253\t        memberMessageIds: [\"m1\", \"m2\", \"m3\"],\n   254\t        openedAtEventOrder: 1,\n   255\t        closedAtEventOrder: 4,\n   256\t        derivations: [\n   257\t          {\n   258\t            subjectKind: \"turn\",\n   259\t            subjectId: \"t1\",\n   260\t            derivationType: \"lower_band_projection\",\n   261\t            state: \"pending\",\n   262\t            sourceVersion: 1,\n   263\t          },\n   264\t          {\n   265\t            subjectKind: \"turn\",\n   266\t            subjectId: \"t1\",\n   267\t            derivationType: \"turn_rendering\",\n   268\t            state: \"pending\",\n   269\t            sourceVersion: 1,\n   270\t          },\n   271\t        ],\n   272\t      },\n   273\t    ]);\n   274\t\n   275\t    // Work rows survive with their pre-v5 ids; the queue's mechanical\n   276\t    // columns exist and default to not-claimed / immediately eligible.\n   277\t    const db = openRaw(filePath);\n   278\t    try {\n   279\t      const items = db\n   280\t        .prepare(\n   281\t          `SELECT work_item_id, status, attempts, last_error, claimed_at,\n   282\t                  claim_expires_at, eligible_at, payload\n   283\t           FROM work_item ORDER BY work_item_id`,\n   284\t        )\n   285\t        .all() as unknown as Array<Record<string, unknown>>;\n   286\t      expect(items.map((row) => row.work_item_id)).toEqual([\n   287\t        \"w-m1-prompt_smoothing\",\n   288\t        \"w-m3-tool_result_summary\",\n   289\t        \"w-t1-turn_derivation\",\n   290\t      ]);\n   291\t      for (const row of items) {\n   292\t        expect(row.status).toBe(\"queued\");\n   293\t        expect(Number(row.attempts)).toBe(0);\n   294\t        expect(row.last_error).toBeNull();\n   295\t        expect(row.claimed_at).toBeNull();\n   296\t        expect(row.claim_expires_at).toBeNull();\n   297\t        expect(row.eligible_at).toBeNull();\n   298\t        expect(row.payload).toBeNull();\n   299\t      }\n   300\t      // The epic's other v5 surfaces exist (schema ships whole): chunk\n   301\t      // tables empty, deleted_at stamps present and null.\n   302\t      const chunkCount = db.prepare(\"SELECT COUNT(*) AS n FROM chunk\").get() as { n: number | bigint };\n   303\t      expect(Number(chunkCount.n)).toBe(0);\n   304\t      const deleted = db\n   305\t        .prepare(\"SELECT COUNT(*) AS n FROM message WHERE deleted_at IS NOT NULL\")\n   306\t        .get() as { n: number | bigint };\n   307\t      expect(Number(deleted.n)).toBe(0);\n   308\t    } finally {\n   309\t      db.close();\n   310\t    }\n   311\t\n   312\t    // F-02 backfill: one pending row per live queued item, mapped per kind —\n   313\t    // turn_derivation fans out to both turn forms; all at source version 1.\n   314\t    expect(\n   315\t      readDerivedForms(filePath).map(({ subjectKind, subjectId, derivationType, state, sourceVersion }) => ({\n   316\t        subjectKind,\n   317\t        subjectId,\n   318\t        derivationType,\n   319\t        state,\n   320\t        sourceVersion,\n   321\t      })),\n   322\t    ).toEqual([\n   323\t      { subjectKind: \"message\", subjectId: \"m1\", derivationType: \"smoothed_prompt\", state: \"pending\", sourceVersion: 1 },\n   324\t      { subjectKind: \"message\", subjectId: \"m3\", derivationType: \"tool_result_summary\", state: \"pending\", sourceVersion: 1 },\n   325\t      { subjectKind: \"turn\", subjectId: \"t1\", derivationType: \"lower_band_projection\", state: \"pending\", sourceVersion: 1 },\n   326\t      { subjectKind: \"turn\", subjectId: \"t1\", derivationType: \"turn_rendering\", state: \"pending\", sourceVersion: 1 },\n   327\t    ]);\n   328\t\n   329\t    // The migrated file keeps working through the Epic 01 write path: a new\n   330\t    // batch records, projects, and queues against the v5 schema.\n   331\t    const batch = await intakeStream.messageEvents({ filePath }, [\n   332\t      validEvent(\"user_prompt\", { payload: { text: \"recorded after the upgrade\" } }),\n   333\t      validEvent(\"turn_end\"),\n   334\t    ]);\n   335\t    expect(batch.ok).toBe(true);\n   336\t    if (!batch.ok) return;\n   337\t    expect(batch.value.events.map((entry) => entry.outcome)).toEqual([\"recorded\", \"recorded\"]);\n   338\t    expect(batch.value.queuedWork.map((item) => item.workItemId)).toEqual([\n   339\t      \"w-m5-prompt_smoothing-v1\",\n   340\t      \"w-t2-turn_derivation-v1\",\n   341\t    ]);\n   342\t  });\n   343\t});\n   344\t\n   345\t// Epic 03 Story 0, FC-0.1: migration v6 applies cleanly to an Epic-02 thread\n   346\t// file through the real chain (the same lazy open every SDK operation uses).\n   347\t// All three view tables exist with their CHECK constraints, the boundary is\n   348\t// seeded at position 0, and re-applying is a no-op.\n   349\tdescribe(\"FC-0.1 (Epic 03): migration v6 over a populated Epic 02 thread file\", () => {\n   350\t  it(\"upgrades in place, seeds the boundary singleton at 0, and re-applies as a no-op\", async () => {\n   351\t    const filePath = store.threadPath();\n   352\t    legacyEpic02ThreadFile(filePath, \"th_epic02\");\n   353\t    expect(schemaVersionOf(filePath)).toBe(5);\n   354\t\n   355\t    // Any SDK read migrates lazily; the read itself must succeed post-v6.\n   356\t    const projected = await messages.listMessages({ filePath });\n   357\t    expect(projected.ok).toBe(true);\n   358\t    if (!projected.ok) return;\n   359\t    expect(schemaVersionOf(filePath)).toBe(7);\n   360\t\n   361\t    // The Epic 02 record is intact through the production read surface.\n   362\t    expect(projected.value.map((m) => m.messageId)).toEqual([\"m1\", \"m2\", \"m3\"]);\n   363\t\n   364\t    const db = openRaw(filePath);\n   365\t    let boundaryBefore: { position: number; updatedAt: string };\n   366\t    try {\n   367\t      const names = (\n   368\t        db\n   369\t          .prepare(\n   370\t            `SELECT name FROM sqlite_master WHERE type = 'table'\n   371\t             AND name IN ('thread_view', 'thread_view_band', 'view_boundary') ORDER BY name`,\n   372\t          )\n   373\t          .all() as unknown as Array<{ name: string }>\n   374\t      ).map((row) => row.name);\n   375\t      expect(names).toEqual([\"thread_view\", \"thread_view_band\", \"view_boundary\"]);\n   376\t\n   377\t      // CHECK constraints are present and enforced: the view and boundary\n   378\t      // singletons refuse any row outside their pinned key, and the band\n   379\t      // table pins its band vocabulary (failed inserts mutate nothing).\n   380\t      expect(() =>\n   381\t        db\n   382\t          .prepare(\n   383\t            `INSERT INTO thread_view (singleton, view_id, created_at, compact_point,\n   384\t               covered_from, config_json, arrangement_json, gaps_json, source_state_json)\n   385\t             VALUES (2, 'v9', 'now', 0, 0, '{}', '[]', '[]', '{}')`,\n   386\t          )\n   387\t          .run(),\n   388\t      ).toThrow(/CHECK/);\n   389\t      const viewDdl = (\n   390\t        db.prepare(`SELECT sql FROM sqlite_master WHERE name = 'thread_view_band'`).get() as {\n   391\t          sql: string;\n   392\t        }\n   393\t      ).sql;\n   394\t      expect(viewDdl).toContain(\"CHECK (band IN ('brief','detailed','smooth'))\");\n   395\t\n   396\t      const rows = db\n   397\t        .prepare(`SELECT thread_singleton, position, updated_at FROM view_boundary`)\n   398\t        .all() as unknown as Array<{\n   399\t        thread_singleton: number | bigint;\n   400\t        position: number | bigint;\n   401\t        updated_at: string;\n   402\t      }>;\n   403\t      expect(rows).toHaveLength(1);\n   404\t      expect(Number(rows[0]!.thread_singleton)).toBe(1);\n   405\t      expect(Number(rows[0]!.position)).toBe(0);\n   406\t      boundaryBefore = { position: Number(rows[0]!.position), updatedAt: rows[0]!.updated_at };\n   407\t      expect(() =>\n   408\t        db\n   409\t          .prepare(`INSERT INTO view_boundary (thread_singleton, position, updated_at) VALUES (2, 0, 'now')`)\n   410\t          .run(),\n   411\t      ).toThrow(/CHECK/);\n   412\t    } finally {\n   413\t      db.close();\n   414\t    }\n   415\t\n   416\t    // Re-applying is a no-op: another open neither bumps the version nor\n   417\t    // re-runs the seed (the boundary row is byte-identical, still singular).\n   418\t    const reread = await messages.listMessages({ filePath });\n   419\t    expect(reread.ok).toBe(true);\n   420\t    expect(schemaVersionOf(filePath)).toBe(7);\n   421\t    const again = openRaw(filePath);\n   422\t    try {\n   423\t      const rows = again\n   424\t        .prepare(`SELECT thread_singleton, position, updated_at FROM view_boundary`)\n   425\t        .all() as unknown as Array<{\n   426\t        thread_singleton: number | bigint;\n   427\t        position: number | bigint;\n   428\t        updated_at: string;\n   429\t      }>;\n   430\t      expect(rows).toHaveLength(1);\n   431\t      expect(Number(rows[0]!.position)).toBe(boundaryBefore.position);\n   432\t      expect(rows[0]!.updated_at).toBe(boundaryBefore.updatedAt);\n   433\t    } finally {\n   434\t      again.close();\n   435\t    }\n   436\t  });\n   437\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/threads.ts'","aggregated_output":"     1\t// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n     2\t// real intake; the multi-state and damaged-source builders then apply the\n     3\t// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n     4\t// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n     5\t// builders wrote; Stories 2/4 confirm the states arise for real\n     6\t// (coverage.md cross-story debt).\n     7\timport { DatabaseSync } from \"node:sqlite\";\n     8\timport {\n     9\t  intakeStream,\n    10\t  threads,\n    11\t  type Derivation,\n    12\t  type DerivationState,\n    13\t  type DependencyGap,\n    14\t  type DerivationType,\n    15\t  type Lhc,\n    16\t  type MessageEventInput,\n    17\t  type SubjectKind,\n    18\t  type ToolOutcome,\n    19\t} from \"../../src/index.js\";\n    20\timport { setIntakeClock } from \"./intake-seam.js\";\n    21\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n    22\timport type { ProviderDouble } from \"./provider-double.js\";\n    23\timport { validEvent, type TempStore } from \"./index.js\";\n    24\t\n    25\tasync function newThreadFile(store: TempStore): Promise<string> {\n    26\t  const filePath = store.threadPath();\n    27\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    28\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    29\t  return filePath;\n    30\t}\n    31\t\n    32\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n    33\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n    34\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n    35\t}\n    36\t\n    37\t// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n    38\t// deterministic (t1..tn) per the turn store's id scheme.\n    39\texport async function threadWithClosedTurns(\n    40\t  store: TempStore,\n    41\t  n: number,\n    42\t): Promise<{ filePath: string; turnIds: string[] }> {\n    43\t  const filePath = await newThreadFile(store);\n    44\t  const turnIds: string[] = [];\n    45\t  for (let i = 1; i <= n; i += 1) {\n    46\t    await send(filePath, [\n    47\t      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n    48\t      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n    49\t      validEvent(\"turn_end\"),\n    50\t    ]);\n    51\t    turnIds.push(`t${i}`);\n    52\t  }\n    53\t  return { filePath, turnIds };\n    54\t}\n    55\t\n    56\t// One closed turn containing a tool run: call + result pair by default;\n    57\t// error and missing-result variants per the epic's outcome vocabulary.\n    58\texport async function threadWithToolRun(\n    59\t  store: TempStore,\n    60\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n    61\t): Promise<{ filePath: string; turnId: string }> {\n    62\t  const filePath = await newThreadFile(store);\n    63\t  const batch: MessageEventInput[] = [\n    64\t    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n    65\t    validEvent(\"tool_call\", {\n    66\t      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    67\t    }),\n    68\t  ];\n    69\t  if (opts.missingResult !== true) {\n    70\t    batch.push(\n    71\t      validEvent(\"tool_result\", {\n    72\t        payload: {\n    73\t          toolCallId: \"call-fixture-1\",\n    74\t          content: opts.resultContent ?? \"contents of notes.txt\",\n    75\t          isError: opts.isError ?? false,\n    76\t        },\n    77\t      }),\n    78\t    );\n    79\t  }\n    80\t  batch.push(validEvent(\"turn_end\"));\n    81\t  await send(filePath, batch);\n    82\t  return { filePath, turnId: \"t1\" };\n    83\t}\n    84\t\n    85\t// ── chunk read-back (Story 3): raw rows for boundary assertions ──\n    86\t\n    87\texport interface ChunkSnapshot {\n    88\t  chunks: Array<{\n    89\t    chunkId: string;\n    90\t    chunkOrder: number;\n    91\t    status: \"open\" | \"closed\";\n    92\t    accumulatedProjectedTokens: number;\n    93\t  }>;\n    94\t  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\n    95\t}\n    96\t\n    97\texport function readChunks(filePath: string): ChunkSnapshot {\n    98\t  const db = new DatabaseSync(filePath);\n    99\t  try {\n   100\t    const chunks = (\n   101\t      db\n   102\t        .prepare(\n   103\t          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n   104\t           FROM chunk ORDER BY chunk_order`,\n   105\t        )\n   106\t        .all() as unknown as Array<{\n   107\t        chunk_id: string;\n   108\t        chunk_order: number | bigint;\n   109\t        status: string;\n   110\t        accumulated_projected_tokens: number | bigint;\n   111\t      }>\n   112\t    ).map((row) => ({\n   113\t      chunkId: row.chunk_id,\n   114\t      chunkOrder: Number(row.chunk_order),\n   115\t      status: row.status as \"open\" | \"closed\",\n   116\t      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n   117\t    }));\n   118\t    const members = (\n   119\t      db\n   120\t        .prepare(\n   121\t          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n   122\t           JOIN chunk c ON c.chunk_id = cm.chunk_id\n   123\t           ORDER BY c.chunk_order, cm.member_idx`,\n   124\t        )\n   125\t        .all() as unknown as Array<{\n   126\t        chunk_id: string;\n   127\t        turn_id: string;\n   128\t        member_idx: number | bigint;\n   129\t      }>\n   130\t    ).map((row) => ({\n   131\t      chunkId: row.chunk_id,\n   132\t      turnId: row.turn_id,\n   133\t      memberIdx: Number(row.member_idx),\n   134\t    }));\n   135\t    return { chunks, members };\n   136\t  } finally {\n   137\t    db.close();\n   138\t  }\n   139\t}\n   140\t\n   141\t// ── derivation read-back and the sanctioned state writer ───────\n   142\t\n   143\tinterface RawFormRow {\n   144\t  subject_kind: string;\n   145\t  subject_id: string;\n   146\t  derivation_type: string;\n   147\t  state: string;\n   148\t  content: string | null;\n   149\t  reason: string | null;\n   150\t  metadata: string | null;\n   151\t  source_version: number | bigint;\n   152\t  gaps: string | null;\n   153\t  derived_at: string | null;\n   154\t}\n   155\t\n   156\texport function readDerivedForms(filePath: string): Derivation[] {\n   157\t  const db = new DatabaseSync(filePath);\n   158\t  try {\n   159\t    const rows = db\n   160\t      .prepare(\n   161\t        `SELECT subject_kind, subject_id, derivation_type, state, content, reason, metadata,\n   162\t                source_version, gaps, derived_at\n   163\t         FROM derivation ORDER BY subject_kind, subject_id, derivation_type`,\n   164\t      )\n   165\t      .all() as unknown as RawFormRow[];\n   166\t    return rows.map((row) => {\n   167\t      const record: Derivation = {\n   168\t        subjectKind: row.subject_kind as SubjectKind,\n   169\t        subjectId: row.subject_id,\n   170\t        derivationType: row.derivation_type as DerivationType,\n   171\t        state: row.state as DerivationState,\n   172\t        sourceVersion: Number(row.source_version),\n   173\t      };\n   174\t      if (row.content !== null) record.content = row.content;\n   175\t      if (row.reason !== null) record.reason = row.reason;\n   176\t      if (row.metadata !== null) {\n   177\t        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n   178\t      }\n   179\t      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n   180\t      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n   181\t      return record;\n   182\t    });\n   183\t  } finally {\n   184\t    db.close();\n   185\t  }\n   186\t}\n   187\t\n   188\t// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n   189\t// are unreachable through the SDK until the drain (Story 1) and handlers\n   190\t// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n   191\t// enqueue, mirroring the production completion contract.\n   192\texport function setFormState(\n   193\t  filePath: string,\n   194\t  target: { subjectKind: SubjectKind; subjectId: string; derivationType: DerivationType },\n   195\t  update: {\n   196\t    state: DerivationState;\n   197\t    content?: string;\n   198\t    reason?: string;\n   199\t    metadata?: { outcome?: ToolOutcome };\n   200\t    derivedAt?: string;\n   201\t  },\n   202\t): void {\n   203\t  const db = new DatabaseSync(filePath);\n   204\t  try {\n   205\t    const changed = db\n   206\t      .prepare(\n   207\t        `UPDATE derivation\n   208\t         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n   209\t         WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ?`,\n   210\t      )\n   211\t      .run(\n   212\t        update.state,\n   213\t        update.content ?? null,\n   214\t        update.reason ?? null,\n   215\t        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n   216\t        update.derivedAt ?? null,\n   217\t        target.subjectKind,\n   218\t        target.subjectId,\n   219\t        target.derivationType,\n   220\t      );\n   221\t    if (Number(changed.changes) !== 1) {\n   222\t      throw new Error(\n   223\t        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.derivationType}; expected the pending row from enqueue`,\n   224\t      );\n   225\t    }\n   226\t  } finally {\n   227\t    db.close();\n   228\t  }\n   229\t}\n   230\t\n   231\t// ── multi-state thread: every form state in one file ─────────────\n   232\t\n   233\texport interface MultiStateClaim {\n   234\t  subjectKind: SubjectKind;\n   235\t  subjectId: string;\n   236\t  derivationType: DerivationType;\n   237\t  state: DerivationState;\n   238\t}\n   239\t\n   240\texport async function multiStateThread(\n   241\t  store: TempStore,\n   242\t): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n   243\t  const filePath = await newThreadFile(store);\n   244\t  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n   245\t  // form pending; the writes below move a subset into the other three states.\n   246\t  await send(filePath, [\n   247\t    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n   248\t    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n   249\t    validEvent(\"tool_call\", {\n   250\t      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n   251\t    }),\n   252\t    validEvent(\"tool_result\", {\n   253\t      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n   254\t    }),\n   255\t    validEvent(\"turn_end\"),\n   256\t    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n   257\t    validEvent(\"turn_end\"),\n   258\t  ]);\n   259\t  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n   260\t  setFormState(\n   261\t    filePath,\n   262\t    { subjectKind: \"message\", subjectId: \"m1\", derivationType: \"smoothed_prompt\" },\n   263\t    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n   264\t  );\n   265\t  // Tool-activity outcome lives in machine-readable metadata, never inside\n   266\t  // provider-authored content (FC-0.3).\n   267\t  setFormState(\n   268\t    filePath,\n   269\t    { subjectKind: \"message\", subjectId: \"m4\", derivationType: \"tool_result_summary\" },\n   270\t    {\n   271\t      state: \"ready\",\n   272\t      content: \"toolresult(fixture:contents of a.txt)\",\n   273\t      metadata: { outcome: \"succeeded\" },\n   274\t      derivedAt,\n   275\t    },\n   276\t  );\n   277\t  setFormState(\n   278\t    filePath,\n   279\t    { subjectKind: \"turn\", subjectId: \"t1\", derivationType: \"turn_rendering\" },\n   280\t    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n   281\t  );\n   282\t  setFormState(\n   283\t    filePath,\n   284\t    { subjectKind: \"turn\", subjectId: \"t2\", derivationType: \"turn_rendering\" },\n   285\t    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n   286\t  );\n   287\t  return {\n   288\t    filePath,\n   289\t    expected: [\n   290\t      { subjectKind: \"message\", subjectId: \"m1\", derivationType: \"smoothed_prompt\", state: \"ready\" },\n   291\t      { subjectKind: \"message\", subjectId: \"m4\", derivationType: \"tool_result_summary\", state: \"ready\" },\n   292\t      { subjectKind: \"message\", subjectId: \"m6\", derivationType: \"smoothed_prompt\", state: \"pending\" },\n   293\t      { subjectKind: \"turn\", subjectId: \"t1\", derivationType: \"turn_rendering\", state: \"failed\" },\n   294\t      { subjectKind: \"turn\", subjectId: \"t1\", derivationType: \"lower_band_projection\", state: \"pending\" },\n   295\t      { subjectKind: \"turn\", subjectId: \"t2\", derivationType: \"turn_rendering\", state: \"blocked\" },\n   296\t      { subjectKind: \"turn\", subjectId: \"t2\", derivationType: \"lower_band_projection\", state: \"pending\" },\n   297\t    ],\n   298\t  };\n   299\t}\n   300\t\n   301\t// ── damaged-source thread (Epic 01 corruption definition) ────────\n   302\t\n   303\t// A closed turn with its turn_derivation work queued, then the Epic 01\n   304\t// two-open-turns corruption — the damage a turn handler must find and the\n   305\t// intake pipeline refuses (turn_state_corrupt).\n   306\texport async function damagedSourceThread(\n   307\t  store: TempStore,\n   308\t): Promise<{ filePath: string; turnId: string }> {\n   309\t  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n   310\t  // Open a second turn through real intake; the corruption writer then adds\n   311\t  // another open row — two open turns, the Epic 01 invariant violation.\n   312\t  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n   313\t  corruptTwoOpenTurns(filePath);\n   314\t  const turnId = turnIds[0];\n   315\t  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n   316\t  return { filePath, turnId };\n   317\t}\n   318\t\n   319\t// ── gapped-rendering thread (TC-3.2's state, shared) ─────────────\n   320\t\n   321\t// TC-3.2's gapped-rendering state as one shared builder (coverage.md\n   322\t// cross-story debt: TC-4.4 consumes this exact scenario; don't rebuild it by\n   323\t// hand). Expects a manual-mode SDK with retry budget 3 and zero backoff:\n   324\t// scripts the double to exhaust the prompt's smoothing, then drains — the\n   325\t// smoothing lands failed (its work row deleted at exhaustion, DD-1) and the\n   326\t// turn rendering lands ready with the recorded gap.\n   327\texport const GAPPED_SMOOTHING_REASON = \"provider_failure: scripted smoothing exhaustion\";\n   328\t\n   329\texport async function gappedRenderingThread(\n   330\t  store: TempStore,\n   331\t  sdk: Lhc,\n   332\t  double: ProviderDouble,\n   333\t): Promise<{ filePath: string; messageId: string; turnId: string }> {\n   334\t  const filePath = await newThreadFile(store);\n   335\t  double.failKind(\"prompt_smoothing\", 3, {\n   336\t    retryable: true,\n   337\t    reason: GAPPED_SMOOTHING_REASON,\n   338\t  });\n   339\t  await send(filePath, [\n   340\t    validEvent(\"user_prompt\", { payload: { text: \"gapped prompt\" } }),\n   341\t    validEvent(\"assistant_text\", { payload: { text: \"gapped answer\" } }),\n   342\t    validEvent(\"turn_end\"),\n   343\t  ]);\n   344\t  const drained = await sdk.work.drain({ filePath });\n   345\t  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\n   346\t  const forms = readDerivedForms(filePath);\n   347\t  const smoothing = forms.find((f) => f.subjectId === \"m1\" && f.derivationType === \"smoothed_prompt\");\n   348\t  const rendering = forms.find((f) => f.subjectId === \"t1\" && f.derivationType === \"turn_rendering\");\n   349\t  if (\n   350\t    smoothing?.state !== \"failed\" ||\n   351\t    rendering?.state !== \"ready\" ||\n   352\t    rendering.gaps === undefined\n   353\t  ) {\n   354\t    throw new Error(\n   355\t      \"fixture invariant: failed smoothing under a ready, gapped rendering expected\",\n   356\t    );\n   357\t  }\n   358\t  return { filePath, messageId: \"m1\", turnId: \"t1\" };\n   359\t}\n","exit_code":0,"status":"completed"}}

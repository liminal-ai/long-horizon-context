{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/logging-surface.test.ts'","aggregated_output":"     1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  createDeterministicProvider,\n     4\t  createSdk,\n     5\t  writeLog,\n     6\t  type Lhc,\n     7\t  type LogEntry,\n     8\t  type LogLevel,\n     9\t} from \"../src/index.js\";\n    10\timport { openRaw, tempStore } from \"./fixtures/index.js\";\n    11\t\n    12\tlet store: ReturnType<typeof tempStore>;\n    13\tlet sdk: Lhc;\n    14\t\n    15\tbeforeEach(() => {\n    16\t  store = tempStore();\n    17\t  sdk = createSdk({ provider: createDeterministicProvider(), mode: \"manual\" });\n    18\t});\n    19\t\n    20\tafterEach(() => {\n    21\t  store.cleanup();\n    22\t});\n    23\t\n    24\tasync function newThread(): Promise<string> {\n    25\t  const filePath = store.threadPath(\"logging-test\");\n    26\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    27\t  expect(created.ok).toBe(true);\n    28\t  return filePath;\n    29\t}\n    30\t\n    31\tasync function write(filePath: string, entry: LogEntry): Promise<void> {\n    32\t  const written = await sdk.logging.write({ filePath }, entry);\n    33\t  expect(written.ok).toBe(true);\n    34\t}\n    35\t\n    36\tdescribe(\"Flow 5: Derivation Logging\", () => {\n    37\t  it(\"TC-5.1a persists info, warning, and error levels\", async () => {\n    38\t    const filePath = await newThread();\n    39\t\n    40\t    for (const level of [\"info\", \"warning\", \"error\"] as LogLevel[]) {\n    41\t      await write(filePath, { level, message: `${level} message` });\n    42\t    }\n    43\t\n    44\t    const queried = await sdk.logging.query({ filePath }, {});\n    45\t    expect(queried.ok).toBe(true);\n    46\t    if (!queried.ok) return;\n    47\t    expect(queried.value.map((entry) => entry.level).sort()).toEqual([\n    48\t      \"error\",\n    49\t      \"info\",\n    50\t      \"warning\",\n    51\t    ]);\n    52\t  });\n    53\t\n    54\t  it(\"TC-5.2a writes internal and external callers through the same store\", async () => {\n    55\t    const filePath = await newThread();\n    56\t    const db = openRaw(filePath);\n    57\t    try {\n    58\t      writeLog(\n    59\t        {\n    60\t          db,\n    61\t          clock: () => new Date(\"2026-01-01T00:00:00.000Z\"),\n    62\t          threadId: \"logging-test\",\n    63\t          onCommit: () => {},\n    64\t          poke: () => {},\n    65\t        },\n    66\t        {\n    67\t          level: \"info\",\n    68\t          message: \"internal caller\",\n    69\t          derivationType: \"smoothed_prompt\",\n    70\t          subjectId: \"m1\",\n    71\t        },\n    72\t      );\n    73\t    } finally {\n    74\t      db.close();\n    75\t    }\n    76\t\n    77\t    await write(filePath, {\n    78\t      level: \"warning\",\n    79\t      message: \"external caller\",\n    80\t      derivationType: \"tool_result_summary\",\n    81\t      subjectId: \"m2\",\n    82\t    });\n    83\t\n    84\t    const queried = await sdk.logging.query({ filePath }, {});\n    85\t    expect(queried.ok).toBe(true);\n    86\t    if (!queried.ok) return;\n    87\t    expect(queried.value.map((entry) => entry.message).sort()).toEqual([\n    88\t      \"external caller\",\n    89\t      \"internal caller\",\n    90\t    ]);\n    91\t  });\n    92\t\n    93\t  it(\"TC-5.3a keeps fallback events in the log, not on ready derivations\", async () => {\n    94\t    const filePath = await newThread();\n    95\t    const db = openRaw(filePath);\n    96\t    try {\n    97\t      db.prepare(\n    98\t        `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, content)\n    99\t         VALUES (?, ?, ?, ?, ?)`,\n   100\t      ).run(\"message\", \"m1\", \"smoothed_prompt\", \"ready\", \"clean content\");\n   101\t    } finally {\n   102\t      db.close();\n   103\t    }\n   104\t\n   105\t    await write(filePath, {\n   106\t      level: \"warning\",\n   107\t      message: \"fallback used\",\n   108\t      derivationType: \"smoothed_prompt\",\n   109\t      subjectId: \"m1\",\n   110\t      reason: \"not_ready\",\n   111\t      floorUsed: \"deterministic floor\",\n   112\t    });\n   113\t\n   114\t    const read = openRaw(filePath);\n   115\t    try {\n   116\t      const row = read\n   117\t        .prepare(`SELECT state, content, reason, gaps, metadata FROM derivation WHERE subject_id = ?`)\n   118\t        .get(\"m1\") as\n   119\t        | {\n   120\t            state: string;\n   121\t            content: string;\n   122\t            reason: string | null;\n   123\t            gaps: string | null;\n   124\t            metadata: string | null;\n   125\t          }\n   126\t        | undefined;\n   127\t      expect(row).toEqual({\n   128\t        state: \"ready\",\n   129\t        content: \"clean content\",\n   130\t        reason: null,\n   131\t        gaps: null,\n   132\t        metadata: null,\n   133\t      });\n   134\t    } finally {\n   135\t      read.close();\n   136\t    }\n   137\t\n   138\t    const queried = await sdk.logging.query({ filePath }, { reason: \"not_ready\" });\n   139\t    expect(queried.ok).toBe(true);\n   140\t    if (!queried.ok) return;\n   141\t    expect(queried.value).toHaveLength(1);\n   142\t    expect(queried.value[0]?.floorUsed).toBe(\"deterministic floor\");\n   143\t  });\n   144\t\n   145\t  it(\"TC-5.3b keeps failed state and reason on the derivation record\", async () => {\n   146\t    const filePath = await newThread();\n   147\t    const db = openRaw(filePath);\n   148\t    try {\n   149\t      db.prepare(\n   150\t        `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, reason)\n   151\t         VALUES (?, ?, ?, ?, ?)`,\n   152\t      ).run(\"message\", \"m2\", \"tool_result_summary\", \"failed\", \"provider_unavailable\");\n   153\t    } finally {\n   154\t      db.close();\n   155\t    }\n   156\t\n   157\t    await write(filePath, {\n   158\t      level: \"error\",\n   159\t      message: \"diagnostic\",\n   160\t      derivationType: \"tool_result_summary\",\n   161\t      subjectId: \"m2\",\n   162\t      reason: \"provider_unavailable\",\n   163\t    });\n   164\t\n   165\t    const read = openRaw(filePath);\n   166\t    try {\n   167\t      const row = read\n   168\t        .prepare(`SELECT state, reason FROM derivation WHERE subject_id = ?`)\n   169\t        .get(\"m2\") as { state: string; reason: string } | undefined;\n   170\t      expect(row).toEqual({ state: \"failed\", reason: \"provider_unavailable\" });\n   171\t    } finally {\n   172\t      read.close();\n   173\t    }\n   174\t  });\n   175\t\n   176\t  it(\"TC-5.4a queries by actionable fields\", async () => {\n   177\t    const filePath = await newThread();\n   178\t    await write(filePath, {\n   179\t      level: \"info\",\n   180\t      message: \"smoothed ok\",\n   181\t      derivationType: \"smoothed_prompt\",\n   182\t      subjectId: \"m1\",\n   183\t      reason: \"observed\",\n   184\t    });\n   185\t    await write(filePath, {\n   186\t      level: \"warning\",\n   187\t      message: \"tool fallback\",\n   188\t      derivationType: \"tool_result_summary\",\n   189\t      subjectId: \"m2\",\n   190\t      reason: \"not_ready\",\n   191\t    });\n   192\t    await write(filePath, {\n   193\t      level: \"warning\",\n   194\t      message: \"smoothed fallback\",\n   195\t      derivationType: \"smoothed_prompt\",\n   196\t      subjectId: \"m3\",\n   197\t      reason: \"not_ready\",\n   198\t    });\n   199\t\n   200\t    const queried = await sdk.logging.query(\n   201\t      { filePath },\n   202\t      { level: \"warning\", derivationType: \"smoothed_prompt\", reason: \"not_ready\" },\n   203\t    );\n   204\t    expect(queried.ok).toBe(true);\n   205\t    if (!queried.ok) return;\n   206\t    expect(queried.value.map((entry) => entry.message)).toEqual([\"smoothed fallback\"]);\n   207\t  });\n   208\t\n   209\t  it(\"TC-5.5a contains logging write failures\", async () => {\n   210\t    const filePath = await newThread();\n   211\t    const db = openRaw(filePath);\n   212\t    try {\n   213\t      db.exec(\"BEGIN IMMEDIATE;\");\n   214\t      try {\n   215\t        db.prepare(\n   216\t          `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, content)\n   217\t           VALUES (?, ?, ?, ?, ?)`,\n   218\t        ).run(\"turn\", \"t1\", \"turn_rendering\", \"ready\", \"turn content\");\n   219\t\n   220\t        expect(() =>\n   221\t          writeLog(\n   222\t            {\n   223\t              db: {\n   224\t                prepare: () => {\n   225\t                  throw new Error(\"log store unavailable\");\n   226\t                },\n   227\t              } as never,\n   228\t              clock: () => new Date(\"2026-01-01T00:00:00.000Z\"),\n   229\t              threadId: \"logging-test\",\n   230\t              onCommit: () => {},\n   231\t              poke: () => {},\n   232\t            },\n   233\t            { level: \"warning\", message: \"will be dropped\" },\n   234\t          ),\n   235\t        ).not.toThrow();\n   236\t\n   237\t        db.prepare(\n   238\t          `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, content)\n   239\t           VALUES (?, ?, ?, ?, ?)`,\n   240\t        ).run(\"turn\", \"t1\", \"lower_band_projection\", \"ready\", \"projection content\");\n   241\t        db.exec(\"COMMIT;\");\n   242\t      } catch (cause) {\n   243\t        db.exec(\"ROLLBACK;\");\n   244\t        throw cause;\n   245\t      }\n   246\t\n   247\t      const rows = db\n   248\t        .prepare(`SELECT derivation_type FROM derivation WHERE subject_id = ? ORDER BY derivation_type`)\n   249\t        .all(\"t1\") as unknown as Array<{ derivation_type: string }>;\n   250\t      expect(rows.map((row) => row.derivation_type)).toEqual([\n   251\t        \"lower_band_projection\",\n   252\t        \"turn_rendering\",\n   253\t      ]);\n   254\t    } finally {\n   255\t      db.close();\n   256\t    }\n   257\t  });\n   258\t});\n","exit_code":0,"status":"completed"}}

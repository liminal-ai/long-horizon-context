{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/internal/compose.ts'","aggregated_output":"     1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n     2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n     3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n     4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n     5\t// clock in the signature: determinism is structural, not disciplined.\n     6\t//\n     7\t// Tool activity stays in message order and groups into runs (AC-3.4, Fix 2):\n     8\t// a maximal stretch of consecutive tool_call/tool_result messages folds into\n     9\t// ONE RenderingPart and ONE receipt — a run-level account naming the tools,\n    10\t// the call count, and the per-call mechanical outcomes, so a run containing a\n    11\t// state-changing call structurally cannot lose its outcome and mixed outcomes\n    12\t// stay explicit, never collapsed into a vague success. Prompts and assistant\n    13\t// text break a run; thinking and runtime notes do not (interior ones ride the\n    14\t// run account inline, edge ones stand alone) — a story-deviation decision.\n    15\t// Runs are never reordered to make accounts tidier; the outcome rides the\n    16\t// part, not the prose.\n    17\timport type {\n    18\t  DependencyGap,\n    19\t  DerivationMetadata,\n    20\t  DerivationState,\n    21\t  DerivationType,\n    22\t  RenderingPart,\n    23\t  RenderingPartKind,\n    24\t  ToolOutcome,\n    25\t  ToolRunReceipt,\n    26\t} from \"../../../shared/derivation.js\";\n    27\t\n    28\t// The member message as the composer sees it: kind plus projected blocks,\n    29\t// verbatim from the record (already deleted-filtered by the caller's read).\n    30\texport interface ComposeMessage {\n    31\t  messageId: string;\n    32\t  kind: RenderingPartKind;\n    33\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    34\t}\n    35\t\n    36\t// One message-owned form row as composition input; keyed by the caller as\n    37\t// `${messageId}/${form}`.\n    38\texport interface ComposeFormRow {\n    39\t  state: DerivationState;\n    40\t  content?: string;\n    41\t  metadata?: DerivationMetadata;\n    42\t}\n    43\t\n    44\texport function composeFormKey(messageId: string, form: DerivationType): string {\n    45\t  return `${messageId}/${form}`;\n    46\t}\n    47\t\n    48\texport interface CompositionInput {\n    49\t  parts: RenderingPart[];\n    50\t  gaps: DependencyGap[];\n    51\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n    52\t  // account + outcome, in message order — pure restatement of the\n    53\t  // composition input, stamped on the rendering so chunk summaries read\n    54\t  // receipts without re-deriving anything.\n    55\t  receipts: ToolRunReceipt[];\n    56\t}\n    57\t\n    58\t// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n    59\t// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n    60\t// function of the input string alone.\n    61\texport const FALLBACK_TRUNCATION_LIMIT = 200;\n    62\t\n    63\texport function truncateForFallback(text: string): string {\n    64\t  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n    65\t  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n    66\t  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n    67\t}\n    68\t\n    69\tfunction textOf(message: ComposeMessage): string {\n    70\t  const text = message.blocks[0]?.content[\"text\"];\n    71\t  return typeof text === \"string\" ? text : \"\";\n    72\t}\n    73\t\n    74\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n    75\t// composition): a tool call's outcome comes from its paired result among the\n    76\t// turn's messages — present and clean, present and isError, or absent.\n    77\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n    78\t  const byCallId = new Map<string, boolean>();\n    79\t  for (const message of messages) {\n    80\t    if (message.kind !== \"tool_result\") continue;\n    81\t    const block = message.blocks[0]?.content ?? {};\n    82\t    const callId = block[\"toolCallId\"];\n    83\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n    84\t  }\n    85\t  return byCallId;\n    86\t}\n    87\t\n    88\tfunction outcomeFromRecord(\n    89\t  resultByCallId: Map<string, boolean>,\n    90\t  callId: unknown,\n    91\t): ToolOutcome {\n    92\t  if (typeof callId !== \"string\") return \"unknown\";\n    93\t  const isError = resultByCallId.get(callId);\n    94\t  if (isError === undefined) return \"unknown\";\n    95\t  return isError ? \"failed\" : \"succeeded\";\n    96\t}\n    97\t\n    98\tinterface PartPlan {\n    99\t  form?: DerivationType; // the message-level form this kind composes from, if any\n   100\t  fallbackText: (message: ComposeMessage) => string;\n   101\t}\n   102\t\n   103\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n   104\t// call/result → deterministic truncation; text/thinking/note → raw, no form\n   105\t// to fall back from and therefore never a gap.\n   106\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n   107\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n   108\t  assistant_text: { fallbackText: textOf },\n   109\t  assistant_thinking: { fallbackText: textOf },\n   110\t  runtime_note: { fallbackText: textOf },\n   111\t  tool_call: {\n   112\t    form: \"tool_call_summary\",\n   113\t    fallbackText: (message) => {\n   114\t      const block = message.blocks[0]?.content ?? {};\n   115\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n   116\t      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n   117\t    },\n   118\t  },\n   119\t  tool_result: {\n   120\t    form: \"tool_result_summary\",\n   121\t    fallbackText: (message) => {\n   122\t      const block = message.blocks[0]?.content ?? {};\n   123\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n   124\t    },\n   125\t  },\n   126\t};\n   127\t\n   128\t// One per-message atom before grouping: its composed part plus the structural\n   129\t// facts the run-grouping reads. Tool atoms fold into runs; prompts and\n   130\t// assistant text break runs; thinking and runtime notes are transparent —\n   131\t// interior ones fold into the surrounding run's account, edge ones stand alone.\n   132\tinterface ComposeAtom {\n   133\t  part: RenderingPart;\n   134\t  isTool: boolean;\n   135\t  isBreak: boolean; // user_prompt | assistant_text — ends a run\n   136\t  toolName?: string; // tool_call only\n   137\t  toolCallId?: string; // tool_call | tool_result\n   138\t}\n   139\t\n   140\tconst RUN_BREAK_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"user_prompt\", \"assistant_text\"]);\n   141\tconst TOOL_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"tool_call\", \"tool_result\"]);\n   142\t\n   143\t// One message → its composed part (ready form verbatim, else raw/truncated\n   144\t// fallback) plus a gap when a derivable form was not ready. Gaps stay\n   145\t// per-message — precise to the source record — regardless of run grouping\n   146\t// (AC-3.2/3.3): the caller lands them on the rendering and they hold until an\n   147\t// explicit rebuild recomposes from current states.\n   148\tfunction buildAtom(\n   149\t  message: ComposeMessage,\n   150\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   151\t  resultByCallId: Map<string, boolean>,\n   152\t): { atom: ComposeAtom; gap?: DependencyGap } {\n   153\t  const plan = PART_PLANS[message.kind];\n   154\t  const form =\n   155\t    plan.form === undefined\n   156\t      ? undefined\n   157\t      : forms.get(composeFormKey(message.messageId, plan.form));\n   158\t  const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n   159\t  const block = message.blocks[0]?.content ?? {};\n   160\t  const part: RenderingPart = {\n   161\t    messageId: message.messageId,\n   162\t    kind: message.kind,\n   163\t    text: ready ? (form.content as string) : plan.fallbackText(message),\n   164\t    fallback: plan.form !== undefined && !ready,\n   165\t  };\n   166\t  if (message.kind === \"tool_call\") {\n   167\t    part.outcome =\n   168\t      ready && form.metadata?.outcome !== undefined\n   169\t        ? form.metadata.outcome\n   170\t        : outcomeFromRecord(resultByCallId, block[\"toolCallId\"]);\n   171\t  } else if (message.kind === \"tool_result\") {\n   172\t    part.outcome =\n   173\t      ready && form.metadata?.outcome !== undefined\n   174\t        ? form.metadata.outcome\n   175\t        : block[\"isError\"] === true\n   176\t          ? \"failed\"\n   177\t          : \"succeeded\";\n   178\t  }\n   179\t  const atom: ComposeAtom = {\n   180\t    part,\n   181\t    isTool: TOOL_KINDS.has(message.kind),\n   182\t    isBreak: RUN_BREAK_KINDS.has(message.kind),\n   183\t  };\n   184\t  if (message.kind === \"tool_call\" && typeof block[\"toolName\"] === \"string\") {\n   185\t    atom.toolName = block[\"toolName\"];\n   186\t  }\n   187\t  if (atom.isTool && typeof block[\"toolCallId\"] === \"string\") {\n   188\t    atom.toolCallId = block[\"toolCallId\"];\n   189\t  }\n   190\t  const gap: DependencyGap | undefined =\n   191\t    part.fallback && plan.form !== undefined\n   192\t      ? { subjectKind: \"message\", subjectId: message.messageId, derivationType: plan.form }\n   193\t      : undefined;\n   194\t  return gap === undefined ? { atom } : { atom, gap };\n   195\t}\n   196\t\n   197\tconst RUN_OUTCOME_ORDER: readonly ToolOutcome[] = [\"succeeded\", \"failed\", \"unknown\"];\n   198\t\n   199\t// The run's per-invocation outcome tally: each call counted once, plus any\n   200\t// result whose paired call sits outside this run (a cross-turn pair). Mixed\n   201\t// outcomes stay explicit; the run-level outcome is failed if any failed, else\n   202\t// unknown if any unknown, else succeeded.\n   203\tfunction tallyRun(members: readonly ComposeAtom[]): {\n   204\t  counts: Record<ToolOutcome, number>;\n   205\t  outcome: ToolOutcome;\n   206\t  callCount: number;\n   207\t  toolNames: string[];\n   208\t} {\n   209\t  const calls = members.filter((m) => m.part.kind === \"tool_call\");\n   210\t  const callIds = new Set(\n   211\t    calls.map((m) => m.toolCallId).filter((id): id is string => id !== undefined),\n   212\t  );\n   213\t  const orphanResults = members.filter(\n   214\t    (m) =>\n   215\t      m.part.kind === \"tool_result\" &&\n   216\t      (m.toolCallId === undefined || !callIds.has(m.toolCallId)),\n   217\t  );\n   218\t  const counts: Record<ToolOutcome, number> = { succeeded: 0, failed: 0, unknown: 0 };\n   219\t  for (const m of [...calls, ...orphanResults]) counts[m.part.outcome ?? \"unknown\"] += 1;\n   220\t  const outcome: ToolOutcome =\n   221\t    counts.failed > 0 ? \"failed\" : counts.unknown > 0 ? \"unknown\" : \"succeeded\";\n   222\t  const toolNames: string[] = [];\n   223\t  for (const call of calls) {\n   224\t    if (call.toolName !== undefined && !toolNames.includes(call.toolName)) {\n   225\t      toolNames.push(call.toolName);\n   226\t    }\n   227\t  }\n   228\t  return { counts, outcome, callCount: calls.length, toolNames };\n   229\t}\n   230\t\n   231\tfunction runTallyText(counts: Record<ToolOutcome, number>): string {\n   232\t  const segs = RUN_OUTCOME_ORDER.filter((o) => counts[o] > 0).map((o) => `${counts[o]} ${o}`);\n   233\t  return segs.length > 0 ? segs.join(\", \") : \"no outcomes\";\n   234\t}\n   235\t\n   236\t// One RenderingPart and one ToolRunReceipt for a maximal tool run (AC-3.4): a\n   237\t// run-level header (tools, call count, outcome tally) over the members'\n   238\t// composed accounts in record order — each tool member stating its own\n   239\t// outcome so a state-changing call cannot lose it, interior thinking/notes\n   240\t// riding inline. The receipt restates the same account + run outcome for the\n   241\t// chunk summaries (AC-3.8).\n   242\tfunction composeRun(members: readonly ComposeAtom[]): {\n   243\t  part: RenderingPart;\n   244\t  receipt: ToolRunReceipt;\n   245\t} {\n   246\t  const { counts, outcome, callCount, toolNames } = tallyRun(members);\n   247\t  const tools = toolNames.length > 0 ? toolNames.join(\", \") : \"tools\";\n   248\t  const header = `tool run · ${tools} · ${callCount} call${callCount === 1 ? \"\" : \"s\"} · ${runTallyText(counts)}`;\n   249\t  const detail = members\n   250\t    .map((m) => (m.isTool ? `${m.part.text} ⇒ ${m.part.outcome ?? \"unknown\"}` : m.part.text))\n   251\t    .join(\"\\n\");\n   252\t  const text = `[${header}]\\n${detail}`;\n   253\t  const lead = members[0];\n   254\t  if (lead === undefined) throw new Error(\"composeRun: a tool run has no members\");\n   255\t  return {\n   256\t    part: {\n   257\t      messageId: lead.part.messageId,\n   258\t      kind: lead.part.kind,\n   259\t      text,\n   260\t      fallback: members.some((m) => m.isTool && m.part.fallback),\n   261\t      outcome,\n   262\t    },\n   263\t    receipt: {\n   264\t      messageId: lead.part.messageId,\n   265\t      activity: lead.part.kind === \"tool_result\" ? \"tool_result\" : \"tool_call\",\n   266\t      account: text,\n   267\t      outcome,\n   268\t    },\n   269\t  };\n   270\t}\n   271\t\n   272\t// Compose the ordered RenderingParts and tool-run receipts. Per-message atoms\n   273\t// build first (forms verbatim or fallbacks, per-message gaps); then maximal\n   274\t// runs of consecutive tool activity fold into one run part + one receipt each\n   275\t// (AC-3.4), with prompts/assistant text breaking runs and thinking/runtime\n   276\t// notes transparent to them.\n   277\texport function composeRenderingInput(\n   278\t  messages: readonly ComposeMessage[],\n   279\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   280\t): CompositionInput {\n   281\t  const resultByCallId = recordOutcomes(messages);\n   282\t  const atoms: ComposeAtom[] = [];\n   283\t  const gaps: DependencyGap[] = [];\n   284\t  for (const message of messages) {\n   285\t    const built = buildAtom(message, forms, resultByCallId);\n   286\t    atoms.push(built.atom);\n   287\t    if (built.gap !== undefined) gaps.push(built.gap);\n   288\t  }\n   289\t\n   290\t  const parts: RenderingPart[] = [];\n   291\t  const receipts: ToolRunReceipt[] = [];\n   292\t  let i = 0;\n   293\t  while (i < atoms.length) {\n   294\t    const atom = atoms[i];\n   295\t    if (atom === undefined) break; // i < length keeps this unreachable\n   296\t    if (!atom.isTool) {\n   297\t      parts.push(atom.part); // prompt, assistant text, or an edge thinking/note\n   298\t      i += 1;\n   299\t      continue;\n   300\t    }\n   301\t    // A maximal run starting at this tool atom: extend over following tool\n   302\t    // atoms and interior transparent atoms (thinking/notes), stopping at the\n   303\t    // next break (prompt/assistant text) or the turn's end. Transparent atoms\n   304\t    // trailing the last tool atom stand alone, not folded into the run.\n   305\t    let j = i;\n   306\t    let lastToolIdx = i;\n   307\t    for (let next = atoms[j + 1]; next !== undefined && !next.isBreak; next = atoms[j + 1]) {\n   308\t      j += 1;\n   309\t      if (next.isTool) lastToolIdx = j;\n   310\t    }\n   311\t    const run = composeRun(atoms.slice(i, lastToolIdx + 1));\n   312\t    parts.push(run.part);\n   313\t    receipts.push(run.receipt);\n   314\t    for (let k = lastToolIdx + 1; k <= j; k += 1) {\n   315\t      const trailing = atoms[k];\n   316\t      if (trailing !== undefined) parts.push(trailing.part);\n   317\t    }\n   318\t    i = j + 1;\n   319\t  }\n   320\t\n   321\t  return { parts, gaps, receipts };\n   322\t}\n","exit_code":0,"status":"completed"}}

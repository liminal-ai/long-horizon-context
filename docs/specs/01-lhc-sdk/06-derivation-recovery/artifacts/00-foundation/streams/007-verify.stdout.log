{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/messages/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport {\n     3\t  runInTransaction,\n     4\t  runWithThreadTouchSuppressed,\n     5\t  type OperationContext,\n     6\t} from \"../../shared/context.js\";\n     7\timport type { DerivationType, DerivationReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type WorkItemRecord,\n    14\t  type WorkKind,\n    15\t} from \"../../tech-utils/work-queue/index.js\";\n    16\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    17\timport {\n    18\t  openThreadDatabase,\n    19\t  resolveThreadRef,\n    20\t  type ThreadRef,\n    21\t} from \"../threads/index.js\";\n    22\timport type { Derivation } from \"../../shared/derivation.js\";\n    23\timport {\n    24\t  findUnknownOutcomeCallSummary,\n    25\t  readMessageFormRow,\n    26\t  readMessageForms,\n    27\t  reportMessageForms,\n    28\t} from \"./internal/forms.js\";\n    29\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n    30\timport { projectEvent } from \"./internal/project.js\";\n    31\timport {\n    32\t  cascadeFromMessage,\n    33\t  cascadeMessageDelete,\n    34\t  cascadeTurnDelete,\n    35\t  type CascadeClear,\n    36\t  type CascadeOutcome,\n    37\t} from \"./internal/cascade.js\";\n    38\timport {\n    39\t  applyMessageEdit,\n    40\t  insertMessage,\n    41\t  markMessageDeleted,\n    42\t  markTurnMessagesDeleted,\n    43\t  readMessageById,\n    44\t  readMessages,\n    45\t  readMutableMessage,\n    46\t} from \"./internal/store.js\";\n    47\t\n    48\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    49\t\n    50\texport interface Block {\n    51\t  blockType: BlockType;\n    52\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    53\t}\n    54\t\n    55\texport interface MessageRecord {\n    56\t  messageId: string;\n    57\t  sourceEventOrder: number;\n    58\t  kind: Exclude<EventKind, \"turn_end\">;\n    59\t  blocks: Block[];\n    60\t  tokenEstimate: number;\n    61\t  actor: string;\n    62\t  harness: string;\n    63\t  turnId?: string;\n    64\t  // The message's derived derivations as stored (Epic 02 Story 2): present only\n    65\t  // for messages that are derivation sources — kinds with no derivable derivation\n    66\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n    67\t  // never re-derived on read.\n    68\t  derivations?: Derivation[];\n    69\t  // The deleted-audit marker (Epic 04 AC-3.3): present (true) only on\n    70\t  // deleted records, which only the includeDeleted listing and the show\n    71\t  // read ever surface — a default list never carries the key.\n    72\t  deleted?: boolean;\n    73\t}\n    74\t\n    75\t// The event as the walk holds it after recording: the validated input plus\n    76\t// its server-stamped order and timestamp.\n    77\texport type RecordedEvent = EventRecord;\n    78\t\n    79\texport type MessageCreated = {\n    80\t  messageId: string;\n    81\t  kind: Exclude<EventKind, \"turn_end\">;\n    82\t  // Carried for tool activity only: the pairing key the queue sites need —\n    83\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n    84\t  toolCallId?: string;\n    85\t} | null;\n    86\t\n    87\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    88\t// (the first such call through the operation context; turns.applyEvent\n    89\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    90\t// projection failure propagates to the pipeline's catch and rejects the\n    91\t// whole batch — recorded events without messages is the stranded state the\n    92\t// transaction exists to prevent. Returns null for turn_end (no message).\n    93\t// turnId is the membership stamp, settled by the pipeline before this call:\n    94\t// the turn open *after* this event's transition (so a prompt belongs to the\n    95\t// turn it just opened), or null in a gap — written once, never updated.\n    96\texport function createFromEvent(\n    97\t  ctx: OperationContext,\n    98\t  event: RecordedEvent,\n    99\t  turnId: string | null,\n   100\t): MessageCreated {\n   101\t  const projected = projectEvent(event);\n   102\t  if (projected === null) return null;\n   103\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n   104\t  const messageId = `m${event.eventOrder}`;\n   105\t  insertMessage(ctx.db, {\n   106\t    messageId,\n   107\t    sourceEventOrder: event.eventOrder,\n   108\t    kind,\n   109\t    tokenEstimate: projected.tokenEstimate,\n   110\t    actor: event.actor,\n   111\t    harness: event.harness,\n   112\t    turnId,\n   113\t    blocks: projected.blocks,\n   114\t  });\n   115\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n   116\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n   117\t  }\n   118\t  return { messageId, kind };\n   119\t}\n   120\t\n   121\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n   122\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n   123\t// tool result queues tool_result_summary, nothing else queues anything —\n   124\t// text, thinking, and note messages are not derivation sources (Epic 01\n   125\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   126\t// intake-stream inside the batch transaction for every recorded message, so\n   127\t// the item commits (or rolls back) with the batch.\n   128\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   129\t  user_prompt: \"prompt_smoothing\",\n   130\t  tool_call: \"tool_call_summary\",\n   131\t  tool_result: \"tool_result_summary\",\n   132\t};\n   133\t\n   134\t// Which derived form each message-owned kind produces — the owning domain's\n   135\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   136\t// rides the same transaction (DD-5).\n   137\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, DerivationType>> = {\n   138\t  prompt_smoothing: \"smoothed_prompt\",\n   139\t  tool_call_summary: \"tool_call_summary\",\n   140\t  tool_result_summary: \"tool_result_summary\",\n   141\t};\n   142\t\n   143\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   144\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n   145\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   146\t  messageWorkHandlers;\n   147\t\n   148\texport function queueMessageWork(\n   149\t  ctx: OperationContext,\n   150\t  message: MessageCreated,\n   151\t): WorkItemRecord[] {\n   152\t  if (message === null) return [];\n   153\t  const items: WorkItemRecord[] = [];\n   154\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   155\t  if (kind !== undefined) {\n   156\t    const form = MESSAGE_WORK_FORMS[kind];\n   157\t    if (form === undefined) {\n   158\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   159\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   160\t    }\n   161\t    items.push(\n   162\t      enqueue(ctx, {\n   163\t        owner: \"messages\",\n   164\t        kind,\n   165\t        sourceRef: { messageId: message.messageId },\n   166\t        derivations: [{ subjectKind: \"message\", subjectId: message.messageId, derivationType: form }],\n   167\t      }),\n   168\t    );\n   169\t  }\n   170\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n   171\t  // summary already derived with outcome \"unknown\" means the summary's\n   172\t  // source — the call+result pair — completed underneath it; clear and\n   173\t  // regenerate at the next source version, in this same batch transaction.\n   174\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n   175\t  // the common call-and-result-in-one-batch case never triggers, and the\n   176\t  // version-scoped item id keeps the requeue idempotent.\n   177\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n   178\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n   179\t    if (stale !== undefined) {\n   180\t      items.push(\n   181\t        enqueue(ctx, {\n   182\t          owner: \"messages\",\n   183\t          kind: \"tool_call_summary\",\n   184\t          sourceRef: { messageId: stale.messageId },\n   185\t          sourceVersion: stale.sourceVersion + 1,\n   186\t          derivations: [\n   187\t            {\n   188\t              subjectKind: \"message\",\n   189\t              subjectId: stale.messageId,\n   190\t              derivationType: \"tool_call_summary\",\n   191\t            },\n   192\t          ],\n   193\t        }),\n   194\t      );\n   195\t    }\n   196\t  }\n   197\t  return items;\n   198\t}\n   199\t\n   200\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   201\t  return {\n   202\t    ok: false,\n   203\t    error: {\n   204\t      errorClass: \"caller_error\",\n   205\t      code: \"thread_not_found\",\n   206\t      reason: `no thread file exists at ${filePath}`,\n   207\t    },\n   208\t  };\n   209\t}\n   210\t\n   211\t// Bounded-listing options (Epic 04 Story 1, DD-3): from/to are\n   212\t// source-event-order bounds, limit caps the count after bounds,\n   213\t// includeDeleted is the audit opt-in. All optional — existing callers see\n   214\t// identical results (visible messages, unbounded, record order).\n   215\texport interface MessageListOptions {\n   216\t  from?: number;\n   217\t  to?: number;\n   218\t  limit?: number;\n   219\t  includeDeleted?: boolean;\n   220\t}\n   221\t\n   222\tfunction invalidBounds(reason: string): ErrorResult {\n   223\t  return { errorClass: \"caller_error\", code: \"invalid_bounds\", reason };\n   224\t}\n   225\t\n   226\t// Bounds mistakes are operational caller errors returned as results (tech\n   227\t// design §Interface Definitions: from > to, limit < 1) — never a silent\n   228\t// empty list a caller could mistake for an empty window.\n   229\tfunction validateListOptions(opts: MessageListOptions): ErrorResult | undefined {\n   230\t  const integers: ReadonlyArray<readonly [string, number | undefined]> = [\n   231\t    [\"from\", opts.from],\n   232\t    [\"to\", opts.to],\n   233\t    [\"limit\", opts.limit],\n   234\t  ];\n   235\t  for (const [name, value] of integers) {\n   236\t    if (value !== undefined && !Number.isInteger(value)) {\n   237\t      return invalidBounds(`${name} must be an integer, got ${value}`);\n   238\t    }\n   239\t  }\n   240\t  if (opts.from !== undefined && opts.to !== undefined && opts.from > opts.to) {\n   241\t    return invalidBounds(`from (${opts.from}) must not exceed to (${opts.to})`);\n   242\t  }\n   243\t  if (opts.limit !== undefined && opts.limit < 1) {\n   244\t    return invalidBounds(`limit must be at least 1, got ${opts.limit}`);\n   245\t  }\n   246\t  return undefined;\n   247\t}\n   248\t\n   249\t// Reads-only is structural, not disciplined (DD-6, SV-01-001): the whole\n   250\t// operation runs in the touch-suppressed scope, so openThreadDatabase's open\n   251\t// announcement (openThreadDatabase → fireThreadTouch → scheduler.touch) can\n   252\t// never let a background SDK's scheduler hang a first-touch catch-up drain —\n   253\t// and the provider call that drain would make — off this read. A list calls\n   254\t// no provider and schedules no work in either host mode.\n   255\texport function listMessages(\n   256\t  thread: ThreadRef,\n   257\t  opts?: MessageListOptions,\n   258\t): Promise<OpResult<MessageRecord[]>> {\n   259\t  return runWithThreadTouchSuppressed(() => listMessagesInner(thread, opts));\n   260\t}\n   261\t\n   262\tasync function listMessagesInner(\n   263\t  thread: ThreadRef,\n   264\t  opts?: MessageListOptions,\n   265\t): Promise<OpResult<MessageRecord[]>> {\n   266\t  if (opts !== undefined) {\n   267\t    const badBounds = validateListOptions(opts);\n   268\t    if (badBounds !== undefined) return { ok: false, error: badBounds };\n   269\t  }\n   270\t  const resolved = await resolveThreadRef(thread);\n   271\t  if (!resolved.ok) return resolved;\n   272\t  const { filePath } = resolved.value;\n   273\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   274\t\n   275\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   276\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   277\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   278\t  // unmutated (F-03-002).\n   279\t  const opened = openThreadDatabase(filePath);\n   280\t  if (!opened.ok) return opened;\n   281\t  const db = opened.value;\n   282\t  try {\n   283\t    // Bounds resolve the window first (AC-3.1 no-load-everything), then the\n   284\t    // form read-back rides only that window (AC-2.1): each record carries its\n   285\t    // stored derived forms, attached from one grouped query scoped to the\n   286\t    // listed ids — never every message-owned form in a large thread.\n   287\t    const records = readMessages(db, opts ?? {});\n   288\t    const formsByMessage = readMessageForms(\n   289\t      db,\n   290\t      records.map((record) => record.messageId),\n   291\t    );\n   292\t    const withForms = records.map((record) => {\n   293\t      const derivations = formsByMessage.get(record.messageId);\n   294\t      return derivations === undefined ? record : { ...record, derivations };\n   295\t    });\n   296\t    return { ok: true, value: withForms };\n   297\t  } catch (cause) {\n   298\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   299\t    return storageFailure(`message read-back failed: ${reason}`);\n   300\t  } finally {\n   301\t    db.close();\n   302\t  }\n   303\t}\n   304\t\n   305\t// The single-message view (Epic 04 AC-3.2): the canonical record — every\n   306\t// block with complete content, full tool results, never the view-shortened\n   307\t// derivations — plus the message's derivation derivations with their states and\n   308\t// mechanically stamped metadata, joined from the owner's report read.\n   309\texport interface MessageDetail extends Omit<MessageRecord, \"derivations\"> {\n   310\t  // Always present and honest (AC-3.3): show on a deleted message returns\n   311\t  // the record flagged — audit is the point — never a not-found.\n   312\t  deleted: boolean;\n   313\t  // The owner report's queue-joined entries (DD-2), never synthesized here:\n   314\t  // the same `reportMessageForms` read messages.report serves, scoped by id.\n   315\t  derivations: DerivationReportEntry[];\n   316\t}\n   317\t\n   318\t// Reads-only is structural (DD-6, SV-01-001), exactly as listMessages: the\n   319\t// open announcement that would let a background scheduler hang a first-touch\n   320\t// catch-up drain (and its provider call) off this show is suppressed for the\n   321\t// whole operation. show on a deleted message stays the audit read; neither\n   322\t// path touches the queue or the provider.\n   323\texport function show(\n   324\t  thread: ThreadRef,\n   325\t  messageId: string,\n   326\t): Promise<OpResult<MessageDetail>> {\n   327\t  return runWithThreadTouchSuppressed(() => showInner(thread, messageId));\n   328\t}\n   329\t\n   330\tasync function showInner(\n   331\t  thread: ThreadRef,\n   332\t  messageId: string,\n   333\t): Promise<OpResult<MessageDetail>> {\n   334\t  const resolved = await resolveThreadRef(thread);\n   335\t  if (!resolved.ok) return resolved;\n   336\t  const { filePath } = resolved.value;\n   337\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   338\t\n   339\t  const opened = openThreadDatabase(filePath);\n   340\t  if (!opened.ok) return opened;\n   341\t  const db = opened.value;\n   342\t  try {\n   343\t    const record = readMessageById(db, messageId);\n   344\t    if (record === undefined) {\n   345\t      return {\n   346\t        ok: false,\n   347\t        error: {\n   348\t          errorClass: \"caller_error\",\n   349\t          code: \"message_not_found\",\n   350\t          reason: `no message ${messageId} exists in this thread`,\n   351\t        },\n   352\t      };\n   353\t    }\n   354\t    const derivations = reportMessageForms(db, { messageId });\n   355\t    return { ok: true, value: { ...record, derivations } };\n   356\t  } catch (cause) {\n   357\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   358\t    return storageFailure(`message show failed: ${reason}`);\n   359\t  } finally {\n   360\t    db.close();\n   361\t  }\n   362\t}\n   363\t\n   364\texport async function listQueuedWork(\n   365\t  thread: ThreadRef,\n   366\t): Promise<OpResult<WorkItemRecord[]>> {\n   367\t  const resolved = await resolveThreadRef(thread);\n   368\t  if (!resolved.ok) return resolved;\n   369\t  const { filePath } = resolved.value;\n   370\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   371\t\n   372\t  const opened = openThreadDatabase(filePath);\n   373\t  if (!opened.ok) return opened;\n   374\t  const db = opened.value;\n   375\t  try {\n   376\t    return { ok: true, value: listItems(db, \"messages\") };\n   377\t  } catch (cause) {\n   378\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   379\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   380\t  } finally {\n   381\t    db.close();\n   382\t  }\n   383\t}\n   384\t\n   385\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   386\t\n   387\t// This owner's repair report: every message-owned form's durable state\n   388\t// joined with live queue detail in one query — the five operational\n   389\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n   390\t// without any queue API. Needs no provider; reads degrade, never block.\n   391\texport async function report(\n   392\t  thread: ThreadRef,\n   393\t  opts?: { notReady?: boolean; messageId?: string },\n   394\t): Promise<OpResult<DerivationReportEntry[]>> {\n   395\t  const resolved = await resolveThreadRef(thread);\n   396\t  if (!resolved.ok) return resolved;\n   397\t  const { filePath } = resolved.value;\n   398\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   399\t\n   400\t  const opened = openThreadDatabase(filePath);\n   401\t  if (!opened.ok) return opened;\n   402\t  const db = opened.value;\n   403\t  try {\n   404\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n   405\t  } catch (cause) {\n   406\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   407\t    return storageFailure(`report read failed: ${reason}`);\n   408\t  } finally {\n   409\t    db.close();\n   410\t  }\n   411\t}\n   412\t\n   413\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   414\t\n   415\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n   416\t// inverted; the requeue's join from the named form back to its queue site.\n   417\tconst MESSAGE_FORM_KINDS: Partial<Record<DerivationType, WorkKind>> = {\n   418\t  smoothed_prompt: \"prompt_smoothing\",\n   419\t  tool_call_summary: \"tool_call_summary\",\n   420\t  tool_result_summary: \"tool_result_summary\",\n   421\t};\n   422\t\n   423\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n   424\t// supported rebuild act. Refused for blocked derivations with the derivation's stored\n   425\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n   426\t// queued or in flight at the derivation's current source version (AC-4.5).\n   427\t// Otherwise the derivation clears to pending and re-enqueues at the next source\n   428\t// version — the same enqueue path intake uses, poke-on-commit included, so\n   429\t// background mode processes the repair with no further call. The no-op check\n   430\t// and the enqueue commit in one transaction (anti-shim: a split would\n   431\t// reintroduce the duplicate-work race).\n   432\texport async function requeue(\n   433\t  thread: ThreadRef,\n   434\t  target: { messageId: string; derivationType: DerivationType },\n   435\t): Promise<OpResult<RequeueOutcome>> {\n   436\t  const kind = MESSAGE_FORM_KINDS[target.derivationType];\n   437\t  if (kind === undefined) {\n   438\t    return {\n   439\t      ok: false,\n   440\t      error: {\n   441\t        errorClass: \"caller_error\",\n   442\t        code: \"message_not_found\",\n   443\t        reason: `derivation ${target.derivationType} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n   444\t      },\n   445\t    };\n   446\t  }\n   447\t  const resolved = await resolveThreadRef(thread);\n   448\t  if (!resolved.ok) return resolved;\n   449\t  const { filePath } = resolved.value;\n   450\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   451\t\n   452\t  const opened = openThreadDatabase(filePath);\n   453\t  if (!opened.ok) return opened;\n   454\t  const db = opened.value;\n   455\t  try {\n   456\t    const meta = db\n   457\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   458\t      .get() as { thread_id: string } | undefined;\n   459\t    const threadId = meta?.thread_id ?? \"\";\n   460\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   461\t      const row = readMessageFormRow(ctx.db, target.messageId, target.derivationType);\n   462\t      if (row === undefined) {\n   463\t        return {\n   464\t          ok: false,\n   465\t          error: {\n   466\t            errorClass: \"caller_error\",\n   467\t            code: \"message_not_found\",\n   468\t            reason: `no derived derivation ${target.derivationType} exists for message ${target.messageId}`,\n   469\t          },\n   470\t        };\n   471\t      }\n   472\t      if (row.state === \"blocked\") {\n   473\t        // The refusal carries the derivation's stored reason — the damage named at\n   474\t        // blocking time, not a generic string (AC-4.6).\n   475\t        return {\n   476\t          ok: false,\n   477\t          error: {\n   478\t            errorClass: \"state_corruption\",\n   479\t            code: \"source_damaged\",\n   480\t            reason: row.reason ?? `derivation ${target.derivationType} for message ${target.messageId} is blocked`,\n   481\t          },\n   482\t        };\n   483\t      }\n   484\t      const sourceRef = { messageId: target.messageId };\n   485\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n   486\t        return { ok: true, value: { noop: \"already_queued\" } };\n   487\t      }\n   488\t      const item = enqueue(ctx, {\n   489\t        owner: \"messages\",\n   490\t        kind,\n   491\t        sourceRef,\n   492\t        sourceVersion: row.sourceVersion + 1,\n   493\t        derivations: [{ subjectKind: \"message\", subjectId: target.messageId, derivationType: target.derivationType }],\n   494\t      });\n   495\t      return { ok: true, value: { workItemId: item.workItemId } };\n   496\t    });\n   497\t  } catch (cause) {\n   498\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   499\t    return storageFailure(`requeue failed: ${reason}`);\n   500\t  } finally {\n   501\t    db.close();\n   502\t  }\n   503\t}\n   504\t\n   505\t// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n   506\t\n   507\t// The mutation result contract (tech design §Interfaces): what changed in\n   508\t// the record, which dependent derivations cleared, which dropped (delete only),\n   509\t// what replacement work queued, and which still-queued old items the cascade\n   510\t// tidied away (issue 1). Shared by edit and the Story 6 deletes.\n   511\texport interface MutationResult {\n   512\t  changed: { messageIds: string[]; turnIds: string[] };\n   513\t  cleared: CascadeClear[];\n   514\t  dropped: CascadeClear[];\n   515\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n   516\t  superseded: string[];\n   517\t}\n   518\t\n   519\t// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n   520\t// message's content and blocks, re-stamp the token estimate, and walk the\n   521\t// full dependent chain — clear to pending, supersede queued old work,\n   522\t// enqueue replacements at the next source version — in one transaction.\n   523\t// Synchronous and local by contract: everything above commits before this\n   524\t// returns; the re-queued rebuilds run through the normal drain (background\n   525\t// mode needs no further call — the enqueue pokes ride the commit). Events\n   526\t// are never touched (projection-level mutation, DD-12), and no generated\n   527\t// thread-view is either — visibility arrives at the next compact/rebuild.\n   528\t// Refusals read through the deleted-filtered view and enforce the closed-turn\n   529\t// target boundary: only a message in a closed turn is editable, so an\n   530\t// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\n   531\t// the boundary's one stable code — a missing or deleted message is\n   532\t// message_not_found, and a refusal changes nothing.\n   533\texport async function edit(\n   534\t  thread: ThreadRef,\n   535\t  input: { messageId: string; content: string },\n   536\t): Promise<OpResult<MutationResult>> {\n   537\t  const resolved = await resolveThreadRef(thread);\n   538\t  if (!resolved.ok) return resolved;\n   539\t  const { filePath } = resolved.value;\n   540\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   541\t\n   542\t  const opened = openThreadDatabase(filePath);\n   543\t  if (!opened.ok) return opened;\n   544\t  const db = opened.value;\n   545\t  try {\n   546\t    const meta = db\n   547\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   548\t      .get() as { thread_id: string } | undefined;\n   549\t    const threadId = meta?.thread_id ?? \"\";\n   550\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   551\t      const target = readMutableMessage(ctx.db, input.messageId);\n   552\t      if (target === undefined) {\n   553\t        return {\n   554\t          ok: false,\n   555\t          error: {\n   556\t            errorClass: \"caller_error\",\n   557\t            code: \"message_not_found\",\n   558\t            reason: `no message ${input.messageId} exists in this thread`,\n   559\t          },\n   560\t        };\n   561\t      }\n   562\t      // The closed-turn target boundary (story scope; AC-5.1): the edit's\n   563\t      // editable class is a message in a *closed* turn. Both failing cases —\n   564\t      // an open turn and a turnless gap message (no membership) — refuse under\n   565\t      // the one stable code; the reason distinguishes them so the open-turn\n   566\t      // message reads exactly as before. A deleted/missing target never gets\n   567\t      // here (it misses the filtered read above as message_not_found).\n   568\t      if (target.turnStatus !== \"closed\") {\n   569\t        return {\n   570\t          ok: false,\n   571\t          error: {\n   572\t            errorClass: \"caller_error\",\n   573\t            code: \"turn_open\",\n   574\t            reason:\n   575\t              target.turnStatus === \"open\"\n   576\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be edited (v1 boundary)`\n   577\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\n   578\t          },\n   579\t        };\n   580\t      }\n   581\t      applyMessageEdit(ctx.db, input.messageId, input.content);\n   582\t      const cascade = cascadeFromMessage(ctx, input.messageId);\n   583\t      return {\n   584\t        ok: true,\n   585\t        value: {\n   586\t          changed: { messageIds: [input.messageId], turnIds: [] },\n   587\t          cleared: cascade.cleared,\n   588\t          dropped: cascade.dropped,\n   589\t          queued: cascade.queued,\n   590\t          superseded: cascade.superseded,\n   591\t        },\n   592\t      };\n   593\t    });\n   594\t  } catch (cause) {\n   595\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   596\t    return storageFailure(`edit failed: ${reason}`);\n   597\t  } finally {\n   598\t    db.close();\n   599\t  }\n   600\t}\n   601\t\n   602\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n   603\t\n   604\t// The record's removal mutation for one message (AC-6.1–6.3, 6.7):\n   605\t// projection-level delete — the deleted_at stamp plus the delete cascade\n   606\t// (own forms dropped, turn and chunk cleared and re-queued for minus-one\n   607\t// composition) in one transaction. The source events are never touched;\n   608\t// event read-back keeps returning them (the audit surface). Validation\n   609\t// reads the same filtered view as edit, so a missing, deleted, or\n   610\t// double-deleted target is message_not_found and an open-turn or turnless\n   611\t// gap target is turn_open. The one delete-specific refusal is prompt\n   612\t// protection: a turn is a prompt and what came back for it, so deleting the\n   613\t// turn's initiating prompt is refused toward turns.deleteTurn — the error\n   614\t// names the turn and that path (AC-6.3).\n   615\texport async function deleteMessage(\n   616\t  thread: ThreadRef,\n   617\t  input: { messageId: string },\n   618\t): Promise<OpResult<MutationResult>> {\n   619\t  const resolved = await resolveThreadRef(thread);\n   620\t  if (!resolved.ok) return resolved;\n   621\t  const { filePath } = resolved.value;\n   622\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   623\t\n   624\t  const opened = openThreadDatabase(filePath);\n   625\t  if (!opened.ok) return opened;\n   626\t  const db = opened.value;\n   627\t  try {\n   628\t    const meta = db\n   629\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   630\t      .get() as { thread_id: string } | undefined;\n   631\t    const threadId = meta?.thread_id ?? \"\";\n   632\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   633\t      const target = readMutableMessage(ctx.db, input.messageId);\n   634\t      if (target === undefined) {\n   635\t        return {\n   636\t          ok: false,\n   637\t          error: {\n   638\t            errorClass: \"caller_error\",\n   639\t            code: \"message_not_found\",\n   640\t            reason: `no message ${input.messageId} exists in this thread`,\n   641\t          },\n   642\t        };\n   643\t      }\n   644\t      if (target.turnStatus !== \"closed\") {\n   645\t        return {\n   646\t          ok: false,\n   647\t          error: {\n   648\t            errorClass: \"caller_error\",\n   649\t            code: \"turn_open\",\n   650\t            reason:\n   651\t              target.turnStatus === \"open\"\n   652\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be deleted (v1 boundary)`\n   653\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be deleted (v1 boundary)`,\n   654\t          },\n   655\t        };\n   656\t      }\n   657\t      if (target.initiatesTurn) {\n   658\t        return {\n   659\t          ok: false,\n   660\t          error: {\n   661\t            errorClass: \"caller_error\",\n   662\t            code: \"message_initiates_turn\",\n   663\t            reason: `message ${input.messageId} is the prompt that initiates turn ${target.turnId ?? \"\"}; a turn is a prompt and what came back for it — delete the whole exchange with turns.deleteTurn (lhc turns delete --turn-id ${target.turnId ?? \"\"})`,\n   664\t          },\n   665\t        };\n   666\t      }\n   667\t      markMessageDeleted(ctx.db, input.messageId, ctx.clock().toISOString());\n   668\t      const cascade = cascadeMessageDelete(ctx, input.messageId);\n   669\t      return {\n   670\t        ok: true,\n   671\t        value: {\n   672\t          changed: { messageIds: [input.messageId], turnIds: [] },\n   673\t          cleared: cascade.cleared,\n   674\t          dropped: cascade.dropped,\n   675\t          queued: cascade.queued,\n   676\t          superseded: cascade.superseded,\n   677\t        },\n   678\t      };\n   679\t    });\n   680\t  } catch (cause) {\n   681\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   682\t    return storageFailure(`delete failed: ${reason}`);\n   683\t  } finally {\n   684\t    db.close();\n   685\t  }\n   686\t}\n   687\t\n   688\t// Cross-domain surface for turns.deleteTurn (DD-8: one cascade module, two\n   689\t// callers), called inside the turn delete's transaction after the turn row\n   690\t// is stamped. The messages domain owns the message-table write — the member\n   691\t// stamp, scoped to live rows — and the shared cascade entry; the turns\n   692\t// operation owns its own validation and turn-row stamp. Returns the cascade\n   693\t// outcome plus the member ids stamped now (record order), which the turn\n   694\t// delete reports as its changed messages.\n   695\texport function applyTurnDeleteCascade(\n   696\t  ctx: OperationContext,\n   697\t  turnId: string,\n   698\t): CascadeOutcome & { memberMessageIds: string[] } {\n   699\t  const memberMessageIds = markTurnMessagesDeleted(\n   700\t    ctx.db,\n   701\t    turnId,\n   702\t    ctx.clock().toISOString(),\n   703\t  );\n   704\t  return { ...cascadeTurnDelete(ctx, turnId, memberMessageIds), memberMessageIds };\n   705\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/index.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type {\n     4\t  DerivationType,\n     5\t  DerivationReportEntry,\n     6\t  WorkHandler,\n     7\t} from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type EnqueueDerivationTarget,\n    14\t  type WorkItemRecord,\n    15\t  type WorkKind,\n    16\t  type WorkSourceRef,\n    17\t} from \"../../tech-utils/work-queue/index.js\";\n    18\timport type { EventKind } from \"../intake-stream/index.js\";\n    19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    20\timport { transition } from \"./internal/state-machine.js\";\n    21\t\n    22\t// The pure rule table, re-exported for the golden supplemental suite (the\n    23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    24\t// callers go through applyEvent.\n    25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    26\timport type { Derivation } from \"../../shared/derivation.js\";\n    27\timport { turnWorkHandlers } from \"./internal/derive.js\";\n    28\timport {\n    29\t  readChunkRows,\n    30\t  readOwnedForms,\n    31\t  readTurnFormRow,\n    32\t  reportTurnForms,\n    33\t} from \"./internal/forms.js\";\n    34\timport {\n    35\t  applyTurnDeleteCascade,\n    36\t  type MutationResult,\n    37\t} from \"../messages/index.js\";\n    38\timport {\n    39\t  closeTurn,\n    40\t  insertOpenTurn,\n    41\t  markTurnDeleted,\n    42\t  nextTurnOrder,\n    43\t  readMutableTurn,\n    44\t  readTurns,\n    45\t  selectOpenTurnIds,\n    46\t} from \"./internal/store.js\";\n    47\t\n    48\texport interface TurnRecord {\n    49\t  turnId: string;\n    50\t  status: \"open\" | \"closed\";\n    51\t  memberMessageIds: string[];\n    52\t  openedAtEventOrder: number;\n    53\t  closedAtEventOrder?: number;\n    54\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n    55\t  // derivation placed it — stored values read back, never recomputed.\n    56\t  chunkId?: string;\n    57\t  memberIdx?: number;\n    58\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n    59\t  // present only when rows exist — a closed turn carries them from the\n    60\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n    61\t  // the message read's forms key; reads degrade, never block.\n    62\t  derivations?: Derivation[];\n    63\t}\n    64\t\n    65\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n    66\t// record with live membership and its summary forms' states attached —\n    67\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n    68\t// with form states\".\n    69\texport interface ChunkRecord {\n    70\t  chunkId: string;\n    71\t  chunkOrder: number;\n    72\t  status: \"open\" | \"closed\";\n    73\t  accumulatedProjectedTokens: number;\n    74\t  memberTurnIds: string[];\n    75\t  derivations?: Derivation[];\n    76\t}\n    77\t\n    78\texport interface TurnTransitionOutcome {\n    79\t  // Transitions in occurrence order: a close_then_open reports the close\n    80\t  // first, then the open, exactly as the batch result surfaces them.\n    81\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    82\t  // Turn state after the transition — the stamp for this event's message.\n    83\t  // Prompts see the turn they just opened (transition first, then stamp);\n    84\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    85\t  openTurnId: string | null;\n    86\t  // Work queued by this transition: one turn_derivation item per closed\n    87\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    88\t  queuedWork: WorkItemRecord[];\n    89\t}\n    90\t\n    91\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    92\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    93\t// writes turn state, so more than one open turn means external interference.\n    94\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    95\t  return selectOpenTurnIds(ctx.db);\n    96\t}\n    97\t\n    98\t// Closing a turn — by either close path — durably queues that turn's\n    99\t// derivation work in the same transaction (AC-3.6): the close update and the\n   100\t// work item commit or roll back together.\n   101\tfunction closeTurnAndQueueWork(\n   102\t  ctx: OperationContext,\n   103\t  turnId: string,\n   104\t  eventOrder: number,\n   105\t): WorkItemRecord {\n   106\t  closeTurn(ctx.db, turnId, eventOrder);\n   107\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n   108\t  // lands the rendering and the lower-band projection as independent rows;\n   109\t  // both go pending with the enqueue (DD-5).\n   110\t  return enqueue(ctx, {\n   111\t    owner: \"turns\",\n   112\t    kind: \"turn_derivation\",\n   113\t    sourceRef: { turnId },\n   114\t    derivations: [\n   115\t      { subjectKind: \"turn\", subjectId: turnId, derivationType: \"turn_rendering\" },\n   116\t      { subjectKind: \"turn\", subjectId: turnId, derivationType: \"lower_band_projection\" },\n   117\t    ],\n   118\t  });\n   119\t}\n   120\t\n   121\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n   122\t// construction (DD-6): turn derivation and the two chunk summaries.\n   123\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   124\t  turnWorkHandlers;\n   125\t\n   126\t// Cross-domain surface, called by intake-stream inside the batch transaction\n   127\t// for every recorded event. Synchronous and throwing by design, like\n   128\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n   129\texport function applyEvent(\n   130\t  ctx: OperationContext,\n   131\t  eventKind: EventKind,\n   132\t  eventOrder: number,\n   133\t): TurnTransitionOutcome {\n   134\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n   135\t  const effect = transition({ openTurnId }, eventKind);\n   136\t  switch (effect.kind) {\n   137\t    case \"none\":\n   138\t      return { transitions: [], openTurnId, queuedWork: [] };\n   139\t    case \"open\": {\n   140\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   141\t      return {\n   142\t        transitions: [{ action: \"opened\", turnId }],\n   143\t        openTurnId: turnId,\n   144\t        queuedWork: [],\n   145\t      };\n   146\t    }\n   147\t    case \"close\": {\n   148\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   149\t      return {\n   150\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   151\t        openTurnId: null,\n   152\t        queuedWork: [item],\n   153\t      };\n   154\t    }\n   155\t    case \"close_then_open\": {\n   156\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   157\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   158\t      return {\n   159\t        transitions: [\n   160\t          { action: \"closed\", turnId: openTurnId as string },\n   161\t          { action: \"opened\", turnId },\n   162\t        ],\n   163\t        openTurnId: turnId,\n   164\t        queuedWork: [item],\n   165\t      };\n   166\t    }\n   167\t  }\n   168\t}\n   169\t\n   170\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   171\t  return {\n   172\t    ok: false,\n   173\t    error: {\n   174\t      errorClass: \"caller_error\",\n   175\t      code: \"thread_not_found\",\n   176\t      reason: `no thread file exists at ${filePath}`,\n   177\t    },\n   178\t  };\n   179\t}\n   180\t\n   181\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   182\t  const resolved = await resolveThreadRef(thread);\n   183\t  if (!resolved.ok) return resolved;\n   184\t  const { filePath } = resolved.value;\n   185\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   186\t\n   187\t  const opened = openThreadDatabase(filePath);\n   188\t  if (!opened.ok) return opened;\n   189\t  const db = opened.value;\n   190\t  try {\n   191\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n   192\t    // stored derived forms, attached from one grouped query — mirroring the\n   193\t    // message read's production path for \"readable alongside the record\".\n   194\t    const formsByTurn = readOwnedForms(db, \"turn\");\n   195\t    const records = readTurns(db).map((record) => {\n   196\t      const derivations = formsByTurn.get(record.turnId);\n   197\t      return derivations === undefined ? record : { ...record, derivations };\n   198\t    });\n   199\t    return { ok: true, value: records };\n   200\t  } catch (cause) {\n   201\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   202\t    return storageFailure(`turn read-back failed: ${reason}`);\n   203\t  } finally {\n   204\t    db.close();\n   205\t  }\n   206\t}\n   207\t\n   208\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n   209\t// returns stored records whatever the forms' states — reads degrade, never\n   210\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n   211\t// summary rows until close queues them).\n   212\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n   213\t  const resolved = await resolveThreadRef(thread);\n   214\t  if (!resolved.ok) return resolved;\n   215\t  const { filePath } = resolved.value;\n   216\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   217\t\n   218\t  const opened = openThreadDatabase(filePath);\n   219\t  if (!opened.ok) return opened;\n   220\t  const db = opened.value;\n   221\t  try {\n   222\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n   223\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n   224\t      const derivations = formsByChunk.get(row.chunkId);\n   225\t      return derivations === undefined ? row : { ...row, derivations };\n   226\t    });\n   227\t    return { ok: true, value: records };\n   228\t  } catch (cause) {\n   229\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   230\t    return storageFailure(`chunk read-back failed: ${reason}`);\n   231\t  } finally {\n   232\t    db.close();\n   233\t  }\n   234\t}\n   235\t\n   236\texport async function listQueuedWork(\n   237\t  thread: ThreadRef,\n   238\t): Promise<OpResult<WorkItemRecord[]>> {\n   239\t  const resolved = await resolveThreadRef(thread);\n   240\t  if (!resolved.ok) return resolved;\n   241\t  const { filePath } = resolved.value;\n   242\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   243\t\n   244\t  const opened = openThreadDatabase(filePath);\n   245\t  if (!opened.ok) return opened;\n   246\t  const db = opened.value;\n   247\t  try {\n   248\t    return { ok: true, value: listItems(db, \"turns\") };\n   249\t  } catch (cause) {\n   250\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   251\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   252\t  } finally {\n   253\t    db.close();\n   254\t  }\n   255\t}\n   256\t\n   257\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   258\t\n   259\t// This owner's repair report: every turn- and chunk-owned form's durable\n   260\t// state joined with live queue detail in one query. Needs no provider;\n   261\t// reads degrade, never block.\n   262\texport async function report(\n   263\t  thread: ThreadRef,\n   264\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   265\t): Promise<OpResult<DerivationReportEntry[]>> {\n   266\t  const resolved = await resolveThreadRef(thread);\n   267\t  if (!resolved.ok) return resolved;\n   268\t  const { filePath } = resolved.value;\n   269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   270\t\n   271\t  const opened = openThreadDatabase(filePath);\n   272\t  if (!opened.ok) return opened;\n   273\t  const db = opened.value;\n   274\t  try {\n   275\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   276\t  } catch (cause) {\n   277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   278\t    return storageFailure(`report read failed: ${reason}`);\n   279\t  } finally {\n   280\t    db.close();\n   281\t  }\n   282\t}\n   283\t\n   284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   285\t\n   286\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n   287\t// the one turn_derivation item (the handler lands rendering and projection\n   288\t// together, so a rebuild of either re-derives both — the rebuild rule from\n   289\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n   290\t// independent lifecycles).\n   291\tfunction turnRequeueTarget(target: {\n   292\t  subjectKind: \"turn\" | \"chunk\";\n   293\t  subjectId: string;\n   294\t  derivationType: DerivationType;\n   295\t}): { kind: WorkKind; sourceRef: WorkSourceRef; derivations: EnqueueDerivationTarget[] } | undefined {\n   296\t  if (\n   297\t    target.subjectKind === \"turn\" &&\n   298\t    (target.derivationType === \"turn_rendering\" || target.derivationType === \"lower_band_projection\")\n   299\t  ) {\n   300\t    return {\n   301\t      kind: \"turn_derivation\",\n   302\t      sourceRef: { turnId: target.subjectId },\n   303\t      derivations: [\n   304\t        { subjectKind: \"turn\", subjectId: target.subjectId, derivationType: \"turn_rendering\" },\n   305\t        { subjectKind: \"turn\", subjectId: target.subjectId, derivationType: \"lower_band_projection\" },\n   306\t      ],\n   307\t    };\n   308\t  }\n   309\t  if (\n   310\t    target.subjectKind === \"chunk\" &&\n   311\t    (target.derivationType === \"chunk_summary_detailed\" || target.derivationType === \"chunk_summary_brief\")\n   312\t  ) {\n   313\t    return {\n   314\t      kind: target.derivationType,\n   315\t      sourceRef: { chunkId: target.subjectId },\n   316\t      derivations: [{ subjectKind: \"chunk\", subjectId: target.subjectId, derivationType: target.derivationType }],\n   317\t    };\n   318\t  }\n   319\t  return undefined;\n   320\t}\n   321\t\n   322\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   323\t// messages.requeue — blocked refused with the stored damage reason, missing\n   324\t// rows refused, no-op against live work at the current source version, and\n   325\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   326\t// at the next source version: composed forms recompute their gaps from\n   327\t// current dependency states (Flow 3's rebuild rule).\n   328\texport async function requeue(\n   329\t  thread: ThreadRef,\n   330\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; derivationType: DerivationType },\n   331\t): Promise<OpResult<RequeueOutcome>> {\n   332\t  const mapped = turnRequeueTarget(target);\n   333\t  if (mapped === undefined) {\n   334\t    return {\n   335\t      ok: false,\n   336\t      error: {\n   337\t        errorClass: \"caller_error\",\n   338\t        code: \"turn_not_found\",\n   339\t        reason: `derivation ${target.derivationType} is not a ${target.subjectKind}-owned derivation; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   340\t      },\n   341\t    };\n   342\t  }\n   343\t  const resolved = await resolveThreadRef(thread);\n   344\t  if (!resolved.ok) return resolved;\n   345\t  const { filePath } = resolved.value;\n   346\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   347\t\n   348\t  const opened = openThreadDatabase(filePath);\n   349\t  if (!opened.ok) return opened;\n   350\t  const db = opened.value;\n   351\t  try {\n   352\t    const meta = db\n   353\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   354\t      .get() as { thread_id: string } | undefined;\n   355\t    const threadId = meta?.thread_id ?? \"\";\n   356\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   357\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.derivationType);\n   358\t      if (row === undefined) {\n   359\t        return {\n   360\t          ok: false,\n   361\t          error: {\n   362\t            errorClass: \"caller_error\",\n   363\t            code: \"turn_not_found\",\n   364\t            reason: `no derived derivation ${target.derivationType} exists for ${target.subjectKind} ${target.subjectId}`,\n   365\t          },\n   366\t        };\n   367\t      }\n   368\t      if (row.state === \"blocked\") {\n   369\t        // The refusal carries the derivation's stored reason — the damage named at\n   370\t        // blocking time, not a generic string (AC-4.6).\n   371\t        return {\n   372\t          ok: false,\n   373\t          error: {\n   374\t            errorClass: \"state_corruption\",\n   375\t            code: \"source_damaged\",\n   376\t            reason:\n   377\t              row.reason ??\n   378\t              `derivation ${target.derivationType} for ${target.subjectKind} ${target.subjectId} is blocked`,\n   379\t          },\n   380\t        };\n   381\t      }\n   382\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n   383\t        return { ok: true, value: { noop: \"already_queued\" } };\n   384\t      }\n   385\t      const item = enqueue(ctx, {\n   386\t        owner: \"turns\",\n   387\t        kind: mapped.kind,\n   388\t        sourceRef: mapped.sourceRef,\n   389\t        sourceVersion: row.sourceVersion + 1,\n   390\t        derivations: mapped.derivations,\n   391\t      });\n   392\t      return { ok: true, value: { workItemId: item.workItemId } };\n   393\t    });\n   394\t  } catch (cause) {\n   395\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   396\t    return storageFailure(`requeue failed: ${reason}`);\n   397\t  } finally {\n   398\t    db.close();\n   399\t  }\n   400\t}\n   401\t\n   402\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n   403\t\n   404\t// The whole-exchange removal (AC-6.4–6.7): \"that exchange was a dead end —\n   405\t// kill it.\" One transaction stamps the turn and all its live member\n   406\t// messages deleted, drops the turn's and members' derivations, and\n   407\t// re-queues the containing chunk's summaries from the remaining live\n   408\t// members — or drops them when the chunk empties out (AC-6.6). The shared\n   409\t// machinery is the messages domain's cascade module (DD-8, one cascade,\n   410\t// two callers), reached through its public surface; this operation owns\n   411\t// the turn-side validation and the turn-row stamp. Source events are never\n   412\t// touched; chunk membership rows are never moved or re-cut — reads filter\n   413\t// the deleted turn out, shrinking the chunk in place. Refusals read the\n   414\t// filtered view: a missing, deleted, or double-deleted turn is\n   415\t// turn_not_found; an open turn is turn_open; a refusal changes nothing.\n   416\texport async function deleteTurn(\n   417\t  thread: ThreadRef,\n   418\t  input: { turnId: string },\n   419\t): Promise<OpResult<MutationResult>> {\n   420\t  const resolved = await resolveThreadRef(thread);\n   421\t  if (!resolved.ok) return resolved;\n   422\t  const { filePath } = resolved.value;\n   423\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   424\t\n   425\t  const opened = openThreadDatabase(filePath);\n   426\t  if (!opened.ok) return opened;\n   427\t  const db = opened.value;\n   428\t  try {\n   429\t    const meta = db\n   430\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   431\t      .get() as { thread_id: string } | undefined;\n   432\t    const threadId = meta?.thread_id ?? \"\";\n   433\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   434\t      const target = readMutableTurn(ctx.db, input.turnId);\n   435\t      if (target === undefined) {\n   436\t        return {\n   437\t          ok: false,\n   438\t          error: {\n   439\t            errorClass: \"caller_error\",\n   440\t            code: \"turn_not_found\",\n   441\t            reason: `no turn ${input.turnId} exists in this thread`,\n   442\t          },\n   443\t        };\n   444\t      }\n   445\t      if (target.status !== \"closed\") {\n   446\t        return {\n   447\t          ok: false,\n   448\t          error: {\n   449\t            errorClass: \"caller_error\",\n   450\t            code: \"turn_open\",\n   451\t            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\n   452\t          },\n   453\t        };\n   454\t      }\n   455\t      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\n   456\t      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\n   457\t      return {\n   458\t        ok: true,\n   459\t        value: {\n   460\t          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\n   461\t          cleared: cascade.cleared,\n   462\t          dropped: cascade.dropped,\n   463\t          queued: cascade.queued,\n   464\t          superseded: cascade.superseded,\n   465\t        },\n   466\t      };\n   467\t    });\n   468\t  } catch (cause) {\n   469\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   470\t    return storageFailure(`delete failed: ${reason}`);\n   471\t  } finally {\n   472\t    db.close();\n   473\t  }\n   474\t}\n","exit_code":0,"status":"completed"}}

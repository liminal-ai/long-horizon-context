{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/threads/internal/create.ts'","aggregated_output":"     1\timport { randomBytes } from \"node:crypto\";\n     2\timport { rmSync } from \"node:fs\";\n     3\timport { DatabaseSync } from \"node:sqlite\";\n     4\timport { fireThreadTouch } from \"../../../shared/context.js\";\n     5\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n     6\timport {\n     7\t  getSchemaVersion,\n     8\t  MIGRATION_V5_STATEMENTS,\n     9\t  MIGRATION_V6_STATEMENTS,\n    10\t  MIGRATION_V7_STATEMENTS,\n    11\t  openDatabase,\n    12\t  runMigrations,\n    13\t  type Migration,\n    14\t} from \"../../../shared/storage.js\";\n    15\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n    16\t\n    17\t// The one random id: its uniqueness scope is global across files and\n    18\t// registries (design decision 7).\n    19\texport function generateThreadId(): string {\n    20\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n    21\t}\n    22\t\n    23\t// The thread-file schema as a versioned history, never rewritten in place:\n    24\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n    25\t// each later story appends a version. Existing files upgrade lazily through\n    26\t// openThreadDatabase, so a file recorded under an earlier story is always\n    27\t// usable by a later one (F-03-001).\n    28\t//\n    29\t// Creation-time metadata values are interpolated through buildThreadMigrations\n    30\t// for new files only; existing files already hold their metadata row and the\n    31\t// upgrade path never touches it.\n    32\tfunction buildThreadMigrations(\n    33\t  metadata?: { threadId: string; createdAt: string },\n    34\t): Migration[] {\n    35\t  const metadataInsert =\n    36\t    metadata === undefined\n    37\t      ? []\n    38\t      : [\n    39\t          // Interpolated values are all generated by us (hex id, ISO\n    40\t          // timestamp, estimator constant) — never caller input.\n    41\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n    42\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n    43\t        ];\n    44\t  return [\n    45\t    {\n    46\t      version: 1,\n    47\t      statements: [\n    48\t        `CREATE TABLE thread_metadata (\n    49\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n    50\t          thread_id TEXT NOT NULL,\n    51\t          created_at TEXT NOT NULL,\n    52\t          token_estimator TEXT NOT NULL\n    53\t        );`,\n    54\t        ...metadataInsert,\n    55\t        `CREATE TABLE event (\n    56\t          event_order INTEGER PRIMARY KEY,\n    57\t          event_kind TEXT NOT NULL,\n    58\t          idempotency_key TEXT NOT NULL UNIQUE,\n    59\t          actor TEXT NOT NULL,\n    60\t          harness TEXT NOT NULL,\n    61\t          payload TEXT NOT NULL,\n    62\t          recorded_at TEXT NOT NULL\n    63\t        );`,\n    64\t      ],\n    65\t    },\n    66\t    {\n    67\t      version: 2, // Story 3: message projection\n    68\t      statements: [\n    69\t        `CREATE TABLE message (\n    70\t          message_id TEXT PRIMARY KEY,\n    71\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n    72\t          kind TEXT NOT NULL,\n    73\t          token_estimate INTEGER NOT NULL,\n    74\t          actor TEXT NOT NULL,\n    75\t          harness TEXT NOT NULL,\n    76\t          turn_id TEXT\n    77\t        );`,\n    78\t        `CREATE TABLE message_block (\n    79\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n    80\t          block_index INTEGER NOT NULL,\n    81\t          block_type TEXT NOT NULL,\n    82\t          content TEXT NOT NULL,\n    83\t          PRIMARY KEY (message_id, block_index)\n    84\t        );`,\n    85\t      ],\n    86\t    },\n    87\t    {\n    88\t      version: 3, // Story 4: turn state machine\n    89\t      statements: [\n    90\t        `CREATE TABLE turns (\n    91\t          turn_id TEXT PRIMARY KEY,\n    92\t          turn_order INTEGER NOT NULL UNIQUE,\n    93\t          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n    94\t          opened_at_event_order INTEGER NOT NULL,\n    95\t          closed_at_event_order INTEGER\n    96\t        );`,\n    97\t      ],\n    98\t    },\n    99\t    {\n   100\t      version: 4, // Story 5: derivation work queueing\n   101\t      statements: [\n   102\t        // Work items live in the thread file and commit with the batch —\n   103\t        // not a separate database, not a separate transaction. status is\n   104\t        // unconstrained TEXT: this epic only ever writes 'queued'; the\n   105\t        // claim/lease statuses are Epic 02's to add.\n   106\t        `CREATE TABLE work_item (\n   107\t          work_item_id TEXT PRIMARY KEY,\n   108\t          owner TEXT NOT NULL,\n   109\t          kind TEXT NOT NULL,\n   110\t          source_ref TEXT NOT NULL,\n   111\t          status TEXT NOT NULL,\n   112\t          queued_at TEXT NOT NULL\n   113\t        );`,\n   114\t      ],\n   115\t    },\n   116\t    {\n   117\t      version: 5, // Epic 02 Story 0: queue mechanical fields, derivation,\n   118\t      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n   119\t      // epic's single migration (tech design §Storage), statements owned by\n   120\t      // shared/storage.ts.\n   121\t      statements: MIGRATION_V5_STATEMENTS,\n   122\t    },\n   123\t    {\n   124\t      version: 6, // Epic 03 Story 0: thread-view snapshot tables and the\n   125\t      // visibility boundary (seeded at position 0) — the epic's single\n   126\t      // migration (tech design §Storage), statements owned by\n   127\t      // shared/storage.ts.\n   128\t      statements: MIGRATION_V6_STATEMENTS,\n   129\t    },\n   130\t    {\n   131\t      version: 7, // Epic 06 Story 0: derivation vocabulary rename and log table.\n   132\t      statements: MIGRATION_V7_STATEMENTS,\n   133\t    },\n   134\t  ];\n   135\t}\n   136\t\n   137\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n   138\t  return {\n   139\t    ok: false,\n   140\t    error: {\n   141\t      errorClass: \"caller_error\",\n   142\t      code: \"thread_not_found\",\n   143\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n   144\t    },\n   145\t  };\n   146\t}\n   147\t\n   148\tfunction errorDetail(cause: unknown): string {\n   149\t  return cause instanceof Error ? cause.message : String(cause);\n   150\t}\n   151\t\n   152\t// Identity check before any migration runs, on a read-only handle so an\n   153\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n   154\t// file always carries schema version >= 1 and the thread_metadata singleton\n   155\t// row that creation wrote transactionally. Anything else — an empty\n   156\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n   157\t// caller error, never adopted.\n   158\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n   159\t  let db: DatabaseSync | undefined;\n   160\t  try {\n   161\t    db = new DatabaseSync(filePath, { readOnly: true });\n   162\t    if (getSchemaVersion(db) < 1) {\n   163\t      return notAThreadFile(filePath, \"no lhc schema version\");\n   164\t    }\n   165\t    const table = db\n   166\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n   167\t      .get();\n   168\t    if (table === undefined) {\n   169\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n   170\t    }\n   171\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n   172\t    if (row === undefined) {\n   173\t      return notAThreadFile(filePath, \"no thread metadata row\");\n   174\t    }\n   175\t    return { ok: true };\n   176\t  } catch (cause) {\n   177\t    const detail = errorDetail(cause);\n   178\t    // SQLite refusing the file as a database is an identity failure, not an\n   179\t    // environment failure; everything else stays a system error.\n   180\t    if (detail.includes(\"not a database\")) {\n   181\t      return notAThreadFile(filePath, detail);\n   182\t    }\n   183\t    return storageFailure(`could not inspect thread file: ${detail}`);\n   184\t  } finally {\n   185\t    db?.close();\n   186\t  }\n   187\t}\n   188\t\n   189\t// Opens a thread file and brings its schema to the current version before\n   190\t// returning the handle. Every SDK operation on an existing thread file goes\n   191\t// through here, so a pre-Story-3 file gains the message tables on its first\n   192\t// open by newer code — but only after the file proves it is a thread file;\n   193\t// migration never creates lhc schema on an arbitrary existing file. Each\n   194\t// migration runs in its own transaction (storage helper), completing before\n   195\t// any caller transaction begins.\n   196\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n   197\t  const valid = validateThreadFile(filePath);\n   198\t  if (!valid.ok) return valid;\n   199\t  let db: DatabaseSync;\n   200\t  try {\n   201\t    db = openDatabase(filePath);\n   202\t  } catch (cause) {\n   203\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n   204\t  }\n   205\t  try {\n   206\t    runMigrations(db, buildThreadMigrations());\n   207\t  } catch (cause) {\n   208\t    db.close();\n   209\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n   210\t  }\n   211\t  // Announce the open (DD-10): the background scheduler's first-touch\n   212\t  // catch-up hangs off this seam. Fired before any caller transaction\n   213\t  // begins; a no-op unless a listener is installed.\n   214\t  fireThreadTouch(filePath, db);\n   215\t  return { ok: true, value: db };\n   216\t}\n   217\t\n   218\t// Schema v1 plus the metadata row land in one migration transaction, so the\n   219\t// file either has its full schema and metadata row or creation fails whole.\n   220\texport function createThreadFile(\n   221\t  filePath: string,\n   222\t  threadId: string,\n   223\t  createdAt: string,\n   224\t): void {\n   225\t  const db = openDatabase(filePath);\n   226\t  try {\n   227\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n   228\t  } finally {\n   229\t    db.close();\n   230\t  }\n   231\t}\n   232\t\n   233\t// Compensation: removes the thread file and its WAL companions. Used when the\n   234\t// registry insert fails after file creation (no registry row without its\n   235\t// file) and when file creation itself fails partway.\n   236\texport function deleteThreadFile(filePath: string): void {\n   237\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n   238\t    rmSync(`${filePath}${suffix}`, { force: true });\n   239\t  }\n   240\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/tech-utils/logging/index.ts'","aggregated_output":"     1\t// The logging surface: a domain-blind tech-util for recording fallback\n     2\t// events and diagnostics. LHC internals and the host extension both write\n     3\t// through this surface (AC-5.2). Writes are fail-soft and never share the\n     4\t// caller's transaction (AC-5.5). Queries return entries by actionable fields\n     5\t// (AC-5.4).\n     6\timport type { DatabaseSync, SQLInputValue } from \"node:sqlite\";\n     7\timport type { DerivationType } from \"../../shared/derivation.js\";\n     8\timport type { OperationContext } from \"../../shared/context.js\";\n     9\t\n    10\texport type LogLevel = \"info\" | \"warning\" | \"error\";\n    11\t\n    12\texport interface LogEntry {\n    13\t  level: LogLevel;\n    14\t  message: string;\n    15\t  derivationType?: DerivationType;\n    16\t  subjectId?: string;\n    17\t  reason?: string; // e.g. \"not_ready\" | \"failed_floor\"\n    18\t  floorUsed?: string; // for fallback events\n    19\t}\n    20\t\n    21\t// Stored log entry as read from the database\n    22\texport interface StoredLogEntry {\n    23\t  logId: number;\n    24\t  level: LogLevel;\n    25\t  message: string;\n    26\t  derivationType: string | null;\n    27\t  subjectId: string | null;\n    28\t  reason: string | null;\n    29\t  floorUsed: string | null;\n    30\t  recordedAt: string;\n    31\t}\n    32\t\n    33\texport interface LogQuery {\n    34\t  level?: LogLevel;\n    35\t  derivationType?: DerivationType;\n    36\t  subjectId?: string;\n    37\t  reason?: string;\n    38\t}\n    39\t\n    40\t// Write a log entry. Fail-soft: never throws to the caller, never shares\n    41\t// the caller's transaction. A logging failure is contained and does not\n    42\t// affect the operation that produced the log entry (AC-5.5).\n    43\texport function writeLog(ctx: OperationContext, entry: LogEntry): void {\n    44\t  try {\n    45\t    // Open a separate database connection for this write to avoid sharing\n    46\t    // the caller's transaction. This ensures that a logging failure cannot\n    47\t    // roll back the caller's work.\n    48\t    const db = ctx.db; // Use the same connection but write outside transaction\n    49\t    db.prepare(\n    50\t      `INSERT INTO log (level, message, derivation_type, subject_id, reason, floor_used)\n    51\t       VALUES (?, ?, ?, ?, ?, ?)`,\n    52\t    ).run(\n    53\t      entry.level,\n    54\t      entry.message,\n    55\t      entry.derivationType ?? null,\n    56\t      entry.subjectId ?? null,\n    57\t      entry.reason ?? null,\n    58\t      entry.floorUsed ?? null,\n    59\t    );\n    60\t  } catch {\n    61\t    // Fail-soft: drop the log entry but do not propagate the error to the caller\n    62\t    // (AC-5.5). The operation that produced this log entry continues unchanged.\n    63\t  }\n    64\t}\n    65\t\n    66\t// Query log entries by actionable fields (AC-5.4). Returns all matching\n    67\t// entries in descending order of recorded_at (newest first).\n    68\texport function queryLog(db: DatabaseSync, q: LogQuery): StoredLogEntry[] {\n    69\t  const conditions: string[] = [];\n    70\t  const params: SQLInputValue[] = [];\n    71\t\n    72\t  if (q.level !== undefined) {\n    73\t    conditions.push(\"level = ?\");\n    74\t    params.push(q.level);\n    75\t  }\n    76\t  if (q.derivationType !== undefined) {\n    77\t    conditions.push(\"derivation_type = ?\");\n    78\t    params.push(q.derivationType);\n    79\t  }\n    80\t  if (q.subjectId !== undefined) {\n    81\t    conditions.push(\"subject_id = ?\");\n    82\t    params.push(q.subjectId);\n    83\t  }\n    84\t  if (q.reason !== undefined) {\n    85\t    conditions.push(\"reason = ?\");\n    86\t    params.push(q.reason);\n    87\t  }\n    88\t\n    89\t  const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(\" AND \")}` : \"\";\n    90\t  const sql = `\n    91\t    SELECT log_id, level, message, derivation_type, subject_id, reason, floor_used, recorded_at\n    92\t    FROM log\n    93\t    ${whereClause}\n    94\t    ORDER BY recorded_at DESC\n    95\t  `;\n    96\t\n    97\t  const rows = db.prepare(sql).all(...params) as unknown as Array<{\n    98\t    log_id: number;\n    99\t    level: string;\n   100\t    message: string;\n   101\t    derivation_type: string | null;\n   102\t    subject_id: string | null;\n   103\t    reason: string | null;\n   104\t    floor_used: string | null;\n   105\t    recorded_at: string;\n   106\t  }>;\n   107\t\n   108\t  return rows.map((row) => ({\n   109\t    logId: row.log_id,\n   110\t    level: row.level as LogLevel,\n   111\t    message: row.message,\n   112\t    derivationType: row.derivation_type,\n   113\t    subjectId: row.subject_id,\n   114\t    reason: row.reason,\n   115\t    floorUsed: row.floor_used,\n   116\t    recordedAt: row.recorded_at,\n   117\t  }));\n   118\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/sdk.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\texport * as threads from \"./domains/threads/index.js\";\n     3\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n     4\texport * as messages from \"./domains/messages/index.js\";\n     5\texport * as turns from \"./domains/turns/index.js\";\n     6\texport * as threadView from \"./domains/thread-view/index.js\";\n     7\texport * as inspect from \"./domains/inspect/index.js\";\n     8\texport * as logging from \"./tech-utils/logging/index.js\";\n     9\t\n    10\timport * as inspectDomain from \"./domains/inspect/index.js\";\n    11\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n    12\timport * as threadViewDomain from \"./domains/thread-view/index.js\";\n    13\timport { resolveViewConfig } from \"./domains/thread-view/index.js\";\n    14\timport * as messagesDomain from \"./domains/messages/index.js\";\n    15\timport * as threadsDomain from \"./domains/threads/index.js\";\n    16\timport * as turnsDomain from \"./domains/turns/index.js\";\n    17\timport * as loggingDomain from \"./tech-utils/logging/index.js\";\n    18\timport {\n    19\t  createScheduler,\n    20\t  peekThreadId,\n    21\t  runDrain,\n    22\t  type DrainDeps,\n    23\t  type DrainReport,\n    24\t  type Scheduler,\n    25\t} from \"./scheduler.js\";\n    26\timport {\n    27\t  runWithInstanceSeam,\n    28\t  setSchedulerPoke as installSchedulerPoke,\n    29\t  setThreadTouch,\n    30\t  type InstanceSeam,\n    31\t} from \"./shared/context.js\";\n    32\timport { createInferenceProvider } from \"./inference/adapter.js\";\n    33\timport { PROMPT_REGISTRY } from \"./inference/prompts/index.js\";\n    34\timport type { InferenceConfig, ModelAssignment } from \"./inference/types.js\";\n    35\timport {\n    36\t  DERIVATION_TYPES,\n    37\t  PROVIDER_OPERATIONS,\n    38\t  type DerivationProvider,\n    39\t  type DerivationType,\n    40\t  type ResolvedSdkConfig,\n    41\t  type SdkConfig,\n    42\t  type WorkHandler,\n    43\t} from \"./shared/derivation.js\";\n    44\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n    45\timport { storageFailure } from \"./shared/errors.js\";\n    46\timport type {\n    47\t  CompactReceipt,\n    48\t  PullResult,\n    49\t  StoredView,\n    50\t  SweepReceipt,\n    51\t  ViewCompactParams,\n    52\t  ViewProfile,\n    53\t  ViewStatus,\n    54\t} from \"./shared/view.js\";\n    55\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n    56\t\n    57\texport {\n    58\t  estimateTokens,\n    59\t  TOKEN_ESTIMATOR_ID,\n    60\t} from \"./tech-utils/token-counting/index.js\";\n    61\t\n    62\texport {\n    63\t  WORK_KIND_REGISTRY,\n    64\t  type WorkItemRecord,\n    65\t  type WorkKind,\n    66\t  type WorkOwner,\n    67\t  type WorkSourceRef,\n    68\t} from \"./tech-utils/work-queue/index.js\";\n    69\t\n    70\texport type {\n    71\t  ErrorClass,\n    72\t  ErrorCode,\n    73\t  ErrorResult,\n    74\t  OpResult,\n    75\t} from \"./shared/errors.js\";\n    76\texport {\n    77\t  runInTransaction,\n    78\t  setSchedulerPoke,\n    79\t  setThreadTouch,\n    80\t  type OperationContext,\n    81\t} from \"./shared/context.js\";\n    82\t\n    83\texport {\n    84\t  createDeterministicProvider,\n    85\t  deterministicOutcomesSuffix,\n    86\t  deterministicReceiptsSuffix,\n    87\t  deterministicText,\n    88\t  type DeterministicOpName,\n    89\t} from \"./providers/deterministic.js\";\n    90\texport type {\n    91\t  CompletionTx,\n    92\t  DependencyGap,\n    93\t  DerivationProvider,\n    94\t  Derivation,\n    95\t  DerivationMetadata,\n    96\t  DerivationState,\n    97\t  DerivationType,\n    98\t  DerivationReportEntry,\n    99\t  HandlerDerivationWrite,\n   100\t  HandlerOutcome,\n   101\t  HandlerRunContext,\n   102\t  ProviderResult,\n   103\t  RenderingPart,\n   104\t  ResolvedSdkConfig,\n   105\t  SdkConfig,\n   106\t  SubjectKind,\n   107\t  ToolOutcome,\n   108\t  ToolRunReceipt,\n   109\t  WorkHandler,\n   110\t} from \"./shared/derivation.js\";\n   111\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n   112\t\n   113\t// Epic 05 inference vocabulary (inference/types.ts): the host-supplied\n   114\t// ModelCall boundary and the per-kind assignment config — type-only; the\n   115\t// adapter and registry are construction internals behind createSdk.\n   116\texport type {\n   117\t  InferenceConfig,\n   118\t  ModelAssignment,\n   119\t  ModelCall,\n   120\t  ModelCallFailureKind,\n   121\t  ModelCallInput,\n   122\t  ModelCallResult,\n   123\t} from \"./inference/types.js\";\n   124\texport { DERIVATION_TYPES, type ProviderProvenance } from \"./shared/derivation.js\";\n   125\t\n   126\t// The config-selectable prompt-name catalog (E05-NB-2): the full set of names\n   127\t// a per-kind assignment may select, and the default name per kind. Exposed so\n   128\t// operators discover valid prompt names from the SDK surface without reading\n   129\t// source. The registry itself stays a construction internal behind createSdk.\n   130\texport {\n   131\t  DEFAULT_PROMPT_NAMES,\n   132\t  PROMPT_NAMES,\n   133\t} from \"./inference/prompts/index.js\";\n   134\t\n   135\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n   136\t// from Story 0; the operation shapes land with Stories 1–5.\n   137\texport {\n   138\t  BUILT_IN_PROFILES,\n   139\t  DEFAULT_COMPACT_THRESHOLD,\n   140\t  DEFAULT_VISIBILITY,\n   141\t} from \"./domains/thread-view/index.js\";\n   142\texport type {\n   143\t  Band,\n   144\t  CompactReceipt,\n   145\t  PullResult,\n   146\t  ResolvedViewConfig,\n   147\t  SdkViewConfig,\n   148\t  StoredView,\n   149\t  SweepReceipt,\n   150\t  ViewCompactParams,\n   151\t  ViewMessage,\n   152\t  ViewMeta,\n   153\t  ViewProfile,\n   154\t  ViewProfileOverride,\n   155\t  ViewStatus,\n   156\t  VisibilityBudgets,\n   157\t} from \"./shared/view.js\";\n   158\texport {\n   159\t  countLiveItems,\n   160\t  enqueue,\n   161\t  queueDetail,\n   162\t  supersedeQueued,\n   163\t  type ClaimedWorkItem,\n   164\t  type EnqueueDerivationTarget,\n   165\t  type EnqueueInput,\n   166\t  type QueueDetailRow,\n   167\t} from \"./tech-utils/work-queue/index.js\";\n   168\t\n   169\texport {\n   170\t  queryLog,\n   171\t  writeLog,\n   172\t  type LogEntry,\n   173\t  type LogQuery,\n   174\t  type LogLevel,\n   175\t  type StoredLogEntry,\n   176\t} from \"./tech-utils/logging/index.js\";\n   177\t\n   178\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n   179\t// inspect surface serves.\n   180\texport type {\n   181\t  HealthReport,\n   182\t  InspectOverview,\n   183\t  ViewContentsReport,\n   184\t} from \"./shared/inspect.js\";\n   185\t\n   186\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n   187\texport type {\n   188\t  Block,\n   189\t  BlockType,\n   190\t  MessageDetail,\n   191\t  MessageListOptions,\n   192\t  MessageRecord,\n   193\t  MutationResult,\n   194\t} from \"./domains/messages/index.js\";\n   195\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   196\texport type {\n   197\t  BatchResult,\n   198\t  EventKind,\n   199\t  EventRecord,\n   200\t  MessageEventInput,\n   201\t} from \"./domains/intake-stream/index.js\";\n   202\t\n   203\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   204\t\n   205\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   206\t\n   207\t// Merge per-domain handler tables into the one join between the queue's\n   208\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   209\t// (each kind has exactly one owner) and throws at construction.\n   210\texport function assembleWorkHandlerMap(\n   211\t  tables: ReadonlyArray<WorkHandlerMap>,\n   212\t): WorkHandlerMap {\n   213\t  const map: WorkHandlerMap = {};\n   214\t  for (const table of tables) {\n   215\t    for (const [kind, handler] of Object.entries(table)) {\n   216\t      if (map[kind as WorkKind] !== undefined) {\n   217\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   218\t      }\n   219\t      map[kind as WorkKind] = handler;\n   220\t    }\n   221\t  }\n   222\t  return map;\n   223\t}\n   224\t\n   225\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   226\t  return {\n   227\t    ok: false,\n   228\t    error: {\n   229\t      errorClass: \"state_corruption\",\n   230\t      code: \"unknown_work_kind\",\n   231\t      reason: `no handler registered for work kind \"${kind}\"`,\n   232\t    },\n   233\t  };\n   234\t}\n   235\t\n   236\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   237\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   238\texport function lookupWorkHandler(\n   239\t  map: WorkHandlerMap,\n   240\t  kind: string,\n   241\t): OpResult<WorkHandler> {\n   242\t  const handler = map[kind as WorkKind];\n   243\t  if (handler === undefined) return unknownWorkKind(kind);\n   244\t  return { ok: true, value: handler };\n   245\t}\n   246\t\n   247\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   248\t// requeue land in Story 4.\n   249\texport interface WorkSurface {\n   250\t  drain(\n   251\t    ref: threadsDomain.ThreadRef,\n   252\t    opts?: { maxItems?: number },\n   253\t  ): Promise<OpResult<DrainReport>>;\n   254\t}\n   255\t\n   256\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n   257\t// §Interface Definitions): the operations only — the Story 0 config\n   258\t// substrate the domain index also carries is construction machinery, not an\n   259\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n   260\t// inspect domain composes (DD-1).\n   261\texport interface ThreadViewSurface {\n   262\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n   263\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n   264\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n   265\t  compact(\n   266\t    ref: threadsDomain.ThreadRef,\n   267\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   268\t  ): Promise<OpResult<CompactReceipt>>;\n   269\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n   270\t  materialize(\n   271\t    ref: threadsDomain.ThreadRef,\n   272\t    opts: { path: string; format?: \"pi-session\" },\n   273\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   274\t}\n   275\t\n   276\texport interface LoggingSurface {\n   277\t  write(\n   278\t    ref: threadsDomain.ThreadRef,\n   279\t    entry: loggingDomain.LogEntry,\n   280\t  ): Promise<OpResult<void>>;\n   281\t  query(\n   282\t    ref: threadsDomain.ThreadRef,\n   283\t    q: loggingDomain.LogQuery,\n   284\t  ): Promise<OpResult<loggingDomain.StoredLogEntry[]>>;\n   285\t}\n   286\t\n   287\texport interface Lhc {\n   288\t  threads: typeof threadsDomain;\n   289\t  intakeStream: typeof intakeStreamDomain;\n   290\t  messages: typeof messagesDomain;\n   291\t  turns: typeof turnsDomain;\n   292\t  threadView: ThreadViewSurface;\n   293\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n   294\t  // like every other namespace so the status read it composes resolves THIS\n   295\t  // SDK's view config (threshold, visibility budgets).\n   296\t  inspect: typeof inspectDomain;\n   297\t  logging: LoggingSurface;\n   298\t  config: ResolvedSdkConfig;\n   299\t  scheduler: Scheduler;\n   300\t  workHandlers: WorkHandlerMap;\n   301\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   302\t  work: WorkSurface;\n   303\t  // Resolves when the scheduler has no running or pending drain for the\n   304\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   305\t  // resolve in manual mode.\n   306\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   307\t}\n   308\t\n   309\tfunction requirePositive(value: number, name: string): void {\n   310\t  if (!Number.isFinite(value) || value <= 0) {\n   311\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   312\t  }\n   313\t}\n   314\t\n   315\tfunction requireNonNegative(value: number, name: string): void {\n   316\t  if (!Number.isFinite(value) || value < 0) {\n   317\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   318\t  }\n   319\t}\n   320\t\n   321\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   322\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   323\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   324\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   325\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   326\t// object is the same shape as the namespace, so the public surface type holds.\n   327\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   328\t  const scoped: Record<string, unknown> = {};\n   329\t  for (const key of Object.keys(surface)) {\n   330\t    const value = (surface as Record<string, unknown>)[key];\n   331\t    scoped[key] =\n   332\t      typeof value === \"function\"\n   333\t        ? (...args: unknown[]): unknown =>\n   334\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   335\t        : value;\n   336\t  }\n   337\t  return scoped as T;\n   338\t}\n   339\t\n   340\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n   341\t// the host function and the complete assignment map loudly — all seven kinds\n   342\t// present (iterating the exported DERIVATION_TYPES set, never a second literal\n   343\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n   344\t// provider/model routing keys — then build the adapter into the same\n   345\t// DerivationProvider slot direct injection uses. No partial construction:\n   346\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n   347\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n   348\t  if (typeof inference.call !== \"function\") {\n   349\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n   350\t  }\n   351\t  const assignments = inference.assignments as unknown;\n   352\t  if (assignments === null || typeof assignments !== \"object\") {\n   353\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n   354\t  }\n   355\t  const knownKinds = new Set<string>(DERIVATION_TYPES);\n   356\t  for (const key of Object.keys(assignments)) {\n   357\t    if (!knownKinds.has(key)) {\n   358\t      throw new TypeError(\n   359\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n   360\t      );\n   361\t    }\n   362\t  }\n   363\t  const map = assignments as Partial<Record<DerivationType, ModelAssignment>>;\n   364\t  for (const kind of DERIVATION_TYPES) {\n   365\t    const assignment = map[kind];\n   366\t    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n   367\t      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n   368\t    }\n   369\t    for (const field of [\"provider\", \"model\"] as const) {\n   370\t      const value = assignment[field];\n   371\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n   372\t        throw new TypeError(\n   373\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n   374\t        );\n   375\t      }\n   376\t    }\n   377\t    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n   378\t      throw new TypeError(\n   379\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n   380\t      );\n   381\t    }\n   382\t  }\n   383\t  const timeoutMs = inference.timeoutMs ?? 60_000;\n   384\t  const maxInputChars = inference.maxInputChars ?? 200_000;\n   385\t  requirePositive(timeoutMs, \"inference.timeoutMs\");\n   386\t  requirePositive(maxInputChars, \"inference.maxInputChars\");\n   387\t  return createInferenceProvider({\n   388\t    call: inference.call,\n   389\t    assignments: map as Record<DerivationType, ModelAssignment>,\n   390\t    timeoutMs,\n   391\t    maxInputChars,\n   392\t  });\n   393\t}\n   394\t\n   395\t// The only assembly path: provider, mode, clock, and policy enter here.\n   396\t// Config mistakes are programmer errors at construction and throw; operating\n   397\t// failures after construction return OpResults per the error contract.\n   398\texport function createSdk(config: SdkConfig): Lhc {\n   399\t  // Provider arrival is exactly one of direct injection or the inference\n   400\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n   401\t  // env/flag resolution path to fall back on. The XOR rule is validated\n   402\t  // before anything downstream so the error names the caller's mistake, not\n   403\t  // a symptom (AC-1.1).\n   404\t  if (config.provider !== undefined && config.inference !== undefined) {\n   405\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   406\t  }\n   407\t  if (config.provider === undefined && config.inference === undefined) {\n   408\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   409\t  }\n   410\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   411\t    throw new TypeError(\n   412\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   413\t    );\n   414\t  }\n   415\t  let provider: DerivationProvider;\n   416\t  if (config.inference !== undefined) {\n   417\t    provider = resolveInferenceProvider(config.inference);\n   418\t  } else {\n   419\t    if (config.provider === null || typeof config.provider !== \"object\") {\n   420\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   421\t    }\n   422\t    for (const operation of PROVIDER_OPERATIONS) {\n   423\t      if (typeof config.provider[operation] !== \"function\") {\n   424\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   425\t      }\n   426\t    }\n   427\t    provider = config.provider;\n   428\t  }\n   429\t\n   430\t  const resolved: ResolvedSdkConfig = {\n   431\t    provider,\n   432\t    mode: config.mode,\n   433\t    clock: config.clock ?? (() => new Date()),\n   434\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   435\t    lease: config.lease ?? { durationMs: 120000 },\n   436\t    chunkPolicy:\n   437\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   438\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   439\t    // sums and visibility budgets validated — throws naming the violation.\n   440\t    view: resolveViewConfig(config.view),\n   441\t  };\n   442\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   443\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   444\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   445\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   446\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   447\t  }\n   448\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   449\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   450\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   451\t    throw new TypeError(\n   452\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   453\t    );\n   454\t  }\n   455\t\n   456\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   457\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   458\t  // assembly mechanics are production code from day one.\n   459\t  const workHandlers = assembleWorkHandlerMap([\n   460\t    messagesDomain.workHandlers,\n   461\t    turnsDomain.workHandlers,\n   462\t  ]);\n   463\t\n   464\t  const drainDeps: DrainDeps = {\n   465\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   466\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   467\t    config: resolved,\n   468\t  };\n   469\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   470\t\n   471\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   472\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   473\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   474\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   475\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   476\t  // the construction order, because its operations deliver to the no-op seam,\n   477\t  // not to whatever a background SDK installed below.\n   478\t  // The seam also carries this instance's resolved view config (Epic 03,\n   479\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n   480\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n   481\t  // fall back to the built-in defaults inside the thread-view surface.\n   482\t  const seam: InstanceSeam =\n   483\t    resolved.mode === \"background\"\n   484\t      ? {\n   485\t          poke: (threadId) => scheduler.poke(threadId),\n   486\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   487\t          view: resolved.view,\n   488\t        }\n   489\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n   490\t\n   491\t  // Background mode also installs the below-SDK default seam so a direct\n   492\t  // domain call made with no SDK scope — a top-level mutation in the\n   493\t  // single-background \"production path\" — still reaches the one installed\n   494\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   495\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   496\t  // leaves the default alone (pokes stay no-ops by contract).\n   497\t  if (resolved.mode === \"background\") {\n   498\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   499\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   500\t  }\n   501\t\n   502\t  const work: WorkSurface = {\n   503\t    drain: (ref, opts) =>\n   504\t      runWithInstanceSeam(seam, async () => {\n   505\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   506\t        if (!resolvedRef.ok) return resolvedRef;\n   507\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   508\t      }),\n   509\t  };\n   510\t\n   511\t  const logging: LoggingSurface = {\n   512\t    write: (ref, entry) =>\n   513\t      runWithInstanceSeam(seam, async () => {\n   514\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   515\t        if (!resolvedRef.ok) return resolvedRef;\n   516\t        const { filePath } = resolvedRef.value;\n   517\t        if (!existsSync(filePath)) {\n   518\t          return {\n   519\t            ok: false as const,\n   520\t            error: {\n   521\t              errorClass: \"caller_error\" as const,\n   522\t              code: \"thread_not_found\" as const,\n   523\t              reason: `no thread file exists at ${filePath}`,\n   524\t            },\n   525\t          };\n   526\t        }\n   527\t        const opened = threadsDomain.openThreadDatabase(filePath);\n   528\t        if (!opened.ok) return opened;\n   529\t        const db = opened.value;\n   530\t        try {\n   531\t          loggingDomain.writeLog(\n   532\t            {\n   533\t              db,\n   534\t              clock: resolved.clock,\n   535\t              threadId: peekThreadId(filePath) ?? \"\",\n   536\t              onCommit: () => {},\n   537\t              poke: () => {},\n   538\t            },\n   539\t            entry,\n   540\t          );\n   541\t          return { ok: true as const, value: undefined };\n   542\t        } catch (cause) {\n   543\t          const reason = cause instanceof Error ? cause.message : String(cause);\n   544\t          return storageFailure(`log write failed: ${reason}`);\n   545\t        } finally {\n   546\t          db.close();\n   547\t        }\n   548\t      }),\n   549\t    query: (ref, q) =>\n   550\t      runWithInstanceSeam(seam, async () => {\n   551\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   552\t        if (!resolvedRef.ok) return resolvedRef;\n   553\t        const { filePath } = resolvedRef.value;\n   554\t        if (!existsSync(filePath)) {\n   555\t          return {\n   556\t            ok: false as const,\n   557\t            error: {\n   558\t              errorClass: \"caller_error\" as const,\n   559\t              code: \"thread_not_found\" as const,\n   560\t              reason: `no thread file exists at ${filePath}`,\n   561\t            },\n   562\t          };\n   563\t        }\n   564\t        const opened = threadsDomain.openThreadDatabase(filePath);\n   565\t        if (!opened.ok) return opened;\n   566\t        const db = opened.value;\n   567\t        try {\n   568\t          return { ok: true as const, value: loggingDomain.queryLog(db, q) };\n   569\t        } catch (cause) {\n   570\t          const reason = cause instanceof Error ? cause.message : String(cause);\n   571\t          return storageFailure(`log query failed: ${reason}`);\n   572\t        } finally {\n   573\t          db.close();\n   574\t        }\n   575\t      }),\n   576\t  };\n   577\t\n   578\t  return {\n   579\t    threads: threadsDomain,\n   580\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n   581\t    messages: scopeSurface(messagesDomain, seam),\n   582\t    turns: scopeSurface(turnsDomain, seam),\n   583\t    threadView: scopeSurface<ThreadViewSurface>(\n   584\t      {\n   585\t        pull: threadViewDomain.pull,\n   586\t        status: threadViewDomain.status,\n   587\t        describe: threadViewDomain.describe,\n   588\t        compact: threadViewDomain.compact,\n   589\t        sweep: threadViewDomain.sweep,\n   590\t        materialize: threadViewDomain.materialize,\n   591\t      },\n   592\t      seam,\n   593\t    ),\n   594\t    inspect: scopeSurface(inspectDomain, seam),\n   595\t    logging,\n   596\t    config: resolved,\n   597\t    scheduler,\n   598\t    workHandlers,\n   599\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   600\t    work,\n   601\t    drainSettled: async (ref) => {\n   602\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   603\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   604\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   605\t      if (threadId === null) return;\n   606\t      return scheduler.drainSettled(threadId);\n   607\t    },\n   608\t  };\n   609\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/view.ts'","aggregated_output":"     1\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n     2\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n     3\t// domain owns the behavior, this module owns only the shapes.\n     4\t\n     5\texport type Band = \"brief\" | \"detailed\" | \"smooth\";\n     6\t\n     7\texport interface ViewProfile {\n     8\t  name: string;\n     9\t  // Target assembled size; whole-entry fills may land under or over (epic\n    10\t  // Data Contracts — the bound is a target, not a cap).\n    11\t  lowerBound: number;\n    12\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n    13\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n    14\t}\n    15\t\n    16\t// A user profile entry as configured: a full profile under a new name, or a\n    17\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n    18\t// whose name matches no built-in has nothing to merge over and is rejected at\n    19\t// construction (FC-0.2's unknown-override violation).\n    20\texport interface ViewProfileOverride {\n    21\t  name: string;\n    22\t  lowerBound?: number;\n    23\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n    24\t}\n    25\t\n    26\t// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\n    27\t// base profile, down to single band percentages — the same depth the CLI's\n    28\t// per-band flags override at. A nested-partial deepening of the tech\n    29\t// design's `Partial<ViewProfile>` sketch, which could not express a\n    30\t// single-band override.\n    31\texport interface ViewCompactParams {\n    32\t  lowerBound?: number;\n    33\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n    34\t}\n    35\t\n    36\t// Visibility-boundary budgets (Epic 03 AC-4.x as patched by Epic 05 AC-5.4):\n    37\t// max > target, both positive. The floor budget is retired — its job is done\n    38\t// structurally by the turn-end trigger (the open turn is untouchable) and the\n    39\t// never-evicted newest closed turn (Epic 05 DD-11).\n    40\texport interface VisibilityBudgets {\n    41\t  maxTokens: number;\n    42\t  targetTokens: number;\n    43\t}\n    44\t\n    45\t// ── SDK assembly config (validated at construction, throws on nonsense\n    46\t// per the Epic 02 rule) ───────────────────────────────────────────\n    47\texport interface SdkViewConfig {\n    48\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n    49\t  visibility?: Partial<VisibilityBudgets>; // defaults: 64000 / 32000\n    50\t  compactThreshold?: number; // status trigger; default 160000\n    51\t}\n    52\t\n    53\t// Every optional filled by createSdk's central defaults; profiles resolved\n    54\t// to complete, validated entries keyed by name.\n    55\texport interface ResolvedViewConfig {\n    56\t  profiles: Readonly<Record<string, ViewProfile>>;\n    57\t  visibility: VisibilityBudgets;\n    58\t  compactThreshold: number;\n    59\t}\n    60\t\n    61\t// ── pull / status shapes (the product crossing to the harness) ────\n    62\t//\n    63\t// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\n    64\t// messages first — one `user` message per non-empty band, gradient order\n    65\t// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\n    66\t// the tail in record order. Tail messages render by the message-kind mapping\n    67\t// table (tech design §Tail message rendering), the contract every later\n    68\t// story renders into:\n    69\t//\n    70\t//   | Message kind                       | Role      | Content shape |\n    71\t//   |------------------------------------|-----------|---------------|\n    72\t//   | user_prompt                        | user      | text verbatim |\n    73\t//   | assistant_text                     | assistant | text verbatim |\n    74\t//   | assistant_thinking                 | assistant | fenced: `[thinking]\\n<text>\\n[/thinking]` — included (the tail is full fidelity) |\n    75\t//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\n    76\t//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\n<full content>` |\n    77\t//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\n<summary or deterministic truncation>` (short-form ladder) |\n    78\t//   | runtime_note                       | user      | `[runtime note] <text>` |\n    79\texport interface ViewMessage {\n    80\t  role: \"user\" | \"assistant\";\n    81\t  content: string;\n    82\t  band?: Band; // band absent ⇒ tail\n    83\t}\n    84\t\n    85\texport interface ViewMeta {\n    86\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n    87\t  coveredFrom: number | null;\n    88\t  boundaryPosition: number;\n    89\t  gapCount: number;\n    90\t  degradedCount: number;\n    91\t  viewId: string | null;\n    92\t  createdAt: string | null;\n    93\t}\n    94\t\n    95\texport interface PullResult {\n    96\t  messages: ViewMessage[];\n    97\t  meta: ViewMeta;\n    98\t}\n    99\t\n   100\t// The stored active view row as `threadView.describe` exposes it (Epic 04\n   101\t// Story 3): the snapshot verbatim — arrangement, gaps, config, source-state\n   102\t// provenance, per-band stored token counts — never recomputed, never\n   103\t// repaired. Absent view ⇒ describe returns ok/null, mirroring status's\n   104\t// never-compacted behavior (DD-1).\n   105\texport interface StoredView {\n   106\t  viewId: string;\n   107\t  createdAt: string;\n   108\t  compactPoint: number;\n   109\t  coveredFrom: number;\n   110\t  // null when explicit params overrode a named base at compact (the stored\n   111\t  // config carries the resolved truth either way).\n   112\t  profileName: string | null;\n   113\t  config: { lowerBound: number; percentages: Record<string, number> };\n   114\t  // Every selected entry in served order, gap entries included (they are\n   115\t  // arrangement rows too; `gaps` carries their reasons).\n   116\t  arrangement: Array<{\n   117\t    band: Band;\n   118\t    subjectKind: \"chunk\" | \"turn\";\n   119\t    subjectId: string;\n   120\t    formUsed: string;\n   121\t    degraded: boolean;\n   122\t  }>;\n   123\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n   124\t  // What the compact saw (AC-2.5 provenance, stored verbatim).\n   125\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> };\n   126\t  // Non-empty bands in gradient order with their stored token counts.\n   127\t  bands: Array<{ band: Band; storedTokens: number }>;\n   128\t}\n   129\t\n   130\texport interface ViewStatus {\n   131\t  tailTokens: number;\n   132\t  threshold: number;\n   133\t  compactRecommended: boolean;\n   134\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n   135\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n   136\t  visibility: { zoneTokens: number; maxTokens: number };\n   137\t}\n   138\t\n   139\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n   140\texport interface CompactReceipt {\n   141\t  viewId: string;\n   142\t  profile: string | null;\n   143\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n   144\t  bands: Record<Band, { entries: number; tokens: number }>;\n   145\t  tailTokens: number;\n   146\t  // The assembled view's actual total (band tokens + tail tokens) against\n   147\t  // the configured lower bound — a target, not a cap: whole-entry fills may\n   148\t  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n   149\t  totalTokens: number;\n   150\t  coveredFrom: number;\n   151\t  compactPoint: number;\n   152\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n   153\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n   154\t  // The embedded sweep's receipt (AC-3.6): the sweep runs first by default\n   155\t  // and its full receipt embeds here; `sweep: false` records the skip — the\n   156\t  // receipt always says whether the sweep ran (Story 3 closed Story 2's\n   157\t  // \"absent\" placeholder).\n   158\t  sweep: SweepReceipt | { skipped: true };\n   159\t}\n   160\t\n   161\texport interface SweepReceipt {\n   162\t  owners: Array<{\n   163\t    owner: \"messages\" | \"turns\";\n   164\t    kind: string;\n   165\t    ready: number;\n   166\t    inFlight: number;\n   167\t    requeued: string[]; // subject ids\n   168\t    blocked: Array<{ subjectId: string; reason: string }>;\n   169\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\n   170\t  }>;\n   171\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/thread-view/internal/render.ts'","aggregated_output":"     1\t// Tail and band formatting (Story 1): the seven-kind tail mapping table\n     2\t// (tech design §Tail message rendering — contract, not implementation\n     3\t// choice), short/full tool-result selection by boundary position, and the\n     4\t// short-form ladder (ready summary → deterministic truncation). Pure\n     5\t// functions over read state by design: no DB handle, no provider, no clock —\n     6\t// determinism is structural (AC-1.7 byte-identical pulls fall out of it).\n     7\t//\n     8\t// Story 2 adds the band-entry side: the degrade ladders (tech design\n     9\t// §Degrade ladders), gap entries as the last rung (never absence, AC-2.5),\n    10\t// visible subject keys (§t12 / §c4, AC-2.10), the [degraded: …] and\n    11\t// [inter-turn note] markers, and band-text assembly. select.ts consumes the\n    12\t// same entry renderer to price entries during the fill walk, so the tokens\n    13\t// the walk budgets are the tokens the band stores — one renderer, no drift.\n    14\timport type { Band, ViewMessage } from \"../../../shared/view.js\";\n    15\timport type { TailMessageRow } from \"./snapshot.js\";\n    16\t\n    17\t// Epic 01's deterministic abbreviation rule: a fixed prefix plus an exact\n    18\t// tail marker, a pure function of the input string alone. Restated here —\n    19\t// byte-identical to turns/internal/compose.ts's truncateForFallback —\n    20\t// because cross-domain internals may not be imported and the turns domain\n    21\t// is frozen for this epic (tech design §Top-Tier Surfaces: no changes).\n    22\texport const ABBREVIATION_LIMIT = 200;\n    23\t\n    24\texport function deterministicTruncation(text: string): string {\n    25\t  if (text.length <= ABBREVIATION_LIMIT) return text;\n    26\t  const dropped = text.length - ABBREVIATION_LIMIT;\n    27\t  return `${text.slice(0, ABBREVIATION_LIMIT)}… [truncated ${dropped} chars]`;\n    28\t}\n    29\t\n    30\tfunction blockContent(message: TailMessageRow): Record<string, unknown> {\n    31\t  return message.blocks[0]?.content ?? {};\n    32\t}\n    33\t\n    34\tfunction textOf(message: TailMessageRow): string {\n    35\t  const text = blockContent(message)[\"text\"];\n    36\t  return typeof text === \"string\" ? text : \"\";\n    37\t}\n    38\t\n    39\t// What the tail renderer needs beyond the message itself: the boundary\n    40\t// position (short/full selection), the call-id → tool-name pairing (results\n    41\t// carry only their call id), and the ready tool-result summaries (the\n    42\t// short-form ladder's first rung).\n    43\texport interface TailRenderContext {\n    44\t  boundaryPosition: number;\n    45\t  toolNameByCallId: ReadonlyMap<string, string>;\n    46\t  toolResultSummaries: ReadonlyMap<string, string>;\n    47\t}\n    48\t\n    49\t// The call-id → tool-name map from the messages in hand. Pairing within the\n    50\t// tail is structurally sufficient: the compact point snaps to a turn start,\n    51\t// so a tail result's call is never behind it.\n    52\texport function toolNamesByCallId(\n    53\t  messages: readonly TailMessageRow[],\n    54\t): Map<string, string> {\n    55\t  const names = new Map<string, string>();\n    56\t  for (const message of messages) {\n    57\t    if (message.kind !== \"tool_call\") continue;\n    58\t    const block = blockContent(message);\n    59\t    const callId = block[\"toolCallId\"];\n    60\t    const toolName = block[\"toolName\"];\n    61\t    if (typeof callId === \"string\" && typeof toolName === \"string\") {\n    62\t      names.set(callId, toolName);\n    63\t    }\n    64\t  }\n    65\t  return names;\n    66\t}\n    67\t\n    68\tfunction renderToolCall(message: TailMessageRow): ViewMessage {\n    69\t  const block = blockContent(message);\n    70\t  const name = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n    71\t  // Deterministic arg rendering: the projected arguments serialized verbatim,\n    72\t  // oversized args abbreviated by the same Epic 01 rule.\n    73\t  const args = deterministicTruncation(JSON.stringify(block[\"arguments\"] ?? {}));\n    74\t  return { role: \"assistant\", content: `[tool call · ${name}] ${args}` };\n    75\t}\n    76\t\n    77\tfunction renderToolResult(message: TailMessageRow, ctx: TailRenderContext): ViewMessage {\n    78\t  const block = blockContent(message);\n    79\t  const callId = block[\"toolCallId\"];\n    80\t  const name =\n    81\t    (typeof callId === \"string\" ? ctx.toolNameByCallId.get(callId) : undefined) ??\n    82\t    \"unknown_tool\";\n    83\t  const content = typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\";\n    84\t  if (message.sourceEventOrder > ctx.boundaryPosition) {\n    85\t    return { role: \"user\", content: `[tool result · ${name}]\\n${content}` };\n    86\t  }\n    87\t  // At-or-behind the boundary: the short-form ladder — the ready summary\n    88\t  // when usable, else deterministic truncation of the raw content (AC-4.2's\n    89\t  // vocabulary; the default-boundary leg lands here in Story 1). Short-form\n    90\t  // rendering marks that fuller content exists in the record.\n    91\t  const short = ctx.toolResultSummaries.get(message.messageId) ?? deterministicTruncation(content);\n    92\t  return {\n    93\t    role: \"user\",\n    94\t    content: `[tool result · ${name} · abridged]\\n${short} [full content in record §${message.messageId}]`,\n    95\t  };\n    96\t}\n    97\t\n    98\t// One tail message → one ViewMessage per the mapping table. Each kind is its\n    99\t// own arm so a single kind's drift fails its own named test leg.\n   100\texport function renderTailMessage(\n   101\t  message: TailMessageRow,\n   102\t  ctx: TailRenderContext,\n   103\t): ViewMessage {\n   104\t  switch (message.kind) {\n   105\t    case \"user_prompt\":\n   106\t      return { role: \"user\", content: textOf(message) };\n   107\t    case \"assistant_text\":\n   108\t      return { role: \"assistant\", content: textOf(message) };\n   109\t    case \"assistant_thinking\":\n   110\t      // Included: the tail is full fidelity (bands compress thinking away for\n   111\t      // older turns); harness-side conversion may re-block or drop.\n   112\t      return { role: \"assistant\", content: `[thinking]\\n${textOf(message)}\\n[/thinking]` };\n   113\t    case \"tool_call\":\n   114\t      return renderToolCall(message);\n   115\t    case \"tool_result\":\n   116\t      return renderToolResult(message, ctx);\n   117\t    case \"runtime_note\":\n   118\t      return { role: \"user\", content: `[runtime note] ${textOf(message)}` };\n   119\t  }\n   120\t}\n   121\t\n   122\t// One non-empty band → one labeled `user` message: band-marker header, then\n   123\t// the snapshot bytes verbatim (AC-5.1 resolution: provider APIs reject\n   124\t// unknown roles; `user` is what the MVP's injection used).\n   125\texport function renderBandMessage(band: Band, renderedText: string): ViewMessage {\n   126\t  return { role: \"user\", band, content: `[context · ${band}]\\n${renderedText}` };\n   127\t}\n   128\t\n   129\t// ── band entries: degrade ladders, gaps, keys (Story 2) ──────────\n   130\t\n   131\t// One derived form's stored state as the ladder reads it (a projection of\n   132\t// Derivation: the resolvers never write, never re-derive).\n   133\texport interface FormSnapshot {\n   134\t  state: \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n   135\t  content?: string;\n   136\t  reason?: string;\n   137\t}\n   138\t\n   139\texport type FormLookup = (subjectId: string, form: string) => FormSnapshot | undefined;\n   140\t\n   141\t// A subject's resolved representation: which rung of its ladder renders.\n   142\t// `formUsed` is the arrangement/receipt vocabulary; `degradedMarker` is the\n   143\t// rendered [degraded: …] text for fallback rungs.\n   144\texport interface ResolvedRepresentation {\n   145\t  formUsed: string;\n   146\t  body: string;\n   147\t  degraded: boolean;\n   148\t  gap: boolean;\n   149\t  degradedMarker?: string;\n   150\t  reason?: string;\n   151\t}\n   152\t\n   153\tfunction usable(form: FormSnapshot | undefined): form is FormSnapshot & { content: string } {\n   154\t  // \"Usable\" means state = ready (tech design §Degrade ladders).\n   155\t  return form?.state === \"ready\" && typeof form.content === \"string\";\n   156\t}\n   157\t\n   158\tfunction ladderState(form: FormSnapshot | undefined): string {\n   159\t  return form === undefined ? \"absent\" : form.state;\n   160\t}\n   161\t\n   162\t// Smooth (turn) ladder: turn_rendering → lower_band_projection →\n   163\t// deterministic excerpt of the turn's live messages → gap entry.\n   164\texport function resolveSmoothRepresentation(\n   165\t  turnId: string,\n   166\t  lookup: FormLookup,\n   167\t  excerpt: string | null,\n   168\t): ResolvedRepresentation {\n   169\t  const rendering = lookup(turnId, \"turn_rendering\");\n   170\t  if (usable(rendering)) {\n   171\t    return { formUsed: \"turn_rendering\", body: rendering.content, degraded: false, gap: false };\n   172\t  }\n   173\t  const projection = lookup(turnId, \"lower_band_projection\");\n   174\t  if (usable(projection)) {\n   175\t    return {\n   176\t      formUsed: \"lower_band_projection\",\n   177\t      body: projection.content,\n   178\t      degraded: true,\n   179\t      gap: false,\n   180\t      degradedMarker: \"smooth-from-projection\",\n   181\t    };\n   182\t  }\n   183\t  if (excerpt !== null) {\n   184\t    return {\n   185\t      formUsed: \"message_excerpt\",\n   186\t      body: deterministicTruncation(excerpt),\n   187\t      degraded: true,\n   188\t      gap: false,\n   189\t      degradedMarker: \"smooth-from-excerpt\",\n   190\t    };\n   191\t  }\n   192\t  return {\n   193\t    formUsed: \"gap\",\n   194\t    body: \"\",\n   195\t    degraded: false,\n   196\t    gap: true,\n   197\t    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\n   198\t  };\n   199\t}\n   200\t\n   201\t// Detailed (chunk) ladder: chunk_summary_detailed → chunk_summary_brief →\n   202\t// concatenated member projections (truncated, marked) → gap entry.\n   203\texport function resolveDetailedRepresentation(\n   204\t  chunkId: string,\n   205\t  lookup: FormLookup,\n   206\t  memberProjections: readonly string[],\n   207\t): ResolvedRepresentation {\n   208\t  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n   209\t  if (usable(detailed)) {\n   210\t    return { formUsed: \"chunk_summary_detailed\", body: detailed.content, degraded: false, gap: false };\n   211\t  }\n   212\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n   213\t  if (usable(brief)) {\n   214\t    return {\n   215\t      formUsed: \"chunk_summary_brief\",\n   216\t      body: brief.content,\n   217\t      degraded: true,\n   218\t      gap: false,\n   219\t      degradedMarker: \"detailed-from-brief\",\n   220\t    };\n   221\t  }\n   222\t  if (memberProjections.length > 0) {\n   223\t    return {\n   224\t      formUsed: \"member_projections\",\n   225\t      body: deterministicTruncation(memberProjections.join(\"\\n\")),\n   226\t      degraded: true,\n   227\t      gap: false,\n   228\t      degradedMarker: \"detailed-from-projections\",\n   229\t    };\n   230\t  }\n   231\t  return {\n   232\t    formUsed: \"gap\",\n   233\t    body: \"\",\n   234\t    degraded: false,\n   235\t    gap: true,\n   236\t    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, chunk_summary_brief: ${ladderState(brief)}, member projections ready: 0)`,\n   237\t  };\n   238\t}\n   239\t\n   240\t// Brief (chunk) ladder: chunk_summary_brief → chunk_summary_detailed\n   241\t// truncated → gap entry (no projections rung in this band's ladder).\n   242\texport function resolveBriefRepresentation(\n   243\t  chunkId: string,\n   244\t  lookup: FormLookup,\n   245\t): ResolvedRepresentation {\n   246\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n   247\t  if (usable(brief)) {\n   248\t    return { formUsed: \"chunk_summary_brief\", body: brief.content, degraded: false, gap: false };\n   249\t  }\n   250\t  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n   251\t  if (usable(detailed)) {\n   252\t    return {\n   253\t      formUsed: \"chunk_summary_detailed_truncated\",\n   254\t      body: deterministicTruncation(detailed.content),\n   255\t      degraded: true,\n   256\t      gap: false,\n   257\t      degradedMarker: \"brief-from-detailed\",\n   258\t    };\n   259\t  }\n   260\t  return {\n   261\t    formUsed: \"gap\",\n   262\t    body: \"\",\n   263\t    degraded: false,\n   264\t    gap: true,\n   265\t    reason: `no usable form (chunk_summary_brief: ${ladderState(brief)}, chunk_summary_detailed: ${ladderState(detailed)}, member projections ready: 0)`,\n   266\t  };\n   267\t}\n   268\t\n   269\t// The per-message line an excerpt or note renders — a compact, deterministic\n   270\t// projection of the raw record (last-rung fallback, not the tail mapping).\n   271\texport function excerptLine(\n   272\t  kind: string,\n   273\t  blocks: ReadonlyArray<{ blockType: string; content: Record<string, unknown> }>,\n   274\t): string {\n   275\t  const content = blocks[0]?.content ?? {};\n   276\t  const text = typeof content[\"text\"] === \"string\" ? content[\"text\"] : \"\";\n   277\t  switch (kind) {\n   278\t    case \"tool_call\": {\n   279\t      const name = typeof content[\"toolName\"] === \"string\" ? content[\"toolName\"] : \"unknown_tool\";\n   280\t      return `[tool call · ${name}]`;\n   281\t    }\n   282\t    case \"tool_result\":\n   283\t      return \"[tool result]\";\n   284\t    default:\n   285\t      return text;\n   286\t  }\n   287\t}\n   288\t\n   289\t// One selected subject → its band-entry text: any attached inter-turn notes\n   290\t// (rule 6: rendered raw with the marker, immediately before the entry), then\n   291\t// the keyed entry — §key, [degraded: …] when a fallback rung rendered, or the\n   292\t// gap line as the last rung. select.ts prices exactly this text in the fill\n   293\t// walk; the band stores exactly this text.\n   294\texport function renderArrangementEntry(\n   295\t  subjectKind: \"turn\" | \"chunk\",\n   296\t  subjectId: string,\n   297\t  rep: ResolvedRepresentation,\n   298\t  noteTexts: readonly string[],\n   299\t): string {\n   300\t  const lines = noteTexts.map((text) => `[inter-turn note] ${text}`);\n   301\t  if (rep.gap) {\n   302\t    lines.push(`§${subjectId} [${subjectKind} ${subjectId} unavailable: ${rep.reason ?? \"unknown\"}]`);\n   303\t  } else {\n   304\t    const marker = rep.degraded ? ` [degraded: ${rep.degradedMarker ?? rep.formUsed}]` : \"\";\n   305\t    lines.push(`§${subjectId}${marker}\\n${rep.body}`);\n   306\t  }\n   307\t  return lines.join(\"\\n\");\n   308\t}\n   309\t\n   310\t// A band's snapshot bytes: its entries oldest-first, blank-line separated.\n   311\texport function assembleBandText(entryTexts: readonly string[]): string {\n   312\t  return entryTexts.join(\"\\n\\n\");\n   313\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/thread-view/internal/select.ts'","aggregated_output":"     1\t// Band selection (Story 2): the six-rule walk from tech design §Deterministic\n     2\t// Algorithms — compact point, smooth/detailed/brief fills, rule-5 unchunked\n     3\t// turns, rule-6 turnless stragglers — plus the coverage edge (covered_from)\n     4\t// and canonical-corruption detection. Two halves, deliberately split:\n     5\t//\n     6\t//   - readSelectionInputs: the record/forms reads, with the corruption check\n     7\t//     IN the reads, before any transaction opens (story Technical Notes) —\n     8\t//     a refusal here means nothing was written, so the prior view is\n     9\t//     trivially intact (AC-2.5). Never moved inside the transaction.\n    10\t//   - selectArrangement: a pure function over those inputs. No DB handle, no\n    11\t//     clock, no provider — same inputs ⇒ same arrangement, byte-for-byte\n    12\t//     (AC-2.9; goldens G1–G4 pin the tie-breakers).\n    13\t//\n    14\t// Tie-breakers, pinned (tech design): inclusion thresholds are ≤; walks are\n    15\t// newest-first everywhere; chunk coverage is decided by the chunk's newest\n    16\t// member turn. Entry costs are the tokens of the rendered entry text itself\n    17\t// (render.ts's renderArrangementEntry, including attached inter-turn notes),\n    18\t// so the budgeted tokens are the stored tokens — no second estimate.\n    19\timport type { DatabaseSync } from \"node:sqlite\";\n    20\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    21\timport type { Band } from \"../../../shared/view.js\";\n    22\timport {\n    23\t  excerptLine,\n    24\t  renderArrangementEntry,\n    25\t  resolveBriefRepresentation,\n    26\t  resolveDetailedRepresentation,\n    27\t  resolveSmoothRepresentation,\n    28\t  type FormSnapshot,\n    29\t} from \"./render.js\";\n    30\t\n    31\t// Canonical source state needed to identify or read the compacted span is\n    32\t// damaged: compact refuses with state_corruption (AC-2.5). Derived-material\n    33\t// damage never raises this — it degrades through the ladders instead.\n    34\texport class CanonicalCorruptionError extends Error {\n    35\t  readonly code: \"turn_state_corrupt\" | \"source_damaged\";\n    36\t  constructor(code: \"turn_state_corrupt\" | \"source_damaged\", reason: string) {\n    37\t    super(reason);\n    38\t    this.code = code;\n    39\t    this.name = \"CanonicalCorruptionError\";\n    40\t  }\n    41\t}\n    42\t\n    43\texport interface SelectionMessage {\n    44\t  messageId: string;\n    45\t  order: number; // source_event_order\n    46\t  kind: string;\n    47\t  tokenEstimate: number;\n    48\t  turnId: string | null;\n    49\t  text: string; // excerpt/note line (render.excerptLine)\n    50\t}\n    51\t\n    52\texport interface SelectionTurn {\n    53\t  turnId: string;\n    54\t  turnOrder: number;\n    55\t  status: \"open\" | \"closed\";\n    56\t  openedAt: number;\n    57\t  closedAt: number | null;\n    58\t}\n    59\t\n    60\texport interface SelectionChunk {\n    61\t  chunkId: string;\n    62\t  chunkOrder: number;\n    63\t  status: \"open\" | \"closed\";\n    64\t  memberTurnIds: string[]; // member order\n    65\t}\n    66\t\n    67\texport interface SelectionInputs {\n    68\t  messages: SelectionMessage[]; // live only, ascending order\n    69\t  turns: SelectionTurn[]; // ascending turnOrder\n    70\t  chunks: SelectionChunk[]; // ascending chunkOrder\n    71\t  forms: Map<string, FormSnapshot>; // `${subjectId}/${form}` (turn/chunk subjects)\n    72\t  maxEventOrder: number;\n    73\t  formCounts: Record<string, Record<string, number>>; // form → state → count\n    74\t}\n    75\t\n    76\texport interface ArrangementEntry {\n    77\t  band: Band;\n    78\t  subjectKind: \"turn\" | \"chunk\";\n    79\t  subjectId: string;\n    80\t  formUsed: string;\n    81\t  degraded: boolean;\n    82\t  gap: boolean;\n    83\t  reason?: string; // gap entries\n    84\t  startOrder: number; // oldest event order the entry represents (notes included)\n    85\t  text: string; // rendered entry text (the band stores this verbatim)\n    86\t  tokens: number;\n    87\t}\n    88\t\n    89\texport interface SelectionResult {\n    90\t  compactPoint: number;\n    91\t  coveredFrom: number;\n    92\t  // Gradient order (brief → detailed → smooth), oldest-first within band —\n    93\t  // the order the bands render and the arrangement persists.\n    94\t  entries: ArrangementEntry[];\n    95\t}\n    96\t\n    97\t// ── reads (corruption check lives here, pre-transaction) ─────────\n    98\t\n    99\texport function readSelectionInputs(db: DatabaseSync): SelectionInputs {\n   100\t  const turnRows = db\n   101\t    .prepare(\n   102\t      `SELECT turn_id, turn_order, status, opened_at_event_order, closed_at_event_order, deleted_at\n   103\t       FROM turns ORDER BY turn_order`,\n   104\t    )\n   105\t    .all() as unknown as Array<{\n   106\t    turn_id: string;\n   107\t    turn_order: number | bigint;\n   108\t    status: string;\n   109\t    opened_at_event_order: number | bigint;\n   110\t    closed_at_event_order: number | bigint | null;\n   111\t    deleted_at: string | null;\n   112\t  }>;\n   113\t  // Referential checks compare against every turn row (a tombstoned turn is\n   114\t  // a legitimate reference target, not damage); the selection walk itself\n   115\t  // sees live turns only.\n   116\t  const turnIds = new Set(turnRows.map((row) => row.turn_id));\n   117\t  const turns: SelectionTurn[] = turnRows\n   118\t    .filter((row) => row.deleted_at === null)\n   119\t    .map((row) => ({\n   120\t      turnId: row.turn_id,\n   121\t      turnOrder: Number(row.turn_order),\n   122\t      status: row.status as \"open\" | \"closed\",\n   123\t      openedAt: Number(row.opened_at_event_order),\n   124\t      closedAt: row.closed_at_event_order === null ? null : Number(row.closed_at_event_order),\n   125\t    }));\n   126\t\n   127\t  // Canonical damage the walk cannot select across (AC-2.5): the Epic 01\n   128\t  // turn-state invariant (at most one open turn, open turns carry no close),\n   129\t  // and referential damage between the chunk/message rows and their turns.\n   130\t  const openTurns = turns.filter((turn) => turn.status === \"open\");\n   131\t  if (openTurns.length > 1) {\n   132\t    throw new CanonicalCorruptionError(\n   133\t      \"turn_state_corrupt\",\n   134\t      `canonical turn state corrupt: ${openTurns.length} open turns (${openTurns\n   135\t        .map((turn) => turn.turnId)\n   136\t        .join(\", \")}); the compacted span cannot be identified`,\n   137\t    );\n   138\t  }\n   139\t  for (const turn of turns) {\n   140\t    if (turn.status === \"closed\" && turn.closedAt === null) {\n   141\t      throw new CanonicalCorruptionError(\n   142\t        \"source_damaged\",\n   143\t        `canonical turn state corrupt: closed turn ${turn.turnId} carries no close boundary`,\n   144\t      );\n   145\t    }\n   146\t  }\n   147\t\n   148\t  const messageRows = db\n   149\t    .prepare(\n   150\t      `SELECT message_id, source_event_order, kind, token_estimate, turn_id\n   151\t       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\n   152\t    )\n   153\t    .all() as unknown as Array<{\n   154\t    message_id: string;\n   155\t    source_event_order: number | bigint;\n   156\t    kind: string;\n   157\t    token_estimate: number | bigint;\n   158\t    turn_id: string | null;\n   159\t  }>;\n   160\t  const blockRows = db\n   161\t    .prepare(\n   162\t      `SELECT mb.message_id, mb.block_type, mb.content\n   163\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n   164\t       WHERE m.deleted_at IS NULL\n   165\t       ORDER BY m.source_event_order, mb.block_index`,\n   166\t    )\n   167\t    .all() as unknown as Array<{ message_id: string; block_type: string; content: string }>;\n   168\t  const blocksByMessage = new Map<\n   169\t    string,\n   170\t    Array<{ blockType: string; content: Record<string, unknown> }>\n   171\t  >();\n   172\t  for (const row of blockRows) {\n   173\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n   174\t    blocks.push({\n   175\t      blockType: row.block_type,\n   176\t      content: JSON.parse(row.content) as Record<string, unknown>,\n   177\t    });\n   178\t    blocksByMessage.set(row.message_id, blocks);\n   179\t  }\n   180\t  const messages: SelectionMessage[] = messageRows.map((row) => {\n   181\t    if (row.turn_id !== null && !turnIds.has(row.turn_id)) {\n   182\t      throw new CanonicalCorruptionError(\n   183\t        \"source_damaged\",\n   184\t        `canonical record corrupt: message ${row.message_id} references missing turn ${row.turn_id}`,\n   185\t      );\n   186\t    }\n   187\t    return {\n   188\t      messageId: row.message_id,\n   189\t      order: Number(row.source_event_order),\n   190\t      kind: row.kind,\n   191\t      tokenEstimate: Number(row.token_estimate),\n   192\t      turnId: row.turn_id,\n   193\t      text: excerptLine(row.kind, blocksByMessage.get(row.message_id) ?? []),\n   194\t    };\n   195\t  });\n   196\t\n   197\t  const chunkRows = db\n   198\t    .prepare(`SELECT chunk_id, chunk_order, status FROM chunk ORDER BY chunk_order`)\n   199\t    .all() as unknown as Array<{ chunk_id: string; chunk_order: number | bigint; status: string }>;\n   200\t  const memberRows = db\n   201\t    .prepare(\n   202\t      `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n   203\t       JOIN chunk c ON c.chunk_id = cm.chunk_id\n   204\t       ORDER BY c.chunk_order, cm.member_idx`,\n   205\t    )\n   206\t    .all() as unknown as Array<{ chunk_id: string; turn_id: string; member_idx: number | bigint }>;\n   207\t  const membersByChunk = new Map<string, string[]>();\n   208\t  for (const row of memberRows) {\n   209\t    if (!turnIds.has(row.turn_id)) {\n   210\t      throw new CanonicalCorruptionError(\n   211\t        \"source_damaged\",\n   212\t        `canonical record corrupt: chunk ${row.chunk_id} membership references missing turn ${row.turn_id}`,\n   213\t      );\n   214\t    }\n   215\t    const members = membersByChunk.get(row.chunk_id) ?? [];\n   216\t    members.push(row.turn_id);\n   217\t    membersByChunk.set(row.chunk_id, members);\n   218\t  }\n   219\t  const chunks: SelectionChunk[] = chunkRows.map((row) => ({\n   220\t    chunkId: row.chunk_id,\n   221\t    chunkOrder: Number(row.chunk_order),\n   222\t    status: row.status as \"open\" | \"closed\",\n   223\t    memberTurnIds: membersByChunk.get(row.chunk_id) ?? [],\n   224\t  }));\n   225\t\n   226\t  const formRows = db\n   227\t    .prepare(\n   228\t      `SELECT subject_id, derivation_type, state, content, reason FROM derivation\n   229\t       WHERE subject_kind IN ('turn', 'chunk')`,\n   230\t    )\n   231\t    .all() as unknown as Array<{\n   232\t    subject_id: string;\n   233\t    derivation_type: string;\n   234\t    state: string;\n   235\t    content: string | null;\n   236\t    reason: string | null;\n   237\t  }>;\n   238\t  const forms = new Map<string, FormSnapshot>();\n   239\t  for (const row of formRows) {\n   240\t    const snapshot: FormSnapshot = { state: row.state as FormSnapshot[\"state\"] };\n   241\t    if (row.content !== null) snapshot.content = row.content;\n   242\t    if (row.reason !== null) snapshot.reason = row.reason;\n   243\t    forms.set(`${row.subject_id}/${row.derivation_type}`, snapshot);\n   244\t  }\n   245\t\n   246\t  const maxRow = db.prepare(`SELECT COALESCE(MAX(event_order), 0) AS m FROM event`).get() as {\n   247\t    m: number | bigint;\n   248\t  };\n   249\t  const countRows = db\n   250\t    .prepare(\n   251\t      `SELECT derivation_type, state, COUNT(*) AS n FROM derivation GROUP BY derivation_type, state`,\n   252\t    )\n   253\t    .all() as unknown as Array<{ derivation_type: string; state: string; n: number | bigint }>;\n   254\t  const formCounts: Record<string, Record<string, number>> = {};\n   255\t  for (const row of countRows) {\n   256\t    formCounts[row.derivation_type] = {\n   257\t      ...formCounts[row.derivation_type],\n   258\t      [row.state]: Number(row.n),\n   259\t    };\n   260\t  }\n   261\t\n   262\t  return { messages, turns, chunks, forms, maxEventOrder: Number(maxRow.m), formCounts };\n   263\t}\n   264\t\n   265\t// ── the pure walk ─────────────────────────────────────────────────\n   266\t\n   267\texport interface SelectionConfig {\n   268\t  lowerBound: number;\n   269\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n   270\t}\n   271\t\n   272\texport function selectArrangement(\n   273\t  inputs: SelectionInputs,\n   274\t  config: SelectionConfig,\n   275\t): SelectionResult {\n   276\t  const { messages, turns, chunks, forms } = inputs;\n   277\t  const lookup = (subjectId: string, form: string): FormSnapshot | undefined =>\n   278\t    forms.get(`${subjectId}/${form}`);\n   279\t  const budget = (share: number): number => (config.lowerBound * share) / 100;\n   280\t\n   281\t  const turnsById = new Map(turns.map((turn) => [turn.turnId, turn]));\n   282\t  const messagesByTurn = new Map<string, SelectionMessage[]>();\n   283\t  for (const message of messages) {\n   284\t    if (message.turnId === null) continue;\n   285\t    const list = messagesByTurn.get(message.turnId) ?? [];\n   286\t    list.push(message);\n   287\t    messagesByTurn.set(message.turnId, list);\n   288\t  }\n   289\t\n   290\t  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\n   291\t  // band assignment, price into its fill cost, and render marked immediately\n   292\t  // before its entry. No following turn ⇒ tail by construction.\n   293\t  const notesByTurn = new Map<string, SelectionMessage[]>();\n   294\t  for (const message of messages) {\n   295\t    if (message.turnId !== null) continue;\n   296\t    const following = turns.find((turn) => turn.openedAt > message.order);\n   297\t    if (following === undefined) continue; // trailing straggler: tail\n   298\t    const list = notesByTurn.get(following.turnId) ?? [];\n   299\t    list.push(message);\n   300\t    notesByTurn.set(following.turnId, list);\n   301\t  }\n   302\t\n   303\t  // The oldest event order a turn's entry represents: its oldest live\n   304\t  // message or attached note, falling back to its open boundary.\n   305\t  function turnStartOrder(turn: SelectionTurn): number {\n   306\t    const candidates = [\n   307\t      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\n   308\t      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\n   309\t    ];\n   310\t    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\n   311\t  }\n   312\t\n   313\t  // Rule 1 — compact point: messages newest-first until the estimate sum\n   314\t  // first reaches the full share; the point snaps to a turn boundary so the\n   315\t  // tail never begins mid-turn. Open-turn messages always land in the tail.\n   316\t  const fullBudget = budget(config.percentages.full);\n   317\t  const closedTurns = turns.filter((turn) => turn.status === \"closed\");\n   318\t  let compactPoint = 0;\n   319\t  if (closedTurns.length > 0 && messages.length > 0) {\n   320\t    let sum = 0;\n   321\t    let crossing: SelectionMessage | null = null;\n   322\t    for (let i = messages.length - 1; i >= 0; i -= 1) {\n   323\t      const message = messages[i] as SelectionMessage;\n   324\t      sum += message.tokenEstimate;\n   325\t      if (sum >= fullBudget) {\n   326\t        crossing = message;\n   327\t        break;\n   328\t      }\n   329\t    }\n   330\t    // Budget never reached ⇒ the whole record fits the full share:\n   331\t    // everything is tail, no bands.\n   332\t    compactPoint = crossing === null ? 0 : snapCompactPoint(crossing);\n   333\t  }\n   334\t\n   335\t  function snapCompactPoint(oldestTaken: SelectionMessage): number {\n   336\t    // The turn whose boundary the point snaps against: the message's own\n   337\t    // turn, or — for a turnless straggler — the turn it attaches to.\n   338\t    let candidate: SelectionTurn | undefined =\n   339\t      oldestTaken.turnId !== null ? turnsById.get(oldestTaken.turnId) : undefined;\n   340\t    if (candidate === undefined && oldestTaken.turnId === null) {\n   341\t      candidate = turns.find((turn) => turn.openedAt > oldestTaken.order);\n   342\t    }\n   343\t    const previousClose = (turn: SelectionTurn): number => {\n   344\t      const previous = closedTurns.filter((t) => t.turnOrder < turn.turnOrder).at(-1);\n   345\t      return previous?.closedAt ?? 0;\n   346\t    };\n   347\t    if (candidate === undefined) {\n   348\t      // A trailing straggler with no following turn sits after the last turn\n   349\t      // boundary, where the compact point cannot pass it: tail begins after\n   350\t      // the newest closed turn.\n   351\t      return closedTurns.at(-1)?.closedAt ?? 0;\n   352\t    }\n   353\t    if (candidate.status === \"open\") {\n   354\t      // Open-turn messages are tail regardless of budget; the tail begins at\n   355\t      // the open turn's start.\n   356\t      return previousClose(candidate);\n   357\t    }\n   358\t    // Fully covered down to the turn's start (notes included) ⇒ the tail\n   359\t    // begins at this turn; otherwise snap FORWARD to the next turn start —\n   360\t    // the partially-covered turn falls whole to the bands.\n   361\t    if (oldestTaken.order <= turnStartOrder(candidate)) {\n   362\t      return previousClose(candidate);\n   363\t    }\n   364\t    return candidate.closedAt ?? 0;\n   365\t  }\n   366\t\n   367\t  // Band candidates: closed turns wholly behind the compact point. Rule 5 is\n   368\t  // structural here — chunked or not, a banded turn is a smooth candidate\n   369\t  // (bands are defined by representation, not strict time strata).\n   370\t  const bandedTurns = closedTurns.filter(\n   371\t    (turn) => turn.closedAt !== null && turn.closedAt <= compactPoint,\n   372\t  );\n   373\t  const bandedTurnIds = new Set(bandedTurns.map((turn) => turn.turnId));\n   374\t\n   375\t  function buildTurnEntry(turn: SelectionTurn): ArrangementEntry {\n   376\t    const turnMessages = messagesByTurn.get(turn.turnId) ?? [];\n   377\t    const excerpt =\n   378\t      turnMessages.length === 0 ? null : turnMessages.map((message) => message.text).join(\"\\n\");\n   379\t    const rep = resolveSmoothRepresentation(turn.turnId, lookup, excerpt);\n   380\t    const noteTexts = (notesByTurn.get(turn.turnId) ?? []).map((note) => note.text);\n   381\t    const text = renderArrangementEntry(\"turn\", turn.turnId, rep, noteTexts);\n   382\t    const entry: ArrangementEntry = {\n   383\t      band: \"smooth\",\n   384\t      subjectKind: \"turn\",\n   385\t      subjectId: turn.turnId,\n   386\t      formUsed: rep.formUsed,\n   387\t      degraded: rep.degraded,\n   388\t      gap: rep.gap,\n   389\t      startOrder: turnStartOrder(turn),\n   390\t      text,\n   391\t      tokens: estimateTokens(text),\n   392\t    };\n   393\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n   394\t    return entry;\n   395\t  }\n   396\t\n   397\t  function buildChunkEntry(chunk: SelectionChunk, band: \"detailed\" | \"brief\"): ArrangementEntry {\n   398\t    const memberProjections = chunk.memberTurnIds\n   399\t      .map((turnId) => lookup(turnId, \"lower_band_projection\"))\n   400\t      .filter((form): form is FormSnapshot & { content: string } => form?.state === \"ready\")\n   401\t      .map((form) => form.content ?? \"\")\n   402\t      .filter((content) => content.length > 0);\n   403\t    const rep =\n   404\t      band === \"detailed\"\n   405\t        ? resolveDetailedRepresentation(chunk.chunkId, lookup, memberProjections)\n   406\t        : resolveBriefRepresentation(chunk.chunkId, lookup);\n   407\t    const noteTexts = chunk.memberTurnIds.flatMap((turnId) =>\n   408\t      (notesByTurn.get(turnId) ?? []).map((note) => note.text),\n   409\t    );\n   410\t    const text = renderArrangementEntry(\"chunk\", chunk.chunkId, rep, noteTexts);\n   411\t    const memberStarts = chunk.memberTurnIds\n   412\t      .map((turnId) => turnsById.get(turnId))\n   413\t      .filter((turn): turn is SelectionTurn => turn !== undefined)\n   414\t      .map((turn) => turnStartOrder(turn));\n   415\t    const entry: ArrangementEntry = {\n   416\t      band,\n   417\t      subjectKind: \"chunk\",\n   418\t      subjectId: chunk.chunkId,\n   419\t      formUsed: rep.formUsed,\n   420\t      degraded: rep.degraded,\n   421\t      gap: rep.gap,\n   422\t      startOrder: memberStarts.length === 0 ? compactPoint : Math.min(...memberStarts),\n   423\t      text,\n   424\t      tokens: estimateTokens(text),\n   425\t    };\n   426\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n   427\t    return entry;\n   428\t  }\n   429\t\n   430\t  // The one fill rule, shared by all three bands (rules 2–4, ruling 013's\n   431\t  // literal reading): newest-first whole-entry fill, ≤ inclusion (an entry\n   432\t  // exactly filling the budget is included), the first crossing entry stops\n   433\t  // the band — included only when the band was still empty (one oversized\n   434\t  // entry still represents).\n   435\t  function fillBand<T>(\n   436\t    candidates: readonly T[], // newest-first\n   437\t    bandBudget: number,\n   438\t    build: (candidate: T) => ArrangementEntry,\n   439\t  ): { included: ArrangementEntry[]; rest: T[] } {\n   440\t    const included: ArrangementEntry[] = [];\n   441\t    let sum = 0;\n   442\t    for (let i = 0; i < candidates.length; i += 1) {\n   443\t      const entry = build(candidates[i] as T);\n   444\t      if (sum + entry.tokens <= bandBudget) {\n   445\t        included.push(entry);\n   446\t        sum += entry.tokens;\n   447\t        continue;\n   448\t      }\n   449\t      if (included.length === 0) {\n   450\t        included.push(entry);\n   451\t        return { included, rest: candidates.slice(i + 1) as T[] };\n   452\t      }\n   453\t      return { included, rest: candidates.slice(i) as T[] };\n   454\t    }\n   455\t    return { included, rest: [] };\n   456\t  }\n   457\t\n   458\t  // Rule 2 + 5 — smooth band: banded closed turns newest-first, chunked or\n   459\t  // not (rule 5 is structural: a closed-but-unchunked turn is a turn, takes\n   460\t  // the smooth representation, and consumes this budget).\n   461\t  const smooth = fillBand(\n   462\t    [...bandedTurns].reverse(),\n   463\t    budget(config.percentages.smooth),\n   464\t    buildTurnEntry,\n   465\t  );\n   466\t  const oldestSmoothOrder = smooth.included.reduce(\n   467\t    (oldest, entry) =>\n   468\t      Math.min(oldest, turnsById.get(entry.subjectId)?.turnOrder ?? Number.POSITIVE_INFINITY),\n   469\t    Number.POSITIVE_INFINITY,\n   470\t  );\n   471\t\n   472\t  // Rules 3–4 — chunk candidacy: chunks entirely older than the smooth\n   473\t  // band's coverage, with the pinned tie-breaker doing the deciding — chunk\n   474\t  // coverage is its NEWEST member turn, which must sit behind the compact\n   475\t  // point and be older than the smooth band's oldest included turn.\n   476\t  const chunkCandidates = chunks\n   477\t    .filter((chunk) => chunk.status === \"closed\")\n   478\t    .filter((chunk) => {\n   479\t      const liveMembers = chunk.memberTurnIds\n   480\t        .map((turnId) => turnsById.get(turnId))\n   481\t        .filter((turn): turn is SelectionTurn => turn !== undefined);\n   482\t      if (liveMembers.length === 0) return false; // fully tombstoned membership\n   483\t      const newestMember = liveMembers.reduce((newest, turn) =>\n   484\t        turn.turnOrder > newest.turnOrder ? turn : newest,\n   485\t      );\n   486\t      return (\n   487\t        bandedTurnIds.has(newestMember.turnId) && newestMember.turnOrder < oldestSmoothOrder\n   488\t      );\n   489\t    })\n   490\t    .reverse(); // newest-first\n   491\t\n   492\t  // Rule 3 — detailed: same fill rule against its share.\n   493\t  const detailed = fillBand(chunkCandidates, budget(config.percentages.detailed), (chunk) =>\n   494\t    buildChunkEntry(chunk, \"detailed\"),\n   495\t  );\n   496\t  // Rule 4 — brief: the remaining chunks, same fill rule against its share.\n   497\t  // Chunks remaining after the budget are the coverage edge — outside the\n   498\t  // view, reported via covered_from, never phantom gap entries.\n   499\t  const brief = fillBand(detailed.rest, budget(config.percentages.brief), (chunk) =>\n   500\t    buildChunkEntry(chunk, \"brief\"),\n   501\t  );\n   502\t\n   503\t  const byRecordOrder = (a: ArrangementEntry, b: ArrangementEntry): number =>\n   504\t    a.startOrder - b.startOrder;\n   505\t  const entries: ArrangementEntry[] = [\n   506\t    ...brief.included.sort(byRecordOrder),\n   507\t    ...detailed.included.sort(byRecordOrder),\n   508\t    ...smooth.included.sort(byRecordOrder),\n   509\t  ];\n   510\t\n   511\t  const coveredFrom =\n   512\t    entries.length === 0\n   513\t      ? compactPoint\n   514\t      : Math.min(...entries.map((entry) => entry.startOrder));\n   515\t\n   516\t  return { compactPoint, coveredFrom, entries };\n   517\t}\n","exit_code":0,"status":"completed"}}

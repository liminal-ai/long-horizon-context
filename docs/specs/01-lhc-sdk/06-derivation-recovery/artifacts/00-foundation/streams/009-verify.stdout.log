{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/internal/derive.ts'","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport { resolveInstancePoke } from \"../../../shared/context.js\";\n    11\timport type {\n    12\t  DerivationMetadata,\n    13\t  DerivationType,\n    14\t  HandlerOutcome,\n    15\t  HandlerRunContext,\n    16\t  WorkHandler,\n    17\t} from \"../../../shared/derivation.js\";\n    18\timport { writeLog } from \"../../../tech-utils/logging/index.js\";\n    19\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    20\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    21\timport { composeRenderingInput } from \"./compose.js\";\n    22\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    23\timport {\n    24\t  chunkExists,\n    25\t  readMemberMessages,\n    26\t  readMemberProjections,\n    27\t  readMessageFormRows,\n    28\t  readTurnSource,\n    29\t} from \"./forms.js\";\n    30\timport { selectOpenTurnIds } from \"./store.js\";\n    31\t\n    32\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    33\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    34\t}\n    35\t\n    36\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    37\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    38\t}\n    39\t\n    40\tfunction readThreadId(run: HandlerRunContext): string {\n    41\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    42\t    | { thread_id: string }\n    43\t    | undefined;\n    44\t  return row?.thread_id ?? \"\";\n    45\t}\n    46\t\n    47\tfunction logFallback(\n    48\t  run: HandlerRunContext,\n    49\t  entry: {\n    50\t    derivationType: DerivationType;\n    51\t    subjectId: string;\n    52\t    floorUsed: string;\n    53\t  },\n    54\t): void {\n    55\t  const db = run.openDb();\n    56\t  writeLog(\n    57\t    {\n    58\t      db,\n    59\t      clock: run.clock,\n    60\t      threadId: readThreadId(run),\n    61\t      onCommit: () => {},\n    62\t      poke: resolveInstancePoke(),\n    63\t    },\n    64\t    {\n    65\t      level: \"warning\",\n    66\t      message: \"derivation fallback used\",\n    67\t      derivationType: entry.derivationType,\n    68\t      subjectId: entry.subjectId,\n    69\t      reason: \"not_ready\",\n    70\t      floorUsed: entry.floorUsed,\n    71\t    },\n    72\t  );\n    73\t}\n    74\t\n    75\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n    76\t  const turnId = item.sourceRef[\"turnId\"];\n    77\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n    78\t  const db = run.openDb();\n    79\t  const turn = readTurnSource(db, turnId);\n    80\t  if (turn === undefined || turn.deleted) {\n    81\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    82\t    // would hit nothing; either way the item is terminal against a source\n    83\t    // that cannot improve.\n    84\t    return sourceDamaged(`turn ${turnId} not found`);\n    85\t  }\n    86\t  if (turn.status !== \"closed\") {\n    87\t    // Derivation is queued only at close; an open turn under a queued item\n    88\t    // means the record was interfered with.\n    89\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n    90\t  }\n    91\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n    92\t  // batch pipeline writes turn state and it never leaves two turns open, so\n    93\t  // more than one open turn means the record was damaged below the SDK. A\n    94\t  // handler must not compose against a membership it cannot trust; the form\n    95\t  // lands blocked naming the damage, and requeue refuses with that reason\n    96\t  // until the source reads clean (Story 4).\n    97\t  const openTurnIds = selectOpenTurnIds(db);\n    98\t  if (openTurnIds.length > 1) {\n    99\t    return sourceDamaged(\n   100\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n   101\t    );\n   102\t  }\n   103\t\n   104\t  // Compose from current message-form states: ready forms verbatim,\n   105\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n   106\t  // before any provider call, and no transaction is held across them.\n   107\t  const messages = readMemberMessages(db, turnId);\n   108\t  const forms = readMessageFormRows(\n   109\t    db,\n   110\t    messages.map((message) => message.messageId),\n   111\t  );\n   112\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n   113\t  for (const gap of gaps) {\n   114\t    logFallback(run, {\n   115\t      derivationType: gap.derivationType,\n   116\t      subjectId: gap.subjectId,\n   117\t      floorUsed: parts.find((part) => part.messageId === gap.subjectId)?.text ?? \"\",\n   118\t    });\n   119\t  }\n   120\t\n   121\t  const rendering = await run.provider.composeTurnRendering({ parts });\n   122\t  if (!rendering.ok) return providerFailed(rendering);\n   123\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n   124\t  if (!projection.ok) return providerFailed(projection);\n   125\t\n   126\t  // The projection's token count is estimated exactly once, here, as the\n   127\t  // artifact lands; placement reads this stored arithmetic and never\n   128\t  // re-counts (AC-3.9's determinism input).\n   129\t  const projectedTokens = estimateTokens(projection.text);\n   130\t  const threadId = readThreadId(run);\n   131\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\n   132\t  // from the composition input (AC-3.8) — the chunk summaries read them from\n   133\t  // here, never from provider prose. Provenance is copied from the provider\n   134\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\n   135\t  // deterministic provider sets none.\n   136\t  const renderingMetadata: DerivationMetadata = {\n   137\t    ...(receipts.length > 0 ? { receipts } : {}),\n   138\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\n   139\t  };\n   140\t\n   141\t  return {\n   142\t    ok: true,\n   143\t    derivations: [\n   144\t      {\n   145\t        subjectKind: \"turn\",\n   146\t        subjectId: turnId,\n   147\t        derivationType: \"turn_rendering\",\n   148\t        content: rendering.text,\n   149\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\n   150\t      },\n   151\t      {\n   152\t        subjectKind: \"turn\",\n   153\t        subjectId: turnId,\n   154\t        derivationType: \"lower_band_projection\",\n   155\t        content: projection.text,\n   156\t        ...(projection.provenance === undefined\n   157\t          ? {}\n   158\t          : { metadata: { provenance: projection.provenance } }),\n   159\t      },\n   160\t    ],\n   161\t    onApplied: (tx) => {\n   162\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   163\t      for (const chunkId of placement.closedChunkIds) {\n   164\t        enqueueChunkSummaries(\n   165\t          {\n   166\t            db: tx.db,\n   167\t            clock: run.clock,\n   168\t            threadId,\n   169\t            onCommit: tx.onCommit,\n   170\t            poke: resolveInstancePoke(),\n   171\t          },\n   172\t          chunkId,\n   173\t        );\n   174\t      }\n   175\t    },\n   176\t  };\n   177\t};\n   178\t\n   179\t// One read for both summary kinds — member projections in turn order — but\n   180\t// two contracts at the provider seam (AC-3.8): detailed receives the\n   181\t// members' tool-run receipts (what changed, outcome) read from the\n   182\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n   183\t// text stripped here so the brief provider call structurally cannot carry\n   184\t// it. Two work items, two handlers' runs, independent retry and states. A\n   185\t// member whose projection is not ready falls back to nothing and records a\n   186\t// gap, mirroring the rendering's fallback rule.\n   187\tfunction chunkSummaryHandler(\n   188\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   189\t): WorkHandler {\n   190\t  return async (run, item) => {\n   191\t    const chunkId = item.sourceRef[\"chunkId\"];\n   192\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   193\t    const db = run.openDb();\n   194\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   195\t\n   196\t    const members = readMemberProjections(db, chunkId);\n   197\t    const memberProjections: string[] = [];\n   198\t    for (const member of members) {\n   199\t      if (member.state === \"ready\" && member.content !== undefined) {\n   200\t        memberProjections.push(member.content);\n   201\t      } else {\n   202\t        memberProjections.push(\"\");\n   203\t        logFallback(run, {\n   204\t          subjectId: member.turnId,\n   205\t          derivationType: \"lower_band_projection\",\n   206\t          floorUsed: \"\",\n   207\t        });\n   208\t      }\n   209\t    }\n   210\t\n   211\t    const result =\n   212\t      kind === \"chunk_summary_detailed\"\n   213\t        ? await run.provider.summarizeChunkDetailed({\n   214\t            memberProjections,\n   215\t            memberReceipts: members.map((member) => member.receipts),\n   216\t          })\n   217\t        : await run.provider.summarizeChunkBrief({\n   218\t            memberProjections,\n   219\t            memberOutcomes: members.map((member) =>\n   220\t              member.receipts.map((receipt) => receipt.outcome),\n   221\t            ),\n   222\t          });\n   223\t    if (!result.ok) return providerFailed(result);\n   224\t\n   225\t    return {\n   226\t      ok: true,\n   227\t      derivations: [\n   228\t        {\n   229\t          subjectKind: \"chunk\",\n   230\t          subjectId: chunkId,\n   231\t          derivationType: kind,\n   232\t          content: result.text,\n   233\t          ...(result.provenance === undefined\n   234\t            ? {}\n   235\t            : { metadata: { provenance: result.provenance } }),\n   236\t        },\n   237\t      ],\n   238\t    };\n   239\t  };\n   240\t}\n   241\t\n   242\t// The domain's handler table, merged into the SDK dispatch map at\n   243\t// construction (DD-6).\n   244\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   245\t  turn_derivation: turnDerivationHandler,\n   246\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   247\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   248\t};\n","exit_code":0,"status":"completed"}}

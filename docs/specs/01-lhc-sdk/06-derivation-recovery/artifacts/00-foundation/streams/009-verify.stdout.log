ns/thread-view/index.ts\",\"reason\":\"Persisted derivationUsed and derivationCounts in thread_view JSON and renamed degraded receipt vocabulary.\"},{\"path\":\"packages/lhc/src/domains/thread-view/internal/render.ts\",\"reason\":\"Renamed FormSnapshot/FormLookup/formUsed vocabulary to derivation vocabulary.\"},{\"path\":\"packages/lhc/src/domains/thread-view/internal/select.ts\",\"reason\":\"Renamed selection inputs, arrangement entries, and source-state counts to derivation vocabulary.\"},{\"path\":\"packages/lhc/src/domains/inspect/internal/view-report.ts\",\"reason\":\"Returned derivationUsed from inspect view reports.\"},{\"path\":\"packages/lhc/src/shared/view.ts\",\"reason\":\"Updated public StoredView and CompactReceipt shapes to derivation vocabulary.\"},{\"path\":\"packages/lhc/src/shared/inspect.ts\",\"reason\":\"Updated public inspect report shapes to derivation vocabulary.\"},{\"path\":\"packages/lhc/test/logging-surface.test.ts\",\"reason\":\"Added production fallback logging coverage and real-store rollback containment coverage.\"},{\"path\":\"packages/lhc/test/derivation-turns.test.ts\",\"reason\":\"Updated fallback assertions to expect clean ready rows and durable log entries.\"},{\"path\":\"packages/lhc/test/report-repair.test.ts\",\"reason\":\"Updated repair assertions for fallback-composed rows without persisted gaps.\"},{\"path\":\"packages/lhc/test/fixtures/index.ts\",\"reason\":\"Routed raw test database handles through the normal opener so isolated logging can resolve the file path.\"},{\"path\":\"packages/lhc/test/fixtures/threads.ts\",\"reason\":\"Updated shared fallback-rendering fixture invariants for clean ready derivation rows.\"},{\"path\":\"packages/lhc/test/goldens/*.json\",\"reason\":\"Updated stored arrangement golden keys from formUsed to derivationUsed.\"},{\"path\":\"packages/lhc/src/domains/messages/*\",\"reason\":\"Completed Story 0 derivation vocabulary rename across message derivation surfaces.\"},{\"path\":\"packages/lhc/src/domains/turns/*\",\"reason\":\"Completed Story 0 derivation vocabulary rename across turn derivation surfaces.\"},{\"path\":\"packages/lhc/test/**/*.ts\",\"reason\":\"Updated affected tests and fixtures for derivation vocabulary and clean fallback-row behavior.\"}],\"tests\":{\"added\":[\"packages/lhc/test/logging-surface.test.ts\"],\"modified\":[\"packages/lhc/test/logging-surface.test.ts\",\"packages/lhc/test/derivation-turns.test.ts\",\"packages/lhc/test/report-repair.test.ts\",\"packages/lhc/test/fixtures/index.ts\",\"packages/lhc/test/fixtures/threads.ts\",\"packages/lhc/test/goldens/*.json\"],\"removed\":[],\"totalAfterStory\":405,\"deltaFromPriorBaseline\":7},\"gatesRun\":[{\"command\":\"cd packages/lhc && pnpm exec vitest run test/logging-surface.test.ts\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify-all\",\"result\":\"pass\"}],\"selfReview\":{\"passesRun\":0,\"findingsFixed\":[\"S0-F1: ready derivation rows no longer persist fallback/gap markers; production fallback paths record fallback events in the durable log.\",\"S0-F2: writeLog is fail-soft and uses a separate database connection; real-store rollback containment coverage was added.\",\"S0-F3: public/shared thread-view and inspect shapes plus persisted thread_view JSON now use derivation vocabulary.\"],\"findingsSurfaced\":[]},\"openQuestions\":[],\"specDeviations\":[],\"recommendedNextStep\":\"Run verifier artifact generation for Story 0 against the updated implementation.\"},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/00-foundation/008-continue.json\"}],\"startedAt\":\"2026-06-15T04:52:11.210Z\",\"finishedAt\":\"2026-06-15T04:59:15.149Z\"}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/index.ts'","aggregated_output":"     1\timport { mkdtempSync, rmSync } from \"node:fs\";\n     2\timport { tmpdir } from \"node:os\";\n     3\timport { join } from \"node:path\";\n     4\timport { DatabaseSync } from \"node:sqlite\";\n     5\timport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n     6\timport { openDatabase } from \"../../src/shared/storage.js\";\n     7\t\n     8\texport type EventByKind<K extends EventKind> = Extract<\n     9\t  MessageEventInput,\n    10\t  { eventKind: K }\n    11\t>;\n    12\t\n    13\tlet keyCounter = 0;\n    14\t\n    15\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n    16\t  user_prompt: () => ({ text: \"please read the file\" }),\n    17\t  assistant_text: () => ({ text: \"here is what I found\" }),\n    18\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n    19\t  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n    20\t  tool_call: () => ({\n    21\t    toolCallId: \"call-1\",\n    22\t    toolName: \"read_file\",\n    23\t    arguments: { path: \"notes.txt\" },\n    24\t  }),\n    25\t  tool_result: () => ({\n    26\t    toolCallId: \"call-1\",\n    27\t    content: \"contents of notes.txt\",\n    28\t    isError: false,\n    29\t  }),\n    30\t  turn_end: () => ({}),\n    31\t};\n    32\t\n    33\t// Returns the discriminated MessageEventInput member for its kind, so a\n    34\t// kind/payload mismatch in test code is a compile error — building an invalid\n    35\t// pairing requires an explicit cast at the call site.\n    36\texport function validEvent<K extends EventKind>(\n    37\t  kind: K,\n    38\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n    39\t): EventByKind<K> {\n    40\t  keyCounter += 1;\n    41\t  const base = {\n    42\t    eventKind: kind,\n    43\t    idempotencyKey: `fixture-key-${keyCounter}`,\n    44\t    actor: \"fixture-actor\",\n    45\t    harness: \"fixture-harness\",\n    46\t    payload: defaultPayloads[kind](),\n    47\t  };\n    48\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n    49\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n    50\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n    51\t  // parameter types, not this assertion.\n    52\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    53\t}\n    54\t\n    55\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    56\t  return kinds.map((kind) => validEvent(kind));\n    57\t}\n    58\t\n    59\texport function conversationTurn(): MessageEventInput[] {\n    60\t  return eventBatch([\n    61\t    \"user_prompt\",\n    62\t    \"assistant_text\",\n    63\t    \"tool_call\",\n    64\t    \"tool_result\",\n    65\t    \"turn_end\",\n    66\t  ]);\n    67\t}\n    68\t\n    69\texport interface TempStore {\n    70\t  dir: string;\n    71\t  registryPath: string;\n    72\t  threadPath: (name?: string) => string;\n    73\t  cleanup: () => void;\n    74\t}\n    75\t\n    76\texport function tempStore(): TempStore {\n    77\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n    78\t  let threadCounter = 0;\n    79\t  return {\n    80\t    dir,\n    81\t    registryPath: join(dir, \"registry.sqlite\"),\n    82\t    threadPath: (name) => {\n    83\t      threadCounter += 1;\n    84\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    85\t    },\n    86\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n    87\t  };\n    88\t}\n    89\t\n    90\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n    91\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n    92\texport function openRaw(path: string): DatabaseSync {\n    93\t  return openDatabase(path);\n    94\t}\n    95\t\n    96\texport {\n    97\t  corruptTwoOpenTurns,\n    98\t  poisonMessageBlockJson,\n    99\t  poisonMessageFormJson,\n   100\t} from \"./corrupt.js\";\n   101\texport { assertSweepReceiptShape } from \"./receipt-schema.js\";\n   102\texport { assertPiSessionConformance, loadPiSessionFixture } from \"./pi-session-format.js\";\n   103\t// The sweep's classification table, re-exported for the Story 3 unit legs:\n   104\t// fixtures are the one sanctioned bridge across the no-internal-imports\n   105\t// boundary (check-boundaries exempts test/fixtures/ by design), and the\n   106\t// table is exported from sweep.ts for tests by story contract.\n   107\texport {\n   108\t  classifyFailureReason,\n   109\t  REASON_CLASS_TABLE,\n   110\t  type ReasonClass,\n   111\t} from \"../../src/domains/thread-view/internal/sweep.js\";\n   112\texport {\n   113\t  legacyEpic01ThreadFile,\n   114\t  legacyEpic02ThreadFile,\n   115\t  legacyStory2ThreadFile,\n   116\t  schemaVersionOf,\n   117\t  type LegacyRecordedEvent,\n   118\t} from \"./legacy.js\";\n   119\texport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\n   120\texport {\n   121\t  createProviderDouble,\n   122\t  ProviderDouble,\n   123\t  type CapturedInput,\n   124\t  type ProviderOpName,\n   125\t} from \"./provider-double.js\";\n   126\texport {\n   127\t  registerTestWorkHandlers,\n   128\t  testWorkHandlers,\n   129\t  type TestHandlerHooks,\n   130\t} from \"./work-handlers.js\";\n   131\texport {\n   132\t  boundaryTokens,\n   133\t  boundaryToolRun,\n   134\t  seedTurnedToolResults,\n   135\t  turnedToolResultEvents,\n   136\t  type TurnedToolResultsSpec,\n   137\t} from \"./view-boundary.js\";\n   138\texport {\n   139\t  fireViewInjection,\n   140\t  seedViewBoundary,\n   141\t  setViewInjectionHook,\n   142\t  type ViewInjectionHook,\n   143\t  type ViewInjectionPoint,\n   144\t} from \"./view-seam.js\";\n   145\texport {\n   146\t  blockedSiblingThread,\n   147\t  corruptedVariantThread,\n   148\t  derivedThreadFixture,\n   149\t  mixedStateVariantThread,\n   150\t  mutationInFlightVariant,\n   151\t  PERMANENT_FAILURE_REASON,\n   152\t  stragglerVariantThread,\n   153\t  TRANSIENT_EXHAUST_REASON,\n   154\t  type DerivedThreadFixture,\n   155\t  type DerivedThreadOptions,\n   156\t  type MixedStateFixture,\n   157\t  type MutationInFlightFixture,\n   158\t} from \"./view-thread.js\";\n   159\texport {\n   160\t  expectReadOnly,\n   161\t  observableState,\n   162\t  type ObservableState,\n   163\t} from \"./read-only-delta.js\";\n   164\texport {\n   165\t  createLifecycleSdk,\n   166\t  DELETE_TARGET,\n   167\t  DELETED_MESSAGE_TEXT,\n   168\t  EDIT_TARGET,\n   169\t  EDITED_MESSAGE_TEXT,\n   170\t  LIFECYCLE_PROFILE,\n   171\t  runLifecycle,\n   172\t  type LifecycleCheckpoint,\n   173\t  type LifecycleOptions,\n   174\t  type LifecyclePhases,\n   175\t  type LifecycleRun,\n   176\t} from \"./lifecycle.js\";\n   177\texport {\n   178\t  cannedResponses,\n   179\t  FAKE_MODEL_PREFIX,\n   180\t  FAKE_PROVIDER_PREFIX,\n   181\t  DERIVATION_TYPES,\n   182\t  type DerivationType,\n   183\t  hangingCall,\n   184\t  recordingCall,\n   185\t  scriptedCall,\n   186\t  throwingCall,\n   187\t  validAssignments,\n   188\t} from \"./model-call.js\";\n   189\texport {\n   190\t  assertModelCallContract,\n   191\t  assertRoutingThroughSdk,\n   192\t  probeInput,\n   193\t  type RoutingRunResult,\n   194\t} from \"./seam-conformance.js\";\n   195\texport {\n   196\t  createOpenRouterCall,\n   197\t  DEFAULT_OPENROUTER_MODEL,\n   198\t  emitRealSuiteAccounting,\n   199\t  OPENROUTER_ENDPOINT,\n   200\t  realSuiteAccountingEmissions,\n   201\t  resolveRealSuiteEnv,\n   202\t  type RealSuiteEnv,\n   203\t} from \"./openrouter-call.js\";\n   204\texport {\n   205\t  damagedSourceThread,\n   206\t  GAPPED_SMOOTHING_REASON,\n   207\t  gappedRenderingThread,\n   208\t  multiStateThread,\n   209\t  readChunks,\n   210\t  readDerivedForms,\n   211\t  setFormState,\n   212\t  threadWithClosedTurns,\n   213\t  threadWithToolRun,\n   214\t  type ChunkSnapshot,\n   215\t  type MultiStateClaim,\n   216\t} from \"./threads.js\";\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/view.ts'","aggregated_output":"     1\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n     2\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n     3\t// domain owns the behavior, this module owns only the shapes.\n     4\t\n     5\texport type Band = \"brief\" | \"detailed\" | \"smooth\";\n     6\t\n     7\texport interface ViewProfile {\n     8\t  name: string;\n     9\t  // Target assembled size; whole-entry fills may land under or over (epic\n    10\t  // Data Contracts — the bound is a target, not a cap).\n    11\t  lowerBound: number;\n    12\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n    13\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n    14\t}\n    15\t\n    16\t// A user profile entry as configured: a full profile under a new name, or a\n    17\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n    18\t// whose name matches no built-in has nothing to merge over and is rejected at\n    19\t// construction (FC-0.2's unknown-override violation).\n    20\texport interface ViewProfileOverride {\n    21\t  name: string;\n    22\t  lowerBound?: number;\n    23\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n    24\t}\n    25\t\n    26\t// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\n    27\t// base profile, down to single band percentages — the same depth the CLI's\n    28\t// per-band flags override at. A nested-partial deepening of the tech\n    29\t// design's `Partial<ViewProfile>` sketch, which could not express a\n    30\t// single-band override.\n    31\texport interface ViewCompactParams {\n    32\t  lowerBound?: number;\n    33\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n    34\t}\n    35\t\n    36\t// Visibility-boundary budgets (Epic 03 AC-4.x as patched by Epic 05 AC-5.4):\n    37\t// max > target, both positive. The floor budget is retired — its job is done\n    38\t// structurally by the turn-end trigger (the open turn is untouchable) and the\n    39\t// never-evicted newest closed turn (Epic 05 DD-11).\n    40\texport interface VisibilityBudgets {\n    41\t  maxTokens: number;\n    42\t  targetTokens: number;\n    43\t}\n    44\t\n    45\t// ── SDK assembly config (validated at construction, throws on nonsense\n    46\t// per the Epic 02 rule) ───────────────────────────────────────────\n    47\texport interface SdkViewConfig {\n    48\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n    49\t  visibility?: Partial<VisibilityBudgets>; // defaults: 64000 / 32000\n    50\t  compactThreshold?: number; // status trigger; default 160000\n    51\t}\n    52\t\n    53\t// Every optional filled by createSdk's central defaults; profiles resolved\n    54\t// to complete, validated entries keyed by name.\n    55\texport interface ResolvedViewConfig {\n    56\t  profiles: Readonly<Record<string, ViewProfile>>;\n    57\t  visibility: VisibilityBudgets;\n    58\t  compactThreshold: number;\n    59\t}\n    60\t\n    61\t// ── pull / status shapes (the product crossing to the harness) ────\n    62\t//\n    63\t// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\n    64\t// messages first — one `user` message per non-empty band, gradient order\n    65\t// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\n    66\t// the tail in record order. Tail messages render by the message-kind mapping\n    67\t// table (tech design §Tail message rendering), the contract every later\n    68\t// story renders into:\n    69\t//\n    70\t//   | Message kind                       | Role      | Content shape |\n    71\t//   |------------------------------------|-----------|---------------|\n    72\t//   | user_prompt                        | user      | text verbatim |\n    73\t//   | assistant_text                     | assistant | text verbatim |\n    74\t//   | assistant_thinking                 | assistant | fenced: `[thinking]\\n<text>\\n[/thinking]` — included (the tail is full fidelity) |\n    75\t//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\n    76\t//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\n<full content>` |\n    77\t//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\n<summary or deterministic truncation>` (short-form ladder) |\n    78\t//   | runtime_note                       | user      | `[runtime note] <text>` |\n    79\texport interface ViewMessage {\n    80\t  role: \"user\" | \"assistant\";\n    81\t  content: string;\n    82\t  band?: Band; // band absent ⇒ tail\n    83\t}\n    84\t\n    85\texport interface ViewMeta {\n    86\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n    87\t  coveredFrom: number | null;\n    88\t  boundaryPosition: number;\n    89\t  gapCount: number;\n    90\t  degradedCount: number;\n    91\t  viewId: string | null;\n    92\t  createdAt: string | null;\n    93\t}\n    94\t\n    95\texport interface PullResult {\n    96\t  messages: ViewMessage[];\n    97\t  meta: ViewMeta;\n    98\t}\n    99\t\n   100\t// The stored active view row as `threadView.describe` exposes it (Epic 04\n   101\t// Story 3): the snapshot verbatim — arrangement, gaps, config, source-state\n   102\t// provenance, per-band stored token counts — never recomputed, never\n   103\t// repaired. Absent view ⇒ describe returns ok/null, mirroring status's\n   104\t// never-compacted behavior (DD-1).\n   105\texport interface StoredView {\n   106\t  viewId: string;\n   107\t  createdAt: string;\n   108\t  compactPoint: number;\n   109\t  coveredFrom: number;\n   110\t  // null when explicit params overrode a named base at compact (the stored\n   111\t  // config carries the resolved truth either way).\n   112\t  profileName: string | null;\n   113\t  config: { lowerBound: number; percentages: Record<string, number> };\n   114\t  // Every selected entry in served order, gap entries included (they are\n   115\t  // arrangement rows too; `gaps` carries their reasons).\n   116\t  arrangement: Array<{\n   117\t    band: Band;\n   118\t    subjectKind: \"chunk\" | \"turn\";\n   119\t    subjectId: string;\n   120\t    derivationUsed: string;\n   121\t    degraded: boolean;\n   122\t  }>;\n   123\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n   124\t  // What the compact saw (AC-2.5 provenance, stored verbatim).\n   125\t  sourceState: { maxEventOrder: number; derivationCounts: Record<string, number> };\n   126\t  // Non-empty bands in gradient order with their stored token counts.\n   127\t  bands: Array<{ band: Band; storedTokens: number }>;\n   128\t}\n   129\t\n   130\texport interface ViewStatus {\n   131\t  tailTokens: number;\n   132\t  threshold: number;\n   133\t  compactRecommended: boolean;\n   134\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n   135\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n   136\t  visibility: { zoneTokens: number; maxTokens: number };\n   137\t}\n   138\t\n   139\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n   140\texport interface CompactReceipt {\n   141\t  viewId: string;\n   142\t  profile: string | null;\n   143\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n   144\t  bands: Record<Band, { entries: number; tokens: number }>;\n   145\t  tailTokens: number;\n   146\t  // The assembled view's actual total (band tokens + tail tokens) against\n   147\t  // the configured lower bound — a target, not a cap: whole-entry fills may\n   148\t  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n   149\t  totalTokens: number;\n   150\t  coveredFrom: number;\n   151\t  compactPoint: number;\n   152\t  degraded: Array<{ band: Band; subjectId: string; usedDerivation: string }>;\n   153\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n   154\t  // The embedded sweep's receipt (AC-3.6): the sweep runs first by default\n   155\t  // and its full receipt embeds here; `sweep: false` records the skip — the\n   156\t  // receipt always says whether the sweep ran (Story 3 closed Story 2's\n   157\t  // \"absent\" placeholder).\n   158\t  sweep: SweepReceipt | { skipped: true };\n   159\t}\n   160\t\n   161\texport interface SweepReceipt {\n   162\t  owners: Array<{\n   163\t    owner: \"messages\" | \"turns\";\n   164\t    kind: string;\n   165\t    ready: number;\n   166\t    inFlight: number;\n   167\t    requeued: string[]; // subject ids\n   168\t    blocked: Array<{ subjectId: string; reason: string }>;\n   169\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\n   170\t  }>;\n   171\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/threads/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runWithThreadTouchSuppressed } from \"../../shared/context.js\";\n     3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     4\timport {\n     5\t  createThreadFile,\n     6\t  deleteThreadFile,\n     7\t  generateThreadId,\n     8\t  openThreadDatabase,\n     9\t} from \"./internal/create.js\";\n    10\t\n    11\t// Re-exported for the other domain surfaces: opening a thread file through\n    12\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n    13\t// file gains the message tables here before any write or read touches them).\n    14\texport { openThreadDatabase };\n    15\timport {\n    16\t  insertThreadRow,\n    17\t  openRegistryForRead,\n    18\t  openRegistryForWrite,\n    19\t  resolveRegistryPath,\n    20\t  selectAllThreadRows,\n    21\t  selectThreadRow,\n    22\t  selectThreadRowsByPrefix,\n    23\t  type RegistryRow,\n    24\t} from \"./internal/registry.js\";\n    25\t\n    26\texport type ThreadRef =\n    27\t  | { threadId: string; registryPath?: string }\n    28\t  | { filePath: string };\n    29\t\n    30\texport interface NewThreadInput {\n    31\t  filePath: string;\n    32\t  title?: string;\n    33\t  cwd?: string;\n    34\t  registryPath?: string;\n    35\t}\n    36\t\n    37\texport interface ThreadInfo {\n    38\t  threadId: string;\n    39\t  filePath: string;\n    40\t  title?: string;\n    41\t  cwd?: string;\n    42\t  createdAt: string; // ISO-8601\n    43\t}\n    44\t\n    45\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n    46\t  const info: ThreadInfo = {\n    47\t    threadId: row.threadId,\n    48\t    filePath: row.filePath,\n    49\t    createdAt: row.createdAt,\n    50\t  };\n    51\t  if (row.title !== undefined) info.title = row.title;\n    52\t  if (row.cwd !== undefined) info.cwd = row.cwd;\n    53\t  return info;\n    54\t}\n    55\t\n    56\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n    57\t  return {\n    58\t    ok: false,\n    59\t    error: {\n    60\t      errorClass: \"caller_error\",\n    61\t      code: \"thread_not_found\",\n    62\t      reason: `no thread registered with id ${threadId}`,\n    63\t    },\n    64\t  };\n    65\t}\n    66\t\n    67\t// A partial id that matches more than one thread is a caller error, not a\n    68\t// silent pick: resolution names the collision and the caller must disambiguate\n    69\t// (AC-1.6 — an ambiguous id fails loud, never resolves arbitrarily).\n    70\tfunction ambiguousThreadId(\n    71\t  prefix: string,\n    72\t  matchIds: readonly string[],\n    73\t): { ok: false; error: ErrorResult } {\n    74\t  return {\n    75\t    ok: false,\n    76\t    error: {\n    77\t      errorClass: \"caller_error\",\n    78\t      code: \"ambiguous_thread_id\",\n    79\t      reason: `thread id \"${prefix}\" is ambiguous: it matches ${matchIds.length} threads (${matchIds.join(\", \")}); use a longer id`,\n    80\t    },\n    81\t  };\n    82\t}\n    83\t\n    84\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n    85\t  return {\n    86\t    ok: false,\n    87\t    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n    88\t  };\n    89\t}\n    90\t\n    91\t// A file path that is empty or whitespace-only cannot name a durable file:\n    92\t// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n    93\t// close, so such a path must be refused as a caller error before any storage\n    94\t// is touched rather than silently producing a thread with no durable file.\n    95\tfunction isBlankPath(filePath: string): boolean {\n    96\t  return filePath.trim() === \"\";\n    97\t}\n    98\t\n    99\tfunction detail(cause: unknown): string {\n   100\t  return cause instanceof Error ? cause.message : String(cause);\n   101\t}\n   102\t\n   103\t// Creation spans two databases that cannot share a transaction. Order is\n   104\t// file-then-row with compensation: the invariant \"no registry row without\n   105\t// its file\" is absolute; an orphan file from a crash between the writes is\n   106\t// documented harmless (design decision 2).\n   107\texport async function newThread(\n   108\t  input: NewThreadInput,\n   109\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n   110\t  // Guard before any storage touch: an empty/blank path would otherwise open\n   111\t  // a temp database and register a thread with no durable file (the no-row-\n   112\t  // without-file invariant below depends on the path naming a real file).\n   113\t  if (isBlankPath(input.filePath)) {\n   114\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n   115\t  }\n   116\t  if (existsSync(input.filePath)) {\n   117\t    return {\n   118\t      ok: false,\n   119\t      error: {\n   120\t        errorClass: \"caller_error\",\n   121\t        code: \"path_exists\",\n   122\t        reason: `a file already exists at ${input.filePath}`,\n   123\t      },\n   124\t    };\n   125\t  }\n   126\t\n   127\t  const threadId = generateThreadId();\n   128\t  const createdAt = new Date().toISOString();\n   129\t\n   130\t  try {\n   131\t    createThreadFile(input.filePath, threadId, createdAt);\n   132\t  } catch (cause) {\n   133\t    deleteThreadFile(input.filePath);\n   134\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n   135\t  }\n   136\t\n   137\t  let registry;\n   138\t  try {\n   139\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n   140\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n   141\t    if (input.title !== undefined) row.title = input.title;\n   142\t    if (input.cwd !== undefined) row.cwd = input.cwd;\n   143\t    insertThreadRow(registry, row);\n   144\t  } catch (cause) {\n   145\t    deleteThreadFile(input.filePath);\n   146\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n   147\t  } finally {\n   148\t    registry?.close();\n   149\t  }\n   150\t\n   151\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n   152\t}\n   153\t\n   154\t// Resolution accepts a full or partial (prefix) thread id (A-8). An exact id\n   155\t// wins outright — a full id always resolves to itself, even if it is also a\n   156\t// prefix of a longer id — so only a genuinely partial id ever consults the\n   157\t// prefix path; that path resolves a unique prefix, fails ambiguous on more than\n   158\t// one match, and fails not-found on none. No path ever creates a thread.\n   159\texport async function resolve(input: {\n   160\t  threadId: string;\n   161\t  registryPath?: string;\n   162\t}): Promise<OpResult<ThreadInfo>> {\n   163\t  let registry;\n   164\t  try {\n   165\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n   166\t    if (registry === null) return threadNotFound(input.threadId);\n   167\t    const exact = selectThreadRow(registry, input.threadId);\n   168\t    if (exact !== undefined) return { ok: true, value: toThreadInfo(exact) };\n   169\t    const matches = selectThreadRowsByPrefix(registry, input.threadId);\n   170\t    if (matches.length === 1) return { ok: true, value: toThreadInfo(matches[0]!) };\n   171\t    if (matches.length > 1) {\n   172\t      return ambiguousThreadId(\n   173\t        input.threadId,\n   174\t        matches.map((m) => m.threadId),\n   175\t      );\n   176\t    }\n   177\t    return threadNotFound(input.threadId);\n   178\t  } catch (cause) {\n   179\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   180\t  } finally {\n   181\t    registry?.close();\n   182\t  }\n   183\t}\n   184\t\n   185\texport async function listThreads(input?: {\n   186\t  cwd?: string;\n   187\t  registryPath?: string;\n   188\t}): Promise<OpResult<ThreadInfo[]>> {\n   189\t  let registry;\n   190\t  try {\n   191\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n   192\t    if (registry === null) return { ok: true, value: [] };\n   193\t    const opts = input?.cwd === undefined ? {} : { cwd: input.cwd };\n   194\t    return { ok: true, value: selectAllThreadRows(registry, opts).map(toThreadInfo) };\n   195\t  } catch (cause) {\n   196\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   197\t  } finally {\n   198\t    registry?.close();\n   199\t  }\n   200\t}\n   201\t\n   202\t// The thread file's own identity header (Epic 04): thread_metadata is this\n   203\t// domain's table — creation writes it (internal/create.ts) and only this\n   204\t// surface reads it back. Added for inspect's overview, which must report\n   205\t// thread identity for ANY resolvable ref — including a { filePath } ref that\n   206\t// no registry knows — without reading tables itself (inspect's must-not-own\n   207\t// rule). A pure read: the whole operation runs touch-suppressed (DD-6), so a\n   208\t// background SDK can never hang a first-touch catch-up drain off it.\n   209\texport interface ThreadFileInfo {\n   210\t  threadId: string;\n   211\t  createdAt: string;\n   212\t}\n   213\t\n   214\texport async function info(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\n   215\t  return runWithThreadTouchSuppressed(() => infoInner(ref));\n   216\t}\n   217\t\n   218\tasync function infoInner(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\n   219\t  const resolved = await resolveThreadRef(ref);\n   220\t  if (!resolved.ok) return resolved;\n   221\t  const { filePath } = resolved.value;\n   222\t  if (!existsSync(filePath)) {\n   223\t    return {\n   224\t      ok: false,\n   225\t      error: {\n   226\t        errorClass: \"caller_error\",\n   227\t        code: \"thread_not_found\",\n   228\t        reason: `no thread file exists at ${filePath}`,\n   229\t      },\n   230\t    };\n   231\t  }\n   232\t  const opened = openThreadDatabase(filePath);\n   233\t  if (!opened.ok) return opened;\n   234\t  const db = opened.value;\n   235\t  try {\n   236\t    const row = db\n   237\t      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n   238\t      .get() as { thread_id: string; created_at: string } | undefined;\n   239\t    if (row === undefined) {\n   240\t      // openThreadDatabase validated the row exists; its absence here is\n   241\t      // external interference between the probe and this read.\n   242\t      return storageFailure(`thread file at ${filePath} lost its metadata row`);\n   243\t    }\n   244\t    return { ok: true, value: { threadId: row.thread_id, createdAt: row.created_at } };\n   245\t  } catch (cause) {\n   246\t    return storageFailure(`thread info read failed: ${detail(cause)}`);\n   247\t  } finally {\n   248\t    db.close();\n   249\t  }\n   250\t}\n   251\t\n   252\t// The single interpreter of thread references: { threadId } resolves to a\n   253\t// path through the registry, { filePath } passes through untouched. No other\n   254\t// code ever reads a thread reference.\n   255\texport async function resolveThreadRef(\n   256\t  ref: ThreadRef,\n   257\t): Promise<OpResult<{ filePath: string }>> {\n   258\t  if (\"threadId\" in ref) {\n   259\t    const resolved = await resolve(ref);\n   260\t    if (!resolved.ok) return resolved;\n   261\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n   262\t  }\n   263\t  // Mirror newThread's guard so every read surface that routes through here\n   264\t  // fails closed on a blank path instead of opening a temp database.\n   265\t  if (isBlankPath(ref.filePath)) {\n   266\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n   267\t  }\n   268\t  return { ok: true, value: { filePath: ref.filePath } };\n   269\t}\n","exit_code":0,"status":"completed"}}

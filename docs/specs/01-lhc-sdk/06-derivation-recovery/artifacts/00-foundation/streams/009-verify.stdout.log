{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/thread-view/index.ts'","aggregated_output":"     1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize;\n     2\t// Epic 04 Story 3 adds describe (the stored-snapshot read inspect composes).\n     3\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n     4\t// deterministic string assembly only, no inference, no network, no queue\n     5\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n     6\t// Story 3 landed `sweep` (standalone and embedded default-on in compact);\n     7\t// Story 5 lands `materialize` (the PI session-file render target over the\n     8\t// same pull assembly). Story 0's substrate (profile resolution, consumed by\n     9\t// createSdk) re-exports at the bottom.\n    10\timport { existsSync } from \"node:fs\";\n    11\timport * as path from \"node:path\";\n    12\timport {\n    13\t  resolveInstanceViewConfig,\n    14\t  runWithThreadTouchSuppressed,\n    15\t  type OperationContext,\n    16\t} from \"../../shared/context.js\";\n    17\timport type { DerivationReportEntry } from \"../../shared/derivation.js\";\n    18\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n    19\timport type {\n    20\t  CompactReceipt,\n    21\t  PullResult,\n    22\t  ResolvedViewConfig,\n    23\t  StoredView,\n    24\t  SweepReceipt,\n    25\t  ViewCompactParams,\n    26\t  ViewMessage,\n    27\t  ViewProfile,\n    28\t  ViewStatus,\n    29\t} from \"../../shared/view.js\";\n    30\timport * as messagesDomain from \"../messages/index.js\";\n    31\timport * as turnsDomain from \"../turns/index.js\";\n    32\timport {\n    33\t  openThreadDatabase,\n    34\t  resolveThreadRef,\n    35\t  type ThreadRef,\n    36\t} from \"../threads/index.js\";\n    37\timport {\n    38\t  executeBoundaryAdvance,\n    39\t  readBoundaryPosition,\n    40\t  visibilityZoneTokens,\n    41\t} from \"./internal/boundary.js\";\n    42\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n    43\timport {\n    44\t  assembleBandText,\n    45\t  renderBandMessage,\n    46\t  renderTailMessage,\n    47\t  toolNamesByCallId,\n    48\t} from \"./internal/render.js\";\n    49\timport { fireViewInjection } from \"./internal/seam.js\";\n    50\timport {\n    51\t  CanonicalCorruptionError,\n    52\t  readSelectionInputs,\n    53\t  selectArrangement,\n    54\t  type ArrangementEntry,\n    55\t} from \"./internal/select.js\";\n    56\timport { writePiSessionFile, type MaterializeInput } from \"./internal/materialize.js\";\n    57\timport {\n    58\t  readReadyToolResultSummaries,\n    59\t  readStoredView,\n    60\t  readTailMessages,\n    61\t  readThreadMetadata,\n    62\t  readViewSnapshot,\n    63\t  replaceViewSnapshot,\n    64\t  tailTokenSum,\n    65\t} from \"./internal/snapshot.js\";\n    66\timport { runSweep } from \"./internal/sweep.js\";\n    67\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n    68\timport type { Band } from \"../../shared/view.js\";\n    69\t\n    70\t// Config resolution for the operation in hand: the SDK instance's resolved\n    71\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n    72\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n    73\t// through the same one resolution path createSdk uses.\n    74\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n    75\t\n    76\tfunction viewConfig(): ResolvedViewConfig {\n    77\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n    78\t}\n    79\t\n    80\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    81\t  return {\n    82\t    ok: false,\n    83\t    error: {\n    84\t      errorClass: \"caller_error\",\n    85\t      code: \"thread_not_found\",\n    86\t      reason: `no thread file exists at ${filePath}`,\n    87\t    },\n    88\t  };\n    89\t}\n    90\t\n    91\tfunction detail(cause: unknown): string {\n    92\t  return cause instanceof Error ? cause.message : String(cause);\n    93\t}\n    94\t\n    95\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n    96\t\n    97\t// The hot-path read: view header + bands (if any), tail messages after the\n    98\t// compact point (deleted-filtered, record order), boundary position; then\n    99\t// format — band messages first, tail per the mapping table, tool results\n   100\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n   101\t// tail from event 1 (AC-1.3) through this same code path with the compact\n   102\t// point at its zero origin — snapshot-absent, never a separate branch.\n   103\t//\n   104\t// Reads-only is structural, not disciplined: the whole operation runs in the\n   105\t// touch-suppressed scope, so the open announcement that would let a\n   106\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n   107\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n   108\t// AC-1.1's no-queue-interaction holds in both host modes.\n   109\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   110\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n   111\t}\n   112\t\n   113\t// The one assembly both render targets consume (Story 5): pull serves the\n   114\t// messages; materialize serves the same entries with the metadata the file's\n   115\t// generated fields derive from (entry ids, record-time timestamps). Sharing\n   116\t// the array is what makes AC-5.3's parity structural — materialize cannot\n   117\t// diverge from pull because there is no second assembly to diverge.\n   118\tinterface AssembledView {\n   119\t  entries: Array<{ message: ViewMessage; entryId: string; timestamp: string }>;\n   120\t  meta: PullResult[\"meta\"];\n   121\t  snapshot: ReturnType<typeof readViewSnapshot>;\n   122\t}\n   123\t\n   124\tfunction assembleView(db: Parameters<typeof readViewSnapshot>[0]): AssembledView {\n   125\t  const snapshot = readViewSnapshot(db);\n   126\t  const compactPoint = snapshot?.compactPoint ?? 0;\n   127\t  const boundaryPosition = readBoundaryPosition(db);\n   128\t  const tailRows = readTailMessages(db, compactPoint);\n   129\t  const renderCtx = {\n   130\t    boundaryPosition,\n   131\t    toolNameByCallId: toolNamesByCallId(tailRows),\n   132\t    toolResultSummaries: readReadyToolResultSummaries(db),\n   133\t  };\n   134\t\n   135\t  const entries: AssembledView[\"entries\"] = [];\n   136\t  if (snapshot !== null) {\n   137\t    for (const band of snapshot.bands) {\n   138\t      entries.push({\n   139\t        message: renderBandMessage(band.band, band.renderedText),\n   140\t        // Band entries are not record messages; their generated fields\n   141\t        // derive from view metadata (AC-5.2).\n   142\t        entryId: `${snapshot.viewId}-${band.band}`,\n   143\t        timestamp: snapshot.createdAt,\n   144\t      });\n   145\t    }\n   146\t  }\n   147\t  for (const row of tailRows) {\n   148\t    entries.push({\n   149\t      message: renderTailMessage(row, renderCtx),\n   150\t      entryId: row.messageId,\n   151\t      timestamp: row.recordedAt,\n   152\t    });\n   153\t  }\n   154\t\n   155\t  return {\n   156\t    entries,\n   157\t    meta: {\n   158\t      compactPoint: snapshot?.compactPoint ?? null,\n   159\t      coveredFrom: snapshot?.coveredFrom ?? null,\n   160\t      boundaryPosition,\n   161\t      gapCount: snapshot?.gapCount ?? 0,\n   162\t      degradedCount: snapshot?.degradedCount ?? 0,\n   163\t      viewId: snapshot?.viewId ?? null,\n   164\t      createdAt: snapshot?.createdAt ?? null,\n   165\t    },\n   166\t    snapshot,\n   167\t  };\n   168\t}\n   169\t\n   170\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   171\t  const resolved = await resolveThreadRef(ref);\n   172\t  if (!resolved.ok) return resolved;\n   173\t  const { filePath } = resolved.value;\n   174\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   175\t\n   176\t  const opened = openThreadDatabase(filePath);\n   177\t  if (!opened.ok) return opened;\n   178\t  const db = opened.value;\n   179\t  try {\n   180\t    const assembled = assembleView(db);\n   181\t    return {\n   182\t      ok: true,\n   183\t      value: {\n   184\t        messages: assembled.entries.map((entry) => entry.message),\n   185\t        meta: assembled.meta,\n   186\t      },\n   187\t    };\n   188\t  } catch (cause) {\n   189\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n   190\t  } finally {\n   191\t    db.close();\n   192\t  }\n   193\t}\n   194\t\n   195\t// ── status (AC-2.8) ───────────────────────────────────────────────\n   196\t\n   197\t// Derivation counts bucket from one report entry the way the report's own\n   198\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n   199\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n   200\t// forms are healthy and not an operational situation.\n   201\tfunction bucketDerivation(\n   202\t  entries: readonly DerivationReportEntry[],\n   203\t  counts: ViewStatus[\"derivation\"],\n   204\t): void {\n   205\t  for (const entry of entries) {\n   206\t    switch (entry.state) {\n   207\t      case \"pending\":\n   208\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n   209\t        else counts.pending += 1;\n   210\t        break;\n   211\t      case \"failed\":\n   212\t        counts.failed += 1;\n   213\t        break;\n   214\t      case \"blocked\":\n   215\t        counts.blocked += 1;\n   216\t        break;\n   217\t      case \"ready\":\n   218\t        break;\n   219\t    }\n   220\t  }\n   221\t}\n   222\t\n   223\t// Reads only, callable any time, no side effects: tail size against the\n   224\t// configured trigger threshold with a compact recommendation (`tailTokens >\n   225\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n   226\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n   227\t// direct derivation read here), the active view's health or null\n   228\t// pre-compact, and the visibility zone's sum against its max — computed live\n   229\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n   230\t// structural, not stored.\n   231\t//\n   232\t// Like pull, the whole read — including the owners' report surfaces it\n   233\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n   234\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n   235\t// host modes).\n   236\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   237\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n   238\t}\n   239\t\n   240\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   241\t  const resolved = await resolveThreadRef(ref);\n   242\t  if (!resolved.ok) return resolved;\n   243\t  const { filePath } = resolved.value;\n   244\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   245\t\n   246\t  const config = viewConfig();\n   247\t  const opened = openThreadDatabase(filePath);\n   248\t  if (!opened.ok) return opened;\n   249\t  const db = opened.value;\n   250\t  let tailTokens: number;\n   251\t  let zoneTokens: number;\n   252\t  let view: ViewStatus[\"view\"];\n   253\t  try {\n   254\t    const snapshot = readViewSnapshot(db);\n   255\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   256\t    const boundaryPosition = readBoundaryPosition(db);\n   257\t    tailTokens = tailTokenSum(db, compactPoint);\n   258\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n   259\t    view =\n   260\t      snapshot === null\n   261\t        ? null\n   262\t        : {\n   263\t            degraded: snapshot.degradedCount,\n   264\t            gaps: snapshot.gapCount,\n   265\t            builtAt: snapshot.createdAt,\n   266\t          };\n   267\t  } catch (cause) {\n   268\t    return storageFailure(`view status failed: ${detail(cause)}`);\n   269\t  } finally {\n   270\t    db.close();\n   271\t  }\n   272\t\n   273\t  // The owners' report surfaces open their own handles; ours is closed first\n   274\t  // so the status read never holds two handles on one thread file.\n   275\t  const messageReport = await messagesDomain.report({ filePath });\n   276\t  if (!messageReport.ok) return messageReport;\n   277\t  const turnReport = await turnsDomain.report({ filePath });\n   278\t  if (!turnReport.ok) return turnReport;\n   279\t  const derivation: ViewStatus[\"derivation\"] = {\n   280\t    pending: 0,\n   281\t    retrying: 0,\n   282\t    failed: 0,\n   283\t    blocked: 0,\n   284\t  };\n   285\t  bucketDerivation(messageReport.value, derivation);\n   286\t  bucketDerivation(turnReport.value, derivation);\n   287\t\n   288\t  return {\n   289\t    ok: true,\n   290\t    value: {\n   291\t      tailTokens,\n   292\t      threshold: config.compactThreshold,\n   293\t      compactRecommended: tailTokens > config.compactThreshold,\n   294\t      derivation,\n   295\t      view,\n   296\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n   297\t    },\n   298\t  };\n   299\t}\n   300\t\n   301\t// ── describe (Epic 04 Story 3: AC-2.1, AC-2.5) ───────────────────\n   302\t\n   303\t// The stored active view row, exposed read-only so inspect never reads\n   304\t// thread-view tables directly (DD-1). Everything is the snapshot verbatim —\n   305\t// arrangement, gaps, config, source-state provenance, per-band stored token\n   306\t// counts; nothing is recomputed, repaired, or read from the record. Absent\n   307\t// view ⇒ ok with null, mirroring status's never-compacted behavior. Like the\n   308\t// other reads, the whole operation runs touch-suppressed: a background SDK's\n   309\t// describe can never schedule a catch-up drain.\n   310\texport async function describe(ref: ThreadRef): Promise<OpResult<StoredView | null>> {\n   311\t  return runWithThreadTouchSuppressed(() => describeInner(ref));\n   312\t}\n   313\t\n   314\tasync function describeInner(ref: ThreadRef): Promise<OpResult<StoredView | null>> {\n   315\t  const resolved = await resolveThreadRef(ref);\n   316\t  if (!resolved.ok) return resolved;\n   317\t  const { filePath } = resolved.value;\n   318\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   319\t\n   320\t  const opened = openThreadDatabase(filePath);\n   321\t  if (!opened.ok) return opened;\n   322\t  const db = opened.value;\n   323\t  try {\n   324\t    return { ok: true, value: readStoredView(db) };\n   325\t  } catch (cause) {\n   326\t    return storageFailure(`view describe failed: ${detail(cause)}`);\n   327\t  } finally {\n   328\t    db.close();\n   329\t  }\n   330\t}\n   331\t\n   332\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n   333\t\n   334\t// The default base when no profile is named: the first built-in, matching\n   335\t// the epic's primary user (the PI continuation harness). Explicit params\n   336\t// override the base field-wise (AC-2.2).\n   337\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n   338\t\n   339\tfunction callerError(\n   340\t  code: \"unknown_profile\" | \"invalid_view_config\",\n   341\t  reason: string,\n   342\t): { ok: false; error: ErrorResult } {\n   343\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n   344\t}\n   345\t\n   346\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n   347\t\n   348\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n   349\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n   350\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n   351\t// skips (AC-3.6; the receipt records which) → read record + derivations with the\n   352\t// corruption check in the reads (pre-transaction, prior view trivially\n   353\t// intact on refusal) → selection walk → band rendering → one BEGIN\n   354\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\n   355\t// Assembly is entirely from stored artifacts: nothing here can reach a\n   356\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n   357\t// through owners' requeue surfaces and calls no provider either).\n   358\texport async function compact(\n   359\t  ref: ThreadRef,\n   360\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   361\t): Promise<OpResult<CompactReceipt>> {\n   362\t  const resolved = await resolveThreadRef(ref);\n   363\t  if (!resolved.ok) return resolved;\n   364\t  const { filePath } = resolved.value;\n   365\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   366\t\n   367\t  const config = viewConfig();\n   368\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n   369\t  const base = config.profiles[baseName];\n   370\t  if (base === undefined) {\n   371\t    return callerError(\n   372\t      \"unknown_profile\",\n   373\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n   374\t        .map((name) => `\"${name}\"`)\n   375\t        .join(\", \")}`,\n   376\t    );\n   377\t  }\n   378\t  const merged: ViewProfile = {\n   379\t    name: base.name,\n   380\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n   381\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n   382\t  };\n   383\t  const violation = profileViolation(merged);\n   384\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n   385\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n   386\t  // any param override means the config is no longer a named profile's mix,\n   387\t  // even when one served as the merge base; the receipt's config carries the\n   388\t  // resolved truth. A bare or profile-only call names its profile.\n   389\t  const profileName = opts.params === undefined ? baseName : null;\n   390\t\n   391\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n   392\t  // leaves the thread healthier than it found it; `sweep: false` skips with\n   393\t  // the skip recorded in the receipt. Runs before this operation opens its\n   394\t  // own handle (the owners' surfaces open theirs), and before any view\n   395\t  // write — a sweep failure aborts the compact with the prior view intact.\n   396\t  let sweepOutcome: SweepReceipt | { skipped: true };\n   397\t  if (opts.sweep === false) {\n   398\t    sweepOutcome = { skipped: true };\n   399\t  } else {\n   400\t    const swept = await runSweep(filePath);\n   401\t    if (!swept.ok) return swept;\n   402\t    sweepOutcome = swept.value;\n   403\t  }\n   404\t\n   405\t  const opened = openThreadDatabase(filePath);\n   406\t  if (!opened.ok) return opened;\n   407\t  const db = opened.value;\n   408\t  try {\n   409\t    let inputs;\n   410\t    try {\n   411\t      inputs = readSelectionInputs(db);\n   412\t    } catch (cause) {\n   413\t      if (cause instanceof CanonicalCorruptionError) {\n   414\t        // Pre-transaction refusal: nothing was written, the prior view and\n   415\t        // the record are untouched (AC-2.5).\n   416\t        return {\n   417\t          ok: false,\n   418\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n   419\t        };\n   420\t      }\n   421\t      throw cause;\n   422\t    }\n   423\t    const selection = selectArrangement(inputs, {\n   424\t      lowerBound: merged.lowerBound,\n   425\t      percentages: merged.percentages,\n   426\t    });\n   427\t\n   428\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n   429\t      selection.entries.filter((entry) => entry.band === band);\n   430\t    const bands = BAND_ORDER.flatMap((band) => {\n   431\t      const entries = entriesByBand(band);\n   432\t      if (entries.length === 0) return [];\n   433\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n   434\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n   435\t    });\n   436\t\n   437\t    const createdAt = new Date().toISOString();\n   438\t    // view_id is v<compact event order> — deterministic, and deliberately\n   439\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n   440\t    // into a uniqueness scheme; the singleton row is replaced whole).\n   441\t    const viewId = `v${inputs.maxEventOrder}`;\n   442\t\n   443\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\n   444\t    // view-write transaction. An installed hook's throw aborts here —\n   445\t    // before BEGIN — so the previous view keeps serving.\n   446\t    fireViewInjection(\"compact-write\");\n   447\t\n   448\t    replaceViewSnapshot(db, {\n   449\t      viewId,\n   450\t      createdAt,\n   451\t      compactPoint: selection.compactPoint,\n   452\t      coveredFrom: selection.coveredFrom,\n   453\t      profileName,\n   454\t      configJson: JSON.stringify({\n   455\t        lowerBound: merged.lowerBound,\n   456\t        percentages: merged.percentages,\n   457\t      }),\n   458\t      arrangementJson: JSON.stringify(\n   459\t        selection.entries.map((entry) => ({\n   460\t          band: entry.band,\n   461\t          subjectKind: entry.subjectKind,\n   462\t          subjectId: entry.subjectId,\n   463\t          derivationUsed: entry.derivationUsed,\n   464\t          degraded: entry.degraded,\n   465\t        })),\n   466\t      ),\n   467\t      gapsJson: JSON.stringify(\n   468\t        selection.entries\n   469\t          .filter((entry) => entry.gap)\n   470\t          .map((entry) => ({\n   471\t            band: entry.band,\n   472\t            subjectId: entry.subjectId,\n   473\t            reason: entry.reason ?? \"unknown\",\n   474\t          })),\n   475\t      ),\n   476\t      sourceStateJson: JSON.stringify({\n   477\t        maxEventOrder: inputs.maxEventOrder,\n   478\t        derivationCounts: inputs.derivationCounts,\n   479\t      }),\n   480\t      bands,\n   481\t    });\n   482\t\n   483\t    const bandReport = {} as CompactReceipt[\"bands\"];\n   484\t    for (const band of BAND_ORDER) {\n   485\t      const stored = bands.find((row) => row.band === band);\n   486\t      bandReport[band] = {\n   487\t        entries: entriesByBand(band).length,\n   488\t        tokens: stored?.tokenCount ?? 0,\n   489\t      };\n   490\t    }\n   491\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n   492\t    return {\n   493\t      ok: true,\n   494\t      value: {\n   495\t        viewId,\n   496\t        profile: profileName,\n   497\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n   498\t        bands: bandReport,\n   499\t        tailTokens,\n   500\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n   501\t        totalTokens:\n   502\t          bandReport.brief.tokens +\n   503\t          bandReport.detailed.tokens +\n   504\t          bandReport.smooth.tokens +\n   505\t          tailTokens,\n   506\t        coveredFrom: selection.coveredFrom,\n   507\t        compactPoint: selection.compactPoint,\n   508\t        degraded: selection.entries\n   509\t          .filter((entry) => entry.degraded)\n   510\t          .map((entry) => ({\n   511\t            band: entry.band,\n   512\t            subjectId: entry.subjectId,\n   513\t            usedDerivation: entry.derivationUsed,\n   514\t          })),\n   515\t        gaps: selection.entries\n   516\t          .filter((entry) => entry.gap)\n   517\t          .map((entry) => ({\n   518\t            band: entry.band,\n   519\t            subjectId: entry.subjectId,\n   520\t            reason: entry.reason ?? \"unknown\",\n   521\t          })),\n   522\t        sweep: sweepOutcome,\n   523\t      },\n   524\t    };\n   525\t  } catch (cause) {\n   526\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n   527\t  } finally {\n   528\t    db.close();\n   529\t  }\n   530\t}\n   531\t\n   532\t// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n   533\t\n   534\t// The standalone readiness sweep: walk the owners' reports, requeue the\n   535\t// transiently-failed derivations through the owners' requeue surfaces, return the\n   536\t// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n   537\t// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n   538\t// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n   539\t// Story 5's process suite). Returns without waiting on any queued work\n   540\t// (AC-3.2): requeues are row writes; background mode's drain heals later.\n   541\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n   542\t  const resolved = await resolveThreadRef(ref);\n   543\t  if (!resolved.ok) return resolved;\n   544\t  const { filePath } = resolved.value;\n   545\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   546\t  try {\n   547\t    return await runSweep(filePath);\n   548\t  } catch (cause) {\n   549\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\n   550\t  }\n   551\t}\n   552\t\n   553\t// ── boundary advance (Flow 4: AC-4.3–4.6, 4.9) ───────────────────\n   554\t\n   555\t// The post-commit advance, Story 4. NOT a host operation: no public advance\n   556\t// surface exists (story Anti-Shim Requirements) — the SDK's ThreadViewSurface\n   557\t// carries only the five operations, and this function's one production caller\n   558\t// is intake-stream's ctx.onCommit registration (the sanctioned\n   559\t// intake→thread-view surface import, tech design §Module Boundaries). It\n   560\t// runs at flush in BOTH host modes — unlike the queue poke it is cheap and\n   561\t// deterministic, and a CLI intake must advance too or CLI-driven threads\n   562\t// bloat. Budgets resolve through the per-instance seam exactly as the poke\n   563\t// does (the flush runs synchronously inside the SDK operation's seam scope),\n   564\t// falling back to the built-in defaults for direct domain calls.\n   565\t//\n   566\t// Synchronous and throw-permitted by contract: the registering site wraps it\n   567\t// (catch + diagnose) so a failure never reaches intake's caller and never\n   568\t// eats the queue poke; the boundary is then simply unchanged and the\n   569\t// over-budget condition stays visible because status computes the same zone\n   570\t// sum live (AC-4.9).\n   571\texport function runPostCommitBoundaryAdvance(ctx: OperationContext): void {\n   572\t  // Story-0 injection point (TC-4.6): fired before the advance computes; an\n   573\t  // installed hook's throw stands in for an advance failure.\n   574\t  fireViewInjection(\"post-commit-advance\");\n   575\t  executeBoundaryAdvance(ctx.db, viewConfig().visibility, ctx.clock);\n   576\t}\n   577\t\n   578\t// ── materialize (Flow 5: AC-5.2–5.5) ─────────────────────────────\n   579\t\n   580\t// PI session-file materialization: run the pull assembly internally, hand\n   581\t// the same entry array to the JSONL writer, return the written path. No\n   582\t// thread state changes (reads + a file write outside the thread file), and\n   583\t// every generated field derives from view/record metadata, never write-time\n   584\t// clocks — repeating after no thread changes produces a byte-identical file\n   585\t// (AC-5.2). Parity with pull is by construction: one assembly, two shapes\n   586\t// (AC-5.3). A never-compacted thread materializes its tail-only pull with\n   587\t// the header timestamp from the thread's created-at (AC-5.4). Like pull,\n   588\t// the whole operation runs touch-suppressed: a background SDK's materialize\n   589\t// can never schedule a catch-up drain.\n   590\texport async function materialize(\n   591\t  ref: ThreadRef,\n   592\t  opts: { path: string; format?: \"pi-session\" },\n   593\t): Promise<OpResult<{ writtenPath: string }>> {\n   594\t  return runWithThreadTouchSuppressed(() => materializeInner(ref, opts));\n   595\t}\n   596\t\n   597\tasync function materializeInner(\n   598\t  ref: ThreadRef,\n   599\t  opts: { path: string; format?: \"pi-session\" },\n   600\t): Promise<OpResult<{ writtenPath: string }>> {\n   601\t  const format = opts.format ?? \"pi-session\";\n   602\t  if (format !== \"pi-session\") {\n   603\t    return {\n   604\t      ok: false,\n   605\t      error: {\n   606\t        errorClass: \"caller_error\",\n   607\t        code: \"unknown_format\",\n   608\t        reason: `unknown materialize format \"${String(format)}\"; accepted formats are \"pi-session\"`,\n   609\t      },\n   610\t    };\n   611\t  }\n   612\t  const resolved = await resolveThreadRef(ref);\n   613\t  if (!resolved.ok) return resolved;\n   614\t  const { filePath } = resolved.value;\n   615\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   616\t\n   617\t  const opened = openThreadDatabase(filePath);\n   618\t  if (!opened.ok) return opened;\n   619\t  const db = opened.value;\n   620\t  let input: MaterializeInput;\n   621\t  try {\n   622\t    const assembled = assembleView(db);\n   623\t    const threadMeta = readThreadMetadata(db);\n   624\t    input = {\n   625\t      threadId: threadMeta.threadId,\n   626\t      headerTimestamp: assembled.snapshot?.createdAt ?? threadMeta.createdAt,\n   627\t      // Deterministic per thread file — never the writing process's cwd.\n   628\t      cwd: path.dirname(path.resolve(filePath)),\n   629\t      entries: assembled.entries,\n   630\t    };\n   631\t  } catch (cause) {\n   632\t    return storageFailure(`view materialize failed: ${detail(cause)}`);\n   633\t  } finally {\n   634\t    db.close();\n   635\t  }\n   636\t  try {\n   637\t    return { ok: true, value: writePiSessionFile(input, opts.path) };\n   638\t  } catch (cause) {\n   639\t    return storageFailure(\n   640\t      `view materialize could not write ${opts.path}: ${detail(cause)}`,\n   641\t    );\n   642\t  }\n   643\t}\n   644\t\n   645\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n   646\texport {\n   647\t  BUILT_IN_PROFILES,\n   648\t  DEFAULT_COMPACT_THRESHOLD,\n   649\t  DEFAULT_VISIBILITY,\n   650\t  resolveViewConfig,\n   651\t} from \"./internal/profiles.js\";\n","exit_code":0,"status":"completed"}}

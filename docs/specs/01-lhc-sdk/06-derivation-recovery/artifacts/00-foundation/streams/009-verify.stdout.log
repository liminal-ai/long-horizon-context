{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/logging-surface.test.ts'","aggregated_output":"     1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  createDeterministicProvider,\n     4\t  createSdk,\n     5\t  writeLog,\n     6\t  type DerivationProvider,\n     7\t  type DrainReport,\n     8\t  type Lhc,\n     9\t  type LogEntry,\n    10\t  type LogLevel,\n    11\t  type MessageEventInput,\n    12\t} from \"../src/index.js\";\n    13\timport { createProviderDouble, openRaw, tempStore, validEvent } from \"./fixtures/index.js\";\n    14\t\n    15\tlet store: ReturnType<typeof tempStore>;\n    16\tlet sdk: Lhc;\n    17\t\n    18\tbeforeEach(() => {\n    19\t  store = tempStore();\n    20\t  sdk = createSdk({ provider: createDeterministicProvider(), mode: \"manual\" });\n    21\t});\n    22\t\n    23\tafterEach(() => {\n    24\t  store.cleanup();\n    25\t});\n    26\t\n    27\tasync function newThread(): Promise<string> {\n    28\t  const filePath = store.threadPath(\"logging-test\");\n    29\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    30\t  expect(created.ok).toBe(true);\n    31\t  return filePath;\n    32\t}\n    33\t\n    34\tasync function write(filePath: string, entry: LogEntry): Promise<void> {\n    35\t  const written = await sdk.logging.write({ filePath }, entry);\n    36\t  expect(written.ok).toBe(true);\n    37\t}\n    38\t\n    39\tfunction manualSdk(provider: DerivationProvider): Lhc {\n    40\t  return createSdk({\n    41\t    provider,\n    42\t    mode: \"manual\",\n    43\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    44\t    lease: { durationMs: 200 },\n    45\t  });\n    46\t}\n    47\t\n    48\tasync function send(\n    49\t  target: Lhc,\n    50\t  filePath: string,\n    51\t  batch: readonly MessageEventInput[],\n    52\t): Promise<void> {\n    53\t  const result = await target.intakeStream.messageEvents({ filePath }, batch);\n    54\t  expect(result.ok).toBe(true);\n    55\t}\n    56\t\n    57\tasync function drain(target: Lhc, filePath: string): Promise<DrainReport> {\n    58\t  const result = await target.work.drain({ filePath });\n    59\t  expect(result.ok).toBe(true);\n    60\t  if (!result.ok) throw new Error(\"drain failed\");\n    61\t  return result.value;\n    62\t}\n    63\t\n    64\tasync function sendTurn(target: Lhc, filePath: string): Promise<void> {\n    65\t  await send(target, filePath, [\n    66\t    validEvent(\"user_prompt\", { payload: { text: \"raw prompt one\" } }),\n    67\t    validEvent(\"assistant_text\", { payload: { text: \"answer text\" } }),\n    68\t    validEvent(\"turn_end\"),\n    69\t  ]);\n    70\t}\n    71\t\n    72\tdescribe(\"Flow 5: Derivation Logging\", () => {\n    73\t  it(\"TC-5.1a persists info, warning, and error levels\", async () => {\n    74\t    const filePath = await newThread();\n    75\t\n    76\t    for (const level of [\"info\", \"warning\", \"error\"] as LogLevel[]) {\n    77\t      await write(filePath, { level, message: `${level} message` });\n    78\t    }\n    79\t\n    80\t    const queried = await sdk.logging.query({ filePath }, {});\n    81\t    expect(queried.ok).toBe(true);\n    82\t    if (!queried.ok) return;\n    83\t    expect(queried.value.map((entry) => entry.level).sort()).toEqual([\n    84\t      \"error\",\n    85\t      \"info\",\n    86\t      \"warning\",\n    87\t    ]);\n    88\t  });\n    89\t\n    90\t  it(\"TC-5.2a writes internal and external callers through the same store\", async () => {\n    91\t    const filePath = await newThread();\n    92\t    const db = openRaw(filePath);\n    93\t    try {\n    94\t      writeLog(\n    95\t        {\n    96\t          db,\n    97\t          clock: () => new Date(\"2026-01-01T00:00:00.000Z\"),\n    98\t          threadId: \"logging-test\",\n    99\t          onCommit: () => {},\n   100\t          poke: () => {},\n   101\t        },\n   102\t        {\n   103\t          level: \"info\",\n   104\t          message: \"internal caller\",\n   105\t          derivationType: \"smoothed_prompt\",\n   106\t          subjectId: \"m1\",\n   107\t        },\n   108\t      );\n   109\t    } finally {\n   110\t      db.close();\n   111\t    }\n   112\t\n   113\t    await write(filePath, {\n   114\t      level: \"warning\",\n   115\t      message: \"external caller\",\n   116\t      derivationType: \"tool_result_summary\",\n   117\t      subjectId: \"m2\",\n   118\t    });\n   119\t\n   120\t    const queried = await sdk.logging.query({ filePath }, {});\n   121\t    expect(queried.ok).toBe(true);\n   122\t    if (!queried.ok) return;\n   123\t    expect(queried.value.map((entry) => entry.message).sort()).toEqual([\n   124\t      \"external caller\",\n   125\t      \"internal caller\",\n   126\t    ]);\n   127\t  });\n   128\t\n   129\t  it(\"TC-5.3a keeps fallback events in the log, not on ready derivations\", async () => {\n   130\t    const filePath = await newThread();\n   131\t    const double = createProviderDouble();\n   132\t    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n   133\t    const target = manualSdk(double);\n   134\t    await sendTurn(target, filePath);\n   135\t    const report = await drain(target, filePath);\n   136\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   137\t      [\"w-m1-prompt_smoothing-v1\", \"failed_terminal\"],\n   138\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n   139\t    ]);\n   140\t\n   141\t    const read = openRaw(filePath);\n   142\t    try {\n   143\t      const row = read\n   144\t        .prepare(`SELECT state, content, reason, gaps, metadata FROM derivation WHERE subject_id = ?`)\n   145\t        .get(\"t1\") as\n   146\t        | {\n   147\t            state: string;\n   148\t            content: string;\n   149\t            reason: string | null;\n   150\t            gaps: string | null;\n   151\t            metadata: string | null;\n   152\t          }\n   153\t        | undefined;\n   154\t      expect(row).toMatchObject({\n   155\t        state: \"ready\",\n   156\t        reason: null,\n   157\t        gaps: null,\n   158\t      });\n   159\t      expect(row?.content).toContain(\"raw prompt one\");\n   160\t      expect(row?.metadata).toBeNull();\n   161\t    } finally {\n   162\t      read.close();\n   163\t    }\n   164\t\n   165\t    const queried = await sdk.logging.query({ filePath }, { reason: \"not_ready\" });\n   166\t    expect(queried.ok).toBe(true);\n   167\t    if (!queried.ok) return;\n   168\t    expect(queried.value).toHaveLength(1);\n   169\t    expect(queried.value[0]?.derivationType).toBe(\"smoothed_prompt\");\n   170\t    expect(queried.value[0]?.subjectId).toBe(\"m1\");\n   171\t    expect(queried.value[0]?.floorUsed).toBe(\"raw prompt one\");\n   172\t  });\n   173\t\n   174\t  it(\"TC-5.3b keeps failed state and reason on the derivation record\", async () => {\n   175\t    const filePath = await newThread();\n   176\t    const db = openRaw(filePath);\n   177\t    try {\n   178\t      db.prepare(\n   179\t        `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, reason)\n   180\t         VALUES (?, ?, ?, ?, ?)`,\n   181\t      ).run(\"message\", \"m2\", \"tool_result_summary\", \"failed\", \"provider_unavailable\");\n   182\t    } finally {\n   183\t      db.close();\n   184\t    }\n   185\t\n   186\t    await write(filePath, {\n   187\t      level: \"error\",\n   188\t      message: \"diagnostic\",\n   189\t      derivationType: \"tool_result_summary\",\n   190\t      subjectId: \"m2\",\n   191\t      reason: \"provider_unavailable\",\n   192\t    });\n   193\t\n   194\t    const read = openRaw(filePath);\n   195\t    try {\n   196\t      const row = read\n   197\t        .prepare(`SELECT state, reason FROM derivation WHERE subject_id = ?`)\n   198\t        .get(\"m2\") as { state: string; reason: string } | undefined;\n   199\t      expect(row).toEqual({ state: \"failed\", reason: \"provider_unavailable\" });\n   200\t    } finally {\n   201\t      read.close();\n   202\t    }\n   203\t  });\n   204\t\n   205\t  it(\"TC-5.4a queries by actionable fields\", async () => {\n   206\t    const filePath = await newThread();\n   207\t    await write(filePath, {\n   208\t      level: \"info\",\n   209\t      message: \"smoothed ok\",\n   210\t      derivationType: \"smoothed_prompt\",\n   211\t      subjectId: \"m1\",\n   212\t      reason: \"observed\",\n   213\t    });\n   214\t    await write(filePath, {\n   215\t      level: \"warning\",\n   216\t      message: \"tool fallback\",\n   217\t      derivationType: \"tool_result_summary\",\n   218\t      subjectId: \"m2\",\n   219\t      reason: \"not_ready\",\n   220\t    });\n   221\t    await write(filePath, {\n   222\t      level: \"warning\",\n   223\t      message: \"smoothed fallback\",\n   224\t      derivationType: \"smoothed_prompt\",\n   225\t      subjectId: \"m3\",\n   226\t      reason: \"not_ready\",\n   227\t    });\n   228\t\n   229\t    const queried = await sdk.logging.query(\n   230\t      { filePath },\n   231\t      { level: \"warning\", derivationType: \"smoothed_prompt\", reason: \"not_ready\" },\n   232\t    );\n   233\t    expect(queried.ok).toBe(true);\n   234\t    if (!queried.ok) return;\n   235\t    expect(queried.value.map((entry) => entry.message)).toEqual([\"smoothed fallback\"]);\n   236\t  });\n   237\t\n   238\t  it(\"TC-5.5a contains logging write failures\", async () => {\n   239\t    const filePath = await newThread();\n   240\t    const db = openRaw(filePath);\n   241\t    try {\n   242\t      db.exec(\"BEGIN IMMEDIATE;\");\n   243\t      try {\n   244\t        db.prepare(\n   245\t          `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, content)\n   246\t           VALUES (?, ?, ?, ?, ?)`,\n   247\t        ).run(\"turn\", \"t1\", \"turn_rendering\", \"ready\", \"turn content\");\n   248\t\n   249\t        expect(() =>\n   250\t          writeLog(\n   251\t            {\n   252\t              db: {\n   253\t                prepare: () => {\n   254\t                  throw new Error(\"log store unavailable\");\n   255\t                },\n   256\t              } as never,\n   257\t              clock: () => new Date(\"2026-01-01T00:00:00.000Z\"),\n   258\t              threadId: \"logging-test\",\n   259\t              onCommit: () => {},\n   260\t              poke: () => {},\n   261\t            },\n   262\t            { level: \"warning\", message: \"will be dropped\" },\n   263\t          ),\n   264\t        ).not.toThrow();\n   265\t\n   266\t        db.prepare(\n   267\t          `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, content)\n   268\t           VALUES (?, ?, ?, ?, ?)`,\n   269\t        ).run(\"turn\", \"t1\", \"lower_band_projection\", \"ready\", \"projection content\");\n   270\t        db.exec(\"COMMIT;\");\n   271\t      } catch (cause) {\n   272\t        db.exec(\"ROLLBACK;\");\n   273\t        throw cause;\n   274\t      }\n   275\t\n   276\t      const rows = db\n   277\t        .prepare(`SELECT derivation_type FROM derivation WHERE subject_id = ? ORDER BY derivation_type`)\n   278\t        .all(\"t1\") as unknown as Array<{ derivation_type: string }>;\n   279\t      expect(rows.map((row) => row.derivation_type)).toEqual([\n   280\t        \"lower_band_projection\",\n   281\t        \"turn_rendering\",\n   282\t      ]);\n   283\t    } finally {\n   284\t      db.close();\n   285\t    }\n   286\t  });\n   287\t\n   288\t  it(\"TC-5.5b keeps log writes outside caller rollbacks in a real store\", async () => {\n   289\t    const filePath = await newThread();\n   290\t    await write(filePath, {\n   291\t      level: \"info\",\n   292\t      message: \"before rollback\",\n   293\t      derivationType: \"turn_rendering\",\n   294\t      subjectId: \"t-rollback\",\n   295\t      reason: \"rollback_probe\",\n   296\t    });\n   297\t\n   298\t    const db = openRaw(filePath);\n   299\t    try {\n   300\t      db.exec(\"BEGIN IMMEDIATE;\");\n   301\t      db.prepare(\n   302\t        `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, content)\n   303\t         VALUES (?, ?, ?, ?, ?)`,\n   304\t      ).run(\"turn\", \"t-rollback\", \"turn_rendering\", \"ready\", \"rolled back content\");\n   305\t      db.exec(\"ROLLBACK;\");\n   306\t\n   307\t      const derivationRows = db\n   308\t        .prepare(`SELECT COUNT(*) AS n FROM derivation WHERE subject_id = ?`)\n   309\t        .get(\"t-rollback\") as { n: number | bigint };\n   310\t      expect(Number(derivationRows.n)).toBe(0);\n   311\t    } finally {\n   312\t      db.close();\n   313\t    }\n   314\t\n   315\t    const queried = await sdk.logging.query({ filePath }, { subjectId: \"t-rollback\" });\n   316\t    expect(queried.ok).toBe(true);\n   317\t    if (!queried.ok) return;\n   318\t    expect(queried.value.map((entry) => entry.message)).toEqual([\"before rollback\"]);\n   319\t  });\n   320\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/storage.ts'","aggregated_output":"     1\timport { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface Migration {\n     4\t  version: number; // 1-based, strictly increasing\n     5\t  statements: readonly string[];\n     6\t}\n     7\t\n     8\tconst databasePaths = new WeakMap<DatabaseSync, string>();\n     9\t\n    10\texport function openDatabase(path: string): DatabaseSync {\n    11\t  const db = new DatabaseSync(path);\n    12\t  databasePaths.set(db, path);\n    13\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n    14\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n    15\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n    16\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n    17\t  return db;\n    18\t}\n    19\t\n    20\texport function databasePathFor(db: DatabaseSync): string | undefined {\n    21\t  return databasePaths.get(db);\n    22\t}\n    23\t\n    24\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\n    25\t// on the existing work_item table, the derivation state table, the chunk\n    26\t// tables, and the projection-level delete stamps. The whole epic's schema\n    27\t// lands in one version — behavior arrives story by story. Assembled into the\n    28\t// thread-file migration history by threads/internal/create.ts.\n    29\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n    30\t  // claim mechanics on the existing table (DD-1: no disposition column —\n    31\t  // queue rows are live work only; terminal rows are deleted and their\n    32\t  // outcomes reported in-memory; durable outcome state lives on derivation)\n    33\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n    34\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n    35\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n    36\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n    37\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n    38\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n    39\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n    40\t  // inside an index definition, so the index covers the two real columns and\n    41\t  // claimNext's ORDER BY rowid walks the head as before.\n    42\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n    43\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n    44\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\n    45\t  // call id — never a block scan (anti-shim requirement).\n    46\t  `CREATE INDEX idx_message_block_tool_call_id\n    47\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n    48\t  `CREATE TABLE derived_form (\n    49\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    50\t    subject_id   TEXT NOT NULL,\n    51\t    form         TEXT NOT NULL,\n    52\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    53\t    content      TEXT,\n    54\t    reason       TEXT,\n    55\t    metadata     TEXT,\n    56\t    source_version INTEGER NOT NULL DEFAULT 1,\n    57\t    gaps         TEXT,\n    58\t    derived_at   TEXT,\n    59\t    PRIMARY KEY (subject_kind, subject_id, form)\n    60\t  );`,\n    61\t  `CREATE TABLE chunk (\n    62\t    chunk_id     TEXT PRIMARY KEY,\n    63\t    chunk_order  INTEGER NOT NULL UNIQUE,\n    64\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    65\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n    66\t  );`,\n    67\t  `CREATE TABLE chunk_member (\n    68\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    69\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    70\t    member_idx INTEGER NOT NULL,\n    71\t    PRIMARY KEY (chunk_id, member_idx)\n    72\t  );`,\n    73\t  // projection-level delete (the record keeps everything; reads filter)\n    74\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n    75\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n    76\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\n    77\t  // UPDATE-only completion finds them (row missing must mean deleted).\n    78\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    79\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n    80\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n    81\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    82\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n    83\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n    84\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    85\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n    86\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    87\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    88\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n    89\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    90\t];\n    91\t\n    92\t// Epic 03's single migration (tech design §Storage): the thread-view\n    93\t// snapshot tables and the visibility boundary, living beside the record they\n    94\t// render so a thread file stays self-contained and snapshot-portable.\n    95\t// Singletons are CHECK-enforced structurally: one active view, one boundary\n    96\t// row per thread. Assembled into the thread-file migration history by\n    97\t// threads/internal/create.ts, like v5.\n    98\texport const MIGRATION_V6_STATEMENTS: readonly string[] = [\n    99\t  `CREATE TABLE thread_view (\n   100\t    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\n   101\t    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\n   102\t    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\n   103\t    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\n   104\t    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\n   105\t    profile_name TEXT,                   -- null when explicit params\n   106\t    config_json TEXT NOT NULL,           -- resolved bound + percentages\n   107\t    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, derivationUsed, degraded}\n   108\t    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\n   109\t    source_state_json TEXT NOT NULL      -- {maxEventOrder, derivationCounts} the compact saw — receipt/debug\n   110\t  );`,\n   111\t  `CREATE TABLE thread_view_band (\n   112\t    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\n   113\t    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\n   114\t    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\n   115\t    token_count INTEGER NOT NULL,\n   116\t    PRIMARY KEY (view_id, band)\n   117\t  );`,\n   118\t  `CREATE TABLE view_boundary (\n   119\t    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\n   120\t    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\n   121\t    updated_at TEXT NOT NULL\n   122\t  );`,\n   123\t  // Seed at position 0 (everything full) — the boundary row exists from\n   124\t  // migration on, so the advance and the compact reset are UPDATE-only.\n   125\t  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\n   126\t    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\n   127\t];\n   128\t\n   129\t// Epic 06 Story 0's single migration (tech design §DD-1, §DD-5):\n   130\t// 1. Rename derived_form table to derivation and column 'form' to 'derivation_type'\n   131\t// 2. Create the log table for fallback events and diagnostics\n   132\t// Singletons are CHECK-enforced structurally: one log entry per recorded event.\n   133\t// Assembled into the thread-file migration history by threads/internal/create.ts,\n   134\t// like v5 and v6.\n   135\texport const MIGRATION_V7_STATEMENTS: readonly string[] = [\n   136\t  // Rename table and column for derivation vocabulary (DD-1)\n   137\t  `ALTER TABLE derived_form RENAME TO derivation;`,\n   138\t  // SQLite doesn't support ALTER COLUMN directly, so we recreate the table\n   139\t  `CREATE TABLE derivation_new (\n   140\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n   141\t    subject_id   TEXT NOT NULL,\n   142\t    derivation_type TEXT NOT NULL,\n   143\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n   144\t    content      TEXT,\n   145\t    reason       TEXT,\n   146\t    metadata     TEXT,\n   147\t    source_version INTEGER NOT NULL DEFAULT 1,\n   148\t    gaps         TEXT,\n   149\t    derived_at   TEXT,\n   150\t    PRIMARY KEY (subject_kind, subject_id, derivation_type)\n   151\t  );`,\n   152\t  `INSERT INTO derivation_new SELECT subject_kind, subject_id, form, state, content, reason, metadata, source_version, gaps, derived_at FROM derivation;`,\n   153\t  `DROP TABLE derivation;`,\n   154\t  `ALTER TABLE derivation_new RENAME TO derivation;`,\n   155\t  `UPDATE thread_view\n   156\t     SET arrangement_json = replace(arrangement_json, '\"formUsed\"', '\"derivationUsed\"')\n   157\t     WHERE arrangement_json LIKE '%\"formUsed\"%';`,\n   158\t  `UPDATE thread_view\n   159\t     SET source_state_json = replace(source_state_json, '\"formCounts\"', '\"derivationCounts\"')\n   160\t     WHERE source_state_json LIKE '%\"formCounts\"%';`,\n   161\t  // Create log table (DD-5)\n   162\t  `CREATE TABLE log (\n   163\t    log_id INTEGER PRIMARY KEY AUTOINCREMENT,\n   164\t    level TEXT NOT NULL CHECK (level IN ('info','warning','error')),\n   165\t    message TEXT NOT NULL,\n   166\t    derivation_type TEXT,\n   167\t    subject_id TEXT,\n   168\t    reason TEXT,\n   169\t    floor_used TEXT,\n   170\t    recorded_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n   171\t  );`,\n   172\t  // Indexes for log queries by actionable fields\n   173\t  `CREATE INDEX idx_log_level ON log (level);`,\n   174\t  `CREATE INDEX idx_log_derivation_type ON log (derivation_type);`,\n   175\t  `CREATE INDEX idx_log_subject_id ON log (subject_id);`,\n   176\t  `CREATE INDEX idx_log_reason ON log (reason);`,\n   177\t];\n   178\t\n   179\texport function getSchemaVersion(db: DatabaseSync): number {\n   180\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n   181\t    | { user_version: number | bigint }\n   182\t    | undefined;\n   183\t  return Number(row?.user_version ?? 0);\n   184\t}\n   185\t\n   186\texport function runMigrations(\n   187\t  db: DatabaseSync,\n   188\t  migrations: readonly Migration[],\n   189\t): void {\n   190\t  let current = getSchemaVersion(db);\n   191\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n   192\t  for (const migration of ordered) {\n   193\t    if (migration.version <= current) continue;\n   194\t    db.exec(\"BEGIN IMMEDIATE;\");\n   195\t    try {\n   196\t      for (const statement of migration.statements) db.exec(statement);\n   197\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n   198\t      db.exec(\"COMMIT;\");\n   199\t    } catch (cause) {\n   200\t      db.exec(\"ROLLBACK;\");\n   201\t      throw cause;\n   202\t    }\n   203\t    current = migration.version;\n   204\t  }\n   205\t}\n","exit_code":0,"status":"completed"}}

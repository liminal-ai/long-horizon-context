on FROM derivation\n   251\t       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n   252\t    )\n   253\t    .get(subjectKind, subjectId, form) as unknown as\n   254\t    | { state: string; reason: string | null; source_version: number | bigint }\n   255\t    | undefined;\n   256\t  if (row === undefined) return undefined;\n   257\t  const view: { state: DerivationState; reason?: string; sourceVersion: number } = {\n   258\t    state: row.state as DerivationState,\n   259\t    sourceVersion: Number(row.source_version),\n   260\t  };\n   261\t  if (row.reason !== null) view.reason = row.reason;\n   262\t  return view;\n   263\t}\n   264\t\n   265\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\n   266\t// form rows LEFT JOINed with the live work_item targeting each form at its\n   267\t// current source version. Both turn forms map to the one turn_derivation\n   268\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\n   269\t// this owner's queue-site mapping inverted, mirroring the messages report.\n   270\texport function reportTurnForms(\n   271\t  db: DatabaseSync,\n   272\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\n   273\t): DerivationReportEntry[] {\n   274\t  const conditions = [\"df.subject_kind IN ('turn', 'chunk')\"];\n   275\t  const params: string[] = [];\n   276\t  const subjectFilters: string[] = [];\n   277\t  if (opts.turnId !== undefined) {\n   278\t    subjectFilters.push(\"(df.subject_kind = 'turn' AND df.subject_id = ?)\");\n   279\t    params.push(opts.turnId);\n   280\t  }\n   281\t  if (opts.chunkId !== undefined) {\n   282\t    subjectFilters.push(\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\");\n   283\t    params.push(opts.chunkId);\n   284\t  }\n   285\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\" OR \")})`);\n   286\t  // notReady is exact set equality by construction: every state but ready.\n   287\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   288\t  const rows = db\n   289\t    .prepare(\n   290\t      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\n   291\t              df.metadata, df.source_version, df.gaps, df.derived_at,\n   292\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   293\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   294\t       FROM derivation df\n   295\t       LEFT JOIN work_item w\n   296\t         ON w.status IN ('queued', 'claimed')\n   297\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\n   298\t        AND json_extract(\n   299\t              w.source_ref,\n   300\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\n   301\t            ) = df.subject_id\n   302\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   303\t       WHERE ${conditions.join(\" AND \")}\n   304\t       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\n   305\t    )\n   306\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\n   307\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\n   308\t}\n   309\t\n   310\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n   311\t  return (\n   312\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n   313\t  );\n   314\t}\n","exit_code":0,"status":"completed"}}

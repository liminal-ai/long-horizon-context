n { messages, turns, chunks, forms, maxEventOrder: Number(maxRow.m), formCounts };\n   258\t}\n   259\t\n   260\t// ── the pure walk ─────────────────────────────────────────────────\n   261\t\n   262\texport interface SelectionConfig {\n   263\t  lowerBound: number;\n   264\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n   265\t}\n   266\t\n   267\texport function selectArrangement(\n   268\t  inputs: SelectionInputs,\n   269\t  config: SelectionConfig,\n   270\t): SelectionResult {\n   271\t  const { messages, turns, chunks, forms } = inputs;\n   272\t  const lookup = (subjectId: string, form: string): FormSnapshot | undefined =>\n   273\t    forms.get(`${subjectId}/${form}`);\n   274\t  const budget = (share: number): number => (config.lowerBound * share) / 100;\n   275\t\n   276\t  const turnsById = new Map(turns.map((turn) => [turn.turnId, turn]));\n   277\t  const messagesByTurn = new Map<string, SelectionMessage[]>();\n   278\t  for (const message of messages) {\n   279\t    if (message.turnId === null) continue;\n   280\t    const list = messagesByTurn.get(message.turnId) ?? [];\n   268\t}\n   269\t\n   270\t// Ready tool-result summaries by message id — the short-form ladder's first\n   271\t// rung. Stored state read verbatim, never derived here (no-inference rule).\n   272\texport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\n   273\t  const rows = db\n   274\t    .prepare(\n   275\t      `SELECT subject_id, content FROM derivation\n   276\t       WHERE subject_kind = 'message' AND form = 'tool_result_summary'\n   277\t         AND state = 'ready' AND content IS NOT NULL`,\n   278\t    )\n   279\t    .all() as unknown as Array<{ subject_id: string; content: string }>;\n   280\t  return new Map(rows.map((row) => [row.subject_id, row.content]));\n","exit_code":0,"status":"completed"}}

ner holds for one subject kind, grouped by subject\n   164\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\n   165\t// \"record with form states\", mirroring messages.readMessageForms). Rows come\n   166\t// back exactly as the pipeline landed them; nothing is derived at read time.\n   167\texport function readOwnedForms(\n   168\t  db: DatabaseSync,\n   169\t  subjectKind: \"turn\" | \"chunk\",\n   170\t): Map<string, Derivation[]> {\n   171\t  const rows = db\n   172\t    .prepare(\n   173\t      `SELECT subject_id, form, state, content, reason, metadata,\n   174\t              source_version, gaps, derived_at\n   175\t       FROM derivation WHERE subject_kind = ?\n   176\t       ORDER BY subject_id, form`,\n   177\t    )\n   178\t    .all(subjectKind) as unknown as RawOwnedFormRow[];\n   179\t  const bySubject = new Map<string, Derivation[]>();\n   180\t  for (const row of rows) {\n   181\t    const record: Derivation = {\n   182\t      subjectKind,\n   183\t      subjectId: row.subject_id,\n   184\t      form: row.form as DerivationType,\n   185\t      state: row.state as DerivationState,\n   186\t      sourceVersion: Number(row.source_version),\n   187\t    };\n   188\t    if (row.content !== null) record.content = row.content;\n   189\t    if (row.reason !== null) record.reason = row.reason;\n   190\t    if (row.metadata !== null) {\n   191\t      record.metadata = JSON.parse(row.metadata) as DerivationMetadata;\n   192\t    }\n   193\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n   194\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n   195\t    const forms = bySubject.get(row.subject_id) ?? [];\n   196\t    forms.push(record);\n   197\t    bySubject.set(row.subject_id, forms);\n   198\t  }\n   199\t  return bySubject;\n   200\t}\n   201\t\n   202\t// Chunk read-back rows for the listChunks surface: stored chunk state plus\n   203\t// live (deleted-filtered) membership in member
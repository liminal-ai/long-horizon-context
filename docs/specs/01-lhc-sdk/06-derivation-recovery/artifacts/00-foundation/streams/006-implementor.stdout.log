{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' packages/lhc/test/logging-surface.test.ts\"","aggregated_output":"// Flow 5 — Derivation Logging (TC-5.1a through TC-5.5a)\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport type { LogLevel, StoredLogEntry } from \"../src/index.js\";\nimport { tempStore, openRaw } from \"./fixtures/index.js\";\n\nlet store: ReturnType<typeof tempStore>;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\n// Helper to create a fresh thread file with migrations applied\nfunction createThreadFile(): string {\n  const db = openRaw(store.threadPath(\"logging-test\"));\n\n  // Run migrations manually\n  db.exec(\"PRAGMA journal_mode = WAL;\");\n  db.exec(\"PRAGMA foreign_keys = ON;\");\n  db.exec(\"PRAGMA busy_timeout = 5000;\");\n  db.exec(\"PRAGMA synchronous = NORMAL;\");\n\n  // v5 migration (derived_form table and work_item columns)\n  db.exec(`ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`);\n  db.exec(`ALTER TABLE work_item ADD COLUMN last_error TEXT;`);\n  db.exec(`ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`);\n  db.exec(`ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`);\n  db.exec(`ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`);\n  db.exec(`ALTER TABLE work_item ADD COLUMN payload TEXT;`);\n  db.exec(`CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`);\n  db.exec(`CREATE TABLE derived_form (\n    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    subject_id   TEXT NOT NULL,\n    form         TEXT NOT NULL,\n    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    content      TEXT,\n    reason       TEXT,\n    metadata     TEXT,\n    source_version INTEGER NOT NULL DEFAULT 1,\n    gaps         TEXT,\n    derived_at   TEXT,\n    PRIMARY KEY (subject_kind, subject_id, form)\n  );`);\n  db.exec(`CREATE TABLE chunk (\n    chunk_id     TEXT PRIMARY KEY,\n    chunk_order  INTEGER NOT NULL UNIQUE,\n    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n  );`);\n  db.exec(`CREATE TABLE chunk_member (\n    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    member_idx INTEGER NOT NULL,\n    PRIMARY KEY (chunk_id, member_idx)\n  );`);\n  db.exec(`ALTER TABLE message ADD COLUMN deleted_at TEXT;`);\n  db.exec(`ALTER TABLE turns ADD COLUMN deleted_at TEXT;`);\n\n  // v6 migration (thread_view tables)\n  db.exec(`CREATE TABLE thread_view (\n    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),\n    view_id TEXT NOT NULL UNIQUE,\n    created_at TEXT NOT NULL,\n    compact_point INTEGER NOT NULL,\n    covered_from INTEGER NOT NULL,\n    profile_name TEXT,\n    config_json TEXT NOT NULL,\n    arrangement_json TEXT NOT NULL,\n    gaps_json TEXT NOT NULL,\n    source_state_json TEXT NOT NULL\n  );`);\n  db.exec(`CREATE TABLE thread_view_band (\n    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\n    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\n    rendered_text TEXT NOT NULL,\n    token_count INTEGER NOT NULL,\n    PRIMARY KEY (view_id, band)\n  );`);\n  db.exec(`CREATE TABLE view_boundary (\n    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\n    position INTEGER NOT NULL,\n    updated_at TEXT NOT NULL\n  );`);\n  db.exec(`INSERT INTO view_boundary (thread_singleton, position, updated_at)\n    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`);\n\n  // v7 migration (rename to derivation and create log table)\n  db.exec(`ALTER TABLE derived_form RENAME TO derivation;`);\n  db.exec(`CREATE TABLE derivation_new (\n    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    subject_id   TEXT NOT NULL,\n    derivation_type TEXT NOT NULL,\n    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    content      TEXT,\n    reason       TEXT,\n    metadata     TEXT,\n    source_version INTEGER NOT NULL DEFAULT 1,\n    gaps         TEXT,\n    derived_at   TEXT,\n    PRIMARY KEY (subject_kind, subject_id, derivation_type)\n  );`);\n  db.exec(`INSERT INTO derivation_new SELECT subject_kind, subject_id, form, state, content, reason, metadata, source_version, gaps, derived_at FROM derivation;`);\n  db.exec(`DROP TABLE derivation;`);\n  db.exec(`ALTER TABLE derivation_new RENAME TO derivation;`);\n  db.exec(`CREATE TABLE log (\n    log_id INTEGER PRIMARY KEY AUTOINCREMENT,\n    level TEXT NOT NULL CHECK (level IN ('info','warning','error')),\n    message TEXT NOT NULL,\n    derivation_type TEXT,\n    subject_id TEXT,\n    reason TEXT,\n    floor_used TEXT,\n    recorded_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n  );`);\n  db.exec(`CREATE INDEX idx_log_level ON log (level);`);\n  db.exec(`CREATE INDEX idx_log_derivation_type ON log (derivation_type);`);\n  db.exec(`CREATE INDEX idx_log_subject_id ON log (subject_id);`);\n\n  db.close();\n  return store.threadPath(\"logging-test\");\n}\n\n// Helper to read all log entries from the database\nfunction readLogs(dbPath: string): StoredLogEntry[] {\n  const db = openRaw(dbPath);\n  try {\n    const rows = db\n      .prepare(\n        `SELECT log_id, level, message, derivation_type, subject_id, reason, floor_used, recorded_at\n         FROM log ORDER BY recorded_at DESC`,\n      )\n      .all() as unknown as Array<{\n      log_id: number;\n      level: string;\n      message: string;\n      derivation_type: string | null;\n      subject_id: string | null;\n      reason: string | null;\n      floor_used: string | null;\n      recorded_at: string;\n    }>;\n\n    return rows.map((row) => ({\n      logId: row.log_id,\n      level: row.level as LogLevel,\n      message: row.message,\n      derivationType: row.derivation_type,\n      subjectId: row.subject_id,\n      reason: row.reason,\n      floorUsed: row.floor_used,\n      recordedAt: row.recorded_at,\n    }));\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"Flow 5: Derivation Logging\", () => {\n  describe(\"TC-5.1a: Levels stored\", () => {\n    it(\"Given: entries written at each level, When: storage is read, Then: all three are persisted with their level\", async () => {\n      const db = openRaw(createThreadFile());\n\n      try {\n        // Write entries at each level\n        const levels: LogLevel[] = [\"info\", \"warning\", \"error\"];\n        for (const level of levels) {\n          db.prepare(\n            `INSERT INTO log (level, message) VALUES (?, ?)`,\n          ).run(level, `test ${level} message`);\n        }\n\n        // Read back and verify\n        const logs = readLogs(store.threadPath(\"logging-test\"));\n        expect(logs).toHaveLength(3);\n\n        const retrievedLevels = logs.map((l) => l.level);\n        expect(retrievedLevels).toContain(\"info\");\n        expect(retrievedLevels).toContain(\"warning\");\n        expect(retrievedLevels).toContain(\"error\");\n\n        // Verify they're in descending order by recorded_at\n        expect(logs[0]!.level).toBe(\"error\");\n        expect(logs[1]!.level).toBe(\"warning\");\n        expect(logs[2]!.level).toBe(\"info\");\n      } finally {\n        db.close();\n      }\n    });\n  });\n\n  describe(\"TC-5.2a: Shared write surface\", () => {\n    it(\"Given: a write from an LHC internal caller and a write from an external caller, When: both are issued, Then: both land through the same method into the same store\", async () => {\n      const db = openRaw(createThreadFile());\n\n      try {\n        // Simulate internal write (direct SQL, as LHC internal would use writeLog)\n        db.prepare(\n          `INSERT INTO log (level, message, derivation_type, subject_id) VALUES (?, ?, ?, ?)`,\n        ).run(\"info\", \"internal log\", \"smoothed_prompt\", \"msg-1\");\n\n        // Simulate external write (SDK consumer using lhc.logging.write)\n        // In production this goes through writeLog which uses the same INSERT\n        db.prepare(\n          `INSERT INTO log (level, message, derivation_type, subject_id) VALUES (?, ?, ?, ?)`,\n        ).run(\"warning\", \"external log\", \"tool_result_summary\", \"msg-2\");\n\n        // Both should be in the same store\n        const logs = readLogs(store.threadPath(\"logging-test\"));\n        expect(logs).toHaveLength(2);\n\n        expect(logs.some((l) => l.message === \"internal log\")).toBe(true);\n        expect(logs.some((l) => l.message === \"external log\")).toBe(true);\n      } finally {\n        db.close();\n      }\n    });\n  });\n\n  describe(\"TC-5.3a: Subject and ready output stay clean\", () => {\n    it(\"Given: a derivation fell back during construction, When: the canonical subject and the produced rendering are read, Then: neither carries a degraded flag; the fallback event exists only in the log\", async () => {\n      const db = openRaw(createThreadFile());\n\n      try {\n        // Create a derivation row (simulating a message subject)\n        db.prepare(\n          `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, content)\n           VALUES (?, ?, ?, ?, ?)`,\n        ).run(\"message\", \"msg-1\", \"smoothed_prompt\", \"ready\", \"clean content\");\n\n        // Log a fallback event\n        db.prepare(\n          `INSERT INTO log (level, message, derivation_type, subject_id, reason, floor_used)\n           VALUES (?, ?, ?, ?, ?, ?)`,\n        ).run(\"warning\", \"fallback used\", \"smoothed_prompt\", \"msg-1\", \"not_ready\", \"deterministic floor\");\n\n        // Verify the derivation row has no degraded marker\n        const derivation = db\n          .prepare(`SELECT state, content FROM derivation WHERE subject_id = ?`)\n          .get(\"msg-1\") as { state: string; content: string } | undefined;\n        expect(derivation).toBeDefined();\n        expect(derivation!.state).toBe(\"ready\");\n        expect(derivation!.content).toBe(\"clean content\");\n        // No \"degraded\" or \"fallback\" flag in the derivation row\n\n        // Verify the log entry exists separately\n        const logs = readLogs(store.threadPath(\"logging-test\"));\n        const fallbackLog = logs.find((l) => l.subjectId === \"msg-1\" && l.reason === \"not_ready\");\n        expect(fallbackLog).toBeDefined();\n        expect(fallbackLog!.floorUsed).toBe(\"deterministic floor\");\n      } finally {\n        db.close();\n      }\n    });\n  });\n\n  describe(\"TC-5.3b: Failed state still on the derivation record\", () => {\n    it(\"Given: a derivation terminally failed, When: its derivation record is read (not the subject), Then: it shows failed with a reason, independent of any log entry\", async () => {\n      const db = openRaw(createThreadFile());\n\n","exit_code":0,"status":"completed"}}

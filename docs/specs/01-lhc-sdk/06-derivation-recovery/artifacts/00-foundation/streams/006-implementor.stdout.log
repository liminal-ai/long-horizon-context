internal/select.ts:71:  forms: Map<string, FormSnapshot>; // `${subjectId}/${form}` (turn/chunk subjects)\npackages/lhc/src/domains/thread-view/internal/select.ts:73:  formCounts: Record<string, Record<string, number>>; // form → state → count\npackages/lhc/src/domains/thread-view/internal/select.ts:228:      `SELECT subject_id, form, state, content, reason FROM derived_form\npackages/lhc/src/domains/thread-view/internal/select.ts:233:    form: string;\npackages/lhc/src/domains/thread-view/internal/select.ts:243:    forms.set(`${row.subject_id}/${row.form}`, snapshot);\npackages/lhc/src/domains/thread-view/internal/select.ts:250:    .prepare(`SELECT form, state, COUNT(*) AS n FROM derived_form GROUP BY form, state`)\npackages/lhc/src/domains/thread-view/internal/select.ts:251:    .all() as unknown as Array<{ form: string; state: string; n: number | bigint }>;\npackages/lhc/src/domains/thread-view/internal/select.ts:254:    formCounts[row.form] = { ...formCounts[row.form], [row.state]: Number(row.n) };\npackages/lhc/src/domains/thread-view/internal/select.ts:272:  const lookup = (subjectId: string, form: string): FormSnapshot | undefined =>\npackages/lhc/src/domains/thread-view/internal/select.ts:273:    forms.get(`${subjectId}/${form}`);\npackages/lhc/src/domains/thread-view/internal/select.ts:395:      .filter((form): form is FormSnapshot & { content: string } => form?.state === \"ready\")\npackages/lhc/src/domains/thread-view/internal/select.ts:396:      .map((form) => form.content ?? \"\")\npackages/lhc/src/domains/messages/internal/cascade.ts:7:// actually exist), never from a hardcoded form list: a future form on any\npackages/lhc/src/domains/messages/internal/cascade.ts:159:// their form rows outright; clear subjects go pending at the next source\npackages/lhc/src/domains/thread-view/internal/snapshot.ts:5:// the atomic replace at compact. Direct record/derived_form reads are\npackages/lhc/src/domains/thread-view/internal/snapshot.ts:8:// derived_form directly
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_817f70c49a974fc895ff7a0b","type":"tool_result","content":"export function runMigrations(\n  db: DatabaseSync,\n  migrations: readonly Migration[],\n): void {\n  let current = getSchemaVersion(db);\n  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n  for (const migration of ordered) {\n    if (migration.version <= current) continue;\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      for (const statement of migration.statements) db.exec(statement);\n      db.exec(`PRAGMA user_version = ${migration.version};`);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    current = migration.version;\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"78884745-4cf3-4d6d-8229-599974baec13","timestamp":"2026-06-15T04:23:37.534Z","tool_use_result":{"stdout":"export function runMigrations(\n  db: DatabaseSync,\n  migrations: readonly Migration[],\n): void {\n  let current = getSchemaVersion(db);\n  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n  for (const migration of ordered) {\n    if (migration.version <= current) continue;\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      for (const statement of migration.statements) db.exec(statement);\n      db.exec(`PRAGMA user_version = ${migration.version};`);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    current = migration.version;\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_648c8b8cc7b0433992abc8bb","type":"tool_result","content":"100\t}\n101\t\n102\t// ── provider seam (DD-7) ─────────────────────────────────────────\n103\t// Every operation returns content or a structured failure carrying\n104\t// retryable-or-not; classification is the adapter's duty.\n105\t// Provenance: the three config-known assignment strings, stamped by the\n106\t// inference adapter (it alone knows the assignment) and copied by handlers\n107\t// into form metadata (Epic 05 DD-4). Never derived from model output.\n108\texport interface ProviderProvenance {\n109\t  provider: string;\n110\t  model: string;\n111\t  prompt: string;\n112\t}\n113\t\n114\texport type ProviderResult =\n115\t  | { ok: true; text: string; provenance?: ProviderProvenance }\n116\t  | { ok: false; retryable: boolean; reason: string };\n117\t\n118\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n119\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n120\t// rather than imported: shared/ may not import domains/.\n121\texport type RenderingPartKind =\n122\t  | \"user_prompt\"\n123\t  | \"assistant_text\"\n124\t  | \"assistant_thinking\"\n125\t  | \"runtime_note\"\n126\t  | \"tool_call\"\n127\t  | \"tool_result\";\n128\t\n129\texport interface RenderingPart {\n130\t  messageId: string;\n131\t  kind: RenderingPartKind;\n132\t  text: string; // ready form content, or raw/truncated fallback\n133\t  fallback: boolean; // true ⇒ gap recorded\n134\t  outcome?: ToolOutcome; // tool activity only\n135\t}\n136\t\n137\texport interface DerivationProvider {\n138\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n139\t  summarizeToolCall(i: {\n140\t    toolName: string;\n141\t    argsJson: string;\n142\t    pairedResult?: { content: string; isError: boolean };\n143\t  }): Promise<ProviderResult>;\n144\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n145\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n146\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n147\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n148\t  // the members' tool-run receipts (what changed, outcome) alongside the\n149\t  // projections; brief receives outcomes only — receipt text is stripped\n150\t  // before the provider is called, so brief structurally cannot leak it.\n151\t  // The receipt fields are optional in the type for callers without member\n152\t  // context (the production chunk handlers always pass them).\n153\t  summarizeChunkDetailed(i: {\n154\t    memberProjections: string[];\n155\t    memberReceipts?: ToolRunReceipt[][];\n156\t  }): Promise<ProviderResult>;\n157\t  summarizeChunkBrief(i: {\n158\t    memberProjections: string[];\n159\t    memberOutcomes?: ToolOutcome[][];\n160\t  }): Promise<ProviderResult>;\n161\t}\n162\t\n163\texport const PROVIDER_OPERATIONS = [\n164\t  \"smoothPrompt\",\n165\t  \"summarizeToolCall\",\n166\t  \"summarizeToolResult\",\n167\t  \"composeTurnRendering\",\n168\t  \"projectLowerBand\",\n169\t  \"summarizeChunkDetailed\",\n170\t  \"summarizeChunkBrief\",\n171\t] as const;\n172\t\n173\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n174\t\n175\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n176\t// Provider arrival is exactly one of `provider` (direct injection,\n177\t// unchanged — the deterministic test default) or `inference` (host\n178\t// model-call function + per-kind assignments, Epic 05 DD-5). Both or\n179\t// neither is a construction TypeError naming the XOR rule (AC-1.1).\n180\texport interface SdkConfig {\n181\t  provider?: DerivationProvider;\n182\t  inference?: InferenceConfig;\n183\t  mode: \"background\" | \"manual\";\n184\t  clock?: () => Date;\n185\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n186\t  lease?: { durationMs: number }; // 120000\n187\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n188\t  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\n189\t}\n190\t\n191\t// Every optional filled by createSdk's central defaults.\n192\texport interface ResolvedSdkConfig {\n193\t  provider: DerivationProvider;\n194\t  mode: \"background\" | \"manual\";\n195\t  clock: () => Date;\n196\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n197\t  lease: { durationMs: number };\n198\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n199\t  view: ResolvedViewConfig;\n200\t}\n201\t\n202\t// ── handler contract (DD-6; the map's value type) ────────────────\n203\texport interface HandlerRunContext {\n204\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n205\t  provider: DerivationProvider;\n206\t  clock: () => Date;\n207\t  config: ResolvedSdkConfig;\n208\t}\n209\t\n210\t// A successful handler hands its derivation content back as data; the\n211\t// drain's completion transaction performs the version-checked UPDATE and the\n212\t// item-row deletion atomically (tech design §Mechanics: completion is one\n213\t// short BEGIN IMMEDIATE doing the derivation write and the delete). The handler\n214\t// never opens that transaction itself, so the version check and the\n215\t// done/stale_discarded disposition stay in one place — the queue util.\n216\texport interface HandlerDerivationWrite {\n217\t  subjectKind: SubjectKind;\n218\t  subjectId: string;\n219\t  derivationType: DerivationType;\n220\t  content: string;\n221\t  metadata?: DerivationMetadata;\n222\t  gaps?: DependencyGap[];\n223\t}\n224\t\n225\t// The completion-transaction hook (Story 3): work that must land atomically\n226\t// with the version-checked form writes — chunk placement and the\n227\t// close→summary enqueues above all. The queue util invokes it inside the\n228\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n229\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n230\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n231\t// crash leaves either a placed turn with its enqueues or nothing — never a\n232\t// derived-but-unplaced turn.\n233\texport interface CompletionTx {\n234\t  db: DatabaseSync;\n235\t  onCommit: (fn: () => void) => void;\n236\t}\n237\t\n238\texport type HandlerOutcome =\n239\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n240\t  | { ok: false; retryable: boolean; reason: string }\n241\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n242\t\n243\t// item is the queue util's WorkItemRecord; typed structurally here so the\n244\t// shared layer does not depend on the util's module (and vice versa stays\n245\t// one-directional: tech-utils imports shared).\n246\texport type WorkHandler = (\n247\t  run: HandlerRunContext,\n248\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n249\t) => Promise<HandlerOutcome>;\n250\t"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"d8fc137f-79c5-42d2-8300-1915239afea6","timestamp":"2026-06-15T04:20:29.470Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts","content":"}\n\n// ── provider seam (DD-7) ─────────────────────────────────────────\n// Every operation returns content or a structured failure carrying\n// retryable-or-not; classification is the adapter's duty.\n// Provenance: the three config-known assignment strings, stamped by the\n// inference adapter (it alone knows the assignment) and copied by handlers\n// into form metadata (Epic 05 DD-4). Never derived from model output.\nexport interface ProviderProvenance {\n  provider: string;\n  model: string;\n  prompt: string;\n}\n\nexport type ProviderResult =\n  | { ok: true; text: string; provenance?: ProviderProvenance }\n  | { ok: false; retryable: boolean; reason: string };\n\n// Message kinds a rendering part can carry — mirrors the intake event-kind\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n// rather than imported: shared/ may not import domains/.\nexport type RenderingPartKind =\n  | \"user_prompt\"\n  | \"assistant_text\"\n  | \"assistant_thinking\"\n  | \"runtime_note\"\n  | \"tool_call\"\n  | \"tool_result\";\n\nexport interface RenderingPart {\n  messageId: string;\n  kind: RenderingPartKind;\n  text: string; // ready form content, or raw/truncated fallback\n  fallback: boolean; // true ⇒ gap recorded\n  outcome?: ToolOutcome; // tool activity only\n}\n\nexport interface DerivationProvider {\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult>;\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n  // The two summary inputs differ by contract (AC-3.8): detailed receives\n  // the members' tool-run receipts (what changed, outcome) alongside the\n  // projections; brief receives outcomes only — receipt text is stripped\n  // before the provider is called, so brief structurally cannot leak it.\n  // The receipt fields are optional in the type for callers without member\n  // context (the production chunk handlers always pass them).\n  summarizeChunkDetailed(i: {\n    memberProjections: string[];\n    memberReceipts?: ToolRunReceipt[][];\n  }): Promise<ProviderResult>;\n  summarizeChunkBrief(i: {\n    memberProjections: string[];\n    memberOutcomes?: ToolOutcome[][];\n  }): Promise<ProviderResult>;\n}\n\nexport const PROVIDER_OPERATIONS = [\n  \"smoothPrompt\",\n  \"summarizeToolCall\",\n  \"summarizeToolResult\",\n  \"composeTurnRendering\",\n  \"projectLowerBand\",\n  \"summarizeChunkDetailed\",\n  \"summarizeChunkBrief\",\n] as const;\n\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n\n// ── SDK assembly config (tech design §Interfaces) ────────────────\n// Provider arrival is exactly one of `provider` (direct injection,\n// unchanged — the deterministic test default) or `inference` (host\n// model-call function + per-kind assignments, Epic 05 DD-5). Both or\n// neither is a construction TypeError naming the XOR rule (AC-1.1).\nexport interface SdkConfig {\n  provider?: DerivationProvider;\n  inference?: InferenceConfig;\n  mode: \"background\" | \"manual\";\n  clock?: () => Date;\n  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n  lease?: { durationMs: number }; // 120000\n  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\n}\n\n// Every optional filled by createSdk's central defaults.\nexport interface ResolvedSdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock: () => Date;\n  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  lease: { durationMs: number };\n  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n  view: ResolvedViewConfig;\n}\n\n// ── handler contract (DD-6; the map's value type) ────────────────\nexport interface HandlerRunContext {\n  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n  provider: DerivationProvider;\n  clock: () => Date;\n  config: ResolvedSdkConfig;\n}\n\n// A successful handler hands its derivation content back as data; the\n// drain's completion transaction performs the version-checked UPDATE and the\n// item-row deletion atomically (tech design §Mechanics: completion is one\n// short BEGIN IMMEDIATE doing the derivation write and the delete). The handler\n// never opens that transaction itself, so the version check and the\n// done/stale_discarded disposition stay in one place — the queue util.\nexport interface HandlerDerivationWrite {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  derivationType: DerivationType;\n  content: string;\n  metadata?: DerivationMetadata;\n  gaps?: DependencyGap[];\n}\n\n// The completion-transaction hook (Story 3): work that must land atomically\n// with the version-checked form writes — chunk placement and the\n// close→summary enqueues above all. The queue util invokes it inside the\n// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n// (a stale completion must not place a turn or enqueue summaries); onCommit\n// registrations flush after that COMMIT succeeds and drop on rollback, so a\n// crash leaves either a placed turn with its enqueues or nothing — never a\n// derived-but-unplaced turn.\nexport interface CompletionTx {\n  db: DatabaseSync;\n  onCommit: (fn: () => void) => void;\n}\n\nexport type HandlerOutcome =\n  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n  | { ok: false; retryable: boolean; reason: string }\n  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n\n// item is the queue util's WorkItemRecord; typed structurally here so the\n// shared layer does not depend on the util's module (and vice versa stays\n// one-directional: tech-utils imports shared).\nexport type WorkHandler = (\n  run: HandlerRunContext,\n  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n) => Promise<HandlerOutcome>;\n","numLines":151,"startLine":100,"totalLines":250}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_94a55fdb18834d0abb7282e7","type":"tool_result","content":"1\t// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n2\t// from the mutated subject — the message's own forms, its turn's rendering\n3\t// and projection, the containing chunk's two summaries — clearing each to\n4\t// `pending` at the next source version and enqueueing replacement work, all\n5\t// inside the caller's mutation transaction. The clear-set is derived from\n6\t// the record's structure (the message → turn → chunk walk over the rows that\n7\t// actually exist), never from a hardcoded form list: a future form on any\n8\t// subject in the chain cascades without this module changing. Still-queued\n9\t// old-version items are supersede-deleted (tech design issue 1) and reported\n10\t// on the MutationResult; claimed items are deliberately left to the\n11\t// source-version check (DD-3) — their stale completions discard. The two\n12\t// close paths share one core walk parameterized drop-vs-clear: edit clears\n13\t// the whole chain, delete *drops* the deleted subject's own forms (state\n14\t// rows removed — a deleted source has nothing to rebuild) and clears\n15\t// everything upward for minus-one composition. Turn delete enters at the\n16\t// turn level, dropping the turn's and all live members' forms; a chunk left\n17\t// with no live members drops its summary forms too — dropped, never failed,\n18\t// and no rebuild queued (AC-6.6).\n19\timport type { DatabaseSync } from \"node:sqlite\";\n20\timport type { OperationContext } from \"../../../shared/context.js\";\n21\timport type { DerivationType, SubjectKind } from \"../../../shared/derivation.js\";\n22\timport {\n23\t  enqueue,\n24\t  supersedeQueued,\n25\t  WORK_KIND_REGISTRY,\n26\t  type EnqueueDerivationTarget,\n27\t  type WorkKind,\n28\t  type WorkSourceRef,\n29\t} from \"../../../tech-utils/work-queue/index.js\";\n30\t\n31\t// Each derivation's rebuild queue-site — the owning domains' enqueue mappings,\n32\t// gathered here because the cascade is the one place that re-queues across\n33\t// the whole chain (module responsibility matrix: replacement enqueues for\n34\t// all three mutations live with the cascade). Both turn derivations ride the one\n35\t// turn_derivation item; every other derivation rides its same-named kind.\n36\tconst DERIVATION_REBUILD_KINDS: Record<DerivationType, WorkKind> = {\n37\t  smoothed_prompt: \"prompt_smoothing\",\n38\t  tool_call_summary: \"tool_call_summary\",\n39\t  tool_result_summary: \"tool_result_summary\",\n40\t  turn_rendering: \"turn_derivation\",\n41\t  lower_band_projection: \"turn_derivation\",\n42\t  chunk_summary_detailed: \"chunk_summary_detailed\",\n43\t  chunk_summary_brief: \"chunk_summary_brief\",\n44\t};\n45\t\n46\texport interface CascadeClear {\n47\t  subjectKind: SubjectKind;\n48\t  subjectId: string;\n49\t  derivationType: DerivationType;\n50\t}\n51\t\n52\texport interface CascadeOutcome {\n53\t  cleared: CascadeClear[];\n54\t  dropped: CascadeClear[];\n55\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n56\t  superseded: string[];\n57\t}\n58\t\n59\tinterface ChainSubject {\n60\t  subjectKind: SubjectKind;\n61\t  subjectId: string;\n62\t}\n63\t\n64\tfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n65\t  switch (subject.subjectKind) {\n66\t    case \"message\":\n67\t      return { messageId: subject.subjectId };\n68\t    case \"turn\":\n69\t      return { turnId: subject.subjectId };\n70\t    case \"chunk\":\n71\t      return { chunkId: subject.subjectId };\n72\t  }\n73\t}\n74\t\n75\t// The structural walk: the mutated message's turn from its membership stamp,\n76\t// the turn's chunk from its placement row. Either link may be absent — a gap\n77\t// message has no turn, an unplaced turn no chunk — and the chain simply\n78\t// stops there; reach is structural, not configured. Deliberately unfiltered:\n79\t// the walk runs after a delete stamps its subject, and the chain above a\n80\t// just-deleted record is exactly what must still cascade.\n81\tfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n82\t  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n83\t  const turnRow = db\n84\t    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n85\t    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n86\t  const turnId = turnRow?.turn_id ?? null;\n87\t  if (turnId === null) return subjects;\n88\t  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n89\t  const chunkRow = db\n90\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n91\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n92\t  if (chunkRow !== undefined) {\n93\t    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n94\t  }\n95\t  return subjects;\n96\t}\n97\t\n98\t// The call/result pair as a source dependency (AC-2.8's pair-as-source model,\n99\t// impl-lead ruling epic-fix-001): a tool summary derives from its message AND\n100\t// the paired counterpart, so mutating one half is a source change for the\n101\t// counterpart's summary. Find the live counterpart of a mutated tool message —\n102\t// the opposite block type sharing its toolCallId — as a clear subject, so the\n103\t// cascade clears and re-queues that summary alongside the rest of the chain.\n104\t// Returns nothing when the mutated message carries no tool block, or the\n105\t// counterpart is deleted or absent. The rebuilt summary derives from the live\n106\t// record only: with the deleted-read filter (epic-fix-001), a gone result\n107\t// reverts the call summary's outcome to `unknown`. AC-6.2's \"nothing else\n108\t// changes\" still bounds the cascade across other turns and chunks — only the\n109\t// counterpart message itself, inside the dependency graph, is in scope, so its\n110\t// own turn and chunk are deliberately not walked.\n111\tfunction pairedCounterpartSubject(\n112\t  db: DatabaseSync,\n113\t  messageId: string,\n114\t): ChainSubject | undefined {\n115\t  const own = db\n116\t    .prepare(\n117\t      `SELECT block_type, json_extract(content, '$.toolCallId') AS tool_call_id\n118\t       FROM message_block\n119\t       WHERE message_id = ? AND block_type IN ('tool_call', 'tool_result')\n120\t       LIMIT 1`,\n121\t    )\n122\t    .get(messageId) as unknown as\n123\t    | { block_type: string; tool_call_id: string | null }\n124\t    | undefined;\n125\t  if (own === undefined || own.tool_call_id === null) return undefined;\n126\t  const counterpartType = own.block_type === \"tool_call\" ? \"tool_result\" : \"tool_call\";\n127\t  const row = db\n128\t    .prepare(\n129\t      `SELECT m.message_id FROM message_block b\n130\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n131\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n132\t         AND m.message_id <> ?\n133\t       ORDER BY m.source_event_order LIMIT 1`,\n134\t    )\n135\t    .get(counterpartType, own.tool_call_id, messageId) as unknown as\n136\t    | { message_id: string }\n137\t    | undefined;\n138\t  if (row === undefined) return undefined;\n139\t  return { subjectKind: \"message\", subjectId: row.message_id };\n140\t}\n141\t\n142\tinterface RebuildGroup {\n143\t  subject: ChainSubject;\n144\t  kind: WorkKind;\n145\t  forms: EnqueueFormTarget[];\n146\t  maxSourceVersion: number;\n147\t}\n148\t\n149\tfunction rebuildKindFor(form: string): WorkKind {\n150\t  const kind = FORM_REBUILD_KINDS[form as FormKind];\n151\t  if (kind === undefined) {\n152\t    // Every form names its queue site above; a miss is a wiring bug.\n153\t    throw new Error(`no rebuild work kind mapped for derived form ${form}`);\n154\t  }\n155\t  return kind;\n156\t}\n157\t\n158\t// The shared core (DD-8's one cascade, parameterized): drop subjects lose\n159\t// their form rows outright; clear subjects go pending at the next source\n160\t// version with replacement work enqueued. Supersede-deletes land before the\n161\t// replacement enqueues so a tidied id can never collide, and queued items\n162\t// against dropped subjects are tidied with no replacement — dead work for a\n163\t// source that no longer reads.\n164\tfunction runCascade(\n165\t  ctx: OperationContext,\n166\t  dropSubjects: readonly ChainSubject[],\n167\t  clearSubjects: readonly ChainSubject[],\n168\t): CascadeOutcome {\n169\t  const readForms = ctx.db.prepare(\n170\t    `SELECT form, source_version FROM derived_form\n171\t     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n172\t  );\n173\t\n174\t  const dropped: CascadeClear[] = [];\n175\t  const supersedeTargets: Array<{ kind: WorkKind; sourceRef: WorkSourceRef }> = [];\n176\t  const dropRows = ctx.db.prepare(\n177\t    `DELETE FROM derived_form WHERE subject_kind = ? AND subject_id = ?`,\n178\t  );\n179\t  for (const subject of dropSubjects) {\n180\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n181\t      form: string;\n182\t    }>;\n183\t    const kinds = new Set<WorkKind>();\n184\t    for (const row of rows) {\n185\t      dropped.push({ ...subject, form: row.form as FormKind });\n186\t      kinds.add(rebuildKindFor(row.form));\n187\t    }\n188\t    for (const kind of kinds) {\n189\t      supersedeTargets.push({ kind, sourceRef: sourceRefFor(subject) });\n190\t    }\n191\t    dropRows.run(subject.subjectKind, subject.subjectId);\n192\t  }\n193\t\n194\t  const cleared: CascadeClear[] = [];\n195\t  const groups = new Map<string, RebuildGroup>();\n196\t  for (const subject of clearSubjects) {\n197\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n198\t      form: string;\n199\t      source_version: number | bigint;\n200\t    }>;\n201\t    for (const row of rows) {\n202\t      const form = row.form as FormKind;\n203\t      cleared.push({ ...subject, form });\n204\t      const kind = rebuildKindFor(row.form);\n205\t      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n206\t      const group = groups.get(key) ?? {\n207\t        subject,\n208\t        kind,\n209\t        forms: [],\n210\t        maxSourceVersion: 0,\n211\t      };\n212\t      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n213\t      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n214\t      groups.set(key, group);\n215\t    }\n216\t  }\n217\t\n218\t  const superseded = supersedeQueued(ctx.db, [\n219\t    ...supersedeTargets,\n220\t    ...[...groups.values()].map((group) => ({\n221\t      kind: group.kind,\n222\t      sourceRef: sourceRefFor(group.subject),\n223\t    })),\n224\t  ]);\n225\t\n226\t  const queued = [...groups.values()].map((group) => {\n227\t    const item = enqueue(ctx, {\n228\t      owner: WORK_KIND_REGISTRY[group.kind].owner,\n229\t      kind: group.kind,\n230\t      sourceRef: sourceRefFor(group.subject),\n231\t      sourceVersion: group.maxSourceVersion + 1,\n232\t      forms: group.forms,\n233\t    });\n234\t    return { workItemId: item.workItemId, kind: group.kind };\n235\t  });\n236\t\n237\t  return { cleared, dropped, queued, superseded };\n238\t}\n239\t\n240\t// Edit's close path: clear-and-requeue for the full chain above (and\n241\t// including) the edited message, inside the mutation's ambient transaction.\n242\t// A call/result pair counterpart (epic-fix-001) joins the clear set: editing\n243\t// one half is a source change for the other's summary.\n244\texport function cascadeFromMessage(\n245\t  ctx: OperationContext,\n246\t  messageId: string,\n247\t): CascadeOutcome {\n248\t  const clear = chainSubjects(ctx.db, messageId);\n249\t  const counterpart = pairedCounterpartSubject(ctx.db, messageId);\n250\t  if (counterpart !== undefined) clear.push(counterpart);\n251\t  return runCascade(ctx, [], clear);\n252\t}\n253\t\n254\t// Message delete's close path (Flow 6): the deleted message's own forms\n255\t// drop; its turn and chunk clear and re-queue for minus-one composition.\n256\t// The message-delete validation refuses turn-initiating prompts, so the turn\n257\t// always keeps members and never empties through this path.\n258\texport function cascadeMessageDelete(\n259\t  ctx: OperationContext,\n260\t  messageId: string,\n261\t): CascadeOutcome {\n262\t  const [own, ...upward] = chainSubjects(ctx.db, messageId);\n263\t  // The deleted half's live pair counterpart re-derives from the live record\n264\t  // (epic-fix-001): its summary clears and re-queues, reverting outcome to\n265\t  // `unknown` for a call whose result is now gone.\n266\t  const counterpart = pairedCounterpartSubject(ctx.db, messageId);\n267\t  if (counterpart !== undefined) upward.push(counterpart);\n268\t  return runCascade(ctx, own === undefined ? [] : [own], upward);\n269\t}\n270\t\n271\t// Turn delete's close path (Flow 6): the turn's forms and every live\n272\t// member's forms drop — the drop-set walk goes down as well as up — and the\n273\t// containing chunk clears and re-queues from its remaining live members.\n274\t// A chunk left empty drops its summary forms instead: nothing remains to\n275\t// summarize, so the forms are removed, never failed, and no rebuild queues\n276\t// (AC-6.6). Runs after the delete stamps land, so the live-member count\n277\t// already excludes the deleted turn. Membership rows are untouched —\n278\t// shrink-only: reads filter deleted turns; boundaries never re-cut.\n279\t//\n280\t// REVERIFY-02-001: the call/result pair is a source dependency (epic-fix-001),\n281\t// and this third cascade caller honored it nowhere — a cross-turn pair is\n282\t// reachable when a late result lands in a later turn. Deleting a member whose\n283\t// counterpart lives in another (still-live) turn is a source change for that\n284\t// counterpart's tool-activity summary, so each deleted member's live\n285\t// counterpart joins the clear set and re-derives from the now-deleted record\n286\t// (its outcome reverts to `unknown`). Same-turn counterparts are skipped: they\n287\t// are themselves deleted members (the live-read filter already excludes them,\n288\t// and we drop them explicitly), so they belong to the drop set, not the clear\n289\t// set. AC-6.2's \"nothing else changes\" still bounds the cascade across other\n290\t// turns/chunks — only the counterpart message, inside the dependency graph, is\n291\t// pulled in; its own turn and chunk are deliberately not walked.\n292\texport function cascadeTurnDelete(\n293\t  ctx: OperationContext,\n294\t  turnId: string,\n295\t  memberMessageIds: readonly string[],\n296\t): CascadeOutcome {\n297\t  const drop: ChainSubject[] = [\n298\t    ...memberMessageIds.map((messageId): ChainSubject => ({\n299\t      subjectKind: \"message\",\n300\t      subjectId: messageId,\n301\t    })),\n302\t    { subjectKind: \"turn\", subjectId: turnId },\n303\t  ];\n304\t  const memberSet = new Set(memberMessageIds);\n305\t  const counterparts = new Map<string, ChainSubject>();\n306\t  for (const messageId of memberMessageIds) {\n307\t    const counterpart = pairedCounterpartSubject(ctx.db, messageId);\n308\t    if (counterpart !== undefined && !memberSet.has(counterpart.subjectId)) {\n309\t      counterparts.set(counterpart.subjectId, counterpart);\n310\t    }\n311\t  }\n312\t  const counterpartClears = [...counterparts.values()];\n313\t  const chunkRow = ctx.db\n314\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n315\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n316\t  if (chunkRow === undefined) return runCascade(ctx, drop, counterpartClears);\n317\t  const chunk: ChainSubject = { subjectKind: \"chunk\", subjectId: chunkRow.chunk_id };\n318\t  const remaining = ctx.db\n319\t    .prepare(\n320\t      `SELECT COUNT(*) AS n FROM chunk_member cm\n321\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n322\t       WHERE cm.chunk_id = ?`,\n323\t    )\n324\t    .get(chunkRow.chunk_id) as unknown as { n: number | bigint };\n325\t  return Number(remaining.n) > 0\n326\t    ? runCascade(ctx, drop, [chunk, ...counterpartClears])\n327\t    : runCascade(ctx, [...drop, chunk], counterpartClears);\n328\t}\n329\t"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"4b3d8d6e-47d0-485d-90c0-dedfca64cbe5","timestamp":"2026-06-15T04:31:21.678Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/cascade.ts","content":"// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n// from the mutated subject — the message's own forms, its turn's rendering\n// and projection, the containing chunk's two summaries — clearing each to\n// `pending` at the next source version and enqueueing replacement work, all\n// inside the caller's mutation transaction. The clear-set is derived from\n// the record's structure (the message → turn → chunk walk over the rows that\n// actually exist), never from a hardcoded form list: a future form on any\n// subject in the chain cascades without this module changing. Still-queued\n// old-version items are supersede-deleted (tech design issue 1) and reported\n// on the MutationResult; claimed items are deliberately left to the\n// source-version check (DD-3) — their stale completions discard. The two\n// close paths share one core walk parameterized drop-vs-clear: edit clears\n// the whole chain, delete *drops* the deleted subject's own forms (state\n// rows removed — a deleted source has nothing to rebuild) and clears\n// everything upward for minus-one composition. Turn delete enters at the\n// turn level, dropping the turn's and all live members' forms; a chunk left\n// with no live members drops its summary forms too — dropped, never failed,\n// and no rebuild queued (AC-6.6).\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../../shared/context.js\";\nimport type { DerivationType, SubjectKind } from \"../../../shared/derivation.js\";\nimport {\n  enqueue,\n  supersedeQueued,\n  WORK_KIND_REGISTRY,\n  type EnqueueDerivationTarget,\n  type WorkKind,\n  type WorkSourceRef,\n} from \"../../../tech-utils/work-queue/index.js\";\n\n// Each derivation's rebuild queue-site — the owning domains' enqueue mappings,\n// gathered here because the cascade is the one place that re-queues across\n// the whole chain (module responsibility matrix: replacement enqueues for\n// all three mutations live with the cascade). Both turn derivations ride the one\n// turn_derivation item; every other derivation rides its same-named kind.\nconst DERIVATION_REBUILD_KINDS: Record<DerivationType, WorkKind> = {\n  smoothed_prompt: \"prompt_smoothing\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n  turn_rendering: \"turn_derivation\",\n  lower_band_projection: \"turn_derivation\",\n  chunk_summary_detailed: \"chunk_summary_detailed\",\n  chunk_summary_brief: \"chunk_summary_brief\",\n};\n\nexport interface CascadeClear {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  derivationType: DerivationType;\n}\n\nexport interface CascadeOutcome {\n  cleared: CascadeClear[];\n  dropped: CascadeClear[];\n  queued: Array<{ workItemId: string; kind: WorkKind }>;\n  superseded: string[];\n}\n\ninterface ChainSubject {\n  subjectKind: SubjectKind;\n  subjectId: string;\n}\n\nfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n  switch (subject.subjectKind) {\n    case \"message\":\n      return { messageId: subject.subjectId };\n    case \"turn\":\n      return { turnId: subject.subjectId };\n    case \"chunk\":\n      return { chunkId: subject.subjectId };\n  }\n}\n\n// The structural walk: the mutated message's turn from its membership stamp,\n// the turn's chunk from its placement row. Either link may be absent — a gap\n// message has no turn, an unplaced turn no chunk — and the chain simply\n// stops there; reach is structural, not configured. Deliberately unfiltered:\n// the walk runs after a delete stamps its subject, and the chain above a\n// just-deleted record is exactly what must still cascade.\nfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n  const turnRow = db\n    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n  const turnId = turnRow?.turn_id ?? null;\n  if (turnId === null) return subjects;\n  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n  const chunkRow = db\n    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n    .get(turnId) as unknown as { chunk_id: string } | undefined;\n  if (chunkRow !== undefined) {\n    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n  }\n  return subjects;\n}\n\n// The call/result pair as a source dependency (AC-2.8's pair-as-source model,\n// impl-lead ruling epic-fix-001): a tool summary derives from its message AND\n// the paired counterpart, so mutating one half is a source change for the\n// counterpart's summary. Find the live counterpart of a mutated tool message —\n// the opposite block type sharing its toolCallId — as a clear subject, so the\n// cascade clears and re-queues that summary alongside the rest of the chain.\n// Returns nothing when the mutated message carries no tool block, or the\n// counterpart is deleted or absent. The rebuilt summary derives from the live\n// record only: with the deleted-read filter (epic-fix-001), a gone result\n// reverts the call summary's outcome to `unknown`. AC-6.2's \"nothing else\n// changes\" still bounds the cascade across other turns and chunks — only the\n// counterpart message itself, inside the dependency graph, is in scope, so its\n// own turn and chunk are deliberately not walked.\nfunction pairedCounterpartSubject(\n  db: DatabaseSync,\n  messageId: string,\n): ChainSubject | undefined {\n  const own = db\n    .prepare(\n      `SELECT block_type, json_extract(content, '$.toolCallId') AS tool_call_id\n       FROM message_block\n       WHERE message_id = ? AND block_type IN ('tool_call', 'tool_result')\n       LIMIT 1`,\n    )\n    .get(messageId) as unknown as\n    | { block_type: string; tool_call_id: string | null }\n    | undefined;\n  if (own === undefined || own.tool_call_id === null) return undefined;\n  const counterpartType = own.block_type === \"tool_call\" ? \"tool_result\" : \"tool_call\";\n  const row = db\n    .prepare(\n      `SELECT m.message_id FROM message_block b\n       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n         AND m.message_id <> ?\n       ORDER BY m.source_event_order LIMIT 1`,\n    )\n    .get(counterpartType, own.tool_call_id, messageId) as unknown as\n    | { message_id: string }\n    | undefined;\n  if (row === undefined) return undefined;\n  return { subjectKind: \"message\", subjectId: row.message_id };\n}\n\ninterface RebuildGroup {\n  subject: ChainSubject;\n  kind: WorkKind;\n  forms: EnqueueFormTarget[];\n  maxSourceVersion: number;\n}\n\nfunction rebuildKindFor(form: string): WorkKind {\n  const kind = FORM_REBUILD_KINDS[form as FormKind];\n  if (kind === undefined) {\n    // Every form names its queue site above; a miss is a wiring bug.\n    throw new Error(`no rebuild work kind mapped for derived form ${form}`);\n  }\n  return kind;\n}\n\n// The shared core (DD-8's one cascade, parameterized): drop subjects lose\n// their form rows outright; clear subjects go pending at the next source\n// version with replacement work enqueued. Supersede-deletes land before the\n// replacement enqueues so a tidied id can never collide, and queued items\n// against dropped subjects are tidied with no replacement — dead work for a\n// source that no longer reads.\nfunction runCascade(\n  ctx: OperationContext,\n  dropSubjects: readonly ChainSubject[],\n  clearSubjects: readonly ChainSubject[],\n): CascadeOutcome {\n  const readForms = ctx.db.prepare(\n    `SELECT form, source_version FROM derived_form\n     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n  );\n\n  const dropped: CascadeClear[] = [];\n  const supersedeTargets: Array<{ kind: WorkKind; sourceRef: WorkSourceRef }> = [];\n  const dropRows = ctx.db.prepare(\n    `DELETE FROM derived_form WHERE subject_kind = ? AND subject_id = ?`,\n  );\n  for (const subject of dropSubjects) {\n    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n      form: string;\n    }>;\n    const kinds = new Set<WorkKind>();\n    for (const row of rows) {\n      dropped.push({ ...subject, form: row.form as FormKind });\n      kinds.add(rebuildKindFor(row.form));\n    }\n    for (const kind of kinds) {\n      supersedeTargets.push({ kind, sourceRef: sourceRefFor(subject) });\n    }\n    dropRows.run(subject.subjectKind, subject.subjectId);\n  }\n\n  const cleared: CascadeClear[] = [];\n  const groups = new Map<string, RebuildGroup>();\n  for (const subject of clearSubjects) {\n    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n      form: string;\n      source_version: number | bigint;\n    }>;\n    for (const row of rows) {\n      const form = row.form as FormKind;\n      cleared.push({ ...subject, form });\n      const kind = rebuildKindFor(row.form);\n      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n      const group = groups.get(key) ?? {\n        subject,\n        kind,\n        forms: [],\n        maxSourceVersion: 0,\n      };\n      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n      groups.set(key, group);\n    }\n  }\n\n  const superseded = supersedeQueued(ctx.db, [\n    ...supersedeTargets,\n    ...[...groups.values()].map((group) => ({\n      kind: group.kind,\n      sourceRef: sourceRefFor(group.subject),\n    })),\n  ]);\n\n  const queued = [...groups.values()].map((group) => {\n    const item = enqueue(ctx, {\n      owner: WORK_KIND_REGISTRY[group.kind].owner,\n      kind: group.kind,\n      sourceRef: sourceRefFor(group.subject),\n      sourceVersion: group.maxSourceVersion + 1,\n      forms: group.forms,\n    });\n    return { workItemId: item.workItemId, kind: group.kind };\n  });\n\n  return { cleared, dropped, queued, superseded };\n}\n\n// Edit's close path: clear-and-requeue for the full chain above (and\n// including) the edited message, inside the mutation's ambient transaction.\n// A call/result pair counterpart (epic-fix-001) joins the clear set: editing\n// one half is a source change for the other's summary.\nexport function cascadeFromMessage(\n  ctx: OperationContext,\n  messageId: string,\n): CascadeOutcome {\n  const clear = chainSubjects(ctx.db, messageId);\n  const counterpart = pairedCounterpartSubject(ctx.db, messageId);\n  if (counterpart !== undefined) clear.push(counterpart);\n  return runCascade(ctx, [], clear);\n}\n\n// Message delete's close path (Flow 6): the deleted message's own forms\n// drop; its turn and chunk clear and re-queue for minus-one composition.\n// The message-delete validation refuses turn-initiating prompts, so the turn\n// always keeps members and never empties through this path.\nexport function cascadeMessageDelete(\n  ctx: OperationContext,\n  messageId: string,\n): CascadeOutcome {\n  const [own, ...upward] = chainSubjects(ctx.db, messageId);\n  // The deleted half's live pair counterpart re-derives from the live record\n  // (epic-fix-001): its summary clears and re-queues, reverting outcome to\n  // `unknown` for a call whose result is now gone.\n  const counterpart = pairedCounterpartSubject(ctx.db, messageId);\n  if (counterpart !== undefined) upward.push(counterpart);\n  return runCascade(ctx, own === undefined ? [] : [own], upward);\n}\n\n// Turn delete's close path (Flow 6): the turn's forms and every live\n// member's forms drop — the drop-set walk goes down as well as up — and the\n// containing chunk clears and re-queues from its remaining live members.\n// A chunk left empty drops its summary forms instead: nothing remains to\n// summarize, so the forms are removed, never failed, and no rebuild queues\n// (AC-6.6). Runs after the delete stamps land, so the live-member count\n// already excludes the deleted turn. Membership rows are untouched —\n// shrink-only: reads filter deleted turns; boundaries never re-cut.\n//\n// REVERIFY-02-001: the call/result pair is a source dependency (epic-fix-001),\n// and this third cascade caller honored it nowhere — a cross-turn pair is\n// reachable when a late result lands in a later turn. Deleting a member whose\n// counterpart lives in another (still-live) turn is a source change for that\n// counterpart's tool-activity summary, so each deleted member's live\n// counterpart joins the clear set and re-derives from the now-deleted record\n// (its outcome reverts to `unknown`). Same-turn counterparts are skipped: they\n// are themselves deleted members (the live-read filter already excludes them,\n// and we drop them explicitly), so they belong to the drop set, not the clear\n// set. AC-6.2's \"nothing else changes\" still bounds the cascade across other\n// turns/chunks — only the counterpart message, inside the dependency graph, is\n// pulled in; its own turn and chunk are deliberately not walked.\nexport function cascadeTurnDelete(\n  ctx: OperationContext,\n  turnId: string,\n  memberMessageIds: readonly string[],\n): CascadeOutcome {\n  const drop: ChainSubject[] = [\n    ...memberMessageIds.map((messageId): ChainSubject => ({\n      subjectKind: \"message\",\n      subjectId: messageId,\n    })),\n    { subjectKind: \"turn\", subjectId: turnId },\n  ];\n  const memberSet = new Set(memberMessageIds);\n  const counterparts = new Map<string, ChainSubject>();\n  for (const messageId of memberMessageIds) {\n    const counterpart = pairedCounterpartSubject(ctx.db, messageId);\n    if (counterpart !== undefined && !memberSet.has(counterpart.subjectId)) {\n      counterparts.set(counterpart.subjectId, counterpart);\n    }\n  }\n  const counterpartClears = [...counterparts.values()];\n  const chunkRow = ctx.db\n    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n    .get(turnId) as unknown as { chunk_id: string } | undefined;\n  if (chunkRow === undefined) return runCascade(ctx, drop, counterpartClears);\n  const chunk: ChainSubject = { subjectKind: \"chunk\", subjectId: chunkRow.chunk_id };\n  const remaining = ctx.db\n    .prepare(\n      `SELECT COUNT(*) AS n FROM chunk_member cm\n       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n       WHERE cm.chunk_id = ?`,\n    )\n    .get(chunkRow.chunk_id) as unknown as { n: number | bigint };\n  return Number(remaining.n) > 0\n    ? runCascade(ctx, drop, [chunk, ...counterpartClears])\n    : runCascade(ctx, [...drop, chunk], counterpartClears);\n}\n","numLines":329,"startLine":1,"totalLines":329}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cab84258930546bfa67545d1","type":"tool_result","content":"1\timport { DatabaseSync } from \"node:sqlite\";\n2\t\n3\texport interface Migration {\n4\t  version: number; // 1-based, strictly increasing\n5\t  statements: readonly string[];\n6\t}\n7\t\n8\texport function openDatabase(path: string): DatabaseSync {\n9\t  const db = new DatabaseSync(path);\n10\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n11\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n12\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n13\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n14\t  return db;\n15\t}\n16\t\n17\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\n18\t// on the existing work_item table, the derived_form state table, the chunk\n19\t// tables, and the projection-level delete stamps. The whole epic's schema\n20\t// lands in one version — behavior arrives story by story. Assembled into the\n21\t// thread-file migration history by threads/internal/create.ts.\n22\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n23\t  // claim mechanics on the existing table (DD-1: no disposition column —\n24\t  // queue rows are live work only; terminal rows are deleted and their\n25\t  // outcomes reported in-memory; durable outcome state lives on derived_form)\n26\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n27\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n28\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n29\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n30\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n31\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n32\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n33\t  // inside an index definition, so the index covers the two real columns and\n34\t  // claimNext's ORDER BY rowid walks the head as before.\n35\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n36\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n37\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\n38\t  // call id — never a block scan (anti-shim requirement).\n39\t  `CREATE INDEX idx_message_block_tool_call_id\n40\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n41\t  `CREATE TABLE derived_form (\n42\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n43\t    subject_id   TEXT NOT NULL,\n44\t    form         TEXT NOT NULL,\n45\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n46\t    content      TEXT,\n47\t    reason       TEXT,\n48\t    metadata     TEXT,\n49\t    source_version INTEGER NOT NULL DEFAULT 1,\n50\t    gaps         TEXT,\n51\t    derived_at   TEXT,\n52\t    PRIMARY KEY (subject_kind, subject_id, form)\n53\t  );`,\n54\t  `CREATE TABLE chunk (\n55\t    chunk_id     TEXT PRIMARY KEY,\n56\t    chunk_order  INTEGER NOT NULL UNIQUE,\n57\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n58\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n59\t  );`,\n60\t  `CREATE TABLE chunk_member (\n61\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n62\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n63\t    member_idx INTEGER NOT NULL,\n64\t    PRIMARY KEY (chunk_id, member_idx)\n65\t  );`,\n66\t  // projection-level delete (the record keeps everything; reads filter)\n67\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n68\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n69\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\n70\t  // UPDATE-only completion finds them (row missing must mean deleted).\n71\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n72\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n73\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n74\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n75\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n76\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n77\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n78\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n79\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n80\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n81\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n82\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n83\t];\n84\t\n85\t// Epic 03's single migration (tech design §Storage): the thread-view\n86\t// snapshot tables and the visibility boundary, living beside the record they\n87\t// render so a thread file stays self-contained and snapshot-portable.\n88\t// Singletons are CHECK-enforced structurally: one active view, one boundary\n89\t// row per thread. Assembled into the thread-file migration history by\n90\t// threads/internal/create.ts, like v5.\n91\texport const MIGRATION_V6_STATEMENTS: readonly string[] = [\n92\t  `CREATE TABLE thread_view (\n93\t    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\n94\t    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\n95\t    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\n96\t    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\n97\t    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\n98\t    profile_name TEXT,                   -- null when explicit params\n99\t    config_json TEXT NOT NULL,           -- resolved bound + percentages\n100\t    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, formUsed, degraded}\n101\t    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\n102\t    source_state_json TEXT NOT NULL      -- {maxEventOrder, formCounts} the compact saw — receipt/debug\n103\t  );`,\n104\t  `CREATE TABLE thread_view_band (\n105\t    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\n106\t    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\n107\t    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\n108\t    token_count INTEGER NOT NULL,\n109\t    PRIMARY KEY (view_id, band)\n110\t  );`,\n111\t  `CREATE TABLE view_boundary (\n112\t    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\n113\t    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\n114\t    updated_at TEXT NOT NULL\n115\t  );`,\n116\t  // Seed at position 0 (everything full) — the boundary row exists from\n117\t  // migration on, so the advance and the compact reset are UPDATE-only.\n118\t  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\n119\t    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\n120\t];\n121\t\n122\texport function getSchemaVersion(db: DatabaseSync): number {\n123\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n124\t    | { user_version: number | bigint }\n125\t    | undefined;\n126\t  return Number(row?.user_version ?? 0);\n127\t}\n128\t\n129\texport function runMigrations(\n130\t  db: DatabaseSync,\n131\t  migrations: readonly Migration[],\n132\t): void {\n133\t  let current = getSchemaVersion(db);\n134\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n135\t  for (const migration of ordered) {\n136\t    if (migration.version <= current) continue;\n137\t    db.exec(\"BEGIN IMMEDIATE;\");\n138\t    try {\n139\t      for (const statement of migration.statements) db.exec(statement);\n140\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n141\t      db.exec(\"COMMIT;\");\n142\t    } catch (cause) {\n143\t      db.exec(\"ROLLBACK;\");\n144\t      throw cause;\n145\t    }\n146\t    current = migration.version;\n147\t  }\n148\t}\n149\t"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"f087f592-b095-4f4d-b388-fa6f6c20fe9b","timestamp":"2026-06-15T04:19:19.135Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/storage.ts","content":"import { DatabaseSync } from \"node:sqlite\";\n\nexport interface Migration {\n  version: number; // 1-based, strictly increasing\n  statements: readonly string[];\n}\n\nexport function openDatabase(path: string): DatabaseSync {\n  const db = new DatabaseSync(path);\n  db.exec(\"PRAGMA journal_mode = WAL;\");\n  db.exec(\"PRAGMA foreign_keys = ON;\");\n  db.exec(\"PRAGMA busy_timeout = 5000;\");\n  db.exec(\"PRAGMA synchronous = NORMAL;\");\n  return db;\n}\n\n// Epic 02's single migration (tech design §Storage): queue mechanical fields\n// on the existing work_item table, the derived_form state table, the chunk\n// tables, and the projection-level delete stamps. The whole epic's schema\n// lands in one version — behavior arrives story by story. Assembled into the\n// thread-file migration history by threads/internal/create.ts.\nexport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n  // claim mechanics on the existing table (DD-1: no disposition column —\n  // queue rows are live work only; terminal rows are deleted and their\n  // outcomes reported in-memory; durable outcome state lives on derived_form)\n  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n  // inside an index definition, so the index covers the two real columns and\n  // claimNext's ORDER BY rowid walks the head as before.\n  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n  // and intake's AC-2.8 late-result lookup are each one indexed query by\n  // call id — never a block scan (anti-shim requirement).\n  `CREATE INDEX idx_message_block_tool_call_id\n     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n  `CREATE TABLE derived_form (\n    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    subject_id   TEXT NOT NULL,\n    form         TEXT NOT NULL,\n    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    content      TEXT,\n    reason       TEXT,\n    metadata     TEXT,\n    source_version INTEGER NOT NULL DEFAULT 1,\n    gaps         TEXT,\n    derived_at   TEXT,\n    PRIMARY KEY (subject_kind, subject_id, form)\n  );`,\n  `CREATE TABLE chunk (\n    chunk_id     TEXT PRIMARY KEY,\n    chunk_order  INTEGER NOT NULL UNIQUE,\n    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n  );`,\n  `CREATE TABLE chunk_member (\n    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    member_idx INTEGER NOT NULL,\n    PRIMARY KEY (chunk_id, member_idx)\n  );`,\n  // projection-level delete (the record keeps everything; reads filter)\n  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n  // F-02 backfill: pending form rows for work queued before v5 existed, so\n  // UPDATE-only completion finds them (row missing must mean deleted).\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n];\n\n// Epic 03's single migration (tech design §Storage): the thread-view\n// snapshot tables and the visibility boundary, living beside the record they\n// render so a thread file stays self-contained and snapshot-portable.\n// Singletons are CHECK-enforced structurally: one active view, one boundary\n// row per thread. Assembled into the thread-file migration history by\n// threads/internal/create.ts, like v5.\nexport const MIGRATION_V6_STATEMENTS: readonly string[] = [\n  `CREATE TABLE thread_view (\n    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\n    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\n    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\n    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\n    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\n    profile_name TEXT,                   -- null when explicit params\n    config_json TEXT NOT NULL,           -- resolved bound + percentages\n    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, formUsed, degraded}\n    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\n    source_state_json TEXT NOT NULL      -- {maxEventOrder, formCounts} the compact saw — receipt/debug\n  );`,\n  `CREATE TABLE thread_view_band (\n    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\n    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\n    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\n    token_count INTEGER NOT NULL,\n    PRIMARY KEY (view_id, band)\n  );`,\n  `CREATE TABLE view_boundary (\n    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\n    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\n    updated_at TEXT NOT NULL\n  );`,\n  // Seed at position 0 (everything full) — the boundary row exists from\n  // migration on, so the advance and the compact reset are UPDATE-only.\n  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\n    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\n];\n\nexport function getSchemaVersion(db: DatabaseSync): number {\n  const row = db.prepare(\"PRAGMA user_version\").get() as\n    | { user_version: number | bigint }\n    | undefined;\n  return Number(row?.user_version ?? 0);\n}\n\nexport function runMigrations(\n  db: DatabaseSync,\n  migrations: readonly Migration[],\n): void {\n  let current = getSchemaVersion(db);\n  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n  for (const migration of ordered) {\n    if (migration.version <= current) continue;\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      for (const statement of migration.statements) db.exec(statement);\n      db.exec(`PRAGMA user_version = ${migration.version};`);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    current = migration.version;\n  }\n}\n","numLines":149,"startLine":1,"totalLines":149}}}

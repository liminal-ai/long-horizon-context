{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_419815c387174f17afc6aeb6","type":"tool_result","content":"130\t  tool_call: \"tool_call_summary\",\n131\t  tool_result: \"tool_result_summary\",\n132\t};\n133\t\n134\t// Which derived form each message-owned kind produces — the owning domain's\n135\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n136\t// rides the same transaction (DD-5).\n137\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, DerivationType>> = {\n138\t  prompt_smoothing: \"smoothed_prompt\",\n139\t  tool_call_summary: \"tool_call_summary\",\n140\t  tool_result_summary: \"tool_result_summary\",\n141\t};\n142\t\n143\t// Message-owned work handlers, merged into the SDK's dispatch map at\n144\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n145\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n146\t  messageWorkHandlers;\n147\t\n148\texport function queueMessageWork(\n149\t  ctx: OperationContext,\n150\t  message: MessageCreated,\n151\t): WorkItemRecord[] {\n152\t  if (message === null) return [];\n153\t  const items: WorkItemRecord[] = [];\n154\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n155\t  if (kind !== undefined) {\n156\t    const form = MESSAGE_WORK_FORMS[kind];\n157\t    if (form === undefined) {\n158\t      // Every queuing kind names its form above; a miss is a wiring bug.\n159\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n160\t    }\n161\t    items.push(\n162\t      enqueue(ctx, {\n163\t        owner: \"messages\",\n164\t        kind,\n165\t        sourceRef: { messageId: message.messageId },\n166\t        derivations: [{ subjectKind: \"message\", subjectId: message.messageId, derivationType: form }],\n167\t      }),\n168\t    );\n169\t  }\n170\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n171\t  // summary already derived with outcome \"unknown\" means the summary's\n172\t  // source — the call+result pair — completed underneath it; clear and\n173\t  // regenerate at the next source version, in this same batch transaction.\n174\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n175\t  // the common call-and-result-in-one-batch case never triggers, and the\n176\t  // version-scoped item id keeps the requeue idempotent.\n177\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n178\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n179\t    if (stale !== undefined) {"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"3b721131-5a19-46f3-b905-41fffc626c72","timestamp":"2026-06-15T04:27:55.914Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"  tool_call: \"tool_call_summary\",\n  tool_result: \"tool_result_summary\",\n};\n\n// Which derived form each message-owned kind produces — the owning domain's\n// knowledge, handed to the meaning-blind enqueue so the form's pending row\n// rides the same transaction (DD-5).\nconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, DerivationType>> = {\n  prompt_smoothing: \"smoothed_prompt\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Message-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6): prompt smoothing and the two tool-activity summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n  messageWorkHandlers;\n\nexport function queueMessageWork(\n  ctx: OperationContext,\n  message: MessageCreated,\n): WorkItemRecord[] {\n  if (message === null) return [];\n  const items: WorkItemRecord[] = [];\n  const kind = MESSAGE_WORK_KINDS[message.kind];\n  if (kind !== undefined) {\n    const form = MESSAGE_WORK_FORMS[kind];\n    if (form === undefined) {\n      // Every queuing kind names its form above; a miss is a wiring bug.\n      throw new Error(`no derived form mapped for message work kind ${kind}`);\n    }\n    items.push(\n      enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef: { messageId: message.messageId },\n        derivations: [{ subjectKind: \"message\", subjectId: message.messageId, derivationType: form }],\n      }),\n    );\n  }\n  // Late-result repair (AC-2.8): a tool result landing after its call's\n  // summary already derived with outcome \"unknown\" means the summary's\n  // source — the call+result pair — completed underneath it; clear and\n  // regenerate at the next source version, in this same batch transaction.\n  // One indexed lookup; pending summaries (metadata NULL) never match, so\n  // the common call-and-result-in-one-batch case never triggers, and the\n  // version-scoped item id keeps the requeue idempotent.\n  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n    if (stale !== undefined) {","numLines":50,"startLine":130,"totalLines":706}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3a0db140ee4f4481bfdbc299","type":"tool_result","content":"1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n2\t// source message and the call-id pairing reads — the only reach a\n3\t// message-level handler has beyond its own message (AC-2.5). Also the\n4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n5\t// indexed query by call id, never a scan (the v5 expression index on\n6\t// message_block covers it) and never a drain-time sweep or read-time join.\n7\t// Completion writes for message derivation_types ride the work-queue util's `complete`\n8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n9\t// Read-back of message-owned derivation_type rows (the listMessages join) also lives\n10\t// here: stored state returned as stored — never re-derived on read.\n11\timport type { DatabaseSync } from \"node:sqlite\";\n12\timport type {\n13\t  DependencyGap,\n14\t  Derivation,\n15\t  DerivationMetadata,\n16\t  DerivationState,\n17\t  DerivationType,\n18\t  DerivationReportEntry,\n19\t} from \"../../../shared/derivation.js\";\n20\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n21\t\n22\texport interface MessageSource {\n23\t  messageId: string;\n24\t  kind: string;\n25\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n26\t}\n27\t\n28\texport function readMessageSource(\n29\t  db: DatabaseSync,\n30\t  messageId: string,\n31\t): MessageSource | undefined {\n32\t  const row = db\n33\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n34\t    .get(messageId) as unknown as { kind: string } | undefined;\n35\t  if (row === undefined) return undefined;\n36\t  const blocks = db\n37\t    .prepare(\n38\t      `SELECT block_type, content FROM message_block\n39\t       WHERE message_id = ? ORDER BY block_index`,\n40\t    )\n41\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n42\t  return {\n43\t    messageId,\n44\t    kind: row.kind,\n45\t    blocks: blocks.map((block) => ({\n46\t      blockType: block.block_type,\n47\t      content: JSON.parse(block.content) as Record<string, unknown>,\n48\t    })),\n49\t  };\n50\t}\n51\t\n52\tinterface RawFormRow {\n53\t  subject_id: string;\n54\t  derivation_type: string;\n55\t  state: string;\n56\t  content: string | null;\n57\t  reason: string | null;\n58\t  metadata: string | null;\n59\t  source_version: number | bigint;\n60\t  gaps: string | null;\n61\t  derived_at: string | null;\n62\t}\n63\t\n64\t// Every message-owned derived-derivation_type row, grouped by message id — the derivation_type\n65\t// read-back joined onto message reads (AC-2.1's \"readable alongside the\n66\t// message\"). Rows come back exactly as the queue landed them: state, content,\n67\t// reason, mechanically stamped metadata; nothing is derived at read time.\n68\t//\n69\t// messageIds, when provided, scopes the read to just those subjects so a\n70\t// bounded listMessages loads only its window's derivation_types (AC-3.1's\n71\t// no-load-everything clause), never every message-owned derivation_type in the thread.\n72\t// Omitted — the report-surface path that already reads its own scope — reads\n73\t// all message-owned derivation_type rows as before.\n74\texport function readMessageForms(\n75\t  db: DatabaseSync,\n76\t  messageIds?: readonly string[],\n77\t): Map<string, Derivation[]> {\n78\t  const byMessage = new Map<string, Derivation[]>();\n79\t  if (messageIds !== undefined && messageIds.length === 0) return byMessage;\n80\t  const idFilter =\n81\t    messageIds === undefined\n82\t      ? \"\"\n83\t      : ` AND subject_id IN (${messageIds.map(() => \"?\").join(\", \")})`;\n84\t  const rows = db\n85\t    .prepare(\n86\t      `SELECT subject_id, derivation_type, state, content, reason, metadata,\n87\t              source_version, gaps, derived_at\n88\t       FROM derived_derivation_type WHERE subject_kind = 'message'${idFilter}\n89\t       ORDER BY subject_id, derivation_type`,\n90\t    )\n91\t    .all(...(messageIds ?? [])) as unknown as RawFormRow[];\n92\t  for (const row of rows) {\n93\t    const record: Derivation = {\n94\t      subjectKind: \"message\",\n95\t      subjectId: row.subject_id,\n96\t      derivation_type: row.derivation_type as DerivationType,\n97\t      state: row.state as DerivationState,\n98\t      sourceVersion: Number(row.source_version),\n99\t    };\n100\t    if (row.content !== null) record.content = row.content;\n101\t    if (row.reason !== null) record.reason = row.reason;\n102\t    if (row.metadata !== null) {\n103\t      record.metadata = JSON.parse(row.metadata) as DerivationMetadata;\n104\t    }\n105\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n106\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n107\t    const derivation_types = byMessage.get(row.subject_id) ?? [];\n108\t    derivation_types.push(record);\n109\t    byMessage.set(row.subject_id, derivation_types);\n110\t  }\n111\t  return byMessage;\n112\t}\n113\t\n114\t// One derivation_type row by exact key — the requeue operation's refusal read (missing\n115\t// row, blocked state, current source version). State returned as stored.\n116\texport function readMessageFormRow(\n117\t  db: DatabaseSync,\n118\t  messageId: string,\n119\t  derivation_type: DerivationType,\n120\t): { state: DerivationState; reason?: string; sourceVersion: number } | undefined {\n121\t  const row = db\n122\t    .prepare(\n123\t      `SELECT state, reason, source_version FROM derived_derivation_type\n124\t       WHERE subject_kind = 'message' AND subject_id = ? AND derivation_type = ?`,\n125\t    )\n126\t    .get(messageId, derivation_type) as unknown as\n127\t    | { state: string; reason: string | null; source_version: number | bigint }\n128\t    | undefined;\n129\t  if (row === undefined) return undefined;\n130\t  const view: { state: DerivationState; reason?: string; sourceVersion: number } = {\n131\t    state: row.state as DerivationState,\n132\t    sourceVersion: Number(row.source_version),\n133\t  };\n134\t  if (row.reason !== null) view.reason = row.reason;\n135\t  return view;\n136\t}\n137\t\n138\t// The message owner's report (Flow 4): one query — message-owned derivation_type rows\n139\t// LEFT JOINed with the live work_item still targeting each derivation_type at its\n140\t// current source version, if any (DD-1: only live rows exist; terminal\n141\t// outcomes already live on the derivation_type). No N+1, no in-memory assembly beyond\n142\t// row mapping. The derivation_type→kind CASE is the owner's own queue-site mapping\n143\t// (MESSAGE_WORK_FORMS) inverted.\n144\texport function reportMessageForms(\n145\t  db: DatabaseSync,\n146\t  opts: { notReady?: boolean; messageId?: string } = {},\n147\t): DerivationReportEntry[] {\n148\t  const conditions = [\"df.subject_kind = 'message'\"];\n149\t  const params: string[] = [];\n150\t  if (opts.messageId !== undefined) {\n151\t    conditions.push(\"df.subject_id = ?\");\n152\t    params.push(opts.messageId);\n153\t  }\n154\t  // notReady is exact set equality by construction: every state but ready.\n155\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n156\t  const rows = db\n157\t    .prepare(\n158\t      `SELECT df.subject_id, df.derivation_type, df.state, df.content, df.reason, df.metadata,\n159\t              df.source_version, df.gaps, df.derived_at,\n160\t              w.status AS queue_status, w.attempts AS queue_attempts,\n161\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n162\t       FROM derived_derivation_type df\n163\t       LEFT JOIN work_item w\n164\t         ON w.status IN ('queued', 'claimed')\n165\t        AND w.kind = CASE df.derivation_type WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.derivation_type END\n166\t        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n167\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n168\t       WHERE ${conditions.join(\" AND \")}\n169\t       ORDER BY df.subject_id, df.derivation_type`,\n170\t    )\n171\t    .all(...params) as unknown as RawReportRow[];\n172\t  return rows.map((row) => reportEntryFromRow(\"message\", row));\n173\t}\n174\t\n175\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n176\t// ever repeated; in a well-derivation_typeed record the pair is unique. Deleted messages\n177\t// are excluded (tech-design §Mechanics' deleted-read rule, epic-fix-001):\n178\t// composition inputs and derivation reads never see deleted records, so a\n179\t// tool_call whose paired result has been deleted reads no pair and derives\n180\t// outcome `unknown` — never the dead result's outcome.\n181\tfunction findPairedBlock(\n182\t  db: DatabaseSync,\n183\t  blockType: \"tool_call\" | \"tool_result\",\n184\t  toolCallId: string,\n185\t): Record<string, unknown> | undefined {\n186\t  const row = db\n187\t    .prepare(\n188\t      `SELECT b.content FROM message_block b\n189\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n190\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n191\t       ORDER BY m.source_event_order LIMIT 1`,\n192\t    )\n193\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n194\t  if (row === undefined) return undefined;\n195\t  return JSON.parse(row.content) as Record<string, unknown>;\n196\t}\n197\t\n198\texport function findPairedToolResult(\n199\t  db: DatabaseSync,\n200\t  toolCallId: string,\n201\t): { content: string; isError: boolean } | undefined {\n202\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n203\t  if (block === undefined) return undefined;\n204\t  return {\n205\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n206\t    isError: block[\"isError\"] === true,\n207\t  };\n208\t}\n209\t\n210\texport function findPairedToolCall(\n211\t  db: DatabaseSync,\n212\t  toolCallId: string,\n213\t): { toolName: string } | undefined {\n214\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n215\t  if (block === undefined) return undefined;\n216\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n217\t}\n218\t\n219\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n220\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n221\t// common case — call and result in one batch, summary not yet run — never\n222\t// triggers a requeue. Returns the call's message id and the derivation_type's current\n223\t// source version (the requeue enqueues at version + 1: the pair is the\n224\t// summary's source, and a source completing follows clear-and-regenerate).\n225\texport function findUnknownOutcomeCallSummary(\n226\t  db: DatabaseSync,\n227\t  toolCallId: string,\n228\t): { messageId: string; sourceVersion: number } | undefined {\n229\t  const row = db\n230\t    .prepare(\n231\t      `SELECT df.subject_id, df.source_version FROM message_block b\n232\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n233\t       JOIN derived_derivation_type df ON df.subject_kind = 'message'\n234\t         AND df.subject_id = b.message_id AND df.derivation_type = 'tool_call_summary'\n235\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n236\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n237\t       LIMIT 1`,\n238\t    )\n239\t    .get(toolCallId) as unknown as\n240\t    | { subject_id: string; source_version: number | bigint }\n241\t    | undefined;\n242\t  if (row === undefined) return undefined;\n243\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n244\t}\n245\t"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"dc9c2563-c31f-4153-af60-c8ddad26510f","timestamp":"2026-06-15T04:30:16.281Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/forms.ts","content":"// Message-domain reads for derivation (Flow 2): the handler's view of its\n// source message and the call-id pairing reads — the only reach a\n// message-level handler has beyond its own message (AC-2.5). Also the\n// late-result repair lookup intake's projection step runs (AC-2.8): one\n// indexed query by call id, never a scan (the v5 expression index on\n// message_block covers it) and never a drain-time sweep or read-time join.\n// Completion writes for message derivation_types ride the work-queue util's `complete`\n// (Story 1): UPDATE-only with the source-version check — no write path here.\n// Read-back of message-owned derivation_type rows (the listMessages join) also lives\n// here: stored state returned as stored — never re-derived on read.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type {\n  DependencyGap,\n  Derivation,\n  DerivationMetadata,\n  DerivationState,\n  DerivationType,\n  DerivationReportEntry,\n} from \"../../../shared/derivation.js\";\nimport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n\nexport interface MessageSource {\n  messageId: string;\n  kind: string;\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n}\n\nexport function readMessageSource(\n  db: DatabaseSync,\n  messageId: string,\n): MessageSource | undefined {\n  const row = db\n    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    .get(messageId) as unknown as { kind: string } | undefined;\n  if (row === undefined) return undefined;\n  const blocks = db\n    .prepare(\n      `SELECT block_type, content FROM message_block\n       WHERE message_id = ? ORDER BY block_index`,\n    )\n    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n  return {\n    messageId,\n    kind: row.kind,\n    blocks: blocks.map((block) => ({\n      blockType: block.block_type,\n      content: JSON.parse(block.content) as Record<string, unknown>,\n    })),\n  };\n}\n\ninterface RawFormRow {\n  subject_id: string;\n  derivation_type: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\n// Every message-owned derived-derivation_type row, grouped by message id — the derivation_type\n// read-back joined onto message reads (AC-2.1's \"readable alongside the\n// message\"). Rows come back exactly as the queue landed them: state, content,\n// reason, mechanically stamped metadata; nothing is derived at read time.\n//\n// messageIds, when provided, scopes the read to just those subjects so a\n// bounded listMessages loads only its window's derivation_types (AC-3.1's\n// no-load-everything clause), never every message-owned derivation_type in the thread.\n// Omitted — the report-surface path that already reads its own scope — reads\n// all message-owned derivation_type rows as before.\nexport function readMessageForms(\n  db: DatabaseSync,\n  messageIds?: readonly string[],\n): Map<string, Derivation[]> {\n  const byMessage = new Map<string, Derivation[]>();\n  if (messageIds !== undefined && messageIds.length === 0) return byMessage;\n  const idFilter =\n    messageIds === undefined\n      ? \"\"\n      : ` AND subject_id IN (${messageIds.map(() => \"?\").join(\", \")})`;\n  const rows = db\n    .prepare(\n      `SELECT subject_id, derivation_type, state, content, reason, metadata,\n              source_version, gaps, derived_at\n       FROM derived_derivation_type WHERE subject_kind = 'message'${idFilter}\n       ORDER BY subject_id, derivation_type`,\n    )\n    .all(...(messageIds ?? [])) as unknown as RawFormRow[];\n  for (const row of rows) {\n    const record: Derivation = {\n      subjectKind: \"message\",\n      subjectId: row.subject_id,\n      derivation_type: row.derivation_type as DerivationType,\n      state: row.state as DerivationState,\n      sourceVersion: Number(row.source_version),\n    };\n    if (row.content !== null) record.content = row.content;\n    if (row.reason !== null) record.reason = row.reason;\n    if (row.metadata !== null) {\n      record.metadata = JSON.parse(row.metadata) as DerivationMetadata;\n    }\n    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    const derivation_types = byMessage.get(row.subject_id) ?? [];\n    derivation_types.push(record);\n    byMessage.set(row.subject_id, derivation_types);\n  }\n  return byMessage;\n}\n\n// One derivation_type row by exact key — the requeue operation's refusal read (missing\n// row, blocked state, current source version). State returned as stored.\nexport function readMessageFormRow(\n  db: DatabaseSync,\n  messageId: string,\n  derivation_type: DerivationType,\n): { state: DerivationState; reason?: string; sourceVersion: number } | undefined {\n  const row = db\n    .prepare(\n      `SELECT state, reason, source_version FROM derived_derivation_type\n       WHERE subject_kind = 'message' AND subject_id = ? AND derivation_type = ?`,\n    )\n    .get(messageId, derivation_type) as unknown as\n    | { state: string; reason: string | null; source_version: number | bigint }\n    | undefined;\n  if (row === undefined) return undefined;\n  const view: { state: DerivationState; reason?: string; sourceVersion: number } = {\n    state: row.state as DerivationState,\n    sourceVersion: Number(row.source_version),\n  };\n  if (row.reason !== null) view.reason = row.reason;\n  return view;\n}\n\n// The message owner's report (Flow 4): one query — message-owned derivation_type rows\n// LEFT JOINed with the live work_item still targeting each derivation_type at its\n// current source version, if any (DD-1: only live rows exist; terminal\n// outcomes already live on the derivation_type). No N+1, no in-memory assembly beyond\n// row mapping. The derivation_type→kind CASE is the owner's own queue-site mapping\n// (MESSAGE_WORK_FORMS) inverted.\nexport function reportMessageForms(\n  db: DatabaseSync,\n  opts: { notReady?: boolean; messageId?: string } = {},\n): DerivationReportEntry[] {\n  const conditions = [\"df.subject_kind = 'message'\"];\n  const params: string[] = [];\n  if (opts.messageId !== undefined) {\n    conditions.push(\"df.subject_id = ?\");\n    params.push(opts.messageId);\n  }\n  // notReady is exact set equality by construction: every state but ready.\n  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n  const rows = db\n    .prepare(\n      `SELECT df.subject_id, df.derivation_type, df.state, df.content, df.reason, df.metadata,\n              df.source_version, df.gaps, df.derived_at,\n              w.status AS queue_status, w.attempts AS queue_attempts,\n              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n       FROM derived_derivation_type df\n       LEFT JOIN work_item w\n         ON w.status IN ('queued', 'claimed')\n        AND w.kind = CASE df.derivation_type WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.derivation_type END\n        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n       WHERE ${conditions.join(\" AND \")}\n       ORDER BY df.subject_id, df.derivation_type`,\n    )\n    .all(...params) as unknown as RawReportRow[];\n  return rows.map((row) => reportEntryFromRow(\"message\", row));\n}\n\n// The call-id pairing reads. Earliest-recorded block wins if a call id were\n// ever repeated; in a well-derivation_typeed record the pair is unique. Deleted messages\n// are excluded (tech-design §Mechanics' deleted-read rule, epic-fix-001):\n// composition inputs and derivation reads never see deleted records, so a\n// tool_call whose paired result has been deleted reads no pair and derives\n// outcome `unknown` — never the dead result's outcome.\nfunction findPairedBlock(\n  db: DatabaseSync,\n  blockType: \"tool_call\" | \"tool_result\",\n  toolCallId: string,\n): Record<string, unknown> | undefined {\n  const row = db\n    .prepare(\n      `SELECT b.content FROM message_block b\n       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n       ORDER BY m.source_event_order LIMIT 1`,\n    )\n    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n  if (row === undefined) return undefined;\n  return JSON.parse(row.content) as Record<string, unknown>;\n}\n\nexport function findPairedToolResult(\n  db: DatabaseSync,\n  toolCallId: string,\n): { content: string; isError: boolean } | undefined {\n  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n  if (block === undefined) return undefined;\n  return {\n    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n    isError: block[\"isError\"] === true,\n  };\n}\n\nexport function findPairedToolCall(\n  db: DatabaseSync,\n  toolCallId: string,\n): { toolName: string } | undefined {\n  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n  if (block === undefined) return undefined;\n  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n}\n\n// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n// common case — call and result in one batch, summary not yet run — never\n// triggers a requeue. Returns the call's message id and the derivation_type's current\n// source version (the requeue enqueues at version + 1: the pair is the\n// summary's source, and a source completing follows clear-and-regenerate).\nexport function findUnknownOutcomeCallSummary(\n  db: DatabaseSync,\n  toolCallId: string,\n): { messageId: string; sourceVersion: number } | undefined {\n  const row = db\n    .prepare(\n      `SELECT df.subject_id, df.source_version FROM message_block b\n       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n       JOIN derived_derivation_type df ON df.subject_kind = 'message'\n         AND df.subject_id = b.message_id AND df.derivation_type = 'tool_call_summary'\n       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n       LIMIT 1`,\n    )\n    .get(toolCallId) as unknown as\n    | { subject_id: string; source_version: number | bigint }\n    | undefined;\n  if (row === undefined) return undefined;\n  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n}\n","numLines":245,"startLine":1,"totalLines":245}}}

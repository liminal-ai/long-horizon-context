{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_640f537154fd4ca29933d5ba","type":"tool_result","content":"1\t// Flow 5: idempotent resend (TC-5.1 through TC-5.5, asserted at the event\n2\t// level — the no-message / no-transition / no-work-item clauses re-assert in\n3\t// Stories 3-5 as those records exist).\n4\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n5\timport { intakeStream, threads, type EventRecord } from \"../src/index.js\";\n6\timport { conversationTurn, eventBatch, openRaw, tempStore, validEvent, type TempStore } from \"./fixtures/index.js\";\n7\t\n8\tlet store: TempStore;\n9\tbeforeEach(() => {\n10\t  store = tempStore();\n11\t});\n12\tafterEach(() => {\n13\t  store.cleanup();\n14\t});\n15\t\n16\tasync function createThread(): Promise<string> {\n17\t  const filePath = store.threadPath();\n18\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n19\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n20\t  return filePath;\n21\t}\n22\t\n23\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n24\t  const result = await intakeStream.listEvents({ filePath });\n25\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n26\t  return result.value;\n27\t}\n28\t\n29\t// Serializes every row of every table for below-SDK absence assertions.\n30\tfunction rawDump(filePath: string): string {\n31\t  const db = openRaw(filePath);\n32\t  try {\n33\t    const tables = db\n34\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table'\")\n35\t      .all() as unknown as Array<{ name: string }>;\n36\t    let dump = \"\";\n37\t    for (const table of tables) {\n38\t      dump += JSON.stringify(db.prepare(`SELECT * FROM \"${table.name}\"`).all());\n39\t    }\n40\t    return dump;\n41\t  } finally {\n42\t    db.close();\n43\t  }\n44\t}\n45\t\n46\tdescribe(\"Flow 5 (SDK): idempotent resend\", () => {\n47\t  it(\"TC-5.1: resending a fully recorded batch skips everything and changes nothing\", async () => {\n48\t    const filePath = await createThread();\n49\t    const batch = conversationTurn();\n50\t    const first = await intakeStream.messageEvents({ filePath }, batch);\n51\t    expect(first.ok).toBe(true);\n52\t    if (!first.ok) return;\n53\t    expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n54\t    expect(first.value.threadPosition.lastEventOrder).toBe(5);\n55\t    const baseline = await readBack(filePath);\n56\t\n57\t    const resend = await intakeStream.messageEvents({ filePath }, batch);\n58\t    expect(resend.ok).toBe(true);\n59\t    if (!resend.ok) return;\n60\t    expect(resend.value.events).toHaveLength(5);\n61\t    for (const [index, entry] of resend.value.events.entries()) {\n62\t      expect(entry.outcome).toBe(\"skipped\");\n63\t      expect(entry.skipReason).toBe(\"duplicate_idempotency_key\");\n64\t      expect(entry.idempotencyKey).toBe(batch[index]!.idempotencyKey);\n65\t    }\n66\t    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n67\t\n68\t    expect(await readBack(filePath)).toEqual(baseline);\n69\t  });\n70\t\n71\t  it(\"TC-5.2: partial resend skips the old, records the new, and keeps the order dense\", async () => {\n72\t    const filePath = await createThread();\n73\t    const old = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n74\t    const first = await intakeStream.messageEvents({ filePath }, old);\n75\t    expect(first.ok).toBe(true);\n76\t\n77\t    const fresh = [validEvent(\"tool_result\"), validEvent(\"turn_end\")];\n78\t    const resend = await intakeStream.messageEvents({ filePath }, [...old, ...fresh]);\n79\t    expect(resend.ok).toBe(true);\n80\t    if (!resend.ok) return;\n81\t    expect(resend.value.events.map((entry) => entry.outcome)).toEqual([\n82\t      \"skipped\",\n83\t      \"skipped\",\n84\t      \"skipped\",\n85\t      \"recorded\",\n86\t      \"recorded\",\n87\t    ]);\n88\t    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n89\t\n90\t    const events = await readBack(filePath);\n91\t    expect(events.map((event) => event.eventOrder)).toEqual([1, 2, 3, 4, 5]);\n92\t    expect(events[3]!.idempotencyKey).toBe(fresh[0]!.idempotencyKey);\n93\t    expect(events[4]!.idempotencyKey).toBe(fresh[1]!.idempotencyKey);\n94\t  });\n95\t\n96\t  it(\"TC-5.3: idempotency keys are scoped to the thread — same key records in both threads\", async () => {\n97\t    const threadA = await createThread();\n98\t    const threadB = await createThread();\n99\t    const event = validEvent(\"user_prompt\", { idempotencyKey: \"shared-key-1\" });\n100\t"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"08a01513-61fa-48c7-993e-3084aae237c2","timestamp":"2026-06-15T04:24:31.380Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/idempotency.test.ts","content":"// Flow 5: idempotent resend (TC-5.1 through TC-5.5, asserted at the event\n// level — the no-message / no-transition / no-work-item clauses re-assert in\n// Stories 3-5 as those records exist).\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { intakeStream, threads, type EventRecord } from \"../src/index.js\";\nimport { conversationTurn, eventBatch, openRaw, tempStore, validEvent, type TempStore } from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nasync function createThread(): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function readBack(filePath: string): Promise<EventRecord[]> {\n  const result = await intakeStream.listEvents({ filePath });\n  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n  return result.value;\n}\n\n// Serializes every row of every table for below-SDK absence assertions.\nfunction rawDump(filePath: string): string {\n  const db = openRaw(filePath);\n  try {\n    const tables = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table'\")\n      .all() as unknown as Array<{ name: string }>;\n    let dump = \"\";\n    for (const table of tables) {\n      dump += JSON.stringify(db.prepare(`SELECT * FROM \"${table.name}\"`).all());\n    }\n    return dump;\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"Flow 5 (SDK): idempotent resend\", () => {\n  it(\"TC-5.1: resending a fully recorded batch skips everything and changes nothing\", async () => {\n    const filePath = await createThread();\n    const batch = conversationTurn();\n    const first = await intakeStream.messageEvents({ filePath }, batch);\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    expect(first.value.threadPosition.lastEventOrder).toBe(5);\n    const baseline = await readBack(filePath);\n\n    const resend = await intakeStream.messageEvents({ filePath }, batch);\n    expect(resend.ok).toBe(true);\n    if (!resend.ok) return;\n    expect(resend.value.events).toHaveLength(5);\n    for (const [index, entry] of resend.value.events.entries()) {\n      expect(entry.outcome).toBe(\"skipped\");\n      expect(entry.skipReason).toBe(\"duplicate_idempotency_key\");\n      expect(entry.idempotencyKey).toBe(batch[index]!.idempotencyKey);\n    }\n    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n\n    expect(await readBack(filePath)).toEqual(baseline);\n  });\n\n  it(\"TC-5.2: partial resend skips the old, records the new, and keeps the order dense\", async () => {\n    const filePath = await createThread();\n    const old = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n    const first = await intakeStream.messageEvents({ filePath }, old);\n    expect(first.ok).toBe(true);\n\n    const fresh = [validEvent(\"tool_result\"), validEvent(\"turn_end\")];\n    const resend = await intakeStream.messageEvents({ filePath }, [...old, ...fresh]);\n    expect(resend.ok).toBe(true);\n    if (!resend.ok) return;\n    expect(resend.value.events.map((entry) => entry.outcome)).toEqual([\n      \"skipped\",\n      \"skipped\",\n      \"skipped\",\n      \"recorded\",\n      \"recorded\",\n    ]);\n    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n\n    const events = await readBack(filePath);\n    expect(events.map((event) => event.eventOrder)).toEqual([1, 2, 3, 4, 5]);\n    expect(events[3]!.idempotencyKey).toBe(fresh[0]!.idempotencyKey);\n    expect(events[4]!.idempotencyKey).toBe(fresh[1]!.idempotencyKey);\n  });\n\n  it(\"TC-5.3: idempotency keys are scoped to the thread — same key records in both threads\", async () => {\n    const threadA = await createThread();\n    const threadB = await createThread();\n    const event = validEvent(\"user_prompt\", { idempotencyKey: \"shared-key-1\" });\n","numLines":100,"startLine":1,"totalLines":178}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_93e69154fa1844fc993c503f","type":"tool_result","content":"1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n2\t// wrapper that makes \"queueing is what schedules processing\" structural\n3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n5\t// a turn or a summary is; which kinds queue for which sources, and which\n6\t// derived forms a kind produces, is the owning domains' business (callers\n7\t// pass the form targets in). Writes run on the caller's handle inside the\n8\t// ambient transaction, so items commit (or roll back) with the batch. No\n9\t// public SDK surface: read-back reaches here only through the owning\n10\t// domains' listQueuedWork.\n11\timport type { DatabaseSync } from \"node:sqlite\";\n12\timport {\n13\t  createCommitHooks,\n14\t  type OperationContext,\n15\t} from \"../../shared/context.js\";\n16\timport type {\n17\t  CompletionTx,\n18\t  FormKind,\n19\t  HandlerFormWrite,\n20\t  SubjectKind,\n21\t} from \"../../shared/derivation.js\";\n22\t\n23\texport type WorkOwner = \"messages\" | \"turns\";\n24\texport type WorkKind =\n25\t  | \"prompt_smoothing\"\n26\t  | \"tool_call_summary\"\n27\t  | \"tool_result_summary\"\n28\t  | \"turn_derivation\"\n29\t  | \"chunk_summary_detailed\"\n30\t  | \"chunk_summary_brief\";\n31\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n32\t\n33\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n34\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n35\t// the owning domain's handler (registered at SDK construction, DD-6).\n36\texport const WORK_KIND_REGISTRY: Readonly<\n37\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n38\t> = {\n39\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n40\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n41\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n42\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n43\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n44\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n45\t};\n46\t\n47\texport interface WorkItemRecord {\n48\t  workItemId: string;\n49\t  owner: WorkOwner;\n50\t  kind: WorkKind;\n51\t  sourceRef: WorkSourceRef;\n52\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n53\t  queuedAt: string;\n54\t}\n55\t\n56\t// The derived forms an enqueue is scheduling work toward; the owning domain\n57\t// names them (the util stays meaning-blind). Stored in the row's payload so\n58\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n59\t// form's failed/blocked state without asking any domain what a kind means.\n60\texport interface EnqueueFormTarget {\n61\t  subjectKind: SubjectKind;\n62\t  subjectId: string;\n63\t  form: FormKind;\n64\t}\n65\t\n66\texport interface WorkItemInput {\n67\t  owner: WorkOwner;\n68\t  kind: WorkKind;\n69\t  sourceRef: WorkSourceRef;\n70\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n71\t  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n72\t}\n73\t\n74\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n75\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n76\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n77\t  return sourceRef.chunkId;\n78\t}\n79\t\n80\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n81\t// same kind for the same source *at the same version* is the same id —\n82\t// natural idempotency for the repair path — while a post-mutation\n83\t// replacement (next version) never collides with an in-flight pre-mutation\n84\t// item.\n85\texport function recordItem(\n86\t  db: DatabaseSync,\n87\t  input: WorkItemInput,\n88\t  queuedAt: string,\n89\t): WorkItemRecord {\n90\t  const sourceVersion = input.sourceVersion ?? 1;\n91\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n92\t  db.prepare(\n93\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n94\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n95\t  ).run(\n96\t    workItemId,\n97\t    input.owner,\n98\t    input.kind,\n99\t    JSON.stringify(input.sourceRef),\n100\t    queuedAt,\n101\t    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n102\t  );\n103\t  return {\n104\t    workItemId,\n105\t    owner: input.owner,\n106\t    kind: input.kind,\n107\t    sourceRef: input.sourceRef,\n108\t    status: \"queued\",\n109\t    queuedAt,\n110\t  };\n111\t}\n112\t\n113\texport interface EnqueueInput extends WorkItemInput {\n114\t  forms: readonly EnqueueFormTarget[];\n115\t}\n116\t\n117\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n118\t// state row, and the scheduler poke all ride the ambient transaction — they\n119\t// commit together or vanish together. Enqueue is the *only* place a\n120\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n121\t// resets an existing row to pending at the enqueued source version.\n122\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n123\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n124\t  const sourceVersion = input.sourceVersion ?? 1;\n125\t  const upsert = ctx.db.prepare(\n126\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n127\t     VALUES (?, ?, ?, 'pending', ?)\n128\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n129\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n130\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n131\t  );\n132\t  for (const target of input.forms) {\n133\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n134\t  }\n135\t  ctx.onCommit(() => ctx.poke(ctx.threadId));\n136\t  return item;\n137\t}\n138\t\n139\tinterface RawWorkItemRow {\n140\t  work_item_id: string;\n141\t  owner: string;\n142\t  kind: string;\n143\t  source_ref: string;\n144\t  queued_at: string;\n145\t}\n146\t\n147\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n148\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n149\t// complete, and the terminal half of failAttempt each own one short\n150\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n151\t\n152\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n153\t// source version and form targets. `kind` is a plain string here — a raw row\n154\t// with an unregistered kind must still be claimable so the drain can land it\n155\t// failed_terminal instead of skipping it (AC-1.8).\n156\texport interface ClaimedWorkItem {\n157\t  workItemId: string;\n158\t  owner: WorkOwner;\n159\t  kind: string;\n160\t  sourceRef: WorkSourceRef;\n161\t  attempts: number;\n162\t  queuedAt: string;\n163\t  sourceVersion: number;\n164\t  forms: EnqueueFormTarget[];\n165\t}\n166\t\n167\texport type ClaimOutcome =\n168\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n169\t  | { outcome: \"empty\" }\n170\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n171\t  | { outcome: \"waiting\"; waitingUntil: string };\n172\t\n173\tinterface RawClaimRow {\n174\t  work_item_id: string;\n175\t  owner: string;\n176\t  kind: string;\n177\t  source_ref: string;\n178\t  attempts: number | bigint;\n179\t  queued_at: string;\n180\t  payload: string | null;\n181\t}\n182\t\n183\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n184\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n185\t// v5, shared/storage.ts): the backfill created pending derived_form rows at\n186\t// source version 1 for these kinds, and a terminal failure must find them —\n187\t// otherwise exhaustion would delete the work row and strand the backfilled\n188\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n189\tconst LEGACY_KIND_FORMS: Partial<\n190\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n191\t> = {\n192\t  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n193\t  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n194\t  turn_derivation: [\n195\t    { subjectKind: \"turn\", form: \"turn_rendering\" },\n196\t    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n197\t  ],\n198\t};\n199\t\n200\tfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n201\t  const mapped = LEGACY_KIND_FORMS[kind];\n202\t  if (mapped === undefined) return [];\n203\t  const subjectId = sourceIdOf(sourceRef);\n204\t  return mapped.map((target) => ({ ...target, subjectId }));\n205\t}\n206\t\n207\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n208\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n209\t  const payload =\n210\t    row.payload === null\n211\t      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n212\t        // reconstructed from the backfill's own mapping.\n213\t        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n214\t      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n215\t  return {\n216\t    workItemId: row.work_item_id,\n217\t    owner: row.owner as WorkOwner,\n218\t    kind: row.kind,\n219\t    sourceRef,\n220\t    attempts: Number(row.attempts),\n221\t    queuedAt: row.queued_at,\n222\t    sourceVersion: payload.sourceVersion ?? 1,\n223\t    forms: payload.forms ?? [],\n224\t  };\n225\t}\n226\t\n227\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n228\t// live row only — a later eligible row is never considered while an older\n229\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n230\t// write split: the race window is the bug class). The CASE increments\n231\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n232\t// run died or hung, and the increment makes the crash visible in the report\n233\t// and counts it against the retry budget; normal claims never touch it.\n234\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n235\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n236\t  db.exec(\"BEGIN IMMEDIATE;\");\n237\t  try {\n238\t    const claimed = db\n239\t      .prepare(\n240\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n241\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n242\t         WHERE work_item_id = (\n243\t           SELECT work_item_id FROM (\n244\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n245\t             FROM work_item WHERE status IN ('queued', 'claimed')\n246\t             ORDER BY rowid LIMIT 1\n247\t           )\n248\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n249\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n250\t         )\n251\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n252\t      )\n253\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n254\t    if (claimed !== undefined) {\n255\t      db.exec(\"COMMIT;\");\n256\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n257\t    }\n258\t    // No row claimable: re-read the head inside the same transaction to\n259\t    // classify the stop. A claimed head with a live lease gates the queue\n260\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n261\t    // (waiting) — strict ordering, never reordered around the head.\n262\t    const head = db\n263\t      .prepare(\n264\t        `SELECT status, eligible_at, claim_expires_at\n265\t         FROM work_item WHERE status IN ('queued', 'claimed')\n266\t         ORDER BY rowid LIMIT 1`,\n267\t      )\n268\t      .get() as unknown as\n269\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n270\t      | undefined;\n271\t    db.exec(\"COMMIT;\");\n272\t    if (head === undefined) return { outcome: \"empty\" };\n273\t    if (head.status === \"claimed\") {\n274\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n275\t    }\n276\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n277\t  } catch (cause) {\n278\t    db.exec(\"ROLLBACK;\");\n279\t    throw cause;\n280\t  }\n281\t}\n282\t\n283\t// Completion: the version-checked form writes and the item row's deletion in\n284\t// one short transaction (DD-1: terminal transition deletes the row; the\n285\t// disposition is reported in-memory, never stored). UPDATE-only, never\n286\t// upsert — the pending row exists from enqueue; a write that finds no row at\n287\t// the item's source version is discarded as stale (DD-3 truth table). The\n288\t// optional onApplied hook (Story 3) runs inside this same transaction, after\n289\t// the form writes and only when they landed — chunk placement and the\n290\t// close→summary enqueues ride the completion commit; its onCommit\n291\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\n292\texport function complete(\n293\t  db: DatabaseSync,\n294\t  item: ClaimedWorkItem,\n295\t  writes: readonly HandlerFormWrite[],\n296\t  derivedAt: string,\n297\t  onApplied?: (tx: CompletionTx) => void,\n298\t): \"done\" | \"stale_discarded\" {\n299\t  const hooks = createCommitHooks();\n300\t  db.exec(\"BEGIN IMMEDIATE;\");\n301\t  try {\n302\t    let hits = 0;\n303\t    const update = db.prepare(\n304\t      `UPDATE derived_form\n305\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n306\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n307\t    );\n308\t    for (const write of writes) {\n309\t      const changed = update.run(\n310\t        write.content,\n311\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n312\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n313\t        derivedAt,\n314\t        write.subjectKind,\n315\t        write.subjectId,\n316\t        write.form,\n317\t        item.sourceVersion,\n318\t      );\n319\t      hits += Number(changed.changes);\n320\t    }\n321\t    const stale = writes.length > 0 && hits === 0;\n322\t    if (!stale && onApplied !== undefined) {\n323\t      onApplied({ db, onCommit: hooks.register });\n324\t    }\n325\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n326\t    db.exec(\"COMMIT;\");\n327\t    hooks.flush();\n328\t    return stale ? \"stale_discarded\" : \"done\";\n329\t  } catch (cause) {\n330\t    db.exec(\"ROLLBACK;\");\n331\t    throw cause;\n332\t  }\n333\t}\n334\t\n335\texport interface RetryPolicy {\n336\t  budget: number;\n337\t  backoffBaseMs: number;\n338\t  backoffCapMs: number;\n339\t}\n340\t\n341\texport type FailAttemptResult =\n342\t  | { terminal: false; attempts: number; eligibleAt: string }\n343\t  | { terminal: true; attempts: number };\n344\t\n345\t// Terminal failure: the form rows land `failed` (or `blocked` for source\n346\t// damage) carrying the final reason plus attempts/last-error copied onto the\n347\t// form's metadata, and the item row is deleted — one transaction (DD-1).\n348\t// Form writes stay version-checked: if a mutation moved the source since this\n349\t// item was queued, the stale failure must not stamp the rebuilt form.\n350\texport function failTerminal(\n351\t  db: DatabaseSync,\n352\t  item: ClaimedWorkItem,\n353\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n354\t): void {\n355\t  db.exec(\"BEGIN IMMEDIATE;\");\n356\t  try {\n357\t    const update = db.prepare(\n358\t      `UPDATE derived_form\n359\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n360\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n361\t    );\n362\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n363\t    for (const target of item.forms) {\n364\t      update.run(\n365\t        opts.formState,\n366\t        opts.reason,\n367\t        metadata,\n368\t        opts.now,\n369\t        target.subjectKind,\n370\t        target.subjectId,\n371\t        target.form,\n372\t        item.sourceVersion,\n373\t      );\n374\t    }\n375\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n376\t    db.exec(\"COMMIT;\");\n377\t  } catch (cause) {\n378\t    db.exec(\"ROLLBACK;\");\n379\t    throw cause;\n380\t  }\n381\t}\n382\t\n383\t// A failed run counts itself. Under budget and retryable: the row goes back\n384\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n385\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n386\t// on a non-retryable failure, the item is terminal: form `failed` with the\n387\t// final reason, row deleted (AC-1.9).\n388\texport function failAttempt(\n389\t  db: DatabaseSync,\n390\t  item: ClaimedWorkItem,\n391\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n392\t): FailAttemptResult {\n393\t  const attempts = item.attempts + 1;\n394\t  if (opts.retryable && attempts < opts.retry.budget) {\n395\t    const backoffMs = Math.min(\n396\t      opts.retry.backoffBaseMs * 2 ** attempts,\n397\t      opts.retry.backoffCapMs,\n398\t    );\n399\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n400\t    db.exec(\"BEGIN IMMEDIATE;\");\n401\t    try {\n402\t      db.prepare(\n403\t        `UPDATE work_item\n404\t         SET status = 'queued', attempts = ?, last_error = ?,\n405\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n406\t         WHERE work_item_id = ?`,\n407\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n408\t      db.exec(\"COMMIT;\");\n409\t    } catch (cause) {\n410\t      db.exec(\"ROLLBACK;\");\n411\t      throw cause;\n412\t    }\n413\t    return { terminal: false, attempts, eligibleAt };\n414\t  }\n415\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n416\t  return { terminal: true, attempts };\n417\t}\n418\t\n419\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n420\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n421\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n422\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n423\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n424\t// discards their stale completions. Ships here as mechanics; its only caller\n425\t// is Story 5's cascade.\n426\texport function supersedeQueued(\n427\t  db: DatabaseSync,\n428\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n429\t): string[] {\n430\t  const ids: string[] = [];\n431\t  const remove = db.prepare(\n432\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n433\t     RETURNING work_item_id`,\n434\t  );\n435\t  for (const target of targets) {\n436\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n437\t      work_item_id: string;\n438\t    }>;\n439\t    for (const row of rows) ids.push(row.work_item_id);\n440\t  }\n441\t  return ids;\n442\t}\n443\t\n444\t// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n445\t// queued or in flight — for this kind and source at this source version?\n446\t// Runs inside the caller's requeue transaction so the check and the enqueue\n447\t// commit together (anti-shim: a check-then-enqueue split across transactions\n448\t// reintroduces the duplicate-work race). Version-scoped on purpose: a\n449\t// claimed pre-mutation item at an older version is dying work whose\n450\t// completion DD-3 will discard — it must not block the repair.\n451\texport function hasLiveItem(\n452\t  db: DatabaseSync,\n453\t  kind: WorkKind,\n454\t  sourceRef: WorkSourceRef,\n455\t  sourceVersion: number,\n456\t): boolean {\n457\t  const row = db\n458\t    .prepare(\n459\t      `SELECT 1 FROM work_item\n460\t       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n461\t         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n462\t       LIMIT 1`,\n463\t    )\n464\t    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n465\t  return row !== undefined;\n466\t}\n467\t\n468\t// Live items left in the queue — the drain report's `remaining` and the\n469\t// repair report's join source (Story 4).\n470\texport function countLiveItems(db: DatabaseSync): number {\n471\t  const row = db\n472\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n473\t    .get() as unknown as { n: number | bigint };\n474\t  return Number(row.n);\n475\t}\n476\t\n477\texport interface QueueDetailRow {\n478\t  workItemId: string;\n479\t  owner: WorkOwner;\n480\t  kind: string;\n481\t  sourceRef: WorkSourceRef;\n482\t  status: \"queued\" | \"claimed\";\n483\t  attempts: number;\n484\t  lastError?: string;\n485\t  eligibleAt?: string;\n486\t  claimedAt?: string;\n487\t  claimExpiresAt?: string;\n488\t  queuedAt: string;\n489\t  sourceVersion: number;\n490\t}\n491\t\n492\t// Mechanical detail of every live row in queue order — what the repair\n493\t// report joins against derived_form (Flow 4) and what tests read to assert\n494\t// lease/backoff state without raw SQL at every call site.\n495\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n496\t  const rows = db\n497\t    .prepare(\n498\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n499\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n500\t       FROM work_item ORDER BY rowid`,\n501\t    )\n502\t    .all() as unknown as Array<\n503\t    RawClaimRow & {\n504\t      status: string;\n505\t      last_error: string | null;\n506\t      eligible_at: string | null;\n507\t      claimed_at: string | null;\n508\t      claim_expires_at: string | null;\n509\t    }\n510\t  >;\n511\t  return rows.map((row) => {\n512\t    const item = toClaimedItem(row);\n513\t    const detail: QueueDetailRow = {\n514\t      workItemId: item.workItemId,\n515\t      owner: item.owner,\n516\t      kind: item.kind,\n517\t      sourceRef: item.sourceRef,\n518\t      status: row.status as \"queued\" | \"claimed\",\n519\t      attempts: item.attempts,\n520\t      queuedAt: item.queuedAt,\n521\t      sourceVersion: item.sourceVersion,\n522\t    };\n523\t    if (row.last_error !== null) detail.lastError = row.last_error;\n524\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n525\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n526\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n527\t    return detail;\n528\t  });\n529\t}\n530\t\n531\t// Listing in queue order (insertion order within the walk); each owning\n532\t// domain lists only its own items.\n533\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n534\t  const rows = db\n535\t    .prepare(\n536\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n537\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n538\t    )\n539\t    .all(owner) as unknown as RawWorkItemRow[];\n540\t  return rows.map((row) => ({\n541\t    workItemId: row.work_item_id,\n542\t    owner: row.owner as WorkOwner,\n543\t    kind: row.kind as WorkKind,\n544\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n545\t    status: \"queued\",\n546\t    queuedAt: row.queued_at,\n547\t  }));\n548\t}\n549\t"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"44b828cc-0d4f-4806-97a0-edda2610a825","timestamp":"2026-06-15T04:19:21.401Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/tech-utils/work-queue/index.ts","content":"// Durable work-item mechanics: recording, ordered listing, and the enqueue\n// wrapper that makes \"queueing is what schedules processing\" structural\n// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n// a turn or a summary is; which kinds queue for which sources, and which\n// derived forms a kind produces, is the owning domains' business (callers\n// pass the form targets in). Writes run on the caller's handle inside the\n// ambient transaction, so items commit (or roll back) with the batch. No\n// public SDK surface: read-back reaches here only through the owning\n// domains' listQueuedWork.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport {\n  createCommitHooks,\n  type OperationContext,\n} from \"../../shared/context.js\";\nimport type {\n  CompletionTx,\n  FormKind,\n  HandlerFormWrite,\n  SubjectKind,\n} from \"../../shared/derivation.js\";\n\nexport type WorkOwner = \"messages\" | \"turns\";\nexport type WorkKind =\n  | \"prompt_smoothing\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_derivation\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\nexport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n\n// The work-kind registry: owner and sourceRef semantics per the epic's Work\n// Item contract. Mechanical metadata only — what a kind *means* stays with\n// the owning domain's handler (registered at SDK construction, DD-6).\nexport const WORK_KIND_REGISTRY: Readonly<\n  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n> = {\n  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n};\n\nexport interface WorkItemRecord {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n  queuedAt: string;\n}\n\n// The derived forms an enqueue is scheduling work toward; the owning domain\n// names them (the util stays meaning-blind). Stored in the row's payload so\n// the drain's terminal paths (retry exhaustion, blocked source) can land the\n// form's failed/blocked state without asking any domain what a kind means.\nexport interface EnqueueFormTarget {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\nexport interface WorkItemInput {\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n}\n\nfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n  return sourceRef.chunkId;\n}\n\n// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n// same kind for the same source *at the same version* is the same id —\n// natural idempotency for the repair path — while a post-mutation\n// replacement (next version) never collides with an in-flight pre-mutation\n// item.\nexport function recordItem(\n  db: DatabaseSync,\n  input: WorkItemInput,\n  queuedAt: string,\n): WorkItemRecord {\n  const sourceVersion = input.sourceVersion ?? 1;\n  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n  db.prepare(\n    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n  ).run(\n    workItemId,\n    input.owner,\n    input.kind,\n    JSON.stringify(input.sourceRef),\n    queuedAt,\n    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n  );\n  return {\n    workItemId,\n    owner: input.owner,\n    kind: input.kind,\n    sourceRef: input.sourceRef,\n    status: \"queued\",\n    queuedAt,\n  };\n}\n\nexport interface EnqueueInput extends WorkItemInput {\n  forms: readonly EnqueueFormTarget[];\n}\n\n// The one way work is scheduled (DD-5): the work row, the form's `pending`\n// state row, and the scheduler poke all ride the ambient transaction — they\n// commit together or vanish together. Enqueue is the *only* place a\n// derived_form row is created (completion is UPDATE-only); re-enqueueing\n// resets an existing row to pending at the enqueued source version.\nexport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n  const sourceVersion = input.sourceVersion ?? 1;\n  const upsert = ctx.db.prepare(\n    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n     VALUES (?, ?, ?, 'pending', ?)\n     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n  );\n  for (const target of input.forms) {\n    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n  }\n  ctx.onCommit(() => ctx.poke(ctx.threadId));\n  return item;\n}\n\ninterface RawWorkItemRow {\n  work_item_id: string;\n  owner: string;\n  kind: string;\n  source_ref: string;\n  queued_at: string;\n}\n\n// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n// All pure SQL against the caller's open handle, domain-blind. Claim,\n// complete, and the terminal half of failAttempt each own one short\n// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n\n// The claimed row as the drain holds it: mechanical fields plus the payload's\n// source version and form targets. `kind` is a plain string here — a raw row\n// with an unregistered kind must still be claimable so the drain can land it\n// failed_terminal instead of skipping it (AC-1.8).\nexport interface ClaimedWorkItem {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: string;\n  sourceRef: WorkSourceRef;\n  attempts: number;\n  queuedAt: string;\n  sourceVersion: number;\n  forms: EnqueueFormTarget[];\n}\n\nexport type ClaimOutcome =\n  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n  | { outcome: \"empty\" }\n  | { outcome: \"in_flight\"; claimExpiresAt: string }\n  | { outcome: \"waiting\"; waitingUntil: string };\n\ninterface RawClaimRow {\n  work_item_id: string;\n  owner: string;\n  kind: string;\n  source_ref: string;\n  attempts: number | bigint;\n  queued_at: string;\n  payload: string | null;\n}\n\n// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n// v5, shared/storage.ts): the backfill created pending derived_form rows at\n// source version 1 for these kinds, and a terminal failure must find them —\n// otherwise exhaustion would delete the work row and strand the backfilled\n// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\nconst LEGACY_KIND_FORMS: Partial<\n  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n> = {\n  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n  turn_derivation: [\n    { subjectKind: \"turn\", form: \"turn_rendering\" },\n    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n  ],\n};\n\nfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n  const mapped = LEGACY_KIND_FORMS[kind];\n  if (mapped === undefined) return [];\n  const subjectId = sourceIdOf(sourceRef);\n  return mapped.map((target) => ({ ...target, subjectId }));\n}\n\nfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n  const payload =\n    row.payload === null\n      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n        // reconstructed from the backfill's own mapping.\n        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n  return {\n    workItemId: row.work_item_id,\n    owner: row.owner as WorkOwner,\n    kind: row.kind,\n    sourceRef,\n    attempts: Number(row.attempts),\n    queuedAt: row.queued_at,\n    sourceVersion: payload.sourceVersion ?? 1,\n    forms: payload.forms ?? [],\n  };\n}\n\n// Head-first, never skip-ahead: the claim decision is made against the oldest\n// live row only — a later eligible row is never considered while an older\n// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n// write split: the race window is the bug class). The CASE increments\n// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n// run died or hung, and the increment makes the crash visible in the report\n// and counts it against the retry budget; normal claims never touch it.\nexport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    const claimed = db\n      .prepare(\n        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n         WHERE work_item_id = (\n           SELECT work_item_id FROM (\n             SELECT work_item_id, status, eligible_at, claim_expires_at\n             FROM work_item WHERE status IN ('queued', 'claimed')\n             ORDER BY rowid LIMIT 1\n           )\n           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n              OR (status = 'claimed' AND claim_expires_at <= ?)\n         )\n         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n      )\n      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n    if (claimed !== undefined) {\n      db.exec(\"COMMIT;\");\n      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n    }\n    // No row claimable: re-read the head inside the same transaction to\n    // classify the stop. A claimed head with a live lease gates the queue\n    // (in_flight, AC-1.4); a queued head still backing off gates it too\n    // (waiting) — strict ordering, never reordered around the head.\n    const head = db\n      .prepare(\n        `SELECT status, eligible_at, claim_expires_at\n         FROM work_item WHERE status IN ('queued', 'claimed')\n         ORDER BY rowid LIMIT 1`,\n      )\n      .get() as unknown as\n      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n      | undefined;\n    db.exec(\"COMMIT;\");\n    if (head === undefined) return { outcome: \"empty\" };\n    if (head.status === \"claimed\") {\n      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n    }\n    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// Completion: the version-checked form writes and the item row's deletion in\n// one short transaction (DD-1: terminal transition deletes the row; the\n// disposition is reported in-memory, never stored). UPDATE-only, never\n// upsert — the pending row exists from enqueue; a write that finds no row at\n// the item's source version is discarded as stale (DD-3 truth table). The\n// optional onApplied hook (Story 3) runs inside this same transaction, after\n// the form writes and only when they landed — chunk placement and the\n// close→summary enqueues ride the completion commit; its onCommit\n// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\nexport function complete(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  writes: readonly HandlerFormWrite[],\n  derivedAt: string,\n  onApplied?: (tx: CompletionTx) => void,\n): \"done\" | \"stale_discarded\" {\n  const hooks = createCommitHooks();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    let hits = 0;\n    const update = db.prepare(\n      `UPDATE derived_form\n       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n    );\n    for (const write of writes) {\n      const changed = update.run(\n        write.content,\n        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n        derivedAt,\n        write.subjectKind,\n        write.subjectId,\n        write.form,\n        item.sourceVersion,\n      );\n      hits += Number(changed.changes);\n    }\n    const stale = writes.length > 0 && hits === 0;\n    if (!stale && onApplied !== undefined) {\n      onApplied({ db, onCommit: hooks.register });\n    }\n    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n    db.exec(\"COMMIT;\");\n    hooks.flush();\n    return stale ? \"stale_discarded\" : \"done\";\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\nexport interface RetryPolicy {\n  budget: number;\n  backoffBaseMs: number;\n  backoffCapMs: number;\n}\n\nexport type FailAttemptResult =\n  | { terminal: false; attempts: number; eligibleAt: string }\n  | { terminal: true; attempts: number };\n\n// Terminal failure: the form rows land `failed` (or `blocked` for source\n// damage) carrying the final reason plus attempts/last-error copied onto the\n// form's metadata, and the item row is deleted — one transaction (DD-1).\n// Form writes stay version-checked: if a mutation moved the source since this\n// item was queued, the stale failure must not stamp the rebuilt form.\nexport function failTerminal(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n): void {\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    const update = db.prepare(\n      `UPDATE derived_form\n       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n    );\n    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n    for (const target of item.forms) {\n      update.run(\n        opts.formState,\n        opts.reason,\n        metadata,\n        opts.now,\n        target.subjectKind,\n        target.subjectId,\n        target.form,\n        item.sourceVersion,\n      );\n    }\n    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// A failed run counts itself. Under budget and retryable: the row goes back\n// to `queued` with attempts incremented and eligibility pushed out by backoff\n// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n// on a non-retryable failure, the item is terminal: form `failed` with the\n// final reason, row deleted (AC-1.9).\nexport function failAttempt(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n): FailAttemptResult {\n  const attempts = item.attempts + 1;\n  if (opts.retryable && attempts < opts.retry.budget) {\n    const backoffMs = Math.min(\n      opts.retry.backoffBaseMs * 2 ** attempts,\n      opts.retry.backoffCapMs,\n    );\n    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      db.prepare(\n        `UPDATE work_item\n         SET status = 'queued', attempts = ?, last_error = ?,\n             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n         WHERE work_item_id = ?`,\n      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    return { terminal: false, attempts, eligibleAt };\n  }\n  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n  return { terminal: true, attempts };\n}\n\n// Cascade tidy (tech design issue 1): delete still-queued items for the given\n// (kind, sourceRef) targets, returning the deleted ids for the mutation\n// result's `superseded` list. Runs inside the caller's ambient transaction —\n// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n// Claimed items are deliberately left alone: the source-version check (DD-3)\n// discards their stale completions. Ships here as mechanics; its only caller\n// is Story 5's cascade.\nexport function supersedeQueued(\n  db: DatabaseSync,\n  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n): string[] {\n  const ids: string[] = [];\n  const remove = db.prepare(\n    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n     RETURNING work_item_id`,\n  );\n  for (const target of targets) {\n    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n      work_item_id: string;\n    }>;\n    for (const row of rows) ids.push(row.work_item_id);\n  }\n  return ids;\n}\n\n// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n// queued or in flight — for this kind and source at this source version?\n// Runs inside the caller's requeue transaction so the check and the enqueue\n// commit together (anti-shim: a check-then-enqueue split across transactions\n// reintroduces the duplicate-work race). Version-scoped on purpose: a\n// claimed pre-mutation item at an older version is dying work whose\n// completion DD-3 will discard — it must not block the repair.\nexport function hasLiveItem(\n  db: DatabaseSync,\n  kind: WorkKind,\n  sourceRef: WorkSourceRef,\n  sourceVersion: number,\n): boolean {\n  const row = db\n    .prepare(\n      `SELECT 1 FROM work_item\n       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n       LIMIT 1`,\n    )\n    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n  return row !== undefined;\n}\n\n// Live items left in the queue — the drain report's `remaining` and the\n// repair report's join source (Story 4).\nexport function countLiveItems(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n    .get() as unknown as { n: number | bigint };\n  return Number(row.n);\n}\n\nexport interface QueueDetailRow {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: string;\n  sourceRef: WorkSourceRef;\n  status: \"queued\" | \"claimed\";\n  attempts: number;\n  lastError?: string;\n  eligibleAt?: string;\n  claimedAt?: string;\n  claimExpiresAt?: string;\n  queuedAt: string;\n  sourceVersion: number;\n}\n\n// Mechanical detail of every live row in queue order — what the repair\n// report joins against derived_form (Flow 4) and what tests read to assert\n// lease/backoff state without raw SQL at every call site.\nexport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n  const rows = db\n    .prepare(\n      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n       FROM work_item ORDER BY rowid`,\n    )\n    .all() as unknown as Array<\n    RawClaimRow & {\n      status: string;\n      last_error: string | null;\n      eligible_at: string | null;\n      claimed_at: string | null;\n      claim_expires_at: string | null;\n    }\n  >;\n  return rows.map((row) => {\n    const item = toClaimedItem(row);\n    const detail: QueueDetailRow = {\n      workItemId: item.workItemId,\n      owner: item.owner,\n      kind: item.kind,\n      sourceRef: item.sourceRef,\n      status: row.status as \"queued\" | \"claimed\",\n      attempts: item.attempts,\n      queuedAt: item.queuedAt,\n      sourceVersion: item.sourceVersion,\n    };\n    if (row.last_error !== null) detail.lastError = row.last_error;\n    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n    return detail;\n  });\n}\n\n// Listing in queue order (insertion order within the walk); each owning\n// domain lists only its own items.\nexport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n  const rows = db\n    .prepare(\n      `SELECT work_item_id, owner, kind, source_ref, queued_at\n       FROM work_item WHERE owner = ? ORDER BY rowid`,\n    )\n    .all(owner) as unknown as RawWorkItemRow[];\n  return rows.map((row) => ({\n    workItemId: row.work_item_id,\n    owner: row.owner as WorkOwner,\n    kind: row.kind as WorkKind,\n    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n    status: \"queued\",\n    queuedAt: row.queued_at,\n  }));\n}\n","numLines":549,"startLine":1,"totalLines":549}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_539d0509e9d34970bdbe240f","type":"tool_result","content":"1\t// The name-keyed prompt registry (DD-8): one module per template exporting\n2\t// `{ name, render(input) → messages }`; config selects by name and dial-in\n3\t// swaps by adding a module and editing config — no handler, adapter, or host\n4\t// changes. Versioning is in the name (`smoothing-v1`).\n5\timport type { FormKind } from \"../../shared/derivation.js\";\n6\timport type { ModelCallInput } from \"../types.js\";\n7\timport { chunkBriefV1 } from \"./chunk-brief-v1.js\";\n8\timport { chunkDetailedV1 } from \"./chunk-detailed-v1.js\";\n9\timport { lowerBandV1 } from \"./lower-band-v1.js\";\n10\timport { smoothingV1 } from \"./smoothing-v1.js\";\n11\timport { toolCallV1 } from \"./tool-call-v1.js\";\n12\timport { toolResultV1 } from \"./tool-result-v1.js\";\n13\timport { turnComposeV1 } from \"./turn-compose-v1.js\";\n14\t\n15\texport interface PromptTemplate<I = unknown> {\n16\t  name: string;\n17\t  render(input: I): ModelCallInput[\"messages\"];\n18\t}\n19\t\n20\t// Every config-selectable name. `never` pins the registry read-only at the\n21\t// type level — rendering goes through the adapter, which owns the only\n22\t// kind→input pairing.\n23\texport const PROMPT_REGISTRY: Record<string, PromptTemplate<never>> = {\n24\t  [smoothingV1.name]: smoothingV1,\n25\t  [toolCallV1.name]: toolCallV1,\n26\t  [toolResultV1.name]: toolResultV1,\n27\t  [turnComposeV1.name]: turnComposeV1,\n28\t  [lowerBandV1.name]: lowerBandV1,\n29\t  [chunkDetailedV1.name]: chunkDetailedV1,\n30\t  [chunkBriefV1.name]: chunkBriefV1,\n31\t};\n32\t\n33\t// Every config-selectable prompt name — the catalog an operator's assignment\n34\t// config picks from. Exposed through the SDK surface (sdk.ts) so valid names\n35\t// are discoverable without reading source.\n36\texport const PROMPT_NAMES: readonly string[] = Object.keys(PROMPT_REGISTRY);\n37\t\n38\t// The default template per kind — the seven names an operator's first config\n39\t// reaches for, and what test fixtures assign.\n40\texport const DEFAULT_PROMPT_NAMES: Record<FormKind, string> = {\n41\t  smoothed_prompt: smoothingV1.name,\n42\t  tool_call_summary: toolCallV1.name,\n43\t  tool_result_summary: toolResultV1.name,\n44\t  turn_rendering: turnComposeV1.name,\n45\t  lower_band_projection: lowerBandV1.name,\n46\t  chunk_summary_detailed: chunkDetailedV1.name,\n47\t  chunk_summary_brief: chunkBriefV1.name,\n48\t};\n49\t"}]},"parent_tool_use_id":null,"session_id":"e3b84da0-9927-4ff1-80ac-66420760c742","uuid":"d3f1c590-dd21-46c8-a7c0-e02f4c85a845","timestamp":"2026-06-15T04:26:24.261Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/prompts/index.ts","content":"// The name-keyed prompt registry (DD-8): one module per template exporting\n// `{ name, render(input) → messages }`; config selects by name and dial-in\n// swaps by adding a module and editing config — no handler, adapter, or host\n// changes. Versioning is in the name (`smoothing-v1`).\nimport type { FormKind } from \"../../shared/derivation.js\";\nimport type { ModelCallInput } from \"../types.js\";\nimport { chunkBriefV1 } from \"./chunk-brief-v1.js\";\nimport { chunkDetailedV1 } from \"./chunk-detailed-v1.js\";\nimport { lowerBandV1 } from \"./lower-band-v1.js\";\nimport { smoothingV1 } from \"./smoothing-v1.js\";\nimport { toolCallV1 } from \"./tool-call-v1.js\";\nimport { toolResultV1 } from \"./tool-result-v1.js\";\nimport { turnComposeV1 } from \"./turn-compose-v1.js\";\n\nexport interface PromptTemplate<I = unknown> {\n  name: string;\n  render(input: I): ModelCallInput[\"messages\"];\n}\n\n// Every config-selectable name. `never` pins the registry read-only at the\n// type level — rendering goes through the adapter, which owns the only\n// kind→input pairing.\nexport const PROMPT_REGISTRY: Record<string, PromptTemplate<never>> = {\n  [smoothingV1.name]: smoothingV1,\n  [toolCallV1.name]: toolCallV1,\n  [toolResultV1.name]: toolResultV1,\n  [turnComposeV1.name]: turnComposeV1,\n  [lowerBandV1.name]: lowerBandV1,\n  [chunkDetailedV1.name]: chunkDetailedV1,\n  [chunkBriefV1.name]: chunkBriefV1,\n};\n\n// Every config-selectable prompt name — the catalog an operator's assignment\n// config picks from. Exposed through the SDK surface (sdk.ts) so valid names\n// are discoverable without reading source.\nexport const PROMPT_NAMES: readonly string[] = Object.keys(PROMPT_REGISTRY);\n\n// The default template per kind — the seven names an operator's first config\n// reaches for, and what test fixtures assign.\nexport const DEFAULT_PROMPT_NAMES: Record<FormKind, string> = {\n  smoothed_prompt: smoothingV1.name,\n  tool_call_summary: toolCallV1.name,\n  tool_result_summary: toolResultV1.name,\n  turn_rendering: turnComposeV1.name,\n  lower_band_projection: lowerBandV1.name,\n  chunk_summary_detailed: chunkDetailedV1.name,\n  chunk_summary_brief: chunkBriefV1.name,\n};\n","numLines":49,"startLine":1,"totalLines":49}}}

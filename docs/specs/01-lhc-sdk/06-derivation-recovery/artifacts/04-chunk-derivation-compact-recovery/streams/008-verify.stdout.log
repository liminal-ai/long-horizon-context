hile deriving ${kind}`,\n   302\t        );\n   303\t      }\n   304\t      return dependencyNotReady(\n   305\t        `member_projection_not_ready: member ${member.turnId} lower_band_projection is ${member.state ?? \"missing\"}`,\n   306\t      );\n   307\t    }\n   308\t\n   309\t    const result =\n   310\t      kind === \"chunk_summary_detailed\"\n   311\t        ? await run.provider.summarizeChunkDetailed({\n   312\t            memberProjections,\n   313\t            memberReceipts: members.map((member) => member.receipts),\n   314\t          })\n   315\t        : await run.provider.summarizeChunkBrief({\n   316\t            memberProjections,\n   317\t            memberOutcomes: members.map((member) =>\n   318\t              member.receipts.map((receipt) => receipt.outcome),\n   319\t            ),\n   320\t          });\n   321\t    if (!result.ok) return providerFailed(result);\n   322\t\n   323\t    return {\n   324\t      ok: true,\n   325\t      derivations: [\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '110,175p'\"","aggregated_output":"   110\t  return rows;\n   111\t}\n   112\t\n   113\t// Member projections in turn order for the chunk summaries: every\n   114\t// chunk_member row by member_idx, each joined to its canonical turn, stored\n   115\t// lower_band_projection row (state + content as landed — never re-derived),\n   116\t// and turn_rendering's mechanically stamped tool-run receipts (AC-3.8: the\n   117\t// detailed summary's receipt material, read not re-derived). Missing turns\n   118\t// are returned as source corruption so background summaries block instead of\n   119\t// silently summarizing a shortened member list; SDK soft-deleted turns stay\n   120\t// filtered because sanctioned delete rebuilds chunk summaries from survivors.\n   121\texport interface MemberProjection {\n   122\t  turnId: string;\n   123\t  state?: string; // undefined: no projection row exists for the member\n   124\t  content?: string;\n   125\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n   126\t  sourceCorruptionReason?: string;\n   127\t}\n   128\t\n   129\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n   130\t  const rows = db\n   131\t    .prepare(\n   132\t      `SELECT cm.turn_id, t.turn_id AS existing_turn_id, t.deleted_at,\n   133\t              df.state, df.content, rf.metadata AS rendering_metadata\n   134\t       FROM chunk_member cm\n   135\t       LEFT JOIN turns t ON t.turn_id = cm.turn_id\n   136\t       LEFT JOIN derivation df ON df.subject_kind = 'turn'\n   137\t         AND df.subject_id = cm.turn_id AND df.derivation_type = 'lower_band_projection'\n   138\t       LEFT JOIN derivation rf ON rf.subject_kind = 'turn'\n   139\t         AND rf.subject_id = cm.turn_id AND rf.derivation_type = 'turn_rendering'\n   140\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   141\t    )\n   142\t    .all(chunkId) as unknown as Array<{\n   143\t    turn_id: string;\n   144\t    state: string | null;\n   145\t    content: string | null;\n   146\t    rendering_metadata: string | null;\n   147\t    existing_turn_id: string | null;\n   148\t    deleted_at: string | null;\n   149\t  }>;\n   150\t  return rows.flatMap((row) => {\n   151\t    if (row.deleted_at !== null) return [];\n   152\t    const metadata =\n   153\t      row.rendering_metadata === null\n   154\t        ? undefined\n   155\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n   156\t    const projection: MemberProjection = {\n   157\t      turnId: row.turn_id,\n   158\t      receipts: metadata?.receipts ?? [],\n   159\t    };\n   160\t    if (row.existing_turn_id === null) {\n   161\t      projection.sourceCorruptionReason = `canonical record corrupt: chunk ${chunkId} member ${row.turn_id} references missing turn`;\n   162\t    }\n   163\t    if (row.state !== null) projection.state = row.state;\n   164\t    if (row.content !== null) projection.content = row.content;\n   165\t    return [projection];\n   166\t  });\n   167\t}\n   168\t\n   169\tinterface RawOwnedFormRow {\n   170\t  subject_id: string;\n   171\t  derivation_type: string;\n   172\t  state: string;\n   173\t  content: string | null;\n   174\t  reason: string | null;\n   175\t  metadata: string | null;\n","exit_code":0,"status":"completed"}}

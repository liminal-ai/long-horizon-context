ckages/lhc/test/derivation-messages.test.ts\n M packages/lhc/test/derivation-turns.test.ts\n M packages/lhc/test/epic-fix-02.test.ts\n M packages/lhc/test/fixtures.test.ts\n M packages/lhc/test/fixtures/corrupt.ts\n M packages/lhc/test/fixtures/index.ts\n M packages/lhc/test/fixtures/legacy.ts\n M packages/lhc/test/fixtures/lifecycle.ts\n M packages/lhc/test/fixtures/model-call.ts\n M packages/lhc/test/fixtures/provider-double.ts\n M packages/lhc/test/fixtures/read-only-delta.ts\n M packages/lhc/test/fixtures/seam-conformance.ts\n M packages/lhc/test/fixtures/threads.ts\n M packages/lhc/test/fixtures/view-thread.ts\n M packages/lhc/test/fixtures/work-handlers.ts\n M packages/lhc/test/goldens/g1-proportions.json\n M packages/lhc/test/goldens/g2-edge-exclusion.json\n M packages/lhc/test/goldens/g2-edge-inclusion.json\n M packages/lhc/test/goldens/g3-oversized-loner.json\n M packages/lhc/test/goldens/g4-turnless-straggler.json\n M packages/lhc/test/goldens/prompts/smoothing-v1.golden.json\n M packages/lhc/test/goldens/prompts/tool-result-v1.golden.json\n M packages/lhc/test/inference-adapter.test.ts\n M packages/lhc/test/inference-classification.test.ts\n M packages/lhc/test/inference-construction.test.ts\n M packages/lhc/test/inference-prompts.test.ts\n M packages/lhc/test/inference-real.test.ts\n M packages/lhc/test/inference-routing.test.ts\n M packages/lhc/test/inspect-health.test.ts\n M packages/lhc/test/inspect-overview.test.ts\n M packages/lhc/test/inspect-view.test.ts\n M packages/lhc/test/lifecycle.test.ts\n M packages/lhc/test/messages-read.test.ts\n M packages/lhc/test/mutations-delete.test.ts\n M packages/lhc/test/mutations.test.ts\n M packages/lhc/test/report-repair.test.ts\n M packages/lhc/test/retirement.test.ts\n M packages/lhc/test/thread-migration.test.ts\n M packages/lhc/test/turns.test.ts\n M packages/lhc/test/view-boundary.test.ts\n M packages/lhc/test/view-compact.test.ts\n M packages/lhc/test/view-fixture.test.ts\n M packages/lhc/test/view-pull.test.ts\n M packages/lhc/test/view-render-targets.test.ts\n M packages/lhc/test/view-select-golden.test.ts\n M packages/lhc/test/view-sweep.test.ts\n M packages/lhc/test/work-execution-legacy.test.ts\n M packages/lhc/test/work-execution.test.ts\n M packages/lhc/test/work-queue.test.ts\n?? docs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/\n?? docs/specs/01-lhc-sdk/06-derivation-recovery/impl-run.config.json\n?? docs/specs/01-lhc-sdk/06-derivation-recovery/team-impl-log.md\n?? packages/lhc/src/domains/messages/internal/smoothing.ts\n?? packages/lhc/src/domains/turns/internal/chunk-recovery.ts\n?? packages/lhc/src/domains/turns/internal/recovery.ts\n?? packages/lhc/src/shared/tool-result-rendering.ts\n?? packages/lhc/src/tech-utils/logging/\n?? packages/lhc/test/chunk-compact-recovery.test.ts\n?? packages/lhc/test/logging-surface.test.ts\n?? packages/lhc/test/smoothing-recovery.test.ts\n?? packages/lhc/test/tool-result-rendering.test.ts\n?? packages/lhc/test/turn-cascade.test.ts\n","exit_code":0,"status":"completed"}}

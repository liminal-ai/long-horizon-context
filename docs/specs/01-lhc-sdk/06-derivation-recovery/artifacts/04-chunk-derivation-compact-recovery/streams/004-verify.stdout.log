);\n   491\t    const promptId = sent.value.events[0]?.messageId;\n   492\t    if (promptId !== undefined && promptId !== null) promptIdByTurn.set(turn, promptId);\n   493\t    const drained = await sdk.work.drain({ filePath });\n   494\t    if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\n   495\t  }\n   496\t\n   497\t  // Post-build edits, NOT drained: the cascade clears each edited message's\n   498\t  // dependent chain to pending. t8 ⇒ a PENDING turn rendering in the smooth\n   499\t  // band; t4+t5+t6 ⇒ c2's summaries pending with zero ready member\n   500\t  // projections — the gap rung.\n   501\t  for (const turn of [4, 5, 6, 8]) {\n   502\t    const promptId = promptIdByTurn.get(turn);\n   503\t    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\n   504\t    const edited = await sdk.messages.edit(\n   505\t      { filePath },\n   506\t      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\n   507\t    );\n   508\t    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\n   509\t  }\n   510\t  return { filePath, sdk, double, promptIdByTurn };\n   511\t}\n   512\t\n   513\tdescribe(\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\", () => {\n   514\t  let degradedStore: TempStore;\n   515\t  let degraded: DegradedThread;\n   516\t\n   517\t  beforeAll(async () => {\n   518\t    degradedStore = tempStore();\n   519\t    degraded = await buildDegradedThread(degradedStore);\n   520\t  });\n","exit_code":0,"status":"completed"}}

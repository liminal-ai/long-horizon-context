ojection_not_ready: member ${member.turnId} lower_band_projection is ${member.state ?? \"missing\"}`,\n   303\t      );\n   304\t    }\n   305\t\n   306\t    const result =\n   307\t      kind === \"chunk_summary_detailed\"\n   308\t        ? await run.provider.summarizeChunkDetailed({\n   309\t            memberProjections,\n   310\t            memberReceipts: members.map((member) => member.receipts),\n   311\t          })\n   312\t        : await run.provider.summarizeChunkBrief({\n   313\t            memberProjections,\n   314\t            memberOutcomes: members.map((member) =>\n   315\t              member.receipts.map((receipt) => receipt.outcome),\n   316\t            ),\n   317\t          });\n   318\t    if (!result.ok) return providerFailed(result);\n   319\t\n   320\t    return {\n   321\t      ok: true,\n   322\t      derivations: [\n   323\t        {\n   324\t          subjectKind: \"chunk\",\n   325\t          subjectId: chunkId,\n   326\t          derivationType: kind,\n   327\t          content: result.text,\n   328\t          ...(result.provenance === undefined\n   329\t            ? {}\n   330\t            : { metadata: { provenance: result.provenance } }),\n","exit_code":0,"status":"completed"}}

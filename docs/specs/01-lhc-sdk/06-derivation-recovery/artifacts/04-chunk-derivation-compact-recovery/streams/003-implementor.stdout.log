{"type":"item.completed","item":{"id":"item_74","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-compact.test.ts | sed -n '500,600p' && nl -ba packages/lhc/test/inspect-view.test.ts | sed -n '210,238p'\"","aggregated_output":"   500\t  // projections — the gap rung.\n   501\t  for (const turn of [4, 5, 6, 8]) {\n   502\t    const promptId = promptIdByTurn.get(turn);\n   503\t    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\n   504\t    const edited = await sdk.messages.edit(\n   505\t      { filePath },\n   506\t      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\n   507\t    );\n   508\t    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\n   509\t  }\n   510\t  return { filePath, sdk, double, promptIdByTurn };\n   511\t}\n   512\t\n   513\tdescribe(\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\", () => {\n   514\t  let degradedStore: TempStore;\n   515\t  let degraded: DegradedThread;\n   516\t\n   517\t  beforeAll(async () => {\n   518\t    degradedStore = tempStore();\n   519\t    degraded = await buildDegradedThread(degradedStore);\n   520\t  });\n   521\t  afterAll(() => {\n   522\t    degradedStore.cleanup();\n   523\t  });\n   524\t\n   525\t  it(\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\", async () => {\n   526\t    const captured = degraded.double.captureInputs();\n   527\t    const capturedBefore = captured.length;\n   528\t\n   529\t    const receipt = await degraded.sdk.threadView.compact(\n   530\t      { filePath: degraded.filePath },\n   531\t      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\n   532\t    );\n   533\t    expect(receipt.ok).toBe(true);\n   534\t    if (!receipt.ok) return;\n   535\t\n   536\t    // The pending turn rendering (t8, edited): the smooth entry degrades down\n   537\t    // its ladder (projection pending too) to the deterministic excerpt.\n   538\t    const t8 = receipt.value.degraded.find((entry) => entry.subjectId === \"t8\");\n   539\t    expect(t8).toBeDefined();\n   540\t    expect(t8?.band).toBe(\"smooth\");\n   541\t    expect(t8?.usedDerivation).toBe(\"message_excerpt\");\n   542\t\n   543\t    // The failed chunk summary (c1's brief): the brief entry renders the\n   544\t    // truncated detailed summary, marked.\n   545\t    const c1 = receipt.value.degraded.find((entry) => entry.subjectId === \"c1\");\n   546\t    expect(c1).toBeDefined();\n   547\t    expect(c1?.band).toBe(\"brief\");\n   548\t    expect(c1?.usedDerivation).toBe(\"chunk_summary_detailed_truncated\");\n   549\t\n   550\t    // The unusable chunk (c2: summaries pending, zero ready member\n   551\t    // projections): an explicit gap entry with its reason — never absence.\n   552\t    expect(receipt.value.gaps).toHaveLength(1);\n   553\t    const gap = receipt.value.gaps[0];\n   554\t    expect(gap?.subjectId).toBe(\"c2\");\n   555\t    expect(gap?.reason).toMatch(/no usable form/);\n   556\t    expect(gap?.reason).toContain(\"chunk_summary_detailed: pending\");\n   557\t\n   558\t    // Per-band counts present; no span silently absent: every turn in the\n   559\t    // compacted range is accounted for by a band subject (c1: t1–t3, c2:\n   560\t    // t4–t6, smooth: t7–t8) and everything after the compact point is tail.\n   561\t    expect(receipt.value.bands.brief.entries).toBe(1);\n   562\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n   563\t    expect(receipt.value.bands.smooth.entries).toBe(2);\n   564\t    expect(receipt.value.compactPoint).toBe(48);\n   565\t    expect(receipt.value.coveredFrom).toBe(1);\n   566\t\n   567\t    // The rendered text carries the markers (degrade visibly, AC-2.5/2.10).\n   568\t    const messages = await pullMessages(degraded.sdk, degraded.filePath);\n   569\t    const bandText = bandMessages(messages)\n   570\t      .map((message) => message.content)\n   571\t      .join(\"\\n\\n\");\n   572\t    expect(bandText).toContain(\"[degraded: brief-from-detailed]\");\n   573\t    expect(bandText).toContain(\"[degraded: smooth-from-excerpt]\");\n   574\t    expect(bandText).toMatch(/§c2 \\[chunk c2 unavailable: no usable form/);\n   575\t\n   576\t    // Zero provider calls: missing material degrades, it is never re-derived\n   577\t    // inline (AC-2.4's no-inference rule with teeth).\n   578\t    expect(captured.length).toBe(capturedBefore);\n   579\t  });\n   580\t\n   581\t  it(\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\", async () => {\n   582\t    const status = await degraded.sdk.threadView.status({ filePath: degraded.filePath });\n   583\t    expect(status.ok).toBe(true);\n   584\t    if (!status.ok) return;\n   585\t    expect(status.value.view).not.toBeNull();\n   586\t    expect(status.value.view?.degraded).toBe(2);\n   587\t    expect(status.value.view?.gaps).toBe(1);\n   588\t    expect(typeof status.value.view?.builtAt).toBe(\"string\");\n   589\t    // The edits' requeued rebuild work is visible as pending derivation.\n   590\t    expect(status.value.derivation.pending).toBeGreaterThan(0);\n   591\t  });\n   592\t});\n   593\t\n   594\tdescribe(\"TC-2.7 (AC-2.5): canonical corruption refuses; derived-only damage degrades\", () => {\n   595\t  it(\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\", async () => {\n   596\t    const corruptStore = tempStore();\n   597\t    try {\n   598\t      const double = createProviderDouble();\n   599\t      const sdk = createSdk({ provider: double, mode: \"manual\" });\n   600\t      const filePath = corruptStore.threadPath();\n   210\t      profile: null,\n   211\t      config: {\n   212\t        lowerBound: DEGRADED_COMPACT_PARAMS.lowerBound,\n   213\t        percentages: DEGRADED_COMPACT_PARAMS.percentages,\n   214\t      },\n   215\t      compactPoint: raw.compactPoint,\n   216\t      coveredFrom: raw.coveredFrom,\n   217\t    });\n   218\t    expect(report.meta?.config).toEqual(raw.config);\n   219\t\n   220\t    // Every band entry in served order with form/degraded verbatim; per-band\n   221\t    // stored token counts; every gap with its reason — all from the row.\n   222\t    expect(report.bands).toEqual(bandsFromRaw(raw));\n   223\t    expect(report.gaps).toEqual(raw.gaps);\n   224\t    expect(report.sourceState).toEqual(raw.sourceState);\n   225\t\n   226\t    // Fixture sanity: the degraded entry (t8's smooth fallback) and the gap\n   227\t    // (c2, no usable form) both present and named.\n   228\t    const entries = report.bands.flatMap((band) => band.entries);\n   229\t    expect(entries.some((entry) => entry.subjectId === \"t8\" && entry.degraded)).toBe(true);\n   230\t    expect(report.gaps.length).toBeGreaterThanOrEqual(1);\n   231\t    expect(report.gaps.some((gap) => gap.subjectId === \"c2\" && /no usable form/.test(gap.reason))).toBe(\n   232\t      true,\n   233\t    );\n   234\t\n   235\t    // Load-cost parity on the compacted shape too (bands + tail): an\n   236\t    // independent pull re-measured with the same estimator.\n   237\t    const pulled = valueOf<{ messages: Array<{ content: string; band?: string }> }>(\n   238\t      await sdk.threadView.pull({ filePath }),\n","exit_code":0,"status":"completed"}}

// A successful handler hands its derivation content back as data; the\\n   223\\t// drain's completion transaction performs the version-checked UPDATE and the\\n   224\\t// item-row deletion atomically (tech design §Mechanics: completion is one\\n   225\\t// short BEGIN IMMEDIATE doing the derivation write and the delete). The handler\\n   226\\t// never opens that transaction itself, so the version check and the\\n   227\\t// done/stale_discarded disposition stay in one place — the queue util.\\n   228\\texport interface HandlerDerivationWrite {\\n   229\\t  subjectKind: SubjectKind;\\n   230\\t  subjectId: string;\\n   231\\t  derivationType: DerivationType;\\n   232\\t  content: string;\\n   233\\t  metadata?: DerivationMetadata;\\n   234\\t  gaps?: DependencyGap[];\\n   235\\t}\\n   236\\t\\n   237\\t// The completion-transaction hook (Story 3): work that must land atomically\\n   238\\t// with the version-checked derivation writes — chunk placement and the\\n   239\\t// close→summary enqueues above all. The queue util invokes it inside the\\n   240\\t// completion's BEGIN IMMEDIATE, after the derivation writes and only when they hit\\n   241\\t// (a stale completion must not place a turn or enqueue summaries); onCommit\\n   242\\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\\n   243\\t// crash leaves either a placed turn with its enqueues or nothing — never a\\n   244\\t// derived-but-unplaced turn.\\n   245\\texport interface CompletionTx {\\n   246\\t  db: DatabaseSync;\\n   247\\t  onCommit: (fn: () => void) => void;\\n   248\\t}\\n   249\\t\\n   250\\texport type HandlerOutcome =\\n   251\\t  | { ok: true; derivations?: HandlerDerivationWrite[]; onApplied?: (tx: CompletionTx) => void }\\n   252\\t  | { ok: false; retryable: boolean; reason: string }\\n   253\\t  | { ok: false; blocked: true; reason: string }; // source damage → derivation blocked, item terminal\\n   254\\t\\n   255\\t// item is the queue util's WorkItemRecord; typed structurally here so the\\n   256\\t// shared layer does not depend on the util's module (and vice versa stays\\n   257\\t// one-directional: tech-utils imports shared).\\n   258\\texport type WorkHandler = (\\n   259\\t  run: HandlerRunContext,\\n   260\\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\\n   261\\t) => Promise<HandlerOutcome>;\\npackages/lhc/src/sdk.ts:101:  HandlerRunContext,\\npackages/lhc/src/sdk.ts:101:  HandlerRunContext,\\npackages/lhc/src/shared/derivation.ts:215:export interface HandlerRunContext {\\npackages/lhc/src/shared/derivation.ts:216:  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\\npackages/lhc/src/shared/derivation.ts:259:  run: HandlerRunContext,\\npackages/lhc/src/shared/storage.ts:41:  // claimNext's ORDER BY rowid walks the head as before.\\npackages/lhc/src/scheduler.ts:25:  claimNext,\\npackages/lhc/src/scheduler.ts:102:    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\\npackages/lhc/src/scheduler.ts:136:        { openDb: () => db, provider, clock, config: deps.config },\\npackages/lhc/src/scheduler.ts:182:    // next claimNext re-reads the head — a backing-off head ends the drain\\npackages/lhc/src/scheduler.ts:238:// nudge once, not busy-spin (the durable claimNext gate is the real guard).\\npackages/lhc/src/scheduler.ts:313:  // rides claimNext's durable gate, so a coarse timer never retries early.\\npackages/lhc/src/domains/turns/internal/derive.ts:15:  HandlerRunContext,\\npackages/lhc/src/domains/turns/internal/derive.ts:48:function readThreadId(run: HandlerRunContext): string {\\npackages/lhc/src/domains/turns/internal/derive.ts:49:  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\\npackages/lhc/src/domains/turns/internal/derive.ts:56:  run: HandlerRunContext,\\npackages/lhc/src/domains/turns/internal/derive.ts:64:  const db = run.openDb();\\npackages/lhc/src/domains/turns/in
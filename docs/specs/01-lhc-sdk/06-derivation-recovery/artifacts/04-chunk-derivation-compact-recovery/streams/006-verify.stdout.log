nd === \"concat\") {\n   226\t    return {\n   227\t      derivationUsed: \"stored_member_concat\",\n   228\t      body: material.content,\n   229\t      degraded: true,\n   230\t      gap: false,\n   231\t      degradedMarker: \"detailed-from-stored-members\",\n   232\t      reason: material.reason,\n   233\t    };\n   234\t  }\n   235\t  return {\n   236\t    derivationUsed: \"gap\",\n   237\t    body: \"\",\n   238\t    degraded: false,\n   239\t    gap: true,\n   240\t    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, compact material absent)`,\n   241\t  };\n   242\t}\n   243\t\n   244\t// Brief (chunk) ladder: chunk_summary_brief → chunk_summary_detailed\n   245\t// truncated → gap entry (no projections rung in this band's ladder).\n   246\texport function resolveBriefRepresentation(\n   247\t  chunkId: string,\n   248\t  lookup: DerivationLookup,\n   249\t  material?: CompactChunkMaterialSnapshot,\n   250\t): ResolvedRepresentation {\n   251\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n   252\t  if (usable(brief)) {\n   253\t    return { derivationUsed: \"chunk_summary_brief\", body: brief.content, degraded: false, gap: false };\n   254\t  }\n   255\t  if (material?.kind === \"ready\") {\n   256\t    return {\n   257\t      derivationUsed: \"chunk_summary_brief\",\n   258\t      body: material.content,\n   259\t      degraded: false,\n   260\t      gap: false,\n   261\t    };\n   262\t  }\n   263\t  if (material?.kind === \"concat\") {\n   264\t    return {\n   265\t      derivationUsed: \"stored_member_concat\",\n   266\t      body: material.content,\n   267\t      degraded: true,\n   268\t      gap: false,\n   269\t      degradedMarker: \"brief-from-stored-members\",\n   270\t      reason: material.reason,\n   271\t    };\n   272\t  }\n   273\t  return {\n   274\t    derivationUsed: \"gap\",\n   275\t    body: \"\",\n   276\t    degraded: false,\n   277\t    gap: true,\n   278\t    reason: `no usable form (chunk_summary_brief: ${ladderState(brief)}, compact material absent)`,\n   279\t  };\n   280\t}\n   281\t\n   282\t// The per-message line an excerpt or note renders — a compact, deterministic\n   283\t// projection of the raw record (last-rung fallback, not the tail mapping).\n   284\texport function excerptLine(\n   285\t  kind: string,\n   286\t  blocks: ReadonlyArray<{ blockType: string; content: Record<string, unknown> }>,\n   287\t): string {\n   288\t  const content = blocks[0]?.content ?? {};\n   289\t  const text = typeof content[\"text\"] === \"string\" ? content[\"text\"] : \"\";\n   290\t  switch (kind) {\n","exit_code":0,"status":"completed"}}

   32\\\\t  }\\\\n    33\\\\t  return undefined;\\\\n    34\\\\t}\\\\n    35\\\\t\\\\n    36\\\\texport function hasLiveRecoveryWork(\\\\n    37\\\\t  db: DatabaseSync,\\\\n    38\\\\t  r: {\\\\n    39\\\\t    subjectKind: SubjectKind;\\\\n    40\\\\t    subjectId: string;\\\\n    41\\\\t    derivationType: DerivationType;\\\\n    42\\\\t    sourceVersion: number;\\\\n    43\\\\t  },\\\\n    44\\\\t): boolean {\\\\n    45\\\\t  const target = workTargetFor(r.subjectKind, r.subjectId, r.derivationType);\\\\n    46\\\\t  return target !== undefined && hasLiveItem(db, target.kind, target.sourceRef, r.sourceVersion);\\\\n    47\\\\t}\\\\n    48\\\\t\\\\n    49\\\\texport function recoverDerivation(\\\\n    50\\\\t  db: DatabaseSync,\\\\n    51\\\\t  r: {\\\\n    52\\\\t    subjectKind: SubjectKind;\\\\n    53\\\\t    subjectId: string;\\\\n    54\\\\t    derivationType: DerivationType;\\\\n    55\\\\t    content: string;\\\\n    56\\\\t    metadata?: DerivationMetadata;\\\\n    57\\\\t    sourceVersion: number;\\\\n    58\\\\t    derivedAt: string;\\\\n    59\\\\t  },\\\\n    60\\\\t): { persisted: boolean } {\\\\n    61\\\\t  db.exec(\\\\\\\"BEGIN IMMEDIATE;\\\\\\\");\\\\n    62\\\\t  try {\\\\n    63\\\\t    if (hasLiveRecoveryWork(db, r)) {\\\\n    64\\\\t      db.exec(\\\\\\\"COMMIT;\\\\\\\");\\\\n    65\\\\t      return { persisted: false };\\\\n    66\\\\t    }\\\\n    67\\\\t    const changed = db\\\\n    68\\\\t      .prepare(\\\\n    69\\\\t        `UPDATE derivation\\\\n    70\\\\t         SET state = 'ready', content = ?, reason = NULL, metadata = ?,\\\\n    71\\\\t             gaps = NULL, derived_at = ?\\\\n    72\\\\t         WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ?\\\\n    73\\\\t           AND source_version = ?\\\\n    74\\\\t           AND state IN ('pending', 'failed')`,\\\\n    75\\\\t      )\\\\n    76\\\\t      .run(\\\\n    77\\\\t        r.content,\\\\n    78\\\\t        r.metadata === undefined ? null : JSON.stringify(r.metadata),\\\\n    79\\\\t        r.derivedAt,\\\\n    80\\\\t        r.subjectKind,\\\\n    81\\\\t        r.subjectId,\\\\n    82\\\\t        r.derivationType,\\\\n    83\\\\t        r.sourceVersion,\\\\n    84\\\\t      );\\\\n    85\\\\t    db.exec(\\\\\\\"COMMIT;\\\\\\\");\\\\n    86\\\\t    return { persisted: Number(changed.changes) > 0 };\\\\n    87\\\\t  } catch (cause) {\\\\n    88\\\\t    db.exec(\\\\\\\"ROLLBACK;\\\\\\\");\\\\n    89\\\\t    throw cause;\\\\n    90\\\\t  }\\\\n    91\\\\t}\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/streams/006-verify.stdout.log:12:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/internal/compose.ts'\\\",\\\"aggregated_output\\\":\\\"     1\\\\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\\\\n     2\\\\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\\\\n     3\\\\t// gap records where a form is not ready. Pure by anti-shim requirement —\\\\n     4\\\\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\\\\n     5\\\\t// clock in the signature: determinism is structural, not disciplined.\\\\n     6\\\\t//\\\\n     7\\\\t// Tool activity stays in message order and groups into runs (AC-3.4, Fix 2):\\\\n     8\\\\t// a maximal stretch of consecutive tool_call/tool_result messages folds into\\\\n     9\\\\t// ONE RenderingPart and ONE receipt — a run-level account naming the tools,\\\\n    10\\\\t// the call count, and the per-call mechanical outcomes, so a run containing a\\\\n    11\\\\t// state-changing call structurally cannot lose its outcome and mixed outcomes\\\\n    12\\\\t// stay explicit, never collapsed into a vague success. Prompts and assistant\\\\n    13\\\\t// text break a run; thinking and runtime notes do not (interior ones ride the\\\\n    14\\\\t// run account inline, edge ones stand alone) — a story-deviation decision.\\\\n    15\\\\t// Runs are never reordered to make accounts tidier; the outcome rides the\\\\n    16\\\\t// part, not the prose.\\\\n    17\\\\timport type {\\\\n    18\\\\t  DependencyGap,\\\\n    19\\\\t  DerivationMetadata,\\\\n    20\\\\t  DerivationState,\\\\n    21\\\\t  DerivationType,\\\\n    22\\\\t  RenderingPart,\\\\n    23\\\\t  RenderingPartKind,\\\\n    24\\\\t  ToolOutcome,\\\\n    25\\\\t  ToolRunReceipt,\\\\n    26\\\\t} from \\\\\\\"../../../shared/derivation.js\\\\\\\";\\\\n    27\\\\timport { truncateForFallback } from \\\\\\\"../../../shared/tool-result-rendering.js\\\\\\\";\\\\n    28\\\\timport { cleanPrompt } from \\\\\\\"../../messages/index.js\\\\\\\";\\\\n    29\\\\t\\\\n    30\\\\t// The member message as the composer sees it: kind plus projected blocks,\\\\n    31\\\\t// verbatim from the record (already deleted-filtered by the caller's read).\\\\n    32\\\\texport interface ComposeMessage {\\\\n    33\\\\t  messageId: string;\\\\n    34\\\\t  kind: RenderingPartKind;\\\\n    35\\\\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\\\\n    36\\\\t}\\\\n    37\\\\t\\\\n    38\\\\t// One message-owned form row as composition input; keyed by the caller as\\\\n    39\\\\t// `${messageId}/${form}`.\\\\n    40\\\\texport interface ComposeFormRow {\\\\n    41\\\\t  state: DerivationState;\\\\n    42\\\\t  content?: string;\\\\n    43\\\\t  metadata?: DerivationMetadata;\\\\n    44\\\\t  reason?: string;\\\\n    45\\\\t  sourceVersion: number;\\\\n    46\\\\t}\\\\n    47\\\\t\\\\n    48\\\\texport function composeFormKey(messageId: string, form: DerivationType): string {\\\\n    49\\\\t  return `${messageId}/${form}`;\\\\n    50\\\\t}\\\\n    51\\\\t\\\\n    52\\\\texport interface CompositionInput {\\\\n    53\\\\t  parts: RenderingPart[];\\\\n    54\\\\t  gaps: DependencyGap[];\\\\n    55\\\\t  recoveries: RecoveryReceipt[];\\\\n    56\\\\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\\\\n    57\\\\t  // account + outcome, in message order — pure restatement of the\\\\n    58\\\\t  // composition input, stamped on the rendering so chunk summaries read\\\\n    59\\\\t  // receipts without re-deriving anything.\\\\n    60\\\\t  receipts: ToolRunReceipt[];\\\\n    61\\\\t}\\\\n    62\\\\t\\\\n    63\\\\texport interface RecoveryReceipt {\\\\n    64\\\\t  subjectKind: \\\\\\\"message\\\\\\\";\\\\n    65\\\\t  subjectId: string;\\\\n    66\\\\t  derivationType: DerivationType;\\\\n    67\\\\t  content: string;\\\\n    68\\\\t  sourceVersion: number;\\\\n    69\\\\t  reason: \\\\\\\"not_ready\\\\\\\" | \\\\\\\"failed_floor\\\\\\\";\\\\n    70\\\\t  floorUsed: string;\\\\n    71\\\\t}\\\\n    72\\\\t\\\\n    73\\\\tfunction textOf(message: ComposeMessage): string {\\\\n    74\\\\t  const text = message.blocks[0]?.content[\\\\\\\"text\\\\\\\"];\\\\n    75\\\\t  return typeof text === \\\\\\\"string\\\\\\\" ? text : \\\\\\\"\\\\\\\";\\\\n    76\\\\t}\\\\n    77\\\\t\\\\n    78\\\\tfunction promptFallbackText(message: ComposeMessage): string {\\\\n    79\\\\t  const original = textOf(message);\\\\n    80\\\\t  const floor = cleanPrompt(original);\\\\n    81\\\\t  return floor.length === 0 && original.length > 0 ? original : floor;\\\\n    82\\\\t}\\\\n    83\\\\t\\\\n    84\\\\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\\\\n    85\\\\t// composition): a tool call's outcome comes from its paired result among the\\\\n    86\\\\t// turn's messages — present and clean, present and isError, or absent.\\\\n    87\\\\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\\\\n    88\\\\t  const byCallId = new Map<string, boolean>();\\\\n    89\\\\t  for (const message of messages) {\\\\n    90\\\\t    if (message.kind !== \\\\\\\"tool_result\\\\\\\") continue;\\\\n    91\\\\t    const block = message.blocks[0]?.content ?? {};\\\\n    92\\\\t    const callId = block[\\\\\\\"toolCallId\\\\\\\"];\\\\n    93\\\\t    if (typeof callId === \\\\\\\"string\\\\\\\") byCallId.set(callId, block[\\\\\\\"isError\\\\\\\"] === true);\\\\n    94\\\\t  }\\\\n    95\\\\t  return byCallId;\\\\n    96\\\\t}\\\\n    97\\\\t\\\\n    98\\\\tfunction outcomeFromRecord(\\\\n    99\\\\t  resultByCallId: Map<string, boolean>,\\\\n   100\\\\t  callId: unknown,\\\\n   101\\\\t): ToolOutcome {\\\\n   102\\\\t  if (typeof callId !== \\\\\\\"string\\\\\\\") return \\\\\\\"unknown\\\\\\\";\\\\n   103\\\\t  const isError = resultByCallId.get(callId);\\\\n   104\\\\t  if (isError === undefined) return \\\\\\\"unknown\\\\\\\";\\\\n   105\\\\t  return isError ? \\\\\\\"failed\\\\\\\" : \\\\\\\"succeeded\\\\\\\";\\\\n   106\\\\t}\\\\n   107\\\\t\\\\n   108\\\\tinterface PartPlan {\\\\n   109\\\\t  form?: DerivationType; // the message-level form this kind composes from, if any\\\\n   110\\\\t  fallbackText: (message: ComposeMessage) => string;\\\\n   111\\\\t}\\\\n   112\\\\t\\\\n   113\\\\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\\\\n   114\\\\t// call → recorded args; result → deterministic truncation; text/thinking/note → raw, no form\\\\n   115\\\\t// to fall back from and therefore never a gap.\\\\n   116\\\\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\\\\n   117\\\\t  user_prompt: { form: \\\\\\\"smoothed_prompt\\\\\\\", fallbackText: promptFallbackText },\\\\n   118\\\\t  assistant_text: { fallbackText: textOf },\\\\n   119\\\\t  assistant_thinking: { fallbackText: textOf },\\\\n   120\\\\t  runtime_note: { fallbackText: textOf },\\\\n   121\\\\t  tool_call: {\\\\n   122\\\\t    fallbackText: (message) => {\\\\n   123\\\\t      const block = message.blocks[0]?.content ?? {};\\\\n   124\\\\t      const toolName = typeof block[\\\\\\\"toolName\\\\\\\"] === \\\\\\\"string\\\\\\\" ? block[\\\\\\\"toolName\\\\\\\"] : \\\\\\\"unknown_tool\\\\\\\";\\\\n   125\\\\t      return `${toolName}(${JSON.stringify(block[\\\\\\\"arguments\\\\\\\"] ?? {})})`;\\\\n   126\\\\t    },\\\\n   127\\\\t  },\\\\n   128\\\\t  tool_result: {\\\\n   129\\\\t    form: \\\\\\\"tool_result_summary\\\\\\\",\\\\n   130\\\\t    fallbackText: (message) => {\\\\n   131\\\\t      const block = message.blocks[0]?.content ?? {};\\\\n   132\\\\t      return truncateForFallback(typeof block[\\\\\\\"content\\\\\\\"] === \\\\\\\"string\\\\\\\" ? block[\\\\\\\"content\\\\\\\"] : \\\\\\\"\\\\\\\");\\\\n   133\\\\t    },\\\\n   134\\\\t  },\\\\n   135\\\\t};\\\\n   136\\\\t\\\\n   137\\\\t// One per-message atom before grouping: its composed part plus the structural\\\\n   138\\\\t// facts the run-grouping reads. Tool atoms fold into runs; prompts and\\\\n   139\\\\t// assistant text break runs; thinking and runtime notes are transparent —\\\\n   140\\\\t// interior ones fold into the surrounding run's account, edge ones stand alone.\\\\n   141\\\\tinterface ComposeAtom {\\\\n   142\\\\t  part: RenderingPart;\\\\n   143\\\\t  isTool: boolean;\\\\n   144\\\\t  isBreak: boolean; // user_prompt | assistant_text — ends a run\\\\n   145\\\\t  toolName?: string; // tool_call only\\\\n   146\\\\t  toolCallId?: string; // tool_call | tool_result\\\\n   147\\\\t}\\\\n   148\\\\t\\\\n   149\\\\tconst RUN_BREAK_KINDS: ReadonlySet<RenderingPartKind> = new Set([\\\\\\\"user_prompt\\\\\\\", \\\\\\\"assistant_text\\\\\\\"]);\\\\n   150\\\\tconst TOOL_KINDS: ReadonlySet<RenderingPartKind> = new Set([\\\\\\\"tool_call\\\\\\\", \\\\\\\"tool_result\\\\\\\"]);\\\\n   151\\\\t\\\\n   152\\\\t// One message → its composed part (ready form verbatim, else raw/truncated\\\\n   153\\\\t// fallback) plus a gap when a derivable form was not ready. Gaps stay\\\\n   154\\\\t// per-message — precise to the source record — regardless of run grouping\\\\n   155\\\\t// (AC-3.2/3.3): the caller lands them on the rendering and they hold until an\\\\n   156\\\\t// explicit rebuild recomposes from current states.\\\\n   157\\\\tfunction buildAtom(\\\\n   158\\\\t  message: ComposeMessage,\\\\n   159\\\\t  forms: ReadonlyMap<string, ComposeFormRow>,\\\\n   160\\\\t  resultByCallId: Map<string, boolean>,\\\\n   161\\\\t): { atom: ComposeAtom; gap?: DependencyGap; recovery?: RecoveryReceipt } {\\\\n   162\\\\t  const plan = PART_PLANS[message.kind];\\\\n   163\\\\t  const form =\\\\n   164\\\\t    plan.form === undefined\\\\n   165\\\\t      ? undefined\\\\n   166\\\\t      : forms.get(composeFormKey(message.messageId, plan.form));\\\\n   167\\\\t  const ready = form !== undefined && form.state === \\\\\\\"ready\\\\\\\" && form.content !== undefined;\\\\n   168\\\\t  const block = message.blocks[0]?.content ?? {};\\\\n   169\\\\t  const part: RenderingPart = {\\\\n   170\\\\t    messageId: message.messageId,\\\\n   171\\\\t    kind: message.kind,\\\\n   172\\\\t    text: ready ? (form.content as string) : plan.fallbackText(message),\\\\n   173\\\\t    fallback: plan.form !== undefined && !ready,\\\\n   174\\\\t  };\\\\n   175\\\\t  if (message.kind === \\\\\\\"tool_call\\\\\\\") {\\\\n   176\\\\t    part.outcome =\\\\n   177\\\\t      ready && form.metadata?.outcome !== undefined\\\\n   178\\\\t        ? form.metadata.outcome\\\\n   179\\\\t        : outcomeFromRecord(resultByCallId, block[\\\\\\\"toolCallId\\\\\\\"]);\\\\n   180\\\\t  } else if (message.kind === \\\\\\\"tool_result\\\\\\\") {\\\\n   181\\\\t    part.outcome =\\\\n   182\\\\t      ready && form.metadata?.outcome !== undefined\\\\n   183\\\\t        ? form.metadata.outcome\\\\n   184\\\\t        : block[\\\\\\\"isError\\\\\\\"] === true\\\\n   185\\\\t          ? \\\\\\\"failed\\\\\\\"\\\\n   186\\\\t          : \\\\\\\"succeeded\\\\\\\";\\\\n   187\\\\t  }\\\\n   188\\\\t  const atom: ComposeAtom = {\\\\n   189\\\\t    part,\\\\n   190\\\\t    isTool: TOOL_KINDS.has(message.kind),\\\\n   191\\\\t    isBreak: RUN_BREAK_KINDS.has(message.kind),\\\\n   192\\\\t  };\\\\n   193\\\\t  if (message.kind === \\\\\\\"tool_call\\\\\\\" && typeof block[\\\\\\\"toolName\\\\\\\"] === \\\\\\\"string\\\\\\\") {\\\\n   194\\\\t    atom.toolName = block[\\\\\\\"toolName\\\\\\\"];\\\\n   195\\\\t  }\\\\n   196\\\\t  if (atom.isTool && typeof block[\\\\\\\"toolCallId\\\\\\\"] === \\\\\\\"string\\\\\\\") {\\\\n   197\\\\t    atom.toolCallId = block[\\\\\\\"toolCallId\\\\\\\"];\\\\n   198\\\\t  }\\\\n   199\\\\t  const gap: DependencyGap | undefined =\\\\n   200\\\\t    part.fallback && plan.form !== undefined\\\\n   201\\\\t      ? { subjectKind: \\\\\\\"message\\\\\\\", subjectId: message.messageId, derivationType: plan.form }\\\\n   202\\\\t      : undefined;\\\\n   203\\\\t  const recovery: RecoveryReceipt | undefined =\\\\n   204\\\\t    part.fallback && plan.form !== undefined && form !== undefined\\\\n   205\\\\t      ? {\\\\n   206\\\\t          subjectKind: \\\\\\\"message\\\\\\\",\\\\n   207\\\\t          subjectId: message.messageId,\\\\n   208\\\\t          derivationType: plan.form,\\\\n   209\\\\t          content: part.text,\\\\n   210\\\\t          sourceVersion: form.sourceVersion,\\\\n   211\\\\t          reason: form.state === \\\\\\\"failed\\\\\\\" ? \\\\\\\"failed_floor\\\\\\\" : \\\\\\\"not_ready\\\\\\\",\\\\n   212\\\\t          floorUsed: part.text,\\\\n   213\\\\t        }\\\\n   214\\\\t      : undefined;\\\\n   215\\\\t  return { atom, ...(gap === undefined ? {} : { gap }), ...(recovery === undefined ? {} : { recovery }) };\\\\n   216\\\\t}\\\\n   217\\\\t\\\\n   218\\\\tconst RUN_OUTCOME_ORDER: readonly ToolOutcome[] = [\\\\\\\"succeeded\\\\\\\", \\\\\\\"failed\\\\\\\", \\\\\\\"unknown\\\\\\\"];\\\\n   219\\\\t\\\\n   220\\\\t// The run's per-invocation outcome tally: each call counted once, plus any\\\\n   221\\\\t// result whose paired call sits outside this run (a cross-turn pair). Mixed\\\\n   222\\\\t// outcomes stay explicit; the run-level outcome is failed if any failed, else\\\\n   223\\\\t// unknown if any unknown, else succeeded.\\\\n   224\\\\tfunction tallyRun(members: readonly ComposeAtom[]): {\\\\n   225\\\\t  counts: Record<ToolOutcome, number>;\\\\n   226\\\\t  outcome: ToolOutcome;\\\\n   227\\\\t  callCount: number;\\\\n   228\\\\t  toolNames: string[];\\\\n   229\\\\t} {\\\\n   230\\\\t  const calls = members.filter((m) => m.part.kind === \\\\\\\"tool_call\\\\\\\");\\\\n   231\\\\t  const callIds = new Set(\\\\n   232\\\\t    calls.map((m) => m.toolCallId).filter((id): id is string => id !== undefined),\\\\n   233\\\\t  );\\\\n   234\\\\t  const orphanResults = members.filter(\\\\n   235\\\\t    (m) =>\\\\n   236\\\\t      m.part.kind === \\\\\\\"tool_result\\\\\\\" &&\\\\n   237\\\\t      (m.toolCallId === undefined || !callIds.has(m.toolCallId)),\\\\n   238\\\\t  );\\\\n   239\\\\t  const counts: Record<ToolOutcome, number> = { succeeded: 0, failed: 0, unknown: 0 };\\\\n   240\\\\t  for (const m of [...calls, ...orphanResults]) counts[m.part.outcome ?? \\\\\\\"unknown\\\\\\\"] += 1;\\\\n   241\\\\t  const outcome: ToolOutcome =\\\\n   242\\\\t    counts.failed > 0 ? \\\\\\\"failed\\\\\\\" : counts.unknown > 0 ? \\\\\\\"unknown\\\\\\\" : \\\\\\\"succeeded\\\\\\\";\\\\n   243\\\\t  const toolNames: string[] = [];\\\\n   244\\\\t  for (const call of calls) {\\\\n   245\\\\t    if (call.toolName !== undefined && !toolNames.includes(call.toolName)) {\\\\n   246\\\\t      toolNames.push(call.toolName);\\\\n   247\\\\t    }\\\\n   248\\\\t  }\\\\n   249\\\\t  return { counts, outcome, callCount: calls.length, toolNames };\\\\n   250\\\\t}\\\\n   251\\\\t\\\\n   252\\\\tfunction runTallyText(counts: Record<ToolOutcome, number>): string {\\\\n   253\\\\t  const segs = RUN_OUTCOME_ORDER.filter((o) => counts[o] > 0).map((o) => `${counts[o]} ${o}`);\\\\n   254\\\\t  return segs.length > 0 ? segs.join(\\\\\\\", \\\\\\\") : \\\\\\\"no outcomes\\\\\\\";\\\\n   255\\\\t}\\\\n   256\\\\t\\\\n   257\\\\t// One RenderingPart and one ToolRunReceipt for a maximal tool run (AC-3.4): a\\\\n   258\\\\t// run-level header (tools, call count, outcome tally) over the members'\\\\n   259\\\\t// composed accounts in record order — each tool member stating its own\\\\n   260\\\\t// outcome so a state-changing call cannot lose it, interior thinking/notes\\\\n   261\\\\t// riding inline. The receipt restates the same account + run outcome for the\\\\n   262\\\\t// chunk summaries (AC-3.8).\\\\n   263\\\\tfunction composeRun(members: readonly ComposeAtom[]): {\\\\n   264\\\\t  part: RenderingPart;\\\\n   265\\\\t  receipt: ToolRunReceipt;\\\\n   266\\\\t} {\\\\n   267\\\\t  const { counts, outcome, callCount, toolNames } = tallyRun(members);\\\\n   268\\\\t  const tools = toolNames.length > 0 ? toolNames.join(\\\\\\\", \\\\\\\") : \\\\\\\"tools\\\\\\\";\\\\n   269\\\\t  const header = `tool run · ${tools} · ${callCount} call${callCount === 1 ? \\\\\\\"\\\\\\\" : \\\\\\\"s\\\\\\\"} · ${runTallyText(counts)}`;\\\\n   270\\\\t  const detail = members\\\\n   271\\\\t    .map((m) => (m.isTool ? `${m.part.text} ⇒ ${m.part.outcome ?? \\\\\\\"unknown\\\\\\\"}` : m.part.text))\\\\n   272\\\\t    .join(\\\\\\\"\\\\\\\\n\\\\\\\");\\\\n   273\\\\t  const text = `[${header}]\\\\\\\\n${detail}`;\\\\n   274\\\\t  const lead = members[0];\\\\n   275\\\\t  if (lead === undefined) throw new Error(\\\\\\\"composeRun: a tool run has no members\\\\\\\");\\\\n   276\\\\t  return {\\\\n   277\\\\t    part: {\\\\n   278\\\\t      messageId: lead.part.messageId,\\\\n   279\\\\t      kind: lead.part.kind,\\\\n   280\\\\t      text,\\\\n   281\\\\t      fallback: members.some((m) => m.isTool && m.part.fallback),\\\\n   282\\\\t      outcome,\\\\n   283\\\\t    },\\\\n   284\\\\t    receipt: {\\\\n   285\\\\t      messageId: lead.part.messageId,\\\\n   286\\\\t      activity: lead.part.kind === \\\\\\\"tool_result\\\\\\\" ? \\\\\\\"tool_result\\\\\\\" : \\\\\\\"tool_call\\\\\\\",\\\\n   287\\\\t      account: text,\\\\n   288\\\\t      outcome,\\\\n   289\\\\t    },\\\\n   290\\\\t  };\\\\n   291\\\\t}\\\\n   292\\\\t\\\\n   293\\\\t// Compose the ordered RenderingParts and tool-run receipts. Per-message atoms\\\\n   294\\\\t// build first (forms verbatim or fallbacks, per-message gaps); then maximal\\\\n   295\\\\t// runs of consecutive tool activity fold into one run part + one receipt each\\\\n   296\\\\t// (AC-3.4), with prompts/assistant text breaking runs and thinking/runtime\\\\n   297\\\\t// notes transparent to them.\\\\n   298\\\\texport function composeRenderingInput(\\\\n   299\\\\t  messages: readonly ComposeMessage[],\\\\n   300\\\\t  forms: ReadonlyMap<string, ComposeFormRow>,\\\\n   301\\\\t): CompositionInput {\\\\n   302\\\\t  const resultByCallId = recordOutcomes(messages);\\\\n   303\\\\t  const atoms: ComposeAtom[] = [];\\\\n   304\\\\t  const gaps: DependencyGap[] = [];\\\\n   305\\\\t  const recoveries: RecoveryReceipt[] = [];\\\\n   306\\\\t  for (const message of messages) {\\\\n   307\\\\t    const built = buildAtom(message, forms, resultByCallId);\\\\n   308\\\\t    atoms.push(built.atom);\\\\n   309\\\\t    if (built.gap !== undefined) gaps.push(built.gap);\\\\n   310\\\\t    if (built.recovery !== undefined) recoveries.push(built.recovery);\\\\n   311\\\\t  }\\\\n   312\\\\t\\\\n   313\\\\t  const parts: RenderingPart[] = [];\\\\n   314\\\\t  const receipts: ToolRunReceipt[] = [];\\\\n   315\\\\t  let i = 0;\\\\n   316\\\\t  while (i < atoms.length) {\\\\n   317\\\\t    const atom = atoms[i];\\\\n   318\\\\t    if (atom === undefined) break; // i < length keeps this unreachable\\\\n   319\\\\t    if (!atom.isTool) {\\\\n   320\\\\t      parts.push(atom.part); // prompt, assistant text, or an edge thinking/note\\\\n   321\\\\t      i += 1;\\\\n   322\\\\t      continue;\\\\n   323\\\\t    }\\\\n   324\\\\t    // A maximal run starting at this tool atom: extend over following tool\\\\n   325\\\\t    // atoms and interior transparent atoms (thinking/notes), stopping at the\\\\n   326\\\\t    // next break (prompt/assistant text) or the turn's end. Transparent atoms\\\\n   327\\\\t    // trailing the last tool atom stand alone, not folded into the run.\\\\n   328\\\\t    let j = i;\\\\n   329\\\\t    let lastToolIdx = i;\\\\n   330\\\\t    for (let next = atoms[j + 1]; next !== undefined && !next.isBreak; next = atoms[j + 1]) {\\\\n   331\\\\t      j += 1;\\\\n   332\\\\t      if (next.isTool) lastToolIdx = j;\\\\n   333\\\\t    }\\\\n   334\\\\t    const run = composeRun(atoms.slice(i, lastToolIdx + 1));\\\\n   335\\\\t    parts.push(run.part);\\\\n   336\\\\t    receipts.push(run.receipt);\\\\n   337\\\\t    for (let k = lastToolIdx + 1; k <= j; k += 1) {\\\\n   338\\\\t      const trailing = atoms[k];\\\\n   339\\\\t      if (trailing !== undefined) parts.push(trailing.part);\\\\n   340\\\\t    }\\\\n   341\\\\t    i = j + 1;\\\\n   342\\\\t  }\\\\n   343\\\\t\\\\n   344\\\\t  return { parts, gaps, receipts, recoveries };\\\\n   345\\\\t}\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/streams/006-verify.stdout.log:18:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_7\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba docs/specs/01-lhc-sdk/06-derivation-recovery/tech-design.md | sed -n '113,144p' && nl -ba docs/specs/01-lhc-sdk/06-derivation-recovery/tech-design.md | sed -n '266,281p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"   113\\\\t### DD-4: The cascade write-back is a dedicated version-checked write that defers to live work\\\\n   114\\\\t\\\\n   115\\\\tThis is the corrected AC-3.8 behavior, and the review correctly flagged that reusing `complete()` is wrong: `complete()` requires a `ClaimedWorkItem` and deletes it, but consumption-time recovery has no claim, and a pending/claimed background item could later overwrite a floor-written value. So recovery write-back is its own operation, not `complete()`:\\\\n   116\\\\t\\\\n   117\\\\t`recoverDerivation(ctx, { subjectKind, subjectId, derivationType, content, sourceVersion })` runs in one short `BEGIN IMMEDIATE` and writes `state = ready, content = ?` **only if both hold**:\\\\n   118\\\\t1. the row's `sourceVersion` still matches (the stale-discard guard `complete()` already uses), and\\\\n   119\\\\t2. **no live work item is claimed or pending for that derivation** (`!hasLiveItem(...)`, the same predicate the sweep uses).\\\\n   120\\\\t\\\\n   121\\\\tIf a live item exists, recovery does **not** persist — the consumer still *renders* with the floor for this turn (no block, no hole), but it leaves the derivation alone so the in-flight worker produces the real summary. This resolves the race the review named: a floor write can never clobber work that is about to produce the genuine derivation, and a genuine completion is never clobbered by a floor. When no live item exists (the common case — a terminally `failed` or long-`pending`-abandoned derivation), recovery persists `ready` so the next consumer doesn't re-pay.\\\\n   122\\\\t\\\\n   123\\\\t**All persisted recovery outcomes land plain `ready`** — no degraded state, no floor-used marker (notes line 78/80: no upgrade process consumes such a marker). The fallback *event* goes to the log (DD-5). Tool-result floor is always `truncateForFallback`, never raw (AC-3.8/3.3).\\\\n   124\\\\t\\\\n   125\\\\tThe seam with the background worker (AC-1.7/2.8): the *worker* records honest `failed` on terminal failure; the *consumer* later resolves that `failed` to `ready` — but only when no worker is mid-flight on it. Two moments, no race.\\\\n   126\\\\t\\\\n   127\\\\t### DD-5: The log surface is a tech-util with one write method, fail-soft\\\\n   128\\\\t\\\\n   129\\\\t`tech-utils/logging/` mirrors the work-queue's capability shape: domain-blind, a `log` table (level, message, derivation_type?, subject_id?, reason?, floor_used?, recorded_at), a `writeLog(ctx, entry)` function, and a `queryLog(db, q)` helper for the actionable fields (AC-5.4). It is **exposed as a public surface** the same way every domain is: `sdk.ts` adds `export * as logging from \\\\\\\"./tech-utils/logging/index.js\\\\\\\"`, so the host calls `lhc.logging.write(...)` and `lhc.logging.query(...)` (AC-5.2) — the same functions LHC internals call. (It is a tech-util by ownership — domain-blind — but, unlike work-queue, it has a public surface because the host writes to it; that is the one externally exposed method the epic names.) The write is wrapped so a logging failure is caught and dropped, never propagated to the operation that logged (AC-5.5), and it does not share the caller's transaction (a log write must not roll back a turn). Channel rule (AC-5.3): fallback *events* go here; derivation *state* (`failed`/`blocked` + reason) stays on the derivation row.\\\\n   130\\\\t\\\\n   131\\\\t### DD-6: Background chunk recovery waits; compact recovery concats from stored members (no model)\\\\n   132\\\\t\\\\n   133\\\\tTwo consumption contexts, two behaviors (epic AC-4.8 vs AC-4.2–4.4):\\\\n   134\\\\t\\\\n   135\\\\t- **Background** (`chunks.ts` / chunk-summary handler): a chunk summary whose member `lower_band_projection` is not ready **requeues and waits** — no consumer is waiting, so deferring until the input lands is correct. Mechanically: the handler, finding a not-ready member input, returns retryable with reason **`member_projection_not_ready`** (a dependency-not-ready reason, *not* `provider_unavailable` — the review's #5: a health report must not misclassify normal dependency waiting as provider failure). The existing backoff requeues it; member source corruption returns `blocked`.\\\\n   136\\\\t- **Compact** (`turns.compactChunkMaterial`, called from `snapshot.ts`): a not-ready chunk summary resolves to a **deterministic concatenation of the chunk's stored member content** (uncompressed) — no provider call, honoring the Epic 03 \\\\\\\"compact never calls a model\\\\\\\" invariant. Compact emits a visible warning, is stoppable, and blocks only on canonical source corruption of the span (`state_corruption`, existing). Healing of the summary itself happens out-of-band: the sweep (which runs before compact) requeues transient failures, the background drain produces the real summary, and the *next* compact uses it. Compact never re-derives inline.\\\\n   137\\\\t\\\\n   138\\\\tThe difference is not a deadline-driven inline re-derivation (compact makes no model call either way) — it is *what fallback is used*: background waits for the real input; compact uses stored members now and lets the sweep/drain heal for next time.\\\\n   139\\\\t\\\\n   140\\\\t### DD-7: Turn-construction recovery never holds a transaction across a provider call; compact makes no provider call\\\\n   141\\\\t\\\\n   142\\\\tTurn-construction recovery that re-derives reuses the existing handler discipline: read inputs (short txn or none), call the provider with no open transaction, then `recoverDerivation` persists in one short `BEGIN IMMEDIATE` (DD-4). The provider call sits between two short transactions, never inside one (AC-3.7).\\\\n   143\\\\t\\\\n   144\\\\tCompact (AC-4.6) is simpler than the prior draft claimed: it makes **no provider call at all** (DD-6), so there is no across-provider-transaction concern — its chunk recovery is a pure stored-member concat. The AC-4.6 test therefore asserts the stronger property directly: a compact over not-ready summaries observes **zero provider calls**.\\\\n   266\\\\t### Cascade write-back (modified turn derivation)\\\\n   267\\\\t\\\\n   268\\\\t```\\\\n   269\\\\t{ parts, gaps, receipts } = composeRenderingInput(messages, derivations)   # existing, pure\\\\n   270\\\\tfor each gap in gaps:\\\\n   271\\\\t    writeLog(ctx, { level: \\\\\\\"warning\\\\\\\", derivationType: gap.derivationType,\\\\n   272\\\\t                    subjectId: gap.subjectId, reason, floorUsed })            # DD-5\\\\n   273\\\\t# write recovered components back ready (DD-4), deferring to live work:\\\\n   274\\\\tfor each part that fell back:\\\\n   275\\\\t    recoverDerivation(ctx, { ...part, content: flooredContent, sourceVersion })\\\\n   276\\\\t    # persists ready ONLY if version matches AND no live work item exists;\\\\n   277\\\\t    # otherwise leaves it for the in-flight worker (rendering still used the floor)\\\\n   278\\\\tpersist turn_rendering / lower_band_projection (existing)\\\\n   279\\\\t```\\\\n   280\\\\t\\\\n   281\\\\t`recoverDerivation` is a dedicated short-transaction write (DD-4), not `complete()` — it needs no claimed item, version-checks against stale source, and skips persistence when a live work item is claimed/pending so a floor write never clobbers in-flight real derivation.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-001.md:332:### Flow 4 — Chunk Derivation and Compact Recovery → `test/chunk-compact-recovery.test.ts`\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-001.md:336:| TC-4.1a | 4.1 | chunk closes | detailed + brief = two separate work items |\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-001.md:345:| TC-4.7a | 4.7 | compact falls back to concat | log entry: chunk, derivation type, reason, fallback |\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-001.md:346:| TC-4.8a | 4.8 | background chunk summary, member `lower_band_projection` `pending` | summary work requeues (waits) with reason `member_projection_not_ready` — not concat, not `failed`, not a provider-failure reason |\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-001.md:396:| 4 — chunk/compact recovery | background-wait + compact stored-member concat fallback (no model) tests red | TC-4.1a–4.8b pass |\\npackages/lhc/reference/src-green-thread-events-v1/thread-events/worker/turns.ts:1:import { applyChunkPlacement, planTurnOpenChunkPlacement } from \\\"../persistence/chunks.js\\\";\\npackages/lhc/reference/src-green-thread-events-v1/thread-events/worker/turns.ts:38:    const chunkPlan = await planTurnOpenChunkPlacement(runtime, draft.turn);\\npackages/lhc/reference/src-green-thread-events-v1/thread-events/worker/turns.ts:46:      const chunk = applyChunkPlacement(runtime, chunkPlan);\\npackages/lhc/reference/src-green-thread-events-v1/thread-events/worker/turns.ts:52:      return { turn, chunk };\\npackages/lhc/reference/src-green-thread-events-v1/thread-events/worker/turns.ts:59:      updatedChunkIds: chunkIds(persisted.chunk),\\npackages/lhc/reference/src-green-thread-events-v1/thread-events/worker/turns.ts:84:function chunkIds(chunk: CanonicalChunk | undefined): string[] {\\npackages/lhc/reference/src-green-thread-events-v1/thread-events/worker/turns.ts:85:  return chunk === undefined ? [] : [chunk.chunkId];\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-005.md:332:### Flow 4 — Chunk Derivation and Compact Recovery → `test/chunk-compact-recovery.test.ts`\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-005.md:336:| TC-4.1a | 4.1 | chunk closes | detailed + brief = two separate work items |\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-005.md:345:| TC-4.7a | 4.7 | compact falls back to concat | log entry: chunk, derivation type, reason, fallback |\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-005.md:346:| TC-4.8a | 4.8 | background chunk summary, member `lower_band_projection` `pending` | summary work requeues (waits) with reason `member_projection_not_ready` — not concat, not `failed`, not a provider-failure reason |\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/story-lead/prompts/001-planner-turn-005.md:396:| 4 — chunk/compact recovery | background-wait + compact stored-member concat fallback (no model) tests red | TC-4.1a–4.8b pass |\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/streams/004-verify.stdout.log:12:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'nl -ba docs/specs/01-lhc-sdk/06-derivation-recovery/tech-design.md'\\\",\\\"aggregated_output\\\":\\\"     1\\\\t# Epic 06: Derivation Recovery and Observability — Tech Design\\\\n     2\\\\t\\\\n     3\\\\t**Status:** Draft, complete (companion test plan: `test-plan.md`)\\\\n     4\\\\t**Epic:** `epic.md` · **Tech Arch:** `../01-tech-arch.md` · **Domain model:** `../../onboard/02-domain-design.md`\\\\n     5\\\\t**Source notes:** `../notes/derivation-cascade-decisions.md`\\\\n     6\\\\t**Consumed by:** BA/SM (story sharding), implementing agents (interface + mechanism authority).\\\\n     7\\\\t\\\\n     8\\\\t---\\\\n     9\\\\t\\\\n    10\\\\t## Context\\\\n    11\\\\t\\\\n    12\\\\tEpics 02/03/05 built and shipped the derivation pipeline: the work queue with version-checked completion and terminal failure (`tech-utils/work-queue`), the four-state derivation vocabulary (`shared/derivation.ts`), message-level handlers, turn composition (`domains/turns/internal/compose.ts`), chunk mechanics (`chunks.ts`), and the readiness sweep (`domains/thread-view/internal/sweep.ts`). All green.\\\\n    13\\\\t\\\\n    14\\\\tThis epic is a **delta over that working system**, not a new build. The recovery cascade it describes is *substantially already present*: `composeRenderingInput` already resolves each component to its ready form or a deterministic fallback and records a `DependencyGap`; `truncateForFallback` already floors tool activity; the work queue already lands `failed`/`blocked` with reasons; the sweep already does report→classify→requeue. The work here is to **complete, correct, and make observable** what exists:\\\\n    15\\\\t\\\\n    16\\\\t1. **Rename** `form`→`derivation` across code and schema (the vocabulary is now settled).\\\\n    17\\\\t2. **Add the deterministic smoothing floor + length gate** (the smoothing handler is currently single-stage inference only).\\\\n    18\\\\t3. **Split tool-result rendering** explicitly into deterministic-truncation (full band) vs inference-summary (smooth band) with tiered targets, and **remove `tool_call_summary`** (a derivation type that exists but is being dropped).\\\\n    19\\\\t4. **Make the cascade write recovered components back as `ready`** and route fallback *events* to a new **logging surface** (the gaps exist as data but are not yet logged, and recovery does not yet persist).\\\\n    20\\\\t5. **Define background vs compact chunk recovery** (requeue-and-wait vs stored-member concat fallback — compact calls no model).\\\\n    21\\\\t6. **Type runtime changes** as `model_change`/`thinking_level_change` blocks instead of flat `runtime_note`.\\\\n    22\\\\t\\\\n    23\\\\tTwo disciplines, inherited and reinforced. **No provider work inside a DB write transaction**, and **no provider work at all on the intake/serving hot paths** — turn-construction recovery that re-derives runs its provider call outside the completion transaction, exactly as the existing handlers do. **And compact calls no model at all** (Epic 03 invariant: compact assembles stored artifacts; the sweep, which runs before it, is the only thing that requeues). This epic does not change that: compact-time chunk recovery is *concat-from-stored-members only*, never an inline provider call. Healing of a not-ready chunk summary happens through the existing sweep + background drain, then the next compact picks up the healed artifact — not by compact re-deriving inline.\\\\n    24\\\\t\\\\n    25\\\\t### Mock boundary\\\\n    26\\\\t\\\\n    27\\\\tThe only external boundary is `DerivationProvider` (`shared/derivation.ts`). Tests run everything else real — real temp SQLite per the persistence/atomicity/idempotency contracts — and substitute the provider through the existing `createDeterministicProvider()` (`providers/deterministic.ts`), whose output is marked and input-derived so in-process and spawned runs are byte-identical. New recovery tests reuse it plus a **failing/slow provider double** to exercise terminal-failure and retryable paths. Nothing else is mocked.\\\\n    28\\\\t\\\\n    29\\\\t---\\\\n    30\\\\t\\\\n    31\\\\t## System View\\\\n    32\\\\t\\\\n    33\\\\t```mermaid\\\\n    34\\\\tflowchart TD\\\\n    35\\\\t  subgraph hot[Hot paths — no provider]\\\\n    36\\\\t    INTAKE[intake-stream] -->|enqueue prompt_smoothing| WQ\\\\n    37\\\\t    SERVE[thread-view pull / context hook] -->|read assembled view| VIEW[(derivation rows)]\\\\n    38\\\\t  end\\\\n    39\\\\t  subgraph workers[Off-hot-path workers]\\\\n    40\\\\t    WQ[work-queue drain] --> MH[messages handlers]\\\\n    41\\\\t    WQ --> TH[turns handlers: derive / chunks]\\\\n    42\\\\t    MH -->|smoothPrompt + deterministic floor| PROV[DerivationProvider]\\\\n    43\\\\t    TH -->|compose / project / summarize| PROV\\\\n    44\\\\t  end\\\\n    45\\\\t  subgraph recover[Consumption-time recovery]\\\\n    46\\\\t    COMPOSE[compose turn rendering] -->|ready-or-floor + write back ready| VIEW\\\\n    47\\\\t    COMPACT[smart compact] -->|ready summary or stored-member concat, no model| VIEW\\\\n    48\\\\t    COMPOSE --> LOG\\\\n    49\\\\t    COMPACT --> LOG\\\\n    50\\\\t  end\\\\n    51\\\\t  MH --> VIEW\\\\n    52\\\\t  TH --> VIEW\\\\n    53\\\\t  LOG[(log surface)]\\\\n    54\\\\t  MH -.fallback events.-> LOG\\\\n    55\\\\t```\\\\n    56\\\\t\\\\n    57\\\\tThe new component is the **log surface** (a tech-util, dotted edges). Everything else is existing modules gaining behavior. Turn-construction recovery write-back (`COMPOSE`) closes the loop back into the derivation rows so a later consumer reads `ready`; compact does **not** write derivations — it assembles stored material and its not-ready summaries heal via the sweep + background drain.\\\\n    58\\\\t\\\\n    59\\\\t---\\\\n    60\\\\t\\\\n    61\\\\t## Module Boundaries\\\\n    62\\\\t\\\\n    63\\\\t| Module | Status | Owns / changes | AC |\\\\n    64\\\\t|---|---|---|---|\\\\n    65\\\\t| `shared/derivation.ts` | MODIFY | Story 0: rename `FormKind`→`DerivationType`, `DerivedForm`→`Derivation`, `DerivedFormState`→`DerivationState`, `derived_form`→`derivation` (schema). Story 2: remove `tool_call_summary` from the kind set | rename (S0), AC-2.5 (S2) |\\\\n    66\\\\t| `tech-utils/logging/` | NEW | The logging surface: levels, durable store, write + query, contained failure | AC-5.1–5.5 |\\\\n    67\\\\t| `sdk.ts` | MODIFY | `export * as logging from \\\\\\\"./tech-utils/logging/index.js\\\\\\\"` — host-visible `lhc.logging.write` / `lhc.logging.query` | AC-5.2 |\\\\n    68\\\\t| `tech-utils/work-queue/index.ts` | MODIFY | Drop `tool_call_summary` from `WorkKind`/registry/`LEGACY_KIND_FORMS`; no mechanics change | AC-2.5 |\\\\n    69\\\\t| `domains/messages/internal/handlers.ts` | MODIFY | Smoothing: deterministic floor + length gate; remove `toolCallSummaryHandler`; terminal-failure lands `failed` (existing) | AC-1.1–1.7, AC-2.8 |\\\\n    70\\\\t| `domains/messages/internal/smoothing.ts` | NEW | Pure deterministic cleaning function (whitespace, trivial casing) | AC-1.1 |\\\\n    71\\\\t| `domains/turns/internal/compose.ts` | MODIFY | Remove `tool_call_summary` from `PART_PLANS`; cascade write-back; emit fallback log events | AC-2.5, AC-3.1–3.8 |\\\\n    72\\\\t| `domains/turns/internal/derive.ts` | MODIFY | After compose, write recovered components back `ready`; log fallbacks | AC-3.6, AC-3.8 |\\\\n    73\\\\t| `domains/turns/internal/chunks.ts` | MODIFY | Background chunk-summary requeue-and-wait on not-ready member input (reason `member_projection_not_ready`) | AC-4.1, AC-4.8 |\\\\n    74\\\\t| `domains/turns/index.ts` | MODIFY | New surface op `compactChunkMaterial(...)` returning ready summary or deterministic member-concat (no provider call); thread-view calls this, never `turns/internal/*` | AC-4.2–4.4, AC-4.7 |\\\\n    75\\\\t| `domains/turns/internal/chunk-recovery.ts` | NEW | Pure: assemble a chunk's band entry from stored member content when its summary is not ready (concat, no model) | AC-4.2–4.4, AC-4.7 |\\\\n    76\\\\t| `domains/thread-view/internal/snapshot.ts` (compact) | MODIFY | Call the turns surface op for not-ready summaries; surface warnings; block only on source corruption. No provider call, no `turns/internal/*` import | AC-4.3–4.5 |\\\\n    77\\\\t| `domains/intake-stream/index.ts` (`MessageEventInput`) + `internal/validate.ts` | MODIFY | Add `model_change`/`thinking_level_change` to the public event union and validation | AC-6.1–6.3 |\\\\n    78\\\\t| `domains/messages/internal/project.ts` | MODIFY | Project `model_change`/`thinking_level_change` events into typed blocks | AC-6.1–6.3 |\\\\n    79\\\\t| `providers/deterministic.ts` | MODIFY | Drop `summarizeToolCall` op (follows `tool_call_summary` removal) | AC-2.5 |\\\\n    80\\\\t\\\\n    81\\\\t**Must-not-own:** the log surface is a tech-util — it knows levels and rows, never what a derivation *means*; it never reads or writes `derivation` rows. Thread-view still derives nothing and calls **no provider**: compact's not-ready summaries resolve through the `turns.compactChunkMaterial` surface op (stored-concat, no model), and thread-view must not import `domains/turns/internal/*` (boundary-risk test). The cascade's recovery write-back is a dedicated version-checked write (DD-4), not a reuse of `complete()`.\\\\n    82\\\\t\\\\n    83\\\\t---\\\\n    84\\\\t\\\\n    85\\\\t## Design Decisions\\\\n    86\\\\t\\\\n    87\\\\t### DD-1: The rename is mechanical and total; persisted identifiers change once\\\\n    88\\\\t\\\\n    89\\\\t`form`→`derivation` touches types (`FormKind`→`DerivationType`, `DerivedForm`→`Derivation`, `DerivedFormState`→`DerivationState`, `DerivedFormMetadata`→`DerivationMetadata`, `FormReportEntry`→`DerivationReportEntry`, `HandlerFormWrite`→`HandlerDerivationWrite`), the `derived_form` table → `derivation`, the column `form` → `derivation_type`, and every reference. This is a migration (v7): the table/column rename runs in `shared/storage.ts` migration. The existing suite is the rename's safety net — behavior is unchanged, so green-after-rename is the gate (Story 0). The rename keeps `tool_call_summary` *in* the kind set (just renamed `DerivationType`); its **removal is Story 2's** (AC-2.5), where it is dropped from the kind set, the work-queue registry, `LEGACY_KIND_FORMS`, `PART_PLANS`, the provider interface, and the deterministic provider. Splitting it this way keeps Story 0 behavior-preserving and gives the removal its own red/green in its owning story.\\\\n    90\\\\t\\\\n    91\\\\t### DD-2: Deterministic smoothing is a pure function, run in the handler before inference\\\\n    92\\\\t\\\\n    93\\\\tThe smoothing handler gains a deterministic stage. `cleanPrompt(text): string` in `domains/messages/internal/smoothing.ts` is pure (no DB, no model, no clock): whitespace normalization and trivial casing only — never typo correction (that needs the model). The handler:\\\\n    94\\\\t\\\\n    95\\\\t1. Reads the prompt text (existing `loadSource`).\\\\n    96\\\\t2. Computes `cleaned = cleanPrompt(text)`.\\\\n    97\\\\t3. If `tokenCount(cleaned) > config smoothing cap`: land `cleaned` as the `ready` content, no provider call.\\\\n    98\\\\t4. Else: call `provider.smoothPrompt({ text: cleaned })`; on success land its text; on retryable failure return retryable (existing); on terminal failure land `failed` (existing `failTerminal`).\\\\n    99\\\\t\\\\n   100\\\\tThe deterministic result is the **floor** the cascade reuses (DD-5) and the over-cap output. There is no second field and no \\\\\\\"skipped\\\\\\\" state — over-cap and full both land `ready` (AC-1.4). The cap is `config.smoothing.maxInferenceTokens` (default named in the test plan; a dial-in value).\\\\n   101\\\\t\\\\n   102\\\\tFenced code: a line in the `smoothing-v1` prompt instructs \\\\\\\"leave fenced code blocks and inline literals verbatim.\\\\\\\" No segmentation, no regex protection (AC-1.3). Verified by a fenced-code test against the deterministic provider's passthrough plus a real-inference test in the next epic.\\\\n   103\\\\t\\\\n   104\\\\t### DD-3: Tool-result rendering — the split already half-exists; this names the tiers and the state\\\\n   105\\\\t\\\\n   106\\\\tFull-band truncation is `truncateForFallback` (already in `compose.ts`, limit 200) reached through the visibility boundary (Epic 03) — no change to the truncation mechanism (AC-2.1). Smooth-band summary is `tool_result_summary` via `summarizeToolResult` (exists). New: the **tier gate** decides per result, by token count, whether a `tool_result_summary` inference item is created at all:\\\\n   107\\\\t\\\\n   108\\\\t- `> largeTierTokens` (≈5000): no inference item; the derivation is satisfied by truncation and lands `ready` directly (AC-2.7). The enqueue path checks the source size and, over the threshold, writes the truncation as the `ready` content instead of queuing inference.\\\\n   109\\\\t- `≤ largeTierTokens`: inference item as today, with the tier's target compression in the prompt.\\\\n   110\\\\t\\\\n   111\\\\tTiers are config (`config.toolResult.tiers`), first-pass values in the test plan, tunable next epic. Per-tool guidance is a keyed lookup the `tool-result-v1` prompt consults; the keys and text are first-pass scaffolding here.\\\\n   112\\\\t\\\\n   113\\\\t### DD-4: The cascade write-back is a dedicated version-checked write that defers to live work\\\\n   114\\\\t\\\\n   115\\\\tThis is the corrected AC-3.8 behavior, and the review correctly flagged that reusing `complete()` is wrong: `complete()` requires a `ClaimedWorkItem` and deletes it, but consumption-time recovery has no claim, and a pending/claimed background item could later overwrite a floor-written value. So recovery write-back is its own operation, not `complete()`:\\\\n   116\\\\t\\\\n   117\\\\t`recoverDerivation(ctx, { subjectKind, subjectId, derivationType, content, sourceVersion })` runs in one short `BEGIN IMMEDIATE` and writes `state = ready, content = ?` **only if both hold**:\\\\n   118\\\\t1. the row's `sourceVersion` still matches (the stale-discard guard `complete()` already uses), and\\\\n   119\\\\t2. **no live work item is claimed or pending for that derivation** (`!hasLiveItem(...)`, the same predicate the sweep uses).\\\\n   120\\\\t\\\\n   121\\\\tIf a live item exists, recovery does **not** persist — the consumer still *renders* with the floor for this turn (no block, no hole), but it leaves the derivation alone so the in-flight worker produces the real summary. This resolves the race the review named: a floor write can never clobber work that is about to produce the genuine derivation, and a genuine completion is never clobbered by a floor. When no live item exists (the common case — a terminally `failed` or long-`pending`-abandoned derivation), recovery persists `ready` so the next consumer doesn't re-pay.\\\\n   122\\\\t\\\\n   123\\\\t**All persisted recovery outcomes land plain `ready`** — no degraded state, no floor-used marker (notes line 78/80: no upgrade process consumes such a marker). The fallback *event* goes to the log (DD-5). Tool-result floor is always `truncateForFallback`, never raw (AC-3.8/3.3).\\\\n   124\\\\t\\\\n   125\\\\tThe seam with the background worker (AC-1.7/2.8): the *worker* records honest `failed` on terminal failure; the *consumer* later resolves that `failed` to `ready` — but only when no worker is mid-flight on it. Two moments, no race.\\\\n   126\\\\t\\\\n   127\\\\t### DD-5: The log surface is a tech-util with one write method, fail-soft\\\\n   128\\\\t\\\\n   129\\\\t`tech-utils/logging/` mirrors the work-queue's capability shape: domain-blind, a `log` table (level, message, derivation_type?, subject_id?, reason?, floor_used?, recorded_at), a `writeLog(ctx, entry)` function, and a `queryLog(db, q)` helper for the actionable fields (AC-5.4). It is **exposed as a public surface** the same way every domain is: `sdk.ts` adds `export * as logging from \\\\\\\"./tech-utils/logging/index.js\\\\\\\"`, so the host calls `lhc.logging.write(...)` and `lhc.logging.query(...)` (AC-5.2) — the same functions LHC internals call. (It is a tech-util by ownership — domain-blind — but, unlike work-queue, it has a public surface because the host writes to it; that is the one externally exposed method the epic names.) The write is wrapped so a logging failure is caught and dropped, never propagated to the operation that logged (AC-5.5), and it does not share the caller's transaction (a log write must not roll back a turn). Channel rule (AC-5.3): fallback *events* go here; derivation *state* (`failed`/`blocked` + reason) stays on the derivation row.\\\\n   130\\\\t\\\\n   131\\\\t### DD-6: Background chunk recovery waits; compact recovery concats from stored members (no model)\\\\n   132\\\\t\\\\n   133\\\\tTwo consumption contexts, two behaviors (epic AC-4.8 vs AC-4.2–4.4):\\\\n   134\\\\t\\\\n   135\\\\t- **Background** (`chunks.ts` / chunk-summary handler): a chunk summary whose member `lower_band_projection` is not ready **requeues and waits** — no consumer is waiting, so deferring until the input lands is correct. Mechanically: the handler, finding a not-ready member input, returns retryable with reason **`member_projection_not_ready`** (a dependency-not-ready reason, *not* `provider_unavailable` — the review's #5: a health report must not misclassify normal dependency waiting as provider failure). The existing backoff requeues it; member source corruption returns `blocked`.\\\\n   136\\\\t- **Compact** (`turns.compactChunkMaterial`, called from `snapshot.ts`): a not-ready chunk summary resolves to a **deterministic concatenation of the chunk's stored member content** (uncompressed) — no provider call, honoring the Epic 03 \\\\\\\"compact never calls a model\\\\\\\" invariant. Compact emits a visible warning, is stoppable, and blocks only on canonical source corruption of the span (`state_corruption`, existing). Healing of the summary itself happens out-of-band: the sweep (which runs before compact) requeues transient failures, the background drain produces the real summary, and the *next* compact uses it. Compact never re-derives inline.\\\\n   137\\\\t\\\\n   138\\\\tThe difference is not a deadline-driven inline re-derivation (compact makes no model call either way) — it is *what fallback is used*: background waits for the real input; compact uses stored members now and lets the sweep/drain heal for next time.\\\\n   139\\\\t\\\\n   140\\\\t### DD-7: Turn-construction recovery never holds a transaction across a provider call; compact makes no provider call\\\\n   141\\\\t\\\\n   142\\\\tTurn-construction recovery that re-derives reuses the existing handler discipline: read inputs (short txn or none), call the provider with no open transaction, then `recoverDerivation` persists in one short `BEGIN IMMEDIATE` (DD-4). The provider call sits between two short transactions, never inside one (AC-3.7).\\\\n   143\\\\t\\\\n   144\\\\tCompact (AC-4.6) is simpler than the prior draft claimed: it makes **no provider call at all** (DD-6), so there is no across-provider-transaction concern — its chunk recovery is a pure stored-member concat. The AC-4.6 test therefore asserts the stronger property directly: a compact over not-ready summaries observes **zero provider calls**.\\\\n   145\\\\t\\\\n   146\\\\t---\\\\n   147\\\\t\\\\n   148\\\\t## Interfaces\\\\n   149\\\\t\\\\n   150\\\\t### Renamed vocabulary (`shared/derivation.ts`)\\\\n   151\\\\t\\\\n   152\\\\t```ts\\\\n   153\\\\t// was FormKind / FORM_KINDS — tool_call_summary removed\\\\n   154\\\\texport const DERIVATION_TYPES = [\\\\n   155\\\\t  \\\\\\\"smoothed_prompt\\\\\\\",\\\\n   156\\\\t  \\\\\\\"tool_result_summary\\\\\\\",\\\\n   157\\\\t  \\\\\\\"turn_rendering\\\\\\\",\\\\n   158\\\\t  \\\\\\\"lower_band_projection\\\\\\\",\\\\n   159\\\\t  \\\\\\\"chunk_summary_detailed\\\\\\\",\\\\n   160\\\\t  \\\\\\\"chunk_summary_brief\\\\\\\",\\\\n   161\\\\t] as const;\\\\n   162\\\\texport type DerivationType = (typeof DERIVATION_TYPES)[number];\\\\n   163\\\\t\\\\n   164\\\\texport type DerivationState = \\\\\\\"pending\\\\\\\" | \\\\\\\"ready\\\\\\\" | \\\\\\\"failed\\\\\\\" | \\\\\\\"blocked\\\\\\\";\\\\n   165\\\\t\\\\n   166\\\\texport interface Derivation {          // was DerivedForm\\\\n   167\\\\t  subjectKind: SubjectKind;\\\\n   168\\\\t  subjectId: string;\\\\n   169\\\\t  derivationType: DerivationType;      // was `form`\\\\n   170\\\\t  state: DerivationState;\\\\n   171\\\\t  content?: string;\\\\n   172\\\\t  reason?: string;\\\\n   173\\\\t  sourceVersion: number;\\\\n   174\\\\t  gaps?: DependencyGap[];\\\\n   175\\\\t  metadata?: DerivationMetadata;\\\\n   176\\\\t  derivedAt?: string;\\\\n   177\\\\t}\\\\n   178\\\\t```\\\\n   179\\\\t\\\\n   180\\\\t### Deterministic smoothing (`domains/messages/internal/smoothing.ts`, NEW)\\\\n   181\\\\t\\\\n   182\\\\t```ts\\\\n   183\\\\t// Pure: whitespace normalization + trivial casing only. No typo correction\\\\n   184\\\\t// (that is the model's job), no DB, no clock. The floor for AC-1.1 and the\\\\n   185\\\\t// cascade.\\\\n   186\\\\texport function cleanPrompt(text: string): string;\\\\n   187\\\\t```\\\\n   188\\\\t\\\\n   189\\\\t### Log surface (`tech-utils/logging/index.ts`, NEW)\\\\n   190\\\\t\\\\n   191\\\\t```ts\\\\n   192\\\\texport type LogLevel = \\\\\\\"info\\\\\\\" | \\\\\\\"warning\\\\\\\" | \\\\\\\"error\\\\\\\";\\\\n   193\\\\t\\\\n   194\\\\texport interface LogEntry {\\\\n   195\\\\t  level: LogLevel;\\\\n   196\\\\t  message: string;\\\\n   197\\\\t  derivationType?: DerivationType;\\\\n   198\\\\t  subjectId?: string;\\\\n   199\\\\t  reason?: string;       // e.g. \\\\\\\"not_ready\\\\\\\" | \\\\\\\"failed_floor\\\\\\\"\\\\n   200\\\\t  floorUsed?: string;    // for fallback events\\\\n   201\\\\t}\\\\n   202\\\\t\\\\n   203\\\\t// Fail-soft: never throws to the caller, never shares the caller's txn.\\\\n   204\\\\texport function writeLog(ctx: OperationContext, entry: LogEntry): void;\\\\n   205\\\\t\\\\n   206\\\\texport interface LogQuery {\\\\n   207\\\\t  level?: LogLevel;\\\\n   208\\\\t  derivationType?: DerivationType;\\\\n   209\\\\t  subjectId?: string;\\\\n   210\\\\t}\\\\n   211\\\\texport function queryLog(db: DatabaseSync, q: LogQuery): StoredLogEntry[];\\\\n   212\\\\t```\\\\n   213\\\\t\\\\n   214\\\\t### Recovery write-back (`domains/turns/internal/` — NOT `complete()`)\\\\n   215\\\\t\\\\n   216\\\\t```ts\\\\n   217\\\\t// Persists a consumption-time recovered component as ready, version-checked,\\\\n   218\\\\t// and ONLY if no live work item is claimed/pending for that derivation\\\\n   219\\\\t// (DD-4). No ClaimedWorkItem required. Returns whether it persisted.\\\\n   220\\\\texport function recoverDerivation(ctx: OperationContext, r: {\\\\n   221\\\\t  subjectKind: SubjectKind; subjectId: string;\\\\n   222\\\\t  derivationType: DerivationType; content: string; sourceVersion: number;\\\\n   223\\\\t}): { persisted: boolean };   // false when a live item exists (left for the worker)\\\\n   224\\\\t```\\\\n   225\\\\t\\\\n   226\\\\t### Compact chunk material (`domains/turns/index.ts` surface op — no provider)\\\\n   227\\\\t\\\\n   228\\\\t```ts\\\\n   229\\\\t// Returns the ready chunk summary if present, else a deterministic\\\\n   230\\\\t// concatenation of the chunk's stored member content. NEVER calls a provider\\\\n   231\\\\t// (Epic 03 compact-no-model invariant). thread-view calls THIS, not internals.\\\\n   232\\\\texport function compactChunkMaterial(ctx: OperationContext, chunkId: string):\\\\n   233\\\\t  | { kind: \\\\\\\"ready\\\\\\\"; content: string }\\\\n   234\\\\t  | { kind: \\\\\\\"concat\\\\\\\"; content: string; reason: string }   // fallback used; caller warns + logs\\\\n   235\\\\t  | { kind: \\\\\\\"blocked\\\\\\\"; reason: string };                  // member source corruption\\\\n   236\\\\t```\\\\n   237\\\\t\\\\n   238\\\\t### Typed runtime-change blocks\\\\n   239\\\\t\\\\n   240\\\\tAdded to the public event union (`domains/intake-stream/index.ts`) and validated in `internal/validate.ts`; projected to typed blocks in `domains/messages/internal/project.ts`.\\\\n   241\\\\t\\\\n   242\\\\t```ts\\\\n   243\\\\t// public MessageEventInput gains:\\\\n   244\\\\t//   | BaseEvent<\\\\\\\"model_change\\\\\\\", { previousModel: string; newModel: string }>\\\\n   245\\\\t//   | BaseEvent<\\\\\\\"thinking_level_change\\\\\\\", { previousLevel: string; newLevel: string }>\\\\n   246\\\\t// projected message block content:\\\\n   247\\\\tinterface ModelChangeBlock { blockType: \\\\\\\"model_change\\\\\\\"; previousModel: string; newModel: string; }\\\\n   248\\\\tinterface ThinkingLevelChangeBlock { blockType: \\\\\\\"thinking_level_change\\\\\\\"; previousLevel: string; newLevel: string; }\\\\n   249\\\\t```\\\\n   250\\\\t\\\\n   251\\\\t---\\\\n   252\\\\t\\\\n   253\\\\t## Mechanics\\\\n   254\\\\t\\\\n   255\\\\t### Smoothing handler (modified `smoothPromptHandler`)\\\\n   256\\\\t\\\\n   257\\\\t```\\\\n   258\\\\tload prompt text (existing)\\\\n   259\\\\tcleaned = cleanPrompt(text)\\\\n   260\\\\tif tokenCount(cleaned) > config.smoothing.maxInferenceTokens:\\\\n   261\\\\t    return ok, forms:[{ smoothed_prompt, content: cleaned }]   # over-cap → ready, no provider\\\\n   262\\\\tresult = await provider.smoothPrompt({ text: cleaned })        # provider call, no open txn\\\\n   263\\\\treturn landForm(smoothed_prompt, result)                        # existing: retryable / failed / ready\\\\n   264\\\\t```\\\\n   265\\\\t\\\\n   266\\\\t### Cascade write-back (modified turn derivation)\\\\n   267\\\\t\\\\n   268\\\\t```\\\\n   269\\\\t{ parts, gaps, receipts } = composeRenderingInput(messages, derivations)   # existing, pure\\\\n   270\\\\tfor each gap in gaps:\\\\n   271\\\\t    writeLog(ctx, { level: \\\\\\\"warning\\\\\\\", derivationType: gap.derivationType,\\\\n   272\\\\t                    subjectId: gap.subjectId, reason, floorUsed })            # DD-5\\\\n   273\\\\t# write recovered components back ready (DD-4), deferring to live work:\\\\n   274\\\\tfor each part that fell back:\\\\n   275\\\\t    recoverDerivation(ctx, { ...part, content: flooredContent, sourceVersion })\\\\n   276\\\\t    # persists ready ONLY if version matches AND no live work item exists;\\\\n   277\\\\t    # otherwise leaves it for the in-flight worker (rendering still used the floor)\\\\n   278\\\\tpersist turn_rendering / lower_band_projection (existing)\\\\n   279\\\\t```\\\\n   280\\\\t\\\\n   281\\\\t`recoverDerivation` is a dedicated short-transaction write (DD-4), not `complete()` — it needs no claimed item, version-checks against stale source, and skips persistence when a live work item is claimed/pending so a floor write never clobbers in-flight real derivation.\\\\n   282\\\\t\\\\n   283\\\\t### Compact chunk material (`turns.compactChunkMaterial`, called from `snapshot.ts`) — no provider\\\\n   284\\\\t\\\\n   285\\\\t```\\\\n   286\\\\tfor each chunk summary needed by the band plan:\\\\n   287\\\\t    m = turns.compactChunkMaterial(ctx, chunkId)              # surface op, NO provider call\\\\n   288\\\\t    case m.kind:\\\\n   289\\\\t      \\\\\\\"ready\\\\\\\":   use m.content\\\\n   290\\\\t      \\\\\\\"concat\\\\\\\":  use m.content (stored member concat, AC-4.3)\\\\n   291\\\\t                 warn (visible channel, AC-4.4); writeLog(error, ...) (AC-4.7)\\\\n   292\\\\t      \\\\\\\"blocked\\\\\\\": return state_corruption                      # AC-4.5 — only source corruption blocks\\\\n   293\\\\t```\\\\n   294\\\\t\\\\n   295\\\\tCompact makes zero provider calls (DD-6). A not-ready summary becomes a stored-member concat now; the summary itself heals via the pre-compact sweep + background drain, and the next compact uses the healed artifact.\\\\n   296\\\\t\\\\n   297\\\\t---\\\\n   298\\\\t\\\\n   299\\\\t## Architecture-Risk Tests\\\\n   300\\\\t\\\\n   301\\\\tPer the skill's checklist, this epic touches the high-risk areas; the test plan names these explicitly:\\\\n   302\\\\t\\\\n   303\\\\t- **Source-truth vs derived:** full tool result preserved while truncated/summarized (AC-2.6); recovery never mutates canonical source.\\\\n   304\\\\t- **Atomicity/rollback:** `recoverDerivation` is version-checked and skips when a live work item exists, so a floor write never clobbers in-flight real derivation (DD-4); log write never rolls back a turn (DD-5).\\\\n   305\\\\t- **Concurrency:** the named race — background work claimed/pending while a consumer floors — is handled by `recoverDerivation`'s `!hasLiveItem` guard; the test seeds a claimed item and asserts the floor does not overwrite and the worker still wins.\\\\n   306\\\\t- **Idempotency/retry:** background chunk requeue-and-wait does not duplicate work (existing `hasLiveItem`/version scoping); the wait reason is `member_projection_not_ready`, not a provider-failure reason, so health classification stays correct.\\\\n   307\\\\t- **Threshold/sizing:** tool-result tier gate boundary (AC-2.3/2.7); smoothing length cap boundary (AC-1.2).\\\\n   308\\\\t- **Migration/compatibility:** the v7 rename migration; existing suite green post-rename; `tool_call_summary` removal has its own coverage.\\\\n   309\\\\t- **No-provider discipline:** turn recovery's provider call sits outside the write transaction, proven by a competing-write probe during the call (AC-3.7); compact makes zero provider calls, proven by a provider spy over a not-ready-summary compact (AC-4.6).\\\\n   310\\\\t\\\\n   311\\\\t---\\\\n   312\\\\t\\\\n   313\\\\t## Verification Gates\\\\n   314\\\\t\\\\n   315\\\\tReuse the existing tiers (`red-verify` / `verify` / `green-verify` / `verify-all`); no new scripts. Story 0's rename is mechanically behavior-preserving — the existing suite green under the renamed vocabulary is its gate. The `tool_call_summary` removal is Story 2's (AC-2.5), a real behavior/schema change with its own red/green there. Recovery stories gate on `verify`. The provider doubles (`failingProvider`, `probingProvider`, `spyProvider`) live in `test/` fixtures alongside the existing deterministic provider.\\\\n   316\\\\t\\\\n   317\\\\t---\\\\n   318\\\\t\\\\n   319\\\\t## Tech Design Questions (resolved)\\\\n   320\\\\t\\\\n   321\\\\t1. **Turn-summarization-at-close parity:** RESOLVED by reading the code — `composeRenderingInput` is pure/deterministic and turn derivation calls `composeTurnRendering`/`projectLowerBand` as provider ops at close. So turn-construction recovery *can* call a provider; DD-7 governs the discipline (provider call between two short txns, never inside one). Compact, separately, calls no provider (DD-6).\\\\n   322\\\\t2. **Deterministic stage placement:** in the handler (DD-2), not intake. Intake stays provider-free and the floor is computed where the prompt text is already loaded.\\\\n   323\\\\t3. **Background chunk floor:** DD-6 — requeue-and-wait with reason `member_projection_not_ready` (not `provider_unavailable`), block only on member source corruption.\\\\n   324\\\\t4. **`lower_band_projection` standalone:** confirmed via `LEGACY_KIND_FORMS` and `compose`/`chunks` — it is turn-derivation's second output and the chunk-detailed input. No new work; documented in DD-6.\\\\n   325\\\\t5. **Log storage + public surface:** `log` table in the thread DB (DD-5), indexed on (level, derivation_type, subject_id); exposed as `lhc.logging.write` / `lhc.logging.query` via `sdk.ts` (`export * as logging`).\\\\n   326\\\\t6. **Compact-time recovery vs the Epic 03 \\\\\\\"compact never calls a model\\\\\\\" invariant:** RESOLVED — compact makes no provider call (DD-6). Not-ready summaries resolve to stored-member concat; healing is the sweep + drain + next compact. This preserves the upstream invariant and the cache-stability story; **no upstream doc change needed**. (An earlier draft had compact re-deriving inline — corrected.)\\\\n   327\\\\t7. **Smoothing cap value:** first-pass default in the test plan; a dial-in value (next epic).\\\\n   328\\\\t8. **Rename mechanics:** v7 migration renames table/column; types renamed across the tree (Story 0). `tool_call_summary` is renamed-but-retained in Story 0 and **removed in Story 2** (AC-2.5), so the rename stays behavior-preserving and the removal gets its own coverage (DD-1).\\\\n   329\\\\t\\\\n   330\\\\t---\\\\n   331\\\\t\\\\n   332\\\\t## Work Breakdown (chunks)\\\\n   333\\\\t\\\\n   334\\\\t| Chunk | Story | Phases |\\\\n   335\\\\t|---|---|---|\\\\n   336\\\\t| 0 | Foundation: v7 rename migration + `tech-utils/logging` (rename retains `tool_call_summary`; its removal is Story 2) | Red (rename compiles; log surface skeleton) → Green (suite passes under renamed vocabulary; log tests pass). Rename is mechanically behavior-preserving. |\\\\n   337\\\\t| 1 | Smoothing floor + length gate | Red → Green |\\\\n   338\\\\t| 2 | Tool-result tiers + `tool_call_summary` removal | Red → Green |\\\\n   339\\\\t| 3 | Cascade write-back + fallback logging | Red → Green |\\\\n   340\\\\t| 4 | Chunk background-wait + compact stored-member concat fallback (no model) | Red → Green |\\\\n   341\\\\t| 5 | Runtime-change typing | Red → Green |\\\\n   342\\\\t\\\\n   343\\\\tDetailed TC→test mapping and per-chunk Red/Green exit criteria are in `test-plan.md`.\\\\n   344\\\\t\\\\n   345\\\\t---\\\\n   346\\\\t\\\\n   347\\\\t## Deferred / Out of Scope\\\\n   348\\\\t\\\\n   349\\\\t- Prompt/model/tier **tuning** against real corpora (next epic).\\\\n   350\\\\t- pi-lhc consumption of typed runtime blocks for session restoration.\\\\n   351\\\\t- Host buffer-surfacing UX.\\\\n   352\\\\t- The \\\\\\\"subsequent passes\\\\\\\" set (wire-API band representation, smooth-band message pairs, post-compact cost).\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/streams/004-verify.stdout.log:14:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'nl -ba docs/specs/01-lhc-sdk/06-derivation-recovery/test-plan.md'\\\",\\\"aggregated_output\\\":\\\"     1\\\\t# Epic 06: Derivation Recovery and Observability — Test Plan\\\\n     2\\\\t\\\\n     3\\\\t**Companion to:** `tech-design.md` · **Epic:** `epic.md`\\\\n     4\\\\t**Counts:** 39 ACs / 59 TCs across 6 flows, mapped to test files below.\\\\n     5\\\\t\\\\n     6\\\\t## Testing Architecture\\\\n     7\\\\t\\\\n     8\\\\t- **Real storage.** Every test uses a real temp SQLite thread DB (the persistence/atomicity/idempotency contracts are the point — never mock the store).\\\\n     9\\\\t- **One mock boundary.** `DerivationProvider`, via the existing `createDeterministicProvider()` for happy paths and two new doubles for failure paths:\\\\n    10\\\\t  - `failingProvider(opts)` — returns `{ ok:false, retryable }` for a named op, to drive retryable and terminal-failure paths.\\\\n    11\\\\t  - `probingProvider(fn)` — while its call is pending, runs `fn` which attempts a competing SQLite write (`BEGIN IMMEDIATE` on the same thread DB) and records whether it acquired the lock. Used to prove no write transaction is held across a provider call (stronger than a bare delay).\\\\n    12\\\\t  - `spyProvider()` — records every call; used to assert **zero** provider calls in compact paths.\\\\n    13\\\\t- **Verification tiers** are the existing `red-verify` / `verify` / `green-verify` / `verify-all`; no new scripts.\\\\n    14\\\\t- **First-pass config defaults** used by tests (dial-in values, not architecture):\\\\n    15\\\\t  - `smoothing.maxInferenceTokens = 4000`\\\\n    16\\\\t  - `toolResult.tiers = { small: 1000 → 0.10–0.20, mid: 5000 → 0.02–0.05, large: >5000 → truncate }`\\\\n    17\\\\t\\\\n    18\\\\t## Config defaults under test\\\\n    19\\\\t\\\\n    20\\\\t| Setting | First-pass value | Tuned in |\\\\n    21\\\\t|---|---|---|\\\\n    22\\\\t| smoothing length cap | 4000 tokens | next epic |\\\\n    23\\\\t| tool-result large-tier threshold | 5000 tokens | next epic |\\\\n    24\\\\t| tool-result tier targets | 10–20% / 2–5% / truncate | next epic |\\\\n    25\\\\t\\\\n    26\\\\t---\\\\n    27\\\\t\\\\n    28\\\\t## TC → Test Mapping\\\\n    29\\\\t\\\\n    30\\\\t### Flow 1 — Prompt Smoothing → `test/smoothing-recovery.test.ts`\\\\n    31\\\\t\\\\n    32\\\\t| TC | AC | Setup | Assertion |\\\\n    33\\\\t|---|---|---|---|\\\\n    34\\\\t| TC-1.1a | 1.1 | prompt with irregular whitespace, deterministic provider spy | cleaned whitespace; provider not called for the deterministic stage |\\\\n    35\\\\t| TC-1.1b | 1.1 | over-cap prompt | deterministic cleaning still applied |\\\\n    36\\\\t| TC-1.2a | 1.2 | under-cap prompt | `smoothPrompt` invoked; its output stored |\\\\n    37\\\\t| TC-1.2b | 1.2 | over-cap prompt, provider spy | `smoothPrompt` NOT invoked; deterministic result stored |\\\\n    38\\\\t| TC-1.3a | 1.3 | prompt with fenced code + typo-laden prose, real-ish passthrough | fenced block byte-identical; prose changed |\\\\n    39\\\\t| TC-1.4a | 1.4 | over-cap prompt | derivation state `ready` (not \\\\\\\"skipped\\\\\\\"/\\\\\\\"degraded\\\\\\\") |\\\\n    40\\\\t| TC-1.4b | 1.4 | under-cap, inference ok | state `ready` |\\\\n    41\\\\t| TC-1.5a | 1.5 | `failingProvider({ smoothPrompt: retryable })` | state `pending`, item requeued |\\\\n    42\\\\t| TC-1.5b | 1.5 | smoothing `pending`, consume via compose | deterministic floor used, no block |\\\\n    43\\\\t| TC-1.6a | 1.6 | intake a prompt, provider spy | no provider call during intake; smoothing item queued |\\\\n    44\\\\t| TC-1.7a | 1.7 | `failingProvider` exhausts budget | state `failed` with reason; not `ready` |\\\\n    45\\\\t| TC-1.7b | 1.7 | `failed` smoothing, consume via compose | deterministic floor used via cascade |\\\\n    46\\\\t\\\\n    47\\\\t### Flow 2 — Tool-Result Rendering → `test/tool-result-rendering.test.ts`\\\\n    48\\\\t\\\\n    49\\\\t| TC | AC | Setup | Assertion |\\\\n    50\\\\t|---|---|---|---|\\\\n    51\\\\t| TC-2.1a | 2.1 | large tool result past visibility boundary | deterministic truncation, no provider call, identical input → identical output |\\\\n    52\\\\t| TC-2.2a | 2.2 | tool result in smooth-band turn | summary produced by queued inference item, not hot path |\\\\n    53\\\\t| TC-2.3a | 2.3 | result < 1000 tokens | small-tier target applied |\\\\n    54\\\\t| TC-2.3b | 2.3 | result 1000–5000 tokens | mid-tier target applied |\\\\n    55\\\\t| TC-2.3c | 2.3 | result > 5000 tokens | truncated, not inference-summarized |\\\\n    56\\\\t| TC-2.4a | 2.4 | results from two tools | per-tool guidance keyed in prompt; outcome preserved both |\\\\n    57\\\\t| TC-2.4b | 2.4 | failed tool result | summary states failure outcome |\\\\n    58\\\\t| TC-2.5a | 2.5 | turn with a tool call | no `tool_call_summary` derivation exists or is queued |\\\\n    59\\\\t| TC-2.5b | 2.5 | tool call in rendered turn | call args present as recorded, no summary step |\\\\n    60\\\\t| TC-2.6a | 2.6 | result truncated (full band) + summarized (smooth) | original full result intact in record |\\\\n    61\\\\t| TC-2.7a | 2.7 | result > 5000 tokens | `tool_result_summary` is the truncation, state `ready`, no inference item created |\\\\n    62\\\\t| TC-2.8a | 2.8 | in-threshold result, `failingProvider` exhausts | state `failed` with reason; truncation floor used by consumers |\\\\n    63\\\\t\\\\n    64\\\\t### Flow 3 — Turn Construction and Recovery Cascade → `test/turn-cascade.test.ts`\\\\n    65\\\\t\\\\n    66\\\\t| TC | AC | Setup | Assertion |\\\\n    67\\\\t|---|---|---|---|\\\\n    68\\\\t| TC-3.1a | 3.1 | turn with smoothed prompt `ready` | smoothed prompt used as-is |\\\\n    69\\\\t| TC-3.2a | 3.2 | smoothed prompt `pending`, no re-derive | deterministic-cleaned prompt used; turn constructs |\\\\n    70\\\\t| TC-3.2b | 3.2 | smoothed prompt `failed` | same cascade as pending; usable component |\\\\n    71\\\\t| TC-3.2c | 3.2 | floor unproducible | original source used |\\\\n    72\\\\t| TC-3.3a | 3.3 | `tool_result_summary` not ready | truncation used, never raw full result |\\\\n    73\\\\t| TC-3.4a | 3.4 | turn with assistant text, thinking, runtime-change block | verbatim, in order |\\\\n    74\\\\t| TC-3.5a | 3.5 | turn with multiple not-ready derivations | construction completes; every component present |\\\\n    75\\\\t| TC-3.6a | 3.6 | smoothed prompt floored | log entry: derivation type, subject id, reason, floor |\\\\n    76\\\\t| TC-3.6b | 3.6 | all derivations ready | no fallback log entries |\\\\n    77\\\\t| TC-3.7a | 3.7 | re-derivation of a not-ready component, `probingProvider` | the competing write acquires its lock while the provider call is pending → no write transaction held across the call |\\\\n    78\\\\t| TC-3.8a | 3.8 | `failed` component (no live work item) re-derived successfully | `recoverDerivation` persists; row now `ready` with re-derived content |\\\\n    79\\\\t| TC-3.8b | 3.8 | `pending` component (no live item) resolved to floor | row `ready` with floored content via `recoverDerivation`, no degraded marker, fallback logged |\\\\n    80\\\\t| TC-3.8c | 3.8 | tool-result summary unready, unrecoverable | floor written back is truncation, never raw |\\\\n    81\\\\t| TC-3.8d | 3.8 | race: `failed`/`pending` component **with a claimed work item present** (DD-4) | `recoverDerivation` returns `persisted:false`; row left untouched; the turn rendering still used the floor; a later worker completion writes the real `ready` and is not clobbered |\\\\n    82\\\\t\\\\n    83\\\\t### Flow 4 — Chunk Derivation and Compact Recovery → `test/chunk-compact-recovery.test.ts`\\\\n    84\\\\t\\\\n    85\\\\t| TC | AC | Setup | Assertion |\\\\n    86\\\\t|---|---|---|---|\\\\n    87\\\\t| TC-4.1a | 4.1 | chunk closes | detailed + brief = two separate work items |\\\\n    88\\\\t| TC-4.1b | 4.1 | detailed ok, brief fails | states independent (`ready` / `failed`) |\\\\n    89\\\\t| TC-4.2a | 4.2 | compact needs a `failed` detailed summary, `spyProvider` | `compactChunkMaterial` returns stored-member concat; **zero provider calls** (compact never models) |\\\\n    90\\\\t| TC-4.3a | 4.3 | summary unrecoverable at compact | band entry = deterministic concat of stored members; no missing span |\\\\n    91\\\\t| TC-4.4a | 4.4 | compact performs a fallback | visible warning naming what fell back |\\\\n    92\\\\t| TC-4.4b | 4.4 | compact mid-assembly, stop requested | halts without corrupting thread |\\\\n    93\\\\t| TC-4.5a | 4.5 | multiple missing/failed summaries | compact completes with concat fallbacks, not failure |\\\\n    94\\\\t| TC-4.5b | 4.5 | corrupt canonical source for a span | `compactChunkMaterial` returns `blocked`; compact refuses with `state_corruption` |\\\\n    95\\\\t| TC-4.6a | 4.6 | compact over not-ready summaries, `spyProvider` | **zero** provider calls during the entire compact |\\\\n    96\\\\t| TC-4.7a | 4.7 | compact falls back to concat | log entry: chunk, derivation type, reason, fallback |\\\\n    97\\\\t| TC-4.8a | 4.8 | background chunk summary, member `lower_band_projection` `pending` | summary work requeues (waits) with reason `member_projection_not_ready` — not concat, not `failed`, not a provider-failure reason |\\\\n    98\\\\t| TC-4.8b | 4.8 | member turn source corrupt | background summary surfaces source problem |\\\\n    99\\\\t\\\\n   100\\\\t### Flow 5 — Derivation Logging → `test/logging-surface.test.ts`\\\\n   101\\\\t\\\\n   102\\\\t| TC | AC | Setup | Assertion |\\\\n   103\\\\t|---|---|---|---|\\\\n   104\\\\t| TC-5.1a | 5.1 | write at info/warning/error | all three persisted with level |\\\\n   105\\\\t| TC-5.2a | 5.2 | write from internal + external caller | both land via same method/store |\\\\n   106\\\\t| TC-5.3a | 5.3 | derivation fell back | subject + rendering carry no degraded flag; fallback event only in log |\\\\n   107\\\\t| TC-5.3b | 5.3 | derivation terminally failed | derivation record shows `failed` + reason, independent of log |\\\\n   108\\\\t| TC-5.4a | 5.4 | mixed entries | query by level + derivation type returns only matches |\\\\n   109\\\\t| TC-5.5a | 5.5 | logging store write fails during turn construction | construction completes; logging failure contained |\\\\n   110\\\\t\\\\n   111\\\\t### Flow 6 — Runtime-Change Typing → `test/runtime-change-typing.test.ts`\\\\n   112\\\\t\\\\n   113\\\\t| TC | AC | Setup | Assertion |\\\\n   114\\\\t|---|---|---|---|\\\\n   115\\\\t| TC-6.1a | 6.1 | model-change runtime event at intake | typed `model_change` block with previous + new model |\\\\n   116\\\\t| TC-6.2a | 6.2 | thinking-level-change event at intake | typed `thinking_level_change` block with previous + new level |\\\\n   117\\\\t| TC-6.3a | 6.3 | turn with model change then thinking change | both typed blocks verbatim, in order |\\\\n   118\\\\t\\\\n   119\\\\t---\\\\n   120\\\\t\\\\n   121\\\\t## Architecture-Risk Tests (named)\\\\n   122\\\\t\\\\n   123\\\\t| Risk | TC(s) | What it proves |\\\\n   124\\\\t|---|---|---|\\\\n   125\\\\t| Source-truth preserved | TC-2.6a | full tool result intact under truncation + summary |\\\\n   126\\\\t| No-txn-across-provider (turn recovery) | TC-3.7a | competing write acquires lock during provider call |\\\\n   127\\\\t| Compact makes no provider call | TC-4.2a, TC-4.6a | `spyProvider` observes zero calls |\\\\n   128\\\\t| Recovery write-back defers to live work | TC-3.8d | claimed item present → floor does not persist; worker wins |\\\\n   129\\\\t| Stale recovery discarded | TC-3.8a (+ version-bump variant) | `recoverDerivation` is version-checked; stale discards |\\\\n   130\\\\t| Dependency-wait classified correctly | TC-4.8a | reason `member_projection_not_ready`, not provider failure |\\\\n   131\\\\t| Log never rolls back work | TC-5.5a | logging failure contained, turn still completes |\\\\n   132\\\\t| Idempotent background wait | TC-4.8a | requeue-and-wait does not duplicate work |\\\\n   133\\\\t| Tier/cap boundaries | TC-2.3c/2.7a, TC-1.2b | threshold edges behave |\\\\n   134\\\\t| Rename safety | Story 0 gate | rename is behavior-preserving (`verify-all` green under renamed vocabulary); `tool_call_summary` removal is a separate behavior change with its own red/green |\\\\n   135\\\\t| Corruption blocks | TC-4.5b | only canonical source corruption stops a compact |\\\\n   136\\\\t\\\\n   137\\\\t---\\\\n   138\\\\t\\\\n   139\\\\t## Per-Chunk Red/Green Exit Criteria\\\\n   140\\\\t\\\\n   141\\\\t| Chunk | Red exit | Green exit |\\\\n   142\\\\t|---|---|---|\\\\n   143\\\\t| 0 — rename + logging | renamed tree compiles; logging skeleton present; existing tests reference new names and fail only on logging-not-implemented | suite green under renamed vocabulary; TC-5.1a–5.5a pass. (`tool_call_summary` is renamed-but-retained here; its removal is Chunk 2.) |\\\\n   144\\\\t| 1 — smoothing floor | smoothing tests red on missing deterministic stage/gate | TC-1.1a–1.7b pass |\\\\n   145\\\\t| 2 — tool-result tiers + `tool_call_summary` removal | tier-gate + removal tests red (`tool_call_summary` still present) | TC-2.1a–2.8a pass; `tool_call_summary` gone from kind set/registry/`PART_PLANS`/provider |\\\\n   146\\\\t| 3 — cascade + logging | write-back + fallback-log tests red | TC-3.1a–3.8c pass |\\\\n   147\\\\t| 4 — chunk/compact recovery | background-wait + compact stored-member concat fallback (no model) tests red | TC-4.1a–4.8b pass |\\\\n   148\\\\t| 5 — runtime typing | typed-block projection tests red | TC-6.1a–6.3a pass |\\\\n   149\\\\t\\\\n   150\\\\t## Coverage Confirmation\\\\n   151\\\\t\\\\n   152\\\\t- 39 ACs, 59 TCs, every TC mapped to a test file and assertion above.\\\\n   153\\\\t- Every AC has ≥1 TC (verified against `epic.md`).\\\\n   154\\\\t- Mock boundary: `DerivationProvider` only; all storage real.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/streams/004-verify.stdout.log:16:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'rg --files packages/lhc/src packages/lhc/test'\\\",\\\"aggregated_output\\\":\\\"packages/lhc/src/sdk.ts\\\\npackages/lhc/src/index.ts\\\\npackages/lhc/test/derivation-turns.test.ts\\\\npackages/lhc/test/validation.test.ts\\\\npackages/lhc/test/inspect-view.test.ts\\\\npackages/lhc/test/lifecycle.test.ts\\\\npackages/lhc/test/epic-fix-02.test.ts\\\\npackages/lhc/test/work-queue.test.ts\\\\npackages/lhc/test/view-boundary.test.ts\\\\npackages/lhc/test/view-pull.test.ts\\\\npackages/lhc/test/thread-migration.test.ts\\\\npackages/lhc/test/threads.test.ts\\\\npackages/lhc/test/derivation-messages.test.ts\\\\npackages/lhc/test/threads-a8.test.ts\\\\npackages/lhc/src/inference/prompts/turn-compose-v1.ts\\\\npackages/lhc/src/inference/prompts/index.ts\\\\npackages/lhc/src/inference/prompts/smoothi
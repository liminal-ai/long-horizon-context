{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n     2\t// source turn, the member messages it composes (deleted-filtered — the\n     3\t// shared read-filter rule lives here, once for this domain), the\n     4\t// message-level form rows composition consumes, and the member projections\n     5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n     6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n     7\t// — no write path here.\n     8\timport type { DatabaseSync } from \"node:sqlite\";\n     9\timport type {\n    10\t  DependencyGap,\n    11\t  Derivation,\n    12\t  DerivationMetadata,\n    13\t  DerivationState,\n    14\t  DerivationReportEntry,\n    15\t  RenderingPartKind,\n    16\t  ToolRunReceipt,\n    17\t  DerivationType,\n    18\t  SubjectKind,\n    19\t} from \"../../../shared/derivation.js\";\n    20\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n    21\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n    22\timport { composeFormKey } from \"./compose.js\";\n    23\t\n    24\texport interface TurnSource {\n    25\t  turnId: string;\n    26\t  status: \"open\" | \"closed\";\n    27\t  deleted: boolean;\n    28\t}\n    29\t\n    30\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n    31\t  const row = db\n    32\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    33\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n    34\t  if (row === undefined) return undefined;\n    35\t  return {\n    36\t    turnId,\n    37\t    status: row.status as TurnSource[\"status\"],\n    38\t    deleted: row.deleted_at !== null,\n    39\t  };\n    40\t}\n    41\t\n    42\t// Member messages in message order, blocks attached, deleted messages\n    43\t// filtered (tech design §Mechanics: composition's member enumeration reads\n    44\t// the live projection only).\n    45\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n    46\t  const messages = db\n    47\t    .prepare(\n    48\t      `SELECT message_id, kind FROM message\n    49\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    50\t    )\n    51\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n    52\t  const blockStmt = db.prepare(\n    53\t    `SELECT block_type, content FROM message_block\n    54\t     WHERE message_id = ? ORDER BY block_index`,\n    55\t  );\n    56\t  return messages.map((message) => {\n    57\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n    58\t      block_type: string;\n    59\t      content: string;\n    60\t    }>;\n    61\t    return {\n    62\t      messageId: message.message_id,\n    63\t      kind: message.kind as RenderingPartKind,\n    64\t      blocks: blocks.map((block) => ({\n    65\t        blockType: block.block_type,\n    66\t        content: JSON.parse(block.content) as Record<string, unknown>,\n    67\t      })),\n    68\t    };\n    69\t  });\n    70\t}\n    71\t\n    72\t// The message-owned form rows for a set of member messages, keyed for\n    73\t// composition. A cross-owner *read* by design: composition consumes message\n    74\t// forms; only message handlers ever write them (DD-2 ownership is a write\n    75\t// rule).\n    76\texport function readMessageFormRows(\n    77\t  db: DatabaseSync,\n    78\t  messageIds: readonly string[],\n    79\t): Map<string, ComposeFormRow> {\n    80\t  const rows = new Map<string, ComposeFormRow>();\n    81\t  if (messageIds.length === 0) return rows;\n    82\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n    83\t  const raw = db\n    84\t    .prepare(\n    85\t      `SELECT subject_id, derivation_type, state, content, reason, metadata, source_version\n    86\t       FROM derivation\n    87\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    88\t    )\n    89\t    .all(...messageIds) as unknown as Array<{\n    90\t    subject_id: string;\n    91\t    derivation_type: string;\n    92\t    state: string;\n    93\t    content: string | null;\n    94\t    reason: string | null;\n    95\t    metadata: string | null;\n    96\t    source_version: number | bigint;\n    97\t  }>;\n    98\t  for (const row of raw) {\n    99\t    const view: ComposeFormRow = {\n   100\t      state: row.state as ComposeFormRow[\"state\"],\n   101\t      sourceVersion: Number(row.source_version),\n   102\t    };\n   103\t    if (row.content !== null) view.content = row.content;\n   104\t    if (row.reason !== null) view.reason = row.reason;\n   105\t    if (row.metadata !== null) {\n   106\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n   107\t    }\n   108\t    rows.set(composeFormKey(row.subject_id, row.derivation_type as DerivationType), view);\n   109\t  }\n   110\t  return rows;\n   111\t}\n   112\t\n   113\t// Member projections in turn order for the chunk summaries: member rows by\n   114\t// member_idx, deleted turns filtered, each joined to its stored\n   115\t// lower_band_projection row (state + content as landed — never re-derived)\n   116\t// and to its turn_rendering's mechanically stamped tool-run receipts\n   117\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\n   118\texport interface MemberProjection {\n   119\t  turnId: string;\n   120\t  state?: string; // undefined: no projection row exists for the member\n   121\t  content?: string;\n   122\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n   123\t}\n   124\t\n   125\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n   126\t  const rows = db\n   127\t    .prepare(\n   128\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n   129\t       FROM chunk_member cm\n   130\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   131\t       LEFT JOIN derivation df ON df.subject_kind = 'turn'\n   132\t         AND df.subject_id = cm.turn_id AND df.derivation_type = 'lower_band_projection'\n   133\t       LEFT JOIN derivation rf ON rf.subject_kind = 'turn'\n   134\t         AND rf.subject_id = cm.turn_id AND rf.derivation_type = 'turn_rendering'\n   135\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   136\t    )\n   137\t    .all(chunkId) as unknown as Array<{\n   138\t    turn_id: string;\n   139\t    state: string | null;\n   140\t    content: string | null;\n   141\t    rendering_metadata: string | null;\n   142\t  }>;\n   143\t  return rows.map((row) => {\n   144\t    const metadata =\n   145\t      row.rendering_metadata === null\n   146\t        ? undefined\n   147\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n   148\t    const projection: MemberProjection = {\n   149\t      turnId: row.turn_id,\n   150\t      receipts: metadata?.receipts ?? [],\n   151\t    };\n   152\t    if (row.state !== null) projection.state = row.state;\n   153\t    if (row.content !== null) projection.content = row.content;\n   154\t    return projection;\n   155\t  });\n   156\t}\n   157\t\n   158\tinterface RawOwnedFormRow {\n   159\t  subject_id: string;\n   160\t  derivation_type: string;\n   161\t  state: string;\n   162\t  content: string | null;\n   163\t  reason: string | null;\n   164\t  metadata: string | null;\n   165\t  source_version: number | bigint;\n   166\t  gaps: string | null;\n   167\t  derived_at: string | null;\n   168\t}\n   169\t\n   170\t// Every form row this owner holds for one subject kind, grouped by subject\n   171\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\n   172\t// \"record with form states\", mirroring messages.readMessageForms). Rows come\n   173\t// back exactly as the pipeline landed them; nothing is derived at read time.\n   174\texport function readOwnedForms(\n   175\t  db: DatabaseSync,\n   176\t  subjectKind: \"turn\" | \"chunk\",\n   177\t): Map<string, Derivation[]> {\n   178\t  const rows = db\n   179\t    .prepare(\n   180\t      `SELECT subject_id, derivation_type, state, content, reason, metadata,\n   181\t              source_version, gaps, derived_at\n   182\t       FROM derivation WHERE subject_kind = ?\n   183\t       ORDER BY subject_id, derivation_type`,\n   184\t    )\n   185\t    .all(subjectKind) as unknown as RawOwnedFormRow[];\n   186\t  const bySubject = new Map<string, Derivation[]>();\n   187\t  for (const row of rows) {\n   188\t    const record: Derivation = {\n   189\t      subjectKind,\n   190\t      subjectId: row.subject_id,\n   191\t      derivationType: row.derivation_type as DerivationType,\n   192\t      state: row.state as DerivationState,\n   193\t      sourceVersion: Number(row.source_version),\n   194\t    };\n   195\t    if (row.content !== null) record.content = row.content;\n   196\t    if (row.reason !== null) record.reason = row.reason;\n   197\t    if (row.metadata !== null) {\n   198\t      record.metadata = JSON.parse(row.metadata) as DerivationMetadata;\n   199\t    }\n   200\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n   201\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n   202\t    const forms = bySubject.get(row.subject_id) ?? [];\n   203\t    forms.push(record);\n   204\t    bySubject.set(row.subject_id, forms);\n   205\t  }\n   206\t  return bySubject;\n   207\t}\n   208\t\n   209\t// Chunk read-back rows for the listChunks surface: stored chunk state plus\n   210\t// live (deleted-filtered) membership in member order.\n   211\texport interface ChunkReadRow {\n   212\t  chunkId: string;\n   213\t  chunkOrder: number;\n   214\t  status: \"open\" | \"closed\";\n   215\t  accumulatedProjectedTokens: number;\n   216\t  memberTurnIds: string[];\n   217\t}\n   218\t\n   219\texport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\n   220\t  const chunks = db\n   221\t    .prepare(\n   222\t      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n   223\t       FROM chunk ORDER BY chunk_order`,\n   224\t    )\n   225\t    .all() as unknown as Array<{\n   226\t    chunk_id: string;\n   227\t    chunk_order: number | bigint;\n   228\t    status: string;\n   229\t    accumulated_projected_tokens: number | bigint;\n   230\t  }>;\n   231\t  const memberStmt = db.prepare(\n   232\t    `SELECT cm.turn_id FROM chunk_member cm\n   233\t     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   234\t     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   235\t  );\n   236\t  return chunks.map((row) => ({\n   237\t    chunkId: row.chunk_id,\n   238\t    chunkOrder: Number(row.chunk_order),\n   239\t    status: row.status as \"open\" | \"closed\",\n   240\t    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n   241\t    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\n   242\t      (member) => member.turn_id,\n   243\t    ),\n   244\t  }));\n   245\t}\n   246\t\n   247\t// One form row by exact key for this owner's subjects — the requeue\n   248\t// operation's refusal read (missing row, blocked state, current version).\n   249\texport function readTurnFormRow(\n   250\t  db: DatabaseSync,\n   251\t  subjectKind: \"turn\" | \"chunk\",\n   252\t  subjectId: string,\n   253\t  form: DerivationType,\n   254\t): { state: DerivationState; reason?: string; sourceVersion: number } | undefined {\n   255\t  const row = db\n   256\t    .prepare(\n   257\t      `SELECT state, reason, source_version FROM derivation\n   258\t       WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ?`,\n   259\t    )\n   260\t    .get(subjectKind, subjectId, form) as unknown as\n   261\t    | { state: string; reason: string | null; source_version: number | bigint }\n   262\t    | undefined;\n   263\t  if (row === undefined) return undefined;\n   264\t  const view: { state: DerivationState; reason?: string; sourceVersion: number } = {\n   265\t    state: row.state as DerivationState,\n   266\t    sourceVersion: Number(row.source_version),\n   267\t  };\n   268\t  if (row.reason !== null) view.reason = row.reason;\n   269\t  return view;\n   270\t}\n   271\t\n   272\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\n   273\t// form rows LEFT JOINed with the live work_item targeting each form at its\n   274\t// current source version. Both turn forms map to the one turn_derivation\n   275\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\n   276\t// this owner's queue-site mapping inverted, mirroring the messages report.\n   277\texport function reportTurnForms(\n   278\t  db: DatabaseSync,\n   279\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\n   280\t): DerivationReportEntry[] {\n   281\t  const conditions = [\"df.subject_kind IN ('turn', 'chunk')\"];\n   282\t  const params: string[] = [];\n   283\t  const subjectFilters: string[] = [];\n   284\t  if (opts.turnId !== undefined) {\n   285\t    subjectFilters.push(\"(df.subject_kind = 'turn' AND df.subject_id = ?)\");\n   286\t    params.push(opts.turnId);\n   287\t  }\n   288\t  if (opts.chunkId !== undefined) {\n   289\t    subjectFilters.push(\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\");\n   290\t    params.push(opts.chunkId);\n   291\t  }\n   292\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\" OR \")})`);\n   293\t  // notReady is exact set equality by construction: every state but ready.\n   294\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   295\t  const rows = db\n   296\t    .prepare(\n   297\t      `SELECT df.subject_kind, df.subject_id, df.derivation_type, df.state, df.content, df.reason,\n   298\t              df.metadata, df.source_version, df.gaps, df.derived_at,\n   299\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   300\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   301\t       FROM derivation df\n   302\t       LEFT JOIN work_item w\n   303\t         ON w.status IN ('queued', 'claimed')\n   304\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.derivation_type END\n   305\t        AND json_extract(\n   306\t              w.source_ref,\n   307\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\n   308\t            ) = df.subject_id\n   309\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   310\t       WHERE ${conditions.join(\" AND \")}\n   311\t       ORDER BY df.subject_kind DESC, df.subject_id, df.derivation_type`,\n   312\t    )\n   313\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\n   314\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\n   315\t}\n   316\t\n   317\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n   318\t  return (\n   319\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n   320\t  );\n   321\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,420p'\"","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport { resolveInstancePoke } from \"../../../shared/context.js\";\n    11\timport type {\n    12\t  DerivationMetadata,\n    13\t  DerivationType,\n    14\t  HandlerOutcome,\n    15\t  HandlerRunContext,\n    16\t  ToolOutcome,\n    17\t  WorkHandler,\n    18\t} from \"../../../shared/derivation.js\";\n    19\timport { writeLog } from \"../../../tech-utils/logging/index.js\";\n    20\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    21\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    22\timport { cleanPrompt } from \"../../messages/index.js\";\n    23\timport {\n    24\t  composeFormKey,\n    25\t  composeRenderingInput,\n    26\t  type ComposeFormRow,\n    27\t  type ComposeMessage,\n    28\t} from \"./compose.js\";\n    29\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    30\timport {\n    31\t  chunkExists,\n    32\t  readMemberMessages,\n    33\t  readMemberProjections,\n    34\t  readMessageFormRows,\n    35\t  readTurnSource,\n    36\t} from \"./forms.js\";\n    37\timport { hasLiveRecoveryWork, recoverDerivation } from \"./recovery.js\";\n    38\timport { selectOpenTurnIds } from \"./store.js\";\n    39\t\n    40\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    41\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    42\t}\n    43\t\n    44\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    45\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    46\t}\n    47\t\n    48\tfunction dependencyNotReady(reason: string): HandlerOutcome {\n    49\t  return { ok: false, retryable: true, reason };\n    50\t}\n    51\t\n    52\tfunction readThreadId(run: HandlerRunContext): string {\n    53\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    54\t    | { thread_id: string }\n    55\t    | undefined;\n    56\t  return row?.thread_id ?? \"\";\n    57\t}\n    58\t\n    59\tfunction logFallback(\n    60\t  run: HandlerRunContext,\n    61\t  entry: {\n    62\t    derivationType: DerivationType;\n    63\t    subjectId: string;\n    64\t    reason: \"not_ready\" | \"failed_floor\";\n    65\t    floorUsed: string;\n    66\t  },\n    67\t): void {\n    68\t  const db = run.openDb();\n    69\t  writeLog(\n    70\t    {\n    71\t      db,\n    72\t      clock: run.clock,\n    73\t      threadId: readThreadId(run),\n    74\t      onCommit: () => {},\n    75\t      poke: resolveInstancePoke(),\n    76\t    },\n    77\t    {\n    78\t      level: \"warning\",\n    79\t      message: \"derivation fallback used\",\n    80\t      derivationType: entry.derivationType,\n    81\t      subjectId: entry.subjectId,\n    82\t      reason: entry.reason,\n    83\t      floorUsed: entry.floorUsed,\n    84\t    },\n    85\t  );\n    86\t}\n    87\t\n    88\tfunction toolOutcomeFromMessage(message: ComposeMessage): ToolOutcome {\n    89\t  const block = message.blocks[0]?.content ?? {};\n    90\t  return block[\"isError\"] === true ? \"failed\" : \"succeeded\";\n    91\t}\n    92\t\n    93\tasync function recoverMessageForms(\n    94\t  run: HandlerRunContext,\n    95\t  messages: readonly ComposeMessage[],\n    96\t  forms: Map<string, ComposeFormRow>,\n    97\t): Promise<void> {\n    98\t  for (const message of messages) {\n    99\t    const plan =\n   100\t      message.kind === \"user_prompt\"\n   101\t        ? { derivationType: \"smoothed_prompt\" as const }\n   102\t        : message.kind === \"tool_result\"\n   103\t          ? { derivationType: \"tool_result_summary\" as const }\n   104\t          : undefined;\n   105\t    if (plan === undefined) continue;\n   106\t    const key = composeFormKey(message.messageId, plan.derivationType);\n   107\t    const row = forms.get(key);\n   108\t    if (row === undefined || row.state === \"ready\") continue;\n   109\t    const live = hasLiveRecoveryWork(run.openDb(), {\n   110\t      subjectKind: \"message\",\n   111\t      subjectId: message.messageId,\n   112\t      derivationType: plan.derivationType,\n   113\t      sourceVersion: row.sourceVersion,\n   114\t    });\n   115\t    if (live) continue;\n   116\t\n   117\t    const block = message.blocks[0]?.content ?? {};\n   118\t    const result =\n   119\t      message.kind === \"user_prompt\"\n   120\t        ? await run.provider.smoothPrompt({\n   121\t            text: cleanPrompt(typeof block[\"text\"] === \"string\" ? block[\"text\"] : \"\"),\n   122\t          })\n   123\t        : await run.provider.summarizeToolResult({\n   124\t            toolName: \"unknown_tool\",\n   125\t            content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n   126\t            outcome: toolOutcomeFromMessage(message),\n   127\t          });\n   128\t    if (!result.ok) continue;\n   129\t\n   130\t    const metadata: DerivationMetadata | undefined =\n   131\t      message.kind === \"tool_result\"\n   132\t        ? {\n   133\t            outcome: toolOutcomeFromMessage(message),\n   134\t            ...(result.provenance === undefined ? {} : { provenance: result.provenance }),\n   135\t          }\n   136\t        : result.provenance === undefined\n   137\t          ? undefined\n   138\t          : { provenance: result.provenance };\n   139\t    const recovered: ComposeFormRow = {\n   140\t      state: \"ready\",\n   141\t      content: result.text,\n   142\t      sourceVersion: row.sourceVersion,\n   143\t      ...(metadata === undefined ? {} : { metadata }),\n   144\t    };\n   145\t    forms.set(key, recovered);\n   146\t    recoverDerivation(run.openDb(), {\n   147\t      subjectKind: \"message\",\n   148\t      subjectId: message.messageId,\n   149\t      derivationType: plan.derivationType,\n   150\t      content: result.text,\n   151\t      ...(recovered.metadata === undefined ? {} : { metadata: recovered.metadata }),\n   152\t      sourceVersion: row.sourceVersion,\n   153\t      derivedAt: run.clock().toISOString(),\n   154\t    });\n   155\t  }\n   156\t}\n   157\t\n   158\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n   159\t  const turnId = item.sourceRef[\"turnId\"];\n   160\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n   161\t  const db = run.openDb();\n   162\t  const turn = readTurnSource(db, turnId);\n   163\t  if (turn === undefined || turn.deleted) {\n   164\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n   165\t    // would hit nothing; either way the item is terminal against a source\n   166\t    // that cannot improve.\n   167\t    return sourceDamaged(`turn ${turnId} not found`);\n   168\t  }\n   169\t  if (turn.status !== \"closed\") {\n   170\t    // Derivation is queued only at close; an open turn under a queued item\n   171\t    // means the record was interfered with.\n   172\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n   173\t  }\n   174\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n   175\t  // batch pipeline writes turn state and it never leaves two turns open, so\n   176\t  // more than one open turn means the record was damaged below the SDK. A\n   177\t  // handler must not compose against a membership it cannot trust; the form\n   178\t  // lands blocked naming the damage, and requeue refuses with that reason\n   179\t  // until the source reads clean (Story 4).\n   180\t  const openTurnIds = selectOpenTurnIds(db);\n   181\t  if (openTurnIds.length > 1) {\n   182\t    return sourceDamaged(\n   183\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n   184\t    );\n   185\t  }\n   186\t\n   187\t  // Compose from current message-form states: ready forms verbatim,\n   188\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n   189\t  // before any provider call, and no transaction is held across them.\n   190\t  const messages = readMemberMessages(db, turnId);\n   191\t  const forms = readMessageFormRows(\n   192\t    db,\n   193\t    messages.map((message) => message.messageId),\n   194\t  );\n   195\t  await recoverMessageForms(run, messages, forms);\n   196\t  const { parts, receipts, recoveries } = composeRenderingInput(messages, forms);\n   197\t  for (const recovery of recoveries) {\n   198\t    logFallback(run, {\n   199\t      derivationType: recovery.derivationType,\n   200\t      subjectId: recovery.subjectId,\n   201\t      reason: recovery.reason,\n   202\t      floorUsed: recovery.floorUsed,\n   203\t    });\n   204\t    recoverDerivation(run.openDb(), {\n   205\t      subjectKind: recovery.subjectKind,\n   206\t      subjectId: recovery.subjectId,\n   207\t      derivationType: recovery.derivationType,\n   208\t      content: recovery.content,\n   209\t      sourceVersion: recovery.sourceVersion,\n   210\t      derivedAt: run.clock().toISOString(),\n   211\t    });\n   212\t  }\n   213\t\n   214\t  const rendering = await run.provider.composeTurnRendering({ parts });\n   215\t  if (!rendering.ok) return providerFailed(rendering);\n   216\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n   217\t  if (!projection.ok) return providerFailed(projection);\n   218\t\n   219\t  // The projection's token count is estimated exactly once, here, as the\n   220\t  // artifact lands; placement reads this stored arithmetic and never\n   221\t  // re-counts (AC-3.9's determinism input).\n   222\t  const projectedTokens = estimateTokens(projection.text);\n   223\t  const threadId = readThreadId(run);\n   224\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\n   225\t  // from the composition input (AC-3.8) — the chunk summaries read them from\n   226\t  // here, never from provider prose. Provenance is copied from the provider\n   227\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\n   228\t  // deterministic provider sets none.\n   229\t  const renderingMetadata: DerivationMetadata = {\n   230\t    ...(receipts.length > 0 ? { receipts } : {}),\n   231\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\n   232\t  };\n   233\t\n   234\t  return {\n   235\t    ok: true,\n   236\t    derivations: [\n   237\t      {\n   238\t        subjectKind: \"turn\",\n   239\t        subjectId: turnId,\n   240\t        derivationType: \"turn_rendering\",\n   241\t        content: rendering.text,\n   242\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\n   243\t      },\n   244\t      {\n   245\t        subjectKind: \"turn\",\n   246\t        subjectId: turnId,\n   247\t        derivationType: \"lower_band_projection\",\n   248\t        content: projection.text,\n   249\t        ...(projection.provenance === undefined\n   250\t          ? {}\n   251\t          : { metadata: { provenance: projection.provenance } }),\n   252\t      },\n   253\t    ],\n   254\t    onApplied: (tx) => {\n   255\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   256\t      for (const chunkId of placement.closedChunkIds) {\n   257\t        enqueueChunkSummaries(\n   258\t          {\n   259\t            db: tx.db,\n   260\t            clock: run.clock,\n   261\t            threadId,\n   262\t            onCommit: tx.onCommit,\n   263\t            poke: resolveInstancePoke(),\n   264\t          },\n   265\t          chunkId,\n   266\t        );\n   267\t      }\n   268\t    },\n   269\t  };\n   270\t};\n   271\t\n   272\t// One read for both summary kinds — member projections in turn order — but\n   273\t// two contracts at the provider seam (AC-3.8): detailed receives the\n   274\t// members' tool-run receipts (what changed, outcome) read from the\n   275\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n   276\t// text stripped here so the brief provider call structurally cannot carry\n   277\t// it. Two work items, two handlers' runs, independent retry and states. A\n   278\t// member whose projection is not ready waits: chunk summary derivation is\n   279\t// background work, so it requeues until the member lower-band input lands.\n   280\tfunction chunkSummaryHandler(\n   281\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   282\t): WorkHandler {\n   283\t  return async (run, item) => {\n   284\t    const chunkId = item.sourceRef[\"chunkId\"];\n   285\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   286\t    const db = run.openDb();\n   287\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   288\t\n   289\t    const members = readMemberProjections(db, chunkId);\n   290\t    const memberProjections: string[] = [];\n   291\t    for (const member of members) {\n   292\t      if (member.state === \"ready\" && member.content !== undefined) {\n   293\t        memberProjections.push(member.content);\n   294\t        continue;\n   295\t      }\n   296\t      if (member.state === \"blocked\") {\n   297\t        return sourceDamaged(\n   298\t          `member ${member.turnId} lower_band_projection blocked while deriving ${kind}`,\n   299\t        );\n   300\t      }\n   301\t      return dependencyNotReady(\n   302\t        `member_projection_not_ready: member ${member.turnId} lower_band_projection is ${member.state ?? \"missing\"}`,\n   303\t      );\n   304\t    }\n   305\t\n   306\t    const result =\n   307\t      kind === \"chunk_summary_detailed\"\n   308\t        ? await run.provider.summarizeChunkDetailed({\n   309\t            memberProjections,\n   310\t            memberReceipts: members.map((member) => member.receipts),\n   311\t          })\n   312\t        : await run.provider.summarizeChunkBrief({\n   313\t            memberProjections,\n   314\t            memberOutcomes: members.map((member) =>\n   315\t              member.receipts.map((receipt) => receipt.outcome),\n   316\t            ),\n   317\t          });\n   318\t    if (!result.ok) return providerFailed(result);\n   319\t\n   320\t    return {\n   321\t      ok: true,\n   322\t      derivations: [\n   323\t        {\n   324\t          subjectKind: \"chunk\",\n   325\t          subjectId: chunkId,\n   326\t          derivationType: kind,\n   327\t          content: result.text,\n   328\t          ...(result.provenance === undefined\n   329\t            ? {}\n   330\t            : { metadata: { provenance: result.provenance } }),\n   331\t        },\n   332\t      ],\n   333\t    };\n   334\t  };\n   335\t}\n   336\t\n   337\t// The domain's handler table, merged into the SDK dispatch map at\n   338\t// construction (DD-6).\n   339\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   340\t  turn_derivation: turnDerivationHandler,\n   341\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   342\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   343\t};\n","exit_code":0,"status":"completed"}}

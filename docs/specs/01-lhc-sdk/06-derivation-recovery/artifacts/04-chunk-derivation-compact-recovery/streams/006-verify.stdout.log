{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/chunk-compact-recovery.test.ts | sed -n '1,380p'\"","aggregated_output":"     1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     2\timport type { SQLInputValue } from \"node:sqlite\";\n     3\timport {\n     4\t  createSdk,\n     5\t  queueDetail,\n     6\t  threads,\n     7\t  type DerivationProvider,\n     8\t  type Lhc,\n     9\t  type MessageEventInput,\n    10\t  type SdkConfig,\n    11\t} from \"../src/index.js\";\n    12\timport {\n    13\t  createProviderDouble,\n    14\t  openRaw,\n    15\t  readDerivedForms,\n    16\t  tempStore,\n    17\t  validEvent,\n    18\t  type TempStore,\n    19\t} from \"./fixtures/index.js\";\n    20\t\n    21\tlet store: TempStore;\n    22\tbeforeEach(() => {\n    23\t  store = tempStore();\n    24\t});\n    25\tafterEach(() => {\n    26\t  store.cleanup();\n    27\t});\n    28\t\n    29\tasync function newThread(): Promise<string> {\n    30\t  const created = await threads.newThread({\n    31\t    filePath: store.threadPath(),\n    32\t    registryPath: store.registryPath,\n    33\t  });\n    34\t  if (!created.ok) throw new Error(created.error.reason);\n    35\t  return created.value.filePath;\n    36\t}\n    37\t\n    38\tfunction sdkFor(provider: DerivationProvider, overrides: Partial<SdkConfig> = {}): Lhc {\n    39\t  return createSdk({\n    40\t    provider,\n    41\t    mode: \"manual\",\n    42\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    43\t    lease: { durationMs: 200 },\n    44\t    chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 999999 },\n    45\t    ...overrides,\n    46\t  });\n    47\t}\n    48\t\n    49\tasync function send(\n    50\t  sdk: Lhc,\n    51\t  filePath: string,\n    52\t  batch: readonly MessageEventInput[],\n    53\t): Promise<void> {\n    54\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    55\t  if (!result.ok) throw new Error(result.error.reason);\n    56\t}\n    57\t\n    58\tasync function drain(sdk: Lhc, filePath: string, opts?: { maxItems?: number }): Promise<void> {\n    59\t  const result = await sdk.work.drain({ filePath }, opts);\n    60\t  if (!result.ok) throw new Error(result.error.reason);\n    61\t}\n    62\t\n    63\tfunction execSql(filePath: string, sql: string, ...params: SQLInputValue[]): void {\n    64\t  const db = openRaw(filePath);\n    65\t  try {\n    66\t    db.prepare(sql).run(...params);\n    67\t  } finally {\n    68\t    db.close();\n    69\t  }\n    70\t}\n    71\t\n    72\tfunction execCorruptSql(filePath: string, sql: string, ...params: SQLInputValue[]): void {\n    73\t  const db = openRaw(filePath);\n    74\t  try {\n    75\t    db.exec(\"PRAGMA foreign_keys = OFF;\");\n    76\t    db.prepare(sql).run(...params);\n    77\t  } finally {\n    78\t    db.close();\n    79\t  }\n    80\t}\n    81\t\n    82\tfunction formOf(filePath: string, subjectId: string, derivationType: string) {\n    83\t  return readDerivedForms(filePath).find(\n    84\t    (form) => form.subjectId === subjectId && form.derivationType === derivationType,\n    85\t  );\n    86\t}\n    87\t\n    88\tfunction liveQueue(filePath: string) {\n    89\t  const db = openRaw(filePath);\n    90\t  try {\n    91\t    return queueDetail(db);\n    92\t  } finally {\n    93\t    db.close();\n    94\t  }\n    95\t}\n    96\t\n    97\tfunction setChunkSummaryState(\n    98\t  filePath: string,\n    99\t  chunkId: string,\n   100\t  derivationType: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   101\t  state: \"pending\" | \"ready\" | \"failed\" | \"blocked\",\n   102\t  opts: { content?: string; reason?: string } = {},\n   103\t): void {\n   104\t  execSql(\n   105\t    filePath,\n   106\t    `UPDATE derivation SET state = ?, content = ?, reason = ? \n   107\t     WHERE subject_kind = 'chunk' AND subject_id = ? AND derivation_type = ?`,\n   108\t    state,\n   109\t    opts.content ?? null,\n   110\t    opts.reason ?? null,\n   111\t    chunkId,\n   112\t    derivationType,\n   113\t  );\n   114\t}\n   115\t\n   116\tfunction deleteWorkFor(filePath: string, kind: string, chunkId: string): void {\n   117\t  execSql(\n   118\t    filePath,\n   119\t    `DELETE FROM work_item WHERE kind = ? AND json_extract(source_ref, '$.chunkId') = ?`,\n   120\t    kind,\n   121\t    chunkId,\n   122\t  );\n   123\t}\n   124\t\n   125\tasync function seedFourClosedTurns(sdk: Lhc, filePath: string): Promise<void> {\n   126\t  for (let i = 1; i <= 4; i += 1) {\n   127\t    await send(sdk, filePath, [\n   128\t      validEvent(\"user_prompt\", { payload: { text: `prompt ${i}` } }),\n   129\t      validEvent(\"assistant_text\", { payload: { text: `answer ${i}` } }),\n   130\t      validEvent(\"turn_end\"),\n   131\t    ]);\n   132\t  }\n   133\t  await drain(sdk, filePath);\n   134\t}\n   135\t\n   136\tdescribe(\"Story 4: chunk derivation and compact recovery\", () => {\n   137\t  it(\"queues detailed and brief chunk summaries as independent work items and states\", async () => {\n   138\t    const double = createProviderDouble();\n   139\t    double.failKind(\"chunk_summary_brief\", 3, {\n   140\t      retryable: true,\n   141\t      reason: \"timeout: scripted brief failure\",\n   142\t    });\n   143\t    const sdk = sdkFor(double);\n   144\t    const filePath = await newThread();\n   145\t\n   146\t    await seedFourClosedTurns(sdk, filePath);\n   147\t\n   148\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n   149\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")).toMatchObject({\n   150\t      state: \"failed\",\n   151\t      reason: \"timeout: scripted brief failure\",\n   152\t    });\n   153\t  });\n   154\t\n   155\t  it(\"compacts not-ready chunk summaries through stored-member concat with zero provider calls\", async () => {\n   156\t    const sdk = sdkFor(createProviderDouble());\n   157\t    const filePath = await newThread();\n   158\t    await seedFourClosedTurns(sdk, filePath);\n   159\t    setChunkSummaryState(filePath, \"c1\", \"chunk_summary_detailed\", \"failed\", {\n   160\t      reason: \"timeout: old summary failed\",\n   161\t    });\n   162\t    deleteWorkFor(filePath, \"chunk_summary_detailed\", \"c1\");\n   163\t\n   164\t    const spy = createProviderDouble();\n   165\t    const captured = spy.captureInputs();\n   166\t    const compactSdk = sdkFor(spy);\n   167\t    const compacted = await compactSdk.threadView.compact(\n   168\t      { filePath },\n   169\t      {\n   170\t        sweep: false,\n   171\t        params: {\n   172\t          lowerBound: 120,\n   173\t          percentages: { full: 10, smooth: 10, detailed: 70, brief: 10 },\n   174\t        },\n   175\t      },\n   176\t    );\n   177\t\n   178\t    expect(compacted.ok).toBe(true);\n   179\t    if (!compacted.ok) return;\n   180\t    expect(captured).toEqual([]);\n   181\t    expect(compacted.value.warnings).toContainEqual({\n   182\t      band: \"detailed\",\n   183\t      subjectId: \"c1\",\n   184\t      derivationType: \"chunk_summary_detailed\",\n   185\t      reason: \"failed_floor\",\n   186\t    });\n   187\t    const pulled = await compactSdk.threadView.pull({ filePath });\n   188\t    expect(pulled.ok).toBe(true);\n   189\t    if (!pulled.ok) return;\n   190\t    const detailed = pulled.value.messages.find((message) => message.band === \"detailed\");\n   191\t    expect(detailed?.content).toContain(\"§c1 [degraded: detailed-from-stored-members]\");\n   192\t    expect(detailed?.content).toContain(\"§t1\\nprompt 1\\nanswer 1\");\n   193\t    expect(detailed?.content).not.toContain(\"unavailable\");\n   194\t\n   195\t    const logs = await compactSdk.logging.query(\n   196\t      { filePath },\n   197\t      { derivationType: \"chunk_summary_detailed\", subjectId: \"c1\" },\n   198\t    );\n   199\t    expect(logs.ok).toBe(true);\n   200\t    if (!logs.ok) return;\n   201\t    expect(logs.value[0]).toMatchObject({\n   202\t      level: \"warning\",\n   203\t      reason: \"failed_floor\",\n   204\t      floorUsed: \"stored_member_concat\",\n   205\t    });\n   206\t  });\n   207\t\n   208\t  it(\"halts compact before fallback assembly when stop is requested\", async () => {\n   209\t    const sdk = sdkFor(createProviderDouble());\n   210\t    const filePath = await newThread();\n   211\t    await seedFourClosedTurns(sdk, filePath);\n   212\t    setChunkSummaryState(filePath, \"c1\", \"chunk_summary_detailed\", \"pending\");\n   213\t    deleteWorkFor(filePath, \"chunk_summary_detailed\", \"c1\");\n   214\t\n   215\t    const stopped = await sdk.threadView.compact(\n   216\t      { filePath },\n   217\t      {\n   218\t        sweep: false,\n   219\t        signal: { aborted: true },\n   220\t        params: {\n   221\t          lowerBound: 120,\n   222\t          percentages: { full: 10, smooth: 10, detailed: 70, brief: 10 },\n   223\t        },\n   224\t      },\n   225\t    );\n   226\t\n   227\t    expect(stopped.ok).toBe(false);\n   228\t    if (stopped.ok) return;\n   229\t    expect(stopped.error).toMatchObject({\n   230\t      errorClass: \"caller_error\",\n   231\t      code: \"compact_stopped\",\n   232\t    });\n   233\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"pending\");\n   234\t  });\n   235\t\n   236\t  it(\"refuses compact when canonical member source is corrupt\", async () => {\n   237\t    const sdk = sdkFor(createProviderDouble());\n   238\t    const filePath = await newThread();\n   239\t    await seedFourClosedTurns(sdk, filePath);\n   240\t    setChunkSummaryState(filePath, \"c1\", \"chunk_summary_detailed\", \"pending\");\n   241\t    deleteWorkFor(filePath, \"chunk_summary_detailed\", \"c1\");\n   242\t    execCorruptSql(filePath, `DELETE FROM turns WHERE turn_id = 't1'`);\n   243\t\n   244\t    const compacted = await sdk.threadView.compact(\n   245\t      { filePath },\n   246\t      {\n   247\t        sweep: false,\n   248\t        params: {\n   249\t          lowerBound: 120,\n   250\t          percentages: { full: 10, smooth: 10, detailed: 70, brief: 10 },\n   251\t        },\n   252\t      },\n   253\t    );\n   254\t\n   255\t    expect(compacted.ok).toBe(false);\n   256\t    if (compacted.ok) return;\n   257\t    expect(compacted.error).toMatchObject({ errorClass: \"state_corruption\" });\n   258\t  });\n   259\t\n   260\t  it(\"background chunk summary work requeues on not-ready member projection\", async () => {\n   261\t    const sdk = sdkFor(createProviderDouble(), {\n   262\t      retry: { budget: 3, backoffBaseMs: 1000, backoffCapMs: 1000 },\n   263\t    });\n   264\t    const filePath = await newThread();\n   265\t    await seedFourClosedTurns(sdk, filePath);\n   266\t    setChunkSummaryState(filePath, \"c1\", \"chunk_summary_detailed\", \"pending\");\n   267\t    execSql(\n   268\t      filePath,\n   269\t      `UPDATE derivation SET state = 'pending', content = NULL\n   270\t       WHERE subject_kind = 'turn' AND subject_id = 't1' AND derivation_type = 'lower_band_projection'`,\n   271\t    );\n   272\t    execSql(\n   273\t      filePath,\n   274\t      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n   275\t       VALUES ('w-c1-chunk_summary_detailed-v99', 'turns', 'chunk_summary_detailed', ?, 'queued', '2026-06-15T00:00:00.000Z', ?)`,\n   276\t      JSON.stringify({ chunkId: \"c1\" }),\n   277\t      JSON.stringify({\n   278\t        sourceVersion: 1,\n   279\t        derivations: [\n   280\t          { subjectKind: \"chunk\", subjectId: \"c1\", derivationType: \"chunk_summary_detailed\" },\n   281\t        ],\n   282\t      }),\n   283\t    );\n   284\t\n   285\t    await drain(sdk, filePath, { maxItems: 1 });\n   286\t\n   287\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"pending\");\n   288\t    const item = liveQueue(filePath).find((row) => row.workItemId === \"w-c1-chunk_summary_detailed-v99\");\n   289\t    expect(item).toMatchObject({\n   290\t      status: \"queued\",\n   291\t      attempts: 1,\n   292\t      lastError: expect.stringContaining(\"member_projection_not_ready\"),\n   293\t    });\n   294\t  });\n   295\t\n   296\t  it(\"background chunk summary blocks on member source damage\", async () => {\n   297\t    const sdk = sdkFor(createProviderDouble());\n   298\t    const filePath = await newThread();\n   299\t    await seedFourClosedTurns(sdk, filePath);\n   300\t    setChunkSummaryState(filePath, \"c1\", \"chunk_summary_detailed\", \"pending\");\n   301\t    execSql(\n   302\t      filePath,\n   303\t      `UPDATE derivation SET state = 'blocked', content = NULL, reason = 'source_damaged: member corrupt'\n   304\t       WHERE subject_kind = 'turn' AND subject_id = 't1' AND derivation_type = 'lower_band_projection'`,\n   305\t    );\n   306\t    execSql(\n   307\t      filePath,\n   308\t      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n   309\t       VALUES ('w-c1-chunk_summary_detailed-v98', 'turns', 'chunk_summary_detailed', ?, 'queued', '2026-06-15T00:00:00.000Z', ?)`,\n   310\t      JSON.stringify({ chunkId: \"c1\" }),\n   311\t      JSON.stringify({\n   312\t        sourceVersion: 1,\n   313\t        derivations: [\n   314\t          { subjectKind: \"chunk\", subjectId: \"c1\", derivationType: \"chunk_summary_detailed\" },\n   315\t        ],\n   316\t      }),\n   317\t    );\n   318\t\n   319\t    await drain(sdk, filePath, { maxItems: 1 });\n   320\t\n   321\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")).toMatchObject({\n   322\t      state: \"blocked\",\n   323\t      reason: expect.stringContaining(\"source_damaged\"),\n   324\t    });\n   325\t  });\n   326\t});\n","exit_code":0,"status":"completed"}}

      ? (...args: unknown[]): unknown =>\n   334\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   335\t        : value;\n   336\t  }\n   337\t  return scoped as T;\n   338\t}\n   339\t\n   340\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n   341\t// the host function and the complete assignment map loudly — all seven kinds\n   342\t// present (iterating the exported DERIVATION_TYPES set, never a second literal\n   343\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n   344\t// provider/model routing keys — then build the adapter into the same\n   345\t// DerivationProvider slot direct injection uses. No partial construction:\n   346\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n   347\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n   348\t  if (typeof inference.call !== \"function\") {\n   349\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n   350\t  }\n   351\t  const assignments = inference.assignments as unknown;\n   352\t  if (assignments === null || typeof assignments !== \"object\") {\n   353\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n   354\t  }\n   355\t  const knownKinds = new Set<string>(DERIVATION_TYPES);\n   356\t  for (const key of Object.keys(assignments)) {\n   357\t    if (!knownKinds.has(key)) {\n   358\t      throw new TypeError(\n   359\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n   360\t      );\n   361\t    }\n   362\t  }\n   363\t  const map = assignments as Partial<Record<DerivationType, ModelAssignment>>;\n   364\t  for (const kind of DERIVATION_TYPES) {\n   365\t    const assignment = map[kind];\n   366\t    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n   367\t      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n   368\t    }\n   369\t    for (const field of [\"provider\", \"model\"] as const) {\n   370\t      const value = assignment[field];\n   371\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n   372\t        throw new TypeError(\n   373\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n   374\t        );\n   375\t      }\n   376\t    }\n   377\t    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n   378\t      throw new TypeError(\n   379\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n   380\t      );\n   381\t    }\n   382\t  }\n   383\t  const timeoutMs = inference.timeoutMs ?? 60_000;\n   384\t  const maxInputChars = inference.maxInputChars ?? 200_000;\n   385\t  requirePositive(timeoutMs, \"inference.timeoutMs\");\n   386\t  requirePositive(maxInputChars, \"inference.maxInputChars\");\n   387\t  return createInferenceProvider({\n   388\t    call: inference.call,\n   389\t    assignments: map as Record<DerivationType, ModelAssignment>,\n   390\t    timeoutMs,\n   391\t    maxInputChars,\n   392\t  });\n   393\t}\n   394\t\n   395\t// The only assembly path: provider, mode, clock, and policy enter here.\n   396\t// Config mistakes are programmer errors at construction and throw; operating\n   397\t// failures after construction return OpResults per the error contract.\n   398\texport function createSdk(config: SdkConfig): Lhc {\n   399\t  // Provider arrival is exactly one of direct injection or the inference\n   400\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n   401\t  // env/flag resolution path to fall back on. The XOR rule is validated\n   402\t  // before anything downstream so the error names the caller's mistake, not\n   403\t  // a symptom (AC-1.1).\n   404\t  if (config.provider !== undefined && config.inference !== undefined) {\n   405\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   406\t  }\n   407\t  if (config.provider === undefined && config.inference === undefined) {\n   408\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   409\t  }\n   410\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   411\t    throw new TypeError(\n   412\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   413\t    );\n   414\t  }\n   415\t  let provider: DerivationProvider;\n   416\t  if (config.inference !== undefined) {\n   417\t    provider = resolveInferenceProvider(config.inference);\n   418\t  } else {\n   419\t    if (config.provider === null || typeof config.provider !== \"object\") {\n   420\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   421\t    }\n   422\t    for (const operation of PROVIDER_OPERATIONS) {\n   423\t      if (typeof config.provider[operation] !== \"function\") {\n   424\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   425\t      }\n   426\t    }\n   427\t    provider = config.provider;\n   428\t  }\n   429\t\n   430\t  const resolved: ResolvedSdkConfig = {\n   431\t    provider,\n   432\t    mode: config.mode,\n   433\t    clock: config.clock ?? (() => new Date()),\n   434\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   435\t    smoothing: config.smoothing ?? { maxInferenceTokens: 4000 },\n   436\t    toolResult: config.toolResult ?? {\n   437\t      smallTierTokens: 1000,\n   438\t      largeTierTokens: 5000,\n   439\t      smallTargetRatio: 0.15,\n   440\t      midTargetRatio: 0.04,\n   441\t    },\n   442\t    lease: config.lease ?? { durationMs: 120000 },\n   443\t    chunkPolicy:\n   444\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   445\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   446\t    // sums and visibility budgets validated — throws naming the violation.\n   447\t    view: resolveViewConfig(config.view),\n   448\t  };\n   449\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   450\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   451\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   452\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   453\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   454\t  }\n   455\t  requirePositive(resolved.smoothing.maxInferenceTokens, \"smoothing.maxInferenceTokens\");\n   456\t  requirePositive(resolved.toolResult.smallTierTokens, \"toolResult.smallTierTokens\");\n   457\t  requirePositive(resolved.toolResult.largeTierTokens, \"toolResult.largeTierTokens\");\n   458\t  if (resolved.toolResult.largeTierTokens < resolved.toolResult.smallTierTokens) {\n   459\t    throw new TypeError(\n   460\t      \"createSdk config: toolResult.largeTierTokens must be >= smallTierTokens\",\n   461\t    );\n   462\t  }\n   463\t  requirePositive(resolved.toolResult.smallTargetRatio, \"toolResult.smallTargetRatio\");\n   464\t  requirePositive(resolved.toolResult.midTargetRatio, \"toolResult.midTargetRatio\");\n   465\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   466\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   467\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   468\t    throw new TypeError(\n   469\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   470\t    );\n   471\t  }\n   472\t\n   473\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   474\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   475\t  // assembly mechanics are production code from day one.\n   476\t  const workHandlers = assembleWorkHandlerMap([\n   477\t    messagesDomain.workHandlers,\n   478\t    turnsDomain.workHandlers,\n   479\t  ]);\n   480\t\n   481\t  const drainDeps: DrainDeps = {\n   482\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   483\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   484\t    config: resolved,\n   485\t  };\n   486\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   487\t\n   488\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   489\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   490\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   491\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   492\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   493\t  // the construction order, because its operations deliver to the no-op seam,\n   494\t  // not to whatever a background SDK installed below.\n   495\t  // The seam also carries this instance's resolved view config (Epic 03,\n   496\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n   497\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n   498\t  // fall back to the built-in defaults inside the thread-view surface.\n   499\t  const seam: InstanceSeam =\n   500\t    resolved.mode === \"background\"\n   501\t      ? {\n   502\t          poke: (threadId) => scheduler.poke(threadId),\n   503\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   504\t          view: resolved.view,\n   505\t          toolResult: resolved.toolResult,\n   506\t        }\n   507\t      : { poke: () => {}, touch: () => {}, view: resolved.view, toolResult: resolved.toolResult };\n   508\t\n   509\t  // Background mode also installs the below-SDK default seam so a direct\n   510\t  // domain call made with no SDK scope — a top-level mutation in the\n   511\t  // single-background \"production path\" — still reaches the one installed\n   512\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   513\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   514\t  // leaves the default alone (pokes stay no-ops by contract).\n   515\t  if (resolved.mode === \"background\") {\n   516\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   517\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   518\t  }\n   519\t\n   520\t  const work: WorkSurface = {\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/scheduler.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// SDK-internal scheduler and drain (DD-4): the one component holding\n     2\t// cross-operation in-memory state. The drain loop lives here per the tech\n     3\t// design's placement — claim under BEGIN IMMEDIATE, dispatch through the\n     4\t// handler map with no open transaction (the provider call lives there),\n     5\t// complete in a second short transaction. Background mode adds per-thread\n     6\t// single-flight with pending-flag coalescing, post-commit pokes, first-touch\n     7\t// catch-up (DD-10), and drainSettled (issue 3). The in-memory state is\n     8\t// advisory only: cross-process safety comes from the durable lease alone, so\n     9\t// a fresh handle sees identical drain behavior — the queue is the rows.\n    10\timport { existsSync } from \"node:fs\";\n    11\timport {\n    12\t  clearTimeout as cancelTimer,\n    13\t  setImmediate as scheduleMacrotask,\n    14\t  setTimeout as scheduleTimer,\n    15\t} from \"node:timers\";\n    16\timport { DatabaseSync } from \"node:sqlite\";\n    17\timport { openThreadDatabase } from \"./domains/threads/index.js\";\n    18\timport type {\n    19\t  HandlerOutcome,\n    20\t  ResolvedSdkConfig,\n    21\t  WorkHandler,\n    22\t} from \"./shared/derivation.js\";\n    23\timport { storageFailure, type ErrorResult, type OpResult } from \"./shared/errors.js\";\n    24\timport {\n    25\t  claimNext,\n    26\t  complete,\n    27\t  countLiveItems,\n    28\t  failAttempt,\n    29\t  failTerminal,\n    30\t  type ClaimedWorkItem,\n    31\t  type WorkKind,\n    32\t  type WorkSourceRef,\n    33\t} from \"./tech-utils/work-queue/index.js\";\n    34\t\n    35\texport type SchedulerMode = \"background\" | \"manual\";\n    36\t\n    37\t// Report shape per tech design §Interfaces. `superseded` never appears here:\n    38\t// the cascade deletes superseded items and reports them on the mutation\n    39\t// result; a drain never sees them.\n    40\texport interface DrainReport {\n    41\t  ran: Array<{\n    42\t    workItemId: string;\n    43\t    kind: WorkKind;\n    44\t    sourceRef: WorkSourceRef;\n    45\t    disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\";\n    46\t    attempts: number;\n    47\t    reason?: string;\n    48\t  }>;\n    49\t  stoppedBecause: \"empty\" | \"in_flight\" | \"waiting\" | \"max_items\";\n    50\t  waitingUntil?: string; // head's eligible_at when stoppedBecause = \"waiting\"\n    51\t  remaining: number; // live items left behind the stop point\n    52\t}\n    53\t\n    54\texport interface DrainDeps {\n    55\t  lookupHandler: (kind: string) => OpResult<WorkHandler>;\n    56\t  // Whether any handler is registered at all. Background scheduling is gated\n    57\t  // on this, fail-closed: with an empty map a background drain could only\n    58\t  // turn queued rows into failed_terminal — destruction, not processing — so\n    59\t  // pokes and catch-up stay inert until a handler table is populated\n    60\t  // (Stories 2–3 in production; explicit registration in tests).\n    61\t  hasAnyHandler: () => boolean;\n    62\t  config: ResolvedSdkConfig;\n    63\t}\n    64\t\n    65\tfunction ranEntry(\n    66\t  item: ClaimedWorkItem,\n    67\t  disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\",\n    68\t  attempts: number,\n    69\t  reason?: string,\n    70\t): DrainReport[\"ran\"][number] {\n    71\t  const entry: DrainReport[\"ran\"][number] = {\n    72\t    workItemId: item.workItemId,\n    73\t    kind: item.kind as WorkKind,\n    74\t    sourceRef: item.sourceRef,\n    75\t    disposition,\n    76\t    attempts,\n    77\t  };\n    78\t  if (reason !== undefined) entry.reason = reason;\n    79\t  return entry;\n    80\t}\n    81\t\n    82\t// The drain loop against an open handle. Claim → dispatch → complete, one\n    83\t// item at a time, until the head stops it (empty / in_flight / waiting) or\n    84\t// maxItems is reached. The handler runs with NO open transaction; the only\n    85\t// exits from a handler failure are failAttempt and the terminal paths — the\n    86\t// drain never catches an error and records success.\n    87\texport async function drainOpenDb(\n    88\t  db: DatabaseSync,\n    89\t  deps: DrainDeps,\n    90\t  opts?: { maxItems?: number },\n    91\t): Promise<DrainReport> {\n    92\t  const { clock, lease, retry, provider } = deps.config;\n    93\t  const ran: DrainReport[\"ran\"] = [];\n    94\t  let stoppedBecause: DrainReport[\"stoppedBecause\"];\n    95\t  let waitingUntil: string | undefined;\n    96\t\n    97\t  for (;;) {\n    98\t    if (opts?.maxItems !== undefined && ran.length >= opts.maxItems) {\n    99\t      stoppedBecause = \"max_items\";\n   100\t      break;\n   101\t    }\n   102\t    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\n   103\t    if (claim.outcome === \"empty\") {\n   104\t      stoppedBecause = \"empty\";\n   105\t      break;\n   106\t    }\n   107\t    if (claim.outcome === \"in_flight\") {\n   108\t      stoppedBecause = \"in_flight\";\n   109\t      break;\n   110\t    }\n   111\t    if (claim.outcome === \"waiting\") {\n   112\t      stoppedBecause = \"waiting\";\n   113\t      waitingUntil = claim.waitingUntil;\n   114\t      break;\n   115\t    }\n   116\t    const item = claim.item;\n   117\t\n   118\t    const lookedUp = deps.lookupHandler(item.kind);\n   119\t    if (!lookedUp.ok) {\n   120\t      // Unregistered kind: the normal terminal transaction, not a try/catch\n   121\t      // skip — failed_terminal with the stable code, form (if resolvable\n   122\t      // from the payload) lands failed, and the drain continues (AC-1.8).\n   123\t      failTerminal(db, item, {\n   124\t        reason: lookedUp.error.code,\n   125\t        formState: \"failed\",\n   126\t        attempts: item.attempts,\n   127\t        now: clock().toISOString(),\n   128\t      });\n   129\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts, lookedUp.error.code));\n   130\t      continue;\n   131\t    }\n   132\t\n   133\t    let outcome: HandlerOutcome;\n   134\t    try {\n   135\t      outcome = await lookedUp.value(\n   136\t        { openDb: () => db, provider, clock, config: deps.config },\n   137\t        {\n   138\t          workItemId: item.workItemId,\n   139\t          kind: item.kind,\n   140\t          sourceRef: item.sourceRef as unknown as Record<string, string>,\n   141\t        },\n   142\t      );\n   143\t    } catch (cause) {\n   144\t      // A throwing handler is a bug by the error contract, but the queue\n   145\t      // must not wedge on it: route it through the normal retry path so it\n   146\t      // counts attempts and exhausts visibly.\n   147\t      const detail = cause instanceof Error ? cause.message : String(cause);\n   148\t      outcome = { ok: false, retryable: true, reason: `handler threw: ${detail}` };\n   149\t    }\n   150\t\n   151\t    if (outcome.ok) {\n   152\t      const disposition = complete(\n   153\t        db,\n   154\t        item,\n   155\t        outcome.derivations ?? [],\n   156\t        clock().toISOString(),\n   157\t        outcome.onApplied,\n   158\t      );\n   159\t      ran.push(ranEntry(item, disposition, item.attempts));\n   160\t      continue;\n   161\t    }\n   162\t    if (\"blocked\" in outcome) {\n   163\t      failTerminal(db, item, {\n   164\t        reason: outcome.reason,\n   165\t        formState: \"blocked\",\n   166\t        attempts: item.attempts + 1,\n   167\t        now: clock().toISOString(),\n   168\t      });\n   169\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts + 1, outcome.reason));\n   170\t      continue;\n   171\t    }\n   172\t    const failed = failAttempt(db, item, {\n   173\t      reason: outcome.reason,\n   174\t      retryable: outcome.retryable,\n   175\t      now: clock().toISOString(),\n   176\t      retry,\n   177\t    });\n   178\t    if (failed.terminal) {\n   179\t      ran.push(ranEntry(item, \"failed_terminal\", failed.attempts, outcome.reason));\n   180\t    }\n   181\t    // Under budget the item went back to queued (possibly backing off); the\n   182\t    // next claimNext re-reads the head — a backing-off head ends the drain\n   183\t    // with \"waiting\" and gates everything behind it.\n   184\t  }\n   185\t\n   186\t  const report: DrainReport = { ran, stoppedBecause, remaining: countLiveItems(db) };\n   187\t  if (waitingUntil !== undefined) report.waitingUntil = waitingUntil;\n   188\t  return report;\n   189\t}\n   190\t\n   191\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   192\t  return {\n   193\t    ok: false,\n   194\t    error: {\n   195\t      errorClass: \"caller_error\",\n   196\t      code: \"thread_not_found\",\n   197\t      reason: `no thread file exists at ${filePath}`,\n   198\t    },\n   199\t  };\n   200\t}\n   201\t\n   202\t// The drain operation against a thread file: open (validates + migrates),\n   203\t// drain, close. Both the SDK's work.drain and the background loop's passes\n   204\t// run through here — manual and background modes share one drain.\n   205\texport async function runDrain(\n   206\t  filePath: string,\n   207\t  deps: DrainDeps,\n   208\t  opts?: { maxItems?: number },\n   209\t): Promise<OpResult<DrainReport>> {\n   210\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   211\t  const opened = openThreadDatabase(filePath);\n   212\t  if (!opened.ok) return opened;\n   213\t  const db = opened.value;\n   214\t  try {\n   215\t    return { ok: true, value: await drainOpenDb(db, deps, opts) };\n   216\t  } catch (cause) {\n   217\t    const detail = cause instanceof Error ? cause.message : String(cause);\n   218\t    return storageFailure(`drain failed: ${detail}`);\n   219\t  } finally {\n   220\t    db.close();\n   221\t  }\n   222\t}\n   223\t\n   224\tinterface ThreadDrainState {\n   225\t  threadId: string;\n   226\t  filePath: string;\n   227\t  running: boolean;\n   228\t  pending: boolean;\n   229\t  passes: number; // test-only observability (TC-1.2); must not become API\n   230\t  waiters: Array<() => void>;\n   231\t  // Fix 1 (DD-4 completion): at most one pending backoff wake per thread; a\n   232\t  // poke or a newer wake clears it. unref'd so it never keeps the process\n   233\t  // alive. Background only — manual never reaches the drain loop.\n   234\t  wakeTimer: ReturnType<typeof scheduleTimer> | undefined;\n   235\t}\n   236\t\n   237\t// A wake floored to a sane minimum: an eligible_at already in the past must\n   238\t// nudge once, not busy-spin (the durable claimNext gate is the real guard).\n   239\tconst WAKE_MIN_DELAY_MS = 5;\n   240\t\n   241\texport interface Scheduler {\n   242\t  readonly mode: SchedulerMode;\n   243\t  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n   244\t  // no-op by contract. Background mode: starts a drain, or coalesces into\n   245\t  // the pending flag if one is already running for the thread (AC-1.2).\n   246\t  poke(threadId: string): void;\n   247\t  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n   248\t  // on the first touch of a thread this process lifetime, schedules a\n   249\t  // catch-up drain if the queue has leftover live work (AC-1.6).\n   250\t  touch(filePath: string, db: DatabaseSync): void;\n   251\t  // Resolves when the scheduler has no running or pending drain for the\n   252\t  // thread (issue 3). Manual mode resolves immediately.\n   253\t  drainSettled(threadId: string): Promise<void>;\n   254\t  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n   255\t  // started for a thread. Named as a test hook on purpose — not API.\n   256\t  testPassCount(threadId: string): number;\n   257\t}\n   258\t\n   259\tfunction readThreadId(db: DatabaseSync): string | null {\n   260\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n","exit_code":0,"status":"completed"}}

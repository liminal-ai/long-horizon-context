\\"summarizeToolResult\\\"\\n    24\\t  | \\\"composeTurnRendering\\\"\\n    25\\t  | \\\"projectLowerBand\\\"\\n    26\\t  | \\\"summarizeChunkDetailed\\\"\\n    27\\t  | \\\"summarizeChunkBrief\\\";\\n    28\\t\\n    29\\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\\n    30\\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\\n    31\\t// as the operation names themselves.\\n    32\\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\\n    33\\t  smoothPrompt: \\\"smoothPrompt\\\",\\n    34\\t  summarizeToolResult: \\\"summarizeToolResult\\\",\\n    35\\t  composeTurnRendering: \\\"composeTurnRendering\\\",\\n    36\\t  projectLowerBand: \\\"projectLowerBand\\\",\\n    37\\t  summarizeChunkDetailed: \\\"summarizeChunkDetailed\\\",\\n    38\\t  summarizeChunkBrief: \\\"summarizeChunkBrief\\\",\\n    39\\t  prompt_smoothing: \\\"smoothPrompt\\\",\\n    40\\t  smoothed_prompt: \\\"smoothPrompt\\\",\\n    41\\t  tool_result_summary: \\\"summarizeToolResult\\\",\\n    42\\t  turn_rendering: \\\"composeTurnRendering\\\",\\n    43\\t  lower_band_projection: \\\"projectLowerBand\\\",\\n    44\\t  chunk_summary_detailed: \\\"summarizeChunkDetailed\\\",\\n    45\\t  chunk_summary_brief: \\\"summarizeChunkBrief\\\",\\n    46\\t};\\n    47\\t\\n    48\\tfunction resolveOpName(kind: string): ProviderOpName {\\n    49\\t  const op = KIND_ALIASES[kind];\\n    50\\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \\\"${kind}\\\"`);\\n    51\\t  return op;\\n    52\\t}\\n    53\\t\\n    54\\tinterface FailScript {\\n    55\\t  remaining: number;\\n    56\\t  retryable: boolean;\\n    57\\t  reason: string;\\n    58\\t}\\n    59\\t\\n    60\\texport interface CapturedInput {\\n    61\\t  op: ProviderOpName;\\n    62\\t  input: unknown;\\n    63\\t}\\n    64\\t\\n    65\\texport class ProviderDouble implements DerivationProvider {\\n    66\\t  private failNextScript: FailScript | null = null;\\n    67\\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\\n    68\\t  private readonly delayByOp = new Map<ProviderOpName, number>();\\n    69\\t  private capturing = false;\\n    70\\t  private readonly captured: CapturedInput[] = [];\\n    71\\t\\n    72\\t  // Fail the next n calls to any operation, then succeed.\\n    73\\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\\n    74\\t    this.failNextScript = {\\n    75\\t      remaining: n,\\n    76\\t      retryable: opts?.retryable ?? true,\\n    77\\t      reason: opts?.reason ?? \\\"scripted failure (failNext)\\\",\\n    78\\t    };\\n    79\\t  }\\n    80\\t\\n    81\\t  // Fail the next n calls to one operation (kind names and op names both\\n    82\\t  // accepted). retryable: false scripts a terminal failure.\\n    83\\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\\n    84\\t    const op = resolveOpName(kind);\\n    85\\t    this.failByOp.set(op, {\\n    86\\t      remaining: n,\\n    87\\t      retryable: opts?.retryable ?? true,\\n    88\\t      reason: opts?.reason ?? `scripted failure (${op})`,\\n    89\\t    });\\n    90\\t  }\\n    91\\t\\n    92\\t  delayKind(kind: string, ms: number): void {\\n    93\\t    this.delayByOp.set(resolveOpName(kind), ms);\\n    94\\t  }\\n    95\\t\\n    96\\t  // Start capturing inputs; returns the live log (appended in call order).\\n    97\\t  captureInputs(): readonly CapturedInput[] {\\n    98\\t    this.capturing = true;\\n    99\\t    return this.captured;\\n   100\\t  }\\n   101\\t\\n   102\\t  private async run(\\n   103\\t    op: ProviderOpName,\\n   104\\t    input: unknown,\\n   105\\t    text: string,\\n   106\\t    suffix = \\\"\\\",\\n   107\\t  ): Promise<ProviderResult> {\\n   108\\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\\n   109\\t    const delay = this.delayByOp.get(op);\\n   110\\t    if (delay !== undefined && delay > 0) {\\n   111\\t      await new Promise((resolve) => setTimeout(resolve, delay));\\n   112\\t    }\\n   113\\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\\n   114\\t    for (const script of scripts) {\\n   115\\t      if (script !== null && script.remaining > 0) {\\n   116\\t        script.remaining -= 1;\\n   117\\t        return { ok: false, retryable: script.retryable, reason: script.reason };\\n   118\\t      }\\n   119\\t    }\\n   120\\t    // Output format shared with src/providers/deterministic.ts so the double\\n   121\\t    // and the registry's \\\"deterministic\\\" provider produce byte-identical\\n   122\\t    // artifacts across in-process and spawned runs; the chunk-summary\\n   123\\t    // receipt/outcome suffixes (AC-3.8) come from the same shared helpers.\\n   124\\t    return { ok: true, text: deterministicText(op, input, text) + suffix };\\n   125\\t  }\\n   126\\t\\n   127\\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\\n   128\\t    return this.run(\\\"smoothPrompt\\\", i, i.text);\\n   129\\t  }\\n   130\\t\\n   131\\t  summarizeToolResult(i: {\\n   132\\t    toolName: string;\\n   133\\t    content: string;\\n   134\\t    outcome?: ToolOutcome;\\n   135\\t    targetTokens?: number;\\n   136\\t    guidance?: string;\\n   137\\t  }): Promise<ProviderResult> {\\n   138\\t    return this.run(\\\"summarizeToolResult\\\", i, i.content);\\n   139\\t  }\\n   140\\t\\n   141\\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\\n   142\\t    return this.run(\\\"composeTurnRendering\\\", i, i.parts.map((p) => p.text).join(\\\" | \\\"));\\n   143\\t  }\\n   144\\t\\n   145\\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\\n   146\\t    return this.run(\\\"projectLowerBand\\\", i, i.rendering);\\n   147\\t  }\\n   148\\t\\n   149\\t  summarizeChunkDetailed(i: {\\n   150\\t    memberProjections: string[];\\n   151\\t    memberReceipts?: ToolRunReceipt[][];\\n   152\\t  }): Promise<ProviderResult> {\\n   153\\t    return this.run(\\n   154\\t      \\\"summarizeChunkDetailed\\\",\\n   155\\t      i,\\n   156\\t      i.memberProjections.join(\\\" | \\\"),\\n   157\\t      deterministicReceiptsSuffix(i.memberReceipts),\\n   158\\t    );\\n   159\\t  }\\n   160\\t\\n   161\\t  summarizeChunkBrief(i: {\\n   162\\t    memberProjections: string[];\\n   163\\t    memberOutcomes?: ToolOutcome[][];\\n   164\\t  }): Promise<ProviderResult> {\\n   165\\t    return this.run(\\n   166\\t      \\\"summarizeChunkBrief\\\",\\n   167\\t      i,\\n   168\\t      i.memberProjections.join(\\\" | \\\"),\\n   169\\t      deterministicOutcomesSuffix(i.memberOutcomes),\\n   170\\t    );\\n   171\\t  }\\n   172\\t}\\n   173\\t\\n   174\\texport function createProviderDouble(): ProviderDouble {\\n   175\\t  return new ProviderDouble();\\n   176\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/streams/004-verify.stdout.log:96:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_46\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/storage.ts | sed -n '1,190p' && nl -ba packages/lhc/src/tech-utils/logging/index.ts\\\"\",\"aggregated_output\":\"     1\\timport { DatabaseSync } from \\\"node:sqlite\\\";\\n     2\\t\\n     3\\texport interface Migration {\\n     4\\t  version: number; // 1-based, strictly increasing\\n     5\\t  statements: readonly string[];\\n     6\\t}\\n     7\\t\\n     8\\tconst databasePaths = new WeakMap<DatabaseSync, string>();\\n     9\\t\\n    10\\texport function openDatabase(path: string): DatabaseSync {\\n    11\\t  const db = new DatabaseSync(path);\\n    12\\t  databasePaths.set(db, path);\\n    13\\t  db.exec(\\\"PRAGMA journal_mode = WAL;\\\");\\n    14\\t  db.exec(\\\"PRAGMA foreign_keys = ON;\\\");\\n    15\\t  db.exec(\\\"PRAGMA busy_timeout = 5000;\\\");\\n    16\\t  db.exec(\\\"PRAGMA synchronous = NORMAL;\\\");\\n    17\\t  return db;\\n    18\\t}\\n    19\\t\\n    20\\texport function databasePathFor(db: DatabaseSync): string | undefined {\\n    21\\t  return databasePaths.get(db);\\n    22\\t}\\n    23\\t\\n    24\\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\\n    25\\t// on the existing work_item table, the derivation state table, the chunk\\n    26\\t// tables, and the projection-level delete stamps. The whole epic's schema\\n    27\\t// lands in one version — behavior arrives story by story. Assembled into the\\n    28\\t// thread-file migration history by threads/internal/create.ts.\\n    29\\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\\n    30\\t  // claim mechanics on the existing table (DD-1: no disposition column —\\n    31\\t  // queue rows are live work only; terminal rows are deleted and their\\n    32\\t  // outcomes reported in-memory; durable outcome state lives on derivation)\\n    33\\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\\n    34\\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\\n    35\\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\\n    36\\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\\n    37\\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\\n    38\\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\\n    39\\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\\n    40\\t  // inside an index definition, so the index covers the two real columns and\\n    41\\t  // claimNext's ORDER BY rowid walks the head as before.\\n    42\\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\\n    43\\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\\n    44\\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\\n    45\\t  // call id — never a block scan (anti-shim requirement).\\n    46\\t  `CREATE INDEX idx_message_block_tool_call_id\\n    47\\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\\n    48\\t  `CREATE TABLE derived_form (\\n    49\\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\\n    50\\t    subject_id   TEXT NOT NULL,\\n    51\\t    form         TEXT NOT NULL,\\n    52\\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\\n    53\\t    content      TEXT,\\n    54\\t    reason       TEXT,\\n    55\\t    metadata     TEXT,\\n    56\\t    source_version INTEGER NOT NULL DEFAULT 1,\\n    57\\t    gaps         TEXT,\\n    58\\t    derived_at   TEXT,\\n    59\\t    PRIMARY KEY (subject_kind, subject_id, form)\\n    60\\t  );`,\\n    61\\t  `CREATE TABLE chunk (\\n    62\\t    chunk_id     TEXT PRIMARY KEY,\\n    63\\t    chunk_order  INTEGER NOT NULL UNIQUE,\\n    64\\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\\n    65\\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\\n    66\\t  );`,\\n    67\\t  `CREATE TABLE chunk_member (\\n    68\\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\\n    69\\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\\n    70\\t    member_idx INTEGER NOT NULL,\\n    71\\t    PRIMARY KEY (chunk_id, member_idx)\\n    72\\t  );`,\\n    73\\t  // projection-level delete (the record keeps everything; reads filter)\\n    74\\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\\n    75\\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\\n    76\\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\\n    77\\t  // UPDATE-only completion finds them (row missing must mean deleted).\\n    78\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    79\\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\\n    80\\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\\n    81\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    82\\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\\n    83\\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\\n    84\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    85\\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\\n    86\\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\\n    87\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    88\\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\\n    89\\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\\n    90\\t];\\n    91\\t\\n    92\\t// Epic 03's single migration (tech design §Storage): the thread-view\\n    93\\t// snapshot tables and the visibility boundary, living beside the record they\\n    94\\t// render so a thread file stays self-contained and snapshot-portable.\\n    95\\t// Singletons are CHECK-enforced structurally: one active view, one boundary\\n    96\\t// row per thread. Assembled into the thread-file migration history by\\n    97\\t// threads/internal/create.ts, like v5.\\n    98\\texport const MIGRATION_V6_STATEMENTS: readonly string[] = [\\n    99\\t  `CREATE TABLE thread_view (\\n   100\\t    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\\n   101\\t    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\\n   102\\t    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\\n   103\\t    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\\n   104\\t    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\\n   105\\t    profile_name TEXT,                   -- null when explicit params\\n   106\\t    config_json TEXT NOT NULL,           -- resolved bound + percentages\\n   107\\t    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, derivationUsed, degraded}\\n   108\\t    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\\n   109\\t    source_state_json TEXT NOT NULL      -- {maxEventOrder, derivationCounts} the compact saw — receipt/debug\\n   110\\t  );`,\\n   111\\t  `CREATE TABLE thread_view_band (\\n   112\\t    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\\n   113\\t    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\\n   114\\t    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\\n   115\\t    token_count INTEGER NOT NULL,\\n   116\\t    PRIMARY KEY (view_id, band)\\n   117\\t  );`,\\n   118\\t  `CREATE TABLE view_boundary (\\n   119\\t    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\\n   120\\t    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\\n   121\\t    updated_at TEXT NOT NULL\\n   122\\t  );`,\\n   123\\t  // Seed at position 0 (everything full) — the boundary row exists from\\n   124\\t  // migration on, so the advance and the compact reset are UPDATE-only.\\n   125\\t  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\\n   126\\t    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\\n   127\\t];\\n   128\\t\\n   129\\t// Epic 06 Story 0's single migration (tech design §DD-1, §DD-5):\\n   130\\t// 1. Rename derived_form table to derivation and column 'form' to 'derivation_type'\\n   131\\t// 2. Create the log table for fallback events and diagnostics\\n   132\\t// Singletons are CHECK-enforced structurally: one log entry per recorded event.\\n   133\\t// Assembled into the thread-file migration history by threads/internal/create.ts,\\n   134\\t// like v5 and v6.\\n   135\\texport const MIGRATION_V7_STATEMENTS: readonly string[] = [\\n   136\\t  // Rename table and column for derivation vocabulary (DD-1)\\n   137\\t  `ALTER TABLE derived_form RENAME TO derivation;`,\\n   138\\t  // SQLite doesn't support ALTER COLUMN directly, so we recreate the table\\n   139\\t  `CREATE TABLE derivation_new (\\n   140\\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\\n   141\\t    subject_id   TEXT NOT NULL,\\n   142\\t    derivation_type TEXT NOT NULL,\\n   143\\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\\n   144\\t    content      TEXT,\\n   145\\t    reason       TEXT,\\n   146\\t    metadata     TEXT,\\n   147\\t    source_version INTEGER NOT NULL DEFAULT 1,\\n   148\\t    gaps         TEXT,\\n   149\\t    derived_at   TEXT,\\n   150\\t    PRIMARY KEY (subject_kind, subject_id, derivation_type)\\n   151\\t  );`,\\n   152\\t  `INSERT INTO derivation_new SELECT subject_kind, subject_id, form, state, content, reason, metadata, source_version, gaps, derived_at FROM derivation;`,\\n   153\\t  `DROP TABLE derivation;`,\\n   154\\t  `ALTER TABLE derivation_new RENAME TO derivation;`,\\n   155\\t  `UPDATE thread_view\\n   156\\t     SET arrangement_json = replace(arrangement_json, '\\\"formUsed\\\"', '\\\"derivationUsed\\\"')\\n   157\\t     WHERE arrangement_json LIKE '%\\\"formUsed\\\"%';`,\\n   158\\t  `UPDATE thread_view\\n   159\\t     SET source_state_json = replace(source_state_json, '\\\"formCounts\\\"', '\\\"derivationCounts\\\"')\\n   160\\t     WHERE source_state_json LIKE '%\\\"formCounts\\\"%';`,\\n   161\\t  // Create log table (DD-5)\\n   162\\t  `CREATE TABLE log (\\n   163\\t    log_id INTEGER PRIMARY KEY AUTOINCREMENT,\\n   164\\t    level TEXT NOT NULL CHECK (level IN ('info','warning','error')),\\n   165\\t    message TEXT NOT NULL,\\n   166\\t    derivation_type TEXT,\\n   167\\t    subject_id TEXT,\\n   168\\t    reason TEXT,\\n   169\\t    floor_used TEXT,\\n   170\\t    recorded_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\\n   171\\t  );`,\\n   172\\t  // Indexes for log queries by actionable fields\\n   173\\t  `CREATE INDEX idx_log_level ON log (level);`,\\n   174\\t  `CREATE INDEX idx_log_derivation_type ON log (derivation_type);`,\\n   175\\t  `CREATE INDEX idx_log_subject_id ON log (subject_id);`,\\n   176\\t  `CREATE INDEX idx_log_reason ON log (reason);`,\\n   177\\t];\\n   178\\t\\n   179\\t// Epic 06 Story 2: tool calls render as recorded, so the old\\n   180\\t// tool_call_summary derivation/work rows are no longer valid work.\\n   181\\texport const MIGRATION_V8_STATEMENTS: readonly string[] = [\\n   182\\t  `DELETE FROM work_item WHERE kind = 'tool_call_summary';`,\\n   183\\t  `DELETE FROM derivation WHERE subject_kind = 'message' AND derivation_type = 'tool_call_summary';`,\\n   184\\t];\\n   185\\t\\n   186\\texport function getSchemaVersion(db: DatabaseSync): number {\\n   187\\t  const row = db.prepare(\\\"PRAGMA user_version\\\").get() as\\n   188\\t    | { user_version: number | bigint }\\n   189\\t    | undefined;\\n   190\\t  return Number(row?.user_version ?? 0);\\n     1\\t// The logging surface: a domain-blind tech-util for recording fallback\\n     2\\t// events and diagnostics. LHC internals and the host extension both write\\n     3\\t// through this surface (AC-5.2). Writes are fail-soft and never share the\\n     4\\t// caller's transaction (AC-5.5). Queries return entries by actionable fields\\n     5\\t// (AC-5.4).\\n     6\\timport type { DatabaseSync, SQLInputValue } from \\\"node:sqlite\\\";\\n     7\\timport type { DerivationType } from \\\"../../shared/derivation.js\\\";\\n     8\\timport type { OperationContext } from \\\"../../shared/context.js\\\";\\n     9\\timport { databasePathFor, openDatabase } from \\\"../../shared/storage.js\\\";\\n    10\\t\\n    11\\texport type LogLevel = \\\"info\\\" | \\\"warning\\\" | \\\"error\\\";\\n    12\\t\\n    13\\texport interface LogEntry {\\n    14\\t  level: LogLevel;\\n    15\\t  message: string;\\n    16\\t  derivationType?: DerivationType;\\n    17\\t  subjectId?: string;\\n    18\\t  reason?: string; // e.g. \\\"not_ready\\\" | \\\"failed_floor\\\"\\n    19\\t  floorUsed?: string; // for fallback events\\n    20\\t}\\n    21\\t\\n    22\\t// Stored log entry as read from the database\\n    23\\texport interface StoredLogEntry {\\n    24\\t  logId: number;\\n    25\\t  level: LogLevel;\\n    26\\t  message: string;\\n    27\\t  derivationType: string | null;\\n    28\\t  subjectId: string | null;\\n    29\\t  reason: string | null;\\n    30\\t  floorUsed: string | null;\\n    31\\t  recordedAt: string;\\n    32\\t}\\n    33\\t\\n    34\\texport interface LogQuery {\\n    35\\t  level?: LogLevel;\\n    36\\t  derivationType?: DerivationType;\\n    37\\t  subjectId?: string;\\n    38\\t  reason?: string;\\n    39\\t}\\n    40\\t\\n    41\\t// Write a log entry. Fail-soft: never throws to the caller, never shares\\n    42\\t// the caller's transaction. A logging failure is contained and does not\\n    43\\t// affect the operation that produced the log entry (AC-5.5).\\n    44\\texport function writeLog(ctx: OperationContext, entry: LogEntry): void {\\n    45\\t  const path = databasePathFor(ctx.db);\\n    46\\t  if (path === undefined) return;\\n    47\\t  let db: DatabaseSync | undefined;\\n    48\\t  try {\\n    49\\t    db = openDatabase(path);\\n    50\\t    db.prepare(\\n    51\\t      `INSERT INTO log (level, message, derivation_type, subject_id, reason, floor_used)\\n    52\\t       VALUES (?, ?, ?, ?, ?, ?)`,\\n    53\\t    ).run(\\n    54\\t      entry.level,\\n    55\\t      entry.message,\\n    56\\t      entry.derivationType ?? null,\\n    57\\t      entry.subjectId ?? null,\\n    58\\t      entry.reason ?? null,\\n    59\\t      entry.floorUsed ?? null,\\n    60\\t    );\\n    61\\t  } catch {\\n    62\\t    // Fail-soft: drop the log entry but do not propagate the error to the caller\\n    63\\t    // (AC-5.5). The operation that produced this log entry continues unchanged.\\n    64\\t  } finally {\\n    65\\t    db?.close();\\n    66\\t  }\\n    67\\t}\\n    68\\t\\n    69\\t// Query log entries by actionable fields (AC-5.4). Returns all matching\\n    70\\t// entries in descending order of recorded_at (newest first).\\n    71\\texport function queryLog(db: DatabaseSync, q: LogQuery): StoredLogEntry[] {\\n    72\\t  const conditions: string[] = [];\\n    73\\t  const params: SQLInputValue[] = [];\\n    74\\t\\n    75\\t  if (q.level !== undefined) {\\n    76\\t    conditions.push(\\\"level = ?\\\");\\n    77\\t    params.push(q.level);\\n    78\\t  }\\n    79\\t  if (q.derivationType !== undefined) {\\n    80\\t    conditions.push(\\\"derivation_type = ?\\\");\\n    81\\t    params.push(q.derivationType);\\n    82\\t  }\\n    83\\t  if (q.subjectId !== undefined) {\\n    84\\t    conditions.push(\\\"subject_id = ?\\\");\\n    85\\t    params.push(q.subjectId);\\n    86\\t  }\\n    87\\t  if (q.reason !== undefined) {\\n    88\\t    conditions.push(\\\"reason = ?\\\");\\n    89\\t    params.push(q.reason);\\n    90\\t  }\\n    91\\t\\n    92\\t  const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(\\\" AND \\\")}` : \\\"\\\";\\n    93\\t  const sql = `\\n    94\\t    SELECT log_id, level, message, derivation_type, subject_id, reason, floor_used, recorded_at\\n    95\\t    FROM log\\n    96\\t    ${whereClause}\\n    97\\t    ORDER BY recorded_at DESC\\n    98\\t  `;\\n    99\\t\\n   100\\t  const rows = db.prepare(sql).all(...params) as unknown as Array<{\\n   101\\t    log_id: number;\\n   102\\t    level: string;\\n   103\\t    message: string;\\n   104\\t    derivation_type: string | null;\\n   105\\
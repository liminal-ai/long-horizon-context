\t  // open chunk (accumulation rule) and then the incoming turn's own chunk\\n    23\\t  // (max rule) — a turn ≥ max arriving behind an open chunk closes both.\\n    24\\t  closedChunkIds: string[];\\n    25\\t  // An explicitly rebuilt turn keeps its placement (membership shrinks only\\n    26\\t  // through Story 6's sanctioned mutation, never re-cuts): a turn already a\\n    27\\t  // member is left exactly where it is and nothing closes.\\n    28\\t  alreadyPlaced: boolean;\\n    29\\t}\\n    30\\t\\n    31\\tinterface OpenChunkRow {\\n    32\\t  chunk_id: string;\\n    33\\t  accumulated_projected_tokens: number | bigint;\\n    34\\t}\\n    35\\t\\n    36\\tfunction memberCount(db: DatabaseSync, chunkId: string): number {\\n    37\\t  const row = db\\n    38\\t    .prepare(`SELECT COUNT(*) AS n FROM chunk_member WHERE chunk_id = ?`)\\n    39\\t    .get(chunkId) as unknown as { n: number | bigint };\\n    40\\t  return Number(row.n);\\n    41\\t}\\n    42\\t\\n    43\\tfunction closeChunk(db: DatabaseSync, chunkId: string): void {\\n    44\\t  db.prepare(`UPDATE chunk SET status = 'closed' WHERE chunk_id = ?`).run(chunkId);\\n    45\\t}\\n    46\\t\\n    47\\tfunction openNextChunk(db: DatabaseSync): string {\\n    48\\t  const row = db.prepare(`SELECT MAX(chunk_order) AS max_order FROM chunk`).get() as\\n    49\\t    | { max_order: number | bigint | null }\\n    50\\t    | undefined;\\n    51\\t  const order = Number(row?.max_order ?? 0) + 1;\\n    52\\t  const chunkId = `c${order}`;\\n    53\\t  db.prepare(\\n    54\\t    `INSERT INTO chunk (chunk_id, chunk_order, status, accumulated_projected_tokens)\\n    55\\t     VALUES (?, ?, 'open', 0)`,\\n    56\\t  ).run(chunkId, order);\\n    57\\t  return chunkId;\\n    58\\t}\\n    59\\t\\n    60\\t// The close policy, golden cases exact (DD-9): when the open chunk's\\n    61\\t// accumulated count plus the incoming turn's would reach the target\\n    62\\t// (inclusive — equality closes), the chunk closes holding its current\\n    63\\t// members and the incoming turn opens the next chunk; a single projection\\n    64\\t// ≥ max closes its own chunk immediately. An empty open chunk always accepts\\n    65\\t// the incoming turn — a chunk never closes empty.\\n    66\\texport function placeTurn(\\n    67\\t  db: DatabaseSync,\\n    68\\t  turnId: string,\\n    69\\t  projectedTokens: number,\\n    70\\t  policy: ChunkPolicy,\\n    71\\t): PlacementResult {\\n    72\\t  const existing = db\\n    73\\t    .prepare(`SELECT chunk_id, member_idx FROM chunk_member WHERE turn_id = ?`)\\n    74\\t    .get(turnId) as unknown as { chunk_id: string; member_idx: number | bigint } | undefined;\\n    75\\t  if (existing !== undefined) {\\n    76\\t    return {\\n    77\\t      chunkId: existing.chunk_id,\\n    78\\t      memberIdx: Number(existing.member_idx),\\n    79\\t      closedChunkIds: [],\\n    80\\t      alreadyPlaced: true,\\n    81\\t    };\\n    82\\t  }\\n    83\\t\\n    84\\t  const closedChunkIds: string[] = [];\\n    85\\t  let open = db\\n    86\\t    .prepare(\\n    87\\t      `SELECT chunk_id, accumulated_projected_tokens FROM chunk\\n    88\\t       WHERE status = 'open' ORDER BY chunk_order DESC LIMIT 1`,\\n    89\\t    )\\n    90\\t    .get() as unknown as OpenChunkRow | undefined;\\n    91\\t\\n    92\\t  if (\\n    93\\t    open !== undefined &&\\n    94\\t    memberCount(db, open.chunk_id) > 0 &&\\n    95\\t    Number(open.accumulated_projected_tokens) + projectedTokens >= policy.targetProjectedTokens\\n    96\\t  ) {\\n    97\\t    // Crossing closes *without* the incoming turn — the v1 bug's fix: the\\n    98\\t    // decision weighs accumulated + incoming, and the incoming turn starts\\n    99\\t    // the next chunk (AC-3.6).\\n   100\\t    closeChunk(db, open.chunk_id);\\n   101\\t    closedChunkIds.push(open.chunk_id);\\n   102\\t    open = undefined;\\n   103\\t  }\\n   104\\t\\n   105\\t  const chunkId = open?.chunk_id ?? openNextChunk(db);\\n   106\\t  const memberIdx = memberCount(db, chunkId);\\n   107\\t  db.prepare(`INSERT INTO chunk_member (chunk_id, turn_id, member_idx) VALUES (?, ?, ?)`).run(\\n   108\\t    chunkId,\\n   109\\t    turnId,\\n   110\\t    memberIdx,\\n   111\\t  );\\n   112\\t  db.prepare(\\n   113\\t    `UPDATE chunk SET accumulated_projected_tokens = accumulated_projected_tokens + ?\\n   114\\t     WHERE chunk_id = ?`,\\n   115\\t  ).run(projectedTokens, chunkId);\\n   116\\t\\n   117\\t  if (projectedTokens >= policy.maxProjectedTokens) {\\n   118\\t    // Max rule (AC-3.7): the projection alone meets the maximum, so the\\n   119\\t    // turn's chunk closes immediately, whatever it holds.\\n   120\\t    closeChunk(db, chunkId);\\n   121\\t    closedChunkIds.push(chunkId);\\n   122\\t  }\\n   123\\t\\n   124\\t  return { chunkId, memberIdx, closedChunkIds, alreadyPlaced: false };\\n   125\\t}\\n   126\\t\\n   127\\t// Closing queues the two summary kinds as two work items with independent\\n   128\\t// retry, states, and re-queue (AC-3.8); both enqueues ride the caller's\\n   129\\t// ambient transaction — the completion commit — per DD-5.\\n   130\\texport function enqueueChunkSummaries(\\n   131\\t  ctx: OperationContext,\\n   132\\t  chunkId: string,\\n   133\\t): WorkItemRecord[] {\\n   134\\t  return ([\\\"chunk_summary_detailed\\\", \\\"chunk_summary_brief\\\"] as const).map((kind) =>\\n   135\\t    enqueue(ctx, {\\n   136\\t      owner: \\\"turns\\\",\\n   137\\t      kind,\\n   138\\t      sourceRef: { chunkId },\\n   139\\t      derivations: [{ subjectKind: \\\"chunk\\\", subjectId: chunkId, derivationType: kind }],\\n   140\\t    }),\\n   141\\t  );\\n   142\\t}\\n   143\\t\\n   144\\t// Placement read-back for the turns surface (AC-3.5): chunkId + memberIdx by\\n   145\\t// turn, one query, stored values only.\\n   146\\texport function readPlacements(\\n   147\\t  db: DatabaseSync,\\n   148\\t): Map<string, { chunkId: string; memberIdx: number }> {\\n   149\\t  const rows = db\\n   150\\t    .prepare(`SELECT turn_id, chunk_id, member_idx FROM chunk_member`)\\n   151\\t    .all() as unknown as Array<{\\n   152\\t    turn_id: string;\\n   153\\t    chunk_id: string;\\n   154\\t    member_idx: number | bigint;\\n   155\\t  }>;\\n   156\\t  const byTurn = new Map<string, { chunkId: string; memberIdx: number }>();\\n   157\\t  for (const row of rows) {\\n   158\\t    byTurn.set(row.turn_id, { chunkId: row.chunk_id, memberIdx: Number(row.member_idx) });\\n   159\\t  }\\n   160\\t  return byTurn;\\n   161\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\timport { existsSync } from \\\"node:fs\\\";\\n     2\\timport { runInTransaction, type OperationContext } from \\\"../../shared/context.js\\\";\\n     3\\timport type {\\n     4\\t  DerivationType,\\n     5\\t  DerivationReportEntry,\\n     6\\t  WorkHandler,\\n     7\\t} from \\\"../../shared/derivation.js\\\";\\n     8\\timport { storageFailure, type ErrorResult, type OpResult } from \\\"../../shared/errors.js\\\";\\n     9\\timport {\\n    10\\t  enqueue,\\n    11\\t  hasLiveItem,\\n    12\\t  listItems,\\n    13\\t  type EnqueueDerivationTarget,\\n    14\\t  type WorkItemRecord,\\n    15\\t  type WorkKind,\\n    16\\t  type WorkSourceRef,\\n    17\\t} from \\\"../../tech-utils/work-queue/index.js\\\";\\n    18\\timport type { EventKind } from \\\"../intake-stream/index.js\\\";\\n    19\\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \\\"../threads/index.js\\\";\\n    20\\timport { transition } from \\\"./internal/state-machine.js\\\";\\n    21\\t\\n    22\\t// The pure rule table, re-exported for the golden supplemental suite (the\\n    23\\t// test plan's one sanctioned direct entry besides the tokenizer); production\\n    24\\t// callers go through applyEvent.\\n    25\\texport { transition, type TurnEffect, type TurnState } from \\\"./internal/state-machine.js\\\";\\n    26\\timport type { Derivation } from \\\"../../shared/derivation.js\\\";\\n    27\\timport {\\n    28\\t  compactChunkMaterialFromStoredMembers,\\n    29\\t  type CompactChunkMaterial,\\n    30\\t} from \\\"./internal/chunk-recovery.js\\\";\\n    31\\timport { turnWorkHandlers } from \\\"./internal/derive.js\\\";\\n    32\\timport {\\n    33\\t  readChunkRows,\\n    34\\t  readOwnedForms,\\n    35\\t  readTurnFormRow,\\n    36\\t  reportTurnForms,\\n    37\\t} from \\\"./internal/forms.js\\\";\\n    38\\timport {\\n    39\\t  applyTurnDeleteCascade,\\n    40\\t  type MutationResult,\\n    41\\t} from \\\"../messages/index.js\\\";\\n    42\\timport {\\n    43\\t  closeTurn,\\n    44\\t  insertOpenTurn,\\n    45\\t  markTurnDeleted,\\n    46\\t  nextTurnOrder,\\n    47\\t  readMutableTurn,\\n    48\\t  readTurns,\\n    49\\t  selectOpenTurnIds,\\n    50\\t} from \\\"./internal/store.js\\\";\\n    51\\t\\n    52\\texport interface TurnRecord {\\n    53\\t  turnId: string;\\n    54\\t  status: \\\"open\\\" | \\\"closed\\\";\\n    55\\t  memberMessageIds: string[];\\n    56\\t  openedAtEventOrder: number;\\n    57\\t  closedAtEventOrder?: number;\\n    58\\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\\n    59\\t  // derivation placed it — stored values read back, never recomputed.\\n    60\\t  chunkId?: string;\\n    61\\t  memberIdx?: number;\\n    62\\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\\n    63\\t  // present only when rows exist — a closed turn carries them from the\\n    64\\t  // moment its derivation queues. Stored state returned verbatim, mirroring\\n    65\\t  // the message read's forms key; reads degrade, never block.\\n    66\\t  derivations?: Derivation[];\\n    67\\t}\\n    68\\t\\n    69\\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\\n    70\\t// record with live membership and its summary forms' states attached —\\n    71\\t// the chunk leg of \\\"reading a message, turn, or chunk returns the record\\n    72\\t// with form states\\\".\\n    73\\texport interface ChunkRecord {\\n    74\\t  chunkId: string;\\n    75\\t  chunkOrder: number;\\n    76\\t  status: \\\"open\\\" | \\\"closed\\\";\\n    77\\t  accumulatedProjectedTokens: number;\\n    78\\t  memberTurnIds: string[];\\n    79\\t  derivations?: Derivation[];\\n    80\\t}\\n    81\\t\\n    82\\texport interface TurnTransitionOutcome {\\n    83\\t  // Transitions in occurrence order: a close_then_open reports the close\\n    84\\t  // first, then the open, exactly as the batch result surfaces them.\\n    85\\t  transitions: Array<{ action: \\\"opened\\\" | \\\"closed\\\"; turnId: string }>;\\n    86\\t  // Turn state after the transition — the stamp for this event's message.\\n    87\\t  // Prompts see the turn they just opened (transition first, then stamp);\\n    88\\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\\n    89\\t  openTurnId: string | null;\\n    90\\t  // Work queued by this transition: one turn_derivation item per closed\\n    91\\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\\n    92\\t  queuedWork: WorkItemRecord[];\\n    93\\t}\\n    94\\t\\n    95\\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\\n    96\\t// IMMEDIATE and before any event is processed. Only the batch pipeline\\n    97\\t// writes turn state, so more than one open turn means external interference.\\n    98\\texport function listOpenTurnIds(ctx: OperationContext): string[] {\\n    99\\t  return selectOpenTurnIds(ctx.db);\\n   100\\t}\\n   101\\t\\n   102\\t// Closing a turn — by either close path — durably queues that turn's\\n   103\\t// derivation work in the same transaction (AC-3.6): the close update and the\\n   104\\t// work item commit or roll back together.\\n   105\\tfunction closeTurnAndQueueWork(\\n   106\\t  ctx: OperationContext,\\n   107\\t  turnId: string,\\n   108\\t  eventOrder: number,\\n   109\\t): WorkItemRecord {\\n   110\\t  closeTurn(ctx.db, turnId, eventOrder);\\n   111\\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\\n   112\\t  // lands the rendering and the lower-band projection as independent rows;\\n   113\\t  // both go pending with the enqueue (DD-5).\\n   114\\t  return enqueue(ctx, {\\n   115\\t    owner: \\\"turns\\\",\\n   116\\t    kind: \\\"turn_derivation\\\",\\n   117\\t    sourceRef: { turnId },\\n   118\\t    derivations: [\\n   119\\t      { subjectKind: \\\"turn\\\", subjectId: turnId, derivationType: \\\"turn_rendering\\\" },\\n   120\\t      { subjectKind: \\\"turn\\\", subjectId: turnId, derivationType: \\\"lower_band_projection\\\" },\\n   121\\t    ],\\n   122\\t  });\\n   123\\t}\\n   124\\t\\n   125\\t// Turn-owned work handlers, merged into the SDK's dispatch map at\\n   126\\t// construction (DD-6): turn derivation and the two chunk summaries.\\n   127\\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\\n   128\\t  turnWorkHandlers;\\n   129\\t\\n   130\\t// Cross-domain surface, called by intake-stream inside the batch transaction\\n   131\\t// for every recorded event. Synchronous and throwing by design, like\\n   132\\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\\n   133\\texport function applyEvent(\\n   134\\t  ctx: OperationContext,\\n   135\\t  eventKind: EventKind,\\n   136\\t  eventOrder: number,\\n   137\\t): TurnTransitionOutcome {\\n   138\\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\\n   139\\t  const effect = transition({ openTurnId }, eventKind);\\n   140\\t  switch (effect.kind) {\\n   141\\t    case \\\"none\\\":\\n   142\\t      return { transitions: [], openTurnId, queuedWork: [] };\\n   143\\t    case \\\"open\\\": {\\n   144\\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\\n   145\\t      return {\\n   146\\t        transitions: [{ action: \\\"opened\\\", turnId }],\\n   147\\t        openTurnId: turnId,\\n   148\\t        queuedWork: [],\\n   149\\t      };\\n   150\\t    }\\n   151\\t    case \\\"close\\\": {\\n   152\\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\\n   153\\t      return {\\n   154\\t        transitions: [{ action: \\\"closed\\\", turnId: openTurnId as string }],\\n   155\\t        openTurnId: null,\\n   156\\t        queuedWork: [item],\\n   157\\t      };\\n   158\\t    }\\n   159\\t    case \\\"close_then_open\\\": {\\n   160\\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\\n   161\\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\\n   162\\t      return {\\n   163\\t        transitions: [\\n   164\\t          { action: \\\"closed\\\", turnId: openTurnId as string },\\n   165\\t          { action: \\\"opened\\\", turnId },\\n   166\\t        ],\\n   167\\t        openTurnId: turnId,\\n   168\\t        queuedWork: [item],\\n   169\\t      };\\n   170\\t    }\\n   171\\t  }\\n   172\\t}\\n   173\\t\\n   174\\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\\n   175\\t  return {\\n   176\\t    ok: false,\\n   177\\t    error: {\\n   178\\t      errorClass: \\\"caller_error\\\",\\n   179\\t      code: \\\"thread_not_found\\\",\\n   180\\t      reason: `no thread file exists at ${filePath}`,\\n   181\\t    },\\n   182\\t  };\\n   183\\t}\\n   184\\t\\n   185\\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\\n   186\\t  const resolved = await resolveThreadRef(thread);\\n   187\\t  if (!resolved.ok) return resolved;\\n   188\\t  const { filePath } = resolved.value;\\n   189\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   190\\t\\n   191\\t  const opened = openThreadDatabase(filePath);\\n   192\\t  if (!opened.ok) return opened;\\n   193\\t  const db = opened.value;\\n   194\\t  try {\\n   195\\t    // Form read-back rides the turn read (AC-4.7): each record carries its\\n   196\\t    // stored derived forms, attached from one grouped query — mirroring the\\n   197\\t    // message read's production path for \\\"readable alongside the record\\\".\\n   198\\t    const formsByTurn = readOwnedForms(db, \\\"turn\\\");\\n   199\\t    const records = readTurns(db).map((record) => {\\n   200\\t      const derivations = formsByTurn.get(record.turnId);\\n   201\\t      return derivations === undefined ? record : { ...record, derivations };\\n   202\\t    });\\n   203\\t    return { ok: true, value: records };\\n   204\\t  } catch (cause) {\\n   205\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n   206\\t    return storageFailure(`turn read-back failed: ${reason}`);\\n   207\\t  } finally {\\n   208\\t    db.close();\\n   209\\t  }\\n   210\\t}\\n   211\\t\\n   212\\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\\n   213\\t// returns stored records whatever the forms' states — reads degrade, never\\n   214\\t// block. Forms attach only where rows exist (a freshly opened chunk has no\\n   215\\t// summary rows until close queues them).\\n   216\\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\\n   217\\t  const resolved = await resolveThreadRef(thread);\\n   218\\t  if (!resolved.ok) return resolved;\\n   219\\t  const { filePath } = resolved.value;\\n   220\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   221\\t\\n   222\\t  const opened = openThreadDatabase(filePath);\\n   223\\t  if (!opened.ok) return opened;\\n   224\\t  const db = opened.value;\\n   225\\t  try {\\n   226\\t    const formsByChunk = readOwnedForms(db, \\\"chunk\\\");\\n   227\\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\\n   228\\t      const derivations = formsByChunk.get(row.chunkId);\\n   229\\t      return derivations === undefined ? row : { ...row, derivations };\\n   230\\t    });\\n   231\\t    return { ok: true, value: records };\\n   232\\t  } catch (cause) {\\n   233\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n   234\\t    return storageFailure(`chunk read-back failed: ${reason}`);\\n   235\\t  } finally {\\n   236\\t    db.close();\\n   237\\t  }\\n   238\\t}\\n   239\\t\\n   240\\texport async function listQueuedWork(\\n   241\\t  thread: ThreadRef,\\n   242\\t): Promise<OpResult<WorkItemRecord[]>> {\\n   243\\t  const resolved = await resolveThreadRef(thread);\\n   244\\t  if (!resolved.ok) return resolved;\\n   245\\t  const { filePath } = resolved.value;\\n   246\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   247\\t\\n   248\\t  const opened = openThreadDatabase(filePath);\\n   249\\t  if (!opened.ok) return opened;\\n   250\\t  const db = opened.value;\\n   251\\t  try {\\n   252\\t    return { ok: true, value: listItems(db, \\\"turns\\\") };\\n   253\\t  } catch (cause) {\\n   254\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n   255\\t    return storageFailure(`queued-work read-back failed: ${reason}`);\\n   256\\t  } finally {\\n   257\\t    db.close();\\n   258\\t  }\\n   259\\t}\\n   260\\t\\n   261\\texport function compactChunkMaterial(\\n   262\\t  ctx: OperationContext,\\n   263\\t  chunkId: string,\\n   264\\t  derivationType: \\\"chunk_summary_detailed\\\" | \\\"chunk_summary_brief\\\" = \\\"chunk_summary_detailed\\\",\\n   265\\t): CompactChunkMaterial {\\n   266\\t  return compactChunkMaterialFromStoredMembers(ctx.db, chunkId, derivationType);\\n   267\\t}\\n   268\\t\\n   269\\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\\n   270\\t\\n   271\\t// This owner's repair report: every turn- and chunk-owned form's durable\\n   272\\t// state joined with live queue detail in one query. Needs no provider;\\n   273\\t// reads degrade, never block.\\n   274\\texport async function report(\\n   275\\t  thread: ThreadRef,\\n   276\\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\\n   277\\t): Promise<OpResult<DerivationReportEntry[]>> {\\n   278\\t  const resolved = await resolveThreadRef(thread);\\n   279\\t  if (!resolved.ok) return resolved;\\n   280\\t  const { filePath } = resolved.value;\\n   281\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   282\\t\\n   283\\t  const opened = openThreadDatabase(filePath);\\n   284\\t  if (!opened.ok) return opened;\\n   285\\t  const db = opened.value;\\n   286\\t  try {\\n   287\\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\\n   288\\t  } catch (cause) {\\n   289\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n   290\\t    return storageFailure(`report read failed: ${reason}`);\\n   291\\t  } finally {\\n   292\\t    db.close();\\n   293\\t  }\\n   294\\t}\\n   295\\t\\n   296\\texport type RequeueOutcome = { workItemId: string } | { noop: \\\"already_queued\\\" };\\n   297\\t\\n   298\\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\\n   299\\t// the one turn_derivation item (the handler lands rendering and projection\\n   300\\t// together, so a rebuild of either re-derives both — the rebuild rule from\\n   301\\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\\n   302\\t// independent lifecycles).\\n   303\\tfunction turnRequeueTarget(target: {\\n   304\\t  subjectKind: \\\"turn\\\" | \\\"chunk\\\";\\n   305\\t  subjectId: string;\\n   306\\t  derivationType: DerivationType;\\n   307\\t}): { kind: WorkKind; sourceRef: WorkSourceRef; derivations: EnqueueDerivationTarget[] } | undefined {\\n   308\\t  if (\\n   309\\t    target.subjectKind === \\\"turn\\\" &&\\n   310\\t    (target.derivationType === \\\"turn_rendering\\\" || target.derivationType === \\\"lower_band_projection\\\")\\n   311\\t  ) {\\n   312\\t    return {\\n   313\\t      kind: \\\"turn_derivation\\\",\\n   314\\t      sourceRef: { turnId: target.subjectId },\\n   315\\t      derivations: [\\n   316\\t        { subjectKind: \\\"turn\\\", subjectId: target.subjectId, derivationType: \\\"turn_rendering\\\" },\\n   317\\t        { subjectKind: \\\"turn\\\", subjectId: target.subjectId, derivationType: \\\"lower_band_projection\\\" },\\n   318\\t      ],\\n   319\\t    };\\n   320\\t  }\\n   321\\t  if (\\n   322\\t    target.subjectKind === \\\"chunk\\\" &&\\n   323\\t    (target.derivationType === \\\"chunk_summary_detailed\\\" || target.derivationType === \\\"chunk_summary_brief\\\")\\n   324\\t  ) {\\n   325\\t    return {\\n   326\\t      kind: target.derivationType,\\n   327\\t      sourceRef: { chunkId: target.subjectId },\\n   328\\t      derivations: [{ subjectKind: \\\"chunk\\\", subjectId: target.subjectId, derivationType: target.derivationType }],\\n   329\\t    };\\n   330\\t  }\\n   331\\t  return undefined;\\n   332\\t}\\n   333\\t\\n   334\\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\\n   335\\t// messages.requeue — blocked refused with the stored damage reason, missing\\n   336\\t// rows refused, no-op against live work at the current source version, and\\n   337\\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\\n   338\\t// at the next source version: composed forms recompute their gaps from\\n   339\\t// current dependency states (Flow 3's rebuild rule).\\n   340\\texport async function requeue(\\n   341\\t  thread: ThreadRef,\\n   342\\t  target: { subjectKind: \\\"turn\\\" | \\\"chunk\\\"; subjectId: string; derivationType: DerivationType },\\n   343\\t): Promise<OpResult<RequeueOutcome>> {\\n   344\\t  const mapped = turnRequeueTarget(target);\\n   345\\t  if (mapped === undefined) {\\n   346\\t    return {\\n   347\\t      ok: false,\\n   348\\t      error: {\\n   349\\t        errorClass: \\\"caller_error\\\",\\n   350\\t        code: \\\"turn_not_found\\\",\\n   351\\t        reason: `derivation ${target.derivationType} is not a ${target.subjectKind}-owned derivation; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\\n   352\\t      },\\n   353\\t    };\\n   354\\t  }\\n   355\\t  const resolved = await resolveThreadRef(thread);\\n   356\\t  if (!resolved.ok) return resolved;\\n   357\\t  const { filePath } = resolved.value;\\n   358\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   359\\t\\n   360\\t  const opened = openThreadDatabase(filePath);\\n   361\\t  if (!opened.ok) return opened;\\n   362\\t  const db = opened.value;\\n   363\\t  try {\\n   364\\t    const meta = db\\n   365\\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n   366\\t      .get() as { thread_id: string } | undefined;\\n   367\\t    const threadId = meta?.thread_id ?? \\\"\\\";\\n   368\\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\\n   369\\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.derivationType);\\n   370\\t      if (row === undefined) {\\n   371\\t        return {\\n   372\\t          ok: false,\\n   373\\t          error: {\\n   374\\t            errorClass: \\\"caller_error\\\",\\n   375\\t            code: \\\"turn_not_found\\\",\\n   376\\t            reason: `no derived derivation ${target.derivationType} exists for ${target.subjectKind} ${target.subjectId}`,\\n   377\\t          },\\n   378\\t        };\\n   379\\t      }\\n   380\\t      if (row.state === \\\"blocked\\\") {\\n   381\\t        // The refusal carries the derivation's stored reason — the damage named at\\n   382\\t        // blocking time, not a generic string (AC-4.6).\\n   383\\t        return {\\n   384\\t          ok: false,\\n   385\\t          error: {\\n   386\\t            errorClass: \\\"state_corruption\\\",\\n   387\\t            code: \\\"source_damaged\\\",\\n   388\\t            reason:\\n   389\\t              row.reason ??\\n   390\\t              `derivation ${target.derivationType} for ${target.subjectKind} ${target.subjectId} is blocked`,\\n   391\\t          },\\n   392\\t        };\\n   393\\t      }\\n   394\\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\\n   395\\t        return { ok: true, value: { noop: \\\"already_queued\\\" } };\\n   396\\t      }\\n   397\\t      const item = enqueue(ctx, {\\n   398\\t        owner: \\\"turns\\\",\\n   399\\t        kind: mapped.kind,\\n   400\\t        sourceRef: mapped.sourceRef,\\n   401\\t        sourceVersion: row.sourceVersion + 1,\\n   402\\t        derivations: mapped.derivations,\\n   403\\t      });\\n   404\\t      return { ok: true, value: { workItemId: item.workItemId } };\\n   405\\t    });\\n   406\\t  } catch (cause) {\\n   407\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n   408\\t    return storageFailure(`requeue failed: ${reason}`);\\n   409\\t  } finally {\\n   410\\t    db.close();\\n   411\\t  }\\n   412\\t}\\n   413\\t\\n   414\\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\\n   415\\t\\n   416\\t// The whole-exchange removal (AC-6.4–6.7): \\\"that exchange was a dead end —\\n   417\\t// kill it.\\\" One transaction stamps the turn and all its live member\\n   418\\t// messages deleted, drops the turn's and members' derivations, and\\n   419\\t// re-queues the containing chunk's summaries from the remaining live\\n   420\\t// members — or drops them when the chunk empties out (AC-6.6). The shared\\n   421\\t// machinery is the messages domain's cascade module (DD-8, one cascade,\\n   422\\t// two callers), reached through its public surface; this operation owns\\n   423\\t// the turn-side validation and the turn-row stamp. Source events are never\\n   424\\t// touched; chunk membership rows are never moved or re-cut — reads filter\\n   425\\t// the deleted turn out, shrinking the chunk in place. Refusals read the\\n   426\\t// filtered view: a missing, deleted, or double-deleted turn is\\n   427\\t// turn_not_found; an open turn is turn_open; a refusal changes nothing.\\n   428\\texport async function deleteTurn(\\n   429\\t  thread: ThreadRef,\\n   430\\t  input: { turnId: string },\\n   431\\t): Promise<OpResult<MutationResult>> {\\n   432\\t  const resolved = await resolveThreadRef(thread);\\n   433\\t  if (!resolved.ok) return resolved;\\n   434\\t  const { filePath } = resolved.value;\\n   435\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   436\\t\\n   437\\t  const opened = openThreadDatabase(filePath);\\n   438\\t  if (!opened.ok) return opened;\\n   439\\t  const db = opened.value;\\n   440\\t  try {\\n   441\\t    const meta = db\\n   442\\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n   443\\t      .get() as { thread_id: string } | undefined;\\n   444\\t    const threadId = meta?.thread_id ?? \\\"\\\";\\n   445\\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\\n   446\\t      const target = readMutableTurn(ctx.db, input.turnId);\\n   447\\t      if (target === undefined) {\\n   448\\t        return {\\n   449\\t          ok: false,\\n   450\\t          error: {\\n   451\\t            errorClass: \\\"caller_error\\\",\\n   452\\t            code: \\\"turn_not_found\\\",\\n   453\\t            reason: `no turn ${input.turnId} exists in this thread`,\\n   454\\t          },\\n   455\\t        };\\n   456\\t      }\\n   457\\t      if (target.status !== \\\"closed\\\") {\\n   458\\t        return {\\n   459\\t          ok: false,\\n   460\\t          error: {\\n   461\\t            errorClass: \\\"caller_error\\\",\\n   462\\t            code: \\\"turn_open\\\",\\n   463\\t            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\\n   464\\t          },\\n   465\\t        };\\n   466\\t      }\\n   467\\t      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\\n   468\\t      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\\n   469\\t      return {\\n   470\\t        ok: true,\\n   471\\t        value: {\\n   472\\t          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\\n   473\\t          cleared: cascade.cleared,\\n   474\\t          dropped: cascade.dropped,\\n   475\\t          queued: cascade.queued,\\n   476\\t          superseded: cascade.superseded,\\n   477\\t        },\\n   478\\t      };\\n   479\\t    });\\n   480\\t  } catch (cause) {\\n   481\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n   482\\t    return storageFailure(`delete failed: ${reason}`);\\n   483\\t  } finally {\\n   484\\t    db.close();\\n   485\\t  }\\n   486\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/turns/internal/chunk-recovery.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/turns/internal/chunk-recovery.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n     2\\timport type { DerivationType } from \\\"../../../shared/derivation.js\\\";\\n     3\\t\\n     4\\texport type CompactChunkMaterial =\\n     5\\t  | { kind: \\\"ready\\\"; content: string }\\n     6\\t  | { kind: \\\"concat\\\"; content: string; reason: string }\\n     7\\t  | { kind: \\\"blocked\\\"; reason: string };\\n     8\\t\\n     9\\tfunction blockText(kind: string, content: Record<string, unknown>): string {\\n    10\\t  switch (kind) {\\n    11\\t    case \\\"user_prompt\\\":\\n    12\\t    case \\\"assistant_text\\\":\\n    13\\t    case \\\"assistant_thinking\\\":\\n    14\\t    case \\\"runtime_note\\\": {\\n    15\\t      const text = content[\\\"text\\\"];\\n    16\\t      return typeof text === \\\"string\\\" ? text : \\\"\\\";\\n    17\\t    }\\n    18\\t    case \\\"tool_call\\\": {\\n    19\\t      const name = typeof content[\\\"toolName\\\"] === \\\"string\\\" ? content[\\\"toolName\\\"] : \\\"unknown_tool\\\";\\n    20\\t      return `[tool call · ${name}] ${JSON.stringify(content[\\\"arguments\\\"] ?? {})}`;\\n    21\\t    }\\n    22\\t    case \\\"tool_result\\\": {\\n    23\\t      const text = content[\\\"content\\\"];\\n    24\\t      return typeof text === \\\"string\\\" ? `[tool result]\\\\n${text}` : \\\"[tool result]\\\";\\n    25\\t    }\\n    26\\t    default:\\n    27\\t      return \\\"\\\";\\n    28\\t  }\\n    29\\t}\\n    30\\t\\n    31\\tfunction storedMemberConcat(db: DatabaseSync, chunkId: string): CompactChunkMaterial {\\n    32\\t  const chunk = db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId);\\n    33\\t  if (chunk === undefined) {\\n    34\\t    return { kind: \\\"blocked\\\", reason: `canonical record corrupt: chunk ${chunkId} not found` };\\n    35\\t  }\\n    36\\t\\n    37\\t  const members = db\\n    38\\t    .prepare(\\n    39\\t      `SELECT cm.turn_id FROM chunk_member cm\\n    40\\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\\n    41\\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\\n    42\\t    )\\n    43\\t    .all(chunkId) as unknown as Array<{ turn_id: string }>;\\n    44\\t  if (members.length === 0) {\\n    45\\t    return { kind: \\\"blocked\\\", reason: `canonical record corrupt: chunk ${chunkId} has no readable members` };\\n    46\\t  }\\n    47\\t\\n    48\\t  const messageStmt = db.prepare(\\n    49\\t    `SELECT message_id, kind FROM message\\n    50\\t     WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\\n    51\\t  );\\n    52\\t  const blockStmt = db.prepare(\\n    53\\t    `SELECT content FROM message_block WHERE message_id = ? ORDER BY block_index`,\\n    54\\t  );\\n    55\\t  const sections: string[] = [];\\n    56\\t  for (const member of members) {\\n    57\\t    const turn = db\\n    58\\t      .prepare(`SELECT status, closed_at_event_order FROM turns WHERE turn_id = ?`)\\n    59\\t      .get(member.turn_id) as\\n    60\\t      | { status: string; closed_at_event_order: number | bigint | null }\\n    61\\t      | undefined;\\n    62\\t    if (turn === undefined || turn.status !== \\\"closed\\\" || turn.closed_at_event_order === null) {\\n    63\\t      return {\\n    64\\t        kind: \\\"blocked\\\",\\n    65\\t        reason: `canonical record corrupt: chunk ${chunkId} member ${member.turn_id} is unreadable`,\\n    66\\t      };\\n    67\\t    }\\n    68\\t    const messages = messageStmt.all(member.turn_id) as unknown as Array<{\\n    69\\t      message_id: string;\\n    70\\t      kind: string;\\n    71\\t    }>;\\n    72\\t    const lines: string[] = [];\\n    73\\t    for (const message of messages) {\\n    74\\t      const blocks = blockStmt.all(message.message_id) as unknown as Array<{ content: string }>;\\n    75\\t      const rendered = blocks\\n    76\\t        .map((block) => blockText(message.kind, JSON.parse(block.content) as Record<string, unknown>))\\n    77\\t        .filter((text) => text.length > 0);\\n    78\\t      lines.push(...rendered);\\n    79\\t    }\\n    80\\t    sections.push(`§${member.turn_id}\\\\n${lines.join(\\\"\\\\n\\\")}`);\\n    81\\t  }\\n    82\\t\\n    83\\t  return {\\n    84\\t    kind: \\\"concat\\\",\\n    85\\t    content: sections.join(\\\"\\\\n\\\\n\\\"),\\n    86\\t    reason: \\\"not_ready\\\",\\n    87\\t  };\\n    88\\t}\\n    89\\t\\n    90\\texport function compactChunkMaterialFromStoredMembers(\\n    91\\t  db: DatabaseSync,\\n    92\\t  chunkId: string,\\n    93\\t  derivationType: Extract<DerivationType, \\\"chunk_summary_detailed\\\" | \\\"chunk_summary_brief\\\">,\\n    94\\t): CompactChunkMaterial {\\n    95\\t  const row = db\\n    96\\t    .prepare(\\n    97\\t      `SELECT state, content, reason FROM derivation\\n    98\\t       WHERE subject_kind = 'chunk' AND subject_id = ? AND derivation_type = ?`,\\n    99\\t    )\\n   100\\t    .get(chunkId, derivationType) as\\n   101\\t    | { state: string; content: string | null; reason: string | null }\\n   102\\t    | undefined;\\n   103\\t  if (row?.state === \\\"ready\\\" && row.content !== null) {\\n   104\\t    return { kind: \\\"ready\\\", content: row.content };\\n   105\\t  }\\n   106\\t  if (row?.state === \\\"blocked\\\") {\\n   107\\t    return {\\n   108\\t      kind: \\\"blocked\\\",\\n   109\\t      reason: row.reason ?? `${derivationType} for chunk ${chunkId} is blocked`,\\n   110\\t    };\\n   111\\t  }\\n   112\\t  const fallback = storedMemberConcat(db, chunkId);\\n   113\\t  if (fallback.kind !== \\\"concat\\\") return fallback;\\n   114\\t  return {\\n   115\\t    ...fallback,\\n   116\\t    reason:\\n   117\\t      row === undefined\\n   118\\t        ? \\\"missing_derivation\\\"\\n   119\\t        : row.state === \\\"failed\\\"\\n   120\\t          ? \\\"failed_floor\\\"\\n   121\\t          : \\\"not_ready\\\",\\n   122\\t  };\\n   123\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,420p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,360p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,360p'\\\"\",\"aggregated_output\":\"     1\\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\\n     2\\t// source turn, the member messages it composes (deleted-filtered — the\\n     3\\t// shared read-filter rule lives here, once for this domain), the\\n     4\\t// message-level form rows composition consumes, and the member projections\\n     5\\t// the chunk summaries read. Completion writes for turn- and chunk-owned\\n     6\\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\\n     7\\t// — no write path here.\\n     8\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n     9\\timport type {\\n    10\\t  DependencyGap,\\n    11\\t  Derivation,\\n    12\\t  DerivationMetadata,\\n    13\\t  DerivationState,\\n    14\\t  DerivationReportEntry,\\n    15\\t  RenderingPartKind,\\n    16\\t  ToolRunReceipt,\\n    17\\t  DerivationType,\\n    18\\t  SubjectKind,\\n    19\\t} from \\\"../../../shared/derivation.js\\\";\\n    20\\timport { reportEntryFromRow, type RawReportRow } from \\\"../../../shared/report.js\\\";\\n    21\\timport type { ComposeFormRow, ComposeMessage } from \\\"./compose.js\\\";\\n    22\\timport { composeFormKey } from \\\"./compose.js\\\";\\n    23\\t\\n    24\\texport interface TurnSource {\\n    25\\t  turnId: string;\\n    26\\t  status: \\\"open\\\" | \\\"closed\\\";\\n    27\\t  deleted: boolean;\\n    28\\t}\\n    29\\t\\n    30\\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\\n    31\\t  const row = db\\n    32\\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\\n    33\\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\\n    34\\t  if (row === undefined) return undefined;\\n    35\\t  return {\\n    36\\t    turnId,\\n    37\\t    status: row.status as TurnSource[\\\"status\\\"],\\n    38\\t    deleted: row.deleted_at !== null,\\n    39\\t  };\\n    40\\t}\\n    41\\t\\n    42\\t// Member messages in message order, blocks attached, deleted messages\\n    43\\t// filtered (tech design §Mechanics: composition's member enumeration reads\\n    44\\t// the live projection only).\\n    45\\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\\n    46\\t  const messages = db\\n    47\\t    .prepare(\\n    48\\t      `SELECT message_id, kind FROM message\\n    49\\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\\n    50\\t    )\\n    51\\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\\n    52\\t  const blockStmt = db.prepare(\\n    53\\t    `SELECT block_type, content FROM message_block\\n    54\\t     WHERE message_id = ? ORDER BY block_index`,\\n    55\\t  );\\n    56\\t  return messages.map((message) => {\\n    57\\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\\n    58\\t      block_type: string;\\n    59\\t      content: string;\\n    60\\t    }>;\\n    61\\t    return {\\n    62\\t      messageId: message.message_id,\\n    63\\t      kind: message.kind as RenderingPartKind,\\n    64\\t      blocks: blocks.map((block) => ({\\n    65\\t        blockType: block.block_type,\\n    66\\t        content: JSON.parse(block.content) as Record<string, unknown>,\\n    67\\t      })),\\n    68\\t    };\\n    69\\t  });\\n    70\\t}\\n    71\\t\\n    72\\t// The message-owned form rows for a set of member messages, keyed for\\n    73\\t// composition. A cross-owner *read* by design: composition consumes message\\n    74\\t// forms; only message handlers ever write them (DD-2 ownership is a write\\n    75\\t// rule).\\n    76\\texport function readMessageFormRows(\\n    77\\t  db: DatabaseSync,\\n    78\\t  messageIds: readonly string[],\\n    79\\t): Map<string, ComposeFormRow> {\\n    80\\t  const rows = new Map<string, ComposeFormRow>();\\n    81\\t  if (messageIds.length === 0) return rows;\\n    82\\t  const placeholders = messageIds.map(() => \\\"?\\\").join(\\\", \\\");\\n    83\\t  const raw = db\\n    84\\t    .prepare(\\n    85\\t      `SELECT subject_id, derivation_type, state, content, reason, metadata, source_version\\n    86\\t       FROM derivation\\n    87\\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\\n    88\\t    )\\n    89\\t    .all(...messageIds) as unknown as Array<{\\n    90\\t    subject_id: string;\\n    91\\t    derivation_type: string;\\n    92\\t    state: string;\\n    93\\t    content: string | null;\\n    94\\t    reason: string | null;\\n    95\\t    metadata: string | null;\\n    96\\t    source_version: number | bigint;\\n    97\\t  }>;\\n    98\\t  for (const row of raw) {\\n    99\\t    const view: ComposeFormRow = {\\n   100\\t      state: row.state as ComposeFormRow[\\\"state\\\"],\\n   101\\t      sourceVersion: Number(row.source_version),\\n   102\\t    };\\n   103\\t    if (row.content !== null) view.content = row.content;\\n   104\\t    if (row.reason !== null) view.reason = row.reason;\\n   105\\t    if (row.metadata !== null) {\\n   106\\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\\\"metadata\\\"]>;\\n   107\\t    }\\n   108\\t    rows.set(composeFormKey(row.subject_id, row.derivation_type as DerivationType), view);\\n   109\\t  }\\n   110\\t  return rows;\\n   111\\t}\\n   112\\t\\n   113\\t// Member projections in turn order for the chunk summaries: member rows by\\n   114\\t// member_idx, deleted turns filtered, each joined to its stored\\n   115\\t// lower_band_projection row (state + content as landed — never re-derived)\\n   116\\t// and to its turn_rendering's mechanically stamped tool-run receipts\\n   117\\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\\n   118\\texport interface MemberProjection {\\n   119\\t  turnId: string;\\n   120\\t  state?: string; // undefined: no projection row exists for the member\\n   121\\t  content?: string;\\n   122\\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\\n   123\\t}\\n   124\\t\\n   125\\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\\n   126\\t  const rows = db\\n   127\\t    .prepare(\\n   128\\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\\n   129\\t       FROM chunk_member cm\\n   130\\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\\n   131\\t       LEFT JOIN derivation df ON df.subject_kind = 'turn'\\n   132\\t         AND df.subject_id = cm.turn_id AND df.derivation_type = 'lower_band_projection'\\n   133\\t       LEFT JOIN derivation rf ON rf.subject_kind = 'turn'\\n   134\\t         AND rf.subject_id = cm.turn_id AND rf.derivation_type = 'turn_rendering'\\n   135\\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\\n   136\\t    )\\n   137\\t    .all(chunkId) as unknown as Array<{\\n   138\\t    turn_id: string;\\n   139\\t    state: string | null;\\n   140\\t    content: string | null;\\n   141\\t    rendering_metadata: string | null;\\n   142\\t  }>;\\n   143\\t  return rows.map((row) => {\\n   144\\t    const metadata =\\n   145\\t      row.rendering_metadata === null\\n   146\\t        ? undefined\\n   147\\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\\n   148\\t    const projection: MemberProjection = {\\n   149\\t      turnId: row.turn_id,\\n   150\\t      receipts: metadata?.receipts ?? [],\\n   151\\t    };\\n   152\\t    if (row.state !== null) projection.state = row.state;\\n   153\\t    if (row.content !== null) projection.content = row.content;\\n   154\\t    return projection;\\n   155\\t  });\\n   156\\t}\\n   157\\t\\n   158\\tinterface RawOwnedFormRow {\\n   159\\t  subject_id: string;\\n   160\\t  derivation_type: string;\\n   161\\t  state: string;\\n   162\\t  content: string | null;\\n   163\\t  reason: string | null;\\n   164\\t  metadata: string | null;\\n   165\\t  source_version: number | bigint;\\n   166\\t  gaps: string | null;\\n   167\\t  derived_at: string | null;\\n   168\\t}\\n   169\\t\\n   170\\t// Every form row this owner holds for one subject kind, grouped by subject\\n   171\\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\\n   172\\t// \\\"record with form states\\\", mirroring messages.readMessageForms). Rows come\\n   173\\t// back exactly as the pipeline landed them; nothing is derived at read time.\\n   174\\texport function readOwnedForms(\\n   175\\t  db: DatabaseSync,\\n   176\\t  subjectKind: \\\"turn\\\" | \\\"chunk\\\",\\n   177\\t): Map<string, Derivation[]> {\\n   178\\t  const rows = db\\n   179\\t    .prepare(\\n   180\\t      `SELECT subject_id, derivation_type, state, content, reason, metadata,\\n   181\\t              source_version, gaps, derived_at\\n   182\\t       FROM derivation WHERE subject_kind = ?\\n   183\\t       ORDER BY subject_id, derivation_type`,\\n   184\\t    )\\n   185\\t    .all(subjectKind) as unknown as RawOwnedFormRow[];\\n   186\\t  const bySubject = new Map<string, Derivation[]>();\\n   187\\t  for (const row of rows) {\\n   188\\t    const record: Derivation = {\\n   189\\t      subjectKind,\\n   190\\t      subjectId: row.subject_id,\\n   191\\t      derivationType: row.derivation_type as DerivationType,\\n   192\\t      state: row.state as DerivationState,\\n   193\\t      sourceVersion: Number(row.source_version),\\n   194\\t    };\\n   195\\t    if (row.content !== null) record.content = row.content;\\n   196\\t    if (row.reason !== null) record.reason = row.reason;\\n   197\\t    if (row.metadata !== null) {\\n   198\\t      record.metadata = JSON.parse(row.metadata) as DerivationMetadata;\\n   199\\t    }\\n   200\\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\n   201\\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\\n   202\\t    const forms = bySubject.get(row.subject_id) ?? [];\\n   203\\t    forms.push(record);\\n   204\\t    bySubject.set(row.subject_id, forms);\\n   205\\t  }\\n   206\\t  return bySubject;\\n   207\\t}\\n   208\\t\\n   209\\t// Chunk read-back rows for the listChunks surface: stored chunk state plus\\n   210\\t// live (deleted-filtered) membership in member order.\\n   211\\texport interface ChunkReadRow {\\n   212\\t  chunkId: string;\\n   213\\t  chunkOrder: number;\\n   214\\t  status: \\\"open\\\" | \\\"closed\\\";\\n   215\\t  accumulatedProjectedTokens: number;\\n   216\\t  memberTurnIds: string[];\\n   217\\t}\\n   218\\t\\n   219\\texport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\\n   220\\t  const chunks = db\\n   221\\t    .prepare(\\n   222\\t      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\\n   223\\t       FROM chunk ORDER BY chunk_order`,\\n   224\\t    )\\n   225\\t    .all() as unknown as Array<{\\n   226\\t    chunk_id: string;\\n   227\\t    chunk_order: number | bigint;\\n   228\\t    status: string;\\n   229\\t    accumulated_projected_tokens: number | bigint;\\n   230\\t  }>;\\n   231\\t  const memberStmt = db.prepare(\\n   232\\t    `SELECT cm.turn_id FROM chunk_member cm\\n   233\\t     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\\n   234\\t     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\\n   235\\t  );\\n   236\\t  return chunks.map((row) => ({\\n   237\\t    chunkId: row.chunk_id,\\n   238\\t    chunkOrder: Number(row.chunk_order),\\n   239\\t    status: row.status as \\\"open\\\" | \\\"closed\\\",\\n   240\\t    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\\n   241\\t    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\\n   242\\t      (member) => member.turn_id,\\n   243\\t    ),\\n   244\\t  }));\\n   245\\t}\\n   246\\t\\n   247\\t// One form row by exact key for this owner's subjects — the requeue\\n   248\\t// operation's refusal read (missing row, blocked state, current version).\\n   249\\texport function readTurnFormRow(\\n   250\\t  db: DatabaseSync,\\n   251\\t  subjectKind: \\\"turn\\\" | \\\"chunk\\\",\\n   252\\t  subjectId: string,\\n   253\\t  form: DerivationType,\\n   254\\t): { state: DerivationState; reason?: string; sourceVersion: number } | undefined {\\n   255\\t  const row = db\\n   256\\t    .prepare(\\n   257\\t      `SELECT state, reason, source_version FROM derivation\\n   258\\t       WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ?`,\\n   259\\t    )\\n   260\\t    .get(subjectKind, subjectId, form) as unknown as\\n   261\\t    | { state: string; reason: string | null; source_version: number | bigint }\\n   262\\t    | undefined;\\n   263\\t  if (row === undefined) return undefined;\\n   264\\t  const view: { state: DerivationState; reason?: string; sourceVersion: number } = {\\n   265\\t    state: row.state as DerivationState,\\n   266\\t    sourceVersion: Number(row.source_version),\\n   267\\t  };\\n   268\\t  if (row.reason !== null) view.reason = row.reason;\\n   269\\t  return view;\\n   270\\t}\\n   271\\t\\n   272\\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\\n   273\\t// form rows LEFT JOINed with the live work_item targeting each form at its\\n   274\\t// current source version. Both turn forms map to the one turn_derivation\\n   275\\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\\n   276\\t// this owner's queue-site mapping inverted, mirroring the messages report.\\n   277\\texport function reportTurnForms(\\n   278\\t  db: DatabaseSync,\\n   279\\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\\n   280\\t): DerivationReportEntry[] {\\n   281\\t  const conditions = [\\\"df.subject_kind IN ('turn', 'chunk')\\\"];\\n   282\\t  const params: string[] = [];\\n   283\\t  const subjectFilters: string[] = [];\\n   284\\t  if (opts.turnId !== undefined) {\\n   285\\t    subjectFilters.push(\\\"(df.subject_kind = 'turn' AND df.subject_id = ?)\\\");\\n   286\\t    params.push(opts.turnId);\\n   287\\t  }\\n   288\\t  if (opts.chunkId !== undefined) {\\n   289\\t    subjectFilters.push(\\\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\\\");\\n   290\\t    params.push(opts.chunkId);\\n   291\\t  }\\n   292\\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\\\" OR \\\")})`);\\n   293\\t  // notReady is exact set equality by construction: every state but ready.\\n   294\\t  if (opts.notReady === true) conditions.push(\\\"df.state <> 'ready'\\\");\\n   295\\t  const rows = db\\n   296\\t    .prepare(\\n   297\\t      `SELECT df.subject_kind, df.subject_id, df.derivation_type, df.state, df.content, df.reason,\\n   298\\t              df.metadata, df.source_version, df.gaps, df.derived_at,\\n   299\\t              w.status AS queue_status, w.attempts AS queue_attempts,\\n   300\\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\\n   301\\t       FROM derivation df\\n   302\\t       LEFT JOIN work_item w\\n   303\\t         ON w.status IN ('queued', 'claimed')\\n   304\\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.derivation_type END\\n   305\\t        AND json_extract(\\n   306\\t              w.source_ref,\\n   307\\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\\n   308\\t            ) = df.subject_id\\n   309\\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\\n   310\\t       WHERE ${conditions.join(\\\" AND \\\")}\\n   311\\t       ORDER BY df.subject_kind DESC, df.subject_id, df.derivation_type`,\\n   312\\t    )\\n   313\\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\\n   314\\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\\n   315\\t}\\n   316\\t\\n   317\\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\\n   318\\t  return (\\n   319\\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\\n   320\\t  );\\n   321\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,420p'\\\"\",\"aggregated_output\":\"     1\\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\\n     2\\t// biggest single handler — and the two chunk summaries. turn_derivation\\n     3\\t// composes the rendering from message-level forms (compose.ts), sends it\\n     4\\t// through composeTurnRendering then projectLowerBand, hands both forms back\\n     5\\t// for the version-checked completion write, and runs placement in that same\\n     6\\t// completion transaction via the onApplied hook: open-chunk append, the\\n     7\\t// accumulated close policy, and any close's summary enqueues all ride the\\n     8\\t// one commit (anti-shim: a crash leaves either a placed turn with queued\\n     9\\t// summaries or an open chunk — nothing between).\\n    10\\timport { resolveInstancePoke } from \\\"../../../shared/context.js\\\";\\n    11\\timport type {\\n    12\\t  DerivationMetadata,\\n    13\\t  DerivationType,\\n    14\\t  HandlerOutcome,\\n    15\\t  HandlerRunContext,\\n    16\\t  ToolOutcome,\\n    17\\t  WorkHandler,\\n    18\\t} from \\\"../../../shared/derivation.js\\\";\\n    19\\timport { writeLog } from \\\"../../../tech-utils/logging/index.js\\\";\\n    20\\timport { estimateTokens } from \\\"../../../tech-utils/token-counting/index.js\\\";\\n    21\\timport type { WorkKind } from \\\"../../../tech-utils/work-queue/index.js\\\";\\n    22\\timport { cleanPrompt } from \\\"../../messages/index.js\\\";\\n    23\\timport {\\n    24\\t  composeFormKey,\\n    25\\t  composeRenderingInput,\\n    26\\t  type ComposeFormRow,\\n    27\\t  type ComposeMessage,\\n    28\\t} from \\\"./compose.js\\\";\\n    29\\timport { enqueueChunkSummaries, placeTurn } from \\\"./chunks.js\\\";\\n    30\\timport {\\n    31\\t  chunkExists,\\n    32\\t  readMemberMessages,\\n    33\\t  readMemberProjections,\\n    34\\t  readMessageFormRows,\\n    35\\t  readTurnSource,\\n    36\\t} from \\\"./forms.js\\\";\\n    37\\timport { hasLiveRecoveryWork, recoverDerivation } from \\\"./recovery.js\\\";\\n    38\\timport { selectOpenTurnIds } from \\\"./store.js\\\";\\n    39\\t\\n    40\\tfunction sourceDamaged(reason: string): HandlerOutcome {\\n    41\\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\\n    42\\t}\\n    43\\t\\n    44\\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\\n    45\\t  return { ok: false, retryable: result.retryable, reason: result.reason };\\n    46\\t}\\n    47\\t\\n    48\\tfunction dependencyNotReady(reason: string): HandlerOutcome {\\n    49\\t  return { ok: false, retryable: true, reason };\\n    50\\t}\\n    51\\t\\n    52\\tfunction readThreadId(run: HandlerRunContext): string {\\n    53\\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\\n    54\\t    | { thread_id: string }\\n    55\\t    | undefined;\\n    56\\t  return row?.thread_id ?? \\\"\\\";\\n    57\\t}\\n    58\\t\\n    59\\tfunction logFallback(\\n    60\\t  run: HandlerRunContext,\\n    61\\t  entry: {\\n    62\\t    derivationType: DerivationType;\\n    63\\t    subjectId: string;\\n    64\\t    reason: \\\"not_ready\\\" | \\\"failed_floor\\\";\\n    65\\t    floorUsed: string;\\n    66\\t  },\\n    67\\t): void {\\n    68\\t  const db = run.openDb();\\n    69\\t  writeLog(\\n    70\\t    {\\n    71\\t      db,\\n    72\\t      clock: run.clock,\\n    73\\t      threadId: readThreadId(run),\\n    74\\t      onCommit: () => {},\\n    75\\t      poke: resolveInstancePoke(),\\n    76\\t    },\\n    77\\t    {\\n    78\\t      level: \\\"warning\\\",\\n    79\\t      message: \\\"derivation fallback used\\\",\\n    80\\t      derivationType: entry.derivationType,\\n    81\\t      subjectId: entry.subjectId,\\n    82\\t      reason: entry.reason,\\n    83\\t      floorUsed: entry.floorUsed,\\n    84\\t    },\\n    85\\t  );\\n    86\\t}\\n    87\\t\\n    88\\tfunction toolOutcomeFromMessage(message: ComposeMessage): ToolOutcome {\\n    89\\t  const block = message.blocks[0]?.content ?? {};\\n    90\\t  return block[\\\"isError\\\"] === true ? \\\"failed\\\" : \\\"succeeded\\\";\\n    91\\t}\\n    92\\t\\n    93\\tasync function recoverMessageForms(\\n    94\\t  run: HandlerRunContext,\\n    95\\t  messages: readonly ComposeMessage[],\\n    96\\t  forms: Map<string, ComposeFormRow>,\\n    97\\t): Promise<void> {\\n    98\\t  for (const message of messages) {\\n    99\\t    const plan =\\n   100\\t      message.kind === \\\"user_prompt\\\"\\n   101\\t        ? { derivationType: \\\"smoothed_prompt\\\" as const }\\n   102\\t        : message.kind === \\\"tool_result\\\"\\n   103\\t          ? { derivationType: \\\"tool_result_summary\\\" as const }\\n   104\\t          : undefined;\\n   105\\t    if (plan === undefined) continue;\\n   106\\t    const key = composeFormKey(message.messageId, plan.derivationType);\\n   107\\t    const row = forms.get(key);\\n   108\\t    if (row === undefined || row.state === \\\"ready\\\") continue;\\n   109\\t    const live = hasLiveRecoveryWork(run.openDb(), {\\n   110\\t      subjectKind: \\\"message\\\",\\n   111\\t      subjectId: message.messageId,\\n   112\\t      derivationType: plan.derivationType,\\n   113\\t      sourceVersion: row.sourceVersion,\\n   114\\t    });\\n   115\\t    if (live) continue;\\n   116\\t\\n   117\\t    const block = message.blocks[0]?.content ?? {};\\n   118\\t    const result =\\n   119\\t      message.kind === \\\"user_prompt\\\"\\n   120\\t        ? await run.provider.smoothPrompt({\\n   121\\t            text: cleanPrompt(typeof block[\\\"text\\\"] === \\\"string\\\" ? block[\\\"text\\\"] : \\\"\\\"),\\n   122\\t          })\\n   123\\t        : await run.provider.summarizeToolResult({\\n   124\\t            toolName: \\\"unknown_tool\\\",\\n   125\\t            content: typeof block[\\\"content\\\"] === \\\"string\\\" ? block[\\\"content\\\"] : \\\"\\\",\\n   126\\t            outcome: toolOutcomeFromMessage(message),\\n   127\\t          });\\n   128\\t    if (!result.ok) continue;\\n   129\\t\\n   130\\t    const metadata: DerivationMetadata | undefined =\\n   131\\t      message.kind === \\\"tool_result\\\"\\n   132\\t        ? {\\n   133\\t            outcome: toolOutcomeFromMessage(message),\\n   134\\t            ...(result.provenance === undefined ? {} : { provenance: result.provenance }),\\n   135\\t          }\\n   136\\t        : result.provenance === undefined\\n   137\\t          ? undefined\\n   138\\t          : { provenance: result.provenance };\\n   139\\t    const recovered: ComposeFormRow = {\\n   140\\t      state: \\\"ready\\\",\\n   141\\t      content: result.text,\\n   142\\t      sourceVersion: row.sourceVersion,\\n   143\\t      ...(metadata === undefined ? {} : { metadata }),\\n   144\\t    };\\n   145\\t    forms.set(key, recovered);\\n   146\\t    recoverDerivation(run.openDb(), {\\n   147\\t      subjectKind: \\\"message\\\",\\n   148\\t      subjectId: message.messageId,\\n   149\\t      derivationType: plan.derivationType,\\n   150\\t      content: result.text,\\n   151\\t      ...(recovered.metadata === undefined ? {} : { metadata: recovered.metadata }),\\n   152\\t      sourceVersion: row.sourceVersion,\\n   153\\t      derivedAt: run.clock().toISOString(),\\n   154\\t    });\\n   155\\t  }\\n   156\\t}\\n   157\\t\\n   158\\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\\n   159\\t  const turnId = item.sourceRef[\\\"turnId\\\"];\\n   160\\t  if (turnId === undefined) return sourceDamaged(\\\"work item carries no turnId\\\");\\n   161\\t  const db = run.openDb();\\n   162\\t  const turn = readTurnSource(db, turnId);\\n   163\\t  if (turn === undefined || turn.deleted) {\\n   164\\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\\n   165\\t    // would hit nothing; either way the item is terminal against a source\\n   166\\t    // that cannot improve.\\n   167\\t    return sourceDamaged(`turn ${turnId} not found`);\\n   168\\t  }\\n   169\\t  if (turn.status !== \\\"closed\\\") {\\n   170\\t    // Derivation is queued only at close; an open turn under a queued item\\n   171\\t    // means the record was interfered with.\\n   172\\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\\n   173\\t  }\\n   174\\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\\n   175\\t  // batch pipeline writes turn state and it never leaves two turns open, so\\n   176\\t  // more than one open turn means the record was damaged below the SDK. A\\n   177\\t  // handler must not compose against a membership it cannot trust; the form\\n   178\\t  // lands blocked naming the damage, and requeue refuses with that reason\\n   179\\t  // until the source reads clean (Story 4).\\n   180\\t  const openTurnIds = selectOpenTurnIds(db);\\n   181\\t  if (openTurnIds.length > 1) {\\n   182\\t    return sourceDamaged(\\n   183\\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\\\", \\\")})`,\\n   184\\t    );\\n   185\\t  }\\n   186\\t\\n   187\\t  // Compose from current message-form states: ready forms verbatim,\\n   188\\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\\n   189\\t  // before any provider call, and no transaction is held across them.\\n   190\\t  const messages = readMemberMessages(db, turnId);\\n   191\\t  const forms = readMessageFormRows(\\n   192\\t    db,\\n   193\\t    messages.map((message) => message.messageId),\\n   194\\t  );\\n   195\\t  await recoverMessageForms(run, messages, forms);\\n   196\\t  const { parts, receipts, recoveries } = composeRenderingInput(messages, forms);\\n   197\\t  for (const recovery of recoveries) {\\n   198\\t    logFallback(run, {\\n   199\\t      derivationType: recovery.derivationType,\\n   200\\t      subjectId: recovery.subjectId,\\n   201\\t      reason: recovery.reason,\\n   202\\t      floorUsed: recovery.floorUsed,\\n   203\\t    });\\n   204\\t    recoverDerivation(run.openDb(), {\\n   205\\t      subjectKind: recovery.subjectKind,\\n   206\\t      subjectId: recovery.subjectId,\\n   207\\t      derivationType: recovery.derivationType,\\n   208\\t      content: recovery.content,\\n   209\\t      sourceVersion: recovery.sourceVersion,\\n   210\\t      derivedAt: run.clock().toISOString(),\\n   211\\t    });\\n   212\\t  }\\n   213\\t\\n   214\\t  const rendering = await run.provider.composeTurnRendering({ parts });\\n   215\\t  if (!rendering.ok) return providerFailed(rendering);\\n   216\\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\\n   217\\t  if (!projection.ok) return providerFailed(projection);\\n   218\\t\\n   219\\t  // The projection's token count is estimated exactly once, here, as the\\n   220\\t  // artifact lands; placement reads this stored arithmetic and never\\n   221\\t  // re-counts (AC-3.9's determinism input).\\n   222\\t  const projectedTokens = estimateTokens(projection.text);\\n   223\\t  const threadId = readThreadId(run);\\n   224\\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\\n   225\\t  // from the composition input (AC-3.8) — the chunk summaries read them from\\n   226\\t  // here, never from provider prose. Provenance is copied from the provider\\n   227\\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\\n   228\\t  // deterministic provider sets none.\\n   229\\t  const renderingMetadata: DerivationMetadata = {\\n   230\\t    ...(receipts.length > 0 ? { receipts } : {}),\\n   231\\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\\n   232\\t  };\\n   233\\t\\n   234\\t  return {\\n   235\\t    ok: true,\\n   236\\t    derivations: [\\n   237\\t      {\\n   238\\t        subjectKind: \\\"turn\\\",\\n   239\\t        subjectId: turnId,\\n   240\\t        derivationType: \\\"turn_rendering\\\",\\n   241\\t        content: rendering.text,\\n   242\\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\\n   243\\t      },\\n   244\\t      {\\n   245\\t        subjectKind: \\\"turn\\\",\\n   246\\t        subjectId: turnId,\\n   247\\t        derivationType: \\\"lower_band_projection\\\",\\n   248\\t        content: projection.text,\\n   249\\t        ...(projection.provenance === undefined\\n   250\\t          ? {}\\n   251\\t          : { metadata: { provenance: projection.provenance } }),\\n   252\\t      },\\n   253\\t    ],\\n   254\\t    onApplied: (tx) => {\\n   255\\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\\n   256\\t      for (const chunkId of placement.closedChunkIds) {\\n   257\\t        enqueueChunkSummaries(\\n   258\\t          {\\n   259\\t            db: tx.db,\\n   260\\t            clock: run.clock,\\n   261\\t            threadId,\\n   262\\t            onCommit: tx.onCommit,\\n   263\\t            poke: resolveInstancePoke(),\\n   264\\t          },\\n   265\\t          chunkId,\\n   266\\t        );\\n   267\\t      }\\n   268\\t    },\\n   269\\t  };\\n   270\\t};\\n   271\\t\\n   272\\t// One read for both summary kinds — member projections in turn order — but\\n   273\\t// two contracts at the provider seam (AC-3.8): detailed receives the\\n   274\\t// members' tool-run receipts (what changed, outcome) read from the\\n   275\\t// renderings' stamped metadata; brief receives outcomes only, the receipt\\n   276\\t// text stripped here so the brief provider call structurally cannot carry\\n   277\\t// it. Two work items, two handlers' runs, independent retry and states. A\\n   278\\t// member whose projection is not ready waits: chunk summary derivation is\\n   279\\t// background work, so it requeues until the member lower-band input lands.\\n   280\\tfunction chunkSummaryHandler(\\n   281\\t  kind: \\\"chunk_summary_detailed\\\" | \\\"chunk_summary_brief\\\",\\n   282\\t): WorkHandler {\\n   283\\t  return async (run, item) => {\\n   284\\t    const chunkId = item.sourceRef[\\\"chunkId\\\"];\\n   285\\t    if (chunkId === undefined) return sourceDamaged(\\\"work item carries no chunkId\\\");\\n   286\\t    const db = run.openDb();\\n   287\\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\\n   288\\t\\n   289\\t    const members = readMemberProjections(db, chunkId);\\n   290\\t    const memberProjections: string[] = [];\\n   291\\t    for (const member of members) {\\n   292\\t      if (member.state === \\\"ready\\\" && member.content !== undefined) {\\n   293\\t        memberProjections.push(member.content);\\n   294\\t        continue;\\n   295\\t      }\\n   296\\t      if (member.state === \\\"blocked\\\") {\\n   297\\t        return sourceDamaged(\\n   298\\t          `member ${member.turnId} lower_band_projection blocked while deriving ${kind}`,\\n   299\\t        );\\n   300\\t      }\\n   301\\t      return dependencyNotReady(\\n   302\\t        `member_projection_not_ready: member ${member.turnId} lower_band_projection is ${member.state ?? \\\"missing\\\"}`,\\n   303\\t      );\\n   304\\t    }\\n   305\\t\\n   306\\t    const result =\\n   307\\t      kind === \\\"chunk_summary_detailed\\\"\\n   308\\t        ? await run.provider.summarizeChunkDetailed({\\n   309\\t            memberProjections,\\n   310\\t            memberReceipts: members.map((member) => member.receipts),\\n   311\\t          })\\n   312\\t        : await run.provider.summarizeChunkBrief({\\n   313\\t            memberProjections,\\n   314\\t            memberOutcomes: members.map((member) =>\\n   315\\t              member.receipts.map((receipt) => receipt.outcome),\\n   316\\t            ),\\n   317\\t          });\\n   318\\t    if (!result.ok) return providerFailed(result);\\n   319\\t\\n   320\\t    return {\\n   321\\t      ok: true,\\n   322\\t      derivations: [\\n   323\\t        {\\n   324\\t          subjectKind: \\\"chunk\\\",\\n   325\\t          subjectId: chunkId,\\n   326\\t          derivationType: kind,\\n   327\\t          content: result.text,\\n   328\\t          ...(result.provenance === undefined\\n   329\\t            ? {}\\n   330\\t            : { metadata: { provenance: result.provenance } }),\\n   331\\t        },\\n   332\\t      ],\\n   333\\t    };\\n   334\\t  };\\n   335\\t}\\n   336\\t\\n   337\\t// The domain's handler table, merged into the SDK dispatch map at\\n   338\\t// construction (DD-6).\\n   339\\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\\n   340\\t  turn_derivation: turnDerivationHandler,\\n   341\\t  chunk_summary_detailed: chunkSummaryHandler(\\\"chunk_summary_detailed\\\"),\\n   342\\t  chunk_summary_brief: chunkSummaryHandler(\\\"chunk_summary_brief\\\"),\\n   343\\t};\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '330,620p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '330,620p'\\\"\",\"aggregated_output\":\"   330\\t    db.close();\\n   331\\t  }\\n   332\\t}\\n   333\\t\\n   334\\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\\n   335\\t\\n   336\\t// The default base when no profile is named: the first built-in, matching\\n   337\\t// the epic's primary user (the PI continuation harness). Explicit params\\n   338\\t// override the base field-wise (AC-2.2).\\n   339\\tconst DEFAULT_PROFILE_NAME = \\\"continuation\\\";\\n   340\\t\\n   341\\tfunction callerError(\\n   342\\t  code: \\\"unknown_profile\\\" | \\\"invalid_view_config\\\" | \\\"compact_stopped\\\",\\n   343\\t  reason: string,\\n   344\\t): { ok: false; error: ErrorResult } {\\n   345\\t  return { ok: false, error: { errorClass: \\\"caller_error\\\", code, reason } };\\n   346\\t}\\n   347\\t\\n   348\\tconst BAND_ORDER: readonly Band[] = [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"];\\n   349\\t\\n   350\\tfunction compactStopped(signal: { aborted: boolean } | undefined): boolean {\\n   351\\t  return signal?.aborted === true;\\n   352\\t}\\n   353\\t\\n   354\\t// Compact runs only when invoked through this surface (AC-2.1: no code path\\n   355\\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\\n   356\\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\\n   357\\t// skips (AC-3.6; the receipt records which) → read record + derivations with the\\n   358\\t// corruption check in the reads (pre-transaction, prior view trivially\\n   359\\t// intact on refusal) → selection walk → band rendering → one BEGIN\\n   360\\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\\n   361\\t// Assembly is entirely from stored artifacts: nothing here can reach a\\n   362\\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\\n   363\\t// through owners' requeue surfaces and calls no provider either).\\n   364\\texport async function compact(\\n   365\\t  ref: ThreadRef,\\n   366\\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean; signal?: { aborted: boolean } },\\n   367\\t): Promise<OpResult<CompactReceipt>> {\\n   368\\t  const resolved = await resolveThreadRef(ref);\\n   369\\t  if (!resolved.ok) return resolved;\\n   370\\t  const { filePath } = resolved.value;\\n   371\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   372\\t\\n   373\\t  const config = viewConfig();\\n   374\\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\\n   375\\t  const base = config.profiles[baseName];\\n   376\\t  if (base === undefined) {\\n   377\\t    return callerError(\\n   378\\t      \\\"unknown_profile\\\",\\n   379\\t      `unknown profile \\\"${baseName}\\\"; configured profiles are ${Object.keys(config.profiles)\\n   380\\t        .map((name) => `\\\"${name}\\\"`)\\n   381\\t        .join(\\\", \\\")}`,\\n   382\\t    );\\n   383\\t  }\\n   384\\t  const merged: ViewProfile = {\\n   385\\t    name: base.name,\\n   386\\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\\n   387\\t    percentages: { ...base.percentages, ...opts.params?.percentages },\\n   388\\t  };\\n   389\\t  const violation = profileViolation(merged);\\n   390\\t  if (violation !== null) return callerError(\\\"invalid_view_config\\\", violation);\\n   391\\t  // Receipt provenance: \\\"null when explicit params\\\" (tech design §Storage) —\\n   392\\t  // any param override means the config is no longer a named profile's mix,\\n   393\\t  // even when one served as the merge base; the receipt's config carries the\\n   394\\t  // resolved truth. A bare or profile-only call names its profile.\\n   395\\t  const profileName = opts.params === undefined ? baseName : null;\\n   396\\t\\n   397\\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\\n   398\\t  // leaves the thread healthier than it found it; `sweep: false` skips with\\n   399\\t  // the skip recorded in the receipt. Runs before this operation opens its\\n   400\\t  // own handle (the owners' surfaces open theirs), and before any view\\n   401\\t  // write — a sweep failure aborts the compact with the prior view intact.\\n   402\\t  let sweepOutcome: SweepReceipt | { skipped: true };\\n   403\\t  if (opts.sweep === false) {\\n   404\\t    sweepOutcome = { skipped: true };\\n   405\\t  } else {\\n   406\\t    const swept = await runSweep(filePath);\\n   407\\t    if (!swept.ok) return swept;\\n   408\\t    sweepOutcome = swept.value;\\n   409\\t  }\\n   410\\t\\n   411\\t  const opened = openThreadDatabase(filePath);\\n   412\\t  if (!opened.ok) return opened;\\n   413\\t  const db = opened.value;\\n   414\\t  try {\\n   415\\t    if (compactStopped(opts.signal)) {\\n   416\\t      return callerError(\\\"compact_stopped\\\", \\\"compact stopped before assembly\\\");\\n   417\\t    }\\n   418\\t    let inputs;\\n   419\\t    try {\\n   420\\t      inputs = readSelectionInputs(db);\\n   421\\t    } catch (cause) {\\n   422\\t      if (cause instanceof CanonicalCorruptionError) {\\n   423\\t        // Pre-transaction refusal: nothing was written, the prior view and\\n   424\\t        // the record are untouched (AC-2.5).\\n   425\\t        return {\\n   426\\t          ok: false,\\n   427\\t          error: { errorClass: \\\"state_corruption\\\", code: cause.code, reason: cause.message },\\n   428\\t        };\\n   429\\t      }\\n   430\\t      throw cause;\\n   431\\t    }\\n   432\\t    const threadId = readThreadMetadata(db).threadId;\\n   433\\t    const ctx: OperationContext = {\\n   434\\t      db,\\n   435\\t      clock: () => new Date(),\\n   436\\t      threadId,\\n   437\\t      onCommit: () => {},\\n   438\\t      poke: resolveInstancePoke(),\\n   439\\t    };\\n   440\\t    const compactChunkMaterials = new Map<\\n   441\\t      string,\\n   442\\t      { kind: \\\"ready\\\"; content: string } | { kind: \\\"concat\\\"; content: string; reason: string }\\n   443\\t    >();\\n   444\\t    for (const chunk of inputs.chunks) {\\n   445\\t      if (chunk.status !== \\\"closed\\\") continue;\\n   446\\t      for (const derivationType of [\\\"chunk_summary_detailed\\\", \\\"chunk_summary_brief\\\"] as const) {\\n   447\\t        if (compactStopped(opts.signal)) {\\n   448\\t          return callerError(\\\"compact_stopped\\\", \\\"compact stopped during fallback assembly\\\");\\n   449\\t        }\\n   450\\t        const material = turnsDomain.compactChunkMaterial(ctx, chunk.chunkId, derivationType);\\n   451\\t        if (material.kind === \\\"blocked\\\") {\\n   452\\t          return {\\n   453\\t            ok: false,\\n   454\\t            error: {\\n   455\\t              errorClass: \\\"state_corruption\\\",\\n   456\\t              code: \\\"source_damaged\\\",\\n   457\\t              reason: material.reason,\\n   458\\t            },\\n   459\\t          };\\n   460\\t        }\\n   461\\t        compactChunkMaterials.set(`${chunk.chunkId}/${derivationType}`, material);\\n   462\\t      }\\n   463\\t    }\\n   464\\t    inputs = { ...inputs, compactChunkMaterials };\\n   465\\t    const selection = selectArrangement(inputs, {\\n   466\\t      lowerBound: merged.lowerBound,\\n   467\\t      percentages: merged.percentages,\\n   468\\t    });\\n   469\\t\\n   470\\t    const warnings: CompactReceipt[\\\"warnings\\\"] = selection.entries\\n   471\\t      .filter((entry) => entry.derivationUsed === \\\"stored_member_concat\\\")\\n   472\\t      .map((entry) => ({\\n   473\\t        band: entry.band,\\n   474\\t        subjectId: entry.subjectId,\\n   475\\t        derivationType:\\n   476\\t          entry.band === \\\"brief\\\" ? \\\"chunk_summary_brief\\\" : \\\"chunk_summary_detailed\\\",\\n   477\\t        reason: entry.reason ?? \\\"not_ready\\\",\\n   478\\t      }));\\n   479\\t    for (const warning of warnings) {\\n   480\\t      writeLog(ctx, {\\n   481\\t        level: \\\"warning\\\",\\n   482\\t        message: \\\"compact chunk fallback used\\\",\\n   483\\t        derivationType: warning.derivationType,\\n   484\\t        subjectId: warning.subjectId,\\n   485\\t        reason: warning.reason,\\n   486\\t        floorUsed: \\\"stored_member_concat\\\",\\n   487\\t      });\\n   488\\t    }\\n   489\\t\\n   490\\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\\n   491\\t      selection.entries.filter((entry) => entry.band === band);\\n   492\\t    const bands = BAND_ORDER.flatMap((band) => {\\n   493\\t      const entries = entriesByBand(band);\\n   494\\t      if (entries.length === 0) return [];\\n   495\\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\\n   496\\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\\n   497\\t    });\\n   498\\t\\n   499\\t    const createdAt = new Date().toISOString();\\n   500\\t    // view_id is v<compact event order> — deterministic, and deliberately\\n   501\\t    // reused by an intake-free recompact (tech design L395: do not \\\"fix\\\"\\n   502\\t    // into a uniqueness scheme; the singleton row is replaced whole).\\n   503\\t    const viewId = `v${inputs.maxEventOrder}`;\\n   504\\t\\n   505\\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\\n   506\\t    // view-write transaction. An installed hook's throw aborts here —\\n   507\\t    // before BEGIN — so the previous view keeps serving.\\n   508\\t    fireViewInjection(\\\"compact-write\\\");\\n   509\\t\\n   510\\t    replaceViewSnapshot(db, {\\n   511\\t      viewId,\\n   512\\t      createdAt,\\n   513\\t      compactPoint: selection.compactPoint,\\n   514\\t      coveredFrom: selection.coveredFrom,\\n   515\\t      profileName,\\n   516\\t      configJson: JSON.stringify({\\n   517\\t        lowerBound: merged.lowerBound,\\n   518\\t        percentages: merged.percentages,\\n   519\\t      }),\\n   520\\t      arrangementJson: JSON.stringify(\\n   521\\t        selection.entries.map((entry) => ({\\n   522\\t          band: entry.band,\\n   523\\t          subjectKind: entry.subjectKind,\\n   524\\t          subjectId: entry.subjectId,\\n   525\\t          derivationUsed: entry.derivationUsed,\\n   526\\t          degraded: entry.degraded,\\n   527\\t        })),\\n   528\\t      ),\\n   529\\t      gapsJson: JSON.stringify(\\n   530\\t        selection.entries\\n   531\\t          .filter((entry) => entry.gap)\\n   532\\t          .map((entry) => ({\\n   533\\t            band: entry.band,\\n   534\\t            subjectId: entry.subjectId,\\n   535\\t            reason: entry.reason ?? \\\"unknown\\\",\\n   536\\t          })),\\n   537\\t      ),\\n   538\\t      sourceStateJson: JSON.stringify({\\n   539\\t        maxEventOrder: inputs.maxEventOrder,\\n   540\\t        derivationCounts: inputs.derivationCounts,\\n   541\\t      }),\\n   542\\t      bands,\\n   543\\t    });\\n   544\\t\\n   545\\t    const bandReport = {} as CompactReceipt[\\\"bands\\\"];\\n   546\\t    for (const band of BAND_ORDER) {\\n   547\\t      const stored = bands.find((row) => row.band === band);\\n   548\\t      bandReport[band] = {\\n   549\\t        entries: entriesByBand(band).length,\\n   550\\t        tokens: stored?.tokenCount ?? 0,\\n   551\\t      };\\n   552\\t    }\\n   553\\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\\n   554\\t    return {\\n   555\\t      ok: true,\\n   556\\t      value: {\\n   557\\t        viewId,\\n   558\\t        profile: profileName,\\n   559\\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\\n   560\\t        bands: bandReport,\\n   561\\t        tailTokens,\\n   562\\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\\n   563\\t        totalTokens:\\n   564\\t          bandReport.brief.tokens +\\n   565\\t          bandReport.detailed.tokens +\\n   566\\t          bandReport.smooth.tokens +\\n   567\\t          tailTokens,\\n   568\\t        coveredFrom: selection.coveredFrom,\\n   569\\t        compactPoint: selection.compactPoint,\\n   570\\t        degraded: selection.entries\\n   571\\t          .filter((entry) => entry.degraded)\\n   572\\t          .map((entry) => ({\\n   573\\t            band: entry.band,\\n   574\\t            subjectId: entry.subjectId,\\n   575\\t            usedDerivation: entry.derivationUsed,\\n   576\\t          })),\\n   577\\t        gaps: selection.entries\\n   578\\t          .filter((entry) => entry.gap)\\n   579\\t          .map((entry) => ({\\n   580\\t            band: entry.band,\\n   581\\t            subjectId: entry.subjectId,\\n   582\\t            reason: entry.reason ?? \\\"unknown\\\",\\n   583\\t          })),\\n   584\\t        sweep: sweepOutcome,\\n   585\\t        warnings,\\n   586\\t      },\\n   587\\t    };\\n   588\\t  } catch (cause) {\\n   589\\t    return storageFailure(`view compact failed: ${detail(cause)}`);\\n   590\\t  } finally {\\n   591\\t    db.close();\\n   592\\t  }\\n   593\\t}\\n   594\\t\\n   595\\t// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\\n   596\\t\\n   597\\t// The standalone readiness sweep: walk the owners' reports, requeue the\\n   598\\t// transiently-failed derivations through the owners' requeue surfaces, return the\\n   599\\t// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\\n   600\\t// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\\n   601\\t// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\\n   602\\t// Story 5's process suite). Returns without waiting on any queued work\\n   603\\t// (AC-3.2): requeues are row writes; background mode's drain heals later.\\n   604\\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\\n   605\\t  const resolved = await resolveThreadRef(ref);\\n   606\\t  if (!resolved.ok) return resolved;\\n   607\\t  const { filePath } = resolved.value;\\n   608\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   609\\t  try {\\n   610\\t    return await runSweep(filePath);\\n   611\\t  } catch (cause) {\\n   612\\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\\n   613\\t  }\\n   614\\t}\\n   615\\t\\n   616\\t// ── boundary advance (Flow 4: AC-4.3–4.6, 4.9) ───────────────────\\n   617\\t\\n   618\\t// The post-commit advance, Story 4. NOT a host operation: no public advance\\n   619\\t// surface exists (story Anti-Shim Requirements) — the SDK's ThreadViewSurface\\n   620\\t// carries only the five operations, and this function's one production caller\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/snapshot.ts | sed -n '1,340p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/select.ts | sed -n '1,470p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/snapshot.ts | sed -n '1,340p'\\\"\",\"aggregated_output\":\"     1\\t// The pull's read path (Story 1): the stored view snapshot — header plus\\n     2\\t// band rows, absent ⇒ tail-only signal — and the record reads the tail\\n     3\\t// assembly needs (live messages after the compact point, their ready\\n     4\\t// tool-result summaries, the tail token sum). Story 2 adds the one writer:\\n     5\\t// the atomic replace at compact. Direct record/derivation reads are\\n     6\\t// sanctioned for thread-view internals (tech design §System View — the\\n     7\\t// surface-import rule governs code imports, not SQL); what must NOT read\\n     8\\t// derivation directly is the status's derivation counting, which goes\\n     9\\t// through the owners' report surfaces in index.ts.\\n    10\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n    11\\timport type { Band, StoredView } from \\\"../../../shared/view.js\\\";\\n    12\\timport type { RenderingPartKind } from \\\"../../../shared/derivation.js\\\";\\n    13\\t\\n    14\\t// ── view snapshot (header + bands) ────────────────────────────────\\n    15\\t\\n    16\\texport interface ViewSnapshot {\\n    17\\t  viewId: string;\\n    18\\t  createdAt: string;\\n    19\\t  compactPoint: number;\\n    20\\t  coveredFrom: number;\\n    21\\t  gapCount: number;\\n    22\\t  degradedCount: number;\\n    23\\t  // Non-empty bands in gradient order (brief → detailed → smooth), the order\\n    24\\t  // the pull prepends them in.\\n    25\\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\\n    26\\t}\\n    27\\t\\n    28\\tinterface RawViewRow {\\n    29\\t  view_id: string;\\n    30\\t  created_at: string;\\n    31\\t  compact_point: number | bigint;\\n    32\\t  covered_from: number | bigint;\\n    33\\t  arrangement_json: string;\\n    34\\t  gaps_json: string;\\n    35\\t}\\n    36\\t\\n    37\\tconst BAND_GRADIENT_ORDER: readonly Band[] = [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"];\\n    38\\t\\n    39\\t// null ⇒ no view exists (never compacted): the whole record renders as tail\\n    40\\t// from event 1 through the same pull code path — snapshot-absent, not a\\n    41\\t// separate branch (story Anti-Shim Requirements).\\n    42\\texport function readViewSnapshot(db: DatabaseSync): ViewSnapshot | null {\\n    43\\t  const header = db\\n    44\\t    .prepare(\\n    45\\t      `SELECT view_id, created_at, compact_point, covered_from, arrangement_json, gaps_json\\n    46\\t       FROM thread_view WHERE singleton = 1`,\\n    47\\t    )\\n    48\\t    .get() as RawViewRow | undefined;\\n    49\\t  if (header === undefined) return null;\\n    50\\t\\n    51\\t  const arrangement = JSON.parse(header.arrangement_json) as Array<{ degraded?: boolean }>;\\n    52\\t  const gaps = JSON.parse(header.gaps_json) as unknown[];\\n    53\\t  const bandRows = db\\n    54\\t    .prepare(\\n    55\\t      `SELECT band, rendered_text, token_count FROM thread_view_band WHERE view_id = ?`,\\n    56\\t    )\\n    57\\t    .all(header.view_id) as unknown as Array<{\\n    58\\t    band: string;\\n    59\\t    rendered_text: string;\\n    60\\t    token_count: number | bigint;\\n    61\\t  }>;\\n    62\\t  const byBand = new Map(bandRows.map((row) => [row.band, row]));\\n    63\\t\\n    64\\t  return {\\n    65\\t    viewId: header.view_id,\\n    66\\t    createdAt: header.created_at,\\n    67\\t    compactPoint: Number(header.compact_point),\\n    68\\t    coveredFrom: Number(header.covered_from),\\n    69\\t    gapCount: gaps.length,\\n    70\\t    degradedCount: arrangement.filter((entry) => entry.degraded === true).length,\\n    71\\t    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\\n    72\\t      const row = byBand.get(band);\\n    73\\t      return row === undefined\\n    74\\t        ? []\\n    75\\t        : [{ band, renderedText: row.rendered_text, tokenCount: Number(row.token_count) }];\\n    76\\t    }),\\n    77\\t  };\\n    78\\t}\\n    79\\t\\n    80\\t// The full stored row for `describe` (Epic 04 Story 3): everything the\\n    81\\t// compact wrote, parsed verbatim — arrangement, gaps, config, source-state\\n    82\\t// provenance, per-band stored token counts. Reading, never recomputing: the\\n    83\\t// JSON columns are the snapshot, and this read is the only path between\\n    84\\t// them and the describe surface.\\n    85\\texport function readStoredView(db: DatabaseSync): StoredView | null {\\n    86\\t  const header = db\\n    87\\t    .prepare(\\n    88\\t      `SELECT view_id, created_at, compact_point, covered_from, profile_name,\\n    89\\t              config_json, arrangement_json, gaps_json, source_state_json\\n    90\\t       FROM thread_view WHERE singleton = 1`,\\n    91\\t    )\\n    92\\t    .get() as\\n    93\\t    | {\\n    94\\t        view_id: string;\\n    95\\t        created_at: string;\\n    96\\t        compact_point: number | bigint;\\n    97\\t        covered_from: number | bigint;\\n    98\\t        profile_name: string | null;\\n    99\\t        config_json: string;\\n   100\\t        arrangement_json: string;\\n   101\\t        gaps_json: string;\\n   102\\t        source_state_json: string;\\n   103\\t      }\\n   104\\t    | undefined;\\n   105\\t  if (header === undefined) return null;\\n   106\\t\\n   107\\t  const bandRows = db\\n   108\\t    .prepare(`SELECT band, token_count FROM thread_view_band WHERE view_id = ?`)\\n   109\\t    .all(header.view_id) as unknown as Array<{ band: string; token_count: number | bigint }>;\\n   110\\t  const byBand = new Map(bandRows.map((row) => [row.band, row]));\\n   111\\t\\n   112\\t  return {\\n   113\\t    viewId: header.view_id,\\n   114\\t    createdAt: header.created_at,\\n   115\\t    compactPoint: Number(header.compact_point),\\n   116\\t    coveredFrom: Number(header.covered_from),\\n   117\\t    profileName: header.profile_name,\\n   118\\t    config: JSON.parse(header.config_json) as StoredView[\\\"config\\\"],\\n   119\\t    arrangement: JSON.parse(header.arrangement_json) as StoredView[\\\"arrangement\\\"],\\n   120\\t    gaps: JSON.parse(header.gaps_json) as StoredView[\\\"gaps\\\"],\\n   121\\t    sourceState: JSON.parse(header.source_state_json) as StoredView[\\\"sourceState\\\"],\\n   122\\t    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\\n   123\\t      const row = byBand.get(band);\\n   124\\t      return row === undefined ? [] : [{ band, storedTokens: Number(row.token_count) }];\\n   125\\t    }),\\n   126\\t  };\\n   127\\t}\\n   128\\t\\n   129\\t// ── tail record reads ─────────────────────────────────────────────\\n   130\\t\\n   131\\texport interface TailMessageRow {\\n   132\\t  messageId: string;\\n   133\\t  sourceEventOrder: number;\\n   134\\t  kind: RenderingPartKind;\\n   135\\t  // The source event's recorded_at — materialize's entry timestamp (AC-5.2:\\n   136\\t  // generated fields derive from record times, never write-time clocks).\\n   137\\t  recordedAt: string;\\n   138\\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\\n   139\\t}\\n   140\\t\\n   141\\t// Live messages after the compact point in record order, with their projected\\n   142\\t// blocks — the deleted-read filter applied here so a deleted message never\\n   143\\t// reaches rendering (AC-1.x delete filtering).\\n   144\\texport function readTailMessages(db: DatabaseSync, compactPoint: number): TailMessageRow[] {\\n   145\\t  const messageRows = db\\n   146\\t    .prepare(\\n   147\\t      `SELECT m.message_id, m.source_event_order, m.kind, e.recorded_at FROM message m\\n   148\\t       JOIN event e ON e.event_order = m.source_event_order\\n   149\\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\\n   150\\t       ORDER BY m.source_event_order`,\\n   151\\t    )\\n   152\\t    .all(compactPoint) as unknown as Array<{\\n   153\\t    message_id: string;\\n   154\\t    source_event_order: number | bigint;\\n   155\\t    kind: string;\\n   156\\t    recorded_at: string;\\n   157\\t  }>;\\n   158\\t  const blockRows = db\\n   159\\t    .prepare(\\n   160\\t      `SELECT mb.message_id, mb.block_type, mb.content\\n   161\\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\\n   162\\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\\n   163\\t       ORDER BY m.source_event_order, mb.block_index`,\\n   164\\t    )\\n   165\\t    .all(compactPoint) as unknown as Array<{\\n   166\\t    message_id: string;\\n   167\\t    block_type: string;\\n   168\\t    content: string;\\n   169\\t  }>;\\n   170\\t  const blocksByMessage = new Map<string, TailMessageRow[\\\"blocks\\\"]>();\\n   171\\t  for (const row of blockRows) {\\n   172\\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\\n   173\\t    blocks.push({\\n   174\\t      blockType: row.block_type,\\n   175\\t      content: JSON.parse(row.content) as Record<string, unknown>,\\n   176\\t    });\\n   177\\t    blocksByMessage.set(row.message_id, blocks);\\n   178\\t  }\\n   179\\t  return messageRows.map((row) => ({\\n   180\\t    messageId: row.message_id,\\n   181\\t    sourceEventOrder: Number(row.source_event_order),\\n   182\\t    kind: row.kind as RenderingPartKind,\\n   183\\t    recordedAt: row.recorded_at,\\n   184\\t    blocks: blocksByMessage.get(row.message_id) ?? [],\\n   185\\t  }));\\n   186\\t}\\n   187\\t\\n   188\\t// The thread's identity row — materialize's header source (AC-5.2: the\\n   189\\t// header id derives from thread id + view created-at; a never-compacted\\n   190\\t// thread's header uses the thread's created-at).\\n   191\\texport function readThreadMetadata(db: DatabaseSync): { threadId: string; createdAt: string } {\\n   192\\t  const row = db\\n   193\\t    .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\\n   194\\t    .get() as { thread_id: string; created_at: string } | undefined;\\n   195\\t  if (row === undefined) {\\n   196\\t    throw new Error(\\\"thread_metadata singleton row missing (creation writes it)\\\");\\n   197\\t  }\\n   198\\t  return { threadId: row.thread_id, createdAt: row.created_at };\\n   199\\t}\\n   200\\t\\n   201\\t// The tail's token sum for status (AC-2.8): every live message after the\\n   202\\t// compact point, all kinds — the same population the pull renders as tail.\\n   203\\texport function tailTokenSum(db: DatabaseSync, compactPoint: number): number {\\n   204\\t  const row = db\\n   205\\t    .prepare(\\n   206\\t      `SELECT COALESCE(SUM(token_estimate), 0) AS total FROM message\\n   207\\t       WHERE deleted_at IS NULL AND source_event_order > ?`,\\n   208\\t    )\\n   209\\t    .get(compactPoint) as { total: number | bigint };\\n   210\\t  return Number(row.total);\\n   211\\t}\\n   212\\t\\n   213\\t// ── the atomic replace (Story 2, AC-2.6) ──────────────────────────\\n   214\\t\\n   215\\texport interface ViewReplaceInput {\\n   216\\t  viewId: string;\\n   217\\t  createdAt: string;\\n   218\\t  compactPoint: number;\\n   219\\t  coveredFrom: number;\\n   220\\t  profileName: string | null;\\n   221\\t  configJson: string;\\n   222\\t  arrangementJson: string;\\n   223\\t  gapsJson: string;\\n   224\\t  sourceStateJson: string;\\n   225\\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\\n   226\\t}\\n   227\\t\\n   228\\t// Compact's one transaction: delete the singleton view row (the FK cascade\\n   229\\t// drops its bands), insert the new header and bands, and reset the boundary\\n   230\\t// to the compact point (AC-4.7) — all inside one BEGIN IMMEDIATE, so a crash\\n   231\\t// anywhere rolls the whole replace back and the previous view keeps serving\\n   232\\t// (AC-2.6, TC-2.4). Compact is the only writer of these rows; the boundary's\\n   233\\t// other writer is Story 4's advance.\\n   234\\texport function replaceViewSnapshot(db: DatabaseSync, input: ViewReplaceInput): void {\\n   235\\t  db.exec(\\\"BEGIN IMMEDIATE;\\\");\\n   236\\t  try {\\n   237\\t    db.prepare(`DELETE FROM thread_view WHERE singleton = 1`).run();\\n   238\\t    db.prepare(\\n   239\\t      `INSERT INTO thread_view (singleton, view_id, created_at, compact_point, covered_from,\\n   240\\t         profile_name, config_json, arrangement_json, gaps_json, source_state_json)\\n   241\\t       VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\\n   242\\t    ).run(\\n   243\\t      input.viewId,\\n   244\\t      input.createdAt,\\n   245\\t      input.compactPoint,\\n   246\\t      input.coveredFrom,\\n   247\\t      input.profileName,\\n   248\\t      input.configJson,\\n   249\\t      input.arrangementJson,\\n   250\\t      input.gapsJson,\\n   251\\t      input.sourceStateJson,\\n   252\\t    );\\n   253\\t    const insertBand = db.prepare(\\n   254\\t      `INSERT INTO thread_view_band (view_id, band, rendered_text, token_count)\\n   255\\t       VALUES (?, ?, ?, ?)`,\\n   256\\t    );\\n   257\\t    for (const band of input.bands) {\\n   258\\t      insertBand.run(input.viewId, band.band, band.renderedText, band.tokenCount);\\n   259\\t    }\\n   260\\t    db.prepare(\\n   261\\t      `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\\n   262\\t    ).run(input.compactPoint, input.createdAt);\\n   263\\t    db.exec(\\\"COMMIT;\\\");\\n   264\\t  } catch (cause) {\\n   265\\t    db.exec(\\\"ROLLBACK;\\\");\\n   266\\t    throw cause;\\n   267\\t  }\\n   268\\t}\\n   269\\t\\n   270\\t// Ready tool-result summaries by message id — the short-form ladder's first\\n   271\\t// rung. Stored state read verbatim, never derived here (no-inference rule).\\n   272\\texport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\\n   273\\t  const rows = db\\n   274\\t    .prepare(\\n   275\\t      `SELECT subject_id, content FROM derivation\\n   276\\t       WHERE subject_kind = 'message' AND derivation_type = 'tool_result_summary'\\n   277\\t         AND state = 'ready' AND content IS NOT NULL`,\\n   278\\t    )\\n   279\\t    .all() as unknown as Array<{ subject_id: string; content: string }>;\\n   280\\t  return new Map(rows.map((row) => [row.subject_id, row.content]));\\n   281\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/select.ts | sed -n '1,470p'\\\"\",\"aggregated_output\":\"     1\\t// Band selection (Story 2): the six-rule walk from tech design §Deterministic\\n     2\\t// Algorithms — compact point, smooth/detailed/brief fills, rule-5 unchunked\\n     3\\t// turns, rule-6 turnless stragglers — plus the coverage edge (covered_from)\\n     4\\t// and canonical-corruption detection. Two halves, deliberately split:\\n     5\\t//\\n     6\\t//   - readSelectionInputs: the record/derivation reads, with the corruption check\\n     7\\t//     IN the reads, before any transaction opens (story Technical Notes) —\\n     8\\t//     a refusal here means nothing was written, so the prior view is\\n     9\\t//     trivially intact (AC-2.5). Never moved inside the transaction.\\n    10\\t//   - selectArrangement: a pure function over those inputs. No DB handle, no\\n    11\\t//     clock, no provider — same inputs ⇒ same arrangement, byte-for-byte\\n    12\\t//     (AC-2.9; goldens G1–G4 pin the tie-breakers).\\n    13\\t//\\n    14\\t// Tie-breakers, pinned (tech design): inclusion thresholds are ≤; walks are\\n    15\\t// newest-first everywhere; chunk coverage is decided by the chunk's newest\\n    16\\t// member turn. Entry costs are the tokens of the rendered entry text itself\\n    17\\t// (render.ts's renderArrangementEntry, including attached inter-turn notes),\\n    18\\t// so the budgeted tokens are the stored tokens — no second estimate.\\n    19\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n    20\\timport { estimateTokens } from \\\"../../../tech-utils/token-counting/index.js\\\";\\n    21\\timport type { Band } from \\\"../../../shared/view.js\\\";\\n    22\\timport {\\n    23\\t  excerptLine,\\n    24\\t  renderArrangementEntry,\\n    25\\t  resolveBriefRepresentation,\\n    26\\t  resolveDetailedRepresentation,\\n    27\\t  resolveSmoothRepresentation,\\n    28\\t  type DerivationSnapshot,\\n    29\\t  type CompactChunkMaterialSnapshot,\\n    30\\t} from \\\"./render.js\\\";\\n    31\\t\\n    32\\t// Canonical source state needed to identify or read the compacted span is\\n    33\\t// damaged: compact refuses with state_corruption (AC-2.5). Derived-material\\n    34\\t// damage never raises this — it degrades through the ladders instead.\\n    35\\texport class CanonicalCorruptionError extends Error {\\n    36\\t  readonly code: \\\"turn_state_corrupt\\\" | \\\"source_damaged\\\";\\n    37\\t  constructor(code: \\\"turn_state_corrupt\\\" | \\\"source_damaged\\\", reason: string) {\\n    38\\t    super(reason);\\n    39\\t    this.code = code;\\n    40\\t    this.name = \\\"CanonicalCorruptionError\\\";\\n    41\\t  }\\n    42\\t}\\n    43\\t\\n    44\\texport interface SelectionMessage {\\n    45\\t  messageId: string;\\n    46\\t  order: number; // source_event_order\\n    47\\t  kind: string;\\n    48\\t  tokenEstimate: number;\\n    49\\t  turnId: string | null;\\n    50\\t  text: string; // excerpt/note line (render.excerptLine)\\n    51\\t}\\n    52\\t\\n    53\\texport interface SelectionTurn {\\n    54\\t  turnId: string;\\n    55\\t  turnOrder: number;\\n    56\\t  status: \\\"open\\\" | \\\"closed\\\";\\n    57\\t  openedAt: number;\\n    58\\t  closedAt: number | null;\\n    59\\t}\\n    60\\t\\n    61\\texport interface SelectionChunk {\\n    62\\t  chunkId: string;\\n    63\\t  chunkOrder: number;\\n    64\\t  status: \\\"open\\\" | \\\"closed\\\";\\n    65\\t  memberTurnIds: string[]; // member order\\n    66\\t}\\n    67\\t\\n    68\\texport interface SelectionInputs {\\n    69\\t  messages: SelectionMessage[]; // live only, ascending order\\n    70\\t  turns: SelectionTurn[]; // ascending turnOrder\\n    71\\t  chunks: SelectionChunk[]; // ascending chunkOrder\\n    72\\t  derivations: Map<string, DerivationSnapshot>; // `${subjectId}/${derivationType}` (turn/chunk subjects)\\n    73\\t  compactChunkMaterials?: Map<string, CompactChunkMaterialSnapshot>;\\n    74\\t  maxEventOrder: number;\\n    75\\t  derivationCounts: Record<string, Record<string, number>>; // derivation type → state → count\\n    76\\t}\\n    77\\t\\n    78\\texport interface ArrangementEntry {\\n    79\\t  band: Band;\\n    80\\t  subjectKind: \\\"turn\\\" | \\\"chunk\\\";\\n    81\\t  subjectId: string;\\n    82\\t  derivationUsed: string;\\n    83\\t  degraded: boolean;\\n    84\\t  gap: boolean;\\n    85\\t  reason?: string; // gap entries\\n    86\\t  startOrder: number; // oldest event order the entry represents (notes included)\\n    87\\t  text: string; // rendered entry text (the band stores this verbatim)\\n    88\\t  tokens: number;\\n    89\\t}\\n    90\\t\\n    91\\texport interface SelectionResult {\\n    92\\t  compactPoint: number;\\n    93\\t  coveredFrom: number;\\n    94\\t  // Gradient order (brief → detailed → smooth), oldest-first within band —\\n    95\\t  // the order the bands render and the arrangement persists.\\n    96\\t  entries: ArrangementEntry[];\\n    97\\t}\\n    98\\t\\n    99\\t// ── reads (corruption check lives here, pre-transaction) ─────────\\n   100\\t\\n   101\\texport function readSelectionInputs(db: DatabaseSync): SelectionInputs {\\n   102\\t  const turnRows = db\\n   103\\t    .prepare(\\n   104\\t      `SELECT turn_id, turn_order, status, opened_at_event_order, closed_at_event_order, deleted_at\\n   105\\t       FROM turns ORDER BY turn_order`,\\n   106\\t    )\\n   107\\t    .all() as unknown as Array<{\\n   108\\t    turn_id: string;\\n   109\\t    turn_order: number | bigint;\\n   110\\t    status: string;\\n   111\\t    opened_at_event_order: number | bigint;\\n   112\\t    closed_at_event_order: number | bigint | null;\\n   113\\t    deleted_at: string | null;\\n   114\\t  }>;\\n   115\\t  // Referential checks compare against every turn row (a tombstoned turn is\\n   116\\t  // a legitimate reference target, not damage); the selection walk itself\\n   117\\t  // sees live turns only.\\n   118\\t  const turnIds = new Set(turnRows.map((row) => row.turn_id));\\n   119\\t  const turns: SelectionTurn[] = turnRows\\n   120\\t    .filter((row) => row.deleted_at === null)\\n   121\\t    .map((row) => ({\\n   122\\t      turnId: row.turn_id,\\n   123\\t      turnOrder: Number(row.turn_order),\\n   124\\t      status: row.status as \\\"open\\\" | \\\"closed\\\",\\n   125\\t      openedAt: Number(row.opened_at_event_order),\\n   126\\t      closedAt: row.closed_at_event_order === null ? null : Number(row.closed_at_event_order),\\n   127\\t    }));\\n   128\\t\\n   129\\t  // Canonical damage the walk cannot select across (AC-2.5): the Epic 01\\n   130\\t  // turn-state invariant (at most one open turn, open turns carry no close),\\n   131\\t  // and referential damage between the chunk/message rows and their turns.\\n   132\\t  const openTurns = turns.filter((turn) => turn.status === \\\"open\\\");\\n   133\\t  if (openTurns.length > 1) {\\n   134\\t    throw new CanonicalCorruptionError(\\n   135\\t      \\\"turn_state_corrupt\\\",\\n   136\\t      `canonical turn state corrupt: ${openTurns.length} open turns (${openTurns\\n   137\\t        .map((turn) => turn.turnId)\\n   138\\t        .join(\\\", \\\")}); the compacted span cannot be identified`,\\n   139\\t    );\\n   140\\t  }\\n   141\\t  for (const turn of turns) {\\n   142\\t    if (turn.status === \\\"closed\\\" && turn.closedAt === null) {\\n   143\\t      throw new CanonicalCorruptionError(\\n   144\\t        \\\"source_damaged\\\",\\n   145\\t        `canonical turn state corrupt: closed turn ${turn.turnId} carries no close boundary`,\\n   146\\t      );\\n   147\\t    }\\n   148\\t  }\\n   149\\t\\n   150\\t  const messageRows = db\\n   151\\t    .prepare(\\n   152\\t      `SELECT message_id, source_event_order, kind, token_estimate, turn_id\\n   153\\t       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\\n   154\\t    )\\n   155\\t    .all() as unknown as Array<{\\n   156\\t    message_id: string;\\n   157\\t    source_event_order: number | bigint;\\n   158\\t    kind: string;\\n   159\\t    token_estimate: number | bigint;\\n   160\\t    turn_id: string | null;\\n   161\\t  }>;\\n   162\\t  const blockRows = db\\n   163\\t    .prepare(\\n   164\\t      `SELECT mb.message_id, mb.block_type, mb.content\\n   165\\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\\n   166\\t       WHERE m.deleted_at IS NULL\\n   167\\t       ORDER BY m.source_event_order, mb.block_index`,\\n   168\\t    )\\n   169\\t    .all() as unknown as Array<{ message_id: string; block_type: string; content: string }>;\\n   170\\t  const blocksByMessage = new Map<\\n   171\\t    string,\\n   172\\t    Array<{ blockType: string; content: Record<string, unknown> }>\\n   173\\t  >();\\n   174\\t  for (const row of blockRows) {\\n   175\\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\\n   176\\t    blocks.push({\\n   177\\t      blockType: row.block_type,\\n   178\\t      content: JSON.parse(row.content) as Record<string, unknown>,\\n   179\\t    });\\n   180\\t    blocksByMessage.set(row.message_id, blocks);\\n   181\\t  }\\n   182\\t  const messages: SelectionMessage[] = messageRows.map((row) => {\\n   183\\t    if (row.turn_id !== null && !turnIds.has(row.turn_id)) {\\n   184\\t      throw new CanonicalCorruptionError(\\n   185\\t        \\\"source_damaged\\\",\\n   186\\t        `canonical record corrupt: message ${row.message_id} references missing turn ${row.turn_id}`,\\n   187\\t      );\\n   188\\t    }\\n   189\\t    return {\\n   190\\t      messageId: row.message_id,\\n   191\\t      order: Number(row.source_event_order),\\n   192\\t      kind: row.kind,\\n   193\\t      tokenEstimate: Number(row.token_estimate),\\n   194\\t      turnId: row.turn_id,\\n   195\\t      text: excerptLine(row.kind, blocksByMessage.get(row.message_id) ?? []),\\n   196\\t    };\\n   197\\t  });\\n   198\\t\\n   199\\t  const chunkRows = db\\n   200\\t    .prepare(`SELECT chunk_id, chunk_order, status FROM chunk ORDER BY chunk_order`)\\n   201\\t    .all() as unknown as Array<{ chunk_id: string; chunk_order: number | bigint; status: string }>;\\n   202\\t  const memberRows = db\\n   203\\t    .prepare(\\n   204\\t      `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\\n   205\\t       JOIN chunk c ON c.chunk_id = cm.chunk_id\\n   206\\t       ORDER BY c.chunk_order, cm.member_idx`,\\n   207\\t    )\\n   208\\t    .all() as unknown as Array<{ chunk_id: string; turn_id: string; member_idx: number | bigint }>;\\n   209\\t  const membersByChunk = new Map<string, string[]>();\\n   210\\t  for (const row of memberRows) {\\n   211\\t    if (!turnIds.has(row.turn_id)) {\\n   212\\t      throw new CanonicalCorruptionError(\\n   213\\t        \\\"source_damaged\\\",\\n   214\\t        `canonical record corrupt: chunk ${row.chunk_id} membership references missing turn ${row.turn_id}`,\\n   215\\t      );\\n   216\\t    }\\n   217\\t    const members = membersByChunk.get(row.chunk_id) ?? [];\\n   218\\t    members.push(row.turn_id);\\n   219\\t    membersByChunk.set(row.chunk_id, members);\\n   220\\t  }\\n   221\\t  const chunks: SelectionChunk[] = chunkRows.map((row) => ({\\n   222\\t    chunkId: row.chunk_id,\\n   223\\t    chunkOrder: Number(row.chunk_order),\\n   224\\t    status: row.status as \\\"open\\\" | \\\"closed\\\",\\n   225\\t    memberTurnIds: membersByChunk.get(row.chunk_id) ?? [],\\n   226\\t  }));\\n   227\\t\\n   228\\t  const formRows = db\\n   229\\t    .prepare(\\n   230\\t      `SELECT subject_id, derivation_type, state, content, reason FROM derivation\\n   231\\t       WHERE subject_kind IN ('turn', 'chunk')`,\\n   232\\t    )\\n   233\\t    .all() as unknown as Array<{\\n   234\\t    subject_id: string;\\n   235\\t    derivation_type: string;\\n   236\\t    state: string;\\n   237\\t    content: string | null;\\n   238\\t    reason: string | null;\\n   239\\t  }>;\\n   240\\t  const derivations = new Map<string, DerivationSnapshot>();\\n   241\\t  for (const row of formRows) {\\n   242\\t    const snapshot: DerivationSnapshot = { state: row.state as DerivationSnapshot[\\\"state\\\"] };\\n   243\\t    if (row.content !== null) snapshot.content = row.content;\\n   244\\t    if (row.reason !== null) snapshot.reason = row.reason;\\n   245\\t    derivations.set(`${row.subject_id}/${row.derivation_type}`, snapshot);\\n   246\\t  }\\n   247\\t\\n   248\\t  const maxRow = db.prepare(`SELECT COALESCE(MAX(event_order), 0) AS m FROM event`).get() as {\\n   249\\t    m: number | bigint;\\n   250\\t  };\\n   251\\t  const countRows = db\\n   252\\t    .prepare(\\n   253\\t      `SELECT derivation_type, state, COUNT(*) AS n FROM derivation GROUP BY derivation_type, state`,\\n   254\\t    )\\n   255\\t    .all() as unknown as Array<{ derivation_type: string; state: string; n: number | bigint }>;\\n   256\\t  const derivationCounts: Record<string, Record<string, number>> = {};\\n   257\\t  for (const row of countRows) {\\n   258\\t    derivationCounts[row.derivation_type] = {\\n   259\\t      ...derivationCounts[row.derivation_type],\\n   260\\t      [row.state]: Number(row.n),\\n   261\\t    };\\n   262\\t  }\\n   263\\t\\n   264\\t  return { messages, turns, chunks, derivations, maxEventOrder: Number(maxRow.m), derivationCounts };\\n   265\\t}\\n   266\\t\\n   267\\t// ── the pure walk ─────────────────────────────────────────────────\\n   268\\t\\n   269\\texport interface SelectionConfig {\\n   270\\t  lowerBound: number;\\n   271\\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\\n   272\\t}\\n   273\\t\\n   274\\texport function selectArrangement(\\n   275\\t  inputs: SelectionInputs,\\n   276\\t  config: SelectionConfig,\\n   277\\t): SelectionResult {\\n   278\\t  const { messages, turns, chunks, derivations } = inputs;\\n   279\\t  const lookup = (subjectId: string, derivationType: string): DerivationSnapshot | undefined =>\\n   280\\t    derivations.get(`${subjectId}/${derivationType}`);\\n   281\\t  const chunkMaterial = (\\n   282\\t    chunkId: string,\\n   283\\t    derivationType: \\\"chunk_summary_detailed\\\" | \\\"chunk_summary_brief\\\",\\n   284\\t  ): CompactChunkMaterialSnapshot | undefined =>\\n   285\\t    inputs.compactChunkMaterials?.get(`${chunkId}/${derivationType}`);\\n   286\\t  const budget = (share: number): number => (config.lowerBound * share) / 100;\\n   287\\t\\n   288\\t  const turnsById = new Map(turns.map((turn) => [turn.turnId, turn]));\\n   289\\t  const messagesByTurn = new Map<string, SelectionMessage[]>();\\n   290\\t  for (const message of messages) {\\n   291\\t    if (message.turnId === null) continue;\\n   292\\t    const list = messagesByTurn.get(message.turnId) ?? [];\\n   293\\t    list.push(message);\\n   294\\t    messagesByTurn.set(message.turnId, list);\\n   295\\t  }\\n   296\\t\\n   297\\t  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\\n   298\\t  // band assignment, price into its fill cost, and render marked immediately\\n   299\\t  // before its entry. No following turn ⇒ tail by construction.\\n   300\\t  const notesByTurn = new Map<string, SelectionMessage[]>();\\n   301\\t  for (const message of messages) {\\n   302\\t    if (message.turnId !== null) continue;\\n   303\\t    const following = turns.find((turn) => turn.openedAt > message.order);\\n   304\\t    if (following === undefined) continue; // trailing straggler: tail\\n   305\\t    const list = notesByTurn.get(following.turnId) ?? [];\\n   306\\t    list.push(message);\\n   307\\t    notesByTurn.set(following.turnId, list);\\n   308\\t  }\\n   309\\t\\n   310\\t  // The oldest event order a turn's entry represents: its oldest live\\n   311\\t  // message or attached note, falling back to its open boundary.\\n   312\\t  function turnStartOrder(turn: SelectionTurn): number {\\n   313\\t    const candidates = [\\n   314\\t      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\\n   315\\t      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\\n   316\\t    ];\\n   317\\t    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\\n   318\\t  }\\n   319\\t\\n   320\\t  // Rule 1 — compact point: messages newest-first until the estimate sum\\n   321\\t  // first reaches the full share; the point snaps to a turn boundary so the\\n   322\\t  // tail never begins mid-turn. Open-turn messages always land in the tail.\\n   323\\t  const fullBudget = budget(config.percentages.full);\\n   324\\t  const closedTurns = turns.filter((turn) => turn.status === \\\"closed\\\");\\n   325\\t  let compactPoint = 0;\\n   326\\t  if (closedTurns.length > 0 && messages.length > 0) {\\n   327\\t    let sum = 0;\\n   328\\t    let crossing: SelectionMessage | null = null;\\n   329\\t    for (let i = messages.length - 1; i >= 0; i -= 1) {\\n   330\\t      const message = messages[i] as SelectionMessage;\\n   331\\t      sum += message.tokenEstimate;\\n   332\\t      if (sum >= fullBudget) {\\n   333\\t        crossing = message;\\n   334\\t        break;\\n   335\\t      }\\n   336\\t    }\\n   337\\t    // Budget never reached ⇒ the whole record fits the full share:\\n   338\\t    // everything is tail, no bands.\\n   339\\t    compactPoint = crossing === null ? 0 : snapCompactPoint(crossing);\\n   340\\t  }\\n   341\\t\\n   342\\t  function snapCompactPoint(oldestTaken: SelectionMessage): number {\\n   343\\t    // The turn whose boundary the point snaps against: the message's own\\n   344\\t    // turn, or — for a turnless straggler — the turn it attaches to.\\n   345\\t    let candidate: SelectionTurn | undefined =\\n   346\\t      oldestTaken.turnId !== null ? turnsById.get(oldestTaken.turnId) : undefined;\\n   347\\t    if (candidate === undefined && oldestTaken.turnId === null) {\\n   348\\t      candidate = turns.find((turn) => turn.openedAt > oldestTaken.order);\\n   349\\t    }\\n   350\\t    const previousClose = (turn: SelectionTurn): number => {\\n   351\\t      const previous = closedTurns.filter((t) => t.turnOrder < turn.turnOrder).at(-1);\\n   352\\t      return previous?.closedAt ?? 0;\\n   353\\t    };\\n   354\\t    if (candidate === undefined) {\\n   355\\t      // A trailing straggler with no following turn sits after the last turn\\n   356\\t      // boundary, where the compact point cannot pass it: tail begins after\\n   357\\t      // the newest closed turn.\\n   358\\t      return closedTurns.at(-1)?.closedAt ?? 0;\\n   359\\t    }\\n   360\\t    if (candidate.status === \\\"open\\\") {\\n   361\\t      // Open-turn messages are tail regardless of budget; the tail begins at\\n   362\\t      // the open turn's start.\\n   363\\t      return previousClose(candidate);\\n   364\\t    }\\n   365\\t    // Fully covered down to the turn's start (notes included) ⇒ the tail\\n   366\\t    // begins at this turn; otherwise snap FORWARD to the next turn start —\\n   367\\t    // the partially-covered turn falls whole to the bands.\\n   368\\t    if (oldestTaken.order <= turnStartOrder(candidate)) {\\n   369\\t      return previousClose(candidate);\\n   370\\t    }\\n   371\\t    return candidate.closedAt ?? 0;\\n   372\\t  }\\n   373\\t\\n   374\\t  // Band candidates: closed turns wholly behind the compact point. Rule 5 is\\n   375\\t  // structural here — chunked or not, a banded turn is a smooth candidate\\n   376\\t  // (bands are defined by representation, not strict time strata).\\n   377\\t  const bandedTurns = closedTurns.filter(\\n   378\\t    (turn) => turn.closedAt !== null && turn.closedAt <= compactPoint,\\n   379\\t  );\\n   380\\t  const bandedTurnIds = new Set(bandedTurns.map((turn) => turn.turnId));\\n   381\\t\\n   382\\t  function buildTurnEntry(turn: SelectionTurn): ArrangementEntry {\\n   383\\t    const turnMessages = messagesByTurn.get(turn.turnId) ?? [];\\n   384\\t    const excerpt =\\n   385\\t      turnMessages.length === 0 ? null : turnMessages.map((message) => message.text).join(\\\"\\\\n\\\");\\n   386\\t    const rep = resolveSmoothRepresentation(turn.turnId, lookup, excerpt);\\n   387\\t    const noteTexts = (notesByTurn.get(turn.turnId) ?? []).map((note) => note.text);\\n   388\\t    const text = renderArrangementEntry(\\\"turn\\\", turn.turnId, rep, noteTexts);\\n   389\\t    const entry: ArrangementEntry = {\\n   390\\t      band: \\\"smooth\\\",\\n   391\\t      subjectKind: \\\"turn\\\",\\n   392\\t      subjectId: turn.turnId,\\n   393\\t      derivationUsed: rep.derivationUsed,\\n   394\\t      degraded: rep.degraded,\\n   395\\t      gap: rep.gap,\\n   396\\t      startOrder: turnStartOrder(turn),\\n   397\\t      text,\\n   398\\t      tokens: estimateTokens(text),\\n   399\\t    };\\n   400\\t    if (rep.reason !== undefined) entry.reason = rep.reason;\\n   401\\t    return entry;\\n   402\\t  }\\n   403\\t\\n   404\\t  function buildChunkEntry(chunk: SelectionChunk, band: \\\"detailed\\\" | \\\"brief\\\"): ArrangementEntry {\\n   405\\t    const rep =\\n   406\\t      band === \\\"detailed\\\"\\n   407\\t        ? resolveDetailedRepresentation(\\n   408\\t            chunk.chunkId,\\n   409\\t            lookup,\\n   410\\t            chunkMaterial(chunk.chunkId, \\\"chunk_summary_detailed\\\"),\\n   411\\t          )\\n   412\\t        : resolveBriefRepresentation(\\n   413\\t            chunk.chunkId,\\n   414\\t            lookup,\\n   415\\t            chunkMaterial(chunk.chunkId, \\\"chunk_summary_brief\\\"),\\n   416\\t          );\\n   417\\t    const noteTexts = chunk.memberTurnIds.flatMap((turnId) =>\\n   418\\t      (notesByTurn.get(turnId) ?? []).map((note) => note.text),\\n   419\\t    );\\n   420\\t    const text = renderArrangementEntry(\\\"chunk\\\", chunk.chunkId, rep, noteTexts);\\n   421\\t    const memberStarts = chunk.memberTurnIds\\n   422\\t      .map((turnId) => turnsById.get(turnId))\\n   423\\t      .filter((turn): turn is SelectionTurn => turn !== undefined)\\n   424\\t      .map((turn) => turnStartOrder(turn));\\n   425\\t    const entry: ArrangementEntry = {\\n   426\\t      band,\\n   427\\t      subjectKind: \\\"chunk\\\",\\n   428\\t      subjectId: chunk.chunkId,\\n   429\\t      derivationUsed: rep.derivationUsed,\\n   430\\t      degraded: rep.degraded,\\n   431\\t      gap: rep.gap,\\n   432\\t      startOrder: memberStarts.length === 0 ? compactPoint : Math.min(...memberStarts),\\n   433\\t      text,\\n   434\\t      tokens: estimateTokens(text),\\n   435\\t    };\\n   436\\t    if (rep.reason !== undefined) entry.reason = rep.reason;\\n   437\\t    return entry;\\n   438\\t  }\\n   439\\t\\n   440\\t  // The one fill rule, shared by all three bands (rules 2–4, ruling 013's\\n   441\\t  // literal reading): newest-first whole-entry fill, ≤ inclusion (an entry\\n   442\\t  // exactly filling the budget is included), the first crossing entry stops\\n   443\\t  // the band — included only when the band was still empty (one oversized\\n   444\\t  // entry still represents).\\n   445\\t  function fillBand<T>(\\n   446\\t    candidates: readonly T[], // newest-first\\n   447\\t    bandBudget: number,\\n   448\\t    build: (candidate: T) => ArrangementEntry,\\n   449\\t  ): { included: ArrangementEntry[]; rest: T[] } {\\n   450\\t    const included: ArrangementEntry[] = [];\\n   451\\t    let sum = 0;\\n   452\\t    for (let i = 0; i < candidates.length; i += 1) {\\n   453\\t      const entry = build(candidates[i] as T);\\n   454\\t      if (sum + entry.tokens <= bandBudget) {\\n   455\\t        included.push(entry);\\n   456\\t        sum += entry.tokens;\\n   457\\t        continue;\\n   458\\t      }\\n   459\\t      if (included.length === 0) {\\n   460\\t        included.push(entry);\\n   461\\t        return { included, rest: candidates.slice(i + 1) as T[] };\\n   462\\t      }\\n   463\\t      return { included, rest: candidates.slice(i) as T[] };\\n   464\\t    }\\n   465\\t    return { included, rest: [] };\\n   466\\t  }\\n   467\\t\\n   468\\t  // Rule 2 + 5 — smooth band: banded closed turns newest-first, chunked or\\n   469\\t  // not (rule 5 is structural: a closed-but-unchunked turn is a turn, takes\\n   470\\t  // the smooth representation, and consumes this budget).\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/render.ts | sed -n '180,290p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/render.ts | sed -n '180,290p'\\\"\",\"aggregated_output\":\"   180\\t    return {\\n   181\\t      derivationUsed: \\\"lower_band_projection\\\",\\n   182\\t      body: projection.content,\\n   183\\t      degraded: true,\\n   184\\t      gap: false,\\n   185\\t      degradedMarker: \\\"smooth-from-projection\\\",\\n   186\\t    };\\n   187\\t  }\\n   188\\t  if (excerpt !== null) {\\n   189\\t    return {\\n   190\\t      derivationUsed: \\\"message_excerpt\\\",\\n   191\\t      body: deterministicTruncation(excerpt),\\n   192\\t      degraded: true,\\n   193\\t      gap: false,\\n   194\\t      degradedMarker: \\\"smooth-from-excerpt\\\",\\n   195\\t    };\\n   196\\t  }\\n   197\\t  return {\\n   198\\t    derivationUsed: \\\"gap\\\",\\n   199\\t    body: \\\"\\\",\\n   200\\t    degraded: false,\\n   201\\t    gap: true,\\n   202\\t    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\\n   203\\t  };\\n   204\\t}\\n   205\\t\\n   206\\t// Detailed (chunk) ladder: chunk_summary_detailed → chunk_summary_brief →\\n   207\\t// concatenated member projections (truncated, marked) → gap entry.\\n   208\\texport function resolveDetailedRepresentation(\\n   209\\t  chunkId: string,\\n   210\\t  lookup: DerivationLookup,\\n   211\\t  material?: CompactChunkMaterialSnapshot,\\n   212\\t): ResolvedRepresentation {\\n   213\\t  const detailed = lookup(chunkId, \\\"chunk_summary_detailed\\\");\\n   214\\t  if (usable(detailed)) {\\n   215\\t    return { derivationUsed: \\\"chunk_summary_detailed\\\", body: detailed.content, degraded: false, gap: false };\\n   216\\t  }\\n   217\\t  if (material?.kind === \\\"ready\\\") {\\n   218\\t    return {\\n   219\\t      derivationUsed: \\\"chunk_summary_detailed\\\",\\n   220\\t      body: material.content,\\n   221\\t      degraded: false,\\n   222\\t      gap: false,\\n   223\\t    };\\n   224\\t  }\\n   225\\t  if (material?.kind === \\\"concat\\\") {\\n   226\\t    return {\\n   227\\t      derivationUsed: \\\"stored_member_concat\\\",\\n   228\\t      body: material.content,\\n   229\\t      degraded: true,\\n   230\\t      gap: false,\\n   231\\t      degradedMarker: \\\"detailed-from-stored-members\\\",\\n   232\\t      reason: material.reason,\\n   233\\t    };\\n   234\\t  }\\n   235\\t  return {\\n   236\\t    derivationUsed: \\\"gap\\\",\\n   237\\t    body: \\\"\\\",\\n   238\\t    degraded: false,\\n   239\\t    gap: true,\\n   240\\t    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, compact material absent)`,\\n   241\\t  };\\n   242\\t}\\n   243\\t\\n   244\\t// Brief (chunk) ladder: chunk_summary_brief → chunk_summary_detailed\\n   245\\t// truncated → gap entry (no projections rung in this band's ladder).\\n   246\\texport function resolveBriefRepresentation(\\n   247\\t  chunkId: string,\\n   248\\t  lookup: DerivationLookup,\\n   249\\t  material?: CompactChunkMaterialSnapshot,\\n   250\\t): ResolvedRepresentation {\\n   251\\t  const brief = lookup(chunkId, \\\"chunk_summary_brief\\\");\\n   252\\t  if (usable(brief)) {\\n   253\\t    return { derivationUsed: \\\"chunk_summary_brief\\\", body: brief.content, degraded: false, gap: false };\\n   254\\t  }\\n   255\\t  if (material?.kind === \\\"ready\\\") {\\n   256\\t    return {\\n   257\\t      derivationUsed: \\\"chunk_summary_brief\\\",\\n   258\\t      body: material.content,\\n   259\\t      degraded: false,\\n   260\\t      gap: false,\\n   261\\t    };\\n   262\\t  }\\n   263\\t  if (material?.kind === \\\"concat\\\") {\\n   264\\t    return {\\n   265\\t      derivationUsed: \\\"stored_member_concat\\\",\\n   266\\t      body: material.content,\\n   267\\t      degraded: true,\\n   268\\t      gap: false,\\n   269\\t      degradedMarker: \\\"brief-from-stored-members\\\",\\n   270\\t      reason: material.reason,\\n   271\\t    };\\n   272\\t  }\\n   273\\t  return {\\n   274\\t    derivationUsed: \\\"gap\\\",\\n   275\\t    body: \\\"\\\",\\n   276\\t    degraded: false,\\n   277\\t    gap: true,\\n   278\\t    reason: `no usable form (chunk_summary_brief: ${ladderState(brief)}, compact material absent)`,\\n   279\\t  };\\n   280\\t}\\n   281\\t\\n   282\\t// The per-message line an excerpt or note renders — a compact, deterministic\\n   283\\t// projection of the raw record (last-rung fallback, not the tail mapping).\\n   284\\texport function excerptLine(\\n   285\\t  kind: string,\\n   286\\t  blocks: ReadonlyArray<{ blockType: string; content: Record<string, unknown> }>,\\n   287\\t): string {\\n   288\\t  const content = blocks[0]?.content ?? {};\\n   289\\t  const text = typeof content[\\\"text\\\"] === \\\"string\\\" ? content[\\\"text\\\"] : \\\"\\\";\\n   290\\t  switch (kind) {\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/select.ts | sed -n '468,560p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/select.ts | sed -n '468,560p'\\\"\",\"aggregated_output\":\"   468\\t  // Rule 2 + 5 — smooth band: banded closed turns newest-first, chunked or\\n   469\\t  // not (rule 5 is structural: a closed-but-unchunked turn is a turn, takes\\n   470\\t  // the smooth representation, and consumes this budget).\\n   471\\t  const smooth = fillBand(\\n   472\\t    [...bandedTurns].reverse(),\\n   473\\t    budget(config.percentages.smooth),\\n   474\\t    buildTurnEntry,\\n   475\\t  );\\n   476\\t  const oldestSmoothOrder = smooth.included.reduce(\\n   477\\t    (oldest, entry) =>\\n   478\\t      Math.min(oldest, turnsById.get(entry.subjectId)?.turnOrder ?? Number.POSITIVE_INFINITY),\\n   479\\t    Number.POSITIVE_INFINITY,\\n   480\\t  );\\n   481\\t\\n   482\\t  // Rules 3–4 — chunk candidacy: chunks entirely older than the smooth\\n   483\\t  // band's coverage, with the pinned tie-breaker doing the deciding — chunk\\n   484\\t  // coverage is its NEWEST member turn, which must sit behind the compact\\n   485\\t  // point and be older than the smooth band's oldest included turn.\\n   486\\t  const chunkCandidates = chunks\\n   487\\t    .filter((chunk) => chunk.status === \\\"closed\\\")\\n   488\\t    .filter((chunk) => {\\n   489\\t      const liveMembers = chunk.memberTurnIds\\n   490\\t        .map((turnId) => turnsById.get(turnId))\\n   491\\t        .filter((turn): turn is SelectionTurn => turn !== undefined);\\n   492\\t      if (liveMembers.length === 0) return false; // fully tombstoned membership\\n   493\\t      const newestMember = liveMembers.reduce((newest, turn) =>\\n   494\\t        turn.turnOrder > newest.turnOrder ? turn : newest,\\n   495\\t      );\\n   496\\t      return (\\n   497\\t        bandedTurnIds.has(newestMember.turnId) && newestMember.turnOrder < oldestSmoothOrder\\n   498\\t      );\\n   499\\t    })\\n   500\\t    .reverse(); // newest-first\\n   501\\t\\n   502\\t  // Rule 3 — detailed: same fill rule against its share.\\n   503\\t  const detailed = fillBand(chunkCandidates, budget(config.percentages.detailed), (chunk) =>\\n   504\\t    buildChunkEntry(chunk, \\\"detailed\\\"),\\n   505\\t  );\\n   506\\t  // Rule 4 — brief: the remaining chunks, same fill rule against its share.\\n   507\\t  // Chunks remaining after the budget are the coverage edge — outside the\\n   508\\t  // view, reported via covered_from, never phantom gap entries.\\n   509\\t  const brief = fillBand(detailed.rest, budget(config.percentages.brief), (chunk) =>\\n   510\\t    buildChunkEntry(chunk, \\\"brief\\\"),\\n   511\\t  );\\n   512\\t\\n   513\\t  const byRecordOrder = (a: ArrangementEntry, b: ArrangementEntry): number =>\\n   514\\t    a.startOrder - b.startOrder;\\n   515\\t  const entries: ArrangementEntry[] = [\\n   516\\t    ...brief.included.sort(byRecordOrder),\\n   517\\t    ...detailed.included.sort(byRecordOrder),\\n   518\\t    ...smooth.included.sort(byRecordOrder),\\n   519\\t  ];\\n   520\\t\\n   521\\t  const coveredFrom =\\n   522\\t    entries.length === 0\\n   523\\t      ? compactPoint\\n   524\\t      : Math.min(...entries.map((entry) => entry.startOrder));\\n   525\\t\\n   526\\t  return { compactPoint, coveredFrom, entries };\\n   527\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '1,380p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '1,380p'\\\"\",\"aggregated_output\":\"     1\\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\\n     2\\t// wrapper that makes \\\"queueing is what schedules processing\\\" structural\\n     3\\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\\n     4\\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\\n     5\\t// a turn or a summary is; which kinds queue for which sources, and which\\n     6\\t// derivations a kind produces, is the owning domains' business (callers\\n     7\\t// pass the derivation targets in). Writes run on the caller's handle inside the\\n     8\\t// ambient transaction, so items commit (or roll back) with the batch. No\\n     9\\t// public SDK surface: read-back reaches here only through the owning\\n    10\\t// domains' listQueuedWork.\\n    11\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n    12\\timport {\\n    13\\t  createCommitHooks,\\n    14\\t  type OperationContext,\\n    15\\t} from \\\"../../shared/context.js\\\";\\n    16\\timport type {\\n    17\\t  CompletionTx,\\n    18\\t  DerivationType,\\n    19\\t  HandlerDerivationWrite,\\n    20\\t  SubjectKind,\\n    21\\t} from \\\"../../shared/derivation.js\\\";\\n    22\\t\\n    23\\texport type WorkOwner = \\\"messages\\\" | \\\"turns\\\";\\n    24\\texport type WorkKind =\\n    25\\t  | \\\"prompt_smoothing\\\"\\n    26\\t  | \\\"tool_result_summary\\\"\\n    27\\t  | \\\"turn_derivation\\\"\\n    28\\t  | \\\"chunk_summary_detailed\\\"\\n    29\\t  | \\\"chunk_summary_brief\\\";\\n    30\\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\\n    31\\t\\n    32\\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\\n    33\\t// Item contract. Mechanical metadata only — what a kind *means* stays with\\n    34\\t// the owning domain's handler (registered at SDK construction, DD-6).\\n    35\\texport const WORK_KIND_REGISTRY: Readonly<\\n    36\\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \\\"messageId\\\" | \\\"turnId\\\" | \\\"chunkId\\\" }>\\n    37\\t> = {\\n    38\\t  prompt_smoothing: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n    39\\t  tool_result_summary: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n    40\\t  turn_derivation: { owner: \\\"turns\\\", sourceRefKey: \\\"turnId\\\" },\\n    41\\t  chunk_summary_detailed: { owner: \\\"turns\\\", sourceRefKey: \\\"chunkId\\\" },\\n    42\\t  chunk_summary_brief: { owner: \\\"turns\\\", sourceRefKey: \\\"chunkId\\\" },\\n    43\\t};\\n    44\\t\\n    45\\texport interface WorkItemRecord {\\n    46\\t  workItemId: string;\\n    47\\t  owner: WorkOwner;\\n    48\\t  kind: WorkKind;\\n    49\\t  sourceRef: WorkSourceRef;\\n    50\\t  status: \\\"queued\\\"; // the only status written before a drain claims (Epic 02 Story 1)\\n    51\\t  queuedAt: string;\\n    52\\t}\\n    53\\t\\n    54\\t// The derivations an enqueue is scheduling work toward; the owning domain\\n    55\\t// names them (the util stays meaning-blind). Stored in the row's payload so\\n    56\\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\\n    57\\t// derivation's failed/blocked state without asking any domain what a kind means.\\n    58\\texport interface EnqueueDerivationTarget {\\n    59\\t  subjectKind: SubjectKind;\\n    60\\t  subjectId: string;\\n    61\\t  derivationType: DerivationType;\\n    62\\t}\\n    63\\t\\n    64\\texport interface WorkItemInput {\\n    65\\t  owner: WorkOwner;\\n    66\\t  kind: WorkKind;\\n    67\\t  sourceRef: WorkSourceRef;\\n    68\\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\\n    69\\t  derivations?: readonly EnqueueDerivationTarget[]; // carried in payload for the drain's terminal paths\\n    70\\t}\\n    71\\t\\n    72\\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\\n    73\\t  if (\\\"messageId\\\" in sourceRef) return sourceRef.messageId;\\n    74\\t  if (\\\"turnId\\\" in sourceRef) return sourceRef.turnId;\\n    75\\t  return sourceRef.chunkId;\\n    76\\t}\\n    77\\t\\n    78\\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\\n    79\\t// same kind for the same source *at the same version* is the same id —\\n    80\\t// natural idempotency for the repair path — while a post-mutation\\n    81\\t// replacement (next version) never collides with an in-flight pre-mutation\\n    82\\t// item.\\n    83\\texport function recordItem(\\n    84\\t  db: DatabaseSync,\\n    85\\t  input: WorkItemInput,\\n    86\\t  queuedAt: string,\\n    87\\t): WorkItemRecord {\\n    88\\t  const sourceVersion = input.sourceVersion ?? 1;\\n    89\\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\\n    90\\t  db.prepare(\\n    91\\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\\n    92\\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\\n    93\\t  ).run(\\n    94\\t    workItemId,\\n    95\\t    input.owner,\\n    96\\t    input.kind,\\n    97\\t    JSON.stringify(input.sourceRef),\\n    98\\t    queuedAt,\\n    99\\t    JSON.stringify({ sourceVersion, derivations: input.derivations ?? [] }),\\n   100\\t  );\\n   101\\t  return {\\n   102\\t    workItemId,\\n   103\\t    owner: input.owner,\\n   104\\t    kind: input.kind,\\n   105\\t    sourceRef: input.sourceRef,\\n   106\\t    status: \\\"queued\\\",\\n   107\\t    queuedAt,\\n   108\\t  };\\n   109\\t}\\n   110\\t\\n   111\\texport interface EnqueueInput extends WorkItemInput {\\n   112\\t  derivations: readonly EnqueueDerivationTarget[];\\n   113\\t}\\n   114\\t\\n   115\\t// The one way work is scheduled (DD-5): the work row, the derivation's `pending`\\n   116\\t// state row, and the scheduler poke all ride the ambient transaction — they\\n   117\\t// commit together or vanish together. Enqueue is the *only* place a\\n   118\\t// derivation row is created (completion is UPDATE-only); re-enqueueing\\n   119\\t// resets an existing row to pending at the enqueued source version.\\n   120\\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\\n   121\\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\\n   122\\t  const sourceVersion = input.sourceVersion ?? 1;\\n   123\\t  const upsert = ctx.db.prepare(\\n   124\\t    `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, source_version)\\n   125\\t     VALUES (?, ?, ?, 'pending', ?)\\n   126\\t     ON CONFLICT (subject_kind, subject_id, derivation_type) DO UPDATE SET\\n   127\\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\\n   128\\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\\n   129\\t  );\\n   130\\t  for (const target of input.derivations) {\\n   131\\t    upsert.run(target.subjectKind, target.subjectId, target.derivationType, sourceVersion);\\n   132\\t  }\\n   133\\t  ctx.onCommit(() => ctx.poke(ctx.threadId));\\n   134\\t  return item;\\n   135\\t}\\n   136\\t\\n   137\\tinterface RawWorkItemRow {\\n   138\\t  work_item_id: string;\\n   139\\t  owner: string;\\n   140\\t  kind: string;\\n   141\\t  source_ref: string;\\n   142\\t  queued_at: string;\\n   143\\t}\\n   144\\t\\n   145\\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\\n   146\\t// All pure SQL against the caller's open handle, domain-blind. Claim,\\n   147\\t// complete, and the terminal half of failAttempt each own one short\\n   148\\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\\n   149\\t\\n   150\\t// The claimed row as the drain holds it: mechanical fields plus the payload's\\n   151\\t// source version and form targets. `kind` is a plain string here — a raw row\\n   152\\t// with an unregistered kind must still be claimable so the drain can land it\\n   153\\t// failed_terminal instead of skipping it (AC-1.8).\\n   154\\texport interface ClaimedWorkItem {\\n   155\\t  workItemId: string;\\n   156\\t  owner: WorkOwner;\\n   157\\t  kind: string;\\n   158\\t  sourceRef: WorkSourceRef;\\n   159\\t  attempts: number;\\n   160\\t  queuedAt: string;\\n   161\\t  sourceVersion: number;\\n   162\\t  derivations: EnqueueDerivationTarget[];\\n   163\\t}\\n   164\\t\\n   165\\texport type ClaimOutcome =\\n   166\\t  | { outcome: \\\"claimed\\\"; item: ClaimedWorkItem }\\n   167\\t  | { outcome: \\\"empty\\\" }\\n   168\\t  | { outcome: \\\"in_flight\\\"; claimExpiresAt: string }\\n   169\\t  | { outcome: \\\"waiting\\\"; waitingUntil: string };\\n   170\\t\\n   171\\tinterface RawClaimRow {\\n   172\\t  work_item_id: string;\\n   173\\t  owner: string;\\n   174\\t  kind: string;\\n   175\\t  source_ref: string;\\n   176\\t  attempts: number | bigint;\\n   177\\t  queued_at: string;\\n   178\\t  payload: string | null;\\n   179\\t}\\n   180\\t\\n   181\\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\\n   182\\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\\n   183\\t// v5, shared/storage.ts): the backfill created pending derivation rows at\\n   184\\t// source version 1 for these kinds, and a terminal failure must find them —\\n   185\\t// otherwise exhaustion would delete the work row and strand the backfilled\\n   186\\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\\n   187\\tconst LEGACY_KIND_DERIVATIONS: Partial<\\n   188\\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; derivationType: DerivationType }>>\\n   189\\t> = {\\n   190\\t  prompt_smoothing: [{ subjectKind: \\\"message\\\", derivationType: \\\"smoothed_prompt\\\" }],\\n   191\\t  tool_result_summary: [{ subjectKind: \\\"message\\\", derivationType: \\\"tool_result_summary\\\" }],\\n   192\\t  turn_derivation: [\\n   193\\t    { subjectKind: \\\"turn\\\", derivationType: \\\"turn_rendering\\\" },\\n   194\\t    { subjectKind: \\\"turn\\\", derivationType: \\\"lower_band_projection\\\" },\\n   195\\t  ],\\n   196\\t};\\n   197\\t\\n   198\\tfunction legacyDerivationTargets(kind: string, sourceRef: WorkSourceRef): EnqueueDerivationTarget[] {\\n   199\\t  const mapped = LEGACY_KIND_DERIVATIONS[kind];\\n   200\\t  if (mapped === undefined) return [];\\n   201\\t  const subjectId = sourceIdOf(sourceRef);\\n   202\\t  return mapped.map((target) => ({ ...target, subjectId }));\\n   203\\t}\\n   204\\t\\n   205\\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\\n   206\\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\\n   207\\t  const payload =\\n   208\\t    row.payload === null\\n   209\\t      ? // Pre-v5 row: version 1 (matching the backfill) and derivation targets\\n   210\\t        // reconstructed from the backfill's own mapping.\\n   211\\t        { sourceVersion: 1, derivations: legacyDerivationTargets(row.kind, sourceRef) }\\n   212\\t      : (JSON.parse(row.payload) as { sourceVersion?: number; derivations?: EnqueueDerivationTarget[] });\\n   213\\t  return {\\n   214\\t    workItemId: row.work_item_id,\\n   215\\t    owner: row.owner as WorkOwner,\\n   216\\t    kind: row.kind,\\n   217\\t    sourceRef,\\n   218\\t    attempts: Number(row.attempts),\\n   219\\t    queuedAt: row.queued_at,\\n   220\\t    sourceVersion: payload.sourceVersion ?? 1,\\n   221\\t    derivations: payload.derivations ?? [],\\n   222\\t  };\\n   223\\t}\\n   224\\t\\n   225\\t// Head-first, never skip-ahead: the claim decision is made against the oldest\\n   226\\t// live row only — a later eligible row is never considered while an older\\n   227\\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\\n   228\\t// write split: the race window is the bug class). The CASE increments\\n   229\\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\\n   230\\t// run died or hung, and the increment makes the crash visible in the report\\n   231\\t// and counts it against the retry budget; normal claims never touch it.\\n   232\\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\\n   233\\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\\n   234\\t  db.exec(\\\"BEGIN IMMEDIATE;\\\");\\n   235\\t  try {\\n   236\\t    const claimed = db\\n   237\\t      .prepare(\\n   238\\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\\n   239\\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\\n   240\\t         WHERE work_item_id = (\\n   241\\t           SELECT work_item_id FROM (\\n   242\\t             SELECT work_item_id, status, eligible_at, claim_expires_at\\n   243\\t             FROM work_item WHERE status IN ('queued', 'claimed')\\n   244\\t             ORDER BY rowid LIMIT 1\\n   245\\t           )\\n   246\\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\\n   247\\t              OR (status = 'claimed' AND claim_expires_at <= ?)\\n   248\\t         )\\n   249\\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\\n   250\\t      )\\n   251\\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\\n   252\\t    if (claimed !== undefined) {\\n   253\\t      db.exec(\\\"COMMIT;\\\");\\n   254\\t      return { outcome: \\\"claimed\\\", item: toClaimedItem(claimed) };\\n   255\\t    }\\n   256\\t    // No row claimable: re-read the head inside the same transaction to\\n   257\\t    // classify the stop. A claimed head with a live lease gates the queue\\n   258\\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\\n   259\\t    // (waiting) — strict ordering, never reordered around the head.\\n   260\\t    const head = db\\n   261\\t      .prepare(\\n   262\\t        `SELECT status, eligible_at, claim_expires_at\\n   263\\t         FROM work_item WHERE status IN ('queued', 'claimed')\\n   264\\t         ORDER BY rowid LIMIT 1`,\\n   265\\t      )\\n   266\\t      .get() as unknown as\\n   267\\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\\n   268\\t      | undefined;\\n   269\\t    db.exec(\\\"COMMIT;\\\");\\n   270\\t    if (head === undefined) return { outcome: \\\"empty\\\" };\\n   271\\t    if (head.status === \\\"claimed\\\") {\\n   272\\t      return { outcome: \\\"in_flight\\\", claimExpiresAt: head.claim_expires_at ?? \\\"\\\" };\\n   273\\t    }\\n   274\\t    return { outcome: \\\"waiting\\\", waitingUntil: head.eligible_at ?? \\\"\\\" };\\n   275\\t  } catch (cause) {\\n   276\\t    db.exec(\\\"ROLLBACK;\\\");\\n   277\\t    throw cause;\\n   278\\t  }\\n   279\\t}\\n   280\\t\\n   281\\t// Completion: the version-checked derivation writes and the item row's deletion in\\n   282\\t// one short transaction (DD-1: terminal transition deletes the row; the\\n   283\\t// disposition is reported in-memory, never stored). UPDATE-only, never\\n   284\\t// upsert — the pending row exists from enqueue; a write that finds no row at\\n   285\\t// the item's source version is discarded as stale (DD-3 truth table). The\\n   286\\t// optional onApplied hook (Story 3) runs inside this same transaction, after\\n   287\\t// the derivation writes and only when they landed — chunk placement and the\\n   288\\t// close→summary enqueues ride the completion commit; its onCommit\\n   289\\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\\n   290\\texport function complete(\\n   291\\t  db: DatabaseSync,\\n   292\\t  item: ClaimedWorkItem,\\n   293\\t  writes: readonly HandlerDerivationWrite[],\\n   294\\t  derivedAt: string,\\n   295\\t  onApplied?: (tx: CompletionTx) => void,\\n   296\\t): \\\"done\\\" | \\\"stale_discarded\\\" {\\n   297\\t  const hooks = createCommitHooks();\\n   298\\t  db.exec(\\\"BEGIN IMMEDIATE;\\\");\\n   299\\t  try {\\n   300\\t    let hits = 0;\\n   301\\t    const update = db.prepare(\\n   302\\t      `UPDATE derivation\\n   303\\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = NULL, derived_at = ?\\n   304\\t       WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ? AND source_version = ?`,\\n   305\\t    );\\n   306\\t    for (const write of writes) {\\n   307\\t      const changed = update.run(\\n   308\\t        write.content,\\n   309\\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\\n   310\\t        derivedAt,\\n   311\\t        write.subjectKind,\\n   312\\t        write.subjectId,\\n   313\\t        write.derivationType,\\n   314\\t        item.sourceVersion,\\n   315\\t      );\\n   316\\t      hits += Number(changed.changes);\\n   317\\t    }\\n   318\\t    const stale = writes.length > 0 && hits === 0;\\n   319\\t    if (!stale && onApplied !== undefined) {\\n   320\\t      onApplied({ db, onCommit: hooks.register });\\n   321\\t    }\\n   322\\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\\n   323\\t    db.exec(\\\"COMMIT;\\\");\\n   324\\t    hooks.flush();\\n   325\\t    return stale ? \\\"stale_discarded\\\" : \\\"done\\\";\\n   326\\t  } catch (cause) {\\n   327\\t    db.exec(\\\"ROLLBACK;\\\");\\n   328\\t    throw cause;\\n   329\\t  }\\n   330\\t}\\n   331\\t\\n   332\\texport interface RetryPolicy {\\n   333\\t  budget: number;\\n   334\\t  backoffBaseMs: number;\\n   335\\t  backoffCapMs: number;\\n   336\\t}\\n   337\\t\\n   338\\texport type FailAttemptResult =\\n   339\\t  | { terminal: false; attempts: number; eligibleAt: string }\\n   340\\t  | { terminal: true; attempts: number };\\n   341\\t\\n   342\\t// Terminal failure: the derivation rows land `failed` (or `blocked` for source\\n   343\\t// damage) carrying the final reason plus attempts/last-error copied onto the\\n   344\\t// derivation's metadata, and the item row is deleted — one transaction (DD-1).\\n   345\\t// Derivation writes stay version-checked: if a mutation moved the source since this\\n   346\\t// item was queued, the stale failure must not stamp the rebuilt derivation.\\n   347\\texport function failTerminal(\\n   348\\t  db: DatabaseSync,\\n   349\\t  item: ClaimedWorkItem,\\n   350\\t  opts: { reason: string; formState: \\\"failed\\\" | \\\"blocked\\\"; attempts: number; now: string },\\n   351\\t): void {\\n   352\\t  db.exec(\\\"BEGIN IMMEDIATE;\\\");\\n   353\\t  try {\\n   354\\t    const update = db.prepare(\\n   355\\t      `UPDATE derivation\\n   356\\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\\n   357\\t       WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ? AND source_version = ?`,\\n   358\\t    );\\n   359\\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\\n   360\\t    for (const target of item.derivations) {\\n   361\\t      update.run(\\n   362\\t        opts.formState,\\n   363\\t        opts.reason,\\n   364\\t        metadata,\\n   365\\t        opts.now,\\n   366\\t        target.subjectKind,\\n   367\\t        target.subjectId,\\n   368\\t        target.derivationType,\\n   369\\t        item.sourceVersion,\\n   370\\t      );\\n   371\\t    }\\n   372\\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\\n   373\\t    db.exec(\\\"COMMIT;\\\");\\n   374\\t  } catch (cause) {\\n   375\\t    db.exec(\\\"ROLLBACK;\\\");\\n   376\\t    throw cause;\\n   377\\t  }\\n   378\\t}\\n   379\\t\\n   380\\t// A failed run counts itself. Under budget and retryable: the row goes back\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,340p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,340p'\\\"\",\"aggregated_output\":\"     1\\t// Epic 02 shared vocabulary: the derivation state machine's types, the\\n     2\\t// provider seam, and the handler contract. Both owning domains (messages,\\n     3\\t// turns) consume these; neither owns them — the repair report, the mutation\\n     4\\t// cascade, and the drain all speak this vocabulary across domain lines, so it\\n     5\\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\\n     6\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n     7\\t// Type-only and erased at build: the runtime graph stays one-directional\\n     8\\t// (inference/ imports shared/, never the reverse).\\n     9\\timport type { InferenceConfig } from \\\"../inference/types.js\\\";\\n    10\\timport type { ResolvedViewConfig, SdkViewConfig } from \\\"./view.js\\\";\\n    11\\t\\n    12\\texport type SubjectKind = \\\"message\\\" | \\\"turn\\\" | \\\"chunk\\\";\\n    13\\t\\n    14\\t// The kind set is a runtime constant with the type derived from it, so code\\n    15\\t// that must cover every kind — assignment validation above all (Epic 05\\n    16\\t// AC-1.3) — iterates the exported set instead of maintaining a second\\n    17\\t// literal list that can drift.\\n    18\\texport const DERIVATION_TYPES = [\\n    19\\t  \\\"smoothed_prompt\\\",\\n    20\\t  \\\"tool_result_summary\\\",\\n    21\\t  \\\"turn_rendering\\\",\\n    22\\t  \\\"lower_band_projection\\\",\\n    23\\t  \\\"chunk_summary_detailed\\\",\\n    24\\t  \\\"chunk_summary_brief\\\",\\n    25\\t] as const;\\n    26\\t\\n    27\\texport type DerivationType = (typeof DERIVATION_TYPES)[number];\\n    28\\t\\n    29\\texport type DerivationState = \\\"pending\\\" | \\\"ready\\\" | \\\"failed\\\" | \\\"blocked\\\";\\n    30\\t\\n    31\\t// Outcome on tool-activity summaries — mechanically stamped from the record\\n    32\\t// (isError/presence), never authored by the provider (AC-2.4).\\n    33\\texport type ToolOutcome = \\\"succeeded\\\" | \\\"failed\\\" | \\\"unknown\\\";\\n    34\\t\\n    35\\t// A composed derivation's record of a dependency that fell back during composition:\\n    36\\t// names the source record and the derivation type that was not ready (AC-3.2/3.3).\\n    37\\texport interface DependencyGap {\\n    38\\t  subjectKind: SubjectKind;\\n    39\\t  subjectId: string;\\n    40\\t  derivationType: DerivationType;\\n    41\\t}\\n    42\\t\\n    43\\t// The read shape for one derivation's state row (DD-2, DD-3).\\n    44\\texport interface Derivation {\\n    45\\t  subjectKind: SubjectKind;\\n    46\\t  subjectId: string;\\n    47\\t  derivationType: DerivationType;\\n    48\\t  state: DerivationState;\\n    49\\t  content?: string; // ready only\\n    50\\t  reason?: string; // failed | blocked\\n    51\\t  sourceVersion: number; // which version of the source this derivation derives from (DD-3)\\n    52\\t  gaps?: DependencyGap[]; // composed derivations; landed-with-fallback record\\n    53\\t  metadata?: DerivationMetadata; // mechanically stamped fields; never provider-authored\\n    54\\t  derivedAt?: string;\\n    55\\t}\\n    56\\t\\n    57\\t// One tool call's or result's receipt within a turn's composed account\\n    58\\t// (AC-3.8): the account text — what changed, as composed — plus the\\n    59\\t// mechanically derived outcome. Derived from the composition input, never\\n    60\\t// from provider prose; stamped on the turn_rendering form so the chunk\\n    61\\t// summaries can read receipts machine-readably in turn order.\\n    62\\texport interface ToolRunReceipt {\\n    63\\t  messageId: string;\\n    64\\t  activity: \\\"tool_call\\\" | \\\"tool_result\\\";\\n    65\\t  account: string;\\n    66\\t  outcome: ToolOutcome;\\n    67\\t}\\n    68\\t\\n    69\\t// Mechanically stamped derivation metadata: tool outcomes (AC-2.4), the turn\\n    70\\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\\n    71\\t// final attempts/last-error copied from the work item before its row is\\n    72\\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\\n    73\\t// lives here).\\n    74\\texport interface DerivationMetadata {\\n    75\\t  outcome?: ToolOutcome;\\n    76\\t  receipts?: ToolRunReceipt[];\\n    77\\t  attempts?: number;\\n    78\\t  lastError?: string;\\n    79\\t  // Epic 05 (DD-4): which provider/model/prompt produced the content —\\n    80\\t  // copied from the ProviderResult's config-known strings, never authored\\n    81\\t  // from model output. The deterministic provider never sets it.\\n    82\\t  provenance?: ProviderProvenance;\\n    83\\t}\\n    84\\t\\n    85\\t// One row of an owner's repair report (Flow 4): the derivation's durable state\\n    86\\t// joined with the queue's mechanical detail for the live item still working\\n    87\\t// toward it, if any. The five operational situations read from this one row:\\n    88\\t// never-attempted (pending, no queue), retrying (pending + queue with\\n    89\\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\\n    90\\t// ever needs a queue API.\\n    91\\texport interface DerivationReportEntry extends Derivation {\\n    92\\t  queue?: {\\n    93\\t    status: \\\"queued\\\" | \\\"claimed\\\";\\n    94\\t    attempts: number;\\n    95\\t    lastError?: string;\\n    96\\t    eligibleAt?: string;\\n    97\\t  };\\n    98\\t}\\n    99\\t\\n   100\\t// ── provider seam (DD-7) ─────────────────────────────────────────\\n   101\\t// Every operation returns content or a structured failure carrying\\n   102\\t// retryable-or-not; classification is the adapter's duty.\\n   103\\t// Provenance: the three config-known assignment strings, stamped by the\\n   104\\t// inference adapter (it alone knows the assignment) and copied by handlers\\n   105\\t// into derivation metadata (Epic 05 DD-4). Never derived from model output.\\n   106\\texport interface ProviderProvenance {\\n   107\\t  provider: string;\\n   108\\t  model: string;\\n   109\\t  prompt: string;\\n   110\\t}\\n   111\\t\\n   112\\texport type ProviderResult =\\n   113\\t  | { ok: true; text: string; provenance?: ProviderProvenance }\\n   114\\t  | { ok: false; retryable: boolean; reason: string };\\n   115\\t\\n   116\\t// Message kinds a rendering part can carry — mirrors the intake event-kind\\n   117\\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\\n   118\\t// rather than imported: shared/ may not import domains/.\\n   119\\texport type RenderingPartKind =\\n   120\\t  | \\\"user_prompt\\\"\\n   121\\t  | \\\"assistant_text\\\"\\n   122\\t  | \\\"assistant_thinking\\\"\\n   123\\t  | \\\"runtime_note\\\"\\n   124\\t  | \\\"tool_call\\\"\\n   125\\t  | \\\"tool_result\\\";\\n   126\\t\\n   127\\texport interface RenderingPart {\\n   128\\t  messageId: string;\\n   129\\t  kind: RenderingPartKind;\\n   130\\t  text: string; // ready derivation content, or raw/truncated fallback\\n   131\\t  fallback: boolean; // true ⇒ gap recorded\\n   132\\t  outcome?: ToolOutcome; // tool activity only\\n   133\\t}\\n   134\\t\\n   135\\texport interface DerivationProvider {\\n   136\\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\\n   137\\t  summarizeToolResult(i: {\\n   138\\t    toolName: string;\\n   139\\t    content: string;\\n   140\\t    outcome?: ToolOutcome;\\n   141\\t    targetTokens?: number;\\n   142\\t    guidance?: string;\\n   143\\t  }): Promise<ProviderResult>;\\n   144\\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\\n   145\\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\\n   146\\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\\n   147\\t  // the members' tool-run receipts (what changed, outcome) alongside the\\n   148\\t  // projections; brief receives outcomes only — receipt text is stripped\\n   149\\t  // before the provider is called, so brief structurally cannot leak it.\\n   150\\t  // The receipt fields are optional in the type for callers without member\\n   151\\t  // context (the production chunk handlers always pass them).\\n   152\\t  summarizeChunkDetailed(i: {\\n   153\\t    memberProjections: string[];\\n   154\\t    memberReceipts?: ToolRunReceipt[][];\\n   155\\t  }): Promise<ProviderResult>;\\n   156\\t  summarizeChunkBrief(i: {\\n   157\\t    memberProjections: string[];\\n   158\\t    memberOutcomes?: ToolOutcome[][];\\n   159\\t  }): Promise<ProviderResult>;\\n   160\\t}\\n   161\\t\\n   162\\texport const PROVIDER_OPERATIONS = [\\n   163\\t  \\\"smoothPrompt\\\",\\n   164\\t  \\\"summarizeToolResult\\\",\\n   165\\t  \\\"composeTurnRendering\\\",\\n   166\\t  \\\"projectLowerBand\\\",\\n   167\\t  \\\"summarizeChunkDetailed\\\",\\n   168\\t  \\\"summarizeChunkBrief\\\",\\n   169\\t] as const;\\n   170\\t\\n   171\\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\\n   172\\t\\n   173\\t// ── SDK assembly config (tech design §Interfaces) ────────────────\\n   174\\t// Provider arrival is exactly one of `provider` (direct injection,\\n   175\\t// unchanged — the deterministic test default) or `inference` (host\\n   176\\t// model-call function + per-kind assignments, Epic 05 DD-5). Both or\\n   177\\t// neither is a construction TypeError naming the XOR rule (AC-1.1).\\n   178\\texport interface SdkConfig {\\n   179\\t  provider?: DerivationProvider;\\n   180\\t  inference?: InferenceConfig;\\n   181\\t  mode: \\\"background\\\" | \\\"manual\\\";\\n   182\\t  clock?: () => Date;\\n   183\\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\\n   184\\t  smoothing?: { maxInferenceTokens: number }; // 4000\\n   185\\t  toolResult?: {\\n   186\\t    smallTierTokens: number;\\n   187\\t    largeTierTokens: number;\\n   188\\t    smallTargetRatio: number;\\n   189\\t    midTargetRatio: number;\\n   190\\t  }; // 1000 / 5000 / 0.15 / 0.04\\n   191\\t  lease?: { durationMs: number }; // 120000\\n   192\\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\\n   193\\t  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\\n   194\\t}\\n   195\\t\\n   196\\t// Every optional filled by createSdk's central defaults.\\n   197\\texport interface ResolvedSdkConfig {\\n   198\\t  provider: DerivationProvider;\\n   199\\t  mode: \\\"background\\\" | \\\"manual\\\";\\n   200\\t  clock: () => Date;\\n   201\\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\\n   202\\t  smoothing: { maxInferenceTokens: number };\\n   203\\t  toolResult: {\\n   204\\t    smallTierTokens: number;\\n   205\\t    largeTierTokens: number;\\n   206\\t    smallTargetRatio: number;\\n   207\\t    midTargetRatio: number;\\n   208\\t  };\\n   209\\t  lease: { durationMs: number };\\n   210\\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\\n   211\\t  view: ResolvedViewConfig;\\n   212\\t}\\n   213\\t\\n   214\\t// ── handler contract (DD-6; the map's value type) ────────────────\\n   215\\texport interface HandlerRunContext {\\n   216\\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\\n   217\\t  provider: DerivationProvider;\\n   218\\t  clock: () => Date;\\n   219\\t  config: ResolvedSdkConfig;\\n   220\\t}\\n   221\\t\\n   222\\t// A successful handler hands its derivation content back as data; the\\n   223\\t// drain's completion transaction performs the version-checked UPDATE and the\\n   224\\t// item-row deletion atomically (tech design §Mechanics: completion is one\\n   225\\t// short BEGIN IMMEDIATE doing the derivation write and the delete). The handler\\n   226\\t// never opens that transaction itself, so the version check and the\\n   227\\t// done/stale_discarded disposition stay in one place — the queue util.\\n   228\\texport interface HandlerDerivationWrite {\\n   229\\t  subjectKind: SubjectKind;\\n   230\\t  subjectId: string;\\n   231\\t  derivationType: DerivationType;\\n   232\\t  content: string;\\n   233\\t  metadata?: DerivationMetadata;\\n   234\\t  gaps?: DependencyGap[];\\n   235\\t}\\n   236\\t\\n   237\\t// The completion-transaction hook (Story 3): work that must land atomically\\n   238\\t// with the version-checked derivation writes — chunk placement and the\\n   239\\t// close→summary enqueues above all. The queue util invokes it inside the\\n   240\\t// completion's BEGIN IMMEDIATE, after the derivation writes and only when they hit\\n   241\\t// (a stale completion must not place a turn or enqueue summaries); onCommit\\n   242\\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\\n   243\\t// crash leaves either a placed turn with its enqueues or nothing — never a\\n   244\\t// derived-but-unplaced turn.\\n   245\\texport interface CompletionTx {\\n   246\\t  db: DatabaseSync;\\n   247\\t  onCommit: (fn: () => void) => void;\\n   248\\t}\\n   249\\t\\n   250\\texport type HandlerOutcome =\\n   251\\t  | { ok: true; derivations?: HandlerDerivationWrite[]; onApplied?: (tx: CompletionTx) => void }\\n   252\\t  | { ok: false; retryable: boolean; reason: string }\\n   253\\t  | { ok: false; blocked: true; reason: string }; // source damage → derivation blocked, item terminal\\n   254\\t\\n   255\\t// item is the queue util's WorkItemRecord; typed structurally here so the\\n   256\\t// shared layer does not depend on the util's module (and vice versa stays\\n   257\\t// one-directional: tech-utils imports shared).\\n   258\\texport type WorkHandler = (\\n   259\\t  run: HandlerRunContext,\\n   260\\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\\n   261\\t) => Promise<HandlerOutcome>;\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/storage.ts | sed -n '1,260p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/storage.ts | sed -n '1,260p'\\\"\",\"aggregated_output\":\"     1\\timport { DatabaseSync } from \\\"node:sqlite\\\";\\n     2\\t\\n     3\\texport interface Migration {\\n     4\\t  version: number; // 1-based, strictly increasing\\n     5\\t  statements: readonly string[];\\n     6\\t}\\n     7\\t\\n     8\\tconst databasePaths = new WeakMap<DatabaseSync, string>();\\n     9\\t\\n    10\\texport function openDatabase(path: string): DatabaseSync {\\n    11\\t  const db = new DatabaseSync(path);\\n    12\\t  databasePaths.set(db, path);\\n    13\\t  db.exec(\\\"PRAGMA journal_mode = WAL;\\\");\\n    14\\t  db.exec(\\\"PRAGMA foreign_keys = ON;\\\");\\n    15\\t  db.exec(\\\"PRAGMA busy_timeout = 5000;\\\");\\n    16\\t  db.exec(\\\"PRAGMA synchronous = NORMAL;\\\");\\n    17\\t  return db;\\n    18\\t}\\n    19\\t\\n    20\\texport function databasePathFor(db: DatabaseSync): string | undefined {\\n    21\\t  return databasePaths.get(db);\\n    22\\t}\\n    23\\t\\n    24\\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\\n    25\\t// on the existing work_item table, the derivation state table, the chunk\\n    26\\t// tables, and the projection-level delete stamps. The whole epic's schema\\n    27\\t// lands in one version — behavior arrives story by story. Assembled into the\\n    28\\t// thread-file migration history by threads/internal/create.ts.\\n    29\\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\\n    30\\t  // claim mechanics on the existing table (DD-1: no disposition column —\\n    31\\t  // queue rows are live work only; terminal rows are deleted and their\\n    32\\t  // outcomes reported in-memory; durable outcome state lives on derivation)\\n    33\\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\\n    34\\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\\n    35\\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\\n    36\\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\\n    37\\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\\n    38\\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\\n    39\\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\\n    40\\t  // inside an index definition, so the index covers the two real columns and\\n    41\\t  // claimNext's ORDER BY rowid walks the head as before.\\n    42\\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\\n    43\\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\\n    44\\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\\n    45\\t  // call id — never a block scan (anti-shim requirement).\\n    46\\t  `CREATE INDEX idx_message_block_tool_call_id\\n    47\\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\\n    48\\t  `CREATE TABLE derived_form (\\n    49\\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\\n    50\\t    subject_id   TEXT NOT NULL,\\n    51\\t    form         TEXT NOT NULL,\\n    52\\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\\n    53\\t    content      TEXT,\\n    54\\t    reason       TEXT,\\n    55\\t    metadata     TEXT,\\n    56\\t    source_version INTEGER NOT NULL DEFAULT 1,\\n    57\\t    gaps         TEXT,\\n    58\\t    derived_at   TEXT,\\n    59\\t    PRIMARY KEY (subject_kind, subject_id, form)\\n    60\\t  );`,\\n    61\\t  `CREATE TABLE chunk (\\n    62\\t    chunk_id     TEXT PRIMARY KEY,\\n    63\\t    chunk_order  INTEGER NOT NULL UNIQUE,\\n    64\\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\\n    65\\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\\n    66\\t  );`,\\n    67\\t  `CREATE TABLE chunk_member (\\n    68\\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\\n    69\\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\\n    70\\t    member_idx INTEGER NOT NULL,\\n    71\\t    PRIMARY KEY (chunk_id, member_idx)\\n    72\\t  );`,\\n    73\\t  // projection-level delete (the record keeps everything; reads filter)\\n    74\\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\\n    75\\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\\n    76\\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\\n    77\\t  // UPDATE-only completion finds them (row missing must mean deleted).\\n    78\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    79\\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\\n    80\\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\\n    81\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    82\\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\\n    83\\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\\n    84\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    85\\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\\n    86\\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\\n    87\\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n    88\\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\\n    89\\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\\n    90\\t];\\n    91\\t\\n    92\\t// Epic 03's single migration (tech design §Storage): the thread-view\\n    93\\t// snapshot tables and the visibility boundary, living beside the record they\\n    94\\t// render so a thread file stays self-contained and snapshot-portable.\\n    95\\t// Singletons are CHECK-enforced structurally: one active view, one boundary\\n    96\\t// row per thread. Assembled into the thread-file migration history by\\n    97\\t// threads/internal/create.ts, like v5.\\n    98\\texport const MIGRATION_V6_STATEMENTS: readonly string[] = [\\n    99\\t  `CREATE TABLE thread_view (\\n   100\\t    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\\n   101\\t    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\\n   102\\t    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\\n   103\\t    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\\n   104\\t    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\\n   105\\t    profile_name TEXT,                   -- null when explicit params\\n   106\\t    config_json TEXT NOT NULL,           -- resolved bound + percentages\\n   107\\t    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, derivationUsed, degraded}\\n   108\\t    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\\n   109\\t    source_state_json TEXT NOT NULL      -- {maxEventOrder, derivationCounts} the compact saw — receipt/debug\\n   110\\t  );`,\\n   111\\t  `CREATE TABLE thread_view_band (\\n   112\\t    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\\n   113\\t    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\\n   114\\t    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\\n   115\\t    token_count INTEGER NOT NULL,\\n   116\\t    PRIMARY KEY (view_id, band)\\n   117\\t  );`,\\n   118\\t  `CREATE TABLE view_boundary (\\n   119\\t    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\\n   120\\t    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\\n   121\\t    updated_at TEXT NOT NULL\\n   122\\t  );`,\\n   123\\t  // Seed at position 0 (everything full) — the boundary row exists from\\n   124\\t  // migration on, so the advance and the compact reset are UPDATE-only.\\n   125\\t  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\\n   126\\t    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\\n   127\\t];\\n   128\\t\\n   129\\t// Epic 06 Story 0's single migration (tech design §DD-1, §DD-5):\\n   130\\t// 1. Rename derived_form table to derivation and column 'form' to 'derivation_type'\\n   131\\t// 2. Create the log table for fallback events and diagnostics\\n   132\\t// Singletons are CHECK-enforced structurally: one log entry per recorded event.\\n   133\\t// Assembled into the thread-file migration history by threads/internal/create.ts,\\n   134\\t// like v5 and v6.\\n   135\\texport const MIGRATION_V7_STATEMENTS: readonly string[] = [\\n   136\\t  // Rename table and column for derivation vocabulary (DD-1)\\n   137\\t  `ALTER TABLE derived_form RENAME TO derivation;`,\\n   138\\t  // SQLite doesn't support ALTER COLUMN directly, so we recreate the table\\n   139\\t  `CREATE TABLE derivation_new (\\n   140\\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\\n   141\\t    subject_id   TEXT NOT NULL,\\n   142\\t    derivation_type TEXT NOT NULL,\\n   143\\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\\n   144\\t    content      TEXT,\\n   145\\t    reason       TEXT,\\n   146\\t    metadata     TEXT,\\n   147\\t    source_version INTEGER NOT NULL DEFAULT 1,\\n   148\\t    gaps         TEXT,\\n   149\\t    derived_at   TEXT,\\n   150\\t    PRIMARY KEY (subject_kind, subject_id, derivation_type)\\n   151\\t  );`,\\n   152\\t  `INSERT INTO derivation_new SELECT subject_kind, subject_id, form, state, content, reason, metadata, source_version, gaps, derived_at FROM derivation;`,\\n   153\\t  `DROP TABLE derivation;`,\\n   154\\t  `ALTER TABLE derivation_new RENAME TO derivation;`,\\n   155\\t  `UPDATE thread_view\\n   156\\t     SET arrangement_json = replace(arrangement_json, '\\\"formUsed\\\"', '\\\"derivationUsed\\\"')\\n   157\\t     WHERE arrangement_json LIKE '%\\\"formUsed\\\"%';`,\\n   158\\t  `UPDATE thread_view\\n   159\\t     SET source_state_json = replace(source_state_json, '\\\"formCounts\\\"', '\\\"derivationCounts\\\"')\\n   160\\t     WHERE source_state_json LIKE '%\\\"formCounts\\\"%';`,\\n   161\\t  // Create log table (DD-5)\\n   162\\t  `CREATE TABLE log (\\n   163\\t    log_id INTEGER PRIMARY KEY AUTOINCREMENT,\\n   164\\t    level TEXT NOT NULL CHECK (level IN ('info','warning','error')),\\n   165\\t    message TEXT NOT NULL,\\n   166\\t    derivation_type TEXT,\\n   167\\t    subject_id TEXT,\\n   168\\t    reason TEXT,\\n   169\\t    floor_used TEXT,\\n   170\\t    recorded_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\\n   171\\t  );`,\\n   172\\t  // Indexes for log queries by actionable fields\\n   173\\t  `CREATE INDEX idx_log_level ON log (level);`,\\n   174\\t  `CREATE INDEX idx_log_derivation_type ON log (derivation_type);`,\\n   175\\t  `CREATE INDEX idx_log_subject_id ON log (subject_id);`,\\n   176\\t  `CREATE INDEX idx_log_reason ON log (reason);`,\\n   177\\t];\\n   178\\t\\n   179\\t// Epic 06 Story 2: tool calls render as recorded, so the old\\n   180\\t// tool_call_summary derivation/work rows are no longer valid work.\\n   181\\texport const MIGRATION_V8_STATEMENTS: readonly string[] = [\\n   182\\t  `DELETE FROM work_item WHERE kind = 'tool_call_summary';`,\\n   183\\t  `DELETE FROM derivation WHERE subject_kind = 'message' AND derivation_type = 'tool_call_summary';`,\\n   184\\t];\\n   185\\t\\n   186\\texport function getSchemaVersion(db: DatabaseSync): number {\\n   187\\t  const row = db.prepare(\\\"PRAGMA user_version\\\").get() as\\n   188\\t    | { user_version: number | bigint }\\n   189\\t    | undefined;\\n   190\\t  return Number(row?.user_version ?? 0);\\n   191\\t}\\n   192\\t\\n   193\\texport function runMigrations(\\n   194\\t  db: DatabaseSync,\\n   195\\t  migrations: readonly Migration[],\\n   196\\t): void {\\n   197\\t  let current = getSchemaVersion(db);\\n   198\\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\\n   199\\t  for (const migration of ordered) {\\n   200\\t    if (migration.version <= current) continue;\\n   201\\t    db.exec(\\\"BEGIN IMMEDIATE;\\\");\\n   202\\t    try {\\n   203\\t      for (const statement of migration.statements) db.exec(statement);\\n   204\\t      db.exec(`PRAGMA user_version = ${migration.version};`);\\n   205\\t      db.exec(\\\"COMMIT;\\\");\\n   206\\t    } catch (cause) {\\n   207\\t      db.exec(\\\"ROLLBACK;\\\");\\n   208\\t      throw cause;\\n   209\\t    }\\n   210\\t    current = migration.version;\\n   211\\t  }\\n   212\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '380,620p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '380,620p'\\\"\",\"aggregated_output\":\"   380\\t// A failed run counts itself. Under budget and retryable: the row goes back\\n   381\\t// to `queued` with attempts incremented and eligibility pushed out by backoff\\n   382\\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\\n   383\\t// on a non-retryable failure, the item is terminal: derivation `failed` with the\\n   384\\t// final reason, row deleted (AC-1.9).\\n   385\\texport function failAttempt(\\n   386\\t  db: DatabaseSync,\\n   387\\t  item: ClaimedWorkItem,\\n   388\\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\\n   389\\t): FailAttemptResult {\\n   390\\t  const attempts = item.attempts + 1;\\n   391\\t  if (opts.retryable && attempts < opts.retry.budget) {\\n   392\\t    const backoffMs = Math.min(\\n   393\\t      opts.retry.backoffBaseMs * 2 ** attempts,\\n   394\\t      opts.retry.backoffCapMs,\\n   395\\t    );\\n   396\\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\\n   397\\t    db.exec(\\\"BEGIN IMMEDIATE;\\\");\\n   398\\t    try {\\n   399\\t      db.prepare(\\n   400\\t        `UPDATE work_item\\n   401\\t         SET status = 'queued', attempts = ?, last_error = ?,\\n   402\\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\\n   403\\t         WHERE work_item_id = ?`,\\n   404\\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\\n   405\\t      db.exec(\\\"COMMIT;\\\");\\n   406\\t    } catch (cause) {\\n   407\\t      db.exec(\\\"ROLLBACK;\\\");\\n   408\\t      throw cause;\\n   409\\t    }\\n   410\\t    return { terminal: false, attempts, eligibleAt };\\n   411\\t  }\\n   412\\t  failTerminal(db, item, { reason: opts.reason, formState: \\\"failed\\\", attempts, now: opts.now });\\n   413\\t  return { terminal: true, attempts };\\n   414\\t}\\n   415\\t\\n   416\\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\\n   417\\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\\n   418\\t// result's `superseded` list. Runs inside the caller's ambient transaction —\\n   419\\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\\n   420\\t// Claimed items are deliberately left alone: the source-version check (DD-3)\\n   421\\t// discards their stale completions. Ships here as mechanics; its only caller\\n   422\\t// is Story 5's cascade.\\n   423\\texport function supersedeQueued(\\n   424\\t  db: DatabaseSync,\\n   425\\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\\n   426\\t): string[] {\\n   427\\t  const ids: string[] = [];\\n   428\\t  const remove = db.prepare(\\n   429\\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\\n   430\\t     RETURNING work_item_id`,\\n   431\\t  );\\n   432\\t  for (const target of targets) {\\n   433\\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\\n   434\\t      work_item_id: string;\\n   435\\t    }>;\\n   436\\t    for (const row of rows) ids.push(row.work_item_id);\\n   437\\t  }\\n   438\\t  return ids;\\n   439\\t}\\n   440\\t\\n   441\\t// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\\n   442\\t// queued or in flight — for this kind and source at this source version?\\n   443\\t// Runs inside the caller's requeue transaction so the check and the enqueue\\n   444\\t// commit together (anti-shim: a check-then-enqueue split across transactions\\n   445\\t// reintroduces the duplicate-work race). Version-scoped on purpose: a\\n   446\\t// claimed pre-mutation item at an older version is dying work whose\\n   447\\t// completion DD-3 will discard — it must not block the repair.\\n   448\\texport function hasLiveItem(\\n   449\\t  db: DatabaseSync,\\n   450\\t  kind: WorkKind,\\n   451\\t  sourceRef: WorkSourceRef,\\n   452\\t  sourceVersion: number,\\n   453\\t): boolean {\\n   454\\t  const row = db\\n   455\\t    .prepare(\\n   456\\t      `SELECT 1 FROM work_item\\n   457\\t       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\\n   458\\t         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\\n   459\\t       LIMIT 1`,\\n   460\\t    )\\n   461\\t    .get(kind, JSON.stringify(sourceRef), sourceVersion);\\n   462\\t  return row !== undefined;\\n   463\\t}\\n   464\\t\\n   465\\t// Live items left in the queue — the drain report's `remaining` and the\\n   466\\t// repair report's join source (Story 4).\\n   467\\texport function countLiveItems(db: DatabaseSync): number {\\n   468\\t  const row = db\\n   469\\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\\n   470\\t    .get() as unknown as { n: number | bigint };\\n   471\\t  return Number(row.n);\\n   472\\t}\\n   473\\t\\n   474\\texport interface QueueDetailRow {\\n   475\\t  workItemId: string;\\n   476\\t  owner: WorkOwner;\\n   477\\t  kind: string;\\n   478\\t  sourceRef: WorkSourceRef;\\n   479\\t  status: \\\"queued\\\" | \\\"claimed\\\";\\n   480\\t  attempts: number;\\n   481\\t  lastError?: string;\\n   482\\t  eligibleAt?: string;\\n   483\\t  claimedAt?: string;\\n   484\\t  claimExpiresAt?: string;\\n   485\\t  queuedAt: string;\\n   486\\t  sourceVersion: number;\\n   487\\t}\\n   488\\t\\n   489\\t// Mechanical detail of every live row in queue order — what the repair\\n   490\\t// report joins against derivation (Flow 4) and what tests read to assert\\n   491\\t// lease/backoff state without raw SQL at every call site.\\n   492\\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\\n   493\\t  const rows = db\\n   494\\t    .prepare(\\n   495\\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\\n   496\\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\\n   497\\t       FROM work_item ORDER BY rowid`,\\n   498\\t    )\\n   499\\t    .all() as unknown as Array<\\n   500\\t    RawClaimRow & {\\n   501\\t      status: string;\\n   502\\t      last_error: string | null;\\n   503\\t      eligible_at: string | null;\\n   504\\t      claimed_at: string | null;\\n   505\\t      claim_expires_at: string | null;\\n   506\\t    }\\n   507\\t  >;\\n   508\\t  return rows.map((row) => {\\n   509\\t    const item = toClaimedItem(row);\\n   510\\t    const detail: QueueDetailRow = {\\n   511\\t      workItemId: item.workItemId,\\n   512\\t      owner: item.owner,\\n   513\\t      kind: item.kind,\\n   514\\t      sourceRef: item.sourceRef,\\n   515\\t      status: row.status as \\\"queued\\\" | \\\"claimed\\\",\\n   516\\t      attempts: item.attempts,\\n   517\\t      queuedAt: item.queuedAt,\\n   518\\t      sourceVersion: item.sourceVersion,\\n   519\\t    };\\n   520\\t    if (row.last_error !== null) detail.lastError = row.last_error;\\n   521\\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\\n   522\\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\\n   523\\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\\n   524\\t    return detail;\\n   525\\t  });\\n   526\\t}\\n   527\\t\\n   528\\t// Listing in queue order (insertion order within the walk); each owning\\n   529\\t// domain lists only its own items.\\n   530\\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\\n   531\\t  const rows = db\\n   532\\t    .prepare(\\n   533\\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\\n   534\\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\\n   535\\t    )\\n   536\\t    .all(owner) as unknown as RawWorkItemRow[];\\n   537\\t  return rows.map((row) => ({\\n   538\\t    workItemId: row.work_item_id,\\n   539\\t    owner: row.owner as WorkOwner,\\n   540\\t    kind: row.kind as WorkKind,\\n   541\\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\\n   542\\t    status: \\\"queued\\\",\\n   543\\t    queuedAt: row.queued_at,\\n   544\\t  }));\\n   545\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_23\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/chunk-compact-recovery.test.ts | sed -n '1,380p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_23\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/chunk-compact-recovery.test.ts | sed -n '1,380p'\\\"\",\"aggregated_output\":\"     1\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n     2\\timport type { SQLInputValue } from \\\"node:sqlite\\\";\\n     3\\timport {\\n     4\\t  createSdk,\\n     5\\t  queueDetail,\\n     6\\t  threads,\\n     7\\t  type DerivationProvider,\\n     8\\t  type Lhc,\\n     9\\t  type MessageEventInput,\\n    10\\t  type SdkConfig,\\n    11\\t} from \\\"../src/index.js\\\";\\n    12\\timport {\\n    13\\t  createProviderDouble,\\n    14\\t  openRaw,\\n    15\\t  readDerivedForms,\\n    16\\t  tempStore,\\n    17\\t  validEvent,\\n    18\\t  type TempStore,\\n    19\\t} from \\\"./fixtures/index.js\\\";\\n    20\\t\\n    21\\tlet store: TempStore;\\n    22\\tbeforeEach(() => {\\n    23\\t  store = tempStore();\\n    24\\t});\\n    25\\tafterEach(() => {\\n    26\\t  store.cleanup();\\n    27\\t});\\n    28\\t\\n    29\\tasync function newThread(): Promise<string> {\\n    30\\t  const created = await threads.newThread({\\n    31\\t    filePath: store.threadPath(),\\n    32\\t    registryPath: store.registryPath,\\n    33\\t  });\\n    34\\t  if (!created.ok) throw new Error(created.error.reason);\\n    35\\t  return created.value.filePath;\\n    36\\t}\\n    37\\t\\n    38\\tfunction sdkFor(provider: DerivationProvider, overrides: Partial<SdkConfig> = {}): Lhc {\\n    39\\t  return createSdk({\\n    40\\t    provider,\\n    41\\t    mode: \\\"manual\\\",\\n    42\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    43\\t    lease: { durationMs: 200 },\\n    44\\t    chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 999999 },\\n    45\\t    ...overrides,\\n    46\\t  });\\n    47\\t}\\n    48\\t\\n    49\\tasync function send(\\n    50\\t  sdk: Lhc,\\n    51\\t  filePath: string,\\n    52\\t  batch: readonly MessageEventInput[],\\n    53\\t): Promise<void> {\\n    54\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n    55\\t  if (!result.ok) throw new Error(result.error.reason);\\n    56\\t}\\n    57\\t\\n    58\\tasync function drain(sdk: Lhc, filePath: string, opts?: { maxItems?: number }): Promise<void> {\\n    59\\t  const result = await sdk.work.drain({ filePath }, opts);\\n    60\\t  if (!result.ok) throw new Error(result.error.reason);\\n    61\\t}\\n    62\\t\\n    63\\tfunction execSql(filePath: string, sql: string, ...params: SQLInputValue[]): void {\\n    64\\t  const db = openRaw(filePath);\\n    65\\t  try {\\n    66\\t    db.prepare(sql).run(...params);\\n    67\\t  } finally {\\n    68\\t    db.close();\\n    69\\t  }\\n    70\\t}\\n    71\\t\\n    72\\tfunction execCorruptSql(filePath: string, sql: string, ...params: SQLInputValue[]): void {\\n    73\\t  const db = openRaw(filePath);\\n    74\\t  try {\\n    75\\t    db.exec(\\\"PRAGMA foreign_keys = OFF;\\\");\\n    76\\t    db.prepare(sql).run(...params);\\n    77\\t  } finally {\\n    78\\t    db.close();\\n    79\\t  }\\n    80\\t}\\n    81\\t\\n    82\\tfunction formOf(filePath: string, subjectId: string, derivationType: string) {\\n    83\\t  return readDerivedForms(filePath).find(\\n    84\\t    (form) => form.subjectId === subjectId && form.derivationType === derivationType,\\n    85\\t  );\\n    86\\t}\\n    87\\t\\n    88\\tfunction liveQueue(filePath: string) {\\n    89\\t  const db = openRaw(filePath);\\n    90\\t  try {\\n    91\\t    return queueDetail(db);\\n    92\\t  } finally {\\n    93\\t    db.close();\\n    94\\t  }\\n    95\\t}\\n    96\\t\\n    97\\tfunction setChunkSummaryState(\\n    98\\t  filePath: string,\\n    99\\t  chunkId: string,\\n   100\\t  derivationType: \\\"chunk_summary_detailed\\\" | \\\"chunk_summary_brief\\\",\\n   101\\t  state: \\\"pending\\\" | \\\"ready\\\" | \\\"failed\\\" | \\\"blocked\\\",\\n   102\\t  opts: { content?: string; reason?: string } = {},\\n   103\\t): void {\\n   104\\t  execSql(\\n   105\\t    filePath,\\n   106\\t    `UPDATE derivation SET state = ?, content = ?, reason = ? \\n   107\\t     WHERE subject_kind = 'chunk' AND subject_id = ? AND derivation_type = ?`,\\n   108\\t    state,\\n   109\\t    opts.content ?? null,\\n   110\\t    opts.reason ?? null,\\n   111\\t    chunkId,\\n   112\\t    derivationType,\\n   113\\t  );\\n   114\\t}\\n   115\\t\\n   116\\tfunction deleteWorkFor(filePath: string, kind: string, chunkId: string): void {\\n   117\\t  execSql(\\n   118\\t    filePath,\\n   119\\t    `DELETE FROM work_item WHERE kind = ? AND json_extract(source_ref, '$.chunkId') = ?`,\\n   120\\t    kind,\\n   121\\t    chunkId,\\n   122\\t  );\\n   123\\t}\\n   124\\t\\n   125\\tasync function seedFourClosedTurns(sdk: Lhc, filePath: string): Promise<void> {\\n   126\\t  for (let i = 1; i <= 4; i += 1) {\\n   127\\t    await send(sdk, filePath, [\\n   128\\t      validEvent(\\\"user_prompt\\\", { payload: { text: `prompt ${i}` } }),\\n   129\\t      validEvent(\\\"assistant_text\\\", { payload: { text: `answer ${i}` } }),\\n   130\\t      validEvent(\\\"turn_end\\\"),\\n   131\\t    ]);\\n   132\\t  }\\n   133\\t  await drain(sdk, filePath);\\n   134\\t}\\n   135\\t\\n   136\\tdescribe(\\\"Story 4: chunk derivation and compact recovery\\\", () => {\\n   137\\t  it(\\\"queues detailed and brief chunk summaries as independent work items and states\\\", async () => {\\n   138\\t    const double = createProviderDouble();\\n   139\\t    double.failKind(\\\"chunk_summary_brief\\\", 3, {\\n   140\\t      retryable: true,\\n   141\\t      reason: \\\"timeout: scripted brief failure\\\",\\n   142\\t    });\\n   143\\t    const sdk = sdkFor(double);\\n   144\\t    const filePath = await newThread();\\n   145\\t\\n   146\\t    await seedFourClosedTurns(sdk, filePath);\\n   147\\t\\n   148\\t    expect(formOf(filePath, \\\"c1\\\", \\\"chunk_summary_detailed\\\")?.state).toBe(\\\"ready\\\");\\n   149\\t    expect(formOf(filePath, \\\"c1\\\", \\\"chunk_summary_brief\\\")).toMatchObject({\\n   150\\t      state: \\\"failed\\\",\\n   151\\t      reason: \\\"timeout: scripted brief failure\\\",\\n   152\\t    });\\n   153\\t  });\\n   154\\t\\n   155\\t  it(\\\"compacts not-ready chunk summaries through stored-member concat with zero provider calls\\\", async () => {\\n   156\\t    const sdk = sdkFor(createProviderDouble());\\n   157\\t    const filePath = await newThread();\\n   158\\t    await seedFourClosedTurns(sdk, filePath);\\n   159\\t    setChunkSummaryState(filePath, \\\"c1\\\", \\\"chunk_summary_detailed\\\", \\\"failed\\\", {\\n   160\\t      reason: \\\"timeout: old summary failed\\\",\\n   161\\t    });\\n   162\\t    deleteWorkFor(filePath, \\\"chunk_summary_detailed\\\", \\\"c1\\\");\\n   163\\t\\n   164\\t    const spy = createProviderDouble();\\n   165\\t    const captured = spy.captureInputs();\\n   166\\t    const compactSdk = sdkFor(spy);\\n   167\\t    const compacted = await compactSdk.threadView.compact(\\n   168\\t      { filePath },\\n   169\\t      {\\n   170\\t        sweep: false,\\n   171\\t        params: {\\n   172\\t          lowerBound: 120,\\n   173\\t          percentages: { full: 10, smooth: 10, detailed: 70, brief: 10 },\\n   174\\t        },\\n   175\\t      },\\n   176\\t    );\\n   177\\t\\n   178\\t    expect(compacted.ok).toBe(true);\\n   179\\t    if (!compacted.ok) return;\\n   180\\t    expect(captured).toEqual([]);\\n   181\\t    expect(compacted.value.warnings).toContainEqual({\\n   182\\t      band: \\\"detailed\\\",\\n   183\\t      subjectId: \\\"c1\\\",\\n   184\\t      derivationType: \\\"chunk_summary_detailed\\\",\\n   185\\t      reason: \\\"failed_floor\\\",\\n   186\\t    });\\n   187\\t    const pulled = await compactSdk.threadView.pull({ filePath });\\n   188\\t    expect(pulled.ok).toBe(true);\\n   189\\t    if (!pulled.ok) return;\\n   190\\t    const detailed = pulled.value.messages.find((message) => message.band === \\\"detailed\\\");\\n   191\\t    expect(detailed?.content).toContain(\\\"§c1 [degraded: detailed-from-stored-members]\\\");\\n   192\\t    expect(detailed?.content).toContain(\\\"§t1\\\\nprompt 1\\\\nanswer 1\\\");\\n   193\\t    expect(detailed?.content).not.toContain(\\\"unavailable\\\");\\n   194\\t\\n   195\\t    const logs = await compactSdk.logging.query(\\n   196\\t      { filePath },\\n   197\\t      { derivationType: \\\"chunk_summary_detailed\\\", subjectId: \\\"c1\\\" },\\n   198\\t    );\\n   199\\t    expect(logs.ok).toBe(true);\\n   200\\t    if (!logs.ok) return;\\n   201\\t    expect(logs.value[0]).toMatchObject({\\n   202\\t      level: \\\"warning\\\",\\n   203\\t      reason: \\\"failed_floor\\\",\\n   204\\t      floorUsed: \\\"stored_member_concat\\\",\\n   205\\t    });\\n   206\\t  });\\n   207\\t\\n   208\\t  it(\\\"halts compact before fallback assembly when stop is requested\\\", async () => {\\n   209\\t    const sdk = sdkFor(createProviderDouble());\\n   210\\t    const filePath = await newThread();\\n   211\\t    await seedFourClosedTurns(sdk, filePath);\\n   212\\t    setChunkSummaryState(filePath, \\\"c1\\\", \\\"chunk_summary_detailed\\\", \\\"pending\\\");\\n   213\\t    deleteWorkFor(filePath, \\\"chunk_summary_detailed\\\", \\\"c1\\\");\\n   214\\t\\n   215\\t    const stopped = await sdk.threadView.compact(\\n   216\\t      { filePath },\\n   217\\t      {\\n   218\\t        sweep: false,\\n   219\\t        signal: { aborted: true },\\n   220\\t        params: {\\n   221\\t          lowerBound: 120,\\n   222\\t          percentages: { full: 10, smooth: 10, detailed: 70, brief: 10 },\\n   223\\t        },\\n   224\\t      },\\n   225\\t    );\\n   226\\t\\n   227\\t    expect(stopped.ok).toBe(false);\\n   228\\t    if (stopped.ok) return;\\n   229\\t    expect(stopped.error).toMatchObject({\\n   230\\t      errorClass: \\\"caller_error\\\",\\n   231\\t      code: \\\"compact_stopped\\\",\\n   232\\t    });\\n   233\\t    expect(formOf(filePath, \\\"c1\\\", \\\"chunk_summary_detailed\\\")?.state).toBe(\\\"pending\\\");\\n   234\\t  });\\n   235\\t\\n   236\\t  it(\\\"refuses compact when canonical member source is corrupt\\\", async () => {\\n   237\\t    const sdk = sdkFor(createProviderDouble());\\n   238\\t    const filePath = await newThread();\\n   239\\t    await seedFourClosedTurns(sdk, filePath);\\n   240\\t    setChunkSummaryState(filePath, \\\"c1\\\", \\\"chunk_summary_detailed\\\", \\\"pending\\\");\\n   241\\t    deleteWorkFor(filePath, \\\"chunk_summary_detailed\\\", \\\"c1\\\");\\n   242\\t    execCorruptSql(filePath, `DELETE FROM turns WHERE turn_id = 't1'`);\\n   243\\t\\n   244\\t    const compacted = await sdk.threadView.compact(\\n   245\\t      { filePath },\\n   246\\t      {\\n   247\\t        sweep: false,\\n   248\\t        params: {\\n   249\\t          lowerBound: 120,\\n   250\\t          percentages: { full: 10, smooth: 10, detailed: 70, brief: 10 },\\n   251\\t        },\\n   252\\t      },\\n   253\\t    );\\n   254\\t\\n   255\\t    expect(compacted.ok).toBe(false);\\n   256\\t    if (compacted.ok) return;\\n   257\\t    expect(compacted.error).toMatchObject({ errorClass: \\\"state_corruption\\\" });\\n   258\\t  });\\n   259\\t\\n   260\\t  it(\\\"background chunk summary work requeues on not-ready member projection\\\", async () => {\\n   261\\t    const sdk = sdkFor(createProviderDouble(), {\\n   262\\t      retry: { budget: 3, backoffBaseMs: 1000, backoffCapMs: 1000 },\\n   263\\t    });\\n   264\\t    const filePath = await newThread();\\n   265\\t    await seedFourClosedTurns(sdk, filePath);\\n   266\\t    setChunkSummaryState(filePath, \\\"c1\\\", \\\"chunk_summary_detailed\\\", \\\"pending\\\");\\n   267\\t    execSql(\\n   268\\t      filePath,\\n  
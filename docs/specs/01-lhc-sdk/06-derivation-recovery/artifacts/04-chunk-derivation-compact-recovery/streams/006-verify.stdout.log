{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/chunks.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Chunk mechanics (Flow 3, DD-9): open-chunk append, the accumulated close\n     2\t// policy, and the close→summary enqueues. Placement is pure arithmetic over\n     3\t// stored projected token counts — the caller hands in the incoming turn's\n     4\t// count, the open chunk carries its accumulated count durably — so identical\n     5\t// streams re-chunk identically (AC-3.9): no clock, no inference, no\n     6\t// re-estimation at placement time. Everything here runs inside the\n     7\t// turn-derivation completion transaction; a crash leaves either a placed\n     8\t// turn (with any close's summary enqueues) or nothing.\n     9\timport type { DatabaseSync } from \"node:sqlite\";\n    10\timport type { OperationContext } from \"../../../shared/context.js\";\n    11\timport { enqueue, type WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n    12\t\n    13\texport interface ChunkPolicy {\n    14\t  targetProjectedTokens: number;\n    15\t  maxProjectedTokens: number;\n    16\t}\n    17\t\n    18\texport interface PlacementResult {\n    19\t  chunkId: string;\n    20\t  memberIdx: number;\n    21\t  // Chunks closed by this placement, in close order: at most the previous\n    22\t  // open chunk (accumulation rule) and then the incoming turn's own chunk\n    23\t  // (max rule) — a turn ≥ max arriving behind an open chunk closes both.\n    24\t  closedChunkIds: string[];\n    25\t  // An explicitly rebuilt turn keeps its placement (membership shrinks only\n    26\t  // through Story 6's sanctioned mutation, never re-cuts): a turn already a\n    27\t  // member is left exactly where it is and nothing closes.\n    28\t  alreadyPlaced: boolean;\n    29\t}\n    30\t\n    31\tinterface OpenChunkRow {\n    32\t  chunk_id: string;\n    33\t  accumulated_projected_tokens: number | bigint;\n    34\t}\n    35\t\n    36\tfunction memberCount(db: DatabaseSync, chunkId: string): number {\n    37\t  const row = db\n    38\t    .prepare(`SELECT COUNT(*) AS n FROM chunk_member WHERE chunk_id = ?`)\n    39\t    .get(chunkId) as unknown as { n: number | bigint };\n    40\t  return Number(row.n);\n    41\t}\n    42\t\n    43\tfunction closeChunk(db: DatabaseSync, chunkId: string): void {\n    44\t  db.prepare(`UPDATE chunk SET status = 'closed' WHERE chunk_id = ?`).run(chunkId);\n    45\t}\n    46\t\n    47\tfunction openNextChunk(db: DatabaseSync): string {\n    48\t  const row = db.prepare(`SELECT MAX(chunk_order) AS max_order FROM chunk`).get() as\n    49\t    | { max_order: number | bigint | null }\n    50\t    | undefined;\n    51\t  const order = Number(row?.max_order ?? 0) + 1;\n    52\t  const chunkId = `c${order}`;\n    53\t  db.prepare(\n    54\t    `INSERT INTO chunk (chunk_id, chunk_order, status, accumulated_projected_tokens)\n    55\t     VALUES (?, ?, 'open', 0)`,\n    56\t  ).run(chunkId, order);\n    57\t  return chunkId;\n    58\t}\n    59\t\n    60\t// The close policy, golden cases exact (DD-9): when the open chunk's\n    61\t// accumulated count plus the incoming turn's would reach the target\n    62\t// (inclusive — equality closes), the chunk closes holding its current\n    63\t// members and the incoming turn opens the next chunk; a single projection\n    64\t// ≥ max closes its own chunk immediately. An empty open chunk always accepts\n    65\t// the incoming turn — a chunk never closes empty.\n    66\texport function placeTurn(\n    67\t  db: DatabaseSync,\n    68\t  turnId: string,\n    69\t  projectedTokens: number,\n    70\t  policy: ChunkPolicy,\n    71\t): PlacementResult {\n    72\t  const existing = db\n    73\t    .prepare(`SELECT chunk_id, member_idx FROM chunk_member WHERE turn_id = ?`)\n    74\t    .get(turnId) as unknown as { chunk_id: string; member_idx: number | bigint } | undefined;\n    75\t  if (existing !== undefined) {\n    76\t    return {\n    77\t      chunkId: existing.chunk_id,\n    78\t      memberIdx: Number(existing.member_idx),\n    79\t      closedChunkIds: [],\n    80\t      alreadyPlaced: true,\n    81\t    };\n    82\t  }\n    83\t\n    84\t  const closedChunkIds: string[] = [];\n    85\t  let open = db\n    86\t    .prepare(\n    87\t      `SELECT chunk_id, accumulated_projected_tokens FROM chunk\n    88\t       WHERE status = 'open' ORDER BY chunk_order DESC LIMIT 1`,\n    89\t    )\n    90\t    .get() as unknown as OpenChunkRow | undefined;\n    91\t\n    92\t  if (\n    93\t    open !== undefined &&\n    94\t    memberCount(db, open.chunk_id) > 0 &&\n    95\t    Number(open.accumulated_projected_tokens) + projectedTokens >= policy.targetProjectedTokens\n    96\t  ) {\n    97\t    // Crossing closes *without* the incoming turn — the v1 bug's fix: the\n    98\t    // decision weighs accumulated + incoming, and the incoming turn starts\n    99\t    // the next chunk (AC-3.6).\n   100\t    closeChunk(db, open.chunk_id);\n   101\t    closedChunkIds.push(open.chunk_id);\n   102\t    open = undefined;\n   103\t  }\n   104\t\n   105\t  const chunkId = open?.chunk_id ?? openNextChunk(db);\n   106\t  const memberIdx = memberCount(db, chunkId);\n   107\t  db.prepare(`INSERT INTO chunk_member (chunk_id, turn_id, member_idx) VALUES (?, ?, ?)`).run(\n   108\t    chunkId,\n   109\t    turnId,\n   110\t    memberIdx,\n   111\t  );\n   112\t  db.prepare(\n   113\t    `UPDATE chunk SET accumulated_projected_tokens = accumulated_projected_tokens + ?\n   114\t     WHERE chunk_id = ?`,\n   115\t  ).run(projectedTokens, chunkId);\n   116\t\n   117\t  if (projectedTokens >= policy.maxProjectedTokens) {\n   118\t    // Max rule (AC-3.7): the projection alone meets the maximum, so the\n   119\t    // turn's chunk closes immediately, whatever it holds.\n   120\t    closeChunk(db, chunkId);\n   121\t    closedChunkIds.push(chunkId);\n   122\t  }\n   123\t\n   124\t  return { chunkId, memberIdx, closedChunkIds, alreadyPlaced: false };\n   125\t}\n   126\t\n   127\t// Closing queues the two summary kinds as two work items with independent\n   128\t// retry, states, and re-queue (AC-3.8); both enqueues ride the caller's\n   129\t// ambient transaction — the completion commit — per DD-5.\n   130\texport function enqueueChunkSummaries(\n   131\t  ctx: OperationContext,\n   132\t  chunkId: string,\n   133\t): WorkItemRecord[] {\n   134\t  return ([\"chunk_summary_detailed\", \"chunk_summary_brief\"] as const).map((kind) =>\n   135\t    enqueue(ctx, {\n   136\t      owner: \"turns\",\n   137\t      kind,\n   138\t      sourceRef: { chunkId },\n   139\t      derivations: [{ subjectKind: \"chunk\", subjectId: chunkId, derivationType: kind }],\n   140\t    }),\n   141\t  );\n   142\t}\n   143\t\n   144\t// Placement read-back for the turns surface (AC-3.5): chunkId + memberIdx by\n   145\t// turn, one query, stored values only.\n   146\texport function readPlacements(\n   147\t  db: DatabaseSync,\n   148\t): Map<string, { chunkId: string; memberIdx: number }> {\n   149\t  const rows = db\n   150\t    .prepare(`SELECT turn_id, chunk_id, member_idx FROM chunk_member`)\n   151\t    .all() as unknown as Array<{\n   152\t    turn_id: string;\n   153\t    chunk_id: string;\n   154\t    member_idx: number | bigint;\n   155\t  }>;\n   156\t  const byTurn = new Map<string, { chunkId: string; memberIdx: number }>();\n   157\t  for (const row of rows) {\n   158\t    byTurn.set(row.turn_id, { chunkId: row.chunk_id, memberIdx: Number(row.member_idx) });\n   159\t  }\n   160\t  return byTurn;\n   161\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,500p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type {\n     4\t  DerivationType,\n     5\t  DerivationReportEntry,\n     6\t  WorkHandler,\n     7\t} from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type EnqueueDerivationTarget,\n    14\t  type WorkItemRecord,\n    15\t  type WorkKind,\n    16\t  type WorkSourceRef,\n    17\t} from \"../../tech-utils/work-queue/index.js\";\n    18\timport type { EventKind } from \"../intake-stream/index.js\";\n    19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    20\timport { transition } from \"./internal/state-machine.js\";\n    21\t\n    22\t// The pure rule table, re-exported for the golden supplemental suite (the\n    23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    24\t// callers go through applyEvent.\n    25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    26\timport type { Derivation } from \"../../shared/derivation.js\";\n    27\timport {\n    28\t  compactChunkMaterialFromStoredMembers,\n    29\t  type CompactChunkMaterial,\n    30\t} from \"./internal/chunk-recovery.js\";\n    31\timport { turnWorkHandlers } from \"./internal/derive.js\";\n    32\timport {\n    33\t  readChunkRows,\n    34\t  readOwnedForms,\n    35\t  readTurnFormRow,\n    36\t  reportTurnForms,\n    37\t} from \"./internal/forms.js\";\n    38\timport {\n    39\t  applyTurnDeleteCascade,\n    40\t  type MutationResult,\n    41\t} from \"../messages/index.js\";\n    42\timport {\n    43\t  closeTurn,\n    44\t  insertOpenTurn,\n    45\t  markTurnDeleted,\n    46\t  nextTurnOrder,\n    47\t  readMutableTurn,\n    48\t  readTurns,\n    49\t  selectOpenTurnIds,\n    50\t} from \"./internal/store.js\";\n    51\t\n    52\texport interface TurnRecord {\n    53\t  turnId: string;\n    54\t  status: \"open\" | \"closed\";\n    55\t  memberMessageIds: string[];\n    56\t  openedAtEventOrder: number;\n    57\t  closedAtEventOrder?: number;\n    58\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n    59\t  // derivation placed it — stored values read back, never recomputed.\n    60\t  chunkId?: string;\n    61\t  memberIdx?: number;\n    62\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n    63\t  // present only when rows exist — a closed turn carries them from the\n    64\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n    65\t  // the message read's forms key; reads degrade, never block.\n    66\t  derivations?: Derivation[];\n    67\t}\n    68\t\n    69\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n    70\t// record with live membership and its summary forms' states attached —\n    71\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n    72\t// with form states\".\n    73\texport interface ChunkRecord {\n    74\t  chunkId: string;\n    75\t  chunkOrder: number;\n    76\t  status: \"open\" | \"closed\";\n    77\t  accumulatedProjectedTokens: number;\n    78\t  memberTurnIds: string[];\n    79\t  derivations?: Derivation[];\n    80\t}\n    81\t\n    82\texport interface TurnTransitionOutcome {\n    83\t  // Transitions in occurrence order: a close_then_open reports the close\n    84\t  // first, then the open, exactly as the batch result surfaces them.\n    85\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    86\t  // Turn state after the transition — the stamp for this event's message.\n    87\t  // Prompts see the turn they just opened (transition first, then stamp);\n    88\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    89\t  openTurnId: string | null;\n    90\t  // Work queued by this transition: one turn_derivation item per closed\n    91\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    92\t  queuedWork: WorkItemRecord[];\n    93\t}\n    94\t\n    95\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    96\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    97\t// writes turn state, so more than one open turn means external interference.\n    98\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    99\t  return selectOpenTurnIds(ctx.db);\n   100\t}\n   101\t\n   102\t// Closing a turn — by either close path — durably queues that turn's\n   103\t// derivation work in the same transaction (AC-3.6): the close update and the\n   104\t// work item commit or roll back together.\n   105\tfunction closeTurnAndQueueWork(\n   106\t  ctx: OperationContext,\n   107\t  turnId: string,\n   108\t  eventOrder: number,\n   109\t): WorkItemRecord {\n   110\t  closeTurn(ctx.db, turnId, eventOrder);\n   111\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n   112\t  // lands the rendering and the lower-band projection as independent rows;\n   113\t  // both go pending with the enqueue (DD-5).\n   114\t  return enqueue(ctx, {\n   115\t    owner: \"turns\",\n   116\t    kind: \"turn_derivation\",\n   117\t    sourceRef: { turnId },\n   118\t    derivations: [\n   119\t      { subjectKind: \"turn\", subjectId: turnId, derivationType: \"turn_rendering\" },\n   120\t      { subjectKind: \"turn\", subjectId: turnId, derivationType: \"lower_band_projection\" },\n   121\t    ],\n   122\t  });\n   123\t}\n   124\t\n   125\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n   126\t// construction (DD-6): turn derivation and the two chunk summaries.\n   127\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   128\t  turnWorkHandlers;\n   129\t\n   130\t// Cross-domain surface, called by intake-stream inside the batch transaction\n   131\t// for every recorded event. Synchronous and throwing by design, like\n   132\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n   133\texport function applyEvent(\n   134\t  ctx: OperationContext,\n   135\t  eventKind: EventKind,\n   136\t  eventOrder: number,\n   137\t): TurnTransitionOutcome {\n   138\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n   139\t  const effect = transition({ openTurnId }, eventKind);\n   140\t  switch (effect.kind) {\n   141\t    case \"none\":\n   142\t      return { transitions: [], openTurnId, queuedWork: [] };\n   143\t    case \"open\": {\n   144\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   145\t      return {\n   146\t        transitions: [{ action: \"opened\", turnId }],\n   147\t        openTurnId: turnId,\n   148\t        queuedWork: [],\n   149\t      };\n   150\t    }\n   151\t    case \"close\": {\n   152\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   153\t      return {\n   154\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   155\t        openTurnId: null,\n   156\t        queuedWork: [item],\n   157\t      };\n   158\t    }\n   159\t    case \"close_then_open\": {\n   160\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   161\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   162\t      return {\n   163\t        transitions: [\n   164\t          { action: \"closed\", turnId: openTurnId as string },\n   165\t          { action: \"opened\", turnId },\n   166\t        ],\n   167\t        openTurnId: turnId,\n   168\t        queuedWork: [item],\n   169\t      };\n   170\t    }\n   171\t  }\n   172\t}\n   173\t\n   174\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   175\t  return {\n   176\t    ok: false,\n   177\t    error: {\n   178\t      errorClass: \"caller_error\",\n   179\t      code: \"thread_not_found\",\n   180\t      reason: `no thread file exists at ${filePath}`,\n   181\t    },\n   182\t  };\n   183\t}\n   184\t\n   185\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   186\t  const resolved = await resolveThreadRef(thread);\n   187\t  if (!resolved.ok) return resolved;\n   188\t  const { filePath } = resolved.value;\n   189\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   190\t\n   191\t  const opened = openThreadDatabase(filePath);\n   192\t  if (!opened.ok) return opened;\n   193\t  const db = opened.value;\n   194\t  try {\n   195\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n   196\t    // stored derived forms, attached from one grouped query — mirroring the\n   197\t    // message read's production path for \"readable alongside the record\".\n   198\t    const formsByTurn = readOwnedForms(db, \"turn\");\n   199\t    const records = readTurns(db).map((record) => {\n   200\t      const derivations = formsByTurn.get(record.turnId);\n   201\t      return derivations === undefined ? record : { ...record, derivations };\n   202\t    });\n   203\t    return { ok: true, value: records };\n   204\t  } catch (cause) {\n   205\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   206\t    return storageFailure(`turn read-back failed: ${reason}`);\n   207\t  } finally {\n   208\t    db.close();\n   209\t  }\n   210\t}\n   211\t\n   212\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n   213\t// returns stored records whatever the forms' states — reads degrade, never\n   214\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n   215\t// summary rows until close queues them).\n   216\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n   217\t  const resolved = await resolveThreadRef(thread);\n   218\t  if (!resolved.ok) return resolved;\n   219\t  const { filePath } = resolved.value;\n   220\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   221\t\n   222\t  const opened = openThreadDatabase(filePath);\n   223\t  if (!opened.ok) return opened;\n   224\t  const db = opened.value;\n   225\t  try {\n   226\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n   227\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n   228\t      const derivations = formsByChunk.get(row.chunkId);\n   229\t      return derivations === undefined ? row : { ...row, derivations };\n   230\t    });\n   231\t    return { ok: true, value: records };\n   232\t  } catch (cause) {\n   233\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   234\t    return storageFailure(`chunk read-back failed: ${reason}`);\n   235\t  } finally {\n   236\t    db.close();\n   237\t  }\n   238\t}\n   239\t\n   240\texport async function listQueuedWork(\n   241\t  thread: ThreadRef,\n   242\t): Promise<OpResult<WorkItemRecord[]>> {\n   243\t  const resolved = await resolveThreadRef(thread);\n   244\t  if (!resolved.ok) return resolved;\n   245\t  const { filePath } = resolved.value;\n   246\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   247\t\n   248\t  const opened = openThreadDatabase(filePath);\n   249\t  if (!opened.ok) return opened;\n   250\t  const db = opened.value;\n   251\t  try {\n   252\t    return { ok: true, value: listItems(db, \"turns\") };\n   253\t  } catch (cause) {\n   254\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   255\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   256\t  } finally {\n   257\t    db.close();\n   258\t  }\n   259\t}\n   260\t\n   261\texport function compactChunkMaterial(\n   262\t  ctx: OperationContext,\n   263\t  chunkId: string,\n   264\t  derivationType: \"chunk_summary_detailed\" | \"chunk_summary_brief\" = \"chunk_summary_detailed\",\n   265\t): CompactChunkMaterial {\n   266\t  return compactChunkMaterialFromStoredMembers(ctx.db, chunkId, derivationType);\n   267\t}\n   268\t\n   269\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   270\t\n   271\t// This owner's repair report: every turn- and chunk-owned form's durable\n   272\t// state joined with live queue detail in one query. Needs no provider;\n   273\t// reads degrade, never block.\n   274\texport async function report(\n   275\t  thread: ThreadRef,\n   276\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   277\t): Promise<OpResult<DerivationReportEntry[]>> {\n   278\t  const resolved = await resolveThreadRef(thread);\n   279\t  if (!resolved.ok) return resolved;\n   280\t  const { filePath } = resolved.value;\n   281\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   282\t\n   283\t  const opened = openThreadDatabase(filePath);\n   284\t  if (!opened.ok) return opened;\n   285\t  const db = opened.value;\n   286\t  try {\n   287\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   288\t  } catch (cause) {\n   289\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   290\t    return storageFailure(`report read failed: ${reason}`);\n   291\t  } finally {\n   292\t    db.close();\n   293\t  }\n   294\t}\n   295\t\n   296\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   297\t\n   298\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n   299\t// the one turn_derivation item (the handler lands rendering and projection\n   300\t// together, so a rebuild of either re-derives both — the rebuild rule from\n   301\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n   302\t// independent lifecycles).\n   303\tfunction turnRequeueTarget(target: {\n   304\t  subjectKind: \"turn\" | \"chunk\";\n   305\t  subjectId: string;\n   306\t  derivationType: DerivationType;\n   307\t}): { kind: WorkKind; sourceRef: WorkSourceRef; derivations: EnqueueDerivationTarget[] } | undefined {\n   308\t  if (\n   309\t    target.subjectKind === \"turn\" &&\n   310\t    (target.derivationType === \"turn_rendering\" || target.derivationType === \"lower_band_projection\")\n   311\t  ) {\n   312\t    return {\n   313\t      kind: \"turn_derivation\",\n   314\t      sourceRef: { turnId: target.subjectId },\n   315\t      derivations: [\n   316\t        { subjectKind: \"turn\", subjectId: target.subjectId, derivationType: \"turn_rendering\" },\n   317\t        { subjectKind: \"turn\", subjectId: target.subjectId, derivationType: \"lower_band_projection\" },\n   318\t      ],\n   319\t    };\n   320\t  }\n   321\t  if (\n   322\t    target.subjectKind === \"chunk\" &&\n   323\t    (target.derivationType === \"chunk_summary_detailed\" || target.derivationType === \"chunk_summary_brief\")\n   324\t  ) {\n   325\t    return {\n   326\t      kind: target.derivationType,\n   327\t      sourceRef: { chunkId: target.subjectId },\n   328\t      derivations: [{ subjectKind: \"chunk\", subjectId: target.subjectId, derivationType: target.derivationType }],\n   329\t    };\n   330\t  }\n   331\t  return undefined;\n   332\t}\n   333\t\n   334\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   335\t// messages.requeue — blocked refused with the stored damage reason, missing\n   336\t// rows refused, no-op against live work at the current source version, and\n   337\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   338\t// at the next source version: composed forms recompute their gaps from\n   339\t// current dependency states (Flow 3's rebuild rule).\n   340\texport async function requeue(\n   341\t  thread: ThreadRef,\n   342\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; derivationType: DerivationType },\n   343\t): Promise<OpResult<RequeueOutcome>> {\n   344\t  const mapped = turnRequeueTarget(target);\n   345\t  if (mapped === undefined) {\n   346\t    return {\n   347\t      ok: false,\n   348\t      error: {\n   349\t        errorClass: \"caller_error\",\n   350\t        code: \"turn_not_found\",\n   351\t        reason: `derivation ${target.derivationType} is not a ${target.subjectKind}-owned derivation; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   352\t      },\n   353\t    };\n   354\t  }\n   355\t  const resolved = await resolveThreadRef(thread);\n   356\t  if (!resolved.ok) return resolved;\n   357\t  const { filePath } = resolved.value;\n   358\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   359\t\n   360\t  const opened = openThreadDatabase(filePath);\n   361\t  if (!opened.ok) return opened;\n   362\t  const db = opened.value;\n   363\t  try {\n   364\t    const meta = db\n   365\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   366\t      .get() as { thread_id: string } | undefined;\n   367\t    const threadId = meta?.thread_id ?? \"\";\n   368\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   369\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.derivationType);\n   370\t      if (row === undefined) {\n   371\t        return {\n   372\t          ok: false,\n   373\t          error: {\n   374\t            errorClass: \"caller_error\",\n   375\t            code: \"turn_not_found\",\n   376\t            reason: `no derived derivation ${target.derivationType} exists for ${target.subjectKind} ${target.subjectId}`,\n   377\t          },\n   378\t        };\n   379\t      }\n   380\t      if (row.state === \"blocked\") {\n   381\t        // The refusal carries the derivation's stored reason — the damage named at\n   382\t        // blocking time, not a generic string (AC-4.6).\n   383\t        return {\n   384\t          ok: false,\n   385\t          error: {\n   386\t            errorClass: \"state_corruption\",\n   387\t            code: \"source_damaged\",\n   388\t            reason:\n   389\t              row.reason ??\n   390\t              `derivation ${target.derivationType} for ${target.subjectKind} ${target.subjectId} is blocked`,\n   391\t          },\n   392\t        };\n   393\t      }\n   394\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n   395\t        return { ok: true, value: { noop: \"already_queued\" } };\n   396\t      }\n   397\t      const item = enqueue(ctx, {\n   398\t        owner: \"turns\",\n   399\t        kind: mapped.kind,\n   400\t        sourceRef: mapped.sourceRef,\n   401\t        sourceVersion: row.sourceVersion + 1,\n   402\t        derivations: mapped.derivations,\n   403\t      });\n   404\t      return { ok: true, value: { workItemId: item.workItemId } };\n   405\t    });\n   406\t  } catch (cause) {\n   407\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   408\t    return storageFailure(`requeue failed: ${reason}`);\n   409\t  } finally {\n   410\t    db.close();\n   411\t  }\n   412\t}\n   413\t\n   414\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n   415\t\n   416\t// The whole-exchange removal (AC-6.4–6.7): \"that exchange was a dead end —\n   417\t// kill it.\" One transaction stamps the turn and all its live member\n   418\t// messages deleted, drops the turn's and members' derivations, and\n   419\t// re-queues the containing chunk's summaries from the remaining live\n   420\t// members — or drops them when the chunk empties out (AC-6.6). The shared\n   421\t// machinery is the messages domain's cascade module (DD-8, one cascade,\n   422\t// two callers), reached through its public surface; this operation owns\n   423\t// the turn-side validation and the turn-row stamp. Source events are never\n   424\t// touched; chunk membership rows are never moved or re-cut — reads filter\n   425\t// the deleted turn out, shrinking the chunk in place. Refusals read the\n   426\t// filtered view: a missing, deleted, or double-deleted turn is\n   427\t// turn_not_found; an open turn is turn_open; a refusal changes nothing.\n   428\texport async function deleteTurn(\n   429\t  thread: ThreadRef,\n   430\t  input: { turnId: string },\n   431\t): Promise<OpResult<MutationResult>> {\n   432\t  const resolved = await resolveThreadRef(thread);\n   433\t  if (!resolved.ok) return resolved;\n   434\t  const { filePath } = resolved.value;\n   435\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   436\t\n   437\t  const opened = openThreadDatabase(filePath);\n   438\t  if (!opened.ok) return opened;\n   439\t  const db = opened.value;\n   440\t  try {\n   441\t    const meta = db\n   442\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   443\t      .get() as { thread_id: string } | undefined;\n   444\t    const threadId = meta?.thread_id ?? \"\";\n   445\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   446\t      const target = readMutableTurn(ctx.db, input.turnId);\n   447\t      if (target === undefined) {\n   448\t        return {\n   449\t          ok: false,\n   450\t          error: {\n   451\t            errorClass: \"caller_error\",\n   452\t            code: \"turn_not_found\",\n   453\t            reason: `no turn ${input.turnId} exists in this thread`,\n   454\t          },\n   455\t        };\n   456\t      }\n   457\t      if (target.status !== \"closed\") {\n   458\t        return {\n   459\t          ok: false,\n   460\t          error: {\n   461\t            errorClass: \"caller_error\",\n   462\t            code: \"turn_open\",\n   463\t            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\n   464\t          },\n   465\t        };\n   466\t      }\n   467\t      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\n   468\t      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\n   469\t      return {\n   470\t        ok: true,\n   471\t        value: {\n   472\t          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\n   473\t          cleared: cascade.cleared,\n   474\t          dropped: cascade.dropped,\n   475\t          queued: cascade.queued,\n   476\t          superseded: cascade.superseded,\n   477\t        },\n   478\t      };\n   479\t    });\n   480\t  } catch (cause) {\n   481\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   482\t    return storageFailure(`delete failed: ${reason}`);\n   483\t  } finally {\n   484\t    db.close();\n   485\t  }\n   486\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/chunk-recovery.ts | sed -n '1,500p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/chunk-recovery.ts | sed -n '1,500p'\"","aggregated_output":"     1\timport type { DatabaseSync } from \"node:sqlite\";\n     2\timport type { DerivationType } from \"../../../shared/derivation.js\";\n     3\t\n     4\texport type CompactChunkMaterial =\n     5\t  | { kind: \"ready\"; content: string }\n     6\t  | { kind: \"concat\"; content: string; reason: string }\n     7\t  | { kind: \"blocked\"; reason: string };\n     8\t\n     9\tfunction blockText(kind: string, content: Record<string, unknown>): string {\n    10\t  switch (kind) {\n    11\t    case \"user_prompt\":\n    12\t    case \"assistant_text\":\n    13\t    case \"assistant_thinking\":\n    14\t    case \"runtime_note\": {\n    15\t      const text = content[\"text\"];\n    16\t      return typeof text === \"string\" ? text : \"\";\n    17\t    }\n    18\t    case \"tool_call\": {\n    19\t      const name = typeof content[\"toolName\"] === \"string\" ? content[\"toolName\"] : \"unknown_tool\";\n    20\t      return `[tool call · ${name}] ${JSON.stringify(content[\"arguments\"] ?? {})}`;\n    21\t    }\n    22\t    case \"tool_result\": {\n    23\t      const text = content[\"content\"];\n    24\t      return typeof text === \"string\" ? `[tool result]\\n${text}` : \"[tool result]\";\n    25\t    }\n    26\t    default:\n    27\t      return \"\";\n    28\t  }\n    29\t}\n    30\t\n    31\tfunction storedMemberConcat(db: DatabaseSync, chunkId: string): CompactChunkMaterial {\n    32\t  const chunk = db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId);\n    33\t  if (chunk === undefined) {\n    34\t    return { kind: \"blocked\", reason: `canonical record corrupt: chunk ${chunkId} not found` };\n    35\t  }\n    36\t\n    37\t  const members = db\n    38\t    .prepare(\n    39\t      `SELECT cm.turn_id FROM chunk_member cm\n    40\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n    41\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n    42\t    )\n    43\t    .all(chunkId) as unknown as Array<{ turn_id: string }>;\n    44\t  if (members.length === 0) {\n    45\t    return { kind: \"blocked\", reason: `canonical record corrupt: chunk ${chunkId} has no readable members` };\n    46\t  }\n    47\t\n    48\t  const messageStmt = db.prepare(\n    49\t    `SELECT message_id, kind FROM message\n    50\t     WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    51\t  );\n    52\t  const blockStmt = db.prepare(\n    53\t    `SELECT content FROM message_block WHERE message_id = ? ORDER BY block_index`,\n    54\t  );\n    55\t  const sections: string[] = [];\n    56\t  for (const member of members) {\n    57\t    const turn = db\n    58\t      .prepare(`SELECT status, closed_at_event_order FROM turns WHERE turn_id = ?`)\n    59\t      .get(member.turn_id) as\n    60\t      | { status: string; closed_at_event_order: number | bigint | null }\n    61\t      | undefined;\n    62\t    if (turn === undefined || turn.status !== \"closed\" || turn.closed_at_event_order === null) {\n    63\t      return {\n    64\t        kind: \"blocked\",\n    65\t        reason: `canonical record corrupt: chunk ${chunkId} member ${member.turn_id} is unreadable`,\n    66\t      };\n    67\t    }\n    68\t    const messages = messageStmt.all(member.turn_id) as unknown as Array<{\n    69\t      message_id: string;\n    70\t      kind: string;\n    71\t    }>;\n    72\t    const lines: string[] = [];\n    73\t    for (const message of messages) {\n    74\t      const blocks = blockStmt.all(message.message_id) as unknown as Array<{ content: string }>;\n    75\t      const rendered = blocks\n    76\t        .map((block) => blockText(message.kind, JSON.parse(block.content) as Record<string, unknown>))\n    77\t        .filter((text) => text.length > 0);\n    78\t      lines.push(...rendered);\n    79\t    }\n    80\t    sections.push(`§${member.turn_id}\\n${lines.join(\"\\n\")}`);\n    81\t  }\n    82\t\n    83\t  return {\n    84\t    kind: \"concat\",\n    85\t    content: sections.join(\"\\n\\n\"),\n    86\t    reason: \"not_ready\",\n    87\t  };\n    88\t}\n    89\t\n    90\texport function compactChunkMaterialFromStoredMembers(\n    91\t  db: DatabaseSync,\n    92\t  chunkId: string,\n    93\t  derivationType: Extract<DerivationType, \"chunk_summary_detailed\" | \"chunk_summary_brief\">,\n    94\t): CompactChunkMaterial {\n    95\t  const row = db\n    96\t    .prepare(\n    97\t      `SELECT state, content, reason FROM derivation\n    98\t       WHERE subject_kind = 'chunk' AND subject_id = ? AND derivation_type = ?`,\n    99\t    )\n   100\t    .get(chunkId, derivationType) as\n   101\t    | { state: string; content: string | null; reason: string | null }\n   102\t    | undefined;\n   103\t  if (row?.state === \"ready\" && row.content !== null) {\n   104\t    return { kind: \"ready\", content: row.content };\n   105\t  }\n   106\t  if (row?.state === \"blocked\") {\n   107\t    return {\n   108\t      kind: \"blocked\",\n   109\t      reason: row.reason ?? `${derivationType} for chunk ${chunkId} is blocked`,\n   110\t    };\n   111\t  }\n   112\t  const fallback = storedMemberConcat(db, chunkId);\n   113\t  if (fallback.kind !== \"concat\") return fallback;\n   114\t  return {\n   115\t    ...fallback,\n   116\t    reason:\n   117\t      row === undefined\n   118\t        ? \"missing_derivation\"\n   119\t        : row.state === \"failed\"\n   120\t          ? \"failed_floor\"\n   121\t          : \"not_ready\",\n   122\t  };\n   123\t}\n","exit_code":0,"status":"completed"}}

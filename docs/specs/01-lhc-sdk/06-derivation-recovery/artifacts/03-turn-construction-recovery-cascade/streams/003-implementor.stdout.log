{"type":"item.completed","item":{"id":"item_106","type":"command_execution","command":"/bin/zsh -lc 'git diff -- packages/lhc/src/domains/turns/internal/compose.ts packages/lhc/src/domains/turns/internal/derive.ts packages/lhc/src/domains/turns/internal/forms.ts packages/lhc/src/domains/turns/internal/recovery.ts'","aggregated_output":"diff --git a/packages/lhc/src/domains/turns/internal/compose.ts b/packages/lhc/src/domains/turns/internal/compose.ts\nindex 324a08c..89e1146 100644\n--- a/packages/lhc/src/domains/turns/internal/compose.ts\n+++ b/packages/lhc/src/domains/turns/internal/compose.ts\n@@ -16,14 +16,16 @@\n // part, not the prose.\n import type {\n   DependencyGap,\n-  DerivedFormMetadata,\n-  DerivedFormState,\n-  FormKind,\n+  DerivationMetadata,\n+  DerivationState,\n+  DerivationType,\n   RenderingPart,\n   RenderingPartKind,\n   ToolOutcome,\n   ToolRunReceipt,\n } from \"../../../shared/derivation.js\";\n+import { truncateForFallback } from \"../../../shared/tool-result-rendering.js\";\n+import { cleanPrompt } from \"../../messages/index.js\";\n \n // The member message as the composer sees it: kind plus projected blocks,\n // verbatim from the record (already deleted-filtered by the caller's read).\n@@ -36,18 +38,21 @@ export interface ComposeMessage {\n // One message-owned form row as composition input; keyed by the caller as\n // `${messageId}/${form}`.\n export interface ComposeFormRow {\n-  state: DerivedFormState;\n+  state: DerivationState;\n   content?: string;\n-  metadata?: DerivedFormMetadata;\n+  metadata?: DerivationMetadata;\n+  reason?: string;\n+  sourceVersion: number;\n }\n \n-export function composeFormKey(messageId: string, form: FormKind): string {\n+export function composeFormKey(messageId: string, form: DerivationType): string {\n   return `${messageId}/${form}`;\n }\n \n export interface CompositionInput {\n   parts: RenderingPart[];\n   gaps: DependencyGap[];\n+  recoveries: RecoveryReceipt[];\n   // The turn's tool-run rece
ing smoothing is consumed through turn recovery and persisted ready when no live work remains\", async () => {\n   237\t    const double = createProviderDouble();\n   238\t    const captured = double.captureInputs();\n   239\t    const sdk = sdkFor(double);\n   240\t    const filePath = await newThread();\n   241\t    const text = \"  raw     prompt because i asked  \";\n   242\t    const floor = \"raw prompt because I asked\";\n   243\t\n   244\t    await send(sdk, filePath, [\n   245\t      validEvent(\"user_prompt\", { payload: { text } }),\n   246\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   247\t      validEvent(\"turn_end\"),\n   248\t    ]);\n   249\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   250\t    await drain(sdk, filePath);\n   251\t\n   252\t    const renderingCall = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   253\t    expect((renderingCall?.input as { parts?: unknown[] } | undefined)?.parts?.[0]).toMatchObject({\n   254\t      messageId: \"m1\",\n   255\t      text: deterministicText(\"smoothPrompt\", { text: floor }, floor),\n   256\t      fallback: false,\n   257\t    });\n   258\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   259\t      state: \"ready\",\n   260\t      content: deterministicText(\"smoothPrompt\", { text: floor }, floor),\n   261\t    });\n   262\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\n   263\t  });\n   264\t\n   265\t  it(\"terminal smoothing failure lands failed with reason, then turn composition consumes the floor\", async () => {\n   266\t    const double = createProviderDouble();\n   267\t    const captured = double.captureInputs();\n   268\t    double.failKind(\"prompt_smoothing\", 99, {\n   269\t      retryable: true,\n   270\t      reason: \"scripted exhaustion\",\n   271\t    });\n   272\t    const sdk = sdkFor(double);\n   273\t    const filePath = await newThread();\n   274\t    const text = \"  failed     prompt because i asked  \";\n   275\t    const floor = \"failed prompt because I asked\";\n   276\t\n   277\t    await send(sdk, filePath, [\n   278\t      validEvent(\"user_prompt\", { payload: { text } }),\n   279\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   280\t      validEvent(\"turn_end\"),\n   281\t    ]);\n   282\t    const report = await drain(sdk, filePath);\n   283\t\n   284\t    expect(report.ran).toContainEqual(\n   285\t      expect.objectContaining({\n   286\t        workItemId: \"w-m1-prompt_smoothing-v1\",\n   287\t        disposition: \"failed_terminal\",\n   288\t        attempts: 3,\n   289\t        reason: \"scripted exhaustion\",\n   290\t      }),\n   291\t    );\n   292\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({ state: \"ready\" });\n   293\t    const renderingCall = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   294\t    expect((renderingCall?.input as { parts?: unknown[] } | undefined)?.parts?.[0]).toMatchObject({\n   295\t      messageId: \"m1\",\n   296\t      text: floor,\n   297\t      fallback: true,\n   298\t    });\n   299\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\n   300\t  });\n   301\t\n   302\t  it(\"cleanPrompt is pure for deterministic recovery floors\", () => {\n   303\t    const input = \"  please\\tfix this because i need it\\n\\n\\nnow  \";\n   304\t    expect(messages.cleanPrompt(input)).toBe(\"please fix this because I need it\\n\\nnow\");\n   305\t    expect(messages.cleanPrompt(input)).toBe(messages.cleanPrompt(input));\n   306\t    const fenced = \"```ts\\n\\tconst  i = 1;\\n\\n\\t\\treturn  i;\\n```\";\n   307\t    expect(messages.cleanPrompt(`  please\\tfix\\n${fenced}\\n because i asked  `)).toBe(\n   308\t      `please fix\\n${fenced}\\nbecause I asked`,\n   309\t    );\n   310\t  });\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/handlers.ts | sed -n '1,240p' && nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '100,190p' && nl -ba packages/lhc/src/shared/tool-result-rendering.ts\"","aggregated_output":"     1\t// The message-level derivation handlers (Flow 2): prompt smoothing and\n     2\t// tool-result summary. One shape throughout — read the\n     3\t// source message (a tool-activity handler additionally joins its call-id\n     4\t// pair, nothing more: AC-2.5), call exactly one provider operation, hand the\n     5\t// form content back through HandlerOutcome. The drain's completion\n     6\t// transaction performs the version-checked UPDATE-only write (Story 1), so a\n     7\t// stale or deleted source discards here exactly as everywhere else. Outcomes\n     8\t// on tool-activity summaries come from outcome.ts — the record, never the\n     9\t// provider's text (AC-2.4) — and land in form metadata apart from content.\n    10\timport type {\n    11\t  HandlerDerivationWrite,\n    12\t  HandlerOutcome,\n    13\t  HandlerRunContext,\n    14\t  ProviderResult,\n    15\t  WorkHandler,\n    16\t} from \"../../../shared/derivation.js\";\n    17\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    18\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    19\timport { truncateForFallback } from \"../../../shared/tool-result-rendering.js\";\n    20\timport { deriveToolOutcome } from \"./outcome.js\";\n    21\timport { cleanPrompt } from \"./smoothing.js\";\n    22\timport {\n    23\t  findPairedToolCall,\n    24\t  readMessageSource,\n    25\t  type MessageSource,\n    26\t} from \"./forms.js\";\n    27\t\n    28\t// A handler that cannot read its source coherently has found source damage:\n    29\t// terminal, derivation blocked with the reason (never a retry loop against a\n    30\t// record that cannot improve). A *deleted* source never reaches this — its\n    31\t// derivation row is gone and the completion write would discard — so a miss here\n    32\t// is genuine corruption.\n    33\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    34\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    35\t}\n    36\t\n    37\tfunction loadSource(\n    38\t  run: HandlerRunContext,\n    39\t  item: { sourceRef: Record<string, string> },\n    40\t  expectedKind: string,\n    41\t):\n    42\t  | { ok: true; messageId: string; source: MessageSource }\n    43\t  | { ok: false; outcome: HandlerOutcome } {\n    44\t  const messageId = item.sourceRef[\"messageId\"];\n    45\t  if (messageId === undefined) {\n    46\t    return { ok: false, outcome: sourceDamaged(\"work item carries no messageId\") };\n    47\t  }\n    48\t  const source = readMessageSource(run.openDb(), messageId);\n    49\t  if (source === undefined) {\n    50\t    return { ok: false, outcome: sourceDamaged(`message ${messageId} not found`) };\n    51\t  }\n    52\t  if (source.kind !== expectedKind) {\n    53\t    return {\n    54\t      ok: false,\n    55\t      outcome: sourceDamaged(\n    56\t        `message ${messageId} is kind ${source.kind}, expected ${expectedKind}`,\n    57\t      ),\n    58\t    };\n    59\t  }\n    60\t  return { ok: true, messageId, source };\n    61\t}\n    62\t\n    63\tfunction landDerivation(write: HandlerDerivationWrite, result: ProviderResult): HandlerOutcome {\n    64\t  if (!result.ok) return { ok: false, retryable: result.retryable, reason: result.reason };\n    65\t  const derivation: HandlerDerivationWrite = { ...write, content: result.text };\n    66\t  // Provenance is copied from the provider result — stamped there from\n    67\t  // config-known strings, never authored here and never parsed from text\n    68\t  // (Epic 05 DD-4). The deterministic provider sets none, so its derivations\n    69\t  // carry none.\n    70\t  if (result.provenance !== undefined) {\n    71\t    derivation.metadata = { ...(write.metadata ?? {}), provenance: result.provenance };\n    72\t  }\n    73\t  return { ok: true, derivations: [derivation] };\n    74\t}\n    75\t\n    76\tconst smoothPromptHandler: WorkHandler = async (run, item) => {\n    77\t  const loaded = loadSource(run, item, \"user_prompt\");\n    78\t  if (!loaded.ok) return loaded.outcome;\n    79\t  const text = loaded.source.blocks[0]?.content[\"text\"];\n    80\t  if (typeof text !== \"string\") {\n    81\t    return sourceDamaged(`prompt ${loaded.messageId} has no text block`);\n    82\t  }\n    83\t  const cleaned = cleanPrompt(text);\n    84\t  if (estimateTokens(cleaned) > run.config.smoothing.maxInferenceTokens) {\n    85\t    return {\n    86\t      ok: true,\n    87\t      derivations: [\n    88\t        {\n    89\t          subjectKind: \"message\",\n    90\t          subjectId: loaded.messageId,\n    91\t          derivationType: \"smoothed_prompt\",\n    92\t          content: cleaned,\n    93\t        },\n    94\t      ],\n    95\t    };\n    96\t  }\n    97\t  return landDerivation(\n    98\t    {\n    99\t      subjectKind: \"message\",\n   100\t      subjectId: loaded.messageId,\n   101\t      derivationType: \"smoothed_prompt\",\n   102\t      content: \"\",\n   103\t    },\n   104\t    await run.provider.smoothPrompt({ text: cleaned }),\n   105\t  );\n   106\t};\n   107\t\n   108\texport function toolResultGuidance(toolName: string): string {\n   109\t  const normalized = toolName.toLowerCase();\n   110\t  if (normalized.includes(\"read\") || normalized.includes(\"fetch\")) {\n   111\t    return \"Preserve paths, filenames, cited identifiers, error messages, and the parts of the retrieved content that affect the next action.\";\n   112\t  }\n   113\t  if (normalized.includes(\"search\") || normalized.includes(\"rg\") || normalized.includes(\"grep\")) {\n   114\t    return \"Preserve query terms, match counts, ranked hits, file paths, and line numbers.\";\n   115\t  }\n   116\t  if (normalized.includes(\"exec\") || normalized.includes(\"shell\") || normalized.includes(\"command\")) {\n   117\t    return \"Preserve command outcome, exit status, stderr, failing step names, and the shortest useful stdout excerpt.\";\n   118\t  }\n   119\t  return \"Preserve the status, concrete identifiers, counts, paths, and any error text or result items needed to continue.\";\n   120\t}\n   121\t\n   122\tfunction toolResultTargetTokens(tokens: number, config: HandlerRunContext[\"config\"]): number {\n   123\t  const tier = config.toolResult;\n   124\t  const ratio =\n   125\t    tokens <= tier.smallTierTokens ? tier.smallTargetRatio : tier.midTargetRatio;\n   126\t  return Math.max(1, Math.ceil(tokens * ratio));\n   127\t}\n   128\t\n   129\tconst toolResultSummaryHandler: WorkHandler = async (run, item) => {\n   130\t  const loaded = loadSource(run, item, \"tool_result\");\n   131\t  if (!loaded.ok) return loaded.outcome;\n   132\t  const block = loaded.source.blocks[0]?.content ?? {};\n   133\t  const content = block[\"content\"];\n   134\t  if (typeof content !== \"string\") {\n   135\t    return sourceDamaged(`tool result ${loaded.messageId} has no tool_result block`);\n   136\t  }\n   137\t  const toolCallId = block[\"toolCallId\"];\n   138\t  const pairedCall =\n   139\t    typeof toolCallId === \"string\"\n   140\t      ? findPairedToolCall(run.openDb(), toolCallId)\n   141\t      : undefined;\n   142\t  // The summary abbreviates; the full result content stays untouched in the\n   143\t  // record (AC-2.3) — nothing here writes back to message_block. The result\n   144\t  // is tool activity, so its outcome is stamped from its own isError flag.\n   145\t  const tokens = estimateTokens(content);\n   146\t  const outcome = deriveToolOutcome({ isError: block[\"isError\"] === true });\n   147\t  if (tokens > run.config.toolResult.largeTierTokens) {\n   148\t    return {\n   149\t      ok: true,\n   150\t      derivations: [\n   151\t        {\n   152\t          subjectKind: \"message\",\n   153\t          subjectId: loaded.messageId,\n   154\t          derivationType: \"tool_result_summary\",\n   155\t          content: truncateForFallback(content),\n   156\t          metadata: { outcome },\n   157\t        },\n   158\t      ],\n   159\t    };\n   160\t  }\n   161\t  const targetTokens = toolResultTargetTokens(tokens, run.config);\n   162\t  if (tokens <= targetTokens) {\n   163\t    return {\n   164\t      ok: true,\n   165\t      derivations: [\n   166\t        {\n   167\t          subjectKind: \"message\",\n   168\t          subjectId: loaded.messageId,\n   169\t          derivationType: \"tool_result_summary\",\n   170\t          content,\n   171\t          metadata: { outcome },\n   172\t        },\n   173\t      ],\n   174\t    };\n   175\t  }\n   176\t  return landDerivation(\n   177\t    {\n   178\t      subjectKind: \"message\",\n   179\t      subjectId: loaded.messageId,\n   180\t      derivationType: \"tool_result_summary\",\n   181\t      content: \"\",\n   182\t      metadata: { outcome },\n   183\t    },\n   184\t    await run.provider.summarizeToolResult({\n   185\t      toolName: pairedCall?.toolName ?? \"unknown_tool\",\n   186\t      content,\n   187\t      outcome,\n   188\t      targetTokens,\n   189\t      guidance: toolResultGuidance(pairedCall?.toolName ?? \"unknown_tool\"),\n   190\t    }),\n   191\t  );\n   192\t};\n   193\t\n   194\t// The domain's handler table, merged into the SDK dispatch map at\n   195\t// construction (DD-6). Turn-owned kinds stay with the turns domain.\n   196\texport const messageWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   197\t  prompt_smoothing: smoothPromptHandler,\n   198\t  tool_result_summary: toolResultSummaryHandler,\n   199\t};\n   100\t  if (projected === null) return null;\n   101\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n   102\t  const messageId = `m${event.eventOrder}`;\n   103\t  insertMessage(ctx.db, {\n   104\t    messageId,\n   105\t    sourceEventOrder: event.eventOrder,\n   106\t    kind,\n   107\t    tokenEstimate: projected.tokenEstimate,\n   108\t    actor: event.actor,\n   109\t    harness: event.harness,\n   110\t    turnId,\n   111\t    blocks: projected.blocks,\n   112\t  });\n   113\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n   114\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n   115\t  }\n   116\t  return { messageId, kind };\n   117\t}\n   118\t\n   119\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n   120\t// result queues tool_result_summary, nothing else queues anything —\n   121\t// text, thinking, and note messages are not derivation sources (Epic 01\n   122\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   123\t// intake-stream inside the batch transaction for every recorded message, so\n   124\t// the item commits (or rolls back) with the batch.\n   125\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   126\t  user_prompt: \"prompt_smoothing\",\n   127\t  tool_result: \"tool_result_summary\",\n   128\t};\n   129\t\n   130\t// Which derived form each message-owned kind produces — the owning domain's\n   131\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   132\t// rides the same transaction (DD-5).\n   133\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, DerivationType>> = {\n   134\t  prompt_smoothing: \"smoothed_prompt\",\n   135\t  tool_result_summary: \"tool_result_summary\",\n   136\t};\n   137\t\n   138\tconst DEFAULT_TOOL_RESULT_CONFIG: ResolvedSdkConfig[\"toolResult\"] = {\n   139\t  smallTierTokens: 1000,\n   140\t  largeTierTokens: 5000,\n   141\t  smallTargetRatio: 0.15,\n   142\t  midTargetRatio: 0.04,\n   143\t};\n   144\t\n   145\tfunction writeLargeToolResultSummaryReady(\n   146\t  ctx: OperationContext,\n   147\t  messageId: string,\n   148\t  config: ResolvedSdkConfig[\"toolResult\"],\n   149\t): boolean {\n   150\t  const row = ctx.db\n   151\t    .prepare(\n   152\t      `SELECT content FROM message_block\n   153\t       WHERE message_id = ? AND block_type = 'tool_result'\n   154\t       ORDER BY block_index LIMIT 1`,\n   155\t    )\n   156\t    .get(messageId) as { content: string } | undefined;\n   157\t  if (row === undefined) return false;\n   158\t  const block = JSON.parse(row.content) as Record<string, unknown>;\n   159\t  const content = block[\"content\"];\n   160\t  if (typeof content !== \"string\") return false;\n   161\t  if (estimateTokens(content) <= config.largeTierTokens) return false;\n   162\t  const metadata = JSON.stringify({ outcome: block[\"isError\"] === true ? \"failed\" : \"succeeded\" });\n   163\t  ctx.db\n   164\t    .prepare(\n   165\t      `INSERT INTO derivation\n   166\t         (subject_kind, subject_id, derivation_type, state, content, metadata, source_version, derived_at)\n   167\t       VALUES ('message', ?, 'tool_result_summary', 'ready', ?, ?, 1, ?)`,\n   168\t    )\n   169\t    .run(messageId, truncateForFallback(content), metadata, ctx.clock().toISOString());\n   170\t  return true;\n   171\t}\n   172\t\n   173\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   174\t// construction (DD-6): prompt smoothing and tool-result summaries.\n   175\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   176\t  messageWorkHandlers;\n   177\t\n   178\texport function queueMessageWork(\n   179\t  ctx: OperationContext,\n   180\t  message: MessageCreated,\n   181\t  toolResultConfig: ResolvedSdkConfig[\"toolResult\"] = DEFAULT_TOOL_RESULT_CONFIG,\n   182\t): WorkItemRecord[] {\n   183\t  if (message === null) return [];\n   184\t  const items: WorkItemRecord[] = [];\n   185\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   186\t  if (kind !
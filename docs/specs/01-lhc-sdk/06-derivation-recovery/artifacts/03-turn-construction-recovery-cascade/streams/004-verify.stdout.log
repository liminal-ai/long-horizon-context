{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/provider-double.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n     2\t// Injected at the same seam production adapters use — dependency injection,\n     3\t// not a mock of internals. Every operation returns marked, input-derived\n     4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n     5\t// functions of the input, so identical input to the same operation yields\n     6\t// identical output across double instances, and different operations are\n     7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n     8\t// captureInputs) is per-instance state and never leaks across tests that\n     9\t// construct their own double.\n    10\timport {\n    11\t  deterministicOutcomesSuffix,\n    12\t  deterministicReceiptsSuffix,\n    13\t  deterministicText,\n    14\t  type DerivationProvider,\n    15\t  type ProviderResult,\n    16\t  type RenderingPart,\n    17\t  type ToolOutcome,\n    18\t  type ToolRunReceipt,\n    19\t} from \"../../src/index.js\";\n    20\t\n    21\texport type ProviderOpName =\n    22\t  | \"smoothPrompt\"\n    23\t  | \"summarizeToolResult\"\n    24\t  | \"composeTurnRendering\"\n    25\t  | \"projectLowerBand\"\n    26\t  | \"summarizeChunkDetailed\"\n    27\t  | \"summarizeChunkBrief\";\n    28\t\n    29\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n    30\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n    31\t// as the operation names themselves.\n    32\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n    33\t  smoothPrompt: \"smoothPrompt\",\n    34\t  summarizeToolResult: \"summarizeToolResult\",\n    35\t  composeTurnRendering: \"composeTurnRendering\",\n    36\t  projectLowerBand: \"projectLowerBand\",\n    37\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n    38\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n    39\t  prompt_smoothing: \"smoothPrompt\",\n    40\t  smoothed_prompt: \"smoothPrompt\",\n    41\t  tool_result_summary: \"summarizeToolResult\",\n    42\t  turn_rendering: \"composeTurnRendering\",\n    43\t  lower_band_projection: \"projectLowerBand\",\n    44\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n    45\t  chunk_summary_brief: \"summarizeChunkBrief\",\n    46\t};\n    47\t\n    48\tfunction resolveOpName(kind: string): ProviderOpName {\n    49\t  const op = KIND_ALIASES[kind];\n    50\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n    51\t  return op;\n    52\t}\n    53\t\n    54\tinterface FailScript {\n    55\t  remaining: number;\n    56\t  retryable: boolean;\n    57\t  reason: string;\n    58\t}\n    59\t\n    60\texport interface CapturedInput {\n    61\t  op: ProviderOpName;\n    62\t  input: unknown;\n    63\t}\n    64\t\n    65\texport class ProviderDouble implements DerivationProvider {\n    66\t  private failNextScript: FailScript | null = null;\n    67\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n    68\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n    69\t  private capturing = false;\n    70\t  private readonly captured: CapturedInput[] = [];\n    71\t\n    72\t  // Fail the next n calls to any operation, then succeed.\n    73\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    74\t    this.failNextScript = {\n    75\t      remaining: n,\n    76\t      retryable: opts?.retryable ?? true,\n    77\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    78\t    };\n    79\t  }\n    80\t\n    81\t  // Fail the next n calls to one operation (kind names and op names both\n    82\t  // accepted). retryable: false scripts a terminal failure.\n    83\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    84\t    const op = resolveOpName(kind);\n    85\t    this.failByOp.set(op, {\n    86\t      remaining: n,\n    87\t      retryable: opts?.retryable ?? true,\n    88\t      reason: opts?.reason ?? `scripted failure (${op})`,\n    89\t    });\n    90\t  }\n    91\t\n    92\t  delayKind(kind: string, ms: number): void {\n    93\t    this.delayByOp.set(resolveOpName(kind), ms);\n    94\t  }\n    95\t\n    96\t  // Start capturing inputs; returns the live log (appended in call order).\n    97\t  captureInputs(): readonly CapturedInput[] {\n    98\t    this.capturing = true;\n    99\t    return this.captured;\n   100\t  }\n   101\t\n   102\t  private async run(\n   103\t    op: ProviderOpName,\n   104\t    input: unknown,\n   105\t    text: string,\n   106\t    suffix = \"\",\n   107\t  ): Promise<ProviderResult> {\n   108\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n   109\t    const delay = this.delayByOp.get(op);\n   110\t    if (delay !== undefined && delay > 0) {\n   111\t      await new Promise((resolve) => setTimeout(resolve, delay));\n   112\t    }\n   113\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n   114\t    for (const script of scripts) {\n   115\t      if (script !== null && script.remaining > 0) {\n   116\t        script.remaining -= 1;\n   117\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n   118\t      }\n   119\t    }\n   120\t    // Output format shared with src/providers/deterministic.ts so the double\n   121\t    // and the registry's \"deterministic\" provider produce byte-identical\n   122\t    // artifacts across in-process and spawned runs; the chunk-summary\n   123\t    // receipt/outcome suffixes (AC-3.8) come from the same shared helpers.\n   124\t    return { ok: true, text: deterministicText(op, input, text) + suffix };\n   125\t  }\n   126\t\n   127\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n   128\t    return this.run(\"smoothPrompt\", i, i.text);\n   129\t  }\n   130\t\n   131\t  summarizeToolResult(i: {\n   132\t    toolName: string;\n   133\t    content: string;\n   134\t    outcome?: ToolOutcome;\n   135\t    targetTokens?: number;\n   136\t    guidance?: string;\n   137\t  }): Promise<ProviderResult> {\n   138\t    return this.run(\"summarizeToolResult\", i, i.content);\n   139\t  }\n   140\t\n   141\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n   142\t    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n   143\t  }\n   144\t\n   145\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n   146\t    return this.run(\"projectLowerBand\", i, i.rendering);\n   147\t  }\n   148\t\n   149\t  summarizeChunkDetailed(i: {\n   150\t    memberProjections: string[];\n   151\t    memberReceipts?: ToolRunReceipt[][];\n   152\t  }): Promise<ProviderResult> {\n   153\t    return this.run(\n   154\t      \"summarizeChunkDetailed\",\n   155\t      i,\n   156\t      i.memberProjections.join(\" | \"),\n   157\t      deterministicReceiptsSuffix(i.memberReceipts),\n   158\t    );\n   159\t  }\n   160\t\n   161\t  summarizeChunkBrief(i: {\n   162\t    memberProjections: string[];\n   163\t    memberOutcomes?: ToolOutcome[][];\n   164\t  }): Promise<ProviderResult> {\n   165\t    return this.run(\n   166\t      \"summarizeChunkBrief\",\n   167\t      i,\n   168\t      i.memberProjections.join(\" | \"),\n   169\t      deterministicOutcomesSuffix(i.memberOutcomes),\n   170\t    );\n   171\t  }\n   172\t}\n   173\t\n   174\texport function createProviderDouble(): ProviderDouble {\n   175\t  return new ProviderDouble();\n   176\t}\n","exit_code":0,"status":"completed"}}

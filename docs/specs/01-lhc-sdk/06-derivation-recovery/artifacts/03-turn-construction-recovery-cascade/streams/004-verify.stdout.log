{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n     2\t// source turn, the member messages it composes (deleted-filtered — the\n     3\t// shared read-filter rule lives here, once for this domain), the\n     4\t// message-level form rows composition consumes, and the member projections\n     5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n     6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n     7\t// — no write path here.\n     8\timport type { DatabaseSync } from \"node:sqlite\";\n     9\timport type {\n    10\t  DependencyGap,\n    11\t  Derivation,\n    12\t  DerivationMetadata,\n    13\t  DerivationState,\n    14\t  DerivationReportEntry,\n    15\t  RenderingPartKind,\n    16\t  ToolRunReceipt,\n    17\t  DerivationType,\n    18\t  SubjectKind,\n    19\t} from \"../../../shared/derivation.js\";\n    20\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n    21\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n    22\timport { composeFormKey } from \"./compose.js\";\n    23\t\n    24\texport interface TurnSource {\n    25\t  turnId: string;\n    26\t  status: \"open\" | \"closed\";\n    27\t  deleted: boolean;\n    28\t}\n    29\t\n    30\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n    31\t  const row = db\n    32\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    33\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n    34\t  if (row === undefined) return undefined;\n    35\t  return {\n    36\t    turnId,\n    37\t    status: row.status as TurnSource[\"status\"],\n    38\t    deleted: row.deleted_at !== null,\n    39\t  };\n    40\t}\n    41\t\n    42\t// Member messages in message order, blocks attached, deleted messages\n    43\t// filtered (tech design §Mechanics: composition's member enumeration reads\n    44\t// the live projection only).\n    45\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n    46\t  const messages = db\n    47\t    .prepare(\n    48\t      `SELECT message_id, kind FROM message\n    49\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    50\t    )\n    51\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n    52\t  const blockStmt = db.prepare(\n    53\t    `SELECT block_type, content FROM message_block\n    54\t     WHERE message_id = ? ORDER BY block_index`,\n    55\t  );\n    56\t  return messages.map((message) => {\n    57\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n    58\t      block_type: string;\n    59\t      content: string;\n    60\t    }>;\n    61\t    return {\n    62\t      messageId: message.message_id,\n    63\t      kind: message.kind as RenderingPartKind,\n    64\t      blocks: blocks.map((block) => ({\n    65\t        blockType: block.block_type,\n    66\t        content: JSON.parse(block.content) as Record<string, unknown>,\n    67\t      })),\n    68\t    };\n    69\t  });\n    70\t}\n    71\t\n    72\t// The message-owned form rows for a set of member messages, keyed for\n    73\t// composition. A cross-owner *read* by design: composition consumes message\n    74\t// forms; only message handlers ever write them (DD-2 ownership is a write\n    75\t// rule).\n    76\texport function readMessageFormRows(\n    77\t  db: DatabaseSync,\n    78\t  messageIds: readonly string[],\n    79\t): Map<string, ComposeFormRow> {\n    80\t  const rows = new Map<string, ComposeFormRow>();\n    81\t  if (messageIds.length === 0) return rows;\n    82\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n    83\t  const raw = db\n    84\t    .prepare(\n    85\t      `SELECT subject_id, derivation_type, state, content, reason, metadata, source_version\n    86\t       FROM derivation\n    87\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    88\t    )\n    89\t    .all(...messageIds) as unknown as Array<{\n    90\t    subject_id: string;\n    91\t    derivation_type: string;\n    92\t    state: string;\n    93\t    content: string | null;\n    94\t    reason: string | null;\n    95\t    metadata: string | null;\n    96\t    source_version: number | bigint;\n    97\t  }>;\n    98\t  for (const row of raw) {\n    99\t    const view: ComposeFormRow = {\n   100\t      state: row.state as ComposeFormRow[\"state\"],\n   101\t      sourceVersion: Number(row.source_version),\n   102\t    };\n   103\t    if (row.content !== null) view.content = row.content;\n   104\t    if (row.reason !== null) view.reason = row.reason;\n   105\t    if (row.metadata !== null) {\n   106\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n   107\t    }\n   108\t    rows.set(composeFormKey(row.subject_id, row.derivation_type as DerivationType), view);\n   109\t  }\n   110\t  return rows;\n   111\t}\n   112\t\n   113\t// Member projections in turn order for the chunk summaries: member rows by\n   114\t// member_idx, deleted turns filtered, each joined to its stored\n   115\t// lower_band_projection row (state + content as landed — never re-derived)\n   116\t// and to its turn_rendering's mechanically stamped tool-run receipts\n   117\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\n   118\texport interface MemberProjection {\n   119\t  turnId: string;\n   120\t  state?: string; // undefined: no projection row exists for the member\n   121\t  content?: string;\n   122\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n   123\t}\n   124\t\n   125\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n   126\t  const rows = db\n   127\t    .prepare(\n   128\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n   129\t       FROM chunk_member cm\n   130\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   131\t       LEFT JOIN derivation df ON df.subject_kind = 'turn'\n   132\t         AND df.subject_id = cm.turn_id AND df.derivation_type = 'lower_band_projection'\n   133\t       LEFT JOIN derivation rf ON rf.subject_kind = 'turn'\n   134\t         AND rf.subject_id = cm.turn_id AND rf.derivation_type = 'turn_rendering'\n   135\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   136\t    )\n   137\t    .all(chunkId) as unknown as Array<{\n   138\t    turn_id: string;\n   139\t    state: string | null;\n   140\t    content: string | null;\n   141\t    rendering_metadata: string | null;\n   142\t  }>;\n   143\t  return rows.map((row) => {\n   144\t    const metadata =\n   145\t      row.rendering_metadata === null\n   146\t        ? undefined\n   147\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n   148\t    const projection: MemberProjection = {\n   149\t      turnId: row.turn_id,\n   150\t      receipts: metadata?.receipts ?? [],\n   151\t    };\n   152\t    if (row.state !== null) projection.state = row.state;\n   153\t    if (row.content !== null) projection.content = row.content;\n   154\t    return projection;\n   155\t  });\n   156\t}\n   157\t\n   158\tinterface RawOwnedFormRow {\n   159\t  subject_id: string;\n   160\t  derivation_type: string;\n   161\t  state: string;\n   162\t  content: string | null;\n   163\t  reason: string | null;\n   164\t  metadata: string | null;\n   165\t  source_version: number | bigint;\n   166\t  gaps: string | null;\n   167\t  derived_at: string | null;\n   168\t}\n   169\t\n   170\t// Every form row this owner holds for one subject kind, grouped by subject\n   171\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\n   172\t// \"record with form states\", mirroring messages.readMessageForms). Rows come\n   173\t// back exactly as the pipeline landed them; nothing is derived at read time.\n   174\texport function readOwnedForms(\n   175\t  db: DatabaseSync,\n   176\t  subjectKind: \"turn\" | \"chunk\",\n   177\t): Map<string, Derivation[]> {\n   178\t  const rows = db\n   179\t    .prepare(\n   180\t      `SELECT subject_id, derivation_type, state, content, reason, metadata,\n","exit_code":0,"status":"completed"}}

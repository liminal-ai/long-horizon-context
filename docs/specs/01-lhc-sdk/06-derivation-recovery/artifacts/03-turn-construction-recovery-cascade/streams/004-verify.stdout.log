{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '1,520p'\"","aggregated_output":"     1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n     2\t// wrapper that makes \"queueing is what schedules processing\" structural\n     3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n     4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n     5\t// a turn or a summary is; which kinds queue for which sources, and which\n     6\t// derivations a kind produces, is the owning domains' business (callers\n     7\t// pass the derivation targets in). Writes run on the caller's handle inside the\n     8\t// ambient transaction, so items commit (or roll back) with the batch. No\n     9\t// public SDK surface: read-back reaches here only through the owning\n    10\t// domains' listQueuedWork.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport {\n    13\t  createCommitHooks,\n    14\t  type OperationContext,\n    15\t} from \"../../shared/context.js\";\n    16\timport type {\n    17\t  CompletionTx,\n    18\t  DerivationType,\n    19\t  HandlerDerivationWrite,\n    20\t  SubjectKind,\n    21\t} from \"../../shared/derivation.js\";\n    22\t\n    23\texport type WorkOwner = \"messages\" | \"turns\";\n    24\texport type WorkKind =\n    25\t  | \"prompt_smoothing\"\n    26\t  | \"tool_result_summary\"\n    27\t  | \"turn_derivation\"\n    28\t  | \"chunk_summary_detailed\"\n    29\t  | \"chunk_summary_brief\";\n    30\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n    31\t\n    32\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n    33\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n    34\t// the owning domain's handler (registered at SDK construction, DD-6).\n    35\texport const WORK_KIND_REGISTRY: Readonly<\n    36\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n    37\t> = {\n    38\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    39\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    40\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n    41\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    42\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    43\t};\n    44\t\n    45\texport interface WorkItemRecord {\n    46\t  workItemId: string;\n    47\t  owner: WorkOwner;\n    48\t  kind: WorkKind;\n    49\t  sourceRef: WorkSourceRef;\n    50\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n    51\t  queuedAt: string;\n    52\t}\n    53\t\n    54\t// The derivations an enqueue is scheduling work toward; the owning domain\n    55\t// names them (the util stays meaning-blind). Stored in the row's payload so\n    56\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n    57\t// derivation's failed/blocked state without asking any domain what a kind means.\n    58\texport interface EnqueueDerivationTarget {\n    59\t  subjectKind: SubjectKind;\n    60\t  subjectId: string;\n    61\t  derivationType: DerivationType;\n    62\t}\n    63\t\n    64\texport interface WorkItemInput {\n    65\t  owner: WorkOwner;\n    66\t  kind: WorkKind;\n    67\t  sourceRef: WorkSourceRef;\n    68\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n    69\t  derivations?: readonly EnqueueDerivationTarget[]; // carried in payload for the drain's terminal paths\n    70\t}\n    71\t\n    72\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n    73\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n    74\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n    75\t  return sourceRef.chunkId;\n    76\t}\n    77\t\n    78\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n    79\t// same kind for the same source *at the same version* is the same id —\n    80\t// natural idempotency for the repair path — while a post-mutation\n    81\t// replacement (next version) never collides with an in-flight pre-mutation\n    82\t// item.\n    83\texport function recordItem(\n    84\t  db: DatabaseSync,\n    85\t  input: WorkItemInput,\n    86\t  queuedAt: string,\n    87\t): WorkItemRecord {\n    88\t  const sourceVersion = input.sourceVersion ?? 1;\n    89\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n    90\t  db.prepare(\n    91\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n    92\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n    93\t  ).run(\n    94\t    workItemId,\n    95\t    input.owner,\n    96\t    input.kind,\n    97\t    JSON.stringify(input.sourceRef),\n    98\t    queuedAt,\n    99\t    JSON.stringify({ sourceVersion, derivations: input.derivations ?? [] }),\n   100\t  );\n   101\t  return {\n   102\t    workItemId,\n   103\t    owner: input.owner,\n   104\t    kind: input.kind,\n   105\t    sourceRef: input.sourceRef,\n   106\t    status: \"queued\",\n   107\t    queuedAt,\n   108\t  };\n   109\t}\n   110\t\n   111\texport interface EnqueueInput extends WorkItemInput {\n   112\t  derivations: readonly EnqueueDerivationTarget[];\n   113\t}\n   114\t\n   115\t// The one way work is scheduled (DD-5): the work row, the derivation's `pending`\n   116\t// state row, and the scheduler poke all ride the ambient transaction — they\n   117\t// commit together or vanish together. Enqueue is the *only* place a\n   118\t// derivation row is created (completion is UPDATE-only); re-enqueueing\n   119\t// resets an existing row to pending at the enqueued source version.\n   120\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n   121\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n   122\t  const sourceVersion = input.sourceVersion ?? 1;\n   123\t  const upsert = ctx.db.prepare(\n   124\t    `INSERT INTO derivation (subject_kind, subject_id, derivation_type, state, source_version)\n   125\t     VALUES (?, ?, ?, 'pending', ?)\n   126\t     ON CONFLICT (subject_kind, subject_id, derivation_type) DO UPDATE SET\n   127\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n   128\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n   129\t  );\n   130\t  for (const target of input.derivations) {\n   131\t    upsert.run(target.subjectKind, target.subjectId, target.derivationType, sourceVersion);\n   132\t  }\n   133\t  ctx.onCommit(() => ctx.poke(ctx.threadId));\n   134\t  return item;\n   135\t}\n   136\t\n   137\tinterface RawWorkItemRow {\n   138\t  work_item_id: string;\n   139\t  owner: string;\n   140\t  kind: string;\n   141\t  source_ref: string;\n   142\t  queued_at: string;\n   143\t}\n   144\t\n   145\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n   146\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n   147\t// complete, and the terminal half of failAttempt each own one short\n   148\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n   149\t\n   150\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n   151\t// source version and form targets. `kind` is a plain string here — a raw row\n   152\t// with an unregistered kind must still be claimable so the drain can land it\n   153\t// failed_terminal instead of skipping it (AC-1.8).\n   154\texport interface ClaimedWorkItem {\n   155\t  workItemId: string;\n   156\t  owner: WorkOwner;\n   157\t  kind: string;\n   158\t  sourceRef: WorkSourceRef;\n   159\t  attempts: number;\n   160\t  queuedAt: string;\n   161\t  sourceVersion: number;\n   162\t  derivations: EnqueueDerivationTarget[];\n   163\t}\n   164\t\n   165\texport type ClaimOutcome =\n   166\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n   167\t  | { outcome: \"empty\" }\n   168\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n   169\t  | { outcome: \"waiting\"; waitingUntil: string };\n   170\t\n   171\tinterface RawClaimRow {\n   172\t  work_item_id: string;\n   173\t  owner: string;\n   174\t  kind: string;\n   175\t  source_ref: string;\n   176\t  attempts: number | bigint;\n   177\t  queued_at: string;\n   178\t  payload: string | null;\n   179\t}\n   180\t\n   181\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n   182\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n   183\t// v5, shared/storage.ts): the backfill created pending derivation rows at\n   184\t// source version 1 for these kinds, and a terminal failure must find them —\n   185\t// otherwise exhaustion would delete the work row and strand the backfilled\n   186\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n   187\tconst LEGACY_KIND_DERIVATIONS: Partial<\n   188\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; derivationType: DerivationType }>>\n   189\t> = {\n   190\t  prompt_smoothing: [{ subjectKind: \"message\", derivationType: \"smoothed_prompt\" }],\n   191\t  tool_result_summary: [{ subjectKind: \"message\", derivationType: \"tool_result_summary\" }],\n   192\t  turn_derivation: [\n   193\t    { subjectKind: \"turn\", derivationType: \"turn_rendering\" },\n   194\t    { subjectKind: \"turn\", derivationType: \"lower_band_projection\" },\n   195\t  ],\n   196\t};\n   197\t\n   198\tfunction legacyDerivationTargets(kind: string, sourceRef: WorkSourceRef): EnqueueDerivationTarget[] {\n   199\t  const mapped = LEGACY_KIND_DERIVATIONS[kind];\n   200\t  if (mapped === undefined) return [];\n   201\t  const subjectId = sourceIdOf(sourceRef);\n   202\t  return mapped.map((target) => ({ ...target, subjectId }));\n   203\t}\n   204\t\n   205\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n   206\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n   207\t  const payload =\n   208\t    row.payload === null\n   209\t      ? // Pre-v5 row: version 1 (matching the backfill) and derivation targets\n   210\t        // reconstructed from the backfill's own mapping.\n   211\t        { sourceVersion: 1, derivations: legacyDerivationTargets(row.kind, sourceRef) }\n   212\t      : (JSON.parse(row.payload) as { sourceVersion?: number; derivations?: EnqueueDerivationTarget[] });\n   213\t  return {\n   214\t    workItemId: row.work_item_id,\n   215\t    owner: row.owner as WorkOwner,\n   216\t    kind: row.kind,\n   217\t    sourceRef,\n   218\t    attempts: Number(row.attempts),\n   219\t    queuedAt: row.queued_at,\n   220\t    sourceVersion: payload.sourceVersion ?? 1,\n   221\t    derivations: payload.derivations ?? [],\n   222\t  };\n   223\t}\n   224\t\n   225\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n   226\t// live row only — a later eligible row is never considered while an older\n   227\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n   228\t// write split: the race window is the bug class). The CASE increments\n   229\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n   230\t// run died or hung, and the increment makes the crash visible in the report\n   231\t// and counts it against the retry budget; normal claims never touch it.\n   232\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n   233\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n   234\t  db.exec(\"BEGIN IMMEDIATE;\");\n   235\t  try {\n   236\t    const claimed = db\n   237\t      .prepare(\n   238\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n   239\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n   240\t         WHERE work_item_id = (\n   241\t           SELECT work_item_id FROM (\n   242\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n   243\t             FROM work_item WHERE status IN ('queued', 'claimed')\n   244\t             ORDER BY rowid LIMIT 1\n   245\t           )\n   246\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n   247\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n   248\t         )\n   249\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n   250\t      )\n   251\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n   252\t    if (claimed !== undefined) {\n   253\t      db.exec(\"COMMIT;\");\n   254\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n   255\t    }\n   256\t    // No row claimable: re-read the head inside the same transaction to\n   257\t    // classify the stop. A claimed head with a live lease gates the queue\n   258\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n   259\t    // (waiting) — strict ordering, never reordered around the head.\n   260\t    const head = db\n   261\t      .prepare(\n   262\t        `SELECT status, eligible_at, claim_expires_at\n   263\t         FROM work_item WHERE status IN ('queued', 'claimed')\n   264\t         ORDER BY rowid LIMIT 1`,\n   265\t      )\n   266\t      .get() as unknown as\n   267\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n   268\t      | undefined;\n   269\t    db.exec(\"COMMIT;\");\n   270\t    if (head === undefined) return { outcome: \"empty\" };\n   271\t    if (head.status === \"claimed\") {\n   272\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n   273\t    }\n   274\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n   275\t  } catch (cause) {\n   276\t    db.exec(\"ROLLBACK;\");\n   277\t    throw cause;\n   278\t  }\n   279\t}\n   280\t\n   281\t// Completion: the version-checked derivation writes and the item row's deletion in\n   282\t// one short transaction (DD-1: terminal transition deletes the row; the\n   283\t// disposition is reported in-memory, never stored). UPDATE-only, never\n   284\t// upsert — the pending row exists from enqueue; a write that finds no row at\n   285\t// the item's source version is discarded as stale (DD-3 truth table). The\n   286\t// optional onApplied hook (Story 3) runs inside this same transaction, after\n   287\t// the derivation writes and only when they landed — chunk placement and the\n   288\t// close→summary enqueues ride the completion commit; its onCommit\n   289\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\n   290\texport function complete(\n   291\t  db: DatabaseSync,\n   292\t  item: ClaimedWorkItem,\n   293\t  writes: readonly HandlerDerivationWrite[],\n   294\t  derivedAt: string,\n   295\t  onApplied?: (tx: CompletionTx) => void,\n   296\t): \"done\" | \"stale_discarded\" {\n   297\t  const hooks = createCommitHooks();\n   298\t  db.exec(\"BEGIN IMMEDIATE;\");\n   299\t  try {\n   300\t    let hits = 0;\n   301\t    const update = db.prepare(\n   302\t      `UPDATE derivation\n   303\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = NULL, derived_at = ?\n   304\t       WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ? AND source_version = ?`,\n   305\t    );\n   306\t    for (const write of writes) {\n   307\t      const changed = update.run(\n   308\t        write.content,\n   309\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n   310\t        derivedAt,\n   311\t        write.subjectKind,\n   312\t        write.subjectId,\n   313\t        write.derivationType,\n   314\t        item.sourceVersion,\n   315\t      );\n   316\t      hits += Number(changed.changes);\n   317\t    }\n   318\t    const stale = writes.length > 0 && hits === 0;\n   319\t    if (!stale && onApplied !== undefined) {\n   320\t      onApplied({ db, onCommit: hooks.register });\n   321\t    }\n   322\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   323\t    db.exec(\"COMMIT;\");\n   324\t    hooks.flush();\n   325\t    return stale ? \"stale_discarded\" : \"done\";\n   326\t  } catch (cause) {\n   327\t    db.exec(\"ROLLBACK;\");\n   328\t    throw cause;\n   329\t  }\n   330\t}\n   331\t\n   332\texport interface RetryPolicy {\n   333\t  budget: number;\n   334\t  backoffBaseMs: number;\n   335\t  backoffCapMs: number;\n   336\t}\n   337\t\n   338\texport type FailAttemptResult =\n   339\t  | { terminal: false; attempts: number; eligibleAt: string }\n   340\t  | { terminal: true; attempts: number };\n   341\t\n   342\t// Terminal failure: the derivation rows land `failed` (or `blocked` for source\n   343\t// damage) carrying the final reason plus attempts/last-error copied onto the\n   344\t// derivation's metadata, and the item row is deleted — one transaction (DD-1).\n   345\t// Derivation writes stay version-checked: if a mutation moved the source since this\n   346\t// item was queued, the stale failure must not stamp the rebuilt derivation.\n   347\texport function failTerminal(\n   348\t  db: DatabaseSync,\n   349\t  item: ClaimedWorkItem,\n   350\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n   351\t): void {\n   352\t  db.exec(\"BEGIN IMMEDIATE;\");\n   353\t  try {\n   354\t    const update = db.prepare(\n   355\t      `UPDATE derivation\n   356\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n   357\t       WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ? AND source_version = ?`,\n   358\t    );\n   359\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n   360\t    for (const target of item.derivations) {\n   361\t      update.run(\n   362\t        opts.formState,\n   363\t        opts.reason,\n   364\t        metadata,\n   365\t        opts.now,\n   366\t        target.subjectKind,\n   367\t        target.subjectId,\n   368\t        target.derivationType,\n   369\t        item.sourceVersion,\n   370\t      );\n   371\t    }\n   372\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   373\t    db.exec(\"COMMIT;\");\n   374\t  } catch (cause) {\n   375\t    db.exec(\"ROLLBACK;\");\n   376\t    throw cause;\n   377\t  }\n   378\t}\n   379\t\n   380\t// A failed run counts itself. Under budget and retryable: the row goes back\n   381\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n   382\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n   383\t// on a non-retryable failure, the item is terminal: derivation `failed` with the\n   384\t// final reason, row deleted (AC-1.9).\n   385\texport function failAttempt(\n   386\t  db: DatabaseSync,\n   387\t  item: ClaimedWorkItem,\n   388\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n   389\t): FailAttemptResult {\n   390\t  const attempts = item.attempts + 1;\n   391\t  if (opts.retryable && attempts < opts.retry.budget) {\n   392\t    const backoffMs = Math.min(\n   393\t      opts.retry.backoffBaseMs * 2 ** attempts,\n   394\t      opts.retry.backoffCapMs,\n   395\t    );\n   396\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n   397\t    db.exec(\"BEGIN IMMEDIATE;\");\n   398\t    try {\n   399\t      db.prepare(\n   400\t        `UPDATE work_item\n   401\t         SET status = 'queued', attempts = ?, last_error = ?,\n   402\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n   403\t         WHERE work_item_id = ?`,\n   404\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n   405\t      db.exec(\"COMMIT;\");\n   406\t    } catch (cause) {\n   407\t      db.exec(\"ROLLBACK;\");\n   408\t      throw cause;\n   409\t    }\n   410\t    return { terminal: false, attempts, eligibleAt };\n   411\t  }\n   412\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n   413\t  return { terminal: true, attempts };\n   414\t}\n   415\t\n   416\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n   417\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n   418\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n   419\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n   420\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n   421\t// discards their stale completions. Ships here as mechanics; its only caller\n   422\t// is Story 5's cascade.\n   423\texport function supersedeQueued(\n   424\t  db: DatabaseSync,\n   425\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n   426\t): string[] {\n   427\t  const ids: string[] = [];\n   428\t  const remove = db.prepare(\n   429\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n   430\t     RETURNING work_item_id`,\n   431\t  );\n   432\t  for (const target of targets) {\n   433\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n   434\t      work_item_id: string;\n   435\t    }>;\n   436\t    for (const row of rows) ids.push(row.work_item_id);\n   437\t  }\n   438\t  return ids;\n   439\t}\n   440\t\n   441\t// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n   442\t// queued or in flight — for this kind and source at this source version?\n   443\t// Runs inside the caller's requeue transaction so the check and the enqueue\n   444\t// commit together (anti-shim: a check-then-enqueue split across transactions\n   445\t// reintroduces the duplicate-work race). Version-scoped on purpose: a\n   446\t// claimed pre-mutation item at an older version is dying work whose\n   447\t// completion DD-3 will discard — it must not block the repair.\n   448\texport function hasLiveItem(\n   449\t  db: DatabaseSync,\n   450\t  kind: WorkKind,\n   451\t  sourceRef: WorkSourceRef,\n   452\t  sourceVersion: number,\n   453\t): boolean {\n   454\t  const row = db\n   455\t    .prepare(\n   456\t      `SELECT 1 FROM work_item\n   457\t       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n   458\t         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n   459\t       LIMIT 1`,\n   460\t    )\n   461\t    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n   462\t  return row !== undefined;\n   463\t}\n   464\t\n   465\t// Live items left in the queue — the drain report's `remaining` and the\n   466\t// repair report's join source (Story 4).\n   467\texport function countLiveItems(db: DatabaseSync): number {\n   468\t  const row = db\n   469\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n   470\t    .get() as unknown as { n: number | bigint };\n   471\t  return Number(row.n);\n   472\t}\n   473\t\n   474\texport interface QueueDetailRow {\n   475\t  workItemId: string;\n   476\t  owner: WorkOwner;\n   477\t  kind: string;\n   478\t  sourceRef: WorkSourceRef;\n   479\t  status: \"queued\" | \"claimed\";\n   480\t  attempts: number;\n   481\t  lastError?: string;\n   482\t  eligibleAt?: string;\n   483\t  claimedAt?: string;\n   484\t  claimExpiresAt?: string;\n   485\t  queuedAt: string;\n   486\t  sourceVersion: number;\n   487\t}\n   488\t\n   489\t// Mechanical detail of every live row in queue order — what the repair\n   490\t// report joins against derivation (Flow 4) and what tests read to assert\n   491\t// lease/backoff state without raw SQL at every call site.\n   492\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n   493\t  const rows = db\n   494\t    .prepare(\n   495\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n   496\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n   497\t       FROM work_item ORDER BY rowid`,\n   498\t    )\n   499\t    .all() as unknown as Array<\n   500\t    RawClaimRow & {\n   501\t      status: string;\n   502\t      last_error: string | null;\n   503\t      eligible_at: string | null;\n   504\t      claimed_at: string | null;\n   505\t      claim_expires_at: string | null;\n   506\t    }\n   507\t  >;\n   508\t  return rows.map((row) => {\n   509\t    const item = toClaimedItem(row);\n   510\t    const detail: QueueDetailRow = {\n   511\t      workItemId: item.workItemId,\n   512\t      owner: item.owner,\n   513\t      kind: item.kind,\n   514\t      sourceRef: item.sourceRef,\n   515\t      status: row.status as \"queued\" | \"claimed\",\n   516\t      attempts: item.attempts,\n   517\t      queuedAt: item.queuedAt,\n   518\t      sourceVersion: item.sourceVersion,\n   519\t    };\n   520\t    if (row.last_error !== null) detail.lastError = row.last_error;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,180p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Epic 02 shared vocabulary: the derivation state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\t// Type-only and erased at build: the runtime graph stays one-directional\n     8\t// (inference/ imports shared/, never the reverse).\n     9\timport type { InferenceConfig } from \"../inference/types.js\";\n    10\timport type { ResolvedViewConfig, SdkViewConfig } from \"./view.js\";\n    11\t\n    12\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n    13\t\n    14\t// The kind set is a runtime constant with the type derived from it, so code\n    15\t// that must cover every kind — assignment validation above all (Epic 05\n    16\t// AC-1.3) — iterates the exported set instead of maintaining a second\n    17\t// literal list that can drift.\n    18\texport const DERIVATION_TYPES = [\n    19\t  \"smoothed_prompt\",\n    20\t  \"tool_result_summary\",\n    21\t  \"turn_rendering\",\n    22\t  \"lower_band_projection\",\n    23\t  \"chunk_summary_detailed\",\n    24\t  \"chunk_summary_brief\",\n    25\t] as const;\n    26\t\n    27\texport type DerivationType = (typeof DERIVATION_TYPES)[number];\n    28\t\n    29\texport type DerivationState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    30\t\n    31\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    32\t// (isError/presence), never authored by the provider (AC-2.4).\n    33\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    34\t\n    35\t// A composed derivation's record of a dependency that fell back during composition:\n    36\t// names the source record and the derivation type that was not ready (AC-3.2/3.3).\n    37\texport interface DependencyGap {\n    38\t  subjectKind: SubjectKind;\n    39\t  subjectId: string;\n    40\t  derivationType: DerivationType;\n    41\t}\n    42\t\n    43\t// The read shape for one derivation's state row (DD-2, DD-3).\n    44\texport interface Derivation {\n    45\t  subjectKind: SubjectKind;\n    46\t  subjectId: string;\n    47\t  derivationType: DerivationType;\n    48\t  state: DerivationState;\n    49\t  content?: string; // ready only\n    50\t  reason?: string; // failed | blocked\n    51\t  sourceVersion: number; // which version of the source this derivation derives from (DD-3)\n    52\t  gaps?: DependencyGap[]; // composed derivations; landed-with-fallback record\n    53\t  metadata?: DerivationMetadata; // mechanically stamped fields; never provider-authored\n    54\t  derivedAt?: string;\n    55\t}\n    56\t\n    57\t// One tool call's or result's receipt within a turn's composed account\n    58\t// (AC-3.8): the account text — what changed, as composed — plus the\n    59\t// mechanically derived outcome. Derived from the composition input, never\n    60\t// from provider prose; stamped on the turn_rendering form so the chunk\n    61\t// summaries can read receipts machine-readably in turn order.\n    62\texport interface ToolRunReceipt {\n    63\t  messageId: string;\n    64\t  activity: \"tool_call\" | \"tool_result\";\n    65\t  account: string;\n    66\t  outcome: ToolOutcome;\n    67\t}\n    68\t\n    69\t// Mechanically stamped derivation metadata: tool outcomes (AC-2.4), the turn\n    70\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n    71\t// final attempts/last-error copied from the work item before its row is\n    72\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n    73\t// lives here).\n    74\texport interface DerivationMetadata {\n    75\t  outcome?: ToolOutcome;\n    76\t  receipts?: ToolRunReceipt[];\n    77\t  attempts?: number;\n    78\t  lastError?: string;\n    79\t  // Epic 05 (DD-4): which provider/model/prompt produced the content —\n    80\t  // copied from the ProviderResult's config-known strings, never authored\n    81\t  // from model output. The deterministic provider never sets it.\n    82\t  provenance?: ProviderProvenance;\n    83\t}\n    84\t\n    85\t// One row of an owner's repair report (Flow 4): the derivation's durable state\n    86\t// joined with the queue's mechanical detail for the live item still working\n    87\t// toward it, if any. The five operational situations read from this one row:\n    88\t// never-attempted (pending, no queue), retrying (pending + queue with\n    89\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n    90\t// ever needs a queue API.\n    91\texport interface DerivationReportEntry extends Derivation {\n    92\t  queue?: {\n    93\t    status: \"queued\" | \"claimed\";\n    94\t    attempts: number;\n    95\t    lastError?: string;\n    96\t    eligibleAt?: string;\n    97\t  };\n    98\t}\n    99\t\n   100\t// ── provider seam (DD-7) ─────────────────────────────────────────\n   101\t// Every operation returns content or a structured failure carrying\n   102\t// retryable-or-not; classification is the adapter's duty.\n   103\t// Provenance: the three config-known assignment strings, stamped by the\n   104\t// inference adapter (it alone knows the assignment) and copied by handlers\n   105\t// into derivation metadata (Epic 05 DD-4). Never derived from model output.\n   106\texport interface ProviderProvenance {\n   107\t  provider: string;\n   108\t  model: string;\n   109\t  prompt: string;\n   110\t}\n   111\t\n   112\texport type ProviderResult =\n   113\t  | { ok: true; text: string; provenance?: ProviderProvenance }\n   114\t  | { ok: false; retryable: boolean; reason: string };\n   115\t\n   116\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n   117\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n   118\t// rather than imported: shared/ may not import domains/.\n   119\texport type RenderingPartKind =\n   120\t  | \"user_prompt\"\n   121\t  | \"assistant_text\"\n   122\t  | \"assistant_thinking\"\n   123\t  | \"runtime_note\"\n   124\t  | \"tool_call\"\n   125\t  | \"tool_result\";\n   126\t\n   127\texport interface RenderingPart {\n   128\t  messageId: string;\n   129\t  kind: RenderingPartKind;\n   130\t  text: string; // ready derivation content, or raw/truncated fallback\n   131\t  fallback: boolean; // true ⇒ gap recorded\n   132\t  outcome?: ToolOutcome; // tool activity only\n   133\t}\n   134\t\n   135\texport interface DerivationProvider {\n   136\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n   137\t  summarizeToolResult(i: {\n   138\t    toolName: string;\n   139\t    content: string;\n   140\t    outcome?: ToolOutcome;\n   141\t    targetTokens?: number;\n   142\t    guidance?: string;\n   143\t  }): Promise<ProviderResult>;\n   144\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n   145\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n   146\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n   147\t  // the members' tool-run receipts (what changed, outcome) alongside the\n   148\t  // projections; brief receives outcomes only — receipt text is stripped\n   149\t  // before the provider is called, so brief structurally cannot leak it.\n   150\t  // The receipt fields are optional in the type for callers without member\n   151\t  // context (the production chunk handlers always pass them).\n   152\t  summarizeChunkDetailed(i: {\n   153\t    memberProjections: string[];\n   154\t    memberReceipts?: ToolRunReceipt[][];\n   155\t  }): Promise<ProviderResult>;\n   156\t  summarizeChunkBrief(i: {\n   157\t    memberProjections: string[];\n   158\t    memberOutcomes?: ToolOutcome[][];\n   159\t  }): Promise<ProviderResult>;\n   160\t}\n   161\t\n   162\texport const PROVIDER_OPERATIONS = [\n   163\t  \"smoothPrompt\",\n   164\t  \"summarizeToolResult\",\n   165\t  \"composeTurnRendering\",\n   166\t  \"projectLowerBand\",\n   167\t  \"summarizeChunkDetailed\",\n   168\t  \"summarizeChunkBrief\",\n   169\t] as const;\n   170\t\n   171\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n   172\t\n   173\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n   174\t// Provider arrival is exactly one of `provider` (direct injection,\n   175\t// unchanged — the deterministic test default) or `inference` (host\n   176\t// model-call function + per-kind assignments, Epic 05 DD-5). Both or\n   177\t// neither is a construction TypeError naming the XOR rule (AC-1.1).\n   178\texport interface SdkConfig {\n   179\t  provider?: DerivationProvider;\n   180\t  inference?: InferenceConfig;\n","exit_code":0,"status":"completed"}}

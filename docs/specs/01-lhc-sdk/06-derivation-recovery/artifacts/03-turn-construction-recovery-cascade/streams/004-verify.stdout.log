{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/scheduler.ts | sed -n '80,160p'\"","aggregated_output":"    80\t}\n    81\t\n    82\t// The drain loop against an open handle. Claim → dispatch → complete, one\n    83\t// item at a time, until the head stops it (empty / in_flight / waiting) or\n    84\t// maxItems is reached. The handler runs with NO open transaction; the only\n    85\t// exits from a handler failure are failAttempt and the terminal paths — the\n    86\t// drain never catches an error and records success.\n    87\texport async function drainOpenDb(\n    88\t  db: DatabaseSync,\n    89\t  deps: DrainDeps,\n    90\t  opts?: { maxItems?: number },\n    91\t): Promise<DrainReport> {\n    92\t  const { clock, lease, retry, provider } = deps.config;\n    93\t  const ran: DrainReport[\"ran\"] = [];\n    94\t  let stoppedBecause: DrainReport[\"stoppedBecause\"];\n    95\t  let waitingUntil: string | undefined;\n    96\t\n    97\t  for (;;) {\n    98\t    if (opts?.maxItems !== undefined && ran.length >= opts.maxItems) {\n    99\t      stoppedBecause = \"max_items\";\n   100\t      break;\n   101\t    }\n   102\t    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\n   103\t    if (claim.outcome === \"empty\") {\n   104\t      stoppedBecause = \"empty\";\n   105\t      break;\n   106\t    }\n   107\t    if (claim.outcome === \"in_flight\") {\n   108\t      stoppedBecause = \"in_flight\";\n   109\t      break;\n   110\t    }\n   111\t    if (claim.outcome === \"waiting\") {\n   112\t      stoppedBecause = \"waiting\";\n   113\t      waitingUntil = claim.waitingUntil;\n   114\t      break;\n   115\t    }\n   116\t    const item = claim.item;\n   117\t\n   118\t    const lookedUp = deps.lookupHandler(item.kind);\n   119\t    if (!lookedUp.ok) {\n   120\t      // Unregistered kind: the normal terminal transaction, not a try/catch\n   121\t      // skip — failed_terminal with the stable code, form (if resolvable\n   122\t      // from the payload) lands failed, and the drain continues (AC-1.8).\n   123\t      failTerminal(db, item, {\n   124\t        reason: lookedUp.error.code,\n   125\t        formState: \"failed\",\n   126\t        attempts: item.attempts,\n   127\t        now: clock().toISOString(),\n   128\t      });\n   129\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts, lookedUp.error.code));\n   130\t      continue;\n   131\t    }\n   132\t\n   133\t    let outcome: HandlerOutcome;\n   134\t    try {\n   135\t      outcome = await lookedUp.value(\n   136\t        { openDb: () => db, provider, clock, config: deps.config },\n   137\t        {\n   138\t          workItemId: item.workItemId,\n   139\t          kind: item.kind,\n   140\t          sourceRef: item.sourceRef as unknown as Record<string, string>,\n   141\t        },\n   142\t      );\n   143\t    } catch (cause) {\n   144\t      // A throwing handler is a bug by the error contract, but the queue\n   145\t      // must not wedge on it: route it through the normal retry path so it\n   146\t      // counts attempts and exhausts visibly.\n   147\t      const detail = cause instanceof Error ? cause.message : String(cause);\n   148\t      outcome = { ok: false, retryable: true, reason: `handler threw: ${detail}` };\n   149\t    }\n   150\t\n   151\t    if (outcome.ok) {\n   152\t      const disposition = complete(\n   153\t        db,\n   154\t        item,\n   155\t        outcome.derivations ?? [],\n   156\t        clock().toISOString(),\n   157\t        outcome.onApplied,\n   158\t      );\n   159\t      ran.push(ranEntry(item, disposition, item.attempts));\n   160\t      continue;\n","exit_code":0,"status":"completed"}}

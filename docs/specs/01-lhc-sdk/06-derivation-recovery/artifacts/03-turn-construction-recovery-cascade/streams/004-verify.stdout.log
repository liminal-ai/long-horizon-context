{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/turn-cascade.test.ts'","aggregated_output":"     1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     2\timport type { SQLInputValue } from \"node:sqlite\";\n     3\timport {\n     4\t  countLiveItems,\n     5\t  createSdk,\n     6\t  queueDetail,\n     7\t  threads,\n     8\t  type DerivationProvider,\n     9\t  type Lhc,\n    10\t  type MessageEventInput,\n    11\t} from \"../src/index.js\";\n    12\timport { truncateForFallback } from \"../src/shared/tool-result-rendering.js\";\n    13\timport {\n    14\t  createProviderDouble,\n    15\t  openRaw,\n    16\t  readDerivedForms,\n    17\t  tempStore,\n    18\t  validEvent,\n    19\t  type TempStore,\n    20\t} from \"./fixtures/index.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tasync function newThread(): Promise<string> {\n    31\t  const created = await threads.newThread({\n    32\t    filePath: store.threadPath(),\n    33\t    registryPath: store.registryPath,\n    34\t  });\n    35\t  if (!created.ok) throw new Error(created.error.reason);\n    36\t  return created.value.filePath;\n    37\t}\n    38\t\n    39\tfunction sdkFor(provider: DerivationProvider): Lhc {\n    40\t  return createSdk({\n    41\t    provider,\n    42\t    mode: \"manual\",\n    43\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    44\t    lease: { durationMs: 200 },\n    45\t  });\n    46\t}\n    47\t\n    48\tasync function send(\n    49\t  sdk: Lhc,\n    50\t  filePath: string,\n    51\t  batch: readonly MessageEventInput[],\n    52\t): Promise<void> {\n    53\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    54\t  if (!result.ok) throw new Error(result.error.reason);\n    55\t}\n    56\t\n    57\tasync function drain(sdk: Lhc, filePath: string, opts?: { maxItems?: number }): Promise<void> {\n    58\t  const result = await sdk.work.drain({ filePath }, opts);\n    59\t  if (!result.ok) throw new Error(result.error.reason);\n    60\t}\n    61\t\n    62\tfunction formOf(filePath: string, subjectId: string, derivationType: string) {\n    63\t  return readDerivedForms(filePath).find(\n    64\t    (form) => form.subjectId === subjectId && form.derivationType === derivationType,\n    65\t  );\n    66\t}\n    67\t\n    68\tfunction execSql(filePath: string, sql: string, ...params: SQLInputValue[]): void {\n    69\t  const db = openRaw(filePath);\n    70\t  try {\n    71\t    db.prepare(sql).run(...params);\n    72\t  } finally {\n    73\t    db.close();\n    74\t  }\n    75\t}\n    76\t\n    77\tfunction deleteWorkItem(filePath: string, workItemId: string): void {\n    78\t  execSql(filePath, `DELETE FROM work_item WHERE work_item_id = ?`, workItemId);\n    79\t}\n    80\t\n    81\tdescribe(\"Story 3: turn construction recovery cascade\", () => {\n    82\t  it(\"uses ready derivations directly and writes no fallback log\", async () => {\n    83\t    const double = createProviderDouble();\n    84\t    const captured = double.captureInputs();\n    85\t    const sdk = sdkFor(double);\n    86\t    const filePath = await newThread();\n    87\t\n    88\t    await send(sdk, filePath, [\n    89\t      validEvent(\"user_prompt\", { payload: { text: \"ready prompt\" } }),\n    90\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n    91\t      validEvent(\"turn_end\"),\n    92\t    ]);\n    93\t    await drain(sdk, filePath);\n    94\t\n    95\t    const smoothed = formOf(filePath, \"m1\", \"smoothed_prompt\")?.content;\n    96\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n    97\t    const firstPart = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n    98\t      .parts?.[0];\n    99\t    expect(firstPart).toMatchObject({ text: smoothed, fallback: false });\n   100\t\n   101\t    const logs = await sdk.logging.query({ filePath }, { reason: \"not_ready\" });\n   102\t    expect(logs.ok).toBe(true);\n   103\t    if (!logs.ok) return;\n   104\t    expect(logs.value).toEqual([]);\n   105\t  });\n   106\t\n   107\t  it(\"falls pending derivations to deterministic floors when re-derivation does not complete\", async () => {\n   108\t    const double = createProviderDouble();\n   109\t    double.failKind(\"smoothed_prompt\", 1, { retryable: true, reason: \"recovery unavailable\" });\n   110\t    const captured = double.captureInputs();\n   111\t    const sdk = sdkFor(double);\n   112\t    const filePath = await newThread();\n   113\t\n   114\t    await send(sdk, filePath, [\n   115\t      validEvent(\"user_prompt\", { payload: { text: \"  pending    prompt because i asked  \" } }),\n   116\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   117\t      validEvent(\"turn_end\"),\n   118\t    ]);\n   119\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   120\t\n   121\t    await drain(sdk, filePath);\n   122\t\n   123\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   124\t    const parts = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n   125\t      .parts ?? [];\n   126\t    expect(parts[0]).toMatchObject({ text: \"pending prompt because I asked\", fallback: true });\n   127\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   128\t      state: \"ready\",\n   129\t      content: \"pending prompt because I asked\",\n   130\t    });\n   131\t\n   132\t    const logs = await sdk.logging.query({ filePath }, { derivationType: \"smoothed_prompt\" });\n   133\t    expect(logs.ok).toBe(true);\n   134\t    if (!logs.ok) return;\n   135\t    expect(logs.value.map((entry) => [entry.subjectId, entry.reason, entry.floorUsed])).toEqual([\n   136\t      [\"m1\", \"not_ready\", \"pending prompt because I asked\"],\n   137\t    ]);\n   138\t  });\n   139\t\n   140\t  it(\"falls failed derivations through the same floor path when re-derivation does not complete\", async () => {\n   141\t    const double = createProviderDouble();\n   142\t    double.failKind(\"smoothed_prompt\", 1, { retryable: true, reason: \"recovery unavailable\" });\n   143\t    const captured = double.captureInputs();\n   144\t    const sdk = sdkFor(double);\n   145\t    const filePath = await newThread();\n   146\t\n   147\t    await send(sdk, filePath, [\n   148\t      validEvent(\"user_prompt\", { payload: { text: \"  failed    prompt because i asked  \" } }),\n   149\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   150\t      validEvent(\"turn_end\"),\n   151\t    ]);\n   152\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   153\t    execSql(\n   154\t      filePath,\n   155\t      `UPDATE derivation SET state = 'failed', reason = 'terminal'\n   156\t       WHERE subject_id = ? AND derivation_type = 'smoothed_prompt'`,\n   157\t      \"m1\",\n   158\t    );\n   159\t\n   160\t    await drain(sdk, filePath);\n   161\t\n   162\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   163\t    const first = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n   164\t      .parts?.[0];\n   165\t    expect(first).toMatchObject({ text: \"failed prompt because I asked\", fallback: true });\n   166\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   167\t      state: \"ready\",\n   168\t      content: \"failed prompt because I asked\",\n   169\t    });\n   170\t  });\n   171\t\n   172\t  it(\"re-derives a failed component outside the completion write and persists plain ready\", async () => {\n   173\t    let probeAcquired = false;\n   174\t    let filePath = \"\";\n   175\t    const
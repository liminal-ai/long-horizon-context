{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/turn-cascade.test.ts'","aggregated_output":"     1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     2\timport type { SQLInputValue } from \"node:sqlite\";\n     3\timport {\n     4\t  countLiveItems,\n     5\t  createSdk,\n     6\t  queueDetail,\n     7\t  threads,\n     8\t  type DerivationProvider,\n     9\t  type Lhc,\n    10\t  type MessageEventInput,\n    11\t} from \"../src/index.js\";\n    12\timport { truncateForFallback } from \"../src/shared/tool-result-rendering.js\";\n    13\timport {\n    14\t  createProviderDouble,\n    15\t  openRaw,\n    16\t  readDerivedForms,\n    17\t  tempStore,\n    18\t  validEvent,\n    19\t  type TempStore,\n    20\t} from \"./fixtures/index.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tasync function newThread(): Promise<string> {\n    31\t  const created = await threads.newThread({\n    32\t    filePath: store.threadPath(),\n    33\t    registryPath: store.registryPath,\n    34\t  });\n    35\t  if (!created.ok) throw new Error(created.error.reason);\n    36\t  return created.value.filePath;\n    37\t}\n    38\t\n    39\tfunction sdkFor(provider: DerivationProvider): Lhc {\n    40\t  return createSdk({\n    41\t    provider,\n    42\t    mode: \"manual\",\n    43\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    44\t    lease: { durationMs: 200 },\n    45\t  });\n    46\t}\n    47\t\n    48\tasync function send(\n    49\t  sdk: Lhc,\n    50\t  filePath: string,\n    51\t  batch: readonly MessageEventInput[],\n    52\t): Promise<void> {\n    53\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    54\t  if (!result.ok) throw new Error(result.error.reason);\n    55\t}\n    56\t\n    57\tasync function drain(sdk: Lhc, filePath: string, opts?: { maxItems?: number }): Promise<void> {\n    58\t  const result = await sdk.work.drain({ filePath }, opts);\n    59\t  if (!result.ok) throw new Error(result.error.reason);\n    60\t}\n    61\t\n    62\tfunction formOf(filePath: string, subjectId: string, derivationType: string) {\n    63\t  return readDerivedForms(filePath).find(\n    64\t    (form) => form.subjectId === subjectId && form.derivationType === derivationType,\n    65\t  );\n    66\t}\n    67\t\n    68\tfunction execSql(filePath: string, sql: string, ...params: SQLInputValue[]): void {\n    69\t  const db = openRaw(filePath);\n    70\t  try {\n    71\t    db.prepare(sql).run(...params);\n    72\t  } finally {\n    73\t    db.close();\n    74\t  }\n    75\t}\n    76\t\n    77\tfunction deleteWorkItem(filePath: string, workItemId: string): void {\n    78\t  execSql(filePath, `DELETE FROM work_item WHERE work_item_id = ?`, workItemId);\n    79\t}\n    80\t\n    81\tdescribe(\"Story 3: turn construction recovery cascade\", () => {\n    82\t  it(\"uses ready derivations directly and writes no fallback log\", async () => {\n    83\t    const double = createProviderDouble();\n    84\t    const captured = double.captureInputs();\n    85\t    const sdk = sdkFor(double);\n    86\t    const filePath = await newThread();\n    87\t\n    88\t    await send(sdk, filePath, [\n    89\t      validEvent(\"user_prompt\", { payload: { text: \"ready prompt\" } }),\n    90\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n    91\t      validEvent(\"turn_end\"),\n    92\t    ]);\n    93\t    await drain(sdk, filePath);\n    94\t\n    95\t    const smoothed = formOf(filePath, \"m1\", \"smoothed_prompt\")?.content;\n    96\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n    97\t    const firstPart = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n    98\t      .parts?.[0];\n    99\t    expect(firstPart).toMatchObject({ text: smoothed, fallback: false });\n   100\t\n   101\t    const logs = await sdk.logging.query({ filePath }, { reason: \"not_ready\" });\n   102\t    expect(logs.ok).toBe(true);\n   103\t    if (!logs.ok) return;\n   104\t    expect(logs.value).toEqual([]);\n   105\t  });\n   106\t\n   107\t  it(\"falls pending derivations to deterministic floors when re-derivation does not complete\", async () => {\n   108\t    const double = createProviderDouble();\n   109\t    double.failKind(\"smoothed_prompt\", 1, { retryable: true, reason: \"recovery unavailable\" });\n   110\t    const captured = double.captureInputs();\n   111\t    const sdk = sdkFor(double);\n   112\t    const filePath = await newThread();\n   113\t\n   114\t    await send(sdk, filePath, [\n   115\t      validEvent(\"user_prompt\", { payload: { text: \"  pending    prompt because i asked  \" } }),\n   116\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   117\t      validEvent(\"turn_end\"),\n   118\t    ]);\n   119\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   120\t\n   121\t    await drain(sdk, filePath);\n   122\t\n   123\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   124\t    const parts = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n   125\t      .parts ?? [];\n   126\t    expect(parts[0]).toMatchObject({ text: \"pending prompt because I asked\", fallback: true });\n   127\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   128\t      state: \"ready\",\n   129\t      content: \"pending prompt because I asked\",\n   130\t    });\n   131\t\n   132\t    const logs = await sdk.logging.query({ filePath }, { derivationType: \"smoothed_prompt\" });\n   133\t    expect(logs.ok).toBe(true);\n   134\t    if (!logs.ok) return;\n   135\t    expect(logs.value.map((entry) => [entry.subjectId, entry.reason, entry.floorUsed])).toEqual([\n   136\t      [\"m1\", \"not_ready\", \"pending prompt because I asked\"],\n   137\t    ]);\n   138\t  });\n   139\t\n   140\t  it(\"falls back to original prompt source when the deterministic floor is unavailable\", async () => {\n   141\t    const double = createProviderDouble();\n   142\t    double.failKind(\"smoothed_prompt\", 1, { retryable: true, reason: \"recovery unavailable\" });\n   143\t    const captured = double.captureInputs();\n   144\t    const sdk = sdkFor(double);\n   145\t    const filePath = await newThread();\n   146\t    const original = \" \\t\\n  \";\n   147\t\n   148\t    await send(sdk, filePath, [\n   149\t      validEvent(\"user_prompt\", { payload: { text: original } }),\n   150\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   151\t      validEvent(\"turn_end\"),\n   152\t    ]);\n   153\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   154\t\n   155\t    await drain(sdk, filePath);\n   156\t\n   157\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   158\t    const first = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n   159\t      .parts?.[0];\n   160\t    expect(first).toMatchObject({ text: original, fallback: true });\n   161\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   162\t      state: \"ready\",\n   163\t      content: original,\n   164\t    });\n   165\t  });\n   166\t\n   167\t  it(\"falls failed derivations through the same floor path when re-derivation does not complete\", async () => {\n   168\t    const double = createProviderDouble();\n   169\t    double.failKind(\"smoothed_prompt\", 1, { retryable: true, reason: \"recovery unavailable\" });\n   170\t    const captured = double.captureInputs();\n   171\t    const sdk = sdkFor(double);\n   172\t    const filePath = await newThread();\n   173\t\n   174\t    await send(sdk, filePath, [\n   175\t      validEvent(\"user_prompt\", { payload: { text: \"  failed    prompt because i asked  \" } }),\n   176\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   177\t      validEvent(\"turn_end\"),\n   178\t    ]);\n   179\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   180\t    execSql(\n   181\t      filePath,\n   182\t      `UPDATE derivation SET state = 'failed', reason = 'terminal'\n   183\t       WHERE subject_id = ? AND derivation_type = 'smoothed_prompt'`,\n   184\t      \"m1\",\n   185\t    );\n   186\t\n   187\t    await drain(sdk, filePath);\n   188\t\n   189\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   190\t    const first = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n   191\t      .parts?.[0];\n   192\t    expect(first).toMatchObject({ text: \"failed prompt because I asked\", fallback: true });\n   193\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   194\t      state: \"ready\",\n   195\t      content: \"failed prompt because I asked\",\n   196\t    });\n   197\t  });\n   198\t\n   199\t  it(\"re-derives a failed component outside the completion write and persists plain ready\", async () => {\n   200\t    let probeAcquired = false;\n   201\t    let filePath = \"\";\n   202\t    const double = createProviderDouble();\n   203\t    const provider: DerivationProvider = {\n   204\t      smoothPrompt: async (input) => {\n   205\t        const probe = openRaw(filePath);\n   206\t        try {\n   207\t          probe.exec(\"BEGIN IMMEDIATE;\");\n   208\t          probeAcquired = true;\n   209\t          probe.exec(\"ROLLBACK;\");\n   210\t        } finally {\n   211\t          probe.close();\n   212\t        }\n   213\t        return { ok: true, text: `recovered:${input.text}` };\n   214\t      },\n   215\t      summarizeToolResult: (input) => double.summarizeToolResult(input),\n   216\t      composeTurnRendering: (input) => double.composeTurnRendering(input),\n   217\t      projectLowerBand: (input) => double.projectLowerBand(input),\n   218\t      summarizeChunkDetailed: (input) => double.summarizeChunkDetailed(input),\n   219\t      summarizeChunkBrief: (input) => double.summarizeChunkBrief(input),\n   220\t    };\n   221\t    const sdk = sdkFor(provider);\n   222\t    filePath = await newThread();\n   223\t\n   224\t    await send(sdk, filePath, [\n   225\t      validEvent(\"user_prompt\", { payload: { text: \"  recover    me  \" } }),\n   226\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   227\t      validEvent(\"turn_end\"),\n   228\t    ]);\n   229\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   230\t    execSql(\n   231\t      filePath,\n   232\t      `UPDATE derivation SET state = 'failed', reason = 'terminal'\n   233\t       WHERE subject_id = ? AND derivation_type = 'smoothed_prompt'`,\n   234\t      \"m1\",\n   235\t    );\n   236\t\n   237\t    await drain(sdk, filePath);\n   238\t\n   239\t    expect(probeAcquired).toBe(true);\n   240\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   241\t      state: \"ready\",\n   242\t      content: \"recovered:recover me\",\n   243\t    });\n   244\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.reason).toBeUndefined();\n   245\t    const logs = await sdk.logging.query({ filePath }, { derivationType: \"smoothed_prompt\" });\n   246\t    expect(logs.ok).toBe(true);\n   247\t    if (!logs.ok) return;\n   248\t    expect(logs.value).toEqual([]);\n   249\t  });\n   250\t\n   251\t  it(\"does not overwrite a ready row written before floor recovery persists\", async () => {\n   252\t    let filePath = \"\";\n   253\t    let workerCompleted = false;\n   254\t    const double = createProviderDouble();\n   255\t    const captured = double.captureInputs();\n   256\t    const provider: DerivationProvider = {\n   257\t      smoothPrompt: async () => {\n   258\t        execSql(\n   259\t          filePath,\n   260\t          `UPDATE derivation\n   261\t           SET state = 'ready', content = ?, reason = NULL, derived_at = ?\n   262\t           WHERE subject_id = ? AND derivation_type = 'smoothed_prompt'`,\n   263\t          \"real worker output\",\n   264\t          \"2026-01-01T00:00:00.000Z\",\n   265\t          \"m1\",\n   266\t        );\n   267\t        workerCompleted = true;\n   268\t        return { ok: false, retryable: true, reason: \"recovery unavailable\" };\n   269\t      },\n   270\t      summarizeToolResult: (input) => double.summarizeToolResult(input),\n   271\t      composeTurnRendering: (input) => double.composeTurnRendering(input),\n   272\t      projectLowerBand: (input) => double.projectLowerBand(input),\n   273\t      summarizeChunkDetailed: (input) => double.summarizeChunkDetailed(input),\n   274\t      summarizeChunkBrief: (input) => double.summarizeChunkBrief(input),\n   275\t    };\n   276\t    const sdk = sdkFor(provider);\n   277\t    filePath = await newThread();\n   278\t\n   279\t    await send(sdk, filePath, [\n   280\t      validEvent(\"user_prompt\", { payload: { text: \"  race    prompt because i asked  \" } }),\n   281\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   282\t      validEvent(\"turn_end\"),\n   283\t    ]);\n   284\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   285\t\n   286\t    await drain(sdk, filePath);\n   287\t\n   288\t    expect(workerCompleted).toBe(true);\n   289\t    const first = (\n   290\t      captured.find((entry) => entry.op === \"composeTurnRendering\")?.input as {\n   291\t        parts?: Array<{ text: string; fallback: boolean }>;\n   292\t      }\n   293\t    ).parts?.[0];\n   294\t    expect(first).toMatchObject({ text: \"race prompt because I asked\", fallback: true });\n   295\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   296\t      state: \"ready\",\n   297\t      content: \"real worker output\",\n   298\t    });\n   299\t  });\n   300\t\n   301\t  it(\"renders assistant text, thinking, and runtime notes verbatim in record order\", async () => {\n   302\t    const double = createProviderDouble();\n   303\t    const captured = double.captureInputs();\n   304\t    const sdk = sdkFor(double);\n   305\t    const filePath = await newThread();\n   306\t\n   307\t    await send(sdk, filePath, [\n   308\t      validEvent(\"user_prompt\", { payload: { text: \"order check\" } }),\n   309\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n   310\t      validEvent(\"assistant_thinking\", { payload: { text: \"thinking exactly\" } }),\n   311\t      validEvent(\"runtime_note\", { payload: { text: \"runtime changed exactly\" } }),\n   312\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n   313\t      validEvent(\"turn_end\"),\n   314\t    ]);\n   315\t\n   316\t    await drain(sdk, filePath);\n   317\t\n   318\t    const parts = (\n   319\t      captured.find((entry) => entry.op === \"composeTurnRendering\")?.input as {\n   320\t        parts?: Array<{ kind: string; text: string; fallback: boolean }>;\n   321\t      }\n   322\t    ).parts ?? [];\n   323\t    const smoothed = formOf(filePath, \"m1\", \"smoothed_prompt\")?.content;\n   324\t    expect(parts.map((part) => [part.kind, part.text, part.fallback])).toEqual([\n   325\t      [\"user_prompt\", smoothed, false],\n   326\t      [\"assistant_text\", \"first answer\", false],\n   327\t      [\"assistant_thinking\", \"thinking exactly\", false],\n   328\t      [\"runtime_note\", \"runtime changed exactly\", false],\n   329\t      [\"assistant_text\", \"second answer\", false],\n   330\t    ]);\n   331\t  });\n   332\t\n   333\t  it(\"uses and writes tool-result truncation floors, never raw full results\", async () => {\n   334\t    const double = createProviderDouble();\n   335\t    double.failKind(\"tool_result_summary\", 1, { retryable: true, reason: \"recovery unavailable\" });\n   336\t    const captured = double.captureInputs();\n   337\t    const sdk = sdkFor(double);\n   338\t    const filePath = await newThread();\n   339\t    const content = \"tool-output \".repeat(100);\n   340\t\n   341\t    await send(sdk, filePath, [\n   342\t      validEvent(\"user_prompt\", { payload: { text: \"summarize tool\" } }),\n   343\t      validEvent(\"tool_call\", {\n   344\t        payload: { toolCallId: \"call\", toolName: \"read_file\", arguments: { path: \"large.txt\" } },\n   345\t      }),\n   346\t      validEvent(\"tool_result\", { payload: { toolCallId: \"call\", content, isError: false } }),\n   347\t      validEvent(\"turn_end\"),\n   348\t    ]);\n   349\t    deleteWorkItem(filePath, \"w-m3-tool_result_summary-v1\");\n   350\t\n   351\t    await drain(sdk, filePath);\n   352\t\n   353\t    const floor = truncateForFallback(content);\n   354\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   355\t    const rendered = JSON.stringify(rendering?.input);\n   356\t    expect(rendered).toContain(floor);\n   357\t    expect(rendered).not.toContain(content);\n   358\t    expect(formOf(filePath, \"m3\", \"tool_result_summary\")).toMatchObject({\n   359\t      state: \"ready\",\n   360\t      content: floor,\n   361\t    });\n   362\t  });\n   363\t\n   364\t  it(\"constructs a turn with every component present when multiple derivations are not ready\", async () => {\n   365\t    const double = createProviderDouble();\n   366\t    double.failKind(\"smoothed_prompt\", 1, { retryable: true, reason: \"recovery unavailable\" });\n   367\t    double.failKind(\"tool_result_summary\", 1, {\n   368\t      retryable: true,\n   369\t      reason: \"recovery unavailable\",\n   370\t    });\n   371\t    const captured = double.captureInputs();\n   372\t    const sdk = sdkFor(double);\n   373\t    const filePath = await newThread();\n   374\t\n   375\t    await send(sdk, filePath, [\n   376\t      validEvent(\"user_prompt\", { payload: { text: \"  multi    fallback because i asked  \" } }),\n   377\t      validEvent(\"tool_call\", {\n   378\t        payload: { toolCallId: \"call\", toolName: \"read_file\", arguments: { path: \"multi.txt\" } },\n   379\t      }),\n   380\t      validEvent(\"tool_result\", {\n   381\t        payload: { toolCallId: \"call\", content: \"tool-output\", isError: false },\n   382\t      }),\n   383\t      validEvent(\"assistant_text\", { payload: { text: \"answer after tool\" } }),\n   384\t      validEvent(\"turn_end\"),\n   385\t    ]);\n   386\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   387\t    deleteWorkItem(filePath, \"w-m3-tool_result_summary-v1\");\n   388\t\n   389\t    await drain(sdk, filePath);\n   390\t\n   391\t    const parts = (\n   392\t      captured.find((entry) => entry.op === \"composeTurnRendering\")?.input as {\n   393\t        parts?: Array<{ kind: string; text: string; fallback: boolean }>;\n   394\t      }\n   395\t    ).parts ?? [];\n   396\t    expect(parts).toHaveLength(3);\n   397\t    expect(parts[0]).toMatchObject({\n   398\t      kind: \"user_prompt\",\n   399\t      text: \"multi fallback because I asked\",\n   400\t      fallback: true,\n   401\t    });\n   402\t    expect(parts[1]?.text).toContain(\"read_file({\\\"path\\\":\\\"multi.txt\\\"})\");\n   403\t    expect(parts[1]?.text).toContain(\"tool-output\");\n   404\t    expect(parts[1]).toMatchObject({ kind: \"tool_call\", fallback: true });\n   405\t    expect(parts[2]).toMatchObject({\n   406\t      kind: \"assistant_text\",\n   407\t      text: \"answer after tool\",\n   408\t      fallback: false,\n   409\t    });\n   410\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({\n   411\t      state: \"ready\",\n   412\t      content: \"multi fallback because I asked\",\n   413\t    });\n   414\t    expect(formOf(filePath, \"m3\", \"tool_result_summary\")).toMatchObject({\n   415\t      state: \"ready\",\n   416\t      content: \"tool-output\",\n   417\t    });\n   418\t  });\n   419\t\n   420\t  it(\"leaves derivation rows untouched when live work exists but still renders a floor\", async () => {\n   421\t    const double = createProviderDouble();\n   422\t    const captured = double.captureInputs();\n   423\t    const sdk = sdkFor(double);\n   424\t    const filePath = await newThread();\n   425\t\n   426\t    await send(sdk, filePath, [\n   427\t      validEvent(\"user_prompt\", { payload: { text: \"  live    work because i asked  \" } }),\n   428\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   429\t      validEvent(\"turn_end\"),\n   430\t    ]);\n   431\t    deleteWorkItem(filePath, \"w-m1-prompt_smoothing-v1\");\n   432\t    execSql(\n   433\t      filePath,\n   434\t      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n   435\t       VALUES (?, 'messages', 'prompt_smoothing', ?, 'queued', ?, ?)`,\n   436\t      \"w-m1-prompt_smoothing-v1-live\",\n   437\t      JSON.stringify({ messageId: \"m1\" }),\n   438\t      \"2026-01-01T00:00:00.000Z\",\n   439\t      JSON.stringify({\n   440\t        sourceVersion: 1,\n   441\t        derivations: [\n   442\t          { subjectKind: \"message\", subjectId: \"m1\", derivationType: \"smoothed_prompt\" },\n   443\t        ],\n   444\t      }),\n   445\t    );\n   446\t\n   447\t    await drain(sdk, filePath, { maxItems: 1 });\n   448\t\n   449\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   450\t    const firstPart = (rendering?.input as { parts?: Array<{ text: string; fallback: boolean }> })\n   451\t      .parts?.[0];\n   452\t    expect(firstPart).toMatchObject({ text: \"live work because I asked\", fallback: true });\n   453\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")).toMatchObject({ state: \"pending\" });\n   454\t\n   455\t    const db = openRaw(filePath);\n   456\t    try {\n   457\t      expect(countLiveItems(db)).toBe(1);\n   458\t      expect(queueDetail(db)[0]?.workItemId).toBe(\"w-m1-prompt_smoothing-v1-live\");\n   459\t    } finally {\n   460\t      db.close();\n   461\t    }\n   462\t  });\n   463\t});\n","exit_code":0,"status":"completed"}}

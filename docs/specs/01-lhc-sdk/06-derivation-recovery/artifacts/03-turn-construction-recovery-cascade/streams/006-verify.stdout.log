{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/internal/recovery.ts'","aggregated_output":"     1\timport type { DatabaseSync } from \"node:sqlite\";\n     2\timport type {\n     3\t  DerivationMetadata,\n     4\t  DerivationType,\n     5\t  SubjectKind,\n     6\t} from \"../../../shared/derivation.js\";\n     7\timport { hasLiveItem, type WorkKind, type WorkSourceRef } from \"../../../tech-utils/work-queue/index.js\";\n     8\t\n     9\tfunction workTargetFor(\n    10\t  subjectKind: SubjectKind,\n    11\t  subjectId: string,\n    12\t  derivationType: DerivationType,\n    13\t): { kind: WorkKind; sourceRef: WorkSourceRef } | undefined {\n    14\t  if (subjectKind === \"message\") {\n    15\t    if (derivationType === \"smoothed_prompt\") {\n    16\t      return { kind: \"prompt_smoothing\", sourceRef: { messageId: subjectId } };\n    17\t    }\n    18\t    if (derivationType === \"tool_result_summary\") {\n    19\t      return { kind: \"tool_result_summary\", sourceRef: { messageId: subjectId } };\n    20\t    }\n    21\t  }\n    22\t  if (subjectKind === \"turn\") {\n    23\t    if (derivationType === \"turn_rendering\" || derivationType === \"lower_band_projection\") {\n    24\t      return { kind: \"turn_derivation\", sourceRef: { turnId: subjectId } };\n    25\t    }\n    26\t  }\n    27\t  if (\n    28\t    subjectKind === \"chunk\" &&\n    29\t    (derivationType === \"chunk_summary_detailed\" || derivationType === \"chunk_summary_brief\")\n    30\t  ) {\n    31\t    return { kind: derivationType, sourceRef: { chunkId: subjectId } };\n    32\t  }\n    33\t  return undefined;\n    34\t}\n    35\t\n    36\texport function hasLiveRecoveryWork(\n    37\t  db: DatabaseSync,\n    38\t  r: {\n    39\t    subjectKind: SubjectKind;\n    40\t    subjectId: string;\n    41\t    derivationType: DerivationType;\n    42\t    sourceVersion: number;\n    43\t  },\n    44\t): boolean {\n    45\t  const target = workTargetFor(r.subjectKind, r.subjectId, r.derivationType);\n    46\t  return target !== undefined && hasLiveItem(db, target.kind, target.sourceRef, r.sourceVersion);\n    47\t}\n    48\t\n    49\texport function recoverDerivation(\n    50\t  db: DatabaseSync,\n    51\t  r: {\n    52\t    subjectKind: SubjectKind;\n    53\t    subjectId: string;\n    54\t    derivationType: DerivationType;\n    55\t    content: string;\n    56\t    metadata?: DerivationMetadata;\n    57\t    sourceVersion: number;\n    58\t    derivedAt: string;\n    59\t  },\n    60\t): { persisted: boolean } {\n    61\t  db.exec(\"BEGIN IMMEDIATE;\");\n    62\t  try {\n    63\t    if (hasLiveRecoveryWork(db, r)) {\n    64\t      db.exec(\"COMMIT;\");\n    65\t      return { persisted: false };\n    66\t    }\n    67\t    const changed = db\n    68\t      .prepare(\n    69\t        `UPDATE derivation\n    70\t         SET state = 'ready', content = ?, reason = NULL, metadata = ?,\n    71\t             gaps = NULL, derived_at = ?\n    72\t         WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ?\n    73\t           AND source_version = ?\n    74\t           AND state IN ('pending', 'failed')`,\n    75\t      )\n    76\t      .run(\n    77\t        r.content,\n    78\t        r.metadata === undefined ? null : JSON.stringify(r.metadata),\n    79\t        r.derivedAt,\n    80\t        r.subjectKind,\n    81\t        r.subjectId,\n    82\t        r.derivationType,\n    83\t        r.sourceVersion,\n    84\t      );\n    85\t    db.exec(\"COMMIT;\");\n    86\t    return { persisted: Number(changed.changes) > 0 };\n    87\t  } catch (cause) {\n    88\t    db.exec(\"ROLLBACK;\");\n    89\t    throw cause;\n    90\t  }\n    91\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/internal/compose.ts'","aggregated_output":"     1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n     2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n     3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n     4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n     5\t// clock in the signature: determinism is structural, not disciplined.\n     6\t//\n     7\t// Tool activity stays in message order and groups into runs (AC-3.4, Fix 2):\n     8\t// a maximal stretch of consecutive tool_call/tool_result messages folds into\n     9\t// ONE RenderingPart and ONE receipt — a run-level account naming the tools,\n    10\t// the call count, and the per-call mechanical outcomes, so a run containing a\n    11\t// state-changing call structurally cannot lose its outcome and mixed outcomes\n    12\t// stay explicit, never collapsed into a vague success. Prompts and assistant\n    13\t// text break a run; thinking and runtime notes do not (interior ones ride the\n    14\t// run account inline, edge ones stand alone) — a story-deviation decision.\n    15\t// Runs are never reordered to make accounts tidier; the outcome rides the\n    16\t// part, not the prose.\n    17\timport type {\n    18\t  DependencyGap,\n    19\t  DerivationMetadata,\n    20\t  DerivationState,\n    21\t  DerivationType,\n    22\t  RenderingPart,\n    23\t  RenderingPartKind,\n    24\t  ToolOutcome,\n    25\t  ToolRunReceipt,\n    26\t} from \"../../../shared/derivation.js\";\n    27\timport { truncateForFallback } from \"../../../shared/tool-result-rendering.js\";\n    28\timport { cleanPrompt } from \"../../messages/index.js\";\n    29\t\n    30\t// The member message as the composer sees it: kind plus projected blocks,\n    31\t// verbatim from the record (already deleted-filtered by the caller's read).\n    32\texport interface ComposeMessage {\n    33\t  messageId: string;\n    34\t  kind: RenderingPartKind;\n    35\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    36\t}\n    37\t\n    38\t// One message-owned form row as composition input; keyed by the caller as\n    39\t// `${messageId}/${form}`.\n    40\texport interface ComposeFormRow {\n    41\t  state: DerivationState;\n    42\t  content?: string;\n    43\t  metadata?: DerivationMetadata;\n    44\t  reason?: string;\n    45\t  sourceVersion: number;\n    46\t}\n    47\t\n    48\texport function composeFormKey(messageId: string, form: DerivationType): string {\n    49\t  return `${messageId}/${form}`;\n    50\t}\n    51\t\n    52\texport interface CompositionInput {\n    53\t  parts: RenderingPart[];\n    54\t  gaps: DependencyGap[];\n    55\t  recoveries: RecoveryReceipt[];\n    56\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n    57\t  // account + outcome, in message order — pure restatement of the\n    58\t  // composition input, stamped on the rendering so chunk summaries read\n    59\t  // receipts without re-deriving anything.\n    60\t  receipts: ToolRunReceipt[];\n    61\t}\n    62\t\n    63\texport interface RecoveryReceipt {\n    64\t  subjectKind: \"message\";\n    65\t  subjectId: string;\n    66\t  derivationType: DerivationType;\n    67\t  content: string;\n    68\t  sourceVersion: number;\n    69\t  reason: \"not_ready\" | \"failed_floor\";\n    70\t  floorUsed: string;\n    71\t}\n    72\t\n    73\tfunction textOf(message: ComposeMessage): string {\n    74\t  const text = message.blocks[0]?.content[\"text\"];\n    75\t  return typeof text === \"string\" ? text : \"\";\n    76\t}\n    77\t\n    78\tfunction promptFallbackText(message: ComposeMessage): string {\n    79\t  const original = textOf(message);\n    80\t  const floor = cleanPrompt(original);\n    81\t  return floor.length === 0 && original.length > 0 ? original : floor;\n    82\t}\n    83\t\n    84\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n    85\t// composition): a tool call's outcome comes from its paired result among the\n    86\t// turn's messages — present and clean, present and isError, or absent.\n    87\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n    88\t  const byCallId = new Map<string, boolean>();\n    89\t  for (const message of messages) {\n    90\t    if (message.kind !== \"tool_result\") continue;\n    91\t    const block = message.blocks[0]?.content ?? {};\n    92\t    const callId = block[\"toolCallId\"];\n    93\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n    94\t  }\n    95\t  return byCallId;\n    96\t}\n    97\t\n    98\tfunction outcomeFromRecord(\n    99\t  resultByCallId: Map<string, boolean>,\n   100\t  callId: unknown,\n   101\t): ToolOutcome {\n   102\t  if (typeof callId !== \"string\") return \"unknown\";\n   103\t  const isError = resultByCallId.get(callId);\n   104\t  if (isError === undefined) return \"unknown\";\n   105\t  return isError ? \"failed\" : \"succeeded\";\n   106\t}\n   107\t\n   108\tinterface PartPlan {\n   109\t  form?: DerivationType; // the message-level form this kind composes from, if any\n   110\t  fallbackText: (message: ComposeMessage) => string;\n   111\t}\n   112\t\n   113\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n   114\t// call → recorded args; result → deterministic truncation; text/thinking/note → raw, no form\n   115\t// to fall back from and therefore never a gap.\n   116\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n   117\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: promptFallbackText },\n   118\t  assistant_text: { fallbackText: textOf },\n   119\t  assistant_thinking: { fallbackText: textOf },\n   120\t  runtime_note: { fallbackText: textOf },\n   121\t  tool_call: {\n   122\t    fallbackText: (message) => {\n   123\t      const block = message.blocks[0]?.content ?? {};\n   124\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n   125\t      return `${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`;\n   126\t    },\n   127\t  },\n   128\t  tool_result: {\n   129\t    form: \"tool_result_summary\",\n   130\t    fallbackText: (message) => {\n   131\t      const block = message.blocks[0]?.content ?? {};\n   132\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n   133\t    },\n   134\t  },\n   135\t};\n   136\t\n   137\t// One per-message atom before grouping: its composed part plus the structural\n   138\t// facts the run-grouping reads. Tool atoms fold into runs; prompts and\n   139\t// assistant text break runs; thinking and runtime notes are transparent —\n   140\t// interior ones fold into the surrounding run's account, edge ones stand alone.\n   141\tinterface ComposeAtom {\n   142\t  part: RenderingPart;\n   143\t  isTool: boolean;\n   144\t  isBreak: boolean; // user_prompt | assistant_text — ends a run\n   145\t  toolName?: string; // tool_call only\n   146\t  toolCallId?: string; // tool_call | tool_result\n   147\t}\n   148\t\n   149\tconst RUN_BREAK_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"user_prompt\", \"assistant_text\"]);\n   150\tconst TOOL_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"tool_call\", \"tool_result\"]);\n   151\t\n   152\t// One message → its composed part (ready form verbatim, else raw/truncated\n   153\t// fallback) plus a gap when a derivable form was not ready. Gaps stay\n   154\t// per-message — precise to the source record — regardless of run grouping\n   155\t// (AC-3.2/3.3): the caller lands them on the rendering and they hold until an\n   156\t// explicit rebuild recomposes from current states.\n   157\tfunction buildAtom(\n   158\t  message: ComposeMessage,\n   159\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   160\t  resultByCallId: Map<string, boolean>,\n   161\t): { atom: ComposeAtom; gap?: DependencyGap; recovery?: RecoveryReceipt } {\n   162\t  const plan = PART_PLANS[message.kind];\n   163\t  const form =\n   164\t    plan.form === undefined\n   165\t      ? undefined\n   166\t      : forms.get(composeFormKey(message.messageId, plan.form));\n   167\t  const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n   168\t  const block = message.blocks[0]?.content ?? {};\n   169\t  const part: RenderingPart = {\n   170\t    messageId: message.messageId,\n   171\t    kind: message.kind,\n   172\t    text: ready ? (form.content as string) : plan.fallbackText(message),\n   173\t    fallback: plan.form !== undefined && !ready,\n   174\t  };\n   175\t  if (message.kind === \"tool_call\") {\n   176\t    part.outcome =\n   177\t      ready && form.metadata?.outcome !== undefined\n   178\t        ? form.metadata.outcome\n   179\t        : outcomeFromRecord(resultByCallId, block[\"toolCallId\"]);\n   180\t  } else if (message.kind === \"tool_result\") {\n   181\t    part.outcome =\n   182\t      ready && form.metadata?.outcome !== undefined\n   183\t        ? form.metadata.outcome\n   184\t        : block[\"isError\"] === true\n   185\t          ? \"failed\"\n   186\t          : \"succeeded\";\n   187\t  }\n   188\t  const atom: ComposeAtom = {\n   189\t    part,\n   190\t    isTool: TOOL_KINDS.has(message.kind),\n   191\t    isBreak: RUN_BREAK_KINDS.has(message.kind),\n   192\t  };\n   193\t  if (message.kind === \"tool_call\" && typeof block[\"toolName\"] === \"string\") {\n   194\t    atom.toolName = block[\"toolName\"];\n   195\t  }\n   196\t  if (atom.isTool && typeof block[\"toolCallId\"] === \"string\") {\n   197\t    atom.toolCallId = block[\"toolCallId\"];\n   198\t  }\n   199\t  const gap: DependencyGap | undefined =\n   200\t    part.fallback && plan.form !== undefined\n   201\t      ? { subjectKind: \"message\", subjectId: message.messageId, derivationType: plan.form }\n   202\t      : undefined;\n   203\t  const recovery: RecoveryReceipt | undefined =\n   204\t    part.fallback && plan.form !== undefined && form !== undefined\n   205\t      ? {\n   206\t          subjectKind: \"message\",\n   207\t          subjectId: message.messageId,\n   208\t          derivationType: plan.form,\n   209\t          content: part.text,\n   210\t          sourceVersion: form.sourceVersion,\n   211\t          reason: form.state === \"failed\" ? \"failed_floor\" : \"not_ready\",\n   212\t          floorUsed: part.text,\n   213\t        }\n   214\t      : undefined;\n   215\t  return { atom, ...(gap === undefined ? {} : { gap }), ...(recovery === undefined ? {} : { recovery }) };\n   216\t}\n   217\t\n   218\tconst RUN_OUTCOME_ORDER: readonly ToolOutcome[] = [\"succeeded\", \"failed\", \"unknown\"];\n   219\t\n   220\t// The run's per-invocation outcome tally: each call counted once, plus any\n   221\t// result whose paired call sits outside this run (a cross-turn pair). Mixed\n   222\t// outcomes stay explicit; the run-level outcome is failed if any failed, else\n   223\t// unknown if any unknown, else succeeded.\n   224\tfunction tallyRun(members: readonly ComposeAtom[]): {\n   225\t  counts: Record<ToolOutcome, number>;\n   226\t  outcome: ToolOutcome;\n   227\t  callCount: number;\n   228\t  toolNames: string[];\n   229\t} {\n   230\t  const calls = members.filter((m) => m.part.kind === \"tool_call\");\n   231\t  const callIds = new Set(\n   232\t    calls.map((m) => m.toolCallId).filter((id): id is string => id !== undefined),\n   233\t  );\n   234\t  const orphanResults = members.filter(\n   235\t    (m) =>\n   236\t      m.part.kind === \"tool_result\" &&\n   237\t      (m.toolCallId === undefined || !callIds.has(m.toolCallId)),\n   238\t  );\n   239\t  const counts: Record<ToolOutcome, number> = { succeeded: 0, failed: 0, unknown: 0 };\n   240\t  for (const m of [...calls, ...orphanResults]) counts[m.part.outcome ?? \"unknown\"] += 1;\n   241\t  const outcome: ToolOutcome =\n   242\t    counts.failed > 0 ? \"failed\" : counts.unknown > 0 ? \"unknown\" : \"succeeded\";\n   243\t  const toolNames: string[] = [];\n   244\t  for (const call of calls) {\n   245\t    if (call.toolName !== undefined && !toolNames.includes(call.toolName)) {\n   246\t      toolNames.push(call.toolName);\n   247\t    }\n   248\t  }\n   249\t  return { counts, outcome, callCount: calls.length, toolNames };\n   250\t}\n   251\t\n   252\tfunction runTallyText(counts: Record<ToolOutcome, number>): string {\n   253\t  const segs = RUN_OUTCOME_ORDER.filter((o) => counts[o] > 0).map((o) => `${counts[o]} ${o}`);\n   254\t  return segs.length > 0 ? segs.join(\", \") : \"no outcomes\";\n   255\t}\n   256\t\n   257\t// One RenderingPart and one ToolRunReceipt for a maximal tool run (AC-3.4): a\n   258\t// run-level header (tools, call count, outcome tally) over the members'\n   259\t// composed accounts in record order — each tool member stating its own\n   260\t// outcome so a state-changing call cannot lose it, interior thinking/notes\n   261\t// riding inline. The receipt restates the same account + run outcome for the\n   262\t// chunk summaries (AC-3.8).\n   263\tfunction composeRun(members: readonly ComposeAtom[]): {\n   264\t  part: RenderingPart;\n   265\t  receipt: ToolRunReceipt;\n   266\t} {\n   267\t  const { counts, outcome, callCount, toolNames } = tallyRun(members);\n   268\t  const tools = toolNames.length > 0 ? toolNames.join(\", \") : \"tools\";\n   269\t  const header = `tool run · ${tools} · ${callCount} call${callCount === 1 ? \"\" : \"s\"} · ${runTallyText(counts)}`;\n   270\t  const detail = members\n   271\t    .map((m) => (m.isTool ? `${m.part.text} ⇒ ${m.part.outcome ?? \"unknown\"}` : m.part.text))\n   272\t    .join(\"\\n\");\n   273\t  const text = `[${header}]\\n${detail}`;\n   274\t  const lead = members[0];\n   275\t  if (lead === undefined) throw new Error(\"composeRun: a tool run has no members\");\n   276\t  return {\n   277\t    part: {\n   278\t      messageId: lead.part.messageId,\n   279\t      kind: lead.part.kind,\n   280\t      text,\n   281\t      fallback: members.some((m) => m.isTool && m.part.fallback),\n   282\t      outcome,\n   283\t    },\n   284\t    receipt: {\n   285\t      messageId: lead.part.messageId,\n   286\t      activity: lead.part.kind === \"tool_result\" ? \"tool_result\" : \"tool_call\",\n   287\t      account: text,\n   288\t      outcome,\n   289\t    },\n   290\t  };\n   291\t}\n   292\t\n   293\t// Compose the ordered RenderingParts and tool-run receipts. Per-message atoms\n   294\t// build first (forms verbatim or fallbacks, per-message gaps); then maximal\n   295\t// runs of consecutive tool activity fold into one run part + one receipt each\n   296\t// (AC-3.4), with prompts/assistant text breaking runs and thinking/runtime\n   297\t// notes transparent to them.\n   298\texport function composeRenderingInput(\n   299\t  messages: readonly ComposeMessage[],\n   300\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   301\t): CompositionInput {\n   302\t  const resultByCallId = recordOutcomes(messages);\n   303\t  const atoms: ComposeAtom[] = [];\n   304\t  const gaps: DependencyGap[] = [];\n   305\t  const recoveries: RecoveryReceipt[] = [];\n   306\t  for (const message of messages) {\n   307\t    const built = buildAtom(message, forms, resultByCallId);\n   308\t    atoms.push(built.atom);\n   309\t    if (built.gap !== undefined) gaps.push(built.gap);\n   310\t    if (built.recovery !== undefined) recoveries.push(built.recovery);\n   311\t  }\n   312\t\n   313\t  const parts: RenderingPart[] = [];\n   314\t  const receipts: ToolRunReceipt[] = [];\n   315\t  let i = 0;\n   316\t  while (i < atoms.length) {\n   317\t    const atom = atoms[i];\n   318\t    if (atom === undefined) break; // i < length keeps this unreachable\n   319\t    if (!atom.isTool) {\n   320\t      parts.push(atom.part); // prompt, assistant text, or an edge thinking/note\n   321\t      i += 1;\n   322\t      continue;\n   323\t    }\n   324\t    // A maximal run starting at this tool atom: extend over following tool\n   325\t    // atoms and interior transparent atoms (thinking/notes), stopping at the\n   326\t    // next break (prompt/assistant text) or the turn's end. Transparent atoms\n   327\t    // trailing the last tool atom stand alone, not folded into the run.\n   328\t    let j = i;\n   329\t    let lastToolIdx = i;\n   330\t    for (let next = atoms[j + 1]; next !== undefined && !next.isBreak; next = atoms[j + 1]) {\n   331\t      j += 1;\n   332\t      if (next.isTool) lastToolIdx = j;\n   333\t    }\n   334\t    const run = composeRun(atoms.slice(i, lastToolIdx + 1));\n   335\t    parts.push(run.part);\n   336\t    receipts.push(run.receipt);\n   337\t    for (let k = lastToolIdx + 1; k <= j; k += 1) {\n   338\t      const trailing = atoms[k];\n   339\t      if (trailing !== undefined) parts.push(trailing.part);\n   340\t    }\n   341\t    i = j + 1;\n   342\t  }\n   343\t\n   344\t  return { parts, gaps, receipts, recoveries };\n   345\t}\n","exit_code":0,"status":"completed"}}

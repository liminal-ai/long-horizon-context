packages/lhc/src/domains/turns/internal/compose.ts\"],\"requirementIds\":[\"AC-3.2\",\"TC-3.2c\",\"AC-3.4\",\"TC-3.4a\",\"AC-3.5\",\"TC-3.5a\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"openFindings\":[{\"id\":\"SV-03-001\",\"severity\":\"major\",\"title\":\"Recovery write-back can clobber a worker's ready result\",\"evidence\":\"TC-3.8d requires a live worker to win after floor rendering. In packages/lhc/src/domains/turns/internal/recovery.ts:67-83, recoverDerivation updates any row matching subject/type/source_version after the live-work check; it does not guard against the row already being ready. A focused probe seeded a ready row with content \\\"real result\\\", called recoverDerivation with \\\"floor result\\\", and failed with: \\\"expected ready worker content to survive, got floor result\\\". This models the race where a claimed worker completes and deletes its work_item just before recovery opens its transaction. The Story 3 test at packages/lhc/test/turn-cascade.test.ts:255-293 only proves a queued live item remains untouched; it never completes the worker and asserts the real ready result survives.\",\"affectedFiles\":[\"packages/lhc/src/domains/turns/internal/recovery.ts\",\"packages/lhc/test/turn-cascade.test.ts\"],\"requirementIds\":[\"AC-3.8\",\"TC-3.8d\",\"DD-4\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true},{\"id\":\"SV-03-002\",\"severity\":\"major\",\"title\":\"Required cascade TC scenarios are not covered in story tests\",\"evidence\":\"The story/test-plan map TC-3.2c, TC-3.4a, and TC-3.5a to packages/lhc/test/turn-cascade.test.ts. That file currently has six tests at lines 82, 107, 140, 172, 224, and 255, covering ready use, pending floor, failed floor, re-derive, tool truncation, and queued live-work deferral. rg found no test evidence for TC-3.2c, TC-3.4a, TC-3.5a, floor-unavailable/original fallback, runtime-change placement during turn construction, or multiple not-ready derivations producing a no-hole turn.\",\"affectedFiles\":[\"packages/lhc/test/turn-cascade.test.ts\",\"packages/lhc/src/domains/turns/internal/compose.ts\"],\"requirementIds\":[\"AC-3.2\",\"TC-3.2c\",\"AC-3.4\",\"TC-3.4a\",\"AC-3.5\",\"TC-3.5a\"],\"recommendedFixScope\":\"same-session-implementor\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"AC-3.1 / TC-3.1a\",\"AC-3.2 / TC-3.2a\",\"AC-3.2 / TC-3.2b\",\"AC-3.3 / TC-3.3a\",\"AC-3.6 / TC-3.6a\",\"AC-3.6 / TC-3.6b\",\"AC-3.7 / TC-3.7a\",\"AC-3.8 / TC-3.8a\",\"AC-3.8 / TC-3.8b\",\"AC-3.8 / TC-3.8c\",\"Story gate passed\",\"Epic gate passed\"],\"unverified\":[\"AC-3.2 / TC-3.2c\",\"AC-3.4 / TC-3.4a\",\"AC-3.5 / TC-3.5a\",\"AC-3.8 / TC-3.8d\"]},\"gatesRun\":[{\"command\":\"cd packages/lhc && pnpm exec vitest run test/turn-cascade.test.ts\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify-all\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm exec tsx -e \\\"<recoverDerivation ready-row overwrite probe>\\\"\",\"result\":\"fail\"}],\"productionPathFindings\":[\"SV-03-001: production recoverDerivation can overwrite a ready derivation after the live work item has completed and been deleted.\",\"No fake adapter, shim, placeholder, or production mock path was found in the Story 3 turn construction path; provider doubles are confined to tests.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"same-session-implementor\",\"openQuestions\":[],\"additionalObservations\":[\"Configured gates passed with 45 test files passing and 9 real-inference tests skipped because LHC_OPENROUTER_KEY is unset; the skipped real-inference tests were not used as Story 3 evidence.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/004-verify.jso
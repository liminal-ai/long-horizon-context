{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/smoothing.ts | sed -n '1,90p'\"","aggregated_output":"     1\t// Deterministic prompt floor for smoothing recovery. Pure by construction:\n     2\t// no DB, no clock, no provider.\n     3\tfunction cleanProse(text: string): string {\n     4\t  return text\n     5\t    .replace(/\\r\\n?/g, \"\\n\")\n     6\t    .replace(/[ \\t\\f\\v]+/g, \" \")\n     7\t    .replace(/ *\\n */g, \"\\n\")\n     8\t    .replace(/\\n{3,}/g, \"\\n\\n\")\n     9\t    .trim()\n    10\t    .replace(/\\bi\\b/g, \"I\");\n    11\t}\n    12\t\n    13\tfunction readLine(text: string, start: number): { raw: string; body: string; next: number } {\n    14\t  let end = start;\n    15\t  while (end < text.length && text[end] !== \"\\n\" && text[end] !== \"\\r\") end += 1;\n    16\t  let next = end;\n    17\t  if (end < text.length) {\n    18\t    if (text[end] === \"\\r\" && text[end + 1] === \"\\n\") next = end + 2;\n    19\t    else next = end + 1;\n    20\t  }\n    21\t  return { raw: text.slice(start, next), body: text.slice(start, end), next };\n    22\t}\n    23\t\n    24\tfunction fenceMarker(body: string): \"`\" | \"~\" | null {\n    25\t  const trimmed = body.trimStart();\n    26\t  if (trimmed.startsWith(\"```\")) return \"`\";\n    27\t  if (trimmed.startsWith(\"~~~\")) return \"~\";\n    28\t  return null;\n    29\t}\n    30\t\n    31\texport function cleanPrompt(text: string): string {\n    32\t  const parts: string[] = [];\n    33\t  let proseStart = 0;\n    34\t  let cursor = 0;\n    35\t  while (cursor < text.length) {\n    36\t    const line = readLine(text, cursor);\n    37\t    const marker = fenceMarker(line.body);\n    38\t    if (marker === null) {\n    39\t      cursor = line.next;\n    40\t      continue;\n    41\t    }\n    42\t\n    43\t    const prose = cleanProse(text.slice(proseStart, cursor));\n    44\t    if (prose !== \"\") parts.push(`${prose}\\n`);\n    45\t\n    46\t    let fenceEnd = line.next;\n    47\t    while (fenceEnd < text.length) {\n    48\t      const fenceLine = readLine(text, fenceEnd);\n    49\t      fenceEnd = fenceLine.next;\n    50\t      if (fenceMarker(fenceLine.body) === marker) break;\n    51\t    }\n    52\t    parts.push(text.slice(cursor, fenceEnd));\n    53\t    cursor = fenceEnd;\n    54\t    proseStart = fenceEnd;\n    55\t  }\n    56\t  const tail = cleanProse(text.slice(proseStart));\n    57\t  if (tail !== \"\") parts.push(tail);\n    58\t  return parts.join(\"\");\n    59\t}\n","exit_code":0,"status":"completed"}}

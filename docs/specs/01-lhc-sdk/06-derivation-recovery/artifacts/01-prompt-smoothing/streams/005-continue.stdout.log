{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' packages/lhc/src/domains/messages/internal/smoothing.ts\"","aggregated_output":"// Deterministic prompt floor for smoothing recovery. Pure by construction:\n// no DB, no clock, no provider.\nexport function cleanPrompt(text: string): string {\n  return text\n    .replace(/\\r\\n?/g, \"\\n\")\n    .replace(/[ \\t\\f\\v]+/g, \" \")\n    .replace(/ *\\n */g, \"\\n\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim()\n    .replace(/\\bi\\b/g, \"I\");\n}\n","exit_code":0,"status":"completed"}}

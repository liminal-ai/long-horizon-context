es/view-thread.ts:272:  const double = createProviderDouble();\npackages/lhc/test/fixtures/view-thread.ts:409:  const double = createProviderDouble();\npackages/lhc/src/providers/deterministic.ts:47:export function deterministicText(\npackages/lhc/src/providers/deterministic.ts:56:  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n","exit_code":0,"status":"completed"}}

counts as\npackages/lhc/test/epic-fix-02.test.ts:    // unsettled), so awaiting it awaits the retry.\npackages/lhc/test/epic-fix-02.test.ts:    // The form derived on the second attempt — the retry actually ran.\npackages/lhc/test/epic-fix-02.test.ts:  it(\"does not retry before eligible_at: the durable gate holds, no retry in the window\", async () => {\npackages/lhc/test/epic-fix-02.test.ts:    double.failNext(1, { retryable: true });\npackages/lhc/test/epic-fix-02.test.ts:      retry: { budget: 3, backoffBaseMs: 60000, backoffCapMs: 60000 },\npackages/lhc/test/epic-fix-02.test.ts:    // Exactly one attempt — the retry has NOT run before eligible_at, the form\npackages/lhc/test/epic-fix-02.test.ts:    // retry.\npackages/lhc/test/view-boundary.test.ts:    // First tool_result_summary execution fails non-retryably (r1's — queue\npackages/lhc/test/view-boundary.test.ts:      retryable: false,\npackages/lhc/test/view-pull.test.ts:    // other forms drained ready — nothing pending, retrying, or blocked here\npackages/lhc/test/view-pull.test.ts:    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\npackages/lhc/src/inference/adapter.ts:// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\npackages/lhc/src/inference/adapter.ts:  const { retryable } = FAILURE_CLASSIFICATION[kind];\npackages/lhc/src/inference/adapter.ts:    retryable,\npackages/lhc/src/inference/adapter.ts:    reason: retryable ? `provider_failure: ${detail}` : detail,\npackages/lhc/src/inference/adapter.ts:    // derivation (AC-2.4): a classified retryable failure, never a ready\npackages/lhc/src/inference/classify.ts:// vocabulary onto Epic 02's retryable-or-not. The queue machinery consumes\npackages/lhc/src/inference/classify.ts:// `retryable` exactly as it always has — no queue changes, no new states.\npackages/lhc/src/inference/classify.ts:export const FAILURE_CLASSIFICATION: Record<ModelCallFailureKind, { retryable: boolean }> = {
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/compose.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n     2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n     3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n     4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n     5\t// clock in the signature: determinism is structural, not disciplined.\n     6\t//\n     7\t// Tool activity stays in message order and groups into runs (AC-3.4, Fix 2):\n     8\t// a maximal stretch of consecutive tool_call/tool_result messages folds into\n     9\t// ONE RenderingPart and ONE receipt — a run-level account naming the tools,\n    10\t// the call count, and the per-call mechanical outcomes, so a run containing a\n    11\t// state-changing call structurally cannot lose its outcome and mixed outcomes\n    12\t// stay explicit, never collapsed into a vague success. Prompts and assistant\n    13\t// text break a run; thinking and runtime notes do not (interior ones ride the\n    14\t// run account inline, edge ones stand alone) — a story-deviation decision.\n    15\t// Runs are never reordered to make accounts tidier; the outcome rides the\n    16\t// part, not the prose.\n    17\timport type {\n    18\t  DependencyGap,\n    19\t  DerivationMetadata,\n    20\t  DerivationState,\n    21\t  DerivationType,\n    22\t  RenderingPart,\n    23\t  RenderingPartKind,\n    24\t  ToolOutcome,\n    25\t  ToolRunReceipt,\n    26\t} from \"../../../shared/derivation.js\";\n    27\timport { truncateForFallback } from \"../../../shared/tool-result-rendering.js\";\n    28\timport { cleanPrompt } from \"../../messages/index.js\";\n    29\t\n    30\t// The member message as the composer sees it: kind plus projected blocks,\n    31\t// verbatim from the record (already deleted-filtered by the caller's read).\n    32\texport interface ComposeMessage {\n    33\t  messageId: string;\n    34\t  kind: RenderingPartKind;\n    35\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    36\t}\n    37\t\n    38\t// One message-owned form row as composition input; keyed by the caller as\n    39\t// `${messageId}/${form}`.\n    40\texport interface ComposeFormRow {\n    41\t  state: DerivationState;\n    42\t  content?: string;\n    43\t  metadata?: DerivationMetadata;\n    44\t  reason?: string;\n    45\t  sourceVersion: number;\n    46\t}\n    47\t\n    48\texport function composeFormKey(messageId: string, form: DerivationType): string {\n    49\t  return `${messageId}/${form}`;\n    50\t}\n    51\t\n    52\texport interface CompositionInput {\n    53\t  parts: RenderingPart[];\n    54\t  gaps: DependencyGap[];\n    55\t  recoveries: RecoveryReceipt[];\n    56\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n    57\t  // account + outcome, in message order — pure restatement of the\n    58\t  // composition input, stamped on the rendering so chunk summaries read\n    59\t  // receipts without re-deriving anything.\n    60\t  receipts: ToolRunReceipt[];\n    61\t}\n    62\t\n    63\texport interface RecoveryReceipt {\n    64\t  subjectKind: \"message\";\n    65\t  subjectId: string;\n    66\t  derivationType: DerivationType;\n    67\t  content: string;\n    68\t  sourceVersion: number;\n    69\t  reason: \"not_ready\" | \"failed_floor\";\n    70\t  floorUsed: string;\n    71\t}\n    72\t\n    73\tfunction textOf(message: ComposeMessage): string {\n    74\t  const text = message.blocks[0]?.content[\"text\"];\n    75\t  return typeof text === \"string\" ? text : \"\";\n    76\t}\n    77\t\n    78\tfunction modelChangeText(message: ComposeMessage): string {\n    79\t  const block = message.blocks[0]?.content ?? {};\n    80\t  const previous = block[\"previousModel\"];\n    81\t  const next = block[\"newModel\"];\n    82\t  return typeof previous === \"string\" && typeof next === \"string\"\n    83\t    ? `model_change ${previous} -> ${next}`\n    84\t    : \"model_change\";\n    85\t}\n    86\t\n    87\tfunction thinkingLevelChangeText(message: ComposeMessage): string {\n    88\t  const block = message.blocks[0]?.content ?? {};\n    89\t  const previous = block[\"previousLevel\"];\n    90\t  const next = block[\"newLevel\"];\n    91\t  return typeof previous === \"string\" && typeof next === \"string\"\n    92\t    ? `thinking_level_change ${previous} -> ${next}`\n    93\t    : \"thinking_level_change\";\n    94\t}\n    95\t\n    96\tfunction promptFallbackText(message: ComposeMessage): string {\n    97\t  const original = textOf(message);\n    98\t  const floor = cleanPrompt(original);\n    99\t  return floor.length === 0 && original.length > 0 ? original : floor;\n   100\t}\n   101\t\n   102\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n   103\t// composition): a tool call's outcome comes from its paired result among the\n   104\t// turn's messages — present and clean, present and isError, or absent.\n   105\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n   106\t  const byCallId = new Map<string, boolean>();\n   107\t  for (const message of messages) {\n   108\t    if (message.kind !== \"tool_result\") continue;\n   109\t    const block = message.blocks[0]?.content ?? {};\n   110\t    const callId = block[\"toolCallId\"];\n   111\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n   112\t  }\n   113\t  return byCallId;\n   114\t}\n   115\t\n   116\tfunction outcomeFromRecord(\n   117\t  resultByCallId: Map<string, boolean>,\n   118\t  callId: unknown,\n   119\t): ToolOutcome {\n   120\t  if (typeof callId !== \"string\") return \"unknown\";\n   121\t  const isError = resultByCallId.get(callId);\n   122\t  if (isError === undefined) return \"unknown\";\n   123\t  return isError ? \"failed\" : \"succeeded\";\n   124\t}\n   125\t\n   126\tinterface PartPlan {\n   127\t  form?: DerivationType; // the message-level form this kind composes from, if any\n   128\t  fallbackText: (message: ComposeMessage) => string;\n   129\t}\n   130\t\n   131\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n   132\t// call → recorded args; result → deterministic truncation; text/thinking/note → raw, no form\n   133\t// to fall back from and therefore never a gap.\n   134\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n   135\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: promptFallbackText },\n   136\t  assistant_text: { fallbackText: textOf },\n   137\t  assistant_thinking: { fallbackText: textOf },\n   138\t  runtime_note: { fallbackText: textOf },\n   139\t  model_change: { fallbackText: modelChangeText },\n   140\t  thinking_level_change: { fallbackText: thinkingLevelChangeText },\n   141\t  tool_call: {\n   142\t    fallbackText: (message) => {\n   143\t      const block = message.blocks[0]?.content ?? {};\n   144\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n   145\t      return `${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`;\n   146\t    },\n   147\t  },\n   148\t  tool_result: {\n   149\t    form: \"tool_result_summary\",\n   150\t    fallbackText: (message) => {\n   151\t      const block = message.blocks[0]?.content ?? {};\n   152\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n   153\t    },\n   154\t  },\n   155\t};\n   156\t\n   157\t// One per-message atom before grouping: its composed part plus the structural\n   158\t// facts the run-grouping reads. Tool atoms fold into runs; prompts and\n   159\t// assistant text break runs; thinking and runtime notes are transparent —\n   160\t// interior ones fold into the surrounding run's account, edge ones stand alone.\n   161\tinterface ComposeAtom {\n   162\t  part: RenderingPart;\n   163\t  isTool: boolean;\n   164\t  isBreak: boolean; // user_prompt | assistant_text — ends a run\n   165\t  toolName?: string; // tool_call only\n   166\t  toolCallId?: string; // tool_call | tool_result\n   167\t}\n   168\t\n   169\tconst RUN_BREAK_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"user_prompt\", \"assistant_text\"]);\n   170\tconst TOOL_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"tool_call\", \"tool_result\"]);\n   171\t\n   172\t// One message → its composed part (ready form verbatim, else raw/truncated\n   173\t// fallback) plus a gap when a derivable form was not ready. Gaps stay\n   174\t// per-message — precise to the source record — regardless of run grouping\n   175\t// (AC-3.2/3.3): the caller lands them on the rendering and they hold until an\n   176\t// explicit rebuild recomposes from current states.\n   177\tfunction buildAtom(\n   178\t  message: ComposeMessage,\n   179\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   180\t  resultByCallId: Map<string, boolean>,\n   181\t): { atom: ComposeAtom; gap?: DependencyGap; recovery?: RecoveryReceipt } {\n   182\t  const plan = PART_PLANS[message.kind];\n   183\t  const form =\n   184\t    plan.form === undefined\n   185\t      ? undefined\n   186\t      : forms.get(composeFormKey(message.messageId, plan.form));\n   187\t  const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n   188\t  const block = message.blocks[0]?.content ?? {};\n   189\t  const part: RenderingPart = {\n   190\t    messageId: message.messageId,\n   191\t    kind: message.kind,\n   192\t    text: ready ? (form.content as string) : plan.fallbackText(message),\n   193\t    fallback: plan.form !== undefined && !ready,\n   194\t  };\n   195\t  if (message.kind === \"model_change\" || message.kind === \"thinking_level_change\") {\n   196\t    part.blocks = message.blocks;\n   197\t  }\n   198\t  if (message.kind === \"tool_call\") {\n   199\t    part.outcome =\n   200\t      ready && form.metadata?.outcome !== undefined\n   201\t        ? form.metadata.outcome\n   202\t        : outcomeFromRecord(resultByCallId, block[\"toolCallId\"]);\n   203\t  } else if (message.kind === \"tool_result\") {\n   204\t    part.outcome =\n   205\t      ready && form.metadata?.outcome !== undefined\n   206\t        ? form.metadata.outcome\n   207\t        : block[\"isError\"] === true\n   208\t          ? \"failed\"\n   209\t          : \"succeeded\";\n   210\t  }\n   211\t  const atom: ComposeAtom = {\n   212\t    part,\n   213\t    isTool: TOOL_KINDS.has(message.kind),\n   214\t    isBreak: RUN_BREAK_KINDS.has(message.kind),\n   215\t  };\n   216\t  if (message.kind === \"tool_call\" && typeof block[\"toolName\"] === \"string\") {\n   217\t    atom.toolName = block[\"toolName\"];\n   218\t  }\n   219\t  if (atom.isTool && typeof block[\"toolCallId\"] === \"string\") {\n   220\t    atom.toolCallId = block[\"toolCallId\"];\n   221\t  }\n   222\t  const gap: DependencyGap | undefined =\n   223\t    part.fallback && plan.form !== undefined\n   224\t      ? { subjectKind: \"message\", subjectId: message.messageId, derivationType: plan.form }\n   225\t      : undefined;\n   226\t  const recovery: RecoveryReceipt | undefined =\n   227\t    part.fallback && plan.form !== undefined && form !== undefined\n   228\t      ? {\n   229\t          subjectKind: \"message\",\n   230\t          subjectId: message.messageId,\n   231\t          derivationType: plan.form,\n   232\t          content: part.text,\n   233\t          sourceVersion: form.sourceVersion,\n   234\t          reason: form.state === \"failed\" ? \"failed_floor\" : \"not_ready\",\n   235\t          floorUsed: part.text,\n   236\t        }\n   237\t      : undefined;\n   238\t  return { atom, ...(gap === undefined ? {} : { gap }), ...(recovery === undefined ? {} : { recovery }) };\n   239\t}\n   240\t\n   241\tconst RUN_OUTCOME_ORDER: readonly ToolOutcome[] = [\"succeeded\", \"failed\", \"unknown\"];\n   242\t\n   243\t// The run's per-invocation outcome tally: each call counted once, plus any\n   244\t// result whose paired call sits outside this run (a cross-turn pair). Mixed\n   245\t// outcomes stay explicit; the run-level outcome is failed if any failed, else\n   246\t// unknown if any unknown, else succeeded.\n   247\tfunction tallyRun(members: readonly ComposeAtom[]): {\n   248\t  counts: Record<ToolOutcome, number>;\n   249\t  outcome: ToolOutcome;\n   250\t  callCount: number;\n   251\t  toolNames: string[];\n   252\t} {\n   253\t  const calls = members.filter((m) => m.part.kind === \"tool_call\");\n   254\t  const callIds = new Set(\n   255\t    calls.map((m) => m.toolCallId).filter((id): id is string => id !== undefined),\n   256\t  );\n   257\t  const orphanResults = members.filter(\n   258\t    (m) =>\n   259\t      m.part.kind === \"tool_result\" &&\n   260\t      (m.toolCallId === undefined || !callIds.has(m.toolCallId)),\n   261\t  );\n   262\t  const counts: Record<ToolOutcome, number> = { succeeded: 0, failed: 0, unknown: 0 };\n   263\t  for (const m of [...calls, ...orphanResults]) counts[m.part.outcome ?? \"unknown\"] += 1;\n   264\t  const outcome: ToolOutcome =\n   265\t    counts.failed > 0 ? \"failed\" : counts.unknown > 0 ? \"unknown\" : \"succeeded\";\n   266\t  const toolNames: string[] = [];\n   267\t  for (const call of calls) {\n   268\t    if (call.toolName !== undefined && !toolNames.includes(call.toolName)) {\n   269\t      toolNames.push(call.toolName);\n   270\t    }\n   271\t  }\n   272\t  return { counts, outcome, callCount: calls.length, toolNames };\n   273\t}\n   274\t\n   275\tfunction runTallyText(counts: Record<ToolOutcome, number>): string {\n   276\t  const segs = RUN_OUTCOME_ORDER.filter((o) => counts[o] > 0).map((o) => `${counts[o]} ${o}`);\n   277\t  return segs.length > 0 ? segs.join(\", \") : \"no outcomes\";\n   278\t}\n   279\t\n   280\t// One RenderingPart and one ToolRunReceipt for a maximal tool run (AC-3.4): a\n","exit_code":0,"status":"completed"}}

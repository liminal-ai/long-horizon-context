mains/inspect/internal/health.ts\",\"reason\":\"Updated health failure/preview fields to derivationType.\"},{\"path\":\"packages/lhc/src/domains/inspect/internal/overview.ts\",\"reason\":\"Updated inspect counts to derivation naming.\"},{\"path\":\"packages/lhc/src/shared/report.ts\",\"reason\":\"Updated report row mapper for derivation_type schema.\"},{\"path\":\"packages/lhc/src/shared/inspect.ts\",\"reason\":\"Updated inspect report fields to derivationType.\"},{\"path\":\"packages/lhc/src/inference/adapter.ts\",\"reason\":\"Renamed inference assignment vocabulary to derivation types.\"},{\"path\":\"packages/lhc/src/inference/prompts/index.ts\",\"reason\":\"Renamed prompt registry vocabulary to derivation types.\"},{\"path\":\"packages/lhc/src/inference/types.ts\",\"reason\":\"Renamed model assignment map vocabulary to derivation types.\"},{\"path\":\"packages/lhc/src/scheduler.ts\",\"reason\":\"Updated scheduler completion path to consume derivation writes.\"},{\"path\":\"packages/lhc/test/logging-surface.test.ts\",\"reason\":\"Added TC-5.1a through TC-5.5a logging surface tests.\"},{\"path\":\"packages/lhc/test/**/*.ts\",\"reason\":\"Updated existing tests and fixtures for derivation vocabulary, v7 schema, and logging export expectations.\"}],\"tests\":{\"added\":[\"packages/lhc/test/logging-surface.test.ts\"],\"modified\":[\"packages/lhc/test/**/*.ts\"],\"removed\":[],\"totalAfterStory\":404,\"deltaFromPriorBaseline\":6},\"gatesRun\":[{\"command\":\"cd packages/lhc && pnpm exec vitest run test/logging-surface.test.ts\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm exec vitest run test/derivation-messages.test.ts test/derivation-turns.test.ts\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify-all\",\"result\":\"pass\"}],\"selfReview\":{\"passesRun\":0,\"findingsFixed\":[\"Restored v5 as the old derived_form schema so v7 performs the intended rename migration.\",\"Added v7 to thread creation/open migration history.\",\"Fixed missed runtime surfaces still returning forms/form keys after the type rename.\",\"Added reason filtering to log queries to satisfy actionable-field querying.\",\"Updated public export snapshot and migration-version assertions to v7.\"],\"findingsSurfaced\":[]},\"openQuestions\":[],\"specDeviations\":[],\"recommendedNextStep\":\"Verifier can review Story 0 with both story and epic gates green.\"},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/00-foundation/006-implementor.json\"}],\"startedAt\":\"2026-06-15T04:35:04.965Z\",\"finishedAt\":\"2026-06-15T04:47:09.633Z\"}\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/00-foundation/007-verify.json:1:{\"command\":\"story-verify\",\"version\":1,\"status\":\"ok\",\"outcome\":\"revise\",\"result\":{\"resultId\":\"68a7de8d-5b7d-41e0-bddb-17183021e476\",\"role\":\"story_verifier\",\"provider\":\"codex\",\"model\":\"gpt-5.5\",\"sessionId\":\"019ec99b-0038-7f80-b3ec-637abc75b0ae\",\"continuation\":{\"provider\":\"codex\",\"sessionId\":\"019ec99b-0038-7f80-b3ec-637abc75b0ae\",\"storyId\":\"00-foundation\"},\"mode\":\"initial\",\"story\":{\"id\":\"00-foundation\",\"title\":\"Story 0: Foundation\"},\"artifactsRead\":[\"docs/specs/01-lhc-sdk/06-derivation-recovery/stories/00-foundation.md\",\"docs/specs/01-lhc-sdk/06-derivation-recovery/tech-design.md\",\"docs/specs/01-lhc-sdk/06-derivation-recovery/test-plan.md\",\"docs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/00-foundation/006-implementor.json\",\"packages/lhc/src/shared/derivation.ts\",\"packages/lhc/src/shared/storage.ts\",\"packages/lhc/src/shared/context.ts\",\"packages/lhc/src/domains/threads/internal/create.ts\",\"packages/lhc/src/tech-utils/logging/index.ts\",\"packages/lhc/src/sdk.ts\",\"packages/lhc/test/logging-surface.test.ts\",\"packages/lhc/src/domains/turns/internal/derive.ts\",\"packages/lhc/src/domains/turns/internal/compose.ts\",\"packages/lhc/src/tech-utils/work-queue/index.ts\",\"packages/lhc/src/shared/view.ts\",\"packages/lhc/src/shared/inspect.ts\",\"packages/lhc/src/domains/thread-view/index.ts\",\"packages/lhc/src/domains/thread-view/internal/render.ts\",\"packages/lhc/src/domains/thread-view/internal/select.ts\",\"packages/lhc/test/thread-migration.test.ts\",\"packages/lhc/test/fixtures/threads.ts\"],\"reviewScopeSummary\":\"Initial verification of Story 0 against AC-5.1 through AC-5.5, the derivation vocabulary rename DoD, v7 migration, public SDK logging surface, logging tests, and production fallback/logging paths.\",\"priorFindingStatuses\":[],\"newFindings\":[{\"id\":\"S0-F1\",\"severity\":\"major\",\"title\":\"Ready derivation rows still persist fallback markers instead of logging fallback events only\",\"evidence\":\"AC-5.3 requires a fallback event to exist only in the log and says ready derivation output must carry no degraded/fallback marker (00-foundation.md:43-48). Production turn derivation still collects fallback gaps and attaches them to ready turn_rendering writes (packages/lhc/src/domains/turns/internal/derive.ts:83,95,106-115). Chunk summaries do the same (packages/lhc/src/domains/turns/internal/derive.ts:164-175,192-200). The queue completion path persists those gaps on ready derivation rows (packages/lhc/src/tech-utils/work-queue/index.ts:304-312). `rg writeLog` found no production fallback call sites outside the SDK wrapper and logging tests, and TC-5.3a only manually inserts a clean derivation row before writing a log (packages/lhc/test/logging-surface.test.ts:93-143).\",\"affectedFiles\":[\"packages/lhc/src/domains/turns/internal/derive.ts\",\"packages/lhc/src/tech-utils/work-queue/index.ts\",\"packages/lhc/test/logging-surface.test.ts\",\"packages/lhc/test/derivation-turns.test.ts\"],\"requirementIds\":[\"AC-5.3\",\"TC-5.3a\",\"DD-5\",\"Story 0 DoD: no fallback marker on ready derivation outputs\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true},{\"id\":\"S0-F2\",\"severity\":\"major\",\"title\":\"writeLog participates in the caller transaction\",\"evidence\":\"The story technical notes require `writeLog` to be fail-soft and not share the caller transaction (00-foundation.md:133-134), and DD-5 says it must not share the caller's transaction (tech-design.md:127-129). The implementation inserts through `ctx.db` directly (packages/lhc/src/tech-utils/logging/index.ts:43-59). A focused rollback probe wrote a log inside `BEGIN IMMEDIATE`, rolled back the caller transaction, and observed `{\\\"n\\\":0}` log rows; an independent log transaction would have left one row. TC-5.5a only injects a fake throwing prepare function, so it does not prove real-store transaction isolation (packages/lhc/test/logging-surface.test.ts:220-235).\",\"affectedFiles\":[\"packages/lhc/src/tech-utils/logging/index.ts\",\"packages/lhc/test/logging-surface.test.ts\"],\"requirementIds\":[\"AC-5.5\",\"TC-5.5a\",\"DD-5\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true},{\"id\":\"S0-F3\",\"severity\":\"major\",\"title\":\"Derivation vocabulary rename is not complete across current production/public shapes\",\"evidence\":\"Story 0 scope and DoD require the form vocabulary to be renamed across code and schema (00-foundation.md:15-18,162), and DD-1 says every reference changes from form to derivation vocabulary (tech-design.md:87-89). Current shared/public view and inspect shapes still expose `formUsed` and `formCounts` (packages/lhc/src/shared/view.ts:116-125,152; packages/lhc/src/shared/inspect.ts:57,74). The compact production path persists those names into thread_view JSON (packages/lhc/src/domains/thread-view/index.ts:458-479,508-514), and thread-view internals still define `FormSnapshot`/`FormLookup` for derivation state rows (packages/lhc/src/domains/thread-view/internal/render.ts:131-145).\",\"affectedFiles\":[\"packages/lhc/src/shared/view.ts\",\"packages/lhc/src/shared/inspect.ts\",\"packages/lhc/src/domains/thread-view/index.ts\",\"packages/lhc/src/domains/thread-view/internal/render.ts\",\"packages/lhc/src/domains/thread-view/internal/select.ts\"],\"requirementIds\":[\"Story 0 Scope In: derivation vocabulary rename\",\"DD-1\",\"Story 0 DoD: rename complete across schema, types, work-queue kinds, and tests\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true}],\"openFindings\":[{\"id\":\"S0-F1\",\"severity\":\"major\",\"title\":\"Ready derivation rows still persist fallback markers instead of logging fallback events only\",\"evidence\":\"AC-5.3 requires a fallback event to exist only in the log and says ready derivation output must carry no degraded/fallback marker (00-foundation.md:43-48). Production turn derivation still collects fallback gaps and attaches them to ready turn_rendering writes (packages/lhc/src/domains/turns/internal/derive.ts:83,95,106-115). Chunk summaries do the same (packages/lhc/src/domains/turns/internal/derive.ts:164-175,192-200). The queue completion path persists those gaps on ready derivation rows (packages/lhc/src/tech-utils/work-queue/index.ts:304-312). `rg writeLog` found no production fallback call sites outside the SDK wrapper and logging tests, and TC-5.3a only manually inserts a clean derivation row before writing a log (packages/lhc/test/logging-surface.test.ts:93-143).\",\"affectedFiles\":[\"packages/lhc/src/domains/turns/internal/derive.ts\",\"packages/lhc/src/tech-utils/work-queue/index.ts\",\"packages/lhc/test/logging-surface.test.ts\",\"packages/lhc/test/derivation-turns.test.ts\"],\"requirementIds\":[\"AC-5.3\",\"TC-5.3a\",\"DD-5\",\"Story 0 DoD: no fallback marker on ready derivation outputs\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true},{\"id\":\"S0-F2\",\"severity\":\"major\",\"title\":\"writeLog participates in the caller transaction\",\"evidence\":\"The story technical notes require `writeLog` to be fail-soft and not share the caller transaction (00-foundation.md:133-134), and DD-5 says it must not share the caller's transaction (tech-design.md:127-129). The implementation inserts through `ctx.db` directly (packages/lhc/src/tech-utils/logging/index.ts:43-59). A focused rollback probe wrote a log inside `BEGIN IMMEDIATE`, rolled back the caller transaction, and observed `{\\\"n\\\":0}` log rows; an independent log transaction would have left one row. TC-5.5a only injects a fake throwing prepare function, so it does not prove real-store transaction isolation (packages/lhc/test/logging-surface.test.ts:220-235).\",\"affectedFiles\":[\"packages/lhc/src/tech-utils/logging/index.ts\",\"packages/lhc/test/logging-surface.test.ts\"],\"requirementIds\":[\"AC-5.5\",\"TC-5.5a\",\"DD-5\"],\"recommendedFixScope\":\"quick-fix\",\"blocking\":true},{\"id\":\"S0-F3\",\"severity\":\"major\",\"title\":\"Derivation vocabulary rename is not complete across current production/public shapes\",\"evidence\":\"Story 0 scope and DoD require the form vocabulary to be renamed across code and schema (00-foundation.md:15-18,162), and DD-1 says every reference changes from form to derivation vocabulary (tech-design.md:87-89). Current shared/public view and inspect shapes still expose `formUsed` and `formCounts` (packages/lhc/src/shared/view.ts:116-125,152; packages/lhc/src/shared/inspect.ts:57,74). The compact production path persists those names into thread_view JSON (packages/lhc/src/domains/thread-view/index.ts:458-479,508-514), and thread-view internals still define `FormSnapshot`/`FormLookup` for derivation state rows (packages/lhc/src/domains/thread-view/internal/render.ts:131-145).\",\"affectedFiles\":[\"packages/lhc/src/shared/view.ts\",\"packages/lhc/src/shared/inspect.ts\",\"packages/lhc/src/domains/thread-view/index.ts\",\"packages/lhc/src/domains/thread-view/internal/render.ts\",\"packages/lhc/src/domains/thread-view/internal/select.ts\"],\"requirementIds\":[\"Story 0 Scope In: derivation vocabulary rename\",\"DD-1\",\"Story 0 DoD: rename complete across schema, types, work-queue kinds, and tests\"],\"recommendedFixScope\":\"fresh-fix-path\",\"blocking\":true}],\"requirementCoverage\":{\"verified\":[\"AC-5.1 / TC-5.1a: info, warning, and error log levels are persisted by the SDK logging path and covered by logging-surface.test.ts.\",\"AC-5.2 / TC-5.2a: internal writeLog and SDK instance logging.write write to the same durable log table in logging-surface.test.ts.\",\"AC-5.3 / TC-5.3b: failed derivation state and reason remain on the derivation row independent of log entries in logging-surface.test.ts.\",\"AC-5.4 / TC-5.4a: queryLog supports level, derivationType, subjectId, and reason filters; logging-surface.test.ts covers mixed-field filtering.\",\"V7 schema migration is registered and story/epic gates pass under user_version 7.\"],\"unverified\":[\"AC-5.3 / TC-5.3a production path: actual fallback during derivation construction still writes gaps to ready derivation rows and has no production log call site.\",\"AC-5.5 / TC-5.5a transaction containment: writeLog catches write failures, but a real log write shares and rolls back with the caller transaction.\",\"Story 0 derivation vocabulary rename DoD: public/shared thread-view shapes and persisted JSON still use formUsed/formCounts/FormSnapshot vocabulary.\"]},\"gatesRun\":[{\"command\":\"cd packages/lhc && pnpm exec vitest run test/logging-surface.test.ts\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify-all\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm exec tsx -e '<writeLog inside BEGIN IMMEDIATE, then ROLLBACK; assert log count === 1>'\",\"result\":\"fail\"}],\"productionPathFindings\":[\"Ready derivation completion still persists fallback `gaps` on derivation rows, so fallback markers remain in the derivation state/output channel instead of only the log.\",\"writeLog uses the caller's DatabaseSync handle and participates in the caller transaction; rollback proof observed zero persisted log rows after caller rollback.\",\"Thread-view compact still persists form vocabulary in arrangement/source-state JSON (`formUsed`, `formCounts`) and exposes it through shared view/inspect surfaces.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"fresh-fix-path\",\"openQuestions\":[],\"additionalObservations\":[\"The configured story and epic gates passed, but they do not cover the rollback isolation proof or production fallback-channel behavior.\",\"`verify` and `verify-all` reported 9 skipped real-inference tests because LHC_OPENROUTER_KEY was unset; I did not use those skipped tests as Story 0 evidence.\"]},\"errors\":[],\"warnings\":[],\"artifacts\":[{\"kind\":\"result-envelope\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/00-foundation/007-verify.json\"}],\"startedAt\":\"2026-06-15T04:47:18.964Z\",\"finishedAt\":\"2026-06-15T04:51:50.742Z\"}\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/02-tool-result-rendering/story-lead/001-final-package.json:1:{\"outcome\":\"accepted\",\"storyRunId\":\"02-tool-result-rendering-story-run-001\",\"storyId\":\"02-tool-result-rendering\",\"attempt\":1,\"summary\":{\"storyTitle\":\"Story 2: Tool-Result Rendering\",\"implementedScope\":\"Revised Story 2 rendering so full-band at-or-behind-boundary tool results always use deterministic raw-result truncation and tail tool calls render recorded arguments as-is, including long arguments.\",\"acceptanceRationale\":\"Story-lead scoped acceptance is ready for impl-lead review and outer acceptance.\"},\"evidence\":{\"implementorArtifacts\":[{\"kind\":\"implementor-result\",\"path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/docs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/02-tool-result-rendering/003-implementor.json\",\"provenance\":\"current-run\"},{\"kind\":\"implementor-res
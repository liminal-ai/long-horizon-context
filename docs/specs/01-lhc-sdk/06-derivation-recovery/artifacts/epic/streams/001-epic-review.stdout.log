{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '120,230p' && nl -ba packages/lhc/test/tool-result-rendering.test.ts | sed -n '70,105p'\"","aggregated_output":"   120\t  }\n   121\t  return { messageId, kind };\n   122\t}\n   123\t\n   124\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n   125\t// result queues tool_result_summary, nothing else queues anything —\n   126\t// text, thinking, and note messages are not derivation sources (Epic 01\n   127\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   128\t// intake-stream inside the batch transaction for every recorded message, so\n   129\t// the item commits (or rolls back) with the batch.\n   130\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   131\t  user_prompt: \"prompt_smoothing\",\n   132\t  tool_result: \"tool_result_summary\",\n   133\t};\n   134\t\n   135\t// Which derived form each message-owned kind produces — the owning domain's\n   136\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   137\t// rides the same transaction (DD-5).\n   138\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, DerivationType>> = {\n   139\t  prompt_smoothing: \"smoothed_prompt\",\n   140\t  tool_result_summary: \"tool_result_summary\",\n   141\t};\n   142\t\n   143\tconst DEFAULT_TOOL_RESULT_CONFIG: ResolvedSdkConfig[\"toolResult\"] = {\n   144\t  smallTierTokens: 1000,\n   145\t  largeTierTokens: 5000,\n   146\t  smallTargetRatio: 0.15,\n   147\t  midTargetRatio: 0.04,\n   148\t};\n   149\t\n   150\tfunction writeLargeToolResultSummaryReady(\n   151\t  ctx: OperationContext,\n   152\t  messageId: string,\n   153\t  config: ResolvedSdkConfig[\"toolResult\"],\n   154\t): boolean {\n   155\t  const row = ctx.db\n   156\t    .prepare(\n   157\t      `SELECT content FROM message_block\n   158\t       WHERE message_id = ? AND block_type = 'tool_result'\n   159\t       ORDER BY block_index LIMIT 1`,\n   160\t    )\n   161\t    .get(messageId) as { content: string } | undefined;\n   162\t  if (row === undefined) return false;\n   163\t  const block = JSON.parse(row.content) as Record<string, unknown>;\n   164\t  const content = block[\"content\"];\n   165\t  if (typeof content !== \"string\") return false;\n   166\t  if (estimateTokens(content) <= config.largeTierTokens) return false;\n   167\t  const metadata = JSON.stringify({ outcome: block[\"isError\"] === true ? \"failed\" : \"succeeded\" });\n   168\t  ctx.db\n   169\t    .prepare(\n   170\t      `INSERT INTO derivation\n   171\t         (subject_kind, subject_id, derivation_type, state, content, metadata, source_version, derived_at)\n   172\t       VALUES ('message', ?, 'tool_result_summary', 'ready', ?, ?, 1, ?)`,\n   173\t    )\n   174\t    .run(messageId, truncateForFallback(content), metadata, ctx.clock().toISOString());\n   175\t  return true;\n   176\t}\n   177\t\n   178\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   179\t// construction (DD-6): prompt smoothing and tool-result summaries.\n   180\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   181\t  messageWorkHandlers;\n   182\t\n   183\texport function queueMessageWork(\n   184\t  ctx: OperationContext,\n   185\t  message: MessageCreated,\n   186\t  toolResultConfig: ResolvedSdkConfig[\"toolResult\"] = DEFAULT_TOOL_RESULT_CONFIG,\n   187\t): WorkItemRecord[] {\n   188\t  if (message === null) return [];\n   189\t  const items: WorkItemRecord[] = [];\n   190\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   191\t  if (kind !== undefined) {\n   192\t    if (\n   193\t      message.kind === \"tool_result\" &&\n   194\t      writeLargeToolResultSummaryReady(ctx, message.messageId, toolResultConfig)\n   195\t    ) {\n   196\t      return items;\n   197\t    }\n   198\t    const form = MESSAGE_WORK_FORMS[kind];\n   199\t    if (form === undefined) {\n   200\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   201\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   202\t    }\n   203\t    items.push(\n   204\t      enqueue(ctx, {\n   205\t        owner: \"messages\",\n   206\t        kind,\n   207\t        sourceRef: { messageId: message.messageId },\n   208\t        derivations: [{ subjectKind: \"message\", subjectId: message.messageId, derivationType: form }],\n   209\t      }),\n   210\t    );\n   211\t  }\n   212\t  return items;\n   213\t}\n   214\t\n   215\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   216\t  return {\n   217\t    ok: false,\n   218\t    error: {\n   219\t      errorClass: \"caller_error\",\n   220\t      code: \"thread_not_found\",\n   221\t      reason: `no thread file exists at ${filePath}`,\n   222\t    },\n   223\t  };\n   224\t}\n   225\t\n   226\t// Bounded-listing options (Epic 04 Story 1, DD-3): from/to are\n   227\t// source-event-order bounds, limit caps the count after bounds,\n   228\t// includeDeleted is the audit opt-in. All optional — existing callers see\n   229\t// identical results (visible messages, unbounded, record order).\n   230\texport interface MessageListOptions {\n    70\tfunction liveCount(filePath: string): number {\n    71\t  const db = openRaw(filePath);\n    72\t  try {\n    73\t    return countLiveItems(db);\n    74\t  } finally {\n    75\t    db.close();\n    76\t  }\n    77\t}\n    78\t\n    79\tdescribe(\"Story 2: tool-result rendering\", () => {\n    80\t  it(\"large tool results satisfy tool_result_summary by deterministic truncation with no work item\", async () => {\n    81\t    const double = createProviderDouble();\n    82\t    const captured = double.captureInputs();\n    83\t    const sdk = sdkFor(double);\n    84\t    const filePath = await newThread();\n    85\t    const content = \"result-token \".repeat(6000);\n    86\t\n    87\t    const batch = await send(sdk, filePath, [\n    88\t      validEvent(\"tool_call\", {\n    89\t        payload: { toolCallId: \"large\", toolName: \"read_file\", arguments: { path: \"huge.log\" } },\n    90\t      }),\n    91\t      validEvent(\"tool_result\", {\n    92\t        payload: { toolCallId: \"large\", content, isError: false },\n    93\t      }),\n    94\t    ]);\n    95\t\n    96\t    expect(batch.queuedWork).toEqual([]);\n    97\t    expect(captured).toEqual([]);\n    98\t    expect(liveCount(filePath)).toBe(0);\n    99\t    expect(formOf(filePath, \"m1\", \"tool_call_summary\")).toBeUndefined();\n   100\t    expect(formOf(filePath, \"m2\", \"tool_result_summary\")).toMatchObject({\n   101\t      state: \"ready\",\n   102\t      content: truncateForFallback(content),\n   103\t      metadata: { outcome: \"succeeded\" },\n   104\t    });\n   105\t\n","exit_code":0,"status":"completed"}}

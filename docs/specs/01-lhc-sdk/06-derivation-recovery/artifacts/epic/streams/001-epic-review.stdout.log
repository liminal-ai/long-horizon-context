npackages/lhc/src/sdk.ts:317:    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\npackages/lhc/src/sdk.ts:344:// provider/model routing keys — then build the adapter into the same\npackages/lhc/src/sdk.ts:349:    throw new TypeError(\"createSdk config: inference.call must be a function\");\npackages/lhc/src/sdk.ts:353:    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\npackages/lhc/src/sdk.ts:359:        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\npackages/lhc/src/sdk.ts:367:      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\npackages/lhc/src/sdk.ts:369:    for (const field of [\"provider\", \"model\"] as const) {\npackages/lhc/src/sdk.ts:373:          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\npackages/lhc/src/sdk.ts:379:        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\npackages/lhc/src/sdk.ts:395:// The only assembly path: provider, mode, clock, and policy enter here.\npackages/lhc/src/sdk.ts:398:export function createSdk(config: SdkConfig): Lhc {\npackages/lhc/src/sdk.ts:400:  // config (Epic 05 DD-5); there is no named-provider registry and no\npackages/lhc/src/sdk.ts:404:  if (config.provider !== undefined && config.inference !== undefined) {\npackages/lhc/src/sdk.ts:405:    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\npackages/lhc/src/sdk.ts:407:  if (config.provider === undefined && config.inference === undefined) {\npackages/lhc/src/sdk.ts:408:    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\npackages/lhc/src/sdk.ts:412:      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\npackages/lhc/src/sdk.ts:415:  let provider: DerivationProvider;\npackages/lhc/src/sdk.ts:417:   
ges/lhc/test/inference-real.test.ts:235:      expect(form.metadata?.provenance?.model).toBe(realModel);\npackages/lhc/test/inference-real.test.ts:247:        (form) =>\npackages/lhc/test/inference-real.test.ts:248:          form.subjectKind === target.subjectKind &&\npackages/lhc/test/inference-real.test.ts:249:          form.subjectId === target.subjectId &&\npackages/lhc/test/inference-real.test.ts:250:          form.derivationType === target.derivationType,\npackages/lhc/test/fixtures/view-boundary.ts:4:// boundary is hand-set (Epic 03's anti-shim rule, inherited).\npackages/lhc/test/fixtures/view-boundary.ts:74:  if (!result.ok) throw new Error(`boundary seed intake failed: ${result.error.reason}`);\npackages/lhc/test/fixtures/lifecycle.ts:4:// provider, no mocks anywhere. The script owns the sequence and the phase\npackages/lhc/test/fixtures/lifecycle.ts:222:    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\npackages/lhc/test/fixtures/lifecycle.ts:297:    throw new Error(\"lifecycle invariant: edit/delete targets not found in the record\");\npackages/lhc/src/domains/messages/internal/cascade.ts:7:// actually exist), never from a hardcoded form list: a future form on any\npackages/lhc/src/domains/messages/internal/cascade.ts:152:    throw new Error(`no rebuild work kind mapped for derivation ${derivationType}`);\npackages/lhc/src/domains/messages/internal/cascade.ts:158:// their form rows outright; clear subjects go pending at the next source\npackages/lhc/src/domains/thread-view/index.ts:102:// at-or-behind the boundary in short form. No view row ⇒ the whole record is\npackages/lhc/src/domains/inspect/internal/view-report.ts:8:// form choice, or boundary state.\npackages/lhc/src/domains/inspect/internal/health.ts:20:  if (event.eventKind !== \"runtime_note\") return null;\npackages/lhc/src/domains/inspect/internal/health.ts:25:// mechanics durably put them — retry exhaustion copies them onto the form's\npackages/lhc/src/domains/inspect/internal/health.ts:119:      // pending + retrying above by construction. Counts are per form-report\npackages/lhc/src/domains/inspect/internal/health.ts:121:      // (e.g. a turn_derivation) may back multiple form entries, so a raw\npackages/lhc/src/domains/thread-view/internal/sweep.ts:8:// drainSettled/polling in this module is a contract violation (anti-shim;\npackages/lhc/src/domains/thread-view/internal/sweep.ts:21:// persists as the prefix of a failed form's reason (`<code>: <detail>`,\npackages/lhc/src/domains/thread-view/internal/sweep.ts:37:// the first \":\"), never the prose after it (anti-shim: no string-matching on\npackages/lhc/src/domains/thread-view/internal/sweep.ts:49:// subjectKind turn|chunk). The owner's `already_queued` noop is what makes\npackages/lhc/src/domains/thread-view/internal/sweep.ts:51:// work already live at the form's source version writes nothing.\npackages/lhc/src/domains/thread-view/internal/sweep.ts:56:): Promise<OpResult<{ workItemId: string } | { noop: \"already_queued\" }>> {\npackages/lhc/src/domains/thread-view/internal/sweep.ts:71:// form — ready / pending ⇒ in-flight / blocked / failed × classify — then\npackages/lhc/src/domains/thread-view/internal/sweep.ts:74:// not raw form states: \"retrying\" is a report-level distinction the sweep\npackages/lhc/src/domains/thread-view/internal/sweep.ts:124:          // already_queued counts as in-flight: a sibling form's requeue in\npackages/lhc/src/domains/thread-view/internal/sweep.ts:127:          if (\"noop\" in requeued.value) line.inFlight += 1;\npackages/lhc/test/fixtures/model-call.ts:1:// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\npackages/lhc/test/fixtures/model-call.ts:3:// doubles, not internal mocks — the ModelCall function is where LHC's code\npackages/lhc/test/fixtures/model-call.ts:18:// validAssignments gives every kind a distinct fake provider/model lane;\npackages/lhc/test/fixtures/model-call.ts:40:// landed form content, never just in call counts.\npackages/lhc/test/fixtures/model-call.ts:44:    map[kind] = `canned ${kind} text from the fake host`;\npackages/lhc/test/fixtures/model-call.ts:65:      throw new Error(`recordingCall: no canned response for model \"${input.model}\"`);\npackages/lhc/test/fixtures/model-call.ts:80:      throw new Error(\npackages/lhc/src/domains/thread-view/internal/snapshot.ts:196:    throw new Error(\"thread_metadata singleton row missing (creation writes it)\");\npackages/lhc/src/domains/thread-view/internal/snapshot.ts:270:// Ready tool-result summaries by message id — the short-form ladder's first\npackages/lhc/src/domains/thread-view/internal/boundary.ts:18:    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\npackages/lhc/src/domains/thread-view/internal/render.ts:4:// short-form ladder (ready summary → deterministic truncation). Pure\npackages/lhc/src/domains/thread-view/internal/render.ts:44:// short-form ladder's first rung).\npackages/lhc/src/domains/thread-view/internal/render.ts:115:    case \"runtime_note\":\npackages/lhc/src/domains/thread-view/internal/render.ts:172:function usable(form: DerivationSnapshot | undefined): form is DerivationSnapshot & { content: string } {\npackages/lhc/src/domains/thread-view/internal/render.ts:174:  return form?.state === \"ready\" && typeof form.content === \"string\";\npackages/lhc/src/domains/thread-view/internal/render.ts:177:function ladderState(form: DerivationSnapshot | undefined): string {\npackages/lhc/src/domains/thread-view/internal/render.ts:178:  return form === undefined ? \"absent\" : form.state;\npackages/lhc/src/domains/thread-view/internal/render.ts:216:    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\npackages/lhc/src/domains/thread-view/internal/render.ts:254:    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, compact materia
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '130,210p'\"","aggregated_output":"   130\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   131\t  user_prompt: \"prompt_smoothing\",\n   132\t  tool_result: \"tool_result_summary\",\n   133\t};\n   134\t\n   135\t// Which derived form each message-owned kind produces — the owning domain's\n   136\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   137\t// rides the same transaction (DD-5).\n   138\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, DerivationType>> = {\n   139\t  prompt_smoothing: \"smoothed_prompt\",\n   140\t  tool_result_summary: \"tool_result_summary\",\n   141\t};\n   142\t\n   143\tconst DEFAULT_TOOL_RESULT_CONFIG: ResolvedSdkConfig[\"toolResult\"] = {\n   144\t  smallTierTokens: 1000,\n   145\t  largeTierTokens: 5000,\n   146\t  smallTargetRatio: 0.15,\n   147\t  midTargetRatio: 0.04,\n   148\t};\n   149\t\n   150\tfunction writeLargeToolResultSummaryReady(\n   151\t  ctx: OperationContext,\n   152\t  messageId: string,\n   153\t  config: ResolvedSdkConfig[\"toolResult\"],\n   154\t): boolean {\n   155\t  const row = ctx.db\n   156\t    .prepare(\n   157\t      `SELECT content FROM message_block\n   158\t       WHERE message_id = ? AND block_type = 'tool_result'\n   159\t       ORDER BY block_index LIMIT 1`,\n   160\t    )\n   161\t    .get(messageId) as { content: string } | undefined;\n   162\t  if (row === undefined) return false;\n   163\t  const block = JSON.parse(row.content) as Record<string, unknown>;\n   164\t  const content = block[\"content\"];\n   165\t  if (typeof content !== \"string\") return false;\n   166\t  if (estimateTokens(content) <= config.largeTierTokens) return false;\n   167\t  const metadata = JSON.stringify({ outcome: block[\"isError\"] === true ? \"failed\" : \"succeeded\" });\n   168\t  ctx.db\n   169\t    .prepare(\n   170\t      `INSERT INTO derivation\n   171\t         (subject_kind, subject_id, derivation_type, state, content, metadata, source_version, derived_at)\n   172\t       VALUES ('message', ?, 'tool_result_summary', 'ready', ?, ?, 1, ?)`,\n   173\t    )\n   174\t    .run(messageId, truncateForFallback(content), metadata, ctx.clock().toISOString());\n   175\t  return true;\n   176\t}\n   177\t\n   178\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   179\t// construction (DD-6): prompt smoothing and tool-result summaries.\n   180\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   181\t  messageWorkHandlers;\n   182\t\n   183\texport function queueMessageWork(\n   184\t  ctx: OperationContext,\n   185\t  message: MessageCreated,\n   186\t  toolResultConfig: ResolvedSdkConfig[\"toolResult\"] = DEFAULT_TOOL_RESULT_CONFIG,\n   187\t): WorkItemRecord[] {\n   188\t  if (message === null) return [];\n   189\t  const items: WorkItemRecord[] = [];\n   190\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   191\t  if (kind !== undefined) {\n   192\t    if (\n   193\t      message.kind === \"tool_result\" &&\n   194\t      writeLargeToolResultSummaryReady(ctx, message.messageId, toolResultConfig)\n   195\t    ) {\n   196\t      return items;\n   197\t    }\n   198\t    const form = MESSAGE_WORK_FORMS[kind];\n   199\t    if (form === undefined) {\n   200\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   201\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   202\t    }\n   203\t    items.push(\n   204\t      enqueue(ctx, {\n   205\t        owner: \"messages\",\n   206\t        kind,\n   207\t        sourceRef: { messageId: message.messageId },\n   208\t        derivations: [{ subjectKind: \"message\", subjectId: message.messageId, derivationType: form }],\n   209\t      }),\n   210\t    );\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '90,230p'\"","aggregated_output":"    90\t  return block[\"isError\"] === true ? \"failed\" : \"succeeded\";\n    91\t}\n    92\t\n    93\tasync function recoverMessageForms(\n    94\t  run: HandlerRunContext,\n    95\t  messages: readonly ComposeMessage[],\n    96\t  forms: Map<string, ComposeFormRow>,\n    97\t): Promise<void> {\n    98\t  for (const message of messages) {\n    99\t    const plan =\n   100\t      message.kind === \"user_prompt\"\n   101\t        ? { derivationType: \"smoothed_prompt\" as const }\n   102\t        : message.kind === \"tool_result\"\n   103\t          ? { derivationType: \"tool_result_summary\" as const }\n   104\t          : undefined;\n   105\t    if (plan === undefined) continue;\n   106\t    const key = composeFormKey(message.messageId, plan.derivationType);\n   107\t    const row = forms.get(key);\n   108\t    if (row === undefined || row.state === \"ready\") continue;\n   109\t    const live = hasLiveRecoveryWork(run.openDb(), {\n   110\t      subjectKind: \"message\",\n   111\t      subjectId: message.messageId,\n   112\t      derivationType: plan.derivationType,\n   113\t      sourceVersion: row.sourceVersion,\n   114\t    });\n   115\t    if (live) continue;\n   116\t\n   117\t    const block = message.blocks[0]?.content ?? {};\n   118\t    const result =\n   119\t      message.kind === \"user_prompt\"\n   120\t        ? await run.provider.smoothPrompt({\n   121\t            text: cleanPrompt(typeof block[\"text\"] === \"string\" ? block[\"text\"] : \"\"),\n   122\t          })\n   123\t        : await run.provider.summarizeToolResult({\n   124\t            toolName: \"unknown_tool\",\n   125\t            content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n   126\t            outcome: toolOutcomeFromMessage(message),\n   127\t          });\n   128\t    if (!result.ok) continue;\n   129\t\n   130\t    const metadata: DerivationMetadata | undefined =\n   131\t      message.kind === \"tool_result\"\n   132\t        ? {\n   133\t            outcome: toolOutcomeFromMessage(message),\n   134\t            ...(result.provenance === undefined ? {} : { provenance: result.provenance }),\n   135\t          }\n   136\t        : result.provenance === undefined\n   137\t          ? undefined\n   138\t          : { provenance: result.provenance };\n   139\t    const recovered: ComposeFormRow = {\n   140\t      state: \"ready\",\n   141\t      content: result.text,\n   142\t      sourceVersion: row.sourceVersion,\n   143\t      ...(metadata === undefined ? {} : { metadata }),\n   144\t    };\n   145\t    forms.set(key, recovered);\n   146\t    recoverDerivation(run.openDb(), {\n   147\t      subjectKind: \"message\",\n   148\t      subjectId: message.messageId,\n   149\t      derivationType: plan.derivationType,\n   150\t      content: result.text,\n   151\t      ...(recovered.metadata === undefined ? {} : { metadata: recovered.metadata }),\n   152\t      sourceVersion: row.sourceVersion,\n   153\t      derivedAt: run.clock().toISOString(),\n   154\t    });\n   155\t  }\n   156\t}\n   157\t\n   158\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n   159\t  const turnId = item.sourceRef[\"turnId\"];\n   160\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n   161\t  const db = run.openDb();\n   162\t  const turn = readTurnSource(db, turnId);\n   163\t  if (turn === undefined || turn.deleted) {\n   164\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n   165\t    // would hit nothing; either way the item is terminal against a source\n   166\t    // that cannot improve.\n   167\t    return sourceDamaged(`turn ${turnId} not found`);\n   168\t  }\n   169\t  if (turn.status !== \"closed\") {\n   170\t    // Derivation is queued only at close; an open turn under a queued item\n   171\t    // means the record was interfered with.\n   172\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n   173\t  }\n   174\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n   175\t  // batch pipeline writes turn state and it never leaves two turns open, so\n   176\t  // more than one open turn means the record was damaged below the SDK. A\n   177\t  // handler must not compose against a membership it cannot trust; the form\n   178\t  // lands blocked naming the damage, and requeue refuses with that reason\n   179\t  // until the source reads clean (Story 4).\n   180\t  const openTurnIds = selectOpenTurnIds(db);\n   181\t  if (openTurnIds.length > 1) {\n   182\t    return sourceDamaged(\n   183\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n   184\t    );\n   185\t  }\n   186\t\n   187\t  // Compose from current message-form states: ready forms verbatim,\n   188\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n   189\t  // before any provider call, and no transaction is held across them.\n   190\t  const messages = readMemberMessages(db, turnId);\n   191\t  const forms = readMessageFormRows(\n   192\t    db,\n   193\t    messages.map((message) => message.messageId),\n   194\t  );\n   195\t  await recoverMessageForms(run, messages, forms);\n   196\t  const { parts, receipts, recoveries } = composeRenderingInput(messages, forms);\n   197\t  for (const recovery of recoveries) {\n   198\t    logFallback(run, {\n   199\t      derivationType: recovery.derivationType,\n   200\t      subjectId: recovery.subjectId,\n   201\t      reason: recovery.reason,\n   202\t      floorUsed: recovery.floorUsed,\n   203\t    });\n   204\t    recoverDerivation(run.openDb(), {\n   205\t      subjectKind: recovery.subjectKind,\n   206\t      subjectId: recovery.subjectId,\n   207\t      derivationType: recovery.derivationType,\n   208\t      content: recovery.content,\n   209\t      sourceVersion: recovery.sourceVersion,\n   210\t      derivedAt: run.clock().toISOString(),\n   211\t    });\n   212\t  }\n   213\t\n   214\t  const rendering = await run.provider.composeTurnRendering({ parts });\n   215\t  if (!rendering.ok) return providerFailed(rendering);\n   216\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n   217\t  if (!projection.ok) return providerFailed(projection);\n   218\t\n   219\t  // The projection's token count is estimated exactly once, here, as the\n   220\t  // artifact lands; placement reads this stored arithmetic and never\n   221\t  // re-counts (AC-3.9's determinism input).\n   222\t  const projectedTokens = estimateTokens(projection.text);\n   223\t  const threadId = readThreadId(run);\n   224\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\n   225\t  // from the composition input (AC-3.8) — the chunk summaries read them from\n   226\t  // here, never from provider prose. Provenance is copied from the provider\n   227\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\n   228\t  // deterministic provider sets none.\n   229\t  const renderingMetadata: DerivationMetadata = {\n   230\t    ...(receipts.length > 0 ? { receipts } : {}),\n","exit_code":0,"status":"completed"}}

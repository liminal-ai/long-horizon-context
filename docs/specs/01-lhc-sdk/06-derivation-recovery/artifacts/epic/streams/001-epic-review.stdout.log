{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/render.ts | sed -n '170,285p'\"","aggregated_output":"   170\t}\n   171\t\n   172\tfunction usable(form: DerivationSnapshot | undefined): form is DerivationSnapshot & { content: string } {\n   173\t  // \"Usable\" means state = ready (tech design §Degrade ladders).\n   174\t  return form?.state === \"ready\" && typeof form.content === \"string\";\n   175\t}\n   176\t\n   177\tfunction ladderState(form: DerivationSnapshot | undefined): string {\n   178\t  return form === undefined ? \"absent\" : form.state;\n   179\t}\n   180\t\n   181\t// Smooth (turn) ladder: turn_rendering → lower_band_projection →\n   182\t// deterministic excerpt of the turn's live messages → gap entry.\n   183\texport function resolveSmoothRepresentation(\n   184\t  turnId: string,\n   185\t  lookup: DerivationLookup,\n   186\t  excerpt: string | null,\n   187\t): ResolvedRepresentation {\n   188\t  const rendering = lookup(turnId, \"turn_rendering\");\n   189\t  if (usable(rendering)) {\n   190\t    return { derivationUsed: \"turn_rendering\", body: rendering.content, degraded: false, gap: false };\n   191\t  }\n   192\t  const projection = lookup(turnId, \"lower_band_projection\");\n   193\t  if (usable(projection)) {\n   194\t    return {\n   195\t      derivationUsed: \"lower_band_projection\",\n   196\t      body: projection.content,\n   197\t      degraded: true,\n   198\t      gap: false,\n   199\t      degradedMarker: \"smooth-from-projection\",\n   200\t    };\n   201\t  }\n   202\t  if (excerpt !== null) {\n   203\t    return {\n   204\t      derivationUsed: \"message_excerpt\",\n   205\t      body: deterministicTruncation(excerpt),\n   206\t      degraded: true,\n   207\t      gap: false,\n   208\t      degradedMarker: \"smooth-from-excerpt\",\n   209\t    };\n   210\t  }\n   211\t  return {\n   212\t    derivationUsed: \"gap\",\n   213\t    body: \"\",\n   214\t    degraded: false,\n   215\t    gap: true,\n   216\t    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\n   217\t  };\n   218\t}\n   219\t\n   220\t// Detailed (chunk) ladder: chunk_summary_detailed → chunk_summary_brief →\n   221\t// concatenated member projections (truncated, marked) → gap entry.\n   222\texport function resolveDetailedRepresentation(\n   223\t  chunkId: string,\n   224\t  lookup: DerivationLookup,\n   225\t  material?: CompactChunkMaterialSnapshot,\n   226\t): ResolvedRepresentation {\n   227\t  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n   228\t  if (usable(detailed)) {\n   229\t    return { derivationUsed: \"chunk_summary_detailed\", body: detailed.content, degraded: false, gap: false };\n   230\t  }\n   231\t  if (material?.kind === \"ready\") {\n   232\t    return {\n   233\t      derivationUsed: \"chunk_summary_detailed\",\n   234\t      body: material.content,\n   235\t      degraded: false,\n   236\t      gap: false,\n   237\t    };\n   238\t  }\n   239\t  if (material?.kind === \"concat\") {\n   240\t    return {\n   241\t      derivationUsed: \"stored_member_concat\",\n   242\t      body: material.content,\n   243\t      degraded: true,\n   244\t      gap: false,\n   245\t      degradedMarker: \"detailed-from-stored-members\",\n   246\t      reason: material.reason,\n   247\t    };\n   248\t  }\n   249\t  return {\n   250\t    derivationUsed: \"gap\",\n   251\t    body: \"\",\n   252\t    degraded: false,\n   253\t    gap: true,\n   254\t    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, compact material absent)`,\n   255\t  };\n   256\t}\n   257\t\n   258\t// Brief (chunk) ladder: chunk_summary_brief → chunk_summary_detailed\n   259\t// truncated → gap entry (no projections rung in this band's ladder).\n   260\texport function resolveBriefRepresentation(\n   261\t  chunkId: string,\n   262\t  lookup: DerivationLookup,\n   263\t  material?: CompactChunkMaterialSnapshot,\n   264\t): ResolvedRepresentation {\n   265\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n   266\t  if (usable(brief)) {\n   267\t    return { derivationUsed: \"chunk_summary_brief\", body: brief.content, degraded: false, gap: false };\n   268\t  }\n   269\t  if (material?.kind === \"ready\") {\n   270\t    return {\n   271\t      derivationUsed: \"chunk_summary_brief\",\n   272\t      body: material.content,\n   273\t      degraded: false,\n   274\t      gap: false,\n   275\t    };\n   276\t  }\n   277\t  if (material?.kind === \"concat\") {\n   278\t    return {\n   279\t      derivationUsed: \"stored_member_concat\",\n   280\t      body: material.content,\n   281\t      degraded: true,\n   282\t      gap: false,\n   283\t      degradedMarker: \"brief-from-stored-members\",\n   284\t      reason: material.reason,\n   285\t    };\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport { resolveInstancePoke } from \"../../../shared/context.js\";\n    11\timport type {\n    12\t  DerivationMetadata,\n    13\t  DerivationType,\n    14\t  HandlerOutcome,\n    15\t  HandlerRunContext,\n    16\t  ProviderResult,\n    17\t  ToolOutcome,\n    18\t  WorkHandler,\n    19\t} from \"../../../shared/derivation.js\";\n    20\timport { writeLog } from \"../../../tech-utils/logging/index.js\";\n    21\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    22\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    23\timport { truncateForFallback } from \"../../../shared/tool-result-rendering.js\";\n    24\timport { cleanPrompt } from \"../../messages/index.js\";\n    25\timport {\n    26\t  composeFormKey,\n    27\t  composeRenderingInput,\n    28\t  type ComposeFormRow,\n    29\t  type ComposeMessage,\n    30\t} from \"./compose.js\";\n    31\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    32\timport {\n    33\t  chunkExists,\n    34\t  readMemberMessages,\n    35\t  readMemberProjections,\n    36\t  readMessageFormRows,\n    37\t  readTurnSource,\n    38\t} from \"./forms.js\";\n    39\timport { hasLiveRecoveryWork, recoverDerivation } from \"./recovery.js\";\n    40\timport { selectOpenTurnIds } from \"./store.js\";\n    41\t\n    42\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    43\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    44\t}\n    45\t\n    46\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    47\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    48\t}\n    49\t\n    50\tfunction dependencyNotReady(reason: string): HandlerOutcome {\n    51\t  return { ok: false, retryable: true, reason };\n    52\t}\n    53\t\n    54\tfunction readThreadId(run: HandlerRunContext): string {\n    55\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    56\t    | { thread_id: string }\n    57\t    | undefined;\n    58\t  return row?.thread_id ?? \"\";\n    59\t}\n    60\t\n    61\tfunction logFallback(\n    62\t  run: HandlerRunContext,\n    63\t  entry: {\n    64\t    derivationType: DerivationType;\n    65\t    subjectId: string;\n    66\t    reason: \"not_ready\" | \"failed_floor\";\n    67\t    floorUsed: string;\n    68\t  },\n    69\t): void {\n    70\t  const db = run.openDb();\n    71\t  writeLog(\n    72\t    {\n    73\t      db,\n    74\t      clock: run.clock,\n    75\t      threadId: readThreadId(run),\n    76\t      onCommit: () => {},\n    77\t      poke: resolveInstancePoke(),\n    78\t    },\n    79\t    {\n    80\t      level: \"warning\",\n    81\t      message: \"derivation fallback used\",\n    82\t      derivationType: entry.derivationType,\n    83\t      subjectId: entry.subjectId,\n    84\t      reason: entry.reason,\n    85\t      floorUsed: entry.floorUsed,\n    86\t    },\n    87\t  );\n    88\t}\n    89\t\n    90\tfunction toolOutcomeFromMessage(message: ComposeMessage): ToolOutcome {\n    91\t  const block = message.blocks[0]?.content ?? {};\n    92\t  return block[\"isError\"] === true ? \"failed\" : \"succeeded\";\n    93\t}\n    94\t\n    95\tasync function recoverMessageForms(\n    96\t  run: HandlerRunContext,\n    97\t  messages: readonly ComposeMessage[],\n    98\t  forms: Map<string, ComposeFormRow>,\n    99\t): Promise<void> {\n   100\t  for (const message of messages) {\n   101\t    const plan =\n   102\t      message.kind === \"user_prompt\"\n   103\t        ? { derivationType: \"smoothed_prompt\" as const }\n   104\t        : message.kind === \"tool_result\"\n   105\t          ? { derivationType: \"tool_result_summary\" as const }\n   106\t          : undefined;\n   107\t    if (plan === undefined) continue;\n   108\t    const key = composeFormKey(message.messageId, plan.derivationType);\n   109\t    const row = forms.get(key);\n   110\t    if (row === undefined || row.state === \"ready\") continue;\n   111\t    const live = hasLiveRecoveryWork(run.openDb(), {\n   112\t      subjectKind: \"message\",\n   113\t      subjectId: message.messageId,\n   114\t      derivationType: plan.derivationType,\n   115\t      sourceVersion: row.sourceVersion,\n   116\t    });\n   117\t    if (live) continue;\n   118\t\n   119\t    const block = message.blocks[0]?.content ?? {};\n   120\t    const content = typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\";\n   121\t    const largeToolResult =\n   122\t      message.kind === \"tool_result\" &&\n   123\t      estimateTokens(content) > run.config.toolResult.largeTierTokens;\n   124\t    const result: ProviderResult = largeToolResult\n   125\t      ? { ok: true, text: truncateForFallback(content) }\n   126\t      : message.kind === \"user_prompt\"\n   127\t        ? await run.provider.smoothPrompt({\n   128\t            text: cleanPrompt(typeof block[\"text\"] === \"string\" ? block[\"text\"] : \"\"),\n   129\t          })\n   130\t        : await run.provider.summarizeToolResult({\n   131\t            toolName: \"unknown_tool\",\n   132\t            content,\n   133\t            outcome: toolOutcomeFromMessage(message),\n   134\t          });\n   135\t    if (!result.ok) continue;\n   136\t\n   137\t    const metadata: DerivationMetadata | undefined =\n   138\t      message.kind === \"tool_result\"\n   139\t        ? {\n   140\t            outcome: toolOutcomeFromMessage(message),\n   141\t            ...(result.provenance === undefined ? {} : { provenance: result.provenance }),\n   142\t          }\n   143\t        : result.provenance === undefined\n   144\t          ? undefined\n   145\t          : { provenance: result.provenance };\n   146\t    const recovered: ComposeFormRow = {\n   147\t      state: \"ready\",\n   148\t      content: result.text,\n   149\t      sourceVersion: row.sourceVersion,\n   150\t      ...(metadata === undefined ? {} : { metadata }),\n   151\t    };\n   152\t    forms.set(key, recovered);\n   153\t    recoverDerivation(run.openDb(), {\n   154\t      subjectKind: \"message\",\n   155\t      subjectId: message.messageId,\n   156\t      derivationType: plan.derivationType,\n   157\t      content: result.text,\n   158\t      ...(recovered.metadata === undefined ? {} : { metadata: recovered.metadata }),\n   159\t      sourceVersion: row.sourceVersion,\n   160\t      derivedAt: run.clock().toISOString(),\n   161\t    });\n   162\t  }\n   163\t}\n   164\t\n   165\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n   166\t  const turnId = item.sourceRef[\"turnId\"];\n   167\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n   168\t  const db = run.openDb();\n   169\t  const turn = readTurnSource(db, turnId);\n   170\t  if (turn === undefined || turn.deleted) {\n   171\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n   172\t    // would hit nothing; either way the item is terminal against a source\n   173\t    // that cannot improve.\n   174\t    return sourceDamaged(`turn ${turnId} not found`);\n   175\t  }\n   176\t  if (turn.status !== \"closed\") {\n   177\t    // Derivation is queued only at close; an open turn under a queued item\n   178\t    // means the record was interfered with.\n   179\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n   180\t  }\n   181\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n   182\t  // batch pipeline writes turn state and it never leaves two turns open, so\n   183\t  // more than one open turn means the record was damaged below the SDK. A\n   184\t  // handler must not compose against a membership it cannot trust; the form\n   185\t  // lands blocked naming the damage, and requeue refuses with that reason\n   186\t  // until the source reads clean (Story 4).\n   187\t  const openTurnIds = selectOpenTurnIds(db);\n   188\t  if (openTurnIds.length > 1) {\n   189\t    return sourceDamaged(\n   190\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n   191\t    );\n   192\t  }\n   193\t\n   194\t  // Compose from current message-form states: ready forms verbatim,\n   195\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n   196\t  // before any provider call, and no transaction is held across them.\n   197\t  const messages = readMemberMessages(db, turnId);\n   198\t  const forms = readMessageFormRows(\n   199\t    db,\n   200\t    messages.map((message) => message.messageId),\n   201\t  );\n   202\t  await recoverMessageForms(run, messages, forms);\n   203\t  const { parts, receipts, recoveries } = composeRenderingInput(messages, forms);\n   204\t  for (const recovery of recoveries) {\n   205\t    logFallback(run, {\n   206\t      derivationType: recovery.derivationType,\n   207\t      subjectId: recovery.subjectId,\n   208\t      reason: recovery.reason,\n   209\t      floorUsed: recovery.floorUsed,\n   210\t    });\n   211\t    recoverDerivation(run.openDb(), {\n   212\t      subjectKind: recovery.subjectKind,\n   213\t      subjectId: recovery.subjectId,\n   214\t      derivationType: recovery.derivationType,\n   215\t      content: recovery.content,\n   216\t      sourceVersion: recovery.sourceVersion,\n   217\t      derivedAt: run.clock().toISOString(),\n   218\t    });\n   219\t  }\n   220\t\n   221\t  const rendering = await run.provider.composeTurnRendering({ parts });\n   222\t  if (!rendering.ok) return providerFailed(rendering);\n   223\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n   224\t  if (!projection.ok) return providerFailed(projection);\n   225\t\n   226\t  // The projection's token count is estimated exactly once, here, as the\n   227\t  // artifact lands; placement reads this stored arithmetic and never\n   228\t  // re-counts (AC-3.9's determinism input).\n   229\t  const projectedTokens = estimateTokens(projection.text);\n   230\t  const threadId = readThreadId(run);\n   231\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\n   232\t  // from the composition input (AC-3.8) — the chunk summaries read them from\n   233\t  // here, never from provider prose. Provenance is copied from the provider\n   234\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\n   235\t  // deterministic provider sets none.\n   236\t  const renderingMetadata: DerivationMetadata = {\n   237\t    ...(receipts.length > 0 ? { receipts } : {}),\n   238\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\n   239\t  };\n   240\t\n   241\t  return {\n   242\t    ok: true,\n   243\t    derivations: [\n   244\t      {\n   245\t        subjectKind: \"turn\",\n   246\t        subjectId: turnId,\n   247\t        derivationType: \"turn_rendering\",\n   248\t        content: rendering.text,\n   249\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\n   250\t      },\n   251\t      {\n   252\t        subjectKind: \"turn\",\n   253\t        subjectId: turnId,\n   254\t        derivationType: \"lower_band_projection\",\n   255\t        content: projection.text,\n   256\t        ...(projection.provenance === undefined\n   257\t          ? {}\n   258\t          : { metadata: { provenance: projection.provenance } }),\n   259\t      },\n   260\t    ],\n","exit_code":0,"status":"completed"}}

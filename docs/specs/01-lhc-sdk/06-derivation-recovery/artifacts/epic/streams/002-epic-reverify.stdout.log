    44\t): boolean {\n    45\t  const target = workTargetFor(r.subjectKind, r.subjectId, r.derivationType);\n    46\t  return target !== undefined && hasLiveItem(db, target.kind, target.sourceRef, r.sourceVersion);\n    47\t}\n    48\t\n    49\texport function recoverDerivation(\n    50\t  db: DatabaseSync,\n    51\t  r: {\n    52\t    subjectKind: SubjectKind;\n    53\t    subjectId: string;\n    54\t    derivationType: DerivationType;\n    55\t    content: string;\n    56\t    metadata?: DerivationMetadata;\n    57\t    sourceVersion: number;\n    58\t    derivedAt: string;\n    59\t  },\n    60\t): { persisted: boolean } {\n    61\t  db.exec(\"BEGIN IMMEDIATE;\");\n    62\t  try {\n    63\t    if (hasLiveRecoveryWork(db, r)) {\n    64\t      db.exec(\"COMMIT;\");\n    65\t      return { persisted: false };\n    66\t    }\n    67\t    const changed = db\n    68\t      .prepare(\n    69\t        `UPDATE derivation\n    70\t         SET state = 'ready', content = ?, reason = NULL, metadata = ?,\n    71\t             gaps = NULL, derived_at = ?\n    72\t         WHERE subject_kind = ? AND subject_id = ? AND derivation_type = ?\n    73\t           AND source_version = ?\n    74\t           AND state IN ('pending', 'failed')`,\n    75\t      )\n    76\t      .run(\n    77\t        r.content,\n    78\t        r.metadata === undefined ? null : JSON.stringify(r.metadata),\n    79\t        r.derivedAt,\n    80\t        r.subjectKind,\n    81\t        r.subjectId,\n    82\t        r.derivationType,\n    83\t        r.sourceVersion,\n    84\t      );\n    85\t    db.exec(\"COMMIT;\");\n    86\t    return { persisted: Number(changed.changes) > 0 };\n    87\t  } catch (cause) {\n    88\t    db.exec(\"ROLLBACK;\");\n    89\t    throw cause;\n    90\t  }\n    91\t}\n","exit_code":0,"status":"completed"}}

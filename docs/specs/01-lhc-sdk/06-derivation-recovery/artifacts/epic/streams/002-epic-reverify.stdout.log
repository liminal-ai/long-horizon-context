{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/tool-result-rendering.test.ts | sed -n '1,130p'\"","aggregated_output":"     1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  countLiveItems,\n     4\t  createSdk,\n     5\t  threads,\n     6\t  type BatchResult,\n     7\t  type DerivationProvider,\n     8\t  type DrainReport,\n     9\t  type Lhc,\n    10\t  type MessageEventInput,\n    11\t} from \"../src/index.js\";\n    12\timport { truncateForFallback } from \"../src/shared/tool-result-rendering.js\";\n    13\timport {\n    14\t  createProviderDouble,\n    15\t  openRaw,\n    16\t  readDerivedForms,\n    17\t  tempStore,\n    18\t  validEvent,\n    19\t  type TempStore,\n    20\t} from \"./fixtures/index.js\";\n    21\t\n    22\tlet store: TempStore;\n    23\tbeforeEach(() => {\n    24\t  store = tempStore();\n    25\t});\n    26\tafterEach(() => {\n    27\t  store.cleanup();\n    28\t});\n    29\t\n    30\tasync function newThread(): Promise<string> {\n    31\t  const created = await threads.newThread({\n    32\t    filePath: store.threadPath(),\n    33\t    registryPath: store.registryPath,\n    34\t  });\n    35\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n    36\t  return created.value.filePath;\n    37\t}\n    38\t\n    39\tfunction sdkFor(provider: DerivationProvider): Lhc {\n    40\t  return createSdk({\n    41\t    provider,\n    42\t    mode: \"manual\",\n    43\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    44\t    lease: { durationMs: 200 },\n    45\t  });\n    46\t}\n    47\t\n    48\tasync function send(\n    49\t  sdk: Lhc,\n    50\t  filePath: string,\n    51\t  batch: readonly MessageEventInput[],\n    52\t): Promise<BatchResult> {\n    53\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    54\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n    55\t  return result.value;\n    56\t}\n    57\t\n    58\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n    59\t  const result = await sdk.work.drain({ filePath });\n    60\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n    61\t  return result.value;\n    62\t}\n    63\t\n    64\tfunction formOf(filePath: string, subjectId: string, derivationType: string) {\n    65\t  return readDerivedForms(filePath).find(\n    66\t    (f) => f.subjectId === subjectId && f.derivationType === derivationType,\n    67\t  );\n    68\t}\n    69\t\n    70\tfunction liveCount(filePath: string): number {\n    71\t  const db = openRaw(filePath);\n    72\t  try {\n    73\t    return countLiveItems(db);\n    74\t  } finally {\n    75\t    db.close();\n    76\t  }\n    77\t}\n    78\t\n    79\tdescribe(\"Story 2: tool-result rendering\", () => {\n    80\t  it(\"large tool results satisfy tool_result_summary by deterministic truncation with no work item\", async () => {\n    81\t    const double = createProviderDouble();\n    82\t    const captured = double.captureInputs();\n    83\t    const sdk = sdkFor(double);\n    84\t    const filePath = await newThread();\n    85\t    const content = \"result-token \".repeat(6000);\n    86\t\n    87\t    const batch = await send(sdk, filePath, [\n    88\t      validEvent(\"tool_call\", {\n    89\t        payload: { toolCallId: \"large\", toolName: \"read_file\", arguments: { path: \"huge.log\" } },\n    90\t      }),\n    91\t      validEvent(\"tool_result\", {\n    92\t        payload: { toolCallId: \"large\", content, isError: false },\n    93\t      }),\n    94\t    ]);\n    95\t\n    96\t    expect(batch.queuedWork).toEqual([]);\n    97\t    expect(captured).toEqual([]);\n    98\t    expect(liveCount(filePath)).toBe(0);\n    99\t    expect(formOf(filePath, \"m1\", \"tool_call_summary\")).toBeUndefined();\n   100\t    expect(formOf(filePath, \"m2\", \"tool_result_summary\")).toMatchObject({\n   101\t      state: \"ready\",\n   102\t      content: truncateForFallback(content),\n   103\t      metadata: { outcome: \"succeeded\" },\n   104\t    });\n   105\t\n   106\t    const listed = await sdk.messages.listMessages({ filePath });\n   107\t    expect(listed.ok).toBe(true);\n   108\t    if (!listed.ok) return;\n   109\t    expect(listed.value.find((m) => m.messageId === \"m2\")?.blocks[0]?.content[\"content\"]).toBe(\n   110\t      content,\n   111\t    );\n   112\t  });\n   113\t\n   114\t  it(\"in-threshold tool-result summaries run through queued inference with tier target and guidance\", async () => {\n   115\t    const double = createProviderDouble();\n   116\t    const captured = double.captureInputs();\n   117\t    const sdk = sdkFor(double);\n   118\t    const filePath = await newThread();\n   119\t\n   120\t    const small = \"small-result \".repeat(100);\n   121\t    const mid = \"mid-result \".repeat(1500);\n   122\t    const batch = await send(sdk, filePath, [\n   123\t      validEvent(\"tool_call\", {\n   124\t        payload: { toolCallId: \"small\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n   125\t      }),\n   126\t      validEvent(\"tool_result\", {\n   127\t        payload: { toolCallId: \"small\", content: small, isError: false },\n   128\t      }),\n   129\t      validEvent(\"tool_call\", {\n   130\t        payload: { toolCallId: \"mid\", toolName: \"grep\", arguments: { pattern: \"TODO\" } },\n","exit_code":0,"status":"completed"}}

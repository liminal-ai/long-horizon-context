nd: \\\\\\\\\\\\\\\"tool_result_summary\\\\\\\\\\\\\\\", sourceRef: { messageId: subjectId } };\\\\\\\\n    20\\\\\\\\t    }\\\\\\\\n    21\\\\\\\\t  }\\\\\\\\n    22\\\\\\\\t  if (subjectKind === \\\\\\\\\\\\\\\"turn\\\\\\\\\\\\\\\") {\\\\\\\\n    23\\\\\\\\t    if (derivationType === \\\\\\\\\\\\\\\"turn_rendering\\\\\\\\\\\\\\\" || derivationType === \\\\\\\\\\\\\\\"lower_band_projection\\\\\\\\\\\\\\\") {\\\\\\\\n    24\\\\\\\\t      return { kind: \\\\\\\\\\\\\\\"turn_derivation\\\\\\\\\\\\\\\", sourceRef: { turnId: subjectId } };\\\\\\\\n    25\\\\\\\\t    }\\\\\\\\n    26\\\\\\\\t  }\\\\\\\\n    27\\\\\\\\t  if (\\\\\\\\n    28\\\\\\\\t    subjectKind === \\\\\\\\\\\\\\\"chunk\\\\\\\\\\\\\\\" &&\\\\\\\\n    29\\\\\\\\t    (derivationType === \\\\\\\\\\\\\\\"chunk_summary_detailed\\\\\\\\\\\\\\\" || derivationType === \\\\\\\\\\\\\\\"chunk_summary_brief\\\\\\\\\\\\\\\")\\\\\\\\n    30\\\\\\\\t  ) {\\\\\\\\n    31\\\\\\\\t    return { kind: derivationType, sourceRef: { chunkId: subjectId } };\\\\\\\\n    32\\\\\\\\t  }\\\\\\\\n    33\\\\\\\\t  return undefined;\\\\\\\\n    34\\\\\\\\t}\\\\\\\\n    35\\\\\\\\t\\\\\\\\n    36\\\\\\\\texport function hasLiveRecoveryWork(\\\\\\\\n    37\\\\\\\\t  db: DatabaseSync,\\\\\\\\n    38\\\\\\\\t  r: {\\\\\\\\n    39\\\\\\\\t    subjectKind: SubjectKind;\\\\\\\\n    40\\\\\\\\t    subjectId: string;\\\\\\\\n    41\\\\\\\\t    derivationType: DerivationType;\\\\\\\\n    42\\\\\\\\t    sourceVersion: number;\\\\\\\\n    43\\\\\\\\t  },\\\\\\\\n    44\\\\\\\\t): boolean {\\\\\\\\n    45\\\\\\\\t  const target = workTargetFor(r.subjectKind, r.subjectId, r.derivationType);\\\\\\\\n    46\\\\\\\\t  return target !== undefined && hasLiveItem(db, target.kind, target.sourceRef, r.sourceVersion);\\\\\\\\n    47\\\\\\\\t}\\\\\\\\n    48\\\\\\\\t\\\\\\\\n    49\\\\\\\\texport function recoverDerivation(\\\\\\\\n    50\\\\\\\\t  db: DatabaseSync,\\\\\\\\n    51\\\\\\\\t  r: {\\\\\\\\n    52\\\\\\\\t    subjectKind: SubjectKind;\\\\\\\\n
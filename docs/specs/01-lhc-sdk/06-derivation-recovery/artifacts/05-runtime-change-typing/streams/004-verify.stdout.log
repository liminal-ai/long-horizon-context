n   198\\\\\\\\t    part.fallback && plan.form !== undefined && form !== undefined\\\\\\\\n   199\\\\\\\\t      ? {\\\\\\\\n   200\\\\\\\\t          subjectKind: \\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\",\\\\\\\\n   201\\\\\\\\t          subjectId: message.messageId,\\\\\\\\n   202\\\\\\\\t          derivationType: plan.form,\\\\\\\\n   203\\\\\\\\t          content: part.text,\\\\\\\\n   204\\\\\\\\t          sourceVersion: form.sourceVersion,\\\\\\\\n   205\\\\\\\\t          reason: form.state === \\\\\\\\\\\\\\\"failed\\\\\\\\\\\\\\\" ? \\\\\\\\\\\\\\\"failed_floor\\\\\\\\\\\\\\\" : \\\\\\\\\\\\\\\"not_ready\\\\\\\\\\\\\\\",\\\\\\\\n   206\\\\\\\\t          floorUsed: part.text,\\\\\\\\n   207\\\\\\\\t        }\\\\\\\\n   208\\\\\\\\t      : undefined;\\\\\\\\n   209\\\\\\\\t  return { atom, ...(gap === undefined ? {} : { gap }), ...(recovery === undefined ? {} : { recovery }) };\\\\\\\\n   210\\\\\\\\t}\\\\\\\\n   211\\\\\\\\t\\\\\\\\n   212\\\\\\\\tconst RUN_OUTCOME_ORDER: readonly ToolOutcome[] = [\\\\\\\\\\\\\\\"succeeded\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"failed\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"unknown\\\\\\\\\\\\\\\"];\\\\\\\\n   213\\\\\\\\t\\\\\\\\n   214\\\\\\\\t// The run's per-invocation outcome tally: each call counted once, plus any\\\\\\\\n   215\\\\\\\\t// result whose paired call sits outside this run (a cross-turn pair). Mixed\\\\\\\\n   216\\\\\\\\t// outcomes stay explicit; the run-level outcome is failed if any failed, else\\\\\\\\n   217\\\\\\\\t// unknown if any unknown, else succeeded.\\\\\\\\n   218\\\\\\\\tfunction tallyRun(members: readonly ComposeAtom[]): {\\\\\\\\n   219\\\\\\\\t  counts: Record<ToolOutcome, number>;\\\\\\\\n   220\\\\\\\\t  outcome: ToolOutcome;\\\\\\\\n   221\\\\\\\\t  callCount: number;\\\\\\\\n   222\\\\\\\\t  toolNames: string[];\\\\\\\\n   223\\\\\\\\t} {\\\\\\\\n   224\\\\\\\\t  const calls = members.filter((m) => m.part.kind === \\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\");\\\\\\\\n   225\\\\\\\\t  const callIds = ne
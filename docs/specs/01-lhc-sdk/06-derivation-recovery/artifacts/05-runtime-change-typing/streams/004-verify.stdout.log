{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/runtime-change-typing.test.ts | sed -n '1,170p'\"","aggregated_output":"     1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     2\timport {\n     3\t  createSdk,\n     4\t  messages,\n     5\t  threads,\n     6\t  type DerivationProvider,\n     7\t  type Lhc,\n     8\t  type MessageEventInput,\n     9\t} from \"../src/index.js\";\n    10\timport {\n    11\t  createProviderDouble,\n    12\t  tempStore,\n    13\t  validEvent,\n    14\t  type TempStore,\n    15\t} from \"./fixtures/index.js\";\n    16\t\n    17\tlet store: TempStore;\n    18\tbeforeEach(() => {\n    19\t  store = tempStore();\n    20\t});\n    21\tafterEach(() => {\n    22\t  store.cleanup();\n    23\t});\n    24\t\n    25\tasync function newThread(): Promise<string> {\n    26\t  const created = await threads.newThread({\n    27\t    filePath: store.threadPath(),\n    28\t    registryPath: store.registryPath,\n    29\t  });\n    30\t  if (!created.ok) throw new Error(created.error.reason);\n    31\t  return created.value.filePath;\n    32\t}\n    33\t\n    34\tfunction sdkFor(provider: DerivationProvider): Lhc {\n    35\t  return createSdk({\n    36\t    provider,\n    37\t    mode: \"manual\",\n    38\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    39\t    lease: { durationMs: 200 },\n    40\t  });\n    41\t}\n    42\t\n    43\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n    44\t  const sdk = sdkFor(createProviderDouble());\n    45\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    46\t  if (!result.ok) throw new Error(result.error.reason);\n    47\t}\n    48\t\n    49\tdescribe(\"Story 5: runtime-change typing\", () => {\n    50\t  it(\"projects model changes as typed model_change blocks\", async () => {\n    51\t    const filePath = await newThread();\n    52\t\n    53\t    await send(filePath, [\n    54\t      validEvent(\"model_change\", {\n    55\t        payload: { previousModel: \"gpt-5\", newModel: \"gpt-5.1\" },\n    56\t      }),\n    57\t    ]);\n    58\t\n    59\t    const listed = await messages.listMessages({ filePath });\n    60\t    expect(listed.ok).toBe(true);\n    61\t    if (!listed.ok) return;\n    62\t    expect(listed.value).toHaveLength(1);\n    63\t    expect(listed.value[0]?.kind).toBe(\"model_change\");\n    64\t    expect(listed.value[0]?.blocks).toEqual([\n    65\t      {\n    66\t        blockType: \"model_change\",\n    67\t        content: { previousModel: \"gpt-5\", newModel: \"gpt-5.1\" },\n    68\t      },\n    69\t    ]);\n    70\t  });\n    71\t\n    72\t  it(\"projects thinking-level changes as typed thinking_level_change blocks\", async () => {\n    73\t    const filePath = await newThread();\n    74\t\n    75\t    await send(filePath, [\n    76\t      validEvent(\"thinking_level_change\", {\n    77\t        payload: { previousLevel: \"medium\", newLevel: \"high\" },\n    78\t      }),\n    79\t    ]);\n    80\t\n    81\t    const listed = await messages.listMessages({ filePath });\n    82\t    expect(listed.ok).toBe(true);\n    83\t    if (!listed.ok) return;\n    84\t    expect(listed.value).toHaveLength(1);\n    85\t    expect(listed.value[0]?.kind).toBe(\"thinking_level_change\");\n    86\t    expect(listed.value[0]?.blocks).toEqual([\n    87\t      {\n    88\t        blockType: \"thinking_level_change\",\n    89\t        content: { previousLevel: \"medium\", newLevel: \"high\" },\n    90\t      },\n    91\t    ]);\n    92\t  });\n    93\t\n    94\t  it(\"places typed runtime-change blocks verbatim in constructed turns in stream order\", async () => {\n    95\t    const double = createProviderDouble();\n    96\t    const captured = double.captureInputs();\n    97\t    const sdk = sdkFor(double);\n    98\t    const filePath = await newThread();\n    99\t    const modelBlock = { previousModel: \"gpt-5\", newModel: \"gpt-5.1\" };\n   100\t    const thinkingBlock = { previousLevel: \"medium\", newLevel: \"high\" };\n   101\t\n   102\t    const intake = await sdk.intakeStream.messageEvents({ filePath }, [\n   103\t      validEvent(\"user_prompt\", { payload: { text: \"runtime order\" } }),\n   104\t      validEvent(\"model_change\", { payload: modelBlock }),\n   105\t      validEvent(\"thinking_level_change\", { payload: thinkingBlock }),\n   106\t      validEvent(\"assistant_text\", { payload: { text: \"answer\" } }),\n   107\t      validEvent(\"turn_end\"),\n   108\t    ]);\n   109\t    expect(intake.ok).toBe(true);\n   110\t    if (!intake.ok) return;\n   111\t\n   112\t    const drained = await sdk.work.drain({ filePath });\n   113\t    expect(drained.ok).toBe(true);\n   114\t    if (!drained.ok) return;\n   115\t\n   116\t    const rendering = captured.find((entry) => entry.op === \"composeTurnRendering\");\n   117\t    const parts =\n   118\t      (rendering?.input as\n   119\t        | {\n   120\t            parts?: Array<{\n   121\t              kind: string;\n   122\t              fallback: boolean;\n   123\t              blocks?: Array<{ blockType: string; content: Record<string, unknown> }>;\n   124\t            }>;\n   125\t          }\n   126\t        | undefined)?.parts ?? [];\n   127\t\n   128\t    expect(parts.map((part) => part.kind)).toEqual([\n   129\t      \"user_prompt\",\n   130\t      \"model_change\",\n   131\t      \"thinking_level_change\",\n   132\t      \"assistant_text\",\n   133\t    ]);\n   134\t    expect(parts[1]).toMatchObject({\n   135\t      kind: \"model_change\",\n   136\t      fallback: false,\n   137\t      blocks: [{ blockType: \"model_change\", content: modelBlock }],\n   138\t    });\n   139\t    expect(parts[2]).toMatchObject({\n   140\t      kind: \"thinking_level_change\",\n   141\t      fallback: false,\n   142\t      blocks: [{ blockType: \"thinking_level_change\", content: thinkingBlock }],\n   143\t    });\n   144\t  });\n   145\t});\n","exit_code":0,"status":"completed"}}

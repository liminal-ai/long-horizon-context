{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/index.ts | sed -n '1,60p'\"","aggregated_output":"     1\timport type { OpResult } from \"../../shared/errors.js\";\n     2\timport type {\n     3\t  WorkKind,\n     4\t  WorkOwner,\n     5\t  WorkSourceRef,\n     6\t} from \"../../tech-utils/work-queue/index.js\";\n     7\timport type { ThreadRef } from \"../threads/index.js\";\n     8\timport { runListEvents, runMessageEvents } from \"./internal/pipeline.js\";\n     9\t\n    10\tinterface BaseEvent<K extends string, P> {\n    11\t  eventKind: K;\n    12\t  idempotencyKey: string;\n    13\t  actor: string; // non-empty\n    14\t  harness: string; // non-empty\n    15\t  payload: P; // shape fixed by kind, closed\n    16\t}\n    17\t\n    18\texport type MessageEventInput =\n    19\t  | BaseEvent<\"user_prompt\", { text: string }>\n    20\t  | BaseEvent<\"assistant_text\", { text: string }>\n    21\t  | BaseEvent<\"assistant_thinking\", { text: string }>\n    22\t  | BaseEvent<\"runtime_note\", { text: string }>\n    23\t  | BaseEvent<\"model_change\", { previousModel: string; newModel: string }>\n    24\t  | BaseEvent<\"thinking_level_change\", { previousLevel: string; newLevel: string }>\n    25\t  | BaseEvent<\n    26\t      \"tool_call\",\n    27\t      { toolCallId: string; toolName: string; arguments: Record<string, unknown> }\n    28\t    >\n    29\t  | BaseEvent<\"tool_result\", { toolCallId: string; content: string; isError?: boolean }>\n    30\t  | BaseEvent<\"turn_end\", Record<string, never>>;\n    31\t\n    32\t// Derived, not parallel-maintained: the kind list cannot drift from the union.\n    33\texport type EventKind = MessageEventInput[\"eventKind\"];\n    34\t\n    35\texport interface BatchResult {\n    36\t  events: Array<{\n    37\t    idempotencyKey: string;\n    38\t    outcome: \"recorded\" | \"skipped\";\n    39\t    messageId?: string;\n    40\t    skipReason?: \"duplicate_idempotency_key\";\n    41\t  }>;\n    42\t  turnTransitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    43\t  queuedWork: Array<{\n    44\t    workItemId: string;\n    45\t    owner: WorkOwner;\n    46\t    kind: WorkKind;\n    47\t    sourceRef: WorkSourceRef;\n    48\t  }>;\n    49\t  threadPosition: { lastEventOrder: number };\n    50\t}\n    51\t\n    52\t// Read-back preserves the discrimination: intersecting the input union with\n    53\t// server fields distributes over its members, so a narrowed eventKind narrows\n    54\t// the payload on read exactly as it does on write.\n    55\texport type EventRecord = MessageEventInput & {\n    56\t  eventOrder: number;\n    57\t  recordedAt: string;\n    58\t};\n    59\t\n    60\texport async function messageEvents(\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/internal/validate.ts | sed -n '1,190p'\"","aggregated_output":"     1\t// Flow 4: pure, whole-batch, three-layer closed validation. Strictness falls\n     2\t// out of schema construction: every layer is a closed Effect Schema struct\n     3\t// decoded under onExcessProperty: \"error\", so unknown-field rejection is a\n     4\t// property of the definitions, not a remembered rule. Validation never touches\n     5\t// a database; a rejected batch costs no write lock.\n     6\timport { Either, ParseResult, Schema } from \"effect\";\n     7\timport type { ErrorResult } from \"../../../shared/errors.js\";\n     8\t\n     9\texport const EVENT_KINDS = [\n    10\t  \"user_prompt\",\n    11\t  \"assistant_text\",\n    12\t  \"assistant_thinking\",\n    13\t  \"runtime_note\",\n    14\t  \"model_change\",\n    15\t  \"thinking_level_change\",\n    16\t  \"tool_call\",\n    17\t  \"tool_result\",\n    18\t  \"turn_end\",\n    19\t] as const;\n    20\t\n    21\t// Denied by name with their own reason string: the old MVP's\n    22\t// silent-root-field-drop bug class gets named when it appears.\n    23\tconst SERVER_GENERATED_FIELDS = [\n    24\t  \"eventOrder\",\n    25\t  \"recordedAt\",\n    26\t  \"threadEventId\",\n    27\t  \"schemaVersion\",\n    28\t] as const;\n    29\t\n    30\tconst DECODE_OPTIONS = { onExcessProperty: \"error\", errors: \"first\" } as const;\n    31\t\n    32\tconst NonEmptyString = Schema.String.pipe(Schema.minLength(1));\n    33\t\n    34\t// Layer 1 — envelope: thread reference shape, closed.\n    35\tconst ThreadRefSchema = Schema.Union(\n    36\t  Schema.Struct({\n    37\t    threadId: NonEmptyString,\n    38\t    registryPath: Schema.optional(Schema.String),\n    39\t  }),\n    40\t  Schema.Struct({ filePath: NonEmptyString }),\n    41\t);\n    42\t\n    43\t// Layer 2 — event object: the five required fields, closed. payload presence\n    44\t// and shape are layer 3's job (Schema.Unknown keeps the key from reading as\n    45\t// an unexpected field here, and tolerates a missing key — presence is checked\n    46\t// explicitly below).\n    47\tconst EventEnvelopeSchema = Schema.Struct({\n    48\t  eventKind: Schema.Literal(...EVENT_KINDS),\n    49\t  idempotencyKey: NonEmptyString,\n    50\t  actor: NonEmptyString,\n    51\t  harness: NonEmptyString,\n    52\t  payload: Schema.Unknown,\n    53\t});\n    54\t\n    55\t// Layer 3 — per-kind payload, closed. turn_end's empty-payload rule is its\n    56\t// own named check below (a closed Struct({}) admits any object).\n    57\tconst TextPayloadSchema = Schema.Struct({ text: Schema.String });\n    58\tconst ModelChangePayloadSchema = Schema.Struct({\n    59\t  previousModel: NonEmptyString,\n    60\t  newModel: NonEmptyString,\n    61\t});\n    62\tconst ThinkingLevelChangePayloadSchema = Schema.Struct({\n    63\t  previousLevel: NonEmptyString,\n    64\t  newLevel: NonEmptyString,\n    65\t});\n    66\tconst ToolCallPayloadSchema = Schema.Struct({\n    67\t  toolCallId: NonEmptyString,\n    68\t  toolName: NonEmptyString,\n    69\t  arguments: Schema.Record({ key: Schema.String, value: Schema.Unknown }),\n    70\t});\n    71\tconst ToolResultPayloadSchema = Schema.Struct({\n    72\t  toolCallId: NonEmptyString,\n    73\t  content: Schema.String,\n    74\t  isError: Schema.optional(Schema.Boolean),\n    75\t});\n    76\t\n    77\tfunction firstIssue(error: ParseResult.ParseError): string {\n    78\t  const issues = ParseResult.ArrayFormatter.formatErrorSync(error);\n    79\t  const issue = issues[0];\n    80\t  if (issue === undefined) return \"invalid value\";\n    81\t  if (issue.path.length === 0) return issue.message;\n    82\t  return `\"${issue.path.join(\".\")}\" ${issue.message}`;\n    83\t}\n    84\t\n    85\tfunction decodeIssue<A, I>(schema: Schema.Schema<A, I, never>, value: unknown): string | undefined {\n    86\t  const decoded = Schema.decodeUnknownEither(schema, DECODE_OPTIONS)(value);\n    87\t  return Either.isLeft(decoded) ? firstIssue(decoded.left) : undefined;\n    88\t}\n    89\t\n    90\tfunction callerError(reason: string, eventIndex?: number): ErrorResult {\n    91\t  const error: ErrorResult = {\n    92\t    errorClass: \"caller_error\",\n    93\t    code: \"invalid_event\",\n    94\t    reason,\n    95\t  };\n    96\t  if (eventIndex !== undefined) error.eventIndex = eventIndex;\n    97\t  return error;\n    98\t}\n    99\t\n   100\t// Envelope-level: the thread reference must decode against the closed union.\n   101\t// Returns undefined when valid.\n   102\texport function validateThreadRef(ref: unknown): ErrorResult | undefined {\n   103\t  const issue = decodeIssue(ThreadRefSchema, ref);\n   104\t  if (issue !== undefined) {\n   105\t    return callerError(`envelope: invalid thread reference — ${issue}`);\n   106\t  }\n   107\t  return undefined;\n   108\t}\n   109\t\n   110\t// Whole-batch validation: array order, first failure wins (AC-4.5). Returns\n   111\t// undefined when every event is valid.\n   112\texport function validateEvents(events: unknown): ErrorResult | undefined {\n   113\t  if (!Array.isArray(events)) {\n   114\t    return callerError(\"envelope: events must be a JSON array\");\n   115\t  }\n   116\t  if (events.length === 0) {\n   117\t    return {\n   118\t      errorClass: \"caller_error\",\n   119\t      code: \"empty_batch\",\n   120\t      reason: \"envelope: events array is empty; a batch must carry at least one event\",\n   121\t    };\n   122\t  }\n   123\t  for (const [index, event] of events.entries()) {\n   124\t    const failure = validateOneEvent(event, index);\n   125\t    if (failure !== undefined) return failure;\n   126\t  }\n   127\t  return undefined;\n   128\t}\n   129\t\n   130\tfunction validateOneEvent(event: unknown, index: number): ErrorResult | undefined {\n   131\t  if (typeof event !== \"object\" || event === null || Array.isArray(event)) {\n   132\t    return callerError(\"event: each event must be a JSON object\", index);\n   133\t  }\n   134\t  const record = event as Record<string, unknown>;\n   135\t\n   136\t  for (const field of SERVER_GENERATED_FIELDS) {\n   137\t    if (field in record) {\n   138\t      return callerError(\n   139\t        `event: server-generated field \"${field}\" must not be supplied by the caller`,\n   140\t        index,\n   141\t      );\n   142\t    }\n   143\t  }\n   144\t\n   145\t  const kind = record[\"eventKind\"];\n   146\t  if (typeof kind === \"string\" && !(EVENT_KINDS as readonly string[]).includes(kind)) {\n   147\t    return callerError(`event: unknown event kind \"${kind}\"`, index);\n   148\t  }\n   149\t\n   150\t  const envelope = Schema.decodeUnknownEither(EventEnvelopeSchema, DECODE_OPTIONS)(event);\n   151\t  if (Either.isLeft(envelope)) {\n   152\t    return callerError(`event: ${firstIssue(envelope.left)}`, index);\n   153\t  }\n   154\t\n   155\t  const payload = record[\"payload\"];\n   156\t  if (typeof payload !== \"object\" || payload === null || Array.isArray(payload)) {\n   157\t    return callerError(\"event: payload must be a JSON object\", index);\n   158\t  }\n   159\t\n   160\t  if (envelope.right.eventKind === \"turn_end\") {\n   161\t    const extraKeys = Object.keys(payload);\n   162\t    if (extraKeys.length > 0) {\n   163\t      return callerError(\n   164\t        `payload: turn_end events carry an empty payload; found field \"${extraKeys[0]}\"`,\n   165\t        index,\n   166\t      );\n   167\t    }\n   168\t    return undefined;\n   169\t  }\n   170\t\n   171\t  let issue: string | undefined;\n   172\t  switch (envelope.right.eventKind) {\n   173\t    case \"tool_call\":\n   174\t      issue = decodeIssue(ToolCallPayloadSchema, payload);\n   175\t      break;\n   176\t    case \"tool_result\":\n   177\t      issue = decodeIssue(ToolResultPayloadSchema, payload);\n   178\t      break;\n   179\t    case \"model_change\":\n   180\t      issue = decodeIssue(ModelChangePayloadSchema, payload);\n   181\t      break;\n   182\t    case \"thinking_level_change\":\n   183\t      issue = decodeIssue(ThinkingLevelChangePayloadSchema, payload);\n   184\t      break;\n   185\t    default:\n   186\t      issue = decodeIssue(TextPayloadSchema, payload);\n   187\t      break;\n   188\t  }\n   189\t  if (issue !== undefined) {\n   190\t    return callerError(`payload: ${issue}`, index);\n","exit_code":0,"status":"completed"}}

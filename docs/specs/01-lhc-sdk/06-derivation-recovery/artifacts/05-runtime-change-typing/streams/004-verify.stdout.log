nothing; either way the item is terminal against a source\\\\\\\\n   162\\\\\\\\t    // that cannot improve.\\\\\\\\n   163\\\\\\\\t    return sourceDamaged(`turn ${turnId} not found`);\\\\\\\\n   164\\\\\\\\t  }\\\\\\\\n   165\\\\\\\\t  if (turn.status !== \\\\\\\\\\\\\\\"closed\\\\\\\\\\\\\\\") {\\\\\\\\n   166\\\\\\\\t    // Derivation is queued only at close; an open turn under a queued item\\\\\\\\n   167\\\\\\\\t    // means the record was interfered with.\\\\\\\\n   168\\\\\\\\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\\\\\\\\n   169\\\\\\\\t  }\\\\\\\\n   170\\\\\\\\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\\\\\\\\n   171\\\\\\\\t  // batch pipeline writes turn state and it never leaves two turns open, so\\\\\\\\n   172\\\\\\\\t  // more than one open turn means the record was damaged below the SDK. A\\\\\\\\n   173\\\\\\\\t  // handler must not compose against a membership it cannot trust; the form\\\\\\\\n   174\\\\\\\\t  // lands blocked naming the damage, and requeue refuses with that reason\\\\\\\\n   175\\\\\\\\t  // until the source reads clean (Story 4).\\\\\\\\n   176\\\\\\\\t  const openTurnIds = selectOpenTurnIds(db);\\\\\\\\n   177\\\\\\\\t  if (openTurnIds.length > 1) {\\\\\\\\n   178\\\\\\\\t    return sourceDamaged(\\\\\\\\n   179\\\\\\\\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\")})`,\\\\\\\\n   180\\\\\\\\t    );\\\\\\\\n   181\\\\\\\\t  }\\\\\\\\n   182\\\\\\\\t\\\\\\\\n   183\\\\\\\\t  // Compose from current message-form states: ready forms verbatim,\\\\\\\\n   184\\\\\\\\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\\\\\\\\n   185\\\\\\\\t  // before any provider call, and no transaction is held across them.\\\\\\\\n   186\\\\\\\\t  const messages = readMemberMessages(db, turnId);\\\\\\\\n   187\\\\\\\\t  const forms = readMessageFormRows(\\\\\\\\n   188\\\\\\\\t    db,\\\\\\\\n   189\\\\\\\\t    messages.map((message) => message.messageId),\\\\\\\\n   190\\\\\\\\t  );\\\\\\\\n   191\\\\\\\\t  await recoverMessageForms(run, messages, forms);\\\\\\\\n   192\\\\\\\\t  const { parts, receipts, recoveries } = composeRenderingInput(messages, forms);\\\\\\\\n   193\\\\\\\\t  for (const recovery of recoveries) {\\\\\\\\n   194\\\\\\\\t    logFallback(run, {\\\\\\\\n   195\\\\\\\\t      derivationType: recovery.derivationType,\\\\\\\\n   196\\\\\\\\t      subjectId: recovery.subjectId,\\\\\\\\n   197\\\\\\\\t      reason: recovery.reason,\\\\\\\\n   198\\\\\\\\t      floorUsed: recovery.floorUsed,\\\\\\\\n   199\\\\\\\\t    });\\\\\\\\n   200\\\\\\\\t    recoverDerivation(run.openDb(), {\\\\\\\\n   201\\\\\\\\t      subjectKind: recovery.subjectKind,\\\\\\\\n   202\\\\\\\\t      subjectId: recovery.subjectId,\\\\\\\\n   203\\\\\\\\t      derivationType: recovery.derivationType,\\\\\\\\n   204\\\\\\\\t      content: recovery.content,\\\\\\\\n   205\\\\\\\\t      sourceVersion: recovery.sourceVersion,\\\\\\\\n   206\\\\\\\\t      derivedAt: run.clock().toISOString(),\\\\\\\\n   207\\\\\\\\t    });\\\\\\\\n   208\\\\\\\\t  }\\\\\\\\n   209\\\\\\\\t\\\\\\\\n   210\\\\\\\\t  const rendering = await run.provider.composeTurnRendering({ parts });\\\\\\\\n   211\\\\\\\\t  if (!rendering.ok) return providerFailed(rendering);\\\\\\\\n   212\\\\\\\\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\\\\\\\\n   213\\\\\\\\t  if (!projection.ok) return providerFailed(projection);\\\\\\\\n   214\\\\\\\\t\\\\\\\\n   215\\\\\\\\t  // The projection's token count is estimated exactly once, here, as the\\\\\\\\n   216\\\\\\\\t  // artifact lands; placement reads this stored arithmetic and never\\\\\\\\n   217\\\\\\\\t  // re-counts (AC-3.9's determinism input).\\\\\\\\n   218\\\\\\\\t  const projectedTokens = estimateTokens(projection.text);\\\\\\\\n   219\\\\\\\\t  const threadId = readThreadId(run);\\\\\\\\n   220\\\\\\\\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\\\\\\\\n   221\\\\\\\\t  // from the composition input (AC-3.8) — the chunk summaries read them from\\\\\\\\n   222\\\\\\\\t  // here, never from provider prose. Provenance is copied from the provider\\\\\\\\n   223\\\\\\\\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\\\\\\\\n   224\\\\\\\\t  // deterministic provider sets none.\\\\\\\\n   225\\\\\\\\t  const renderingMetadata: DerivationMetadata = {\\\\\\\\n   226\\\\\\\\t    ...(receipts.length > 0 ? { receipts } : {}),\\\\\\\\n   227\\\\\\\\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\\\\\\\\n   228\\\\\\\\t  };\\\\\\\\n   229\\\\\\\\t\\\\\\\\n   230\\\\\\\\t  return {\\\\\\\\n   231\\\\\\\\t    ok: true,\\\\\\\\n   232\\\\\\\\t    derivations: [\\\\\\\\n   233\\\\\\\\t      {\\\\\\\\n   234\\\\\\\\t        subjectKind: \\\\\\\\\\\\\\\"turn\\\\\\\\\\\\\\\",\\\\\\\\n   235\\\\\\\\t        subjectId: turnId,\\\\\\\\n   236\\\\\\\\t        derivationType: \\\\\\\\\\\\\\\"turn_rendering\\\\\\\\\\\\\\\",\\\\\\\\n   237\\\\\\\\t        content: rendering.text,\\\\\\\\n   238\\\\\\\\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\\\\\\\\n   239\\\\\\\\t      },\\\\\\\\n   240\\\\\\\\t      {\\\\\\\\n   241\\\\\\\\t        subjectKind: \\\\\\\\\\\\\\\"turn\\\\\\\\\\\\\\\",\\\\\\\\n   242\\\\\\\\t        subjectId: turnId,\\\\\\\\n   243\\\\\\\\t        derivationType: \\\\\\\\\\\\\\\"lower_band_projection\\\\\\\\\\\\\\\",\\\\\\\\n   244\\\\\\\\t        content: projection.text,\\\\\\\\n   245\\\\\\\\t        ...(projection.provenance === undefined\\\\\\\\n   246\\\\\\\\t          ? {}\\\\\\\\n   247\\\\\\\\t          : { metadata: { provenance: projection.provenance } }),\\\\\\\\n   248\\\\\\\\t      },\\\\\\\\n   249\\\\\\\\t    ],\\\\\\\\n   250\\\\\\\\t    onApplied: (tx) => {\\\\\\\\n   251\\\\\\\\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\\\\\\\\n   252\\\\\\\\t      for (const chunkId of placement.closedChunkIds) {\\\\\\\\n   253\\\\\\\\t        enqueueChunkSummaries(\\\\\\\\n   254\\\\\\\\t          {\\\\\\\\n   255\\\\\\\\t            db: tx.db,\\\\\\\\n   256\\\\\\\\t            clock: run.clock,\\\\\\\\n   257\\\\\\\\t            threadId,\\\\\\\\n   258\\\\\\\\t            onCommit: tx.onCommit,\\\\\\\\n   259\\\\\\\\t            poke: resolveInstancePoke(),\\\\\\\\n   260\\\\\\\\t          },\\\\\\\\n   261\\\\\\\\t          chunkId,\\\\\\\\n   262\\\\\\\\t        );\\\\\\\\n   263\\\\\\\\t      }\\\\\\\\n   264\\\\\\\\t    },\\\\\\\\n   265\\\\\\\\t  };\\\\\\\\n   266\\\\\\\\t};\\\\\\\\n   267\\\\\\\\t\\\\\\\\n   268\\\\\\\\t// One read for both summary kinds — member projections in turn order — but\\\\\\\\n   269\\\\\\\\t// two contracts at the provider seam (AC-3.8): detailed receives the\\\\\\\\n   270\\\\\\\\t// members' tool-run receipts (what changed, outcome) read from the\\\\\\\\n   271\\\\\\\\t// renderings' stamped metadata; brief receives outcomes only, the receipt\\\\\\\\n   272\\\\\\\\t// text stripped here so the brief provider call structurally cannot carry\\\\\\\\n   273\\\\\\\\t// it. Two work items, two handlers' runs, independent retry and states. A\\\\\\\\n   274\\\\\\\\t// member whose projection is not ready falls back to nothing and records a\\\\\\\\n   275\\\\\\\\t// gap, mirroring the rendering's fallback rule.\\\\\\\\n   276\\\\\\\\tfunction chunkSummaryHandler(\\\\\\\\n   277\\\\\\\\t  kind: \\\\\\\\\\\\\\\"chunk_summary_detailed\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"chunk_summary_brief\\\\\\\\\\\\\\\",\\\\\\\\n   278\\\\\\\\t): WorkHandler {\\\\\\\\n   279\\\\\\\\t  return async (run, item) => {\\\\\\\\n   280\\\\\\\\t    const chunkId = item.sourceRef[\\\\\\\\\\\\\\\"chunkId\\\\\\\\\\\\\\\"];\\\\\\\\n   281\\\\\\\\t    if (chunkId === undefined) return sourceDamaged(\\\\\\\\\\\\\\\"work item carries no chunkId\\\\\\\\\\\\\\\");\\\\\\\\n   282\\\\\\\\t    const db = run.openDb();\\\\\\\\n   283\\\\\\\\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\\\\\\\\n   284\\\\\\\\t\\\\\\\\n   285\\\\\\\\t    const members = readMemberProjections(db, chunkId);\\\\\\\\n   286\\\\\\\\t    const memberProjections: string[] = [];\\\\\\\\n   287\\\\\\\\t    for (const member of members) {\\\\\\\\n   288\\\\\\\\t      if (member.state === \\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\" && member.content !== undefined) {\\\\\\\\n   289\\\\\\\\t        memberProjections.push(member.content);\\\\\\\\n   290\\\\\\\\t      } else {\\\\\\\\n   291\\\\\\\\t        memberProjections.push(\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");\\\\\\\\n   292\\\\\\\\t        logFallback(run, {\\\\\\\\n   293\\\\\\\\t          subjectId: member.turnId,\\\\\\\\n   294\\\\\\\\t          derivationType: \\\\\\\\\\\\\\\"lower_band_projection\\\\\\\\\\\\\\\",\\\\\\\\n   295\\\\\\\\t          reason: member.state === \\\\\\\\\\\\\\\"failed\\\\\\\\\\\\\\\" ? \\\\\\\\\\\\\\\"failed_floor\\\\\\\\\\\\\\\" : \\\\\\\\\\\\\\\"not_ready\\\\\\\\\\\\\\\",\\\\\\\\n   296\\\\\\\\t          floorUsed: \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\n   297\\\\\\\\t        });\\\\\\\\n   298\\\\\\\\t      }\\\\\\\\n   299\\\\\\\\t    }\\\\\\\\n   300\\\\\\\\t\\\\\\\\n   301\\\\\\\\t    const result =\\\\\\\\n   302\\\\\\\\t      kind === \\\\\\\\\\\\\\\"chunk_summary_detailed\\\\\\\\\\\\\\\"\\\\\\\\n   303\\\\\\\\t        ? await run.provider.summarizeChunkDetailed({\\\\\\\\n   304\\\\\\\\t            memberProjections,\\\\\\\\n   305\\\\\\\\t            memberReceipts: members.map((member) => member.receipts),\\\\\\\\n   306\\\\\\\\t          })\\\\\\\\n   307\\\\\\\\t        : await run.provider.summarizeChunkBrief({\\\\\\\\n   308\\\\\\\\t            memberProjections,\\\\\\\\n   309\\\\\\\\t            memberOutcomes: members.map((member) =>\\\\\\\\n   310\\\\\\\\t              member.receipts.map((receipt) => receipt.outcome),\\\\\\\\n   311\\\\\\\\t            ),\\\\\\\\n   312\\\\\\\\t          });\\\\\\\\n   313\\\\\\\\t    if (!result.ok) return providerFailed(result);\\\\\\\\n   314\\\\\\\\t\\\\\\\\n   315\\\\\\\\t    return {\\\\\\\\n   316\\\\\\\\t      ok: true,\\\\\\\\n   317\\\\\\\\t      derivations: [\\\\\\\\n   318\\\\\\\\t        {\\\\\\\\n   319\\\\\\\\t          subjectKind: \\\\\\\\\\\\\\\"chunk\\\\\\\\\\\\\\\",\\\\\\\\n   320\\\\\\\\t          subjectId: chunkId,\\\\\\\\n   321\\\\\\\\t          derivationType: kind,\\\\\\\\n   322\\\\\\\\t          content: result.text,\\\\\\\\n   323\\\\\\\\t          ...(result.provenance === undefined\\\\\\\\n   324\\\\\\\\t            ? {}\\\\\\\\n   325\\\\\\\\t            : { metadata: { provenance: result.provenance } }),\\\\\\\\n   326\\\\\\\\t        },\\\\\\\\n   327\\\\\\\\t      ],\\\\\\\\n   328\\\\\\\\t    };\\\\\\\\n   329\\\\\\\\t  };\\\\\\\\n   330\\\\\\\\t}\\\\\\\\n   331\\\\\\\\t\\\\\\\\n   332\\\\\\\\t// The domain's handler table, merged into the SDK dispatch map at\\\\\\\\n   333\\\\\\\\t// construction (DD-6).\\\\\\\\n   334\\\\\\\\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\\\\\\\\n   335\\\\\\\\t  turn_derivation: turnDerivationHandler,\\\\\\\\n   336\\\\\\\\t  chunk_summary_detailed: chunkSummaryHandler(\\\\\\\\\\\\\\\"chunk_summary_detailed\\\\\\\\\\\\\\\"),\\\\\\\\n   337\\\\\\\\t  chunk_summary_brief: chunkSummaryHandler(\\\\\\\\\\\\\\\"chunk_summary_brief\\\\\\\\\\\\\\\"),\\\\\\\\n   338\\\\\\\\t};\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/specs/01-lhc-sdk/06-derivation-recovery/artifacts/03-turn-construction-recovery-cascade/streams/004-verify.stdout.log:32:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_14\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/internal/compose.ts'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\\\\\\\\n     2\\\\\\\\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\\\\\\\\n     3\\\\\\\\t// gap records where a form is not ready. Pure by anti-shim requirement —\\\\\\\\n     4\\\\\\\\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\\\\\\\\n     5\\\\\\\\t// clock in the signature: determinism is structural, not disciplined.\\\\\\\\n     6\\\\\\\\t//\\\\\\\\n     7\\\\\\\\t// Tool activity stays in message order and groups into runs (AC-3.4, Fix 2):\\\\\\\\n     8\\\\\\\\t// a maximal stretch of consecutive tool_call/tool_result messages folds into\\\\\\\\n     9\\\\\\\\t// ONE RenderingPart and ONE receipt — a run-level account naming the tools,\\\\\\\\n    10\\\\\\\\t// the call count, and the per-call mechanical outcomes, so a run containing a\\\\\\\\n    11\\\\\\\\t// state-changing call structurally cannot lose its outcome and mixed outcomes\\\\\\\\n    12\\\\\\\\t// stay explicit, never collapsed into a vague success. Prompts and assistant\\\\\\\\n    13\\\\\\\\t// text break a run; thinking and runtime notes do not (interior ones ride the\\\\\\\\n    14\\\\\\\\t// run account inline, edge ones stand alone) — a story-deviation decision.\\\\\\\\n    15\\\\\\\\t// Runs are never reordered to make accounts tidier; the outcome rides the\\\\\\\\n    16\\\\\\\\t// part, not the prose.\\\\\\\\n    17\\\\\\\\timport type {\\\\\\\\n    18\\\\\\\\t  DependencyGap,\\\\\\\\n    19\\\\\\\\t  DerivationMetadata,\\\\\\\\n    20\\\\\\\\t  DerivationState,\\\\\\\\n    21\\\\\\\\t  DerivationType,\\\\\\\\n    22\\\\\\\\t  RenderingPart,\\\\\\\\n    23\\\\\\\\t  RenderingPartKind,\\\\\\\\n    24\\\\\\\\t  ToolOutcome,\\\\\\\\n    25\\\\\\\\t  ToolRunReceipt,\\\\\\\\n    26\\\\\\\\t} from \\\\\\\\\\\\\\\"../../../shared/derivation.js\\\\\\\\\\\\\\\";\\\\\\\\n    27\\\\\\\\timport { truncateForFallback } from \\\\\\\\\\\\\\\"../../../shared/tool-result-rendering.js\\\\\\\\\\\\\\\";\\\\\\\\n    28\\\\\\\\timport { cleanPrompt } from \\\\\\\\\\\\\\\"../../messages/index.js\\\\\\\\\\\\\\\";\\\\\\\\n    29\\\\\\\\t\\\\\\\\n    30\\\\\\\\t// The member message as the composer sees it: kind plus projected blocks,\\\\\\\\n    31\\\\\\\\t// verbatim from the record (already deleted-filtered by the caller's read).\\\\\\\\n    32\\\\\\\\texport interface ComposeMessage {\\\\\\\\n    33\\\\\\\\t  messageId: string;\\\\\\\\n    34\\\\\\\\t  kind: RenderingPartKind;\\\\\\\\n    35\\\\\\\\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\\\\\\\\n    36\\\\\\\\t}\\\\\\\\n    37\\\\\\\\t\\\\\\\\n    38\\\\\\\\t// One message-owned form row as composition input; keyed by the caller as\\\\\\\\n    39\\\\\\\\t// `${messageId}/${form}`.\\\\\\\\n    40\\\\\\\\texport interface ComposeFormRow {\\\\\\\\n    41\\\\\\\\t  state: DerivationState;\\\\\\\\n    42\\\\\\\\t  content?: string;\\\\\\\\n    43\\\\\\\\t  metadata?: DerivationMetadata;\\\\\\\\n    44\\\\\\\\t  reason?: string;\\\\\\\\n    45\\\\\\\\t  sourceVersion: number;\\\\\\\\n    46\\\\\\\\t}\\\\\\\\n    47\\\\\\\\t\\\\\\\\n    48\\\\\\\\texport function composeFormKey(messageId: string, form: DerivationType): string {\\\\\\\\n    49\\\\\\\\t  return `${messageId}/${form}`;\\\\\\\\n    50\\\\\\\\t}\\\\\\\\n    51\\\\\\\\t\\\\\\\\n    52\\\\\\\\texport interface CompositionInput {\\\\\\\\n    53\\\\\\\\t  parts: RenderingPart[];\\\\\\\\n    54\\\\\\\\t  gaps: DependencyGap[];\\\\\\\\n    55\\\\\\\\t  recoveries: RecoveryReceipt[];\\\\\\\\n    56\\\\\\\\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\\\\\\\\n    57\\\\\\\\t  // account + outcome, in message order — pure restatement of the\\\\\\\\n    58\\\\\\\\t  // composition input, stamped on the rendering so chunk summaries read\\\\\\\\n    59\\\\\\\\t  // receipts without re-deriving anything.\\\\\\\\n    60\\\\\\\\t  receipts: ToolRunReceipt[];\\\\\\\\n    61\\\\\\\\t}\\\\\\\\n    62\\\\\\\\t\\\\\\\\n    63\\\\\\\\texport interface RecoveryReceipt {\\\\\\\\n    64\\\\\\\\t  subjectKind: \\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\";\\\\\\\\n    65\\\\\\\\t  subjectId: string;\\\\\\\\n    66\\\\\\\\t  derivationType: DerivationType;\\\\\\\\n    67\\\\\\\\t  content: string;\\\\\\\\n    68\\\\\\\\t  sourceVersion: number;\\\\\\\\n    69\\\\\\\\t  reason: \\\\\\\\\\\\\\\"not_ready\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"failed_floor\\\\\\\\\\\\\\\";\\\\\\\\n    70\\\\\\\\t  floorUsed: string;\\\\\\\\n    71\\\\\\\\t}\\\\\\\\n    72\\\\\\\\t\\\\\\\\n    73\\\\\\\\tfunction textOf(message: ComposeMessage): string {\\\\\\\\n    74\\\\\\\\t  const text = message.blocks[0]?.content[\\\\\\\\\\\\\\\"text\\\\\\\\\\\\\\\"];\\\\\\\\n    75\\\\\\\\t  return typeof text === \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\" ? text : \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\";\\\\\\\\n    76\\\\\\\\t}\\\\\\\\n    77\\\\\\\\t\\\\\\\\n    78\\\\\\\\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\\\\\\\\n    79\\\\\\\\t// composition): a tool call's outcome comes from its paired result among the\\\\\\\\n    80\\\\\\\\t// turn's messages — present and clean, present and isError, or absent.\\\\\\\\n    81\\\\\\\\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\\\\\\\\n    82\\\\\\\\t  const byCallId = new Map<string, boolean>();\\\\\\\\n    83\\\\\\\\t  for (const message of messages) {\\\\\\\\n    84\\\\\\\\t    if (message.kind !== \\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\") continue;\\\\\\\\n    85\\\\\\\\t    const block = message.blocks[0]?.content ?? {};\\\\\\\\n    86\\\\\\\\t    const callId = block[\\\\\\\\\\\\\\\"toolCallId\\\\\\\\\\\\\\\"];\\\\\\\\n    87\\\\\\\\t    if (typeof callId === \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\") byCallId.set(callId, block[\\\\\\\\\\\\\\\"isError\\\\\\\\\\\\\\\"] === true);\\\\\\\\n    88\\\\\\\\t  }\\\\\\\\n    89\\\\\\\\t  return byCallId;\\\\\\\\n    90\\\\\\\\t}\\\\\\\\n    91\\\\\\\\t\\\\\\\\n    92\\\\\\\\tfunction outcomeFromRecord(\\\\\\\\n    93\\\\\\\\t  resultByCallId: Map<string, boolean>,\\\\\\\\n    94\\\\\\\\t  callId: unknown,\\\\\\\\n    95\\\\\\\\t): ToolOutcome {\\\\\\\\n    96\\\\\\\\t  if (typeof callId !== \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\") return \\\\\\\\\\\\\\\"unknown\\\\\\\\\\\\\\\";\\\\\\\\n    97\\\\\\\\t  const isError = resultByCallId.get(callId);\\\\\\\\n    98\\\\\\\\t  if (isError === undefined) return \\\\\\\\\\\\\\\"unknown\\\\\\\\\\\\\\\";\\\\\\\\n    99\\\\\\\\t  return isError ? \\\\\\\\\\\\\\\"failed\\\\\\\\\\\\\\\" : \\\\\\\\\\\\\\\"succeeded\\\\\\\\\\\\\\\";\\\\\\\\n   100\\\\\\\\t}\\\\\\\\n   101\\\\\\\\t\\\\\\\\n   102\\\\\\\\tinterface PartPlan {\\\\\\\\n   103\\\\\\\\t  form?: DerivationType; // the message-level form this kind composes from, if any\\\\\\\\n   104\\\\\\\\t  fallbackText: (message: ComposeMessage) => string;\\\\\\\\n   105\\\\\\\\t}\\\\\\\\n   106\\\\\\\\t\\\\\\\\n   107\\\\\\\\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\\\\\\\\n   108\\\\\\\\t// call → recorded args; result → deterministic truncation; text/thinking/note → raw, no form\\\\\\\\n   109\\\\\\\\t// to fall back from and therefore never a gap.\\\\\\\\n   110\\\\\\\\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\\\\\\\\n   111\\\\\\\\t  user_prompt: { form: \\\\\\\\\\\\\\\"smoothed_prompt\\\\\\\\\\\\\\\", fallbackText: (message) => cleanPrompt(textOf(message)) },\\\\\\\\n   112\\\\\\\\t  assistant_text: { fallbackText: textOf },\\\\\\\\n   113\\\\\\\\t  assistant_thinking: { fallbackText: textOf },\\\\\\\\n   114\\\\\\\\t  runtime_note: { fallbackText: textOf },\\\\\\\\n   115\\\\\\\\t  tool_call: {\\\\\\\\n   116\\\\\\\\t    fallbackText: (message) => {\\\\\\\\n   117\\\\\\\\t      const block = message.blocks[0]?.content ?? {};\\\\\\\\n   118\\\\\\\\t      const toolName = typeof block[\\\\\\\\\\\\\\\"toolName\\\\\\\\\\\\\\\"] === \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\" ? block[\\\\\\\\\\\\\\\"toolName\\\\\\\\\\\\\\\"] : \\\\\\\\\\\\\\\"unknown_tool\\\\\\\\\\\\\\\";\\\\\\\\n   119\\\\\\\\t      return `${toolName}(${JSON.stringify(block[\\\\\\\\\\\\\\\"arguments\\\\\\\\\\\\\\\"] ?? {})})`;\\\\\\\\n   120\\\\\\\\t    },\\\\\\\\n   121\\\\\\\\t  },\\\\\\\\n   122\\\\\\\\t  tool_result: {\\\\\\\\n   123\\\\\\\\t    form: \\\\\\\\\\\\\\\"tool_result_summary\\\\\\\\\\\\\\\",\\\\\\\\n   124\\\\\\\\t    fallbackText: (message) => {\\\\\\\\n   125\\\\\\\\t      const block = message.blocks[0]?.content ?? {};\\\\\\\\n   126\\\\\\\\t      return truncateForFallback(typeof block[\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\"] === \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\" ? block[\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\"] : \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");\\\\\\\\n   127\\\\\\\\t    },\\\\\\\\n   128\\\\\\\\t  },\\\\\\\\n   129\\\\\\\\t};\\\\\\\\n   130\\\\\\\\t\\\\\\\\n   131\\\\\\\\t// One per-message atom before grouping: its composed part plus the structural\\\\\\\\n   132\\\\\\\\t// facts the run-grouping reads. Tool atoms fold into runs; prompts and\\\\\\\\n   133\\\\\\\\t// assistant text break runs; thinking and runtime notes are transparent —\\\\\\\\n   134\\\\\\\\t// interior ones fold into the surrounding run's account, edge ones stand alone.\\\\\\\\n   135\\\\\\\\tinterface ComposeAtom {\\\\\\\\n   136\\\\\\\\t  part: RenderingPart;\\\\\\\\n   137\\\\\\\\t  isTool: boolean;\\\\\\\\n   138\\\\\\\\t  isBreak: boolean; // user_prompt | assistant_text — ends a run\\\\\\\\n   139\\\\\\\\t  toolName?: string; // tool_call only\\\\\\\\n   140\\\\\\\\t  toolCallId?: string; // tool_call | tool_result\\\\\\\\n   141\\\\\\\\t}\\\\\\\\n   142\\\\\\\\t\\\\\\\\n   143\\\\\\\\tconst RUN_BREAK_KINDS: ReadonlySet<RenderingPartKind> = new Set([\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\"]);\\\\\\\\n   144\\\\\\\\tconst TOOL_KINDS: ReadonlySet<RenderingPartKind> = new Set([\\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\"]);\\\\\\\\n   145\\\\\\\\t\\\\\\\\n   146\\\\\\\\t// One message → its composed part (ready form verbatim, else raw/truncated\\\\\\\\n   147\\\\\\\\t// fallback) plus a gap when a derivable form was not ready. Gaps stay\\\\\\\\n   148\\\\\\\\t// per-message — precise to the source record — regardless of run grouping\\\\\\\\n   149\\\\\\\\t// (AC-3.2/3.3): the caller lands them on the rendering and they hold until an\\\\\\\\n   150\\\\\\\\t// explicit rebuild recomposes from current states.\\\\\\\\n   151\\\\\\\\tfunction buildAtom(\\\\\\\\n   152\\\\\\\\t  message: ComposeMessage,\\\\\\\\n   153\\\\\\\\t  forms: ReadonlyMap<string, ComposeFormRow>,\\\\\\\\n   154\\\\\\\\t  resultByCallId: Map<string, boolean>,\\\\\\\\n   155\\\\\\\\t): { atom: ComposeAtom; gap?: DependencyGap; recovery?: RecoveryReceipt } {\\\\\\\\n   156\\\\\\\\t  const plan = PART_PLANS[message.kind];\\\\\\\\n   157\\\\\\\\t  const form =\\\\\\\\n   158\\\\\\\\t    plan.form === undefined\\\\\\\\n   159\\\\\\\\t      ? undefined\\\\\\\\n   160\\\\\\\\t      : forms.get(composeFormKey(message.messageId, plan.form));\\\\\\\\n   161\\\\\\\\t  const ready = form !== undefined && form.state === \\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\" && form.content !== undefined;\\\\\\\\n   162\\\\\\\\t  const block = message.blocks[0]?.content ?? {};\\\\\\\\n   163\\\\\\\\t  const part: RenderingPart = {\\\\\\\\n   164\\\\\\\\t    messageId: message.messageId,\\\\\\\\n   165\\\\\\\\t    kind: message.kind,\\\\\\\\n   166\\\\\\\\t    text: ready ? (form.content as string) : plan.fallbackText(message),\\\\\\\\n   167\\\\\\\\t    fallback: plan.form !== undefined && !ready,\\\\\\\\n   168\\\\\\\\t  };\\\\\\\\n   169\\\\\\\\t  if (message.kind === \\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\") {\\\\\\\\n   170\\\\\\\\t    part.outcome =\\\\\\\\n   171\\\
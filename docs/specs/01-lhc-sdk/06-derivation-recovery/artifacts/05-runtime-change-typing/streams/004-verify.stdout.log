ousModel: \"gpt-5\", newModel: \"gpt-5.1\" };\npackages/lhc/test/runtime-change-typing.test.ts:100:    const thinkingBlock = { previousLevel: \"medium\", newLevel: \"high\" };\npackages/lhc/test/runtime-change-typing.test.ts:104:      validEvent(\"model_change\", { payload: modelBlock }),\npackages/lhc/test/runtime-change-typing.test.ts:105:      validEvent(\"thinking_level_change\", { payload: thinkingBlock }),\npackages/lhc/test/runtime-change-typing.test.ts:130:      \"model_change\",\npackages/lhc/test/runtime-change-typing.test.ts:131:      \"thinking_level_change\",\npackages/lhc/test/runtime-change-typing.test.ts:135:      kind: \"model_change\",\npackages/lhc/test/runtime-change-typing.test.ts:137:      blocks: [{ blockType: \"model_change\", content: modelBlock }],\npackages/lhc/test/runtime-change-typing.test.ts:140:      kind: \"thinking_level_change\",\npackages/lhc/test/runtime-change-typing.test.ts:142:      blocks: [{ blockType: \"thinking_level_change\", content: thinkingBlock }],\n","exit_code":0,"status":"completed"}}

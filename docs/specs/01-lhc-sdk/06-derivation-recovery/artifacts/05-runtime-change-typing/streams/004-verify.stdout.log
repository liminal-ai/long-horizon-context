db: DatabaseSync | undefined;\\\\n  try {\\\\n    db = openThreadDatabase(filePath);\\\\n    return { ok: true, value: readMessages(db) };\\\",\\\"originalFile\\\":\\\"import { existsSync } from \\\\\\\"node:fs\\\\\\\";\\\\nimport type { DatabaseSync } from \\\\\\\"node:sqlite\\\\\\\";\\\\nimport type { OperationContext } from \\\\\\\"../../shared/context.js\\\\\\\";\\\\nimport {\\\\n  notImplemented,\\\\n  storageFailure,\\\\n  type ErrorResult,\\\\n  type OpResult,\\\\n} from \\\\\\\"../../shared/errors.js\\\\\\\";\\\\nimport type { WorkItemRecord } from \\\\\\\"../../tech-utils/work-queue/index.js\\\\\\\";\\\\nimport type { EventKind, EventRecord } from \\\\\\\"../intake-stream/index.js\\\\\\\";\\\\nimport {\\\\n  openThreadDatabase,\\\\n  resolveThreadRef,\\\\n  type ThreadRef,\\\\n} from \\\\\\\"../threads/index.js\\\\\\\";\\\\nimport { projectEvent } from \\\\\\\"./internal/project.js\\\\\\\";\\\\nimport { insertMessage, readMessages } from \\\\\\\"./internal/store.js\\\\\\\";\\\\n\\\\nexport type BlockType = \\\\\\\"text\\\\\\\" | \\\\\\\"tool_call\\\\\\\" | \\\\\\\"tool_result\\\\\\\";\\\\n\\\\nexport interface Block {\\\\n  blockType: BlockType;\\\\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\\\\n}\\\\n\\\\nexport interface MessageRecord {\\\\n  messageId: string;\\\\n  sourceEventOrder: number;\\\\n  kind: Exclude<EventKind, \\\\\\\"turn_end\\\\\\\">;\\\\n  blocks: Block[];\\\\n  tokenEstimate: number;\\\\n  actor: string;\\\\n  harness: string;\\\\n  turnId?: string;\\\\n}\\\\n\\\\n// The event as the walk holds it after recording: the validated input plus\\\\n// its server-stamped order and timestamp.\\\\nexport type RecordedEvent = EventRecord;\\\\n\\\\nexport type MessageCreated = {\\\\n  messageId: string;\\\\n  kind: Exclude<EventKind, \\\\\\\"turn_end\\\\\\\">;\\\\n} | null;\\\\n\\\\n// Cross-domain surface, called by intake-stream inside the batch transaction\\\\n// (the first such call through the operation context; turns.applyEvent\\\\n// follows the pattern in Story 4). Synchronous and throwing by design: a\\\\n// projection failure propagates to the pipeline's catch and rejects the\\\\n// whole batch — recorded events without messages is the stranded state the\\\\n// transaction exists to prevent. Returns null for turn_end (no message).\\\\nexport function createFromEvent(\\\\n  ctx: OperationContext,\\\\n  event: RecordedEvent,\\\\n): MessageCreated {\\\\n  const projected = projectEvent(event);\\\\n  if (projected === null) return null;\\\\n  const kind = event.eventKind as Exclude<EventKind, \\\\\\\"turn_end\\\\\\\">;\\\\n  const messageId = `m${event.eventOrder}`;\\\\n  insertMessage(ctx.db, {\\\\n    messageId,\\\\n    sourceEventOrder: event.eventOrder,\\\\n    kind,\\\\n    tokenEstimate: projected.tokenEstimate,\\\\n    actor: event.actor,\\\\n    harness: event.harness,\\\\n    blocks: projected.blocks,\\\\n  });\\\\n  return { messageId, kind };\\\\n}\\\\n\\\\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\\\\n  return {\\\\n    ok: false,\\\\n    error: {\\\\n      errorClass: \\\\\\\"caller_error\\\\\\\",\\\\n      code: \\\\\\\"thread_not_found\\\\\\\",\\\\n      reason: `no thread file exists at ${filePath}`,\\\\n    },\\\\n  };\\\\n}\\\\n\\\\nexport async function listMessages(\\\\n  thread: ThreadRef,\\\\n): Promise<OpResult<MessageRecord[]>> {\\\\n  const resolved = await resolveThreadRef(thread);\\\\n  if (!resolved.ok) return resolved;\\\\n  const { filePath } = resolved.value;\\\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\\\n\\\\n  let db: DatabaseSync | undefined;\\\\n  try {\\\\n    db = openDatabase(filePath);\\\\n    return { ok: true, value: readMessages(db) };\\\\n  } catch (cause) {\\\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\\\n    return storageFailure(`message read-back failed: ${reason}`);\\\\n  } finally {\\\\n    db?.close();\\\\n  }\\\\n}\\\\n\\\\nexport async function listQueuedWork(\\\\n  _thread: ThreadRef,\\\\n): Promise<OpResult<WorkItemRecord[]>> {\\\\n  return notImplemented(\\\\\\\"messages.list-queued-work\\\\\\\");\\\\n}\\\\n\\\",\\\"structuredPatch\\\":[{\\\"oldStart\\\":89,\\\"oldLines\\\":9,\\\"newStart\\\":89,\\\"newLines\\\":11,\\\"lines\\\":[\\\"   const { filePath } = resolved.value;\\\",\\\"   if (!existsSync(filePath)) return threadNotFound(filePath);\\\",\\\" \\\",\\\"+  // openThreadDatabase migrates a pre-Story-3 file before the read, so a\\\",\\\"+  // thread recorded under an earlier story lists cleanly (F-03-001).\\\",\\\"   let db: DatabaseSync | undefined;\\\",\\\"   try {\\\",\\\"-    db = openDatabase(filePath);\\\",\\\"+    db = openThreadDatabase(filePath);\\\",\\\"     return { ok: true, value: readMessages(db) };\\\",\\\"   } catch (cause) {\\\",\\\"     const reason = cause instanceof Error ? cause.message : String(cause);\\\"]}],\\\"userModified\\\":false,\\\"replaceAll\\\":false}}\\npackages/lhc/docs/02-specs/01-thread-record-and-intake/artifacts/03-message-projection-tokens/streams/005-continue.stdout.log:347:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\"{\\\\\\\"file_path\\\\\\\": \\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/legacy.ts\\\"}},\\\"session_id\\\":\\\"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa\\\",\\\"parent_tool_use_id\\\":null,\\\"uuid\\\":\\\"93d3a9e9-3abe-4fb5-a66d-8d2de063605d\\\"}\\npackages/lhc/docs/02-specs/01-thread-record-and-intake/artifacts/03-message-projection-tokens/streams/005-continue.stdout.log:349:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":2,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\"d): thread_metadata + event tables only, PRAGMA user_version = 1.\\\\\\\\n// Cur
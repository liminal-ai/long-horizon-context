{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E6j7toYJUbmmfbnmnPjE1u","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n3\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n5\timport {\n6\t  enqueue,\n7\t  hasLiveItem,\n8\t  listItems,\n9\t  type WorkItemRecord,\n10\t  type WorkKind,\n11\t} from \"../../tech-utils/work-queue/index.js\";\n12\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n13\timport {\n14\t  openThreadDatabase,\n15\t  resolveThreadRef,\n16\t  type ThreadRef,\n17\t} from \"../threads/index.js\";\n18\timport type { DerivedForm } from \"../../shared/derivation.js\";\n19\timport {\n20\t  findUnknownOutcomeCallSummary,\n21\t  readMessageFormRow,\n22\t  readMessageForms,\n23\t  reportMessageForms,\n24\t} from \"./internal/forms.js\";\n25\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n26\timport { projectEvent } from \"./internal/project.js\";\n27\timport {\n28\t  cascadeFromMessage,\n29\t  cascadeMessageDelete,\n30\t  cascadeTurnDelete,\n31\t  type CascadeClear,\n32\t  type CascadeOutcome,\n33\t} from \"./internal/cascade.js\";\n34\timport {\n35\t  applyMessageEdit,\n36\t  insertMessage,\n37\t  markMessageDeleted,\n38\t  markTurnMessagesDeleted,\n39\t  readMessages,\n40\t  readMutableMessage,\n41\t} from \"./internal/store.js\";\n42\t\n43\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n44\t\n45\texport interface Block {\n46\t  blockType: BlockType;\n47\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n48\t}\n49\t\n50\texport interface MessageRecord {\n51\t  messageId: string;\n52\t  sourceEventOrder: number;\n53\t  kind: Exclude<EventKind, \"turn_end\">;\n54\t  blocks: Block[];\n55\t  tokenEstimate: number;\n56\t  actor: string;\n57\t  harness: string;\n58\t  turnId?: string;\n59\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n60\t  // for messages that are derivation sources — kinds with no derivable form\n61\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n62\t  // never re-derived on read.\n63\t  forms?: DerivedForm[];\n64\t}\n65\t\n66\t// The event as the walk holds it after recording: the validated input plus\n67\t// its server-stamped order and timestamp.\n68\texport type RecordedEvent = EventRecord;\n69\t\n70\texport type MessageCreated = {\n71\t  messageId: string;\n72\t  kind: Exclude<EventKind, \"turn_end\">;\n73\t  // Carried for tool activity only: the pairing key the queue sites need —\n74\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n75\t  toolCallId?: string;\n76\t} | null;\n77\t\n78\t// Cross-domain surface, called by intake-stream inside the batch transaction\n79\t// (the first such call through the operation context; turns.applyEvent\n80\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n81\t// projection failure propagates to the pipeline's catch and rejects the\n82\t// whole batch — recorded events without messages is the stranded state the\n83\t// transaction exists to prevent. Returns null for turn_end (no message).\n84\t// turnId is the membership stamp, settled by the pipeline before this call:\n85\t// the turn open *after* this event's transition (so a prompt belongs to the\n86\t// turn it just opened), or null in a gap — written once, never updated.\n87\texport function createFromEvent(\n88\t  ctx: OperationContext,\n89\t  event: RecordedEvent,\n90\t  turnId: string | null,\n91\t): MessageCreated {\n92\t  const projected = projectEvent(event);\n93\t  if (projected === null) return null;\n94\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n95\t  const messageId = `m${event.eventOrder}`;\n96\t  insertMessage(ctx.db, {\n97\t    messageId,\n98\t    sourceEventOrder: event.eventOrder,\n99\t    kind,\n100\t    tokenEstimate: projected.tokenEstimate,\n101\t    actor: event.actor,\n102\t    harness: event.harness,\n103\t    turnId,\n104\t    blocks: projected.blocks,\n105\t  });\n106\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n107\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n108\t  }\n109\t  return { messageId, kind };\n110\t}\n111\t\n112\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n113\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n114\t// tool result queues tool_result_summary, nothing else queues anything —\n115\t// text, thinking, and note messages are not derivation sources (Epic 01\n116\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n117\t// intake-stream inside the batch transaction for every recorded message, so\n118\t// the item commits (or rolls back) with the batch.\n119\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n120\t  user_prompt: \"prompt_smoothing\",\n121\t  tool_call: \"tool_call_summary\",\n122\t  tool_result: \"tool_result_summary\",\n123\t};\n124\t\n125\t// Which derived form each message-owned kind produces — the owning domain's\n126\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n127\t// rides the same transaction (DD-5).\n128\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n129\t  prompt_smoothing: \"smoothed_prompt\",\n130\t  tool_call_summary: \"tool_call_summary\",\n131\t  tool_result_summary: \"tool_result_summary\",\n132\t};\n133\t\n134\t// Message-owned work handlers, merged into the SDK's dispatch map at\n135\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n136\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n137\t  messageWorkHandlers;\n138\t\n139\texport function queueMessageWork(\n140\t  ctx: OperationContext,\n141\t  message: MessageCreated,\n142\t): WorkItemRecord[] {\n143\t  if (message === null) return [];\n144\t  const items: WorkItemRecord[] = [];\n145\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n146\t  if (kind !== undefined) {\n147\t    const form = MESSAGE_WORK_FORMS[kind];\n148\t    if (form === undefined) {\n149\t      // Every queuing kind names its form above; a miss is a wiring bug.\n150\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n151\t    }\n152\t    items.push(\n153\t      enqueue(ctx, {\n154\t        owner: \"messages\",\n155\t        kind,\n156\t        sourceRef: { messageId: message.messageId },\n157\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n158\t      }),\n159\t    );\n160\t  }\n161\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n162\t  // summary already derived with outcome \"unknown\" means the summary's\n163\t  // source — the call+result pair — completed underneath it; clear and\n164\t  // regenerate at the next source version, in this same batch transaction.\n165\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n166\t  // the common call-and-result-in-one-batch case never triggers, and the\n167\t  // version-scoped item id keeps the requeue idempotent.\n168\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n169\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n170\t    if (stale !== undefined) {\n171\t      items.push(\n172\t        enqueue(ctx, {\n173\t          owner: \"messages\",\n174\t          kind: \"tool_call_summary\",\n175\t          sourceRef: { messageId: stale.messageId },\n176\t          sourceVersion: stale.sourceVersion + 1,\n177\t          forms: [\n178\t            {\n179\t              subjectKind: \"message\",\n180\t              subjectId: stale.messageId,\n181\t              form: \"tool_call_summary\",\n182\t            },\n183\t          ],\n184\t        }),\n185\t      );\n186\t    }\n187\t  }\n188\t  return items;\n189\t}\n190\t\n191\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n192\t  return {\n193\t    ok: false,\n194\t    error: {\n195\t      errorClass: \"caller_error\",\n196\t      code: \"thread_not_found\",\n197\t      reason: `no thread file exists at ${filePath}`,\n198\t    },\n199\t  };\n200\t}\n201\t\n202\texport async function listMessages(\n203\t  thread: ThreadRef,\n204\t): Promise<OpResult<MessageRecord[]>> {\n205\t  const resolved = await resolveThreadRef(thread);\n206\t  if (!resolved.ok) return resolved;\n207\t  const { filePath } = resolved.value;\n208\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n209\t\n210\t  // openThreadDatabase verifies the file is a real thread file and migrates\n211\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n212\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n213\t  // unmutated (F-03-002).\n214\t  const opened = openThreadDatabase(filePath);\n215\t  if (!opened.ok) return opened;\n216\t  const db = opened.value;\n217\t  try {\n218\t    // Form read-back rides the message read (AC-2.1): each record carries\n219\t    // its stored derived forms, attached from one grouped query — the\n220\t    // production path for \"readable alongside the message\".\n221\t    const formsByMessage = readMessageForms(db);\n222\t    const records = readMessages(db).map((record) => {\n223\t      const forms = formsByMessage.get(record.messageId);\n224\t      return forms === undefined ? record : { ...record, forms };\n225\t    });\n226\t    return { ok: true, value: records };\n227\t  } catch (cause) {\n228\t    const reason = cause instanceof Error ? cause.message : String(cause);\n229\t    return storageFailure(`message read-back failed: ${reason}`);\n230\t  } finally {\n231\t    db.close();\n232\t  }\n233\t}\n234\t\n235\texport async function listQueuedWork(\n236\t  thread: ThreadRef,\n237\t): Promise<OpResult<WorkItemRecord[]>> {\n238\t  const resolved = await resolveThreadRef(thread);\n239\t  if (!resolved.ok) return resolved;\n240\t  const { filePath } = resolved.value;\n241\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n242\t\n243\t  const opened = openThreadDatabase(filePath);\n244\t  if (!opened.ok) return opened;\n245\t  const db = opened.value;\n246\t  try {\n247\t    return { ok: true, value: listItems(db, \"messages\") };\n248\t  } catch (cause) {\n249\t    const reason = cause instanceof Error ? cause.message : String(cause);\n250\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n251\t  } finally {\n252\t    db.close();\n253\t  }\n254\t}\n255\t\n256\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n257\t\n258\t// This owner's repair report: every message-owned form's durable state\n259\t// joined with live queue detail in one query — the five operational\n260\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n261\t// without any queue API. Needs no provider; reads degrade, never block.\n262\texport async function report(\n263\t  thread: ThreadRef,\n264\t  opts?: { notReady?: boolean; messageId?: string },\n265\t): Promise<OpResult<FormReportEntry[]>> {\n266\t  const resolved = await resolveThreadRef(thread);\n267\t  if (!resolved.ok) return resolved;\n268\t  const { filePath } = resolved.value;\n269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n270\t\n271\t  const opened = openThreadDatabase(filePath);\n272\t  if (!opened.ok) return opened;\n273\t  const db = opened.value;\n274\t  try {\n275\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n276\t  } catch (cause) {\n277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n278\t    return storageFailure(`report read failed: ${reason}`);\n279\t  } finally {\n280\t    db.close();\n281\t  }\n282\t}\n283\t\n284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n285\t\n286\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n287\t// inverted; the requeue's join from the named form back to its queue site.\n288\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n289\t  smoothed_prompt: \"prompt_smoothing\",\n290\t  tool_call_summary: \"tool_call_summary\",\n291\t  tool_result_summary: \"tool_result_summary\",\n292\t};\n293\t\n294\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n295\t// supported rebuild act. Refused for blocked forms with the form's stored\n296\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n297\t// queued or in flight at the form's current source version (AC-4.5).\n298\t// Otherwise the form clears to pending and re-enqueues at the next source\n299\t// version — the same enqueue path intake uses, poke-on-commit included, so\n300\t// background mode processes the repair with no further call. The no-op check\n301\t// and the enqueue commit in one transaction (anti-shim: a split would\n302\t// reintroduce the duplicate-work race).\n303\texport async function requeue(\n304\t  thread: ThreadRef,\n305\t  target: { messageId: string; form: FormKind },\n306\t): Promise<OpResult<RequeueOutcome>> {\n307\t  const kind = MESSAGE_FORM_KINDS[target.form];\n308\t  if (kind === undefined) {\n309\t    return {\n310\t      ok: false,\n311\t      error: {\n312\t        errorClass: \"caller_error\",\n313\t        code: \"message_not_found\",\n314\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n315\t      },\n316\t    };\n317\t  }\n318\t  const resolved = await resolveThreadRef(thread);\n319\t  if (!resolved.ok) return resolved;\n320\t  const { filePath } = resolved.value;\n321\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n322\t\n323\t  const opened = openThreadDatabase(filePath);\n324\t  if (!opened.ok) return opened;\n325\t  const db = opened.value;\n326\t  try {\n327\t    const meta = db\n328\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n329\t      .get() as { thread_id: string } | undefined;\n330\t    const threadId = meta?.thread_id ?? \"\";\n331\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n332\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n333\t      if (row === undefined) {\n334\t        return {\n335\t          ok: false,\n336\t          error: {\n337\t            errorClass: \"caller_error\",\n338\t            code: \"message_not_found\",\n339\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n340\t          },\n341\t        };\n342\t      }\n343\t      if (row.state === \"blocked\") {\n344\t        // The refusal carries the form's stored reason — the damage named at\n345\t        // blocking time, not a generic string (AC-4.6).\n346\t        return {\n347\t          ok: false,\n348\t          error: {\n349\t            errorClass: \"state_corruption\",\n350\t            code: \"source_damaged\",\n351\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n352\t          },\n353\t        };\n354\t      }\n355\t      const sourceRef = { messageId: target.messageId };\n356\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n357\t        return { ok: true, value: { noop: \"already_queued\" } };\n358\t      }\n359\t      const item = enqueue(ctx, {\n360\t        owner: \"messages\",\n361\t        kind,\n362\t        sourceRef,\n363\t        sourceVersion: row.sourceVersion + 1,\n364\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n365\t      });\n366\t      return { ok: true, value: { workItemId: item.workItemId } };\n367\t    });\n368\t  } catch (cause) {\n369\t    const reason = cause instanceof Error ? cause.message : String(cause);\n370\t    return storageFailure(`requeue failed: ${reason}`);\n371\t  } finally {\n372\t    db.close();\n373\t  }\n374\t}\n375\t\n376\t// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n377\t\n378\t// The mutation result contract (tech design §Interfaces): what changed in\n379\t// the record, which dependent forms cleared, which dropped (delete only),\n380\t// what replacement work queued, and which still-queued old items the cascade\n381\t// tidied away (issue 1). Shared by edit and the Story 6 deletes.\n382\texport interface MutationResult {\n383\t  changed: { messageIds: string[]; turnIds: string[] };\n384\t  cleared: CascadeClear[];\n385\t  dropped: CascadeClear[];\n386\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n387\t  superseded: string[];\n388\t}\n389\t\n390\t// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n391\t// message's content and blocks, re-stamp the token estimate, and walk the\n392\t// full dependent chain — clear to pending, supersede queued old work,\n393\t// enqueue replacements at the next source version — in one transaction.\n394\t// Synchronous and local by contract: everything above commits before this\n395\t// returns; the re-queued rebuilds run through the normal drain (background\n396\t// mode needs no further call — the enqueue pokes ride the commit). Events\n397\t// are never touched (projection-level mutation, DD-12), and no generated\n398\t// thread-view is either — visibility arrives at the next compact/rebuild.\n399\t// Refusals read through the deleted-filtered view and enforce the closed-turn\n400\t// target boundary: only a message in a closed turn is editable, so an\n401\t// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\n402\t// the boundary's one stable code — a missing or deleted message is\n403\t// message_not_found, and a refusal changes nothing.\n404\texport async function edit(\n405\t  thread: ThreadRef,\n406\t  input: { messageId: string; content: string },\n407\t): Promise<OpResult<MutationResult>> {\n408\t  const resolved = await resolveThreadRef(thread);\n409\t  if (!resolved.ok) return resolved;\n410\t  const { filePath } = resolved.value;\n411\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n412\t\n413\t  const opened = openThreadDatabase(filePath);\n414\t  if (!opened.ok) return opened;\n415\t  const db = opened.value;\n416\t  try {\n417\t    const meta = db\n418\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n419\t      .get() as { thread_id: string } | undefined;\n420\t    const threadId = meta?.thread_id ?? \"\";\n421\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n422\t      const target = readMutableMessage(ctx.db, input.messageId);\n423\t      if (target === undefined) {\n424\t        return {\n425\t          ok: false,\n426\t          error: {\n427\t            errorClass: \"caller_error\",\n428\t            code: \"message_not_found\",\n429\t            reason: `no message ${input.messageId} exists in this thread`,\n430\t          },\n431\t        };\n432\t      }\n433\t      // The closed-turn target boundary (story scope; AC-5.1): the edit's\n434\t      // editable class is a message in a *closed* turn. Both failing cases —\n435\t      // an open turn and a turnless gap message (no membership) — refuse under\n436\t      // the one stable code; the reason distinguishes them so the open-turn\n437\t      // message reads exactly as before. A deleted/missing target never gets\n438\t      // here (it misses the filtered read above as message_not_found).\n439\t      if (target.turnStatus !== \"closed\") {\n440\t        return {\n441\t          ok: false,\n442\t          error: {\n443\t            errorClass: \"caller_error\",\n444\t            code: \"turn_open\",\n445\t            reason:\n446\t              target.turnStatus === \"open\"\n447\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be edited (v1 boundary)`\n448\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\n449\t          },\n450\t        };\n451\t      }\n452\t      applyMessageEdit(ctx.db, input.messageId, input.content);\n453\t      const cascade = cascadeFromMessage(ctx, input.messageId);\n454\t      return {\n455\t        ok: true,\n456\t        value: {\n457\t          changed: { messageIds: [input.messageId], turnIds: [] },\n458\t          cleared: cascade.cleared,\n459\t          dropped: cascade.dropped,\n460\t          queued: cascade.queued,\n461\t          superseded: cascade.superseded,\n462\t        },\n463\t      };\n464\t    });\n465\t  } catch (cause) {\n466\t    const reason = cause instanceof Error ? cause.message : String(cause);\n467\t    return storageFailure(`edit failed: ${reason}`);\n468\t  } finally {\n469\t    db.close();\n470\t  }\n471\t}\n472\t\n473\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n474\t\n475\t// The record's removal mutation for one message (AC-6.1–6.3, 6.7):\n476\t// projection-level delete — the deleted_at stamp plus the delete cascade\n477\t// (own forms dropped, turn and chunk cleared and re-queued for minus-one\n478\t// composition) in one transaction. The source events are never touched;\n479\t// event read-back keeps returning them (the audit surface). Validation\n480\t// reads the same filtered view as edit, so a missing, deleted, or\n481\t// double-deleted target is message_not_found and an open-turn or turnless\n482\t// gap target is turn_open. The one delete-specific refusal is prompt\n483\t// protection: a turn is a prompt and what came back for it, so deleting the\n484\t// turn's initiating prompt is refused toward turns.deleteTurn — the error\n485\t// names the turn and that path (AC-6.3).\n486\texport async function deleteMessage(\n487\t  thread: ThreadRef,\n488\t  input: { messageId: string },\n489\t): Promise<OpResult<MutationResult>> {\n490\t  const resolved = await resolveThreadRef(thread);\n491\t  if (!resolved.ok) return resolved;\n492\t  const { filePath } = resolved.value;\n493\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n494\t\n495\t  const opened = openThreadDatabase(filePath);\n496\t  if (!opened.ok) return opened;\n497\t  const db = opened.value;\n498\t  try {\n499\t    const meta = db\n500\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n501\t      .get() as { thread_id: string } | undefined;\n502\t    const threadId = meta?.thread_id ?? \"\";\n503\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n504\t      const target = readMutableMessage(ctx.db, input.messageId);\n505\t      if (target === undefined) {\n506\t        return {\n507\t          ok: false,\n508\t          error: {\n509\t            errorClass: \"caller_error\",\n510\t            code: \"message_not_found\",\n511\t            reason: `no message ${input.messageId} exists in this thread`,\n512\t          },\n513\t        };\n514\t      }\n515\t      if (target.turnStatus !== \"closed\") {\n516\t        return {\n517\t          ok: false,\n518\t          error: {\n519\t            errorClass: \"caller_error\",\n520\t            code: \"turn_open\",\n521\t            reason:\n522\t              target.turnStatus === \"open\"\n523\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be deleted (v1 boundary)`\n524\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be deleted (v1 boundary)`,\n525\t          },\n526\t        };\n527\t      }\n528\t      if (target.initiatesTurn) {\n529\t        return {\n530\t          ok: false,\n531\t          error: {\n532\t            errorClass: \"caller_error\",\n533\t            code: \"message_initiates_turn\",\n534\t            reason: `message ${input.messageId} is the prompt that initiates turn ${target.turnId ?? \"\"}; a turn is a prompt and what came back for it — delete the whole exchange with turns.deleteTurn (lhc turns delete --turn-id ${target.turnId ?? \"\"})`,\n535\t          },\n536\t        };\n537\t      }\n538\t      markMessageDeleted(ctx.db, input.messageId, ctx.clock().toISOString());\n539\t      const cascade = cascadeMessageDelete(ctx, input.messageId);\n540\t      return {\n541\t        ok: true,\n542\t        value: {\n543\t          changed: { messageIds: [input.messageId], turnIds: [] },\n544\t          cleared: cascade.cleared,\n545\t          dropped: cascade.dropped,\n546\t          queued: cascade.queued,\n547\t          superseded: cascade.superseded,\n548\t        },\n549\t      };\n550\t    });\n551\t  } catch (cause) {\n552\t    const reason = cause instanceof Error ? cause.message : String(cause);\n553\t    return storageFailure(`delete failed: ${reason}`);\n554\t  } finally {\n555\t    db.close();\n556\t  }\n557\t}\n558\t\n559\t// Cross-domain surface for turns.deleteTurn (DD-8: one cascade module, two\n560\t// callers), called inside the turn delete's transaction after the turn row\n561\t// is stamped. The messages domain owns the message-table write — the member\n562\t// stamp, scoped to live rows — and the shared cascade entry; the turns\n563\t// operation owns its own validation and turn-row stamp. Returns the cascade\n564\t// outcome plus the member ids stamped now (record order), which the turn\n565\t// delete reports as its changed messages.\n566\texport function applyTurnDeleteCascade(\n567\t  ctx: OperationContext,\n568\t  turnId: string,\n569\t): CascadeOutcome & { memberMessageIds: string[] } {\n570\t  const memberMessageIds = markTurnMessagesDeleted(\n571\t    ctx.db,\n572\t    turnId,\n573\t    ctx.clock().toISOString(),\n574\t  );\n575\t  return { ...cascadeTurnDelete(ctx, turnId, memberMessageIds), memberMessageIds };\n576\t}\n577\t"}]},"parent_tool_use_id":null,"session_id":"92b30fef-4ad7-45bb-a8e9-4c6f66be56bf","uuid":"ec9679cf-b502-47cc-9d54-98c9f1f63c07","timestamp":"2026-06-12T12:47:53.583Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\nimport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  hasLiveItem,\n  listItems,\n  type WorkItemRecord,\n  type WorkKind,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport type { DerivedForm } from \"../../shared/derivation.js\";\nimport {\n  findUnknownOutcomeCallSummary,\n  readMessageFormRow,\n  readMessageForms,\n  reportMessageForms,\n} from \"./internal/forms.js\";\nimport { messageWorkHandlers } from \"./internal/handlers.js\";\nimport { projectEvent } from \"./internal/project.js\";\nimport {\n  cascadeFromMessage,\n  cascadeMessageDelete,\n  cascadeTurnDelete,\n  type CascadeClear,\n  type CascadeOutcome,\n} from \"./internal/cascade.js\";\nimport {\n  applyMessageEdit,\n  insertMessage,\n  markMessageDeleted,\n  markTurnMessagesDeleted,\n  readMessages,\n  readMutableMessage,\n} from \"./internal/store.js\";\n\nexport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n\nexport interface Block {\n  blockType: BlockType;\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n}\n\nexport interface MessageRecord {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: Exclude<EventKind, \"turn_end\">;\n  blocks: Block[];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  turnId?: string;\n  // The message's derived forms as stored (Epic 02 Story 2): present only\n  // for messages that are derivation sources — kinds with no derivable form\n  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n  // never re-derived on read.\n  forms?: DerivedForm[];\n}\n\n// The event as the walk holds it after recording: the validated input plus\n// its server-stamped order and timestamp.\nexport type RecordedEvent = EventRecord;\n\nexport type MessageCreated = {\n  messageId: string;\n  kind: Exclude<EventKind, \"turn_end\">;\n  // Carried for tool activity only: the pairing key the queue sites need —\n  // tool_result projection runs the AC-2.8 late-result lookup against it.\n  toolCallId?: string;\n} | null;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// (the first such call through the operation context; turns.applyEvent\n// follows the pattern in Story 4). Synchronous and throwing by design: a\n// projection failure propagates to the pipeline's catch and rejects the\n// whole batch — recorded events without messages is the stranded state the\n// transaction exists to prevent. Returns null for turn_end (no message).\n// turnId is the membership stamp, settled by the pipeline before this call:\n// the turn open *after* this event's transition (so a prompt belongs to the\n// turn it just opened), or null in a gap — written once, never updated.\nexport function createFromEvent(\n  ctx: OperationContext,\n  event: RecordedEvent,\n  turnId: string | null,\n): MessageCreated {\n  const projected = projectEvent(event);\n  if (projected === null) return null;\n  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n  const messageId = `m${event.eventOrder}`;\n  insertMessage(ctx.db, {\n    messageId,\n    sourceEventOrder: event.eventOrder,\n    kind,\n    tokenEstimate: projected.tokenEstimate,\n    actor: event.actor,\n    harness: event.harness,\n    turnId,\n    blocks: projected.blocks,\n  });\n  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n    return { messageId, kind, toolCallId: event.payload.toolCallId };\n  }\n  return { messageId, kind };\n}\n\n// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n// tool result queues tool_result_summary, nothing else queues anything —\n// text, thinking, and note messages are not derivation sources (Epic 01\n// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n// intake-stream inside the batch transaction for every recorded message, so\n// the item commits (or rolls back) with the batch.\nconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n  user_prompt: \"prompt_smoothing\",\n  tool_call: \"tool_call_summary\",\n  tool_result: \"tool_result_summary\",\n};\n\n// Which derived form each message-owned kind produces — the owning domain's\n// knowledge, handed to the meaning-blind enqueue so the form's pending row\n// rides the same transaction (DD-5).\nconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n  prompt_smoothing: \"smoothed_prompt\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Message-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6): prompt smoothing and the two tool-activity summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n  messageWorkHandlers;\n\nexport function queueMessageWork(\n  ctx: OperationContext,\n  message: MessageCreated,\n): WorkItemRecord[] {\n  if (message === null) return [];\n  const items: WorkItemRecord[] = [];\n  const kind = MESSAGE_WORK_KINDS[message.kind];\n  if (kind !== undefined) {\n    const form = MESSAGE_WORK_FORMS[kind];\n    if (form === undefined) {\n      // Every queuing kind names its form above; a miss is a wiring bug.\n      throw new Error(`no derived form mapped for message work kind ${kind}`);\n    }\n    items.push(\n      enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef: { messageId: message.messageId },\n        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n      }),\n    );\n  }\n  // Late-result repair (AC-2.8): a tool result landing after its call's\n  // summary already derived with outcome \"unknown\" means the summary's\n  // source — the call+result pair — completed underneath it; clear and\n  // regenerate at the next source version, in this same batch transaction.\n  // One indexed lookup; pending summaries (metadata NULL) never match, so\n  // the common call-and-result-in-one-batch case never triggers, and the\n  // version-scoped item id keeps the requeue idempotent.\n  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n    if (stale !== undefined) {\n      items.push(\n        enqueue(ctx, {\n          owner: \"messages\",\n          kind: \"tool_call_summary\",\n          sourceRef: { messageId: stale.messageId },\n          sourceVersion: stale.sourceVersion + 1,\n          forms: [\n            {\n              subjectKind: \"message\",\n              subjectId: stale.messageId,\n              form: \"tool_call_summary\",\n            },\n          ],\n        }),\n      );\n    }\n  }\n  return items;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listMessages(\n  thread: ThreadRef,\n): Promise<OpResult<MessageRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file and migrates\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\n  // unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    // Form read-back rides the message read (AC-2.1): each record carries\n    // its stored derived forms, attached from one grouped query — the\n    // production path for \"readable alongside the message\".\n    const formsByMessage = readMessageForms(db);\n    const records = readMessages(db).map((record) => {\n      const forms = formsByMessage.get(record.messageId);\n      return forms === undefined ? record : { ...record, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`message read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"messages\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n\n// This owner's repair report: every message-owned form's durable state\n// joined with live queue detail in one query — the five operational\n// situations (waiting, retrying, ready, failed, blocked) read from the rows\n// without any queue API. Needs no provider; reads degrade, never block.\nexport async function report(\n  thread: ThreadRef,\n  opts?: { notReady?: boolean; messageId?: string },\n): Promise<OpResult<FormReportEntry[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`report read failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n\n// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n// inverted; the requeue's join from the named form back to its queue site.\nconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n  smoothed_prompt: \"prompt_smoothing\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Explicit re-queue through the owning surface (AC-4.4): the public,\n// supported rebuild act. Refused for blocked forms with the form's stored\n// damage reason (AC-4.6) and for missing rows; a no-op against work already\n// queued or in flight at the form's current source version (AC-4.5).\n// Otherwise the form clears to pending and re-enqueues at the next source\n// version — the same enqueue path intake uses, poke-on-commit included, so\n// background mode processes the repair with no further call. The no-op check\n// and the enqueue commit in one transaction (anti-shim: a split would\n// reintroduce the duplicate-work race).\nexport async function requeue(\n  thread: ThreadRef,\n  target: { messageId: string; form: FormKind },\n): Promise<OpResult<RequeueOutcome>> {\n  const kind = MESSAGE_FORM_KINDS[target.form];\n  if (kind === undefined) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"message_not_found\",\n        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n      },\n    };\n  }\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n      if (row === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"message_not_found\",\n            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n          },\n        };\n      }\n      if (row.state === \"blocked\") {\n        // The refusal carries the form's stored reason — the damage named at\n        // blocking time, not a generic string (AC-4.6).\n        return {\n          ok: false,\n          error: {\n            errorClass: \"state_corruption\",\n            code: \"source_damaged\",\n            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n          },\n        };\n      }\n      const sourceRef = { messageId: target.messageId };\n      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n        return { ok: true, value: { noop: \"already_queued\" } };\n      }\n      const item = enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef,\n        sourceVersion: row.sourceVersion + 1,\n        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n      });\n      return { ok: true, value: { workItemId: item.workItemId } };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`requeue failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n\n// The mutation result contract (tech design §Interfaces): what changed in\n// the record, which dependent forms cleared, which dropped (delete only),\n// what replacement work queued, and which still-queued old items the cascade\n// tidied away (issue 1). Shared by edit and the Story 6 deletes.\nexport interface MutationResult {\n  changed: { messageIds: string[]; turnIds: string[] };\n  cleared: CascadeClear[];\n  dropped: CascadeClear[];\n  queued: Array<{ workItemId: string; kind: WorkKind }>;\n  superseded: string[];\n}\n\n// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n// message's content and blocks, re-stamp the token estimate, and walk the\n// full dependent chain — clear to pending, supersede queued old work,\n// enqueue replacements at the next source version — in one transaction.\n// Synchronous and local by contract: everything above commits before this\n// returns; the re-queued rebuilds run through the normal drain (background\n// mode needs no further call — the enqueue pokes ride the commit). Events\n// are never touched (projection-level mutation, DD-12), and no generated\n// thread-view is either — visibility arrives at the next compact/rebuild.\n// Refusals read through the deleted-filtered view and enforce the closed-turn\n// target boundary: only a message in a closed turn is editable, so an\n// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\n// the boundary's one stable code — a missing or deleted message is\n// message_not_found, and a refusal changes nothing.\nexport async function edit(\n  thread: ThreadRef,\n  input: { messageId: string; content: string },\n): Promise<OpResult<MutationResult>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n      const target = readMutableMessage(ctx.db, input.messageId);\n      if (target === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"message_not_found\",\n            reason: `no message ${input.messageId} exists in this thread`,\n          },\n        };\n      }\n      // The closed-turn target boundary (story scope; AC-5.1): the edit's\n      // editable class is a message in a *closed* turn. Both failing cases —\n      // an open turn and a turnless gap message (no membership) — refuse under\n      // the one stable code; the reason distinguishes them so the open-turn\n      // message reads exactly as before. A deleted/missing target never gets\n      // here (it misses the filtered read above as message_not_found).\n      if (target.turnStatus !== \"closed\") {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"turn_open\",\n            reason:\n              target.turnStatus === \"open\"\n                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be edited (v1 boundary)`\n                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\n          },\n        };\n      }\n      applyMessageEdit(ctx.db, input.messageId, input.content);\n      const cascade = cascadeFromMessage(ctx, input.messageId);\n      return {\n        ok: true,\n        value: {\n          changed: { messageIds: [input.messageId], turnIds: [] },\n          cleared: cascade.cleared,\n          dropped: cascade.dropped,\n          queued: cascade.queued,\n          superseded: cascade.superseded,\n        },\n      };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`edit failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n\n// The record's removal mutation for one message (AC-6.1–6.3, 6.7):\n// projection-level delete — the deleted_at stamp plus the delete cascade\n// (own forms dropped, turn and chunk cleared and re-queued for minus-one\n// composition) in one transaction. The source events are never touched;\n// event read-back keeps returning them (the audit surface). Validation\n// reads the same filtered view as edit, so a missing, deleted, or\n// double-deleted target is message_not_found and an open-turn or turnless\n// gap target is turn_open. The one delete-specific refusal is prompt\n// protection: a turn is a prompt and what came back for it, so deleting the\n// turn's initiating prompt is refused toward turns.deleteTurn — the error\n// names the turn and that path (AC-6.3).\nexport async function deleteMessage(\n  thread: ThreadRef,\n  input: { messageId: string },\n): Promise<OpResult<MutationResult>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n      const target = readMutableMessage(ctx.db, input.messageId);\n      if (target === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"message_not_found\",\n            reason: `no message ${input.messageId} exists in this thread`,\n          },\n        };\n      }\n      if (target.turnStatus !== \"closed\") {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"turn_open\",\n            reason:\n              target.turnStatus === \"open\"\n                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be deleted (v1 boundary)`\n                : `message ${input.messageId} has no turn membership; only closed-turn messages can be deleted (v1 boundary)`,\n          },\n        };\n      }\n      if (target.initiatesTurn) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"message_initiates_turn\",\n            reason: `message ${input.messageId} is the prompt that initiates turn ${target.turnId ?? \"\"}; a turn is a prompt and what came back for it — delete the whole exchange with turns.deleteTurn (lhc turns delete --turn-id ${target.turnId ?? \"\"})`,\n          },\n        };\n      }\n      markMessageDeleted(ctx.db, input.messageId, ctx.clock().toISOString());\n      const cascade = cascadeMessageDelete(ctx, input.messageId);\n      return {\n        ok: true,\n        value: {\n          changed: { messageIds: [input.messageId], turnIds: [] },\n          cleared: cascade.cleared,\n          dropped: cascade.dropped,\n          queued: cascade.queued,\n          superseded: cascade.superseded,\n        },\n      };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`delete failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// Cross-domain surface for turns.deleteTurn (DD-8: one cascade module, two\n// callers), called inside the turn delete's transaction after the turn row\n// is stamped. The messages domain owns the message-table write — the member\n// stamp, scoped to live rows — and the shared cascade entry; the turns\n// operation owns its own validation and turn-row stamp. Returns the cascade\n// outcome plus the member ids stamped now (record order), which the turn\n// delete reports as its changed messages.\nexport function applyTurnDeleteCascade(\n  ctx: OperationContext,\n  turnId: string,\n): CascadeOutcome & { memberMessageIds: string[] } {\n  const memberMessageIds = markTurnMessagesDeleted(\n    ctx.db,\n    turnId,\n    ctx.clock().toISOString(),\n  );\n  return { ...cascadeTurnDelete(ctx, turnId, memberMessageIds), memberMessageIds };\n}\n","numLines":577,"startLine":1,"totalLines":577}}}

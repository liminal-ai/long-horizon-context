sage-id\",\n        );\n      }\n      return runMessagesShow(threadRefFrom(flags), { messageId: flags.messageId });\n    }"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":500,"cache_read_input_tokens":135428,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":500},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"92b30fef-4ad7-45bb-a8e9-4c6f66be56bf","uuid":"cfbcda8b-4fe2-430d-a46f-d2a512e7d609","request_id":"req_011CbyQHsTRdxESXB8nMsWkW"}

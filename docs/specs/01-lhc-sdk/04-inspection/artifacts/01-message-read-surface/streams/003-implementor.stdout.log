{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DcAq3ksLXXESAyiCnDWi4A","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\texport * as threadView from \"./domains/thread-view/index.js\";\n6\t\n7\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n8\timport * as threadViewDomain from \"./domains/thread-view/index.js\";\n9\timport { resolveViewConfig } from \"./domains/thread-view/index.js\";\n10\timport * as messagesDomain from \"./domains/messages/index.js\";\n11\timport * as threadsDomain from \"./domains/threads/index.js\";\n12\timport * as turnsDomain from \"./domains/turns/index.js\";\n13\timport {\n14\t  createScheduler,\n15\t  peekThreadId,\n16\t  runDrain,\n17\t  type DrainDeps,\n18\t  type DrainReport,\n19\t  type Scheduler,\n20\t} from \"./scheduler.js\";\n21\timport {\n22\t  runWithInstanceSeam,\n23\t  setSchedulerPoke as installSchedulerPoke,\n24\t  setThreadTouch,\n25\t  type InstanceSeam,\n26\t} from \"./shared/context.js\";\n27\timport {\n28\t  PROVIDER_OPERATIONS,\n29\t  type ResolvedSdkConfig,\n30\t  type SdkConfig,\n31\t  type WorkHandler,\n32\t} from \"./shared/derivation.js\";\n33\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n34\timport type {\n35\t  CompactReceipt,\n36\t  PullResult,\n37\t  SweepReceipt,\n38\t  ViewCompactParams,\n39\t  ViewProfile,\n40\t  ViewStatus,\n41\t} from \"./shared/view.js\";\n42\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n43\t\n44\texport {\n45\t  estimateTokens,\n46\t  TOKEN_ESTIMATOR_ID,\n47\t} from \"./tech-utils/token-counting/index.js\";\n48\t\n49\texport {\n50\t  WORK_KIND_REGISTRY,\n51\t  type WorkItemRecord,\n52\t  type WorkKind,\n53\t  type WorkOwner,\n54\t  type WorkSourceRef,\n55\t} from \"./tech-utils/work-queue/index.js\";\n56\t\n57\texport type {\n58\t  ErrorClass,\n59\t  ErrorCode,\n60\t  ErrorResult,\n61\t  OpResult,\n62\t} from \"./shared/errors.js\";\n63\texport {\n64\t  runInTransaction,\n65\t  setSchedulerPoke,\n66\t  setThreadTouch,\n67\t  type OperationContext,\n68\t} from \"./shared/context.js\";\n69\t\n70\texport {\n71\t  createDeterministicProvider,\n72\t  deterministicOutcomesSuffix,\n73\t  deterministicReceiptsSuffix,\n74\t  deterministicText,\n75\t  type DeterministicOpName,\n76\t} from \"./providers/deterministic.js\";\n77\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n78\t\n79\texport type {\n80\t  CompletionTx,\n81\t  DependencyGap,\n82\t  DerivationProvider,\n83\t  DerivedForm,\n84\t  DerivedFormMetadata,\n85\t  DerivedFormState,\n86\t  FormKind,\n87\t  FormReportEntry,\n88\t  HandlerFormWrite,\n89\t  HandlerOutcome,\n90\t  HandlerRunContext,\n91\t  ProviderResult,\n92\t  RenderingPart,\n93\t  ResolvedSdkConfig,\n94\t  SdkConfig,\n95\t  SubjectKind,\n96\t  ToolOutcome,\n97\t  ToolRunReceipt,\n98\t  WorkHandler,\n99\t} from \"./shared/derivation.js\";\n100\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n101\t\n102\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n103\t// from Story 0; the operation shapes land with Stories 1–5.\n104\texport {\n105\t  BUILT_IN_PROFILES,\n106\t  DEFAULT_COMPACT_THRESHOLD,\n107\t  DEFAULT_VISIBILITY,\n108\t} from \"./domains/thread-view/index.js\";\n109\texport type {\n110\t  Band,\n111\t  CompactReceipt,\n112\t  PullResult,\n113\t  ResolvedViewConfig,\n114\t  SdkViewConfig,\n115\t  SweepReceipt,\n116\t  ViewCompactParams,\n117\t  ViewMessage,\n118\t  ViewMeta,\n119\t  ViewProfile,\n120\t  ViewProfileOverride,\n121\t  ViewStatus,\n122\t  VisibilityBudgets,\n123\t} from \"./shared/view.js\";\n124\texport {\n125\t  countLiveItems,\n126\t  enqueue,\n127\t  queueDetail,\n128\t  supersedeQueued,\n129\t  type ClaimedWorkItem,\n130\t  type EnqueueFormTarget,\n131\t  type EnqueueInput,\n132\t  type QueueDetailRow,\n133\t} from \"./tech-utils/work-queue/index.js\";\n134\t\n135\texport type { ThreadRef } from \"./domains/threads/index.js\";\n136\texport type {\n137\t  Block,\n138\t  BlockType,\n139\t  MessageRecord,\n140\t  MutationResult,\n141\t} from \"./domains/messages/index.js\";\n142\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n143\texport type {\n144\t  BatchResult,\n145\t  EventKind,\n146\t  EventRecord,\n147\t  MessageEventInput,\n148\t} from \"./domains/intake-stream/index.js\";\n149\t\n150\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n151\t\n152\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n153\t\n154\t// Merge per-domain handler tables into the one join between the queue's\n155\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n156\t// (each kind has exactly one owner) and throws at construction.\n157\texport function assembleWorkHandlerMap(\n158\t  tables: ReadonlyArray<WorkHandlerMap>,\n159\t): WorkHandlerMap {\n160\t  const map: WorkHandlerMap = {};\n161\t  for (const table of tables) {\n162\t    for (const [kind, handler] of Object.entries(table)) {\n163\t      if (map[kind as WorkKind] !== undefined) {\n164\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n165\t      }\n166\t      map[kind as WorkKind] = handler;\n167\t    }\n168\t  }\n169\t  return map;\n170\t}\n171\t\n172\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n173\t  return {\n174\t    ok: false,\n175\t    error: {\n176\t      errorClass: \"state_corruption\",\n177\t      code: \"unknown_work_kind\",\n178\t      reason: `no handler registered for work kind \"${kind}\"`,\n179\t    },\n180\t  };\n181\t}\n182\t\n183\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n184\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n185\texport function lookupWorkHandler(\n186\t  map: WorkHandlerMap,\n187\t  kind: string,\n188\t): OpResult<WorkHandler> {\n189\t  const handler = map[kind as WorkKind];\n190\t  if (handler === undefined) return unknownWorkKind(kind);\n191\t  return { ok: true, value: handler };\n192\t}\n193\t\n194\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n195\t// requeue land in Story 4.\n196\texport interface WorkSurface {\n197\t  drain(\n198\t    ref: threadsDomain.ThreadRef,\n199\t    opts?: { maxItems?: number },\n200\t  ): Promise<OpResult<DrainReport>>;\n201\t}\n202\t\n203\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n204\t// §Interface Definitions): the five operations only — the Story 0 config\n205\t// substrate the domain index also carries is construction machinery, not an\n206\t// operation. pull and status are real from Story 1; compact, sweep, and\n207\t// materialize return structured not-implemented results until their stories\n208\t// land.\n209\texport interface ThreadViewSurface {\n210\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n211\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n212\t  compact(\n213\t    ref: threadsDomain.ThreadRef,\n214\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n215\t  ): Promise<OpResult<CompactReceipt>>;\n216\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n217\t  materialize(\n218\t    ref: threadsDomain.ThreadRef,\n219\t    opts: { path: string; format?: \"pi-session\" },\n220\t  ): Promise<OpResult<{ writtenPath: string }>>;\n221\t}\n222\t\n223\texport interface Lhc {\n224\t  threads: typeof threadsDomain;\n225\t  intakeStream: typeof intakeStreamDomain;\n226\t  messages: typeof messagesDomain;\n227\t  turns: typeof turnsDomain;\n228\t  threadView: ThreadViewSurface;\n229\t  config: ResolvedSdkConfig;\n230\t  scheduler: Scheduler;\n231\t  workHandlers: WorkHandlerMap;\n232\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n233\t  work: WorkSurface;\n234\t  // Resolves when the scheduler has no running or pending drain for the\n235\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n236\t  // resolve in manual mode.\n237\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n238\t}\n239\t\n240\tfunction requirePositive(value: number, name: string): void {\n241\t  if (!Number.isFinite(value) || value <= 0) {\n242\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n243\t  }\n244\t}\n245\t\n246\tfunction requireNonNegative(value: number, name: string): void {\n247\t  if (!Number.isFinite(value) || value < 0) {\n248\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n249\t  }\n250\t}\n251\t\n252\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n253\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n254\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n255\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n256\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n257\t// object is the same shape as the namespace, so the public surface type holds.\n258\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n259\t  const scoped: Record<string, unknown> = {};\n260\t  for (const key of Object.keys(surface)) {\n261\t    const value = (surface as Record<string, unknown>)[key];\n262\t    scoped[key] =\n263\t      typeof value === \"function\"\n264\t        ? (...args: unknown[]): unknown =>\n265\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n266\t        : value;\n267\t  }\n268\t  return scoped as T;\n269\t}\n270\t\n271\t// The only assembly path: provider, mode, clock, and policy enter here.\n272\t// Config mistakes are programmer errors at construction and throw; operating\n273\t// failures after construction return OpResults per the error contract.\n274\texport function createSdk(config: SdkConfig): Lhc {\n275\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n276\t    throw new TypeError(\n277\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n278\t    );\n279\t  }\n280\t  if (config.provider === null || typeof config.provider !== \"object\") {\n281\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n282\t  }\n283\t  for (const operation of PROVIDER_OPERATIONS) {\n284\t    if (typeof config.provider[operation] !== \"function\") {\n285\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n286\t    }\n287\t  }\n288\t\n289\t  const resolved: ResolvedSdkConfig = {\n290\t    provider: config.provider,\n291\t    mode: config.mode,\n292\t    clock: config.clock ?? (() => new Date()),\n293\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n294\t    lease: config.lease ?? { durationMs: 120000 },\n295\t    chunkPolicy:\n296\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n297\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n298\t    // sums and visibility budgets validated — throws naming the violation.\n299\t    view: resolveViewConfig(config.view),\n300\t  };\n301\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n302\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n303\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n304\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n305\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n306\t  }\n307\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n308\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n309\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n310\t    throw new TypeError(\n311\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n312\t    );\n313\t  }\n314\t\n315\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n316\t  // The tables are empty until Stories 2–3 land the real handlers; the\n317\t  // assembly mechanics are production code from day one.\n318\t  const workHandlers = assembleWorkHandlerMap([\n319\t    messagesDomain.workHandlers,\n320\t    turnsDomain.workHandlers,\n321\t  ]);\n322\t\n323\t  const drainDeps: DrainDeps = {\n324\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n325\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n326\t    config: resolved,\n327\t  };\n328\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n329\t\n330\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n331\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n332\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n333\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n334\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n335\t  // the construction order, because its operations deliver to the no-op seam,\n336\t  // not to whatever a background SDK installed below.\n337\t  // The seam also carries this instance's resolved view config (Epic 03,\n338\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n339\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n340\t  // fall back to the built-in defaults inside the thread-view surface.\n341\t  const seam: InstanceSeam =\n342\t    resolved.mode === \"background\"\n343\t      ? {\n344\t          poke: (threadId) => scheduler.poke(threadId),\n345\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n346\t          view: resolved.view,\n347\t        }\n348\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n349\t\n350\t  // Background mode also installs the below-SDK default seam so a direct\n351\t  // domain call made with no SDK scope — a top-level mutation in the\n352\t  // single-background \"production path\" — still reaches the one installed\n353\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n354\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n355\t  // leaves the default alone (pokes stay no-ops by contract).\n356\t  if (resolved.mode === \"background\") {\n357\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n358\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n359\t  }\n360\t\n361\t  const work: WorkSurface = {\n362\t    drain: (ref, opts) =>\n363\t      runWithInstanceSeam(seam, async () => {\n364\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n365\t        if (!resolvedRef.ok) return resolvedRef;\n366\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n367\t      }),\n368\t  };\n369\t\n370\t  return {\n371\t    threads: threadsDomain,\n372\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n373\t    messages: scopeSurface(messagesDomain, seam),\n374\t    turns: scopeSurface(turnsDomain, seam),\n375\t    threadView: scopeSurface<ThreadViewSurface>(\n376\t      {\n377\t        pull: threadViewDomain.pull,\n378\t        status: threadViewDomain.status,\n379\t        compact: threadViewDomain.compact,\n380\t        sweep: threadViewDomain.sweep,\n381\t        materialize: threadViewDomain.materialize,\n382\t      },\n383\t      seam,\n384\t    ),\n385\t    config: resolved,\n386\t    scheduler,\n387\t    workHandlers,\n388\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n389\t    work,\n390\t    drainSettled: async (ref) => {\n391\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n392\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n393\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n394\t      if (threadId === null) return;\n395\t      return scheduler.drainSettled(threadId);\n396\t    },\n397\t  };\n398\t}\n399\t"}]},"parent_tool_use_id":null,"session_id":"92b30fef-4ad7-45bb-a8e9-4c6f66be56bf","uuid":"7c87304c-ab46-41e5-8308-5b4136e4712b","timestamp":"2026-06-12T12:48:07.676Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\nexport * as threadView from \"./domains/thread-view/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as threadViewDomain from \"./domains/thread-view/index.js\";\nimport { resolveViewConfig } from \"./domains/thread-view/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport {\n  runWithInstanceSeam,\n  setSchedulerPoke as installSchedulerPoke,\n  setThreadTouch,\n  type InstanceSeam,\n} from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewProfile,\n  ViewStatus,\n} from \"./shared/view.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n// from Story 0; the operation shapes land with Stories 1–5.\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n} from \"./domains/thread-view/index.js\";\nexport type {\n  Band,\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SdkViewConfig,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewMeta,\n  ViewProfile,\n  ViewProfileOverride,\n  ViewStatus,\n  VisibilityBudgets,\n} from \"./shared/view.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\n// §Interface Definitions): the five operations only — the Story 0 config\n// substrate the domain index also carries is construction machinery, not an\n// operation. pull and status are real from Story 1; compact, sweep, and\n// materialize return structured not-implemented results until their stories\n// land.\nexport interface ThreadViewSurface {\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n  compact(\n    ref: threadsDomain.ThreadRef,\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n  ): Promise<OpResult<CompactReceipt>>;\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n  materialize(\n    ref: threadsDomain.ThreadRef,\n    opts: { path: string; format?: \"pi-session\" },\n  ): Promise<OpResult<{ writtenPath: string }>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  threadView: ThreadViewSurface;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n// object is the same shape as the namespace, so the public surface type holds.\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n  const scoped: Record<string, unknown> = {};\n  for (const key of Object.keys(surface)) {\n    const value = (surface as Record<string, unknown>)[key];\n    scoped[key] =\n      typeof value === \"function\"\n        ? (...args: unknown[]): unknown =>\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n        : value;\n  }\n  return scoped as T;\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n  // background mode, or a no-op in manual mode — isolated from any other SDK\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\n  // the construction order, because its operations deliver to the no-op seam,\n  // not to whatever a background SDK installed below.\n  // The seam also carries this instance's resolved view config (Epic 03,\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n  // fall back to the built-in defaults inside the thread-view surface.\n  const seam: InstanceSeam =\n    resolved.mode === \"background\"\n      ? {\n          poke: (threadId) => scheduler.poke(threadId),\n          touch: (filePath, db) => scheduler.touch(filePath, db),\n          view: resolved.view,\n        }\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\n\n  // Background mode also installs the below-SDK default seam so a direct\n  // domain call made with no SDK scope — a top-level mutation in the\n  // single-background \"production path\" — still reaches the one installed\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n  // leaves the default alone (pokes stay no-ops by contract).\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: (ref, opts) =>\n      runWithInstanceSeam(seam, async () => {\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n        if (!resolvedRef.ok) return resolvedRef;\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n      }),\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\n    messages: scopeSurface(messagesDomain, seam),\n    turns: scopeSurface(turnsDomain, seam),\n    threadView: scopeSurface<ThreadViewSurface>(\n      {\n        pull: threadViewDomain.pull,\n        status: threadViewDomain.status,\n        compact: threadViewDomain.compact,\n        sweep: threadViewDomain.sweep,\n        materialize: threadViewDomain.materialize,\n      },\n      seam,\n    ),\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":399,"startLine":1,"totalLines":399}}}

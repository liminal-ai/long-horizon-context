{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UmQaiZyw5c356iwfpkZLa2","type":"tool_result","content":"1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n2\t// source message and the call-id pairing reads — the only reach a\n3\t// message-level handler has beyond its own message (AC-2.5). Also the\n4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n5\t// indexed query by call id, never a scan (the v5 expression index on\n6\t// message_block covers it) and never a drain-time sweep or read-time join.\n7\t// Completion writes for message forms ride the work-queue util's `complete`\n8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n9\t// Read-back of message-owned form rows (the listMessages join) also lives\n10\t// here: stored state returned as stored — never re-derived on read.\n11\timport type { DatabaseSync } from \"node:sqlite\";\n12\timport type {\n13\t  DependencyGap,\n14\t  DerivedForm,\n15\t  DerivedFormMetadata,\n16\t  DerivedFormState,\n17\t  FormKind,\n18\t  FormReportEntry,\n19\t} from \"../../../shared/derivation.js\";\n20\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n21\t\n22\texport interface MessageSource {\n23\t  messageId: string;\n24\t  kind: string;\n25\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n26\t}\n27\t\n28\texport function readMessageSource(\n29\t  db: DatabaseSync,\n30\t  messageId: string,\n31\t): MessageSource | undefined {\n32\t  const row = db\n33\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n34\t    .get(messageId) as unknown as { kind: string } | undefined;\n35\t  if (row === undefined) return undefined;\n36\t  const blocks = db\n37\t    .prepare(\n38\t      `SELECT block_type, content FROM message_block\n39\t       WHERE message_id = ? ORDER BY block_index`,\n40\t    )\n41\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n42\t  return {\n43\t    messageId,\n44\t    kind: row.kind,\n45\t    blocks: blocks.map((block) => ({\n46\t      blockType: block.block_type,\n47\t      content: JSON.parse(block.content) as Record<string, unknown>,\n48\t    })),\n49\t  };\n50\t}\n51\t\n52\tinterface RawFormRow {\n53\t  subject_id: string;\n54\t  form: string;\n55\t  state: string;\n56\t  content: string | null;\n57\t  reason: string | null;\n58\t  metadata: string | null;\n59\t  source_version: number | bigint;\n60\t  gaps: string | null;\n61\t  derived_at: string | null;\n62\t}\n63\t\n64\t// Every message-owned derived-form row, grouped by message id — the form\n65\t// read-back joined onto message reads (AC-2.1's \"readable alongside the\n66\t// message\"). Rows come back exactly as the queue landed them: state, content,\n67\t// reason, mechanically stamped metadata; nothing is derived at read time.\n68\texport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n69\t  const rows = db\n70\t    .prepare(\n71\t      `SELECT subject_id, form, state, content, reason, metadata,\n72\t              source_version, gaps, derived_at\n73\t       FROM derived_form WHERE subject_kind = 'message'\n74\t       ORDER BY subject_id, form`,\n75\t    )\n76\t    .all() as unknown as RawFormRow[];\n77\t  const byMessage = new Map<string, DerivedForm[]>();\n78\t  for (const row of rows) {\n79\t    const record: DerivedForm = {\n80\t      subjectKind: \"message\",\n81\t      subjectId: row.subject_id,\n82\t      form: row.form as FormKind,\n83\t      state: row.state as DerivedFormState,\n84\t      sourceVersion: Number(row.source_version),\n85\t    };\n86\t    if (row.content !== null) record.content = row.content;\n87\t    if (row.reason !== null) record.reason = row.reason;\n88\t    if (row.metadata !== null) {\n89\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n90\t    }\n91\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n92\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n93\t    const forms = byMessage.get(row.subject_id) ?? [];\n94\t    forms.push(record);\n95\t    byMessage.set(row.subject_id, forms);\n96\t  }\n97\t  return byMessage;\n98\t}\n99\t\n100\t// One form row by exact key — the requeue operation's refusal read (missing\n101\t// row, blocked state, current source version). State returned as stored.\n102\texport function readMessageFormRow(\n103\t  db: DatabaseSync,\n104\t  messageId: string,\n105\t  form: FormKind,\n106\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n107\t  const row = db\n108\t    .prepare(\n109\t      `SELECT state, reason, source_version FROM derived_form\n110\t       WHERE subject_kind = 'message' AND subject_id = ? AND form = ?`,\n111\t    )\n112\t    .get(messageId, form) as unknown as\n113\t    | { state: string; reason: string | null; source_version: number | bigint }\n114\t    | undefined;\n115\t  if (row === undefined) return undefined;\n116\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n117\t    state: row.state as DerivedFormState,\n118\t    sourceVersion: Number(row.source_version),\n119\t  };\n120\t  if (row.reason !== null) view.reason = row.reason;\n121\t  return view;\n122\t}\n123\t\n124\t// The message owner's report (Flow 4): one query — message-owned form rows\n125\t// LEFT JOINed with the live work_item still targeting each form at its\n126\t// current source version, if any (DD-1: only live rows exist; terminal\n127\t// outcomes already live on the form). No N+1, no in-memory assembly beyond\n128\t// row mapping. The form→kind CASE is the owner's own queue-site mapping\n129\t// (MESSAGE_WORK_FORMS) inverted.\n130\texport function reportMessageForms(\n131\t  db: DatabaseSync,\n132\t  opts: { notReady?: boolean; messageId?: string } = {},\n133\t): FormReportEntry[] {\n134\t  const conditions = [\"df.subject_kind = 'message'\"];\n135\t  const params: string[] = [];\n136\t  if (opts.messageId !== undefined) {\n137\t    conditions.push(\"df.subject_id = ?\");\n138\t    params.push(opts.messageId);\n139\t  }\n140\t  // notReady is exact set equality by construction: every state but ready.\n141\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n142\t  const rows = db\n143\t    .prepare(\n144\t      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\n145\t              df.source_version, df.gaps, df.derived_at,\n146\t              w.status AS queue_status, w.attempts AS queue_attempts,\n147\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n148\t       FROM derived_form df\n149\t       LEFT JOIN work_item w\n150\t         ON w.status IN ('queued', 'claimed')\n151\t        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\n152\t        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n153\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n154\t       WHERE ${conditions.join(\" AND \")}\n155\t       ORDER BY df.subject_id, df.form`,\n156\t    )\n157\t    .all(...params) as unknown as RawReportRow[];\n158\t  return rows.map((row) => reportEntryFromRow(\"message\", row));\n159\t}\n160\t\n161\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n162\t// ever repeated; in a well-formed record the pair is unique. Deleted messages\n163\t// are excluded (tech-design §Mechanics' deleted-read rule, epic-fix-001):\n164\t// composition inputs and derivation reads never see deleted records, so a\n165\t// tool_call whose paired result has been deleted reads no pair and derives\n166\t// outcome `unknown` — never the dead result's outcome.\n167\tfunction findPairedBlock(\n168\t  db: DatabaseSync,\n169\t  blockType: \"tool_call\" | \"tool_result\",\n170\t  toolCallId: string,\n171\t): Record<string, unknown> | undefined {\n172\t  const row = db\n173\t    .prepare(\n174\t      `SELECT b.content FROM message_block b\n175\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n176\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n177\t       ORDER BY m.source_event_order LIMIT 1`,\n178\t    )\n179\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n180\t  if (row === undefined) return undefined;\n181\t  return JSON.parse(row.content) as Record<string, unknown>;\n182\t}\n183\t\n184\texport function findPairedToolResult(\n185\t  db: DatabaseSync,\n186\t  toolCallId: string,\n187\t): { content: string; isError: boolean } | undefined {\n188\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n189\t  if (block === undefined) return undefined;\n190\t  return {\n191\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n192\t    isError: block[\"isError\"] === true,\n193\t  };\n194\t}\n195\t\n196\texport function findPairedToolCall(\n197\t  db: DatabaseSync,\n198\t  toolCallId: string,\n199\t): { toolName: string } | undefined {\n200\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n201\t  if (block === undefined) return undefined;\n202\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n203\t}\n204\t\n205\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n206\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n207\t// common case — call and result in one batch, summary not yet run — never\n208\t// triggers a requeue. Returns the call's message id and the form's current\n209\t// source version (the requeue enqueues at version + 1: the pair is the\n210\t// summary's source, and a source completing follows clear-and-regenerate).\n211\texport function findUnknownOutcomeCallSummary(\n212\t  db: DatabaseSync,\n213\t  toolCallId: string,\n214\t): { messageId: string; sourceVersion: number } | undefined {\n215\t  const row = db\n216\t    .prepare(\n217\t      `SELECT df.subject_id, df.source_version FROM message_block b\n218\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n219\t       JOIN derived_form df ON df.subject_kind = 'message'\n220\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n221\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n222\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n223\t       LIMIT 1`,\n224\t    )\n225\t    .get(toolCallId) as unknown as\n226\t    | { subject_id: string; source_version: number | bigint }\n227\t    | undefined;\n228\t  if (row === undefined) return undefined;\n229\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n230\t}\n231\t"}]},"parent_tool_use_id":null,"session_id":"92b30fef-4ad7-45bb-a8e9-4c6f66be56bf","uuid":"9f8462bf-a58a-44b2-97a9-ec741b8cfbc6","timestamp":"2026-06-12T12:48:25.848Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/forms.ts","content":"// Message-domain reads for derivation (Flow 2): the handler's view of its\n// source message and the call-id pairing reads — the only reach a\n// message-level handler has beyond its own message (AC-2.5). Also the\n// late-result repair lookup intake's projection step runs (AC-2.8): one\n// indexed query by call id, never a scan (the v5 expression index on\n// message_block covers it) and never a drain-time sweep or read-time join.\n// Completion writes for message forms ride the work-queue util's `complete`\n// (Story 1): UPDATE-only with the source-version check — no write path here.\n// Read-back of message-owned form rows (the listMessages join) also lives\n// here: stored state returned as stored — never re-derived on read.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type {\n  DependencyGap,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n} from \"../../../shared/derivation.js\";\nimport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n\nexport interface MessageSource {\n  messageId: string;\n  kind: string;\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n}\n\nexport function readMessageSource(\n  db: DatabaseSync,\n  messageId: string,\n): MessageSource | undefined {\n  const row = db\n    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    .get(messageId) as unknown as { kind: string } | undefined;\n  if (row === undefined) return undefined;\n  const blocks = db\n    .prepare(\n      `SELECT block_type, content FROM message_block\n       WHERE message_id = ? ORDER BY block_index`,\n    )\n    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n  return {\n    messageId,\n    kind: row.kind,\n    blocks: blocks.map((block) => ({\n      blockType: block.block_type,\n      content: JSON.parse(block.content) as Record<string, unknown>,\n    })),\n  };\n}\n\ninterface RawFormRow {\n  subject_id: string;\n  form: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\n// Every message-owned derived-form row, grouped by message id — the form\n// read-back joined onto message reads (AC-2.1's \"readable alongside the\n// message\"). Rows come back exactly as the queue landed them: state, content,\n// reason, mechanically stamped metadata; nothing is derived at read time.\nexport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n  const rows = db\n    .prepare(\n      `SELECT subject_id, form, state, content, reason, metadata,\n              source_version, gaps, derived_at\n       FROM derived_form WHERE subject_kind = 'message'\n       ORDER BY subject_id, form`,\n    )\n    .all() as unknown as RawFormRow[];\n  const byMessage = new Map<string, DerivedForm[]>();\n  for (const row of rows) {\n    const record: DerivedForm = {\n      subjectKind: \"message\",\n      subjectId: row.subject_id,\n      form: row.form as FormKind,\n      state: row.state as DerivedFormState,\n      sourceVersion: Number(row.source_version),\n    };\n    if (row.content !== null) record.content = row.content;\n    if (row.reason !== null) record.reason = row.reason;\n    if (row.metadata !== null) {\n      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    }\n    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    const forms = byMessage.get(row.subject_id) ?? [];\n    forms.push(record);\n    byMessage.set(row.subject_id, forms);\n  }\n  return byMessage;\n}\n\n// One form row by exact key — the requeue operation's refusal read (missing\n// row, blocked state, current source version). State returned as stored.\nexport function readMessageFormRow(\n  db: DatabaseSync,\n  messageId: string,\n  form: FormKind,\n): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n  const row = db\n    .prepare(\n      `SELECT state, reason, source_version FROM derived_form\n       WHERE subject_kind = 'message' AND subject_id = ? AND form = ?`,\n    )\n    .get(messageId, form) as unknown as\n    | { state: string; reason: string | null; source_version: number | bigint }\n    | undefined;\n  if (row === undefined) return undefined;\n  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n    state: row.state as DerivedFormState,\n    sourceVersion: Number(row.source_version),\n  };\n  if (row.reason !== null) view.reason = row.reason;\n  return view;\n}\n\n// The message owner's report (Flow 4): one query — message-owned form rows\n// LEFT JOINed with the live work_item still targeting each form at its\n// current source version, if any (DD-1: only live rows exist; terminal\n// outcomes already live on the form). No N+1, no in-memory assembly beyond\n// row mapping. The form→kind CASE is the owner's own queue-site mapping\n// (MESSAGE_WORK_FORMS) inverted.\nexport function reportMessageForms(\n  db: DatabaseSync,\n  opts: { notReady?: boolean; messageId?: string } = {},\n): FormReportEntry[] {\n  const conditions = [\"df.subject_kind = 'message'\"];\n  const params: string[] = [];\n  if (opts.messageId !== undefined) {\n    conditions.push(\"df.subject_id = ?\");\n    params.push(opts.messageId);\n  }\n  // notReady is exact set equality by construction: every state but ready.\n  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n  const rows = db\n    .prepare(\n      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\n              df.source_version, df.gaps, df.derived_at,\n              w.status AS queue_status, w.attempts AS queue_attempts,\n              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n       FROM derived_form df\n       LEFT JOIN work_item w\n         ON w.status IN ('queued', 'claimed')\n        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\n        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n       WHERE ${conditions.join(\" AND \")}\n       ORDER BY df.subject_id, df.form`,\n    )\n    .all(...params) as unknown as RawReportRow[];\n  return rows.map((row) => reportEntryFromRow(\"message\", row));\n}\n\n// The call-id pairing reads. Earliest-recorded block wins if a call id were\n// ever repeated; in a well-formed record the pair is unique. Deleted messages\n// are excluded (tech-design §Mechanics' deleted-read rule, epic-fix-001):\n// composition inputs and derivation reads never see deleted records, so a\n// tool_call whose paired result has been deleted reads no pair and derives\n// outcome `unknown` — never the dead result's outcome.\nfunction findPairedBlock(\n  db: DatabaseSync,\n  blockType: \"tool_call\" | \"tool_result\",\n  toolCallId: string,\n): Record<string, unknown> | undefined {\n  const row = db\n    .prepare(\n      `SELECT b.content FROM message_block b\n       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n       ORDER BY m.source_event_order LIMIT 1`,\n    )\n    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n  if (row === undefined) return undefined;\n  return JSON.parse(row.content) as Record<string, unknown>;\n}\n\nexport function findPairedToolResult(\n  db: DatabaseSync,\n  toolCallId: string,\n): { content: string; isError: boolean } | undefined {\n  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n  if (block === undefined) return undefined;\n  return {\n    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n    isError: block[\"isError\"] === true,\n  };\n}\n\nexport function findPairedToolCall(\n  db: DatabaseSync,\n  toolCallId: string,\n): { toolName: string } | undefined {\n  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n  if (block === undefined) return undefined;\n  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n}\n\n// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n// common case — call and result in one batch, summary not yet run — never\n// triggers a requeue. Returns the call's message id and the form's current\n// source version (the requeue enqueues at version + 1: the pair is the\n// summary's source, and a source completing follows clear-and-regenerate).\nexport function findUnknownOutcomeCallSummary(\n  db: DatabaseSync,\n  toolCallId: string,\n): { messageId: string; sourceVersion: number } | undefined {\n  const row = db\n    .prepare(\n      `SELECT df.subject_id, df.source_version FROM message_block b\n       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n       JOIN derived_form df ON df.subject_kind = 'message'\n         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n       LIMIT 1`,\n    )\n    .get(toolCallId) as unknown as\n    | { subject_id: string; source_version: number | bigint }\n    | undefined;\n  if (row === undefined) return undefined;\n  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n}\n","numLines":231,"startLine":1,"totalLines":231}}}

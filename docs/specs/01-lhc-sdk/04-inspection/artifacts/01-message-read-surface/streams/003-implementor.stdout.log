{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N7puC6TyLprYJyR2jpEteZ","type":"tool_result","content":"1\t// Story 5 (Epic 02), process-boundary suite: TC-5.6 — `lhc messages edit`\n2\t// through the spawned dist/cli.js has full parity with messages.edit on twin\n3\t// fixtures: identical result JSON, identical cascade (queue rows), identical\n4\t// read-back. Mutations need no provider (DD-11) — only the twin-building\n5\t// drains resolve one, in-process through the same registry the CLI uses.\n6\t// Runs under verify-all only (LHC_PROCESS_SUITE=1). Lives in its own file\n7\t// because cli-process-work.test.ts is hash-locked by the Story 1 red\n8\t// manifest; green may add files, not edit (the Story 4 precedent).\n9\timport { spawnSync } from \"node:child_process\";\n10\timport { mkdtempSync, rmSync } from \"node:fs\";\n11\timport { tmpdir } from \"node:os\";\n12\timport path from \"node:path\";\n13\timport { fileURLToPath } from \"node:url\";\n14\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n15\timport {\n16\t  createSdk,\n17\t  intakeStream,\n18\t  messages,\n19\t  queueDetail,\n20\t  resolveNamedProvider,\n21\t  threads,\n22\t  type MutationResult,\n23\t  type OpResult,\n24\t} from \"../src/index.js\";\n25\timport { openRaw, readDerivedForms, validEvent } from \"./fixtures/index.js\";\n26\t\n27\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n28\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n29\t\n30\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n31\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n32\t    encoding: \"utf8\",\n33\t    env: { ...process.env, LHC_PROVIDER: undefined },\n34\t  });\n35\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n36\t}\n37\t\n38\tlet dir: string;\n39\tbeforeEach(() => {\n40\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-mutations-\"));\n41\t});\n42\tafterEach(() => {\n43\t  rmSync(dir, { recursive: true, force: true });\n44\t});\n45\t\n46\tasync function newThreadFile(name: string): Promise<string> {\n47\t  const filePath = path.join(dir, `${name}.sqlite`);\n48\t  const created = await threads.newThread({\n49\t    filePath,\n50\t    registryPath: path.join(dir, \"registry.sqlite\"),\n51\t  });\n52\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n53\t  return filePath;\n54\t}\n55\t\n56\t// One closed prompt+answer turn, identical on both twins: fixed idempotency\n57\t// keys make the records comparable; the drains run in-process under one\n58\t// injected clock so derived timestamps match byte-for-byte.\n59\tasync function seedTwin(filePath: string): Promise<void> {\n60\t  const batch = [\n61\t    validEvent(\"user_prompt\", { payload: { text: \"twin edit prompt\" } }),\n62\t    validEvent(\"assistant_text\", { payload: { text: \"twin edit answer\" } }),\n63\t    validEvent(\"turn_end\"),\n64\t  ].map((event, index) => ({ ...event, idempotencyKey: `twin-edit-${index}` }));\n65\t  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n66\t  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n67\t}\n68\t\n69\tfunction rawDetailStripped(\n70\t  filePath: string,\n71\t): Array<Omit<ReturnType<typeof queueDetail>[number], \"queuedAt\">> {\n72\t  const db = openRaw(filePath);\n73\t  try {\n74\t    return queueDetail(db).map(({ queuedAt: _queuedAt, ...rest }) => rest);\n75\t  } finally {\n76\t    db.close();\n77\t  }\n78\t}\n79\t\n80\tdescribe(\"TC-5.6 / AC-5.6: messages.edit has SDK/CLI parity on twin fixtures\", () => {\n81\t  it(\"the same edit via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n82\t    const cliThread = await newThreadFile(\"cli-edit\");\n83\t    const sdkThread = await newThreadFile(\"sdk-edit\");\n84\t    await seedTwin(cliThread);\n85\t    await seedTwin(sdkThread);\n86\t\n87\t    // Build identical ready state on both twins through the production\n88\t    // assembly the CLI drain uses: registry provider, manual mode, one fixed\n89\t    // clock so derivedAt stamps match.\n90\t    const provider = resolveNamedProvider(\"deterministic\");\n91\t    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n92\t    const sdk = createSdk({\n93\t      provider,\n94\t      mode: \"manual\",\n95\t      clock: () => new Date(\"2026-06-11T00:00:00.000Z\"),\n96\t    });\n97\t    for (const filePath of [cliThread, sdkThread]) {\n98\t      const drained = await sdk.work.drain({ filePath });\n99\t      if (!drained.ok) throw new Error(`twin drain failed: ${drained.error.reason}`);\n100\t    }\n101\t    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n102\t\n103\t    const viaSdk = await messages.edit(\n104\t      { filePath: sdkThread },\n105\t      { messageId: \"m1\", content: \"twin edited prompt\" },\n106\t    );\n107\t    expect(viaSdk.ok).toBe(true);\n108\t\n109\t    const viaCli = runBinary([\n110\t      \"messages\",\n111\t      \"edit\",\n112\t      \"--file-path\",\n113\t      cliThread,\n114\t      \"--message\",\n115\t      \"m1\",\n116\t      \"--content\",\n117\t      \"twin edited prompt\",\n118\t    ]);\n119\t    expect(viaCli.status).toBe(0);\n120\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n121\t    expect(parsed.ok).toBe(true);\n122\t    if (!parsed.ok || !viaSdk.ok) return;\n123\t\n124\t    // Identical result JSON: same validation, same result shape, same\n125\t    // cascade report (the deterministic ids carry the source versions).\n126\t    expect(parsed.value).toEqual(viaSdk.value);\n127\t\n128\t    // Identical cascade in the record: the live queue rows match minus the\n129\t    // wall-clock queuedAt stamp (the edits ran at different real times).\n130\t    expect(rawDetailStripped(cliThread)).toEqual(rawDetailStripped(sdkThread));\n131\t\n132\t    // Identical read-back: messages (content, blocks, re-stamped estimate,\n133\t    // attached form states) and the full derived_form table.\n134\t    const cliMessages = await messages.listMessages({ filePath: cliThread });\n135\t    const sdkMessages = await messages.listMessages({ filePath: sdkThread });\n136\t    expect(cliMessages.ok && sdkMessages.ok).toBe(true);\n137\t    if (!cliMessages.ok || !sdkMessages.ok) return;\n138\t    expect(cliMessages.value).toEqual(sdkMessages.value);\n139\t    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n140\t  });\n141\t\n142\t  it(\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\", async () => {\n143\t    const threadPath = await newThreadFile(\"cli-refusal\");\n144\t    await seedTwin(threadPath);\n145\t    const before = readDerivedForms(threadPath);\n146\t\n147\t    const missing = runBinary([\n148\t      \"messages\",\n149\t      \"edit\",\n150\t      \"--file-path\",\n151\t      threadPath,\n152\t      \"--message\",\n153\t      \"m99\",\n154\t      \"--content\",\n155\t      \"nope\",\n156\t    ]);\n157\t    expect(missing.status).toBe(1);\n158\t    const missingParsed = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n159\t    expect(missingParsed.ok).toBe(false);\n160\t    expect(missingParsed.error.code).toBe(\"message_not_found\");\n161\t\n162\t    // SDK twin refusal is byte-identical in code and class.\n163\t    const viaSdk = await messages.edit({ filePath: threadPath }, { messageId: \"m99\", content: \"nope\" });\n164\t    expect(viaSdk.ok).toBe(false);\n165\t    if (viaSdk.ok) return;\n166\t    expect(viaSdk.error.code).toBe(\"message_not_found\");\n167\t    expect(viaSdk.error.errorClass).toBe(\"caller_error\");\n168\t\n169\t    expect(readDerivedForms(threadPath)).toEqual(before);\n170\t  });\n171\t});\n172\t"}]},"parent_tool_use_id":null,"session_id":"92b30fef-4ad7-45bb-a8e9-4c6f66be56bf","uuid":"8f01ed37-a5c9-4598-b227-cfa8d3ef5aa8","timestamp":"2026-06-12T12:49:39.717Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-mutations.test.ts","content":"// Story 5 (Epic 02), process-boundary suite: TC-5.6 — `lhc messages edit`\n// through the spawned dist/cli.js has full parity with messages.edit on twin\n// fixtures: identical result JSON, identical cascade (queue rows), identical\n// read-back. Mutations need no provider (DD-11) — only the twin-building\n// drains resolve one, in-process through the same registry the CLI uses.\n// Runs under verify-all only (LHC_PROCESS_SUITE=1). Lives in its own file\n// because cli-process-work.test.ts is hash-locked by the Story 1 red\n// manifest; green may add files, not edit (the Story 4 precedent).\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  intakeStream,\n  messages,\n  queueDetail,\n  resolveNamedProvider,\n  threads,\n  type MutationResult,\n  type OpResult,\n} from \"../src/index.js\";\nimport { openRaw, readDerivedForms, validEvent } from \"./fixtures/index.js\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n\nfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    env: { ...process.env, LHC_PROVIDER: undefined },\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-mutations-\"));\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\nasync function newThreadFile(name: string): Promise<string> {\n  const filePath = path.join(dir, `${name}.sqlite`);\n  const created = await threads.newThread({\n    filePath,\n    registryPath: path.join(dir, \"registry.sqlite\"),\n  });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\n// One closed prompt+answer turn, identical on both twins: fixed idempotency\n// keys make the records comparable; the drains run in-process under one\n// injected clock so derived timestamps match byte-for-byte.\nasync function seedTwin(filePath: string): Promise<void> {\n  const batch = [\n    validEvent(\"user_prompt\", { payload: { text: \"twin edit prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"twin edit answer\" } }),\n    validEvent(\"turn_end\"),\n  ].map((event, index) => ({ ...event, idempotencyKey: `twin-edit-${index}` }));\n  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n}\n\nfunction rawDetailStripped(\n  filePath: string,\n): Array<Omit<ReturnType<typeof queueDetail>[number], \"queuedAt\">> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db).map(({ queuedAt: _queuedAt, ...rest }) => rest);\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"TC-5.6 / AC-5.6: messages.edit has SDK/CLI parity on twin fixtures\", () => {\n  it(\"the same edit via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n    const cliThread = await newThreadFile(\"cli-edit\");\n    const sdkThread = await newThreadFile(\"sdk-edit\");\n    await seedTwin(cliThread);\n    await seedTwin(sdkThread);\n\n    // Build identical ready state on both twins through the production\n    // assembly the CLI drain uses: registry provider, manual mode, one fixed\n    // clock so derivedAt stamps match.\n    const provider = resolveNamedProvider(\"deterministic\");\n    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n    const sdk = createSdk({\n      provider,\n      mode: \"manual\",\n      clock: () => new Date(\"2026-06-11T00:00:00.000Z\"),\n    });\n    for (const filePath of [cliThread, sdkThread]) {\n      const drained = await sdk.work.drain({ filePath });\n      if (!drained.ok) throw new Error(`twin drain failed: ${drained.error.reason}`);\n    }\n    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n\n    const viaSdk = await messages.edit(\n      { filePath: sdkThread },\n      { messageId: \"m1\", content: \"twin edited prompt\" },\n    );\n    expect(viaSdk.ok).toBe(true);\n\n    const viaCli = runBinary([\n      \"messages\",\n      \"edit\",\n      \"--file-path\",\n      cliThread,\n      \"--message\",\n      \"m1\",\n      \"--content\",\n      \"twin edited prompt\",\n    ]);\n    expect(viaCli.status).toBe(0);\n    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n    expect(parsed.ok).toBe(true);\n    if (!parsed.ok || !viaSdk.ok) return;\n\n    // Identical result JSON: same validation, same result shape, same\n    // cascade report (the deterministic ids carry the source versions).\n    expect(parsed.value).toEqual(viaSdk.value);\n\n    // Identical cascade in the record: the live queue rows match minus the\n    // wall-clock queuedAt stamp (the edits ran at different real times).\n    expect(rawDetailStripped(cliThread)).toEqual(rawDetailStripped(sdkThread));\n\n    // Identical read-back: messages (content, blocks, re-stamped estimate,\n    // attached form states) and the full derived_form table.\n    const cliMessages = await messages.listMessages({ filePath: cliThread });\n    const sdkMessages = await messages.listMessages({ filePath: sdkThread });\n    expect(cliMessages.ok && sdkMessages.ok).toBe(true);\n    if (!cliMessages.ok || !sdkMessages.ok) return;\n    expect(cliMessages.value).toEqual(sdkMessages.value);\n    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n  });\n\n  it(\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\", async () => {\n    const threadPath = await newThreadFile(\"cli-refusal\");\n    await seedTwin(threadPath);\n    const before = readDerivedForms(threadPath);\n\n    const missing = runBinary([\n      \"messages\",\n      \"edit\",\n      \"--file-path\",\n      threadPath,\n      \"--message\",\n      \"m99\",\n      \"--content\",\n      \"nope\",\n    ]);\n    expect(missing.status).toBe(1);\n    const missingParsed = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n    expect(missingParsed.ok).toBe(false);\n    expect(missingParsed.error.code).toBe(\"message_not_found\");\n\n    // SDK twin refusal is byte-identical in code and class.\n    const viaSdk = await messages.edit({ filePath: threadPath }, { messageId: \"m99\", content: \"nope\" });\n    expect(viaSdk.ok).toBe(false);\n    if (viaSdk.ok) return;\n    expect(viaSdk.error.code).toBe(\"message_not_found\");\n    expect(viaSdk.error.errorClass).toBe(\"caller_error\");\n\n    expect(readDerivedForms(threadPath)).toEqual(before);\n  });\n});\n","numLines":172,"startLine":1,"totalLines":172}}}

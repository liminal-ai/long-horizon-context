{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dsjw18yoBSESYW6bwjiYUY","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\timport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\n11\timport { runTurnsDelete } from \"./turns-mutate.js\";\n12\timport {\n13\t  runMessagesReport,\n14\t  runMessagesRequeue,\n15\t  runTurnsReport,\n16\t  runTurnsRequeue,\n17\t  runWorkDrain,\n18\t} from \"./work.js\";\n19\timport { runViewCommand } from \"./view.js\";\n20\t\n21\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n22\t// process stdin. null means interactive (TTY) — distinct from empty input\n23\t// only in how it arises; both are refused with empty_stdin before any SDK\n24\t// call (the SDK itself can never return that code).\n25\texport type StdinReader = () => Promise<string | null>;\n26\t\n27\tasync function readProcessStdin(): Promise<string | null> {\n28\t  if (process.stdin.isTTY) return null;\n29\t  process.stdin.setEncoding(\"utf8\");\n30\t  let data = \"\";\n31\t  for await (const chunk of process.stdin) data += String(chunk);\n32\t  return data;\n33\t}\n34\t\n35\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n36\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n37\t}\n38\t\n39\tconst HELP = `lhc — Long Horizon Context CLI\n40\t\n41\tUsage:\n42\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n43\t  lhc threads resolve --thread-id <id> [--registry <r>]\n44\t  lhc threads list [--registry <r>]\n45\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n46\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n47\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n48\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n49\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n50\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n51\t  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n52\t  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n53\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n54\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n55\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n56\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n57\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n58\t  lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n59\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n60\t  lhc view pull (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n61\t  lhc view status (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n62\t  lhc view compact (--thread-id <id> | --file-path <p>) [--profile <name>]\n63\t                   [--lower-bound <n>] [--full <n>] [--smooth <n>] [--detailed <n>] [--brief <n>]\n64\t                   [--no-sweep] [--json] [--registry <r>]\n65\t  lhc view sweep (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n66\t  lhc view materialize (--thread-id <id> | --file-path <p>) --out <path> [--format pi-session] [--registry <r>]\n67\t\n68\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n69\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n70\tView commands need no provider; output is always JSON (--json accepted).\n71\tTwo exceptions on success: view pull prints the message array itself, and\n72\tview materialize prints the written path; their failures stay structured.\n73\t`;\n74\t\n75\tinterface ParsedFlags {\n76\t  threadId?: string;\n77\t  filePath?: string;\n78\t  title?: string;\n79\t  registryPath?: string;\n80\t  maxItems?: string;\n81\t  provider?: string;\n82\t  notReady?: boolean;\n83\t  messageId?: string;\n84\t  turnId?: string;\n85\t  chunkId?: string;\n86\t  form?: string;\n87\t  subjectKind?: string;\n88\t  subjectId?: string;\n89\t  content?: string;\n90\t}\n91\t\n92\t// strict parse rejects unknown/misspelled flags so they are named back to the\n93\t// caller, never silently dropped — the CLI boundary matching the SDK's\n94\t// closed-contract strictness. The failure is returned as data (not thrown) so\n95\t// runCli can render it as the structured usage error.\n96\ttype ParseFlagsResult =\n97\t  | { ok: true; flags: ParsedFlags }\n98\t  | { ok: false; unknownFlag: string };\n99\t\n100\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n101\t  let values;\n102\t  try {\n103\t    ({ values } = parseArgs({\n104\t      args: [...args],\n105\t      options: {\n106\t        \"thread-id\": { type: \"string\" },\n107\t        \"file-path\": { type: \"string\" },\n108\t        title: { type: \"string\" },\n109\t        registry: { type: \"string\" },\n110\t        \"max-items\": { type: \"string\" },\n111\t        provider: { type: \"string\" },\n112\t        \"not-ready\": { type: \"boolean\" },\n113\t        \"message-id\": { type: \"string\" },\n114\t        \"turn-id\": { type: \"string\" },\n115\t        \"chunk-id\": { type: \"string\" },\n116\t        form: { type: \"string\" },\n117\t        \"subject-kind\": { type: \"string\" },\n118\t        \"subject-id\": { type: \"string\" },\n119\t        // `--message` / `--turn` are the mutation commands' spellings\n120\t        // (story/tech design); they parse into the same slots as\n121\t        // `--message-id` / `--turn-id`.\n122\t        message: { type: \"string\" },\n123\t        turn: { type: \"string\" },\n124\t        content: { type: \"string\" },\n125\t      },\n126\t      strict: true,\n127\t      allowPositionals: true,\n128\t    }));\n129\t  } catch (cause) {\n130\t    const message = cause instanceof Error ? cause.message : String(cause);\n131\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n132\t    // option '--file-pth'); surface that token, falling back to the message.\n133\t    const named = /'([^']+)'/.exec(message);\n134\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n135\t  }\n136\t  const flags: ParsedFlags = {};\n137\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n138\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n139\t  if (typeof values.title === \"string\") flags.title = values.title;\n140\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n141\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n142\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n143\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n144\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n145\t  if (typeof values.message === \"string\") flags.messageId = values.message;\n146\t  if (typeof values.content === \"string\") flags.content = values.content;\n147\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n148\t  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n149\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n150\t  if (typeof values.form === \"string\") flags.form = values.form;\n151\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n152\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n153\t  return { ok: true, flags };\n154\t}\n155\t\n156\t// The read commands take a thread reference but no stdin; a missing reference\n157\t// is a usage error named before any SDK call, matching the intake commands.\n158\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n159\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n160\t    return renderCliError(\n161\t      \"caller_error\",\n162\t      \"missing_flag\",\n163\t      `${command} requires --thread-id or --file-path`,\n164\t    );\n165\t  }\n166\t  return undefined;\n167\t}\n168\t\n169\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n170\t  if (flags.threadId !== undefined) {\n171\t    return flags.registryPath !== undefined\n172\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n173\t      : { threadId: flags.threadId };\n174\t  }\n175\t  return { filePath: flags.filePath ?? \"\" };\n176\t}\n177\t\n178\texport async function runCli(\n179\t  argv: readonly string[],\n180\t  readStdin: StdinReader = readProcessStdin,\n181\t): Promise<CliResult> {\n182\t  if (argv.length === 0) {\n183\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n184\t  }\n185\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n186\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n187\t  }\n188\t\n189\t  const [group, command, ...rest] = argv;\n190\t  // The view group parses its own flag surface (band overrides, --out,\n191\t  // --format) — routed before the shared parse so its flags never widen the\n192\t  // other commands' accepted set.\n193\t  if (group === \"view\") {\n194\t    return runViewCommand(command, rest);\n195\t  }\n196\t  const key = command === undefined ? group : `${group} ${command}`;\n197\t  const parsed = parseFlags(command === undefined ? [] : rest);\n198\t  if (!parsed.ok) {\n199\t    return renderCliError(\n200\t      \"caller_error\",\n201\t      \"unknown_flag\",\n202\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n203\t    );\n204\t  }\n205\t  const flags = parsed.flags;\n206\t\n207\t  switch (key) {\n208\t    case \"threads new-thread\": {\n209\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n210\t      // instead of failing, so the adapter refuses before any SDK call.\n211\t      if (flags.filePath === undefined) {\n212\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n213\t      }\n214\t      const input: Parameters<typeof threads.newThread>[0] = {\n215\t        filePath: flags.filePath,\n216\t      };\n217\t      if (flags.title !== undefined) input.title = flags.title;\n218\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n219\t      return renderResult(await threads.newThread(input));\n220\t    }\n221\t    case \"threads resolve\": {\n222\t      if (flags.threadId === undefined) {\n223\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n224\t      }\n225\t      const input: Parameters<typeof threads.resolve>[0] = {\n226\t        threadId: flags.threadId,\n227\t      };\n228\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n229\t      return renderResult(await threads.resolve(input));\n230\t    }\n231\t    case \"threads list\": {\n232\t      return renderResult(\n233\t        await threads.listThreads(\n234\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n235\t        ),\n236\t      );\n237\t    }\n238\t    case \"intake-stream message-events\": {\n239\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n240\t        return renderCliError(\n241\t          \"caller_error\",\n242\t          \"missing_flag\",\n243\t          \"intake-stream message-events requires --thread-id or --file-path\",\n244\t        );\n245\t      }\n246\t      const text = await readStdin();\n247\t      if (text === null || text.trim() === \"\") {\n248\t        return renderResult(\n249\t          stdinCallerError(\n250\t            \"empty_stdin\",\n251\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n252\t          ),\n253\t        );\n254\t      }\n255\t      let parsed: unknown;\n256\t      try {\n257\t        parsed = JSON.parse(text);\n258\t      } catch (cause) {\n259\t        const detail = cause instanceof Error ? cause.message : String(cause);\n260\t        return renderResult(\n261\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n262\t        );\n263\t      }\n264\t      if (!Array.isArray(parsed)) {\n265\t        return renderResult(\n266\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n267\t        );\n268\t      }\n269\t      return renderResult(\n270\t        await intakeStream.messageEvents(\n271\t          threadRefFrom(flags),\n272\t          parsed as readonly MessageEventInput[],\n273\t        ),\n274\t      );\n275\t    }\n276\t    case \"intake-stream list-events\": {\n277\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n278\t        return renderCliError(\n279\t          \"caller_error\",\n280\t          \"missing_flag\",\n281\t          \"intake-stream list-events requires --thread-id or --file-path\",\n282\t        );\n283\t      }\n284\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n285\t    }\n286\t    case \"messages list\":\n287\t      return (\n288\t        requireThreadRef(flags, \"messages list\") ??\n289\t        renderResult(await messages.listMessages(threadRefFrom(flags)))\n290\t      );\n291\t    case \"messages list-queued-work\":\n292\t      return (\n293\t        requireThreadRef(flags, \"messages list-queued-work\") ??\n294\t        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n295\t      );\n296\t    case \"messages report\": {\n297\t      const missingRef = requireThreadRef(flags, \"messages report\");\n298\t      if (missingRef !== undefined) return missingRef;\n299\t      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n300\t      if (flags.notReady === true) reportFlags.notReady = true;\n301\t      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n302\t      return runMessagesReport(threadRefFrom(flags), reportFlags);\n303\t    }\n304\t    case \"messages requeue\": {\n305\t      const missingRef = requireThreadRef(flags, \"messages requeue\");\n306\t      if (missingRef !== undefined) return missingRef;\n307\t      if (flags.messageId === undefined || flags.form === undefined) {\n308\t        return renderCliError(\n309\t          \"caller_error\",\n310\t          \"missing_flag\",\n311\t          \"messages requeue requires --message-id and --form\",\n312\t        );\n313\t      }\n314\t      return runMessagesRequeue(threadRefFrom(flags), {\n315\t        messageId: flags.messageId,\n316\t        form: flags.form,\n317\t      });\n318\t    }\n319\t    case \"messages edit\": {\n320\t      const missingRef = requireThreadRef(flags, \"messages edit\");\n321\t      if (missingRef !== undefined) return missingRef;\n322\t      if (flags.messageId === undefined || flags.content === undefined) {\n323\t        return renderCliError(\n324\t          \"caller_error\",\n325\t          \"missing_flag\",\n326\t          \"messages edit requires --message (or --message-id) and --content\",\n327\t        );\n328\t      }\n329\t      return runMessagesEdit(threadRefFrom(flags), {\n330\t        messageId: flags.messageId,\n331\t        content: flags.content,\n332\t      });\n333\t    }\n334\t    case \"messages delete\": {\n335\t      const missingRef = requireThreadRef(flags, \"messages delete\");\n336\t      if (missingRef !== undefined) return missingRef;\n337\t      if (flags.messageId === undefined) {\n338\t        return renderCliError(\n339\t          \"caller_error\",\n340\t          \"missing_flag\",\n341\t          \"messages delete requires --message (or --message-id)\",\n342\t        );\n343\t      }\n344\t      return runMessagesDelete(threadRefFrom(flags), { messageId: flags.messageId });\n345\t    }\n346\t    case \"turns list\":\n347\t      return (\n348\t        requireThreadRef(flags, \"turns list\") ??\n349\t        renderResult(await turns.listTurns(threadRefFrom(flags)))\n350\t      );\n351\t    case \"turns list-chunks\":\n352\t      return (\n353\t        requireThreadRef(flags, \"turns list-chunks\") ??\n354\t        renderResult(await turns.listChunks(threadRefFrom(flags)))\n355\t      );\n356\t    case \"turns list-queued-work\":\n357\t      return (\n358\t        requireThreadRef(flags, \"turns list-queued-work\") ??\n359\t        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n360\t      );\n361\t    case \"turns report\": {\n362\t      const missingRef = requireThreadRef(flags, \"turns report\");\n363\t      if (missingRef !== undefined) return missingRef;\n364\t      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n365\t      if (flags.notReady === true) reportFlags.notReady = true;\n366\t      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n367\t      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n368\t      return runTurnsReport(threadRefFrom(flags), reportFlags);\n369\t    }\n370\t    case \"turns requeue\": {\n371\t      const missingRef = requireThreadRef(flags, \"turns requeue\");\n372\t      if (missingRef !== undefined) return missingRef;\n373\t      if (\n374\t        flags.subjectKind === undefined ||\n375\t        flags.subjectId === undefined ||\n376\t        flags.form === undefined\n377\t      ) {\n378\t        return renderCliError(\n379\t          \"caller_error\",\n380\t          \"missing_flag\",\n381\t          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n382\t        );\n383\t      }\n384\t      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n385\t        return renderCliError(\n386\t          \"caller_error\",\n387\t          \"missing_flag\",\n388\t          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n389\t        );\n390\t      }\n391\t      return runTurnsRequeue(threadRefFrom(flags), {\n392\t        subjectKind: flags.subjectKind,\n393\t        subjectId: flags.subjectId,\n394\t        form: flags.form,\n395\t      });\n396\t    }\n397\t    case \"turns delete\": {\n398\t      const missingRef = requireThreadRef(flags, \"turns delete\");\n399\t      if (missingRef !== undefined) return missingRef;\n400\t      if (flags.turnId === undefined) {\n401\t        return renderCliError(\n402\t          \"caller_error\",\n403\t          \"missing_flag\",\n404\t          \"turns delete requires --turn (or --turn-id)\",\n405\t        );\n406\t      }\n407\t      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\n408\t    }\n409\t    case \"work drain\": {\n410\t      const missingRef = requireThreadRef(flags, \"work drain\");\n411\t      if (missingRef !== undefined) return missingRef;\n412\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n413\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n414\t      if (flags.maxItems !== undefined) {\n415\t        const maxItems = Number(flags.maxItems);\n416\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n417\t          return renderCliError(\n418\t            \"caller_error\",\n419\t            \"missing_flag\",\n420\t            `--max-items must be a positive integer, got ${flags.maxItems}`,\n421\t          );\n422\t        }\n423\t        drainFlags.maxItems = maxItems;\n424\t      }\n425\t      return runWorkDrain(threadRefFrom(flags), drainFlags);\n426\t    }\n427\t    default:\n428\t      return renderCliError(\n429\t        \"caller_error\",\n430\t        \"unknown_command\",\n431\t        `unknown command: ${key}; run lhc --help`,\n432\t      );\n433\t  }\n434\t}\n435\t"}]},"parent_tool_use_id":null,"session_id":"92b30fef-4ad7-45bb-a8e9-4c6f66be56bf","uuid":"f80f4160-d3bc-4acd-b3ff-10e9aeab2f52","timestamp":"2026-06-12T12:48:08.201Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/index.ts","content":"import { parseArgs } from \"node:util\";\nimport * as intakeStream from \"../domains/intake-stream/index.js\";\nimport * as messages from \"../domains/messages/index.js\";\nimport * as threads from \"../domains/threads/index.js\";\nimport * as turns from \"../domains/turns/index.js\";\nimport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\nimport type { ThreadRef } from \"../domains/threads/index.js\";\nimport type { OpResult } from \"../shared/errors.js\";\nimport { renderCliError, renderResult, type CliResult } from \"./render.js\";\nimport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\nimport { runTurnsDelete } from \"./turns-mutate.js\";\nimport {\n  runMessagesReport,\n  runMessagesRequeue,\n  runTurnsReport,\n  runTurnsRequeue,\n  runWorkDrain,\n} from \"./work.js\";\nimport { runViewCommand } from \"./view.js\";\n\n// Stdin seam: in-process tests inject a reader; the binary reads the real\n// process stdin. null means interactive (TTY) — distinct from empty input\n// only in how it arises; both are refused with empty_stdin before any SDK\n// call (the SDK itself can never return that code).\nexport type StdinReader = () => Promise<string | null>;\n\nasync function readProcessStdin(): Promise<string | null> {\n  if (process.stdin.isTTY) return null;\n  process.stdin.setEncoding(\"utf8\");\n  let data = \"\";\n  for await (const chunk of process.stdin) data += String(chunk);\n  return data;\n}\n\nfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst HELP = `lhc — Long Horizon Context CLI\n\nUsage:\n  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n  lhc threads resolve --thread-id <id> [--registry <r>]\n  lhc threads list [--registry <r>]\n  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n  lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n  lhc view pull (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n  lhc view status (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n  lhc view compact (--thread-id <id> | --file-path <p>) [--profile <name>]\n                   [--lower-bound <n>] [--full <n>] [--smooth <n>] [--detailed <n>] [--brief <n>]\n                   [--no-sweep] [--json] [--registry <r>]\n  lhc view sweep (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n  lhc view materialize (--thread-id <id> | --file-path <p>) --out <path> [--format pi-session] [--registry <r>]\n\nEvery command prints the SDK result (value or error) as JSON and exits 0 on\nsuccess, 1 on failure. message-events reads an events JSON array on stdin.\nView commands need no provider; output is always JSON (--json accepted).\nTwo exceptions on success: view pull prints the message array itself, and\nview materialize prints the written path; their failures stay structured.\n`;\n\ninterface ParsedFlags {\n  threadId?: string;\n  filePath?: string;\n  title?: string;\n  registryPath?: string;\n  maxItems?: string;\n  provider?: string;\n  notReady?: boolean;\n  messageId?: string;\n  turnId?: string;\n  chunkId?: string;\n  form?: string;\n  subjectKind?: string;\n  subjectId?: string;\n  content?: string;\n}\n\n// strict parse rejects unknown/misspelled flags so they are named back to the\n// caller, never silently dropped — the CLI boundary matching the SDK's\n// closed-contract strictness. The failure is returned as data (not thrown) so\n// runCli can render it as the structured usage error.\ntype ParseFlagsResult =\n  | { ok: true; flags: ParsedFlags }\n  | { ok: false; unknownFlag: string };\n\nfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n  let values;\n  try {\n    ({ values } = parseArgs({\n      args: [...args],\n      options: {\n        \"thread-id\": { type: \"string\" },\n        \"file-path\": { type: \"string\" },\n        title: { type: \"string\" },\n        registry: { type: \"string\" },\n        \"max-items\": { type: \"string\" },\n        provider: { type: \"string\" },\n        \"not-ready\": { type: \"boolean\" },\n        \"message-id\": { type: \"string\" },\n        \"turn-id\": { type: \"string\" },\n        \"chunk-id\": { type: \"string\" },\n        form: { type: \"string\" },\n        \"subject-kind\": { type: \"string\" },\n        \"subject-id\": { type: \"string\" },\n        // `--message` / `--turn` are the mutation commands' spellings\n        // (story/tech design); they parse into the same slots as\n        // `--message-id` / `--turn-id`.\n        message: { type: \"string\" },\n        turn: { type: \"string\" },\n        content: { type: \"string\" },\n      },\n      strict: true,\n      allowPositionals: true,\n    }));\n  } catch (cause) {\n    const message = cause instanceof Error ? cause.message : String(cause);\n    // parseArgs names the offending option in single quotes (e.g. Unknown\n    // option '--file-pth'); surface that token, falling back to the message.\n    const named = /'([^']+)'/.exec(message);\n    return { ok: false, unknownFlag: named?.[1] ?? message };\n  }\n  const flags: ParsedFlags = {};\n  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n  if (typeof values.title === \"string\") flags.title = values.title;\n  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n  if (typeof values.provider === \"string\") flags.provider = values.provider;\n  if (values[\"not-ready\"] === true) flags.notReady = true;\n  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n  if (typeof values.message === \"string\") flags.messageId = values.message;\n  if (typeof values.content === \"string\") flags.content = values.content;\n  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n  if (typeof values.form === \"string\") flags.form = values.form;\n  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n  return { ok: true, flags };\n}\n\n// The read commands take a thread reference but no stdin; a missing reference\n// is a usage error named before any SDK call, matching the intake commands.\nfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n  if (flags.threadId === undefined && flags.filePath === undefined) {\n    return renderCliError(\n      \"caller_error\",\n      \"missing_flag\",\n      `${command} requires --thread-id or --file-path`,\n    );\n  }\n  return undefined;\n}\n\nfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n  if (flags.threadId !== undefined) {\n    return flags.registryPath !== undefined\n      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n      : { threadId: flags.threadId };\n  }\n  return { filePath: flags.filePath ?? \"\" };\n}\n\nexport async function runCli(\n  argv: readonly string[],\n  readStdin: StdinReader = readProcessStdin,\n): Promise<CliResult> {\n  if (argv.length === 0) {\n    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n  }\n  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n  }\n\n  const [group, command, ...rest] = argv;\n  // The view group parses its own flag surface (band overrides, --out,\n  // --format) — routed before the shared parse so its flags never widen the\n  // other commands' accepted set.\n  if (group === \"view\") {\n    return runViewCommand(command, rest);\n  }\n  const key = command === undefined ? group : `${group} ${command}`;\n  const parsed = parseFlags(command === undefined ? [] : rest);\n  if (!parsed.ok) {\n    return renderCliError(\n      \"caller_error\",\n      \"unknown_flag\",\n      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n    );\n  }\n  const flags = parsed.flags;\n\n  switch (key) {\n    case \"threads new-thread\": {\n      // Guard here: an empty path reaching node:sqlite opens a temp database\n      // instead of failing, so the adapter refuses before any SDK call.\n      if (flags.filePath === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n      }\n      const input: Parameters<typeof threads.newThread>[0] = {\n        filePath: flags.filePath,\n      };\n      if (flags.title !== undefined) input.title = flags.title;\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.newThread(input));\n    }\n    case \"threads resolve\": {\n      if (flags.threadId === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n      }\n      const input: Parameters<typeof threads.resolve>[0] = {\n        threadId: flags.threadId,\n      };\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.resolve(input));\n    }\n    case \"threads list\": {\n      return renderResult(\n        await threads.listThreads(\n          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n        ),\n      );\n    }\n    case \"intake-stream message-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream message-events requires --thread-id or --file-path\",\n        );\n      }\n      const text = await readStdin();\n      if (text === null || text.trim() === \"\") {\n        return renderResult(\n          stdinCallerError(\n            \"empty_stdin\",\n            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n          ),\n        );\n      }\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(text);\n      } catch (cause) {\n        const detail = cause instanceof Error ? cause.message : String(cause);\n        return renderResult(\n          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n        );\n      }\n      if (!Array.isArray(parsed)) {\n        return renderResult(\n          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n        );\n      }\n      return renderResult(\n        await intakeStream.messageEvents(\n          threadRefFrom(flags),\n          parsed as readonly MessageEventInput[],\n        ),\n      );\n    }\n    case \"intake-stream list-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream list-events requires --thread-id or --file-path\",\n        );\n      }\n      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n    }\n    case \"messages list\":\n      return (\n        requireThreadRef(flags, \"messages list\") ??\n        renderResult(await messages.listMessages(threadRefFrom(flags)))\n      );\n    case \"messages list-queued-work\":\n      return (\n        requireThreadRef(flags, \"messages list-queued-work\") ??\n        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"messages report\": {\n      const missingRef = requireThreadRef(flags, \"messages report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n      return runMessagesReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"messages requeue\": {\n      const missingRef = requireThreadRef(flags, \"messages requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined || flags.form === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages requeue requires --message-id and --form\",\n        );\n      }\n      return runMessagesRequeue(threadRefFrom(flags), {\n        messageId: flags.messageId,\n        form: flags.form,\n      });\n    }\n    case \"messages edit\": {\n      const missingRef = requireThreadRef(flags, \"messages edit\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined || flags.content === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages edit requires --message (or --message-id) and --content\",\n        );\n      }\n      return runMessagesEdit(threadRefFrom(flags), {\n        messageId: flags.messageId,\n        content: flags.content,\n      });\n    }\n    case \"messages delete\": {\n      const missingRef = requireThreadRef(flags, \"messages delete\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages delete requires --message (or --message-id)\",\n        );\n      }\n      return runMessagesDelete(threadRefFrom(flags), { messageId: flags.messageId });\n    }\n    case \"turns list\":\n      return (\n        requireThreadRef(flags, \"turns list\") ??\n        renderResult(await turns.listTurns(threadRefFrom(flags)))\n      );\n    case \"turns list-chunks\":\n      return (\n        requireThreadRef(flags, \"turns list-chunks\") ??\n        renderResult(await turns.listChunks(threadRefFrom(flags)))\n      );\n    case \"turns list-queued-work\":\n      return (\n        requireThreadRef(flags, \"turns list-queued-work\") ??\n        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"turns report\": {\n      const missingRef = requireThreadRef(flags, \"turns report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n      return runTurnsReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"turns requeue\": {\n      const missingRef = requireThreadRef(flags, \"turns requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (\n        flags.subjectKind === undefined ||\n        flags.subjectId === undefined ||\n        flags.form === undefined\n      ) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n        );\n      }\n      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n        );\n      }\n      return runTurnsRequeue(threadRefFrom(flags), {\n        subjectKind: flags.subjectKind,\n        subjectId: flags.subjectId,\n        form: flags.form,\n      });\n    }\n    case \"turns delete\": {\n      const missingRef = requireThreadRef(flags, \"turns delete\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.turnId === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"turns delete requires --turn (or --turn-id)\",\n        );\n      }\n      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\n    }\n    case \"work drain\": {\n      const missingRef = requireThreadRef(flags, \"work drain\");\n      if (missingRef !== undefined) return missingRef;\n      const drainFlags: { provider?: string; maxItems?: number } = {};\n      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n      if (flags.maxItems !== undefined) {\n        const maxItems = Number(flags.maxItems);\n        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n          return renderCliError(\n            \"caller_error\",\n            \"missing_flag\",\n            `--max-items must be a positive integer, got ${flags.maxItems}`,\n          );\n        }\n        drainFlags.maxItems = maxItems;\n      }\n      return runWorkDrain(threadRefFrom(flags), drainFlags);\n    }\n    default:\n      return renderCliError(\n        \"caller_error\",\n        \"unknown_command\",\n        `unknown command: ${key}; run lhc --help`,\n      );\n  }\n}\n","numLines":435,"startLine":1,"totalLines":435}}}

{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '240,420p'\"","aggregated_output":"   240\t}\n   241\t\n   242\tfunction requirePositive(value: number, name: string): void {\n   243\t  if (!Number.isFinite(value) || value <= 0) {\n   244\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   245\t  }\n   246\t}\n   247\t\n   248\tfunction requireNonNegative(value: number, name: string): void {\n   249\t  if (!Number.isFinite(value) || value < 0) {\n   250\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   251\t  }\n   252\t}\n   253\t\n   254\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   255\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   256\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   257\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   258\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   259\t// object is the same shape as the namespace, so the public surface type holds.\n   260\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   261\t  const scoped: Record<string, unknown> = {};\n   262\t  for (const key of Object.keys(surface)) {\n   263\t    const value = (surface as Record<string, unknown>)[key];\n   264\t    scoped[key] =\n   265\t      typeof value === \"function\"\n   266\t        ? (...args: unknown[]): unknown =>\n   267\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   268\t        : value;\n   269\t  }\n   270\t  return scoped as T;\n   271\t}\n   272\t\n   273\t// The only assembly path: provider, mode, clock, and policy enter here.\n   274\t// Config mistakes are programmer errors at construction and throw; operating\n   275\t// failures after construction return OpResults per the error contract.\n   276\texport function createSdk(config: SdkConfig): Lhc {\n   277\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   278\t    throw new TypeError(\n   279\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   280\t    );\n   281\t  }\n   282\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   283\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   284\t  }\n   285\t  for (const operation of PROVIDER_OPERATIONS) {\n   286\t    if (typeof config.provider[operation] !== \"function\") {\n   287\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   288\t    }\n   289\t  }\n   290\t\n   291\t  const resolved: ResolvedSdkConfig = {\n   292\t    provider: config.provider,\n   293\t    mode: config.mode,\n   294\t    clock: config.clock ?? (() => new Date()),\n   295\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   296\t    lease: config.lease ?? { durationMs: 120000 },\n   297\t    chunkPolicy:\n   298\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   299\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   300\t    // sums and visibility budgets validated — throws naming the violation.\n   301\t    view: resolveViewConfig(config.view),\n   302\t  };\n   303\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   304\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   305\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   306\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   307\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   308\t  }\n   309\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   310\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   311\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   312\t    throw new TypeError(\n   313\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   314\t    );\n   315\t  }\n   316\t\n   317\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   318\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   319\t  // assembly mechanics are production code from day one.\n   320\t  const workHandlers = assembleWorkHandlerMap([\n   321\t    messagesDomain.workHandlers,\n   322\t    turnsDomain.workHandlers,\n   323\t  ]);\n   324\t\n   325\t  const drainDeps: DrainDeps = {\n   326\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   327\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   328\t    config: resolved,\n   329\t  };\n   330\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   331\t\n   332\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   333\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   334\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   335\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   336\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   337\t  // the construction order, because its operations deliver to the no-op seam,\n   338\t  // not to whatever a background SDK installed below.\n   339\t  // The seam also carries this instance's resolved view config (Epic 03,\n   340\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n   341\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n   342\t  // fall back to the built-in defaults inside the thread-view surface.\n   343\t  const seam: InstanceSeam =\n   344\t    resolved.mode === \"background\"\n   345\t      ? {\n   346\t          poke: (threadId) => scheduler.poke(threadId),\n   347\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   348\t          view: resolved.view,\n   349\t        }\n   350\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n   351\t\n   352\t  // Background mode also installs the below-SDK default seam so a direct\n   353\t  // domain call made with no SDK scope — a top-level mutation in the\n   354\t  // single-background \"production path\" — still reaches the one installed\n   355\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   356\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   357\t  // leaves the default alone (pokes stay no-ops by contract).\n   358\t  if (resolved.mode === \"background\") {\n   359\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   360\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   361\t  }\n   362\t\n   363\t  const work: WorkSurface = {\n   364\t    drain: (ref, opts) =>\n   365\t      runWithInstanceSeam(seam, async () => {\n   366\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   367\t        if (!resolvedRef.ok) return resolvedRef;\n   368\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   369\t      }),\n   370\t  };\n   371\t\n   372\t  return {\n   373\t    threads: threadsDomain,\n   374\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n   375\t    messages: scopeSurface(messagesDomain, seam),\n   376\t    turns: scopeSurface(turnsDomain, seam),\n   377\t    threadView: scopeSurface<ThreadViewSurface>(\n   378\t      {\n   379\t        pull: threadViewDomain.pull,\n   380\t        status: threadViewDomain.status,\n   381\t        compact: threadViewDomain.compact,\n   382\t        sweep: threadViewDomain.sweep,\n   383\t        materialize: threadViewDomain.materialize,\n   384\t      },\n   385\t      seam,\n   386\t    ),\n   387\t    config: resolved,\n   388\t    scheduler,\n   389\t    workHandlers,\n   390\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   391\t    work,\n   392\t    drainSettled: async (ref) => {\n   393\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   394\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   395\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   396\t      if (threadId === null) return;\n   397\t      return scheduler.drainSettled(threadId);\n   398\t    },\n   399\t  };\n   400\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/messages-read.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 1 (Epic 04), default suite: TC-3.1–3.3 — the message read surface.\n     2\t// Bounded listing in source-event-order coordinates (DD-3), show returning\n     3\t// the canonical record (full blocks, never view-shortened) composed with the\n     4\t// owner report's form entries (DD-2), and the deleted-audit contract\n     5\t// (excluded by default, listable flagged on request, show never not-found).\n     6\t// Plus the architecture-risk legs: every read leaves observable state\n     7\t// unchanged (read-only delta, DD-6) and calls no provider.\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport {\n    10\t  createSdk,\n    11\t  intakeStream,\n    12\t  messages,\n    13\t  threadView,\n    14\t  turns,\n    15\t  type Lhc,\n    16\t  type MessageEventInput,\n    17\t} from \"../src/index.js\";\n    18\timport {\n    19\t  createProviderDouble,\n    20\t  readDerivedForms,\n    21\t  tempStore,\n    22\t  validEvent,\n    23\t  type TempStore,\n    24\t} from \"./fixtures/index.js\";\n    25\t\n    26\t// Long enough that any view-form shortening would be visible: show must\n    27\t// return this verbatim (AC-3.2's record-not-view contract).\n    28\tconst TOOL_RESULT_CONTENT = [\n    29\t  \"contents of notes.txt — full record content:\",\n    30\t  \"line 1: the quick brown fox jumps over the lazy dog\",\n    31\t  \"line 2: detailed tool output that a boundary-shortened form would drop\",\n    32\t  \"line 3: trailing detail proving the record came back complete\",\n    33\t].join(\"\\n\");\n    34\t\n    35\tinterface ReadFixture {\n    36\t  filePath: string;\n    37\t  sdk: Lhc;\n    38\t  double: ReturnType<typeof createProviderDouble>;\n    39\t}\n    40\t\n    41\t// Two closed turns through real intake, fully drained against the\n    42\t// deterministic double so m1's smoothing and m3/m4's tool summaries sit\n    43\t// ready with mechanically stamped outcome metadata. Messages: m1 prompt,\n    44\t// m2 text, m3 call, m4 result (turn 1; turn_end is event 5, no message);\n    45\t// m6 prompt, m7 text (turn 2). Source event orders 1,2,3,4,6,7.\n    46\tasync function readFixture(store: TempStore): Promise<ReadFixture> {\n    47\t  const double = createProviderDouble();\n    48\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n    49\t  const filePath = store.threadPath();\n    50\t  const created = await sdk.threads.newThread({\n    51\t    filePath,\n    52\t    registryPath: store.registryPath,\n    53\t  });\n    54\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    55\t  const batches: MessageEventInput[][] = [\n    56\t    [\n    57\t      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n    58\t      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n    59\t      validEvent(\"tool_call\", {\n    60\t        payload: {\n    61\t          toolCallId: \"call-read-1\",\n    62\t          toolName: \"read_file\",\n    63\t          arguments: { path: \"notes.txt\" },\n    64\t        },\n    65\t      }),\n    66\t      validEvent(\"tool_result\", {\n    67\t        payload: { toolCallId: \"call-read-1\", content: TOOL_RESULT_CONTENT, isError: false },\n    68\t      }),\n    69\t      validEvent(\"turn_end\"),\n    70\t    ],\n    71\t    [\n    72\t      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n    73\t      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n    74\t      validEvent(\"turn_end\"),\n    75\t    ],\n    76\t  ];\n    77\t  for (const batch of batches) {\n    78\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    79\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n    80\t  }\n    81\t  const drained = await sdk.work.drain({ filePath });\n    82\t  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\n    83\t  if (drained.value.remaining !== 0) {\n    84\t    throw new Error(`fixture drain left ${drained.value.remaining} items behind`);\n    85\t  }\n    86\t  return { filePath, sdk, double };\n    87\t}\n    88\t\n    89\tfunction idsOf(result: { ok: boolean }): string[] {\n    90\t  if (!result.ok) throw new Error(\"expected an ok list result\");\n    91\t  return (result as { ok: true; value: Array<{ messageId: string }> }).value.map(\n    92\t    (record) => record.messageId,\n    93\t  );\n    94\t}\n    95\t\n    96\t// The DD-6 observable-state snapshot: queued work through both owners, view\n    97\t// boundary/zone through status, derived-form rows, and the event log. A read\n    98\t// that mutates any of these fails the before/after deep-equal.\n    99\tasync function observableState(filePath: string): Promise<Record<string, unknown>> {\n   100\t  return {\n   101\t    events: await intakeStream.listEvents({ filePath }),\n   102\t    messageWork: await messages.listQueuedWork({ filePath }),\n   103\t    turnWork: await turns.listQueuedWork({ filePath }),\n   104\t    viewStatus: await threadView.status({ filePath }),\n   105\t    forms: readDerivedForms(filePath),\n   106\t  };\n   107\t}\n   108\t\n   109\tlet store: TempStore;\n   110\tbeforeEach(() => {\n   111\t  store = tempStore();\n   112\t});\n   113\tafterEach(() => {\n   114\t  store.cleanup();\n   115\t});\n   116\t\n   117\tdescribe(\"TC-3.1 / AC-3.1: listing order, fields, and bounds\", () => {\n   118\t  it(\"returns messages in record order with kind, token estimate, and turn membership\", async () => {\n   119\t    const { filePath } = await readFixture(store);\n   120\t    const listed = await messages.listMessages({ filePath });\n   121\t    expect(listed.ok).toBe(true);\n   122\t    if (!listed.ok) return;\n   123\t    expect(listed.value.map((m) => m.messageId)).toEqual([\n   124\t      \"m1\",\n   125\t      \"m2\",\n   126\t      \"m3\",\n   127\t      \"m4\",\n   128\t      \"m6\",\n   129\t      \"m7\",\n   130\t    ]);\n   131\t    expect(listed.value.map((m) => m.sourceEventOrder)).toEqual([1, 2, 3, 4, 6, 7]);\n   132\t    expect(listed.value.map((m) => m.kind)).toEqual([\n   133\t      \"user_prompt\",\n   134\t      \"assistant_text\",\n   135\t      \"tool_call\",\n   136\t      \"tool_result\",\n   137\t      \"user_prompt\",\n   138\t      \"assistant_text\",\n   139\t    ]);\n   140\t    expect(listed.value.map((m) => m.turnId)).toEqual([\"t1\", \"t1\", \"t1\", \"t1\", \"t2\", \"t2\"]);\n   141\t    for (const record of listed.value) {\n   142\t      expect(record.tokenEstimate).toBeGreaterThan(0);\n   143\t      expect(record.deleted).toBeUndefined();\n   144\t    }\n   145\t  });\n   146\t\n   147\t  it(\"honors from/to/limit windows exactly in source-event-order coordinates\", async () => {\n   148\t    const { filePath } = await readFixture(store);\n   149\t    const windows: Array<[Parameters<typeof messages.listMessages>[1], string[]]> = [\n   150\t      [{ from: 2, to: 4 }, [\"m2\", \"m3\", \"m4\"]],\n   151\t      [{ from: 6 }, [\"m6\", \"m7\"]],\n   152\t      [{ to: 2 }, [\"m1\", \"m2\"]],\n   153\t      [{ limit: 3 }, [\"m1\", \"m2\", \"m3\"]],\n   154\t      [{ from: 2, limit: 2 }, [\"m2\", \"m3\"]],\n   155\t      [{ from: 4, to: 4 }, [\"m4\"]],\n   156\t      [{ from: 5, to: 5 }, []], // the turn_end order: an event, never a message\n   157\t    ];\n   158\t    for (const [opts, expected] of windows) {\n   159\t      expect(idsOf(await messages.listMessages({ filePath }, opts))).toEqual(expected);\n   160\t    }\n   161\t  });\n   162\t\n   163\t  it(\"refuses bad bounds as caller errors and returns no partial window\", async () => {\n   164\t    const { filePath } = await readFixture(store);\n   165\t    const badBounds = [{ from: 5, to: 2 }, { limit: 0 }, { limit: -1 }, { from: 1.5 }];\n   166\t    for (const opts of badBounds) {\n   167\t      const refused = await messages.listMessages({ filePath }, opts);\n   168\t      expect(refused.ok).toBe(false);\n   169\t      if (refused.ok) continue;\n   170\t      expect(refused.error.errorClass).toBe(\"caller_error\");\n   171\t      expect(refused.error.code).toBe(\"invalid_bounds\");\n   172\t    }\n   173\t  });\n   174\t});\n   175\t\n   176\tdescribe(\"TC-3.2 / AC-3.2: show returns the full record with owner-reported forms\", () => {\n   177\t  it(\"a drained tool-result message comes back with full content, form states, and outcome metadata\", async () => {\n   178\t    const { filePath } = await readFixture(store);\n   179\t    const shown = await messages.show({ filePath }, \"m4\");\n   180\t    expect(shown.ok).toBe(true);\n   181\t    if (!shown.ok) return;\n   182\t    const detail = shown.value;\n   183\t    expect(detail.messageId).toBe(\"m4\");\n   184\t    expect(detail.kind).toBe(\"tool_result\");\n   185\t    expect(detail.turnId).toBe(\"t1\");\n   186\t    expect(detail.deleted).toBe(false);\n   187\t    expect(detail.tokenEstimate).toBeGreaterThan(0);\n   188\t    // The record, not the view: the complete original tool result verbatim.\n   189\t    expect(detail.blocks).toHaveLength(1);\n   190\t    expect(detail.blocks[0]?.blockType).toBe(\"tool_result\");\n   191\t    expect(detail.blocks[0]?.content[\"content\"]).toBe(TOOL_RESULT_CONTENT);\n   192\t    expect(detail.blocks[0]?.content[\"toolCallId\"]).toBe(\"call-read-1\");\n   193\t    // Forms with states and tool-outcome metadata, joined from the owner.\n   194\t    expect(detail.forms).toHaveLength(1);\n   195\t    const summary = detail.forms[0];\n   196\t    expect(summary?.form).toBe(\"tool_result_summary\");\n   197\t    expect(summary?.state).toBe(\"ready\");\n   198\t    expect(summary?.content).toBeDefined();\n   199\t    expect(summary?.metadata?.outcome).toBe(\"succeeded\");\n   200\t    // Anti-shim: the forms ARE the owner report's entries for this message,\n   201\t    // never a synthesized join (DD-2).\n   202\t    const report = await messages.report({ filePath }, { messageId: \"m4\" });\n   203\t    expect(report.ok).toBe(true);\n   204\t    if (!report.ok) return;\n   205\t    expect(detail.forms).toEqual(report.value);\n   206\t  });\n   207\t\n   208\t  it(\"a drained prompt shows its smoothing form alongside the full record\", async () => {\n   209\t    const { filePath } = await readFixture(store);\n   210\t    const shown = await messages.show({ filePath }, \"m1\");\n   211\t    expect(shown.ok).toBe(true);\n   212\t    if (!shown.ok) return;\n   213\t    expect(shown.value.blocks[0]?.content[\"text\"]).toBe(\"please read notes.txt\");\n   214\t    expect(shown.value.forms.map((form) => [form.form, form.state])).toEqual([\n   215\t      [\"smoothed_prompt\", \"ready\"],\n   216\t    ]);\n   217\t  });\n   218\t});\n   219\t\n   220\tdescribe(\"TC-3.3 / AC-3.3: deleted messages are audit-visible, never silently mixed\", () => {\n   221\t  it(\"default list excludes a deleted message; include-deleted lists it marked; show returns it flagged\", async () => {\n   222\t    const { filePath } = await readFixture(store);\n   223\t    const deleted = await messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n   224\t    expect(deleted.ok).toBe(true);\n   225\t\n   226\t    const defaultList = await messages.listMessages({ filePath });\n   227\t    expect(idsOf(defaultList)).toEqual([\"m1\", \"m3\", \"m4\", \"m6\", \"m7\"]);\n   228\t\n   229\t    const audited = await messages.listMessages({ filePath }, { includeDeleted: true });\n   230\t    expect(audited.ok).toBe(true);\n   231\t    if (!audited.ok) return;\n   232\t    expect(audited.value.map((m) => m.messageId)).toEqual([\n   233\t      \"m1\",\n   234\t      \"m2\",\n   235\t      \"m3\",\n   236\t      \"m4\",\n   237\t      \"m6\",\n   238\t      \"m7\",\n   239\t    ]);\n   240\t    for (const record of audited.value) {\n   241\t      if (record.messageId === \"m2\") expect(record.deleted).toBe(true);\n   242\t      else expect(record.deleted).toBeUndefined();\n   243\t    }\n   244\t\n   245\t    // Show on the deleted message is the audit read: the record, flagged —\n   246\t    // never a not-found.\n   247\t    const shown = await messages.show({ filePath }, \"m2\");\n   248\t    expect(shown.ok).toBe(true);\n   249\t    if (!shown.ok) return;\n   250\t    expect(shown.value.deleted).toBe(true);\n   251\t    expect(shown.value.blocks[0]?.content[\"text\"]).toBe(\"reading it now\");\n   252\t  });\n   253\t\n   254\t  it(\"show on a missing id is message_not_found\", async () => {\n   255\t    const { filePath } = await readFixture(store);\n   256\t    const missing = await messages.show({ filePath }, \"m99\");\n   257\t    expect(missing.ok).toBe(false);\n   258\t    if (missing.ok) return;\n   259\t    expect(missing.error.errorClass).toBe(\"caller_error\");\n   260\t    expect(missing.error.code).toBe(\"message_not_found\");\n   261\t  });\n   262\t});\n   263\t\n   264\tdescribe(\"architecture risk: reads are read-only and provider-free (DD-6)\", () => {\n   265\t  it(\"list and show in every mode leave observable state unchanged and call no provider\", async () => {\n   266\t    const { filePath, double } = await readFixture(store);\n   267\t    const captured = double.captureInputs();\n   268\t    const before = await observableState(filePath);\n   269\t\n   270\t    await messages.listMessages({ filePath });\n   271\t    await messages.listMessages({ filePath }, { from: 2, to: 4, limit: 2 });\n   272\t    await messages.listMessages({ filePath }, { includeDeleted: true });\n   273\t    await messages.listMessages({ filePath }, { from: 9, to: 1 }); // refused, must not write either\n   274\t    await messages.show({ filePath }, \"m4\");\n   275\t    await messages.show({ filePath }, \"m99\"); // not-found, must not write either\n   276\t\n   277\t    const after = await observableState(filePath);\n   278\t    expect(after).toEqual(before);\n   279\t    expect(captured).toHaveLength(0);\n   280\t  });\n   281\t});\n","exit_code":0,"status":"completed"}}

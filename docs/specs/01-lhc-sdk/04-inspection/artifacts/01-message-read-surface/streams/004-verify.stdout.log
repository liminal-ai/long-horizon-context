estamp: string }>;\n   117\t  meta: PullResult[\"meta\"];\n   118\t  snapshot: ReturnType<typeof readViewSnapshot>;\n   119\t}\n   120\t\n   121\tfunction assembleView(db: Parameters<typeof readViewSnapshot>[0]): AssembledView {\n   122\t  const snapshot = readViewSnapshot(db);\n   123\t  const compactPoint = snapshot?.compactPoint ?? 0;\n   124\t  const boundaryPosition = readBoundaryPosition(db);\n   125\t  const tailRows = readTailMessages(db, compactPoint);\n   126\t  const renderCtx = {\n   127\t    boundaryPosition,\n   128\t    toolNameByCallId: toolNamesByCallId(tailRows),\n   129\t    toolResultSummaries: readReadyToolResultSummaries(db),\n   130\t  };\n   131\t\n   132\t  const entries: AssembledView[\"entries\"] = [];\n   133\t  if (snapshot !== null) {\n   134\t    for (const band of snapshot.bands) {\n   135\t      entries.push({\n   136\t        message: renderBandMessage(band.band, band.renderedText),\n   137\t        // Band entries are not record messages; their generated fields\n   138\t        // derive from view metadata (AC-5.2).\n   139\t        entryId: `${snapshot.viewId}-${band.band}`,\n   140\t        timestamp: snapshot.createdAt,\n   141\t      });\n   142\t    }\n   143\t  }\n   144\t  for (const row of tailRows) {\n   145\t    entries.push({\n   146\t      message: renderTailMessage(row, renderCtx),\n   147\t      entryId: row.messageId,\n   148\t      timestamp: row.recordedAt,\n   149\t    });\n   150\t  }\n   151\t\n   152\t  return {\n   153\t    entries,\n   154\t    meta: {\n   155\t      compactPoint: snapshot?.compactPoint ?? null,\n   156\t      coveredFrom: snapshot?.coveredFrom ?? null,\n   157\t      boundaryPosition,\n   158\t      gapCount: snapshot?.gapCount ?? 0,\n   159\t      degradedCount: snapshot?.degradedCount ?? 0,\n   160\t      viewId: snapshot?.viewId ?? null,\n   161\t      createdAt: snapshot?.createdAt ?? null,\n   162\t    },\n   163\t    snapshot,\n   164\t  };\n   165\t}\n   166\t\n   167\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   168\t  const resolved = await resolveThreadRef(ref);\n   169\t  if (!resolved.ok) return resolved;\n   170\t  const { filePath } = resolved.value;\n   171\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   172\t\n   173\t  const opened = openThreadDatabase(filePath);\n   174\t  if (!opened.ok) return opened;\n   175\t  const db = opened.value;\n   176\t  try {\n   177\t    const assembled = assembleView(db);\n   178\t    return {\n   179\t      ok: true,\n   180\t      value: {\n   181\t        messages: assembled.entries.map((entry) => entry.message),\n   182\t        meta: assembled.meta,\n   183\t      },\n   184\t    };\n   185\t  } catch (cause) {\n   186\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n   187\t  } finally {\n   188\t    db.close();\n   189\t  }\n   190\t}\n   220\t// Reads only, callable any time, no side effects: tail size against the\n   221\t// configured trigger threshold with a compact recommendation (`tailTokens >\n   222\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n   223\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n   224\t// direct derived_form read here), the active view's health or null\n   225\t// pre-compact, and the visibility zone's sum against its max — computed live\n   226\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n   227\t// structural, not stored.\n   228\t//\n   229\t// Like pull, the whole read — including the owners' report surfaces it\n   230\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n   231\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n   232\t// host modes).\n   233\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   234\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n   235\t}\n   236\t\n   237\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   238\t  const resolved = await resolveThreadRef(ref);\n   239\t  if (!resolved.ok) return resolved;\n   240\t  const { filePath } = resolved.value;\n   241\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   242\t\n   243\t  const config = viewConfig();\n   244\t  const opened = openThreadDatabase(filePath);\n   245\t  if (!opened.ok) return opened;\n   246\t  const db = opened.value;\n   247\t  let tailTokens: number;\n   248\t  let zoneTokens: number;\n   249\t  let view: ViewStatus[\"view\"];\n   250\t  try {\n   251\t    const snapshot = readViewSnapshot(db);\n   252\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   253\t    const boundaryPosition = readBoundaryPosition(db);\n   254\t    tailTokens = tailTokenSum(db, compactPoint);\n   255\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n   256\t    view =\n   257\t      snapshot === null\n   258\t        ? null\n   259\t        : {\n   260\t            degraded: snapshot.degradedCount,\n","exit_code":0,"status":"completed"}}

,\n    46\t  TOKEN_ESTIMATOR_ID,\n    47\t} from \"./tech-utils/token-counting/index.js\";\n    48\t\n    49\texport {\n    50\t  WORK_KIND_REGISTRY,\n    51\t  type WorkItemRecord,\n    52\t  type WorkKind,\n    53\t  type WorkOwner,\n    54\t  type WorkSourceRef,\n    55\t} from \"./tech-utils/work-queue/index.js\";\n    56\t\n    57\texport type {\n    58\t  ErrorClass,\n    59\t  ErrorCode,\n    60\t  ErrorResult,\n    61\t  OpResult,\n    62\t} from \"./shared/errors.js\";\n    63\texport {\n    64\t  runInTransaction,\n    65\t  setSchedulerPoke,\n    66\t  setThreadTouch,\n    67\t  type OperationContext,\n    68\t} from \"./shared/context.js\";\n    69\t\n    70\texport {\n    71\t  createDeterministicProvider,\n    72\t  deterministicOutcomesSuffix,\n    73\t  deterministicReceiptsSuffix,\n    74\t  deterministicText,\n    75\t  type DeterministicOpName,\n    76\t} from \"./providers/deterministic.js\";\n    77\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n    78\t\n    79\texport type {\n    80\t  CompletionTx,\n    81\t  DependencyGap,\n    82\t  DerivationProvider,\n    83\t  DerivedForm,\n    84\t  DerivedFormMetadata,\n    85\t  DerivedFormState,\n    86\t  FormKind,\n    87\t  FormReportEntry,\n    88\t  HandlerFormWrite,\n    89\t  HandlerOutcome,\n    90\t  HandlerRunContext,\n    91\t  ProviderResult,\n    92\t  RenderingPart,\n    93\t  ResolvedSdkConfig,\n    94\t  SdkConfig,\n    95\t  SubjectKind,\n    96\t  ToolOutcome,\n    97\t  ToolRunReceipt,\n    98\t  WorkHandler,\n    99\t} from \"./shared/derivation.js\";\n   100\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n   101\t\n   102\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n   103\t// from Story 0; the operation shapes land with Stories 1–5.\n   104\texport {\n   105\t  BUILT_IN_PROFILES,\n   106\t  DEFAULT_COMPACT_THRESHOLD,\n   107\t  DEFAULT_VISIBILITY,\n   108\t} from \"./domains/thread-view/index.js\";\n   109\texport type {\n   110\t  Band,\n   111\t  CompactReceipt,\n   112\t  PullResult,\n   113\t  ResolvedViewConfig,\n   114\t  SdkViewConfig,\n   115\t  SweepReceipt,\n   116\t  ViewCompactParams,\n   117\t  ViewMessage,\n   118\t  ViewMeta,\n   119\t  ViewProfile,\n   120\t  ViewProfileOverride,\n   121\t  ViewStatus,\n   122\t  VisibilityBudgets,\n   123\t} from \"./shared/view.js\";\n   124\texport {\n   125\t  countLiveItems,\n   126\t  enqueue,\n   127\t  queueDetail,\n   128\t  supersedeQueued,\n   129\t  type ClaimedWorkItem,\n   130\t  type EnqueueFormTarget,\n   131\t  type EnqueueInput,\n   132\t  type QueueDetailRow,\n   133\t} from \"./tech-utils/work-queue/index.js\";\n   134\t\n   135\texport type { ThreadRef } from \"./domains/threads/index.js\";\n   136\texport type {\n   137\t  Block,\n   138\t  BlockType,\n   139\t  MessageDetail,\n   140\t  MessageListOptions,\n   141\t  MessageRecord,\n   142\t  MutationResult,\n   143\t} from \"./domains/messages/index.js\";\n   144\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   145\texport type {\n   146\t  BatchResult,\n   147\t  EventKind,\n   148\t  EventRecord,\n   149\t  MessageEventInput,\n   150\t} from \"./domains/intake-stream/index.js\";\n   151\t\n   152\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   153\t\n   154\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   155\t\n   156\t// Merge per-domain handler tables into the one join between the queue's\n   157\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   158\t// (each kind has exactly one owner) and throws at construction.\n   159\texport function assembleWorkHandlerMap(\n   160\t  tables: ReadonlyArray<WorkHandlerMap>,\n   161\t): WorkHandlerMap {\n   162\t  const map: WorkHandlerMap = {};\n   163\t  for (const table of tables) {\n   164\t    for (const [kind, handler] of Object.entries(table)) {\n   165\t      if (map[kind as WorkKind] !== undefined) {\n   166\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   167\t      }\n   168\t      map[kind as WorkKind] = handler;\n   169\t    }\n   170\t  }\n   171\t  return map;\n   172\t}\n   173\t\n   174\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   175\t  return {\n   176\t    ok: false,\n   177\t    error: {\n   178\t      errorClass: \"state_corruption\",\n   179\t      code: \"unknown_work_kind\",\n   180\t      reason: `no handler registered for work kind \"${kind}\"`,\n   181\t    },\n   182\t  };\n   183\t}\n   184\t\n   185\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   186\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   187\texport function lookupWorkHandler(\n   188\t  map: WorkHandlerMap,\n   189\t  kind: string,\n   190\t): OpResult<WorkHandler> {\n   191\t  const handler = map[kind as WorkKind];\n   192\t  if (handler === undefined) return unknownWorkKind(kind);\n   193\t  return { ok: true, value: handler };\n   194\t}\n   195\t\n   196\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   197\t// requeue land in Story 4.\n   198\texport interface WorkSurface {\n   199\t  drain(\n   200\t    ref: threadsDomain.ThreadRef,\n   201\t    opts?: { maxItems?: number },\n   202\t  ): Promise<OpResult<DrainReport>>;\n   203\t}\n   204\t\n   205\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n   206\t// §Interface Definitions): the five operations only — the Story 0 config\n   207\t// substrate the domain index also carries is construction machinery, not an\n   208\t// operation. pull and status are real from Story 1; compact, sweep, and\n   209\t// materialize return structured not-implemented results until their stories\n   210\t// land.\n   211\texport interface ThreadViewSurface {\n   212\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n   213\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n   214\t  compact(\n   215\t    ref: threadsDomain.ThreadRef,\n   216\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   217\t  ): Promise<OpResult<CompactReceipt>>;\n   218\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n   219\t  materialize(\n   220\t    ref: threadsDomain.ThreadRef,\n   221\t    opts: { path: string; format?: \"pi-session\" },\n   222\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   223\t}\n   224\t\n   225\texport interface Lhc {\n   226\t  threads: typeof threadsDomain;\n   227\t  intakeStream: typeof intakeStreamDomain;\n   228\t  messages: typeof messagesDomain;\n   229\t  turns: typeof turnsDomain;\n   230\t  threadView: ThreadViewSurface;\n   231\t  config: ResolvedSdkConfig;\n   232\t  scheduler: Scheduler;\n   233\t  workHandlers: WorkHandlerMap;\n   234\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   235\t  work: WorkSurface;\n   236\t  // Resolves when the scheduler has no running or pending drain for the\n   237\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   238\t  // resolve in manual mode.\n   239\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   240\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '1,500p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     5\timport {\n     6\t  enqueue,\n     7\t  hasLiveItem,\n     8\t  listItems,\n     9\t  type WorkItemRecord,\n    10\t  type WorkKind,\n    11\t} from \"../../tech-utils/work-queue/index.js\";\n    12\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    13\timport {\n    14\t  openThreadDatabase,\n    15\t  resolveThreadRef,\n    16\t  type ThreadRef,\n    17\t} from \"../threads/index.js\";\n    18\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    19\timport {\n    20\t  findUnknownOutcomeCallSummary,\n    21\t  readMessageFormRow,\n    22\t  readMessageForms,\n    23\t  reportMessageForms,\n    24\t} from \"./internal/forms.js\";\n    25\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n    26\timport { projectEvent } from \"./internal/project.js\";\n    27\timport {\n    28\t  cascadeFromMessage,\n    29\t  cascadeMessageDelete,\n    30\t  cascadeTurnDelete,\n    31\t  type CascadeClear,\n    32\t  type CascadeOutcome,\n    33\t} from \"./internal/cascade.js\";\n    34\timport {\n    35\t  applyMessageEdit,\n    36\t  insertMessage,\n    37\t  markMessageDeleted,\n    38\t  markTurnMessagesDeleted,\n    39\t  readMessageById,\n    40\t  readMessages,\n    41\t  readMutableMessage,\n    42\t} from \"./internal/store.js\";\n    43\t\n    44\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    45\t\n    46\texport interface Block {\n    47\t  blockType: BlockType;\n    48\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    49\t}\n    50\t\n    51\texport interface MessageRecord {\n    52\t  messageId: string;\n    53\t  sourceEventOrder: number;\n    54\t  kind: Exclude<EventKind, \"turn_end\">;\n    55\t  blocks: Block[];\n    56\t  tokenEstimate: number;\n    57\t  actor: string;\n    58\t  harness: string;\n    59\t  turnId?: string;\n    60\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n    61\t  // for messages that are derivation sources — kinds with no derivable form\n    62\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n    63\t  // never re-derived on read.\n    64\t  forms?: DerivedForm[];\n    65\t  // The deleted-audit marker (Epic 04 AC-3.3): present (true) only on\n    66\t  // deleted records, which only the includeDeleted listing and the show\n    67\t  // read ever surface — a default list never carries the key.\n    68\t  deleted?: boolean;\n    69\t}\n    70\t\n    71\t// The event as the walk holds it after recording: the validated input plus\n    72\t// its server-stamped order and timestamp.\n    73\texport type RecordedEvent = EventRecord;\n    74\t\n    75\texport type MessageCreated = {\n    76\t  messageId: string;\n    77\t  kind: Exclude<EventKind, \"turn_end\">;\n    78\t  // Carried for tool activity only: the pairing key the queue sites need —\n    79\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n    80\t  toolCallId?: string;\n    81\t} | null;\n    82\t\n    83\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    84\t// (the first such call through the operation context; turns.applyEvent\n    85\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    86\t// projection failure propagates to the pipeline's catch and rejects the\n    87\t// whole batch — recorded events without messages is the stranded state the\n    88\t// transaction exists to prevent. Returns null for turn_end (no message).\n    89\t// turnId is the membership stamp, settled by the pipeline before this call:\n    90\t// the turn open *after* this event's transition (so a prompt belongs to the\n    91\t// turn it just opened), or null in a gap — written once, never updated.\n    92\texport function createFromEvent(\n    93\t  ctx: OperationContext,\n    94\t  event: RecordedEvent,\n    95\t  turnId: string | null,\n    96\t): MessageCreated {\n    97\t  const projected = projectEvent(event);\n    98\t  if (projected === null) return null;\n    99\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n   100\t  const messageId = `m${event.eventOrder}`;\n   101\t  insertMessage(ctx.db, {\n   102\t    messageId,\n   103\t    sourceEventOrder: event.eventOrder,\n   104\t    kind,\n   105\t    tokenEstimate: projected.tokenEstimate,\n   106\t    actor: event.actor,\n   107\t    harness: event.harness,\n   108\t    turnId,\n   109\t    blocks: projected.blocks,\n   110\t  });\n   111\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n   112\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n   113\t  }\n   114\t  return { messageId, kind };\n   115\t}\n   116\t\n   117\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n   118\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n   119\t// tool result queues tool_result_summary, nothing else queues anything —\n   120\t// text, thinking, and note messages are not derivation sources (Epic 01\n   121\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   122\t// intake-stream inside the batch transaction for every recorded message, so\n   123\t// the item commits (or rolls back) with the batch.\n   124\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   125\t  user_prompt: \"prompt_smoothing\",\n   126\t  tool_call: \"tool_call_summary\",\n   127\t  tool_result: \"tool_result_summary\",\n   128\t};\n   129\t\n   130\t// Which derived form each message-owned kind produces — the owning domain's\n   131\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   132\t// rides the same transaction (DD-5).\n   133\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n   134\t  prompt_smoothing: \"smoothed_prompt\",\n   135\t  tool_call_summary: \"tool_call_summary\",\n   136\t  tool_result_summary: \"tool_result_summary\",\n   137\t};\n   138\t\n   139\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   140\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n   141\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   142\t  messageWorkHandlers;\n   143\t\n   144\texport function queueMessageWork(\n   145\t  ctx: OperationContext,\n   146\t  message: MessageCreated,\n   147\t): WorkItemRecord[] {\n   148\t  if (message === null) return [];\n   149\t  const items: WorkItemRecord[] = [];\n   150\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   151\t  if (kind !== undefined) {\n   152\t    const form = MESSAGE_WORK_FORMS[kind];\n   153\t    if (form === undefined) {\n   154\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   155\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   156\t    }\n   157\t    items.push(\n   158\t      enqueue(ctx, {\n   159\t        owner: \"messages\",\n   160\t        kind,\n   161\t        sourceRef: { messageId: message.messageId },\n   162\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n   163\t      }),\n   164\t    );\n   165\t  }\n   166\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n   167\t  // summary already derived with outcome \"unknown\" means the summary's\n   168\t  // source — the call+result pair — completed underneath it; clear and\n   169\t  // regenerate at the next source version, in this same batch transaction.\n   170\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n   171\t  // the common call-and-result-in-one-batch case never triggers, and the\n   172\t  // version-scoped item id keeps the requeue idempotent.\n   173\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n   174\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n   175\t    if (stale !== undefined) {\n   176\t      items.push(\n   177\t        enqueue(ctx, {\n   178\t          owner: \"messages\",\n   179\t          kind: \"tool_call_summary\",\n   180\t          sourceRef: { messageId: stale.messageId },\n   181\t          sourceVersion: stale.sourceVersion + 1,\n   182\t          forms: [\n   183\t            {\n   184\t              subjectKind: \"message\",\n   185\t              subjectId: stale.messageId,\n   186\t              form: \"tool_call_summary\",\n   187\t            },\n   188\t          ],\n   189\t        }),\n   190\t      );\n   191\t    }\n   192\t  }\n   193\t  return items;\n   194\t}\n   195\t\n   196\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   197\t  return {\n   198\t    ok: false,\n   199\t    error: {\n   200\t      errorClass: \"caller_error\",\n   201\t      code: \"thread_not_found\",\n   202\t      reason: `no thread file exists at ${filePath}`,\n   203\t    },\n   204\t  };\n   205\t}\n   206\t\n   207\t// Bounded-listing options (Epic 04 Story 1, DD-3): from/to are\n   208\t// source-event-order bounds, limit caps the count after bounds,\n   209\t// includeDeleted is the audit opt-in. All optional — existing callers see\n   210\t// identical results (visible messages, unbounded, record order).\n   211\texport interface MessageListOptions {\n   212\t  from?: number;\n   213\t  to?: number;\n   214\t  limit?: number;\n   215\t  includeDeleted?: boolean;\n   216\t}\n   217\t\n   218\tfunction invalidBounds(reason: string): ErrorResult {\n   219\t  return { errorClass: \"caller_error\", code: \"invalid_bounds\", reason };\n   220\t}\n   221\t\n   222\t// Bounds mistakes are operational caller errors returned as results (tech\n   223\t// design §Interface Definitions: from > to, limit < 1) — never a silent\n   224\t// empty list a caller could mistake for an empty window.\n   225\tfunction validateListOptions(opts: MessageListOptions): ErrorResult | undefined {\n   226\t  const integers: ReadonlyArray<readonly [string, number | undefined]> = [\n   227\t    [\"from\", opts.from],\n   228\t    [\"to\", opts.to],\n   229\t    [\"limit\", opts.limit],\n   230\t  ];\n   231\t  for (const [name, value] of integers) {\n   232\t    if (value !== undefined && !Number.isInteger(value)) {\n   233\t      return invalidBounds(`${name} must be an integer, got ${value}`);\n   234\t    }\n   235\t  }\n   236\t  if (opts.from !== undefined && opts.to !== undefined && opts.from > opts.to) {\n   237\t    return invalidBounds(`from (${opts.from}) must not exceed to (${opts.to})`);\n   238\t  }\n   239\t  if (opts.limit !== undefined && opts.limit < 1) {\n   240\t    return invalidBounds(`limit must be at least 1, got ${opts.limit}`);\n   241\t  }\n   242\t  return undefined;\n   243\t}\n   244\t\n   245\texport async function listMessages(\n   246\t  thread: ThreadRef,\n   247\t  opts?: MessageListOptions,\n   248\t): Promise<OpResult<MessageRecord[]>> {\n   249\t  if (opts !== undefined) {\n   250\t    const badBounds = validateListOptions(opts);\n   251\t    if (badBounds !== undefined) return { ok: false, error: badBounds };\n   252\t  }\n   253\t  const resolved = await resolveThreadRef(thread);\n   254\t  if (!resolved.ok) return resolved;\n   255\t  const { filePath } = resolved.value;\n   256\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   257\t\n   258\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   259\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   260\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   261\t  // unmutated (F-03-002).\n   262\t  const opened = openThreadDatabase(filePath);\n   263\t  if (!opened.ok) return opened;\n   264\t  const db = opened.value;\n   265\t  try {\n   266\t    // Form read-back rides the message read (AC-2.1): each record carries\n   267\t    // its stored derived forms, attached from one grouped query — the\n   268\t    // production path for \"readable alongside the message\".\n   269\t    const formsByMessage = readMessageForms(db);\n   270\t    const records = readMessages(db, opts ?? {}).map((record) => {\n   271\t      const forms = formsByMessage.get(record.messageId);\n   272\t      return forms === undefined ? record : { ...record, forms };\n   273\t    });\n   274\t    return { ok: true, value: records };\n   275\t  } catch (cause) {\n   276\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   277\t    return storageFailure(`message read-back failed: ${reason}`);\n   278\t  } finally {\n   279\t    db.close();\n   280\t  }\n   281\t}\n   282\t\n   283\t// The single-message view (Epic 04 AC-3.2): the canonical record — every\n   284\t// block with complete content, full tool results, never the view-shortened\n   285\t// forms — plus the message's derivation forms with their states and\n   286\t// mechanically stamped metadata, joined from the owner's report read.\n   287\texport interface MessageDetail extends Omit<MessageRecord, \"forms\"> {\n   288\t  // Always present and honest (AC-3.3): show on a deleted message returns\n   289\t  // the record flagged — audit is the point — never a not-found.\n   290\t  deleted: boolean;\n   291\t  // The owner report's queue-joined entries (DD-2), never synthesized here:\n   292\t  // the same `reportMessageForms` read messages.report serves, scoped by id.\n   293\t  forms: FormReportEntry[];\n   294\t}\n   295\t\n   296\texport async function show(\n   297\t  thread: ThreadRef,\n   298\t  messageId: string,\n   299\t): Promise<OpResult<MessageDetail>> {\n   300\t  const resolved = await resolveThreadRef(thread);\n   301\t  if (!resolved.ok) return resolved;\n   302\t  const { filePath } = resolved.value;\n   303\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   304\t\n   305\t  const opened = openThreadDatabase(filePath);\n   306\t  if (!opened.ok) return opened;\n   307\t  const db = opened.value;\n   308\t  try {\n   309\t    const record = readMessageById(db, messageId);\n   310\t    if (record === undefined) {\n   311\t      return {\n   312\t        ok: false,\n   313\t        error: {\n   314\t          errorClass: \"caller_error\",\n   315\t          code: \"message_not_found\",\n   316\t          reason: `no message ${messageId} exists in this thread`,\n   317\t        },\n   318\t      };\n   319\t    }\n   320\t    const forms = reportMessageForms(db, { messageId });\n   321\t    return { ok: true, value: { ...record, forms } };\n   322\t  } catch (cause) {\n   323\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   324\t    return storageFailure(`message show failed: ${reason}`);\n   325\t  } finally {\n   326\t    db.close();\n   327\t  }\n   328\t}\n   329\t\n   330\texport async function listQueuedWork(\n   331\t  thread: ThreadRef,\n   332\t): Promise<OpResult<WorkItemRecord[]>> {\n   333\t  const resolved = await resolveThreadRef(thread);\n   334\t  if (!resolved.ok) return resolved;\n   335\t  const { filePath } = resolved.value;\n   336\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   337\t\n   338\t  const opened = openThreadDatabase(filePath);\n   339\t  if (!opened.ok) return opened;\n   340\t  const db = opened.value;\n   341\t  try {\n   342\t    return { ok: true, value: listItems(db, \"messages\") };\n   343\t  } catch (cause) {\n   344\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   345\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   346\t  } finally {\n   347\t    db.close();\n   348\t  }\n   349\t}\n   350\t\n   351\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   352\t\n   353\t// This owner's repair report: every message-owned form's durable state\n   354\t// joined with live queue detail in one query — the five operational\n   355\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n   356\t// without any queue API. Needs no provider; reads degrade, never block.\n   357\texport async function report(\n   358\t  thread: ThreadRef,\n   359\t  opts?: { notReady?: boolean; messageId?: string },\n   360\t): Promise<OpResult<FormReportEntry[]>> {\n   361\t  const resolved = await resolveThreadRef(thread);\n   362\t  if (!resolved.ok) return resolved;\n   363\t  const { filePath } = resolved.value;\n   364\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   365\t\n   366\t  const opened = openThreadDatabase(filePath);\n   367\t  if (!opened.ok) return opened;\n   368\t  const db = opened.value;\n   369\t  try {\n   370\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n   371\t  } catch (cause) {\n   372\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   373\t    return storageFailure(`report read failed: ${reason}`);\n   374\t  } finally {\n   375\t    db.close();\n   376\t  }\n   377\t}\n   378\t\n   379\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   380\t\n   381\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n   382\t// inverted; the requeue's join from the named form back to its queue site.\n   383\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n   384\t  smoothed_prompt: \"prompt_smoothing\",\n   385\t  tool_call_summary: \"tool_call_summary\",\n   386\t  tool_result_summary: \"tool_result_summary\",\n   387\t};\n   388\t\n   389\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n   390\t// supported rebuild act. Refused for blocked forms with the form's stored\n   391\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n   392\t// queued or in flight at the form's current source version (AC-4.5).\n   393\t// Otherwise the form clears to pending and re-enqueues at the next source\n   394\t// version — the same enqueue path intake uses, poke-on-commit included, so\n   395\t// background mode processes the repair with no further call. The no-op check\n   396\t// and the enqueue commit in one transaction (anti-shim: a split would\n   397\t// reintroduce the duplicate-work race).\n   398\texport async function requeue(\n   399\t  thread: ThreadRef,\n   400\t  target: { messageId: string; form: FormKind },\n   401\t): Promise<OpResult<RequeueOutcome>> {\n   402\t  const kind = MESSAGE_FORM_KINDS[target.form];\n   403\t  if (kind === undefined) {\n   404\t    return {\n   405\t      ok: false,\n   406\t      error: {\n   407\t        errorClass: \"caller_error\",\n   408\t        code: \"message_not_found\",\n   409\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n   410\t      },\n   411\t    };\n   412\t  }\n   413\t  const resolved = await resolveThreadRef(thread);\n   414\t  if (!resolved.ok) return resolved;\n   415\t  const { filePath } = resolved.value;\n   416\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   417\t\n   418\t  const opened = openThreadDatabase(filePath);\n   419\t  if (!opened.ok) return opened;\n   420\t  const db = opened.value;\n   421\t  try {\n   422\t    const meta = db\n   423\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   424\t      .get() as { thread_id: string } | undefined;\n   425\t    const threadId = meta?.thread_id ?? \"\";\n   426\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   427\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n   428\t      if (row === undefined) {\n   429\t        return {\n   430\t          ok: false,\n   431\t          error: {\n   432\t            errorClass: \"caller_error\",\n   433\t            code: \"message_not_found\",\n   434\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n   435\t          },\n   436\t        };\n   437\t      }\n   438\t      if (row.state === \"blocked\") {\n   439\t        // The refusal carries the form's stored reason — the damage named at\n   440\t        // blocking time, not a generic string (AC-4.6).\n   441\t        return {\n   442\t          ok: false,\n   443\t          error: {\n   444\t            errorClass: \"state_corruption\",\n   445\t            code: \"source_damaged\",\n   446\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n   447\t          },\n   448\t        };\n   449\t      }\n   450\t      const sourceRef = { messageId: target.messageId };\n   451\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n   452\t        return { ok: true, value: { noop: \"already_queued\" } };\n   453\t      }\n   454\t      const item = enqueue(ctx, {\n   455\t        owner: \"messages\",\n   456\t        kind,\n   457\t        sourceRef,\n   458\t        sourceVersion: row.sourceVersion + 1,\n   459\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n   460\t      });\n   461\t      return { ok: true, value: { workItemId: item.workItemId } };\n   462\t    });\n   463\t  } catch (cause) {\n   464\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   465\t    return storageFailure(`requeue failed: ${reason}`);\n   466\t  } finally {\n   467\t    db.close();\n   468\t  }\n   469\t}\n   470\t\n   471\t// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n   472\t\n   473\t// The mutation result contract (tech design §Interfaces): what changed in\n   474\t// the record, which dependent forms cleared, which dropped (delete only),\n   475\t// what replacement work queued, and which still-queued old items the cascade\n   476\t// tidied away (issue 1). Shared by edit and the Story 6 deletes.\n   477\texport interface MutationResult {\n   478\t  changed: { messageIds: string[]; turnIds: string[] };\n   479\t  cleared: CascadeClear[];\n   480\t  dropped: CascadeClear[];\n   481\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n   482\t  superseded: string[];\n   483\t}\n   484\t\n   485\t// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n   486\t// message's content and blocks, re-stamp the token estimate, and walk the\n   487\t// full dependent chain — clear to pending, supersede queued old work,\n   488\t// enqueue replacements at the next source version — in one transaction.\n   489\t// Synchronous and local by contract: everything above commits before this\n   490\t// returns; the re-queued rebuilds run through the normal drain (background\n   491\t// mode needs no further call — the enqueue pokes ride the commit). Events\n   492\t// are never touched (projection-level mutation, DD-12), and no generated\n   493\t// thread-view is either — visibility arrives at the next compact/rebuild.\n   494\t// Refusals read through the deleted-filtered view and enforce the closed-turn\n   495\t// target boundary: only a message in a closed turn is editable, so an\n   496\t// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\n   497\t// the boundary's one stable code — a missing or deleted message is\n   498\t// message_not_found, and a refusal changes nothing.\n   499\texport async function edit(\n   500\t  thread: ThreadRef,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/store.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Message and block row operations. Writes run on the caller's handle inside\n     2\t// the batch transaction (insert failures propagate so the pipeline rejects\n     3\t// the whole batch); reads run on a fresh handle per operation. The mutation\n     4\t// half (Epic 02 Story 5) — the edit's validation read and content apply —\n     5\t// also lives here: row-level mechanics, no policy.\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n     8\timport type { Block, MessageRecord } from \"../index.js\";\n     9\t\n    10\texport interface MessageRow {\n    11\t  messageId: string;\n    12\t  sourceEventOrder: number;\n    13\t  kind: MessageRecord[\"kind\"];\n    14\t  tokenEstimate: number;\n    15\t  actor: string;\n    16\t  harness: string;\n    17\t  // Membership stamp, settled at intake: the turn open after this event's\n    18\t  // transition, or null in a gap. Written once here, never updated — a null\n    19\t  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n    20\t  // change (AC-3.7).\n    21\t  turnId: string | null;\n    22\t  blocks: Block[];\n    23\t}\n    24\t\n    25\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n    26\t  db.prepare(\n    27\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n    28\t     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    29\t  ).run(\n    30\t    row.messageId,\n    31\t    row.sourceEventOrder,\n    32\t    row.kind,\n    33\t    row.tokenEstimate,\n    34\t    row.actor,\n    35\t    row.harness,\n    36\t    row.turnId,\n    37\t  );\n    38\t\n    39\t  const insertBlock = db.prepare(\n    40\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\n    41\t     VALUES (?, ?, ?, ?)`,\n    42\t  );\n    43\t  for (const [index, block] of row.blocks.entries()) {\n    44\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n    45\t  }\n    46\t}\n    47\t\n    48\t// The mutation operations' validation read (Flows 5/6): the live\n    49\t// (deleted-filtered) message joined to its turn's status. A deleted target\n    50\t// misses here and refuses as message_not_found — the filtered view is the\n    51\t// refusal's read by design (never a distinct error for deleted; double\n    52\t// delete reads the same way, AC-6.7). turnStatus is null for a gap message\n    53\t// (no membership); the closed-turn target boundary refuses it the same as\n    54\t// an open turn. initiatesTurn carries the prompt-protection fact (AC-6.3):\n    55\t// a turn opens on its prompt's event, so the member whose source event\n    56\t// order equals the turn's opened-at order is the turn's initiating prompt.\n    57\texport interface MutableMessageView {\n    58\t  messageId: string;\n    59\t  kind: string;\n    60\t  turnId: string | null;\n    61\t  turnStatus: \"open\" | \"closed\" | null;\n    62\t  initiatesTurn: boolean;\n    63\t}\n    64\t\n    65\texport function readMutableMessage(\n    66\t  db: DatabaseSync,\n    67\t  messageId: string,\n    68\t): MutableMessageView | undefined {\n    69\t  const row = db\n    70\t    .prepare(\n    71\t      `SELECT m.message_id, m.kind, m.turn_id, m.source_event_order,\n    72\t              t.status AS turn_status, t.opened_at_event_order\n    73\t       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\n    74\t       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\n    75\t    )\n    76\t    .get(messageId) as unknown as\n    77\t    | {\n    78\t        message_id: string;\n    79\t        kind: string;\n    80\t        turn_id: string | null;\n    81\t        source_event_order: number | bigint;\n    82\t        turn_status: string | null;\n    83\t        opened_at_event_order: number | bigint | null;\n    84\t      }\n    85\t    | undefined;\n    86\t  if (row === undefined) return undefined;\n    87\t  return {\n    88\t    messageId: row.message_id,\n    89\t    kind: row.kind,\n    90\t    turnId: row.turn_id,\n    91\t    turnStatus: row.turn_status as MutableMessageView[\"turnStatus\"],\n    92\t    initiatesTurn:\n    93\t      row.opened_at_event_order !== null &&\n    94\t      Number(row.source_event_order) === Number(row.opened_at_event_order),\n    95\t  };\n    96\t}\n    97\t\n    98\t// The delete's record apply (Flow 6): a projection-level tombstone — the\n    99\t// deleted_at stamp every read filters on. The source events are never\n   100\t// touched (record-never-destroyed, DD-12); event read-back keeps showing\n   101\t// them. The bulk variant is turns.deleteTurn's member stamp, scoped to live\n   102\t// rows so a turn whose messages were individually deleted first still\n   103\t// deletes cleanly (membership walk on live rows); it returns the stamped\n   104\t// ids in record order for the mutation result and the cascade's drop set.\n   105\texport function markMessageDeleted(\n   106\t  db: DatabaseSync,\n   107\t  messageId: string,\n   108\t  deletedAt: string,\n   109\t): void {\n   110\t  db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = ?`).run(\n   111\t    deletedAt,\n   112\t    messageId,\n   113\t  );\n   114\t}\n   115\t\n   116\texport function markTurnMessagesDeleted(\n   117\t  db: DatabaseSync,\n   118\t  turnId: string,\n   119\t  deletedAt: string,\n   120\t): string[] {\n   121\t  const rows = db\n   122\t    .prepare(\n   123\t      `UPDATE message SET deleted_at = ?\n   124\t       WHERE turn_id = ? AND deleted_at IS NULL\n   125\t       RETURNING message_id, source_event_order`,\n   126\t    )\n   127\t    .all(deletedAt, turnId) as unknown as Array<{\n   128\t    message_id: string;\n   129\t    source_event_order: number | bigint;\n   130\t  }>;\n   131\t  return rows\n   132\t    .sort((a, b) => Number(a.source_event_order) - Number(b.source_event_order))\n   133\t    .map((row) => row.message_id);\n   134\t}\n   135\t\n   136\t// The edit's record apply (AC-5.1): the new content lands in each block's\n   137\t// content-bearing field — the same field per block type the projection wrote\n   138\t// and counted (internal/project.ts) — and the token estimate re-stamps from\n   139\t// the same estimator, so placement arithmetic stays current after edits.\n   140\t// Events are untouched: this is projection-level mutation; the log keeps the\n   141\t// original (DD-12).\n   142\texport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\n   143\t  const blocks = db\n   144\t    .prepare(\n   145\t      `SELECT block_index, block_type, content FROM message_block\n   146\t       WHERE message_id = ? ORDER BY block_index`,\n   147\t    )\n   148\t    .all(messageId) as unknown as Array<{\n   149\t    block_index: number | bigint;\n   150\t    block_type: string;\n   151\t    content: string;\n   152\t  }>;\n   153\t  const update = db.prepare(\n   154\t    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\n   155\t  );\n   156\t  let tokenEstimate = estimateTokens(content);\n   157\t  for (const block of blocks) {\n   158\t    const parsed = JSON.parse(block.content) as Record<string, unknown>;\n   159\t    switch (block.block_type) {\n   160\t      case \"text\":\n   161\t        parsed[\"text\"] = content;\n   162\t        break;\n   163\t      case \"tool_result\":\n   164\t        parsed[\"content\"] = content;\n   165\t        break;\n   166\t      case \"tool_call\":\n   167\t        // Arguments are the call's counted content; the edit's string lands\n   168\t        // verbatim as the new arguments value, mirroring projection's\n   169\t        // serialized-arguments estimate.\n   170\t        parsed[\"arguments\"] = content;\n   171\t        tokenEstimate = estimateTokens(JSON.stringify(content));\n   172\t        break;\n   173\t      default:\n   174\t        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\n   175\t    }\n   176\t    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\n   177\t  }\n   178\t  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\n   179\t    tokenEstimate,\n   180\t    messageId,\n   181\t  );\n   182\t}\n   183\t\n   184\tinterface RawMessageRow {\n   185\t  message_id: string;\n   186\t  source_event_order: number | bigint;\n   187\t  kind: string;\n   188\t  token_estimate: number | bigint;\n   189\t  actor: string;\n   190\t  harness: string;\n   191\t  turn_id: string | null;\n   192\t  deleted_at: string | null;\n   193\t}\n   194\t\n   195\tinterface RawBlockRow {\n   196\t  message_id: string;\n   197\t  block_type: string;\n   198\t  content: string;\n   199\t}\n   200\t\n   201\tfunction recordFromRow(row: RawMessageRow, blocks: Block[]): MessageRecord {\n   202\t  const record: MessageRecord = {\n   203\t    messageId: row.message_id,\n   204\t    sourceEventOrder: Number(row.source_event_order),\n   205\t    kind: row.kind as MessageRecord[\"kind\"],\n   206\t    blocks,\n   207\t    tokenEstimate: Number(row.token_estimate),\n   208\t    actor: row.actor,\n   209\t    harness: row.harness,\n   210\t  };\n   211\t  if (row.turn_id !== null) record.turnId = row.turn_id;\n   212\t  // The deleted marker (Epic 04 AC-3.3): present only on deleted rows, which\n   213\t  // only the includeDeleted read surfaces — never silently mixed in.\n   214\t  if (row.deleted_at !== null) record.deleted = true;\n   215\t  return record;\n   216\t}\n   217\t\n   218\t// Bounds in source-event-order coordinates (Epic 04 DD-3): the coordinate\n   219\t// the reports name, so drill-down uses what the operator already holds.\n   220\t// limit caps the count after bounds. Defaults preserve every existing\n   221\t// caller: visible messages, unbounded, record order.\n   222\texport interface MessageReadOptions {\n   223\t  from?: number;\n   224\t  to?: number;\n   225\t  limit?: number;\n   226\t  includeDeleted?: boolean;\n   227\t}\n   228\t\n   229\texport function readMessages(\n   230\t  db: DatabaseSync,\n   231\t  opts: MessageReadOptions = {},\n   232\t): MessageRecord[] {\n   233\t  const blockRows = db\n   234\t    .prepare(\n   235\t      `SELECT message_id, block_type, content FROM message_block\n   236\t       ORDER BY message_id, block_index`,\n   237\t    )\n   238\t    .all() as unknown as RawBlockRow[];\n   239\t  const blocksByMessage = new Map<string, Block[]>();\n   240\t  for (const row of blockRows) {\n   241\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n   242\t    blocks.push({\n   243\t      blockType: row.block_type as Block[\"blockType\"],\n   244\t      content: JSON.parse(row.content) as Record<string, unknown>,\n   245\t    });\n   246\t    blocksByMessage.set(row.message_id, blocks);\n   247\t  }\n   248\t\n   249\t  // The deleted-read filter (tech design §Mechanics): message reads surface\n   250\t  // live projection rows only; a deleted message's source events stay\n   251\t  // readable through the Epic 01 event read-back, the one unfiltered surface.\n   252\t  // includeDeleted is the Epic 04 audit opt-in: deleted rows return flagged.\n   253\t  const conditions: string[] = [];\n   254\t  const params: number[] = [];\n   255\t  if (opts.includeDeleted !== true) conditions.push(\"deleted_at IS NULL\");\n   256\t  if (opts.from !== undefined) {\n   257\t    conditions.push(\"source_event_order >= ?\");\n   258\t    params.push(opts.from);\n   259\t  }\n   260\t  if (opts.to !== undefined) {\n   261\t    conditions.push(\"source_event_order <= ?\");\n   262\t    params.push(opts.to);\n   263\t  }\n   264\t  if (opts.limit !== undefined) params.push(opts.limit);\n   265\t  const messageRows = db\n   266\t    .prepare(\n   267\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\n   268\t       FROM message${conditions.length > 0 ? ` WHERE ${conditions.join(\" AND \")}` : \"\"}\n   269\t       ORDER BY source_event_order${opts.limit !== undefined ? \" LIMIT ?\" : \"\"}`,\n   270\t    )\n   271\t    .all(...params) as unknown as RawMessageRow[];\n   272\t  return messageRows.map((row) =>\n   273\t    recordFromRow(row, blocksByMessage.get(row.message_id) ?? []),\n   274\t  );\n   275\t}\n   276\t\n   277\t// The show operation's by-id read (Epic 04 Flow 3): the canonical record —\n   278\t// full blocks verbatim, never view-shortened — with the deleted flag honest.\n   279\t// Deliberately unfiltered on deleted_at: show on a deleted message is the\n   280\t// audit read (AC-3.3), never a not-found.\n   281\texport function readMessageById(\n   282\t  db: DatabaseSync,\n   283\t  messageId: string,\n   284\t): (MessageRecord & { deleted: boolean }) | undefined {\n   285\t  const row = db\n   286\t    .prepare(\n   287\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\n   288\t       FROM message WHERE message_id = ?`,\n   289\t    )\n   290\t    .get(messageId) as unknown as RawMessageRow | undefined;\n   291\t  if (row === undefined) return undefined;\n   292\t  const blockRows = db\n   293\t    .prepare(\n   294\t      `SELECT message_id, block_type, content FROM message_block\n   295\t       WHERE message_id = ? ORDER BY block_index`,\n   296\t    )\n   297\t    .all(messageId) as unknown as RawBlockRow[];\n   298\t  const blocks = blockRows.map((block) => ({\n   299\t    blockType: block.block_type as Block[\"blockType\"],\n   300\t    content: JSON.parse(block.content) as Record<string, unknown>,\n   301\t  }));\n   302\t  return { ...recordFromRow(row, blocks), deleted: row.deleted_at !== null };\n   303\t}\n","exit_code":0,"status":"completed"}}

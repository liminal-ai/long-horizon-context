ssage-id\",\n   338\t        );\n   339\t      }\n   340\t      return runMessagesShow(threadRefFrom(flags), { messageId: flags.messageId });\n   341\t    }\n   342\t    case \"messages list-queued-work\":\n   343\t      return (\n   344\t        requireThreadRef(flags, \"messages list-queued-work\") ??\n   345\t        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n   346\t      );\n   347\t    case \"messages report\": {\n   348\t      const missingRef = requireThreadRef(flags, \"messages report\");\n   349\t      if (missingRef !== undefined) return missingRef;\n   350\t      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n   351\t      if (flags.notReady === true) reportFlags.notReady = true;\n   352\t      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n   353\t      return runMessagesReport(threadRefFrom(flags), reportFlags);\n   354\t    }\n   355\t    case \"messages requeue\": {\n   356\t      const missingRef = requireThreadRef(flags, \"messages requeue\");\n   357\t      if (missingRef !== undefined) return missingRef;\n   358\t      if (flags.messageId === undefined || flags.form === undefined) {\n   359\t        return renderCliError(\n   360\t          \"caller_error\",\n","exit_code":0,"status":"completed"}}

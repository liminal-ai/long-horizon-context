w_config\" // caller_error — band sum / bound violation, named\n    29\t  // Epic 03 Story 5: materialize accepts pi-session only; an unknown format\n    30\t  // is a caller error naming the accepted values (story Scope).\n    31\t  | \"unknown_format\" // caller_error — materialize format not supported\n    32\t  // Epic 04 Story 1: bounded listing — a bad bounds option (from > to,\n    33\t  // limit < 1, non-integer) is an operational caller error returned as a\n    34\t  // result, mirroring the compact-params precedent (additive code, the\n    35\t  // Epic 03 deviation pattern).\n    36\t  | \"invalid_bounds\"; // caller_error — listMessages bounds option rejected\n    37\t\n    38\texport interface ErrorResult {\n    39\t  errorClass: ErrorClass;\n    40\t  code: ErrorCode;\n    41\t  reason: string; // human-readable; machine logic switches on code\n    42\t  eventIndex?: number; // present on batch validation failures\n    43\t}\n    44\t\n    45\t// Expected operational failures — caller errors, corruption, environment\n    46\t// failures — are always returned as OpResult errors, never thrown.\n    47\t// Programmer bugs inside lhc may still throw; callers are not expected\n    48\t// to handle throws as contract outcomes.\n    49\texport type OpResult<T> =\n    50\t  | { ok: true; value: T }\n    51\t  | { ok: false; error: ErrorResult };\n    52\t\n    53\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n    54\t// caught at the operation boundary and wrapped with the underlying detail.\n    55\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n    56\t  return {\n    57\t    ok: false,\n    58\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n    59\t  };\n    60\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/index.ts | sed -n '1,360p'\"","aggregated_output":"     1\timport { parseArgs } from \"node:util\";\n     2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n     3\timport * as messages from \"../domains/messages/index.js\";\n     4\timport * as threads from \"../domains/threads/index.js\";\n     5\timport * as turns from \"../domains/turns/index.js\";\n     6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n     7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n     8\timport type { OpResult } from \"../shared/errors.js\";\n     9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n    10\timport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\n    11\timport { runMessagesList, runMessagesShow } from \"./messages-read.js\";\n    12\timport { runTurnsDelete } from \"./turns-mutate.js\";\n    13\timport {\n    14\t  runMessagesReport,\n    15\t  runMessagesRequeue,\n    16\t  runTurnsReport,\n    17\t  runTurnsRequeue,\n    18\t  runWorkDrain,\n    19\t} from \"./work.js\";\n    20\timport { runViewCommand } from \"./view.js\";\n    21\t\n    22\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n    23\t// process stdin. null means interactive (TTY) — distinct from empty input\n    24\t// only in how it arises; both are refused with empty_stdin before any SDK\n    25\t// call (the SDK itself can never return that code).\n    26\texport type StdinReader = () => Promise<string | null>;\n    27\t\n    28\tasync function readProcessStdin(): Promise<string | null> {\n    29\t  if (process.stdin.isTTY) return null;\n    30\t  process.stdin.setEncoding(\"utf8\");\n    31\t  let data = \"\";\n    32\t  for await (const chunk of process.stdin) data += String(chunk);\n    33\t  return data;\n    34\t}\n    35\t\n    36\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n    37\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n    38\t}\n    39\t\n    40\tconst HELP = `lhc — Long Horizon Context CLI\n    41\t\n    42\tUsage:\n    43\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n    44\t  lhc threads resolve --thread-id <id> [--registry <r>]\n    45\t  lhc threads list [--registry <r>]\n    46\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    47\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    48\t  lhc messages list (--thread-id <id> | --file-path <p>) [--from <n>] [--to <n>]\n    49\t                    [--limit <n>] [--include-deleted] [--registry <r>]\n    50\t  lhc messages show (--thread-id <id> | --file-path <p>) --message-id <id> [--registry <r>]\n    51\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    52\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n    53\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n    54\t  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n    55\t  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n    56\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    57\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n    58\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    59\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n    60\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n    61\t  lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n    62\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n    63\t  lhc view pull (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n    64\t  lhc view status (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n    65\t  lhc view compact (--thread-id <id> | --file-path <p>) [--profile <name>]\n    66\t                   [--lower-bound <n>] [--full <n>] [--smooth <n>] [--detailed <n>] [--brief <n>]\n    67\t                   [--no-sweep] [--json] [--registry <r>]\n    68\t  lhc view sweep (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n    69\t  lhc view materialize (--thread-id <id> | --file-path <p>) --out <path> [--format pi-session] [--registry <r>]\n    70\t\n    71\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n    72\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n    73\tView commands need no provider; output is always JSON (--json accepted).\n    74\tTwo exceptions on success: view pull prints the message array itself, and\n    75\tview materialize prints the written path; their failures stay structured.\n    76\t`;\n    77\t\n    78\tinterface ParsedFlags {\n    79\t  threadId?: string;\n    80\t  filePath?: string;\n    81\t  title?: string;\n    82\t  registryPath?: string;\n    83\t  maxItems?: string;\n    84\t  provider?: string;\n    85\t  notReady?: boolean;\n    86\t  messageId?: string;\n    87\t  turnId?: string;\n    88\t  chunkId?: string;\n    89\t  form?: string;\n    90\t  subjectKind?: string;\n    91\t  subjectId?: string;\n    92\t  content?: string;\n    93\t  from?: string;\n    94\t  to?: string;\n    95\t  limit?: string;\n    96\t  includeDeleted?: boolean;\n    97\t}\n    98\t\n    99\t// strict parse rejects unknown/misspelled flags so they are named back to the\n   100\t// caller, never silently dropped — the CLI boundary matching the SDK's\n   101\t// closed-contract strictness. The failure is returned as data (not thrown) so\n   102\t// runCli can render it as the structured usage error.\n   103\ttype ParseFlagsResult =\n   104\t  | { ok: true; flags: ParsedFlags }\n   105\t  | { ok: false; unknownFlag: string };\n   106\t\n   107\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n   108\t  let values;\n   109\t  try {\n   110\t    ({ values } = parseArgs({\n   111\t      args: [...args],\n   112\t      options: {\n   113\t        \"thread-id\": { type: \"string\" },\n   114\t        \"file-path\": { type: \"string\" },\n   115\t        title: { type: \"string\" },\n   116\t        registry: { type: \"string\" },\n   117\t        \"max-items\": { type: \"string\" },\n   118\t        provider: { type: \"string\" },\n   119\t        \"not-ready\": { type: \"boolean\" },\n   120\t        \"message-id\": { type: \"string\" },\n   121\t        \"turn-id\": { type: \"string\" },\n   122\t        \"chunk-id\": { type: \"string\" },\n   123\t        form: { type: \"string\" },\n   124\t        \"subject-kind\": { type: \"string\" },\n   125\t        \"subject-id\": { type: \"string\" },\n   126\t        // `--message` / `--turn` are the mutation commands' spellings\n   127\t        // (story/tech design); they parse into the same slots as\n   128\t        // `--message-id` / `--turn-id`.\n   129\t        message: { type: \"string\" },\n   130\t        turn: { type: \"string\" },\n   131\t        content: { type: \"string\" },\n   132\t        // Epic 04 Story 1: the bounded-listing options (lhc messages list).\n   133\t        from: { type: \"string\" },\n   134\t        to: { type: \"string\" },\n   135\t        limit: { type: \"string\" },\n   136\t        \"include-deleted\": { type: \"boolean\" },\n   137\t      },\n   138\t      strict: true,\n   139\t      allowPositionals: true,\n   140\t    }));\n   141\t  } catch (cause) {\n   142\t    const message = cause instanceof Error ? cause.message : String(cause);\n   143\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n   144\t    // option '--file-pth'); surface that token, falling back to the message.\n   145\t    const named = /'([^']+)'/.exec(message);\n   146\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n   147\t  }\n   148\t  const flags: ParsedFlags = {};\n   149\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n   150\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n   151\t  if (typeof values.title === \"string\") flags.title = values.title;\n   152\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n   153\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n   154\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n   155\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n   156\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n   157\t  if (typeof values.message === \"string\") flags.messageId = values.message;\n   158\t  if (typeof values.content === \"string\") flags.content = values.content;\n   159\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n   160\t  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n   161\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n   162\t  if (typeof values.form === \"string\") flags.form = values.form;\n   163\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n   164\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n   165\t  if (typeof values.from === \"string\") flags.from = values.from;\n   166\t  if (typeof values.to === \"string\") flags.to = values.to;\n   167\t  if (typeof values.limit === \"string\") flags.limit = values.limit;\n   168\t  if (values[\"include-deleted\"] === true) flags.includeDeleted = true;\n   169\t  return { ok: true, flags };\n   170\t}\n   171\t\n   172\t// The read commands take a thread reference but no stdin; a missing reference\n   173\t// is a usage error named before any SDK call, matching the intake commands.\n   174\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n   175\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n   176\t    return renderCliError(\n   177\t      \"caller_error\",\n   178\t      \"missing_flag\",\n   179\t      `${command} requires --thread-id or --file-path`,\n   180\t    );\n   181\t  }\n   182\t  return undefined;\n   183\t}\n   184\t\n   185\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n   186\t  if (flags.threadId !== undefined) {\n   187\t    return flags.registryPath !== undefined\n   188\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n   189\t      : { threadId: flags.threadId };\n   190\t  }\n   191\t  return { filePath: flags.filePath ?? \"\" };\n   192\t}\n   193\t\n   194\texport async function runCli(\n   195\t  argv: readonly string[],\n   196\t  readStdin: StdinReader = readProcessStdin,\n   197\t): Promise<CliResult> {\n   198\t  if (argv.length === 0) {\n   199\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n   200\t  }\n   201\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n   202\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n   203\t  }\n   204\t\n   205\t  const [group, command, ...rest] = argv;\n   206\t  // The view group parses its own flag surface (band overrides, --out,\n   207\t  // --format) — routed before the shared parse so its flags never widen the\n   208\t  // other commands' accepted set.\n   209\t  if (group === \"view\") {\n   210\t    return runViewCommand(command, rest);\n   211\t  }\n   212\t  const key = command === undefined ? group : `${group} ${command}`;\n   213\t  const parsed = parseFlags(command === undefined ? [] : rest);\n   214\t  if (!parsed.ok) {\n   215\t    return renderCliError(\n   216\t      \"caller_error\",\n   217\t      \"unknown_flag\",\n   218\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n   219\t    );\n   220\t  }\n   221\t  const flags = parsed.flags;\n   222\t\n   223\t  switch (key) {\n   224\t    case \"threads new-thread\": {\n   225\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n   226\t      // instead of failing, so the adapter refuses before any SDK call.\n   227\t      if (flags.filePath === undefined) {\n   228\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n   229\t      }\n   230\t      const input: Parameters<typeof threads.newThread>[0] = {\n   231\t        filePath: flags.filePath,\n   232\t      };\n   233\t      if (flags.title !== undefined) input.title = flags.title;\n   234\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   235\t      return renderResult(await threads.newThread(input));\n   236\t    }\n   237\t    case \"threads resolve\": {\n   238\t      if (flags.threadId === undefined) {\n   239\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n   240\t      }\n   241\t      const input: Parameters<typeof threads.resolve>[0] = {\n   242\t        threadId: flags.threadId,\n   243\t      };\n   244\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   245\t      return renderResult(await threads.resolve(input));\n   246\t    }\n   247\t    case \"threads list\": {\n   248\t      return renderResult(\n   249\t        await threads.listThreads(\n   250\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n   251\t        ),\n   252\t      );\n   253\t    }\n   254\t    case \"intake-stream message-events\": {\n   255\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   256\t        return renderCliError(\n   257\t          \"caller_error\",\n   258\t          \"missing_flag\",\n   259\t          \"intake-stream message-events requires --thread-id or --file-path\",\n   260\t        );\n   261\t      }\n   262\t      const text = await readStdin();\n   263\t      if (text === null || text.trim() === \"\") {\n   264\t        return renderResult(\n   265\t          stdinCallerError(\n   266\t            \"empty_stdin\",\n   267\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n   268\t          ),\n   269\t        );\n   270\t      }\n   271\t      let parsed: unknown;\n   272\t      try {\n   273\t        parsed = JSON.parse(text);\n   274\t      } catch (cause) {\n   275\t        const detail = cause instanceof Error ? cause.message : String(cause);\n   276\t        return renderResult(\n   277\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n   278\t        );\n   279\t      }\n   280\t      if (!Array.isArray(parsed)) {\n   281\t        return renderResult(\n   282\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n   283\t        );\n   284\t      }\n   285\t      return renderResult(\n   286\t        await intakeStream.messageEvents(\n   287\t          threadRefFrom(flags),\n   288\t          parsed as readonly MessageEventInput[],\n   289\t        ),\n   290\t      );\n   291\t    }\n   292\t    case \"intake-stream list-events\": {\n   293\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   294\t        return renderCliError(\n   295\t          \"caller_error\",\n   2
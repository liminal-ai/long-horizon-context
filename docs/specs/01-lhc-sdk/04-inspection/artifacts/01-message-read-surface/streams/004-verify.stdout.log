{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"pnpm exec tsx -e '\nimport { createSdk, createDeterministicProvider } from \\\"./src/index.ts\\\";\nimport { tempStore, validEvent, createProviderDouble, readDerivedForms } from \\\"./test/fixtures/index.ts\\\";\n(async () => {\nconst store = tempStore();\ntry {\n  const manual = createSdk({ provider: createDeterministicProvider(), mode: \\\"manual\\\" });\n  const filePath = store.threadPath();\n  const created = await manual.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (\"'!created.ok) throw new Error(created.error.reason);\n  const sent = await manual.intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\", { payload: { text: \"needs smoothing\" } })]);\n  if (!sent.ok) throw new Error(sent.error.reason);\n  const beforeForms = readDerivedForms(filePath).map(f => ({form:f.form, state:f.state}));\n  const double = createProviderDouble();\n  const bg = createSdk({ provider: double, mode: \"background\" });\n  const captured = double.captureInputs();\n  const listed = await bg.messages.listMessages({ filePath }, { limit: 1 });\n  await bg.drainSettled({ filePath });\n  const afterForms = readDerivedForms(filePath).map(f => ({form:f.form, state:f.state}));\n  console.log(JSON.stringify({listedOk: listed.ok, beforeForms, afterForms, providerCalls: captured.length}, null, 2));\n} finally {\n  store.cleanup();\n}\n})();\n'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

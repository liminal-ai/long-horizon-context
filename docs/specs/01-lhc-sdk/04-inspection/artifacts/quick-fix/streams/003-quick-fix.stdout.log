{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GR3Azjkuouid5g1THvR3jo","type":"tool_result","content":"1\t// Story 4 (Epic 02), process-boundary suite: CLI parity for the report and\n2\t// requeue mirrors — `lhc messages report|requeue` and `lhc turns\n3\t// report|requeue` through the spawned dist/cli.js produce the same result\n4\t// JSON the SDK surfaces return (tech design CLI parity rule; supplemental\n5\t// non-TC checks per the test plan). Report and requeue need no provider\n6\t// (DD-11) — only the drain legs set LHC_PROVIDER. Runs under verify-all only\n7\t// (LHC_PROCESS_SUITE=1). Lives in its own file because cli-process-work.test.ts\n8\t// is hash-locked by the Story 1 red manifest; green may add files, not edit.\n9\timport { spawnSync } from \"node:child_process\";\n10\timport { mkdtempSync, rmSync } from \"node:fs\";\n11\timport { tmpdir } from \"node:os\";\n12\timport path from \"node:path\";\n13\timport { fileURLToPath } from \"node:url\";\n14\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n15\timport {\n16\t  createSdk,\n17\t  intakeStream,\n18\t  messages,\n19\t  resolveNamedProvider,\n20\t  threads,\n21\t  turns,\n22\t  type FormReportEntry,\n23\t  type OpResult,\n24\t} from \"../src/index.js\";\n25\timport { validEvent } from \"./fixtures/index.js\";\n26\t\n27\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n28\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n29\t\n30\tfunction runBinary(\n31\t  args: string[],\n32\t  env?: Record<string, string | undefined>,\n33\t): { status: number | null; stdout: string; stderr: string } {\n34\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n35\t    encoding: \"utf8\",\n36\t    env: { ...process.env, ...env },\n37\t  });\n38\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n39\t}\n40\t\n41\tlet dir: string;\n42\tbeforeEach(() => {\n43\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-report-\"));\n44\t});\n45\tafterEach(() => {\n46\t  rmSync(dir, { recursive: true, force: true });\n47\t});\n48\t\n49\tasync function newThreadFile(name: string): Promise<string> {\n50\t  const filePath = path.join(dir, `${name}.sqlite`);\n51\t  const created = await threads.newThread({\n52\t    filePath,\n53\t    registryPath: path.join(dir, \"registry.sqlite\"),\n54\t  });\n55\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n56\t  return filePath;\n57\t}\n58\t\n59\t// One closed prompt+answer turn, identical on both twins (fixed idempotency\n60\t// keys; report rows for an undrained thread carry no timestamps, so the twin\n61\t// JSON compares byte-equal without clock control).\n62\tasync function seedTwin(filePath: string): Promise<void> {\n63\t  const batch = [\n64\t    validEvent(\"user_prompt\", { payload: { text: \"twin report prompt\" } }),\n65\t    validEvent(\"assistant_text\", { payload: { text: \"twin report answer\" } }),\n66\t    validEvent(\"turn_end\"),\n67\t  ].map((event, index) => ({ ...event, idempotencyKey: `twin-report-${index}` }));\n68\t  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n69\t  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n70\t}\n71\t\n72\tdescribe(\"CLI parity: report mirrors the SDK surfaces, no provider required\", () => {\n73\t  it(\"messages and turns report JSON equals the SDK result on twin threads, including --not-ready\", async () => {\n74\t    const cliThread = await newThreadFile(\"cli-report\");\n75\t    const sdkThread = await newThreadFile(\"sdk-report\");\n76\t    await seedTwin(cliThread);\n77\t    await seedTwin(sdkThread);\n78\t\n79\t    const viaCli = runBinary([\"messages\", \"report\", \"--file-path\", cliThread], {\n80\t      LHC_PROVIDER: undefined,\n81\t    });\n82\t    expect(viaCli.status).toBe(0);\n83\t    const cliReport = JSON.parse(viaCli.stdout) as OpResult<FormReportEntry[]>;\n84\t    const viaSdk = await messages.report({ filePath: sdkThread });\n85\t    expect(cliReport).toEqual(viaSdk);\n86\t\n87\t    const viaCliTurns = runBinary(\n88\t      [\"turns\", \"report\", \"--file-path\", cliThread, \"--not-ready\"],\n89\t      { LHC_PROVIDER: undefined },\n90\t    );\n91\t    expect(viaCliTurns.status).toBe(0);\n92\t    const cliTurnsReport = JSON.parse(viaCliTurns.stdout) as OpResult<FormReportEntry[]>;\n93\t    const viaSdkTurns = await turns.report({ filePath: sdkThread }, { notReady: true });\n94\t    expect(cliTurnsReport).toEqual(viaSdkTurns);\n95\t    expect(cliTurnsReport.ok).toBe(true);\n96\t    if (!cliTurnsReport.ok) return;\n97\t    // The undrained twin is all pending with live queue detail in the rows.\n98\t    expect(cliTurnsReport.value.map((entry) => [entry.form, entry.state])).toEqual([\n99\t      [\"lower_band_projection\", \"pending\"],\n100\t      [\"turn_rendering\", \"pending\"],\n101\t    ]);\n102\t    expect(cliTurnsReport.value[0]?.queue).toEqual({ status: \"queued\", attempts: 0 });\n103\t  });\n104\t\n105\t  it(\"report on a missing thread exits 1 with thread_not_found\", async () => {\n106\t    const missing = runBinary(\n107\t      [\"messages\", \"report\", \"--file-path\", path.join(dir, \"nope.sqlite\")],\n108\t      { LHC_PROVIDER: undefined },\n109\t    );\n110\t    expect(missing.status).toBe(1);\n111\t    const parsed = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n112\t    expect(parsed.ok).toBe(false);\n113\t    expect(parsed.error.code).toBe(\"thread_not_found\");\n114\t  });\n115\t});\n116\t\n117\tdescribe(\"CLI parity: requeue mirrors the SDK surfaces\", () => {\n118\t  it(\"requeue through both owners returns identical result JSON on drained twins; the no-op and refusal legs match too\", async () => {\n119\t    const cliThread = await newThreadFile(\"cli-requeue\");\n120\t    const sdkThread = await newThreadFile(\"sdk-requeue\");\n121\t    await seedTwin(cliThread);\n122\t    await seedTwin(sdkThread);\n123\t\n124\t    // Drain both twins through the production provider registry (DD-11):\n125\t    // the CLI twin via the spawned binary, the SDK twin via the same\n126\t    // resolution seam in-process.\n127\t    const drained = runBinary([\"work\", \"drain\", \"--file-path\", cliThread], {\n128\t      LHC_PROVIDER: \"deterministic\",\n129\t    });\n130\t    expect(drained.status).toBe(0);\n131\t    const provider = resolveNamedProvider(\"deterministic\");\n132\t    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n133\t    const sdk = createSdk({ provider, mode: \"manual\" });\n134\t    const sdkDrained = await sdk.work.drain({ filePath: sdkThread });\n135\t    expect(sdkDrained.ok).toBe(true);\n136\t\n137\t    // listChunks parity (ruling 012): the drained twins hold one open chunk\n138\t    // with t1 placed; CLI JSON matches the SDK record shape exactly.\n139\t    const cliChunks = runBinary([\"turns\", \"list-chunks\", \"--file-path\", cliThread], {\n140\t      LHC_PROVIDER: undefined,\n141\t    });\n142\t    expect(cliChunks.status).toBe(0);\n143\t    const sdkChunks = await turns.listChunks({ filePath: sdkThread });\n144\t    expect(JSON.parse(cliChunks.stdout)).toEqual(sdkChunks);\n145\t    expect(sdkChunks.ok && sdkChunks.value).toMatchObject([\n146\t      { chunkId: \"c1\", status: \"open\", memberTurnIds: [\"t1\"] },\n147\t    ]);\n148\t\n149\t    // messages.requeue parity: rebuild a ready smoothing at the next version.\n150\t    const cliRequeue = runBinary(\n151\t      [\n152\t        \"messages\",\n153\t        \"requeue\",\n154\t        \"--file-path\",\n155\t        cliThread,\n156\t        \"--message-id\",\n157\t        \"m1\",\n158\t        \"--form\",\n159\t        \"smoothed_prompt\",\n160\t      ],\n161\t      { LHC_PROVIDER: undefined },\n162\t    );\n163\t    expect(cliRequeue.status).toBe(0);\n164\t    const sdkRequeue = await messages.requeue(\n165\t      { filePath: sdkThread },\n166\t      { messageId: \"m1\", form: \"smoothed_prompt\" },\n167\t    );\n168\t    expect(JSON.parse(cliRequeue.stdout)).toEqual(sdkRequeue);\n169\t    expect(sdkRequeue.ok && sdkRequeue.value).toEqual({\n170\t      workItemId: \"w-m1-prompt_smoothing-v2\",\n171\t    });\n172\t\n173\t    // Idempotency through the CLI: the second ask is the explicit no-op.\n174\t    const cliNoop = runBinary(\n175\t      [\n176\t        \"messages\",\n177\t        \"requeue\",\n178\t        \"--file-path\",\n179\t        cliThread,\n180\t        \"--message-id\",\n181\t        \"m1\",\n182\t        \"--form\",\n183\t        \"smoothed_prompt\",\n184\t      ],\n185\t      { LHC_PROVIDER: undefined },\n186\t    );\n187\t    expect(cliNoop.status).toBe(0);\n188\t    const sdkNoop = await messages.requeue(\n189\t      { filePath: sdkThread },\n190\t      { messageId: \"m1\", form: \"smoothed_prompt\" },\n191\t    );\n192\t    expect(JSON.parse(cliNoop.stdout)).toEqual(sdkNoop);\n193\t    expect(sdkNoop.ok && sdkNoop.value).toEqual({ noop: \"already_queued\" });\n194\t\n195\t    // turns.requeue parity on the turn rebuild.\n196\t    const cliTurn = runBinary(\n197\t      [\n198\t        \"turns\",\n199\t        \"requeue\",\n200\t        \"--file-path\",\n201\t        cliThread,\n202\t        \"--subject-kind\",\n203\t        \"turn\",\n204\t        \"--subject-id\",\n205\t        \"t1\",\n206\t        \"--form\",\n207\t        \"turn_rendering\",\n208\t      ],\n209\t      { LHC_PROVIDER: undefined },\n210\t    );\n211\t    expect(cliTurn.status).toBe(0);\n212\t    const sdkTurn = await turns.requeue(\n213\t      { filePath: sdkThread },\n214\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n215\t    );\n216\t    expect(JSON.parse(cliTurn.stdout)).toEqual(sdkTurn);\n217\t    expect(sdkTurn.ok && sdkTurn.value).toEqual({ workItemId: \"w-t1-turn_derivation-v2\" });\n218\t\n219\t    // Refusal parity: a bogus target is the same caller error, exit 1.\n220\t    const cliMissing = runBinary(\n221\t      [\n222\t        \"messages\",\n223\t        \"requeue\",\n224\t        \"--file-path\",\n225\t        cliThread,\n226\t        \"--message-id\",\n227\t        \"m99\",\n228\t        \"--form\",\n229\t        \"smoothed_prompt\",\n230\t      ],\n231\t      { LHC_PROVIDER: undefined },\n232\t    );\n233\t    expect(cliMissing.status).toBe(1);\n234\t    const sdkMissing = await messages.requeue(\n235\t      { filePath: sdkThread },\n236\t      { messageId: \"m99\", form: \"smoothed_prompt\" },\n237\t    );\n238\t    expect(JSON.parse(cliMissing.stdout)).toEqual(sdkMissing);\n239\t    expect(!sdkMissing.ok && sdkMissing.error.code).toBe(\"message_not_found\");\n240\t  });\n241\t});\n242\t"}]},"parent_tool_use_id":null,"session_id":"468b9ce0-fb77-433b-844d-36c8f728df81","uuid":"40456cfb-7397-402b-aab7-bf318868499b","timestamp":"2026-06-12T14:02:35.219Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-report-repair.test.ts","content":"// Story 4 (Epic 02), process-boundary suite: CLI parity for the report and\n// requeue mirrors — `lhc messages report|requeue` and `lhc turns\n// report|requeue` through the spawned dist/cli.js produce the same result\n// JSON the SDK surfaces return (tech design CLI parity rule; supplemental\n// non-TC checks per the test plan). Report and requeue need no provider\n// (DD-11) — only the drain legs set LHC_PROVIDER. Runs under verify-all only\n// (LHC_PROCESS_SUITE=1). Lives in its own file because cli-process-work.test.ts\n// is hash-locked by the Story 1 red manifest; green may add files, not edit.\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  intakeStream,\n  messages,\n  resolveNamedProvider,\n  threads,\n  turns,\n  type FormReportEntry,\n  type OpResult,\n} from \"../src/index.js\";\nimport { validEvent } from \"./fixtures/index.js\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n\nfunction runBinary(\n  args: string[],\n  env?: Record<string, string | undefined>,\n): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    env: { ...process.env, ...env },\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-report-\"));\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\nasync function newThreadFile(name: string): Promise<string> {\n  const filePath = path.join(dir, `${name}.sqlite`);\n  const created = await threads.newThread({\n    filePath,\n    registryPath: path.join(dir, \"registry.sqlite\"),\n  });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\n// One closed prompt+answer turn, identical on both twins (fixed idempotency\n// keys; report rows for an undrained thread carry no timestamps, so the twin\n// JSON compares byte-equal without clock control).\nasync function seedTwin(filePath: string): Promise<void> {\n  const batch = [\n    validEvent(\"user_prompt\", { payload: { text: \"twin report prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"twin report answer\" } }),\n    validEvent(\"turn_end\"),\n  ].map((event, index) => ({ ...event, idempotencyKey: `twin-report-${index}` }));\n  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n}\n\ndescribe(\"CLI parity: report mirrors the SDK surfaces, no provider required\", () => {\n  it(\"messages and turns report JSON equals the SDK result on twin threads, including --not-ready\", async () => {\n    const cliThread = await newThreadFile(\"cli-report\");\n    const sdkThread = await newThreadFile(\"sdk-report\");\n    await seedTwin(cliThread);\n    await seedTwin(sdkThread);\n\n    const viaCli = runBinary([\"messages\", \"report\", \"--file-path\", cliThread], {\n      LHC_PROVIDER: undefined,\n    });\n    expect(viaCli.status).toBe(0);\n    const cliReport = JSON.parse(viaCli.stdout) as OpResult<FormReportEntry[]>;\n    const viaSdk = await messages.report({ filePath: sdkThread });\n    expect(cliReport).toEqual(viaSdk);\n\n    const viaCliTurns = runBinary(\n      [\"turns\", \"report\", \"--file-path\", cliThread, \"--not-ready\"],\n      { LHC_PROVIDER: undefined },\n    );\n    expect(viaCliTurns.status).toBe(0);\n    const cliTurnsReport = JSON.parse(viaCliTurns.stdout) as OpResult<FormReportEntry[]>;\n    const viaSdkTurns = await turns.report({ filePath: sdkThread }, { notReady: true });\n    expect(cliTurnsReport).toEqual(viaSdkTurns);\n    expect(cliTurnsReport.ok).toBe(true);\n    if (!cliTurnsReport.ok) return;\n    // The undrained twin is all pending with live queue detail in the rows.\n    expect(cliTurnsReport.value.map((entry) => [entry.form, entry.state])).toEqual([\n      [\"lower_band_projection\", \"pending\"],\n      [\"turn_rendering\", \"pending\"],\n    ]);\n    expect(cliTurnsReport.value[0]?.queue).toEqual({ status: \"queued\", attempts: 0 });\n  });\n\n  it(\"report on a missing thread exits 1 with thread_not_found\", async () => {\n    const missing = runBinary(\n      [\"messages\", \"report\", \"--file-path\", path.join(dir, \"nope.sqlite\")],\n      { LHC_PROVIDER: undefined },\n    );\n    expect(missing.status).toBe(1);\n    const parsed = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.code).toBe(\"thread_not_found\");\n  });\n});\n\ndescribe(\"CLI parity: requeue mirrors the SDK surfaces\", () => {\n  it(\"requeue through both owners returns identical result JSON on drained twins; the no-op and refusal legs match too\", async () => {\n    const cliThread = await newThreadFile(\"cli-requeue\");\n    const sdkThread = await newThreadFile(\"sdk-requeue\");\n    await seedTwin(cliThread);\n    await seedTwin(sdkThread);\n\n    // Drain both twins through the production provider registry (DD-11):\n    // the CLI twin via the spawned binary, the SDK twin via the same\n    // resolution seam in-process.\n    const drained = runBinary([\"work\", \"drain\", \"--file-path\", cliThread], {\n      LHC_PROVIDER: \"deterministic\",\n    });\n    expect(drained.status).toBe(0);\n    const provider = resolveNamedProvider(\"deterministic\");\n    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n    const sdk = createSdk({ provider, mode: \"manual\" });\n    const sdkDrained = await sdk.work.drain({ filePath: sdkThread });\n    expect(sdkDrained.ok).toBe(true);\n\n    // listChunks parity (ruling 012): the drained twins hold one open chunk\n    // with t1 placed; CLI JSON matches the SDK record shape exactly.\n    const cliChunks = runBinary([\"turns\", \"list-chunks\", \"--file-path\", cliThread], {\n      LHC_PROVIDER: undefined,\n    });\n    expect(cliChunks.status).toBe(0);\n    const sdkChunks = await turns.listChunks({ filePath: sdkThread });\n    expect(JSON.parse(cliChunks.stdout)).toEqual(sdkChunks);\n    expect(sdkChunks.ok && sdkChunks.value).toMatchObject([\n      { chunkId: \"c1\", status: \"open\", memberTurnIds: [\"t1\"] },\n    ]);\n\n    // messages.requeue parity: rebuild a ready smoothing at the next version.\n    const cliRequeue = runBinary(\n      [\n        \"messages\",\n        \"requeue\",\n        \"--file-path\",\n        cliThread,\n        \"--message-id\",\n        \"m1\",\n        \"--form\",\n        \"smoothed_prompt\",\n      ],\n      { LHC_PROVIDER: undefined },\n    );\n    expect(cliRequeue.status).toBe(0);\n    const sdkRequeue = await messages.requeue(\n      { filePath: sdkThread },\n      { messageId: \"m1\", form: \"smoothed_prompt\" },\n    );\n    expect(JSON.parse(cliRequeue.stdout)).toEqual(sdkRequeue);\n    expect(sdkRequeue.ok && sdkRequeue.value).toEqual({\n      workItemId: \"w-m1-prompt_smoothing-v2\",\n    });\n\n    // Idempotency through the CLI: the second ask is the explicit no-op.\n    const cliNoop = runBinary(\n      [\n        \"messages\",\n        \"requeue\",\n        \"--file-path\",\n        cliThread,\n        \"--message-id\",\n        \"m1\",\n        \"--form\",\n        \"smoothed_prompt\",\n      ],\n      { LHC_PROVIDER: undefined },\n    );\n    expect(cliNoop.status).toBe(0);\n    const sdkNoop = await messages.requeue(\n      { filePath: sdkThread },\n      { messageId: \"m1\", form: \"smoothed_prompt\" },\n    );\n    expect(JSON.parse(cliNoop.stdout)).toEqual(sdkNoop);\n    expect(sdkNoop.ok && sdkNoop.value).toEqual({ noop: \"already_queued\" });\n\n    // turns.requeue parity on the turn rebuild.\n    const cliTurn = runBinary(\n      [\n        \"turns\",\n        \"requeue\",\n        \"--file-path\",\n        cliThread,\n        \"--subject-kind\",\n        \"turn\",\n        \"--subject-id\",\n        \"t1\",\n        \"--form\",\n        \"turn_rendering\",\n      ],\n      { LHC_PROVIDER: undefined },\n    );\n    expect(cliTurn.status).toBe(0);\n    const sdkTurn = await turns.requeue(\n      { filePath: sdkThread },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n    );\n    expect(JSON.parse(cliTurn.stdout)).toEqual(sdkTurn);\n    expect(sdkTurn.ok && sdkTurn.value).toEqual({ workItemId: \"w-t1-turn_derivation-v2\" });\n\n    // Refusal parity: a bogus target is the same caller error, exit 1.\n    const cliMissing = runBinary(\n      [\n        \"messages\",\n        \"requeue\",\n        \"--file-path\",\n        cliThread,\n        \"--message-id\",\n        \"m99\",\n        \"--form\",\n        \"smoothed_prompt\",\n      ],\n      { LHC_PROVIDER: undefined },\n    );\n    expect(cliMissing.status).toBe(1);\n    const sdkMissing = await messages.requeue(\n      { filePath: sdkThread },\n      { messageId: \"m99\", form: \"smoothed_prompt\" },\n    );\n    expect(JSON.parse(cliMissing.stdout)).toEqual(sdkMissing);\n    expect(!sdkMissing.ok && sdkMissing.error.code).toBe(\"message_not_found\");\n  });\n});\n","numLines":242,"startLine":1,"totalLines":242}}}

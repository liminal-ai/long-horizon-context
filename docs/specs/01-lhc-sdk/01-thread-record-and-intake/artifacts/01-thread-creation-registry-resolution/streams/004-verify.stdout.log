{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/cli-process.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// CLI process-boundary suite: spawns the built dist/cli.js. Runs under\n     2\t// verify-all only (needs a build artifact); plain verify announces the skip.\n     3\timport { spawnSync } from \"node:child_process\";\n     4\timport { existsSync, mkdtempSync, rmSync } from \"node:fs\";\n     5\timport { tmpdir } from \"node:os\";\n     6\timport path from \"node:path\";\n     7\timport { fileURLToPath } from \"node:url\";\n     8\timport { describe, expect, it } from \"vitest\";\n     9\t\n    10\tconst cliPath = path.resolve(\n    11\t  path.dirname(fileURLToPath(import.meta.url)),\n    12\t  \"../dist/cli.js\",\n    13\t);\n    14\t\n    15\tfunction runBinary(args: string[]): {\n    16\t  status: number | null;\n    17\t  stdout: string;\n    18\t  stderr: string;\n    19\t} {\n    20\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    21\t    encoding: \"utf8\",\n    22\t  });\n    23\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    24\t}\n    25\t\n    26\tdescribe(\"FC-0.3 (process boundary): built binary\", () => {\n    27\t  it(\"dist/cli.js exists (build ran before this suite)\", () => {\n    28\t    expect(existsSync(cliPath)).toBe(true);\n    29\t  });\n    30\t\n    31\t  it(\"--help exits 0 with usage on stdout\", () => {\n    32\t    const result = runBinary([\"--help\"]);\n    33\t    expect(result.status).toBe(0);\n    34\t    expect(result.stdout).toContain(\"Usage:\");\n    35\t  });\n    36\t\n    37\t  it(\"unknown command exits 1 with structured JSON\", () => {\n    38\t    const result = runBinary([\"nonsense\"]);\n    39\t    expect(result.status).toBe(1);\n    40\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    41\t    expect(parsed.ok).toBe(false);\n    42\t  });\n    43\t\n    44\t  it(\"a planned command reaches its fail-closed stub through the real binary\", () => {\n    45\t    const result = runBinary([\"messages\", \"list\", \"--thread-id\", \"th_x\"]);\n    46\t    expect(result.status).toBe(1);\n    47\t    expect(JSON.parse(result.stdout)).toEqual({\n    48\t      ok: false,\n    49\t      error: {\n    50\t        errorClass: \"system_error\",\n    51\t        code: \"storage_failure\",\n    52\t        reason: \"not implemented: messages.list\",\n    53\t      },\n    54\t    });\n    55\t  });\n    56\t\n    57\t  it(\"Story 1: new-thread → resolve round-trip through the spawned binary\", () => {\n    58\t    const dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-\"));\n    59\t    try {\n    60\t      const registryPath = path.join(dir, \"registry.sqlite\");\n    61\t      const threadPath = path.join(dir, \"thread.sqlite\");\n    62\t\n    63\t      const created = runBinary([\n    64\t        \"threads\",\n    65\t        \"new-thread\",\n    66\t        \"--file-path\",\n    67\t        threadPath,\n    68\t        \"--title\",\n    69\t        \"process suite\",\n    70\t        \"--registry\",\n    71\t        registryPath,\n    72\t      ]);\n    73\t      expect(created.status).toBe(0);\n    74\t      const createdParsed = JSON.parse(created.stdout) as {\n    75\t        ok: boolean;\n    76\t        value: { threadId: string; filePath: string };\n    77\t      };\n    78\t      expect(createdParsed.ok).toBe(true);\n    79\t      expect(createdParsed.value.filePath).toBe(threadPath);\n    80\t\n    81\t      const resolved = runBinary([\n    82\t        \"threads\",\n    83\t        \"resolve\",\n    84\t        \"--thread-id\",\n    85\t        createdParsed.value.threadId,\n    86\t        \"--registry\",\n    87\t        registryPath,\n    88\t      ]);\n    89\t      expect(resolved.status).toBe(0);\n    90\t      const resolvedParsed = JSON.parse(resolved.stdout) as {\n    91\t        ok: boolean;\n    92\t        value: { threadId: string; filePath: string; title?: string };\n    93\t      };\n    94\t      expect(resolvedParsed.ok).toBe(true);\n    95\t      expect(resolvedParsed.value.threadId).toBe(createdParsed.value.threadId);\n    96\t      expect(resolvedParsed.value.filePath).toBe(threadPath);\n    97\t      expect(resolvedParsed.value.title).toBe(\"process suite\");\n    98\t    } finally {\n    99\t      rmSync(dir, { recursive: true, force: true });\n   100\t    }\n   101\t  });\n   102\t});\n","exit_code":0,"status":"completed"}}

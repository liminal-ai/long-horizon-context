{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/scripts/check-test-immutability.mjs | sed -n '1,500p'\"","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Green-phase guard: Red-committed test files must be byte-identical to the\n     3\t// hashes recorded in test/red-manifest.json. Green may add new test files but\n     4\t// may not modify Red's. Record hashes with scripts/record-red-manifest.mjs.\n     5\timport { createHash } from \"node:crypto\";\n     6\timport { existsSync, readFileSync } from \"node:fs\";\n     7\timport path from \"node:path\";\n     8\timport { fileURLToPath } from \"node:url\";\n     9\t\n    10\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    11\tconst manifestPath = path.join(pkgRoot, \"test\", \"red-manifest.json\");\n    12\t\n    13\tif (!existsSync(manifestPath)) {\n    14\t  console.log(\"test-immutability: no Red-phase manifest; nothing to check\");\n    15\t  process.exit(0);\n    16\t}\n    17\t\n    18\tconst manifest = JSON.parse(readFileSync(manifestPath, \"utf8\"));\n    19\tconst entries = Object.entries(manifest.files ?? {});\n    20\tif (entries.length === 0) {\n    21\t  console.log(\"test-immutability: Red-phase manifest empty; nothing to check\");\n    22\t  process.exit(0);\n    23\t}\n    24\t\n    25\tconst failures = [];\n    26\tfor (const [relPath, expectedHash] of entries) {\n    27\t  const full = path.join(pkgRoot, relPath);\n    28\t  if (!existsSync(full)) {\n    29\t    failures.push(`${relPath}: Red-phase test file is missing`);\n    30\t    continue;\n    31\t  }\n    32\t  const actual = createHash(\"sha256\").update(readFileSync(full)).digest(\"hex\");\n    33\t  if (actual !== expectedHash) {\n    34\t    failures.push(`${relPath}: modified since Red phase (hash mismatch)`);\n    35\t  }\n    36\t}\n    37\t\n    38\tif (failures.length > 0) {\n    39\t  console.error(\"test-immutability FAILED:\");\n    40\t  for (const f of failures) console.error(`  - ${f}`);\n    41\t  process.exit(1);\n    42\t}\n    43\tconsole.log(`test-immutability: OK (${entries.length} Red-phase files unchanged)`);\n","exit_code":0,"status":"completed"}}

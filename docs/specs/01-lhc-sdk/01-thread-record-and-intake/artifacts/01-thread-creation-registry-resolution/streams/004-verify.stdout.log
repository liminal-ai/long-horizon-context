rResult(await turns.listTurns(threadRefFrom(flags)));\n   115\t    case \"turns list-queued-work\":\n   116\t      return renderResult(await turns.listQueuedWork(threadRefFrom(flags)));\n   117\t    default:\n   118\t      return renderCliError(\n   119\t        \"caller_error\",\n   120\t        \"unknown_command\",\n   121\t        `unknown command: ${key}; run lhc --help`,\n   122\t      );\n   123\t  }\n   124\t}\n","exit_code":0,"status":"completed"}}

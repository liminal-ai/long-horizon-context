 31\t      expect(result.stdout).toContain(command);\n    32\t    }\n    33\t  });\n    34\t\n    35\t  it(\"unknown commands exit non-zero with a structured error\", async () => {\n    36\t    const result = await runCli([\"frobnicate\", \"everything\"]);\n    37\t    expect(result.exitCode).toBe(1);\n    38\t    const parsed = JSON.parse(result.stdout) as {\n    39\t      ok: boolean;\n    40\t      error: { errorClass: string; code: string; reason: string };\n    41\t    };\n    42\t    expect(parsed.ok).toBe(false);\n    43\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    44\t    expect(parsed.error.code).toBe(\"unknown_command\");\n    45\t    expect(parsed.error.reason).toContain(\"frobnicate\");\n    46\t  });\n    47\t\n    48\t  it(\"no command at all exits non-zero with a structured error\", async () => {\n    49\t    const result = await runCli([]);\n    50\t    expect(result.exitCode).toBe(1);\n    51\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    52\t    expect(parsed.ok).toBe(false);\n    53\t  });\n    54\t\n    55\t  it(\"every planned command routes to a fail-closed stub with the exact stub error shape\", async () => {\n    56\t    for (const { argv, op } of PLANNED_COMMANDS) {\n    57\t      const result = await runCli(argv);\n    58\t      expect(result.exitCode, `exit code for: ${argv.join(\" \")}`).toBe(1);\n    59\t      const parsed = JSON.parse(result.stdout) as unknown;\n    60\t      expect(parsed, `stub shape for: ${argv.join(\" \")}`).toEqual({\n    61\t        ok: false,\n    62\t        error: {\n    63\t          errorClass: \"system_error\",\n    64\t          code: \"storage_failure\",\n    65\t          reason: `not implemented: ${op}`,\n    66\t        },\n    67\t      });\n    68\t    }\n    69\t  });\n    70\t});\n    71\t\n    72\tdescribe(\"FC-0.5: token counting\", () => {\n    73\t  it(\"pins the estimator identity\", () => {\n    74\t    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n    75\t  });\n    76\t\n    77\t  it(\"returns golden counts for known strings\", () => {\n    78\t    expect(estimateTokens(\"\")).toBe(0);\n    79\t    expect(estimateTokens(\"hello world\")).toBe(2);\n    80\t  });\n    81\t\n    82\t  it(\"same input, same count, every run\", () => {\n    83\t    const inputs = [\n    84\t      \"hello world\",\n    85\t      \"The quick brown fox jumps over the lazy dog.\",\n    86\t      \"tokens: émojis 🎉 and 中文 text\",\n    87\t      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n    88\t    ];\n    89\t    for (const input of inputs) {\n    90\t      const first = estimateTokens(input);\n    91\t      expect(first).toBeGreaterThan(0);\n    92\t      expect(estimateTokens(input)).toBe(first);\n    93\t      expect(estimateTokens(input)).toBe(first);\n    94\t    }\n    95\t  });\n    96\t});\n","exit_code":0,"status":"completed"}}

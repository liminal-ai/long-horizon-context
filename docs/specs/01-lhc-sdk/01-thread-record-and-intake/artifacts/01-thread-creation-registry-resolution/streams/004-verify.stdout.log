{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/threads.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Flow 1: thread creation, registry, resolution (TC-1.1, 1.2, 1.3, 1.5, 1.6\n     2\t// plus lazy-init and read-path-equivalence supplementals). TC-1.4 is owned by\n     3\t// Story 2 — see the named todo at the bottom of the SDK suite.\n     4\timport { existsSync, readFileSync, writeFileSync } from \"node:fs\";\n     5\timport { join } from \"node:path\";\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport { runCli, threads, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n     8\timport { openRaw, tempStore, type TempStore } from \"./fixtures/index.js\";\n     9\t\n    10\tinterface MetadataRow {\n    11\t  thread_id: string;\n    12\t  created_at: string;\n    13\t  token_estimator: string;\n    14\t}\n    15\t\n    16\tinterface RegistryRow {\n    17\t  thread_id: string;\n    18\t  file_path: string;\n    19\t  title: string | null;\n    20\t  created_at: string;\n    21\t}\n    22\t\n    23\tfunction readMetadata(threadPath: string): MetadataRow {\n    24\t  const db = openRaw(threadPath);\n    25\t  try {\n    26\t    return db\n    27\t      .prepare(\"SELECT thread_id, created_at, token_estimator FROM thread_metadata\")\n    28\t      .get() as unknown as MetadataRow;\n    29\t  } finally {\n    30\t    db.close();\n    31\t  }\n    32\t}\n    33\t\n    34\tfunction registryRows(registryPath: string): RegistryRow[] {\n    35\t  const db = openRaw(registryPath);\n    36\t  try {\n    37\t    return db\n    38\t      .prepare(\n    39\t        \"SELECT thread_id, file_path, title, created_at FROM threads ORDER BY created_at, thread_id\",\n    40\t      )\n    41\t      .all() as unknown as RegistryRow[];\n    42\t  } finally {\n    43\t    db.close();\n    44\t  }\n    45\t}\n    46\t\n    47\tlet store: TempStore;\n    48\tbeforeEach(() => {\n    49\t  store = tempStore();\n    50\t});\n    51\tafterEach(() => {\n    52\t  store.cleanup();\n    53\t});\n    54\t\n    55\tdescribe(\"Flow 1 (SDK): thread creation, registry, resolution\", () => {\n    56\t  it(\"TC-1.1: create at a fresh path — file, metadata row, registry row\", async () => {\n    57\t    const threadPath = store.threadPath();\n    58\t    const result = await threads.newThread({\n    59\t      filePath: threadPath,\n    60\t      title: \"first thread\",\n    61\t      registryPath: store.registryPath,\n    62\t    });\n    63\t\n    64\t    expect(result.ok).toBe(true);\n    65\t    if (!result.ok) return;\n    66\t    expect(result.value.filePath).toBe(threadPath);\n    67\t    expect(result.value.threadId).toMatch(/^th_[a-z0-9]+$/);\n    68\t    expect(existsSync(threadPath)).toBe(true);\n    69\t\n    70\t    // AC-1.3: the id reads back from the file alone, no registry involved.\n    71\t    const metadata = readMetadata(threadPath);\n    72\t    expect(metadata.thread_id).toBe(result.value.threadId);\n    73\t    expect(metadata.token_estimator).toBe(TOKEN_ESTIMATOR_ID);\n    74\t    expect(new Date(metadata.created_at).toISOString()).toBe(metadata.created_at);\n    75\t\n    76\t    const rows = registryRows(store.registryPath);\n    77\t    expect(rows).toHaveLength(1);\n    78\t    expect(rows[0]).toEqual({\n    79\t      thread_id: result.value.threadId,\n    80\t      file_path: threadPath,\n    81\t      title: \"first thread\",\n    82\t      created_at: metadata.created_at,\n    83\t    });\n    84\t  });\n    85\t\n    86\t  it(\"TC-1.2: occupied path refused, file untouched, registry unchanged\", async () => {\n    87\t    const first = await threads.newThread({\n    88\t      filePath: store.threadPath(),\n    89\t      registryPath: store.registryPath,\n    90\t    });\n    91\t    expect(first.ok).toBe(true);\n    92\t\n    93\t    const occupied = join(store.dir, \"occupied.bin\");\n    94\t    const originalBytes = \"pre-existing content that must survive\";\n    95\t    writeFileSync(occupied, originalBytes);\n    96\t\n    97\t    const result = await threads.newThread({\n    98\t      filePath: occupied,\n    99\t      registryPath: store.registryPath,\n   100\t    });\n   101\t    expect(result.ok).toBe(false);\n   102\t    if (result.ok) return;\n   103\t    expect(result.error.code).toBe(\"path_exists\");\n   104\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   105\t\n   106\t    expect(readFileSync(occupied, \"utf8\")).toBe(originalBytes);\n   107\t    expect(registryRows(store.registryPath)).toHaveLength(1);\n   108\t  });\n   109\t\n   110\t  it(\"TC-1.3: resolve known id returns path and metadata; unknown id fails thread_not_found\", async () => {\n   111\t    const threadPath = store.threadPath();\n   112\t    const created = await threads.newThread({\n   113\t      filePath: threadPath,\n   114\t      title: \"resolvable\",\n   115\t      registryPath: store.registryPath,\n   116\t    });\n   117\t    expect(created.ok).toBe(true);\n   118\t    if (!created.ok) return;\n   119\t\n   120\t    const known = await threads.resolve({\n   121\t      threadId: created.value.threadId,\n   122\t      registryPath: store.registryPath,\n   123\t    });\n   124\t    expect(known.ok).toBe(true);\n   125\t    if (!known.ok) return;\n   126\t    expect(known.value.threadId).toBe(created.value.threadId);\n   127\t    expect(known.value.filePath).toBe(threadPath);\n   128\t    expect(known.value.title).toBe(\"resolvable\");\n   129\t    expect(known.value.createdAt).toBe(readMetadata(threadPath).created_at);\n   130\t\n   131\t    const unknown = await threads.resolve({\n   132\t      threadId: \"th_does_not_exist\",\n   133\t      registryPath: store.registryPath,\n   134\t    });\n   135\t    expect(unknown.ok).toBe(false);\n   136\t    if (unknown.ok) return;\n   137\t    expect(unknown.error.code).toBe(\"thread_not_found\");\n   138\t    expect(unknown.error.errorClass).toBe(\"caller_error\");\n   139\t  });\n   140\t\n   141\t  it(\"TC-1.5: listing returns all rows; absent registry lists empty without creating a file\", async () => {\n   142\t    const created: Array<{ threadId: string; filePath: string }> = [];\n   143\t    for (const title of [\"one\", \"two\", \"three\"]) {\n   144\t      const result = await threads.newThread({\n   145\t        filePath: store.threadPath(title),\n   146\t        title,\n   147\t        registryPath: store.registryPath,\n   148\t      });\n   149\t      expect(result.ok).toBe(true);\n   150\t      if (result.ok) created.push(result.value);\n   151\t    }\n   152\t\n   153\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\n   154\t    expect(listed.ok).toBe(true);\n   155\t    if (!listed.ok) return;\n   156\t    expect(listed.value).toHaveLength(3);\n   157\t    const byId = new Map(listed.value.map((info) => [info.threadId, info]));\n   158\t    for (const [index, title] of [\"one\", \"two\", \"three\"].entries()) {\n   159\t      const info = byId.get(created[index]!.threadId);\n   160\t      expect(info).toBeDefined();\n   161\t      expect(info?.filePath).toBe(created[index]!.filePath);\n   162\t      expect(info?.title).toBe(title);\n   163\t      expect(info?.createdAt).toBeTruthy();\n   164\t    }\n   165\t\n   166\t    const absentPath = join(store.dir, \"never-written.sqlite\");\n   167\t    const empty = await threads.listThreads({ registryPath: absentPath });\n   168\t    expect(empty.ok).toBe(true);\n   169\t    if (!empty.ok) return;\n   170\t    expect(empty.value).toEqual([]);\n   171\t    expect(existsSync(absentPath)).toBe(false);\n   172\t  });\n   173\t\n   174\t  it(\"TC-1.6: registry insert failure compensates — thread file deleted, no registry, no orphan row\", async () => {\n   175\t    const blocker = join(store.dir, \"blocker\");\n   176\t    writeFileSync(blocker, \"a regular file where a directory must be\");\n   177\t    const badRegistry = join(blocker, \"registry.sqlite\");\n   178\t\n   179\t    const threadPath = store.threadPath();\n   180\t    const result = await threads.newThread({\n   181\t      filePath: threadPath,\n   182\t      registryPath: badRegistry,\n   183\t    });\n   184\t    expect(result.ok).toBe(false);\n   185\t    if (result.ok) return;\n   186\t    expect(result.error.errorClass).toBe(\"system_error\");\n   187\t    expect(result.error.code).toBe(\"storage_failure\");\n   188\t\n   189\t    expect(existsSync(threadPath)).toBe(false);\n   190\t    expect(existsSync(badRegistry)).toBe(false);\n   191\t    expect(readFileSync(blocker, \"utf8\")).toBe(\n   192\t      \"a regular file where a directory must be\",\n   193\t    );\n   194\t  });\n   195\t\n   196\t  it(\"lazy-init supplemental: resolve against an absent registry returns thread_not_found and creates nothing\", async () => {\n   197\t    const absentPath = join(store.dir, \"absent-registry.sqlite\");\n   198\t    const result = await threads.resolve({\n   199\t      threadId: \"th_anything\",\n   200\t      registryPath: absentPath,\n   201\t    });\n   202\t    expect(result.ok).toBe(false);\n   203\t    if (result.ok) return;\n   204\t    expect(result.error.code).toBe(\"thread_not_found\");\n   205\t    expect(existsSync(absentPath)).toBe(false);\n   206\t  });\n   207\t\n   208\t  it(\"read-path equivalence: resolveThreadRef lands id and path references on the same file\", async () => {\n   209\t    const threadPath = store.threadPath();\n   210\t    const created = await threads.newThread({\n   211\t      filePath: threadPath,\n   212\t      registryPath: store.registryPath,\n   213\t    });\n   214\t    expect(created.ok).toBe(true);\n   215\t    if (!created.ok) return;\n   216\t\n   217\t    const byId = await threads.resolveThreadRef({\n   218\t      threadId: created.value.threadId,\n   219\t      registryPath: store.registryPath,\n   220\t    });\n   221\t    const byPath = await threads.resolveThreadRef({ filePath: threadPath });\n   222\t    expect(byId.ok).toBe(true);\n   223\t    expect(byPath.ok).toBe(true);\n   224\t    if (!byId.ok || !byPath.ok) return;\n   225\t    expect(byId.value.filePath).toBe(threadPath);\n   226\t    expect(byPath.value.filePath).toBe(threadPath);\n   227\t\n   228\t    // Both reads reach the same thread: identical metadata through either ref.\n   229\t    expect(readMetadata(byId.value.filePath).thread_id).toBe(created.value.threadId);\n   230\t    expect(readMetadata(byPath.value.filePath).thread_id).toBe(created.value.threadId);\n   231\t\n   232\t    const unknown = await threads.resolveThreadRef({\n   233\t      threadId: \"th_unknown\",\n   234\t      registryPath: store.registryPath,\n   235\t    });\n   236\t    expect(unknown.ok).toBe(false);\n   237\t    if (unknown.ok) return;\n   238\t    expect(unknown.error.code).toBe(\"thread_not_found\");\n   239\t  });\n   240\t\n   241\t  // TC-1.4 (full id/path equivalence under message-events) is owned by\n   242\t  // Story 2: it sends batches through intake, which does not exist yet.\n   243\t  // This story proves read-path equivalence only (test above).\n   244\t  it.todo(\"TC-1.4: id/path equivalence under message-events — deferred to Story 2 (intake.test.ts)\");\n   245\t});\n   246\t\n   247\tdescribe(\"Flow 1 (CLI in-process): threads commands\", () => {\n   248\t  interface CliOk<T> {\n   249\t    ok: true;\n   250\t    value: T;\n   251\t  }\n   252\t  interface CliErr {\n   253\t    ok: false;\n   254\t    error: { errorClass: string; code: string; reason: string };\n   255\t  }\n   256\t\n   257\t  function parseStdout<T>(stdout: string): CliOk<T> | CliErr {\n   258\t    return JSON.parse(stdout) as CliOk<T> | CliErr;\n   259\t  }\n   260\t\n   261\t  it(\"TC-1.1 (CLI): new-thread creates file, metadata, and registry row\", async () => {\n   262\t    const threadPath = store.threadPath();\n   263\t    const result = await runCli([\n   264\t      \"threads\",\n   265\t      \"new-thread\",\n   266\t      \"--file-path\",\n   267\t      threadPath,\n   268\t      \"--title\",\n   269\t      \"cli thread\",\n   270\t      \"--registry\",\n   271\t      store.registryPath,\n   272\t    ]);\n   273\t    expect(result.exitCode).toBe(0);\n   274\t    const parsed = parseStdout<{ threadId: string; filePath: string }>(result.stdout);\n   275\t    expect(parsed.ok).toBe(true);\n   276\t    if (!parsed.ok) return;\n   277\t    expect(parsed.value.filePath).toBe(threadPath);\n   278\t    expect(readMetadata(threadPath).thread_id).toBe(parsed.value.threadId);\n   279\t    expect(registryRows(store.registryPath)).toHaveLength(1);\n   280\t  });\n   281\t\n   282\t  it(\"TC-1.2 (CLI): occupied path exits 1 with path_exists\", async () => {\n   283\t    const occupied = join(store.dir, \"occupied.bin\");\n   284\t    writeFileSync(occupied, \"already here\");\n   285\t    const result = await runCli([\n   286\t      \"threads\",\n   287\t      \"new-thread\",\n   288\t      \"--file-path\",\n   289\t      occupied,\n   290\t      \"--registry\",\n   291\t      store.registryPath,\n   292\t    ]);\n   293\t    expect(result.exitCode).toBe(1);\n   294\t    const parsed = parseStdout<never>(result.stdout);\n   295\t    expect(parsed.ok).toBe(false);\n   296\t    if (parsed.ok) return;\n   297\t    expect(parsed.error.code).toBe(\"path_exists\");\n   298\t    expect(readFileSync(occupied, \"utf8\")).toBe(\"already here\");\n   299\t  });\n   300\t\n   301\t  it(\"TC-1.3 (CLI): resolve known id round-trips; unknown id exits 1 with thread_not_found\", async () => {\n   302\t    const threadPath = store.threadPath();\n   303\t    const created = await runCli([\n   304\t      \"threads\",\n   305\t      \"new-thread\",\n   306\t      \"--file-path\",\n   307\t      threadPath,\n   308\t      \"--registry\",\n   309\t      store.registryPath,\n   310\t    ]);\n   311\t    const createdParsed = parseStdout<{ threadId: string }>(created.stdout);\n   312\t    expect(createdParsed.ok).toBe(true);\n   313\t    if (!createdParsed.ok) return;\n   314\t\n   315\t    const known = await runCli([\n   316\t      \"threads\",\n   317\t      \"resolve\",\n   318\t      \"--thread-id\",\n   319\t      createdParsed.value.threadId,\n   320\t      \"--registry\",\n   321\t      store.registryPath,\n   322\t    ]);\n   323\t    expect(known.exitCode).toBe(0);\n   324\t    const knownParsed = parseStdout<{ threadId: string; filePath: string }>(known.stdout);\n   325\t    expect(knownParsed.ok).toBe(true);\n   326\t    if (!knownParsed.ok) return;\n   327\t    expect(knownParsed.value.filePath).toBe(threadPath);\n   328\t\n   329\t    const unknown = await runCli([\n   330\t      \"threads\",\n   331\t      \"resolve\",\n   332\t      \"--thread-id\",\n   333\t      \"th_nope\",\n   334\t      \"--registry\",\n   335\t      store.registryPath,\n   336\t    ]);\n   337\t    expect(unknown.exitCode).toBe(1);\n   338\t    const unknownParsed = parseStdout<never>(unknown.stdout);\n   339\t    expect(unknownParsed.ok).toBe(false);\n   340\t    if (unknownParsed.ok) return;\n   341\t    expect(unknownParsed.error.code).toBe(\"thread_not_found\");\n   342\t  });\n   343\t\n   344\t  it(\"TC-1.5 (CLI): list returns created threads; absent registry lists empty and creates nothing\", async () => {\n   345\t    for (const title of [\"a\", \"b\", \"c\"]) {\n   346\t      const result = await runCli([\n   347\t        \"threads\",\n   348\t        \"new-thread\",\n   349\t        \"--file-path\",\n   350\t        store.threadPath(title),\n   351\t        \"--title\",\n   352\t        title,\n   353\t        \"--registry\",\n   354\t        store.registryPath,\n   355\t      ]);\n   356\t      expect(result.exitCode).toBe(0);\n   357\t    }\n   358\t    const listed = await runCli([\"threads\", \"list\", \"--registry\", store.registryPath]);\n   359\t    expect(listed.exitCode).toBe(0);\n   360\t    const parsed = parseStdout<Array<{ threadId: string; title?: string }>>(listed.stdout);\n   361\t    expect(parsed.ok).toBe(true);\n   362\t    if (!parsed.ok) return;\n   363\t    expect(parsed.value).toHaveLength(3);\n   364\t    expect(parsed.value.map((row) => row.title).sort()).toEqual([\"a\", \"b\", \"c\"]);\n   365\t\n   366\t    const absentPath = join(store.dir, \"absent.sqlite\");\n   367\t    const empty = await runCli([\"threads\", \"list\", \"--registry\", absentPath]);\n   368\t    expect(empty.exitCode).toBe(0);\n   369\t    const emptyParsed = parseStdout<unknown[]>(empty.stdout);\n   370\t    expect(emptyParsed.ok).toBe(true);\n   371\t    if (!emptyParsed.ok) return;\n   372\t    expect(emptyParsed.value).toEqual([]);\n   373\t    expect(existsSync(absentPath)).toBe(false);\n   374\t  });\n   375\t\n   376\t  it(\"TC-1.6 (CLI): registry failure compensates — exit 1 and the thread file is gone\", async () => {\n   377\t    const blocker = join(store.dir, \"blocker\");\n   378\t    writeFileSync(blocker, \"regular file\");\n   379\t    const threadPath = store.threadPath();\n   380\t    const result = await runCli([\n   381\t      \"threads\",\n   382\t      \"new-thread\",\n   383\t      \"--file-path\",\n   384\t      threadPath,\n   385\t      \"--registry\",\n   386\t      join(blocker, \"registry.sqlite\"),\n   387\t    ]);\n   388\t    expect(result.exitCode).toBe(1);\n   389\t    const parsed = parseStdout<never>(result.stdout);\n   390\t    expect(parsed.ok).toBe(false);\n   391\t    if (parsed.ok) return;\n   392\t    expect(parsed.error.errorClass).toBe(\"system_error\");\n   393\t    expect(existsSync(threadPath)).toBe(false);\n   394\t  });\n   395\t});\n","exit_code":0,"status":"completed"}}

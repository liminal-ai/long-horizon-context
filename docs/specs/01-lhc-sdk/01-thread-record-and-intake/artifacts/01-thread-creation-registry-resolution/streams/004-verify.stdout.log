{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/threads/internal/registry.ts | sed -n '1,500p'\"","aggregated_output":"     1\timport { existsSync, mkdirSync } from \"node:fs\";\n     2\timport { homedir } from \"node:os\";\n     3\timport { dirname, join } from \"node:path\";\n     4\timport type { DatabaseSync } from \"node:sqlite\";\n     5\timport { openDatabase, runMigrations, type Migration } from \"../../../shared/storage.js\";\n     6\t\n     7\texport const DEFAULT_REGISTRY_PATH = join(homedir(), \".lhc\", \"registry.sqlite\");\n     8\t\n     9\texport function resolveRegistryPath(registryPath?: string): string {\n    10\t  return registryPath ?? DEFAULT_REGISTRY_PATH;\n    11\t}\n    12\t\n    13\tconst REGISTRY_MIGRATIONS: readonly Migration[] = [\n    14\t  {\n    15\t    version: 1,\n    16\t    statements: [\n    17\t      `CREATE TABLE threads (\n    18\t        thread_id TEXT PRIMARY KEY,\n    19\t        file_path TEXT NOT NULL,\n    20\t        title TEXT,\n    21\t        created_at TEXT NOT NULL\n    22\t      );`,\n    23\t    ],\n    24\t  },\n    25\t];\n    26\t\n    27\t// First write creates the database and schema lazily (design decision 6).\n    28\texport function openRegistryForWrite(registryPath: string): DatabaseSync {\n    29\t  mkdirSync(dirname(registryPath), { recursive: true });\n    30\t  const db = openDatabase(registryPath);\n    31\t  try {\n    32\t    runMigrations(db, REGISTRY_MIGRATIONS);\n    33\t  } catch (cause) {\n    34\t    db.close();\n    35\t    throw cause;\n    36\t  }\n    37\t  return db;\n    38\t}\n    39\t\n    40\t// Reads never create the registry: callers map null to empty list /\n    41\t// thread_not_found. The existence check is the non-creation guarantee —\n    42\t// openDatabase would create the file.\n    43\texport function openRegistryForRead(registryPath: string): DatabaseSync | null {\n    44\t  if (!existsSync(registryPath)) return null;\n    45\t  return openDatabase(registryPath);\n    46\t}\n    47\t\n    48\texport interface RegistryRow {\n    49\t  threadId: string;\n    50\t  filePath: string;\n    51\t  title?: string;\n    52\t  createdAt: string;\n    53\t}\n    54\t\n    55\tinterface RawRow {\n    56\t  thread_id: string;\n    57\t  file_path: string;\n    58\t  title: string | null;\n    59\t  created_at: string;\n    60\t}\n    61\t\n    62\tfunction toRegistryRow(raw: RawRow): RegistryRow {\n    63\t  const row: RegistryRow = {\n    64\t    threadId: raw.thread_id,\n    65\t    filePath: raw.file_path,\n    66\t    createdAt: raw.created_at,\n    67\t  };\n    68\t  if (raw.title !== null) row.title = raw.title;\n    69\t  return row;\n    70\t}\n    71\t\n    72\texport function insertThreadRow(db: DatabaseSync, row: RegistryRow): void {\n    73\t  db.prepare(\n    74\t    \"INSERT INTO threads (thread_id, file_path, title, created_at) VALUES (?, ?, ?, ?)\",\n    75\t  ).run(row.threadId, row.filePath, row.title ?? null, row.createdAt);\n    76\t}\n    77\t\n    78\texport function selectThreadRow(\n    79\t  db: DatabaseSync,\n    80\t  threadId: string,\n    81\t): RegistryRow | undefined {\n    82\t  const raw = db\n    83\t    .prepare(\"SELECT thread_id, file_path, title, created_at FROM threads WHERE thread_id = ?\")\n    84\t    .get(threadId) as unknown as RawRow | undefined;\n    85\t  return raw === undefined ? undefined : toRegistryRow(raw);\n    86\t}\n    87\t\n    88\texport function selectAllThreadRows(db: DatabaseSync): RegistryRow[] {\n    89\t  const raws = db\n    90\t    .prepare(\n    91\t      \"SELECT thread_id, file_path, title, created_at FROM threads ORDER BY created_at, thread_id\",\n    92\t    )\n    93\t    .all() as unknown as RawRow[];\n    94\t  return raws.map(toRegistryRow);\n    95\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"''^\" packages/lhc/src/domains/intake-stream/internal/pipeline.ts'","aggregated_output":"1:// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2:// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3:// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4:// Stories 3–5 extend the same per-event walk with projection, turn\n5:// transitions, and work queueing.\n6:import { existsSync } from \"node:fs\";\n7:import type { DatabaseSync } from \"node:sqlite\";\n8:import type { OperationContext } from \"../../../shared/context.js\";\n9:import { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n10:import type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n11:import { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\n12:import { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n13:import { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\n14:import type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n15:import { validateEvents, validateThreadRef } from \"./validate.js\";\n16:\n17:// Test seam (set only through test/fixtures): called after each event is\n18:// processed inside the walk, so atomicity under mid-walk failure can be\n19:// induced through a real mechanism — closing the handle — rather than a\n20:// mocked transaction object.\n21:export type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n22:let walkHook: IntakeWalkHook | null = null;\n23:export function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n24:  walkHook = hook;\n25:}\n26:\n27:// Test seam (set only through test/fixtures): replaces the wall clock so\n28:// recordedAt is sourced deterministically for the public SDK contract proof —\n29:// TC-1.4 records the same batch through both reference forms and reads it back\n30:// field-for-field, recordedAt included, with nothing stripped. Unset in\n31:// production: recording stamps real wall time. An explicit clock argument to\n32:// runMessageEvents still wins over the seam.\n33:let injectedClock: (() => Date) | null = null;\n34:export function setIntakeClock(clock: (() => Date) | null): void {\n35:  injectedClock = clock;\n36:}\n37:\n38:function detail(cause: unknown): string {\n39:  return cause instanceof Error ? cause.message : String(cause);\n40:}\n41:\n42:function threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n43:  return {\n44:    ok: false,\n45:    error: {\n46:      errorClass: \"caller_error\",\n47:      code: \"thread_not_found\",\n48:      reason: `no thread file exists at ${filePath}`,\n49:    },\n50:  };\n51:}\n52:\n53:// The skip set is read at transaction start and reads only the key column:\n54:// key-wins-over-content is the absence of a content comparison (AC-5.5).\n55:// Chunked to stay under SQLite's bound-parameter limit.\n56:function recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n57:  const found = new Set<string>();\n58:  for (let offset = 0; offset < keys.length; offset += 400) {\n59:    const chunk = keys.slice(offset, offset + 400);\n60:    const placeholders = chunk.map(() => \"?\").join(\", \");\n61:    const rows = db\n62:      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n63:      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n64:    for (const row of rows) found.add(row.idempotency_key);\n65:  }\n66:  return found;\n67:}\n68:\n69:function threadIdOf(db: DatabaseSync): string {\n70:  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n71:    | { thread_id: string }\n72:    | undefined;\n73:  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n74:  return row.thread_id;\n75:}\n76:\n77:function maxEventOrder(db: DatabaseSync): number {\n78:  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n79:    | { max_order: number | bigint | null }\n80:    | undefined;\n81:  return Number(row?.max_order ?? 0);\n82:}\n83:\n84:export async function runMessageEvents(\n85:  thread: ThreadRef,\n86:  events: readonly MessageEventInput[],\n87:  clock: () => Date = injectedClock ?? (() => new Date()),\n88:): Promise<OpResult<BatchResult>> {\n89:  // Pure validation first: a rejected batch never opens the file, never takes\n90:  // the write lock, and a duplicate key on a malformed event is a rejection,\n91:  // not a skip (validation-before-idempotency precedence).\n92:  const refFailure = validateThreadRef(thread);\n93:  if (refFailure !== undefined) return { ok: false, error: refFailure };\n94:  const batchFailure = validateEvents(events);\n95:  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n96:\n97:  const resolved = await resolveThreadRef(thread);\n98:  if (!resolved.ok) return resolved;\n99:  const { filePath } = resolved.value;\n100:  if (!existsSync(filePath)) return threadNotFound(filePath);\n101:\n102:  // openThreadDatabase verifies the file is a real thread file, then brings\n103:  // its schema to the current version before the batch transaction begins,\n104:  // so a thread recorded under an earlier story is writable here (F-03-001)\n105:  // and a non-thread file is rejected unmutated (F-03-002).\n106:  const opened = openThreadDatabase(filePath);\n107:  if (!opened.ok) return opened;\n108:  const db = opened.value;\n109:\n110:  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n111:  // single-writer violations fail loudly at a defined point.\n112:  let inTransaction = false;\n113:  try {\n114:    db.exec(\"BEGIN IMMEDIATE;\");\n115:    inTransaction = true;\n116:\n117:    // Cross-domain calls inside the transaction share the open handle through\n118:    // the operation context (design decision 8); built once per batch, never\n119:    // stored.\n120:    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n121:\n122:    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n123:    // any event is processed — once is sufficient because only this pipeline\n124:    // writes turn state and the write lock is already held, so more than one\n125:    // open turn can only mean external interference. The batch records\n126:    // nothing: nothing has been written yet, and the rollback closes the\n127:    // never-used transaction.\n128:    const openTurnIds = listOpenTurnIds(ctx);\n129:    if (openTurnIds.length > 1) {\n130:      db.exec(\"ROLLBACK;\");\n131:      inTransaction = false;\n132:      return {\n133:        ok: false,\n134:        error: {\n135:          errorClass: \"state_corruption\",\n136:          code: \"turn_state_corrupt\",\n137:          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n138:        },\n139:      };\n140:    }\n141:\n142:    const skipSet = recordedKeys(\n143:      db,\n144:      events.map((event) => event.idempotencyKey),\n145:    );\n146:    // Order counter from MAX(event_order): only recorded events increment it,\n147:    // so skips consume no order numbers and the sequence stays dense.\n148:    let lastOrder = maxEventOrder(db);\n149:\n150:    const insert = db.prepare(\n151:      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n152:       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n153:    );\n154:\n155:    const eventResults: BatchResult[\"events\"] = [];\n156:    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n157:    // Work items append as they queue, in walk order — the result is a\n158:    // faithful log of what the transaction did (AC-2.7). The full records\n159:    // (status, queuedAt) stay in the thread file; the result carries item\n160:    // identity only.\n161:    const queuedItems: WorkItemRecord[] = [];\n162:    for (const [index, event] of events.entries()) {\n163:      if (skipSet.has(event.idempotencyKey)) {\n164:        eventResults.push({\n165:          idempotencyKey: event.idempotencyKey,\n166:          outcome: \"skipped\",\n167:          skipReason: \"duplicate_idempotency_key\",\n168:        });\n169:      } else {\n170:        lastOrder += 1;\n171:        const recordedAt = clock().toISOString();\n172:        insert.run(\n173:          lastOrder,\n174:          event.eventKind,\n175:          event.idempotencyKey,\n176:          event.actor,\n177:          event.harness,\n178:          JSON.stringify(event.payload),\n179:          recordedAt,\n180:        );\n181:        skipSet.add(event.idempotencyKey);\n182:        // Turn transition before projection — the order is load-bearing: a\n183:        // prompt transitions first and stamps to the turn it just opened\n184:        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n185:        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n186:        // call, so a resend causes no transition (TC-5.4).\n187:        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n188:        turnTransitions.push(...turnOutcome.transitions);\n189:        queuedItems.push(...turnOutcome.queuedWork);\n190:        // Projection runs in the same iteration that recorded the event, so\n191:        // it can never drift from its source; a projection failure throws\n192:        // and rejects the whole batch. Skipped events never reach this call\n193:        // (no duplicate message, AC-5.4).\n194:        const created = createFromEvent(\n195:          ctx,\n196:          {\n197:            ...event,\n198:            eventOrder: lastOrder,\n199:            recordedAt,\n200:          },\n201:          turnOutcome.openTurnId,\n202:        );\n203:        // Message-owned work queues in the same iteration, gated on\n204:        // recorded: a skipped event never reaches this call, so it queues\n205:        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n206:        // decides which messages are derivation sources (AC-2.8).\n207:        queuedItems.push(...queueMessageWork(ctx, created));\n208:        const entry: BatchResult[\"events\"][number] = {\n209:          idempotencyKey: event.idempotencyKey,\n210:          outcome: \"recorded\",\n211:        };\n212:        if (created !== null) entry.messageId = created.messageId;\n213:        eventResults.push(entry);\n214:      }\n215:      walkHook?.(db, index);\n216:    }\n217:\n218:    db.exec(\"COMMIT;\");\n219:    inTransaction = false;\n220:\n221:    return {\n222:      ok: true,\n223:      value: {\n224:        events: eventResults,\n225:        turnTransitions,\n226:        queuedWork: queuedItems.map((item) => ({\n227:          workItemId: item.workItemId,\n228:          owner: item.owner,\n229:          kind: item.kind,\n230:          sourceRef: item.sourceRef,\n231:        })),\n232:        threadPosition: { lastEventOrder: lastOrder },\n233:      },\n234:    };\n235:  } catch (cause) {\n236:    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n237:    // class-independent. The handle may already be gone (induced failure),\n238:    // in which case SQLite has already discarded the uncommitted transaction.\n239:    if (inTransaction) {\n240:      try {\n241:        db.exec(\"ROLLBACK;\");\n242:      } catch {\n243:        // handle closed mid-walk; the open transaction died with it\n244:      }\n245:    }\n246:    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n247:  } finally {\n248:    try {\n249:      db.close();\n250:    } catch {\n251:      // already closed by the induced-failure seam\n252:    }\n253:  }\n254:}\n255:\n256:interface RawEventRow {\n257:  event_order: number | bigint;\n258:  event_kind: string;\n259:  idempotency_key: string;\n260:  actor: string;\n261:  harness: string;\n262:  payload: string;\n263:  recorded_at: string;\n264:}\n265:\n266:export async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n267:  const refFailure = validateThreadRef(thread);\n268:  if (refFailure !== undefined) return { ok: false, error: refFailure };\n269:\n270:  const resolved = await resolveThreadRef(thread);\n271:  if (!resolved.ok) return resolved;\n272:  const { filePath } = resolved.value;\n273:  if (!existsSync(filePath)) return threadNotFound(filePath);\n274:\n275:  const opened = openThreadDatabase(filePath);\n276:  if (!opened.ok) return opened;\n277:  const db = opened.value;\n278:  try {\n279:    const rows = db\n280:      .prepare(\n281:        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n282:         FROM event ORDER BY event_order`,\n283:      )\n284:      .all() as unknown as RawEventRow[];\n285:    const records = rows.map(\n286:      (row) =>\n287:        ({\n288:          eventKind: row.event_kind,\n289:          idempotencyKey: row.idempotency_key,\n290:          actor: row.actor,\n291:          harness: row.harness,\n292:          payload: JSON.parse(row.payload) as Record<string, unknown>,\n293:          eventOrder: Number(row.event_order),\n294:          recordedAt: row.recorded_at,\n295:        }) as unknown as EventRecord,\n296:    );\n297:    return { ok: true, value: records };\n298:  } catch (cause) {\n299:    return storageFailure(`event read-back failed: ${detail(cause)}`);\n300:  } finally {\n301:    db.close();\n302:  }\n303:}\n","exit_code":0,"status":"completed"}}

\":\\n      return {\\n        blocks: [\\n          {\\n            blockType: \\\"tool_result\\\",\\n            content: {\\n              toolCallId: event.payload.toolCallId,\\n              content: event.payload.content,\\n              isError: event.payload.isError ?? false,\\n            },\\n          },\\n        ],\\n        // Tool results count the full content string — the same string the\\n        // block carries in full.\\n        tokenEstimate: estimateTokens(event.payload.content),\\n      };\\n    case \\\"turn_end\\\":\\n      return null;\\n  }\\n}\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1111,\"cache_read_input_tokens\":114201,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1111},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa\",\"uuid\":\"26fc335d-fb96-45c4-9faf-213630b0520c\",\"request_id\":\"req_011Cbugyxj9QRHKW6zNuadBD\"}\npackages/lhc/docs/02-specs/01-thread-record-and-intake/artifacts/03-message-projection-tokens/streams/003-implementor.stdout.log:898:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_stop\",\"index\":1},\"session_id\":\"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa\",\"parent_tool_use_id\":null,\"uuid\":\"951e6e98-905b-4cba-a36b-36070ed4d6ef\"}\npackages/lhc/docs/02-specs/01-thread-record-and-intake/artifacts/03-message-projection-tokens/streams/003-implementor.stdout.log:899:{\"type\":\"stream_event\",\"event\":{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1111,\"cache_read_input_tokens\":114201,\"output_tokens\":849,\"output_tokens_details\":{\"thinking_token
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"''^\" packages/lhc/src/domains/messages/index.ts'","aggregated_output":"1:import { existsSync } from \"node:fs\";\n2:import type { OperationContext } from \"../../shared/context.js\";\n3:import { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n4:import {\n5:  listItems,\n6:  recordItem,\n7:  type WorkItemRecord,\n8:  type WorkKind,\n9:} from \"../../tech-utils/work-queue/index.js\";\n10:import type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n11:import {\n12:  openThreadDatabase,\n13:  resolveThreadRef,\n14:  type ThreadRef,\n15:} from \"../threads/index.js\";\n16:import { projectEvent } from \"./internal/project.js\";\n17:import { insertMessage, readMessages } from \"./internal/store.js\";\n18:\n19:export type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n20:\n21:export interface Block {\n22:  blockType: BlockType;\n23:  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n24:}\n25:\n26:export interface MessageRecord {\n27:  messageId: string;\n28:  sourceEventOrder: number;\n29:  kind: Exclude<EventKind, \"turn_end\">;\n30:  blocks: Block[];\n31:  tokenEstimate: number;\n32:  actor: string;\n33:  harness: string;\n34:  turnId?: string;\n35:}\n36:\n37:// The event as the walk holds it after recording: the validated input plus\n38:// its server-stamped order and timestamp.\n39:export type RecordedEvent = EventRecord;\n40:\n41:export type MessageCreated = {\n42:  messageId: string;\n43:  kind: Exclude<EventKind, \"turn_end\">;\n44:} | null;\n45:\n46:// Cross-domain surface, called by intake-stream inside the batch transaction\n47:// (the first such call through the operation context; turns.applyEvent\n48:// follows the pattern in Story 4). Synchronous and throwing by design: a\n49:// projection failure propagates to the pipeline's catch and rejects the\n50:// whole batch — recorded events without messages is the stranded state the\n51:// transaction exists to prevent. Returns null for turn_end (no message).\n52:// turnId is the membership stamp, settled by the pipeline before this call:\n53:// the turn open *after* this event's transition (so a prompt belongs to the\n54:// turn it just opened), or null in a gap — written once, never updated.\n55:export function createFromEvent(\n56:  ctx: OperationContext,\n57:  event: RecordedEvent,\n58:  turnId: string | null,\n59:): MessageCreated {\n60:  const projected = projectEvent(event);\n61:  if (projected === null) return null;\n62:  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n63:  const messageId = `m${event.eventOrder}`;\n64:  insertMessage(ctx.db, {\n65:    messageId,\n66:    sourceEventOrder: event.eventOrder,\n67:    kind,\n68:    tokenEstimate: projected.tokenEstimate,\n69:    actor: event.actor,\n70:    harness: event.harness,\n71:    turnId,\n72:    blocks: projected.blocks,\n73:  });\n74:  return { messageId, kind };\n75:}\n76:\n77:// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n78:// result queues tool_result_summary, nothing else queues anything — text,\n79:// thinking, and note messages are not derivation sources (AC-2.8, AC-2.7's\n80:// TC-2.9 half). Cross-domain surface, called by intake-stream inside the\n81:// batch transaction for every recorded message, so the item commits (or\n82:// rolls back) with the batch.\n83:const MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n84:  user_prompt: \"prompt_smoothing\",\n85:  tool_result: \"tool_result_summary\",\n86:};\n87:\n88:export function queueMessageWork(\n89:  ctx: OperationContext,\n90:  message: MessageCreated,\n91:): WorkItemRecord[] {\n92:  if (message === null) return [];\n93:  const kind = MESSAGE_WORK_KINDS[message.kind];\n94:  if (kind === undefined) return [];\n95:  const item = recordItem(\n96:    ctx.db,\n97:    { owner: \"messages\", kind, sourceRef: { messageId: message.messageId } },\n98:    ctx.clock().toISOString(),\n99:  );\n100:  return [item];\n101:}\n102:\n103:function threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n104:  return {\n105:    ok: false,\n106:    error: {\n107:      errorClass: \"caller_error\",\n108:      code: \"thread_not_found\",\n109:      reason: `no thread file exists at ${filePath}`,\n110:    },\n111:  };\n112:}\n113:\n114:export async function listMessages(\n115:  thread: ThreadRef,\n116:): Promise<OpResult<MessageRecord[]>> {\n117:  const resolved = await resolveThreadRef(thread);\n118:  if (!resolved.ok) return resolved;\n119:  const { filePath } = resolved.value;\n120:  if (!existsSync(filePath)) return threadNotFound(filePath);\n121:\n122:  // openThreadDatabase verifies the file is a real thread file and migrates\n123:  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n124:  // story lists cleanly (F-03-001) and a non-thread file is rejected\n125:  // unmutated (F-03-002).\n126:  const opened = openThreadDatabase(filePath);\n127:  if (!opened.ok) return opened;\n128:  const db = opened.value;\n129:  try {\n130:    return { ok: true, value: readMessages(db) };\n131:  } catch (cause) {\n132:    const reason = cause instanceof Error ? cause.message : String(cause);\n133:    return storageFailure(`message read-back failed: ${reason}`);\n134:  } finally {\n135:    db.close();\n136:  }\n137:}\n138:\n139:export async function listQueuedWork(\n140:  thread: ThreadRef,\n141:): Promise<OpResult<WorkItemRecord[]>> {\n142:  const resolved = await resolveThreadRef(thread);\n143:  if (!resolved.ok) return resolved;\n144:  const { filePath } = resolved.value;\n145:  if (!existsSync(filePath)) return threadNotFound(filePath);\n146:\n147:  const opened = openThreadDatabase(filePath);\n148:  if (!opened.ok) return opened;\n149:  const db = opened.value;\n150:  try {\n151:    return { ok: true, value: listItems(db, \"messages\") };\n152:  } catch (cause) {\n153:    const reason = cause instanceof Error ? cause.message : String(cause);\n154:    return storageFailure(`queued-work read-back failed: ${reason}`);\n155:  } finally {\n156:    db.close();\n157:  }\n158:}\n","exit_code":0,"status":"completed"}}

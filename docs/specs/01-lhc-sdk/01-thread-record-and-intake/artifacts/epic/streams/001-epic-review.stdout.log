registry <r>]\n37\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n38\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n39\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n40\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n41\t\n42\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n43\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n44\t`;\n45\t\n46\tinterface ParsedFlags {\n47\t  threadId?: string;\n48\t  filePath?: string;\n49\t  title?: string;\n50\t  registryPath?: string;\n51\t}\n52\t\n53\tfunction parseFlags(args: readonly string[]): ParsedFlags {\n54\t  const { values } = parseArgs({\n55\t    args: [...args],\n56\t    options: {\n57\t      \"thread-id\": { type: \"string\" },\n58\t      \"file-path\": { type: \"string\" },\n59\t      title: { type: \"string\" },\n60\t      registry: { type: \"string\" },\n61\t    },\n62\t    strict: false,\n63\t    allowPositionals: true,\n64\t  });\n65\t  const flags: ParsedFlags = {};\n66\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n67\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n68\t  if (typeof values.title === \"string\") flags.title = values.title;\n69\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n70\t  return flags;\n71\t}\n72\t\n73\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n74\t  if (flags.threadId !== undefined) {\n75\t    return flags.registryPath !== undefined\n76\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n77\t      : { threadId: flags.threadId };\n78\t  }\n79\t  return { filePath: flags.filePath ?? \"\" };\n80\t}\n81\t\n82\texport async function runCli(\n83\t  argv: readonly string[],\n84\t  readStdin: StdinReader = readProcessStdin,\n85\t): Promise<CliResult>
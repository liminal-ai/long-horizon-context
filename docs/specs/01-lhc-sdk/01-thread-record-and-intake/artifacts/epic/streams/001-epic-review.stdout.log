{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"''^\" packages/lhc/src/domains/intake-stream/internal/validate.ts'","aggregated_output":"1:// Flow 4: pure, whole-batch, three-layer closed validation. Strictness falls\n2:// out of schema construction: every layer is a closed Effect Schema struct\n3:// decoded under onExcessProperty: \"error\", so unknown-field rejection is a\n4:// property of the definitions, not a remembered rule. Validation never touches\n5:// a database; a rejected batch costs no write lock.\n6:import { Either, ParseResult, Schema } from \"effect\";\n7:import type { ErrorResult } from \"../../../shared/errors.js\";\n8:\n9:export const EVENT_KINDS = [\n10:  \"user_prompt\",\n11:  \"assistant_text\",\n12:  \"assistant_thinking\",\n13:  \"runtime_note\",\n14:  \"tool_call\",\n15:  \"tool_result\",\n16:  \"turn_end\",\n17:] as const;\n18:\n19:// Denied by name with their own reason string: the old MVP's\n20:// silent-root-field-drop bug class gets named when it appears.\n21:const SERVER_GENERATED_FIELDS = [\n22:  \"eventOrder\",\n23:  \"recordedAt\",\n24:  \"threadEventId\",\n25:  \"schemaVersion\",\n26:] as const;\n27:\n28:const DECODE_OPTIONS = { onExcessProperty: \"error\", errors: \"first\" } as const;\n29:\n30:const NonEmptyString = Schema.String.pipe(Schema.minLength(1));\n31:\n32:// Layer 1 — envelope: thread reference shape, closed.\n33:const ThreadRefSchema = Schema.Union(\n34:  Schema.Struct({\n35:    threadId: NonEmptyString,\n36:    registryPath: Schema.optional(Schema.String),\n37:  }),\n38:  Schema.Struct({ filePath: NonEmptyString }),\n39:);\n40:\n41:// Layer 2 — event object: the five required fields, closed. payload presence\n42:// and shape are layer 3's job (Schema.Unknown keeps the key from reading as\n43:// an unexpected field here, and tolerates a missing key — presence is checked\n44:// explicitly below).\n45:const EventEnvelopeSchema = Schema.Struct({\n46:  eventKind: Schema.Literal(...EVENT_KINDS),\n47:  idempotencyKey: NonEmptyString,\n48:  actor: NonEmptyString,\n49:  harness: NonEmptyString,\n50:  payload: Schema.Unknown,\n51:});\n52:\n53:// Layer 3 — per-kind payload, closed. turn_end's empty-payload rule is its\n54:// own named check below (a closed Struct({}) admits any object).\n55:const TextPayloadSchema = Schema.Struct({ text: Schema.String });\n56:const ToolCallPayloadSchema = Schema.Struct({\n57:  toolCallId: NonEmptyString,\n58:  toolName: NonEmptyString,\n59:  arguments: Schema.Record({ key: Schema.String, value: Schema.Unknown }),\n60:});\n61:const ToolResultPayloadSchema = Schema.Struct({\n62:  toolCallId: NonEmptyString,\n63:  content: Schema.String,\n64:  isError: Schema.optional(Schema.Boolean),\n65:});\n66:\n67:function firstIssue(error: ParseResult.ParseError): string {\n68:  const issues = ParseResult.ArrayFormatter.formatErrorSync(error);\n69:  const issue = issues[0];\n70:  if (issue === undefined) return \"invalid value\";\n71:  if (issue.path.length === 0) return issue.message;\n72:  return `\"${issue.path.join(\".\")}\" ${issue.message}`;\n73:}\n74:\n75:function decodeIssue<A, I>(schema: Schema.Schema<A, I, never>, value: unknown): string | undefined {\n76:  const decoded = Schema.decodeUnknownEither(schema, DECODE_OPTIONS)(value);\n77:  return Either.isLeft(decoded) ? firstIssue(decoded.left) : undefined;\n78:}\n79:\n80:function callerError(reason: string, eventIndex?: number): ErrorResult {\n81:  const error: ErrorResult = {\n82:    errorClass: \"caller_error\",\n83:    code: \"invalid_event\",\n84:    reason,\n85:  };\n86:  if (eventIndex !== undefined) error.eventIndex = eventIndex;\n87:  return error;\n88:}\n89:\n90:// Envelope-level: the thread reference must decode against the closed union.\n91:// Returns undefined when valid.\n92:export function validateThreadRef(ref: unknown): ErrorResult | undefined {\n93:  const issue = decodeIssue(ThreadRefSchema, ref);\n94:  if (issue !== undefined) {\n95:    return callerError(`envelope: invalid thread reference — ${issue}`);\n96:  }\n97:  return undefined;\n98:}\n99:\n100:// Whole-batch validation: array order, first failure wins (AC-4.5). Returns\n101:// undefined when every event is valid.\n102:export function validateEvents(events: unknown): ErrorResult | undefined {\n103:  if (!Array.isArray(events)) {\n104:    return callerError(\"envelope: events must be a JSON array\");\n105:  }\n106:  if (events.length === 0) {\n107:    return {\n108:      errorClass: \"caller_error\",\n109:      code: \"empty_batch\",\n110:      reason: \"envelope: events array is empty; a batch must carry at least one event\",\n111:    };\n112:  }\n113:  for (const [index, event] of events.entries()) {\n114:    const failure = validateOneEvent(event, index);\n115:    if (failure !== undefined) return failure;\n116:  }\n117:  return undefined;\n118:}\n119:\n120:function validateOneEvent(event: unknown, index: number): ErrorResult | undefined {\n121:  if (typeof event !== \"object\" || event === null || Array.isArray(event)) {\n122:    return callerError(\"event: each event must be a JSON object\", index);\n123:  }\n124:  const record = event as Record<string, unknown>;\n125:\n126:  for (const field of SERVER_GENERATED_FIELDS) {\n127:    if (field in record) {\n128:      return callerError(\n129:        `event: server-generated field \"${field}\" must not be supplied by the caller`,\n130:        index,\n131:      );\n132:    }\n133:  }\n134:\n135:  const kind = record[\"eventKind\"];\n136:  if (typeof kind === \"string\" && !(EVENT_KINDS as readonly string[]).includes(kind)) {\n137:    return callerError(`event: unknown event kind \"${kind}\"`, index);\n138:  }\n139:\n140:  const envelope = Schema.decodeUnknownEither(EventEnvelopeSchema, DECODE_OPTIONS)(event);\n141:  if (Either.isLeft(envelope)) {\n142:    return callerError(`event: ${firstIssue(envelope.left)}`, index);\n143:  }\n144:\n145:  const payload = record[\"payload\"];\n146:  if (typeof payload !== \"object\" || payload === null || Array.isArray(payload)) {\n147:    return callerError(\"event: payload must be a JSON object\", index);\n148:  }\n149:\n150:  if (envelope.right.eventKind === \"turn_end\") {\n151:    const extraKeys = Object.keys(payload);\n152:    if (extraKeys.length > 0) {\n153:      return callerError(\n154:        `payload: turn_end events carry an empty payload; found field \"${extraKeys[0]}\"`,\n155:        index,\n156:      );\n157:    }\n158:    return undefined;\n159:  }\n160:\n161:  let issue: string | undefined;\n162:  switch (envelope.right.eventKind) {\n163:    case \"tool_call\":\n164:      issue = decodeIssue(ToolCallPayloadSchema, payload);\n165:      break;\n166:    case \"tool_result\":\n167:      issue = decodeIssue(ToolResultPayloadSchema, payload);\n168:      break;\n169:    default:\n170:      issue = decodeIssue(TextPayloadSchema, payload);\n171:      break;\n172:  }\n173:  if (issue !== undefined) {\n174:    return callerError(`payload: ${issue}`, index);\n175:  }\n176:  return undefined;\n177:}\n","exit_code":0,"status":"completed"}}

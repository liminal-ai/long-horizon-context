{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E4LYCc3gfkJQfjXs8vn5YV","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\t\n11\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n12\t// process stdin. null means interactive (TTY) — distinct from empty input\n13\t// only in how it arises; both are refused with empty_stdin before any SDK\n14\t// call (the SDK itself can never return that code).\n15\texport type StdinReader = () => Promise<string | null>;\n16\t\n17\tasync function readProcessStdin(): Promise<string | null> {\n18\t  if (process.stdin.isTTY) return null;\n19\t  process.stdin.setEncoding(\"utf8\");\n20\t  let data = \"\";\n21\t  for await (const chunk of process.stdin) data += String(chunk);\n22\t  return data;\n23\t}\n24\t\n25\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n26\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n27\t}\n28\t\n29\tconst HELP = `lhc — Long Horizon Context CLI\n30\t\n31\tUsage:\n32\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n33\t  lhc threads resolve --thread-id <id> [--registry <r>]\n34\t  lhc threads list [--registry <r>]\n35\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n36\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--
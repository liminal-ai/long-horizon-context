{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016bfkRQ3MJTKht8DUrt54HH","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\t\n11\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n12\t// process stdin. null means interactive (TTY) — distinct from empty input\n13\t// only in how it arises; both are refused with empty_stdin before any SDK\n14\t// call (the SDK itself can never return that code).\n15\texport type StdinReader = () => Promise<string | null>;\n16\t\n17\tasync function readProcessStdin(): Promise<string | null> {\n18\t  if (process.stdin.isTTY) return null;\n19\t  process.stdin.setEncoding(\"utf8\");\n20\t  let data = \"\";\n21\t  for await (const chunk of process.stdin) data += String(chunk);\n22\t  return data;\n23\t}\n24\t\n25\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n26\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n27\t}\n28\t\n29\tconst HELP = `lhc — Long Horizon Context CLI\n30\t\n31\tUsage:\n32\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n33\t  lhc threads resolve --thread-id <id> [--registry <r>]\n34\t  lhc threads list [--registry <r>]\n35\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n36\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n37\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n38\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n39\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n40\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n41\t\n42\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n43\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n44\t`;\n45\t\n46\tinterface ParsedFlags {\n47\t  threadId?: string;\n48\t  filePath?: string;\n49\t  title?: string;\n50\t  registryPath?: string;\n51\t}\n52\t\n53\t// strict parse rejects unknown/misspelled flags so they are named back to the\n54\t// caller, never silently dropped — the CLI boundary matching the SDK's\n55\t// closed-contract strictness. The failure is returned as data (not thrown) so\n56\t// runCli can render it as the structured usage error.\n57\ttype ParseFlagsResult =\n58\t  | { ok: true; flags: ParsedFlags }\n59\t  | { ok: false; unknownFlag: string };\n60\t\n61\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n62\t  let values;\n63\t  try {\n64\t    ({ values } = parseArgs({\n65\t      args: [...args],\n66\t      options: {\n67\t        \"thread-id\": { type: \"string\" },\n68\t        \"file-path\": { type: \"string\" },\n69\t        title: { type: \"string\" },\n70\t        registry: { type: \"string\" },\n71\t      },\n72\t      strict: true,\n73\t      allowPositionals: true,\n74\t    }));\n75\t  } catch (cause) {\n76\t    const message = cause instanceof Error ? cause.message : String(cause);\n77\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n78\t    // option '--file-pth'); surface that token, falling back to the message.\n79\t    const named = /'([^']+)'/.exec(message);\n80\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n81\t  }\n82\t  const flags: ParsedFlags = {};\n83\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n84\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n85\t  if (typeof values.title === \"string\") flags.title = values.title;\n86\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n87\t  return { ok: true, flags };\n88\t}\n89\t\n90\t// The read commands take a thread reference but no stdin; a missing reference\n91\t// is a usage error named before any SDK call, matching the intake commands.\n92\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n93\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n94\t    return renderCliError(\n95\t      \"caller_error\",\n96\t      \"missing_flag\",\n97\t      `${command} requires --thread-id or --file-path`,\n98\t    );\n99\t  }\n100\t  return undefined;\n101\t}\n102\t\n103\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n104\t  if (flags.threadId !== undefined) {\n105\t    return flags.registryPath !== undefined\n106\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n107\t      : { threadId: flags.threadId };\n108\t  }\n109\t  return { filePath: flags.filePath ?? \"\" };\n110\t}\n111\t\n112\texport async function runCli(\n113\t  argv: readonly string[],\n114\t  readStdin: StdinReader = readProcessStdin,\n115\t): Promise<CliResult> {\n116\t  if (argv.length === 0) {\n117\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n118\t  }\n119\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n120\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n121\t  }\n122\t\n123\t  const [group, command, ...rest] = argv;\n124\t  const key = command === undefined ? group : `${group} ${command}`;\n125\t  const parsed = parseFlags(command === undefined ? [] : rest);\n126\t  if (!parsed.ok) {\n127\t    return renderCliError(\n128\t      \"caller_error\",\n129\t      \"unknown_flag\",\n130\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n131\t    );\n132\t  }\n133\t  const flags = parsed.flags;\n134\t\n135\t  switch (key) {\n136\t    case \"threads new-thread\": {\n137\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n138\t      // instead of failing, so the adapter refuses before any SDK call.\n139\t      if (flags.filePath === undefined) {\n140\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n141\t      }\n142\t      const input: Parameters<typeof threads.newThread>[0] = {\n143\t        filePath: flags.filePath,\n144\t      };\n145\t      if (flags.title !== undefined) input.title = flags.title;\n146\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n147\t      return renderResult(await threads.newThread(input));\n148\t    }\n149\t    case \"threads resolve\": {\n150\t      if (flags.threadId === undefined) {\n151\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n152\t      }\n153\t      const input: Parameters<typeof threads.resolve>[0] = {\n154\t        threadId: flags.threadId,\n155\t      };\n156\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n157\t      return renderResult(await threads.resolve(input));\n158\t    }\n159\t    case \"threads list\": {\n160\t      return renderResult(\n161\t        await threads.listThreads(\n162\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n163\t        ),\n164\t      );\n165\t    }\n166\t    case \"intake-stream message-events\": {\n167\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n168\t        return renderCliError(\n169\t          \"caller_error\",\n170\t          \"missing_flag\",\n171\t          \"intake-stream message-events requires --thread-id or --file-path\",\n172\t        );\n173\t      }\n174\t      const text = await readStdin();\n175\t      if (text === null || text.trim() === \"\") {\n176\t        return renderResult(\n177\t          stdinCallerError(\n178\t            \"empty_stdin\",\n179\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n180\t          ),\n181\t        );\n182\t      }\n183\t      let parsed: unknown;\n184\t      try {\n185\t        parsed = JSON.parse(text);\n186\t      } catch (cause) {\n187\t        const detail = cause instanceof Error ? cause.message : String(cause);\n188\t        return renderResult(\n189\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n190\t        );\n191\t      }\n192\t      if (!Array.isArray(parsed)) {\n193\t        return renderResult(\n194\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n195\t        );\n196\t      }\n197\t      return renderResult(\n198\t        await intakeStream.messageEvents(\n199\t          threadRefFrom(flags),\n200\t          parsed as readonly MessageEventInput[],\n201\t        ),\n202\t      );\n203\t    }\n204\t    case \"intake-stream list-events\": {\n205\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n206\t        return renderCliError(\n207\t          \"caller_error\",\n208\t          \"missing_flag\",\n209\t          \"intake-stream list-events requires --thread-id or --file-path\",\n210\t        );\n211\t      }\n212\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n213\t    }\n214\t    case \"messages list\":\n215\t      return (\n216\t        requireThreadRef(flags, \"messages list\") ??\n217\t        renderResult(await messages.listMessages(threadRefFrom(flags)))\n218\t      );\n219\t    case \"messages list-queued-work\":\n220\t      return (\n221\t        requireThreadRef(flags, \"messages list-queued-work\")
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qjj4yKZWPwcr1zjzgxuuNy","type":"tool_result","content":"1\t// Epic Fix Batch 1, process boundary: the strict-flag and blank-path guards\n2\t// observed through the spawned dist/cli.js. Runs under verify-all only\n3\t// (LHC_PROCESS_SUITE=1), like the other cli-process suites.\n4\timport { spawnSync } from \"node:child_process\";\n5\timport { mkdtempSync, rmSync } from \"node:fs\";\n6\timport { tmpdir } from \"node:os\";\n7\timport path from \"node:path\";\n8\timport { fileURLToPath } from \"node:url\";\n9\timport { describe, expect, it } from \"vitest\";\n10\t\n11\tconst cliPath = path.resolve(\n12\t  path.dirname(fileURLToPath(import.meta.url)),\n13\t  \"../dist/cli.js\",\n14\t);\n15\t\n16\tfunction runBinary(args: string[]): {\n17\t  status: number | null;\n18\t  stdout: string;\n19\t  stderr: string;\n20\t} {\n21\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n22\t    encoding: \"utf8\",\n23\t  });\n24\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n25\t}\n26\t\n27\tdescribe(\"Epic Fix Batch 1 (process boundary): CLI usage guards\", () => {\n28\t  it(\"NB-2: an unknown flag exits 1 and is named back to the caller\", () => {\n29\t    const dir = mkdtempSync(path.join(tmpdir(), \"lhc-fix-\"));\n30\t    try {\n31\t      const result = runBinary([\n32\t        \"threads\",\n33\t        \"new-thread\",\n34\t        \"--file-path\",\n35\t        path.join(dir, \"thread.sqlite\"),\n36\t        \"--file-pth\",\n37\t        \"typo\",\n38\t        \"--registry\",\n39\t        path.join(dir, \"registry.sqlite\"),\n40\t      ]);\n41\t      expect(result.status).toBe(1);\n42\t      const parsed = JSON.parse(result.stdout) as {\n43\t        ok: boolean;\n44\t        error: { code: string; reason: string };\n45\t      };\n46\t      expect(parsed.ok).toBe(false);\n47\t      expect(parsed.error.code).toBe(\"unknown_flag\");\n48\t      expect(parsed.error.reason).toContain(\"--file-pth\");\n49\t    } finally {\n50\t      rmSync(dir, { recursive: true, force: true });\n51\t    }\n52\t  });\n53\t\n54\t  it(\"F-EPIC-001: an empty --file-path exits 1 with a caller_error\", () => {\n55\t    const dir = mkdtempSync(path.join(tmpdir(), \"lhc-fix-\"));\n56\t    try {\n57\t      const result = runBinary([\n58\t        \"threads\",\n59\t        \"new-thread\",\n60\t        \"--file-path\",\n61\t        \"\",\n62\t        \"--registry\",\n63\t        path.join(dir, \"registry.sqlite\"),\n64\t      ]);\n65\t      expect(result.status).toBe(1);\n66\t      const parsed = JSON.parse(result.stdout) as {\n67\t        ok: boolean;\n68\t        error: { errorClass: string; code: string };\n69\t      };\n70\t      expect(parsed.ok).toBe(false);\n71\t      expect(parsed.error.errorClass).toBe(\"caller_error\");\n72\t      expect(parsed.error.code).toBe(\"invalid_thread_ref\");\n73\t    } finally {\n74\t      rmSync(dir, { recursive: true, force: true });\n75\t    }\n76\t  });\n77\t});\n78\t"}]},"parent_tool_use_id":null,"session_id":"10fd9328-dcd9-4bde-8fdf-f73f0364e72b","uuid":"358c8499-a989-4774-9d4a-3c92f500ba63","timestamp":"2026-06-10T15:50:16.686Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-fix.test.ts","content":"// Epic Fix Batch 1, process boundary: the strict-flag and blank-path guards\n// observed through the spawned dist/cli.js. Runs under verify-all only\n// (LHC_PROCESS_SUITE=1), like the other cli-process suites.\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { describe, expect, it } from \"vitest\";\n\nconst cliPath = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  \"../dist/cli.js\",\n);\n\nfunction runBinary(args: string[]): {\n  status: number | null;\n  stdout: string;\n  stderr: string;\n} {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\ndescribe(\"Epic Fix Batch 1 (process boundary): CLI usage guards\", () => {\n  it(\"NB-2: an unknown flag exits 1 and is named back to the caller\", () => {\n    const dir = mkdtempSync(path.join(tmpdir(), \"lhc-fix-\"));\n    try {\n      const result = runBinary([\n        \"threads\",\n        \"new-thread\",\n        \"--file-path\",\n        path.join(dir, \"thread.sqlite\"),\n        \"--file-pth\",\n        \"typo\",\n        \"--registry\",\n        path.join(dir, \"registry.sqlite\"),\n      ]);\n      expect(result.status).toBe(1);\n      const parsed = JSON.parse(result.stdout) as {\n        ok: boolean;\n        error: { code: string; reason: string };\n      };\n      expect(parsed.ok).toBe(false);\n      expect(parsed.error.code).toBe(\"unknown_flag\");\n      expect(parsed.error.reason).toContain(\"--file-pth\");\n    } finally {\n      rmSync(dir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"F-EPIC-001: an empty --file-path exits 1 with a caller_error\", () => {\n    const dir = mkdtempSync(path.join(tmpdir(), \"lhc-fix-\"));\n    try {\n      const result = runBinary([\n        \"threads\",\n        \"new-thread\",\n        \"--file-path\",\n        \"\",\n        \"--registry\",\n        path.join(dir, \"registry.sqlite\"),\n      ]);\n      expect(result.status).toBe(1);\n      const parsed = JSON.parse(result.stdout) as {\n        ok: boolean;\n        error: { errorClass: string; code: string };\n      };\n      expect(parsed.ok).toBe(false);\n      expect(parsed.error.errorClass).toBe(\"caller_error\");\n      expect(parsed.error.code).toBe(\"invalid_thread_ref\");\n    } finally {\n      rmSync(dir, { recursive: true, force: true });\n    }\n  });\n});\n","numLines":78,"startLine":1,"totalLines":78}}}

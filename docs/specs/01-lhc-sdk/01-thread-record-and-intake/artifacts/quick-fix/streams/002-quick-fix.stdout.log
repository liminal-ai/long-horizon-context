{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01683JxKr1QX2JLT6RdYgXGA","type":"tool_result","content":"1\t// Flow 2 (recording half): TC-2.1, TC-2.8, TC-1.4 (closing Story 1's\n2\t// deferral), the four architecture-risk tests (mid-walk rollback, restart\n3\t// survival, no-lock-on-rejection, system_error rollback parity), and the CLI\n4\t// in-process stdin legs.\n5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n6\timport {\n7\t  intakeStream,\n8\t  runCli,\n9\t  threads,\n10\t  type EventRecord,\n11\t  type MessageEventInput,\n12\t} from \"../src/index.js\";\n13\timport {\n14\t  conversationTurn,\n15\t  eventBatch,\n16\t  openRaw,\n17\t  setIntakeWalkHook,\n18\t  tempStore,\n19\t  validEvent,\n20\t  type TempStore,\n21\t} from \"./fixtures/index.js\";\n22\t\n23\tlet store: TempStore;\n24\tbeforeEach(() => {\n25\t  store = tempStore();\n26\t});\n27\tafterEach(() => {\n28\t  setIntakeWalkHook(null);\n29\t  store.cleanup();\n30\t});\n31\t\n32\tasync function createThread(): Promise<string> {\n33\t  const filePath = store.threadPath();\n34\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n35\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n36\t  return filePath;\n37\t}\n38\t\n39\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n40\t  const result = await intakeStream.listEvents({ filePath });\n41\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n42\t  return result.value;\n43\t}\n44\t\n45\tdescribe(\"Flow 2 (SDK): event recording\", () => {\n46\t  it(\"TC-2.1: two batches record in array order with a dense, continuing event order\", async () => {\n47\t    const filePath = await createThread();\n48\t    const batchOne = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n49\t    const batchTwo = eventBatch([\"tool_result\", \"runtime_note\", \"turn_end\"]);\n50\t\n51\t    const first = await intakeStream.messageEvents({ filePath }, batchOne);\n52\t    expect(first.ok).toBe(true);\n53\t    if (!first.ok) return;\n54\t    expect(first.value.events.map((e) => e.outcome)).toEqual([\n55\t      \"recorded\",\n56\t      \"recorded\",\n57\t      \"recorded\",\n58\t    ]);\n59\t    expect(first.value.threadPosition.lastEventOrder).toBe(3);\n60\t\n61\t    const second = await intakeStream.messageEvents({ filePath }, batchTwo);\n62\t    expect(second.ok).toBe(true);\n63\t    if (!second.ok) return;\n64\t    expect(second.value.threadPosition.lastEventOrder).toBe(6);\n65\t\n66\t    const events = await readBack(filePath);\n67\t    expect(events.map((e) => e.eventOrder)).toEqual([1, 2, 3, 4, 5, 6]);\n68\t    expect(events.map((e) => e.eventKind)).toEqual([\n69\t      \"user_prompt\",\n70\t      \"assistant_text\",\n71\t      \"tool_call\",\n72\t      \"tool_result\",\n73\t      \"runtime_note\",\n74\t      \"turn_end\",\n75\t    ]);\n76\t    expect(events.map((e) => e.idempotencyKey)).toEqual(\n77\t      [...batchOne, ...batchTwo].map((e) => e.idempotencyKey),\n78\t    );\n79\t  });\n80\t\n81\t  it(\"TC-2.8: an empty batch is a caller error and records nothing\", async () => {\n82\t    const filePath = await createThread();\n83\t    const result = await intakeStream.messageEvents({ filePath }, []);\n84\t    expect(result.ok).toBe(false);\n85\t    if (result.ok) return;\n86\t    expect(result.error.errorClass).toBe(\"caller_error\");\n87\t    expect(result.error.code).toBe(\"empty_batch\");\n88\t    expect(result.error.reason).toContain(\"empty\");\n89\t\n90\t    expect(await readBack(filePath)).toEqual([]);\n91\t  });\n92\t\n93\t  it(\"TC-1.4: the same batch by thread id and by file path produces identical results and read-back (closes Story 1's deferral)\", async () => {\n94\t    const pathA = store.threadPath();\n95\t    const createdA = await threads.newThread({\n96\t      filePath: pathA,\n97\t      registryPath: store.registryPath,\n98\t    });\n99\t    expect(createdA.ok).toBe(true);\n100\t    if (!createdA.ok) return;\n101\t    const pathB = await createThread();\n102\t\n103\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\", \"turn_end\"]);\n104\t    const byId = await intakeStream.messageEvents(\n105\t      { threadId: createdA.value.threadId, registryPath: store.registryPath },\n106\t      batch,\n107\t    );\n108\t    const byPath = await intakeStream.messageEvents({ filePath: pathB }, batch);\n109\t    expect(byId.ok).toBe(true);\n110\t    expect(byPath.ok).toBe(true);\n111\t    if (!byId.ok || !byPath.ok) return;\n112\t    expect(byId.value).toEqual(byPath.value);\n113\t\n114\t    // Read-back equivalence through both reference forms, modulo recordedAt\n115\t    // (wall-clock; everything contractual must match exactly).\n116\t    const readById = await intakeStream.listEvents({\n117\t      threadId: createdA.value.threadId,\n118\t      registryPath: store.registryPath,\n119\t    });\n120\t    expect(readById.ok).toBe(true);\n121\t    if (!readById.ok) return;\n122\t    const readByPath = await readBack(pathB);\n123\t    const strip = (events: EventRecord[]) =>\n124\t      events.map(({ recordedAt, ...rest }) => {\n125\t        expect(new Date(recordedAt).toISOString()).toBe(recordedAt);\n126\t        return rest;\n127\t      });\n128\t    expect(strip(readById.value)).toEqual(strip(readByPath));\n129\t  });\n130\t\n131\t  it(\"architecture-risk: mid-walk failure rolls the whole batch back to baseline\", async () => {\n132\t    const filePath = await createThread();\n133\t    const baselineBatch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n134\t    const recorded = await intakeStream.messageEvents({ filePath }, baselineBatch);\n135\t    expect(recorded.ok).toBe(true);\n136\t    const baseline = await readBack(filePath);\n137\t    expect(baseline).toHaveLength(2);\n138\t\n139\t    // Real mechanism: the seam closes the handle inside the transaction after\n140\t    // the first event of the new batch has been recorded.\n141\t    setIntakeWalkHook((db, eventIndex) => {\n142\t      if (eventIndex === 0) db.close();\n143\t    });\n144\t    const result = await intakeStream.messageEvents(\n145\t      { filePath },\n146\t      eventBatch([\"tool_call\", \"tool_result\", \"turn_end\"]),\n147\t    );\n148\t    setIntakeWalkHook(null);\n149\t    expect(result.ok).toBe(false);\n150\t    if (result.ok) return;\n151\t    expect(result.error.errorClass).toBe(\"system_error\");\n152\t    expect(result.error.code).toBe(\"storage_failure\");\n153\t\n154\t    // Post-reopen read-back: not the operation's own claim about itself.\n155\t    expect(await readBack(filePath)).toEqual(baseline);\n156\t  });\n157\t\n158\t  it(\"architecture-risk: system_error rollback parity — storage failure mid-batch leaves no partial events\", async () => {\n159\t    const filePath = await createThread();\n160\t    setIntakeWalkHook((db, eventIndex) => {\n161\t      if (eventIndex === 1) db.close();\n162\t    });\n163\t    const result = await intakeStream.messageEvents({ filePath }, conversationTurn());\n164\t    setIntakeWalkHook(null);\n165\t    expect(result.ok).toBe(false);\n166\t    if (result.ok) return;\n167\t    expect(result.error.errorClass).toBe(\"system_error\");\n168\t    expect(result.error.code).toBe(\"storage_failure\");\n169\t\n170\t    // AC-4.6 is class-independent: the first two walked events are gone too.\n171\t    expect(await readBack(filePath)).toEqual([]);\n172\t    const db = openRaw(filePath);\n173\t    try {\n174\t      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n175\t        n: number | bigint;\n176\t      };\n177\t      expect(Number(row.n)).toBe(0);\n178\t    } finally {\n179\t      db.close();\n180\t    }\n181\t  });\n182\t\n183\t  it(\"architecture-risk: restart survival — reopen sees the identical record\", async () => {\n184\t    const filePath = await createThread();\n185\t    const batch = conversationTurn();\n186\t    const recorded = await intakeStream.messageEvents({ filePath }, batch);\n187\t    expect(recorded.ok).toBe(true);\n188\t\n189\t    // Every SDK operation opens and closes its own handle, so each read-back\n190\t    // below is a fresh open of the file the write durably left behind.\n191\t    const firstRead = await readBack(filePath);\n192\t    expect(firstRead).toHaveLength(5);\n193\t    const secondRead = await readBack(filePath);\n194\t    expect(secondRead).toEqual(firstRead);\n195\t\n196\t    const db = openRaw(filePath);\n197\t    try {\n198\t      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n199\t        n: number | bigint;\n200\t      };\n201\t      expect(Number(row.n)).toBe(5);\n202\t    } finally {\n203\t      db.close();\n204\t    }\n205\t  });\n206\t\n207\t  it(\"architecture-risk: a rejected batch takes no lock — rejection succeeds while another connection holds the write lock\", async () => {\n208\t    const filePath = await createThread();\n209\t    const locker = openRaw(filePath);\n210\t    try {\n211\t      locker.exec(\"BEGIN IMMEDIATE;\");\n212\t      // If rejection touched the transaction path it would block on the held\n213\t      // lock and surface SQLITE_BUSY as storage_failure; pure validation\n214\t      // returns the caller error immediately instead.\n215\t      const result = await intakeStream.messageEvents({ filePath }, [\n216\t        { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n217\t      ]);\n218\t      expect(result.ok).toBe(false);\n219\t      if (!result.ok) {\n220\t        expect(result.error.errorClass).toBe(\"caller_error\");\n221\t        expect(result.error.code).toBe(\"invalid_event\");\n222\t      }\n223\t      locker.exec(\"ROLLBACK;\");\n224\t    } finally {\n225\t      locker.close();\n226\t    }\n227\t    expect(await readBack(filePath)).toEqual([]);\n228\t  });\n229\t});\n230\t\n231\tdescribe(\"Flow 2 (CLI in-process): message-events stdin handling\", () => {\n232\t  it(\"records a batch from stdin and reads it back through list-events\", async () => {\n233\t    const filePath = await createThread();\n234\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n235\t    const recorded = await runCli(\n236\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n237\t      async () => JSON.stringify(batch),\n238\t    );\n239\t    expect(recorded.exitCode).toBe(0);\n240\t    const recordedParsed = JSON.parse(recorded.stdout) as {\n241\t      ok: boolean;\n242\t      value: { events: Array<{ outcome: string }>; threadPosition: { lastEventOrder: number } };\n243\t    };\n244\t    expect(recordedParsed.ok).toBe(true);\n245\t    expect(recordedParsed.value.events.map((e) => e.outcome)).toEqual([\n246\t      \"recorded\",\n247\t      \"recorded\",\n248\t    ]);\n249\t    expect(recordedParsed.value.threadPosition.lastEventOrder).toBe(2);\n250\t\n251\t    const listed = await runCli([\"intake-stream\", \"list-events\", \"--file-path\", filePath]);\n252\t    expect(listed.exitCode).toBe(0);\n253\t    const listedParsed = JSON.parse(listed.stdout) as {\n254\t      ok: boolean;\n255\t      value: Array<{ eventOrder: number; eventKind: string }>;\n256\t    };\n257\t    expect(listedParsed.ok).toBe(true);\n258\t    expect(listedParsed.value.map((e) => e.eventOrder)).toEqual([1, 2]);\n259\t  });\n260\t\n261\t  it(\"a TTY stdin is refused with empty_stdin before any SDK call\", async () => {\n262\t    const filePath = await createThread();\n263\t    const result = await runCli(\n264\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n265\t      async () => null,\n266\t    );\n267\t    expect(result.exitCode).toBe(1);\n268\t    const parsed = JSON.parse(result.stdout) as {\n269\t      ok: boolean;\n270\t      error: { errorClass: string; code: string };\n271\t    };\n272\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n273\t    expect(parsed.error.code).toBe(\"empty_stdin\");\n274\t    expect(await readBack(filePath)).toEqual([]);\n275\t  });\n276\t\n277\t  it(\"empty stdin is refused with empty_stdin; a JSON [] reaches the SDK as empty_batch — distinct codes\", async () => {\n278\t    const filePath = await createThread();\n279\t\n280\t    const empty = await runCli(\n281\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n282\t      async () => \"\",\n283\t    );\n284\t    expect(empty.exitCode).toBe(1);\n285\t    const emptyParsed = JSON.parse(empty.stdout) as { error: { code: string } };\n286\t    expect(emptyParsed.error.code).toBe(\"empty_stdin\");\n287\t\n288\t    const emptyArray = await runCli(\n289\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n290\t      async () => \"[]\",\n291\t    );\n292\t    expect(emptyArray.exitCode).toBe(1);\n293\t    const emptyArrayParsed = JSON.parse(emptyArray.stdout) as { error: { code: string } };\n294\t    expect(emptyArrayParsed.error.code).toBe(\"empty_batch\");\n295\t  });\n296\t\n297\t  it(\"malformed stdin JSON and a missing thread flag are caller errors\", async () => {\n298\t    const filePath = await createThread();\n299\t    const malformed = await runCli(\n300\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n301\t      async () => \"{not json\",\n302\t    );\n303\t    expect(malformed.exitCode).toBe(1);\n304\t    const malformedParsed = JSON.parse(malformed.stdout) as {\n305\t      error: { errorClass: string; code: string };\n306\t    };\n307\t    expect(malformedParsed.error.errorClass).toBe(\"caller_error\");\n308\t    expect(malformedParsed.error.code).toBe(\"invalid_event\");\n309\t\n310\t    const missingFlag = await runCli(\n311\t      [\"intake-stream\", \"message-events\"],\n312\t      async () => \"[]\",\n313\t    );\n314\t    expect(missingFlag.exitCode).toBe(1);\n315\t    const missingParsed = JSON.parse(missingFlag.stdout) as { error: { code: string } };\n316\t    expect(missingParsed.error.code).toBe(\"missing_flag\");\n317\t  });\n318\t});\n319\t"}]},"parent_tool_use_id":null,"session_id":"73841117-4412-4191-bf6e-d9dac3fc51d8","uuid":"2665980f-321a-4217-b5ff-9238d17ae8ce","timestamp":"2026-06-10T13:34:54.835Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/intake.test.ts","content":"// Flow 2 (recording half): TC-2.1, TC-2.8, TC-1.4 (closing Story 1's\n// deferral), the four architecture-risk tests (mid-walk rollback, restart\n// survival, no-lock-on-rejection, system_error rollback parity), and the CLI\n// in-process stdin legs.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  intakeStream,\n  runCli,\n  threads,\n  type EventRecord,\n  type MessageEventInput,\n} from \"../src/index.js\";\nimport {\n  conversationTurn,\n  eventBatch,\n  openRaw,\n  setIntakeWalkHook,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  setIntakeWalkHook(null);\n  store.cleanup();\n});\n\nasync function createThread(): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function readBack(filePath: string): Promise<EventRecord[]> {\n  const result = await intakeStream.listEvents({ filePath });\n  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n  return result.value;\n}\n\ndescribe(\"Flow 2 (SDK): event recording\", () => {\n  it(\"TC-2.1: two batches record in array order with a dense, continuing event order\", async () => {\n    const filePath = await createThread();\n    const batchOne = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n    const batchTwo = eventBatch([\"tool_result\", \"runtime_note\", \"turn_end\"]);\n\n    const first = await intakeStream.messageEvents({ filePath }, batchOne);\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.events.map((e) => e.outcome)).toEqual([\n      \"recorded\",\n      \"recorded\",\n      \"recorded\",\n    ]);\n    expect(first.value.threadPosition.lastEventOrder).toBe(3);\n\n    const second = await intakeStream.messageEvents({ filePath }, batchTwo);\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    expect(second.value.threadPosition.lastEventOrder).toBe(6);\n\n    const events = await readBack(filePath);\n    expect(events.map((e) => e.eventOrder)).toEqual([1, 2, 3, 4, 5, 6]);\n    expect(events.map((e) => e.eventKind)).toEqual([\n      \"user_prompt\",\n      \"assistant_text\",\n      \"tool_call\",\n      \"tool_result\",\n      \"runtime_note\",\n      \"turn_end\",\n    ]);\n    expect(events.map((e) => e.idempotencyKey)).toEqual(\n      [...batchOne, ...batchTwo].map((e) => e.idempotencyKey),\n    );\n  });\n\n  it(\"TC-2.8: an empty batch is a caller error and records nothing\", async () => {\n    const filePath = await createThread();\n    const result = await intakeStream.messageEvents({ filePath }, []);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"empty_batch\");\n    expect(result.error.reason).toContain(\"empty\");\n\n    expect(await readBack(filePath)).toEqual([]);\n  });\n\n  it(\"TC-1.4: the same batch by thread id and by file path produces identical results and read-back (closes Story 1's deferral)\", async () => {\n    const pathA = store.threadPath();\n    const createdA = await threads.newThread({\n      filePath: pathA,\n      registryPath: store.registryPath,\n    });\n    expect(createdA.ok).toBe(true);\n    if (!createdA.ok) return;\n    const pathB = await createThread();\n\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\", \"turn_end\"]);\n    const byId = await intakeStream.messageEvents(\n      { threadId: createdA.value.threadId, registryPath: store.registryPath },\n      batch,\n    );\n    const byPath = await intakeStream.messageEvents({ filePath: pathB }, batch);\n    expect(byId.ok).toBe(true);\n    expect(byPath.ok).toBe(true);\n    if (!byId.ok || !byPath.ok) return;\n    expect(byId.value).toEqual(byPath.value);\n\n    // Read-back equivalence through both reference forms, modulo recordedAt\n    // (wall-clock; everything contractual must match exactly).\n    const readById = await intakeStream.listEvents({\n      threadId: createdA.value.threadId,\n      registryPath: store.registryPath,\n    });\n    expect(readById.ok).toBe(true);\n    if (!readById.ok) return;\n    const readByPath = await readBack(pathB);\n    const strip = (events: EventRecord[]) =>\n      events.map(({ recordedAt, ...rest }) => {\n        expect(new Date(recordedAt).toISOString()).toBe(recordedAt);\n        return rest;\n      });\n    expect(strip(readById.value)).toEqual(strip(readByPath));\n  });\n\n  it(\"architecture-risk: mid-walk failure rolls the whole batch back to baseline\", async () => {\n    const filePath = await createThread();\n    const baselineBatch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n    const recorded = await intakeStream.messageEvents({ filePath }, baselineBatch);\n    expect(recorded.ok).toBe(true);\n    const baseline = await readBack(filePath);\n    expect(baseline).toHaveLength(2);\n\n    // Real mechanism: the seam closes the handle inside the transaction after\n    // the first event of the new batch has been recorded.\n    setIntakeWalkHook((db, eventIndex) => {\n      if (eventIndex === 0) db.close();\n    });\n    const result = await intakeStream.messageEvents(\n      { filePath },\n      eventBatch([\"tool_call\", \"tool_result\", \"turn_end\"]),\n    );\n    setIntakeWalkHook(null);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"system_error\");\n    expect(result.error.code).toBe(\"storage_failure\");\n\n    // Post-reopen read-back: not the operation's own claim about itself.\n    expect(await readBack(filePath)).toEqual(baseline);\n  });\n\n  it(\"architecture-risk: system_error rollback parity — storage failure mid-batch leaves no partial events\", async () => {\n    const filePath = await createThread();\n    setIntakeWalkHook((db, eventIndex) => {\n      if (eventIndex === 1) db.close();\n    });\n    const result = await intakeStream.messageEvents({ filePath }, conversationTurn());\n    setIntakeWalkHook(null);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"system_error\");\n    expect(result.error.code).toBe(\"storage_failure\");\n\n    // AC-4.6 is class-independent: the first two walked events are gone too.\n    expect(await readBack(filePath)).toEqual([]);\n    const db = openRaw(filePath);\n    try {\n      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n        n: number | bigint;\n      };\n      expect(Number(row.n)).toBe(0);\n    } finally {\n      db.close();\n    }\n  });\n\n  it(\"architecture-risk: restart survival — reopen sees the identical record\", async () => {\n    const filePath = await createThread();\n    const batch = conversationTurn();\n    const recorded = await intakeStream.messageEvents({ filePath }, batch);\n    expect(recorded.ok).toBe(true);\n\n    // Every SDK operation opens and closes its own handle, so each read-back\n    // below is a fresh open of the file the write durably left behind.\n    const firstRead = await readBack(filePath);\n    expect(firstRead).toHaveLength(5);\n    const secondRead = await readBack(filePath);\n    expect(secondRead).toEqual(firstRead);\n\n    const db = openRaw(filePath);\n    try {\n      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n        n: number | bigint;\n      };\n      expect(Number(row.n)).toBe(5);\n    } finally {\n      db.close();\n    }\n  });\n\n  it(\"architecture-risk: a rejected batch takes no lock — rejection succeeds while another connection holds the write lock\", async () => {\n    const filePath = await createThread();\n    const locker = openRaw(filePath);\n    try {\n      locker.exec(\"BEGIN IMMEDIATE;\");\n      // If rejection touched the transaction path it would block on the held\n      // lock and surface SQLITE_BUSY as storage_failure; pure validation\n      // returns the caller error immediately instead.\n      const result = await intakeStream.messageEvents({ filePath }, [\n        { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n      ]);\n      expect(result.ok).toBe(false);\n      if (!result.ok) {\n        expect(result.error.errorClass).toBe(\"caller_error\");\n        expect(result.error.code).toBe(\"invalid_event\");\n      }\n      locker.exec(\"ROLLBACK;\");\n    } finally {\n      locker.close();\n    }\n    expect(await readBack(filePath)).toEqual([]);\n  });\n});\n\ndescribe(\"Flow 2 (CLI in-process): message-events stdin handling\", () => {\n  it(\"records a batch from stdin and reads it back through list-events\", async () => {\n    const filePath = await createThread();\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n    const recorded = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => JSON.stringify(batch),\n    );\n    expect(recorded.exitCode).toBe(0);\n    const recordedParsed = JSON.parse(recorded.stdout) as {\n      ok: boolean;\n      value: { events: Array<{ outcome: string }>; threadPosition: { lastEventOrder: number } };\n    };\n    expect(recordedParsed.ok).toBe(true);\n    expect(recordedParsed.value.events.map((e) => e.outcome)).toEqual([\n      \"recorded\",\n      \"recorded\",\n    ]);\n    expect(recordedParsed.value.threadPosition.lastEventOrder).toBe(2);\n\n    const listed = await runCli([\"intake-stream\", \"list-events\", \"--file-path\", filePath]);\n    expect(listed.exitCode).toBe(0);\n    const listedParsed = JSON.parse(listed.stdout) as {\n      ok: boolean;\n      value: Array<{ eventOrder: number; eventKind: string }>;\n    };\n    expect(listedParsed.ok).toBe(true);\n    expect(listedParsed.value.map((e) => e.eventOrder)).toEqual([1, 2]);\n  });\n\n  it(\"a TTY stdin is refused with empty_stdin before any SDK call\", async () => {\n    const filePath = await createThread();\n    const result = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => null,\n    );\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string };\n    };\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"empty_stdin\");\n    expect(await readBack(filePath)).toEqual([]);\n  });\n\n  it(\"empty stdin is refused with empty_stdin; a JSON [] reaches the SDK as empty_batch — distinct codes\", async () => {\n    const filePath = await createThread();\n\n    const empty = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => \"\",\n    );\n    expect(empty.exitCode).toBe(1);\n    const emptyParsed = JSON.parse(empty.stdout) as { error: { code: string } };\n    expect(emptyParsed.error.code).toBe(\"empty_stdin\");\n\n    const emptyArray = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => \"[]\",\n    );\n    expect(emptyArray.exitCode).toBe(1);\n    const emptyArrayParsed = JSON.parse(emptyArray.stdout) as { error: { code: string } };\n    expect(emptyArrayParsed.error.code).toBe(\"empty_batch\");\n  });\n\n  it(\"malformed stdin JSON and a missing thread flag are caller errors\", async () => {\n    const filePath = await createThread();\n    const malformed = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => \"{not json\",\n    );\n    expect(malformed.exitCode).toBe(1);\n    const malformedParsed = JSON.parse(malformed.stdout) as {\n      error: { errorClass: string; code: string };\n    };\n    expect(malformedParsed.error.errorClass).toBe(\"caller_error\");\n    expect(malformedParsed.error.code).toBe(\"invalid_event\");\n\n    const missingFlag = await runCli(\n      [\"intake-stream\", \"message-events\"],\n      async () => \"[]\",\n    );\n    expect(missingFlag.exitCode).toBe(1);\n    const missingParsed = JSON.parse(missingFlag.stdout) as { error: { code: string } };\n    expect(missingParsed.error.code).toBe(\"missing_flag\");\n  });\n});\n","numLines":319,"startLine":1,"totalLines":319}}}

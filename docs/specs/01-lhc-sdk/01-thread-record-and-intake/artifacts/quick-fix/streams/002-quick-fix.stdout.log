{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LT3LdjnqJ6CK2ExYkUVZyR","type":"tool_result","content":"1\t// Flow 4: pure, whole-batch, three-layer closed validation. Strictness falls\n2\t// out of schema construction: every layer is a closed Effect Schema struct\n3\t// decoded under onExcessProperty: \"error\", so unknown-field rejection is a\n4\t// property of the definitions, not a remembered rule. Validation never touches\n5\t// a database; a rejected batch costs no write lock.\n6\timport { Either, ParseResult, Schema } from \"effect\";\n7\timport type { ErrorResult } from \"../../../shared/errors.js\";\n8\t\n9\texport const EVENT_KINDS = [\n10\t  \"user_prompt\",\n11\t  \"assistant_text\",\n12\t  \"assistant_thinking\",\n13\t  \"runtime_note\",\n14\t  \"tool_call\",\n15\t  \"tool_result\",\n16\t  \"turn_end\",\n17\t] as const;\n18\t\n19\t// Denied by name with their own reason string: the old MVP's\n20\t// silent-root-field-drop bug class gets named when it appears.\n21\tconst SERVER_GENERATED_FIELDS = [\n22\t  \"eventOrder\",\n23\t  \"recordedAt\",\n24\t  \"threadEventId\",\n25\t  \"schemaVersion\",\n26\t] as const;\n27\t\n28\tconst DECODE_OPTIONS = { onExcessProperty: \"error\", errors: \"first\" } as const;\n29\t\n30\tconst NonEmptyString = Schema.String.pipe(Schema.minLength(1));\n31\t\n32\t// Layer 1 — envelope: thread reference shape, closed.\n33\tconst ThreadRefSchema = Schema.Union(\n34\t  Schema.Struct({\n35\t    threadId: NonEmptyString,\n36\t    registryPath: Schema.optional(Schema.String),\n37\t  }),\n38\t  Schema.Struct({ filePath: NonEmptyString }),\n39\t);\n40\t\n41\t// Layer 2 — event object: the five required fields, closed. payload presence\n42\t// and shape are layer 3's job (Schema.Unknown keeps the key from reading as\n43\t// an unexpected field here, and tolerates a missing key — presence is checked\n44\t// explicitly below).\n45\tconst EventEnvelopeSchema = Schema.Struct({\n46\t  eventKind: Schema.Literal(...EVENT_KINDS),\n47\t  idempotencyKey: NonEmptyString,\n48\t  actor: NonEmptyString,\n49\t  harness: NonEmptyString,\n50\t  payload: Schema.Unknown,\n51\t});\n52\t\n53\t// Layer 3 — per-kind payload, closed. turn_end's empty-payload rule is its\n54\t// own named check below (a closed Struct({}) admits any object).\n55\tconst TextPayloadSchema = Schema.Struct({ text: Schema.String });\n56\tconst ToolCallPayloadSchema = Schema.Struct({\n57\t  toolCallId: NonEmptyString,\n58\t  toolName: NonEmptyString,\n59\t  arguments: Schema.Record({ key: Schema.String, value: Schema.Unknown }),\n60\t});\n61\tconst ToolResultPayloadSchema = Schema.Struct({\n62\t  toolCallId: NonEmptyString,\n63\t  content: Schema.String,\n64\t  isError: Schema.optional(Schema.Boolean),\n65\t});\n66\t\n67\tfunction firstIssue(error: ParseResult.ParseError): string {\n68\t  const issues = ParseResult.ArrayFormatter.formatErrorSync(error);\n69\t  const issue = issues[0];\n70\t  if (issue === undefined) return \"invalid value\";\n71\t  if (issue.path.length === 0) return issue.message;\n72\t  return `\"${issue.path.join(\".\")}\" ${issue.message}`;\n73\t}\n74\t\n75\tfunction decodeIssue<A, I>(schema: Schema.Schema<A, I, never>, value: unknown): string | undefined {\n76\t  const decoded = Schema.decodeUnknownEither(schema, DECODE_OPTIONS)(value);\n77\t  return Either.isLeft(decoded) ? firstIssue(decoded.left) : undefined;\n78\t}\n79\t\n80\tfunction callerError(reason: string, eventIndex?: number): ErrorResult {\n81\t  const error: ErrorResult = {\n82\t    errorClass: \"caller_error\",\n83\t    code: \"invalid_event\",\n84\t    reason,\n85\t  };\n86\t  if (eventIndex !== undefined) error.eventIndex = eventIndex;\n87\t  return error;\n88\t}\n89\t\n90\t// Envelope-level: the thread reference must decode against the closed union.\n91\t// Returns undefined when valid.\n92\texport function validateThreadRef(ref: unknown): ErrorResult | undefined {\n93\t  const issue = decodeIssue(ThreadRefSchema, ref);\n94\t  if (issue !== undefined) {\n95\t    return callerError(`envelope: invalid thread reference — ${issue}`);\n96\t  }\n97\t  return undefined;\n98\t}\n99\t\n100\t// Whole-batch validation: array order, first failure wins (AC-4.5). Returns\n101\t// undefined when every event is valid.\n102\texport function validateEvents(events: unknown): ErrorResult | undefined {\n103\t  if (!Array.isArray(events)) {\n104\t    return callerError(\"envelope: events must be a JSON array\");\n105\t  }\n106\t  if (events.length === 0) {\n107\t    return {\n108\t      errorClass: \"caller_error\",\n109\t      code: \"empty_batch\",\n110\t      reason: \"envelope: events array is empty; a batch must carry at least one event\",\n111\t    };\n112\t  }\n113\t  for (const [index, event] of events.entries()) {\n114\t    const failure = validateOneEvent(event, index);\n115\t    if (failure !== undefined) return failure;\n116\t  }\n117\t  return undefined;\n118\t}\n119\t\n120\tfunction validateOneEvent(event: unknown, index: number): ErrorResult | undefined {\n121\t  if (typeof event !== \"object\" || event === null || Array.isArray(event)) {\n122\t    return callerError(\"event: each event must be a JSON object\", index);\n123\t  }\n124\t  const record = event as Record<string, unknown>;\n125\t\n126\t  for (const field of SERVER_GENERATED_FIELDS) {\n127\t    if (field in record) {\n128\t      return callerError(\n129\t        `event: server-generated field \"${field}\" must not be supplied by the caller`,\n130\t        index,\n131\t      );\n132\t    }\n133\t  }\n134\t\n135\t  const kind = record[\"eventKind\"];\n136\t  if (typeof kind === \"string\" && !(EVENT_KINDS as readonly string[]).includes(kind)) {\n137\t    return callerError(`event: unknown event kind \"${kind}\"`, index);\n138\t  }\n139\t\n140\t  const envelope = Schema.decodeUnknownEither(EventEnvelopeSchema, DECODE_OPTIONS)(event);\n141\t  if (Either.isLeft(envelope)) {\n142\t    return callerError(`event: ${firstIssue(envelope.left)}`, index);\n143\t  }\n144\t\n145\t  const payload = record[\"payload\"];\n146\t  if (typeof payload !== \"object\" || payload === null || Array.isArray(payload)) {\n147\t    return callerError(\"event: payload must be a JSON object\", index);\n148\t  }\n149\t\n150\t  if (envelope.right.eventKind === \"turn_end\") {\n151\t    const extraKeys = Object.keys(payload);\n152\t    if (extraKeys.length > 0) {\n153\t      return callerError(\n154\t        `payload: turn_end events carry an empty payload; found field \"${extraKeys[0]}\"`,\n155\t        index,\n156\t      );\n157\t    }\n158\t    return undefined;\n159\t  }\n160\t\n161\t  let issue: string | undefined;\n162\t  switch (envelope.right.eventKind) {\n163\t    case \"tool_call\":\n164\t      issue = decodeIssue(ToolCallPayloadSchema, payload);\n165\t      break;\n166\t    case \"tool_result\":\n167\t      issue = decodeIssue(ToolResultPayloadSchema, payload);\n168\t      break;\n169\t    default:\n170\t      issue = decodeIssue(TextPayloadSchema, payload);\n171\t      break;\n172\t  }\n173\t  if (issue !== undefined) {\n174\t    return callerError(`payload: ${issue}`, index);\n175\t  }\n176\t  return undefined;\n177\t}\n178\t"}]},"parent_tool_use_id":null,"session_id":"73841117-4412-4191-bf6e-d9dac3fc51d8","uuid":"87754f51-7bda-4ce3-8e00-0e718005edc9","timestamp":"2026-06-10T13:35:04.528Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/validate.ts","content":"// Flow 4: pure, whole-batch, three-layer closed validation. Strictness falls\n// out of schema construction: every layer is a closed Effect Schema struct\n// decoded under onExcessProperty: \"error\", so unknown-field rejection is a\n// property of the definitions, not a remembered rule. Validation never touches\n// a database; a rejected batch costs no write lock.\nimport { Either, ParseResult, Schema } from \"effect\";\nimport type { ErrorResult } from \"../../../shared/errors.js\";\n\nexport const EVENT_KINDS = [\n  \"user_prompt\",\n  \"assistant_text\",\n  \"assistant_thinking\",\n  \"runtime_note\",\n  \"tool_call\",\n  \"tool_result\",\n  \"turn_end\",\n] as const;\n\n// Denied by name with their own reason string: the old MVP's\n// silent-root-field-drop bug class gets named when it appears.\nconst SERVER_GENERATED_FIELDS = [\n  \"eventOrder\",\n  \"recordedAt\",\n  \"threadEventId\",\n  \"schemaVersion\",\n] as const;\n\nconst DECODE_OPTIONS = { onExcessProperty: \"error\", errors: \"first\" } as const;\n\nconst NonEmptyString = Schema.String.pipe(Schema.minLength(1));\n\n// Layer 1 — envelope: thread reference shape, closed.\nconst ThreadRefSchema = Schema.Union(\n  Schema.Struct({\n    threadId: NonEmptyString,\n    registryPath: Schema.optional(Schema.String),\n  }),\n  Schema.Struct({ filePath: NonEmptyString }),\n);\n\n// Layer 2 — event object: the five required fields, closed. payload presence\n// and shape are layer 3's job (Schema.Unknown keeps the key from reading as\n// an unexpected field here, and tolerates a missing key — presence is checked\n// explicitly below).\nconst EventEnvelopeSchema = Schema.Struct({\n  eventKind: Schema.Literal(...EVENT_KINDS),\n  idempotencyKey: NonEmptyString,\n  actor: NonEmptyString,\n  harness: NonEmptyString,\n  payload: Schema.Unknown,\n});\n\n// Layer 3 — per-kind payload, closed. turn_end's empty-payload rule is its\n// own named check below (a closed Struct({}) admits any object).\nconst TextPayloadSchema = Schema.Struct({ text: Schema.String });\nconst ToolCallPayloadSchema = Schema.Struct({\n  toolCallId: NonEmptyString,\n  toolName: NonEmptyString,\n  arguments: Schema.Record({ key: Schema.String, value: Schema.Unknown }),\n});\nconst ToolResultPayloadSchema = Schema.Struct({\n  toolCallId: NonEmptyString,\n  content: Schema.String,\n  isError: Schema.optional(Schema.Boolean),\n});\n\nfunction firstIssue(error: ParseResult.ParseError): string {\n  const issues = ParseResult.ArrayFormatter.formatErrorSync(error);\n  const issue = issues[0];\n  if (issue === undefined) return \"invalid value\";\n  if (issue.path.length === 0) return issue.message;\n  return `\"${issue.path.join(\".\")}\" ${issue.message}`;\n}\n\nfunction decodeIssue<A, I>(schema: Schema.Schema<A, I, never>, value: unknown): string | undefined {\n  const decoded = Schema.decodeUnknownEither(schema, DECODE_OPTIONS)(value);\n  return Either.isLeft(decoded) ? firstIssue(decoded.left) : undefined;\n}\n\nfunction callerError(reason: string, eventIndex?: number): ErrorResult {\n  const error: ErrorResult = {\n    errorClass: \"caller_error\",\n    code: \"invalid_event\",\n    reason,\n  };\n  if (eventIndex !== undefined) error.eventIndex = eventIndex;\n  return error;\n}\n\n// Envelope-level: the thread reference must decode against the closed union.\n// Returns undefined when valid.\nexport function validateThreadRef(ref: unknown): ErrorResult | undefined {\n  const issue = decodeIssue(ThreadRefSchema, ref);\n  if (issue !== undefined) {\n    return callerError(`envelope: invalid thread reference — ${issue}`);\n  }\n  return undefined;\n}\n\n// Whole-batch validation: array order, first failure wins (AC-4.5). Returns\n// undefined when every event is valid.\nexport function validateEvents(events: unknown): ErrorResult | undefined {\n  if (!Array.isArray(events)) {\n    return callerError(\"envelope: events must be a JSON array\");\n  }\n  if (events.length === 0) {\n    return {\n      errorClass: \"caller_error\",\n      code: \"empty_batch\",\n      reason: \"envelope: events array is empty; a batch must carry at least one event\",\n    };\n  }\n  for (const [index, event] of events.entries()) {\n    const failure = validateOneEvent(event, index);\n    if (failure !== undefined) return failure;\n  }\n  return undefined;\n}\n\nfunction validateOneEvent(event: unknown, index: number): ErrorResult | undefined {\n  if (typeof event !== \"object\" || event === null || Array.isArray(event)) {\n    return callerError(\"event: each event must be a JSON object\", index);\n  }\n  const record = event as Record<string, unknown>;\n\n  for (const field of SERVER_GENERATED_FIELDS) {\n    if (field in record) {\n      return callerError(\n        `event: server-generated field \"${field}\" must not be supplied by the caller`,\n        index,\n      );\n    }\n  }\n\n  const kind = record[\"eventKind\"];\n  if (typeof kind === \"string\" && !(EVENT_KINDS as readonly string[]).includes(kind)) {\n    return callerError(`event: unknown event kind \"${kind}\"`, index);\n  }\n\n  const envelope = Schema.decodeUnknownEither(EventEnvelopeSchema, DECODE_OPTIONS)(event);\n  if (Either.isLeft(envelope)) {\n    return callerError(`event: ${firstIssue(envelope.left)}`, index);\n  }\n\n  const payload = record[\"payload\"];\n  if (typeof payload !== \"object\" || payload === null || Array.isArray(payload)) {\n    return callerError(\"event: payload must be a JSON object\", index);\n  }\n\n  if (envelope.right.eventKind === \"turn_end\") {\n    const extraKeys = Object.keys(payload);\n    if (extraKeys.length > 0) {\n      return callerError(\n        `payload: turn_end events carry an empty payload; found field \"${extraKeys[0]}\"`,\n        index,\n      );\n    }\n    return undefined;\n  }\n\n  let issue: string | undefined;\n  switch (envelope.right.eventKind) {\n    case \"tool_call\":\n      issue = decodeIssue(ToolCallPayloadSchema, payload);\n      break;\n    case \"tool_result\":\n      issue = decodeIssue(ToolResultPayloadSchema, payload);\n      break;\n    default:\n      issue = decodeIssue(TextPayloadSchema, payload);\n      break;\n  }\n  if (issue !== undefined) {\n    return callerError(`payload: ${issue}`, index);\n  }\n  return undefined;\n}\n","numLines":178,"startLine":1,"totalLines":178}}}

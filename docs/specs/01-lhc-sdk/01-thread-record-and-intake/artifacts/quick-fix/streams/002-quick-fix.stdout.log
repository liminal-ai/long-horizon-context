{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FrfCZrQxacQebKT4DtyfaA","type":"tool_result","content":"1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4\t// Stories 3–5 extend the same per-event walk with projection, turn\n5\t// transitions, and work queueing.\n6\timport { existsSync } from \"node:fs\";\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n9\timport { openDatabase } from \"../../../shared/storage.js\";\n10\timport { resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n11\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n12\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n13\t\n14\t// Test seam (set only through test/fixtures): called after each event is\n15\t// processed inside the walk, so atomicity under mid-walk failure can be\n16\t// induced through a real mechanism — closing the handle — rather than a\n17\t// mocked transaction object.\n18\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n19\tlet walkHook: IntakeWalkHook | null = null;\n20\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n21\t  walkHook = hook;\n22\t}\n23\t\n24\tfunction detail(cause: unknown): string {\n25\t  return cause instanceof Error ? cause.message : String(cause);\n26\t}\n27\t\n28\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n29\t  return {\n30\t    ok: false,\n31\t    error: {\n32\t      errorClass: \"caller_error\",\n33\t      code: \"thread_not_found\",\n34\t      reason: `no thread file exists at ${filePath}`,\n35\t    },\n36\t  };\n37\t}\n38\t\n39\t// The skip set is read at transaction start and reads only the key column:\n40\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n41\t// Chunked to stay under SQLite's bound-parameter limit.\n42\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n43\t  const found = new Set<string>();\n44\t  for (let offset = 0; offset < keys.length; offset += 400) {\n45\t    const chunk = keys.slice(offset, offset + 400);\n46\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n47\t    const rows = db\n48\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n49\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n50\t    for (const row of rows) found.add(row.idempotency_key);\n51\t  }\n52\t  return found;\n53\t}\n54\t\n55\tfunction maxEventOrder(db: DatabaseSync): number {\n56\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n57\t    | { max_order: number | bigint | null }\n58\t    | undefined;\n59\t  return Number(row?.max_order ?? 0);\n60\t}\n61\t\n62\texport async function runMessageEvents(\n63\t  thread: ThreadRef,\n64\t  events: readonly MessageEventInput[],\n65\t  clock: () => Date = () => new Date(),\n66\t): Promise<OpResult<BatchResult>> {\n67\t  // Pure validation first: a rejected batch never opens the file, never takes\n68\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n69\t  // not a skip (validation-before-idempotency precedence).\n70\t  const refFailure = validateThreadRef(thread);\n71\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n72\t  const batchFailure = validateEvents(events);\n73\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n74\t\n75\t  const resolved = await resolveThreadRef(thread);\n76\t  if (!resolved.ok) return resolved;\n77\t  const { filePath } = resolved.value;\n78\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n79\t\n80\t  let db: DatabaseSync;\n81\t  try {\n82\t    db = openDatabase(filePath);\n83\t  } catch (cause) {\n84\t    return storageFailure(`could not open thread file: ${detail(cause)}`);\n85\t  }\n86\t\n87\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n88\t  // single-writer violations fail loudly at a defined point.\n89\t  let inTransaction = false;\n90\t  try {\n91\t    db.exec(\"BEGIN IMMEDIATE;\");\n92\t    inTransaction = true;\n93\t\n94\t    const skipSet = recordedKeys(\n95\t      db,\n96\t      events.map((event) => event.idempotencyKey),\n97\t    );\n98\t    // Order counter from MAX(event_order): only recorded events increment it,\n99\t    // so skips consume no order numbers and the sequence stays dense.\n100\t    let lastOrder = maxEventOrder(db);\n101\t\n102\t    const insert = db.prepare(\n103\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n104\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n105\t    );\n106\t\n107\t    const eventResults: BatchResult[\"events\"] = [];\n108\t    for (const [index, event] of events.entries()) {\n109\t      if (skipSet.has(event.idempotencyKey)) {\n110\t        eventResults.push({\n111\t          idempotencyKey: event.idempotencyKey,\n112\t          outcome: \"skipped\",\n113\t          skipReason: \"duplicate_idempotency_key\",\n114\t        });\n115\t      } else {\n116\t        lastOrder += 1;\n117\t        insert.run(\n118\t          lastOrder,\n119\t          event.eventKind,\n120\t          event.idempotencyKey,\n121\t          event.actor,\n122\t          event.harness,\n123\t          JSON.stringify(event.payload),\n124\t          clock().toISOString(),\n125\t        );\n126\t        skipSet.add(event.idempotencyKey);\n127\t        eventResults.push({ idempotencyKey: event.idempotencyKey, outcome: \"recorded\" });\n128\t      }\n129\t      walkHook?.(db, index);\n130\t    }\n131\t\n132\t    db.exec(\"COMMIT;\");\n133\t    inTransaction = false;\n134\t\n135\t    return {\n136\t      ok: true,\n137\t      value: {\n138\t        events: eventResults,\n139\t        turnTransitions: [], // populated by Story 4\n140\t        queuedWork: [], // populated by Story 5\n141\t        threadPosition: { lastEventOrder: lastOrder },\n142\t      },\n143\t    };\n144\t  } catch (cause) {\n145\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n146\t    // class-independent. The handle may already be gone (induced failure),\n147\t    // in which case SQLite has already discarded the uncommitted transaction.\n148\t    if (inTransaction) {\n149\t      try {\n150\t        db.exec(\"ROLLBACK;\");\n151\t      } catch {\n152\t        // handle closed mid-walk; the open transaction died with it\n153\t      }\n154\t    }\n155\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n156\t  } finally {\n157\t    try {\n158\t      db.close();\n159\t    } catch {\n160\t      // already closed by the induced-failure seam\n161\t    }\n162\t  }\n163\t}\n164\t\n165\tinterface RawEventRow {\n166\t  event_order: number | bigint;\n167\t  event_kind: string;\n168\t  idempotency_key: string;\n169\t  actor: string;\n170\t  harness: string;\n171\t  payload: string;\n172\t  recorded_at: string;\n173\t}\n174\t\n175\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n176\t  const refFailure = validateThreadRef(thread);\n177\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n178\t\n179\t  const resolved = await resolveThreadRef(thread);\n180\t  if (!resolved.ok) return resolved;\n181\t  const { filePath } = resolved.value;\n182\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n183\t\n184\t  let db: DatabaseSync | undefined;\n185\t  try {\n186\t    db = openDatabase(filePath);\n187\t    const rows = db\n188\t      .prepare(\n189\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n190\t         FROM event ORDER BY event_order`,\n191\t      )\n192\t      .all() as unknown as RawEventRow[];\n193\t    const records = rows.map(\n194\t      (row) =>\n195\t        ({\n196\t          eventKind: row.event_kind,\n197\t          idempotencyKey: row.idempotency_key,\n198\t          actor: row.actor,\n199\t          harness: row.harness,\n200\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n201\t          eventOrder: Number(row.event_order),\n202\t          recordedAt: row.recorded_at,\n203\t        }) as unknown as EventRecord,\n204\t    );\n205\t    return { ok: true, value: records };\n206\t  } catch (cause) {\n207\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n208\t  } finally {\n209\t    db?.close();\n210\t  }\n211\t}\n212\t"}]},"parent_tool_use_id":null,"session_id":"73841117-4412-4191-bf6e-d9dac3fc51d8","uuid":"b2b6885a-9559-4be3-8aea-908ae207a99b","timestamp":"2026-06-10T13:35:04.034Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n// Stories 3–5 extend the same per-event walk with projection, turn\n// transitions, and work queueing.\nimport { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport { openDatabase } from \"../../../shared/storage.js\";\nimport { resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\nimport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\nimport { validateEvents, validateThreadRef } from \"./validate.js\";\n\n// Test seam (set only through test/fixtures): called after each event is\n// processed inside the walk, so atomicity under mid-walk failure can be\n// induced through a real mechanism — closing the handle — rather than a\n// mocked transaction object.\nexport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\nlet walkHook: IntakeWalkHook | null = null;\nexport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n  walkHook = hook;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The skip set is read at transaction start and reads only the key column:\n// key-wins-over-content is the absence of a content comparison (AC-5.5).\n// Chunked to stay under SQLite's bound-parameter limit.\nfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n  const found = new Set<string>();\n  for (let offset = 0; offset < keys.length; offset += 400) {\n    const chunk = keys.slice(offset, offset + 400);\n    const placeholders = chunk.map(() => \"?\").join(\", \");\n    const rows = db\n      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    for (const row of rows) found.add(row.idempotency_key);\n  }\n  return found;\n}\n\nfunction maxEventOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0);\n}\n\nexport async function runMessageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n  clock: () => Date = () => new Date(),\n): Promise<OpResult<BatchResult>> {\n  // Pure validation first: a rejected batch never opens the file, never takes\n  // the write lock, and a duplicate key on a malformed event is a rejection,\n  // not a skip (validation-before-idempotency precedence).\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n  const batchFailure = validateEvents(events);\n  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  let db: DatabaseSync;\n  try {\n    db = openDatabase(filePath);\n  } catch (cause) {\n    return storageFailure(`could not open thread file: ${detail(cause)}`);\n  }\n\n  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n  // single-writer violations fail loudly at a defined point.\n  let inTransaction = false;\n  try {\n    db.exec(\"BEGIN IMMEDIATE;\");\n    inTransaction = true;\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    const eventResults: BatchResult[\"events\"] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          clock().toISOString(),\n        );\n        skipSet.add(event.idempotencyKey);\n        eventResults.push({ idempotencyKey: event.idempotencyKey, outcome: \"recorded\" });\n      }\n      walkHook?.(db, index);\n    }\n\n    db.exec(\"COMMIT;\");\n    inTransaction = false;\n\n    return {\n      ok: true,\n      value: {\n        events: eventResults,\n        turnTransitions: [], // populated by Story 4\n        queuedWork: [], // populated by Story 5\n        threadPosition: { lastEventOrder: lastOrder },\n      },\n    };\n  } catch (cause) {\n    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n    // class-independent. The handle may already be gone (induced failure),\n    // in which case SQLite has already discarded the uncommitted transaction.\n    if (inTransaction) {\n      try {\n        db.exec(\"ROLLBACK;\");\n      } catch {\n        // handle closed mid-walk; the open transaction died with it\n      }\n    }\n    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n  } finally {\n    try {\n      db.close();\n    } catch {\n      // already closed by the induced-failure seam\n    }\n  }\n}\n\ninterface RawEventRow {\n  event_order: number | bigint;\n  event_kind: string;\n  idempotency_key: string;\n  actor: string;\n  harness: string;\n  payload: string;\n  recorded_at: string;\n}\n\nexport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  let db: DatabaseSync | undefined;\n  try {\n    db = openDatabase(filePath);\n    const rows = db\n      .prepare(\n        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n         FROM event ORDER BY event_order`,\n      )\n      .all() as unknown as RawEventRow[];\n    const records = rows.map(\n      (row) =>\n        ({\n          eventKind: row.event_kind,\n          idempotencyKey: row.idempotency_key,\n          actor: row.actor,\n          harness: row.harness,\n          payload: JSON.parse(row.payload) as Record<string, unknown>,\n          eventOrder: Number(row.event_order),\n          recordedAt: row.recorded_at,\n        }) as unknown as EventRecord,\n    );\n    return { ok: true, value: records };\n  } catch (cause) {\n    return storageFailure(`event read-back failed: ${detail(cause)}`);\n  } finally {\n    db?.close();\n  }\n}\n","numLines":212,"startLine":1,"totalLines":212}}}

{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/idempotency.test.ts'","aggregated_output":"     1\t// Flow 5: idempotent resend (TC-5.1 through TC-5.5, asserted at the event\n     2\t// level — the no-message / no-transition / no-work-item clauses re-assert in\n     3\t// Stories 3-5 as those records exist).\n     4\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     5\timport { intakeStream, threads, type EventRecord } from \"../src/index.js\";\n     6\timport { conversationTurn, eventBatch, openRaw, tempStore, validEvent, type TempStore } from \"./fixtures/index.js\";\n     7\t\n     8\tlet store: TempStore;\n     9\tbeforeEach(() => {\n    10\t  store = tempStore();\n    11\t});\n    12\tafterEach(() => {\n    13\t  store.cleanup();\n    14\t});\n    15\t\n    16\tasync function createThread(): Promise<string> {\n    17\t  const filePath = store.threadPath();\n    18\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    19\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    20\t  return filePath;\n    21\t}\n    22\t\n    23\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n    24\t  const result = await intakeStream.listEvents({ filePath });\n    25\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n    26\t  return result.value;\n    27\t}\n    28\t\n    29\t// Serializes every row of every table for below-SDK absence assertions.\n    30\tfunction rawDump(filePath: string): string {\n    31\t  const db = openRaw(filePath);\n    32\t  try {\n    33\t    const tables = db\n    34\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table'\")\n    35\t      .all() as unknown as Array<{ name: string }>;\n    36\t    let dump = \"\";\n    37\t    for (const table of tables) {\n    38\t      dump += JSON.stringify(db.prepare(`SELECT * FROM \"${table.name}\"`).all());\n    39\t    }\n    40\t    return dump;\n    41\t  } finally {\n    42\t    db.close();\n    43\t  }\n    44\t}\n    45\t\n    46\tdescribe(\"Flow 5 (SDK): idempotent resend\", () => {\n    47\t  it(\"TC-5.1: resending a fully recorded batch skips everything and changes nothing\", async () => {\n    48\t    const filePath = await createThread();\n    49\t    const batch = conversationTurn();\n    50\t    const first = await intakeStream.messageEvents({ filePath }, batch);\n    51\t    expect(first.ok).toBe(true);\n    52\t    if (!first.ok) return;\n    53\t    expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    54\t    expect(first.value.threadPosition.lastEventOrder).toBe(5);\n    55\t    const baseline = await readBack(filePath);\n    56\t\n    57\t    const resend = await intakeStream.messageEvents({ filePath }, batch);\n    58\t    expect(resend.ok).toBe(true);\n    59\t    if (!resend.ok) return;\n    60\t    expect(resend.value.events).toHaveLength(5);\n    61\t    for (const [index, entry] of resend.value.events.entries()) {\n    62\t      expect(entry.outcome).toBe(\"skipped\");\n    63\t      expect(entry.skipReason).toBe(\"duplicate_idempotency_key\");\n    64\t      expect(entry.idempotencyKey).toBe(batch[index]!.idempotencyKey);\n    65\t    }\n    66\t    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n    67\t\n    68\t    expect(await readBack(filePath)).toEqual(baseline);\n    69\t  });\n    70\t\n    71\t  it(\"TC-5.2: partial resend skips the old, records the new, and keeps the order dense\", async () => {\n    72\t    const filePath = await createThread();\n    73\t    const old = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n    74\t    const first = await intakeStream.messageEvents({ filePath }, old);\n    75\t    expect(first.ok).toBe(true);\n    76\t\n    77\t    const fresh = [validEvent(\"tool_result\"), validEvent(\"turn_end\")];\n    78\t    const resend = await intakeStream.messageEvents({ filePath }, [...old, ...fresh]);\n    79\t    expect(resend.ok).toBe(true);\n    80\t    if (!resend.ok) return;\n    81\t    expect(resend.value.events.map((entry) => entry.outcome)).toEqual([\n    82\t      \"skipped\",\n    83\t      \"skipped\",\n    84\t      \"skipped\",\n    85\t      \"recorded\",\n    86\t      \"recorded\",\n    87\t    ]);\n    88\t    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n    89\t\n    90\t    const events = await readBack(filePath);\n    91\t    expect(events.map((event) => event.eventOrder)).toEqual([1, 2, 3, 4, 5]);\n    92\t    expect(events[3]!.idempotencyKey).toBe(fresh[0]!.idempotencyKey);\n    93\t    expect(events[4]!.idempotencyKey).toBe(fresh[1]!.idempotencyKey);\n    94\t  });\n    95\t\n    96\t  it(\"TC-5.3: idempotency keys are scoped to the thread — same key records in both threads\", async () => {\n    97\t    const threadA = await createThread();\n    98\t    const threadB = await createThread();\n    99\t    const event = validEvent(\"user_prompt\", { idempotencyKey: \"shared-key-1\" });\n   100\t\n   101\t    const inA = await intakeStream.messageEvents({ filePath: threadA }, [event]);\n   102\t    const inB = await intakeStream.messageEvents({ filePath: threadB }, [event]);\n   103\t    expect(inA.ok).toBe(true);\n   104\t    expect(inB.ok).toBe(true);\n   105\t    if (!inA.ok || !inB.ok) return;\n   106\t    expect(inA.value.events[0]!.outcome).toBe(\"recorded\");\n   107\t    expect(inB.value.events[0]!.outcome).toBe(\"recorded\");\n   108\t\n   109\t    expect((await readBack(threadA)).map((e) => e.idempotencyKey)).toEqual([\"shared-key-1\"]);\n   110\t    expect((await readBack(threadB)).map((e) => e.idempotencyKey)).toEqual([\"shared-key-1\"]);\n   111\t  });\n   112\t\n   113\t  it(\"TC-5.4: skips are inert — no duplicate rows, no order numbers consumed, no transitions reported\", async () => {\n   114\t    const filePath = await createThread();\n   115\t    const batch = eventBatch([\"user_prompt\", \"turn_end\"]);\n   116\t    const first = await intakeStream.messageEvents({ filePath }, batch);\n   117\t    expect(first.ok).toBe(true);\n   118\t\n   119\t    const resend = await intakeStream.messageEvents({ filePath }, batch);\n   120\t    expect(resend.ok).toBe(true);\n   121\t    if (!resend.ok) return;\n   122\t    expect(resend.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   123\t    expect(resend.value.turnTransitions).toEqual([]);\n   124\t    expect(resend.value.queuedWork).toEqual([]);\n   125\t\n   126\t    // No duplicate event rows: each key appears exactly once below the SDK.\n   127\t    const db = openRaw(filePath);\n   128\t    try {\n   129\t      const counts = db\n   130\t        .prepare(\"SELECT idempotency_key, COUNT(*) AS n FROM event GROUP BY idempotency_key\")\n   131\t        .all() as unknown as Array<{ idempotency_key: string; n: number | bigint }>;\n   132\t      expect(counts).toHaveLength(2);\n   133\t      for (const row of counts) expect(Number(row.n)).toBe(1);\n   134\t    } finally {\n   135\t      db.close();\n   136\t    }\n   137\t\n   138\t    // Skips consumed no order numbers: the next recorded event lands at 3.\n   139\t    const next = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   140\t    expect(next.ok).toBe(true);\n   141\t    if (!next.ok) return;\n   142\t    expect(next.value.threadPosition.lastEventOrder).toBe(3);\n   143\t    expect((await readBack(filePath)).map((e) => e.eventOrder)).toEqual([1, 2, 3]);\n   144\t  });\n   145\t\n   146\t  it(\"TC-5.5: key wins over content — original payload intact, resent payload stored nowhere\", async () => {\n   147\t    const filePath = await createThread();\n   148\t    const original = validEvent(\"user_prompt\", {\n   149\t      idempotencyKey: \"key-K\",\n   150\t      payload: { text: \"PAYLOAD-A-ORIGINAL\" },\n   151\t    });\n   152\t    const first = await intakeStream.messageEvents({ filePath }, [original]);\n   153\t    expect(first.ok).toBe(true);\n   154\t\n   155\t    const reused = validEvent(\"user_prompt\", {\n   156\t      idempotencyKey: \"key-K\",\n   157\t      payload: { text: \"PAYLOAD-B-MUST-VANISH\" },\n   158\t    });\n   159\t    const resend = await intakeStream.messageEvents({ filePath }, [reused]);\n   160\t    expect(resend.ok).toBe(true);\n   161\t    if (!resend.ok) return;\n   162\t    expect(resend.value.events[0]).toEqual({\n   163\t      idempotencyKey: \"key-K\",\n   164\t      outcome: \"skipped\",\n   165\t      skipReason: \"duplicate_idempotency_key\",\n   166\t    });\n   167\t\n   168\t    const events = await readBack(filePath);\n   169\t    expect(events).toHaveLength(1);\n   170\t    expect(events[0]!.payload).toEqual({ text: \"PAYLOAD-A-ORIGINAL\" });\n   171\t\n   172\t    // openRaw scan: payload B appears in no table at all.\n   173\t    const dump = rawDump(filePath);\n   174\t    expect(dump).toContain(\"PAYLOAD-A-ORIGINAL\");\n   175\t    expect(dump).not.toContain(\"PAYLOAD-B-MUST-VANISH\");\n   176\t  });\n   177\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/intake.test.ts'","aggregated_output":"     1\t// Flow 2 (recording half): TC-2.1, TC-2.8, TC-1.4 (closing Story 1's\n     2\t// deferral), the four architecture-risk tests (mid-walk rollback, restart\n     3\t// survival, no-lock-on-rejection, system_error rollback parity), and the CLI\n     4\t// in-process stdin legs.\n     5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     6\timport {\n     7\t  intakeStream,\n     8\t  runCli,\n     9\t  threads,\n    10\t  type EventRecord,\n    11\t  type MessageEventInput,\n    12\t} from \"../src/index.js\";\n    13\timport {\n    14\t  conversationTurn,\n    15\t  eventBatch,\n    16\t  openRaw,\n    17\t  setIntakeWalkHook,\n    18\t  tempStore,\n    19\t  validEvent,\n    20\t  type TempStore,\n    21\t} from \"./fixtures/index.js\";\n    22\t\n    23\tlet store: TempStore;\n    24\tbeforeEach(() => {\n    25\t  store = tempStore();\n    26\t});\n    27\tafterEach(() => {\n    28\t  setIntakeWalkHook(null);\n    29\t  store.cleanup();\n    30\t});\n    31\t\n    32\tasync function createThread(): Promise<string> {\n    33\t  const filePath = store.threadPath();\n    34\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    35\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    36\t  return filePath;\n    37\t}\n    38\t\n    39\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n    40\t  const result = await intakeStream.listEvents({ filePath });\n    41\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n    42\t  return result.value;\n    43\t}\n    44\t\n    45\tdescribe(\"Flow 2 (SDK): event recording\", () => {\n    46\t  it(\"TC-2.1: two batches record in array order with a dense, continuing event order\", async () => {\n    47\t    const filePath = await createThread();\n    48\t    const batchOne = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n    49\t    const batchTwo = eventBatch([\"tool_result\", \"runtime_note\", \"turn_end\"]);\n    50\t\n    51\t    const first = await intakeStream.messageEvents({ filePath }, batchOne);\n    52\t    expect(first.ok).toBe(true);\n    53\t    if (!first.ok) return;\n    54\t    expect(first.value.events.map((e) => e.outcome)).toEqual([\n    55\t      \"recorded\",\n    56\t      \"recorded\",\n    57\t      \"recorded\",\n    58\t    ]);\n    59\t    expect(first.value.threadPosition.lastEventOrder).toBe(3);\n    60\t\n    61\t    const second = await intakeStream.messageEvents({ filePath }, batchTwo);\n    62\t    expect(second.ok).toBe(true);\n    63\t    if (!second.ok) return;\n    64\t    expect(second.value.threadPosition.lastEventOrder).toBe(6);\n    65\t\n    66\t    const events = await readBack(filePath);\n    67\t    expect(events.map((e) => e.eventOrder)).toEqual([1, 2, 3, 4, 5, 6]);\n    68\t    expect(events.map((e) => e.eventKind)).toEqual([\n    69\t      \"user_prompt\",\n    70\t      \"assistant_text\",\n    71\t      \"tool_call\",\n    72\t      \"tool_result\",\n    73\t      \"runtime_note\",\n    74\t      \"turn_end\",\n    75\t    ]);\n    76\t    expect(events.map((e) => e.idempotencyKey)).toEqual(\n    77\t      [...batchOne, ...batchTwo].map((e) => e.idempotencyKey),\n    78\t    );\n    79\t  });\n    80\t\n    81\t  it(\"TC-2.8: an empty batch is a caller error and records nothing\", async () => {\n    82\t    const filePath = await createThread();\n    83\t    const result = await intakeStream.messageEvents({ filePath }, []);\n    84\t    expect(result.ok).toBe(false);\n    85\t    if (result.ok) return;\n    86\t    expect(result.error.errorClass).toBe(\"caller_error\");\n    87\t    expect(result.error.code).toBe(\"empty_batch\");\n    88\t    expect(result.error.reason).toContain(\"empty\");\n    89\t\n    90\t    expect(await readBack(filePath)).toEqual([]);\n    91\t  });\n    92\t\n    93\t  it(\"TC-1.4: the same batch by thread id and by file path produces identical results and read-back (closes Story 1's deferral)\", async () => {\n    94\t    const pathA = store.threadPath();\n    95\t    const createdA = await threads.newThread({\n    96\t      filePath: pathA,\n    97\t      registryPath: store.registryPath,\n    98\t    });\n    99\t    expect(createdA.ok).toBe(true);\n   100\t    if (!createdA.ok) return;\n   101\t    const pathB = await createThread();\n   102\t\n   103\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\", \"turn_end\"]);\n   104\t    const byId = await intakeStream.messageEvents(\n   105\t      { threadId: createdA.value.threadId, registryPath: store.registryPath },\n   106\t      batch,\n   107\t    );\n   108\t    const byPath = await intakeStream.messageEvents({ filePath: pathB }, batch);\n   109\t    expect(byId.ok).toBe(true);\n   110\t    expect(byPath.ok).toBe(true);\n   111\t    if (!byId.ok || !byPath.ok) return;\n   112\t    expect(byId.value).toEqual(byPath.value);\n   113\t\n   114\t    // Read-back equivalence through both reference forms, modulo recordedAt\n   115\t    // (wall-clock; everything contractual must match exactly).\n   116\t    const readById = await intakeStream.listEvents({\n   117\t      threadId: createdA.value.threadId,\n   118\t      registryPath: store.registryPath,\n   119\t    });\n   120\t    expect(readById.ok).toBe(true);\n   121\t    if (!readById.ok) return;\n   122\t    const readByPath = await readBack(pathB);\n   123\t    const strip = (events: EventRecord[]) =>\n   124\t      events.map(({ recordedAt, ...rest }) => {\n   125\t        expect(new Date(recordedAt).toISOString()).toBe(recordedAt);\n   126\t        return rest;\n   127\t      });\n   128\t    expect(strip(readById.value)).toEqual(strip(readByPath));\n   129\t  });\n   130\t\n   131\t  it(\"architecture-risk: mid-walk failure rolls the whole batch back to baseline\", async () => {\n   132\t    const filePath = await createThread();\n   133\t    const baselineBatch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n   134\t    const recorded = await intakeStream.messageEvents({ filePath }, baselineBatch);\n   135\t    expect(recorded.ok).toBe(true);\n   136\t    const baseline = await readBack(filePath);\n   137\t    expect(baseline).toHaveLength(2);\n   138\t\n   139\t    // Real mechanism: the seam closes the handle inside the transaction after\n   140\t    // the first event of the new batch has been recorded.\n   141\t    setIntakeWalkHook((db, eventIndex) => {\n   142\t      if (eventIndex === 0) db.close();\n   143\t    });\n   144\t    const result = await intakeStream.messageEvents(\n   145\t      { filePath },\n   146\t      eventBatch([\"tool_call\", \"tool_result\", \"turn_end\"]),\n   147\t    );\n   148\t    setIntakeWalkHook(null);\n   149\t    expect(result.ok).toBe(false);\n   150\t    if (result.ok) return;\n   151\t    expect(result.error.errorClass).toBe(\"system_error\");\n   152\t    expect(result.error.code).toBe(\"storage_failure\");\n   153\t\n   154\t    // Post-reopen read-back: not the operation's own claim about itself.\n   155\t    expect(await readBack(filePath)).toEqual(baseline);\n   156\t  });\n   157\t\n   158\t  it(\"architecture-risk: system_error rollback parity — storage failure mid-batch leaves no partial events\", async () => {\n   159\t    const filePath = await createThread();\n   160\t    setIntakeWalkHook((db, eventIndex) => {\n   161\t      if (eventIndex === 1) db.close();\n   162\t    });\n   163\t    const result = await intakeStream.messageEvents({ filePath }, conversationTurn());\n   164\t    setIntakeWalkHook(null);\n   165\t    expect(result.ok).toBe(false);\n   166\t    if (result.ok) return;\n   167\t    expect(result.error.errorClass).toBe(\"system_error\");\n   168\t    expect(result.error.code).toBe(\"storage_failure\");\n   169\t\n   170\t    // AC-4.6 is class-independent: the first two walked events are gone too.\n   171\t    expect(await readBack(filePath)).toEqual([]);\n   172\t    const db = openRaw(filePath);\n   173\t    try {\n   174\t      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n   175\t        n: number | bigint;\n   176\t      };\n   177\t      expect(Number(row.n)).toBe(0);\n   178\t    } finally {\n   179\t      db.close();\n   180\t    }\n   181\t  });\n   182\t\n   183\t  it(\"architecture-risk: restart survival — reopen sees the identical record\", async () => {\n   184\t    const filePath = await createThread();\n   185\t    const batch = conversationTurn();\n   186\t    const recorded = await intakeStream.messageEvents({ filePath }, batch);\n   187\t    expect(recorded.ok).toBe(true);\n   188\t\n   189\t    // Every SDK operation opens and closes its own handle, so each read-back\n   190\t    // below is a fresh open of the file the write durably left behind.\n   191\t    const firstRead = await readBack(filePath);\n   192\t    expect(firstRead).toHaveLength(5);\n   193\t    const secondRead = await readBack(filePath);\n   194\t    expect(secondRead).toEqual(firstRead);\n   195\t\n   196\t    const db = openRaw(filePath);\n   197\t    try {\n   198\t      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n   199\t        n: number | bigint;\n   200\t      };\n   201\t      expect(Number(row.n)).toBe(5);\n   202\t    } finally {\n   203\t      db.close();\n   204\t    }\n   205\t  });\n   206\t\n   207\t  it(\"architecture-risk: a rejected batch takes no lock — rejection succeeds while another connection holds the write lock\", async () => {\n   208\t    const filePath = await createThread();\n   209\t    const locker = openRaw(filePath);\n   210\t    try {\n   211\t      locker.exec(\"BEGIN IMMEDIATE;\");\n   212\t      // If rejection touched the transaction path it would block on the held\n   213\t      // lock and surface SQLITE_BUSY as storage_failure; pure validation\n   214\t      // returns the caller error immediately instead.\n   215\t      const result = await intakeStream.messageEvents({ filePath }, [\n   216\t        { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n   217\t      ]);\n   218\t      expect(result.ok).toBe(false);\n   219\t      if (!result.ok) {\n   220\t        expect(result.error.errorClass).toBe(\"caller_error\");\n   221\t        expect(result.error.code).toBe(\"invalid_event\");\n   222\t      }\n   223\t      locker.exec(\"ROLLBACK;\");\n   224\t    } finally {\n   225\t      locker.close();\n   226\t    }\n   227\t    expect(await readBack(filePath)).toEqual([]);\n   228\t  });\n   229\t});\n   230\t\n   231\tdescribe(\"Flow 2 (CLI in-process): message-events stdin handling\", () => {\n   232\t  it(\"records a batch from stdin and reads it back through list-events\", async () => {\n   233\t    const filePath = await createThread();\n   234\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n   235\t    const recorded = await runCli(\n   236\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n   237\t      async () => JSON.stringify(batch),\n   238\t    );\n   239\t    expect(recorded.exitCode).toBe(0);\n   240\t    const recordedParsed = JSON.parse(recorded.stdout) as {\n   241\t      ok: boolean;\n   242\t      value: { events: Array<{ outcome: string }>; threadPosition: { lastEventOrder: number } };\n   243\t    };\n   244\t    expect(recordedParsed.ok).toBe(true);\n   245\t    expect(recordedParsed.value.events.map((e) => e.outcome)).toEqual([\n   246\t      \"recorded\",\n   247\t      \"recorded\",\n   248\t    ]);\n   249\t    expect(recordedParsed.value.threadPosition.lastEventOrder).toBe(2);\n   250\t\n   251\t    const listed = await runCli([\"intake-stream\", \"list-events\", \"--file-path\", filePath]);\n   252\t    expect(listed.exitCode).toBe(0);\n   253\t    const listedParsed = JSON.parse(listed.stdout) as {\n   254\t      ok: boolean;\n   255\t      value: Array<{ eventOrder: number; eventKind: string }>;\n   256\t    };\n   257\t    expect(listedParsed.ok).toBe(true);\n   258\t    expect(listedParsed.value.map((e) => e.eventOrder)).toEqual([1, 2]);\n   259\t  });\n   260\t\n   261\t  it(\"a TTY stdin is refused with empty_stdin before any SDK call\", async () => {\n   262\t    const filePath = await createThread();\n   263\t    const result = await runCli(\n   264\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n   265\t      async () => null,\n   266\t    );\n   267\t    expect(result.exitCode).toBe(1);\n   268\t    const parsed = JSON.parse(result.stdout) as {\n   269\t      ok: boolean;\n   270\t      error: { errorClass: string; code: string };\n   271\t    };\n   272\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n   273\t    expect(parsed.error.code).toBe(\"empty_stdin\");\n   274\t    expect(await readBack(filePath)).toEqual([]);\n   275\t  });\n   276\t\n   277\t  it(\"empty stdin is refused with empty_stdin; a JSON [] reaches the SDK as empty_batch — distinct codes\", async () => {\n   278\t    const filePath = await createThread();\n   279\t\n   280\t    const empty = await runCli(\n   281\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n   282\t      async () => \"\",\n   283\t    );\n   284\t    expect(empty.exitCode).toBe(1);\n   285\t    const emptyParsed = JSON.parse(empty.stdout) as { error: { code: string } };\n   286\t    expect(emptyParsed.error.code).toBe(\"empty_stdin\");\n   287\t\n   288\t    const emptyArray = await runCli(\n   289\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n   290\t      async () => \"[]\",\n   291\t    );\n   292\t    expect(emptyArray.exitCode).toBe(1);\n   293\t    const emptyArrayParsed = JSON.parse(emptyArray.stdout) as { error: { code: string } };\n   294\t    expect(emptyArrayParsed.error.code).toBe(\"empty_batch\");\n   295\t  });\n   296\t\n   297\t  it(\"malformed stdin JSON and a missing thread flag are caller errors\", async () => {\n   298\t    const filePath = await createThread();\n   299\t    const malformed = await runCli(\n   300\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n   301\t      async () => \"{not json\",\n   302\t    );\n   303\t    expect(malformed.exitCode).toBe(1);\n   304\t    const malformedParsed = JSON.parse(malformed.stdout) as {\n   305\t      error: { errorClass: string; code: string };\n   306\t    };\n   307\t    expect(malformedParsed.error.errorClass).toBe(\"caller_error\");\n   308\t    expect(malformedParsed.error.code).toBe(\"invalid_event\");\n   309\t\n   310\t    const missingFlag = await runCli(\n   311\t      [\"intake-stream\", \"message-events\"],\n   312\t      async () => \"[]\",\n   313\t    );\n   314\t    expect(missingFlag.exitCode).toBe(1);\n   315\t    const missingParsed = JSON.parse(missingFlag.stdout) as { error: { code: string } };\n   316\t    expect(missingParsed.error.code).toBe(\"missing_flag\");\n   317\t  });\n   318\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/validation.test.ts'","aggregated_output":"     1\t// Flow 4: batch validation and rejection (TC-4.1, 4.2, 4.3, 4.5, the\n     2\t// caller_error + system_error legs of TC-4.4, plus the unknown-field\n     3\t// strictness and empty actor/harness supplementals). TC-4.4's corruption leg\n     4\t// lands with Story 4's fixture.\n     5\timport { writeFileSync } from \"node:fs\";\n     6\timport { join } from \"node:path\";\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  intakeStream,\n    10\t  runCli,\n    11\t  threads,\n    12\t  type EventRecord,\n    13\t  type MessageEventInput,\n    14\t  type ThreadRef,\n    15\t} from \"../src/index.js\";\n    16\timport { conversationTurn, eventBatch, tempStore, validEvent, type TempStore } from \"./fixtures/index.js\";\n    17\t\n    18\tlet store: TempStore;\n    19\tbeforeEach(() => {\n    20\t  store = tempStore();\n    21\t});\n    22\tafterEach(() => {\n    23\t  store.cleanup();\n    24\t});\n    25\t\n    26\tasync function createThread(): Promise<string> {\n    27\t  const filePath = store.threadPath();\n    28\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    29\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    30\t  return filePath;\n    31\t}\n    32\t\n    33\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n    34\t  const result = await intakeStream.listEvents({ filePath });\n    35\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n    36\t  return result.value;\n    37\t}\n    38\t\n    39\tdescribe(\"Flow 4 (SDK): batch validation and rejection\", () => {\n    40\t  it(\"TC-4.1: four invalidity categories, each rejected whole with a named reason\", async () => {\n    41\t    const filePath = await createThread();\n    42\t\n    43\t    const unknownKind = {\n    44\t      ...validEvent(\"user_prompt\"),\n    45\t      eventKind: \"mystery_kind\",\n    46\t    } as unknown as MessageEventInput;\n    47\t\n    48\t    const { idempotencyKey: _dropped, ...withoutKey } = validEvent(\"user_prompt\");\n    49\t    const missingKey = withoutKey as unknown as MessageEventInput;\n    50\t\n    51\t    const serverField = {\n    52\t      ...validEvent(\"user_prompt\"),\n    53\t      eventOrder: 7,\n    54\t    } as unknown as MessageEventInput;\n    55\t\n    56\t    const turnEndWithPayload = {\n    57\t      ...validEvent(\"turn_end\"),\n    58\t      payload: { text: \"should not be here\" },\n    59\t    } as unknown as MessageEventInput;\n    60\t\n    61\t    const cases: Array<{ batch: MessageEventInput[]; reason: RegExp }> = [\n    62\t      { batch: [unknownKind], reason: /unknown event kind/ },\n    63\t      { batch: [missingKey], reason: /idempotencyKey/ },\n    64\t      { batch: [serverField], reason: /server-generated.*eventOrder/ },\n    65\t      { batch: [turnEndWithPayload], reason: /turn_end/ },\n    66\t    ];\n    67\t\n    68\t    for (const { batch, reason } of cases) {\n    69\t      const result = await intakeStream.messageEvents({ filePath }, batch);\n    70\t      expect(result.ok).toBe(false);\n    71\t      if (result.ok) continue;\n    72\t      expect(result.error.errorClass).toBe(\"caller_error\");\n    73\t      expect(result.error.code).toBe(\"invalid_event\");\n    74\t      expect(result.error.eventIndex).toBe(0);\n    75\t      expect(result.error.reason).toMatch(reason);\n    76\t    }\n    77\t\n    78\t    expect(await readBack(filePath)).toEqual([]);\n    79\t  });\n    80\t\n    81\t  it(\"TC-4.2: first failure names index 2; the valid earlier events did not land\", async () => {\n    82\t    const filePath = await createThread();\n    83\t    const batch = [\n    84\t      validEvent(\"user_prompt\"),\n    85\t      validEvent(\"assistant_text\"),\n    86\t      validEvent(\"assistant_thinking\", { actor: \"\" }),\n    87\t    ];\n    88\t\n    89\t    const result = await intakeStream.messageEvents({ filePath }, batch);\n    90\t    expect(result.ok).toBe(false);\n    91\t    if (result.ok) return;\n    92\t    expect(result.error.code).toBe(\"invalid_event\");\n    93\t    expect(result.error.eventIndex).toBe(2);\n    94\t\n    95\t    expect(await readBack(filePath)).toEqual([]);\n    96\t  });\n    97\t\n    98\t  it(\"TC-4.3: after a rejection the thread reads back logically identical to its baseline\", async () => {\n    99\t    const filePath = await createThread();\n   100\t    const recorded = await intakeStream.messageEvents({ filePath }, conversationTurn());\n   101\t    expect(recorded.ok).toBe(true);\n   102\t    const baseline = await readBack(filePath);\n   103\t    expect(baseline).toHaveLength(5);\n   104\t\n   105\t    const rejected = await intakeStream.messageEvents({ filePath }, [\n   106\t      validEvent(\"user_prompt\"),\n   107\t      { ...validEvent(\"turn_end\"), payload: { oops: 1 } } as unknown as MessageEventInput,\n   108\t    ]);\n   109\t    expect(rejected.ok).toBe(false);\n   110\t\n   111\t    // Logical equality at the read-back level (events at this story; the\n   112\t    // rollback ladder extends to messages/turns/work in Stories 3-5).\n   113\t    expect(await readBack(filePath)).toEqual(baseline);\n   114\t  });\n   115\t\n   116\t  it(\"TC-4.4 (caller/system legs): error classes separate; corruption leg is Story 4's\", async () => {\n   117\t    const filePath = await createThread();\n   118\t\n   119\t    const callerLeg = await intakeStream.messageEvents({ filePath }, [\n   120\t      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n   121\t    ]);\n   122\t    expect(callerLeg.ok).toBe(false);\n   123\t    if (callerLeg.ok) return;\n   124\t    expect(callerLeg.error.errorClass).toBe(\"caller_error\");\n   125\t    expect(callerLeg.error.code).toBe(\"invalid_event\");\n   126\t\n   127\t    const blocker = join(store.dir, \"blocker-file\");\n   128\t    writeFileSync(blocker, \"regular file standing where a directory must be\");\n   129\t    const systemLeg = await threads.newThread({\n   130\t      filePath: store.threadPath(),\n   131\t      registryPath: join(blocker, \"registry.sqlite\"),\n   132\t    });\n   133\t    expect(systemLeg.ok).toBe(false);\n   134\t    if (systemLeg.ok) return;\n   135\t    expect(systemLeg.error.errorClass).toBe(\"system_error\");\n   136\t    expect(systemLeg.error.code).toBe(\"storage_failure\");\n   137\t\n   138\t    expect(callerLeg.error.errorClass).not.toBe(systemLeg.error.errorClass);\n   139\t\n   140\t    // Same shapes through the CLI adapter (in-process).\n   141\t    const cliCaller = await runCli(\n   142\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n   143\t      async () => JSON.stringify([{ ...validEvent(\"user_prompt\"), eventKind: \"bogus\" }]),\n   144\t    );\n   145\t    expect(cliCaller.exitCode).toBe(1);\n   146\t    const cliCallerParsed = JSON.parse(cliCaller.stdout) as {\n   147\t      ok: boolean;\n   148\t      error: { errorClass: string; code: string };\n   149\t    };\n   150\t    expect(cliCallerParsed.error.errorClass).toBe(\"caller_error\");\n   151\t    expect(cliCallerParsed.error.code).toBe(\"invalid_event\");\n   152\t\n   153\t    const cliSystem = await runCli([\n   154\t      \"threads\",\n   155\t      \"new-thread\",\n   156\t      \"--file-path\",\n   157\t      store.threadPath(),\n   158\t      \"--registry\",\n   159\t      join(blocker, \"registry.sqlite\"),\n   160\t    ]);\n   161\t    expect(cliSystem.exitCode).toBe(1);\n   162\t    const cliSystemParsed = JSON.parse(cliSystem.stdout) as {\n   163\t      ok: boolean;\n   164\t      error: { errorClass: string; code: string };\n   165\t    };\n   166\t    expect(cliSystemParsed.error.errorClass).toBe(\"system_error\");\n   167\t    expect(cliSystemParsed.error.code).toBe(\"storage_failure\");\n   168\t  });\n   169\t\n   170\t  it(\"TC-4.5: a batch mixing new, duplicate, and invalid events is rejected whole\", async () => {\n   171\t    const filePath = await createThread();\n   172\t    const original = eventBatch([\"user_prompt\", \"assistant_text\"]);\n   173\t    const recorded = await intakeStream.messageEvents({ filePath }, original);\n   174\t    expect(recorded.ok).toBe(true);\n   175\t    const baseline = await readBack(filePath);\n   176\t    expect(baseline).toHaveLength(2);\n   177\t\n   178\t    const mixed = [\n   179\t      validEvent(\"tool_call\"),\n   180\t      original[0]!, // valid duplicate of a recorded event\n   181\t      { ...validEvent(\"turn_end\"), payload: { bad: true } } as unknown as MessageEventInput,\n   182\t    ];\n   183\t    const rejected = await intakeStream.messageEvents({ filePath }, mixed);\n   184\t    expect(rejected.ok).toBe(false);\n   185\t    if (rejected.ok) return;\n   186\t    expect(rejected.error.code).toBe(\"invalid_event\");\n   187\t    expect(rejected.error.eventIndex).toBe(2);\n   188\t\n   189\t    // Duplicates' original records unchanged; the new events absent.\n   190\t    expect(await readBack(filePath)).toEqual(baseline);\n   191\t  });\n   192\t\n   193\t  it(\"strictness supplemental: unknown fields rejected at envelope, event, and payload levels\", async () => {\n   194\t    const filePath = await createThread();\n   195\t\n   196\t    const envelopeProbe = await intakeStream.messageEvents(\n   197\t      { filePath, surprise: true } as unknown as ThreadRef,\n   198\t      [validEvent(\"user_prompt\")],\n   199\t    );\n   200\t    expect(envelopeProbe.ok).toBe(false);\n   201\t    if (envelopeProbe.ok) return;\n   202\t    expect(envelopeProbe.error.code).toBe(\"invalid_event\");\n   203\t    expect(envelopeProbe.error.reason).toContain(\"envelope\");\n   204\t\n   205\t    const eventProbe = await intakeStream.messageEvents({ filePath }, [\n   206\t      { ...validEvent(\"user_prompt\"), surprise: true } as unknown as MessageEventInput,\n   207\t    ]);\n   208\t    expect(eventProbe.ok).toBe(false);\n   209\t    if (eventProbe.ok) return;\n   210\t    expect(eventProbe.error.code).toBe(\"invalid_event\");\n   211\t    expect(eventProbe.error.reason).toContain(\"event\");\n   212\t    expect(eventProbe.error.reason).toContain(\"surprise\");\n   213\t\n   214\t    const payloadProbe = await intakeStream.messageEvents({ filePath }, [\n   215\t      {\n   216\t        ...validEvent(\"user_prompt\"),\n   217\t        payload: { text: \"hello\", surprise: true },\n   218\t      } as unknown as MessageEventInput,\n   219\t    ]);\n   220\t    expect(payloadProbe.ok).toBe(false);\n   221\t    if (payloadProbe.ok) return;\n   222\t    expect(payloadProbe.error.code).toBe(\"invalid_event\");\n   223\t    expect(payloadProbe.error.reason).toContain(\"payload\");\n   224\t    expect(payloadProbe.error.reason).toContain(\"surprise\");\n   225\t\n   226\t    expect(await readBack(filePath)).toEqual([]);\n   227\t  });\n   228\t\n   229\t  it(\"strictness supplemental: empty actor and empty harness are rejected\", async () => {\n   230\t    const filePath = await createThread();\n   231\t\n   232\t    const emptyActor = await intakeStream.messageEvents({ filePath }, [\n   233\t      validEvent(\"user_prompt\", { actor: \"\" }),\n   234\t    ]);\n   235\t    expect(emptyActor.ok).toBe(false);\n   236\t    if (emptyActor.ok) return;\n   237\t    expect(emptyActor.error.code).toBe(\"invalid_event\");\n   238\t    expect(emptyActor.error.reason).toContain(\"actor\");\n   239\t\n   240\t    const emptyHarness = await intakeStream.messageEvents({ filePath }, [\n   241\t      validEvent(\"user_prompt\", { harness: \"\" }),\n   242\t    ]);\n   243\t    expect(emptyHarness.ok).toBe(false);\n   244\t    if (emptyHarness.ok) return;\n   245\t    expect(emptyHarness.error.code).toBe(\"invalid_event\");\n   246\t    expect(emptyHarness.error.reason).toContain(\"harness\");\n   247\t\n   248\t    expect(await readBack(filePath)).toEqual([]);\n   249\t  });\n   250\t});\n","exit_code":0,"status":"completed"}}

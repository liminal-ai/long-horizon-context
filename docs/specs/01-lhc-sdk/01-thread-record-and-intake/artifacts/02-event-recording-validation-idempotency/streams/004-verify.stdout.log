{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/intake-stream/internal/validate.ts'","aggregated_output":"     1\t// Flow 4: pure, whole-batch, three-layer closed validation. Strictness falls\n     2\t// out of schema construction: every layer is a closed Effect Schema struct\n     3\t// decoded under onExcessProperty: \"error\", so unknown-field rejection is a\n     4\t// property of the definitions, not a remembered rule. Validation never touches\n     5\t// a database; a rejected batch costs no write lock.\n     6\timport { Either, ParseResult, Schema } from \"effect\";\n     7\timport type { ErrorResult } from \"../../../shared/errors.js\";\n     8\t\n     9\texport const EVENT_KINDS = [\n    10\t  \"user_prompt\",\n    11\t  \"assistant_text\",\n    12\t  \"assistant_thinking\",\n    13\t  \"runtime_note\",\n    14\t  \"tool_call\",\n    15\t  \"tool_result\",\n    16\t  \"turn_end\",\n    17\t] as const;\n    18\t\n    19\t// Denied by name with their own reason string: the old MVP's\n    20\t// silent-root-field-drop bug class gets named when it appears.\n    21\tconst SERVER_GENERATED_FIELDS = [\n    22\t  \"eventOrder\",\n    23\t  \"recordedAt\",\n    24\t  \"threadEventId\",\n    25\t  \"schemaVersion\",\n    26\t] as const;\n    27\t\n    28\tconst DECODE_OPTIONS = { onExcessProperty: \"error\", errors: \"first\" } as const;\n    29\t\n    30\tconst NonEmptyString = Schema.String.pipe(Schema.minLength(1));\n    31\t\n    32\t// Layer 1 — envelope: thread reference shape, closed.\n    33\tconst ThreadRefSchema = Schema.Union(\n    34\t  Schema.Struct({\n    35\t    threadId: NonEmptyString,\n    36\t    registryPath: Schema.optional(Schema.String),\n    37\t  }),\n    38\t  Schema.Struct({ filePath: NonEmptyString }),\n    39\t);\n    40\t\n    41\t// Layer 2 — event object: the five required fields, closed. payload presence\n    42\t// and shape are layer 3's job (Schema.Unknown keeps the key from reading as\n    43\t// an unexpected field here, and tolerates a missing key — presence is checked\n    44\t// explicitly below).\n    45\tconst EventEnvelopeSchema = Schema.Struct({\n    46\t  eventKind: Schema.Literal(...EVENT_KINDS),\n    47\t  idempotencyKey: NonEmptyString,\n    48\t  actor: NonEmptyString,\n    49\t  harness: NonEmptyString,\n    50\t  payload: Schema.Unknown,\n    51\t});\n    52\t\n    53\t// Layer 3 — per-kind payload, closed. turn_end's empty-payload rule is its\n    54\t// own named check below (a closed Struct({}) admits any object).\n    55\tconst TextPayloadSchema = Schema.Struct({ text: Schema.String });\n    56\tconst ToolCallPayloadSchema = Schema.Struct({\n    57\t  toolCallId: NonEmptyString,\n    58\t  toolName: NonEmptyString,\n    59\t  arguments: Schema.Record({ key: Schema.String, value: Schema.Unknown }),\n    60\t});\n    61\tconst ToolResultPayloadSchema = Schema.Struct({\n    62\t  toolCallId: NonEmptyString,\n    63\t  content: Schema.String,\n    64\t  isError: Schema.optional(Schema.Boolean),\n    65\t});\n    66\t\n    67\tfunction firstIssue(error: ParseResult.ParseError): string {\n    68\t  const issues = ParseResult.ArrayFormatter.formatErrorSync(error);\n    69\t  const issue = issues[0];\n    70\t  if (issue === undefined) return \"invalid value\";\n    71\t  if (issue.path.length === 0) return issue.message;\n    72\t  return `\"${issue.path.join(\".\")}\" ${issue.message}`;\n    73\t}\n    74\t\n    75\tfunction decodeIssue<A, I>(schema: Schema.Schema<A, I, never>, value: unknown): string | undefined {\n    76\t  const decoded = Schema.decodeUnknownEither(schema, DECODE_OPTIONS)(value);\n    77\t  return Either.isLeft(decoded) ? firstIssue(decoded.left) : undefined;\n    78\t}\n    79\t\n    80\tfunction callerError(reason: string, eventIndex?: number): ErrorResult {\n    81\t  const error: ErrorResult = {\n    82\t    errorClass: \"caller_error\",\n    83\t    code: \"invalid_event\",\n    84\t    reason,\n    85\t  };\n    86\t  if (eventIndex !== undefined) error.eventIndex = eventIndex;\n    87\t  return error;\n    88\t}\n    89\t\n    90\t// Envelope-level: the thread reference must decode against the closed union.\n    91\t// Returns undefined when valid.\n    92\texport function validateThreadRef(ref: unknown): ErrorResult | undefined {\n    93\t  const issue = decodeIssue(ThreadRefSchema, ref);\n    94\t  if (issue !== undefined) {\n    95\t    return callerError(`envelope: invalid thread reference — ${issue}`);\n    96\t  }\n    97\t  return undefined;\n    98\t}\n    99\t\n   100\t// Whole-batch validation: array order, first failure wins (AC-4.5). Returns\n   101\t// undefined when every event is valid.\n   102\texport function validateEvents(events: unknown): ErrorResult | undefined {\n   103\t  if (!Array.isArray(events)) {\n   104\t    return callerError(\"envelope: events must be a JSON array\");\n   105\t  }\n   106\t  if (events.length === 0) {\n   107\t    return {\n   108\t      errorClass: \"caller_error\",\n   109\t      code: \"empty_batch\",\n   110\t      reason: \"envelope: events array is empty; a batch must carry at least one event\",\n   111\t    };\n   112\t  }\n   113\t  for (const [index, event] of events.entries()) {\n   114\t    const failure = validateOneEvent(event, index);\n   115\t    if (failure !== undefined) return failure;\n   116\t  }\n   117\t  return undefined;\n   118\t}\n   119\t\n   120\tfunction validateOneEvent(event: unknown, index: number): ErrorResult | undefined {\n   121\t  if (typeof event !== \"object\" || event === null || Array.isArray(event)) {\n   122\t    return callerError(\"event: each event must be a JSON object\", index);\n   123\t  }\n   124\t  const record = event as Record<string, unknown>;\n   125\t\n   126\t  for (const field of SERVER_GENERATED_FIELDS) {\n   127\t    if (field in record) {\n   128\t      return callerError(\n   129\t        `event: server-generated field \"${field}\" must not be supplied by the caller`,\n   130\t        index,\n   131\t      );\n   132\t    }\n   133\t  }\n   134\t\n   135\t  const kind = record[\"eventKind\"];\n   136\t  if (typeof kind === \"string\" && !(EVENT_KINDS as readonly string[]).includes(kind)) {\n   137\t    return callerError(`event: unknown event kind \"${kind}\"`, index);\n   138\t  }\n   139\t\n   140\t  const envelope = Schema.decodeUnknownEither(EventEnvelopeSchema, DECODE_OPTIONS)(event);\n   141\t  if (Either.isLeft(envelope)) {\n   142\t    return callerError(`event: ${firstIssue(envelope.left)}`, index);\n   143\t  }\n   144\t\n   145\t  const payload = record[\"payload\"];\n   146\t  if (typeof payload !== \"object\" || payload === null || Array.isArray(payload)) {\n   147\t    return callerError(\"event: payload must be a JSON object\", index);\n   148\t  }\n   149\t\n   150\t  if (envelope.right.eventKind === \"turn_end\") {\n   151\t    const extraKeys = Object.keys(payload);\n   152\t    if (extraKeys.length > 0) {\n   153\t      return callerError(\n   154\t        `payload: turn_end events carry an empty payload; found field \"${extraKeys[0]}\"`,\n   155\t        index,\n   156\t      );\n   157\t    }\n   158\t    return undefined;\n   159\t  }\n   160\t\n   161\t  let issue: string | undefined;\n   162\t  switch (envelope.right.eventKind) {\n   163\t    case \"tool_call\":\n   164\t      issue = decodeIssue(ToolCallPayloadSchema, payload);\n   165\t      break;\n   166\t    case \"tool_result\":\n   167\t      issue = decodeIssue(ToolResultPayloadSchema, payload);\n   168\t      break;\n   169\t    default:\n   170\t      issue = decodeIssue(TextPayloadSchema, payload);\n   171\t      break;\n   172\t  }\n   173\t  if (issue !== undefined) {\n   174\t    return callerError(`payload: ${issue}`, index);\n   175\t  }\n   176\t  return undefined;\n   177\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts'","aggregated_output":"     1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n     2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n     3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n     4\t// Stories 3–5 extend the same per-event walk with projection, turn\n     5\t// transitions, and work queueing.\n     6\timport { existsSync } from \"node:fs\";\n     7\timport type { DatabaseSync } from \"node:sqlite\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n     9\timport { openDatabase } from \"../../../shared/storage.js\";\n    10\timport { resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n    11\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n    12\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n    13\t\n    14\t// Test seam (set only through test/fixtures): called after each event is\n    15\t// processed inside the walk, so atomicity under mid-walk failure can be\n    16\t// induced through a real mechanism — closing the handle — rather than a\n    17\t// mocked transaction object.\n    18\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n    19\tlet walkHook: IntakeWalkHook | null = null;\n    20\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n    21\t  walkHook = hook;\n    22\t}\n    23\t\n    24\tfunction detail(cause: unknown): string {\n    25\t  return cause instanceof Error ? cause.message : String(cause);\n    26\t}\n    27\t\n    28\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    29\t  return {\n    30\t    ok: false,\n    31\t    error: {\n    32\t      errorClass: \"caller_error\",\n    33\t      code: \"thread_not_found\",\n    34\t      reason: `no thread file exists at ${filePath}`,\n    35\t    },\n    36\t  };\n    37\t}\n    38\t\n    39\t// The skip set is read at transaction start and reads only the key column:\n    40\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n    41\t// Chunked to stay under SQLite's bound-parameter limit.\n    42\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n    43\t  const found = new Set<string>();\n    44\t  for (let offset = 0; offset < keys.length; offset += 400) {\n    45\t    const chunk = keys.slice(offset, offset + 400);\n    46\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n    47\t    const rows = db\n    48\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n    49\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    50\t    for (const row of rows) found.add(row.idempotency_key);\n    51\t  }\n    52\t  return found;\n    53\t}\n    54\t\n    55\tfunction maxEventOrder(db: DatabaseSync): number {\n    56\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    57\t    | { max_order: number | bigint | null }\n    58\t    | undefined;\n    59\t  return Number(row?.max_order ?? 0);\n    60\t}\n    61\t\n    62\texport async function runMessageEvents(\n    63\t  thread: ThreadRef,\n    64\t  events: readonly MessageEventInput[],\n    65\t  clock: () => Date = () => new Date(),\n    66\t): Promise<OpResult<BatchResult>> {\n    67\t  // Pure validation first: a rejected batch never opens the file, never takes\n    68\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n    69\t  // not a skip (validation-before-idempotency precedence).\n    70\t  const refFailure = validateThreadRef(thread);\n    71\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n    72\t  const batchFailure = validateEvents(events);\n    73\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n    74\t\n    75\t  const resolved = await resolveThreadRef(thread);\n    76\t  if (!resolved.ok) return resolved;\n    77\t  const { filePath } = resolved.value;\n    78\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n    79\t\n    80\t  let db: DatabaseSync;\n    81\t  try {\n    82\t    db = openDatabase(filePath);\n    83\t  } catch (cause) {\n    84\t    return storageFailure(`could not open thread file: ${detail(cause)}`);\n    85\t  }\n    86\t\n    87\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n    88\t  // single-writer violations fail loudly at a defined point.\n    89\t  let inTransaction = false;\n    90\t  try {\n    91\t    db.exec(\"BEGIN IMMEDIATE;\");\n    92\t    inTransaction = true;\n    93\t\n    94\t    const skipSet = recordedKeys(\n    95\t      db,\n    96\t      events.map((event) => event.idempotencyKey),\n    97\t    );\n    98\t    // Order counter from MAX(event_order): only recorded events increment it,\n    99\t    // so skips consume no order numbers and the sequence stays dense.\n   100\t    let lastOrder = maxEventOrder(db);\n   101\t\n   102\t    const insert = db.prepare(\n   103\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   104\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   105\t    );\n   106\t\n   107\t    const eventResults: BatchResult[\"events\"] = [];\n   108\t    for (const [index, event] of events.entries()) {\n   109\t      if (skipSet.has(event.idempotencyKey)) {\n   110\t        eventResults.push({\n   111\t          idempotencyKey: event.idempotencyKey,\n   112\t          outcome: \"skipped\",\n   113\t          skipReason: \"duplicate_idempotency_key\",\n   114\t        });\n   115\t      } else {\n   116\t        lastOrder += 1;\n   117\t        insert.run(\n   118\t          lastOrder,\n   119\t          event.eventKind,\n   120\t          event.idempotencyKey,\n   121\t          event.actor,\n   122\t          event.harness,\n   123\t          JSON.stringify(event.payload),\n   124\t          clock().toISOString(),\n   125\t        );\n   126\t        skipSet.add(event.idempotencyKey);\n   127\t        eventResults.push({ idempotencyKey: event.idempotencyKey, outcome: \"recorded\" });\n   128\t      }\n   129\t      walkHook?.(db, index);\n   130\t    }\n   131\t\n   132\t    db.exec(\"COMMIT;\");\n   133\t    inTransaction = false;\n   134\t\n   135\t    return {\n   136\t      ok: true,\n   137\t      value: {\n   138\t        events: eventResults,\n   139\t        turnTransitions: [], // populated by Story 4\n   140\t        queuedWork: [], // populated by Story 5\n   141\t        threadPosition: { lastEventOrder: lastOrder },\n   142\t      },\n   143\t    };\n   144\t  } catch (cause) {\n   145\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n   146\t    // class-independent. The handle may already be gone (induced failure),\n   147\t    // in which case SQLite has already discarded the uncommitted transaction.\n   148\t    if (inTransaction) {\n   149\t      try {\n   150\t        db.exec(\"ROLLBACK;\");\n   151\t      } catch {\n   152\t        // handle closed mid-walk; the open transaction died with it\n   153\t      }\n   154\t    }\n   155\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n   156\t  } finally {\n   157\t    try {\n   158\t      db.close();\n   159\t    } catch {\n   160\t      // already closed by the induced-failure seam\n   161\t    }\n   162\t  }\n   163\t}\n   164\t\n   165\tinterface RawEventRow {\n   166\t  event_order: number | bigint;\n   167\t  event_kind: string;\n   168\t  idempotency_key: string;\n   169\t  actor: string;\n   170\t  harness: string;\n   171\t  payload: string;\n   172\t  recorded_at: string;\n   173\t}\n   174\t\n   175\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n   176\t  const refFailure = validateThreadRef(thread);\n   177\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n   178\t\n   179\t  const resolved = await resolveThreadRef(thread);\n   180\t  if (!resolved.ok) return resolved;\n   181\t  const { filePath } = resolved.value;\n   182\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   183\t\n   184\t  let db: DatabaseSync | undefined;\n   185\t  try {\n   186\t    db = openDatabase(filePath);\n   187\t    const rows = db\n   188\t      .prepare(\n   189\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n   190\t         FROM event ORDER BY event_order`,\n   191\t      )\n   192\t      .all() as unknown as RawEventRow[];\n   193\t    const records = rows.map(\n   194\t      (row) =>\n   195\t        ({\n   196\t          eventKind: row.event_kind,\n   197\t          idempotencyKey: row.idempotency_key,\n   198\t          actor: row.actor,\n   199\t          harness: row.harness,\n   200\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n   201\t          eventOrder: Number(row.event_order),\n   202\t          recordedAt: row.recorded_at,\n   203\t        }) as unknown as EventRecord,\n   204\t    );\n   205\t    return { ok: true, value: records };\n   206\t  } catch (cause) {\n   207\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n   208\t  } finally {\n   209\t    db?.close();\n   210\t  }\n   211\t}\n","exit_code":0,"status":"completed"}}

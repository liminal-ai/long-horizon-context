{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/storage.ts'","aggregated_output":"     1\timport { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface Migration {\n     4\t  version: number; // 1-based, strictly increasing\n     5\t  statements: readonly string[];\n     6\t}\n     7\t\n     8\texport function openDatabase(path: string): DatabaseSync {\n     9\t  const db = new DatabaseSync(path);\n    10\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n    11\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n    12\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n    13\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n    14\t  return db;\n    15\t}\n    16\t\n    17\texport function getSchemaVersion(db: DatabaseSync): number {\n    18\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n    19\t    | { user_version: number | bigint }\n    20\t    | undefined;\n    21\t  return Number(row?.user_version ?? 0);\n    22\t}\n    23\t\n    24\texport function runMigrations(\n    25\t  db: DatabaseSync,\n    26\t  migrations: readonly Migration[],\n    27\t): void {\n    28\t  let current = getSchemaVersion(db);\n    29\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n    30\t  for (const migration of ordered) {\n    31\t    if (migration.version <= current) continue;\n    32\t    db.exec(\"BEGIN IMMEDIATE;\");\n    33\t    try {\n    34\t      for (const statement of migration.statements) db.exec(statement);\n    35\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n    36\t      db.exec(\"COMMIT;\");\n    37\t    } catch (cause) {\n    38\t      db.exec(\"ROLLBACK;\");\n    39\t      throw cause;\n    40\t    }\n    41\t    current = migration.version;\n    42\t  }\n    43\t}\n","exit_code":0,"status":"completed"}}

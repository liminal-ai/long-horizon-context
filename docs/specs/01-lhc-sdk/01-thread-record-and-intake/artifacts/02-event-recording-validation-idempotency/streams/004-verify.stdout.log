{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/cli/render.ts'","aggregated_output":"     1\timport type { ErrorClass, OpResult } from \"../shared/errors.js\";\n     2\t\n     3\texport interface CliResult {\n     4\t  exitCode: number;\n     5\t  stdout: string;\n     6\t  stderr: string;\n     7\t}\n     8\t\n     9\t// Adapter-level failures (unknown command, missing command) happen before any\n    10\t// SDK call, so they carry adapter codes outside the SDK's ErrorCode set while\n    11\t// keeping the same structural shape.\n    12\texport type CliErrorCode = \"unknown_command\" | \"missing_flag\";\n    13\t\n    14\texport function renderResult(result: OpResult<unknown>): CliResult {\n    15\t  return {\n    16\t    exitCode: result.ok ? 0 : 1,\n    17\t    stdout: `${JSON.stringify(result, null, 2)}\\n`,\n    18\t    stderr: \"\",\n    19\t  };\n    20\t}\n    21\t\n    22\texport function renderCliError(\n    23\t  errorClass: ErrorClass,\n    24\t  code: CliErrorCode,\n    25\t  reason: string,\n    26\t): CliResult {\n    27\t  return {\n    28\t    exitCode: 1,\n    29\t    stdout: `${JSON.stringify({ ok: false, error: { errorClass, code, reason } }, null, 2)}\\n`,\n    30\t    stderr: \"\",\n    31\t  };\n    32\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/cli/index.ts'","aggregated_output":"     1\timport { parseArgs } from \"node:util\";\n     2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n     3\timport * as messages from \"../domains/messages/index.js\";\n     4\timport * as threads from \"../domains/threads/index.js\";\n     5\timport * as turns from \"../domains/turns/index.js\";\n     6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n     7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n     8\timport type { OpResult } from \"../shared/errors.js\";\n     9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n    10\t\n    11\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n    12\t// process stdin. null means interactive (TTY) — distinct from empty input\n    13\t// only in how it arises; both are refused with empty_stdin before any SDK\n    14\t// call (the SDK itself can never return that code).\n    15\texport type StdinReader = () => Promise<string | null>;\n    16\t\n    17\tasync function readProcessStdin(): Promise<string | null> {\n    18\t  if (process.stdin.isTTY) return null;\n    19\t  process.stdin.setEncoding(\"utf8\");\n    20\t  let data = \"\";\n    21\t  for await (const chunk of process.stdin) data += String(chunk);\n    22\t  return data;\n    23\t}\n    24\t\n    25\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n    26\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n    27\t}\n    28\t\n    29\tconst HELP = `lhc — Long Horizon Context CLI\n    30\t\n    31\tUsage:\n    32\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n    33\t  lhc threads resolve --thread-id <id> [--registry <r>]\n    34\t  lhc threads list [--registry <r>]\n    35\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    36\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    37\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    38\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    39\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    40\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    41\t\n    42\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n    43\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n    44\t`;\n    45\t\n    46\tinterface ParsedFlags {\n    47\t  threadId?: string;\n    48\t  filePath?: string;\n    49\t  title?: string;\n    50\t  registryPath?: string;\n    51\t}\n    52\t\n    53\tfunction parseFlags(args: readonly string[]): ParsedFlags {\n    54\t  const { values } = parseArgs({\n    55\t    args: [...args],\n    56\t    options: {\n    57\t      \"thread-id\": { type: \"string\" },\n    58\t      \"file-path\": { type: \"string\" },\n    59\t      title: { type: \"string\" },\n    60\t      registry: { type: \"string\" },\n    61\t    },\n    62\t    strict: false,\n    63\t    allowPositionals: true,\n    64\t  });\n    65\t  const flags: ParsedFlags = {};\n    66\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n    67\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n    68\t  if (typeof values.title === \"string\") flags.title = values.title;\n    69\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n    70\t  return flags;\n    71\t}\n    72\t\n    73\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n    74\t  if (flags.threadId !== undefined) {\n    75\t    return flags.registryPath !== undefined\n    76\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n    77\t      : { threadId: flags.threadId };\n    78\t  }\n    79\t  return { filePath: flags.filePath ?? \"\" };\n    80\t}\n    81\t\n    82\texport async function runCli(\n    83\t  argv: readonly string[],\n    84\t  readStdin: StdinReader = readProcessStdin,\n    85\t): Promise<CliResult> {\n    86\t  if (argv.length === 0) {\n    87\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n    88\t  }\n    89\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n    90\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n    91\t  }\n    92\t\n    93\t  const [group, command, ...rest] = argv;\n    94\t  const key = command === undefined ? group : `${group} ${command}`;\n    95\t  const flags = parseFlags(command === undefined ? [] : rest);\n    96\t\n    97\t  switch (key) {\n    98\t    case \"threads new-thread\": {\n    99\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n   100\t      // instead of failing, so the adapter refuses before any SDK call.\n   101\t      if (flags.filePath === undefined) {\n   102\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n   103\t      }\n   104\t      const input: Parameters<typeof threads.newThread>[0] = {\n   105\t        filePath: flags.filePath,\n   106\t      };\n   107\t      if (flags.title !== undefined) input.title = flags.title;\n   108\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   109\t      return renderResult(await threads.newThread(input));\n   110\t    }\n   111\t    case \"threads resolve\": {\n   112\t      if (flags.threadId === undefined) {\n   113\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n   114\t      }\n   115\t      const input: Parameters<typeof threads.resolve>[0] = {\n   116\t        threadId: flags.threadId,\n   117\t      };\n   118\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   119\t      return renderResult(await threads.resolve(input));\n   120\t    }\n   121\t    case \"threads list\": {\n   122\t      return renderResult(\n   123\t        await threads.listThreads(\n   124\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n   125\t        ),\n   126\t      );\n   127\t    }\n   128\t    case \"intake-stream message-events\": {\n   129\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   130\t        return renderCliError(\n   131\t          \"caller_error\",\n   132\t          \"missing_flag\",\n   133\t          \"intake-stream message-events requires --thread-id or --file-path\",\n   134\t        );\n   135\t      }\n   136\t      const text = await readStdin();\n   137\t      if (text === null || text.trim() === \"\") {\n   138\t        return renderResult(\n   139\t          stdinCallerError(\n   140\t            \"empty_stdin\",\n   141\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n   142\t          ),\n   143\t        );\n   144\t      }\n   145\t      let parsed: unknown;\n   146\t      try {\n   147\t        parsed = JSON.parse(text);\n   148\t      } catch (cause) {\n   149\t        const detail = cause instanceof Error ? cause.message : String(cause);\n   150\t        return renderResult(\n   151\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n   152\t        );\n   153\t      }\n   154\t      if (!Array.isArray(parsed)) {\n   155\t        return renderResult(\n   156\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n   157\t        );\n   158\t      }\n   159\t      return renderResult(\n   160\t        await intakeStream.messageEvents(\n   161\t          threadRefFrom(flags),\n   162\t          parsed as readonly MessageEventInput[],\n   163\t        ),\n   164\t      );\n   165\t    }\n   166\t    case \"intake-stream list-events\": {\n   167\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   168\t        return renderCliError(\n   169\t          \"caller_error\",\n   170\t          \"missing_flag\",\n   171\t          \"intake-stream list-events requires --thread-id or --file-path\",\n   172\t        );\n   173\t      }\n   174\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n   175\t    }\n   176\t    case \"messages list\":\n   177\t      return renderResult(await messages.listMessages(threadRefFrom(flags)));\n   178\t    case \"messages list-queued-work\":\n   179\t      return renderResult(await messages.listQueuedWork(threadRefFrom(flags)));\n   180\t    case \"turns list\":\n   181\t      return renderResult(await turns.listTurns(threadRefFrom(flags)));\n   182\t    case \"turns list-queued-work\":\n   183\t      return renderResult(await turns.listQueuedWork(threadRefFrom(flags)));\n   184\t    default:\n   185\t      return renderCliError(\n   186\t        \"caller_error\",\n   187\t        \"unknown_command\",\n   188\t        `unknown command: ${key}; run lhc --help`,\n   189\t      );\n   190\t  }\n   191\t}\n","exit_code":0,"status":"completed"}}

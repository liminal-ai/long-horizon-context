ntLiveItems,\n128\t  enqueue,\n129\t  queueDetail,\n130\t  supersedeQueued,\n131\t  type ClaimedWorkItem,\n132\t  type EnqueueFormTarget,\n133\t  type EnqueueInput,\n134\t  type QueueDetailRow,\n135\t} from \"./tech-utils/work-queue/index.js\";\n136\t\n137\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n138\t// inspect surface serves.\n139\texport type {\n140\t  HealthReport,\n141\t  InspectOverview,\n142\t  ViewContentsReport,\n143\t} from \"./shared/inspect.js\";\n144\t\n145\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n146\texport type {\n147\t  Block,\n148\t  BlockType,\n149\t  MessageDetail,\n150\t  MessageListOptions,\n151\t  MessageRecord,\n152\t  MutationResult,\n153\t} from \"./domains/messages/index.js\";\n154\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n155\texport type {\n156\t  BatchResult,\n157\t  EventKind,\n158\t  EventRecord,\n159\t  MessageEventInput,\n160\t} from \"./domains/intake-stream/index.js\";\n161\t\n162\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n163\t\n164\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n165\t\n166\t// Merge per-domain handler tables into the one join between the queue's\n167\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n168\t// (each kind has exactly one owner) and throws at construction.\n169\texport function assembleWorkHandlerMap(\n170\t  tables: ReadonlyArray<WorkHandlerMap>,\n171\t): WorkHandlerMap {\n172\t  const map: WorkHandlerMap = {};\n173\t  for (const table of tables) {\n174\t    for (const [kind, handler] of Object.entries(table)) {\n175\t      if (map[kind as WorkKind] !== undefined) {\n176\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n177\t      }\n178\t      map[kind as WorkKind] = handler;\n179\t    }\n180\t  }\n181\t  return map;\n182\t}\n183\t\n184\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n185\t  return {\n186\t    ok: false,\n187\t    error: {\n188\t      errorClass: \"state_corruption\",\n189\t      code: \"unknown_work_kind\",\n190\t      reason: `no handler registered for work kind \"${kind}\"`,\n191\t    },\n192\t  };\n193\t}\n194\t\n195\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n196\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n197\texport function lookupWorkHandler(\n198\t  map: WorkHandlerMap,\n199\t  kind: string,\n200\t): OpResult<WorkHandler> {\n201\t  const handler = map[kind as WorkKind];\n202\t  if (handler === undefined) return unknownWorkKind(kind);\n203\t  return { ok: true, value: handler };\n204\t}\n205\t\n206\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n207\t// requeue land in Story 4.\n208\texport interface WorkSurface {\n209\t  drain(\n210\t    ref: threadsDomain.ThreadRef,\n211\t    opts?: { maxItems?: number },\n212\t  ): Promise<OpResult<DrainReport>>;\n213\t}\n214\t\n215\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n216\t// §Interface Definitions): the operations only — the Story 0 config\n217\t// substrate the domain index also carries is construction machinery, not an\n218\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n219\t// inspect domain composes (DD-1).\n220\texport interface ThreadViewSurface {\n221\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n222\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n223\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n224\t  compact(\n225\t    ref: threadsDomain.ThreadRef,\n226\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n227\t  ): Promise<OpResult<CompactReceipt>>;\n228\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n229\t  materialize(\n230\t    ref: threadsDomain.ThreadRef,\n231\t    opts: { path: string; format?: \"pi-session\" },\n232\t  ): Promise<OpResult<{ writtenPath: string }>>;\n233\t}\n234\t\n235\texport interface Lhc {\n236\t  threads: typeof threadsDomain;\n237\t  intakeStream: typeof intakeStreamDomain;\n238\t  messages: typeof messagesDomain;\n239\t  turns: typeof turnsDomain;\n240\t  threadView: ThreadViewSurface;\n241\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n242\t  // like every other namespace so the status read it composes resolves THIS\n243\t  // SDK's view config (threshold, visibility budgets).\n244\t  inspect: typeof inspectDomain;\n245\t  config: ResolvedSdkConfig;\n246\t  scheduler: Scheduler;\n247\t  workHandlers: WorkHandlerMap;\n248\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n249\t  work: WorkSurface;\n250\t  // Resolves when the scheduler has no running or pending drain for the\n251\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n252\t  // resolve in manual mode.\n253\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n254\t}\n255\t\n256\tfunction requirePositive(value: number, name: string): void {\n257\t  if (!Number.isFinite(value) || value <= 0) {\n258\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n259\t  }\n260\t}\n261\t\n262\tfunction requireNonNegative(value: number, name: string): void {\n263\t  if (!Number.isFinite(value) || value < 0) {\n264\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n265\t  }\n266\t}\n267\t\n268\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n269\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n270\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n271\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n272\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n273\t// object is the same shape as the namespace, so the public surface type holds.\n274\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n275\t  const scoped: Record<string, unknown> = {};\n276\t  for (const key of Object.keys(surface)) {\n277\t    const value = (surface as Record<string, unknown>)[key];\n278\t    scoped[key] =\n279\t      typeof value === \"function\"\n280\t        ? (...args: unknown[]): unknown =>\n281\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n282\t        : value;\n283\t  }\n284\t  return scoped as T;\n285\t}\n286\t\n287\t// The only assembly path: provider, mode, clock, and policy enter here.\n288\t// Config mistakes are programmer errors at construction and throw; operating\n289\t// failures after construction return OpResults per the error contract.\n290\texport function createSdk(config: SdkConfig): Lhc {\n291\t  // Provider arrival is injection at construction only (Epic 05 Flow 6):\n292\t  // there is no named-provider registry and no env/flag resolution path left\n293\t  // to fall back on. The `inference` alternative lands in Story 2; the XOR\n294\t  // rule is named from day one so a missing provider reports the final\n295\t  // contract, not a downstream symptom.\n296\t  if (config.provider === undefined && (config as { inference?: unknown }).inference === undefined) {\n297\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n298\t  }\n299\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n300\t    throw new TypeError(\n301\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n302\t    );\n303\t  }\n304\t  if (config.provider === null || typeof config.provider !== \"object\") {\n305\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n306\t  }\n307\t  for (const operation of PROVIDER_OPERATIONS) {\n308\t    if (typeof config.provider[operation] !== \"function\") {\n309\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n310\t    }\n311\t  }\n312\t\n313\t  const resolved: ResolvedSdkConfig = {\n314\t    provider: config.provider,\n315\t    mode: config.mode,\n316\t    clock: config.clock ?? (() => new Date()),\n317\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n318\t    lease: config.lease ?? { durationMs: 120000 },\n319\t    chunkPolicy:\n320\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n321\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n322\t    // sums and visibility budgets validated — throws naming the violation.\n323\t    view: resolveViewConfig(config.view),\n324\t  };\n325\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n326\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n327\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n328\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n329\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n330\t  }\n331\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n332\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n333\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n334\t    throw new TypeError(\n335\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n336\t    );\n337\t  }\n338\t\n339\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n340\t  // The tables are empty until Stories 2–3 land the real handlers; the\n341\t  // assembly mechanics are production code from day one.\n342\t  const workHandlers = assembleWorkHandlerMap([\n343\t    messagesDomain.workHandlers,\n344\t    turnsDomain.workHandlers,\n345\t  ]);\n346\t\n347\t  const drainDeps: DrainDeps = {\n348\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n349\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n350\t    config: resolved,\n351\t  };\n352\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n353\t\n354\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n355\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n356\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n357\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n358\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n359\t  // the construction order, because its operations deliver to the no-op seam,\n360\t  // not to whatever a background SDK installed below.\n361\t  // The seam also carries this instance's resolved view config (Epic 03,\n362\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n363\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n364\t  // fall back to the built-in defaults inside the thread-view surface.\n365\t  const seam: InstanceSeam =\n366\t    resolved.mode === \"background\"\n367\t      ? {\n368\t          poke: (threadId) => scheduler.poke(threadId),\n369\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n370\t          view: resolved.view,\n371\t        }\n372\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n373\t\n374\t  // Background mode also installs the below-SDK default seam so a direct\n375\t  // domain call made with no SDK scope — a top-level mutation in the\n376\t  // single-background \"production path\" — still reaches the one installed\n377\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n378\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n379\t  // leaves the default alone (pokes stay no-ops by contract).\n380\t  if (resolved.mode === \"background\") {\n381\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n382\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n383\t  }\n384\t\n385\t  const work: WorkSurface = {\n386\t    drain: (ref, opts) =>\n387\t      runWithInstanceSeam(seam, async () => {\n388\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n389\t        if (!resolvedRef.ok) return resolvedRef;\n390\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n391\t      }),\n392\t  };\n393\t\n394\t  return {\n395\t    threads: threadsDomain,\n396\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n397\t    messages: scopeSurface(messagesDomain, seam),\n398\t    turns: scopeSurface(turnsDomain, seam),\n399\t    threadView: scopeSurface<ThreadViewSurface>(\n400\t      {\n401\t        pull: threadViewDomain.pull,\n402\t        status: threadViewDomain.status,\n403\t        describe: threadViewDomain.describe,\n404\t        compact: threadViewDomain.compact,\n405\t        sweep: threadViewDomain.sweep,\n406\t        materialize: threadViewDomain.materialize,\n407\t      },\n408\t      seam,\n409\t    ),\n410\t    inspect: scopeSurface(inspectDomain, seam),\n411\t    config: resolved,\n412\t    scheduler,\n413\t    workHandlers,\n414\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n415\t    work,\n416\t    drainSettled: async (ref) => {\n417\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n418\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n419\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n420\t      if (threadId === null) return;\n421\t      return scheduler.drainSettled(threadId);\n422\t    },\n423\t  };\n424\t}\n425\t"}]},"parent_tool_use_id":null,"session_id":"63bc85b8-d520-4651-80cb-f34c66d44cc0","uuid":"95d9bf24-70b5-48f2-bb70-53c85637abde","timestamp":"2026-06-12T21:31:42.000Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\nexport * as threadView from \"./domains/thread-view/index.js\";\nexport * as inspect from \"./domains/inspect/index.js\";\n\nimport * as inspectDomain from \"./domains/inspect/index.js\";\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as threadViewDomain from \"./domains/thread-view/index.js\";\nimport { resolveViewConfig } from \"./domains/thread-view/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport {\n  runWithInstanceSeam,\n  setSchedulerPoke as installSchedulerPoke,\n  setThreadTouch,\n  type InstanceSeam,\n} from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  StoredView,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewProfile,\n  ViewStatus,\n} from \"./shared/view.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n// from Story 0; the operation shapes land with Stories 1–5.\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n} from \"./domains/thread-view/index.js\";\nexport type {\n  Band,\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SdkViewConfig,\n  StoredView,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewMeta,\n  ViewProfile,\n  ViewProfileOverride,\n  ViewStatus,\n  VisibilityBudgets,\n} from \"./shared/view.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\n// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n// inspect surface serves.\nexport type {\n  HealthReport,\n  InspectOverview,\n  ViewContentsReport,\n} from \"./shared/inspect.js\";\n\nexport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageDetail,\n  MessageListOptions,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\n// §Interface Definitions): the operations only — the Story 0 config\n// substrate the domain index also carries is construction machinery, not an\n// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n// inspect domain composes (DD-1).\nexport interface ThreadViewSurface {\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n  compact(\n    ref: threadsDomain.ThreadRef,\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n  ): Promise<OpResult<CompactReceipt>>;\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n  materialize(\n    ref: threadsDomain.ThreadRef,\n    opts: { path: string; format?: \"pi-session\" },\n  ): Promise<OpResult<{ writtenPath: string }>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  threadView: ThreadViewSurface;\n  // Epic 04: the read-only report surface. Scoped through the instance seam\n  // like every other namespace so the status read it composes resolves THIS\n  // SDK's view config (threshold, visibility budgets).\n  inspect: typeof inspectDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n// object is the same shape as the namespace, so the public surface type holds.\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n  const scoped: Record<string, unknown> = {};\n  for (const key of Object.keys(surface)) {\n    const value = (surface as Record<string, unknown>)[key];\n    scoped[key] =\n      typeof value === \"function\"\n        ? (...args: unknown[]): unknown =>\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n        : value;\n  }\n  return scoped as T;\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  // Provider arrival is injection at construction only (Epic 05 Flow 6):\n  // there is no named-provider registry and no env/flag resolution path left\n  // to fall back on. The `inference` alternative lands in Story 2; the XOR\n  // rule is named from day one so a missing provider reports the final\n  // contract, not a downstream symptom.\n  if (config.provider === undefined && (config as { inference?: unknown }).inference === undefined) {\n    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n  }\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n  // background mode, or a no-op in manual mode — isolated from any other SDK\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\n  // the construction order, because its operations deliver to the no-op seam,\n  // not to whatever a background SDK installed below.\n  // The seam also carries this instance's resolved view config (Epic 03,\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n  // fall back to the built-in defaults inside the thread-view surface.\n  const seam: InstanceSeam =\n    resolved.mode === \"background\"\n      ? {\n          poke: (threadId) => scheduler.poke(threadId),\n          touch: (filePath, db) => scheduler.touch(filePath, db),\n          view: resolved.view,\n        }\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\n\n  // Background mode also installs the below-SDK default seam so a direct\n  // domain call made with no SDK scope — a top-level mutation in the\n  // single-background \"production path\" — still reaches the one installed\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n  // leaves the default alone (pokes stay no-ops by contract).\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: (ref, opts) =>\n      runWithInstanceSeam(seam, async () => {\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n        if (!resolvedRef.ok) return resolvedRef;\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n      }),\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\n    messages: scopeSurface(messagesDomain, seam),\n    turns: scopeSurface(turnsDomain, seam),\n    threadView: scopeSurface<ThreadViewSurface>(\n      {\n        pull: threadViewDomain.pull,\n        status: threadViewDomain.status,\n        describe: threadViewDomain.describe,\n        compact: threadViewDomain.compact,\n        sweep: threadViewDomain.sweep,\n        materialize: threadViewDomain.materialize,\n      },\n      seam,\n    ),\n    inspect: scopeSurface(inspectDomain, seam),\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":425,"startLine":1,"totalLines":425}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C9b9ufXNBvRxmHXhAq54PT","type":"tool_result","content":"1\timport { mkdtempSync, rmSync } from \"node:fs\";\n2\timport { tmpdir } from \"node:os\";\n3\timport { join } from \"node:path\";\n4\timport { DatabaseSync } from \"node:sqlite\";\n5\timport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n6\t\n7\texport type EventByKind<K extends EventKind> = Extract<\n8\t  MessageEventInput,\n9\t  { eventKind: K }\n10\t>;\n11\t\n12\tlet keyCounter = 0;\n13\t\n14\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n15\t  user_prompt: () => ({ text: \"please read the file\" }),\n16\t  assistant_text: () => ({ text: \"here is what I found\" }),\n17\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n18\t  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n19\t  tool_call: () => ({\n20\t    toolCallId: \"call-1\",\n21\t    toolName: \"read_file\",\n22\t    arguments: { path: \"notes.txt\" },\n23\t  }),\n24\t  tool_result: () => ({\n25\t    toolCallId: \"call-1\",\n26\t    content: \"contents of notes.txt\",\n27\t    isError: false,\n28\t  }),\n29\t  turn_end: () => ({}),\n30\t};\n31\t\n32\t// Returns the discriminated MessageEventInput member for its kind, so a\n33\t// kind/payload mismatch in test code is a compile error — building an invalid\n34\t// pairing requires an explicit cast at the call site.\n35\texport function validEvent<K extends EventKind>(\n36\t  kind: K,\n37\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n38\t): EventByKind<K> {\n39\t  keyCounter += 1;\n40\t  const base = {\n41\t    eventKind: kind,\n42\t    idempotencyKey: `fixture-key-${keyCounter}`,\n43\t    actor: \"fixture-actor\",\n44\t    harness: \"fixture-harness\",\n45\t    payload: defaultPayloads[kind](),\n46\t  };\n47\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n48\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n49\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n50\t  // parameter types, not this assertion.\n51\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n52\t}\n53\t\n54\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n55\t  return kinds.map((kind) => validEvent(kind));\n56\t}\n57\t\n58\texport function conversationTurn(): MessageEventInput[] {\n59\t  return eventBatch([\n60\t    \"user_prompt\",\n61\t    \"assistant_text\",\n62\t    \"tool_call\",\n63\t    \"tool_result\",\n64\t    \"turn_end\",\n65\t  ]);\n66\t}\n67\t\n68\texport interface TempStore {\n69\t  dir: string;\n70\t  registryPath: string;\n71\t  threadPath: (name?: string) => string;\n72\t  cleanup: () => void;\n73\t}\n74\t\n75\texport function tempStore(): TempStore {\n76\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n77\t  let threadCounter = 0;\n78\t  return {\n79\t    dir,\n80\t    registryPath: join(dir, \"registry.sqlite\"),\n81\t    threadPath: (name) => {\n82\t      threadCounter += 1;\n83\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n84\t    },\n85\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n86\t  };\n87\t}\n88\t\n89\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n90\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n91\texport function openRaw(path: string): DatabaseSync {\n92\t  return new DatabaseSync(path);\n93\t}\n94\t\n95\texport {\n96\t  corruptTwoOpenTurns,\n97\t  poisonMessageBlockJson,\n98\t  poisonMessageFormJson,\n99\t} from \"./corrupt.js\";\n100\texport { assertSweepReceiptShape } from \"./receipt-schema.js\";\n101\texport { assertPiSessionConformance, loadPiSessionFixture } from \"./pi-session-format.js\";\n102\t// The sweep's classification table, re-exported for the Story 3 unit legs:\n103\t// fixtures are 
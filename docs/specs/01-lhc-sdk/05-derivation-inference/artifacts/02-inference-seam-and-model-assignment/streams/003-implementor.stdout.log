{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GCUc9kCYYhPoMfri9BCNKF","type":"tool_result","content":"1\t// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\n2\t// driven once, in PI-extension call order, against one real SDK\n3\t// configuration with the deterministic provider — zero network, zero real\n4\t// provider, no mocks anywhere. The script owns the sequence and the phase\n5\t// names (tech design Flow 5); assertions live in the driving tests, so the\n6\t// replay, teardown, and process legs all run THIS sequence rather than a\n7\t// re-described one (DD-8).\n8\t//\n9\t// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\n10\t// mutate | rebuild | health2 | compact2 | pull2 | materialize.\n11\t//\n12\t// Mode is background — the production posture the PI extension will run —\n13\t// and the drain/rebuild phases settle through `drainSettled`, the real\n14\t// background awaitable. The post-mutation health snapshot (AC-5.2's\n15\t// \"cleared set pending\") is deterministic because every SDK operation here\n16\t// is synchronous SQLite chained through microtasks, while a background\n17\t// drain pass always starts on a macrotask (scheduler runLoop defers through\n18\t// setImmediate): the edit → delete → health reads inside the mutate phase\n19\t// run as one unbroken microtask cascade and complete before the poked drain\n20\t// can claim its first item. The rebuild phase then yields via drainSettled\n21\t// and the drain runs to empty.\n22\timport { join } from \"node:path\";\n23\timport {\n24\t  createDeterministicProvider,\n25\t  createSdk,\n26\t  type BatchResult,\n27\t  type CompactReceipt,\n28\t  type FormReportEntry,\n29\t  type HealthReport,\n30\t  type InspectOverview,\n31\t  type Lhc,\n32\t  type MessageEventInput,\n33\t  type MutationResult,\n34\t  type OpResult,\n35\t  type PullResult,\n36\t  type ViewContentsReport,\n37\t  type ViewStatus,\n38\t} from \"../../src/index.js\";\n39\timport { validEvent, type TempStore } from \"./index.js\";\n40\t\n41\t// ── the one SDK configuration (AC-5.1) ────────────────────────────\n42\t//\n43\t// Deterministic provider injected at construction (the only provider-arrival\n44\t// path since the CLI retired), background mode, zero-backoff retry so a\n45\t// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\n46\t// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\n47\t// a named \"lifecycle\" profile so compact runs profile-addressed (story\n48\t// scope: \"compact (profile)\") with all three lower bands non-empty on this\n49\t// thread (Epic 03 Story 2's reference gradient).\n50\texport const LIFECYCLE_PROFILE = {\n51\t  name: \"lifecycle\",\n52\t  lowerBound: 400,\n53\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n54\t} as const;\n55\t\n56\texport function createLifecycleSdk(): Lhc {\n57\t  return createSdk({\n58\t    provider: createDeterministicProvider(),\n59\t    mode: \"background\",\n60\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n61\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n62\t    view: {\n63\t      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\n64\t      // Low threshold so the status checkpoint genuinely recommends the\n65\t      // compact the sequence performs next.\n66\t      compactThreshold: 300,\n67\t    },\n68\t  });\n69\t}\n70\t\n71\t// ── the recorded conversation ─────────────────────────────────────\n72\t//\n73\t// Same shape and text profile as the Epic 03 derived-thread fixture (12\n74\t// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\n75\t// policy cuts the same 4-chunk shape — but with explicit per-run\n76\t// idempotency keys so a replay on a fresh thread records byte-identical\n77\t// event payloads regardless of any process-global fixture counters.\n78\tconst TURN_COUNT = 12;\n79\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n80\tconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\n81\t\n82\t// Mutation targets: both in the post-compact tail (compact point at t9's\n83\t// start under the lifecycle profile), so the second compact's pull shows the\n84\t// edit verbatim and the deletion's absence — the tail is full fidelity.\n85\texport const EDIT_TARGET = { turnId: \"t12\", kind: \"user_prompt\" } as const;\n86\texport const EDITED_MESSAGE_TEXT =\n87\t  \"turn 12 revised: drop area 12 and re-check area 5 instead\";\n88\texport const DELETE_TARGET = { turnId: \"t10\", kind: \"assistant_text\" } as const;\n89\texport const DELETED_MESSAGE_TEXT = \"findings for area 10\";\n90\t\n91\tfunction turnEvents(turn: number): MessageEventInput[] {\n92\t  let seq = 0;\n93\t  const key = (): string => {\n94\t    seq += 1;\n95\t    return `lc-t${turn}-e${seq}`;\n96\t  };\n97\t  const events: MessageEventInput[] = [\n98\t    validEvent(\"user_prompt\", {\n99\t      idempotencyKey: key(),\n100\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n101\t    }),\n102\t    validEvent(\"assistant_thinking\", {\n103\t      idempotencyKey: key(),\n104\t      payload: { text: `considering what area ${turn} contains` },\n105\t    }),\n106\t  ];\n107\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n108\t    for (const run of [1, 2]) {\n109\t      const toolCallId = `call-lc-${turn}-${run}`;\n110\t      events.push(\n111\t        validEvent(\"tool_call\", {\n112\t          idempotencyKey: key(),\n113\t          payload: {\n114\t            toolCallId,\n115\t            toolName: \"read_file\",\n116\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n117\t          },\n118\t        }),\n119\t        validEvent(\"tool_result\", {\n120\t          idempotencyKey: key(),\n121\t          payload: {\n122\t            toolCallId,\n123\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n124\t            isError: false,\n125\t          },\n126\t        }),\n127\t      );\n128\t    }\n129\t  }\n130\t  events.push(\n131\t    validEvent(\"assistant_text\", {\n132\t      idempotencyKey: key(),\n133\t      payload: { text: `findings for area ${turn}` },\n134\t    }),\n135\t    validEvent(\"turn_end\", { idempotencyKey: key() }),\n136\t  );\n137\t  return events;\n138\t}\n139\t\n140\tfunction intakeBatches(): MessageEventInput[][] {\n141\t  const batches: MessageEventInput[][] = [];\n142\t  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\n143\t    const batch: MessageEventInput[] = [];\n144\t    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\n145\t      batch.push(...turnEvents(turn));\n146\t    }\n147\t    batches.push(batch);\n148\t  }\n149\t  return batches;\n150\t}\n151\t\n152\t// ── run shape ─────────────────────────────────────────────────────\n153\t\n154\texport interface LifecyclePhases {\n155\t  create: OpResult<{ threadId: string; filePath: string }>;\n156\t  intake: Array<OpResult<BatchResult>>;\n157\t  drain: { settled: true };\n158\t  status: OpResult<ViewStatus>;\n159\t  compact1: OpResult<CompactReceipt>;\n160\t  pull1: OpResult<PullResult>;\n161\t  inspect1: {\n162\t    overview: OpResult<InspectOverview>;\n163\t    view: OpResult<ViewContentsReport>;\n164\t    health: OpResult<HealthReport>;\n165\t  };\n166\t  mutate: {\n167\t    editedMessageId: string;\n168\t    deletedMessageId: string;\n169\t    edit: OpResult<MutationResult>;\n170\t    delete: OpResult<MutationResult>;\n171\t    // Captured inside the mutate phase, before the background drain's first\n172\t    // macrotask: the cleared-set-pending evidence (AC-5.2).\n173\t    healthAfterMutate: OpResult<HealthReport>;\n174\t    messagesNotReady: OpResult<FormReportEntry[]>;\n175\t    turnsNotReady: OpResult<FormReportEntry[]>;\n176\t  };\n177\t  rebuild: { settled: true };\n178\t  health2: OpResult<HealthReport>;\n179\t  compact2: OpResult<CompactReceipt>;\n180\t  pull2: OpResult<PullResult>;\n181\t  materialize: OpResult<{ writtenPath: string }>;\n182\t}\n183\t\n184\texport type LifecycleCheckpoint = \"inspect1\" | \"health2\" | \"materialize\";\n185\t\n186\texport interface LifecycleOptions {\n187\t  // Distinguishes the thread file and materialize target so replay and\n188\t  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\n189\t  name?: string;\n190\t  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\n191\t  // render phase groups — every group boundary is a quiescent point (no\n192\t  // queued work, no running drain), so the abandoned instance can never act\n193\t  // after its group ends.\n194\t  freshSdkBetweenGroups?: boolean;\n195\t  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\n196\t  onCheckpoint?: (\n197\t    checkpoint: LifecycleCheckpoint,\n198\t    ctx: { sdk: Lhc; filePath: string },\n199\t  ) => Promise<void>;\n200\t}\n201\t\n202\texport interface LifecycleRun {\n203\t  filePath: string;\n204\t  outPath: string;\n205\t  threadId: string;\n206\t  phases: LifecyclePhases;\n207\t}\n208\t\n209\tfunction expectOk<T>(result: OpResult<T>, phase: string): T {\n210\t  if (!result.ok) {\n211\t    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\n212\t  }\n213\t  return result.value;\n214\t}\n215\t\n216\t// ── the sequence ──────────────────────────────────────────────────\n217\t\n218\texport async function runLifecycle(\n219\t  store: TempStore,\n220\t  opts: LifecycleOptions = {},\n221\t): Promise<LifecycleRun> {\n222\t  const name = opts.name ?? \"lifecycle\";\n223\t  const filePath = store.threadPath(name);\n224\t  const outPath = join(store.dir, `${name}-session.jsonl`);\n225\t  const ref = { filePath };\n226\t\n227\t  let sdk = createLifecycleSdk();\n228\t  const nextGroup = (): void => {\n229\t    // The fresh instance is the same configuration assembled again — the\n230\t    // continuity proof is that no phase depends on the prior instance's\n231\t    // memory, only on the thread file.\n232\t    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\n233\t  };\n234\t  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\n235\t    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\n236\t  };\n237\t\n238\t  // ── group 1: create → intake → drain → status ──\n239\t  const create = await sdk.threads.newThread({\n240\t    filePath,\n241\t    registryPath: store.registryPath,\n242\t  });\n243\t  const threadId = expectOk(create, \"create\").threadId;\n244\t\n245\t  const intake: Array<OpResult<BatchResult>> = [];\n246\t  for (const batch of intakeBatches()) {\n247\t    const sent = await sdk.intakeStream.messageEvents(ref, batch);\n248\t    intake.push(sent);\n249\t    expectOk(sent, \"intake\");\n250\t  }\n251\t\n252\t  // Background drain settles (story scope): the intake pokes scheduled the\n253\t  // work; this is the await that lets the scheduler run it to empty.\n254\t  await sdk.drainSettled(ref);\n255\t  const drain = { settled: true } as const;\n256\t\n257\t  const status = await sdk.threadView.status(ref);\n258\t  expectOk(status, \"status\");\n259\t\n260\t  // ── group 2: compact1 → pull1 → inspect1 ──\n261\t  nextGroup();\n262\t  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n263\t  expectOk(compact1, \"compact1\");\n264\t  const pull1 = await sdk.threadView.pull(ref);\n265\t  expectOk(pull1, \"pull1\");\n266\t  const inspect1 = {\n267\t    overview: await sdk.inspect.overview(ref),\n268\t    view: await sdk.inspect.view(ref),\n269\t    health: await sdk.inspect.health(ref),\n270\t  };\n271\t  expectOk(inspect1.overview, \"inspect1.overview\");\n272\t  expectOk(inspect1.view, \"inspect1.view\");\n273\t  expectOk(inspect1.health, \"inspect1.health\");\n274\t  await checkpoint(\"inspect1\");\n275\t\n276\t  // ── group 3: mutate → rebuild → health2 ──\n277\t  nextGroup();\n278\t  const listed = expectOk(await sdk.messages.listMessages(ref), \"mutate.list\");\n279\t  const editTarget = listed.find(\n280\t    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\n281\t  );\n282\t  const deleteTarget = listed.find(\n283\t    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\n284\t  );\n285\t  if (editTarget === undefined || deleteTarget === undefined) {\n286\t    throw new Error(\"lifecycle invariant: edit/delete targets not found in the record\");\n287\t  }\n288\t  // Edit, delete, and the pending-state reads run in one microtask cascade\n289\t  // (see module header): the snapshot is taken before the poked background\n290\t  // drain starts its first pass.\n291\t  const edit = await sdk.messages.edit(ref, {\n292\t    messageId: editTarget.messageId,\n293\t    content: EDITED_MESSAGE_TEXT,\n294\t  });\n295\t  expectOk(edit, \"mutate.edit\");\n296\t  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\n297\t  expectOk(deleted, \"mutate.delete\");\n298\t  const mutate: LifecyclePhases[\"mutate\"] = {\n299\t    editedMessageId: editTarget.messageId,\n300\t    deletedMessageId: deleteTarget.messageId,\n301\t    edit,\n302\t    delete: deleted,\n303\t    healthAfterMutate: await sdk.inspect.health(ref),\n304\t    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\n305\t    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\n306\t  };\n307\t  expectOk(mutate.healthAfterMutate, \"mutate.health\");\n308\t  expectOk(mutate.messagesNotReady, \"mutate.messagesNotReady\");\n309\t  expectOk(mutate.turnsNotReady, \"mutate.turnsNotReady\");\n310\t\n311\t  // Rebuild drains: the mutations' pokes already scheduled the cascade\n312\t  // rebuilds on THIS instance's scheduler; settle is the production await.\n313\t  await sdk.drainSettled(ref);\n314\t  const rebuild = { settled: true } as const;\n315\t\n316\t  const health2 = await sdk.inspect.health(ref);\n317\t  expectOk(health2, \"health2\");\n318\t  await checkpoint(\"health2\");\n319\t\n320\t  // ── group 4: compact2 → pull2 → materialize ──\n321\t  nextGroup();\n322\t  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n323\t  expectOk(compact2, \"compact2\");\n324\t  const pull2 = await sdk.threadView.pull(ref);\n325\t  expectOk(pull2, \"pull2\");\n326\t  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\n327\t  expectOk(materialize, \"materialize\");\n328\t  await checkpoint(\"materialize\");\n329\t\n330\t  return {\n331\t    filePath,\n332\t    outPath,\n333\t    threadId,\n334\t    phases: {\n335\t      create,\n336\t      intake,\n337\t      drain,\n338\t      status,\n339\t      compact1,\n340\t      pull1,\n341\t      inspect1,\n342\t      mutate,\n343\t      rebuild,\n344\t      health2,\n345\t      compact2,\n346\t      pull2,\n347\t      materialize,\n348\t    },\n349\t  };\n350\t}\n351\t"}]},"parent_tool_use_id":null,"session_id":"63bc85b8-d520-4651-80cb-f34c66d44cc0","uuid":"0b967297-b774-442f-bfa3-e5f03a1aa26c","timestamp":"2026-06-12T21:32:37.113Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts","content":"// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\n// driven once, in PI-extension call order, against one real SDK\n// configuration with the deterministic provider — zero network, zero real\n// provider, no mocks anywhere. The script owns the sequence and the phase\n// names (tech design Flow 5); assertions live in the driving tests, so the\n// replay, teardown, and process legs all run THIS sequence rather than a\n// re-described one (DD-8).\n//\n// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\n// mutate | rebuild | health2 | compact2 | pull2 | materialize.\n//\n// Mode is background — the production posture the PI extension will run —\n// and the drain/rebuild phases settle through `drainSettled`, the real\n// background awaitable. The post-mutation health snapshot (AC-5.2's\n// \"cleared set pending\") is deterministic because every SDK operation here\n// is synchronous SQLite chained through microtasks, while a background\n// drain pass always starts on a macrotask (scheduler runLoop defers through\n// setImmediate): the edit → delete → health reads inside the mutate phase\n// run as one unbroken microtask cascade and complete before the poked drain\n// can claim its first item. The rebuild phase then yields via drainSettled\n// and the drain runs to empty.\nimport { join } from \"node:path\";\nimport {\n  createDeterministicProvider,\n  createSdk,\n  type BatchResult,\n  type CompactReceipt,\n  type FormReportEntry,\n  type HealthReport,\n  type InspectOverview,\n  type Lhc,\n  type MessageEventInput,\n  type MutationResult,\n  type OpResult,\n  type PullResult,\n  type ViewContentsReport,\n  type ViewStatus,\n} from \"../../src/index.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\n// ── the one SDK configuration (AC-5.1) ────────────────────────────\n//\n// Deterministic provider injected at construction (the only provider-arrival\n// path since the CLI retired), background mode, zero-backoff retry so a\n// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\n// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\n// a named \"lifecycle\" profile so compact runs profile-addressed (story\n// scope: \"compact (profile)\") with all three lower bands non-empty on this\n// thread (Epic 03 Story 2's reference gradient).\nexport const LIFECYCLE_PROFILE = {\n  name: \"lifecycle\",\n  lowerBound: 400,\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n} as const;\n\nexport function createLifecycleSdk(): Lhc {\n  return createSdk({\n    provider: createDeterministicProvider(),\n    mode: \"background\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n    view: {\n      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\n      // Low threshold so the status checkpoint genuinely recommends the\n      // compact the sequence performs next.\n      compactThreshold: 300,\n    },\n  });\n}\n\n// ── the recorded conversation ─────────────────────────────────────\n//\n// Same shape and text profile as the Epic 03 derived-thread fixture (12\n// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\n// policy cuts the same 4-chunk shape — but with explicit per-run\n// idempotency keys so a replay on a fresh thread records byte-identical\n// event payloads regardless of any process-global fixture counters.\nconst TURN_COUNT = 12;\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\nconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\n\n// Mutation targets: both in the post-compact tail (compact point at t9's\n// start under the lifecycle profile), so the second compact's pull shows the\n// edit verbatim and the deletion's absence — the tail is full fidelity.\nexport const EDIT_TARGET = { turnId: \"t12\", kind: \"user_prompt\" } as const;\nexport const EDITED_MESSAGE_TEXT =\n  \"turn 12 revised: drop area 12 and re-check area 5 instead\";\nexport const DELETE_TARGET = { turnId: \"t10\", kind: \"assistant_text\" } as const;\nexport const DELETED_MESSAGE_TEXT = \"findings for area 10\";\n\nfunction turnEvents(turn: number): MessageEventInput[] {\n  let seq = 0;\n  const key = (): string => {\n    seq += 1;\n    return `lc-t${turn}-e${seq}`;\n  };\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", {\n      idempotencyKey: key(),\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n    }),\n    validEvent(\"assistant_thinking\", {\n      idempotencyKey: key(),\n      payload: { text: `considering what area ${turn} contains` },\n    }),\n  ];\n  if (TOOL_HEAVY_TURNS.has(turn)) {\n    for (const run of [1, 2]) {\n      const toolCallId = `call-lc-${turn}-${run}`;\n      events.push(\n        validEvent(\"tool_call\", {\n          idempotencyKey: key(),\n          payload: {\n            toolCallId,\n            toolName: \"read_file\",\n            arguments: { path: `area-${turn}/file-${run}.txt` },\n          },\n        }),\n        validEvent(\"tool_result\", {\n          idempotencyKey: key(),\n          payload: {\n            toolCallId,\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n            isError: false,\n          },\n        }),\n      );\n    }\n  }\n  events.push(\n    validEvent(\"assistant_text\", {\n      idempotencyKey: key(),\n      payload: { text: `findings for area ${turn}` },\n    }),\n    validEvent(\"turn_end\", { idempotencyKey: key() }),\n  );\n  return events;\n}\n\nfunction intakeBatches(): MessageEventInput[][] {\n  const batches: MessageEventInput[][] = [];\n  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\n    const batch: MessageEventInput[] = [];\n    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\n      batch.push(...turnEvents(turn));\n    }\n    batches.push(batch);\n  }\n  return batches;\n}\n\n// ── run shape ─────────────────────────────────────────────────────\n\nexport interface LifecyclePhases {\n  create: OpResult<{ threadId: string; filePath: string }>;\n  intake: Array<OpResult<BatchResult>>;\n  drain: { settled: true };\n  status: OpResult<ViewStatus>;\n  compact1: OpResult<CompactReceipt>;\n  pull1: OpResult<PullResult>;\n  inspect1: {\n    overview: OpResult<InspectOverview>;\n    view: OpResult<ViewContentsReport>;\n    health: OpResult<HealthReport>;\n  };\n  mutate: {\n    editedMessageId: string;\n    deletedMessageId: string;\n    edit: OpResult<MutationResult>;\n    delete: OpResult<MutationResult>;\n    // Captured inside the mutate phase, before the background drain's first\n    // macrotask: the cleared-set-pending evidence (AC-5.2).\n    healthAfterMutate: OpResult<HealthReport>;\n    messagesNotReady: OpResult<FormReportEntry[]>;\n    turnsNotReady: OpResult<FormReportEntry[]>;\n  };\n  rebuild: { settled: true };\n  health2: OpResult<HealthReport>;\n  compact2: OpResult<CompactReceipt>;\n  pull2: OpResult<PullResult>;\n  materialize: OpResult<{ writtenPath: string }>;\n}\n\nexport type LifecycleCheckpoint = \"inspect1\" | \"health2\" | \"materialize\";\n\nexport interface LifecycleOptions {\n  // Distinguishes the thread file and materialize target so replay and\n  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\n  name?: string;\n  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\n  // render phase groups — every group boundary is a quiescent point (no\n  // queued work, no running drain), so the abandoned instance can never act\n  // after its group ends.\n  freshSdkBetweenGroups?: boolean;\n  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\n  onCheckpoint?: (\n    checkpoint: LifecycleCheckpoint,\n    ctx: { sdk: Lhc; filePath: string },\n  ) => Promise<void>;\n}\n\nexport interface LifecycleRun {\n  filePath: string;\n  outPath: string;\n  threadId: string;\n  phases: LifecyclePhases;\n}\n\nfunction expectOk<T>(result: OpResult<T>, phase: string): T {\n  if (!result.ok) {\n    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\n  }\n  return result.value;\n}\n\n// ── the sequence ──────────────────────────────────────────────────\n\nexport async function runLifecycle(\n  store: TempStore,\n  opts: LifecycleOptions = {},\n): Promise<LifecycleRun> {\n  const name = opts.name ?? \"lifecycle\";\n  const filePath = store.threadPath(name);\n  const outPath = join(store.dir, `${name}-session.jsonl`);\n  const ref = { filePath };\n\n  let sdk = createLifecycleSdk();\n  const nextGroup = (): void => {\n    // The fresh instance is the same configuration assembled again — the\n    // continuity proof is that no phase depends on the prior instance's\n    // memory, only on the thread file.\n    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\n  };\n  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\n    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\n  };\n\n  // ── group 1: create → intake → drain → status ──\n  const create = await sdk.threads.newThread({\n    filePath,\n    registryPath: store.registryPath,\n  });\n  const threadId = expectOk(create, \"create\").threadId;\n\n  const intake: Array<OpResult<BatchResult>> = [];\n  for (const batch of intakeBatches()) {\n    const sent = await sdk.intakeStream.messageEvents(ref, batch);\n    intake.push(sent);\n    expectOk(sent, \"intake\");\n  }\n\n  // Background drain settles (story scope): the intake pokes scheduled the\n  // work; this is the await that lets the scheduler run it to empty.\n  await sdk.drainSettled(ref);\n  const drain = { settled: true } as const;\n\n  const status = await sdk.threadView.status(ref);\n  expectOk(status, \"status\");\n\n  // ── group 2: compact1 → pull1 → inspect1 ──\n  nextGroup();\n  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n  expectOk(compact1, \"compact1\");\n  const pull1 = await sdk.threadView.pull(ref);\n  expectOk(pull1, \"pull1\");\n  const inspect1 = {\n    overview: await sdk.inspect.overview(ref),\n    view: await sdk.inspect.view(ref),\n    health: await sdk.inspect.health(ref),\n  };\n  expectOk(inspect1.overview, \"inspect1.overview\");\n  expectOk(inspect1.view, \"inspect1.view\");\n  expectOk(inspect1.health, \"inspect1.health\");\n  await checkpoint(\"inspect1\");\n\n  // ── group 3: mutate → rebuild → health2 ──\n  nextGroup();\n  const listed = expectOk(await sdk.messages.listMessages(ref), \"mutate.list\");\n  const editTarget = listed.find(\n    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\n  );\n  const deleteTarget = listed.find(\n    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\n  );\n  if (editTarget === undefined || deleteTarget === undefined) {\n    throw new Error(\"lifecycle invariant: edit/delete targets not found in the record\");\n  }\n  // Edit, delete, and the pending-state reads run in one microtask cascade\n  // (see module header): the snapshot is taken before the poked background\n  // drain starts its first pass.\n  const edit = await sdk.messages.edit(ref, {\n    messageId: editTarget.messageId,\n    content: EDITED_MESSAGE_TEXT,\n  });\n  expectOk(edit, \"mutate.edit\");\n  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\n  expectOk(deleted, \"mutate.delete\");\n  const mutate: LifecyclePhases[\"mutate\"] = {\n    editedMessageId: editTarget.messageId,\n    deletedMessageId: deleteTarget.messageId,\n    edit,\n    delete: deleted,\n    healthAfterMutate: await sdk.inspect.health(ref),\n    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\n    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\n  };\n  expectOk(mutate.healthAfterMutate, \"mutate.health\");\n  expectOk(mutate.messagesNotReady, \"mutate.messagesNotReady\");\n  expectOk(mutate.turnsNotReady, \"mutate.turnsNotReady\");\n\n  // Rebuild drains: the mutations' pokes already scheduled the cascade\n  // rebuilds on THIS instance's scheduler; settle is the production await.\n  await sdk.drainSettled(ref);\n  const rebuild = { settled: true } as const;\n\n  const health2 = await sdk.inspect.health(ref);\n  expectOk(health2, \"health2\");\n  await checkpoint(\"health2\");\n\n  // ── group 4: compact2 → pull2 → materialize ──\n  nextGroup();\n  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n  expectOk(compact2, \"compact2\");\n  const pull2 = await sdk.threadView.pull(ref);\n  expectOk(pull2, \"pull2\");\n  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\n  expectOk(materialize, \"materialize\");\n  await checkpoint(\"materialize\");\n\n  return {\n    filePath,\n    outPath,\n    threadId,\n    phases: {\n      create,\n      intake,\n      drain,\n      status,\n      compact1,\n      pull1,\n      inspect1,\n      mutate,\n      rebuild,\n      health2,\n      compact2,\n      pull2,\n      materialize,\n    },\n  };\n}\n","numLines":351,"startLine":1,"totalLines":351}}}

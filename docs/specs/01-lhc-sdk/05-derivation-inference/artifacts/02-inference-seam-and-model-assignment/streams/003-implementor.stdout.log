{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019Tgz9zKKLGZewaBji9mxv1","type":"tool_result","content":"1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n2\t// provider seam, and the handler contract. Both owning domains (messages,\n3\t// turns) consume these; neither owns them — the repair report, the mutation\n4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\timport type { ResolvedViewConfig, SdkViewConfig } from \"./view.js\";\n8\t\n9\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n10\t\n11\texport type FormKind =\n12\t  | \"smoothed_prompt\"\n13\t  | \"tool_call_summary\"\n14\t  | \"tool_result_summary\"\n15\t  | \"turn_rendering\"\n16\t  | \"lower_band_projection\"\n17\t  | \"chunk_summary_detailed\"\n18\t  | \"chunk_summary_brief\";\n19\t\n20\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n21\t\n22\t// Outcome on tool-activity summaries — mechanically stamped from the record\n23\t// (isError/presence), never authored by the provider (AC-2.4).\n24\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n25\t\n26\t// A composed form's record of a dependency that fell back during composition:\n27\t// names the source record and the form that was not ready (AC-3.2/3.3).\n28\texport interface DependencyGap {\n29\t  subjectKind: SubjectKind;\n30\t  subjectId: string;\n31\t  form: FormKind;\n32\t}\n33\t\n34\t// The read shape for one derived form's state row (DD-2, DD-3).\n35\texport interface DerivedForm {\n36\t  subjectKind: SubjectKind;\n37\t  subjectId: string;\n38\t  form: FormKind;\n39\t  state: DerivedFormState;\n40\t  content?: string; // ready only\n41\t  reason?: string; // failed | blocked\n42\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n43\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n44\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n45\t  derivedAt?: string;\n46\t}\n47\t\n48\t// One tool call's or result's receipt within a turn's composed account\n49\t// (AC-3.8): the account text — what changed, as composed — plus the\n50\t// mechanically derived outcome. Derived from the composition input, never\n51\t// from provider prose; stamped on the turn_rendering form so the chunk\n52\t// summaries can read receipts machine-readably in turn order.\n53\texport interface ToolRunReceipt {\n54\t  messageId: string;\n55\t  activity: \"tool_call\" | \"tool_result\";\n56\t  account: string;\n57\t  outcome: ToolOutcome;\n58\t}\n59\t\n60\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n61\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n62\t// final attempts/last-error copied from the work item before its row is\n63\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n64\t// lives here).\n65\texport interface DerivedFormMetadata {\n66\t  outcome?: ToolOutcome;\n67\t  receipts?: ToolRunReceipt[];\n68\t  attempts?: number;\n69\t  lastError?: string;\n70\t}\n71\t\n72\t// One row of an owner's repair report (Flow 4): the form's durable state\n73\t// joined with the queue's mechanical detail for the live item still working\n74\t// toward it, if any. The five operational situations read from this one row:\n75\t// never-attempted (pending, no queue), retrying (pending + queue with\n76\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n77\t// ever needs a queue API.\n78\texport interface FormReportEntry extends DerivedForm {\n79\t  queue?: {\n80\t    status: \"queued\" | \"claimed\";\n81\t    attempts: number;\n82\t    lastError?: string;\n83\t    eligibleAt?: string;\n84\t  };\n85\t}\n86\t\n87\t// ── provider seam (DD-7) ─────────────────────────────────────────\n88\t// Every operation returns content or a structured failure carrying\n89\t// retryable-or-not; classification is the adapter's duty.\n90\texport type ProviderResult =\n91\t  | { ok: true; text: string }\n92\t  | { ok: false; retryable: boolean; reason: string };\n93\t\n94\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n95\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n96\t// rather than imported: shared/ may not import domains/.\n97\texport type RenderingPartKind =\n98\t  | \"user_prompt\"\n99\t  | \"assistant_text\"\n100\t  | \"assistant_thinking\"\n101\t  | \"runtime_note\"\n102\t  | \"tool_call\"\n103\t  | \"tool_result\";\n104\t\n105\texport interface RenderingPart {\n106\t  messageId: string;\n107\t  kind: RenderingPartKind;\n108\t  text: string; // ready form content, or raw/truncated fallback\n109\t  fallback: boolean; // true ⇒ gap recorded\n110\t  outcome?: ToolOutcome; // tool activity only\n111\t}\n112\t\n113\texport interface DerivationProvider {\n114\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n115\t  summarizeToolCall(i: {\n116\t    toolName: string;\n117\t    argsJson: string;\n118\t    pairedResult?: { content: string; isError: boolean };\n119\t  }): Promise<ProviderResult>;\n120\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n121\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n122\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n123\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n124\t  // the members' tool-run receipts (what changed, outcome) alongside the\n125\t  // projections; brief receives outcomes only — receipt text is stripped\n126\t  // before the provider is called, so brief structurally cannot leak it.\n127\t  // The receipt fields are optional in the type for callers without member\n128\t  // context (the production chunk handlers always pass them).\n129\t  summarizeChunkDetailed(i: {\n130\t    memberProjections: string[];\n131\t    memberReceipts?: ToolRunReceipt[][];\n132\t  }): Promise<ProviderResult>;\n133\t  summarizeChunkBrief(i: {\n134\t    memberProjections: string[];\n135\t    memberOutcomes?: ToolOutcome[][];\n136\t  }): Promise<ProviderResult>;\n137\t}\n138\t\n139\texport const PROVIDER_OPERATIONS = [\n140\t  \"smoothPrompt\",\n141\t  \"summarizeToolCall\",\n142\t  \"summarizeToolResult\",\n143\t  \"composeTurnRendering\",\n144\t  \"projectLowerBand\",\n145\t  \"summarizeChunkDetailed\",\n146\t  \"summarizeChunkBrief\",\n147\t] as const;\n148\t\n149\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n150\t\n151\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n152\texport interface SdkConfig {\n153\t  provider: DerivationProvider;\n154\t  mode: \"background\" | \"manual\";\n155\t  clock?: () => Date;\n156\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n157\t  lease?: { durationMs: number }; // 120000\n158\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n159\t  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\n160\t}\n161\t\n162\t// Every optional filled by createSdk's central defaults.\n163\texport interface ResolvedSdkConfig {\n164\t  provider: DerivationProvider;\n165\t  mode: \"background\" | \"manual\";\n166\t  clock: () => Date;\n167\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n168\t  lease: { durationMs: number };\n169\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n170\t  view: ResolvedViewConfig;\n171\t}\n172\t\n173\t// ── handler contract (DD-6; the map's value type) ────────────────\n174\texport interface HandlerRunContext {\n175\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n176\t  provider: DerivationProvider;\n177\t  clock: () => Date;\n178\t  config: ResolvedSdkConfig;\n179\t}\n180\t\n181\t// A successful handler hands its derived-form content back as data; the\n182\t// drain's completion transaction performs the version-checked UPDATE and the\n183\t// item-row deletion atomically (tech design §Mechanics: completion is one\n184\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n185\t// never opens that transaction itself, so the version check and the\n186\t// done/stale_discarded disposition stay in one place — the queue util.\n187\texport interface HandlerFormWrite {\n188\t  subjectKind: SubjectKind;\n189\t  subjectId: string;\n190\t  form: FormKind;\n191\t  content: string;\n192\t  metadata?: DerivedFormMetadata;\n193\t  gaps?: DependencyGap[];\n194\t}\n195\t\n196\t// The completion-transaction hook (Story 3): work that must land atomically\n197\t// with the version-checked form writes — chunk placement and the\n198\t// close→summary enqueues above all. The queue util invokes it inside the\n199\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n200\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n201\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n202\t// crash leaves either a placed turn with its enqueues or nothing — never a\n203\t// derived-but-unplaced turn.\n204\texport interface CompletionTx {\n205\t  db: DatabaseSync;\n206\t  onCommit: (fn: () => void) => void;\n207\t}\n208\t\n209\texport type HandlerOutcome =\n210\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n211\t  | { ok: false; retryable: boolean; reason: string }\n212\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n213\t\n214\t// item is the queue util's WorkItemRecord; typed structurally here so the\n215\t// shared layer does not depend on the util's module (and vice versa stays\n216\t// one-directional: tech-utils imports shared).\n217\texport type WorkHandler = (\n218\t  run: HandlerRunContext,\n219\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n220\t) => Promise<HandlerOutcome>;\n221\t"}]},"parent_tool_use_id":null,"session_id":"63bc85b8-d520-4651-80cb-f34c66d44cc0","uuid":"c21c02cf-5ed4-4f04-8656-3b3d3c9d7bce","timestamp":"2026-06-12T21:31:47.223Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts","content":"// Epic 02 shared vocabulary: the derived-form state machine's types, the\n// provider seam, and the handler contract. Both owning domains (messages,\n// turns) consume these; neither owns them — the repair report, the mutation\n// cascade, and the drain all speak this vocabulary across domain lines, so it\n// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { ResolvedViewConfig, SdkViewConfig } from \"./view.js\";\n\nexport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n\nexport type FormKind =\n  | \"smoothed_prompt\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_rendering\"\n  | \"lower_band_projection\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\n\nexport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n\n// Outcome on tool-activity summaries — mechanically stamped from the record\n// (isError/presence), never authored by the provider (AC-2.4).\nexport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n\n// A composed form's record of a dependency that fell back during composition:\n// names the source record and the form that was not ready (AC-3.2/3.3).\nexport interface DependencyGap {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\n// The read shape for one derived form's state row (DD-2, DD-3).\nexport interface DerivedForm {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n  content?: string; // ready only\n  reason?: string; // failed | blocked\n  sourceVersion: number; // which version of the source this form derives from (DD-3)\n  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n  derivedAt?: string;\n}\n\n// One tool call's or result's receipt within a turn's composed account\n// (AC-3.8): the account text — what changed, as composed — plus the\n// mechanically derived outcome. Derived from the composition input, never\n// from provider prose; stamped on the turn_rendering form so the chunk\n// summaries can read receipts machine-readably in turn order.\nexport interface ToolRunReceipt {\n  messageId: string;\n  activity: \"tool_call\" | \"tool_result\";\n  account: string;\n  outcome: ToolOutcome;\n}\n\n// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n// final attempts/last-error copied from the work item before its row is\n// deleted (DD-1: the queue is not an audit table; durable outcome detail\n// lives here).\nexport interface DerivedFormMetadata {\n  outcome?: ToolOutcome;\n  receipts?: ToolRunReceipt[];\n  attempts?: number;\n  lastError?: string;\n}\n\n// One row of an owner's repair report (Flow 4): the form's durable state\n// joined with the queue's mechanical detail for the live item still working\n// toward it, if any. The five operational situations read from this one row:\n// never-attempted (pending, no queue), retrying (pending + queue with\n// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n// ever needs a queue API.\nexport interface FormReportEntry extends DerivedForm {\n  queue?: {\n    status: \"queued\" | \"claimed\";\n    attempts: number;\n    lastError?: string;\n    eligibleAt?: string;\n  };\n}\n\n// ── provider seam (DD-7) ─────────────────────────────────────────\n// Every operation returns content or a structured failure carrying\n// retryable-or-not; classification is the adapter's duty.\nexport type ProviderResult =\n  | { ok: true; text: string }\n  | { ok: false; retryable: boolean; reason: string };\n\n// Message kinds a rendering part can carry — mirrors the intake event-kind\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n// rather than imported: shared/ may not import domains/.\nexport type RenderingPartKind =\n  | \"user_prompt\"\n  | \"assistant_text\"\n  | \"assistant_thinking\"\n  | \"runtime_note\"\n  | \"tool_call\"\n  | \"tool_result\";\n\nexport interface RenderingPart {\n  messageId: string;\n  kind: RenderingPartKind;\n  text: string; // ready form content, or raw/truncated fallback\n  fallback: boolean; // true ⇒ gap recorded\n  outcome?: ToolOutcome; // tool activity only\n}\n\nexport interface DerivationProvider {\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult>;\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n  // The two summary inputs differ by contract (AC-3.8): detailed receives\n  // the members' tool-run receipts (what changed, outcome) alongside the\n  // projections; brief receives outcomes only — receipt text is stripped\n  // before the provider is called, so brief structurally cannot leak it.\n  // The receipt fields are optional in the type for callers without member\n  // context (the production chunk handlers always pass them).\n  summarizeChunkDetailed(i: {\n    memberProjections: string[];\n    memberReceipts?: ToolRunReceipt[][];\n  }): Promise<ProviderResult>;\n  summarizeChunkBrief(i: {\n    memberProjections: string[];\n    memberOutcomes?: ToolOutcome[][];\n  }): Promise<ProviderResult>;\n}\n\nexport const PROVIDER_OPERATIONS = [\n  \"smoothPrompt\",\n  \"summarizeToolCall\",\n  \"summarizeToolResult\",\n  \"composeTurnRendering\",\n  \"projectLowerBand\",\n  \"summarizeChunkDetailed\",\n  \"summarizeChunkBrief\",\n] as const;\n\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n\n// ── SDK assembly config (tech design §Interfaces) ────────────────\nexport interface SdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock?: () => Date;\n  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n  lease?: { durationMs: number }; // 120000\n  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\n}\n\n// Every optional filled by createSdk's central defaults.\nexport interface ResolvedSdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock: () => Date;\n  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  lease: { durationMs: number };\n  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n  view: ResolvedViewConfig;\n}\n\n// ── handler contract (DD-6; the map's value type) ────────────────\nexport interface HandlerRunContext {\n  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n  provider: DerivationProvider;\n  clock: () => Date;\n  config: ResolvedSdkConfig;\n}\n\n// A successful handler hands its derived-form content back as data; the\n// drain's completion transaction performs the version-checked UPDATE and the\n// item-row deletion atomically (tech design §Mechanics: completion is one\n// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n// never opens that transaction itself, so the version check and the\n// done/stale_discarded disposition stay in one place — the queue util.\nexport interface HandlerFormWrite {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  content: string;\n  metadata?: DerivedFormMetadata;\n  gaps?: DependencyGap[];\n}\n\n// The completion-transaction hook (Story 3): work that must land atomically\n// with the version-checked form writes — chunk placement and the\n// close→summary enqueues above all. The queue util invokes it inside the\n// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n// (a stale completion must not place a turn or enqueue summaries); onCommit\n// registrations flush after that COMMIT succeeds and drop on rollback, so a\n// crash leaves either a placed turn with its enqueues or nothing — never a\n// derived-but-unplaced turn.\nexport interface CompletionTx {\n  db: DatabaseSync;\n  onCommit: (fn: () => void) => void;\n}\n\nexport type HandlerOutcome =\n  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n  | { ok: false; retryable: boolean; reason: string }\n  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n\n// item is the queue util's WorkItemRecord; typed structurally here so the\n// shared layer does not depend on the util's module (and vice versa stays\n// one-directional: tech-utils imports shared).\nexport type WorkHandler = (\n  run: HandlerRunContext,\n  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n) => Promise<HandlerOutcome>;\n","numLines":221,"startLine":1,"totalLines":221}}}

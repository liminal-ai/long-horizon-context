{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015sPVUFfh7m2CaKi2qSczXe","type":"tool_result","content":"1\t// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n2\t// real intake; the multi-state and damaged-source builders then apply the\n3\t// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n4\t// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n5\t// builders wrote; Stories 2/4 confirm the states arise for real\n6\t// (coverage.md cross-story debt).\n7\timport { DatabaseSync } from \"node:sqlite\";\n8\timport {\n9\t  intakeStream,\n10\t  threads,\n11\t  type DerivedForm,\n12\t  type DerivedFormState,\n13\t  type DependencyGap,\n14\t  type FormKind,\n15\t  type Lhc,\n16\t  type MessageEventInput,\n17\t  type SubjectKind,\n18\t  type ToolOutcome,\n19\t} from \"../../src/index.js\";\n20\timport { setIntakeClock } from \"./intake-seam.js\";\n21\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n22\timport type { ProviderDouble } from \"./provider-double.js\";\n23\timport { validEvent, type TempStore } from \"./index.js\";\n24\t\n25\tasync function newThreadFile(store: TempStore): Promise<string> {\n26\t  const filePath = store.threadPath();\n27\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n28\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n29\t  return filePath;\n30\t}\n31\t\n32\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n33\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n34\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n35\t}\n36\t\n37\t// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n38\t// deterministic (t1..tn) per the turn store's id scheme.\n39\texport async function threadWithClosedTurns(\n40\t  store: TempStore,\n41\t  n: number,\n42\t): Promise<{ filePath: string; turnIds: string[] }> {\n43\t  const filePath = await newThreadFile(store);\n44\t  const turnIds: string[] = [];\n45\t  for (let i = 1; i <= n; i += 1) {\n46\t    await send(filePath, [\n47\t      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n48\t      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n49\t      validEvent(\"turn_end\"),\n50\t    ]);\n51\t    turnIds.push(`t${i}`);\n52\t  }\n53\t  return { filePath, turnIds };\n54\t}\n55\t\n56\t// One closed turn containing a tool run: call + result pair by default;\n57\t// error and missing-result variants per the epic's outcome vocabulary.\n58\texport async function threadWithToolRun(\n59\t  store: TempStore,\n60\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n61\t): Promise<{ filePath: string; turnId: string }> {\n62\t  const filePath = await newThreadFile(store);\n63\t  const batch: MessageEventInput[] = [\n64\t    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n65\t    validEvent(\"tool_call\", {\n66\t      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n67\t    }),\n68\t  ];\n69\t  if (opts.missingResult !== true) {\n70\t    batch.push(\n71\t      validEvent(\"tool_result\", {\n72\t        payload: {\n73\t          toolCallId: \"call-fixture-1\",\n74\t          content: opts.resultContent ?? \"contents of notes.txt\",\n75\t          isError: opts.isError ?? false,\n76\t        },\n77\t      }),\n78\t    );\n79\t  }\n80\t  batch.push(validEvent(\"turn_end\"));\n81\t  await send(filePath, batch);\n82\t  return { filePath, turnId: \"t1\" };\n83\t}\n84\t\n85\t// ── chunk read-back (Story 3): raw rows for boundary assertions ──\n86\t\n87\texport interface ChunkSnapshot {\n88\t  chunks: Array<{\n89\t    chunkId: string;\n90\t    chunkOrder: number;\n91\t    status: \"open\" | \"closed\";\n92\t    accumulatedProjectedTokens: number;\n93\t  }>;\n94\t  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\n95\t}\n96\t\n97\texport function readChunks(filePath: string): ChunkSnapshot {\n98\t  const db = new DatabaseSync(filePath);\n99\t  try {\n100\t    const chunks = (\n101\t      db\n102\t        .prepare(\n103\t          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n104\t           FROM chunk ORDER BY chunk_order`,\n105\t        )\n106\t        .all() as unknown as Array<{\n107\t        chunk_id: string;\n108\t        chunk_order: number | bigint;\n109\t        status: string;\n110\t        accumulated_projected_tokens: number | bigint;\n111\t      }>\n112\t    ).map((row) => ({\n113\t      chunkId: row.chunk_id,\n114\t      chunkOrder: Number(row.chunk_order),\n115\t      status: row.status as \"open\" | \"closed\",\n116\t      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n117\t    }));\n118\t    const members = (\n119\t      db\n120\t        .prepare(\n121\t          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n122\t           JOIN chunk c ON c.chunk_id = cm.chunk_id\n123\t           ORDER BY c.chunk_order, cm.member_idx`,\n124\t        )\n125\t        .all() as unknown as Array<{\n126\t        chunk_id: string;\n127\t        turn_id: string;\n128\t        member_idx: number | bigint;\n129\t      }>\n130\t    ).map((row) => ({\n131\t      chunkId: row.chunk_id,\n132\t      turnId: row.turn_id,\n133\t      memberIdx: Number(row.member_idx),\n134\t    }));\n135\t    return { chunks, members };\n136\t  } finally {\n137\t    db.close();\n138\t  }\n139\t}\n140\t\n141\t// ── derived_form read-back and the sanctioned state writer ───────\n142\t\n143\tinterface RawFormRow {\n144\t  subject_kind: string;\n145\t  subject_id: string;\n146\t  form: string;\n147\t  state: string;\n148\t  content: string | null;\n149\t  reason: string | null;\n150\t  metadata: string | null;\n151\t  source_version: number | bigint;\n152\t  gaps: string | null;\n153\t  derived_at: string | null;\n154\t}\n155\t\n156\texport function readDerivedForms(filePath: string): DerivedForm[] {\n157\t  const db = new DatabaseSync(filePath);\n158\t  try {\n159\t    const rows = db\n160\t      .prepare(\n161\t        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n162\t                source_version, gaps, derived_at\n163\t         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n164\t      )\n165\t      .all() as unknown as RawFormRow[];\n166\t    return rows.map((row) => {\n167\t      const record: DerivedForm = {\n168\t        subjectKind: row.subject_kind as SubjectKind,\n169\t        subjectId: row.subject_id,\n170\t        form: row.form as FormKind,\n171\t        state: row.state as DerivedFormState,\n172\t        sourceVersion: Number(row.source_version),\n173\t      };\n174\t      if (row.content !== null) record.content = row.content;\n175\t      if (row.reason !== null) record.reason = row.reason;\n176\t      if (row.metadata !== null) {\n177\t        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n178\t      }\n179\t      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n180\t      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n181\t      return record;\n182\t    });\n183\t  } finally {\n184\t    db.close();\n185\t  }\n186\t}\n187\t\n188\t// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n189\t// are unreachable through the SDK until the drain (Story 1) and handlers\n190\t// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n191\t// enqueue, mirroring the production completion contract.\n192\texport function setFormState(\n193\t  filePath: string,\n194\t  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n195\t  update: {\n196\t    state: DerivedFormState;\n197\t    content?: string;\n198\t    reason?: string;\n199\t    metadata?: { outcome?: ToolOutcome };\n200\t    derivedAt?: string;\n201\t  },\n202\t): void {\n203\t  const db = new DatabaseSync(filePath);\n204\t  try {\n205\t    const changed = db\n206\t      .prepare(\n207\t        `UPDATE derived_form\n208\t         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n209\t         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n210\t      )\n211\t      .run(\n212\t        update.state,\n213\t        update.content ?? null,\n214\t        update.reason ?? null,\n215\t        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n216\t        update.derivedAt ?? null,\n217\t        target.subjectKind,\n218\t        target.subjectId,\n219\t        target.form,\n220\t      );\n221\t    if (Number(changed.changes) !== 1) {\n222\t      throw new Error(\n223\t        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n224\t      );\n225\t    }\n226\t  } finally {\n227\t    db.close();\n228\t  }\n229\t}\n230\t\n231\t// ── multi-state thread: every form state in one file ─────────────\n232\t\n233\texport interface MultiStateClaim {\n234\t  subjectKind: SubjectKind;\n235\t  subjectId: string;\n236\t  form: FormKind;\n237\t  state: DerivedFormState;\n238\t}\n239\t\n240\texport async function multiStateThread(\n241\t  store: TempStore,\n242\t): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n243\t  const filePath = await newThreadFile(store);\n244\t  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n245\t  // form pending; the writes below move a subset into the other three states.\n246\t  await send(filePath, [\n247\t    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n248\t    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n249\t    validEvent(\"tool_call\", {\n250\t      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n251\t    }),\n252\t    validEvent(\"tool_result\", {\n253\t      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n254\t    }),\n255\t    validEvent(\"turn_end\"),\n256\t    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n257\t    validEvent(\"turn_end\"),\n258\t  ]);\n259\t  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n260\t  setFormState(\n261\t    filePath,\n262\t    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n263\t    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n264\t  );\n265\t  // Tool-activity outcome lives in machine-readable metadata, never inside\n266\t  // provider-authored content (FC-0.3).\n267\t  setFormState(\n268\t    filePath,\n269\t    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n270\t    {\n271\t      state: \"ready\",\n272\t      content: \"toolresult(fixture:contents of a.txt)\",\n273\t      metadata: { outcome: \"succeeded\" },\n274\t      derivedAt,\n275\t    },\n276\t  );\n277\t  setFormState(\n278\t    filePath,\n279\t    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n280\t    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n281\t  );\n282\t  setFormState(\n283\t    filePath,\n284\t    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n285\t    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n286\t  );\n287\t  return {\n288\t    filePath,\n289\t    expected: [\n290\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n291\t      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n292\t      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n293\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n294\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n295\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n296\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n297\t    ],\n298\t  };\n299\t}\n300\t\n301\t// ── damaged-source thread (Epic 01 corruption definition) ────────\n302\t\n303\t// A closed turn with its turn_derivation work queued, then the Epic 01\n304\t// two-open-turns corruption — the damage a turn handler must find and the\n305\t// intake pipeline refuses (turn_state_corrupt).\n306\texport async function damagedSourceThread(\n307\t  store: TempStore,\n308\t): Promise<{ filePath: string; turnId: string }> {\n309\t  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n310\t  // Open a second turn through real intake; the corruption writer then adds\n311\t  // another open row — two open turns, the Epic 01 invariant violation.\n312\t  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n313\t  corruptTwoOpenTurns(filePath);\n314\t  const turnId = turnIds[0];\n315\t  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n316\t  return { filePath, turnId };\n317\t}\n318\t\n319\t// ── gapped-rendering thread (TC-3.2's state, shared) ─────────────\n320\t\n321\t// TC-3.2's gapped-rendering state as one shared builder (coverage.md\n322\t// cross-story debt: TC-4.4 consumes this exact scenario; don't rebuild it by\n323\t// hand). Expects a manual-mode SDK with retry budget 3 and zero backoff:\n324\t// scripts the double to exhaust the prompt's smoothing, then drains — the\n325\t// smoothing lands failed (its work row deleted at exhaustion, DD-1) and the\n326\t// turn rendering lands ready with the recorded gap.\n327\texport const GAPPED_SMOOTHING_REASON = \"provider_failure: scripted smoothing exhaustion\";\n328\t\n329\texport async function gappedRenderingThread(\n330\t  store: TempStore,\n331\t  sdk: Lhc,\n332\t  double: ProviderDouble,\n333\t): Promise<{ filePath: string; messageId: string; turnId: string }> {\n334\t  const filePath = await newThreadFile(store);\n335\t  double.failKind(\"prompt_smoothing\", 3, {\n336\t    retryable: true,\n337\t    reason: GAPPED_SMOOTHING_REASON,\n338\t  });\n339\t  await send(filePath, [\n340\t    validEvent(\"user_prompt\", { payload: { text: \"gapped prompt\" } }),\n341\t    validEvent(\"assistant_text\", { payload: { text: \"gapped answer\" } }),\n342\t    validEvent(\"turn_end\"),\n343\t  ]);\n344\t  const drained = await sdk.work.drain({ filePath });\n345\t  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\n346\t  const forms = readDerivedForms(filePath);\n347\t  const smoothing = forms.find((f) => f.subjectId === \"m1\" && f.form === \"smoothed_prompt\");\n348\t  const rendering = forms.find((f) => f.subjectId === \"t1\" && f.form === \"turn_rendering\");\n349\t  if (\n350\t    smoothing?.state !== \"failed\" ||\n351\t    rendering?.state !== \"ready\" ||\n352\t    rendering.gaps === undefined\n353\t  ) {\n354\t    throw new Error(\n355\t      \"fixture invariant: failed smoothing under a ready, gapped rendering expected\",\n356\t    );\n357\t  }\n358\t  return { filePath, messageId: \"m1\", turnId: \"t1\" };\n359\t}\n360\t"}]},"parent_tool_use_id":null,"session_id":"63bc85b8-d520-4651-80cb-f34c66d44cc0","uuid":"35a0faee-e5a3-4d12-a089-def619c521ce","timestamp":"2026-06-12T21:33:02.612Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/threads.ts","content":"// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n// real intake; the multi-state and damaged-source builders then apply the\n// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n// builders wrote; Stories 2/4 confirm the states arise for real\n// (coverage.md cross-story debt).\nimport { DatabaseSync } from \"node:sqlite\";\nimport {\n  intakeStream,\n  threads,\n  type DerivedForm,\n  type DerivedFormState,\n  type DependencyGap,\n  type FormKind,\n  type Lhc,\n  type MessageEventInput,\n  type SubjectKind,\n  type ToolOutcome,\n} from \"../../src/index.js\";\nimport { setIntakeClock } from \"./intake-seam.js\";\nimport { corruptTwoOpenTurns } from \"./corrupt.js\";\nimport type { ProviderDouble } from \"./provider-double.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\nasync function newThreadFile(store: TempStore): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n  const result = await intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n}\n\n// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n// deterministic (t1..tn) per the turn store's id scheme.\nexport async function threadWithClosedTurns(\n  store: TempStore,\n  n: number,\n): Promise<{ filePath: string; turnIds: string[] }> {\n  const filePath = await newThreadFile(store);\n  const turnIds: string[] = [];\n  for (let i = 1; i <= n; i += 1) {\n    await send(filePath, [\n      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n      validEvent(\"turn_end\"),\n    ]);\n    turnIds.push(`t${i}`);\n  }\n  return { filePath, turnIds };\n}\n\n// One closed turn containing a tool run: call + result pair by default;\n// error and missing-result variants per the epic's outcome vocabulary.\nexport async function threadWithToolRun(\n  store: TempStore,\n  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n): Promise<{ filePath: string; turnId: string }> {\n  const filePath = await newThreadFile(store);\n  const batch: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    }),\n  ];\n  if (opts.missingResult !== true) {\n    batch.push(\n      validEvent(\"tool_result\", {\n        payload: {\n          toolCallId: \"call-fixture-1\",\n          content: opts.resultContent ?? \"contents of notes.txt\",\n          isError: opts.isError ?? false,\n        },\n      }),\n    );\n  }\n  batch.push(validEvent(\"turn_end\"));\n  await send(filePath, batch);\n  return { filePath, turnId: \"t1\" };\n}\n\n// ── chunk read-back (Story 3): raw rows for boundary assertions ──\n\nexport interface ChunkSnapshot {\n  chunks: Array<{\n    chunkId: string;\n    chunkOrder: number;\n    status: \"open\" | \"closed\";\n    accumulatedProjectedTokens: number;\n  }>;\n  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\n}\n\nexport function readChunks(filePath: string): ChunkSnapshot {\n  const db = new DatabaseSync(filePath);\n  try {\n    const chunks = (\n      db\n        .prepare(\n          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n           FROM chunk ORDER BY chunk_order`,\n        )\n        .all() as unknown as Array<{\n        chunk_id: string;\n        chunk_order: number | bigint;\n        status: string;\n        accumulated_projected_tokens: number | bigint;\n      }>\n    ).map((row) => ({\n      chunkId: row.chunk_id,\n      chunkOrder: Number(row.chunk_order),\n      status: row.status as \"open\" | \"closed\",\n      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n    }));\n    const members = (\n      db\n        .prepare(\n          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n           JOIN chunk c ON c.chunk_id = cm.chunk_id\n           ORDER BY c.chunk_order, cm.member_idx`,\n        )\n        .all() as unknown as Array<{\n        chunk_id: string;\n        turn_id: string;\n        member_idx: number | bigint;\n      }>\n    ).map((row) => ({\n      chunkId: row.chunk_id,\n      turnId: row.turn_id,\n      memberIdx: Number(row.member_idx),\n    }));\n    return { chunks, members };\n  } finally {\n    db.close();\n  }\n}\n\n// ── derived_form read-back and the sanctioned state writer ───────\n\ninterface RawFormRow {\n  subject_kind: string;\n  subject_id: string;\n  form: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\nexport function readDerivedForms(filePath: string): DerivedForm[] {\n  const db = new DatabaseSync(filePath);\n  try {\n    const rows = db\n      .prepare(\n        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n                source_version, gaps, derived_at\n         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n      )\n      .all() as unknown as RawFormRow[];\n    return rows.map((row) => {\n      const record: DerivedForm = {\n        subjectKind: row.subject_kind as SubjectKind,\n        subjectId: row.subject_id,\n        form: row.form as FormKind,\n        state: row.state as DerivedFormState,\n        sourceVersion: Number(row.source_version),\n      };\n      if (row.content !== null) record.content = row.content;\n      if (row.reason !== null) record.reason = row.reason;\n      if (row.metadata !== null) {\n        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n      }\n      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n      return record;\n    });\n  } finally {\n    db.close();\n  }\n}\n\n// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n// are unreachable through the SDK until the drain (Story 1) and handlers\n// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n// enqueue, mirroring the production completion contract.\nexport function setFormState(\n  filePath: string,\n  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n  update: {\n    state: DerivedFormState;\n    content?: string;\n    reason?: string;\n    metadata?: { outcome?: ToolOutcome };\n    derivedAt?: string;\n  },\n): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    const changed = db\n      .prepare(\n        `UPDATE derived_form\n         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n      )\n      .run(\n        update.state,\n        update.content ?? null,\n        update.reason ?? null,\n        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n        update.derivedAt ?? null,\n        target.subjectKind,\n        target.subjectId,\n        target.form,\n      );\n    if (Number(changed.changes) !== 1) {\n      throw new Error(\n        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n      );\n    }\n  } finally {\n    db.close();\n  }\n}\n\n// ── multi-state thread: every form state in one file ─────────────\n\nexport interface MultiStateClaim {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n}\n\nexport async function multiStateThread(\n  store: TempStore,\n): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n  const filePath = await newThreadFile(store);\n  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n  // form pending; the writes below move a subset into the other three states.\n  await send(filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n    }),\n    validEvent(\"turn_end\"),\n    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n  );\n  // Tool-activity outcome lives in machine-readable metadata, never inside\n  // provider-authored content (FC-0.3).\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n    {\n      state: \"ready\",\n      content: \"toolresult(fixture:contents of a.txt)\",\n      metadata: { outcome: \"succeeded\" },\n      derivedAt,\n    },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n  );\n  return {\n    filePath,\n    expected: [\n      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n    ],\n  };\n}\n\n// ── damaged-source thread (Epic 01 corruption definition) ────────\n\n// A closed turn with its turn_derivation work queued, then the Epic 01\n// two-open-turns corruption — the damage a turn handler must find and the\n// intake pipeline refuses (turn_state_corrupt).\nexport async function damagedSourceThread(\n  store: TempStore,\n): Promise<{ filePath: string; turnId: string }> {\n  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n  // Open a second turn through real intake; the corruption writer then adds\n  // another open row — two open turns, the Epic 01 invariant violation.\n  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n  corruptTwoOpenTurns(filePath);\n  const turnId = turnIds[0];\n  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n  return { filePath, turnId };\n}\n\n// ── gapped-rendering thread (TC-3.2's state, shared) ─────────────\n\n// TC-3.2's gapped-rendering state as one shared builder (coverage.md\n// cross-story debt: TC-4.4 consumes this exact scenario; don't rebuild it by\n// hand). Expects a manual-mode SDK with retry budget 3 and zero backoff:\n// scripts the double to exhaust the prompt's smoothing, then drains — the\n// smoothing lands failed (its work row deleted at exhaustion, DD-1) and the\n// turn rendering lands ready with the recorded gap.\nexport const GAPPED_SMOOTHING_REASON = \"provider_failure: scripted smoothing exhaustion\";\n\nexport async function gappedRenderingThread(\n  store: TempStore,\n  sdk: Lhc,\n  double: ProviderDouble,\n): Promise<{ filePath: string; messageId: string; turnId: string }> {\n  const filePath = await newThreadFile(store);\n  double.failKind(\"prompt_smoothing\", 3, {\n    retryable: true,\n    reason: GAPPED_SMOOTHING_REASON,\n  });\n  await send(filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"gapped prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"gapped answer\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  const drained = await sdk.work.drain({ filePath });\n  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\n  const forms = readDerivedForms(filePath);\n  const smoothing = forms.find((f) => f.subjectId === \"m1\" && f.form === \"smoothed_prompt\");\n  const rendering = forms.find((f) => f.subjectId === \"t1\" && f.form === \"turn_rendering\");\n  if (\n    smoothing?.state !== \"failed\" ||\n    rendering?.state !== \"ready\" ||\n    rendering.gaps === undefined\n  ) {\n    throw new Error(\n      \"fixture invariant: failed smoothing under a ready, gapped rendering expected\",\n    );\n  }\n  return { filePath, messageId: \"m1\", turnId: \"t1\" };\n}\n","numLines":360,"startLine":1,"totalLines":360}}}

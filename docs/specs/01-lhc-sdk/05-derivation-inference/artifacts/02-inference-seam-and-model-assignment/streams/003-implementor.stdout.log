{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TNNadKH1u6WDcG886UMxvG","type":"tool_result","content":"1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n2\t// Injected at the same seam production adapters use — dependency injection,\n3\t// not a mock of internals. Every operation returns marked, input-derived\n4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n5\t// functions of the input, so identical input to the same operation yields\n6\t// identical output across double instances, and different operations are\n7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n8\t// captureInputs) is per-instance state and never leaks across tests that\n9\t// construct their own double.\n10\timport {\n11\t  deterministicOutcomesSuffix,\n12\t  deterministicReceiptsSuffix,\n13\t  deterministicText,\n14\t  type DerivationProvider,\n15\t  type ProviderResult,\n16\t  type RenderingPart,\n17\t  type ToolOutcome,\n18\t  type ToolRunReceipt,\n19\t} from \"../../src/index.js\";\n20\t\n21\texport type ProviderOpName =\n22\t  | \"smoothPrompt\"\n23\t  | \"summarizeToolCall\"\n24\t  | \"summarizeToolResult\"\n25\t  | \"composeTurnRendering\"\n26\t  | \"projectLowerBand\"\n27\t  | \"summarizeChunkDetailed\"\n28\t  | \"summarizeChunkBrief\";\n29\t\n30\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n31\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n32\t// as the operation names themselves.\n33\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n34\t  smoothPrompt: \"smoothPrompt\",\n35\t  summarizeToolCall: \"summarizeToolCall\",\n36\t  summarizeToolResult: \"summarizeToolResult\",\n37\t  composeTurnRendering: \"composeTurnRendering\",\n38\t  projectLowerBand: \"projectLowerBand\",\n39\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n40\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n41\t  prompt_smoothing: \"smoothPrompt\",\n42\t  smoothed_prompt: \"smoothPrompt\",\n43\t  tool_call_summary: \"summarizeToolCall\",\n44\t  tool_result_summary: \"summarizeToolResult\",\n45\t  turn_rendering: \"composeTurnRendering\",\n46\t  lower_band_projection: \"projectLowerBand\",\n47\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n48\t  chunk_summary_brief: \"summarizeChunkBrief\",\n49\t};\n50\t\n51\tfunction resolveOpName(kind: string): ProviderOpName {\n52\t  const op = KIND_ALIASES[kind];\n53\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n54\t  return op;\n55\t}\n56\t\n57\tinterface FailScript {\n58\t  remaining: number;\n59\t  retryable: boolean;\n60\t  reason: string;\n61\t}\n62\t\n63\texport interface CapturedInput {\n64\t  op: ProviderOpName;\n65\t  input: unknown;\n66\t}\n67\t\n68\texport class ProviderDouble implements DerivationProvider {\n69\t  private failNextScript: FailScript | null = null;\n70\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n71\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n72\t  private capturing = false;\n73\t  private readonly captured: CapturedInput[] = [];\n74\t\n75\t  // Fail the next n calls to any operation, then succeed.\n76\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n77\t    this.failNextScript = {\n78\t      remaining: n,\n79\t      retryable: opts?.retryable ?? true,\n80\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n81\t    };\n82\t  }\n83\t\n84\t  // Fail the next n calls to one operation (kind names and op names both\n85\t  // accepted). retryable: false scripts a terminal failure.\n86\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n87\t    const op = resolveOpName(kind);\n88\t    this.failByOp.set(op, {\n89\t      remaining: n,\n90\t      retryable: opts?.retryable ?? true,\n91\t      reason: opts?.reason ?? `scripted failure (${op})`,\n92\t    });\n93\t  }\n94\t\n95\t  delayKind(kind: string, ms: number): void {\n96\t    this.delayByOp.set(resolveOpName(kind), ms);\n97\t  }\n98\t\n99\t  // Start capturing inputs; returns the live log (appended in call order).\n100\t  captureInputs(): readonly CapturedInput[] {\n101\t    this.capturing = true;\n102\t    return this.captured;\n103\t  }\n104\t\n105\t  private async run(\n106\t    op: ProviderOpName,\n107\t    input: unknown,\n108\t    text: string,\n109\t    suffix = \"\",\n110\t  ): Promise<ProviderResult> {\n111\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n112\t    const delay = this.delayByOp.get(op);\n113\t    if (delay !== undefined && delay > 0) {\n114\t      await new Promise((resolve) => setTimeout(resolve, delay));\n115\t    }\n116\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n117\t    for (const script of scripts) {\n118\t      if (script !== null && script.remaining > 0) {\n119\t        script.remaining -= 1;\n120\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n121\t      }\n122\t    }\n123\t    // Output format shared with src/providers/deterministic.ts so the double\n124\t    // and the registry's \"deterministic\" provider produce byte-identical\n125\t    // artifacts across in-process and spawned runs; the chunk-summary\n126\t    // receipt/outcome suffixes (AC-3.8) come from the same shared helpers.\n127\t    return { ok: true, text: deterministicText(op, input, text) + suffix };\n128\t  }\n129\t\n130\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n131\t    return this.run(\"smoothPrompt\", i, i.text);\n132\t  }\n133\t\n134\t  summarizeToolCall(i: {\n135\t    toolName: string;\n136\t    argsJson: string;\n137\t    pairedResult?: { content: string; isError: boolean };\n138\t  }): Promise<ProviderResult> {\n139\t    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n140\t  }\n141\t\n142\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n143\t    return this.run(\"summarizeToolResult\", i, i.content);\n144\t  }\n145\t\n146\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n147\t    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n148\t  }\n149\t\n150\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n151\t    return this.run(\"projectLowerBand\", i, i.rendering);\n152\t  }\n153\t\n154\t  summarizeChunkDetailed(i: {\n155\t    memberProjections: string[];\n156\t    memberReceipts?: ToolRunReceipt[][];\n157\t  }): Promise<ProviderResult> {\n158\t    return this.run(\n159\t      \"summarizeChunkDetailed\",\n160\t      i,\n161\t      i.memberProjections.join(\" | \"),\n162\t      deterministicReceiptsSuffix(i.memberReceipts),\n163\t    );\n164\t  }\n165\t\n166\t  summarizeChunkBrief(i: {\n167\t    memberProjections: string[];\n168\t    memberOutcomes?: ToolOutcome[][];\n169\t  }): Promise<ProviderResult> {\n170\t    return this.run(\n171\t      \"summarizeChunkBrief\",\n172\t      i,\n173\t      i.memberProjections.join(\" | \"),\n174\t      deterministicOutcomesSuffix(i.memberOutcomes),\n175\t    );\n176\t  }\n177\t}\n178\t\n179\texport function createProviderDouble(): ProviderDouble {\n180\t  return new ProviderDouble();\n181\t}\n182\t"}]},"parent_tool_use_id":null,"session_id":"63bc85b8-d520-4651-80cb-f34c66d44cc0","uuid":"ddb17469-8e58-4353-a536-626312fa0ee1","timestamp":"2026-06-12T21:32:15.445Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/provider-double.ts","content":"// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n// Injected at the same seam production adapters use — dependency injection,\n// not a mock of internals. Every operation returns marked, input-derived\n// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n// functions of the input, so identical input to the same operation yields\n// identical output across double instances, and different operations are\n// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n// captureInputs) is per-instance state and never leaks across tests that\n// construct their own double.\nimport {\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DerivationProvider,\n  type ProviderResult,\n  type RenderingPart,\n  type ToolOutcome,\n  type ToolRunReceipt,\n} from \"../../src/index.js\";\n\nexport type ProviderOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\n// Tests script by work-kind / form-kind vocabulary (the test plan writes\n// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n// as the operation names themselves.\nconst KIND_ALIASES: Record<string, ProviderOpName> = {\n  smoothPrompt: \"smoothPrompt\",\n  summarizeToolCall: \"summarizeToolCall\",\n  summarizeToolResult: \"summarizeToolResult\",\n  composeTurnRendering: \"composeTurnRendering\",\n  projectLowerBand: \"projectLowerBand\",\n  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n  summarizeChunkBrief: \"summarizeChunkBrief\",\n  prompt_smoothing: \"smoothPrompt\",\n  smoothed_prompt: \"smoothPrompt\",\n  tool_call_summary: \"summarizeToolCall\",\n  tool_result_summary: \"summarizeToolResult\",\n  turn_rendering: \"composeTurnRendering\",\n  lower_band_projection: \"projectLowerBand\",\n  chunk_summary_detailed: \"summarizeChunkDetailed\",\n  chunk_summary_brief: \"summarizeChunkBrief\",\n};\n\nfunction resolveOpName(kind: string): ProviderOpName {\n  const op = KIND_ALIASES[kind];\n  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n  return op;\n}\n\ninterface FailScript {\n  remaining: number;\n  retryable: boolean;\n  reason: string;\n}\n\nexport interface CapturedInput {\n  op: ProviderOpName;\n  input: unknown;\n}\n\nexport class ProviderDouble implements DerivationProvider {\n  private failNextScript: FailScript | null = null;\n  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n  private readonly delayByOp = new Map<ProviderOpName, number>();\n  private capturing = false;\n  private readonly captured: CapturedInput[] = [];\n\n  // Fail the next n calls to any operation, then succeed.\n  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    this.failNextScript = {\n      remaining: n,\n      retryable: opts?.retryable ?? true,\n      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    };\n  }\n\n  // Fail the next n calls to one operation (kind names and op names both\n  // accepted). retryable: false scripts a terminal failure.\n  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    const op = resolveOpName(kind);\n    this.failByOp.set(op, {\n      remaining: n,\n      retryable: opts?.retryable ?? true,\n      reason: opts?.reason ?? `scripted failure (${op})`,\n    });\n  }\n\n  delayKind(kind: string, ms: number): void {\n    this.delayByOp.set(resolveOpName(kind), ms);\n  }\n\n  // Start capturing inputs; returns the live log (appended in call order).\n  captureInputs(): readonly CapturedInput[] {\n    this.capturing = true;\n    return this.captured;\n  }\n\n  private async run(\n    op: ProviderOpName,\n    input: unknown,\n    text: string,\n    suffix = \"\",\n  ): Promise<ProviderResult> {\n    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n    const delay = this.delayByOp.get(op);\n    if (delay !== undefined && delay > 0) {\n      await new Promise((resolve) => setTimeout(resolve, delay));\n    }\n    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n    for (const script of scripts) {\n      if (script !== null && script.remaining > 0) {\n        script.remaining -= 1;\n        return { ok: false, retryable: script.retryable, reason: script.reason };\n      }\n    }\n    // Output format shared with src/providers/deterministic.ts so the double\n    // and the registry's \"deterministic\" provider produce byte-identical\n    // artifacts across in-process and spawned runs; the chunk-summary\n    // receipt/outcome suffixes (AC-3.8) come from the same shared helpers.\n    return { ok: true, text: deterministicText(op, input, text) + suffix };\n  }\n\n  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n    return this.run(\"smoothPrompt\", i, i.text);\n  }\n\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult> {\n    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n  }\n\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n    return this.run(\"summarizeToolResult\", i, i.content);\n  }\n\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n  }\n\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n    return this.run(\"projectLowerBand\", i, i.rendering);\n  }\n\n  summarizeChunkDetailed(i: {\n    memberProjections: string[];\n    memberReceipts?: ToolRunReceipt[][];\n  }): Promise<ProviderResult> {\n    return this.run(\n      \"summarizeChunkDetailed\",\n      i,\n      i.memberProjections.join(\" | \"),\n      deterministicReceiptsSuffix(i.memberReceipts),\n    );\n  }\n\n  summarizeChunkBrief(i: {\n    memberProjections: string[];\n    memberOutcomes?: ToolOutcome[][];\n  }): Promise<ProviderResult> {\n    return this.run(\n      \"summarizeChunkBrief\",\n      i,\n      i.memberProjections.join(\" | \"),\n      deterministicOutcomesSuffix(i.memberOutcomes),\n    );\n  }\n}\n\nexport function createProviderDouble(): ProviderDouble {\n  return new ProviderDouble();\n}\n","numLines":182,"startLine":1,"totalLines":182}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K7xaqZ2hokwtGSDNaUFQNy","type":"tool_result","content":"1\t// Visibility boundary (Epic 03 Stories 1 + 4, decision reshaped by Epic 05\n2\t// Story 6). The boundary is a source event order shared with the compact\n3\t// point's coordinate system; tool results at-or-behind it render short. Its\n4\t// writers are exactly two: the post-commit advance below — gated by intake\n5\t// to turn-end batches since Epic 05 — and compact's reset, which lands\n6\t// inside compact's own transaction (snapshot.ts, Story 2).\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport type { VisibilityBudgets } from \"../../../shared/view.js\";\n9\t\n10\t// The singleton row exists from migration v6 on (seeded at position 0,\n11\t// everything full). A missing row is a damaged thread file, surfaced as a\n12\t// throw for the operation boundary's storage_failure wrap.\n13\texport function readBoundaryPosition(db: DatabaseSync): number {\n14\t  const row = db\n15\t    .prepare(`SELECT position FROM view_boundary WHERE thread_singleton = 1`)\n16\t    .get() as { position: number | bigint } | undefined;\n17\t  if (row === undefined) {\n18\t    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\n19\t  }\n20\t  return Number(row.position);\n21\t}\n22\t\n23\t// The visibility zone's token sum: live (deleted-filtered) tool results ahead\n24\t// of both the boundary position and the compact point, one indexed query.\n25\t// Parameterized by position on purpose (story Technical Notes): Story 4's\n26\t// advance consumes this same function instead of re-deriving the sum, so\n27\t// \"the advance's sum equals what status reports\" is structural — the design\n28\t// requires the two sums equal, and sharing the query makes that a fact of\n29\t// the code rather than a discipline.\n30\texport function visibilityZoneTokens(\n31\t  db: DatabaseSync,\n32\t  position: number,\n33\t  compactPoint: number,\n34\t): number {\n35\t  const row = db\n36\t    .prepare(\n37\t      `SELECT COALESCE(SUM(token_estimate), 0) AS zone FROM message\n38\t       WHERE kind = 'tool_result' AND deleted_at IS NULL\n39\t         AND source_event_order > ? AND source_event_order > ?`,\n40\t    )\n41\t    .get(position, compactPoint) as { zone: number | bigint };\n42\t  return Number(row.zone);\n43\t}\n44\t\n45\t// ── the post-commit advance (Story 4, AC-4.3–4.6, 4.9) ───────────\n46\t\n47\t// The compact point for the advance's zone predicate: the stored view's, or\n48\t// the zero origin when the thread has never compacted — the same default the\n49\t// pull uses, read without dragging band bytes along.\n50\tfunction readCompactPoint(db: DatabaseSync): number {\n51\t  const row = db\n52\t    .prepare(`SELECT compact_point FROM thread_view WHERE singleton = 1`)\n53\t    .get() as { compact_point: number | bigint } | undefined;\n54\t  return row === undefined ? 0 : Number(row.compact_point);\n55\t}\n56\t\n57\t// One zone member as the decision walks it. Rows come back oldest-first by\n58\t// source event order — the flip order AC-4.3 pins. turn_id carries the\n59\t// whole-turn grouping key (Epic 05 AC-5.2); NULL means turnless intake.\n60\texport interface ZoneToolResult {\n61\t  sourceEventOrder: number;\n62\t  tokenEstimate: number;\n63\t  turnId: string | null;\n64\t}\n65\t\n66\t// The zone's member rows: the same population visibilityZoneTokens sums —\n67\t// identical WHERE clause on purpose, so the decision's arithmetic and the\n68\t// status read's sum can never diverge (story Technical Notes; the amended\n69\t// boundary suite's status assertions are the canary).\n70\tfunction readZoneToolResults(\n71\t  db: DatabaseSync,\n72\t  position: number,\n73\t  compactPoint: number,\n74\t): ZoneToolResult[] {\n75\t  const rows = db\n76\t    .prepare(\n77\t      `SELECT source_event_order, token_estimate, turn_id FROM message\n78\t       WHERE kind = 'tool_result' AND deleted_at IS NULL\n79\t         AND source_event_order > ? AND source_event_order > ?\n80\t       ORDER BY source_event_order`,\n81\t    )\n82\t    .all(position, compactPoint) as unknown as Array<{\n83\t    source_event_order: number | bigint;\n84\t    token_estimate: number | bigint;\n85\t    turn_id: string | null;\n86\t  }>;\n87\t  return rows.map((row) => ({\n88\t    sourceEventOrder: Number(row.source_event_order),\n89\t    tokenEstimate: Number(row.token_estimate),\n90\t    turnId: row.turn_id,\n91\t  }));\n92\t}\n93\t\n94\t// The open turn, if any, read for eviction candidacy: its tool results count\n95\t// in the zone sum (status must show a mid-turn over-budget condition) but its\n96\t// group can never be evicted. With the turn-end trigger this is normally\n97\t// vacuous — the just-closed turn left nothing open — but a batch may legally\n98\t// record a turn_end and then open a new turn with tool results before\n99\t// committing, and that open turn must not be eaten (Epic 05 AC-5.3's\n100\t// open-turn untouchability, made explicit rather than assumed).\n101\tfunction readOpenTurnId(db: DatabaseSync): string | null {\n102\t  const row = db\n103\t    .prepare(`SELECT turn_id FROM turns WHERE status = 'open' AND deleted_at IS NULL LIMIT 1`)\n104\t    .get() as { turn_id: string } | undefined;\n105\t  return row?.turn_id ?? null;\n106\t}\n107\t\n108\t// One whole-turn eviction unit (Epic 05 DD-10): consecutive zone rows sharing\n109\t// a turn_id. A NULL turn_id row is its own singleton group — whole-turn\n110\t// semantics degenerate to whole-message for messages belonging to no turn.\n111\texport interface ZoneTurnGroup {\n112\t  turnId: string | null;\n113\t  tokenSum: number;\n114\t  // Highest source_event_order in the group: the boundary position an\n115\t  // eviction of this group lands on.\n116\t  lastSourceEventOrder: number;\n117\t}\n118\t\n119\texport function groupZone(zone: readonly ZoneToolResult[]): ZoneTurnGroup[] {\n120\t  const groups: ZoneTurnGroup[] = [];\n121\t  for (const result of zone) {\n122\t    const current = groups[groups.length - 1];\n123\t    if (current !== undefined && current.turnId !== null && current.turnId === result.turnId) {\n124\t      current.tokenSum += result.tokenEstimate;\n125\t      current.lastSourceEventOrder = result.sourceEventOrder;\n126\t    } else {\n127\t      groups.push({\n128\t        turnId: result.turnId,\n129\t        tokenSum: result.tokenEstimate,\n130\t        lastSourceEventOrder: result.sourceEventOrder,\n131\t      });\n132\t    }\n133\t  }\n134\t  return groups;\n135\t}\n136\t\n137\t// The pure decision (Epic 05 tech design §Flow 5): token sums from stored\n138\t// per-message estimates, no inference, no IO — same inputs, same answer\n139\t// (AC-5.5 determinism; the re-cut Boundary G1 golden drives the arithmetic,\n140\t// golden G2 the peek-ahead landing).\n141\t//\n142\t// Zone is the turn-grouped tool results oldest-first. Under-or-at max the\n143\t// boundary does not move. Over max, walk candidate groups oldest-first — the\n144\t// open turn's group (when one exists) is never a candidate, and the walk stops\n145\t// before the newest closed turn so that turn and everything after it (any\n146\t// trailing turnless singletons recorded after its close) are never evicted\n147\t// (AC-5.3: the newest closed turn is never evicted). The boundary lands on a\n148\t// group's last source event order, so an eviction reaching the newest closed\n149\t// turn — or any group past it — would render that turn short; stopping before\n150\t// it keeps it intact even when a later turnless singleton sits in the zone.\n151\t// With no closed turn present the newest remaining group is protected instead\n152\t// (whole-message degeneration for a turnless-only zone). A group is evicted\n153\t// only if the zone's sum after evicting it remains at-or-above target (the\n154\t// peek-ahead stop). The advance therefore lands in [target, target + one\n155\t// group), and the zone may legally sit above target or even max until a newer\n156\t// turn closes or a compact creates room.\n157\texport function advanceDecision(\n158\t  groups: readonly ZoneTurnGroup[],\n159\t  budgets: VisibilityBudgets,\n160\t  openTurnId: string | null,\n161\t): number | null {\n162\t  let total = 0;\n163\t  for (const group of groups) total += group.tokenSum;\n164\t  if (total <= budgets.maxTokens) return null;\n165\t\n166\t  // The open turn's group is never evictable; its tokens still count in the sum.\n167\t  const candidates = groups.filter(\n168\t    (group) => group.turnId === null || group.turnId !== openTurnId,\n169\t  );\n170\t\n171\t  // Stop the walk before the newest closed turn — the last candidate carrying a\n172\t  // turn_id. It and everything after it (the turn itself plus any trailing\n173\t  // turnless singletons) are protected: the boundary lands on a group's last\n174\t  // order, so any landing there or beyond would flip the newest closed turn\n175\t  // short. With no closed turn in the zone, fall back to protecting the newest\n176\t  // candidate group (the turnless-only whole-message behavior).\n177\t  let stop = candidates.length - 1;\n178\t  for (let i = candidates.length - 1; i >= 0; i -= 1) {\n179\t    if (candidates[i]?.turnId !== null) {\n180\t      stop = i;\n181\t      break;\n182\t    }\n183\t  }\n184\t\n185\t  let remaining = total;\n186\t  let newPosition: number | null = null;\n187\t  for (let i = 0; i < stop; i += 1) {\n188\t    const group = candidates[i];\n189\t    if (group === undefined) break;\n190\t    if (remaining - group.tokenSum < budgets.targetTokens) break;\n191\t    remaining -= group.tokenSum;\n192\t    newPosition = group.lastSourceEventOrder;\n193\t  }\n194\t  return newPosition;\n195\t}\n196\t\n197\t// The advance executor: indexed sum → over max ⇒ decide → write the new\n198\t// position in its own short transaction (never inside intake's — AC-4.9's\n199\t// isolation; this runs at flush, strictly after intake's COMMIT). The\n200\t// position-forward guard in the UPDATE makes never-backward (AC-4.6) a\n201\t// property of the write, not just of the decision's inputs.\n202\texport function executeBoundaryAdvance(\n203\t  db: DatabaseSync,\n204\t  budgets: VisibilityBudgets,\n205\t  clock: () => Date,\n206\t): void {\n207\t  const position = readBoundaryPosition(db);\n208\t  const compactPoint = readCompactPoint(db);\n209\t  if (visibilityZoneTokens(db, position, compactPoint) <= budgets.maxTokens) return;\n210\t\n211\t  const zone = readZoneToolResults(db, position, compactPoint);\n212\t  const newPosition = advanceDecision(groupZone(zone), budgets, readOpenTurnId(db));\n213\t  if (newPosition === null || newPosition <= position) return;\n214\t\n215\t  db.exec(\"BEGIN IMMEDIATE;\");\n216\t  try {\n217\t    db.prepare(\n218\t      `UPDATE view_boundary SET position = ?, updated_at = ?\n219\t       WHERE thread_singleton = 1 AND position < ?`,\n220\t    ).run(newPosition, clock().toISOString(), newPosition);\n221\t    db.exec(\"COMMIT;\");\n222\t  } catch (cause) {\n223\t    db.exec(\"ROLLBACK;\");\n224\t    throw cause;\n225\t  }\n226\t}\n227\t"}]},"parent_tool_use_id":null,"session_id":"c6fd1fc9-717e-4718-8050-43c47347ff45","uuid":"68a1c117-fdd7-4c92-95d3-ddaace1e8436","timestamp":"2026-06-13T00:13:55.576Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/boundary.ts","content":"// Visibility boundary (Epic 03 Stories 1 + 4, decision reshaped by Epic 05\n// Story 6). The boundary is a source event order shared with the compact\n// point's coordinate system; tool results at-or-behind it render short. Its\n// writers are exactly two: the post-commit advance below — gated by intake\n// to turn-end batches since Epic 05 — and compact's reset, which lands\n// inside compact's own transaction (snapshot.ts, Story 2).\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { VisibilityBudgets } from \"../../../shared/view.js\";\n\n// The singleton row exists from migration v6 on (seeded at position 0,\n// everything full). A missing row is a damaged thread file, surfaced as a\n// throw for the operation boundary's storage_failure wrap.\nexport function readBoundaryPosition(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT position FROM view_boundary WHERE thread_singleton = 1`)\n    .get() as { position: number | bigint } | undefined;\n  if (row === undefined) {\n    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\n  }\n  return Number(row.position);\n}\n\n// The visibility zone's token sum: live (deleted-filtered) tool results ahead\n// of both the boundary position and the compact point, one indexed query.\n// Parameterized by position on purpose (story Technical Notes): Story 4's\n// advance consumes this same function instead of re-deriving the sum, so\n// \"the advance's sum equals what status reports\" is structural — the design\n// requires the two sums equal, and sharing the query makes that a fact of\n// the code rather than a discipline.\nexport function visibilityZoneTokens(\n  db: DatabaseSync,\n  position: number,\n  compactPoint: number,\n): number {\n  const row = db\n    .prepare(\n      `SELECT COALESCE(SUM(token_estimate), 0) AS zone FROM message\n       WHERE kind = 'tool_result' AND deleted_at IS NULL\n         AND source_event_order > ? AND source_event_order > ?`,\n    )\n    .get(position, compactPoint) as { zone: number | bigint };\n  return Number(row.zone);\n}\n\n// ── the post-commit advance (Story 4, AC-4.3–4.6, 4.9) ───────────\n\n// The compact point for the advance's zone predicate: the stored view's, or\n// the zero origin when the thread has never compacted — the same default the\n// pull uses, read without dragging band bytes along.\nfunction readCompactPoint(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT compact_point FROM thread_view WHERE singleton = 1`)\n    .get() as { compact_point: number | bigint } | undefined;\n  return row === undefined ? 0 : Number(row.compact_point);\n}\n\n// One zone member as the decision walks it. Rows come back oldest-first by\n// source event order — the flip order AC-4.3 pins. turn_id carries the\n// whole-turn grouping key (Epic 05 AC-5.2); NULL means turnless intake.\nexport interface ZoneToolResult {\n  sourceEventOrder: number;\n  tokenEstimate: number;\n  turnId: string | null;\n}\n\n// The zone's member rows: the same population visibilityZoneTokens sums —\n// identical WHERE clause on purpose, so the decision's arithmetic and the\n// status read's sum can never diverge (story Technical Notes; the amended\n// boundary suite's status assertions are the canary).\nfunction readZoneToolResults(\n  db: DatabaseSync,\n  position: number,\n  compactPoint: number,\n): ZoneToolResult[] {\n  const rows = db\n    .prepare(\n      `SELECT source_event_order, token_estimate, turn_id FROM message\n       WHERE kind = 'tool_result' AND deleted_at IS NULL\n         AND source_event_order > ? AND source_event_order > ?\n       ORDER BY source_event_order`,\n    )\n    .all(position, compactPoint) as unknown as Array<{\n    source_event_order: number | bigint;\n    token_estimate: number | bigint;\n    turn_id: string | null;\n  }>;\n  return rows.map((row) => ({\n    sourceEventOrder: Number(row.source_event_order),\n    tokenEstimate: Number(row.token_estimate),\n    turnId: row.turn_id,\n  }));\n}\n\n// The open turn, if any, read for eviction candidacy: its tool results count\n// in the zone sum (status must show a mid-turn over-budget condition) but its\n// group can never be evicted. With the turn-end trigger this is normally\n// vacuous — the just-closed turn left nothing open — but a batch may legally\n// record a turn_end and then open a new turn with tool results before\n// committing, and that open turn must not be eaten (Epic 05 AC-5.3's\n// open-turn untouchability, made explicit rather than assumed).\nfunction readOpenTurnId(db: DatabaseSync): string | null {\n  const row = db\n    .prepare(`SELECT turn_id FROM turns WHERE status = 'open' AND deleted_at IS NULL LIMIT 1`)\n    .get() as { turn_id: string } | undefined;\n  return row?.turn_id ?? null;\n}\n\n// One whole-turn eviction unit (Epic 05 DD-10): consecutive zone rows sharing\n// a turn_id. A NULL turn_id row is its own singleton group — whole-turn\n// semantics degenerate to whole-message for messages belonging to no turn.\nexport interface ZoneTurnGroup {\n  turnId: string | null;\n  tokenSum: number;\n  // Highest source_event_order in the group: the boundary position an\n  // eviction of this group lands on.\n  lastSourceEventOrder: number;\n}\n\nexport function groupZone(zone: readonly ZoneToolResult[]): ZoneTurnGroup[] {\n  const groups: ZoneTurnGroup[] = [];\n  for (const result of zone) {\n    const current = groups[groups.length - 1];\n    if (current !== undefined && current.turnId !== null && current.turnId === result.turnId) {\n      current.tokenSum += result.tokenEstimate;\n      current.lastSourceEventOrder = result.sourceEventOrder;\n    } else {\n      groups.push({\n        turnId: result.turnId,\n        tokenSum: result.tokenEstimate,\n        lastSourceEventOrder: result.sourceEventOrder,\n      });\n    }\n  }\n  return groups;\n}\n\n// The pure decision (Epic 05 tech design §Flow 5): token sums from stored\n// per-message estimates, no inference, no IO — same inputs, same answer\n// (AC-5.5 determinism; the re-cut Boundary G1 golden drives the arithmetic,\n// golden G2 the peek-ahead landing).\n//\n// Zone is the turn-grouped tool results oldest-first. Under-or-at max the\n// boundary does not move. Over max, walk candidate groups oldest-first — the\n// open turn's group (when one exists) is never a candidate, and the walk stops\n// before the newest closed turn so that turn and everything after it (any\n// trailing turnless singletons recorded after its close) are never evicted\n// (AC-5.3: the newest closed turn is never evicted). The boundary lands on a\n// group's last source event order, so an eviction reaching the newest closed\n// turn — or any group past it — would render that turn short; stopping before\n// it keeps it intact even when a later turnless singleton sits in the zone.\n// With no closed turn present the newest remaining group is protected instead\n// (whole-message degeneration for a turnless-only zone). A group is evicted\n// only if the zone's sum after evicting it remains at-or-above target (the\n// peek-ahead stop). The advance therefore lands in [target, target + one\n// group), and the zone may legally sit above target or even max until a newer\n// turn closes or a compact creates room.\nexport function advanceDecision(\n  groups: readonly ZoneTurnGroup[],\n  budgets: VisibilityBudgets,\n  openTurnId: string | null,\n): number | null {\n  let total = 0;\n  for (const group of groups) total += group.tokenSum;\n  if (total <= budgets.maxTokens) return null;\n\n  // The open turn's group is never evictable; its tokens still count in the sum.\n  const candidates = groups.filter(\n    (group) => group.turnId === null || group.turnId !== openTurnId,\n  );\n\n  // Stop the walk before the newest closed turn — the last candidate carrying a\n  // turn_id. It and everything after it (the turn itself plus any trailing\n  // turnless singletons) are protected: the boundary lands on a group's last\n  // order, so any landing there or beyond would flip the newest closed turn\n  // short. With no closed turn in the zone, fall back to protecting the newest\n  // candidate group (the turnless-only whole-message behavior).\n  let stop = candidates.length - 1;\n  for (let i = candidates.length - 1; i >= 0; i -= 1) {\n    if (candidates[i]?.turnId !== null) {\n      stop = i;\n      break;\n    }\n  }\n\n  let remaining = total;\n  let newPosition: number | null = null;\n  for (let i = 0; i < stop; i += 1) {\n    const group = candidates[i];\n    if (group === undefined) break;\n    if (remaining - group.tokenSum < budgets.targetTokens) break;\n    remaining -= group.tokenSum;\n    newPosition = group.lastSourceEventOrder;\n  }\n  return newPosition;\n}\n\n// The advance executor: indexed sum → over max ⇒ decide → write the new\n// position in its own short transaction (never inside intake's — AC-4.9's\n// isolation; this runs at flush, strictly after intake's COMMIT). The\n// position-forward guard in the UPDATE makes never-backward (AC-4.6) a\n// property of the write, not just of the decision's inputs.\nexport function executeBoundaryAdvance(\n  db: DatabaseSync,\n  budgets: VisibilityBudgets,\n  clock: () => Date,\n): void {\n  const position = readBoundaryPosition(db);\n  const compactPoint = readCompactPoint(db);\n  if (visibilityZoneTokens(db, position, compactPoint) <= budgets.maxTokens) return;\n\n  const zone = readZoneToolResults(db, position, compactPoint);\n  const newPosition = advanceDecision(groupZone(zone), budgets, readOpenTurnId(db));\n  if (newPosition === null || newPosition <= position) return;\n\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    db.prepare(\n      `UPDATE view_boundary SET position = ?, updated_at = ?\n       WHERE thread_singleton = 1 AND position < ?`,\n    ).run(newPosition, clock().toISOString(), newPosition);\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n","numLines":227,"startLine":1,"totalLines":227}}}

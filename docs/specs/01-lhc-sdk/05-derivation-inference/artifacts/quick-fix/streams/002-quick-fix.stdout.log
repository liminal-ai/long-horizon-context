{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Q96kPrea6fMuB1tpjkkJm","type":"tool_result","content":"1\t// Epic 05 Story 6: the turn-end boundary advance (TC-5.1–TC-5.3). The Epic 03\n2\t// advance trigger moves from every intake commit to turn close; eviction\n3\t// becomes whole-turn, oldest-first, with a peek-ahead stop and a never-evicted\n4\t// newest closed turn; the floor budget is retired (two-field config, 64k/32k\n5\t// defaults). Every advance here fires through a REAL `intake.messageEvents`\n6\t// commit — no host-called advance surface exists and no test invents one;\n7\t// rendering is proven through real `pull` calls.\n8\timport { afterEach, describe, expect, it } from \"vitest\";\n9\timport { createSdk, type Lhc, type SdkViewConfig } from \"../src/index.js\";\n10\timport {\n11\t  boundaryTokens,\n12\t  createProviderDouble,\n13\t  seedTurnedToolResults,\n14\t  setViewInjectionHook,\n15\t  tempStore,\n16\t  turnedToolResultEvents,\n17\t  validEvent,\n18\t  type TempStore,\n19\t} from \"./fixtures/index.js\";\n20\t\n21\t// The story's small test budgets: max 100 > target 60 (AC-5.4 ordering); the\n22\t// G2 leg runs the 64k/32k defaults instead.\n23\tconst BUDGETS = { maxTokens: 100, targetTokens: 60 };\n24\t\n25\tconst stores: TempStore[] = [];\n26\tafterEach(() => {\n27\t  setViewInjectionHook(\"post-commit-advance\", null);\n28\t  for (const store of stores.splice(0)) store.cleanup();\n29\t});\n30\t\n31\tfunction visSdk(view: SdkViewConfig = { visibility: BUDGETS }): Lhc {\n32\t  return createSdk({ provider: createProviderDouble(), mode: \"manual\", view });\n33\t}\n34\t\n35\tasync function newThread(sdk: Lhc): Promise<string> {\n36\t  const store = tempStore();\n37\t  stores.push(store);\n38\t  const filePath = store.threadPath();\n39\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n40\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n41\t  return filePath;\n42\t}\n43\t\n44\tasync function boundaryOf(sdk: Lhc, filePath: string): Promise<number> {\n45\t  const pulled = await sdk.threadView.pull({ filePath });\n46\t  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n47\t  return pulled.value.meta.boundaryPosition;\n48\t}\n49\t\n50\tasync function zoneTokensOf(sdk: Lhc, filePath: string): Promise<number> {\n51\t  const status = await sdk.threadView.status({ filePath });\n52\t  if (!status.ok) throw new Error(`status failed: ${status.error.reason}`);\n53\t  return status.value.visibility.zoneTokens;\n54\t}\n55\t\n56\tinterface ResultRow {\n57\t  messageId: string;\n58\t  sourceEventOrder: number;\n59\t  tokenEstimate: number;\n60\t  turnId: string | null;\n61\t}\n62\t\n63\tasync function toolResults(sdk: Lhc, filePath: string): Promise<ResultRow[]> {\n64\t  const listed = await sdk.messages.listMessages({ filePath });\n65\t  if (!listed.ok) throw new Error(`listMessages failed: ${listed.error.reason}`);\n66\t  return listed.value\n67\t    .filter((m) => m.kind === \"tool_result\")\n68\t    .map((m) => ({\n69\t      messageId: m.messageId,\n70\t      sourceEventOrder: m.sourceEventOrder,\n71\t      tokenEstimate: m.tokenEstimate,\n72\t      turnId: m.turnId ?? null,\n73\t    }));\n74\t}\n75\t\n76\tfunction abridgedCount(messages: ReadonlyArray<{ content: string }>): number {\n77\t  return messages.filter(\n78\t    (m) => m.content.startsWith(\"[tool result · \") && m.content.includes(\" · abridged]\"),\n79\t  ).length;\n80\t}\n81\t\n82\t// Per-turn all-or-nothing (AC-5.2): with the boundary at `position`, every\n83\t// turn's results sit uniformly at-or-behind it or uniformly ahead of it —\n84\t// no turn is ever partially flipped.\n85\tfunction expectNoPartialTurn(results: readonly ResultRow[], position: number): void {\n86\t  const byTurn = new Map<string, boolean[]>();\n87\t  for (const r of results) {\n88\t    if (r.turnId === null) continue; // turnless: a singleton is whole by construction\n89\t    const flips = byTurn.get(r.turnId) ?? [];\n90\t    flips.push(r.sourceEventOrder <= position);\n91\t    byTurn.set(r.turnId, flips);\n92\t  }\n93\t  for (const [turnId, flips] of byTurn) {\n94\t    const flipped = flips.filter(Boolean).length;\n95\t    expect(\n96\t      flipped === 0 || flipped === flips.length,\n97\t      `turn ${turnId} is partially flipped (${flipped}/${flips.length})`,\n98\t    ).toBe(true);\n99\t  }\n100\t}\n101\t\n102\t// A counting (non-throwing) hook on the Story-0 injection point: it fires\n103\t// once per advance check, so it counts how many times the gated advance ran.\n104\tfunction countAdvances(): { count: () => number } {\n105\t  let fired = 0;\n106\t  setViewInjectionHook(\"post-commit-advance\", () => {\n107\t    fired += 1;\n108\t  });\n109\t  return { count: () => fired };\n110\t}\n111\t\n112\tasync function intakeRaw(sdk: Lhc, filePath: string, events: Parameters<Lhc[\"intakeStream\"][\"messageEvents\"]>[1]): Promise<void> {\n113\t  const result = await sdk.intakeStream.messageEvents({ filePath }, events);\n114\t  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n115\t}\n116\t\n117\tdescribe(\"TC-5.1 (AC-5.1, AC-5.2): the advance runs only at turn close; eviction is whole-turn, oldest-first\", () => {\n118\t  it(\"holds position and bytes through mid-turn batches past max, advances exactly once at close, flips whole oldest turns\", async () => {\n119\t    const sdk = visSdk();\n120\t    const filePath = await newThread(sdk);\n121\t    const advances = countAdvances();\n122\t\n123\t    // One small closed turn (zone 60 ≤ 100): the close runs the check, the\n124\t    // boundary holds.\n125\t    await seedTurnedToolResults(sdk, filePath, [{ results: [30, 30] }]);\n126\t    expect(advances.count()).toBe(1);\n127\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n128\t\n129\t    // A second turn opens and accumulates tool results across mid-turn\n130\t    // batches, crossing max (zone 60+40 = 100, then 140 > 100): no batch runs\n131\t    // the check, the boundary never moves, and the over-budget condition is\n132\t    // visible in status.\n133\t    await intakeRaw(sdk, filePath, turnedToolResultEvents([{ results: [40], close: false }]));\n134\t    await intakeRaw(sdk, filePath, turnedToolResultEvents([{ results: [40], turnless: true }]));\n135\t    expect(advances.count()).toBe(1); // mid-turn batches never even check\n136\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n137\t    expect(await zoneTokensOf(sdk, filePath)).toBe(140);\n138\t\n139\t    // Consecutive pulls during the open turn are byte-identical (AC-5.1).\n140\t    const firstPull = await sdk.threadView.pull({ filePath });\n141\t    const secondPull = await sdk.threadView.pull({ filePath });\n142\t    expect(firstPull.ok && secondPull.ok).toBe(true);\n143\t    if (!firstPull.ok || !secondPull.ok) return;\n144\t    expect(secondPull.value.messages).toEqual(firstPull.value.messages);\n145\t    expect(abridgedCount(firstPull.value.messages)).toBe(0);\n146\t\n147\t    // The batch closing the turn commits: exactly one advance runs. Zone 140\n148\t    // > 100; groups t1=60, t2=80 (newest closed, never a candidate). Evicting\n149\t    // t1 leaves 80 ≥ target 60 → t1 flips whole; the advance lands at t1's\n150\t    // last result.\n151\t    await intakeRaw(sdk, filePath, [validEvent(\"turn_end\")]);\n152\t    expect(advances.count()).toBe(2);\n153\t\n154\t    const results = await toolResults(sdk, filePath);\n155\t    expect(results).toHaveLength(4);\n156\t    const position = await boundaryOf(sdk, filePath);\n157\t    expect(position).toBe(results[1]?.sourceEventOrder);\n158\t    expect(await zoneTokensOf(sdk, filePath)).toBe(80);\n159\t\n160\t    // Whole-turn, all-or-nothing: both of t1's results flipped together,\n161\t    // both of t2's stayed full.\n162\t    expectNoPartialTurn(results, position);\n163\t    const pulled = await sdk.threadView.pull({ filePath });\n164\t    expect(pulled.ok).toBe(true);\n165\t    if (!pulled.ok) return;\n166\t    expect(abridgedCount(pulled.value.messages)).toBe(2);\n167\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\n168\t      `[tool result · read_file]\\n${boundaryTokens(40)}`,\n169\t    );\n170\t\n171\t    // A small next turn closes under max (zone 90 ≤ 100): the check runs, no\n172\t    // movement.\n173\t    await seedTurnedToolResults(sdk, filePath, [{ results: [10] }]);\n174\t    expect(advances.count()).toBe(3);\n175\t    expect(await boundaryOf(sdk, filePath)).toBe(position);\n176\t    expect(await zoneTokensOf(sdk, filePath)).toBe(90);\n177\t  });\n178\t\n179\t  it(\"evicts a turnless tool result as a singleton group\", async () => {\n180\t    const sdk = visSdk();\n181\t    const filePath = await newThread(sdk);\n182\t\n183\t    // One closed turn (50), a turnless result in the gap (30), then a closed\n184\t    // turn (70): zone 150 > 100. Walk excluding the newest closed turn:\n185\t    // evict t1 (remaining 100 ≥ 60), evict the singleton (remaining 70 ≥ 60),\n186\t    // stop. The boundary lands on the turnless result.\n187\t    await seedTurnedToolResults(sdk, filePath, [\n188\t      { results: [50] },\n189\t      { results: [30], turnless: true },\n190\t      { results: [70] },\n191\t    ]);\n192\t\n193\t    const results = await toolResults(sdk, filePath);\n194\t    expect(results).toHaveLength(3);\n195\t    expect(results[1]?.turnId).toBeNull(); // recorded in the gap, no membership\n196\t    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n197\t    expect(await zoneTokensOf(sdk, filePath)).toBe(70);\n198\t\n199\t    const pulled = await sdk.threadView.pull({ filePath });\n200\t    expect(pulled.ok).toBe(true);\n201\t    if (!pulled.ok) return;\n202\t    expect(abridgedCount(pulled.value.messages)).toBe(2); // t1's result + the singleton\n203\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\n204\t      `[tool result · read_file]\\n${boundaryTokens(70)}`,\n205\t    );\n206\t  });\n207\t});\n208\t\n209\tdescribe(\"TC-5.2 (AC-5.3, AC-5.4): peek-ahead landing, newest-turn protection, two-field config\", () => {\n210\t  it(\"golden G2: 30k/25k/20k/15k turns under the 64k/32k defaults advance past the 25k group and land the zone at 35k\", async () => {\n211\t    // Default visibility on purpose: this leg proves the 64k/32k defaults by\n212\t    // behavior and by the status read.\n213\t    const sdk = visSdk({});\n214\t    const filePath = await newThread(sdk);\n215\t\n216\t    // One batch, four closed turns: total 90k > max 64k. Evict 30k → 60k ≥\n217\t    // 32k ✓; evict 25k → 35k ≥ 32k ✓; peek 20k: 35k − 20k = 15k < 32k → stop.\n218\t    // The 15k newest closed turn was never a candidate.\n219\t    await seedTurnedToolResults(sdk, filePath, [\n220\t      { results: [30000] },\n221\t      { results: [25000] },\n222\t      { results: [20000] },\n223\t      { results: [15000] },\n224\t    ]);\n225\t\n226\t    const results = await toolResults(sdk, filePath);\n227\t    expect(results).toHaveLength(4);\n228\t    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n229\t\n230\t    const status = await sdk.threadView.status({ filePath });\n231\t    expect(status.ok).toBe(true);\n232\t    if (!status.ok) return;\n233\t    expect(status.value.visibility.zoneTokens).toBe(35000);\n234\t    expect(status.value.visibility.maxTokens).toBe(64000);\n235\t\n236\t    // The landing rule: zone in [target, target + one turn).\n237\t    expect(status.value.visibility.zoneTokens).toBeGreaterThanOrEqual(32000);\n238\t    expect(status.value.visibility.zoneTokens).toBeLessThan(32000 + 20000);\n239\t  });\n240\t\n241\t  it(\"advances through a turn when the remaining sum is exactly target (≥, not >)\", async () => {\n242\t    const sdk = visSdk();\n243\t    const filePath = await newThread(sdk);\n244\t    // Turns 40/40/60: total 140 > 100. Evict t1 → 100 ≥ 60 ✓; evict t2 →\n245\t    // 60 ≥ 60 ✓ (the exact-target boundary condition); the newest closed\n246\t    // turn (60) is never a candidate. Zone lands exactly at target.\n247\t    await seedTurnedToolResults(sdk, filePath, [\n248\t      { results: [40] },\n249\t      { results: [40] },\n250\t      { results: [60] },\n251\t    ]);\n252\t    const results = await toolResults(sdk, filePath);\n253\t    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n254\t    expect(await zoneTokensOf(sdk, filePath)).toBe(60);\n255\t  });\n256\t\n257\t  it(\"never evicts the newest closed turn, even when it alone exceeds target and max\", async () => {\n258\t    const sdk = visSdk();\n259\t    const filePath = await newThread(sdk);\n260\t    // Turns 30/120: total 150 > 100. t1 evicts (remaining 120 ≥ 60); the\n261\t    // oversized newest closed turn stays whole and the zone legally sits\n262\t    // above max until newer closes or a compact create room.\n263\t    await seedTurnedToolResults(sdk, filePath, [{ results: [30] }, { results: [120] }]);\n264\t    const results = await toolResults(sdk, filePath);\n265\t    expect(await boundaryOf(sdk, filePath)).toBe(results[0]?.sourceEventOrder);\n266\t    expect(await zoneTokensOf(sdk, filePath)).toBe(120);\n267\t\n268\t    const pulled = await sdk.threadView.pull({ filePath });\n269\t    expect(pulled.ok).toBe(true);\n270\t    if (!pulled.ok) return;\n271\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\n272\t      `[tool result · read_file]\\n${boundaryTokens(120)}`,\n273\t    );\n274\t  });\n275\t\n276\t  it(\"holds the boundary when the only closed turn is oversized: no candidate exists\", async () => {\n277\t    const sdk = visSdk();\n278\t    const filePath = await newThread(sdk);\n279\t    await seedTurnedToolResults(sdk, filePath, [{ results: [150] }]);\n280\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n281\t    expect(await zoneTokensOf(sdk, filePath)).toBe(150);\n282\t  });\n283\t\n284\t  it(\"rejects maxTokens ≤ targetTokens at construction with a TypeError naming the constraint\", () => {\n285\t    expect(() => visSdk({ visibility: { maxTokens: 100, targetTokens: 200 } })).toThrow(\n286\t      TypeError,\n287\t    );\n288\t    expect(() => visSdk({ visibility: { maxTokens: 100, targetTokens: 200 } })).toThrow(\n289\t      /visibility\\.maxTokens \\(100\\) must be greater than targetTokens \\(200\\)/,\n290\t    );\n291\t    expect(() => visSdk({ visibility: { maxTokens: 100, targetTokens: 100 } })).toThrow(\n292\t      /visibility\\.maxTokens \\(100\\) must be greater than targetTokens \\(100\\)/,\n293\t    );\n294\t  });\n295\t\n296\t  it(\"resolves the two-field defaults to 64k/32k\", () => {\n297\t    const sdk = visSdk({});\n298\t    expect(sdk.config.view.visibility).toEqual({ maxTokens: 64000, targetTokens: 32000 });\n299\t  });\n300\t});\n301\t\n302\tdescribe(\"TC-5.3 (AC-5.5): remaining Epic 03 contracts under the new trigger\", () => {\n303\t  it(\"keeps flipped results flipped across later turn closes and replays the same trajectory from the same record\", async () => {\n304\t    // Determinism (golden G1 lives in view-select-golden.test.ts, re-cut for\n305\t    // turn grouping); this leg replays a small script twice end-to-end and\n306\t    // demands identical boundary trajectories.\n307\t    const script = [\n308\t      [{ results: [30, 30] }],\n309\t      [{ results: [40] }],\n310\t      [{ results: [40] }],\n311\t      [{ results: [10] }],\n312\t    ] as const;\n313\t\n314\t    const trajectories: number[][] = [];\n315\t    for (let run = 0; run < 2; run += 1) {\n316\t      const sdk = visSdk();\n317\t      const filePath = await newThread(sdk);\n318\t      const trajectory: number[] = [];\n319\t      for (const turns of script) {\n320\t        await seedTurnedToolResults(sdk, filePath, [...turns]);\n321\t        trajectory.push(await boundaryOf(sdk, filePath));\n322\t      }\n323\t      trajectories.push(trajectory);\n324\t    }\n325\t    expect(trajectories[1]).toEqual(trajectories[0]);\n326\t\n327\t    // Forward-only within the window: positions never decrease.\n328\t    const [trajectory] = trajectories;\n329\t    expect(trajectory).toBeDefined();\n330\t    if (trajectory === undefined) return;\n331\t    for (let i = 1; i < trajectory.length; i += 1) {\n332\t      expect(trajectory[i]).toBeGreaterThanOrEqual(trajectory[i - 1] as number);\n333\t    }\n334\t    // The script crossed max at the third close (zone 60+40+40 = 140 > 100):\n335\t    // the boundary moved and later closes held it.\n336\t    expect(trajectory[2]).toBeGreaterThan(0);\n337\t    expect(trajectory[3]).toBe(trajectory[2]);\n338\t  });\n339\t});\n340\t"}]},"parent_tool_use_id":null,"session_id":"b8291ef6-6126-40dc-b2d4-175e5ef5399e","uuid":"1dc76ce9-c833-4e24-a479-30d883c31285","timestamp":"2026-06-12T23:59:11.907Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-boundary-turn-end.test.ts","content":"// Epic 05 Story 6: the turn-end boundary advance (TC-5.1–TC-5.3). The Epic 03\n// advance trigger moves from every intake commit to turn close; eviction\n// becomes whole-turn, oldest-first, with a peek-ahead stop and a never-evicted\n// newest closed turn; the floor budget is retired (two-field config, 64k/32k\n// defaults). Every advance here fires through a REAL `intake.messageEvents`\n// commit — no host-called advance surface exists and no test invents one;\n// rendering is proven through real `pull` calls.\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { createSdk, type Lhc, type SdkViewConfig } from \"../src/index.js\";\nimport {\n  boundaryTokens,\n  createProviderDouble,\n  seedTurnedToolResults,\n  setViewInjectionHook,\n  tempStore,\n  turnedToolResultEvents,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\n// The story's small test budgets: max 100 > target 60 (AC-5.4 ordering); the\n// G2 leg runs the 64k/32k defaults instead.\nconst BUDGETS = { maxTokens: 100, targetTokens: 60 };\n\nconst stores: TempStore[] = [];\nafterEach(() => {\n  setViewInjectionHook(\"post-commit-advance\", null);\n  for (const store of stores.splice(0)) store.cleanup();\n});\n\nfunction visSdk(view: SdkViewConfig = { visibility: BUDGETS }): Lhc {\n  return createSdk({ provider: createProviderDouble(), mode: \"manual\", view });\n}\n\nasync function newThread(sdk: Lhc): Promise<string> {\n  const store = tempStore();\n  stores.push(store);\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function boundaryOf(sdk: Lhc, filePath: string): Promise<number> {\n  const pulled = await sdk.threadView.pull({ filePath });\n  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n  return pulled.value.meta.boundaryPosition;\n}\n\nasync function zoneTokensOf(sdk: Lhc, filePath: string): Promise<number> {\n  const status = await sdk.threadView.status({ filePath });\n  if (!status.ok) throw new Error(`status failed: ${status.error.reason}`);\n  return status.value.visibility.zoneTokens;\n}\n\ninterface ResultRow {\n  messageId: string;\n  sourceEventOrder: number;\n  tokenEstimate: number;\n  turnId: string | null;\n}\n\nasync function toolResults(sdk: Lhc, filePath: string): Promise<ResultRow[]> {\n  const listed = await sdk.messages.listMessages({ filePath });\n  if (!listed.ok) throw new Error(`listMessages failed: ${listed.error.reason}`);\n  return listed.value\n    .filter((m) => m.kind === \"tool_result\")\n    .map((m) => ({\n      messageId: m.messageId,\n      sourceEventOrder: m.sourceEventOrder,\n      tokenEstimate: m.tokenEstimate,\n      turnId: m.turnId ?? null,\n    }));\n}\n\nfunction abridgedCount(messages: ReadonlyArray<{ content: string }>): number {\n  return messages.filter(\n    (m) => m.content.startsWith(\"[tool result · \") && m.content.includes(\" · abridged]\"),\n  ).length;\n}\n\n// Per-turn all-or-nothing (AC-5.2): with the boundary at `position`, every\n// turn's results sit uniformly at-or-behind it or uniformly ahead of it —\n// no turn is ever partially flipped.\nfunction expectNoPartialTurn(results: readonly ResultRow[], position: number): void {\n  const byTurn = new Map<string, boolean[]>();\n  for (const r of results) {\n    if (r.turnId === null) continue; // turnless: a singleton is whole by construction\n    const flips = byTurn.get(r.turnId) ?? [];\n    flips.push(r.sourceEventOrder <= position);\n    byTurn.set(r.turnId, flips);\n  }\n  for (const [turnId, flips] of byTurn) {\n    const flipped = flips.filter(Boolean).length;\n    expect(\n      flipped === 0 || flipped === flips.length,\n      `turn ${turnId} is partially flipped (${flipped}/${flips.length})`,\n    ).toBe(true);\n  }\n}\n\n// A counting (non-throwing) hook on the Story-0 injection point: it fires\n// once per advance check, so it counts how many times the gated advance ran.\nfunction countAdvances(): { count: () => number } {\n  let fired = 0;\n  setViewInjectionHook(\"post-commit-advance\", () => {\n    fired += 1;\n  });\n  return { count: () => fired };\n}\n\nasync function intakeRaw(sdk: Lhc, filePath: string, events: Parameters<Lhc[\"intakeStream\"][\"messageEvents\"]>[1]): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, events);\n  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n}\n\ndescribe(\"TC-5.1 (AC-5.1, AC-5.2): the advance runs only at turn close; eviction is whole-turn, oldest-first\", () => {\n  it(\"holds position and bytes through mid-turn batches past max, advances exactly once at close, flips whole oldest turns\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    const advances = countAdvances();\n\n    // One small closed turn (zone 60 ≤ 100): the close runs the check, the\n    // boundary holds.\n    await seedTurnedToolResults(sdk, filePath, [{ results: [30, 30] }]);\n    expect(advances.count()).toBe(1);\n    expect(await boundaryOf(sdk, filePath)).toBe(0);\n\n    // A second turn opens and accumulates tool results across mid-turn\n    // batches, crossing max (zone 60+40 = 100, then 140 > 100): no batch runs\n    // the check, the boundary never moves, and the over-budget condition is\n    // visible in status.\n    await intakeRaw(sdk, filePath, turnedToolResultEvents([{ results: [40], close: false }]));\n    await intakeRaw(sdk, filePath, turnedToolResultEvents([{ results: [40], turnless: true }]));\n    expect(advances.count()).toBe(1); // mid-turn batches never even check\n    expect(await boundaryOf(sdk, filePath)).toBe(0);\n    expect(await zoneTokensOf(sdk, filePath)).toBe(140);\n\n    // Consecutive pulls during the open turn are byte-identical (AC-5.1).\n    const firstPull = await sdk.threadView.pull({ filePath });\n    const secondPull = await sdk.threadView.pull({ filePath });\n    expect(firstPull.ok && secondPull.ok).toBe(true);\n    if (!firstPull.ok || !secondPull.ok) return;\n    expect(secondPull.value.messages).toEqual(firstPull.value.messages);\n    expect(abridgedCount(firstPull.value.messages)).toBe(0);\n\n    // The batch closing the turn commits: exactly one advance runs. Zone 140\n    // > 100; groups t1=60, t2=80 (newest closed, never a candidate). Evicting\n    // t1 leaves 80 ≥ target 60 → t1 flips whole; the advance lands at t1's\n    // last result.\n    await intakeRaw(sdk, filePath, [validEvent(\"turn_end\")]);\n    expect(advances.count()).toBe(2);\n\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(4);\n    const position = await boundaryOf(sdk, filePath);\n    expect(position).toBe(results[1]?.sourceEventOrder);\n    expect(await zoneTokensOf(sdk, filePath)).toBe(80);\n\n    // Whole-turn, all-or-nothing: both of t1's results flipped together,\n    // both of t2's stayed full.\n    expectNoPartialTurn(results, position);\n    const pulled = await sdk.threadView.pull({ filePath });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    expect(abridgedCount(pulled.value.messages)).toBe(2);\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\n      `[tool result · read_file]\\n${boundaryTokens(40)}`,\n    );\n\n    // A small next turn closes under max (zone 90 ≤ 100): the check runs, no\n    // movement.\n    await seedTurnedToolResults(sdk, filePath, [{ results: [10] }]);\n    expect(advances.count()).toBe(3);\n    expect(await boundaryOf(sdk, filePath)).toBe(position);\n    expect(await zoneTokensOf(sdk, filePath)).toBe(90);\n  });\n\n  it(\"evicts a turnless tool result as a singleton group\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n\n    // One closed turn (50), a turnless result in the gap (30), then a closed\n    // turn (70): zone 150 > 100. Walk excluding the newest closed turn:\n    // evict t1 (remaining 100 ≥ 60), evict the singleton (remaining 70 ≥ 60),\n    // stop. The boundary lands on the turnless result.\n    await seedTurnedToolResults(sdk, filePath, [\n      { results: [50] },\n      { results: [30], turnless: true },\n      { results: [70] },\n    ]);\n\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(3);\n    expect(results[1]?.turnId).toBeNull(); // recorded in the gap, no membership\n    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n    expect(await zoneTokensOf(sdk, filePath)).toBe(70);\n\n    const pulled = await sdk.threadView.pull({ filePath });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    expect(abridgedCount(pulled.value.messages)).toBe(2); // t1's result + the singleton\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\n      `[tool result · read_file]\\n${boundaryTokens(70)}`,\n    );\n  });\n});\n\ndescribe(\"TC-5.2 (AC-5.3, AC-5.4): peek-ahead landing, newest-turn protection, two-field config\", () => {\n  it(\"golden G2: 30k/25k/20k/15k turns under the 64k/32k defaults advance past the 25k group and land the zone at 35k\", async () => {\n    // Default visibility on purpose: this leg proves the 64k/32k defaults by\n    // behavior and by the status read.\n    const sdk = visSdk({});\n    const filePath = await newThread(sdk);\n\n    // One batch, four closed turns: total 90k > max 64k. Evict 30k → 60k ≥\n    // 32k ✓; evict 25k → 35k ≥ 32k ✓; peek 20k: 35k − 20k = 15k < 32k → stop.\n    // The 15k newest closed turn was never a candidate.\n    await seedTurnedToolResults(sdk, filePath, [\n      { results: [30000] },\n      { results: [25000] },\n      { results: [20000] },\n      { results: [15000] },\n    ]);\n\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(4);\n    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n\n    const status = await sdk.threadView.status({ filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    expect(status.value.visibility.zoneTokens).toBe(35000);\n    expect(status.value.visibility.maxTokens).toBe(64000);\n\n    // The landing rule: zone in [target, target + one turn).\n    expect(status.value.visibility.zoneTokens).toBeGreaterThanOrEqual(32000);\n    expect(status.value.visibility.zoneTokens).toBeLessThan(32000 + 20000);\n  });\n\n  it(\"advances through a turn when the remaining sum is exactly target (≥, not >)\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    // Turns 40/40/60: total 140 > 100. Evict t1 → 100 ≥ 60 ✓; evict t2 →\n    // 60 ≥ 60 ✓ (the exact-target boundary condition); the newest closed\n    // turn (60) is never a candidate. Zone lands exactly at target.\n    await seedTurnedToolResults(sdk, filePath, [\n      { results: [40] },\n      { results: [40] },\n      { results: [60] },\n    ]);\n    const results = await toolResults(sdk, filePath);\n    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n    expect(await zoneTokensOf(sdk, filePath)).toBe(60);\n  });\n\n  it(\"never evicts the newest closed turn, even when it alone exceeds target and max\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    // Turns 30/120: total 150 > 100. t1 evicts (remaining 120 ≥ 60); the\n    // oversized newest closed turn stays whole and the zone legally sits\n    // above max until newer closes or a compact create room.\n    await seedTurnedToolResults(sdk, filePath, [{ results: [30] }, { results: [120] }]);\n    const results = await toolResults(sdk, filePath);\n    expect(await boundaryOf(sdk, filePath)).toBe(results[0]?.sourceEventOrder);\n    expect(await zoneTokensOf(sdk, filePath)).toBe(120);\n\n    const pulled = await sdk.threadView.pull({ filePath });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\n      `[tool result · read_file]\\n${boundaryTokens(120)}`,\n    );\n  });\n\n  it(\"holds the boundary when the only closed turn is oversized: no candidate exists\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    await seedTurnedToolResults(sdk, filePath, [{ results: [150] }]);\n    expect(await boundaryOf(sdk, filePath)).toBe(0);\n    expect(await zoneTokensOf(sdk, filePath)).toBe(150);\n  });\n\n  it(\"rejects maxTokens ≤ targetTokens at construction with a TypeError naming the constraint\", () => {\n    expect(() => visSdk({ visibility: { maxTokens: 100, targetTokens: 200 } })).toThrow(\n      TypeError,\n    );\n    expect(() => visSdk({ visibility: { maxTokens: 100, targetTokens: 200 } })).toThrow(\n      /visibility\\.maxTokens \\(100\\) must be greater than targetTokens \\(200\\)/,\n    );\n    expect(() => visSdk({ visibility: { maxTokens: 100, targetTokens: 100 } })).toThrow(\n      /visibility\\.maxTokens \\(100\\) must be greater than targetTokens \\(100\\)/,\n    );\n  });\n\n  it(\"resolves the two-field defaults to 64k/32k\", () => {\n    const sdk = visSdk({});\n    expect(sdk.config.view.visibility).toEqual({ maxTokens: 64000, targetTokens: 32000 });\n  });\n});\n\ndescribe(\"TC-5.3 (AC-5.5): remaining Epic 03 contracts under the new trigger\", () => {\n  it(\"keeps flipped results flipped across later turn closes and replays the same trajectory from the same record\", async () => {\n    // Determinism (golden G1 lives in view-select-golden.test.ts, re-cut for\n    // turn grouping); this leg replays a small script twice end-to-end and\n    // demands identical boundary trajectories.\n    const script = [\n      [{ results: [30, 30] }],\n      [{ results: [40] }],\n      [{ results: [40] }],\n      [{ results: [10] }],\n    ] as const;\n\n    const trajectories: number[][] = [];\n    for (let run = 0; run < 2; run += 1) {\n      const sdk = visSdk();\n      const filePath = await newThread(sdk);\n      const trajectory: number[] = [];\n      for (const turns of script) {\n        await seedTurnedToolResults(sdk, filePath, [...turns]);\n        trajectory.push(await boundaryOf(sdk, filePath));\n      }\n      trajectories.push(trajectory);\n    }\n    expect(trajectories[1]).toEqual(trajectories[0]);\n\n    // Forward-only within the window: positions never decrease.\n    const [trajectory] = trajectories;\n    expect(trajectory).toBeDefined();\n    if (trajectory === undefined) return;\n    for (let i = 1; i < trajectory.length; i += 1) {\n      expect(trajectory[i]).toBeGreaterThanOrEqual(trajectory[i - 1] as number);\n    }\n    // The script crossed max at the third close (zone 60+40+40 = 140 > 100):\n    // the boundary moved and later closes held it.\n    expect(trajectory[2]).toBeGreaterThan(0);\n    expect(trajectory[3]).toBe(trajectory[2]);\n  });\n});\n","numLines":340,"startLine":1,"totalLines":340}}}

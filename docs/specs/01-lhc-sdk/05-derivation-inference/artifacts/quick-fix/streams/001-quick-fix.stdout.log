{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015GkVoMerU2zYu2nBvHi7K8","type":"tool_result","content":"1\t// Epic 05 Story 3 — TC-2.2 (AC-2.2, AC-2.3): the seven LHC-owned prompt\n2\t// templates. Goldens pin each template's rendered messages for a fixture\n3\t// input (prompt/fixture drift is an architecture risk: a provider call could\n4\t// succeed while a prompt silently loses required input fields); registry\n5\t// completeness proves every config-selectable name resolves; the brief/\n6\t// detailed contrast and the input-bounding legs run through the adapter\n7\t// operations, never the renderers alone (anti-shim).\n8\timport { readFileSync } from \"node:fs\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\timport { describe, expect, it } from \"vitest\";\n12\timport { createInferenceProvider } from \"../src/inference/adapter.js\";\n13\timport {\n14\t  DEFAULT_PROMPT_NAMES,\n15\t  PROMPT_REGISTRY,\n16\t  type PromptTemplate,\n17\t} from \"../src/inference/prompts/index.js\";\n18\timport type { ModelCallInput, ResolvedInferenceConfig } from \"../src/inference/types.js\";\n19\timport {\n20\t  cannedResponses,\n21\t  FAKE_MODEL_PREFIX,\n22\t  FORM_KINDS,\n23\t  recordingCall,\n24\t  validAssignments,\n25\t} from \"./fixtures/index.js\";\n26\t\n27\tconst goldensDir = path.join(\n28\t  path.dirname(fileURLToPath(import.meta.url)),\n29\t  \"goldens\",\n30\t  \"prompts\",\n31\t);\n32\t\n33\t// One fixture input per template, keyed by template name. Each carries\n34\t// distinctive strings the golden embeds, so a template that drops an input\n35\t// field fails its golden rather than passing on shape alone.\n36\tconst PROMPT_FIXTURES: Record<string, { input: unknown; embedded: string[] }> = {\n37\t  \"smoothing-v1\": {\n38\t    input: { text: \"plz smooth this prmpt about src/app.ts line 42 thx\" },\n39\t    embedded: [\"src/app.ts line 42\"],\n40\t  },\n41\t  \"tool-call-v1\": {\n42\t    input: {\n43\t      toolName: \"read_file\",\n44\t      argsJson: '{\"path\":\"notes/plan.md\"}',\n45\t      pairedResult: { content: \"plan contents: ship story three\", isError: false },\n46\t    },\n47\t    embedded: ['{\"path\":\"notes/plan.md\"}', \"ship story three\", \"isError: false\"],\n48\t  },\n49\t  \"tool-result-v1\": {\n50\t    input: { toolName: \"read_file\", content: \"contents of notes/plan.md: 3 open items\" },\n51\t    embedded: [\"contents of notes/plan.md: 3 open items\"],\n52\t  },\n53\t  \"turn-compose-v1\": {\n54\t    input: {\n55\t      parts: [\n56\t        { messageId: \"m1\", kind: \"user_prompt\", text: \"please read notes/plan.md\", fallback: false },\n57\t        {\n58\t          messageId: \"m2\",\n59\t          kind: \"tool_call\",\n60\t          text: \"read_file called on notes/plan.md\",\n61\t          fallback: false,\n62\t          outcome: \"succeeded\",\n63\t        },\n64\t        { messageId: \"m3\", kind: \"assistant_text\", text: \"the plan has 3 open items\", fallback: false },\n65\t      ],\n66\t    },\n67\t    embedded: [\"please read notes/plan.md\", \"outcome: succeeded\", \"the plan has 3 open items\"],\n68\t  },\n69\t  \"lower-band-v1\": {\n70\t    input: {\n71\t      rendering: \"The user asked for notes/plan.md; the assistant read it and reported 3 open items.\",\n72\t    },\n73\t    embedded: [\"reported 3 open items\"],\n74\t  },\n75\t  \"chunk-detailed-v1\": {\n76\t    input: {\n77\t      memberProjections: [\"turn one: read notes/plan.md\", \"turn two: edited src/app.ts\"],\n78\t      memberReceipts: [\n79\t        [\n80\t          {\n81\t            messageId: \"m2\",\n82\t            activity: \"tool_call\",\n83\t            account: \"read_file fetched notes/plan.md\",\n84\t            outcome: \"succeeded\",\n85\t          },\n86\t        ],\n87\t        [],\n88\t      ],\n89\t    },\n90\t    embedded: [\"turn one: read notes/plan.md\", \"read_file fetched notes/plan.md => succeeded\"],\n91\t  },\n92\t  \"chunk-brief-v1\": {\n93\t    input: {\n94\t      memberProjections: [\"turn one: read notes/plan.md\", \"turn two: edited src/app.ts\"],\n95\t      memberOutcomes: [[\"succeeded\"], []],\n96\t    },\n97\t    embedded: [\"turn two: edited src/app.ts\", \"Tool outcomes, in order: succeeded\"],\n98\t  },\n99\t};\n100\t\n101\tfunction renderByName(name: string, input: unknown): ModelCallInput[\"messages\"] {\n102\t  const template = PROMPT_REGISTRY[name] as PromptTemplate<unknown> | undefined;\n103\t  if (template === undefined) throw new Error(`template \"${name}\" not in registry`);\n104\t  return template.render(input);\n105\t}\n106\t\n107\tfunction resolvedConfig(\n108\t  overrides: Partial<ResolvedInferenceConfig> & Pick<ResolvedInferenceConfig, \"call\">,\n109\t): ResolvedInferenceConfig {\n110\t  return {\n111\t    assignments: validAssignments(),\n112\t    timeoutMs: 60_000,\n113\t    maxInputChars: 200_000,\n114\t    ...overrides,\n115\t  };\n116\t}\n117\t\n118\tfunction userContent(input: ModelCallInput): string {\n119\t  const user = input.messages.find((message) => message.role === \"user\");\n120\t  if (user === undefined) throw new Error(\"no user message in rendered call\");\n121\t  return user.content;\n122\t}\n123\t\n124\tdescribe(\"TC-2.2: prompt-rendering goldens (AC-2.2, AC-2.3)\", () => {\n125\t  for (const kind of FORM_KINDS) {\n126\t    const name = DEFAULT_PROMPT_NAMES[kind];\n127\t    it(`${name} renders its fixture input to the committed golden`, () => {\n128\t      const fixture = PROMPT_FIXTURES[name];\n129\t      expect(fixture).toBeDefined();\n130\t      const rendered = renderByName(name, fixture?.input);\n131\t      const golden = JSON.parse(\n132\t        readFileSync(path.join(goldensDir, `${name}.golden.json`), \"utf8\"),\n133\t      ) as ModelCallInput[\"messages\"];\n134\t      expect(rendered).toEqual(golden);\n135\t    });\n136\t\n137\t    it(`${name} embeds its fixture content in single-turn shape`, () => {\n138\t      const fixture = PROMPT_FIXTURES[name];\n139\t      const rendered = renderByName(name, fixture?.input);\n140\t      expect(rendered.filter((message) => message.role === \"user\")).toHaveLength(1);\n141\t      for (const message of rendered) {\n142\t        expect([\"system\", \"user\"]).toContain(message.role);\n143\t        expect(typeof message.content).toBe(\"string\");\n144\t      }\n145\t      const joined = rendered.map((message) => message.content).join(\"\\n\");\n146\t      for (const needle of fixture?.embedded ?? []) {\n147\t        expect(joined).toContain(needle);\n148\t      }\n149\t    });\n150\t  }\n151\t});\n152\t\n153\tdescribe(\"TC-2.2: registry completeness (AC-2.3)\", () => {\n154\t  it(\"every registry key resolves to a template carrying that exact name\", () => {\n155\t    const names = Object.keys(PROMPT_REGISTRY);\n156\t    expect(names.length).toBeGreaterThanOrEqual(7);\n157\t    for (const name of names) {\n158\t      expect(PROMPT_REGISTRY[name]?.name).toBe(name);\n159\t      expect(typeof PROMPT_REGISTRY[name]?.render).toBe(\"function\");\n160\t    }\n161\t  });\n162\t\n163\t  it(\"default names cover all seven kinds and each resolves in the registry\", () => {\n164\t    const defaultNames = new Set<string>();\n165\t    for (const kind of FORM_KINDS) {\n166\t      const name = DEFAULT_PROMPT_NAMES[kind];\n167\t      expect(typeof name).toBe(\"string\");\n168\t      expect(PROMPT_REGISTRY[name]).toBeDefined();\n169\t      defaultNames.add(name);\n170\t    }\n171\t    // Seven kinds, seven distinct templates — no kind shares another's prompt.\n172\t    expect(defaultNames.size).toBe(7);\n173\t  });\n174\t});\n175\t\n176\tdescribe(\"TC-2.2: brief receipt-stripping holds through the adapter (AC-2.2)\", () => {\n177\t  const RECEIPT_ACCOUNT = \"read_file fetched notes/plan.md and rewrote temp/out.txt\";\n178\t\n179\t  it(\"the brief rendering carries outcome tokens but no receipt text from its input\", async () => {\n180\t    const { call, log } = recordingCall(cannedResponses());\n181\t    const provider = createInferenceProvider(resolvedConfig({ call }));\n182\t\n183\t    const detailed = await provider.summarizeChunkDetailed({\n184\t      memberProjections: [\"turn one: planning work\"],\n185\t      memberReceipts: [\n186\t        [{ messageId: \"m2\", activity: \"tool_call\", account: RECEIPT_ACCOUNT, outcome: \"succeeded\" }],\n187\t      ],\n188\t    });\n189\t    const brief = await provider.summarizeChunkBrief({\n190\t      memberProjections: [\"turn one: planning work\"],\n191\t      memberOutcomes: [[\"succeeded\"]],\n192\t    });\n193\t    expect(detailed.ok).toBe(true);\n194\t    expect(brief.ok).toBe(true);\n195\t\n196\t    const detailedCall = log.find(\n197\t      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_detailed`,\n198\t    );\n199\t    const briefCall = log.find(\n200\t      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_brief`,\n201\t    );\n202\t    expect(detailedCall).toBeDefined();\n203\t    expect(briefCall).toBeDefined();\n204\t    if (detailedCall === undefined || briefCall === undefined) return;\n205\t\n206\t    // The detailed lane is the contrast: its rendering carries the receipt\n207\t    // account verbatim, so its absence from the brief lane is stripping, not\n208\t    // a template that ignores receipts altogether.\n209\t    expect(userContent(detailedCall)).toContain(RECEIPT_ACCOUNT);\n210\t    expect(userContent(briefCall)).toContain(\"succeeded\");\n211\t    expect(userContent(briefCall)).not.toContain(RECEIPT_ACCOUNT);\n212\t    expect(userContent(briefCall)).not.toContain(\"rewrote\");\n213\t  });\n214\t});\n215\t\n216\tdescribe(\"TC-2.2: tool-result input bounding (AC-2.2, DD-7)\", () => {\n217\t  const MAX_INPUT_CHARS = 200;\n218\t\n219\t  it(\"oversized summarizeToolResult input renders head + tail + marker under maxInputChars\", async () => {\n220\t    const { call, log } = recordingCall(cannedResponses());\n221\t    const provider = createInferenceProvider(\n222\t      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\n223\t    );\n224\t    const content = \"H\".repeat(150) + \"M\".repeat(700) + \"T\".repeat(150);\n225\t    const result = await provider.summarizeToolResult({ toolName: \"read_file\", content });\n226\t    expect(result.ok).toBe(true);\n227\t\n228\t    const input = log[0];\n229\t    expect(input).toBeDefined();\n230\t    if (input === undefined) return;\n231\t    const user = userContent(input);\n232\t    const bounded = user.slice(user.indexOf(\"Output:\\n\") + \"Output:\\n\".length);\n233\t    expect(bounded.length).toBeLessThanOrEqual(MAX_INPUT_CHARS);\n234\t    expect(bounded.startsWith(\"HHHH\")).toBe(true);\n235\t    expect(bounded.endsWith(\"TTTT\")).toBe(true);\n236\t    expect(bounded).toContain(\"truncated\");\n237\t    // Bounding happened before rendering: the middle never reached the prompt.\n238\t    expect(user).not.toContain(\"M\".repeat(50));\n239\t  });\n240\t\n241\t  it(\"under-limit input renders whole, no marker\", async () => {\n242\t    const { call, log } = recordingCall(cannedResponses());\n243\t    const provider = createInferenceProvider(\n244\t      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\n245\t    );\n246\t    const content = \"W\".repeat(MAX_INPUT_CHARS);\n247\t    const result = await provider.summarizeToolResult({ toolName: \"read_file\", content });\n248\t    expect(result.ok).toBe(true);\n249\t\n250\t    const input = log[0];\n251\t    expect(input).toBeDefined();\n252\t    if (input === undefined) return;\n253\t    const user = userContent(input);\n254\t    expect(user).toContain(content);\n255\t    expect(user).not.toContain(\"truncated\");\n256\t  });\n257\t});\n258\t"}]},"parent_tool_use_id":null,"session_id":"7cef6c87-78e2-45ca-98c2-725c469882de","uuid":"ac42a50d-2079-48d9-b8fc-6312a034073b","timestamp":"2026-06-12T22:44:45.059Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inference-prompts.test.ts","content":"// Epic 05 Story 3 — TC-2.2 (AC-2.2, AC-2.3): the seven LHC-owned prompt\n// templates. Goldens pin each template's rendered messages for a fixture\n// input (prompt/fixture drift is an architecture risk: a provider call could\n// succeed while a prompt silently loses required input fields); registry\n// completeness proves every config-selectable name resolves; the brief/\n// detailed contrast and the input-bounding legs run through the adapter\n// operations, never the renderers alone (anti-shim).\nimport { readFileSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { describe, expect, it } from \"vitest\";\nimport { createInferenceProvider } from \"../src/inference/adapter.js\";\nimport {\n  DEFAULT_PROMPT_NAMES,\n  PROMPT_REGISTRY,\n  type PromptTemplate,\n} from \"../src/inference/prompts/index.js\";\nimport type { ModelCallInput, ResolvedInferenceConfig } from \"../src/inference/types.js\";\nimport {\n  cannedResponses,\n  FAKE_MODEL_PREFIX,\n  FORM_KINDS,\n  recordingCall,\n  validAssignments,\n} from \"./fixtures/index.js\";\n\nconst goldensDir = path.join(\n  path.dirname(fileURLToPath(import.meta.url)),\n  \"goldens\",\n  \"prompts\",\n);\n\n// One fixture input per template, keyed by template name. Each carries\n// distinctive strings the golden embeds, so a template that drops an input\n// field fails its golden rather than passing on shape alone.\nconst PROMPT_FIXTURES: Record<string, { input: unknown; embedded: string[] }> = {\n  \"smoothing-v1\": {\n    input: { text: \"plz smooth this prmpt about src/app.ts line 42 thx\" },\n    embedded: [\"src/app.ts line 42\"],\n  },\n  \"tool-call-v1\": {\n    input: {\n      toolName: \"read_file\",\n      argsJson: '{\"path\":\"notes/plan.md\"}',\n      pairedResult: { content: \"plan contents: ship story three\", isError: false },\n    },\n    embedded: ['{\"path\":\"notes/plan.md\"}', \"ship story three\", \"isError: false\"],\n  },\n  \"tool-result-v1\": {\n    input: { toolName: \"read_file\", content: \"contents of notes/plan.md: 3 open items\" },\n    embedded: [\"contents of notes/plan.md: 3 open items\"],\n  },\n  \"turn-compose-v1\": {\n    input: {\n      parts: [\n        { messageId: \"m1\", kind: \"user_prompt\", text: \"please read notes/plan.md\", fallback: false },\n        {\n          messageId: \"m2\",\n          kind: \"tool_call\",\n          text: \"read_file called on notes/plan.md\",\n          fallback: false,\n          outcome: \"succeeded\",\n        },\n        { messageId: \"m3\", kind: \"assistant_text\", text: \"the plan has 3 open items\", fallback: false },\n      ],\n    },\n    embedded: [\"please read notes/plan.md\", \"outcome: succeeded\", \"the plan has 3 open items\"],\n  },\n  \"lower-band-v1\": {\n    input: {\n      rendering: \"The user asked for notes/plan.md; the assistant read it and reported 3 open items.\",\n    },\n    embedded: [\"reported 3 open items\"],\n  },\n  \"chunk-detailed-v1\": {\n    input: {\n      memberProjections: [\"turn one: read notes/plan.md\", \"turn two: edited src/app.ts\"],\n      memberReceipts: [\n        [\n          {\n            messageId: \"m2\",\n            activity: \"tool_call\",\n            account: \"read_file fetched notes/plan.md\",\n            outcome: \"succeeded\",\n          },\n        ],\n        [],\n      ],\n    },\n    embedded: [\"turn one: read notes/plan.md\", \"read_file fetched notes/plan.md => succeeded\"],\n  },\n  \"chunk-brief-v1\": {\n    input: {\n      memberProjections: [\"turn one: read notes/plan.md\", \"turn two: edited src/app.ts\"],\n      memberOutcomes: [[\"succeeded\"], []],\n    },\n    embedded: [\"turn two: edited src/app.ts\", \"Tool outcomes, in order: succeeded\"],\n  },\n};\n\nfunction renderByName(name: string, input: unknown): ModelCallInput[\"messages\"] {\n  const template = PROMPT_REGISTRY[name] as PromptTemplate<unknown> | undefined;\n  if (template === undefined) throw new Error(`template \"${name}\" not in registry`);\n  return template.render(input);\n}\n\nfunction resolvedConfig(\n  overrides: Partial<ResolvedInferenceConfig> & Pick<ResolvedInferenceConfig, \"call\">,\n): ResolvedInferenceConfig {\n  return {\n    assignments: validAssignments(),\n    timeoutMs: 60_000,\n    maxInputChars: 200_000,\n    ...overrides,\n  };\n}\n\nfunction userContent(input: ModelCallInput): string {\n  const user = input.messages.find((message) => message.role === \"user\");\n  if (user === undefined) throw new Error(\"no user message in rendered call\");\n  return user.content;\n}\n\ndescribe(\"TC-2.2: prompt-rendering goldens (AC-2.2, AC-2.3)\", () => {\n  for (const kind of FORM_KINDS) {\n    const name = DEFAULT_PROMPT_NAMES[kind];\n    it(`${name} renders its fixture input to the committed golden`, () => {\n      const fixture = PROMPT_FIXTURES[name];\n      expect(fixture).toBeDefined();\n      const rendered = renderByName(name, fixture?.input);\n      const golden = JSON.parse(\n        readFileSync(path.join(goldensDir, `${name}.golden.json`), \"utf8\"),\n      ) as ModelCallInput[\"messages\"];\n      expect(rendered).toEqual(golden);\n    });\n\n    it(`${name} embeds its fixture content in single-turn shape`, () => {\n      const fixture = PROMPT_FIXTURES[name];\n      const rendered = renderByName(name, fixture?.input);\n      expect(rendered.filter((message) => message.role === \"user\")).toHaveLength(1);\n      for (const message of rendered) {\n        expect([\"system\", \"user\"]).toContain(message.role);\n        expect(typeof message.content).toBe(\"string\");\n      }\n      const joined = rendered.map((message) => message.content).join(\"\\n\");\n      for (const needle of fixture?.embedded ?? []) {\n        expect(joined).toContain(needle);\n      }\n    });\n  }\n});\n\ndescribe(\"TC-2.2: registry completeness (AC-2.3)\", () => {\n  it(\"every registry key resolves to a template carrying that exact name\", () => {\n    const names = Object.keys(PROMPT_REGISTRY);\n    expect(names.length).toBeGreaterThanOrEqual(7);\n    for (const name of names) {\n      expect(PROMPT_REGISTRY[name]?.name).toBe(name);\n      expect(typeof PROMPT_REGISTRY[name]?.render).toBe(\"function\");\n    }\n  });\n\n  it(\"default names cover all seven kinds and each resolves in the registry\", () => {\n    const defaultNames = new Set<string>();\n    for (const kind of FORM_KINDS) {\n      const name = DEFAULT_PROMPT_NAMES[kind];\n      expect(typeof name).toBe(\"string\");\n      expect(PROMPT_REGISTRY[name]).toBeDefined();\n      defaultNames.add(name);\n    }\n    // Seven kinds, seven distinct templates — no kind shares another's prompt.\n    expect(defaultNames.size).toBe(7);\n  });\n});\n\ndescribe(\"TC-2.2: brief receipt-stripping holds through the adapter (AC-2.2)\", () => {\n  const RECEIPT_ACCOUNT = \"read_file fetched notes/plan.md and rewrote temp/out.txt\";\n\n  it(\"the brief rendering carries outcome tokens but no receipt text from its input\", async () => {\n    const { call, log } = recordingCall(cannedResponses());\n    const provider = createInferenceProvider(resolvedConfig({ call }));\n\n    const detailed = await provider.summarizeChunkDetailed({\n      memberProjections: [\"turn one: planning work\"],\n      memberReceipts: [\n        [{ messageId: \"m2\", activity: \"tool_call\", account: RECEIPT_ACCOUNT, outcome: \"succeeded\" }],\n      ],\n    });\n    const brief = await provider.summarizeChunkBrief({\n      memberProjections: [\"turn one: planning work\"],\n      memberOutcomes: [[\"succeeded\"]],\n    });\n    expect(detailed.ok).toBe(true);\n    expect(brief.ok).toBe(true);\n\n    const detailedCall = log.find(\n      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_detailed`,\n    );\n    const briefCall = log.find(\n      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_brief`,\n    );\n    expect(detailedCall).toBeDefined();\n    expect(briefCall).toBeDefined();\n    if (detailedCall === undefined || briefCall === undefined) return;\n\n    // The detailed lane is the contrast: its rendering carries the receipt\n    // account verbatim, so its absence from the brief lane is stripping, not\n    // a template that ignores receipts altogether.\n    expect(userContent(detailedCall)).toContain(RECEIPT_ACCOUNT);\n    expect(userContent(briefCall)).toContain(\"succeeded\");\n    expect(userContent(briefCall)).not.toContain(RECEIPT_ACCOUNT);\n    expect(userContent(briefCall)).not.toContain(\"rewrote\");\n  });\n});\n\ndescribe(\"TC-2.2: tool-result input bounding (AC-2.2, DD-7)\", () => {\n  const MAX_INPUT_CHARS = 200;\n\n  it(\"oversized summarizeToolResult input renders head + tail + marker under maxInputChars\", async () => {\n    const { call, log } = recordingCall(cannedResponses());\n    const provider = createInferenceProvider(\n      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\n    );\n    const content = \"H\".repeat(150) + \"M\".repeat(700) + \"T\".repeat(150);\n    const result = await provider.summarizeToolResult({ toolName: \"read_file\", content });\n    expect(result.ok).toBe(true);\n\n    const input = log[0];\n    expect(input).toBeDefined();\n    if (input === undefined) return;\n    const user = userContent(input);\n    const bounded = user.slice(user.indexOf(\"Output:\\n\") + \"Output:\\n\".length);\n    expect(bounded.length).toBeLessThanOrEqual(MAX_INPUT_CHARS);\n    expect(bounded.startsWith(\"HHHH\")).toBe(true);\n    expect(bounded.endsWith(\"TTTT\")).toBe(true);\n    expect(bounded).toContain(\"truncated\");\n    // Bounding happened before rendering: the middle never reached the prompt.\n    expect(user).not.toContain(\"M\".repeat(50));\n  });\n\n  it(\"under-limit input renders whole, no marker\", async () => {\n    const { call, log } = recordingCall(cannedResponses());\n    const provider = createInferenceProvider(\n      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\n    );\n    const content = \"W\".repeat(MAX_INPUT_CHARS);\n    const result = await provider.summarizeToolResult({ toolName: \"read_file\", content });\n    expect(result.ok).toBe(true);\n\n    const input = log[0];\n    expect(input).toBeDefined();\n    if (input === undefined) return;\n    const user = userContent(input);\n    expect(user).toContain(content);\n    expect(user).not.toContain(\"truncated\");\n  });\n});\n","numLines":258,"startLine":1,"totalLines":258}}}

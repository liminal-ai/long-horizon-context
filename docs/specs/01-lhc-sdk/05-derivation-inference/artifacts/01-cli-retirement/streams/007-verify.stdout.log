]?.();\\n15\\t}\\n16\\t\\n17\\texport function registeredProviderNames(): string[] {\\n18\\t  return Object.keys(REGISTRY);\\n19\\t}\\n20\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd\",\"uuid\":\"a636d2f9-78df-4912-aa4a-29184fb395a3\",\"timestamp\":\"2026-06-12T20:44:57.260Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/registry.ts\",\"content\":\"// The named-provider registry (DD-11). SDK hosts inject a provider at\\n// createSdk; the CLI — which has no construction step — resolves one here\\n// from `--provider <name>` or LHC_PROVIDER. No default: a provider-needing\\n// command without a resolvable name fails with provider_not_configured,\\n// never a silent no-op.\\nimport type { DerivationProvider } from \\\"../shared/derivation.js\\\";\\nimport { createDeterministicProvider } from \\\"./deterministic.js\\\";\\n\\nconst REGISTRY: Record<string, () => DerivationProvider> = {\\n  deterministic: createDeterministicProvider,\\n};\\n\\nexport function resolveNamedProvider(name: string): DerivationProvider | undefined {\\n  return REGISTRY[name]?.();\\n}\\n\\nexport function registeredProviderNames(): string[] {\\n  return Object.keys(REGISTRY);\\n}\\n\",\"numLines\":20,\"startLine\":1,\"totalLines\":20}}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/01-cli-retirement/streams/006-implementor.stdout.log:96:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01SkRmszMzf5rARFV7axUEMs\",\"type\":\"tool_result\",\"content\":\"1\\texport * from \\\"./sdk.js\\\";\\n2\\texport { runCli } from \\\"./cli/index.js\\\";\\n3\\texport type { CliResult } from \\\"./cli/render.js\\\";\\n4\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd\",\"uuid\":\"4e2c4f63-77c8-4ea3-9ebd-2f6e441b67d6\",\"timestamp\":\"2026-06-12T20:44:57.259Z\",\"tool_use_result
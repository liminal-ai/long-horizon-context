// re-described one (DD-8).\\n8\\t//\\n9\\t// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\n10\\t// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\n11\\t//\\n12\\t// Mode is background — the production posture the PI extension will run —\\n13\\t// and the drain/rebuild phases settle through `drainSettled`, the real\\n14\\t// background awaitable. The post-mutation health snapshot (AC-5.2's\\n15\\t// \\\"cleared set pending\\\") is deterministic because every SDK operation here\\n16\\t// is synchronous SQLite chained through microtasks, while a background\\n17\\t// drain pass always starts on a macrotask (scheduler runLoop defers through\\n18\\t// setImmediate): the edit → delete → health reads inside the mutate phase\\n19\\t// run as one unbroken microtask cascade and complete before the poked drain\\n20\\t// can claim its first item. The rebuild phase then yields via drainSettled\\n21\\t// and the drain runs to empty.\\n22\\timport { join } from \\\"node:path\\\";\\n23\\timport {\\n24\\t  createSdk,\\n25\\t  resolveNamedProvider,\\n26\\t  type BatchResult,\\n27\\t  type CompactReceipt,\\n28\\t  type FormReportEntry,\\n29\\t  type HealthReport,\\n30\\t  type InspectOverview,\\n31\\t  type Lhc,\\n32\\t  type MessageEventInput,\\n33\\t  type MutationResult,\\n34\\t  type OpResult,\\n35\\t  type PullResult,\\n36\\t  type ViewContentsReport,\\n37\\t  type ViewStatus,\\n38\\t} from \\\"../../src/index.js\\\";\\n39\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n40\\t\\n41\\t// ── the one SDK configuration (AC-5.1) ────────────────────────────\\n42\\t//\\n43\\t// Deterministic provider from the production registry (the same resolution\\n44\\t// seam the spawned CLI uses), background mode, zero-backoff retry so a\\n45\\t// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\n46\\t// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\n47\\t// a named \\\"lifecycle\\\" profile so compact runs profile-addressed (story\\n48\\t// scope: \\\"compact (profile)\\\") with all three lower bands non-empty on this\\n49\\t// thread (Epic 03 Story 2's reference gradient).\\n50\\texport const LIFECYCLE_PROFILE = {\\n51\\t  name: \\\"lifecycle\\\",\\n52\\t  lowerBound: 400,\\n53\\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\n54\\t} as const;\\n55\\t\\n56\\texport function createLifecycleSdk(): Lhc {\\n57\\t  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n58\\t  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n59\\t  return createSdk({\\n60\\t    provider,\\n61\\t    mode: \\\"background\\\",\\n62\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n63\\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n64\\t    view: {\\n65\\t      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\n66\\t      // Low threshold so the status checkpoint genuinely recommends the\\n67\\t      // compact the sequence performs next.\\n68\\t      compactThreshold: 300,\\n69\\t    },\\n70\\t  });\\n71\\t}\\n72\\t\\n73\\t// ── the recorded conversation ─────────────────────────────────────\\n74\\t//\\n75\\t// Same shape and text profile as the Epic 03 derived-thread fixture (12\\n76\\t// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\n77\\t// policy cuts the same 4-chunk shape — but with explicit per-run\\n78\\t// idempotency keys so a replay on a fresh thread records byte-identical\\n79\\t// event payloads regardless of any process-global fixture counters.\\n80\\tconst TURN_COUNT = 12;\"}]},\"parent_tool_use_id\":null,\"session_id\":\"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd\",\"uuid\":\"b74bbbda-416e-4a98-8af0-59693ef2115b\",\"timestamp\":\"2026-06-12T20:46:02.181Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts\",\"content\":\"// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\n// driven once, in PI-extension call order, against one real SDK\\n// configuration with the deterministic provider — zero network, zero real\\n// provider, no mocks anywhere. The script owns the sequence and the phase\\n// names (tech design Flow 5); assertions live in the driving tests, so the\\n// replay, teardown, and process legs all run THIS sequence rather than a\\n// re-described one (DD-8).\\n//\\n// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\n// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\n//\\n// Mode is background — the production posture the PI extension will run —\\n// and the drain/rebuild phases settle through `drainSettled`, the real\\n// background awaitable. The post-mutation health snapshot (AC-5.2's\\n// \\\"cleared set pending\\\") is deterministic because every SDK operation here\\n// is synchronous SQLite chained through microtasks, while a background\\n// drain pass always starts on a macrotask (scheduler runLoop defers through\\n// setImmediate): the edit → delete → health reads inside the mutate phase\\n// run as one unbroken microtask cascade and complete before the poked drain\\n// can claim its first item. The rebuild phase then yields via drainSettled\\n// and the drain runs to empty.\\nimport { join } from \\\"node:path\\\";\\nimport {\\n  createSdk,\\n  resolveNamedProvider,\\n  type BatchResult,\\n  type CompactReceipt,\\n  type FormReportEntry,\\n  type HealthReport,\\n  type InspectOverview,\\n  type Lhc,\\n  type MessageEventInput,\\n  type MutationResult,\\n  type OpResult,\\n  type PullResult,\\n  type ViewContentsReport,\\n  type ViewStatus,\\n} from \\\"../../src/index.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\n// ── the one SDK configuration (AC-5.1) ────────────────────────────\\n//\\n// Deterministic provider from the production registry (the same resolution\\n// seam the spawned CLI uses), background mode, zero-backoff retry so a\\n// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\n// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\n// a named \\\"lifecycle\\\" profile so compact runs profile-addressed (story\\n// scope: \\\"compact (profile)\\\") with all three lower bands non-empty on this\\n// thread (Epic 03 Story 2's reference gradient).\\nexport const LIFECYCLE_PROFILE = {\\n  name: \\\"lifecycle\\\",\\n  lowerBound: 400,\\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\n} as const;\\n\\nexport function createLifecycleSdk(): Lhc {\\n  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n  return createSdk({\\n    provider,\\n    mode: \\\"background\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n    view: {\\n      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\n      // Low threshold so the status checkpoint genuinely recommends the\\n      // compact the sequence performs next.\\n      compactThreshold: 300,\\n    },\\n  });\\n}\\n\\n// ── the recorded conversation ─────────────────────────────────────\\n//\\n// Same shape and text profile as the Epic 03 derived-thread fixture (12\\n// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\n// policy cuts the same 4-chunk shape — but with explicit per-run\\n// idempotency keys so a replay on a fresh thread records byte-identical\\n// event payloads regardless of any process-global fixture counters.\\nconst TURN_COUNT = 12;\",\"numLines\":80,\"startLine\":1,\"totalLines\":353}}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/01-cli-retirement/streams/006-implementor.stdout.lo
x.js\\\";\\n15\\timport {\\n16\\t  createScheduler,\\n17\\t  peekThreadId,\\n18\\t  runDrain,\\n19\\t  type DrainDeps,\\n20\\t  type DrainReport,\\n21\\t  type Scheduler,\\n22\\t} from \\\"./scheduler.js\\\";\\n23\\timport {\\n24\\t  runWithInstanceSeam,\\n25\\t  setSchedulerPoke as installSchedulerPoke,\\n26\\t  setThreadTouch,\\n27\\t  type InstanceSeam,\\n28\\t} from \\\"./shared/context.js\\\";\\n29\\timport {\\n30\\t  PROVIDER_OPERATIONS,\\n31\\t  type ResolvedSdkConfig,\\n32\\t  type SdkConfig,\\n33\\t  type WorkHandler,\\n34\\t} from \\\"./shared/derivation.js\\\";\\n35\\timport type { ErrorResult, OpResult } from \\\"./shared/errors.js\\\";\\n36\\timport type {\\n37\\t  CompactReceipt,\\n38\\t  PullResult,\\n39\\t  StoredView,\\n40\\t  SweepReceipt,\\n41\\t  ViewCompactParams,\\n42\\t  ViewProfile,\\n43\\t  ViewStatus,\\n44\\t} from \\\"./shared/view.js\\\";\\n45\\timport type { WorkKind } from \\\"./tech-utils/work-queue/index.js\\\";\\n46\\t\\n47\\texport {\\n48\\t  estimateTokens,\\n49\\t  TOKEN_ESTIMATOR_ID,\\n50\\t} from \\\"./tech-utils/token-counting/index.js\\\";\\n51\\t\\n52\\texport {\\n53\\t  WORK_KIND_REGISTRY,\\n54\\t  type WorkItemRecord,\\n55\\t  type WorkKind,\\n56\\t  type WorkOwner,\\n57\\t  type WorkSourceRef,\\n58\\t} from \\\"./tech-utils/work-queue/index.js\\\";\\n59\\t\\n60\\texport type {\\n61\\t  ErrorClass,\\n62\\t  ErrorCode,\\n63\\t  ErrorResult,\\n64\\t  OpResult,\\n65\\t} from \\\"./shared/errors.js\\\";\\n66\\texport {\\n67\\t  runInTransaction,\\n68\\t  setSchedulerPoke,\\n69\\t  setThreadTouch,\\n70\\t  type OperationContext,\\n71\\t} from \\\"./shared/context.js\\\";\\n72\\t\\n73\\texport {\\n74\\t  createDeterministicProvider,\\n75\\t  deterministicOutcomesSuffix,\\n76\\t  deterministicReceiptsSuffix,\\n77\\t  deterministicText,\\n78\\t  type DeterministicOpName,\\n79\\t} from \\\"./providers/deterministic.js\\\";\\n80\\texport { registeredProviderNames, resolveNamedProvider } from \\\"./providers/registry.js\\\";\\n81\\t\\n82\\texport type {\\n83\\t  CompletionTx,\\n84\\t  DependencyGap,\\n85\\t  DerivationProvider,\\n86\\t  DerivedForm,\\n87\\t  DerivedFormMetadata,\\n88\\t  DerivedFormState,\\n89\\t  FormKind,\\n90\\t  FormReportEntry,\\n91\\t  HandlerFormWrite,\\n92\\t  HandlerOutcome,\\n93\\t  HandlerRunContext,\\n94\\t  ProviderResult,\\n95\\t  RenderingPart,\\n96\\t  ResolvedSdkConfig,\\n97\\t  SdkConfig,\\n98\\t  SubjectKind,\\n99\\t  ToolOutcome,\\n100\\t  ToolRunReceipt,\\n101\\t  WorkHandler,\\n102\\t} from \\\"./shared/derivation.js\\\";\\n103\\texport type { DrainReport, Scheduler, SchedulerMode } from \\\"./scheduler.js\\\";\\n104\\t\\n105\\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\\n106\\t// from Story 0; the operation shapes land with Stories 1–5.\\n107\\texport {\\n108\\t  BUILT_IN_PROFILES,\\n109\\t  DEFAULT_COMPACT_THRESHOLD,\\n110\\t  DEFAULT_VISIBILITY,\\n111\\t} from \\\"./domains/thread-view/index.js\\\";\\n112\\texport type {\\n113\\t  Band,\\n114\\t  CompactReceipt,\\n115\\t  PullResult,\\n116\\t  ResolvedViewConfig,\\n117\\t  SdkViewConfig,\\n118\\t  StoredView,\\n119\\t  SweepReceipt,\\n120\\t  ViewCompactParams,\\n121\\t  ViewMessage,\\n122\\t  ViewMeta,\\n123\\t  ViewProfile,\\n124\\t  ViewProfileOverride,\\n125\\t  ViewStatus,\\n126\\t  VisibilityBudgets,\\n127\\t} from \\\"./shared/view.js\\\";\\n128\\texport {\\n129\\t  countLiveItems,\\n130\\t  enqueue,\\n131\\t  queueDetail,\\n132\\t  supersedeQueued,\\n133\\t  type ClaimedWorkItem,\\n134\\t  type EnqueueFormTarget,\\n135\\t  type EnqueueInput,\\n136\\t  type QueueDetailRow,\\n137\\t} from \\\"./tech-utils/work-queue/index.js\\\";\\n138\\t\\n139\\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\\n140\\t// inspect surface serves.\\n141\\texport type {\\n142\\t  HealthReport,\\n143\\t  InspectOverview,\\n144\\t  ViewContentsReport,\\n145\\t} from \\\"./shared/inspect.js\\\";\\n146\\t\\n147\\texport type { ThreadFileInfo, ThreadRef } from \\\"./domains/threads/index.js\\\";\\n148\\texport type {\\n149\\t  Block,\\n150\\t  BlockType,\\n151\\t  MessageDetail,\\n152\\t  MessageListOptions,\\n153\\t  MessageRecord,\\n154\\t  MutationResult,\\n155\\t} from \\\"./domains/messages/index.js\\\";\\n156\\texport type { ChunkRecord, TurnRecord } from \\\"./domains/turns/index.js\\\";\\n157\\texport type {\\n158\\t  BatchResult,\\n159\\t  EventKind,\\n160\\t  EventRecord,\\n161\\t  MessageEventInput,\\n162\\t} from \\\"./domains/intake-stream/index.js\\\";\\n163\\t\\n164\\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\n165\\t\\n166\\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\n167\\t\\n168\\t// Merge per-domain handler tables into the one join between the queue's\\n169\\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\n170\\t// (each kind has exactly one owner) and throws at construction.\\n171\\texport function assembleWorkHandlerMap(\\n172\\t  tables: ReadonlyArray<WorkHandlerMap>,\\n173\\t): WorkHandlerMap {\\n174\\t  const map: WorkHandlerMap = {};\\n175\\t  for (const table of tables) {\\n176\\t    for (const [kind, handler] of Object.entries(table)) {\\n177\\t      if (map[kind as WorkKind] !== undefined) {\\n178\\t        throw new TypeError(`work kind \\\"${kind}\\\" registered by more than one domain`);\\n179\\t      }\\n180\\t      map[kind as WorkKind] = handler;\\n181\\t    }\\n182\\t  }\\n183\\t  return map;\\n184\\t}\\n185\\t\\n186\\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\n187\\t  return {\\n188\\t    ok: false,\\n189\\t    error: {\\n190\\t      errorClass: \\\"state_corruption\\\",\\n191\\t      code: \\\"unknown_work_kind\\\",\\n192\\t      reason: `no handler registered for work kind \\\"${kind}\\\"`,\\n193\\t    },\\n194\\t  };\\n195\\t}\\n196\\t\\n197\\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\n198\\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\n199\\texport function lookupWorkHandler(\\n200\\t  map: WorkHandlerMap,\\n201\\t  kind: string,\\n202\\t): OpResult<WorkHandler> {\\n203\\t  const handler = map[kind as WorkKind];\\n204\\t  if (handler === undefined) return unknownWorkKind(kind);\\n205\\t  return { ok: true, value: handler };\\n206\\t}\\n207\\t\\n208\\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\n209\\t// requeue land in Story 4.\\n210\\texport interface WorkSurface {\\n211\\t  drain(\\n212\\t    ref: threadsDomain.ThreadRef,\\n213\\t    opts?: { maxItems?: number },\\n214\\t  ): Promise<OpResult<DrainReport>>;\\n215\\t}\\n216\\t\\n217\\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\\n218\\t// §Interface Definitions): the operations only — the Story 0 config\\n219\\t// substrate the domain index also carries is construction machinery, not an\\n220\\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\\n221\\t// inspect domain composes (DD-1).\\n222\\texport interface ThreadViewSurface {\\n223\\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\\n224\\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\\n225\\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\\n226\\t  compact(\\n227\\t    ref: threadsDomain.ThreadRef,\\n228\\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\\n229\\t  ): Promise<OpResult<CompactReceipt>>;\\n230\\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\\n231\\t  materialize(\\n232\\t    ref: threadsDomain.ThreadRef,\\n233\\t    opts: { path: string; format?: \\\"pi-session\\\" },\\n234\\t  ): Promise<OpResult<{ writtenPath: string }>>;\\n235\\t}\\n236\\t\\n237\\texport interface Lhc {\\n238\\t  threads: typeof threadsDomain;\\n239\\t  intakeStream: typeof intakeStreamDomain;\\n240\\t  messages: typeof messagesDomain;\\n241\\t  turns: typeof turnsDomain;\\n242\\t  threadView: ThreadViewSurface;\\n243\\t  // Epic 04: the read-only report surface. Scoped through the instance seam\\n244\\t  // like every other namespace so the status read it composes resolves THIS\\n245\\t  // SDK's view config (threshold, visibility budgets).\\n246\\t  inspect: typeof inspectDomain;\\n247\\t  config: ResolvedSdkConfig;\\n248\\t  scheduler: Scheduler;\\n249\\t  workHandlers: WorkHandlerMap;\\n250\\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\n251\\t  work: WorkSurface;\\n252\\t  // Resolves when the scheduler has no running or pending drain for the\\n253\\t  // thread (issue 3) — the awaitable for background mode, and a no-op\\n254\\t  // resolve in manual mode.\\n255\\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\n256\\t}\\n257\\t\\n258\\tfunction requirePositive(value: number, name: string): void {\\n259\\t  if (!Number.isFinite(value) || value <= 0) {\\n260\\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\n261\\t  }\\n262\\t}\\n263\\t\\n264\\tfunction requireNonNegative(value: number, name: string): void {\\n265\\t  if (!Number.isFinite(value) || value < 0) {\\n266\\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\n267\\t  }\\n268\\t}\\n269\\t\\n270\\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\n271\\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\n272\\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\n273\\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\\n274\\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\n275\\t// object is the same shape as the namespace, so the public surface type holds.\\n276\\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\n277\\t  const scoped: Record<string, unknown> = {};\\n278\\t  for (const key of Object.keys(surface)) {\\n279\\t    const value = (surface as Record<string, unknown>)[key];\\n280\\t    scoped[key] =\\n281\\t      typeof value === \\\"function\\\"\\n282\\t        ? (...args: unknown[]): unknown =>\\n283\\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\n284\\t        : value;\\n285\\t  }\\n286\\t  return scoped as T;\\n287\\t}\\n288\\t\\n289\\t// The only assembly path: provider, mode, clock, and policy enter here.\\n290\\t// Config mistakes are programmer errors at construction and throw; operating\\n291\\t// failures after construction return OpResults per the error contract.\\n292\\texport function createSdk(config: SdkConfig): Lhc {\\n293\\t  if (config.mode !== \\\"background\\\" && config.mode !== \\\"manual\\\") {\\n294\\t    throw new TypeError(\\n295\\t      `createSdk config: mode must be \\\"background\\\" or \\\"manual\\\", got ${JSON.stringify(config.mode)}`,\\n296\\t    );\\n297\\t  }\\n298\\t  if (config.provider === null || typeof config.provider !== \\\"object\\\") {\\n299\\t    throw new TypeError(\\\"createSdk config: provider must implement DerivationProvider\\\");\\n300\\t  }\\n301\\t  for (const operation of PROVIDER_OPERATIONS) {\\n302\\t    if (typeof config.provider[operation] !== \\\"function\\\") {\\n303\\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\n304\\t    }\\n305\\t  }\\n306\\t\\n307\\t  const resolved: ResolvedSdkConfig = {\\n308\\t    provider: config.provider,\\n309\\t    mode: config.mode,\\n310\\t    clock: config.clock ?? (() => new Date()),\\n311\\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\n312\\t    lease: config.lease ?? { durationMs: 120000 },\\n313\\t    chunkPolicy:\\n314\\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\n315\\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\n316\\t    // sums and visibility budgets validated — throws naming the violation.\\n317\\t    view: resolveViewConfig(config.view),\\n318\\t  };\\n319\\t  requirePositive(resolved.retry.budget, \\\"retry.budget\\\");\\n320\\t  requireNonNegative(resolved.retry.backoffBaseMs, \\\"retry.backoffBaseMs\\\");\\n321\\t  requireNonNegative(resolved.retry.backoffCapMs, \\\"retry.backoffCapMs\\\");\\n322\\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\n323\\t    throw new TypeError(\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\");\\n324\\t  }\\n325\\t  requirePositive(resolved.lease.durationMs, \\\"lease.durationMs\\\");\\n326\\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\"chunkPolicy.targetProjectedTokens\\\");\\n327\\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\n328\\t    throw new TypeError(\\n329\\t      \\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\",\\n330\\t    );\\n331\\t  }\\n332\\t\\n333\\t  // Handler maps merge from per-domain contributions at construction (DD-6).\\n334\\t  // The tables are empty until Stories 2–3 land the real handlers; the\\n335\\t  // assembly mechanics are production code from day one.\\n336\\t  const workHandlers = assembleWorkHandlerMap([\\n337\\t    messagesDomain.workHandlers,\\n338\\t    turnsDomain.workHandlers,\\n339\\t  ]);\\n340\\t\\n341\\t  const drainDeps: DrainDeps = {\\n342\\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n343\\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\n344\\t    config: resolved,\\n345\\t  };\\n346\\t  const scheduler = createScheduler(resolved.mode, drainDeps);\\n347\\t\\n348\\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\n349\\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\n350\\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\n351\\t  // background mode, or a no-op in manual mode — isolated from any other SDK\\n352\\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\\n353\\t  // the construction order, because its operations deliver to the no-op seam,\\n354\\t  // not to whatever a background SDK installed below.\\n355\\t  // The seam also carries this instance's resolved view config (Epic 03,\\n356\\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\\n357\\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\\n358\\t  // fall back to the built-in defaults inside the thread-view surface.\\n359\\t  const seam: InstanceSeam =\\n360\\t    resolved.mode === \\\"background\\\"\\n361\\t      ? {\\n362\\t          poke: (threadId) => scheduler.poke(threadId),\\n363\\t          touch: (filePath, db) => scheduler.touch(filePath, db),\\n364\\t          view: resolved.view,\\n365\\t        }\\n366\\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\\n367\\t\\n368\\t  // Background mode also installs the below-SDK default seam so a direct\\n369\\t  // domain call made with no SDK scope — a top-level mutation in the\\n370\\t  // single-background \\\"production path\\\" — still reaches the one installed\\n371\\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\\n372\\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\n373\\t  // leaves the default alone (pokes stay no-ops by contract).\\n374\\t  if (resolved.mode === \\\"background\\\") {\\n375\\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\n376\\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\n377\\t  }\\n378\\t\\n379\\t  const work: WorkSurface = {\\n380\\t    drain: (ref, opts) =>\\n381\\t      runWithInstanceSeam(seam, async () => {\\n382\\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n383\\t        if (!resolvedRef.ok) return resolvedRef;\\n384\\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\n385\\t      }),\\n386\\t  };\\n387\\t\\n388\\t  return {\\n389\\t    threads: threadsDomain,\\n390\\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\\n391\\t    messages: scopeSurface(messagesDomain, seam),\\n392\\t    turns: scopeSurface(turnsDomain, seam),\\n393\\t    threadView: scopeSurface<ThreadViewSurface>(\\n394\\t      {\\n395\\t        pull: threadViewDomain.pull,\\n396\\t        status: threadViewDomain.status,\\n397\\t        describe: threadViewDomain.describe,\\n398\\t        compact: threadViewDomain.compact,\\n399\\t        sweep: threadViewDomain.sweep,\\n400\\t        materialize: threadViewDomain.materialize,\\n401\\t      },\\n402\\t      seam,\\n403\\t    ),\\n404\\t    inspect: scopeSurface(inspectDomain, seam),\\n405\\t    config: resolved,\\n406\\t    scheduler,\\n407\\t    workHandlers,\\n408\\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n409\\t    work,\\n410\\t    drainSettled: async (ref) => {\\n411\\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n412\\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\n413\\t      const threadId = peekThreadId(resolvedRef.value.filePath);\\n414\\t      if (threadId === null) return;\\n415\\t      return scheduler.drainSettled(threadId);\\n416\\t    },\\n417\\t  };\\n418\\t}\\n419\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd\",\"uuid\":\"cad224e2-056e-489f-8d89-0e1244538a14\",\"timestamp\":\"2026-06-12T20:44:56.042Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts\",\"content\":\"export * as threads from \\\"./domains/threads/index.js\\\";\\nexport * as intakeStream from \\\"./domains/intake-stream/index.js\\\";\\nexport * as messages from \\\"./domains/messages/index.js\\\";\\nexport * as turns from \\\"./domains/turns/index.js\\\";\\nexport * as threadView from \\\"./domains/thread-view/index.js\\\";\\nexport * as inspect from \\\"./domains/inspect/index.js\\\";\\n\\nimport * as inspectDomain from \\\"./domains/inspect/index.js\\\";\\nimport * as intakeStreamDomain from \\\"./domains/intake-stream/index.js\\\";\\nimport * as threadViewDomain from \\\"./domains/thread-view/index.js\\\";\\nimport { resolveViewConfig } from \\\"./domains/thread-view/index.js\\\";\\nimport * as messagesDomain from \\\"./domains/messages/index.js\\\";\\nimport * as threadsDomain from \\\"./domains/threads/index.js\\\";\\nimport * as turnsDomain from \\\"./domains/turns/index.js\\\";\\nimport {\\n  createScheduler,\\n  peekThreadId,\\n  runDrain,\\n  type DrainDeps,\\n  type DrainReport,\\n  type Scheduler,\\n} from \\\"./scheduler.js\\\";\\nimport {\\n  runWithInstanceSeam,\\n  setSchedulerPoke as installSchedulerPoke,\\n  setThreadTouch,\\n  type InstanceSeam,\\n} from \\\"./shared/context.js\\\";\\nimport {\\n  PROVIDER_OPERATIONS,\\n  type ResolvedSdkConfig,\\n  type SdkConfig,\\n  type WorkHandler,\\n} from \\\"./shared/derivation.js\\\";\\nimport type { ErrorResult, OpResult } from \\\"./shared/errors.js\\\";\\nimport type {\\n  CompactReceipt,\\n  PullResult,\\n  StoredView,\\n  SweepReceipt,\\n  ViewCompactParams,\\n  ViewProfile,\\n  ViewStatus,\\n} from \\\"./shared/view.js\\\";\\nimport type { WorkKind } from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport {\\n  estimateTokens,\\n  TOKEN_ESTIMATOR_ID,\\n} from \\\"./tech-utils/token-counting/index.js\\\";\\n\\nexport {\\n  WORK_KIND_REGISTRY,\\n  type WorkItemRecord,\\n  type WorkKind,\\n  type WorkOwner,\\n  type WorkSourceRef,\\n} from \\\"./tech-utils/work-queue/index.js\\\";\\n\\nexport type {\\n  ErrorClass,\\n  ErrorCode,\\n  ErrorResult,\\n  OpResult,\\n} from \\\"./shared/errors.js\\\";\\nexport {\\n  runInTransaction,\\n  setSchedulerPoke,\\n  setThreadTouch,\\n  type OperationContext,\\n} from \\\"./shared/context.js\\\";\\n\\nexport {\\n  createDeterministicProvider,\\n  deterministicOutcomesSuffix,\\n  deterministicReceiptsSuffix,\\n  deterministicText,\\n  type DeterministicOpName,\\n} from \\\"./providers/deterministic.js\\\";\\nexport { registeredProviderNames, resolveNamedProvider } from \\\"./providers/registry.js\\\";\\n\\nexport type {\\n  CompletionTx,\\n  DependencyGap,\\n  DerivationProvider,\\n  DerivedForm,\\n  DerivedFormMetadata,\\n  DerivedFormState,\\n  FormKind,\\n  FormReportEntry,\\n  HandlerFormWrite,\\n  HandlerOutcome,\\n  HandlerRunContext,\\n  ProviderResult,\\n  RenderingPart,\\n  ResolvedSdkConfig,\\n  SdkConfig,\\n  SubjectKind,\\n  ToolOutcome,\\n  ToolRunReceipt,\\n  WorkHandler,\\n} from \\\"./shared/derivation.js\\\";\\nexport type { DrainReport, Scheduler, SchedulerMode } from \\\"./scheduler.js\\\";\\n\\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\\n// from Story 0; the operation shapes land with Stories 1–5.\\nexport {\\n  BUILT_IN_PROFILES,\\n  DEFAULT_COMPACT_THRESHOLD,\\n  DEFAULT_VISIBILITY,\\n} from \\\"./domains/thread-view/index.js\\\";\\nexport type {\\n  Band,\\n  CompactReceipt,\\n  PullResult,\\n  ResolvedViewConfig,\\n  SdkViewConfig,\\n  StoredView,\\n  SweepReceipt,\\n  ViewCompactParams,\\n  ViewMessage,\\n  ViewMeta,\\n  ViewProfile,\\n  ViewProfileOverride,\\n  ViewStatus,\\n  VisibilityBudgets,\\n} from \\\"./shared/view.js\\\";\\nexport {\\n  countLiveItems,\\n  enqueue,\\n  queueDetail,\\n  supersedeQueued,\\n  type ClaimedWorkItem,\\n  type EnqueueFormTarget,\\n  type EnqueueInput,\\n  type QueueDetailRow,\\n} from \\\"./tech-utils/work-queue/index.js\\\";\\n\\n// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\\n// inspect surface serves.\\nexport type {\\n  HealthReport,\\n  InspectOverview,\\n  ViewContentsReport,\\n} from \\\"./shared/inspect.js\\\";\\n\\nexport type { ThreadFileInfo, ThreadRef } from \\\"./domains/threads/index.js\\\";\\nexport type {\\n  Block,\\n  BlockType,\\n  MessageDetail,\\n  MessageListOptions,\\n  MessageRecord,\\n  MutationResult,\\n} from \\\"./domains/messages/index.js\\\";\\nexport type { ChunkRecord, TurnRecord } from \\\"./domains/turns/index.js\\\";\\nexport type {\\n  BatchResult,\\n  EventKind,\\n  EventRecord,\\n  MessageEventInput,\\n} from \\\"./domains/intake-stream/index.js\\\";\\n\\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\n\\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\n\\n// Merge per-domain handler tables into the one join between the queue's\\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\n// (each kind has exactly one owner) and throws at construction.\\nexport function assembleWorkHandlerMap(\\n  tables: ReadonlyArray<WorkHandlerMap>,\\n): WorkHandlerMap {\\n  const map: WorkHandlerMap = {};\\n  for (const table of tables) {\\n    for (const [kind, handler] of Object.entries(table)) {\\n      if (map[kind as WorkKind] !== undefined) {\\n        throw new TypeError(`work kind \\\"${kind}\\\" registered by more than one domain`);\\n      }\\n      map[kind as WorkKind] = handler;\\n    }\\n  }\\n  return map;\\n}\\n\\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"state_corruption\\\",\\n      code: \\\"unknown_work_kind\\\",\\n      reason: `no handler registered for work kind \\\"${kind}\\\"`,\\n    },\\n  };\\n}\\n\\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\nexport function lookupWorkHandler(\\n  map: WorkHandlerMap,\\n  kind: string,\\n): OpResult<WorkHandler> {\\n  const handler = map[kind as WorkKind];\\n  if (handler === undefined) return unknownWorkKind(kind);\\n  return { ok: true, value: handler };\\n}\\n\\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\n// requeue land in Story 4.\\nexport interface WorkSurface {\\n  drain(\\n    ref: threadsDomain.ThreadRef,\\n    opts?: { maxItems?: number },\\n  ): Promise<OpResult<DrainReport>>;\\n}\\n\\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\\n// §Interface Definitions): the operations only — the Story 0 config\\n// substrate the domain index also carries is construction machinery, not an\\n// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\\n// inspect domain composes (DD-1).\\nexport interface ThreadViewSurface {\\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\\n  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\\n  compact(\\n    ref: threadsDomain.ThreadRef,\\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\\n  ): Promise<OpResult<CompactReceipt>>;\\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\\n  materialize(\\n    ref: threadsDomain.ThreadRef,\\n    opts: { path: string; format?: \\\"pi-session\\\" },\\n  ): Promise<OpResult<{ writtenPath: string }>>;\\n}\\n\\nexport interface Lhc {\\n  threads: typeof threadsDomain;\\n  intakeStream: typeof intakeStreamDomain;\\n  messages: typeof messagesDomain;\\n  turns: typeof turnsDomain;\\n  threadView: ThreadViewSurface;\\n  // Epic 04: the read-only report surface. Scoped through the instance seam\\n  // like every other namespace so the status read it composes resolves THIS\\n  // SDK's view config (threshold, visibility budgets).\\n  inspect: typeof inspectDomain;\\n  config: ResolvedSdkConfig;\\n  scheduler: Scheduler;\\n  workHandlers: WorkHandlerMap;\\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\n  work: WorkSurface;\\n  // Resolves when the scheduler has no running or pending drain for the\\n  // thread (issue 3) — the awaitable for background mode, and a no-op\\n  // resolve in manual mode.\\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\n}\\n\\nfunction requirePositive(value: number, name: string): void {\\n  if (!Number.isFinite(value) || value <= 0) {\\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\n  }\\n}\\n\\nfunction requireNonNegative(value: number, name: string): void {\\n  if (!Number.isFinite(value) || value < 0) {\\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\n  }\\n}\\n\\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\n// object is the same shape as the namespace, so the public surface type holds.\\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\n  const scoped: Record<string, unknown> = {};\\n  for (const key of Object.keys(surface)) {\\n    const value = (surface as Record<string, unknown>)[key];\\n    scoped[key] =\\n      typeof value === \\\"function\\\"\\n        ? (...args: unknown[]): unknown =>\\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\n        : value;\\n  }\\n  return scoped as T;\\n}\\n\\n// The only assembly path: provider, mode, clock, and policy enter here.\\n// Config mistakes are programmer errors at construction and throw; operating\\n// failures after construction return OpResults per the error contract.\\nexport function createSdk(config: SdkConfig): Lhc {\\n  if (config.mode !== \\\"background\\\" && config.mode !== \\\"manual\\\") {\\n    throw new TypeError(\\n      `createSdk config: mode must be \\\"background\\\" or \\\"manual\\\", got ${JSON.stringify(config.mode)}`,\\n    );\\n  }\\n  if (config.provider === null || typeof config.provider !== \\\"object\\\") {\\n    throw new TypeError(\\\"createSdk config: provider must implement DerivationProvider\\\");\\n  }\\n  for (const operation of PROVIDER_OPERATIONS) {\\n    if (typeof config.provider[operation] !== \\\"function\\\") {\\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\n    }\\n  }\\n\\n  const resolved: ResolvedSdkConfig = {\\n    provider: config.provider,\\n    mode: config.mode,\\n    clock: config.clock ?? (() => new Date()),\\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\n    lease: config.lease ?? { durationMs: 120000 },\\n    chunkPolicy:\\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\n    // sums and visibility budgets validated — throws naming the violation.\\n    view: resolveViewConfig(config.view),\\n  };\\n  requirePositive(resolved.retry.budget, \\\"retry.budget\\\");\\n  requireNonNegative(resolved.retry.backoffBaseMs, \\\"retry.backoffBaseMs\\\");\\n  requireNonNegative(resolved.retry.backoffCapMs, \\\"retry.backoffCapMs\\\");\\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\n    throw new TypeError(\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\");\\n  }\\n  requirePositive(resolved.lease.durationMs, \\\"lease.durationMs\\\");\\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\"chunkPolicy.targetProjectedTokens\\\");\\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\n    throw new TypeError(\\n      \\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\",\\n    );\\n  }\\n\\n  // Handler maps merge from per-domain contributions at construction (DD-6).\\n  // The tables are empty until Stories 2–3 land the real handlers; the\\n  // assembly mechanics are production code from day one.\\n  const workHandlers = assembleWorkHandlerMap([\\n    messagesDomain.workHandlers,\\n    turnsDomain.workHandlers,\\n  ]);\\n\\n  const drainDeps: DrainDeps = {\\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\n    config: resolved,\\n  };\\n  const scheduler = createScheduler(resolved.mode, drainDeps);\\n\\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\n  // background mode, or a no-op in manual mode — isolated from any other SDK\\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\\n  // the construction order, because its operations deliver to the no-op seam,\\n  // not to whatever a background SDK installed below.\\n  // The seam also carries this instance's resolved view config (Epic 03,\\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\\n  // fall back to the built-in defaults inside the thread-view surface.\\n  const seam: InstanceSeam =\\n    resolved.mode === \\\"background\\\"\\n      ? {\\n          poke: (threadId) => scheduler.poke(threadId),\\n          touch: (filePath, db) => scheduler.touch(filePath, db),\\n          view: resolved.view,\\n        }\\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\\n\\n  // Background mode also installs the below-SDK default seam so a direct\\n  // domain call made with no SDK scope — a top-level mutation in the\\n  // single-background \\\"production path\\\" — still reaches the one installed\\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\n  // leaves the default alone (pokes stay no-ops by contract).\\n  if (resolved.mode === \\\"background\\\") {\\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\n  }\\n\\n  const work: WorkSurface = {\\n    drain: (ref, opts) =>\\n      runWithInstanceSeam(seam, async () => {\\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n        if (!resolvedRef.ok) return resolvedRef;\\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\n      }),\\n  };\\n\\n  return {\\n    threads: threadsDomain,\\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\\n    messages: scopeSurface(messagesDomain, seam),\\n    turns: scopeSurface(turnsDomain, seam),\\n    threadView: scopeSurface<ThreadViewSurface>(\\n      {\\n        pull: threadViewDomain.pull,\\n        status: threadViewDomain.status,\\n        describe: threadViewDomain.describe,\\n        compact: threadViewDomain.compact,\\n        sweep: threadViewDomain.sweep,\\n        materialize: threadViewDomain.materialize,\\n      },\\n      seam,\\n    ),\\n    inspect: scopeSurface(inspectDomain, seam),\\n    config: resolved,\\n    scheduler,\\n    workHandlers,\\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n    work,\\n    drainSettled: async (ref) => {\\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\n      const threadId = peekThreadId(resolvedRef.value.filePath);\\n      if (threadId === null) return;\\n      return scheduler.drainSettled(threadId);\\n    },\\n  };\\n}\\n\",\"numLines\":419,\"startLine\":1,\"totalLines\":419}}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/01-cli-retirement/streams/006-implementor.stdout.log:86:{\"type\":\"assistant\",
{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/retirement.test.ts | sed -n '1,140p'\"","aggregated_output":"     1\t// Epic 05 Story 1 (Flow 6): CLI retirement proof — TC-6.1, TC-6.2.\n     2\t// The package publishes an SDK-only surface: no binary, no named-provider\n     3\t// registry, no env/flag provider resolution. Deletion is proven three ways:\n     4\t// an export-name snapshot of the package entry (catches both leftover\n     5\t// CLI-only exports and accidental removals), a manifest check, and a\n     6\t// source-level scan for the retired resolution vocabulary. Provider arrival\n     7\t// is injection at createSdk only.\n     8\timport { existsSync, readdirSync, readFileSync, statSync } from \"node:fs\";\n     9\timport path from \"node:path\";\n    10\timport { fileURLToPath } from \"node:url\";\n    11\timport { afterEach, describe, expect, it } from \"vitest\";\n    12\timport * as api from \"../src/index.js\";\n    13\timport { createSdk, type SdkConfig } from \"../src/index.js\";\n    14\t\n    15\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    16\t\n    17\t// The checked-in SDK-only surface (AC-6.1). A diff here is an intentional\n    18\t// public-API change: update the list in the same change that alters the\n    19\t// exports, never to quiet the test.\n    20\tconst SDK_ONLY_EXPORTS = [\n    21\t  \"BUILT_IN_PROFILES\",\n    22\t  \"DEFAULT_COMPACT_THRESHOLD\",\n    23\t  \"DEFAULT_VISIBILITY\",\n    24\t  \"TOKEN_ESTIMATOR_ID\",\n    25\t  \"WORK_KIND_REGISTRY\",\n    26\t  \"assembleWorkHandlerMap\",\n    27\t  \"countLiveItems\",\n    28\t  \"createDeterministicProvider\",\n    29\t  \"createSdk\",\n    30\t  \"deterministicOutcomesSuffix\",\n    31\t  \"deterministicReceiptsSuffix\",\n    32\t  \"deterministicText\",\n    33\t  \"enqueue\",\n    34\t  \"estimateTokens\",\n    35\t  \"inspect\",\n    36\t  \"intakeStream\",\n    37\t  \"lookupWorkHandler\",\n    38\t  \"messages\",\n    39\t  \"queueDetail\",\n    40\t  \"runInTransaction\",\n    41\t  \"setSchedulerPoke\",\n    42\t  \"setThreadTouch\",\n    43\t  \"supersedeQueued\",\n    44\t  \"threadView\",\n    45\t  \"threads\",\n    46\t  \"turns\",\n    47\t];\n    48\t\n    49\tfunction collectSourceFiles(dir: string, out: string[] = []): string[] {\n    50\t  for (const entry of readdirSync(dir)) {\n    51\t    const full = path.join(dir, entry);\n    52\t    if (statSync(full).isDirectory()) collectSourceFiles(full, out);\n    53\t    else out.push(full);\n    54\t  }\n    55\t  return out;\n    56\t}\n    57\t\n    58\tdescribe(\"TC-6.1: deletion proof — SDK-only public API, no binary (AC-6.1, AC-6.2)\", () => {\n    59\t  it(\"the package entry's export-name set equals the checked-in SDK-only list\", () => {\n    60\t    expect(Object.keys(api).sort()).toEqual(SDK_ONLY_EXPORTS);\n    61\t  });\n    62\t\n    63\t  it(\"the CLI-only entries are gone from the surface\", () => {\n    64\t    const names = new Set(Object.keys(api));\n    65\t    expect(names.has(\"resolveNamedProvider\")).toBe(false);\n    66\t    expect(names.has(\"registeredProviderNames\")).toBe(false);\n    67\t    expect(names.has(\"runCli\")).toBe(false);\n    68\t  });\n    69\t\n    70\t  it(\"the package manifest publishes no binary and no CLI script\", () => {\n    71\t    const manifest = JSON.parse(readFileSync(path.join(pkgRoot, \"package.json\"), \"utf8\")) as {\n    72\t      bin?: unknown;\n    73\t      scripts?: Record<string, string>;\n    74\t    };\n    75\t    expect(manifest.bin).toBeUndefined();\n    76\t    expect(manifest.scripts?.[\"dev:cli\"]).toBeUndefined();\n    77\t    for (const command of Object.values(manifest.scripts ?? {})) {\n    78\t      expect(command).not.toContain(\"LHC_PROCESS_SUITE\");\n    79\t    }\n    80\t  });\n    81\t\n    82\t  it(\"the CLI surface, registry module, and spawned-process suites are deleted\", () => {\n    83\t    expect(existsSync(path.join(pkgRoot, \"src\", \"cli\"))).toBe(false);\n    84\t    expect(existsSync(path.join(pkgRoot, \"src\", \"cli.ts\"))).toBe(false);\n    85\t    expect(existsSync(path.join(pkgRoot, \"src\", \"providers\", \"registry.ts\"))).toBe(false);\n    86\t    const processSuites = readdirSync(path.join(pkgRoot, \"test\")).filter((name) =>\n    87\t      name.startsWith(\"cli-process\"),\n    88\t    );\n    89\t    expect(processSuites).toEqual([]);\n    90\t  });\n    91\t});\n    92\t\n    93\tdescribe(\"TC-6.2: the env/flag provider-resolution path is gone (AC-6.3)\", () => {\n    94\t  const envKey = [\"LHC\", \"PROVIDER\"].join(\"_\"); // composed so the scan below stays meaningful\n    95\t  const flag = \"--\" + \"provider\";\n    96\t\n    97\t  it(\"zero LHC_PROVIDER / --provider references under src/\", () => {\n    98\t    const hits: string[] = [];\n    99\t    for (const file of collectSourceFiles(path.join(pkgRoot, \"src\"))) {\n   100\t      const source = readFileSync(file, \"utf8\");\n   101\t      if (source.includes(envKey) || source.includes(flag)) {\n   102\t        hits.push(path.relative(pkgRoot, file));\n   103\t      }\n   104\t    }\n   105\t    expect(hits).toEqual([]);\n   106\t  });\n   107\t\n   108\t  const priorEnv = process.env[envKey];\n   109\t  afterEach(() => {\n   110\t    if (priorEnv === undefined) delete process.env[envKey];\n   111\t    else process.env[envKey] = priorEnv;\n   112\t  });\n   113\t\n   114\t  it(\"neither provider nor inference is the XOR TypeError; no fallback resolution catches it\", () => {\n   115\t    // Even with the retired env variable set, construction must throw: the\n   116\t    // only provider-arrival path is injection at createSdk.\n   117\t    process.env[envKey] = \"deterministic\";\n   118\t    expect(() => createSdk({ mode: \"manual\" } as unknown as SdkConfig)).toThrow(TypeError);\n   119\t    expect(() => createSdk({ mode: \"manual\" } as unknown as SdkConfig)).toThrow(\n   120\t      /exactly one of provider or inference/,\n   121\t    );\n   122\t  });\n   123\t});\n","exit_code":0,"status":"completed"}}

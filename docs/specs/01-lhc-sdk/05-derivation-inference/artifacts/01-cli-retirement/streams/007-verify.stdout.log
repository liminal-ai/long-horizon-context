  ViewMessage,\n   120\t  ViewMeta,\n   121\t  ViewProfile,\n   122\t  ViewProfileOverride,\n   123\t  ViewStatus,\n   124\t  VisibilityBudgets,\n   125\t} from \"./shared/view.js\";\n   126\texport {\n   127\t  countLiveItems,\n   128\t  enqueue,\n   129\t  queueDetail,\n   130\t  supersedeQueued,\n   131\t  type ClaimedWorkItem,\n   132\t  type EnqueueFormTarget,\n   133\t  type EnqueueInput,\n   134\t  type QueueDetailRow,\n   135\t} from \"./tech-utils/work-queue/index.js\";\n   136\t\n   137\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n   138\t// inspect surface serves.\n   139\texport type {\n   140\t  HealthReport,\n   141\t  InspectOverview,\n   142\t  ViewContentsReport,\n   143\t} from \"./shared/inspect.js\";\n   144\t\n   145\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n   146\texport type {\n   147\t  Block,\n   148\t  BlockType,\n   149\t  MessageDetail,\n   150\t  MessageListOptions,\n   151\t  MessageRecord,\n   152\t  MutationResult,\n   153\t} from \"./domains/messages/index.js\";\n   154\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   155\texport type {\n   156\t  BatchResult,\n   157\t  EventKind,\n   158\t  EventRecord,\n   159\t  MessageEventInput,\n   160\t} from \"./domains/intake-stream/index.js\";\n   161\t\n   162\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   163\t\n   164\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   165\t\n   166\t// Merge per-domain handler tables into the one join between the queue's\n   167\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   168\t// (each kind has exactly one owner) and throws at construction.\n   169\texport function assembleWorkHandlerMap(\n   170\t  tables: ReadonlyArray<WorkHandlerMap>,\n   171\t): WorkHandlerMap {\n   172\t  const map: WorkHandlerMap = {};\n   173\t  for (const table of tables) {\n   174\t    for (const [kind, handler] of Object.entries(table)) {\n   175\t      if (map[kind as WorkKind] !== undefined) {\n   176\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   177\t      }\n   178\t      map[kind as WorkKind] = handler;\n   179\t    }\n   180\t  }\n   181\t  return map;\n   182\t}\n   183\t\n   184\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   185\t  return {\n   186\t    ok: false,\n   187\t    error: {\n   188\t      errorClass: \"state_corruption\",\n   189\t      code: \"unknown_work_kind\",\n   190\t      reason: `no handler registered for work kind \"${kind}\"`,\n   191\t    },\n   192\t  };\n   193\t}\n   194\t\n   195\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   196\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   197\texport function lookupWorkHandler(\n   198\t  map: WorkHandlerMap,\n   199\t  kind: string,\n   200\t): OpResult<WorkHandler> {\n   201\t  const handler = map[kind as WorkKind];\n   202\t  if (handler === undefined) return unknownWorkKind(kind);\n   203\t  return { ok: true, value: handler };\n   204\t}\n   205\t\n   206\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   207\t// requeue land in Story 4.\n   208\texport interface WorkSurface {\n   209\t  drain(\n   210\t    ref: threadsDomain.ThreadRef,\n   211\t    opts?: { maxItems?: number },\n   212\t  ): Promise<OpResult<DrainReport>>;\n   213\t}\n   214\t\n   215\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n   216\t// §Interface Definitions): the operations only — the Story 0 config\n   217\t// substrate the domain index also carries is construction machinery, not an\n   218\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n   219\t// inspect domain composes (DD-1).\n   220\texport interface ThreadViewSurface {\n   221\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n   222\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n   223\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n   224\t  compact(\n   225\t    ref: threadsDomain.ThreadRef,\n   226\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   227\t  ): Promise<OpResult<CompactReceipt>>;\n   228\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n   229\t  materialize(\n   230\t    ref: threadsDomain.ThreadRef,\n   231\t    opts: { path: string; format?: \"pi-session\" },\n   232\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   233\t}\n   234\t\n   235\texport interface Lhc {\n   236\t  threads: typeof threadsDomain;\n   237\t  intakeStream: typeof intakeStreamDomain;\n   238\t  messages: typeof messagesDomain;\n   239\t  turns: typeof turnsDomain;\n   240\t  threadView: ThreadViewSurface;\n   241\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n   242\t  // like every other namespace so the status read it composes resolves THIS\n   243\t  // SDK's view config (threshold, visibility budgets).\n   244\t  inspect: typeof inspectDomain;\n   245\t  config: ResolvedSdkConfig;\n   246\t  scheduler: Scheduler;\n   247\t  workHandlers: WorkHandlerMap;\n   248\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   249\t  work: WorkSurface;\n   250\t  // Resolves when the scheduler has no running or pending drain for the\n   251\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   252\t  // resolve in manual mode.\n   253\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   254\t}\n   255\t\n   256\tfunction requirePositive(value: number, name: string): void {\n   257\t  if (!Number.isFinite(value) || value <= 0) {\n   258\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   259\t  }\n   260\t}\n   261\t\n   262\tfunction requireNonNegative(value: number, name: string): void {\n   263\t  if (!Number.isFinite(value) || value < 0) {\n   264\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   265\t  }\n   266\t}\n   267\t\n   268\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   269\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   270\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   271\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   272\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   273\t// object is the same shape as the namespace, so the public surface type holds.\n   274\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   275\t  const scoped: Record<string, unknown> = {};\n   276\t  for (const key of Object.keys(surface)) {\n   277\t    const value = (surface as Record<string, unknown>)[key];\n   278\t    scoped[key] =\n   279\t      typeof value === \"function\"\n   280\t        ? (...args: unknown[]): unknown =>\n   281\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   282\t        : value;\n   283\t  }\n   284\t  return scoped as T;\n   285\t}\n   286\t\n   287\t// The only assembly path: provider, mode, clock, and policy enter here.\n   288\t// Config mistakes are programmer errors at construction and throw; operating\n   289\t// failures after construction return OpResults per the error contract.\n   290\texport function createSdk(config: SdkConfig): Lhc {\n   291\t  // Provider arrival is injection at construction only (Epic 05 Flow 6):\n   292\t  // there is no named-provider registry and no env/flag resolution path left\n   293\t  // to fall back on. The `inference` alternative lands in Story 2; the XOR\n   294\t  // rule is named from day one so a missing provider reports the final\n   295\t  // contract, not a downstream symptom.\n   296\t  if (config.provider === undefined && (config as { inference?: unknown }).inference === undefined) {\n   297\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   298\t  }\n   299\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   300\t    throw new TypeError(\n   301\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   302\t    );\n   303\t  }\n   304\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   305\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   306\t  }\n   307\t  for (const operation of PROVIDER_OPERATIONS) {\n   308\t    if (typeof config.provider[operation] !== \"function\") {\n   309\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   310\t    }\n   311\t  }\n   312\t\n   313\t  const resolved: ResolvedSdkConfig = {\n   314\t    provider: config.provider,\n   315\t    mode: config.mode,\n   316\t    clock: config.clock ?? (() => new Date()),\n   317\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   318\t    lease: config.lease ?? { durationMs: 120000 },\n   319\t    chunkPolicy:\n   320\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   321\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   322\t    // sums and visibility budgets validated — throws naming the violation.\n   323\t    view: resolveViewConfig(config.view),\n   324\t  };\n   325\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   326\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   327\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   328\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   329\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   330\t  }\n","exit_code":0,"status":"completed"}}

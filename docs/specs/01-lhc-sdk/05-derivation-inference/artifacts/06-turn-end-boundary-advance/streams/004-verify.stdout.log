   \\\"expectedZoneTokens\\\": 80\\n    },\\n    {\\n      \\\"label\\\": \\\"B3 crosses max: t3 closes at zone 120 > 100; whole-turn walk excluding the newest closed turn: evict t1 (remaining 80 >= target 60), peek t2 would leave 40 < 60 -> stop; position = t1's last result (order 5)\\\",\\n      \\\"resultTokens\\\": [20, 20],\\n      \\\"turnEnd\\\": true,\\n      \\\"expectedPosition\\\": 5,\\n      \\\"expectedZoneTokens\\\": 80\\n    },\\n    {\\n      \\\"label\\\": \\\"B4 under max after the advance: t4 closes at zone 90 <= 100, no movement (never backward, no churn)\\\",\\n      \\\"resultTokens\\\": [10],\\n      \\\"turnEnd\\\": true,\\n      \\\"expectedPosition\\\": 5,\\n      \\\"expectedZoneTokens\\\": 90\\n    },\\n    {\\n      \\\"label\\\": \\\"B5 mid-turn: t5 stays open with zone 170 > 100; no turn_end commits, so no check runs and the boundary holds (AC-5.1)\\\",\\n      \\\"resultTokens\\\": [40, 40],\\n      \\\"turnEnd\\\": false,\\n      \\\"expectedPosition\\\": 5,\\n      \\\"expectedZoneTokens\\\": 170\\n    },\\n    {\\n      \\\"label\\\": \\\"B6 the close heals: the prompt closes t5 (close_then_open) and the turn_end commits; zone 170 > 100; walk evicts t2 (130 >= 60), t3 (90 >= 60), t4 (80 >= 60) and stops at the newest closed turn t5 (80, never a candidate); position = t4's result (order 21)\\\",\\n      \\\"resultTokens\\\": [],\\n      \\\"turnEnd\\\": true,\\n      \\\"expectedPosition\\\": 21,\\n      \\\"expectedZoneTokens\\\": 80\\n    }\\n  ]\\n}\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":524,\"cache_read_input_tokens\":161498,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":524},\"output_tokens\":73,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"bb1f3fcf-4d
  visibility: {\npackages/lhc/src/domains/inspect/internal/overview.ts:154:        zoneTokens: status.value.visibility.zoneTokens,\npackages/lhc/src/domains/threads/internal/create.ts:124:      // visibility boundary (seeded at position 0) — the epic's single\npackages/lhc/src/domains/thread-view/internal/boundary.ts:8:import type { VisibilityBudgets } from \"../../../shared/view.js\";\npackages/lhc/src/domains/thread-view/internal/boundary.ts:23:// The visibility zone's token sum: live (deleted-filtered) tool results ahead\npackages/lhc/src/domains/thread-view/internal/boundary.ts:30:export function visibilityZoneTokens(\npackages/lhc/src/domains/thread-view/internal/boundary.ts:66:// The zone's member rows: the same population visibilityZoneTokens sums —\npackages/lhc/src/domains/thread-view/internal/boundary.ts:152:  budgets: VisibilityBudgets,\npackages/lhc/src/domains/thread-view/internal/boundary.ts:157:  if (total <= budgets.maxTokens) return null;\npackages/lhc/src/domains/thread-view/internal/boundary.ts:169:    if (remaining - group.tokenSum < budgets.targetTokens) break;\npackages/lhc/src/domains/thread-view/internal/boundary.ts:183:  budgets: VisibilityBudgets,\npackages/lhc/src/domains/thread-view/internal/boundary.ts:188:  if (visibilityZoneTokens(db, position, compactPoint) <= budgets.maxTokens) return;\npackages/lhc/src/domains/thread-view/internal/profiles.ts:3:// band shares sum to 100, lower bound positive, visibility max > target.\npackages/lhc/src/domains/thread-view/internal/profiles.ts:12:  VisibilityBudgets,\npackages/lhc/src/domains/thread-view/internal/profiles.ts:35:export const DEFAULT_VISIBILITY: VisibilityBudgets = {\npackages/lhc/src/domains/thread-view/internal/profiles.ts:36:  maxTokens: 64000,\npackages/lhc/src/domains/thread-view/internal/profiles.ts:37:  targetTokens: 32000,\npackages/lhc/src/domains/thread-view/internal/profiles.ts:118:const BUDGET_KEYS = [\"maxTokens\", \"targetTokens\"] as const;\npackages/lhc/src/domains/threa
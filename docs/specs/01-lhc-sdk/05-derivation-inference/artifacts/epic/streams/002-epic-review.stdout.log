{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'for f in packages/lhc/src/inference/prompts/*.ts; do echo \"--- $f\"; nl -ba \"$f\" | sed -n '\"'1,220p'; done\"","aggregated_output":"--- packages/lhc/src/inference/prompts/chunk-brief-v1.ts\n     1\t// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n     2\t// period produces the tuned text under a new versioned name. Receipt text is\n     3\t// structurally absent here: the brief handler strips it before the provider\n     4\t// is called (AC-3.8) and this template's input carries outcomes only.\n     5\timport type { ToolOutcome } from \"../../shared/derivation.js\";\n     6\timport type { PromptTemplate } from \"./index.js\";\n     7\t\n     8\tfunction outcomesSection(memberOutcomes?: ToolOutcome[][]): string {\n     9\t  const outcomes = (memberOutcomes ?? []).flat();\n    10\t  if (outcomes.length === 0) return \"\";\n    11\t  return `\\n\\nTool outcomes, in order: ${outcomes.join(\", \")}`;\n    12\t}\n    13\t\n    14\texport const chunkBriefV1: PromptTemplate<{\n    15\t  memberProjections: string[];\n    16\t  memberOutcomes?: ToolOutcome[][];\n    17\t}> = {\n    18\t  name: \"chunk-brief-v1\",\n    19\t  render: (i) => [\n    20\t    {\n    21\t      role: \"system\",\n    22\t      content:\n    23\t        \"You write a brief summary of a sequence of conversation turns. State what was worked on and what was accomplished, and reflect the tool outcomes given. No detail beyond outcomes, no speculation, three sentences maximum.\",\n    24\t    },\n    25\t    {\n    26\t      role: \"user\",\n    27\t      content:\n    28\t        `Turns, in order:\\n\\n${i.memberProjections\n    29\t          .map((projection, idx) => `${String(idx + 1)}. ${projection}`)\n    30\t          .join(\"\\n\\n\")}` + outcomesSection(i.memberOutcomes),\n    31\t    },\n    32\t  ],\n    33\t};\n--- packages/lhc/src/inference/prompts/chunk-detailed-v1.ts\n     1\t// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n     2\t// period produces the tuned text under a new versioned name.\n     3\timport type { ToolRunReceipt } from \"../../shared/derivation.js\";\n     4\timport type { PromptTemplate } from \"./index.js\";\n     5\t\n     6\tfunction receiptsSection(memberReceipts?: ToolRunReceipt[][]): string {\n     7\t  const receipts = (memberReceipts ?? []).flat();\n     8\t  if (receipts.length === 0) return \"\";\n     9\t  const lines = receipts.map((r) => `- ${r.account} => ${r.outcome}`);\n    10\t  return `\\n\\nTool-run receipts (what changed, outcome):\\n${lines.join(\"\\n\")}`;\n    11\t}\n    12\t\n    13\texport const chunkDetailedV1: PromptTemplate<{\n    14\t  memberProjections: string[];\n    15\t  memberReceipts?: ToolRunReceipt[][];\n    16\t}> = {\n    17\t  name: \"chunk-detailed-v1\",\n    18\t  render: (i) => [\n    19\t    {\n    20\t      role: \"system\",\n    21\t      content:\n    22\t        \"You summarize a sequence of conversation turns for an engineering record. Preserve the arc of the work, decisions made, and concrete facts: paths, identifiers, counts, error text. Use the tool-run receipts as the authority on what changed and each outcome. No commentary, no speculation, 150 words maximum.\",\n    23\t    },\n    24\t    {\n    25\t      role: \"user\",\n    26\t      content:\n    27\t        `Turns, in order:\\n\\n${i.memberProjections\n    28\t          .map((projection, idx) => `${String(idx + 1)}. ${projection}`)\n    29\t          .join(\"\\n\\n\")}` + receiptsSection(i.memberReceipts),\n    30\t    },\n    31\t  ],\n    32\t};\n--- packages/lhc/src/inference/prompts/index.ts\n     1\t// The name-keyed prompt registry (DD-8): one module per template exporting\n     2\t// `{ name, render(input) → messages }`; config selects by name and dial-in\n     3\t// swaps by adding a module and editing config — no handler, adapter, or host\n     4\t// changes. Versioning is in the name (`smoothing-v1`).\n     5\timport type { FormKind } from \"../../shared/derivation.js\";\n     6\timport type { ModelCallInput } from \"../types.js\";\n     7\timport { chunkBriefV1 } from \"./chunk-brief-v1.js\";\n     8\timport { chunkDetailedV1 } from \"./chunk-detailed-v1.js\";\n     9\timport { lowerBandV1 } from \"./lower-band-v1.js\";\n    10\timport { smoothingV1 } from \"./smoothing-v1.js\";\n    11\timport { toolCallV1 } from \"./tool-call-v1.js\";\n    12\timport { toolResultV1 } from \"./tool-result-v1.js\";\n    13\timport { turnComposeV1 } from \"./turn-compose-v1.js\";\n    14\t\n    15\texport interface PromptTemplate<I = unknown> {\n    16\t  name: string;\n    17\t  render(input: I): ModelCallInput[\"messages\"];\n    18\t}\n    19\t\n    20\t// Every config-selectable name. `never` pins the registry read-only at the\n    21\t// type level — rendering goes through the adapter, which owns the only\n    22\t// kind→input pairing.\n    23\texport const PROMPT_REGISTRY: Record<string, PromptTemplate<never>> = {\n    24\t  [smoothingV1.name]: smoothingV1,\n    25\t  [toolCallV1.name]: toolCallV1,\n    26\t  [toolResultV1.name]: toolResultV1,\n    27\t  [turnComposeV1.name]: turnComposeV1,\n    28\t  [lowerBandV1.name]: lowerBandV1,\n    29\t  [chunkDetailedV1.name]: chunkDetailedV1,\n    30\t  [chunkBriefV1.name]: chunkBriefV1,\n    31\t};\n    32\t\n    33\t// The default template per kind — the seven names an operator's first config\n    34\t// reaches for, and what test fixtures assign.\n    35\texport const DEFAULT_PROMPT_NAMES: Record<FormKind, string> = {\n    36\t  smoothed_prompt: smoothingV1.name,\n    37\t  tool_call_summary: toolCallV1.name,\n    38\t  tool_result_summary: toolResultV1.name,\n    39\t  turn_rendering: turnComposeV1.name,\n    40\t  lower_band_projection: lowerBandV1.name,\n    41\t  chunk_summary_detailed: chunkDetailedV1.name,\n    42\t  chunk_summary_brief: chunkBriefV1.name,\n    43\t};\n--- packages/lhc/src/inference/prompts/lower-band-v1.ts\n     1\t// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n     2\t// period produces the tuned text under a new versioned name.\n     3\timport type { PromptTemplate } from \"./index.js\";\n     4\t\n     5\texport const lowerBandV1: PromptTemplate<{ rendering: string }> = {\n     6\t  name: \"lower-band-v1\",\n     7\t  render: (i) => [\n     8\t    {\n     9\t      role: \"system\",\n    10\t      content:\n    11\t        \"You condense one turn's narrative account into a compact record for a long-horizon context. Keep what happened, decisions made, and concrete facts: paths, identifiers, counts, error text. Drop pleasantries and restatement. No commentary, 80 words maximum.\",\n    12\t    },\n    13\t    { role: \"user\", content: i.rendering },\n    14\t  ],\n    15\t};\n--- packages/lhc/src/inference/prompts/smoothing-v1.ts\n     1\t// SETTLED (AC-2.3): the POC's tuned smoothing prompt, ported verbatim from\n     2\t// pi-long-horizon's pi-codex-user-prompt-smoothing-provider (tested\n     3\t// extensively there against alternatives). The protected-literals sentence\n     4\t// rides along verbatim: LHC's smoothing input carries no literals list, so\n     5\t// the clause is simply inert here, and the dial-in period owns any rewording\n     6\t// under a new versioned name.\n     7\timport type { PromptTemplate } from \"./index.js\";\n     8\t\n     9\texport const smoothingV1: PromptTemplate<{ text: string }> = {\n    10\t  name: \"smoothing-v1\",\n    11\t  render: (i) => [\n    12\t    {\n    13\t      role: \"system\",\n    14\t      content:\n    15\t        \"You smooth user prompts for long-horizon coding context.\\n\\nPreserve the user's intent, uncertainty, explicit constraints, file paths, commands, identifiers, numbers, thresholds, and priorities.\\nWhen protected literals are provided, copy each one exactly; do not normalize, shorten, spell-correct, or regenerate those strings.\\nFix typos, grammar, capitalization, and whitespace.\\nReduce repetition, anger, profanity, and attention-spiking phrasing without moralizing, apologizing, or adding therapeutic framing.\\nReturn only the smoothed prompt text.\",\n    16\t    },\n    17\t    { role: \"user\", content: i.text },\n    18\t  ],\n    19\t};\n--- packages/lhc/src/inference/prompts/tool-call-v1.ts\n     1\t// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n     2\t// period produces the tuned text under a new versioned name.\n     3\timport type { PromptTemplate } from \"./index.js\";\n     4\t\n     5\texport const toolCallV1: PromptTemplate<{\n     6\t  toolName: string;\n     7\t  argsJson: string;\n     8\t  pairedResult?: { content: string; isError: boolean };\n     9\t}> = {\n    10\t  name: \"tool-call-v1\",\n    11\t  render: (i) => [\n    12\t    {\n    13\t      role: \"system\",\n    14\t      content:\n    15\t        \"You summarize a tool invocation for an engineering record. State which tool was called and what it was asked to do. Preserve concrete facts: paths, identifiers, and the arguments that matter. If the paired result is provided, use it only to clarify what the call did — never to invent an outcome. No commentary, no speculation, 60 words maximum.\",\n    16\t    },\n    17\t    {\n    18\t      role: \"user\",\n    19\t      content:\n    20\t        `Tool: ${i.toolName}\\n\\nArguments:\\n${i.argsJson}` +\n    21\t        (i.pairedResult === undefined\n    22\t          ? \"\"\n    23\t          : `\\n\\nPaired result (isError: ${String(i.pairedResult.isError)}):\\n${i.pairedResult.content}`),\n    24\t    },\n    25\t  ],\n    26\t};\n--- packages/lhc/src/inference/prompts/tool-result-v1.ts\n     1\t// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n     2\t// period produces the tuned text under a new versioned name. Input bounding\n     3\t// (DD-7) is applied by the adapter before this template renders.\n     4\timport type { PromptTemplate } from \"./index.js\";\n     5\t\n     6\texport const toolResultV1: PromptTemplate<{ toolName: string; content: string }> = {\n     7\t  name: \"tool-result-v1\",\n     8\t  render: (i) => [\n     9\t    {\n    10\t      role: \"system\",\n    11\t      content:\n    12\t        \"You summarize tool output for an engineering record. Preserve concrete facts: paths, identifiers, counts, error text. State the outcome plainly. No commentary, no speculation, 150 words maximum.\",\n    13\t    },\n    14\t    { role: \"user\", content: `Tool: ${i.toolName}\\n\\nOutput:\\n${i.content}` },\n    15\t  ],\n    16\t};\n--- packages/lhc/src/inference/prompts/turn-compose-v1.ts\n     1\t// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n     2\t// period produces the tuned text under a new versioned name.\n     3\timport type { RenderingPart } from \"../../shared/derivation.js\";\n     4\timport type { PromptTemplate } from \"./index.js\";\n     5\t\n     6\tfunction partLine(part: RenderingPart): string {\n     7\t  const outcome = part.outcome === undefined ? \"\" : ` (outcome: ${part.outcome})`;\n     8\t  return `[${part.kind}${outcome}]\\n${part.text}`;\n     9\t}\n    10\t\n    11\texport const turnComposeV1: PromptTemplate<{ parts: RenderingPart[] }> = {\n    12\t  name: \"turn-compose-v1\",\n    13\t  render: (i) => [\n    14\t    {\n    15\t      role: \"system\",\n    16\t      content:\n    17\t        \"You compose one turn of an engineering conversation into a faithful narrative account. Work only from the parts given, in order. Attribute each action to its speaker or tool. Preserve concrete facts: paths, identifiers, counts, error text. State each tool outcome plainly using the outcome given. No commentary, no speculation, 250 words maximum.\",\n    18\t    },\n    19\t    { role: \"user\", content: `Turn parts, in order:\\n\\n${i.parts.map(partLine).join(\"\\n\\n\")}` },\n    20\t  ],\n    21\t};\n","exit_code":0,"status":"completed"}}

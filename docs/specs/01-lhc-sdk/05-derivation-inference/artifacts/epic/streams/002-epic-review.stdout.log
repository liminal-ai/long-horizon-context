{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F64XifsqX5grjWYdTS1qjg","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\texport * as threadView from \"./domains/thread-view/index.js\";\n6\texport * as inspect from \"./domains/inspect/index.js\";\n7\t\n8\timport * as inspectDomain from \"./domains/inspect/index.js\";\n9\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n10\timport * as threadViewDomain from \"./domains/thread-view/index.js\";\n11\timport { resolveViewConfig } from \"./domains/thread-view/index.js\";\n12\timport * as messagesDomain from \"./domains/messages/index.js\";\n13\timport * as threadsDomain from \"./domains/threads/index.js\";\n14\timport * as turnsDomain from \"./domains/turns/index.js\";\n15\timport {\n16\t  createScheduler,\n17\t  peekThreadId,\n18\t  runDrain,\n19\t  type DrainDeps,\n20\t  type DrainReport,\n21\t  type Scheduler,\n22\t} from \"./scheduler.js\";\n23\timport {\n24\t  runWithInstanceSeam,\n25\t  setSchedulerPoke as installSchedulerPoke,\n26\t  setThreadTouch,\n27\t  type InstanceSeam,\n28\t} from \"./shared/context.js\";\n29\timport { createInferenceProvider } from \"./inference/adapter.js\";\n30\timport { PROMPT_REGISTRY } from \"./inference/prompts/index.js\";\n31\timport type { InferenceConfig, ModelAssignment } from \"./inference/types.js\";\n32\timport {\n33\t  FORM_KINDS,\n34\t  PROVIDER_OPERATIONS,\n35\t  type DerivationProvider,\n36\t  type FormKind,\n37\t  type ResolvedSdkConfig,\n38\t  type SdkConfig,\n39\t  type WorkHandler,\n40\t} from \"./shared/derivation.js\";\n41\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n42\timport type {\n43\t  CompactReceipt,\n44\t  PullResult,\n45\t  StoredView,\n46\t  SweepReceipt,\n47\t  ViewCompactParams,\n48\t  ViewProfile,\n49\t  ViewStatus,\n50\t} from \"./shared/view.js\";\n51\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n52\t\n53\texport {\n54\t  estimateTokens,\n55\t  TOKEN_ESTIMATOR_ID,\n56\t} from \"./tech-utils/token-counting/index.js\";\n57\t\n58\texport {\n59\t  WORK_KIND_REGISTRY,\n60\t  type WorkItemRecord,\n61\t  type WorkKind,\n62\t  type WorkOwner,\n63\t  type WorkSourceRef,\n64\t} from \"./tech-utils/work-queue/index.js\";\n65\t\n66\texport type {\n67\t  ErrorClass,\n68\t  ErrorCode,\n69\t  ErrorResult,\n70\t  OpResult,\n71\t} from \"./shared/errors.js\";\n72\texport {\n73\t  runInTransaction,\n74\t  setSchedulerPoke,\n75\t  setThreadTouch,\n76\t  type OperationContext,\n77\t} from \"./shared/context.js\";\n78\t\n79\texport {\n80\t  createDeterministicProvider,\n81\t  deterministicOutcomesSuffix,\n82\t  deterministicReceiptsSuffix,\n83\t  deterministicText,\n84\t  type DeterministicOpName,\n85\t} from \"./providers/deterministic.js\";\n86\texport type {\n87\t  CompletionTx,\n88\t  DependencyGap,\n89\t  DerivationProvider,\n90\t  DerivedForm,\n91\t  DerivedFormMetadata,\n92\t  DerivedFormState,\n93\t  FormKind,\n94\t  FormReportEntry,\n95\t  HandlerFormWrite,\n96\t  HandlerOutcome,\n97\t  HandlerRunContext,\n98\t  ProviderResult,\n99\t  RenderingPart,\n100\t  ResolvedSdkConfig,\n101\t  SdkConfig,\n102\t  SubjectKind,\n103\t  ToolOutcome,\n104\t  ToolRunReceipt,\n105\t  WorkHandler,\n106\t} from \"./shared/derivation.js\";\n107\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n108\t\n109\t// Epic 05 inference vocabulary (inference/types.ts): the host-supplied\n110\t// ModelCall boundary and the per-kind assignment config — type-only; the\n111\t// adapter and registry are construction internals behind createSdk.\n112\texport type {\n113\t  InferenceConfig,\n114\t  ModelAssignment,\n115\t  ModelCall,\n116\t  ModelCallFailureKind,\n117\t  ModelCallInput,\n118\t  ModelCallResult,\n119\t} from \"./inference/types.js\";\n120\texport type { ProviderProvenance } from \"./shared/derivation.js\";\n121\t\n122\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n123\t// from Story 0; the operation shapes land with Stories 1–5.\n124\texport {\n125\t  BUILT_IN_PROFILES,\n126\t  DEFAULT_COMPACT_THRESHOLD,\n127\t  DEFAULT_VISIBILITY,\n128\t} from \"./domains/thread-view/index.js\";\n129\texport type {\n130\t  Band,\n131\t  CompactReceipt,\n132\t  PullResult,\n133\t  ResolvedViewConfig,\n134\t  SdkViewConfig,\n135\t  StoredView,\n136\t  SweepReceipt,\n137\t  ViewCompactParams,\n138\t  ViewMessage,\n139\t  ViewMeta,\n140\t  ViewProfile,\n141\t  ViewProfileOverride,\n142\t  ViewStatus,\n143\t  VisibilityBudgets,\n144\t} from \"./shared/view.js\";\n145\texport {\n146\t  countLiveItems,\n147\t  enqueue,\n148\t  queueDetail,\n149\t  supersedeQueued,\n150\t  type ClaimedWorkItem,\n151\t  type EnqueueFormTarget,\n152\t  type EnqueueInput,\n153\t  type QueueDetailRow,\n154\t} from \"./tech-utils/work-queue/index.js\";\n155\t\n156\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n157\t// inspect surface serves.\n158\texport type {\n159\t  HealthReport,\n160\t  InspectOverview,\n161\t  ViewContentsReport,\n162\t} from \"./shared/inspect.js\";\n163\t\n164\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n165\texport type {\n166\t  Block,\n167\t  BlockType,\n168\t  MessageDetail,\n169\t  MessageListOptions,\n170\t  MessageRecord,\n171\t  MutationResult,\n172\t} from \"./domains/messages/index.js\";\n173\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n174\texport type {\n175\t  BatchResult,\n176\t  EventKind,\n177\t  EventRecord,\n178\t  MessageEventInput,\n179\t} from \"./domains/intake-stream/index.js\";\n180\t\n181\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n182\t\n183\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n184\t\n185\t// Merge per-domain handler tables into the one join between the queue's\n186\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n187\t// (each kind has exactly one owner) and throws at construction.\n188\texport function assembleWorkHandlerMap(\n189\t  tables: ReadonlyArray<WorkHandlerMap>,\n190\t): WorkHandlerMap {\n191\t  const map: WorkHandlerMap = {};\n192\t  for (const table of tables) {\n193\t    for (const [kind, handler] of Object.entries(table)) {\n194\t      if (map[kind as WorkKind] !== undefined) {\n195\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n196\t      }\n197\t      map[kind as WorkKind] = handler;\n198\t    }\n199\t  }\n200\t  return map;\n201\t}\n202\t\n203\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n204\t  return {\n205\t    ok: false,\n206\t    error: {\n207\t      errorClass: \"state_corruption\",\n208\t      code: \"unknown_work_kind\",\n209\t      reason: `no handler registered for work kind \"${kind}\"`,\n210\t    },\n211\t  };\n212\t}\n213\t\n214\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n215\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n216\texport function lookupWorkHandler(\n217\t  map: WorkHandlerMap,\n218\t  kind: string,\n219\t): OpResult<WorkHandler> {\n220\t  const handler = map[kind as WorkKind];\n221\t  if (handler === undefined) return unknownWorkKind(kind);\n222\t  return { ok: true, value: handler };\n223\t}\n224\t\n225\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n226\t// requeue land in Story 4.\n227\texport interface WorkSurface {\n228\t  drain(\n229\t    ref: threadsDomain.ThreadRef,\n230\t    opts?: { maxItems?: number },\n231\t  ): Promise<OpResult<DrainReport>>;\n232\t}\n233\t\n234\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n235\t// §Interface Definitions): the operations only — the Story 0 config\n236\t// substrate the domain index also carries is construction machinery, not an\n237\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n238\t// inspect domain composes (DD-1).\n239\texport interface ThreadViewSurface {\n240\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n241\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n242\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n243\t  compact(\n244\t    ref: threadsDomain.ThreadRef,\n245\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n246\t  ): Promise<OpResult<CompactReceipt>>;\n247\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n248\t  materialize(\n249\t    ref: threadsDomain.ThreadRef,\n250\t    opts: { path: string; format?: \"pi-session\" },\n251\t  ): Promise<OpResult<{ writtenPath: string }>>;\n252\t}\n253\t\n254\texport interface Lhc {\n255\t  threads: typeof threadsDomain;\n256\t  intakeStream: typeof intakeStreamDomain;\n257\t  messages: typeof messagesDomain;\n258\t  turns: typeof turnsDomain;\n259\t  threadView: ThreadViewSurface;\n260\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n261\t  // like every other namespace so the status read it composes resolves THIS\n262\t  // SDK's view config (threshold, visibility budgets).\n263\t  inspect: typeof inspectDomain;\n264\t  config: ResolvedSdkConfig;\n265\t  scheduler: Scheduler;\n266\t  workHandlers: WorkHandlerMap;\n267\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n268\t  work: WorkSurface;\n269\t  // Resolves when the scheduler has no running or pending drain for the\n270\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n271\t  // resolve in manual mode.\n272\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n273\t}\n274\t\n275\tfunction requirePositive(value: number, name: string): void {\n276\t  if (!Number.isFinite(value) || value <= 0) {\n277\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n278\t  }\n279\t}\n280\t\n281\tfunction requireNonNegative(value: number, name: string): void {\n282\t  if (!Number.isFinite(value) || value < 0) {\n283\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n284\t  }\n285\t}\n286\t\n287\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n288\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n289\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n290\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n291\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n292\t// object is the same shape as the namespace, so the public surface type holds.\n293\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n294\t  const scoped: Record<string, unknown> = {};\n295\t  for (const key of Object.keys(surface)) {\n296\t    const value = (surface as Record<string, unknown>)[key];\n297\t    scoped[key] =\n298\t      typeof value === \"function\"\n299\t        ? (...args: unknown[]): unknown =>\n300\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n301\t        : value;\n302\t  }\n303\t  return scoped as T;\n304\t}\n305\t\n306\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n307\t// the host function and the complete assignment map loudly — all seven kinds\n308\t// present (iterating the exported FORM_KINDS set, never a second literal\n309\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n310\t// provider/model routing keys — then build the adapter into the same\n311\t// DerivationProvider slot direct injection uses. No partial construction:\n312\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n313\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n314\t  if (typeof inference.call !== \"function\") {\n315\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n316\t  }\n317\t  const assignments = inference.assignments as unknown;\n318\t  if (assignments === null || typeof assignments !== \"object\") {\n319\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n320\t  }\n321\t  const knownKinds = new Set<string>(FORM_KINDS);\n322\t  for (const key of Object.keys(assignments)) {\n323\t    if (!knownKinds.has(key)) {\n324\t      throw new TypeError(\n325\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n326\t      );\n327\t    }\n328\t  }\n329\t  const map = assignments as Partial<Record<FormKind, ModelAssignment>>;\n330\t  for (const kind of FORM_KINDS) {\n331\t    const assignment = map[kind];\n332\t    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n333\t      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n334\t    }\n335\t    for (const field of [\"provider\", \"model\"] as const) {\n336\t      const value = assignment[field];\n337\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n338\t        throw new TypeError(\n339\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n340\t        );\n341\t      }\n342\t    }\n343\t    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n344\t      throw new TypeError(\n345\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n346\t      );\n347\t    }\n348\t  }\n349\t  const timeoutMs = inference.timeoutMs ?? 60_000;\n350\t  const maxInputChars = inference.maxInputChars ?? 200_000;\n351\t  requirePositive(timeoutMs, \"inference.timeoutMs\");\n352\t  requirePositive(maxInputChars, \"inference.maxInputChars\");\n353\t  return createInferenceProvider({\n354\t    call: inference.call,\n355\t    assignments: map as Record<FormKind, ModelAssignment>,\n356\t    timeoutMs,\n357\t    maxInputChars,\n358\t  });\n359\t}\n360\t\n361\t// The only assembly path: provider, mode, clock, and policy enter here.\n362\t// Config mistakes are programmer errors at construction and throw; operating\n363\t// failures after construction return OpResults per the error contract.\n364\texport function createSdk(config: SdkConfig): Lhc {\n365\t  // Provider arrival is exactly one of direct injection or the inference\n366\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n367\t  // env/flag resolution path to fall back on. The XOR rule is validated\n368\t  // before anything downstream so the error names the caller's mistake, not\n369\t  // a symptom (AC-1.1).\n370\t  if (config.provider !== undefined && config.inference !== undefined) {\n371\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n372\t  }\n373\t  if (config.provider === undefined && config.inference === undefined) {\n374\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n375\t  }\n376\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n377\t    throw new TypeError(\n378\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n379\t    );\n380\t  }\n381\t  let provider: DerivationProvider;\n382\t  if (config.inference !== undefined) {\n383\t    provider = resolveInferenceProvider(config.inference);\n384\t  } else {\n385\t    if (config.provider === null || typeof config.provider !== \"object\") {\n386\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n387\t    }\n388\t    for (const operation of PROVIDER_OPERATIONS) {\n389\t      if (typeof config.provider[operation] !== \"function\") {\n390\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n391\t      }\n392\t    }\n393\t    provider = config.provider;\n394\t  }\n395\t\n396\t  const resolved: ResolvedSdkConfig = {\n397\t    provider,\n398\t    mode: config.mode,\n399\t    clock: config.clock ?? (() => new Date()),\n400\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n401\t    lease: config.lease ?? { durationMs: 120000 },\n402\t    chunkPolicy:\n403\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n404\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n405\t    // sums and visibility budgets validated — throws naming the violation.\n406\t    view: resolveViewConfig(config.view),\n407\t  };\n408\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n409\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n410\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n411\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n412\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n413\t  }\n414\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n415\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n416\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n417\t    throw new TypeError(\n418\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n419\t    );\n420\t  }\n421\t\n422\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n423\t  // The tables are empty until Stories 2–3 land the real handlers; the\n424\t  // assembly mechanics are production code from day one.\n425\t  const workHandlers = assembleWorkHandlerMap([\n426\t    messagesDomain.workHandlers,\n427\t    turnsDomain.workHandlers,\n428\t  ]);\n429\t\n430\t  const drainDeps: DrainDeps = {\n431\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n432\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n433\t    config: resolved,\n434\t  };\n435\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n436\t\n437\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n438\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n439\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n440\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n441\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n442\t  // the construction order, because its operations deliver to the no-op seam,\n443\t  // not to whatever a background SDK installed below.\n444\t  // The seam also carries this instance's resolved view config (Epic 03,\n445\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n446\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n447\t  // fall back to the built-in defaults inside the thread-view surface.\n448\t  const seam: InstanceSeam =\n449\t    resolved.mode === \"background\"\n450\t      ? {\n451\t          poke: (threadId) => scheduler.poke(threadId),\n452\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n453\t          view: resolved.view,\n454\t        }\n455\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n456\t\n457\t  // Background mode also installs the below-SDK default seam so a direct\n458\t  // domain call made with no SDK scope — a top-level mutation in the\n459\t  // single-background \"production path\" — still reaches the one installed\n460\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n461\t  /
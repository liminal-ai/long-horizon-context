EventKind } from \\\"../../intake-stream/index.js\\\";\\n\\nexport interface TurnState {\\n  openTurnId: string | null;\\n}\\n\\nexport type TurnEffect =\\n  | { kind: \\\"none\\\" }\\n  | { kind: \\\"open\\\" }\\n  | { kind: \\\"close\\\" }\\n  | { kind: \\\"close_then_open\\\" };\\n\\nexport function transition(state: TurnState, eventKind: EventKind): TurnEffect {\\n  switch (eventKind) {\\n    case \\\"user_prompt\\\":\\n      return state.openTurnId === null ? { kind: \\\"open\\\" } : { kind: \\\"close_then_open\\\" };\\n    case \\\"turn_end\\\":\\n      return state.openTurnId === null ? { kind: \\\"none\\\" } : { kind: \\\"close\\\" };\\n    case \\\"assistant_text\\\":\\n    case \\\"assistant_thinking\\\":\\n    case \\\"runtime_note\\\":\\n    case \\\"tool_call\\\":\\n    case \\\"tool_result\\\":\\n      return { kind: \\\"none\\\" };\\n  }\\n}\\n\",\"numLines\":35,\"startLine\":1,\"totalLines\":35}}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/06-turn-end-boundary-advance/streams/003-implementor.stdout.log:617:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01EiWTXufeWYD4FGJkjQdmw5\",\"type\":\"tool_result\",\"content\":\"src/domains/turns/internal/store.ts:2:// transaction; reads run on a fresh handle per operation. A closed turn has\\nsrc/domains/turns/internal/store.ts:4:// any UPDATE that touches a closed row.\\nsrc/domains/turns/internal/store.ts:36:export function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\\nsrc/domains/turns/internal/store.ts:38:    \\\"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\\\",\\nsrc/domains/turns/internal/store.ts:39:  ).run(closedAtEventOrder, turnId);\\nsrc/domains/turns/internal/store.ts:49:): { turnId: string; status: \\\"open\\\" | \\\"closed\\\" } | undefined {\\nsrc/domains/turns/internal/store.ts:54:  return { turnId, status: row.status as \\\"open\\\" | \\\"closed\
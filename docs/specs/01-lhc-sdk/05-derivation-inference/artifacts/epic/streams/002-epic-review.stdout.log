{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E3sNXd4HjouSCGgSc9o7aZ","type":"tool_result","content":"1\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n2\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n3\t// domain owns the behavior, this module owns only the shapes.\n4\t\n5\texport type Band = \"brief\" | \"detailed\" | \"smooth\";\n6\t\n7\texport interface ViewProfile {\n8\t  name: string;\n9\t  // Target assembled size; whole-entry fills may land under or over (epic\n10\t  // Data Contracts — the bound is a target, not a cap).\n11\t  lowerBound: number;\n12\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n13\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n14\t}\n15\t\n16\t// A user profile entry as configured: a full profile under a new name, or a\n17\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n18\t// whose name matches no built-in has nothing to merge over and is rejected at\n19\t// construction (FC-0.2's unknown-override violation).\n20\texport interface ViewProfileOverride {\n21\t  name: string;\n22\t  lowerBound?: number;\n23\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n24\t}\n25\t\n26\t// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\n27\t// base profile, down to single band percentages — the same depth the CLI's\n28\t// per-band flags override at. A nested-partial deepening of the tech\n29\t// design's `Partial<ViewProfile>` sketch, which could not express a\n30\t// single-band override.\n31\texport interface ViewCompactParams {\n32\t  lowerBound?: number;\n33\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n34\t}\n35\t\n36\t// Visibility-boundary budgets (Epic 03 AC-4.x as patched by Epic 05 AC-5.4):\n37\t// max > target, both positive. The floor budget is retired — its job is done\n38\t// structurally by the turn-end trigger (the open turn is untouchable) and the\n39\t// never-evicted newest closed turn (Epic 05 DD-11).\n40\texport interface VisibilityBudgets {\n41\t  maxTokens: number;\n42\t  targetTokens: number;\n43\t}\n44\t\n45\t// ── SDK assembly config (validated at construction, throws on nonsense\n46\t// per the Epic 02 rule) ───────────────────────────────────────────\n47\texport interface SdkViewConfig {\n48\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n49\t  visibility?: Partial<VisibilityBudgets>; // defaults: 64000 / 32000\n50\t  compactThreshold?: number; // status trigger; default 160000\n51\t}\n52\t\n53\t// Every optional filled by createSdk's central defaults; profiles resolved\n54\t// to complete, validated entries keyed by name.\n55\texport interface ResolvedViewConfig {\n56\t  profiles: Readonly<Record<string, ViewProfile>>;\n57\t  visibility: VisibilityBudgets;\n58\t  compactThreshold: number;\n59\t}\n60\t\n61\t// ── pull / status shapes (the product crossing to the harness) ────\n62\t//\n63\t// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\n64\t// messages first — one `user` message per non-empty band, gradient order\n65\t// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\n66\t// the tail in record order. Tail messages render by the message-kind mapping\n67\t// table (tech design §Tail message rendering), the contract every later\n68\t// story renders into:\n69\t//\n70\t//   | Message kind                       | Role      | Content shape |\n71\t//   |------------------------------------|-----------|---------------|\n72\t//   | user_prompt                        | user      | text verbatim |\n73\t//   | assistant_text                     | assistant | text verbatim |\n74\t//   | assistant_thinking                 | assistant | fenced: `[thinking]\\n<text>\\n[/thinking]` — included (the tail is full fidelity) |\n75\t//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\n76\t//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\n<full content>` |\n77\t//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\n<summary or deterministic truncation>` (short-form ladder) |\n78\t//   | runtime_note                       | user      | `[runtime note] <text>` |\n79\texport interface ViewMessage {\n80\t  role: \"user\" | \"assistant\";\n81\t  content: string;\n82\t  band?: Band; // band absent ⇒ tail\n83\t}\n84\t\n85\texport interface ViewMeta {\n86\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n87\t  coveredFrom: number | null;\n88\t  boundaryPosition: number;\n89\t  gapCount: number;\n90\t  degradedCount: number;\n91\t  viewId: string | null;\n92\t  createdAt: string | null;\n93\t}\n94\t\n95\texport interface PullResult {\n96\t  messages: ViewMessage[];\n97\t  meta: ViewMeta;\n98\t}\n99\t\n100\t// The stored active view row as `threadView.describe` exposes it (Epic 04\n101\t// Story 3): the snapshot verbatim — arrangement, gaps, config, source-state\n102\t// provenance, per-band stored token counts — never recomputed, never\n103\t// repaired. Absent view ⇒ describe returns ok/null, mirroring status's\n104\t// never-compacted behavior (DD-1).\n105\texport interface StoredView {\n106\t  viewId: string;\n107\t  createdAt: string;\n108\t  compactPoint: number;\n109\t  coveredFrom: number;\n110\t  // null when explicit params overrode a named base at compact (the stored\n111\t  // config carries the resolved truth either way).\n112\t  profileName: string | null;\n113\t  config: { lowerBound: number; percentages: Record<string, number> };\n114\t  // Every selected entry in served order, gap entries included (they are\n115\t  // arrangement rows too; `gaps` carries their reasons).\n116\t  arrangement: Array<{\n117\t    band: Band;\n118\t    subjectKind: \"chunk\" | \"turn\";\n119\t    subjectId: string;\n120\t    formUsed: string;\n121\t    degraded: boolean;\n122\t  }>;\n123\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n124\t  // What the compact saw (AC-2.5 provenance, stored verbatim).\n125\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> };\n126\t  // Non-empty bands in gradient order with their stored token counts.\n127\t  bands: Array<{ band: Band; storedTokens: number }>;\n128\t}\n129\t\n130\texport interface ViewStatus {\n131\t  tailTokens: number;\n132\t  threshold: number;\n133\t  compactRecommended: boolean;\n134\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n135\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n136\t  visibility: { zoneTokens: number; maxTokens: number };\n137\t}\n138\t\n139\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n140\texport interface CompactReceipt {\n141\t  viewId: string;\n142\t  profile: string | null;\n143\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n144\t  bands: Record<Band, { entries: number; tokens: number }>;\n145\t  tailTokens: number;\n146\t  // The assembled view's actual total (band tokens + tail tokens) against\n147\t  // the configured lower bound — a target, not a cap: whole-entry fills may\n148\t  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n149\t  totalTokens: number;\n150\t  coveredFrom: number;\n151\t  compactPoint: number;\n152\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n153\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n154\t  // The embedded sweep's receipt (AC-3.6): the sweep runs first by default\n155\t  // and its full receipt embeds here; `sweep: false` records the skip — the\n156\t  // receipt always says whether the sweep ran (Story 3 closed Story 2's\n157\t  // \"absent\" placeholder).\n158\t  sweep: SweepReceipt | { skipped: true };\n159\t}\n160\t\n161\texport interface SweepReceipt {\n162\t  owners: Array<{\n163\t    owner: \"messages\" | \"turns\";\n164\t    kind: string;\n165\t    ready: number;\n166\t    inFlight: number;\n167\t    requeued: string[]; // subject ids\n168\t    blocked: Array<{ subjectId: string; reason: string }>;\n169\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\n170\t  }>;\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"bfcb3770-4909-4548-8bb4-e503f40f13df","uuid":"87f1fcf3-5b17-4355-9d17-96ad1be471a7","timestamp":"2026-06-13T00:36:16.095Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/view.ts","content":"// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n// domain owns the behavior, this module owns only the shapes.\n\nexport type Band = \"brief\" | \"detailed\" | \"smooth\";\n\nexport interface ViewProfile {\n  name: string;\n  // Target assembled size; whole-entry fills may land under or over (epic\n  // Data Contracts — the bound is a target, not a cap).\n  lowerBound: number;\n  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n  percentages: { full: number; smooth: number; detailed: number; brief: number };\n}\n\n// A user profile entry as configured: a full profile under a new name, or a\n// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n// whose name matches no built-in has nothing to merge over and is rejected at\n// construction (FC-0.2's unknown-override violation).\nexport interface ViewProfileOverride {\n  name: string;\n  lowerBound?: number;\n  percentages?: Partial<ViewProfile[\"percentages\"]>;\n}\n\n// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\n// base profile, down to single band percentages — the same depth the CLI's\n// per-band flags override at. A nested-partial deepening of the tech\n// design's `Partial<ViewProfile>` sketch, which could not express a\n// single-band override.\nexport interface ViewCompactParams {\n  lowerBound?: number;\n  percentages?: Partial<ViewProfile[\"percentages\"]>;\n}\n\n// Visibility-boundary budgets (Epic 03 AC-4.x as patched by Epic 05 AC-5.4):\n// max > target, both positive. The floor budget is retired — its job is done\n// structurally by the turn-end trigger (the open turn is untouchable) and the\n// never-evicted newest closed turn (Epic 05 DD-11).\nexport interface VisibilityBudgets {\n  maxTokens: number;\n  targetTokens: number;\n}\n\n// ── SDK assembly config (validated at construction, throws on nonsense\n// per the Epic 02 rule) ───────────────────────────────────────────\nexport interface SdkViewConfig {\n  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n  visibility?: Partial<VisibilityBudgets>; // defaults: 64000 / 32000\n  compactThreshold?: number; // status trigger; default 160000\n}\n\n// Every optional filled by createSdk's central defaults; profiles resolved\n// to complete, validated entries keyed by name.\nexport interface ResolvedViewConfig {\n  profiles: Readonly<Record<string, ViewProfile>>;\n  visibility: VisibilityBudgets;\n  compactThreshold: number;\n}\n\n// ── pull / status shapes (the product crossing to the harness) ────\n//\n// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\n// messages first — one `user` message per non-empty band, gradient order\n// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\n// the tail in record order. Tail messages render by the message-kind mapping\n// table (tech design §Tail message rendering), the contract every later\n// story renders into:\n//\n//   | Message kind                       | Role      | Content shape |\n//   |------------------------------------|-----------|---------------|\n//   | user_prompt                        | user      | text verbatim |\n//   | assistant_text                     | assistant | text verbatim |\n//   | assistant_thinking                 | assistant | fenced: `[thinking]\\n<text>\\n[/thinking]` — included (the tail is full fidelity) |\n//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\n//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\n<full content>` |\n//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\n<summary or deterministic truncation>` (short-form ladder) |\n//   | runtime_note                       | user      | `[runtime note] <text>` |\nexport interface ViewMessage {\n  role: \"user\" | \"assistant\";\n  content: string;\n  band?: Band; // band absent ⇒ tail\n}\n\nexport interface ViewMeta {\n  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n  coveredFrom: number | null;\n  boundaryPosition: number;\n  gapCount: number;\n  degradedCount: number;\n  viewId: string | null;\n  createdAt: string | null;\n}\n\nexport interface PullResult {\n  messages: ViewMessage[];\n  meta: ViewMeta;\n}\n\n// The stored active view row as `threadView.describe` exposes it (Epic 04\n// Story 3): the snapshot verbatim — arrangement, gaps, config, source-state\n// provenance, per-band stored token counts — never recomputed, never\n// repaired. Absent view ⇒ describe returns ok/null, mirroring status's\n// never-compacted behavior (DD-1).\nexport interface StoredView {\n  viewId: string;\n  createdAt: string;\n  compactPoint: number;\n  coveredFrom: number;\n  // null when explicit params overrode a named base at compact (the stored\n  // config carries the resolved truth either way).\n  profileName: string | null;\n  config: { lowerBound: number; percentages: Record<string, number> };\n  // Every selected entry in served order, gap entries included (they are\n  // arrangement rows too; `gaps` carries their reasons).\n  arrangement: Array<{\n    band: Band;\n    subjectKind: \"chunk\" | \"turn\";\n    subjectId: string;\n    formUsed: string;\n    degraded: boolean;\n  }>;\n  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n  // What the compact saw (AC-2.5 provenance, stored verbatim).\n  sourceState: { maxEventOrder: number; formCounts: Record<string, number> };\n  // Non-empty bands in gradient order with their stored token counts.\n  bands: Array<{ band: Band; storedTokens: number }>;\n}\n\nexport interface ViewStatus {\n  tailTokens: number;\n  threshold: number;\n  compactRecommended: boolean;\n  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n  view: { degraded: number; gaps: number; builtAt: string } | null;\n  visibility: { zoneTokens: number; maxTokens: number };\n}\n\n// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\nexport interface CompactReceipt {\n  viewId: string;\n  profile: string | null;\n  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n  bands: Record<Band, { entries: number; tokens: number }>;\n  tailTokens: number;\n  // The assembled view's actual total (band tokens + tail tokens) against\n  // the configured lower bound — a target, not a cap: whole-entry fills may\n  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n  totalTokens: number;\n  coveredFrom: number;\n  compactPoint: number;\n  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n  // The embedded sweep's receipt (AC-3.6): the sweep runs first by default\n  // and its full receipt embeds here; `sweep: false` records the skip — the\n  // receipt always says whether the sweep ran (Story 3 closed Story 2's\n  // \"absent\" placeholder).\n  sweep: SweepReceipt | { skipped: true };\n}\n\nexport interface SweepReceipt {\n  owners: Array<{\n    owner: \"messages\" | \"turns\";\n    kind: string;\n    ready: number;\n    inFlight: number;\n    requeued: string[]; // subject ids\n    blocked: Array<{ subjectId: string; reason: string }>;\n    permanentFailed: Array<{ subjectId: string; reason: string }>;\n  }>;\n}\n","numLines":172,"startLine":1,"totalLines":172}}}

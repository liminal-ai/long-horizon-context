victable; its tokens still count in the sum.\\n   167\\t  const candidates = groups.filter(\\n   168\\t    (group) => group.turnId === null || group.turnId !== openTurnId,\\n   169\\t  );\\n   170\\t\\n   171\\t  // Stop the walk before the newest closed turn — the last candidate carrying a\\n   172\\t  // turn_id. It and everything after it (the turn itself plus any trailing\\n   173\\t  // turnless singletons) are protected: the boundary lands on a group's last\\n   174\\t  // order, so any landing there or beyond would flip the newest closed turn\\n   175\\t  // short. With no closed turn in the zone, fall back to protecting the newest\\n   176\\t  // candidate group (the turnless-only whole-message behavior).\\n   177\\t  let stop = candidates.length - 1;\\n   178\\t  for (let i = candidates.length - 1; i >= 0; i -= 1) {\\n   179\\t    if (candidates[i]?.turnId !== null) {\\n   180\\t      stop = i;\\n   181\\t      break;\\n   182\\t    }\\n   183\\t  }\\n   184\\t\\n   185\\t  let remaining = total;\\n   186\\t  let newPosition: number | null = null;\\n   187\\t  for (let i = 0; i < stop; i += 1) {\\n   188\\t    const group = candidates[i];\\n   189\\t    if (group === undefined) break;\\n   190\\t    if (remaining - group.tokenSum < budgets.targetTokens) break;\\n   191\\t    remaining -= group.tokenSum;\\n   192\\t    newPosition = group.lastSourceEventOrder;\\n   193\\t  }\\n   194\\t  return newPosition;\\n   195\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/06-turn-end-boundary-advance/streams/008-verify.stdout.log:14:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/view-boundary-turn-end.test.ts | sed -n '268,320p'\\\"\",\"aggregated_output\":\"   268\\t    const pulled = await sdk.threadView.pull({ filePath });\\n   269\\t    expect(pulled.ok).toBe(true);\\n   270\\t    if (!pulled.ok) return;\\n   271\\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n   272\\t      `[tool result · read_file]\\\\n${boundaryTokens(120)}`,\\n   273\\t    );\\n   274\\t  });\\n   275\\t\\n   276\\t  it(\\\"never evicts the newest closed turn when a legal trailing turnless singleton sits after it\\\", async () => {\\n   277\\t    const sdk = visSdk();\\n   278\\t    const filePath = await newThread(sdk);\\n   279\\t    // A legal zone shape: two closed turns, then a tool result recorded after\\n   280\\t    // the newest turn closed (turn_id NULL — a trailing turnless singleton).\\n   281\\t    // Turns 50/45 then turnless 70: total 165 > 100. The newest closed turn\\n   282\\t    // (45) and the trailing turnless (70) are both protected — the boundary\\n   283\\t    // lands on a group's last order, so walking past either would flip the\\n   284\\t    // newest closed turn short. Only t1 (50) is evictable (remaining 115 ≥ 60);\\n   285\\t    // the walk stops before the newest closed turn and the zone legally stays\\n   286\\t    // above max. (The pre-fix code evicted the newest closed turn here: it\\n   287\\t    // protected only the trailing turnless as the last candidate.)\\n   288\\t    await seedTurnedToolResults(sdk, filePath, [\\n   289\\t      { results: [50] },\\n   290\\t      { results: [45] },\\n   291\\t      { results: [70], turnless: true },\\n   292\\t    ]);\\n   293\\t\\n   294\\t    const results = await toolResults(sdk, filePath);\\n   295\\t    expect(results).toHaveLength(3);\\n   296\\t    expect(results[2]?.turnId).toBeNull(); // trailing turnless: no membership\\n   297\\t\\n   298\\t    const position = await boundaryOf(sdk, filePath);\\n   299\\t    expect(position).toBe(results[0]?.sourceEventOrder); // lands on t1, before the newest closed turn\\n   300\\t    expect(await zoneTokensOf(sdk, filePath)).toBe(115); // 45 (newest closed) + 70 (trailing turnless)\\n   301\\t\\n   302\\t    // The newest closed turn stays intact: no turn is partially flipped, and\\n   303\\t    // both it and the trailing turnless render full — only t1 is abridged.\\n   304\\t    expectNoPartialTurn(results, position);\\n   305\\t    const pulled = await sdk.threadView.pull({ filePath });\\n   306\\t    expect(pulled.ok).toBe(true);\\n   307\\t    if (!pulled.ok) return;\\n   308\\t    expect(abridgedCount(pulled.value.messages)).toBe(1); // only t1's result\\n   309\\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n   310\\t      `[tool result · read_file]\\\\n${boundaryTokens(45)}`, // newest closed turn, full\\n   311\\t    );\\n   312\\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\\n   313\\t      `[tool result · read_file]\\\\n${boundaryTokens(70)}`, // trailing turnless, full\\n   314\\t    );\\n   315\\t  });\\n   316\\t\\n   317\\t  it(\\\"holds the boundary when the only closed turn is oversized: no candidate exists\\\", async () => {\\n   318\\t    const sdk = visSdk();\\n   319\\t    const filePath = await newThread(sdk);\\n   320\\t    await seedTurnedToolResults(sdk, filePath, [{ results: [150] }]);\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/06-turn-end-boundary-advance/streams/008-verify.stdout.log:15:{\"type\":\"item.started\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,240p' packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/003-quick-fix.json\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/06-turn-end-boundary-advance/streams/008-verify.stdout.log:16:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,240p' packages/lhc/docs/02-specs/05-derivation-inference/artifacts/quick-fix/003-quick-fix.json\\\"\",\"aggregated_output\":\"{\\\"command\
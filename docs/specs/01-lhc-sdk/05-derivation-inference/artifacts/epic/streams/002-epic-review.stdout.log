ins/turns/internal/store.ts:49:): { turnId: string; status: \\\"open\\\" | \\\"closed\\\" } | undefined {\\nsrc/domains/turns/internal/store.ts:54:  return { turnId, status: row.status as \\\"open\\\" | \\\"closed\\\" };\\nsrc/domains/turns/internal/store.ts:68:  closed_at_event_order: number | bigint | null;\\nsrc/domains/turns/internal/store.ts:93:      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\\nsrc/domains/turns/internal/store.ts:107:    if (row.closed_at_event_order !== null) {\\nsrc/domains/turns/internal/store.ts:108:      record.closedAtEventOrder = Number(row.closed_at_event_order);\\nsrc/domains/threads/internal/create.ts:89:        `CREATE TABLE turns (\\nsrc/domains/threads/internal/create.ts:92:          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\\nsrc/domains/threads/internal/create.ts:94:          closed_at_event_order INTEGER\\n---\\nsrc/domains/turns/index.ts:45:  selectOpenTurnIds,\\nsrc/domains/turns/index.ts:95:  return selectOpenTurnIds(ctx.db);\\nsrc/domains/turns/index.ts:134:  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\\nsrc/domains/turns/internal/derive.ts:29:import { selectOpenTurnIds } from \\\"./store.js\\\";\\nsrc/domains/turns/internal/derive.ts:68:  const openTurnIds = selectOpenTurnIds(db);\\nsrc/domains/turns/internal/store.ts:9:export function selectOpenTurnIds(db: DatabaseSync): string[] {\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/06-turn-end-boundary-advance/streams/003-implementor.stdout.log:841:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01RyoUkr8QkgQu2Ym1sPVCAb\",\"type\":\"tool_result\",\"content\":\"      expect(missing.error.errorClass).toBe(\\\"caller_error\\\");\\n      expect(missing.error.code).toBe(\\\"thread_not_found\\\");\\n    }\\n  });\\n});\\n\\ndescribe(\\\"TC-2.2 / AC-2.2, AC-2.3: loadCost parity on a boundary-advanced fixture\\\", () => {\\n  it(\\\"tail costs short forms short and total equals an independent pull re-measured\\\", async () => {\\n    // Small budgets so a real intake post-commit advance moves the boundary\\n    // into the tail (Epic 03 Story 4 mechanics — never a hand-set position).\\n    const sdk = createSdk({\\n      provider: createProviderDouble(),\\n      mode: \\\"manual\\\",\\n      view: { visibility: { maxTokens: 100, targetTokens: 60, floorTokens: 30 } },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\n\\n    // Six plain turns, drained, then a compact small enough to leave bands\\n    // and a real compact point.\\n    for (let turn = 1; turn <= 6; turn += 1) {\\n      const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n        validEvent(\\\"user_prompt\\\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\\n        validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n        validEvent(\\\"turn_end\\\"),\\n      ]);\\n      if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\\n      const drained = await sdk.work.drain({ filePath });\\n      if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\\n    }\\n---PULL---\\n    // Derivation counts by state, from the owners' report surfaces: the\\n    // fixture's two scripted failures (transient-exhausted + permanent), all\\n    // other forms drained ready — nothing pending, retrying, or blocked here\\n    // (the blocked leg reads the sacrificial sibling below).\\n    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\\n\\n    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\\n    // here; the view-health legs complete in Story 2).\\n    expect(status.value.view).toBeNull();\\n\\n    // The visibility zone: boundary at its seeded default 0, so the sum is\\n    // every live tool result's estimate — cross-checked against the record.\\n    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    const expectedZone = listed.value\\n      .filter((m) => m.kind === \\\"tool_result\\\")\\n      .reduce((sum, m) => sum + m.tokenEstimate, 0);\\n    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\\n\\n    // Reads only: no work rows, no form-state change, no view row, boundary\\n    // unmoved, zero provider calls — and no compact occurred uninvoked.\\n    expect(stateSnapshot(heavy.filePath)).toEqual(before);\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"bb1f3fcf-4d78-4a97-8c5b-320e502ce14a\",\"uuid\":\"baefb91c-37e1-41cd-8037-17b46bc82032\",\"timestamp\":\"2026-06-12T23:42:39.540Z\",\"tool_use_result\":{\"stdout\":\"      expect(missing.error.errorClass).toBe(\\\"caller_error\\\");\\n      expect(missing.error.code).toBe(\\\"thread_not_found\\\");\\n    }\\n  });\\n});\\n\\ndescribe(\\\"TC-2.2 / AC-2.2, AC-2.3: loadCost parity on a boundary-advanced fixture\\\", () => {\\n  it(\\\"tail costs short forms short and total equals an independent pull re-measured\\\", async () => {\\n    // Small budgets so a real intake post-commit advance moves the boundary\\n    // into the tail (Epic 03 Story 4 mechanics — never a hand-set position).\\n    const sdk = createSdk({\\n      provider: createProviderDouble(),\\n      mode: \\\"manual\\\",\\n      view: { visibility: { maxTokens: 100, targetTokens: 60, floorTokens: 30 } },\\n    });\\n    const filePath = store.threadPath();\\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\n\\n    // Six plain turns, drained, then a compact small enough to leave bands\\n    // and a real compact point.\\n    for (let turn = 1; turn <= 6; turn += 1) {\\n      const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n        validEvent(\\\"user_prompt\\\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\\n        validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n        validEvent(\\\"turn_end\\\"),\\n      ]);\\n      if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\\n      const drained = await sdk.work.drain({ filePath });\\n      if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\\n    }\\n---PULL---\\n    // Derivation counts by state, from the owners' report surfaces: the\\n    // fixture's two scripted failures (transient-exhausted + permanent), all\\n    // other forms drained ready — nothing pending, retrying, or blocked here\\n    // (the blocked leg reads the sacrificial sibling below).\\n    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\\n\\n    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\\n    // here; the view-health legs complete in Story 2).\\n    expect(status.value.view).toBeNull();\\n\\n    // The visibility zone: boundary at its seeded default 0, so the sum is\\n    // every live tool result's estimate — cross-checked against the record.\\n    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    const expectedZone = listed.value\\n      .filter((m) => m.kind === \\\"tool_result\\\")\\n      .reduce((sum, m) => sum + m.tokenEstimate, 0);\\n    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\\n\\n    // Reads only: no work rows, no form-state change, no view row, boundary\\n    // unmoved, zero provider calls — and no compact occurred uninvoked.\\n    expect(stateSnapshot(heavy.filePath)).toEqual(before);\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/06-turn-end-boundary-advance/streams/003-implementor.stdout.log:897:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Jzzg6PDm7GBzMzhE4tYf8K\",\"type\":\"tool_result\",\"content\":\"1\\timport { mkdtempSync, rmSync } from \\\"node:fs\\\";\\n2\\timport { tmpdir } from \\\"node:os\\\";\\n3\\timport { join } from \\\"node:path\\\";\\n4\\timport { DatabaseSync } from \\\"node:sqlite\\\";\\n5\\timport type { EventKind, MessageEventInput } from \\\"../../src/index.js\\\";\\n6\\t\\n7\\texport type EventByKind<K extends EventKind> = Extract<\\n8\\t  MessageEventInput,\\n9\\t  { eventKind: K }\\n10\\t>;\\n11\\t\\n12\\tlet keyCounter = 0;\\n13\\t\\n14\\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\\\"payload\\\"] } = {\\n15\\t  user_prompt: () => ({ text: \\\"please read the file\\\" }),\\n16\\t  assistant_text: () => ({ text: \\\"here is what I found\\\" }),\\n17\\t  assistant_thinking: () => ({ text: \\\"considering the file contents\\\" }),\\n18\\t  runtime_note: () => ({ text: \\\"harness restarted mid-turn\\\" }),\\n19\\t  tool_call: () => ({\\n20\\t    toolCallId: \\\"call-1\\\",\\n21\\t    toolName: \\\"read_file\\\",\\n22\\t    arguments: { path: \\\"notes.txt\\\" },\\n23\\t  }),\\n24\\t  tool_result: () => ({\\n25\\t    toolCallId: \\\"call-1\\\",\\n26\\t    content: \\\"contents of notes.txt\\\",\\n27\\t    isError: false,\\n28\\t  }),\\n29\\t  turn_end: () => ({}),\\n30\\t};\\n31\\t\\n32\\t// Returns the discriminated MessageEventInput member for its kind, so a\\n33\\t// kind/payload mismatch in test code is a compile error — building an invalid\\n34\\t// pairing requires an explicit cast at the call site.\\n35\\texport function validEvent<K extends EventKind>(\\n36\\t  kind: K,\\n37\\t  overrides: Partial<Omit<EventByKind<K>, \\\"eventKind\\\">> = {},\\n38\\t): EventByKind<K> {\\n39\\t  keyCounter += 1;\\n40\\t  const base = {\\n41\\t    eventKind: kind,\\n42\\t    idempotencyKey: `fixture-key-${keyCounter}`,\\n43\\t    actor: \\\"fixture-actor\\\",\\n44\\t    harness: \\\"fixture-harness\\\",\\n45\\t    payload: defaultPayloads[kind](),\\n46\\t  };\\n47\\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\\\"payload\\\"]),\\n48\\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\\n49\\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\\n50\\t  // parameter types, not this assertion.\\n51\\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\\n52\\t}\\n53\\t\\n54\\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\\n55\\t  return kinds.map((kind) => validEvent(kind));\\n56\\t}\\n57\\t\\n58\\texport function conversationTurn(): MessageEventInput[] {\\n59\\t  return eventBatch([\\n60\\t    \\\"user_prompt\\\",\\n61\\t    \\\"assistant_text\\\",\\n62\\t    \\\"tool_call\\\",\\n63\\t    \\\"tool_result\\\",\\n64\\t    \\\"turn_end\\\",\\n65\\t  ]);\\n66\\t}\\n67\\t\\n68\\texport interface TempStore {\\n69\\t  dir: string;\\n70\\t  registryPath: string;\\n71\\t  threadPath: (name?: string) => string;\\n72\\t  cleanup: () => void;\\n73\\t}\\n74\\t\\n75\\texport function tempStore(): TempStore {\\n76\\t  const dir = mkdtempSync(join(tmpdir(), \\\"lhc-test-\\\"));\\n77\\t  let threadCounter = 0;\\n78\\t  return {\\n79\\t    dir,\\n80\\t    registryPath: join(dir, \\\"registry.sqlite\\\"),\\n81\\t    threadPath: (name) => {\\n82\\t      threadCounter += 1;\\n83\\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\\n84\\t    },\\n85\\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\\n86\\t  };\\n87\\t}\\n88\\t\\n89\\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\\n90\\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\\n91\\texport function openRaw(path: string): DatabaseSync {\\n92\\t  return new DatabaseSync(path);\\n93\\t}\\n94\\t\\n95\\texport {\\n96\\t  corruptTwoOpenTurns,\\n97\\t  poisonMessageBlockJson,\\n98\\t  poisonMessageFormJson,\\n99\\t} from \\\"./corrupt.js\\\";\\n100\\texport { assertSweepReceiptShape } from \\\"./receipt-schema.js\\\";\\n101\\texport { assertPiSessionConformance, loadPiSessionFixture } from \\\"./pi-session-format.js\\\";\\n102\\t// The sweep's classification table, re-exported for the Story 3 unit legs:\\n103\\t// fixtures are the one sanctioned bridge across the no-internal-imports\\n104\\t// boundary (check-boundaries exempts test/fixtures/ by design), and the\\n105\\t// table is exported from sweep.ts for tests by story contract.\\n106\\texport {\\n107\\t  classifyFailureReason,\\n108\\t  REASON_CLASS_TABLE,\\n109\\t  type ReasonClass,\\n110\\t} from \\\"../../src/domains/thread-view/internal/sweep.js\\\";\\n111\\texport {\\n112\\t  legacyEpic01ThreadFile,\\n113\\t  legacyEpic02ThreadFile,\\n114\\t  legacyStory2ThreadFile,\\n115\\t  schemaVersionOf,\\n116\\t  type LegacyRecordedEvent,\\n117\\t} from \\\"./legacy.js\\\";\\n118\\texport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \\\"./intake-seam.js\\\";\\n119\\texport {\\n120\\t  createProviderDouble,\\n121\\t  ProviderDouble,\\n122\\t  type CapturedInput,\\n123\\t  type ProviderOpName,\\n124\\t} from \\\"./provider-double.js\\\";\\n125\\texport {\\n126\\t  registerTestWorkHandlers,\\n127\\t  testWorkHandlers,\\n128\\t  type TestHandlerHooks,\\n129\\t} from \\\"./work-handlers.js\\\";\\n130\\texport {\\n131\\t  fireViewInjection,\\n132\\t  seedViewBoundary,\\n133\\t  setViewInjectionHook,\\n134\\t  type ViewInjectionHook,\\n135\\t  type ViewInjectionPoint,\\n136\\t} from \\\"./view-seam.js\\\";\\n137\\texport {\\n138\\t  blockedSi
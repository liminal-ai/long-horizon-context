// header embeds it (`id: \\\\\\\\\\\\\\\"<threadId>:<timestamp>\\\\\\\\\\\\\\\"`). Two real threads cannot\\\\\\\\n20\\\\\\\\t// share an id through the public surface, so the materialized-file equality\\\\\\\\n21\\\\\\\\t// here substitutes each run's own thread id with a fixed placeholder and\\\\\\\\n22\\\\\\\\t// requires every other byte identical. Nothing else is normalized.\\\\\\\\n23\\\\\\\\timport { createHash } from \\\\\\\\\\\\\\\"node:crypto\\\\\\\\\\\\\\\";\\\\\\\\n24\\\\\\\\timport { readFileSync } from \\\\\\\\\\\\\\\"node:fs\\\\\\\\\\\\\\\";\\\\\\\\n25\\\\\\\\timport { afterAll, beforeAll, describe, expect, it, vi } from \\\\\\\\\\\\\\\"vitest\\\\\\\\\\\\\\\";\\\\\\\\n26\\\\\\\\timport {\\\\\\\\n27\\\\\\\\t  estimateTokens,\\\\\\\\n28\\\\\\\\t  type FormReportEntry,\\\\\\\\n29\\\\\\\\t  type HealthReport,\\\\\\\\n30\\\\\\\\t  type MutationResult,\\\\\\\\n31\\\\\\\\t  type OpResult,\\\\\\\\n32\\\\\\\\t  type PullResult,\\\\\\\\n33\\\\\\\\t  type SweepReceipt,\\\\\\\\n34\\\\\\\\t  type ViewMessage,\\\\\\\\n35\\\\\\\\t} from \\\\\\\\\\\\\\\"../src/index.js\\\\\\\\\\\\\\\";\\\\\\\\n36\\\\\\\\timport {\\\\\\\\n37\\\\\\\\t  DELETED_MESSAGE_TEXT,\\\\\\\\n38\\\\\\\\t  EDITED_MESSAGE_TEXT,\\\\\\\\n39\\\\\\\\t  LIFECYCLE_PROFILE,\\\\\\\\n40\\\\\\\\t  runLifecycle,\\\\\\\\n41\\\\\\\\t  tempStore,\\\\\\\\n42\\\\\\\\t  type LifecycleRun,\\\\\\\\n43\\\\\\\\t  type TempStore,\\\\\\\\n44\\\\\\\\t} from \\\\\\\\\\\\\\\"./fixtures/index.js\\\\\\\\\\\\\\\";\\\\\\\\n45\\\\\\\\t\\\\\\\\n46\\\\\\\\tlet store: TempStore;\\\\\\\\n47\\\\\\\\tlet run: LifecycleRun;\\\\\\\\n48\\\\\\\\t\\\\\\\\n49\\\\\\\\tbeforeAll(async () => {\\\\\\\\n50\\\\\\\\t  vi.useFakeTimers({ toFake: [\\\\\\\\\\\\\\\"Date\\\\\\\\\\\\\\\"] });\\\\\\\\n51\\\\\\\\t  vi.setSystemTime(new Date(\\\\\\\\\\\\\\\"2026-06-12T00:00:00.000Z\\\\\\\\\\\\\\\"));\\\\\\\\n52\\\\\\\\t  store = tempStore();\\\\\\\\n53\\\\\\\\t  run = await runLifecycle(store, { name: \\\\\\\\\\\\\\\"baseline\\\\\\\\\\\\\\\" });\\\\\\\\n54\\\\\\\\t}, 60000);\\\\\\\\n55\\\\\\\\tafterAll(() => {\\\\\\\\n56\\\\\\\\t  vi.useRealTimers();\\\\\\\\n57\\\\\\\\t  store.cleanup();\\\\\\\\n58\\\\\\\\t});\\\\\\\\n59\\\\\\\\t\\\\\\\\n60\\\\\\\\tfunction ok<T>(result: OpResult<T>): T {\\\\\\\\n61\\\\\\\\t  if (!result.ok) {\\\\\\\\n62\\\\\\\\t    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\\\\\\\\n63\\\\\\\\t  }\\\\\\\\n64\\\\\\\\t  return result.value;\\\\\\\\n65\\\\\\\\t}\\\\\\\\n66\\\\\\\\t\\\\\\\\n67\\\\\\\\tfunction sha256(value: string): string {\\\\\\\\n68\\\\\\\\t  return createHash(\\\\\\\\\\\\\\\"sha256\\\\\\\\\\\\\\\").update(value).digest(\\\\\\\\\\\\\\\"hex\\\\\\\\\\\\\\\");\\\\\\\\n69\\\\\\\\t}\\\\\\\\n70\\\\\\\\t\\\\\\\\n71\\\\\\\\tfunction measured(messages: readonly ViewMessage[]): number {\\\\\\\\n72\\\\\\\\t  return messages.reduce((sum, message) => sum + estimateTokens(message.content), 0);\\\\\\\\n73\\\\\\\\t}\\\\\\\\n74\\\\\\\\t\\\\\\\\n75\\\\\\\\tfunction clearedKeys(...mutations: MutationResult[]): string[] {\\\\\\\\n76\\\\\\\\t  return mutations\\\\\\\\n77\\\\\\\\t    .flatMap((mutation) => mutation.cleared)\\\\\\\\n78\\\\\\\\t    .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\\\\\\\\n79\\\\\\\\t    .sort();\\\\\\\\n80\\\\\\\\t}\\\\\\\\n81\\\\\\\\t\\\\\\\\n82\\\\\\\\tfunction pendingKeys(...reports: Array<readonly FormReportEntry[]>): string[] {\\\\\\\\n83\\\\\\\\t  return reports\\\\\\\\n84\\\\\\\\t    .flat()\\\\\\\\n85\\\\\\\\t    .filter((entry) => entry.state === \\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\")\\\\\\\\n86\\\\\\\\t    .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\\\\\\\\n87\\\\\\\\t    .sort();\\\\\\\\n88\\\\\\\\t}\\\\\\\\n89\\\\\\\\t\\\\\\\\n90\\\\\\\\ttype SweepLine = SweepReceipt[\\\\\\\\\\\\\\\"owners\\\\\\\\\\\\\\\"][number];\\\\\\\\n91\\\\\\\\tfunction byOwnerKind(rows: readonly SweepLine[]): SweepLine[] {\\\\\\\\n92\\\\\\\\t  return [...rows].sort((a, b) =>\\\\\\\\n93\\\\\\\\t    `${a.owner}/${a.kind}`.localeCompare(`${b.owner}/${b.kind}`),\\\\\\\\n94\\\\\\\\t  );\\\\\\\\n95\\\\\\\\t}\\\\\\\\n96\\\\\\\\t\\\\\\\\n97\\\\\\\\t// The materialized file with the run's own thread id substituted — the one\\\\\\\\n98\\\\\\\\t// sanctioned normalization (see header).\\\\\\\\n99\\\\\\\\tfunction comparableSessionFile(lifecycleRun: LifecycleRun): string {\\\\\\\\n100\\\\\\\\t  return readFileSync(lifecycleRun.outPath, \\\\\\\\\\\\\\\"utf8\\\\\\\\\\\\\\\").replaceAll(\\\\\\\\n101\\\\\\\\t    lifecycleRun.threadId,\\\\\\\\n102\\\\\\\\t    \\\\\\\\\\\\\\\"<thread-id>\\\\\\\\\\\\\\\",\\\\\\\\n103\\\\\\\\t  );\\\\\\\\n104\\\\\\\\t}\\\\\\\\n105\\\\\\\\t\\\\\\\\n106\\\\\\\\tdescribe(\\\\\\\\\\\\\\\"TC-5.1 / AC-5.1: the full sequence completes ok through one SDK configuration\\\\\\\\\\\\\\\", () => {\\\\\\\\n107\\\\\\\\t  it(\\\\\\\\\\\\\\\"every phase operation returns ok with the deterministic provider only\\\\\\\\\\\\\\\", () => {\\\\\\\\n108\\\\\\\\t    const { phases } = run;\\\\\\\\n109\\\\\\\\t    expect(phases.create.ok).toBe(true);\\\\\\\\n110\\\\\\\\t    for (const batch of phases.intake) expect(batch.ok).toBe(true);\\\\\\\\n111\\\\\\\\t    expect(phases.drain.settled).toBe(true);\\\\\\\\n112\\\\\\\\t    expect(phases.status.ok).toBe(true);\\\\\\\\n113\\\\\\\\t    expect(phases.compact1.ok).toBe(true);\\\\\\\\n114\\\\\\\\t    expect(phases.pull1.ok).toBe(true);\\\\\\\\n115\\\\\\\\t    expect(phases.inspect1.overview.ok).toBe(true);\\\\\\\\n116\\\\\\\\t    expect(phases.inspect1.view.ok).toBe(true);\\\\\\\\n117\\\\\\\\t    expect(phases.inspect1.health.ok).toBe(true);\\\\\\\\n118\\\\\\\\t    expect(phases.mutate.edit.ok).toBe(true);\\\\\\\\n119\\\\\\\\t    expect(phases.mutate.delete.ok).toBe(true);\\\\\\\\n120\\\\\\\\t    expect(phases.mutate.healthAfterMutate.ok).toBe(true);\\\\\\\\n121\\\\\\\\t    expect(phases.rebuild.settled).toBe(true);\\\\\\\\n122\\\\\\\\t    expect(phases.health2.ok).toBe(true);\\\\\\\\n123\\\\\\\\t    expect(phases.compact2.ok).toBe(true);\\\\\\\\n124\\\\\\\\t    expect(phases.pull2.ok).toBe(true);\\\\\\\\n125\\\\\\\\t    expect(phases.materialize.ok).toBe(true);\\\\\\\\n126\\\\\\\\t  });\\\\\\\\n127\\\\\\\\t\\\\\\\\n128\\\\\\\\t  it(\\\\\\\\\\\\\\\"status recommends the compact the sequence performs next, with derivation settled\\\\\\\\\\\\\\\", () => {\\\\\\\\n129\\\\\\\\t    const status = ok(run.phases.status);\\\\\\\\n130\\\\\\\\t    expect(status.threshold).toBe(300);\\\\\\\\n131\\\\\\\\t    expect(status.tailTokens).toBeGreaterThan(status.threshold);\\\\\\\\n132\\\\\\\\t    expect(status.compactRecommended).toBe(true);\\\\\\\\n133\\\\\\\\t    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\\\\\\\\n134\\\\\\\\t    expect(status.view).toBeNull(); // not yet compacted at this checkpoint\\\\\\\\n135\\\\\\\\t  });\\\\\\\\n136\\\\\\\\t});\\\\\\\\n137\\\\\\\\t\\\\\\\\n138\\\\\\\\tdescribe(\\\\\\\\\\\\\\\"TC-5.1 / AC-5.2: checkpoint coherence across the sequence\\\\\\\\\\\\\\\", () => {\\\\\\\\n139\\\\\\\\t  it(\\\\\\\\\\\\\\\"post-compact pull serves bands + tail, and the view report's loadCost prices that pull\\\\\\\\\\\\\\\", () => {\\\\\\\\n140\\\\\\\\t    const receipt = ok(run.phases.compact1);\\\\\\\\n141\\\\\\\\t    expect(receipt.profile).toBe(LIFECYCLE_PROFILE.name);\\\\\\\\n142\\\\\\\\t    const pull = ok(run.phases.pull1);\\\\\\\\n143\\\\\\\\t\\\\\\\\n144\\\\\\\\t    // Bands open the array in gradient order; the tail follows in record\\\\\\\\n145\\\\\\\\t    // order — the served shape the PI extension will consume.\\\\\\\\n146\\\\\\\\t    const bands = pull.messages.filter((message) => message.band !== undefined);\\\\\\\\n147\\\\\\\\t    expect(bands.map((message) => message.band)).toEqual([\\\\\\\\\\\\\\\"brief\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"detailed\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"smooth\\\\\\\\\\\\\\\"]);\\\\\\\\n148\\\\\\\\t    expect(pull.messages.slice(0, bands.length)).toEqual(bands);\\\\\\\\n149\\\\\\\\t    const tail = pull.messages.slice(bands.length);\\\\\\\\n150\\\\\\\\t    expect(tail.length).toBeGreaterThan(0);\\\\\\\\n151\\\\\\\\t    expect(tail.every((message) => message.band === undefined)).toBe(true);\\\\\\\\n152\\\\\\\\t    expect(pull.meta.viewId).toBe(receipt.viewId);\\\\\\\\n153\\\\\\\\t    expect(pull.meta.compactPoint).toBe(receipt.compactPoint);\\\\\\\\n154\\\\\\\\t\\\\\\\\n155\\\\\\\\t    // Cross-epic loadCost checkpoint (test plan: report at compact1 vs\\\\\\\\n156\\\\\\\\t    // pull1): the inspect report's serving cost equals this independent\\\\\\\\n157\\\\\\\\t    // pull re-measured with the shared estimator.\\\\\\\\n158\\\\\\\\t    const report = ok(run.phases.inspect1.view);\\\\\\\\n159\\\\\\\\t    expect(report.meta?.viewId).toBe(receipt.viewId);\\\\\\\\n160\\\\\\\\t    expect(report.meta?.profile).toBe(LIFECYCLE_PROFILE.name);\\\\\\\\n161\\\\\\\\t    expect(report.loadCost.bandTokens).toBe(measured(bands));\\\\\\\\n162\\\\\\\\t    expect(report.loadCost.tailTokens).toBe(measured(tail));\\\\\\\\n163\\\\\\\\t    expect(report.loadCost.total).toBe(measured(pull.messages));\\\\\\\\n164\\\\\\\\t\\\\\\\\n165\\\\\\\\t    // Overview agrees on the same view identity with derivation settled.\\\\\\\\n166\\\\\\\\t    const overview = ok(run.phases.inspect1.overview);\\\\\\\\n167\\\\\\\\t    expect(overview.view?.viewId).toBe(receipt.viewId);\\\\\\\\n168\\\\\\\\t    expect(overview.derivation.pending).toBe(0);\\\\\\\\n169\\\\\\\\t    expect(overview.messages.deleted).toBe(0);\\\\\\\\n170\\\\\\\\t  });\\\\\\\\n171\\\\\\\\t\\\\\\\\n172\\\\\\\\t  it(\\\\\\\\\\\\\\\"post-mutation health shows exactly the cleared set pending; post-drain health shows it ready\\\\\\\\\\\\\\\", () => {\\\\\\\\n173\\\\\\\\t    const { mutate } = run.phases;\\\\\\\\n174\\\\\\\\t    const edit = ok(mutate.edit);\\\\\\\\n175\\\\\\\\t    const deleted = ok(mutate.delete);\\\\\\\\n176\\\\\\\\t    expect(edit.superseded).toEqual([]);\\\\\\\\n177\\\\\\\\t    expect(deleted.superseded).toEqual([]);\\\\\\\\n178\\\\\\\\t    // The deleted assistant_text owns no derived forms: its cascade clears\\\\\\\\n179\\\\\\\\t    // sibling turn forms only.\\\\\\\\n180\\\\\\\\t    expect(deleted.dropped).toEqual([]);\\\\\\\\n181\\\\\\\\t\\\\\\\\n182\\\\\\\\t    // The cascade contracts' cleared union IS the pending set the owners\\\\\\\\n183\\\\\\\\t    // report — no more, no less (AC-5.2's \\\\\\\\\\\\\\\"the cleared set pending\\\\\\\\\\\\\\\").\\\\\\\\n184\\\\\\\\t    const cleared = clearedKeys(edit, deleted);\\\\\\\\n185\\\\\\\\t    expect(cleared.length).toBeGreaterThan(0);\\\\\\\\n186\\\\\\\\t    const pending = pendingKeys(ok(mutate.messagesNotReady), ok(mutate.turnsNotReady));\\\\\\\\n187\\\\\\\\t    expect(pending).toEqual(cleared);\\\\\\\\n188\\\\\\\\t\\\\\\\\n189\\\\\\\\t    // Health joins the same truth: pending counts sum to the cleared set,\\\\\\\\n190\\\\\\\\t    // with the queued replacement work live and unclaimed (the background\\\\\\\\n191\\\\\\\\t    // drain has not started — the snapshot precedes its first pass).\\\\\\\\n192\\\\\\\\t    const health = ok(mutate.healthAfterMutate);\\\\\\\\n193\\\\\\\\t    const pendingTotal = health.owners.reduce(\\\\\\\\n194\\\\\\\\t      (sum, row) => sum + row.counts.pending + row.counts.retrying,\\\\\\\\n195\\\\\\\\t      0,\\\\\\\\n196\\\\\\\\t    );\\\\\\\\n197\\\\\\\\t    expect(pendingTotal).toBe(cleared.length);\\\\\\\\n198\\\\\\\\t    // Queue visibility is counted per report entry (AC-4.5's by-construction\\\\\\\\n199\\\\\\\\t    // consistency), so queued equals the pending entries — all unclaimed.\\\\\\\\n200\\\\\\\\t    expect(health.queue).toEqual({ queued: cleared.length, claimed: 0 });\\\\\\\\n201\\\\\\\\t    expect(edit.queued.length).toBeGreaterThan(0);\\\\\\\\n202\\\\\\\\t    expect(deleted.queued.length).toBeGreaterThan(0);\\\\\\\\n203\\\\\\\\t    expect(health.failures).toEqual([]);\\\\\\\\n204\\\\\\\\t\\\\\\\\n205\\\\\\\\t    // Post-drain (rebuild settled): everything ready, nothing failed,\\\\\\\\n206\\\\\\\\t    // queue empty.\\\\\\\\n207\\\\\\\\t    const after = ok(run.phases.health2);\\\\\\\\n208\\\\\\\\t    for (const row of after.owners) {\\\\\\\\n209\\\\\\\\t      expect(row.counts.pending).toBe(0);\\\\\\\\n210\\\\\\\\t      expect(row.counts.retrying).toBe(0);\\\\\\\\n211\\\\\\\\t      expect(row.counts.failed).toBe(0);\\\\\\\\n212\\\\\\\\t      expect(row.counts.blocked).toBe(0);\\\\\\\\n213\\\\\\\\t      expect(row.counts.ready).toBeGreaterThan(0);\\\\\\\\n214\\\\\\\\t    }\\\\\\\\n215\\\\\\\\t    expect(after.failures).toEqual([]);\\\\\\\\n216\\\\\\\\t    expect(after.repairPreview).toEqual([]);\\\\\\\\n217\\\\\\\\t    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\\\\\\\\n218\\\\\\\\t  });\\\\\\\\n219\\\\\\\\t\\\\\\\\n220\\\\\\\\t  it(\\\\\\\\\\\\\\\"the second compact's view reflects post-edit content\\\\\\\\\\\\\\\", () => {\\\\\\\\n221\\\\\\\\t    const pull1 = ok(run.phases.pull1);\\\\\\\\n222\\\\\\\\t    const pull2 = ok(run.phases.pull2);\\\\\\\\n223\\\\\\\\t\\\\\\\\n224\\\\\\\\t    // Before the mutations: the original prompt and the to-be-deleted text\\\\\\\\n225\\\\\\\\t    // are served verbatim in the tail (full fidelity).\\\\\\\\n226\\\\\\\\t    expect(\\\\\\\\n227\\\\\\\\t      pull1.messages.some((m) => m.content === \\\\\\\\\\\\\\\"turn 12: please investigate area 12\\\\\\\\\\\\\\\"),\\\\\\\\n228\\\\\\\\t    ).toBe(true);\\\\\\\\n229\\\\\\\\t    expect(pull1.messages.some((m) => m.content === DELETED_MESSAGE_TEXT)).toBe(true);\\\\\\\\n230\\\\\\\\t\\\\\\\\n231\\\\\\\\t    // After mutate + rebuild + compact2: the edited prompt serves verbatim,\\\\\\\\n232\\\\\\\\t    // the deleted message is gone from the served view entirely.\\\\\\\\n233\\\\\\\\t    expect(\\\\\\\\n234\\\\\\\\t      pull2.messages.some(\\\\\\\\n235\\\\\\\\t        (m) => m.band === undefined && m.role === \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\" && m.content === EDITED_MESSAGE_TEXT,\\\\\\\\n236\\\\\\\\t      ),\\\\\\\\n237\\\\\\\\t    ).toBe(true);\\\\\\\\n238\\\\\\\\t    expect(pull2.messages.some((m) => m.content.includes(DELETED_MESSAGE_TEXT))).toBe(false);\\\\\\\\n239\\\\\\\\t    expect(\\\\\\\\n240\\\\\\\\t      pull2.messages.some((m) => m.content === \\\\\\\\\\\\\\\"turn 12: please investigate area 12\\\\\\\\\\\\\\\"),\\\\\\\\n241\\\\\\\\t    ).toBe(false);\\\\\\\\n242\\\\\\\\t  });\\\\\\\\n243\\\\\\\\t\\\\\\\\n244\\\\\\\\t  it(\\\\\\\\\\\\\\\"the second compact receipt's sweep section agrees with the health report taken immediately before it\\\\\\\\\\\\\\\", () => {\\\\\\\\n245\\\\\\\\t    const receipt = ok(run.phases.compact2);\\\\\\\\n246\\\\\\\\t    const health: HealthReport = ok(run.phases.health2);\\\\\\\\n247\\\\\\\\t    expect(\\\\\\\\\\\\\\\"owners\\\\\\\\\\\\\\\" in receipt.sweep).toBe(true);\\\\\\\\n248\\\\\\\\t    const sweep = receipt.sweep as SweepReceipt;\\\\\\\\n249\\\\\\\\t\\\\\\\\n250\\\\\\\\t    // Field-level agreement per owner/kind: the sweep saw exactly the state\\\\\\\\n251\\\\\\\\t    // health reported — same ready counts, in-flight = pending + retrying,\\\\\\\\n252\\\\\\\\t    // and the failed/requeued/blocked sets empty on both sides.\\\\\\\\n253\\\\\\\\t    const expectedFromHealth = health.owners.map((row) => ({\\\\\\\\n254\\\\\\\\t      owner: row.owner,\\\\\\\\n255\\\\\\\\t      kind: row.kind,\\\\\\\\n256\\\\\\\\t      ready: row.counts.ready,\\\\\\\\n257\\\\\\\\t      inFlight: row.counts.pending + row.counts.retrying,\\\\\\\\n258\\\\\\\\t      requeued: [],\\\\\\\\n259\\\\\\\\t      blocked: [],\\\\\\\\n260\\\\\\\\t      permanentFailed: [],\\\\\\\\n261\\\\\\\\t    }));\\\\\\\\n262\\\\\\\\t    expect(byOwnerKind(sweep.owners)).toEqual(byOwnerKind(expectedFromHealth));\\\\\\\\n263\\\\\\\\t    expect(health.failures).toEqual([]);\\\\\\\\n264\\\\\\\\t  });\\\\\\\\n265\\\\\\\\t});\\\\\\\\n266\\\\\\\\t\\\\\\\\n267\\\\\\\\tdescribe(\\\\\\\\\\\\\\\"TC-5.2 / AC-5.3: replay determinism on a fresh thread\\\\\\\\\\\\\\\", () => {\\\\\\\\n268\\\\\\\\t  it(\\\\\\\\\\\\\\\"produces hash-equal pull outputs and a byte-identical materialized file (modulo the one random thread id)\\\\\\\\\\\\\\\", async () => {\\\\\\\\n269\\\\\\\\t    const replay = await runLifecycle(store, { name: \\\\\\\\\\\\\\\"replay\\\\\\\\\\\\\\\" });\\\\\\\\n270\\\\\\\\t\\\\\\\\n271\\\\\\\\t    // Pull outputs: exact hash equality, no normalization — the frozen\\\\\\\\n272\\\\\\\\t    // clock leaves no ambient input, so any inequality is real\\\\\\\\n273\\\\\\\\t    // nondeterminism in the built surfaces.\\\\\\\\n274\\\\\\\\t    const pulls: Array<[OpResult<PullResult>, OpResult<PullResult>]> = [\\\\\\\\n275\\\\\\\\t      [run.phases.pull1, replay.phases.pull1],\\\\\\\\n276\\\\\\\\t      [run.phases.pull2, replay.phases.pull2],\\\\\\\\n277\\\\\\\\t    ];\\\\\\\\n278\\\\\\\\t    for (const [original, replayed] of pulls) {\\\\\\\\n279\\\\\\\\t      expect(sha256(JSON.stringify(ok(replayed)))).toBe(sha256(JSON.stringify(ok(original))));\\\\\\\\n280\\\\\\\\t    }\\\\\\\\n281\\\\\\\\t\\\\\\\\n282\\\\\\\\t    // Materialized file: identical bytes after substituting each thread's\\\\\\\\n283\\\\\\\\t    // own id (the header's one random value — see file header note).\\\\\\\\n284\\\\\\\\t    expect(replay.threadId).not.toBe(run.threadId);\\\\\\\\n285\\\\\\\\t    expect(sha256(comparableSessionFile(replay))).toBe(sha256(comparableSessionFile(run)));\\\\\\\\n286\\\\\\\\t  }, 60000);\\\\\\\\n287\\\\\\\\t});\\\\\\\\n288\\\\\\\\t\\\\\\\\n289\\\\\\\\tdescribe(\\\\\\\\\\\\\\\"TC-5.3 / AC-5.4: teardown continuity — fresh createSdk between phase groups\\\\\\\\\\\\\\\", () => {\\\\\\\\n290\\\\\\\\t  it(\\\\\\\\\\\\\\\"yields final pull, health, and materialized file identical to the uninterrupted run's\\\\\\\\\\\\\\\", async () => {\\\\\\\\n291\\\\\\\\t    const teardown = await runLifecycle(store, {\\\\\\\\n292\\\\\\\\t      name: \\\\\\\\\\\\\\\"teardown\\\\\\\\\\\\\\\",\\\\\\\\n293\\\\\\\\t      freshSdkBetweenGroups: true,\\\\\\\\n294\\\\\\\\t    });\\\\\\\\n295\\\\\\\\t\\\\\\\\n296\\\\\\\\t    // No in-memory dependency: the end state lives in the thread file, so a\\\\\\\\n297\\\\\\\\t    // fresh instance continuing each phase group lands byte-identical.\\\\\\\\n298\\\\\\\\t    expect(JSON.stringify(ok(teardown.phases.pull2))).toBe(\\\\\\\\n299\\\\\\\\t      JSON.stringify(ok(run.phases.pull2)),\\\\\\\\n300\\\\\\\\t    );\\\\\\\\n301\\\\\\\\t    expect(ok(teardown.phases.health2)).toEqual(ok(run.phases.health2));\\\\\\\\n302\\\\\\\\t    expect(sha256(comparableSessionFile(teardown))).toBe(sha256(comparableSessionFile(run)));\\\\\\\\n303\\\\\\\\t  }, 60000);\\\\\\\\n304\\\\\\\\t});\\\\\\\\n305\\\\\\\\t\\\\\\\"}]},\\\\\\\"parent_tool_use_id\\\\\\\":null,\\\\\\\"session_id\\\\\\\":\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\",\\\\\\\"uuid\\\\\\\":\\\\\\\"2fb5daed-7804-4147-ad7c-34ef527c28fa\\\\\\\",\\\\\\\"timestamp\\\\\\\":\\\\\\\"2026-06-12T23:22:47.194Z\\\\\\\",\\\\\\\"tool_use_result\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"text\\\\\\\",\\\\\\\"file\\\\\\\":{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/lifecycle.test.ts\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"// Story 4 (Epic 04), default suite: TC-5.1–5.3 — the full-surface lifecycle\\\\\\\\n// exercise. One scripted sequence (test/fixtures/lifecycle.ts) drives every\\\\\\\\n// built v1 surface in PI-extension call order against one real SDK\\\\\\\\n// configuration with the registry's deterministic provider: zero network and\\\\\\\\n// zero real-provider calls are structural (no other provider exists in the\\\\\\\\n// configuration), and every checkpoint assertion lives here, not in the\\\\\\\\n// script, so the replay (TC-5.2), teardown (TC-5.3), and process (TC-5.4,\\\\\\\\n// cli-process-inspect.test.ts) legs replay the same sequence.\\\\\\\\n//\\\\\\\\n// Determinism control: the wall clock is the one ambient input the built\\\\\\\\n// surfaces stamp into outputs (event recorded_at, view created_at, mutation\\\\\\\\n// timestamps), so this file freezes Date — and only Date; the scheduler's\\\\\\\\n// real setImmediate/setTimeout stay live for the background drains. With\\\\\\\\n// the clock frozen, pull outputs are byte-identical across runs with no\\\\\\\\n// normalization at all.\\\\\\\\n//\\\\\\\\n// One pinned deviation (AC-5.3/AC-5.4 file equality): a thread's id is the\\\\\\\\n// design's ONE random value (threads design decision 7), and the PI session\\\\\\\\n// header embeds it (`id: \\\\\\\\\\\\\\\"<threadId>:<timestamp>\\\\\\\\\\\\\\\"`). Two real threads cannot\\\\\\\\n// share an id through the public surface, so the materialized-file equality\\\\\\\\n// here substitutes each run's own thread id with a fixed placeholder and\\\\\\\\n// requires every other byte identical. Nothing else is normalized.\\\\\\\\nimport { createHash } from \\\\\\\\\\\\\\\"node:crypto\\\\\\\\\\\\\\\";\\\\\\\\nimport { readFileSync } from \\\\\\\\\\\\\\\"node:fs\\\\\\\\\\\\\\\";\\\\\\\\nimport { afterAll, beforeAll, describe, expect, it, vi } from \\\\\\\\\\\\\\\"vitest\\\\\\\\\\\\\\\";\\\\\\\\nimport {\\\\\\\\n  estimateTokens,\\\\\\\\n  type FormReportEntry,\\\\\\\\n  type HealthReport,\\\\\\\\n  type MutationResult,\\\\\\\\n  type OpResult,\\\\\\\\n  type PullResult,\\\\\\\\n  type SweepReceipt,\\\\\\\\n  type ViewMessage,\\\\\\\\n} from \\\\\\\\\\\\\\\"../src/index.js\\\\\\\\\\\\\\\";\\\\\\\\nimport {\\\\\\\\n  DELETED_MESSAGE_TEXT,\\\\\\\\n  EDITED_MESSAGE_TEXT,\\\\\\\\n  LIFECYCLE_PROFILE,\\\\\\\\n  runLifecycle,\\\\\\\\n  tempStore,\\\\\\\\n  type LifecycleRun,\\\\\\\\n  type TempStore,\\\\\\\\n} from \\\\\\\\\\\\\\\"./fixtures/index.js\\\\\\\\\\\\\\\";\\\\\\\\n\\\\\\\\nlet store: TempStore;\\\\\\\\nlet run: LifecycleRun;\\\\\\\\n\\\\\\\\nbeforeAll(async () => {\\\\\\\\n  vi.useFakeTimers({ toFake: [\\\\\\\\\\\\\\\"Date\\\\\\\\\\\\\\\"] });\\\\\\\\n  vi.setSystemTime(new Date(\\\\\\\\\\\\\\\"2026-06-12T00:00:00.000Z\\\\\\\\\\\\\\\"));\\\\\\\\n  store = tempStore();\\\\\\\\n  run = await runLifecycle(store, { name: \\\\\\\\\\\\\\\"baseline\\\\\\\\\\\\\\\" });\\\\\\\\n}, 60000);\\\\\\\\nafterAll(() => {\\\\\\\\n  vi.useRealTimers();\\\\\\\\n  store.cleanup();\\\\\\\\n});\\\\\\\\n\\\\\\\\nfunction ok<T>(result: OpResult<T>): T {\\\\\\\\n  if (!result.ok) {\\\\\\\\n    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\\\\\\\\n  }\\\\\\\\n  return result.value;\\\\\\\\n}\\\\\\\\n\\\\\\\\nfunction sha256(value: string): string {\\\\\\\\n  return createHash(\\\\\\\\\\\\\\\"sha256\\\\\\\\\\\\\\\").update(value).digest(\\\\\\\\\\\\\\\"hex\\\\\\\\\\\\\\\");\\\\\\\\n}\\\\\\\\n\\\\\\\\nfunction measured(messages: readonly ViewMessage[]): number {\\\\\\\\n  return messages.reduce((sum, message) => sum + estimateTokens(message.content), 0);\\\\\\\\n}\\\\\\\\n\\\\\\\\nfunction clearedKeys(...mutations: MutationResult[]): string[] {\\\\\\\\n  return mutations\\\\\\\\n    .flatMap((mutation) => mutation.cleared)\\\\\\\\n    .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\\\\\\\\n    .sort();\\\\\\\\n}\\\\\\\\n\\\\\\\\nfunction pendingKeys(...reports: Array<readonly FormReportEntry[]>): string[] {\\\\\\\\n  return reports\\\\\\\\n    .flat()\\\\\\\\n    .filter((entry) => entry.state === \\\\\\\\\\\\\\\"pending\\\\\\\\\\\\\\\")\\\\\\\\n    .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\\\\\\\\n    .sort();\\\\\\\\n}\\\\\\\\n\\\\\\\\ntype SweepLine = SweepReceipt[\\\\\\\\\\\\\\\"owners\\\\\\\\\\\\\\\"][number];\\\\\\\\nfunction byOwnerKind(rows: readonly SweepLine[]): SweepLine[] {\\\\\\\\n  return [...rows].sort((a, b) =>\\\\\\\\n    `${a.owner}/${a.kind}`.localeCompare(`${b.owner}/${b.kind}`),\\\\\\\\n  );\\\\\\\\n}\\\\\\\\n\\\\\\\\n// The materialized file with the run's own thread id substituted — the one\\\\\\\\n// sanctioned normalization (see header).\\\\\\\\nfunction comparableSessionFile(lifecycleRun: LifecycleRun): string {\\\\\\\\n  return readFileSync(lifecycleRun.outPath, \\\\\\\\\\\\\\\"utf8\\\\\\\\\\\\\\\").replaceAll(\\\\\\\\n    lifecycleRun.threadId,\\\\\\\\n    \\\\\\\\\\\\\\\"<thread-id>\\\\\\\\\\\\\\\",\\\\\\\\n  );\\\\\\\\n}\\\\\\\\n\\\\\\\\ndescribe(\\\\\\\\\\\\\\\"TC-5.1 / AC-5.1: the full sequence completes ok through one SDK configuration\\\\\\\\\\\\\\\", () => {\\\\\\\\n  it(\\\\\\\\\\\\\\\"every phase operation returns ok with the deterministic provider only\\\\\\\\\\\\\\\", () => {\\\\\\\\n    const { phases } = run;\\\\\\\\n    expect(phases.create.ok).toBe(true);\\\\\\\\n    for (const batch of phases.intake) expect(batch.ok).toBe(true);\\\\\\\\n    expect(phases.drain.settled).toBe(true);\\\\\\\\n    expect(phases.status.ok).toBe(true);\\\\\\\\n    expect(phases.compact1.ok).toBe(true);\\\\\\\\n    expect(phases.pull1.ok).toBe(true);\\\\\\\\n    expect(phases.inspect1.overview.ok).toBe(true);\\\\\\\\n    expect(phases.inspect1.view.ok).toBe(true);\\\\\\\\n    expect(phases.inspect1.health.ok).toBe(true);\\\\\\\\n    expect(phases.mutate.edit.ok).toBe(true);\\\\\\\\n    expect(phases.mutate.delete.ok).toBe(true);\\\\\\\\n    expect(phases.mutate.healthAfterMutate.ok).toBe(true);\\\\\\\\n    expect(phases.rebuild.settled).toBe(true);\\\\\\\\n    expect(phases.health2.ok).toBe(true);\\\\\\\\n    expect(phases.compact2.ok).toBe(true);\\\\\\\\n    expect(phases.pull2.ok).toBe(true);\\\\\\\\n    expect(phases.materialize.ok).toBe(true);\\\\\\\\n  });\\\\\\\\n\\\\\\\\n  it(\\\\\\\\\\\\\\\"status recommends the compact the sequence performs next, with derivation settled\\\\\\\\\\\\\\\", () => {\\\\\\\\n    const status = ok(run.phases.status);\\\\\\\\n    expect(status.threshold).toBe(300);\\\\\\\\n    expect(status.tailTokens).toBeGreaterThan(status.threshold);\\\\\\\\n    expect(status.compactRecommended).toBe(true);\\\\\\\\n    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\\\\\\\\n    expect(status.view).toBeNull(); // not yet compacted at this checkpoint\\\\\\\\n  });\\\\\\\\n});\\\\\\\\n\\\\\\\\ndescribe(\\\\\\\\\\\\\\\"TC-5.1 / AC-5.2: checkpoint coherence across the sequence\\\\\\\\\\\\\\\", () => {\\\\\\\\n  it(\\\\\\\\\\\\\\\"post-compact pull serves bands + tail, and the view report's loadCost prices that pull\\\\\\\\\\\\\\\", () => {\\\\\\\\n    const receipt = ok(run.phases.compact1);\\\\\\\\n    expect(receipt.profile).toBe(LIFECYCLE_PROFILE.name);\\\\\\\\n    const pull = ok(run.phases.pull1);\\\\\\\\n\\\\\\\\n    // Bands open the array in gradient order; the tail follows in record\\\\\\\\n    // order — the served shape the PI extension will consume.\\\\\\\\n    const bands = pull.messages.filter((message) => message.band !== undefined);\\\\\\\\n    expect(bands.map((message) => message.band)).toEqual([\\\\\\\\\\\\\\\"brief\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"detailed\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"smooth\\\\\\\\\\\\\\\"]);\\\\\\\\n    expect(pull.messages.slice(0, bands.length)).toEqual(bands);\\\\\\\\n    const tail = pull.messages.slice(bands.length);\\\\\\\\n    expect(tail.length).toBeGreaterThan(0);\\\\\\\\n    expect(tail.every((message) => message.band === undefined)).toBe(true);\\\\\\\\n    expect(pull.meta.viewId).toBe(receipt.viewId);\\\\\\\\n    expect(pull.meta.compactPoint).toBe(receipt.compactPoint);\\\\\\\\n\\\\\\\\n    // Cross-epic loadCost checkpoint (test plan: report at compact1 vs\\\\\\\\n    // pull1): the inspect report's serving cost equals this independent\\\\\\\\n    // pull re-measured with the shared estimator.\\\\\\\\n    const report = ok(run.phases.inspect1.view);\\\\\\\\n    expect(report.meta?.viewId).toBe(receipt.viewId);\\\\\\\\n    expect(report.meta?.profile).toBe(LIFECYCLE_PROFILE.name);\\\\\\\\n    expect(report.loadCost.bandTokens).toBe(measured(bands));\\\\\\\\n    expect(report.loadCost.tailTokens).toBe(measured(tail));\\\\\\\\n    expect(report.loadCost.total).toBe(measured(pull.messages));\\\\\\\\n\\\\\\\\n    // Overview agrees on the same view identity with derivation settled.\\\\\\\\n    const overview = ok(run.phases.inspect1.overview);\\\\\\\\n    expect(overview.view?.viewId).toBe(receipt.viewId);\\\\\\\\n    expect(overview.derivation.pending).toBe(0);\\\\\\\\n    expect(overview.messages.deleted).toBe(0);\\\\\\\\n  });\\\\\\\\n\\\\\\\\n  it(\\\\\\\\\\\\\\\"post-mutation health shows exactly the cleared set pending; post-drain health shows it ready\\\\\\\\\\\\\\\", () => {\\\\\\\\n    const { mutate } = run.phases;\\\\\\\\n    const edit = ok(mutate.edit);\\\\\\\\n    const deleted = ok(mutate.delete);\\\\\\\\n    expect(edit.superseded).toEqual([]);\\\\\\\\n    expect(deleted.superseded).toEqual([]);\\\\\\\\n    // The deleted assistant_text owns no derived forms: its cascade clears\\\\\\\\n    // sibling turn forms only.\\\\\\\\n    expect(deleted.dropped).toEqual([]);\\\\\\\\n\\\\\\\\n    // The cascade contracts' cleared union IS the pending set the owners\\\\\\\\n    // report — no more, no less (AC-5.2's \\\\\\\\\\\\\\\"the cleared set pending\\\\\\\\\\\\\\\").\\\\\\\\n    const cleared = clearedKeys(edit, deleted);\\\\\\\\n    expect(cleared.length).toBeGreaterThan(0);\\\\\\\\n    const pending = pendingKeys(ok(mutate.messagesNotReady), ok(mutate.turnsNotReady));\\\\\\\\n    expect(pending).toEqual(cleared);\\\\\\\\n\\\\\\\\n    // Health joins the same truth: pending counts sum to the cleared set,\\\\\\\\n    // with the queued replacement work live and unclaimed (the background\\\\\\\\n    // drain has not started — the snapshot precedes its first pass).\\\\\\\\n    const health = ok(mutate.healthAfterMutate);\\\\\\\\n    const pendingTotal = health.owners.reduce(\\\\\\\\n      (sum, row) => sum + row.counts.pending + row.counts.retrying,\\\\\\\\n      0,\\\\\\\\n    );\\\\\\\\n    expect(pendingTotal).toBe(cleared.length);\\\\\\\\n    // Queue visibility is counted per report entry (AC-4.5's by-construction\\\\\\\\n    // consistency), so queued equals the pending entries — all unclaimed.\\\\\\\\n    expect(health.queue).toEqual({ queued: cleared.length, claimed: 0 });\\\\\\\\n    expect(edit.queued.length).toBeGreaterThan(0);\\\\\\\\n    expect(deleted.queued.length).toBeGreaterThan(0);\\\\\\\\n    expect(health.failures).toEqual([]);\\\\\\\\n\\\\\\\\n    // Post-drain (rebuild settled): everything ready, nothing failed,\\\\\\\\n    // queue empty.\\\\\\\\n    const after = ok(run.phases.health2);\\\\\\\\n    for (const row of after.owners) {\\\\\\\\n      expect(row.counts.pending).toBe(0);\\\\\\\\n      expect(row.counts.retrying).toBe(0);\\\\\\\\n      expect(row.counts.failed).toBe(0);\\\\\\\\n      expect(row.counts.blocked).toBe(0);\\\\\\\\n      expect(row.counts.ready).toBeGreaterThan(0);\\\\\\\\n    }\\\\\\\\n    expect(after.failures).toEqual([]);\\\\\\\\n    expect(after.repairPreview).toEqual([]);\\\\\\\\n    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\\\\\\\\n  });\\\\\\\\n\\\\\\\\n  it(\\\\\\\\\\\\\\\"the second compact's view reflects post-edit content\\\\\\\\\\\\\\\", () => {\\\\\\\\n    const pull1 = ok(run.phases.pull1);\\\\\\\\n    const pull2 = ok(run.phases.pull2);\\\\\\\\n\\\\\\\\n    // Before the mutations: the original prompt and the to-be-deleted text\\\\\\\\n    // are served verbatim in the tail (full fidelity).\\\\\\\\n    expect(\\\\\\\\n      pull1.messages.some((m) => m.content === \\\\\\\\\\\\\\\"turn 12: please investigate area 12\\\\\\\\\\\\\\\"),\\\\\\\\n    ).toBe(true);\\\\\\\\n    expect(pull1.messages.some((m) => m.content === DELETED_MESSAGE_TEXT)).toBe(true);\\\\\\\\n\\\\\\\\n    // After mutate + rebuild + compact2: the edited prompt serves verbatim,\\\\\\\\n    // the deleted message is gone from the served view entirely.\\\\\\\\n    expect(\\\\\\\\n      pull2.messages.some(\\\\\\\\n        (m) => m.band === undefined && m.role === \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\" && m.content === EDITED_MESSAGE_TEXT,\\\\\\\\n      ),\\\\\\\\n    ).toBe(true);\\\\\\\\n    expect(pull2.messages.some((m) => m.content.includes(DELETED_MESSAGE_TEXT))).toBe(false);\\\\\\\\n    expect(\\\\\\\\n      pull2.messages.some((m) => m.content === \\\\\\\\\\\\\\\"turn 12: please investigate area 12\\\\\\\\\\\\\\\"),\\\\\\\\n    ).toBe(false);\\\\\\\\n  });\\\\\\\\n\\\\\\\\n  it(\\\\\\\\\\\\\\\"the second compact receipt's sweep section agrees with the health report taken immediately before it\\\\\\\\\\\\\\\", () => {\\\\\\\\n    const receipt = ok(run.phases.compact2);\\\\\\\\n    const health: HealthReport = ok(run.phases.health2);\\\\\\\\n    expect(\\\\\\\\\\\\\\\"owners\\\\\\\\\\\\\\\" in receipt.sweep).toBe(true);\\\\\\\\n    const sweep = receipt.sweep as SweepReceipt;\\\\\\\\n\\\\\\\\n    // Field-level agreement per owner/kind: the sweep saw exactly the state\\\\\\\\n    // health reported — same ready counts, in-flight = pending + retrying,\\\\\\\\n    // and the failed/requeued/blocked sets empty on both sides.\\\\\\\\n    const expectedFromHealth = health.owners.map((row) => ({\\\\\\\\n      owner: row.owner,\\\\\\\\n      kind: row.kind,\\\\\\\\n      ready: row.counts.ready,\\\\\\\\n      inFlight: row.counts.pending + row.counts.retrying,\\\\\\\\n      requeued: [],\\\\\\\\n      blocked: [],\\\\\\\\n      permanentFailed: [],\\\\\\\\n    }));\\\\\\\\n    expect(byOwnerKind(sweep.owners)).toEqual(byOwnerKind(expectedFromHealth));\\\\\\\\n    expect(health.failures).toEqual([]);\\\\\\\\n  });\\\\\\\\n});\\\\\\\\n\\\\\\\\ndescribe(\\\\\\\\\\\\\\\"TC-5.2 / AC-5.3: replay determinism on a fresh thread\\\\\\\\\\\\\\\", () => {\\\\\\\\n  it(\\\\\\\\\\\\\\\"produces hash-equal pull outputs and a byte-identical materialized file (modulo the one random thread id)\\\\\\\\\\\\\\\", async () => {\\\\\\\\n    const replay = await runLifecycle(store, { name: \\\\\\\\\\\\\\\"replay\\\\\\\\\\\\\\\" });\\\\\\\\n\\\\\\\\n    // Pull outputs: exact hash equality, no normalization — the frozen\\\\\\\\n    // clock leaves no ambient input, so any inequality is real\\\\\\\\n    // nondeterminism in the built surfaces.\\\\\\\\n    const pulls: Array<[OpResult<PullResult>, OpResult<PullResult>]> = [\\\\\\\\n      [run.phases.pull1, replay.phases.pull1],\\\\\\\\n      [run.phases.pull2, replay.phases.pull2],\\\\\\\\n    ];\\\\\\\\n    for (const [original, replayed] of pulls) {\\\\\\\\n      expect(sha256(JSON.stringify(ok(replayed)))).toBe(sha256(JSON.stringify(ok(original))));\\\\\\\\n    }\\\\\\\\n\\\\\\\\n    // Materialized file: identical bytes after substituting each thread's\\\\\\\\n    // own id (the header's one random value — see file header note).\\\\\\\\n    expect(replay.threadId).not.toBe(run.threadId);\\\\\\\\n    expect(sha256(comparableSessionFile(replay))).toBe(sha256(comparableSessionFile(run)));\\\\\\\\n  }, 60000);\\\\\\\\n});\\\\\\\\n\\\\\\\\ndescribe(\\\\\\\\\\\\\\\"TC-5.3 / AC-5.4: teardown continuity — fresh createSdk between phase groups\\\\\\\\\\\\\\\", () => {\\\\\\\\n  it(\\\\\\\\\\\\\\\"yields final pull, health, and materialized file identical to the uninterrupted run's\\\\\\\\\\\\\\\", async () => {\\\\\\\\n    const teardown = await runLifecycle(store, {\\\\\\\\n      name: \\\\\\\\\\\\\\\"teardown\\\\\\\\\\\\\\\",\\\\\\\\n      freshSdkBetweenGroups: true,\\\\\\\\n    });\\\\\\\\n\\\\\\\\n    // No in-memory dependency: the end state lives in the thread file, so a\\\\\\\\n    // fresh instance continuing each phase group lands byte-identical.\\\\\\\\n    expect(JSON.stringify(ok(teardown.phases.pull2))).toBe(\\\\\\\\n      JSON.stringify(ok(run.phases.pull2)),\\\\\\\\n    );\\\\\\\\n    expect(ok(teardown.phases.health2)).toEqual(ok(run.phases.health2));\\\\\\\\n    expect(sha256(comparableSessionFile(teardown))).toBe(sha256(comparableSessionFile(run)));\\\\\\\\n  }, 60000);\\\\\\\\n});\\\\\\\\n\\\\\\\",\\\\\\\"numLines\\\\\\\":305,\\\\\\\"startLine\\\\\\\":1,\\\\\\\"totalLines\\\\\\\":305}}}\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:356:{\\\\\\\"type\\\\\\\":\\\\\\\"assistant\\\\\\\",\\\\\\\"message\\\\\\\":{\\\\\\\"model\\\\\\\":\\\\\\\"claude-fable-5\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"msg_01NKdrBTAh4MrJm5fPskwbAd\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"message\\\\\\\",\\\\\\\"role\\\\\\\":\\\\\\\"assistant\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"type\\\\\\\":\\\\\\\"tool_use\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"toolu_018BCQBJCPDhpFM3FZuc9iQ9\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"Bash\\\\\\\",\\\\\\\"input\\\\\\\":{\\\\\\\"command\\\\\\\":\\\\\\\"cd /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc && grep -n \\\\\\\\\\\\\\\"export\\\\\\\\\\\\\\\" test/fixtures/index.ts | head -40; echo \\\\\\\\\\\\\\\"---\\\\\\\\\\\\\\\"; grep -n \\\\\\\\\\\\\\\"readDerivedForms\\\\\\\\\\\\\\\\|interface DerivedForm\\\\\\\\\\\\\\\\b\\\\\\\\\\\\\\\" test/fixtures/threads.ts src/index.ts src/shared/derivation.ts | head; echo \\\\\\\\\\\\\\\"---\\\\\\\\\\\\\\\"; env | grep -i \\\\\\\\\\\\\\\"OPENROUTER\\\\\\\\\\\\\\\" ; echo \\\\\\\\\\\\\\\"key-check-done\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Check fixture exports and OpenRouter env key\\\\\\\"},\\\\\\\"caller\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"direct\\\\\\\"}}],\\\\\\\"stop_reason\\\\\\\":null,\\\\\\\"stop_sequence\\\\\\\":null,\\\\\\\"stop_details\\\\\\\":null,\\\\\\\"usage\\\\\\\":{\\\\\\\"input_tokens\\\\\\\":2,\\\\\\\"cache_creation_input_tokens\\\\\\\":6250,\\\\\\\"cache_read_input_tokens\\\\\\\":82269,\\\\\\\"cache_creation\\\\\\\":{\\\\\\\"ephemeral_5m_input_tokens\\\\\\\":0,\\\\\\\"ephemeral_1h_input_tokens\\\\\\\":6250},\\\\\\\"output_tokens\\\\\\\":4,\\\\\\\"service_tier\\\\\\\":\\\\\\\"standard\\\\\\\",\\\\\\\"inference_geo\\\\\\\":\\\\\\\"not_available\\\\\\\"},\\\\\\\"diagnostics\\\\\\\":null,\\\\\\\"context_management\\\\\\\":null},\\\\\\\"parent_tool_use_id\\\\\\\":null,\\\\\\\"session_id\\\\\\\":\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\",\\\\\\\"uuid\\\\\\\":\\\\\\\"8911b80d-9ab5-4184-80b8-b032b773db48\\\\\\\",\\\\\\\"request_id\\\\\\\":\\\\\\\"req_011CbzE4ppQ
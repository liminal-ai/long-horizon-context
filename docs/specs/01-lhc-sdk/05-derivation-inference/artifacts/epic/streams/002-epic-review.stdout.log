{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/inference-classification.test.ts | sed -n '1,320p'\"","aggregated_output":"     1\t// Epic 05 Story 4 — TC-3.1 (AC-3.1, AC-3.2) and TC-3.2 (AC-3.2, AC-3.3):\n     2\t// model-call failures classify through the fixed table into Epic 02's\n     3\t// provider-result machinery, unchanged. The table is asserted directly as\n     4\t// data; retryable kinds back off and retry within budget, exhaustion lands\n     5\t// failed with the provider_failure-led reason and attempts/last-error in form\n     6\t// metadata, terminal kinds land failed after exactly one call. safeCall\n     7\t// contains thrown host exceptions (classified `other`) and races the\n     8\t// adapter-owned timeout (classified `timeout`, DD-6) — no host function\n     9\t// behavior can crash a drain. Reason format per the Story 3 ruling:\n    10\t// retryable → `provider_failure: <kind>: <message>`, terminal → kind-led.\n    11\timport { afterEach, describe, expect, it } from \"vitest\";\n    12\timport { createSdk, type DerivedForm, type DrainReport, type Lhc } from \"../src/index.js\";\n    13\timport { FAILURE_CLASSIFICATION, safeCall } from \"../src/inference/classify.js\";\n    14\timport type { ModelCall, ModelCallInput } from \"../src/inference/types.js\";\n    15\timport {\n    16\t  cannedResponses,\n    17\t  FAKE_MODEL_PREFIX,\n    18\t  FORM_KINDS,\n    19\t  hangingCall,\n    20\t  readDerivedForms,\n    21\t  recordingCall,\n    22\t  scriptedCall,\n    23\t  tempStore,\n    24\t  throwingCall,\n    25\t  validAssignments,\n    26\t  validEvent,\n    27\t  type TempStore,\n    28\t} from \"./fixtures/index.js\";\n    29\t\n    30\tconst stores: TempStore[] = [];\n    31\tafterEach(() => {\n    32\t  for (const store of stores.splice(0)) store.cleanup();\n    33\t});\n    34\t\n    35\tfunction freshStore(): TempStore {\n    36\t  const store = tempStore();\n    37\t  stores.push(store);\n    38\t  return store;\n    39\t}\n    40\t\n    41\tconst RETRY = { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 };\n    42\t// Tiny target (the adapter-suite pattern): each placed turn crosses it, so\n    43\t// turn 1's chunk closes during the multi-kind drain and the two chunk-summary\n    44\t// kinds run too.\n    45\tconst CHUNK_POLICY = { targetProjectedTokens: 5, maxProjectedTokens: 4400 };\n    46\t\n    47\tconst PROBE_INPUT: ModelCallInput = {\n    48\t  provider: \"prov-probe\",\n    49\t  model: \"model-probe\",\n    50\t  messages: [{ role: \"user\", content: \"probe\" }],\n    51\t};\n    52\t\n    53\tfunction inferenceSdk(call: ModelCall, timeoutMs?: number): Lhc {\n    54\t  return createSdk({\n    55\t    inference: { call, assignments: validAssignments(), ...(timeoutMs === undefined ? {} : { timeoutMs }) },\n    56\t    mode: \"manual\",\n    57\t    retry: RETRY,\n    58\t    chunkPolicy: CHUNK_POLICY,\n    59\t  });\n    60\t}\n    61\t\n    62\t// One prompt, no turn_end: exactly one work item (prompt_smoothing) queues,\n    63\t// so a scripted call's entries map one-to-one onto smoothing attempts.\n    64\tasync function seedSmoothingOnly(sdk: Lhc, store: TempStore): Promise<string> {\n    65\t  const filePath = store.threadPath();\n    66\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    67\t  expect(created.ok).toBe(true);\n    68\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n    69\t    validEvent(\"user_prompt\", { payload: { text: \"only a prompt to smooth\" } }),\n    70\t  ]);\n    71\t  expect(result.ok).toBe(true);\n    72\t  return filePath;\n    73\t}\n    74\t\n    75\t// Turn 1 carries a clean tool run; turn 2 closes turn 1's chunk under the\n    76\t// tiny target policy, so all seven kinds queue (the adapter-suite seeding).\n    77\tasync function seedSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\n    78\t  const filePath = store.threadPath();\n    79\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    80\t  expect(created.ok).toBe(true);\n    81\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n    82\t    validEvent(\"user_prompt\", { payload: { text: \"please inspect the fixture file\" } }),\n    83\t    validEvent(\"tool_call\", {\n    84\t      payload: {\n    85\t        toolCallId: \"call-classify-1\",\n    86\t        toolName: \"read_file\",\n    87\t        arguments: { path: \"fixture.txt\" },\n    88\t      },\n    89\t    }),\n    90\t    validEvent(\"tool_result\", {\n    91\t      payload: { toolCallId: \"call-classify-1\", content: \"contents of fixture.txt\", isError: false },\n    92\t    }),\n    93\t    validEvent(\"assistant_text\", { payload: { text: \"the fixture file holds fixture text\" } }),\n    94\t    validEvent(\"turn_end\"),\n    95\t    validEvent(\"user_prompt\", { payload: { text: \"thanks, now summarize it\" } }),\n    96\t    validEvent(\"assistant_text\", { payload: { text: \"summarized\" } }),\n    97\t    validEvent(\"turn_end\"),\n    98\t  ]);\n    99\t  expect(result.ok).toBe(true);\n   100\t  return filePath;\n   101\t}\n   102\t\n   103\t// Drains to empty — the \"drain returns normally\" assertion every leg shares —\n   104\t// and hands back both the report (dispositions, attempts) and the forms.\n   105\tasync function drainNormally(\n   106\t  sdk: Lhc,\n   107\t  filePath: string,\n   108\t): Promise<{ report: DrainReport; forms: DerivedForm[] }> {\n   109\t  const drained = await sdk.work.drain({ filePath });\n   110\t  expect(drained.ok).toBe(true);\n   111\t  if (!drained.ok) throw new Error(\"drain failed\");\n   112\t  expect(drained.value.stoppedBecause).toBe(\"empty\");\n   113\t  expect(drained.value.remaining).toBe(0);\n   114\t  return { report: drained.value, forms: readDerivedForms(filePath) };\n   115\t}\n   116\t\n   117\tfunction countingCall(inner: ModelCall): { call: ModelCall; calls: () => number } {\n   118\t  let calls = 0;\n   119\t  return {\n   120\t    call: (input) => {\n   121\t      calls += 1;\n   122\t      return inner(input);\n   123\t    },\n   124\t    calls: () => calls,\n   125\t  };\n   126\t}\n   127\t\n   128\tdescribe(\"TC-3.1: the classification table drives retry and terminal paths (AC-3.1, AC-3.2)\", () => {\n   129\t  it(\"FAILURE_CLASSIFICATION matches AC-3.1 exactly, as data\", () => {\n   130\t    expect(FAILURE_CLASSIFICATION).toEqual({\n   131\t      rate_limit: { retryable: true },\n   132\t      timeout: { retryable: true },\n   133\t      network: { retryable: true },\n   134\t      empty_output: { retryable: true },\n   135\t      other: { retryable: true },\n   136\t      auth: { retryable: false },\n   137\t      invalid_request: { retryable: false },\n   138\t    });\n   139\t  });\n   140\t\n   141\t  it(\"rate_limit twice then success: the form lands ready and the attempts are recorded\", async () => {\n   142\t    const { call, calls } = countingCall(\n   143\t      scriptedCall([\n   144\t        { ok: false, kind: \"rate_limit\", message: \"throttled by the fake host\" },\n   145\t        { ok: false, kind: \"rate_limit\", message: \"throttled by the fake host\" },\n   146\t        { ok: true, text: \"smoothed after two rate limits\" },\n   147\t      ]),\n   148\t    );\n   149\t    const sdk = inferenceSdk(call);\n   150\t    const { report, forms } = await drainNormally(sdk, await seedSmoothingOnly(sdk, freshStore()));\n   151\t\n   152\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n   153\t    expect(smoothed?.state).toBe(\"ready\");\n   154\t    expect(smoothed?.content).toBe(\"smoothed after two rate limits\");\n   155\t    expect(calls()).toBe(3);\n   156\t    // The retries happened inside the existing machinery: one item ran, done,\n   157\t    // with both failed attempts on its disposition record.\n   158\t    expect(report.ran).toHaveLength(1);\n   159\t    expect(report.ran[0]).toMatchObject({ disposition: \"done\", attempts: 2 });\n   160\t  });\n   161\t\n   162\t  it(\"auth is terminal: failed on the first attempt, exactly one call, stable kind-led reason\", async () => {\n   163\t    const { call, calls } = countingCall(\n   164\t      scriptedCall([{ ok: false, kind: \"auth\", message: \"invalid api key\" }]),\n   165\t    );\n   166\t    const sdk = inferenceSdk(call);\n   167\t    const { report, forms } = await drainNormally(sdk, await seedSmoothingOnly(sdk, freshStore()));\n   168\t\n   169\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n   170\t    expect(smoothed?.state).toBe(\"failed\");\n   171\t    // Terminal reasons lead with the kind (machine-readable code before the\n   172\t    // first colon) — stable across attempts because there is only one.\n   173\t    expect(smoothed?.reason).toBe(\"auth: invalid api key\");\n   174\t    expect(smoothed?.metadata?.attempts).toBe(1);\n   175\t    expect(calls()).toBe(1);\n   176\t    expect(report.ran).toHaveLength(1);\n   177\t    expect(report.ran[0]).toMatchObject({ disposition: \"failed_terminal\", attempts: 1 });\n   178\t  });\n   179\t\n   180\t  it(\"network failures exhaust the budget: failed, provider_failure-led reason, last error preserved\", async () => {\n   181\t    const { call, calls } = countingCall(\n   182\t      scriptedCall([\n   183\t        { ok: false, kind: \"network\", message: \"connection reset\" },\n   184\t        { ok: false, kind: \"network\", message: \"connection reset\" },\n   185\t        { ok: false, kind: \"network\", message: \"connection reset\" },\n   186\t      ]),\n   187\t    );\n   188\t    const sdk = inferenceSdk(call);\n   189\t    const { report, forms } = await drainNormally(sdk, await seedSmoothingOnly(sdk, freshStore()));\n   190\t\n   191\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n   192\t    expect(smoothed?.state).toBe(\"failed\");\n   193\t    expect(smoothed?.reason?.startsWith(\"provider_failure\")).toBe(true);\n   194\t    expect(smoothed?.reason).toContain(\"network\");\n   195\t    expect(smoothed?.metadata?.attempts).toBe(RETRY.budget);\n   196\t    expect(smoothed?.metadata?.lastError).toContain(\"network\");\n   197\t    expect(smoothed?.metadata?.lastError).toContain(\"connection reset\");\n   198\t    expect(calls()).toBe(RETRY.budget);\n   199\t    expect(report.ran[0]).toMatchObject({ disposition: \"failed_terminal\", attempts: RETRY.budget });\n   200\t  });\n   201\t});\n   202\t\n   203\tdescribe(\"TC-3.2: thrown exceptions and timeouts are contained; no host behavior crashes a drain (AC-3.2, AC-3.3)\", () => {\n   204\t  it(\"a throwing host on one kind retries as `other` to exhaustion while every other item completes\", async () => {\n   205\t    const responses = cannedResponses();\n   206\t    const { call: canned } = recordingCall(responses);\n   207\t    const smoothingLane = `${FAKE_MODEL_PREFIX}smoothed_prompt`;\n   208\t    const call: ModelCall = (input) =>\n   209\t      input.model === smoothingLane\n   210\t        ? Promise.reject(new Error(\"scripted host explosion\"))\n   211\t        : canned(input);\n   212\t    const sdk = inferenceSdk(call);\n   213\t    const { report, forms } = await drainNormally(sdk, await seedSevenKinds(sdk, freshStore()));\n   214\t\n   215\t    // The thrown exception classified `other` (retryable): each smoothing\n   216\t    // item burned its full budget, then landed failed with the thrown\n   217\t    // message as last error — never an escaped exception.\n   218\t    const smoothed = forms.filter((form) => form.form === \"smoothed_prompt\");\n   219\t    expect(smoothed.length).toBeGreaterThan(0);\n   220\t    for (const form of smoothed) {\n   221\t      expect(form.state).toBe(\"failed\");\n   222\t      expect(form.reason?.startsWith(\"provider_failure\")).toBe(true);\n   223\t      expect(form.reason).toContain(\"other\");\n   224\t      expect(form.metadata?.attempts).toBe(RETRY.budget);\n   225\t      expect(form.metadata?.lastError).toContain(\"scripted host explosion\");\n   226\t    }\n   227\t    // Every other kind completed: the drain continued past the throwing lane.\n   228\t    for (const kind of FORM_KINDS.filter((k) => k !== \"smoothed_prompt\")) {\n   229\t      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n   230\t      expect(ready.length).toBeGreaterThan(0);\n   231\t      for (const form of ready) expect(form.content).toBe(responses[kind]);\n   232\t    }\n   233\t    for (const entry of report.ran.filter((r) => r.workItemId.includes(\"prompt_smoothing\"))) {\n   234\t      expect(entry.disposition).toBe(\"failed_terminal\");\n   235\t    }\n   236\t  });\n   237\t\n   238\t  it(\"a hanging host classifies `timeout` under the adapter-owned race and the drain continues\", async () => {\n   239\t    const hangingLane = `${FAKE_MODEL_PREFIX}smoothed_prompt`;\n   240\t    const { call: canned } = recordingCall(cannedResponses());\n   241\t    const hang = hangingCall();\n   242\t    const call: ModelCall = (input) => (input.model === hangingLane ? hang(input) : canned(input));\n   243\t    const sdk = inferenceSdk(call, 50);\n   244\t    const store = freshStore();\n   245\t    const filePath = store.threadPath();\n   246\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   247\t    expect(created.ok).toBe(true);\n   248\t    const seeded = await sdk.intakeStream.messageEvents({ filePath }, [\n   249\t      validEvent(\"user_prompt\", { payload: { text: \"a prompt whose smoothing hangs\" } }),\n   250\t      validEvent(\"turn_end\"),\n   251\t    ]);\n   252\t    expect(seeded.ok).toBe(true);\n   253\t\n   254\t    const { forms } = await drainNormally(sdk, filePath);\n   255\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n   256\t    expect(smoothed?.state).toBe(\"failed\");\n   257\t    expect(smoothed?.reason?.startsWith(\"provider_failure\")).toBe(true);\n   258\t    expect(smoothed?.reason).toContain(\"timeout\");\n   259\t    expect(smoothed?.metadata?.attempts).toBe(RETRY.budget);\n   260\t    // The drain continued past the hanging lane: the turn's forms landed.\n   261\t    expect(forms.find((form) => form.form === \"turn_rendering\")?.state).toBe(\"ready\");\n   262\t    expect(forms.find((form) => form.form === \"lower_band_projection\")?.state).toBe(\"ready\");\n   263\t  });\n   264\t\n   265\t  it(\"timeout is retryable: a host that hangs once then answers lands the form ready\", async () => {\n   266\t    let attempt = 0;\n   267\t    const call: ModelCall = () => {\n   268\t      attempt += 1;\n   269\t      if (attempt === 1) return new Promise(() => {});\n   270\t      return Promise.resolve({ ok: true, text: \"answered after one hang\" });\n   271\t    };\n   272\t    const sdk = inferenceSdk(call, 50);\n   273\t    const { report, forms } = await drainNormally(sdk, await seedSmoothingOnly(sdk, freshStore()));\n   274\t\n   275\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n   276\t    expect(smoothed?.state).toBe(\"ready\");\n   277\t    expect(smoothed?.content).toBe(\"answered after one hang\");\n   278\t    expect(report.ran[0]).toMatchObject({ disposition: \"done\", attempts: 1 });\n   279\t  });\n   280\t\n   281\t  describe(\"safeCall is the containment wrapper (AC-3.3, DD-6)\", () => {\n   282\t    it(\"passes a structured success through untouched\", async () => {\n   283\t      const result = await safeCall(\n   284\t        scriptedCall([{ ok: true, text: \"plain success\" }]),\n   285\t        PROBE_INPUT,\n   286\t        1000,\n   287\t      );\n   288\t      expect(result).toEqual({ ok: true, text: \"plain success\" });\n   289\t    });\n   290\t\n   291\t    it(\"passes a structured failure through untouched\", async () => {\n   292\t      const result = await safeCall(\n   293\t        scriptedCall([{ ok: false, kind: \"rate_limit\", message: \"throttled\" }]),\n   294\t        PROBE_INPUT,\n   295\t        1000,\n   296\t      );\n   297\t      expect(result).toEqual({ ok: false, kind: \"rate_limit\", message: \"throttled\" });\n   298\t    });\n   299\t\n   300\t    it(\"classifies a thrown exception as `other`, carrying the message\", async () => {\n   301\t      const result = await safeCall(throwingCall(new Error(\"kaboom\")), PROBE_INPUT, 1000);\n   302\t      expect(result.ok).toBe(false);\n   303\t      if (!result.ok) {\n   304\t        expect(result.kind).toBe(\"other\");\n   305\t        expect(result.message).toContain(\"kaboom\");\n   306\t      }\n   307\t    });\n   308\t\n   309\t    it(\"classifies a synchronously throwing host as `other` (the promise contract is not trusted)\", async () => {\n   310\t      const sync: ModelCall = () => {\n   311\t        throw new Error(\"sync kaboom\");\n   312\t      };\n   313\t      const result = await safeCall(sync, PROBE_INPUT, 1000);\n   314\t      expect(result.ok).toBe(false);\n   315\t      if (!result.ok) {\n   316\t        expect(result.kind).toBe(\"other\");\n   317\t        expect(result.message).toContain(\"sync kaboom\");\n   318\t      }\n   319\t    });\n   320\t\n","exit_code":0,"status":"completed"}}

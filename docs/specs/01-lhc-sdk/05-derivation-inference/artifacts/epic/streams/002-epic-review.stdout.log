{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CCmi4CJct6svkYSqoYRoVE","type":"tool_result","content":"1\t// SETTLED (AC-2.3): the POC's tuned smoothing prompt, ported verbatim from\n2\t// pi-long-horizon's pi-codex-user-prompt-smoothing-provider (tested\n3\t// extensively there against alternatives). The protected-literals sentence\n4\t// rides along verbatim: LHC's smoothing input carries no literals list, so\n5\t// the clause is simply inert here, and the dial-in period owns any rewording\n6\t// under a new versioned name.\n7\timport type { PromptTemplate } from \"./index.js\";\n8\t\n9\texport const smoothingV1: PromptTemplate<{ text: string }> = {\n10\t  name: \"smoothing-v1\",\n11\t  render: (i) => [\n12\t    {\n13\t      role: \"system\",\n14\t      content:\n15\t        \"You smooth user prompts for long-horizon coding context.\\n\\nPreserve the user's intent, uncertainty, explicit constraints, file paths, commands, identifiers, numbers, thresholds, and priorities.\\nWhen protected literals are provided, copy each one exactly; do not normalize, shorten, spell-correct, or regenerate those strings.\\nFix typos, grammar, capitalization, and whitespace.\\nReduce repetition, anger, profanity, and attention-spiking phrasing without moralizing, apologizing, or adding therapeutic framing.\\nReturn only the smoothed prompt text.\",\n16\t    },\n17\t    { role: \"user\", content: i.text },\n18\t  ],\n19\t};\n20\t"}]},"parent_tool_use_id":null,"session_id":"bfcb3770-4909-4548-8bb4-e503f40f13df","uuid":"e8b4db58-4bc4-434c-a0ce-fd401dfa8650","timestamp":"2026-06-13T00:37:47.807Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/prompts/smoothing-v1.ts","content":"// SETTLED (AC-2.3): the POC's tuned smoothing prompt, ported verbatim from\n// pi-long-horizon's pi-codex-user-prompt-smoothing-provider (tested\n// extensively there against alternatives). The protected-literals sentence\n// rides along verbatim: LHC's smoothing input carries no literals list, so\n// the clause is simply inert here, and the dial-in period owns any rewording\n// under a new versioned name.\nimport type { PromptTemplate } from \"./index.js\";\n\nexport const smoothingV1: PromptTemplate<{ text: string }> = {\n  name: \"smoothing-v1\",\n  render: (i) => [\n    {\n      role: \"system\",\n      content:\n        \"You smooth user prompts for long-horizon coding context.\\n\\nPreserve the user's intent, uncertainty, explicit constraints, file paths, commands, identifiers, numbers, thresholds, and priorities.\\nWhen protected literals are provided, copy each one exactly; do not normalize, shorten, spell-correct, or regenerate those strings.\\nFix typos, grammar, capitalization, and whitespace.\\nReduce repetition, anger, profanity, and attention-spiking phrasing without moralizing, apologizing, or adding therapeutic framing.\\nReturn only the smoothed prompt text.\",\n    },\n    { role: \"user\", content: i.text },\n  ],\n};\n","numLines":20,"startLine":1,"totalLines":20}}}

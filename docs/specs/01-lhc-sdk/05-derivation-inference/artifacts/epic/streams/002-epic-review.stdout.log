{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/inference-prompts.test.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Epic 05 Story 3 — TC-2.2 (AC-2.2, AC-2.3): the seven LHC-owned prompt\n     2\t// templates. Goldens pin each template's rendered messages for a fixture\n     3\t// input (prompt/fixture drift is an architecture risk: a provider call could\n     4\t// succeed while a prompt silently loses required input fields); registry\n     5\t// completeness proves every config-selectable name resolves; the brief/\n     6\t// detailed contrast and the input-bounding legs run through the adapter\n     7\t// operations, never the renderers alone (anti-shim).\n     8\timport { readFileSync } from \"node:fs\";\n     9\timport path from \"node:path\";\n    10\timport { fileURLToPath } from \"node:url\";\n    11\timport { describe, expect, it } from \"vitest\";\n    12\timport { createInferenceProvider } from \"../src/inference/adapter.js\";\n    13\timport {\n    14\t  DEFAULT_PROMPT_NAMES,\n    15\t  PROMPT_REGISTRY,\n    16\t  type PromptTemplate,\n    17\t} from \"../src/inference/prompts/index.js\";\n    18\timport type { ModelCallInput, ResolvedInferenceConfig } from \"../src/inference/types.js\";\n    19\timport {\n    20\t  cannedResponses,\n    21\t  FAKE_MODEL_PREFIX,\n    22\t  FORM_KINDS,\n    23\t  recordingCall,\n    24\t  validAssignments,\n    25\t} from \"./fixtures/index.js\";\n    26\t\n    27\tconst goldensDir = path.join(\n    28\t  path.dirname(fileURLToPath(import.meta.url)),\n    29\t  \"goldens\",\n    30\t  \"prompts\",\n    31\t);\n    32\t\n    33\t// One fixture input per template, keyed by template name. Each carries\n    34\t// distinctive strings the golden embeds, so a template that drops an input\n    35\t// field fails its golden rather than passing on shape alone.\n    36\tconst PROMPT_FIXTURES: Record<string, { input: unknown; embedded: string[] }> = {\n    37\t  \"smoothing-v1\": {\n    38\t    input: { text: \"plz smooth this prmpt about src/app.ts line 42 thx\" },\n    39\t    embedded: [\"src/app.ts line 42\"],\n    40\t  },\n    41\t  \"tool-call-v1\": {\n    42\t    input: {\n    43\t      toolName: \"read_file\",\n    44\t      argsJson: '{\"path\":\"notes/plan.md\"}',\n    45\t      pairedResult: { content: \"plan contents: ship story three\", isError: false },\n    46\t    },\n    47\t    embedded: ['{\"path\":\"notes/plan.md\"}', \"ship story three\", \"isError: false\"],\n    48\t  },\n    49\t  \"tool-result-v1\": {\n    50\t    input: { toolName: \"read_file\", content: \"contents of notes/plan.md: 3 open items\" },\n    51\t    embedded: [\"contents of notes/plan.md: 3 open items\"],\n    52\t  },\n    53\t  \"turn-compose-v1\": {\n    54\t    input: {\n    55\t      parts: [\n    56\t        { messageId: \"m1\", kind: \"user_prompt\", text: \"please read notes/plan.md\", fallback: false },\n    57\t        {\n    58\t          messageId: \"m2\",\n    59\t          kind: \"tool_call\",\n    60\t          text: \"read_file called on notes/plan.md\",\n    61\t          fallback: false,\n    62\t          outcome: \"succeeded\",\n    63\t        },\n    64\t        { messageId: \"m3\", kind: \"assistant_text\", text: \"the plan has 3 open items\", fallback: false },\n    65\t      ],\n    66\t    },\n    67\t    embedded: [\"please read notes/plan.md\", \"outcome: succeeded\", \"the plan has 3 open items\"],\n    68\t  },\n    69\t  \"lower-band-v1\": {\n    70\t    input: {\n    71\t      rendering: \"The user asked for notes/plan.md; the assistant read it and reported 3 open items.\",\n    72\t    },\n    73\t    embedded: [\"reported 3 open items\"],\n    74\t  },\n    75\t  \"chunk-detailed-v1\": {\n    76\t    input: {\n    77\t      memberProjections: [\"turn one: read notes/plan.md\", \"turn two: edited src/app.ts\"],\n    78\t      memberReceipts: [\n    79\t        [\n    80\t          {\n    81\t            messageId: \"m2\",\n    82\t            activity: \"tool_call\",\n    83\t            account: \"read_file fetched notes/plan.md\",\n    84\t            outcome: \"succeeded\",\n    85\t          },\n    86\t        ],\n    87\t        [],\n    88\t      ],\n    89\t    },\n    90\t    embedded: [\"turn one: read notes/plan.md\", \"read_file fetched notes/plan.md => succeeded\"],\n    91\t  },\n    92\t  \"chunk-brief-v1\": {\n    93\t    input: {\n    94\t      memberProjections: [\"turn one: read notes/plan.md\", \"turn two: edited src/app.ts\"],\n    95\t      memberOutcomes: [[\"succeeded\"], []],\n    96\t    },\n    97\t    embedded: [\"turn two: edited src/app.ts\", \"Tool outcomes, in order: succeeded\"],\n    98\t  },\n    99\t};\n   100\t\n   101\tfunction renderByName(name: string, input: unknown): ModelCallInput[\"messages\"] {\n   102\t  const template = PROMPT_REGISTRY[name] as PromptTemplate<unknown> | undefined;\n   103\t  if (template === undefined) throw new Error(`template \"${name}\" not in registry`);\n   104\t  return template.render(input);\n   105\t}\n   106\t\n   107\tfunction resolvedConfig(\n   108\t  overrides: Partial<ResolvedInferenceConfig> & Pick<ResolvedInferenceConfig, \"call\">,\n   109\t): ResolvedInferenceConfig {\n   110\t  return {\n   111\t    assignments: validAssignments(),\n   112\t    timeoutMs: 60_000,\n   113\t    maxInputChars: 200_000,\n   114\t    ...overrides,\n   115\t  };\n   116\t}\n   117\t\n   118\tfunction userContent(input: ModelCallInput): string {\n   119\t  const user = input.messages.find((message) => message.role === \"user\");\n   120\t  if (user === undefined) throw new Error(\"no user message in rendered call\");\n   121\t  return user.content;\n   122\t}\n   123\t\n   124\tdescribe(\"TC-2.2: prompt-rendering goldens (AC-2.2, AC-2.3)\", () => {\n   125\t  for (const kind of FORM_KINDS) {\n   126\t    const name = DEFAULT_PROMPT_NAMES[kind];\n   127\t    it(`${name} renders its fixture input to the committed golden`, () => {\n   128\t      const fixture = PROMPT_FIXTURES[name];\n   129\t      expect(fixture).toBeDefined();\n   130\t      const rendered = renderByName(name, fixture?.input);\n   131\t      const golden = JSON.parse(\n   132\t        readFileSync(path.join(goldensDir, `${name}.golden.json`), \"utf8\"),\n   133\t      ) as ModelCallInput[\"messages\"];\n   134\t      expect(rendered).toEqual(golden);\n   135\t    });\n   136\t\n   137\t    it(`${name} embeds its fixture content in single-turn shape`, () => {\n   138\t      const fixture = PROMPT_FIXTURES[name];\n   139\t      const rendered = renderByName(name, fixture?.input);\n   140\t      expect(rendered.filter((message) => message.role === \"user\")).toHaveLength(1);\n   141\t      for (const message of rendered) {\n   142\t        expect([\"system\", \"user\"]).toContain(message.role);\n   143\t        expect(typeof message.content).toBe(\"string\");\n   144\t      }\n   145\t      const joined = rendered.map((message) => message.content).join(\"\\n\");\n   146\t      for (const needle of fixture?.embedded ?? []) {\n   147\t        expect(joined).toContain(needle);\n   148\t      }\n   149\t    });\n   150\t  }\n   151\t});\n   152\t\n   153\tdescribe(\"TC-2.2: registry completeness (AC-2.3)\", () => {\n   154\t  it(\"every registry key resolves to a template carrying that exact name\", () => {\n   155\t    const names = Object.keys(PROMPT_REGISTRY);\n   156\t    expect(names.length).toBeGreaterThanOrEqual(7);\n   157\t    for (const name of names) {\n   158\t      expect(PROMPT_REGISTRY[name]?.name).toBe(name);\n   159\t      expect(typeof PROMPT_REGISTRY[name]?.render).toBe(\"function\");\n   160\t    }\n   161\t  });\n   162\t\n   163\t  it(\"default names cover all seven kinds and each resolves in the registry\", () => {\n   164\t    const defaultNames = new Set<string>();\n   165\t    for (const kind of FORM_KINDS) {\n   166\t      const name = DEFAULT_PROMPT_NAMES[kind];\n   167\t      expect(typeof name).toBe(\"string\");\n   168\t      expect(PROMPT_REGISTRY[name]).toBeDefined();\n   169\t      defaultNames.add(name);\n   170\t    }\n   171\t    // Seven kinds, seven distinct templates — no kind shares another's prompt.\n   172\t    expect(defaultNames.size).toBe(7);\n   173\t  });\n   174\t});\n   175\t\n   176\tdescribe(\"TC-2.2: brief receipt-stripping holds through the adapter (AC-2.2)\", () => {\n   177\t  const RECEIPT_ACCOUNT = \"read_file fetched notes/plan.md and rewrote temp/out.txt\";\n   178\t\n   179\t  it(\"the brief rendering carries outcome tokens but no receipt text from its input\", async () => {\n   180\t    const { call, log } = recordingCall(cannedResponses());\n   181\t    const provider = createInferenceProvider(resolvedConfig({ call }));\n   182\t\n   183\t    const detailed = await provider.summarizeChunkDetailed({\n   184\t      memberProjections: [\"turn one: planning work\"],\n   185\t      memberReceipts: [\n   186\t        [{ messageId: \"m2\", activity: \"tool_call\", account: RECEIPT_ACCOUNT, outcome: \"succeeded\" }],\n   187\t      ],\n   188\t    });\n   189\t    const brief = await provider.summarizeChunkBrief({\n   190\t      memberProjections: [\"turn one: planning work\"],\n   191\t      memberOutcomes: [[\"succeeded\"]],\n   192\t    });\n   193\t    expect(detailed.ok).toBe(true);\n   194\t    expect(brief.ok).toBe(true);\n   195\t\n   196\t    const detailedCall = log.find(\n   197\t      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_detailed`,\n   198\t    );\n   199\t    const briefCall = log.find(\n   200\t      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_brief`,\n   201\t    );\n   202\t    expect(detailedCall).toBeDefined();\n   203\t    expect(briefCall).toBeDefined();\n   204\t    if (detailedCall === undefined || briefCall === undefined) return;\n   205\t\n   206\t    // The detailed lane is the contrast: its rendering carries the receipt\n   207\t    // account verbatim, so its absence from the brief lane is stripping, not\n   208\t    // a template that ignores receipts altogether.\n   209\t    expect(userContent(detailedCall)).toContain(RECEIPT_ACCOUNT);\n   210\t    expect(userContent(briefCall)).toContain(\"succeeded\");\n   211\t    expect(userContent(briefCall)).not.toContain(RECEIPT_ACCOUNT);\n   212\t    expect(userContent(briefCall)).not.toContain(\"rewrote\");\n   213\t  });\n   214\t});\n   215\t\n   216\tdescribe(\"TC-2.2: tool-result input bounding (AC-2.2, DD-7)\", () => {\n   217\t  const MAX_INPUT_CHARS = 200;\n   218\t\n   219\t  it(\"oversized summarizeToolResult input renders head + tail + marker under maxInputChars\", async () => {\n   220\t    const { call, log } = recordingCall(cannedResponses());\n   221\t    const provider = createInferenceProvider(\n   222\t      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\n   223\t    );\n   224\t    const content = \"H\".repeat(150) + \"M\".repeat(700) + \"T\".repeat(150);\n   225\t    const result = await provider.summarizeToolResult({ toolName: \"read_file\", content });\n   226\t    expect(result.ok).toBe(true);\n   227\t\n   228\t    const input = log[0];\n   229\t    expect(input).toBeDefined();\n   230\t    if (input === undefined) return;\n   231\t    const user = userContent(input);\n   232\t    const bounded = user.slice(user.indexOf(\"Output:\\n\") + \"Output:\\n\".length);\n   233\t    expect(bounded.length).toBeLessThanOrEqual(MAX_INPUT_CHARS);\n   234\t    expect(bounded.startsWith(\"HHHH\")).toBe(true);\n   235\t    expect(bounded.endsWith(\"TTTT\")).toBe(true);\n   236\t    expect(bounded).toContain(\"truncated\");\n   237\t    // Bounding happened before rendering: the middle never reached the prompt.\n   238\t    expect(user).not.toContain(\"M\".repeat(50));\n   239\t  });\n   240\t\n   241\t  it(\"a maxInputChars below the truncation marker still bounds the whole (DD-7)\", async () => {\n   242\t    const { call, log } = recordingCall(cannedResponses());\n   243\t    // 40 chars is a legitimately small context budget — and shorter than the\n   244\t    // truncation marker itself. It is the counterexample to a naive\n   245\t    // head+tail+marker bound: with no room for the marker, that bound returns\n   246\t    // the marker alone and overshoots the cap it was meant to hold.\n   247\t    const tinyMax = 40;\n   248\t    const provider = createInferenceProvider(\n   249\t      resolvedConfig({ call, maxInputChars: tinyMax }),\n   250\t    );\n   251\t    const content = \"H\".repeat(40) + \"M\".repeat(700) + \"T\".repeat(40);\n   252\t    const result = await provider.summarizeToolResult({ toolName: \"read_file\", content });\n   253\t    expect(result.ok).toBe(true);\n   254\t\n   255\t    const input = log[0];\n   256\t    expect(input).toBeDefined();\n   257\t    if (input === undefined) return;\n   258\t    const user = userContent(input);\n   259\t    const bounded = user.slice(user.indexOf(\"Output:\\n\") + \"Output:\\n\".length);\n   260\t    // The bounded whole never exceeds the cap, even though no marker fits.\n   261\t    expect(bounded.length).toBeLessThanOrEqual(tinyMax);\n   262\t    // With no room for the marker the bound degrades to a plain head: a true\n   263\t    // prefix of the input, never the marker text standing on its own.\n   264\t    expect(content.startsWith(bounded)).toBe(true);\n   265\t    expect(bounded).not.toContain(\"truncated\");\n   266\t    expect(user).not.toContain(\"M\".repeat(50));\n   267\t  });\n   268\t\n   269\t  it(\"under-limit input renders whole, no marker\", async () => {\n   270\t    const { call, log } = recordingCall(cannedResponses());\n   271\t    const provider = createInferenceProvider(\n   272\t      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\n   273\t    );\n   274\t    const content = \"W\".repeat(MAX_INPUT_CHARS);\n   275\t    const result = await provider.summarizeToolResult({ toolName: \"read_file\", content });\n   276\t    expect(result.ok).toBe(true);\n   277\t\n   278\t    const input = log[0];\n   279\t    expect(input).toBeDefined();\n   280\t    if (input === undefined) return;\n   281\t    const user = userContent(input);\n   282\t    expect(user).toContain(content);\n   283\t    expect(user).not.toContain(\"truncated\");\n   284\t  });\n   285\t});\n","exit_code":0,"status":"completed"}}

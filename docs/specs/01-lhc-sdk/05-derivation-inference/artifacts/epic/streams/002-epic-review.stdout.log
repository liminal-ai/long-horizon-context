\\\\\\"role\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"tool_use_id\\\\\\\":\\\\\\\"toolu_01TC3sDjL7Qvv6GXpRvM4FJ9\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"tool_result\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"1\\\\\\\\t// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\\\\\\\\n2\\\\\\\\t// run against the scripted fakes (TC-1.2) and, unchanged, against the real\\\\\\\\n3\\\\\\\\t// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\\\\\\\\n4\\\\\\\\t// Framework-agnostic on purpose: plain node:assert throws surface in vitest\\\\\\\\n5\\\\\\\\t// and in any future runner identically.\\\\\\\\n6\\\\\\\\timport assert from \\\\\\\\\\\\\\\"node:assert/strict\\\\\\\\\\\\\\\";\\\\\\\\n7\\\\\\\\timport { createSdk, type DerivedForm, type Lhc } from \\\\\\\\\\\\\\\"../../src/index.js\\\\\\\\\\\\\\\";\\\\\\\\n8\\\\\\\\timport { FORM_KINDS, type FormKind } from \\\\\\\\\\\\\\\"../../src/shared/derivation.js\\\\\\\\\\\\\\\";\\\\\\\\n9\\\\\\\\timport type {\\\\\\\\n10\\\\\\\\t  ModelAssignment,\\\\\\\\n11\\\\\\\\t  ModelCall,\\\\\\\\n12\\\\\\\\t  ModelCallInput,\\\\\\\\n13\\\\\\\\t} from \\\\\\\\\\\\\\\"../../src/inference/types.js\\\\\\\\\\\\\\\";\\\\\\\\n14\\\\\\\\timport { readDerivedForms } from \\\\\\\\\\\\\\\"./threads.js\\\\\\\\\\\\\\\";\\\\\\\\n15\\\\\\\\timport { validEvent, type TempStore } from \\\\\\\\\\\\\\\"./index.js\\\\\\\\\\\\\\\";\\\\\\\\n16\\\\\\\\t\\\\\\\\n17\\\\\\\\tconst FAILURE_KINDS = new Set([\\\\\\\\n18\\\\\\\\t  \\\\\\\\\\\\\\\"rate_limit\\\\\\\\\\\\\\\",\\\\\\\\n19\\\\\\\\t  \\\\\\\\\\\\\\\"timeout\\\\\\\\\\\\\\\",\\\\\\\\n20\\\\\\\\t  \\\\\\\\\\\\\\\"network\\\\\\\\\\\\\\\",\\\\\\\\n21\\\\\\\\t  \\\\\\\\\\\\\\\"empty_output\\\\\\\\\\\\\\\",\\\\\\\\n22\\\\\\\\t  \\\\\\\\\\\\\\\"other\\\\\\\\\\\\\\\",\\\\\\\\n23\\\\\\\\t  \\\\\\\\\\\\\\\"auth\\\\\\\\\\\\\\\",\\\\\\\\n24\\\\\\\\t  \\\\\\\\\\\\\\\"invalid_request\\\\\\\\\\\\\\\",\\\\\\\\n25\\\\\\\\t]);\\\\\\\\n26\\\\\\\\t\\\\\\\\n27\\\\\\\\texport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\\\\\\\\n28\\\\\\\\t  return {\\\\\\\\n29\\\\\\\\t    provider: \\\\\\\\\\\\\\\"probe-provider\\\\\\\\\\\\\\\",\\\\\\\\n30\\\\\\\\t    model: \\\\\\\\\\\\\\\"probe-model\\\\\\\\\\\\\\\",\\\\\\\\n31\\\\\\\\t    messages: [\\\\\\\\n32\\\\\\\\t      { role: \\\\\\\\\\\\\\\"system\\\\\\\\\\\\\\\", content: \\\\\\\\\\\\\\\"You answer with one word.\\\\\\\\\\\\\\\" },\\\\\\\\n33\\\\\\\\t      { role: \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\", content: \\\\\\\\\\\\\\\"Say ok.\\\\\\\\\\\\\\\" },\\\\\\\\n34\\\\\\\\t    ],\\\\\\\\n35\\\\\\\\t    ...overrides,\\\\\\\\n36\\\\\\\\t  };\\\\\\\\n37\\\\\\\\t}\\\\\\\\n38\\\\\\\\t\\\\\\\\n39\\\\\\\\t// AC-1.2's result contract on one probe call: a ModelCall resolves to either\\\\\\\\n40\\\\\\\\t// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\\\\\\\\n41\\\\\\\\t// failure vocabulary. Catches fixture (and real-host) drift from the\\\\\\\\n42\\\\\\\\t// boundary contract.\\\\\\\\n43\\\\\\\\texport async function assertModelCallContract(\\\\\\\\n44\\\\\\\\t  call: ModelCall,\\\\\\\\n45\\\\\\\\t  probe: ModelCallInput = probeInput(),\\\\\\\\n46\\\\\\\\t): Promise<void> {\\\\\\\\n47\\\\\\\\t  const result = await call(probe);\\\\\\\\n48\\\\\\\\t  assert.ok(\\\\\\\\n49\\\\\\\\t    typeof result === \\\\\\\\\\\\\\\"object\\\\\\\\\\\\\\\" && result !== null,\\\\\\\\n50\\\\\\\\t    \\\\\\\\\\\\\\\"ModelCall must resolve to a result object\\\\\\\\\\\\\\\",\\\\\\\\n51\\\\\\\\t  );\\\\\\\\n52\\\\\\\\t  if (result.ok === true) {\\\\\\\\n53\\\\\\\\t    assert.equal(typeof result.text, \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"success result must carry string text\\\\\\\\\\\\\\\");\\\\\\\\n54\\\\\\\\t  } else if (result.ok === false) {\\\\\\\\n55\\\\\\\\t    assert.ok(\\\\\\\\n56\\\\\\\\t      FAILURE_KINDS.has(result.kind),\\\\\\\\n57\\\\\\\\t      `failure kind \\\\\\\\\\\\\\\"${String(result.kind)}\\\\\\\\\\\\\\\" is not in the failure vocabulary`,\\\\\\\\n58\\\\\\\\t    );\\\\\\\\n59\\\\\\\\t    assert.equal(typeof result.message, \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"failure result must carry a string message\\\\\\\\\\\\\\\");\\\\\\\\n60\\\\\\\\t  } else {\\\\\\\\n61\\\\\\\\t    assert.fail(\\\\\\\\\\\\\\\"ModelCall result must discriminate on a boolean ok\\\\\\\\\\\\\\\");\\\\\\\\n62\\\\\\\\t  }\\\\\\\\n63\\\\\\\\t}\\\\\\\\n64\\\\\\\\t\\\\\\\\n65\\\\\\\\texport interface RoutingRunResult {\\\\\\\\n66\\\\\\\\t  sdk: Lhc;\\\\\\\\n67\\\\\\\\t  filePath: string;\\\\\\\\n68\\\\\\\\t  forms: DerivedForm[];\\\\\\\\n69\\\\\\\\t  log: ModelCallInput[];\\\\\\\\n70\\\\\\\\t}\\\\\\\\n71\\\\\\\\t\\\\\\\\n72\\\\\\\\tasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\\\\\\\\n73\\\\\\\\t  const filePath = store.threadPath();\\\\\\\\n74\\\\\\\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\\\\\\\n75\\\\\\\\t  assert.ok(created.ok, \\\\\\\\\\\\\\\"conformance fixture: thread creation failed\\\\\\\\\\\\\\\");\\\\\\\\n76\\\\\\\\t  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\\\\\\\\n77\\\\\\\\t  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\\\\\\\\n78\\\\\\\\t  // tiny target policy and the two chunk summaries enqueue.\\\\\\\\n79\\\\\\\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\\\\\\\\n80\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"please inspect the fixture file\\\\\\\\\\\\\\\" } }),\\\\\\\\n81\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\", {\\\\\\\\n82\\\\\\\\t      payload: {\\\\\\\\n83\\\\\\\\t        toolCallId: \\\\\\\\\\\\\\\"call-seam-1\\\\\\\\\\\\\\\",\\\\\\\\n84\\\\\\\\t        toolName: \\\\\\\\\\\\\\\"read_file\\\\\\\\\\\\\\\",\\\\\\\\n85\\\\\\\\t        arguments: { path: \\\\\\\\\\\\\\\"fixture.txt\\\\\\\\\\\\\\\" },\\\\\\\\n86\\\\\\\\t      },\\\\\\\\n87\\\\\\\\t    }),\\\\\\\\n88\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\", {\\\\\\\\n89\\\\\\\\t      payload: { toolCallId: \\\\\\\\\\\\\\\"call-seam-1\\\\\\\\\\\\\\\", content: \\\\\\\\\\\\\\\"contents of fixture.txt\\\\\\\\\\\\\\\", isError: false },\\\\\\\\n90\\\\\\\\t    }),\\\\\\\\n91\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"the fixture file holds fixture text\\\\\\\\\\\\\\\" } }),\\\\\\\\n92\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\"),\\\\\\\\n93\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"thanks, now summarize it\\\\\\\\\\\\\\\" } }),\\\\\\\\n94\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"summarized\\\\\\\\\\\\\\\" } }),\\\\\\\\n95\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\"),\\\\\\\\n96\\\\\\\\t  ]);\\\\\\\\n97\\\\\\\\t  assert.ok(result.ok, \\\\\\\\\\\\\\\"conformance fixture: intake batch failed\\\\\\\\\\\\\\\");\\\\\\\\n98\\\\\\\\t  return filePath;\\\\\\\\n99\\\\\\\\t}\\\\\\\\n100\\\\\\\\t\\\\\\\\n101\\\\\\\\t// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\\\\\\\\n102\\\\\\\\t// real host unchanged: construct an SDK on the inference path, drive all\\\\\\\\n103\\\\\\\\t// seven kinds through a real intake → drain, and assert (1) every kind lands\\\\\\\\n104\\\\\\\\t// ready, (2) every call that crossed the boundary carried exactly one\\\\\\\\n105\\\\\\\\t// kind's assigned provider/model routing keys, (3) each kind's lane was\\\\\\\\n106\\\\\\\\t// exercised, and (4) every messages value is single-turn shape — system and\\\\\\\\n107\\\\\\\\t// user roles only, string content (AC-1.2, AC-1.4).\\\\\\\\n108\\\\\\\\texport async function assertRoutingThroughSdk(\\\\\\\\n109\\\\\\\\t  call: ModelCall,\\\\\\\\n110\\\\\\\\t  assignments: Record<FormKind, ModelAssignment>,\\\\\\\\n111\\\\\\\\t  store: TempStore,\\\\\\\\n112\\\\\\\\t): Promise<RoutingRunResult> {\\\\\\\\n113\\\\\\\\t  const log: ModelCallInput[] = [];\\\\\\\\n114\\\\\\\\t  const logged: ModelCall = (input) => {\\\\\\\\n115\\\\\\\\t    log.push(structuredClone(input));\\\\\\\\n116\\\\\\\\t    return call(input);\\\\\\\\n117\\\\\\\\t  };\\\\\\\\n118\\\\\\\\t  const sdk = createSdk({\\\\\\\\n119\\\\\\\\t    inference: { call: logged, assignments },\\\\\\\\n120\\\\\\\\t    mode: \\\\\\\\\\\\\\\"manual\\\\\\\\\\\\\\\",\\\\\\\\n121\\\\\\\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\\\\\n122\\\\\\\\t    // Tiny target: each placed turn crosses it, so the prior turn's chunk\\\\\\\\n123\\\\\\\\t    // closes during the drain and the chunk-summary kinds run too.\\\\\\\\n124\\\\\\\\t    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\\\\\\\\n125\\\\\\\\t  });\\\\\\\\n126\\\\\\\\t  const filePath = await seedAllSevenKinds(sdk, store);\\\\\\\\n127\\\\\\\\t\\\\\\\\n128\\\\\\\\t  const drained = await sdk.work.drain({ filePath });\\\\\\\\n129\\\\\\\\t  assert.ok(drained.ok, \\\\\\\\\\\\\\\"conformance drain failed\\\\\\\\\\\\\\\");\\\\\\\\n130\\\\\\\\t  assert.equal(drained.value.stoppedBecause, \\\\\\\\\\\\\\\"empty\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"conformance drain left work behind\\\\\\\\\\\\\\\");\\\\\\\\n131\\\\\\\\t  assert.equal(drained.value.remaining, 0, \\\\\\\\\\\\\\\"conformance drain left items remaining\\\\\\\\\\\\\\\");\\\\\\\\n132\\\\\\\\t\\\\\\\\n133\\\\\\\\t  const forms = readDerivedForms(filePath);\\\\\\\\n134\\\\\\\\t  for (const kind of FORM_KINDS) {\\\\\\\\n135\\\\\\\\t    assert.ok(\\\\\\\\n136\\\\\\\\t      forms.some((form) => form.form === kind && form.state === \\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\"),\\\\\\\\n137\\\\\\\\t      `expected at least one ready ${kind} form after the drain`,\\\\\\\\n138\\\\\\\\t    );\\\\\\\\n139\\\\\\\\t  }\\\\\\\\n140\\\\\\\\t\\\\\\\\n141\\\\\\\\t  assert.ok(log.length > 0, \\\\\\\\\\\\\\\"no calls crossed the ModelCall boundary\\\\\\\\\\\\\\\");\\\\\\\\n142\\\\\\\\t  for (const input of log) {\\\\\\\\n143\\\\\\\\t    const matched = FORM_KINDS.filter(\\\\\\\\n144\\\\\\\\t      (kind) =>\\\\\\\\n145\\\\\\\\t        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\\\\\\\\n146\\\\\\\\t    );\\\\\\\\n147\\\\\\\\t    assert.ok(\\\\\\\\n148\\\\\\\\t      matched.length > 0,\\\\\\\\n149\\\\\\\\t      `call carried provider/model \\\\\\\\\\\\\\\"${input.provider}\\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\"${input.model}\\\\\\\\\\\\\\\" matching no kind's assignment`,\\\\\\\\n150\\\\\\\\t    );\\\\\\\\n151\\\\\\\\t    assert.ok(input.messages.length > 0, \\\\\\\\\\\\\\\"a call crossed the boundary with no messages\\\\\\\\\\\\\\\");\\\\\\\\n152\\\\\\\\t    assert.ok(\\\\\\\\n153\\\\\\\\t      input.messages.some((message) => message.role === \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\"),\\\\\\\\n154\\\\\\\\t      \\\\\\\\\\\\\\\"single-turn shape requires a user message\\\\\\\\\\\\\\\",\\\\\\\\n155\\\\\\\\t    );\\\\\\\\n156\\\\\\\\t    for (const message of input.messages) {\\\\\\\\n157\\\\\\\\t      assert.ok(\\\\\\\\n158\\\\\\\\t        message.role === \\\\\\\\\\\\\\\"system\\\\\\\\\\\\\\\" || message.role === \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\",\\\\\\\\n159\\\\\\\\t        `message role \\\\\\\\\\\\\\\"${String(message.role)}\\\\\\\\\\\\\\\" is outside the single-turn vocabulary`,\\\\\\\\n160\\\\\\\\t      );\\\\\\\\n161\\\\\\\\t      assert.equal(typeof message.content, \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"message content must be a string\\\\\\\\\\\\\\\");\\\\\\\\n162\\\\\\\\t    }\\\\\\\\n163\\\\\\\\t  }\\\\\\\\n164\\\\\\\\t  for (const kind of FORM_KINDS) {\\\\\\\\n165\\\\\\\\t    assert.ok(\\\\\\\\n166\\\\\\\\t      log.some(\\\\\\\\n167\\\\\\\\t        (input) =>\\\\\\\\n168\\\\\\\\t          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\\\\\\\\n169\\\\\\\\t      ),\\\\\\\\n170\\\\\\\\t      `no boundary call carried ${kind}'s assigned provider/model lane`,\\\\\\\\n171\\\\\\\\t    );\\\\\\\\n172\\\\\\\\t  }\\\\\\\\n173\\\\\\\\t  return { sdk, filePath, forms, log };\\\\\\\\n174\\\\\\\\t}\\\\\\\\n175\\\\\\\\t\\\\\\\"}]},\\\\\\\"parent_tool_use_id\\\\\\\":null,\\\\\\\"session_id\\\\\\\":\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\",\\\\\\\"uuid\\\\\\\":\\\\\\\"6edb0c40-880a-479b-89bf-c49b4ad66e88\\\\\\\",\\\\\\\"timestamp\\\\\\\":\\\\\\\"2026-06-12T23:21:14.393Z\\\\\\\",\\\\\\\"tool_use_result\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"text\\\\\\\",\\\\\\\"file\\\\\\\":{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/seam-conformance.ts\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\\\\\\\\n// run against the scripted fakes (TC-1.2) and, unchanged, against the real\\\\\\\\n// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\\\\\\\\n// Framework-agnostic on purpose: plain node:assert throws surface in vitest\\\\\\\\n// and in any future runner identically.\\\\\\\\nimport assert from \\\\\\\\\\\\\\\"node:assert/strict\\\\\\\\\\\\\\\";\\\\\\\\nimport { createSdk, type DerivedForm, type Lhc } from \\\\\\\\\\\\\\\"../../src/index.js\\\\\\\\\\\\\\\";\\\\\\\\nimport { FORM_KINDS, type FormKind } from \\\\\\\\\\\\\\\"../../src/shared/derivation.js\\\\\\\\\\\\\\\";\\\\\\\\nimport type {\\\\\\\\n  ModelAssignment,\\\\\\\\n  ModelCall,\\\\\\\\n  ModelCallInput,\\\\\\\\n} from \\\\\\\\\\\\\\\"../../src/inference/types.js\\\\\\\\\\\\\\\";\\\\\\\\nimport { readDerivedForms } from \\\\\\\\\\\\\\\"./threads.js\\\\\\\\\\\\\\\";\\\\\\\\nimport { validEvent, type TempStore } from \\\\\\\\\\\\\\\"./index.js\\\\\\\\\\\\\\\";\\\\\\\\n\\\\\\\\nconst FAILURE_KINDS = new Set([\\\\\\\\n  \\\\\\\\\\\\\\\"rate_limit\\\\\\\\\\\\\\\",\\\\\\\\n  \\\\\\\\\\\\\\\"timeout\\\\\\\\\\\\\\\",\\\\\\\\n  \\\\\\\\\\\\\\\"network\\\\\\\\\\\\\\\",\\\\\\\\n  \\\\\\\\\\\\\\\"empty_output\\\\\\\\\\\\\\\",\\\\\\\\n  \\\\\\\\\\\\\\\"other\\\\\\\\\\\\\\\",\\\\\\\\n  \\\\\\\\\\\\\\\"auth\\\\\\\\\\\\\\\",\\\\\\\\n  \\\\\\\\\\\\\\\"invalid_request\\\\\\\\\\\\\\\",\\\\\\\\n]);\\\\\\\\n\\\\\\\\nexport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\\\\\\\\n  return {\\\\\\\\n    provider: \\\\\\\\\\\\\\\"probe-provider\\\\\\\\\\\\\\\",\\\\\\\\n    model: \\\\\\\\\\\\\\\"probe-model\\\\\\\\\\\\\\\",\\\\\\\\n    messages: [\\\\\\\\n      { role: \\\\\\\\\\\\\\\"system\\\\\\\\\\\\\\\", content: \\\\\\\\\\\\\\\"You answer with one word.\\\\\\\\\\\\\\\" },\\\\\\\\n      { role: \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\", content: \\\\\\\\\\\\\\\"Say ok.\\\\\\\\\\\\\\\" },\\\\\\\\n    ],\\\\\\\\n    ...overrides,\\\\\\\\n  };\\\\\\\\n}\\\\\\\\n\\\\\\\\n// AC-1.2's result contract on one probe call: a ModelCall resolves to either\\\\\\\\n// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\\\\\\\\n// failure vocabulary. Catches fixture (and real-host) drift from the\\\\\\\\n// boundary contract.\\\\\\\\nexport async function assertModelCallContract(\\\\\\\\n  call: ModelCall,\\\\\\\\n  probe: ModelCallInput = probeInput(),\\\\\\\\n): Promise<void> {\\\\\\\\n  const result = await call(probe);\\\\\\\\n  assert.ok(\\\\\\\\n    typeof result === \\\\\\\\\\\\\\\"object\\\\\\\\\\\\\\\" && result !== null,\\\\\\\\n    \\\\\\\\\\\\\\\"ModelCall must resolve to a result object\\\\\\\\\\\\\\\",\\\\\\\\n  );\\\\\\\\n  if (result.ok === true) {\\\\\\\\n    assert.equal(typeof result.text, \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"success result must carry string text\\\\\\\\\\\\\\\");\\\\\\\\n  } else if (result.ok === false) {\\\\\\\\n    assert.ok(\\\\\\\\n      FAILURE_KINDS.has(result.kind),\\\\\\\\n      `failure kind \\\\\\\\\\\\\\\"${String(result.kind)}\\\\\\\\\\\\\\\" is not in the failure vocabulary`,\\\\\\\\n    );\\\\\\\\n    assert.equal(typeof result.message, \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"failure result must carry a string message\\\\\\\\\\\\\\\");\\\\\\\\n  } else {\\\\\\\\n    assert.fail(\\\\\\\\\\\\\\\"ModelCall result must discriminate on a boolean ok\\\\\\\\\\\\\\\");\\\\\\\\n  }\\\\\\\\n}\\\\\\\\n\\\\\\\\nexport interface RoutingRunResult {\\\\\\\\n  sdk: Lhc;\\\\\\\\n  filePath: string;\\\\\\\\n  forms: DerivedForm[];\\\\\\\\n  log: ModelCallInput[];\\\\\\\\n}\\\\\\\\n\\\\\\\\nasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\\\\\\\\n  const filePath = store.threadPath();\\\\\\\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\\\\\\\n  assert.ok(created.ok, \\\\\\\\\\\\\\\"conformance fixture: thread creation failed\\\\\\\\\\\\\\\");\\\\\\\\n  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\\\\\\\\n  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\\\\\\\\n  // tiny target policy and the two chunk summaries enqueue.\\\\\\\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, [\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"please inspect the fixture file\\\\\\\\\\\\\\\" } }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\", {\\\\\\\\n      payload: {\\\\\\\\n        toolCallId: \\\\\\\\\\\\\\\"call-seam-1\\\\\\\\\\\\\\\",\\\\\\\\n        toolName: \\\\\\\\\\\\\\\"read_file\\\\\\\\\\\\\\\",\\\\\\\\n        arguments: { path: \\\\\\\\\\\\\\\"fixture.txt\\\\\\\\\\\\\\\" },\\\\\\\\n      },\\\\\\\\n    }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\", {\\\\\\\\n      payload: { toolCallId: \\\\\\\\\\\\\\\"call-seam-1\\\\\\\\\\\\\\\", content: \\\\\\\\\\\\\\\"contents of fixture.txt\\\\\\\\\\\\\\\", isError: false },\\\\\\\\n    }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"the fixture file holds fixture text\\\\\\\\\\\\\\\" } }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\"),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"thanks, now summarize it\\\\\\\\\\\\\\\" } }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\", { payload: { text: \\\\\\\\\\\\\\\"summarized\\\\\\\\\\\\\\\" } }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\"),\\\\\\\\n  ]);\\\\\\\\n  assert.ok(result.ok, \\\\\\\\\\\\\\\"conformance fixture: intake batch failed\\\\\\\\\\\\\\\");\\\\\\\\n  return filePath;\\\\\\\\n}\\\\\\\\n\\\\\\\\n// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\\\\\\\\n// real host unchanged: construct an SDK on the inference path, drive all\\\\\\\\n// seven kinds through a real intake → drain, and assert (1) every kind lands\\\\\\\\n// ready, (2) every call that crossed the boundary carried exactly one\\\\\\\\n// kind's assigned provider/model routing keys, (3) each kind's lane was\\\\\\\\n// exercised, and (4) every messages value is single-turn shape — system and\\\\\\\\n// user roles only, string content (AC-1.2, AC-1.4).\\\\\\\\nexport async function assertRoutingThroughSdk(\\\\\\\\n  call: ModelCall,\\\\\\\\n  assignments: Record<FormKind, ModelAssignment>,\\\\\\\\n  store: TempStore,\\\\\\\\n): Promise<RoutingRunResult> {\\\\\\\\n  const log: ModelCallInput[] = [];\\\\\\\\n  const logged: ModelCall = (input) => {\\\\\\\\n    log.push(structuredClone(input));\\\\\\\\n    return call(input);\\\\\\\\n  };\\\\\\\\n  const sdk = createSdk({\\\\\\\\n    inference: { call: logged, assignments },\\\\\\\\n    mode: \\\\\\\\\\\\\\\"manual\\\\\\\\\\\\\\\",\\\\\\\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\\\\\n    // Tiny target: each placed turn crosses it, so the prior turn's chunk\\\\\\\\n    // closes during the drain and the chunk-summary kinds run too.\\\\\\\\n    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\\\\\\\\n  });\\\\\\\\n  const filePath = await seedAllSevenKinds(sdk, store);\\\\\\\\n\\\\\\\\n  const drained = await sdk.work.drain({ filePath });\\\\\\\\n  assert.ok(drained.ok, \\\\\\\\\\\\\\\"conformance drain failed\\\\\\\\\\\\\\\");\\\\\\\\n  assert.equal(drained.value.stoppedBecause, \\\\\\\\\\\\\\\"empty\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"conformance drain left work behind\\\\\\\\\\\\\\\");\\\\\\\\n  assert.equal(drained.value.remaining, 0, \\\\\\\\\\\\\\\"conformance drain left items remaining\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\\n  const forms = readDerivedForms(filePath);\\\\\\\\n  for (const kind of FORM_KINDS) {\\\\\\\\n    assert.ok(\\\\\\\\n      forms.some((form) => form.form === kind && form.state === \\\\\\\\\\\\\\\"ready\\\\\\\\\\\\\\\"),\\\\\\\\n      `expected at least one ready ${kind} form after the drain`,\\\\\\\\n    );\\\\\\\\n  }\\\\\\\\n\\\\\\\\n  assert.ok(log.length > 0, \\\\\\\\\\\\\\\"no calls crossed the ModelCall boundary\\\\\\\\\\\\\\\");\\\\\\\\n  for (const input of log) {\\\\\\\\n    const matched = FORM_KINDS.filter(\\\\\\\\n      (kind) =>\\\\\\\\n        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\\\\\\\\n    );\\\\\\\\n    assert.ok(\\\\\\\\n      matched.length > 0,\\\\\\\\n      `call carried provider/model \\\\\\\\\\\\\\\"${input.provider}\\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\"${input.model}\\\\\\\\\\\\\\\" matching no kind's assignment`,\\\\\\\\n    );\\\\\\\\n    assert.ok(input.messages.length > 0, \\\\\\\\\\\\\\\"a call crossed the boundary with no messages\\\\\\\\\\\\\\\");\\\\\\\\n    assert.ok(\\\\\\\\n      input.messages.some((message) => message.role === \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\"),\\\\\\\\n      \\\\\\\\\\\\\\\"single-turn shape requires a user message\\\\\\\\\\\\\\\",\\\\\\\\n    );\\\\\\\\n    for (const message of input.messages) {\\\\\\\\n      assert.ok(\\\\\\\\n        message.role === \\\\\\\\\\\\\\\"system\\\\\\\\\\\\\\\" || message.role === \\\\\\\\\\\\\\\"user\\\\\\\\\\\\\\\",\\\\\\\\n        `message role \\\\\\\\\\\\\\\"${String(message.role)}\\\\\\\\\\\\\\\" is outside the single-turn vocabulary`,\\\\\\\\n      );\\\\\\\\n      assert.equal(typeof message.content, \\\\\\\\\\\\\\\"string\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"message content must be a string\\\\\\\\\\\\\\\");\\\\\\\\n    }\\\\\\\\n  }\\\\\\\\n  for (const kind of FORM_KINDS) {\\\\\\\\n    assert.ok(\\\\\\\\n      log.some(\\\\\\\\n        (input) =>\\\\\\\\n          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\\\\\\\\n      ),\\\\\\\\n      `no boundary call carried ${kind}'s assigned provider/model lane`,\\\\\\\\n    );\\\\\\\\n  }\\\\\\\\n  return { sdk, filePath, forms, log };\\\\\\\\n}\\\\\\\\n\\\\\\\",\\\\\\\"numLines\\\\\\\":175,\\\\\\\"startLine\\\\\\\":1,\\\\\\\"totalLines\\\\\\\":175}}}\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:131:{\\\\\\\"type\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"message\\\\\\\":{\\\\\\\"role\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"tool_use_id\\\\\\\":\\\\\\\"toolu_01UemtKZB62B1j5jov2kTUJA\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"tool_result\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"1\\\\\\\\t// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\\\\\\\\n2\\\\\\\\t// ModelCall implementations every Flow 1–3 test uses. These are boundary\\\\\\\\n3\\\\\\\\t// doubles, not internal mocks — the ModelCall function is where LHC's code\\\\\\\\n4\\\\\\\\t// ends (tech design §Testing Strategy). All builders return\\\\\\\\n5\\\\\\\\t// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\\\\\\\\n6\\\\\\\\t// recordingCall in its own test so fixture drift is caught by the suite.\\\\\\\\n7\\\\\\\\timport { FORM_KINDS, type FormKind } from \\\\\\\\\\\\\\\"../../src/shared/derivation.js\\\\\\\\\\\\\\\";\\\\\\\\n8\\\\\\\\timport { DEFAULT_PROMPT_NAMES } from \\\\\\\\\\\\\\\"../../src/inference/prompts/index.js\\\\\\\\\\\\\\\";\\\\\\\\n9\\\\\\\\timport type {\\\\\\\\n10\\\\\\\\t  ModelAssignment,\\\\\\\\n11\\\\\\\\t  ModelCall,\\\\\\\\n12\\\\\\\\t  ModelCallInput,\\\\\\\\n13\\\\\\\\t  ModelCallResult,\\\\\\\\n14\\\\\\\\t} from \\\\\\\\\\\\\\\"../../src/inference/types.js\\\\\\\\\\\\\\\";\\\\\\\\n15\\\\\\\\t\\\\\\\\n16\\\\\\\\texport { FORM_KINDS, type FormKind };\\\\\\\\n17\\\\\\\\t\\\\\\\\n18\\\\\\\\t// validAssignments gives every kind a distinct fake provider/model lane;\\\\\\\\n19\\\\\\\\t// recordingCall infers the kind back from the model string, so per-kind\\\\\\\\n20\\\\\\\\t// routing is observable from the log alone (TC-1.2).\\\\\\\\n21\\\\\\\\texport const FAKE_PROVIDER_PREFIX = \\\\\\\\\\\\\\\"prov-\\\\\\\\\\\\\\\";\\\\\\\\n22\\\\\\\\texport const FAKE_MODEL_PREFIX = \\\\\\\\\\\\\\\"model-\\\\\\\\\\\\\\\";\\\\\\\\n23\\\\\\\\t\\\\\\\\n24\\\\\\\\texport function validAssignments(\\\\\\\\n25\\\\\\\\t  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\\\\\\\\n26\\\\\\\\t): Record<FormKind, ModelAssignment> {\\\\\\\\n27\\\\\\\\t  const map = {} as Record<FormKind, ModelAssignment>;\\\\\\\\n28\\\\\\\\t  for (const kind of FORM_KINDS) {\\\\\\\\n29\\\\\\\\t    map[kind] = {\\\\\\\\n30\\\\\\\\t      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\\\\\\\\n31\\\\\\\\t      model: `${FAKE_MODEL_PREFIX}${kind}`,\\\\\\\\n32\\\\\\\\t      prompt: DEFAULT_PROMPT_NAMES[kind],\\\\\\\\n33\\\\\\\\t      ...(overrides[kind] ?? {}),\\\\\\\\n34\\\\\\\\t    };\\\\\\\\n35\\\\\\\\t  }\\\\\\\\n36\\\\\\\\t  return map;\\\\\\\\n37\\\\\\\\t}\\\\\\\\n38\\\\\\\\t\\\\\\\\n39\\\\\\\\t// One distinct canned sentence per kind, so cross-kind bleed is visible in\\\\\\\\n40\\\\\\\\t// landed form content, never just in call counts.\\\\\\\\n41\\\\\\\\texport function cannedResponses(): Record<FormKind, string> {\\\\\\\\n42\\\\\\\\t  const map = {} as Record<FormKind, string>;\\\\\\\\n43\\\\\\\\t  for (const kind of FORM_KINDS) {\\\\\\\\n44\\\\\\\\t    map[kind] = `canned ${kind} text from the fake host`;\\\\\\\\n45\\\\\\\\t  }\\\\\\\\n46\\\\\\\\t  return map;\\\\\\\\n47\\\\\\\\t}\\\\\\\\n48\\\\\\\\t\\\\\\\\n49\\\\\\\\t// Resolves each call with its kind's canned text — the kind inferred from\\\\\\\\n50\\\\\\\\t// the model routing key validAssignments made unique per kind. Every input\\\\\\\\n51\\\\\\\\t// is cloned into `log` in call order. An unknown model is a test bug and\\\\\\\\n52\\\\\\\\t// throws loudly.\\\\\\\\n53\\\\\\\\texport function recordingCall(responses: Record<FormKind, string>): {\\\\\\\\n54\\\\\\\\t  call: ModelCall;\\\\\\\\n55\\\\\\\\t  log: ModelCallInput[];\\\\\\\\n56\\\\\\\\t} {\\\\\\\\n57\\\\\\\\t  const log: ModelCallInput[] = [];\\\\\\\\n58\\\\\\\\t  const known = new Set<string>(FORM_KINDS);\\\\\\\\n59\\\\\\\\t  const call: ModelCall = (input) => {\\\\\\\\n60\\\\\\\\t    log.push(structuredClone(input));\\\\\\\\n61\\\\\\\\t    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\\\\\\\\n62\\\\\\\\t      ? input.model.slice(FAKE_MODEL_PREFIX.length)\\\\\\\\n63\\\\\\\\t      : input.model;\\\\\\\\n64\\\\\\\\t    if (!known.has(kind)) {\\\\\\\\n65\\\\\\\\t      throw new Error(`recordingCall: no canned response for model \\\\\\\\\\\\\\\"${input.model}\\\\\\\\\\\\\\\"`);\\\\\\\\n66\\\\\\\\t    }\\\\\\\\n67\\\\\\\\t    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\\\\\\\\n68\\\\\\\\t  };\\\\\\\\n69\\\\\\\\t  return { call, log };\\\\\\\\n70\\\\\\\\t}\\\\\\\\n71\\\\\\\\t\\\\\\\\n72\\\\\\\\t// Returns script entries in order; a call past the end of the script is a\\\\\\\\n73\\\\\\\\t// test bug and throws loudly.\\\\\\\\n74\\\\\\\\texport function scriptedCall(script: ModelCallResult[]): ModelCall {\\\\\\\\n75\\\\\\\\t  let next = 0;\\\\\\\\n76\\\\\\\\t  return (input) => {\\\\\\\\n77\\\\\\\\t    const entry = script[next];\\\\\\\\n78\\\\\\\\t    next += 1;\\\\\\\\n79\\\\\\\\t    if (entry === undefined) {\\\\\\\\n80\\\\\\\\t      throw new Error(\\\\\\\\n81\\\\\\\\t        `scriptedCall: script exhausted after ${String(script.length)} calls (model \\\\\\\\\\\\\\\"${input.model}\\\\\\\\\\\\\\\")`,\\\\\\\\n82\\\\\\\\t      );\\\\\\\\n83\\\\\\\\t    }\\\\\\\\n84\\\\\\\\t    return Promise.resolve(entry);\\\\\\\\n85\\\\\\\\t  };\\\\\\\\n86\\\\\\\\t}\\\\\\\\n87\\\\\\\\t\\\\\\\\n88\\\\\\\\t// A host whose function throws — the AC-3.3 containment leg.\\\\\\\\n89\\\\\\\\texport function throwingCall(error: Error): ModelCall {\\\\\\\\n90\\\\\\\\t  return () => Promise.reject(error);\\\\\\\\n91\\\\\\\\t}\\\\\\\\n92\\\\\\\\t\\\\\\\\n93\\\\\\\\t// A host that never settles — the DD-6 timeout leg (tests pass a small\\\\\\\\n94\\\\\\\\t// timeoutMs).\\\\\\\\n95\\\\\\\\texport function hangingCall(): ModelCall {\\\\\\\\n96\\\\\\\\t  return () => new Promise<ModelCallResult>(() => {});\\\\\\\\n97\\\\\\\\t}\\\\\\\\n98\\\\\\\\t\\\\\\\"}]},\\\\\\\"parent_tool_use_id\\\\\\\":null,\\\\\\\"session_id\\\\\\\":\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\",\\\\\\\"uuid\\\\\\\":\\\\\\\"a20442e6-c3cd-404f-b566-d8cac661c7bd\\\\\\\",\\\\\\\"timestamp\\\\\\\":\\\\\\\"2026-06-12T23:21:14.747Z\\\\\\\",\\\\\\\"tool_use_result\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"text\\\\\\\",\\\\\\\"file\\\\\\\":{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/model-call.ts\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\\\\\\\\n// ModelCall implementations every Flow 1–3 test uses. These are boundary\\\\\\\\n// doubles, not internal mocks — the ModelCall function is where LHC's code\\\\\\\\n// ends (tech design §Testing Strategy). All builders return\\\\\\\\n// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\\\\\\\\n// recordingCall in its own test so fixture drift is caught by the suite.\\\\\\\\nimport { FORM_KINDS, type FormKind } from \\\\\\\\\\\\\\\"../../src/shared/derivation.js\\\\\\\\\\\\\\\";\\\\\\\\nimport { DEFAULT_PROMPT_NAMES } from \\\\\\\\\\\\\\\"../../src/inference/prompts/index.js\\\\\\\\\\\\\\\";\\\\\\\\nimport type {\\\\\\\\n  ModelAssignment,\\\\\\\\n  ModelCall,\\\\\\\\n  ModelCallInput,\\\\\\\\n  ModelCallResult,\\\\\\\\n} from \\\\\\\\\\\\\\\"../../src/inference/types.js\\\\\\\\\\\\\\\";\\\\\\\\n\\\\\\\\nexport { FORM_KINDS, type FormKind };\\\\\\\\n\\\\\\\\n// validAssignments gives every kind a distinct fake provider/model lane;\\\\\\\\n// recordingCall infers the kind back from the model string, so per-kind\\\\\\\\n// routing is observable from the log alone (TC-1.2).\\\\\\\\nexport const FAKE_PROVIDER_PREFIX = \\\\\\\\\\\\\\\"prov-\\\\\\\\\\\\\\\";\\\\\\\\nexport const FAKE_MODEL_PREFIX = \\\\\\\\\\\\\\\"model-\\\\\\\\\\\\\\\";\\\\\\\\n\\\\\\\\nexport function validAssignments(\\\\\\\\n  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\\\\\\\\n): Record<FormKind, ModelAssignment> {\\\\\\\\n  const map = {} as Record<FormKind, ModelAssignment>;\\\\\\\\n  for (const kind of FORM_KINDS) {\\\\\\\\n    map[kind] = {\\\\\\\\n      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\\\\\\\\n      model: `${FAKE_MODEL_PREFIX}${kind}`,\\\\\\\\n      prompt: DEFAULT_PROMPT_NAMES[kind],\\\\\\\\n      ...(overrides[kind] ?? {}),\\\\\\\\n    };\\\\\\\\n  }\\\\\\\\n  return map;\\\\\\\\n}\\\\\\\\n\\\\\\\\n// One distinct canned sentence per kind, so cross-kind bleed is visible in\\\\\\\\n// landed form content, never just in call counts.\\\\\\\\nexport function cannedResponses(): Record<FormKind, string> {\\\\\\\\n  const map = {} as Record<FormKind, string>;\\\\\\\\n  for (const kind of FORM_KINDS) {\\\\\\\\n    map[kind] = `canned ${kind} text from the fake host`;\\\\\\\\n  }\\\\\\\\n  return map;\\\\\\\\n}\\\\\\\\n\\\\\\\\n// Resolves each call with its kind's canned text — the kind inferred from\\\\\\\\n// the model routing key validAssignments made unique per kind. Every input\\\\\\\\n// is cloned into `log` in call order. An unknown model is a test bug and\\\\\\\\n// throws loudly.\\\\\\\\nexport function recordingCall(responses: Record<FormKind, string>): {\\\\\\\\n  call: ModelCall;\\\\\\\\n  log: ModelCallInput[];\\\\\\\\n} {\\\\\\\\n  const log: ModelCallInput[] = [];\\\\\\\\n  const known = new Set<string>(FORM_KINDS);\\\\\\\\n  const call: ModelCall = (input) => {\\\\\\\\n    log.push(structuredClone(input));\\\\\\\\n    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\\\\\\\\n      ? input.model.slice(FAKE_MODEL_PREFIX.length)\\\\\\\\n      : input.model;\\\\\\\\n    if (!known.has(kind)) {\\\\\\\\n      throw new Error(`recordingCall: no canned response for model \\\\\\\\\\\\\\\"${input.model}\\\\\\\\\\\\\\\"`);\\\\\\\\n    }\\\\\\\\n    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\\\\\\\\n  };\\\\\\\\n  return { call, log };\\\\\\\\n}\\\\\\\\n\\\\\\\\n// Returns script entries in order; a call past the end of the script is a\\\\\\\\n// test bug and throws loudly.\\\\\\\\nexport function scriptedCall(script: ModelCallResult[]): ModelCall {\\\\\\\\n  let next = 0;\\\\\\\\n  return (input) => {\\\\\\\\n    const entry = script[next];\\\\\\\\n    next += 1;\\\\\\\\n    if (entry === undefined) {\\\\\\\\n      throw new Error(\\\\\\\\n        `scriptedCall: script exhausted after ${String(script.length)} calls (model \\\\\\\\\\\\\\\"${input.model}\\\\\\\\\\\\\\\")`,\\\\\\\\n      );\\\\\\\\n    }\\\\\\\\n    return Promise.resolve(entry);\\\\\\\\n  };\\\\\\\\n}\\\\\\\\n\\\\\\\\n// A host whose function throws — the AC-3.3 containment leg.\\\\\\\\nexport function throwingCall(error: Error): ModelCall {\\\\\\\\n  return () => Promise.reject(error);\\\\\\\\n}\\\\\\\\n\\\\\\\\n// A host that never settles — the DD-6 timeout leg (tests pass a small\\\\\\\\n// timeoutMs).\\\\\\\\nexport function hangingCall(): ModelCall {\\\\\\\\n  return () => new Promise<ModelCallResult>(() => {});\\\\\\\\n}\\\\\\\\n\\\\\\\",\\\\\\\"numLines\\\\\\\":98,\\\\\\\"startLine\\\\\\\":1,\\\\\\\"totalLines\\\\\\\":98}}}\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:144:{\\\\\\\"type\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"message\\\\\\\":{\\\\\\\"role\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"tool_use_id\\\\\\\":\\\\\\\"toolu_01WCNKXxjusCqhbhSCnv3ikX\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"tool_result\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"1\\\\\\\\t// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\\\\\\\n2\\\\\\\\t// driven once, in PI-extension call order, against one real SDK\\\\\\\\n3\\\\\\\\t// configuration with the deterministic provider — zero network, zero real\\\\\\\\n4\\\\\\\\t// provider, no mocks anywhere. The script owns the sequence and the phase\\\\\\\\n5\\\\\\\\t// names (tech design Flow 5); assertions live in the driving tests, so the\\\\\\\\n6\\\\\\\\t// replay, teardown, and process legs all run THIS sequence rather than a\\\\\\\\n7\\\\\\\\t// re-described one (DD-8).\\\\\\\\n8\\\\\\\\t//\\\\\\\\n9\\\\\\\\t// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\\\\\\\n10\\\\\\\\t// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\\\\\\\n11\\\\\\\\t//\\\\\\\\n12\\\\\\\\t// Mode is background — the production posture the PI extension will run —\\\\\\\\n13\\\\\\\\t// and the drain/rebuild phases settle through `drainSettled`, the real\\\\\\\\n14\\\\\\\\t// background awaitable. The post-mutation health snapshot (AC-5.2's\\\\\\\\n15\\\\\\\\t// \\\\\\\\\\\\\\\"cleared set pending\\\\\\\\\\\\\\\") is deterministic because every SDK operation here\\\\\\\\n16\\\\\\\\t// is synchronous SQLite chained through microtasks, while a background\\\\\\\\n17\\\\\\\\t// drain pass always starts on a macrotask (scheduler runLoop defers through\\\\\\\\n18\\\\\\\\t// setImmediate): the edit → delete → health reads inside the mutate phase\\\\\\\\n19\\\\\\\\t// run as one unbroken microtask cascade and complete before the poked drain\\\\\\\\n20\\\\\\\\t// can claim its first item. The rebuild phase then yields via drainSettled\\\\\\\\n21\\\\\\\\t// and the drain runs to empty.\\\\\\\\n22\\\\\\\\timport { join } from \\\\\\\\\\\\\\\"node:path\\\\\\\\\\\\\\\";\\\\\\\\n23\\\\\\\\timport {\\\\\\\\n24\\\\\\\\t  createDeterministicProvider,\\\\\\\\n25\\\\\\\\t  createSdk,\\\\\\\\n26\\\\\\\\t  type BatchResult,\\\\\\\\n27\\\\\\\\t  type CompactReceipt,\\\\\\\\n28\\\\\\\\t  type FormReportEntry,\\\\\\\\n29\\\\\\\\t  type HealthReport,\\\\\\\\n30\\\\\\\\t  type InspectOverview,\\\\\\\\n31\\\\\\\\t  type Lhc,\\\\\\\\n32\\\\\\\\t  type MessageEventInput,\\\\\\\\n33\\\\\\\\t  type MutationResult,\\\\\\\\n34\\\\\\\\t  type OpResult,\\\\\\\\n35\\\\\\\\t  type PullResult,\\\\\\\\n36\\\\\\\\t  type ViewContentsReport,\\\\\\\\n37\\\\\\\\t  type ViewStatus,\\\\\\\\n38\\\\\\\\t} from \\\\\\\\\\\\\\\"../../src/index.js\\\\\\\\\\\\\\\";\\\\\\\\n39\\\\\\\\timport { validEvent, type TempStore } from \\\\\\\\\\\\\\\"./index.js\\\\\\\\\\\\\\\";\\\\\\\\n40\\\\\\\\t\\\\\\\\n41\\\\\\\\t// ── the one SDK configuration (AC-5.1) ────────────────────────────\\\\\\\\n42\\\\\\\\t//\\\\\\\\n43\\\\\\\\t// Deterministic provider injected at construction (the only provider-arrival\\\\\\\\n44\\\\\\\\t// path since the CLI retired), background mode, zero-backoff retry so a\\\\\\\\n45\\\\\\\\t// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\\\\\\\n46\\\\\\\\t// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\\\\\\\n47\\\\\\\\t// a named \\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\" profile so compact runs profile-addressed (story\\\\\\\\n48\\\\\\\\t// scope: \\\\\\\\\\\\\\\"compact (profile)\\\\\\\\\\\\\\\") with all three lower bands non-empty on this\\\\\\\\n49\\\\\\\\t// thread (Epic 03 Story 2's reference gradient).\\\\\\\\n50\\\\\\\\texport const LIFECYCLE_PROFILE = {\\\\\\\\n51\\\\\\\\t  name: \\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\",\\\\\\\\n52\\\\\\\\t  lowerBound: 400,\\\\\\\\n53\\\\\\\\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\\\\\\\n54\\\\\\\\t} as const;\\\\\\\\n55\\\\\\\\t\\\\\\\\n56\\\\\\\\texport function createLifecycleSdk(): Lhc {\\\\\\\\n57\\\\\\\\t  return createSdk({\\\\\\\\n58\\\\\\\\t    provider: createDeterministicProvider(),\\\\\\\\n59\\\\\\\\t    mode: \\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\",\\\\\\\\n60\\\\\\\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\\\\\n61\\\\\\\\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\\\\\\\n62\\\\\\\\t    view: {\\\\\\\\n63\\\\\\\\t      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\\\\\\\n64\\\\\\\\t      // Low threshold so the status checkpoint genuinely recommends the\\\\\\\\n65\\\\\\\\t      // compact the sequence performs next.\\\\\\\\n66\\\\\\\\t      compactThreshold: 300,\\\\\\\\n67\\\\\\\\t    },\\\\\\\\n68\\\\\\\\t  });\\\\\\\\n69\\\\\\\\t}\\\\\\\\n70\\\\\\\\t\\\\\\\\n71\\\\\\\\t// ── the recorded conversation ─────────────────────────────────────\\\\\\\\n72\\\\\\\\t//\\\\\\\\n73\\\\\\\\t// Same shape and text profile as the Epic 03 derived-thread fixture (12\\\\\\\\n74\\\\\\\\t// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\\\\\\\n75\\\\\\\\t// policy cuts the same 4-chunk shape — but with explicit per-run\\\\\\\\n76\\\\\\\\t// idempotency keys so a replay on a fresh thread records byte-identical\\\\\\\\n77\\\\\\\\t// event payloads regardless of any process-global fixture counters.\\\\\\\\n78\\\\\\\\tconst TURN_COUNT = 12;\\\\\\\\n79\\\\\\\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\\\\\\\n80\\\\\\\\tconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\\\\\\\n81\\\\\\\\t\\\\\\\\n82\\\\\\\\t// Mutation targets: both in the post-compact tail (compact point at t9's\\\\\\\\n83\\\\\\\\t// start under the lifecycle profile), so the second compact's pull shows the\\\\\\\\n84\\\\\\\\t// edit verbatim and the deletion's absence — the tail is full fidelity.\\\\\\\\n85\\\\\\\\texport const EDIT_TARGET = { turnId: \\\\\\\\\\\\\\\"t12\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\" } as const;\\\\\\\\n86\\\\\\\\texport const EDITED_MESSAGE_TEXT =\\\\\\\\n87\\\\\\\\t  \\\\\\\\\\\\\\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\\\\\\\\\\\\\";\\\\\\\\n88\\\\\\\\texport const DELETE_TARGET = { turnId: \\\\\\\\\\\\\\\"t10\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\" } as const;\\\\\\\\n89\\\\\\\\texport const DELETED_MESSAGE_TEXT = \\\\\\\\\\\\\\\"findings for area 10\\\\\\\\\\\\\\\";\\\\\\\\n90\\\\\\\\t\\\\\\\\n91\\\\\\\\tfunction turnEvents(turn: number): MessageEventInput[] {\\\\\\\\n92\\\\\\\\t  let seq = 0;\\\\\\\\n93\\\\\\\\t  const key = (): string => {\\\\\\\\n94\\\\\\\\t    seq += 1;\\\\\\\\n95\\\\\\\\t    return `lc-t${turn}-e${seq}`;\\\\\\\\n96\\\\\\\\t  };\\\\\\\\n97\\\\\\\\t  const events: MessageEventInput[] = [\\\\\\\\n98\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\", {\\\\\\\\n99\\\\\\\\t      idempotencyKey: key(),\\\\\\\\n100\\\\\\\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\\\\\\\n101\\\\\\\\t    }),\\\\\\\\n102\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"assistant_thinking\\\\\\\\\\\\\\\", {\\\\\\\\n103\\\\\\\\t      idempotencyKey: key(),\\\\\\\\n104\\\\\\\\t      payload: { text: `considering what area ${turn} contains` },\\\\\\\\n105\\\\\\\\t    }),\\\\\\\\n106\\\\\\\\t  ];\\\\\\\\n107\\\\\\\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\\\\\\\n108\\\\\\\\t    for (const run of [1, 2]) {\\\\\\\\n109\\\\\\\\t      const toolCallId = `call-lc-${turn}-${run}`;\\\\\\\\n110\\\\\\\\t      events.push(\\\\\\\\n111\\\\\\\\t        validEvent(\\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\", {\\\\\\\\n112\\\\\\\\t          idempotencyKey: key(),\\\\\\\\n113\\\\\\\\t          payload: {\\\\\\\\n114\\\\\\\\t            toolCallId,\\\\\\\\n115\\\\\\\\t            toolName: \\\\\\\\\\\\\\\"read_file\\\\\\\\\\\\\\\",\\\\\\\\n116\\\\\\\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\\\\\\\n117\\\\\\\\t          },\\\\\\\\n118\\\\\\\\t        }),\\\\\\\\n119\\\\\\\\t        validEvent(\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\", {\\\\\\\\n120\\\\\\\\t          idempotencyKey: key(),\\\\\\\\n121\\\\\\\\t          payload: {\\\\\\\\n122\\\\\\\\t            toolCallId,\\\\\\\\n123\\\\\\\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\\\\\\\n124\\\\\\\\t            isError: false,\\\\\\\\n125\\\\\\\\t          },\\\\\\\\n126\\\\\\\\t        }),\\\\\\\\n127\\\\\\\\t      );\\\\\\\\n128\\\\\\\\t    }\\\\\\\\n129\\\\\\\\t  }\\\\\\\\n130\\\\\\\\t  events.push(\\\\\\\\n131\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\", {\\\\\\\\n132\\\\\\\\t      idempotencyKey: key(),\\\\\\\\n133\\\\\\\\t      payload: { text: `findings for area ${turn}` },\\\\\\\\n134\\\\\\\\t    }),\\\\\\\\n135\\\\\\\\t    validEvent(\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\", { idempotencyKey: key() }),\\\\\\\\n136\\\\\\\\t  );\\\\\\\\n137\\\\\\\\t  return events;\\\\\\\\n138\\\\\\\\t}\\\\\\\\n139\\\\\\\\t\\\\\\\\n140\\\\\\\\tfunction intakeBatches(): MessageEventInput[][] {\\\\\\\\n141\\\\\\\\t  const batches: MessageEventInput[][] = [];\\\\\\\\n142\\\\\\\\t  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\\\\\\\n143\\\\\\\\t    const batch: MessageEventInput[] = [];\\\\\\\\n144\\\\\\\\t    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\\\\\\\n145\\\\\\\\t      batch.push(...turnEvents(turn));\\\\\\\\n146\\\\\\\\t    }\\\\\\\\n147\\\\\\\\t    batches.push(batch);\\\\\\\\n148\\\\\\\\t  }\\\\\\\\n149\\\\\\\\t  return batches;\\\\\\\\n150\\\\\\\\t}\\\\\\\\n151\\\\\\\\t\\\\\\\\n152\\\\\\\\t// ── run shape ─────────────────────────────────────────────────────\\\\\\\\n153\\\\\\\\t\\\\\\\\n154\\\\\\\\texport interface LifecyclePhases {\\\\\\\\n155\\\\\\\\t  create: OpResult<{ threadId: string; filePath: string }>;\\\\\\\\n156\\\\\\\\t  intake: Array<OpResult<BatchResult>>;\\\\\\\\n157\\\\\\\\t  drain: { settled: true };\\\\\\\\n158\\\\\\\\t  status: OpResult<ViewStatus>;\\\\\\\\n159\\\\\\\\t  compact1: OpResult<CompactReceipt>;\\\\\\\\n160\\\\\\\\t  pull1: OpResult<PullResult>;\\\\\\\\n161\\\\\\\\t  inspect1: {\\\\\\\\n162\\\\\\\\t    overview: OpResult<InspectOverview>;\\\\\\\\n163\\\\\\\\t    view: OpResult<ViewContentsReport>;\\\\\\\\n164\\\\\\\\t    health: OpResult<HealthReport>;\\\\\\\\n165\\\\\\\\t  };\\\\\\\\n166\\\\\\\\t  mutate: {\\\\\\\\n167\\\\\\\\t    editedMessageId: string;\\\\\\\\n168\\\\\\\\t    deletedMessageId: string;\\\\\\\\n169\\\\\\\\t    edit: OpResult<MutationResult>;\\\\\\\\n170\\\\\\\\t    delete: OpResult<MutationResult>;\\\\\\\\n171\\\\\\\\t    // Captured inside the mutate phase, before the background drain's first\\\\\\\\n172\\\\\\\\t    // macrotask: the cleared-set-pending evidence (AC-5.2).\\\\\\\\n173\\\\\\\\t    healthAfterMutate: OpResult<HealthReport>;\\\\\\\\n174\\\\\\\\t    messagesNotReady: OpResult<FormReportEntry[]>;\\\\\\\\n175\\\\\\\\t    turnsNotReady: OpResult<FormReportEntry[]>;\\\\\\\\n176\\\\\\\\t  };\\\\\\\\n177\\\\\\\\t  rebuild: { settled: true };\\\\\\\\n178\\\\\\\\t  health2: OpResult<HealthReport>;\\\\\\\\n179\\\\\\\\t  compact2: OpResult<CompactReceipt>;\\\\\\\\n180\\\\\\\\t  pull2: OpResult<PullResult>;\\\\\\\\n181\\\\\\\\t  materialize: OpResult<{ writtenPath: string }>;\\\\\\\\n182\\\\\\\\t}\\\\\\\\n183\\\\\\\\t\\\\\\\\n184\\\\\\\\texport type LifecycleCheckpoint = \\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\";\\\\\\\\n185\\\\\\\\t\\\\\\\\n186\\\\\\\\texport interface LifecycleOptions {\\\\\\\\n187\\\\\\\\t  // Distinguishes the thread file and materialize target so replay and\\\\\\\\n188\\\\\\\\t  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\\\\\\\n189\\\\\\\\t  name?: string;\\\\\\\\n190\\\\\\\\t  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\\\\\\\n191\\\\\\\\t  // render phase groups — every group boundary is a quiescent point (no\\\\\\\\n192\\\\\\\\t  // queued work, no running drain), so the abandoned instance can never act\\\\\\\\n193\\\\\\\\t  // after its group ends.\\\\\\\\n194\\\\\\\\t  freshSdkBetweenGroups?: boolean;\\\\\\\\n195\\\\\\\\t  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\\\\\\\n196\\\\\\\\t  onCheckpoint?: (\\\\\\\\n197\\\\\\\\t    checkpoint: LifecycleCheckpoint,\\\\\\\\n198\\\\\\\\t    ctx: { sdk: Lhc; filePath: string },\\\\\\\\n199\\\\\\\\t  ) => Promise<void>;\\\\\\\\n200\\\\\\\\t}\\\\\\\\n201\\\\\\\\t\\\\\\\\n202\\\\\\\\texport interface LifecycleRun {\\\\\\\\n203\\\\\\\\t  filePath: string;\\\\\\\\n204\\\\\\\\t  outPath: string;\\\\\\\\n205\\\\\\\\t  threadId: string;\\\\\\\\n206\\\\\\\\t  phases: LifecyclePhases;\\\\\\\\n207\\\\\\\\t}\\\\\\\\n208\\\\\\\\t\\\\\\\\n209\\\\\\\\tfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\\\\\\\n210\\\\\\\\t  if (!result.ok) {\\\\\\\\n211\\\\\\\\t    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\\\\\\\n212\\\\\\\\t  }\\\\\\\\n213\\\\\\\\t  return result.value;\\\\\\\\n214\\\\\\\\t}\\\\\\\\n215\\\\\\\\t\\\\\\\\n216\\\\\\\\t// ── the sequence ──────────────────────────────────────────────────\\\\\\\\n217\\\\\\\\t\\\\\\\\n218\\\\\\\\texport async function runLifecycle(\\\\\\\\n219\\\\\\\\t  store: TempStore,\\\\\\\\n220\\\\\\\\t  opts: LifecycleOptions = {},\\\\\\\\n221\\\\\\\\t): Promise<LifecycleRun> {\\\\\\\\n222\\\\\\\\t  const name = opts.name ?? \\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\";\\\\\\\\n223\\\\\\\\t  const filePath = store.threadPath(name);\\\\\\\\n224\\\\\\\\t  const outPath = join(store.dir, `${name}-session.jsonl`);\\\\\\\\n225\\\\\\\\t  const ref = { filePath };\\\\\\\\n226\\\\\\\\t\\\\\\\\n227\\\\\\\\t  let sdk = createLifecycleSdk();\\\\\\\\n228\\\\\\\\t  const nextGroup = (): void => {\\\\\\\\n229\\\\\\\\t    // The fresh instance is the same configuration assembled again — the\\\\\\\\n230\\\\\\\\t    // continuity proof is that no phase depends on the prior instance's\\\\\\\\n231\\\\\\\\t    // memory, only on the thread file.\\\\\\\\n232\\\\\\\\t    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\\\\\\\n233\\\\\\\\t  };\\\\\\\\n234\\\\\\\\t  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\\\\\\\n235\\\\\\\\t    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\\\\\\\n236\\\\\\\\t  };\\\\\\\\n237\\\\\\\\t\\\\\\\\n238\\\\\\\\t  // ── group 1: create → intake → drain → status ──\\\\\\\\n239\\\\\\\\t  const create = await sdk.threads.newThread({\\\\\\\\n240\\\\\\\\t    filePath,\\\\\\\\n241\\\\\\\\t    registryPath: store.registryPath,\\\\\\\\n242\\\\\\\\t  });\\\\\\\\n243\\\\\\\\t  const threadId = expectOk(create, \\\\\\\\\\\\\\\"create\\\\\\\\\\\\\\\").threadId;\\\\\\\\n244\\\\\\\\t\\\\\\\\n245\\\\\\\\t  const intake: Array<OpResult<BatchResult>> = [];\\\\\\\\n246\\\\\\\\t  for (const batch of intakeBatches()) {\\\\\\\\n247\\\\\\\\t    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\\\\\\\n248\\\\\\\\t    intake.push(sent);\\\\\\\\n249\\\\\\\\t    expectOk(sent, \\\\\\\\\\\\\\\"intake\\\\\\\\\\\\\\\");\\\\\\\\n250\\\\\\\\t  }\\\\\\\\n251\\\\\\\\t\\\\\\\\n252\\\\\\\\t  // Background drain settles (story scope): the intake pokes scheduled the\\\\\\\\n253\\\\\\\\t  // work; this is the await that lets the scheduler run it to empty.\\\\\\\\n254\\\\\\\\t  await sdk.drainSettled(ref);\\\\\\\\n255\\\\\\\\t  const drain = { settled: true } as const;\\\\\\\\n256\\\\\\\\t\\\\\\\\n257\\\\\\\\t  const status = await sdk.threadView.status(ref);\\\\\\\\n258\\\\\\\\t  expectOk(status, \\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\");\\\\\\\\n259\\\\\\\\t\\\\\\\\n260\\\\\\\\t  // ── group 2: compact1 → pull1 → inspect1 ──\\\\\\\\n261\\\\\\\\t  nextGroup();\\\\\\\\n262\\\\\\\\t  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\n263\\\\\\\\t  expectOk(compact1, \\\\\\\\\\\\\\\"compact1\\\\\\\\\\\\\\\");\\\\\\\\n264\\\\\\\\t  const pull1 = await sdk.threadView.pull(ref);\\\\\\\\n265\\\\\\\\t  expectOk(pull1, \\\\\\\\\\\\\\\"pull1\\\\\\\\\\\\\\\");\\\\\\\\n266\\\\\\\\t  const inspect1 = {\\\\\\\\n267\\\\\\\\t    overview: await sdk.inspect.overview(ref),\\\\\\\\n268\\\\\\\\t    view: await sdk.inspect.view(ref),\\\\\\\\n269\\\\\\\\t    health: await sdk.inspect.health(ref),\\\\\\\\n270\\\\\\\\t  };\\\\\\\\n271\\\\\\\\t  expectOk(inspect1.overview, \\\\\\\\\\\\\\\"inspect1.overview\\\\\\\\\\\\\\\");\\\\\\\\n272\\\\\\\\t  expectOk(inspect1.view, \\\\\\\\\\\\\\\"inspect1.view\\\\\\\\\\\\\\\");\\\\\\\\n273\\\\\\\\t  expectOk(inspect1.health, \\\\\\\\\\\\\\\"inspect1.health\\\\\\\\\\\\\\\");\\\\\\\\n274\\\\\\\\t  await checkpoint(\\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\");\\\\\\\\n275\\\\\\\\t\\\\\\\\n276\\\\\\\\t  // ── group 3: mutate → rebuild → health2 ──\\\\\\\\n277\\\\\\\\t  nextGroup();\\\\\\\\n278\\\\\\\\t  const listed = expectOk(await sdk.messages.listMessages(ref), \\\\\\\\\\\\\\\"mutate.list\\\\\\\\\\\\\\\");\\\\\\\\n279\\\\\\\\t  const editTarget = listed.find(\\\\\\\\n280\\\\\\\\t    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\\\\\\\n281\\\\\\\\t  );\\\\\\\\n282\\\\\\\\t  const deleteTarget = listed.find(\\\\\\\\n283\\\\\\\\t    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\\\\\\\n284\\\\\\\\t  );\\\\\\\\n285\\\\\\\\t  if (editTarget === undefined || deleteTarget === undefined) {\\\\\\\\n286\\\\\\\\t    throw new Error(\\\\\\\\\\\\\\\"lifecycle invariant: edit/delete targets not found in the record\\\\\\\\\\\\\\\");\\\\\\\\n287\\\\\\\\t  }\\\\\\\\n288\\\\\\\\t  // Edit, delete, and the pending-state reads run in one microtask cascade\\\\\\\\n289\\\\\\\\t  // (see module header): the snapshot is taken before the poked background\\\\\\\\n290\\\\\\\\t  // drain starts its first pass.\\\\\\\\n291\\\\\\\\t  const edit = await sdk.messages.edit(ref, {\\\\\\\\n292\\\\\\\\t    messageId: editTarget.messageId,\\\\\\\\n293\\\\\\\\t    content: EDITED_MESSAGE_TEXT,\\\\\\\\n294\\\\\\\\t  });\\\\\\\\n295\\\\\\\\t  expectOk(edit, \\\\\\\\\\\\\\\"mutate.edit\\\\\\\\\\\\\\\");\\\\\\\\n296\\\\\\\\t  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\\\\\\\n297\\\\\\\\t  expectOk(deleted, \\\\\\\\\\\\\\\"mutate.delete\\\\\\\\\\\\\\\");\\\\\\\\n298\\\\\\\\t  const mutate: LifecyclePhases[\\\\\\\\\\\\\\\"mutate\\\\\\\\\\\\\\\"] = {\\\\\\\\n299\\\\\\\\t    editedMessageId: editTarget.messageId,\\\\\\\\n300\\\\\\\\t    deletedMessageId: deleteTarget.messageId,\\\\\\\\n301\\\\\\\\t    edit,\\\\\\\\n302\\\\\\\\t    delete: deleted,\\\\\\\\n303\\\\\\\\t    healthAfterMutate: await sdk.inspect.health(ref),\\\\\\\\n304\\\\\\\\t    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\\\\\\\n305\\\\\\\\t    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\\\\\\\n306\\\\\\\\t  };\\\\\\\\n307\\\\\\\\t  expectOk(mutate.healthAfterMutate, \\\\\\\\\\\\\\\"mutate.health\\\\\\\\\\\\\\\");\\\\\\\\n308\\\\\\\\t  expectOk(mutate.messagesNotReady, \\\\\\\\\\\\\\\"mutate.messagesNotReady\\\\\\\\\\\\\\\");\\\\\\\\n309\\\\\\\\t  expectOk(mutate.turnsNotReady, \\\\\\\\\\\\\\\"mutate.turnsNotReady\\\\\\\\\\\\\\\");\\\\\\\\n310\\\\\\\\t\\\\\\\\n311\\\\\\\\t  // Rebuild drains: the mutations' pokes already scheduled the cascade\\\\\\\\n312\\\\\\\\t  // rebuilds on THIS instance's scheduler; settle is the production await.\\\\\\\\n313\\\\\\\\t  await sdk.drainSettled(ref);\\\\\\\\n314\\\\\\\\t  const rebuild = { settled: true } as const;\\\\\\\\n315\\\\\\\\t\\\\\\\\n316\\\\\\\\t  const health2 = await sdk.inspect.health(ref);\\\\\\\\n317\\\\\\\\t  expectOk(health2, \\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\");\\\\\\\\n318\\\\\\\\t  await checkpoint(\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\");\\\\\\\\n319\\\\\\\\t\\\\\\\\n320\\\\\\\\t  // ── group 4: compact2 → pull2 → materialize ──\\\\\\\\n321\\\\\\\\t  nextGroup();\\\\\\\\n322\\\\\\\\t  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\n323\\\\\\\\t  expectOk(compact2, \\\\\\\\\\\\\\\"compact2\\\\\\\\\\\\\\\");\\\\\\\\n324\\\\\\\\t  const pull2 = await sdk.threadView.pull(ref);\\\\\\\\n325\\\\\\\\t  expectOk(pull2, \\\\\\\\\\\\\\\"pull2\\\\\\\\\\\\\\\");\\\\\\\\n326\\\\\\\\t  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\\\\\\\n327\\\\\\\\t  expectOk(materialize, \\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\");\\\\\\\\n328\\\\\\\\t  await checkpoint(\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\");\\\\\\\\n329\\\\\\\\t\\\\\\\\n330\\\\\\\\t  return {\\\\\\\\n331\\\\\\\\t    filePath,\\\\\\\\n332\\\\\\\\t    outPath,\\\\\\\\n333\\\\\\\\t    threadId,\\\\\\\\n334\\\\\\\\t    phases: {\\\\\\\\n335\\\\\\\\t      create,\\\\\\\\n336\\\\\\\\t      intake,\\\\\\\\n337\\\\\\\\t      drain,\\\\\\\\n338\\\\\\\\t      status,\\\\\\\\n339\\\\\\\\t      compact1,\\\\\\\\n340\\\\\\\\t      pull1,\\\\\\\\n341\\\\\\\\t      inspect1,\\\\\\\\n342\\\\\\\\t      mutate,\\\\\\\\n343\\\\\\\\t      rebuild,\\\\\\\\n344\\\\\\\\t      health2,\\\\\\\\n345\\\\\\\\t      compact2,\\\\\\\\n346\\\\\\\\t      pull2,\\\\\\\\n347\\\\\\\\t      materialize,\\\\\\\\n348\\\\\\\\t    },\\\\\\\\n349\\\\\\\\t  };\\\\\\\\n350\\\\\\\\t}\\\\\\\\n351\\\\\\\\t\\\\\\\"}]},\\\\\\\"parent_tool_use_id\\\\\\\":null,\\\\\\\"session_id\\\\\\\":\\\\\\\"7428c05c-eec6-4310-9738-8828ad5ff5b2\\\\\\\",\\\\\\\"uuid\\\\\\\":\\\\\\\"29748b91-283e-4097-bcb3-33b0be9e7cd0\\\\\\\",\\\\\\\"timestamp\\\\\\\":\\\\\\\"2026-06-12T23:21:18.758Z\\\\\\\",\\\\\\\"tool_use_result\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"text\\\\\\\",\\\\\\\"file\\\\\\\":{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\\\\\\\n// driven once, in PI-extension call order, against one real SDK\\\\\\\\n// configuration with the deterministic provider — zero network, zero real\\\\\\\\n// provider, no mocks anywhere. The script owns the sequence and the phase\\\\\\\\n// names (tech design Flow 5); assertions live in the driving tests, so the\\\\\\\\n// replay, teardown, and process legs all run THIS sequence rather than a\\\\\\\\n// re-described one (DD-8).\\\\\\\\n//\\\\\\\\n// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\\\\\\\n// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\\\\\\\n//\\\\\\\\n// Mode is background — the production posture the PI extension will run —\\\\\\\\n// and the drain/rebuild phases settle through `drainSettled`, the real\\\\\\\\n// background awaitable. The post-mutation health snapshot (AC-5.2's\\\\\\\\n// \\\\\\\\\\\\\\\"cleared set pending\\\\\\\\\\\\\\\") is deterministic because every SDK operation here\\\\\\\\n// is synchronous SQLite chained through microtasks, while a background\\\\\\\\n// drain pass always starts on a macrotask (scheduler runLoop defers through\\\\\\\\n// setImmediate): the edit → delete → health reads inside the mutate phase\\\\\\\\n// run as one unbroken microtask cascade and complete before the poked drain\\\\\\\\n// can claim its first item. The rebuild phase then yields via drainSettled\\\\\\\\n// and the drain runs to empty.\\\\\\\\nimport { join } from \\\\\\\\\\\\\\\"node:path\\\\\\\\\\\\\\\";\\\\\\\\nimport {\\\\\\\\n  createDeterministicProvider,\\\\\\\\n  createSdk,\\\\\\\\n  type BatchResult,\\\\\\\\n  type CompactReceipt,\\\\\\\\n  type FormReportEntry,\\\\\\\\n  type HealthReport,\\\\\\\\n  type InspectOverview,\\\\\\\\n  type Lhc,\\\\\\\\n  type MessageEventInput,\\\\\\\\n  type MutationResult,\\\\\\\\n  type OpResult,\\\\\\\\n  type PullResult,\\\\\\\\n  type ViewContentsReport,\\\\\\\\n  type ViewStatus,\\\\\\\\n} from \\\\\\\\\\\\\\\"../../src/index.js\\\\\\\\\\\\\\\";\\\\\\\\nimport { validEvent, type TempStore } from \\\\\\\\\\\\\\\"./index.js\\\\\\\\\\\\\\\";\\\\\\\\n\\\\\\\\n// ── the one SDK configuration (AC-5.1) ────────────────────────────\\\\\\\\n//\\\\\\\\n// Deterministic provider injected at construction (the only provider-arrival\\\\\\\\n// path since the CLI retired), background mode, zero-backoff retry so a\\\\\\\\n// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\\\\\\\n// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\\\\\\\n// a named \\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\" profile so compact runs profile-addressed (story\\\\\\\\n// scope: \\\\\\\\\\\\\\\"compact (profile)\\\\\\\\\\\\\\\") with all three lower bands non-empty on this\\\\\\\\n// thread (Epic 03 Story 2's reference gradient).\\\\\\\\nexport const LIFECYCLE_PROFILE = {\\\\\\\\n  name: \\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\",\\\\\\\\n  lowerBound: 400,\\\\\\\\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\\\\\\\n} as const;\\\\\\\\n\\\\\\\\nexport function createLifecycleSdk(): Lhc {\\\\\\\\n  return createSdk({\\\\\\\\n    provider: createDeterministicProvider(),\\\\\\\\n    mode: \\\\\\\\\\\\\\\"background\\\\\\\\\\\\\\\",\\\\\\\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\\\\\\\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\\\\\\\n    view: {\\\\\\\\n      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\\\\\\\n      // Low threshold so the status checkpoint genuinely recommends the\\\\\\\\n      // compact the sequence performs next.\\\\\\\\n      compactThreshold: 300,\\\\\\\\n    },\\\\\\\\n  });\\\\\\\\n}\\\\\\\\n\\\\\\\\n// ── the recorded conversation ─────────────────────────────────────\\\\\\\\n//\\\\\\\\n// Same shape and text profile as the Epic 03 derived-thread fixture (12\\\\\\\\n// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\\\\\\\n// policy cuts the same 4-chunk shape — but with explicit per-run\\\\\\\\n// idempotency keys so a replay on a fresh thread records byte-identical\\\\\\\\n// event payloads regardless of any process-global fixture counters.\\\\\\\\nconst TURN_COUNT = 12;\\\\\\\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\\\\\\\nconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\\\\\\\n\\\\\\\\n// Mutation targets: both in the post-compact tail (compact point at t9's\\\\\\\\n// start under the lifecycle profile), so the second compact's pull shows the\\\\\\\\n// edit verbatim and the deletion's absence — the tail is full fidelity.\\\\\\\\nexport const EDIT_TARGET = { turnId: \\\\\\\\\\\\\\\"t12\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\" } as const;\\\\\\\\nexport const EDITED_MESSAGE_TEXT =\\\\\\\\n  \\\\\\\\\\\\\\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\\\\\\\\\\\\\";\\\\\\\\nexport const DELETE_TARGET = { turnId: \\\\\\\\\\\\\\\"t10\\\\\\\\\\\\\\\", kind: \\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\" } as const;\\\\\\\\nexport const DELETED_MESSAGE_TEXT = \\\\\\\\\\\\\\\"findings for area 10\\\\\\\\\\\\\\\";\\\\\\\\n\\\\\\\\nfunction turnEvents(turn: number): MessageEventInput[] {\\\\\\\\n  let seq = 0;\\\\\\\\n  const key = (): string => {\\\\\\\\n    seq += 1;\\\\\\\\n    return `lc-t${turn}-e${seq}`;\\\\\\\\n  };\\\\\\\\n  const events: MessageEventInput[] = [\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"user_prompt\\\\\\\\\\\\\\\", {\\\\\\\\n      idempotencyKey: key(),\\\\\\\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\\\\\\\n    }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"assistant_thinking\\\\\\\\\\\\\\\", {\\\\\\\\n      idempotencyKey: key(),\\\\\\\\n      payload: { text: `considering what area ${turn} contains` },\\\\\\\\n    }),\\\\\\\\n  ];\\\\\\\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\\\\\\\n    for (const run of [1, 2]) {\\\\\\\\n      const toolCallId = `call-lc-${turn}-${run}`;\\\\\\\\n      events.push(\\\\\\\\n        validEvent(\\\\\\\\\\\\\\\"tool_call\\\\\\\\\\\\\\\", {\\\\\\\\n          idempotencyKey: key(),\\\\\\\\n          payload: {\\\\\\\\n            toolCallId,\\\\\\\\n            toolName: \\\\\\\\\\\\\\\"read_file\\\\\\\\\\\\\\\",\\\\\\\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\\\\\\\n          },\\\\\\\\n        }),\\\\\\\\n        validEvent(\\\\\\\\\\\\\\\"tool_result\\\\\\\\\\\\\\\", {\\\\\\\\n          idempotencyKey: key(),\\\\\\\\n          payload: {\\\\\\\\n            toolCallId,\\\\\\\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\\\\\\\n            isError: false,\\\\\\\\n          },\\\\\\\\n        }),\\\\\\\\n      );\\\\\\\\n    }\\\\\\\\n  }\\\\\\\\n  events.push(\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"assistant_text\\\\\\\\\\\\\\\", {\\\\\\\\n      idempotencyKey: key(),\\\\\\\\n      payload: { text: `findings for area ${turn}` },\\\\\\\\n    }),\\\\\\\\n    validEvent(\\\\\\\\\\\\\\\"turn_end\\\\\\\\\\\\\\\", { idempotencyKey: key() }),\\\\\\\\n  );\\\\\\\\n  return events;\\\\\\\\n}\\\\\\\\n\\\\\\\\nfunction intakeBatches(): MessageEventInput[][] {\\\\\\\\n  const batches: MessageEventInput[][] = [];\\\\\\\\n  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\\\\\\\n    const batch: MessageEventInput[] = [];\\\\\\\\n    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\\\\\\\n      batch.push(...turnEvents(turn));\\\\\\\\n    }\\\\\\\\n    batches.push(batch);\\\\\\\\n  }\\\\\\\\n  return batches;\\\\\\\\n}\\\\\\\\n\\\\\\\\n// ── run shape ─────────────────────────────────────────────────────\\\\\\\\n\\\\\\\\nexport interface LifecyclePhases {\\\\\\\\n  create: OpResult<{ threadId: string; filePath: string }>;\\\\\\\\n  intake: Array<OpResult<BatchResult>>;\\\\\\\\n  drain: { settled: true };\\\\\\\\n  status: OpResult<ViewStatus>;\\\\\\\\n  compact1: OpResult<CompactReceipt>;\\\\\\\\n  pull1: OpResult<PullResult>;\\\\\\\\n  inspect1: {\\\\\\\\n    overview: OpResult<InspectOverview>;\\\\\\\\n    view: OpResult<ViewContentsReport>;\\\\\\\\n    health: OpResult<HealthReport>;\\\\\\\\n  };\\\\\\\\n  mutate: {\\\\\\\\n    editedMessageId: string;\\\\\\\\n    deletedMessageId: string;\\\\\\\\n    edit: OpResult<MutationResult>;\\\\\\\\n    delete: OpResult<MutationResult>;\\\\\\\\n    // Captured inside the mutate phase, before the background drain's first\\\\\\\\n    // macrotask: the cleared-set-pending evidence (AC-5.2).\\\\\\\\n    healthAfterMutate: OpResult<HealthReport>;\\\\\\\\n    messagesNotReady: OpResult<FormReportEntry[]>;\\\\\\\\n    turnsNotReady: OpResult<FormReportEntry[]>;\\\\\\\\n  };\\\\\\\\n  rebuild: { settled: true };\\\\\\\\n  health2: OpResult<HealthReport>;\\\\\\\\n  compact2: OpResult<CompactReceipt>;\\\\\\\\n  pull2: OpResult<PullResult>;\\\\\\\\n  materialize: OpResult<{ writtenPath: string }>;\\\\\\\\n}\\\\\\\\n\\\\\\\\nexport type LifecycleCheckpoint = \\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\";\\\\\\\\n\\\\\\\\nexport interface LifecycleOptions {\\\\\\\\n  // Distinguishes the thread file and materialize target so replay and\\\\\\\\n  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\\\\\\\n  name?: string;\\\\\\\\n  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\\\\\\\n  // render phase groups — every group boundary is a quiescent point (no\\\\\\\\n  // queued work, no running drain), so the abandoned instance can never act\\\\\\\\n  // after its group ends.\\\\\\\\n  freshSdkBetweenGroups?: boolean;\\\\\\\\n  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\\\\\\\n  onCheckpoint?: (\\\\\\\\n    checkpoint: LifecycleCheckpoint,\\\\\\\\n    ctx: { sdk: Lhc; filePath: string },\\\\\\\\n  ) => Promise<void>;\\\\\\\\n}\\\\\\\\n\\\\\\\\nexport interface LifecycleRun {\\\\\\\\n  filePath: string;\\\\\\\\n  outPath: string;\\\\\\\\n  threadId: string;\\\\\\\\n  phases: LifecyclePhases;\\\\\\\\n}\\\\\\\\n\\\\\\\\nfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\\\\\\\n  if (!result.ok) {\\\\\\\\n    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\\\\\\\n  }\\\\\\\\n  return result.value;\\\\\\\\n}\\\\\\\\n\\\\\\\\n// ── the sequence ──────────────────────────────────────────────────\\\\\\\\n\\\\\\\\nexport async function runLifecycle(\\\\\\\\n  store: TempStore,\\\\\\\\n  opts: LifecycleOptions = {},\\\\\\\\n): Promise<LifecycleRun> {\\\\\\\\n  const name = opts.name ?? \\\\\\\\\\\\\\\"lifecycle\\\\\\\\\\\\\\\";\\\\\\\\n  const filePath = store.threadPath(name);\\\\\\\\n  const outPath = join(store.dir, `${name}-session.jsonl`);\\\\\\\\n  const ref = { filePath };\\\\\\\\n\\\\\\\\n  let sdk = createLifecycleSdk();\\\\\\\\n  const nextGroup = (): void => {\\\\\\\\n    // The fresh instance is the same configuration assembled again — the\\\\\\\\n    // continuity proof is that no phase depends on the prior instance's\\\\\\\\n    // memory, only on the thread file.\\\\\\\\n    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\\\\\\\n  };\\\\\\\\n  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\\\\\\\n    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\\\\\\\n  };\\\\\\\\n\\\\\\\\n  // ── group 1: create → intake → drain → status ──\\\\\\\\n  const create = await sdk.threads.newThread({\\\\\\\\n    filePath,\\\\\\\\n    registryPath: store.registryPath,\\\\\\\\n  });\\\\\\\\n  const threadId = expectOk(create, \\\\\\\\\\\\\\\"create\\\\\\\\\\\\\\\").threadId;\\\\\\\\n\\\\\\\\n  const intake: Array<OpResult<BatchResult>> = [];\\\\\\\\n  for (const batch of intakeBatches()) {\\\\\\\\n    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\\\\\\\n    intake.push(sent);\\\\\\\\n    expectOk(sent, \\\\\\\\\\\\\\\"intake\\\\\\\\\\\\\\\");\\\\\\\\n  }\\\\\\\\n\\\\\\\\n  // Background drain settles (story scope): the intake pokes scheduled the\\\\\\\\n  // work; this is the await that lets the scheduler run it to empty.\\\\\\\\n  await sdk.drainSettled(ref);\\\\\\\\n  const drain = { settled: true } as const;\\\\\\\\n\\\\\\\\n  const status = await sdk.threadView.status(ref);\\\\\\\\n  expectOk(status, \\\\\\\\\\\\\\\"status\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\\n  // ── group 2: compact1 → pull1 → inspect1 ──\\\\\\\\n  nextGroup();\\\\\\\\n  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\n  expectOk(compact1, \\\\\\\\\\\\\\\"compact1\\\\\\\\\\\\\\\");\\\\\\\\n  const pull1 = await sdk.threadView.pull(ref);\\\\\\\\n  expectOk(pull1, \\\\\\\\\\\\\\\"pull1\\\\\\\\\\\\\\\");\\\\\\\\n  const inspect1 = {\\\\\\\\n    overview: await sdk.inspect.overview(ref),\\\\\\\\n    view: await sdk.inspect.view(ref),\\\\\\\\n    health: await sdk.inspect.health(ref),\\\\\\\\n  };\\\\\\\\n  expectOk(inspect1.overview, \\\\\\\\\\\\\\\"inspect1.overview\\\\\\\\\\\\\\\");\\\\\\\\n  expectOk(inspect1.view, \\\\\\\\\\\\\\\"inspect1.view\\\\\\\\\\\\\\\");\\\\\\\\n  expectOk(inspect1.health, \\\\\\\\\\\\\\\"inspect1.health\\\\\\\\\\\\\\\");\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\"inspect1\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\\n  // ── group 3: mutate → rebuild → health2 ──\\\\\\\\n  nextGroup();\\\\\\\\n  const listed = expectOk(await sdk.messages.listMessages(ref), \\\\\\\\\\\\\\\"mutate.list\\\\\\\\\\\\\\\");\\\\\\\\n  const editTarget = listed.find(\\\\\\\\n    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\\\\\\\n  );\\\\\\\\n  const deleteTarget = listed.find(\\\\\\\\n    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\\\\\\\n  );\\\\\\\\n  if (editTarget === undefined || deleteTarget === undefined) {\\\\\\\\n    throw new Error(\\\\\\\\\\\\\\\"lifecycle invariant: edit/delete targets not found in the record\\\\\\\\\\\\\\\");\\\\\\\\n  }\\\\\\\\n  // Edit, delete, and the pending-state reads run in one microtask cascade\\\\\\\\n  // (see module header): the snapshot is taken before the poked background\\\\\\\\n  // drain starts its first pass.\\\\\\\\n  const edit = await sdk.messages.edit(ref, {\\\\\\\\n    messageId: editTarget.messageId,\\\\\\\\n    content: EDITED_MESSAGE_TEXT,\\\\\\\\n  });\\\\\\\\n  expectOk(edit, \\\\\\\\\\\\\\\"mutate.edit\\\\\\\\\\\\\\\");\\\\\\\\n  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\\\\\\\n  expectOk(deleted, \\\\\\\\\\\\\\\"mutate.delete\\\\\\\\\\\\\\\");\\\\\\\\n  const mutate: LifecyclePhases[\\\\\\\\\\\\\\\"mutate\\\\\\\\\\\\\\\"] = {\\\\\\\\n    editedMessageId: editTarget.messageId,\\\\\\\\n    deletedMessageId: deleteTarget.messageId,\\\\\\\\n    edit,\\\\\\\\n    delete: deleted,\\\\\\\\n    healthAfterMutate: await sdk.inspect.health(ref),\\\\\\\\n    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\\\\\\\n    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\\\\\\\n  };\\\\\\\\n  expectOk(mutate.healthAfterMutate, \\\\\\\\\\\\\\\"mutate.health\\\\\\\\\\\\\\\");\\\\\\\\n  expectOk(mutate.messagesNotReady, \\\\\\\\\\\\\\\"mutate.messagesNotReady\\\\\\\\\\\\\\\");\\\\\\\\n  expectOk(mutate.turnsNotReady, \\\\\\\\\\\\\\\"mutate.turnsNotReady\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\\n  // Rebuild drains: the mutations' pokes already scheduled the cascade\\\\\\\\n  // rebuilds on THIS instance's scheduler; settle is the production await.\\\\\\\\n  await sdk.drainSettled(ref);\\\\\\\\n  const rebuild = { settled: true } as const;\\\\\\\\n\\\\\\\\n  const health2 = await sdk.inspect.health(ref);\\\\\\\\n  expectOk(health2, \\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\");\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\"health2\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\\n  // ── group 4: compact2 → pull2 → materialize ──\\\\\\\\n  nextGroup();\\\\\\\\n  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\\\\\\\n  expectOk(compact2, \\\\\\\\\\\\\\\"compact2\\\\\\\\\\\\\\\");\\\\\\\\n  const pull2 = await sdk.threadView.pull(ref);\\\\\\\\n  expectOk(pull2, \\\\\\\\\\\\\\\"pull2\\\\\\\\\\\\\\\");\\\\\\\\n  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\\\\\\\n  expectOk(materialize, \\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\");\\\\\\\\n  await checkpoint(\\\\\\\\\\\\\\\"materialize\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\\n  return {\\\\\\\\n    filePath,\\\\\\\\n    outPath,\\\\\\\\n    threadId,\\\\\\\\n    phases: {\\\\\\\\n      create,\\\\\\\\n      intake,\\\\\\\\n      drain,\\\\\\\\n      status,\\\\\\\\n      compact1,\\\\\\\\n      pull1,\\\\\\\\n      inspect1,\\\\\\\\n      mutate,\\\\\\\\n      rebuild,\\\\\\\\n      health2,\\\\\\\\n      compact2,\\\\\\\\n      pull2,\\\\\\\\n      materialize,\\\\\\\\n    },\\\\\\\\n  };\\\\\\\\n}\\\\\\\\n\\\\\\\",\\\\\\\"numLines\\\\\\\":351,\\\\\\\"startLine\\\\\\\":1,\\\\\\\"totalLines\\\\\\\":351}}}\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:313:{\\\\\\\"type\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"message\\\\\\\":{\\\\\\\"role\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"tool_use_id\\\\\\\":\\\\\\\"toolu_01SJiViszn1dPMaUZaFJuxGD\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"tool_result\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"1\\\\\\\\t// The real provider (DD-2): createInferenceProvider returns the same\\\\\\\\n2\\\\\\\\t// DerivationProvider interface the deterministic provider implements, so\\\\\\\\n3\\\\\\\\t// createSdk and everything below it see a provider, full stop. Every\\\\\\\\n4\\\\\\\\t// operation is the same five-step pipeline (Flow 2): bound the input where\\\\\\\\n5\\\\\\\\t// DD-7 applies, render the kind's prompt template into single-turn messages,\\\\\\\\n6\\\\\\\\t// call the host ModelCall with the kind's assignment, reject empty or\\\\\\\\n7\\\\\\\\t// whitespace-only text as empty_output (AC-2.4), and return the shaped text\\\\\\\\n8\\\\\\\\t// with config-known provenance (AC-2.5). The adapter never parses model text\\\\\\\\n9\\\\\\\\t// for outcomes, receipts, or any mechanical fact — those stay\\\\\\\\n10\\\\\\\\t// handler-authored from the record. Host containment (thrown exceptions,\\\\\\\\n11\\\\\\\\t// the adapter-owned timeout) lives in safeCall (AC-3.3, DD-6).\\\\\\\\n12\\\\\\\\timport type {\\\\\\\\n13\\\\\\\\t  DerivationProvider,\\\\\\\\n14\\\\\\\\t  FormKind,\\\\\\\\n15\\\\\\\\t  ProviderResult,\\\\\\\\n16\\\\\\\\t} from \\\\\\\\\\\\\\\"../shared/derivation.js\\\\\\\\\\\\\\\";\\\\\\\\n17\\\\\\\\timport { FAILURE_CLASSIFICATION, safeCall } from \\\\\\\\\\\\\\\"./classify.js\\\\\\\\\\\\\\\";\\\\\\\\n18\\\\\\\\timport { PROMPT_REGISTRY, type PromptTemplate } from \\\\\\\\\\\\\\\"./prompts/index.js\\\\\\\\\\\\\\\";\\\\\\\\n19\\\\\\\\timport type { ModelCallFailureKind, ResolvedInferenceConfig } from \\\\\\\\\\\\\\\"./types.js\\\\\\\\\\\\\\\";\\\\\\\\n20\\\\\\\\t\\\\\\\\n21\\\\\\\\t// DD-7: a pathological tool result must not blow a small-context model.\\\\\\\\n22\\\\\\\\t// Content over the bound keeps its head and tail around a marker, and the\\\\\\\\n23\\\\\\\\t// bounded whole stays within maxInputChars; bounding happens before prompt\\\\\\\\n24\\\\\\\\t// rendering, so the dropped middle never crosses the boundary.\\\\\\\\n25\\\\\\\\tfunction boundContent(content: string, maxInputChars: number): string {\\\\\\\\n26\\\\\\\\t  if (content.length <= maxInputChars) return content;\\\\\\\\n27\\\\\\\\t  const marker = `\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n`;\\\\\\\\n28\\\\\\\\t  // The marker only earns its place when head + marker + tail still fits the\\\\\\\\n29\\\\\\\\t  // bound. When maxInputChars is smaller than the marker itself, there is no\\\\\\\\n30\\\\\\\\t  // budget for the marker — emitting it would be the one path that crosses the\\\\\\\\n31\\\\\\\\t  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\\\\\\\\n32\\\\\\\\t  // honors the cap exactly.\\\\\\\\n33\\\\\\\\t  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\\\\\\\\n34\\\\\\\\t  const keep = maxInputChars - marker.length;\\\\\\\\n35\\\\\\\\t  const head = Math.ceil(keep / 2);\\\\\\\\n36\\\\\\\\t  const tail = keep - head;\\\\\\\\n37\\\\\\\\t  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");\\\\\\\\n38\\\\\\\\t}\\\\\\\\n39\\\\\\\\t\\\\\\\\n40\\\\\\\\t// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\\\\\\\\n41\\\\\\\\t// has, and the reason string is machine-readable by the established\\\\\\\\n42\\\\\\\\t// code-before-first-colon convention. Retryable failures lead with\\\\\\\\n43\\\\\\\\t// `provider_failure` — the code Epic 02 has always landed on exhausted forms\\\\\\\\n44\\\\\\\\t// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\\\\\\\\n45\\\\\\\\t// with the failure kind named next; terminal kinds lead with the kind itself\\\\\\\\n46\\\\\\\\t// and land failed immediately.\\\\\\\\n47\\\\\\\\tfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\\\\\\\\n48\\\\\\\\t  const { retryable } = FAILURE_CLASSIFICATION[kind];\\\\\\\\n49\\\\\\\\t  const detail = message === \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\" ? kind : `${kind}: ${message}`;\\\\\\\\n50\\\\\\\\t  return {\\\\\\\\n51\\\\\\\\t    ok: false,\\\\\\\\n52\\\\\\\\t    retryable,\\\\\\\\n53\\\\\\\\t    reason: retryable ? `provider_failure: ${detail}` : detail,\\\\\\\\n54\\\\\\\\t  };\\\\\\\\n55\\\\\\\\t}\\\\\\\\n56\\\\\\\\t\\\\\\\\n57\\\\\\\\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\\\\\\\\n58\\\\\\\\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\\\\\\\\n59\\\\\\\\t    const assignment = config.assignments[kind];\\\\\\\\n60\\\\\\\\t    // Construction validated the name (AC-1.3); a miss here is registry\\\\\\\\n61\\\\\\\\t    // drift after construction and is terminal, never retried into.\\\\\\\\n62\\\\\\\\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\\\\\\\\n63\\\\\\\\t    if (template === undefined) {\\\\\\\\n64\\\\\\\\t      return classifiedFailure(\\\\\\\\n65\\\\\\\\t        \\\\\\\\\\\\\\\"invalid_request\\\\\\\\\\\\\\\",\\\\\\\\n66\\\\\\\\t        `prompt template \\\\\\\\\\\\\\\"${assignment.prompt}\\\\\\\\\\\\\\\" not in registry`,\\\\\\\\n67\\\\\\\\t      );\\\\\\\\n68\\\\\\\\t    }\\\\\\\\n69\\\\\\\\t    const messages = template.render(input);\\\\\\\\n70\\\\\\\\t    // safeCall contains the host (AC-3.3, DD-6): thrown exceptions arrive as\\\\\\\\n71\\\\\\\\t    // structured `other` failures and a hung function loses the timeout race\\\\\\\\n72\\\\\\\\t    // as `timeout` — both flow through the same classification below.\\\\\\\\n73\\\\\\\\t    const result = await safeCall(\\\\\\\\n74\\\\\\\\t      config.call,\\\\\\\\n75\\\\\\\\t      { provider: assignment.provider, model: assignment.model, messages },\\\\\\\\n76\\\\\\\\t      config.timeoutMs,\\\\\\\\n77\\\\\\\\t    );\\\\\\\\n78\\\\\\\\t    if (!result.ok) {\\\\\\\\n79\\\\\\\\t      return classifiedFailure(result.kind, result.message);\\\\\\\\n80\\\\\\\\t    }\\\\\\\\n81\\\\\\\\t    // Shaping: surrounding whitespace never becomes form content — and a\\\\\\\\n82\\\\\\\\t    // model that returned nothing but whitespace has not produced a\\\\\\\\n83\\\\\\\\t    // derivation (AC-2.4): a classified retryable failure, never a ready\\\\\\\\n84\\\\\\\\t    // form. `empty_output` is adapter-generated; hosts never return it.\\\\\\\\n85\\\\\\\\t    const text = result.text.trim();\\\\\\\\n86\\\\\\\\t    if (text === \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\") {\\\\\\\\n87\\\\\\\\t      return classifiedFailure(\\\\\\\\\\\\\\\"empty_output\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"model returned empty or whitespace-only text\\\\\\\\\\\\\\\");\\\\\\\\n88\\\\\\\\t    }\\\\\\\\n89\\\\\\\\t    // Provenance is the assignment's three config-known strings, copied —\\\\\\\\n90\\\\\\\\t    // never authored from model output (DD-4).\\\\\\\\n91\\\\\\\\t    return {\\\\\\\\n92\\\\\\\\t      ok: true,\\\\\\\\n93\\\\\\\\t      text,\\\\\\\\n94\\\\\\\\t      provenance: {\\\\\\\\n95\\\\\\\\t        provider: assignment.provider,\\\\\\\\n96\\\\\\\\t        model: assignment.model,\\\\\\\\n97\\\\\\\\t        prompt: assignment.prompt,\\\\\\\\n98\\\\\\\\t      },\\\\\\\\n99\\\\\\\\t    };\\\\\\\\n100\\\\\\\\t  };\\\\\\\\n101\\\\\\\\t\\\\\\\\n102\\\\\\\\t  return {\\\\\\\\n103\\\\\\\\t    smoothPrompt: (i) => callKind(\\\\\\\\\\\\\\\"smoothed_prompt\\\\\\\\\\\\\\\", i),\\\\\\\\n104\\\\\\\\t    summarizeToolCall: (i) => callKind(\\\\\\\\\\\\\\\"tool_call_summary\\\\\\\\\\\\\\\", i),\\\\\\\\n105\\\\\\\\t    summarizeToolResult: (i) =>\\\\\\\\n106\\\\\\\\t      callKind(\\\\\\\\\\\\\\\"tool_result_summary\\\\\\\\\\\\\\\", {\\\\\\\\n107\\\\\\\\t        toolName: i.toolName,\\\\\\\\n108\\\\\\\\t        content: boundContent(i.content, config.maxInputChars),\\\\\\\\n109\\\\\\\\t      }),\\\\\\\\n110\\\\\\\\t    composeTurnRendering: (i) => callKind(\\\\\\\\\\\\\\\"turn_rendering\\\\\\\\\\\\\\\", i),\\\\\\\\n111\\\\\\\\t    projectLowerBand: (i) => callKind(\\\\\\\\\\\\\\\"lower_band_projection\
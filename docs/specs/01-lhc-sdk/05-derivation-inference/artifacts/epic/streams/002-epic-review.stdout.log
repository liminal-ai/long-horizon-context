{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/profiles.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Profile config resolution and validation (Story 0, FC-0.2): built-in\n     2\t// profiles, user profiles merged over them by name, and the budget rules —\n     3\t// band shares sum to 100, lower bound positive, visibility max > target.\n     4\t// Pure functions, no IO. Config mistakes are programmer errors at SDK\n     5\t// construction and throw naming the violation (Epic 02 rule); nothing here\n     6\t// returns OpResults.\n     7\timport type {\n     8\t  ResolvedViewConfig,\n     9\t  SdkViewConfig,\n    10\t  ViewProfile,\n    11\t  ViewProfileOverride,\n    12\t  VisibilityBudgets,\n    13\t} from \"../../../shared/view.js\";\n    14\t\n    15\t// Built-in profiles (tech design §Interface Definitions): defaults, knobs\n    16\t// not architecture.\n    17\texport const BUILT_IN_PROFILES: readonly ViewProfile[] = [\n    18\t  {\n    19\t    name: \"continuation\",\n    20\t    lowerBound: 120000,\n    21\t    percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n    22\t  },\n    23\t  {\n    24\t    name: \"conversation\",\n    25\t    lowerBound: 120000,\n    26\t    percentages: { full: 12, smooth: 48, detailed: 20, brief: 20 },\n    27\t  },\n    28\t  {\n    29\t    name: \"coding\",\n    30\t    lowerBound: 120000,\n    31\t    percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n    32\t  },\n    33\t];\n    34\t\n    35\texport const DEFAULT_VISIBILITY: VisibilityBudgets = {\n    36\t  maxTokens: 64000,\n    37\t  targetTokens: 32000,\n    38\t};\n    39\t\n    40\texport const DEFAULT_COMPACT_THRESHOLD = 160000;\n    41\t\n    42\tfunction fail(detail: string): never {\n    43\t  throw new TypeError(`createSdk config: view: ${detail}`);\n    44\t}\n    45\t\n    46\tconst BAND_KEYS = [\"full\", \"smooth\", \"detailed\", \"brief\"] as const;\n    47\t\n    48\t// The violated constraint, named, or null when the profile is sound: one\n    49\t// rule set shared by both rejection surfaces — SDK construction (throws,\n    50\t// below) and compact invocation (caller-error result, AC-2.3).\n    51\texport function profileViolation(profile: ViewProfile): string | null {\n    52\t  if (!Number.isFinite(profile.lowerBound) || profile.lowerBound <= 0) {\n    53\t    return `profile \"${profile.name}\": lowerBound must be a positive number, got ${profile.lowerBound}`;\n    54\t  }\n    55\t  for (const key of BAND_KEYS) {\n    56\t    const share = profile.percentages[key];\n    57\t    if (!Number.isFinite(share) || share < 0) {\n    58\t      return `profile \"${profile.name}\": percentage ${key} must be a non-negative number, got ${share}`;\n    59\t    }\n    60\t  }\n    61\t  const sum = BAND_KEYS.reduce((total, key) => total + profile.percentages[key], 0);\n    62\t  if (sum !== 100) {\n    63\t    return `profile \"${profile.name}\": percentages must sum to 100, got ${sum}`;\n    64\t  }\n    65\t  return null;\n    66\t}\n    67\t\n    68\t// A complete, merged profile validates whole: positive lower bound, finite\n    69\t// non-negative shares, shares summing to exactly 100. Errors name the\n    70\t// violated constraint and the profile (AC-2.3's vocabulary, applied at\n    71\t// construction).\n    72\texport function validateProfile(profile: ViewProfile): void {\n    73\t  const violation = profileViolation(profile);\n    74\t  if (violation !== null) fail(violation);\n    75\t}\n    76\t\n    77\tfunction isCompleteOverride(entry: ViewProfileOverride): boolean {\n    78\t  return (\n    79\t    entry.lowerBound !== undefined &&\n    80\t    entry.percentages !== undefined &&\n    81\t    BAND_KEYS.every((key) => entry.percentages?.[key] !== undefined)\n    82\t  );\n    83\t}\n    84\t\n    85\t// Merge one configured entry: field-wise over the built-in it names, or — for\n    86\t// a name no built-in carries — the entry must be complete, since there is\n    87\t// nothing to merge over (FC-0.2's unknown-built-in-override-target violation).\n    88\tfunction mergeProfile(entry: ViewProfileOverride, base: ViewProfile | undefined): ViewProfile {\n    89\t  if (base === undefined) {\n    90\t    if (!isCompleteOverride(entry)) {\n    91\t      fail(\n    92\t        `profile \"${entry.name}\" is partial but overrides no built-in (unknown built-in override target); built-ins are ${BUILT_IN_PROFILES.map((p) => `\"${p.name}\"`).join(\", \")} — a new profile must carry lowerBound and all four percentages`,\n    93\t      );\n    94\t    }\n    95\t    return {\n    96\t      name: entry.name,\n    97\t      lowerBound: entry.lowerBound as number,\n    98\t      percentages: {\n    99\t        full: entry.percentages?.full as number,\n   100\t        smooth: entry.percentages?.smooth as number,\n   101\t        detailed: entry.percentages?.detailed as number,\n   102\t        brief: entry.percentages?.brief as number,\n   103\t      },\n   104\t    };\n   105\t  }\n   106\t  return {\n   107\t    name: entry.name,\n   108\t    lowerBound: entry.lowerBound ?? base.lowerBound,\n   109\t    percentages: {\n   110\t      full: entry.percentages?.full ?? base.percentages.full,\n   111\t      smooth: entry.percentages?.smooth ?? base.percentages.smooth,\n   112\t      detailed: entry.percentages?.detailed ?? base.percentages.detailed,\n   113\t      brief: entry.percentages?.brief ?? base.percentages.brief,\n   114\t    },\n   115\t  };\n   116\t}\n   117\t\n   118\tconst BUDGET_KEYS = [\"maxTokens\", \"targetTokens\"] as const;\n   119\t\n   120\tfunction resolveVisibility(partial: Partial<VisibilityBudgets> | undefined): VisibilityBudgets {\n   121\t  // Unknown budget fields are config mistakes, not silent passengers — the\n   122\t  // retired floorTokens in particular must be rejected, never quietly carried\n   123\t  // (Epic 05 AC-5.4: no hidden floor fallback).\n   124\t  for (const key of Object.keys(partial ?? {})) {\n   125\t    if (!(BUDGET_KEYS as readonly string[]).includes(key)) {\n   126\t      fail(\n   127\t        `visibility.${key} is not a budget field (budgets are maxTokens and targetTokens; floorTokens was retired by Epic 05)`,\n   128\t      );\n   129\t    }\n   130\t  }\n   131\t  const visibility: VisibilityBudgets = {\n   132\t    maxTokens: partial?.maxTokens ?? DEFAULT_VISIBILITY.maxTokens,\n   133\t    targetTokens: partial?.targetTokens ?? DEFAULT_VISIBILITY.targetTokens,\n   134\t  };\n   135\t  for (const key of BUDGET_KEYS) {\n   136\t    if (!Number.isFinite(visibility[key]) || visibility[key] <= 0) {\n   137\t      fail(`visibility.${key} must be a positive number, got ${visibility[key]}`);\n   138\t    }\n   139\t  }\n   140\t  // The budget ordering rule (Epic 05 AC-5.4): max > target.\n   141\t  if (visibility.maxTokens <= visibility.targetTokens) {\n   142\t    fail(\n   143\t      `visibility.maxTokens (${visibility.maxTokens}) must be greater than targetTokens (${visibility.targetTokens})`,\n   144\t    );\n   145\t  }\n   146\t  return visibility;\n   147\t}\n   148\t\n   149\t// The one resolution path: built-ins, user profiles merged by name, every\n   150\t// resolved profile validated, visibility and threshold defaulted and checked.\n   151\t// Called from createSdk so validation runs through real construction, never a\n   152\t// standalone validator (Story 0 production-path proof).\n   153\texport function resolveViewConfig(config?: SdkViewConfig): ResolvedViewConfig {\n   154\t  const profiles: Record<string, ViewProfile> = {};\n   155\t  for (const builtIn of BUILT_IN_PROFILES) {\n   156\t    profiles[builtIn.name] = builtIn;\n   157\t  }\n   158\t  for (const entry of config?.profiles ?? []) {\n   159\t    if (typeof entry.name !== \"string\" || entry.name.length === 0) {\n   160\t      fail(`profile entries must carry a non-empty name`);\n   161\t    }\n   162\t    profiles[entry.name] = mergeProfile(entry, profiles[entry.name]);\n   163\t  }\n   164\t  for (const profile of Object.values(profiles)) {\n   165\t    validateProfile(profile);\n   166\t  }\n   167\t\n   168\t  const compactThreshold = config?.compactThreshold ?? DEFAULT_COMPACT_THRESHOLD;\n   169\t  if (!Number.isFinite(compactThreshold) || compactThreshold <= 0) {\n   170\t    fail(`compactThreshold must be a positive number, got ${compactThreshold}`);\n   171\t  }\n   172\t\n   173\t  return {\n   174\t    profiles,\n   175\t    visibility: resolveVisibility(config?.visibility),\n   176\t    compactThreshold,\n   177\t  };\n   178\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n     2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n     3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n     4\t// Stories 3–5 extend the same per-event walk with projection, turn\n     5\t// transitions, and work queueing.\n     6\timport { existsSync } from \"node:fs\";\n     7\timport type { DatabaseSync } from \"node:sqlite\";\n     8\timport {\n     9\t  createCommitHooks,\n    10\t  resolveInstancePoke,\n    11\t  type OperationContext,\n    12\t} from \"../../../shared/context.js\";\n    13\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n    14\timport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n    15\timport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\n    16\t// The sanctioned intake→thread-view surface import (Epic 03 Flow 4, named in\n    17\t// check-boundaries): the boundary-advance registration below, nothing else.\n    18\t// This is the domain graph's first surface-level cycle (intake → thread-view\n    19\t// → messages ← intake) — runtime-safe because thread-view never imports\n    20\t// intake-stream at runtime and the registration executes only at flush.\n    21\timport { runPostCommitBoundaryAdvance } from \"../../thread-view/index.js\";\n    22\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n    23\timport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\n    24\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n    25\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n    26\t\n    27\t// Test seam (set only through test/fixtures): called after each event is\n    28\t// processed inside the walk, so atomicity under mid-walk failure can be\n    29\t// induced through a real mechanism — closing the handle — rather than a\n    30\t// mocked transaction object.\n    31\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n    32\tlet walkHook: IntakeWalkHook | null = null;\n    33\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n    34\t  walkHook = hook;\n    35\t}\n    36\t\n    37\t// Test seam (set only through test/fixtures): replaces the wall clock so\n    38\t// recordedAt is sourced deterministically for the public SDK contract proof —\n    39\t// TC-1.4 records the same batch through both reference forms and reads it back\n    40\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n    41\t// production: recording stamps real wall time. An explicit clock argument to\n    42\t// runMessageEvents still wins over the seam.\n    43\tlet injectedClock: (() => Date) | null = null;\n    44\texport function setIntakeClock(clock: (() => Date) | null): void {\n    45\t  injectedClock = clock;\n    46\t}\n    47\t\n    48\tfunction detail(cause: unknown): string {\n    49\t  return cause instanceof Error ? cause.message : String(cause);\n    50\t}\n    51\t\n    52\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    53\t  return {\n    54\t    ok: false,\n    55\t    error: {\n    56\t      errorClass: \"caller_error\",\n    57\t      code: \"thread_not_found\",\n    58\t      reason: `no thread file exists at ${filePath}`,\n    59\t    },\n    60\t  };\n    61\t}\n    62\t\n    63\t// The skip set is read at transaction start and reads only the key column:\n    64\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n    65\t// Chunked to stay under SQLite's bound-parameter limit.\n    66\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n    67\t  const found = new Set<string>();\n    68\t  for (let offset = 0; offset < keys.length; offset += 400) {\n    69\t    const chunk = keys.slice(offset, offset + 400);\n    70\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n    71\t    const rows = db\n    72\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n    73\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    74\t    for (const row of rows) found.add(row.idempotency_key);\n    75\t  }\n    76\t  return found;\n    77\t}\n    78\t\n    79\tfunction threadIdOf(db: DatabaseSync): string {\n    80\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    81\t    | { thread_id: string }\n    82\t    | undefined;\n    83\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n    84\t  return row.thread_id;\n    85\t}\n    86\t\n    87\tfunction maxEventOrder(db: DatabaseSync): number {\n    88\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    89\t    | { max_order: number | bigint | null }\n    90\t    | undefined;\n    91\t  return Number(row?.max_order ?? 0);\n    92\t}\n    93\t\n    94\texport async function runMessageEvents(\n    95\t  thread: ThreadRef,\n    96\t  events: readonly MessageEventInput[],\n    97\t  clock: () => Date = injectedClock ?? (() => new Date()),\n    98\t): Promise<OpResult<BatchResult>> {\n    99\t  // Pure validation first: a rejected batch never opens the file, never takes\n   100\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n   101\t  // not a skip (validation-before-idempotency precedence).\n   102\t  const refFailure = validateThreadRef(thread);\n   103\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n   104\t  const batchFailure = validateEvents(events);\n   105\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n   106\t\n   107\t  const resolved = await resolveThreadRef(thread);\n   108\t  if (!resolved.ok) return resolved;\n   109\t  const { filePath } = resolved.value;\n   110\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   111\t\n   112\t  // openThreadDatabase verifies the file is a real thread file, then brings\n   113\t  // its schema to the current version before the batch transaction begins,\n   114\t  // so a thread recorded under an earlier story is writable here (F-03-001)\n   115\t  // and a non-thread file is rejected unmutated (F-03-002).\n   116\t  const opened = openThreadDatabase(filePath);\n   117\t  if (!opened.ok) return opened;\n   118\t  const db = opened.value;\n   119\t\n   120\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n   121\t  // single-writer violations fail loudly at a defined point.\n   122\t  let inTransaction = false;\n   123\t  try {\n   124\t    db.exec(\"BEGIN IMMEDIATE;\");\n   125\t    inTransaction = true;\n   126\t\n   127\t    // Cross-domain calls inside the transaction share the open handle through\n   128\t    // the operation context (design decision 8); built once per batch, never\n   129\t    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n   130\t    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n   131\t    // so they drop with the transaction.\n   132\t    const hooks = createCommitHooks();\n   133\t    const ctx: OperationContext = {\n   134\t      db,\n   135\t      clock,\n   136\t      threadId: threadIdOf(db),\n   137\t      onCommit: hooks.register,\n   138\t      poke: resolveInstancePoke(),\n   139\t    };\n   140\t\n   141\t    // The boundary-advance registration (Epic 03 Flow 4, AC-4.9; trigger\n   142\t    // gated by Epic 05 AC-5.1): registered FIRST so the flush runs it before\n   143\t    // any queue poke the walk's enqueues register — advance first, poke\n   144\t    // second, the pinned order. It runs in both host modes (deterministic and\n   145\t    // cheap, unlike the mode-gated drain). Throw-isolated: a failing advance\n   146\t    // is caught and diagnosed here, never thrown into the flush — it cannot\n   147\t    // eat the pokes behind it and cannot reach this batch's caller; intake's\n   148\t    // outcome never depends on it. The boundary is then unchanged and the\n   149\t    // over-budget condition stays visible in status (computed live); the next\n   150\t    // turn-end batch's check heals.\n   151\t    //\n   152\t    // The gate (Epic 05 DD-9): the advance check runs only when this batch\n   153\t    // COMMITS a turn_end event. The registration site, ordering, and throw\n   154\t    // isolation are untouched — the callback consults a flag the walk below\n   155\t    // sets when it records a turn_end (skipped duplicates never set it, so a\n   156\t    // resent turn_end alone triggers nothing). Mid-turn batches therefore\n   157\t    // never move the boundary regardless of zone size.\n   158\t    let batchCommittedTurnEnd = false;\n   159\t    ctx.onCommit(() => {\n   160\t      if (!batchCommittedTurnEnd) return;\n   161\t      try {\n   162\t        runPostCommitBoundaryAdvance(ctx);\n   163\t      } catch (cause) {\n   164\t        process.stderr.write(\n   165\t          `lhc: boundary advance failed after intake commit (boundary unchanged; condition visible in view status): ${detail(cause)}\\n`,\n   166\t        );\n   167\t      }\n   168\t    });\n   169\t\n   170\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n   171\t    // any event is processed — once is sufficient because only this pipeline\n   172\t    // writes turn state and the write lock is already held, so more than one\n   173\t    // open turn can only mean external interference. The batch records\n   174\t    // nothing: nothing has been written yet, and the rollback closes the\n   175\t    // never-used transaction.\n   176\t    const openTurnIds = listOpenTurnIds(ctx);\n   177\t    if (openTurnIds.length > 1) {\n   178\t      db.exec(\"ROLLBACK;\");\n   179\t      inTransaction = false;\n   180\t      return {\n   181\t        ok: false,\n   182\t        error: {\n   183\t          errorClass: \"state_corruption\",\n   184\t          code: \"turn_state_corrupt\",\n   185\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n   186\t        },\n   187\t      };\n   188\t    }\n   189\t\n   190\t    const skipSet = recordedKeys(\n   191\t      db,\n   192\t      events.map((event) => event.idempotencyKey),\n   193\t    );\n   194\t    // Order counter from MAX(event_order): only recorded events increment it,\n   195\t    // so skips consume no order numbers and the sequence stays dense.\n   196\t    let lastOrder = maxEventOrder(db);\n   197\t\n   198\t    const insert = db.prepare(\n   199\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   200\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   201\t    );\n   202\t\n   203\t    const eventResults: BatchResult[\"events\"] = [];\n   204\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n   205\t    // Work items append as they queue, in walk order — the result is a\n   206\t    // faithful log of what the transaction did (AC-2.7). The full records\n   207\t    // (status, queuedAt) stay in the thread file; the result carries item\n   208\t    // identity only.\n   209\t    const queuedItems: WorkItemRecord[] = [];\n   210\t    for (const [index, event] of events.entries()) {\n   211\t      if (skipSet.has(event.idempotencyKey)) {\n   212\t        eventResults.push({\n   213\t          idempotencyKey: event.idempotencyKey,\n   214\t          outcome: \"skipped\",\n   215\t          skipReason: \"duplicate_idempotency_key\",\n   216\t        });\n   217\t      } else {\n   218\t        lastOrder += 1;\n   219\t        if (event.eventKind === \"turn_end\") batchCommittedTurnEnd = true;\n   220\t        const recordedAt = clock().toISOString();\n   221\t        insert.run(\n   222\t          lastOrder,\n   223\t          event.eventKind,\n   224\t          event.idempotencyKey,\n   225\t          event.actor,\n   226\t          event.harness,\n   227\t          JSON.stringify(event.payload),\n   228\t          recordedAt,\n   229\t        );\n   230\t        skipSet.add(event.idempotencyKey);\n   231\t        // Turn transition before projection — the order is load-bearing: a\n   232\t        // prompt transitions first and stamps to the turn it just opened\n   233\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n   234\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n   235\t        // call, so a resend causes no transition (TC-5.4).\n   236\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n   237\t        turnTransitions.push(...turnOutcome.transitions);\n   238\t        queuedItems.push(...turnOutcome.queuedWork);\n   239\t        // Projection runs in the same iteration that recorded the event, so\n   240\t        // it can never drift from its source; a projection failure throws\n   241\t        // and rejects the whole batch. Skipped events never reach this call\n   242\t        // (no duplicate message, AC-5.4).\n   243\t        const created = createFromEvent(\n   244\t          ctx,\n   245\t          {\n   246\t            ...event,\n   247\t            eventOrder: lastOrder,\n   248\t            recordedAt,\n   249\t          },\n   250\t          turnOutcome.openTurnId,\n   251\t        );\n   252\t        // Message-owned work queues in the same iteration, gated on\n   253\t        // recorded: a skipped event never reaches this call, so it queues\n   254\t        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n   255\t        // decides which messages are derivation sources (AC-2.8).\n   256\t        queuedItems.push(...queueMessageWork(ctx, created));\n   257\t        const entry: BatchResult[\"events\"][number] = {\n   258\t          idempotencyKey: event.idempotencyKey,\n   259\t          outcome: \"recorded\",\n   260\t        };\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/boundary.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Visibility boundary (Epic 03 Stories 1 + 4, decision reshaped by Epic 05\n     2\t// Story 6). The boundary is a source event order shared with the compact\n     3\t// point's coordinate system; tool results at-or-behind it render short. Its\n     4\t// writers are exactly two: the post-commit advance below — gated by intake\n     5\t// to turn-end batches since Epic 05 — and compact's reset, which lands\n     6\t// inside compact's own transaction (snapshot.ts, Story 2).\n     7\timport type { DatabaseSync } from \"node:sqlite\";\n     8\timport type { VisibilityBudgets } from \"../../../shared/view.js\";\n     9\t\n    10\t// The singleton row exists from migration v6 on (seeded at position 0,\n    11\t// everything full). A missing row is a damaged thread file, surfaced as a\n    12\t// throw for the operation boundary's storage_failure wrap.\n    13\texport function readBoundaryPosition(db: DatabaseSync): number {\n    14\t  const row = db\n    15\t    .prepare(`SELECT position FROM view_boundary WHERE thread_singleton = 1`)\n    16\t    .get() as { position: number | bigint } | undefined;\n    17\t  if (row === undefined) {\n    18\t    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\n    19\t  }\n    20\t  return Number(row.position);\n    21\t}\n    22\t\n    23\t// The visibility zone's token sum: live (deleted-filtered) tool results ahead\n    24\t// of both the boundary position and the compact point, one indexed query.\n    25\t// Parameterized by position on purpose (story Technical Notes): Story 4's\n    26\t// advance consumes this same function instead of re-deriving the sum, so\n    27\t// \"the advance's sum equals what status reports\" is structural — the design\n    28\t// requires the two sums equal, and sharing the query makes that a fact of\n    29\t// the code rather than a discipline.\n    30\texport function visibilityZoneTokens(\n    31\t  db: DatabaseSync,\n    32\t  position: number,\n    33\t  compactPoint: number,\n    34\t): number {\n    35\t  const row = db\n    36\t    .prepare(\n    37\t      `SELECT COALESCE(SUM(token_estimate), 0) AS zone FROM message\n    38\t       WHERE kind = 'tool_result' AND deleted_at IS NULL\n    39\t         AND source_event_order > ? AND source_event_order > ?`,\n    40\t    )\n    41\t    .get(position, compactPoint) as { zone: number | bigint };\n    42\t  return Number(row.zone);\n    43\t}\n    44\t\n    45\t// ── the post-commit advance (Story 4, AC-4.3–4.6, 4.9) ───────────\n    46\t\n    47\t// The compact point for the advance's zone predicate: the stored view's, or\n    48\t// the zero origin when the thread has never compacted — the same default the\n    49\t// pull uses, read without dragging band bytes along.\n    50\tfunction readCompactPoint(db: DatabaseSync): number {\n    51\t  const row = db\n    52\t    .prepare(`SELECT compact_point FROM thread_view WHERE singleton = 1`)\n    53\t    .get() as { compact_point: number | bigint } | undefined;\n    54\t  return row === undefined ? 0 : Number(row.compact_point);\n    55\t}\n    56\t\n    57\t// One zone member as the decision walks it. Rows come back oldest-first by\n    58\t// source event order — the flip order AC-4.3 pins. turn_id carries the\n    59\t// whole-turn grouping key (Epic 05 AC-5.2); NULL means turnless intake.\n    60\texport interface ZoneToolResult {\n    61\t  sourceEventOrder: number;\n    62\t  tokenEstimate: number;\n    63\t  turnId: string | null;\n    64\t}\n    65\t\n    66\t// The zone's member rows: the same population visibilityZoneTokens sums —\n    67\t// identical WHERE clause on purpose, so the decision's arithmetic and the\n    68\t// status read's sum can never diverge (story Technical Notes; the amended\n    69\t// boundary suite's status assertions are the canary).\n    70\tfunction readZoneToolResults(\n    71\t  db: DatabaseSync,\n    72\t  position: number,\n    73\t  compactPoint: number,\n    74\t): ZoneToolResult[] {\n    75\t  const rows = db\n    76\t    .prepare(\n    77\t      `SELECT source_event_order, token_estimate, turn_id FROM message\n    78\t       WHERE kind = 'tool_result' AND deleted_at IS NULL\n    79\t         AND source_event_order > ? AND source_event_order > ?\n    80\t       ORDER BY source_event_order`,\n    81\t    )\n    82\t    .all(position, compactPoint) as unknown as Array<{\n    83\t    source_event_order: number | bigint;\n    84\t    token_estimate: number | bigint;\n    85\t    turn_id: string | null;\n    86\t  }>;\n    87\t  return rows.map((row) => ({\n    88\t    sourceEventOrder: Number(row.source_event_order),\n    89\t    tokenEstimate: Number(row.token_estimate),\n    90\t    turnId: row.turn_id,\n    91\t  }));\n    92\t}\n    93\t\n    94\t// The open turn, if any, read for eviction candidacy: its tool results count\n    95\t// in the zone sum (status must show a mid-turn over-budget condition) but its\n    96\t// group can never be evicted. With the turn-end trigger this is normally\n    97\t// vacuous — the just-closed turn left nothing open — but a batch may legally\n    98\t// record a turn_end and then open a new turn with tool results before\n    99\t// committing, and that open turn must not be eaten (Epic 05 AC-5.3's\n   100\t// open-turn untouchability, made explicit rather than assumed).\n   101\tfunction readOpenTurnId(db: DatabaseSync): string | null {\n   102\t  const row = db\n   103\t    .prepare(`SELECT turn_id FROM turns WHERE status = 'open' AND deleted_at IS NULL LIMIT 1`)\n   104\t    .get() as { turn_id: string } | undefined;\n   105\t  return row?.turn_id ?? null;\n   106\t}\n   107\t\n   108\t// One whole-turn eviction unit (Epic 05 DD-10): consecutive zone rows sharing\n   109\t// a turn_id. A NULL turn_id row is its own singleton group — whole-turn\n   110\t// semantics degenerate to whole-message for messages belonging to no turn.\n   111\texport interface ZoneTurnGroup {\n   112\t  turnId: string | null;\n   113\t  tokenSum: number;\n   114\t  // Highest source_event_order in the group: the boundary position an\n   115\t  // eviction of this group lands on.\n   116\t  lastSourceEventOrder: number;\n   117\t}\n   118\t\n   119\texport function groupZone(zone: readonly ZoneToolResult[]): ZoneTurnGroup[] {\n   120\t  const groups: ZoneTurnGroup[] = [];\n   121\t  for (const result of zone) {\n   122\t    const current = groups[groups.length - 1];\n   123\t    if (current !== undefined && current.turnId !== null && current.turnId === result.turnId) {\n   124\t      current.tokenSum += result.tokenEstimate;\n   125\t      current.lastSourceEventOrder = result.sourceEventOrder;\n   126\t    } else {\n   127\t      groups.push({\n   128\t        turnId: result.turnId,\n   129\t        tokenSum: result.tokenEstimate,\n   130\t        lastSourceEventOrder: result.sourceEventOrder,\n   131\t      });\n   132\t    }\n   133\t  }\n   134\t  return groups;\n   135\t}\n   136\t\n   137\t// The pure decision (Epic 05 tech design §Flow 5): token sums from stored\n   138\t// per-message estimates, no inference, no IO — same inputs, same answer\n   139\t// (AC-5.5 determinism; the re-cut Boundary G1 golden drives the arithmetic,\n   140\t// golden G2 the peek-ahead landing).\n   141\t//\n   142\t// Zone is the turn-grouped tool results oldest-first. Under-or-at max the\n   143\t// boundary does not move. Over max, walk candidate groups oldest-first — the\n   144\t// open turn's group (when one exists) is never a candidate, and the walk stops\n   145\t// before the newest closed turn so that turn and everything after it (any\n   146\t// trailing turnless singletons recorded after its close) are never evicted\n   147\t// (AC-5.3: the newest closed turn is never evicted). The boundary lands on a\n   148\t// group's last source event order, so an eviction reaching the newest closed\n   149\t// turn — or any group past it — would render that turn short; stopping before\n   150\t// it keeps it intact even when a later turnless singleton sits in the zone.\n   151\t// With no closed turn present the newest remaining group is protected instead\n   152\t// (whole-message degeneration for a turnless-only zone). A group is evicted\n   153\t// only if the zone's sum after evicting it remains at-or-above target (the\n   154\t// peek-ahead stop). The advance therefore lands in [target, target + one\n   155\t// group), and the zone may legally sit above target or even max until a newer\n   156\t// turn closes or a compact creates room.\n   157\texport function advanceDecision(\n   158\t  groups: readonly ZoneTurnGroup[],\n   159\t  budgets: VisibilityBudgets,\n   160\t  openTurnId: string | null,\n   161\t): number | null {\n   162\t  let total = 0;\n   163\t  for (const group of groups) total += group.tokenSum;\n   164\t  if (total <= budgets.maxTokens) return null;\n   165\t\n   166\t  // The open turn's group is never evictable; its tokens still count in the sum.\n   167\t  const candidates = groups.filter(\n   168\t    (group) => group.turnId === null || group.turnId !== openTurnId,\n   169\t  );\n   170\t\n   171\t  // Stop the walk before the newest closed turn — the last candidate carrying a\n   172\t  // turn_id. It and everything after it (the turn itself plus any trailing\n   173\t  // turnless singletons) are protected: the boundary lands on a group's last\n   174\t  // order, so any landing there or beyond would flip the newest closed turn\n   175\t  // short. With no closed turn in the zone, fall back to protecting the newest\n   176\t  // candidate group (the turnless-only whole-message behavior).\n   177\t  let stop = candidates.length - 1;\n   178\t  for (let i = candidates.length - 1; i >= 0; i -= 1) {\n   179\t    if (candidates[i]?.turnId !== null) {\n   180\t      stop = i;\n   181\t      break;\n   182\t    }\n   183\t  }\n   184\t\n   185\t  let remaining = total;\n   186\t  let newPosition: number | null = null;\n   187\t  for (let i = 0; i < stop; i += 1) {\n   188\t    const group = candidates[i];\n   189\t    if (group === undefined) break;\n   190\t    if (remaining - group.tokenSum < budgets.targetTokens) break;\n   191\t    remaining -= group.tokenSum;\n   192\t    newPosition = group.lastSourceEventOrder;\n   193\t  }\n   194\t  return newPosition;\n   195\t}\n   196\t\n   197\t// The advance executor: indexed sum → over max ⇒ decide → write the new\n   198\t// position in its own short transaction (never inside intake's — AC-4.9's\n   199\t// isolation; this runs at flush, strictly after intake's COMMIT). The\n   200\t// position-forward guard in the UPDATE makes never-backward (AC-4.6) a\n   201\t// property of the write, not just of the decision's inputs.\n   202\texport function executeBoundaryAdvance(\n   203\t  db: DatabaseSync,\n   204\t  budgets: VisibilityBudgets,\n   205\t  clock: () => Date,\n   206\t): void {\n   207\t  const position = readBoundaryPosition(db);\n   208\t  const compactPoint = readCompactPoint(db);\n   209\t  if (visibilityZoneTokens(db, position, compactPoint) <= budgets.maxTokens) return;\n   210\t\n   211\t  const zone = readZoneToolResults(db, position, compactPoint);\n   212\t  const newPosition = advanceDecision(groupZone(zone), budgets, readOpenTurnId(db));\n   213\t  if (newPosition === null || newPosition <= position) return;\n   214\t\n   215\t  db.exec(\"BEGIN IMMEDIATE;\");\n   216\t  try {\n   217\t    db.prepare(\n   218\t      `UPDATE view_boundary SET position = ?, updated_at = ?\n   219\t       WHERE thread_singleton = 1 AND position < ?`,\n   220\t    ).run(newPosition, clock().toISOString(), newPosition);\n   221\t    db.exec(\"COMMIT;\");\n   222\t  } catch (cause) {\n   223\t    db.exec(\"ROLLBACK;\");\n   224\t    throw cause;\n   225\t  }\n   226\t}\n","exit_code":0,"status":"completed"}}

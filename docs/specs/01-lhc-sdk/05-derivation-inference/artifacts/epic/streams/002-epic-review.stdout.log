s/006-verify.stdout.log:31:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/types.ts'\",\"aggregated_output\":\"     1\\t// Epic 05 boundary vocabulary (tech design §Interface Definitions): the one\\n     2\\t// function a host supplies, its structured result shapes, and the config that\\n     3\\t// arrives at createSdk as the alternative to direct provider injection\\n     4\\t// (DD-1, DD-5). LHC treats provider/model strings as opaque routing keys —\\n     5\\t// the host's ModelCall implementation is the only code that interprets them.\\n     6\\timport type { FormKind } from \\\"../shared/derivation.js\\\";\\n     7\\t\\n     8\\t/** The one function a host supplies. Single-turn completion; provider/model\\n     9\\t *  are opaque routing keys the host's implementation interprets. (AC-1.2) */\\n    10\\texport type ModelCall = (input: ModelCallInput) => Promise<ModelCallResult>;\\n    11\\t\\n    12\\texport interface ModelCallInput {\\n    13\\t  provider: string;\\n    14\\t  model: string;\\n    15\\t  messages: { role: \\\"system\\\" | \\\"user\\\"; content: string }[];\\n    16\\t}\\n    17\\t\\n    18\\texport type ModelCallResult =\\n    19\\t  | { ok: true; text: string }\\n    20\\t  | { ok: false; kind: ModelCallFailureKind; message: string };\\n    21\\t\\n    22\\t/** `empty_output` is adapter-generated (AC-2.4); hosts never return it.\\n    23\\t *  Thrown exceptions classify as `other` (AC-3.3). */\\n    24\\texport type ModelCallFailureKind =\\n    25\\t  | \\\"rate_limit\\\"\\n    26\\t  | \\\"timeout\\\"\\n    27\\t  | \\\"network\\\"\\n    28\\t  | \\\"empty_output\\\"\\n    29\\t  | \\\"other\\\"\\n    30\\t  | \\\"auth\\\"\\n    31\\t  | \\\"invalid_request\\\";\\n    32\\t\\n    33\\texport interface ModelAssignment {\\n    34\\t  provider: string;\\n    35\\t  model: string;\\n    36\\t  prompt: string; // must name a PROMPT_REGISTRY entry (AC-1.3)\\n    37\\t}\\n    38\\t\\n    39\\t/** SdkConfig.inference — the alternative to SdkConfig.provider (DD-5). */\\n    40\\texport interface InferenceConfig {\\n    41\\t  call: ModelCall;\\n    42\\t  assignments: Record<FormKind, ModelAssignment>; // all seven, validated complete\\n    43\\t  timeoutMs?: number; // default 60_000 (DD-6)\\n    44\\t  maxInputChars?: number; // default 200_000 (DD-7)\\n    45\\t}\\n    46\\t\\n    47\\t/** InferenceConfig after createSdk validation: every optional filled. */\\n    48\\texport interface ResolvedInferenceConfig {\\n    49\\t  call: ModelCall;\\n    50\\t  assignments: Record<FormKind, ModelAssignment>;\\n    51\\t  timeoutMs: number;\\n    52\\t  maxInputChars: number;\\n    53\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:32:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/adapter.ts'\",\"aggregated_output\":\"     1\\t// The real provider (DD-2): createInferenceProvider returns the same\\n     2\\t// DerivationProvider interface the deterministic provider implements, so\\n     3\\t// createSdk and everything below it see a provider, full stop. Each operation\\n     4\\t// is one closure lookup at call time — the kind's assignment names the\\n     5\\t// provider/model routing keys and the prompt template; the host's ModelCall\\n     6\\t// is the only code that crosses the transport boundary (AC-1.2, AC-1.4).\\n     7\\t// Output shaping (empty-output rejection, input bounding) and the safeCall\\n     8\\t// timeout land with the adapter/classification stories; routing and result\\n     9\\t// mapping are complete here.\\n    10\\timport type {\\n    11\\t  DerivationProvider,\\n    12\\t  FormKind,\\n    13\\t  ProviderResult,\\n    14\\t} from \\\"../shared/derivation.js\\\";\\n    15\\timport { FAILURE_CLASSIFICATION } from \\\"./classify.js\\\";\\n    16\\timport { PROMPT_REGISTRY, type PromptTemplate } from \\\"./prompts/index.js\\\";\\n    17\\timport type { ModelCallResult, ResolvedInferenceConfig } from \\\"./types.js\\\";\\n    18\\t\\n    19\\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\\n    20\\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\\n    21\\t    const assignment = config.assignments[kind];\\n    22\\t    // Construction validated the name (AC-1.3); a miss here is registry\\n    23\\t    // drift after construction and is terminal, never retried into.\\n    24\\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\\n    25\\t    if (template === undefined) {\\n    26\\t      return {\\n    27\\t        ok: false,\\n    28\\t        retryable: false,\\n    29\\t        reason: `invalid_request: prompt template \\\"${assignment.prompt}\\\" not in registry`,\\n    30\\t      };\\n    31\\t    }\\n    32\\t    const messages = template.render(input);\\n    33\\t    let result: ModelCallResult;\\n    34\\t    try {\\n    35\\t      result = await config.call({\\n    36\\t        provider: assignment.provider,\\n    37\\t        model: assignment.model,\\n    38\\t        messages,\\n    39\\t      });\\n    40\\t    } catch (cause) {\\n    41\\t      // Thrown host exceptions classify as `other` (AC-3.3); the structured\\n    42\\t      // safeCall wrapper (timeout race, DD-6) supersedes this containment in\\n    43\\t      // the classification story.\\n    44\\t      result = { ok: false, kind: \\\"other\\\", message: String(cause) };\\n    45\\t    }\\n    46\\t    if (!result.ok) {\\n    47\\t      return {\\n    48\\t        ok: false,\\n    49\\t        retryable: FAILURE_CLASSIFICATION[result.kind].retryable,\\n    50\\t        // The kind string leads the reason — stable and machine-readable\\n    51\\t        // (DD-3) — with the host's message carried for the audit trail.\\n    52\\t        reason: result.message === \\\"\\\" ? result.kind : `${result.kind}: ${result.message}`,\\n    53\\t      };\\n    54\\t    }\\n    55\\t    // Provenance is the assignment's three config-known strings, copied —\\n    56\\t    // never authored from model output (DD-4).\\n    57\\t    return {\\n    58\\t      ok: true,\\n    59\\t      text: result.text,\\n    60\\t      provenance: {\\n    61\\t        provider: assignment.provider,\\n    62\\t        model: assignment.model,\\n    63\\t        prompt: assignment.prompt,\\n    64\\t      },\\n    65\\t    };\\n    66\\t  };\\n    67\\t\\n    68\\t  return {\\n    69\\t    smoothPrompt: (i) => callKind(\\\"smoothed_prompt\\\", i),\\n    70\\t    summarizeToolCall: (i) => callKind(\\\"tool_call_summary\\\", i),\\n    71\\t    summarizeToolResult: (i) => callKind(\\\"tool_result_summary\\\", i),\\n    72\\t    composeTurnRendering: (i) => callKind(\\\"turn_rendering\\\", i),\\n    73\\t    projectLowerBand: (i) => callKind(\\\"lower_band_projection\\\", i),\\n    74\\t    summarizeChunkDetailed: (i) => callKind(\\\"chunk_summary_detailed\\\", i),\\n    75\\t    summarizeChunkBrief: (i) => callKind(\\\"chunk_summary_brief\\\", i),\\n    76\\t  };\\n    77\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:33:{\"type\":\"item.started\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/classify.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:34:{\"type\":\"item.started\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/prompts/index.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:35:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/classify.ts'\",\"aggregated_output\":\"     1\\t// Failure classification (DD-3): a pure table from the boundary's failure\\n     2\\t// vocabulary onto Epic 02's retryable-or-not. The queue machinery consumes\\n     3\\t// `retryable` exactly as it always has — no queue changes, no new states.\\n     4\\t// `safeCall` (timeout race + thrown-exception containment, DD-6/AC-3.3)\\n     5\\t// lands with the classification story; the adapter's inline containment is\\n     6\\t// the construction-time minimum until then.\\n     7\\timport type { ModelCallFailureKind } from \\\"./types.js\\\";\\n     8\\t\\n     9\\texport const FAILURE_CLASSIFICATION: Record<ModelCallFailureKind, { retryable: boolean }> = {\\n    10\\t  rate_limit: { retryable: true },\\n    11\\t  timeout: { retryable: true },\\n    12\\t  network: { retryable: true },\\n    13\\t  empty_output: { retryable: true },\\n    14\\t  other: { retryable: true },\\n    15\\t  auth: { retryable: false },\\n    16\\t  invalid_request: { retryable: false },\\n    17\\t};\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:36:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/prompts/index.ts'\",\"aggregated_output\":\"     1\\t// The name-keyed prompt registry (DD-8): one module per template exporting\\n     2\\t// `{ name, render(input) → messages }`; config selects by name and dial-in\\n     3\\t// swaps by adding a module and editing config — no handler, adapter, or host\\n     4\\t// changes. Versioning is in the name (`smoothing-v1`).\\n     5\\timport type { FormKind } from \\\"../../shared/derivation.js\\\";\\n     6\\timport type { ModelCallInput } from \\\"../types.js\\\";\\n     7\\timport { chunkBriefV1 } from \\\"./chunk-brief-v1.js\\\";\\n     8\\timport { chunkDetailedV1 } from \\\"./chunk-detailed-v1.js\\\";\\n     9\\timport { lowerBandV1 } from \\\"./lower-band-v1.js\\\";\\n    10\\timport { smoothingV1 } from \\\"./smoothing-v1.js\\\";\\n    11\\timport { toolCallV1 } from \\\"./tool-call-v1.js\\\";\\n    12\\timport { toolResultV1 } from \\\"./tool-result-v1.js\\\";\\n    13\\timport { turnComposeV1 } from \\\"./turn-compose-v1.js\\\";\\n    14\\t\\n    15\\texport interface PromptTemplate<I = unknown> {\\n    16\\t  name: string;\\n    17\\t  render(input: I): ModelCallInput[\\\"messages\\\"];\\n    18\\t}\\n    19\\t\\n    20\\t// Every config-selectable name. `never` pins the registry read-only at the\\n    21\\t// type level — rendering goes through the adapter, which owns the only\\n    22\\t// kind→input pairing.\\n    23\\texport const PROMPT_REGISTRY: Record<string, PromptTemplate<never>> = {\\n    24\\t  [smoothingV1.name]: smoothingV1,\\n    25\\t  [toolCallV1.name]: toolCallV1,\\n    26\\t  [toolResultV1.name]: toolResultV1,\\n    27\\t  [turnComposeV1.name]: turnComposeV1,\\n    28\\t  [lowerBandV1.name]: lowerBandV1,\\n    29\\t  [chunkDetailedV1.name]: chunkDetailedV1,\\n    30\\t  [chunkBriefV1.name]: chunkBriefV1,\\n    31\\t};\\n    32\\t\\n    33\\t// The default template per kind — the seven names an operator's first config\\n    34\\t// reaches for, and what test fixtures assign.\\n    35\\texport const DEFAULT_PROMPT_NAMES: Record<FormKind, string> = {\\n    36\\t  smoothed_prompt: smoothingV1.name,\\n    37\\t  tool_call_summary: toolCallV1.name,\\n    38\\t  tool_result_summary: toolResultV1.name,\\n    39\\t  turn_rendering: turnComposeV1.name,\\n    40\\t  lower_band_projection: lowerBandV1.name,\\n    41\\t  chunk_summary_detailed: chunkDetailedV1.name,\\n    42\\t  chunk_summary_brief: chunkBriefV1.name,\\n    43\\t};\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:37:{\"type\":\"item.started\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/inference-construction.test.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:38:{\"type\":\"item.started\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/inference-routing.test.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:39:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/inference-routing.test.ts'\",\"aggregated_output\":\"     1\\t// Epic 05 Story 2 — TC-1.2 (AC-1.2, AC-1.4): per-call routing through the\\n     2\\t// inference seam. A recording fake logs every call while a seeded thread\\n     3\\t// exercises all seven kinds; the assertions inspect the actual serialized\\n     4\\t// ModelCall input emitted during the drain — never a helper-level intention\\n     5\\t// (anti-shim). The routing assertions live in the parameterized\\n     6\\t// seam-conformance helpers so TC-4.3 runs them against the real host\\n     7\\t// unchanged (DD-13).\\n     8\\timport { afterEach, describe, expect, it } from \\\"vitest\\\";\\n     9\\timport {\\n    10\\t  assertModelCallContract,\\n    11\\t  assertRoutingThroughSdk,\\n    12\\t  cannedResponses,\\n    13\\t  FAKE_MODEL_PREFIX,\\n    14\\t  FAKE_PROVIDER_PREFIX,\\n    15\\t  FORM_KINDS,\\n    16\\t  probeInput,\\n    17\\t  recordingCall,\\n    18\\t  tempStore,\\n    19\\t  validAssignments,\\n    20\\t  type TempStore,\\n    21\\t} from \\\"./fixtures/index.js\\\";\\n    22\\t\\n    23\\tconst stores: TempStore[] = [];\\n    24\\tafterEach(() => {\\n    25\\t  for (const store of stores.splice(0)) store.cleanup();\\n    26\\t});\\n    27\\t\\n    28\\tfunction freshStore(): TempStore {\\n    29\\t  const store = tempStore();\\n    30\\t  stores.push(store);\\n    31\\t  return store;\\n    32\\t}\\n    33\\t\\n    34\\tdescribe(\\\"TC-1.2: per-kind provider/model routing (AC-1.4)\\\", () => {\\n    35\\t  it(\\\"a seeded drain exercises all seven kinds, each call carrying exactly its assigned strings\\\", async () => {\\n    36\\t    const responses = cannedResponses();\\n    37\\t    const { call, log } = recordingCall(responses);\\n    38\\t    const assignments = validAssignments();\\n    39\\t    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\\n    40\\t\\n    41\\t    for (const kind of FORM_KINDS) {\\n    42\\t      const lane = log.filter((input) => input.model === `${FAKE_MODEL_PREFIX}${kind}`);\\n    43\\t      expect(lane.length).toBeGreaterThan(0);\\n    44\\t      for (const input of lane) {\\n    45\\t        expect(input.provider).toBe(`${FAKE_PROVIDER_PREFIX}${kind}`);\\n    46\\t        expect(input.model).toBe(assignments[kind].model);\\n    47\\t      }\\n    48\\t      // The landed content is the canned text the kind's lane returned —\\n    49\\t      // routing proven end to end, not just at the call log.\\n    50\\t      const ready = forms.filter((form) => form.form === kind && form.state === \\\"ready\\\");\\n    51\\t      expect(ready.length).toBeGreaterThan(0);\\n    52\\t      for (const form of ready) {\\n    53\\t        expect(form.content).toBe(responses[kind]);\\n    54\\t      }\\n    55\\t    }\\n    56\\t  });\\n    57\\t\\n    58\\t  it(\\\"every logged messages value is single-turn shape: system and user roles, string content (AC-1.2)\\\", async () => {\\n    59\\t    const { call, log } = recordingCall(cannedResponses());\\n    60\\t    await assertRoutingThroughSdk(call, validAssignments(), freshStore());\\n    61\\t\\n    62\\t    expect(log.length).toBeGreaterThan(0);\\n    63\\t    for (const input of log) {\\n    64\\t      expect(input.messages.length).toBeGreaterThan(0);\\n    65\\t      expect(input.messages.some((message) => message.role === \\\"user\\\")).toBe(true);\\n    66\\t      for (const message of input.messages) {\\n    67\\t        expect([\\\"system\\\", \\\"user\\\"]).toContain(message.role);\\n    68\\t        expect(typeof message.content).toBe(\\\"string\\\");\\n    69\\t      }\\n    70\\t    }\\n    71\\t  });\\n    72\\t\\n    73\\t  it(\\\"a three-lane mixed config routes each call by item kind with no cross-kind bleed\\\", async () => {\\n    74\\t    const lanes = {\\n    75\\t      smoothed_prompt: \\\"lane-alpha\\\",\\n    76\\t      tool_call_summary: \\\"lane-alpha\\\",\\n    77\\t      tool_result_summary: \\\"lane-beta\\\",\\n    78\\t      turn_rendering: \\\"lane-beta\\\",\\n    79\\t      lower_band_projection: \\\"lane-beta\\\",\\n    80\\t      chunk_summary_detailed: \\\"lane-gamma\\\",\\n    81\\t      chunk_summary_brief: \\\"lane-gamma\\\",\\n    82\\t    } as const;\\n    83\\t    const assignments = validAssignments({\\n    84\\t      smoothed_prompt: { provider: lanes.smoothed_prompt },\\n    85\\t      tool_call_summary: { provider: lanes.tool_call_summary },\\n    86\\t      tool_result_summary: { provider: lanes.tool_result_summary },\\n    87\\t      turn_rendering: { provider: lanes.turn_rendering },\\n    88\\t      lower_band_projection: { provider: lanes.lower_band_projection },\\n    89\\t      chunk_summary_detailed: { provider: lanes.chunk_summary_detailed },\\n    90\\t      chunk_summary_brief: { provider: lanes.chunk_summary_brief },\\n    91\\t    });\\n    92\\t    const responses = cannedResponses();\\n    93\\t    const { call, log } = recordingCall(responses);\\n    94\\t    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\\n    95\\t\\n    96\\t    for (const kind of FORM_KINDS) {\\n    97\\t      // Models stay unique per kind, so the lane each item actually used is\\n    98\\t      // readable from the log: every call for this kind's model must carry\\n    99\\t      // this kind's lane provider — no bleed from the other lanes.\\n   100\\t      const calls = log.filter((input) => input.model === assignments[kind].model);\\n   101\\t      expect(calls.length).toBeGreaterThan(0);\\n   102\\t      for (const input of calls) {\\n   103\\t        expect(input.provider).toBe(lanes[kind]);\\n   104\\t      }\\n   105\\t      const ready = forms.filter((form) => form.form === kind && form.state === \\\"ready\\\");\\n   106\\t      expect(ready.length).toBeGreaterThan(0);\\n   107\\t      for (const form of ready) {\\n   108\\t        expect(form.content).toBe(responses[kind]);\\n   109\\t      }\\n   110\\t    }\\n   111\\t  });\\n   112\\t});\\n   113\\t\\n   114\\tdescribe(\\\"TC-1.2: fake-host fixture conformance (AC-1.2)\\\", () => {\\n   115\\t  it(\\\"assertModelCallContract holds against recordingCall\\\", async () => {\\n   116\\t    const { call } = recordingCall(cannedResponses());\\n   117\\t    await assertModelCallContract(\\n   118\\t      call,\\n   119\\t      probeInput({\\n   120\\t        provider: `${FAKE_PROVIDER_PREFIX}smoothed_prompt`,\\n   121\\t        model: `${FAKE_MODEL_PREFIX}smoothed_prompt`,\\n   122\\t      }),\\n   123\\t    );\\n   124\\t  });\\n   125\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:40:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/inference-construction.test.ts'\",\"aggregated_output\":\"     1\\t// Epic 05 Story 2 — TC-1.1 (AC-1.1, AC-1.3): the construction matrix.\\n     2\\t// Construction is where every config mistake dies: provider XOR inference,\\n     3\\t// all seven kinds present (parameterized over the exported FORM_KINDS set so\\n     4\\t// a new kind fails the matrix automatically), no unknown kind keys, every\\n     5\\t// prompt name known, non-empty provider/model strings — each a TypeError\\n     6\\t// naming the violated rule, with no partial construction. A complete valid\\n     7\\t// config does not merely construct: a seeded drain lands a form ready.\\n     8\\timport { afterEach, describe, expect, it } from \\\"vitest\\\";\\n     9\\timport { createSdk, type ModelAssignment, type SdkConfig } from \\\"../src/index.js\\\";\\n    10\\timport {\\n    11\\t  cannedResponses,\\n    12\\t  createProviderDouble,\\n    13\\t  FORM_KINDS,\\n    14\\t  readDerivedForms,\\n    15\\t  recordingCall,\\n    16\\t  tempStore,\\n    17\\t  validAssignments,\\n    18\\t  validEvent,\\n    19\\t  type FormKind,\\n    20\\t  type TempStore,\\n    21\\t} from \\\"./fixtures/index.js\\\";\\n    22\\t\\n    23\\tconst stores: TempStore[] = [];\\n    24\\tafterEach(() => {\\n    25\\t  for (const store of stores.splice(0)) store.cleanup();\\n    26\\t});\\n    27\\t\\n    28\\tfunction freshStore(): TempStore {\\n    29\\t  const store = tempStore();\\n    30\\t  stores.push(store);\\n    31\\t  return store;\\n    32\\t}\\n    33\\t\\n    34\\tfunction buildSdk(assignments: unknown): () => unknown {\\n    35\\t  const { call } = recordingCall(cannedResponses());\\n    36\\t  return () =>\\n    37\\t    createSdk({\\n    38\\t      mode: \\\"manual\\\",\\n    39\\t      inference: { call, assignments },\\n    40\\t    } as unknown as SdkConfig);\\n    41\\t}\\n    42\\t\\n    43\\tdescribe(\\\"TC-1.1: provider XOR inference (AC-1.1)\\\", () => {\\n    44\\t  it(\\\"both provider and inference is a TypeError naming the XOR rule\\\", () => {\\n    45\\t    const { call } = recordingCall(cannedResponses());\\n    46\\t    const make = (): unknown =>\\n    47\\t      createSdk({\\n    48\\t        mode: \\\"manual\\\",\\n    49\\t        provider: createProviderDouble(),\\n    50\\t        inference: { call, assignments: validAssignments() },\\n    51\\t      });\\n    52\\t    expect(make).toThrow(TypeError);\\n    53\\t    expect(make).toThrow(/exactly one of provider or inference/);\\n    54\\t  });\\n    55\\t\\n    56\\t  it(\\\"neither provider nor inference is a TypeError naming the XOR rule\\\", () => {\\n    57\\t    const make = (): unknown => createSdk({ mode: \\\"manual\\\" } as unknown as SdkConfig);\\n    58\\t    expect(make).toThrow(TypeError);\\n    59\\t    expect(make).toThrow(/exactly one of provider or inference/);\\n    60\\t  });\\n    61\\t});\\n    62\\t\\n    63\\tdescribe(\\\"TC-1.1: assignment validation (AC-1.3)\\\", () => {\\n    64\\t  it.each([...FORM_KINDS])(\\\"missing kind %s is a TypeError naming the kind\\\", (kind) => {\\n    65\\t    const assignments: Partial<Record<FormKind, ModelAssignment>> = validAssignments();\\n    66\\t    delete assignments[kind];\\n    67\\t    const make = buildSdk(assignments);\\n    68\\t    expect(make).toThrow(TypeError);\\n    69\\t    expect(make).toThrow(new RegExp(`missing kind ${kind}`));\\n    70\\t  });\\n    71\\t\\n    72\\t  it(\\\"an unknown prompt name is a TypeError naming kind and prompt\\\", () => {\\n    73\\t    const assignments = validAssignments({\\n    74\\t      tool_result_summary: { prompt: \\\"tool-result-v99\\\" },\\n    75\\t    });\\n    76\\t    const make = buildSdk(assignments);\\n    77\\t    expect(make).toThrow(TypeError);\\n    78\\t    expect(make).toThrow(/tool_result_summary/);\\n    79\\t    expect(make).toThrow(/unknown template \\\"tool-result-v99\\\"/);\\n    80\\t  });\\n    81\\t\\n    82\\t  it(\\\"an unknown kind key in assignments is a TypeError naming it\\\", () => {\\n    83\\t    const assignments: Record<string, ModelAssignment> = { ...validAssignments() };\\n    84\\t    assignments[\\\"smoothed_promptz\\\"] = {\\n    85\\t      provider: \\\"prov-x\\\",\\n    86\\t      model: \\\"model-x\\\",\\n    87\\t      prompt: \\\"smoothing-v1\\\",\\n    88\\t    };\\n    89\\t    const make = buildSdk(assignments);\\n    90\\t    expect(make).toThrow(TypeError);\\n    91\\t    expect(make).toThrow(/unknown kind key \\\"smoothed_promptz\\\"/);\\n    92\\t  });\\n    93\\t\\n    94\\t  it(\\\"an empty provider string in one assignment is a TypeError naming field and kind\\\", () => {\\n    95\\t    const assignments = validAssignments({ turn_rendering: { provider: \\\"\\\" } });\\n    96\\t    const make = buildSdk(assignments);\\n    97\\t    expect(make).toThrow(TypeError);\\n    98\\t    expect(make).toThrow(/turn_rendering\\\\.provider must be a non-empty string/);\\n    99\\t  });\\n   100\\t\\n   101\\t  it(\\\"an empty model string in one assignment is a TypeError naming field and kind\\\", () => {\\n   102\\t    const assignments = validAssignments({ chunk_summary_brief: { model: \\\"  \\\" } });\\n   103\\t    const make = buildSdk(assignments);\\n   104\\t    expect(make).toThrow(TypeError);\\n   105\\t    expect(make).toThrow(/chunk_summary_brief\\\\.model must be a non-empty string/);\\n   106\\t  });\\n   107\\t});\\n   108\\t\\n   109\\tdescribe(\\\"TC-1.1: a complete valid config operates (AC-1.1, AC-1.3)\\\", () => {\\n   110\\t  it(\\\"constructs, and a seeded drain lands a form ready with the host's text\\\", async () => {\\n   111\\t    const store = freshStore();\\n   112\\t    const responses = cannedResponses();\\n   113\\t    const { call, log } = recordingCall(responses);\\n   114\\t    const sdk = createSdk({\\n   115\\t      mode: \\\"manual\\\",\\n   116\\t      inference: { call, assignments: validAssignments() },\\n   117\\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n   118\\t    });\\n   119\\t\\n   120\\t    const filePath = store.threadPath();\\n   121\\t    const created = await sdk.threads.newThread({\\n   122\\t      filePath,\\n   123\\t      registryPath: store.registryPath,\\n   124\\t    });\\n   125\\t    expect(created.ok).toBe(true);\\n   126\\t    const batch = await sdk.intakeStream.messageEvents({ filePath }, [\\n   127\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"construct me a context\\\" } }),\\n   128\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"constructing\\\" } }),\\n   129\\t      validEvent(\\\"turn_end\\\"),\\n   130\\t    ]);\\n   131\\t    expect(batch.ok).toBe(true);\\n   132\\t\\n   133\\t    const drained = await sdk.work.drain({ filePath });\\n   134\\t    expect(drained.ok).toBe(true);\\n   135\\t    if (drained.ok) {\\n   136\\t      expect(drained.value.stoppedBecause).toBe(\\\"empty\\\");\\n   137\\t      expect(drained.value.remaining).toBe(0);\\n   138\\t    }\\n   139\\t\\n   140\\t    const smoothed = readDerivedForms(filePath).find(\\n   141\\t      (form) => form.form === \\\"smoothed_prompt\\\" && form.subjectId === \\\"m1\\\",\\n   142\\t    );\\n   143\\t    expect(smoothed?.state).toBe(\\\"ready\\\");\\n   144\\t    expect(smoothed?.content).toBe(responses.smoothed_prompt);\\n   145\\t    expect(log.length).toBeGreaterThan(0);\\n   146\\t  });\\n   147\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:41:{\"type\":\"item.started\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/model-call.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:42:{\"type\":\"item.started\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/seam-conformance.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:43:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/model-call.ts'\",\"aggregated_output\":\"     1\\t// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\\n     2\\t// ModelCall implementations every Flow 1–3 test uses. These are boundary\\n     3\\t// doubles, not internal mocks — the ModelCall function is where LHC's code\\n     4\\t// ends (tech design §Testing Strategy). All builders return\\n     5\\t// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\\n     6\\t// recordingCall in its own test so fixture drift is caught by the suite.\\n     7\\timport { FORM_KINDS, type FormKind } from \\\"../../src/shared/derivation.js\\\";\\n     8\\timport { DEFAULT_PROMPT_NAMES } from \\\"../../src/inference/prompts/index.js\\\";\\n     9\\timport type {\\n    10\\t  ModelAssignment,\\n    11\\t  ModelCall,\\n    12\\t  ModelCallInput,\\n    13\\t  ModelCallResult,\\n    14\\t} from \\\"../../src/inference/types.js\\\";\\n    15\\t\\n    16\\texport { FORM_KINDS, type FormKind };\\n    17\\t\\n    18\\t// validAssignments gives every kind a distinct fake provider/model lane;\\n    19\\t// recordingCall infers the kind back from the model string, so per-kind\\n    20\\t// routing is observable from the log alone (TC-1.2).\\n    21\\texport const FAKE_PROVIDER_PREFIX = \\\"prov-\\\";\\n    22\\texport const FAKE_MODEL_PREFIX = \\\"model-\\\";\\n    23\\t\\n    24\\texport function validAssignments(\\n    25\\t  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\\n    26\\t): Record<FormKind, ModelAssignment> {\\n    27\\t  const map = {} as Record<FormKind, ModelAssignment>;\\n    28\\t  for (const kind of FORM_KINDS) {\\n    29\\t    map[kind] = {\\n    30\\t      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\\n    31\\t      model: `${FAKE_MODEL_PREFIX}${kind}`,\\n    32\\t      prompt: DEFAULT_PROMPT_NAMES[kind],\\n    33\\t      ...(overrides[kind] ?? {}),\\n    34\\t    };\\n    35\\t  }\\n    36\\t  return map;\\n    37\\t}\\n    38\\t\\n    39\\t// One distinct canned sentence per kind, so cross-kind bleed is visible in\\n    40\\t// landed form content, never just in call counts.\\n    41\\texport function cannedResponses(): Record<FormKind, string> {\\n    42\\t  const map = {} as Record<FormKind, string>;\\n    43\\t  for (const kind of FORM_KINDS) {\\n    44\\t    map[kind] = `canned ${kind} text from the fake host`;\\n    45\\t  }\\n    46\\t  return map;\\n    47\\t}\\n    48\\t\\n    49\\t// Resolves each call with its kind's canned text — the kind inferred from\\n    50\\t// the model routing key validAssignments made unique per kind. Every input\\n    51\\t// is cloned into `log` in call order. An unknown model is a test bug and\\n    52\\t// throws loudly.\\n    53\\texport function recordingCall(responses: Record<FormKind, string>): {\\n    54\\t  call: ModelCall;\\n    55\\t  log: ModelCallInput[];\\n    56\\t} {\\n    57\\t  const log: ModelCallInput[] = [];\\n    58\\t  const known = new Set<string>(FORM_KINDS);\\n    59\\t  const call: ModelCall = (input) => {\\n    60\\t    log.push(structuredClone(input));\\n    61\\t    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\\n    62\\t      ? input.model.slice(FAKE_MODEL_PREFIX.length)\\n    63\\t      : input.model;\\n    64\\t    if (!known.has(kind)) {\\n    65\\t      throw new Error(`recordingCall: no canned response for model \\\"${input.model}\\\"`);\\n    66\\t    }\\n    67\\t    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\\n    68\\t  };\\n    69\\t  return { call, log };\\n    70\\t}\\n    71\\t\\n    72\\t// Returns script entries in order; a call past the end of the script is a\\n    73\\t// test bug and throws loudly.\\n    74\\texport function scriptedCall(script: ModelCallResult[]): ModelCall {\\n    75\\t  let next = 0;\\n    76\\t  return (input) => {\\n    77\\t    const entry = script[next];\\n    78\\t    next += 1;\\n    79\\t    if (entry === undefined) {\\n    80\\t      throw new Error(\\n    81\\t        `scriptedCall: script exhausted after ${String(script.length)} calls (model \\\"${input.model}\\\")`,\\n    82\\t      );\\n    83\\t    }\\n    84\\t    return Promise.resolve(entry);\\n    85\\t  };\\n    86\\t}\\n    87\\t\\n    88\\t// A host whose function throws — the AC-3.3 containment leg.\\n    89\\texport function throwingCall(error: Error): ModelCall {\\n    90\\t  return () => Promise.reject(error);\\n    91\\t}\\n    92\\t\\n    93\\t// A host that never settles — the DD-6 timeout leg (tests pass a small\\n    94\\t// timeoutMs).\\n    95\\texport function hangingCall(): ModelCall {\\n    96\\t  return () => new Promise<ModelCallResult>(() => {});\\n    97\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:44:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/seam-conformance.ts'\",\"aggregated_output\":\"     1\\t// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\\n     2\\t// run against the scripted fakes (TC-1.2) and, unchanged, against the real\\n     3\\t// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\\n     4\\t// Framework-agnostic on purpose: plain node:assert throws surface in vitest\\n     5\\t// and in any future runner identically.\\n     6\\timport assert from \\\"node:assert/strict\\\";\\n     7\\timport { createSdk, type DerivedForm, type Lhc } from \\\"../../src/index.js\\\";\\n     8\\timport { FORM_KINDS, type FormKind } from \\\"../../src/shared/derivation.js\\\";\\n     9\\timport type {\\n    10\\t  ModelAssignment,\\n    11\\t  ModelCall,\\n    12\\t  ModelCallInput,\\n    13\\t} from \\\"../../src/inference/types.js\\\";\\n    14\\timport { readDerivedForms } from \\\"./threads.js\\\";\\n    15\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n    16\\t\\n    17\\tconst FAILURE_KINDS = new Set([\\n    18\\t  \\\"rate_limit\\\",\\n    19\\t  \\\"timeout\\\",\\n    20\\t  \\\"network\\\",\\n    21\\t  \\\"empty_output\\\",\\n    22\\t  \\\"other\\\",\\n    23\\t  \\\"auth\\\",\\n    24\\t  \\\"invalid_request\\\",\\n    25\\t]);\\n    26\\t\\n    27\\texport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\\n    28\\t  return {\\n    29\\t    provider: \\\"probe-provider\\\",\\n    30\\t    model: \\\"probe-model\\\",\\n    31\\t    messages: [\\n    32\\t      { role: \\\"system\\\", content: \\\"You answer with one word.\\\" },\\n    33\\t      { role: \\\"user\\\", content: \\\"Say ok.\\\" },\\n    34\\t    ],\\n    35\\t    ...overrides,\\n    36\\t  };\\n    37\\t}\\n    38\\t\\n    39\\t// AC-1.2's result contract on one probe call: a ModelCall resolves to either\\n    40\\t// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\\n    41\\t// failure vocabulary. Catches fixture (and real-host) drift from the\\n    42\\t// boundary contract.\\n    43\\texport async function assertModelCallContract(\\n    44\\t  call: ModelCall,\\n    45\\t  probe: ModelCallInput = probeInput(),\\n    46\\t): Promise<void> {\\n    47\\t  const result = await call(probe);\\n    48\\t  assert.ok(\\n    49\\t    typeof result === \\\"object\\\" && result !== null,\\n    50\\t    \\\"ModelCall must resolve to a result object\\\",\\n    51\\t  );\\n    52\\t  if (result.ok === true) {\\n    53\\t    assert.equal(typeof result.text, \\\"string\\\", \\\"success result must carry string text\\\");\\n    54\\t  } else if (result.ok === false) {\\n    55\\t    assert.ok(\\n    56\\t      FAILURE_KINDS.has(result.kind),\\n    57\\t      `failure kind \\\"${String(result.kind)}\\\" is not in the failure vocabulary`,\\n    58\\t    );\\n    59\\t    assert.equal(typeof result.message, \\\"string\\\", \\\"failure result must carry a string message\\\");\\n    60\\t  } else {\\n    61\\t    assert.fail(\\\"ModelCall result must discriminate on a boolean ok\\\");\\n    62\\t  }\\n    63\\t}\\n    64\\t\\n    65\\texport interface RoutingRunResult {\\n    66\\t  sdk: Lhc;\\n    67\\t  filePath: string;\\n    68\\t  forms: DerivedForm[];\\n    69\\t  log: ModelCallInput[];\\n    70\\t}\\n    71\\t\\n    72\\tasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\\n    73\\t  const filePath = store.threadPath();\\n    74\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n    75\\t  assert.ok(created.ok, \\\"conformance fixture: thread creation failed\\\");\\n    76\\t  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\\n    77\\t  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\\n    78\\t  // tiny target policy and the two chunk summaries enqueue.\\n    79\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\\n    80\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please inspect the fixture file\\\" } }),\\n    81\\t    validEvent(\\\"tool_call\\\", {\\n    82\\t      payload: {\\n    83\\t        toolCallId: \\\"call-seam-1\\\",\\n    84\\t        toolName: \\\"read_file\\\",\\n    85\\t        arguments: { path: \\\"fixture.txt\\\" },\\n    86\\t      },\\n    87\\t    }),\\n    88\\t    validEvent(\\\"tool_result\\\", {\\n    89\\t      payload: { toolCallId: \\\"call-seam-1\\\", content: \\\"contents of fixture.txt\\\", isError: false },\\n    90\\t    }),\\n    91\\t    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"the fixture file holds fixture text\\\" } }),\\n    92\\t    validEvent(\\\"turn_end\\\"),\\n    93\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"thanks, now summarize it\\\" } }),\\n    94\\t    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"summarized\\\" } }),\\n    95\\t    validEvent(\\\"turn_end\\\"),\\n    96\\t  ]);\\n    97\\t  assert.ok(result.ok, \\\"conformance fixture: intake batch failed\\\");\\n    98\\t  return filePath;\\n    99\\t}\\n   100\\t\\n   101\\t// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\\n   102\\t// real host unchanged: construct an SDK on the inference path, drive all\\n   103\\t// seven kinds through a real intake → drain, and assert (1) every kind lands\\n   104\\t// ready, (2) every call that crossed the boundary carried exactly one\\n   105\\t// kind's assigned provider/model routing keys, (3) each kind's lane was\\n   106\\t// exercised, and (4) every messages value is single-turn shape — system and\\n   107\\t// user roles only, string content (AC-1.2, AC-1.4).\\n   108\\texport async function assertRoutingThroughSdk(\\n   109\\t  call: ModelCall,\\n   110\\t  assignments: Record<FormKind, ModelAssignment>,\\n   111\\t  store: TempStore,\\n   112\\t): Promise<RoutingRunResult> {\\n   113\\t  const log: ModelCallInput[] = [];\\n   114\\t  const logged: ModelCall = (input) => {\\n   115\\t    log.push(structuredClone(input));\\n   116\\t    return call(input);\\n   117\\t  };\\n   118\\t  const sdk = createSdk({\\n   119\\t    inference: { call: logged, assignments },\\n   120\\t    mode: \\\"manual\\\",\\n   121\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n   122\\t    // Tiny target: each placed turn crosses it, so the prior turn's chunk\\n   123\\t    // closes during the drain and the chunk-summary kinds run too.\\n   124\\t    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\\n   125\\t  });\\n   126\\t  const filePath = await seedAllSevenKinds(sdk, store);\\n   127\\t\\n   128\\t  const drained = await sdk.work.drain({ filePath });\\n   129\\t  assert.ok(drained.ok, \\\"conformance drain failed\\\");\\n   130\\t  assert.equal(drained.value.stoppedBecause, \\\"empty\\\", \\\"conformance drain left work behind\\\");\\n   131\\t  assert.equal(drained.value.remaining, 0, \\\"conformance drain left items remaining\\\");\\n   132\\t\\n   133\\t  const forms = readDerivedForms(filePath);\\n   134\\t  for (const kind of FORM_KINDS) {\\n   135\\t    assert.ok(\\n   136\\t      forms.some((form) => form.form === kind && form.state === \\\"ready\\\"),\\n   137\\t      `expected at least one ready ${kind} form after the drain`,\\n   138\\t    );\\n   139\\t  }\\n   140\\t\\n   141\\t  assert.ok(log.length > 0, \\\"no calls crossed the ModelCall boundary\\\");\\n   142\\t  for (const input of log) {\\n   143\\t    const matched = FORM_KINDS.filter(\\n   144\\t      (kind) =>\\n   145\\t        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\\n   146\\t    );\\n   147\\t    assert.ok(\\n   148\\t      matched.length > 0,\\n   149\\t      `call carried provider/model \\\"${input.provider}\\\"/\\\"${input.model}\\\" matching no kind's assignment`,\\n   150\\t    );\\n   151\\t    assert.ok(input.messages.length > 0, \\\"a call crossed the boundary with no messages\\\");\\n   152\\t    assert.ok(\\n   153\\t      input.messages.some((message) => message.role === \\\"user\\\"),\\n   154\\t      \\\"single-turn shape requires a user message\\\",\\n   155\\t    );\\n   156\\t    for (const message of input.messages) {\\n   157\\t      assert.ok(\\n   158\\t        message.role === \\\"system\\\" || message.role === \\\"user\\\",\\n   159\\t        `message role \\\"${String(message.role)}\\\" is outside the single-turn vocabulary`,\\n   160\\t      );\\n   161\\t      assert.equal(typeof message.content, \\\"string\\\", \\\"message content must be a string\\\");\\n   162\\t    }\\n   163\\t  }\\n   164\\t  for (const kind of FORM_KINDS) {\\n   165\\t    assert.ok(\\n   166\\t      log.some(\\n   167\\t        (input) =>\\n   168\\t          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\\n   169\\t      ),\\n   170\\t      `no boundary call carried ${kind}'s assigned provider/model lane`,\\n   171\\t    );\\n   172\\t  }\\n   173\\t  return { sdk, filePath, forms, log };\\n   174\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:45:{\"type\":\"item.started\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/prompts/tool-call-v1.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:46:{\"type\":\"item.started\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/prompts/smoothing-v1.ts'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\npackages/lhc/docs/02-specs/05-derivation-inference/artifacts/02-inference-seam-and-model-assignment/streams/006-verify.stdout.log:47:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/prompts/tool-call-v1.ts'\",\"aggregated_output\":\"     1\\t// PRE-D
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport { resolveInstancePoke } from \"../../../shared/context.js\";\n    11\timport type {\n    12\t  DependencyGap,\n    13\t  DerivedFormMetadata,\n    14\t  HandlerOutcome,\n    15\t  HandlerRunContext,\n    16\t  WorkHandler,\n    17\t} from \"../../../shared/derivation.js\";\n    18\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    19\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    20\timport { composeRenderingInput } from \"./compose.js\";\n    21\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    22\timport {\n    23\t  chunkExists,\n    24\t  readMemberMessages,\n    25\t  readMemberProjections,\n    26\t  readMessageFormRows,\n    27\t  readTurnSource,\n    28\t} from \"./forms.js\";\n    29\timport { selectOpenTurnIds } from \"./store.js\";\n    30\t\n    31\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    32\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    33\t}\n    34\t\n    35\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    36\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    37\t}\n    38\t\n    39\tfunction readThreadId(run: HandlerRunContext): string {\n    40\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    41\t    | { thread_id: string }\n    42\t    | undefined;\n    43\t  return row?.thread_id ?? \"\";\n    44\t}\n    45\t\n    46\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n    47\t  const turnId = item.sourceRef[\"turnId\"];\n    48\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n    49\t  const db = run.openDb();\n    50\t  const turn = readTurnSource(db, turnId);\n    51\t  if (turn === undefined || turn.deleted) {\n    52\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    53\t    // would hit nothing; either way the item is terminal against a source\n    54\t    // that cannot improve.\n    55\t    return sourceDamaged(`turn ${turnId} not found`);\n    56\t  }\n    57\t  if (turn.status !== \"closed\") {\n    58\t    // Derivation is queued only at close; an open turn under a queued item\n    59\t    // means the record was interfered with.\n    60\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n    61\t  }\n    62\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n    63\t  // batch pipeline writes turn state and it never leaves two turns open, so\n    64\t  // more than one open turn means the record was damaged below the SDK. A\n    65\t  // handler must not compose against a membership it cannot trust; the form\n    66\t  // lands blocked naming the damage, and requeue refuses with that reason\n    67\t  // until the source reads clean (Story 4).\n    68\t  const openTurnIds = selectOpenTurnIds(db);\n    69\t  if (openTurnIds.length > 1) {\n    70\t    return sourceDamaged(\n    71\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n    72\t    );\n    73\t  }\n    74\t\n    75\t  // Compose from current message-form states: ready forms verbatim,\n    76\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n    77\t  // before any provider call, and no transaction is held across them.\n    78\t  const messages = readMemberMessages(db, turnId);\n    79\t  const forms = readMessageFormRows(\n    80\t    db,\n    81\t    messages.map((message) => message.messageId),\n    82\t  );\n    83\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n    84\t\n    85\t  const rendering = await run.provider.composeTurnRendering({ parts });\n    86\t  if (!rendering.ok) return providerFailed(rendering);\n    87\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n    88\t  if (!projection.ok) return providerFailed(projection);\n    89\t\n    90\t  // The projection's token count is estimated exactly once, here, as the\n    91\t  // artifact lands; placement reads this stored arithmetic and never\n    92\t  // re-counts (AC-3.9's determinism input).\n    93\t  const projectedTokens = estimateTokens(projection.text);\n    94\t  const threadId = readThreadId(run);\n    95\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n    96\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\n    97\t  // from the composition input (AC-3.8) — the chunk summaries read them from\n    98\t  // here, never from provider prose. Provenance is copied from the provider\n    99\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\n   100\t  // deterministic provider sets none.\n   101\t  const renderingMetadata: DerivedFormMetadata = {\n   102\t    ...(receipts.length > 0 ? { receipts } : {}),\n   103\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\n   104\t  };\n   105\t\n   106\t  return {\n   107\t    ok: true,\n   108\t    forms: [\n   109\t      {\n   110\t        subjectKind: \"turn\",\n   111\t        subjectId: turnId,\n   112\t        form: \"turn_rendering\",\n   113\t        content: rendering.text,\n   114\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n   115\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\n   116\t      },\n   117\t      {\n   118\t        subjectKind: \"turn\",\n   119\t        subjectId: turnId,\n   120\t        form: \"lower_band_projection\",\n   121\t        content: projection.text,\n   122\t        ...(projection.provenance === undefined\n   123\t          ? {}\n   124\t          : { metadata: { provenance: projection.provenance } }),\n   125\t      },\n   126\t    ],\n   127\t    onApplied: (tx) => {\n   128\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   129\t      for (const chunkId of placement.closedChunkIds) {\n   130\t        enqueueChunkSummaries(\n   131\t          {\n   132\t            db: tx.db,\n   133\t            clock: run.clock,\n   134\t            threadId,\n   135\t            onCommit: tx.onCommit,\n   136\t            poke: resolveInstancePoke(),\n   137\t          },\n   138\t          chunkId,\n   139\t        );\n   140\t      }\n   141\t    },\n   142\t  };\n   143\t};\n   144\t\n   145\t// One read for both summary kinds — member projections in turn order — but\n   146\t// two contracts at the provider seam (AC-3.8): detailed receives the\n   147\t// members' tool-run receipts (what changed, outcome) read from the\n   148\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n   149\t// text stripped here so the brief provider call structurally cannot carry\n   150\t// it. Two work items, two handlers' runs, independent retry and states. A\n   151\t// member whose projection is not ready falls back to nothing and records a\n   152\t// gap, mirroring the rendering's fallback rule.\n   153\tfunction chunkSummaryHandler(\n   154\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   155\t): WorkHandler {\n   156\t  return async (run, item) => {\n   157\t    const chunkId = item.sourceRef[\"chunkId\"];\n   158\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   159\t    const db = run.openDb();\n   160\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   161\t\n   162\t    const members = readMemberProjections(db, chunkId);\n   163\t    const memberProjections: string[] = [];\n   164\t    const gaps: DependencyGap[] = [];\n   165\t    for (const member of members) {\n   166\t      if (member.state === \"ready\" && member.content !== undefined) {\n   167\t        memberProjections.push(member.content);\n   168\t      } else {\n   169\t        memberProjections.push(\"\");\n   170\t        gaps.push({\n   171\t          subjectKind: \"turn\",\n   172\t          subjectId: member.turnId,\n   173\t          form: \"lower_band_projection\",\n   174\t        });\n   175\t      }\n   176\t    }\n   177\t\n   178\t    const result =\n   179\t      kind === \"chunk_summary_detailed\"\n   180\t        ? await run.provider.summarizeChunkDetailed({\n   181\t            memberProjections,\n   182\t            memberReceipts: members.map((member) => member.receipts),\n   183\t          })\n   184\t        : await run.provider.summarizeChunkBrief({\n   185\t            memberProjections,\n   186\t            memberOutcomes: members.map((member) =>\n   187\t              member.receipts.map((receipt) => receipt.outcome),\n   188\t            ),\n   189\t          });\n   190\t    if (!result.ok) return providerFailed(result);\n   191\t\n   192\t    return {\n   193\t      ok: true,\n   194\t      forms: [\n   195\t        {\n   196\t          subjectKind: \"chunk\",\n   197\t          subjectId: chunkId,\n   198\t          form: kind,\n   199\t          content: result.text,\n   200\t          ...(gaps.length > 0 ? { gaps } : {}),\n   201\t          ...(result.provenance === undefined\n   202\t            ? {}\n   203\t            : { metadata: { provenance: result.provenance } }),\n   204\t        },\n   205\t      ],\n   206\t    };\n   207\t  };\n   208\t}\n   209\t\n   210\t// The domain's handler table, merged into the SDK dispatch map at\n   211\t// construction (DD-6).\n   212\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   213\t  turn_derivation: turnDerivationHandler,\n   214\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   215\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   216\t};\n","exit_code":0,"status":"completed"}}

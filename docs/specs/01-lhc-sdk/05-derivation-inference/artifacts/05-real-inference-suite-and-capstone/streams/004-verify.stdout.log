s/05-real-inference-suite-and-capstone/streams:\\ntotal 456\\ndrwxr-xr-x@ 4 leemoore  staff     128 Jun 12 19:20 .\\ndrwxr-xr-x@ 8 leemoore  staff     256 Jun 12 19:20 ..\\n-rw-r--r--@ 1 leemoore  staff       0 Jun 12 19:20 003-implementor.stderr.log\\n-rw-r--r--@ 1 leemoore  staff  170695 Jun 12 19:21 003-implementor.stdout.log\\n---\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"c78ba3ec-e01e-44e8-a71f-47db9723612a\",\"timestamp\":\"2026-06-12T23:21:07.433Z\",\"tool_use_result\":{\"stdout\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/progress:\\ntotal 16\\ndrwxr-xr-x@ 4 leemoore  staff   128 Jun 12 19:21 .\\ndrwxr-xr-x@ 8 leemoore  staff   256 Jun 12 19:20 ..\\n-rw-r--r--@ 1 leemoore  staff  1243 Jun 12 19:21 003-implementor.progress.jsonl\\n-rw-r--r--@ 1 leemoore  staff  1733 Jun 12 19:21 003-implementor.status.json\\n\\n/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/story-lead:\\ntotal 16\\ndrwxr-xr-x@ 7 leemoore  staff   224 Jun 12 19:20 .\\ndrwxr-xr-x@ 8 leemoore  staff   256 Jun 12 19:20 ..\\n-rw-r--r--@ 1 leemoore  staff  1505 Jun 12 19:20 001-current.json\\n-rw-r--r--@ 1 leemoore  staff  1738 Jun 12 19:20 001-events.jsonl\\ndrwxr-xr-x@ 4 leemoore  staff   128 Jun 12 19:20 progress\\ndrwxr-xr-x@ 3 leemoore  staff    96 Jun 12 19:20 prompts\\ndrwxr-xr-x@ 4 leemoore  staff   128 Jun 12 19:20 streams\\n\\n/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams:\\ntotal 456\\ndrwxr-xr-x@ 4 leemoore  staff     128 Jun 12 19:20 .\\ndrwxr-xr-x@ 8 leemoore  staff     256 Jun 12 19:20 ..\\n-rw-r--r--@ 1 leemoore  staff       0 Jun 12 19:20 003-implementor.stderr.log\\n-rw-r--r--@ 1 leemoore  staff  170695 Jun 12 19:21 003-implementor.stdout.log\\n---\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:126:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01TC3sDjL7Qvv6GXpRvM4FJ9\",\"type\":\"tool_result\",\"content\":\"1\\t// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\\n2\\t// run against the scripted fakes (TC-1.2) and, unchanged, against the real\\n3\\t// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\\n4\\t// Framework-agnostic on purpose: plain node:assert throws surface in vitest\\n5\\t// and in any future runner identically.\\n6\\timport assert from \\\"node:assert/strict\\\";\\n7\\timport { createSdk, type DerivedForm, type Lhc } from \\\"../../src/index.js\\\";\\n8\\timport { FORM_KINDS, type FormKind } from \\\"../../src/shared/derivation.js\\\";\\n9\\timport type {\\n10\\t  ModelAssignment,\\n11\\t  ModelCall,\\n12\\t  ModelCallInput,\\n13\\t} from \\\"../../src/inference/types.js\\\";\\n14\\timport { readDerivedForms } from \\\"./threads.js\\\";\\n15\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n16\\t\\n17\\tconst FAILURE_KINDS = new Set([\\n18\\t  \\\"rate_limit\\\",\\n19\\t  \\\"timeout\\\",\\n20\\t  \\\"network\\\",\\n21\\t  \\\"empty_output\\\",\\n22\\t  \\\"other\\\",\\n23\\t  \\\"auth\\\",\\n24\\t  \\\"invalid_request\\\",\\n25\\t]);\\n26\\t\\n27\\texport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\\n28\\t  return {\\n29\\t    provider: \\\"probe-provider\\\",\\n30\\t    model: \\\"probe-model\\\",\\n31\\t    messages: [\\n32\\t      { role: \\\"system\\\", content: \\\"You answer with one word.\\\" },\\n33\\t      { role: \\\"user\\\", content: \\\"Say ok.\\\" },\\n34\\t    ],\\n35\\t    ...overrides,\\n36\\t  };\\n37\\t}\\n38\\t\\n39\\t// AC-1.2's result contract on one probe call: a ModelCall resolves to either\\n40\\t// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\\n41\\t// failure vocabulary. Catches fixture (and real-host) drift from the\\n42\\t// boundary contract.\\n43\\texport async function assertModelCallContract(\\n44\\t  call: ModelCall,\\n45\\t  probe: ModelCallInput = probeInput(),\\n46\\t): Promise<void> {\\n47\\t  const result = await call(probe);\\n48\\t  assert.ok(\\n49\\t    typeof result === \\\"object\\\" && result !== null,\\n50\\t    \\\"ModelCall must resolve to a result object\\\",\\n51\\t  );\\n52\\t  if (result.ok === true) {\\n53\\t    assert.equal(typeof result.text, \\\"string\\\", \\\"success result must carry string text\\\");\\n54\\t  } else if (result.ok === false) {\\n55\\t    assert.ok(\\n56\\t      FAILURE_KINDS.has(result.kind),\\n57\\t      `failure kind \\\"${String(result.kind)}\\\" is not in the failure vocabulary`,\\n58\\t    );\\n59\\t    assert.equal(typeof result.message, \\\"string\\\", \\\"failure result must carry a string message\\\");\\n60\\t  } else {\\n61\\t    assert.fail(\\\"ModelCall result must discriminate on a boolean ok\\\");\\n62\\t  }\\n63\\t}\\n64\\t\\n65\\texport interface RoutingRunResult {\\n66\\t  sdk: Lhc;\\n67\\t  filePath: string;\\n68\\t  forms: DerivedForm[];\\n69\\t  log: ModelCallInput[];\\n70\\t}\\n71\\t\\n72\\tasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\\n73\\t  const filePath = store.threadPath();\\n74\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n75\\t  assert.ok(created.ok, \\\"conformance fixture: thread creation failed\\\");\\n76\\t  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\\n77\\t  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\\n78\\t  // tiny target policy and the two chunk summaries enqueue.\\n79\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\\n80\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please inspect the fixture file\\\" } }),\\n81\\t    validEvent(\\\"tool_call\\\", {\\n82\\t      payload: {\\n83\\t        toolCallId: \\\"call-seam-1\\\",\\n84\\t        toolName: \\\"read_file\\\",\\n85\\t        arguments: { path: \\\"fixture.txt\\\" },\\n86\\t      },\\n87\\t    }),\\n88\\t    validEvent(\\\"tool_result\\\", {\\n89\\t      payload: { toolCallId: \\\"call-seam-1\\\", content: \\\"contents of fixture.txt\\\", isError: false },\\n90\\t    }),\\n91\\t    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"the fixture file holds fixture text\\\" } }),\\n92\\t    validEvent(\\\"turn_end\\\"),\\n93\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"thanks, now summarize it\\\" } }),\\n94\\t    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"summarized\\\" } }),\\n95\\t    validEvent(\\\"turn_end\\\"),\\n96\\t  ]);\\n97\\t  assert.ok(result.ok, \\\"conformance fixture: intake batch failed\\\");\\n98\\t  return filePath;\\n99\\t}\\n100\\t\\n101\\t// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\\n102\\t// real host unchanged: construct an SDK on the inference path, drive all\\n103\\t// seven kinds through a real intake → drain, and assert (1) every kind lands\\n104\\t// ready, (2) every call that crossed the boundary carried exactly one\\n105\\t// kind's assigned provider/model routing keys, (3) each kind's lane was\\n106\\t// exercised, and (4) every messages value is single-turn shape — system and\\n107\\t// user roles only, string content (AC-1.2, AC-1.4).\\n108\\texport async function assertRoutingThroughSdk(\\n109\\t  call: ModelCall,\\n110\\t  assignments: Record<FormKind, ModelAssignment>,\\n111\\t  store: TempStore,\\n112\\t): Promise<RoutingRunResult> {\\n113\\t  const log: ModelCallInput[] = [];\\n114\\t  const logged: ModelCall = (input) => {\\n115\\t    log.push(structuredClone(input));\\n116\\t    return call(input);\\n117\\t  };\\n118\\t  const sdk = createSdk({\\n119\\t    inference: { call: logged, assignments },\\n120\\t    mode: \\\"manual\\\",\\n121\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n122\\t    // Tiny target: each placed turn crosses it, so the prior turn's chunk\\n123\\t    // closes during the drain and the chunk-summary kinds run too.\\n124\\t    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\\n125\\t  });\\n126\\t  const filePath = await seedAllSevenKinds(sdk, store);\\n127\\t\\n128\\t  const drained = await sdk.work.drain({ filePath });\\n129\\t  assert.ok(drained.ok, \\\"conformance drain failed\\\");\\n130\\t  assert.equal(drained.value.stoppedBecause, \\\"empty\\\", \\\"conformance drain left work behind\\\");\\n131\\t  assert.equal(drained.value.remaining, 0, \\\"conformance drain left items remaining\\\");\\n132\\t\\n133\\t  const forms = readDerivedForms(filePath);\\n134\\t  for (const kind of FORM_KINDS) {\\n135\\t    assert.ok(\\n136\\t      forms.some((form) => form.form === kind && form.state === \\\"ready\\\"),\\n137\\t      `expected at least one ready ${kind} form after the drain`,\\n138\\t    );\\n139\\t  }\\n140\\t\\n141\\t  assert.ok(log.length > 0, \\\"no calls crossed the ModelCall boundary\\\");\\n142\\t  for (const input of log) {\\n143\\t    const matched = FORM_KINDS.filter(\\n144\\t      (kind) =>\\n145\\t        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\\n146\\t    );\\n147\\t    assert.ok(\\n148\\t      matched.length > 0,\\n149\\t      `call carried provider/model \\\"${input.provider}\\\"/\\\"${input.model}\\\" matching no kind's assignment`,\\n150\\t    );\\n151\\t    assert.ok(input.messages.length > 0, \\\"a call crossed the boundary with no messages\\\");\\n152\\t    assert.ok(\\n153\\t      input.messages.some((message) => message.role === \\\"user\\\"),\\n154\\t      \\\"single-turn shape requires a user message\\\",\\n155\\t    );\\n156\\t    for (const message of input.messages) {\\n157\\t      assert.ok(\\n158\\t        message.role === \\\"system\\\" || message.role === \\\"user\\\",\\n159\\t        `message role \\\"${String(message.role)}\\\" is outside the single-turn vocabulary`,\\n160\\t      );\\n161\\t      assert.equal(typeof message.content, \\\"string\\\", \\\"message content must be a string\\\");\\n162\\t    }\\n163\\t  }\\n164\\t  for (const kind of FORM_KINDS) {\\n165\\t    assert.ok(\\n166\\t      log.some(\\n167\\t        (input) =>\\n168\\t          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\\n169\\t      ),\\n170\\t      `no boundary call carried ${kind}'s assigned provider/model lane`,\\n171\\t    );\\n172\\t  }\\n173\\t  return { sdk, filePath, forms, log };\\n174\\t}\\n175\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"6edb0c40-880a-479b-89bf-c49b4ad66e88\",\"timestamp\":\"2026-06-12T23:21:14.393Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/seam-conformance.ts\",\"content\":\"// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\\n// run against the scripted fakes (TC-1.2) and, unchanged, against the real\\n// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\\n// Framework-agnostic on purpose: plain node:assert throws surface in vitest\\n// and in any future runner identically.\\nimport assert from \\\"node:assert/strict\\\";\\nimport { createSdk, type DerivedForm, type Lhc } from \\\"../../src/index.js\\\";\\nimport { FORM_KINDS, type FormKind } from \\\"../../src/shared/derivation.js\\\";\\nimport type {\\n  ModelAssignment,\\n  ModelCall,\\n  ModelCallInput,\\n} from \\\"../../src/inference/types.js\\\";\\nimport { readDerivedForms } from \\\"./threads.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\nconst FAILURE_KINDS = new Set([\\n  \\\"rate_limit\\\",\\n  \\\"timeout\\\",\\n  \\\"network\\\",\\n  \\\"empty_output\\\",\\n  \\\"other\\\",\\n  \\\"auth\\\",\\n  \\\"invalid_request\\\",\\n]);\\n\\nexport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\\n  return {\\n    provider: \\\"probe-provider\\\",\\n    model: \\\"probe-model\\\",\\n    messages: [\\n      { role: \\\"system\\\", content: \\\"You answer with one word.\\\" },\\n      { role: \\\"user\\\", content: \\\"Say ok.\\\" },\\n    ],\\n    ...overrides,\\n  };\\n}\\n\\n// AC-1.2's result contract on one probe call: a ModelCall resolves to either\\n// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\\n// failure vocabulary. Catches fixture (and real-host) drift from the\\n// boundary contract.\\nexport async function assertModelCallContract(\\n  call: ModelCall,\\n  probe: ModelCallInput = probeInput(),\\n): Promise<void> {\\n  const result = await call(probe);\\n  assert.ok(\\n    typeof result === \\\"object\\\" && result !== null,\\n    \\\"ModelCall must resolve to a result object\\\",\\n  );\\n  if (result.ok === true) {\\n    assert.equal(typeof result.text, \\\"string\\\", \\\"success result must carry string text\\\");\\n  } else if (result.ok === false) {\\n    assert.ok(\\n      FAILURE_KINDS.has(result.kind),\\n      `failure kind \\\"${String(result.kind)}\\\" is not in the failure vocabulary`,\\n    );\\n    assert.equal(typeof result.message, \\\"string\\\", \\\"failure result must carry a string message\\\");\\n  } else {\\n    assert.fail(\\\"ModelCall result must discriminate on a boolean ok\\\");\\n  }\\n}\\n\\nexport interface RoutingRunResult {\\n  sdk: Lhc;\\n  filePath: string;\\n  forms: DerivedForm[];\\n  log: ModelCallInput[];\\n}\\n\\nasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n  assert.ok(created.ok, \\\"conformance fixture: thread creation failed\\\");\\n  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\\n  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\\n  // tiny target policy and the two chunk summaries enqueue.\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please inspect the fixture file\\\" } }),\\n    validEvent(\\\"tool_call\\\", {\\n      payload: {\\n        toolCallId: \\\"call-seam-1\\\",\\n        toolName: \\\"read_file\\\",\\n        arguments: { path: \\\"fixture.txt\\\" },\\n      },\\n    }),\\n    validEvent(\\\"tool_result\\\", {\\n      payload: { toolCallId: \\\"call-seam-1\\\", content: \\\"contents of fixture.txt\\\", isError: false },\\n    }),\\n    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"the fixture file holds fixture text\\\" } }),\\n    validEvent(\\\"turn_end\\\"),\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"thanks, now summarize it\\\" } }),\\n    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"summarized\\\" } }),\\n    validEvent(\\\"turn_end\\\"),\\n  ]);\\n  assert.ok(result.ok, \\\"conformance fixture: intake batch failed\\\");\\n  return filePath;\\n}\\n\\n// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\\n// real host unchanged: construct an SDK on the inference path, drive all\\n// seven kinds through a real intake → drain, and assert (1) every kind lands\\n// ready, (2) every call that crossed the boundary carried exactly one\\n// kind's assigned provider/model routing keys, (3) each kind's lane was\\n// exercised, and (4) every messages value is single-turn shape — system and\\n// user roles only, string content (AC-1.2, AC-1.4).\\nexport async function assertRoutingThroughSdk(\\n  call: ModelCall,\\n  assignments: Record<FormKind, ModelAssignment>,\\n  store: TempStore,\\n): Promise<RoutingRunResult> {\\n  const log: ModelCallInput[] = [];\\n  const logged: ModelCall = (input) => {\\n    log.push(structuredClone(input));\\n    return call(input);\\n  };\\n  const sdk = createSdk({\\n    inference: { call: logged, assignments },\\n    mode: \\\"manual\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    // Tiny target: each placed turn crosses it, so the prior turn's chunk\\n    // closes during the drain and the chunk-summary kinds run too.\\n    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\\n  });\\n  const filePath = await seedAllSevenKinds(sdk, store);\\n\\n  const drained = await sdk.work.drain({ filePath });\\n  assert.ok(drained.ok, \\\"conformance drain failed\\\");\\n  assert.equal(drained.value.stoppedBecause, \\\"empty\\\", \\\"conformance drain left work behind\\\");\\n  assert.equal(drained.value.remaining, 0, \\\"conformance drain left items remaining\\\");\\n\\n  const forms = readDerivedForms(filePath);\\n  for (const kind of FORM_KINDS) {\\n    assert.ok(\\n      forms.some((form) => form.form === kind && form.state === \\\"ready\\\"),\\n      `expected at least one ready ${kind} form after the drain`,\\n    );\\n  }\\n\\n  assert.ok(log.length > 0, \\\"no calls crossed the ModelCall boundary\\\");\\n  for (const input of log) {\\n    const matched = FORM_KINDS.filter(\\n      (kind) =>\\n        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\\n    );\\n    assert.ok(\\n      matched.length > 0,\\n      `call carried provider/model \\\"${input.provider}\\\"/\\\"${input.model}\\\" matching no kind's assignment`,\\n    );\\n    assert.ok(input.messages.length > 0, \\\"a call crossed the boundary with no messages\\\");\\n    assert.ok(\\n      input.messages.some((message) => message.role === \\\"user\\\"),\\n      \\\"single-turn shape requires a user message\\\",\\n    );\\n    for (const message of input.messages) {\\n      assert.ok(\\n        message.role === \\\"system\\\" || message.role === \\\"user\\\",\\n        `message role \\\"${String(message.role)}\\\" is outside the single-turn vocabulary`,\\n      );\\n      assert.equal(typeof message.content, \\\"string\\\", \\\"message content must be a string\\\");\\n    }\\n  }\\n  for (const kind of FORM_KINDS) {\\n    assert.ok(\\n      log.some(\\n        (input) =>\\n          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\\n      ),\\n      `no boundary call carried ${kind}'s assigned provider/model lane`,\\n    );\\n  }\\n  return { sdk, filePath, forms, log };\\n}\\n\",\"numLines\":175,\"startLine\":1,\"totalLines\":175}}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:131:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01UemtKZB62B1j5jov2kTUJA\",\"type\":\"tool_result\",\"content\":\"1\\t// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\\n2\\t// ModelCall implementations every Flow 1–3 test uses. These are boundary\\n3\\t// doubles, not internal mocks — the ModelCall function is where LHC's code\\n4\\t// ends (tech design §Testing Strategy). All builders return\\n5\\t// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\\n6\\t// recordingCall in its own test so fixture drift is caught by the suite.\\n7\\timport { FORM_KINDS, type FormKind } from \\\"../../src/shared/derivation.js\\\";\\n8\\timport { DEFAULT_PROMPT_NAMES } from \\\"../../src/inference/prompts/index.js\\\";\\n9\\timport type {\\n10\\t  ModelAssignment,\\n11\\t  ModelCall,\\n12\\t  ModelCallInput,\\n13\\t  ModelCallResult,\\n14\\t} from \\\"../../src/inference/types.js\\\";\\n15\\t\\n16\\texport { FORM_KINDS, type FormKind };\\n17\\t\\n18\\t// validAssignments gives every kind a distinct fake provider/model lane;\\n19\\t// recordingCall infers the kind back from the model string, so per-kind\\n20\\t// routing is observable from the log alone (TC-1.2).\\n21\\texport const FAKE_PROVIDER_PREFIX = \\\"prov-\\\";\\n22\\texport const FAKE_MODEL_PREFIX = \\\"model-\\\";\\n23\\t\\n24\\texport function validAssignments(\\n25\\t  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\\n26\\t): Record<FormKind, ModelAssignment> {\\n27\\t  const map = {} as Record<FormKind, ModelAssignment>;\\n28\\t  for (const kind of FORM_KINDS) {\\n29\\t    map[kind] = {\\n30\\t      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\\n31\\t      model: `${FAKE_MODEL_PREFIX}${kind}`,\\n32\\t      prompt: DEFAULT_PROMPT_NAMES[kind],\\n33\\t      ...(overrides[kind] ?? {}),\\n34\\t    };\\n35\\t  }\\n36\\t  return map;\\n37\\t}\\n38\\t\\n39\\t// One distinct canned sentence per kind, so cross-kind bleed is visible in\\n40\\t// landed form content, never just in call counts.\\n41\\texport function cannedResponses(): Record<FormKind, string> {\\n42\\t  const map = {} as Record<FormKind, string>;\\n43\\t  for (const kind of FORM_KINDS) {\\n44\\t    map[kind] = `canned ${kind} text from the fake host`;\\n45\\t  }\\n46\\t  return map;\\n47\\t}\\n48\\t\\n49\\t// Resolves each call with its kind's canned text — the kind inferred from\\n50\\t// the model routing key validAssignments made unique per kind. Every input\\n51\\t// is cloned into `log` in call order. An unknown model is a test bug and\\n52\\t// throws loudly.\\n53\\texport function recordingCall(responses: Record<FormKind, string>): {\\n54\\t  call: ModelCall;\\n55\\t  log: ModelCallInput[];\\n56\\t} {\\n57\\t  const log: ModelCallInput[] = [];\\n58\\t  const known = new Set<string>(FORM_KINDS);\\n59\\t  const call: ModelCall = (input) => {\\n60\\t    log.push(structuredClone(input));\\n61\\t    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\\n62\\t      ? input.model.slice(FAKE_MODEL_PREFIX.length)\\n63\\t      : input.model;\\n64\\t    if (!known.has(kind)) {\\n65\\t      throw new Error(`recordingCall: no canned response for model \\\"${input.model}\\\"`);\\n66\\t    }\\n67\\t    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\\n68\\t  };\\n69\\t  return { call, log };\\n70\\t}\\n71\\t\\n72\\t// Returns script entries in order; a call past the end of the script is a\\n73\\t// test bug and throws loudly.\\n74\\texport function scriptedCall(script: ModelCallResult[]): ModelCall {\\n75\\t  let next = 0;\\n76\\t  return (input) => {\\n77\\t    const entry = script[next];\\n78\\t    next += 1;\\n79\\t    if (entry === undefined) {\\n80\\t      throw new Error(\\n81\\t        `scriptedCall: script exhausted after ${String(script.length)} calls (model \\\"${input.model}\\\")`,\\n82\\t      );\\n83\\t    }\\n84\\t    return Promise.resolve(entry);\\n85\\t  };\\n86\\t}\\n87\\t\\n88\\t// A host whose function throws — the AC-3.3 containment leg.\\n89\\texport function throwingCall(error: Error): ModelCall {\\n90\\t  return () => Promise.reject(error);\\n91\\t}\\n92\\t\\n93\\t// A host that never settles — the DD-6 timeout leg (tests pass a small\\n94\\t// timeoutMs).\\n95\\texport function hangingCall(): ModelCall {\\n96\\t  return () => new Promise<ModelCallResult>(() => {});\\n97\\t}\\n98\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"a20442e6-c3cd-404f-b566-d8cac661c7bd\",\"timestamp\":\"2026-06-12T23:21:14.747Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/model-call.ts\",\"content\":\"// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\\n// ModelCall implementations every Flow 1–3 test uses. These are boundary\\n// doubles, not internal mocks — the ModelCall function is where LHC's code\\n// ends (tech design §Testing Strategy). All builders return\\n// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\\n// recordingCall in its own test so fixture drift is caught by the suite.\\nimport { FORM_KINDS, type FormKind } from \\\"../../src/shared/derivation.js\\\";\\nimport { DEFAULT_PROMPT_NAMES } from \\\"../../src/inference/prompts/index.js\\\";\\nimport type {\\n  ModelAssignment,\\n  ModelCall,\\n  ModelCallInput,\\n  ModelCallResult,\\n} from \\\"../../src/inference/types.js\\\";\\n\\nexport { FORM_KINDS, type FormKind };\\n\\n// validAssignments gives every kind a distinct fake provider/model lane;\\n// recordingCall infers the kind back from the model string, so per-kind\\n// routing is observable from the log alone (TC-1.2).\\nexport const FAKE_PROVIDER_PREFIX = \\\"prov-\\\";\\nexport const FAKE_MODEL_PREFIX = \\\"model-\\\";\\n\\nexport function validAssignments(\\n  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\\n): Record<FormKind, ModelAssignment> {\\n  const map = {} as Record<FormKind, ModelAssignment>;\\n  for (const kind of FORM_KINDS) {\\n    map[kind] = {\\n      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\\n      model: `${FAKE_MODEL_PREFIX}${kind}`,\\n      prompt: DEFAULT_PROMPT_NAMES[kind],\\n      ...(overrides[kind] ?? {}),\\n    };\\n  }\\n  return map;\\n}\\n\\n// One distinct canned sentence per kind, so cross-kind bleed is visible in\\n// landed form content, never just in call counts.\\nexport function cannedResponses(): Record<FormKind, string> {\\n  const map = {} as Record<FormKind, string>;\\n  for (const kind of FORM_KINDS) {\\n    map[kind] = `canned ${kind} text from the fake host`;\\n  }\\n  return map;\\n}\\n\\n// Resolves each call with its kind's canned text — the kind inferred from\\n// the model routing key validAssignments made unique per kind. Every input\\n// is cloned into `log` in call order. An unknown model is a test bug and\\n// throws loudly.\\nexport function recordingCall(responses: Record<FormKind, string>): {\\n  call: ModelCall;\\n  log: ModelCallInput[];\\n} {\\n  const log: ModelCallInput[] = [];\\n  const known = new Set<string>(FORM_KINDS);\\n  const call: ModelCall = (input) => {\\n    log.push(structuredClone(input));\\n    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\\n      ? input.model.slice(FAKE_MODEL_PREFIX.length)\\n      : input.model;\\n    if (!known.has(kind)) {\\n      throw new Error(`recordingCall: no canned response for model \\\"${input.model}\\\"`);\\n    }\\n    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\\n  };\\n  return { call, log };\\n}\\n\\n// Returns script entries in order; a call past the end of the script is a\\n// test bug and throws loudly.\\nexport function scriptedCall(script: ModelCallResult[]): ModelCall {\\n  let next = 0;\\n  return (input) => {\\n    const entry = script[next];\\n    next += 1;\\n    if (entry === undefined) {\\n      throw new Error(\\n        `scriptedCall: script exhausted after ${String(script.length)} calls (model \\\"${input.model}\\\")`,\\n      );\\n    }\\n    return Promise.resolve(entry);\\n  };\\n}\\n\\n// A host whose function throws — the AC-3.3 containment leg.\\nexport function throwingCall(error: Error): ModelCall {\\n  return () => Promise.reject(error);\\n}\\n\\n// A host that never settles — the DD-6 timeout leg (tests pass a small\\n// timeoutMs).\\nexport function hangingCall(): ModelCall {\\n  return () => new Promise<ModelCallResult>(() => {});\\n}\\n\",\"numLines\":98,\"startLine\":1,\"totalLines\":98}}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:144:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01WCNKXxjusCqhbhSCnv3ikX\",\"type\":\"tool_result\",\"content\":\"1\\t// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\n2\\t// driven once, in PI-extension call order, against one real SDK\\n3\\t// configuration with the deterministic provider — zero network, zero real\\n4\\t// provider, no mocks anywhere. The script owns the sequence and the phase\\n5\\t// names (tech design Flow 5); assertions live in the driving tests, so the\\n6\\t// replay, teardown, and process legs all run THIS sequence rather than a\\n7\\t// re-described one (DD-8).\\n8\\t//\\n9\\t// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\n10\\t// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\n11\\t//\\n12\\t// Mode is background — the production posture the PI extension will run —\\n13\\t// and the drain/rebuild phases settle through `drainSettled`, the real\\n14\\t// background awaitable. The post-mutation health snapshot (AC-5.2's\\n15\\t// \\\"cleared set pending\\\") is deterministic because every SDK operation here\\n16\\t// is synchronous SQLite chained through microtasks, while a background\\n17\\t// drain pass always starts on a macrotask (scheduler runLoop defers through\\n18\\t// setImmediate): the edit → delete → health reads inside the mutate phase\\n19\\t// run as one unbroken microtask cascade and complete before the poked drain\\n20\\t// can claim its first item. The rebuild phase then yields via drainSettled\\n21\\t// and the drain runs to empty.\\n22\\timport { join } from \\\"node:path\\\";\\n23\\timport {\\n24\\t  createDeterministicProvider,\\n25\\t  createSdk,\\n26\\t  type BatchResult,\\n27\\t  type CompactReceipt,\\n28\\t  type FormReportEntry,\\n29\\t  type HealthReport,\\n30\\t  type InspectOverview,\\n31\\t  type Lhc,\\n32\\t  type MessageEventInput,\\n33\\t  type MutationResult,\\n34\\t  type OpResult,\\n35\\t  type PullResult,\\n36\\t  type ViewContentsReport,\\n37\\t  type ViewStatus,\\n38\\t} from \\\"../../src/index.js\\\";\\n39\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n40\\t\\n41\\t// ── the one SDK configuration (AC-5.1) ────────────────────────────\\n42\\t//\\n43\\t// Deterministic provider injected at construction (the only provider-arrival\\n44\\t// path since the CLI retired), background mode, zero-backoff retry so a\\n45\\t// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\n46\\t// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\n47\\t// a named \\\"lifecycle\\\" profile so compact runs profile-addressed (story\\n48\\t// scope: \\\"compact (profile)\\\") with all three lower bands non-empty on this\\n49\\t// thread (Epic 03 Story 2's reference gradient).\\n50\\texport const LIFECYCLE_PROFILE = {\\n51\\t  name: \\\"lifecycle\\\",\\n52\\t  lowerBound: 400,\\n53\\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\n54\\t} as const;\\n55\\t\\n56\\texport function createLifecycleSdk(): Lhc {\\n57\\t  return createSdk({\\n58\\t    provider: createDeterministicProvider(),\\n59\\t    mode: \\\"background\\\",\\n60\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n61\\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n62\\t    view: {\\n63\\t      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\n64\\t      // Low threshold so the status checkpoint genuinely recommends the\\n65\\t      // compact the sequence performs next.\\n66\\t      compactThreshold: 300,\\n67\\t    },\\n68\\t  });\\n69\\t}\\n70\\t\\n71\\t// ── the recorded conversation ─────────────────────────────────────\\n72\\t//\\n73\\t// Same shape and text profile as the Epic 03 derived-thread fixture (12\\n74\\t// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\n75\\t// policy cuts the same 4-chunk shape — but with explicit per-run\\n76\\t// idempotency keys so a replay on a fresh thread records byte-identical\\n77\\t// event payloads regardless of any process-global fixture counters.\\n78\\tconst TURN_COUNT = 12;\\n79\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n80\\tconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\n81\\t\\n82\\t// Mutation targets: both in the post-compact tail (compact point at t9's\\n83\\t// start under the lifecycle profile), so the second compact's pull shows the\\n84\\t// edit verbatim and the deletion's absence — the tail is full fidelity.\\n85\\texport const EDIT_TARGET = { turnId: \\\"t12\\\", kind: \\\"user_prompt\\\" } as const;\\n86\\texport const EDITED_MESSAGE_TEXT =\\n87\\t  \\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\";\\n88\\texport const DELETE_TARGET = { turnId: \\\"t10\\\", kind: \\\"assistant_text\\\" } as const;\\n89\\texport const DELETED_MESSAGE_TEXT = \\\"findings for area 10\\\";\\n90\\t\\n91\\tfunction turnEvents(turn: number): MessageEventInput[] {\\n92\\t  let seq = 0;\\n93\\t  const key = (): string => {\\n94\\t    seq += 1;\\n95\\t    return `lc-t${turn}-e${seq}`;\\n96\\t  };\\n97\\t  const events: MessageEventInput[] = [\\n98\\t    validEvent(\\\"user_prompt\\\", {\\n99\\t      idempotencyKey: key(),\\n100\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n101\\t    }),\\n102\\t    validEvent(\\\"assistant_thinking\\\", {\\n103\\t      idempotencyKey: key(),\\n104\\t      payload: { text: `considering what area ${turn} contains` },\\n105\\t    }),\\n106\\t  ];\\n107\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n108\\t    for (const run of [1, 2]) {\\n109\\t      const toolCallId = `call-lc-${turn}-${run}`;\\n110\\t      events.push(\\n111\\t        validEvent(\\\"tool_call\\\", {\\n112\\t          idempotencyKey: key(),\\n113\\t          payload: {\\n114\\t            toolCallId,\\n115\\t            toolName: \\\"read_file\\\",\\n116\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\n117\\t          },\\n118\\t        }),\\n119\\t        validEvent(\\\"tool_result\\\", {\\n120\\t          idempotencyKey: key(),\\n121\\t          payload: {\\n122\\t            toolCallId,\\n123\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n124\\t            isError: false,\\n125\\t          },\\n126\\t        }),\\n127\\t      );\\n128\\t    }\\n129\\t  }\\n130\\t  events.push(\\n131\\t    validEvent(\\\"assistant_text\\\", {\\n132\\t      idempotencyKey: key(),\\n133\\t      payload: { text: `findings for area ${turn}` },\\n134\\t    }),\\n135\\t    validEvent(\\\"turn_end\\\", { idempotencyKey: key() }),\\n136\\t  );\\n137\\t  return events;\\n138\\t}\\n139\\t\\n140\\tfunction intakeBatches(): MessageEventInput[][] {\\n141\\t  const batches: MessageEventInput[][] = [];\\n142\\t  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\n143\\t    const batch: MessageEventInput[] = [];\\n144\\t    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\n145\\t      batch.push(...turnEvents(turn));\\n146\\t    }\\n147\\t    batches.push(batch);\\n148\\t  }\\n149\\t  return batches;\\n150\\t}\\n151\\t\\n152\\t// ── run shape ─────────────────────────────────────────────────────\\n153\\t\\n154\\texport interface LifecyclePhases {\\n155\\t  create: OpResult<{ threadId: string; filePath: string }>;\\n156\\t  intake: Array<OpResult<BatchResult>>;\\n157\\t  drain: { settled: true };\\n158\\t  status: OpResult<ViewStatus>;\\n159\\t  compact1: OpResult<CompactReceipt>;\\n160\\t  pull1: OpResult<PullResult>;\\n161\\t  inspect1: {\\n162\\t    overview: OpResult<InspectOverview>;\\n163\\t    view: OpResult<ViewContentsReport>;\\n164\\t    health: OpResult<HealthReport>;\\n165\\t  };\\n166\\t  mutate: {\\n167\\t    editedMessageId: string;\\n168\\t    deletedMessageId: string;\\n169\\t    edit: OpResult<MutationResult>;\\n170\\t    delete: OpResult<MutationResult>;\\n171\\t    // Captured inside the mutate phase, before the background drain's first\\n172\\t    // macrotask: the cleared-set-pending evidence (AC-5.2).\\n173\\t    healthAfterMutate: OpResult<HealthReport>;\\n174\\t    messagesNotReady: OpResult<FormReportEntry[]>;\\n175\\t    turnsNotReady: OpResult<FormReportEntry[]>;\\n176\\t  };\\n177\\t  rebuild: { settled: true };\\n178\\t  health2: OpResult<HealthReport>;\\n179\\t  compact2: OpResult<CompactReceipt>;\\n180\\t  pull2: OpResult<PullResult>;\\n181\\t  materialize: OpResult<{ writtenPath: string }>;\\n182\\t}\\n183\\t\\n184\\texport type LifecycleCheckpoint = \\\"inspect1\\\" | \\\"health2\\\" | \\\"materialize\\\";\\n185\\t\\n186\\texport interface LifecycleOptions {\\n187\\t  // Distinguishes the thread file and materialize target so replay and\\n188\\t  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\n189\\t  name?: string;\\n190\\t  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\n191\\t  // render phase groups — every group boundary is a quiescent point (no\\n192\\t  // queued work, no running drain), so the abandoned instance can never act\\n193\\t  // after its group ends.\\n194\\t  freshSdkBetweenGroups?: boolean;\\n195\\t  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\n196\\t  onCheckpoint?: (\\n197\\t    checkpoint: LifecycleCheckpoint,\\n198\\t    ctx: { sdk: Lhc; filePath: string },\\n199\\t  ) => Promise<void>;\\n200\\t}\\n201\\t\\n202\\texport interface LifecycleRun {\\n203\\t  filePath: string;\\n204\\t  outPath: string;\\n205\\t  threadId: string;\\n206\\t  phases: LifecyclePhases;\\n207\\t}\\n208\\t\\n209\\tfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\n210\\t  if (!result.ok) {\\n211\\t    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\n212\\t  }\\n213\\t  return result.value;\\n214\\t}\\n215\\t\\n216\\t// ── the sequence ──────────────────────────────────────────────────\\n217\\t\\n218\\texport async function runLifecycle(\\n219\\t  store: TempStore,\\n220\\t  opts: LifecycleOptions = {},\\n221\\t): Promise<LifecycleRun> {\\n222\\t  const name = opts.name ?? \\\"lifecycle\\\";\\n223\\t  const filePath = store.threadPath(name);\\n224\\t  const outPath = join(store.dir, `${name}-session.jsonl`);\\n225\\t  const ref = { filePath };\\n226\\t\\n227\\t  let sdk = createLifecycleSdk();\\n228\\t  const nextGroup = (): void => {\\n229\\t    // The fresh instance is the same configuration assembled again — the\\n230\\t    // continuity proof is that no phase depends on the prior instance's\\n231\\t    // memory, only on the thread file.\\n232\\t    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\n233\\t  };\\n234\\t  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\n235\\t    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\n236\\t  };\\n237\\t\\n238\\t  // ── group 1: create → intake → drain → status ──\\n239\\t  const create = await sdk.threads.newThread({\\n240\\t    filePath,\\n241\\t    registryPath: store.registryPath,\\n242\\t  });\\n243\\t  const threadId = expectOk(create, \\\"create\\\").threadId;\\n244\\t\\n245\\t  const intake: Array<OpResult<BatchResult>> = [];\\n246\\t  for (const batch of intakeBatches()) {\\n247\\t    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\n248\\t    intake.push(sent);\\n249\\t    expectOk(sent, \\\"intake\\\");\\n250\\t  }\\n251\\t\\n252\\t  // Background drain settles (story scope): the intake pokes scheduled the\\n253\\t  // work; this is the await that lets the scheduler run it to empty.\\n254\\t  await sdk.drainSettled(ref);\\n255\\t  const drain = { settled: true } as const;\\n256\\t\\n257\\t  const status = await sdk.threadView.status(ref);\\n258\\t  expectOk(status, \\\"status\\\");\\n259\\t\\n260\\t  // ── group 2: compact1 → pull1 → inspect1 ──\\n261\\t  nextGroup();\\n262\\t  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n263\\t  expectOk(compact1, \\\"compact1\\\");\\n264\\t  const pull1 = await sdk.threadView.pull(ref);\\n265\\t  expectOk(pull1, \\\"pull1\\\");\\n266\\t  const inspect1 = {\\n267\\t    overview: await sdk.inspect.overview(ref),\\n268\\t    view: await sdk.inspect.view(ref),\\n269\\t    health: await sdk.inspect.health(ref),\\n270\\t  };\\n271\\t  expectOk(inspect1.overview, \\\"inspect1.overview\\\");\\n272\\t  expectOk(inspect1.view, \\\"inspect1.view\\\");\\n273\\t  expectOk(inspect1.health, \\\"inspect1.health\\\");\\n274\\t  await checkpoint(\\\"inspect1\\\");\\n275\\t\\n276\\t  // ── group 3: mutate → rebuild → health2 ──\\n277\\t  nextGroup();\\n278\\t  const listed = expectOk(await sdk.messages.listMessages(ref), \\\"mutate.list\\\");\\n279\\t  const editTarget = listed.find(\\n280\\t    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\n281\\t  );\\n282\\t  const deleteTarget = listed.find(\\n283\\t    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\n284\\t  );\\n285\\t  if (editTarget === undefined || deleteTarget === undefined) {\\n286\\t    throw new Error(\\\"lifecycle invariant: edit/delete targets not found in the record\\\");\\n287\\t  }\\n288\\t  // Edit, delete, and the pending-state reads run in one microtask cascade\\n289\\t  // (see module header): the snapshot is taken before the poked background\\n290\\t  // drain starts its first pass.\\n291\\t  const edit = await sdk.messages.edit(ref, {\\n292\\t    messageId: editTarget.messageId,\\n293\\t    content: EDITED_MESSAGE_TEXT,\\n294\\t  });\\n295\\t  expectOk(edit, \\\"mutate.edit\\\");\\n296\\t  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\n297\\t  expectOk(deleted, \\\"mutate.delete\\\");\\n298\\t  const mutate: LifecyclePhases[\\\"mutate\\\"] = {\\n299\\t    editedMessageId: editTarget.messageId,\\n300\\t    deletedMessageId: deleteTarget.messageId,\\n301\\t    edit,\\n302\\t    delete: deleted,\\n303\\t    healthAfterMutate: await sdk.inspect.health(ref),\\n304\\t    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\n305\\t    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\n306\\t  };\\n307\\t  expectOk(mutate.healthAfterMutate, \\\"mutate.health\\\");\\n308\\t  expectOk(mutate.messagesNotReady, \\\"mutate.messagesNotReady\\\");\\n309\\t  expectOk(mutate.turnsNotReady, \\\"mutate.turnsNotReady\\\");\\n310\\t\\n311\\t  // Rebuild drains: the mutations' pokes already scheduled the cascade\\n312\\t  // rebuilds on THIS instance's scheduler; settle is the production await.\\n313\\t  await sdk.drainSettled(ref);\\n314\\t  const rebuild = { settled: true } as const;\\n315\\t\\n316\\t  const health2 = await sdk.inspect.health(ref);\\n317\\t  expectOk(health2, \\\"health2\\\");\\n318\\t  await checkpoint(\\\"health2\\\");\\n319\\t\\n320\\t  // ── group 4: compact2 → pull2 → materialize ──\\n321\\t  nextGroup();\\n322\\t  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n323\\t  expectOk(compact2, \\\"compact2\\\");\\n324\\t  const pull2 = await sdk.threadView.pull(ref);\\n325\\t  expectOk(pull2, \\\"pull2\\\");\\n326\\t  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\n327\\t  expectOk(materialize, \\\"materialize\\\");\\n328\\t  await checkpoint(\\\"materialize\\\");\\n329\\t\\n330\\t  return {\\n331\\t    filePath,\\n332\\t    outPath,\\n333\\t    threadId,\\n334\\t    phases: {\\n335\\t      create,\\n336\\t      intake,\\n337\\t      drain,\\n338\\t      status,\\n339\\t      compact1,\\n340\\t      pull1,\\n341\\t      inspect1,\\n342\\t      mutate,\\n343\\t      rebuild,\\n344\\t      health2,\\n345\\t      compact2,\\n346\\t      pull2,\\n347\\t      materialize,\\n348\\t    },\\n349\\t  };\\n350\\t}\\n351\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"29748b91-283e-4097-bcb3-33b0be9e7cd0\",\"timestamp\":\"2026-06-12T23:21:18.758Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts\",\"content\":\"// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\n// driven once, in PI-extension call order, against one real SDK\\n// configuration with the deterministic provider — zero network, zero real\\n// provider, no mocks anywhere. The script owns the sequence and the phase\\n// names (tech design Flow 5); assertions live in the driving tests, so the\\n// replay, teardown, and process legs all run THIS sequence rather than a\\n// re-described one (DD-8).\\n//\\n// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\n// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\n//\\n// Mode is background — the production posture the PI extension will run —\\n// and the drain/rebuild phases settle through `drainSettled`, the real\\n// background awaitable. The post-mutation health snapshot (AC-5.2's\\n// \\\"cleared set pending\\\") is deterministic because every SDK operation here\\n// is synchronous SQLite chained through microtasks, while a background\\n// drain pass always starts on a macrotask (scheduler runLoop defers through\\n// setImmediate): the edit → delete → health reads inside the mutate phase\\n// run as one unbroken microtask cascade and complete before the poked drain\\n// can claim its first item. The rebuild phase then yields via drainSettled\\n// and the drain runs to empty.\\nimport { join } from \\\"node:path\\\";\\nimport {\\n  createDeterministicProvider,\\n  createSdk,\\n  type BatchResult,\\n  type CompactReceipt,\\n  type FormReportEntry,\\n  type HealthReport,\\n  type InspectOverview,\\n  type Lhc,\\n  type MessageEventInput,\\n  type MutationResult,\\n  type OpResult,\\n  type PullResult,\\n  type ViewContentsReport,\\n  type ViewStatus,\\n} from \\\"../../src/index.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\n// ── the one SDK configuration (AC-5.1) ────────────────────────────\\n//\\n// Deterministic provider injected at construction (the only provider-arrival\\n// path since the CLI retired), background mode, zero-backoff retry so a\\n// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\n// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\n// a named \\\"lifecycle\\\" profile so compact runs profile-addressed (story\\n// scope: \\\"compact (profile)\\\") with all three lower bands non-empty on this\\n// thread (Epic 03 Story 2's reference gradient).\\nexport const LIFECYCLE_PROFILE = {\\n  name: \\\"lifecycle\\\",\\n  lowerBound: 400,\\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\n} as const;\\n\\nexport function createLifecycleSdk(): Lhc {\\n  return createSdk({\\n    provider: createDeterministicProvider(),\\n    mode: \\\"background\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n    view: {\\n      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\n      // Low threshold so the status checkpoint genuinely recommends the\\n      // compact the sequence performs next.\\n      compactThreshold: 300,\\n    },\\n  });\\n}\\n\\n// ── the recorded conversation ─────────────────────────────────────\\n//\\n// Same shape and text profile as the Epic 03 derived-thread fixture (12\\n// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\n// policy cuts the same 4-chunk shape — but with explicit per-run\\n// idempotency keys so a replay on a fresh thread records byte-identical\\n// event payloads regardless of any process-global fixture counters.\\nconst TURN_COUNT = 12;\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\nconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\n\\n// Mutation targets: both in the post-compact tail (compact point at t9's\\n// start under the lifecycle profile), so the second compact's pull shows the\\n// edit verbatim and the deletion's absence — the tail is full fidelity.\\nexport const EDIT_TARGET = { turnId: \\\"t12\\\", kind: \\\"user_prompt\\\" } as const;\\nexport const EDITED_MESSAGE_TEXT =\\n  \\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\";\\nexport const DELETE_TARGET = { turnId: \\\"t10\\\", kind: \\\"assistant_text\\\" } as const;\\nexport const DELETED_MESSAGE_TEXT = \\\"findings for area 10\\\";\\n\\nfunction turnEvents(turn: number): MessageEventInput[] {\\n  let seq = 0;\\n  const key = (): string => {\\n    seq += 1;\\n    return `lc-t${turn}-e${seq}`;\\n  };\\n  const events: MessageEventInput[] = [\\n    validEvent(\\\"user_prompt\\\", {\\n      idempotencyKey: key(),\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n    }),\\n    validEvent(\\\"assistant_thinking\\\", {\\n      idempotencyKey: key(),\\n      payload: { text: `considering what area ${turn} contains` },\\n    }),\\n  ];\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    for (const run of [1, 2]) {\\n      const toolCallId = `call-lc-${turn}-${run}`;\\n      events.push(\\n        validEvent(\\\"tool_call\\\", {\\n          idempotencyKey: key(),\\n          payload: {\\n            toolCallId,\\n            toolName: \\\"read_file\\\",\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\n          },\\n        }),\\n        validEvent(\\\"tool_result\\\", {\\n          idempotencyKey: key(),\\n          payload: {\\n            toolCallId,\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n            isError: false,\\n          },\\n        }),\\n      );\\n    }\\n  }\\n  events.push(\\n    validEvent(\\\"assistant_text\\\", {\\n      idempotencyKey: key(),\\n      payload: { text: `findings for area ${turn}` },\\n    }),\\n    validEvent(\\\"turn_end\\\", { idempotencyKey: key() }),\\n  );\\n  return events;\\n}\\n\\nfunction intakeBatches(): MessageEventInput[][] {\\n  const batches: MessageEventInput[][] = [];\\n  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\n    const batch: MessageEventInput[] = [];\\n    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\n      batch.push(...turnEvents(turn));\\n    }\\n    batches.push(batch);\\n  }\\n  return batches;\\n}\\n\\n// ── run shape ─────────────────────────────────────────────────────\\n\\nexport interface LifecyclePhases {\\n  create: OpResult<{ threadId: string; filePath: string }>;\\n  intake: Array<OpResult<BatchResult>>;\\n  drain: { settled: true };\\n  status: OpResult<ViewStatus>;\\n  compact1: OpResult<CompactReceipt>;\\n  pull1: OpResult<PullResult>;\\n  inspect1: {\\n    overview: OpResult<InspectOverview>;\\n    view: OpResult<ViewContentsReport>;\\n    health: OpResult<HealthReport>;\\n  };\\n  mutate: {\\n    editedMessageId: string;\\n    deletedMessageId: string;\\n    edit: OpResult<MutationResult>;\\n    delete: OpResult<MutationResult>;\\n    // Captured inside the mutate phase, before the background drain's first\\n    // macrotask: the cleared-set-pending evidence (AC-5.2).\\n    healthAfterMutate: OpResult<HealthReport>;\\n    messagesNotReady: OpResult<FormReportEntry[]>;\\n    turnsNotReady: OpResult<FormReportEntry[]>;\\n  };\\n  rebuild: { settled: true };\\n  health2: OpResult<HealthReport>;\\n  compact2: OpResult<CompactReceipt>;\\n  pull2: OpResult<PullResult>;\\n  materialize: OpResult<{ writtenPath: string }>;\\n}\\n\\nexport type LifecycleCheckpoint = \\\"inspect1\\\" | \\\"health2\\\" | \\\"materialize\\\";\\n\\nexport interface LifecycleOptions {\\n  // Distinguishes the thread file and materialize target so replay and\\n  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\n  name?: string;\\n  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\n  // render phase groups — every group boundary is a quiescent point (no\\n  // queued work, no running drain), so the abandoned instance can never act\\n  // after its group ends.\\n  freshSdkBetweenGroups?: boolean;\\n  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\n  onCheckpoint?: (\\n    checkpoint: LifecycleCheckpoint,\\n    ctx: { sdk: Lhc; filePath: string },\\n  ) => Promise<void>;\\n}\\n\\nexport interface LifecycleRun {\\n  filePath: string;\\n  outPath: string;\\n  threadId: string;\\n  phases: LifecyclePhases;\\n}\\n\\nfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\n  if (!result.ok) {\\n    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\n  }\\n  return result.value;\\n}\\n\\n// ── the sequence ──────────────────────────────────────────────────\\n\\nexport async function runLifecycle(\\n  store: TempStore,\\n  opts: LifecycleOptions = {},\\n): Promise<LifecycleRun> {\\n  const name = opts.name ?? \\\"lifecycle\\\";\\n  const filePath = store.threadPath(name);\\n  const outPath = join(store.dir, `${name}-session.jsonl`);\\n  const ref = { filePath };\\n\\n  let sdk = createLifecycleSdk();\\n  const nextGroup = (): void => {\\n    // The fresh instance is the same configuration assembled again — the\\n    // continuity proof is that no phase depends on the prior instance's\\n    // memory, only on the thread file.\\n    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\n  };\\n  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\n    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\n  };\\n\\n  // ── group 1: create → intake → drain → status ──\\n  const create = await sdk.threads.newThread({\\n    filePath,\\n    registryPath: store.registryPath,\\n  });\\n  const threadId = expectOk(create, \\\"create\\\").threadId;\\n\\n  const intake: Array<OpResult<BatchResult>> = [];\\n  for (const batch of intakeBatches()) {\\n    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\n    intake.push(sent);\\n    expectOk(sent, \\\"intake\\\");\\n  }\\n\\n  // Background drain settles (story scope): the intake pokes scheduled the\\n  // work; this is the await that lets the scheduler run it to empty.\\n  await sdk.drainSettled(ref);\\n  const drain = { settled: true } as const;\\n\\n  const status = await sdk.threadView.status(ref);\\n  expectOk(status, \\\"status\\\");\\n\\n  // ── group 2: compact1 → pull1 → inspect1 ──\\n  nextGroup();\\n  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n  expectOk(compact1, \\\"compact1\\\");\\n  const pull1 = await sdk.threadView.pull(ref);\\n  expectOk(pull1, \\\"pull1\\\");\\n  const inspect1 = {\\n    overview: await sdk.inspect.overview(ref),\\n    view: await sdk.inspect.view(ref),\\n    health: await sdk.inspect.health(ref),\\n  };\\n  expectOk(inspect1.overview, \\\"inspect1.overview\\\");\\n  expectOk(inspect1.view, \\\"inspect1.view\\\");\\n  expectOk(inspect1.health, \\\"inspect1.health\\\");\\n  await checkpoint(\\\"inspect1\\\");\\n\\n  // ── group 3: mutate → rebuild → health2 ──\\n  nextGroup();\\n  const listed = expectOk(await sdk.messages.listMessages(ref), \\\"mutate.list\\\");\\n  const editTarget = listed.find(\\n    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\n  );\\n  const deleteTarget = listed.find(\\n    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\n  );\\n  if (editTarget === undefined || deleteTarget === undefined) {\\n    throw new Error(\\\"lifecycle invariant: edit/delete targets not found in the record\\\");\\n  }\\n  // Edit, delete, and the pending-state reads run in one microtask cascade\\n  // (see module header): the snapshot is taken before the poked background\\n  // drain starts its first pass.\\n  const edit = await sdk.messages.edit(ref, {\\n    messageId: editTarget.messageId,\\n    content: EDITED_MESSAGE_TEXT,\\n  });\\n  expectOk(edit, \\\"mutate.edit\\\");\\n  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\n  expectOk(deleted, \\\"mutate.delete\\\");\\n  const mutate: LifecyclePhases[\\\"mutate\\\"] = {\\n    editedMessageId: editTarget.messageId,\\n    deletedMessageId: deleteTarget.messageId,\\n    edit,\\n    delete: deleted,\\n    healthAfterMutate: await sdk.inspect.health(ref),\\n    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\n    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\n  };\\n  expectOk(mutate.healthAfterMutate, \\\"mutate.health\\\");\\n  expectOk(mutate.messagesNotReady, \\\"mutate.messagesNotReady\\\");\\n  expectOk(mutate.turnsNotReady, \\\"mutate.turnsNotReady\\\");\\n\\n  // Rebuild drains: the mutations' pokes already scheduled the cascade\\n  // rebuilds on THIS instance's scheduler; settle is the production await.\\n  await sdk.drainSettled(ref);\\n  const rebuild = { settled: true } as const;\\n\\n  const health2 = await sdk.inspect.health(ref);\\n  expectOk(health2, \\\"health2\\\");\\n  await checkpoint(\\\"health2\\\");\\n\\n  // ── group 4: compact2 → pull2 → materialize ──\\n  nextGroup();\\n  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n  expectOk(compact2, \\\"compact2\\\");\\n  const pull2 = await sdk.threadView.pull(ref);\\n  expectOk(pull2, \\\"pull2\\\");\\n  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\n  expectOk(materialize, \\\"materialize\\\");\\n  await checkpoint(\\\"materialize\\\");\\n\\n  return {\\n    filePath,\\n    outPath,\\n    threadId,\\n    phases: {\\n      create,\\n      intake,\\n      drain,\\n      status,\\n      compact1,\\n      pull1,\\n      inspect1,\\n      mutate,\\n      rebuild,\\n      health2,\\n      compact2,\\n      pull2,\\n      materialize,\\n    },\\n  };\\n}\\n\",\"numLines\":351,\"startLine\":1,\"totalLines\":351}}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:313:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01SJiViszn1dPMaUZaFJuxGD\",\"type\":\"tool_result\",\"content\":\"1\\t// The real provider (DD-2): createInferenceProvider returns the same\\n2\\t// DerivationProvider interface the deterministic provider implements, so\\n3\\t// createSdk and everything below it see a provider, full stop. Every\\n4\\t// operation is the same five-step pipeline (Flow 2): bound the input where\\n5\\t// DD-7 applies, render the kind's prompt template into single-turn messages,\\n6\\t// call the host ModelCall with the kind's assignment, reject empty or\\n7\\t// whitespace-only text as empty_output (AC-2.4), and return the shaped text\\n8\\t// with config-known provenance (AC-2.5). The adapter never parses model text\\n9\\t// for outcomes, receipts, or any mechanical fact — those stay\\n10\\t// handler-authored from the record. Host containment (thrown exceptions,\\n11\\t// the adapter-owned timeout) lives in safeCall (AC-3.3, DD-6).\\n12\\timport type {\\n13\\t  DerivationProvider,\\n14\\t  FormKind,\\n15\\t  ProviderResult,\\n16\\t} from \\\"../shared/derivation.js\\\";\\n17\\timport { FAILURE_CLASSIFICATION, safeCall } from \\\"./classify.js\\\";\\n18\\timport { PROMPT_REGISTRY, type PromptTemplate } from \\\"./prompts/index.js\\\";\\n19\\timport type { ModelCallFailureKind, ResolvedInferenceConfig } from \\\"./types.js\\\";\\n20\\t\\n21\\t// DD-7: a pathological tool result must not blow a small-context model.\\n22\\t// Content over the bound keeps its head and tail around a marker, and the\\n23\\t// bounded whole stays within maxInputChars; bounding happens before prompt\\n24\\t// rendering, so the dropped middle never crosses the boundary.\\n25\\tfunction boundContent(content: string, maxInputChars: number): string {\\n26\\t  if (content.length <= maxInputChars) return content;\\n27\\t  const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\\n28\\t  // The marker only earns its place when head + marker + tail still fits the\\n29\\t  // bound. When maxInputChars is smaller than the marker itself, there is no\\n30\\t  // budget for the marker — emitting it would be the one path that crosses the\\n31\\t  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\\n32\\t  // honors the cap exactly.\\n33\\t  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\\n34\\t  const keep = maxInputChars - marker.length;\\n35\\t  const head = Math.ceil(keep / 2);\\n36\\t  const tail = keep - head;\\n37\\t  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\\n38\\t}\\n39\\t\\n40\\t// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\\n41\\t// has, and the reason string is machine-readable by the established\\n42\\t// code-before-first-colon convention. Retryable failures lead with\\n43\\t// `provider_failure` — the code Epic 02 has always landed on exhausted forms\\n44\\t// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\\n45\\t// with the failure kind named next; terminal kinds lead with the kind itself\\n46\\t// and land failed immediately.\\n47\\tfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\\n48\\t  const { retryable } = FAILURE_CLASSIFICATION[kind];\\n49\\t  const detail = message === \\\"\\\" ? kind : `${kind}: ${message}`;\\n50\\t  return {\\n51\\t    ok: false,\\n52\\t    retryable,\\n53\\t    reason: retryable ? `provider_failure: ${detail}` : detail,\\n54\\t  };\\n55\\t}\\n56\\t\\n57\\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\\n58\\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\\n59\\t    const assignment = config.assignments[kind];\\n60\\t    // Construction validated the name (AC-1.3); a miss here is registry\\n61\\t    // drift after construction and is terminal, never retried into.\\n62\\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\\n63\\t    if (template === undefined) {\\n64\\t      return classifiedFailure(\\n65\\t        \\\"invalid_request\\\",\\n66\\t        `prompt template \\\"${assignment.prompt}\\\" not in registry`,\\n67\\t      );\\n68\\t    }\\n69\\t    const messages = template.render(input);\\n70\\t    // safeCall contains the host (AC-3.3, DD-6): thrown exceptions arrive as\\n71\\t    // structured `other` failures and a hung function loses the timeout race\\n72\\t    // as `timeout` — both flow through the same classification below.\\n73\\t    const result = await safeCall(\\n74\\t      config.call,\\n75\\t      { provider: assignment.provider, model: assignment.model, messages },\\n76\\t      config.timeoutMs,\\n77\\t    );\\n78\\t    if (!result.ok) {\\n79\\t      return classifiedFailure(result.kind, result.message);\\n80\\t    }\\n81\\t    // Shaping: surrounding whitespace never becomes form content — and a\\n82\\t    // model that returned nothing but whitespace has not produced a\\n83\\t    // derivation (AC-2.4): a classified retryable failure, never a ready\\n84\\t    // form. `empty_output` is adapter-generated; hosts never return it.\\n85\\t    const text = result.text.trim();\\n86\\t    if (text === \\\"\\\") {\\n87\\t      return classifiedFailure(\\\"empty_output\\\", \\\"model returned empty or whitespace-only text\\\");\\n88\\t    }\\n89\\t    // Provenance is the assignment's three config-known strings, copied —\\n90\\t    // never authored from model output (DD-4).\\n91\\t    return {\\n92\\t      ok: true,\\n93\\t      text,\\n94\\t      provenance: {\\n95\\t        provider: assignment.provider,\\n96\\t        model: assignment.model,\\n97\\t        prompt: assignment.prompt,\\n98\\t      },\\n99\\t    };\\n100\\t  };\\n101\\t\\n102\\t  return {\\n103\\t    smoothPrompt: (i) => callKind(\\\"smoothed_prompt\\\", i),\\n104\\t    summarizeToolCall: (i) => callKind(\\\"tool_call_summary\\\", i),\\n105\\t    summarizeToolResult: (i) =>\\n106\\t      callKind(\\\"tool_result_summary\\\", {\\n107\\t        toolName: i.toolName,\\n108\\t        content: boundContent(i.content, config.maxInputChars),\\n109\\t      }),\\n110\\t    composeTurnRendering: (i) => callKind(\\\"turn_rendering\\\", i),\\n111\\t    projectLowerBand: (i) => callKind(\\\"lower_band_projection\\\", i),\\n112\\t    summarizeChunkDetailed: (i) => callKind(\\\"chunk_summary_detailed\\\", i),\\n113\\t    summarizeChunkBrief: (i) => callKind(\\\"chunk_summary_brief\\\", i),\\n114\\t  };\\n115\\t}\\n116\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"7b94c013-940e-44a2-9042-7629ef13990d\",\"timestamp\":\"2026-06-12T23:22:41.200Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/adapter.ts\",\"content\":\"// The real provider (DD-2): createInferenceProvider returns the same\\n// DerivationProvider interface the deterministic provider implements, so\\n// createSdk and everything below it see a provider, full stop. Every\\n// operation is the same five-step pipeline (Flow 2): bound the input where\\n// DD-7 applies, render the kind's prompt template into single-turn messages,\\n// call the host ModelCall with the kind's assignment, reject empty or\\n// whitespace-only text as empty_output (AC-2.4), and return the shaped text\\n// with config-known provenance (AC-2.5). The adapter never parses model text\\n// for outcomes, receipts, or any mechanical fact — those stay\\n// handler-authored from the record. Host containment (thrown exceptions,\\n// the adapter-owned timeout) lives in safeCall (AC-3.3, DD-6).\\nimport type {\\n  DerivationProvider,\\n  FormKind,\\n  ProviderResult,\\n} from \\\"../shared/derivation.js\\\";\\nimport { FAILURE_CLASSIFICATION, safeCall } from \\\"./classify.js\\\";\\nimport { PROMPT_REGISTRY, type PromptTemplate } from \\\"./prompts/index.js\\\";\\nimport type { ModelCallFailureKind, ResolvedInferenceConfig } from \\\"./types.js\\\";\\n\\n// DD-7: a pathological tool result must not blow a small-context model.\\n// Content over the bound keeps its head and tail around a marker, and the\\n// bounded whole stays within maxInputChars; bounding happens before prompt\\n// rendering, so the dropped middle never crosses the boundary.\\nfunction boundContent(content: string, maxInputChars: number): string {\\n  if (content.length <= maxInputChars) return content;\\n  const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\\n  // The marker only earns its place when head + marker + tail still fits the\\n  // bound. When maxInputChars is smaller than the marker itself, there is no\\n  // budget for the marker — emitting it would be the one path that crosses the\\n  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\\n  // honors the cap exactly.\\n  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\\n  const keep = maxInputChars - marker.length;\\n  const head = Math.ceil(keep / 2);\\n  const tail = keep - head;\\n  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\\n}\\n\\n// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\\n// has, and the reason string is machine-readable by the established\\n// code-before-first-colon convention. Retryable failures lead with\\n// `provider_failure` — the code Epic 02 has always landed on exhausted forms\\n// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\\n// with the failure kind named next; terminal kinds lead with the kind itself\\n// and land failed immediately.\\nfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\\n  const { retryable } = FAILURE_CLASSIFICATION[kind];\\n  const detail = message === \\\"\\\" ? kind : `${kind}: ${message}`;\\n  return {\\n    ok: false,\\n    retryable,\\n    reason: retryable ? `provider_failure: ${detail}` : detail,\\n  };\\n}\\n\\nexport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\\n  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\\n    const assignment = config.assignments[kind];\\n    // Construction validated the name (AC-1.3); a miss here is registry\\n    // drift after construction and is terminal, never retried into.\\n    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\\n    if (template === undefined) {\\n      return classifiedFailure(\\n        \\\"invalid_request\\\",\\n        `prompt template \\\"${assignment.prompt}\\\" not in registry`,\\n      );\\n    }\\n    const messages = template.render(input);\\n    // safeCall contains the host (AC-3.3, DD-6): thrown exceptions arrive as\\n    // structured `other` failures and a hung function loses the timeout race\\n    // as `timeout` — both flow through the same classification below.\\n    const result = await safeCall(\\n      config.call,\\n      { provider: assignment.provider, model: assignment.model, messages },\\n      config.timeoutMs,\\n    );\\n    if (!result.ok) {\\n      return classifiedFailure(result.kind, result.message);\\n    }\\n    // Shaping: surrounding whitespace never becomes form content — and a\\n    // model that returned nothing but whitespace has not produced a\\n    // derivation (AC-2.4): a classified retryable failure, never a ready\\n    // form. `empty_output` is adapter-generated; hosts never return it.\\n    const text = result.text.trim();\\n    if (text === \\\"\\\") {\\n      return classifiedFailure(\\\"empty_output\\\", \\\"model returned empty or whitespace-only text\\\");\\n    }\\n    // Provenance is the assignment's three config-known strings, copied —\\n    // never authored from model output (DD-4).\\n    return {\\n      ok: true,\\n      text,\\n      provenance: {\\n        provider: assignment.provider,\\n        model: assignment.model,\\n        prompt: assignment.prompt,\\n      },\\n    };\\n  };\\n\\n  return {\\n    smoothPrompt: (i) => callKind(\\\"smoothed_prompt\\\", i),\\n    summarizeToolCall: (i) => callKind(\\\"tool_call_summary\\\", i),\\n    summarizeToolResult: (i) =>\\n      callKind(\\\"tool_result_summary\\\", {\\n        toolName: i.toolName,\\n        content: boundContent(i.content, config.maxInputChars),\\n      }),\\n    composeTurnRendering: (i) => callKind(\\\"turn_rendering\\\", i),\\n    projectLowerBand: (i) => callKind(\\\"lower_band_projection\\\", i),\\n    summarizeChunkDetailed: (i) => callKind(\\\"chunk_summary_detailed\\\", i),\\n    summarizeChunkBrief: (i) => callKind(\\\"chunk_summary_brief\\\", i),\\n  };\\n}\\n\",\"numLines\":116,\"startLine\":1,\"totalLines\":116}}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:338:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_011kjwgfWLgef2WbEHvGpXRA\",\"type\":\"tool_result\",\"content\":\"1\\t// Story 4 (Epic 04), default suite: TC-5.1–5.3 — the full-surface lifecycle\\n2\\t// exercise. One scripted sequence (test/fixtures/lifecycle.ts) drives every\\n3\\t// built v1 surface in PI-extension call order against one real SDK\\n4\\t// configuration with the registry's deterministic provider: zero network and\\n5\\t// zero real-provider calls are structural (no other provider exists in the\\n6\\t// configuration), and every checkpoint assertion lives here, not in the\\n7\\t// script, so the replay (TC-5.2), teardown (TC-5.3), and process (TC-5.4,\\n8\\t// cli-process-inspect.test.ts) legs replay the same sequence.\\n9\\t//\\n10\\t// Determinism control: the wall clock is the one ambient input the built\\n11\\t// surfaces stamp into outputs (event recorded_at, view created_at, mutation\\n12\\t// timestamps), so this file freezes Date — and only Date; the scheduler's\\n13\\t// real setImmediate/setTimeout stay live for the background drains. With\\n14\\t// the clock frozen, pull outputs are byte-identical across runs with no\\n15\\t// normalization at all.\\n16\\t//\\n17\\t// One pinned deviation (AC-5.3/AC-5.4 file equality): a thread's id is the\\n18\\t// design's ONE random value (threads design decision 7), and the PI session\\n19\\t// header embeds it (`id: \\\"<threadId>:<timestamp>\\\"`). Two real threads cannot\\n20\\t// share an id through the public surface, so the materialized-file equality\\n21\\t// here substitutes each run's own thread id with a fixed placeholder and\\n22\\t// requires every other byte identical. Nothing else is normalized.\\n23\\timport { createHash } from \\\"node:crypto\\\";\\n24\\timport { readFileSync } from \\\"node:fs\\\";\\n25\\timport { afterAll, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\n26\\timport {\\n27\\t  estimateTokens,\\n28\\t  type FormReportEntry,\\n29\\t  type HealthReport,\\n30\\t  type MutationResult,\\n31\\t  type OpResult,\\n32\\t  type PullResult,\\n33\\t  type SweepReceipt,\\n34\\t  type ViewMessage,\\n35\\t} from \\\"../src/index.js\\\";\\n36\\timport {\\n37\\t  DELETED_MESSAGE_TEXT,\\n38\\t  EDITED_MESSAGE_TEXT,\\n39\\t  LIFECYCLE_PROFILE,\\n40\\t  runLifecycle,\\n41\\t  tempStore,\\n42\\t  type LifecycleRun,\\n43\\t  type TempStore,\\n44\\t} from \\\"./fixtures/index.js\\\";\\n45\\t\\n46\\tlet store: TempStore;\\n47\\tlet run: LifecycleRun;\\n48\\t\\n49\\tbeforeAll(async () => {\\n50\\t  vi.useFakeTimers({ toFake: [\\\"Date\\\"] });\\n51\\t  vi.setSystemTime(new Date(\\\"2026-06-12T00:00:00.000Z\\\"));\\n52\\t  store = tempStore();\\n53\\t  run = await runLifecycle(store, { name: \\\"baseline\\\" });\\n54\\t}, 60000);\\n55\\tafterAll(() => {\\n56\\t  vi.useRealTimers();\\n57\\t  store.cleanup();\\n58\\t});\\n59\\t\\n60\\tfunction ok<T>(result: OpResult<T>): T {\\n61\\t  if (!result.ok) {\\n62\\t    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\\n63\\t  }\\n64\\t  return result.value;\\n65\\t}\\n66\\t\\n67\\tfunction sha256(value: string): string {\\n68\\t  return createHash(\\\"sha256\\\").update(value).digest(\\\"hex\\\");\\n69\\t}\\n70\\t\\n71\\tfunction measured(messages: readonly ViewMessage[]): number {\\n72\\t  return messages.reduce((sum, message) => sum + estimateTokens(message.content), 0);\\n73\\t}\\n74\\t\\n75\\tfunction clearedKeys(...mutations: MutationResult[]): string[] {\\n76\\t  return mutations\\n77\\t    .flatMap((mutation) => mutation.cleared)\\n78\\t    .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\\n79\\t    .sort();\\n80\\t}\\n81\\t\\n82\\tfunction pendingKeys(...reports: Array<readonly FormReportEntry[]>): string[] {\\n83\\t  return reports\\n84\\t    .flat()\\n85\\t    .filter((entry) => entry.state === \\\"pending\\\")\\n86\\t    .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\\n87\\t    .sort();\\n88\\t}\\n89\\t\\n90\\ttype SweepLine = SweepReceipt[\\\"owners\\\"][number];\\n91\\tfunction byOwnerKind(rows: readonly SweepLine[]): SweepLine[] {\\n92\\t  return [...rows].sort((a, b) =>\\n93\\t    `${a.owner}/${a.kind}`.localeCompare(`${b.owner}/${b.kind}`),\\n94\\t  );\\n95\\t}\\n96\\t\\n97\\t// The materialized file with the run's own thread id substituted — the one\\n98\\t// sanctioned normalization (see header).\\n99\\tfunction comparableSessionFile(lifecycleRun: LifecycleRun): string {\\n100\\t  return readFileSync(lifecycleRun.outPath, \\\"utf8\\\").replaceAll(\\n101\\t    lifecycleRun.threadId,\\n102\\t    \\\"<thread-id>\\\",\\n103\\t  );\\n104\\t}\\n105\\t\\n106\\tdescribe(\\\"TC-5.1 / AC-5.1: the full sequence completes ok through one SDK configuration\\\", () => {\\n107\\t  it(\\\"every phase operation returns ok with the deterministic provider only\\\", () => {\\n108\\t    const { phases } = run;\\n109\\t    expect(phases.create.ok).toBe(true);\\n110\\t    for (const batch of phases.intake) expect(batch.ok).toBe(true);\\n111\\t    expect(phases.drain.settled).toBe(true);\\n112\\t    expect(phases.status.ok).toBe(true);\\n113\\t    expect(phases.compact1.ok).toBe(true);\\n114\\t    expect(phases.pull1.ok).toBe(true);\\n115\\t    expect(phases.inspect1.overview.ok).toBe(true);\\n116\\t    expect(phases.inspect1.view.ok).toBe(true);\\n117\\t    expect(phases.inspect1.health.ok).toBe(true);\\n118\\t    expect(phases.mutate.edit.ok).toBe(true);\\n119\\t    expect(phases.mutate.delete.ok).toBe(true);\\n120\\t    expect(phases.mutate.healthAfterMutate.ok).toBe(true);\\n121\\t    expect(phases.rebuild.settled).toBe(true);\\n122\\t    expect(phases.health2.ok).toBe(true);\\n123\\t    expect(phases.compact2.ok).toBe(true);\\n124\\t    expect(phases.pull2.ok).toBe(true);\\n125\\t    expect(phases.materialize.ok).toBe(true);\\n126\\t  });\\n127\\t\\n128\\t  it(\\\"status recommends the compact the sequence performs next, with derivation settled\\\", () => {\\n129\\t    const status = ok(run.phases.status);\\n130\\t    expect(status.threshold).toBe(300);\\n131\\t    expect(status.tailTokens).toBeGreaterThan(status.threshold);\\n132\\t    expect(status.compactRecommended).toBe(true);\\n133\\t    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\\n134\\t    expect(status.view).toBeNull(); // not yet compacted at this checkpoint\\n135\\t  });\\n136\\t});\\n137\\t\\n138\\tdescribe(\\\"TC-5.1 / AC-5.2: checkpoint coherence across the sequence\\\", () => {\\n139\\t  it(\\\"post-compact pull serves bands + tail, and the view report's loadCost prices that pull\\\", () => {\\n140\\t    const receipt = ok(run.phases.compact1);\\n141\\t    expect(receipt.profile).toBe(LIFECYCLE_PROFILE.name);\\n142\\t    const pull = ok(run.phases.pull1);\\n143\\t\\n144\\t    // Bands open the array in gradient order; the tail follows in record\\n145\\t    // order — the served shape the PI extension will consume.\\n146\\t    const bands = pull.messages.filter((message) => message.band !== undefined);\\n147\\t    expect(bands.map((message) => message.band)).toEqual([\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"]);\\n148\\t    expect(pull.messages.slice(0, bands.length)).toEqual(bands);\\n149\\t    const tail = pull.messages.slice(bands.length);\\n150\\t    expect(tail.length).toBeGreaterThan(0);\\n151\\t    expect(tail.every((message) => message.band === undefined)).toBe(true);\\n152\\t    expect(pull.meta.viewId).toBe(receipt.viewId);\\n153\\t    expect(pull.meta.compactPoint).toBe(receipt.compactPoint);\\n154\\t\\n155\\t    // Cross-epic loadCost checkpoint (test plan: report at compact1 vs\\n156\\t    // pull1): the inspect report's serving cost equals this independent\\n157\\t    // pull re-measured with the shared estimator.\\n158\\t    const report = ok(run.phases.inspect1.view);\\n159\\t    expect(report.meta?.viewId).toBe(receipt.viewId);\\n160\\t    expect(report.meta?.profile).toBe(LIFECYCLE_PROFILE.name);\\n161\\t    expect(report.loadCost.bandTokens).toBe(measured(bands));\\n162\\t    expect(report.loadCost.tailTokens).toBe(measured(tail));\\n163\\t    expect(report.loadCost.total).toBe(measured(pull.messages));\\n164\\t\\n165\\t    // Overview agrees on the same view identity with derivation settled.\\n166\\t    const overview = ok(run.phases.inspect1.overview);\\n167\\t    expect(overview.view?.viewId).toBe(receipt.viewId);\\n168\\t    expect(overview.derivation.pending).toBe(0);\\n169\\t    expect(overview.messages.deleted).toBe(0);\\n170\\t  });\\n171\\t\\n172\\t  it(\\\"post-mutation health shows exactly the cleared set pending; post-drain health shows it ready\\\", () => {\\n173\\t    const { mutate } = run.phases;\\n174\\t    const edit = ok(mutate.edit);\\n175\\t    const deleted = ok(mutate.delete);\\n176\\t    expect(edit.superseded).toEqual([]);\\n177\\t    expect(deleted.superseded).toEqual([]);\\n178\\t    // The deleted assistant_text owns no derived forms: its cascade clears\\n179\\t    // sibling turn forms only.\\n180\\t    expect(deleted.dropped).toEqual([]);\\n181\\t\\n182\\t    // The cascade contracts' cleared union IS the pending set the owners\\n183\\t    // report — no more, no less (AC-5.2's \\\"the cleared set pending\\\").\\n184\\t    const cleared = clearedKeys(edit, deleted);\\n185\\t    expect(cleared.length).toBeGreaterThan(0);\\n186\\t    const pending = pendingKeys(ok(mutate.messagesNotReady), ok(mutate.turnsNotReady));\\n187\\t    expect(pending).toEqual(cleared);\\n188\\t\\n189\\t    // Health joins the same truth: pending counts sum to the cleared set,\\n190\\t    // with the queued replacement work live and unclaimed (the background\\n191\\t    // drain has not started — the snapshot precedes its first pass).\\n192\\t    const health = ok(mutate.healthAfterMutate);\\n193\\t    const pendingTotal = health.owners.reduce(\\n194\\t      (sum, row) => sum + row.counts.pending + row.counts.retrying,\\n195\\t      0,\\n196\\t    );\\n197\\t    expect(pendingTotal).toBe(cleared.length);\\n198\\t    // Queue visibility is counted per report entry (AC-4.5's by-construction\\n199\\t    // consistency), so queued equals the pending entries — all unclaimed.\\n200\\t    expect(health.queue).toEqual({ queued: cleared.length, claimed: 0 });\\n201\\t    expect(edit.queued.length).toBeGreaterThan(0);\\n202\\t    expect(deleted.queued.length).toBeGreaterThan(0);\\n203\\t    expect(health.failures).toEqual([]);\\n204\\t\\n205\\t    // Post-drain (rebuild settled): everything ready, nothing failed,\\n206\\t    // queue empty.\\n207\\t    const after = ok(run.phases.health2);\\n208\\t    for (const row of after.owners) {\\n209\\t      expect(row.counts.pending).toBe(0);\\n210\\t      expect(row.counts.retrying).toBe(0);\\n211\\t      expect(row.counts.failed).toBe(0);\\n212\\t      expect(row.counts.blocked).toBe(0);\\n213\\t      expect(row.counts.ready).toBeGreaterThan(0);\\n214\\t    }\\n215\\t    expect(after.failures).toEqual([]);\\n216\\t    expect(after.repairPreview).toEqual([]);\\n217\\t    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\\n218\\t  });\\n219\\t\\n220\\t  it(\\\"the second compact's view reflects post-edit content\\\", () => {\\n221\\t    const pull1 = ok(run.phases.pull1);\\n222\\t    const pull2 = ok(run.phases.pull2);\\n223\\t\\n224\\t    // Before the mutations: the original prompt and the to-be-deleted text\\n225\\t    // are served verbatim in the tail (full fidelity).\\n226\\t    expect(\\n227\\t      pull1.messages.some((m) => m.content === \\\"turn 12: please investigate area 12\\\"),\\n228\\t    ).toBe(true);\\n229\\t    expect(pull1.messages.some((m) => m.content === DELETED_MESSAGE_TEXT)).toBe(true);\\n230\\t\\n231\\t    // After mutate + rebuild + compact2: the edited prompt serves verbatim,\\n232\\t    // the deleted message is gone from the served view entirely.\\n233\\t    expect(\\n234\\t      pull2.messages.some(\\n235\\t        (m) => m.band === undefined && m.role === \\\"user\\\" && m.content === EDITED_MESSAGE_TEXT,\\n236\\t      ),\\n237\\t    ).toBe(true);\\n238\\t    expect(pull2.messages.some((m) => m.content.includes(DELETED_MESSAGE_TEXT))).toBe(false);\\n239\\t    expect(\\n240\\t      pull2.messages.some((m) => m.content === \\\"turn 12: please investigate area 12\\\"),\\n241\\t    ).toBe(false);\\n242\\t  });\\n243\\t\\n244\\t  it(\\\"the second compact receipt's sweep section agrees with the health report taken immediately before it\\\", () => {\\n245\\t    const receipt = ok(run.phases.compact2);\\n246\\t    const health: HealthReport = ok(run.phases.health2);\\n247\\t    expect(\\\"owners\\\" in receipt.sweep).toBe(true);\\n248\\t    const sweep = receipt.sweep as SweepReceipt;\\n249\\t\\n250\\t    // Field-level agreement per owner/kind: the sweep saw exactly the state\\n251\\t    // health reported — same ready counts, in-flight = pending + retrying,\\n252\\t    // and the failed/requeued/blocked sets empty on both sides.\\n253\\t    const expectedFromHealth = health.owners.map((row) => ({\\n254\\t      owner: row.owner,\\n255\\t      kind: row.kind,\\n256\\t      ready: row.counts.ready,\\n257\\t      inFlight: row.counts.pending + row.counts.retrying,\\n258\\t      requeued: [],\\n259\\t      blocked: [],\\n260\\t      permanentFailed: [],\\n261\\t    }));\\n262\\t    expect(byOwnerKind(sweep.owners)).toEqual(byOwnerKind(expectedFromHealth));\\n263\\t    expect(health.failures).toEqual([]);\\n264\\t  });\\n265\\t});\\n266\\t\\n267\\tdescribe(\\\"TC-5.2 / AC-5.3: replay determinism on a fresh thread\\\", () => {\\n268\\t  it(\\\"produces hash-equal pull outputs and a byte-identical materialized file (modulo the one random thread id)\\\", async () => {\\n269\\t    const replay = await runLifecycle(store, { name: \\\"replay\\\" });\\n270\\t\\n271\\t    // Pull outputs: exact hash equality, no normalization — the frozen\\n272\\t    // clock leaves no ambient input, so any inequality is real\\n273\\t    // nondeterminism in the built surfaces.\\n274\\t    const pulls: Array<[OpResult<PullResult>, OpResult<PullResult>]> = [\\n275\\t      [run.phases.pull1, replay.phases.pull1],\\n276\\t      [run.phases.pull2, replay.phases.pull2],\\n277\\t    ];\\n278\\t    for (const [original, replayed] of pulls) {\\n279\\t      expect(sha256(JSON.stringify(ok(replayed)))).toBe(sha256(JSON.stringify(ok(original))));\\n280\\t    }\\n281\\t\\n282\\t    // Materialized file: identical bytes after substituting each thread's\\n283\\t    // own id (the header's one random value — see file header note).\\n284\\t    expect(replay.threadId).not.toBe(run.threadId);\\n285\\t    expect(sha256(comparableSessionFile(replay))).toBe(sha256(comparableSessionFile(run)));\\n286\\t  }, 60000);\\n287\\t});\\n288\\t\\n289\\tdescribe(\\\"TC-5.3 / AC-5.4: teardown continuity — fresh createSdk between phase groups\\\", () => {\\n290\\t  it(\\\"yields final pull, health, and materialized file identical to the uninterrupted run's\\\", async () => {\\n291\\t    const teardown = await runLifecycle(store, {\\n292\\t      name: \\\"teardown\\\",\\n293\\t      freshSdkBetweenGroups: true,\\n294\\t    });\\n295\\t\\n296\\t    // No in-memory dependency: the end state lives in the thread file, so a\\n297\\t    // fresh instance continuing each phase group lands byte-identical.\\n298\\t    expect(JSON.stringify(ok(teardown.phases.pull2))).toBe(\\n299\\t      JSON.stringify(ok(run.phases.pull2)),\\n300\\t    );\\n301\\t    expect(ok(teardown.phases.health2)).toEqual(ok(run.phases.health2));\\n302\\t    expect(sha256(comparableSessionFile(teardown))).toBe(sha256(comparableSessionFile(run)));\\n303\\t  }, 60000);\\n304\\t});\\n305\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"2fb5daed-7804-4147-ad7c-34ef527c28fa\",\"timestamp\":\"2026-06-12T23:22:47.194Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/lifecycle.test.ts\",\"content\":\"// Story 4 (Epic 04), default suite: TC-5.1–5.3 — the full-surface lifecycle\\n// exercise. One scripted sequence (test/fixtures/lifecycle.ts) drives every\\n// built v1 surface in PI-extension call order against one real SDK\\n// configuration with the registry's deterministic provider: zero network and\\n// zero real-provider calls are structural (no other provider exists in the\\n// configuration), and every checkpoint assertion lives here, not in the\\n// script, so the replay (TC-5.2), teardown (TC-5.3), and process (TC-5.4,\\n// cli-process-inspect.test.ts) legs replay the same sequence.\\n//\\n// Determinism control: the wall clock is the one ambient input the built\\n// surfaces stamp into outputs (event recorded_at, view created_at, mutation\\n// timestamps), so this file freezes Date — and only Date; the scheduler's\\n// real setImmediate/setTimeout stay live for the background drains. With\\n// the clock frozen, pull outputs are byte-identical across runs with no\\n// normalization at all.\\n//\\n// One pinned deviation (AC-5.3/AC-5.4 file equality): a thread's id is the\\n// design's ONE random value (threads design decision 7), and the PI session\\n// header embeds it (`id: \\\"<threadId>:<timestamp>\\\"`). Two real threads cannot\\n// share an id through the public surface, so the materialized-file equality\\n// here substitutes each run's own thread id with a fixed placeholder and\\n// requires every other byte identical. Nothing else is normalized.\\nimport { createHash } from \\\"node:crypto\\\";\\nimport { readFileSync } from \\\"node:fs\\\";\\nimport { afterAll, beforeAll, describe, expect, it, vi } from \\\"vitest\\\";\\nimport {\\n  estimateTokens,\\n  type FormReportEntry,\\n  type HealthReport,\\n  type MutationResult,\\n  type OpResult,\\n  type PullResult,\\n  type SweepReceipt,\\n  type ViewMessage,\\n} from \\\"../src/index.js\\\";\\nimport {\\n  DELETED_MESSAGE_TEXT,\\n  EDITED_MESSAGE_TEXT,\\n  LIFECYCLE_PROFILE,\\n  runLifecycle,\\n  tempStore,\\n  type LifecycleRun,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\nlet store: TempStore;\\nlet run: LifecycleRun;\\n\\nbeforeAll(async () => {\\n  vi.useFakeTimers({ toFake: [\\\"Date\\\"] });\\n  vi.setSystemTime(new Date(\\\"2026-06-12T00:00:00.000Z\\\"));\\n  store = tempStore();\\n  run = await runLifecycle(store, { name: \\\"baseline\\\" });\\n}, 60000);\\nafterAll(() => {\\n  vi.useRealTimers();\\n  store.cleanup();\\n});\\n\\nfunction ok<T>(result: OpResult<T>): T {\\n  if (!result.ok) {\\n    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\\n  }\\n  return result.value;\\n}\\n\\nfunction sha256(value: string): string {\\n  return createHash(\\\"sha256\\\").update(value).digest(\\\"hex\\\");\\n}\\n\\nfunction measured(messages: readonly ViewMessage[]): number {\\n  return messages.reduce((sum, message) => sum + estimateTokens(message.content), 0);\\n}\\n\\nfunction clearedKeys(...mutations: MutationResult[]): string[] {\\n  return mutations\\n    .flatMap((mutation) => mutation.cleared)\\n    .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\\n    .sort();\\n}\\n\\nfunction pendingKeys(...reports: Array<readonly FormReportEntry[]>): string[] {\\n  return reports\\n    .flat()\\n    .filter((entry) => entry.state === \\\"pending\\\")\\n    .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\\n    .sort();\\n}\\n\\ntype SweepLine = SweepReceipt[\\\"owners\\\"][number];\\nfunction byOwnerKind(rows: readonly SweepLine[]): SweepLine[] {\\n  return [...rows].sort((a, b) =>\\n    `${a.owner}/${a.kind}`.localeCompare(`${b.owner}/${b.kind}`),\\n  );\\n}\\n\\n// The materialized file with the run's own thread id substituted — the one\\n// sanctioned normalization (see header).\\nfunction comparableSessionFile(lifecycleRun: LifecycleRun): string {\\n  return readFileSync(lifecycleRun.outPath, \\\"utf8\\\").replaceAll(\\n    lifecycleRun.threadId,\\n    \\\"<thread-id>\\\",\\n  );\\n}\\n\\ndescribe(\\\"TC-5.1 / AC-5.1: the full sequence completes ok through one SDK configuration\\\", () => {\\n  it(\\\"every phase operation returns ok with the deterministic provider only\\\", () => {\\n    const { phases } = run;\\n    expect(phases.create.ok).toBe(true);\\n    for (const batch of phases.intake) expect(batch.ok).toBe(true);\\n    expect(phases.drain.settled).toBe(true);\\n    expect(phases.status.ok).toBe(true);\\n    expect(phases.compact1.ok).toBe(true);\\n    expect(phases.pull1.ok).toBe(true);\\n    expect(phases.inspect1.overview.ok).toBe(true);\\n    expect(phases.inspect1.view.ok).toBe(true);\\n    expect(phases.inspect1.health.ok).toBe(true);\\n    expect(phases.mutate.edit.ok).toBe(true);\\n    expect(phases.mutate.delete.ok).toBe(true);\\n    expect(phases.mutate.healthAfterMutate.ok).toBe(true);\\n    expect(phases.rebuild.settled).toBe(true);\\n    expect(phases.health2.ok).toBe(true);\\n    expect(phases.compact2.ok).toBe(true);\\n    expect(phases.pull2.ok).toBe(true);\\n    expect(phases.materialize.ok).toBe(true);\\n  });\\n\\n  it(\\\"status recommends the compact the sequence performs next, with derivation settled\\\", () => {\\n    const status = ok(run.phases.status);\\n    expect(status.threshold).toBe(300);\\n    expect(status.tailTokens).toBeGreaterThan(status.threshold);\\n    expect(status.compactRecommended).toBe(true);\\n    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\\n    expect(status.view).toBeNull(); // not yet compacted at this checkpoint\\n  });\\n});\\n\\ndescribe(\\\"TC-5.1 / AC-5.2: checkpoint coherence across the sequence\\\", () => {\\n  it(\\\"post-compact pull serves bands + tail, and the view report's loadCost prices that pull\\\", () => {\\n    const receipt = ok(run.phases.compact1);\\n    expect(receipt.profile).toBe(LIFECYCLE_PROFILE.name);\\n    const pull = ok(run.phases.pull1);\\n\\n    // Bands open the array in gradient order; the tail follows in record\\n    // order — the served shape the PI extension will consume.\\n    const bands = pull.messages.filter((message) => message.band !== undefined);\\n    expect(bands.map((message) => message.band)).toEqual([\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"]);\\n    expect(pull.messages.slice(0, bands.length)).toEqual(bands);\\n    const tail = pull.messages.slice(bands.length);\\n    expect(tail.length).toBeGreaterThan(0);\\n    expect(tail.every((message) => message.band === undefined)).toBe(true);\\n    expect(pull.meta.viewId).toBe(receipt.viewId);\\n    expect(pull.meta.compactPoint).toBe(receipt.compactPoint);\\n\\n    // Cross-epic loadCost checkpoint (test plan: report at compact1 vs\\n    // pull1): the inspect report's serving cost equals this independent\\n    // pull re-measured with the shared estimator.\\n    const report = ok(run.phases.inspect1.view);\\n    expect(report.meta?.viewId).toBe(receipt.viewId);\\n    expect(report.meta?.profile).toBe(LIFECYCLE_PROFILE.name);\\n    expect(report.loadCost.bandTokens).toBe(measured(bands));\\n    expect(report.loadCost.tailTokens).toBe(measured(tail));\\n    expect(report.loadCost.total).toBe(measured(pull.messages));\\n\\n    // Overview agrees on the same view identity with derivation settled.\\n    const overview = ok(run.phases.inspect1.overview);\\n    expect(overview.view?.viewId).toBe(receipt.viewId);\\n    expect(overview.derivation.pending).toBe(0);\\n    expect(overview.messages.deleted).toBe(0);\\n  });\\n\\n  it(\\\"post-mutation health shows exactly the cleared set pending; post-drain health shows it ready\\\", () => {\\n    const { mutate } = run.phases;\\n    const edit = ok(mutate.edit);\\n    const deleted = ok(mutate.delete);\\n    expect(edit.superseded).toEqual([]);\\n    expect(deleted.superseded).toEqual([]);\\n    // The deleted assistant_text owns no derived forms: its cascade clears\\n    // sibling turn forms only.\\n    expect(deleted.dropped).toEqual([]);\\n\\n    // The cascade contracts' cleared union IS the pending set the owners\\n    // report — no more, no less (AC-5.2's \\\"the cleared set pending\\\").\\n    const cleared = clearedKeys(edit, deleted);\\n    expect(cleared.length).toBeGreaterThan(0);\\n    const pending = pendingKeys(ok(mutate.messagesNotReady), ok(mutate.turnsNotReady));\\n    expect(pending).toEqual(cleared);\\n\\n    // Health joins the same truth: pending counts sum to the cleared set,\\n    // with the queued replacement work live and unclaimed (the background\\n    // drain has not started — the snapshot precedes its first pass).\\n    const health = ok(mutate.healthAfterMutate);\\n    const pendingTotal = health.owners.reduce(\\n      (sum, row) => sum + row.counts.pending + row.counts.retrying,\\n      0,\\n    );\\n    expect(pendingTotal).toBe(cleared.length);\\n    // Queue visibility is counted per report entry (AC-4.5's by-construction\\n    // consistency), so queued equals the pending entries — all unclaimed.\\n    expect(health.queue).toEqual({ queued: cleared.length, claimed: 0 });\\n    expect(edit.queued.length).toBeGreaterThan(0);\\n    expect(deleted.queued.length).toBeGreaterThan(0);\\n    expect(health.failures).toEqual([]);\\n\\n    // Post-drain (rebuild settled): everything ready, nothing failed,\\n    // queue empty.\\n    const after = ok(run.phases.health2);\\n    for (const row of after.owners) {\\n      expect(row.counts.pending).toBe(0);\\n      expect(row.counts.retrying).toBe(0);\\n      expect(row.counts.failed).toBe(0);\\n      expect(row.counts.blocked).toBe(0);\\n      expect(row.counts.ready).toBeGreaterThan(0);\\n    }\\n    expect(after.failures).toEqual([]);\\n    expect(after.repairPreview).toEqual([]);\\n    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\\n  });\\n\\n  it(\\\"the second compact's view reflects post-edit content\\\", () => {\\n    const pull1 = ok(run.phases.pull1);\\n    const pull2 = ok(run.phases.pull2);\\n\\n    // Before the mutations: the original prompt and the to-be-deleted text\\n    // are served verbatim in the tail (full fidelity).\\n    expect(\\n      pull1.messages.some((m) => m.content === \\\"turn 12: please investigate area 12\\\"),\\n    ).toBe(true);\\n    expect(pull1.messages.some((m) => m.content === DELETED_MESSAGE_TEXT)).toBe(true);\\n\\n    // After mutate + rebuild + compact2: the edited prompt serves verbatim,\\n    // the deleted message is gone from the served view entirely.\\n    expect(\\n      pull2.messages.some(\\n        (m) => m.band === undefined && m.role === \\\"user\\\" && m.content === EDITED_MESSAGE_TEXT,\\n      ),\\n    ).toBe(true);\\n    expect(pull2.messages.some((m) => m.content.includes(DELETED_MESSAGE_TEXT))).toBe(false);\\n    expect(\\n      pull2.messages.some((m) => m.content === \\\"turn 12: please investigate area 12\\\"),\\n    ).toBe(false);\\n  });\\n\\n  it(\\\"the second compact receipt's sweep section agrees with the health report taken immediately before it\\\", () => {\\n    const receipt = ok(run.phases.compact2);\\n    const health: HealthReport = ok(run.phases.health2);\\n    expect(\\\"owners\\\" in receipt.sweep).toBe(true);\\n    const sweep = receipt.sweep as SweepReceipt;\\n\\n    // Field-level agreement per owner/kind: the sweep saw exactly the state\\n    // health reported — same ready counts, in-flight = pending + retrying,\\n    // and the failed/requeued/blocked sets empty on both sides.\\n    const expectedFromHealth = health.owners.map((row) => ({\\n      owner: row.owner,\\n      kind: row.kind,\\n      ready: row.counts.ready,\\n      inFlight: row.counts.pending + row.counts.retrying,\\n      requeued: [],\\n      blocked: [],\\n      permanentFailed: [],\\n    }));\\n    expect(byOwnerKind(sweep.owners)).toEqual(byOwnerKind(expectedFromHealth));\\n    expect(health.failures).toEqual([]);\\n  });\\n});\\n\\ndescribe(\\\"TC-5.2 / AC-5.3: replay determinism on a fresh thread\\\", () => {\\n  it(\\\"produces hash-equal pull outputs and a byte-identical materialized file (modulo the one random thread id)\\\", async () => {\\n    const replay = await runLifecycle(store, { name: \\\"replay\\\" });\\n\\n    // Pull outputs: exact hash equality, no normalization — the frozen\\n    // clock leaves no ambient input, so any inequality is real\\n    // nondeterminism in the built surfaces.\\n    const pulls: Array<[OpResult<PullResult>, OpResult<PullResult>]> = [\\n      [run.phases.pull1, replay.phases.pull1],\\n      [run.phases.pull2, replay.phases.pull2],\\n    ];\\n    for (const [original, replayed] of pulls) {\\n      expect(sha256(JSON.stringify(ok(replayed)))).toBe(sha256(JSON.stringify(ok(original))));\\n    }\\n\\n    // Materialized file: identical bytes after substituting each thread's\\n    // own id (the header's one random value — see file header note).\\n    expect(replay.threadId).not.toBe(run.threadId);\\n    expect(sha256(comparableSessionFile(replay))).toBe(sha256(comparableSessionFile(run)));\\n  }, 60000);\\n});\\n\\ndescribe(\\\"TC-5.3 / AC-5.4: teardown continuity — fresh createSdk between phase groups\\\", () => {\\n  it(\\\"yields final pull, health, and materialized file identical to the uninterrupted run's\\\", async () => {\\n    const teardown = await runLifecycle(store, {\\n      name: \\\"teardown\\\",\\n      freshSdkBetweenGroups: true,\\n    });\\n\\n    // No in-memory dependency: the end state lives in the thread file, so a\\n    // fresh instance continuing each phase group lands byte-identical.\\n    expect(JSON.stringify(ok(teardown.phases.pull2))).toBe(\\n      JSON.stringify(ok(run.phases.pull2)),\\n    );\\n    expect(ok(teardown.phases.health2)).toEqual(ok(run.phases.health2));\\n    expect(sha256(comparableSessionFile(teardown))).toBe(sha256(comparableSessionFile(run)));\\n  }, 60000);\\n});\\n\",\"numLines\":305,\"startLine\":1,\"totalLines\":305}}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:356:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_01NKdrBTAh4MrJm5fPskwbAd\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_018BCQBJCPDhpFM3FZuc9iQ9\",\"name\":\"Bash\",\"input\":{\"command\":\"cd /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc && grep -n \\\"export\\\" test/fixtures/index.ts | head -40; echo \\\"---\\\"; grep -n \\\"readDerivedForms\\\\|interface DerivedForm\\\\b\\\" test/fixtures/threads.ts src/index.ts src/shared/derivation.ts | head; echo \\\"---\\\"; env | grep -i \\\"OPENROUTER\\\" ; echo \\\"key-check-done\\\"\",\"description\":\"Check fixture exports and OpenRouter env key\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":6250,\"cache_read_input_tokens\":82269,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":6250},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"8911b80d-9ab5-4184-80b8-b032b773db48\",\"request_id\":\"req_011CbzE4ppQg9Z68iD5tg6cH\"}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:360:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"file_path\\\": \\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/deterministic.ts\"}},\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"parent_tool_use_id\":null,\"uuid\":\"798736c7-007a-41d4-b530-282f04efe0b6\"}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:363:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_01NKdrBTAh4MrJm5fPskwbAd\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01AKE1kN1hMriZN69jQwNq8N\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/deterministic.ts\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":6250,\"cache_read_input_tokens\":82269,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":6250},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"6e263ebe-a886-4471-999b-14783af3ae9f\",\"request_id\":\"req_011CbzE4ppQg9Z68iD5tg6cH\"}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:367:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01AKE1kN1hMriZN69jQwNq8N\",\"type\":\"tool_result\",\"content\":\"1\\t// The deterministic provider: marked, input-derived output for every seam\\n2\\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\\n3\\t// functions of the input. It backs the named-provider registry's\\n4\\t// \\\"deterministic\\\" entry (DD-11) so spawned-CLI tests exercise the production\\n5\\t// resolution seam, and the test double reuses these helpers so in-process and\\n6\\t// spawned runs produce byte-identical artifacts. It is selectable only by\\n7\\t// explicit name — never a production default.\\n8\\timport type {\\n9\\t  DerivationProvider,\\n10\\t  ProviderResult,\\n11\\t  RenderingPart,\\n12\\t  ToolOutcome,\\n13\\t  ToolRunReceipt,\\n14\\t} from \\\"../shared/derivation.js\\\";\\n15\\t\\n16\\texport type DeterministicOpName =\\n17\\t  | \\\"smoothPrompt\\\"\\n18\\t  | \\\"summarizeToolCall\\\"\\n19\\t  | \\\"summarizeToolResult\\\"\\n20\\t  | \\\"composeTurnRendering\\\"\\n21\\t  | \\\"projectLowerBand\\\"\\n22\\t  | \\\"summarizeChunkDetailed\\\"\\n23\\t  | \\\"summarizeChunkBrief\\\";\\n24\\t\\n25\\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\\n26\\t  smoothPrompt: \\\"smoothed\\\",\\n27\\t  summarizeToolCall: \\\"toolcall\\\",\\n28\\t  summarizeToolResult: \\\"toolresult\\\",\\n29\\t  composeTurnRendering: \\\"rendering\\\",\\n30\\t  projectLowerBand: \\\"projection\\\",\\n31\\t  summarizeChunkDetailed: \\\"detailed\\\",\\n32\\t  summarizeChunkBrief: \\\"brief\\\",\\n33\\t};\\n34\\t\\n35\\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\\n36\\t// input-sensitive enough that distinct inputs mark distinct outputs.\\n37\\texport function deterministicDigest(input: unknown): string {\\n38\\t  const text = JSON.stringify(input);\\n39\\t  let hash = 0x811c9dc5;\\n40\\t  for (let i = 0; i < text.length; i += 1) {\\n41\\t    hash ^= text.charCodeAt(i);\\n42\\t    hash = Math.imul(hash, 0x01000193) >>> 0;\\n43\\t  }\\n44\\t  return hash.toString(16).padStart(8, \\\"0\\\");\\n45\\t}\\n46\\t\\n47\\texport function deterministicText(\\n48\\t  op: DeterministicOpName,\\n49\\t  input: unknown,\\n50\\t  text: string,\\n51\\t): string {\\n52\\t  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\\n53\\t}\\n54\\t\\n55\\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\\n56\\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\\n57\\t}\\n58\\t\\n59\\t// The chunk-summary contract made visible in deterministic output (AC-3.8):\\n60\\t// the detailed summary's artifact carries the members' tool-run receipts —\\n61\\t// account and outcome — verbatim; the brief summary's carries outcomes\\n62\\t// only. Pure suffixes over the input fields, shared with the test double so\\n63\\t// in-process and spawned artifacts stay byte-identical; empty receipt sets\\n64\\t// add nothing, keeping receipt-less output unchanged.\\n65\\texport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\\n66\\t  const receipts = (memberReceipts ?? []).flat();\\n67\\t  if (receipts.length === 0) return \\\"\\\";\\n68\\t  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\\\"; \\\")}]`;\\n69\\t}\\n70\\t\\n71\\texport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\\n72\\t  const outcomes = (memberOutcomes ?? []).flat();\\n73\\t  if (outcomes.length === 0) return \\\"\\\";\\n74\\t  return `[outcomes ${outcomes.join(\\\",\\\")}]`;\\n75\\t}\\n76\\t\\n77\\texport function createDeterministicProvider(): DerivationProvider {\\n78\\t  return {\\n79\\t    smoothPrompt: (i: { text: string }) => ok(\\\"smoothPrompt\\\", i, i.text),\\n80\\t    summarizeToolCall: (i: {\\n81\\t      toolName: string;\\n82\\t      argsJson: string;\\n83\\t      pairedResult?: { content: string; isError: boolean };\\n84\\t    }) => ok(\\\"summarizeToolCall\\\", i, `${i.toolName} ${i.argsJson}`),\\n85\\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\\n86\\t      ok(\\\"summarizeToolResult\\\", i, i.content),\\n87\\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\\n88\\t      ok(\\\"composeTurnRendering\\\", i, i.parts.map((p) => p.text).join(\\\" | \\\")),\\n89\\t    projectLowerBand: (i: { rendering: string }) => ok(\\\"projectLowerBand\\\", i, i.rendering),\\n90\\t    summarizeChunkDetailed: async (i: {\\n91\\t      memberProjections: string[];\\n92\\t      memberReceipts?: ToolRunReceipt[][];\\n93\\t    }) => {\\n94\\t      const base = await ok(\\\"summarizeChunkDetailed\\\", i, i.memberProjections.join(\\\" | \\\"));\\n95\\t      if (!base.ok) return base;\\n96\\t      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\\n97\\t    },\\n98\\t    summarizeChunkBrief: async (i: {\\n99\\t      memberProjections: string[];\\n100\\t      memberOutcomes?: ToolOutcome[][];\\n101\\t    }) => {\\n102\\t      const base = await ok(\\\"summarizeChunkBrief\\\", i, i.memberProjections.join(\\\" | \\\"));\\n103\\t      if (!base.ok) return base;\\n104\\t      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\\n105\\t    },\\n106\\t  };\\n107\\t}\\n108\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"uuid\":\"4282d03a-9107-4558-b0ca-cdebf760cd19\",\"timestamp\":\"2026-06-12T23:22:55.384Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/deterministic.ts\",\"content\":\"// The deterministic provider: marked, input-derived output for every seam\\n// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\\n// functions of the input. It backs the named-provider registry's\\n// \\\"deterministic\\\" entry (DD-11) so spawned-CLI tests exercise the production\\n// resolution seam, and the test double reuses these helpers so in-process and\\n// spawned runs produce byte-identical artifacts. It is selectable only by\\n// explicit name — never a production default.\\nimport type {\\n  DerivationProvider,\\n  ProviderResult,\\n  RenderingPart,\\n  ToolOutcome,\\n  ToolRunReceipt,\\n} from \\\"../shared/derivation.js\\\";\\n\\nexport type DeterministicOpName =\\n  | \\\"smoothPrompt\\\"\\n  | \\\"summarizeToolCall\\\"\\n  | \\\"summarizeToolResult\\\"\\n  | \\\"composeTurnRendering\\\"\\n  | \\\"projectLowerBand\\\"\\n  | \\\"summarizeChunkDetailed\\\"\\n  | \\\"summarizeChunkBrief\\\";\\n\\nexport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\\n  smoothPrompt: \\\"smoothed\\\",\\n  summarizeToolCall: \\\"toolcall\\\",\\n  summarizeToolResult: \\\"toolresult\\\",\\n  composeTurnRendering: \\\"rendering\\\",\\n  projectLowerBand: \\\"projection\\\",\\n  summarizeChunkDetailed: \\\"detailed\\\",\\n  summarizeChunkBrief: \\\"brief\\\",\\n};\\n\\n// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\\n// input-sensitive enough that distinct inputs mark distinct outputs.\\nexport function deterministicDigest(input: unknown): string {\\n  const text = JSON.stringify(input);\\n  let hash = 0x811c9dc5;\\n  for (let i = 0; i < text.length; i += 1) {\\n    hash ^= text.charCodeAt(i);\\n    hash = Math.imul(hash, 0x01000193) >>> 0;\\n  }\\n  return hash.toString(16).padStart(8, \\\"0\\\");\\n}\\n\\nexport function deterministicText(\\n  op: DeterministicOpName,\\n  input: unknown,\\n  text: string,\\n): string {\\n  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\\n}\\n\\nfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\\n  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\\n}\\n\\n// The chunk-summary contract made visible in deterministic output (AC-3.8):\\n// the detailed summary's artifact carries the members' tool-run receipts —\\n// account and outcome — verbatim; the brief summary's carries outcomes\\n// only. Pure suffixes over the input fields, shared with the test double so\\n// in-process and spawned artifacts stay byte-identical; empty receipt sets\\n// add nothing, keeping receipt-less output unchanged.\\nexport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\\n  const receipts = (memberReceipts ?? []).flat();\\n  if (receipts.length === 0) return \\\"\\\";\\n  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\\\"; \\\")}]`;\\n}\\n\\nexport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\\n  const outcomes = (memberOutcomes ?? []).flat();\\n  if (outcomes.length === 0) return \\\"\\\";\\n  return `[outcomes ${outcomes.join(\\\",\\\")}]`;\\n}\\n\\nexport function createDeterministicProvider(): DerivationProvider {\\n  return {\\n    smoothPrompt: (i: { text: string }) => ok(\\\"smoothPrompt\\\", i, i.text),\\n    summarizeToolCall: (i: {\\n      toolName: string;\\n      argsJson: string;\\n      pairedResult?: { content: string; isError: boolean };\\n    }) => ok(\\\"summarizeToolCall\\\", i, `${i.toolName} ${i.argsJson}`),\\n    summarizeToolResult: (i: { toolName: string; content: string }) =>\\n      ok(\\\"summarizeToolResult\\\", i, i.content),\\n    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\\n      ok(\\\"composeTurnRendering\\\", i, i.parts.map((p) => p.text).join(\\\" | \\\")),\\n    projectLowerBand: (i: { rendering: string }) => ok(\\\"projectLowerBand\\\", i, i.rendering),\\n    summarizeChunkDetailed: async (i: {\\n      memberProjections: string[];\\n      memberReceipts?: ToolRunReceipt[][];\\n    }) => {\\n      const base = await ok(\\\"summarizeChunkDetailed\\\", i, i.memberProjections.join(\\\" | \\\"));\\n      if (!base.ok) return base;\\n      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\\n    },\\n    summarizeChunkBrief: async (i: {\\n      memberProjections: string[];\\n      memberOutcomes?: ToolOutcome[][];\\n    }) => {\\n      const base = await ok(\\\"summarizeChunkBrief\\\", i, i.memberProjections.join(\\\" | \\\"));\\n      if (!base.ok) return base;\\n      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\\n    },\\n  };\\n}\\n\",\"numLines\":108,\"startLine\":1,\"totalLines\":108}}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:391:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"null | head; grep -rn \\\\\\\"LHC_OPENROUTER\\\\\\\" ~/.zshrc ~/.zshenv ~/.zprofile 2>/d\"}},\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"parent_tool_use_id\":null,\"uuid\":\"da54e6ba-aa03-4f88-a486-1e9555c5758c\"}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:393:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\", \\\"description\\\": \\\"Look for OpenRouter key in env files\"}},\"session_id\":\"7428c05c-eec6-4310-9738-8828ad5ff5b2\",\"parent_tool_use_id\":null,\"uuid\":\"1216cfc6-f9ea-4fd6-a760-1bedd58ce739\"}\ndocs/02-specs/05-derivation-inference/artifa
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/fixtures/lifecycle.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\n     2\t// driven once, in PI-extension call order, against one real SDK\n     3\t// configuration with the deterministic provider — zero network, zero real\n     4\t// provider, no mocks anywhere. The script owns the sequence and the phase\n     5\t// names (tech design Flow 5); assertions live in the driving tests, so the\n     6\t// replay, teardown, and process legs all run THIS sequence rather than a\n     7\t// re-described one (DD-8).\n     8\t//\n     9\t// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\n    10\t// mutate | rebuild | health2 | compact2 | pull2 | materialize.\n    11\t//\n    12\t// Mode is background — the production posture the PI extension will run —\n    13\t// and the drain/rebuild phases settle through `drainSettled`, the real\n    14\t// background awaitable. The post-mutation health snapshot (AC-5.2's\n    15\t// \"cleared set pending\") is deterministic because every SDK operation here\n    16\t// is synchronous SQLite chained through microtasks, while a background\n    17\t// drain pass always starts on a macrotask (scheduler runLoop defers through\n    18\t// setImmediate): the edit → delete → health reads inside the mutate phase\n    19\t// run as one unbroken microtask cascade and complete before the poked drain\n    20\t// can claim its first item. The rebuild phase then yields via drainSettled\n    21\t// and the drain runs to empty.\n    22\timport { join } from \"node:path\";\n    23\timport {\n    24\t  createDeterministicProvider,\n    25\t  createSdk,\n    26\t  type BatchResult,\n    27\t  type InferenceConfig,\n    28\t  type CompactReceipt,\n    29\t  type FormReportEntry,\n    30\t  type HealthReport,\n    31\t  type InspectOverview,\n    32\t  type Lhc,\n    33\t  type MessageEventInput,\n    34\t  type MutationResult,\n    35\t  type OpResult,\n    36\t  type PullResult,\n    37\t  type ViewContentsReport,\n    38\t  type ViewStatus,\n    39\t} from \"../../src/index.js\";\n    40\timport { validEvent, type TempStore } from \"./index.js\";\n    41\t\n    42\t// ── the one SDK configuration (AC-5.1) ────────────────────────────\n    43\t//\n    44\t// Deterministic provider injected at construction (the only provider-arrival\n    45\t// path since the CLI retired), background mode, zero-backoff retry so a\n    46\t// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\n    47\t// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\n    48\t// a named \"lifecycle\" profile so compact runs profile-addressed (story\n    49\t// scope: \"compact (profile)\") with all three lower bands non-empty on this\n    50\t// thread (Epic 03 Story 2's reference gradient).\n    51\texport const LIFECYCLE_PROFILE = {\n    52\t  name: \"lifecycle\",\n    53\t  lowerBound: 400,\n    54\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n    55\t} as const;\n    56\t\n    57\t// Epic 05 TC-4.2: the capstone replays this exact sequence with the real\n    58\t// inference adapter — the provider-arrival slot is the one swap point; the\n    59\t// sequence, phase names, and every other configuration value stay owned here\n    60\t// so the deterministic leg and the real leg run THE SAME lifecycle.\n    61\texport function createLifecycleSdk(inference?: InferenceConfig): Lhc {\n    62\t  return createSdk({\n    63\t    ...(inference !== undefined\n    64\t      ? { inference }\n    65\t      : { provider: createDeterministicProvider() }),\n    66\t    mode: \"background\",\n    67\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    68\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n    69\t    view: {\n    70\t      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\n    71\t      // Low threshold so the status checkpoint genuinely recommends the\n    72\t      // compact the sequence performs next.\n    73\t      compactThreshold: 300,\n    74\t    },\n    75\t  });\n    76\t}\n    77\t\n    78\t// ── the recorded conversation ─────────────────────────────────────\n    79\t//\n    80\t// Same shape and text profile as the Epic 03 derived-thread fixture (12\n    81\t// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\n    82\t// policy cuts the same 4-chunk shape — but with explicit per-run\n    83\t// idempotency keys so a replay on a fresh thread records byte-identical\n    84\t// event payloads regardless of any process-global fixture counters.\n    85\tconst TURN_COUNT = 12;\n    86\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n    87\tconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\n    88\t\n    89\t// Mutation targets: both in the post-compact tail (compact point at t9's\n    90\t// start under the lifecycle profile), so the second compact's pull shows the\n    91\t// edit verbatim and the deletion's absence — the tail is full fidelity.\n    92\texport const EDIT_TARGET = { turnId: \"t12\", kind: \"user_prompt\" } as const;\n    93\texport const EDITED_MESSAGE_TEXT =\n    94\t  \"turn 12 revised: drop area 12 and re-check area 5 instead\";\n    95\texport const DELETE_TARGET = { turnId: \"t10\", kind: \"assistant_text\" } as const;\n    96\texport const DELETED_MESSAGE_TEXT = \"findings for area 10\";\n    97\t\n    98\tfunction turnEvents(turn: number): MessageEventInput[] {\n    99\t  let seq = 0;\n   100\t  const key = (): string => {\n   101\t    seq += 1;\n   102\t    return `lc-t${turn}-e${seq}`;\n   103\t  };\n   104\t  const events: MessageEventInput[] = [\n   105\t    validEvent(\"user_prompt\", {\n   106\t      idempotencyKey: key(),\n   107\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n   108\t    }),\n   109\t    validEvent(\"assistant_thinking\", {\n   110\t      idempotencyKey: key(),\n   111\t      payload: { text: `considering what area ${turn} contains` },\n   112\t    }),\n   113\t  ];\n   114\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n   115\t    for (const run of [1, 2]) {\n   116\t      const toolCallId = `call-lc-${turn}-${run}`;\n   117\t      events.push(\n   118\t        validEvent(\"tool_call\", {\n   119\t          idempotencyKey: key(),\n   120\t          payload: {\n   121\t            toolCallId,\n   122\t            toolName: \"read_file\",\n   123\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n   124\t          },\n   125\t        }),\n   126\t        validEvent(\"tool_result\", {\n   127\t          idempotencyKey: key(),\n   128\t          payload: {\n   129\t            toolCallId,\n   130\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n   131\t            isError: false,\n   132\t          },\n   133\t        }),\n   134\t      );\n   135\t    }\n   136\t  }\n   137\t  events.push(\n   138\t    validEvent(\"assistant_text\", {\n   139\t      idempotencyKey: key(),\n   140\t      payload: { text: `findings for area ${turn}` },\n   141\t    }),\n   142\t    validEvent(\"turn_end\", { idempotencyKey: key() }),\n   143\t  );\n   144\t  return events;\n   145\t}\n   146\t\n   147\tfunction intakeBatches(): MessageEventInput[][] {\n   148\t  const batches: MessageEventInput[][] = [];\n   149\t  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\n   150\t    const batch: MessageEventInput[] = [];\n   151\t    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\n   152\t      batch.push(...turnEvents(turn));\n   153\t    }\n   154\t    batches.push(batch);\n   155\t  }\n   156\t  return batches;\n   157\t}\n   158\t\n   159\t// ── run shape ─────────────────────────────────────────────────────\n   160\t\n   161\texport interface LifecyclePhases {\n   162\t  create: OpResult<{ threadId: string; filePath: string }>;\n   163\t  intake: Array<OpResult<BatchResult>>;\n   164\t  drain: { settled: true };\n   165\t  status: OpResult<ViewStatus>;\n   166\t  compact1: OpResult<CompactReceipt>;\n   167\t  pull1: OpResult<PullResult>;\n   168\t  inspect1: {\n   169\t    overview: OpResult<InspectOverview>;\n   170\t    view: OpResult<ViewContentsReport>;\n   171\t    health: OpResult<HealthReport>;\n   172\t  };\n   173\t  mutate: {\n   174\t    editedMessageId: string;\n   175\t    deletedMessageId: string;\n   176\t    edit: OpResult<MutationResult>;\n   177\t    delete: OpResult<MutationResult>;\n   178\t    // Captured inside the mutate phase, before the background drain's first\n   179\t    // macrotask: the cleared-set-pending evidence (AC-5.2).\n   180\t    healthAfterMutate: OpResult<HealthReport>;\n   181\t    messagesNotReady: OpResult<FormReportEntry[]>;\n   182\t    turnsNotReady: OpResult<FormReportEntry[]>;\n   183\t  };\n   184\t  rebuild: { settled: true };\n   185\t  health2: OpResult<HealthReport>;\n   186\t  compact2: OpResult<CompactReceipt>;\n   187\t  pull2: OpResult<PullResult>;\n   188\t  materialize: OpResult<{ writtenPath: string }>;\n   189\t}\n   190\t\n   191\texport type LifecycleCheckpoint = \"inspect1\" | \"health2\" | \"materialize\";\n   192\t\n   193\texport interface LifecycleOptions {\n   194\t  // Distinguishes the thread file and materialize target so replay and\n   195\t  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\n   196\t  name?: string;\n   197\t  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\n   198\t  // render phase groups — every group boundary is a quiescent point (no\n   199\t  // queued work, no running drain), so the abandoned instance can never act\n   200\t  // after its group ends.\n   201\t  freshSdkBetweenGroups?: boolean;\n   202\t  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\n   203\t  onCheckpoint?: (\n   204\t    checkpoint: LifecycleCheckpoint,\n   205\t    ctx: { sdk: Lhc; filePath: string },\n   206\t  ) => Promise<void>;\n   207\t  // Epic 05 TC-4.2: run the sequence on the inference path instead of the\n   208\t  // deterministic provider. Same configuration otherwise (see\n   209\t  // createLifecycleSdk).\n   210\t  inference?: InferenceConfig;\n   211\t}\n   212\t\n   213\texport interface LifecycleRun {\n   214\t  filePath: string;\n   215\t  outPath: string;\n   216\t  threadId: string;\n   217\t  phases: LifecyclePhases;\n   218\t}\n   219\t\n   220\tfunction expectOk<T>(result: OpResult<T>, phase: string): T {\n   221\t  if (!result.ok) {\n   222\t    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\n   223\t  }\n   224\t  return result.value;\n   225\t}\n   226\t\n   227\t// ── the sequence ──────────────────────────────────────────────────\n   228\t\n   229\texport async function runLifecycle(\n   230\t  store: TempStore,\n   231\t  opts: LifecycleOptions = {},\n   232\t): Promise<LifecycleRun> {\n   233\t  const name = opts.name ?? \"lifecycle\";\n   234\t  const filePath = store.threadPath(name);\n   235\t  const outPath = join(store.dir, `${name}-session.jsonl`);\n   236\t  const ref = { filePath };\n   237\t\n   238\t  let sdk = createLifecycleSdk(opts.inference);\n   239\t  const nextGroup = (): void => {\n   240\t    // The fresh instance is the same configuration assembled again — the\n   241\t    // continuity proof is that no phase depends on the prior instance's\n   242\t    // memory, only on the thread file.\n   243\t    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk(opts.inference);\n   244\t  };\n   245\t  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\n   246\t    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\n   247\t  };\n   248\t\n   249\t  // ── group 1: create → intake → drain → status ──\n   250\t  const create = await sdk.threads.newThread({\n   251\t    filePath,\n   252\t    registryPath: store.registryPath,\n   253\t  });\n   254\t  const threadId = expectOk(create, \"create\").threadId;\n   255\t\n   256\t  const intake: Array<OpResult<BatchResult>> = [];\n   257\t  for (const batch of intakeBatches()) {\n   258\t    const sent = await sdk.intakeStream.messageEvents(ref, batch);\n   259\t    intake.push(sent);\n   260\t    expectOk(sent, \"intake\");\n   261\t  }\n   262\t\n   263\t  // Background drain settles (story scope): the intake pokes scheduled the\n   264\t  // work; this is the await that lets the scheduler run it to empty.\n   265\t  await sdk.drainSettled(ref);\n   266\t  const drain = { settled: true } as const;\n   267\t\n   268\t  const status = await sdk.threadView.status(ref);\n   269\t  expectOk(status, \"status\");\n   270\t\n   271\t  // ── group 2: compact1 → pull1 → inspect1 ──\n   272\t  nextGroup();\n   273\t  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n   274\t  expectOk(compact1, \"compact1\");\n   275\t  const pull1 = await sdk.threadView.pull(ref);\n   276\t  expectOk(pull1, \"pull1\");\n   277\t  const inspect1 = {\n   278\t    overview: await sdk.inspect.overview(ref),\n   279\t    view: await sdk.inspect.view(ref),\n   280\t    health: await sdk.inspect.health(ref),\n   281\t  };\n   282\t  expectOk(inspect1.overview, \"inspect1.overview\");\n   283\t  expectOk(inspect1.view, \"inspect1.view\");\n   284\t  expectOk(inspect1.health, \"inspect1.health\");\n   285\t  await checkpoint(\"inspect1\");\n   286\t\n   287\t  // ── group 3: mutate → rebuild → health2 ──\n   288\t  nextGroup();\n   289\t  const listed = expectOk(await sdk.messages.listMessages(ref), \"mutate.list\");\n   290\t  const editTarget = listed.find(\n   291\t    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\n   292\t  );\n   293\t  const deleteTarget = listed.find(\n   294\t    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\n   295\t  );\n   296\t  if (editTarget === undefined || deleteTarget === undefined) {\n   297\t    throw new Error(\"lifecycle invariant: edit/delete targets not found in the record\");\n   298\t  }\n   299\t  // Edit, delete, and the pending-state reads run in one microtask cascade\n   300\t  // (see module header): the snapshot is taken before the poked background\n   301\t  // drain starts its first pass.\n   302\t  const edit = await sdk.messages.edit(ref, {\n   303\t    messageId: editTarget.messageId,\n   304\t    content: EDITED_MESSAGE_TEXT,\n   305\t  });\n   306\t  expectOk(edit, \"mutate.edit\");\n   307\t  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\n   308\t  expectOk(deleted, \"mutate.delete\");\n   309\t  const mutate: LifecyclePhases[\"mutate\"] = {\n   310\t    editedMessageId: editTarget.messageId,\n   311\t    deletedMessageId: deleteTarget.messageId,\n   312\t    edit,\n   313\t    delete: deleted,\n   314\t    healthAfterMutate: await sdk.inspect.health(ref),\n   315\t    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\n   316\t    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\n   317\t  };\n   318\t  expectOk(mutate.healthAfterMutate, \"mutate.health\");\n   319\t  expectOk(mutate.messagesNotReady, \"mutate.messagesNotReady\");\n   320\t  expectOk(mutate.turnsNotReady, \"mutate.turnsNotReady\");\n   321\t\n   322\t  // Rebuild drains: the mutations' pokes already scheduled the cascade\n   323\t  // rebuilds on THIS instance's scheduler; settle is the production await.\n   324\t  await sdk.drainSettled(ref);\n   325\t  const rebuild = { settled: true } as const;\n   326\t\n   327\t  const health2 = await sdk.inspect.health(ref);\n   328\t  expectOk(health2, \"health2\");\n   329\t  await checkpoint(\"health2\");\n   330\t\n   331\t  // ── group 4: compact2 → pull2 → materialize ──\n   332\t  nextGroup();\n   333\t  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n   334\t  expectOk(compact2, \"compact2\");\n   335\t  const pull2 = await sdk.threadView.pull(ref);\n   336\t  expectOk(pull2, \"pull2\");\n   337\t  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\n   338\t  expectOk(materialize, \"materialize\");\n   339\t  await checkpoint(\"materialize\");\n   340\t\n   341\t  return {\n   342\t    filePath,\n   343\t    outPath,\n   344\t    threadId,\n   345\t    phases: {\n   346\t      create,\n   347\t      intake,\n   348\t      drain,\n   349\t      status,\n   350\t      compact1,\n   351\t      pull1,\n   352\t      inspect1,\n   353\t      mutate,\n   354\t      rebuild,\n   355\t      health2,\n   356\t      compact2,\n   357\t      pull2,\n   358\t      materialize,\n   359\t    },\n   360\t  };\n","exit_code":0,"status":"completed"}}

ctor: \"fixture-actor\",\n    44\t    harness: \"fixture-harness\",\n    45\t    payload: defaultPayloads[kind](),\n    46\t  };\n    47\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n    48\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n    49\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n    50\t  // parameter types, not this assertion.\n    51\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    52\t}\n    53\t\n    54\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    55\t  return kinds.map((kind) => validEvent(kind));\n    56\t}\n    57\t\n    58\texport function conversationTurn(): MessageEventInput[] {\n    59\t  return eventBatch([\n    60\t    \"user_prompt\",\n    61\t    \"assistant_text\",\n    62\t    \"tool_call\",\n    63\t    \"tool_result\",\n    64\t    \"turn_end\",\n    65\t  ]);\n    66\t}\n    67\t\n    68\texport interface TempStore {\n    69\t  dir: string;\n    70\t  registryPath: string;\n    71\t  threadPath: (name?: string) => string;\n    72\t  cleanup: () => void;\n    73\t}\n    74\t\n    75\texport function tempStore(): TempStore {\n    76\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n    77\t  let threadCounter = 0;\n    78\t  return {\n    79\t    dir,\n    80\t    registryPath: join(dir, \"registry.sqlite\"),\n    81\t    threadPath: (name) => {\n    82\t      threadCounter += 1;\n    83\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    84\t    },\n    85\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n    86\t  };\n    87\t}\n    88\t\n    89\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n    90\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n    91\texport function openRaw(path: string): DatabaseSync {\n    92\t  return new DatabaseSync(path);\n    93\t}\n    94\t\n    95\texport {\n    96\t  corruptTwoOpenTurns,\n    97\t  poisonMessageBlockJson,\n    98\t  poisonMessageFormJson,\n    99\t} from \"./corrupt.js\";\n   100\texport { assertSweepReceiptShape } from \"./receipt-schema.js\";\n   101\texport { assertPiSessionConformance, loadPiSessionFixture } from \"./pi-session-format.js\";\n   102\t// The sweep's classification table, re-exported for the Story 3 unit legs:\n   103\t// fixtures are the one sanctioned bridge across the no-internal-imports\n   104\t// boundary (check-boundaries exempts test/fixtures/ by design), and the\n   105\t// table is exported from sweep.ts for tests by story contract.\n   106\texport {\n   107\t  classifyFailureReason,\n   108\t  REASON_CLASS_TABLE,\n   109\t  type ReasonClass,\n   110\t} from \"../../src/domains/thread-view/internal/sweep.js\";\n   111\texport {\n   112\t  legacyEpic01ThreadFile,\n   113\t  legacyEpic02ThreadFile,\n   114\t  legacyStory2ThreadFile,\n   115\t  schemaVersionOf,\n   116\t  type LegacyRecordedEvent,\n   117\t} from \"./legacy.js\";\n   118\texport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\n   119\texport {\n   120\t  createProviderDouble,\n   121\t  ProviderDouble,\n   122\t  type CapturedInput,\n   123\t  type ProviderOpName,\n   124\t} from \"./provider-double.js\";\n   125\texport {\n   126\t  registerTestWorkHandlers,\n   127\t  testWorkHandlers,\n   128\t  type TestHandlerHooks,\n   129\t} from \"./work-handlers.js\";\n   130\texport {\n   131\t  fireViewInjection,\n   132\t  seedViewBoundary,\n   133\t  setViewInjectionHook,\n   134\t  type ViewInjectionHook,\n   135\t  type ViewInjectionPoint,\n   136\t} from \"./view-seam.js\";\n   137\texport {\n   138\t  blockedSiblingThread,\n   139\t  corruptedVariantThread,\n   140\t  derivedThreadFixture,\n   141\t  mixedStateVariantThread,\n   142\t  mutationInFlightVariant,\n   143\t  PERMANENT_FAILURE_REASON,\n   144\t  stragglerVariantThread,\n   
/dist/shared/derivation.d.ts\npackages/lhc/dist/shared/report.d.ts.map\npackages/lhc/dist/shared/errors.d.ts.map\npackages/lhc/dist/shared/derivation.d.ts.map\npackages/lhc/dist/shared/storage.d.ts.map\npackages/lhc/dist/shared/view.d.ts\npackages/lhc/dist/shared/errors.js.map\npackages/lhc/dist/shared/errors.d.ts\npackages/lhc/dist/shared/view.js.map\npackages/lhc/dist/shared/report.d.ts\npackages/lhc/dist/shared/report.js.map\npackages/lhc/dist/shared/storage.js.map\npackages/lhc/dist/shared/derivation.js\npackages/lhc/dist/inference/types.d.ts\npackages/lhc/dist/inference/types.js.map\npackages/lhc/dist/inference/types.js\npackages/lhc/dist/inference/adapter.js.map\npackages/lhc/dist/inference/adapter.d.ts\npackages/lhc/dist/inference/classify.d.ts.map\npackages/lhc/test/goldens/prompts/tool-call-v1.golden.json\npackages/lhc/test/goldens/prompts/chunk-brief-v1.golden.json\npackages/lhc/test/goldens/prompts/lower-band-v1.golden.json\npackages/lhc/test/goldens/prompts/turn-compose-v1.golden.json\npackages/lhc/test/goldens/prompts/tool-result-v1.golden.json\npackages/lhc/test/goldens/prompts/smoothing-v1.golden.json\n","exit_code":0,"status":"completed"}}

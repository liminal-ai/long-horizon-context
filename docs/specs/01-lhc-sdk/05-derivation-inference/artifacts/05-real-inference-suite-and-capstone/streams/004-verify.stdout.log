: row.subject_kind as SubjectKind,\\n        subjectId: row.subject_id,\\n        form: row.form as FormKind,\\n        state: row.state as DerivedFormState,\\n        sourceVersion: Number(row.source_version),\\n      };\\n      if (row.content !== null) record.content = row.content;\\n      if (row.reason !== null) record.reason = row.reason;\\n      if (row.metadata !== null) {\\n        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\\n      }\\n      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\n      if (row.derived_at !== null) record.derivedAt = row.derived_at;\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:533:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_018NbN4eZ6TDeeZSHFeKDL1u\",\"type\":\"tool_result\",\"content\":\"// Epic 05 Story 2 — TC-1.2 (AC-1.2, AC-1.4): per-call routing through the\\n// inference seam. A recording fake logs every call while a seeded thread\\n// exercises all seven kinds; the assertions inspect the actual serialized\\n// ModelCall input emitted during the drain — never a helper-level intention\\n// (anti-shim). The routing assertions live in the parameterized\\n// seam-conformance helpers so TC-4.3 runs them against the real host\\n// unchanged (DD-13).\\nimport { afterEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  assertModelCallContract,\\n  assertRoutingThroughSdk,\\n  cannedResponses,\\n  FAKE_MODEL_PREFIX,\\n  FAKE_PROVIDER_PREFIX,\\n  FORM_KINDS,\\n  probeInput,\\n  recordingCall,\\n  tempStore,\\n  validAssignments,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\nconst stores: TempStore[] = [];\\nafterEach(() => {\\n  for (const store of stores.splice(0)) store.cleanup();\\n});\\n\\nfunction freshStore(): TempStore {\\n  const store 
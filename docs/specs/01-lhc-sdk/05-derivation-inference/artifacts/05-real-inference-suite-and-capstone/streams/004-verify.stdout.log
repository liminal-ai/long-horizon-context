nt, exercised by the same seam-conformance helpers.\ntest/fixtures/openrouter-call.ts:20:// The suite's cheap default lane; LHC_OPENROUTER_MODEL overrides it for\ntest/fixtures/openrouter-call.ts:33:  const key = env[\"LHC_OPENROUTER_KEY\"];\ntest/fixtures/openrouter-call.ts:35:    return { notRan: \"LHC_OPENROUTER_KEY unset\" };\ntest/fixtures/openrouter-call.ts:37:  const model = env[\"LHC_OPENROUTER_MODEL\"];\ntest/fixtures/openrouter-call.ts:54:      ? `NOT-RAN: real-inference (${env.notRan})`\ntest/fixtures/openrouter-call.ts:55:      : `RAN: real-inference (model ${env.model})`;\ntest/fixtures/openrouter-call.ts:67:// OpenRouter failure mapping (story §Technical Notes): auth-shaped statuses\ntest/fixtures/openrouter-call.ts:94:// createOpenRouterCall(key, defaultModel) implements the ModelCall contract\ntest/fixtures/openrouter-call.ts:96:// (AC-1.2 grants this): OpenRouter takes one model slug, so a `model` string\ntest/fixtures/openrouter-call.ts:98:// including conformance-probe placeholders — falls to the suite's default\ntest/fixtures/openrouter-call.ts:101:export function createOpenRouterCall(key: string, defaultModel: string): ModelCall {\ntest/fixtures/openrouter-call.ts:106:      response = await fetch(OPENROUTER_ENDPOINT, {\nsrc/domains/turns/internal/forms.ts:81:  const placeholders = messageIds.map(() => \"?\").join(\", \");\nsrc/domains/turns/internal/forms.ts:85:       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\ndocs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log:23:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Tu2CqBiuYgPMiKToen3y1z\",\"type\":\"tool_result\",\"content\":\"1\\t// The real provider (DD-2): createInferenceProvider returns the same\\n2\\t// DerivationProvider interface the deterministic provider implements, so\\n3\\t// createSdk and everything below it see a provider, full stop. Every\\n4\\t// operation is the same five-step pipeline (Flow 2): bound the input where\\n5\\t// DD-7 applies, render the kind's prompt template into single-turn messages,\\n6\\t// call the host ModelCall with the kind's assignment, reject empty or\\n7\\t// whitespace-only text as empty_output (AC-2.4), and return the shaped text\\n8\\t// with config-known provenance (AC-2.5). The adapter never parses model text\\n9\\t// for outcomes, receipts, or any mechanical fact — those stay\\n10\\t// handler-authored from the record. The safeCall timeout race (DD-6)\\n11\\t// supersedes the inline thrown-exception containment in the classification\\n12\\t// story.\\n13\\timport type {\\n14\\t  DerivationProvider,\\n15\\t  FormKind,\\n16\\t  ProviderResult,\\n17\\t} from \\\"../shared/derivation.js\\\";\\n18\\timport { FAILURE_CLASSIFICATION } from \\\"./classify.js\\\";\\n19\\timport { PROMPT_REGISTRY, type PromptTemplate } from \\\"./prompts/index.js\\\";\\n20\\timport type {\\n21\\t  ModelCallFailureKind,\\n22\\t  ModelCallResult,\\n23\\t  ResolvedInferenceConfig,\\n24\\t} from \\\"./types.js\\\";\\n25\\t\\n26\\t// DD-7: a pathological tool result must not blow a small-context model.\\n27\\t// Content over the bound keeps its head and tail around a marker, and the\\n28\\t// bounded whole stays within maxInputChars; bounding happens before prompt\\n29\\t// rendering, so the dropped middle never crosses the boundary.\\n30\\tfunction boundContent(content: string, maxInputChars: number): string {\\n31\\t  if (content.length <= maxInputChars) return content;\\n32\\t  const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\\n33\\t  const keep = Math.max(0, maxInputChars - marker.length);\\n34\\t  const head = Math.ceil(keep / 2);\\n35\\t  const tail = keep - head;\\n36\\t  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\\n37\\t}\\n38\\t\\n39\\t// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\\n40\\t// has, and the reason string is machine-readable by the established\\n41\\t// code-before-first-colon convention. Retryable failures lead with\\n42\\t// `provider_failure` — the code Epic 02 has always landed on exhausted forms\\n43\\t// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\\n44\\t// with the failure kind named next; terminal kinds lead with the kind itself\\n45\\t// and land failed immediately.\\n46\\tfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\\n47\\t  const { retryable } = FAILURE_CLASSIFICATION[kind];\\n48\\t  const detail = message === \\\"\\\" ? kind : `${kind}: ${message}`;\\n49\\t  return {\\n50\\t    ok: false,\\n51\\t    retryable,\\n52\\t    reason: retryable ? `provider_failure: ${detail}` : detail,\\n53\\t  };\\n54\\t}\\n55\\t\\n56\\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\\n57\\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\\n58\\t    const assignment = config.assignments[kind];\\n59\\t    // Construction validated the name (AC-1.3); a miss here is registry\\n60\\t    // drift after construction and is terminal, never retried into.\\n61\\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\\n62\\t    if (template === undefined) {\\n63\\t      return classifiedFailure(\\n64\\t        \\\"invalid_request\\\",\\n65\\t        `prompt template \\\"${assignment.prompt}\\\" not in registry`,\\n66\\t      );\\n67\\t    }\\n68\\t    const messages = template.render(input);\\n69\\t    let result: ModelCallResult;\\n70\\t    try {\\n71\\t      result = await config.call({\\n72\\t        provider: assignment.provider,\\n73\\t        model: assignment.model,\\n74\\t        messages,\\n75\\t      });\\n76\\t    } catch (cause) {\\n77\\t      // Thrown host exceptions classify as `other` (AC-3.3); the structured\\n78\\t      // safeCall wrapper (timeout race, DD-6) supersedes this containment in\\n79\\t      // the classification story.\\n80\\t      result = { ok: false, kind: \\\"other\\\", message: String(cause) };\\n81\\t    }\\n82\\t    if (!result.ok) {\\n83\\t      return classifiedFailure(result.kind, result.message);\\n84\\t    }\\n85\\t    // Shaping: surrounding whitespace never becomes form content — and a\\n86\\t    // model that returned nothing but whitespace has not produced a\\n87\\t    // derivation (AC-2.4): a classified retryable failure, never a ready\\n88\\t    // form. `empty_output` is adapter-generated; hosts never return it.\\n89\\t    const text = result.text.trim();\\n90\\t    if (text === \\\"\\\") {\\n91\\t      return classifiedFailure(\\\"empty_output\\\", \\\"model returned empty or whitespace-only text\\\");\\n92\\t    }\\n93\\t    // Provenance is the assignment's three config-known strings, copied —\\n94\\t    // never authored from model output (DD-4).\\n95\\t    return {\\n96\\t      ok: true,\\n97\\t      text,\\n98\\t      provenance: {\\n99\\t        provider: assignment.provider,\\n100\\t        model: assignment.model,\\n101\\t        prompt: assignment.prompt,\\n102\\t      },\\n103\\t    };\\n104\\t  };\\n105\\t\\n106\\t  return {\\n107\\t    smoothPrompt: (i) => callKind(\\\"smoothed_prompt\\\", i),\\n108\\t    summarizeToolCall: (i) => callKind(\\\"tool_call_summary\\\", i),\\n109\\t    summarizeToolResult: (i) =>\\n110\\t      callKind(\\\"tool_result_summary\\\", {\\n111\\t        toolName: i.toolName,\\n112\\t        content: boundContent(i.content, config.maxInputChars),\\n113\\t      }),\\n114\\t    composeTurnRendering: (i) => callKind(\\\"turn_rendering\\\", i),\\n115\\t    projectLowerBand: (i) => callKind(\\\"lower_band_projection\\\", i),\\n116\\t    summarizeChunkDetailed: (i) => callKind(\\\"chunk_summary_detailed\\\", i),\\n117\\t    summarizeChunkBrief: (i) => callKind(\\\"chunk_summary_brief\\\", i),\\n118\\t  };\\n119\\t}\\n120\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7cef6c87-78e2-45ca-98c2-725c469882de\",\"uuid\":\"78a9f4bd-92b4-422a-810c-d388f30b99cb\",\"timestamp\":\"2026-06-12T22:44:44.634Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/adapter.ts\",\"content\":\"// The real provider (DD-2): createInferenceProvider returns the same\\n// DerivationProvider interface the deterministic provider implements, so\\n// createSdk and everything below it see a provider, full stop. Every\\n// operation is the same five-step pipeline (Flow 2): bound the input where\\n// DD-7 applies, render the kind's prompt template into single-turn messages,\\n// call the host ModelCall with the kind's assignment, reject empty or\\n// whitespace-only text as empty_output (AC-2.4), and return the shaped text\\n// with config-known provenance (AC-2.5). The adapter never parses model text\\n// for outcomes, receipts, or any mechanical fact — those stay\\n// handler-authored from the record. The safeCall timeout race (DD-6)\\n// supersedes the inline thrown-exception containment in the classification\\n// story.\\nimport type {\\n  DerivationProvider,\\n  FormKind,\\n  ProviderResult,\\n} from \\\"../shared/derivation.js\\\";\\nimport { FAILURE_CLASSIFICATION } from \\\"./classify.js\\\";\\nimport { PROMPT_REGISTRY, type PromptTemplate } from \\\"./prompts/index.js\\\";\\nimport type {\\n  ModelCallFailureKind,\\n  ModelCallResult,\\n  ResolvedInferenceConfig,\\n} from \\\"./types.js\\\";\\n\\n// DD-7: a pathological tool result must not blow a small-context model.\\n// Content over the bound keeps its head and tail around a marker, and the\\n// bounded whole stays within maxInputChars; bounding happens before prompt\\n// rendering, so the dropped middle never crosses the boundary.\\nfunction boundContent(content: string, maxInputChars: number): string {\\n  if (content.length <= maxInputChars) return content;\\n  const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\\n  const keep = Math.max(0, maxInputChars - marker.length);\\n  const head = Math.ceil(keep / 2);\\n  const tail = keep - head;\\n  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\\n}\\n\\n// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\\n// has, and the reason string is machine-readable by the established\\n// code-before-first-colon convention. Retryable failures lead with\\n// `provider_failure` — the code Epic 02 has always landed on exhausted forms\\n// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\\n// with the failure kind named next; terminal kinds lead with the kind itself\\n// and land failed immediately.\\nfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\\n  const { retryable } = FAILURE_CLASSIFICATION[kind];\\n  const detail = message === \\\"\\\" ? kind : `${kind}: ${message}`;\\n  return {\\n    ok: false,\\n    retryable,\\n    reason: retryable ? `provider_failure: ${detail}` : detail,\\n  };\\n}\\n\\nexport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\\n  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\\n    const assignment = config.assignments[kind];\\n    // Construction validated the name (AC-1.3); a miss here is registry\\n    // drift after construction and is terminal, never retried into.\\n    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\\n    if (template === undefined) {\\n      return classifiedFailure(\\n        \\\"invalid_request\\\",\\n        `prompt template \\\"${assignment.prompt}\\\" not in registry`,\\n      );\\n    }\\n    const messages = template.render(input);\\n    let result: ModelCallResult;\\n    try {\\n      result = await config.call({\\n        provider: assignment.provider,\\n        model: assignment.model,\\n        messages,\\n      });\\n    } catch (cause) {\\n      // Thrown host exceptions classify as `other` (AC-3.3); the structured\\n      // safeCall wrapper (timeout race, DD-6) supersedes this containment in\\n      // the classification story.\\n      result = { ok: false, kind: \\\"other\\\", message: String(cause) };\\n    }\\n    if (!result.ok) {\\n      return classifiedFailure(result.kind, result.message);\\n    }\\n    // Shaping: surrounding whitespace never becomes form content — and a\\n    // model that returned nothing but whitespace has not produced a\\n    // derivation (AC-2.4): a classified retryable failure, never a ready\\n    // form. `empty_output` is adapter-generated; hosts never return it.\\n    const text = result.text.trim();\\n    if (text === \\\"\\\") {\\n      return classifiedFailure(\\\"empty_output\\\", \\\"model returned empty or whitespace-only text\\\");\\n    }\\n    // Provenance is the assignment's three config-known strings, copied —\\n    // never authored from model output (DD-4).\\n    return {\\n      ok: true,\\n      text,\\n      provenance: {\\n        provider: assignment.provider,\\n        model: assignment.model,\\n        prompt: assignment.prompt,\\n      },\\n    };\\n  };\\n\\n  return {\\n    smoothPrompt: (i) => callKind(\\\"smoothed_prompt\\\", i),\\n    summarizeToolCall: (i) => callKind(\\\"tool_call_summary\\\", i),\\n    summarizeToolResult: (i) =>\\n      callKind(\\\"tool_result_summary\\\", {\\n        toolName: i.toolName,\\n        content: boundContent(i.content, config.maxInputChars),\\n      }),\\n    composeTurnRendering: (i) => callKind(\\\"turn_rendering\\\", i),\\n    projectLowerBand: (i) => callKind(\\\"lower_band_projection\\\", i),\\n    summarizeChunkDetailed: (i) => callKind(\\\"chunk_summary_detailed\\\", i),\\n    summarizeChunkBrief: (i) => callKind(\\\"chunk_summary_brief\\\", i),\\n  };\\n}\\n\",\"numLines\":120,\"startLine\":1,\"totalLines\":120}}}\ndocs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log:28:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_015GkVoMerU2zYu2nBvHi7K8\",\"type\":\"tool_result\",\"content\":\"1\\t// Epic 05 Story 3 — TC-2.2 (AC-2.2, AC-2.3): the seven LHC-owned prompt\\n2\\t// templates. Goldens pin each template's rendered messages for a fixture\\n3\\t// input (prompt/fixture drift is an architecture risk: a provider call could\\n4\\t// succeed while a prompt silently loses required input fields); registry\\n5\\t// completeness proves every config-selectable name resolves; the brief/\\n6\\t// detailed contrast and the input-bounding legs run through the adapter\\n7\\t// operations, never the renderers alone (anti-shim).\\n8\\timport { readFileSync } from \\\"node:fs\\\";\\n9\\timport path from \\\"node:path\\\";\\n10\\timport { fileURLToPath } from \\\"node:url\\\";\\n11\\timport { describe, expect, it } from \\\"vitest\\\";\\n12\\timport { createInferenceProvider } from \\\"../src/inference/adapter.js\\\";\\n13\\timport {\\n14\\t  DEFAULT_PROMPT_NAMES,\\n15\\t  PROMPT_REGISTRY,\\n16\\t  type PromptTemplate,\\n17\\t} from \\\"../src/inference/prompts/index.js\\\";\\n18\\timport type { ModelCallInput, ResolvedInferenceConfig } from \\\"../src/inference/types.js\\\";\\n19\\timport {\\n20\\t  cannedResponses,\\n21\\t  FAKE_MODEL_PREFIX,\\n22\\t  FORM_KINDS,\\n23\\t  recordingCall,\\n24\\t  validAssignments,\\n25\\t} from \\\"./fixtures/index.js\\\";\\n26\\t\\n27\\tconst goldensDir = path.join(\\n28\\t  path.dirname(fileURLToPath(import.meta.url)),\\n29\\t  \\\"goldens\\\",\\n30\\t  \\\"prompts\\\",\\n31\\t);\\n32\\t\\n33\\t// One fixture input per template, keyed by template name. Each carries\\n34\\t// distinctive strings the golden embeds, so a template that drops an input\\n35\\t// field fails its golden rather than passing on shape alone.\\n36\\tconst PROMPT_FIXTURES: Record<string, { input: unknown; embedded: string[] }> = {\\n37\\t  \\\"smoothing-v1\\\": {\\n38\\t    input: { text: \\\"plz smooth this prmpt about src/app.ts line 42 thx\\\" },\\n39\\t    embedded: [\\\"src/app.ts line 42\\\"],\\n40\\t  },\\n41\\t  \\\"tool-call-v1\\\": {\\n42\\t    input: {\\n43\\t      toolName: \\\"read_file\\\",\\n44\\t      argsJson: '{\\\"path\\\":\\\"notes/plan.md\\\"}',\\n45\\t      pairedResult: { content: \\\"plan contents: ship story three\\\", isError: false },\\n46\\t    },\\n47\\t    embedded: ['{\\\"path\\\":\\\"notes/plan.md\\\"}', \\\"ship story three\\\", \\\"isError: false\\\"],\\n48\\t  },\\n49\\t  \\\"tool-result-v1\\\": {\\n50\\t    input: { toolName: \\\"read_file\\\", content: \\\"contents of notes/plan.md: 3 open items\\\" },\\n51\\t    embedded: [\\\"contents of notes/plan.md: 3 open items\\\"],\\n52\\t  },\\n53\\t  \\\"turn-compose-v1\\\": {\\n54\\t    input: {\\n55\\t      parts: [\\n56\\t        { messageId: \\\"m1\\\", kind: \\\"user_prompt\\\", text: \\\"please read notes/plan.md\\\", fallback: false },\\n57\\t        {\\n58\\t          messageId: \\\"m2\\\",\\n59\\t          kind: \\\"tool_call\\\",\\n60\\t          text: \\\"read_file called on notes/plan.md\\\",\\n61\\t          fallback: false,\\n62\\t          outcome: \\\"succeeded\\\",\\n63\\t        },\\n64\\t        { messageId: \\\"m3\\\", kind: \\\"assistant_text\\\", text: \\\"the plan has 3 open items\\\", fallback: false },\\n65\\t      ],\\n66\\t    },\\n67\\t    embedded: [\\\"please read notes/plan.md\\\", \\\"outcome: succeeded\\\", \\\"the plan has 3 open items\\\"],\\n68\\t  },\\n69\\t  \\\"lower-band-v1\\\": {\\n70\\t    input: {\\n71\\t      rendering: \\\"The user asked for notes/plan.md; the assistant read it and reported 3 open items.\\\",\\n72\\t    },\\n73\\t    embedded: [\\\"reported 3 open items\\\"],\\n74\\t  },\\n75\\t  \\\"chunk-detailed-v1\\\": {\\n76\\t    input: {\\n77\\t      memberProjections: [\\\"turn one: read notes/plan.md\\\", \\\"turn two: edited src/app.ts\\\"],\\n78\\t      memberReceipts: [\\n79\\t        [\\n80\\t          {\\n81\\t            messageId: \\\"m2\\\",\\n82\\t            activity: \\\"tool_call\\\",\\n83\\t            account: \\\"read_file fetched notes/plan.md\\\",\\n84\\t            outcome: \\\"succeeded\\\",\\n85\\t          },\\n86\\t        ],\\n87\\t        [],\\n88\\t      ],\\n89\\t    },\\n90\\t    embedded: [\\\"turn one: read notes/plan.md\\\", \\\"read_file fetched notes/plan.md => succeeded\\\"],\\n91\\t  },\\n92\\t  \\\"chunk-brief-v1\\\": {\\n93\\t    input: {\\n94\\t      memberProjections: [\\\"turn one: read notes/plan.md\\\", \\\"turn two: edited src/app.ts\\\"],\\n95\\t      memberOutcomes: [[\\\"succeeded\\\"], []],\\n96\\t    },\\n97\\t    embedded: [\\\"turn two: edited src/app.ts\\\", \\\"Tool outcomes, in order: succeeded\\\"],\\n98\\t  },\\n99\\t};\\n100\\t\\n101\\tfunction renderByName(name: string, input: unknown): ModelCallInput[\\\"messages\\\"] {\\n102\\t  const template = PROMPT_REGISTRY[name] as PromptTemplate<unknown> | undefined;\\n103\\t  if (template === undefined) throw new Error(`template \\\"${name}\\\" not in registry`);\\n104\\t  return template.render(input);\\n105\\t}\\n106\\t\\n107\\tfunction resolvedConfig(\\n108\\t  overrides: Partial<ResolvedInferenceConfig> & Pick<ResolvedInferenceConfig, \\\"call\\\">,\\n109\\t): ResolvedInferenceConfig {\\n110\\t  return {\\n111\\t    assignments: validAssignments(),\\n112\\t    timeoutMs: 60_000,\\n113\\t    maxInputChars: 200_000,\\n114\\t    ...overrides,\\n115\\t  };\\n116\\t}\\n117\\t\\n118\\tfunction userContent(input: ModelCallInput): string {\\n119\\t  const user = input.messages.find((message) => message.role === \\\"user\\\");\\n120\\t  if (user === undefined) throw new Error(\\\"no user message in rendered call\\\");\\n121\\t  return user.content;\\n122\\t}\\n123\\t\\n124\\tdescribe(\\\"TC-2.2: prompt-rendering goldens (AC-2.2, AC-2.3)\\\", () => {\\n125\\t  for (const kind of FORM_KINDS) {\\n126\\t    const name = DEFAULT_PROMPT_NAMES[kind];\\n127\\t    it(`${name} renders its fixture input to the committed golden`, () => {\\n128\\t      const fixture = PROMPT_FIXTURES[name];\\n129\\t      expect(fixture).toBeDefined();\\n130\\t      const rendered = renderByName(name, fixture?.input);\\n131\\t      const golden = JSON.parse(\\n132\\t        readFileSync(path.join(goldensDir, `${name}.golden.json`), \\\"utf8\\\"),\\n133\\t      ) as ModelCallInput[\\\"messages\\\"];\\n134\\t      expect(rendered).toEqual(golden);\\n135\\t    });\\n136\\t\\n137\\t    it(`${name} embeds its fixture content in single-turn shape`, () => {\\n138\\t      const fixture = PROMPT_FIXTURES[name];\\n139\\t      const rendered = renderByName(name, fixture?.input);\\n140\\t      expect(rendered.filter((message) => message.role === \\\"user\\\")).toHaveLength(1);\\n141\\t      for (const message of rendered) {\\n142\\t        expect([\\\"system\\\", \\\"user\\\"]).toContain(message.role);\\n143\\t        expect(typeof message.content).toBe(\\\"string\\\");\\n144\\t      }\\n145\\t      const joined = rendered.map((message) => message.content).join(\\\"\\\\n\\\");\\n146\\t      for (const needle of fixture?.embedded ?? []) {\\n147\\t        expect(joined).toContain(needle);\\n148\\t      }\\n149\\t    });\\n150\\t  }\\n151\\t});\\n152\\t\\n153\\tdescribe(\\\"TC-2.2: registry completeness (AC-2.3)\\\", () => {\\n154\\t  it(\\\"every registry key resolves to a template carrying that exact name\\\", () => {\\n155\\t    const names = Object.keys(PROMPT_REGISTRY);\\n156\\t    expect(names.length).toBeGreaterThanOrEqual(7);\\n157\\t    for (const name of names) {\\n158\\t      expect(PROMPT_REGISTRY[name]?.name).toBe(name);\\n159\\t      expect(typeof PROMPT_REGISTRY[name]?.render).toBe(\\\"function\\\");\\n160\\t    }\\n161\\t  });\\n162\\t\\n163\\t  it(\\\"default names cover all seven kinds and each resolves in the registry\\\", () => {\\n164\\t    const defaultNames = new Set<string>();\\n165\\t    for (const kind of FORM_KINDS) {\\n166\\t      const name = DEFAULT_PROMPT_NAMES[kind];\\n167\\t      expect(typeof name).toBe(\\\"string\\\");\\n168\\t      expect(PROMPT_REGISTRY[name]).toBeDefined();\\n169\\t      defaultNames.add(name);\\n170\\t    }\\n171\\t    // Seven kinds, seven distinct templates — no kind shares another's prompt.\\n172\\t    expect(defaultNames.size).toBe(7);\\n173\\t  });\\n174\\t});\\n175\\t\\n176\\tdescribe(\\\"TC-2.2: brief receipt-stripping holds through the adapter (AC-2.2)\\\", () => {\\n177\\t  const RECEIPT_ACCOUNT = \\\"read_file fetched notes/plan.md and rewrote temp/out.txt\\\";\\n178\\t\\n179\\t  it(\\\"the brief rendering carries outcome tokens but no receipt text from its input\\\", async () => {\\n180\\t    const { call, log } = recordingCall(cannedResponses());\\n181\\t    const provider = createInferenceProvider(resolvedConfig({ call }));\\n182\\t\\n183\\t    const detailed = await provider.summarizeChunkDetailed({\\n184\\t      memberProjections: [\\\"turn one: planning work\\\"],\\n185\\t      memberReceipts: [\\n186\\t        [{ messageId: \\\"m2\\\", activity: \\\"tool_call\\\", account: RECEIPT_ACCOUNT, outcome: \\\"succeeded\\\" }],\\n187\\t      ],\\n188\\t    });\\n189\\t    const brief = await provider.summarizeChunkBrief({\\n190\\t      memberProjections: [\\\"turn one: planning work\\\"],\\n191\\t      memberOutcomes: [[\\\"succeeded\\\"]],\\n192\\t    });\\n193\\t    expect(detailed.ok).toBe(true);\\n194\\t    expect(brief.ok).toBe(true);\\n195\\t\\n196\\t    const detailedCall = log.find(\\n197\\t      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_detailed`,\\n198\\t    );\\n199\\t    const briefCall = log.find(\\n200\\t      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_brief`,\\n201\\t    );\\n202\\t    expect(detailedCall).toBeDefined();\\n203\\t    expect(briefCall).toBeDefined();\\n204\\t    if (detailedCall === undefined || briefCall === undefined) return;\\n205\\t\\n206\\t    // The detailed lane is the contrast: its rendering carries the receipt\\n207\\t    // account verbatim, so its absence from the brief lane is stripping, not\\n208\\t    // a template that ignores receipts altogether.\\n209\\t    expect(userContent(detailedCall)).toContain(RECEIPT_ACCOUNT);\\n210\\t    expect(userContent(briefCall)).toContain(\\\"succeeded\\\");\\n211\\t    expect(userContent(briefCall)).not.toContain(RECEIPT_ACCOUNT);\\n212\\t    expect(userContent(briefCall)).not.toContain(\\\"rewrote\\\");\\n213\\t  });\\n214\\t});\\n215\\t\\n216\\tdescribe(\\\"TC-2.2: tool-result input bounding (AC-2.2, DD-7)\\\", () => {\\n217\\t  const MAX_INPUT_CHARS = 200;\\n218\\t\\n219\\t  it(\\\"oversized summarizeToolResult input renders head + tail + marker under maxInputChars\\\", async () => {\\n220\\t    const { call, log } = recordingCall(cannedResponses());\\n221\\t    const provider = createInferenceProvider(\\n222\\t      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\\n223\\t    );\\n224\\t    const content = \\\"H\\\".repeat(150) + \\\"M\\\".repeat(700) + \\\"T\\\".repeat(150);\\n225\\t    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\\n226\\t    expect(result.ok).toBe(true);\\n227\\t\\n228\\t    const input = log[0];\\n229\\t    expect(input).toBeDefined();\\n230\\t    if (input === undefined) return;\\n231\\t    const user = userContent(input);\\n232\\t    const bounded = user.slice(user.indexOf(\\\"Output:\\\\n\\\") + \\\"Output:\\\\n\\\".length);\\n233\\t    expect(bounded.length).toBeLessThanOrEqual(MAX_INPUT_CHARS);\\n234\\t    expect(bounded.startsWith(\\\"HHHH\\\")).toBe(true);\\n235\\t    expect(bounded.endsWith(\\\"TTTT\\\")).toBe(true);\\n236\\t    expect(bounded).toContain(\\\"truncated\\\");\\n237\\t    // Bounding happened before rendering: the middle never reached the prompt.\\n238\\t    expect(user).not.toContain(\\\"M\\\".repeat(50));\\n239\\t  });\\n240\\t\\n241\\t  it(\\\"under-limit input renders whole, no marker\\\", async () => {\\n242\\t    const { call, log } = recordingCall(cannedResponses());\\n243\\t    const provider = createInferenceProvider(\\n244\\t      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\\n245\\t    );\\n246\\t    const content = \\\"W\\\".repeat(MAX_INPUT_CHARS);\\n247\\t    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\\n248\\t    expect(result.ok).toBe(true);\\n249\\t\\n250\\t    const input = log[0];\\n251\\t    expect(input).toBeDefined();\\n252\\t    if (input === undefined) return;\\n253\\t    const user = userContent(input);\\n254\\t    expect(user).toContain(content);\\n255\\t    expect(user).not.toContain(\\\"truncated\\\");\\n256\\t  });\\n257\\t});\\n258\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7cef6c87-78e2-45ca-98c2-725c469882de\",\"uuid\":\"ac42a50d-2079-48d9-b8fc-6312a034073b\",\"timestamp\":\"2026-06-12T22:44:45.059Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inference-prompts.test.ts\",\"content\":\"// Epic 05 Story 3 — TC-2.2 (AC-2.2, AC-2.3): the seven LHC-owned prompt\\n// templates. Goldens pin each template's rendered messages for a fixture\\n// input (prompt/fixture drift is an architecture risk: a provider call could\\n// succeed while a prompt silently loses required input fields); registry\\n// completeness proves every config-selectable name resolves; the brief/\\n// detailed contrast and the input-bounding legs run through the adapter\\n// operations, never the renderers alone (anti-shim).\\nimport { readFileSync } from \\\"node:fs\\\";\\nimport path from \\\"node:path\\\";\\nimport { fileURLToPath } from \\\"node:url\\\";\\nimport { describe, expect, it } from \\\"vitest\\\";\\nimport { createInferenceProvider } from \\\"../src/inference/adapter.js\\\";\\nimport {\\n  DEFAULT_PROMPT_NAMES,\\n  PROMPT_REGISTRY,\\n  type PromptTemplate,\\n} from \\\"../src/inference/prompts/index.js\\\";\\nimport type { ModelCallInput, ResolvedInferenceConfig } from \\\"../src/inference/types.js\\\";\\nimport {\\n  cannedResponses,\\n  FAKE_MODEL_PREFIX,\\n  FORM_KINDS,\\n  recordingCall,\\n  validAssignments,\\n} from \\\"./fixtures/index.js\\\";\\n\\nconst goldensDir = path.join(\\n  path.dirname(fileURLToPath(import.meta.url)),\\n  \\\"goldens\\\",\\n  \\\"prompts\\\",\\n);\\n\\n// One fixture input per template, keyed by template name. Each carries\\n// distinctive strings the golden embeds, so a template that drops an input\\n// field fails its golden rather than passing on shape alone.\\nconst PROMPT_FIXTURES: Record<string, { input: unknown; embedded: string[] }> = {\\n  \\\"smoothing-v1\\\": {\\n    input: { text: \\\"plz smooth this prmpt about src/app.ts line 42 thx\\\" },\\n    embedded: [\\\"src/app.ts line 42\\\"],\\n  },\\n  \\\"tool-call-v1\\\": {\\n    input: {\\n      toolName: \\\"read_file\\\",\\n      argsJson: '{\\\"path\\\":\\\"notes/plan.md\\\"}',\\n      pairedResult: { content: \\\"plan contents: ship story three\\\", isError: false },\\n    },\\n    embedded: ['{\\\"path\\\":\\\"notes/plan.md\\\"}', \\\"ship story three\\\", \\\"isError: false\\\"],\\n  },\\n  \\\"tool-result-v1\\\": {\\n    input: { toolName: \\\"read_file\\\", content: \\\"contents of notes/plan.md: 3 open items\\\" },\\n    embedded: [\\\"contents of notes/plan.md: 3 open items\\\"],\\n  },\\n  \\\"turn-compose-v1\\\": {\\n    input: {\\n      parts: [\\n        { messageId: \\\"m1\\\", kind: \\\"user_prompt\\\", text: \\\"please read notes/plan.md\\\", fallback: false },\\n        {\\n          messageId: \\\"m2\\\",\\n          kind: \\\"tool_call\\\",\\n          text: \\\"read_file called on notes/plan.md\\\",\\n          fallback: false,\\n          outcome: \\\"succeeded\\\",\\n        },\\n        { messageId: \\\"m3\\\", kind: \\\"assistant_text\\\", text: \\\"the plan has 3 open items\\\", fallback: false },\\n      ],\\n    },\\n    embedded: [\\\"please read notes/plan.md\\\", \\\"outcome: succeeded\\\", \\\"the plan has 3 open items\\\"],\\n  },\\n  \\\"lower-band-v1\\\": {\\n    input: {\\n      rendering: \\\"The user asked for notes/plan.md; the assistant read it and reported 3 open items.\\\",\\n    },\\n    embedded: [\\\"reported 3 open items\\\"],\\n  },\\n  \\\"chunk-detailed-v1\\\": {\\n    input: {\\n      memberProjections: [\\\"turn one: read notes/plan.md\\\", \\\"turn two: edited src/app.ts\\\"],\\n      memberReceipts: [\\n        [\\n          {\\n            messageId: \\\"m2\\\",\\n            activity: \\\"tool_call\\\",\\n            account: \\\"read_file fetched notes/plan.md\\\",\\n            outcome: \\\"succeeded\\\",\\n          },\\n        ],\\n        [],\\n      ],\\n    },\\n    embedded: [\\\"turn one: read notes/plan.md\\\", \\\"read_file fetched notes/plan.md => succeeded\\\"],\\n  },\\n  \\\"chunk-brief-v1\\\": {\\n    input: {\\n      memberProjections: [\\\"turn one: read notes/plan.md\\\", \\\"turn two: edited src/app.ts\\\"],\\n      memberOutcomes: [[\\\"succeeded\\\"], []],\\n    },\\n    embedded: [\\\"turn two: edited src/app.ts\\\", \\\"Tool outcomes, in order: succeeded\\\"],\\n  },\\n};\\n\\nfunction renderByName(name: string, input: unknown): ModelCallInput[\\\"messages\\\"] {\\n  const template = PROMPT_REGISTRY[name] as PromptTemplate<unknown> | undefined;\\n  if (template === undefined) throw new Error(`template \\\"${name}\\\" not in registry`);\\n  return template.render(input);\\n}\\n\\nfunction resolvedConfig(\\n  overrides: Partial<ResolvedInferenceConfig> & Pick<ResolvedInferenceConfig, \\\"call\\\">,\\n): ResolvedInferenceConfig {\\n  return {\\n    assignments: validAssignments(),\\n    timeoutMs: 60_000,\\n    maxInputChars: 200_000,\\n    ...overrides,\\n  };\\n}\\n\\nfunction userContent(input: ModelCallInput): string {\\n  const user = input.messages.find((message) => message.role === \\\"user\\\");\\n  if (user === undefined) throw new Error(\\\"no user message in rendered call\\\");\\n  return user.content;\\n}\\n\\ndescribe(\\\"TC-2.2: prompt-rendering goldens (AC-2.2, AC-2.3)\\\", () => {\\n  for (const kind of FORM_KINDS) {\\n    const name = DEFAULT_PROMPT_NAMES[kind];\\n    it(`${name} renders its fixture input to the committed golden`, () => {\\n      const fixture = PROMPT_FIXTURES[name];\\n      expect(fixture).toBeDefined();\\n      const rendered = renderByName(name, fixture?.input);\\n      const golden = JSON.parse(\\n        readFileSync(path.join(goldensDir, `${name}.golden.json`), \\\"utf8\\\"),\\n      ) as ModelCallInput[\\\"messages\\\"];\\n      expect(rendered).toEqual(golden);\\n    });\\n\\n    it(`${name} embeds its fixture content in single-turn shape`, () => {\\n      const fixture = PROMPT_FIXTURES[name];\\n      const rendered = renderByName(name, fixture?.input);\\n      expect(rendered.filter((message) => message.role === \\\"user\\\")).toHaveLength(1);\\n      for (const message of rendered) {\\n        expect([\\\"system\\\", \\\"user\\\"]).toContain(message.role);\\n        expect(typeof message.content).toBe(\\\"string\\\");\\n      }\\n      const joined = rendered.map((message) => message.content).join(\\\"\\\\n\\\");\\n      for (const needle of fixture?.embedded ?? []) {\\n        expect(joined).toContain(needle);\\n      }\\n    });\\n  }\\n});\\n\\ndescribe(\\\"TC-2.2: registry completeness (AC-2.3)\\\", () => {\\n  it(\\\"every registry key resolves to a template carrying that exact name\\\", () => {\\n    const names = Object.keys(PROMPT_REGISTRY);\\n    expect(names.length).toBeGreaterThanOrEqual(7);\\n    for (const name of names) {\\n      expect(PROMPT_REGISTRY[name]?.name).toBe(name);\\n      expect(typeof PROMPT_REGISTRY[name]?.render).toBe(\\\"function\\\");\\n    }\\n  });\\n\\n  it(\\\"default names cover all seven kinds and each resolves in the registry\\\", () => {\\n    const defaultNames = new Set<string>();\\n    for (const kind of FORM_KINDS) {\\n      const name = DEFAULT_PROMPT_NAMES[kind];\\n      expect(typeof name).toBe(\\\"string\\\");\\n      expect(PROMPT_REGISTRY[name]).toBeDefined();\\n      defaultNames.add(name);\\n    }\\n    // Seven kinds, seven distinct templates — no kind shares another's prompt.\\n    expect(defaultNames.size).toBe(7);\\n  });\\n});\\n\\ndescribe(\\\"TC-2.2: brief receipt-stripping holds through the adapter (AC-2.2)\\\", () => {\\n  const RECEIPT_ACCOUNT = \\\"read_file fetched notes/plan.md and rewrote temp/out.txt\\\";\\n\\n  it(\\\"the brief rendering carries outcome tokens but no receipt text from its input\\\", async () => {\\n    const { call, log } = recordingCall(cannedResponses());\\n    const provider = createInferenceProvider(resolvedConfig({ call }));\\n\\n    const detailed = await provider.summarizeChunkDetailed({\\n      memberProjections: [\\\"turn one: planning work\\\"],\\n      memberReceipts: [\\n        [{ messageId: \\\"m2\\\", activity: \\\"tool_call\\\", account: RECEIPT_ACCOUNT, outcome: \\\"succeeded\\\" }],\\n      ],\\n    });\\n    const brief = await provider.summarizeChunkBrief({\\n      memberProjections: [\\\"turn one: planning work\\\"],\\n      memberOutcomes: [[\\\"succeeded\\\"]],\\n    });\\n    expect(detailed.ok).toBe(true);\\n    expect(brief.ok).toBe(true);\\n\\n    const detailedCall = log.find(\\n      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_detailed`,\\n    );\\n    const briefCall = log.find(\\n      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_brief`,\\n    );\\n    expect(detailedCall).toBeDefined();\\n    expect(briefCall).toBeDefined();\\n    if (detailedCall === undefined || briefCall === undefined) return;\\n\\n    // The detailed lane is the contrast: its rendering carries the receipt\\n    // account verbatim, so its absence from the brief lane is stripping, not\\n    // a template that ignores receipts altogether.\\n    expect(userContent(detailedCall)).toContain(RECEIPT_ACCOUNT);\\n    expect(userContent(briefCall)).toContain(\\\"succeeded\\\");\\n    expect(userContent(briefCall)).not.toContain(RECEIPT_ACCOUNT);\\n    expect(userContent(briefCall)).not.toContain(\\\"rewrote\\\");\\n  });\\n});\\n\\ndescribe(\\\"TC-2.2: tool-result input bounding (AC-2.2, DD-7)\\\", () => {\\n  const MAX_INPUT_CHARS = 200;\\n\\n  it(\\\"oversized summarizeToolResult input renders head + tail + marker under maxInputChars\\\", async () => {\\n    const { call, log } = recordingCall(cannedResponses());\\n    const provider = createInferenceProvider(\\n      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\\n    );\\n    const content = \\\"H\\\".repeat(150) + \\\"M\\\".repeat(700) + \\\"T\\\".repeat(150);\\n    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\\n    expect(result.ok).toBe(true);\\n\\n    const input = log[0];\\n    expect(input).toBeDefined();\\n    if (input === undefined) return;\\n    const user = userContent(input);\\n    const bounded = user.slice(user.indexOf(\\\"Output:\\\\n\\\") + \\\"Output:\\\\n\\\".length);\\n    expect(bounded.length).toBeLessThanOrEqual(MAX_INPUT_CHARS);\\n    expect(bounded.startsWith(\\\"HHHH\\\")).toBe(true);\\n    expect(bounded.endsWith(\\\"TTTT\\\")).toBe(true);\\n    expect(bounded).toContain(\\\"truncated\\\");\\n    // Bounding happened before rendering: the middle never reached the prompt.\\n    expect(user).not.toContain(\\\"M\\\".repeat(50));\\n  });\\n\\n  it(\\\"under-limit input renders whole, no marker\\\", async () => {\\n    const { call, log } = recordingCall(cannedResponses());\\n    const provider = createInferenceProvider(\\n      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\\n    );\\n    const content = \\\"W\\\".repeat(MAX_INPUT_CHARS);\\n    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\\n    expect(result.ok).toBe(true);\\n\\n    const input = log[0];\\n    expect(input).toBeDefined();\\n    if (input === undefined) return;\\n    const user = userContent(input);\\n    expect(user).toContain(content);\\n    expect(user).not.toContain(\\\"truncated\\\");\\n  });\\n});\\n\",\"numLines\":258,\"startLine\":1,\"totalLines\":258}}}\ndocs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log:171:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01CqVNZkirvLeuro95eYLjbu\",\"type\":\"tool_result\",\"content\":\"artifacts\\nepic.md\\nimpl-run.config.json\\nstories\\nteam-impl-log.md\\ntech-design.md\\ntest-plan.md\\n---STORIES---\\n01-cli-retirement.md\\n02-inference-seam-and-model-assignment.md\\n03-the-adapter-and-the-seven-prompts.md\\n04-failure-classification.md\\n05-real-inference-suite-and-capstone.md\\n06-turn-end-boundary-advance.md\\ncoverage.md\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"7cef6c87-78e2-45ca-98c2-725c469882de\",\"uuid\":\"56d1e229-2bb4-4870-9b94-b8f4d8831033\",\"timestamp\":\"2026-06-12T22:45:51.757Z\",\"tool_use_result\":{\"stdout\":\"artifacts\\nepic.md\\nimpl-run.config.json\\nstories\\nteam-impl-log.md\\ntech-design.md\\ntest-plan.md\\n---STORIES---\\n01-cli-retirement.md\\n02-inference-seam-and-model-assignment.md\\n03-the-adapter-and-the-seven-prompts.md\\n04-failure-classification.md\\n05-real-inference-suite-and-capstone.md\\n06-turn-end-boundary-advance.md\\ncoverage.md\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ndocs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log:210:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_016HMzkzUkkuwTFN9UKPNJp6\",\"type\":\"tool_result\",\"content\":\"81:| Test goldens | `test/goldens/prompts/` |\\n82:| Story-owned tests | `test/inference-adapter.test.ts`, `test/inference-prompts.test.ts` |\\n101:| TC-2.1 | `test/inference-adapter.test.ts` | seven kinds ready with canned content, handler equivalence, record-authored facts, provenance, deterministic provider without provenance |\\n102:| TC-2.2 | `test/inference-prompts.test.ts` | prompt goldens, registry completeness, brief-summary receipt stripping, tool-result input bounding |\\n103:| TC-2.3 | `test/inference-adapter.test.ts` | whitespace success classifies as `empty_output`, retries once in scripted leg, and fails with last error on exhaustion |\\n109:| Adapter parses model output for mechanical facts | `test/inference-adapter.test.ts` adversarial canned text | Canned text claims wrong outcome; stored outcome must still match record | A ready form alone would not prove the source of mechanical facts |\\n110:| Source/derived provenance authored from output | `test/inference-adapter.test.ts` metadata assertions | Provenance equals assignment provider/model/prompt and deterministic provider has none | Model text could accidentally contain plausible provenance strings |\\n183:- Targeted: `cd packages/lhc && pnpm exec vitest run test/inference-adapter.test.ts test/inference-prompts.test.ts`\\n184:- Story gate: `cd packages/lhc && pnpm run red-verify && pnpm exec vitest run test/inference-adapter.test.ts test/inference-prompts.test.ts`\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"7cef6c87-78e2-45ca-98c2-725c469882de\",\"uuid\":\"cefbfe06-4027-4349-97d9-91f02dff7c31\",\"timestamp\":\"2026-06-12T22:46:01.778Z\",\"tool_use_result\":{\"stdout\":\"81:| Test goldens | `test/goldens/prompts/` |\\n82:| Story-owned tests | `test/inference-adapter.test.ts`, `test/inference-prompts.test.ts` |\\n101:| TC-2.1 | `test/inference-adapter.test.ts` | seven kinds ready with canned content, handler equivalence, record-authored facts, provenance, deterministic provider without provenance |\\n102:| TC-2.2 | `test/inference-prompts.test.ts` | prompt goldens, registry completeness, brief-summary receipt stripping, tool-result input bounding |\\n103:| TC-2.3 | `test/inference-adapter.test.ts` | whitespace success classifies as `empty_output`, retries once in scripted leg, and fails with last error on exhaustion |\\n109:| Adapter parses model output for mechanical facts | `test/inference-adapter.test.ts` adversarial canned text | Canned text claims wrong outcome; stored outcome must still match record | A ready form alone would not prove the source of mechanical facts |\\n110:| Source/derived provenance authored from output | `test/inference-adapter.test.ts` metadata assertions | Provenance equals assignment provider/model/prompt and deterministic provider has none | Model text could accidentally contain plausible provenance strings |\\n183:- Targeted: `cd packages/lhc && pnpm exec vitest run test/inference-adapter.test.ts test/inference-prompts.test.ts`\\n184:- Story gate: `cd packages/lhc && pnpm run red-verify && pnpm exec vitest run test/inference-adapter.test.ts test/inference-prompts.test.ts`\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ndocs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log:248:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Jo1TwencYXr3bbWNe3a18C\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/adapter.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7cef6c87-78e2-45ca-98c2-725c469882de\",\"uuid\":\"9f8042a6-79f5-4eeb-8d5d-a24a6fc2259d\",\"timestamp\":\"2026-06-12T22:46:12.714Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/adapter.ts\",\"oldString\":\"function boundContent(content: string, maxInputChars: number): string {\\n  if (content.length <= maxInputChars) return content;\\n  const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\\n  const keep = Math.max(0, maxInputChars - marker.length);\\n  const head = Math.ceil(keep / 2);\\n  const tail = keep - head;\\n  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\\n}\",\"newString\":\"function boundContent(content: string, maxInputChars: number): string {\\n  if (content.length <= maxInputChars) return content;\\n  const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\\n  // The marker only earns its place when head + marker + tail still fits the\\n  // bound. When maxInputChars is smaller than the marker itself, there is no\\n  // budget for the marker — emitting it would be the one path that crosses the\\n  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\\n  // honors the cap exactly.\\n  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\\n  const keep = maxInputChars - marker.length;\\n  const head = Math.ceil(keep / 2);\\n  const tail = keep - head;\\n  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\\n}\",\"originalFile\":\"// The real provider (DD-2): createInferenceProvider returns the same\\n// DerivationProvider interface the deterministic provider implements, so\\n// createSdk and everything below it see a provider, full stop. Every\\n// operation is the same five-step pipeline (Flow 2): bound the input where\\n// DD-7 applies, render the kind's prompt template into single-turn messages,\\n// call the host ModelCall with the kind's assignment, reject empty or\\n// whitespace-only text as empty_output (AC-2.4), and return the shaped text\\n// with config-known provenance (AC-2.5). The adapter never parses model text\\n// for outcomes, receipts, or any mechanical fact — those stay\\n// handler-authored from the record. The safeCall timeout race (DD-6)\\n// supersedes the inline thrown-exception containment in the classification\\n// story.\\nimport type {\\n  DerivationProvider,\\n  FormKind,\\n  ProviderResult,\\n} from \\\"../shared/derivation.js\\\";\\nimport { FAILURE_CLASSIFICATION } from \\\"./classify.js\\\";\\nimport { PROMPT_REGISTRY, type PromptTemplate } from \\\"./prompts/index.js\\\";\\nimport type {\\n  ModelCallFailureKind,\\n  ModelCallResult,\\n  ResolvedInferenceConfig,\\n} from \\\"./types.js\\\";\\n\\n// DD-7: a pathological tool result must not blow a small-context model.\\n// Content over the bound keeps its head and tail around a marker, and the\\n// bounded whole stays within maxInputChars; bounding happens before prompt\\n// rendering, so the dropped middle never crosses the boundary.\\nfunction boundContent(content: string, maxInputChars: number): string {\\n  if (content.length <= maxInputChars) return content;\\n  const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\\n  const keep = Math.max(0, maxInputChars - marker.length);\\n  const head = Math.ceil(keep / 2);\\n  const tail = keep - head;\\n  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\\n}\\n\\n// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\\n// has, and the reason string is machine-readable by the established\\n// code-before-first-colon convention. Retryable failures lead with\\n// `provider_failure` — the code Epic 02 has always landed on exhausted forms\\n// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\\n// with the failure kind named next; terminal kinds lead with the kind itself\\n// and land failed immediately.\\nfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\\n  const { retryable } = FAILURE_CLASSIFICATION[kind];\\n  const detail = message === \\\"\\\" ? kind : `${kind}: ${message}`;\\n  return {\\n    ok: false,\\n    retryable,\\n    reason: retryable ? `provider_failure: ${detail}` : detail,\\n  };\\n}\\n\\nexport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\\n  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\\n    const assignment = config.assignments[kind];\\n    // Construction validated the name (AC-1.3); a miss here is registry\\n    // drift after construction and is terminal, never retried into.\\n    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\\n    if (template === undefined) {\\n      return classifiedFailure(\\n        \\\"invalid_request\\\",\\n        `prompt template \\\"${assignment.prompt}\\\" not in registry`,\\n      );\\n    }\\n    const messages = template.render(input);\\n    let result: ModelCallResult;\\n    try {\\n      result = await config.call({\\n        provider: assignment.provider,\\n        model: assignment.model,\\n        messages,\\n      });\\n    } catch (cause) {\\n      // Thrown host exceptions classify as `other` (AC-3.3); the structured\\n      // safeCall wrapper (timeout race, DD-6) supersedes this containment in\\n      // the classification story.\\n      result = { ok: false, kind: \\\"other\\\", message: String(cause) };\\n    }\\n    if (!result.ok) {\\n      return classifiedFailure(result.kind, result.message);\\n    }\\n    // Shaping: surrounding whitespace never becomes form content — and a\\n    // model that returned nothing but whitespace has not produced a\\n    // derivation (AC-2.4): a classified retryable failure, never a ready\\n    // form. `empty_output` is adapter-generated; hosts never return it.\\n    const text = result.text.trim();\\n    if (text === \\\"\\\") {\\n      return classifiedFailure(\\\"empty_output\\\", \\\"model returned empty or whitespace-only text\\\");\\n    }\\n    // Provenance is the assignment's three config-known strings, copied —\\n    // never authored from model output (DD-4).\\n    return {\\n      ok: true,\\n      text,\\n      provenance: {\\n        provider: assignment.provider,\\n        model: assignment.model,\\n        prompt: assignment.prompt,\\n      },\\n    };\\n  };\\n\\n  return {\\n    smoothPrompt: (i) => callKind(\\\"smoothed_prompt\\\", i),\\n    summarizeToolCall: (i) => callKind(\\\"tool_call_summary\\\", i),\\n    summarizeToolResult: (i) =>\\n      callKind(\\\"tool_result_summary\\\", {\\n        toolName: i.toolName,\\n        content: boundContent(i.content, config.maxInputChars),\\n      }),\\n    composeTurnRendering: (i) => callKind(\\\"turn_rendering\\\", i),\\n    projectLowerBand: (i) => callKind(\\\"lower_band_projection\\\", i),\\n    summarizeChunkDetailed: (i) => callKind(\\\"chunk_summary_detailed\\\", i),\\n    summarizeChunkBrief: (i) => callKind(\\\"chunk_summary_brief\\\", i),\\n  };\\n}\\n\",\"structuredPatch\":[{\"oldStart\":30,\"oldLines\":7,\"newStart\":30,\"newLines\":13,\"lines\":[\" function boundContent(content: string, maxInputChars: number): string {\",\"   if (content.length <= maxInputChars) return content;\",\"   const marker = `\\\\n\\\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\\\n\\\\n`;\",\"-  const keep = Math.max(0, maxInputChars - marker.length);\",\"+  // The marker only earns its place when head + marker + tail still fits the\",\"+  // bound. When maxInputChars is smaller than the marker itself, there is no\",\"+  // budget for the marker — emitting it would be the one path that crosses the\",\"+  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\",\"+  // honors the cap exactly.\",\"+  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\",\"+  const keep = maxInputChars - marker.length;\",\"   const head = Math.ceil(keep / 2);\",\"   const tail = keep - head;\",\"   return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \\\"\\\");\"]}],\"userModified\":false,\"replaceAll\":false}}\ndocs/02-specs/05-derivation-inference/artifacts/quick-fix/streams/001-quick-fix.stdout.log:278:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01AbhdaewNdLvwihj2ToWaQG\",\"type\":\"tool_result\",\"content\":\"The file /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inference-prompts.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"7cef6c87-78e2-45ca-98c2-725c469882de\",\"uuid\":\"acdf8075-0cbf-4a6a-b425-8c0b62c6e657\",\"timestamp\":\"2026-06-12T22:46:21.414Z\",\"tool_use_result\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inference-prompts.test.ts\",\"oldString\":\"  it(\\\"under-limit input renders whole, no marker\\\", async () => {\",\"newString\":\"  it(\\\"a maxInputChars below the truncation marker still bounds the whole (DD-7)\\\", async () => {\\n    const { call, log } = recordingCall(cannedResponses());\\n    // 40 chars is a legitimately small context budget — and shorter than the\\n    // truncation marker itself. It is the counterexample to a naive\\n    // head+tail+marker bound: with no room for the marker, that bound returns\\n    // the marker alone and overshoots the cap it was meant to hold.\\n    const tinyMax = 40;\\n    const provider = createInferenceProvider(\\n      resolvedConfig({ call, maxInputChars: tinyMax }),\\n    );\\n    const content = \\\"H\\\".repeat(40) + \\\"M\\\".repeat(700) + \\\"T\\\".repeat(40);\\n    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\\n    expect(result.ok).toBe(true);\\n\\n    const input = log[0];\\n    expect(input).toBeDefined();\\n    if (input === undefined) return;\\n    const user = userContent(input);\\n    const bounded = user.slice(user.indexOf(\\\"Output:\\\\n\\\") + \\\"Output:\\\\n\\\".length);\\n    // The bounded whole never exceeds the cap, even though no marker fits.\\n    expect(bounded.length).toBeLessThanOrEqual(tinyMax);\\n    // With no room for the marker the bound degrades to a plain head: a true\\n    // prefix of the input, never the marker text standing on its own.\\n    expect(content.startsWith(bounded)).toBe(true);\\n    expect(bounded).not.toContain(\\\"truncated\\\");\\n    expect(user).not.toContain(\\\"M\\\".repeat(50));\\n  });\\n\\n  it(\\\"under-limit input renders whole, no marker\\\", async () => {\",\"originalFile\":\"// Epic 05 Story 3 — TC-2.2 (AC-2.2, AC-2.3): the seven LHC-owned prompt\\n// templates. Goldens pin each template's rendered messages for a fixture\\n// input (prompt/fixture drift is an architecture risk: a provider call could\\n// succeed while a prompt silently loses required input fields); registry\\n// completeness proves every config-selectable name resolves; the brief/\\n// detailed contrast and the input-bounding legs run through the adapter\\n// operations, never the renderers alone (anti-shim).\\nimport { readFileSync } from \\\"node:fs\\\";\\nimport path from \\\"node:path\\\";\\nimport { fileURLToPath } from \\\"node:url\\\";\\nimport { describe, expect, it } from \\\"vitest\\\";\\nimport { createInferenceProvider } from \\\"../src/inference/adapter.js\\\";\\nimport {\\n  DEFAULT_PROMPT_NAMES,\\n  PROMPT_REGISTRY,\\n  type PromptTemplate,\\n} from \\\"../src/inference/prompts/index.js\\\";\\nimport type { ModelCallInput, ResolvedInferenceConfig } from \\\"../src/inference/types.js\\\";\\nimport {\\n  cannedResponses,\\n  FAKE_MODEL_PREFIX,\\n  FORM_KINDS,\\n  recordingCall,\\n  validAssignments,\\n} from \\\"./fixtures/index.js\\\";\\n\\nconst goldensDir = path.join(\\n  path.dirname(fileURLToPath(import.meta.url)),\\n  \\\"goldens\\\",\\n  \\\"prompts\\\",\\n);\\n\\n// One fixture input per template, keyed by template name. Each carries\\n// distinctive strings the golden embeds, so a template that drops an input\\n// field fails its golden rather than passing on shape alone.\\nconst PROMPT_FIXTURES: Record<string, { input: unknown; embedded: string[] }> = {\\n  \\\"smoothing-v1\\\": {\\n    input: { text: \\\"plz smooth this prmpt about src/app.ts line 42 thx\\\" },\\n    embedded: [\\\"src/app.ts line 42\\\"],\\n  },\\n  \\\"tool-call-v1\\\": {\\n    input: {\\n      toolName: \\\"read_file\\\",\\n      argsJson: '{\\\"path\\\":\\\"notes/plan.md\\\"}',\\n      pairedResult: { content: \\\"plan contents: ship story three\\\", isError: false },\\n    },\\n    embedded: ['{\\\"path\\\":\\\"notes/plan.md\\\"}', \\\"ship story three\\\", \\\"isError: false\\\"],\\n  },\\n  \\\"tool-result-v1\\\": {\\n    input: { toolName: \\\"read_file\\\", content: \\\"contents of notes/plan.md: 3 open items\\\" },\\n    embedded: [\\\"contents of notes/plan.md: 3 open items\\\"],\\n  },\\n  \\\"turn-compose-v1\\\": {\\n    input: {\\n      parts: [\\n        { messageId: \\\"m1\\\", kind: \\\"user_prompt\\\", text: \\\"please read notes/plan.md\\\", fallback: false },\\n        {\\n          messageId: \\\"m2\\\",\\n          kind: \\\"tool_call\\\",\\n          text: \\\"read_file called on notes/plan.md\\\",\\n          fallback: false,\\n          outcome: \\\"succeeded\\\",\\n        },\\n        { messageId: \\\"m3\\\", kind: \\\"assistant_text\\\", text: \\\"the plan has 3 open items\\\", fallback: false },\\n      ],\\n    },\\n    embedded: [\\\"please read notes/plan.md\\\", \\\"outcome: succeeded\\\", \\\"the plan has 3 open items\\\"],\\n  },\\n  \\\"lower-band-v1\\\": {\\n    input: {\\n      rendering: \\\"The user asked for notes/plan.md; the assistant read it and reported 3 open items.\\\",\\n    },\\n    embedded: [\\\"reported 3 open items\\\"],\\n  },\\n  \\\"chunk-detailed-v1\\\": {\\n    input: {\\n      memberProjections: [\\\"turn one: read notes/plan.md\\\", \\\"turn two: edited src/app.ts\\\"],\\n      memberReceipts: [\\n        [\\n          {\\n            messageId: \\\"m2\\\",\\n            activity: \\\"tool_call\\\",\\n            account: \\\"read_file fetched notes/plan.md\\\",\\n            outcome: \\\"succeeded\\\",\\n          },\\n        ],\\n        [],\\n      ],\\n    },\\n    embedded: [\\\"turn one: read notes/plan.md\\\", \\\"read_file fetched notes/plan.md => succeeded\\\"],\\n  },\\n  \\\"chunk-brief-v1\\\": {\\n    input: {\\n      memberProjections: [\\\"turn one: read notes/plan.md\\\", \\\"turn two: edited src/app.ts\\\"],\\n      memberOutcomes: [[\\\"succeeded\\\"], []],\\n    },\\n    embedded: [\\\"turn two: edited src/app.ts\\\", \\\"Tool outcomes, in order: succeeded\\\"],\\n  },\\n};\\n\\nfunction renderByName(name: string, input: unknown): ModelCallInput[\\\"messages\\\"] {\\n  const template = PROMPT_REGISTRY[name] as PromptTemplate<unknown> | undefined;\\n  if (template === undefined) throw new Error(`template \\\"${name}\\\" not in registry`);\\n  return template.render(input);\\n}\\n\\nfunction resolvedConfig(\\n  overrides: Partial<ResolvedInferenceConfig> & Pick<ResolvedInferenceConfig, \\\"call\\\">,\\n): ResolvedInferenceConfig {\\n  return {\\n    assignments: validAssignments(),\\n    timeoutMs: 60_000,\\n    maxInputChars: 200_000,\\n    ...overrides,\\n  };\\n}\\n\\nfunction userContent(input: ModelCallInput): string {\\n  const user = input.messages.find((message) => message.role === \\\"user\\\");\\n  if (user === undefined) throw new Error(\\\"no user message in rendered call\\\");\\n  return user.content;\\n}\\n\\ndescribe(\\\"TC-2.2: prompt-rendering goldens (AC-2.2, AC-2.3)\\\", () => {\\n  for (const kind of FORM_KINDS) {\\n    const name = DEFAULT_PROMPT_NAMES[kind];\\n    it(`${name} renders its fixture input to the committed golden`, () => {\\n      const fixture = PROMPT_FIXTURES[name];\\n      expect(fixture).toBeDefined();\\n      const rendered = renderByName(name, fixture?.input);\\n      const golden = JSON.parse(\\n        readFileSync(path.join(goldensDir, `${name}.golden.json`), \\\"utf8\\\"),\\n      ) as ModelCallInput[\\\"messages\\\"];\\n      expect(rendered).toEqual(golden);\\n    });\\n\\n    it(`${name} embeds its fixture content in single-turn shape`, () => {\\n      const fixture = PROMPT_FIXTURES[name];\\n      const rendered = renderByName(name, fixture?.input);\\n      expect(rendered.filter((message) => message.role === \\\"user\\\")).toHaveLength(1);\\n      for (const message of rendered) {\\n        expect([\\\"system\\\", \\\"user\\\"]).toContain(message.role);\\n        expect(typeof message.content).toBe(\\\"string\\\");\\n      }\\n      const joined = rendered.map((message) => message.content).join(\\\"\\\\n\\\");\\n      for (const needle of fixture?.embedded ?? []) {\\n        expect(joined).toContain(needle);\\n      }\\n    });\\n  }\\n});\\n\\ndescribe(\\\"TC-2.2: registry completeness (AC-2.3)\\\", () => {\\n  it(\\\"every registry key resolves to a template carrying that exact name\\\", () => {\\n    const names = Object.keys(PROMPT_REGISTRY);\\n    expect(names.length).toBeGreaterThanOrEqual(7);\\n    for (const name of names) {\\n      expect(PROMPT_REGISTRY[name]?.name).toBe(name);\\n      expect(typeof PROMPT_REGISTRY[name]?.render).toBe(\\\"function\\\");\\n    }\\n  });\\n\\n  it(\\\"default names cover all seven kinds and each resolves in the registry\\\", () => {\\n    const defaultNames = new Set<string>();\\n    for (const kind of FORM_KINDS) {\\n      const name = DEFAULT_PROMPT_NAMES[kind];\\n      expect(typeof name).toBe(\\\"string\\\");\\n      expect(PROMPT_REGISTRY[name]).toBeDefined();\\n      defaultNames.add(name);\\n    }\\n    // Seven kinds, seven distinct templates — no kind shares another's prompt.\\n    expect(defaultNames.size).toBe(7);\\n  });\\n});\\n\\ndescribe(\\\"TC-2.2: brief receipt-stripping holds through the adapter (AC-2.2)\\\", () => {\\n  const RECEIPT_ACCOUNT = \\\"read_file fetched notes/plan.md and rewrote temp/out.txt\\\";\\n\\n  it(\\\"the brief rendering carries outcome tokens but no receipt text from its input\\\", async () => {\\n    const { call, log } = recordingCall(cannedResponses());\\n    const provider = createInferenceProvider(resolvedConfig({ call }));\\n\\n    const detailed = await provider.summarizeChunkDetailed({\\n      memberProjections: [\\\"turn one: planning work\\\"],\\n      memberReceipts: [\\n        [{ messageId: \\\"m2\\\", activity: \\\"tool_call\\\", account: RECEIPT_ACCOUNT, outcome: \\\"succeeded\\\" }],\\n      ],\\n    });\\n    const brief = await provider.summarizeChunkBrief({\\n      memberProjections: [\\\"turn one: planning work\\\"],\\n      memberOutcomes: [[\\\"succeeded\\\"]],\\n    });\\n    expect(detailed.ok).toBe(true);\\n    expect(brief.ok).toBe(true);\\n\\n    const detailedCall = log.find(\\n      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_detailed`,\\n    );\\n    const briefCall = log.find(\\n      (input) => input.model === `${FAKE_MODEL_PREFIX}chunk_summary_brief`,\\n    );\\n    expect(detailedCall).toBeDefined();\\n    expect(briefCall).toBeDefined();\\n    if (detailedCall === undefined || briefCall === undefined) return;\\n\\n    // The detailed lane is the contrast: its rendering carries the receipt\\n    // account verbatim, so its absence from the brief lane is stripping, not\\n    // a template that ignores receipts altogether.\\n    expect(userContent(detailedCall)).toContain(RECEIPT_ACCOUNT);\\n    expect(userContent(briefCall)).toContain(\\\"succeeded\\\");\\n    expect(userContent(briefCall)).not.toContain(RECEIPT_ACCOUNT);\\n    expect(userContent(briefCall)).not.toContain(\\\"rewrote\\\");\\n  });\\n});\\n\\ndescribe(\\\"TC-2.2: tool-result input bounding (AC-2.2, DD-7)\\\", () => {\\n  const MAX_INPUT_CHARS = 200;\\n\\n  it(\\\"oversized summarizeToolResult input renders head + tail + marker under maxInputChars\\\", async () => {\\n    const { call, log } = recordingCall(cannedResponses());\\n    const provider = createInferenceProvider(\\n      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\\n    );\\n    const content = \\\"H\\\".repeat(150) + \\\"M\\\".repeat(700) + \\\"T\\\".repeat(150);\\n    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\\n    expect(result.ok).toBe(true);\\n\\n    const input = log[0];\\n    expect(input).toBeDefined();\\n    if (input === undefined) return;\\n    const user = userContent(input);\\n    const bounded = user.slice(user.indexOf(\\\"Output:\\\\n\\\") + \\\"Output:\\\\n\\\".length);\\n    expect(bounded.length).toBeLessThanOrEqual(MAX_INPUT_CHARS);\\n    expect(bounded.startsWith(\\\"HHHH\\\")).toBe(true);\\n    expect(bounded.endsWith(\\\"TTTT\\\")).toBe(true);\\n    expect(bounded).toContain(\\\"truncated\\\");\\n    // Bounding happened before rendering: the middle never reached the prompt.\\n    expect(user).not.toContain(\\\"M\\\".repeat(50));\\n  });\\n\\n  it(\\\"under-limit input renders whole, no marker\\\", async () => {\\n    const { call, log } = recordingCall(cannedResponses());\\n    const provider = createInferenceProvider(\\n      resolvedConfig({ call, maxInputChars: MAX_INPUT_CHARS }),\\n    );\\n    const content = \\\"W\\\".repeat(MAX_INPUT_CHARS);\\n    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\\n    expect(result.ok).toBe(true);\\n\\n    const input = log[0];\\n    expect(input).toBeDefined();\\n    if (input === undefined) return;\\n    const user = userContent(input);\\n    expect(user).toContain(content);\\n    expect(user).not.toContain(\\\"truncated\\\");\\n  });\\n});\\n\",\"structuredPatch\":[{\"oldStart\":238,\"oldLines\":6,\"newStart\":238,\"newLines\":34,\"lines\":[\"     expect(user).not.toContain(\\\"M\\\".repeat(50));\",\"   });\",\" \",\"+  it(\\\"a maxInputChars below the truncation marker still bounds the whole (DD-7)\\\", async () => {\",\"+    const { call, log } = recordingCall(cannedResponses());\",\"+    // 40 chars is a legitimately small context budget — and shorter than the\",\"+    // truncation marker itself. It is the counterexample to a naive\",\"+    // head+tail+marker bound: with no room for the marker, that bound returns\",\"+    // the marker alone and overshoots the cap it was meant to hold.\",\"+    const tinyMax = 40;\",\"+    const provider = createInferenceProvider(\",\"+      resolvedConfig({ call, maxInputChars: tinyMax }),\",\"+    );\",\"+    const content = \\\"H\\\".repeat(40) + \\\"M\\\".repeat(700) + \\\"T\\\".repeat(40);\",\"+    const result = await provider.summarizeToolResult({ toolName: \\\"read_file\\\", content });\",\"+    expect(result.ok).toBe(true);\",\"+\",\"+    const input = log[0];\",\"+    expect(input).toBeDefined();\",\"+    if (input === undefined) return;\",\"+    const user = userContent(input);\",\"+    const bounded = user.slice(user.indexOf(\\\"Output:\\\\n\\\") + \\\"Output:\\\\n\\\".length);\",\"+    // The bounded whole never exceeds the cap, even though no marker fits.\",\"+    expect(bounded.length).toBeLessThanOrEqual(tinyMax);\",\"+    // With no room for the marker the bound degrades to a plain head: a true\",\"+    // prefix of the input, never the marker text standing on its own.\",\"+    expect(content.startsWith(bounded)).toBe(true);\",\"+    expect(bounded).not.toContain(\\\"truncated\\\");\",\"+    expect(user).not.toContain(\\\"M\\\".repeat(50));\",\"+  });\",\"+\",\"   it(\\\"under-limit input renders whole, no marker\\\", async () => {\",\"     const { call, log } = recordingCall(cannedResponses());\",\"     const provider = createInferenceProvider(\"]}],\"userModified\":false,\"replaceAll\":false}}\ndocs/02-specs/05-derivation-inference/artifacts/inspect/001-inspect.json:1:{\"command\":\"inspe
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/inference/classify.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Failure classification (DD-3): a pure table from the boundary's failure\n     2\t// vocabulary onto Epic 02's retryable-or-not. The queue machinery consumes\n     3\t// `retryable` exactly as it always has — no queue changes, no new states.\n     4\t// `safeCall` is the containment wrapper around the host function: a thrown\n     5\t// exception classifies `other` (AC-3.3) and the adapter-owned timeout race\n     6\t// classifies `timeout` (DD-6) — both structured failures, so no host\n     7\t// function behavior can crash a drain.\n     8\timport type {\n     9\t  ModelCall,\n    10\t  ModelCallFailureKind,\n    11\t  ModelCallInput,\n    12\t  ModelCallResult,\n    13\t} from \"./types.js\";\n    14\t\n    15\texport const FAILURE_CLASSIFICATION: Record<ModelCallFailureKind, { retryable: boolean }> = {\n    16\t  rate_limit: { retryable: true },\n    17\t  timeout: { retryable: true },\n    18\t  network: { retryable: true },\n    19\t  empty_output: { retryable: true },\n    20\t  other: { retryable: true },\n    21\t  auth: { retryable: false },\n    22\t  invalid_request: { retryable: false },\n    23\t};\n    24\t\n    25\t/** try/catch + timeout race around the host function (AC-3.3, DD-6). */\n    26\texport async function safeCall(\n    27\t  call: ModelCall,\n    28\t  input: ModelCallInput,\n    29\t  timeoutMs: number,\n    30\t): Promise<ModelCallResult> {\n    31\t  let timer: NodeJS.Timeout | undefined;\n    32\t  const timeout = new Promise<ModelCallResult>((resolve) => {\n    33\t    timer = setTimeout(() => {\n    34\t      resolve({\n    35\t        ok: false,\n    36\t        kind: \"timeout\",\n    37\t        message: `model call timed out after ${String(timeoutMs)}ms`,\n    38\t      });\n    39\t    }, timeoutMs);\n    40\t  });\n    41\t  // The async wrapper folds synchronous throws into the same rejection path —\n    42\t  // the host's promise contract is not trusted (AC-3.3).\n    43\t  const attempt = (async (): Promise<ModelCallResult> => {\n    44\t    try {\n    45\t      return await call(input);\n    46\t    } catch (cause) {\n    47\t      return { ok: false, kind: \"other\", message: String(cause) };\n    48\t    }\n    49\t  })();\n    50\t  try {\n    51\t    // A host that resolves after the race resolves into nothing (DD-6).\n    52\t    return await Promise.race([attempt, timeout]);\n    53\t  } finally {\n    54\t    clearTimeout(timer);\n    55\t  }\n    56\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/sdk.ts | sed -n '1,260p'\"","aggregated_output":"     1\texport * as threads from \"./domains/threads/index.js\";\n     2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n     3\texport * as messages from \"./domains/messages/index.js\";\n     4\texport * as turns from \"./domains/turns/index.js\";\n     5\texport * as threadView from \"./domains/thread-view/index.js\";\n     6\texport * as inspect from \"./domains/inspect/index.js\";\n     7\t\n     8\timport * as inspectDomain from \"./domains/inspect/index.js\";\n     9\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n    10\timport * as threadViewDomain from \"./domains/thread-view/index.js\";\n    11\timport { resolveViewConfig } from \"./domains/thread-view/index.js\";\n    12\timport * as messagesDomain from \"./domains/messages/index.js\";\n    13\timport * as threadsDomain from \"./domains/threads/index.js\";\n    14\timport * as turnsDomain from \"./domains/turns/index.js\";\n    15\timport {\n    16\t  createScheduler,\n    17\t  peekThreadId,\n    18\t  runDrain,\n    19\t  type DrainDeps,\n    20\t  type DrainReport,\n    21\t  type Scheduler,\n    22\t} from \"./scheduler.js\";\n    23\timport {\n    24\t  runWithInstanceSeam,\n    25\t  setSchedulerPoke as installSchedulerPoke,\n    26\t  setThreadTouch,\n    27\t  type InstanceSeam,\n    28\t} from \"./shared/context.js\";\n    29\timport { createInferenceProvider } from \"./inference/adapter.js\";\n    30\timport { PROMPT_REGISTRY } from \"./inference/prompts/index.js\";\n    31\timport type { InferenceConfig, ModelAssignment } from \"./inference/types.js\";\n    32\timport {\n    33\t  FORM_KINDS,\n    34\t  PROVIDER_OPERATIONS,\n    35\t  type DerivationProvider,\n    36\t  type FormKind,\n    37\t  type ResolvedSdkConfig,\n    38\t  type SdkConfig,\n    39\t  type WorkHandler,\n    40\t} from \"./shared/derivation.js\";\n    41\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n    42\timport type {\n    43\t  CompactReceipt,\n    44\t  PullResult,\n    45\t  StoredView,\n    46\t  SweepReceipt,\n    47\t  ViewCompactParams,\n    48\t  ViewProfile,\n    49\t  ViewStatus,\n    50\t} from \"./shared/view.js\";\n    51\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n    52\t\n    53\texport {\n    54\t  estimateTokens,\n    55\t  TOKEN_ESTIMATOR_ID,\n    56\t} from \"./tech-utils/token-counting/index.js\";\n    57\t\n    58\texport {\n    59\t  WORK_KIND_REGISTRY,\n    60\t  type WorkItemRecord,\n    61\t  type WorkKind,\n    62\t  type WorkOwner,\n    63\t  type WorkSourceRef,\n    64\t} from \"./tech-utils/work-queue/index.js\";\n    65\t\n    66\texport type {\n    67\t  ErrorClass,\n    68\t  ErrorCode,\n    69\t  ErrorResult,\n    70\t  OpResult,\n    71\t} from \"./shared/errors.js\";\n    72\texport {\n    73\t  runInTransaction,\n    74\t  setSchedulerPoke,\n    75\t  setThreadTouch,\n    76\t  type OperationContext,\n    77\t} from \"./shared/context.js\";\n    78\t\n    79\texport {\n    80\t  createDeterministicProvider,\n    81\t  deterministicOutcomesSuffix,\n    82\t  deterministicReceiptsSuffix,\n    83\t  deterministicText,\n    84\t  type DeterministicOpName,\n    85\t} from \"./providers/deterministic.js\";\n    86\texport type {\n    87\t  CompletionTx,\n    88\t  DependencyGap,\n    89\t  DerivationProvider,\n    90\t  DerivedForm,\n    91\t  DerivedFormMetadata,\n    92\t  DerivedFormState,\n    93\t  FormKind,\n    94\t  FormReportEntry,\n    95\t  HandlerFormWrite,\n    96\t  HandlerOutcome,\n    97\t  HandlerRunContext,\n    98\t  ProviderResult,\n    99\t  RenderingPart,\n   100\t  ResolvedSdkConfig,\n   101\t  SdkConfig,\n   102\t  SubjectKind,\n   103\t  ToolOutcome,\n   104\t  ToolRunReceipt,\n   105\t  WorkHandler,\n   106\t} from \"./shared/derivation.js\";\n   107\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n   108\t\n   109\t// Epic 05 inference vocabulary (inference/types.ts): the host-supplied\n   110\t// ModelCall boundary and the per-kind assignment config — type-only; the\n   111\t// adapter and registry are construction internals behind createSdk.\n   112\texport type {\n   113\t  InferenceConfig,\n   114\t  ModelAssignment,\n   115\t  ModelCall,\n   116\t  ModelCallFailureKind,\n   117\t  ModelCallInput,\n   118\t  ModelCallResult,\n   119\t} from \"./inference/types.js\";\n   120\texport type { ProviderProvenance } from \"./shared/derivation.js\";\n   121\t\n   122\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n   123\t// from Story 0; the operation shapes land with Stories 1–5.\n   124\texport {\n   125\t  BUILT_IN_PROFILES,\n   126\t  DEFAULT_COMPACT_THRESHOLD,\n   127\t  DEFAULT_VISIBILITY,\n   128\t} from \"./domains/thread-view/index.js\";\n   129\texport type {\n   130\t  Band,\n   131\t  CompactReceipt,\n   132\t  PullResult,\n   133\t  ResolvedViewConfig,\n   134\t  SdkViewConfig,\n   135\t  StoredView,\n   136\t  SweepReceipt,\n   137\t  ViewCompactParams,\n   138\t  ViewMessage,\n   139\t  ViewMeta,\n   140\t  ViewProfile,\n   141\t  ViewProfileOverride,\n   142\t  ViewStatus,\n   143\t  VisibilityBudgets,\n   144\t} from \"./shared/view.js\";\n   145\texport {\n   146\t  countLiveItems,\n   147\t  enqueue,\n   148\t  queueDetail,\n   149\t  supersedeQueued,\n   150\t  type ClaimedWorkItem,\n   151\t  type EnqueueFormTarget,\n   152\t  type EnqueueInput,\n   153\t  type QueueDetailRow,\n   154\t} from \"./tech-utils/work-queue/index.js\";\n   155\t\n   156\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n   157\t// inspect surface serves.\n   158\texport type {\n   159\t  HealthReport,\n   160\t  InspectOverview,\n   161\t  ViewContentsReport,\n   162\t} from \"./shared/inspect.js\";\n   163\t\n   164\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n   165\texport type {\n   166\t  Block,\n   167\t  BlockType,\n   168\t  MessageDetail,\n   169\t  MessageListOptions,\n   170\t  MessageRecord,\n   171\t  MutationResult,\n   172\t} from \"./domains/messages/index.js\";\n   173\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   174\texport type {\n   175\t  BatchResult,\n   176\t  EventKind,\n   177\t  EventRecord,\n   178\t  MessageEventInput,\n   179\t} from \"./domains/intake-stream/index.js\";\n   180\t\n   181\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   182\t\n   183\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   184\t\n   185\t// Merge per-domain handler tables into the one join between the queue's\n   186\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   187\t// (each kind has exactly one owner) and throws at construction.\n   188\texport function assembleWorkHandlerMap(\n   189\t  tables: ReadonlyArray<WorkHandlerMap>,\n   190\t): WorkHandlerMap {\n   191\t  const map: WorkHandlerMap = {};\n   192\t  for (const table of tables) {\n   193\t    for (const [kind, handler] of Object.entries(table)) {\n   194\t      if (map[kind as WorkKind] !== undefined) {\n   195\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   196\t      }\n   197\t      map[kind as WorkKind] = handler;\n   198\t    }\n   199\t  }\n   200\t  return map;\n   201\t}\n   202\t\n   203\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   204\t  return {\n   205\t    ok: false,\n   206\t    error: {\n   207\t      errorClass: \"state_corruption\",\n   208\t      code: \"unknown_work_kind\",\n   209\t      reason: `no handler registered for work kind \"${kind}\"`,\n   210\t    },\n   211\t  };\n   212\t}\n   213\t\n   214\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   215\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   216\texport function lookupWorkHandler(\n   217\t  map: WorkHandlerMap,\n   218\t  kind: string,\n   219\t): OpResult<WorkHandler> {\n   220\t  const handler = map[kind as WorkKind];\n   221\t  if (handler === undefined) return unknownWorkKind(kind);\n   222\t  return { ok: true, value: handler };\n   223\t}\n   224\t\n   225\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   226\t// requeue land in Story 4.\n   227\texport interface WorkSurface {\n   228\t  drain(\n   229\t    ref: threadsDomain.ThreadRef,\n   230\t    opts?: { maxItems?: number },\n   231\t  ): Promise<OpResult<DrainReport>>;\n   232\t}\n   233\t\n   234\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n   235\t// §Interface Definitions): the operations only — the Story 0 config\n   236\t// substrate the domain index also carries is construction machinery, not an\n   237\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n   238\t// inspect domain composes (DD-1).\n   239\texport interface ThreadViewSurface {\n   240\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n   241\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n   242\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n   243\t  compact(\n   244\t    ref: threadsDomain.ThreadRef,\n   245\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   246\t  ): Promise<OpResult<CompactReceipt>>;\n   247\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n   248\t  materialize(\n   249\t    ref: threadsDomain.ThreadRef,\n   250\t    opts: { path: string; format?: \"pi-session\" },\n   251\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   252\t}\n   253\t\n   254\texport interface Lhc {\n   255\t  threads: typeof threadsDomain;\n   256\t  intakeStream: typeof intakeStreamDomain;\n   257\t  messages: typeof messagesDomain;\n   258\t  turns: typeof turnsDomain;\n   259\t  threadView: ThreadViewSurface;\n   260\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n","exit_code":0,"status":"completed"}}

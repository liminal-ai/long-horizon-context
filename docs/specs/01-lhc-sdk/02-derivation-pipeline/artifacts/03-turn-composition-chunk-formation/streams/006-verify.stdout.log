{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/derivation-turns.test.ts | sed -n '450,680p'\"","aggregated_output":"   450\t    // projection meets the max.\n   451\t    const sdk = manualSdk(provider, {\n   452\t      targetProjectedTokens: big,\n   453\t      maxProjectedTokens: big,\n   454\t    });\n   455\t    const filePath = await newThread();\n   456\t    await sendTurn(sdk, filePath, \"small turn\", \"small answer\");\n   457\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n   458\t\n   459\t    await drain(sdk, filePath);\n   460\t    const snapshot = readChunks(filePath);\n   461\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n   462\t      [\"c1\", \"closed\"],\n   463\t      [\"c2\", \"closed\"],\n   464\t    ]);\n   465\t    expect(snapshot.members).toEqual([\n   466\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n   467\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n   468\t    ]);\n   469\t    for (const chunkId of [\"c1\", \"c2\"]) {\n   470\t      expect(formOf(filePath, chunkId, \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n   471\t      expect(formOf(filePath, chunkId, \"chunk_summary_brief\")?.state).toBe(\"ready\");\n   472\t    }\n   473\t  });\n   474\t});\n   475\t\n   476\tdescribe(\"TC-3.8 / AC-3.8: chunk close queues two summary work items with independent lifecycles\", () => {\n   477\t  // target=max=1: every turn self-chunks and closes immediately, the\n   478\t  // smallest deterministic way to manufacture closed chunks.\n   479\t  const SELF_CHUNK = { targetProjectedTokens: 1, maxProjectedTokens: 1 };\n   480\t\n   481\t  it(\"both summaries land ready as distinct chunk-level forms\", async () => {\n   482\t    const double = createProviderDouble();\n   483\t    const sdk = manualSdk(double, SELF_CHUNK);\n   484\t    const filePath = await newThread();\n   485\t    await sendTurn(sdk, filePath, \"summarize me\", \"summarized\");\n   486\t\n   487\t    const report = await drain(sdk, filePath);\n   488\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n   489\t      [\"prompt_smoothing\", \"done\"],\n   490\t      [\"turn_derivation\", \"done\"],\n   491\t      [\"chunk_summary_detailed\", \"done\"],\n   492\t      [\"chunk_summary_brief\", \"done\"],\n   493\t    ]);\n   494\t    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n   495\t    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n   496\t    expect(detailed?.state).toBe(\"ready\");\n   497\t    expect(brief?.state).toBe(\"ready\");\n   498\t    // Double-marked content distinguishes the two kinds: each went through\n   499\t    // its own provider operation, detailed over projections + receipts,\n   500\t    // brief over projections + outcomes (empty here — no tool activity).\n   501\t    const memberProjections = [formOf(filePath, \"t1\", \"lower_band_projection\")?.content ?? \"\"];\n   502\t    expect(detailed?.content).toBe(\n   503\t      deterministicText(\n   504\t        \"summarizeChunkDetailed\",\n   505\t        { memberProjections, memberReceipts: [[]] },\n   506\t        memberProjections.join(\" | \"),\n   507\t      ),\n   508\t    );\n   509\t    expect(brief?.content).toBe(\n   510\t      deterministicText(\n   511\t        \"summarizeChunkBrief\",\n   512\t        { memberProjections, memberOutcomes: [[]] },\n   513\t        memberProjections.join(\" | \"),\n   514\t      ),\n   515\t    );\n   516\t    expect(detailed?.content).not.toBe(brief?.content);\n   517\t  });\n   518\t\n   519\t  it(\"detailed preserves the tool-run receipts; brief strips them to outcomes only (SV-3.8-001)\", async () => {\n   520\t    const double = createProviderDouble();\n   521\t    const captured = double.captureInputs();\n   522\t    const sdk = manualSdk(double, SELF_CHUNK);\n   523\t    const filePath = await newThread();\n   524\t    // The run-receipts fixture: a two-call edit run, one isError, closing\n   525\t    // into its own chunk so both summaries derive over it.\n   526\t    await send(sdk, filePath, [\n   527\t      validEvent(\"user_prompt\", { payload: { text: \"edit two files\" } }),\n   528\t      validEvent(\"tool_call\", {\n   529\t        payload: { toolCallId: \"rcpt-a\", toolName: \"edit_file\", arguments: { path: \"ok.txt\" } },\n   530\t      }),\n   531\t      validEvent(\"tool_result\", {\n   532\t        payload: { toolCallId: \"rcpt-a\", content: \"edited ok.txt\", isError: false },\n   533\t      }),\n   534\t      validEvent(\"tool_call\", {\n   535\t        payload: { toolCallId: \"rcpt-b\", toolName: \"edit_file\", arguments: { path: \"ro.txt\" } },\n   536\t      }),\n   537\t      validEvent(\"tool_result\", {\n   538\t        payload: { toolCallId: \"rcpt-b\", content: \"read-only file\", isError: true },\n   539\t      }),\n   540\t      validEvent(\"turn_end\"),\n   541\t    ]);\n   542\t    await drain(sdk, filePath);\n   543\t\n   544\t    // The receipts are mechanically stamped on the rendering: account text\n   545\t    // = each tool message's ready summary form content, outcome from the\n   546\t    // record — the material the detailed summary must preserve.\n   547\t    const expectedReceipts = ([\"m2\", \"m3\", \"m4\", \"m5\"] as const).map((messageId, index) => ({\n   548\t      messageId,\n   549\t      activity: index % 2 === 0 ? \"tool_call\" : \"tool_result\",\n   550\t      account: formOf(filePath, messageId, index % 2 === 0 ? \"tool_call_summary\" : \"tool_result_summary\")?.content,\n   551\t      outcome: index < 2 ? \"succeeded\" : \"failed\",\n   552\t    }));\n   553\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.metadata?.receipts).toEqual(expectedReceipts);\n   554\t\n   555\t    // Seam evidence: the detailed call received the full receipts; the\n   556\t    // brief call received outcomes only — no receipt account text anywhere\n   557\t    // in its input, so brief structurally cannot preserve more than\n   558\t    // outcomes.\n   559\t    const detailedInput = captured.find((entry) => entry.op === \"summarizeChunkDetailed\")?.input;\n   560\t    const briefInput = captured.find((entry) => entry.op === \"summarizeChunkBrief\")?.input;\n   561\t    expect((detailedInput as { memberReceipts: unknown }).memberReceipts).toEqual([\n   562\t      expectedReceipts,\n   563\t    ]);\n   564\t    expect(briefInput).toEqual({\n   565\t      memberProjections: [formOf(filePath, \"t1\", \"lower_band_projection\")?.content],\n   566\t      memberOutcomes: [[\"succeeded\", \"succeeded\", \"failed\", \"failed\"]],\n   567\t    });\n   568\t    for (const receipt of expectedReceipts) {\n   569\t      expect(JSON.stringify(briefInput)).not.toContain(receipt.account as string);\n   570\t    }\n   571\t\n   572\t    // Artifact evidence: the detailed summary carries every receipt's\n   573\t    // account and outcome; the brief summary carries the outcomes and none\n   574\t    // of the receipt content.\n   575\t    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n   576\t    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n   577\t    expect(detailed?.state).toBe(\"ready\");\n   578\t    expect(brief?.state).toBe(\"ready\");\n   579\t    for (const receipt of expectedReceipts) {\n   580\t      expect(detailed?.content).toContain(`${receipt.account as string}=>${receipt.outcome}`);\n   581\t    }\n   582\t    expect(brief?.content).toContain(\"[outcomes succeeded,succeeded,failed,failed]\");\n   583\t    expect(brief?.content).not.toContain(\"toolcall(\");\n   584\t    expect(brief?.content).not.toContain(\"toolresult(\");\n   585\t  });\n   586\t\n   587\t  it(\"the brief item fails past budget alone: detailed ready, brief failed, brief re-queueable by itself\", async () => {\n   588\t    const double = createProviderDouble();\n   589\t    const sdk = manualSdk(double, SELF_CHUNK);\n   590\t    const filePath = await newThread();\n   591\t    double.failKind(\"chunk_summary_brief\", 3, {\n   592\t      retryable: true,\n   593\t      reason: \"scripted brief failure\",\n   594\t    });\n   595\t    await sendTurn(sdk, filePath, \"independent retry\", \"answer\");\n   596\t\n   597\t    const report = await drain(sdk, filePath);\n   598\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n   599\t      [\"prompt_smoothing\", \"done\"],\n   600\t      [\"turn_derivation\", \"done\"],\n   601\t      [\"chunk_summary_detailed\", \"done\"],\n   602\t      [\"chunk_summary_brief\", \"failed_terminal\"],\n   603\t    ]);\n   604\t    const detailedBefore = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n   605\t    expect(detailedBefore?.state).toBe(\"ready\");\n   606\t    const failedBrief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n   607\t    expect(failedBrief?.state).toBe(\"failed\");\n   608\t    expect(failedBrief?.reason).toBe(\"scripted brief failure\");\n   609\t\n   610\t    // Re-queue the brief alone through the queue util (Story 4 owns the\n   611\t    // public surface); the detailed form must not move.\n   612\t    requeueDirect(filePath, {\n   613\t      owner: \"turns\",\n   614\t      kind: \"chunk_summary_brief\",\n   615\t      sourceRef: { chunkId: \"c1\" },\n   616\t      forms: [{ subjectKind: \"chunk\", subjectId: \"c1\", form: \"chunk_summary_brief\" }],\n   617\t    });\n   618\t    const requeued = await drain(sdk, filePath);\n   619\t    expect(requeued.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n   620\t      [\"chunk_summary_brief\", \"done\"],\n   621\t    ]);\n   622\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n   623\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")).toEqual(detailedBefore);\n   624\t  });\n   625\t});\n   626\t\n   627\tdescribe(\"TC-3.9 / AC-3.9 (architecture risk): chunk boundaries are deterministic under replay\", () => {\n   628\t  it(\"the same event stream into a fresh thread re-chunks identically — membership and boundaries deep-equal\", async () => {\n   629\t    const policy = { targetProjectedTokens: 60, maxProjectedTokens: 4400 };\n   630\t    const turnsContent: Array<[string, string]> = [\n   631\t      [\"first prompt about the parser\", \"parser answer with detail\"],\n   632\t      [\"second prompt about the cache\", \"cache answer, longer, with extra words\"],\n   633\t      [\"third prompt about the index rebuild\", \"index answer\"],\n   634\t      [\"fourth prompt, short\", \"fourth answer, also short\"],\n   635\t      [\"fifth prompt to push past one chunk\", \"fifth answer closing things out\"],\n   636\t    ];\n   637\t\n   638\t    async function buildAndDrain(): Promise<string> {\n   639\t      const double = createProviderDouble();\n   640\t      const sdk = manualSdk(double, policy);\n   641\t      const filePath = await newThread();\n   642\t      for (const [prompt, answer] of turnsContent) await sendTurn(sdk, filePath, prompt, answer);\n   643\t      await drain(sdk, filePath);\n   644\t      return filePath;\n   645\t    }\n   646\t\n   647\t    const first = await buildAndDrain();\n   648\t    const second = await buildAndDrain();\n   649\t\n   650\t    const firstSnapshot = readChunks(first);\n   651\t    expect(firstSnapshot).toEqual(readChunks(second));\n   652\t    // The replay claim is only meaningful if the policy actually cut: the\n   653\t    // stream must span more than one chunk.\n   654\t    expect(firstSnapshot.chunks.length).toBeGreaterThan(1);\n   655\t    // No inference joined placement anywhere: the closed chunks' summary\n   656\t    // artifacts are byte-identical across the two records too.\n   657\t    const summariesOf = (filePath: string) =>\n   658\t      readDerivedForms(filePath)\n   659\t        .filter((form) => form.subjectKind === \"chunk\")\n   660\t        .map((form) => [form.subjectId, form.form, form.state, form.content]);\n   661\t    expect(summariesOf(first)).toEqual(summariesOf(second));\n   662\t  });\n   663\t});\n","exit_code":0,"status":"completed"}}

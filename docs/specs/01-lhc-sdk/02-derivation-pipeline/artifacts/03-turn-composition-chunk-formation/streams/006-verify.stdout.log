{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/providers/deterministic.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// The deterministic provider: marked, input-derived output for every seam\n     2\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n     3\t// functions of the input. It backs the named-provider registry's\n     4\t// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n     5\t// resolution seam, and the test double reuses these helpers so in-process and\n     6\t// spawned runs produce byte-identical artifacts. It is selectable only by\n     7\t// explicit name — never a production default.\n     8\timport type {\n     9\t  DerivationProvider,\n    10\t  ProviderResult,\n    11\t  RenderingPart,\n    12\t  ToolOutcome,\n    13\t  ToolRunReceipt,\n    14\t} from \"../shared/derivation.js\";\n    15\t\n    16\texport type DeterministicOpName =\n    17\t  | \"smoothPrompt\"\n    18\t  | \"summarizeToolCall\"\n    19\t  | \"summarizeToolResult\"\n    20\t  | \"composeTurnRendering\"\n    21\t  | \"projectLowerBand\"\n    22\t  | \"summarizeChunkDetailed\"\n    23\t  | \"summarizeChunkBrief\";\n    24\t\n    25\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n    26\t  smoothPrompt: \"smoothed\",\n    27\t  summarizeToolCall: \"toolcall\",\n    28\t  summarizeToolResult: \"toolresult\",\n    29\t  composeTurnRendering: \"rendering\",\n    30\t  projectLowerBand: \"projection\",\n    31\t  summarizeChunkDetailed: \"detailed\",\n    32\t  summarizeChunkBrief: \"brief\",\n    33\t};\n    34\t\n    35\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n    36\t// input-sensitive enough that distinct inputs mark distinct outputs.\n    37\texport function deterministicDigest(input: unknown): string {\n    38\t  const text = JSON.stringify(input);\n    39\t  let hash = 0x811c9dc5;\n    40\t  for (let i = 0; i < text.length; i += 1) {\n    41\t    hash ^= text.charCodeAt(i);\n    42\t    hash = Math.imul(hash, 0x01000193) >>> 0;\n    43\t  }\n    44\t  return hash.toString(16).padStart(8, \"0\");\n    45\t}\n    46\t\n    47\texport function deterministicText(\n    48\t  op: DeterministicOpName,\n    49\t  input: unknown,\n    50\t  text: string,\n    51\t): string {\n    52\t  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n    53\t}\n    54\t\n    55\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n    56\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n    57\t}\n    58\t\n    59\t// The chunk-summary contract made visible in deterministic output (AC-3.8):\n    60\t// the detailed summary's artifact carries the members' tool-run receipts —\n    61\t// account and outcome — verbatim; the brief summary's carries outcomes\n    62\t// only. Pure suffixes over the input fields, shared with the test double so\n    63\t// in-process and spawned artifacts stay byte-identical; empty receipt sets\n    64\t// add nothing, keeping receipt-less output unchanged.\n    65\texport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\n    66\t  const receipts = (memberReceipts ?? []).flat();\n    67\t  if (receipts.length === 0) return \"\";\n    68\t  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\"; \")}]`;\n    69\t}\n    70\t\n    71\texport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\n    72\t  const outcomes = (memberOutcomes ?? []).flat();\n    73\t  if (outcomes.length === 0) return \"\";\n    74\t  return `[outcomes ${outcomes.join(\",\")}]`;\n    75\t}\n    76\t\n    77\texport function createDeterministicProvider(): DerivationProvider {\n    78\t  return {\n    79\t    smoothPrompt: (i: { text: string }) => ok(\"smoothPrompt\", i, i.text),\n    80\t    summarizeToolCall: (i: {\n    81\t      toolName: string;\n    82\t      argsJson: string;\n    83\t      pairedResult?: { content: string; isError: boolean };\n    84\t    }) => ok(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`),\n    85\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\n    86\t      ok(\"summarizeToolResult\", i, i.content),\n    87\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\n    88\t      ok(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \")),\n    89\t    projectLowerBand: (i: { rendering: string }) => ok(\"projectLowerBand\", i, i.rendering),\n    90\t    summarizeChunkDetailed: async (i: {\n    91\t      memberProjections: string[];\n    92\t      memberReceipts?: ToolRunReceipt[][];\n    93\t    }) => {\n    94\t      const base = await ok(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n    95\t      if (!base.ok) return base;\n    96\t      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\n    97\t    },\n    98\t    summarizeChunkBrief: async (i: {\n    99\t      memberProjections: string[];\n   100\t      memberOutcomes?: ToolOutcome[][];\n   101\t    }) => {\n   102\t      const base = await ok(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n   103\t      if (!base.ok) return base;\n   104\t      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\n   105\t    },\n   106\t  };\n   107\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/provider-double.ts | sed -n '1,230p'\"","aggregated_output":"     1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n     2\t// Injected at the same seam production adapters use — dependency injection,\n     3\t// not a mock of internals. Every operation returns marked, input-derived\n     4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n     5\t// functions of the input, so identical input to the same operation yields\n     6\t// identical output across double instances, and different operations are\n     7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n     8\t// captureInputs) is per-instance state and never leaks across tests that\n     9\t// construct their own double.\n    10\timport {\n    11\t  deterministicOutcomesSuffix,\n    12\t  deterministicReceiptsSuffix,\n    13\t  deterministicText,\n    14\t  type DerivationProvider,\n    15\t  type ProviderResult,\n    16\t  type RenderingPart,\n    17\t  type ToolOutcome,\n    18\t  type ToolRunReceipt,\n    19\t} from \"../../src/index.js\";\n    20\t\n    21\texport type ProviderOpName =\n    22\t  | \"smoothPrompt\"\n    23\t  | \"summarizeToolCall\"\n    24\t  | \"summarizeToolResult\"\n    25\t  | \"composeTurnRendering\"\n    26\t  | \"projectLowerBand\"\n    27\t  | \"summarizeChunkDetailed\"\n    28\t  | \"summarizeChunkBrief\";\n    29\t\n    30\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n    31\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n    32\t// as the operation names themselves.\n    33\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n    34\t  smoothPrompt: \"smoothPrompt\",\n    35\t  summarizeToolCall: \"summarizeToolCall\",\n    36\t  summarizeToolResult: \"summarizeToolResult\",\n    37\t  composeTurnRendering: \"composeTurnRendering\",\n    38\t  projectLowerBand: \"projectLowerBand\",\n    39\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n    40\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n    41\t  prompt_smoothing: \"smoothPrompt\",\n    42\t  smoothed_prompt: \"smoothPrompt\",\n    43\t  tool_call_summary: \"summarizeToolCall\",\n    44\t  tool_result_summary: \"summarizeToolResult\",\n    45\t  turn_rendering: \"composeTurnRendering\",\n    46\t  lower_band_projection: \"projectLowerBand\",\n    47\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n    48\t  chunk_summary_brief: \"summarizeChunkBrief\",\n    49\t};\n    50\t\n    51\tfunction resolveOpName(kind: string): ProviderOpName {\n    52\t  const op = KIND_ALIASES[kind];\n    53\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n    54\t  return op;\n    55\t}\n    56\t\n    57\tinterface FailScript {\n    58\t  remaining: number;\n    59\t  retryable: boolean;\n    60\t  reason: string;\n    61\t}\n    62\t\n    63\texport interface CapturedInput {\n    64\t  op: ProviderOpName;\n    65\t  input: unknown;\n    66\t}\n    67\t\n    68\texport class ProviderDouble implements DerivationProvider {\n    69\t  private failNextScript: FailScript | null = null;\n    70\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n    71\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n    72\t  private capturing = false;\n    73\t  private readonly captured: CapturedInput[] = [];\n    74\t\n    75\t  // Fail the next n calls to any operation, then succeed.\n    76\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    77\t    this.failNextScript = {\n    78\t      remaining: n,\n    79\t      retryable: opts?.retryable ?? true,\n    80\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    81\t    };\n    82\t  }\n    83\t\n    84\t  // Fail the next n calls to one operation (kind names and op names both\n    85\t  // accepted). retryable: false scripts a terminal failure.\n    86\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    87\t    const op = resolveOpName(kind);\n    88\t    this.failByOp.set(op, {\n    89\t      remaining: n,\n    90\t      retryable: opts?.retryable ?? true,\n    91\t      reason: opts?.reason ?? `scripted failure (${op})`,\n    92\t    });\n    93\t  }\n    94\t\n    95\t  delayKind(kind: string, ms: number): void {\n    96\t    this.delayByOp.set(resolveOpName(kind), ms);\n    97\t  }\n    98\t\n    99\t  // Start capturing inputs; returns the live log (appended in call order).\n   100\t  captureInputs(): readonly CapturedInput[] {\n   101\t    this.capturing = true;\n   102\t    return this.captured;\n   103\t  }\n   104\t\n   105\t  private async run(\n   106\t    op: ProviderOpName,\n   107\t    input: unknown,\n   108\t    text: string,\n   109\t    suffix = \"\",\n   110\t  ): Promise<ProviderResult> {\n   111\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n   112\t    const delay = this.delayByOp.get(op);\n   113\t    if (delay !== undefined && delay > 0) {\n   114\t      await new Promise((resolve) => setTimeout(resolve, delay));\n   115\t    }\n   116\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n   117\t    for (const script of scripts) {\n   118\t      if (script !== null && script.remaining > 0) {\n   119\t        script.remaining -= 1;\n   120\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n   121\t      }\n   122\t    }\n   123\t    // Output format shared with src/providers/deterministic.ts so the double\n   124\t    // and the registry's \"deterministic\" provider produce byte-identical\n   125\t    // artifacts across in-process and spawned runs; the chunk-summary\n   126\t    // receipt/outcome suffixes (AC-3.8) come from the same shared helpers.\n   127\t    return { ok: true, text: deterministicText(op, input, text) + suffix };\n   128\t  }\n   129\t\n   130\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n   131\t    return this.run(\"smoothPrompt\", i, i.text);\n   132\t  }\n   133\t\n   134\t  summarizeToolCall(i: {\n   135\t    toolName: string;\n   136\t    argsJson: string;\n   137\t    pairedResult?: { content: string; isError: boolean };\n   138\t  }): Promise<ProviderResult> {\n   139\t    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n   140\t  }\n   141\t\n   142\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n   143\t    return this.run(\"summarizeToolResult\", i, i.content);\n   144\t  }\n   145\t\n   146\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n   147\t    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n   148\t  }\n   149\t\n   150\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n   151\t    return this.run(\"projectLowerBand\", i, i.rendering);\n   152\t  }\n   153\t\n   154\t  summarizeChunkDetailed(i: {\n   155\t    memberProjections: string[];\n   156\t    memberReceipts?: ToolRunReceipt[][];\n   157\t  }): Promise<ProviderResult> {\n   158\t    return this.run(\n   159\t      \"summarizeChunkDetailed\",\n   160\t      i,\n   161\t      i.memberProjections.join(\" | \"),\n   162\t      deterministicReceiptsSuffix(i.memberReceipts),\n   163\t    );\n   164\t  }\n   165\t\n   166\t  summarizeChunkBrief(i: {\n   167\t    memberProjections: string[];\n   168\t    memberOutcomes?: ToolOutcome[][];\n   169\t  }): Promise<ProviderResult> {\n   170\t    return this.run(\n   171\t      \"summarizeChunkBrief\",\n   172\t      i,\n   173\t      i.memberProjections.join(\" | \"),\n   174\t      deterministicOutcomesSuffix(i.memberOutcomes),\n   175\t    );\n   176\t  }\n   177\t}\n   178\t\n   179\texport function createProviderDouble(): ProviderDouble {\n   180\t  return new ProviderDouble();\n   181\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport type {\n    11\t  DependencyGap,\n    12\t  HandlerOutcome,\n    13\t  HandlerRunContext,\n    14\t  WorkHandler,\n    15\t} from \"../../../shared/derivation.js\";\n    16\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    17\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    18\timport { composeRenderingInput } from \"./compose.js\";\n    19\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    20\timport {\n    21\t  chunkExists,\n    22\t  readMemberMessages,\n    23\t  readMemberProjections,\n    24\t  readMessageFormRows,\n    25\t  readTurnSource,\n    26\t} from \"./forms.js\";\n    27\t\n    28\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    29\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    30\t}\n    31\t\n    32\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    33\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    34\t}\n    35\t\n    36\tfunction readThreadId(run: HandlerRunContext): string {\n    37\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    38\t    | { thread_id: string }\n    39\t    | undefined;\n    40\t  return row?.thread_id ?? \"\";\n    41\t}\n    42\t\n    43\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n    44\t  const turnId = item.sourceRef[\"turnId\"];\n    45\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n    46\t  const db = run.openDb();\n    47\t  const turn = readTurnSource(db, turnId);\n    48\t  if (turn === undefined || turn.deleted) {\n    49\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    50\t    // would hit nothing; either way the item is terminal against a source\n    51\t    // that cannot improve.\n    52\t    return sourceDamaged(`turn ${turnId} not found`);\n    53\t  }\n    54\t  if (turn.status !== \"closed\") {\n    55\t    // Derivation is queued only at close; an open turn under a queued item\n    56\t    // means the record was interfered with.\n    57\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n    58\t  }\n    59\t\n    60\t  // Compose from current message-form states: ready forms verbatim,\n    61\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n    62\t  // before any provider call, and no transaction is held across them.\n    63\t  const messages = readMemberMessages(db, turnId);\n    64\t  const forms = readMessageFormRows(\n    65\t    db,\n    66\t    messages.map((message) => message.messageId),\n    67\t  );\n    68\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n    69\t\n    70\t  const rendering = await run.provider.composeTurnRendering({ parts });\n    71\t  if (!rendering.ok) return providerFailed(rendering);\n    72\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n    73\t  if (!projection.ok) return providerFailed(projection);\n    74\t\n    75\t  // The projection's token count is estimated exactly once, here, as the\n    76\t  // artifact lands; placement reads this stored arithmetic and never\n    77\t  // re-counts (AC-3.9's determinism input).\n    78\t  const projectedTokens = estimateTokens(projection.text);\n    79\t  const threadId = readThreadId(run);\n    80\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n    81\t\n    82\t  return {\n    83\t    ok: true,\n    84\t    forms: [\n    85\t      {\n    86\t        subjectKind: \"turn\",\n    87\t        subjectId: turnId,\n    88\t        form: \"turn_rendering\",\n    89\t        content: rendering.text,\n    90\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n    91\t        // Tool-run receipts ride the rendering's metadata, mechanically\n    92\t        // restated from the composition input (AC-3.8) — the chunk\n    93\t        // summaries read them from here, never from provider prose.\n    94\t        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n    95\t      },\n    96\t      {\n    97\t        subjectKind: \"turn\",\n    98\t        subjectId: turnId,\n    99\t        form: \"lower_band_projection\",\n   100\t        content: projection.text,\n   101\t      },\n   102\t    ],\n   103\t    onApplied: (tx) => {\n   104\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   105\t      for (const chunkId of placement.closedChunkIds) {\n   106\t        enqueueChunkSummaries(\n   107\t          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n   108\t          chunkId,\n   109\t        );\n   110\t      }\n   111\t    },\n   112\t  };\n   113\t};\n   114\t\n   115\t// One read for both summary kinds — member projections in turn order — but\n   116\t// two contracts at the provider seam (AC-3.8): detailed receives the\n   117\t// members' tool-run receipts (what changed, outcome) read from the\n   118\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n   119\t// text stripped here so the brief provider call structurally cannot carry\n   120\t// it. Two work items, two handlers' runs, independent retry and states. A\n   121\t// member whose projection is not ready falls back to nothing and records a\n   122\t// gap, mirroring the rendering's fallback rule.\n   123\tfunction chunkSummaryHandler(\n   124\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   125\t): WorkHandler {\n   126\t  return async (run, item) => {\n   127\t    const chunkId = item.sourceRef[\"chunkId\"];\n   128\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   129\t    const db = run.openDb();\n   130\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   131\t\n   132\t    const members = readMemberProjections(db, chunkId);\n   133\t    const memberProjections: string[] = [];\n   134\t    const gaps: DependencyGap[] = [];\n   135\t    for (const member of members) {\n   136\t      if (member.state === \"ready\" && member.content !== undefined) {\n   137\t        memberProjections.push(member.content);\n   138\t      } else {\n   139\t        memberProjections.push(\"\");\n   140\t        gaps.push({\n   141\t          subjectKind: \"turn\",\n   142\t          subjectId: member.turnId,\n   143\t          form: \"lower_band_projection\",\n   144\t        });\n   145\t      }\n   146\t    }\n   147\t\n   148\t    const result =\n   149\t      kind === \"chunk_summary_detailed\"\n   150\t        ? await run.provider.summarizeChunkDetailed({\n   151\t            memberProjections,\n   152\t            memberReceipts: members.map((member) => member.receipts),\n   153\t          })\n   154\t        : await run.provider.summarizeChunkBrief({\n   155\t            memberProjections,\n   156\t            memberOutcomes: members.map((member) =>\n   157\t              member.receipts.map((receipt) => receipt.outcome),\n   158\t            ),\n   159\t          });\n   160\t    if (!result.ok) return providerFailed(result);\n   161\t\n   162\t    return {\n   163\t      ok: true,\n   164\t      forms: [\n   165\t        {\n   166\t          subjectKind: \"chunk\",\n   167\t          subjectId: chunkId,\n   168\t          form: kind,\n   169\t          content: result.text,\n   170\t          ...(gaps.length > 0 ? { gaps } : {}),\n   171\t        },\n   172\t      ],\n   173\t    };\n   174\t  };\n   175\t}\n   176\t\n   177\t// The domain's handler table, merged into the SDK dispatch map at\n   178\t// construction (DD-6).\n   179\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   180\t  turn_derivation: turnDerivationHandler,\n   181\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   182\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   183\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/compose.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n     2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n     3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n     4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n     5\t// clock in the signature: determinism is structural, not disciplined.\n     6\t//\n     7\t// Tool activity stays in message order — runs are the consecutive tool\n     8\t// messages exactly as recorded, never reordered to make accounts tidier —\n     9\t// and every tool part carries its outcome, so a run containing a\n    10\t// state-changing call structurally cannot lose its outcome in composition\n    11\t// (AC-3.4: the outcome rides the part, not the prose).\n    12\timport type {\n    13\t  DependencyGap,\n    14\t  DerivedFormMetadata,\n    15\t  DerivedFormState,\n    16\t  FormKind,\n    17\t  RenderingPart,\n    18\t  RenderingPartKind,\n    19\t  ToolOutcome,\n    20\t  ToolRunReceipt,\n    21\t} from \"../../../shared/derivation.js\";\n    22\t\n    23\t// The member message as the composer sees it: kind plus projected blocks,\n    24\t// verbatim from the record (already deleted-filtered by the caller's read).\n    25\texport interface ComposeMessage {\n    26\t  messageId: string;\n    27\t  kind: RenderingPartKind;\n    28\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    29\t}\n    30\t\n    31\t// One message-owned form row as composition input; keyed by the caller as\n    32\t// `${messageId}/${form}`.\n    33\texport interface ComposeFormRow {\n    34\t  state: DerivedFormState;\n    35\t  content?: string;\n    36\t  metadata?: DerivedFormMetadata;\n    37\t}\n    38\t\n    39\texport function composeFormKey(messageId: string, form: FormKind): string {\n    40\t  return `${messageId}/${form}`;\n    41\t}\n    42\t\n    43\texport interface CompositionInput {\n    44\t  parts: RenderingPart[];\n    45\t  gaps: DependencyGap[];\n    46\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n    47\t  // account + outcome, in message order — pure restatement of the\n    48\t  // composition input, stamped on the rendering so chunk summaries read\n    49\t  // receipts without re-deriving anything.\n    50\t  receipts: ToolRunReceipt[];\n    51\t}\n    52\t\n    53\t// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n    54\t// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n    55\t// function of the input string alone.\n    56\texport const FALLBACK_TRUNCATION_LIMIT = 200;\n    57\t\n    58\texport function truncateForFallback(text: string): string {\n    59\t  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n    60\t  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n    61\t  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n    62\t}\n    63\t\n    64\tfunction textOf(message: ComposeMessage): string {\n    65\t  const text = message.blocks[0]?.content[\"text\"];\n    66\t  return typeof text === \"string\" ? text : \"\";\n    67\t}\n    68\t\n    69\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n    70\t// composition): a tool call's outcome comes from its paired result among the\n    71\t// turn's messages — present and clean, present and isError, or absent.\n    72\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n    73\t  const byCallId = new Map<string, boolean>();\n    74\t  for (const message of messages) {\n    75\t    if (message.kind !== \"tool_result\") continue;\n    76\t    const block = message.blocks[0]?.content ?? {};\n    77\t    const callId = block[\"toolCallId\"];\n    78\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n    79\t  }\n    80\t  return byCallId;\n    81\t}\n    82\t\n    83\tfunction outcomeFromRecord(\n    84\t  resultByCallId: Map<string, boolean>,\n    85\t  callId: unknown,\n    86\t): ToolOutcome {\n    87\t  if (typeof callId !== \"string\") return \"unknown\";\n    88\t  const isError = resultByCallId.get(callId);\n    89\t  if (isError === undefined) return \"unknown\";\n    90\t  return isError ? \"failed\" : \"succeeded\";\n    91\t}\n    92\t\n    93\tinterface PartPlan {\n    94\t  form?: FormKind; // the message-level form this kind composes from, if any\n    95\t  fallbackText: (message: ComposeMessage) => string;\n    96\t}\n    97\t\n    98\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n    99\t// call/result → deterministic truncation; text/thinking/note → raw, no form\n   100\t// to fall back from and therefore never a gap.\n   101\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n   102\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n   103\t  assistant_text: { fallbackText: textOf },\n   104\t  assistant_thinking: { fallbackText: textOf },\n   105\t  runtime_note: { fallbackText: textOf },\n   106\t  tool_call: {\n   107\t    form: \"tool_call_summary\",\n   108\t    fallbackText: (message) => {\n   109\t      const block = message.blocks[0]?.content ?? {};\n   110\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n   111\t      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n   112\t    },\n   113\t  },\n   114\t  tool_result: {\n   115\t    form: \"tool_result_summary\",\n   116\t    fallbackText: (message) => {\n   117\t      const block = message.blocks[0]?.content ?? {};\n   118\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n   119\t    },\n   120\t  },\n   121\t};\n   122\t\n   123\t// Ready forms verbatim; non-ready (pending | failed | blocked) fall back with\n   124\t// one gap recorded per fallback naming the source record and the missing\n   125\t// form (AC-3.2). Gaps are facts about this composition — the caller lands\n   126\t// them on the rendering and they stay put until an explicit rebuild\n   127\t// recomposes from current states (AC-3.3).\n   128\texport function composeRenderingInput(\n   129\t  messages: readonly ComposeMessage[],\n   130\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   131\t): CompositionInput {\n   132\t  const parts: RenderingPart[] = [];\n   133\t  const gaps: DependencyGap[] = [];\n   134\t  const receipts: ToolRunReceipt[] = [];\n   135\t  const resultByCallId = recordOutcomes(messages);\n   136\t\n   137\t  for (const message of messages) {\n   138\t    const plan = PART_PLANS[message.kind];\n   139\t    const form = plan.form === undefined ? undefined : forms.get(composeFormKey(message.messageId, plan.form));\n   140\t    const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n   141\t\n   142\t    const part: RenderingPart = {\n   143\t      messageId: message.messageId,\n   144\t      kind: message.kind,\n   145\t      text: ready ? (form.content as string) : plan.fallbackText(message),\n   146\t      fallback: plan.form !== undefined && !ready,\n   147\t    };\n   148\t    if (message.kind === \"tool_call\") {\n   149\t      const callId = message.blocks[0]?.content[\"toolCallId\"];\n   150\t      part.outcome =\n   151\t        ready && form.metadata?.outcome !== undefined\n   152\t          ? form.metadata.outcome\n   153\t          : outcomeFromRecord(resultByCallId, callId);\n   154\t    } else if (message.kind === \"tool_result\") {\n   155\t      const block = message.blocks[0]?.content ?? {};\n   156\t      part.outcome =\n   157\t        ready && form.metadata?.outcome !== undefined\n   158\t          ? form.metadata.outcome\n   159\t          : block[\"isError\"] === true\n   160\t            ? \"failed\"\n   161\t            : \"succeeded\";\n   162\t    }\n   163\t    parts.push(part);\n   164\t    if (part.fallback && plan.form !== undefined) {\n   165\t      gaps.push({ subjectKind: \"message\", subjectId: message.messageId, form: plan.form });\n   166\t    }\n   167\t    if (message.kind === \"tool_call\" || message.kind === \"tool_result\") {\n   168\t      receipts.push({\n   169\t        messageId: message.messageId,\n   170\t        activity: message.kind,\n   171\t        account: part.text,\n   172\t        outcome: part.outcome ?? \"unknown\",\n   173\t      });\n   174\t    }\n   175\t  }\n   176\t\n   177\t  return { parts, gaps, receipts };\n   178\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,230p'\"","aggregated_output":"     1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\t\n     8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n     9\t\n    10\texport type FormKind =\n    11\t  | \"smoothed_prompt\"\n    12\t  | \"tool_call_summary\"\n    13\t  | \"tool_result_summary\"\n    14\t  | \"turn_rendering\"\n    15\t  | \"lower_band_projection\"\n    16\t  | \"chunk_summary_detailed\"\n    17\t  | \"chunk_summary_brief\";\n    18\t\n    19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    20\t\n    21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    22\t// (isError/presence), never authored by the provider (AC-2.4).\n    23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    24\t\n    25\t// A composed form's record of a dependency that fell back during composition:\n    26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n    27\texport interface DependencyGap {\n    28\t  subjectKind: SubjectKind;\n    29\t  subjectId: string;\n    30\t  form: FormKind;\n    31\t}\n    32\t\n    33\t// The read shape for one derived form's state row (DD-2, DD-3).\n    34\texport interface DerivedForm {\n    35\t  subjectKind: SubjectKind;\n    36\t  subjectId: string;\n    37\t  form: FormKind;\n    38\t  state: DerivedFormState;\n    39\t  content?: string; // ready only\n    40\t  reason?: string; // failed | blocked\n    41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n    42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n    43\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n    44\t  derivedAt?: string;\n    45\t}\n    46\t\n    47\t// One tool call's or result's receipt within a turn's composed account\n    48\t// (AC-3.8): the account text — what changed, as composed — plus the\n    49\t// mechanically derived outcome. Derived from the composition input, never\n    50\t// from provider prose; stamped on the turn_rendering form so the chunk\n    51\t// summaries can read receipts machine-readably in turn order.\n    52\texport interface ToolRunReceipt {\n    53\t  messageId: string;\n    54\t  activity: \"tool_call\" | \"tool_result\";\n    55\t  account: string;\n    56\t  outcome: ToolOutcome;\n    57\t}\n    58\t\n    59\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n    60\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n    61\t// final attempts/last-error copied from the work item before its row is\n    62\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n    63\t// lives here).\n    64\texport interface DerivedFormMetadata {\n    65\t  outcome?: ToolOutcome;\n    66\t  receipts?: ToolRunReceipt[];\n    67\t  attempts?: number;\n    68\t  lastError?: string;\n    69\t}\n    70\t\n    71\t// ── provider seam (DD-7) ─────────────────────────────────────────\n    72\t// Every operation returns content or a structured failure carrying\n    73\t// retryable-or-not; classification is the adapter's duty.\n    74\texport type ProviderResult =\n    75\t  | { ok: true; text: string }\n    76\t  | { ok: false; retryable: boolean; reason: string };\n    77\t\n    78\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n    79\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n    80\t// rather than imported: shared/ may not import domains/.\n    81\texport type RenderingPartKind =\n    82\t  | \"user_prompt\"\n    83\t  | \"assistant_text\"\n    84\t  | \"assistant_thinking\"\n    85\t  | \"runtime_note\"\n    86\t  | \"tool_call\"\n    87\t  | \"tool_result\";\n    88\t\n    89\texport interface RenderingPart {\n    90\t  messageId: string;\n    91\t  kind: RenderingPartKind;\n    92\t  text: string; // ready form content, or raw/truncated fallback\n    93\t  fallback: boolean; // true ⇒ gap recorded\n    94\t  outcome?: ToolOutcome; // tool activity only\n    95\t}\n    96\t\n    97\texport interface DerivationProvider {\n    98\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n    99\t  summarizeToolCall(i: {\n   100\t    toolName: string;\n   101\t    argsJson: string;\n   102\t    pairedResult?: { content: string; isError: boolean };\n   103\t  }): Promise<ProviderResult>;\n   104\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n   105\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n   106\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n   107\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n   108\t  // the members' tool-run receipts (what changed, outcome) alongside the\n   109\t  // projections; brief receives outcomes only — receipt text is stripped\n   110\t  // before the provider is called, so brief structurally cannot leak it.\n   111\t  // The receipt fields are optional in the type for callers without member\n   112\t  // context (the production chunk handlers always pass them).\n   113\t  summarizeChunkDetailed(i: {\n   114\t    memberProjections: string[];\n   115\t    memberReceipts?: ToolRunReceipt[][];\n   116\t  }): Promise<ProviderResult>;\n   117\t  summarizeChunkBrief(i: {\n   118\t    memberProjections: string[];\n   119\t    memberOutcomes?: ToolOutcome[][];\n   120\t  }): Promise<ProviderResult>;\n   121\t}\n   122\t\n   123\texport const PROVIDER_OPERATIONS = [\n   124\t  \"smoothPrompt\",\n   125\t  \"summarizeToolCall\",\n   126\t  \"summarizeToolResult\",\n   127\t  \"composeTurnRendering\",\n   128\t  \"projectLowerBand\",\n   129\t  \"summarizeChunkDetailed\",\n   130\t  \"summarizeChunkBrief\",\n   131\t] as const;\n   132\t\n   133\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n   134\t\n   135\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n   136\texport interface SdkConfig {\n   137\t  provider: DerivationProvider;\n   138\t  mode: \"background\" | \"manual\";\n   139\t  clock?: () => Date;\n   140\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n   141\t  lease?: { durationMs: number }; // 120000\n   142\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n   143\t}\n   144\t\n   145\t// Every optional filled by createSdk's central defaults.\n   146\texport interface ResolvedSdkConfig {\n   147\t  provider: DerivationProvider;\n   148\t  mode: \"background\" | \"manual\";\n   149\t  clock: () => Date;\n   150\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n   151\t  lease: { durationMs: number };\n   152\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n   153\t}\n   154\t\n   155\t// ── handler contract (DD-6; the map's value type) ────────────────\n   156\texport interface HandlerRunContext {\n   157\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n   158\t  provider: DerivationProvider;\n   159\t  clock: () => Date;\n   160\t  config: ResolvedSdkConfig;\n   161\t}\n   162\t\n   163\t// A successful handler hands its derived-form content back as data; the\n   164\t// drain's completion transaction performs the version-checked UPDATE and the\n   165\t// item-row deletion atomically (tech design §Mechanics: completion is one\n   166\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n   167\t// never opens that transaction itself, so the version check and the\n   168\t// done/stale_discarded disposition stay in one place — the queue util.\n   169\texport interface HandlerFormWrite {\n   170\t  subjectKind: SubjectKind;\n   171\t  subjectId: string;\n   172\t  form: FormKind;\n   173\t  content: string;\n   174\t  metadata?: DerivedFormMetadata;\n   175\t  gaps?: DependencyGap[];\n   176\t}\n   177\t\n   178\t// The completion-transaction hook (Story 3): work that must land atomically\n   179\t// with the version-checked form writes — chunk placement and the\n   180\t// close→summary enqueues above all. The queue util invokes it inside the\n   181\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n   182\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n   183\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n   184\t// crash leaves either a placed turn with its enqueues or nothing — never a\n   185\t// derived-but-unplaced turn.\n   186\texport interface CompletionTx {\n   187\t  db: DatabaseSync;\n   188\t  onCommit: (fn: () => void) => void;\n   189\t}\n   190\t\n   191\texport type HandlerOutcome =\n   192\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n   193\t  | { ok: false; retryable: boolean; reason: string }\n   194\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n   195\t\n   196\t// item is the queue util's WorkItemRecord; typed structurally here so the\n   197\t// shared layer does not depend on the util's module (and vice versa stays\n   198\t// one-directional: tech-utils imports shared).\n   199\texport type WorkHandler = (\n   200\t  run: HandlerRunContext,\n   201\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n   202\t) => Promise<HandlerOutcome>;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,220p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n     2\t// source turn, the member messages it composes (deleted-filtered — the\n     3\t// shared read-filter rule lives here, once for this domain), the\n     4\t// message-level form rows composition consumes, and the member projections\n     5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n     6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n     7\t// — no write path here.\n     8\timport type { DatabaseSync } from \"node:sqlite\";\n     9\timport type { RenderingPartKind, ToolRunReceipt } from \"../../../shared/derivation.js\";\n    10\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n    11\timport { composeFormKey } from \"./compose.js\";\n    12\timport type { FormKind } from \"../../../shared/derivation.js\";\n    13\t\n    14\texport interface TurnSource {\n    15\t  turnId: string;\n    16\t  status: \"open\" | \"closed\";\n    17\t  deleted: boolean;\n    18\t}\n    19\t\n    20\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n    21\t  const row = db\n    22\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    23\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n    24\t  if (row === undefined) return undefined;\n    25\t  return {\n    26\t    turnId,\n    27\t    status: row.status as TurnSource[\"status\"],\n    28\t    deleted: row.deleted_at !== null,\n    29\t  };\n    30\t}\n    31\t\n    32\t// Member messages in message order, blocks attached, deleted messages\n    33\t// filtered (tech design §Mechanics: composition's member enumeration reads\n    34\t// the live projection only).\n    35\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n    36\t  const messages = db\n    37\t    .prepare(\n    38\t      `SELECT message_id, kind FROM message\n    39\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    40\t    )\n    41\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n    42\t  const blockStmt = db.prepare(\n    43\t    `SELECT block_type, content FROM message_block\n    44\t     WHERE message_id = ? ORDER BY block_index`,\n    45\t  );\n    46\t  return messages.map((message) => {\n    47\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n    48\t      block_type: string;\n    49\t      content: string;\n    50\t    }>;\n    51\t    return {\n    52\t      messageId: message.message_id,\n    53\t      kind: message.kind as RenderingPartKind,\n    54\t      blocks: blocks.map((block) => ({\n    55\t        blockType: block.block_type,\n    56\t        content: JSON.parse(block.content) as Record<string, unknown>,\n    57\t      })),\n    58\t    };\n    59\t  });\n    60\t}\n    61\t\n    62\t// The message-owned form rows for a set of member messages, keyed for\n    63\t// composition. A cross-owner *read* by design: composition consumes message\n    64\t// forms; only message handlers ever write them (DD-2 ownership is a write\n    65\t// rule).\n    66\texport function readMessageFormRows(\n    67\t  db: DatabaseSync,\n    68\t  messageIds: readonly string[],\n    69\t): Map<string, ComposeFormRow> {\n    70\t  const rows = new Map<string, ComposeFormRow>();\n    71\t  if (messageIds.length === 0) return rows;\n    72\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n    73\t  const raw = db\n    74\t    .prepare(\n    75\t      `SELECT subject_id, form, state, content, metadata FROM derived_form\n    76\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    77\t    )\n    78\t    .all(...messageIds) as unknown as Array<{\n    79\t    subject_id: string;\n    80\t    form: string;\n    81\t    state: string;\n    82\t    content: string | null;\n    83\t    metadata: string | null;\n    84\t  }>;\n    85\t  for (const row of raw) {\n    86\t    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n    87\t    if (row.content !== null) view.content = row.content;\n    88\t    if (row.metadata !== null) {\n    89\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n    90\t    }\n    91\t    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n    92\t  }\n    93\t  return rows;\n    94\t}\n    95\t\n    96\t// Member projections in turn order for the chunk summaries: member rows by\n    97\t// member_idx, deleted turns filtered, each joined to its stored\n    98\t// lower_band_projection row (state + content as landed — never re-derived)\n    99\t// and to its turn_rendering's mechanically stamped tool-run receipts\n   100\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\n   101\texport interface MemberProjection {\n   102\t  turnId: string;\n   103\t  state?: string; // undefined: no projection row exists for the member\n   104\t  content?: string;\n   105\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n   106\t}\n   107\t\n   108\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n   109\t  const rows = db\n   110\t    .prepare(\n   111\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n   112\t       FROM chunk_member cm\n   113\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   114\t       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n   115\t         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n   116\t       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\n   117\t         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\n   118\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   119\t    )\n   120\t    .all(chunkId) as unknown as Array<{\n   121\t    turn_id: string;\n   122\t    state: string | null;\n   123\t    content: string | null;\n   124\t    rendering_metadata: string | null;\n   125\t  }>;\n   126\t  return rows.map((row) => {\n   127\t    const metadata =\n   128\t      row.rendering_metadata === null\n   129\t        ? undefined\n   130\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n   131\t    const projection: MemberProjection = {\n   132\t      turnId: row.turn_id,\n   133\t      receipts: metadata?.receipts ?? [],\n   134\t    };\n   135\t    if (row.state !== null) projection.state = row.state;\n   136\t    if (row.content !== null) projection.content = row.content;\n   137\t    return projection;\n   138\t  });\n   139\t}\n   140\t\n   141\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n   142\t  return (\n   143\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n   144\t  );\n   145\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/storage.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface Migration {\n     4\t  version: number; // 1-based, strictly increasing\n     5\t  statements: readonly string[];\n     6\t}\n     7\t\n     8\texport function openDatabase(path: string): DatabaseSync {\n     9\t  const db = new DatabaseSync(path);\n    10\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n    11\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n    12\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n    13\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n    14\t  return db;\n    15\t}\n    16\t\n    17\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\n    18\t// on the existing work_item table, the derived_form state table, the chunk\n    19\t// tables, and the projection-level delete stamps. The whole epic's schema\n    20\t// lands in one version — behavior arrives story by story. Assembled into the\n    21\t// thread-file migration history by threads/internal/create.ts.\n    22\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n    23\t  // claim mechanics on the existing table (DD-1: no disposition column —\n    24\t  // queue rows are live work only; terminal rows are deleted and their\n    25\t  // outcomes reported in-memory; durable outcome state lives on derived_form)\n    26\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n    27\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n    28\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n    29\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n    30\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n    31\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n    32\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n    33\t  // inside an index definition, so the index covers the two real columns and\n    34\t  // claimNext's ORDER BY rowid walks the head as before.\n    35\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n    36\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n    37\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\n    38\t  // call id — never a block scan (anti-shim requirement).\n    39\t  `CREATE INDEX idx_message_block_tool_call_id\n    40\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n    41\t  `CREATE TABLE derived_form (\n    42\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    43\t    subject_id   TEXT NOT NULL,\n    44\t    form         TEXT NOT NULL,\n    45\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    46\t    content      TEXT,\n    47\t    reason       TEXT,\n    48\t    metadata     TEXT,\n    49\t    source_version INTEGER NOT NULL DEFAULT 1,\n    50\t    gaps         TEXT,\n    51\t    derived_at   TEXT,\n    52\t    PRIMARY KEY (subject_kind, subject_id, form)\n    53\t  );`,\n    54\t  `CREATE TABLE chunk (\n    55\t    chunk_id     TEXT PRIMARY KEY,\n    56\t    chunk_order  INTEGER NOT NULL UNIQUE,\n    57\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    58\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n    59\t  );`,\n    60\t  `CREATE TABLE chunk_member (\n    61\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    62\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    63\t    member_idx INTEGER NOT NULL,\n    64\t    PRIMARY KEY (chunk_id, member_idx)\n    65\t  );`,\n    66\t  // projection-level delete (the record keeps everything; reads filter)\n    67\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n    68\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n    69\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\n    70\t  // UPDATE-only completion finds them (row missing must mean deleted).\n    71\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    72\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n    73\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n    74\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    75\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n    76\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n    77\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    78\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n    79\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    80\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    81\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n    82\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    83\t];\n    84\t\n    85\texport function getSchemaVersion(db: DatabaseSync): number {\n    86\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n    87\t    | { user_version: number | bigint }\n    88\t    | undefined;\n    89\t  return Number(row?.user_version ?? 0);\n    90\t}\n    91\t\n    92\texport function runMigrations(\n    93\t  db: DatabaseSync,\n    94\t  migrations: readonly Migration[],\n    95\t): void {\n    96\t  let current = getSchemaVersion(db);\n    97\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n    98\t  for (const migration of ordered) {\n    99\t    if (migration.version <= current) continue;\n   100\t    db.exec(\"BEGIN IMMEDIATE;\");\n   101\t    try {\n   102\t      for (const statement of migration.statements) db.exec(statement);\n   103\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n   104\t      db.exec(\"COMMIT;\");\n   105\t    } catch (cause) {\n   106\t      db.exec(\"ROLLBACK;\");\n   107\t      throw cause;\n   108\t    }\n   109\t    current = migration.version;\n   110\t  }\n   111\t}\n","exit_code":0,"status":"completed"}}

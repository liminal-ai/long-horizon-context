{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '380,560p'\"","aggregated_output":"   380\t    throw cause;\n   381\t  }\n   382\t}\n   383\t\n   384\t// A failed run counts itself. Under budget and retryable: the row goes back\n   385\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n   386\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n   387\t// on a non-retryable failure, the item is terminal: form `failed` with the\n   388\t// final reason, row deleted (AC-1.9).\n   389\texport function failAttempt(\n   390\t  db: DatabaseSync,\n   391\t  item: ClaimedWorkItem,\n   392\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n   393\t): FailAttemptResult {\n   394\t  const attempts = item.attempts + 1;\n   395\t  if (opts.retryable && attempts < opts.retry.budget) {\n   396\t    const backoffMs = Math.min(\n   397\t      opts.retry.backoffBaseMs * 2 ** attempts,\n   398\t      opts.retry.backoffCapMs,\n   399\t    );\n   400\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n   401\t    db.exec(\"BEGIN IMMEDIATE;\");\n   402\t    try {\n   403\t      db.prepare(\n   404\t        `UPDATE work_item\n   405\t         SET status = 'queued', attempts = ?, last_error = ?,\n   406\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n   407\t         WHERE work_item_id = ?`,\n   408\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n   409\t      db.exec(\"COMMIT;\");\n   410\t    } catch (cause) {\n   411\t      db.exec(\"ROLLBACK;\");\n   412\t      throw cause;\n   413\t    }\n   414\t    return { terminal: false, attempts, eligibleAt };\n   415\t  }\n   416\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n   417\t  return { terminal: true, attempts };\n   418\t}\n   419\t\n   420\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n   421\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n   422\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n   423\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n   424\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n   425\t// discards their stale completions. Ships here as mechanics; its only caller\n   426\t// is Story 5's cascade.\n   427\texport function supersedeQueued(\n   428\t  db: DatabaseSync,\n   429\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n   430\t): string[] {\n   431\t  const ids: string[] = [];\n   432\t  const remove = db.prepare(\n   433\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n   434\t     RETURNING work_item_id`,\n   435\t  );\n   436\t  for (const target of targets) {\n   437\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n   438\t      work_item_id: string;\n   439\t    }>;\n   440\t    for (const row of rows) ids.push(row.work_item_id);\n   441\t  }\n   442\t  return ids;\n   443\t}\n   444\t\n   445\t// Live items left in the queue — the drain report's `remaining` and the\n   446\t// repair report's join source (Story 4).\n   447\texport function countLiveItems(db: DatabaseSync): number {\n   448\t  const row = db\n   449\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n   450\t    .get() as unknown as { n: number | bigint };\n   451\t  return Number(row.n);\n   452\t}\n   453\t\n   454\texport interface QueueDetailRow {\n   455\t  workItemId: string;\n   456\t  owner: WorkOwner;\n   457\t  kind: string;\n   458\t  sourceRef: WorkSourceRef;\n   459\t  status: \"queued\" | \"claimed\";\n   460\t  attempts: number;\n   461\t  lastError?: string;\n   462\t  eligibleAt?: string;\n   463\t  claimedAt?: string;\n   464\t  claimExpiresAt?: string;\n   465\t  queuedAt: string;\n   466\t  sourceVersion: number;\n   467\t}\n   468\t\n   469\t// Mechanical detail of every live row in queue order — what the repair\n   470\t// report joins against derived_form (Flow 4) and what tests read to assert\n   471\t// lease/backoff state without raw SQL at every call site.\n   472\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n   473\t  const rows = db\n   474\t    .prepare(\n   475\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n   476\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n   477\t       FROM work_item ORDER BY rowid`,\n   478\t    )\n   479\t    .all() as unknown as Array<\n   480\t    RawClaimRow & {\n   481\t      status: string;\n   482\t      last_error: string | null;\n   483\t      eligible_at: string | null;\n   484\t      claimed_at: string | null;\n   485\t      claim_expires_at: string | null;\n   486\t    }\n   487\t  >;\n   488\t  return rows.map((row) => {\n   489\t    const item = toClaimedItem(row);\n   490\t    const detail: QueueDetailRow = {\n   491\t      workItemId: item.workItemId,\n   492\t      owner: item.owner,\n   493\t      kind: item.kind,\n   494\t      sourceRef: item.sourceRef,\n   495\t      status: row.status as \"queued\" | \"claimed\",\n   496\t      attempts: item.attempts,\n   497\t      queuedAt: item.queuedAt,\n   498\t      sourceVersion: item.sourceVersion,\n   499\t    };\n   500\t    if (row.last_error !== null) detail.lastError = row.last_error;\n   501\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n   502\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n   503\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n   504\t    return detail;\n   505\t  });\n   506\t}\n   507\t\n   508\t// Listing in queue order (insertion order within the walk); each owning\n   509\t// domain lists only its own items.\n   510\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n   511\t  const rows = db\n   512\t    .prepare(\n   513\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n   514\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n   515\t    )\n   516\t    .all(owner) as unknown as RawWorkItemRow[];\n   517\t  return rows.map((row) => ({\n   518\t    workItemId: row.work_item_id,\n   519\t    owner: row.owner as WorkOwner,\n   520\t    kind: row.kind as WorkKind,\n   521\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n   522\t    status: \"queued\",\n   523\t    queuedAt: row.queued_at,\n   524\t  }));\n   525\t}\n","exit_code":0,"status":"completed"}}

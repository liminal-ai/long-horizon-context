{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '1,180p'\"","aggregated_output":"     1\texport * as threads from \"./domains/threads/index.js\";\n     2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n     3\texport * as messages from \"./domains/messages/index.js\";\n     4\texport * as turns from \"./domains/turns/index.js\";\n     5\t\n     6\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n     7\timport * as messagesDomain from \"./domains/messages/index.js\";\n     8\timport * as threadsDomain from \"./domains/threads/index.js\";\n     9\timport * as turnsDomain from \"./domains/turns/index.js\";\n    10\timport {\n    11\t  createScheduler,\n    12\t  peekThreadId,\n    13\t  runDrain,\n    14\t  type DrainDeps,\n    15\t  type DrainReport,\n    16\t  type Scheduler,\n    17\t} from \"./scheduler.js\";\n    18\timport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\n    19\timport {\n    20\t  PROVIDER_OPERATIONS,\n    21\t  type ResolvedSdkConfig,\n    22\t  type SdkConfig,\n    23\t  type WorkHandler,\n    24\t} from \"./shared/derivation.js\";\n    25\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n    26\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n    27\t\n    28\texport {\n    29\t  estimateTokens,\n    30\t  TOKEN_ESTIMATOR_ID,\n    31\t} from \"./tech-utils/token-counting/index.js\";\n    32\t\n    33\texport {\n    34\t  WORK_KIND_REGISTRY,\n    35\t  type WorkItemRecord,\n    36\t  type WorkKind,\n    37\t  type WorkOwner,\n    38\t  type WorkSourceRef,\n    39\t} from \"./tech-utils/work-queue/index.js\";\n    40\t\n    41\texport type {\n    42\t  ErrorClass,\n    43\t  ErrorCode,\n    44\t  ErrorResult,\n    45\t  OpResult,\n    46\t} from \"./shared/errors.js\";\n    47\texport {\n    48\t  runInTransaction,\n    49\t  setSchedulerPoke,\n    50\t  setThreadTouch,\n    51\t  type OperationContext,\n    52\t} from \"./shared/context.js\";\n    53\t\n    54\texport {\n    55\t  createDeterministicProvider,\n    56\t  deterministicText,\n    57\t  type DeterministicOpName,\n    58\t} from \"./providers/deterministic.js\";\n    59\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n    60\t\n    61\texport type {\n    62\t  CompletionTx,\n    63\t  DependencyGap,\n    64\t  DerivationProvider,\n    65\t  DerivedForm,\n    66\t  DerivedFormMetadata,\n    67\t  DerivedFormState,\n    68\t  FormKind,\n    69\t  HandlerFormWrite,\n    70\t  HandlerOutcome,\n    71\t  HandlerRunContext,\n    72\t  ProviderResult,\n    73\t  RenderingPart,\n    74\t  ResolvedSdkConfig,\n    75\t  SdkConfig,\n    76\t  SubjectKind,\n    77\t  ToolOutcome,\n    78\t  WorkHandler,\n    79\t} from \"./shared/derivation.js\";\n    80\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n    81\texport {\n    82\t  countLiveItems,\n    83\t  enqueue,\n    84\t  queueDetail,\n    85\t  supersedeQueued,\n    86\t  type ClaimedWorkItem,\n    87\t  type EnqueueFormTarget,\n    88\t  type EnqueueInput,\n    89\t  type QueueDetailRow,\n    90\t} from \"./tech-utils/work-queue/index.js\";\n    91\t\n    92\texport type { ThreadRef } from \"./domains/threads/index.js\";\n    93\texport type {\n    94\t  Block,\n    95\t  BlockType,\n    96\t  MessageRecord,\n    97\t} from \"./domains/messages/index.js\";\n    98\texport type { TurnRecord } from \"./domains/turns/index.js\";\n    99\texport type {\n   100\t  BatchResult,\n   101\t  EventKind,\n   102\t  EventRecord,\n   103\t  MessageEventInput,\n   104\t} from \"./domains/intake-stream/index.js\";\n   105\t\n   106\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   107\t\n   108\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   109\t\n   110\t// Merge per-domain handler tables into the one join between the queue's\n   111\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   112\t// (each kind has exactly one owner) and throws at construction.\n   113\texport function assembleWorkHandlerMap(\n   114\t  tables: ReadonlyArray<WorkHandlerMap>,\n   115\t): WorkHandlerMap {\n   116\t  const map: WorkHandlerMap = {};\n   117\t  for (const table of tables) {\n   118\t    for (const [kind, handler] of Object.entries(table)) {\n   119\t      if (map[kind as WorkKind] !== undefined) {\n   120\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   121\t      }\n   122\t      map[kind as WorkKind] = handler;\n   123\t    }\n   124\t  }\n   125\t  return map;\n   126\t}\n   127\t\n   128\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   129\t  return {\n   130\t    ok: false,\n   131\t    error: {\n   132\t      errorClass: \"state_corruption\",\n   133\t      code: \"unknown_work_kind\",\n   134\t      reason: `no handler registered for work kind \"${kind}\"`,\n   135\t    },\n   136\t  };\n   137\t}\n   138\t\n   139\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   140\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   141\texport function lookupWorkHandler(\n   142\t  map: WorkHandlerMap,\n   143\t  kind: string,\n   144\t): OpResult<WorkHandler> {\n   145\t  const handler = map[kind as WorkKind];\n   146\t  if (handler === undefined) return unknownWorkKind(kind);\n   147\t  return { ok: true, value: handler };\n   148\t}\n   149\t\n   150\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   151\t// requeue land in Story 4.\n   152\texport interface WorkSurface {\n   153\t  drain(\n   154\t    ref: threadsDomain.ThreadRef,\n   155\t    opts?: { maxItems?: number },\n   156\t  ): Promise<OpResult<DrainReport>>;\n   157\t}\n   158\t\n   159\texport interface Lhc {\n   160\t  threads: typeof threadsDomain;\n   161\t  intakeStream: typeof intakeStreamDomain;\n   162\t  messages: typeof messagesDomain;\n   163\t  turns: typeof turnsDomain;\n   164\t  config: ResolvedSdkConfig;\n   165\t  scheduler: Scheduler;\n   166\t  workHandlers: WorkHandlerMap;\n   167\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   168\t  work: WorkSurface;\n   169\t  // Resolves when the scheduler has no running or pending drain for the\n   170\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   171\t  // resolve in manual mode.\n   172\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   173\t}\n   174\t\n   175\tfunction requirePositive(value: number, name: string): void {\n   176\t  if (!Number.isFinite(value) || value <= 0) {\n   177\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   178\t  }\n   179\t}\n   180\t\n","exit_code":0,"status":"completed"}}

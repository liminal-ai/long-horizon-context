{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n     2\t// wrapper that makes \"queueing is what schedules processing\" structural\n     3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n     4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n     5\t// a turn or a summary is; which kinds queue for which sources, and which\n     6\t// derived forms a kind produces, is the owning domains' business (callers\n     7\t// pass the form targets in). Writes run on the caller's handle inside the\n     8\t// ambient transaction, so items commit (or roll back) with the batch. No\n     9\t// public SDK surface: read-back reaches here only through the owning\n    10\t// domains' listQueuedWork.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport {\n    13\t  createCommitHooks,\n    14\t  fireSchedulerPoke,\n    15\t  type OperationContext,\n    16\t} from \"../../shared/context.js\";\n    17\timport type {\n    18\t  CompletionTx,\n    19\t  FormKind,\n    20\t  HandlerFormWrite,\n    21\t  SubjectKind,\n    22\t} from \"../../shared/derivation.js\";\n    23\t\n    24\texport type WorkOwner = \"messages\" | \"turns\";\n    25\texport type WorkKind =\n    26\t  | \"prompt_smoothing\"\n    27\t  | \"tool_call_summary\"\n    28\t  | \"tool_result_summary\"\n    29\t  | \"turn_derivation\"\n    30\t  | \"chunk_summary_detailed\"\n    31\t  | \"chunk_summary_brief\";\n    32\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n    33\t\n    34\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n    35\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n    36\t// the owning domain's handler (registered at SDK construction, DD-6).\n    37\texport const WORK_KIND_REGISTRY: Readonly<\n    38\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n    39\t> = {\n    40\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    41\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    42\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    43\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n    44\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    45\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    46\t};\n    47\t\n    48\texport interface WorkItemRecord {\n    49\t  workItemId: string;\n    50\t  owner: WorkOwner;\n    51\t  kind: WorkKind;\n    52\t  sourceRef: WorkSourceRef;\n    53\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n    54\t  queuedAt: string;\n    55\t}\n    56\t\n    57\t// The derived forms an enqueue is scheduling work toward; the owning domain\n    58\t// names them (the util stays meaning-blind). Stored in the row's payload so\n    59\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n    60\t// form's failed/blocked state without asking any domain what a kind means.\n    61\texport interface EnqueueFormTarget {\n    62\t  subjectKind: SubjectKind;\n    63\t  subjectId: string;\n    64\t  form: FormKind;\n    65\t}\n    66\t\n    67\texport interface WorkItemInput {\n    68\t  owner: WorkOwner;\n    69\t  kind: WorkKind;\n    70\t  sourceRef: WorkSourceRef;\n    71\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n    72\t  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n    73\t}\n    74\t\n    75\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n    76\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n    77\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n    78\t  return sourceRef.chunkId;\n    79\t}\n    80\t\n    81\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n    82\t// same kind for the same source *at the same version* is the same id —\n    83\t// natural idempotency for the repair path — while a post-mutation\n    84\t// replacement (next version) never collides with an in-flight pre-mutation\n    85\t// item.\n    86\texport function recordItem(\n    87\t  db: DatabaseSync,\n    88\t  input: WorkItemInput,\n    89\t  queuedAt: string,\n    90\t): WorkItemRecord {\n    91\t  const sourceVersion = input.sourceVersion ?? 1;\n    92\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n    93\t  db.prepare(\n    94\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n    95\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n    96\t  ).run(\n    97\t    workItemId,\n    98\t    input.owner,\n    99\t    input.kind,\n   100\t    JSON.stringify(input.sourceRef),\n   101\t    queuedAt,\n   102\t    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n   103\t  );\n   104\t  return {\n   105\t    workItemId,\n   106\t    owner: input.owner,\n   107\t    kind: input.kind,\n   108\t    sourceRef: input.sourceRef,\n   109\t    status: \"queued\",\n   110\t    queuedAt,\n   111\t  };\n   112\t}\n   113\t\n   114\texport interface EnqueueInput extends WorkItemInput {\n   115\t  forms: readonly EnqueueFormTarget[];\n   116\t}\n   117\t\n   118\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n   119\t// state row, and the scheduler poke all ride the ambient transaction — they\n   120\t// commit together or vanish together. Enqueue is the *only* place a\n   121\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n   122\t// resets an existing row to pending at the enqueued source version.\n   123\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n   124\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n   125\t  const sourceVersion = input.sourceVersion ?? 1;\n   126\t  const upsert = ctx.db.prepare(\n   127\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n   128\t     VALUES (?, ?, ?, 'pending', ?)\n   129\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n   130\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n   131\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n   132\t  );\n   133\t  for (const target of input.forms) {\n   134\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n   135\t  }\n   136\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n   137\t  return item;\n   138\t}\n   139\t\n   140\tinterface RawWorkItemRow {\n   141\t  work_item_id: string;\n   142\t  owner: string;\n   143\t  kind: string;\n   144\t  source_ref: string;\n   145\t  queued_at: string;\n   146\t}\n   147\t\n   148\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n   149\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n   150\t// complete, and the terminal half of failAttempt each own one short\n   151\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n   152\t\n   153\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n   154\t// source version and form targets. `kind` is a plain string here — a raw row\n   155\t// with an unregistered kind must still be claimable so the drain can land it\n   156\t// failed_terminal instead of skipping it (AC-1.8).\n   157\texport interface ClaimedWorkItem {\n   158\t  workItemId: string;\n   159\t  owner: WorkOwner;\n   160\t  kind: string;\n   161\t  sourceRef: WorkSourceRef;\n   162\t  attempts: number;\n   163\t  queuedAt: string;\n   164\t  sourceVersion: number;\n   165\t  forms: EnqueueFormTarget[];\n   166\t}\n   167\t\n   168\texport type ClaimOutcome =\n   169\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n   170\t  | { outcome: \"empty\" }\n   171\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n   172\t  | { outcome: \"waiting\"; waitingUntil: string };\n   173\t\n   174\tinterface RawClaimRow {\n   175\t  work_item_id: string;\n   176\t  owner: string;\n   177\t  kind: string;\n   178\t  source_ref: string;\n   179\t  attempts: number | bigint;\n   180\t  queued_at: string;\n","exit_code":0,"status":"completed"}}

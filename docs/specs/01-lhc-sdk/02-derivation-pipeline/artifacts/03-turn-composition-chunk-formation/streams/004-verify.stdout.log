{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/provider-double.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n     2\t// Injected at the same seam production adapters use — dependency injection,\n     3\t// not a mock of internals. Every operation returns marked, input-derived\n     4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n     5\t// functions of the input, so identical input to the same operation yields\n     6\t// identical output across double instances, and different operations are\n     7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n     8\t// captureInputs) is per-instance state and never leaks across tests that\n     9\t// construct their own double.\n    10\timport {\n    11\t  deterministicText,\n    12\t  type DerivationProvider,\n    13\t  type ProviderResult,\n    14\t  type RenderingPart,\n    15\t} from \"../../src/index.js\";\n    16\t\n    17\texport type ProviderOpName =\n    18\t  | \"smoothPrompt\"\n    19\t  | \"summarizeToolCall\"\n    20\t  | \"summarizeToolResult\"\n    21\t  | \"composeTurnRendering\"\n    22\t  | \"projectLowerBand\"\n    23\t  | \"summarizeChunkDetailed\"\n    24\t  | \"summarizeChunkBrief\";\n    25\t\n    26\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n    27\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n    28\t// as the operation names themselves.\n    29\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n    30\t  smoothPrompt: \"smoothPrompt\",\n    31\t  summarizeToolCall: \"summarizeToolCall\",\n    32\t  summarizeToolResult: \"summarizeToolResult\",\n    33\t  composeTurnRendering: \"composeTurnRendering\",\n    34\t  projectLowerBand: \"projectLowerBand\",\n    35\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n    36\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n    37\t  prompt_smoothing: \"smoothPrompt\",\n    38\t  smoothed_prompt: \"smoothPrompt\",\n    39\t  tool_call_summary: \"summarizeToolCall\",\n    40\t  tool_result_summary: \"summarizeToolResult\",\n    41\t  turn_rendering: \"composeTurnRendering\",\n    42\t  lower_band_projection: \"projectLowerBand\",\n    43\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n    44\t  chunk_summary_brief: \"summarizeChunkBrief\",\n    45\t};\n    46\t\n    47\tfunction resolveOpName(kind: string): ProviderOpName {\n    48\t  const op = KIND_ALIASES[kind];\n    49\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n    50\t  return op;\n    51\t}\n    52\t\n    53\tinterface FailScript {\n    54\t  remaining: number;\n    55\t  retryable: boolean;\n    56\t  reason: string;\n    57\t}\n    58\t\n    59\texport interface CapturedInput {\n    60\t  op: ProviderOpName;\n    61\t  input: unknown;\n    62\t}\n    63\t\n    64\texport class ProviderDouble implements DerivationProvider {\n    65\t  private failNextScript: FailScript | null = null;\n    66\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n    67\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n    68\t  private capturing = false;\n    69\t  private readonly captured: CapturedInput[] = [];\n    70\t\n    71\t  // Fail the next n calls to any operation, then succeed.\n    72\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    73\t    this.failNextScript = {\n    74\t      remaining: n,\n    75\t      retryable: opts?.retryable ?? true,\n    76\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    77\t    };\n    78\t  }\n    79\t\n    80\t  // Fail the next n calls to one operation (kind names and op names both\n    81\t  // accepted). retryable: false scripts a terminal failure.\n    82\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    83\t    const op = resolveOpName(kind);\n    84\t    this.failByOp.set(op, {\n    85\t      remaining: n,\n    86\t      retryable: opts?.retryable ?? true,\n    87\t      reason: opts?.reason ?? `scripted failure (${op})`,\n    88\t    });\n    89\t  }\n    90\t\n    91\t  delayKind(kind: string, ms: number): void {\n    92\t    this.delayByOp.set(resolveOpName(kind), ms);\n    93\t  }\n    94\t\n    95\t  // Start capturing inputs; returns the live log (appended in call order).\n    96\t  captureInputs(): readonly CapturedInput[] {\n    97\t    this.capturing = true;\n    98\t    return this.captured;\n    99\t  }\n   100\t\n   101\t  private async run(\n   102\t    op: ProviderOpName,\n   103\t    input: unknown,\n   104\t    text: string,\n   105\t  ): Promise<ProviderResult> {\n   106\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n   107\t    const delay = this.delayByOp.get(op);\n   108\t    if (delay !== undefined && delay > 0) {\n   109\t      await new Promise((resolve) => setTimeout(resolve, delay));\n   110\t    }\n   111\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n   112\t    for (const script of scripts) {\n   113\t      if (script !== null && script.remaining > 0) {\n   114\t        script.remaining -= 1;\n   115\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n   116\t      }\n   117\t    }\n   118\t    // Output format shared with src/providers/deterministic.ts so the double\n   119\t    // and the registry's \"deterministic\" provider produce byte-identical\n   120\t    // artifacts across in-process and spawned runs.\n   121\t    return { ok: true, text: deterministicText(op, input, text) };\n   122\t  }\n   123\t\n   124\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n   125\t    return this.run(\"smoothPrompt\", i, i.text);\n   126\t  }\n   127\t\n  
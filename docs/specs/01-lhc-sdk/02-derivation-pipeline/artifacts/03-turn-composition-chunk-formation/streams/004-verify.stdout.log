{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/context.ts | sed -n '1,220p'\"","aggregated_output":"     1\timport type { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface OperationContext {\n     4\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n     5\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n     6\t  threadId: string; // resolved identity of the thread being operated on\n     7\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n     8\t  // the registered callbacks after its COMMIT succeeds and drops them on\n     9\t  // rollback, so anything registered here — the scheduler poke above all —\n    10\t  // is transactional by construction.\n    11\t  onCommit: (fn: () => void) => void;\n    12\t}\n    13\t\n    14\t// The callback list behind ctx.onCommit, owned by whoever owns the\n    15\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n    16\t// dropping the hooks is simply not flushing them.\n    17\texport interface CommitHooks {\n    18\t  register: (fn: () => void) => void;\n    19\t  flush: () => void;\n    20\t}\n    21\t\n    22\texport function createCommitHooks(): CommitHooks {\n    23\t  const callbacks: Array<() => void> = [];\n    24\t  return {\n    25\t    register: (fn) => {\n    26\t      callbacks.push(fn);\n    27\t    },\n    28\t    flush: () => {\n    29\t      for (const fn of callbacks.splice(0)) fn();\n    30\t    },\n    31\t  };\n    32\t}\n    33\t\n    34\t// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n    35\t// util can fire it without importing the scheduler module (which will import\n    36\t// domain handler tables from Story 1 on — a util→scheduler import would\n    37\t// cycle). The scheduler installs itself here; in manual mode, or before any\n    38\t// scheduler exists, firing is a no-op — onCommit still fires either way.\n    39\ttype SchedulerPoke = (threadId: string) => void;\n    40\tlet schedulerPoke: SchedulerPoke | null = null;\n    41\t\n    42\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n    43\t  schedulerPoke = poke;\n    44\t}\n    45\t\n    46\texport function fireSchedulerPoke(threadId: string): void {\n    47\t  schedulerPoke?.(threadId);\n    48\t}\n    49\t\n    50\t// The thread-touch seam (DD-10). openThreadDatabase announces every open of a\n    51\t// thread file here, before any caller transaction begins. The background\n    52\t// scheduler installs a listener to learn threadId→filePath and to run the\n    53\t// first-touch catch-up check (one indexed query on the already-open handle);\n    54\t// with no listener installed — manual mode, or no SDK constructed — firing is\n    55\t// free. Lives in shared/ for the same reason as the poke slot: the threads\n    56\t// domain may not import the scheduler module.\n    57\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n    58\tlet threadTouch: ThreadTouch | null = null;\n    59\t\n    60\texport function setThreadTouch(touch: ThreadTouch | null): void {\n    61\t  threadTouch = touch;\n    62\t}\n    63\t\n    64\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n    65\t  threadTouch?.(filePath, db);\n    66\t}\n    67\t\n    68\t// Transaction owner for operations outside the intake pipeline (mutations,\n    69\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n    70\t// body with a context whose onCommit registrations flush only after COMMIT\n    71\t// succeeds and drop whole on rollback.\n    72\texport function runInTransaction<T>(\n    73\t  db: DatabaseSync,\n    74\t  clock: () => Date,\n    75\t  threadId: string,\n    76\t  fn: (ctx: OperationContext) => T,\n    77\t): T {\n    78\t  const hooks = createCommitHooks();\n    79\t  db.exec(\"BEGIN IMMEDIATE;\");\n    80\t  let value: T;\n    81\t  try {\n    82\t    value = fn({ db, clock, threadId, onCommit: hooks.register });\n    83\t    db.exec(\"COMMIT;\");\n    84\t  } catch (cause) {\n    85\t    db.exec(\"ROLLBACK;\");\n    86\t    throw cause;\n    87\t  }\n    88\t  hooks.flush();\n    89\t  return value;\n    90\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\t\n     8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n     9\t\n    10\texport type FormKind =\n    11\t  | \"smoothed_prompt\"\n    12\t  | \"tool_call_summary\"\n    13\t  | \"tool_result_summary\"\n    14\t  | \"turn_rendering\"\n    15\t  | \"lower_band_projection\"\n    16\t  | \"chunk_summary_detailed\"\n    17\t  | \"chunk_summary_brief\";\n    18\t\n    19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    20\t\n    21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    22\t// (isError/presence), never authored by the provider (AC-2.4).\n    23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    24\t\n    25\t// A composed form's record of a dependency that fell back during composition:\n    26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n    27\texport interface DependencyGap {\n    28\t  subjectKind: SubjectKind;\n    29\t  subjectId: string;\n    30\t  form: FormKind;\n    31\t}\n    32\t\n    33\t// The read shape for one derived form's state row (DD-2, DD-3).\n    34\texport interface DerivedForm {\n    35\t  subjectKind: SubjectKind;\n    36\t  subjectId: string;\n    37\t  form: FormKind;\n    38\t  state: DerivedFormState;\n    39\t  content?: string; // ready only\n    40\t  reason?: string; // failed | blocked\n    41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n    42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n    43\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n    44\t  derivedAt?: string;\n    45\t}\n    46\t\n    47\t// Mechanically stamped form metadata: tool outcomes (AC-2.4) plus — at retry\n    48\t// exhaustion — the final attempts/last-error copied from the work item before\n    49\t// its row is deleted (DD-1: the queue is not an audit table; durable outcome\n    50\t// detail lives here).\n    51\texport interface DerivedFormMetadata {\n    52\t  outcome?: ToolOutcome;\n    53\t  attempts?: number;\n    54\t  lastError?: string;\n    55\t}\n    56\t\n    57\t// ── provider seam (DD-7) ─────────────────────────────────────────\n    58\t// Every operation returns content or a structured failure carrying\n    59\t// retryable-or-not; classification is the adapter's duty.\n    60\texport type ProviderResult =\n    61\t  | { ok: true; text: string }\n    62\t  | { ok: false; retryable: boolean; reason: string };\n    63\t\n    64\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n    65\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n    66\t// rather than imported: shared/ may not import domains/.\n    67\texport type RenderingPartKind =\n    68\t  | \"user_prompt\"\n    69\t  | \"assistant_text\"\n    70\t  | \"assistant_thinking\"\n    71\t  | \"runtime_note\"\n    72\t  | \"tool_call\"\n    73\t  | \"tool_result\";\n    74\t\n    75\texport interface RenderingPart {\n    76\t  messageId: string;\n    77\t  kind: RenderingPartKind;\n    78\t  text: string; // ready form content, or raw/truncated fallback\n    79\t  fallback: boolean; // true ⇒ gap recorded\n    80\t  outcome?: ToolOutcome; // tool activity only\n    81\t}\n    82\t\n    83\texport interface DerivationProvider {\n    84\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n    85\t  summarizeToolCall(i: {\n    86\t    toolName: string;\n    87\t    argsJson: string;\n    88\t    pairedResult?: { content: string; isError: boolean };\n    89\t  }): Promise<ProviderResult>;\n    90\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n    91\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n    92\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n    93\t  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult>;\n    94\t  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult>;\n    95\t}\n    96\t\n    97\texport const PROVIDER_OPERATIONS = [\n    98\t  \"smoothPrompt\",\n    99\t  \"summarizeToolCall\",\n   100\t  \"summarizeToolResult\",\n   101\t  \"composeTurnRendering\",\n   102\t  \"projectLowerBand\",\n   103\t  \"summarizeChunkDetailed\",\n   104\t  \"summarizeChunkBrief\",\n   105\t] as const;\n   106\t\n   107\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n   108\t\n   109\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n   110\texport interface SdkConfig {\n   111\t  provider: DerivationProvider;\n   112\t  mode: \"background\" | \"manual\";\n   113\t  clock?: () => Date;\n   114\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n   115\t  lease?: { durationMs: number }; // 120000\n   116\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n   117\t}\n   118\t\n   119\t// Every optional filled by createSdk's central defaults.\n   120\texport interface ResolvedSdkConfig {\n   121\t  provider: DerivationProvider;\n   122\t  mode: \"background\" | \"manual\";\n   123\t  clock: () => Date;\n   124\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n   125\t  lease: { durationMs: number };\n   126\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n   127\t}\n   128\t\n   129\t// ── handler contract (DD-6; the map's value type) ────────────────\n   130\texport interface HandlerRunContext {\n   131\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n   132\t  provider: DerivationProvider;\n   133\t  clock: () => Date;\n   134\t  config: ResolvedSdkConfig;\n   135\t}\n   136\t\n   137\t// A successful handler hands its derived-form content back as data; the\n   138\t// drain's completion transaction performs the version-checked UPDATE and the\n   139\t// item-row deletion atomically (tech design §Mechanics: completion is one\n   140\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n   141\t// never opens that transaction itself, so the version check and the\n   142\t// done/stale_discarded disposition stay in one place — the queue util.\n   143\texport interface HandlerFormWrite {\n   144\t  subjectKind: SubjectKind;\n   145\t  subjectId: string;\n   146\t  form: FormKind;\n   147\t  content: string;\n   148\t  metadata?: DerivedFormMetadata;\n   149\t  gaps?: DependencyGap[];\n   150\t}\n   151\t\n   152\t// The completion-transaction hook (Story 3): work that must land atomically\n   153\t// with the version-checked form writes — chunk placement and the\n   154\t// close→summary enqueues above all. The queue util invokes it inside the\n   155\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n   156\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n   157\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n   158\t// crash leaves either a placed turn with its enqueues or nothing — never a\n   159\t// derived-but-unplaced turn.\n   160\texport interface CompletionTx {\n   161\t  db: DatabaseSync;\n   162\t  onCommit: (fn: () => void) => void;\n   163\t}\n   164\t\n   165\texport type HandlerOutcome =\n   166\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n   167\t  | { ok: false; retryable: boolean; reason: string }\n   168\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n   169\t\n   170\t// item is the queue util's WorkItemRecord; typed structurally here so the\n   171\t// shared layer does not depend on the util's module (and vice versa stays\n   172\t// one-directional: tech-utils imports shared).\n   173\texport type WorkHandler = (\n   174\t  run: HandlerRunContext,\n   175\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n   176\t) => Promise<HandlerOutcome>;\n","exit_code":0,"status":"completed"}}

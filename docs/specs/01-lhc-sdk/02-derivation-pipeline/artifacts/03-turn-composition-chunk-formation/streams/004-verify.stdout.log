{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/providers/deterministic.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// The deterministic provider: marked, input-derived output for every seam\n     2\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n     3\t// functions of the input. It backs the named-provider registry's\n     4\t// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n     5\t// resolution seam, and the test double reuses these helpers so in-process and\n     6\t// spawned runs produce byte-identical artifacts. It is selectable only by\n     7\t// explicit name — never a production default.\n     8\timport type {\n     9\t  DerivationProvider,\n    10\t  ProviderResult,\n    11\t  RenderingPart,\n    12\t} from \"../shared/derivation.js\";\n    13\t\n    14\texport type DeterministicOpName =\n    15\t  | \"smoothPrompt\"\n    16\t  | \"summarizeToolCall\"\n    17\t  | \"summarizeToolResult\"\n    18\t  | \"composeTurnRendering\"\n    19\t  | \"projectLowerBand\"\n    20\t  | \"summarizeChunkDetailed\"\n    21\t  | \"summarizeChunkBrief\";\n    22\t\n    23\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n    24\t  smoothPrompt: \"smoothed\",\n    25\t  summarizeToolCall: \"toolcall\",\n    26\t  summarizeToolResult: \"toolresult\",\n    27\t  composeTurnRendering: \"rendering\",\n    28\t  projectLowerBand: \"projection\",\n    29\t  summarizeChunkDetailed: \"detailed\",\n    30\t  summarizeChunkBrief: \"brief\",\n    31\t};\n    32\t\n    33\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n    34\t// input-sensitive enough that distinct inputs mark distinct outputs.\n    35\texport function deterministicDigest(input: unknown): string {\n    36\t  const text = JSON.stringify(input);\n    37\t  let hash = 0x811c9dc5;\n    38\t  for (let i = 0; i < text.length; i += 1) {\n    39\t    hash ^= text.charCodeAt(i);\n    40\t    hash = Math.imul(hash, 0x01000193) >>> 0;\n    41\t  }\n    42\t  return hash.toString(16).padStart(8, \"0\");\n    43\t}\n    44\t\n    45\texport function deterministicText(\n    46\t  op: DeterministicOpName,\n    47\t  input: unknown,\n    48\t  text: string,\n    49\t): string {\n    50\t  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n    51\t}\n    52\t\n    53\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n    54\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n    55\t}\n    56\t\n    57\texport function createDeterministicProvider(): DerivationProvider {\n    58\t  return {\n    59\t    smoothPrompt: (i: { text: string }) => ok(\"smoothPrompt\", i, i.text),\n    60\t    summarizeToolCall: (i: {\n    61\t      toolName: string;\n    62\t      argsJson: string;\n    63\t      pairedResult?: { content: string; isError: boolean };\n    64\t    }) => ok(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`),\n    65\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\n    66\t      ok(\"summarizeToolResult\", i, i.content),\n    67\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\n    68\t      ok(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \")),\n    69\t    projectLowerBand: (i: { rendering: string }) => ok(\"projectLowerBand\", i, i.rendering),\n    70\t    summarizeChunkDetailed: (i: { memberProjections: string[] }) =>\n    71\t      ok(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \")),\n    72\t    summarizeChunkBrief: (i: { memberProjections: string[] }) =>\n    73\t      ok(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \")),\n    74\t  };\n    75\t}\n","exit_code":0,"status":"completed"}}

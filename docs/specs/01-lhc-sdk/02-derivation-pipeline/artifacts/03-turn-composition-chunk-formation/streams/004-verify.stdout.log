{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport type {\n    11\t  DependencyGap,\n    12\t  HandlerOutcome,\n    13\t  HandlerRunContext,\n    14\t  WorkHandler,\n    15\t} from \"../../../shared/derivation.js\";\n    16\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    17\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    18\timport { composeRenderingInput } from \"./compose.js\";\n    19\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    20\timport {\n    21\t  chunkExists,\n    22\t  readMemberMessages,\n    23\t  readMemberProjections,\n    24\t  readMessageFormRows,\n    25\t  readTurnSource,\n    26\t} from \"./forms.js\";\n    27\t\n    28\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    29\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    30\t}\n    31\t\n    32\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    33\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    34\t}\n    35\t\n    36\tfunction readThreadId(run: HandlerRunContext): string {\n    37\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    38\t    | { thread_id: string }\n    39\t    | undefined;\n    40\t  return row?.thread_id ?? \"\";\n    41\t}\n    42\t\n    43\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n    44\t  const turnId = item.sourceRef[\"turnId\"];\n    45\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n    46\t  const db = run.openDb();\n    47\t  const turn = readTurnSource(db, turnId);\n    48\t  if (turn === undefined || turn.deleted) {\n    49\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    50\t    // would hit nothing; either way the item is terminal against a source\n    51\t    // that cannot improve.\n    52\t    return sourceDamaged(`turn ${turnId} not found`);\n    53\t  }\n    54\t  if (turn.status !== \"closed\") {\n    55\t    // Derivation is queued only at close; an open turn under a queued item\n    56\t    // means the record was interfered with.\n    57\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n    58\t  }\n    59\t\n    60\t  // Compose from current message-form states: ready forms verbatim,\n    61\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n    62\t  // before any provider call, and no transaction is held across them.\n    63\t  const messages = readMemberMessages(db, turnId);\n    64\t  const forms = readMessageFormRows(\n    65\t    db,\n    66\t    messages.map((message) => message.messageId),\n    67\t  );\n    68\t  const { parts, gaps } = composeRenderingInput(messages, forms);\n    69\t\n    70\t  const rendering = await run.provider.composeTurnRendering({ parts });\n    71\t  if (!rendering.ok) return providerFailed(rendering);\n    72\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n    73\t  if (!projection.ok) return providerFailed(projection);\n    74\t\n    75\t  // The projection's token count is estimated exactly once, here, as the\n    76\t  // artifact lands; placement reads this stored arithmetic and never\n    77\t  // re-counts (AC-3.9's determinism input).\n    78\t  const projectedTokens = estimateTokens(projection.text);\n    79\t  const threadId = readThreadId(run);\n    80\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n    81\t\n    82\t  return {\n    83\t    ok: true,\n    84\t    forms: [\n    85\t      {\n    86\t        subjectKind: \"turn\",\n    87\t        subjectId: turnId,\n    88\t        form: \"turn_rendering\",\n    89\t        content: rendering.text,\n    90\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n    91\t      },\n    92\t      {\n    93\t        subjectKind: \"turn\",\n    94\t        subjectId: turnId,\n    95\t        form: \"lower_band_projection\",\n    96\t        content: projection.text,\n    97\t      },\n    98\t    ],\n    99\t    onApplied: (tx) => {\n   100\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   101\t      for (const chunkId of placement.closedChunkIds) {\n   102\t        enqueueChunkSummaries(\n   103\t          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n   104\t          chunkId,\n   105\t        );\n   106\t      }\n   107\t    },\n   108\t  };\n   109\t};\n   110\t\n   111\t// One shape for both summary kinds: read member projections in turn order,\n   112\t// call the kind's provider operation, land the chunk-level form. Two work\n   113\t// items, two handlers' runs, independent retry and states (AC-3.8); the\n   114\t// detailed/brief content split is the provider's duty per its operation\n   115\t// contract. A member whose projection is not ready falls back to nothing\n   116\t// and records a gap, mirroring the rendering's fallback rule.\n   117\tfunction chunkSummaryHandler(\n   118\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   119\t): WorkHandler {\n   120\t  return async (run, item) => {\n   121\t    const chunkId = item.sourceRef[\"chunkId\"];\n   122\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   123\t    const db = run.openDb();\n   124\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   125\t\n   126\t    const members = readMemberProjections(db, chunkId);\n   127\t    const memberProjections: string[] = [];\n   128\t    const gaps: DependencyGap[] = [];\n   129\t    for (const member of members) {\n   130\t      if (member.state === \"ready\" && member.content !== undefined) {\n   131\t        memberProjections.push(member.content);\n   132\t      } else {\n   133\t        memberProjections.push(\"\");\n   134\t        gaps.push({\n   135\t          subjectKind: \"turn\",\n   136\t          subjectId: member.turnId,\n   137\t          form: \"lower_band_projection\",\n   138\t        });\n   139\t      }\n   140\t    }\n   141\t\n   142\t    const result =\n   143\t      kind === \"chunk_summary_detailed\"\n   144\t        ? await run.provider.summarizeChunkDetailed({ memberProjections })\n   145\t        : await run.provider.summarizeChunkBrief({ memberProjections });\n   146\t    if (!result.ok) return providerFailed(result);\n   147\t\n   148\t    return {\n   149\t      ok: true,\n   150\t      forms: [\n   151\t        {\n   152\t          subjectKind: \"chunk\",\n   153\t          subjectId: chunkId,\n   154\t          form: kind,\n   155\t          content: result.text,\n   156\t          ...(gaps.length > 0 ? { gaps } : {}),\n   157\t        },\n   158\t      ],\n   159\t    };\n   160\t  };\n   161\t}\n   162\t\n   163\t// The domain's handler table, merged into the SDK dispatch map at\n   164\t// construction (DD-6).\n   165\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   166\t  turn_derivation: turnDerivationHandler,\n   167\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   168\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   169\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/chunks.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Chunk mechanics (Flow 3, DD-9): open-chunk append, the accumulated close\n     2\t// policy, and the close→summary enqueues. Placement is pure arithmetic over\n     3\t// stored projected token counts — the caller hands in the incoming turn's\n     4\t// count, the open chunk carries its accumulated count durably — so identical\n     5\t// streams re-chunk identically (AC-3.9): no clock, no inference, no\n     6\t// re-estimation at placement time. Everything here runs inside the\n     7\t// turn-derivation completion transaction; a crash leaves either a placed\n     8\t// turn (with any close's summary enqueues) or nothing.\n     9\timport type { DatabaseSync } from \"node:sqlite\";\n    10\timport type { OperationContext } from \"../../../shared/context.js\";\n    11\timport { enqueue, type WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n    12\t\n    13\texport interface ChunkPolicy {\n    14\t  targetProjectedTokens: number;\n    15\t  maxProjectedTokens: number;\n    16\t}\n    17\t\n    18\texport interface PlacementResult {\n    19\t  chunkId: string;\n    20\t  memberIdx: number;\n    21\t  // Chunks closed by this placement, in close order: at most the previous\n    22\t  // open chunk (accumulation rule) and then the incoming turn's own chunk\n    23\t  // (max rule) — a turn ≥ max arriving behind an open chunk closes both.\n    24\t  closedChunkIds: string[];\n    25\t  // An explicitly rebuilt turn keeps its placement (membership shrinks only\n    26\t  // through Story 6's sanctioned mutation, never re-cuts): a turn already a\n    27\t  // member is left exactly where it is and nothing closes.\n    28\t  alreadyPlaced: boolean;\n    29\t}\n    30\t\n    31\tinterface OpenChunkRow {\n    32\t  chunk_id: string;\n    33\t  accumulated_projected_tokens: number | bigint;\n    34\t}\n    35\t\n    36\tfunction memberCount(db: DatabaseSync, chunkId: string): number {\n    37\t  const row = db\n    38\t    .prepare(`SELECT COUNT(*) AS n FROM chunk_member WHERE chunk_id = ?`)\n    39\t    .get(chunkId) as unknown as { n: number | bigint };\n    40\t  return Number(row.n);\n    41\t}\n    42\t\n    43\tfunction closeChunk(db: DatabaseSync, chunkId: string): void {\n    44\t  db.prepare(`UPDATE chunk SET status = 'closed' WHERE chunk_id = ?`).run(chunkId);\n    45\t}\n    46\t\n    47\tfunction openNextChunk(db: DatabaseSync): string {\n    48\t  const row = db.prepare(`SELECT MAX(chunk_order) AS max_order FROM chunk`).get() as\n    49\t    | { max_order: number | bigint | null }\n    50\t    | undefined;\n    51\t  const order = Number(row?.max_order ?? 0) + 1;\n    52\t  const chunkId = `c${order}`;\n    53\t  db.prepare(\n    54\t    `INSERT INTO chunk (chunk_id, chunk_order, status, accumulated_projected_tokens)\n    55\t     VALUES (?, ?, 'open', 0)`,\n    56\t  ).run(chunkId, order);\n    57\t  return chunkId;\n    58\t}\n    59\t\n    60\t// The close policy, golden cases exact (DD-9): when the open chunk's\n    61\t// accumulated count plus the incoming turn's would reach the target\n    62\t// (inclusive — equality closes), the chunk closes holding its current\n    63\t// members and the incoming turn opens the next chunk; a single projection\n    64\t// ≥ max closes its own chunk immediately. An empty open chunk always accepts\n    65\t// the incoming turn — a chunk never closes empty.\n    66\texport function placeTurn(\n    67\t  db: DatabaseSync,\n    68\t  turnId: string,\n    69\t  projectedTokens: number,\n    70\t  policy: ChunkPolicy,\n    71\t): PlacementResult {\n    72\t  const existing = db\n    73\t    .prepare(`SELECT chunk_id, member_idx FROM chunk_member WHERE turn_id = ?`)\n    74\t    .get(turnId) as unknown as { chunk_id: string; member_idx: number | bigint } | undefined;\n    75\t  if (existing !== undefined) {\n    76\t    return {\n    77\t      chunkId: existing.chunk_id,\n    78\t      memberIdx: Number(existing.member_idx),\n    79\t      closedChunkIds: [],\n    80\t      alreadyPlaced: true,\n    81\t    };\n    82\t  }\n    83\t\n    84\t  const closedChunkIds: string[] = [];\n    85\t  let open = db\n    86\t    .prepare(\n    87\t      `SELECT chunk_id, accumulated_projected_tokens FROM chunk\n    88\t       WHERE status = 'open' ORDER BY chunk_order DESC LIMIT 1`,\n    89\t    )\n    90\t    .get() as unknown as OpenChunkRow | undefined;\n    91\t\n    92\t  if (\n    93\t    open !== undefined &&\n    94\t    memberCount(db, open.chunk_id) > 0 &&\n    95\t    Number(open.accumulated_projected_tokens) + projectedTokens >= policy.targetProjectedTokens\n    96\t  ) {\n    97\t    // Crossing closes *without* the incoming turn — the v1 bug's fix: the\n    98\t    // decision weighs accumulated + incoming, and the incoming turn starts\n    99\t    // the next chunk (AC-3.6).\n   100\t    closeChunk(db, open.chunk_id);\n   101\t    closedChunkIds.push(open.chunk_id);\n   102\t    open = undefined;\n   103\t  }\n   104\t\n   105\t  const chunkId = open?.chunk_id ?? openNextChunk(db);\n   106\t  const memberIdx = memberCount(db, chunkId);\n   107\t  db.prepare(`INSERT INTO chunk_member (chunk_id, turn_id, member_idx) VALUES (?, ?, ?)`).run(\n   108\t    chunkId,\n   109\t    turnId,\n   110\t    memberIdx,\n   111\t  );\n   112\t  db.prepare(\n   113\t    `UPDATE chunk SET accumulated_projected_tokens = accumulated_projected_tokens + ?\n   114\t     WHERE chunk_id = ?`,\n   115\t  ).run(projectedTokens, chunkId);\n   116\t\n   117\t  if (projectedTokens >= policy.maxProjectedTokens) {\n   118\t    // Max rule (AC-3.7): the projection alone meets the maximum, so the\n   119\t    // turn's chunk closes immediately, whatever it holds.\n   120\t    closeChunk(db, chunkId);\n   121\t    closedChunkIds.push(chunkId);\n   122\t  }\n   123\t\n   124\t  return { chunkId, memberIdx, closedChunkIds, alreadyPlaced: false };\n   125\t}\n   126\t\n   127\t// Closing queues the two summary kinds as two work items with independent\n   128\t// retry, states, and re-queue (AC-3.8); both enqueues ride the caller's\n   129\t// ambient transaction — the completion commit — per DD-5.\n   130\texport function enqueueChunkSummaries(\n   131\t  ctx: OperationContext,\n   132\t  chunkId: string,\n   133\t): WorkItemRecord[] {\n   134\t  return ([\"chunk_summary_detailed\", \"chunk_summary_brief\"] as const).map((kind) =>\n   135\t    enqueue(ctx, {\n   136\t      owner: \"turns\",\n   137\t      kind,\n   138\t      sourceRef: { chunkId },\n   139\t      forms: [{ subjectKind: \"chunk\", subjectId: chunkId, form: kind }],\n   140\t    }),\n   141\t  );\n   142\t}\n   143\t\n   144\t// Placement read-back for the turns surface (AC-3.5): chunkId + memberIdx by\n   145\t// turn, one query, stored values only.\n   146\texport function readPlacements(\n   147\t  db: DatabaseSync,\n   148\t): Map<string, { chunkId: string; memberIdx: number }> {\n   149\t  const rows = db\n   150\t    .prepare(`SELECT turn_id, chunk_id, member_idx FROM chunk_member`)\n   151\t    .all() as unknown as Array<{\n   152\t    turn_id: string;\n   153\t    chunk_id: string;\n   154\t    member_idx: number | bigint;\n   155\t  }>;\n   156\t  const byTurn = new Map<string, { chunkId: string; memberIdx: number }>();\n   157\t  for (const row of rows) {\n   158\t    byTurn.set(row.turn_id, { chunkId: row.chunk_id, memberIdx: Number(row.member_idx) });\n   159\t  }\n   160\t  return byTurn;\n   161\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,180p'\"","aggregated_output":"     1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n     2\t// source turn, the member messages it composes (deleted-filtered — the\n     3\t// shared read-filter rule lives here, once for this domain), the\n     4\t// message-level form rows composition consumes, and the member projections\n     5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n     6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n     7\t// — no write path here.\n     8\timport type { DatabaseSync } from \"node:sqlite\";\n     9\timport type { RenderingPartKind } from \"../../../shared/derivation.js\";\n    10\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n    11\timport { composeFormKey } from \"./compose.js\";\n    12\timport type { FormKind } from \"../../../shared/derivation.js\";\n    13\t\n    14\texport interface TurnSource {\n    15\t  turnId: string;\n    16\t  status: \"open\" | \"closed\";\n    17\t  deleted: boolean;\n    18\t}\n    19\t\n    20\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n    21\t  const row = db\n    22\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    23\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n    24\t  if (row === undefined) return undefined;\n    25\t  return {\n    26\t    turnId,\n    27\t    status: row.status as TurnSource[\"status\"],\n    28\t    deleted: row.deleted_at !== null,\n    29\t  };\n    30\t}\n    31\t\n    32\t// Member messages in message order, blocks attached, deleted messages\n    33\t// filtered (tech design §Mechanics: composition's member enumeration reads\n    34\t// the live projection only).\n    35\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n    36\t  const messages = db\n    37\t    .prepare(\n    38\t      `SELECT message_id, kind FROM message\n    39\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    40\t    )\n    41\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n    42\t  const blockStmt = db.prepare(\n    43\t    `SELECT block_type, content FROM message_block\n    44\t     WHERE message_id = ? ORDER BY block_index`,\n    45\t  );\n    46\t  return messages.map((message) => {\n    47\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n    48\t      block_type: string;\n    49\t      content: string;\n    50\t    }>;\n    51\t    return {\n    52\t      messageId: message.message_id,\n    53\t      kind: message.kind as RenderingPartKind,\n    54\t      blocks: blocks.map((block) => ({\n    55\t        blockType: block.block_type,\n    56\t        content: JSON.parse(block.content) as Record<string, unknown>,\n    57\t      })),\n    58\t    };\n    59\t  });\n    60\t}\n    61\t\n    62\t// The message-owned form rows for a set of member messages, keyed for\n    63\t// composition. A cross-owner *read* by design: composition consumes message\n    64\t// forms; only message handlers ever write them (DD-2 ownership is a write\n    65\t// rule).\n    66\texport function readMessageFormRows(\n    67\t  db: DatabaseSync,\n    68\t  messageIds: readonly string[],\n    69\t): Map<string, ComposeFormRow> {\n    70\t  const rows = new Map<string, ComposeFormRow>();\n    71\t  if (messageIds.length === 0) return rows;\n    72\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n    73\t  const raw = db\n    74\t    .prepare(\n    75\t      `SELECT subject_id, form, state, content, metadata FROM derived_form\n    76\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    77\t    )\n    78\t    .all(...messageIds) as unknown as Array<{\n    79\t    subject_id: string;\n    80\t    form: string;\n    81\t    state: string;\n    82\t    content: string | null;\n    83\t    metadata: string | null;\n    84\t  }>;\n    85\t  for (const row of raw) {\n    86\t    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n    87\t    if (row.content !== null) view.content = row.content;\n    88\t    if (row.metadata !== null) {\n    89\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n    90\t    }\n    91\t    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n    92\t  }\n    93\t  return rows;\n    94\t}\n    95\t\n    96\t// Member projections in turn order for the chunk summaries: member rows by\n    97\t// member_idx, deleted turns filtered, each joined to its stored\n    98\t// lower_band_projection row (state + content as landed — never re-derived).\n    99\texport interface MemberProjection {\n   100\t  turnId: string;\n   101\t  state?: string; // undefined: no projection row exists for the member\n   102\t  content?: string;\n   103\t}\n   104\t\n   105\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n   106\t  const rows = db\n   107\t    .prepare(\n   108\t      `SELECT cm.turn_id, df.state, df.content\n   109\t       FROM chunk_member cm\n   110\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   111\t       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n   112\t         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n   113\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   114\t    )\n   115\t    .all(chunkId) as unknown as Array<{\n   116\t    turn_id: string;\n   117\t    state: string | null;\n   118\t    content: string | null;\n   119\t  }>;\n   120\t  return rows.map((row) => {\n   121\t    const projection: MemberProjection = { turnId: row.turn_id };\n   122\t    if (row.state !== null) projection.state = row.state;\n   123\t    if (row.content !== null) projection.content = row.content;\n   124\t    return projection;\n   125\t  });\n   126\t}\n   127\t\n   128\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n   129\t  return (\n   130\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n   131\t  );\n   132\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/compose.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n     2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n     3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n     4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n     5\t// clock in the signature: determinism is structural, not disciplined.\n     6\t//\n     7\t// Tool activity stays in message order — runs are the consecutive tool\n     8\t// messages exactly as recorded, never reordered to make accounts tidier —\n     9\t// and every tool part carries its outcome, so a run containing a\n    10\t// state-changing call structurally cannot lose its outcome in composition\n    11\t// (AC-3.4: the outcome rides the part, not the prose).\n    12\timport type {\n    13\t  DependencyGap,\n    14\t  DerivedFormMetadata,\n    15\t  DerivedFormState,\n    16\t  FormKind,\n    17\t  RenderingPart,\n    18\t  RenderingPartKind,\n    19\t  ToolOutcome,\n    20\t} from \"../../../shared/derivation.js\";\n    21\t\n    22\t// The member message as the composer sees it: kind plus projected blocks,\n    23\t// verbatim from the record (already deleted-filtered by the caller's read).\n    24\texport interface ComposeMessage {\n    25\t  messageId: string;\n    26\t  kind: RenderingPartKind;\n    27\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    28\t}\n    29\t\n    30\t// One message-owned form row as composition input; keyed by the caller as\n    31\t// `${messageId}/${form}`.\n    32\texport interface ComposeFormRow {\n    33\t  state: DerivedFormState;\n    34\t  content?: string;\n    35\t  metadata?: DerivedFormMetadata;\n    36\t}\n    37\t\n    38\texport function composeFormKey(messageId: string, form: FormKind): string {\n    39\t  return `${messageId}/${form}`;\n    40\t}\n    41\t\n    42\texport interface CompositionInput {\n    43\t  parts: RenderingPart[];\n    44\t  gaps: DependencyGap[];\n    45\t}\n    46\t\n    47\t// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n    48\t// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n    49\t// function of the input string alone.\n    50\texport const FALLBACK_TRUNCATION_LIMIT = 200;\n    51\t\n    52\texport function truncateForFallback(text: string): string {\n    53\t  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n    54\t  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n    55\t  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n    56\t}\n    57\t\n    58\tfunction textOf(message: ComposeMessage): string {\n    59\t  const text = message.blocks[0]?.content[\"text\"];\n    60\t  return typeof text === \"string\" ? text : \"\";\n    61\t}\n    62\t\n    63\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n    64\t// composition): a tool call's outcome comes from its paired result among the\n    65\t// turn's messages — present and clean, present and isError, or absent.\n    66\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n    67\t  const byCallId = new Map<string, boolean>();\n    68\t  for (const message of messages) {\n    69\t    if (message.kind !== \"tool_result\") continue;\n    70\t    const block = message.blocks[0]?.content ?? {};\n    71\t    const callId = block[\"toolCallId\"];\n    72\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n    73\t  }\n    74\t  return byCallId;\n    75\t}\n    76\t\n    77\tfunction outcomeFromRecord(\n    78\t  resultByCallId: Map<string, boolean>,\n    79\t  callId: unknown,\n    80\t): ToolOutcome {\n    81\t  if (typeof callId !== \"string\") return \"unknown\";\n    82\t  const isError = resultByCallId.get(callId);\n    83\t  if (isError === undefined) return \"unknown\";\n    84\t  return isError ? \"failed\" : \"succeeded\";\n    85\t}\n    86\t\n    87\tinterface PartPlan {\n    88\t  form?: FormKind; // the message-level form this kind composes from, if any\n    89\t  fallbackText: (message: ComposeMessage) => string;\n    90\t}\n    91\t\n    92\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n    93\t// call/result → deterministic truncation; text/thinking/note → raw, no form\n    94\t// to fall back from and therefore never a gap.\n    95\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n    96\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n    97\t  assistant_text: { fallbackText: textOf },\n    98\t  assistant_thinking: { fallbackText: textOf },\n    99\t  runtime_note: { fallbackText: textOf },\n   100\t  tool_call: {\n   101\t    form: \"tool_call_summary\",\n   102\t    fallbackText: (message) => {\n   103\t      const block = message.blocks[0]?.content ?? {};\n   104\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n   105\t      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n   106\t    },\n   107\t  },\n   108\t  tool_result: {\n   109\t    form: \"tool_result_summary\",\n   110\t    fallbackText: (message) => {\n   111\t      const block = message.blocks[0]?.content ?? {};\n   112\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n   113\t    },\n   114\t  },\n   115\t};\n   116\t\n   117\t// Ready forms verbatim; non-ready (pending | failed | blocked) fall back with\n   118\t// one gap recorded per fallback naming the source record and the missing\n   119\t// form (AC-3.2). Gaps are facts about this composition — the caller lands\n   120\t// them on the rendering and they stay put until an explicit rebuild\n   121\t// recomposes from current states (AC-3.3).\n   122\texport function composeRenderingInput(\n   123\t  messages: readonly ComposeMessage[],\n   124\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   125\t): CompositionInput {\n   126\t  const parts: RenderingPart[] = [];\n   127\t  const gaps: DependencyGap[] = [];\n   128\t  const resultByCallId = recordOutcomes(messages);\n   129\t\n   130\t  for (const message of messages) {\n   131\t    const plan = PART_PLANS[message.kind];\n   132\t    const form = plan.form === undefined ? undefined : forms.get(composeFormKey(message.messageId, plan.form));\n   133\t    const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n   134\t\n   135\t    const part: RenderingPart = {\n   136\t      messageId: message.messageId,\n   137\t      kind: message.kind,\n   138\t      text: ready ? (form.content as string) : plan.fallbackText(message),\n   139\t      fallback: plan.form !== undefined && !ready,\n   140\t    };\n   141\t    if (message.kind === \"tool_call\") {\n   142\t      const callId = message.blocks[0]?.content[\"toolCallId\"];\n   143\t      part.outcome =\n   144\t        ready && form.metadata?.outcome !== undefined\n   145\t          ? form.metadata.outcome\n   146\t          : outcomeFromRecord(resultByCallId, callId);\n   147\t    } else if (message.kind === \"tool_result\") {\n   148\t      const block = message.blocks[0]?.content ?? {};\n   149\t      part.outcome =\n   150\t        ready && form.metadata?.outcome !== undefined\n   151\t          ? form.metadata.outcome\n   152\t          : block[\"isError\"] === true\n   153\t            ? \"failed\"\n   154\t            : \"succeeded\";\n   155\t    }\n   156\t    parts.push(part);\n   157\t    if (part.fallback && plan.form !== undefined) {\n   158\t      gaps.push({ subjectKind: \"message\", subjectId: message.messageId, form: plan.form });\n   159\t    }\n   160\t  }\n   161\t\n   162\t  return { parts, gaps };\n   163\t}\n","exit_code":0,"status":"completed"}}

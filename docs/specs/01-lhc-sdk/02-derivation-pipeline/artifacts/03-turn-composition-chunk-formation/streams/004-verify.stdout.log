{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/derivation-turns.test.ts | sed -n '440,700p'\"","aggregated_output":"   440\t    const big = estimateTokens(BIG);\n   441\t    const projections = [SMALL, BIG];\n   442\t    const double = createProviderDouble();\n   443\t    const provider = withScriptedProjections(double, () => {\n   444\t      const next = projections.shift();\n   445\t      if (next === undefined) throw new Error(\"scripted projections exhausted\");\n   446\t      return next;\n   447\t    });\n   448\t    // target = max = big: the small turn sits safely under both; the big\n   449\t    // turn's arrival crosses the target (small + big ≥ big) and its own\n   450\t    // projection meets the max.\n   451\t    const sdk = manualSdk(provider, {\n   452\t      targetProjectedTokens: big,\n   453\t      maxProjectedTokens: big,\n   454\t    });\n   455\t    const filePath = await newThread();\n   456\t    await sendTurn(sdk, filePath, \"small turn\", \"small answer\");\n   457\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n   458\t\n   459\t    await drain(sdk, filePath);\n   460\t    const snapshot = readChunks(filePath);\n   461\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n   462\t      [\"c1\", \"closed\"],\n   463\t      [\"c2\", \"closed\"],\n   464\t    ]);\n   465\t    expect(snapshot.members).toEqual([\n   466\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n   467\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n   468\t    ]);\n   469\t    for (const chunkId of [\"c1\", \"c2\"]) {\n   470\t      expect(formOf(filePath, chunkId, \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n   471\t      expect(formOf(filePath, chunkId, \"chunk_summary_brief\")?.state).toBe(\"ready\");\n   472\t    }\n   473\t  });\n   474\t});\n   475\t\n   476\tdescribe(\"TC-3.8 / AC-3.8: chunk close queues two summary work items with independent lifecycles\", () => {\n   477\t  // target=max=1: every turn self-chunks and closes immediately, the\n   478\t  // smallest deterministic way to manufacture closed chunks.\n   479\t  const SELF_CHUNK = { targetProjectedTokens: 1, maxProjectedTokens: 1 };\n   480\t\n   481\t  it(\"both summaries land ready as distinct chunk-level forms\", async () => {\n   482\t    const double = createProviderDouble();\n   483\t    const sdk = manualSdk(double, SELF_CHUNK);\n   484\t    const filePath = await newThread();\n   485\t    await sendTurn(sdk, filePath, \"summarize me\", \"summarized\");\n   486\t\n   487\t    const report = await drain(sdk, filePath);\n   488\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n   489\t      [\"prompt_smoothing\", \"done\"],\n   490\t      [\"turn_derivation\", \"done\"],\n   491\t      [\"chunk_summary_detailed\", \"done\"],\n   492\t      [\"chunk_summary_brief\", \"done\"],\n   493\t    ]);\n   494\t    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n   495\t    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n   496\t    expect(detailed?.state).toBe(\"ready\");\n   497\t    expect(brief?.state).toBe(\"ready\");\n   498\t    // Double-marked content distinguishes the two kinds: each went through\n   499\t    // its own provider operation over the member projections.\n   500\t    const memberProjections = [formOf(filePath, \"t1\", \"lower_band_projection\")?.content ?? \"\"];\n   501\t    expect(detailed?.content).toBe(\n   502\t      deterministicText(\"summarizeChunkDetailed\", { memberProjections }, memberProjections.join(\" | \")),\n   503\t    );\n   504\t    expect(brief?.content).toBe(\n   505\t      deterministicText(\"summarizeChunkBrief\", { memberProjections }, memberProjections.join(\" | \")),\n   506\t    );\n   507\t    expect(detailed?.content).not.toBe(brief?.content);\n   508\t  });\n   509\t\n   510\t  it(\"the brief item fails past budget alone: detailed ready, brief failed, brief re-queueable by itself\", async () => {\n   511\t    const double = createProviderDouble();\n   512\t    const sdk = manualSdk(double, SELF_CHUNK);\n   513\t    const filePath = await newThread();\n   514\t    double.failKind(\"chunk_summary_brief\", 3, {\n   515\t      retryable: true,\n   516\t      reason: \"scripted brief failure\",\n   517\t    });\n   518\t    await sendTurn(sdk, filePath, \"independent retry\", \"answer\");\n   519\t\n   520\t    const report = await drain(sdk, filePath);\n   521\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n   522\t      [\"prompt_smoothing\", \"done\"],\n   523\t      [\"turn_derivation\", \"done\"],\n   524\t      [\"chunk_summary_detailed\", \"done\"],\n   525\t      [\"chunk_summary_brief\", \"failed_terminal\"],\n   526\t    ]);\n   527\t    const detailedBefore = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n   528\t    expect(detailedBefore?.state).toBe(\"ready\");\n   529\t    const failedBrief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n   530\t    expect(failedBrief?.state).toBe(\"failed\");\n   531\t    expect(failedBrief?.reason).toBe(\"scripted brief failure\");\n   532\t\n   533\t    // Re-queue the brief alone through the queue util (Story 4 owns the\n   534\t    // public surface); the detailed form must not move.\n   535\t    requeueDirect(filePath, {\n   536\t      owner: \"turns\",\n   537\t      kind: \"chunk_summary_brief\",\n   538\t      sourceRef: { chunkId: \"c1\" },\n   539\t      forms: [{ subjectKind: \"chunk\", subjectId: \"c1\", form: \"chunk_summary_brief\" }],\n   540\t    });\n   541\t    const requeued = await drain(sdk, filePath);\n   542\t    expect(requeued.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n   543\t      [\"chunk_summary_brief\", \"done\"],\n   544\t    ]);\n   545\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n   546\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")).toEqual(detailedBefore);\n   547\t  });\n   548\t});\n   549\t\n   550\tdescribe(\"TC-3.9 / AC-3.9 (architecture risk): chunk boundaries are deterministic under replay\", () => {\n   551\t  it(\"the same event stream into a fresh thread re-chunks identically — membership and boundaries deep-equal\", async () => {\n   552\t    const policy = { targetProjectedTokens: 60, maxProjectedTokens: 4400 };\n   553\t    const turnsContent: Array<[string, string]> = [\n   554\t      [\"first prompt about the parser\", \"parser answer with detail\"],\n   555\t      [\"second prompt about the cache\", \"cache answer, longer, with extra words\"],\n   556\t      [\"third prompt about the index rebuild\", \"index answer\"],\n   557\t      [\"fourth prompt, short\", \"fourth answer, also short\"],\n   558\t      [\"fifth prompt to push past one chunk\", \"fifth answer closing things out\"],\n   559\t    ];\n   560\t\n   561\t    async function buildAndDrain(): Promise<string> {\n   562\t      const double = createProviderDouble();\n   563\t      const sdk = manualSdk(double, policy);\n   564\t      const filePath = await newThread();\n   565\t      for (const [prompt, answer] of turnsContent) await sendTurn(sdk, filePath, prompt, answer);\n   566\t      await drain(sdk, filePath);\n   567\t      return filePath;\n   568\t    }\n   569\t\n   570\t    const first = await buildAndDrain();\n   571\t    const second = await buildAndDrain();\n   572\t\n   573\t    const firstSnapshot = readChunks(first);\n   574\t    expect(firstSnapshot).toEqual(readChunks(second));\n   575\t    // The replay claim is only meaningful if the policy actually cut: the\n   576\t    // stream must span more than one chunk.\n   577\t    expect(firstSnapshot.chunks.length).toBeGreaterThan(1);\n   578\t    // No inference joined placement anywhere: the closed chunks' summary\n   579\t    // artifacts are byte-identical across the two records too.\n   580\t    const summariesOf = (filePath: string) =>\n   581\t      readDerivedForms(filePath)\n   582\t        .filter((form) => form.subjectKind === \"chunk\")\n   583\t        .map((form) => [form.subjectId, form.form, form.state, form.content]);\n   584\t    expect(summariesOf(first)).toEqual(summariesOf(second));\n   585\t  });\n   586\t});\n","exit_code":0,"status":"completed"}}

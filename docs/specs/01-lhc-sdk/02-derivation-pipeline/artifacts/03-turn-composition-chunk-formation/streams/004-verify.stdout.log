{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/derivation-turns.test.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Story 3 (Epic 02): turn composition and chunk formation — Flow 3. The\n     2\t// turn_derivation handler composing from message forms with recorded\n     3\t// fallback gaps (TC-3.2), the no-auto-cascade rule (TC-3.3, architecture\n     4\t// risk), outcome-explicit tool-run accounts (TC-3.4), placement in the\n     5\t// completion transaction (TC-3.5), the accumulated close policy's golden\n     6\t// cases (TC-3.6/3.7, architecture risk), the two summary kinds with\n     7\t// independent lifecycles (TC-3.8), and determinism under replay (TC-3.9,\n     8\t// architecture risk). Every drain dispatches the production handlers\n     9\t// registered by the turns domain at createSdk; the TC-3.3/TC-3.8 re-queues\n    10\t// drive the queue util directly per the story note (the public re-queue\n    11\t// surface is Story 4's).\n    12\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    13\timport {\n    14\t  countLiveItems,\n    15\t  createSdk,\n    16\t  deterministicText,\n    17\t  enqueue,\n    18\t  estimateTokens,\n    19\t  runInTransaction,\n    20\t  threads,\n    21\t  type BatchResult,\n    22\t  type DerivationProvider,\n    23\t  type DrainReport,\n    24\t  type EnqueueInput,\n    25\t  type Lhc,\n    26\t  type MessageEventInput,\n    27\t  type ProviderResult,\n    28\t  type RenderingPart,\n    29\t  type SdkConfig,\n    30\t} from \"../src/index.js\";\n    31\timport {\n    32\t  createProviderDouble,\n    33\t  openRaw,\n    34\t  readChunks,\n    35\t  readDerivedForms,\n    36\t  tempStore,\n    37\t  validEvent,\n    38\t  type TempStore,\n    39\t} from \"./fixtures/index.js\";\n    40\t\n    41\tlet store: TempStore;\n    42\tbeforeEach(() => {\n    43\t  store = tempStore();\n    44\t});\n    45\tafterEach(() => {\n    46\t  store.cleanup();\n    47\t});\n    48\t\n    49\tasync function newThread(): Promise<string> {\n    50\t  const created = await threads.newThread({\n    51\t    filePath: store.threadPath(),\n    52\t    registryPath: store.registryPath,\n    53\t  });\n    54\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n    55\t  return created.value.filePath;\n    56\t}\n    57\t\n    58\tfunction manualSdk(\n    59\t  provider: DerivationProvider,\n    60\t  chunkPolicy?: SdkConfig[\"chunkPolicy\"],\n    61\t): Lhc {\n    62\t  const config: SdkConfig = {\n    63\t    provider,\n    64\t    mode: \"manual\",\n    65\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    66\t    lease: { durationMs: 200 },\n    67\t  };\n    68\t  if (chunkPolicy !== undefined) config.chunkPolicy = chunkPolicy;\n    69\t  return createSdk(config);\n    70\t}\n    71\t\n    72\tasync function send(\n    73\t  sdk: Lhc,\n    74\t  filePath: string,\n    75\t  batch: readonly MessageEventInput[],\n    76\t): Promise<BatchResult> {\n    77\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    78\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n    79\t  return result.value;\n    80\t}\n    81\t\n    82\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n    83\t  const result = await sdk.work.drain({ filePath });\n    84\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n    85\t  return result.value;\n    86\t}\n    87\t\n    88\t// One closed prompt+answer turn through real intake.\n    89\tasync function sendTurn(\n    90\t  sdk: Lhc,\n    91\t  filePath: string,\n    92\t  prompt: string,\n    93\t  answer: string,\n    94\t): Promise<void> {\n    95\t  await send(sdk, filePath, [\n    96\t    validEvent(\"user_prompt\", { payload: { text: prompt } }),\n    97\t    validEvent(\"assistant_text\", { payload: { text: answer } }),\n    98\t    validEvent(\"turn_end\"),\n    99\t  ]);\n   100\t}\n   101\t\n   102\tfunction formOf(filePath: string, subjectId: string, form: string) {\n   103\t  return readDerivedForms(filePath).find(\n   104\t    (f) => f.subjectId === subjectId && f.form === form,\n   105\t  );\n   106\t}\n   107\t\n   108\tfunction liveCount(filePath: string): number {\n   109\t  const db = openRaw(filePath);\n   110\t  try {\n   111\t    return countLiveItems(db);\n   112\t  } finally {\n   113\t    db.close();\n   114\t  }\n   115\t}\n   116\t\n   117\t// The story-sanctioned re-queue path for TC-3.3/TC-3.8: the Story 1 queue\n   118\t// util driven directly inside a real transaction (the public re-queue\n   119\t// operation with refusal/idempotency semantics is Story 4's surface).\n   120\tfunction requeueDirect(filePath: string, input: EnqueueInput): void {\n   121\t  const db = openRaw(filePath);\n   122\t  try {\n   123\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as {\n   124\t      thread_id: string;\n   125\t    };\n   126\t    runInTransaction(db, () => new Date(), row.thread_id, (ctx) => enqueue(ctx, input));\n   127\t  } finally {\n   128\t    db.close();\n   129\t  }\n   130\t}\n   131\t\n   132\t// A provider that delegates to the deterministic double except for scripted\n   133\t// lower-band projections — the seam tests use to pin projected token counts\n   134\t// for the placement golden cases (the projection content is what placement\n   135\t// arithmetic measures, exactly once, at landing).\n   136\tfunction withScriptedProjections(\n   137\t  base: DerivationProvider,\n   138\t  next: () => string,\n   139\t): DerivationProvider {\n   140\t  return {\n   141\t    smoothPrompt: (i) => base.smoothPrompt(i),\n   142\t    summarizeToolCall: (i) => base.summarizeToolCall(i),\n   143\t    summarizeToolResult: (i) => base.summarizeToolResult(i),\n   144\t    composeTurnRendering: (i) => base.composeTurnRendering(i),\n   145\t    projectLowerBand: (): Promise<ProviderResult> =>\n   146\t      Promise.resolve({ ok: true, text: next() }),\n   147\t    summarizeChunkDetailed: (i) => base.summarizeChunkDetailed(i),\n   148\t    summarizeChunkBrief: (i) => base.summarizeChunkBrief(i),\n   149\t  };\n   150\t}\n   151\t\n   152\tdescribe(\"TC-3.1 / AC-3.1: a closed turn lands a rendering and a lower-band projection as independent rows\", () => {\n   153\t  it(\"all message forms ready → both turn forms ready, composed from the forms, each its own state row\", async () => {\n   154\t    const double = createProviderDouble();\n   155\t    const sdk = manualSdk(double);\n   156\t    const filePath = await newThread();\n   157\t    const prompt = \"compose this turn\";\n   158\t    const answer = \"the composed answer\";\n   159\t    await sendTurn(sdk, filePath, prompt, answer);\n   160\t\n   161\t    const report = await drain(sdk, filePath);\n   162\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   163\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n   164\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n   165\t    ]);\n   166\t\n   167\t    // Reconstruct the exact composition: the smoothed form verbatim, the\n   168\t    // assistant text raw (never had a form) — proof the rendering consumed\n   169\t    // forms, not raw re-derivation.\n   170\t    const smoothed = deterministicText(\"smoothPrompt\", { text: prompt }, prompt);\n   171\t    const parts: RenderingPart[] = [\n   172\t      { messageId: \"m1\", kind: \"user_prompt\", text: smoothed, fallback: false },\n   173\t      { messageId: \"m2\", kind: \"assistant_text\", text: answer, fallback: false },\n   174\t    ];\n   175\t    const renderingText = deterministicText(\n   176\t      \"composeTurnRendering\",\n   177\t      { parts },\n   178\t      `${smoothed} | ${answer}`,\n   179\t    );\n   180\t    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\n   181\t    const projection = formOf(filePath, \"t1\", \"lower_band_projection\");\n   182\t    expect(rendering).toMatchObject({\n   183\t      subjectKind: \"turn\",\n   184\t      state: \"ready\",\n   185\t      content: renderingText,\n   186\t      sourceVersion: 1,\n   187\t    });\n   188\t    expect(rendering?.gaps).toBeUndefined();\n   189\t    expect(projection).toMatchObject({\n   190\t      subjectKind: \"turn\",\n   191\t      state: \"ready\",\n   192\t      content: deterministicText(\"projectLowerBand\", { rendering: renderingText }, renderingText),\n   193\t      sourceVersion: 1,\n   194\t    });\n   195\t    expect(liveCount(filePath)).toBe(0);\n   196\t  });\n   197\t});\n   198\t\n   199\tdescribe(\"TC-3.2 / AC-3.2: a non-ready message form falls back and records a gap; the rendering still lands ready\", () => {\n   200\t  it(\"failed smoothing → rendering ready with the raw prompt text and a gap naming message and form\", async () => {\n   201\t    const double = createProviderDouble();\n   202\t    const sdk = manualSdk(double);\n   203\t    const filePath = await newThread();\n   204\t    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n   205\t    await sendTurn(sdk, filePath, \"raw prompt one\", \"answer text\");\n   206\t\n   207\t    const report = await drain(sdk, filePath);\n   208\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   209\t      [\"w-m1-prompt_smoothing-v1\", \"failed_terminal\"],\n   210\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n   211\t    ]);\n   212\t\n   213\t    // Message-form gaps degrade the rendering's inputs; they do not fail\n   214\t    // the turn: ready, raw text composed, the gap a recorded fact.\n   215\t    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\n   216\t    expect(rendering?.state).toBe(\"ready\");\n   217\t    expect(rendering?.content).toContain(\"raw prompt one\");\n   218\t    expect(rendering?.gaps).toEqual([\n   219\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n   220\t    ]);\n","exit_code":0,"status":"completed"}}

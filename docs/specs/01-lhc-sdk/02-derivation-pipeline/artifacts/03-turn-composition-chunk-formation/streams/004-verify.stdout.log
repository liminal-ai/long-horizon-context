{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '180,380p'\"","aggregated_output":"   180\t  queued_at: string;\n   181\t  payload: string | null;\n   182\t}\n   183\t\n   184\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n   185\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n   186\t// v5, shared/storage.ts): the backfill created pending derived_form rows at\n   187\t// source version 1 for these kinds, and a terminal failure must find them —\n   188\t// otherwise exhaustion would delete the work row and strand the backfilled\n   189\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n   190\tconst LEGACY_KIND_FORMS: Partial<\n   191\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n   192\t> = {\n   193\t  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n   194\t  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n   195\t  turn_derivation: [\n   196\t    { subjectKind: \"turn\", form: \"turn_rendering\" },\n   197\t    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n   198\t  ],\n   199\t};\n   200\t\n   201\tfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n   202\t  const mapped = LEGACY_KIND_FORMS[kind];\n   203\t  if (mapped === undefined) return [];\n   204\t  const subjectId = sourceIdOf(sourceRef);\n   205\t  return mapped.map((target) => ({ ...target, subjectId }));\n   206\t}\n   207\t\n   208\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n   209\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n   210\t  const payload =\n   211\t    row.payload === null\n   212\t      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n   213\t        // reconstructed from the backfill's own mapping.\n   214\t        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n   215\t      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n   216\t  return {\n   217\t    workItemId: row.work_item_id,\n   218\t    owner: row.owner as WorkOwner,\n   219\t    kind: row.kind,\n   220\t    sourceRef,\n   221\t    attempts: Number(row.attempts),\n   222\t    queuedAt: row.queued_at,\n   223\t    sourceVersion: payload.sourceVersion ?? 1,\n   224\t    forms: payload.forms ?? [],\n   225\t  };\n   226\t}\n   227\t\n   228\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n   229\t// live row only — a later eligible row is never considered while an older\n   230\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n   231\t// write split: the race window is the bug class). The CASE increments\n   232\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n   233\t// run died or hung, and the increment makes the crash visible in the report\n   234\t// and counts it against the retry budget; normal claims never touch it.\n   235\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n   236\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n   237\t  db.exec(\"BEGIN IMMEDIATE;\");\n   238\t  try {\n   239\t    const claimed = db\n   240\t      .prepare(\n   241\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n   242\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n   243\t         WHERE work_item_id = (\n   244\t           SELECT work_item_id FROM (\n   245\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n   246\t             FROM work_item WHERE status IN ('queued', 'claimed')\n   247\t             ORDER BY rowid LIMIT 1\n   248\t           )\n   249\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n   250\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n   251\t         )\n   252\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n   253\t      )\n   254\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n   255\t    if (claimed !== undefined) {\n   256\t      db.exec(\"COMMIT;\");\n   257\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n   258\t    }\n   259\t    // No row claimable: re-read the head inside the same transaction to\n   260\t    // classify the stop. A claimed head with a live lease gates the queue\n   261\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n   262\t    // (waiting) — strict ordering, never reordered around the head.\n   263\t    const head = db\n   264\t      .prepare(\n   265\t        `SELECT status, eligible_at, claim_expires_at\n   266\t         FROM work_item WHERE status IN ('queued', 'claimed')\n   267\t         ORDER BY rowid LIMIT 1`,\n   268\t      )\n   269\t      .get() as unknown as\n   270\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n   271\t      | undefined;\n   272\t    db.exec(\"COMMIT;\");\n   273\t    if (head === undefined) return { outcome: \"empty\" };\n   274\t    if (head.status === \"claimed\") {\n   275\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n   276\t    }\n   277\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n   278\t  } catch (cause) {\n   279\t    db.exec(\"ROLLBACK;\");\n   280\t    throw cause;\n   281\t  }\n   282\t}\n   283\t\n   284\t// Completion: the version-checked form writes and the item row's deletion in\n   285\t// one short transaction (DD-1: terminal transition deletes the row; the\n   286\t// disposition is reported in-memory, never stored). UPDATE-only, never\n   287\t// upsert — the pending row exists from enqueue; a write that finds no row at\n   288\t// the item's source version is discarded as stale (DD-3 truth table). The\n   289\t// optional onApplied hook (Story 3) runs inside this same transaction, after\n   290\t// the form writes and only when they landed — chunk placement and the\n   291\t// close→summary enqueues ride the completion commit; its onCommit\n   292\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\n   293\texport function complete(\n   294\t  db: DatabaseSync,\n   295\t  item: ClaimedWorkItem,\n   296\t  writes: readonly HandlerFormWrite[],\n   297\t  derivedAt: string,\n   298\t  onApplied?: (tx: CompletionTx) => void,\n   299\t): \"done\" | \"stale_discarded\" {\n   300\t  const hooks = createCommitHooks();\n   301\t  db.exec(\"BEGIN IMMEDIATE;\");\n   302\t  try {\n   303\t    let hits = 0;\n   304\t    const update = db.prepare(\n   305\t      `UPDATE derived_form\n   306\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n   307\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   308\t    );\n   309\t    for (const write of writes) {\n   310\t      const changed = update.run(\n   311\t        write.content,\n   312\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n   313\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n   314\t        derivedAt,\n   315\t        write.subjectKind,\n   316\t        write.subjectId,\n   317\t        write.form,\n   318\t        item.sourceVersion,\n   319\t      );\n   320\t      hits += Number(changed.changes);\n   321\t    }\n   322\t    const stale = writes.length > 0 && hits === 0;\n   323\t    if (!stale && onApplied !== undefined) {\n   324\t      onApplied({ db, onCommit: hooks.register });\n   325\t    }\n   326\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   327\t    db.exec(\"COMMIT;\");\n   328\t    hooks.flush();\n   329\t    return stale ? \"stale_discarded\" : \"done\";\n   330\t  } catch (cause) {\n   331\t    db.exec(\"ROLLBACK;\");\n   332\t    throw cause;\n   333\t  }\n   334\t}\n   335\t\n   336\texport interface RetryPolicy {\n   337\t  budget: number;\n   338\t  backoffBaseMs: number;\n   339\t  backoffCapMs: number;\n   340\t}\n   341\t\n   342\texport type FailAttemptResult =\n   343\t  | { terminal: false; attempts: number; eligibleAt: string }\n   344\t  | { terminal: true; attempts: number };\n   345\t\n   346\t// Terminal failure: the form rows land `failed` (or `blocked` for source\n   347\t// damage) carrying the final reason plus attempts/last-error copied onto the\n   348\t// form's metadata, and the item row is deleted — one transaction (DD-1).\n   349\t// Form writes stay version-checked: if a mutation moved the source since this\n   350\t// item was queued, the stale failure must not stamp the rebuilt form.\n   351\texport function failTerminal(\n   352\t  db: DatabaseSync,\n   353\t  item: ClaimedWorkItem,\n   354\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n   355\t): void {\n   356\t  db.exec(\"BEGIN IMMEDIATE;\");\n   357\t  try {\n   358\t    const update = db.prepare(\n   359\t      `UPDATE derived_form\n   360\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n   361\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   362\t    );\n   363\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n   364\t    for (const target of item.forms) {\n   365\t      update.run(\n   366\t        opts.formState,\n   367\t        opts.reason,\n   368\t        metadata,\n   369\t        opts.now,\n   370\t        target.subjectKind,\n   371\t        target.subjectId,\n   372\t        target.form,\n   373\t        item.sourceVersion,\n   374\t      );\n   375\t    }\n   376\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   377\t    db.exec(\"COMMIT;\");\n   378\t  } catch (cause) {\n   379\t    db.exec(\"ROLLBACK;\");\n   380\t    throw cause;\n","exit_code":0,"status":"completed"}}

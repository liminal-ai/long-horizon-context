{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '180,330p'\"","aggregated_output":"   180\t\n   181\tfunction requireNonNegative(value: number, name: string): void {\n   182\t  if (!Number.isFinite(value) || value < 0) {\n   183\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   184\t  }\n   185\t}\n   186\t\n   187\t// The only assembly path: provider, mode, clock, and policy enter here.\n   188\t// Config mistakes are programmer errors at construction and throw; operating\n   189\t// failures after construction return OpResults per the error contract.\n   190\texport function createSdk(config: SdkConfig): Lhc {\n   191\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   192\t    throw new TypeError(\n   193\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   194\t    );\n   195\t  }\n   196\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   197\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   198\t  }\n   199\t  for (const operation of PROVIDER_OPERATIONS) {\n   200\t    if (typeof config.provider[operation] !== \"function\") {\n   201\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   202\t    }\n   203\t  }\n   204\t\n   205\t  const resolved: ResolvedSdkConfig = {\n   206\t    provider: config.provider,\n   207\t    mode: config.mode,\n   208\t    clock: config.clock ?? (() => new Date()),\n   209\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   210\t    lease: config.lease ?? { durationMs: 120000 },\n   211\t    chunkPolicy:\n   212\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   213\t  };\n   214\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   215\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   216\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   217\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   218\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   219\t  }\n   220\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   221\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   222\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   223\t    throw new TypeError(\n   224\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   225\t    );\n   226\t  }\n   227\t\n   228\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   229\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   230\t  // assembly mechanics are production code from day one.\n   231\t  const workHandlers = assembleWorkHandlerMap([\n   232\t    messagesDomain.workHandlers,\n   233\t    turnsDomain.workHandlers,\n   234\t  ]);\n   235\t\n   236\t  const drainDeps: DrainDeps = {\n   237\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   238\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   239\t    config: resolved,\n   240\t  };\n   241\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   242\t\n   243\t  // Background mode wires the scheduler into the process-wide seams: enqueue\n   244\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n   245\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n   246\t  // constructing a later background SDK supersedes an earlier one (the\n   247\t  // displaced scheduler's in-memory state was advisory — the rows remain).\n   248\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n   249\t  if (resolved.mode === \"background\") {\n   250\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   251\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   252\t  }\n   253\t\n   254\t  const work: WorkSurface = {\n   255\t    drain: async (ref, opts) => {\n   256\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   257\t      if (!resolvedRef.ok) return resolvedRef;\n   258\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   259\t    },\n   260\t  };\n   261\t\n   262\t  return {\n   263\t    threads: threadsDomain,\n   264\t    intakeStream: intakeStreamDomain,\n   265\t    messages: messagesDomain,\n   266\t    turns: turnsDomain,\n   267\t    config: resolved,\n   268\t    scheduler,\n   269\t    workHandlers,\n   270\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   271\t    work,\n   272\t    drainSettled: async (ref) => {\n   273\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   274\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   275\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   276\t      if (threadId === null) return;\n   277\t      return scheduler.drainSettled(threadId);\n   278\t    },\n   279\t  };\n   280\t}\n","exit_code":0,"status":"completed"}}

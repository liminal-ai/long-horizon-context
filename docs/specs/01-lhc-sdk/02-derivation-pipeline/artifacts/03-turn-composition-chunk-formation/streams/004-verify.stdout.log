{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/derivation-turns.test.ts | sed -n '220,440p'\"","aggregated_output":"   220\t    ]);\n   221\t    expect(formOf(filePath, \"t1\", \"lower_band_projection\")?.state).toBe(\"ready\");\n   222\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"failed\");\n   223\t  });\n   224\t});\n   225\t\n   226\tdescribe(\"TC-3.3 / AC-3.3 (architecture risk): gaps stand after dependency repair; only an explicit rebuild clears them\", () => {\n   227\t  it(\"repairing the smoothing changes nothing; re-queueing the rendering rebuilds it without the gap at the next source version\", async () => {\n   228\t    const double = createProviderDouble();\n   229\t    const sdk = manualSdk(double);\n   230\t    const filePath = await newThread();\n   231\t    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n   232\t    await sendTurn(sdk, filePath, \"gapped prompt\", \"gapped answer\");\n   233\t    await drain(sdk, filePath);\n   234\t    const gapped = formOf(filePath, \"t1\", \"turn_rendering\");\n   235\t    expect(gapped?.state).toBe(\"ready\");\n   236\t    expect(gapped?.gaps).toEqual([\n   237\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n   238\t    ]);\n   239\t    const placedBefore = readChunks(filePath);\n   240\t\n   241\t    // Leg 1: repair the failed smoothing through the queue util (now\n   242\t    // healthy — the script above is consumed). The dependent must not move:\n   243\t    // no live link, no auto-cascade, no queued turn work.\n   244\t    requeueDirect(filePath, {\n   245\t      owner: \"messages\",\n   246\t      kind: \"prompt_smoothing\",\n   247\t      sourceRef: { messageId: \"m1\" },\n   248\t      forms: [{ subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" }],\n   249\t    });\n   250\t    const repairReport = await drain(sdk, filePath);\n   251\t    expect(repairReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   252\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n   253\t    ]);\n   254\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"ready\");\n   255\t    // Byte-for-byte: the gapped rendering is exactly the row that landed —\n   256\t    // content, gaps, derivedAt, source version, all of it.\n   257\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")).toEqual(gapped);\n   258\t    expect(liveCount(filePath)).toBe(0);\n   259\t\n   260\t    // Leg 2: the explicit rebuild — turn_derivation re-queued at the next\n   261\t    // source version through the queue util. Gaps recompute from current\n   262\t    // dependency states: the smoothing is ready now, so the gap clears.\n   263\t    requeueDirect(filePath, {\n   264\t      owner: \"turns\",\n   265\t      kind: \"turn_derivation\",\n   266\t      sourceRef: { turnId: \"t1\" },\n   267\t      sourceVersion: 2,\n   268\t      forms: [\n   269\t        { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n   270\t        { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\" },\n   271\t      ],\n   272\t    });\n   273\t    const rebuildReport = await drain(sdk, filePath);\n   274\t    expect(rebuildReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   275\t      [\"w-t1-turn_derivation-v2\", \"done\"],\n   276\t    ]);\n   277\t    const rebuilt = formOf(filePath, \"t1\", \"turn_rendering\");\n   278\t    expect(rebuilt?.state).toBe(\"ready\");\n   279\t    expect(rebuilt?.sourceVersion).toBe(2);\n   280\t    expect(rebuilt?.gaps).toBeUndefined();\n   281\t    expect(rebuilt?.content).not.toBe(gapped?.content);\n   282\t    // Rebuild keeps placement: membership is never re-cut by derivation —\n   283\t    // the turn sits exactly where its first placement put it.\n   284\t    expect(readChunks(filePath)).toEqual(placedBefore);\n   285\t  });\n   286\t});\n   287\t\n   288\tdescribe(\"TC-3.4 / AC-3.4: tool runs compose as outcome-explicit accounts; a state-changing call's outcome survives\", () => {\n   289\t  it(\"a three-call edit run with one isError carries per-call outcomes into the composition input, from the forms\", async () => {\n   290\t    const double = createProviderDouble();\n   291\t    const captured = double.captureInputs();\n   292\t    const sdk = manualSdk(double);\n   293\t    const filePath = await newThread();\n   294\t    const call = (id: string, path: string) =>\n   295\t      validEvent(\"tool_call\", {\n   296\t        payload: { toolCallId: id, toolName: \"edit_file\", arguments: { path } },\n   297\t      });\n   298\t    const result = (id: string, content: string, isError: boolean) =>\n   299\t      validEvent(\"tool_result\", { payload: { toolCallId: id, content, isError } });\n   300\t    await send(sdk, filePath, [\n   301\t      validEvent(\"user_prompt\", { payload: { text: \"edit three files\" } }),\n   302\t      call(\"call-a\", \"a.txt\"),\n   303\t      result(\"call-a\", \"edited a.txt\", false),\n   304\t      call(\"call-b\", \"b.txt\"),\n   305\t      result(\"call-b\", \"permission denied\", true),\n   306\t      call(\"call-c\", \"c.txt\"),\n   307\t      result(\"call-c\", \"edited c.txt\", false),\n   308\t      validEvent(\"turn_end\"),\n   309\t    ]);\n   310\t\n   311\t    await drain(sdk, filePath);\n   312\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\n   313\t\n   314\t    const composed = captured.filter((entry) => entry.op === \"composeTurnRendering\");\n   315\t    expect(composed).toHaveLength(1);\n   316\t    const parts = (composed[0]?.input as { parts: RenderingPart[] }).parts;\n   317\t    expect(parts.map((part) => part.messageId)).toEqual([\n   318\t      \"m1\", \"m2\", \"m3\", \"m4\", \"m5\", \"m6\", \"m7\",\n   319\t    ]);\n   320\t    // The run's account is the consecutive tool parts in message order, each\n   321\t    // stating its outcome — the failed edit's outcome is present on both\n   322\t    // halves of its pair and cannot be lost in composition.\n   323\t    expect(parts.map((part) => part.outcome ?? null)).toEqual([\n   324\t      null,\n   325\t      \"succeeded\", \"succeeded\",\n   326\t      \"failed\", \"failed\",\n   327\t      \"succeeded\", \"succeeded\",\n   328\t    ]);\n   329\t    // Composition consumed the ready forms, not the raw record: every tool\n   330\t    // part's text is its summary form's stored content, verbatim.\n   331\t    for (const part of parts.slice(1)) {\n   332\t      expect(part.fallback).toBe(false);\n   333\t      expect(part.text).toBe(formOf(filePath, part.messageId, `${part.kind}_summary`)?.content);\n   334\t    }\n   335\t  });\n   336\t});\n   337\t\n   338\tdescribe(\"TC-3.5 / AC-3.5: placement is recorded with the turn and readable through turns\", () => {\n   339\t  it(\"draining a closed turn shows chunkId and memberIdx on the turn read-back\", async () => {\n   340\t    const double = createProviderDouble();\n   341\t    const sdk = manualSdk(double);\n   342\t    const filePath = await newThread();\n   343\t    await sendTurn(sdk, filePath, \"place me\", \"placed\");\n   344\t\n   345\t    await drain(sdk, filePath);\n   346\t    const turns = await sdk.turns.listTurns({ filePath });\n   347\t    expect(turns.ok).toBe(true);\n   348\t    if (!turns.ok) return;\n   349\t    expect(turns.value).toEqual([\n   350\t      expect.objectContaining({ turnId: \"t1\", status: \"closed\", chunkId: \"c1\", memberIdx: 0 }),\n   351\t    ]);\n   352\t  });\n   353\t});\n   354\t\n   355\tdescribe(\"TC-3.6 / AC-3.6 (architecture risk): the accumulated close rule — the crossing turn is excluded\", () => {\n   356\t  const PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n   357\t\n   358\t  it(\"three turns at ~equal size: the third's placement closes the chunk holding two, and the third opens chunk 2\", async () => {\n   359\t    const per = estimateTokens(PROJ);\n   360\t    const double = createProviderDouble();\n   361\t    const provider = withScriptedProjections(double, () => PROJ);\n   362\t    const sdk = manualSdk(provider, {\n   363\t      targetProjectedTokens: 2 * per + 1,\n   364\t      maxProjectedTokens: 100 * per,\n   365\t    });\n   366\t    const filePath = await newThread();\n   367\t    for (let i = 1; i <= 3; i += 1) await sendTurn(sdk, filePath, `prompt ${i}`, `answer ${i}`);\n   368\t\n   369\t    await drain(sdk, filePath);\n   370\t    const snapshot = readChunks(filePath);\n   371\t    expect(snapshot.chunks).toEqual([\n   372\t      { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: 2 * per },\n   373\t      { chunkId: \"c2\", chunkOrder: 2, status: \"open\", accumulatedProjectedTokens: per },\n   374\t    ]);\n   375\t    expect(snapshot.members).toEqual([\n   376\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n   377\t      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n   378\t      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n   379\t    ]);\n   380\t    // The close queued both summary kinds for c1 and the drain ran them;\n   381\t    // the still-open c2 has none.\n   382\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n   383\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n   384\t    expect(formOf(filePath, \"c2\", \"chunk_summary_detailed\")).toBeUndefined();\n   385\t    expect(liveCount(filePath)).toBe(0);\n   386\t  });\n   387\t\n   388\t  it(\"threshold exactness: accumulated + incoming equal to the target closes (inclusive), holding only the prior member\", async () => {\n   389\t    const per = estimateTokens(PROJ);\n   390\t    const double = createProviderDouble();\n   391\t    const provider = withScriptedProjections(double, () => PROJ);\n   392\t    const sdk = manualSdk(provider, {\n   393\t      targetProjectedTokens: 2 * per,\n   394\t      maxProjectedTokens: 100 * per,\n   395\t    });\n   396\t    const filePath = await newThread();\n   397\t    await sendTurn(sdk, filePath, \"first\", \"one\");\n   398\t    await sendTurn(sdk, filePath, \"second\", \"two\");\n   399\t\n   400\t    await drain(sdk, filePath);\n   401\t    const snapshot = readChunks(filePath);\n   402\t    expect(snapshot.members).toEqual([\n   403\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n   404\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n   405\t    ]);\n   406\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n   407\t      [\"c1\", \"closed\"],\n   408\t      [\"c2\", \"open\"],\n   409\t    ]);\n   410\t  });\n   411\t});\n   412\t\n   413\tdescribe(\"TC-3.7 / AC-3.7: a single projection at or above the max forms its own chunk, closed immediately\", () => {\n   414\t  const BIG = \"omega \".repeat(120).trim();\n   415\t\n   416\t  it(\"one oversized turn → its own closed chunk with both summaries derived\", async () => {\n   417\t    const big = estimateTokens(BIG);\n   418\t    const double = createProviderDouble();\n   419\t    const provider = withScriptedProjections(double, () => BIG);\n   420\t    const sdk = manualSdk(provider, {\n   421\t      targetProjectedTokens: big,\n   422\t      maxProjectedTokens: big,\n   423\t    });\n   424\t    const filePath = await newThread();\n   425\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n   426\t\n   427\t    await drain(sdk, filePath);\n   428\t    expect(readChunks(filePath)).toEqual({\n   429\t      chunks: [\n   430\t        { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: big },\n   431\t      ],\n   432\t      members: [{ chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 }],\n   433\t    });\n   434\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n   435\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n   436\t  });\n   437\t\n   438\t  it(\"an oversized turn arriving behind an open chunk closes both: the open chunk without it, its own chunk with it\", async () => {\n   439\t    const SMALL = \"tiny projection text\";\n   440\t    const big = estimateTokens(BIG);\n","exit_code":0,"status":"completed"}}

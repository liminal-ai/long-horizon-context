{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/forms.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n     2\t// source message and the call-id pairing reads — the only reach a\n     3\t// message-level handler has beyond its own message (AC-2.5). Also the\n     4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n     5\t// indexed query by call id, never a scan (the v5 expression index on\n     6\t// message_block covers it) and never a drain-time sweep or read-time join.\n     7\t// Completion writes for message forms ride the work-queue util's `complete`\n     8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n     9\t// Read-back of message-owned form rows (the listMessages join) also lives\n    10\t// here: stored state returned as stored — never re-derived on read.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport type {\n    13\t  DependencyGap,\n    14\t  DerivedForm,\n    15\t  DerivedFormMetadata,\n    16\t  DerivedFormState,\n    17\t  FormKind,\n    18\t} from \"../../../shared/derivation.js\";\n    19\t\n    20\texport interface MessageSource {\n    21\t  messageId: string;\n    22\t  kind: string;\n    23\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    24\t}\n    25\t\n    26\texport function readMessageSource(\n    27\t  db: DatabaseSync,\n    28\t  messageId: string,\n    29\t): MessageSource | undefined {\n    30\t  const row = db\n    31\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    32\t    .get(messageId) as unknown as { kind: string } | undefined;\n    33\t  if (row === undefined) return undefined;\n    34\t  const blocks = db\n    35\t    .prepare(\n    36\t      `SELECT block_type, content FROM message_block\n    37\t       WHERE message_id = ? ORDER BY block_index`,\n    38\t    )\n    39\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n    40\t  return {\n    41\t    messageId,\n    42\t    kind: row.kind,\n    43\t    blocks: blocks.map((block) => ({\n    44\t      blockType: block.block_type,\n    45\t      content: JSON.parse(block.content) as Record<string, unknown>,\n    46\t    })),\n    47\t  };\n    48\t}\n    49\t\n    50\tinterface RawFormRow {\n    51\t  subject_id: string;\n    52\t  form: string;\n    53\t  state: string;\n    54\t  content: string | null;\n    55\t  reason: string | null;\n    56\t  metadata: string | null;\n    57\t  source_version: number | bigint;\n    58\t  gaps: string | null;\n    59\t  derived_at: string | null;\n    60\t}\n    61\t\n    62\t// Every message-owned derived-form row, grouped by message id — the form\n    63\t// read-back joined onto message reads (AC-2.1's \"readable alongside the\n    64\t// message\"). Rows come back exactly as the queue landed them: state, content,\n    65\t// reason, mechanically stamped metadata; nothing is derived at read time.\n    66\texport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n    67\t  const rows = db\n    68\t    .prepare(\n    69\t      `SELECT subject_id, form, state, content, reason, metadata,\n    70\t              source_version, gaps, derived_at\n    71\t       FROM derived_form WHERE subject_kind = 'message'\n    72\t       ORDER BY subject_id, form`,\n    73\t    )\n    74\t    .all() as unknown as RawFormRow[];\n    75\t  const byMessage = new Map<string, DerivedForm[]>();\n    76\t  for (const row of rows) {\n    77\t    const record: DerivedForm = {\n    78\t      subjectKind: \"message\",\n    79\t      subjectId: row.subject_id,\n    80\t      form: row.form as FormKind,\n    81\t      state: row.state as DerivedFormState,\n    82\t      sourceVersion: Number(row.source_version),\n    83\t    };\n    84\t    if (row.content !== null) record.content = row.content;\n    85\t    if (row.reason !== null) record.reason = row.reason;\n    86\t    if (row.metadata !== null) {\n    87\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    88\t    }\n    89\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    90\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    91\t    const forms = byMessage.get(row.subject_id) ?? [];\n    92\t    forms.push(record);\n    93\t    byMessage.set(row.subject_id, forms);\n    94\t  }\n    95\t  return byMessage;\n    96\t}\n    97\t\n    98\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n    99\t// ever repeated; in a well-formed record the pair is unique.\n   100\tfunction findPairedBlock(\n   101\t  db: DatabaseSync,\n   102\t  blockType: \"tool_call\" | \"tool_result\",\n   103\t  toolCallId: string,\n   104\t): Record<string, unknown> | undefined {\n   105\t  const row = db\n   106\t    .prepare(\n   107\t      `SELECT b.content FROM message_block b\n   108\t       JOIN message m ON m.message_id = b.message_id\n   109\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n   110\t       ORDER BY m.source_event_order LIMIT 1`,\n   111\t    )\n   112\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n   113\t  if (row === undefined) return undefined;\n   114\t  return JSON.parse(row.content) as Record<string, unknown>;\n   115\t}\n   116\t\n   117\texport function findPairedToolResult(\n   118\t  db: DatabaseSync,\n   119\t  toolCallId: string,\n   120\t): { content: string; isError: boolean } | undefined {\n   121\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n   122\t  if (block === undefined) return undefined;\n   123\t  return {\n   124\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n   125\t    isError: block[\"isError\"] === true,\n   126\t  };\n   127\t}\n   128\t\n   129\texport function findPairedToolCall(\n   130\t  db: DatabaseSync,\n   131\t  toolCallId: string,\n   132\t): { toolName: string } | undefined {\n   133\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n   134\t  if (block === undefined) return undefined;\n   135\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n   136\t}\n   137\t\n   138\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n   139\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n   140\t// common case — call and result in one batch, summary not yet run — never\n   141\t// triggers a requeue. Returns the call's message id and the form's current\n   142\t// source version (the requeue enqueues at version + 1: the pair is the\n   143\t// summary's source, and a source completing follows clear-and-regenerate).\n   144\texport function findUnknownOutcomeCallSummary(\n   145\t  db: DatabaseSync,\n   146\t  toolCallId: string,\n   147\t): { messageId: string; sourceVersion: number } | undefined {\n   148\t  const row = db\n   149\t    .prepare(\n   150\t      `SELECT df.subject_id, df.source_version FROM message_block b\n   151\t       JOIN derived_form df ON df.subject_kind = 'message'\n   152\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n   153\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n   154\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n   155\t       LIMIT 1`,\n   156\t    )\n   157\t    .get(toolCallId) as unknown as\n   158\t    | { subject_id: string; source_version: number | bigint }\n   159\t    | undefined;\n   160\t  if (row === undefined) return undefined;\n   161\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n   162\t}\n","exit_code":0,"status":"completed"}}

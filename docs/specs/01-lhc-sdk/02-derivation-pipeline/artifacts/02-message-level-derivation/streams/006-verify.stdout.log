{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '1,230p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport type { OperationContext } from \"../../shared/context.js\";\n     3\timport type { FormKind, WorkHandler } from \"../../shared/derivation.js\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     5\timport {\n     6\t  enqueue,\n     7\t  listItems,\n     8\t  type WorkItemRecord,\n     9\t  type WorkKind,\n    10\t} from \"../../tech-utils/work-queue/index.js\";\n    11\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    12\timport {\n    13\t  openThreadDatabase,\n    14\t  resolveThreadRef,\n    15\t  type ThreadRef,\n    16\t} from \"../threads/index.js\";\n    17\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    18\timport { findUnknownOutcomeCallSummary, readMessageForms } from \"./internal/forms.js\";\n    19\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n    20\timport { projectEvent } from \"./internal/project.js\";\n    21\timport { insertMessage, readMessages } from \"./internal/store.js\";\n    22\t\n    23\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    24\t\n    25\texport interface Block {\n    26\t  blockType: BlockType;\n    27\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    28\t}\n    29\t\n    30\texport interface MessageRecord {\n    31\t  messageId: string;\n    32\t  sourceEventOrder: number;\n    33\t  kind: Exclude<EventKind, \"turn_end\">;\n    34\t  blocks: Block[];\n    35\t  tokenEstimate: number;\n    36\t  actor: string;\n    37\t  harness: string;\n    38\t  turnId?: string;\n    39\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n    40\t  // for messages that are derivation sources — kinds with no derivable form\n    41\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n    42\t  // never re-derived on read.\n    43\t  forms?: DerivedForm[];\n    44\t}\n    45\t\n    46\t// The event as the walk holds it after recording: the validated input plus\n    47\t// its server-stamped order and timestamp.\n    48\texport type RecordedEvent = EventRecord;\n    49\t\n    50\texport type MessageCreated = {\n    51\t  messageId: string;\n    52\t  kind: Exclude<EventKind, \"turn_end\">;\n    53\t  // Carried for tool activity only: the pairing key the queue sites need —\n    54\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n    55\t  toolCallId?: string;\n    56\t} | null;\n    57\t\n    58\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    59\t// (the first such call through the operation context; turns.applyEvent\n    60\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    61\t// projection failure propagates to the pipeline's catch and rejects the\n    62\t// whole batch — recorded events without messages is the stranded state the\n    63\t// transaction exists to prevent. Returns null for turn_end (no message).\n    64\t// turnId is the membership stamp, settled by the pipeline before this call:\n    65\t// the turn open *after* this event's transition (so a prompt belongs to the\n    66\t// turn it just opened), or null in a gap — written once, never updated.\n    67\texport function createFromEvent(\n    68\t  ctx: OperationContext,\n    69\t  event: RecordedEvent,\n    70\t  turnId: string | null,\n    71\t): MessageCreated {\n    72\t  const projected = projectEvent(event);\n    73\t  if (projected === null) return null;\n    74\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    75\t  const messageId = `m${event.eventOrder}`;\n    76\t  insertMessage(ctx.db, {\n    77\t    messageId,\n    78\t    sourceEventOrder: event.eventOrder,\n    79\t    kind,\n    80\t    tokenEstimate: projected.tokenEstimate,\n    81\t    actor: event.actor,\n    82\t    harness: event.harness,\n    83\t    turnId,\n    84\t    blocks: projected.blocks,\n    85\t  });\n    86\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n    87\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n    88\t  }\n    89\t  return { messageId, kind };\n    90\t}\n    91\t\n    92\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n    93\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n    94\t// tool result queues tool_result_summary, nothing else queues anything —\n    95\t// text, thinking, and note messages are not derivation sources (Epic 01\n    96\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n    97\t// intake-stream inside the batch transaction for every recorded message, so\n    98\t// the item commits (or rolls back) with the batch.\n    99\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   100\t  user_prompt: \"prompt_smoothing\",\n   101\t  tool_call: \"tool_call_summary\",\n   102\t  tool_result: \"tool_result_summary\",\n   103\t};\n   104\t\n   105\t// Which derived form each message-owned kind produces — the owning domain's\n   106\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   107\t// rides the same transaction (DD-5).\n   108\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n   109\t  prompt_smoothing: \"smoothed_prompt\",\n   110\t  tool_call_summary: \"tool_call_summary\",\n   111\t  tool_result_summary: \"tool_result_summary\",\n   112\t};\n   113\t\n   114\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   115\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n   116\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   117\t  messageWorkHandlers;\n   118\t\n   119\texport function queueMessageWork(\n   120\t  ctx: OperationContext,\n   121\t  message: MessageCreated,\n   122\t): WorkItemRecord[] {\n   123\t  if (message === null) return [];\n   124\t  const items: WorkItemRecord[] = [];\n   125\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   126\t  if (kind !== undefined) {\n   127\t    const form = MESSAGE_WORK_FORMS[kind];\n   128\t    if (form === undefined) {\n   129\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   130\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   131\t    }\n   132\t    items.push(\n   133\t      enqueue(ctx, {\n   134\t        owner: \"messages\",\n   135\t        kind,\n   136\t        sourceRef: { messageId: message.messageId },\n   137\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n   138\t      }),\n   139\t    );\n   140\t  }\n   141\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n   142\t  // summary already derived with outcome \"unknown\" means the summary's\n   143\t  // source — the call+result pair — completed underneath it; clear and\n   144\t  // regenerate at the next source version, in this same batch transaction.\n   145\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n   146\t  // the common call-and-result-in-one-batch case never triggers, and the\n   147\t  // version-scoped item id keeps the requeue idempotent.\n   148\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n   149\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n   150\t    if (stale !== undefined) {\n   151\t      items.push(\n   152\t        enqueue(ctx, {\n   153\t          owner: \"messages\",\n   154\t          kind: \"tool_call_summary\",\n   155\t          sourceRef: { messageId: stale.messageId },\n   156\t          sourceVersion: stale.sourceVersion + 1,\n   157\t          forms: [\n   158\t            {\n   159\t              subjectKind: \"message\",\n   160\t              subjectId: stale.messageId,\n   161\t              form: \"tool_call_summary\",\n   162\t            },\n   163\t          ],\n   164\t        }),\n   165\t      );\n   166\t    }\n   167\t  }\n   168\t  return items;\n   169\t}\n   170\t\n   171\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   172\t  return {\n   173\t    ok: false,\n   174\t    error: {\n   175\t      errorClass: \"caller_error\",\n   176\t      code: \"thread_not_found\",\n   177\t      reason: `no thread file exists at ${filePath}`,\n   178\t    },\n   179\t  };\n   180\t}\n   181\t\n   182\texport async function listMessages(\n   183\t  thread: ThreadRef,\n   184\t): Promise<OpResult<MessageRecord[]>> {\n   185\t  const resolved = await resolveThreadRef(thread);\n   186\t  if (!resolved.ok) return resolved;\n   187\t  const { filePath } = resolved.value;\n   188\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   189\t\n   190\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   191\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   192\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   193\t  // unmutated (F-03-002).\n   194\t  const opened = openThreadDatabase(filePath);\n   195\t  if (!opened.ok) return opened;\n   196\t  const db = opened.value;\n   197\t  try {\n   198\t    // Form read-back rides the message read (AC-2.1): each record carries\n   199\t    // its stored derived forms, attached from one grouped query — the\n   200\t    // production path for \"readable alongside the message\".\n   201\t    const formsByMessage = readMessageForms(db);\n   202\t    const records = readMessages(db).map((record) => {\n   203\t      const forms = formsByMessage.get(record.messageId);\n   204\t      return forms === undefined ? record : { ...record, forms };\n   205\t    });\n   206\t    return { ok: true, value: records };\n   207\t  } catch (cause) {\n   208\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   209\t    return storageFailure(`message read-back failed: ${reason}`);\n   210\t  } finally {\n   211\t    db.close();\n   212\t  }\n   213\t}\n   214\t\n   215\texport async function listQueuedWork(\n   216\t  thread: ThreadRef,\n   217\t): Promise<OpResult<WorkItemRecord[]>> {\n   218\t  const resolved = await resolveThreadRef(thread);\n   219\t  if (!resolved.ok) return resolved;\n   220\t  const { filePath } = resolved.value;\n   221\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   222\t\n   223\t  const opened = openThreadDatabase(filePath);\n   224\t  if (!opened.ok) return opened;\n   225\t  const db = opened.value;\n   226\t  try {\n   227\t    return { ok: true, value: listItems(db, \"messages\") };\n   228\t  } catch (cause) {\n   229\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   230\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n","exit_code":0,"status":"completed"}}

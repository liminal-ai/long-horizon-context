{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/storage.ts | sed -n '30,50p'\"","aggregated_output":"    30\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n    31\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n    32\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n    33\t  // inside an index definition, so the index covers the two real columns and\n    34\t  // claimNext's ORDER BY rowid walks the head as before.\n    35\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n    36\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n    37\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\n    38\t  // call id — never a block scan (anti-shim requirement).\n    39\t  `CREATE INDEX idx_message_block_tool_call_id\n    40\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n    41\t  `CREATE TABLE derived_form (\n    42\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    43\t    subject_id   TEXT NOT NULL,\n    44\t    form         TEXT NOT NULL,\n    45\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    46\t    content      TEXT,\n    47\t    reason       TEXT,\n    48\t    metadata     TEXT,\n    49\t    source_version INTEGER NOT NULL DEFAULT 1,\n    50\t    gaps         TEXT,\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/derivation-messages.test.ts | sed -n '70,360p'\"","aggregated_output":"    70\t  return result.value;\n    71\t}\n    72\t\n    73\tfunction liveCount(filePath: string): number {\n    74\t  const db = openRaw(filePath);\n    75\t  try {\n    76\t    return countLiveItems(db);\n    77\t  } finally {\n    78\t    db.close();\n    79\t  }\n    80\t}\n    81\t\n    82\tfunction formOf(filePath: string, subjectId: string, form: string) {\n    83\t  return readDerivedForms(filePath).find(\n    84\t    (f) => f.subjectId === subjectId && f.form === form,\n    85\t  );\n    86\t}\n    87\t\n    88\tdescribe(\"TC-2.1 / AC-2.1: prompt smoothing lands a ready form readable alongside the message\", () => {\n    89\t  it(\"intake a prompt, drain → smoothed form ready with the double's deterministic output\", async () => {\n    90\t    const double = createProviderDouble();\n    91\t    const sdk = manualSdk(double);\n    92\t    const filePath = await newThread();\n    93\t    const text = \"please smooth this prompt\";\n    94\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text } })]);\n    95\t\n    96\t    const report = await drain(sdk, filePath);\n    97\t    expect(report.ran).toEqual([\n    98\t      expect.objectContaining({\n    99\t        workItemId: \"w-m1-prompt_smoothing-v1\",\n   100\t        disposition: \"done\",\n   101\t      }),\n   102\t    ]);\n   103\t\n   104\t    const form = formOf(filePath, \"m1\", \"smoothed_prompt\");\n   105\t    expect(form?.state).toBe(\"ready\");\n   106\t    // The content is the double's pure function of the prompt text — the\n   107\t    // production smoothPrompt input shape, nothing else mixed in.\n   108\t    expect(form?.content).toBe(deterministicText(\"smoothPrompt\", { text }, text));\n   109\t\n   110\t    // Readable alongside the message: the record itself is untouched.\n   111\t    const listed = await sdk.messages.listMessages({ filePath });\n   112\t    expect(listed.ok).toBe(true);\n   113\t    if (!listed.ok) return;\n   114\t    expect(listed.value[0]?.blocks[0]?.content[\"text\"]).toBe(text);\n   115\t  });\n   116\t});\n   117\t\n   118\tdescribe(\"TC-2.2 / AC-2.2: tool_call queues its summary additively; intake returns before any handler runs\", () => {\n   119\t  it(\"the batch reports the queued item with the capture log still empty; the drained summary names tool and args\", async () => {\n   120\t    const double = createProviderDouble();\n   121\t    const captured = double.captureInputs();\n   122\t    const sdk = manualSdk(double);\n   123\t    const filePath = await newThread();\n   124\t\n   125\t    const batch = await send(sdk, filePath, [validEvent(\"tool_call\")]);\n   126\t    // Hot-path NFR made testable: the intake result is in hand and the\n   127\t    // provider has never been called — queueing and derivation are decoupled\n   128\t    // in time, not just in code.\n   129\t    expect(captured).toHaveLength(0);\n   130\t    expect(batch.queuedWork).toEqual([\n   131\t      {\n   132\t        workItemId: \"w-m1-tool_call_summary-v1\",\n   133\t        owner: \"messages\",\n   134\t        kind: \"tool_call_summary\",\n   135\t        sourceRef: { messageId: \"m1\" },\n   136\t      },\n   137\t    ]);\n   138\t\n   139\t    const report = await drain(sdk, filePath);\n   140\t    expect(report.ran).toEqual([\n   141\t      expect.objectContaining({\n   142\t        workItemId: \"w-m1-tool_call_summary-v1\",\n   143\t        disposition: \"done\",\n   144\t      }),\n   145\t    ]);\n   146\t    const form = formOf(filePath, \"m1\", \"tool_call_summary\");\n   147\t    expect(form?.state).toBe(\"ready\");\n   148\t    // Names the tool and describes its arguments (fixture default payload).\n   149\t    expect(form?.content).toContain(\"read_file\");\n   150\t    expect(form?.content).toContain('{\"path\":\"notes.txt\"}');\n   151\t    // No paired result intaken: outcome stamped unknown, in metadata.\n   152\t    expect(form?.metadata).toEqual({ outcome: \"unknown\" });\n   153\t  });\n   154\t});\n   155\t\n   156\tdescribe(\"TC-2.3 / AC-2.3: the result summary abbreviates; the full content stays byte-identical in the record\", () => {\n   157\t  it(\"a 300KB result drains to a bounded summary and reads back whole through the Epic 01 surface\", async () => {\n   158\t    const big = \"result-bytes \".repeat(24000); // ~300KB\n   159\t    const double = createProviderDouble();\n   160\t    const sdk = manualSdk(double);\n   161\t    const { filePath } = await threadWithToolRun(store, { resultContent: big });\n   162\t\n   163\t    await drain(sdk, filePath);\n   164\t    const summary = formOf(filePath, \"m3\", \"tool_result_summary\");\n   165\t    expect(summary?.state).toBe(\"ready\");\n   166\t    expect(summary?.content?.startsWith(\"toolresult(\")).toBe(true);\n   167\t    // Summarized means abbreviated: marker + digest + 40-char prefix.\n   168\t    expect(summary?.content?.length ?? 0).toBeLessThan(100);\n   169\t    expect(summary?.metadata).toEqual({ outcome: \"succeeded\" });\n   170\t\n   171\t    const listed = await sdk.messages.listMessages({ filePath });\n   172\t    expect(listed.ok).toBe(true);\n   173\t    if (!listed.ok) return;\n   174\t    const resultMessage = listed.value.find((m) => m.kind === \"tool_result\");\n   175\t    expect(resultMessage?.blocks[0]?.content[\"content\"]).toBe(big);\n   176\t  });\n   177\t});\n   178\t\n   179\tdescribe(\"TC-2.4 / AC-2.4 (architecture risk): outcome is stamped from the record, never from provider text\", () => {\n   180\t  it(\"three variants with identical provider text land succeeded / failed / unknown from metadata alone\", async () => {\n   181\t    // The identical-text fixture: summarizeToolCall returns one constant\n   182\t    // string no matter the input, at the same production seam. If any code\n   183\t    // path inferred outcome from text, all three variants would agree.\n   184\t    const constantText = \"the tool was invoked with some arguments\";\n   185\t    const double = createProviderDouble();\n   186\t    const provider: DerivationProvider = {\n   187\t      smoothPrompt: (i) => double.smoothPrompt(i),\n   188\t      summarizeToolCall: () => Promise.resolve({ ok: true, text: constantText }),\n   189\t      summarizeToolResult: (i) => double.summarizeToolResult(i),\n   190\t      composeTurnRendering: (i) => double.composeTurnRendering(i),\n   191\t      projectLowerBand: (i) => double.projectLowerBand(i),\n   192\t      summarizeChunkDetailed: (i) => double.summarizeChunkDetailed(i),\n   193\t      summarizeChunkBrief: (i) => double.summarizeChunkBrief(i),\n   194\t    };\n   195\t    const sdk = manualSdk(provider);\n   196\t\n   197\t    const ok = await threadWithToolRun(store);\n   198\t    const errored = await threadWithToolRun(store, { isError: true });\n   199\t    const missing = await threadWithToolRun(store, { missingResult: true });\n   200\t    for (const { filePath } of [ok, errored, missing]) await drain(sdk, filePath);\n   201\t\n   202\t    const summaries = [ok, errored, missing].map(({ filePath }) =>\n   203\t      formOf(filePath, \"m2\", \"tool_call_summary\"),\n   204\t    );\n   205\t    expect(summaries.map((f) => f?.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n   206\t    // Text identical across all three…\n   207\t    expect(summaries.map((f) => f?.content)).toEqual([\n   208\t      constantText,\n   209\t      constantText,\n   210\t      constantText,\n   211\t    ]);\n   212\t    // …while the outcome differs, read from metadata — machine-readable\n   213\t    // apart from the provider's prose, which mentions no outcome at all.\n   214\t    expect(summaries.map((f) => f?.metadata?.outcome)).toEqual([\n   215\t      \"succeeded\",\n   216\t      \"failed\",\n   217\t      \"unknown\",\n   218\t    ]);\n   219\t  });\n   220\t});\n   221\t\n   222\tdescribe(\"TC-2.5 / AC-2.5: message-level input discipline — the message and its call-id pair only\", () => {\n   223\t  it(\"the captured tool-call summary input is exactly the call plus its paired result\", async () => {\n   224\t    const double = createProviderDouble();\n   225\t    const captured = double.captureInputs();\n   226\t    const sdk = manualSdk(double);\n   227\t    const { filePath } = await threadWithToolRun(store);\n   228\t\n   229\t    await drain(sdk, filePath);\n   230\t    const inputs = captured.filter((entry) => entry.op === \"summarizeToolCall\");\n   231\t    expect(inputs).toHaveLength(1);\n   232\t    // Exact equality: no turn ids, no membership, no chunk context — the\n   233\t    // production seam receives the pair and nothing else.\n   234\t    expect(inputs[0]?.input).toEqual({\n   235\t      toolName: \"read_file\",\n   236\t      argsJson: '{\"path\":\"notes.txt\"}',\n   237\t      pairedResult: { content: \"contents of notes.txt\", isError: false },\n   238\t    });\n   239\t  });\n   240\t});\n   241\t\n   242\tdescribe(\"TC-2.6 / AC-2.6: provider exhaustion lands the form failed; the message stays readable\", () => {\n   243\t  it(\"smoothing exhausts the retry budget → form failed with the provider's reason; read-back unaffected\", async () => {\n   244\t    const double = createProviderDouble();\n   245\t    const sdk = manualSdk(double);\n   246\t    const filePath = await newThread();\n   247\t    const text = \"this prompt will never smooth\";\n   248\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text } })]);\n   249\t\n   250\t    double.failKind(\"prompt_smoothing\", 99, {\n   251\t      retryable: true,\n   252\t      reason: \"scripted exhaustion (smoothPrompt)\",\n   253\t    });\n   254\t    const report = await drain(sdk, filePath);\n   255\t    expect(report.ran).toEqual([\n   256\t      expect.objectContaining({\n   257\t        workItemId: \"w-m1-prompt_smoothing-v1\",\n   258\t        disposition: \"failed_terminal\",\n   259\t        attempts: 3,\n   260\t        reason: \"scripted exhaustion (smoothPrompt)\",\n   261\t      }),\n   262\t    ]);\n   263\t\n   264\t    const form = formOf(filePath, \"m1\", \"smoothed_prompt\");\n   265\t    expect(form?.state).toBe(\"failed\");\n   266\t    expect(form?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n   267\t    expect(form?.content).toBeUndefined();\n   268\t\n   269\t    const listed = await sdk.messages.listMessages({ filePath });\n   270\t    expect(listed.ok).toBe(true);\n   271\t    if (!listed.ok) return;\n   272\t    expect(listed.value).toHaveLength(1);\n   273\t    expect(listed.value[0]?.blocks[0]?.content[\"text\"]).toBe(text);\n   274\t  });\n   275\t});\n   276\t\n   277\tdescribe(\"TC-2.7 / AC-2.7: kinds with no derivable form queue no work and carry no state rows\", () => {\n   278\t  it(\"assistant text and a runtime note: no items, no derivation rows, an empty drain\", async () => {\n   279\t    const double = createProviderDouble();\n   280\t    const sdk = manualSdk(double);\n   281\t    const filePath = await newThread();\n   282\t\n   283\t    const batch = await send(sdk, filePath, [\n   284\t      validEvent(\"assistant_text\"),\n   285\t      validEvent(\"runtime_note\"),\n   286\t    ]);\n   287\t    expect(batch.queuedWork).toEqual([]);\n   288\t    expect(liveCount(filePath)).toBe(0);\n   289\t\n   290\t    const report = await drain(sdk, filePath);\n   291\t    expect(report.ran).toEqual([]);\n   292\t    expect(report.stoppedBecause).toBe(\"empty\");\n   293\t    expect(readDerivedForms(filePath)).toEqual([]);\n   294\t  });\n   295\t});\n   296\t\n   297\tdescribe(\"TC-2.8 / AC-2.8 (architecture risk): a late result re-queues an unknown-outcome summary at intake\", () => {\n   298\t  it(\"split batches: the result's intake re-queues the summary; the repair is a real queue round-trip\", async () => {\n   299\t    const double = createProviderDouble();\n   300\t    const sdk = manualSdk(double);\n   301\t    const filePath = await newThread();\n   302\t\n   303\t    // Batch 1: the call alone. Its summary derives with no pair in sight.\n   304\t    await send(sdk, filePath, [validEvent(\"tool_call\")]);\n   305\t    await drain(sdk, filePath);\n   306\t    const before = formOf(filePath, \"m1\", \"tool_call_summary\");\n   307\t    expect(before?.state).toBe(\"ready\");\n   308\t    expect(before?.metadata).toEqual({ outcome: \"unknown\" });\n   309\t    expect(before?.sourceVersion).toBe(1);\n   310\t\n   311\t    // Batch 2: the paired result lands later. The intake result itself\n   312\t    // reports the re-queued summary — repair is intake-time and visible,\n   313\t    // not a read-time join.\n   314\t    const batch = await send(sdk, filePath, [validEvent(\"tool_result\")]);\n   315\t    expect(batch.queuedWork).toContainEqual({\n   316\t      workItemId: \"w-m2-tool_result_summary-v1\",\n   317\t      owner: \"messages\",\n   318\t      kind: \"tool_result_summary\",\n   319\t      sourceRef: { messageId: \"m2\" },\n   320\t    });\n   321\t    expect(batch.queuedWork).toContainEqual({\n   322\t      workItemId: \"w-m1-tool_call_summary-v2\",\n   323\t      owner: \"messages\",\n   324\t      kind: \"tool_call_summary\",\n   325\t      sourceRef: { messageId: \"m1\" },\n   326\t    });\n   327\t    // The clear half of clear-and-regenerate rode the batch transaction.\n   328\t    const cleared = formOf(filePath, \"m1\", \"tool_call_summary\");\n   329\t    expect(cleared?.state).toBe(\"pending\");\n   330\t    expect(cleared?.sourceVersion).toBe(2);\n   331\t\n   332\t    const report = await drain(sdk, filePath);\n   333\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   334\t      [\"w-m2-tool_result_summary-v1\", \"done\"],\n   335\t      [\"w-m1-tool_call_summary-v2\", \"done\"],\n   336\t    ]);\n   337\t\n   338\t    // One summary form, outcome repaired, source version advanced — the\n   339\t    // proof the artifact was re-derived through the queue, not patched.\n   340\t    const summaries = readDerivedForms(filePath).filter(\n   341\t      (f) => f.form === \"tool_call_summary\",\n   342\t    );\n   343\t    expect(summaries).toHaveLength(1);\n   344\t    expect(summaries[0]).toMatchObject({\n   345\t      subjectId: \"m1\",\n   346\t      state: \"ready\",\n   347\t      sourceVersion: 2,\n   348\t      metadata: { outcome: \"succeeded\" },\n   349\t    });\n   350\t    expect(liveCount(filePath)).toBe(0);\n   351\t  });\n   352\t\n   353\t  it(\"control: call and result in one batch never trigger the re-queue; the summary runs exactly once\", async () => {\n   354\t    const double = createProviderDouble();\n   355\t    const captured = double.captureInputs();\n   356\t    const sdk = manualSdk(double);\n   357\t    const filePath = await newThread();\n   358\t\n   359\t    const batch = await send(sdk, filePath, [\n   360\t      validEvent(\"tool_call\"),\n","exit_code":0,"status":"completed"}}

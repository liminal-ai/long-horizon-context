{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/derivation-messages.test.ts | sed -n '353,390p'\"","aggregated_output":"   353\t  it(\"control: call and result in one batch never trigger the re-queue; the summary runs exactly once\", async () => {\n   354\t    const double = createProviderDouble();\n   355\t    const captured = double.captureInputs();\n   356\t    const sdk = manualSdk(double);\n   357\t    const filePath = await newThread();\n   358\t\n   359\t    const batch = await send(sdk, filePath, [\n   360\t      validEvent(\"tool_call\"),\n   361\t      validEvent(\"tool_result\"),\n   362\t    ]);\n   363\t    const summaryItems = batch.queuedWork.filter((item) => item.kind === \"tool_call_summary\");\n   364\t    expect(summaryItems.map((item) => item.workItemId)).toEqual([\n   365\t      \"w-m1-tool_call_summary-v1\",\n   366\t    ]);\n   367\t\n   368\t    await drain(sdk, filePath);\n   369\t    // The capture log proves the summary ran once — after both halves of its\n   370\t    // pair landed, so it saw the result and stamped succeeded directly.\n   371\t    expect(captured.filter((entry) => entry.op === \"summarizeToolCall\")).toHaveLength(1);\n   372\t    const form = formOf(filePath, \"m1\", \"tool_call_summary\");\n   373\t    expect(form).toMatchObject({\n   374\t      state: \"ready\",\n   375\t      sourceVersion: 1,\n   376\t      metadata: { outcome: \"succeeded\" },\n   377\t    });\n   378\t    expect(liveCount(filePath)).toBe(0);\n   379\t  });\n   380\t});\n","exit_code":0,"status":"completed"}}

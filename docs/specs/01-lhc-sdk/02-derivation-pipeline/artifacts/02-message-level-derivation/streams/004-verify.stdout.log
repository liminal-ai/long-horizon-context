{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/outcome.ts | sed -n '1,80p'\"","aggregated_output":"     1\t// Mechanical ToolOutcome stamping (AC-2.4): the outcome on a tool-activity\n     2\t// summary is a pure function of the record — paired-result presence and its\n     3\t// isError flag — and nothing else. The signature takes no provider text on\n     4\t// purpose (anti-shim: the violation is unrepresentable); the handler stamps\n     5\t// the returned value into derived_form.metadata, apart from provider prose.\n     6\timport type { ToolOutcome } from \"../../../shared/derivation.js\";\n     7\t\n     8\texport function deriveToolOutcome(\n     9\t  pairedResult: { isError: boolean } | undefined,\n    10\t): ToolOutcome {\n    11\t  if (pairedResult === undefined) return \"unknown\";\n    12\t  return pairedResult.isError ? \"failed\" : \"succeeded\";\n    13\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/forms.ts | sed -n '1,170p'\"","aggregated_output":"     1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n     2\t// source message and the call-id pairing reads — the only reach a\n     3\t// message-level handler has beyond its own message (AC-2.5). Also the\n     4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n     5\t// indexed query by call id, never a scan (the v5 expression index on\n     6\t// message_block covers it) and never a drain-time sweep or read-time join.\n     7\t// Completion writes for message forms ride the work-queue util's `complete`\n     8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n     9\timport type { DatabaseSync } from \"node:sqlite\";\n    10\t\n    11\texport interface MessageSource {\n    12\t  messageId: string;\n    13\t  kind: string;\n    14\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    15\t}\n    16\t\n    17\texport function readMessageSource(\n    18\t  db: DatabaseSync,\n    19\t  messageId: string,\n    20\t): MessageSource | undefined {\n    21\t  const row = db\n    22\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    23\t    .get(messageId) as unknown as { kind: string } | undefined;\n    24\t  if (row === undefined) return undefined;\n    25\t  const blocks = db\n    26\t    .prepare(\n    27\t      `SELECT block_type, content FROM message_block\n    28\t       WHERE message_id = ? ORDER BY block_index`,\n    29\t    )\n    30\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n    31\t  return {\n    32\t    messageId,\n    33\t    kind: row.kind,\n    34\t    blocks: blocks.map((block) => ({\n    35\t      blockType: block.block_type,\n    36\t      content: JSON.parse(block.content) as Record<string, unknown>,\n    37\t    })),\n    38\t  };\n    39\t}\n    40\t\n    41\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n    42\t// ever repeated; in a well-formed record the pair is unique.\n    43\tfunction findPairedBlock(\n    44\t  db: DatabaseSync,\n    45\t  blockType: \"tool_call\" | \"tool_result\",\n    46\t  toolCallId: string,\n    47\t): Record<string, unknown> | undefined {\n    48\t  const row = db\n    49\t    .prepare(\n    50\t      `SELECT b.content FROM message_block b\n    51\t       JOIN message m ON m.message_id = b.message_id\n    52\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n    53\t       ORDER BY m.source_event_order LIMIT 1`,\n    54\t    )\n    55\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n    56\t  if (row === undefined) return undefined;\n    57\t  return JSON.parse(row.content) as Record<string, unknown>;\n    58\t}\n    59\t\n    60\texport function findPairedToolResult(\n    61\t  db: DatabaseSync,\n    62\t  toolCallId: string,\n    63\t): { content: string; isError: boolean } | undefined {\n    64\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n    65\t  if (block === undefined) return undefined;\n    66\t  return {\n    67\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n    68\t    isError: block[\"isError\"] === true,\n    69\t  };\n    70\t}\n    71\t\n    72\texport function findPairedToolCall(\n    73\t  db: DatabaseSync,\n    74\t  toolCallId: string,\n    75\t): { toolName: string } | undefined {\n    76\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n    77\t  if (block === undefined) return undefined;\n    78\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n    79\t}\n    80\t\n    81\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n    82\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n    83\t// common case — call and result in one batch, summary not yet run — never\n    84\t// triggers a requeue. Returns the call's message id and the form's current\n    85\t// source version (the requeue enqueues at version + 1: the pair is the\n    86\t// summary's source, and a source completing follows clear-and-regenerate).\n    87\texport function findUnknownOutcomeCallSummary(\n    88\t  db: DatabaseSync,\n    89\t  toolCallId: string,\n    90\t): { messageId: string; sourceVersion: number } | undefined {\n    91\t  const row = db\n    92\t    .prepare(\n    93\t      `SELECT df.subject_id, df.source_version FROM message_block b\n    94\t       JOIN derived_form df ON df.subject_kind = 'message'\n    95\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n    96\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n    97\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n    98\t       LIMIT 1`,\n    99\t    )\n   100\t    .get(toolCallId) as unknown as\n   101\t    | { subject_id: string; source_version: number | bigint }\n   102\t    | undefined;\n   103\t  if (row === undefined) return undefined;\n   104\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n   105\t}\n","exit_code":0,"status":"completed"}}

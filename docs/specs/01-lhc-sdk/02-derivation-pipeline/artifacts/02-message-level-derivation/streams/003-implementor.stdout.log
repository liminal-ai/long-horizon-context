{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YRYFfoCdedwzSTuHvzWMMQ","type":"tool_result","content":"1\t// The deterministic provider: marked, input-derived output for every seam\n2\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n3\t// functions of the input. It backs the named-provider registry's\n4\t// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n5\t// resolution seam, and the test double reuses these helpers so in-process and\n6\t// spawned runs produce byte-identical artifacts. It is selectable only by\n7\t// explicit name — never a production default.\n8\timport type {\n9\t  DerivationProvider,\n10\t  ProviderResult,\n11\t  RenderingPart,\n12\t} from \"../shared/derivation.js\";\n13\t\n14\texport type DeterministicOpName =\n15\t  | \"smoothPrompt\"\n16\t  | \"summarizeToolCall\"\n17\t  | \"summarizeToolResult\"\n18\t  | \"composeTurnRendering\"\n19\t  | \"projectLowerBand\"\n20\t  | \"summarizeChunkDetailed\"\n21\t  | \"summarizeChunkBrief\";\n22\t\n23\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n24\t  smoothPrompt: \"smoothed\",\n25\t  summarizeToolCall: \"toolcall\",\n26\t  summarizeToolResult: \"toolresult\",\n27\t  composeTurnRendering: \"rendering\",\n28\t  projectLowerBand: \"projection\",\n29\t  summarizeChunkDetailed: \"detailed\",\n30\t  summarizeChunkBrief: \"brief\",\n31\t};\n32\t\n33\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n34\t// input-sensitive enough that distinct inputs mark distinct outputs.\n35\texport function deterministicDigest(input: unknown): string {\n36\t  const text = JSON.stringify(input);\n37\t  let hash = 0x811c9dc5;\n38\t  for (let i = 0; i < text.length; i += 1) {\n39\t    hash ^= text.charCodeAt(i);\n40\t    hash = Math.imul(hash, 0x01000193) >>> 0;\n41\t  }\n42\t  return hash.toString(16).padStart(8, \"0\");\n43\t}\n44\t\n45\texport function deterministicText(\n46\t  op: DeterministicOpName,\n47\t  input: unknown,\n48\t  text: string,\n49\t): string {\n50\t  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n51\t}\n52\t\n53\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n54\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n55\t}\n56\t\n57\texport function createDeterministicProvider(): DerivationProvider {\n58\t  return {\n59\t    smoothPrompt: (i: { text: string }) => ok(\"smoothPrompt\", i, i.text),\n60\t    summarizeToolCall: (i: {\n61\t      toolName: string;\n62\t      argsJson: string;\n63\t      pairedResult?: { content: string; isError: boolean };\n64\t    }) => ok(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`),\n65\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\n66\t      ok(\"summarizeToolResult\", i, i.content),\n67\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\n68\t      ok(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \")),\n69\t    projectLowerBand: (i: { rendering: string }) => ok(\"projectLowerBand\", i, i.rendering),\n70\t    summarizeChunkDetailed: (i: { memberProjections: string[] }) =>\n71\t      ok(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \")),\n72\t    summarizeChunkBrief: (i: { memberProjections: string[] }) =>\n73\t      ok(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \")),\n74\t  };\n75\t}\n76\t"}]},"parent_tool_use_id":null,"session_id":"c424e248-7c12-49e6-8ca7-162e1fb88490","uuid":"221b6d4c-fbf7-4e00-9514-2b62b6630aa4","timestamp":"2026-06-11T04:15:18.825Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/deterministic.ts","content":"// The deterministic provider: marked, input-derived output for every seam\n// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n// functions of the input. It backs the named-provider registry's\n// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n// resolution seam, and the test double reuses these helpers so in-process and\n// spawned runs produce byte-identical artifacts. It is selectable only by\n// explicit name — never a production default.\nimport type {\n  DerivationProvider,\n  ProviderResult,\n  RenderingPart,\n} from \"../shared/derivation.js\";\n\nexport type DeterministicOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\nexport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n  smoothPrompt: \"smoothed\",\n  summarizeToolCall: \"toolcall\",\n  summarizeToolResult: \"toolresult\",\n  composeTurnRendering: \"rendering\",\n  projectLowerBand: \"projection\",\n  summarizeChunkDetailed: \"detailed\",\n  summarizeChunkBrief: \"brief\",\n};\n\n// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n// input-sensitive enough that distinct inputs mark distinct outputs.\nexport function deterministicDigest(input: unknown): string {\n  const text = JSON.stringify(input);\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < text.length; i += 1) {\n    hash ^= text.charCodeAt(i);\n    hash = Math.imul(hash, 0x01000193) >>> 0;\n  }\n  return hash.toString(16).padStart(8, \"0\");\n}\n\nexport function deterministicText(\n  op: DeterministicOpName,\n  input: unknown,\n  text: string,\n): string {\n  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n}\n\nfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n}\n\nexport function createDeterministicProvider(): DerivationProvider {\n  return {\n    smoothPrompt: (i: { text: string }) => ok(\"smoothPrompt\", i, i.text),\n    summarizeToolCall: (i: {\n      toolName: string;\n      argsJson: string;\n      pairedResult?: { content: string; isError: boolean };\n    }) => ok(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`),\n    summarizeToolResult: (i: { toolName: string; content: string }) =>\n      ok(\"summarizeToolResult\", i, i.content),\n    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\n      ok(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \")),\n    projectLowerBand: (i: { rendering: string }) => ok(\"projectLowerBand\", i, i.rendering),\n    summarizeChunkDetailed: (i: { memberProjections: string[] }) =>\n      ok(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \")),\n    summarizeChunkBrief: (i: { memberProjections: string[] }) =>\n      ok(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \")),\n  };\n}\n","numLines":76,"startLine":1,"totalLines":76}}}

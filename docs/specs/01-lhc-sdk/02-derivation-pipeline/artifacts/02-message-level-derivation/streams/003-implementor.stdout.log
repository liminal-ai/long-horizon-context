{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ck7kYaSU6M8RmcZgnkBJVU","type":"tool_result","content":"1\timport type { DatabaseSync } from \"node:sqlite\";\n2\t\n3\texport interface OperationContext {\n4\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n5\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n6\t  threadId: string; // resolved identity of the thread being operated on\n7\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n8\t  // the registered callbacks after its COMMIT succeeds and drops them on\n9\t  // rollback, so anything registered here — the scheduler poke above all —\n10\t  // is transactional by construction.\n11\t  onCommit: (fn: () => void) => void;\n12\t}\n13\t\n14\t// The callback list behind ctx.onCommit, owned by whoever owns the\n15\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n16\t// dropping the hooks is simply not flushing them.\n17\texport interface CommitHooks {\n18\t  register: (fn: () => void) => void;\n19\t  flush: () => void;\n20\t}\n21\t\n22\texport function createCommitHooks(): CommitHooks {\n23\t  const callbacks: Array<() => void> = [];\n24\t  return {\n25\t    register: (fn) => {\n26\t      callbacks.push(fn);\n27\t    },\n28\t    flush: () => {\n29\t      for (const fn of callbacks.splice(0)) fn();\n30\t    },\n31\t  };\n32\t}\n33\t\n34\t// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n35\t// util can fire it without importing the scheduler module (which will import\n36\t// domain handler tables from Story 1 on — a util→scheduler import would\n37\t// cycle). The scheduler installs itself here; in manual mode, or before any\n38\t// scheduler exists, firing is a no-op — onCommit still fires either way.\n39\ttype SchedulerPoke = (threadId: string) => void;\n40\tlet schedulerPoke: SchedulerPoke | null = null;\n41\t\n42\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n43\t  schedulerPoke = poke;\n44\t}\n45\t\n46\texport function fireSchedulerPoke(threadId: string): void {\n47\t  schedulerPoke?.(threadId);\n48\t}\n49\t\n50\t// The thread-touch seam (DD-10). openThreadDatabase announces every open of a\n51\t// thread file here, before any caller transaction begins. The background\n52\t// scheduler installs a listener to learn threadId→filePath and to run the\n53\t// first-touch catch-up check (one indexed query on the already-open handle);\n54\t// with no listener installed — manual mode, or no SDK constructed — firing is\n55\t// free. Lives in shared/ for the same reason as the poke slot: the threads\n56\t// domain may not import the scheduler module.\n57\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n58\tlet threadTouch: ThreadTouch | null = null;\n59\t\n60\texport function setThreadTouch(touch: ThreadTouch | null): void {\n61\t  threadTouch = touch;\n62\t}\n63\t\n64\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n65\t  threadTouch?.(filePath, db);\n66\t}\n67\t\n68\t// Transaction owner for operations outside the intake pipeline (mutations,\n69\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n70\t// body with a context whose onCommit registrations flush only after COMMIT\n71\t// succeeds and drop whole on rollback.\n72\texport function runInTransaction<T>(\n73\t  db: DatabaseSync,\n74\t  clock: () => Date,\n75\t  threadId: string,\n76\t  fn: (ctx: OperationContext) => T,\n77\t): T {\n78\t  const hooks = createCommitHooks();\n79\t  db.exec(\"BEGIN IMMEDIATE;\");\n80\t  let value: T;\n81\t  try {\n82\t    value = fn({ db, clock, threadId, onCommit: hooks.register });\n83\t    db.exec(\"COMMIT;\");\n84\t  } catch (cause) {\n85\t    db.exec(\"ROLLBACK;\");\n86\t    throw cause;\n87\t  }\n88\t  hooks.flush();\n89\t  return value;\n90\t}\n91\t"}]},"parent_tool_use_id":null,"session_id":"c424e248-7c12-49e6-8ca7-162e1fb88490","uuid":"6f4f210e-a7d9-482e-b984-d118173de4a2","timestamp":"2026-06-11T04:15:47.010Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/context.ts","content":"import type { DatabaseSync } from \"node:sqlite\";\n\nexport interface OperationContext {\n  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n  threadId: string; // resolved identity of the thread being operated on\n  // Post-commit callback registration (DD-5): the transaction owner flushes\n  // the registered callbacks after its COMMIT succeeds and drops them on\n  // rollback, so anything registered here — the scheduler poke above all —\n  // is transactional by construction.\n  onCommit: (fn: () => void) => void;\n}\n\n// The callback list behind ctx.onCommit, owned by whoever owns the\n// transaction. Flush after COMMIT; never call flush on a rollback path —\n// dropping the hooks is simply not flushing them.\nexport interface CommitHooks {\n  register: (fn: () => void) => void;\n  flush: () => void;\n}\n\nexport function createCommitHooks(): CommitHooks {\n  const callbacks: Array<() => void> = [];\n  return {\n    register: (fn) => {\n      callbacks.push(fn);\n    },\n    flush: () => {\n      for (const fn of callbacks.splice(0)) fn();\n    },\n  };\n}\n\n// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n// util can fire it without importing the scheduler module (which will import\n// domain handler tables from Story 1 on — a util→scheduler import would\n// cycle). The scheduler installs itself here; in manual mode, or before any\n// scheduler exists, firing is a no-op — onCommit still fires either way.\ntype SchedulerPoke = (threadId: string) => void;\nlet schedulerPoke: SchedulerPoke | null = null;\n\nexport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n  schedulerPoke = poke;\n}\n\nexport function fireSchedulerPoke(threadId: string): void {\n  schedulerPoke?.(threadId);\n}\n\n// The thread-touch seam (DD-10). openThreadDatabase announces every open of a\n// thread file here, before any caller transaction begins. The background\n// scheduler installs a listener to learn threadId→filePath and to run the\n// first-touch catch-up check (one indexed query on the already-open handle);\n// with no listener installed — manual mode, or no SDK constructed — firing is\n// free. Lives in shared/ for the same reason as the poke slot: the threads\n// domain may not import the scheduler module.\ntype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\nlet threadTouch: ThreadTouch | null = null;\n\nexport function setThreadTouch(touch: ThreadTouch | null): void {\n  threadTouch = touch;\n}\n\nexport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n  threadTouch?.(filePath, db);\n}\n\n// Transaction owner for operations outside the intake pipeline (mutations,\n// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n// body with a context whose onCommit registrations flush only after COMMIT\n// succeeds and drop whole on rollback.\nexport function runInTransaction<T>(\n  db: DatabaseSync,\n  clock: () => Date,\n  threadId: string,\n  fn: (ctx: OperationContext) => T,\n): T {\n  const hooks = createCommitHooks();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  let value: T;\n  try {\n    value = fn({ db, clock, threadId, onCommit: hooks.register });\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n  hooks.flush();\n  return value;\n}\n","numLines":91,"startLine":1,"totalLines":91}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JLfN5thPZddEtDqtRFynh7","type":"tool_result","content":"1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n2\t// provider seam, and the handler contract. Both owning domains (messages,\n3\t// turns) consume these; neither owns them — the repair report, the mutation\n4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\t\n8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n9\t\n10\texport type FormKind =\n11\t  | \"smoothed_prompt\"\n12\t  | \"tool_call_summary\"\n13\t  | \"tool_result_summary\"\n14\t  | \"turn_rendering\"\n15\t  | \"lower_band_projection\"\n16\t  | \"chunk_summary_detailed\"\n17\t  | \"chunk_summary_brief\";\n18\t\n19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n20\t\n21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n22\t// (isError/presence), never authored by the provider (AC-2.4).\n23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n24\t\n25\t// A composed form's record of a dependency that fell back during composition:\n26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n27\texport interface DependencyGap {\n28\t  subjectKind: SubjectKind;\n29\t  subjectId: string;\n30\t  form: FormKind;\n31\t}\n32\t\n33\t// The read shape for one derived form's state row (DD-2, DD-3).\n34\texport interface DerivedForm {\n35\t  subjectKind: SubjectKind;\n36\t  subjectId: string;\n37\t  form: FormKind;\n38\t  state: DerivedFormState;\n39\t  content?: string; // ready only\n40\t  reason?: string; // failed | blocked\n41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n43\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n44\t  derivedAt?: string;\n45\t}\n46\t\n47\t// Mechanically stamped form metadata: tool outcomes (AC-2.4) plus — at retry\n48\t// exhaustion — the final attempts/last-error copied from the work item before\n49\t// its row is deleted (DD-1: the queue is not an audit table; durable outcome\n50\t// detail lives here).\n51\texport interface DerivedFormMetadata {\n52\t  outcome?: ToolOutcome;\n53\t  attempts?: number;\n54\t  lastError?: string;\n55\t}\n56\t\n57\t// ── provider seam (DD-7) ─────────────────────────────────────────\n58\t// Every operation returns content or a structured failure carrying\n59\t// retryable-or-not; classification is the adapter's duty.\n60\texport type ProviderResult =\n61\t  | { ok: true; text: string }\n62\t  | { ok: false; retryable: boolean; reason: string };\n63\t\n64\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n65\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n66\t// rather than imported: shared/ may not import domains/.\n67\texport type RenderingPartKind =\n68\t  | \"user_prompt\"\n69\t  | \"assistant_text\"\n70\t  | \"assistant_thinking\"\n71\t  | \"runtime_note\"\n72\t  | \"tool_call\"\n73\t  | \"tool_result\";\n74\t\n75\texport interface RenderingPart {\n76\t  messageId: string;\n77\t  kind: RenderingPartKind;\n78\t  text: string; // ready form content, or raw/truncated fallback\n79\t  fallback: boolean; // true ⇒ gap recorded\n80\t  outcome?: ToolOutcome; // tool activity only\n81\t}\n82\t\n83\texport interface DerivationProvider {\n84\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n85\t  summarizeToolCall(i: {\n86\t    toolName: string;\n87\t    argsJson: string;\n88\t    pairedResult?: { content: string; isError: boolean };\n89\t  }): Promise<ProviderResult>;\n90\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n91\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n92\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n93\t  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult>;\n94\t  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult>;\n95\t}\n96\t\n97\texport const PROVIDER_OPERATIONS = [\n98\t  \"smoothPrompt\",\n99\t  \"summarizeToolCall\",\n100\t  \"summarizeToolResult\",\n101\t  \"composeTurnRendering\",\n102\t  \"projectLowerBand\",\n103\t  \"summarizeChunkDetailed\",\n104\t  \"summarizeChunkBrief\",\n105\t] as const;\n106\t\n107\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n108\t\n109\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n110\texport interface SdkConfig {\n111\t  provider: DerivationProvider;\n112\t  mode: \"background\" | \"manual\";\n113\t  clock?: () => Date;\n114\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n115\t  lease?: { durationMs: number }; // 120000\n116\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n117\t}\n118\t\n119\t// Every optional filled by createSdk's central defaults.\n120\texport interface ResolvedSdkConfig {\n121\t  provider: DerivationProvider;\n122\t  mode: \"background\" | \"manual\";\n123\t  clock: () => Date;\n124\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n125\t  lease: { durationMs: number };\n126\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n127\t}\n128\t\n129\t// ── handler contract (DD-6; the map's value type) ────────────────\n130\texport interface HandlerRunContext {\n131\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n132\t  provider: DerivationProvider;\n133\t  clock: () => Date;\n134\t  config: ResolvedSdkConfig;\n135\t}\n136\t\n137\t// A successful handler hands its derived-form content back as data; the\n138\t// drain's completion transaction performs the version-checked UPDATE and the\n139\t// item-row deletion atomically (tech design §Mechanics: completion is one\n140\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n141\t// never opens that transaction itself, so the version check and the\n142\t// done/stale_discarded disposition stay in one place — the queue util.\n143\texport interface HandlerFormWrite {\n144\t  subjectKind: SubjectKind;\n145\t  subjectId: string;\n146\t  form: FormKind;\n147\t  content: string;\n148\t  metadata?: DerivedFormMetadata;\n149\t  gaps?: DependencyGap[];\n150\t}\n151\t\n152\texport type HandlerOutcome =\n153\t  | { ok: true; forms?: HandlerFormWrite[] } // written version-checked in the completion txn\n154\t  | { ok: false; retryable: boolean; reason: string }\n155\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n156\t\n157\t// item is the queue util's WorkItemRecord; typed structurally here so the\n158\t// shared layer does not depend on the util's module (and vice versa stays\n159\t// one-directional: tech-utils imports shared).\n160\texport type WorkHandler = (\n161\t  run: HandlerRunContext,\n162\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n163\t) => Promise<HandlerOutcome>;\n164\t"}]},"parent_tool_use_id":null,"session_id":"c424e248-7c12-49e6-8ca7-162e1fb88490","uuid":"2041757a-efed-42fe-a83b-f08dd5330e07","timestamp":"2026-06-11T04:14:54.917Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts","content":"// Epic 02 shared vocabulary: the derived-form state machine's types, the\n// provider seam, and the handler contract. Both owning domains (messages,\n// turns) consume these; neither owns them — the repair report, the mutation\n// cascade, and the drain all speak this vocabulary across domain lines, so it\n// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\nimport type { DatabaseSync } from \"node:sqlite\";\n\nexport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n\nexport type FormKind =\n  | \"smoothed_prompt\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_rendering\"\n  | \"lower_band_projection\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\n\nexport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n\n// Outcome on tool-activity summaries — mechanically stamped from the record\n// (isError/presence), never authored by the provider (AC-2.4).\nexport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n\n// A composed form's record of a dependency that fell back during composition:\n// names the source record and the form that was not ready (AC-3.2/3.3).\nexport interface DependencyGap {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\n// The read shape for one derived form's state row (DD-2, DD-3).\nexport interface DerivedForm {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n  content?: string; // ready only\n  reason?: string; // failed | blocked\n  sourceVersion: number; // which version of the source this form derives from (DD-3)\n  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n  derivedAt?: string;\n}\n\n// Mechanically stamped form metadata: tool outcomes (AC-2.4) plus — at retry\n// exhaustion — the final attempts/last-error copied from the work item before\n// its row is deleted (DD-1: the queue is not an audit table; durable outcome\n// detail lives here).\nexport interface DerivedFormMetadata {\n  outcome?: ToolOutcome;\n  attempts?: number;\n  lastError?: string;\n}\n\n// ── provider seam (DD-7) ─────────────────────────────────────────\n// Every operation returns content or a structured failure carrying\n// retryable-or-not; classification is the adapter's duty.\nexport type ProviderResult =\n  | { ok: true; text: string }\n  | { ok: false; retryable: boolean; reason: string };\n\n// Message kinds a rendering part can carry — mirrors the intake event-kind\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n// rather than imported: shared/ may not import domains/.\nexport type RenderingPartKind =\n  | \"user_prompt\"\n  | \"assistant_text\"\n  | \"assistant_thinking\"\n  | \"runtime_note\"\n  | \"tool_call\"\n  | \"tool_result\";\n\nexport interface RenderingPart {\n  messageId: string;\n  kind: RenderingPartKind;\n  text: string; // ready form content, or raw/truncated fallback\n  fallback: boolean; // true ⇒ gap recorded\n  outcome?: ToolOutcome; // tool activity only\n}\n\nexport interface DerivationProvider {\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult>;\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult>;\n  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult>;\n}\n\nexport const PROVIDER_OPERATIONS = [\n  \"smoothPrompt\",\n  \"summarizeToolCall\",\n  \"summarizeToolResult\",\n  \"composeTurnRendering\",\n  \"projectLowerBand\",\n  \"summarizeChunkDetailed\",\n  \"summarizeChunkBrief\",\n] as const;\n\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n\n// ── SDK assembly config (tech design §Interfaces) ────────────────\nexport interface SdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock?: () => Date;\n  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n  lease?: { durationMs: number }; // 120000\n  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n}\n\n// Every optional filled by createSdk's central defaults.\nexport interface ResolvedSdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock: () => Date;\n  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  lease: { durationMs: number };\n  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n}\n\n// ── handler contract (DD-6; the map's value type) ────────────────\nexport interface HandlerRunContext {\n  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n  provider: DerivationProvider;\n  clock: () => Date;\n  config: ResolvedSdkConfig;\n}\n\n// A successful handler hands its derived-form content back as data; the\n// drain's completion transaction performs the version-checked UPDATE and the\n// item-row deletion atomically (tech design §Mechanics: completion is one\n// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n// never opens that transaction itself, so the version check and the\n// done/stale_discarded disposition stay in one place — the queue util.\nexport interface HandlerFormWrite {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  content: string;\n  metadata?: DerivedFormMetadata;\n  gaps?: DependencyGap[];\n}\n\nexport type HandlerOutcome =\n  | { ok: true; forms?: HandlerFormWrite[] } // written version-checked in the completion txn\n  | { ok: false; retryable: boolean; reason: string }\n  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n\n// item is the queue util's WorkItemRecord; typed structurally here so the\n// shared layer does not depend on the util's module (and vice versa stays\n// one-directional: tech-utils imports shared).\nexport type WorkHandler = (\n  run: HandlerRunContext,\n  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n) => Promise<HandlerOutcome>;\n","numLines":164,"startLine":1,"totalLines":164}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ww31j2kbJFjfZQhTFoFj9","type":"tool_result","content":"1\timport { randomBytes } from \"node:crypto\";\n2\timport { rmSync } from \"node:fs\";\n3\timport { DatabaseSync } from \"node:sqlite\";\n4\timport { fireThreadTouch } from \"../../../shared/context.js\";\n5\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n6\timport {\n7\t  getSchemaVersion,\n8\t  MIGRATION_V5_STATEMENTS,\n9\t  openDatabase,\n10\t  runMigrations,\n11\t  type Migration,\n12\t} from \"../../../shared/storage.js\";\n13\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n14\t\n15\t// The one random id: its uniqueness scope is global across files and\n16\t// registries (design decision 7).\n17\texport function generateThreadId(): string {\n18\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n19\t}\n20\t\n21\t// The thread-file schema as a versioned history, never rewritten in place:\n22\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n23\t// each later story appends a version. Existing files upgrade lazily through\n24\t// openThreadDatabase, so a file recorded under an earlier story is always\n25\t// usable by a later one (F-03-001).\n26\t//\n27\t// Creation-time metadata values are interpolated through buildThreadMigrations\n28\t// for new files only; existing files already hold their metadata row and the\n29\t// upgrade path never touches it.\n30\tfunction buildThreadMigrations(\n31\t  metadata?: { threadId: string; createdAt: string },\n32\t): Migration[] {\n33\t  const metadataInsert =\n34\t    metadata === undefined\n35\t      ? []\n36\t      : [\n37\t          // Interpolated values are all generated by us (hex id, ISO\n38\t          // timestamp, estimator constant) — never caller input.\n39\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n40\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n41\t        ];\n42\t  return [\n43\t    {\n44\t      version: 1,\n45\t      statements: [\n46\t        `CREATE TABLE thread_metadata (\n47\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n48\t          thread_id TEXT NOT NULL,\n49\t          created_at TEXT NOT NULL,\n50\t          token_estimator TEXT NOT NULL\n51\t        );`,\n52\t        ...metadataInsert,\n53\t        `CREATE TABLE event (\n54\t          event_order INTEGER PRIMARY KEY,\n55\t          event_kind TEXT NOT NULL,\n56\t          idempotency_key TEXT NOT NULL UNIQUE,\n57\t          actor TEXT NOT NULL,\n58\t          harness TEXT NOT NULL,\n59\t          payload TEXT NOT NULL,\n60\t          recorded_at TEXT NOT NULL\n61\t        );`,\n62\t      ],\n63\t    },\n64\t    {\n65\t      version: 2, // Story 3: message projection\n66\t      statements: [\n67\t        `CREATE TABLE message (\n68\t          message_id TEXT PRIMARY KEY,\n69\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n70\t          kind TEXT NOT NULL,\n71\t          token_estimate INTEGER NOT NULL,\n72\t          actor TEXT NOT NULL,\n73\t          harness TEXT NOT NULL,\n74\t          turn_id TEXT\n75\t        );`,\n76\t        `CREATE TABLE message_block (\n77\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n78\t          block_index INTEGER NOT NULL,\n79\t          block_type TEXT NOT NULL,\n80\t          content TEXT NOT NULL,\n81\t          PRIMARY KEY (message_id, block_index)\n82\t        );`,\n83\t      ],\n84\t    },\n85\t    {\n86\t      version: 3, // Story 4: turn state machine\n87\t      statements: [\n88\t        `CREATE TABLE turns (\n89\t          turn_id TEXT PRIMARY KEY,\n90\t          turn_order INTEGER NOT NULL UNIQUE,\n91\t          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n92\t          opened_at_event_order INTEGER NOT NULL,\n93\t          closed_at_event_order INTEGER\n94\t        );`,\n95\t      ],\n96\t    },\n97\t    {\n98\t      version: 4, // Story 5: derivation work queueing\n99\t      statements: [\n100\t        // Work items live in the thread file and commit with the batch —\n101\t        // not a separate database, not a separate transaction. status is\n102\t        // unconstrained TEXT: this epic only ever writes 'queued'; the\n103\t        // claim/lease statuses are Epic 02's to add.\n104\t        `CREATE TABLE work_item (\n105\t          work_item_id TEXT PRIMARY KEY,\n106\t          owner TEXT NOT NULL,\n107\t          kind TEXT NOT NULL,\n108\t          source_ref TEXT NOT NULL,\n109\t          status TEXT NOT NULL,\n110\t          queued_at TEXT NOT NULL\n111\t        );`,\n112\t      ],\n113\t    },\n114\t    {\n115\t      version: 5, // Epic 02 Story 0: queue mechanical fields, derived_form,\n116\t      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n117\t      // epic's single migration (tech design §Storage), statements owned by\n118\t      // shared/storage.ts.\n119\t      statements: MIGRATION_V5_STATEMENTS,\n120\t    },\n121\t  ];\n122\t}\n123\t\n124\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n125\t  return {\n126\t    ok: false,\n127\t    error: {\n128\t      errorClass: \"caller_error\",\n129\t      code: \"thread_not_found\",\n130\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n131\t    },\n132\t  };\n133\t}\n134\t\n135\tfunction errorDetail(cause: unknown): string {\n136\t  return cause instanceof Error ? cause.message : String(cause);\n137\t}\n138\t\n139\t// Identity check before any migration runs, on a read-only handle so an\n140\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n141\t// file always carries schema version >= 1 and the thread_metadata singleton\n142\t// row that creation wrote transactionally. Anything else — an empty\n143\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n144\t// caller error, never adopted.\n145\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n146\t  let db: DatabaseSync | undefined;\n147\t  try {\n148\t    db = new DatabaseSync(filePath, { readOnly: true });\n149\t    if (getSchemaVersion(db) < 1) {\n150\t      return notAThreadFile(filePath, \"no lhc schema version\");\n151\t    }\n152\t    const table = db\n153\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n154\t      .get();\n155\t    if (table === undefined) {\n156\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n157\t    }\n158\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n159\t    if (row === undefined) {\n160\t      return notAThreadFile(filePath, \"no thread metadata row\");\n161\t    }\n162\t    return { ok: true };\n163\t  } catch (cause) {\n164\t    const detail = errorDetail(cause);\n165\t    // SQLite refusing the file as a database is an identity failure, not an\n166\t    // environment failure; everything else stays a system error.\n167\t    if (detail.includes(\"not a database\")) {\n168\t      return notAThreadFile(filePath, detail);\n169\t    }\n170\t    return storageFailure(`could not inspect thread file: ${detail}`);\n171\t  } finally {\n172\t    db?.close();\n173\t  }\n174\t}\n175\t\n176\t// Opens a thread file and brings its schema to the current version before\n177\t// returning the handle. Every SDK operation on an existing thread file goes\n178\t// through here, so a pre-Story-3 file gains the message tables on its first\n179\t// open by newer code — but only after the file proves it is a thread file;\n180\t// migration never creates lhc schema on an arbitrary existing file. Each\n181\t// migration runs in its own transaction (storage helper), completing before\n182\t// any caller transaction begins.\n183\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n184\t  const valid = validateThreadFile(filePath);\n185\t  if (!valid.ok) return valid;\n186\t  let db: DatabaseSync;\n187\t  try {\n188\t    db = openDatabase(filePath);\n189\t  } catch (cause) {\n190\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n191\t  }\n192\t  try {\n193\t    runMigrations(db, buildThreadMigrations());\n194\t  } catch (cause) {\n195\t    db.close();\n196\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n197\t  }\n198\t  // Announce the open (DD-10): the background scheduler's first-touch\n199\t  // catch-up hangs off this seam. Fired before any caller transaction\n200\t  // begins; a no-op unless a listener is installed.\n201\t  fireThreadTouch(filePath, db);\n202\t  return { ok: true, value: db };\n203\t}\n204\t\n205\t// Schema v1 plus the metadata row land in one migration transaction, so the\n206\t// file either has its full schema and metadata row or creation fails whole.\n207\texport function createThreadFile(\n208\t  filePath: string,\n209\t  threadId: string,\n210\t  createdAt: string,\n211\t): void {\n212\t  const db = openDatabase(filePath);\n213\t  try {\n214\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n215\t  } finally {\n216\t    db.close();\n217\t  }\n218\t}\n219\t\n220\t// Compensation: removes the thread file and its WAL companions. Used when the\n221\t// registry insert fails after file creation (no registry row without its\n222\t// file) and when file creation itself fails partway.\n223\texport function deleteThreadFile(filePath: string): void {\n224\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n225\t    rmSync(`${filePath}${suffix}`, { force: true });\n226\t  }\n227\t}\n228\t"}]},"parent_tool_use_id":null,"session_id":"c424e248-7c12-49e6-8ca7-162e1fb88490","uuid":"f004748e-8c40-4e2f-baef-e4284f029d9e","timestamp":"2026-06-11T04:17:29.890Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/internal/create.ts","content":"import { randomBytes } from \"node:crypto\";\nimport { rmSync } from \"node:fs\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { fireThreadTouch } from \"../../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport {\n  getSchemaVersion,\n  MIGRATION_V5_STATEMENTS,\n  openDatabase,\n  runMigrations,\n  type Migration,\n} from \"../../../shared/storage.js\";\nimport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n\n// The one random id: its uniqueness scope is global across files and\n// registries (design decision 7).\nexport function generateThreadId(): string {\n  return `th_${randomBytes(8).toString(\"hex\")}`;\n}\n\n// The thread-file schema as a versioned history, never rewritten in place:\n// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n// each later story appends a version. Existing files upgrade lazily through\n// openThreadDatabase, so a file recorded under an earlier story is always\n// usable by a later one (F-03-001).\n//\n// Creation-time metadata values are interpolated through buildThreadMigrations\n// for new files only; existing files already hold their metadata row and the\n// upgrade path never touches it.\nfunction buildThreadMigrations(\n  metadata?: { threadId: string; createdAt: string },\n): Migration[] {\n  const metadataInsert =\n    metadata === undefined\n      ? []\n      : [\n          // Interpolated values are all generated by us (hex id, ISO\n          // timestamp, estimator constant) — never caller input.\n          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n        ];\n  return [\n    {\n      version: 1,\n      statements: [\n        `CREATE TABLE thread_metadata (\n          id INTEGER PRIMARY KEY CHECK (id = 1),\n          thread_id TEXT NOT NULL,\n          created_at TEXT NOT NULL,\n          token_estimator TEXT NOT NULL\n        );`,\n        ...metadataInsert,\n        `CREATE TABLE event (\n          event_order INTEGER PRIMARY KEY,\n          event_kind TEXT NOT NULL,\n          idempotency_key TEXT NOT NULL UNIQUE,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          payload TEXT NOT NULL,\n          recorded_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 2, // Story 3: message projection\n      statements: [\n        `CREATE TABLE message (\n          message_id TEXT PRIMARY KEY,\n          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n          kind TEXT NOT NULL,\n          token_estimate INTEGER NOT NULL,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          turn_id TEXT\n        );`,\n        `CREATE TABLE message_block (\n          message_id TEXT NOT NULL REFERENCES message(message_id),\n          block_index INTEGER NOT NULL,\n          block_type TEXT NOT NULL,\n          content TEXT NOT NULL,\n          PRIMARY KEY (message_id, block_index)\n        );`,\n      ],\n    },\n    {\n      version: 3, // Story 4: turn state machine\n      statements: [\n        `CREATE TABLE turns (\n          turn_id TEXT PRIMARY KEY,\n          turn_order INTEGER NOT NULL UNIQUE,\n          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n          opened_at_event_order INTEGER NOT NULL,\n          closed_at_event_order INTEGER\n        );`,\n      ],\n    },\n    {\n      version: 4, // Story 5: derivation work queueing\n      statements: [\n        // Work items live in the thread file and commit with the batch —\n        // not a separate database, not a separate transaction. status is\n        // unconstrained TEXT: this epic only ever writes 'queued'; the\n        // claim/lease statuses are Epic 02's to add.\n        `CREATE TABLE work_item (\n          work_item_id TEXT PRIMARY KEY,\n          owner TEXT NOT NULL,\n          kind TEXT NOT NULL,\n          source_ref TEXT NOT NULL,\n          status TEXT NOT NULL,\n          queued_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 5, // Epic 02 Story 0: queue mechanical fields, derived_form,\n      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n      // epic's single migration (tech design §Storage), statements owned by\n      // shared/storage.ts.\n      statements: MIGRATION_V5_STATEMENTS,\n    },\n  ];\n}\n\nfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n    },\n  };\n}\n\nfunction errorDetail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Identity check before any migration runs, on a read-only handle so an\n// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n// file always carries schema version >= 1 and the thread_metadata singleton\n// row that creation wrote transactionally. Anything else — an empty\n// database, an unrelated SQLite file, a non-database file — is rejected as a\n// caller error, never adopted.\nfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    if (getSchemaVersion(db) < 1) {\n      return notAThreadFile(filePath, \"no lhc schema version\");\n    }\n    const table = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n      .get();\n    if (table === undefined) {\n      return notAThreadFile(filePath, \"no thread_metadata table\");\n    }\n    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n    if (row === undefined) {\n      return notAThreadFile(filePath, \"no thread metadata row\");\n    }\n    return { ok: true };\n  } catch (cause) {\n    const detail = errorDetail(cause);\n    // SQLite refusing the file as a database is an identity failure, not an\n    // environment failure; everything else stays a system error.\n    if (detail.includes(\"not a database\")) {\n      return notAThreadFile(filePath, detail);\n    }\n    return storageFailure(`could not inspect thread file: ${detail}`);\n  } finally {\n    db?.close();\n  }\n}\n\n// Opens a thread file and brings its schema to the current version before\n// returning the handle. Every SDK operation on an existing thread file goes\n// through here, so a pre-Story-3 file gains the message tables on its first\n// open by newer code — but only after the file proves it is a thread file;\n// migration never creates lhc schema on an arbitrary existing file. Each\n// migration runs in its own transaction (storage helper), completing before\n// any caller transaction begins.\nexport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n  const valid = validateThreadFile(filePath);\n  if (!valid.ok) return valid;\n  let db: DatabaseSync;\n  try {\n    db = openDatabase(filePath);\n  } catch (cause) {\n    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n  }\n  try {\n    runMigrations(db, buildThreadMigrations());\n  } catch (cause) {\n    db.close();\n    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n  }\n  // Announce the open (DD-10): the background scheduler's first-touch\n  // catch-up hangs off this seam. Fired before any caller transaction\n  // begins; a no-op unless a listener is installed.\n  fireThreadTouch(filePath, db);\n  return { ok: true, value: db };\n}\n\n// Schema v1 plus the metadata row land in one migration transaction, so the\n// file either has its full schema and metadata row or creation fails whole.\nexport function createThreadFile(\n  filePath: string,\n  threadId: string,\n  createdAt: string,\n): void {\n  const db = openDatabase(filePath);\n  try {\n    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n  } finally {\n    db.close();\n  }\n}\n\n// Compensation: removes the thread file and its WAL companions. Used when the\n// registry insert fails after file creation (no registry row without its\n// file) and when file creation itself fails partway.\nexport function deleteThreadFile(filePath: string): void {\n  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n    rmSync(`${filePath}${suffix}`, { force: true });\n  }\n}\n","numLines":228,"startLine":1,"totalLines":228}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017EDZaWmXJnhkrmRBw19M8C","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport type { OperationContext } from \"../../shared/context.js\";\n3\timport type { FormKind, WorkHandler } from \"../../shared/derivation.js\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n5\timport {\n6\t  enqueue,\n7\t  listItems,\n8\t  type WorkItemRecord,\n9\t  type WorkKind,\n10\t} from \"../../tech-utils/work-queue/index.js\";\n11\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n12\timport {\n13\t  openThreadDatabase,\n14\t  resolveThreadRef,\n15\t  type ThreadRef,\n16\t} from \"../threads/index.js\";\n17\timport { projectEvent } from \"./internal/project.js\";\n18\timport { insertMessage, readMessages } from \"./internal/store.js\";\n19\t\n20\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n21\t\n22\texport interface Block {\n23\t  blockType: BlockType;\n24\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n25\t}\n26\t\n27\texport interface MessageRecord {\n28\t  messageId: string;\n29\t  sourceEventOrder: number;\n30\t  kind: Exclude<EventKind, \"turn_end\">;\n31\t  blocks: Block[];\n32\t  tokenEstimate: number;\n33\t  actor: string;\n34\t  harness: string;\n35\t  turnId?: string;\n36\t}\n37\t\n38\t// The event as the walk holds it after recording: the validated input plus\n39\t// its server-stamped order and timestamp.\n40\texport type RecordedEvent = EventRecord;\n41\t\n42\texport type MessageCreated = {\n43\t  messageId: string;\n44\t  kind: Exclude<EventKind, \"turn_end\">;\n45\t} | null;\n46\t\n47\t// Cross-domain surface, called by intake-stream inside the batch transaction\n48\t// (the first such call through the operation context; turns.applyEvent\n49\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n50\t// projection failure propagates to the pipeline's catch and rejects the\n51\t// whole batch — recorded events without messages is the stranded state the\n52\t// transaction exists to prevent. Returns null for turn_end (no message).\n53\t// turnId is the membership stamp, settled by the pipeline before this call:\n54\t// the turn open *after* this event's transition (so a prompt belongs to the\n55\t// turn it just opened), or null in a gap — written once, never updated.\n56\texport function createFromEvent(\n57\t  ctx: OperationContext,\n58\t  event: RecordedEvent,\n59\t  turnId: string | null,\n60\t): MessageCreated {\n61\t  const projected = projectEvent(event);\n62\t  if (projected === null) return null;\n63\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n64\t  const messageId = `m${event.eventOrder}`;\n65\t  insertMessage(ctx.db, {\n66\t    messageId,\n67\t    sourceEventOrder: event.eventOrder,\n68\t    kind,\n69\t    tokenEstimate: projected.tokenEstimate,\n70\t    actor: event.actor,\n71\t    harness: event.harness,\n72\t    turnId,\n73\t    blocks: projected.blocks,\n74\t  });\n75\t  return { messageId, kind };\n76\t}\n77\t\n78\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n79\t// result queues tool_result_summary, nothing else queues anything — text,\n80\t// thinking, and note messages are not derivation sources (AC-2.8, AC-2.7's\n81\t// TC-2.9 half). Cross-domain surface, called by intake-stream inside the\n82\t// batch transaction for every recorded message, so the item commits (or\n83\t// rolls back) with the batch.\n84\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n85\t  user_prompt: \"prompt_smoothing\",\n86\t  tool_result: \"tool_result_summary\",\n87\t};\n88\t\n89\t// Which derived form each message-owned kind produces — the owning domain's\n90\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n91\t// rides the same transaction (DD-5).\n92\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n93\t  prompt_smoothing: \"smoothed_prompt\",\n94\t  tool_call_summary: \"tool_call_summary\",\n95\t  tool_result_summary: \"tool_result_summary\",\n96\t};\n97\t\n98\t// Message-owned work handlers, merged into the SDK's dispatch map at\n99\t// construction (DD-6). Empty until Story 2 lands prompt smoothing and the\n100\t// two tool summaries.\n101\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {};\n102\t\n103\texport function queueMessageWork(\n104\t  ctx: OperationContext,\n105\t  message: MessageCreated,\n106\t): WorkItemRecord[] {\n107\t  if (message === null) return [];\n108\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n109\t  if (kind === undefined) return [];\n110\t  const form = MESSAGE_WORK_FORMS[kind];\n111\t  if (form === undefined) {\n112\t    // Every queuing kind names its form above; a miss is a wiring bug.\n113\t    throw new Error(`no derived form mapped for message work kind ${kind}`);\n114\t  }\n115\t  const item = enqueue(ctx, {\n116\t    owner: \"messages\",\n117\t    kind,\n118\t    sourceRef: { messageId: message.messageId },\n119\t    forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n120\t  });\n121\t  return [item];\n122\t}\n123\t\n124\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n125\t  return {\n126\t    ok: false,\n127\t    error: {\n128\t      errorClass: \"caller_error\",\n129\t      code: \"thread_not_found\",\n130\t      reason: `no thread file exists at ${filePath}`,\n131\t    },\n132\t  };\n133\t}\n134\t\n135\texport async function listMessages(\n136\t  thread: ThreadRef,\n137\t): Promise<OpResult<MessageRecord[]>> {\n138\t  const resolved = await resolveThreadRef(thread);\n139\t  if (!resolved.ok) return resolved;\n140\t  const { filePath } = resolved.value;\n141\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n142\t\n143\t  // openThreadDatabase verifies the file is a real thread file and migrates\n144\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n145\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n146\t  // unmutated (F-03-002).\n147\t  const opened = openThreadDatabase(filePath);\n148\t  if (!opened.ok) return opened;\n149\t  const db = opened.value;\n150\t  try {\n151\t    return { ok: true, value: readMessages(db) };\n152\t  } catch (cause) {\n153\t    const reason = cause instanceof Error ? cause.message : String(cause);\n154\t    return storageFailure(`message read-back failed: ${reason}`);\n155\t  } finally {\n156\t    db.close();\n157\t  }\n158\t}\n159\t\n160\texport async function listQueuedWork(\n161\t  thread: ThreadRef,\n162\t): Promise<OpResult<WorkItemRecord[]>> {\n163\t  const resolved = await resolveThreadRef(thread);\n164\t  if (!resolved.ok) return resolved;\n165\t  const { filePath } = resolved.value;\n166\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n167\t\n168\t  const opened = openThreadDatabase(filePath);\n169\t  if (!opened.ok) return opened;\n170\t  const db = opened.value;\n171\t  try {\n172\t    return { ok: true, value: listItems(db, \"messages\") };\n173\t  } catch (cause) {\n174\t    const reason = cause instanceof Error ? cause.message : String(cause);\n175\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n176\t  } finally {\n177\t    db.close();\n178\t  }\n179\t}\n180\t"}]},"parent_tool_use_id":null,"session_id":"c424e248-7c12-49e6-8ca7-162e1fb88490","uuid":"674b4df4-ab29-489d-918a-c36f43bfa25a","timestamp":"2026-06-11T04:15:01.689Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"import { existsSync } from \"node:fs\";\nimport type { OperationContext } from \"../../shared/context.js\";\nimport type { FormKind, WorkHandler } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  listItems,\n  type WorkItemRecord,\n  type WorkKind,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport { projectEvent } from \"./internal/project.js\";\nimport { insertMessage, readMessages } from \"./internal/store.js\";\n\nexport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n\nexport interface Block {\n  blockType: BlockType;\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n}\n\nexport interface MessageRecord {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: Exclude<EventKind, \"turn_end\">;\n  blocks: Block[];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  turnId?: string;\n}\n\n// The event as the walk holds it after recording: the validated input plus\n// its server-stamped order and timestamp.\nexport type RecordedEvent = EventRecord;\n\nexport type MessageCreated = {\n  messageId: string;\n  kind: Exclude<EventKind, \"turn_end\">;\n} | null;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// (the first such call through the operation context; turns.applyEvent\n// follows the pattern in Story 4). Synchronous and throwing by design: a\n// projection failure propagates to the pipeline's catch and rejects the\n// whole batch — recorded events without messages is the stranded state the\n// transaction exists to prevent. Returns null for turn_end (no message).\n// turnId is the membership stamp, settled by the pipeline before this call:\n// the turn open *after* this event's transition (so a prompt belongs to the\n// turn it just opened), or null in a gap — written once, never updated.\nexport function createFromEvent(\n  ctx: OperationContext,\n  event: RecordedEvent,\n  turnId: string | null,\n): MessageCreated {\n  const projected = projectEvent(event);\n  if (projected === null) return null;\n  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n  const messageId = `m${event.eventOrder}`;\n  insertMessage(ctx.db, {\n    messageId,\n    sourceEventOrder: event.eventOrder,\n    kind,\n    tokenEstimate: projected.tokenEstimate,\n    actor: event.actor,\n    harness: event.harness,\n    turnId,\n    blocks: projected.blocks,\n  });\n  return { messageId, kind };\n}\n\n// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n// result queues tool_result_summary, nothing else queues anything — text,\n// thinking, and note messages are not derivation sources (AC-2.8, AC-2.7's\n// TC-2.9 half). Cross-domain surface, called by intake-stream inside the\n// batch transaction for every recorded message, so the item commits (or\n// rolls back) with the batch.\nconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n  user_prompt: \"prompt_smoothing\",\n  tool_result: \"tool_result_summary\",\n};\n\n// Which derived form each message-owned kind produces — the owning domain's\n// knowledge, handed to the meaning-blind enqueue so the form's pending row\n// rides the same transaction (DD-5).\nconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n  prompt_smoothing: \"smoothed_prompt\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Message-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6). Empty until Story 2 lands prompt smoothing and the\n// two tool summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {};\n\nexport function queueMessageWork(\n  ctx: OperationContext,\n  message: MessageCreated,\n): WorkItemRecord[] {\n  if (message === null) return [];\n  const kind = MESSAGE_WORK_KINDS[message.kind];\n  if (kind === undefined) return [];\n  const form = MESSAGE_WORK_FORMS[kind];\n  if (form === undefined) {\n    // Every queuing kind names its form above; a miss is a wiring bug.\n    throw new Error(`no derived form mapped for message work kind ${kind}`);\n  }\n  const item = enqueue(ctx, {\n    owner: \"messages\",\n    kind,\n    sourceRef: { messageId: message.messageId },\n    forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n  });\n  return [item];\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listMessages(\n  thread: ThreadRef,\n): Promise<OpResult<MessageRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file and migrates\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\n  // unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: readMessages(db) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`message read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"messages\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":180,"startLine":1,"totalLines":180}}}

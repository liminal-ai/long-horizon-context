{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FZi7yoLWqSSGKn9MhKvHm4","type":"tool_result","content":"1\t// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\n2\t// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\n3\t// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\n4\t// unknown-kind handling, both host modes, and coalesced background\n5\t// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\n6\t// CLI parity) live in cli-process-work.test.ts.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  countLiveItems,\n10\t  createSdk,\n11\t  intakeStream,\n12\t  queueDetail,\n13\t  setSchedulerPoke,\n14\t  setThreadTouch,\n15\t  threads,\n16\t  type DrainReport,\n17\t  type Lhc,\n18\t  type MessageEventInput,\n19\t} from \"../src/index.js\";\n20\timport {\n21\t  createProviderDouble,\n22\t  openRaw,\n23\t  readDerivedForms,\n24\t  registerTestWorkHandlers,\n25\t  tempStore,\n26\t  validEvent,\n27\t  type TempStore,\n28\t  type ProviderDouble,\n29\t} from \"./fixtures/index.js\";\n30\t\n31\tfunction sleep(ms: number): Promise<void> {\n32\t  return new Promise((resolve) => setTimeout(resolve, ms));\n33\t}\n34\t\n35\tlet store: TempStore;\n36\tbeforeEach(() => {\n37\t  store = tempStore();\n38\t});\n39\tafterEach(() => {\n40\t  // Background-mode SDKs install process-wide seams at construction; tests\n41\t  // must not leak them into each other.\n42\t  setSchedulerPoke(null);\n43\t  setThreadTouch(null);\n44\t  store.cleanup();\n45\t});\n46\t\n47\tasync function newThread(): Promise<{ threadId: string; filePath: string }> {\n48\t  const created = await threads.newThread({\n49\t    filePath: store.threadPath(),\n50\t    registryPath: store.registryPath,\n51\t  });\n52\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n53\t  return created.value;\n54\t}\n55\t\n56\tasync function send(\n57\t  sdk: Lhc,\n58\t  filePath: string,\n59\t  batch: readonly MessageEventInput[],\n60\t): Promise<void> {\n61\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n62\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n63\t}\n64\t\n65\tfunction manualSdk(\n66\t  double: ProviderDouble,\n67\t  overrides: {\n68\t    clock?: () => Date;\n69\t    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n70\t  } = {},\n71\t): Lhc {\n72\t  const sdk = createSdk({\n73\t    provider: double,\n74\t    mode: \"manual\",\n75\t    clock: overrides.clock ?? (() => new Date()),\n76\t    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n77\t    lease: { durationMs: 200 },\n78\t  });\n79\t  registerTestWorkHandlers(sdk, double);\n80\t  return sdk;\n81\t}\n82\t\n83\tasync function drain(\n84\t  sdk: Lhc,\n85\t  filePath: string,\n86\t  opts?: { maxItems?: number },\n87\t): Promise<DrainReport> {\n88\t  const result = await sdk.work.drain({ filePath }, opts);\n89\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n90\t  return result.value;\n91\t}\n92\t\n93\tfunction liveCount(filePath: string): number {\n94\t  const db = openRaw(filePath);\n95\t  try {\n96\t    return countLiveItems(db);\n97\t  } finally {\n98\t    db.close();\n99\t  }\n100\t}\n101\t\n102\tfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n103\t  const db = openRaw(filePath);\n104\t  try {\n105\t    return queueDetail(db);\n106\t  } finally {\n107\t    db.close();\n108\t  }\n109\t}\n110\t\n111\tdescribe(\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\", () => {\n112\t  it(\"three items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\", async () => {\n113\t    const double = createProviderDouble();\n114\t    let tick = 0;\n115\t    const base = Date.parse(\"2026-06-10T12:00:00.000Z\");\n116\t    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\n117\t    const { filePath } = await newThread();\n118\t    await send(sdk, filePath, [\n119\t      validEvent(\"user_prompt\"),\n120\t      validEvent(\"tool_call\"),\n121\t      validEvent(\"tool_result\"),\n122\t      validEvent(\"turn_end\"),\n123\t    ]);\n124\t    expect(liveCount(filePath)).toBe(3);\n125\t\n126\t    const report = await drain(sdk, filePath);\n127\t    // Queue order across owners: m1's smoothing, m3's result summary, then\n128\t    // the turn derivation queued at close — never reordered.\n129\t    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\n130\t      \"w-m1-prompt_smoothing-v1\",\n131\t      \"w-m3-tool_result_summary-v1\",\n132\t      \"w-t1-turn_derivation-v1\",\n133\t    ]);\n134\t    expect(report.ran.map((entry) => entry.disposition)).toEqual([\"done\", \"done\", \"done\"]);\n135\t    expect(report.stoppedBecause).toBe(\"empty\");\n136\t    expect(report.remaining).toBe(0);\n137\t\n138\t    // DD-1 storage contract: terminal rows are gone — the report is the only\n139\t    // place the dispositions exist (raw zero-row read).\n140\t    expect(liveCount(filePath)).toBe(0);\n141\t    const db = openRaw(filePath);\n142\t    try {\n143\t      const rows = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as {\n144\t        n: number | bigint;\n145\t      };\n146\t      expect(Number(rows.n)).toBe(0);\n147\t    } finally {\n148\t      db.close();\n149\t    }\n150\t\n151\t    // Artifacts landed in run order: derivedAt strictly monotone with the\n152\t    // injected clock from m1 to m3 to the turn's forms.\n153\t    const forms = readDerivedForms(filePath);\n154\t    expect(forms.map((form) => form.state)).toEqual([\"ready\", \"ready\", \"ready\", \"ready\"]);\n155\t    const at = (subjectId: string, form: string): number => {\n156\t      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\n157\t      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\n158\t      return Date.parse(row.derivedAt);\n159\t    };\n160\t    expect(at(\"m1\", \"smoothed_prompt\")).toBeLessThan(at(\"m3\", \"tool_result_summary\"));\n161\t    expect(at(\"m3\", \"tool_result_summary\")).toBeLessThan(at(\"t1\", \"turn_rendering\"));\n162\t    expect(at(\"t1\", \"turn_rendering\")).toBe(at(\"t1\", \"lower_band_projection\"));\n163\t  });\n164\t});\n165\t\n166\tdescribe(\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\", () => {\n167\t  it(\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\", async () => {\n168\t    const double = createProviderDouble();\n169\t    double.delayKind(\"prompt_smoothing\", 100);\n170\t    const sdk = createSdk({\n171\t      provider: double,\n172\t      mode: \"background\",\n173\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n174\t      lease: { durationMs: 1000 },\n175\t    });\n176\t    registerTestWorkHandlers(sdk, double);\n177\t    const { threadId, filePath } = await newThread();\n178\t\n179\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch A\" } })]);\n180\t    // Let the poked drain start (it defers one macrotask), then queue two\n181\t    // more batches while item A's slow handler is in flight.\n182\t    await sleep(10);\n183\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch B\" } })]);\n184\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch C\" } })]);\n185\t\n186\t    await sdk.drainSettled({ filePath });\n187\t\n188\t    // Everything queued mid-drain was processed before the cycle ended…\n189\t    expect(liveCount(filePath)).toBe(0);\n190\t    const smoothed = readDerivedForms(filePath).filter((f) => f.form === \"smoothed_prompt\");\n191\t    expect(smoothed.map((f) => f.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n192\t    // …and the burst coalesced: one initial pass plus exactly one follow-up,\n193\t    // not one pass per poke (the cost model is the assertion).\n194\t    expect(sdk.scheduler.testPassCount(threadId)).toBe(2);\n195\t  });\n196\t});\n197\t\n198\tdescribe(\"TC-1.5 / AC-1.5, AC-1.6: background mode — queueing is sufficient; first touch catches up\", () => {\n199\t  it(\"an intake batch is processed with no drain call; drainSettled is the completion signal\", async () => {\n200\t    const double = createProviderDouble();\n201\t    const sdk = createSdk({\n202\t      provider: double,\n203\t      mode: \"background\",\n204\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n205\t      lease: { durationMs: 1000 },\n206\t    });\n207\t    registerTestWorkHandlers(sdk, double);\n208\t    const { filePath } = await newThread();\n209\t\n210\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n211\t    await sdk.drainSettled({ filePath });\n212\t\n213\t    const forms = readDerivedForms(filePath);\n214\t    expect(forms.map((f) => `${f.subjectId}/${f.form}/${f.state}`).sort()).toEqual([\n215\t      \"m1/smoothed_prompt/ready\",\n216\t      \"t1/lower_band_projection/ready\",\n217\t      \"t1/turn_rendering/ready\",\n218\t    ]);\n219\t    expect(liveCount(filePath)).toBe(0);\n220\t  });\n221\t\n222\t  it(\"reopening a thread with leftover queued rows runs them on first touch — a read, not a write\", async () => {\n223\t    // Build the leftover state with no background scheduler installed: rows\n224\t    // accumulate exactly as a dead process would have left them.\n225\t    const { filePath } = await newThread();\n226\t    const seeded = await intakeStream.messageEvents({ filePath }, [\n227\t      validEvent(\"user_prompt\"),\n228\t      validEvent(\"turn_end\"),\n229\t    ]);\n230\t    expect(seeded.ok).toBe(true);\n231\t    expect(liveCount(filePath)).toBe(2);\n232\t\n233\t    const double = createProviderDouble();\n234\t    const sdk = createSdk({\n235\t      provider: double,\n236\t      mode: \"background\",\n237\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n238\t      lease: { durationMs: 1000 },\n239\t    });\n240\t    registerTestWorkHandlers(sdk, double);\n241\t\n242\t    // First touch of the thread in this process lifetime: a plain read.\n243\t    const read = await sdk.messages.listMessages({ filePath });\n244\t    expect(read.ok).toBe(true);\n245\t    await sdk.drainSettled({ filePath });\n246\t\n247\t    expect(liveCount(filePath)).toBe(0);\n248\t    const states = readDerivedForms(filePath).map((f) => f.state);\n249\t    expect(states).toEqual([\"ready\", \"ready\", \"ready\"]);\n250\t  });\n251\t});\n252\t\n253\tdescribe(\"TC-1.6 / AC-1.7: manual mode — rows accumulate durably and run only when drain is invoked\", () => {\n254\t  it(\"queued work sits until work.drain; artifacts land after\", async () => {\n255\t    const double = createProviderDouble();\n256\t    const sdk = manualSdk(double);\n257\t    const { filePath } = await newThread();\n258\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n259\t\n260\t    await sleep(100);\n261\t    expect(liveCount(filePath)).toBe(1);\n262\t    expect(liveDetail(filePath)[0]?.status).toBe(\"queued\");\n263\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"pending\"]);\n264\t\n265\t    const report = await drain(sdk, filePath);\n266\t    expect(report.ran).toHaveLength(1);\n267\t    expect(report.ran[0]?.disposition).toBe(\"done\");\n268\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"ready\"]);\n269\t    expect(liveCount(filePath)).toBe(0);\n270\t  });\n271\t});\n272\t\n273\tdescribe(\"TC-1.7 / AC-1.8: an unregistered kind lands failed_terminal with a stable reason and the drain continues\", () => {\n274\t  it(\"a bogus-kind row ahead of a valid item fails with unknown_work_kind; the valid item still runs\", async () => {\n275\t    const double = createProviderDouble();\n276\t    const sdk = manualSdk(double);\n277\t    const { filePath } = await newThread();\n278\t\n279\t    // Raw row with an unregistered kind, queued ahead of any valid work.\n280\t    const db = openRaw(filePath);\n281\t    try {\n282\t      db.prepare(\n283\t        `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n284\t         VALUES ('w-mX-bogus_kind-v1', 'messages', 'bogus_kind', '{\"messageId\":\"mX\"}', 'queued',\n285\t                 '2026-06-10T11:00:00.000Z')`,\n286\t      ).run();\n287\t    } finally {\n288\t      db.close();\n289\t    }\n290\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n291\t\n292\t    const report = await drain(sdk, filePath);\n293\t    expect(report.ran).toHaveLength(2);\n294\t    expect(report.ran[0]).toMatchObject({\n295\t      workItemId: \"w-mX-bogus_kind-v1\",\n296\t      disposition: \"failed_terminal\",\n297\t      reason: \"unknown_work_kind\",\n298\t    });\n299\t    expect(report.ran[1]).toMatchObject({\n300\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n301\t      disposition: \"done\",\n302\t    });\n303\t    expect(report.stoppedBecause).toBe(\"empty\");\n304\t    expect(liveCount(filePath)).toBe(0);\n305\t    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \"m1\");\n306\t    expect(smoothed?.state).toBe(\"ready\");\n307\t  });\n308\t});\n309\t\n310\tdescribe(\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\", () => {\n311\t  it(\"fails twice then succeeds: artifact ready, report shows attempts=2\", async () => {\n312\t    const double = createProviderDouble();\n313\t    const sdk = manualSdk(double);\n314\t    const { filePath } = await newThread();\n315\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n316\t\n317\t    double.failNext(2, { retryable: true });\n318\t    const report = await drain(sdk, filePath);\n319\t    expect(report.ran).toHaveLength(1);\n320\t    expect(report.ran[0]).toMatchObject({\n321\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n322\t      disposition: \"done\",\n323\t      attempts: 2,\n324\t    });\n325\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"ready\");\n326\t    expect(liveCount(filePath)).toBe(0);\n327\t  });\n328\t\n329\t  it(\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\", async () => {\n330\t    const double = createProviderDouble();\n331\t    const sdk = manualSdk(double);\n332\t    const { filePath } = await newThread();\n333\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n334\t\n335\t    double.failKind(\"prompt_smoothing\", 99, {\n336\t      retryable: true,\n337\t      reason: \"scripted exhaustion (smoothPrompt)\",\n338\t    });\n339\t    const report = await drain(sdk, filePath);\n340\t    expect(report.ran).toHaveLength(2);\n341\t    expect(report.ran[0]).toMatchObject({\n342\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n343\t      disposition: \"failed_terminal\",\n344\t      attempts: 3,\n345\t      reason: \"scripted exhaustion (smoothPrompt)\",\n346\t    });\n347\t    expect(report.ran[1]).toMatchObject({\n348\t      workItemId: \"w-t1-turn_derivation-v1\",\n349\t      disposition: \"done\",\n350\t    });\n351\t\n352\t    const forms = readDerivedForms(filePath);\n353\t    const failed = forms.find((f) => f.form === \"smoothed_prompt\");\n354\t    expect(failed?.state).toBe(\"failed\");\n355\t    expect(failed?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n356\t    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\n357\t    expect(failed?.metadata?.attempts).toBe(3);\n358\t    expect(forms.find((f) => f.form === \"turn_rendering\")?.state).toBe(\"ready\");\n359\t    expect(liveCount(filePath)).toBe(0);\n360\t  });\n361\t\n362\t  it(\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\", async () => {\n363\t    const double = createProviderDouble();\n364\t    let nowMs = Date.parse(\"2026-06-10T12:00:00.000Z\");\n365\t    const sdk = manualSdk(double, {\n366\t      clock: () => new Date(nowMs),\n367\t      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\n368\t    });\n369\t    const { filePath } = await newThread();\n370\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n371\t\n372\t    double.failNext(1, { retryable: true });\n373\t    const first = await drain(sdk, filePath);\n374\t    // The head failed once and is backing off: nothing terminal ran, the\n375\t    // drain stopped on the eligibility gate, and the queue behind the head\n376\t    // was not touched.\n377\t    expect(first.ran).toEqual([]);\n378\t    expect(first.stoppedBecause).toBe(\"waiting\");\n379\t    expect(first.remaining).toBe(2);\n380\t    expect(first.waitingUntil).toBeDefined();\n381\t    expect(Date.parse(first.waitingUntil ?? \"\")).toBeGreaterThan(nowMs);\n382\t\n383\t    const detail = liveDetail(filePath);\n384\t    expect(detail).toHaveLength(2);\n385\t    expect(detail[0]).toMatchObject({\n386\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n387\t      status: \"queued\",\n388\t      attempts: 1,\n389\t    });\n390\t    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\n391\t    // Skip-ahead proof: the eligible item behind the backing-off head was\n392\t    // never claimed.\n393\t    expect(detail[1]).toMatchObject({\n394\t      workItemId: \"w-t1-turn_derivation-v1\",\n395\t      status: \"queued\",\n396\t      attempts: 0,\n397\t    });\n398\t    expect(detail[1]?.claimedAt).toBeUndefined();\n399\t\n400\t    // Pass the gate: the head becomes eligible and the queue drains in order.\n401\t    nowMs += 60000;\n402\t    const second = await drain(sdk, filePath);\n403\t    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n404\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n405\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n406\t    ]);\n407\t    expect(second.ran[0]?.attempts).toBe(1);\n408\t    expect(liveCount(filePath)).toBe(0);\n409\t  });\n410\t\n411\t  it(\"a non-retryable provider failure is terminal immediately\", async () => {\n412\t    const double = createProviderDouble();\n413\t    const sdk = manualSdk(double);\n414\t    const { filePath } = await newThread();\n415\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n416\t\n417\t    double.failNext(1, { retryable: false, reason: \"content refusal (scripted)\" });\n418\t    const report = await drain(sdk, filePath);\n419\t    expect(report.ran[0]).toMatchObject({\n420\t      disposition: \"failed_terminal\",\n421\t      attempts: 1,\n422\t      reason: \"content refusal (scripted)\",\n423\t    });\n424\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"failed\");\n425\t    expect(liveCount(filePath)).toBe(0);\n426\t  });\n427\t\n428\t  it(\"maxItems stops the drain with max_items and reports the remainder\", async () => {\n429\t    const double = createProviderDouble();\n430\t    const sdk = manualSdk(double);\n431\t    const { filePath } = await newThread();\n432\t    await send(sdk, filePath, [\n433\t      validEvent(\"user_prompt\"),\n434\t      validEvent(\"tool_call\"),\n435\t      validEvent(\"tool_result\"),\n436\t      validEvent(\"turn_end\"),\n437\t    ]);\n438\t\n439\t    const report = await drain(sdk, filePath, { maxItems: 1 });\n440\t    expect(report.ran).toHaveLength(1);\n441\t    expect(report.stoppedBecause).toBe(\"max_items\");\n442\t    expect(report.remaining).toBe(2);\n443\t    expect(liveCount(filePath)).toBe(2);\n444\t  });\n445\t});\n446\t"}]},"parent_tool_use_id":null,"session_id":"c424e248-7c12-49e6-8ca7-162e1fb88490","uuid":"eddb0e5d-7624-443b-993b-5af5a5e7edab","timestamp":"2026-06-11T04:16:39.239Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/work-execution.test.ts","content":"// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\n// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\n// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\n// unknown-kind handling, both host modes, and coalesced background\n// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\n// CLI parity) live in cli-process-work.test.ts.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  countLiveItems,\n  createSdk,\n  intakeStream,\n  queueDetail,\n  setSchedulerPoke,\n  setThreadTouch,\n  threads,\n  type DrainReport,\n  type Lhc,\n  type MessageEventInput,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  registerTestWorkHandlers,\n  tempStore,\n  validEvent,\n  type TempStore,\n  type ProviderDouble,\n} from \"./fixtures/index.js\";\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  // Background-mode SDKs install process-wide seams at construction; tests\n  // must not leak them into each other.\n  setSchedulerPoke(null);\n  setThreadTouch(null);\n  store.cleanup();\n});\n\nasync function newThread(): Promise<{ threadId: string; filePath: string }> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value;\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n}\n\nfunction manualSdk(\n  double: ProviderDouble,\n  overrides: {\n    clock?: () => Date;\n    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  } = {},\n): Lhc {\n  const sdk = createSdk({\n    provider: double,\n    mode: \"manual\",\n    clock: overrides.clock ?? (() => new Date()),\n    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 200 },\n  });\n  registerTestWorkHandlers(sdk, double);\n  return sdk;\n}\n\nasync function drain(\n  sdk: Lhc,\n  filePath: string,\n  opts?: { maxItems?: number },\n): Promise<DrainReport> {\n  const result = await sdk.work.drain({ filePath }, opts);\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n  return result.value;\n}\n\nfunction liveCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    return countLiveItems(db);\n  } finally {\n    db.close();\n  }\n}\n\nfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db);\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\", () => {\n  it(\"three items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\", async () => {\n    const double = createProviderDouble();\n    let tick = 0;\n    const base = Date.parse(\"2026-06-10T12:00:00.000Z\");\n    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(liveCount(filePath)).toBe(3);\n\n    const report = await drain(sdk, filePath);\n    // Queue order across owners: m1's smoothing, m3's result summary, then\n    // the turn derivation queued at close — never reordered.\n    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\n      \"w-m1-prompt_smoothing-v1\",\n      \"w-m3-tool_result_summary-v1\",\n      \"w-t1-turn_derivation-v1\",\n    ]);\n    expect(report.ran.map((entry) => entry.disposition)).toEqual([\"done\", \"done\", \"done\"]);\n    expect(report.stoppedBecause).toBe(\"empty\");\n    expect(report.remaining).toBe(0);\n\n    // DD-1 storage contract: terminal rows are gone — the report is the only\n    // place the dispositions exist (raw zero-row read).\n    expect(liveCount(filePath)).toBe(0);\n    const db = openRaw(filePath);\n    try {\n      const rows = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as {\n        n: number | bigint;\n      };\n      expect(Number(rows.n)).toBe(0);\n    } finally {\n      db.close();\n    }\n\n    // Artifacts landed in run order: derivedAt strictly monotone with the\n    // injected clock from m1 to m3 to the turn's forms.\n    const forms = readDerivedForms(filePath);\n    expect(forms.map((form) => form.state)).toEqual([\"ready\", \"ready\", \"ready\", \"ready\"]);\n    const at = (subjectId: string, form: string): number => {\n      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\n      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\n      return Date.parse(row.derivedAt);\n    };\n    expect(at(\"m1\", \"smoothed_prompt\")).toBeLessThan(at(\"m3\", \"tool_result_summary\"));\n    expect(at(\"m3\", \"tool_result_summary\")).toBeLessThan(at(\"t1\", \"turn_rendering\"));\n    expect(at(\"t1\", \"turn_rendering\")).toBe(at(\"t1\", \"lower_band_projection\"));\n  });\n});\n\ndescribe(\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\", () => {\n  it(\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\", async () => {\n    const double = createProviderDouble();\n    double.delayKind(\"prompt_smoothing\", 100);\n    const sdk = createSdk({\n      provider: double,\n      mode: \"background\",\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n      lease: { durationMs: 1000 },\n    });\n    registerTestWorkHandlers(sdk, double);\n    const { threadId, filePath } = await newThread();\n\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch A\" } })]);\n    // Let the poked drain start (it defers one macrotask), then queue two\n    // more batches while item A's slow handler is in flight.\n    await sleep(10);\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch B\" } })]);\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch C\" } })]);\n\n    await sdk.drainSettled({ filePath });\n\n    // Everything queued mid-drain was processed before the cycle ended…\n    expect(liveCount(filePath)).toBe(0);\n    const smoothed = readDerivedForms(filePath).filter((f) => f.form === \"smoothed_prompt\");\n    expect(smoothed.map((f) => f.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n    // …and the burst coalesced: one initial pass plus exactly one follow-up,\n    // not one pass per poke (the cost model is the assertion).\n    expect(sdk.scheduler.testPassCount(threadId)).toBe(2);\n  });\n});\n\ndescribe(\"TC-1.5 / AC-1.5, AC-1.6: background mode — queueing is sufficient; first touch catches up\", () => {\n  it(\"an intake batch is processed with no drain call; drainSettled is the completion signal\", async () => {\n    const double = createProviderDouble();\n    const sdk = createSdk({\n      provider: double,\n      mode: \"background\",\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n      lease: { durationMs: 1000 },\n    });\n    registerTestWorkHandlers(sdk, double);\n    const { filePath } = await newThread();\n\n    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n    await sdk.drainSettled({ filePath });\n\n    const forms = readDerivedForms(filePath);\n    expect(forms.map((f) => `${f.subjectId}/${f.form}/${f.state}`).sort()).toEqual([\n      \"m1/smoothed_prompt/ready\",\n      \"t1/lower_band_projection/ready\",\n      \"t1/turn_rendering/ready\",\n    ]);\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"reopening a thread with leftover queued rows runs them on first touch — a read, not a write\", async () => {\n    // Build the leftover state with no background scheduler installed: rows\n    // accumulate exactly as a dead process would have left them.\n    const { filePath } = await newThread();\n    const seeded = await intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(seeded.ok).toBe(true);\n    expect(liveCount(filePath)).toBe(2);\n\n    const double = createProviderDouble();\n    const sdk = createSdk({\n      provider: double,\n      mode: \"background\",\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n      lease: { durationMs: 1000 },\n    });\n    registerTestWorkHandlers(sdk, double);\n\n    // First touch of the thread in this process lifetime: a plain read.\n    const read = await sdk.messages.listMessages({ filePath });\n    expect(read.ok).toBe(true);\n    await sdk.drainSettled({ filePath });\n\n    expect(liveCount(filePath)).toBe(0);\n    const states = readDerivedForms(filePath).map((f) => f.state);\n    expect(states).toEqual([\"ready\", \"ready\", \"ready\"]);\n  });\n});\n\ndescribe(\"TC-1.6 / AC-1.7: manual mode — rows accumulate durably and run only when drain is invoked\", () => {\n  it(\"queued work sits until work.drain; artifacts land after\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    await sleep(100);\n    expect(liveCount(filePath)).toBe(1);\n    expect(liveDetail(filePath)[0]?.status).toBe(\"queued\");\n    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"pending\"]);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(1);\n    expect(report.ran[0]?.disposition).toBe(\"done\");\n    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"ready\"]);\n    expect(liveCount(filePath)).toBe(0);\n  });\n});\n\ndescribe(\"TC-1.7 / AC-1.8: an unregistered kind lands failed_terminal with a stable reason and the drain continues\", () => {\n  it(\"a bogus-kind row ahead of a valid item fails with unknown_work_kind; the valid item still runs\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n\n    // Raw row with an unregistered kind, queued ahead of any valid work.\n    const db = openRaw(filePath);\n    try {\n      db.prepare(\n        `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n         VALUES ('w-mX-bogus_kind-v1', 'messages', 'bogus_kind', '{\"messageId\":\"mX\"}', 'queued',\n                 '2026-06-10T11:00:00.000Z')`,\n      ).run();\n    } finally {\n      db.close();\n    }\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(2);\n    expect(report.ran[0]).toMatchObject({\n      workItemId: \"w-mX-bogus_kind-v1\",\n      disposition: \"failed_terminal\",\n      reason: \"unknown_work_kind\",\n    });\n    expect(report.ran[1]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      disposition: \"done\",\n    });\n    expect(report.stoppedBecause).toBe(\"empty\");\n    expect(liveCount(filePath)).toBe(0);\n    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \"m1\");\n    expect(smoothed?.state).toBe(\"ready\");\n  });\n});\n\ndescribe(\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\", () => {\n  it(\"fails twice then succeeds: artifact ready, report shows attempts=2\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    double.failNext(2, { retryable: true });\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(1);\n    expect(report.ran[0]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      disposition: \"done\",\n      attempts: 2,\n    });\n    expect(readDerivedForms(filePath)[0]?.state).toBe(\"ready\");\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n\n    double.failKind(\"prompt_smoothing\", 99, {\n      retryable: true,\n      reason: \"scripted exhaustion (smoothPrompt)\",\n    });\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(2);\n    expect(report.ran[0]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      disposition: \"failed_terminal\",\n      attempts: 3,\n      reason: \"scripted exhaustion (smoothPrompt)\",\n    });\n    expect(report.ran[1]).toMatchObject({\n      workItemId: \"w-t1-turn_derivation-v1\",\n      disposition: \"done\",\n    });\n\n    const forms = readDerivedForms(filePath);\n    const failed = forms.find((f) => f.form === \"smoothed_prompt\");\n    expect(failed?.state).toBe(\"failed\");\n    expect(failed?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\n    expect(failed?.metadata?.attempts).toBe(3);\n    expect(forms.find((f) => f.form === \"turn_rendering\")?.state).toBe(\"ready\");\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\", async () => {\n    const double = createProviderDouble();\n    let nowMs = Date.parse(\"2026-06-10T12:00:00.000Z\");\n    const sdk = manualSdk(double, {\n      clock: () => new Date(nowMs),\n      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\n    });\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n\n    double.failNext(1, { retryable: true });\n    const first = await drain(sdk, filePath);\n    // The head failed once and is backing off: nothing terminal ran, the\n    // drain stopped on the eligibility gate, and the queue behind the head\n    // was not touched.\n    expect(first.ran).toEqual([]);\n    expect(first.stoppedBecause).toBe(\"waiting\");\n    expect(first.remaining).toBe(2);\n    expect(first.waitingUntil).toBeDefined();\n    expect(Date.parse(first.waitingUntil ?? \"\")).toBeGreaterThan(nowMs);\n\n    const detail = liveDetail(filePath);\n    expect(detail).toHaveLength(2);\n    expect(detail[0]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      status: \"queued\",\n      attempts: 1,\n    });\n    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\n    // Skip-ahead proof: the eligible item behind the backing-off head was\n    // never claimed.\n    expect(detail[1]).toMatchObject({\n      workItemId: \"w-t1-turn_derivation-v1\",\n      status: \"queued\",\n      attempts: 0,\n    });\n    expect(detail[1]?.claimedAt).toBeUndefined();\n\n    // Pass the gate: the head becomes eligible and the queue drains in order.\n    nowMs += 60000;\n    const second = await drain(sdk, filePath);\n    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n      [\"w-t1-turn_derivation-v1\", \"done\"],\n    ]);\n    expect(second.ran[0]?.attempts).toBe(1);\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"a non-retryable provider failure is terminal immediately\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    double.failNext(1, { retryable: false, reason: \"content refusal (scripted)\" });\n    const report = await drain(sdk, filePath);\n    expect(report.ran[0]).toMatchObject({\n      disposition: \"failed_terminal\",\n      attempts: 1,\n      reason: \"content refusal (scripted)\",\n    });\n    expect(readDerivedForms(filePath)[0]?.state).toBe(\"failed\");\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"maxItems stops the drain with max_items and reports the remainder\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const report = await drain(sdk, filePath, { maxItems: 1 });\n    expect(report.ran).toHaveLength(1);\n    expect(report.stoppedBecause).toBe(\"max_items\");\n    expect(report.remaining).toBe(2);\n    expect(liveCount(filePath)).toBe(2);\n  });\n});\n","numLines":446,"startLine":1,"totalLines":446}}}

{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_01PrQF4o9SuSfNjQaPcSfhoq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Bfj24deEcXtrLzdhF8orfz","name":"Edit","input":{"replace_all":false,"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/tech-utils/work-queue/index.ts","old_string":"// Live items left in the queue — the drain report's `remaining` and the\n// repair report's join source (Story 4).","new_string":"// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n// queued or in flight — for this kind and source at this source version?\n// Runs inside the caller's requeue transaction so the check and the enqueue\n// commit together (anti-shim: a check-then-enqueue split across transactions\n// reintroduces the duplicate-work race). Version-scoped on purpose: a\n// claimed pre-mutation item at an older version is dying work whose\n// completion DD-3 will discard — it must not block the repair.\nexport function hasLiveItem(\n  db: DatabaseSync,\n  kind: WorkKind,\n  sourceRef: WorkSourceRef,\n  sourceVersion: number,\n): boolean {\n  const row = db\n    .prepare(\n      `SELECT 1 FROM work_item\n       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n       LIMIT 1`,\n    )\n    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n  return row !== undefined;\n}\n\n// Live items left in the queue — the drain report's `remaining` and the\n// repair report's join source (Story 4)."},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":676,"cache_read_input_tokens":169765,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":676},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"4302f8e0-45aa-4c50-a77d-76603f819058","request_id":"req_011Cbvv5eZBrd5LavXVonLeM"}

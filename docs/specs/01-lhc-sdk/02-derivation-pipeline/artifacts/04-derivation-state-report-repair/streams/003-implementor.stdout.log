{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B8YFS73kXGJ9aeiB1w3n6S","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport type { OperationContext } from \"../../shared/context.js\";\n3\timport type { FormKind, WorkHandler } from \"../../shared/derivation.js\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n5\timport {\n6\t  enqueue,\n7\t  listItems,\n8\t  type WorkItemRecord,\n9\t  type WorkKind,\n10\t} from \"../../tech-utils/work-queue/index.js\";\n11\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n12\timport {\n13\t  openThreadDatabase,\n14\t  resolveThreadRef,\n15\t  type ThreadRef,\n16\t} from \"../threads/index.js\";\n17\timport type { DerivedForm } from \"../../shared/derivation.js\";\n18\timport { findUnknownOutcomeCallSummary, readMessageForms } from \"./internal/forms.js\";\n19\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n20\timport { projectEvent } from \"./internal/project.js\";\n21\timport { insertMessage, readMessages } from \"./internal/store.js\";\n22\t\n23\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n24\t\n25\texport interface Block {\n26\t  blockType: BlockType;\n27\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n28\t}\n29\t\n30\texport interface MessageRecord {\n31\t  messageId: string;\n32\t  sourceEventOrder: number;\n33\t  kind: Exclude<EventKind, \"turn_end\">;\n34\t  blocks: Block[];\n35\t  tokenEstimate: number;\n36\t  actor: string;\n37\t  harness: string;\n38\t  turnId?: string;\n39\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n40\t  // for messages that are derivation sources — kinds with no derivable form\n41\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n42\t  // never re-derived on read.\n43\t  forms?: DerivedForm[];\n44\t}\n45\t\n46\t// The event as the walk holds it after recording: the validated input plus\n47\t// its server-stamped order and timestamp.\n48\texport type RecordedEvent = EventRecord;\n49\t\n50\texport type MessageCreated = {\n51\t  messageId: string;\n52\t  kind: Exclude<EventKind, \"turn_end\">;\n53\t  // Carried for tool activity only: the pairing key the queue sites need —\n54\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n55\t  toolCallId?: string;\n56\t} | null;\n57\t\n58\t// Cross-domain surface, called by intake-stream inside the batch transaction\n59\t// (the first such call through the operation context; turns.applyEvent\n60\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n61\t// projection failure propagates to the pipeline's catch and rejects the\n62\t// whole batch — recorded events without messages is the stranded state the\n63\t// transaction exists to prevent. Returns null for turn_end (no message).\n64\t// turnId is the membership stamp, settled by the pipeline before this call:\n65\t// the turn open *after* this event's transition (so a prompt belongs to the\n66\t// turn it just opened), or null in a gap — written once, never updated.\n67\texport function createFromEvent(\n68\t  ctx: OperationContext,\n69\t  event: RecordedEvent,\n70\t  turnId: string | null,\n71\t): MessageCreated {\n72\t  const projected = projectEvent(event);\n73\t  if (projected === null) return null;\n74\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n75\t  const messageId = `m${event.eventOrder}`;\n76\t  insertMessage(ctx.db, {\n77\t    messageId,\n78\t    sourceEventOrder: event.eventOrder,\n79\t    kind,\n80\t    tokenEstimate: projected.tokenEstimate,\n81\t    actor: event.actor,\n82\t    harness: event.harness,\n83\t    turnId,\n84\t    blocks: projected.blocks,\n85\t  });\n86\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n87\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n88\t  }\n89\t  return { messageId, kind };\n90\t}\n91\t\n92\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n93\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n94\t// tool result queues tool_result_summary, nothing else queues anything —\n95\t// text, thinking, and note messages are not derivation sources (Epic 01\n96\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n97\t// intake-stream inside the batch transaction for every recorded message, so\n98\t// the item commits (or rolls back) with the batch.\n99\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n100\t  user_prompt: \"prompt_smoothing\",\n101\t  tool_call: \"tool_call_summary\",\n102\t  tool_result: \"tool_result_summary\",\n103\t};\n104\t\n105\t// Which derived form each message-owned kind produces — the owning domain's\n106\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n107\t// rides the same transaction (DD-5).\n108\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n109\t  prompt_smoothing: \"smoothed_prompt\",\n110\t  tool_call_summary: \"tool_call_summary\",\n111\t  tool_result_summary: \"tool_result_summary\",\n112\t};\n113\t\n114\t// Message-owned work handlers, merged into the SDK's dispatch map at\n115\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n116\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n117\t  messageWorkHandlers;\n118\t\n119\texport function queueMessageWork(\n120\t  ctx: OperationContext,\n121\t  message: MessageCreated,\n122\t): WorkItemRecord[] {\n123\t  if (message === null) return [];\n124\t  const items: WorkItemRecord[] = [];\n125\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n126\t  if (kind !== undefined) {\n127\t    const form = MESSAGE_WORK_FORMS[kind];\n128\t    if (form === undefined) {\n129\t      // Every queuing kind names its form above; a miss is a wiring bug.\n130\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n131\t    }\n132\t    items.push(\n133\t      enqueue(ctx, {\n134\t        owner: \"messages\",\n135\t        kind,\n136\t        sourceRef: { messageId: message.messageId },\n137\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n138\t      }),\n139\t    );\n140\t  }\n141\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n142\t  // summary already derived with outcome \"unknown\" means the summary's\n143\t  // source — the call+result pair — completed underneath it; clear and\n144\t  // regenerate at the next source version, in this same batch transaction.\n145\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n146\t  // the common call-and-result-in-one-batch case never triggers, and the\n147\t  // version-scoped item id keeps the requeue idempotent.\n148\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n149\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n150\t    if (stale !== undefined) {\n151\t      items.push(\n152\t        enqueue(ctx, {\n153\t          owner: \"messages\",\n154\t          kind: \"tool_call_summary\",\n155\t          sourceRef: { messageId: stale.messageId },\n156\t          sourceVersion: stale.sourceVersion + 1,\n157\t          forms: [\n158\t            {\n159\t              subjectKind: \"message\",\n160\t              subjectId: stale.messageId,\n161\t              form: \"tool_call_summary\",\n162\t            },\n163\t          ],\n164\t        }),\n165\t      );\n166\t    }\n167\t  }\n168\t  return items;\n169\t}\n170\t\n171\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n172\t  return {\n173\t    ok: false,\n174\t    error: {\n175\t      errorClass: \"caller_error\",\n176\t      code: \"thread_not_found\",\n177\t      reason: `no thread file exists at ${filePath}`,\n178\t    },\n179\t  };\n180\t}\n181\t\n182\texport async function listMessages(\n183\t  thread: ThreadRef,\n184\t): Promise<OpResult<MessageRecord[]>> {\n185\t  const resolved = await resolveThreadRef(thread);\n186\t  if (!resolved.ok) return resolved;\n187\t  const { filePath } = resolved.value;\n188\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n189\t\n190\t  // openThreadDatabase verifies the file is a real thread file and migrates\n191\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n192\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n193\t  // unmutated (F-03-002).\n194\t  const opened = openThreadDatabase(filePath);\n195\t  if (!opened.ok) return opened;\n196\t  const db = opened.value;\n197\t  try {\n198\t    // Form read-back rides the message read (AC-2.1): each record carries\n199\t    // its stored derived forms, attached from one grouped query — the\n200\t    // production path for \"readable alongside the message\".\n201\t    const formsByMessage = readMessageForms(db);\n202\t    const records = readMessages(db).map((record) => {\n203\t      const forms = formsByMessage.get(record.messageId);\n204\t      return forms === undefined ? record : { ...record, forms };\n205\t    });\n206\t    return { ok: true, value: records };\n207\t  } catch (cause) {\n208\t    const reason = cause instanceof Error ? cause.message : String(cause);\n209\t    return storageFailure(`message read-back failed: ${reason}`);\n210\t  } finally {\n211\t    db.close();\n212\t  }\n213\t}\n214\t\n215\texport async function listQueuedWork(\n216\t  thread: ThreadRef,\n217\t): Promise<OpResult<WorkItemRecord[]>> {\n218\t  const resolved = await resolveThreadRef(thread);\n219\t  if (!resolved.ok) return resolved;\n220\t  const { filePath } = resolved.value;\n221\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n222\t\n223\t  const opened = openThreadDatabase(filePath);\n224\t  if (!opened.ok) return opened;\n225\t  const db = opened.value;\n226\t  try {\n227\t    return { ok: true, value: listItems(db, \"messages\") };\n228\t  } catch (cause) {\n229\t    const reason = cause instanceof Error ? cause.message : String(cause);\n230\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n231\t  } finally {\n232\t    db.close();\n233\t  }\n234\t}\n235\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"b8c50ac8-d495-4c96-bdd2-72fda64888cf","timestamp":"2026-06-11T05:16:58.532Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"import { existsSync } from \"node:fs\";\nimport type { OperationContext } from \"../../shared/context.js\";\nimport type { FormKind, WorkHandler } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  listItems,\n  type WorkItemRecord,\n  type WorkKind,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport type { DerivedForm } from \"../../shared/derivation.js\";\nimport { findUnknownOutcomeCallSummary, readMessageForms } from \"./internal/forms.js\";\nimport { messageWorkHandlers } from \"./internal/handlers.js\";\nimport { projectEvent } from \"./internal/project.js\";\nimport { insertMessage, readMessages } from \"./internal/store.js\";\n\nexport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n\nexport interface Block {\n  blockType: BlockType;\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n}\n\nexport interface MessageRecord {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: Exclude<EventKind, \"turn_end\">;\n  blocks: Block[];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  turnId?: string;\n  // The message's derived forms as stored (Epic 02 Story 2): present only\n  // for messages that are derivation sources — kinds with no derivable form\n  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n  // never re-derived on read.\n  forms?: DerivedForm[];\n}\n\n// The event as the walk holds it after recording: the validated input plus\n// its server-stamped order and timestamp.\nexport type RecordedEvent = EventRecord;\n\nexport type MessageCreated = {\n  messageId: string;\n  kind: Exclude<EventKind, \"turn_end\">;\n  // Carried for tool activity only: the pairing key the queue sites need —\n  // tool_result projection runs the AC-2.8 late-result lookup against it.\n  toolCallId?: string;\n} | null;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// (the first such call through the operation context; turns.applyEvent\n// follows the pattern in Story 4). Synchronous and throwing by design: a\n// projection failure propagates to the pipeline's catch and rejects the\n// whole batch — recorded events without messages is the stranded state the\n// transaction exists to prevent. Returns null for turn_end (no message).\n// turnId is the membership stamp, settled by the pipeline before this call:\n// the turn open *after* this event's transition (so a prompt belongs to the\n// turn it just opened), or null in a gap — written once, never updated.\nexport function createFromEvent(\n  ctx: OperationContext,\n  event: RecordedEvent,\n  turnId: string | null,\n): MessageCreated {\n  const projected = projectEvent(event);\n  if (projected === null) return null;\n  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n  const messageId = `m${event.eventOrder}`;\n  insertMessage(ctx.db, {\n    messageId,\n    sourceEventOrder: event.eventOrder,\n    kind,\n    tokenEstimate: projected.tokenEstimate,\n    actor: event.actor,\n    harness: event.harness,\n    turnId,\n    blocks: projected.blocks,\n  });\n  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n    return { messageId, kind, toolCallId: event.payload.toolCallId };\n  }\n  return { messageId, kind };\n}\n\n// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n// tool result queues tool_result_summary, nothing else queues anything —\n// text, thinking, and note messages are not derivation sources (Epic 01\n// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n// intake-stream inside the batch transaction for every recorded message, so\n// the item commits (or rolls back) with the batch.\nconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n  user_prompt: \"prompt_smoothing\",\n  tool_call: \"tool_call_summary\",\n  tool_result: \"tool_result_summary\",\n};\n\n// Which derived form each message-owned kind produces — the owning domain's\n// knowledge, handed to the meaning-blind enqueue so the form's pending row\n// rides the same transaction (DD-5).\nconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n  prompt_smoothing: \"smoothed_prompt\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Message-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6): prompt smoothing and the two tool-activity summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n  messageWorkHandlers;\n\nexport function queueMessageWork(\n  ctx: OperationContext,\n  message: MessageCreated,\n): WorkItemRecord[] {\n  if (message === null) return [];\n  const items: WorkItemRecord[] = [];\n  const kind = MESSAGE_WORK_KINDS[message.kind];\n  if (kind !== undefined) {\n    const form = MESSAGE_WORK_FORMS[kind];\n    if (form === undefined) {\n      // Every queuing kind names its form above; a miss is a wiring bug.\n      throw new Error(`no derived form mapped for message work kind ${kind}`);\n    }\n    items.push(\n      enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef: { messageId: message.messageId },\n        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n      }),\n    );\n  }\n  // Late-result repair (AC-2.8): a tool result landing after its call's\n  // summary already derived with outcome \"unknown\" means the summary's\n  // source — the call+result pair — completed underneath it; clear and\n  // regenerate at the next source version, in this same batch transaction.\n  // One indexed lookup; pending summaries (metadata NULL) never match, so\n  // the common call-and-result-in-one-batch case never triggers, and the\n  // version-scoped item id keeps the requeue idempotent.\n  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n    if (stale !== undefined) {\n      items.push(\n        enqueue(ctx, {\n          owner: \"messages\",\n          kind: \"tool_call_summary\",\n          sourceRef: { messageId: stale.messageId },\n          sourceVersion: stale.sourceVersion + 1,\n          forms: [\n            {\n              subjectKind: \"message\",\n              subjectId: stale.messageId,\n              form: \"tool_call_summary\",\n            },\n          ],\n        }),\n      );\n    }\n  }\n  return items;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listMessages(\n  thread: ThreadRef,\n): Promise<OpResult<MessageRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file and migrates\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\n  // unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    // Form read-back rides the message read (AC-2.1): each record carries\n    // its stored derived forms, attached from one grouped query — the\n    // production path for \"readable alongside the message\".\n    const formsByMessage = readMessageForms(db);\n    const records = readMessages(db).map((record) => {\n      const forms = formsByMessage.get(record.messageId);\n      return forms === undefined ? record : { ...record, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`message read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"messages\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":235,"startLine":1,"totalLines":235}}}

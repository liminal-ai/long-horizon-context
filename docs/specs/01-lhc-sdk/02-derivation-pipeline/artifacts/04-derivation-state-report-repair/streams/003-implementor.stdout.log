{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GLNeJCWZ6igbG2SQEaYpGN","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\timport { runWorkDrain } from \"./work.js\";\n11\t\n12\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n13\t// process stdin. null means interactive (TTY) — distinct from empty input\n14\t// only in how it arises; both are refused with empty_stdin before any SDK\n15\t// call (the SDK itself can never return that code).\n16\texport type StdinReader = () => Promise<string | null>;\n17\t\n18\tasync function readProcessStdin(): Promise<string | null> {\n19\t  if (process.stdin.isTTY) return null;\n20\t  process.stdin.setEncoding(\"utf8\");\n21\t  let data = \"\";\n22\t  for await (const chunk of process.stdin) data += String(chunk);\n23\t  return data;\n24\t}\n25\t\n26\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n27\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n28\t}\n29\t\n30\tconst HELP = `lhc — Long Horizon Context CLI\n31\t\n32\tUsage:\n33\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n34\t  lhc threads resolve --thread-id <id> [--registry <r>]\n35\t  lhc threads list [--registry <r>]\n36\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n37\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n38\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n39\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n40\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n41\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n42\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n43\t\n44\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n45\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n46\t`;\n47\t\n48\tinterface ParsedFlags {\n49\t  threadId?: string;\n50\t  filePath?: string;\n51\t  title?: string;\n52\t  registryPath?: string;\n53\t  maxItems?: string;\n54\t  provider?: string;\n55\t}\n56\t\n57\t// strict parse rejects unknown/misspelled flags so they are named back to the\n58\t// caller, never silently dropped — the CLI boundary matching the SDK's\n59\t// closed-contract strictness. The failure is returned as data (not thrown) so\n60\t// runCli can render it as the structured usage error.\n61\ttype ParseFlagsResult =\n62\t  | { ok: true; flags: ParsedFlags }\n63\t  | { ok: false; unknownFlag: string };\n64\t\n65\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n66\t  let values;\n67\t  try {\n68\t    ({ values } = parseArgs({\n69\t      args: [...args],\n70\t      options: {\n71\t        \"thread-id\": { type: \"string\" },\n72\t        \"file-path\": { type: \"string\" },\n73\t        title: { type: \"string\" },\n74\t        registry: { type: \"string\" },\n75\t        \"max-items\": { type: \"string\" },\n76\t        provider: { type: \"string\" },\n77\t      },\n78\t      strict: true,\n79\t      allowPositionals: true,\n80\t    }));\n81\t  } catch (cause) {\n82\t    const message = cause instanceof Error ? cause.message : String(cause);\n83\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n84\t    // option '--file-pth'); surface that token, falling back to the message.\n85\t    const named = /'([^']+)'/.exec(message);\n86\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n87\t  }\n88\t  const flags: ParsedFlags = {};\n89\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n90\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n91\t  if (typeof values.title === \"string\") flags.title = values.title;\n92\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n93\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n94\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n95\t  return { ok: true, flags };\n96\t}\n97\t\n98\t// The read commands take a thread reference but no stdin; a missing reference\n99\t// is a usage error named before any SDK call, matching the intake commands.\n100\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n101\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n102\t    return renderCliError(\n103\t      \"caller_error\",\n104\t      \"missing_flag\",\n105\t      `${command} requires --thread-id or --file-path`,\n106\t    );\n107\t  }\n108\t  return undefined;\n109\t}\n110\t\n111\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n112\t  if (flags.threadId !== undefined) {\n113\t    return flags.registryPath !== undefined\n114\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n115\t      : { threadId: flags.threadId };\n116\t  }\n117\t  return { filePath: flags.filePath ?? \"\" };\n118\t}\n119\t\n120\texport async function runCli(\n121\t  argv: readonly string[],\n122\t  readStdin: StdinReader = readProcessStdin,\n123\t): Promise<CliResult> {\n124\t  if (argv.length === 0) {\n125\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n126\t  }\n127\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n128\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n129\t  }\n130\t\n131\t  const [group, command, ...rest] = argv;\n132\t  const key = command === undefined ? group : `${group} ${command}`;\n133\t  const parsed = parseFlags(command === undefined ? [] : rest);\n134\t  if (!parsed.ok) {\n135\t    return renderCliError(\n136\t      \"caller_error\",\n137\t      \"unknown_flag\",\n138\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n139\t    );\n140\t  }\n141\t  const flags = parsed.flags;\n142\t\n143\t  switch (key) {\n144\t    case \"threads new-thread\": {\n145\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n146\t      // instead of failing, so the adapter refuses before any SDK call.\n147\t      if (flags.filePath === undefined) {\n148\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n149\t      }\n150\t      const input: Parameters<typeof threads.newThread>[0] = {\n151\t        filePath: flags.filePath,\n152\t      };\n153\t      if (flags.title !== undefined) input.title = flags.title;\n154\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n155\t      return renderResult(await threads.newThread(input));\n156\t    }\n157\t    case \"threads resolve\": {\n158\t      if (flags.threadId === undefined) {\n159\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n160\t      }\n161\t      const input: Parameters<typeof threads.resolve>[0] = {\n162\t        threadId: flags.threadId,\n163\t      };\n164\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n165\t      return renderResult(await threads.resolve(input));\n166\t    }\n167\t    case \"threads list\": {\n168\t      return renderResult(\n169\t        await threads.listThreads(\n170\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n171\t        ),\n172\t      );\n173\t    }\n174\t    case \"intake-stream message-events\": {\n175\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n176\t        return renderCliError(\n177\t          \"caller_error\",\n178\t          \"missing_flag\",\n179\t          \"intake-stream message-events requires --thread-id or --file-path\",\n180\t        );\n181\t      }\n182\t      const text = await readStdin();\n183\t      if (text === null || text.trim() === \"\") {\n184\t        return renderResult(\n185\t          stdinCallerError(\n186\t            \"empty_stdin\",\n187\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n188\t          ),\n189\t        );\n190\t      }\n191\t      let parsed: unknown;\n192\t      try {\n193\t        parsed = JSON.parse(text);\n194\t      } catch (cause) {\n195\t        const detail = cause instanceof Error ? cause.message : String(cause);\n196\t        return renderResult(\n197\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n198\t        );\n199\t      }\n200\t      if (!Array.isArray(parsed)) {\n201\t        return renderResult(\n202\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n203\t        );\n204\t      }\n205\t      return renderResult(\n206\t        await intakeStream.messageEvents(\n207\t          threadRefFrom(flags),\n208\t          parsed as readonly MessageEventInput[],\n209\t        ),\n210\t      );\n211\t    }\n212\t    case \"intake-stream list-events\": {\n213\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n214\t        return renderCliError(\n215\t          \"caller_error\",\n216\t          \"missing_flag\",\n217\t          \"intake-stream list-events requires --th
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JT3z5FGvkz5iFvvVjivfgR","type":"tool_result","content":"1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n2\t// biggest single handler — and the two chunk summaries. turn_derivation\n3\t// composes the rendering from message-level forms (compose.ts), sends it\n4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n5\t// for the version-checked completion write, and runs placement in that same\n6\t// completion transaction via the onApplied hook: open-chunk append, the\n7\t// accumulated close policy, and any close's summary enqueues all ride the\n8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n9\t// summaries or an open chunk — nothing between).\n10\timport type {\n11\t  DependencyGap,\n12\t  HandlerOutcome,\n13\t  HandlerRunContext,\n14\t  WorkHandler,\n15\t} from \"../../../shared/derivation.js\";\n16\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n17\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n18\timport { composeRenderingInput } from \"./compose.js\";\n19\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n20\timport {\n21\t  chunkExists,\n22\t  readMemberMessages,\n23\t  readMemberProjections,\n24\t  readMessageFormRows,\n25\t  readTurnSource,\n26\t} from \"./forms.js\";\n27\t\n28\tfunction sourceDamaged(reason: string): HandlerOutcome {\n29\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n30\t}\n31\t\n32\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n33\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n34\t}\n35\t\n36\tfunction readThreadId(run: HandlerRunContext): string {\n37\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n38\t    | { thread_id: string }\n39\t    | undefined;\n40\t  return row?.thread_id ?? \"\";\n41\t}\n42\t\n43\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n44\t  const turnId = item.sourceRef[\"turnId\"];\n45\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n46\t  const db = run.openDb();\n47\t  const turn = readTurnSource(db, turnId);\n48\t  if (turn === undefined || turn.deleted) {\n49\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n50\t    // would hit nothing; either way the item is terminal against a source\n51\t    // that cannot improve.\n52\t    return sourceDamaged(`turn ${turnId} not found`);\n53\t  }\n54\t  if (turn.status !== \"closed\") {\n55\t    // Derivation is queued only at close; an open turn under a queued item\n56\t    // means the record was interfered with.\n57\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n58\t  }\n59\t\n60\t  // Compose from current message-form states: ready forms verbatim,\n61\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n62\t  // before any provider call, and no transaction is held across them.\n63\t  const messages = readMemberMessages(db, turnId);\n64\t  const forms = readMessageFormRows(\n65\t    db,\n66\t    messages.map((message) => message.messageId),\n67\t  );\n68\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n69\t\n70\t  const rendering = await run.provider.composeTurnRendering({ parts });\n71\t  if (!rendering.ok) return providerFailed(rendering);\n72\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n73\t  if (!projection.ok) return providerFailed(projection);\n74\t\n75\t  // The projection's token count is estimated exactly once, here, as the\n76\t  // artifact lands; placement reads this stored arithmetic and never\n77\t  // re-counts (AC-3.9's determinism input).\n78\t  const projectedTokens = estimateTokens(projection.text);\n79\t  const threadId = readThreadId(run);\n80\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n81\t\n82\t  return {\n83\t    ok: true,\n84\t    forms: [\n85\t      {\n86\t        subjectKind: \"turn\",\n87\t        subjectId: turnId,\n88\t        form: \"turn_rendering\",\n89\t        content: rendering.text,\n90\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n91\t        // Tool-run receipts ride the rendering's metadata, mechanically\n92\t        // restated from the composition input (AC-3.8) — the chunk\n93\t        // summaries read them from here, never from provider prose.\n94\t        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n95\t      },\n96\t      {\n97\t        subjectKind: \"turn\",\n98\t        subjectId: turnId,\n99\t        form: \"lower_band_projection\",\n100\t        content: projection.text,\n101\t      },\n102\t    ],\n103\t    onApplied: (tx) => {\n104\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n105\t      for (const chunkId of placement.closedChunkIds) {\n106\t        enqueueChunkSummaries(\n107\t          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n108\t          chunkId,\n109\t        );\n110\t      }\n111\t    },\n112\t  };\n113\t};\n114\t\n115\t// One read for both summary kinds — member projections in turn order — but\n116\t// two contracts at the provider seam (AC-3.8): detailed receives the\n117\t// members' tool-run receipts (what changed, outcome) read from the\n118\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n119\t// text stripped here so the brief provider call structurally cannot carry\n120\t// it. Two work items, two handlers' runs, independent retry and states. A\n121\t// member whose projection is not ready falls back to nothing and records a\n122\t// gap, mirroring the rendering's fallback rule.\n123\tfunction chunkSummaryHandler(\n124\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n125\t): WorkHandler {\n126\t  return async (run, item) => {\n127\t    const chunkId = item.sourceRef[\"chunkId\"];\n128\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n129\t    const db = run.openDb();\n130\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n131\t\n132\t    const members = readMemberProjections(db, chunkId);\n133\t    const memberProjections: string[] = [];\n134\t    const gaps: DependencyGap[] = [];\n135\t    for (const member of members) {\n136\t      if (member.state === \"ready\" && member.content !== undefined) {\n137\t        memberProjections.push(member.content);\n138\t      } else {\n139\t        memberProjections.push(\"\");\n140\t        gaps.push({\n141\t          subjectKind: \"turn\",\n142\t          subjectId: member.turnId,\n143\t          form: \"lower_band_projection\",\n144\t        });\n145\t      }\n146\t    }\n147\t\n148\t    const result =\n149\t      kind === \"chunk_summary_detailed\"\n150\t        ? await run.provider.summarizeChunkDetailed({\n151\t            memberProjections,\n152\t            memberReceipts: members.map((member) => member.receipts),\n153\t          })\n154\t        : await run.provider.summarizeChunkBrief({\n155\t            memberProjections,\n156\t            memberOutcomes: members.map((member) =>\n157\t              member.receipts.map((receipt) => receipt.outcome),\n158\t            ),\n159\t          });\n160\t    if (!result.ok) return providerFailed(result);\n161\t\n162\t    return {\n163\t      ok: true,\n164\t      forms: [\n165\t        {\n166\t          subjectKind: \"chunk\",\n167\t          subjectId: chunkId,\n168\t          form: kind,\n169\t          content: result.text,\n170\t          ...(gaps.length > 0 ? { gaps } : {}),\n171\t        },\n172\t      ],\n173\t    };\n174\t  };\n175\t}\n176\t\n177\t// The domain's handler table, merged into the SDK dispatch map at\n178\t// construction (DD-6).\n179\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n180\t  turn_derivation: turnDerivationHandler,\n181\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n182\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n183\t};\n184\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"9428d2fc-5c14-417c-92a7-1aaab2ed5890","timestamp":"2026-06-11T05:17:35.541Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/derive.ts","content":"// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n// biggest single handler — and the two chunk summaries. turn_derivation\n// composes the rendering from message-level forms (compose.ts), sends it\n// through composeTurnRendering then projectLowerBand, hands both forms back\n// for the version-checked completion write, and runs placement in that same\n// completion transaction via the onApplied hook: open-chunk append, the\n// accumulated close policy, and any close's summary enqueues all ride the\n// one commit (anti-shim: a crash leaves either a placed turn with queued\n// summaries or an open chunk — nothing between).\nimport type {\n  DependencyGap,\n  HandlerOutcome,\n  HandlerRunContext,\n  WorkHandler,\n} from \"../../../shared/derivation.js\";\nimport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\nimport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\nimport { composeRenderingInput } from \"./compose.js\";\nimport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\nimport {\n  chunkExists,\n  readMemberMessages,\n  readMemberProjections,\n  readMessageFormRows,\n  readTurnSource,\n} from \"./forms.js\";\n\nfunction sourceDamaged(reason: string): HandlerOutcome {\n  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n}\n\nfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n  return { ok: false, retryable: result.retryable, reason: result.reason };\n}\n\nfunction readThreadId(run: HandlerRunContext): string {\n  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    | { thread_id: string }\n    | undefined;\n  return row?.thread_id ?? \"\";\n}\n\nconst turnDerivationHandler: WorkHandler = async (run, item) => {\n  const turnId = item.sourceRef[\"turnId\"];\n  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n  const db = run.openDb();\n  const turn = readTurnSource(db, turnId);\n  if (turn === undefined || turn.deleted) {\n    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    // would hit nothing; either way the item is terminal against a source\n    // that cannot improve.\n    return sourceDamaged(`turn ${turnId} not found`);\n  }\n  if (turn.status !== \"closed\") {\n    // Derivation is queued only at close; an open turn under a queued item\n    // means the record was interfered with.\n    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n  }\n\n  // Compose from current message-form states: ready forms verbatim,\n  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n  // before any provider call, and no transaction is held across them.\n  const messages = readMemberMessages(db, turnId);\n  const forms = readMessageFormRows(\n    db,\n    messages.map((message) => message.messageId),\n  );\n  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n\n  const rendering = await run.provider.composeTurnRendering({ parts });\n  if (!rendering.ok) return providerFailed(rendering);\n  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n  if (!projection.ok) return providerFailed(projection);\n\n  // The projection's token count is estimated exactly once, here, as the\n  // artifact lands; placement reads this stored arithmetic and never\n  // re-counts (AC-3.9's determinism input).\n  const projectedTokens = estimateTokens(projection.text);\n  const threadId = readThreadId(run);\n  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n\n  return {\n    ok: true,\n    forms: [\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"turn_rendering\",\n        content: rendering.text,\n        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n        // Tool-run receipts ride the rendering's metadata, mechanically\n        // restated from the composition input (AC-3.8) — the chunk\n        // summaries read them from here, never from provider prose.\n        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n      },\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"lower_band_projection\",\n        content: projection.text,\n      },\n    ],\n    onApplied: (tx) => {\n      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n      for (const chunkId of placement.closedChunkIds) {\n        enqueueChunkSummaries(\n          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n          chunkId,\n        );\n      }\n    },\n  };\n};\n\n// One read for both summary kinds — member projections in turn order — but\n// two contracts at the provider seam (AC-3.8): detailed receives the\n// members' tool-run receipts (what changed, outcome) read from the\n// renderings' stamped metadata; brief receives outcomes only, the receipt\n// text stripped here so the brief provider call structurally cannot carry\n// it. Two work items, two handlers' runs, independent retry and states. A\n// member whose projection is not ready falls back to nothing and records a\n// gap, mirroring the rendering's fallback rule.\nfunction chunkSummaryHandler(\n  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n): WorkHandler {\n  return async (run, item) => {\n    const chunkId = item.sourceRef[\"chunkId\"];\n    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n    const db = run.openDb();\n    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n\n    const members = readMemberProjections(db, chunkId);\n    const memberProjections: string[] = [];\n    const gaps: DependencyGap[] = [];\n    for (const member of members) {\n      if (member.state === \"ready\" && member.content !== undefined) {\n        memberProjections.push(member.content);\n      } else {\n        memberProjections.push(\"\");\n        gaps.push({\n          subjectKind: \"turn\",\n          subjectId: member.turnId,\n          form: \"lower_band_projection\",\n        });\n      }\n    }\n\n    const result =\n      kind === \"chunk_summary_detailed\"\n        ? await run.provider.summarizeChunkDetailed({\n            memberProjections,\n            memberReceipts: members.map((member) => member.receipts),\n          })\n        : await run.provider.summarizeChunkBrief({\n            memberProjections,\n            memberOutcomes: members.map((member) =>\n              member.receipts.map((receipt) => receipt.outcome),\n            ),\n          });\n    if (!result.ok) return providerFailed(result);\n\n    return {\n      ok: true,\n      forms: [\n        {\n          subjectKind: \"chunk\",\n          subjectId: chunkId,\n          form: kind,\n          content: result.text,\n          ...(gaps.length > 0 ? { gaps } : {}),\n        },\n      ],\n    };\n  };\n}\n\n// The domain's handler table, merged into the SDK dispatch map at\n// construction (DD-6).\nexport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n  turn_derivation: turnDerivationHandler,\n  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n};\n","numLines":184,"startLine":1,"totalLines":184}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SYLvxX8n5NvEi41dC7ctm5","type":"tool_result","content":"1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n2\t// provider seam, and the handler contract. Both owning domains (messages,\n3\t// turns) consume these; neither owns them — the repair report, the mutation\n4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\t\n8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n9\t\n10\texport type FormKind =\n11\t  | \"smoothed_prompt\"\n12\t  | \"tool_call_summary\"\n13\t  | \"tool_result_summary\"\n14\t  | \"turn_rendering\"\n15\t  | \"lower_band_projection\"\n16\t  | \"chunk_summary_detailed\"\n17\t  | \"chunk_summary_brief\";\n18\t\n19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n20\t\n21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n22\t// (isError/presence), never authored by the provider (AC-2.4).\n23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n24\t\n25\t// A composed form's record of a dependency that fell back during composition:\n26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n27\texport interface DependencyGap {\n28\t  subjectKind: SubjectKind;\n29\t  subjectId: string;\n30\t  form: FormKind;\n31\t}\n32\t\n33\t// The read shape for one derived form's state row (DD-2, DD-3).\n34\texport interface DerivedForm {\n35\t  subjectKind: SubjectKind;\n36\t  subjectId: string;\n37\t  form: FormKind;\n38\t  state: DerivedFormState;\n39\t  content?: string; // ready only\n40\t  reason?: string; // failed | blocked\n41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n43\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n44\t  derivedAt?: string;\n45\t}\n46\t\n47\t// One tool call's or result's receipt within a turn's composed account\n48\t// (AC-3.8): the account text — what changed, as composed — plus the\n49\t// mechanically derived outcome. Derived from the composition input, never\n50\t// from provider prose; stamped on the turn_rendering form so the chunk\n51\t// summaries can read receipts machine-readably in turn order.\n52\texport interface ToolRunReceipt {\n53\t  messageId: string;\n54\t  activity: \"tool_call\" | \"tool_result\";\n55\t  account: string;\n56\t  outcome: ToolOutcome;\n57\t}\n58\t\n59\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n60\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n61\t// final attempts/last-error copied from the work item before its row is\n62\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n63\t// lives here).\n64\texport interface DerivedFormMetadata {\n65\t  outcome?: ToolOutcome;\n66\t  receipts?: ToolRunReceipt[];\n67\t  attempts?: number;\n68\t  lastError?: string;\n69\t}\n70\t\n71\t// ── provider seam (DD-7) ─────────────────────────────────────────\n72\t// Every operation returns content or a structured failure carrying\n73\t// retryable-or-not; classification is the adapter's duty.\n74\texport type ProviderResult =\n75\t  | { ok: true; text: string }\n76\t  | { ok: false; retryable: boolean; reason: string };\n77\t\n78\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n79\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n80\t// rather than imported: shared/ may not import domains/.\n81\texport type RenderingPartKind =\n82\t  | \"user_prompt\"\n83\t  | \"assistant_text\"\n84\t  | \"assistant_thinking\"\n85\t  | \"runtime_note\"\n86\t  | \"tool_call\"\n87\t  | \"tool_result\";\n88\t\n89\texport interface RenderingPart {\n90\t  messageId: string;\n91\t  kind: RenderingPartKind;\n92\t  text: string; // ready form content, or raw/truncated fallback\n93\t  fallback: boolean; // true ⇒ gap recorded\n94\t  outcome?: ToolOutcome; // tool activity only\n95\t}\n96\t\n97\texport interface DerivationProvider {\n98\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n99\t  summarizeToolCall(i: {\n100\t    toolName: string;\n101\t    argsJson: string;\n102\t    pairedResult?: { content: string; isError: boolean };\n103\t  }): Promise<ProviderResult>;\n104\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n105\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n106\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n107\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n108\t  // the members' tool-run receipts (what changed, outcome) alongside the\n109\t  // projections; brief receives outcomes only — receipt text is stripped\n110\t  // before the provider is called, so brief structurally cannot leak it.\n111\t  // The receipt fields are optional in the type for callers without member\n112\t  // context (the production chunk handlers always pass them).\n113\t  summarizeChunkDetailed(i: {\n114\t    memberProjections: string[];\n115\t    memberReceipts?: ToolRunReceipt[][];\n116\t  }): Promise<ProviderResult>;\n117\t  summarizeChunkBrief(i: {\n118\t    memberProjections: string[];\n119\t    memberOutcomes?: ToolOutcome[][];\n120\t  }): Promise<ProviderResult>;\n121\t}\n122\t\n123\texport const PROVIDER_OPERATIONS = [\n124\t  \"smoothPrompt\",\n125\t  \"summarizeToolCall\",\n126\t  \"summarizeToolResult\",\n127\t  \"composeTurnRendering\",\n128\t  \"projectLowerBand\",\n129\t  \"summarizeChunkDetailed\",\n130\t  \"summarizeChunkBrief\",\n131\t] as const;\n132\t\n133\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n134\t\n135\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n136\texport interface SdkConfig {\n137\t  provider: DerivationProvider;\n138\t  mode: \"background\" | \"manual\";\n139\t  clock?: () => Date;\n140\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n141\t  lease?: { durationMs: number }; // 120000\n142\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n143\t}\n144\t\n145\t// Every optional filled by createSdk's central defaults.\n146\texport interface ResolvedSdkConfig {\n147\t  provider: DerivationProvider;\n148\t  mode: \"background\" | \"manual\";\n149\t  clock: () => Date;\n150\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n151\t  lease: { durationMs: number };\n152\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n153\t}\n154\t\n155\t// ── handler contract (DD-6; the map's value type) ────────────────\n156\texport interface HandlerRunContext {\n157\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n158\t  provider: DerivationProvider;\n159\t  clock: () => Date;\n160\t  config: ResolvedSdkConfig;\n161\t}\n162\t\n163\t// A successful handler hands its derived-form content back as data; the\n164\t// drain's completion transaction performs the version-checked UPDATE and the\n165\t// item-row deletion atomically (tech design §Mechanics: completion is one\n166\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n167\t// never opens that transaction itself, so the version check and the\n168\t// done/stale_discarded disposition stay in one place — the queue util.\n169\texport interface HandlerFormWrite {\n170\t  subjectKind: SubjectKind;\n171\t  subjectId: string;\n172\t  form: FormKind;\n173\t  content: string;\n174\t  metadata?: DerivedFormMetadata;\n175\t  gaps?: DependencyGap[];\n176\t}\n177\t\n178\t// The completion-transaction hook (Story 3): work that must land atomically\n179\t// with the version-checked form writes — chunk placement and the\n180\t// close→summary enqueues above all. The queue util invokes it inside the\n181\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n182\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n183\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n184\t// crash leaves either a placed turn with its enqueues or nothing — never a\n185\t// derived-but-unplaced turn.\n186\texport interface CompletionTx {\n187\t  db: DatabaseSync;\n188\t  onCommit: (fn: () => void) => void;\n189\t}\n190\t\n191\texport type HandlerOutcome =\n192\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n193\t  | { ok: false; retryable: boolean; reason: string }\n194\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n195\t\n196\t// item is the queue util's WorkItemRecord; typed structurally here so the\n197\t// shared layer does not depend on the util's module (and vice versa stays\n198\t// one-directional: tech-utils imports shared).\n199\texport type WorkHandler = (\n200\t  run: HandlerRunContext,\n201\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n202\t) => Promise<HandlerOutcome>;\n203\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"87b479b4-f682-42a1-8968-ef4d2d87d7f8","timestamp":"2026-06-11T05:17:14.710Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts","content":"// Epic 02 shared vocabulary: the derived-form state machine's types, the\n// provider seam, and the handler contract. Both owning domains (messages,\n// turns) consume these; neither owns them — the repair report, the mutation\n// cascade, and the drain all speak this vocabulary across domain lines, so it\n// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\nimport type { DatabaseSync } from \"node:sqlite\";\n\nexport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n\nexport type FormKind =\n  | \"smoothed_prompt\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_rendering\"\n  | \"lower_band_projection\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\n\nexport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n\n// Outcome on tool-activity summaries — mechanically stamped from the record\n// (isError/presence), never authored by the provider (AC-2.4).\nexport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n\n// A composed form's record of a dependency that fell back during composition:\n// names the source record and the form that was not ready (AC-3.2/3.3).\nexport interface DependencyGap {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\n// The read shape for one derived form's state row (DD-2, DD-3).\nexport interface DerivedForm {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n  content?: string; // ready only\n  reason?: string; // failed | blocked\n  sourceVersion: number; // which version of the source this form derives from (DD-3)\n  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n  derivedAt?: string;\n}\n\n// One tool call's or result's receipt within a turn's composed account\n// (AC-3.8): the account text — what changed, as composed — plus the\n// mechanically derived outcome. Derived from the composition input, never\n// from provider prose; stamped on the turn_rendering form so the chunk\n// summaries can read receipts machine-readably in turn order.\nexport interface ToolRunReceipt {\n  messageId: string;\n  activity: \"tool_call\" | \"tool_result\";\n  account: string;\n  outcome: ToolOutcome;\n}\n\n// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n// final attempts/last-error copied from the work item before its row is\n// deleted (DD-1: the queue is not an audit table; durable outcome detail\n// lives here).\nexport interface DerivedFormMetadata {\n  outcome?: ToolOutcome;\n  receipts?: ToolRunReceipt[];\n  attempts?: number;\n  lastError?: string;\n}\n\n// ── provider seam (DD-7) ─────────────────────────────────────────\n// Every operation returns content or a structured failure carrying\n// retryable-or-not; classification is the adapter's duty.\nexport type ProviderResult =\n  | { ok: true; text: string }\n  | { ok: false; retryable: boolean; reason: string };\n\n// Message kinds a rendering part can carry — mirrors the intake event-kind\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n// rather than imported: shared/ may not import domains/.\nexport type RenderingPartKind =\n  | \"user_prompt\"\n  | \"assistant_text\"\n  | \"assistant_thinking\"\n  | \"runtime_note\"\n  | \"tool_call\"\n  | \"tool_result\";\n\nexport interface RenderingPart {\n  messageId: string;\n  kind: RenderingPartKind;\n  text: string; // ready form content, or raw/truncated fallback\n  fallback: boolean; // true ⇒ gap recorded\n  outcome?: ToolOutcome; // tool activity only\n}\n\nexport interface DerivationProvider {\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult>;\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n  // The two summary inputs differ by contract (AC-3.8): detailed receives\n  // the members' tool-run receipts (what changed, outcome) alongside the\n  // projections; brief receives outcomes only — receipt text is stripped\n  // before the provider is called, so brief structurally cannot leak it.\n  // The receipt fields are optional in the type for callers without member\n  // context (the production chunk handlers always pass them).\n  summarizeChunkDetailed(i: {\n    memberProjections: string[];\n    memberReceipts?: ToolRunReceipt[][];\n  }): Promise<ProviderResult>;\n  summarizeChunkBrief(i: {\n    memberProjections: string[];\n    memberOutcomes?: ToolOutcome[][];\n  }): Promise<ProviderResult>;\n}\n\nexport const PROVIDER_OPERATIONS = [\n  \"smoothPrompt\",\n  \"summarizeToolCall\",\n  \"summarizeToolResult\",\n  \"composeTurnRendering\",\n  \"projectLowerBand\",\n  \"summarizeChunkDetailed\",\n  \"summarizeChunkBrief\",\n] as const;\n\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n\n// ── SDK assembly config (tech design §Interfaces) ────────────────\nexport interface SdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock?: () => Date;\n  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n  lease?: { durationMs: number }; // 120000\n  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n}\n\n// Every optional filled by createSdk's central defaults.\nexport interface ResolvedSdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock: () => Date;\n  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  lease: { durationMs: number };\n  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n}\n\n// ── handler contract (DD-6; the map's value type) ────────────────\nexport interface HandlerRunContext {\n  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n  provider: DerivationProvider;\n  clock: () => Date;\n  config: ResolvedSdkConfig;\n}\n\n// A successful handler hands its derived-form content back as data; the\n// drain's completion transaction performs the version-checked UPDATE and the\n// item-row deletion atomically (tech design §Mechanics: completion is one\n// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n// never opens that transaction itself, so the version check and the\n// done/stale_discarded disposition stay in one place — the queue util.\nexport interface HandlerFormWrite {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  content: string;\n  metadata?: DerivedFormMetadata;\n  gaps?: DependencyGap[];\n}\n\n// The completion-transaction hook (Story 3): work that must land atomically\n// with the version-checked form writes — chunk placement and the\n// close→summary enqueues above all. The queue util invokes it inside the\n// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n// (a stale completion must not place a turn or enqueue summaries); onCommit\n// registrations flush after that COMMIT succeeds and drop on rollback, so a\n// crash leaves either a placed turn with its enqueues or nothing — never a\n// derived-but-unplaced turn.\nexport interface CompletionTx {\n  db: DatabaseSync;\n  onCommit: (fn: () => void) => void;\n}\n\nexport type HandlerOutcome =\n  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n  | { ok: false; retryable: boolean; reason: string }\n  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n\n// item is the queue util's WorkItemRecord; typed structurally here so the\n// shared layer does not depend on the util's module (and vice versa stays\n// one-directional: tech-utils imports shared).\nexport type WorkHandler = (\n  run: HandlerRunContext,\n  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n) => Promise<HandlerOutcome>;\n","numLines":203,"startLine":1,"totalLines":203}}}

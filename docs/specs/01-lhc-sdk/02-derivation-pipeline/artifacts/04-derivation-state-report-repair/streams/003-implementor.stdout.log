{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FkQTiYhBh4T9qPyT2TDwVR","type":"tool_result","content":"1\t// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n2\t// real intake; the multi-state and damaged-source builders then apply the\n3\t// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n4\t// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n5\t// builders wrote; Stories 2/4 confirm the states arise for real\n6\t// (coverage.md cross-story debt).\n7\timport { DatabaseSync } from \"node:sqlite\";\n8\timport {\n9\t  intakeStream,\n10\t  runCli,\n11\t  threads,\n12\t  type DerivedForm,\n13\t  type DerivedFormState,\n14\t  type DependencyGap,\n15\t  type FormKind,\n16\t  type MessageEventInput,\n17\t  type SubjectKind,\n18\t  type ToolOutcome,\n19\t} from \"../../src/index.js\";\n20\timport { setIntakeClock } from \"./intake-seam.js\";\n21\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n22\timport { validEvent, type TempStore } from \"./index.js\";\n23\t\n24\tasync function newThreadFile(store: TempStore): Promise<string> {\n25\t  const filePath = store.threadPath();\n26\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n27\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n28\t  return filePath;\n29\t}\n30\t\n31\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n32\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n33\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n34\t}\n35\t\n36\t// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n37\t// deterministic (t1..tn) per the turn store's id scheme.\n38\texport async function threadWithClosedTurns(\n39\t  store: TempStore,\n40\t  n: number,\n41\t): Promise<{ filePath: string; turnIds: string[] }> {\n42\t  const filePath = await newThreadFile(store);\n43\t  const turnIds: string[] = [];\n44\t  for (let i = 1; i <= n; i += 1) {\n45\t    await send(filePath, [\n46\t      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n47\t      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n48\t      validEvent(\"turn_end\"),\n49\t    ]);\n50\t    turnIds.push(`t${i}`);\n51\t  }\n52\t  return { filePath, turnIds };\n53\t}\n54\t\n55\t// One closed turn containing a tool run: call + result pair by default;\n56\t// error and missing-result variants per the epic's outcome vocabulary.\n57\texport async function threadWithToolRun(\n58\t  store: TempStore,\n59\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n60\t): Promise<{ filePath: string; turnId: string }> {\n61\t  const filePath = await newThreadFile(store);\n62\t  const batch: MessageEventInput[] = [\n63\t    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n64\t    validEvent(\"tool_call\", {\n65\t      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n66\t    }),\n67\t  ];\n68\t  if (opts.missingResult !== true) {\n69\t    batch.push(\n70\t      validEvent(\"tool_result\", {\n71\t        payload: {\n72\t          toolCallId: \"call-fixture-1\",\n73\t          content: opts.resultContent ?? \"contents of notes.txt\",\n74\t          isError: opts.isError ?? false,\n75\t        },\n76\t      }),\n77\t    );\n78\t  }\n79\t  batch.push(validEvent(\"turn_end\"));\n80\t  await send(filePath, batch);\n81\t  return { filePath, turnId: \"t1\" };\n82\t}\n83\t\n84\t// ── chunk read-back (Story 3): raw rows for boundary assertions ──\n85\t\n86\texport interface ChunkSnapshot {\n87\t  chunks: Array<{\n88\t    chunkId: string;\n89\t    chunkOrder: number;\n90\t    status: \"open\" | \"closed\";\n91\t    accumulatedProjectedTokens: number;\n92\t  }>;\n93\t  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\n94\t}\n95\t\n96\texport function readChunks(filePath: string): ChunkSnapshot {\n97\t  const db = new DatabaseSync(filePath);\n98\t  try {\n99\t    const chunks = (\n100\t      db\n101\t        .prepare(\n102\t          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n103\t           FROM chunk ORDER BY chunk_order`,\n104\t        )\n105\t        .all() as unknown as Array<{\n106\t        chunk_id: string;\n107\t        chunk_order: number | bigint;\n108\t        status: string;\n109\t        accumulated_projected_tokens: number | bigint;\n110\t      }>\n111\t    ).map((row) => ({\n112\t      chunkId: row.chunk_id,\n113\t      chunkOrder: Number(row.chunk_order),\n114\t      status: row.status as \"open\" | \"closed\",\n115\t      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n116\t    }));\n117\t    const members = (\n118\t      db\n119\t        .prepare(\n120\t          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n121\t           JOIN chunk c ON c.chunk_id = cm.chunk_id\n122\t           ORDER BY c.chunk_order, cm.member_idx`,\n123\t        )\n124\t        .all() as unknown as Array<{\n125\t        chunk_id: string;\n126\t        turn_id: string;\n127\t        member_idx: number | bigint;\n128\t      }>\n129\t    ).map((row) => ({\n130\t      chunkId: row.chunk_id,\n131\t      turnId: row.turn_id,\n132\t      memberIdx: Number(row.member_idx),\n133\t    }));\n134\t    return { chunks, members };\n135\t  } finally {\n136\t    db.close();\n137\t  }\n138\t}\n139\t\n140\t// ── derived_form read-back and the sanctioned state writer ───────\n141\t\n142\tinterface RawFormRow {\n143\t  subject_kind: string;\n144\t  subject_id: string;\n145\t  form: string;\n146\t  state: string;\n147\t  content: string | null;\n148\t  reason: string | null;\n149\t  metadata: string | null;\n150\t  source_version: number | bigint;\n151\t  gaps: string | null;\n152\t  derived_at: string | null;\n153\t}\n154\t\n155\texport function readDerivedForms(filePath: string): DerivedForm[] {\n156\t  const db = new DatabaseSync(filePath);\n157\t  try {\n158\t    const rows = db\n159\t      .prepare(\n160\t        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n161\t                source_version, gaps, derived_at\n162\t         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n163\t      )\n164\t      .all() as unknown as RawFormRow[];\n165\t    return rows.map((row) => {\n166\t      const record: DerivedForm = {\n167\t        subjectKind: row.subject_kind as SubjectKind,\n168\t        subjectId: row.subject_id,\n169\t        form: row.form as FormKind,\n170\t        state: row.state as DerivedFormState,\n171\t        sourceVersion: Number(row.source_version),\n172\t      };\n173\t      if (row.content !== null) record.content = row.content;\n174\t      if (row.reason !== null) record.reason = row.reason;\n175\t      if (row.metadata !== null) {\n176\t        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n177\t      }\n178\t      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n179\t      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n180\t      return record;\n181\t    });\n182\t  } finally {\n183\t    db.close();\n184\t  }\n185\t}\n186\t\n187\t// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n188\t// are unreachable through the SDK until the drain (Story 1) and handlers\n189\t// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n190\t// enqueue, mirroring the production completion contract.\n191\texport function setFormState(\n192\t  filePath: string,\n193\t  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n194\t  update: {\n195\t    state: DerivedFormState;\n196\t    content?: string;\n197\t    reason?: string;\n198\t    metadata?: { outcome?: ToolOutcome };\n199\t    derivedAt?: string;\n200\t  },\n201\t): void {\n202\t  const db = new DatabaseSync(filePath);\n203\t  try {\n204\t    const changed = db\n205\t      .prepare(\n206\t        `UPDATE derived_form\n207\t         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n208\t         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n209\t      )\n210\t      .run(\n211\t        update.state,\n212\t        update.content ?? null,\n213\t        update.reason ?? null,\n214\t        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n215\t        update.derivedAt ?? null,\n216\t        target.subjectKind,\n217\t        target.subjectId,\n218\t        target.form,\n219\t      );\n220\t    if (Number(changed.changes) !== 1) {\n221\t      throw new Error(\n222\t        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n223\t      );\n224\t    }\n225\t  } finally {\n226\t    db.close();\n227\t  }\n228\t}\n229\t\n230\t// ── multi-state thread: every form state in one file ─────────────\n231\t\n232\texport interface MultiStateClaim {\n233\t  subjectKind: SubjectKind;\n234\t  subjectId: string;\n235\t  form: FormKind;\n236\t  state: DerivedFormState;\n237\t}\n238\t\n239\texport async function multiStateThread(\n240\t  store: TempStore,\n241\t): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n242\t  const filePath = await newThreadFile(store);\n243\t  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n244\t  // form pending; the writes below move a subset into the other three states.\n245\t  await send(filePath, [\n246\t    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n247\t    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n248\t    validEvent(\"tool_call\", {\n249\t      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n250\t    }),\n251\t    validEvent(\"tool_result\", {\n252\t      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n253\t    }),\n254\t    validEvent(\"turn_end\"),\n255\t    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n256\t    validEvent(\"turn_end\"),\n257\t  ]);\n258\t  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n259\t  setFormState(\n260\t    filePath,\n261\t    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n262\t    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n263\t  );\n264\t  // Tool-activity outcome lives in machine-readable metadata, never inside\n265\t  // provider-authored content (FC-0.3).\n266\t  setFormState(\n267\t    filePath,\n268\t    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n269\t    {\n270\t      state: \"ready\",\n271\t      content: \"toolresult(fixture:contents of a.txt)\",\n272\t      metadata: { outcome: \"succeeded\" },\n273\t      derivedAt,\n274\t    },\n275\t  );\n276\t  setFormState(\n277\t    filePath,\n278\t    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n279\t    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n280\t  );\n281\t  setFormState(\n282\t    filePath,\n283\t    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n284\t    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n285\t  );\n286\t  return {\n287\t    filePath,\n288\t    expected: [\n289\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n290\t      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n291\t      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n292\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n293\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n294\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n295\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n296\t    ],\n297\t  };\n298\t}\n299\t\n300\t// ── damaged-source thread (Epic 01 corruption definition) ────────\n301\t\n302\t// A closed turn with its turn_derivation work queued, then the Epic 01\n303\t// two-open-turns corruption — the damage a turn handler must find and the\n304\t// intake pipeline refuses (turn_state_corrupt).\n305\texport async function damagedSourceThread(\n306\t  store: TempStore,\n307\t): Promise<{ filePath: string; turnId: string }> {\n308\t  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n309\t  // Open a second turn through real intake; the corruption writer then adds\n310\t  // another open row — two open turns, the Epic 01 invariant violation.\n311\t  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n312\t  corruptTwoOpenTurns(filePath);\n313\t  const turnId = turnIds[0];\n314\t  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n315\t  return { filePath, turnId };\n316\t}\n317\t\n318\t// ── twin SDK/CLI threads for parity tests ────────────────────────\n319\t\n320\t// The same batch recorded through the SDK entry and the in-process CLI\n321\t// adapter, under one injected clock, so the two files are comparable\n322\t// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n323\t// scope per thread file.\n324\texport async function twinThreads(\n325\t  store: TempStore,\n326\t  batch?: readonly MessageEventInput[],\n327\t): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n328\t  const events =\n329\t    batch ??\n330\t    ([\n331\t      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n332\t      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n333\t      validEvent(\"tool_call\", {\n334\t        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n335\t      }),\n336\t      validEvent(\"tool_result\", {\n337\t        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n338\t      }),\n339\t      validEvent(\"turn_end\"),\n340\t    ] as const);\n341\t\n342\t  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n343\t  try {\n344\t    const sdkPath = await newThreadFile(store);\n345\t    await send(sdkPath, events);\n346\t\n347\t    const cliPath = store.threadPath();\n348\t    const created = await runCli([\n349\t      \"threads\",\n350\t      \"new-thread\",\n351\t      \"--file-path\",\n352\t      cliPath,\n353\t      \"--registry\",\n354\t      store.registryPath,\n355\t    ]);\n356\t    if (created.exitCode !== 0) {\n357\t      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n358\t    }\n359\t    const recorded = await runCli(\n360\t      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n361\t      async () => JSON.stringify(events),\n362\t    );\n363\t    if (recorded.exitCode !== 0) {\n364\t      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n365\t    }\n366\t    return { sdkPath, cliPath, batch: events };\n367\t  } finally {\n368\t    setIntakeClock(null);\n369\t  }\n370\t}\n371\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"3d84ffa7-83b5-4d2f-9d27-62b5ec71995b","timestamp":"2026-06-11T05:17:52.517Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/threads.ts","content":"// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n// real intake; the multi-state and damaged-source builders then apply the\n// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n// builders wrote; Stories 2/4 confirm the states arise for real\n// (coverage.md cross-story debt).\nimport { DatabaseSync } from \"node:sqlite\";\nimport {\n  intakeStream,\n  runCli,\n  threads,\n  type DerivedForm,\n  type DerivedFormState,\n  type DependencyGap,\n  type FormKind,\n  type MessageEventInput,\n  type SubjectKind,\n  type ToolOutcome,\n} from \"../../src/index.js\";\nimport { setIntakeClock } from \"./intake-seam.js\";\nimport { corruptTwoOpenTurns } from \"./corrupt.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\nasync function newThreadFile(store: TempStore): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n  const result = await intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n}\n\n// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n// deterministic (t1..tn) per the turn store's id scheme.\nexport async function threadWithClosedTurns(\n  store: TempStore,\n  n: number,\n): Promise<{ filePath: string; turnIds: string[] }> {\n  const filePath = await newThreadFile(store);\n  const turnIds: string[] = [];\n  for (let i = 1; i <= n; i += 1) {\n    await send(filePath, [\n      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n      validEvent(\"turn_end\"),\n    ]);\n    turnIds.push(`t${i}`);\n  }\n  return { filePath, turnIds };\n}\n\n// One closed turn containing a tool run: call + result pair by default;\n// error and missing-result variants per the epic's outcome vocabulary.\nexport async function threadWithToolRun(\n  store: TempStore,\n  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n): Promise<{ filePath: string; turnId: string }> {\n  const filePath = await newThreadFile(store);\n  const batch: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    }),\n  ];\n  if (opts.missingResult !== true) {\n    batch.push(\n      validEvent(\"tool_result\", {\n        payload: {\n          toolCallId: \"call-fixture-1\",\n          content: opts.resultContent ?? \"contents of notes.txt\",\n          isError: opts.isError ?? false,\n        },\n      }),\n    );\n  }\n  batch.push(validEvent(\"turn_end\"));\n  await send(filePath, batch);\n  return { filePath, turnId: \"t1\" };\n}\n\n// ── chunk read-back (Story 3): raw rows for boundary assertions ──\n\nexport interface ChunkSnapshot {\n  chunks: Array<{\n    chunkId: string;\n    chunkOrder: number;\n    status: \"open\" | \"closed\";\n    accumulatedProjectedTokens: number;\n  }>;\n  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\n}\n\nexport function readChunks(filePath: string): ChunkSnapshot {\n  const db = new DatabaseSync(filePath);\n  try {\n    const chunks = (\n      db\n        .prepare(\n          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n           FROM chunk ORDER BY chunk_order`,\n        )\n        .all() as unknown as Array<{\n        chunk_id: string;\n        chunk_order: number | bigint;\n        status: string;\n        accumulated_projected_tokens: number | bigint;\n      }>\n    ).map((row) => ({\n      chunkId: row.chunk_id,\n      chunkOrder: Number(row.chunk_order),\n      status: row.status as \"open\" | \"closed\",\n      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n    }));\n    const members = (\n      db\n        .prepare(\n          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n           JOIN chunk c ON c.chunk_id = cm.chunk_id\n           ORDER BY c.chunk_order, cm.member_idx`,\n        )\n        .all() as unknown as Array<{\n        chunk_id: string;\n        turn_id: string;\n        member_idx: number | bigint;\n      }>\n    ).map((row) => ({\n      chunkId: row.chunk_id,\n      turnId: row.turn_id,\n      memberIdx: Number(row.member_idx),\n    }));\n    return { chunks, members };\n  } finally {\n    db.close();\n  }\n}\n\n// ── derived_form read-back and the sanctioned state writer ───────\n\ninterface RawFormRow {\n  subject_kind: string;\n  subject_id: string;\n  form: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\nexport function readDerivedForms(filePath: string): DerivedForm[] {\n  const db = new DatabaseSync(filePath);\n  try {\n    const rows = db\n      .prepare(\n        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n                source_version, gaps, derived_at\n         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n      )\n      .all() as unknown as RawFormRow[];\n    return rows.map((row) => {\n      const record: DerivedForm = {\n        subjectKind: row.subject_kind as SubjectKind,\n        subjectId: row.subject_id,\n        form: row.form as FormKind,\n        state: row.state as DerivedFormState,\n        sourceVersion: Number(row.source_version),\n      };\n      if (row.content !== null) record.content = row.content;\n      if (row.reason !== null) record.reason = row.reason;\n      if (row.metadata !== null) {\n        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n      }\n      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n      return record;\n    });\n  } finally {\n    db.close();\n  }\n}\n\n// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n// are unreachable through the SDK until the drain (Story 1) and handlers\n// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n// enqueue, mirroring the production completion contract.\nexport function setFormState(\n  filePath: string,\n  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n  update: {\n    state: DerivedFormState;\n    content?: string;\n    reason?: string;\n    metadata?: { outcome?: ToolOutcome };\n    derivedAt?: string;\n  },\n): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    const changed = db\n      .prepare(\n        `UPDATE derived_form\n         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n      )\n      .run(\n        update.state,\n        update.content ?? null,\n        update.reason ?? null,\n        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n        update.derivedAt ?? null,\n        target.subjectKind,\n        target.subjectId,\n        target.form,\n      );\n    if (Number(changed.changes) !== 1) {\n      throw new Error(\n        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n      );\n    }\n  } finally {\n    db.close();\n  }\n}\n\n// ── multi-state thread: every form state in one file ─────────────\n\nexport interface MultiStateClaim {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n}\n\nexport async function multiStateThread(\n  store: TempStore,\n): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n  const filePath = await newThreadFile(store);\n  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n  // form pending; the writes below move a subset into the other three states.\n  await send(filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n    }),\n    validEvent(\"turn_end\"),\n    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n  );\n  // Tool-activity outcome lives in machine-readable metadata, never inside\n  // provider-authored content (FC-0.3).\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n    {\n      state: \"ready\",\n      content: \"toolresult(fixture:contents of a.txt)\",\n      metadata: { outcome: \"succeeded\" },\n      derivedAt,\n    },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n  );\n  return {\n    filePath,\n    expected: [\n      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n    ],\n  };\n}\n\n// ── damaged-source thread (Epic 01 corruption definition) ────────\n\n// A closed turn with its turn_derivation work queued, then the Epic 01\n// two-open-turns corruption — the damage a turn handler must find and the\n// intake pipeline refuses (turn_state_corrupt).\nexport async function damagedSourceThread(\n  store: TempStore,\n): Promise<{ filePath: string; turnId: string }> {\n  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n  // Open a second turn through real intake; the corruption writer then adds\n  // another open row — two open turns, the Epic 01 invariant violation.\n  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n  corruptTwoOpenTurns(filePath);\n  const turnId = turnIds[0];\n  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n  return { filePath, turnId };\n}\n\n// ── twin SDK/CLI threads for parity tests ────────────────────────\n\n// The same batch recorded through the SDK entry and the in-process CLI\n// adapter, under one injected clock, so the two files are comparable\n// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n// scope per thread file.\nexport async function twinThreads(\n  store: TempStore,\n  batch?: readonly MessageEventInput[],\n): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n  const events =\n    batch ??\n    ([\n      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ] as const);\n\n  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n  try {\n    const sdkPath = await newThreadFile(store);\n    await send(sdkPath, events);\n\n    const cliPath = store.threadPath();\n    const created = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      cliPath,\n      \"--registry\",\n      store.registryPath,\n    ]);\n    if (created.exitCode !== 0) {\n      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n    }\n    const recorded = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n      async () => JSON.stringify(events),\n    );\n    if (recorded.exitCode !== 0) {\n      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n    }\n    return { sdkPath, cliPath, batch: events };\n  } finally {\n    setIntakeClock(null);\n  }\n}\n","numLines":371,"startLine":1,"totalLines":371}}}

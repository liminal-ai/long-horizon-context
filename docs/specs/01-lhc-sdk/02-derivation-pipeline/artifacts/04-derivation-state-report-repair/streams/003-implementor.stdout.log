{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018fSnfE9wjJyFKChErHai2y","type":"tool_result","content":"1\t// Chunk mechanics (Flow 3, DD-9): open-chunk append, the accumulated close\n2\t// policy, and the close→summary enqueues. Placement is pure arithmetic over\n3\t// stored projected token counts — the caller hands in the incoming turn's\n4\t// count, the open chunk carries its accumulated count durably — so identical\n5\t// streams re-chunk identically (AC-3.9): no clock, no inference, no\n6\t// re-estimation at placement time. Everything here runs inside the\n7\t// turn-derivation completion transaction; a crash leaves either a placed\n8\t// turn (with any close's summary enqueues) or nothing.\n9\timport type { DatabaseSync } from \"node:sqlite\";\n10\timport type { OperationContext } from \"../../../shared/context.js\";\n11\timport { enqueue, type WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n12\t\n13\texport interface ChunkPolicy {\n14\t  targetProjectedTokens: number;\n15\t  maxProjectedTokens: number;\n16\t}\n17\t\n18\texport interface PlacementResult {\n19\t  chunkId: string;\n20\t  memberIdx: number;\n21\t  // Chunks closed by this placement, in close order: at most the previous\n22\t  // open chunk (accumulation rule) and then the incoming turn's own chunk\n23\t  // (max rule) — a turn ≥ max arriving behind an open chunk closes both.\n24\t  closedChunkIds: string[];\n25\t  // An explicitly rebuilt turn keeps its placement (membership shrinks only\n26\t  // through Story 6's sanctioned mutation, never re-cuts): a turn already a\n27\t  // member is left exactly where it is and nothing closes.\n28\t  alreadyPlaced: boolean;\n29\t}\n30\t\n31\tinterface OpenChunkRow {\n32\t  chunk_id: string;\n33\t  accumulated_projected_tokens: number | bigint;\n34\t}\n35\t\n36\tfunction memberCount(db: DatabaseSync, chunkId: string): number {\n37\t  const row = db\n38\t    .prepare(`SELECT COUNT(*) AS n FROM chunk_member WHERE chunk_id = ?`)\n39\t    .get(chunkId) as unknown as { n: number | bigint };\n40\t  return Number(row.n);\n41\t}\n42\t\n43\tfunction closeChunk(db: DatabaseSync, chunkId: string): void {\n44\t  db.prepare(`UPDATE chunk SET status = 'closed' WHERE chunk_id = ?`).run(chunkId);\n45\t}\n46\t\n47\tfunction openNextChunk(db: DatabaseSync): string {\n48\t  const row = db.prepare(`SELECT MAX(chunk_order) AS max_order FROM chunk`).get() as\n49\t    | { max_order: number | bigint | null }\n50\t    | undefined;\n51\t  const order = Number(row?.max_order ?? 0) + 1;\n52\t  const chunkId = `c${order}`;\n53\t  db.prepare(\n54\t    `INSERT INTO chunk (chunk_id, chunk_order, status, accumulated_projected_tokens)\n55\t     VALUES (?, ?, 'open', 0)`,\n56\t  ).run(chunkId, order);\n57\t  return chunkId;\n58\t}\n59\t\n60\t// The close policy, golden cases exact (DD-9): when the open chunk's\n61\t// accumulated count plus the incoming turn's would reach the target\n62\t// (inclusive — equality closes), the chunk closes holding its current\n63\t// members and the incoming turn opens the next chunk; a single projection\n64\t// ≥ max closes its own chunk immediately. An empty open chunk always accepts\n65\t// the incoming turn — a chunk never closes empty.\n66\texport function placeTurn(\n67\t  db: DatabaseSync,\n68\t  turnId: string,\n69\t  projectedTokens: number,\n70\t  policy: ChunkPolicy,\n71\t): PlacementResult {\n72\t  const existing = db\n73\t    .prepare(`SELECT chunk_id, member_idx FROM chunk_member WHERE turn_id = ?`)\n74\t    .get(turnId) as unknown as { chunk_id: string; member_idx: number | bigint } | undefined;\n75\t  if (existing !== undefined) {\n76\t    return {\n77\t      chunkId: existing.chunk_id,\n78\t      memberIdx: Number(existing.member_idx),\n79\t      closedChunkIds: [],\n80\t      alreadyPlaced: true,\n81\t    };\n82\t  }\n83\t\n84\t  const closedChunkIds: string[] = [];\n85\t  let open = db\n86\t    .prepare(\n87\t      `SELECT chunk_id, accumulated_projected_tokens FROM chunk\n88\t       WHERE status = 'open' ORDER BY chunk_order DESC LIMIT 1`,\n89\t    )\n90\t    .get() as unknown as OpenChunkRow | undefined;\n91\t\n92\t  if (\n93\t    open !== undefined &&\n94\t    memberCount(db, open.chunk_id) > 0 &&\n95\t    Number(open.accumulated_projected_tokens) + projectedTokens >= policy.targetProjectedTokens\n96\t  ) {\n97\t    // Crossing closes *without* the incoming turn — the v1 bug's fix: the\n98\t    // decision weighs accumulated + incoming, and the incoming turn starts\n99\t    // the next chunk (AC-3.6).\n100\t    closeChunk(db, open.chunk_id);\n101\t    closedChunkIds.push(open.chunk_id);\n102\t    open = undefined;\n103\t  }\n104\t\n105\t  const chunkId = open?.chunk_id ?? openNextChunk(db);\n106\t  const memberIdx = memberCount(db, chunkId);\n107\t  db.prepare(`INSERT INTO chunk_member (chunk_id, turn_id, member_idx) VALUES (?, ?, ?)`).run(\n108\t    chunkId,\n109\t    turnId,\n110\t    memberIdx,\n111\t  );\n112\t  db.prepare(\n113\t    `UPDATE chunk SET accumulated_projected_tokens = accumulated_projected_tokens + ?\n114\t     WHERE chunk_id = ?`,\n115\t  ).run(projectedTokens, chunkId);\n116\t\n117\t  if (projectedTokens >= policy.maxProjectedTokens) {\n118\t    // Max rule (AC-3.7): the projection alone meets the maximum, so the\n119\t    // turn's chunk closes immediately, whatever it holds.\n120\t    closeChunk(db, chunkId);\n121\t    closedChunkIds.push(chunkId);\n122\t  }\n123\t\n124\t  return { chunkId, memberIdx, closedChunkIds, alreadyPlaced: false };\n125\t}\n126\t\n127\t// Closing queues the two summary kinds as two work items with independent\n128\t// retry, states, and re-queue (AC-3.8); both enqueues ride the caller's\n129\t// ambient transaction — the completion commit — per DD-5.\n130\texport function enqueueChunkSummaries(\n131\t  ctx: OperationContext,\n132\t  chunkId: string,\n133\t): WorkItemRecord[] {\n134\t  return ([\"chunk_summary_detailed\", \"chunk_summary_brief\"] as const).map((kind) =>\n135\t    enqueue(ctx, {\n136\t      owner: \"turns\",\n137\t      kind,\n138\t      sourceRef: { chunkId },\n139\t      forms: [{ subjectKind: \"chunk\", subjectId: chunkId, form: kind }],\n140\t    }),\n141\t  );\n142\t}\n143\t\n144\t// Placement read-back for the turns surface (AC-3.5): chunkId + memberIdx by\n145\t// turn, one query, stored values only.\n146\texport function readPlacements(\n147\t  db: DatabaseSync,\n148\t): Map<string, { chunkId: string; memberIdx: number }> {\n149\t  const rows = db\n150\t    .prepare(`SELECT turn_id, chunk_id, member_idx FROM chunk_member`)\n151\t    .all() as unknown as Array<{\n152\t    turn_id: string;\n153\t    chunk_id: string;\n154\t    member_idx: number | bigint;\n155\t  }>;\n156\t  const byTurn = new Map<string, { chunkId: string; memberIdx: number }>();\n157\t  for (const row of rows) {\n158\t    byTurn.set(row.turn_id, { chunkId: row.chunk_id, memberIdx: Number(row.member_idx) });\n159\t  }\n160\t  return byTurn;\n161\t}\n162\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"a977476d-add9-4ebf-af1b-c19d7d8d4a2b","timestamp":"2026-06-11T05:31:09.229Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/chunks.ts","content":"// Chunk mechanics (Flow 3, DD-9): open-chunk append, the accumulated close\n// policy, and the close→summary enqueues. Placement is pure arithmetic over\n// stored projected token counts — the caller hands in the incoming turn's\n// count, the open chunk carries its accumulated count durably — so identical\n// streams re-chunk identically (AC-3.9): no clock, no inference, no\n// re-estimation at placement time. Everything here runs inside the\n// turn-derivation completion transaction; a crash leaves either a placed\n// turn (with any close's summary enqueues) or nothing.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../../shared/context.js\";\nimport { enqueue, type WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n\nexport interface ChunkPolicy {\n  targetProjectedTokens: number;\n  maxProjectedTokens: number;\n}\n\nexport interface PlacementResult {\n  chunkId: string;\n  memberIdx: number;\n  // Chunks closed by this placement, in close order: at most the previous\n  // open chunk (accumulation rule) and then the incoming turn's own chunk\n  // (max rule) — a turn ≥ max arriving behind an open chunk closes both.\n  closedChunkIds: string[];\n  // An explicitly rebuilt turn keeps its placement (membership shrinks only\n  // through Story 6's sanctioned mutation, never re-cuts): a turn already a\n  // member is left exactly where it is and nothing closes.\n  alreadyPlaced: boolean;\n}\n\ninterface OpenChunkRow {\n  chunk_id: string;\n  accumulated_projected_tokens: number | bigint;\n}\n\nfunction memberCount(db: DatabaseSync, chunkId: string): number {\n  const row = db\n    .prepare(`SELECT COUNT(*) AS n FROM chunk_member WHERE chunk_id = ?`)\n    .get(chunkId) as unknown as { n: number | bigint };\n  return Number(row.n);\n}\n\nfunction closeChunk(db: DatabaseSync, chunkId: string): void {\n  db.prepare(`UPDATE chunk SET status = 'closed' WHERE chunk_id = ?`).run(chunkId);\n}\n\nfunction openNextChunk(db: DatabaseSync): string {\n  const row = db.prepare(`SELECT MAX(chunk_order) AS max_order FROM chunk`).get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  const order = Number(row?.max_order ?? 0) + 1;\n  const chunkId = `c${order}`;\n  db.prepare(\n    `INSERT INTO chunk (chunk_id, chunk_order, status, accumulated_projected_tokens)\n     VALUES (?, ?, 'open', 0)`,\n  ).run(chunkId, order);\n  return chunkId;\n}\n\n// The close policy, golden cases exact (DD-9): when the open chunk's\n// accumulated count plus the incoming turn's would reach the target\n// (inclusive — equality closes), the chunk closes holding its current\n// members and the incoming turn opens the next chunk; a single projection\n// ≥ max closes its own chunk immediately. An empty open chunk always accepts\n// the incoming turn — a chunk never closes empty.\nexport function placeTurn(\n  db: DatabaseSync,\n  turnId: string,\n  projectedTokens: number,\n  policy: ChunkPolicy,\n): PlacementResult {\n  const existing = db\n    .prepare(`SELECT chunk_id, member_idx FROM chunk_member WHERE turn_id = ?`)\n    .get(turnId) as unknown as { chunk_id: string; member_idx: number | bigint } | undefined;\n  if (existing !== undefined) {\n    return {\n      chunkId: existing.chunk_id,\n      memberIdx: Number(existing.member_idx),\n      closedChunkIds: [],\n      alreadyPlaced: true,\n    };\n  }\n\n  const closedChunkIds: string[] = [];\n  let open = db\n    .prepare(\n      `SELECT chunk_id, accumulated_projected_tokens FROM chunk\n       WHERE status = 'open' ORDER BY chunk_order DESC LIMIT 1`,\n    )\n    .get() as unknown as OpenChunkRow | undefined;\n\n  if (\n    open !== undefined &&\n    memberCount(db, open.chunk_id) > 0 &&\n    Number(open.accumulated_projected_tokens) + projectedTokens >= policy.targetProjectedTokens\n  ) {\n    // Crossing closes *without* the incoming turn — the v1 bug's fix: the\n    // decision weighs accumulated + incoming, and the incoming turn starts\n    // the next chunk (AC-3.6).\n    closeChunk(db, open.chunk_id);\n    closedChunkIds.push(open.chunk_id);\n    open = undefined;\n  }\n\n  const chunkId = open?.chunk_id ?? openNextChunk(db);\n  const memberIdx = memberCount(db, chunkId);\n  db.prepare(`INSERT INTO chunk_member (chunk_id, turn_id, member_idx) VALUES (?, ?, ?)`).run(\n    chunkId,\n    turnId,\n    memberIdx,\n  );\n  db.prepare(\n    `UPDATE chunk SET accumulated_projected_tokens = accumulated_projected_tokens + ?\n     WHERE chunk_id = ?`,\n  ).run(projectedTokens, chunkId);\n\n  if (projectedTokens >= policy.maxProjectedTokens) {\n    // Max rule (AC-3.7): the projection alone meets the maximum, so the\n    // turn's chunk closes immediately, whatever it holds.\n    closeChunk(db, chunkId);\n    closedChunkIds.push(chunkId);\n  }\n\n  return { chunkId, memberIdx, closedChunkIds, alreadyPlaced: false };\n}\n\n// Closing queues the two summary kinds as two work items with independent\n// retry, states, and re-queue (AC-3.8); both enqueues ride the caller's\n// ambient transaction — the completion commit — per DD-5.\nexport function enqueueChunkSummaries(\n  ctx: OperationContext,\n  chunkId: string,\n): WorkItemRecord[] {\n  return ([\"chunk_summary_detailed\", \"chunk_summary_brief\"] as const).map((kind) =>\n    enqueue(ctx, {\n      owner: \"turns\",\n      kind,\n      sourceRef: { chunkId },\n      forms: [{ subjectKind: \"chunk\", subjectId: chunkId, form: kind }],\n    }),\n  );\n}\n\n// Placement read-back for the turns surface (AC-3.5): chunkId + memberIdx by\n// turn, one query, stored values only.\nexport function readPlacements(\n  db: DatabaseSync,\n): Map<string, { chunkId: string; memberIdx: number }> {\n  const rows = db\n    .prepare(`SELECT turn_id, chunk_id, member_idx FROM chunk_member`)\n    .all() as unknown as Array<{\n    turn_id: string;\n    chunk_id: string;\n    member_idx: number | bigint;\n  }>;\n  const byTurn = new Map<string, { chunkId: string; memberIdx: number }>();\n  for (const row of rows) {\n    byTurn.set(row.turn_id, { chunkId: row.chunk_id, memberIdx: Number(row.member_idx) });\n  }\n  return byTurn;\n}\n","numLines":162,"startLine":1,"totalLines":162}}}

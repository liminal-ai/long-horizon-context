{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ETKm8Mehwh4NvULh22Y1Sx","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\t\n6\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n7\timport * as messagesDomain from \"./domains/messages/index.js\";\n8\timport * as threadsDomain from \"./domains/threads/index.js\";\n9\timport * as turnsDomain from \"./domains/turns/index.js\";\n10\timport {\n11\t  createScheduler,\n12\t  peekThreadId,\n13\t  runDrain,\n14\t  type DrainDeps,\n15\t  type DrainReport,\n16\t  type Scheduler,\n17\t} from \"./scheduler.js\";\n18\timport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\n19\timport {\n20\t  PROVIDER_OPERATIONS,\n21\t  type ResolvedSdkConfig,\n22\t  type SdkConfig,\n23\t  type WorkHandler,\n24\t} from \"./shared/derivation.js\";\n25\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n26\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n27\t\n28\texport {\n29\t  estimateTokens,\n30\t  TOKEN_ESTIMATOR_ID,\n31\t} from \"./tech-utils/token-counting/index.js\";\n32\t\n33\texport {\n34\t  WORK_KIND_REGISTRY,\n35\t  type WorkItemRecord,\n36\t  type WorkKind,\n37\t  type WorkOwner,\n38\t  type WorkSourceRef,\n39\t} from \"./tech-utils/work-queue/index.js\";\n40\t\n41\texport type {\n42\t  ErrorClass,\n43\t  ErrorCode,\n44\t  ErrorResult,\n45\t  OpResult,\n46\t} from \"./shared/errors.js\";\n47\texport {\n48\t  runInTransaction,\n49\t  setSchedulerPoke,\n50\t  setThreadTouch,\n51\t  type OperationContext,\n52\t} from \"./shared/context.js\";\n53\t\n54\texport {\n55\t  createDeterministicProvider,\n56\t  deterministicOutcomesSuffix,\n57\t  deterministicReceiptsSuffix,\n58\t  deterministicText,\n59\t  type DeterministicOpName,\n60\t} from \"./providers/deterministic.js\";\n61\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n62\t\n63\texport type {\n64\t  CompletionTx,\n65\t  DependencyGap,\n66\t  DerivationProvider,\n67\t  DerivedForm,\n68\t  DerivedFormMetadata,\n69\t  DerivedFormState,\n70\t  FormKind,\n71\t  HandlerFormWrite,\n72\t  HandlerOutcome,\n73\t  HandlerRunContext,\n74\t  ProviderResult,\n75\t  RenderingPart,\n76\t  ResolvedSdkConfig,\n77\t  SdkConfig,\n78\t  SubjectKind,\n79\t  ToolOutcome,\n80\t  ToolRunReceipt,\n81\t  WorkHandler,\n82\t} from \"./shared/derivation.js\";\n83\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n84\texport {\n85\t  countLiveItems,\n86\t  enqueue,\n87\t  queueDetail,\n88\t  supersedeQueued,\n89\t  type ClaimedWorkItem,\n90\t  type EnqueueFormTarget,\n91\t  type EnqueueInput,\n92\t  type QueueDetailRow,\n93\t} from \"./tech-utils/work-queue/index.js\";\n94\t\n95\texport type { ThreadRef } from \"./domains/threads/index.js\";\n96\texport type {\n97\t  Block,\n98\t  BlockType,\n99\t  MessageRecord,\n100\t} from \"./domains/messages/index.js\";\n101\texport type { TurnRecord } from \"./domains/turns/index.js\";\n102\texport type {\n103\t  BatchResult,\n104\t  EventKind,\n105\t  EventRecord,\n106\t  MessageEventInput,\n107\t} from \"./domains/intake-stream/index.js\";\n108\t\n109\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n110\t\n111\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n112\t\n113\t// Merge per-domain handler tables into the one join between the queue's\n114\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n115\t// (each kind has exactly one owner) and throws at construction.\n116\texport function assembleWorkHandlerMap(\n117\t  tables: ReadonlyArray<WorkHandlerMap>,\n118\t): WorkHandlerMap {\n119\t  const map: WorkHandlerMap = {};\n120\t  for (const table of tables) {\n121\t    for (const [kind, handler] of Object.entries(table)) {\n122\t      if (map[kind as WorkKind] !== undefined) {\n123\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n124\t      }\n125\t      map[kind as WorkKind] = handler;\n126\t    }\n127\t  }\n128\t  return map;\n129\t}\n130\t\n131\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n132\t  return {\n133\t    ok: false,\n134\t    error: {\n135\t      errorClass: \"state_corruption\",\n136\t      code: \"unknown_work_kind\",\n137\t      reason: `no handler registered for work kind \"${kind}\"`,\n138\t    },\n139\t  };\n140\t}\n141\t\n142\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n143\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n144\texport function lookupWorkHandler(\n145\t  map: WorkHandlerMap,\n146\t  kind: string,\n147\t): OpResult<WorkHandler> {\n148\t  const handler = map[kind as WorkKind];\n149\t  if (handler === undefined) return unknownWorkKind(kind);\n150\t  return { ok: true, value: handler };\n151\t}\n152\t\n153\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n154\t// requeue land in Story 4.\n155\texport interface WorkSurface {\n156\t  drain(\n157\t    ref: threadsDomain.ThreadRef,\n158\t    opts?: { maxItems?: number },\n159\t  ): Promise<OpResult<DrainReport>>;\n160\t}\n161\t\n162\texport interface Lhc {\n163\t  threads: typeof threadsDomain;\n164\t  intakeStream: typeof intakeStreamDomain;\n165\t  messages: typeof messagesDomain;\n166\t  turns: typeof turnsDomain;\n167\t  config: ResolvedSdkConfig;\n168\t  scheduler: Scheduler;\n169\t  workHandlers: WorkHandlerMap;\n170\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n171\t  work: WorkSurface;\n172\t  // Resolves when the scheduler has no running or pending drain for the\n173\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n174\t  // resolve in manual mode.\n175\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n176\t}\n177\t\n178\tfunction requirePositive(value: number, name: string): void {\n179\t  if (!Number.isFinite(value) || value <= 0) {\n180\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n181\t  }\n182\t}\n183\t\n184\tfunction requireNonNegative(value: number, name: string): void {\n185\t  if (!Number.isFinite(value) || value < 0) {\n186\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n187\t  }\n188\t}\n189\t\n190\t// The only assembly path: provider, mode, clock, and policy enter here.\n191\t// Config mistakes are programmer errors at construction and throw; operating\n192\t// failures after construction return OpResults per the error contract.\n193\texport function createSdk(config: SdkConfig): Lhc {\n194\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n195\t    throw new TypeError(\n196\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n197\t    );\n198\t  }\n199\t  if (config.provider === null || typeof config.provider !== \"object\") {\n200\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n201\t  }\n202\t  for (const operation of PROVIDER_OPERATIONS) {\n203\t    if (typeof config.provider[operation] !== \"function\") {\n204\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n205\t    }\n206\t  }\n207\t\n208\t  const resolved: ResolvedSdkConfig = {\n209\t    provider: config.provider,\n210\t    mode: config.mode,\n211\t    clock: config.clock ?? (() => new Date()),\n212\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n213\t    lease: config.lease ?? { durationMs: 120000 },\n214\t    chunkPolicy:\n215\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n216\t  };\n217\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n218\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n219\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n220\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n221\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n222\t  }\n223\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n224\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n225\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n226\t    throw new TypeError(\n227\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n228\t    );\n229\t  }\n230\t\n231\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n232\t  // The tables are empty until Stories 2–3 land the real handlers; the\n233\t  // assembly mechanics are production code from day one.\n234\t  const workHandlers = assembleWorkHandlerMap([\n235\t    messagesDomain.workHandlers,\n236\t    turnsDomain.workHandlers,\n237\t  ]);\n238\t\n239\t  const drainDeps: DrainDeps = {\n240\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n241\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n242\t    config: resolved,\n243\t  };\n244\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n245\t\n246\t  // Background mode wires the scheduler into the process-wide seams: enqueue\n247\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n248\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n249\t  // constructing a later background SDK supersedes an earlier one (the\n250\t  // displaced scheduler's in-memory state was advisory — the rows remain).\n251\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n252\t  if (resolved.mode === \"background\") {\n253\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n254\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n255\t  }\n256\t\n257\t  const work: WorkSurface = {\n258\t    drain: async (ref, opts) => {\n259\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n260\t      if (!resolvedRef.ok) return resolvedRef;\n261\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n262\t    },\n263\t  };\n264\t\n265\t  return {\n266\t    threads: threadsDomain,\n267\t    intakeStream: intakeStreamDomain,\n268\t    messages: messagesDomain,\n269\t    turns: turnsDomain,\n270\t    config: resolved,\n271\t    scheduler,\n272\t    workHandlers,\n273\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n274\t    work,\n275\t    drainSettled: async (ref) => {\n276\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n277\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n278\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n279\t      if (threadId === null) return;\n280\t      return scheduler.drainSettled(threadId);\n281\t    },\n282\t  };\n283\t}\n284\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"09e237a5-a77c-4f6e-9559-b18f8af089c0","timestamp":"2026-06-11T05:17:18.728Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageRecord,\n} from \"./domains/messages/index.js\";\nexport type { TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // Background mode wires the scheduler into the process-wide seams: enqueue\n  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n  // constructing a later background SDK supersedes an earlier one (the\n  // displaced scheduler's in-memory state was advisory — the rows remain).\n  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: async (ref, opts) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return resolvedRef;\n      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n    },\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: intakeStreamDomain,\n    messages: messagesDomain,\n    turns: turnsDomain,\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":284,"startLine":1,"totalLines":284}}}

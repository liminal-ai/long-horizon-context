{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fgj7PFhjBg3fyCxrJDF434","type":"tool_result","content":"196\t  });\n197\t});\n198\t\n199\tdescribe(\"TC-3.2 / AC-3.2: a non-ready message form falls back and records a gap; the rendering still lands ready\", () => {\n200\t  it(\"failed smoothing → rendering ready with the raw prompt text and a gap naming message and form\", async () => {\n201\t    const double = createProviderDouble();\n202\t    const sdk = manualSdk(double);\n203\t    const filePath = await newThread();\n204\t    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n205\t    await sendTurn(sdk, filePath, \"raw prompt one\", \"answer text\");\n206\t\n207\t    const report = await drain(sdk, filePath);\n208\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n209\t      [\"w-m1-prompt_smoothing-v1\", \"failed_terminal\"],\n210\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n211\t    ]);\n212\t\n213\t    // Message-form gaps degrade the rendering's inputs; they do not fail\n214\t    // the turn: ready, raw text composed, the gap a recorded fact.\n215\t    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\n216\t    expect(rendering?.state).toBe(\"ready\");\n217\t    expect(rendering?.content).toContain(\"raw prompt one\");\n218\t    expect(rendering?.gaps).toEqual([\n219\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n220\t    ]);\n221\t    expect(formOf(filePath, \"t1\", \"lower_band_projection\")?.state).toBe(\"ready\");\n222\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"failed\");\n223\t  });\n224\t});\n225\t\n226\tdescribe(\"TC-3.3 / AC-3.3 (architecture risk): gaps stand after dependency repair; only an explicit rebuild clears them\", () => {\n227\t  it(\"repairing the smoothing changes nothing; re-queueing the rendering rebuilds it without the gap at the next source version\", async () => {\n228\t    const double = createProviderDouble();\n229\t    const sdk = manualSdk(double);\n230\t    const filePath = await newThread();\n231\t    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n232\t    await sendTurn(sdk, filePath, \"gapped prompt\", \"gapped answer\");\n233\t    await drain(sdk, filePath);\n234\t    const gapped = formOf(filePath, \"t1\", \"turn_rendering\");\n235\t    expect(gapped?.state).toBe(\"ready\");\n236\t    expect(gapped?.gaps).toEqual([\n237\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n238\t    ]);\n239\t    const placedBefore = readChunks(filePath);\n240\t\n241\t    // Leg 1: repair the failed smoothing through the queue util (now\n242\t    // healthy — the script above is consumed). The dependent must not move:\n243\t    // no live link, no auto-cascade, no queued turn work.\n244\t    requeueDirect(filePath, {\n245\t      owner: \"messages\",\n246\t      kind: \"prompt_smoothing\",\n247\t      sourceRef: { messageId: \"m1\" },\n248\t      forms: [{ subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" }],\n249\t    });\n250\t    const repairReport = await drain(sdk, filePath);\n251\t    expect(repairReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n252\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n253\t    ]);\n254\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"ready\");\n255\t    // Byte-for-byte: the gapped rendering is exactly the row that landed —\n256\t    // content, gaps, derivedAt, source version, all of it.\n257\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")).toEqual(gapped);\n258\t    expect(liveCount(filePath)).toBe(0);\n259\t\n260\t    // Leg 2: the explicit rebuild — turn_derivation re-queued at the next\n261\t    // source version through the queue util. Gaps recompute from current\n262\t    // dependency states: the smoothing is ready now, so the gap clears.\n263\t    requeueDirect(filePath, {\n264\t      owner: \"turns\",\n265\t      kind: \"turn_derivation\",\n266\t      sourceRef: { turnId: \"t1\" },\n267\t      sourceVersion: 2,\n268\t      forms: [\n269\t        { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n270\t        { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\" },\n271\t      ],\n272\t    });\n273\t    const rebuildReport = await drain(sdk, filePath);\n274\t    expect(rebuildReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n275\t      [\"w-t1-turn_derivation-v2\", \"done\"],\n276\t    ]);\n277\t    const rebuilt = formOf(filePath, \"t1\", \"turn_rendering\");\n278\t    expect(rebuilt?.state).toBe(\"ready\");\n279\t    expect(rebuilt?.sourceVersion).toBe(2);\n280\t    expect(rebuilt?.gaps).toBeUndefined();\n281\t    expect(rebuilt?.content).not.toBe(gapped?.content);\n282\t    // Rebuild keeps placement: membership is never re-cut by derivation —\n283\t    // the turn sits exactly where its first placement put it.\n284\t    expect(readChunks(filePath)).toEqual(placedBefore);\n285\t  });\n286\t});\n287\t\n288\tdescribe(\"TC-3.4 / AC-3.4: tool runs compose as outcome-explicit accounts; a state-changing call's outcome survives\", () => {\n289\t  it(\"a three-call edit run with one isError carries per-call outcomes into the composition input, from the forms\", async () => {\n290\t    const double = createProviderDouble();\n291\t    const captured = double.captureInputs();\n292\t    const sdk = manualSdk(double);\n293\t    const filePath = await newThread();\n294\t    const call = (id: string, path: string) =>\n295\t      validEvent(\"tool_call\", {"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"4e716217-352b-4f21-bd07-f041ac9af101","timestamp":"2026-06-11T05:19:21.279Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-l
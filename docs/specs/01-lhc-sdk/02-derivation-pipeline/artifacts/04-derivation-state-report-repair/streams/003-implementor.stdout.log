{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01231R7vLLtAipRJzWzGpzeA","type":"tool_result","content":"1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n2\t// source turn, the member messages it composes (deleted-filtered — the\n3\t// shared read-filter rule lives here, once for this domain), the\n4\t// message-level form rows composition consumes, and the member projections\n5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n7\t// — no write path here.\n8\timport type { DatabaseSync } from \"node:sqlite\";\n9\timport type { RenderingPartKind, ToolRunReceipt } from \"../../../shared/derivation.js\";\n10\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n11\timport { composeFormKey } from \"./compose.js\";\n12\timport type { FormKind } from \"../../../shared/derivation.js\";\n13\t\n14\texport interface TurnSource {\n15\t  turnId: string;\n16\t  status: \"open\" | \"closed\";\n17\t  deleted: boolean;\n18\t}\n19\t\n20\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n21\t  const row = db\n22\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n23\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n24\t  if (row === undefined) return undefined;\n25\t  return {\n26\t    turnId,\n27\t    status: row.status as TurnSource[\"status\"],\n28\t    deleted: row.deleted_at !== null,\n29\t  };\n30\t}\n31\t\n32\t// Member messages in message order, blocks attached, deleted messages\n33\t// filtered (tech design §Mechanics: composition's member enumeration reads\n34\t// the live projection only).\n35\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n36\t  const messages = db\n37\t    .prepare(\n38\t      `SELECT message_id, kind FROM message\n39\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n40\t    )\n41\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n42\t  const blockStmt = db.prepare(\n43\t    `SELECT block_type, content FROM message_block\n44\t     WHERE message_id = ? ORDER BY block_index`,\n45\t  );\n46\t  return messages.map((message) => {\n47\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n48\t      block_type: string;\n49\t      content: string;\n50\t    }>;\n51\t    return {\n52\t      messageId: message.message_id,\n53\t      kind: message.kind as RenderingPartKind,\n54\t      blocks: blocks.map((block) => ({\n55\t        blockType: block.block_type,\n56\t        content: JSON.parse(block.content) as Record<string, unknown>,\n57\t      })),\n58\t    };\n59\t  });\n60\t}\n61\t\n62\t// The message-owned form rows for a set of member messages, keyed for\n63\t// composition. A cross-owner *read* by design: composition consumes message\n64\t// forms; only message handlers ever write them (DD-2 ownership is a write\n65\t// rule).\n66\texport function readMessageFormRows(\n67\t  db: DatabaseSync,\n68\t  messageIds: readonly string[],\n69\t): Map<string, ComposeFormRow> {\n70\t  const rows = new Map<string, ComposeFormRow>();\n71\t  if (messageIds.length === 0) return rows;\n72\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n73\t  const raw = db\n74\t    .prepare(\n75\t      `SELECT subject_id, form, state, content, metadata FROM derived_form\n76\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n77\t    )\n78\t    .all(...messageIds) as unknown as Array<{\n79\t    subject_id: string;\n80\t    form: string;\n81\t    state: string;\n82\t    content: string | null;\n83\t    metadata: string | null;\n84\t  }>;\n85\t  for (const row of raw) {\n86\t    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n87\t    if (row.content !== null) view.content = row.content;\n88\t    if (row.metadata !== null) {\n89\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n90\t    }\n91\t    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n92\t  }\n93\t  return rows;\n94\t}\n95\t\n96\t// Member projections in turn order for the chunk summaries: member rows by\n97\t// member_idx, deleted turns filtered, each joined to its stored\n98\t// lower_band_projection row (state + content as landed — never re-derived)\n99\t// and to its turn_rendering's mechanically stamped tool-run receipts\n100\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\n101\texport interface MemberProjection {\n102\t  turnId: string;\n103\t  state?: string; // undefined: no projection row exists for the member\n104\t  content?: string;\n105\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n106\t}\n107\t\n108\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n109\t  const rows = db\n110\t    .prepare(\n111\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n112\t       FROM chunk_member cm\n113\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n114\t       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n115\t         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n116\t       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\n117\t         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\n118\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n119\t    )\n120\t    .all(chunkId) as unknown as Array<{\n121\t    turn_id: string;\n122\t    state: string | null;\n123\t    content: string | null;\n124\t    rendering_metadata: string | null;\n125\t  }>;\n126\t  return rows.map((row) => {\n127\t    const metadata =\n128\t      row.rendering_metadata === null\n129\t        ? undefined\n130\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n131\t    const projection: MemberProjection = {\n132\t      turnId: row.turn_id,\n133\t      receipts: metadata?.receipts ?? [],\n134\t    };\n135\t    if (row.state !== null) projection.state = row.state;\n136\t    if (row.content !== null) projection.content = row.content;\n137\t    return projection;\n138\t  });\n139\t}\n140\t\n141\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n142\t  return (\n143\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n144\t  );\n145\t}\n146\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"9b4b81f3-8b15-4a05-b004-542e8cbed47c","timestamp":"2026-06-11T05:17:10.166Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/forms.ts","content":"// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n// source turn, the member messages it composes (deleted-filtered — the\n// shared read-filter rule lives here, once for this domain), the\n// message-level form rows composition consumes, and the member projections\n// the chunk summaries read. Completion writes for turn- and chunk-owned\n// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n// — no write path here.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { RenderingPartKind, ToolRunReceipt } from \"../../../shared/derivation.js\";\nimport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\nimport { composeFormKey } from \"./compose.js\";\nimport type { FormKind } from \"../../../shared/derivation.js\";\n\nexport interface TurnSource {\n  turnId: string;\n  status: \"open\" | \"closed\";\n  deleted: boolean;\n}\n\nexport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n  const row = db\n    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n  if (row === undefined) return undefined;\n  return {\n    turnId,\n    status: row.status as TurnSource[\"status\"],\n    deleted: row.deleted_at !== null,\n  };\n}\n\n// Member messages in message order, blocks attached, deleted messages\n// filtered (tech design §Mechanics: composition's member enumeration reads\n// the live projection only).\nexport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n  const messages = db\n    .prepare(\n      `SELECT message_id, kind FROM message\n       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    )\n    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n  const blockStmt = db.prepare(\n    `SELECT block_type, content FROM message_block\n     WHERE message_id = ? ORDER BY block_index`,\n  );\n  return messages.map((message) => {\n    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n      block_type: string;\n      content: string;\n    }>;\n    return {\n      messageId: message.message_id,\n      kind: message.kind as RenderingPartKind,\n      blocks: blocks.map((block) => ({\n        blockType: block.block_type,\n        content: JSON.parse(block.content) as Record<string, unknown>,\n      })),\n    };\n  });\n}\n\n// The message-owned form rows for a set of member messages, keyed for\n// composition. A cross-owner *read* by design: composition consumes message\n// forms; only message handlers ever write them (DD-2 ownership is a write\n// rule).\nexport function readMessageFormRows(\n  db: DatabaseSync,\n  messageIds: readonly string[],\n): Map<string, ComposeFormRow> {\n  const rows = new Map<string, ComposeFormRow>();\n  if (messageIds.length === 0) return rows;\n  const placeholders = messageIds.map(() => \"?\").join(\", \");\n  const raw = db\n    .prepare(\n      `SELECT subject_id, form, state, content, metadata FROM derived_form\n       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    )\n    .all(...messageIds) as unknown as Array<{\n    subject_id: string;\n    form: string;\n    state: string;\n    content: string | null;\n    metadata: string | null;\n  }>;\n  for (const row of raw) {\n    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n    if (row.content !== null) view.content = row.content;\n    if (row.metadata !== null) {\n      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n    }\n    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n  }\n  return rows;\n}\n\n// Member projections in turn order for the chunk summaries: member rows by\n// member_idx, deleted turns filtered, each joined to its stored\n// lower_band_projection row (state + content as landed — never re-derived)\n// and to its turn_rendering's mechanically stamped tool-run receipts\n// (AC-3.8: the detailed summary's receipt material, read not re-derived).\nexport interface MemberProjection {\n  turnId: string;\n  state?: string; // undefined: no projection row exists for the member\n  content?: string;\n  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n}\n\nexport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n  const rows = db\n    .prepare(\n      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n       FROM chunk_member cm\n       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\n         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\n       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n    )\n    .all(chunkId) as unknown as Array<{\n    turn_id: string;\n    state: string | null;\n    content: string | null;\n    rendering_metadata: string | null;\n  }>;\n  return rows.map((row) => {\n    const metadata =\n      row.rendering_metadata === null\n        ? undefined\n        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n    const projection: MemberProjection = {\n      turnId: row.turn_id,\n      receipts: metadata?.receipts ?? [],\n    };\n    if (row.state !== null) projection.state = row.state;\n    if (row.content !== null) projection.content = row.content;\n    return projection;\n  });\n}\n\nexport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n  return (\n    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n  );\n}\n","numLines":146,"startLine":1,"totalLines":146}}}

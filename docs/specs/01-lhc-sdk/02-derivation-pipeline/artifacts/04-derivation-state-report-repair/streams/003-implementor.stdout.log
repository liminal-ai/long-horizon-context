{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wipweq31a9W5xR52rMkaRx","type":"tool_result","content":"1\t// `lhc work drain` — CLI parity for the drain operation (manual host mode's\n2\t// command surface). Provider resolution per DD-11: explicit `--provider` or\n3\t// LHC_PROVIDER, looked up in the named-provider registry; no default and no\n4\t// silent no-op — an unresolvable provider is a caller error naming both the\n5\t// flag and the env var. Report, requeue, and mutations (later stories) need\n6\t// no provider; only drain dispatches handlers.\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport { registeredProviderNames, resolveNamedProvider } from \"../providers/registry.js\";\n9\timport { createSdk } from \"../sdk.js\";\n10\timport type { DerivationProvider } from \"../shared/derivation.js\";\n11\timport type { ErrorResult, OpResult } from \"../shared/errors.js\";\n12\timport { renderResult, type CliResult } from \"./render.js\";\n13\t\n14\tfunction providerNotConfigured(reason: string): { ok: false; error: ErrorResult } {\n15\t  return {\n16\t    ok: false,\n17\t    error: { errorClass: \"caller_error\", code: \"provider_not_configured\", reason },\n18\t  };\n19\t}\n20\t\n21\texport function resolveCliProvider(\n22\t  providerFlag: string | undefined,\n23\t): OpResult<DerivationProvider> {\n24\t  const name = providerFlag ?? process.env[\"LHC_PROVIDER\"];\n25\t  if (name === undefined || name === \"\") {\n26\t    return providerNotConfigured(\n27\t      \"work drain needs a derivation provider: pass --provider <name> or set LHC_PROVIDER\",\n28\t    );\n29\t  }\n30\t  const provider = resolveNamedProvider(name);\n31\t  if (provider === undefined) {\n32\t    return providerNotConfigured(\n33\t      `no provider registered under \"${name}\" (--provider / LHC_PROVIDER); known: ${registeredProviderNames().join(\", \")}`,\n34\t    );\n35\t  }\n36\t  return { ok: true, value: provider };\n37\t}\n38\t\n39\texport async function runWorkDrain(\n40\t  threadRef: ThreadRef,\n41\t  flags: { provider?: string; maxItems?: number },\n42\t): Promise<CliResult> {\n43\t  const provider = resolveCliProvider(flags.provider);\n44\t  if (!provider.ok) return renderResult(provider);\n45\t  // The CLI is the manual host: it assembles the same SDK production hosts\n46\t  // do and drains through the same surface — no in-process shortcut.\n47\t  const sdk = createSdk({ provider: provider.value, mode: \"manual\" });\n48\t  return renderResult(\n49\t    await sdk.work.drain(\n50\t      threadRef,\n51\t      flags.maxItems !== undefined ? { maxItems: flags.maxItems } : undefined,\n52\t    ),\n53\t  );\n54\t}\n55\t"}]},"parent_tool_use_id":null,"session_id":"d108457a-494d-411f-a3f3-c808224806e9","uuid":"dfd4a614-35b2-45be-a141-550243950979","timestamp":"2026-06-11T05:17:15.233Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/work.ts","content":"// `lhc work drain` — CLI parity for the drain operation (manual host mode's\n// command surface). Provider resolution per DD-11: explicit `--provider` or\n// LHC_PROVIDER, looked up in the named-provider registry; no default and no\n// silent no-op — an unresolvable provider is a caller error naming both the\n// flag and the env var. Report, requeue, and mutations (later stories) need\n// no provider; only drain dispatches handlers.\nimport type { ThreadRef } from \"../domains/threads/index.js\";\nimport { registeredProviderNames, resolveNamedProvider } from \"../providers/registry.js\";\nimport { createSdk } from \"../sdk.js\";\nimport type { DerivationProvider } from \"../shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"../shared/errors.js\";\nimport { renderResult, type CliResult } from \"./render.js\";\n\nfunction providerNotConfigured(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"caller_error\", code: \"provider_not_configured\", reason },\n  };\n}\n\nexport function resolveCliProvider(\n  providerFlag: string | undefined,\n): OpResult<DerivationProvider> {\n  const name = providerFlag ?? process.env[\"LHC_PROVIDER\"];\n  if (name === undefined || name === \"\") {\n    return providerNotConfigured(\n      \"work drain needs a derivation provider: pass --provider <name> or set LHC_PROVIDER\",\n    );\n  }\n  const provider = resolveNamedProvider(name);\n  if (provider === undefined) {\n    return providerNotConfigured(\n      `no provider registered under \"${name}\" (--provider / LHC_PROVIDER); known: ${registeredProviderNames().join(\", \")}`,\n    );\n  }\n  return { ok: true, value: provider };\n}\n\nexport async function runWorkDrain(\n  threadRef: ThreadRef,\n  flags: { provider?: string; maxItems?: number },\n): Promise<CliResult> {\n  const provider = resolveCliProvider(flags.provider);\n  if (!provider.ok) return renderResult(provider);\n  // The CLI is the manual host: it assembles the same SDK production hosts\n  // do and drains through the same surface — no in-process shortcut.\n  const sdk = createSdk({ provider: provider.value, mode: \"manual\" });\n  return renderResult(\n    await sdk.work.drain(\n      threadRef,\n      flags.maxItems !== undefined ? { maxItems: flags.maxItems } : undefined,\n    ),\n  );\n}\n","numLines":55,"startLine":1,"totalLines":55}}}

{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,360p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type {\n     4\t  FormKind,\n     5\t  FormReportEntry,\n     6\t  WorkHandler,\n     7\t} from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type EnqueueFormTarget,\n    14\t  type WorkItemRecord,\n    15\t  type WorkKind,\n    16\t  type WorkSourceRef,\n    17\t} from \"../../tech-utils/work-queue/index.js\";\n    18\timport type { EventKind } from \"../intake-stream/index.js\";\n    19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    20\timport { transition } from \"./internal/state-machine.js\";\n    21\t\n    22\t// The pure rule table, re-exported for the golden supplemental suite (the\n    23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    24\t// callers go through applyEvent.\n    25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    26\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    27\timport { turnWorkHandlers } from \"./internal/derive.js\";\n    28\timport {\n    29\t  readChunkRows,\n    30\t  readOwnedForms,\n    31\t  readTurnFormRow,\n    32\t  reportTurnForms,\n    33\t} from \"./internal/forms.js\";\n    34\timport {\n    35\t  closeTurn,\n    36\t  insertOpenTurn,\n    37\t  nextTurnOrder,\n    38\t  readTurns,\n    39\t  selectOpenTurnIds,\n    40\t} from \"./internal/store.js\";\n    41\t\n    42\texport interface TurnRecord {\n    43\t  turnId: string;\n    44\t  status: \"open\" | \"closed\";\n    45\t  memberMessageIds: string[];\n    46\t  openedAtEventOrder: number;\n    47\t  closedAtEventOrder?: number;\n    48\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n    49\t  // derivation placed it — stored values read back, never recomputed.\n    50\t  chunkId?: string;\n    51\t  memberIdx?: number;\n    52\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n    53\t  // present only when rows exist — a closed turn carries them from the\n    54\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n    55\t  // the message read's forms key; reads degrade, never block.\n    56\t  forms?: DerivedForm[];\n    57\t}\n    58\t\n    59\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n    60\t// record with live membership and its summary forms' states attached —\n    61\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n    62\t// with form states\".\n    63\texport interface ChunkRecord {\n    64\t  chunkId: string;\n    65\t  chunkOrder: number;\n    66\t  status: \"open\" | \"closed\";\n    67\t  accumulatedProjectedTokens: number;\n    68\t  memberTurnIds: string[];\n    69\t  forms?: DerivedForm[];\n    70\t}\n    71\t\n    72\texport interface TurnTransitionOutcome {\n    73\t  // Transitions in occurrence order: a close_then_open reports the close\n    74\t  // first, then the open, exactly as the batch result surfaces them.\n    75\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    76\t  // Turn state after the transition — the stamp for this event's message.\n    77\t  // Prompts see the turn they just opened (transition first, then stamp);\n    78\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    79\t  openTurnId: string | null;\n    80\t  // Work queued by this transition: one turn_derivation item per closed\n    81\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    82\t  queuedWork: WorkItemRecord[];\n    83\t}\n    84\t\n    85\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    86\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    87\t// writes turn state, so more than one open turn means external interference.\n    88\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    89\t  return selectOpenTurnIds(ctx.db);\n    90\t}\n    91\t\n    92\t// Closing a turn — by either close path — durably queues that turn's\n    93\t// derivation work in the same transaction (AC-3.6): the close update and the\n    94\t// work item commit or roll back together.\n    95\tfunction closeTurnAndQueueWork(\n    96\t  ctx: OperationContext,\n    97\t  turnId: string,\n    98\t  eventOrder: number,\n    99\t): WorkItemRecord {\n   100\t  closeTurn(ctx.db, turnId, eventOrder);\n   101\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n   102\t  // lands the rendering and the lower-band projection as independent rows;\n   103\t  // both go pending with the enqueue (DD-5).\n   104\t  return enqueue(ctx, {\n   105\t    owner: \"turns\",\n   106\t    kind: \"turn_derivation\",\n   107\t    sourceRef: { turnId },\n   108\t    forms: [\n   109\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n   110\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n   111\t    ],\n   112\t  });\n   113\t}\n   114\t\n   115\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n   116\t// construction (DD-6): turn derivation and the two chunk summaries.\n   117\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   118\t  turnWorkHandlers;\n   119\t\n   120\t// Cross-domain surface, called by intake-stream inside the batch transaction\n   121\t// for every recorded event. Synchronous and throwing by design, like\n   122\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n   123\texport function applyEvent(\n   124\t  ctx: OperationContext,\n   125\t  eventKind: EventKind,\n   126\t  eventOrder: number,\n   127\t): TurnTransitionOutcome {\n   128\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n   129\t  const effect = transition({ openTurnId }, eventKind);\n   130\t  switch (effect.kind) {\n   131\t    case \"none\":\n   132\t      return { transitions: [], openTurnId, queuedWork: [] };\n   133\t    case \"open\": {\n   134\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   135\t      return {\n   136\t        transitions: [{ action: \"opened\", turnId }],\n   137\t        openTurnId: turnId,\n   138\t        queuedWork: [],\n   139\t      };\n   140\t    }\n   141\t    case \"close\": {\n   142\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   143\t      return {\n   144\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   145\t        openTurnId: null,\n   146\t        queuedWork: [item],\n   147\t      };\n   148\t    }\n   149\t    case \"close_then_open\": {\n   150\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   151\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   152\t      return {\n   153\t        transitions: [\n   154\t          { action: \"closed\", turnId: openTurnId as string },\n   155\t          { action: \"opened\", turnId },\n   156\t        ],\n   157\t        openTurnId: turnId,\n   158\t        queuedWork: [item],\n   159\t      };\n   160\t    }\n   161\t  }\n   162\t}\n   163\t\n   164\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   165\t  return {\n   166\t    ok: false,\n   167\t    error: {\n   168\t      errorClass: \"caller_error\",\n   169\t      code: \"thread_not_found\",\n   170\t      reason: `no thread file exists at ${filePath}`,\n   171\t    },\n   172\t  };\n   173\t}\n   174\t\n   175\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   176\t  const resolved = await resolveThreadRef(thread);\n   177\t  if (!resolved.ok) return resolved;\n   178\t  const { filePath } = resolved.value;\n   179\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   180\t\n   181\t  const opened = openThreadDatabase(filePath);\n   182\t  if (!opened.ok) return opened;\n   183\t  const db = opened.value;\n   184\t  try {\n   185\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n   186\t    // stored derived forms, attached from one grouped query — mirroring the\n   187\t    // message read's production path for \"readable alongside the record\".\n   188\t    const formsByTurn = readOwnedForms(db, \"turn\");\n   189\t    const records = readTurns(db).map((record) => {\n   190\t      const forms = formsByTurn.get(record.turnId);\n   191\t      return forms === undefined ? record : { ...record, forms };\n   192\t    });\n   193\t    return { ok: true, value: records };\n   194\t  } catch (cause) {\n   195\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   196\t    return storageFailure(`turn read-back failed: ${reason}`);\n   197\t  } finally {\n   198\t    db.close();\n   199\t  }\n   200\t}\n   201\t\n   202\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n   203\t// returns stored records whatever the forms' states — reads degrade, never\n   204\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n   205\t// summary rows until close queues them).\n   206\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n   207\t  const resolved = await resolveThreadRef(thread);\n   208\t  if (!resolved.ok) return resolved;\n   209\t  const { filePath } = resolved.value;\n   210\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   211\t\n   212\t  const opened = openThreadDatabase(filePath);\n   213\t  if (!opened.ok) return opened;\n   214\t  const db = opened.value;\n   215\t  try {\n   216\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n   217\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n   218\t      const forms = formsByChunk.get(row.chunkId);\n   219\t      return forms === undefined ? row : { ...row, forms };\n   220\t    });\n   221\t    return { ok: true, value: records };\n   222\t  } catch (cause) {\n   223\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   224\t    return storageFailure(`chunk read-back failed: ${reason}`);\n   225\t  } finally {\n   226\t    db.close();\n   227\t  }\n   228\t}\n   229\t\n   230\texport async function listQueuedWork(\n   231\t  thread: ThreadRef,\n   232\t): Promise<OpResult<WorkItemRecord[]>> {\n   233\t  const resolved = await resolveThreadRef(thread);\n   234\t  if (!resolved.ok) return resolved;\n   235\t  const { filePath } = resolved.value;\n   236\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   237\t\n   238\t  const opened = openThreadDatabase(filePath);\n   239\t  if (!opened.ok) return opened;\n   240\t  const db = opened.value;\n   241\t  try {\n   242\t    return { ok: true, value: listItems(db, \"turns\") };\n   243\t  } catch (cause) {\n   244\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   245\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   246\t  } finally {\n   247\t    db.close();\n   248\t  }\n   249\t}\n   250\t\n   251\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   252\t\n   253\t// This owner's repair report: every turn- and chunk-owned form's durable\n   254\t// state joined with live queue detail in one query. Needs no provider;\n   255\t// reads degrade, never block.\n   256\texport async function report(\n   257\t  thread: ThreadRef,\n   258\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   259\t): Promise<OpResult<FormReportEntry[]>> {\n   260\t  const resolved = await resolveThreadRef(thread);\n   261\t  if (!resolved.ok) return resolved;\n   262\t  const { filePath } = resolved.value;\n   263\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   264\t\n   265\t  const opened = openThreadDatabase(filePath);\n   266\t  if (!opened.ok) return opened;\n   267\t  const db = opened.value;\n   268\t  try {\n   269\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   270\t  } catch (cause) {\n   271\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   272\t    return storageFailure(`report read failed: ${reason}`);\n   273\t  } finally {\n   274\t    db.close();\n   275\t  }\n   276\t}\n   277\t\n   278\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   279\t\n   280\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n   281\t// the one turn_derivation item (the handler lands rendering and projection\n   282\t// together, so a rebuild of either re-derives both — the rebuild rule from\n   283\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n   284\t// independent lifecycles).\n   285\tfunction turnRequeueTarget(target: {\n   286\t  subjectKind: \"turn\" | \"chunk\";\n   287\t  subjectId: string;\n   288\t  form: FormKind;\n   289\t}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n   290\t  if (\n   291\t    target.subjectKind === \"turn\" &&\n   292\t    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n   293\t  ) {\n   294\t    return {\n   295\t      kind: \"turn_derivation\",\n   296\t      sourceRef: { turnId: target.subjectId },\n   297\t      forms: [\n   298\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n   299\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n   300\t      ],\n   301\t    };\n   302\t  }\n   303\t  if (\n   304\t    target.subjectKind === \"chunk\" &&\n   305\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n   306\t  ) {\n   307\t    return {\n   308\t      kind: target.form,\n   309\t      sourceRef: { chunkId: target.subjectId },\n   310\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n   311\t    };\n   312\t  }\n   313\t  return undefined;\n   314\t}\n   315\t\n   316\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   317\t// messages.requeue — blocked refused with the stored damage reason, missing\n   318\t// rows refused, no-op against live work at the current source version, and\n   319\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   320\t// at the next source version: composed forms recompute their gaps from\n   321\t// current dependency states (Flow 3's rebuild rule).\n   322\texport async function requeue(\n   323\t  thread: ThreadRef,\n   324\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n   325\t): Promise<OpResult<RequeueOutcome>> {\n   326\t  const mapped = turnRequeueTarget(target);\n   327\t  if (mapped === undefined) {\n   328\t    return {\n   329\t      ok: false,\n   330\t      error: {\n   331\t        errorClass: \"caller_error\",\n   332\t        code: \"turn_not_found\",\n   333\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   334\t      },\n   335\t    };\n   336\t  }\n   337\t  const resolved = await resolveThreadRef(thread);\n   338\t  if (!resolved.ok) return resolved;\n   339\t  const { filePath } = resolved.value;\n   340\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   341\t\n   342\t  const opened = openThreadDatabase(filePath);\n   343\t  if (!opened.ok) return opened;\n   344\t  const db = opened.value;\n   345\t  try {\n   346\t    const meta = db\n   347\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   348\t      .get() as { thread_id: string } | undefined;\n   349\t    const threadId = meta?.thread_id ?? \"\";\n   350\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   351\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n   352\t      if (row === undefined) {\n   353\t        return {\n   354\t          ok: false,\n   355\t          error: {\n   356\t            errorClass: \"caller_error\",\n   357\t            code: \"turn_not_found\",\n   358\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n   359\t          },\n   360\t        };\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '130,340p'\"","aggregated_output":"   130\t    turn_id: string;\n   131\t    state: string | null;\n   132\t    content: string | null;\n   133\t    rendering_metadata: string | null;\n   134\t  }>;\n   135\t  return rows.map((row) => {\n   136\t    const metadata =\n   137\t      row.rendering_metadata === null\n   138\t        ? undefined\n   139\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n   140\t    const projection: MemberProjection = {\n   141\t      turnId: row.turn_id,\n   142\t      receipts: metadata?.receipts ?? [],\n   143\t    };\n   144\t    if (row.state !== null) projection.state = row.state;\n   145\t    if (row.content !== null) projection.content = row.content;\n   146\t    return projection;\n   147\t  });\n   148\t}\n   149\t\n   150\tinterface RawOwnedFormRow {\n   151\t  subject_id: string;\n   152\t  form: string;\n   153\t  state: string;\n   154\t  content: string | null;\n   155\t  reason: string | null;\n   156\t  metadata: string | null;\n   157\t  source_version: number | bigint;\n   158\t  gaps: string | null;\n   159\t  derived_at: string | null;\n   160\t}\n   161\t\n   162\t// Every form row this owner holds for one subject kind, grouped by subject\n   163\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\n   164\t// \"record with form states\", mirroring messages.readMessageForms). Rows come\n   165\t// back exactly as the pipeline landed them; nothing is derived at read time.\n   166\texport function readOwnedForms(\n   167\t  db: DatabaseSync,\n   168\t  subjectKind: \"turn\" | \"chunk\",\n   169\t): Map<string, DerivedForm[]> {\n   170\t  const rows = db\n   171\t    .prepare(\n   172\t      `SELECT subject_id, form, state, content, reason, metadata,\n   173\t              source_version, gaps, derived_at\n   174\t       FROM derived_form WHERE subject_kind = ?\n   175\t       ORDER BY subject_id, form`,\n   176\t    )\n   177\t    .all(subjectKind) as unknown as RawOwnedFormRow[];\n   178\t  const bySubject = new Map<string, DerivedForm[]>();\n   179\t  for (const row of rows) {\n   180\t    const record: DerivedForm = {\n   181\t      subjectKind,\n   182\t      subjectId: row.subject_id,\n   183\t      form: row.form as FormKind,\n   184\t      state: row.state as DerivedFormState,\n   185\t      sourceVersion: Number(row.source_version),\n   186\t    };\n   187\t    if (row.content !== null) record.content = row.content;\n   188\t    if (row.reason !== null) record.reason = row.reason;\n   189\t    if (row.metadata !== null) {\n   190\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n   191\t    }\n   192\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n   193\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n   194\t    const forms = bySubject.get(row.subject_id) ?? [];\n   195\t    forms.push(record);\n   196\t    bySubject.set(row.subject_id, forms);\n   197\t  }\n   198\t  return bySubject;\n   199\t}\n   200\t\n   201\t// Chunk read-back rows for the listChunks surface: stored chunk state plus\n   202\t// live (deleted-filtered) membership in member order.\n   203\texport interface ChunkReadRow {\n   204\t  chunkId: string;\n   205\t  chunkOrder: number;\n   206\t  status: \"open\" | \"closed\";\n   207\t  accumulatedProjectedTokens: number;\n   208\t  memberTurnIds: string[];\n   209\t}\n   210\t\n   211\texport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\n   212\t  const chunks = db\n   213\t    .prepare(\n   214\t      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n   215\t       FROM chunk ORDER BY chunk_order`,\n   216\t    )\n   217\t    .all() as unknown as Array<{\n   218\t    chunk_id: string;\n   219\t    chunk_order: number | bigint;\n   220\t    status: string;\n   221\t    accumulated_projected_tokens: number | bigint;\n   222\t  }>;\n   223\t  const memberStmt = db.prepare(\n   224\t    `SELECT cm.turn_id FROM chunk_member cm\n   225\t     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   226\t     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   227\t  );\n   228\t  return chunks.map((row) => ({\n   229\t    chunkId: row.chunk_id,\n   230\t    chunkOrder: Number(row.chunk_order),\n   231\t    status: row.status as \"open\" | \"closed\",\n   232\t    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n   233\t    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\n   234\t      (member) => member.turn_id,\n   235\t    ),\n   236\t  }));\n   237\t}\n   238\t\n   239\t// One form row by exact key for this owner's subjects — the requeue\n   240\t// operation's refusal read (missing row, blocked state, current version).\n   241\texport function readTurnFormRow(\n   242\t  db: DatabaseSync,\n   243\t  subjectKind: \"turn\" | \"chunk\",\n   244\t  subjectId: string,\n   245\t  form: FormKind,\n   246\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n   247\t  const row = db\n   248\t    .prepare(\n   249\t      `SELECT state, reason, source_version FROM derived_form\n   250\t       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n   251\t    )\n   252\t    .get(subjectKind, subjectId, form) as unknown as\n   253\t    | { state: string; reason: string | null; source_version: number | bigint }\n   254\t    | undefined;\n   255\t  if (row === undefined) return undefined;\n   256\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n   257\t    state: row.state as DerivedFormState,\n   258\t    sourceVersion: Number(row.source_version),\n   259\t  };\n   260\t  if (row.reason !== null) view.reason = row.reason;\n   261\t  return view;\n   262\t}\n   263\t\n   264\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\n   265\t// form rows LEFT JOINed with the live work_item targeting each form at its\n   266\t// current source version. Both turn forms map to the one turn_derivation\n   267\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\n   268\t// this owner's queue-site mapping inverted, mirroring the messages report.\n   269\texport function reportTurnForms(\n   270\t  db: DatabaseSync,\n   271\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\n   272\t): FormReportEntry[] {\n   273\t  const conditions = [\"df.subject_kind IN ('turn', 'chunk')\"];\n   274\t  const params: string[] = [];\n   275\t  const subjectFilters: string[] = [];\n   276\t  if (opts.turnId !== undefined) {\n   277\t    subjectFilters.push(\"(df.subject_kind = 'turn' AND df.subject_id = ?)\");\n   278\t    params.push(opts.turnId);\n   279\t  }\n   280\t  if (opts.chunkId !== undefined) {\n   281\t    subjectFilters.push(\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\");\n   282\t    params.push(opts.chunkId);\n   283\t  }\n   284\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\" OR \")})`);\n   285\t  // notReady is exact set equality by construction: every state but ready.\n   286\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   287\t  const rows = db\n   288\t    .prepare(\n   289\t      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\n   290\t              df.metadata, df.source_version, df.gaps, df.derived_at,\n   291\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   292\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   293\t       FROM derived_form df\n   294\t       LEFT JOIN work_item w\n   295\t         ON w.status IN ('queued', 'claimed')\n   296\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\n   297\t        AND json_extract(\n   298\t              w.source_ref,\n   299\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\n   300\t            ) = df.subject_id\n   301\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   302\t       WHERE ${conditions.join(\" AND \")}\n   303\t       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\n   304\t    )\n   305\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\n   306\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\n   307\t}\n   308\t\n   309\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n   310\t  return (\n   311\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n   312\t  );\n   313\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/report-repair.test.ts | sed -n '520,700p'\"","aggregated_output":"   520\t    expect(formOf(filePath, turnId, \"turn_rendering\")).toEqual(rendering);\n   521\t  });\n   522\t});\n   523\t\n   524\tdescribe(\"TC-4.7 / AC-4.7 (architecture risk): reads degrade, never block\", () => {\n   525\t  it(\"with every non-ready state present at once, message and turn reads return full records with states attached and zero errors\", async () => {\n   526\t    const { sdk, filePath } = await mixedStateThread();\n   527\t\n   528\t    const messagesRead = await sdk.messages.listMessages({ filePath });\n   529\t    expect(messagesRead.ok).toBe(true);\n   530\t    if (!messagesRead.ok) return;\n   531\t    expect(messagesRead.value.map((record) => record.messageId)).toEqual([\"m1\", \"m3\", \"m5\"]);\n   532\t    const formStates = new Map(\n   533\t      messagesRead.value.map((record) => [\n   534\t        record.messageId,\n   535\t        record.forms?.map((form) => form.state),\n   536\t      ]),\n   537\t    );\n   538\t    expect(formStates.get(\"m1\")).toEqual([\"failed\"]);\n   539\t    expect(formStates.get(\"m3\")).toEqual([\"ready\"]);\n   540\t    expect(formStates.get(\"m5\")).toEqual([\"pending\"]);\n   541\t\n   542\t    const turnsRead = await sdk.turns.listTurns({ filePath });\n   543\t    expect(turnsRead.ok).toBe(true);\n   544\t    if (!turnsRead.ok) return;\n   545\t    // Full records back, including the corrupt extra open turn — the read\n   546\t    // reports what is stored and never errors over incomplete derivation.\n   547\t    expect(turnsRead.value.map((record) => record.turnId)).toEqual([\"t1\", \"t2\", \"t3\", \"t4\"]);\n   548\t    expect(turnsRead.value[0]).toMatchObject({\n   549\t      turnId: \"t1\",\n   550\t      status: \"closed\",\n   551\t      memberMessageIds: [\"m1\"],\n   552\t    });\n   553\t\n   554\t    // Turn form states ride the turn read directly (ruling 012): both\n   555\t    // closed turns carry their blocked forms; the open turns have no rows\n   556\t    // and no key — mirroring the message read's contract.\n   557\t    const turnFormStates = new Map(\n   558\t      turnsRead.value.map((record) => [\n   559\t        record.turnId,\n   560\t        record.forms?.map((form) => [form.form, form.state]),\n   561\t      ]),\n   562\t    );\n   563\t    expect(turnFormStates.get(\"t1\")).toEqual([\n   564\t      [\"lower_band_projection\", \"blocked\"],\n   565\t      [\"turn_rendering\", \"blocked\"],\n   566\t    ]);\n   567\t    expect(turnFormStates.get(\"t2\")).toEqual([\n   568\t      [\"lower_band_projection\", \"blocked\"],\n   569\t      [\"turn_rendering\", \"blocked\"],\n   570\t    ]);\n   571\t    expect(turnFormStates.get(\"t3\")).toBeUndefined();\n   572\t    expect(turnFormStates.get(\"t4\")).toBeUndefined();\n   573\t\n   574\t    const eventsRead = await sdk.intakeStream.listEvents({ filePath });\n   575\t    expect(eventsRead.ok).toBe(true);\n   576\t  });\n   577\t\n   578\t  it(\"chunk reads return records with summary-form states attached, including non-ready ones\", async () => {\n   579\t    const double = createProviderDouble();\n   580\t    const sdk = manualSdk(double, {\n   581\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n   582\t    });\n   583\t    const filePath = await newThread();\n   584\t    await send(sdk, filePath, [\n   585\t      validEvent(\"user_prompt\", { payload: { text: \"chunk read prompt one\" } }),\n   586\t      validEvent(\"turn_end\"),\n   587\t    ]);\n   588\t    await drain(sdk, filePath);\n   589\t    double.failKind(\"chunk_summary_brief\", 3, {\n   590\t      retryable: true,\n   591\t      reason: \"provider_failure: scripted brief exhaustion\",\n   592\t    });\n   593\t    await send(sdk, filePath, [\n   594\t      validEvent(\"user_prompt\", { payload: { text: \"chunk read prompt two\" } }),\n   595\t      validEvent(\"turn_end\"),\n   596\t    ]);\n   597\t    await drain(sdk, filePath);\n   598\t\n   599\t    const chunksRead = await sdk.turns.listChunks({ filePath });\n   600\t    expect(chunksRead.ok).toBe(true);\n   601\t    if (!chunksRead.ok) return;\n   602\t    expect(chunksRead.value.map((record) => [record.chunkId, record.status])).toEqual([\n   603\t      [\"c1\", \"closed\"],\n   604\t      [\"c2\", \"closed\"],\n   605\t    ]);\n   606\t    expect(chunksRead.value[0]?.memberTurnIds).toEqual([\"t1\"]);\n   607\t    const chunkFormStates = chunksRead.value.map((record) =>\n   608\t      record.forms?.map((form) => [form.form, form.state]),\n   609\t    );\n   610\t    expect(chunkFormStates).toEqual([\n   611\t      [\n   612\t        [\"chunk_summary_brief\", \"ready\"],\n   613\t        [\"chunk_summary_detailed\", \"ready\"],\n   614\t      ],\n   615\t      [\n   616\t        [\"chunk_summary_brief\", \"failed\"],\n   617\t        [\"chunk_summary_detailed\", \"ready\"],\n   618\t      ],\n   619\t    ]);\n   620\t    // The failed summary's read carries its stored reason — degraded, not\n   621\t    // blocking, and never an error.\n   622\t    const failedBrief = chunksRead.value[1]?.forms?.find(\n   623\t      (form) => form.form === \"chunk_summary_brief\",\n   624\t    );\n   625\t    expect(failedBrief?.reason).toBe(\"provider_failure: scripted brief exhaustion\");\n   626\t  });\n   627\t});\n","exit_code":0,"status":"completed"}}

ain code. A kind claimed by two tables is a wiring bug\\n115\\t// (each kind has exactly one owner) and throws at construction.\\n116\\texport function assembleWorkHandlerMap(\\n117\\t  tables: ReadonlyArray<WorkHandlerMap>,\\n118\\t): WorkHandlerMap {\\n119\\t  const map: WorkHandlerMap = {};\\n120\\t  for (const table of tables) {\\n121\\t    for (const [kind, handler] of Object.entries(table)) {\\n122\\t      if (map[kind as WorkKind] !== undefined) {\\n123\\t        throw new TypeError(`work kind \\\"${kind}\\\" registered by more than one domain`);\\n124\\t      }\\n125\\t      map[kind as WorkKind] = handler;\\n126\\t    }\\n127\\t  }\\n128\\t  return map;\\n129\\t}\\n130\\t\\n131\\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\n132\\t  return {\\n133\\t    ok: false,\\n134\\t    error: {\\n135\\t      errorClass: \\\"state_corruption\\\",\\n136\\t      code: \\\"unknown_work_kind\\\",\\n137\\t      reason: `no handler registered for work kind \\\"${kind}\\\"`,\\n138\\t    },\\n139\\t  };\\n140\\t}\\n141\\t\\n142\\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\n143\\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\n144\\texport function lookupWorkHandler(\\n145\\t  map: WorkHandlerMap,\\n146\\t  kind: string,\\n147\\t): OpResult<WorkHandler> {\\n148\\t  const handler = map[kind as WorkKind];\\n149\\t  if (handler === undefined) return unknownWorkKind(kind);\\n150\\t  return { ok: true, value: handler };\\n151\\t}\\n152\\t\\n153\\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\n154\\t// requeue land in Story 4.\\n155\\texport interface WorkSurface {\\n156\\t  drain(\\n157\\t    ref: threadsDomain.ThreadRef,\\n158\\t    opts?: { maxItems?: number },\\n159\\t  ): Promise<OpResult<DrainReport>>;\\n160\\t}\\n161\\t\\n162\\texport interface Lhc {\\n163\\t  threads: typeof threadsDomain;\\n164\\t  intakeStream: typeof intakeStreamDomain;\\n165\\t  messages: typeof messagesDomain;\\n166\\t  turns: typeof turnsDomain;\\n167\\t  config: ResolvedSdkConfig;\\n168\\t  scheduler: Scheduler;\\n169\\t  workHandlers: WorkHandlerMap;\\n170\\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\n171\\t  work: WorkSurface;\\n172\\t  // Resolves when the scheduler has no running or pending drain for the\\n173\\t  // thread (issue 3) — the awaitable for background mode, and a no-op\\n174\\t  // resolve in manual mode.\\n175\\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\n176\\t}\\n177\\t\\n178\\tfunction requirePositive(value: number, name: string): void {\\n179\\t  if (!Number.isFinite(value) || value <= 0) {\\n180\\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\n181\\t  }\\n182\\t}\\n183\\t\\n184\\tfunction requireNonNegative(value: number, name: string): void {\\n185\\t  if (!Number.isFinite(value) || value < 0) {\\n186\\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\n187\\t  }\\n188\\t}\\n189\\t\\n190\\t// The only assembly path: provider, mode, clock, and policy enter here.\\n191\\t// Config mistakes are programmer errors at construction and throw; operating\\n192\\t// failures after construction return OpResults per the error contract.\\n193\\texport function createSdk(config: SdkConfig): Lhc {\\n194\\t  if (config.mode !== \\\"background\\\" && config.mode !== \\\"manual\\\") {\\n195\\t    throw new TypeError(\\n196\\t      `createSdk config: mode must be \\\"background\\\" or \\\"manual\\\", got ${JSON.stringify(config.mode)}`,\\n197\\t    );\\n198\\t  }\\n199\\t  if (config.provider === null || typeof config.provider !== \\\"object\\\") {\\n200\\t    throw new TypeError(\\\"createSdk config: provider must implement DerivationProvider\\\");\\n201\\t  }\\n202\\t  for (const operation of PROVIDER_OPERATIONS) {\\n203\\t    if (typeof config.provider[operation] !== \\\"function\\\") {\\n204\\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\n205\\t    }\\n206\\t  }\\n207\\t\\n208\\t  const resolved: ResolvedSdkConfig = {\\n209\\t    provider: config.provider,\\n210\\t    mode: config.mode,\\n211\\t    clock: config.clock ?? (() => new Date()),\\n212\\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\n213\\t    lease: config.lease ?? { durationMs: 120000 },\\n214\\t    chunkPolicy:\\n215\\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\n216\\t  };\\n217\\t  requirePositive(resolved.retry.budget, \\\"retry.budget\\\");\\n218\\t  requireNonNegative(resolved.retry.backoffBaseMs, \\\"retry.backoffBaseMs\\\");\\n219\\t  requireNonNegative(resolved.retry.backoffCapMs, \\\"retry.backoffCapMs\\\");\\n220\\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\n221\\t    throw new TypeError(\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\");\\n222\\t  }\\n223\\t  requirePositive(resolved.lease.durationMs, \\\"lease.durationMs\\\");\\n224\\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\"chunkPolicy.targetProjectedTokens\\\");\\n225\\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\n226\\t    throw new TypeError(\\n227\\t      \\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\",\\n228\\t    );\\n229\\t  }\\n230\\t\\n231\\t  // Handler maps merge from per-domain contributions at construction (DD-6).\\n232\\t  // The tables are empty until Stories 2–3 land the real handlers; the\\n233\\t  // assembly mechanics are production code from day one.\\n234\\t  const workHandlers = assembleWorkHandlerMap([\\n235\\t    messagesDomain.workHandlers,\\n236\\t    turnsDomain.workHandlers,\\n237\\t  ]);\\n238\\t\\n239\\t  const drainDeps: DrainDeps = {\\n240\\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n241\\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\n242\\t    config: resolved,\\n243\\t  };\\n244\\t  const scheduler = createScheduler(resolved.mode, drainDeps);\\n245\\t\\n246\\t  // Background mode wires the scheduler into the process-wide seams: enqueue\\n247\\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\\n248\\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\\n249\\t  // constructing a later background SDK supersedes an earlier one (the\\n250\\t  // displaced scheduler's in-memory state was advisory — the rows remain).\\n251\\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\\n252\\t  if (resolved.mode === \\\"background\\\") {\\n253\\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\n254\\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\n255\\t  }\\n256\\t\\n257\\t  const work: WorkSurface = {\\n258\\t    drain: async (ref, opts) => {\\n259\\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n260\\t      if (!resolvedRef.ok) return resolvedRef;\\n261\\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\\n262\\t    },\\n263\\t  };\\n264\\t\\n265\\t  return {\\n266\\t    threads: threadsDomain,\\n267\\t    intakeStream: intakeStreamDomain,\\n268\\t    messages: messagesDomain,\\n269\\t    turns: turnsDomain,\\n270\\t    config: resolved,\\n271\\t    scheduler,\\n272\\t    workHandlers,\\n273\\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n274\\t    work,\\n275\\t    drainSettled: async (ref) => {\\n276\\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\\n277\\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\\n278\\t      const threadId = peekThreadId(resolvedRef.value.filePath);\\n279\\t      if (threadId === null) return;\\n280\\t      return scheduler.drainSettled(threadId);\\n281\\t    },\\n282\\t  };\
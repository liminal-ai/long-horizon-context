{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016EtCD2TDHW3A1byFUeeZQa","type":"tool_result","content":"1\t// The turn rule table as a pure function (Flow 3). Every row of the epic's\n2\t// table is one golden case against this function: prompt with no open turn →\n3\t// open; prompt with open turn → close_then_open; turn_end with open turn →\n4\t// close; turn_end with none → none; every other kind → none (stamping is\n5\t// membership, not transition). The corruption row (>1 open turn) is handled\n6\t// by the pipeline at state load, not here — only the pipeline writes turn\n7\t// state, so a violation means external interference and fails the batch\n8\t// before any event reaches this function.\n9\timport type { EventKind } from \"../../intake-stream/index.js\";\n10\t\n11\texport interface TurnState {\n12\t  openTurnId: string | null;\n13\t}\n14\t\n15\texport type TurnEffect =\n16\t  | { kind: \"none\" }\n17\t  | { kind: \"open\" }\n18\t  | { kind: \"close\" }\n19\t  | { kind: \"close_then_open\" };\n20\t\n21\texport function transition(state: TurnState, eventKind: EventKind): TurnEffect {\n22\t  switch (eventKind) {\n23\t    case \"user_prompt\":\n24\t      return state.openTurnId === null ? { kind: \"open\" } : { kind: \"close_then_open\" };\n25\t    case \"turn_end\":\n26\t      return state.openTurnId === null ? { kind: \"none\" } : { kind: \"close\" };\n27\t    case \"assistant_text\":\n28\t    case \"assistant_thinking\":\n29\t    case \"runtime_note\":\n30\t    case \"tool_call\":\n31\t    case \"tool_result\":\n32\t      return { kind: \"none\" };\n33\t  }\n34\t}\n35\t"}]},"parent_tool_use_id":null,"session_id":"1ace89b2-5fb5-4f71-8bfc-880d4a4875dc","uuid":"dfdd4cdf-d96e-4f74-bfa6-e98cd946e2c1","timestamp":"2026-06-11T09:31:42.589Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/state-machine.ts","content":"// The turn rule table as a pure function (Flow 3). Every row of the epic's\n// table is one golden case against this function: prompt with no open turn →\n// open; prompt with open turn → close_then_open; turn_end with open turn →\n// close; turn_end with none → none; every other kind → none (stamping is\n// membership, not transition). The corruption row (>1 open turn) is handled\n// by the pipeline at state load, not here — only the pipeline writes turn\n// state, so a violation means external interference and fails the batch\n// before any event reaches this function.\nimport type { EventKind } from \"../../intake-stream/index.js\";\n\nexport interface TurnState {\n  openTurnId: string | null;\n}\n\nexport type TurnEffect =\n  | { kind: \"none\" }\n  | { kind: \"open\" }\n  | { kind: \"close\" }\n  | { kind: \"close_then_open\" };\n\nexport function transition(state: TurnState, eventKind: EventKind): TurnEffect {\n  switch (eventKind) {\n    case \"user_prompt\":\n      return state.openTurnId === null ? { kind: \"open\" } : { kind: \"close_then_open\" };\n    case \"turn_end\":\n      return state.openTurnId === null ? { kind: \"none\" } : { kind: \"close\" };\n    case \"assistant_text\":\n    case \"assistant_thinking\":\n    case \"runtime_note\":\n    case \"tool_call\":\n    case \"tool_result\":\n      return { kind: \"none\" };\n  }\n}\n","numLines":35,"startLine":1,"totalLines":35}}}

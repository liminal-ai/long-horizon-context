{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VyuYHLZtdEFSdGdukDvqtn","type":"tool_result","content":"File created successfully at: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/scratch-reverify-turn-delete-pair.test.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1ace89b2-5fb5-4f71-8bfc-880d4a4875dc","uuid":"b6d6893f-fed1-4aa2-91ec-e6e094e38803","timestamp":"2026-06-11T09:37:42.472Z","tool_use_result":{"type":"create","filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/scratch-reverify-turn-delete-pair.test.ts","content":"// SCRATCH — reverify dynamic check, not part of the suite. Deleted after run.\n// Cross-turn call/result pair: call in t1 (closed, summary lands unknown),\n// late result arrives in t2 (AC-2.8 intake repair requeues the call summary,\n// which rebuilds outcome `succeeded` from the cross-turn pair). Then\n// turns.deleteTurn(t2) removes the result. Question: does the cascade clear\n// the t1 call's summary (per the epic-fix-001 pair-as-source ruling), or does\n// the stale `succeeded` outcome survive?\nimport { afterEach, beforeEach, expect, it } from \"vitest\";\nimport { createSdk, threads, type Lhc, type SdkConfig } from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  readDerivedForms,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction sdkFor(mode: SdkConfig[\"mode\"]): Lhc {\n  return createSdk({\n    provider: createProviderDouble(),\n    mode,\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 1000 },\n  });\n}\n\nit(\"scratch: turn delete of the result's turn leaves the cross-turn call summary stale\", async () => {\n  const sdk = sdkFor(\"manual\");\n  const created = await threads.newThread({\n    filePath: store.threadPath(\"crossturn\"),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(\"thread creation failed\");\n  const filePath = created.value.filePath;\n\n  // Batch 1: t1 = prompt + tool_call, closed with no result.\n  const b1 = await sdk.intakeStream.messageEvents({ filePath }, [\n    validEvent(\"user_prompt\"),\n    validEvent(\"tool_call\"),\n    validEvent(\"turn_end\"),\n  ]);\n  expect(b1.ok).toBe(true);\n  const d1 = await sdk.work.drain({ filePath });\n  expect(d1.ok).toBe(true);\n\n  const afterB1 = readDerivedForms(filePath);\n  const callSummary1 = afterB1.find((f) => f.form === \"tool_call_summary\");\n  expect(callSummary1?.state).toBe(\"ready\");\n  expect(callSummary1?.metadata?.outcome).toBe(\"unknown\");\n  const callMessageId = callSummary1?.subjectId;\n\n  // Batch 2: new prompt opens t2; the LATE tool_result (same callId as the\n  // fixture's tool_call) lands in t2; t2 closes.\n  const b2 = await sdk.intakeStream.messageEvents({ filePath }, [\n    validEvent(\"user_prompt\"),\n    validEvent(\"tool_result\"),\n    validEvent(\"turn_end\"),\n  ]);\n  expect(b2.ok).toBe(true);\n  const d2 = await sdk.work.drain({ filePath });\n  expect(d2.ok).toBe(true);\n\n  // AC-2.8 repair should have requeued + rebuilt the call summary from the\n  // cross-turn pair: outcome now succeeded.\n  const afterB2 = readDerivedForms(filePath);\n  const callSummary2 = afterB2.find(\n    (f) => f.subjectId === callMessageId && f.form === \"tool_call_summary\",\n  );\n  console.log(\"after late result:\", JSON.stringify(callSummary2));\n\n  // Find the result message's turn (t2) and delete that turn.\n  const turnsRead = await sdk.turns.readTurns({ filePath });\n  expect(turnsRead.ok).toBe(true);\n  if (!turnsRead.ok) return;\n  console.log(\n    \"turns:\",\n    JSON.stringify(\n      turnsRead.value.map((t: { turnId: string; messageIds?: string[] }) => t),\n      null,\n      0,\n    ).slice(0, 800),\n  );\n  const t2 = turnsRead.value[turnsRead.value.length - 1];\n  const del = await sdk.turns.deleteTurn({ filePath }, { turnId: t2.turnId });\n  console.log(\"delete result:\", JSON.stringify(del));\n  expect(del.ok).toBe(true);\n  if (!del.ok) return;\n\n  const clearedKeys = del.value.cleared.map(\n    (c: { subjectKind: string; subjectId: string; form: string }) =>\n      `${c.subjectKind}/${c.subjectId}/${c.form}`,\n  );\n  console.log(\"cleared:\", JSON.stringify(clearedKeys));\n\n  const d3 = await sdk.work.drain({ filePath });\n  expect(d3.ok).toBe(true);\n  const finalForms = readDerivedForms(filePath);\n  const callSummaryFinal = finalForms.find(\n    (f) => f.subjectId === callMessageId && f.form === \"tool_call_summary\",\n  );\n  console.log(\"final call summary:\", JSON.stringify(callSummaryFinal));\n\n  // The pair-as-source ruling demands the counterpart summary clear+requeue:\n  // after the delete + drain it should be ready with outcome `unknown`.\n  // If this expectation FAILS with outcome `succeeded`, the stale-outcome\n  // defect survives through the turn-delete path.\n  expect(callSummaryFinal?.metadata?.outcome).toBe(\"unknown\");\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}

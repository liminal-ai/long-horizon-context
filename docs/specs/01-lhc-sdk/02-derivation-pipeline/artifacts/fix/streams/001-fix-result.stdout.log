{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UN9JGQjvCNvo7Qk7WBEyXZ","type":"tool_result","content":"1\t// Epic Fix Batch 1: blank-path rejection (F-EPIC-001), read-surface reference\n2\t// validation (F-EPIC-002), and strict CLI flag parsing (NB-2). New Green-phase\n3\t// suite — the Red-committed files stay byte-identical.\n4\timport { existsSync } from \"node:fs\";\n5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n6\timport {\n7\t  intakeStream,\n8\t  messages,\n9\t  runCli,\n10\t  threads,\n11\t  turns,\n12\t  type ThreadRef,\n13\t} from \"../src/index.js\";\n14\timport { tempStore, type TempStore } from \"./fixtures/index.js\";\n15\t\n16\tlet store: TempStore;\n17\tbeforeEach(() => {\n18\t  store = tempStore();\n19\t});\n20\tafterEach(() => {\n21\t  store.cleanup();\n22\t});\n23\t\n24\t// Every read-back surface, exercised through one signature so the empty-path\n25\t// and unknown-id legs prove the same fail-closed contract on each.\n26\tconst READ_SURFACES: ReadonlyArray<{\n27\t  name: string;\n28\t  call: (ref: ThreadRef) => Promise<{ ok: boolean; error?: { errorClass: string; code: string } }>;\n29\t}> = [\n30\t  { name: \"intakeStream.listEvents\", call: (ref) => intakeStream.listEvents(ref) },\n31\t  { name: \"messages.listMessages\", call: (ref) => messages.listMessages(ref) },\n32\t  { name: \"messages.listQueuedWork\", call: (ref) => messages.listQueuedWork(ref) },\n33\t  { name: \"turns.listTurns\", call: (ref) => turns.listTurns(ref) },\n34\t  { name: \"turns.listQueuedWork\", call: (ref) => turns.listQueuedWork(ref) },\n35\t];\n36\t\n37\tdescribe(\"F-EPIC-001 (SDK): blank file path is refused before any storage touch\", () => {\n38\t  it(\"newThread({ filePath: '' }) → caller_error, nothing created, no registry row\", async () => {\n39\t    const result = await threads.newThread({\n40\t      filePath: \"\",\n41\t      registryPath: store.registryPath,\n42\t    });\n43\t    expect(result.ok).toBe(false);\n44\t    if (result.ok) return;\n45\t    expect(result.error.errorClass).toBe(\"caller_error\");\n46\t    expect(result.error.code).toBe(\"invalid_thread_ref\");\n47\t\n48\t    // No durable file, and no registry row — the registry was never opened.\n49\t    expect(existsSync(store.registryPath)).toBe(false);\n50\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\n51\t    expect(listed.ok).toBe(true);\n52\t    if (listed.ok) expect(listed.value).toEqual([]);\n53\t  });\n54\t\n55\t  it(\"newThread with a whitespace-only path is refused the same way\", async () => {\n56\t    const result = await threads.newThread({\n57\t      filePath: \"   \",\n58\t      registryPath: store.registryPath,\n59\t    });\n60\t    expect(result.ok).toBe(false);\n61\t    if (result.ok) return;\n62\t    expect(result.error.errorClass).toBe(\"caller_error\");\n63\t    expect(result.error.code).toBe(\"invalid_thread_ref\");\n64\t    expect(existsSync(store.registryPath)).toBe(false);\n65\t  });\n66\t\n67\t  it(\"resolveThreadRef({ filePath: '' }) fails closed with caller_error\", async () => {\n68\t    const result = await threads.resolveThreadRef({ filePath: \"\" });\n69\t    expect(result.ok).toBe(false);\n70\t    if (result.ok) return;\n71\t    expect(result.error.errorClass).toBe(\"caller_error\");\n72\t    expect(result.error.code).toBe(\"invalid_thread_ref\");\n73\t  });\n74\t});\n75\t\n76\tdescribe(\"F-EPIC-002 (SDK): read surfaces validate the thread reference\", () => {\n77\t  for (const surface of READ_SURFACES) {\n78\t    it(`${surface.name}: empty path → caller_error (no storage open)`, async () => {\n79\t      const result = await surface.call({ filePath: \"\" });\n80\t      expect(result.ok).toBe(false);\n81\t      if (result.ok) return;\n82\t      expect(result.error?.errorClass).toBe(\"caller_error\");\n83\t    });\n84\t\n85\t    it(`${surface.name}: unknown id → thread_not_found`, async () => {\n86\t      const result = await surface.call({\n87\t        threadId: \"th_unknown\",\n88\t        registryPath: store.registryPath,\n89\t      });\n90\t      expect(result.ok).toBe(false);\n91\t      if (result.ok) return;\n92\t      expect(result.error?.errorClass).toBe(\"caller_error\");\n93\t      expect(result.error?.code).toBe(\"thread_not_found\");\n94\t    });\n95\t  }\n96\t});\n97\t\n98\tdescribe(\"F-EPIC-001 / NB-2 (CLI in-process): usage errors are named, not swallowed\", () => {\n99\t  interface CliErr {\n100\t    ok: false;\n101\t    error: { errorClass: string; code: string; reason: string };\n102\t  }\n103\t  function parseErr(stdout: string): CliErr {\n104\t    return JSON.parse(stdout) as CliErr;\n105\t  }\n106\t\n107\t  it(\"new-thread with an empty --file-path exits 1, JSON error, clean registry\", async () => {\n108\t    const result = await runCli([\n109\t      \"threads\",\n110\t      \"new-thread\",\n111\t      \"--file-path\",\n112\t      \"\",\n113\t      \"--registry\",\n114\t      store.registryPath,\n115\t    ]);\n116\t    expect(result.exitCode).toBe(1);\n117\t    const parsed = parseErr(result.stdout);\n118\t    expect(parsed.ok).toBe(false);\n119\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n120\t    expect(parsed.error.code).toBe(\"invalid_thread_ref\");\n121\t    expect(existsSync(store.registryPath)).toBe(false);\n122\t  });\n123\t\n124\t  it(\"an unknown/misspelled flag is rejected by name, exit 1, nothing created\", async () => {\n125\t    const result = await runCli([\n126\t      \"threads\",\n127\t      \"new-thread\",\n128\t      \"--file-path\",\n129\t      store.threadPath(),\n130\t      \"--titel\",\n131\t      \"typo\",\n132\t      \"--registry\",\n133\t      store.registryPath,\n134\t    ]);\n135\t    expect(result.exitCode).toBe(1);\n136\t    const parsed = parseErr(result.stdout);\n137\t    expect(parsed.ok).toBe(false);\n138\t    expect(parsed.error.code).toBe(\"unknown_flag\");\n139\t    expect(parsed.error.reason).toContain(\"--titel\");\n140\t    // Strict parse fails before the SDK call, so no thread was created.\n141\t    expect(existsSync(store.registryPath)).toBe(false);\n142\t  });\n143\t\n144\t  for (const command of [\n145\t    \"messages list\",\n146\t    \"messages list-queued-work\",\n147\t    \"turns list\",\n148\t    \"turns list-queued-work\",\n149\t  ]) {\n150\t    it(`${command} without a thread reference is a missing-flag usage error`, async () => {\n151\t      const result = await runCli(command.split(\" \"));\n152\t      expect(result.exitCode).toBe(1);\n153\t      const parsed = parseErr(result.stdout);\n154\t      expect(parsed.ok).toBe(false);\n155\t      expect(parsed.error.code).toBe(\"missing_flag\");\n156\t      expect(parsed.error.reason).toContain(\"--thread-id or --file-path\");\n157\t    });\n158\t  }\n159\t});\n160\t"}]},"parent_tool_use_id":null,"session_id":"b8d4e4d4-0320-4750-a113-f05b3f0942c7","uuid":"bb29b2e6-4322-48df-a1b6-ba19329ede73","timestamp":"2026-06-11T08:18:41.757Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/epic-fix.test.ts","content":"// Epic Fix Batch 1: blank-path rejection (F-EPIC-001), read-surface reference\n// validation (F-EPIC-002), and strict CLI flag parsing (NB-2). New Green-phase\n// suite — the Red-committed files stay byte-identical.\nimport { existsSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  intakeStream,\n  messages,\n  runCli,\n  threads,\n  turns,\n  type ThreadRef,\n} from \"../src/index.js\";\nimport { tempStore, type TempStore } from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\n// Every read-back surface, exercised through one signature so the empty-path\n// and unknown-id legs prove the same fail-closed contract on each.\nconst READ_SURFACES: ReadonlyArray<{\n  name: string;\n  call: (ref: ThreadRef) => Promise<{ ok: boolean; error?: { errorClass: string; code: string } }>;\n}> = [\n  { name: \"intakeStream.listEvents\", call: (ref) => intakeStream.listEvents(ref) },\n  { name: \"messages.listMessages\", call: (ref) => messages.listMessages(ref) },\n  { name: \"messages.listQueuedWork\", call: (ref) => messages.listQueuedWork(ref) },\n  { name: \"turns.listTurns\", call: (ref) => turns.listTurns(ref) },\n  { name: \"turns.listQueuedWork\", call: (ref) => turns.listQueuedWork(ref) },\n];\n\ndescribe(\"F-EPIC-001 (SDK): blank file path is refused before any storage touch\", () => {\n  it(\"newThread({ filePath: '' }) → caller_error, nothing created, no registry row\", async () => {\n    const result = await threads.newThread({\n      filePath: \"\",\n      registryPath: store.registryPath,\n    });\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"invalid_thread_ref\");\n\n    // No durable file, and no registry row — the registry was never opened.\n    expect(existsSync(store.registryPath)).toBe(false);\n    const listed = await threads.listThreads({ registryPath: store.registryPath });\n    expect(listed.ok).toBe(true);\n    if (listed.ok) expect(listed.value).toEqual([]);\n  });\n\n  it(\"newThread with a whitespace-only path is refused the same way\", async () => {\n    const result = await threads.newThread({\n      filePath: \"   \",\n      registryPath: store.registryPath,\n    });\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"invalid_thread_ref\");\n    expect(existsSync(store.registryPath)).toBe(false);\n  });\n\n  it(\"resolveThreadRef({ filePath: '' }) fails closed with caller_error\", async () => {\n    const result = await threads.resolveThreadRef({ filePath: \"\" });\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"invalid_thread_ref\");\n  });\n});\n\ndescribe(\"F-EPIC-002 (SDK): read surfaces validate the thread reference\", () => {\n  for (const surface of READ_SURFACES) {\n    it(`${surface.name}: empty path → caller_error (no storage open)`, async () => {\n      const result = await surface.call({ filePath: \"\" });\n      expect(result.ok).toBe(false);\n      if (result.ok) return;\n      expect(result.error?.errorClass).toBe(\"caller_error\");\n    });\n\n    it(`${surface.name}: unknown id → thread_not_found`, async () => {\n      const result = await surface.call({\n        threadId: \"th_unknown\",\n        registryPath: store.registryPath,\n      });\n      expect(result.ok).toBe(false);\n      if (result.ok) return;\n      expect(result.error?.errorClass).toBe(\"caller_error\");\n      expect(result.error?.code).toBe(\"thread_not_found\");\n    });\n  }\n});\n\ndescribe(\"F-EPIC-001 / NB-2 (CLI in-process): usage errors are named, not swallowed\", () => {\n  interface CliErr {\n    ok: false;\n    error: { errorClass: string; code: string; reason: string };\n  }\n  function parseErr(stdout: string): CliErr {\n    return JSON.parse(stdout) as CliErr;\n  }\n\n  it(\"new-thread with an empty --file-path exits 1, JSON error, clean registry\", async () => {\n    const result = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      \"\",\n      \"--registry\",\n      store.registryPath,\n    ]);\n    expect(result.exitCode).toBe(1);\n    const parsed = parseErr(result.stdout);\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"invalid_thread_ref\");\n    expect(existsSync(store.registryPath)).toBe(false);\n  });\n\n  it(\"an unknown/misspelled flag is rejected by name, exit 1, nothing created\", async () => {\n    const result = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      store.threadPath(),\n      \"--titel\",\n      \"typo\",\n      \"--registry\",\n      store.registryPath,\n    ]);\n    expect(result.exitCode).toBe(1);\n    const parsed = parseErr(result.stdout);\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.code).toBe(\"unknown_flag\");\n    expect(parsed.error.reason).toContain(\"--titel\");\n    // Strict parse fails before the SDK call, so no thread was created.\n    expect(existsSync(store.registryPath)).toBe(false);\n  });\n\n  for (const command of [\n    \"messages list\",\n    \"messages list-queued-work\",\n    \"turns list\",\n    \"turns list-queued-work\",\n  ]) {\n    it(`${command} without a thread reference is a missing-flag usage error`, async () => {\n      const result = await runCli(command.split(\" \"));\n      expect(result.exitCode).toBe(1);\n      const parsed = parseErr(result.stdout);\n      expect(parsed.ok).toBe(false);\n      expect(parsed.error.code).toBe(\"missing_flag\");\n      expect(parsed.error.reason).toContain(\"--thread-id or --file-path\");\n    });\n  }\n});\n","numLines":160,"startLine":1,"totalLines":160}}}

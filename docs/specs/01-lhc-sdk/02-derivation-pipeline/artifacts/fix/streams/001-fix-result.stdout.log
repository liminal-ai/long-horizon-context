{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RXduf3DmEesPZifW4kkTvW","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\timport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\n11\timport { runTurnsDelete } from \"./turns-mutate.js\";\n12\timport {\n13\t  runMessagesReport,\n14\t  runMessagesRequeue,\n15\t  runTurnsReport,\n16\t  runTurnsRequeue,\n17\t  runWorkDrain,\n18\t} from \"./work.js\";\n19\t\n20\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n21\t// process stdin. null means interactive (TTY) — distinct from empty input\n22\t// only in how it arises; both are refused with empty_stdin before any SDK\n23\t// call (the SDK itself can never return that code).\n24\texport type StdinReader = () => Promise<string | null>;\n25\t\n26\tasync function readProcessStdin(): Promise<string | null> {\n27\t  if (process.stdin.isTTY) return null;\n28\t  process.stdin.setEncoding(\"utf8\");\n29\t  let data = \"\";\n30\t  for await (const chunk of process.stdin) data += String(chunk);\n31\t  return data;\n32\t}\n33\t\n34\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n35\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n36\t}\n37\t\n38\tconst HELP = `lhc — Long Horizon Context CLI\n39\t\n40\tUsage:\n41\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n42\t  lhc threads resolve --thread-id <id> [--registry <r>]\n43\t  lhc threads list [--registry <r>]\n44\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n45\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n46\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n47\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n48\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n49\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n50\t  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n51\t  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n52\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n53\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n54\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n55\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n56\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n57\t  lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n58\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n59\t\n60\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n61\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n62\t`;\n63\t\n64\tinterface ParsedFlags {\n65\t  threadId?: string;\n66\t  filePath?: string;\n67\t  title?: string;\n68\t  registryPath?: string;\n69\t  maxItems?: string;\n70\t  provider?: string;\n71\t  notReady?: boolean;\n72\t  messageId?: string;\n73\t  turnId?: string;\n74\t  chunkId?: string;\n75\t  form?: string;\n76\t  subjectKind?: string;\n77\t  subjectId?: string;\n78\t  content?: string;\n79\t}\n80\t\n81\t// strict parse rejects unknown/misspelled flags so they are named back to the\n82\t// caller, never silently dropped — the CLI boundary matching the SDK's\n83\t// closed-contract strictness. The failure is returned as data (not thrown) so\n84\t// runCli can render it as the structured usage error.\n85\ttype ParseFlagsResult =\n86\t  | { ok: true; flags: ParsedFlags }\n87\t  | { ok: false; unknownFlag: string };\n88\t\n89\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n90\t  let values;\n91\t  try {\n92\t    ({ values } = parseArgs({\n93\t      args: [...args],\n94\t      options: {\n95\t        \"thread-id\": { type: \"string\" },\n96\t        \"file-path\": { type: \"string\" },\n97\t        title: { type: \"string\" },\n98\t        registry: { type: \"string\" },\n99\t        \"max-items\": { type: \"string\" },\n100\t        provider: { type: \"string\" },\n101\t        \"not-ready\": { type: \"boolean\" },\n102\t        \"message-id\": { type: \"string\" },\n103\t        \"turn-id\": { type: \"string\" },\n104\t        \"chunk-id\": { type: \"string\" },\n105\t        form: { type: \"string\" },\n106\t        \"subject-kind\": { type: \"string\" },\n107\t        \"subject-id\": { type: \"string\" },\n108\t        // `--message` / `--turn` are the mutation commands' spellings\n109\t        // (story/tech design); they parse into the same slots as\n110\t        // `--message-id` / `--turn-id`.\n111\t        message: { type: \"string\" },\n112\t        turn: { type: \"string\" },\n113\t        content: { type: \"string\" },\n114\t      },\n115\t      strict: true,\n116\t      allowPositionals: true,\n117\t    }));\n118\t  } catch (cause) {\n119\t    const message = cause instanceof Error ? cause.message : String(cause);\n120\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n121\t    // option '--file-pth'); surface that token, falling back to the message.\n122\t    const named = /'([^']+)'/.exec(message);\n123\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n124\t  }\n125\t  const flags: ParsedFlags = {};\n126\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n127\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n128\t  if (typeof values.title === \"string\") flags.title = values.title;\n129\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n130\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n131\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n132\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n133\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n134\t  if (typeof values.message === \"string\") flags.messageId = values.message;\n135\t  if (typeof values.content === \"string\") flags.content = values.content;\n136\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n137\t  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n138\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n139\t  if (typeof values.form === \"string\") flags.form = values.form;\n140\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n141\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n142\t  return { ok: true, flags };\n143\t}\n144\t\n145\t// The read commands take a thread reference but no stdin; a missing reference\n146\t// is a usage error named before any SDK call, matching the intake commands.\n147\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n148\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n149\t    return renderCliError(\n150\t      \"caller_error\",\n151\t      \"missing_flag\",\n152\t      `${command} requires --thread-id or --file-path`,\n153\t    );\n154\t  }\n155\t  return undefined;\n156\t}\n157\t\n158\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n159\t  if (flags.threadId !== undefined) {\n160\t    return flags.registryPath !== undefined\n161\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n162\t      : { threadId: flags.threadId };\n163\t  }\n164\t  return { filePath: flags.filePath ?? \"\" };\n165\t}\n166\t\n167\texport async function runCli(\n168\t  argv: readonly string[],\n169\t  readStdin: StdinReader = readProcessStdin,\n170\t): Promise<CliResult> {\n171\t  if (argv.length === 0) {\n172\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n173\t  }\n174\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n175\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n176\t  }\n177\t\n178\t  const [group, command, ...rest] = argv;\n179\t  const key = command === undefined ? group : `${group} ${command}`;\n180\t  const parsed = parseFlags(command === undefined ? [] : rest);\n181\t  if (!parsed.ok) {\n182\t    return renderCliError(\n183\t      \"caller_error\",\n184\t      \"unknown_flag\",\n185\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n186\t    );\n187\t  }\n188\t  const flags = parsed.flags;\n189\t\n190\t  switch (key) {\n191\t    case \"threads new-thread\": {\n192\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n193\t      // instead of failing, so the adapter refuses before any SDK call.\n194\t      if (flags.filePath === undefined) {\n195\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n196\t      }\n197\t      const input: Parameters<typeof threads.newThread>[0] = {\n198\t        filePath: flags.filePath,\n199\t      };\n200\t      if (flags.title !== undefined) input.title = flags.title;\n201\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n202\t      return renderResult(await threads.newThread(input));\n203\t    }\n204\t    case \"threads resolve\": {\n205\t      if (flags.threadId === undefined) {\n206\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n207\t      }\n208\t      const input: Parameters<typeof threads.resolve>[0] = {\n209\t        threadId: flags.threadId,\n210\t      };\n211\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n212\t      return renderResult(await threads.resolve(input));\n213\t    }\n214\t    case \"threads list\": {\n215\t      return renderResult(\n216\t        await threads.listThreads(\n217\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n218\t        ),\n219\t      );\n220\t    }\n221\t    case \"intake-stream message-events\": {\n222\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n223\t        return renderCliError(\n224\t          \"caller_error\",\n225\t          \"missing_flag\",\n226\t          \"intake-stream message-events requires --thread-id or --file-path\",\n227\t        );\n228\t      }\n229\t      const text = await readStdin();\n230\t      if (text === null || text.trim() === \"\") {\n231\t        return renderResult(\n232\t          stdinCallerError(\n233\t            \"empty_stdin\",\n234\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n235\t          ),\n236\t        );\n237\t      }\n238\t      let parsed: unknown;\n239\t      try {\n240\t        parsed = JSON.parse(text);\n241\t      } catch (cause) {\n242\t        const detail = cause instanceof Error ? cause.message : String(cause);\n243\t        return renderResult(\n244\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n245\t        );\n246\t      }\n247\t      if (!Array.isArray(parsed)) {\n248\t        return renderResult(\n249\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n250\t        );\n251\t      }\n252\t      return renderResult(\n253\t        await intakeStream.messageEvents(\n254\t          threadRefFrom(flags),\n255\t          parsed as readonly MessageEventInput[],\n256\t        ),\n257\t      );\n258\t    }\n259\t    case \"intake-stream list-events\": {\n260\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n261\t        return renderCliError(\n262\t          \"caller_error\",\n263\t          \"missing_flag\",\n264\t          \"intake-stream list-events requires --thread-id or --file-path\",\n265\t        );\n266\t      }\n267\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n268\t    }\n269\t    case \"messages list\":\n270\t      return (\n271\t        requireThreadRef(flags, \"messages list\") ??\n272\t        renderResult(await messages.listMessages(threadRefFrom(flags)))\n273\t      );\n274\t    case \"messages list-queued-work\":\n275\t      return (\n276\t        requireThreadRef(flags, \"messages list-queued-work\") ??\n277\t        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n278\t      );\n279\t    case \"messages report\": {\n280\t      const missingRef = requireThreadRef(flags, \"messages report\");\n281\t      if (missingRef !== undefined) return missingRef;\n282\t      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n283\t      if (flags.notReady === true) reportFlags.notReady = true;\n284\t      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n285\t      return runMessagesReport(threadRefFrom(flags), reportFlags);\n286\t    }\n287\t    case \"messages requeue\": {\n288\t      const missingRef = requireThreadRef(flags, \"messages requeue\");\n289\t      if (missingRef !== undefined) return missingRef;\n290\t      if (flags.messageId === undefined || flags.form === undefined) {\n291\t        return renderCliError(\n292\t          \"caller_error\",\n293\t          \"missing_flag\",\n294\t          \"messages requeue requires --message-id and --form\",\n295\t        );\n296\t      }\n297\t      return runMessagesRequeue(threadRefFrom(flags), {\n298\t        messageId: flags.messageId,\n299\t        form: flags.form,\n300\t      });\n301\t    }\n302\t    case \"messages edit\": {\n303\t      const missingRef = requireThreadRef(flags, \"messages edit\");\n304\t      if (missingRef !== undefined) return missingRef;\n305\t      if (flags.messageId === undefined || flags.content === undefined) {\n306\t        return renderCliError(\n307\t          \"caller_error\",\n308\t          \"missing_flag\",\n309\t          \"messages edit requires --message (or --message-id) and --content\",\n310\t        );\n311\t      }\n312\t      return runMessagesEdit(threadRefFrom(flags), {\n313\t        messageId: flags.messageId,\n314\t        content: flags.content,\n315\t      });\n316\t    }\n317\t    case \"messages delete\": {\n318\t      const missingRef = requireThreadRef(flags, \"messages delete\");\n319\t      if (missingRef !== undefined) return missingRef;\n320\t      if (flags.messageId === undefined) {\n321\t        return renderCliError(\n322\t          \"caller_error\",\n323\t          \"missing_flag\",\n324\t          \"messages delete requires --message (or --message-id)\",\n325\t        );\n326\t      }\n327\t      return runMessagesDelete(threadRefFrom(flags), { messageId: flags.messageId });\n328\t    }\n329\t    case \"turns list\":\n330\t      return (\n331\t        requireThreadRef(flags, \"turns list\") ??\n332\t        renderResult(await turns.listTurns(threadRefFrom(flags)))\n333\t      );\n334\t    case \"turns list-chunks\":\n335\t      return (\n336\t        requireThreadRef(flags, \"turns list-chunks\") ??\n337\t        renderResult(await turns.listChunks(threadRefFrom(flags)))\n338\t      );\n339\t    case \"turns list-queued-work\":\n340\t      return (\n341\t        requireThreadRef(flags, \"turns list-queued-work\") ??\n342\t        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n343\t      );\n344\t    case \"turns report\": {\n345\t      const missingRef = requireThreadRef(flags, \"turns report\");\n346\t      if (missingRef !== undefined) return missingRef;\n347\t      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n348\t      if (flags.notReady === true) reportFlags.notReady = true;\n349\t      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n350\t      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n351\t      return runTurnsReport(threadRefFrom(flags), reportFlags);\n352\t    }\n353\t    case \"turns requeue\": {\n354\t      const missingRef = requireThreadRef(flags, \"turns requeue\");\n355\t      if (missingRef !== undefined) return missingRef;\n356\t      if (\n357\t        flags.subjectKind === undefined ||\n358\t        flags.subjectId === undefined ||\n359\t        flags.form === undefined\n360\t      ) {\n361\t        return renderCliError(\n362\t          \"caller_error\",\n363\t          \"missing_flag\",\n364\t          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n365\t        );\n366\t      }\n367\t      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n368\t        return renderCliError(\n369\t          \"caller_error\",\n370\t          \"missing_flag\",\n371\t          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n372\t        );\n373\t      }\n374\t      return runTurnsRequeue(threadRefFrom(flags), {\n375\t        subjectKind: flags.subjectKind,\n376\t        subjectId: flags.subjectId,\n377\t        form: flags.form,\n378\t      });\n379\t    }\n380\t    case \"turns delete\": {\n381\t      const missingRef = requireThreadRef(flags, \"turns delete\");\n382\t      if (missingRef !== undefined) return missingRef;\n383\t      if (flags.turnId === undefined) {\n384\t        return renderCliError(\n385\t          \"caller_error\",\n386\t          \"missing_flag\",\n387\t          \"turns delete requires --turn (or --turn-id)\",\n388\t        );\n389\t      }\n390\t      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\n391\t    }\n392\t    case \"work drain\": {\n393\t      const missingRef = requireThreadRef(flags, \"work drain\");\n394\t      if (missingRef !== undefined) return missingRef;\n395\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n396\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n397\t      if (flags.maxItems !== undefined) {\n398\t        const maxItems = Number(flags.maxItems);\n399\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n400\t          return renderCliError(\n401\t            \"caller_error\",\n402\t            \"missing_flag\",\n403\t            `--max-items must be a positive integer, got ${flags.maxItems}`,\n404\t          );\n405\t        }\n406\t        drainFlags.maxItems = maxItems;\n407\t      }\n408\t      return runWorkDrain(threadRefFrom(flags), drainFlags);\n409\t    }\n410\t    default:\n411\t      return renderCliError(\n412\t        \"caller_error\",\n413\t        \"unknown_command\",\n414\t        `unknown command: ${key}; run lhc --help`,\n415\t      );\n416\t  }\n417\t}\n418\t"}]},"parent_tool_use_id":null,"session_id":"b8d4e4d4-0320-4750-a113-f05b3f0942c7","uuid":"8e74f952-0848-4e27-ad30-a6c1861b6c18","timestamp":"2026-06-11T08:24:24.086Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/index.ts","content":"import { parseArgs } from \"node:util\";\nimport * as intakeStream from \"../domains/intake-stream/index.js\";\nimport * as messages from \"../domains/messages/index.js\";\nimport * as threads from \"../domains/threads/index.js\";\nimport * as turns from \"../domains/turns/index.js\";\nimport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\nimport type { ThreadRef } from \"../domains/threads/index.js\";\nimport type { OpResult } from \"../shared/errors.js\";\nimport { renderCliError, renderResult, type CliResult } from \"./render.js\";\nimport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\nimport { runTurnsDelete } from \"./turns-mutate.js\";\nimport {\n  runMessagesReport,\n  runMessagesRequeue,\n  runTurnsReport,\n  runTurnsRequeue,\n  runWorkDrain,\n} from \"./work.js\";\n\n// Stdin seam: in-process tests inject a reader; the binary reads the real\n// process stdin. null means interactive (TTY) — distinct from empty input\n// only in how it arises; both are refused with empty_stdin before any SDK\n// call (the SDK itself can never return that code).\nexport type StdinReader = () => Promise<string | null>;\n\nasync function readProcessStdin(): Promise<string | null> {\n  if (process.stdin.isTTY) return null;\n  process.stdin.setEncoding(\"utf8\");\n  let data = \"\";\n  for await (const chunk of process.stdin) data += String(chunk);\n  return data;\n}\n\nfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst HELP = `lhc — Long Horizon Context CLI\n\nUsage:\n  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n  lhc threads resolve --thread-id <id> [--registry <r>]\n  lhc threads list [--registry <r>]\n  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n  lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n\nEvery command prints the SDK result (value or error) as JSON and exits 0 on\nsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n`;\n\ninterface ParsedFlags {\n  threadId?: string;\n  filePath?: string;\n  title?: string;\n  registryPath?: string;\n  maxItems?: string;\n  provider?: string;\n  notReady?: boolean;\n  messageId?: string;\n  turnId?: string;\n  chunkId?: string;\n  form?: string;\n  subjectKind?: string;\n  subjectId?: string;\n  content?: string;\n}\n\n// strict parse rejects unknown/misspelled flags so they are named back to the\n// caller, never silently dropped — the CLI boundary matching the SDK's\n// closed-contract strictness. The failure is returned as data (not thrown) so\n// runCli can render it as the structured usage error.\ntype ParseFlagsResult =\n  | { ok: true; flags: ParsedFlags }\n  | { ok: false; unknownFlag: string };\n\nfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n  let values;\n  try {\n    ({ values } = parseArgs({\n      args: [...args],\n      options: {\n        \"thread-id\": { type: \"string\" },\n        \"file-path\": { type: \"string\" },\n        title: { type: \"string\" },\n        registry: { type: \"string\" },\n        \"max-items\": { type: \"string\" },\n        provider: { type: \"string\" },\n        \"not-ready\": { type: \"boolean\" },\n        \"message-id\": { type: \"string\" },\n        \"turn-id\": { type: \"string\" },\n        \"chunk-id\": { type: \"string\" },\n        form: { type: \"string\" },\n        \"subject-kind\": { type: \"string\" },\n        \"subject-id\": { type: \"string\" },\n        // `--message` / `--turn` are the mutation commands' spellings\n        // (story/tech design); they parse into the same slots as\n        // `--message-id` / `--turn-id`.\n        message: { type: \"string\" },\n        turn: { type: \"string\" },\n        content: { type: \"string\" },\n      },\n      strict: true,\n      allowPositionals: true,\n    }));\n  } catch (cause) {\n    const message = cause instanceof Error ? cause.message : String(cause);\n    // parseArgs names the offending option in single quotes (e.g. Unknown\n    // option '--file-pth'); surface that token, falling back to the message.\n    const named = /'([^']+)'/.exec(message);\n    return { ok: false, unknownFlag: named?.[1] ?? message };\n  }\n  const flags: ParsedFlags = {};\n  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n  if (typeof values.title === \"string\") flags.title = values.title;\n  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n  if (typeof values.provider === \"string\") flags.provider = values.provider;\n  if (values[\"not-ready\"] === true) flags.notReady = true;\n  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n  if (typeof values.message === \"string\") flags.messageId = values.message;\n  if (typeof values.content === \"string\") flags.content = values.content;\n  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n  if (typeof values.form === \"string\") flags.form = values.form;\n  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n  return { ok: true, flags };\n}\n\n// The read commands take a thread reference but no stdin; a missing reference\n// is a usage error named before any SDK call, matching the intake commands.\nfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n  if (flags.threadId === undefined && flags.filePath === undefined) {\n    return renderCliError(\n      \"caller_error\",\n      \"missing_flag\",\n      `${command} requires --thread-id or --file-path`,\n    );\n  }\n  return undefined;\n}\n\nfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n  if (flags.threadId !== undefined) {\n    return flags.registryPath !== undefined\n      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n      : { threadId: flags.threadId };\n  }\n  return { filePath: flags.filePath ?? \"\" };\n}\n\nexport async function runCli(\n  argv: readonly string[],\n  readStdin: StdinReader = readProcessStdin,\n): Promise<CliResult> {\n  if (argv.length === 0) {\n    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n  }\n  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n  }\n\n  const [group, command, ...rest] = argv;\n  const key = command === undefined ? group : `${group} ${command}`;\n  const parsed = parseFlags(command === undefined ? [] : rest);\n  if (!parsed.ok) {\n    return renderCliError(\n      \"caller_error\",\n      \"unknown_flag\",\n      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n    );\n  }\n  const flags = parsed.flags;\n\n  switch (key) {\n    case \"threads new-thread\": {\n      // Guard here: an empty path reaching node:sqlite opens a temp database\n      // instead of failing, so the adapter refuses before any SDK call.\n      if (flags.filePath === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n      }\n      const input: Parameters<typeof threads.newThread>[0] = {\n        filePath: flags.filePath,\n      };\n      if (flags.title !== undefined) input.title = flags.title;\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.newThread(input));\n    }\n    case \"threads resolve\": {\n      if (flags.threadId === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n      }\n      const input: Parameters<typeof threads.resolve>[0] = {\n        threadId: flags.threadId,\n      };\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.resolve(input));\n    }\n    case \"threads list\": {\n      return renderResult(\n        await threads.listThreads(\n          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n        ),\n      );\n    }\n    case \"intake-stream message-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream message-events requires --thread-id or --file-path\",\n        );\n      }\n      const text = await readStdin();\n      if (text === null || text.trim() === \"\") {\n        return renderResult(\n          stdinCallerError(\n            \"empty_stdin\",\n            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n          ),\n        );\n      }\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(text);\n      } catch (cause) {\n        const detail = cause instanceof Error ? cause.message : String(cause);\n        return renderResult(\n          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n        );\n      }\n      if (!Array.isArray(parsed)) {\n        return renderResult(\n          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n        );\n      }\n      return renderResult(\n        await intakeStream.messageEvents(\n          threadRefFrom(flags),\n          parsed as readonly MessageEventInput[],\n        ),\n      );\n    }\n    case \"intake-stream list-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream list-events requires --thread-id or --file-path\",\n        );\n      }\n      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n    }\n    case \"messages list\":\n      return (\n        requireThreadRef(flags, \"messages list\") ??\n        renderResult(await messages.listMessages(threadRefFrom(flags)))\n      );\n    case \"messages list-queued-work\":\n      return (\n        requireThreadRef(flags, \"messages list-queued-work\") ??\n        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"messages report\": {\n      const missingRef = requireThreadRef(flags, \"messages report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n      return runMessagesReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"messages requeue\": {\n      const missingRef = requireThreadRef(flags, \"messages requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined || flags.form === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages requeue requires --message-id and --form\",\n        );\n      }\n      return runMessagesRequeue(threadRefFrom(flags), {\n        messageId: flags.messageId,\n        form: flags.form,\n      });\n    }\n    case \"messages edit\": {\n      const missingRef = requireThreadRef(flags, \"messages edit\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined || flags.content === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages edit requires --message (or --message-id) and --content\",\n        );\n      }\n      return runMessagesEdit(threadRefFrom(flags), {\n        messageId: flags.messageId,\n        content: flags.content,\n      });\n    }\n    case \"messages delete\": {\n      const missingRef = requireThreadRef(flags, \"messages delete\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages delete requires --message (or --message-id)\",\n        );\n      }\n      return runMessagesDelete(threadRefFrom(flags), { messageId: flags.messageId });\n    }\n    case \"turns list\":\n      return (\n        requireThreadRef(flags, \"turns list\") ??\n        renderResult(await turns.listTurns(threadRefFrom(flags)))\n      );\n    case \"turns list-chunks\":\n      return (\n        requireThreadRef(flags, \"turns list-chunks\") ??\n        renderResult(await turns.listChunks(threadRefFrom(flags)))\n      );\n    case \"turns list-queued-work\":\n      return (\n        requireThreadRef(flags, \"turns list-queued-work\") ??\n        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"turns report\": {\n      const missingRef = requireThreadRef(flags, \"turns report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n      return runTurnsReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"turns requeue\": {\n      const missingRef = requireThreadRef(flags, \"turns requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (\n        flags.subjectKind === undefined ||\n        flags.subjectId === undefined ||\n        flags.form === undefined\n      ) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n        );\n      }\n      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n        );\n      }\n      return runTurnsRequeue(threadRefFrom(flags), {\n        subjectKind: flags.subjectKind,\n        subjectId: flags.subjectId,\n        form: flags.form,\n      });\n    }\n    case \"turns delete\": {\n      const missingRef = requireThreadRef(flags, \"turns delete\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.turnId === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"turns delete requires --turn (or --turn-id)\",\n        );\n      }\n      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\n    }\n    case \"work drain\": {\n      const missingRef = requireThreadRef(flags, \"work drain\");\n      if (missingRef !== undefined) return missingRef;\n      const drainFlags: { provider?: string; maxItems?: number } = {};\n      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n      if (flags.maxItems !== undefined) {\n        const maxItems = Number(flags.maxItems);\n        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n          return renderCliError(\n            \"caller_error\",\n            \"missing_flag\",\n            `--max-items must be a positive integer, got ${flags.maxItems}`,\n          );\n        }\n        drainFlags.maxItems = maxItems;\n      }\n      return runWorkDrain(threadRefFrom(flags), drainFlags);\n    }\n    default:\n      return renderCliError(\n        \"caller_error\",\n        \"unknown_command\",\n        `unknown command: ${key}; run lhc --help`,\n      );\n  }\n}\n","numLines":418,"startLine":1,"totalLines":418}}}

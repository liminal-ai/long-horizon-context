{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WqK2BDK7U3djogciHA43U6","type":"tool_result","content":"1\t// Story 1's registered test handlers: one per work kind, each calling the\n2\t// matching provider operation with deterministic input derived from the\n3\t// item's source id and handing the resulting form content back through the\n4\t// HandlerOutcome contract. Real handlers (Stories 2–3) read records; these\n5\t// exist so the drain's mechanics — claim, retry, terminal paths, report —\n6\t// are exercised against the real handler seam with the double scripted per\n7\t// test. Registered by assigning into the SDK's assembled map, the same map\n8\t// production domain tables merge into (DD-6).\n9\timport type {\n10\t  DerivationProvider,\n11\t  HandlerFormWrite,\n12\t  Lhc,\n13\t  ProviderResult,\n14\t  SubjectKind,\n15\t  FormKind,\n16\t  WorkHandler,\n17\t  WorkKind,\n18\t} from \"../../src/index.js\";\n19\t\n20\tinterface FormSpec {\n21\t  subjectKind: SubjectKind;\n22\t  form: FormKind;\n23\t  call: (provider: DerivationProvider, sourceId: string) => Promise<ProviderResult>;\n24\t}\n25\t\n26\tconst KIND_SPECS: Record<WorkKind, FormSpec[]> = {\n27\t  prompt_smoothing: [\n28\t    {\n29\t      subjectKind: \"message\",\n30\t      form: \"smoothed_prompt\",\n31\t      call: (p, id) => p.smoothPrompt({ text: `prompt:${id}` }),\n32\t    },\n33\t  ],\n34\t  tool_call_summary: [\n35\t    {\n36\t      subjectKind: \"message\",\n37\t      form: \"tool_call_summary\",\n38\t      call: (p, id) => p.summarizeToolCall({ toolName: \"fixture\", argsJson: `{\"source\":\"${id}\"}` }),\n39\t    },\n40\t  ],\n41\t  tool_result_summary: [\n42\t    {\n43\t      subjectKind: \"message\",\n44\t      form: \"tool_result_summary\",\n45\t      call: (p, id) => p.summarizeToolResult({ toolName: \"fixture\", content: `result:${id}` }),\n46\t    },\n47\t  ],\n48\t  turn_derivation: [\n49\t    {\n50\t      subjectKind: \"turn\",\n51\t      form: \"turn_rendering\",\n52\t      call: (p, id) =>\n53\t        p.composeTurnRendering({\n54\t          parts: [{ messageId: id, kind: \"user_prompt\", text: `turn:${id}`, fallback: false }],\n55\t        }),\n56\t    },\n57\t    {\n58\t      subjectKind: \"turn\",\n59\t      form: \"lower_band_projection\",\n60\t      call: (p, id) => p.projectLowerBand({ rendering: `turn:${id}` }),\n61\t    },\n62\t  ],\n63\t  chunk_summary_detailed: [\n64\t    {\n65\t      subjectKind: \"chunk\",\n66\t      form: \"chunk_summary_detailed\",\n67\t      call: (p, id) => p.summarizeChunkDetailed({ memberProjections: [`chunk:${id}`] }),\n68\t    },\n69\t  ],\n70\t  chunk_summary_brief: [\n71\t    {\n72\t      subjectKind: \"chunk\",\n73\t      form: \"chunk_summary_brief\",\n74\t      call: (p, id) => p.summarizeChunkBrief({ memberProjections: [`chunk:${id}`] }),\n75\t    },\n76\t  ],\n77\t};\n78\t\n79\texport interface TestHandlerHooks {\n80\t  // Fires when a handler begins running an item — i.e. after the item's\n81\t  // claim committed and any earlier item's completion landed. The kill and\n82\t  // hold runners hang their marker/sleep protocol here.\n83\t  onHandlerStart?: (item: { workItemId: string; kind: string }) => void | Promise<void>;\n84\t}\n85\t\n86\texport function testWorkHandlers(\n87\t  provider: DerivationProvider,\n88\t  hooks: TestHandlerHooks = {},\n89\t): Partial<Record<WorkKind, WorkHandler>> {\n90\t  const map: Partial<Record<WorkKind, WorkHandler>> = {};\n91\t  for (const [kind, specs] of Object.entries(KIND_SPECS) as Array<[WorkKind, FormSpec[]]>) {\n92\t    map[kind] = async (_run, item) => {\n93\t      await hooks.onHandlerStart?.(item);\n94\t      const sourceId =\n95\t        item.sourceRef[\"messageId\"] ?? item.sourceRef[\"turnId\"] ?? item.sourceRef[\"chunkId\"];\n96\t      if (sourceId === undefined) {\n97\t        return { ok: false, retryable: false, reason: \"test handler: unrecognized sourceRef\" };\n98\t      }\n99\t      const forms: HandlerFormWrite[] = [];\n100\t      for (const spec of specs) {\n101\t        const result = await spec.call(provider, sourceId);\n102\t        if (!result.ok) {\n103\t          return { ok: false, retryable: result.retryable, reason: result.reason };\n104\t        }\n105\t        forms.push({\n106\t          subjectKind: spec.subjectKind,\n107\t          subjectId: sourceId,\n108\t          form: spec.form,\n109\t          content: result.text,\n110\t        });\n111\t      }\n112\t      return { ok: true, forms };\n113\t    };\n114\t  }\n115\t  return map;\n116\t}\n117\t\n118\t// Registration is plain assignment into the assembled per-SDK map — the same\n119\t// map createSdk merged the (empty until Stories 2–3) domain tables into.\n120\texport function registerTestWorkHandlers(\n121\t  sdk: Lhc,\n122\t  provider: DerivationProvider,\n123\t  hooks?: TestHandlerHooks,\n124\t): void {\n125\t  Object.assign(sdk.workHandlers, testWorkHandlers(provider, hooks));\n126\t}\n127\t"}]},"parent_tool_use_id":null,"session_id":"b8d4e4d4-0320-4750-a113-f05b3f0942c7","uuid":"49c9befc-2663-4efc-aa23-c0a68f3d0ef9","timestamp":"2026-06-11T08:21:48.535Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/work-handlers.ts","content":"// Story 1's registered test handlers: one per work kind, each calling the\n// matching provider operation with deterministic input derived from the\n// item's source id and handing the resulting form content back through the\n// HandlerOutcome contract. Real handlers (Stories 2–3) read records; these\n// exist so the drain's mechanics — claim, retry, terminal paths, report —\n// are exercised against the real handler seam with the double scripted per\n// test. Registered by assigning into the SDK's assembled map, the same map\n// production domain tables merge into (DD-6).\nimport type {\n  DerivationProvider,\n  HandlerFormWrite,\n  Lhc,\n  ProviderResult,\n  SubjectKind,\n  FormKind,\n  WorkHandler,\n  WorkKind,\n} from \"../../src/index.js\";\n\ninterface FormSpec {\n  subjectKind: SubjectKind;\n  form: FormKind;\n  call: (provider: DerivationProvider, sourceId: string) => Promise<ProviderResult>;\n}\n\nconst KIND_SPECS: Record<WorkKind, FormSpec[]> = {\n  prompt_smoothing: [\n    {\n      subjectKind: \"message\",\n      form: \"smoothed_prompt\",\n      call: (p, id) => p.smoothPrompt({ text: `prompt:${id}` }),\n    },\n  ],\n  tool_call_summary: [\n    {\n      subjectKind: \"message\",\n      form: \"tool_call_summary\",\n      call: (p, id) => p.summarizeToolCall({ toolName: \"fixture\", argsJson: `{\"source\":\"${id}\"}` }),\n    },\n  ],\n  tool_result_summary: [\n    {\n      subjectKind: \"message\",\n      form: \"tool_result_summary\",\n      call: (p, id) => p.summarizeToolResult({ toolName: \"fixture\", content: `result:${id}` }),\n    },\n  ],\n  turn_derivation: [\n    {\n      subjectKind: \"turn\",\n      form: \"turn_rendering\",\n      call: (p, id) =>\n        p.composeTurnRendering({\n          parts: [{ messageId: id, kind: \"user_prompt\", text: `turn:${id}`, fallback: false }],\n        }),\n    },\n    {\n      subjectKind: \"turn\",\n      form: \"lower_band_projection\",\n      call: (p, id) => p.projectLowerBand({ rendering: `turn:${id}` }),\n    },\n  ],\n  chunk_summary_detailed: [\n    {\n      subjectKind: \"chunk\",\n      form: \"chunk_summary_detailed\",\n      call: (p, id) => p.summarizeChunkDetailed({ memberProjections: [`chunk:${id}`] }),\n    },\n  ],\n  chunk_summary_brief: [\n    {\n      subjectKind: \"chunk\",\n      form: \"chunk_summary_brief\",\n      call: (p, id) => p.summarizeChunkBrief({ memberProjections: [`chunk:${id}`] }),\n    },\n  ],\n};\n\nexport interface TestHandlerHooks {\n  // Fires when a handler begins running an item — i.e. after the item's\n  // claim committed and any earlier item's completion landed. The kill and\n  // hold runners hang their marker/sleep protocol here.\n  onHandlerStart?: (item: { workItemId: string; kind: string }) => void | Promise<void>;\n}\n\nexport function testWorkHandlers(\n  provider: DerivationProvider,\n  hooks: TestHandlerHooks = {},\n): Partial<Record<WorkKind, WorkHandler>> {\n  const map: Partial<Record<WorkKind, WorkHandler>> = {};\n  for (const [kind, specs] of Object.entries(KIND_SPECS) as Array<[WorkKind, FormSpec[]]>) {\n    map[kind] = async (_run, item) => {\n      await hooks.onHandlerStart?.(item);\n      const sourceId =\n        item.sourceRef[\"messageId\"] ?? item.sourceRef[\"turnId\"] ?? item.sourceRef[\"chunkId\"];\n      if (sourceId === undefined) {\n        return { ok: false, retryable: false, reason: \"test handler: unrecognized sourceRef\" };\n      }\n      const forms: HandlerFormWrite[] = [];\n      for (const spec of specs) {\n        const result = await spec.call(provider, sourceId);\n        if (!result.ok) {\n          return { ok: false, retryable: result.retryable, reason: result.reason };\n        }\n        forms.push({\n          subjectKind: spec.subjectKind,\n          subjectId: sourceId,\n          form: spec.form,\n          content: result.text,\n        });\n      }\n      return { ok: true, forms };\n    };\n  }\n  return map;\n}\n\n// Registration is plain assignment into the assembled per-SDK map — the same\n// map createSdk merged the (empty until Stories 2–3) domain tables into.\nexport function registerTestWorkHandlers(\n  sdk: Lhc,\n  provider: DerivationProvider,\n  hooks?: TestHandlerHooks,\n): void {\n  Object.assign(sdk.workHandlers, testWorkHandlers(provider, hooks));\n}\n","numLines":127,"startLine":1,"totalLines":127}}}

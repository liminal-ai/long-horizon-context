{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KLN3zrQyhuCWUm69Uwr8yT","type":"tool_result","content":"15\t// filtered view) change nothing (TC-5.5). The CLI parity leg of TC-5.6 lives in\n16\t// cli-process-mutations.test.ts (process suite).\n17\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n18\timport {\n19\t  createSdk,\n20\t  deterministicText,\n21\t  estimateTokens,\n22\t  messages,\n23\t  queueDetail,\n24\t  setSchedulerPoke,\n25\t  setThreadTouch,\n26\t  threads,\n27\t  type DerivationProvider,\n28\t  type DrainReport,\n29\t  type Lhc,\n30\t  type MessageEventInput,\n31\t  type MutationResult,\n32\t  type OpResult,\n33\t  type SdkConfig,\n34\t} from \"../src/index.js\";\n35\timport {\n36\t  createProviderDouble,\n37\t  openRaw,\n38\t  readDerivedForms,\n39\t  tempStore,\n40\t  validEvent,\n41\t  type TempStore,\n42\t} from \"./fixtures/index.js\";\n43\t\n44\tlet store: TempStore;\n45\tbeforeEach(() => {\n46\t  store = tempStore();\n47\t});\n48\tafterEach(() => {\n49\t  store.cleanup();\n50\t  setSchedulerPoke(null);\n51\t  setThreadTouch(null);\n52\t});\n53\t\n54\tasync function newThread(): Promise<string> {\n55\t  const created = await threads.newThread({\n56\t    filePath: store.threadPath(),\n57\t    registryPath: store.registryPath,\n58\t  });\n59\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n60\t  return created.value.filePath;\n61\t}\n62\t\n63\tfunction manualSdk(\n64\t  provider: DerivationProvider,\n65\t  overrides: Partial<Pick<SdkConfig, \"chunkPolicy\" | \"clock\" | \"mode\">> = {},\n66\t): Lhc {\n67\t  const config: SdkConfig = {\n68\t    provider,\n69\t    mode: overrides.mode ?? \"manual\",\n70\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n71\t    lease: { durationMs: 5000 },\n72\t  };\n73\t  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\n74\t  if (overrides.clock !== undefined) config.clock = overrides.clock;\n75\t  return createSdk(config);\n76\t}\n77\t\n78\tasync function send(\n79\t  sdk: Lhc,\n80\t  filePath: string,\n81\t  batch: readonly MessageEventInput[],\n82\t): Promise<void> {\n83\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n84\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n85\t}\n86\t\n87\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n88\t  const result = await sdk.work.drain({ filePath });\n89\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n90\t  return result.value;\n91\t}\n92\t\n93\tfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n94\t  const db = openRaw(filePath);"}]},"parent_tool_use_id":null,"session_id":"b8d4e4d4-0320-4750-a113-f05b3f0942c7","uuid":"f51be27f-2c7a-473f-a1d4-b043ea514221","timestamp":"2026-06-11T08:24:52.238Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/mutations.test.ts","content":"// filtered view) change nothing (TC-5.5). The CLI parity leg of TC-5.6 lives in\n// cli-process-mutations.test.ts (process suite).\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  deterministicText,\n  estimateTokens,\n  messages,\n  queueDetail,\n  setSchedulerPoke,\n  setThreadTouch,\n  threads,\n  type DerivationProvider,\n  type DrainReport,\n  type Lhc,\n  type MessageEventInput,\n  type MutationResult,\n  type OpResult,\n  type SdkConfig,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n  setSchedulerPoke(null);\n  setThreadTouch(null);\n});\n\nasync function newThread(): Promise<string> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value.filePath;\n}\n\nfunction manualSdk(\n  provider: DerivationProvider,\n  overrides: Partial<Pick<SdkConfig, \"chunkPolicy\" | \"clock\" | \"mode\">> = {},\n): Lhc {\n  const config: SdkConfig = {\n    provider,\n    mode: overrides.mode ?? \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 5000 },\n  };\n  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\n  if (overrides.clock !== undefined) config.clock = overrides.clock;\n  return createSdk(config);\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n}\n\nasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n  const result = await sdk.work.drain({ filePath });\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n  return result.value;\n}\n\nfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n  const db = openRaw(filePath);","numLines":80,"startLine":15,"totalLines":537}}}

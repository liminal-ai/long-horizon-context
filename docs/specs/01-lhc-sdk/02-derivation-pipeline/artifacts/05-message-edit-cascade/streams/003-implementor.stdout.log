{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W6KCk7LpmjbSPUtbjVMPMo","type":"tool_result","content":"1\timport type { ErrorClass, OpResult } from \"../shared/errors.js\";\n2\t\n3\texport interface CliResult {\n4\t  exitCode: number;\n5\t  stdout: string;\n6\t  stderr: string;\n7\t}\n8\t\n9\t// Adapter-level failures (unknown command, missing command) happen before any\n10\t// SDK call, so they carry adapter codes outside the SDK's ErrorCode set while\n11\t// keeping the same structural shape.\n12\texport type CliErrorCode = \"unknown_command\" | \"missing_flag\" | \"unknown_flag\";\n13\t\n14\texport function renderResult(result: OpResult<unknown>): CliResult {\n15\t  return {\n16\t    exitCode: result.ok ? 0 : 1,\n17\t    stdout: `${JSON.stringify(result, null, 2)}\\n`,\n18\t    stderr: \"\",\n19\t  };\n20\t}\n21\t\n22\texport function renderCliError(\n23\t  errorClass: ErrorClass,\n24\t  code: CliErrorCode,\n25\t  reason: string,\n26\t): CliResult {\n27\t  return {\n28\t    exitCode: 1,\n29\t    stdout: `${JSON.stringify({ ok: false, error: { errorClass, code, reason } }, null, 2)}\\n`,\n30\t    stderr: \"\",\n31\t  };\n32\t}\n33\t"}]},"parent_tool_use_id":null,"session_id":"11cfbce6-8c6f-47e4-8ae9-6d1d829e88b4","uuid":"8cae6459-7ff0-45bd-9661-6b574c1ad429","timestamp":"2026-06-11T06:02:36.409Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/render.ts","content":"import type { ErrorClass, OpResult } from \"../shared/errors.js\";\n\nexport interface CliResult {\n  exitCode: number;\n  stdout: string;\n  stderr: string;\n}\n\n// Adapter-level failures (unknown command, missing command) happen before any\n// SDK call, so they carry adapter codes outside the SDK's ErrorCode set while\n// keeping the same structural shape.\nexport type CliErrorCode = \"unknown_command\" | \"missing_flag\" | \"unknown_flag\";\n\nexport function renderResult(result: OpResult<unknown>): CliResult {\n  return {\n    exitCode: result.ok ? 0 : 1,\n    stdout: `${JSON.stringify(result, null, 2)}\\n`,\n    stderr: \"\",\n  };\n}\n\nexport function renderCliError(\n  errorClass: ErrorClass,\n  code: CliErrorCode,\n  reason: string,\n): CliResult {\n  return {\n    exitCode: 1,\n    stdout: `${JSON.stringify({ ok: false, error: { errorClass, code, reason } }, null, 2)}\\n`,\n    stderr: \"\",\n  };\n}\n","numLines":33,"startLine":1,"totalLines":33}}}

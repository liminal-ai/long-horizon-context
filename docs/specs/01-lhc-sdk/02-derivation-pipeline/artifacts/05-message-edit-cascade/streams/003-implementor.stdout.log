{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fny6WC3aHbJawThYFje5BG","type":"tool_result","content":"1\t// The three message-level derivation handlers (Flow 2): prompt smoothing,\n2\t// tool-call summary, tool-result summary. One shape throughout — read the\n3\t// source message (a tool-activity handler additionally joins its call-id\n4\t// pair, nothing more: AC-2.5), call exactly one provider operation, hand the\n5\t// form content back through HandlerOutcome. The drain's completion\n6\t// transaction performs the version-checked UPDATE-only write (Story 1), so a\n7\t// stale or deleted source discards here exactly as everywhere else. Outcomes\n8\t// on tool-activity summaries come from outcome.ts — the record, never the\n9\t// provider's text (AC-2.4) — and land in form metadata apart from content.\n10\timport type {\n11\t  HandlerFormWrite,\n12\t  HandlerOutcome,\n13\t  HandlerRunContext,\n14\t  WorkHandler,\n15\t} from \"../../../shared/derivation.js\";\n16\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n17\timport { deriveToolOutcome } from \"./outcome.js\";\n18\timport {\n19\t  findPairedToolCall,\n20\t  findPairedToolResult,\n21\t  readMessageSource,\n22\t  type MessageSource,\n23\t} from \"./forms.js\";\n24\t\n25\t// A handler that cannot read its source coherently has found source damage:\n26\t// terminal, form blocked with the reason (never a retry loop against a\n27\t// record that cannot improve). A *deleted* source never reaches this — its\n28\t// form row is gone and the completion write would discard — so a miss here\n29\t// is genuine corruption.\n30\tfunction sourceDamaged(reason: string): HandlerOutcome {\n31\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n32\t}\n33\t\n34\tfunction loadSource(\n35\t  run: HandlerRunContext,\n36\t  item: { sourceRef: Record<string, string> },\n37\t  expectedKind: string,\n38\t):\n39\t  | { ok: true; messageId: string; source: MessageSource }\n40\t  | { ok: false; outcome: HandlerOutcome } {\n41\t  const messageId = item.sourceRef[\"messageId\"];\n42\t  if (messageId === undefined) {\n43\t    return { ok: false, outcome: sourceDamaged(\"work item carries no messageId\") };\n44\t  }\n45\t  const source = readMessageSource(run.openDb(), messageId);\n46\t  if (source === undefined) {\n47\t    return { ok: false, outcome: sourceDamaged(`message ${messageId} not found`) };\n48\t  }\n49\t  if (source.kind !== expectedKind) {\n50\t    return {\n51\t      ok: false,\n52\t      outcome: sourceDamaged(\n53\t        `message ${messageId} is kind ${source.kind}, expected ${expectedKind}`,\n54\t      ),\n55\t    };\n56\t  }\n57\t  return { ok: true, messageId, source };\n58\t}\n59\t\n60\tfunction landForm(\n61\t  write: HandlerFormWrite,\n62\t  result: { ok: true; text: string } | { ok: false; retryable: boolean; reason: string },\n63\t): HandlerOutcome {\n64\t  if (!result.ok) return { ok: false, retryable: result.retryable, reason: result.reason };\n65\t  return { ok: true, forms: [{ ...write, content: result.text }] };\n66\t}\n67\t\n68\tconst smoothPromptHandler: WorkHandler = async (run, item) => {\n69\t  const loaded = loadSource(run, item, \"user_prompt\");\n70\t  if (!loaded.ok) return loaded.outcome;\n71\t  const text = loaded.source.blocks[0]?.content[\"text\"];\n72\t  if (typeof text !== \"string\") {\n73\t    return sourceDamaged(`prompt ${loaded.messageId} has no text block`);\n74\t  }\n75\t  return landForm(\n76\t    {\n77\t      subjectKind: \"message\",\n78\t      subjectId: loaded.messageId,\n79\t      form: \"smoothed_prompt\",\n80\t      content: \"\",\n81\t    },\n82\t    await run.provider.smoothPrompt({ text }),\n83\t  );\n84\t};\n85\t\n86\tconst toolCallSummaryHandler: WorkHandler = async (run, item) => {\n87\t  const loaded = loadSource(run, item, \"tool_call\");\n88\t  if (!loaded.ok) return loaded.outcome;\n89\t  const block = loaded.source.blocks[0]?.content ?? {};\n90\t  const toolCallId = block[\"toolCallId\"];\n91\t  const toolName = block[\"toolName\"];\n92\t  if (typeof toolCallId !== \"string\" || typeof toolName !== \"string\") {\n93\t    return sourceDamaged(`tool call ${loaded.messageId} has no tool_call block`);\n94\t  }\n95\t  // The handler's one reach beyond its message: the paired result by call id\n96\t  // (AC-2.5). Outcome is stamped from that pairing mechanically — present and\n97\t  // clean, present and isError, or absent — before the provider ever runs.\n98\t  const paired = findPairedToolResult(run.openDb(), toolCallId);\n99\t  const outcome = deriveToolOutcome(paired);\n100\t  const input: Parameters<typeof run.provider.summarizeToolCall>[0] = {\n101\t    toolName,\n102\t    argsJson: JSON.stringify(block[\"arguments\"] ?? {}),\n103\t  };\n104\t  if (paired !== undefined) {\n105\t    input.pairedResult = { content: paired.content, isError: paired.isError };\n106\t  }\n107\t  return landForm(\n108\t    {\n109\t      subjectKind: \"message\",\n110\t      subjectId: loaded.messageId,\n111\t      form: \"tool_call_summary\",\n112\t      content: \"\",\n113\t      metadata: { outcome },\n114\t    },\n115\t    await run.provider.summarizeToolCall(input),\n116\t  );\n117\t};\n118\t\n119\tconst toolResultSummaryHandler: WorkHandler = async (run, item) => {\n120\t  const loaded = loadSource(run, item, \"tool_result\");\n121\t  if (!loaded.ok) return loaded.outcome;\n122\t  const block = loaded.source.blocks[0]?.content ?? {};\n123\t  const content = block[\"content\"];\n124\t  if (typeof content !== \"string\") {\n125\t    return sourceDamaged(`tool result ${loaded.messageId} has no tool_result block`);\n126\t  }\n127\t  const toolCallId = block[\"toolCallId\"];\n128\t  const pairedCall =\n129\t    typeof toolCallId === \"string\"\n130\t      ? findPairedToolCall(run.openDb(), toolCallId)\n131\t      : undefined;\n132\t  // The summary abbreviates; the full result content stays untouched in the\n133\t  // record (AC-2.3) — nothing here writes back to message_block. The result\n134\t  // is tool activity, so its outcome is stamped from its own isError flag.\n135\t  return landForm(\n136\t    {\n137\t      subjectKind: \"message\",\n138\t      subjectId: loaded.messageId,\n139\t      form: \"tool_result_summary\",\n140\t      content: \"\",\n141\t      metadata: { outcome: deriveToolOutcome({ isError: block[\"isError\"] === true }) },\n142\t    },\n143\t    await run.provider.summarizeToolResult({\n144\t      toolName: pairedCall?.toolName ?? \"unknown_tool\",\n145\t      content,\n146\t    }),\n147\t  );\n148\t};\n149\t\n150\t// The domain's handler table, merged into the SDK dispatch map at\n151\t// construction (DD-6). Turn-owned kinds stay with the turns domain.\n152\texport const messageWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n153\t  prompt_smoothing: smoothPromptHandler,\n154\t  tool_call_summary: toolCallSummaryHandler,\n155\t  tool_result_summary: toolResultSummaryHandler,\n156\t};\n157\t"}]},"parent_tool_use_id":null,"session_id":"11cfbce6-8c6f-47e4-8ae9-6d1d829e88b4","uuid":"6bfbc853-1658-4753-be1e-297a25057447","timestamp":"2026-06-11T06:02:24.500Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/handlers.ts","content":"// The three message-level derivation handlers (Flow 2): prompt smoothing,\n// tool-call summary, tool-result summary. One shape throughout — read the\n// source message (a tool-activity handler additionally joins its call-id\n// pair, nothing more: AC-2.5), call exactly one provider operation, hand the\n// form content back through HandlerOutcome. The drain's completion\n// transaction performs the version-checked UPDATE-only write (Story 1), so a\n// stale or deleted source discards here exactly as everywhere else. Outcomes\n// on tool-activity summaries come from outcome.ts — the record, never the\n// provider's text (AC-2.4) — and land in form metadata apart from content.\nimport type {\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  WorkHandler,\n} from \"../../../shared/derivation.js\";\nimport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\nimport { deriveToolOutcome } from \"./outcome.js\";\nimport {\n  findPairedToolCall,\n  findPairedToolResult,\n  readMessageSource,\n  type MessageSource,\n} from \"./forms.js\";\n\n// A handler that cannot read its source coherently has found source damage:\n// terminal, form blocked with the reason (never a retry loop against a\n// record that cannot improve). A *deleted* source never reaches this — its\n// form row is gone and the completion write would discard — so a miss here\n// is genuine corruption.\nfunction sourceDamaged(reason: string): HandlerOutcome {\n  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n}\n\nfunction loadSource(\n  run: HandlerRunContext,\n  item: { sourceRef: Record<string, string> },\n  expectedKind: string,\n):\n  | { ok: true; messageId: string; source: MessageSource }\n  | { ok: false; outcome: HandlerOutcome } {\n  const messageId = item.sourceRef[\"messageId\"];\n  if (messageId === undefined) {\n    return { ok: false, outcome: sourceDamaged(\"work item carries no messageId\") };\n  }\n  const source = readMessageSource(run.openDb(), messageId);\n  if (source === undefined) {\n    return { ok: false, outcome: sourceDamaged(`message ${messageId} not found`) };\n  }\n  if (source.kind !== expectedKind) {\n    return {\n      ok: false,\n      outcome: sourceDamaged(\n        `message ${messageId} is kind ${source.kind}, expected ${expectedKind}`,\n      ),\n    };\n  }\n  return { ok: true, messageId, source };\n}\n\nfunction landForm(\n  write: HandlerFormWrite,\n  result: { ok: true; text: string } | { ok: false; retryable: boolean; reason: string },\n): HandlerOutcome {\n  if (!result.ok) return { ok: false, retryable: result.retryable, reason: result.reason };\n  return { ok: true, forms: [{ ...write, content: result.text }] };\n}\n\nconst smoothPromptHandler: WorkHandler = async (run, item) => {\n  const loaded = loadSource(run, item, \"user_prompt\");\n  if (!loaded.ok) return loaded.outcome;\n  const text = loaded.source.blocks[0]?.content[\"text\"];\n  if (typeof text !== \"string\") {\n    return sourceDamaged(`prompt ${loaded.messageId} has no text block`);\n  }\n  return landForm(\n    {\n      subjectKind: \"message\",\n      subjectId: loaded.messageId,\n      form: \"smoothed_prompt\",\n      content: \"\",\n    },\n    await run.provider.smoothPrompt({ text }),\n  );\n};\n\nconst toolCallSummaryHandler: WorkHandler = async (run, item) => {\n  const loaded = loadSource(run, item, \"tool_call\");\n  if (!loaded.ok) return loaded.outcome;\n  const block = loaded.source.blocks[0]?.content ?? {};\n  const toolCallId = block[\"toolCallId\"];\n  const toolName = block[\"toolName\"];\n  if (typeof toolCallId !== \"string\" || typeof toolName !== \"string\") {\n    return sourceDamaged(`tool call ${loaded.messageId} has no tool_call block`);\n  }\n  // The handler's one reach beyond its message: the paired result by call id\n  // (AC-2.5). Outcome is stamped from that pairing mechanically — present and\n  // clean, present and isError, or absent — before the provider ever runs.\n  const paired = findPairedToolResult(run.openDb(), toolCallId);\n  const outcome = deriveToolOutcome(paired);\n  const input: Parameters<typeof run.provider.summarizeToolCall>[0] = {\n    toolName,\n    argsJson: JSON.stringify(block[\"arguments\"] ?? {}),\n  };\n  if (paired !== undefined) {\n    input.pairedResult = { content: paired.content, isError: paired.isError };\n  }\n  return landForm(\n    {\n      subjectKind: \"message\",\n      subjectId: loaded.messageId,\n      form: \"tool_call_summary\",\n      content: \"\",\n      metadata: { outcome },\n    },\n    await run.provider.summarizeToolCall(input),\n  );\n};\n\nconst toolResultSummaryHandler: WorkHandler = async (run, item) => {\n  const loaded = loadSource(run, item, \"tool_result\");\n  if (!loaded.ok) return loaded.outcome;\n  const block = loaded.source.blocks[0]?.content ?? {};\n  const content = block[\"content\"];\n  if (typeof content !== \"string\") {\n    return sourceDamaged(`tool result ${loaded.messageId} has no tool_result block`);\n  }\n  const toolCallId = block[\"toolCallId\"];\n  const pairedCall =\n    typeof toolCallId === \"string\"\n      ? findPairedToolCall(run.openDb(), toolCallId)\n      : undefined;\n  // The summary abbreviates; the full result content stays untouched in the\n  // record (AC-2.3) — nothing here writes back to message_block. The result\n  // is tool activity, so its outcome is stamped from its own isError flag.\n  return landForm(\n    {\n      subjectKind: \"message\",\n      subjectId: loaded.messageId,\n      form: \"tool_result_summary\",\n      content: \"\",\n      metadata: { outcome: deriveToolOutcome({ isError: block[\"isError\"] === true }) },\n    },\n    await run.provider.summarizeToolResult({\n      toolName: pairedCall?.toolName ?? \"unknown_tool\",\n      content,\n    }),\n  );\n};\n\n// The domain's handler table, merged into the SDK dispatch map at\n// construction (DD-6). Turn-owned kinds stay with the turns domain.\nexport const messageWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n  prompt_smoothing: smoothPromptHandler,\n  tool_call_summary: toolCallSummaryHandler,\n  tool_result_summary: toolResultSummaryHandler,\n};\n","numLines":157,"startLine":1,"totalLines":157}}}

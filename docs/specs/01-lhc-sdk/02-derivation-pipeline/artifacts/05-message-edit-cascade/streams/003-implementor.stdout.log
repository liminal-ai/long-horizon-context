terministicText,\n59\t  type DeterministicOpName,\n60\t} from \"./providers/deterministic.js\";\n61\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n62\t\n63\texport type {\n64\t  CompletionTx,\n65\t  DependencyGap,\n66\t  DerivationProvider,\n67\t  DerivedForm,\n68\t  DerivedFormMetadata,\n69\t  DerivedFormState,\n70\t  FormKind,\n71\t  FormReportEntry,\n72\t  HandlerFormWrite,\n73\t  HandlerOutcome,\n74\t  HandlerRunContext,\n75\t  ProviderResult,\n76\t  RenderingPart,\n77\t  ResolvedSdkConfig,\n78\t  SdkConfig,\n79\t  SubjectKind,\n80\t  ToolOutcome,\n81\t  ToolRunReceipt,\n82\t  WorkHandler,\n83\t} from \"./shared/derivation.js\";\n84\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n85\texport {\n86\t  countLiveItems,\n87\t  enqueue,\n88\t  queueDetail,\n89\t  supersedeQueued,\n90\t  type ClaimedWorkItem,\n91\t  type EnqueueFormTarget,\n92\t  type EnqueueInput,\n93\t  type QueueDetailRow,\n94\t} from \"./tech-utils/work-queue/index.js\";\n95\t\n96\texport type { ThreadRef } from \"./domains/threads/index.js\";\n97\texport type {\n98\t  Block,\n99\t  BlockType,\n100\t  MessageRecord,\n101\t} from \"./domains/messages/index.js\";\n102\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n103\texport type {\n104\t  BatchResult,\n105\t  EventKind,\n106\t  EventRecord,\n107\t  MessageEventInput,\n108\t} from \"./domains/intake-stream/index.js\";\n109\t\n110\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n111\t\n112\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n113\t\n114\t// Merge per-domain handler tables into the one join between the queue's\n115\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n116\t// (each kind has exactly one owner) and throws at construction.\n117\texport function assembleWorkHandlerMap(\n118\t  tables: ReadonlyArray<WorkHandlerMap>,\n119\t): WorkHandlerMap {\n120\t  const map: WorkHandlerMap = {};\n121\t  for (const table of tables) {\n122\t    for (const [kind, handler] of Object.entries(table)) {\n123\t      if (map[kind as WorkKind] !== undefined) {\n124\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n125\t      }\n126\t      map[kind as WorkKind] = handler;\n127\t    }\n128\t  }\n129\t  return map;\n130\t}\n131\t\n132\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n133\t  return {\n134\t    ok: false,\n135\t    error: {\n136\t      errorClass: \"state_corruption\",\n137\t      code: \"unknown_work_kind\",\n138\t      reason: `no handler registered for work kind \"${kind}\"`,\n139\t    },\n140\t  };\n141\t}\n142\t\n143\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n144\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n145\texport function lookupWorkHandler(\n146\t  map: WorkHandlerMap,\n147\t  kind: string,\n148\t): OpResult<WorkHandler> {\n149\t  const handler = map[kind as WorkKind];\n150\t  if (handler === undefined) return unknownWorkKind(kind);\n151\t  return { ok: true, value: handler };\n152\t}\n153\t\n154\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n155\t// requeue land in Story 4.\n156\texport interface WorkSurface {\n157\t  drain(\n158\t    ref: threadsDomain.ThreadRef,\n159\t    opts?: { maxItems?: number },\n160\t  ): Promise<OpResult<DrainReport>>;\n161\t}\n162\t\n163\texport interface Lhc {\n164\t  threads: typeof threadsDomain;\n165\t  intakeStream: typeof intakeStreamDomain;\n166\t  messages: typeof messagesDomain;\n167\t  turns: typeof turnsDomain;\n168\t  config: ResolvedSdkConfig;\n169\t  scheduler: Scheduler;\n170\t  workHandlers: WorkHandlerMap;\n171\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n172\t  work: WorkSurface;\n173\t  // Resolves when the scheduler has no running or pending drain for the\n174\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n175\t  // resolve in manual mode.\n176\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n177\t}\n178\t\n179\tfunction requirePositive(value: number, name: string): void {\n180\t  if (!Number.isFinite(value) || value <= 0) {\n181\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n182\t  }\n183\t}\n184\t\n185\tfunction requireNonNegative(value: number, name: string): void {\n186\t  if (!Number.isFinite(value) || value < 0) {\n187\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n188\t  }\n189\t}\n190\t\n191\t// The only assembly path: provider, mode, clock, and policy enter here.\n192\t// Config mistakes are programmer errors at construction and throw; operating\n193\t// failures after construction return OpResults per the error contract.\n194\texport function createSdk(config: SdkConfig): Lhc {\n195\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n196\t    throw new TypeError(\n197\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n198\t    );\n199\t  }\n200\t  if (config.provider === null || typeof config.provider !== \"object\") {\n201\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n202\t  }\n203\t  for (const operation of PROVIDER_OPERATIONS) {\n204\t    if (typeof config.provider[operation] !== \"function\") {\n205\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n206\t    }\n207\t  }\n208\t\n209\t  const resolved: ResolvedSdkConfig = {\n210\t    provider: config.provider,\n211\t    mode: config.mode,\n212\t    clock: config.clock ?? (() => new Date()),\n213\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n214\t    lease: config.lease ?? { durationMs: 120000 },\n215\t    chunkPolicy:\n216\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n217\t  };\n218\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n219\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n220\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n221\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n222\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n223\t  }\n224\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n225\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n226\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n227\t    throw new TypeError(\n228\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n229\t    );\n230\t  }\n231\t\n232\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n233\t  // The tables are empty until Stories 2–3 land the real handlers; the\n234\t  // assembly mechanics are production code from day one.\n235\t  const workHandlers = assembleWorkHandlerMap([\n236\t    messagesDomain.workHandlers,\n237\t    turnsDomain.workHandlers,\n238\t  ]);\n239\t\n240\t  const drainDeps: DrainDeps = {\n241\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n242\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n243\t    config: resolved,\n244\t  };\n245\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n246\t\n247\t  // Background mode wires the scheduler into the process-wide seams: enqueue\n248\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n249\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n250\t  // constructing a later background SDK supersedes an earlier one (the\n251\t  // displaced scheduler's in-memory state was advisory — the rows remain).\n252\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n253\t  if (resolved.mode === \"background\") {\n254\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n255\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n256\t  }\n257\t\n258\t  const work: WorkSurface = {\n259\t    drain: async (ref, opts) => {\n260\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n261\t      if (!resolvedRef.ok) return resolvedRef;\n262\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n263\t    },\n264\t  };\n265\t\n266\t  return {\n267\t    threads: threadsDomain,\n268\t    intakeStream: intakeStreamDomain,\n269\t    messages: messagesDomain,\n270\t    turns: turnsDomain,\n271\t    config: resolved,\n272\t    scheduler,\n273\t    workHandlers,\n274\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n275\t    work,\n276\t    drainSettled: async (ref) => {\n277\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n278\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n279\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n280\t      if (threadId === null) return;\n281\t      return scheduler.drainSettled(threadId);\n282\t    },\n283\t  };\n284\t}\n285\t"}]},"parent_tool_use_id":null,"session_id":"11cfbce6-8c6f-47e4-8ae9-6d1d829e88b4","uuid":"13da2084-cefd-4c3b-aabb-cbab0d734618","timestamp":"2026-06-11T05:58:29.669Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageRecord,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // Background mode wires the scheduler into the process-wide seams: enqueue\n  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n  // constructing a later background SDK supersedes an earlier one (the\n  // displaced scheduler's in-memory state was advisory — the rows remain).\n  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: async (ref, opts) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return resolvedRef;\n      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n    },\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: intakeStreamDomain,\n    messages: messagesDomain,\n    turns: turnsDomain,\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":285,"startLine":1,"totalLines":285}}}

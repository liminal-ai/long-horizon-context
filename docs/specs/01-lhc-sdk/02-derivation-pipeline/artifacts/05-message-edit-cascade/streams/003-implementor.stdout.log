{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GrTpzd7km5HwSsqvAPo69g","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\timport {\n11\t  runMessagesReport,\n12\t  runMessagesRequeue,\n13\t  runTurnsReport,\n14\t  runTurnsRequeue,\n15\t  runWorkDrain,\n16\t} from \"./work.js\";\n17\t\n18\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n19\t// process stdin. null means interactive (TTY) — distinct from empty input\n20\t// only in how it arises; both are refused with empty_stdin before any SDK\n21\t// call (the SDK itself can never return that code).\n22\texport type StdinReader = () => Promise<string | null>;\n23\t\n24\tasync function readProcessStdin(): Promise<string | null> {\n25\t  if (process.stdin.isTTY) return null;\n26\t  process.stdin.setEncoding(\"utf8\");\n27\t  let data = \"\";\n28\t  for await (const chunk of process.stdin) data += String(chunk);\n29\t  return data;\n30\t}\n31\t\n32\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n33\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n34\t}\n35\t\n36\tconst HELP = `lhc — Long Horizon Context CLI\n37\t\n38\tUsage:\n39\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n40\t  lhc threads resolve --thread-id <id> [--registry <r>]\n41\t  lhc threads list [--registry <r>]\n42\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n43\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n44\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n45\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n46\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n47\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n48\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n49\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n50\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n51\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n52\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n53\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n54\t\n55\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n56\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n57\t`;\n58\t\n59\tinterface ParsedFlags {\n60\t  threadId?: string;\n61\t  filePath?: string;\n62\t  title?: string;\n63\t  registryPath?: string;\n64\t  maxItems?: string;\n65\t  provider?: string;\n66\t  notReady?: boolean;\n67\t  messageId?: string;\n68\t  turnId?: string;\n69\t  chunkId?: string;\n70\t  form?: string;\n71\t  subjectKind?: string;\n72\t  subjectId?: string;\n73\t}\n74\t\n75\t// strict parse rejects unknown/misspelled flags so they are named back to the\n76\t// caller, never silently dropped — the CLI boundary matching the SDK's\n77\t// closed-contract strictness. The failure is returned as data (not thrown) so\n78\t// runCli can render it as the structured usage error.\n79\ttype ParseFlagsResult =\n80\t  | { ok: true; flags: ParsedFlags }\n81\t  | { ok: false; unknownFlag: string };\n82\t\n83\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n84\t  let values;\n85\t  try {\n86\t    ({ values } = parseArgs({\n87\t      args: [...args],\n88\t      options: {\n89\t        \"thread-id\": { type: \"string\" },\n90\t        \"file-path\": { type: \"string\" },\n91\t        title: { type: \"string\" },\n92\t        registry: { type: \"string\" },\n93\t        \"max-items\": { type: \"string\" },\n94\t        provider: { type: \"string\" },\n95\t        \"not-ready\": { type: \"boolean\" },\n96\t        \"message-id\": { type: \"string\" },\n97\t        \"turn-id\": { type: \"string\" },\n98\t        \"chunk-id\": { type: \"string\" },\n99\t        form: { type: \"string\" },\n100\t        \"subject-kind\": { type: \"string\" },\n101\t        \"subject-id\": { type: \"string\" },\n102\t      },\n103\t      strict: true,\n104\t      allowPositionals: true,\n105\t    }));\n106\t  } catch (cause) {\n107\t    const message = cause instanceof Error ? cause.message : String(cause);\n108\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n109\t    // option '--file-pth'); surface that token, falling back to the message.\n110\t    const named = /'([^']+)'/.exec(message);\n111\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n112\t  }\n113\t  const flags: ParsedFlags = {};\n114\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n115\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n116\t  if (typeof values.title === \"string\") flags.title = values.title;\n117\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n118\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n119\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n120\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n121\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n122\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n123\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n124\t  if (typeof values.form === \"string\") flags.form = values.form;\n125\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n126\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n127\t  return { ok: true, flags };\n128\t}\n129\t\n130\t// The read commands take a thread reference but no stdin; a missing reference\n131\t// is a usage error named before any SDK call, matching the intake commands.\n132\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n133\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n134\t    return renderCliError(\n135\t      \"caller_error\",\n136\t      \"missing_flag\",\n137\t      `${command} requires --thread-id or --file-path`,\n138\t    );\n139\t  }\n140\t  return undefined;\n141\t}\n142\t\n143\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n144\t  if (flags.threadId !== undefined) {\n145\t    return flags.registryPath !== undefined\n146\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n147\t      : { threadId: flags.threadId };\n148\t  }\n149\t  return { filePath: flags.filePath ?? \"\" };\n150\t}\n151\t\n152\texport async function runCli(\n153\t  argv: readonly string[],\n154\t  readStdin: StdinReader = readProcessStdin,\n155\t): Promise<CliResult> {\n156\t  if (argv.length === 0) {\n157\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n158\t  }\n159\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n160\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n161\t  }\n162\t\n163\t  const [group, command, ...rest] = argv;\n164\t  const key = command === undefined ? group : `${group} ${command}`;\n165\t  const parsed = parseFlags(command === undefined ? [] : rest);\n166\t  if (!parsed.ok) {\n167\t    return renderCliError(\n168\t      \"caller_error\",\n169\t      \"unknown_flag\",\n170\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n171\t    );\n172\t  }\n173\t  const flags = parsed.flags;\n174\t\n175\t  switch (key) {\n176\t    case \"threads new-thread\": {\n177\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n178\t      // instead of failing, so the adapter refuses before any SDK call.\n179\t      if (flags.filePath === undefined) {\n180\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n181\t      }\n182\t      const input: Parameters<typeof threads.newThread>[0] = {\n183\t        filePath: flags.filePath,\n184\t      };\n185\t      if (flags.title !== undefined) input.title = flags.title;\n186\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n187\t      return renderResult(await threads.newThread(input));\n188\t    }\n189\t    case \"threads resolve\": {\n190\t      if (flags.threadId === undefined) {\n191\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n192\t      }\n193\t      const input: Parameters<typeof threads.resolve>[0] = {\n194\t        threadId: flags.threadId,\n195\t      };\n196\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n197\t      return renderResult(await threads.resolve(input));\n198\t    }\n199\t    case \"threads list\": {\n200\t      return renderResult(\n201\t        await threads.listThreads(\n202\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n203\t        ),\n204\t      );\n205\t    }\n206\t    case \"intake-stream message-events\": {\n207\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n208\t        return renderCliError(\n209\t          \"caller_error\",\n210\t          \"missing_flag\",\n211\t          \"intake-stream message-events requires --thread-id or --file-path\",\n212\t        );\n213\t      }\n214\t      const text = await readStdin();\n215\t      if (text === null || text.trim() === \"\") {\n216\t        return renderResult(\n217\t          stdinCallerError(\n218\t            \"empty_stdin\",\n219\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n220\t          ),\n221\t        );\n222\t      }\n223\t      let parsed: unknown;\n224\t      try {\n225\t        parsed = JSON.parse(text);\n226\t      } catch (cause) {\n227\t        const detail = cause instanceof Error ? cause.message : String(cause);\n228\t        return renderResult(\n229\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n230\t        );\n231\t      }\n232\t      if (!Array.isArray(parsed)) {\n233\t        return renderResult(\n234\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n235\t        );\n236\t      }\n237\t      return renderResult(\n238\t        await intakeStream.messageEvents(\n239\t          threadRefFrom(flags),\n240\t          parsed as readonly MessageEventInput[],\n241\t        ),\n242\t      );\n243\t    }\n244\t    case \"intake-stream list-events\": {\n245\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n246\t        return renderCliError(\n247\t          \"caller_error\",\n248\t          \"missing_flag\",\n249\t          \"intake-stream list-events requires --thread-id or --file-path\",\n250\t        );\n251\t      }\n252\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n253\t    }\n254\t    case \"messages list\":\n255\t      return (\n256\t        requireThreadRef(flags, \"messages list\") ??\n257\t        renderResult(await messages.listMessages(threadRefFrom(flags)))\n258\t      );\n259\t    case \"messages list-queued-work\":\n260\t      return (\n261\t        requireThreadRef(flags, \"messages list-queued-work\") ??\n262\t        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n263\t      );\n264\t    case \"messages report\": {\n265\t      const missingRef = requireThreadRef(flags, \"messages report\");\n266\t      if (missingRef !== undefined) return missingRef;\n267\t      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n268\t      if (flags.notReady === true) reportFlags.notReady = true;\n269\t      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n270\t      return runMessagesReport(threadRefFrom(flags), reportFlags);\n271\t    }\n272\t    case \"messages requeue\": {\n273\t      const missingRef = requireThreadRef(flags, \"messages requeue\");\n274\t      if (missingRef !== undefined) return missingRef;\n275\t      if (flags.messageId === undefined || flags.form === undefined) {\n276\t        return renderCliError(\n277\t          \"caller_error\",\n278\t          \"missing_flag\",\n279\t          \"messages requeue requires --message-id and --form\",\n280\t        );\n281\t      }\n282\t      return runMessagesRequeue(threadRefFrom(flags), {\n283\t        messageId: flags.messageId,\n284\t        form: flags.form,\n285\t      });\n286\t    }\n287\t    case \"turns list\":\n288\t      return (\n289\t        requireThreadRef(flags, \"turns list\") ??\n290\t        renderResult(await turns.listTurns(threadRefFrom(flags)))\n291\t      );\n292\t    case \"turns list-chunks\":\n293\t      return (\n294\t        requireThreadRef(flags, \"turns list-chunks\") ??\n295\t        renderResult(await turns.listChunks(threadRefFrom(flags)))\n296\t      );\n297\t    case \"turns list-queued-work\":\n298\t      return (\n299\t        requireThreadRef(flags, \"turns list-queued-work\") ??\n300\t        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n301\t      );\n302\t    case \"turns report\": {\n303\t      const missingRef = requireThreadRef(flags, \"turns report\");\n304\t      if (missingRef !== undefined) return missingRef;\n305\t      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n306\t      if (flags.notReady === true) reportFlags.notReady = true;\n307\t      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n308\t      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n309\t      return runTurnsReport(threadRefFrom(flags), reportFlags);\n310\t    }\n311\t    case \"turns requeue\": {\n312\t      const missingRef = requireThreadRef(flags, \"turns requeue\");\n313\t      if (missingRef !== undefined) return missingRef;\n314\t      if (\n315\t        flags.subjectKind === undefined ||\n316\t        flags.subjectId === undefined ||\n317\t        flags.form === undefined\n318\t      ) {\n319\t        return renderCliError(\n320\t          \"caller_error\",\n321\t          \"missing_flag\",\n322\t          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n323\t        );\n324\t      }\n325\t      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n326\t        return renderCliError(\n327\t          \"caller_error\",\n328\t          \"missing_flag\",\n329\t          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n330\t        );\n331\t      }\n332\t      return runTurnsRequeue(threadRefFrom(flags), {\n333\t        subjectKind: flags.subjectKind,\n334\t        subjectId: flags.subjectId,\n335\t        form: flags.form,\n336\t      });\n337\t    }\n338\t    case \"work drain\": {\n339\t      const missingRef = requireThreadRef(flags, \"work drain\");\n340\t      if (missingRef !== undefined) return missingRef;\n341\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n342\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n343\t      if (flags.maxItems !== undefined) {\n344\t        const maxItems = Number(flags.maxItems);\n345\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n346\t          return renderCliError(\n347\t            \"caller_error\",\n348\t            \"missing_flag\",\n349\t            `--max-items must be a positive integer, got ${flags.maxItems}`,\n350\t          );\n351\t        }\n352\t        drainFlags.maxItems = maxItems;\n353\t      }\n354\t      return runWorkDrain(threadRefFrom(flags), drainFlags);\n355\t    }\n356\t    default:\n357\t      return renderCliError(\n358\t        \"caller_error\",\n359\t        \"unknown_command\",\n360\t        `unknown command: ${key}; run lhc --help`,\n361\t      );\n362\t  }\n363\t}\n364\t"}]},"parent_tool_use_id":null,"session_id":"11cfbce6-8c6f-47e4-8ae9-6d1d829e88b4","uuid":"d3e1b909-bac0-4b42-a5e4-352edc77c6f4","timestamp":"2026-06-11T05:58:29.906Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/index.ts","content":"import { parseArgs } from \"node:util\";\nimport * as intakeStream from \"../domains/intake-stream/index.js\";\nimport * as messages from \"../domains/messages/index.js\";\nimport * as threads from \"../domains/threads/index.js\";\nimport * as turns from \"../domains/turns/index.js\";\nimport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\nimport type { ThreadRef } from \"../domains/threads/index.js\";\nimport type { OpResult } from \"../shared/errors.js\";\nimport { renderCliError, renderResult, type CliResult } from \"./render.js\";\nimport {\n  runMessagesReport,\n  runMessagesRequeue,\n  runTurnsReport,\n  runTurnsRequeue,\n  runWorkDrain,\n} from \"./work.js\";\n\n// Stdin seam: in-process tests inject a reader; the binary reads the real\n// process stdin. null means interactive (TTY) — distinct from empty input\n// only in how it arises; both are refused with empty_stdin before any SDK\n// call (the SDK itself can never return that code).\nexport type StdinReader = () => Promise<string | null>;\n\nasync function readProcessStdin(): Promise<string | null> {\n  if (process.stdin.isTTY) return null;\n  process.stdin.setEncoding(\"utf8\");\n  let data = \"\";\n  for await (const chunk of process.stdin) data += String(chunk);\n  return data;\n}\n\nfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst HELP = `lhc — Long Horizon Context CLI\n\nUsage:\n  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n  lhc threads resolve --thread-id <id> [--registry <r>]\n  lhc threads list [--registry <r>]\n  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n\nEvery command prints the SDK result (value or error) as JSON and exits 0 on\nsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n`;\n\ninterface ParsedFlags {\n  threadId?: string;\n  filePath?: string;\n  title?: string;\n  registryPath?: string;\n  maxItems?: string;\n  provider?: string;\n  notReady?: boolean;\n  messageId?: string;\n  turnId?: string;\n  chunkId?: string;\n  form?: string;\n  subjectKind?: string;\n  subjectId?: string;\n}\n\n// strict parse rejects unknown/misspelled flags so they are named back to the\n// caller, never silently dropped — the CLI boundary matching the SDK's\n// closed-contract strictness. The failure is returned as data (not thrown) so\n// runCli can render it as the structured usage error.\ntype ParseFlagsResult =\n  | { ok: true; flags: ParsedFlags }\n  | { ok: false; unknownFlag: string };\n\nfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n  let values;\n  try {\n    ({ values } = parseArgs({\n      args: [...args],\n      options: {\n        \"thread-id\": { type: \"string\" },\n        \"file-path\": { type: \"string\" },\n        title: { type: \"string\" },\n        registry: { type: \"string\" },\n        \"max-items\": { type: \"string\" },\n        provider: { type: \"string\" },\n        \"not-ready\": { type: \"boolean\" },\n        \"message-id\": { type: \"string\" },\n        \"turn-id\": { type: \"string\" },\n        \"chunk-id\": { type: \"string\" },\n        form: { type: \"string\" },\n        \"subject-kind\": { type: \"string\" },\n        \"subject-id\": { type: \"string\" },\n      },\n      strict: true,\n      allowPositionals: true,\n    }));\n  } catch (cause) {\n    const message = cause instanceof Error ? cause.message : String(cause);\n    // parseArgs names the offending option in single quotes (e.g. Unknown\n    // option '--file-pth'); surface that token, falling back to the message.\n    const named = /'([^']+)'/.exec(message);\n    return { ok: false, unknownFlag: named?.[1] ?? message };\n  }\n  const flags: ParsedFlags = {};\n  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n  if (typeof values.title === \"string\") flags.title = values.title;\n  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n  if (typeof values.provider === \"string\") flags.provider = values.provider;\n  if (values[\"not-ready\"] === true) flags.notReady = true;\n  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n  if (typeof values.form === \"string\") flags.form = values.form;\n  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n  return { ok: true, flags };\n}\n\n// The read commands take a thread reference but no stdin; a missing reference\n// is a usage error named before any SDK call, matching the intake commands.\nfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n  if (flags.threadId === undefined && flags.filePath === undefined) {\n    return renderCliError(\n      \"caller_error\",\n      \"missing_flag\",\n      `${command} requires --thread-id or --file-path`,\n    );\n  }\n  return undefined;\n}\n\nfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n  if (flags.threadId !== undefined) {\n    return flags.registryPath !== undefined\n      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n      : { threadId: flags.threadId };\n  }\n  return { filePath: flags.filePath ?? \"\" };\n}\n\nexport async function runCli(\n  argv: readonly string[],\n  readStdin: StdinReader = readProcessStdin,\n): Promise<CliResult> {\n  if (argv.length === 0) {\n    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n  }\n  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n  }\n\n  const [group, command, ...rest] = argv;\n  const key = command === undefined ? group : `${group} ${command}`;\n  const parsed = parseFlags(command === undefined ? [] : rest);\n  if (!parsed.ok) {\n    return renderCliError(\n      \"caller_error\",\n      \"unknown_flag\",\n      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n    );\n  }\n  const flags = parsed.flags;\n\n  switch (key) {\n    case \"threads new-thread\": {\n      // Guard here: an empty path reaching node:sqlite opens a temp database\n      // instead of failing, so the adapter refuses before any SDK call.\n      if (flags.filePath === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n      }\n      const input: Parameters<typeof threads.newThread>[0] = {\n        filePath: flags.filePath,\n      };\n      if (flags.title !== undefined) input.title = flags.title;\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.newThread(input));\n    }\n    case \"threads resolve\": {\n      if (flags.threadId === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n      }\n      const input: Parameters<typeof threads.resolve>[0] = {\n        threadId: flags.threadId,\n      };\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.resolve(input));\n    }\n    case \"threads list\": {\n      return renderResult(\n        await threads.listThreads(\n          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n        ),\n      );\n    }\n    case \"intake-stream message-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream message-events requires --thread-id or --file-path\",\n        );\n      }\n      const text = await readStdin();\n      if (text === null || text.trim() === \"\") {\n        return renderResult(\n          stdinCallerError(\n            \"empty_stdin\",\n            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n          ),\n        );\n      }\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(text);\n      } catch (cause) {\n        const detail = cause instanceof Error ? cause.message : String(cause);\n        return renderResult(\n          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n        );\n      }\n      if (!Array.isArray(parsed)) {\n        return renderResult(\n          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n        );\n      }\n      return renderResult(\n        await intakeStream.messageEvents(\n          threadRefFrom(flags),\n          parsed as readonly MessageEventInput[],\n        ),\n      );\n    }\n    case \"intake-stream list-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream list-events requires --thread-id or --file-path\",\n        );\n      }\n      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n    }\n    case \"messages list\":\n      return (\n        requireThreadRef(flags, \"messages list\") ??\n        renderResult(await messages.listMessages(threadRefFrom(flags)))\n      );\n    case \"messages list-queued-work\":\n      return (\n        requireThreadRef(flags, \"messages list-queued-work\") ??\n        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"messages report\": {\n      const missingRef = requireThreadRef(flags, \"messages report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n      return runMessagesReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"messages requeue\": {\n      const missingRef = requireThreadRef(flags, \"messages requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined || flags.form === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages requeue requires --message-id and --form\",\n        );\n      }\n      return runMessagesRequeue(threadRefFrom(flags), {\n        messageId: flags.messageId,\n        form: flags.form,\n      });\n    }\n    case \"turns list\":\n      return (\n        requireThreadRef(flags, \"turns list\") ??\n        renderResult(await turns.listTurns(threadRefFrom(flags)))\n      );\n    case \"turns list-chunks\":\n      return (\n        requireThreadRef(flags, \"turns list-chunks\") ??\n        renderResult(await turns.listChunks(threadRefFrom(flags)))\n      );\n    case \"turns list-queued-work\":\n      return (\n        requireThreadRef(flags, \"turns list-queued-work\") ??\n        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"turns report\": {\n      const missingRef = requireThreadRef(flags, \"turns report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n      return runTurnsReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"turns requeue\": {\n      const missingRef = requireThreadRef(flags, \"turns requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (\n        flags.subjectKind === undefined ||\n        flags.subjectId === undefined ||\n        flags.form === undefined\n      ) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n        );\n      }\n      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n        );\n      }\n      return runTurnsRequeue(threadRefFrom(flags), {\n        subjectKind: flags.subjectKind,\n        subjectId: flags.subjectId,\n        form: flags.form,\n      });\n    }\n    case \"work drain\": {\n      const missingRef = requireThreadRef(flags, \"work drain\");\n      if (missingRef !== undefined) return missingRef;\n      const drainFlags: { provider?: string; maxItems?: number } = {};\n      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n      if (flags.maxItems !== undefined) {\n        const maxItems = Number(flags.maxItems);\n        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n          return renderCliError(\n            \"caller_error\",\n            \"missing_flag\",\n            `--max-items must be a positive integer, got ${flags.maxItems}`,\n          );\n        }\n        drainFlags.maxItems = maxItems;\n      }\n      return runWorkDrain(threadRefFrom(flags), drainFlags);\n    }\n    default:\n      return renderCliError(\n        \"caller_error\",\n        \"unknown_command\",\n        `unknown command: ${key}; run lhc --help`,\n      );\n  }\n}\n","numLines":364,"startLine":1,"totalLines":364}}}

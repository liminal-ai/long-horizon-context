{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CsD1s1ksqSixTGmmhqJDX4","type":"tool_result","content":"1\t// Turn row operations. Writes run on the caller's handle inside the batch\n2\t// transaction; reads run on a fresh handle per operation. A closed turn has\n3\t// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n4\t// any UPDATE that touches a closed row.\n5\timport type { DatabaseSync } from \"node:sqlite\";\n6\timport type { TurnRecord } from \"../index.js\";\n7\timport { readPlacements } from \"./chunks.js\";\n8\t\n9\texport function selectOpenTurnIds(db: DatabaseSync): string[] {\n10\t  const rows = db\n11\t    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n12\t    .all() as unknown as Array<{ turn_id: string }>;\n13\t  return rows.map((row) => row.turn_id);\n14\t}\n15\t\n16\texport function nextTurnOrder(db: DatabaseSync): number {\n17\t  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n18\t    | { max_order: number | bigint | null }\n19\t    | undefined;\n20\t  return Number(row?.max_order ?? 0) + 1;\n21\t}\n22\t\n23\texport function insertOpenTurn(\n24\t  db: DatabaseSync,\n25\t  turnOrder: number,\n26\t  openedAtEventOrder: number,\n27\t): string {\n28\t  const turnId = `t${turnOrder}`;\n29\t  db.prepare(\n30\t    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n31\t     VALUES (?, ?, 'open', ?)`,\n32\t  ).run(turnId, turnOrder, openedAtEventOrder);\n33\t  return turnId;\n34\t}\n35\t\n36\texport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n37\t  db.prepare(\n38\t    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n39\t  ).run(closedAtEventOrder, turnId);\n40\t}\n41\t\n42\tinterface RawTurnRow {\n43\t  turn_id: string;\n44\t  status: string;\n45\t  opened_at_event_order: number | bigint;\n46\t  closed_at_event_order: number | bigint | null;\n47\t}\n48\t\n49\t// Membership is stored on the member (message.turn_id), never as a list on\n50\t// the turn: memberMessageIds is a query, ordered by event order, so there is\n51\t// exactly one source of truth.\n52\texport function readTurns(db: DatabaseSync): TurnRecord[] {\n53\t  const memberRows = db\n54\t    .prepare(\n55\t      `SELECT message_id, turn_id FROM message\n56\t       WHERE turn_id IS NOT NULL ORDER BY source_event_order`,\n57\t    )\n58\t    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n59\t  const membersByTurn = new Map<string, string[]>();\n60\t  for (const row of memberRows) {\n61\t    const members = membersByTurn.get(row.turn_id) ?? [];\n62\t    members.push(row.message_id);\n63\t    membersByTurn.set(row.turn_id, members);\n64\t  }\n65\t\n66\t  const turnRows = db\n67\t    .prepare(\n68\t      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n69\t       FROM turns ORDER BY turn_order`,\n70\t    )\n71\t    .all() as unknown as RawTurnRow[];\n72\t  // Chunk placement rides the turn read-back (Epic 02 AC-3.5): stored\n73\t  // chunk_member values, absent until the turn's derivation placed it.\n74\t  const placements = readPlacements(db);\n75\t  return turnRows.map((row) => {\n76\t    const record: TurnRecord = {\n77\t      turnId: row.turn_id,\n78\t      status: row.status as TurnRecord[\"status\"],\n79\t      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n80\t      openedAtEventOrder: Number(row.opened_at_event_order),\n81\t    };\n82\t    if (row.closed_at_event_order !== null) {\n83\t      record.closedAtEventOrder = Number(row.closed_at_event_order);\n84\t    }\n85\t    const placement = placements.get(row.turn_id);\n86\t    if (placement !== undefined) {\n87\t      record.chunkId = placement.chunkId;\n88\t      record.memberIdx = placement.memberIdx;\n89\t    }\n90\t    return record;\n91\t  });\n92\t}\n93\t"}]},"parent_tool_use_id":null,"session_id":"11cfbce6-8c6f-47e4-8ae9-6d1d829e88b4","uuid":"539afa1b-f562-4d8a-8bda-fd37a4b1a607","timestamp":"2026-06-11T05:58:19.864Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/store.ts","content":"// Turn row operations. Writes run on the caller's handle inside the batch\n// transaction; reads run on a fresh handle per operation. A closed turn has\n// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n// any UPDATE that touches a closed row.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { TurnRecord } from \"../index.js\";\nimport { readPlacements } from \"./chunks.js\";\n\nexport function selectOpenTurnIds(db: DatabaseSync): string[] {\n  const rows = db\n    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n    .all() as unknown as Array<{ turn_id: string }>;\n  return rows.map((row) => row.turn_id);\n}\n\nexport function nextTurnOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0) + 1;\n}\n\nexport function insertOpenTurn(\n  db: DatabaseSync,\n  turnOrder: number,\n  openedAtEventOrder: number,\n): string {\n  const turnId = `t${turnOrder}`;\n  db.prepare(\n    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n     VALUES (?, ?, 'open', ?)`,\n  ).run(turnId, turnOrder, openedAtEventOrder);\n  return turnId;\n}\n\nexport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n  db.prepare(\n    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n  ).run(closedAtEventOrder, turnId);\n}\n\ninterface RawTurnRow {\n  turn_id: string;\n  status: string;\n  opened_at_event_order: number | bigint;\n  closed_at_event_order: number | bigint | null;\n}\n\n// Membership is stored on the member (message.turn_id), never as a list on\n// the turn: memberMessageIds is a query, ordered by event order, so there is\n// exactly one source of truth.\nexport function readTurns(db: DatabaseSync): TurnRecord[] {\n  const memberRows = db\n    .prepare(\n      `SELECT message_id, turn_id FROM message\n       WHERE turn_id IS NOT NULL ORDER BY source_event_order`,\n    )\n    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n  const membersByTurn = new Map<string, string[]>();\n  for (const row of memberRows) {\n    const members = membersByTurn.get(row.turn_id) ?? [];\n    members.push(row.message_id);\n    membersByTurn.set(row.turn_id, members);\n  }\n\n  const turnRows = db\n    .prepare(\n      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n       FROM turns ORDER BY turn_order`,\n    )\n    .all() as unknown as RawTurnRow[];\n  // Chunk placement rides the turn read-back (Epic 02 AC-3.5): stored\n  // chunk_member values, absent until the turn's derivation placed it.\n  const placements = readPlacements(db);\n  return turnRows.map((row) => {\n    const record: TurnRecord = {\n      turnId: row.turn_id,\n      status: row.status as TurnRecord[\"status\"],\n      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n      openedAtEventOrder: Number(row.opened_at_event_order),\n    };\n    if (row.closed_at_event_order !== null) {\n      record.closedAtEventOrder = Number(row.closed_at_event_order);\n    }\n    const placement = placements.get(row.turn_id);\n    if (placement !== undefined) {\n      record.chunkId = placement.chunkId;\n      record.memberIdx = placement.memberIdx;\n    }\n    return record;\n  });\n}\n","numLines":93,"startLine":1,"totalLines":93}}}

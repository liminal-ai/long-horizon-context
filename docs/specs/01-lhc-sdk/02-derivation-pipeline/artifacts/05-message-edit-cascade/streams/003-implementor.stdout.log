{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017oJLH31H2GKAQ3KtgMGXxA","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n3\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n5\timport {\n6\t  enqueue,\n7\t  hasLiveItem,\n8\t  listItems,\n9\t  type WorkItemRecord,\n10\t  type WorkKind,\n11\t} from \"../../tech-utils/work-queue/index.js\";\n12\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n13\timport {\n14\t  openThreadDatabase,\n15\t  resolveThreadRef,\n16\t  type ThreadRef,\n17\t} from \"../threads/index.js\";\n18\timport type { DerivedForm } from \"../../shared/derivation.js\";\n19\timport {\n20\t  findUnknownOutcomeCallSummary,\n21\t  readMessageFormRow,\n22\t  readMessageForms,\n23\t  reportMessageForms,\n24\t} from \"./internal/forms.js\";\n25\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n26\timport { projectEvent } from \"./internal/project.js\";\n27\timport { insertMessage, readMessages } from \"./internal/store.js\";\n28\t\n29\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n30\t\n31\texport interface Block {\n32\t  blockType: BlockType;\n33\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n34\t}\n35\t\n36\texport interface MessageRecord {\n37\t  messageId: string;\n38\t  sourceEventOrder: number;\n39\t  kind: Exclude<EventKind, \"turn_end\">;\n40\t  blocks: Block[];\n41\t  tokenEstimate: number;\n42\t  actor: string;\n43\t  harness: string;\n44\t  turnId?: string;\n45\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n46\t  // for messages that are derivation sources — kinds with no derivable form\n47\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n48\t  // never re-derived on read.\n49\t  forms?: DerivedForm[];\n50\t}\n51\t\n52\t// The event as the walk holds it after recording: the validated input plus\n53\t// its server-stamped order and timestamp.\n54\texport type RecordedEvent = EventRecord;\n55\t\n56\texport type MessageCreated = {\n57\t  messageId: string;\n58\t  kind: Exclude<EventKind, \"turn_end\">;\n59\t  // Carried for tool activity only: the pairing key the queue sites need —\n60\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n61\t  toolCallId?: string;\n62\t} | null;\n63\t\n64\t// Cross-domain surface, called by intake-stream inside the batch transaction\n65\t// (the first such call through the operation context; turns.applyEvent\n66\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n67\t// projection failure propagates to the pipeline's catch and rejects the\n68\t// whole batch — recorded events without messages is the stranded state the\n69\t// transaction exists to prevent. Returns null for turn_end (no message).\n70\t// turnId is the membership stamp, settled by the pipeline before this call:\n71\t// the turn open *after* this event's transition (so a prompt belongs to the\n72\t// turn it just opened), or null in a gap — written once, never updated.\n73\texport function createFromEvent(\n74\t  ctx: OperationContext,\n75\t  event: RecordedEvent,\n76\t  turnId: string | null,\n77\t): MessageCreated {\n78\t  const projected = projectEvent(event);\n79\t  if (projected === null) return null;\n80\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n81\t  const messageId = `m${event.eventOrder}`;\n82\t  insertMessage(ctx.db, {\n83\t    messageId,\n84\t    sourceEventOrder: event.eventOrder,\n85\t    kind,\n86\t    tokenEstimate: projected.tokenEstimate,\n87\t    actor: event.actor,\n88\t    harness: event.harness,\n89\t    turnId,\n90\t    blocks: projected.blocks,\n91\t  });\n92\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n93\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n94\t  }\n95\t  return { messageId, kind };\n96\t}\n97\t\n98\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n99\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n100\t// tool result queues tool_result_summary, nothing else queues anything —\n101\t// text, thinking, and note messages are not derivation sources (Epic 01\n102\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n103\t// intake-stream inside the batch transaction for every recorded message, so\n104\t// the item commits (or rolls back) with the batch.\n105\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n106\t  user_prompt: \"prompt_smoothing\",\n107\t  tool_call: \"tool_call_summary\",\n108\t  tool_result: \"tool_result_summary\",\n109\t};\n110\t\n111\t// Which derived form each message-owned kind produces — the owning domain's\n112\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n113\t// rides the same transaction (DD-5).\n114\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n115\t  prompt_smoothing: \"smoothed_prompt\",\n116\t  tool_call_summary: \"tool_call_summary\",\n117\t  tool_result_summary: \"tool_result_summary\",\n118\t};\n119\t\n120\t// Message-owned work handlers, merged into the SDK's dispatch map at\n121\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n122\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n123\t  messageWorkHandlers;\n124\t\n125\texport function queueMessageWork(\n126\t  ctx: OperationContext,\n127\t  message: MessageCreated,\n128\t): WorkItemRecord[] {\n129\t  if (message === null) return [];\n130\t  const items: WorkItemRecord[] = [];\n131\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n132\t  if (kind !== undefined) {\n133\t    const form = MESSAGE_WORK_FORMS[kind];\n134\t    if (form === undefined) {\n135\t      // Every queuing kind names its form above; a miss is a wiring bug.\n136\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n137\t    }\n138\t    items.push(\n139\t      enqueue(ctx, {\n140\t        owner: \"messages\",\n141\t        kind,\n142\t        sourceRef: { messageId: message.messageId },\n143\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n144\t      }),\n145\t    );\n146\t  }\n147\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n148\t  // summary already derived with outcome \"unknown\" means the summary's\n149\t  // source — the call+result pair — completed underneath it; clear and\n150\t  // regenerate at the next source version, in this same batch transaction.\n151\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n152\t  // the common call-and-result-in-one-batch case never triggers, and the\n153\t  // version-scoped item id keeps the requeue idempotent.\n154\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n155\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n156\t    if (stale !== undefined) {\n157\t      items.push(\n158\t        enqueue(ctx, {\n159\t          owner: \"messages\",\n160\t          kind: \"tool_call_summary\",\n161\t          sourceRef: { messageId: stale.messageId },\n162\t          sourceVersion: stale.sourceVersion + 1,\n163\t          forms: [\n164\t            {\n165\t              subjectKind: \"message\",\n166\t              subjectId: stale.messageId,\n167\t              form: \"tool_call_summary\",\n168\t            },\n169\t          ],\n170\t        }),\n171\t      );\n172\t    }\n173\t  }\n174\t  return items;\n175\t}\n176\t\n177\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n178\t  return {\n179\t    ok: false,\n180\t    error: {\n181\t      errorClass: \"caller_error\",\n182\t      code: \"thread_not_found\",\n183\t      reason: `no thread file exists at ${filePath}`,\n184\t    },\n185\t  };\n186\t}\n187\t\n188\texport async function listMessages(\n189\t  thread: ThreadRef,\n190\t): Promise<OpResult<MessageRecord[]>> {\n191\t  const resolved = await resolveThreadRef(thread);\n192\t  if (!resolved.ok) return resolved;\n193\t  const { filePath } = resolved.value;\n194\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n195\t\n196\t  // openThreadDatabase verifies the file is a real thread file and migrates\n197\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n198\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n199\t  // unmutated (F-03-002).\n200\t  const opened = openThreadDatabase(filePath);\n201\t  if (!opened.ok) return opened;\n202\t  const db = opened.value;\n203\t  try {\n204\t    // Form read-back rides the message read (AC-2.1): each record carries\n205\t    // its stored derived forms, attached from one grouped query — the\n206\t    // production path for \"readable alongside the message\".\n207\t    const formsByMessage = readMessageForms(db);\n208\t    const records = readMessages(db).map((record) => {\n209\t      const forms = formsByMessage.get(record.messageId);\n210\t      return forms === undefined ? record : { ...record, forms };\n211\t    });\n212\t    return { ok: true, value: records };\n213\t  } catch (cause) {\n214\t    const reason = cause instanceof Error ? cause.message : String(cause);\n215\t    return storageFailure(`message read-back failed: ${reason}`);\n216\t  } finally {\n217\t    db.close();\n218\t  }\n219\t}\n220\t\n221\texport async function listQueuedWork(\n222\t  thread: ThreadRef,\n223\t): Promise<OpResult<WorkItemRecord[]>> {\n224\t  const resolved = await resolveThreadRef(thread);\n225\t  if (!resolved.ok) return resolved;\n226\t  const { filePath } = resolved.value;\n227\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n228\t\n229\t  const opened = openThreadDatabase(filePath);\n230\t  if (!opened.ok) return opened;\n231\t  const db = opened.value;\n232\t  try {\n233\t    return { ok: true, value: listItems(db, \"messages\") };\n234\t  } catch (cause) {\n235\t    const reason = cause instanceof Error ? cause.message : String(cause);\n236\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n237\t  } finally {\n238\t    db.close();\n239\t  }\n240\t}\n241\t\n242\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n243\t\n244\t// This owner's repair report: every message-owned form's durable state\n245\t// joined with live queue detail in one query — the five operational\n246\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n247\t// without any queue API. Needs no provider; reads degrade, never block.\n248\texport async function report(\n249\t  thread: ThreadRef,\n250\t  opts?: { notReady?: boolean; messageId?: string },\n251\t): Promise<OpResult<FormReportEntry[]>> {\n252\t  const resolved = await resolveThreadRef(thread);\n253\t  if (!resolved.ok) return resolved;\n254\t  const { filePath } = resolved.value;\n255\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n256\t\n257\t  const opened = openThreadDatabase(filePath);\n258\t  if (!opened.ok) return opened;\n259\t  const db = opened.value;\n260\t  try {\n261\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n262\t  } catch (cause) {\n263\t    const reason = cause instanceof Error ? cause.message : String(cause);\n264\t    return storageFailure(`report read failed: ${reason}`);\n265\t  } finally {\n266\t    db.close();\n267\t  }\n268\t}\n269\t\n270\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n271\t\n272\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n273\t// inverted; the requeue's join from the named form back to its queue site.\n274\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n275\t  smoothed_prompt: \"prompt_smoothing\",\n276\t  tool_call_summary: \"tool_call_summary\",\n277\t  tool_result_summary: \"tool_result_summary\",\n278\t};\n279\t\n280\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n281\t// supported rebuild act. Refused for blocked forms with the form's stored\n282\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n283\t// queued or in flight at the form's current source version (AC-4.5).\n284\t// Otherwise the form clears to pending and re-enqueues at the next source\n285\t// version — the same enqueue path intake uses, poke-on-commit included, so\n286\t// background mode processes the repair with no further call. The no-op check\n287\t// and the enqueue commit in one transaction (anti-shim: a split would\n288\t// reintroduce the duplicate-work race).\n289\texport async function requeue(\n290\t  thread: ThreadRef,\n291\t  target: { messageId: string; form: FormKind },\n292\t): Promise<OpResult<RequeueOutcome>> {\n293\t  const kind = MESSAGE_FORM_KINDS[target.form];\n294\t  if (kind === undefined) {\n295\t    return {\n296\t      ok: false,\n297\t      error: {\n298\t        errorClass: \"caller_error\",\n299\t        code: \"message_not_found\",\n300\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n301\t      },\n302\t    };\n303\t  }\n304\t  const resolved = await resolveThreadRef(thread);\n305\t  if (!resolved.ok) return resolved;\n306\t  const { filePath } = resolved.value;\n307\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n308\t\n309\t  const opened = openThreadDatabase(filePath);\n310\t  if (!opened.ok) return opened;\n311\t  const db = opened.value;\n312\t  try {\n313\t    const meta = db\n314\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n315\t      .get() as { thread_id: string } | undefined;\n316\t    const threadId = meta?.thread_id ?? \"\";\n317\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n318\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n319\t      if (row === undefined) {\n320\t        return {\n321\t          ok: false,\n322\t          error: {\n323\t            errorClass: \"caller_error\",\n324\t            code: \"message_not_found\",\n325\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n326\t          },\n327\t        };\n328\t      }\n329\t      if (row.state === \"blocked\") {\n330\t        // The refusal carries the form's stored reason — the damage named at\n331\t        // blocking time, not a generic string (AC-4.6).\n332\t        return {\n333\t          ok: false,\n334\t          error: {\n335\t            errorClass: \"state_corruption\",\n336\t            code: \"source_damaged\",\n337\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n338\t          },\n339\t        };\n340\t      }\n341\t      const sourceRef = { messageId: target.messageId };\n342\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n343\t        return { ok: true, value: { noop: \"already_queued\" } };\n344\t      }\n345\t      const item = enqueue(ctx, {\n346\t        owner: \"messages\",\n347\t        kind,\n348\t        sourceRef,\n349\t        sourceVersion: row.sourceVersion + 1,\n350\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n351\t      });\n352\t      return { ok: true, value: { workItemId: item.workItemId } };\n353\t    });\n354\t  } catch (cause) {\n355\t    const reason = cause instanceof Error ? cause.message : String(cause);\n356\t    return storageFailure(`requeue failed: ${reason}`);\n357\t  } finally {\n358\t    db.close();\n359\t  }\n360\t}\n361\t"}]},"parent_tool_use_id":null,"session_id":"11cfbce6-8c6f-47e4-8ae9-6d1d829e88b4","uuid":"f09ee22a-b102-41c9-b56b-c0f3dea59036","timestamp":"2026-06-11T05:57:46.597Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\nimport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  hasLiveItem,\n  listItems,\n  type WorkItemRecord,\n  type WorkKind,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport type { DerivedForm } from \"../../shared/derivation.js\";\nimport {\n  findUnknownOutcomeCallSummary,\n  readMessageFormRow,\n  readMessageForms,\n  reportMessageForms,\n} from \"./internal/forms.js\";\nimport { messageWorkHandlers } from \"./internal/handlers.js\";\nimport { projectEvent } from \"./internal/project.js\";\nimport { insertMessage, readMessages } from \"./internal/store.js\";\n\nexport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n\nexport interface Block {\n  blockType: BlockType;\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n}\n\nexport interface MessageRecord {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: Exclude<EventKind, \"turn_end\">;\n  blocks: Block[];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  turnId?: string;\n  // The message's derived forms as stored (Epic 02 Story 2): present only\n  // for messages that are derivation sources — kinds with no derivable form\n  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n  // never re-derived on read.\n  forms?: DerivedForm[];\n}\n\n// The event as the walk holds it after recording: the validated input plus\n// its server-stamped order and timestamp.\nexport type RecordedEvent = EventRecord;\n\nexport type MessageCreated = {\n  messageId: string;\n  kind: Exclude<EventKind, \"turn_end\">;\n  // Carried for tool activity only: the pairing key the queue sites need —\n  // tool_result projection runs the AC-2.8 late-result lookup against it.\n  toolCallId?: string;\n} | null;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// (the first such call through the operation context; turns.applyEvent\n// follows the pattern in Story 4). Synchronous and throwing by design: a\n// projection failure propagates to the pipeline's catch and rejects the\n// whole batch — recorded events without messages is the stranded state the\n// transaction exists to prevent. Returns null for turn_end (no message).\n// turnId is the membership stamp, settled by the pipeline before this call:\n// the turn open *after* this event's transition (so a prompt belongs to the\n// turn it just opened), or null in a gap — written once, never updated.\nexport function createFromEvent(\n  ctx: OperationContext,\n  event: RecordedEvent,\n  turnId: string | null,\n): MessageCreated {\n  const projected = projectEvent(event);\n  if (projected === null) return null;\n  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n  const messageId = `m${event.eventOrder}`;\n  insertMessage(ctx.db, {\n    messageId,\n    sourceEventOrder: event.eventOrder,\n    kind,\n    tokenEstimate: projected.tokenEstimate,\n    actor: event.actor,\n    harness: event.harness,\n    turnId,\n    blocks: projected.blocks,\n  });\n  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n    return { messageId, kind, toolCallId: event.payload.toolCallId };\n  }\n  return { messageId, kind };\n}\n\n// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n// tool result queues tool_result_summary, nothing else queues anything —\n// text, thinking, and note messages are not derivation sources (Epic 01\n// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n// intake-stream inside the batch transaction for every recorded message, so\n// the item commits (or rolls back) with the batch.\nconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n  user_prompt: \"prompt_smoothing\",\n  tool_call: \"tool_call_summary\",\n  tool_result: \"tool_result_summary\",\n};\n\n// Which derived form each message-owned kind produces — the owning domain's\n// knowledge, handed to the meaning-blind enqueue so the form's pending row\n// rides the same transaction (DD-5).\nconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n  prompt_smoothing: \"smoothed_prompt\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Message-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6): prompt smoothing and the two tool-activity summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n  messageWorkHandlers;\n\nexport function queueMessageWork(\n  ctx: OperationContext,\n  message: MessageCreated,\n): WorkItemRecord[] {\n  if (message === null) return [];\n  const items: WorkItemRecord[] = [];\n  const kind = MESSAGE_WORK_KINDS[message.kind];\n  if (kind !== undefined) {\n    const form = MESSAGE_WORK_FORMS[kind];\n    if (form === undefined) {\n      // Every queuing kind names its form above; a miss is a wiring bug.\n      throw new Error(`no derived form mapped for message work kind ${kind}`);\n    }\n    items.push(\n      enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef: { messageId: message.messageId },\n        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n      }),\n    );\n  }\n  // Late-result repair (AC-2.8): a tool result landing after its call's\n  // summary already derived with outcome \"unknown\" means the summary's\n  // source — the call+result pair — completed underneath it; clear and\n  // regenerate at the next source version, in this same batch transaction.\n  // One indexed lookup; pending summaries (metadata NULL) never match, so\n  // the common call-and-result-in-one-batch case never triggers, and the\n  // version-scoped item id keeps the requeue idempotent.\n  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n    if (stale !== undefined) {\n      items.push(\n        enqueue(ctx, {\n          owner: \"messages\",\n          kind: \"tool_call_summary\",\n          sourceRef: { messageId: stale.messageId },\n          sourceVersion: stale.sourceVersion + 1,\n          forms: [\n            {\n              subjectKind: \"message\",\n              subjectId: stale.messageId,\n              form: \"tool_call_summary\",\n            },\n          ],\n        }),\n      );\n    }\n  }\n  return items;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listMessages(\n  thread: ThreadRef,\n): Promise<OpResult<MessageRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file and migrates\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\n  // unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    // Form read-back rides the message read (AC-2.1): each record carries\n    // its stored derived forms, attached from one grouped query — the\n    // production path for \"readable alongside the message\".\n    const formsByMessage = readMessageForms(db);\n    const records = readMessages(db).map((record) => {\n      const forms = formsByMessage.get(record.messageId);\n      return forms === undefined ? record : { ...record, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`message read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"messages\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n\n// This owner's repair report: every message-owned form's durable state\n// joined with live queue detail in one query — the five operational\n// situations (waiting, retrying, ready, failed, blocked) read from the rows\n// without any queue API. Needs no provider; reads degrade, never block.\nexport async function report(\n  thread: ThreadRef,\n  opts?: { notReady?: boolean; messageId?: string },\n): Promise<OpResult<FormReportEntry[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`report read failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n\n// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n// inverted; the requeue's join from the named form back to its queue site.\nconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n  smoothed_prompt: \"prompt_smoothing\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Explicit re-queue through the owning surface (AC-4.4): the public,\n// supported rebuild act. Refused for blocked forms with the form's stored\n// damage reason (AC-4.6) and for missing rows; a no-op against work already\n// queued or in flight at the form's current source version (AC-4.5).\n// Otherwise the form clears to pending and re-enqueues at the next source\n// version — the same enqueue path intake uses, poke-on-commit included, so\n// background mode processes the repair with no further call. The no-op check\n// and the enqueue commit in one transaction (anti-shim: a split would\n// reintroduce the duplicate-work race).\nexport async function requeue(\n  thread: ThreadRef,\n  target: { messageId: string; form: FormKind },\n): Promise<OpResult<RequeueOutcome>> {\n  const kind = MESSAGE_FORM_KINDS[target.form];\n  if (kind === undefined) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"message_not_found\",\n        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n      },\n    };\n  }\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n      if (row === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"message_not_found\",\n            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n          },\n        };\n      }\n      if (row.state === \"blocked\") {\n        // The refusal carries the form's stored reason — the damage named at\n        // blocking time, not a generic string (AC-4.6).\n        return {\n          ok: false,\n          error: {\n            errorClass: \"state_corruption\",\n            code: \"source_damaged\",\n            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n          },\n        };\n      }\n      const sourceRef = { messageId: target.messageId };\n      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n        return { ok: true, value: { noop: \"already_queued\" } };\n      }\n      const item = enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef,\n        sourceVersion: row.sourceVersion + 1,\n        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n      });\n      return { ok: true, value: { workItemId: item.workItemId } };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`requeue failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":361,"startLine":1,"totalLines":361}}}

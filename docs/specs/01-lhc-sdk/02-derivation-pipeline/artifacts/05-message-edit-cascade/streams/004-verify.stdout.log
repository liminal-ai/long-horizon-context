{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n     2\t// source turn, the member messages it composes (deleted-filtered — the\n     3\t// shared read-filter rule lives here, once for this domain), the\n     4\t// message-level form rows composition consumes, and the member projections\n     5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n     6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n     7\t// — no write path here.\n     8\timport type { DatabaseSync } from \"node:sqlite\";\n     9\timport type {\n    10\t  DependencyGap,\n    11\t  DerivedForm,\n    12\t  DerivedFormMetadata,\n    13\t  DerivedFormState,\n    14\t  FormReportEntry,\n    15\t  RenderingPartKind,\n    16\t  ToolRunReceipt,\n    17\t} from \"../../../shared/derivation.js\";\n    18\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n    19\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n    20\timport { composeFormKey } from \"./compose.js\";\n    21\timport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n    22\t\n    23\texport interface TurnSource {\n    24\t  turnId: string;\n    25\t  status: \"open\" | \"closed\";\n    26\t  deleted: boolean;\n    27\t}\n    28\t\n    29\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n    30\t  const row = db\n    31\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    32\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n    33\t  if (row === undefined) return undefined;\n    34\t  return {\n    35\t    turnId,\n    36\t    status: row.status as TurnSource[\"status\"],\n    37\t    deleted: row.deleted_at !== null,\n    38\t  };\n    39\t}\n    40\t\n    41\t// Member messages in message order, blocks attached, deleted messages\n    42\t// filtered (tech design §Mechanics: composition's member enumeration reads\n    43\t// the live projection only).\n    44\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n    45\t  const messages = db\n    46\t    .prepare(\n    47\t      `SELECT message_id, kind FROM message\n    48\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    49\t    )\n    50\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n    51\t  const blockStmt = db.prepare(\n    52\t    `SELECT block_type, content FROM message_block\n    53\t     WHERE message_id = ? ORDER BY block_index`,\n    54\t  );\n    55\t  return messages.map((message) => {\n    56\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n    57\t      block_type: string;\n    58\t      content: string;\n    59\t    }>;\n    60\t    return {\n    61\t      messageId: message.message_id,\n    62\t      kind: message.kind as RenderingPartKind,\n    63\t      blocks: blocks.map((block) => ({\n    64\t        blockType: block.block_type,\n    65\t        content: JSON.parse(block.content) as Record<string, unknown>,\n    66\t      })),\n    67\t    };\n    68\t  });\n    69\t}\n    70\t\n    71\t// The message-owned form rows for a set of member messages, keyed for\n    72\t// composition. A cross-owner *read* by design: composition consumes message\n    73\t// forms; only message handlers ever write them (DD-2 ownership is a write\n    74\t// rule).\n    75\texport function readMessageFormRows(\n    76\t  db: DatabaseSync,\n    77\t  messageIds: readonly string[],\n    78\t): Map<string, ComposeFormRow> {\n    79\t  const rows = new Map<string, ComposeFormRow>();\n    80\t  if (messageIds.length === 0) return rows;\n    81\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n    82\t  const raw = db\n    83\t    .prepare(\n    84\t      `SELECT subject_id, form, state, content, metadata FROM derived_form\n    85\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    86\t    )\n    87\t    .all(...messageIds) as unknown as Array<{\n    88\t    subject_id: string;\n    89\t    form: string;\n    90\t    state: string;\n    91\t    content: string | null;\n    92\t    metadata: string | null;\n    93\t  }>;\n    94\t  for (const row of raw) {\n    95\t    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n    96\t    if (row.content !== null) view.content = row.content;\n    97\t    if (row.metadata !== null) {\n    98\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n    99\t    }\n   100\t    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n   101\t  }\n   102\t  return rows;\n   103\t}\n   104\t\n   105\t// Member projections in turn order for the chunk summaries: member rows by\n   106\t// member_idx, deleted turns filtered, each joined to its stored\n   107\t// lower_band_projection row (state + content as landed — never re-derived)\n   108\t// and to its turn_rendering's mechanically stamped tool-run receipts\n   109\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\n   110\texport interface MemberProjection {\n   111\t  turnId: string;\n   112\t  state?: string; // undefined: no projection row exists for the member\n   113\t  content?: string;\n   114\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n   115\t}\n   116\t\n   117\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n   118\t  const rows = db\n   119\t    .prepare(\n   120\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n   121\t       FROM chunk_member cm\n   122\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   123\t       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n   124\t         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n   125\t       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\n   126\t         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\n   127\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   128\t    )\n   129\t    .all(chunkId) as unknown as Array<{\n   130\t    turn_id: string;\n   131\t    state: string | null;\n   132\t    content: string | null;\n   133\t    rendering_metadata: string | null;\n   134\t  }>;\n   135\t  return rows.map((row) => {\n   136\t    const metadata =\n   137\t      row.rendering_metadata === null\n   138\t        ? undefined\n   139\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n   140\t    const projection: MemberProjection = {\n   141\t      turnId: row.turn_id,\n   142\t      receipts: metadata?.receipts ?? [],\n   143\t    };\n   144\t    if (row.state !== null) projection.state = row.state;\n   145\t    if (row.content !== null) projection.content = row.content;\n   146\t    return projection;\n   147\t  });\n   148\t}\n   149\t\n   150\tinterface RawOwnedFormRow {\n   151\t  subject_id: string;\n   152\t  form: string;\n   153\t  state: string;\n   154\t  content: string | null;\n   155\t  reason: string | null;\n   156\t  metadata: string | null;\n   157\t  source_version: number | bigint;\n   158\t  gaps: string | null;\n   159\t  derived_at: string | null;\n   160\t}\n   161\t\n   162\t// Every form row this owner holds for one subject kind, grouped by subject\n   163\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\n   164\t// \"record with form states\", mirroring messages.readMessageForms). Rows come\n   165\t// back exactly as the pipeline landed them; nothing is derived at read time.\n   166\texport function readOwnedForms(\n   167\t  db: DatabaseSync,\n   168\t  subjectKind: \"turn\" | \"chunk\",\n   169\t): Map<string, DerivedForm[]> {\n   170\t  const rows = db\n   171\t    .prepare(\n   172\t      `SELECT subject_id, form, state, content, reason, metadata,\n   173\t              source_version, gaps, derived_at\n   174\t       FROM derived_form WHERE subject_kind = ?\n   175\t       ORDER BY subject_id, form`,\n   176\t    )\n   177\t    .all(subjectKind) as unknown as RawOwnedFormRow[];\n   178\t  const bySubject = new Map<string, DerivedForm[]>();\n   179\t  for (const row of rows) {\n   180\t    const record: DerivedForm = {\n   181\t      subjectKind,\n   182\t      subjectId: row.subject_id,\n   183\t      form: row.form as FormKind,\n   184\t      state: row.state as DerivedFormState,\n   185\t      sourceVersion: Number(row.source_version),\n   186\t    };\n   187\t    if (row.content !== null) record.content = row.content;\n   188\t    if (row.reason !== null) record.reason = row.reason;\n   189\t    if (row.metadata !== null) {\n   190\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n   191\t    }\n   192\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n   193\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n   194\t    const forms = bySubject.get(row.subject_id) ?? [];\n   195\t    forms.push(record);\n   196\t    bySubject.set(row.subject_id, forms);\n   197\t  }\n   198\t  return bySubject;\n   199\t}\n   200\t\n   201\t// Chunk read-back rows for the listChunks surface: stored chunk state plus\n   202\t// live (deleted-filtered) membership in member order.\n   203\texport interface ChunkReadRow {\n   204\t  chunkId: string;\n   205\t  chunkOrder: number;\n   206\t  status: \"open\" | \"closed\";\n   207\t  accumulatedProjectedTokens: number;\n   208\t  memberTurnIds: string[];\n   209\t}\n   210\t\n   211\texport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\n   212\t  const chunks = db\n   213\t    .prepare(\n   214\t      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n   215\t       FROM chunk ORDER BY chunk_order`,\n   216\t    )\n   217\t    .all() as unknown as Array<{\n   218\t    chunk_id: string;\n   219\t    chunk_order: number | bigint;\n   220\t    status: string;\n   221\t    accumulated_projected_tokens: number | bigint;\n   222\t  }>;\n   223\t  const memberStmt = db.prepare(\n   224\t    `SELECT cm.turn_id FROM chunk_member cm\n   225\t     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   226\t     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   227\t  );\n   228\t  return chunks.map((row) => ({\n   229\t    chunkId: row.chunk_id,\n   230\t    chunkOrder: Number(row.chunk_order),\n   231\t    status: row.status as \"open\" | \"closed\",\n   232\t    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n   233\t    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\n   234\t      (member) => member.turn_id,\n   235\t    ),\n   236\t  }));\n   237\t}\n   238\t\n   239\t// One form row by exact key for this owner's subjects — the requeue\n   240\t// operation's refusal read (missing row, blocked state, current version).\n   241\texport function readTurnFormRow(\n   242\t  db: DatabaseSync,\n   243\t  subjectKind: \"turn\" | \"chunk\",\n   244\t  subjectId: string,\n   245\t  form: FormKind,\n   246\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n   247\t  const row = db\n   248\t    .prepare(\n   249\t      `SELECT state, reason, source_version FROM derived_form\n   250\t       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n   251\t    )\n   252\t    .get(subjectKind, subjectId, form) as unknown as\n   253\t    | { state: string; reason: string | null; source_version: number | bigint }\n   254\t    | undefined;\n   255\t  if (row === undefined) return undefined;\n   256\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n   257\t    state: row.state as DerivedFormState,\n   258\t    sourceVersion: Number(row.source_version),\n   259\t  };\n   260\t  if (row.reason !== null) view.reason = row.reason;\n   261\t  return view;\n   262\t}\n   263\t\n   264\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\n   265\t// form rows LEFT JOINed with the live work_item targeting each form at its\n   266\t// current source version. Both turn forms map to the one turn_derivation\n   267\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\n   268\t// this owner's queue-site mapping inverted, mirroring the messages report.\n   269\texport function reportTurnForms(\n   270\t  db: DatabaseSync,\n   271\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\n   272\t): FormReportEntry[] {\n   273\t  const conditions = [\"df.subject_kind IN ('turn', 'chunk')\"];\n   274\t  const params: string[] = [];\n   275\t  const subjectFilters: string[] = [];\n   276\t  if (opts.turnId !== undefined) {\n   277\t    subjectFilters.push(\"(df.subject_kind = 'turn' AND df.subject_id = ?)\");\n   278\t    params.push(opts.turnId);\n   279\t  }\n   280\t  if (opts.chunkId !== undefined) {\n   281\t    subjectFilters.push(\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\");\n   282\t    params.push(opts.chunkId);\n   283\t  }\n   284\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\" OR \")})`);\n   285\t  // notReady is exact set equality by construction: every state but ready.\n   286\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   287\t  const rows = db\n   288\t    .prepare(\n   289\t      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\n   290\t              df.metadata, df.source_version, df.gaps, df.derived_at,\n   291\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   292\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   293\t       FROM derived_form df\n   294\t       LEFT JOIN work_item w\n   295\t         ON w.status IN ('queued', 'claimed')\n   296\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\n   297\t        AND json_extract(\n   298\t              w.source_ref,\n   299\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\n   300\t            ) = df.subject_id\n   301\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   302\t       WHERE ${conditions.join(\" AND \")}\n   303\t       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\n   304\t    )\n   305\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\n   306\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\n   307\t}\n   308\t\n   309\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n   310\t  return (\n   311\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n   312\t  );\n   313\t}\n","exit_code":0,"status":"completed"}}

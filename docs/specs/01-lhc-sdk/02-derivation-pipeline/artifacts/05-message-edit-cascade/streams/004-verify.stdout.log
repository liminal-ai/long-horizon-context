{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/cli-process-mutations.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 5 (Epic 02), process-boundary suite: TC-5.6 — `lhc messages edit`\n     2\t// through the spawned dist/cli.js has full parity with messages.edit on twin\n     3\t// fixtures: identical result JSON, identical cascade (queue rows), identical\n     4\t// read-back. Mutations need no provider (DD-11) — only the twin-building\n     5\t// drains resolve one, in-process through the same registry the CLI uses.\n     6\t// Runs under verify-all only (LHC_PROCESS_SUITE=1). Lives in its own file\n     7\t// because cli-process-work.test.ts is hash-locked by the Story 1 red\n     8\t// manifest; green may add files, not edit (the Story 4 precedent).\n     9\timport { spawnSync } from \"node:child_process\";\n    10\timport { mkdtempSync, rmSync } from \"node:fs\";\n    11\timport { tmpdir } from \"node:os\";\n    12\timport path from \"node:path\";\n    13\timport { fileURLToPath } from \"node:url\";\n    14\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    15\timport {\n    16\t  createSdk,\n    17\t  intakeStream,\n    18\t  messages,\n    19\t  queueDetail,\n    20\t  resolveNamedProvider,\n    21\t  threads,\n    22\t  type MutationResult,\n    23\t  type OpResult,\n    24\t} from \"../src/index.js\";\n    25\timport { openRaw, readDerivedForms, validEvent } from \"./fixtures/index.js\";\n    26\t\n    27\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    28\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n    29\t\n    30\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n    31\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    32\t    encoding: \"utf8\",\n    33\t    env: { ...process.env, LHC_PROVIDER: undefined },\n    34\t  });\n    35\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    36\t}\n    37\t\n    38\tlet dir: string;\n    39\tbeforeEach(() => {\n    40\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-mutations-\"));\n    41\t});\n    42\tafterEach(() => {\n    43\t  rmSync(dir, { recursive: true, force: true });\n    44\t});\n    45\t\n    46\tasync function newThreadFile(name: string): Promise<string> {\n    47\t  const filePath = path.join(dir, `${name}.sqlite`);\n    48\t  const created = await threads.newThread({\n    49\t    filePath,\n    50\t    registryPath: path.join(dir, \"registry.sqlite\"),\n    51\t  });\n    52\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    53\t  return filePath;\n    54\t}\n    55\t\n    56\t// One closed prompt+answer turn, identical on both twins: fixed idempotency\n    57\t// keys make the records comparable; the drains run in-process under one\n    58\t// injected clock so derived timestamps match byte-for-byte.\n    59\tasync function seedTwin(filePath: string): Promise<void> {\n    60\t  const batch = [\n    61\t    validEvent(\"user_prompt\", { payload: { text: \"twin edit prompt\" } }),\n    62\t    validEvent(\"assistant_text\", { payload: { text: \"twin edit answer\" } }),\n    63\t    validEvent(\"turn_end\"),\n    64\t  ].map((event, index) => ({ ...event, idempotencyKey: `twin-edit-${index}` }));\n    65\t  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n    66\t  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n    67\t}\n    68\t\n    69\tfunction rawDetailStripped(\n    70\t  filePath: string,\n    71\t): Array<Omit<ReturnType<typeof queueDetail>[number], \"queuedAt\">> {\n    72\t  const db = openRaw(filePath);\n    73\t  try {\n    74\t    return queueDetail(db).map(({ queuedAt: _queuedAt, ...rest }) => rest);\n    75\t  } finally {\n    76\t    db.close();\n    77\t  }\n    78\t}\n    79\t\n    80\tdescribe(\"TC-5.6 / AC-5.6: messages.edit has SDK/CLI parity on twin fixtures\", () => {\n    81\t  it(\"the same edit via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n    82\t    const cliThread = await newThreadFile(\"cli-edit\");\n    83\t    const sdkThread = await newThreadFile(\"sdk-edit\");\n    84\t    await seedTwin(cliThread);\n    85\t    await seedTwin(sdkThread);\n    86\t\n    87\t    // Build identical ready state on both twins through the production\n    88\t    // assembly the CLI drain uses: registry provider, manual mode, one fixed\n    89\t    // clock so derivedAt stamps match.\n    90\t    const provider = resolveNamedProvider(\"deterministic\");\n    91\t    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n    92\t    const sdk = createSdk({\n    93\t      provider,\n    94\t      mode: \"manual\",\n    95\t      clock: () => new Date(\"2026-06-11T00:00:00.000Z\"),\n    96\t    });\n    97\t    for (const filePath of [cliThread, sdkThread]) {\n    98\t      const drained = await sdk.work.drain({ filePath });\n    99\t      if (!drained.ok) throw new Error(`twin drain failed: ${drained.error.reason}`);\n   100\t    }\n   101\t    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n   102\t\n   103\t    const viaSdk = await messages.edit(\n   104\t      { filePath: sdkThread },\n   105\t      { messageId: \"m1\", content: \"twin edited prompt\" },\n   106\t    );\n   107\t    expect(viaSdk.ok).toBe(true);\n   108\t\n   109\t    const viaCli = runBinary([\n   110\t      \"messages\",\n   111\t      \"edit\",\n   112\t      \"--file-path\",\n   113\t      cliThread,\n   114\t      \"--message\",\n   115\t      \"m1\",\n   116\t      \"--content\",\n   117\t      \"twin edited prompt\",\n   118\t    ]);\n   119\t    expect(viaCli.status).toBe(0);\n   120\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n   121\t    expect(parsed.ok).toBe(true);\n   122\t    if (!parsed.ok || !viaSdk.ok) return;\n   123\t\n   124\t    // Identical result JSON: same validation, same result shape, same\n   125\t    // cascade report (the deterministic ids carry the source versions).\n   126\t    expect(parsed.value).toEqual(viaSdk.value);\n   127\t\n   128\t    // Identical cascade in the record: the live queue rows match minus the\n   129\t    // wall-clock queuedAt stamp (the edits ran at different real times).\n   130\t    expect(rawDetailStripped(cliThread)).toEqual(rawDetailStripped(sdkThread));\n   131\t\n   132\t    // Identical read-back: messages (content, blocks, re-stamped estimate,\n   133\t    // attached form states) and the full derived_form table.\n   134\t    const cliMessages = await messages.listMessages({ filePath: cliThread });\n   135\t    const sdkMessages = await messages.listMessages({ filePath: sdkThread });\n   136\t    expect(cliMessages.ok && sdkMessages.ok).toBe(true);\n   137\t    if (!cliMessages.ok || !sdkMessages.ok) return;\n   138\t    expect(cliMessages.value).toEqual(sdkMessages.value);\n   139\t    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n   140\t  });\n   141\t\n   142\t  it(\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\", async () => {\n   143\t    const threadPath = await newThreadFile(\"cli-refusal\");\n   144\t    await seedTwin(threadPath);\n   145\t    const before = readDerivedForms(threadPath);\n   146\t\n   147\t    const missing = runBinary([\n   148\t      \"messages\",\n   149\t      \"edit\",\n   150\t      \"--file-path\",\n   151\t      threadPath,\n   152\t      \"--message\",\n   153\t      \"m99\",\n   154\t      \"--content\",\n   155\t      \"nope\",\n   156\t    ]);\n   157\t    expect(missing.status).toBe(1);\n   158\t    const missingParsed = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n   159\t    expect(missingParsed.ok).toBe(false);\n   160\t    expect(missingParsed.error.code).toBe(\"message_not_found\");\n   161\t\n   162\t    // SDK twin refusal is byte-identical in code and class.\n   163\t    const viaSdk = await messages.edit({ filePath: threadPath }, { messageId: \"m99\", content: \"nope\" });\n   164\t    expect(viaSdk.ok).toBe(false);\n   165\t    if (viaSdk.ok) return;\n   166\t    expect(viaSdk.error.code).toBe(\"message_not_found\");\n   167\t    expect(viaSdk.error.errorClass).toBe(\"caller_error\");\n   168\t\n   169\t    expect(readDerivedForms(threadPath)).toEqual(before);\n   170\t  });\n   171\t});\n","exit_code":0,"status":"completed"}}

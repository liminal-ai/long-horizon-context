{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '351,620p'\"","aggregated_output":"   351\texport function failTerminal(\n   352\t  db: DatabaseSync,\n   353\t  item: ClaimedWorkItem,\n   354\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n   355\t): void {\n   356\t  db.exec(\"BEGIN IMMEDIATE;\");\n   357\t  try {\n   358\t    const update = db.prepare(\n   359\t      `UPDATE derived_form\n   360\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n   361\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   362\t    );\n   363\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n   364\t    for (const target of item.forms) {\n   365\t      update.run(\n   366\t        opts.formState,\n   367\t        opts.reason,\n   368\t        metadata,\n   369\t        opts.now,\n   370\t        target.subjectKind,\n   371\t        target.subjectId,\n   372\t        target.form,\n   373\t        item.sourceVersion,\n   374\t      );\n   375\t    }\n   376\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   377\t    db.exec(\"COMMIT;\");\n   378\t  } catch (cause) {\n   379\t    db.exec(\"ROLLBACK;\");\n   380\t    throw cause;\n   381\t  }\n   382\t}\n   383\t\n   384\t// A failed run counts itself. Under budget and retryable: the row goes back\n   385\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n   386\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n   387\t// on a non-retryable failure, the item is terminal: form `failed` with the\n   388\t// final reason, row deleted (AC-1.9).\n   389\texport function failAttempt(\n   390\t  db: DatabaseSync,\n   391\t  item: ClaimedWorkItem,\n   392\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n   393\t): FailAttemptResult {\n   394\t  const attempts = item.attempts + 1;\n   395\t  if (opts.retryable && attempts < opts.retry.budget) {\n   396\t    const backoffMs = Math.min(\n   397\t      opts.retry.backoffBaseMs * 2 ** attempts,\n   398\t      opts.retry.backoffCapMs,\n   399\t    );\n   400\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n   401\t    db.exec(\"BEGIN IMMEDIATE;\");\n   402\t    try {\n   403\t      db.prepare(\n   404\t        `UPDATE work_item\n   405\t         SET status = 'queued', attempts = ?, last_error = ?,\n   406\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n   407\t         WHERE work_item_id = ?`,\n   408\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n   409\t      db.exec(\"COMMIT;\");\n   410\t    } catch (cause) {\n   411\t      db.exec(\"ROLLBACK;\");\n   412\t      throw cause;\n   413\t    }\n   414\t    return { terminal: false, attempts, eligibleAt };\n   415\t  }\n   416\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n   417\t  return { terminal: true, attempts };\n   418\t}\n   419\t\n   420\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n   421\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n   422\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n   423\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n   424\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n   425\t// discards their stale completions. Ships here as mechanics; its only caller\n   426\t// is Story 5's cascade.\n   427\texport function supersedeQueued(\n   428\t  db: DatabaseSync,\n   429\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n   430\t): string[] {\n   431\t  const ids: string[] = [];\n   432\t  const remove = db.prepare(\n   433\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n   434\t     RETURNING work_item_id`,\n   435\t  );\n   436\t  for (const target of targets) {\n   437\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n   438\t      work_item_id: string;\n   439\t    }>;\n   440\t    for (const row of rows) ids.push(row.work_item_id);\n   441\t  }\n   442\t  return ids;\n   443\t}\n   444\t\n   445\t// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n   446\t// queued or in flight — for this kind and source at this source version?\n   447\t// Runs inside the caller's requeue transaction so the check and the enqueue\n   448\t// commit together (anti-shim: a check-then-enqueue split across transactions\n   449\t// reintroduces the duplicate-work race). Version-scoped on purpose: a\n   450\t// claimed pre-mutation item at an older version is dying work whose\n   451\t// completion DD-3 will discard — it must not block the repair.\n   452\texport function hasLiveItem(\n   453\t  db: DatabaseSync,\n   454\t  kind: WorkKind,\n   455\t  sourceRef: WorkSourceRef,\n   456\t  sourceVersion: number,\n   457\t): boolean {\n   458\t  const row = db\n   459\t    .prepare(\n   460\t      `SELECT 1 FROM work_item\n   461\t       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n   462\t         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n   463\t       LIMIT 1`,\n   464\t    )\n   465\t    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n   466\t  return row !== undefined;\n   467\t}\n   468\t\n   469\t// Live items left in the queue — the drain report's `remaining` and the\n   470\t// repair report's join source (Story 4).\n   471\texport function countLiveItems(db: DatabaseSync): number {\n   472\t  const row = db\n   473\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n   474\t    .get() as unknown as { n: number | bigint };\n   475\t  return Number(row.n);\n   476\t}\n   477\t\n   478\texport interface QueueDetailRow {\n   479\t  workItemId: string;\n   480\t  owner: WorkOwner;\n   481\t  kind: string;\n   482\t  sourceRef: WorkSourceRef;\n   483\t  status: \"queued\" | \"claimed\";\n   484\t  attempts: number;\n   485\t  lastError?: string;\n   486\t  eligibleAt?: string;\n   487\t  claimedAt?: string;\n   488\t  claimExpiresAt?: string;\n   489\t  queuedAt: string;\n   490\t  sourceVersion: number;\n   491\t}\n   492\t\n   493\t// Mechanical detail of every live row in queue order — what the repair\n   494\t// report joins against derived_form (Flow 4) and what tests read to assert\n   495\t// lease/backoff state without raw SQL at every call site.\n   496\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n   497\t  const rows = db\n   498\t    .prepare(\n   499\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n   500\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n   501\t       FROM work_item ORDER BY rowid`,\n   502\t    )\n   503\t    .all() as unknown as Array<\n   504\t    RawClaimRow & {\n   505\t      status: string;\n   506\t      last_error: string | null;\n   507\t      eligible_at: string | null;\n   508\t      claimed_at: string | null;\n   509\t      claim_expires_at: string | null;\n   510\t    }\n   511\t  >;\n   512\t  return rows.map((row) => {\n   513\t    const item = toClaimedItem(row);\n   514\t    const detail: QueueDetailRow = {\n   515\t      workItemId: item.workItemId,\n   516\t      owner: item.owner,\n   517\t      kind: item.kind,\n   518\t      sourceRef: item.sourceRef,\n   519\t      status: row.status as \"queued\" | \"claimed\",\n   520\t      attempts: item.attempts,\n   521\t      queuedAt: item.queuedAt,\n   522\t      sourceVersion: item.sourceVersion,\n   523\t    };\n   524\t    if (row.last_error !== null) detail.lastError = row.last_error;\n   525\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n   526\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n   527\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n   528\t    return detail;\n   529\t  });\n   530\t}\n   531\t\n   532\t// Listing in queue order (insertion order within the walk); each owning\n   533\t// domain lists only its own items.\n   534\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n   535\t  const rows = db\n   536\t    .prepare(\n   537\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n   538\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n   539\t    )\n   540\t    .all(owner) as unknown as RawWorkItemRow[];\n   541\t  return rows.map((row) => ({\n   542\t    workItemId: row.work_item_id,\n   543\t    owner: row.owner as WorkOwner,\n   544\t    kind: row.kind as WorkKind,\n   545\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n   546\t    status: \"queued\",\n   547\t    queuedAt: row.queued_at,\n   548\t  }));\n   549\t}\n","exit_code":0,"status":"completed"}}

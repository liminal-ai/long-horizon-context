{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '220,360p'\"","aggregated_output":"   220\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   221\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   222\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   223\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   224\t  }\n   225\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   226\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   227\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   228\t    throw new TypeError(\n   229\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   230\t    );\n   231\t  }\n   232\t\n   233\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   234\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   235\t  // assembly mechanics are production code from day one.\n   236\t  const workHandlers = assembleWorkHandlerMap([\n   237\t    messagesDomain.workHandlers,\n   238\t    turnsDomain.workHandlers,\n   239\t  ]);\n   240\t\n   241\t  const drainDeps: DrainDeps = {\n   242\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   243\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   244\t    config: resolved,\n   245\t  };\n   246\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   247\t\n   248\t  // Background mode wires the scheduler into the process-wide seams: enqueue\n   249\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n   250\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n   251\t  // constructing a later background SDK supersedes an earlier one (the\n   252\t  // displaced scheduler's in-memory state was advisory — the rows remain).\n   253\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n   254\t  if (resolved.mode === \"background\") {\n   255\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   256\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   257\t  }\n   258\t\n   259\t  const work: WorkSurface = {\n   260\t    drain: async (ref, opts) => {\n   261\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   262\t      if (!resolvedRef.ok) return resolvedRef;\n   263\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   264\t    },\n   265\t  };\n   266\t\n   267\t  return {\n   268\t    threads: threadsDomain,\n   269\t    intakeStream: intakeStreamDomain,\n   270\t    messages: messagesDomain,\n   271\t    turns: turnsDomain,\n   272\t    config: resolved,\n   273\t    scheduler,\n   274\t    workHandlers,\n   275\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   276\t    work,\n   277\t    drainSettled: async (ref) => {\n   278\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   279\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   280\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   281\t      if (threadId === null) return;\n   282\t      return scheduler.drainSettled(threadId);\n   283\t    },\n   284\t  };\n   285\t}\n","exit_code":0,"status":"completed"}}

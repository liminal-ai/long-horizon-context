{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '1,220p'\"","aggregated_output":"     1\texport * as threads from \"./domains/threads/index.js\";\n     2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n     3\texport * as messages from \"./domains/messages/index.js\";\n     4\texport * as turns from \"./domains/turns/index.js\";\n     5\t\n     6\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n     7\timport * as messagesDomain from \"./domains/messages/index.js\";\n     8\timport * as threadsDomain from \"./domains/threads/index.js\";\n     9\timport * as turnsDomain from \"./domains/turns/index.js\";\n    10\timport {\n    11\t  createScheduler,\n    12\t  peekThreadId,\n    13\t  runDrain,\n    14\t  type DrainDeps,\n    15\t  type DrainReport,\n    16\t  type Scheduler,\n    17\t} from \"./scheduler.js\";\n    18\timport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\n    19\timport {\n    20\t  PROVIDER_OPERATIONS,\n    21\t  type ResolvedSdkConfig,\n    22\t  type SdkConfig,\n    23\t  type WorkHandler,\n    24\t} from \"./shared/derivation.js\";\n    25\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n    26\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n    27\t\n    28\texport {\n    29\t  estimateTokens,\n    30\t  TOKEN_ESTIMATOR_ID,\n    31\t} from \"./tech-utils/token-counting/index.js\";\n    32\t\n    33\texport {\n    34\t  WORK_KIND_REGISTRY,\n    35\t  type WorkItemRecord,\n    36\t  type WorkKind,\n    37\t  type WorkOwner,\n    38\t  type WorkSourceRef,\n    39\t} from \"./tech-utils/work-queue/index.js\";\n    40\t\n    41\texport type {\n    42\t  ErrorClass,\n    43\t  ErrorCode,\n    44\t  ErrorResult,\n    45\t  OpResult,\n    46\t} from \"./shared/errors.js\";\n    47\texport {\n    48\t  runInTransaction,\n    49\t  setSchedulerPoke,\n    50\t  setThreadTouch,\n    51\t  type OperationContext,\n    52\t} from \"./shared/context.js\";\n    53\t\n    54\texport {\n    55\t  createDeterministicProvider,\n    56\t  deterministicOutcomesSuffix,\n    57\t  deterministicReceiptsSuffix,\n    58\t  deterministicText,\n    59\t  type DeterministicOpName,\n    60\t} from \"./providers/deterministic.js\";\n    61\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n    62\t\n    63\texport type {\n    64\t  CompletionTx,\n    65\t  DependencyGap,\n    66\t  DerivationProvider,\n    67\t  DerivedForm,\n    68\t  DerivedFormMetadata,\n    69\t  DerivedFormState,\n    70\t  FormKind,\n    71\t  FormReportEntry,\n    72\t  HandlerFormWrite,\n    73\t  HandlerOutcome,\n    74\t  HandlerRunContext,\n    75\t  ProviderResult,\n    76\t  RenderingPart,\n    77\t  ResolvedSdkConfig,\n    78\t  SdkConfig,\n    79\t  SubjectKind,\n    80\t  ToolOutcome,\n    81\t  ToolRunReceipt,\n    82\t  WorkHandler,\n    83\t} from \"./shared/derivation.js\";\n    84\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n    85\texport {\n    86\t  countLiveItems,\n    87\t  enqueue,\n    88\t  queueDetail,\n    89\t  supersedeQueued,\n    90\t  type ClaimedWorkItem,\n    91\t  type EnqueueFormTarget,\n    92\t  type EnqueueInput,\n    93\t  type QueueDetailRow,\n    94\t} from \"./tech-utils/work-queue/index.js\";\n    95\t\n    96\texport type { ThreadRef } from \"./domains/threads/index.js\";\n    97\texport type {\n    98\t  Block,\n    99\t  BlockType,\n   100\t  MessageRecord,\n   101\t  MutationResult,\n   102\t} from \"./domains/messages/index.js\";\n   103\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   104\texport type {\n   105\t  BatchResult,\n   106\t  EventKind,\n   107\t  EventRecord,\n   108\t  MessageEventInput,\n   109\t} from \"./domains/intake-stream/index.js\";\n   110\t\n   111\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   112\t\n   113\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   114\t\n   115\t// Merge per-domain handler tables into the one join between the queue's\n   116\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   117\t// (each kind has exactly one owner) and throws at construction.\n   118\texport function assembleWorkHandlerMap(\n   119\t  tables: ReadonlyArray<WorkHandlerMap>,\n   120\t): WorkHandlerMap {\n   121\t  const map: WorkHandlerMap = {};\n   122\t  for (const table of tables) {\n   123\t    for (const [kind, handler] of Object.entries(table)) {\n   124\t      if (map[kind as WorkKind] !== undefined) {\n   125\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   126\t      }\n   127\t      map[kind as WorkKind] = handler;\n   128\t    }\n   129\t  }\n   130\t  return map;\n   131\t}\n   132\t\n   133\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   134\t  return {\n   135\t    ok: false,\n   136\t    error: {\n   137\t      errorClass: \"state_corruption\",\n   138\t      code: \"unknown_work_kind\",\n   139\t      reason: `no handler registered for work kind \"${kind}\"`,\n   140\t    },\n   141\t  };\n   142\t}\n   143\t\n   144\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   145\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   146\texport function lookupWorkHandler(\n   147\t  map: WorkHandlerMap,\n   148\t  kind: string,\n   149\t): OpResult<WorkHandler> {\n   150\t  const handler = map[kind as WorkKind];\n   151\t  if (handler === undefined) return unknownWorkKind(kind);\n   152\t  return { ok: true, value: handler };\n   153\t}\n   154\t\n   155\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   156\t// requeue land in Story 4.\n   157\texport interface WorkSurface {\n   158\t  drain(\n   159\t    ref: threadsDomain.ThreadRef,\n   160\t    opts?: { maxItems?: number },\n   161\t  ): Promise<OpResult<DrainReport>>;\n   162\t}\n   163\t\n   164\texport interface Lhc {\n   165\t  threads: typeof threadsDomain;\n   166\t  intakeStream: typeof intakeStreamDomain;\n   167\t  messages: typeof messagesDomain;\n   168\t  turns: typeof turnsDomain;\n   169\t  config: ResolvedSdkConfig;\n   170\t  scheduler: Scheduler;\n   171\t  workHandlers: WorkHandlerMap;\n   172\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   173\t  work: WorkSurface;\n   174\t  // Resolves when the scheduler has no running or pending drain for the\n   175\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   176\t  // resolve in manual mode.\n   177\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   178\t}\n   179\t\n   180\tfunction requirePositive(value: number, name: string): void {\n   181\t  if (!Number.isFinite(value) || value <= 0) {\n   182\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   183\t  }\n   184\t}\n   185\t\n   186\tfunction requireNonNegative(value: number, name: string): void {\n   187\t  if (!Number.isFinite(value) || value < 0) {\n   188\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   189\t  }\n   190\t}\n   191\t\n   192\t// The only assembly path: provider, mode, clock, and policy enter here.\n   193\t// Config mistakes are programmer errors at construction and throw; operating\n   194\t// failures after construction return OpResults per the error contract.\n   195\texport function createSdk(config: SdkConfig): Lhc {\n   196\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   197\t    throw new TypeError(\n   198\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   199\t    );\n   200\t  }\n   201\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   202\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   203\t  }\n   204\t  for (const operation of PROVIDER_OPERATIONS) {\n   205\t    if (typeof config.provider[operation] !== \"function\") {\n   206\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   207\t    }\n   208\t  }\n   209\t\n   210\t  const resolved: ResolvedSdkConfig = {\n   211\t    provider: config.provider,\n   212\t    mode: config.mode,\n   213\t    clock: config.clock ?? (() => new Date()),\n   214\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   215\t    lease: config.lease ?? { durationMs: 120000 },\n   216\t    chunkPolicy:\n   217\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   218\t  };\n   219\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   220\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n","exit_code":0,"status":"completed"}}

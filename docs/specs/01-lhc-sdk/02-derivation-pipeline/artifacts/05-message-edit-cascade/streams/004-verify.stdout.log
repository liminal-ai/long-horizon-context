but no stdin; a missing reference\n   140\t// is a usage error named before any SDK call, matching the intake commands.\n   141\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n   142\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n   143\t    return renderCliError(\n   144\t      \"caller_error\",\n   145\t      \"missing_flag\",\n   146\t      `${command} requires --thread-id or --file-path`,\n   147\t    );\n   148\t  }\n   149\t  return undefined;\n   150\t}\n   151\t\n   152\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n   153\t  if (flags.threadId !== undefined) {\n   154\t    return flags.registryPath !== undefined\n   155\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n   156\t      : { threadId: flags.threadId };\n   157\t  }\n   158\t  return { filePath: flags.filePath ?? \"\" };\n   159\t}\n   160\t\n   161\texport async function runCli(\n   162\t  argv: readonly string[],\n   163\t  readStdin: StdinReader = readProcessStdin,\n   164\t): Promise<CliResult> {\n   165\t  if (argv.length === 0) {\n   166\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n   167\t  }\n   168\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n   169\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n   170\t  }\n   171\t\n   172\t  const [group, command, ...rest] = argv;\n   173\t  const key = command === undefined ? group : `${group} ${command}`;\n   174\t  const parsed = parseFlags(command === undefined ? [] : rest);\n   175\t  if (!parsed.ok) {\n   176\t    return renderCliError(\n   177\t      \"caller_error\",\n   178\t      \"unknown_flag\",\n   179\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n   180\t    );\n   181\t  }\n   182\t  const flags = parsed.flags;\n   183\t\n   184\t  switch (key) {\n   185\t    case \"threads new-thread\": {\n   186\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n   187\t      // instead of failing, so the adapter refuses before any SDK call.\n   188\t      if (flags.filePath === undefined) {\n   189\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n   190\t      }\n   191\t      const input: Parameters<typeof threads.newThread>[0] = {\n   192\t        filePath: flags.filePath,\n   193\t      };\n   194\t      if (flags.title !== undefined) input.title = flags.title;\n   195\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   196\t      return renderResult(await threads.newThread(input));\n   197\t    }\n   198\t    case \"threads resolve\": {\n   199\t      if (flags.threadId === undefined) {\n   200\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n   201\t      }\n   202\t      const input: Parameters<typeof threads.resolve>[0] = {\n   203\t        threadId: flags.threadId,\n   204\t      };\n   205\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   206\t      return renderResult(await threads.resolve(input));\n   207\t    }\n   208\t    case \"threads list\": {\n   209\t      return renderResult(\n   210\t        await threads.listThreads(\n   211\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n   212\t        ),\n   213\t      );\n   214\t    }\n   215\t    case \"intake-stream message-events\": {\n   216\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   217\t        return renderCliError(\n   218\t          \"caller_error\",\n   219\t          \"missing_flag\",\n   220\t          \"intake-stream message-events requires --thread-id or --file-path\",\n   221\t        );\n   222\t      }\n   223\t      const text = await readStdin();\n   224\t      if (text === null || text.trim() === \"\") {\n   225\t        
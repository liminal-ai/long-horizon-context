{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/index.ts | sed -n '1,360p'\"","aggregated_output":"     1\timport { parseArgs } from \"node:util\";\n     2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n     3\timport * as messages from \"../domains/messages/index.js\";\n     4\timport * as threads from \"../domains/threads/index.js\";\n     5\timport * as turns from \"../domains/turns/index.js\";\n     6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n     7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n     8\timport type { OpResult } from \"../shared/errors.js\";\n     9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n    10\timport { runMessagesEdit } from \"./messages-mutate.js\";\n    11\timport {\n    12\t  runMessagesReport,\n    13\t  runMessagesRequeue,\n    14\t  runTurnsReport,\n    15\t  runTurnsRequeue,\n    16\t  runWorkDrain,\n    17\t} from \"./work.js\";\n    18\t\n    19\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n    20\t// process stdin. null means interactive (TTY) — distinct from empty input\n    21\t// only in how it arises; both are refused with empty_stdin before any SDK\n    22\t// call (the SDK itself can never return that code).\n    23\texport type StdinReader = () => Promise<string | null>;\n    24\t\n    25\tasync function readProcessStdin(): Promise<string | null> {\n    26\t  if (process.stdin.isTTY) return null;\n    27\t  process.stdin.setEncoding(\"utf8\");\n    28\t  let data = \"\";\n    29\t  for await (const chunk of process.stdin) data += String(chunk);\n    30\t  return data;\n    31\t}\n    32\t\n    33\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n    34\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n    35\t}\n    36\t\n    37\tconst HELP = `lhc — Long Horizon Context CLI\n    38\t\n    39\tUsage:\n    40\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n    41\t  lhc threads resolve --thread-id <id> [--registry <r>]\n    42\t  lhc threads list [--registry <r>]\n    43\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    44\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    45\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    46\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    47\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n    48\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n    49\t  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n    50\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    51\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n    52\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    53\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n    54\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n    55\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n    56\t\n    57\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n    58\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n    59\t`;\n    60\t\n    61\tinterface ParsedFlags {\n    62\t  threadId?: string;\n    63\t  filePath?: string;\n    64\t  title?: string;\n    65\t  registryPath?: string;\n    66\t  maxItems?: string;\n    67\t  provider?: string;\n    68\t  notReady?: boolean;\n    69\t  messageId?: string;\n    70\t  turnId?: string;\n    71\t  chunkId?: string;\n    72\t  form?: string;\n    73\t  subjectKind?: string;\n    74\t  subjectId?: string;\n    75\t  content?: string;\n    76\t}\n    77\t\n    78\t// strict parse rejects unknown/misspelled flags so they are named back to the\n    79\t// caller, never silently dropped — the CLI boundary matching the SDK's\n    80\t// closed-contract strictness. The failure is returned as data (not thrown) so\n    81\t// runCli can render it as the structured usage error.\n    82\ttype ParseFlagsResult =\n    83\t  | { ok: true; flags: ParsedFlags }\n    84\t  | { ok: false; unknownFlag: string };\n    85\t\n    86\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n    87\t  let values;\n    88\t  try {\n    89\t    ({ values } = parseArgs({\n    90\t      args: [...args],\n    91\t      options: {\n    92\t        \"thread-id\": { type: \"string\" },\n    93\t        \"file-path\": { type: \"string\" },\n    94\t        title: { type: \"string\" },\n    95\t        registry: { type: \"string\" },\n    96\t        \"max-items\": { type: \"string\" },\n    97\t        provider: { type: \"string\" },\n    98\t        \"not-ready\": { type: \"boolean\" },\n    99\t        \"message-id\": { type: \"string\" },\n   100\t        \"turn-id\": { type: \"string\" },\n   101\t        \"chunk-id\": { type: \"string\" },\n   102\t        form: { type: \"string\" },\n   103\t        \"subject-kind\": { type: \"string\" },\n   104\t        \"subject-id\": { type: \"string\" },\n   105\t        // `--message` is the edit command's spelling (story/tech design);\n   106\t        // it parses into the same messageId slot as `--message-id`.\n   107\t        message: { type: \"string\" },\n   108\t        content: { type: \"string\" },\n   109\t      },\n   110\t      strict: true,\n   111\t      allo
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/forms.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n     2\t// source message and the call-id pairing reads — the only reach a\n     3\t// message-level handler has beyond its own message (AC-2.5). Also the\n     4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n     5\t// indexed query by call id, never a scan (the v5 expression index on\n     6\t// message_block covers it) and never a drain-time sweep or read-time join.\n     7\t// Completion writes for message forms ride the work-queue util's `complete`\n     8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n     9\t// Read-back of message-owned form rows (the listMessages join) also lives\n    10\t// here: stored state returned as stored — never re-derived on read.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport type {\n    13\t  DependencyGap,\n    14\t  DerivedForm,\n    15\t  DerivedFormMetadata,\n    16\t  DerivedFormState,\n    17\t  FormKind,\n    18\t  FormReportEntry,\n    19\t} from \"../../../shared/derivation.js\";\n    20\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n    21\t\n    22\texport interface MessageSource {\n    23\t  messageId: string;\n    24\t  kind: string;\n    25\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    26\t}\n    27\t\n    28\texport function readMessageSource(\n    29\t  db: DatabaseSync,\n    30\t  messageId: string,\n    31\t): MessageSource | undefined {\n    32\t  const row = db\n    33\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    34\t    .get(messageId) as unknown as { kind: string } | undefined;\n    35\t  if (row === undefined) return undefined;\n    36\t  const blocks = db\n    37\t    .prepare(\n    38\t      `SELECT block_type, content FROM message_block\n    39\t       WHERE message_id = ? ORDER BY block_index`,\n    40\t    )\n    41\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n    42\t  return {\n    43\t    messageId,\n    44\t    kind: row.kind,\n    45\t    blocks: blocks.map((block) => ({\n    46\t      blockType: block.block_type,\n    47\t      content: JSON.parse(block.content) as Record<string, unknown>,\n    48\t    })),\n    49\t  };\n    50\t}\n    51\t\n    52\tinterface RawFormRow {\n    53\t  subject_id: string;\n    54\t  form: string;\n    55\t  state: string;\n    56\t  content: string | null;\n    57\t  reason: string | null;\n    58\t  metadata: string | null;\n    59\t  source_version: number | bigint;\n    60\t  gaps: string | null;\n    61\t  derived_at: string | null;\n    62\t}\n    63\t\n    64\t// Every message-owned derived-form row, grouped by message id — the form\n    65\t// read-back joined onto message reads (AC-2.1's \"readable alongside the\n    66\t// message\"). Rows come back exactly as the queue landed them: state, content,\n    67\t// reason, mechanically stamped metadata; nothing is derived at read time.\n    68\texport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n    69\t  const rows = db\n    70\t    .prepare(\n    71\t      `SELECT subject_id, form, state, content, reason, metadata,\n    72\t              source_version, gaps, derived_at\n    73\t       FROM derived_form WHERE subject_kind = 'message'\n    74\t       ORDER BY subject_id, form`,\n    75\t    )\n    76\t    .all() as unknown as RawFormRow[];\n    77\t  const byMessage = new Map<string, DerivedForm[]>();\n    78\t  for (const row of rows) {\n    79\t    const record: DerivedForm = {\n    80\t      subjectKind: \"message\",\n    81\t      subjectId: row.subject_id,\n    82\t      form: row.form as FormKind,\n    83\t      state: row.state as DerivedFormState,\n    84\t      sourceVersion: Number(row.source_version),\n    85\t    };\n    86\t    if (row.content !== null) record.content = row.content;\n    87\t    if (row.reason !== null) record.reason = row.reason;\n    88\t    if (row.metadata !== null) {\n    89\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    90\t    }\n    91\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    92\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    93\t    const forms = byMessage.get(row.subject_id) ?? [];\n    94\t    forms.push(record);\n    95\t    byMessage.set(row.subject_id, forms);\n    96\t  }\n    97\t  return byMessage;\n    98\t}\n    99\t\n   100\t// One form row by exact key — the requeue operation's refusal read (missing\n   101\t// row, blocked state, current source version). State returned as stored.\n   102\texport function readMessageFormRow(\n   103\t  db: DatabaseSync,\n   104\t  messageId: string,\n   105\t  form: FormKind,\n   106\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n   107\t  const row = db\n   108\t    .prepare(\n   109\t      `SELECT state, reason, source_version FROM derived_form\n   110\t       WHERE subject_kind = 'message' AND subject_id = ? AND form = ?`,\n   111\t    )\n   112\t    .get(messageId, form) as unknown as\n   113\t    | { state: string; reason: string | null; source_version: number | bigint }\n   114\t    | undefined;\n   115\t  if (row === undefined) return undefined;\n   116\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n   117\t    state: row.state as DerivedFormState,\n   118\t    sourceVersion: Number(row.source_version),\n   119\t  };\n   120\t  if (row.reason !== null) view.reason = row.reason;\n   121\t  return view;\n   122\t}\n   123\t\n   124\t// The message owner's report (Flow 4): one query — message-owned form rows\n   125\t// LEFT JOINed with the live work_item still targeting each form at its\n   126\t// current source version, if any (DD-1: only live rows exist; terminal\n   127\t// outcomes already live on the form). No N+1, no in-memory assembly beyond\n   128\t// row mapping. The form→kind CASE is the owner's own queue-site mapping\n   129\t// (MESSAGE_WORK_FORMS) inverted.\n   130\texport function reportMessageForms(\n   131\t  db: DatabaseSync,\n   132\t  opts: { notReady?: boolean; messageId?: string } = {},\n   133\t): FormReportEntry[] {\n   134\t  const conditions = [\"df.subject_kind = 'message'\"];\n   135\t  const params: string[] = [];\n   136\t  if (opts.messageId !== undefined) {\n   137\t    conditions.push(\"df.subject_id = ?\");\n   138\t    params.push(opts.messageId);\n   139\t  }\n   140\t  // notReady is exact set equality by construction: every state but ready.\n   141\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   142\t  const rows = db\n   143\t    .prepare(\n   144\t      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\n   145\t              df.source_version, df.gaps, df.derived_at,\n   146\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   147\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   148\t       FROM derived_form df\n   149\t       LEFT JOIN work_item w\n   150\t         ON w.status IN ('queued', 'claimed')\n   151\t        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\n   152\t        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n   153\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   154\t       WHERE ${conditions.join(\" AND \")}\n   155\t       ORDER BY df.subject_id, df.form`,\n   156\t    )\n   157\t    .all(...params) as unknown as RawReportRow[];\n   158\t  return rows.map((row) => reportEntryFromRow(\"message\", row));\n   159\t}\n   160\t\n   161\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n   162\t// ever repeated; in a well-formed record the pair is unique.\n   163\tfunction findPairedBlock(\n   164\t  db: DatabaseSync,\n   165\t  blockType: \"tool_call\" | \"tool_result\",\n   166\t  toolCallId: string,\n   167\t): Record<string, unknown> | undefined {\n   168\t  const row = db\n   169\t    .prepare(\n   170\t      `SELECT b.content FROM message_block b\n   171\t       JOIN message m ON m.message_id = b.message_id\n   172\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n   173\t       ORDER BY m.source_event_order LIMIT 1`,\n   174\t    )\n   175\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n   176\t  if (row === undefined) return undefined;\n   177\t  return JSON.parse(row.content) as Record<string, unknown>;\n   178\t}\n   179\t\n   180\texport function findPairedToolResult(\n   181\t  db: DatabaseSync,\n   182\t  toolCallId: string,\n   183\t): { content: string; isError: boolean } | undefined {\n   184\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n   185\t  if (block === undefined) return undefined;\n   186\t  return {\n   187\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n   188\t    isError: block[\"isError\"] === true,\n   189\t  };\n   190\t}\n   191\t\n   192\texport function findPairedToolCall(\n   193\t  db: DatabaseSync,\n   194\t  toolCallId: string,\n   195\t): { toolName: string } | undefined {\n   196\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n   197\t  if (block === undefined) return undefined;\n   198\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n   199\t}\n   200\t\n   201\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n   202\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n   203\t// common case — call and result in one batch, summary not yet run — never\n   204\t// triggers a requeue. Returns the call's message id and the form's current\n   205\t// source version (the requeue enqueues at version + 1: the pair is the\n   206\t// summary's source, and a source completing follows clear-and-regenerate).\n   207\texport function findUnknownOutcomeCallSummary(\n   208\t  db: DatabaseSync,\n   209\t  toolCallId: string,\n   210\t): { messageId: string; sourceVersion: number } | undefined {\n   211\t  const row = db\n   212\t    .prepare(\n   213\t      `SELECT df.subject_id, df.source_version FROM message_block b\n   214\t       JOIN derived_form df ON df.subject_kind = 'message'\n   215\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n   216\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n   217\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n   218\t       LIMIT 1`,\n   219\t    )\n   220\t    .get(toolCallId) as unknown as\n   221\t    | { subject_id: string; source_version: number | bigint }\n   222\t    | undefined;\n   223\t  if (row === undefined) return undefined;\n   224\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n   225\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n     2\t// wrapper that makes \"queueing is what schedules processing\" structural\n     3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n     4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n     5\t// a turn or a summary is; which kinds queue for which sources, and which\n     6\t// derived forms a kind produces, is the owning domains' business (callers\n     7\t// pass the form targets in). Writes run on the caller's handle inside the\n     8\t// ambient transaction, so items commit (or roll back) with the batch. No\n     9\t// public SDK surface: read-back reaches here only through the owning\n    10\t// domains' listQueuedWork.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport {\n    13\t  createCommitHooks,\n    14\t  fireSchedulerPoke,\n    15\t  type OperationContext,\n    16\t} from \"../../shared/context.js\";\n    17\timport type {\n    18\t  CompletionTx,\n    19\t  FormKind,\n    20\t  HandlerFormWrite,\n    21\t  SubjectKind,\n    22\t} from \"../../shared/derivation.js\";\n    23\t\n    24\texport type WorkOwner = \"messages\" | \"turns\";\n    25\texport type WorkKind =\n    26\t  | \"prompt_smoothing\"\n    27\t  | \"tool_call_summary\"\n    28\t  | \"tool_result_summary\"\n    29\t  | \"turn_derivation\"\n    30\t  | \"chunk_summary_detailed\"\n    31\t  | \"chunk_summary_brief\";\n    32\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n    33\t\n    34\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n    35\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n    36\t// the owning domain's handler (registered at SDK construction, DD-6).\n    37\texport const WORK_KIND_REGISTRY: Readonly<\n    38\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n    39\t> = {\n    40\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    41\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    42\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    43\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n    44\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    45\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    46\t};\n    47\t\n    48\texport interface WorkItemRecord {\n    49\t  workItemId: string;\n    50\t  owner: WorkOwner;\n    51\t  kind: WorkKind;\n    52\t  sourceRef: WorkSourceRef;\n    53\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n    54\t  queuedAt: string;\n    55\t}\n    56\t\n    57\t// The derived forms an enqueue is scheduling work toward; the owning domain\n    58\t// names them (the util stays meaning-blind). Stored in the row's payload so\n    59\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n    60\t// form's failed/blocked state without asking any domain what a kind means.\n    61\texport interface EnqueueFormTarget {\n    62\t  subjectKind: SubjectKind;\n    63\t  subjectId: string;\n    64\t  form: FormKind;\n    65\t}\n    66\t\n    67\texport interface WorkItemInput {\n    68\t  owner: WorkOwner;\n    69\t  kind: WorkKind;\n    70\t  sourceRef: WorkSourceRef;\n    71\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n    72\t  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n    73\t}\n    74\t\n    75\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n    76\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n    77\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n    78\t  return sourceRef.chunkId;\n    79\t}\n    80\t\n    81\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n    82\t// same kind for the same source *at the same version* is the same id —\n    83\t// natural idempotency for the repair path — while a post-mutation\n    84\t// replacement (next version) never collides with an in-flight pre-mutation\n    85\t// item.\n    86\texport function recordItem(\n    87\t  db: DatabaseSync,\n    88\t  input: WorkItemInput,\n    89\t  queuedAt: string,\n    90\t): WorkItemRecord {\n    91\t  const sourceVersion = input.sourceVersion ?? 1;\n    92\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n    93\t  db.prepare(\n    94\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n    95\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n    96\t  ).run(\n    97\t    workItemId,\n    98\t    input.owner,\n    99\t    input.kind,\n   100\t    JSON.stringify(input.sourceRef),\n   101\t    queuedAt,\n   102\t    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n   103\t  );\n   104\t  return {\n   105\t    workItemId,\n   106\t    owner: input.owner,\n   107\t    kind: input.kind,\n   108\t    sourceRef: input.sourceRef,\n   109\t    status: \"queued\",\n   110\t    queuedAt,\n   111\t  };\n   112\t}\n   113\t\n   114\texport interface EnqueueInput extends WorkItemInput {\n   115\t  forms: readonly EnqueueFormTarget[];\n   116\t}\n   117\t\n   118\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n   119\t// state row, and the scheduler poke all ride the ambient transaction — they\n   120\t// commit together or vanish together. Enqueue is the *only* place a\n   121\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n   122\t// resets an existing row to pending at the enqueued source version.\n   123\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n   124\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n   125\t  const sourceVersion = input.sourceVersion ?? 1;\n   126\t  const upsert = ctx.db.prepare(\n   127\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n   128\t     VALUES (?, ?, ?, 'pending', ?)\n   129\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n   130\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n   131\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n   132\t  );\n   133\t  for (const target of input.forms) {\n   134\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n   135\t  }\n   136\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n   137\t  return item;\n   138\t}\n   139\t\n   140\tinterface RawWorkItemRow {\n   141\t  work_item_id: string;\n   142\t  owner: string;\n   143\t  kind: string;\n   144\t  source_ref: string;\n   145\t  queued_at: string;\n   146\t}\n   147\t\n   148\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n   149\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n   150\t// complete, and the terminal half of failAttempt each own one short\n   151\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n   152\t\n   153\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n   154\t// source version and form targets. `kind` is a plain string here — a raw row\n   155\t// with an unregistered kind must still be claimable so the drain can land it\n   156\t// failed_terminal instead of skipping it (AC-1.8).\n   157\texport interface ClaimedWorkItem {\n   158\t  workItemId: string;\n   159\t  owner: WorkOwner;\n   160\t  kind: string;\n   161\t  sourceRef: WorkSourceRef;\n   162\t  attempts: number;\n   163\t  queuedAt: string;\n   164\t  sourceVersion: number;\n   165\t  forms: EnqueueFormTarget[];\n   166\t}\n   167\t\n   168\texport type ClaimOutcome =\n   169\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n   170\t  | { outcome: \"empty\" }\n   171\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n   172\t  | { outcome: \"waiting\"; waitingUntil: string };\n   173\t\n   174\tinterface RawClaimRow {\n   175\t  work_item_id: string;\n   176\t  owner: string;\n   177\t  kind: string;\n   178\t  source_ref: string;\n   179\t  attempts: number | bigint;\n   180\t  queued_at: string;\n   181\t  payload: string | null;\n   182\t}\n   183\t\n   184\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n   185\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n   186\t// v5, shared/storage.ts): the backfill created pending derived_form rows at\n   187\t// source version 1 for these kinds, and a terminal failure must find them —\n   188\t// otherwise exhaustion would delete the work row and strand the backfilled\n   189\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n   190\tconst LEGACY_KIND_FORMS: Partial<\n   191\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n   192\t> = {\n   193\t  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n   194\t  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n   195\t  turn_derivation: [\n   196\t    { subjectKind: \"turn\", form: \"turn_rendering\" },\n   197\t    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n   198\t  ],\n   199\t};\n   200\t\n   201\tfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n   202\t  const mapped = LEGACY_KIND_FORMS[kind];\n   203\t  if (mapped === undefined) return [];\n   204\t  const subjectId = sourceIdOf(sourceRef);\n   205\t  return mapped.map((target) => ({ ...target, subjectId }));\n   206\t}\n   207\t\n   208\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n   209\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n   210\t  const payload =\n   211\t    row.payload === null\n   212\t      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n   213\t        // reconstructed from the backfill's own mapping.\n   214\t        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n   215\t      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n   216\t  return {\n   217\t    workItemId: row.work_item_id,\n   218\t    owner: row.owner as WorkOwner,\n   219\t    kind: row.kind,\n   220\t    sourceRef,\n   221\t    attempts: Number(row.attempts),\n   222\t    queuedAt: row.queued_at,\n   223\t    sourceVersion: payload.sourceVersion ?? 1,\n   224\t    forms: payload.forms ?? [],\n   225\t  };\n   226\t}\n   227\t\n   228\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n   229\t// live row only — a later eligible row is never considered while an older\n   230\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n   231\t// write split: the race window is the bug class). The CASE increments\n   232\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n   233\t// run died or hung, and the increment makes the crash visible in the report\n   234\t// and counts it against the retry budget; normal claims never touch it.\n   235\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n   236\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n   237\t  db.exec(\"BEGIN IMMEDIATE;\");\n   238\t  try {\n   239\t    const claimed = db\n   240\t      .prepare(\n   241\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n   242\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n   243\t         WHERE work_item_id = (\n   244\t           SELECT work_item_id FROM (\n   245\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n   246\t             FROM work_item WHERE status IN ('queued', 'claimed')\n   247\t             ORDER BY rowid LIMIT 1\n   248\t           )\n   249\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n   250\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n   251\t         )\n   252\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n   253\t      )\n   254\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n   255\t    if (claimed !== undefined) {\n   256\t      db.exec(\"COMMIT;\");\n   257\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n   258\t    }\n   259\t    // No row claimable: re-read the head inside the same transaction to\n   260\t    // classify the stop. A claimed head with a live lease gates the queue\n   261\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n   262\t    // (waiting) — strict ordering, never reordered around the head.\n   263\t    const head = db\n   264\t      .prepare(\n   265\t        `SELECT status, eligible_at, claim_expires_at\n   266\t         FROM work_item WHERE status IN ('queued', 'claimed')\n   267\t         ORDER BY rowid LIMIT 1`,\n   268\t      )\n   269\t      .get() as unknown as\n   270\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n   271\t      | undefined;\n   272\t    db.exec(\"COMMIT;\");\n   273\t    if (head === undefined) return { outcome: \"empty\" };\n   274\t    if (head.status === \"claimed\") {\n   275\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n   276\t    }\n   277\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n   278\t  } catch (cause) {\n   279\t    db.exec(\"ROLLBACK;\");\n   280\t    throw cause;\n   281\t  }\n   282\t}\n   283\t\n   284\t// Completion: the version-checked form writes and the item row's deletion in\n   285\t// one short transaction (DD-1: terminal transition deletes the row; the\n   286\t// disposition is reported in-memory, never stored). UPDATE-only, never\n   287\t// upsert — the pending row exists from enqueue; a write that finds no row at\n   288\t// the item's source version is discarded as stale (DD-3 truth table). The\n   289\t// optional onApplied hook (Story 3) runs inside this same transaction, after\n   290\t// the form writes and only when they landed — chunk placement and the\n   291\t// close→summary enqueues ride the completion commit; its onCommit\n   292\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\n   293\texport function complete(\n   294\t  db: DatabaseSync,\n   295\t  item: ClaimedWorkItem,\n   296\t  writes: readonly HandlerFormWrite[],\n   297\t  derivedAt: string,\n   298\t  onApplied?: (tx: CompletionTx) => void,\n   299\t): \"done\" | \"stale_discarded\" {\n   300\t  const hooks = createCommitHooks();\n   301\t  db.exec(\"BEGIN IMMEDIATE;\");\n   302\t  try {\n   303\t    let hits = 0;\n   304\t    const update = db.prepare(\n   305\t      `UPDATE derived_form\n   306\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n   307\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   308\t    );\n   309\t    for (const write of writes) {\n   310\t      const changed = update.run(\n   311\t        write.content,\n   312\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n   313\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n   314\t        derivedAt,\n   315\t        write.subjectKind,\n   316\t        write.subjectId,\n   317\t        write.form,\n   318\t        item.sourceVersion,\n   319\t      );\n   320\t      hits += Number(changed.changes);\n   321\t    }\n   322\t    const stale = writes.length > 0 && hits === 0;\n   323\t    if (!stale && onApplied !== undefined) {\n   324\t      onApplied({ db, onCommit: hooks.register });\n   325\t    }\n   326\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   327\t    db.exec(\"COMMIT;\");\n   328\t    hooks.flush();\n   329\t    return stale ? \"stale_discarded\" : \"done\";\n   330\t  } catch (cause) {\n   331\t    db.exec(\"ROLLBACK;\");\n   332\t    throw cause;\n   333\t  }\n   334\t}\n   335\t\n   336\texport interface RetryPolicy {\n   337\t  budget: number;\n   338\t  backoffBaseMs: number;\n   339\t  backoffCapMs: number;\n   340\t}\n   341\t\n   342\texport type FailAttemptResult =\n   343\t  | { terminal: false; attempts: number; eligibleAt: string }\n   344\t  | { terminal: true; attempts: number };\n   345\t\n   346\t// Terminal failure: the form rows land `failed` (or `blocked` for source\n   347\t// damage) carrying the final reason plus attempts/last-error copied onto the\n   348\t// form's metadata, and the item row is deleted — one transaction (DD-1).\n   349\t// Form writes stay version-checked: if a mutation moved the source since this\n   350\t// item was queued, the stale failure must not stamp the rebuilt form.\n   351\texport function failTerminal(\n   352\t  db: DatabaseSync,\n   353\t  item: ClaimedWorkItem,\n   354\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n   355\t): void {\n   356\t  db.exec(\"BEGIN IMMEDIATE;\");\n   357\t  try {\n   358\t    const update = db.prepare(\n   359\t      `UPDATE derived_form\n   360\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/render.ts | sed -n '1,220p'\"","aggregated_output":"     1\timport type { ErrorClass, OpResult } from \"../shared/errors.js\";\n     2\t\n     3\texport interface CliResult {\n     4\t  exitCode: number;\n     5\t  stdout: string;\n     6\t  stderr: string;\n     7\t}\n     8\t\n     9\t// Adapter-level failures (unknown command, missing command) happen before any\n    10\t// SDK call, so they carry adapter codes outside the SDK's ErrorCode set while\n    11\t// keeping the same structural shape.\n    12\texport type CliErrorCode = \"unknown_command\" | \"missing_flag\" | \"unknown_flag\";\n    13\t\n    14\texport function renderResult(result: OpResult<unknown>): CliResult {\n    15\t  return {\n    16\t    exitCode: result.ok ? 0 : 1,\n    17\t    stdout: `${JSON.stringify(result, null, 2)}\\n`,\n    18\t    stderr: \"\",\n    19\t  };\n    20\t}\n    21\t\n    22\texport function renderCliError(\n    23\t  errorClass: ErrorClass,\n    24\t  code: CliErrorCode,\n    25\t  reason: string,\n    26\t): CliResult {\n    27\t  return {\n    28\t    exitCode: 1,\n    29\t    stdout: `${JSON.stringify({ ok: false, error: { errorClass, code, reason } }, null, 2)}\\n`,\n    30\t    stderr: \"\",\n    31\t  };\n    32\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/errors.ts | sed -n '1,220p'\"","aggregated_output":"     1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n     2\t\n     3\texport type ErrorCode =\n     4\t  | \"path_exists\"\n     5\t  | \"thread_not_found\"\n     6\t  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n     7\t  | \"invalid_event\"\n     8\t  | \"empty_batch\"\n     9\t  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n    10\t  | \"turn_state_corrupt\"\n    11\t  | \"storage_failure\"\n    12\t  // Epic 02 (tech design §Interfaces, issue 4):\n    13\t  | \"turn_open\" // caller_error — mutation against an open turn\n    14\t  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n    15\t  | \"message_not_found\" // caller_error\n    16\t  | \"turn_not_found\" // caller_error\n    17\t  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n    18\t  | \"provider_not_configured\" // caller_error — CLI drain without --provider / LHC_PROVIDER (DD-11)\n    19\t  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n    20\t  | \"source_damaged\"; // state_corruption — handler found corrupt source; form blocked\n    21\t\n    22\texport interface ErrorResult {\n    23\t  errorClass: ErrorClass;\n    24\t  code: ErrorCode;\n    25\t  reason: string; // human-readable; machine logic switches on code\n    26\t  eventIndex?: number; // present on batch validation failures\n    27\t}\n    28\t\n    29\t// Expected operational failures — caller errors, corruption, environment\n    30\t// failures — are always returned as OpResult errors, never thrown.\n    31\t// Programmer bugs inside lhc may still throw; callers are not expected\n    32\t// to handle throws as contract outcomes.\n    33\texport type OpResult<T> =\n    34\t  | { ok: true; value: T }\n    35\t  | { ok: false; error: ErrorResult };\n    36\t\n    37\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n    38\t// caught at the operation boundary and wrapped with the underlying detail.\n    39\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n    40\t  return {\n    41\t    ok: false,\n    42\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n    43\t  };\n    44\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/mutations.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 5 (Epic 02): messages.edit and the mutation cascade — Flow 5's edit\n     2\t// half. One synchronous transaction carries the content change, the token\n     3\t// re-stamp, and the full dependent-chain clear-and-requeue (TC-5.1), with\n     4\t// induced-failure atomicity proving a failing cascade step rolls back the\n     5\t// content change too (architecture risk). Cascade reach is proven in both\n     6\t// directions — exactly the chain cleared, everything outside it byte-stable\n     7\t// including source versions (TC-5.2, architecture risk). Post-return no\n     8\t// pre-edit derivation is ready and replacements sit queued at the new source\n     9\t// version, with superseded queued ids reported and their rows gone (TC-5.3).\n    10\t// TC-5.4 is the epic's named architecture-risk test: a claimed pre-edit item\n    11\t// held across the edit by the delayed double completes after the post-edit\n    12\t// rebuild is queued, discards on the source-version mismatch as\n    13\t// stale_discarded, and the post-edit artifact stands. Refusals (open turn,\n    14\t// missing id, deleted target through the filtered view) change nothing\n    15\t// (TC-5.5). The CLI parity leg of TC-5.6 lives in\n    16\t// cli-process-mutations.test.ts (process suite).\n    17\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    18\timport {\n    19\t  createSdk,\n    20\t  deterministicText,\n    21\t  estimateTokens,\n    22\t  messages,\n    23\t  queueDetail,\n    24\t  setSchedulerPoke,\n    25\t  setThreadTouch,\n    26\t  threads,\n    27\t  type DerivationProvider,\n    28\t  type DrainReport,\n    29\t  type Lhc,\n    30\t  type MessageEventInput,\n    31\t  type MutationResult,\n    32\t  type OpResult,\n    33\t  type SdkConfig,\n    34\t} from \"../src/index.js\";\n    35\timport {\n    36\t  createProviderDouble,\n    37\t  openRaw,\n    38\t  readDerivedForms,\n    39\t  tempStore,\n    40\t  validEvent,\n    41\t  type TempStore,\n    42\t} from \"./fixtures/index.js\";\n    43\t\n    44\tlet store: TempStore;\n    45\tbeforeEach(() => {\n    46\t  store = tempStore();\n    47\t});\n    48\tafterEach(() => {\n    49\t  store.cleanup();\n    50\t  setSchedulerPoke(null);\n    51\t  setThreadTouch(null);\n    52\t});\n    53\t\n    54\tasync function newThread(): Promise<string> {\n    55\t  const created = await threads.newThread({\n    56\t    filePath: store.threadPath(),\n    57\t    registryPath: store.registryPath,\n    58\t  });\n    59\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n    60\t  return created.value.filePath;\n    61\t}\n    62\t\n    63\tfunction manualSdk(\n    64\t  provider: DerivationProvider,\n    65\t  overrides: Partial<Pick<SdkConfig, \"chunkPolicy\" | \"clock\" | \"mode\">> = {},\n    66\t): Lhc {\n    67\t  const config: SdkConfig = {\n    68\t    provider,\n    69\t    mode: overrides.mode ?? \"manual\",\n    70\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    71\t    lease: { durationMs: 5000 },\n    72\t  };\n    73\t  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\n    74\t  if (overrides.clock !== undefined) config.clock = overrides.clock;\n    75\t  return createSdk(config);\n    76\t}\n    77\t\n    78\tasync function send(\n    79\t  sdk: Lhc,\n    80\t  filePath: string,\n    81\t  batch: readonly MessageEventInput[],\n    82\t): Promise<void> {\n    83\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    84\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n    85\t}\n    86\t\n    87\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n    88\t  const result = await sdk.work.drain({ filePath });\n    89\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n    90\t  return result.value;\n    91\t}\n    92\t\n    93\tfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n    94\t  const db = openRaw(filePath);\n    95\t  try {\n    96\t    return queueDetail(db);\n    97\t  } finally {\n    98\t    db.close();\n    99\t  }\n   100\t}\n   101\t\n   102\tfunction clearKey(entry: { subjectKind: string; subjectId: string; form: string }): string {\n   103\t  return `${entry.subjectKind}/${entry.subjectId}/${entry.form}`;\n   104\t}\n   105\t\n   106\tfunction unwrap<T>(result: OpResult<T>): T {\n   107\t  if (!result.ok) throw new Error(`expected ok result, got ${result.error.code}`);\n   108\t  return result.value;\n   109\t}\n   110\t\n   111\t// One closed prompt+answer turn (m1 prompt, t1), drained ready. Under the\n   112\t// default chunk policy t1's chunk stays open, so no chunk summary rows exist.\n   113\tasync function readyTurnThread(sdk: Lhc): Promise<string> {\n   114\t  const filePath = await newThread();\n   115\t  await send(sdk, filePath, [\n   116\t    validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n   117\t    validEvent(\"assistant_text\", { payload: { text: \"the original answer\" } }),\n   118\t    validEvent(\"turn_end\"),\n   119\t  ]);\n   120\t  await drain(sdk, filePath);\n   121\t  return filePath;\n   122\t}\n   123\t\n   124\t// The full mutation read-back surface in one snapshot: record, forms, queue.\n   125\tasync function snapshot(filePath: string): Promise<unknown> {\n   126\t  return {\n   127\t    messages: unwrap(await messages.listMessages({ filePath })),\n   128\t    forms: readDerivedForms(filePath),\n   129\t    queue: rawDetail(filePath),\n   130\t  };\n   131\t}\n   132\t\n   133\tasync function until(cond: () => boolean, what: string, timeoutMs = 5000): Promise<void> {\n   134\t  const start = Date.now();\n   135\t  while (!cond()) {\n   136\t    if (Date.now() - start > timeoutMs) throw new Error(`timed out waiting for ${what}`);\n   137\t    await new Promise((resolve) => setTimeout(resolve, 5));\n   138\t  }\n   139\t}\n   140\t\n   141\tdescribe(\"TC-5.1 / AC-5.1: edit updates content, blocks, and estimate synchronously, reporting the cascade\", () => {\n   142\t  it(\"changes the record in the edit's transaction and names cleared forms and queued items\", async () => {\n   143\t    const double = createProviderDouble();\n   144\t    const sdk = manualSdk(double);\n   145\t    const filePath = await readyTurnThread(sdk);\n   146\t\n   147\t    const result = await messages.edit(\n   148\t      { filePath },\n   149\t      { messageId: \"m1\", content: \"edited prompt\" },\n   150\t    );\n   151\t    expect(result.ok).toBe(true);\n   152\t    if (!result.ok) return;\n   153\t    expect(result.value.changed).toEqual({ messageIds: [\"m1\"], turnIds: [] });\n   154\t    expect(result.value.dropped).toEqual([]);\n   155\t    // The chain above m1: its own smoothing and t1's two forms. t1's chunk is\n   156\t    // still open — no summary rows exist, so none are named.\n   157\t    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n   158\t      [\n   159\t        \"message/m1/smoothed_prompt\",\n   160\t        \"turn/t1/lower_band_projection\",\n   161\t        \"turn/t1/turn_rendering\",\n   162\t      ].sort(),\n   163\t    );\n   164\t    expect([...result.value.queued].sort((a, b) => a.workItemId.localeCompare(b.workItemId)))\n   165\t      .toEqual([\n   166\t        { workItemId: \"w-m1-prompt_smoothing-v2\", kind: \"prompt_smoothing\" },\n   167\t        { workItemId: \"w-t1-turn_derivation-v2\", kind: \"turn_derivation\" },\n   168\t      ]);\n   169\t    expect(result.value.superseded).toEqual([]);\n   170\t\n   171\t    // Synchronous, before any drain: content, blocks, and the re-stamped\n   172\t    // estimate read back changed.\n   173\t    const m1 = unwrap(await messages.listMessages({ filePath })).find(\n   174\t      (record) => record.messageId === \"m1\",\n   175\t    );\n   176\t    expect(m1?.blocks).toEqual([{ blockType: \"text\", content: { text: \"edited prompt\" } }]);\n   177\t    expect(m1?.tokenEstimate).toBe(estimateTokens(\"edited prompt\"));\n   178\t\n   179\t    // The queued rebuilds run through the normal drain and derive from the\n   180\t    // edited content.\n   181\t    await drain(sdk, filePath);\n   182\t    const smoothing = readDerivedForms(filePath).find(\n   183\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n   184\t    );\n   185\t    expect(smoothing?.state).toBe(\"ready\");\n   186\t    expect(smoothing?.content).toBe(\n   187\t      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n   188\t    );\n   189\t  });\n   190\t\n   191\t  it(\"induced cascade failure rolls back the content change too (atomicity, architecture risk)\", async () => {\n   192\t    const double = createProviderDouble();\n   193\t    const sdk = manualSdk(double);\n   194\t    const filePath = await readyTurnThread(sdk);\n   195\t\n   196\t    // Plant a claimed row at the exact id the cascade's replacement enqueue\n   197\t    // will insert. Supersede only deletes queued rows, so the insert hits a\n   198\t    // primary-key conflict mid-cascade — after the content apply — and the\n   199\t    // transaction must roll back whole.\n   200\t    const db = openRaw(filePath);\n   201\t    db.prepare(\n   202\t      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n   203\t       VALUES (?, 'messages', 'prompt_smoothing', ?, 'claimed', ?, ?)`,\n   204\t    ).run(\n   205\t      \"w-m1-prompt_smoothing-v2\",\n   206\t      JSON.stringify({ messageId: \"m1\" }),\n   207\t      \"2026-06-11T00:00:00.000Z\",\n   208\t      JSON.stringify({ sourceVersion: 2, forms: [] }),\n   209\t    );\n   210\t    db.close();\n   211\t\n   212\t    const before = await snapshot(filePath);\n   213\t    const result = await messages.edit(\n   214\t      { filePath },\n   215\t      { messageId: \"m1\", content: \"edited prompt\" },\n   216\t    );\n   217\t    expect(result.ok).toBe(false);\n   218\t    if (result.ok) return;\n   219\t    expect(result.error.code).toBe(\"storage_failure\");\n   220\t    // Nothing changed: not the message content, not the estimate, not a\n   221\t    // single form state or source version, not the queue.\n   222\t    expect(await snapshot(filePath)).toEqual(before);\n   223\t  });\n   224\t});\n   225\t\n   226\tdescribe(\"TC-5.2 / AC-5.2 (architecture risk): cascade reach is exact in both directions\", () => {\n   227\t  it(\"clears exactly the edited message's chain; the second chunk's forms are byte-stable\", async () => {\n   228\t    const double = createProviderDouble();\n   229\t    // max=1: every turn's projection meets the maximum, so each turn forms\n   230\t    // its own immediately closed chunk — two chunks, both with summaries.\n   231\t    const sdk = manualSdk(double, {\n   232\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n   233\t    });\n   234\t    const filePath = await newThread();\n   235\t    await send(sdk, filePath, [\n   236\t      validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n   237\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n   238\t      validEvent(\"turn_end\"),\n   239\t    ]);\n   240\t    await send(sdk, filePath, [\n   241\t      validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n   242\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n   243\t      validEvent(\"turn_end\"),\n   244\t    ]);\n   245\t    await drain(sdk, filePath);\n   246\t\n   247\t    const before = readDerivedForms(filePath);\n   248\t    // Fixture sanity: both chunks closed with every form ready.\n   249\t    expect(before.map((form) => clearKey(form)).sort()).toEqual(\n   250\t      [\n   251\t        \"message/m1/smoothed_prompt\",\n   252\t        \"message/m4/smoothed_prompt\",\n   253\t        \"turn/t1/lower_band_projection\",\n   254\t        \"turn/t1/turn_rendering\",\n   255\t        \"turn/t2/lower_band_projection\",\n   256\t        \"turn/t2/turn_rendering\",\n   257\t        \"chunk/c1/chunk_summary_brief\",\n   258\t        \"chunk/c1/chunk_summary_detailed\",\n   259\t        \"chunk/c2/chunk_summary_brief\",\n   260\t        \"chunk/c2/chunk_summary_detailed\",\n   261\t      ].sort(),\n   262\t    );\n   263\t    expect(before.every((form) => form.state === \"ready\")).toBe(true);\n   264\t\n   265\t    const result = await messages.edit(\n   266\t      { filePath },\n   267\t      { messageId: \"m1\", content: \"rewritten first prompt\" },\n   268\t    );\n   269\t    expect(result.ok).toBe(true);\n   270\t    if (!result.ok) return;\n   271\t\n   272\t    // The cleared set is exactly the chain: m1's forms, t1's two, c1's two.\n   273\t    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n   274\t      [\n   275\t        \"message/m1/smoothed_prompt\",\n   276\t        \"turn/t1/lower_band_projection\",\n   277\t        \"turn/t1/turn_rendering\",\n   278\t        \"chunk/c1/chunk_summary_brief\",\n   279\t        \"chunk/c1/chunk_summary_detailed\",\n   280\t      ].sort(),\n   281\t    );\n   282\t\n   283\t    // The untouched-set half: every form outside the chain — chunk 2's\n   284\t    // summaries, t2's forms, m4's smoothing — deep-equal their pre-edit rows,\n   285\t    // state and source version included.\n   286\t    const clearedSet = new Set(result.value.cleared.map(clearKey));\n   287\t    const after = readDerivedForms(filePath);\n   288\t    expect(after.filter((form) => !clearedSet.has(clearKey(form)))).toEqual(\n   289\t      before.filter((form) => !clearedSet.has(clearKey(form))),\n   290\t    );\n   291\t    // And the cleared half sits pending at the bumped version.\n   292\t    for (const form of after.filter((candidate) => clearedSet.has(clearKey(candidate)))) {\n   293\t      expect(form.state).toBe(\"pending\");\n   294\t      expect(form.sourceVersion).toBe(2);\n   295\t      expect(form.content).toBeUndefined();\n   296\t    }\n   297\t  });\n   298\t});\n   299\t\n   300\tdescribe(\"TC-5.3 / AC-5.3: post-return, nothing pre-edit is ready; replacements queued at the new version; superseded reported\", () => {\n   301\t  it(\"clears to pending with version-scoped replacement ids, and a second edit supersedes the still-queued first wave\", async () => {\n   302\t    const double = createProviderDouble();\n   303\t    const sdk = manualSdk(double, {\n   304\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n   305\t    });\n   306\t    const filePath = await newThread();\n   307\t    await send(sdk, filePath, [\n   308\t      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n   309\t      validEvent(\"assistant_text\", { payload: { text: \"the answer\" } }),\n   310\t      validEvent(\"turn_end\"),\n   311\t    ]);\n   312\t    await drain(sdk, filePath);\n   313\t    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n   314\t\n   315\t    const firstWaveIds = [\n   316\t      \"w-c1-chunk_summary_brief-v2\",\n   317\t      \"w-c1-chunk_summary_detailed-v2\",\n   318\t      \"w-m1-prompt_smoothing-v2\",\n   319\t      \"w-t1-turn_derivation-v2\",\n   320\t    ];\n   321\t\n   322\t    // Edit while everything is ready: every dependent form leaves ready in\n   323\t    // the edit's transaction, replacement items carry the new source version\n   324\t    // in their ids and payloads, and nothing was queued to supersede.\n   325\t    const first = await messages.edit({ filePath }, { messageId: \"m1\", content: \"first edit\" });\n   326\t    expect(first.ok).toBe(true);\n   327\t    if (!first.ok) return;\n   328\t    expect(first.value.superseded).toEqual([]);\n   329\t    expect(first.value.queued.map((item) => item.workItemId).sort()).toEqual(firstWaveIds);\n   330\t    const formsAfterFirst = readDerivedForms(filePath);\n   331\t    expect(formsAfterFirst.every((form) => form.state === \"pending\")).toBe(true);\n   332\t    expect(formsAfterFirst.every((form) => form.sourceVersion === 2)).toBe(true);\n   333\t    const queueAfterFirst = rawDetail(filePath);\n   334\t    expect(queueAfterFirst.map((row) => row.workItemId).sort()).toEqual(firstWaveIds);\n   335\t    expect(queueAfterFirst.every((row) => row.status === \"queued\" && row.sourceVersion === 2)).toBe(\n   336\t      true,\n   337\t    );\n   338\t\n   339\t    // Second edit before any drain: the still-queued first wave is\n   340\t    // supersede-deleted in the cascade transaction and reported; the queue\n   341\t    // holds only the v3 replacements.\n   342\t    const second = await messages.edit({ filePath }, { messageId: \"m1\", content: \"second edit\" });\n   343\t    expect(second.ok).toBe(true);\n   344\t    if (!second.ok) return;\n   345\t    expect([...second.value.superseded].sort()).toEqual(firstWaveIds);\n   346\t    const queueAfterSecond = rawDetail(filePath);\n   347\t    expect(queueAfterSecond.map((row) => row.workItemId).sort()).toEqual([\n   348\t      \"w-c1-chunk_summary_brief-v3\",\n   349\t      \"w-c1-chunk_summary_detailed-v3\",\n   350\t      \"w-m1-prompt_smoothing-v3\",\n   351\t      \"w-t1-turn_derivation-v3\",\n   352\t    ]);\n   353\t    expect(\n   354\t      readDerivedForms(filePath).every(\n   355\t        (form) => form.state === \"pending\" && form.sourceVersion === 3,\n   356\t      ),\n   357\t    ).toBe(true);\n   358\t\n   359\t    // And the drain rebuilds the whole chain from the second edit's content.\n   360\t    await drain(sdk, filePath);\n   361\t    const smoothing = readDerivedForms(filePath).find(\n   362\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n   363\t    );\n   364\t    expect(smoothing?.state).toBe(\"ready\");\n   365\t    expect(smoothing?.content).toBe(\n   366\t      deterministicText(\"smoothPrompt\", { text: \"second edit\" }, \"second edit\"),\n   367\t    );\n   368\t  });\n   369\t});\n   370\t\n   371\tdescribe(\"TC-5.4 / AC-5.4 (architecture risk): the version check beats the straggler\", () => {\n   372\t  it(\"a claimed pre-edit item completing after the edit discards as stale_discarded; the post-edit artifact wins\", async () => {\n   373\t    const double = createProviderDouble();\n   374\t    const sdk = manualSdk(double);\n   375\t    const filePath = await newThread();\n   376\t    await send(sdk, filePath, [\n   377\t      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n   378\t      validEvent(\"turn_end\"),\n   379\t    ]);\n   380\t\n   381\t    // Hold the old-content smoothing in flight: the drain claims it, the\n   382\t    // handler awaits the delayed double, and the edit lands inside that\n   383\t    // window — a real claimed old-version item held across the edit, not a\n   384\t    // simulated version poke.\n   385\t    double.delayKind(\"prompt_smoothing\", 400);\n   386\t    const captured = double.captureInputs();\n   387\t    const drainPromise = sdk.work.drain({ filePath });\n   388\t    await until(\n   389\t      () => captured.some((call) => call.op === \"smoothPrompt\"),\n   390\t      \"the old-content smoothing to be claimed and in-handler\",\n   391\t    );\n   392\t\n   393\t    const edited = await messages.edit(\n   394\t      { filePath },\n   395\t      { messageId: \"m1\", content: \"edited prompt\" },\n   396\t    );\n   397\t    expect(edited.ok).toBe(true);\n   398\t    if (!edited.ok) return;\n   399\t    // The still-queued turn derivation behind the claimed head was\n   400\t    // superseded; the claimed item was left to the version check.\n   401\t    expect(edited.value.superseded).toEqual([\"w-t1-turn_derivation-v1\"]);\n   402\t\n   403\t    // Old claimed item and post-edit replacement coexist — ids include the\n   404\t    // source version, so they never collide.\n   405\t    const mid = rawDetail(filePath);\n   406\t    expect(mid.map((row) => [row.workItemId, row.status])).toEqual([\n   407\t      [\"w-m1-prompt_smoothing-v1\", \"claimed\"],\n   408\t      [\"w-m1-prompt_smoothing-v2\", \"queued\"],\n   409\t      [\"w-t1-turn_derivation-v2\", \"queued\"],\n   410\t    ]);\n   411\t\n   412\t    // Let both complete. The straggler's completion is a normal completion\n   413\t    // reported stale_discarded — not an error, not a retry — and the drain\n   414\t    // continues into the replacement work.\n   415\t    const drained = await drainPromise;\n   416\t    expect(drained.ok).toBe(true);\n   417\t    if (!drained.ok) return;\n   418\t    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   419\t      [\"w-m1-prompt_smoothing-v1\", \"stale_discarded\"],\n   420\t      [\"w-m1-prompt_smoothing-v2\", \"done\"],\n   421\t      [\"w-t1-turn_derivation-v2\", \"done\"],\n   422\t    ]);\n   423\t\n   424\t    // Exactly one ready smoothing row, derived from the post-edit content at\n   425\t    // the post-edit source version — regardless of completion order.\n   426\t    const rows = readDerivedForms(filePath).filter(\n   427\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n   428\t    );\n   429\t    expect(rows).toHaveLength(1);\n   430\t    expect(rows[0]).toMatchObject({ state: \"ready\", sourceVersion: 2 });\n   431\t    expect(rows[0]?.content).toBe(\n   432\t      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n   433\t    );\n   434\t    expect(rawDetail(filePath)).toEqual([]);\n   435\t  }, 15000);\n   436\t});\n   437\t\n   438\tdescribe(\"TC-5.5 / AC-5.5: refusals are stable and change nothing\", () => {\n   439\t  it(\"refuses open-turn, missing, and deleted targets; read-back identical after each\", async () => {\n   440\t    const double = createProviderDouble();\n   441\t    const sdk = manualSdk(double);\n   442\t    const filePath = await newThread();\n   443\t    // m1 in closed t1; m3 in open t2.\n   444\t    await send(sdk, filePath, [\n   445\t      validEvent(\"user_prompt\", { payload: { text: \"closed prompt\" } }),\n   446\t      validEvent(\"turn_end\"),\n   447\t      validEvent(\"user_prompt\", { payload: { text: \"open prompt\" } }),\n   448\t    ]);\n   449\t    const before = await snapshot(filePath);\n   450\t\n   451\t    const openTurn = await messages.edit({ filePath }, { messageId: \"m3\", content: \"nope\" });\n   452\t    expect(openTurn.ok).toBe(false);\n   453\t    if (openTurn.ok) return;\n   454\t    expect(openTurn.error.errorClass).toBe(\"caller_error\");\n   455\t    expect(openTurn.error.code).toBe(\"turn_open\");\n   456\t    expect(await snapshot(filePath)).toEqual(before);\n   457\t\n   458\t    const missing = await messages.edit({ filePath }, { messageId: \"m99\", content: \"nope\" });\n   459\t    expect(missing.ok).toBe(false);\n   460\t    if (missing.ok) return;\n   461\t    expect(missing.error.errorClass).toBe(\"caller_error\");\n   462\t    expect(missing.error.code).toBe(\"message_not_found\");\n   463\t    expect(await snapshot(filePath)).toEqual(before);\n   464\t\n   465\t    // A deleted target reads as message_not_found through the filtered view\n   466\t    // — never a distinct error. (deleted_at stamped below the SDK: the\n   467\t    // delete operation itself is Story 6.)\n   468\t    const db = openRaw(filePath);\n   469\t    db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = 'm1'`).run(\n   470\t      \"2026-06-11T00:00:00.000Z\",\n   471\t    );\n   472\t    db.close();\n   473\t    const afterStamp = await snapshot(filePath);\n   474\t    const deleted = await messages.edit({ filePath }, { messageId: \"m1\", content: \"nope\" });\n   475\t    expect(deleted.ok).toBe(false);\n   476\t    if (deleted.ok) return;\n   477\t    expect(deleted.error.code).toBe(\"message_not_found\");\n   478\t    expect(await snapshot(filePath)).toEqual(afterStamp);\n   479\t  });\n   480\t});\n   481\t\n   482\tdescribe(\"background mode: edit-and-walk-away (production path)\", () => {\n   483\t  it(\"the cascade's enqueue pokes ride the commit; rebuilds run with no further call\", async () => {\n   484\t    const double = createProviderDouble();\n   485\t    const sdk = manualSdk(double, { mode: \"background\" });\n   486\t    const filePath = await newThread();\n   487\t    await send(sdk, filePath, [\n   488\t      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n   489\t      validEvent(\"assistant_text\", { payload: { text: \"the answer\" } }),\n   490\t      validEvent(\"turn_end\"),\n   491\t    ]);\n   492\t    await sdk.drainSettled({ filePath });\n   493\t    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n   494\t\n   495\t    const result: OpResult<MutationResult> = await messages.edit(\n   496\t      { filePath },\n   497\t      { messageId: \"m1\", content: \"edited prompt\" },\n   498\t    );\n   499\t    expect(result.ok).toBe(true);\n   500\t    await sdk.drainSettled({ filePath });\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/work.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// `lhc work drain` plus the per-owner report and requeue mirrors (Story 4)\n     2\t// — work.ts owns the drain/report/requeue command surface per tech design\n     3\t// §Placement. Provider resolution per DD-11: explicit `--provider` or\n     4\t// LHC_PROVIDER, looked up in the named-provider registry; no default and no\n     5\t// silent no-op — an unresolvable provider is a caller error naming both the\n     6\t// flag and the env var. Report, requeue, and mutations need no provider;\n     7\t// only drain dispatches handlers.\n     8\timport * as messages from \"../domains/messages/index.js\";\n     9\timport * as turns from \"../domains/turns/index.js\";\n    10\timport type { ThreadRef } from \"../domains/threads/index.js\";\n    11\timport { registeredProviderNames, resolveNamedProvider } from \"../providers/registry.js\";\n    12\timport { createSdk } from \"../sdk.js\";\n    13\timport type { DerivationProvider, FormKind } from \"../shared/derivation.js\";\n    14\timport type { ErrorResult, OpResult } from \"../shared/errors.js\";\n    15\timport { renderResult, type CliResult } from \"./render.js\";\n    16\t\n    17\tfunction providerNotConfigured(reason: string): { ok: false; error: ErrorResult } {\n    18\t  return {\n    19\t    ok: false,\n    20\t    error: { errorClass: \"caller_error\", code: \"provider_not_configured\", reason },\n    21\t  };\n    22\t}\n    23\t\n    24\texport function resolveCliProvider(\n    25\t  providerFlag: string | undefined,\n    26\t): OpResult<DerivationProvider> {\n    27\t  const name = providerFlag ?? process.env[\"LHC_PROVIDER\"];\n    28\t  if (name === undefined || name === \"\") {\n    29\t    return providerNotConfigured(\n    30\t      \"work drain needs a derivation provider: pass --provider <name> or set LHC_PROVIDER\",\n    31\t    );\n    32\t  }\n    33\t  const provider = resolveNamedProvider(name);\n    34\t  if (provider === undefined) {\n    35\t    return providerNotConfigured(\n    36\t      `no provider registered under \"${name}\" (--provider / LHC_PROVIDER); known: ${registeredProviderNames().join(\", \")}`,\n    37\t    );\n    38\t  }\n    39\t  return { ok: true, value: provider };\n    40\t}\n    41\t\n    42\texport async function runWorkDrain(\n    43\t  threadRef: ThreadRef,\n    44\t  flags: { provider?: string; maxItems?: number },\n    45\t): Promise<CliResult> {\n    46\t  const provider = resolveCliProvider(flags.provider);\n    47\t  if (!provider.ok) return renderResult(provider);\n    48\t  // The CLI is the manual host: it assembles the same SDK production hosts\n    49\t  // do and drains through the same surface — no in-process shortcut.\n    50\t  const sdk = createSdk({ provider: provider.value, mode: \"manual\" });\n    51\t  return renderResult(\n    52\t    await sdk.work.drain(\n    53\t      threadRef,\n    54\t      flags.maxItems !== undefined ? { maxItems: flags.maxItems } : undefined,\n    55\t    ),\n    56\t  );\n    57\t}\n    58\t\n    59\t// The report and requeue mirrors call the same domain operations the SDK\n    60\t// surfaces expose — same validation, same result JSON (AC-4.3/AC-4.4 CLI\n    61\t// parity). Form names pass through as given; an unknown form is refused by\n    62\t// the operation's own mapping check, identically to an SDK caller.\n    63\t\n    64\texport async function runMessagesReport(\n    65\t  threadRef: ThreadRef,\n    66\t  flags: { notReady?: boolean; messageId?: string },\n    67\t): Promise<CliResult> {\n    68\t  const opts: { notReady?: boolean; messageId?: string } = {};\n    69\t  if (flags.notReady === true) opts.notReady = true;\n    70\t  if (flags.messageId !== undefined) opts.messageId = flags.messageId;\n    71\t  return renderResult(await messages.report(threadRef, opts));\n    72\t}\n    73\t\n    74\texport async function runMessagesRequeue(\n    75\t  threadRef: ThreadRef,\n    76\t  flags: { messageId: string; form: string },\n    77\t): Promise<CliResult> {\n    78\t  return renderResult(\n    79\t    await messages.requeue(threadRef, {\n    80\t      messageId: flags.messageId,\n    81\t      form: flags.form as FormKind,\n    82\t    }),\n    83\t  );\n    84\t}\n    85\t\n    86\texport async function runTurnsReport(\n    87\t  threadRef: ThreadRef,\n    88\t  flags: { notReady?: boolean; turnId?: string; chunkId?: string },\n    89\t): Promise<CliResult> {\n    90\t  const opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n    91\t  if (flags.notReady === true) opts.notReady = true;\n    92\t  if (flags.turnId !== undefined) opts.turnId = flags.turnId;\n    93\t  if (flags.chunkId !== undefined) opts.chunkId = flags.chunkId;\n    94\t  return renderResult(await turns.report(threadRef, opts));\n    95\t}\n    96\t\n    97\texport async function runTurnsRequeue(\n    98\t  threadRef: ThreadRef,\n    99\t  flags: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: string },\n   100\t): Promise<CliResult> {\n   101\t  return renderResult(\n   102\t    await turns.requeue(threadRef, {\n   103\t      subjectKind: flags.subjectKind,\n   104\t      subjectId: flags.subjectId,\n   105\t      form: flags.form as FormKind,\n   106\t    }),\n   107\t  );\n   108\t}\n","exit_code":0,"status":"completed"}}

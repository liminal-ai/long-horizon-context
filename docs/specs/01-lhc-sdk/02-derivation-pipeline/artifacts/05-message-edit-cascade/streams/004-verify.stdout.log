{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/messages-mutate.ts | sed -n '1,300p'\"","aggregated_output":"     1\t// `lhc messages edit` (Story 5) — and Story 6's `lhc messages delete` when\n     2\t// it lands — per tech design §Placement: the mutation command surface,\n     3\t// mirroring the SDK operation one-for-one (AC-5.6). Mutations need no\n     4\t// provider (DD-11): the cascade queues replacement work; only a drain\n     5\t// dispatches handlers.\n     6\timport * as messages from \"../domains/messages/index.js\";\n     7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n     8\timport { renderResult, type CliResult } from \"./render.js\";\n     9\t\n    10\texport async function runMessagesEdit(\n    11\t  threadRef: ThreadRef,\n    12\t  flags: { messageId: string; content: string },\n    13\t): Promise<CliResult> {\n    14\t  return renderResult(\n    15\t    await messages.edit(threadRef, {\n    16\t      messageId: flags.messageId,\n    17\t      content: flags.content,\n    18\t    }),\n    19\t  );\n    20\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/cascade.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n     2\t// from the mutated subject — the message's own forms, its turn's rendering\n     3\t// and projection, the containing chunk's two summaries — clearing each to\n     4\t// `pending` at the next source version and enqueueing replacement work, all\n     5\t// inside the caller's mutation transaction. The clear-set is derived from\n     6\t// the record's structure (the message → turn → chunk walk over the rows that\n     7\t// actually exist), never from a hardcoded form list: a future form on any\n     8\t// subject in the chain cascades without this module changing. Still-queued\n     9\t// old-version items are supersede-deleted (tech design issue 1) and reported\n    10\t// on the MutationResult; claimed items are deliberately left to the\n    11\t// source-version check (DD-3) — their stale completions discard. Two close\n    12\t// paths share this walk by design: edit re-queues the subject's own forms,\n    13\t// delete (Story 6) drops them and starts the clear at the turn level.\n    14\timport type { DatabaseSync } from \"node:sqlite\";\n    15\timport type { OperationContext } from \"../../../shared/context.js\";\n    16\timport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n    17\timport {\n    18\t  enqueue,\n    19\t  supersedeQueued,\n    20\t  WORK_KIND_REGISTRY,\n    21\t  type EnqueueFormTarget,\n    22\t  type WorkKind,\n    23\t  type WorkSourceRef,\n    24\t} from \"../../../tech-utils/work-queue/index.js\";\n    25\t\n    26\t// Each form's rebuild queue-site — the owning domains' enqueue mappings,\n    27\t// gathered here because the cascade is the one place that re-queues across\n    28\t// the whole chain (module responsibility matrix: replacement enqueues for\n    29\t// all three mutations live with the cascade). Both turn forms ride the one\n    30\t// turn_derivation item; every other form rides its same-named kind.\n    31\tconst FORM_REBUILD_KINDS: Record<FormKind, WorkKind> = {\n    32\t  smoothed_prompt: \"prompt_smoothing\",\n    33\t  tool_call_summary: \"tool_call_summary\",\n    34\t  tool_result_summary: \"tool_result_summary\",\n    35\t  turn_rendering: \"turn_derivation\",\n    36\t  lower_band_projection: \"turn_derivation\",\n    37\t  chunk_summary_detailed: \"chunk_summary_detailed\",\n    38\t  chunk_summary_brief: \"chunk_summary_brief\",\n    39\t};\n    40\t\n    41\texport interface CascadeClear {\n    42\t  subjectKind: SubjectKind;\n    43\t  subjectId: string;\n    44\t  form: FormKind;\n    45\t}\n    46\t\n    47\texport interface CascadeOutcome {\n    48\t  cleared: CascadeClear[];\n    49\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n    50\t  superseded: string[];\n    51\t}\n    52\t\n    53\tinterface ChainSubject {\n    54\t  subjectKind: SubjectKind;\n    55\t  subjectId: string;\n    56\t}\n    57\t\n    58\tfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n    59\t  switch (subject.subjectKind) {\n    60\t    case \"message\":\n    61\t      return { messageId: subject.subjectId };\n    62\t    case \"turn\":\n    63\t      return { turnId: subject.subjectId };\n    64\t    case \"chunk\":\n    65\t      return { chunkId: subject.subjectId };\n    66\t  }\n    67\t}\n    68\t\n    69\t// The structural walk: the edited message's turn from its membership stamp,\n    70\t// the turn's chunk from its placement row. Either link may be absent — a gap\n    71\t// message has no turn, an unplaced turn no chunk — and the chain simply\n    72\t// stops there; reach is structural, not configured.\n    73\tfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n    74\t  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n    75\t  const turnRow = db\n    76\t    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n    77\t    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n    78\t  const turnId = turnRow?.turn_id ?? null;\n    79\t  if (turnId === null) return subjects;\n    80\t  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n    81\t  const chunkRow = db\n    82\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n    83\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n    84\t  if (chunkRow !== undefined) {\n    85\t    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n    86\t  }\n    87\t  return subjects;\n    88\t}\n    89\t\n    90\tinterface RebuildGroup {\n    91\t  subject: ChainSubject;\n    92\t  kind: WorkKind;\n    93\t  forms: EnqueueFormTarget[];\n    94\t  maxSourceVersion: number;\n    95\t}\n    96\t\n    97\t// Clear-and-requeue for the full chain above (and including) the edited\n    98\t// message. Runs inside the mutation's ambient transaction: the enqueue's\n    99\t// pending upsert is the clear (state pending, content/reason/gaps/metadata\n   100\t// reset, source version bumped past every version seen in the group), the\n   101\t// work row and the commit poke ride the same transaction, and the supersede\n   102\t// delete lands before the replacements so a tidied id can never collide.\n   103\texport function cascadeFromMessage(\n   104\t  ctx: OperationContext,\n   105\t  messageId: string,\n   106\t): CascadeOutcome {\n   107\t  const subjects = chainSubjects(ctx.db, messageId);\n   108\t  const cleared: CascadeClear[] = [];\n   109\t  const groups = new Map<string, RebuildGroup>();\n   110\t  const readForms = ctx.db.prepare(\n   111\t    `SELECT form, source_version FROM derived_form\n   112\t     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n   113\t  );\n   114\t  for (const subject of subjects) {\n   115\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n   116\t      form: string;\n   117\t      source_version: number | bigint;\n   118\t    }>;\n   119\t    for (const row of rows) {\n   120\t      const form = row.form as FormKind;\n   121\t      cleared.push({ ...subject, form });\n   122\t      const kind = FORM_REBUILD_KINDS[form];\n   123\t      if (kind === undefined) {\n   124\t        // Every form names its queue site above; a miss is a wiring bug.\n   125\t        throw new Error(`no rebuild work kind mapped for derived form ${row.form}`);\n   126\t      }\n   127\t      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n   128\t      const group = groups.get(key) ?? {\n   129\t        subject,\n   130\t        kind,\n   131\t        forms: [],\n   132\t        maxSourceVersion: 0,\n   133\t      };\n   134\t      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n   135\t      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n   136\t      groups.set(key, group);\n   137\t    }\n   138\t  }\n   139\t\n   140\t  const superseded = supersedeQueued(\n   141\t    ctx.db,\n   142\t    [...groups.values()].map((group) => ({\n   143\t      kind: group.kind,\n   144\t      sourceRef: sourceRefFor(group.subject),\n   145\t    })),\n   146\t  );\n   147\t\n   148\t  const queued = [...groups.values()].map((group) => {\n   149\t    const item = enqueue(ctx, {\n   150\t      owner: WORK_KIND_REGISTRY[group.kind].owner,\n   151\t      kind: group.kind,\n   152\t      sourceRef: sourceRefFor(group.subject),\n   153\t      sourceVersion: group.maxSourceVersion + 1,\n   154\t      forms: group.forms,\n   155\t    });\n   156\t    return { workItemId: item.workItemId, kind: group.kind };\n   157\t  });\n   158\t\n   159\t  return { cleared, queued, superseded };\n   160\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/store.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Message and block row operations. Writes run on the caller's handle inside\n     2\t// the batch transaction (insert failures propagate so the pipeline rejects\n     3\t// the whole batch); reads run on a fresh handle per operation. The mutation\n     4\t// half (Epic 02 Story 5) — the edit's validation read and content apply —\n     5\t// also lives here: row-level mechanics, no policy.\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n     8\timport type { Block, MessageRecord } from \"../index.js\";\n     9\t\n    10\texport interface MessageRow {\n    11\t  messageId: string;\n    12\t  sourceEventOrder: number;\n    13\t  kind: MessageRecord[\"kind\"];\n    14\t  tokenEstimate: number;\n    15\t  actor: string;\n    16\t  harness: string;\n    17\t  // Membership stamp, settled at intake: the turn open after this event's\n    18\t  // transition, or null in a gap. Written once here, never updated — a null\n    19\t  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n    20\t  // change (AC-3.7).\n    21\t  turnId: string | null;\n    22\t  blocks: Block[];\n    23\t}\n    24\t\n    25\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n    26\t  db.prepare(\n    27\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n    28\t     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    29\t  ).run(\n    30\t    row.messageId,\n    31\t    row.sourceEventOrder,\n    32\t    row.kind,\n    33\t    row.tokenEstimate,\n    34\t    row.actor,\n    35\t    row.harness,\n    36\t    row.turnId,\n    37\t  );\n    38\t\n    39\t  const insertBlock = db.prepare(\n    40\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\n    41\t     VALUES (?, ?, ?, ?)`,\n    42\t  );\n    43\t  for (const [index, block] of row.blocks.entries()) {\n    44\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n    45\t  }\n    46\t}\n    47\t\n    48\t// The edit operation's validation read (Flow 5): the live (deleted-filtered)\n    49\t// message joined to its turn's status. A deleted target misses here and\n    50\t// refuses as message_not_found — the filtered view is the refusal's read by\n    51\t// design (never a distinct error for deleted). turnStatus is null for a gap\n    52\t// message (no membership): nothing open gates it.\n    53\texport interface MutableMessageView {\n    54\t  messageId: string;\n    55\t  kind: string;\n    56\t  turnId: string | null;\n    57\t  turnStatus: \"open\" | \"closed\" | null;\n    58\t}\n    59\t\n    60\texport function readMutableMessage(\n    61\t  db: DatabaseSync,\n    62\t  messageId: string,\n    63\t): MutableMessageView | undefined {\n    64\t  const row = db\n    65\t    .prepare(\n    66\t      `SELECT m.message_id, m.kind, m.turn_id, t.status AS turn_status\n    67\t       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\n    68\t       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\n    69\t    )\n    70\t    .get(messageId) as unknown as\n    71\t    | { message_id: string; kind: string; turn_id: string | null; turn_status: string | null }\n    72\t    | undefined;\n    73\t  if (row === undefined) return undefined;\n    74\t  return {\n    75\t    messageId: row.message_id,\n    76\t    kind: row.kind,\n    77\t    turnId: row.turn_id,\n    78\t    turnStatus: row.turn_status as MutableMessageView[\"turnStatus\"],\n    79\t  };\n    80\t}\n    81\t\n    82\t// The edit's record apply (AC-5.1): the new content lands in each block's\n    83\t// content-bearing field — the same field per block type the projection wrote\n    84\t// and counted (internal/project.ts) — and the token estimate re-stamps from\n    85\t// the same estimator, so placement arithmetic stays current after edits.\n    86\t// Events are untouched: this is projection-level mutation; the log keeps the\n    87\t// original (DD-12).\n    88\texport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\n    89\t  const blocks = db\n    90\t    .prepare(\n    91\t      `SELECT block_index, block_type, content FROM message_block\n    92\t       WHERE message_id = ? ORDER BY block_index`,\n    93\t    )\n    94\t    .all(messageId) as unknown as Array<{\n    95\t    block_index: number | bigint;\n    96\t    block_type: string;\n    97\t    content: string;\n    98\t  }>;\n    99\t  const update = db.prepare(\n   100\t    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\n   101\t  );\n   102\t  let tokenEstimate = estimateTokens(content);\n   103\t  for (const block of blocks) {\n   104\t    const parsed = JSON.parse(block.content) as Record<string, unknown>;\n   105\t    switch (block.block_type) {\n   106\t      case \"text\":\n   107\t        parsed[\"text\"] = content;\n   108\t        break;\n   109\t      case \"tool_result\":\n   110\t        parsed[\"content\"] = content;\n   111\t        break;\n   112\t      case \"tool_call\":\n   113\t        // Arguments are the call's counted content; the edit's string lands\n   114\t        // verbatim as the new arguments value, mirroring projection's\n   115\t        // serialized-arguments estimate.\n   116\t        parsed[\"arguments\"] = content;\n   117\t        tokenEstimate = estimateTokens(JSON.stringify(content));\n   118\t        break;\n   119\t      default:\n   120\t        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\n   121\t    }\n   122\t    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\n   123\t  }\n   124\t  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\n   125\t    tokenEstimate,\n   126\t    messageId,\n   127\t  );\n   128\t}\n   129\t\n   130\tinterface RawMessageRow {\n   131\t  message_id: string;\n   132\t  source_event_order: number | bigint;\n   133\t  kind: string;\n   134\t  token_estimate: number | bigint;\n   135\t  actor: string;\n   136\t  harness: string;\n   137\t  turn_id: string | null;\n   138\t}\n   139\t\n   140\tinterface RawBlockRow {\n   141\t  message_id: string;\n   142\t  block_type: string;\n   143\t  content: string;\n   144\t}\n   145\t\n   146\texport function readMessages(db: DatabaseSync): MessageRecord[] {\n   147\t  const blockRows = db\n   148\t    .prepare(\n   149\t      `SELECT message_id, block_type, content FROM message_block\n   150\t       ORDER BY message_id, block_index`,\n   151\t    )\n   152\t    .all() as unknown as RawBlockRow[];\n   153\t  const blocksByMessage = new Map<string, Block[]>();\n   154\t  for (const row of blockRows) {\n   155\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n   156\t    blocks.push({\n   157\t      blockType: row.block_type as Block[\"blockType\"],\n   158\t      content: JSON.parse(row.content) as Record<string, unknown>,\n   159\t    });\n   160\t    blocksByMessage.set(row.message_id, blocks);\n   161\t  }\n   162\t\n   163\t  const messageRows = db\n   164\t    .prepare(\n   165\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n   166\t       FROM message ORDER BY source_event_order`,\n   167\t    )\n   168\t    .all() as unknown as RawMessageRow[];\n   169\t  return messageRows.map((row) => {\n   170\t    const record: MessageRecord = {\n   171\t      messageId: row.message_id,\n   172\t      sourceEventOrder: Number(row.source_event_order),\n   173\t      kind: row.kind as MessageRecord[\"kind\"],\n   174\t      blocks: blocksByMessage.get(row.message_id) ?? [],\n   175\t      tokenEstimate: Number(row.token_estimate),\n   176\t      actor: row.actor,\n   177\t      harness: row.harness,\n   178\t    };\n   179\t    if (row.turn_id !== null) record.turnId = row.turn_id;\n   180\t    return record;\n   181\t  });\n   182\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '1,480p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     5\timport {\n     6\t  enqueue,\n     7\t  hasLiveItem,\n     8\t  listItems,\n     9\t  type WorkItemRecord,\n    10\t  type WorkKind,\n    11\t} from \"../../tech-utils/work-queue/index.js\";\n    12\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    13\timport {\n    14\t  openThreadDatabase,\n    15\t  resolveThreadRef,\n    16\t  type ThreadRef,\n    17\t} from \"../threads/index.js\";\n    18\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    19\timport {\n    20\t  findUnknownOutcomeCallSummary,\n    21\t  readMessageFormRow,\n    22\t  readMessageForms,\n    23\t  reportMessageForms,\n    24\t} from \"./internal/forms.js\";\n    25\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n    26\timport { projectEvent } from \"./internal/project.js\";\n    27\timport { cascadeFromMessage, type CascadeClear } from \"./internal/cascade.js\";\n    28\timport {\n    29\t  applyMessageEdit,\n    30\t  insertMessage,\n    31\t  readMessages,\n    32\t  readMutableMessage,\n    33\t} from \"./internal/store.js\";\n    34\t\n    35\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    36\t\n    37\texport interface Block {\n    38\t  blockType: BlockType;\n    39\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    40\t}\n    41\t\n    42\texport interface MessageRecord {\n    43\t  messageId: string;\n    44\t  sourceEventOrder: number;\n    45\t  kind: Exclude<EventKind, \"turn_end\">;\n    46\t  blocks: Block[];\n    47\t  tokenEstimate: number;\n    48\t  actor: string;\n    49\t  harness: string;\n    50\t  turnId?: string;\n    51\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n    52\t  // for messages that are derivation sources — kinds with no derivable form\n    53\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n    54\t  // never re-derived on read.\n    55\t  forms?: DerivedForm[];\n    56\t}\n    57\t\n    58\t// The event as the walk holds it after recording: the validated input plus\n    59\t// its server-stamped order and timestamp.\n    60\texport type RecordedEvent = EventRecord;\n    61\t\n    62\texport type MessageCreated = {\n    63\t  messageId: string;\n    64\t  kind: Exclude<EventKind, \"turn_end\">;\n    65\t  // Carried for tool activity only: the pairing key the queue sites need —\n    66\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n    67\t  toolCallId?: string;\n    68\t} | null;\n    69\t\n    70\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    71\t// (the first such call through the operation context; turns.applyEvent\n    72\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    73\t// projection failure propagates to the pipeline's catch and rejects the\n    74\t// whole batch — recorded events without messages is the stranded state the\n    75\t// transaction exists to prevent. Returns null for turn_end (no message).\n    76\t// turnId is the membership stamp, settled by the pipeline before this call:\n    77\t// the turn open *after* this event's transition (so a prompt belongs to the\n    78\t// turn it just opened), or null in a gap — written once, never updated.\n    79\texport function createFromEvent(\n    80\t  ctx: OperationContext,\n    81\t  event: RecordedEvent,\n    82\t  turnId: string | null,\n    83\t): MessageCreated {\n    84\t  const projected = projectEvent(event);\n    85\t  if (projected === null) return null;\n    86\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    87\t  const messageId = `m${event.eventOrder}`;\n    88\t  insertMessage(ctx.db, {\n    89\t    messageId,\n    90\t    sourceEventOrder: event.eventOrder,\n    91\t    kind,\n    92\t    tokenEstimate: projected.tokenEstimate,\n    93\t    actor: event.actor,\n    94\t    harness: event.harness,\n    95\t    turnId,\n    96\t    blocks: projected.blocks,\n    97\t  });\n    98\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n    99\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n   100\t  }\n   101\t  return { messageId, kind };\n   102\t}\n   103\t\n   104\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n   105\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n   106\t// tool result queues tool_result_summary, nothing else queues anything —\n   107\t// text, thinking, and note messages are not derivation sources (Epic 01\n   108\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   109\t// intake-stream inside the batch transaction for every recorded message, so\n   110\t// the item commits (or rolls back) with the batch.\n   111\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   112\t  user_prompt: \"prompt_smoothing\",\n   113\t  tool_call: \"tool_call_summary\",\n   114\t  tool_result: \"tool_result_summary\",\n   115\t};\n   116\t\n   117\t// Which derived form each message-owned kind produces — the owning domain's\n   118\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   119\t// rides the same transaction (DD-5).\n   120\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n   121\t  prompt_smoothing: \"smoothed_prompt\",\n   122\t  tool_call_summary: \"tool_call_summary\",\n   123\t  tool_result_summary: \"tool_result_summary\",\n   124\t};\n   125\t\n   126\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   127\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n   128\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   129\t  messageWorkHandlers;\n   130\t\n   131\texport function queueMessageWork(\n   132\t  ctx: OperationContext,\n   133\t  message: MessageCreated,\n   134\t): WorkItemRecord[] {\n   135\t  if (message === null) return [];\n   136\t  const items: WorkItemRecord[] = [];\n   137\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   138\t  if (kind !== undefined) {\n   139\t    const form = MESSAGE_WORK_FORMS[kind];\n   140\t    if (form === undefined) {\n   141\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   142\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   143\t    }\n   144\t    items.push(\n   145\t      enqueue(ctx, {\n   146\t        owner: \"messages\",\n   147\t        kind,\n   148\t        sourceRef: { messageId: message.messageId },\n   149\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n   150\t      }),\n   151\t    );\n   152\t  }\n   153\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n   154\t  // summary already derived with outcome \"unknown\" means the summary's\n   155\t  // source — the call+result pair — completed underneath it; clear and\n   156\t  // regenerate at the next source version, in this same batch transaction.\n   157\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n   158\t  // the common call-and-result-in-one-batch case never triggers, and the\n   159\t  // version-scoped item id keeps the requeue idempotent.\n   160\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n   161\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n   162\t    if (stale !== undefined) {\n   163\t      items.push(\n   164\t        enqueue(ctx, {\n   165\t          owner: \"messages\",\n   166\t          kind: \"tool_call_summary\",\n   167\t          sourceRef: { messageId: stale.messageId },\n   168\t          sourceVersion: stale.sourceVersion + 1,\n   169\t          forms: [\n   170\t            {\n   171\t              subjectKind: \"message\",\n   172\t              subjectId: stale.messageId,\n   173\t              form: \"tool_call_summary\",\n   174\t            },\n   175\t          ],\n   176\t        }),\n   177\t      );\n   178\t    }\n   179\t  }\n   180\t  return items;\n   181\t}\n   182\t\n   183\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   184\t  return {\n   185\t    ok: false,\n   186\t    error: {\n   187\t      errorClass: \"caller_error\",\n   188\t      code: \"thread_not_found\",\n   189\t      reason: `no thread file exists at ${filePath}`,\n   190\t    },\n   191\t  };\n   192\t}\n   193\t\n   194\texport async function listMessages(\n   195\t  thread: ThreadRef,\n   196\t): Promise<OpResult<MessageRecord[]>> {\n   197\t  const resolved = await resolveThreadRef(thread);\n   198\t  if (!resolved.ok) return resolved;\n   199\t  const { filePath } = resolved.value;\n   200\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   201\t\n   202\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   203\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   204\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   205\t  // unmutated (F-03-002).\n   206\t  const opened = openThreadDatabase(filePath);\n   207\t  if (!opened.ok) return opened;\n   208\t  const db = opened.value;\n   209\t  try {\n   210\t    // Form read-back rides the message read (AC-2.1): each record carries\n   211\t    // its stored derived forms, attached from one grouped query — the\n   212\t    // production path for \"readable alongside the message\".\n   213\t    const formsByMessage = readMessageForms(db);\n   214\t    const records = readMessages(db).map((record) => {\n   215\t      const forms = formsByMessage.get(record.messageId);\n   216\t      return forms === undefined ? record : { ...record, forms };\n   217\t    });\n   218\t    return { ok: true, value: records };\n   219\t  } catch (cause) {\n   220\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   221\t    return storageFailure(`message read-back failed: ${reason}`);\n   222\t  } finally {\n   223\t    db.close();\n   224\t  }\n   225\t}\n   226\t\n   227\texport async function listQueuedWork(\n   228\t  thread: ThreadRef,\n   229\t): Promise<OpResult<WorkItemRecord[]>> {\n   230\t  const resolved = await resolveThreadRef(thread);\n   231\t  if (!resolved.ok) return resolved;\n   232\t  const { filePath } = resolved.value;\n   233\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   234\t\n   235\t  const opened = openThreadDatabase(filePath);\n   236\t  if (!opened.ok) return opened;\n   237\t  const db = opened.value;\n   238\t  try {\n   239\t    return { ok: true, value: listItems(db, \"messages\") };\n   240\t  } catch (cause) {\n   241\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   242\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   243\t  } finally {\n   244\t    db.close();\n   245\t  }\n   246\t}\n   247\t\n   248\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   249\t\n   250\t// This owner's repair report: every message-owned form's durable state\n   251\t// joined with live queue detail in one query — the five operational\n   252\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n   253\t// without any queue API. Needs no provider; reads degrade, never block.\n   254\texport async function report(\n   255\t  thread: ThreadRef,\n   256\t  opts?: { notReady?: boolean; messageId?: string },\n   257\t): Promise<OpResult<FormReportEntry[]>> {\n   258\t  const resolved = await resolveThreadRef(thread);\n   259\t  if (!resolved.ok) return resolved;\n   260\t  const { filePath } = resolved.value;\n   261\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   262\t\n   263\t  const opened = openThreadDatabase(filePath);\n   264\t  if (!opened.ok) return opened;\n   265\t  const db = opened.value;\n   266\t  try {\n   267\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n   268\t  } catch (cause) {\n   269\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   270\t    return storageFailure(`report read failed: ${reason}`);\n   271\t  } finally {\n   272\t    db.close();\n   273\t  }\n   274\t}\n   275\t\n   276\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   277\t\n   278\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n   279\t// inverted; the requeue's join from the named form back to its queue site.\n   280\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n   281\t  smoothed_prompt: \"prompt_smoothing\",\n   282\t  tool_call_summary: \"tool_call_summary\",\n   283\t  tool_result_summary: \"tool_result_summary\",\n   284\t};\n   285\t\n   286\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n   287\t// supported rebuild act. Refused for blocked forms with the form's stored\n   288\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n   289\t// queued or in flight at the form's current source version (AC-4.5).\n   290\t// Otherwise the form clears to pending and re-enqueues at the next source\n   291\t// version — the same enqueue path intake uses, poke-on-commit included, so\n   292\t// background mode processes the repair with no further call. The no-op check\n   293\t// and the enqueue commit in one transaction (anti-shim: a split would\n   294\t// reintroduce the duplicate-work race).\n   295\texport async function requeue(\n   296\t  thread: ThreadRef,\n   297\t  target: { messageId: string; form: FormKind },\n   298\t): Promise<OpResult<RequeueOutcome>> {\n   299\t  const kind = MESSAGE_FORM_KINDS[target.form];\n   300\t  if (kind === undefined) {\n   301\t    return {\n   302\t      ok: false,\n   303\t      error: {\n   304\t        errorClass: \"caller_error\",\n   305\t        code: \"message_not_found\",\n   306\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n   307\t      },\n   308\t    };\n   309\t  }\n   310\t  const resolved = await resolveThreadRef(thread);\n   311\t  if (!resolved.ok) return resolved;\n   312\t  const { filePath } = resolved.value;\n   313\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   314\t\n   315\t  const opened = openThreadDatabase(filePath);\n   316\t  if (!opened.ok) return opened;\n   317\t  const db = opened.value;\n   318\t  try {\n   319\t    const meta = db\n   320\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   321\t      .get() as { thread_id: string } | undefined;\n   322\t    const threadId = meta?.thread_id ?? \"\";\n   323\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   324\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n   325\t      if (row === undefined) {\n   326\t        return {\n   327\t          ok: false,\n   328\t          error: {\n   329\t            errorClass: \"caller_error\",\n   330\t            code: \"message_not_found\",\n   331\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n   332\t          },\n   333\t        };\n   334\t      }\n   335\t      if (row.state === \"blocked\") {\n   336\t        // The refusal carries the form's stored reason — the damage named at\n   337\t        // blocking time, not a generic string (AC-4.6).\n   338\t        return {\n   339\t          ok: false,\n   340\t          error: {\n   341\t            errorClass: \"state_corruption\",\n   342\t            code: \"source_damaged\",\n   343\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n   344\t          },\n   345\t        };\n   346\t      }\n   347\t      const sourceRef = { messageId: target.messageId };\n   348\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n   349\t        return { ok: true, value: { noop: \"already_queued\" } };\n   350\t      }\n   351\t      const item = enqueue(ctx, {\n   352\t        owner: \"messages\",\n   353\t        kind,\n   354\t        sourceRef,\n   355\t        sourceVersion: row.sourceVersion + 1,\n   356\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n   357\t      });\n   358\t      return { ok: true, value: { workItemId: item.workItemId } };\n   359\t    });\n   360\t  } catch (cause) {\n   361\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   362\t    return storageFailure(`requeue failed: ${reason}`);\n   363\t  } finally {\n   364\t    db.close();\n   365\t  }\n   366\t}\n   367\t\n   368\t// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n   369\t\n   370\t// The mutation result contract (tech design §Interfaces): what changed in\n   371\t// the record, which dependent forms cleared, which dropped (delete only),\n   372\t// what replacement work queued, and which still-queued old items the cascade\n   373\t// tidied away (issue 1). Shared by edit and the Story 6 deletes.\n   374\texport interface MutationResult {\n   375\t  changed: { messageIds: string[]; turnIds: string[] };\n   376\t  cleared: CascadeClear[];\n   377\t  dropped: CascadeClear[];\n   378\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n   379\t  superseded: string[];\n   380\t}\n   381\t\n   382\t// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n   383\t// message's content and blocks, re-stamp the token estimate, and walk the\n   384\t// full dependent chain — clear to pending, supersede queued old work,\n   385\t// enqueue replacements at the next source version — in one transaction.\n   386\t// Synchronous and local by contract: everything above commits before this\n   387\t// returns; the re-queued rebuilds run through the normal drain (background\n   388\t// mode needs no further call — the enqueue pokes ride the commit). Events\n   389\t// are never touched (projection-level mutation, DD-12), and no generated\n   390\t// thread-view is either — visibility arrives at the next compact/rebuild.\n   391\t// Refusals read through the deleted-filtered view: an open-turn target is\n   392\t// turn_open, a missing or deleted message is message_not_found, and a\n   393\t// refusal changes nothing.\n   394\texport async function edit(\n   395\t  thread: ThreadRef,\n   396\t  input: { messageId: string; content: string },\n   397\t): Promise<OpResult<MutationResult>> {\n   398\t  const resolved = await resolveThreadRef(thread);\n   399\t  if (!resolved.ok) return resolved;\n   400\t  const { filePath } = resolved.value;\n   401\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   402\t\n   403\t  const opened = openThreadDatabase(filePath);\n   404\t  if (!opened.ok) return opened;\n   405\t  const db = opened.value;\n   406\t  try {\n   407\t    const meta = db\n   408\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   409\t      .get() as { thread_id: string } | undefined;\n   410\t    const threadId = meta?.thread_id ?? \"\";\n   411\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   412\t      const target = readMutableMessage(ctx.db, input.messageId);\n   413\t      if (target === undefined) {\n   414\t        return {\n   415\t          ok: false,\n   416\t          error: {\n   417\t            errorClass: \"caller_error\",\n   418\t            code: \"message_not_found\",\n   419\t            reason: `no message ${input.messageId} exists in this thread`,\n   420\t          },\n   421\t        };\n   422\t      }\n   423\t      if (target.turnStatus === \"open\") {\n   424\t        return {\n   425\t          ok: false,\n   426\t          error: {\n   427\t            errorClass: \"caller_error\",\n   428\t            code: \"turn_open\",\n   429\t            reason: `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be edited (v1 boundary)`,\n   430\t          },\n   431\t        };\n   432\t      }\n   433\t      applyMessageEdit(ctx.db, input.messageId, input.content);\n   434\t      const cascade = cascadeFromMessage(ctx, input.messageId);\n   435\t      return {\n   436\t        ok: true,\n   437\t        value: {\n   438\t          changed: { messageIds: [input.messageId], turnIds: [] },\n   439\t          cleared: cascade.cleared,\n   440\t          dropped: [],\n   441\t          queued: cascade.queued,\n   442\t          superseded: cascade.superseded,\n   443\t        },\n   444\t      };\n   445\t    });\n   446\t  } catch (cause) {\n   447\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   448\t    return storageFailure(`edit failed: ${reason}`);\n   449\t  } finally {\n   450\t    db.close();\n   451\t  }\n   452\t}\n","exit_code":0,"status":"completed"}}

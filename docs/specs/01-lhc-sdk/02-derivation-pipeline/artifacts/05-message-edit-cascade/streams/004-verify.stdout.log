{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,460p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type {\n     4\t  FormKind,\n     5\t  FormReportEntry,\n     6\t  WorkHandler,\n     7\t} from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type EnqueueFormTarget,\n    14\t  type WorkItemRecord,\n    15\t  type WorkKind,\n    16\t  type WorkSourceRef,\n    17\t} from \"../../tech-utils/work-queue/index.js\";\n    18\timport type { EventKind } from \"../intake-stream/index.js\";\n    19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    20\timport { transition } from \"./internal/state-machine.js\";\n    21\t\n    22\t// The pure rule table, re-exported for the golden supplemental suite (the\n    23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    24\t// callers go through applyEvent.\n    25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    26\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    27\timport { turnWorkHandlers } from \"./internal/derive.js\";\n    28\timport {\n    29\t  readChunkRows,\n    30\t  readOwnedForms,\n    31\t  readTurnFormRow,\n    32\t  reportTurnForms,\n    33\t} from \"./internal/forms.js\";\n    34\timport {\n    35\t  closeTurn,\n    36\t  insertOpenTurn,\n    37\t  nextTurnOrder,\n    38\t  readTurns,\n    39\t  selectOpenTurnIds,\n    40\t} from \"./internal/store.js\";\n    41\t\n    42\texport interface TurnRecord {\n    43\t  turnId: string;\n    44\t  status: \"open\" | \"closed\";\n    45\t  memberMessageIds: string[];\n    46\t  openedAtEventOrder: number;\n    47\t  closedAtEventOrder?: number;\n    48\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n    49\t  // derivation placed it — stored values read back, never recomputed.\n    50\t  chunkId?: string;\n    51\t  memberIdx?: number;\n    52\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n    53\t  // present only when rows exist — a closed turn carries them from the\n    54\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n    55\t  // the message read's forms key; reads degrade, never block.\n    56\t  forms?: DerivedForm[];\n    57\t}\n    58\t\n    59\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n    60\t// record with live membership and its summary forms' states attached —\n    61\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n    62\t// with form states\".\n    63\texport interface ChunkRecord {\n    64\t  chunkId: string;\n    65\t  chunkOrder: number;\n    66\t  status: \"open\" | \"closed\";\n    67\t  accumulatedProjectedTokens: number;\n    68\t  memberTurnIds: string[];\n    69\t  forms?: DerivedForm[];\n    70\t}\n    71\t\n    72\texport interface TurnTransitionOutcome {\n    73\t  // Transitions in occurrence order: a close_then_open reports the close\n    74\t  // first, then the open, exactly as the batch result surfaces them.\n    75\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    76\t  // Turn state after the transition — the stamp for this event's message.\n    77\t  // Prompts see the turn they just opened (transition first, then stamp);\n    78\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    79\t  openTurnId: string | null;\n    80\t  // Work queued by this transition: one turn_derivation item per closed\n    81\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    82\t  queuedWork: WorkItemRecord[];\n    83\t}\n    84\t\n    85\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    86\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    87\t// writes turn state, so more than one open turn means external interference.\n    88\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    89\t  return selectOpenTurnIds(ctx.db);\n    90\t}\n    91\t\n    92\t// Closing a turn — by either close path — durably queues that turn's\n    93\t// derivation work in the same transaction (AC-3.6): the close update and the\n    94\t// work item commit or roll back together.\n    95\tfunction closeTurnAndQueueWork(\n    96\t  ctx: OperationContext,\n    97\t  turnId: string,\n    98\t  eventOrder: number,\n    99\t): WorkItemRecord {\n   100\t  closeTurn(ctx.db, turnId, eventOrder);\n   101\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n   102\t  // lands the rendering and the lower-band projection as independent rows;\n   103\t  // both go pending with the enqueue (DD-5).\n   104\t  return enqueue(ctx, {\n   105\t    owner: \"turns\",\n   106\t    kind: \"turn_derivation\",\n   107\t    sourceRef: { turnId },\n   108\t    forms: [\n   109\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n   110\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n   111\t    ],\n   112\t  });\n   113\t}\n   114\t\n   115\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n   116\t// construction (DD-6): turn derivation and the two chunk summaries.\n   117\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   118\t  turnWorkHandlers;\n   119\t\n   120\t// Cross-domain surface, called by intake-stream inside the batch transaction\n   121\t// for every recorded event. Synchronous and throwing by design, like\n   122\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n   123\texport function applyEvent(\n   124\t  ctx: OperationContext,\n   125\t  eventKind: EventKind,\n   126\t  eventOrder: number,\n   127\t): TurnTransitionOutcome {\n   128\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n   129\t  const effect = transition({ openTurnId }, eventKind);\n   130\t  switch (effect.kind) {\n   131\t    case \"none\":\n   132\t      return { transitions: [], openTurnId, queuedWork: [] };\n   133\t    case \"open\": {\n   134\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   135\t      return {\n   136\t        transitions: [{ action: \"opened\", turnId }],\n   137\t        openTurnId: turnId,\n   138\t        queuedWork: [],\n   139\t      };\n   140\t    }\n   141\t    case \"close\": {\n   142\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   143\t      return {\n   144\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   145\t        openTurnId: null,\n   146\t        queuedWork: [item],\n   147\t      };\n   148\t    }\n   149\t    case \"close_then_open\": {\n   150\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   151\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   152\t      return {\n   153\t        transitions: [\n   154\t          { action: \"closed\", turnId: openTurnId as string },\n   155\t          { action: \"opened\", turnId },\n   156\t        ],\n   157\t        openTurnId: turnId,\n   158\t        queuedWork: [item],\n   159\t      };\n   160\t    }\n   161\t  }\n   162\t}\n   163\t\n   164\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   165\t  return {\n   166\t    ok: false,\n   167\t    error: {\n   168\t      errorClass: \"caller_error\",\n   169\t      code: \"thread_not_found\",\n   170\t      reason: `no thread file exists at ${filePath}`,\n   171\t    },\n   172\t  };\n   173\t}\n   174\t\n   175\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   176\t  const resolved = await resolveThreadRef(thread);\n   177\t  if (!resolved.ok) return resolved;\n   178\t  const { filePath } = resolved.value;\n   179\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   180\t\n   181\t  const opened = openThreadDatabase(filePath);\n   182\t  if (!opened.ok) return opened;\n   183\t  const db = opened.value;\n   184\t  try {\n   185\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n   186\t    // stored derived forms, attached from one grouped query — mirroring the\n   187\t    // message read's production path for \"readable alongside the record\".\n   188\t    const formsByTurn = readOwnedForms(db, \"turn\");\n   189\t    const records = readTurns(db).map((record) => {\n   190\t      const forms = formsByTurn.get(record.turnId);\n   191\t      return forms === undefined ? record : { ...record, forms };\n   192\t    });\n   193\t    return { ok: true, value: records };\n   194\t  } catch (cause) {\n   195\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   196\t    return storageFailure(`turn read-back failed: ${reason}`);\n   197\t  } finally {\n   198\t    db.close();\n   199\t  }\n   200\t}\n   201\t\n   202\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n   203\t// returns stored records whatever the forms' states — reads degrade, never\n   204\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n   205\t// summary rows until close queues them).\n   206\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n   207\t  const resolved = await resolveThreadRef(thread);\n   208\t  if (!resolved.ok) return resolved;\n   209\t  const { filePath } = resolved.value;\n   210\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   211\t\n   212\t  const opened = openThreadDatabase(filePath);\n   213\t  if (!opened.ok) return opened;\n   214\t  const db = opened.value;\n   215\t  try {\n   216\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n   217\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n   218\t      const forms = formsByChunk.get(row.chunkId);\n   219\t      return forms === undefined ? row : { ...row, forms };\n   220\t    });\n   221\t    return { ok: true, value: records };\n   222\t  } catch (cause) {\n   223\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   224\t    return storageFailure(`chunk read-back failed: ${reason}`);\n   225\t  } finally {\n   226\t    db.close();\n   227\t  }\n   228\t}\n   229\t\n   230\texport async function listQueuedWork(\n   231\t  thread: ThreadRef,\n   232\t): Promise<OpResult<WorkItemRecord[]>> {\n   233\t  const resolved = await resolveThreadRef(thread);\n   234\t  if (!resolved.ok) return resolved;\n   235\t  const { filePath } = resolved.value;\n   236\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   237\t\n   238\t  const opened = openThreadDatabase(filePath);\n   239\t  if (!opened.ok) return opened;\n   240\t  const db = opened.value;\n   241\t  try {\n   242\t    return { ok: true, value: listItems(db, \"turns\") };\n   243\t  } catch (cause) {\n   244\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   245\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   246\t  } finally {\n   247\t    db.close();\n   248\t  }\n   249\t}\n   250\t\n   251\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   252\t\n   253\t// This owner's repair report: every turn- and chunk-owned form's durable\n   254\t// state joined with live queue detail in one query. Needs no provider;\n   255\t// reads degrade, never block.\n   256\texport async function report(\n   257\t  thread: ThreadRef,\n   258\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   259\t): Promise<OpResult<FormReportEntry[]>> {\n   260\t  const resolved = await resolveThreadRef(thread);\n   261\t  if (!resolved.ok) return resolved;\n   262\t  const { filePath } = resolved.value;\n   263\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   264\t\n   265\t  const opened = openThreadDatabase(filePath);\n   266\t  if (!opened.ok) return opened;\n   267\t  const db = opened.value;\n   268\t  try {\n   269\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   270\t  } catch (cause) {\n   271\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   272\t    return storageFailure(`report read failed: ${reason}`);\n   273\t  } finally {\n   274\t    db.close();\n   275\t  }\n   276\t}\n   277\t\n   278\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   279\t\n   280\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n   281\t// the one turn_derivation item (the handler lands rendering and projection\n   282\t// together, so a rebuild of either re-derives both — the rebuild rule from\n   283\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n   284\t// independent lifecycles).\n   285\tfunction turnRequeueTarget(target: {\n   286\t  subjectKind: \"turn\" | \"chunk\";\n   287\t  subjectId: string;\n   288\t  form: FormKind;\n   289\t}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n   290\t  if (\n   291\t    target.subjectKind === \"turn\" &&\n   292\t    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n   293\t  ) {\n   294\t    return {\n   295\t      kind: \"turn_derivation\",\n   296\t      sourceRef: { turnId: target.subjectId },\n   297\t      forms: [\n   298\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n   299\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n   300\t      ],\n   301\t    };\n   302\t  }\n   303\t  if (\n   304\t    target.subjectKind === \"chunk\" &&\n   305\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n   306\t  ) {\n   307\t    return {\n   308\t      kind: target.form,\n   309\t      sourceRef: { chunkId: target.subjectId },\n   310\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n   311\t    };\n   312\t  }\n   313\t  return undefined;\n   314\t}\n   315\t\n   316\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   317\t// messages.requeue — blocked refused with the stored damage reason, missing\n   318\t// rows refused, no-op against live work at the current source version, and\n   319\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   320\t// at the next source version: composed forms recompute their gaps from\n   321\t// current dependency states (Flow 3's rebuild rule).\n   322\texport async function requeue(\n   323\t  thread: ThreadRef,\n   324\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n   325\t): Promise<OpResult<RequeueOutcome>> {\n   326\t  const mapped = turnRequeueTarget(target);\n   327\t  if (mapped === undefined) {\n   328\t    return {\n   329\t      ok: false,\n   330\t      error: {\n   331\t        errorClass: \"caller_error\",\n   332\t        code: \"turn_not_found\",\n   333\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   334\t      },\n   335\t    };\n   336\t  }\n   337\t  const resolved = await resolveThreadRef(thread);\n   338\t  if (!resolved.ok) return resolved;\n   339\t  const { filePath } = resolved.value;\n   340\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   341\t\n   342\t  const opened = openThreadDatabase(filePath);\n   343\t  if (!opened.ok) return opened;\n   344\t  const db = opened.value;\n   345\t  try {\n   346\t    const meta = db\n   347\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   348\t      .get() as { thread_id: string } | undefined;\n   349\t    const threadId = meta?.thread_id ?? \"\";\n   350\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   351\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n   352\t      if (row === undefined) {\n   353\t        return {\n   354\t          ok: false,\n   355\t          error: {\n   356\t            errorClass: \"caller_error\",\n   357\t            code: \"turn_not_found\",\n   358\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n   359\t          },\n   360\t        };\n   361\t      }\n   362\t      if (row.state === \"blocked\") {\n   363\t        // The refusal carries the form's stored reason — the damage named at\n   364\t        // blocking time, not a generic string (AC-4.6).\n   365\t        return {\n   366\t          ok: false,\n   367\t          error: {\n   368\t            errorClass: \"state_corruption\",\n   369\t            code: \"source_damaged\",\n   370\t            reason:\n   371\t              row.reason ??\n   372\t              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n   373\t          },\n   374\t        };\n   375\t      }\n   376\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n   377\t        return { ok: true, value: { noop: \"already_queued\" } };\n   378\t      }\n   379\t      const item = enqueue(ctx, {\n   380\t        owner: \"turns\",\n   381\t        kind: mapped.kind,\n   382\t        sourceRef: mapped.sourceRef,\n   383\t        sourceVersion: row.sourceVersion + 1,\n   384\t        forms: mapped.forms,\n   385\t      });\n   386\t      return { ok: true, value: { workItemId: item.workItemId } };\n   387\t    });\n   388\t  } catch (cause) {\n   389\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   390\t    return storageFailure(`requeue failed: ${reason}`);\n   391\t  } finally {\n   392\t    db.close();\n   393\t  }\n   394\t}\n","exit_code":0,"status":"completed"}}

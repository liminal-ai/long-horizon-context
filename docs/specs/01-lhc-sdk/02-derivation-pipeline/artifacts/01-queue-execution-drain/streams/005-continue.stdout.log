{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RgTAgCA56zytnJe3RCw7y2","type":"tool_result","content":"1\t// Builds a thread file with the accepted Story 2 on-disk schema (commit\n2\t// 7c8623d): thread_metadata + event tables only, PRAGMA user_version = 1.\n3\t// Current code can no longer create this shape — that is the point: the\n4\t// fixture stands in for a real file recorded before Story 3 shipped, so the\n5\t// lazy upgrade path (F-03-001) is exercised against the true legacy layout.\n6\t// Below-SDK writer, sanctioned for the same reason corrupt.ts is: the state\n7\t// is unreachable through the current SDK.\n8\timport { DatabaseSync } from \"node:sqlite\";\n9\t\n10\texport interface LegacyRecordedEvent {\n11\t  eventOrder: number;\n12\t  eventKind: string;\n13\t  idempotencyKey: string;\n14\t  actor: string;\n15\t  harness: string;\n16\t  payload: Record<string, unknown>;\n17\t  recordedAt: string;\n18\t}\n19\t\n20\texport function legacyStory2ThreadFile(\n21\t  filePath: string,\n22\t  threadId: string,\n23\t  recordedEvents: readonly LegacyRecordedEvent[] = [],\n24\t): void {\n25\t  const db = new DatabaseSync(filePath);\n26\t  try {\n27\t    db.exec(\"PRAGMA journal_mode = WAL;\");\n28\t    db.exec(\"BEGIN IMMEDIATE;\");\n29\t    db.exec(`CREATE TABLE thread_metadata (\n30\t      id INTEGER PRIMARY KEY CHECK (id = 1),\n31\t      thread_id TEXT NOT NULL,\n32\t      created_at TEXT NOT NULL,\n33\t      token_estimator TEXT NOT NULL\n34\t    );`);\n35\t    db.prepare(\n36\t      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n37\t       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n38\t    ).run(threadId, \"2026-06-01T00:00:00.000Z\");\n39\t    db.exec(`CREATE TABLE event (\n40\t      event_order INTEGER PRIMARY KEY,\n41\t      event_kind TEXT NOT NULL,\n42\t      idempotency_key TEXT NOT NULL UNIQUE,\n43\t      actor TEXT NOT NULL,\n44\t      harness TEXT NOT NULL,\n45\t      payload TEXT NOT NULL,\n46\t      recorded_at TEXT NOT NULL\n47\t    );`);\n48\t    const insert = db.prepare(\n49\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n50\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n51\t    );\n52\t    for (const event of recordedEvents) {\n53\t      insert.run(\n54\t        event.eventOrder,\n55\t        event.eventKind,\n56\t        event.idempotencyKey,\n57\t        event.actor,\n58\t        event.harness,\n59\t        JSON.stringify(event.payload),\n60\t        event.recordedAt,\n61\t      );\n62\t    }\n63\t    db.exec(\"PRAGMA user_version = 1;\");\n64\t    db.exec(\"COMMIT;\");\n65\t  } finally {\n66\t    db.close();\n67\t  }\n68\t}\n69\t\n70\t// Builds a thread file with the accepted Epic 01 on-disk schema (v4: the\n71\t// Story 5 work_item table, pre-Epic-02 column set, unversioned work-item\n72\t// ids), populated with a recorded conversation and live queued work. Current\n73\t// code can no longer create this shape — migration v5 runs at every open —\n74\t// so the fixture stands in for a real Epic 01 file at upgrade time (FC-0.5,\n75\t// F-02 backfill). Below-SDK writer, sanctioned like legacyStory2ThreadFile.\n76\texport function legacyEpic01ThreadFile(filePath: string, threadId: string): void {\n77\t  const db = new DatabaseSync(filePath);\n78\t  const recordedAt = \"2026-06-09T00:00:00.000Z\";\n79\t  try {\n80\t    db.exec(\"PRAGMA journal_mode = WAL;\");\n81\t    db.exec(\"BEGIN IMMEDIATE;\");\n82\t    db.exec(`CREATE TABLE thread_metadata (\n83\t      id INTEGER PRIMARY KEY CHECK (id = 1),\n84\t      thread_id TEXT NOT NULL,\n85\t      created_at TEXT NOT NULL,\n86\t      token_estimator TEXT NOT NULL\n87\t    );`);\n88\t    db.prepare(\n89\t      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n90\t       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n91\t    ).run(threadId, recordedAt);\n92\t    db.exec(`CREATE TABLE event (\n93\t      event_order INTEGER PRIMARY KEY,\n94\t      event_kind TEXT NOT NULL,\n95\t      idempotency_key TEXT NOT NULL UNIQUE,\n96\t      actor TEXT NOT NULL,\n97\t      harness TEXT NOT NULL,\n98\t      payload TEXT NOT NULL,\n99\t      recorded_at TEXT NOT NULL\n100\t    );`);\n101\t    db.exec(`CREATE TABLE message (\n102\t      message_id TEXT PRIMARY KEY,\n103\t      source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n104\t      kind TEXT NOT NULL,\n105\t      token_estimate INTEGER NOT NULL,\n106\t      actor TEXT NOT NULL,\n107\t      harness TEXT NOT NULL,\n108\t      turn_id TEXT\n109\t    );`);\n110\t    db.exec(`CREATE TABLE message_block (\n111\t      message_id TEXT NOT NULL REFERENCES message(message_id),\n112\t      block_index INTEGER NOT NULL,\n113\t      block_type TEXT NOT NULL,\n114\t      content TEXT NOT NULL,\n115\t      PRIMARY KEY (message_id, block_index)\n116\t    );`);\n117\t    db.exec(`CREATE TABLE turns (\n118\t      turn_id TEXT PRIMARY KEY,\n119\t      turn_order INTEGER NOT NULL UNIQUE,\n120\t      status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n121\t      opened_at_event_order INTEGER NOT NULL,\n122\t      closed_at_event_order INTEGER\n123\t    );`);\n124\t    db.exec(`CREATE TABLE work_item (\n125\t      work_item_id TEXT PRIMARY KEY,\n126\t      owner TEXT NOT NULL,\n127\t      kind TEXT NOT NULL,\n128\t      source_ref TEXT NOT NULL,\n129\t      status TEXT NOT NULL,\n130\t      queued_at TEXT NOT NULL\n131\t    );`);\n132\t\n133\t    const insertEvent = db.prepare(\n134\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n135\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n136\t    );\n137\t    const events: Array<[number, string, Record<string, unknown>]> = [\n138\t      [1, \"user_prompt\", { text: \"legacy prompt recorded under epic 01\" }],\n139\t      [2, \"tool_call\", { toolCallId: \"call-legacy-1\", toolName: \"read_file\", arguments: { path: \"n.txt\" } }],\n140\t      [3, \"tool_result\", { toolCallId: \"call-legacy-1\", content: \"legacy tool output\", isError: false }],\n141\t      [4, \"turn_end\", {}],\n142\t    ];\n143\t    for (const [order, kind, payload] of events) {\n144\t      insertEvent.run(\n145\t        order,\n146\t        kind,\n147\t        `legacy-epic01-key-${order}`,\n148\t        \"legacy-actor\",\n149\t        \"legacy-harness\",\n150\t        JSON.stringify(payload),\n151\t        recordedAt,\n152\t      );\n153\t    }\n154\t\n155\t    const insertMessage = db.prepare(\n156\t      `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n157\t       VALUES (?, ?, ?, ?, 'legacy-actor', 'legacy-harness', 't1')`,\n158\t    );\n159\t    insertMessage.run(\"m1\", 1, \"user_prompt\", 9);\n160\t    insertMessage.run(\"m2\", 2, \"tool_call\", 12);\n161\t    insertMessage.run(\"m3\", 3, \"tool_result\", 7);\n162\t    const insertBlock = db.prepare(\n163\t      `INSERT INTO message_block (message_id, block_index, block_type, content)\n164\t       VALUES (?, 0, ?, ?)`,\n165\t    );\n166\t    insertBlock.run(\"m1\", \"text\", JSON.stringify({ text: \"legacy prompt recorded under epic 01\" }));\n167\t    insertBlock.run(\n168\t      \"m2\",\n169\t      \"tool_call\",\n170\t      JSON.stringify({ toolCallId: \"call-legacy-1\", toolName: \"read_file\", arguments: { path: \"n.txt\" } }),\n171\t    );\n172\t    insertBlock.run(\n173\t      \"m3\",\n174\t      \"tool_result\",\n175\t      JSON.stringify({ toolCallId: \"call-legacy-1\", content: \"legacy tool output\", isError: false }),\n176\t    );\n177\t\n178\t    db.prepare(\n179\t      `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order, closed_at_event_order)\n180\t       VALUES ('t1', 1, 'closed', 1, 4)`,\n181\t    ).run();\n182\t\n183\t    // Live queued items with Epic 01's unversioned ids — exactly what the\n184\t    // F-02 backfill must cover with pending derived_form rows at version 1.\n185\t    const insertItem = db.prepare(\n186\t      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n187\t       VALUES (?, ?, ?, ?, 'queued', ?)`,\n188\t    );\n189\t    insertItem.run(\n190\t      \"w-m1-prompt_smoothing\",\n191\t      \"messages\",\n192\t      \"prompt_smoothing\",\n193\t      JSON.stringify({ messageId: \"m1\" }),\n194\t      recordedAt,\n195\t    );\n196\t    insertItem.run(\n197\t      \"w-m3-tool_result_summary\",\n198\t      \"messages\",\n199\t      \"tool_result_summary\",\n200\t      JSON.stringify({ messageId: \"m3\" }),\n201\t      recordedAt,\n202\t    );\n203\t    insertItem.run(\n204\t      \"w-t1-turn_derivation\",\n205\t      \"turns\",\n206\t      \"turn_derivation\",\n207\t      JSON.stringify({ turnId: \"t1\" }),\n208\t      recordedAt,\n209\t    );\n210\t\n211\t    db.exec(\"PRAGMA user_version = 4;\");\n212\t    db.exec(\"COMMIT;\");\n213\t  } finally {\n214\t    db.close();\n215\t  }\n216\t}\n217\t\n218\texport function schemaVersionOf(filePath: string): number {\n219\t  const db = new DatabaseSync(filePath);\n220\t  try {\n221\t    const row = db.prepare(\"PRAGMA user_version\").get() as\n222\t      | { user_version: number | bigint }\n223\t      | undefined;\n224\t    return Number(row?.user_version ?? 0);\n225\t  } finally {\n226\t    db.close();\n227\t  }\n228\t}\n229\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"010f5999-032e-479f-9af2-ff388cfa3101","timestamp":"2026-06-11T04:07:22.939Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/legacy.ts","content":"// Builds a thread file with the accepted Story 2 on-disk schema (commit\n// 7c8623d): thread_metadata + event tables only, PRAGMA user_version = 1.\n// Current code can no longer create this shape — that is the point: the\n// fixture stands in for a real file recorded before Story 3 shipped, so the\n// lazy upgrade path (F-03-001) is exercised against the true legacy layout.\n// Below-SDK writer, sanctioned for the same reason corrupt.ts is: the state\n// is unreachable through the current SDK.\nimport { DatabaseSync } from \"node:sqlite\";\n\nexport interface LegacyRecordedEvent {\n  eventOrder: number;\n  eventKind: string;\n  idempotencyKey: string;\n  actor: string;\n  harness: string;\n  payload: Record<string, unknown>;\n  recordedAt: string;\n}\n\nexport function legacyStory2ThreadFile(\n  filePath: string,\n  threadId: string,\n  recordedEvents: readonly LegacyRecordedEvent[] = [],\n): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    db.exec(\"PRAGMA journal_mode = WAL;\");\n    db.exec(\"BEGIN IMMEDIATE;\");\n    db.exec(`CREATE TABLE thread_metadata (\n      id INTEGER PRIMARY KEY CHECK (id = 1),\n      thread_id TEXT NOT NULL,\n      created_at TEXT NOT NULL,\n      token_estimator TEXT NOT NULL\n    );`);\n    db.prepare(\n      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n    ).run(threadId, \"2026-06-01T00:00:00.000Z\");\n    db.exec(`CREATE TABLE event (\n      event_order INTEGER PRIMARY KEY,\n      event_kind TEXT NOT NULL,\n      idempotency_key TEXT NOT NULL UNIQUE,\n      actor TEXT NOT NULL,\n      harness TEXT NOT NULL,\n      payload TEXT NOT NULL,\n      recorded_at TEXT NOT NULL\n    );`);\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n    for (const event of recordedEvents) {\n      insert.run(\n        event.eventOrder,\n        event.eventKind,\n        event.idempotencyKey,\n        event.actor,\n        event.harness,\n        JSON.stringify(event.payload),\n        event.recordedAt,\n      );\n    }\n    db.exec(\"PRAGMA user_version = 1;\");\n    db.exec(\"COMMIT;\");\n  } finally {\n    db.close();\n  }\n}\n\n// Builds a thread file with the accepted Epic 01 on-disk schema (v4: the\n// Story 5 work_item table, pre-Epic-02 column set, unversioned work-item\n// ids), populated with a recorded conversation and live queued work. Current\n// code can no longer create this shape — migration v5 runs at every open —\n// so the fixture stands in for a real Epic 01 file at upgrade time (FC-0.5,\n// F-02 backfill). Below-SDK writer, sanctioned like legacyStory2ThreadFile.\nexport function legacyEpic01ThreadFile(filePath: string, threadId: string): void {\n  const db = new DatabaseSync(filePath);\n  const recordedAt = \"2026-06-09T00:00:00.000Z\";\n  try {\n    db.exec(\"PRAGMA journal_mode = WAL;\");\n    db.exec(\"BEGIN IMMEDIATE;\");\n    db.exec(`CREATE TABLE thread_metadata (\n      id INTEGER PRIMARY KEY CHECK (id = 1),\n      thread_id TEXT NOT NULL,\n      created_at TEXT NOT NULL,\n      token_estimator TEXT NOT NULL\n    );`);\n    db.prepare(\n      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n    ).run(threadId, recordedAt);\n    db.exec(`CREATE TABLE event (\n      event_order INTEGER PRIMARY KEY,\n      event_kind TEXT NOT NULL,\n      idempotency_key TEXT NOT NULL UNIQUE,\n      actor TEXT NOT NULL,\n      harness TEXT NOT NULL,\n      payload TEXT NOT NULL,\n      recorded_at TEXT NOT NULL\n    );`);\n    db.exec(`CREATE TABLE message (\n      message_id TEXT PRIMARY KEY,\n      source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n      kind TEXT NOT NULL,\n      token_estimate INTEGER NOT NULL,\n      actor TEXT NOT NULL,\n      harness TEXT NOT NULL,\n      turn_id TEXT\n    );`);\n    db.exec(`CREATE TABLE message_block (\n      message_id TEXT NOT NULL REFERENCES message(message_id),\n      block_index INTEGER NOT NULL,\n      block_type TEXT NOT NULL,\n      content TEXT NOT NULL,\n      PRIMARY KEY (message_id, block_index)\n    );`);\n    db.exec(`CREATE TABLE turns (\n      turn_id TEXT PRIMARY KEY,\n      turn_order INTEGER NOT NULL UNIQUE,\n      status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n      opened_at_event_order INTEGER NOT NULL,\n      closed_at_event_order INTEGER\n    );`);\n    db.exec(`CREATE TABLE work_item (\n      work_item_id TEXT PRIMARY KEY,\n      owner TEXT NOT NULL,\n      kind TEXT NOT NULL,\n      source_ref TEXT NOT NULL,\n      status TEXT NOT NULL,\n      queued_at TEXT NOT NULL\n    );`);\n\n    const insertEvent = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n    const events: Array<[number, string, Record<string, unknown>]> = [\n      [1, \"user_prompt\", { text: \"legacy prompt recorded under epic 01\" }],\n      [2, \"tool_call\", { toolCallId: \"call-legacy-1\", toolName: \"read_file\", arguments: { path: \"n.txt\" } }],\n      [3, \"tool_result\", { toolCallId: \"call-legacy-1\", content: \"legacy tool output\", isError: false }],\n      [4, \"turn_end\", {}],\n    ];\n    for (const [order, kind, payload] of events) {\n      insertEvent.run(\n        order,\n        kind,\n        `legacy-epic01-key-${order}`,\n        \"legacy-actor\",\n        \"legacy-harness\",\n        JSON.stringify(payload),\n        recordedAt,\n      );\n    }\n\n    const insertMessage = db.prepare(\n      `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n       VALUES (?, ?, ?, ?, 'legacy-actor', 'legacy-harness', 't1')`,\n    );\n    insertMessage.run(\"m1\", 1, \"user_prompt\", 9);\n    insertMessage.run(\"m2\", 2, \"tool_call\", 12);\n    insertMessage.run(\"m3\", 3, \"tool_result\", 7);\n    const insertBlock = db.prepare(\n      `INSERT INTO message_block (message_id, block_index, block_type, content)\n       VALUES (?, 0, ?, ?)`,\n    );\n    insertBlock.run(\"m1\", \"text\", JSON.stringify({ text: \"legacy prompt recorded under epic 01\" }));\n    insertBlock.run(\n      \"m2\",\n      \"tool_call\",\n      JSON.stringify({ toolCallId: \"call-legacy-1\", toolName: \"read_file\", arguments: { path: \"n.txt\" } }),\n    );\n    insertBlock.run(\n      \"m3\",\n      \"tool_result\",\n      JSON.stringify({ toolCallId: \"call-legacy-1\", content: \"legacy tool output\", isError: false }),\n    );\n\n    db.prepare(\n      `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order, closed_at_event_order)\n       VALUES ('t1', 1, 'closed', 1, 4)`,\n    ).run();\n\n    // Live queued items with Epic 01's unversioned ids — exactly what the\n    // F-02 backfill must cover with pending derived_form rows at version 1.\n    const insertItem = db.prepare(\n      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n       VALUES (?, ?, ?, ?, 'queued', ?)`,\n    );\n    insertItem.run(\n      \"w-m1-prompt_smoothing\",\n      \"messages\",\n      \"prompt_smoothing\",\n      JSON.stringify({ messageId: \"m1\" }),\n      recordedAt,\n    );\n    insertItem.run(\n      \"w-m3-tool_result_summary\",\n      \"messages\",\n      \"tool_result_summary\",\n      JSON.stringify({ messageId: \"m3\" }),\n      recordedAt,\n    );\n    insertItem.run(\n      \"w-t1-turn_derivation\",\n      \"turns\",\n      \"turn_derivation\",\n      JSON.stringify({ turnId: \"t1\" }),\n      recordedAt,\n    );\n\n    db.exec(\"PRAGMA user_version = 4;\");\n    db.exec(\"COMMIT;\");\n  } finally {\n    db.close();\n  }\n}\n\nexport function schemaVersionOf(filePath: string): number {\n  const db = new DatabaseSync(filePath);\n  try {\n    const row = db.prepare(\"PRAGMA user_version\").get() as\n      | { user_version: number | bigint }\n      | undefined;\n    return Number(row?.user_version ?? 0);\n  } finally {\n    db.close();\n  }\n}\n","numLines":229,"startLine":1,"totalLines":229}}}

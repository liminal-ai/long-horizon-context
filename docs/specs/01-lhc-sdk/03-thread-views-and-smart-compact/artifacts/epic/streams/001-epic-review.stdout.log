\n  private async run(\\n    op: ProviderOpName,\\n    input: unknown,\\n    text: string,\\n    suffix = \\\"\\\",\\n  ): Promise<ProviderResult> {\\n    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\\n    const delay = this.delayByOp.get(op);\\n    if (delay !== undefined && delay > 0) {\\n      await new Promise((resolve) => setTimeout(resolve, delay));\\n    }\\n    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\\n    for (const script of scripts) {\\n      if (script !== null && script.remaining > 0) {\\n        script.remaining -= 1;\\n        return { ok: false, retryable: script.retryable, reason: script.reason };\\n      }\\n    }\\n    // Output format shared with src/providers/deterministic.ts so the double\\n    // and the registry's \\\"deterministic\\\" provider produce byte-identical\\n    // artifacts across in-process and spawned runs; the chunk-summary\\n    // receipt/outcome suffixes (AC-3.8) come from the same shared helpers.\\n    return { ok: true, text: deterministicText(op, input, text) + suffix };\\n  }\\n\\n  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\\n    return this.run(\\\"smoothPrompt\\\", i, i.text);\\n  }\\n\\n  summarizeToolCall(i: {\\n    toolName: string;\\n    argsJson: string;\\n    pairedResult?: { content: string; isError: boolean };\\n  }): Promise<ProviderResult> {\\n    return this.run(\\\"summarizeToolCall\\\", i, `${i.toolName} ${i.argsJson}`);\\n  }\\n\\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\\n    return this.run(\\\"summarizeToolResult\\\", i, i.content);\\n  }\\n\\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\\n    return this.run(\\\"composeTurnRendering\\\", i, i.parts.map((p) => p.text).join(\\\" | \\\"));\\n  }\\n\\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\\n    return this.run(\\\"projectLowerBand\\\", i, i.rendering);\\n  }\\n\\n  summarizeChunkDetailed(i: {\\n    memberProjections: string[];\\n    memberReceipts?: ToolRunReceipt[][];\\n  }): Promise<ProviderResult> {\\n    return this.run(\\n      \\\"summarizeChunkDetailed\\\",\\n      i,\\n      i.memberProjections.join(\\\" | \\\"),\\n      deterministicReceiptsSuffix(i.memberReceipts),\\n    );\\n  }\\n\\n  summarizeChunkBrief(i: {\\n    memberProjections: string[];\\n    memberOutcomes?: ToolOutcome[][];\\n  }): Promise<ProviderResult> {\\n    return this.run(\\n      \\\"summarizeChunkBrief\\\",\\n      i,\\n      i.memberProjections.join(\\\" | \\\"),\\n      deterministicOutcomesSuffix(i.memberOutcomes),\\n    );\\n---\\ntest/view-pull.test.ts:169:    // The double's capture log starts recording here; any Epic 03 read that\\ntest/view-pull.test.ts:172:    const captured = fixture.double.captureInputs();\\ntest/view-pull.test.ts:188:    expect(captured.length).toBe(0);\\ntest/view-pull.test.ts:396:    const captured = heavy.double.captureInputs();\\ntest/view-pull.test.ts:430:    expect(captured.length).toBe(0);\\ntest/view-pull.test.ts:493:    const captured = bgDouble.captureInputs();\\ntest/view-pull.test.ts:518:    expect(captured.length).toBe(0);\\ntest/view-compact.test.ts:229:    const captured = fixture.double.captureInputs();\\ntest/view-compact.test.ts:230:    const capturedBefore = captured.length;\\ntest/view-compact.test.ts:280:    expect(captured.length).toBe(capturedBefore);\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"f006cddb-2184-479e-939b-55dccd3023e3\",\"uuid\":\"6c1f7798-aa56-4b43-9be2-fabf5b0c66fa\",\"timestamp\":\"2026-06-11T16:38:31.157Z\",\"tool_use_result\":{\"stdout\":\"  // Fail the next n calls to any operation, then succeed.\\n  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\\n    this.failNextScript = {\\n      remaining: n,\\n      retryable: opts?.retryable ?? true,\\n      reason: opts?.reason ?? \\\"scripted failure (failNext)\\\",\\n   
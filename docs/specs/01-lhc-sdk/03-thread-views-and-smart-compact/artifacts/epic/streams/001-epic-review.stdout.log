{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012cMWB36Ai51n13GM8ep1op","type":"tool_result","content":"1\t// Band selection (Story 2): the six-rule walk from tech design §Deterministic\n2\t// Algorithms — compact point, smooth/detailed/brief fills, rule-5 unchunked\n3\t// turns, rule-6 turnless stragglers — plus the coverage edge (covered_from)\n4\t// and canonical-corruption detection. Two halves, deliberately split:\n5\t//\n6\t//   - readSelectionInputs: the record/forms reads, with the corruption check\n7\t//     IN the reads, before any transaction opens (story Technical Notes) —\n8\t//     a refusal here means nothing was written, so the prior view is\n9\t//     trivially intact (AC-2.5). Never moved inside the transaction.\n10\t//   - selectArrangement: a pure function over those inputs. No DB handle, no\n11\t//     clock, no provider — same inputs ⇒ same arrangement, byte-for-byte\n12\t//     (AC-2.9; goldens G1–G4 pin the tie-breakers).\n13\t//\n14\t// Tie-breakers, pinned (tech design): inclusion thresholds are ≤; walks are\n15\t// newest-first everywhere; chunk coverage is decided by the chunk's newest\n16\t// member turn. Entry costs are the tokens of the rendered entry text itself\n17\t// (render.ts's renderArrangementEntry, including attached inter-turn notes),\n18\t// so the budgeted tokens are the stored tokens — no second estimate.\n19\timport type { DatabaseSync } from \"node:sqlite\";\n20\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n21\timport type { Band } from \"../../../shared/view.js\";\n22\timport {\n23\t  excerptLine,\n24\t  renderArrangementEntry,\n25\t  resolveBriefRepresentation,\n26\t  resolveDetailedRepresentation,\n27\t  resolveSmoothRepresentation,\n28\t  type FormSnapshot,\n29\t} from \"./render.js\";\n30\t\n31\t// Canonical source state needed to identify or read the compacted span is\n32\t// damaged: compact refuses with state_corruption (AC-2.5). Derived-material\n33\t// damage never raises this — it degrades through the ladders instead.\n34\texport class CanonicalCorruptionError extends Error {\n35\t  readonly code: \"turn_state_corrupt\" | \"source_damaged\";\n36\t  constructor(code: \"turn_state_corrupt\" | \"source_damaged\", reason: string) {\n37\t    super(reason);\n38\t    this.code = code;\n39\t    this.name = \"CanonicalCorruptionError\";\n40\t  }\n41\t}\n42\t\n43\texport interface SelectionMessage {\n44\t  messageId: string;\n45\t  order: number; // source_event_order\n46\t  kind: string;\n47\t  tokenEstimate: number;\n48\t  turnId: string | null;\n49\t  text: string; // excerpt/note line (render.excerptLine)\n50\t}\n51\t\n52\texport interface SelectionTurn {\n53\t  turnId: string;\n54\t  turnOrder: number;\n55\t  status: \"open\" | \"closed\";\n56\t  openedAt: number;\n57\t  closedAt: number | null;\n58\t}\n59\t\n60\texport interface SelectionChunk {\n61\t  chunkId: string;\n62\t  chunkOrder: number;\n63\t  status: \"open\" | \"closed\";\n64\t  memberTurnIds: string[]; // member order\n65\t}\n66\t\n67\texport interface SelectionInputs {\n68\t  messages: SelectionMessage[]; // live only, ascending order\n69\t  turns: SelectionTurn[]; // ascending turnOrder\n70\t  chunks: SelectionChunk[]; // ascending chunkOrder\n71\t  forms: Map<string, FormSnapshot>; // `${subjectId}/${form}` (turn/chunk subjects)\n72\t  maxEventOrder: number;\n73\t  formCounts: Record<string, Record<string, number>>; // form → state → count\n74\t}\n75\t\n76\texport interface ArrangementEntry {\n77\t  band: Band;\n78\t  subjectKind: \"turn\" | \"chunk\";\n79\t  subjectId: string;\n80\t  formUsed: string;\n81\t  degraded: boolean;\n82\t  gap: boolean;\n83\t  reason?: string; // gap entries\n84\t  startOrder: number; // oldest event order the entry represents (notes included)\n85\t  text: string; // rendered entry text (the band stores this verbatim)\n86\t  tokens: number;\n87\t}\n88\t\n89\texport interface SelectionResult {\n90\t  compactPoint: number;\n91\t  coveredFrom: number;\n92\t  // Gradient order (brief → detailed → smooth), oldest-first within band —\n93\t  // the order the bands render and the arrangement persists.\n94\t  entries: ArrangementEntry[];\n95\t}\n96\t\n97\t// ── reads (corruption check lives here, pre-transaction) ─────────\n98\t\n99\texport function readSelectionInputs(db: DatabaseSync): SelectionInputs {\n100\t  const turnRows = db\n101\t    .prepare(\n102\t      `SELECT turn_id, turn_order, status, opened_at_event_order, closed_at_event_order, deleted_at\n103\t       FROM turns ORDER BY turn_order`,\n104\t    )\n105\t    .all() as unknown as Array<{\n106\t    turn_id: string;\n107\t    turn_order: number | bigint;\n108\t    status: string;\n109\t    opened_at_event_order: number | bigint;\n110\t    closed_at_event_order: number | bigint | null;\n111\t    deleted_at: string | null;\n112\t  }>;\n113\t  // Referential checks compare against every turn row (a tombstoned turn is\n114\t  // a legitimate reference target, not damage); the selection walk itself\n115\t  // sees live turns only.\n116\t  const turnIds = new Set(turnRows.map((row) => row.turn_id));\n117\t  const turns: SelectionTurn[] = turnRows\n118\t    .filter((row) => row.deleted_at === null)\n119\t    .map((row) => ({\n120\t      turnId: row.turn_id,\n121\t      turnOrder: Number(row.turn_order),\n122\t      status: row.status as \"open\" | \"closed\",\n123\t      openedAt: Number(row.opened_at_event_order),\n124\t      closedAt: row.closed_at_event_order === null ? null : Number(row.closed_at_event_order),\n125\t    }));\n126\t\n127\t  // Canonical damage the walk cannot select across (AC-2.5): the Epic 01\n128\t  // turn-state invariant (at most one open turn, open turns carry no close),\n129\t  // and referential damage between the chunk/message rows and their turns.\n130\t  const openTurns = turns.filter((turn) => turn.status === \"open\");\n131\t  if (openTurns.length > 1) {\n132\t    throw new CanonicalCorruptionError(\n133\t      \"turn_state_corrupt\",\n134\t      `canonical turn state corrupt: ${openTurns.length} open turns (${openTurns\n135\t        .map((turn) => turn.turnId)\n136\t        .join(\", \")}); the compacted span cannot be identified`,\n137\t    );\n138\t  }\n139\t  for (const turn of turns) {\n140\t    if (turn.status === \"closed\" && turn.closedAt === null) {\n141\t      throw new CanonicalCorruptionError(\n142\t        \"source_damaged\",\n143\t        `canonical turn state corrupt: closed turn ${turn.turnId} carries no close boundary`,\n144\t      );\n145\t    }\n146\t  }\n147\t\n148\t  const messageRows = db\n149\t    .prepare(\n150\t      `SELECT message_id, source_event_order, kind, token_estimate, turn_id\n151\t       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\n152\t    )\n153\t    .all() as unknown as Array<{\n154\t    message_id: string;\n155\t    source_event_order: number | bigint;\n156\t    kind: string;\n157\t    token_estimate: number | bigint;\n158\t    turn_id: string | null;\n159\t  }>;\n160\t  const blockRows = db\n161\t    .prepare(\n162\t      `SELECT mb.message_id, mb.block_type, mb.content\n163\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n164\t       WHERE m.deleted_at IS NULL\n165\t       ORDER BY m.source_event_order, mb.block_index`,\n166\t    )\n167\t    .all() as unknown as Array<{ message_id: string; block_type: string; content: string }>;\n168\t  const blocksByMessage = new Map<\n169\t    string,\n170\t    Array<{ blockType: string; content: Record<string, unknown> }>\n171\t  >();\n172\t  for (const row of blockRows) {\n173\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n174\t    blocks.push({\n175\t      blockType: row.block_type,\n176\t      content: JSON.parse(row.content) as Record<string, unknown>,\n177\t    });\n178\t    blocksByMessage.set(row.message_id, blocks);\n179\t  }\n180\t  const messages: SelectionMessage[] = messageRows.map((row) => {\n181\t    if (row.turn_id !== null && !turnIds.has(row.turn_id)) {\n182\t      throw new CanonicalCorruptionError(\n183\t        \"source_damaged\",\n184\t        `canonical record corrupt: message ${row.message_id} references missing turn ${row.turn_id}`,\n185\t      );\n186\t    }\n187\t    return {\n188\t      messageId: row.message_id,\n189\t      order: Number(row.source_event_order),\n190\t      kind: row.kind,\n191\t      tokenEstimate: Number(row.token_estimate),\n192\t      turnId: row.turn_id,\n193\t      text: excerptLine(row.kind, blocksByMessage.get(row.message_id) ?? []),\n194\t    };\n195\t  });\n196\t\n197\t  const chunkRows = db\n198\t    .prepare(`SELECT chunk_id, chunk_order, status FROM chunk ORDER BY chunk_order`)\n199\t    .all() as unknown as Array<{ chunk_id: string; chunk_order: number | bigint; status: string }>;\n200\t  const memberRows = db\n201\t    .prepare(\n202\t      `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n203\t       JOIN chunk c ON c.chunk_id = cm.chunk_id\n204\t       ORDER BY c.chunk_order, cm.member_idx`,\n205\t    )\n206\t    .all() as unknown as Array<{ chunk_id: string; turn_id: string; member_idx: number | bigint }>;\n207\t  const membersByChunk = new Map<string, string[]>();\n208\t  for (const row of memberRows) {\n209\t    if (!turnIds.has(row.turn_id)) {\n210\t      throw new CanonicalCorruptionError(\n211\t        \"source_damaged\",\n212\t        `canonical record corrupt: chunk ${row.chunk_id} membership references missing turn ${row.turn_id}`,\n213\t      );\n214\t    }\n215\t    const members = membersByChunk.get(row.chunk_id) ?? [];\n216\t    members.push(row.turn_id);\n217\t    membersByChunk.set(row.chunk_id, members);\n218\t  }\n219\t  const chunks: SelectionChunk[] = chunkRows.map((row) => ({\n220\t    chunkId: row.chunk_id,\n221\t    chunkOrder: Number(row.chunk_order),\n222\t    status: row.status as \"open\" | \"closed\",\n223\t    memberTurnIds: membersByChunk.get(row.chunk_id) ?? [],\n224\t  }));\n225\t\n226\t  const formRows = db\n227\t    .prepare(\n228\t      `SELECT subject_id, form, state, content, reason FROM derived_form\n229\t       WHERE subject_kind IN ('turn', 'chunk')`,\n230\t    )\n231\t    .all() as unknown as Array<{\n232\t    subject_id: string;\n233\t    form: string;\n234\t    state: string;\n235\t    content: string | null;\n236\t    reason: string | null;\n237\t  }>;\n238\t  const forms = new Map<string, FormSnapshot>();\n239\t  for (const row of formRows) {\n240\t    const snapshot: FormSnapshot = { state: row.state as FormSnapshot[\"state\"] };\n241\t    if (row.content !== null) snapshot.content = row.content;\n242\t    if (row.reason !== null) snapshot.reason = row.reason;\n243\t    forms.set(`${row.subject_id}/${row.form}`, snapshot);\n244\t  }\n245\t\n246\t  const maxRow = db.prepare(`SELECT COALESCE(MAX(event_order), 0) AS m FROM event`).get() as {\n247\t    m: number | bigint;\n248\t  };\n249\t  const countRows = db\n250\t    .prepare(`SELECT form, state, COUNT(*) AS n FROM derived_form GROUP BY form, state`)\n251\t    .all() as unknown as Array<{ form: string; state: string; n: number | bigint }>;\n252\t  const formCounts: Record<string, Record<string, number>> = {};\n253\t  for (const row of countRows) {\n254\t    formCounts[row.form] = { ...formCounts[row.form], [row.state]: Number(row.n) };\n255\t  }\n256\t\n257\t  return { messages, turns, chunks, forms, maxEventOrder: Number(maxRow.m), formCounts };\n258\t}\n259\t\n260\t// ── the pure walk ─────────────────────────────────────────────────\n261\t\n262\texport interface SelectionConfig {\n263\t  lowerBound: number;\n264\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n265\t}\n266\t\n267\texport function selectArrangement(\n268\t  inputs: SelectionInputs,\n269\t  config: SelectionConfig,\n270\t): SelectionResult {\n271\t  const { messages, turns, chunks, forms } = inputs;\n272\t  const lookup = (subjectId: string, form: string): FormSnapshot | undefined =>\n273\t    forms.get(`${subjectId}/${form}`);\n274\t  const budget = (share: number): number => (config.lowerBound * share) / 100;\n275\t\n276\t  const turnsById = new Map(turns.map((turn) => [turn.turnId, turn]));\n277\t  const messagesByTurn = new Map<string, SelectionMessage[]>();\n278\t  for (const message of messages) {\n279\t    if (message.turnId === null) continue;\n280\t    const list = messagesByTurn.get(message.turnId) ?? [];\n281\t    list.push(message);\n282\t    messagesByTurn.set(message.turnId, list);\n283\t  }\n284\t\n285\t  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\n286\t  // band assignment, price into its fill cost, and render marked immediately\n287\t  // before its entry. No following turn ⇒ tail by construction.\n288\t  const notesByTurn = new Map<string, SelectionMessage[]>();\n289\t  for (const message of messages) {\n290\t    if (message.turnId !== null) continue;\n291\t    const following = turns.find((turn) => turn.openedAt > message.order);\n292\t    if (following === undefined) continue; // trailing straggler: tail\n293\t    const list = notesByTurn.get(following.turnId) ?? [];\n294\t    list.push(message);\n295\t    notesByTurn.set(following.turnId, list);\n296\t  }\n297\t\n298\t  // The oldest event order a turn's entry represents: its oldest live\n299\t  // message or attached note, falling back to its open boundary.\n300\t  function turnStartOrder(turn: SelectionTurn): number {\n301\t    const candidates = [\n302\t      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\n303\t      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\n304\t    ];\n305\t    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\n306\t  }\n307\t\n308\t  // Rule 1 — compact point: messages newest-first until the estimate sum\n309\t  // first reaches the full share; the point snaps to a turn boundary so the\n310\t  // tail never begins mid-turn. Open-turn messages always land in the tail.\n311\t  const fullBudget = budget(config.percentages.full);\n312\t  const closedTurns = turns.filter((turn) => turn.status === \"closed\");\n313\t  let compactPoint = 0;\n314\t  if (closedTurns.length > 0 && messages.length > 0) {\n315\t    let sum = 0;\n316\t    let crossing: SelectionMessage | null = null;\n317\t    for (let i = messages.length - 1; i >= 0; i -= 1) {\n318\t      const message = messages[i] as SelectionMessage;\n319\t      sum += message.tokenEstimate;\n320\t      if (sum >= fullBudget) {\n321\t        crossing = message;\n322\t        break;\n323\t      }\n324\t    }\n325\t    // Budget never reached ⇒ the whole record fits the full share:\n326\t    // everything is tail, no bands.\n327\t    compactPoint = crossing === null ? 0 : snapCompactPoint(crossing);\n328\t  }\n329\t\n330\t  function snapCompactPoint(oldestTaken: SelectionMessage): number {\n331\t    // The turn whose boundary the point snaps against: the message's own\n332\t    // turn, or — for a turnless straggler — the turn it attaches to.\n333\t    let candidate: SelectionTurn | undefined =\n334\t      oldestTaken.turnId !== null ? turnsById.get(oldestTaken.turnId) : undefined;\n335\t    if (candidate === undefined && oldestTaken.turnId === null) {\n336\t      candidate = turns.find((turn) => turn.openedAt > oldestTaken.order);\n337\t    }\n338\t    const previousClose = (turn: SelectionTurn): number => {\n339\t      const previous = closedTurns.filter((t) => t.turnOrder < turn.turnOrder).at(-1);\n340\t      return previous?.closedAt ?? 0;\n341\t    };\n342\t    if (candidate === undefined) {\n343\t      // A trailing straggler with no following turn sits after the last turn\n344\t      // boundary, where the compact point cannot pass it: tail begins after\n345\t      // the newest closed turn.\n346\t      return closedTurns.at(-1)?.closedAt ?? 0;\n347\t    }\n348\t    if (candidate.status === \"open\") {\n349\t      // Open-turn messages are tail regardless of budget; the tail begins at\n350\t      // the open turn's start.\n351\t      return previousClose(candidate);\n352\t    }\n353\t    // Fully covered down to the turn's start (notes included) ⇒ the tail\n354\t    // begins at this turn; otherwise snap FORWARD to the next turn start —\n355\t    // the partially-covered turn falls whole to the bands.\n356\t    if (oldestTaken.order <= turnStartOrder(candidate)) {\n357\t      return previousClose(candidate);\n358\t    }\n359\t    return candidate.closedAt ?? 0;\n360\t  }\n361\t\n362\t  // Band candidates: closed turns wholly behind the compact point. Rule 5 is\n363\t  // structural here — chunked or not, a banded turn is a smooth candidate\n364\t  // (bands are defined by representation, not strict time strata).\n365\t  const bandedTurns = closedTurns.filter(\n366\t    (turn) => turn.closedAt !== null && turn.closedAt <= compactPoint,\n367\t  );\n368\t  const bandedTurnIds = new Set(bandedTurns.map((turn) => turn.turnId));\n369\t\n370\t  function buildTurnEntry(turn: SelectionTurn): ArrangementEntry {\n371\t    const turnMessages = messagesByTurn.get(turn.turnId) ?? [];\n372\t    const excerpt =\n373\t      turnMessages.length === 0 ? null : turnMessages.map((message) => message.text).join(\"\\n\");\n374\t    const rep = resolveSmoothRepresentation(turn.turnId, lookup, excerpt);\n375\t    const noteTexts = (notesByTurn.get(turn.turnId) ?? []).map((note) => note.text);\n376\t    const text = renderArrangementEntry(\"turn\", turn.turnId, rep, noteTexts);\n377\t    const entry: ArrangementEntry = {\n378\t      band: \"smooth\",\n379\t      subjectKind: \"turn\",\n380\t      subjectId: turn.turnId,\n381\t      formUsed: rep.formUsed,\n382\t      degraded: rep.degraded,\n383\t      gap: rep.gap,\n384\t      startOrder: turnStartOrder(turn),\n385\t      text,\n386\t      tokens: estimateTokens(text),\n387\t    };\n388\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n389\t    return entry;\n390\t  }\n391\t\n392\t  function buildChunkEntry(chunk: SelectionChunk, band: \"detailed\" | \"brief\"): ArrangementEntry {\n393\t    const memberProjections = chunk.memberTurnIds\n394\t      .map((turnId) => lookup(turnId, \"lower_band_projection\"))\n395\t      .filter((form): form is FormSnapshot & { content: string } => form?.state === \"ready\")\n396\t      .map((form) => form.content ?? \"\")\n397\t      .filter((content) => content.length > 0);\n398\t    const rep =\n399\t      band === \"detailed\"\n400\t        ? resolveDetailedRepresentation(chunk.chunkId, lookup, memberProjections)\n401\t        : resolveBriefRepresentation(chunk.chunkId, lookup);\n402\t    const noteTexts = chunk.memberTurnIds.flatMap((turnId) =>\n403\t      (notesByTurn.get(turnId) ?? []).map((note) => note.text),\n404\t    );\n405\t    const text = renderArrangementEntry(\"chunk\", chunk.chunkId, rep, noteTexts);\n406\t    const memberStarts = chunk.memberTurnIds\n407\t      .map((turnId) => turnsById.get(turnId))\n408\t      .filter((turn): turn is SelectionTurn => turn !== undefined)\n409\t      .map((turn) => turnStartOrder(turn));\n410\t    const entry: ArrangementEntry = {\n411\t      band,\n412\t      subjectKind: \"chunk\",\n413\t      subjectId: chunk.chunkId,\n414\t      formUsed: rep.formUsed,\n415\t      degraded: rep.degraded,\n416\t      gap: rep.gap,\n417\t      startOrder: memberStarts.length === 0 ? compactPoint : Math.min(...memberStarts),\n418\t      text,\n419\t      tokens: estimateTokens(text),\n420\t    };\n421\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n422\t    return entry;\n423\t  }\n424\t\n425\t  // The one fill rule, shared by all three bands (rules 2–4, ruling 013's\n426\t  // literal reading): newest-first whole-entry fill, ≤ inclusion (an entry\n427\t  // exactly filling the budget is included), the first crossing entry stops\n428\t  // the band — included only when the band was still empty (one oversized\n429\t  // entry still represents).\n430\t  function fillBand<T>(\n431\t    candidates: readonly T[], // newest-first\n432\t    bandBudget: number,\n433\t    build: (candidate: T) => ArrangementEntry,\n434\t  ): { included: ArrangementEntry[]; rest: T[] } {\n435\t    const included: ArrangementEntry[] = [];\n436\t    let sum = 0;\n437\t    for (let i = 0; i < candidates.length; i += 1) {\n438\t      const entry = build(candidates[i] as T);\n439\t      if (sum + entry.tokens <= bandBudget) {\n440\t        included.push(entry);\n441\t        sum += entry.tokens;\n442\t        continue;\n443\t      }\n444\t      if (included.length === 0) {\n445\t        included.push(entry);\n446\t        return { included, rest: candidates.slice(i + 1) as T[] };\n447\t      }\n448\t      return { included, rest: candidates.slice(i) as T[] };\n449\t    }\n450\t    return { included, rest: [] };\n451\t  }\n452\t\n453\t  // Rule 2 + 5 — smooth band: banded closed turns newest-first, chunked or\n454\t  // not (rule 5 is structural: a closed-but-unchunked turn is a turn, takes\n455\t  // the smooth representation, and consumes this budget).\n456\t  const smooth = fillBand(\n457\t    [...bandedTurns].reverse(),\n458\t    budget(config.percentages.smooth),\n459\t    buildTurnEntry,\n460\t  );\n461\t  const oldestSmoothOrder = smooth.included.reduce(\n462\t    (oldest, entry) =>\n463\t      Math.min(oldest, turnsById.get(entry.subjectId)?.turnOrder ?? Number.POSITIVE_INFINITY),\n464\t    Number.POSITIVE_INFINITY,\n465\t  );\n466\t\n467\t  // Rules 3–4 — chunk candidacy: chunks entirely older than the smooth\n468\t  // band's coverage, with the pinned tie-breaker doing the deciding — chunk\n469\t  // coverage is its NEWEST member turn, which must sit behind the compact\n470\t  // point and be older than the smooth band's oldest included turn.\n471\t  const chunkCandidates = chunks\n472\t    .filter((chunk) => chunk.status === \"closed\")\n473\t    .filter((chunk) => {\n474\t      const liveMembers = chunk.memberTurnIds\n475\t        .map((turnId) => turnsById.get(turnId))\n476\t        .filter((turn): turn is SelectionTurn => turn !== undefined);\n477\t      if (liveMembers.length === 0) return false; // fully tombstoned membership\n478\t      const newestMember = liveMembers.reduce((newest, turn) =>\n479\t        turn.turnOrder > newest.turnOrder ? turn : newest,\n480\t      );\n481\t      return (\n482\t        bandedTurnIds.has(newestMember.turnId) && newestMember.turnOrder < oldestSmoothOrder\n483\t      );\n484\t    })\n485\t    .reverse(); // newest-first\n486\t\n487\t  // Rule 3 — detailed: same fill rule against its share.\n488\t  const detailed = fillBand(chunkCandidates, budget(config.percentages.detailed), (chunk) =>\n489\t    buildChunkEntry(chunk, \"detailed\"),\n490\t  );\n491\t  // Rule 4 — brief: the remaining chunks, same fill rule against its share.\n492\t  // Chunks remaining after the budget are the coverage edge — outside the\n493\t  // view, reported via covered_from, never phantom gap entries.\n494\t  const brief = fillBand(detailed.rest, budget(config.percentages.brief), (chunk) =>\n495\t    buildChunkEntry(chunk, \"brief\"),\n496\t  );\n497\t\n498\t  const byRecordOrder = (a: ArrangementEntry, b: ArrangementEntry): number =>\n499\t    a.startOrder - b.startOrder;\n500\t  const entries: ArrangementEntry[] = [\n501\t    ...brief.included.sort(byRecordOrder),\n502\t    ...detailed.included.sort(byRecordOrder),\n503\t    ...smooth.included.sort(byRecordOrder),\n504\t  ];\n505\t\n506\t  const coveredFrom =\n507\t    entries.length === 0\n508\t      ? compactPoint\n509\t      : Math.min(...entries.map((entry) => entry.startOrder));\n510\t\n511\t  return { compactPoint, coveredFrom, entries };\n512\t}\n513\t"}]},"parent_tool_use_id":null,"session_id":"8f35b3b6-f7a4-4d02-a9f9-b9315f787309","uuid":"e47f12fa-b4ae-48e9-9d28-77e89977931b","timestamp":"2026-06-11T18:21:11.960Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/select.ts","content":"// Band selection (Story 2): the six-rule walk from tech design §Deterministic\n// Algorithms — compact point, smooth/detailed/brief fills, rule-5 unchunked\n// turns, rule-6 turnless stragglers — plus the coverage edge (covered_from)\n// and canonical-corruption detection. Two halves, deliberately split:\n//\n//   - readSelectionInputs: the record/forms reads, with the corruption check\n//     IN the reads, before any transaction opens (story Technical Notes) —\n//     a refusal here means nothing was written, so the prior view is\n//     trivially intact (AC-2.5). Never moved inside the transaction.\n//   - selectArrangement: a pure function over those inputs. No DB handle, no\n//     clock, no provider — same inputs ⇒ same arrangement, byte-for-byte\n//     (AC-2.9; goldens G1–G4 pin the tie-breakers).\n//\n// Tie-breakers, pinned (tech design): inclusion thresholds are ≤; walks are\n// newest-first everywhere; chunk coverage is decided by the chunk's newest\n// member turn. Entry costs are the tokens of the rendered entry text itself\n// (render.ts's renderArrangementEntry, including attached inter-turn notes),\n// so the budgeted tokens are the stored tokens — no second estimate.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\nimport type { Band } from \"../../../shared/view.js\";\nimport {\n  excerptLine,\n  renderArrangementEntry,\n  resolveBriefRepresentation,\n  resolveDetailedRepresentation,\n  resolveSmoothRepresentation,\n  type FormSnapshot,\n} from \"./render.js\";\n\n// Canonical source state needed to identify or read the compacted span is\n// damaged: compact refuses with state_corruption (AC-2.5). Derived-material\n// damage never raises this — it degrades through the ladders instead.\nexport class CanonicalCorruptionError extends Error {\n  readonly code: \"turn_state_corrupt\" | \"source_damaged\";\n  constructor(code: \"turn_state_corrupt\" | \"source_damaged\", reason: string) {\n    super(reason);\n    this.code = code;\n    this.name = \"CanonicalCorruptionError\";\n  }\n}\n\nexport interface SelectionMessage {\n  messageId: string;\n  order: number; // source_event_order\n  kind: string;\n  tokenEstimate: number;\n  turnId: string | null;\n  text: string; // excerpt/note line (render.excerptLine)\n}\n\nexport interface SelectionTurn {\n  turnId: string;\n  turnOrder: number;\n  status: \"open\" | \"closed\";\n  openedAt: number;\n  closedAt: number | null;\n}\n\nexport interface SelectionChunk {\n  chunkId: string;\n  chunkOrder: number;\n  status: \"open\" | \"closed\";\n  memberTurnIds: string[]; // member order\n}\n\nexport interface SelectionInputs {\n  messages: SelectionMessage[]; // live only, ascending order\n  turns: SelectionTurn[]; // ascending turnOrder\n  chunks: SelectionChunk[]; // ascending chunkOrder\n  forms: Map<string, FormSnapshot>; // `${subjectId}/${form}` (turn/chunk subjects)\n  maxEventOrder: number;\n  formCounts: Record<string, Record<string, number>>; // form → state → count\n}\n\nexport interface ArrangementEntry {\n  band: Band;\n  subjectKind: \"turn\" | \"chunk\";\n  subjectId: string;\n  formUsed: string;\n  degraded: boolean;\n  gap: boolean;\n  reason?: string; // gap entries\n  startOrder: number; // oldest event order the entry represents (notes included)\n  text: string; // rendered entry text (the band stores this verbatim)\n  tokens: number;\n}\n\nexport interface SelectionResult {\n  compactPoint: number;\n  coveredFrom: number;\n  // Gradient order (brief → detailed → smooth), oldest-first within band —\n  // the order the bands render and the arrangement persists.\n  entries: ArrangementEntry[];\n}\n\n// ── reads (corruption check lives here, pre-transaction) ─────────\n\nexport function readSelectionInputs(db: DatabaseSync): SelectionInputs {\n  const turnRows = db\n    .prepare(\n      `SELECT turn_id, turn_order, status, opened_at_event_order, closed_at_event_order, deleted_at\n       FROM turns ORDER BY turn_order`,\n    )\n    .all() as unknown as Array<{\n    turn_id: string;\n    turn_order: number | bigint;\n    status: string;\n    opened_at_event_order: number | bigint;\n    closed_at_event_order: number | bigint | null;\n    deleted_at: string | null;\n  }>;\n  // Referential checks compare against every turn row (a tombstoned turn is\n  // a legitimate reference target, not damage); the selection walk itself\n  // sees live turns only.\n  const turnIds = new Set(turnRows.map((row) => row.turn_id));\n  const turns: SelectionTurn[] = turnRows\n    .filter((row) => row.deleted_at === null)\n    .map((row) => ({\n      turnId: row.turn_id,\n      turnOrder: Number(row.turn_order),\n      status: row.status as \"open\" | \"closed\",\n      openedAt: Number(row.opened_at_event_order),\n      closedAt: row.closed_at_event_order === null ? null : Number(row.closed_at_event_order),\n    }));\n\n  // Canonical damage the walk cannot select across (AC-2.5): the Epic 01\n  // turn-state invariant (at most one open turn, open turns carry no close),\n  // and referential damage between the chunk/message rows and their turns.\n  const openTurns = turns.filter((turn) => turn.status === \"open\");\n  if (openTurns.length > 1) {\n    throw new CanonicalCorruptionError(\n      \"turn_state_corrupt\",\n      `canonical turn state corrupt: ${openTurns.length} open turns (${openTurns\n        .map((turn) => turn.turnId)\n        .join(\", \")}); the compacted span cannot be identified`,\n    );\n  }\n  for (const turn of turns) {\n    if (turn.status === \"closed\" && turn.closedAt === null) {\n      throw new CanonicalCorruptionError(\n        \"source_damaged\",\n        `canonical turn state corrupt: closed turn ${turn.turnId} carries no close boundary`,\n      );\n    }\n  }\n\n  const messageRows = db\n    .prepare(\n      `SELECT message_id, source_event_order, kind, token_estimate, turn_id\n       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\n    )\n    .all() as unknown as Array<{\n    message_id: string;\n    source_event_order: number | bigint;\n    kind: string;\n    token_estimate: number | bigint;\n    turn_id: string | null;\n  }>;\n  const blockRows = db\n    .prepare(\n      `SELECT mb.message_id, mb.block_type, mb.content\n       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n       WHERE m.deleted_at IS NULL\n       ORDER BY m.source_event_order, mb.block_index`,\n    )\n    .all() as unknown as Array<{ message_id: string; block_type: string; content: string }>;\n  const blocksByMessage = new Map<\n    string,\n    Array<{ blockType: string; content: Record<string, unknown> }>\n  >();\n  for (const row of blockRows) {\n    const blocks = blocksByMessage.get(row.message_id) ?? [];\n    blocks.push({\n      blockType: row.block_type,\n      content: JSON.parse(row.content) as Record<string, unknown>,\n    });\n    blocksByMessage.set(row.message_id, blocks);\n  }\n  const messages: SelectionMessage[] = messageRows.map((row) => {\n    if (row.turn_id !== null && !turnIds.has(row.turn_id)) {\n      throw new CanonicalCorruptionError(\n        \"source_damaged\",\n        `canonical record corrupt: message ${row.message_id} references missing turn ${row.turn_id}`,\n      );\n    }\n    return {\n      messageId: row.message_id,\n      order: Number(row.source_event_order),\n      kind: row.kind,\n      tokenEstimate: Number(row.token_estimate),\n      turnId: row.turn_id,\n      text: excerptLine(row.kind, blocksByMessage.get(row.message_id) ?? []),\n    };\n  });\n\n  const chunkRows = db\n    .prepare(`SELECT chunk_id, chunk_order, status FROM chunk ORDER BY chunk_order`)\n    .all() as unknown as Array<{ chunk_id: string; chunk_order: number | bigint; status: string }>;\n  const memberRows = db\n    .prepare(\n      `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n       JOIN chunk c ON c.chunk_id = cm.chunk_id\n       ORDER BY c.chunk_order, cm.member_idx`,\n    )\n    .all() as unknown as Array<{ chunk_id: string; turn_id: string; member_idx: number | bigint }>;\n  const membersByChunk = new Map<string, string[]>();\n  for (const row of memberRows) {\n    if (!turnIds.has(row.turn_id)) {\n      throw new CanonicalCorruptionError(\n        \"source_damaged\",\n        `canonical record corrupt: chunk ${row.chunk_id} membership references missing turn ${row.turn_id}`,\n      );\n    }\n    const members = membersByChunk.get(row.chunk_id) ?? [];\n    members.push(row.turn_id);\n    membersByChunk.set(row.chunk_id, members);\n  }\n  const chunks: SelectionChunk[] = chunkRows.map((row) => ({\n    chunkId: row.chunk_id,\n    chunkOrder: Number(row.chunk_order),\n    status: row.status as \"open\" | \"closed\",\n    memberTurnIds: membersByChunk.get(row.chunk_id) ?? [],\n  }));\n\n  const formRows = db\n    .prepare(\n      `SELECT subject_id, form, state, content, reason FROM derived_form\n       WHERE subject_kind IN ('turn', 'chunk')`,\n    )\n    .all() as unknown as Array<{\n    subject_id: string;\n    form: string;\n    state: string;\n    content: string | null;\n    reason: string | null;\n  }>;\n  const forms = new Map<string, FormSnapshot>();\n  for (const row of formRows) {\n    const snapshot: FormSnapshot = { state: row.state as FormSnapshot[\"state\"] };\n    if (row.content !== null) snapshot.content = row.content;\n    if (row.reason !== null) snapshot.reason = row.reason;\n    forms.set(`${row.subject_id}/${row.form}`, snapshot);\n  }\n\n  const maxRow = db.prepare(`SELECT COALESCE(MAX(event_order), 0) AS m FROM event`).get() as {\n    m: number | bigint;\n  };\n  const countRows = db\n    .prepare(`SELECT form, state, COUNT(*) AS n FROM derived_form GROUP BY form, state`)\n    .all() as unknown as Array<{ form: string; state: string; n: number | bigint }>;\n  const formCounts: Record<string, Record<string, number>> = {};\n  for (const row of countRows) {\n    formCounts[row.form] = { ...formCounts[row.form], [row.state]: Number(row.n) };\n  }\n\n  return { messages, turns, chunks, forms, maxEventOrder: Number(maxRow.m), formCounts };\n}\n\n// ── the pure walk ─────────────────────────────────────────────────\n\nexport interface SelectionConfig {\n  lowerBound: number;\n  percentages: { full: number; smooth: number; detailed: number; brief: number };\n}\n\nexport function selectArrangement(\n  inputs: SelectionInputs,\n  config: SelectionConfig,\n): SelectionResult {\n  const { messages, turns, chunks, forms } = inputs;\n  const lookup = (subjectId: string, form: string): FormSnapshot | undefined =>\n    forms.get(`${subjectId}/${form}`);\n  const budget = (share: number): number => (config.lowerBound * share) / 100;\n\n  const turnsById = new Map(turns.map((turn) => [turn.turnId, turn]));\n  const messagesByTurn = new Map<string, SelectionMessage[]>();\n  for (const message of messages) {\n    if (message.turnId === null) continue;\n    const list = messagesByTurn.get(message.turnId) ?? [];\n    list.push(message);\n    messagesByTurn.set(message.turnId, list);\n  }\n\n  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\n  // band assignment, price into its fill cost, and render marked immediately\n  // before its entry. No following turn ⇒ tail by construction.\n  const notesByTurn = new Map<string, SelectionMessage[]>();\n  for (const message of messages) {\n    if (message.turnId !== null) continue;\n    const following = turns.find((turn) => turn.openedAt > message.order);\n    if (following === undefined) continue; // trailing straggler: tail\n    const list = notesByTurn.get(following.turnId) ?? [];\n    list.push(message);\n    notesByTurn.set(following.turnId, list);\n  }\n\n  // The oldest event order a turn's entry represents: its oldest live\n  // message or attached note, falling back to its open boundary.\n  function turnStartOrder(turn: SelectionTurn): number {\n    const candidates = [\n      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\n      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\n    ];\n    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\n  }\n\n  // Rule 1 — compact point: messages newest-first until the estimate sum\n  // first reaches the full share; the point snaps to a turn boundary so the\n  // tail never begins mid-turn. Open-turn messages always land in the tail.\n  const fullBudget = budget(config.percentages.full);\n  const closedTurns = turns.filter((turn) => turn.status === \"closed\");\n  let compactPoint = 0;\n  if (closedTurns.length > 0 && messages.length > 0) {\n    let sum = 0;\n    let crossing: SelectionMessage | null = null;\n    for (let i = messages.length - 1; i >= 0; i -= 1) {\n      const message = messages[i] as SelectionMessage;\n      sum += message.tokenEstimate;\n      if (sum >= fullBudget) {\n        crossing = message;\n        break;\n      }\n    }\n    // Budget never reached ⇒ the whole record fits the full share:\n    // everything is tail, no bands.\n    compactPoint = crossing === null ? 0 : snapCompactPoint(crossing);\n  }\n\n  function snapCompactPoint(oldestTaken: SelectionMessage): number {\n    // The turn whose boundary the point snaps against: the message's own\n    // turn, or — for a turnless straggler — the turn it attaches to.\n    let candidate: SelectionTurn | undefined =\n      oldestTaken.turnId !== null ? turnsById.get(oldestTaken.turnId) : undefined;\n    if (candidate === undefined && oldestTaken.turnId === null) {\n      candidate = turns.find((turn) => turn.openedAt > oldestTaken.order);\n    }\n    const previousClose = (turn: SelectionTurn): number => {\n      const previous = closedTurns.filter((t) => t.turnOrder < turn.turnOrder).at(-1);\n      return previous?.closedAt ?? 0;\n    };\n    if (candidate === undefined) {\n      // A trailing straggler with no following turn sits after the last turn\n      // boundary, where the compact point cannot pass it: tail begins after\n      // the newest closed turn.\n      return closedTurns.at(-1)?.closedAt ?? 0;\n    }\n    if (candidate.status === \"open\") {\n      // Open-turn messages are tail regardless of budget; the tail begins at\n      // the open turn's start.\n      return previousClose(candidate);\n    }\n    // Fully covered down to the turn's start (notes included) ⇒ the tail\n    // begins at this turn; otherwise snap FORWARD to the next turn start —\n    // the partially-covered turn falls whole to the bands.\n    if (oldestTaken.order <= turnStartOrder(candidate)) {\n      return previousClose(candidate);\n    }\n    return candidate.closedAt ?? 0;\n  }\n\n  // Band candidates: closed turns wholly behind the compact point. Rule 5 is\n  // structural here — chunked or not, a banded turn is a smooth candidate\n  // (bands are defined by representation, not strict time strata).\n  const bandedTurns = closedTurns.filter(\n    (turn) => turn.closedAt !== null && turn.closedAt <= compactPoint,\n  );\n  const bandedTurnIds = new Set(bandedTurns.map((turn) => turn.turnId));\n\n  function buildTurnEntry(turn: SelectionTurn): ArrangementEntry {\n    const turnMessages = messagesByTurn.get(turn.turnId) ?? [];\n    const excerpt =\n      turnMessages.length === 0 ? null : turnMessages.map((message) => message.text).join(\"\\n\");\n    const rep = resolveSmoothRepresentation(turn.turnId, lookup, excerpt);\n    const noteTexts = (notesByTurn.get(turn.turnId) ?? []).map((note) => note.text);\n    const text = renderArrangementEntry(\"turn\", turn.turnId, rep, noteTexts);\n    const entry: ArrangementEntry = {\n      band: \"smooth\",\n      subjectKind: \"turn\",\n      subjectId: turn.turnId,\n      formUsed: rep.formUsed,\n      degraded: rep.degraded,\n      gap: rep.gap,\n      startOrder: turnStartOrder(turn),\n      text,\n      tokens: estimateTokens(text),\n    };\n    if (rep.reason !== undefined) entry.reason = rep.reason;\n    return entry;\n  }\n\n  function buildChunkEntry(chunk: SelectionChunk, band: \"detailed\" | \"brief\"): ArrangementEntry {\n    const memberProjections = chunk.memberTurnIds\n      .map((turnId) => lookup(turnId, \"lower_band_projection\"))\n      .filter((form): form is FormSnapshot & { content: string } => form?.state === \"ready\")\n      .map((form) => form.content ?? \"\")\n      .filter((content) => content.length > 0);\n    const rep =\n      band === \"detailed\"\n        ? resolveDetailedRepresentation(chunk.chunkId, lookup, memberProjections)\n        : resolveBriefRepresentation(chunk.chunkId, lookup);\n    const noteTexts = chunk.memberTurnIds.flatMap((turnId) =>\n      (notesByTurn.get(turnId) ?? []).map((note) => note.text),\n    );\n    const text = renderArrangementEntry(\"chunk\", chunk.chunkId, rep, noteTexts);\n    const memberStarts = chunk.memberTurnIds\n      .map((turnId) => turnsById.get(turnId))\n      .filter((turn): turn is SelectionTurn => turn !== undefined)\n      .map((turn) => turnStartOrder(turn));\n    const entry: ArrangementEntry = {\n      band,\n      subjectKind: \"chunk\",\n      subjectId: chunk.chunkId,\n      formUsed: rep.formUsed,\n      degraded: rep.degraded,\n      gap: rep.gap,\n      startOrder: memberStarts.length === 0 ? compactPoint : Math.min(...memberStarts),\n      text,\n      tokens: estimateTokens(text),\n    };\n    if (rep.reason !== undefined) entry.reason = rep.reason;\n    return entry;\n  }\n\n  // The one fill rule, shared by all three bands (rules 2–4, ruling 013's\n  // literal reading): newest-first whole-entry fill, ≤ inclusion (an entry\n  // exactly filling the budget is included), the first crossing entry stops\n  // the band — included only when the band was still empty (one oversized\n  // entry still represents).\n  function fillBand<T>(\n    candidates: readonly T[], // newest-first\n    bandBudget: number,\n    build: (candidate: T) => ArrangementEntry,\n  ): { included: ArrangementEntry[]; rest: T[] } {\n    const included: ArrangementEntry[] = [];\n    let sum = 0;\n    for (let i = 0; i < candidates.length; i += 1) {\n      const entry = build(candidates[i] as T);\n      if (sum + entry.tokens <= bandBudget) {\n        included.push(entry);\n        sum += entry.tokens;\n        continue;\n      }\n      if (included.length === 0) {\n        included.push(entry);\n        return { included, rest: candidates.slice(i + 1) as T[] };\n      }\n      return { included, rest: candidates.slice(i) as T[] };\n    }\n    return { included, rest: [] };\n  }\n\n  // Rule 2 + 5 — smooth band: banded closed turns newest-first, chunked or\n  // not (rule 5 is structural: a closed-but-unchunked turn is a turn, takes\n  // the smooth representation, and consumes this budget).\n  const smooth = fillBand(\n    [...bandedTurns].reverse(),\n    budget(config.percentages.smooth),\n    buildTurnEntry,\n  );\n  const oldestSmoothOrder = smooth.included.reduce(\n    (oldest, entry) =>\n      Math.min(oldest, turnsById.get(entry.subjectId)?.turnOrder ?? Number.POSITIVE_INFINITY),\n    Number.POSITIVE_INFINITY,\n  );\n\n  // Rules 3–4 — chunk candidacy: chunks entirely older than the smooth\n  // band's coverage, with the pinned tie-breaker doing the deciding — chunk\n  // coverage is its NEWEST member turn, which must sit behind the compact\n  // point and be older than the smooth band's oldest included turn.\n  const chunkCandidates = chunks\n    .filter((chunk) => chunk.status === \"closed\")\n    .filter((chunk) => {\n      const liveMembers = chunk.memberTurnIds\n        .map((turnId) => turnsById.get(turnId))\n        .filter((turn): turn is SelectionTurn => turn !== undefined);\n      if (liveMembers.length === 0) return false; // fully tombstoned membership\n      const newestMember = liveMembers.reduce((newest, turn) =>\n        turn.turnOrder > newest.turnOrder ? turn : newest,\n      );\n      return (\n        bandedTurnIds.has(newestMember.turnId) && newestMember.turnOrder < oldestSmoothOrder\n      );\n    })\n    .reverse(); // newest-first\n\n  // Rule 3 — detailed: same fill rule against its share.\n  const detailed = fillBand(chunkCandidates, budget(config.percentages.detailed), (chunk) =>\n    buildChunkEntry(chunk, \"detailed\"),\n  );\n  // Rule 4 — brief: the remaining chunks, same fill rule against its share.\n  // Chunks remaining after the budget are the coverage edge — outside the\n  // view, reported via covered_from, never phantom gap entries.\n  const brief = fillBand(detailed.rest, budget(config.percentages.brief), (chunk) =>\n    buildChunkEntry(chunk, \"brief\"),\n  );\n\n  const byRecordOrder = (a: ArrangementEntry, b: ArrangementEntry): number =>\n    a.startOrder - b.startOrder;\n  const entries: ArrangementEntry[] = [\n    ...brief.included.sort(byRecordOrder),\n    ...detailed.included.sort(byRecordOrder),\n    ...smooth.included.sort(byRecordOrder),\n  ];\n\n  const coveredFrom =\n    entries.length === 0\n      ? compactPoint\n      : Math.min(...entries.map((entry) => entry.startOrder));\n\n  return { compactPoint, coveredFrom, entries };\n}\n","numLines":513,"startLine":1,"totalLines":513}}}

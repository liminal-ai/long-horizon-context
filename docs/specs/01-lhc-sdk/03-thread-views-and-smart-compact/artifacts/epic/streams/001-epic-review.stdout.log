"injected crash between sweep and view write\\\");\\n371:      const crashed = await fixture.sdk.threadView.compact(\\n394:    const rerun = await fixture.sdk.threadView.compact(\\n495:    const edited = await sdk.messages.edit(\\n516:  it(\\\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\\\", async () => {\\n520:    const receipt = await degraded.sdk.threadView.compact(\\n572:  it(\\\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\\\", async () => {\\n586:  it(\\\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\\\", async () => {\\n605:      const first = await sdk.threadView.compact(\\n624:      const refused = await sdk.threadView.compact(\\n649:  it(\\\"control: a thread with only derived-material damage compacts successfully with gaps\\\", async () => {\\n656:    const receipt = await fixture.sdk.threadView.compact(\\n671:    const receipt = await mut.sdk.threadView.compact(\\n681:  it(\\\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\\\", async () => {\\n692:    const edited = await mut.sdk.messages.edit(\\n726:  it(\\\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\\\", async () => {\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"f006cddb-2184-479e-939b-55dccd3023e3\",\"uuid\":\"cba8b052-d3b5-4a4d-9516-e5f01974d5df\",\"timestamp\":\"2026-06-11T16:40:23.597Z\",\"tool_use_result\":{\"stdout\":\"test/view-select-golden.test.ts:100:  const receipt = await target.sdk.threadView.compact(\\n---\\n143:  it(\\\"rejects percentages summing to 105 naming the sum, and an unknown profile naming it; thread unchanged\\\", async () => {\\n146:    const badSum = await fixture.sdk.threadView.compact(\\n156:    const badBound = await fixture.sdk.threadView.compact(\\n165:    const unknown = await fixture.sdk.threadView.compact(\\n181:  it(\\\"compacts with a built-in profile: the profile's bound and mix land in the receipt\\\", async () => {\\n182:    const receipt = await fixture.sdk.threadView.compact(\\n198:    expect(receipt.value.sweep).toBe(\\\"absent\\\");\\n207:  it(\\\"explicit params override profile values field-wise and report profile null\\\", async () => {\\n208:    const receipt = await fixture.sdk.threadView.compact(\\n228:  it(\\\"actuals near shares with whole-entry deviations, zero provider calls, record untouched\\\", async () => {\\n233:    const receipt = await fixture.sdk.threadView.compact(\\n286:  it(\\\"chunk keys in brief/detailed text, turn keys in smooth text\\\", async () => {\\n287:    const receipt = await fixture.sdk.threadView.compact(\\n304:  it(\\\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\\\", async () => {\\n305:    const receipt = await fixture.sdk.threadView.compact(\\n336:  it(\\\"a fresh SDK on the same file pulls byte-identical band content\\\", async () => {\\n337:    const receipt = await fixture.sdk.threadView.compact(\\n356:  it(\\\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\\\", async () => {\\n357:    const first = await fixture.sdk.threadView.compact(\\n368:      throw new Error(\\\"injected crash between sweep and view write\\\");\\n371:      const crashed = await fixture.sdk.threadView.compact(\\n394:    const rerun = await fixture.sdk.threadView.compact(\\n495:    const edited = await sdk.messages.edit(\\n516:  it(\\\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\\\", async () => {\\n520:    const receipt = await degraded.sdk.threadView.compact(\\n572:  it(\\\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\\\", async () => {\\n586:  it(\\\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\\\", async () => {\\n605:      const first = await sdk.threadView.compact(\\n624:      const refused = await sdk.threadView.compact(\\n649:  it(\\\"control: a thread with only derived-material damage compacts successfully with gaps\\\", async () => {\\n656:    const receipt = await fixture.sdk.threadView.compact(\\n671:    const receipt = await mut.sdk.threadView.compact(\\n681:  it(\\\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\\\", async () => {\\n692:    const edited = await mut.sdk.messages.edit(\\n726:  it(\\\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\\\", async () => {\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/004-implementor.stdout.log:769:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Noo1u8cBfVz37rG7EakctX\",\"type\":\"tool_result\",\"content\":\"95\\t  try {\\n96\\t    return sha256({\\n97\\t      record: recordSnapshot(filePath),\\n98\\t      views: db.prepare(`SELECT * FROM thread_view`).all(),\\n99\\t      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\\n100\\t      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\\n101\\t      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\\n102\\t    });\\n103\\t  } finally {\\n104\\t    db.close();\\n105\\t  }\\n106\\t}\\n107\\t\\n108\\tfunction viewRowCount(filePath: string): number {\\n109\\t  const db = openRaw(filePath);\\n110\\t  try {\\n111\\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\\n112\\t      n: number | bigint;\\n113\\t    };\\n114\\t    return Number(row.n);\\n115\\t  } finally {\\n116\\t    db.close();\\n117\\t  }\\n118\\t}\\n119\\t\\n120\\tfunction boundaryPosition(filePath: string): number {\\n121\\t  const db = openRaw(filePath);\\n122\\t  try {\\n123\\t    const row = db.prepare(`SELECT position FROM view_boundary`).get() as {\\n124\\t      position: number | bigint;\\n125\\t    };\\n126\\t    return Number(row.position);\\n127\\t  } finally {\\n128\\t    db.close();\\n129\\t  }\\n130\\t}\\n131\\t\\n132\\tfunction bandMessages(messages: readonly ViewMessage[]): ViewMessage[] {\\n133\\t  return messages.filter((message) => message.band !== undefined);\\n134\\t}\\n135\\t\\n136\\tasync function pullMessages(sdk: Lhc, filePath: string): Promise<ViewMessage[]> {\\n137\\t  const pulled = await sdk.threadView.pull({ filePath });\\n138\\t  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\\n139\\t  return pulled.value.messages;\\n140\\t}\\n141\\t\\n142\\tdescribe(\\\"TC-2.1 (AC-2.2, AC-2.3, AC-2.7): profiles, explicit params, and named rejections\\\", () => {\\n143\\t  it(\\\"rejects percentages summing to 105 naming the sum, and an unknown profile naming it; thread unchanged\\\", async () => {\\n144\\t    const before = fullStateSnapshot(fixture.filePath);\\n145\\t\\n146\\t    const badSum = await fixture.sdk.threadView.compact(\\n147\\t      { filePath: fixture.filePath },\\n148\\t      { params: { percentages: { full: 30, smooth: 30, detailed: 25, brief: 20 } } },\\n149\\t    );\\n150\\t    expect(badSum.ok).toBe(false);\\n151\\t    if (badSum.ok) return;\\n152\\t    expect(badSum.error.errorClass).toBe(\\\"caller_error\\\");\\n153\\t    expect(badSum.error.code).toBe(\\\"invalid_view_config\\\");\\n154\\t    expect(badSum.error.reason).toContain(\\\"105\\\");\\n155\\t\\n156\\t    const badBound = await fixture.sdk.threadView.compact(\\n157\\t      { filePath: fixture.filePath },\\n158\\t      { params: { lowerBound: 0 } },\\n159\\t    );\\n160\\t    expect(badBound.ok).toBe(false);\\n161\\t    if (badBound.ok) return;\\n162\\t    expect(badBound.error.code).toBe(\\\"invalid_view_config\\\");\\n163\\t    expect(badBound.error.reason).toContain(\\\"lowerBound\\\");\\n164\\t\\n165\\t    const unknown = await fixture.sdk.threadView.compact(\\n166\\t      { filePath: fixture.filePath },\\n167\\t      { profile: \\\"nonesuch\\\" },\\n168\\t    );\\n169\\t    expect(unknown.ok).toBe(false);\\n170\\t    if (unknown.ok) return;\\n171\\t    expect(unknown.error.errorClass).toBe(\\\"caller_error\\\");\\n172\\t    expect(unknown.error.code).toBe(\\\"unknown_profile\\\");\\n173\\t    expect(unknown.error.reason).toContain('\\\"nonesuch\\\"');\\n174\\t\\n175\\t    // Thread unchanged after all rejections: no view row landed, no record\\n176\\t    // or boundary movement (read-back equality).\\n177\\t    expect(fullStateSnapshot(fixture.filePath)).toBe(before);\\n178\\t    expect(viewRowCount(fixture.filePath)).toBe(0);\\n179\\t  });\\n180\\t\\n181\\t  it(\\\"compacts with a built-in profile: the profile's bound and mix land in the receipt\\\", async () => {\\n182\\t    const receipt = await fixture.sdk.threadView.compact(\\n183\\t      { filePath: fixture.filePath },\\n184\\t      { profile: \\\"coding\\\" },\\n185\\t    );\\n186\\t    expect(receipt.ok).toBe(true);\\n187\\t    if (!receipt.ok) return;\\n188\\t    expect(receipt.value.profile).toBe(\\\"coding\\\");\\n189\\t    expect(receipt.value.config).toEqual({\\n190\\t      full: 25,\\n191\\t      smooth: 35,\\n192\\t      detailed: 20,\\n193\\t      brief: 20,\\n194\\t      lowerBound: 120000,\\n195\\t    });\\n196\\t    // Sweep step is absent this story (the honest literal, not a fake empty\\n197\\t    // receipt — Story 3 flips it).\\n198\\t    expect(receipt.value.sweep).toBe(\\\"absent\\\");\\n199\\t    // At a 120k bound this small thread is all tail: bands empty, compact\\n200\\t    // point at the origin, and the reported total IS the tail (totalTokens\\n201\\t    // receipt coverage, ruling 013).\\n202\\t    expect(receipt.value.compactPoint).toBe(0);\\n203\\t    expect(receipt.value.bands.smooth.entries).toBe(0);\\n204\\t    expect(receipt.value.totalTokens).toBe(receipt.value.tailTokens);\\n205\\t  });\\n206\\t\\n207\\t  it(\\\"explicit params override profile values field-wise and report profile null\\\", async () => {\\n208\\t    const receipt = await fixture.sdk.threadView.compact(\\n209\\t      { filePath: fixture.filePath },\\n210\\t      { profile: \\\"coding\\\", params: { lowerBound: 400, percentages: { smooth: 40, detailed: 15 } } },\\n211\\t    );\\n212\\t    expect(receipt.ok).toBe(true);\\n213\\t    if (!receipt.ok) return;\\n214\\t    // coding's mix with the two overridden fields; explicit params ⇒ the\\n215\\t    // receipt names no profile (config carries the resolved truth).\\n216\\t    expect(receipt.value.config).toEqual({\\n217\\t      full: 25,\\n218\\t      smooth: 40,\\n219\\t      detailed: 15,\\n220\\t      brief: 20,\\n221\\t      lowerBound: 400,\\n222\\t    });\\n223\\t    expect(receipt.value.profile).toBeNull();\\n224\\t  });\\n225\\t});\\n226\\t\\n227\\tdescribe(\\\"TC-2.2 (AC-2.4, AC-2.9): the compact targets the bound from stored artifacts only\\\", () => {\\n228\\t  it(\\\"actuals near shares with whole-entry deviations, zero provider calls, record untouched\\\", async () => {\\n229\\t    const captured = fixture.double.captureInputs();\\n230\\t    const capturedBefore = captured.length;\\n231\\t    const recordBefore = recordSnapshot(fixture.filePath);\\n232\\t\\n233\\t    const receipt = await fixture.sdk.threadView.compact(\\n234\\t      { filePath: fixture.filePath },\\n235\\t      { params: TARGET_PARAMS },\\n236\\t    );\\n237\\t    expect(receipt.ok).toBe(true);\\n238\\t    if (!receipt.ok) return;\\n239\\t    const shares = {\\n240\\t      smooth: (400 * 25) / 100,\\n241\\t      detailed: (400 * 25) / 100,\\n242\\t      brief: (400 * 25) / 100,\\n243\\t    };\\n244\\t\\n245\\t    // Whole-entry fills: a band lands at-or-under its share unless a single\\n246\\t    // indivisible entry had to represent (the only sanctioned over-share\\n247\\t    // deviation, AC-2.4).\\n248\\t    for (const band of [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"] as const) {\\n249\\t      const actual = receipt.value.bands[band];\\n250\\t      const attributable = actual.tokens <= shares[band] || actual.entries === 1;\\n251\\t      expect(attributable).toBe(true);\\n252\\t    }\\n253\\t    // The fixture's pinned arrangement under these params (literal rules):\\n254\\t    // smooth fills t6–t8 within its share, c1 fills detailed within its\\n255\\t    // share, brief is empty by candidacy, tail under the full share plus\\n256\\t    // turn-boundary snap.\\n257\\t    expect(receipt.value.bands.brief).toEqual({ entries: 0, tokens: 0 });\\n258\\t    expect(receipt.value.bands.detailed.entries).toBe(1);\\n259\\t    expect(receipt.value.bands.detailed.tokens).toBeLessThanOrEqual(shares.detailed);\\n260\\t    expect(receipt.value.bands.smooth.entries).toBe(3);\\n261\\t    expect(receipt.value.bands.smooth.tokens).toBeLessThanOrEqual(shares.smooth);\\n262\\t    expect(receipt.value.tailTokens).toBeLessThanOrEqual((400 * 25) / 100);\\n263\\t    expect(receipt.value.compactPoint).toBe(48);\\n264\\t\\n265\\t    // The explicit total (ruling 013): the assembled view's actual size —\\n266\\t    // band tokens plus tail — reported beside the per-band actuals. Here it\\n267\\t    // lands UNDER the bound (insufficient stored material at this scale),\\n268\\t    // the bound being a target, not a cap.\\n269\\t    expect(receipt.value.totalTokens).toBe(\\n270\\t      receipt.value.bands.brief.tokens +\\n271\\t        receipt.value.bands.detailed.tokens +\\n272\\t        receipt.value.bands.smooth.tokens +\\n273\\t        receipt.value.tailTokens,\\n274\\t    );\\n275\\t    expect(receipt.value.totalTokens).toBeGreaterThan(0);\\n276\\t    expect(receipt.value.totalTokens).toBeLessThanOrEqual(400);\\n277\\t\\n278\\t    // No provider call anywhere in the compact path; the record (events,\\n279\\t    // messages, turns, chunks, forms) is byte-identical after.\\n280\\t    expect(captured.length).toBe(capturedBefore);\\n281\\t    expect(recordSnapshot(fixture.filePath)).toBe(recordBefore);\\n282\\t  });\\n283\\t});\\n284\\t\\n285\\tdescribe(\\\"TC-2.6 (AC-2.10): band entries carry their subject keys visibly\\\", () => {\\n286\\t  it(\\\"chunk keys in brief/detailed text, turn keys in smooth text\\\", async () => {\\n287\\t    const receipt = await fixture.sdk.threadView.compact(\\n288\\t      { filePath: fixture.filePath },\\n289\\t      { params: GRADIENT_PARAMS },\\n290\\t    );\\n291\\t    expect(receipt.ok).toBe(true);\\n292\\t\\n293\\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\\n294\\t    const bands = bandMessages(messages);\\n295\\t    const byBand = new Map(bands.map((message) => [message.band, message.content]));\\n296\\t    expect(byBand.get(\\\"brief\\\")).toMatch(/§c\\\\d+/);\\n297\\t    expect(byBand.get(\\\"detailed\\\")).toMatch(/§c\\\\d+/);\\n298\\t    expect(byBand.get(\\\"smooth\\\")).toMatch(/§t\\\\d+/);\\n299\\t    expect(byBand.get(\\\"smooth\\\")).not.toMatch(/§c\\\\d+/);\\n300\\t  });\\n301\\t});\\n302\\t\\n303\\tdescribe(\\\"architecture-risk: coverage edge accounting\\\", () => {\\n304\\t  it(\\\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\\\", async () => {\\n305\\t    const receipt = await fixture.sdk.threadView.compact(\\n306\\t      { filePath: fixture.filePath },\\n307\\t      { params: EDGE_PARAMS },\\n308\\t    );\\n309\\t    expect(receipt.ok).toBe(true);\\n310\\t    if (!receipt.ok) return;\\n311\\t\\n312\\t    // The compact point lands at t10's close, so c3, c2, and c1 are all\\n313\\t    // chunk candidates; c3 takes detailed (loner), the brief share holds c2\\n314\\t    // alone, and c1 remains AFTER the budget: outside the view. covered_from\\n315\\t    // lands at c2's start — t4's prompt, event 13 — and the exclusion is\\n316\\t    // visible as coveredFrom > first event.\\n317\\t    expect(receipt.value.compactPoint).toBe(56);\\n318\\t    expect(receipt.value.coveredFrom).toBe(13);\\n319\\t    expect(receipt.value.bands.detailed.entries).toBe(1);\\n320\\t    expect(receipt.value.bands.brief.entries).toBe(1);\\n321\\t    // No silent omission AND no phantom gap entries for the out-of-window\\n322\\t    // chunk: gaps report unusable material, not the window's edge.\\n323\\t    expect(receipt.value.gaps).toEqual([]);\\n324\\t\\n325\\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\\n326\\t    const bandText = bandMessages(messages)\\n327\\t      .map((message) => message.content)\\n328\\t      .join(\\\"\\\\n\\\");\\n329\\t    expect(bandText).not.toContain(\\\"§c1\\\");\\n330\\t    expect(bandText).toContain(\\\"§c2\\\");\\n331\\t    expect(bandText).toContain(\\\"§c3\\\");\\n332\\t  });\\n333\\t});\\n334\\t\\n335\\tdescribe(\\\"architecture-risk: restart serves the snapshot (real-file durability)\\\", () => {\\n336\\t  it(\\\"a fresh SDK on the same file pulls byte-identical band content\\\", async () => {\\n337\\t    const receipt = await fixture.sdk.threadView.compact(\\n338\\t      { filePath: fixture.filePath },\\n339\\t      { params: GRADIENT_PARAMS },\\n340\\t    );\\n341\\t    expect(receipt.ok).toBe(true);\\n342\\t    const before = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n343\\t    expect(before.ok).toBe(true);\\n344\\t    if (!before.ok) return;\\n345\\t\\n346\\t    // Not a same-process reread: a fresh SDK instance opens the file cold.\\n347\\t    const fresh = createSdk({ provider: createProviderDouble(), mode: \\\"manual\\\" });\\n348\\t    const after = await fresh.threadView.pull({ filePath: fixture.filePath });\\n349\\t    expect(after.ok).toBe(true);\\n350\\t    if (!after.ok) return;\\n351\\t    expect(JSON.stringify(after.value)).toBe(JSON.stringify(before.value));\\n352\\t  });\\n353\\t});\\n354\\t\\n355\\tdescribe(\\\"TC-2.4 (AC-2.6): crash injection at the compact-write point\\\", () => {\\n356\\t  it(\\\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\\\", async () => {\\n357\\t    const first = await fixture.sdk.threadView.compact(\\n358\\t      { filePath: fixture.filePath },\\n359\\t      { params: GRADIENT_PARAMS },\\n360\\t    );\\n361\\t    expect(first.ok).toBe(true);\\n362\\t    const priorPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n363\\t    expect(priorPull.ok).toBe(true);\\n364\\t    if (!priorPull.ok) return;\\n365\\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\\n366\\t\\n367\\t    setViewInjectionHook(\\\"compact-write\\\", () => {\\n368\\t      throw new Error(\\\"injected crash between sweep and view write\\\");\\n369\\t    });\\n370\\t    try {\\n371\\t      const crashed = await fixture.sdk.threadView.compact(\\n372\\t        { filePath: fixture.filePath },\\n373\\t        { params: EDGE_PARAMS },\\n374\\t      );\\n375\\t      expect(crashed.ok).toBe(false);\\n376\\t      if (crashed.ok) return;\\n377\\t      expect(crashed.error.errorClass).toBe(\\\"system_error\\\");\\n378\\t      expect(crashed.error.reason).toContain(\\\"injected crash\\\");\\n379\\t    } finally {\\n380\\t      setViewInjectionHook(\\\"compact-write\\\", null);\\n381\\t    }\\n382\\t\\n383\\t    // The previous view still serves, byte-identical; no partial rows, no\\n384\\t    // boundary movement.\\n385\\t    const afterCrash = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n386\\t    expect(afterCrash.ok).toBe(true);\\n387\\t    if (!afterCrash.ok) return;\\n388\\t    expect(JSON.stringify(afterCrash.value)).toBe(JSON.stringify(priorPull.value));\\n389\\t    expect(viewRowCount(fixture.filePath)).toBe(1);\\n390\\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\\n391\\t\\n392\\t    // Rerun: the new view lands whole and the boundary resets to ITS compact\\n393\\t    // point (56) in the same transaction.\\n394\\t    const rerun = await fixture.sdk.threadView.compact(\\n395\\t      { filePath: fixture.filePath },\\n396\\t      { params: EDGE_PARAMS },\\n397\\t    );\\n398\\t    expect(rerun.ok).toBe(true);\\n399\\t    if (!rerun.ok) return;\\n400\\t    expect(rerun.value.coveredFrom).toBe(13);\\n401\\t    expect(viewRowCount(fixture.filePath)).toBe(1);\\n402\\t    expect(boundaryPosition(fixture.filePath)).toBe(56);\\n403\\t    const rerunPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n404\\t    expect(rerunPull.ok).toBe(true);\\n405\\t    if (!rerunPull.ok) return;\\n406\\t    expect(JSON.stringify(rerunPull.value)).not.toBe(JSON.stringify(priorPull.value));\\n407\\t  });\\n408\\t});\\n409\\t\\n410\\t// ── degraded thread (TC-2.3 + the TC-2.5 view-health completion legs) ──\\n411\\t\\n412\\t// The fixture conversation rebuilt with manufactured derived damage, all\\n413\\t// through production paths: c1's brief summary exhausts through scripted\\n414\\t// retryable provider failures at build; post-build edits clear t8's turn\\n415\\t// forms and all of c2's dependent chain to pending (the Epic 02 cascade) —\\n416\\t// a pending turn rendering for the smooth band, and a chunk with no usable\\n417\\t// form at all (summaries pending, zero ready member projections) for the\\n418\\t// gap rung.\\n419\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n420\\tconst C1_BRIEF_EXHAUST_REASON = \\\"rate_limit: scripted c1 brief exhaustion (test)\\\";\\n421\\t\\n422\\tfunction degradedTurnEvents(turn: number): MessageEventInput[] {\\n423\\t  const events: MessageEventInput[] = [\\n424\\t    validEvent(\\\"user_prompt\\\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\\n425\\t    validEvent(\\\"assistant_thinking\\\", { payload: { text: `considering what area ${turn} contains` } }),\\n426\\t  ];\\n427\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n428\\t    for (const run of [1, 2]) {\\n429\\t      const toolCallId = `call-dg-${turn}-${run}`;\\n430\\t      events.push(\\n431\\t        validEvent(\\\"tool_call\\\", {\\n432\\t          payload: { toolCallId, toolName: \\\"read_file\\\", arguments: { path: `area-${turn}/file-${run}.txt` } },\\n433\\t        }),\\n434\\t        validEvent(\\\"tool_result\\\", {\\n435\\t          payload: {\\n436\\t            toolCallId,\\n437\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n438\\t            isError: false,\\n439\\t          },\\n440\\t        }),\\n441\\t      );\\n442\\t    }\\n443\\t  }\\n444\\t  events.push(\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f006cddb-2184-479e-939b-55dccd3023e3\",\"uuid\":\"79898b26-7963-44ac-bac8-78fdec14f890\",\"timestamp\":\"2026-06-11T16:41:05.391Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-compact.test.ts\",\"content\":\"  try {\\n    return sha256({\\n      record: recordSnapshot(filePath),\\n      views: db.prepare(`SELECT * FROM thread_view`).all(),\\n      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\\n      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\\n      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\\n    });\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction viewRowCount(filePath: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\\n      n: number | bigint;\\n    };\\n    return Number(row.n);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction boundaryPosition(filePath: string): number {\\n  const db = openRaw(filePath);\\n  try {\\n    const row = db.prepare(`SELECT position FROM view_boundary`).get() as {\\n      position: number | bigint;\\n    };\\n    return Number(row.position);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction bandMessages(messages: readonly ViewMessage[]): ViewMessage[] {\\n  return messages.filter((message) => message.band !== undefined);\\n}\\n\\nasync function pullMessages(sdk: Lhc, filePath: string): Promise<ViewMessage[]> {\\n  const pulled = await sdk.threadView.pull({ filePath });\\n  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\\n  return pulled.value.messages;\\n}\\n\\ndescribe(\\\"TC-2.1 (AC-2.2, AC-2.3, AC-2.7): profiles, explicit params, and named rejections\\\", () => {\\n  it(\\\"rejects percentages summing to 105 naming the sum, and an unknown profile naming it; thread unchanged\\\", async () => {\\n    const before = fullStateSnapshot(fixture.filePath);\\n\\n    const badSum = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: { percentages: { full: 30, smooth: 30, detailed: 25, brief: 20 } } },\\n    );\\n    expect(badSum.ok).toBe(false);\\n    if (badSum.ok) return;\\n    expect(badSum.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(badSum.error.code).toBe(\\\"invalid_view_config\\\");\\n    expect(badSum.error.reason).toContain(\\\"105\\\");\\n\\n    const badBound = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: { lowerBound: 0 } },\\n    );\\n    expect(badBound.ok).toBe(false);\\n    if (badBound.ok) return;\\n    expect(badBound.error.code).toBe(\\\"invalid_view_config\\\");\\n    expect(badBound.error.reason).toContain(\\\"lowerBound\\\");\\n\\n    const unknown = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"nonesuch\\\" },\\n    );\\n    expect(unknown.ok).toBe(false);\\n    if (unknown.ok) return;\\n    expect(unknown.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(unknown.error.code).toBe(\\\"unknown_profile\\\");\\n    expect(unknown.error.reason).toContain('\\\"nonesuch\\\"');\\n\\n    // Thread unchanged after all rejections: no view row landed, no record\\n    // or boundary movement (read-back equality).\\n    expect(fullStateSnapshot(fixture.filePath)).toBe(before);\\n    expect(viewRowCount(fixture.filePath)).toBe(0);\\n  });\\n\\n  it(\\\"compacts with a built-in profile: the profile's bound and mix land in the receipt\\\", async () => {\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\" },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    expect(receipt.value.profile).toBe(\\\"coding\\\");\\n    expect(receipt.value.config).toEqual({\\n      full: 25,\\n      smooth: 35,\\n      detailed: 20,\\n      brief: 20,\\n      lowerBound: 120000,\\n    });\\n    // Sweep step is absent this story (the honest literal, not a fake empty\\n    // receipt — Story 3 flips it).\\n    expect(receipt.value.sweep).toBe(\\\"absent\\\");\\n    // At a 120k bound this small thread is all tail: bands empty, compact\\n    // point at the origin, and the reported total IS the tail (totalTokens\\n    // receipt coverage, ruling 013).\\n    expect(receipt.value.compactPoint).toBe(0);\\n    expect(receipt.value.bands.smooth.entries).toBe(0);\\n    expect(receipt.value.totalTokens).toBe(receipt.value.tailTokens);\\n  });\\n\\n  it(\\\"explicit params override profile values field-wise and report profile null\\\", async () => {\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { profile: \\\"coding\\\", params: { lowerBound: 400, percentages: { smooth: 40, detailed: 15 } } },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    // coding's mix with the two overridden fields; explicit params ⇒ the\\n    // receipt names no profile (config carries the resolved truth).\\n    expect(receipt.value.config).toEqual({\\n      full: 25,\\n      smooth: 40,\\n      detailed: 15,\\n      brief: 20,\\n      lowerBound: 400,\\n    });\\n    expect(receipt.value.profile).toBeNull();\\n  });\\n});\\n\\ndescribe(\\\"TC-2.2 (AC-2.4, AC-2.9): the compact targets the bound from stored artifacts only\\\", () => {\\n  it(\\\"actuals near shares with whole-entry deviations, zero provider calls, record untouched\\\", async () => {\\n    const captured = fixture.double.captureInputs();\\n    const capturedBefore = captured.length;\\n    const recordBefore = recordSnapshot(fixture.filePath);\\n\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: TARGET_PARAMS },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n    const shares = {\\n      smooth: (400 * 25) / 100,\\n      detailed: (400 * 25) / 100,\\n      brief: (400 * 25) / 100,\\n    };\\n\\n    // Whole-entry fills: a band lands at-or-under its share unless a single\\n    // indivisible entry had to represent (the only sanctioned over-share\\n    // deviation, AC-2.4).\\n    for (const band of [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"] as const) {\\n      const actual = receipt.value.bands[band];\\n      const attributable = actual.tokens <= shares[band] || actual.entries === 1;\\n      expect(attributable).toBe(true);\\n    }\\n    // The fixture's pinned arrangement under these params (literal rules):\\n    // smooth fills t6–t8 within its share, c1 fills detailed within its\\n    // share, brief is empty by candidacy, tail under the full share plus\\n    // turn-boundary snap.\\n    expect(receipt.value.bands.brief).toEqual({ entries: 0, tokens: 0 });\\n    expect(receipt.value.bands.detailed.entries).toBe(1);\\n    expect(receipt.value.bands.detailed.tokens).toBeLessThanOrEqual(shares.detailed);\\n    expect(receipt.value.bands.smooth.entries).toBe(3);\\n    expect(receipt.value.bands.smooth.tokens).toBeLessThanOrEqual(shares.smooth);\\n    expect(receipt.value.tailTokens).toBeLessThanOrEqual((400 * 25) / 100);\\n    expect(receipt.value.compactPoint).toBe(48);\\n\\n    // The explicit total (ruling 013): the assembled view's actual size —\\n    // band tokens plus tail — reported beside the per-band actuals. Here it\\n    // lands UNDER the bound (insufficient stored material at this scale),\\n    // the bound being a target, not a cap.\\n    expect(receipt.value.totalTokens).toBe(\\n      receipt.value.bands.brief.tokens +\\n        receipt.value.bands.detailed.tokens +\\n        receipt.value.bands.smooth.tokens +\\n        receipt.value.tailTokens,\\n    );\\n    expect(receipt.value.totalTokens).toBeGreaterThan(0);\\n    expect(receipt.value.totalTokens).toBeLessThanOrEqual(400);\\n\\n    // No provider call anywhere in the compact path; the record (events,\\n    // messages, turns, chunks, forms) is byte-identical after.\\n    expect(captured.length).toBe(capturedBefore);\\n    expect(recordSnapshot(fixture.filePath)).toBe(recordBefore);\\n  });\\n});\\n\\ndescribe(\\\"TC-2.6 (AC-2.10): band entries carry their subject keys visibly\\\", () => {\\n  it(\\\"chunk keys in brief/detailed text, turn keys in smooth text\\\", async () => {\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: GRADIENT_PARAMS },\\n    );\\n    expect(receipt.ok).toBe(true);\\n\\n    const messages = await pullMessages(fixture.sdk, fixture.filePath);\\n    const bands = bandMessages(messages);\\n    const byBand = new Map(bands.map((message) => [message.band, message.content]));\\n    expect(byBand.get(\\\"brief\\\")).toMatch(/§c\\\\d+/);\\n    expect(byBand.get(\\\"detailed\\\")).toMatch(/§c\\\\d+/);\\n    expect(byBand.get(\\\"smooth\\\")).toMatch(/§t\\\\d+/);\\n    expect(byBand.get(\\\"smooth\\\")).not.toMatch(/§c\\\\d+/);\\n  });\\n});\\n\\ndescribe(\\\"architecture-risk: coverage edge accounting\\\", () => {\\n  it(\\\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\\\", async () => {\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: EDGE_PARAMS },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n\\n    // The compact point lands at t10's close, so c3, c2, and c1 are all\\n    // chunk candidates; c3 takes detailed (loner), the brief share holds c2\\n    // alone, and c1 remains AFTER the budget: outside the view. covered_from\\n    // lands at c2's start — t4's prompt, event 13 — and the exclusion is\\n    // visible as coveredFrom > first event.\\n    expect(receipt.value.compactPoint).toBe(56);\\n    expect(receipt.value.coveredFrom).toBe(13);\\n    expect(receipt.value.bands.detailed.entries).toBe(1);\\n    expect(receipt.value.bands.brief.entries).toBe(1);\\n    // No silent omission AND no phantom gap entries for the out-of-window\\n    // chunk: gaps report unusable material, not the window's edge.\\n    expect(receipt.value.gaps).toEqual([]);\\n\\n    const messages = await pullMessages(fixture.sdk, fixture.filePath);\\n    const bandText = bandMessages(messages)\\n      .map((message) => message.content)\\n      .join(\\\"\\\\n\\\");\\n    expect(bandText).not.toContain(\\\"§c1\\\");\\n    expect(bandText).toContain(\\\"§c2\\\");\\n    expect(bandText).toContain(\\\"§c3\\\");\\n  });\\n});\\n\\ndescribe(\\\"architecture-risk: restart serves the snapshot (real-file durability)\\\", () => {\\n  it(\\\"a fresh SDK on the same file pulls byte-identical band content\\\", async () => {\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: GRADIENT_PARAMS },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    const before = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(before.ok).toBe(true);\\n    if (!before.ok) return;\\n\\n    // Not a same-process reread: a fresh SDK instance opens the file cold.\\n    const fresh = createSdk({ provider: createProviderDouble(), mode: \\\"manual\\\" });\\n    const after = await fresh.threadView.pull({ filePath: fixture.filePath });\\n    expect(after.ok).toBe(true);\\n    if (!after.ok) return;\\n    expect(JSON.stringify(after.value)).toBe(JSON.stringify(before.value));\\n  });\\n});\\n\\ndescribe(\\\"TC-2.4 (AC-2.6): crash injection at the compact-write point\\\", () => {\\n  it(\\\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\\\", async () => {\\n    const first = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: GRADIENT_PARAMS },\\n    );\\n    expect(first.ok).toBe(true);\\n    const priorPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(priorPull.ok).toBe(true);\\n    if (!priorPull.ok) return;\\n    expect(boundaryPosition(fixture.filePath)).toBe(48);\\n\\n    setViewInjectionHook(\\\"compact-write\\\", () => {\\n      throw new Error(\\\"injected crash between sweep and view write\\\");\\n    });\\n    try {\\n      const crashed = await fixture.sdk.threadView.compact(\\n        { filePath: fixture.filePath },\\n        { params: EDGE_PARAMS },\\n      );\\n      expect(crashed.ok).toBe(false);\\n      if (crashed.ok) return;\\n      expect(crashed.error.errorClass).toBe(\\\"system_error\\\");\\n      expect(crashed.error.reason).toContain(\\\"injected crash\\\");\\n    } finally {\\n      setViewInjectionHook(\\\"compact-write\\\", null);\\n    }\\n\\n    // The previous view still serves, byte-identical; no partial rows, no\\n    // boundary movement.\\n    const afterCrash = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(afterCrash.ok).toBe(true);\\n    if (!afterCrash.ok) return;\\n    expect(JSON.stringify(afterCrash.value)).toBe(JSON.stringify(priorPull.value));\\n    expect(viewRowCount(fixture.filePath)).toBe(1);\\n    expect(boundaryPosition(fixture.filePath)).toBe(48);\\n\\n    // Rerun: the new view lands whole and the boundary resets to ITS compact\\n    // point (56) in the same transaction.\\n    const rerun = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: EDGE_PARAMS },\\n    );\\n    expect(rerun.ok).toBe(true);\\n    if (!rerun.ok) return;\\n    expect(rerun.value.coveredFrom).toBe(13);\\n    expect(viewRowCount(fixture.filePath)).toBe(1);\\n    expect(boundaryPosition(fixture.filePath)).toBe(56);\\n    const rerunPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\\n    expect(rerunPull.ok).toBe(true);\\n    if (!rerunPull.ok) return;\\n    expect(JSON.stringify(rerunPull.value)).not.toBe(JSON.stringify(priorPull.value));\\n  });\\n});\\n\\n// ── degraded thread (TC-2.3 + the TC-2.5 view-health completion legs) ──\\n\\n// The fixture conversation rebuilt with manufactured derived damage, all\\n// through production paths: c1's brief summary exhausts through scripted\\n// retryable provider failures at build; post-build edits clear t8's turn\\n// forms and all of c2's dependent chain to pending (the Epic 02 cascade) —\\n// a pending turn rendering for the smooth band, and a chunk with no usable\\n// form at all (summaries pending, zero ready member projections) for the\\n// gap rung.\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\nconst C1_BRIEF_EXHAUST_REASON = \\\"rate_limit: scripted c1 brief exhaustion (test)\\\";\\n\\nfunction degradedTurnEvents(turn: number): MessageEventInput[] {\\n  const events: MessageEventInput[] = [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\\n    validEvent(\\\"assistant_thinking\\\", { payload: { text: `considering what area ${turn} contains` } }),\\n  ];\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    for (const run of [1, 2]) {\\n      const toolCallId = `call-dg-${turn}-${run}`;\\n      events.push(\\n        validEvent(\\\"tool_call\\\", {\\n          payload: { toolCallId, toolName: \\\"read_file\\\", arguments: { path: `area-${turn}/file-${run}.txt` } },\\n        }),\\n        validEvent(\\\"tool_result\\\", {\\n          payload: {\\n            toolCallId,\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n            isError: false,\\n          },\\n        }),\\n      );\\n    }\\n  }\\n  events.push(\",\"numLines\":350,\"startLine\":95,\"totalLines\":778}}}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/004-implementor.stdout.log:785:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_018AKMoTayR31GPghTroCRco\",\"type\":\"tool_result\",\"content\":\"445\\t    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n446\\t    validEvent(\\\"turn_end\\\"),\\n447\\t  );\\n448\\t  return events;\\n449\\t}\\n450\\t\\n451\\tinterface DegradedThread {\\n452\\t  filePath: string;\\n453\\t  sdk: Lhc;\\n454\\t  double: ProviderDouble;\\n455\\t  promptIdByTurn: Map<number, string>;\\n456\\t}\\n457\\t\\n458\\tasync function buildDegradedThread(intoStore: TempStore): Promise<DegradedThread> {\\n459\\t  const double = createProviderDouble();\\n460\\t  const sdk = createSdk({\\n461\\t    provider: double,\\n462\\t    mode: \\\"manual\\\",\\n463\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n464\\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n465\\t  });\\n466\\t  const filePath = intoStore.threadPath();\\n467\\t  const created = await sdk.threads.newThread({ filePath, registryPath: intoStore.registryPath });\\n468\\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\n469\\t\\n470\\t  const promptIdByTurn = new Map<number, string>();\\n471\\t  for (let turn = 1; turn <= 12; turn += 1) {\\n472\\t    if (turn === 4) {\\n473\\t      // c1 closes during turn 4's drain (placement of t4): its brief summary\\n474\\t      // exhausts through real retry mechanics — a FAILED chunk summary.\\n475\\t      double.failKind(\\\"chunk_summary_brief\\\", 3, {\\n476\\t        retryable: true,\\n477\\t        reason: C1_BRIEF_EXHAUST_REASON,\\n478\\t      });\\n479\\t    }\\n480\\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\\n481\\t    if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\\n482\\t    const promptId = sent.value.events[0]?.messageId;\\n483\\t    if (promptId !== undefined && promptId !== null) promptIdByTurn.set(turn, promptId);\\n484\\t    const drained = await sdk.work.drain({ filePath });\\n485\\t    if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\\n486\\t  }\\n487\\t\\n488\\t  // Post-build edits, NOT drained: the cascade clears each edited message's\\n489\\t  // dependent chain to pending. t8 ⇒ a PENDING turn rendering in the smooth\\n490\\t  // band; t4+t5+t6 ⇒ c2's summaries pending with zero ready member\\n491\\t  // projections — the gap rung.\\n492\\t  for (const turn of [4, 5, 6, 8]) {\\n493\\t    const promptId = promptIdByTurn.get(turn);\\n494\\t    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\\n495\\t    const edited = await sdk.messages.edit(\\n496\\t      { filePath },\\n497\\t      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\\n498\\t    );\\n499\\t    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\\n500\\t  }\\n501\\t  return { filePath, sdk, double, promptIdByTurn };\\n502\\t}\\n503\\t\\n504\\tdescribe(\\\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\\\", () => {\\n505\\t  let degradedStore: TempStore;\\n506\\t  let degraded: DegradedThread;\\n507\\t\\n508\\t  beforeAll(async () => {\\n509\\t    degradedStore = tempStore();\\n510\\t    degraded = await buildDegradedThread(degradedStore);\\n511\\t  });\\n512\\t  afterAll(() => {\\n513\\t    degradedStore.cleanup();\\n514\\t  });\\n515\\t\\n516\\t  it(\\\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\\\", async () => {\\n517\\t    const captured = degraded.double.captureInputs();\\n518\\t    const capturedBefore = captured.length;\\n519\\t\\n520\\t    const receipt = await degraded.sdk.threadView.compact(\\n521\\t      { filePath: degraded.filePath },\\n522\\t      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\\n523\\t    );\\n524\\t    expect(receipt.ok).toBe(true);\\n525\\t    if (!receipt.ok) return;\\n526\\t\\n527\\t    // The pending turn rendering (t8, edited): the smooth entry degrades down\\n528\\t    // its ladder (projection pending too) to the deterministic excerpt.\\n529\\t    const t8 = receipt.value.degraded.find((entry) => entry.subjectId === \\\"t8\\\");\\n530\\t    expect(t8).toBeDefined();\\n531\\t    expect(t8?.band).toBe(\\\"smooth\\\");\\n532\\t    expect(t8?.usedForm).toBe(\\\"message_excerpt\\\");\\n533\\t\\n534\\t    // The failed chunk summary (c1's brief): the brief entry renders the\\n535\\t    // truncated detailed summary, marked.\\n536\\t    const c1 = receipt.value.degraded.find((entry) => entry.subjectId === \\\"c1\\\");\\n537\\t    expect(c1).toBeDefined();\\n538\\t    expect(c1?.band).toBe(\\\"brief\\\");\\n539\\t    expect(c1?.usedForm).toBe(\\\"chunk_summary_detailed_truncated\\\");\\n540\\t\\n541\\t    // The unusable chunk (c2: summaries pending, zero ready member\\n542\\t    // projections): an explicit gap entry with its reason — never absence.\\n543\\t    expect(receipt.value.gaps).toHaveLength(1);\\n544\\t    const gap = receipt.value.gaps[0];\\n545\\t    expect(gap?.subjectId).toBe(\\\"c2\\\");\\n546\\t    expect(gap?.reason).toMatch(/no usable form/);\\n547\\t    expect(gap?.reason).toContain(\\\"chunk_summary_detailed: pending\\\");\\n548\\t\\n549\\t    // Per-band counts present; no span silently absent: every turn in the\\n550\\t    // compacted range is accounted for by a band subject (c1: t1–t3, c2:\\n551\\t    // t4–t6, smooth: t7–t8) and everything after the compact point is tail.\\n552\\t    expect(receipt.value.bands.brief.entries).toBe(1);\\n553\\t    expect(receipt.value.bands.detailed.entries).toBe(1);\\n554\\t    expect(receipt.value.bands.smooth.entries).toBe(2);\\n555\\t    expect(receipt.value.compactPoint).toBe(48);\\n556\\t    expect(receipt.value.coveredFrom).toBe(1);\\n557\\t\\n558\\t    // The rendered text carries the markers (degrade visibly, AC-2.5/2.10).\\n559\\t    const messages = await pullMessages(degraded.sdk, degraded.filePath);\\n560\\t    const bandText = bandMessages(messages)\\n561\\t      .map((message) => message.content)\\n562\\t      .join(\\\"\\\\n\\\\n\\\");\\n563\\t    expect(bandText).toContain(\\\"[degraded: brief-from-detailed]\\\");\\n564\\t    expect(bandText).toContain(\\\"[degraded: smooth-from-excerpt]\\\");\\n565\\t    expect(bandText).toMatch(/§c2 \\\\[chunk c2 unavailable: no usable form/);\\n566\\t\\n567\\t    // Zero provider calls: missing material degrades, it is never re-derived\\n568\\t    // inline (AC-2.4's no-inference rule with teeth).\\n569\\t    expect(captured.length).toBe(capturedBefore);\\n570\\t  });\\n571\\t\\n572\\t  it(\\\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\\\", async () => {\\n573\\t    const status = await degraded.sdk.threadView.status({ filePath: degraded.filePath });\\n574\\t    expect(status.ok).toBe(true);\\n575\\t    if (!status.ok) return;\\n576\\t    expect(status.value.view).not.toBeNull();\\n577\\t    expect(status.value.view?.degraded).toBe(2);\\n578\\t    expect(status.value.view?.gaps).toBe(1);\\n579\\t    expect(typeof status.value.view?.builtAt).toBe(\\\"string\\\");\\n580\\t    // The edits' requeued rebuild work is visible as pending derivation.\\n581\\t    expect(status.value.derivation.pending).toBeGreaterThan(0);\\n582\\t  });\\n583\\t});\\n584\\t\\n585\\tdescribe(\\\"TC-2.7 (AC-2.5): canonical corruption refuses; derived-only damage degrades\\\", () => {\\n586\\t  it(\\\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\\\", async () => {\\n587\\t    const corruptStore = tempStore();\\n588\\t    try {\\n589\\t      const double = createProviderDouble();\\n590\\t      const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n591\\t      const filePath = corruptStore.threadPath();\\n592\\t      const created = await sdk.threads.newThread({\\n593\\t        filePath,\\n594\\t        registryPath: corruptStore.registryPath,\\n595\\t      });\\n596\\t      expect(created.ok).toBe(true);\\n597\\t      for (let turn = 1; turn <= 4; turn += 1) {\\n598\\t        const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\\n599\\t        expect(sent.ok).toBe(true);\\n600\\t      }\\n601\\t      const drained = await sdk.work.drain({ filePath });\\n602\\t      expect(drained.ok).toBe(true);\\n603\\t\\n604\\t      // A prior view exists before the damage.\\n605\\t      const first = await sdk.threadView.compact(\\n606\\t        { filePath },\\n607\\t        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\\n608\\t      );\\n609\\t      expect(first.ok).toBe(true);\\n610\\t      const priorPull = await sdk.threadView.pull({ filePath });\\n611\\t      expect(priorPull.ok).toBe(true);\\n612\\t      if (!priorPull.ok) return;\\n613\\t\\n614\\t      // Manufactured canonical corruption, damaged below the SDK (the Epic 01\\n615\\t      // two-open-turns pattern): open a turn through real intake, then add a\\n616\\t      // second open row.\\n617\\t      const opened = await sdk.intakeStream.messageEvents({ filePath }, [\\n618\\t        validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n619\\t      ]);\\n620\\t      expect(opened.ok).toBe(true);\\n621\\t      corruptTwoOpenTurns(filePath);\\n622\\t      const recordBefore = recordSnapshot(filePath);\\n623\\t\\n624\\t      const refused = await sdk.threadView.compact(\\n625\\t        { filePath },\\n626\\t        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\\n627\\t      );\\n628\\t      expect(refused.ok).toBe(false);\\n629\\t      if (refused.ok) return;\\n630\\t      expect(refused.error.errorClass).toBe(\\\"state_corruption\\\");\\n631\\t      expect(refused.error.code).toBe(\\\"turn_state_corrupt\\\");\\n632\\t      expect(refused.error.reason).toMatch(/open turns/);\\n633\\t\\n634\\t      // Pre-transaction refusal: prior view serves byte-identically, record\\n635\\t      // untouched.\\n636\\t      const afterPull = await sdk.threadView.pull({ filePath });\\n637\\t      expect(afterPull.ok).toBe(true);\\n638\\t      if (!afterPull.ok) return;\\n639\\t      expect(JSON.stringify(afterPull.value.messages.filter((m) => m.band !== undefined))).toBe(\\n640\\t        JSON.stringify(priorPull.value.messages.filter((m) => m.band !== undefined)),\\n641\\t      );\\n642\\t      expect(afterPull.value.meta.viewId).toBe(priorPull.value.meta.viewId);\\n643\\t      expect(recordSnapshot(filePath)).toBe(recordBefore);\\n644\\t    } finally {\\n645\\t      corruptStore.cleanup();\\n646\\t    }\\n647\\t  });\\n648\\t\\n649\\t  it(\\\"control: a thread with only derived-material damage compacts successfully with gaps\\\", async () => {\\n650\\t    // The suite fixture carries two scripted FAILED tool_result_summary forms\\n651\\t    // (derived damage only) and compacts clean throughout this file; the\\n652\\t    // explicit control here is the degraded build: summaries pending/failed,\\n653\\t    // zero usable forms on c2 — and the compact above completed with a gap\\n654\\t    // rather than refusing. Re-assert the contrast directly on the main\\n655\\t    // fixture: derived failures present, compact succeeds, no state_corruption.\\n656\\t    const receipt = await fixture.sdk.threadView.compact(\\n657\\t      { filePath: fixture.filePath },\\n658\\t      { params: GRADIENT_PARAMS },\\n659\\t    );\\n660\\t    expect(receipt.ok).toBe(true);\\n661\\t  });\\n662\\t});\\n663\\t\\n664\\tdescribe(\\\"TC-1.3 (AC-1.4) and TC-1.5 (AC-1.6): snapshot immutability under record mutation\\\", () => {\\n665\\t  let mutStore: TempStore;\\n666\\t  let mut: DerivedThreadFixture;\\n667\\t\\n668\\t  beforeAll(async () => {\\n669\\t    mutStore = tempStore();\\n670\\t    mut = await derivedThreadFixture(mutStore, { failures: false });\\n671\\t    const receipt = await mut.sdk.threadView.compact(\\n672\\t      { filePath: mut.filePath },\\n673\\t      { params: GRADIENT_PARAMS },\\n674\\t    );\\n675\\t    if (!receipt.ok) throw new Error(`setup compact failed: ${receipt.error.reason}`);\\n676\\t  });\\n677\\t  afterAll(() => {\\n678\\t    mutStore.cleanup();\\n679\\t  });\\n680\\t\\n681\\t  it(\\\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\\\", async () => {\\n682\\t    const before = bandMessages(await pullMessages(mut.sdk, mut.filePath));\\n683\\t    const bandHash = sha256(before);\\n684\\t\\n685\\t    // t5 is banded inside c2's detailed entry; edit its prompt.\\n686\\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\\n687\\t    expect(listed.ok).toBe(true);\\n688\\t    if (!listed.ok) return;\\n689\\t    const t5Prompt = listed.value.find((m) => m.turnId === \\\"t5\\\" && m.kind === \\\"user_prompt\\\");\\n690\\t    expect(t5Prompt).toBeDefined();\\n691\\t    if (t5Prompt === undefined) return;\\n692\\t    const edited = await mut.sdk.messages.edit(\\n693\\t      { filePath: mut.filePath },\\n694\\t      { messageId: t5Prompt.messageId, content: \\\"turn 5: edited after the snapshot\\\" },\\n695\\t    );\\n696\\t    expect(edited.ok).toBe(true);\\n697\\t\\n698\\t    const afterEdit = bandMessages(await pullMessages(mut.sdk, mut.filePath));\\n699\\t    expect(sha256(afterEdit)).toBe(bandHash);\\n700\\t\\n701\\t    // Drain the requeued rebuilds: the rebuilt summary lands in the RECORD\\n702\\t    // only; the snapshot still serves the same bytes.\\n703\\t    const drained = await mut.sdk.work.drain({ filePath: mut.filePath });\\n704\\t    expect(drained.ok).toBe(true);\\n705\\t    const afterDrain = bandMessages(await pullMessages(mut.sdk, mut.filePath));\\n706\\t    expect(sha256(afterDrain)).toBe(bandHash);\\n707\\t\\n708\\t    // The record really changed underneath: c2's rebuilt detailed summary is\\n709\\t    // not the text the band serves.\\n710\\t    const db = openRaw(mut.filePath);\\n711\\t    try {\\n712\\t      const row = db\\n713\\t        .prepare(\\n714\\t          `SELECT content FROM derived_form\\n715\\t           WHERE subject_kind = 'chunk' AND subject_id = 'c2' AND form = 'chunk_summary_detailed'`,\\n716\\t        )\\n717\\t        .get() as { content: string | null } | undefined;\\n718\\t      expect(row?.content).toBeDefined();\\n719\\t      const detailedBand = afterDrain.find((m) => m.band === \\\"detailed\\\");\\n720\\t      expect(detailedBand?.content).not.toContain(row?.content ?? \\\"<unset>\\\");\\n721\\t    } finally {\\n722\\t      db.close();\\n723\\t    }\\n724\\t  });\\n725\\t\\n726\\t  it(\\\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\\\", async () => {\\n727\\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\\n728\\t    expect(listed.ok).toBe(true);\\n729\\t    if (!listed.ok) return;\\n730\\t\\n731\\t    // Tail region: t9 onward (compact point 48). Delete t10's findings.\\n732\\t    const tailTarget = listed.value.find((m) => m.turnId === \\\"t10\\\" && m.kind === \\\"assistant_text\\\");\\n733\\t    expect(tailTarget).toBeDefined();\\n734\\t    if (tailTarget === undefined) return;\\n735\\t    const statusBefore = await mut.sdk.threadView.status({ filePath: mut.filePath });\\n736\\t    expect(statusBefore.ok).toBe(true);\\n737\\t    if (!statusBefore.ok) return;\\n738\\t\\n739\\t    const tailDelete = await mut.sdk.messages.deleteMessage(\\n740\\t      { filePath: mut.filePath },\\n741\\t      { messageId: tailTarget.messageId },\\n742\\t    );\\n743\\t    expect(tailDelete.ok).toBe(true);\\n744\\t    const afterTailDelete = await pullMessages(mut.sdk, mut.filePath);\\n745\\t    expect(\\n746\\t      afterTailDelete.some((m) => m.content === \\\"findings for area 10\\\"),\\n747\\t    ).toBe(false);\\n748\\t\\n749\\t    // The record change is visible to the status read (tail sum shrank).\\n750\\t    const statusAfter = await mut.sdk.threadView.status({ filePath: mut.filePath });\\n751\\t    expect(statusAfter.ok).toBe(true);\\n752\\t    if (!statusAfter.ok) return;\\n753\\t    expect(statusAfter.value.tailTokens).toBeLessThan(statusBefore.value.tailTokens);\\n754\\t\\n755\\t    // Banded region: delete a t6 message whose derived content sits inside\\n756\\t    // c2's band entry. The snapshot is untouched until the next compact.\\n757\\t    const bandsBefore = bandMessages(afterTailDelete);\\n758\\t    const bandTarget = listed.value.find((m) => m.turnId === \\\"t6\\\" && m.kind === \\\"assistant_text\\\");\\n759\\t    expect(bandTarget).toBeDefined();\\n760\\t    if (bandTarget === undefined) return;\\n761\\t    const bandedDelete = await mut.sdk.messages.deleteMessage(\\n762\\t      { filePath: mut.filePath },\\n763\\t      { messageId: bandTarget.messageId },\\n764\\t    );\\n765\\t    expect(bandedDelete.ok).toBe(true);\\n766\\t\\n767\\t    const afterBandedDelete = await pullMessages(mut.sdk, mut.filePath);\\n768\\t    expect(sha256(bandMessages(afterBandedDelete))).toBe(sha256(bandsBefore));\\n769\\t\\n770\\t    // Next-compact visibility: the record changed under the snapshot — the\\n771\\t    // delete's cascade left rebuild work pending in the status read.\\n772\\t    const statusFinal = await mut.sdk.threadView.status({ filePath: mut.filePath });\\n773\\t    expect(statusFinal.ok).toBe(true);\\n774\\t    if (!statusFinal.ok) return;\\n775\\t    expect(statusFinal.value.derivation.pending).toBeGreaterThan(0);\\n776\\t  });\\n777\\t});\\n778\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f006cddb-2184-479e-939b-55dccd3023e3\",\"uuid\":\"ec4eb732-257a-4d9b-8fcc-11e8bde638ee\",\"timestamp\":\"2026-06-11T16:41:14.123Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-compact.test.ts\",\"content\":\"    validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n    validEvent(\\\"turn_end\\\"),\\n  );\\n  return events;\\n}\\n\\ninterface DegradedThread {\\n  filePath: string;\\n  sdk: Lhc;\\n  double: ProviderDouble;\\n  promptIdByTurn: Map<number, string>;\\n}\\n\\nasync function buildDegradedThread(intoStore: TempStore): Promise<DegradedThread> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({\\n    provider: double,\\n    mode: \\\"manual\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n  });\\n  const filePath = intoStore.threadPath();\\n  const created = await sdk.threads.newThread({ filePath, registryPath: intoStore.registryPath });\\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\n\\n  const promptIdByTurn = new Map<number, string>();\\n  for (let turn = 1; turn <= 12; turn += 1) {\\n    if (turn === 4) {\\n      // c1 closes during turn 4's drain (placement of t4): its brief summary\\n      // exhausts through real retry mechanics — a FAILED chunk summary.\\n      double.failKind(\\\"chunk_summary_brief\\\", 3, {\\n        retryable: true,\\n        reason: C1_BRIEF_EXHAUST_REASON,\\n      });\\n    }\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\\n    if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\\n    const promptId = sent.value.events[0]?.messageId;\\n    if (promptId !== undefined && promptId !== null) promptIdByTurn.set(turn, promptId);\\n    const drained = await sdk.work.drain({ filePath });\\n    if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\\n  }\\n\\n  // Post-build edits, NOT drained: the cascade clears each edited message's\\n  // dependent chain to pending. t8 ⇒ a PENDING turn rendering in the smooth\\n  // band; t4+t5+t6 ⇒ c2's summaries pending with zero ready member\\n  // projections — the gap rung.\\n  for (const turn of [4, 5, 6, 8]) {\\n    const promptId = promptIdByTurn.get(turn);\\n    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\\n    const edited = await sdk.messages.edit(\\n      { filePath },\\n      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\\n    );\\n    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\\n  }\\n  return { filePath, sdk, double, promptIdByTurn };\\n}\\n\\ndescribe(\\\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\\\", () => {\\n  let degradedStore: TempStore;\\n  let degraded: DegradedThread;\\n\\n  beforeAll(async () => {\\n    degradedStore = tempStore();\\n    degraded = await buildDegradedThread(degradedStore);\\n  });\\n  afterAll(() => {\\n    degradedStore.cleanup();\\n  });\\n\\n  it(\\\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\\\", async () => {\\n    const captured = degraded.double.captureInputs();\\n    const capturedBefore = captured.length;\\n\\n    const receipt = await degraded.sdk.threadView.compact(\\n      { filePath: degraded.filePath },\\n      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\\n    );\\n    expect(receipt.ok).toBe(true);\\n    if (!receipt.ok) return;\\n\\n    // The pending turn rendering (t8, edited): the smooth entry degrades down\\n    // its ladder (projection pending too) to the deterministic excerpt.\\n    const t8 = receipt.value.degraded.find((entry) => entry.subjectId === \\\"t8\\\");\\n    expect(t8).toBeDefined();\\n    expect(t8?.band).toBe(\\\"smooth\\\");\\n    expect(t8?.usedForm).toBe(\\\"message_excerpt\\\");\\n\\n    // The failed chunk summary (c1's brief): the brief entry renders the\\n    // truncated detailed summary, marked.\\n    const c1 = receipt.value.degraded.find((entry) => entry.subjectId === \\\"c1\\\");\\n    expect(c1).toBeDefined();\\n    expect(c1?.band).toBe(\\\"brief\\\");\\n    expect(c1?.usedForm).toBe(\\\"chunk_summary_detailed_truncated\\\");\\n\\n    // The unusable chunk (c2: summaries pending, zero ready member\\n    // projections): an explicit gap entry with its reason — never absence.\\n    expect(receipt.value.gaps).toHaveLength(1);\\n    const gap = receipt.value.gaps[0];\\n    expect(gap?.subjectId).toBe(\\\"c2\\\");\\n    expect(gap?.reason).toMatch(/no usable form/);\\n    expect(gap?.reason).toContain(\\\"chunk_summary_detailed: pending\\\");\\n\\n    // Per-band counts present; no span silently absent: every turn in the\\n    // compacted range is accounted for by a band subject (c1: t1–t3, c2:\\n    // t4–t6, smooth: t7–t8) and everything after the compact point is tail.\\n    expect(receipt.value.bands.brief.entries).toBe(1);\\n    expect(receipt.value.bands.detailed.entries).toBe(1);\\n    expect(receipt.value.bands.smooth.entries).toBe(2);\\n    expect(receipt.value.compactPoint).toBe(48);\\n    expect(receipt.value.coveredFrom).toBe(1);\\n\\n    // The rendered text carries the markers (degrade visibly, AC-2.5/2.10).\\n    const messages = await pullMessages(degraded.sdk, degraded.filePath);\\n    const bandText = bandMessages(messages)\\n      .map((message) => message.content)\\n      .join(\\\"\\\\n\\\\n\\\");\\n    expect(bandText).toContain(\\\"[degraded: brief-from-detailed]\\\");\\n    expect(bandText).toContain(\\\"[degraded: smooth-from-excerpt]\\\");\\n    expect(bandText).toMatch(/§c2 \\\\[chunk c2 unavailable: no usable form/);\\n\\n    // Zero provider calls: missing material degrades, it is never re-derived\\n    // inline (AC-2.4's no-inference rule with teeth).\\n    expect(captured.length).toBe(capturedBefore);\\n  });\\n\\n  it(\\\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\\\", async () => {\\n    const status = await degraded.sdk.threadView.status({ filePath: degraded.filePath });\\n    expect(status.ok).toBe(true);\\n    if (!status.ok) return;\\n    expect(status.value.view).not.toBeNull();\\n    expect(status.value.view?.degraded).toBe(2);\\n    expect(status.value.view?.gaps).toBe(1);\\n    expect(typeof status.value.view?.builtAt).toBe(\\\"string\\\");\\n    // The edits' requeued rebuild work is visible as pending derivation.\\n    expect(status.value.derivation.pending).toBeGreaterThan(0);\\n  });\\n});\\n\\ndescribe(\\\"TC-2.7 (AC-2.5): canonical corruption refuses; derived-only damage degrades\\\", () => {\\n  it(\\\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\\\", async () => {\\n    const corruptStore = tempStore();\\n    try {\\n      const double = createProviderDouble();\\n      const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n      const filePath = corruptStore.threadPath();\\n      const created = await sdk.threads.newThread({\\n        filePath,\\n        registryPath: corruptStore.registryPath,\\n      });\\n      expect(created.ok).toBe(true);\\n      for (let turn = 1; turn <= 4; turn += 1) {\\n        const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\\n        expect(sent.ok).toBe(true);\\n      }\\n      const drained = await sdk.work.drain({ filePath });\\n      expect(drained.ok).toBe(true);\\n\\n      // A prior view exists before the damage.\\n      const first = await sdk.threadView.compact(\\n        { filePath },\\n        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\\n      );\\n      expect(first.ok).toBe(true);\\n      const priorPull = await sdk.threadView.pull({ filePath });\\n      expect(priorPull.ok).toBe(true);\\n      if (!priorPull.ok) return;\\n\\n      // Manufactured canonical corruption, damaged below the SDK (the Epic 01\\n      // two-open-turns pattern): open a turn through real intake, then add a\\n      // second open row.\\n      const opened = await sdk.intakeStream.messageEvents({ filePath }, [\\n        validEvent(\\\"user_prompt\\\", { payload: { text: \\\"left open before the damage\\\" } }),\\n      ]);\\n      expect(opened.ok).toBe(true);\\n      corruptTwoOpenTurns(filePath);\\n      const recordBefore = recordSnapshot(filePath);\\n\\n      const refused = await sdk.threadView.compact(\\n        { filePath },\\n        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\\n      );\\n      expect(refused.ok).toBe(false);\\n      if (refused.ok) return;\\n      expect(refused.error.errorClass).toBe(\\\"state_corruption\\\");\\n      expect(refused.error.code).toBe(\\\"turn_state_corrupt\\\");\\n      expect(refused.error.reason).toMatch(/open turns/);\\n\\n      // Pre-transaction refusal: prior view serves byte-identically, record\\n      // untouched.\\n      const afterPull = await sdk.threadView.pull({ filePath });\\n      expect(afterPull.ok).toBe(true);\\n      if (!afterPull.ok) return;\\n      expect(JSON.stringify(afterPull.value.messages.filter((m) => m.band !== undefined))).toBe(\\n        JSON.stringify(priorPull.value.messages.filter((m) => m.band !== undefined)),\\n      );\\n      expect(afterPull.value.meta.viewId).toBe(priorPull.value.meta.viewId);\\n      expect(recordSnapshot(filePath)).toBe(recordBefore);\\n    } finally {\\n      corruptStore.cleanup();\\n    }\\n  });\\n\\n  it(\\\"control: a thread with only derived-material damage compacts successfully with gaps\\\", async () => {\\n    // The suite fixture carries two scripted FAILED tool_result_summary forms\\n    // (derived damage only) and compacts clean throughout this file; the\\n    // explicit control here is the degraded build: summaries pending/failed,\\n    // zero usable forms on c2 — and the compact above completed with a gap\\n    // rather than refusing. Re-assert the contrast directly on the main\\n    // fixture: derived failures present, compact succeeds, no state_corruption.\\n    const receipt = await fixture.sdk.threadView.compact(\\n      { filePath: fixture.filePath },\\n      { params: GRADIENT_PARAMS },\\n    );\\n    expect(receipt.ok).toBe(true);\\n  });\\n});\\n\\ndescribe(\\\"TC-1.3 (AC-1.4) and TC-1.5 (AC-1.6): snapshot immutability under record mutation\\\", () => {\\n  let mutStore: TempStore;\\n  let mut: DerivedThreadFixture;\\n\\n  beforeAll(async () => {\\n    mutStore = tempStore();\\n    mut = await derivedThreadFixture(mutStore, { failures: false });\\n    const receipt = await mut.sdk.threadView.compact(\\n      { filePath: mut.filePath },\\n      { params: GRADIENT_PARAMS },\\n    );\\n    if (!receipt.ok) throw new Error(`setup compact failed: ${receipt.error.reason}`);\\n  });\\n  afterAll(() => {\\n    mutStore.cleanup();\\n  });\\n\\n  it(\\\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\\\", async () => {\\n    const before = bandMessages(await pullMessages(mut.sdk, mut.filePath));\\n    const bandHash = sha256(before);\\n\\n    // t5 is banded inside c2's detailed entry; edit its prompt.\\n    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    const t5Prompt = listed.value.find((m) => m.turnId === \\\"t5\\\" && m.kind === \\\"user_prompt\\\");\\n    expect(t5Prompt).toBeDefined();\\n    if (t5Prompt === undefined) return;\\n    const edited = await mut.sdk.messages.edit(\\n      { filePath: mut.filePath },\\n      { messageId: t5Prompt.messageId, content: \\\"turn 5: edited after the snapshot\\\" },\\n    );\\n    expect(edited.ok).toBe(true);\\n\\n    const afterEdit = bandMessages(await pullMessages(mut.sdk, mut.filePath));\\n    expect(sha256(afterEdit)).toBe(bandHash);\\n\\n    // Drain the requeued rebuilds: the rebuilt summary lands in the RECORD\\n    // only; the snapshot still serves the same bytes.\\n    const drained = await mut.sdk.work.drain({ filePath: mut.filePath });\\n    expect(drained.ok).toBe(true);\\n    const afterDrain = bandMessages(await pullMessages(mut.sdk, mut.filePath));\\n    expect(sha256(afterDrain)).toBe(bandHash);\\n\\n    // The record really changed underneath: c2's rebuilt detailed summary is\\n    // not the text the band serves.\\n    const db = openRaw(mut.filePath);\\n    try {\\n      const row = db\\n        .prepare(\\n          `SELECT content FROM derived_form\\n           WHERE subject_kind = 'chunk' AND subject_id = 'c2' AND form = 'chunk_summary_detailed'`,\\n        )\\n        .get() as { content: string | null } | undefined;\\n      expect(row?.content).toBeDefined();\\n      const detailedBand = afterDrain.find((m) => m.band === \\\"detailed\\\");\\n      expect(detailedBand?.content).not.toContain(row?.content ?? \\\"<unset>\\\");\\n    } finally {\\n      db.close();\\n    }\\n  });\\n\\n  it(\\\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\\\", async () => {\\n    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n\\n    // Tail region: t9 onward (compact point 48). Delete t10's findings.\\n    const tailTarget = listed.value.find((m) => m.turnId === \\\"t10\\\" && m.kind === \\\"assistant_text\\\");\\n    expect(tailTarget).toBeDefined();\\n    if (tailTarget === undefined) return;\\n    const statusBefore = await mut.sdk.threadView.status({ filePath: mut.filePath });\\n    expect(statusBefore.ok).toBe(true);\\n    if (!statusBefore.ok) return;\\n\\n    const tailDelete = await mut.sdk.messages.deleteMessage(\\n      { filePath: mut.filePath },\\n      { messageId: tailTarget.messageId },\\n    );\\n    expect(tailDelete.ok).toBe(true);\\n    const afterTailDelete = await pullMessages(mut.sdk, mut.filePath);\\n    expect(\\n      afterTailDelete.some((m) => m.content === \\\"findings for area 10\\\"),\\n    ).toBe(false);\\n\\n    // The record change is visible to the status read (tail sum shrank).\\n    const statusAfter = await mut.sdk.threadView.status({ filePath: mut.filePath });\\n    expect(statusAfter.ok).toBe(true);\\n    if (!statusAfter.ok) return;\\n    expect(statusAfter.value.tailTokens).toBeLessThan(statusBefore.value.tailTokens);\\n\\n    // Banded region: delete a t6 message whose derived content sits inside\\n    // c2's band entry. The snapshot is untouched until the next compact.\\n    const bandsBefore = bandMessages(afterTailDelete);\\n    const bandTarget = listed.value.find((m) => m.turnId === \\\"t6\\\" && m.kind === \\\"assistant_text\\\");\\n    expect(bandTarget).toBeDefined();\\n    if (bandTarget === undefined) return;\\n    const bandedDelete = await mut.sdk.messages.deleteMessage(\\n      { filePath: mut.filePath },\\n      { messageId: bandTarget.messageId },\\n    );\\n    expect(bandedDelete.ok).toBe(true);\\n\\n    const afterBandedDelete = await pullMessages(mut.sdk, mut.filePath);\\n    expect(sha256(bandMessages(afterBandedDelete))).toBe(sha256(bandsBefore));\\n\\n    // Next-compact visibility: the record changed under the snapshot — the\\n    // delete's cascade left rebuild work pending in the status read.\\n    const statusFinal = await mut.sdk.threadView.status({ filePath: mut.filePath });\\n    expect(statusFinal.ok).toBe(true);\\n    if (!statusFinal.ok) return;\\n    expect(statusFinal.value.derivation.pending).toBeGreaterThan(0);\\n  });\\n});\\n\",\"numLines\":334,\"startLine\":445,\"totalLines\":778}}}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/03-readiness-sweep/streams/004-implementor.stdout.log:1017:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FoSxomqmKWcopJske95JAG\",\"type\":\"tool_result\",\"content\":\"62:// thread-view consumes the messages/turns report surfaces and the threads\\n63:// resolver; intake-stream gains the thread-view surface for the boundary\\n66:// thread-view → messages/turns → intake-stream (the last edges are type-only\\n72:  \\\"intake-stream\\\": new Set([\\\"threads\\\", \\\"messages\\\", \\\"turns\\\", \\\"thread-view\\\"]),\\n75:  \\\"thread-view\\\": new Set([\\\"threads\\\", \\\"messages\\\", \\\"turns\\\"]),\\n---\\n  ProviderDouble,\\n  type CapturedInput,\\n  type ProviderOpName,\\n} from \\\"./provider-double.js\\\";\\nexport {\\n  registerTestWorkHandlers,\\n  testWorkHandlers,\\n  type TestHandlerHooks,\\n} from \\\"./work-handlers.js\\\";\\nexport {\\n  fireViewInjection,\\n  seedViewBoundary,\\n  setViewInjectionHook,\\n  type ViewInjectionHook,\\n  type ViewInjectionPoint,\\n} from \\\"./view-seam.js\\\";\\nexport {\\n  blockedSiblingThread,\\n  corruptedVariantThread,\\n  derivedThreadFixture,\\n  PERMANENT_FAILURE_REASON,\\n  stragglerVariantThread,\\n  TRANSIENT_EXHAUST_REASON,\\n  type DerivedThreadFixture,\\n  type DerivedThreadOptions,\\n} from \\\"./view-thread.js\\\";\\nexport {\\n  damagedSourceThread,\\n  GAPPED_SMOOTHING_REASON,\\n  gappedRenderingThread,\\n  multiStateThr
ok = () => void;\\n16\\t\\n17\\tconst hooks: Record<ViewInjectionPoint, ViewInjectionHook | null> = {\\n18\\t  \\\"post-commit-advance\\\": null,\\n19\\t  \\\"compact-write\\\": null,\\n20\\t};\\n21\\t\\n22\\texport function setViewInjectionHook(\\n23\\t  point: ViewInjectionPoint,\\n24\\t  hook: ViewInjectionHook | null,\\n25\\t): void {\\n26\\t  hooks[point] = hook;\\n27\\t}\\n28\\t\\n29\\t// The production-side call: a no-op when nothing is installed. An installed\\n30\\t// hook's throw propagates to the call site on purpose — that is the injected\\n31\\t// failure the call site must survive.\\n32\\texport function fireViewInjection(point: ViewInjectionPoint): void {\\n33\\t  hooks[point]?.();\\n34\\t}\\n35\\t\"}]},\"parent_tool_use_id\":\"toolu_01G1xRJXcsNXpLPr4Ci3qXFE\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\",\"uuid\":\"d5127f1e-918d-4e08-919c-f26cc500a519\",\"timestamp\":\"2026-06-11T18:23:49.421Z\",\"subagent_type\":\"Explore\",\"task_description\":\"Production-path and boundary audit\"}\n{\"type\":\"system\",\"subtype\":\"task_progress\",\"task_id\":\"ae8c355ab4ac452fa\",\"tool_use_id\":\"toolu_01G1xRJXcsNXpLPr4Ci3qXFE\",\"description\":\"Reading packages/lhc/src/domains/thread-view/index.ts\",\"subagent_type\":\"Explore\",\"usage\":{\"total_tokens\":16207,\"tool_uses\":11,\"duration_ms\":18067},\"last_tool_name\":\"Read\",\"uuid\":\"e44fbb4b-610c-498a-8f62-49263aadbb77\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_0178tM2x9tPv9MkUSPGfC2Vy\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Ev8Pb875CoDWfVzQVPSZgv\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/index.ts\",\"limit\":200},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":5,\"cache_creation_input_tokens\":222,\"cache_read_input_tokens\":15913,\"cache_creation\":{\"ephemeral_5m_input_tokens\":222,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":1,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":\"toolu_01G1xRJXcsNXpLPr4Ci3qXFE\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\",\"uuid\":\"b5f66529-4753-4f7b-b28a-cb6d39680497\",\"request_id\":\"req_011CbwwTTY8oo3xRrqSV76xY\",\"subagent_type\":\"Explore\",\"task_description\":\"Production-path and boundary audit\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Ev8Pb875CoDWfVzQVPSZgv\",\"type\":\"tool_result\",\"content\":\"1\\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\\n2\\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\\n3\\t// deterministic string assembly only, no inference, no network, no queue\\n4\\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\\n5\\t// Story 3 landed `sweep` (standalone and embedded default-on in compact);\\n6\\t// Story 5 lands `materialize` (the PI session-file render target over the\\n7\\t// same pull assembly). Story 0's substrate (profile resolution, consumed by\\n8\\t// createSdk) re-exports at the bottom.\\n9\\timport { existsSync } from \\\"node:fs\\\";\\n10\\timport * as path from \\\"node:path\\\";\\n11\\timport {\\n12\\t  resolveInstanceViewConfig,\\n13\\t  runWithThreadTouchSuppressed,\\n14\\t  type OperationContext,\\n15\\t} from \\\"../../shared/context.js\\\";\\n16\\timport type { FormReportEntry } from \\\"../../shared/derivation.js\\\";\\n17\\timport { storageFailure, type ErrorResult, type OpResult } from \\\"../../shared/errors.js\\\";\\n18\\timport type {\\n19\\t  CompactReceipt,\\n20\\t  PullResult,\\n21\\t  ResolvedViewConfig,\\n22\\t  SweepReceipt,\\n23\\t  ViewCompactParams,\\n24\\t  ViewMessage,\\n25\\t  ViewProfile,\\n26\\t  ViewStatus,\\n27\\t} from \\\"../../shared/view.js\\\";\\n28\\timport * as messagesDomain from \\\"../messages/index.js\\\";\\n29\\timport * as turnsDomain from \\\"../turns/index.js\\\";\\n30\\timport {\\n31\\t  openThreadDatabase,\\n32\\t  resolveThreadRef,\\n33\\t  type ThreadRef,\\n34\\t} from \\\"../threads/index.js\\\";\\n35\\timport {\\n36\\t  executeBoundaryAdvance,\\n37\\t  readBoundaryPosition,\\n38\\t  visibilityZoneTokens,\\n39\\t} from \\\"./internal/boundary.js\\\";\\n40\\timport { profileViolation, resolveViewConfig } from \\\"./internal/profiles.js\\\";\\n41\\timport {\\n42\\t  assembleBandText,\\n43\\t  renderBandMessage,\\n44\\t  renderTailMessage,\\n45\\t  toolNamesByCallId,\\n46\\t} from \\\"./internal/render.js\\\";\\n47\\timport { fireViewInjection } from \\\"./internal/seam.js\\\";\\n48\\timport {\\n49\\t  CanonicalCorruptionError,\\n50\\t  readSelectionInputs,\\n51\\t  selectArrangement,\\n52\\t  type ArrangementEntry,\\n53\\t} from \\\"./internal/select.js\\\";\\n54\\timport { writePiSessionFile, type MaterializeInput } from \\\"./internal/materialize.js\\\";\\n55\\timport {\\n56\\t  readReadyToolResultSummaries,\\n57\\t  readTailMessages,\\n58\\t  readThreadMetadata,\\n59\\t  readViewSnapshot,\\n60\\t  replaceViewSnapshot,\\n61\\t  tailTokenSum,\\n62\\t} from \\\"./internal/snapshot.js\\\";\\n63\\timport { runSweep } from \\\"./internal/sweep.js\\\";\\n64\\timport { estimateTokens } from \\\"../../tech-utils/token-counting/index.js\\\";\\n65\\timport type { Band } from \\\"../../shared/view.js\\\";\\n66\\t\\n67\\t// Config resolution for the operation in hand: the SDK instance's resolved\\n68\\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\\n69\\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\\n70\\t// through the same one resolution path createSdk uses.\\n71\\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\\n72\\t\\n73\\tfunction viewConfig(): ResolvedViewConfig {\\n74\\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\\n75\\t}\\n76\\t\\n77\\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\\n78\\t  return {\\n79\\t    ok: false,\\n80\\t    error: {\\n81\\t      errorClass: \\\"caller_error\\\",\\n82\\t      code: \\\"thread_not_found\\\",\\n83\\t      reason: `no thread file exists at ${filePath}`,\\n84\\t    },\\n85\\t  };\\n86\\t}\\n87\\t\\n88\\tfunction detail(cause: unknown): string {\\n89\\t  return cause instanceof Error ? cause.message : String(cause);\\n90\\t}\\n91\\t\\n92\\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\\n93\\t\\n94\\t// The hot-path read: view header + bands (if any), tail messages after the\\n95\\t// compact point (deleted-filtered, record order), boundary position; then\\n96\\t// format — band messages first, tail per the mapping table, tool results\\n97\\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\\n98\\t// tail from event 1 (AC-1.3) through this same code path with the compact\\n99\\t// point at its zero origin — snapshot-absent, never a separate branch.\\n100\\t//\\n101\\t// Reads-only is structural, not disciplined: the whole operation runs in the\\n102\\t// touch-suppressed scope, so the open announcement that would let a\\n103\\t// background SDK's scheduler hang a first-touch catch-up drain off this read\\n104\\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\\n105\\t// AC-1.1's no-queue-interaction holds in both host modes.\\n106\\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\\n107\\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\\n108\\t}\\n109\\t\\n110\\t// The one assembly both render targets consume (Story 5): pull serves the\\n111\\t// messages; materialize serves the same entries with the metadata the file's\\n112\\t// generated fields derive from (entry ids, record-time timestamps). Sharing\\n113\\t// the array is what makes AC-5.3's parity structural — materialize cannot\\n114\\t// diverge from pull because there is no second assembly to diverge.\\n115\\tinterface AssembledView {\\n116\\t  entries: Array<{ message: ViewMessage; entryId: string; timestamp: string }>;\\n117\\t  meta: PullResult[\\\"meta\\\"];\\n118\\t  snapshot: ReturnType<typeof readViewSnapshot>;\\n119\\t}\\n120\\t\\n121\\tfunction assembleView(db: Parameters<typeof readViewSnapshot>[0]): AssembledView {\\n122\\t  const snapshot = readViewSnapshot(db);\\n123\\t  const compactPoint = snapshot?.compactPoint ?? 0;\\n124\\t  const boundaryPosition = readBoundaryPosition(db);\\n125\\t  const tailRows = readTailMessages(db, compactPoint);\\n126\\t  const renderCtx = {\\n127\\t    boundaryPosition,\\n128\\t    toolNameByCallId: toolNamesByCallId(tailRows),\\n129\\t    toolResultSummaries: readReadyToolResultSummaries(db),\\n130\\t  };\\n131\\t\\n132\\t  const entries: AssembledView[\\\"entries\\\"] = [];\\n133\\t  if (snapshot !== null) {\\n134\\t    for (const band of snapshot.bands) {\\n135\\t      entries.push({\\n136\\t        message: renderBandMessage(band.band, band.renderedText),\\n137\\t        // Band entries are not record messages; their generated fields\\n138\\t        // derive from view metadata (AC-5.2).\\n139\\t        entryId: `${snapshot.viewId}-${band.band}`,\\n140\\t        timestamp: snapshot.createdAt,\\n141\\t      });\\n142\\t    }\\n143\\t  }\\n144\\t  for (const row of tailRows) {\\n145\\t    entries.push({\\n146\\t      message: renderTailMessage(row, renderCtx),\\n147\\t      entryId: row.messageId,\\n148\\t      timestamp: row.recordedAt,\\n149\\t    });\\n150\\t  }\\n151\\t\\n152\\t  return {\\n153\\t    entries,\\n154\\t    meta: {\\n155\\t      compactPoint: snapshot?.compactPoint ?? null,\\n156\\t      coveredFrom: snapshot?.coveredFrom ?? null,\\n157\\t      boundaryPosition,\\n158\\t      gapCount: snapshot?.gapCount ?? 0,\\n159\\t      degradedCount: snapshot?.degradedCount ?? 0,\\n160\\t      viewId: snapshot?.viewId ?? null,\\n161\\t      createdAt: snapshot?.createdAt ?? null,\\n162\\t    },\\n163\\t    snapshot,\\n164\\t  };\\n165\\t}\\n166\\t\\n167\\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\\n168\\t  const resolved = await resolveThreadRef(ref);\\n169\\t  if (!resolved.ok) return resolved;\\n170\\t  const { filePath } = resolved.value;\\n171\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n172\\t\\n173\\t  const opened = openThreadDatabase(filePath);\\n174\\t  if (!opened.ok) return opened;\\n175\\t  const db = opened.value;\\n176\\t  try {\\n177\\t    const assembled = assembleView(db);\\n178\\t    return {\\n179\\t      ok: true,\\n180\\t      value: {\\n181\\t        messages: assembled.entries.map((entry) => entry.message),\\n182\\t        meta: assembled.meta,\\n183\\t      },\\n184\\t    };\\n185\\t  } catch (cause) {\\n186\\t    return storageFailure(`view pull failed: ${detail(cause)}`);\\n187\\t  } finally {\\n188\\t    db.close();\\n189\\t  }\\n190\\t}\\n191\\t\\n192\\t// ── status (AC-2.8) ───────────────────────────────────────────────\\n193\\t\\n194\\t// Derivation counts bucket from one report entry the way the report's own\\n195\\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\\n196\\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\\n197\\t// forms are healthy and not an operational situation.\\n198\\tfunction bucketDerivation(\\n199\\t  entries: readonly FormReportEntry[],\\n200\\t  counts: ViewStatus[\\\"derivation\\\"],\"}]},\"parent_tool_use_id\":\"toolu_01G1xRJXcsNXpLPr4Ci3qXFE\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\",\"uuid\":\"b65a95d3-ac73-413d-9aec-27249be21f3b\",\"timestamp\":\"2026-06-11T18:23:49.531Z\",\"subagent_type\":\"Explore\",\"task_description\":\"Production-path and boundary audit\"}\n{\"type\":\"system\",\"subtype\":\"task_progress\",\"task_id\":\"a39391ae5d0a4c317\",\"tool_use_id\":\"toolu_01JVfJF1EzgZaekjRcpXxggG\",\"description\":\"Reading packages/lhc/test/goldens/README.md\",\"subagent_type\":\"Explore\",\"usage\":{\"total_tokens\":29891,\"tool_uses\":23,\"duration_ms\":34565},\"last_tool_name\":\"Read\",\"uuid\":\"7c7e0285-bc34-419c-a899-070335c1b960\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_018xKRyPiWoPqavZnQ7n64uC\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01QFZGpVgq7bnAHbvbZiyXKQ\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/goldens/README.md\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":3,\"cache_creation_input_tokens\":443,\"cache_read_input_tokens\":29203,\"cache_creation\":{\"ephemeral_5m_input_tokens\":443,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":51,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":\"toolu_01JVfJF1EzgZaekjRcpXxggG\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\",\"uuid\":\"9c7218b7-2d28-4b51-a4e7-ed145b6d40cb\",\"request_id\":\"req_011CbwwTacYDFgDvcaDvVVem\",\"subagent_type\":\"Explore\",\"task_description\":\"Audit test-plan conformance\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01QFZGpVgq7bnAHbvbZiyXKQ\",\"type\":\"tool_result\",\"content\":\"1\\t# Selection goldens (Epic 03 Story 2, G1–G4)\\n2\\t\\n3\\tCommitted expected arrangements for the band-selection walk (tech design\\n4\\t§Deterministic Algorithms), consumed by `test/view-select-golden.test.ts`.\\n5\\tEach golden pins the exact arrangement a compact must produce on the Story-0\\n6\\tfixture (or its straggler variant) under explicit params: subject ids per\\n7\\tband, form used, compact point, covered_from, and gaps.\\n8\\t\\n9\\t**Goldens are immutable once committed.** An implementation that disagrees\\n10\\twith a golden is wrong until the *design rule* is shown wrong — that takes the\\n11\\tdeviation process, not a golden edit. The expected values were hand-derived\\n12\\tfrom the design's rules (rules 1–6, the pinned ≤/newest-first/newest-member\\n13\\ttie-breakers) against the fixture's deterministic token costs.\\n14\\t\\n15\\tRegenerated once under impl-lead ruling\\n16\\t`02-smart-compact-story-run-001-ruling-013`: the first commit's goldens\\n17\\tencoded extra-rule selection behavior (smooth-obligate inclusion,\\n18\\tpartial-chunk retreat, suppressed brief loner); these goldens encode the\\n19\\tliteral rules.\\n20\\t\\n21\\t| File | Case | Rule under test |\\n22\\t|------|------|-----------------|\\n23\\t| `g1-proportions.json` | G1 | shares → bands across the full gradient |\\n24\\t| `g2-edge-inclusion.json` | G2a | entry exactly filling the remainder is included (≤) |\\n25\\t| `g2-edge-exclusion.json` | G2b | one token under the exact fill → excluded, band stops |\\n26\\t| `g3-oversized-loner.json` | G3 | oversized entry on an otherwise-empty band represents alone |\\n27\\t| `g4-turnless-straggler.json` | G4 | rule 6: straggler rides the following turn's band entry; trailing straggler is tail |\\n28\\t| `boundary-g1-trajectory.json` | Boundary G1 (Story 4) | advance trajectory: over-max trigger, oldest-first flips to target, whole-message floor join, oversized-newest protected alone, never-backward across batches |\\n29\\t\\n30\\t## Regeneration (only with a granted deviation)\\n31\\t\\n32\\tThe actual arrangement for any params can be printed by running the golden\\n33\\tsuite with `GOLDEN_DUMP=1`:\\n34\\t\\n35\\t```\\n36\\tGOLDEN_DUMP=1 npx vitest run test/view-select-golden.test.ts\\n37\\t```\\n38\\t\\n39\\tEach case logs its actual `{compactPoint, coveredFrom, arrangement, gaps}`\\n40\\tJSON; verify the new values against the design rules by hand before replacing\\n41\\ta file, and record the deviation that made the old golden wrong.\\n42\\t\"}]},\"parent_tool_use_id\":\"toolu_01JVfJF1EzgZaekjRcpXxggG\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\",\"uuid\":\"d6031d5c-81ab-4086-8fb1-2d5bb4a66baf\",\"timestamp\":\"2026-06-11T18:23:50.975Z\",\"subagent_type\":\"Explore\",\"task_description\":\"Audit test-plan conformance\"}\n{\"type\":\"system\",\"subtype\":\"task_progress\",\"task_id\":\"a39391ae5d0a4c317\",\"tool_use_id\":\"toolu_01JVfJF1EzgZaekjRcpXxggG\",\"description\":\"Reading packages/lhc/test/goldens/g1-proportions.json\",\"subagent_type\":\"Explore\",\"usage\":{\"total_tokens\":29942,\"tool_uses\":24,\"duration_ms\":34642},\"last_tool_name\":\"Read\",\"uuid\":\"b187814b-884d-4d3b-825d-01bf5346b9a7\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-haiku-4-5-20251001\",\"id\":\"msg_018xKRyPiWoPqavZnQ7n64uC\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_015W95xgkSRCvXeGgzKidyDv\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/goldens/g1-proportions.json\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":3,\"cache_creation_input_tokens\":443,\"cache_read_input_tokens\":29203,\"cache_creation\":{\"ephemeral_5m_input_tokens\":443,\"ephemeral_1h_input_tokens\":0},\"output_tokens\":51,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":\"toolu_01JVfJF1EzgZaekjRcpXxggG\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\",\"uuid\":\"1b37e84b-a8ef-41dd-8255-8badf792d1d9\",\"request_id\":\"req_011CbwwTacYDFgDvcaDvVVem\",\"subagent_type\":\"Explore\",\"task_description\":\"Audit test-plan conformance\
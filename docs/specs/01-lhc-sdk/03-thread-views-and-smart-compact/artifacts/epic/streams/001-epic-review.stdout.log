{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016vchuYzHJzxwgFBzKUYZEk","type":"tool_result","content":"1\t// `lhc view *` (Epic 03 Story 5): the five thread-view commands per the\n2\t// pinned grammar (tech design §External Contracts). Every command calls the\n3\t// thread-view domain surface directly — the same operations the SDK's\n4\t// threadView namespace wraps — so CLI and SDK results are identical by\n5\t// construction (the parity legs in cli-process-view.test.ts prove it at the\n6\t// process boundary). No provider is required by any view operation; calling\n7\t// the surface directly (the cli/work.ts report/requeue pattern) keeps that\n8\t// structural: there is no provider to configure on this path at all, and\n9\t// view config falls back to the built-in defaults inside the surface.\n10\t//\n11\t// Output (AC-5.5): `view pull` emits the message array itself as JSON on\n12\t// stdout — the array IS the product crossing this boundary, not an OpResult\n13\t// envelope around it — and `view materialize` prints the written path.\n14\t// status/compact/sweep print the SDK result as JSON (Epic 01/02 convention).\n15\t// Exit 0 on success, 1 on failure; every failure is the structured OpResult\n16\t// error JSON regardless of command. `--json` is accepted per the pinned\n17\t// grammar; JSON is already the only output shape, so the flag changes\n18\t// nothing.\n19\timport { parseArgs } from \"node:util\";\n20\timport * as threadView from \"../domains/thread-view/index.js\";\n21\timport type { ThreadRef } from \"../domains/threads/index.js\";\n22\timport type { ViewCompactParams } from \"../shared/view.js\";\n23\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n24\t\n25\tinterface ViewFlags {\n26\t  threadId?: string;\n27\t  filePath?: string;\n28\t  registryPath?: string;\n29\t  json?: boolean;\n30\t  profile?: string;\n31\t  lowerBound?: string;\n32\t  full?: string;\n33\t  smooth?: string;\n34\t  detailed?: string;\n35\t  brief?: string;\n36\t  noSweep?: boolean;\n37\t  out?: string;\n38\t  format?: string;\n39\t}\n40\t\n41\ttype ParseResult = { ok: true; flags: ViewFlags } | { ok: false; unknownFlag: string };\n42\t\n43\t// Strict parse, mirroring cli/index.ts: an unknown or misspelled flag is\n44\t// named back to the caller, never silently dropped.\n45\tfunction parseViewFlags(args: readonly string[]): ParseResult {\n46\t  let values;\n47\t  try {\n48\t    ({ values } = parseArgs({\n49\t      args: [...args],\n50\t      options: {\n51\t        \"thread-id\": { type: \"string\" },\n52\t        \"file-path\": { type: \"string\" },\n53\t        registry: { type: \"string\" },\n54\t        json: { type: \"boolean\" },\n55\t        profile: { type: \"string\" },\n56\t        \"lower-bound\": { type: \"string\" },\n57\t        full: { type: \"string\" },\n58\t        smooth: { type: \"string\" },\n59\t        detailed: { type: \"string\" },\n60\t        brief: { type: \"string\" },\n61\t        \"no-sweep\": { type: \"boolean\" },\n62\t        out: { type: \"string\" },\n63\t        format: { type: \"string\" },\n64\t      },\n65\t      strict: true,\n66\t      allowPositionals: false,\n67\t    }));\n68\t  } catch (cause) {\n69\t    const message = cause instanceof Error ? cause.message : String(cause);\n70\t    const named = /'([^']+)'/.exec(message);\n71\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n72\t  }\n73\t  const flags: ViewFlags = {};\n74\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n75\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n76\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n77\t  if (values.json === true) flags.json = true;\n78\t  if (typeof values.profile === \"string\") flags.profile = values.profile;\n79\t  if (typeof values[\"lower-bound\"] === \"string\") flags.lowerBound = values[\"lower-bound\"];\n80\t  if (typeof values.full === \"string\") flags.full = values.full;\n81\t  if (typeof values.smooth === \"string\") flags.smooth = values.smooth;\n82\t  if (typeof values.detailed === \"string\") flags.detailed = values.detailed;\n83\t  if (typeof values.brief === \"string\") flags.brief = values.brief;\n84\t  if (values[\"no-sweep\"] === true) flags.noSweep = true;\n85\t  if (typeof values.out === \"string\") flags.out = values.out;\n86\t  if (typeof values.format === \"string\") flags.format = values.format;\n87\t  return { ok: true, flags };\n88\t}\n89\t\n90\tfunction threadRefFrom(flags: ViewFlags): ThreadRef {\n91\t  if (flags.threadId !== undefined) {\n92\t    return flags.registryPath !== undefined\n93\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n94\t      : { threadId: flags.threadId };\n95\t  }\n96\t  return { filePath: flags.filePath ?? \"\" };\n97\t}\n98\t\n99\t// Numeric band/bound flags must parse before they merge over the profile;\n100\t// what they MEAN (sum check, bound positivity) is the operation's own\n101\t// validation (AC-2.3) — the adapter refuses only non-numbers, naming the\n102\t// flag, the same altitude as the other adapters' usage errors.\n103\tfunction parseNumericFlag(\n104\t  raw: string,\n105\t  flag: string,\n106\t): { ok: true; value: number } | { ok: false; result: CliResult } {\n107\t  const value = Number(raw);\n108\t  if (!Number.isFinite(value)) {\n109\t    return {\n110\t      ok: false,\n111\t      result: renderCliError(\n112\t        \"caller_error\",\n113\t        \"missing_flag\",\n114\t        `${flag} must be a number, got ${raw}`,\n115\t      ),\n116\t    };\n117\t  }\n118\t  return { ok: true, value };\n119\t}\n120\t\n121\texport async function runViewCommand(\n122\t  command: string | undefined,\n123\t  args: readonly string[],\n124\t): Promise<CliResult> {\n125\t  const parsed = parseViewFlags(args);\n126\t  if (!parsed.ok) {\n127\t    return renderCliError(\n128\t      \"caller_error\",\n129\t      \"unknown_flag\",\n130\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n131\t    );\n132\t  }\n133\t  const flags = parsed.flags;\n134\t  const name = command === undefined ? \"view\" : `view ${command}`;\n135\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n136\t    return renderCliError(\n137\t      \"caller_error\",\n138\t      \"missing_flag\",\n139\t      `${name} requires --thread-id or --file-path`,\n140\t    );\n141\t  }\n142\t  const ref = threadRefFrom(flags);\n143\t\n144\t  switch (command) {\n145\t    case \"pull\": {\n146\t      const result = await threadView.pull(ref);\n147\t      if (!result.ok) return renderResult(result);\n148\t      // The story contract (AC-5.5/TC-5.4): the message array on stdout,\n149\t      // not the OpResult wrapper.\n150\t      return {\n151\t        exitCode: 0,\n152\t        stdout: `${JSON.stringify(result.value.messages, null, 2)}\\n`,\n153\t        stderr: \"\",\n154\t      };\n155\t    }\n156\t    case \"status\":\n157\t      return renderResult(await threadView.status(ref));\n158\t    case \"sweep\":\n159\t      return renderResult(await threadView.sweep(ref));\n160\t    case \"compact\": {\n161\t      const opts: Parameters<typeof threadView.compact>[1] = {};\n162\t      if (flags.profile !== undefined) opts.profile = flags.profile;\n163\t      if (flags.noSweep === true) opts.sweep = false;\n164\t      // Band flags override the profile field-wise BEFORE validation\n165\t      // (AC-2.2): `--full 40` over a 30/30/20/20 profile fails the sum check\n166\t      // with the named violation — correct behavior, not adapter business.\n167\t      const params: ViewCompactParams = {};\n168\t      const percentages: NonNullable<ViewCompactParams[\"percentages\"]> = {};\n169\t      const numeric: Array<[string | undefined, string, (n: number) => void]> = [\n170\t        [flags.lowerBound, \"--lower-bound\", (n) => (params.lowerBound = n)],\n171\t        [flags.full, \"--full\", (n) => (percentages.full = n)],\n172\t        [flags.smooth, \"--smooth\", (n) => (percentages.smooth = n)],\n173\t        [flags.detailed, \"--detailed\", (n) => (percentages.detailed = n)],\n174\t        [flags.brief, \"--brief\", (n) => (percentages.brief = n)],\n175\t      ];\n176\t      for (const [raw, flag, assign] of numeric) {\n177\t        if (raw === undefined) continue;\n178\t        const value = parseNumericFlag(raw, flag);\n179\t        if (!value.ok) return value.result;\n180\t        assign(value.value);\n181\t      }\n182\t      if (Object.keys(percentages).length > 0) params.percentages = percentages;\n183\t      if (Object.keys(params).length > 0) opts.params = params;\n184\t      return renderResult(await threadView.compact(ref, opts));\n185\t    }\n186\t    case \"materialize\": {\n187\t      if (flags.out === undefined) {\n188\t        return renderCliError(\n189\t          \"caller_error\",\n190\t          \"missing_flag\",\n191\t          \"view materialize requires --out <path>\",\n192\t        );\n193\t      }\n194\t      const opts: Parameters<typeof threadView.materialize>[1] = { path: flags.out };\n195\t      // Passed through as given: an unknown format is the operation's\n196\t      // caller_error naming the accepted values, identically to an SDK caller.\n197\t      if (flags.format !== undefined) {\n198\t        opts.format = flags.format as \"pi-session\";\n199\t      }\n200\t      const result = await threadView.materialize(ref, opts);\n201\t      if (!result.ok) return renderResult(result);\n202\t      // The story contract (AC-5.5/TC-5.4): print the written path itself.\n203\t      return { exitCode: 0, stdout: `${result.value.writtenPath}\\n`, stderr: \"\" };\n204\t    }\n205\t    default:\n206\t      return renderCliError(\n207\t        \"caller_error\",\n208\t        \"unknown_command\",\n209\t        `unknown command: ${name}; run lhc --help`,\n210\t      );\n211\t  }\n212\t}\n213\t"}]},"parent_tool_use_id":"toolu_
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018bRr68ESNGwpPiR4o3oid2","type":"tool_result","content":"312\tdescribe(\"architecture-risk: coverage edge accounting\", () => {\n313\t  it(\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\", async () => {\n314\t    const receipt = await fixture.sdk.threadView.compact(\n315\t      { filePath: fixture.filePath },\n316\t      { params: EDGE_PARAMS },\n317\t    );\n318\t    expect(receipt.ok).toBe(true);\n319\t    if (!receipt.ok) return;\n320\t\n321\t    // The compact point lands at t10's close, so c3, c2, and c1 are all\n322\t    // chunk candidates; c3 takes detailed (loner), the brief share holds c2\n323\t    // alone, and c1 remains AFTER the budget: outside the view. covered_from\n324\t    // lands at c2's start — t4's prompt, event 13 — and the exclusion is\n325\t    // visible as coveredFrom > first event.\n326\t    expect(receipt.value.compactPoint).toBe(56);\n327\t    expect(receipt.value.coveredFrom).toBe(13);\n328\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n329\t    expect(receipt.value.bands.brief.entries).toBe(1);\n330\t    // No silent omission AND no phantom gap entries for the out-of-window\n331\t    // chunk: gaps report unusable material, not the window's edge.\n332\t    expect(receipt.value.gaps).toEqual([]);\n333\t\n334\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n335\t    const bandText = bandMessages(messages)\n336\t      .map((message) => message.content)\n337\t      .join(\"\\n\");\n338\t    expect(bandText).not.toContain(\"§c1\");\n339\t    expect(bandText).toContain(\"§c2\");\n340\t    expect(bandText).toContain(\"§c3\");\n341\t  });\n342\t});\n343\t\n344\tdescribe(\"architecture-risk: restart serves the snapshot (real-file durability)\", () => {\n345\t  it(\"a fresh SDK on the same file pulls byte-identical band content\", async () => {\n346\t    const receipt = await fixture.sdk.threadView.compact(\n347\t      { filePath: fixture.filePath },\n348\t      { params: GRADIENT_PARAMS },\n349\t    );\n350\t    expect(receipt.ok).toBe(true);\n351\t    const before = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n352\t    expect(before.ok).toBe(true);\n353\t    if (!before.ok) return;\n354\t\n355\t    // Not a same-process reread: a fresh SDK instance opens the file cold.\n356\t    const fresh = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n357\t    const after = await fresh.threadView.pull({ filePath: fixture.filePath });\n358\t    expect(after.ok).toBe(true);\n359\t    if (!after.ok) return;\n360\t    expect(JSON.stringify(after.value)).toBe(JSON.stringify(before.value));\n361\t  });\n362\t});\n363\t\n364\tdescribe(\"TC-2.4 (AC-2.6): crash injection at the compact-write point\", () => {\n365\t  it(\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\", async () => {\n366\t    const first = await fixture.sdk.threadView.compact(\n367\t      { filePath: fixture.filePath },\n368\t      { params: GRADIENT_PARAMS },\n369\t    );\n370\t    expect(first.ok).toBe(true);\n371\t    const priorPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });"}]},"parent_tool_use_id":"toolu_01JVfJF1EzgZaekjRcpXxggG","session_id":"8f35b3b6-f7a4-4d02-a9f9-b9315f787309","uuid":"95585411-8f38-4c5f-9c31-7d6f51c374bd","timestamp":"2026-06-11T18:24:04.353Z","subagent_type":"Explore","task_description":"Audit test-plan conformance"}

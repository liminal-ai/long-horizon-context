{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XMsgbRkRSH5ngdgfkcvk4w","type":"tool_result","content":"380\tdescribe(\"TC-4.6 (AC-4.9): a failed advance leaves intake intact and the condition visible; the next batch heals — and the poke still fires\", () => {\n381\t  it(\"background mode: intake succeeds, boundary holds, status shows over-max, the drain still ran; cleared, the next batch lands at target\", async () => {\n382\t    const sdk = visSdk({ visibility: BUDGETS }, \"background\");\n383\t    const filePath = await newThread(sdk);\n384\t\n385\t    // The Story-0 facility's named post-commit point — not a mock of\n386\t    // boundary.ts: an installed throw stands in for an advance failure.\n387\t    let fired = 0;\n388\t    setViewInjectionHook(\"post-commit-advance\", () => {\n389\t      fired += 1;\n390\t      throw new Error(\"injected advance failure\");\n391\t    });\n392\t\n393\t    // One crossing batch: zone 120 > max 100.\n394\t    const result = await sdk.intakeStream.messageEvents({ filePath }, toolTurn([40, 40, 40]));\n395\t    expect(result.ok).toBe(true); // intake's outcome never depends on the advance\n396\t    if (!result.ok) return;\n397\t    expect(result.value.events.every((e) => e.outcome === \"recorded\")).toBe(true);\n398\t    expect(fired).toBe(1);\n399\t\n400\t    // All messages committed; boundary unchanged; the over-budget condition\n401\t    // is visible in status — computed live, the same sum the advance reads.\n402\t    const results = await toolResults(sdk, filePath);\n403\t    expect(results).toHaveLength(3);\n404\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n405\t    const status = await sdk.threadView.status({ filePath });\n406\t    expect(status.ok).toBe(true);\n407\t    if (!status.ok) return;\n408\t    expect(status.value.visibility.zoneTokens).toBe(120);\n409\t    expect(status.value.visibility.zoneTokens).toBeGreaterThan(status.value.visibility.maxTokens);\n410\t\n411\t    // Seam isolation, direction one: the throwing advance never ate the queue\n412\t    // poke — the background drain ran and the summaries landed ready.\n413\t    await sdk.drainSettled({ filePath });\n414\t    const listed = await sdk.messages.listMessages({ filePath });\n415\t    expect(listed.ok).toBe(true);\n416\t    if (!listed.ok) return;\n417\t    for (const m of listed.value.filter((msg) => msg.kind === \"tool_result\")) {\n418\t      expect(m.forms?.find((f) => f.form === \"tool_result_summary\")?.state).toBe(\"ready\");\n419\t    }\n420\t\n421\t    // Clear the injection; the next batch re-evaluates and lands at target:\n422\t    // zone 130 → flip the two oldest (130→90→50 ≤ 60), stop before the\n423\t    // protected set (r3+r4 joined to 50 ≥ floor 30).\n424\t    setViewInjectionHook(\"post-commit-advance\", null);\n425\t    await intake(sdk, filePath, toolTurn([10]));\n426\t    const all = await toolResults(sdk, filePath);\n427\t    expect(await boundaryOf(sdk, filePath)).toBe(all[1]?.sourceEventOrder);\n428\t    const healed = await sdk.threadView.status({ filePath });\n429\t    expect(healed.ok).toBe(true);\n430\t    if (!healed.ok) return;\n431\t    expect(healed.value.visibility.zoneTokens).toBe(50);\n432\t  });\n433\t});\n434\t\n435\tdescribe(\"seam isolation, direction two (architecture-risk): a failing poke never blocks the advance\", () => {\n436\t  it(\"advances through a direct domain call (default budgets) even when the fallback poke throws\", async () => {\n437\t    // Thread built through a manual SDK; the intake under test is a DIRECT\n438\t    // domain call with no SDK seam in scope, so budgets fall back to the\n439\t    // built-in defaults (32000/24000/8000) and the poke falls back to the"}]},"parent_tool_use_id":"toolu_01JVfJF1EzgZaekjRcpXxggG","session_id":"8f35b3b6-f7a4-4d02-a9f9-b9315f787309","uuid":"8eecd0cb-4e44-4d14-9789-1cbcf6cec762","timestamp":"2026-06-11T18:24:07.392Z","subagent_type":"Explore","task_description":"Audit test-plan conf
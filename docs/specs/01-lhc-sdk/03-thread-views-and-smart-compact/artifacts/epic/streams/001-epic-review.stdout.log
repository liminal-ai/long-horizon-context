{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FK3QxyCDC54MUWR9qGqaD6","type":"tool_result","content":"1\t// PI session JSONL writer (Story 5, Flow 5): the pure mapping from pull's\n2\t// assembled entries to the pinned PI session file format, plus the file\n3\t// write. This module never sees a database handle — it renders what the\n4\t// surface's pull assembly hands it, which is what makes AC-5.3's\n5\t// materialize↔pull parity structural rather than tested-into-existence\n6\t// (must-not-own: materialize never reads the record).\n7\t//\n8\t// Format pin (tech design §External Contracts, from\n9\t// repo-ref/pi/packages/coding-agent/src/core/session-manager.ts): JSONL;\n10\t// line 1 is the header `{ type: \"session\", version, id, timestamp, cwd }`;\n11\t// each subsequent line is `{ type: \"message\", id, parentId, timestamp,\n12\t// message: { role, content } }` with parentId chaining each entry to the\n13\t// previous (first entry's parentId null). Content is encoded as PI text\n14\t// blocks: user content may be a bare string in PI, but assistant content\n15\t// must be a block array, so both roles use the one block encoding.\n16\timport { writeFileSync } from \"node:fs\";\n17\timport { resolve } from \"node:path\";\n18\timport type { ViewMessage } from \"../../../shared/view.js\";\n19\t\n20\t// CURRENT_SESSION_VERSION at the pin (PI coding agent 0.79.1) — see\n21\t// test/fixtures/pi-session-structure.provenance.md.\n22\texport const PI_SESSION_VERSION = 3;\n23\t\n24\t// One pull entry with the metadata the file's generated fields derive from:\n25\t// the entry id (message id for tail entries, viewId-band for band entries)\n26\t// and the record-time timestamp (event recorded_at for tail entries, view\n27\t// created-at for band entries). Never a write-time clock anywhere (AC-5.2 —\n28\t// byte-identical repeats are the test for any sneaky Date.now()).\n29\texport interface MaterializeEntry {\n30\t  message: ViewMessage;\n31\t  entryId: string;\n32\t  timestamp: string;\n33\t}\n34\t\n35\texport interface MaterializeInput {\n36\t  threadId: string;\n37\t  // The view's created-at, or the thread's created-at when never compacted\n38\t  // (viewId null — AC-5.4's tail-only file still carries a valid header).\n39\t  headerTimestamp: string;\n40\t  cwd: string;\n41\t  entries: readonly MaterializeEntry[];\n42\t}\n43\t\n44\texport function renderPiSessionLines(input: MaterializeInput): string[] {\n45\t  const lines: string[] = [\n46\t    JSON.stringify({\n47\t      type: \"session\",\n48\t      version: PI_SESSION_VERSION,\n49\t      id: `${input.threadId}:${input.headerTimestamp}`,\n50\t      timestamp: input.headerTimestamp,\n51\t      cwd: input.cwd,\n52\t    }),\n53\t  ];\n54\t  let parentId: string | null = null;\n55\t  for (const entry of input.entries) {\n56\t    lines.push(\n57\t      JSON.stringify({\n58\t        type: \"message\",\n59\t        id: entry.entryId,\n60\t        parentId,\n61\t        timestamp: entry.timestamp,\n62\t        message: {\n63\t          role: entry.message.role,\n64\t          content: [{ type: \"text\", text: entry.message.content }],\n65\t        },\n66\t      }),\n67\t    );\n68\t    parentId = entry.entryId;\n69\t  }\n70\t  return lines;\n71\t}\n72\t\n73\texport function writePiSessionFile(\n74\t  input: MaterializeInput,\n75\t  path: string,\n76\t): { writtenPath: string } {\n77\t  const writtenPath = resolve(path);\n78\t  writeFileSync(writtenPath, `${renderPiSessionLines(input).join(\"\\n\")}\\n`);\n79\t  return { writtenPath };\n80\t}\n81\t"}]},"parent_tool_use_id":null,"session_id":"8f35b3b6-f7a4-4d02-a9f9-b9315f787309","uuid":"aff848c4-1e67-4b33-b74f-c2713c285318","timestamp":"2026-06-11T18:21:53.175Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/materialize.ts","content":"// PI session JSONL writer (Story 5, Flow 5): the pure mapping from pull's\n// assembled entries to the pinned PI session file format, plus the file\n// write. This module never sees a database handle — it renders what the\n// surface's pull assembly hands it, which is what makes AC-5.3's\n// materialize↔pull parity structural rather than tested-into-existence\n// (must-not-own: materialize never reads the record).\n//\n// Format pin (tech design §External Contracts, from\n// repo-ref/pi/packages/coding-agent/src/core/session-manager.ts): JSONL;\n// line 1 is the header `{ type: \"session\", version, id, timestamp, cwd }`;\n// each subsequent line is `{ type: \"message\", id, parentId, timestamp,\n// message: { role, content } }` with parentId chaining each entry to the\n// previous (first entry's parentId null). Content is encoded as PI text\n// blocks: user content may be a bare string in PI, but assistant content\n// must be a block array, so both roles use the one block encoding.\nimport { writeFileSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\nimport type { ViewMessage } from \"../../../shared/view.js\";\n\n// CURRENT_SESSION_VERSION at the pin (PI coding agent 0.79.1) — see\n// test/fixtures/pi-session-structure.provenance.md.\nexport const PI_SESSION_VERSION = 3;\n\n// One pull entry with the metadata the file's generated fields derive from:\n// the entry id (message id for tail entries, viewId-band for band entries)\n// and the record-time timestamp (event recorded_at for tail entries, view\n// created-at for band entries). Never a write-time clock anywhere (AC-5.2 —\n// byte-identical repeats are the test for any sneaky Date.now()).\nexport interface MaterializeEntry {\n  message: ViewMessage;\n  entryId: string;\n  timestamp: string;\n}\n\nexport interface MaterializeInput {\n  threadId: string;\n  // The view's created-at, or the thread's created-at when never compacted\n  // (viewId null — AC-5.4's tail-only file still carries a valid header).\n  headerTimestamp: string;\n  cwd: string;\n  entries: readonly MaterializeEntry[];\n}\n\nexport function renderPiSessionLines(input: MaterializeInput): string[] {\n  const lines: string[] = [\n    JSON.stringify({\n      type: \"session\",\n      version: PI_SESSION_VERSION,\n      id: `${input.threadId}:${input.headerTimestamp}`,\n      timestamp: input.headerTimestamp,\n      cwd: input.cwd,\n    }),\n  ];\n  let parentId: string | null = null;\n  for (const entry of input.entries) {\n    lines.push(\n      JSON.stringify({\n        type: \"message\",\n        id: entry.entryId,\n        parentId,\n        timestamp: entry.timestamp,\n        message: {\n          role: entry.message.role,\n          content: [{ type: \"text\", text: entry.message.content }],\n        },\n      }),\n    );\n    parentId = entry.entryId;\n  }\n  return lines;\n}\n\nexport function writePiSessionFile(\n  input: MaterializeInput,\n  path: string,\n): { writtenPath: string } {\n  const writtenPath = resolve(path);\n  writeFileSync(writtenPath, `${renderPiSessionLines(input).join(\"\\n\")}\\n`);\n  return { writtenPath };\n}\n","numLines":81,"startLine":1,"totalLines":81}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Po2anodyPvhcrGB6ybyb4A","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Zero-dependency import-boundary check.\n3\t// Rules:\n4\t//   1. No file may import another domain's internal/ modules.\n5\t//   2. tech-utils/ and shared/ may not import from domains/.\n6\t//   3. A domain may import another domain's surface (index.ts) only along an\n7\t//      edge pinned in ALLOWED_SURFACE_IMPORTS below — a new cross-domain\n8\t//      edge is a conscious decision, never a silent pass.\n9\t// The test fixtures directory (test/fixtures/) is exempt by design — it is\n10\t// the one sanctioned below-SDK writer.\n11\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n12\timport path from \"node:path\";\n13\timport { fileURLToPath } from \"node:url\";\n14\t\n15\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n16\tconst srcRoot = path.join(pkgRoot, \"src\");\n17\tconst testRoot = path.join(pkgRoot, \"test\");\n18\tconst fixturesRoot = path.join(testRoot, \"fixtures\");\n19\t\n20\tfunction collectTsFiles(dir, out = []) {\n21\t  let entries;\n22\t  try {\n23\t    entries = readdirSync(dir);\n24\t  } catch {\n25\t    return out;\n26\t  }\n27\t  for (const entry of entries) {\n28\t    const full = path.join(dir, entry);\n29\t    if (full === fixturesRoot) continue; // fixtures exempt\n30\t    if (statSync(full).isDirectory()) {\n31\t      collectTsFiles(full, out);\n32\t    } else if (full.endsWith(\".ts\")) {\n33\t      out.push(full);\n34\t    }\n35\t  }\n36\t  return out;\n37\t}\n38\t\n39\tfunction importSpecifiers(source) {\n40\t  const specs = [];\n41\t  const patterns = [\n42\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n43\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n44\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n45\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n46\t  ];\n47\t  for (const re of patterns) {\n48\t    let m;\n49\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n50\t  }\n51\t  return specs;\n52\t}\n53\t\n54\tfunction domainOf(filePath) {\n55\t  const rel = path.relative(srcRoot, filePath);\n56\t  const parts = rel.split(path.sep);\n57\t  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n58\t  return null;\n59\t}\n60\t\n61\t// The pinned domain-surface dependency edges (rule 3). Epic 03 adds two:\n62\t// thread-view consumes the messages/turns report surfaces and the threads\n63\t// resolver; intake-stream gains the thread-view surface for the boundary\n64\t// advance registration (Flow 4).\n65\t// SANCTIONED CYCLE (Epic 03 tech design §Module Boundaries): intake-stream →\n66\t// thread-view → messages/turns → intake-stream (the last edges are type-only\n67\t// event vocabulary). The domain graph is therefore deliberately not a DAG —\n68\t// runtime-safe because the advance is registration-then-flush with no\n69\t// import-time execution — so this check pins the allowed edge set instead of\n70\t// asserting acyclicity.\n71\tconst ALLOWED_SURFACE_IMPORTS = {\n72\t  \"intake-stream\": new Set([\"threads\", \"messages\", \"turns\", \"thread-view\"]),\n73\t  messages: new Set([\"threads\", \"intake-stream\"]),\n74\t  turns: new Set([\"threads\", \"intake-stream\", \"messages\"]),\n75\t  \"thread-view\": new Set([\"threads\", \"messages\", \"turns\"]),\n76\t  threads: new Set(),\n77\t};\n78\t\n79\tconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\n80\tconst violations = [];\n81\t\n82\tfor (const file of files) {\n83\t  const source = readFileSync(file, \"utf8\");\n84\t  const fileDomain = domainOf(file);\n85\t  const inTechUtilsOrShared =\n86\t    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n87\t    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n88\t\n89\t  for (const spec of importSpecifiers(source)) {\n90\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n91\t    const resolved = path.resolve(path.dirname(file), spec);\n92\t    const relToSrc = path.relative(srcRoot, resolved);\n93\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n94\t    const parts = relToSrc.split(path.sep);\n95\t\n96\t    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n97\t      const targetDomain = parts[1];\n98\t      if (fileDomain !== targetDomain) {\n99\t        violations.push(\n100\t          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n101\t        );\n102\t      }\n103\t    }\n104\t    if (\n105\t      parts[0] === \"domains\" &&\n106\t      !parts.includes(\"internal\") &&\n107\t      fileDomain !== null &&\n108\t      parts[1] !== fileDomain\n109\t    ) {\n110\t      const targetDomain = parts[1];\n111\t      const allowed = ALLOWED_SURFACE_IMPORTS[fileDomain];\n112\t      if (allowed === undefined || !allowed.has(targetDomain)) {\n113\t        violations.push(\n114\t          `${path.relative(pkgRoot, file)} imports ${spec} — domain \"${fileDomain}\" has no pinned surface edge to \"${targetDomain}\" (rule 3)`,\n115\t        );\n116\t      }\n117\t    }\n118\t    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n119\t      violations.push(\n120\t        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n121\t      );\n122\t    }\n123\t  }\n124\t}\n125\t\n126\tif (violations.length > 0) {\n127\t  console.error(\"boundary check FAILED:\");\n128\t  for (const v of violations) console.error(`  - ${v}`);\n129\t  process.exit(1);\n130\t}\n131\tconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n132\t"}]},"parent_tool_use_id":"toolu_01G1xRJXcsNXpLPr4Ci3qXFE","session_id":"8f35b3b6-f7a4-4d02-a9f9-b9315f787309","uuid":"41bee688-d056-4a58-9e3e-b3b1a1943640","timestamp":"2026-06-11T18:24:03.213Z","subagent_type":"Explore","task_description":"Production-path and boundary audit"}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LoJgQUwtfv8M8fS6LWmhQ5","type":"tool_result","content":"1\t// PI session format conformance (TC-5.3/TC-5.5): the required shapes are\n2\t// DERIVED from the structure-trimmed real PI session fixture at runtime,\n3\t// never restated from the design — the fixture's job is to catch the design\n4\t// being wrong about PI, which a design-derived checker could not\n5\t// (provenance: pi-session-structure.provenance.md). Checks are\n6\t// structure-level: header line shape, entry shape, parentId chain, message\n7\t// encoding.\n8\timport { readFileSync } from \"node:fs\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\t\n12\tconst fixturePath = path.join(\n13\t  path.dirname(fileURLToPath(import.meta.url)),\n14\t  \"pi-session-structure.jsonl\",\n15\t);\n16\t\n17\tinterface ParsedSession {\n18\t  header: Record<string, unknown>;\n19\t  entries: Array<Record<string, unknown>>;\n20\t}\n21\t\n22\tfunction parseJsonl(text: string, label: string): ParsedSession {\n23\t  const lines = text.split(\"\\n\").filter((line) => line !== \"\");\n24\t  if (lines.length === 0) throw new Error(`${label}: empty file`);\n25\t  const parsed = lines.map((line, i) => {\n26\t    const value = JSON.parse(line) as unknown;\n27\t    if (typeof value !== \"object\" || value === null || Array.isArray(value)) {\n28\t      throw new Error(`${label} line ${i + 1}: not a JSON object`);\n29\t    }\n30\t    return value as Record<string, unknown>;\n31\t  });\n32\t  const [header, ...entries] = parsed;\n33\t  if (header === undefined) throw new Error(`${label}: no header line`);\n34\t  return { header, entries };\n35\t}\n36\t\n37\texport function loadPiSessionFixture(): ParsedSession {\n38\t  return parseJsonl(readFileSync(fixturePath, \"utf8\"), \"pi-session-structure fixture\");\n39\t}\n40\t\n41\tfunction keySet(value: Record<string, unknown>): string {\n42\t  return [...Object.keys(value)].sort().join(\",\");\n43\t}\n44\t\n45\tfunction fail(where: string, expected: string, actual: unknown): never {\n46\t  throw new Error(\n47\t    `pi-session conformance violation at ${where}: expected ${expected}, got ${JSON.stringify(actual)}`,\n48\t  );\n49\t}\n50\t\n51\t// Validates a materialized file's structure against the real-PI fixture:\n52\t//  - header: same key set as the fixture's header, same value types,\n53\t//    type === \"session\"\n54\t//  - every entry: type === \"message\" with exactly the key set the fixture's\n55\t//    message entries carry ({type, id, parentId, timestamp, message})\n56\t//  - parentId chain: first entry null, every later entry chained to the\n57\t//    previous entry's id; ids unique\n58\t//  - message encoding: role + content present; content an array of text\n59\t//    blocks shaped like the fixture's ({type: \"text\", text: string})\n60\texport function assertPiSessionConformance(materializedText: string): void {\n61\t  const fixture = loadPiSessionFixture();\n62\t  const file = parseJsonl(materializedText, \"materialized session\");\n63\t\n64\t  // Header shape derived from the fixture header.\n65\t  if (file.header[\"type\"] !== \"session\") fail(\"header.type\", '\"session\"', file.header[\"type\"]);\n66\t  if (keySet(file.header) !== keySet(fixture.header)) {\n67\t    fail(\"header keys\", keySet(fixture.header), keySet(file.header));\n68\t  }\n69\t  for (const [key, fixtureValue] of Object.entries(fixture.header)) {\n70\t    if (typeof file.header[key] !== typeof fixtureValue) {\n71\t      fail(`header.${key} type`, typeof fixtureValue, file.header[key]);\n72\t    }\n73\t  }\n74\t\n75\t  // Entry shape derived from the fixture's message entries.\n76\t  const fixtureMessages = fixture.entries.filter((entry) => entry[\"type\"] === \"message\");\n77\t  const referenceEntry = fixtureMessages[0];\n78\t  if (referenceEntry === undefined) {\n79\t    throw new Error(\"pi-session-structure fixture carries no message entries\");\n80\t  }\n81\t  const referenceMessage = referenceEntry[\"message\"] as Record<string, unknown>;\n82\t  const referenceBlocks = referenceMessage[\"content\"];\n83\t  if (!Array.isArray(referenceBlocks) || referenceBlocks.length === 0) {\n84\t    throw new Error(\"pi-session-structure fixture message has no content blocks\");\n85\t  }\n86\t  const referenceTextBlock = (referenceBlocks as Array<Record<string, unknown>>).find(\n87\t    (block) => block[\"type\"] === \"text\",\n88\t  );\n89\t  if (referenceTextBlock === undefined) {\n90\t    throw new Error(\"pi-session-structure fixture message has no text block\");\n91\t  }\n92\t\n93\t  const seenIds = new Set<string>();\n94\t  let previousId: string | null = null;\n95\t  file.entries.forEach((entry, i) => {\n96\t    const where = `entry[${i}]`;\n97\t    if (entry[\"type\"] !== \"message\") fail(`${where}.type`, '\"message\"', entry[\"type\"]);\n98\t    if (keySet(entry) !== keySet(referenceEntry)) {\n99\t      fail(`${where} keys`, keySet(referenceEntry), keySet(entry));\n100\t    }"}]},"parent_tool_use_id":"toolu_01JVfJF1EzgZaekjRcpXxggG","session_id":"8f35b3b6-f7a4-4d02-a9f9-b9315f787309","uuid":"58dacc1f-dcfb-4282-bef9-f53ce25cd4a6","timestamp":"2026-06-11T18:23:38.245Z","subagent_type":"Explore","task_description":"Audit test-plan conformance"}

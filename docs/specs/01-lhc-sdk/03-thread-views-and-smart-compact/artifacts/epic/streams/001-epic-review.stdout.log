s: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  // ... validation throws on errors ...\n```\n\n**InstanceSeam carries view config** (lines 341-348):\n\n```typescript\nconst seam: InstanceSeam =\n  resolved.mode === \"background\"\n    ? {\n        poke: (threadId) => scheduler.poke(threadId),\n        touch: (filePath, db) => scheduler.touch(filePath, db),\n        view: resolved.view,  // Instance's view config rides the seam\n      }\n    : { poke: () => {}, touch: () => {}, view: resolved.view };\n```\n\n**ThreadViewSurface scoped to seam** (lines 375-384):\n\n```typescript\nthreadView: scopeSurface<ThreadViewSurface>(\n  {\n    pull: threadViewDomain.pull,\n    status: threadViewDomain.status,\n    compact: threadViewDomain.compact,\n    sweep: threadViewDomain.sweep,\n    materialize: threadViewDomain.materialize,\n  },\n  seam,\n),\n```\n\n**Confirmation:**\n- Exact five operations, no boundary-advance surface exposure.\n- SdkViewConfig validated at construction with throws via `resolveViewConfig()` (lines 148-173 in profiles.ts).\n- View config carried on per-instance seam via `scopeSurface()` wrapper (lines 258-269).\n- All operations run inside `runWithInstanceSeam(seam, ...)` scope.\n\n---\n\n### Audit 7: CLI view.ts\n\n**Finding: ALL FIVE COMMANDS PRESENT, DIRECT DOMAIN CALLS**\n\n**Grammar compliance** (lines 145-204):\n- ✓ `view pull` — JSON array on stdout (line 152).\n- ✓ `view status` — OpResult JSON (line 157).\n- ✓ `view sweep` — OpResult JSON (line 159).\n- ✓ `view compact --profile/--lower-bound/--full/--smooth/--detailed/--brief/--no-sweep` (lines 160-184). All flags parsed and merged (lines 162-183). `--no-sweep` sets `opts.sweep = false` (line 163). Numeric flags validated (lines 103-119).\n- ✓ `view materialize --out --format` (lines 186-203). Path required (line 187-192), format passed through (lines 197-199).\n\n**Direct domain calls** (line 20):\n```typescript\nimport * as threadView from \"../domains/thread-view/index.js\";\n```\n\nLines 146, 157, 159, 184, 200: All calls are `threadView.<operation>(ref, opts)`, not SDK construction. No `createSdk`, no provider wiring.\n\n**Config fallback** (lines 6-9):\n```\n// No provider is required by any view operation; calling\n// the surface directly (the cli/work.ts report/requeue pattern) keeps that\n// structural: there is no provider to configure on this path at all, and\n// view config falls back to the built-in defaults inside the surface.\n```\n\nThread-view surface defaults to `DEFAULT_VIEW_CONFIG` when no SDK seam is active (thread-view/index.ts lines 71-74).\n\n**Confirmation:** All five commands match grammar. Direct domain calls, no SDK/config wiring. Built-in defaults apply.\n\n---\n\n### Audit 8: Provider Calls, Inference, or Polling in thread-view/**\n\n**Finding: ZERO PROVIDER CALLS, ZERO INFERENCE, ZERO POLLING**\n\n**Search results:**\n- No `provider[` indexing, no `config.provider`, no provider invocations anywhere in `/src/domains/thread-view/`.\n- No `setTimeout`, `sleep`, `drainSettled`, or polling loops.\n- Only `await` calls are to:\n  - `resolveThreadRef()` (resolving file path, not async work).\n  - `messagesDomain.report()` and `turnsDomain.report()` (reading forms state, not inference).\n  - `runSweep()` (requeuing through work-queue owners, not provider).\n\n**Anti-pattern check**: `/src/domains/thread-view/internal/sweep.ts` line explicitly states:\n```\n// No derivation, no provider calls, and no waiting: a requeue returns when\n// queued by the work queue's atomic enqueue, never blocking on the work\n// itself or drainSettled/polling in this module is a contract violation (anti-shim;\n```\n\n**Confirmation:** Thread-view is pure reads and deterministic assembly. No provider, no inference, no blocking. All async calls are structural (file IO, DB reads, intra-domain work registration).\n\n---\n\n## Summary\n\n✓ **Audit 1:** No unfinished production behavior.\n✓ **Audit 2:** Deterministic provider is test-only selectable, never a silent default.\n✓ **Audit 3:** Seam injection hooks isolated to test fixtures, same pattern as intake-seam.\n✓ **Audit 4:** Domain cycle (intake→thread-view→messages←intake) explicitly sanctioned with runtime-safety justification.\n✓ **Audit 5:** Migration v6 schema matches tech-design spec byte-for-byte.\n✓ **Audit 6:** SDK exposes exactly five operations, no boundary-advance. View config validated at construction, carried on per-instance seam.\n✓ **Audit 7:** CLI commands match grammar. Direct domain calls, built-in defaults apply.\n✓ **Audit 8:** Thread-view is pure reads and deterministic assembly—no provider, inference, or polling.\n\n**Overall:** Production path is clean. Epic 03 thread-view architecture is correctly isolated and validated at construction."}],"totalDurationMs":128157,"totalTokens":46907,"totalToolUseCount":40,"usage":{"input_tokens":0,"cache_creation_input_tokens":603,"cache_read_input_tokens":42656,"output_tokens":3648,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":603},"inference_geo":"not_available","iterations":[{"input_tokens":0,"output_tokens":3648,"cache_read_input_tokens":42656,"cache_creation_input_tokens":603,"cache_creation":{"ephemeral_5m_input_tokens":603,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"toolStats":{"readCount":13,"searchCount":0,"bashCount":27,"editFileCount":0,"linesAdded":0,"linesRemoved":0,"otherToolCount":0}}}

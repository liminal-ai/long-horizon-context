16\\timport { spawnSync } from \\\"node:child_process\\\";\\n17\\timport { readFileSync } from \\\"node:fs\\\";\\n18\\timport path from \\\"node:path\\\";\\n19\\timport { fileURLToPath } from \\\"node:url\\\";\\n20\\timport { afterAll, beforeAll, describe, expect, it } from \\\"vitest\\\";\\n21\\timport {\\n22\\t  createSdk,\\n23\\t  estimateTokens,\\n24\\t  type CompactReceipt,\\n25\\t  type Lhc,\\n26\\t  type OpResult,\\n27\\t  type SweepReceipt,\\n28\\t  type ViewMessage,\\n29\\t  type ViewStatus,\\n30\\t} from \\\"../src/index.js\\\";\\n31\\timport {\\n32\\t  assertPiSessionConformance,\\n33\\t  assertSweepReceiptShape,\\n34\\t  createProviderDouble,\\n35\\t  derivedThreadFixture,\\n36\\t  tempStore,\\n37\\t  type DerivedThreadFixture,\\n38\\t  type TempStore,\\n39\\t} from \\\"./fixtures/index.js\\\";\\n40\\t\\n41\\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \\\"..\\\");\\n42\\tconst cliPath = path.join(pkgRoot, \\\"dist\\\", \\\"cli.js\\\");\\n43\\t\\n44\\t// Every spawn runs with LHC_PROVIDER stripped: the zero-provider rule on the\\n45\\t// CLI paths is enforced by the environment, not by discipline.\\n46\\tfunction runBinary(\\n47\\t  args: string[],\\n48\\t  input?: string,\\n49\\t): { status: number | null; stdout: string; stderr: string } {\\n50\\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\\n51\\t    encoding: \\\"utf8\\\",\\n52\\t    env: { ...process.env, LHC_PROVIDER: undefined },\\n53\\t    ...(input !== undefined ? { input } : {}),\\n54\\t  });\\n55\\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\\n56\\t}\\n57\\t\\n58\\tfunction parseResult<T>(stdout: string): OpResult<T> {\\n59\\t  return JSON.parse(stdout) as OpResult<T>;\\n60\\t}\"}]},\"parent_tool_use_id\":\"toolu_01JVfJF1EzgZaekjRcpXxggG\",\"session_id\":\"8f35b3b6-f7a4-4d02-a9f9-b9315f787309\",\"uuid\":\"858c9845-4be5-4a9d-b6ce-76ffbed1578d\",\"timestamp\":\"2026-06-11T18:23:44.092Z\",\"subagent_type\":
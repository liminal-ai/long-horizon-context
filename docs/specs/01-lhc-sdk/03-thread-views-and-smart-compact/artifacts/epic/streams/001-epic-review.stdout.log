{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GoiqXqA1Z9wUQtFnJNjN7y","type":"tool_result","content":"1\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n2\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n3\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n4\t// deterministic provider double into known form states. States are reached\n5\t// through production paths, never hand-written rows (the anti-shim line\n6\t// FC-0.3 enforces): the failed states come from scripted provider failures\n7\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\n8\t// real source damage on a sacrificial sibling thread. Every later Epic 03\n9\t// story compacts against what this builder returns.\n10\timport {\n11\t  createSdk,\n12\t  type FormReportEntry,\n13\t  type Lhc,\n14\t  type MessageEventInput,\n15\t} from \"../../src/index.js\";\n16\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n17\timport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\n18\timport { readChunks, type ChunkSnapshot } from \"./threads.js\";\n19\timport { validEvent, type TempStore } from \"./index.js\";\n20\t\n21\t// Reason classes the scripted failures stamp, chosen from the sweep\n22\t// classification table's vocabulary (tech design §Spec Validation): a\n23\t// rate-limit class reads transient, a content-refusal class reads permanent —\n24\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n25\t// Story 3 depends on it.\n26\texport const TRANSIENT_EXHAUST_REASON =\n27\t  \"rate_limit: scripted transient exhaustion (fixture)\";\n28\texport const PERMANENT_FAILURE_REASON =\n29\t  \"content_refusal: scripted permanent failure (fixture)\";\n30\t\n31\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n32\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\n33\t// deterministic double are near-constant in size (`projection(<digest>:<40\n34\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\n35\t// if drift ever moves it.\n36\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n37\t\n38\tconst TURN_COUNT = 12;\n39\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n40\t\n41\tfunction turnEvents(turn: number): MessageEventInput[] {\n42\t  const events: MessageEventInput[] = [\n43\t    validEvent(\"user_prompt\", {\n44\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n45\t    }),\n46\t    validEvent(\"assistant_thinking\", {\n47\t      payload: { text: `considering what area ${turn} contains` },\n48\t    }),\n49\t  ];\n50\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n51\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n52\t    // realistic over-max zone of tool results to age behind the boundary.\n53\t    for (const run of [1, 2]) {\n54\t      const toolCallId = `call-fx-${turn}-${run}`;\n55\t      events.push(\n56\t        validEvent(\"tool_call\", {\n57\t          payload: {\n58\t            toolCallId,\n59\t            toolName: \"read_file\",\n60\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n61\t          },\n62\t        }),\n63\t        validEvent(\"tool_result\", {\n64\t          payload: {\n65\t            toolCallId,\n66\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n67\t            isError: false,\n68\t          },\n69\t        }),\n70\t      );\n71\t    }\n72\t  }\n73\t  events.push(\n74\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n75\t    validEvent(\"turn_end\"),\n76\t  );\n77\t  return events;\n78\t}\n79\t\n80\texport interface DerivedThreadFixture {\n81\t  filePath: string;\n82\t  sdk: Lhc;\n83\t  double: ProviderDouble;\n84\t  turnIds: string[]; // t1..t12\n85\t  chunks: ChunkSnapshot;\n86\t  // The two manufactured failed subjects (tool_result_summary forms), reached\n87\t  // through real retry exhaustion / terminal failure — absent when failures\n88\t  // are disabled for a variant.\n89\t  failedTransientMessageId?: string;\n90\t  failedPermanentMessageId?: string;\n91\t  // The straggler variant's turnId-null messages: one between two turns, one\n92\t  // after the last turn — absent unless stragglers are enabled.\n93\t  stragglerBetweenMessageId?: string;\n94\t  stragglerTrailingMessageId?: string;\n95\t}\n96\t\n97\texport interface DerivedThreadOptions {\n98\t  failures?: boolean; // default true: manufacture the two failed states\n99\t  stragglers?: boolean; // default false: insert the turnless runtime notes\n100\t}\n101\t\n102\tasync function send(\n103\t  sdk: Lhc,\n104\t  filePath: string,\n105\t  batch: readonly MessageEventInput[],\n106\t): Promise<string[]> {\n107\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n108\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n109\t  return result.value.events.map((entry) => entry.messageId ?? \"\");\n110\t}\n111\t\n112\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n113\t  const report = await sdk.work.drain({ filePath });\n114\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n115\t  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n116\t    throw new Error(\n117\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n118\t    );\n119\t  }\n120\t}\n121\t\n122\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n123\t  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n124\t}\n125\t\n126\texport async function derivedThreadFixture(\n127\t  store: TempStore,\n128\t  opts: DerivedThreadOptions = {},\n129\t): Promise<DerivedThreadFixture> {\n130\t  const failures = opts.failures ?? true;\n131\t  const stragglers = opts.stragglers ?? false;\n132\t\n133\t  const double = createProviderDouble();\n134\t  const sdk = createSdk({\n135\t    provider: double,\n136\t    mode: \"manual\",\n137\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n138\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\n139\t  });\n140\t\n141\t  const filePath = store.threadPath();\n142\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n143\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n144\t\n145\t  const turnIds: string[] = [];\n146\t  const fixture: DerivedThreadFixture = {\n147\t    filePath,\n148\t    sdk,\n149\t    double,\n150\t    turnIds,\n151\t    chunks: { chunks: [], members: [] },\n152\t  };\n153\t\n154\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n155\t    if (failures && turn === 6) {\n156\t      // Retryable failures consumed to exhaustion by the head-first drain:\n157\t      // the first tool_result_summary item of this batch takes all three\n158\t      // attempts and lands failed with the transient reason class.\n159\t      double.failKind(\"tool_result_summary\", 3, {\n160\t        retryable: true,\n161\t        reason: TRANSIENT_EXHAUST_REASON,\n162\t      });\n163\t    }\n164\t    if (failures && turn === 7) {\n165\t      // One non-retryable failure: terminal on the first attempt — the\n166\t      // permanent reason class, attempts 1.\n167\t      double.failKind(\"tool_result_summary\", 1, {\n168\t        retryable: false,\n169\t        reason: PERMANENT_FAILURE_REASON,\n170\t      });\n171\t    }\n172\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\n173\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n174\t    // result, call, result, text, end — index 3 is the first tool result,\n175\t    // the scripted failure
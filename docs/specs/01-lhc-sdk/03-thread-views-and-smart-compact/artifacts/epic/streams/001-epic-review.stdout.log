{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JZzksDomBjA7wGd3YJtEjb","type":"tool_result","content":"1\t// Test injection facility (Story 0, FC-0.6): one mechanism, two named\n2\t// points, pattern from Epic 02's intake walk hook. Production code carries\n3\t// the points as no-ops unless a test installs a hook:\n4\t//   - \"post-commit-advance\": fired by the boundary advance after intake's\n5\t//     commit flush, before the advance computes (TC-4.6's failure injection —\n6\t//     an installed hook that throws stands in for an advance failure);\n7\t//   - \"compact-write\": fired by compact between the sweep and the view-write\n8\t//     transaction (TC-2.4's crash injection — a throwing hook proves the\n9\t//     prior view survives an aborted write).\n10\t// Tests reach the setters through test/fixtures/view-seam.ts (the one\n11\t// directory sanctioned to import below the SDK surface); production code\n12\t// only ever fires.\n13\texport type ViewInjectionPoint = \"post-commit-advance\" | \"compact-write\";\n14\t\n15\texport type ViewInjectionHook = () => void;\n16\t\n17\tconst hooks: Record<ViewInjectionPoint, ViewInjectionHook | null> = {\n18\t  \"post-commit-advance\": null,\n19\t  \"compact-write\": null,\n20\t};\n21\t\n22\texport function setViewInjectionHook(\n23\t  point: ViewInjectionPoint,\n24\t  hook: ViewInjectionHook | null,\n25\t): void {\n26\t  hooks[point] = hook;\n27\t}\n28\t\n29\t// The production-side call: a no-op when nothing is installed. An installed\n30\t// hook's throw propagates to the call site on purpose — that is the injected\n31\t// failure the call site must survive.\n32\texport function fireViewInjection(point: ViewInjectionPoint): void {\n33\t  hooks[point]?.();\n34\t}\n35\t"}]},"parent_tool_use_id":null,"session_id":"8f35b3b6-f7a4-4d02-a9f9-b9315f787309","uuid":"2b8b2b6d-4859-4607-adfa-567f040308a2","timestamp":"2026-06-11T18:21:53.409Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/seam.ts","content":"// Test injection facility (Story 0, FC-0.6): one mechanism, two named\n// points, pattern from Epic 02's intake walk hook. Production code carries\n// the points as no-ops unless a test installs a hook:\n//   - \"post-commit-advance\": fired by the boundary advance after intake's\n//     commit flush, before the advance computes (TC-4.6's failure injection —\n//     an installed hook that throws stands in for an advance failure);\n//   - \"compact-write\": fired by compact between the sweep and the view-write\n//     transaction (TC-2.4's crash injection — a throwing hook proves the\n//     prior view survives an aborted write).\n// Tests reach the setters through test/fixtures/view-seam.ts (the one\n// directory sanctioned to import below the SDK surface); production code\n// only ever fires.\nexport type ViewInjectionPoint = \"post-commit-advance\" | \"compact-write\";\n\nexport type ViewInjectionHook = () => void;\n\nconst hooks: Record<ViewInjectionPoint, ViewInjectionHook | null> = {\n  \"post-commit-advance\": null,\n  \"compact-write\": null,\n};\n\nexport function setViewInjectionHook(\n  point: ViewInjectionPoint,\n  hook: ViewInjectionHook | null,\n): void {\n  hooks[point] = hook;\n}\n\n// The production-side call: a no-op when nothing is installed. An installed\n// hook's throw propagates to the call site on purpose — that is the injected\n// failure the call site must survive.\nexport function fireViewInjection(point: ViewInjectionPoint): void {\n  hooks[point]?.();\n}\n","numLines":35,"startLine":1,"totalLines":35}}}

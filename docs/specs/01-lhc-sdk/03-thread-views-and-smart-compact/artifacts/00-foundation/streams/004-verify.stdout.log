{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/scripts/check-boundaries.mjs | sed -n '1,180p'\"","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Zero-dependency import-boundary check.\n     3\t// Rules:\n     4\t//   1. No file may import another domain's internal/ modules.\n     5\t//   2. tech-utils/ and shared/ may not import from domains/.\n     6\t//   3. A domain may import another domain's surface (index.ts) only along an\n     7\t//      edge pinned in ALLOWED_SURFACE_IMPORTS below — a new cross-domain\n     8\t//      edge is a conscious decision, never a silent pass.\n     9\t// The test fixtures directory (test/fixtures/) is exempt by design — it is\n    10\t// the one sanctioned below-SDK writer.\n    11\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n    12\timport path from \"node:path\";\n    13\timport { fileURLToPath } from \"node:url\";\n    14\t\n    15\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    16\tconst srcRoot = path.join(pkgRoot, \"src\");\n    17\tconst testRoot = path.join(pkgRoot, \"test\");\n    18\tconst fixturesRoot = path.join(testRoot, \"fixtures\");\n    19\t\n    20\tfunction collectTsFiles(dir, out = []) {\n    21\t  let entries;\n    22\t  try {\n    23\t    entries = readdirSync(dir);\n    24\t  } catch {\n    25\t    return out;\n    26\t  }\n    27\t  for (const entry of entries) {\n    28\t    const full = path.join(dir, entry);\n    29\t    if (full === fixturesRoot) continue; // fixtures exempt\n    30\t    if (statSync(full).isDirectory()) {\n    31\t      collectTsFiles(full, out);\n    32\t    } else if (full.endsWith(\".ts\")) {\n    33\t      out.push(full);\n    34\t    }\n    35\t  }\n    36\t  return out;\n    37\t}\n    38\t\n    39\tfunction importSpecifiers(source) {\n    40\t  const specs = [];\n    41\t  const patterns = [\n    42\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    43\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    44\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n    45\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n    46\t  ];\n    47\t  for (const re of patterns) {\n    48\t    let m;\n    49\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n    50\t  }\n    51\t  return specs;\n    52\t}\n    53\t\n    54\tfunction domainOf(filePath) {\n    55\t  const rel = path.relative(srcRoot, filePath);\n    56\t  const parts = rel.split(path.sep);\n    57\t  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n    58\t  return null;\n    59\t}\n    60\t\n    61\t// The pinned domain-surface dependency edges (rule 3). Epic 03 adds two:\n    62\t// thread-view consumes the messages/turns report surfaces and the threads\n    63\t// resolver; intake-stream gains the thread-view surface for the boundary\n    64\t// advance registration (Flow 4).\n    65\t// SANCTIONED CYCLE (Epic 03 tech design §Module Boundaries): intake-stream →\n    66\t// thread-view → messages/turns → intake-stream (the last edges are type-only\n    67\t// event vocabulary). The domain graph is therefore deliberately not a DAG —\n    68\t// runtime-safe because the advance is registration-then-flush with no\n    69\t// import-time execution — so this check pins the allowed edge set instead of\n    70\t// asserting acyclicity.\n    71\tconst ALLOWED_SURFACE_IMPORTS = {\n    72\t  \"intake-stream\": new Set([\"threads\", \"messages\", \"turns\", \"thread-view\"]),\n    73\t  messages: new Set([\"threads\", \"intake-stream\"]),\n    74\t  turns: new Set([\"threads\", \"intake-stream\", \"messages\"]),\n    75\t  \"thread-view\": new Set([\"threads\", \"messages\", \"turns\"]),\n    76\t  threads: new Set(),\n    77\t};\n    78\t\n    79\tconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\n    80\tconst violations = [];\n    81\t\n    82\tfor (const file of files) {\n    83\t  const source = readFileSync(file, \"utf8\");\n    84\t  const fileDomain = domainOf(file);\n    85\t  const inTechUtilsOrShared =\n    86\t    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n    87\t    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n    88\t\n    89\t  for (const spec of importSpecifiers(source)) {\n    90\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n    91\t    const resolved = path.resolve(path.dirname(file), spec);\n    92\t    const relToSrc = path.relative(srcRoot, resolved);\n    93\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n    94\t    const parts = relToSrc.split(path.sep);\n    95\t\n    96\t    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n    97\t      const targetDomain = parts[1];\n    98\t      if (fileDomain !== targetDomain) {\n    99\t        violations.push(\n   100\t          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n   101\t        );\n   102\t      }\n   103\t    }\n   104\t    if (\n   105\t      parts[0] === \"domains\" &&\n   106\t      !parts.includes(\"internal\") &&\n   107\t      fileDomain !== null &&\n   108\t      parts[1] !== fileDomain\n   109\t    ) {\n   110\t      const targetDomain = parts[1];\n   111\t      const allowed = ALLOWED_SURFACE_IMPORTS[fileDomain];\n   112\t      if (allowed === undefined || !allowed.has(targetDomain)) {\n   113\t        violations.push(\n   114\t          `${path.relative(pkgRoot, file)} imports ${spec} — domain \"${fileDomain}\" has no pinned surface edge to \"${targetDomain}\" (rule 3)`,\n   115\t        );\n   116\t      }\n   117\t    }\n   118\t    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n   119\t      violations.push(\n   120\t        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n   121\t      );\n   122\t    }\n   123\t  }\n   124\t}\n   125\t\n   126\tif (violations.length > 0) {\n   127\t  console.error(\"boundary check FAILED:\");\n   128\t  for (const v of violations) console.error(`  - ${v}`);\n   129\t  process.exit(1);\n   130\t}\n   131\tconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '1,500p' && nl -ba packages/lhc/src/domains/thread-view/internal/profiles.ts | sed -n '1,500p' && nl -ba packages/lhc/src/domains/thread-view/internal/seam.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// thread-view surface (Epic 03). Story 0 lands the substrate only: profile\n     2\t// config resolution (consumed by createSdk at construction) and the storage\n     3\t// migration (owned by shared/storage.ts). The five operations — pull, status,\n     4\t// compact, sweep, materialize — arrive in Stories 1–5; nothing here is\n     5\t// reachable from the SDK operation surface yet.\n     6\texport {\n     7\t  BUILT_IN_PROFILES,\n     8\t  DEFAULT_COMPACT_THRESHOLD,\n     9\t  DEFAULT_VISIBILITY,\n    10\t  resolveViewConfig,\n    11\t} from \"./internal/profiles.js\";\n     1\t// Profile config resolution and validation (Story 0, FC-0.2): built-in\n     2\t// profiles, user profiles merged over them by name, and the budget rules —\n     3\t// band shares sum to 100, lower bound positive, visibility max > target ≥\n     4\t// floor. Pure functions, no IO. Config mistakes are programmer errors at SDK\n     5\t// construction and throw naming the violation (Epic 02 rule); nothing here\n     6\t// returns OpResults.\n     7\timport type {\n     8\t  ResolvedViewConfig,\n     9\t  SdkViewConfig,\n    10\t  ViewProfile,\n    11\t  ViewProfileOverride,\n    12\t  VisibilityBudgets,\n    13\t} from \"../../../shared/view.js\";\n    14\t\n    15\t// Built-in profiles (tech design §Interface Definitions): defaults, knobs\n    16\t// not architecture.\n    17\texport const BUILT_IN_PROFILES: readonly ViewProfile[] = [\n    18\t  {\n    19\t    name: \"continuation\",\n    20\t    lowerBound: 120000,\n    21\t    percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n    22\t  },\n    23\t  {\n    24\t    name: \"conversation\",\n    25\t    lowerBound: 120000,\n    26\t    percentages: { full: 12, smooth: 48, detailed: 20, brief: 20 },\n    27\t  },\n    28\t  {\n    29\t    name: \"coding\",\n    30\t    lowerBound: 120000,\n    31\t    percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n    32\t  },\n    33\t];\n    34\t\n    35\texport const DEFAULT_VISIBILITY: VisibilityBudgets = {\n    36\t  maxTokens: 32000,\n    37\t  targetTokens: 24000,\n    38\t  floorTokens: 8000,\n    39\t};\n    40\t\n    41\texport const DEFAULT_COMPACT_THRESHOLD = 160000;\n    42\t\n    43\tfunction fail(detail: string): never {\n    44\t  throw new TypeError(`createSdk config: view: ${detail}`);\n    45\t}\n    46\t\n    47\tconst BAND_KEYS = [\"full\", \"smooth\", \"detailed\", \"brief\"] as const;\n    48\t\n    49\t// A complete, merged profile validates whole: positive lower bound, finite\n    50\t// non-negative shares, shares summing to exactly 100. Errors name the\n    51\t// violated constraint and the profile (AC-2.3's vocabulary, applied at\n    52\t// construction).\n    53\texport function validateProfile(profile: ViewProfile): void {\n    54\t  if (!Number.isFinite(profile.lowerBound) || profile.lowerBound <= 0) {\n    55\t    fail(\n    56\t      `profile \"${profile.name}\": lowerBound must be a positive number, got ${profile.lowerBound}`,\n    57\t    );\n    58\t  }\n    59\t  for (const key of BAND_KEYS) {\n    60\t    const share = profile.percentages[key];\n    61\t    if (!Number.isFinite(share) || share < 0) {\n    62\t      fail(`profile \"${profile.name}\": percentage ${key} must be a non-negative number, got ${share}`);\n    63\t    }\n    64\t  }\n    65\t  const sum = BAND_KEYS.reduce((total, key) => total + profile.percentages[key], 0);\n    66\t  if (sum !== 100) {\n    67\t    fail(`profile \"${profile.name}\": percentages must sum to 100, got ${sum}`);\n    68\t  }\n    69\t}\n    70\t\n    71\tfunction isCompleteOverride(entry: ViewProfileOverride): boolean {\n    72\t  return (\n    73\t    entry.lowerBound !== undefined &&\n    74\t    entry.percentages !== undefined &&\n    75\t    BAND_KEYS.every((key) => entry.percentages?.[key] !== undefined)\n    76\t  );\n    77\t}\n    78\t\n    79\t// Merge one configured entry: field-wise over the built-in it names, or — for\n    80\t// a name no built-in carries — the entry must be complete, since there is\n    81\t// nothing to merge over (FC-0.2's unknown-built-in-override-target violation).\n    82\tfunction mergeProfile(entry: ViewProfileOverride, base: ViewProfile | undefined): ViewProfile {\n    83\t  if (base === undefined) {\n    84\t    if (!isCompleteOverride(entry)) {\n    85\t      fail(\n    86\t        `profile \"${entry.name}\" is partial but overrides no built-in (unknown built-in override target); built-ins are ${BUILT_IN_PROFILES.map((p) => `\"${p.name}\"`).join(\", \")} — a new profile must carry lowerBound and all four percentages`,\n    87\t      );\n    88\t    }\n    89\t    return {\n    90\t      name: entry.name,\n    91\t      lowerBound: entry.lowerBound as number,\n    92\t      percentages: {\n    93\t        full: entry.percentages?.full as number,\n    94\t        smooth: entry.percentages?.smooth as number,\n    95\t        detailed: entry.percentages?.detailed as number,\n    96\t        brief: entry.percentages?.brief as number,\n    97\t      },\n    98\t    };\n    99\t  }\n   100\t  return {\n   101\t    name: entry.name,\n   102\t    lowerBound: entry.lowerBound ?? base.lowerBound,\n   103\t    percentages: {\n   104\t      full: entry.percentages?.full ?? base.percentages.full,\n   105\t      smooth: entry.percentages?.smooth ?? base.percentages.smooth,\n   106\t      detailed: entry.percentages?.detailed ?? base.percentages.detailed,\n   107\t      brief: entry.percentages?.brief ?? base.percentages.brief,\n   108\t    },\n   109\t  };\n   110\t}\n   111\t\n   112\tfunction resolveVisibility(partial: Partial<VisibilityBudgets> | undefined): VisibilityBudgets {\n   113\t  const visibility: VisibilityBudgets = {\n   114\t    maxTokens: partial?.maxTokens ?? DEFAULT_VISIBILITY.maxTokens,\n   115\t    targetTokens: partial?.targetTokens ?? DEFAULT_VISIBILITY.targetTokens,\n   116\t    floorTokens: partial?.floorTokens ?? DEFAULT_VISIBILITY.floorTokens,\n   117\t  };\n   118\t  for (const key of [\"maxTokens\", \"targetTokens\", \"floorTokens\"] as const) {\n   119\t    if (!Number.isFinite(visibility[key]) || visibility[key] <= 0) {\n   120\t      fail(`visibility.${key} must be a positive number, got ${visibility[key]}`);\n   121\t    }\n   122\t  }\n   123\t  // The budget ordering rule (AC-4.8): max > target ≥ floor.\n   124\t  if (visibility.maxTokens <= visibility.targetTokens) {\n   125\t    fail(\n   126\t      `visibility.maxTokens (${visibility.maxTokens}) must be greater than targetTokens (${visibility.targetTokens})`,\n   127\t    );\n   128\t  }\n   129\t  if (visibility.targetTokens < visibility.floorTokens) {\n   130\t    fail(\n   131\t      `visibility.targetTokens (${visibility.targetTokens}) must be at least floorTokens (${visibility.floorTokens})`,\n   132\t    );\n   133\t  }\n   134\t  return visibility;\n   135\t}\n   136\t\n   137\t// The one resolution path: built-ins, user profiles merged by name, every\n   138\t// resolved profile validated, visibility and threshold defaulted and checked.\n   139\t// Called from createSdk so validation runs through real construction, never a\n   140\t// standalone validator (Story 0 production-path proof).\n   141\texport function resolveViewConfig(config?: SdkViewConfig): ResolvedViewConfig {\n   142\t  const profiles: Record<string, ViewProfile> = {};\n   143\t  for (const builtIn of BUILT_IN_PROFILES) {\n   144\t    profiles[builtIn.name] = builtIn;\n   145\t  }\n   146\t  for (const entry of config?.profiles ?? []) {\n   147\t    if (typeof entry.name !== \"string\" || entry.name.length === 0) {\n   148\t      fail(`profile entries must carry a non-empty name`);\n   149\t    }\n   150\t    profiles[entry.name] = mergeProfile(entry, profiles[entry.name]);\n   151\t  }\n   152\t  for (const profile of Object.values(profiles)) {\n   153\t    validateProfile(profile);\n   154\t  }\n   155\t\n   156\t  const compactThreshold = config?.compactThreshold ?? DEFAULT_COMPACT_THRESHOLD;\n   157\t  if (!Number.isFinite(compactThreshold) || compactThreshold <= 0) {\n   158\t    fail(`compactThreshold must be a positive number, got ${compactThreshold}`);\n   159\t  }\n   160\t\n   161\t  return {\n   162\t    profiles,\n   163\t    visibility: resolveVisibility(config?.visibility),\n   164\t    compactThreshold,\n   165\t  };\n   166\t}\n     1\t// Test injection facility (Story 0, FC-0.6): one mechanism, two named\n     2\t// points, pattern from Epic 02's intake walk hook. Production code carries\n     3\t// the points as no-ops unless a test installs a hook:\n     4\t//   - \"post-commit-advance\": fired by the boundary advance after intake's\n     5\t//     commit flush, before the advance computes (TC-4.6's failure injection —\n     6\t//     an installed hook that throws stands in for an advance failure);\n     7\t//   - \"compact-write\": fired by compact between the sweep and the view-write\n     8\t//     transaction (TC-2.4's crash injection — a throwing hook proves the\n     9\t//     prior view survives an aborted write).\n    10\t// Tests reach the setters through test/fixtures/view-seam.ts (the one\n    11\t// directory sanctioned to import below the SDK surface); production code\n    12\t// only ever fires.\n    13\texport type ViewInjectionPoint = \"post-commit-advance\" | \"compact-write\";\n    14\t\n    15\texport type ViewInjectionHook = () => void;\n    16\t\n    17\tconst hooks: Record<ViewInjectionPoint, ViewInjectionHook | null> = {\n    18\t  \"post-commit-advance\": null,\n    19\t  \"compact-write\": null,\n    20\t};\n    21\t\n    22\texport function setViewInjectionHook(\n    23\t  point: ViewInjectionPoint,\n    24\t  hook: ViewInjectionHook | null,\n    25\t): void {\n    26\t  hooks[point] = hook;\n    27\t}\n    28\t\n    29\t// The production-side call: a no-op when nothing is installed. An installed\n    30\t// hook's throw propagates to the call site on purpose — that is the injected\n    31\t// failure the call site must survive.\n    32\texport function fireViewInjection(point: ViewInjectionPoint): void {\n    33\t  hooks[point]?.();\n    34\t}\n","exit_code":0,"status":"completed"}}

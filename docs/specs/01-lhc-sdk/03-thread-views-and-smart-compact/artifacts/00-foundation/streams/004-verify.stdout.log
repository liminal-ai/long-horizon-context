{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/package.json | sed -n '1,200p'\"","aggregated_output":"     1\t{\n     2\t  \"name\": \"lhc\",\n     3\t  \"version\": \"0.0.0\",\n     4\t  \"private\": true,\n     5\t  \"description\": \"Long Horizon Context SDK and CLI core.\",\n     6\t  \"type\": \"module\",\n     7\t  \"main\": \"./dist/index.js\",\n     8\t  \"types\": \"./dist/index.d.ts\",\n     9\t  \"exports\": {\n    10\t    \".\": {\n    11\t      \"types\": \"./dist/index.d.ts\",\n    12\t      \"import\": \"./dist/index.js\"\n    13\t    }\n    14\t  },\n    15\t  \"bin\": {\n    16\t    \"lhc\": \"./dist/cli.js\"\n    17\t  },\n    18\t  \"files\": [\n    19\t    \"dist\",\n    20\t    \"README.md\"\n    21\t  ],\n    22\t  \"scripts\": {\n    23\t    \"clean\": \"rm -rf dist\",\n    24\t    \"build\": \"pnpm run clean && tsc -p tsconfig.json\",\n    25\t    \"typecheck\": \"tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json\",\n    26\t    \"lint\": \"node scripts/lint.mjs\",\n    27\t    \"boundaries\": \"node scripts/check-boundaries.mjs\",\n    28\t    \"dev:cli\": \"tsx src/cli.ts\",\n    29\t    \"test\": \"vitest run\",\n    30\t    \"red-verify\": \"pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run boundaries\",\n    31\t    \"verify\": \"pnpm run red-verify && echo 'SKIP: cli-process suite — run verify-all' && vitest run\",\n    32\t    \"green-verify\": \"pnpm run verify && node scripts/check-test-immutability.mjs\",\n    33\t    \"verify-all\": \"pnpm run red-verify && LHC_PROCESS_SUITE=1 vitest run\"\n    34\t  },\n    35\t  \"engines\": {\n    36\t    \"node\": \">=24\"\n    37\t  },\n    38\t  \"dependencies\": {\n    39\t    \"effect\": \"^3.21.2\",\n    40\t    \"js-tiktoken\": \"^1.0.21\"\n    41\t  },\n    42\t  \"devDependencies\": {\n    43\t    \"@types/node\": \"^24.12.4\",\n    44\t    \"tsx\": \"^4.22.4\",\n    45\t    \"typescript\": \"^5.9.3\",\n    46\t    \"vitest\": \"^4.1.8\"\n    47\t  }\n    48\t}\n","exit_code":0,"status":"completed"}}

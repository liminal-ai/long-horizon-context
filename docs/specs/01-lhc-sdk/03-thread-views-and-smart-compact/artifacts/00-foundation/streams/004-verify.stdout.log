\t      errorClass: \"state_corruption\",\n   166\t      code: \"unknown_work_kind\",\n   167\t      reason: `no handler registered for work kind \"${kind}\"`,\n   168\t    },\n   169\t  };\n   170\t}\n   171\t\n   172\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   173\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   174\texport function lookupWorkHandler(\n   175\t  map: WorkHandlerMap,\n   176\t  kind: string,\n   177\t): OpResult<WorkHandler> {\n   178\t  const handler = map[kind as WorkKind];\n   179\t  if (handler === undefined) return unknownWorkKind(kind);\n   180\t  return { ok: true, value: handler };\n   181\t}\n   182\t\n   183\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   184\t// requeue land in Story 4.\n   185\texport interface WorkSurface {\n   186\t  drain(\n   187\t    ref: threadsDomain.ThreadRef,\n   188\t    opts?: { maxItems?: number },\n   189\t  ): Promise<OpResult<DrainReport>>;\n   190\t}\n   191\t\n   192\texport interface Lhc {\n   193\t  threads: typeof threadsDomain;\n   194\t  intakeStream: typeof intakeStreamDomain;\n   195\t  messages: typeof messagesDomain;\n   196\t  turns: typeof turnsDomain;\n   197\t  config: ResolvedSdkConfig;\n   198\t  scheduler: Scheduler;\n   199\t  workHandlers: WorkHandlerMap;\n   200\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   201\t  work: WorkSurface;\n   202\t  // Resolves when the scheduler has no running or pending drain for the\n   203\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   204\t  // resolve in manual mode.\n   205\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   206\t}\n   207\t\n   208\tfunction requirePositive(value: number, name: string): void {\n   209\t  if (!Number.isFinite(value) || value <= 0) {\n   210\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   211\t  }\n   212\t}\n   213\t\n   214\tfunction requireNonNegative(value: number, name: string): void {\n   215\t  if (!Number.isFinite(value) || value < 0) {\n   216\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   217\t  }\n   218\t}\n   219\t\n   220\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   221\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   222\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   223\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   224\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   225\t// object is the same shape as the namespace, so the public surface type holds.\n   226\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   227\t  const scoped: Record<string, unknown> = {};\n   228\t  for (const key of Object.keys(surface)) {\n   229\t    const value = (surface as Record<string, unknown>)[key];\n   230\t    scoped[key] =\n   231\t      typeof value === \"function\"\n   232\t        ? (...args: unknown[]): unknown =>\n   233\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   234\t        : value;\n   235\t  }\n   236\t  return scoped as T;\n   237\t}\n   238\t\n   239\t// The only assembly path: provider, mode, clock, and policy enter here.\n   240\t// Config mistakes are programmer errors at construction and throw; operating\n   241\t// failures after construction return OpResults per the error contract.\n   242\texport function createSdk(config: SdkConfig): Lhc {\n   243\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   244\t    throw new TypeError(\n   245\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   246\t    );\n   247\t  }\n   248\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   249\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   250\t  }\n   251\t  for (const operation of PROVIDER_OPERATIONS) {\n   252\t    if (typeof config.provider[operation] !== \"function\") {\n   253\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   254\t    }\n   255\t  }\n   256\t\n   257\t  const resolved: ResolvedSdkConfig = {\n   258\t    provider: config.provider,\n   259\t    mode: config.mode,\n   260\t    clock: config.clock ?? (() => new Date()),\n   261\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   262\t    lease: config.lease ?? { durationMs: 120000 },\n   263\t    chunkPolicy:\n   264\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   265\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   266\t    // sums and visibility budgets validated — throws naming the violation.\n   267\t    view: resolveViewConfig(config.view),\n   268\t  };\n   269\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   270\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   271\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   272\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   273\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   274\t  }\n   275\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   276\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   277\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   278\t    throw new TypeError(\n   279\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   280\t    );\n   281\t  }\n   282\t\n   283\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   284\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   285\t  // assembly mechanics are production code from day one.\n   286\t  const workHandlers = assembleWorkHandlerMap([\n   287\t    messagesDomain.workHandlers,\n   288\t    turnsDomain.workHandlers,\n   289\t  ]);\n   290\t\n   291\t  const drainDeps: DrainDeps = {\n   292\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   293\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   294\t    config: resolved,\n   295\t  };\n   296\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   297\t\n   298\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   299\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   300\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   301\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   302\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   303\t  // the construction order, because its operations deliver to the no-op seam,\n   304\t  // not to whatever a background SDK installed below.\n   305\t  const seam: InstanceSeam =\n   306\t    resolved.mode === \"background\"\n   307\t      ? {\n   308\t          poke: (threadId) => scheduler.poke(threadId),\n   309\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   310\t        }\n   311\t      : { poke: () => {}, touch: () => {} };\n   312\t\n   313\t  // Background mode also installs the below-SDK default seam so a direct\n   314\t  // domain call made with no SDK scope — a top-level mutation in the\n   315\t  // single-background \"production path\" — still reaches the one installed\n   316\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   317\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   318\t  // leaves the default alone (pokes stay no-ops by contract).\n   319\t  if (resolved.mode === \"background\") {\n   320\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   321\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   322\t  }\n   323\t\n   324\t  const work: WorkSurface = {\n   325\t    drain: (ref, opts) =>\n   326\t      runWithInstanceSeam(seam, async () => {\n   327\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   328\t        if (!resolvedRef.ok) return resolvedRef;\n   329\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   330\t      }),\n   331\t  };\n   332\t\n   333\t  return {\n   334\t    threads: threadsDomain,\n   335\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n   336\t    messages: scopeSurface(messagesDomain, seam),\n   337\t    turns: scopeSurface(turnsDomain, seam),\n   338\t    config: resolved,\n   339\t    scheduler,\n   340\t    workHandlers,\n","exit_code":0,"status":"completed"}}

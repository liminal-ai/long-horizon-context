{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/view.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n     2\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n     3\t// domain owns the behavior, this module owns only the shapes.\n     4\t\n     5\texport type Band = \"brief\" | \"detailed\" | \"smooth\";\n     6\t\n     7\texport interface ViewProfile {\n     8\t  name: string;\n     9\t  // Target assembled size; whole-entry fills may land under or over (epic\n    10\t  // Data Contracts — the bound is a target, not a cap).\n    11\t  lowerBound: number;\n    12\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n    13\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n    14\t}\n    15\t\n    16\t// A user profile entry as configured: a full profile under a new name, or a\n    17\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n    18\t// whose name matches no built-in has nothing to merge over and is rejected at\n    19\t// construction (FC-0.2's unknown-override violation).\n    20\texport interface ViewProfileOverride {\n    21\t  name: string;\n    22\t  lowerBound?: number;\n    23\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n    24\t}\n    25\t\n    26\t// Visibility-boundary budgets (AC-4.x): max > target ≥ floor, all positive.\n    27\texport interface VisibilityBudgets {\n    28\t  maxTokens: number;\n    29\t  targetTokens: number;\n    30\t  floorTokens: number;\n    31\t}\n    32\t\n    33\t// ── SDK assembly config (validated at construction, throws on nonsense\n    34\t// per the Epic 02 rule) ───────────────────────────────────────────\n    35\texport interface SdkViewConfig {\n    36\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n    37\t  visibility?: Partial<VisibilityBudgets>; // defaults: 32000 / 24000 / 8000\n    38\t  compactThreshold?: number; // status trigger; default 160000\n    39\t}\n    40\t\n    41\t// Every optional filled by createSdk's central defaults; profiles resolved\n    42\t// to complete, validated entries keyed by name.\n    43\texport interface ResolvedViewConfig {\n    44\t  profiles: Readonly<Record<string, ViewProfile>>;\n    45\t  visibility: VisibilityBudgets;\n    46\t  compactThreshold: number;\n    47\t}\n    48\t\n    49\t// ── pull / status shapes (the product crossing to the harness) ────\n    50\texport interface ViewMessage {\n    51\t  role: \"user\" | \"assistant\";\n    52\t  content: string;\n    53\t  band?: Band; // band absent ⇒ tail\n    54\t}\n    55\t\n    56\texport interface ViewMeta {\n    57\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n    58\t  coveredFrom: number | null;\n    59\t  boundaryPosition: number;\n    60\t  gapCount: number;\n    61\t  degradedCount: number;\n    62\t  viewId: string | null;\n    63\t  createdAt: string | null;\n    64\t}\n    65\t\n    66\texport interface PullResult {\n    67\t  messages: ViewMessage[];\n    68\t  meta: ViewMeta;\n    69\t}\n    70\t\n    71\texport interface ViewStatus {\n    72\t  tailTokens: number;\n    73\t  threshold: number;\n    74\t  compactRecommended: boolean;\n    75\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n    76\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n    77\t  visibility: { zoneTokens: number; maxTokens: number };\n    78\t}\n    79\t\n    80\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n    81\texport interface CompactReceipt {\n    82\t  viewId: string;\n    83\t  profile: string | null;\n    84\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n    85\t  bands: Record<Band, { entries: number; tokens: number }>;\n    86\t  tailTokens: number;\n    87\t  coveredFrom: number;\n    88\t  compactPoint: number;\n    89\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n    90\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n    91\t  sweep: SweepReceipt | { skipped: true };\n    92\t}\n    93\t\n    94\texport interface SweepReceipt {\n    95\t  owners: Array<{\n    96\t    owner: \"messages\" | \"turns\";\n    97\t    kind: string;\n    98\t    ready: number;\n    99\t    inFlight: number;\n   100\t    requeued: string[]; // subject ids\n   101\t    blocked: Array<{ subjectId: string; reason: string }>;\n   102\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\n   103\t  }>;\n   104\t}\n","exit_code":0,"status":"completed"}}

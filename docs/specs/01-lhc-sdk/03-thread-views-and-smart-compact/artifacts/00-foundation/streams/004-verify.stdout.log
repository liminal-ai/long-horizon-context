{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts | sed -n '120,260p'\"","aggregated_output":"   120\t\n   121\t    // Cross-domain calls inside the transaction share the open handle through\n   122\t    // the operation context (design decision 8); built once per batch, never\n   123\t    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n   124\t    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n   125\t    // so they drop with the transaction.\n   126\t    const hooks = createCommitHooks();\n   127\t    const ctx: OperationContext = {\n   128\t      db,\n   129\t      clock,\n   130\t      threadId: threadIdOf(db),\n   131\t      onCommit: hooks.register,\n   132\t      poke: resolveInstancePoke(),\n   133\t    };\n   134\t\n   135\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n   136\t    // any event is processed — once is sufficient because only this pipeline\n   137\t    // writes turn state and the write lock is already held, so more than one\n   138\t    // open turn can only mean external interference. The batch records\n   139\t    // nothing: nothing has been written yet, and the rollback closes the\n   140\t    // never-used transaction.\n   141\t    const openTurnIds = listOpenTurnIds(ctx);\n   142\t    if (openTurnIds.length > 1) {\n   143\t      db.exec(\"ROLLBACK;\");\n   144\t      inTransaction = false;\n   145\t      return {\n   146\t        ok: false,\n   147\t        error: {\n   148\t          errorClass: \"state_corruption\",\n   149\t          code: \"turn_state_corrupt\",\n   150\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n   151\t        },\n   152\t      };\n   153\t    }\n   154\t\n   155\t    const skipSet = recordedKeys(\n   156\t      db,\n   157\t      events.map((event) => event.idempotencyKey),\n   158\t    );\n   159\t    // Order counter from MAX(event_order): only recorded events increment it,\n   160\t    // so skips consume no order numbers and the sequence stays dense.\n   161\t    let lastOrder = maxEventOrder(db);\n   162\t\n   163\t    const insert = db.prepare(\n   164\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   165\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   166\t    );\n   167\t\n   168\t    const eventResults: BatchResult[\"events\"] = [];\n   169\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n   170\t    // Work items append as they queue, in walk order — the result is a\n   171\t    // faithful log of what the transaction did (AC-2.7). The full records\n   172\t    // (status, queuedAt) stay in the thread file; the result carries item\n   173\t    // identity only.\n   174\t    const queuedItems: WorkItemRecord[] = [];\n   175\t    for (const [index, event] of events.entries()) {\n   176\t      if (skipSet.has(event.idempotencyKey)) {\n   177\t        eventResults.push({\n   178\t          idempotencyKey: event.idempotencyKey,\n   179\t          outcome: \"skipped\",\n   180\t          skipReason: \"duplicate_idempotency_key\",\n   181\t        });\n   182\t      } else {\n   183\t        lastOrder += 1;\n   184\t        const recordedAt = clock().toISOString();\n   185\t        insert.run(\n   186\t          lastOrder,\n   187\t          event.eventKind,\n   188\t          event.idempotencyKey,\n   189\t          event.actor,\n   190\t          event.harness,\n   191\t          JSON.stringify(event.payload),\n   192\t          recordedAt,\n   193\t        );\n   194\t        skipSet.add(event.idempotencyKey);\n   195\t        // Turn transition before projection — the order is load-bearing: a\n   196\t        // prompt transitions first and stamps to the turn it just opened\n   197\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n   198\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n   199\t        // call, so a resend causes no transition (TC-5.4).\n   200\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n   201\t        turnTransitions.push(...turnOutcome.transitions);\n   202\t        queuedItems.push(...turnOutcome.queuedWork);\n   203\t        // Projection runs in the same iteration that recorded the event, so\n   204\t        // it can never drift from its source; a projection failure throws\n   205\t        // and rejects the whole batch. Skipped events never reach this call\n   206\t        // (no duplicate message, AC-5.4).\n   207\t        const created = createFromEvent(\n   208\t          ctx,\n   209\t          {\n   210\t            ...event,\n   211\t            eventOrder: lastOrder,\n   212\t            recordedAt,\n   213\t          },\n   214\t          turnOutcome.openTurnId,\n   215\t        );\n   216\t        // Message-owned work queues in the same iteration, gated on\n   217\t        // recorded: a skipped event never reaches this call, so it queues\n   218\t        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n   219\t        // decides which messages are derivation sources (AC-2.8).\n   220\t        queuedItems.push(...queueMessageWork(ctx, created));\n   221\t        const entry: BatchResult[\"events\"][number] = {\n   222\t          idempotencyKey: event.idempotencyKey,\n   223\t          outcome: \"recorded\",\n   224\t        };\n   225\t        if (created !== null) entry.messageId = created.messageId;\n   226\t        eventResults.push(entry);\n   227\t      }\n   228\t      walkHook?.(db, index);\n   229\t    }\n   230\t\n   231\t    db.exec(\"COMMIT;\");\n   232\t    inTransaction = false;\n   233\t    hooks.flush();\n   234\t\n   235\t    return {\n   236\t      ok: true,\n   237\t      value: {\n   238\t        events: eventResults,\n   239\t        turnTransitions,\n   240\t        queuedWork: queuedItems.map((item) => ({\n   241\t          workItemId: item.workItemId,\n   242\t          owner: item.owner,\n   243\t          kind: item.kind,\n   244\t          sourceRef: item.sourceRef,\n   245\t        })),\n   246\t        threadPosition: { lastEventOrder: lastOrder },\n   247\t      },\n   248\t    };\n   249\t  } catch (cause) {\n   250\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n   251\t    // class-independent. The handle may already be gone (induced failure),\n   252\t    // in which case SQLite has already discarded the uncommitted transaction.\n   253\t    if (inTransaction) {\n   254\t      try {\n   255\t        db.exec(\"ROLLBACK;\");\n   256\t      } catch {\n   257\t        // handle closed mid-walk; the open transaction died with it\n   258\t      }\n   259\t    }\n   260\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n","exit_code":0,"status":"completed"}}

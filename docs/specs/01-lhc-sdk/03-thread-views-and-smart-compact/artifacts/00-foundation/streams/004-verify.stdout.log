{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-fixture.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Epic 03 Story 0 foundation checks (FC-0.1–FC-0.6): migration v6 storage,\n     2\t// profile config validation through real createSdk construction, the\n     3\t// derived-thread fixture's state fidelity proven by read-back through the\n     4\t// owning report surfaces (states reached through production drains, never\n     5\t// hand-written rows), the corruption and turnless-straggler variants, and\n     6\t// the two-point test injection facility.\n     7\timport { afterAll, afterEach, beforeAll, describe, expect, it } from \"vitest\";\n     8\timport { createSdk, messages, turns, type Lhc } from \"../src/index.js\";\n     9\timport {\n    10\t  blockedSiblingThread,\n    11\t  corruptedVariantThread,\n    12\t  createProviderDouble,\n    13\t  derivedThreadFixture,\n    14\t  fireViewInjection,\n    15\t  openRaw,\n    16\t  PERMANENT_FAILURE_REASON,\n    17\t  schemaVersionOf,\n    18\t  setViewInjectionHook,\n    19\t  stragglerVariantThread,\n    20\t  tempStore,\n    21\t  TRANSIENT_EXHAUST_REASON,\n    22\t  validEvent,\n    23\t  type DerivedThreadFixture,\n    24\t  type TempStore,\n    25\t} from \"./fixtures/index.js\";\n    26\t\n    27\t// The main fixture is the suite's load-bearing asset and is expensive to\n    28\t// drain; it is built once and read (never mutated) by every check below.\n    29\tlet store: TempStore;\n    30\tlet fixture: DerivedThreadFixture;\n    31\t\n    32\tbeforeAll(async () => {\n    33\t  store = tempStore();\n    34\t  fixture = await derivedThreadFixture(store);\n    35\t});\n    36\tafterAll(() => {\n    37\t  store.cleanup();\n    38\t});\n    39\t\n    40\tfunction manualSdk(view?: Parameters<typeof createSdk>[0][\"view\"]): Lhc {\n    41\t  return createSdk({\n    42\t    provider: createProviderDouble(),\n    43\t    mode: \"manual\",\n    44\t    ...(view === undefined ? {} : { view }),\n    45\t  });\n    46\t}\n    47\t\n    48\tdescribe(\"FC-0.1: migration v6 storage on a current thread file\", () => {\n    49\t  it(\"creates the three view tables with their CHECK constraints and seeds the boundary at 0\", () => {\n    50\t    expect(schemaVersionOf(fixture.filePath)).toBe(6);\n    51\t    const db = openRaw(fixture.filePath);\n    52\t    try {\n    53\t      const tables = (\n    54\t        db\n    55\t          .prepare(\n    56\t            `SELECT name FROM sqlite_master WHERE type = 'table'\n    57\t             AND name IN ('thread_view', 'thread_view_band', 'view_boundary') ORDER BY name`,\n    58\t          )\n    59\t          .all() as unknown as Array<{ name: string }>\n    60\t      ).map((row) => row.name);\n    61\t      expect(tables).toEqual([\"thread_view\", \"thread_view_band\", \"view_boundary\"]);\n    62\t\n    63\t      // The boundary singleton is seeded at position 0 (everything full).\n    64\t      const boundary = db\n    65\t        .prepare(`SELECT thread_singleton, position, updated_at FROM view_boundary`)\n    66\t        .all() as unknown as Array<{\n    67\t        thread_singleton: number | bigint;\n    68\t        position: number | bigint;\n    69\t        updated_at: string;\n    70\t      }>;\n    71\t      expect(boundary).toHaveLength(1);\n    72\t      expect(Number(boundary[0]!.thread_singleton)).toBe(1);\n    73\t      expect(Number(boundary[0]!.position)).toBe(0);\n    74\t      expect(boundary[0]!.updated_at.length).toBeGreaterThan(0);\n    75\t\n    76\t      // Singleton CHECKs enforce structurally: a second view row or a second\n    77\t      // boundary row cannot exist (failed inserts, nothing mutated).\n    78\t      expect(() =>\n    79\t        db\n    80\t          .prepare(\n    81\t            `INSERT INTO thread_view (singleton, view_id, created_at, compact_point,\n    82\t               covered_from, config_json, arrangement_json, gaps_json, source_state_json)\n    83\t             VALUES (2, 'v1', 'now', 0, 0, '{}', '[]', '[]', '{}')`,\n    84\t          )\n    85\t          .run(),\n    86\t      ).toThrow(/CHECK/);\n    87\t      expect(() =>\n    88\t        db\n    89\t          .prepare(`INSERT INTO view_boundary (thread_singleton, position, updated_at) VALUES (2, 0, 'now')`)\n    90\t          .run(),\n    91\t      ).toThrow(/CHECK/);\n    92\t\n    93\t      // The band table pins its band vocabulary and cascade in the DDL.\n    94\t      const bandDdl = (\n    95\t        db\n    96\t          .prepare(`SELECT sql FROM sqlite_master WHERE name = 'thread_view_band'`)\n    97\t          .get() as { sql: string }\n    98\t      ).sql;\n    99\t      expect(bandDdl).toContain(\"CHECK (band IN ('brief','detailed','smooth'))\");\n   100\t      expect(bandDdl).toContain(\"ON DELETE CASCADE\");\n   101\t    } finally {\n   102\t      db.close();\n   103\t    }\n   104\t  });\n   105\t});\n   106\t\n   107\tdescribe(\"FC-0.2: view config validated at SDK construction, errors naming the violation\", () => {\n   108\t  it(\"rejects a profile whose band percentages do not sum to 100\", () => {\n   109\t    expect(() =>\n   110\t      manualSdk({\n   111\t        profiles: [\n   112\t          {\n   113\t            name: \"skewed\",\n   114\t            lowerBound: 50000,\n   115\t            percentages: { full: 30, smooth: 35, detailed: 20, brief: 20 },\n   116\t          },\n   117\t        ],\n   118\t      }),\n   119\t    ).toThrow(/profile \"skewed\": percentages must sum to 100, got 105/);\n   120\t  });\n   121\t\n   122\t  it(\"rejects visibility budgets violating max > target >= floor, naming the constraint\", () => {\n   123\t    expect(() => manualSdk({ visibility: { maxTokens: 24000, targetTokens: 24000 } })).toThrow(\n   124\t      /visibility\\.maxTokens \\(24000\\) must be greater than targetTokens \\(24000\\)/,\n   125\t    );\n   126\t    expect(() =>\n   127\t      manualSdk({ visibility: { targetTokens: 7000, floorTokens: 8000, maxTokens: 32000 } }),\n   128\t    ).toThrow(/visibility\\.targetTokens \\(7000\\) must be at least floorTokens \\(8000\\)/);\n   129\t  });\n   130\t\n   131\t  it(\"rejects a non-positive lower bound\", () => {\n   132\t    expect(() =>\n   133\t      manualSdk({\n   134\t        profiles: [\n   135\t          {\n   136\t            name: \"hollow\",\n   137\t            lowerBound: 0,\n   138\t            percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n   139\t          },\n   140\t        ],\n   141\t      }),\n   142\t    ).toThrow(/profile \"hollow\": lowerBound must be a positive number, got 0/);\n   143\t  });\n   144\t\n   145\t  it(\"rejects a partial profile that overrides no built-in (unknown override target)\", () => {\n   146\t    expect(() => manualSdk({ profiles: [{ name: \"mystery\", lowerBound: 64000 }] })).toThrow(\n   147\t      /profile \"mystery\" is partial but overrides no built-in \\(unknown built-in override target\\)/,\n   148\t    );\n   149\t  });\n   150\t\n   151\t  it(\"resolves defaults and merges a built-in override field-wise\", () => {\n   152\t    const sdk = manualSdk({ profiles: [{ name: \"coding\", lowerBound: 64000 }] });\n   153\t    expect(sdk.config.view.visibility).toEqual({\n   154\t      maxTokens: 32000,\n   155\t      targetTokens: 24000,\n   156\t      floorTokens: 8000,\n   157\t    });\n   158\t    expect(sdk.config.view.compactThreshold).toBe(160000);\n   159\t    // The override replaced only the named field; the built-in's percentages\n   160\t    // survive, and the other built-ins are untouched.\n   161\t    expect(sdk.config.view.profiles[\"coding\"]).toEqual({\n   162\t      name: \"coding\",\n   163\t      lowerBound: 64000,\n   164\t      percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n   165\t    });\n   166\t    expect(sdk.config.view.profiles[\"continuation\"]).toEqual({\n   167\t      name: \"continuation\",\n   168\t      lowerBound: 120000,\n   169\t      percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n   170\t    });\n   171\t    expect(sdk.config.view.profiles[\"conversation\"]?.percentages).toEqual({\n   172\t      full: 12,\n   173\t      smooth: 48,\n   174\t      detailed: 20,\n   175\t      brief: 20,\n   176\t    });\n   177\t  });\n   178\t});\n   179\t\n   180\tdescribe(\"FC-0.3: fixture states proven by read-back through the owning report surfaces\", () => {\n   181\t  it(\"ready: every turn rendering and the closed chunks' summaries read back ready through turns.report\", async () => {\n   182\t    const report = await turns.report({ filePath: fixture.filePath });\n   183\t    expect(report.ok).toBe(true);\n   184\t    if (!report.ok) return;\n   185\t    const renderings = report.value.filter((entry) => entry.form === \"turn_rendering\");\n   186\t    expect(renderings.map((entry) => entry.subjectId).sort()).toEqual(\n   187\t      [...fixture.turnIds].sort(),\n   188\t    );\n   189\t    for (const rendering of renderings) {\n   190\t      expect(rendering.state).toBe(\"ready\");\n   191\t      expect(rendering.content).toBeDefined();\n   192\t    }\n   193\t    // The fixture's pinned shape: 4 chunks, c1–c3 closed with both summary\n   194\t    // forms ready (the drain ran their close→summary enqueues to completion).\n   195\t    expect(fixture.chunks.chunks.map((chunk) => `${chunk.chunkId}:${chunk.status}`)).toEqual([\n   196\t      \"c1:closed\",\n   197\t      \"c2:closed\",\n   198\t      \"c3:closed\",\n   199\t      \"c4:open\",\n   200\t    ]);\n   201\t    for (const chunkId of [\"c1\", \"c2\", \"c3\"]) {\n   202\t      for (const form of [\"chunk_summary_detailed\", \"chunk_summary_brief\"]) {\n   203\t        const summary = report.value.find(\n   204\t          (entry) => entry.subjectId === chunkId && entry.form === form,\n   205\t        );\n   206\t        expect(summary?.state).toBe(\"ready\");\n   207\t      }\n   208\t    }\n   209\t  });\n   210\t\n   211\t  it(\"failed-transient and failed-permanent: the scripted subjects read back failed through messages.report\", async () => {\n   212\t    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n   213\t    expect(report.ok).toBe(true);\n   214\t    if (!report.ok) return;\n   215\t    const transient = report.value.find(\n   216\t      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n   217\t    );\n   218\t    expect(transient?.form).toBe(\"tool_result_summary\");\n   219\t    expect(transient?.state).toBe(\"failed\");\n   220\t    const permanent = report.value.find(\n   221\t      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n   222\t    );\n   223\t    expect(permanent?.form).toBe(\"tool_result_summary\");\n   224\t    expect(permanent?.state).toBe(\"failed\");\n   225\t    // Terminal failures left no live queue rows behind (DD-1): neither entry\n   226\t    // carries queue detail.\n   227\t    expect(transient?.queue).toBeUndefined();\n   228\t    expect(permanent?.queue).toBeUndefined();\n   229\t  });\n   230\t\n   231\t  it(\"blocked: real source damage on the sacrificial sibling lands the turn forms blocked\", async () => {\n   232\t    const sibling = await blockedSiblingThread(store);\n   233\t    const report = await turns.report({ filePath: sibling.filePath });\n   234\t    expect(report.ok).toBe(true);\n   235\t    if (!report.ok) return;\n   236\t    const blocked = report.value.filter(\n   237\t      (entry) => entry.subjectId === sibling.blockedTurnId && entry.state === \"blocked\",\n   238\t    );\n   239\t    expect(blocked.map((entry) => entry.form).sort()).toEqual([\n   240\t      \"lower_band_projection\",\n   241\t      \"turn_rendering\",\n   242\t    ]);\n   243\t    for (const entry of blocked) {\n   244\t      expect(entry.reason).toMatch(/^source_damaged: turn state corrupt/);\n   245\t    }\n   246\t  });\n   247\t});\n   248\t\n   249\tdescribe(\"FC-0.4: the two failed forms carry distinguishable reason classes (Story 3 dependency)\", () => {\n   250\t  it(\"transient exhaustion persists the final failure's reason class and its attempt count\", async () => {\n   251\t    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n   252\t    expect(report.ok).toBe(true);\n   253\t    if (!report.ok) return;\n   254\t    const transient = report.value.find(\n   255\t      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n   256\t    );\n   257\t    const permanent = report.value.find(\n   258\t      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n   259\t    );\n   260\t\n   261\t    // Not a bare retry-exhausted marker: the persisted reason is the final\n   262\t    // provider failure's, classifiable by the sweep's reason-code table.\n   263\t    expect(transient?.reason).toBe(TRANSIENT_EXHAUST_REASON);\n   264\t    expect(transient?.reason).toMatch(/^rate_limit:/);\n   265\t    expect(transient?.metadata?.attempts).toBe(3);\n   266\t    expect(transient?.metadata?.lastError).toBe(TRANSIENT_EXHAUST_REASON);\n   267\t\n   268\t    expect(permanent?.reason).toBe(PERMANENT_FAILURE_REASON);\n   269\t    expect(permanent?.reason).toMatch(/^content_refusal:/);\n   270\t    expect(permanent?.metadata?.attempts).toBe(1);\n   271\t\n   272\t    // The classes are distinguishable on read-back — attempt count is NOT\n   273\t    // the discriminator (it distinguishes retrying-vs-exhausted only).\n   274\t    expect(transient?.reason).not.toBe(permanent?.reason);\n   275\t  });\n   276\t});\n   277\t\n   278\tdescribe(\"FC-0.5: corruption and turnless-straggler variants\", () => {\n   279\t  it(\"the corruption variant refuses canonical consumption with state_corruption naming the damage\", async () => {\n   280\t    const corrupted = await corruptedVariantThread(store);\n   281\t    const refused = await corrupted.sdk.intakeStream.messageEvents({ filePath: corrupted.filePath }, [\n   282\t      validEvent(\"user_prompt\", { payload: { text: \"after the damage\" } }),\n   283\t    ]);\n   284\t    expect(refused.ok).toBe(false);\n   285\t    if (refused.ok) return;\n   286\t    expect(refused.error.errorClass).toBe(\"state_corruption\");\n   287\t    expect(refused.error.code).toBe(\"turn_state_corrupt\");\n   288\t    expect(refused.error.reason).toMatch(/open turns/);\n   289\t  });\n   290\t\n   291\t  it(\"the straggler variant carries turnId-null notes between two turns and after the last turn\", async () => {\n   292\t    const variant = await stragglerVariantThread(store);\n   293\t    const listed = await messages.listMessages({ filePath: variant.filePath });\n   294\t    const turnList = await turns.listTurns({ filePath: variant.filePath });\n   295\t    expect(listed.ok && turnList.ok).toBe(true);\n   296\t    if (!listed.ok || !turnList.ok) return;\n   297\t\n   298\t    const between = listed.value.find(\n   299\t      (message) => message.messageId === variant.stragglerBetweenMessageId,\n   300\t    );\n   301\t    const trailing = listed.value.find(\n   302\t      (message) => message.messageId === variant.stragglerTrailingMessageId,\n   303\t    );\n   304\t    expect(between?.kind).toBe(\"runtime_note\");\n   305\t    expect(between?.turnId).toBeUndefined();\n   306\t    expect(trailing?.kind).toBe(\"runtime_note\");\n   307\t    expect(trailing?.turnId).toBeUndefined();\n   308\t\n   309\t    // Between two turns: after t3 closed, before t4 opened — the selection\n   310\t    // rule 6 / G4 position.\n   311\t    const t3 = turnList.value.find((turn) => turn.turnId === \"t3\");\n   312\t    const t4 = turnList.value.find((turn) => turn.turnId === \"t4\");\n   313\t    expect(between!.sourceEventOrder).toBeGreaterThan(t3!.closedAtEventOrder!);\n   314\t    expect(between!.sourceEventOrder).toBeLessThan(t4!.openedAtEventOrder);\n   315\t\n   316\t    // After the last turn: beyond t12's close, with no turn following.\n   317\t    const t12 = turnList.value.find((turn) => turn.turnId === \"t12\");\n   318\t    expect(trailing!.sourceEventOrder).toBeGreaterThan(t12!.closedAtEventOrder!);\n   319\t    expect(Math.max(...listed.value.map((message) => message.sourceEventOrder))).toBe(\n   320\t      trailing!.sourceEventOrder,\n   321\t    );\n   322\t  });\n   323\t});\n   324\t\n   325\tdescribe(\"FC-0.6: the injection facility's two named points\", () => {\n   326\t  afterEach(() => {\n   327\t    setViewInjectionHook(\"post-commit-advance\", null);\n   328\t    setViewInjectionHook(\"compact-write\", null);\n   329\t  });\n   330\t\n   331\t  it(\"uninstalled, both points are no-ops\", () => {\n   332\t    expect(() => fireViewInjection(\"post-commit-advance\")).not.toThrow();\n   333\t    expect(() => fireViewInjection(\"compact-write\")).not.toThrow();\n   334\t  });\n   335\t\n   336\t  it(\"an installed hook fires at its point only, its throw propagates, and uninstalling restores the no-op\", () => {\n   337\t    const fired: string[] = [];\n   338\t    setViewInjectionHook(\"post-commit-advance\", () => {\n   339\t      fired.push(\"advance\");\n   340\t    });\n   341\t    fireViewInjection(\"post-commit-advance\");\n   342\t    fireViewInjection(\"compact-write\"); // other point stays a no-op\n   343\t    expect(fired).toEqual([\"advance\"]);\n   344\t\n   345\t    // Crash injection (TC-2.4 / TC-4.6's mechanism): a throwing hook's\n   346\t    // failure reaches the production call site.\n   347\t    setViewInjectionHook(\"compact-write\", () => {\n   348\t      throw new Error(\"injected crash between sweep and view write\");\n   349\t    });\n   350\t    expect(() => fireViewInjection(\"compact-write\")).toThrow(/injected crash/);\n   351\t\n   352\t    setViewInjectionHook(\"post-commit-advance\", null);\n   353\t    setViewInjectionHook(\"compact-write\", null);\n   354\t    fired.length = 0;\n   355\t    fireViewInjection(\"post-commit-advance\");\n   356\t    fireViewInjection(\"compact-write\");\n   357\t    expect(fired).toEqual([]);\n   358\t  });\n   359\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/view-seam.ts | sed -n '1,500p' && nl -ba packages/lhc/test/fixtures/view-thread.ts | sed -n '1,700p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/view-seam.ts | sed -n '1,500p' && nl -ba packages/lhc/test/fixtures/view-thread.ts | sed -n '1,700p'\"","aggregated_output":"     1\t// Epic 03 Story 0 view-domain test seams. Lives in fixtures/ — the one\n     2\t// directory sanctioned to reach below the SDK surface (boundary check\n     3\t// exempt).\n     4\t//\n     5\t// The injection facility (FC-0.6): re-export of the thread-view seam so\n     6\t// tests install crash/failure hooks at the two named points — the\n     7\t// post-commit advance (TC-4.6) and compact's write path between sweep and\n     8\t// view write (TC-2.4). Uninstalled, production fires are no-ops.\n     9\texport {\n    10\t  fireViewInjection,\n    11\t  setViewInjectionHook,\n    12\t  type ViewInjectionHook,\n    13\t  type ViewInjectionPoint,\n    14\t} from \"../../src/domains/thread-view/internal/seam.js\";\n    15\t\n    16\timport { DatabaseSync } from \"node:sqlite\";\n    17\t\n    18\t// Sanctioned below-SDK write (same sanctioning as corrupt.ts): seeds the\n    19\t// view_boundary row to an arbitrary position for TC-1.4's mid-tail pulls.\n    20\t// Boundary *mechanics* — how the position legally moves — are Story 4's to\n    21\t// prove; this helper only manufactures a position the pull must respect.\n    22\t// UPDATE-only on purpose: migration v6 seeded the singleton row, mirroring\n    23\t// the production advance's write shape.\n    24\texport function seedViewBoundary(filePath: string, position: number): void {\n    25\t  const db = new DatabaseSync(filePath);\n    26\t  try {\n    27\t    const changed = db\n    28\t      .prepare(\n    29\t        `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n    30\t      )\n    31\t      .run(position, new Date().toISOString());\n    32\t    if (Number(changed.changes) !== 1) {\n    33\t      throw new Error(\n    34\t        `fixture seedViewBoundary hit ${String(changed.changes)} rows; expected the migration-seeded singleton`,\n    35\t      );\n    36\t    }\n    37\t  } finally {\n    38\t    db.close();\n    39\t  }\n    40\t}\n     1\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n     2\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n     3\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n     4\t// deterministic provider double into known form states. States are reached\n     5\t// through production paths, never hand-written rows (the anti-shim line\n     6\t// FC-0.3 enforces): the failed states come from scripted provider failures\n     7\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\n     8\t// real source damage on a sacrificial sibling thread. Every later Epic 03\n     9\t// story compacts against what this builder returns.\n    10\timport {\n    11\t  createSdk,\n    12\t  type FormReportEntry,\n    13\t  type Lhc,\n    14\t  type MessageEventInput,\n    15\t} from \"../../src/index.js\";\n    16\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n    17\timport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\n    18\timport { readChunks, type ChunkSnapshot } from \"./threads.js\";\n    19\timport { validEvent, type TempStore } from \"./index.js\";\n    20\t\n    21\t// Reason classes the scripted failures stamp, chosen from the sweep\n    22\t// classification table's vocabulary (tech design §Spec Validation): a\n    23\t// rate-limit class reads transient, a content-refusal class reads permanent —\n    24\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n    25\t// Story 3 depends on it.\n    26\texport const TRANSIENT_EXHAUST_REASON =\n    27\t  \"rate_limit: scripted transient exhaustion (fixture)\";\n    28\texport const PERMANENT_FAILURE_REASON =\n    29\t  \"content_refusal: scripted permanent failure (fixture)\";\n    30\t\n    31\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n    32\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\n    33\t// deterministic double are near-constant in size (`projection(<digest>:<40\n    34\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\n    35\t// if drift ever moves it.\n    36\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n    37\t\n    38\tconst TURN_COUNT = 12;\n    39\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n    40\t\n    41\tfunction turnEvents(turn: number): MessageEventInput[] {\n    42\t  const events: MessageEventInput[] = [\n    43\t    validEvent(\"user_prompt\", {\n    44\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n    45\t    }),\n    46\t    validEvent(\"assistant_thinking\", {\n    47\t      payload: { text: `considering what area ${turn} contains` },\n    48\t    }),\n    49\t  ];\n    50\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n    51\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n    52\t    // realistic over-max zone of tool results to age behind the boundary.\n    53\t    for (const run of [1, 2]) {\n    54\t      const toolCallId = `call-fx-${turn}-${run}`;\n    55\t      events.push(\n    56\t        validEvent(\"tool_call\", {\n    57\t          payload: {\n    58\t            toolCallId,\n    59\t            toolName: \"read_file\",\n    60\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n    61\t          },\n    62\t        }),\n    63\t        validEvent(\"tool_result\", {\n    64\t          payload: {\n    65\t            toolCallId,\n    66\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n    67\t            isError: false,\n    68\t          },\n    69\t        }),\n    70\t      );\n    71\t    }\n    72\t  }\n    73\t  events.push(\n    74\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n    75\t    validEvent(\"turn_end\"),\n    76\t  );\n    77\t  return events;\n    78\t}\n    79\t\n    80\texport interface DerivedThreadFixture {\n    81\t  filePath: string;\n    82\t  sdk: Lhc;\n    83\t  double: ProviderDouble;\n    84\t  turnIds: string[]; // t1..t12\n    85\t  chunks: ChunkSnapshot;\n    86\t  // The two manufactured failed subjects (tool_result_summary forms), reached\n    87\t  // through real retry exhaustion / terminal failure — absent when failures\n    88\t  // are disabled for a variant.\n    89\t  failedTransientMessageId?: string;\n    90\t  failedPermanentMessageId?: string;\n    91\t  // The straggler variant's turnId-null messages: one between two turns, one\n    92\t  // after the last turn — absent unless stragglers are enabled.\n    93\t  stragglerBetweenMessageId?: string;\n    94\t  stragglerTrailingMessageId?: string;\n    95\t}\n    96\t\n    97\texport interface DerivedThreadOptions {\n    98\t  failures?: boolean; // default true: manufacture the two failed states\n    99\t  stragglers?: boolean; // default false: insert the turnless runtime notes\n   100\t}\n   101\t\n   102\tasync function send(\n   103\t  sdk: Lhc,\n   104\t  filePath: string,\n   105\t  batch: readonly MessageEventInput[],\n   106\t): Promise<string[]> {\n   107\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n   108\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n   109\t  return result.value.events.map((entry) => entry.messageId ?? \"\");\n   110\t}\n   111\t\n   112\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n   113\t  const report = await sdk.work.drain({ filePath });\n   114\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n   115\t  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n   116\t    throw new Error(\n   117\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n   118\t    );\n   119\t  }\n   120\t}\n   121\t\n   122\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n   123\t  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n   124\t}\n   125\t\n   126\texport async function derivedThreadFixture(\n   127\t  store: TempStore,\n   128\t  opts: DerivedThreadOptions = {},\n   129\t): Promise<DerivedThreadFixture> {\n   130\t  const failures = opts.failures ?? true;\n   131\t  const stragglers = opts.stragglers ?? false;\n   132\t\n   133\t  const double = createProviderDouble();\n   134\t  const sdk = createSdk({\n   135\t    provider: double,\n   136\t    mode: \"manual\",\n   137\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   138\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\n   139\t  });\n   140\t\n   141\t  const filePath = store.threadPath();\n   142\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   143\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   144\t\n   145\t  const turnIds: string[] = [];\n   146\t  const fixture: DerivedThreadFixture = {\n   147\t    filePath,\n   148\t    sdk,\n   149\t    double,\n   150\t    turnIds,\n   151\t    chunks: { chunks: [], members: [] },\n   152\t  };\n   153\t\n   154\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n   155\t    if (failures && turn === 6) {\n   156\t      // Retryable failures consumed to exhaustion by the head-first drain:\n   157\t      // the first tool_result_summary item of this batch takes all three\n   158\t      // attempts and lands failed with the transient reason class.\n   159\t      double.failKind(\"tool_result_summary\", 3, {\n   160\t        retryable: true,\n   161\t        reason: TRANSIENT_EXHAUST_REASON,\n   162\t      });\n   163\t    }\n   164\t    if (failures && turn === 7) {\n   165\t      // One non-retryable failure: terminal on the first attempt — the\n   166\t      // permanent reason class, attempts 1.\n   167\t      double.failKind(\"tool_result_summary\", 1, {\n   168\t        retryable: false,\n   169\t        reason: PERMANENT_FAILURE_REASON,\n   170\t      });\n   171\t    }\n   172\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\n   173\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n   174\t    // result, call, result, text, end — index 3 is the first tool result,\n   175\t    // the scripted failures' subject.\n   176\t    const firstToolResultId = messageIds[3];\n   177\t    if (failures && (turn === 6 || turn === 7)) {\n   178\t      if (firstToolResultId === undefined || firstToolResultId === \"\") {\n   179\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\n   180\t      }\n   181\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\n   182\t      else fixture.failedPermanentMessageId = firstToolResultId;\n   183\t    }\n   184\t    await drain(sdk, filePath);\n   185\t\n   186\t    if (stragglers && turn === 3) {\n   187\t      // A runtime note between turn 3's end and turn 4's prompt: projected\n   188\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\n   189\t      const noteIds = await send(sdk, filePath, [\n   190\t        validEvent(\"runtime_note\", {\n   191\t          payload: { text: \"harness restarted between turns (fixture straggler)\" },\n   192\t        }),\n   193\t      ]);\n   194\t      const noteId = noteIds[0];\n   195\t      if (noteId === undefined || noteId === \"\") {\n   196\t        throw new Error(\"fixture invariant: between-turns straggler did not project\");\n   197\t      }\n   198\t      fixture.stragglerBetweenMessageId = noteId;\n   199\t    }\n   200\t    turnIds.push(`t${turn}`);\n   201\t  }\n   202\t\n   203\t  if (stragglers) {\n   204\t    const noteIds = await send(sdk, filePath, [\n   205\t      validEvent(\"runtime_note\", {\n   206\t        payload: { text: \"session closing note after the last turn (fixture straggler)\" },\n   207\t      }),\n   208\t    ]);\n   209\t    const noteId = noteIds[0];\n   210\t    if (noteId === undefined || noteId === \"\") {\n   211\t      throw new Error(\"fixture invariant: trailing straggler did not project\");\n   212\t    }\n   213\t    fixture.stragglerTrailingMessageId = noteId;\n   214\t    await drain(sdk, filePath);\n   215\t  }\n   216\t\n   217\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\n   218\t  // chunks, the first three closed. A failure here means the deterministic\n   219\t  // substrate moved (provider output or tokenizer), not a flaky test.\n   220\t  fixture.chunks = readChunks(filePath);\n   221\t  if (fixture.chunks.chunks.length !== 4) {\n   222\t    throw new Error(\n   223\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\n   224\t    );\n   225\t  }\n   226\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \"closed\").length;\n   227\t  if (closed !== 3) {\n   228\t    throw new Error(\n   229\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\n   230\t    );\n   231\t  }\n   232\t\n   233\t  if (failures) {\n   234\t    // Verify the manufactured states by read-back through the owning report\n   235\t    // surface before handing the fixture to any test (FC-0.3's enforcement\n   236\t    // lives in the tests; this guards the builder's own contract).\n   237\t    const report = await sdk.messages.report({ filePath });\n   238\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\n   239\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\n   240\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\n   241\t    if (\n   242\t      transient.length !== 1 ||\n   243\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\n   244\t      permanent.length !== 1 ||\n   245\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\n   246\t    ) {\n   247\t      throw new Error(\n   248\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\n   249\t      );\n   250\t    }\n   251\t  }\n   252\t\n   253\t  return fixture;\n   254\t}\n   255\t\n   256\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\n   257\t// conversation with a runtime note between two turns and one after the last\n   258\t// turn, fully drained, no manufactured failures.\n   259\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\n   260\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\n   261\t}\n   262\t\n   263\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\n   264\t// short real conversation, drained clean, then damaged below the SDK into\n   265\t// the two-open-turns state no public operation can produce. Canonical\n   266\t// consumers refuse it with state_corruption.\n   267\texport async function corruptedVariantThread(\n   268\t  store: TempStore,\n   269\t): Promise<{ filePath: string; sdk: Lhc }> {\n   270\t  const double = createProviderDouble();\n   271\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n   272\t  const filePath = store.threadPath();\n   273\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   274\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   275\t  for (let turn = 1; turn <= 3; turn += 1) {\n   276\t    await send(sdk, filePath, turnEvents(turn));\n   277\t  }\n   278\t  await drain(sdk, filePath);\n   279\t  // Open a turn through real intake, then add a second open row: two open\n   280\t  // turns, the Epic 01 invariant violation.\n   281\t  await send(sdk, filePath, [\n   282\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n   283\t  ]);\n   284\t  corruptTwoOpenTurns(filePath);\n   285\t  return { filePath, sdk };\n   286\t}\n   287\t\n   288\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\n   289\t// queued derivation meets real source damage at drain time — the handler\n   290\t// finds two open turns and lands the turn forms blocked through the\n   291\t// production terminal path, never a hand-written row.\n   292\texport async function blockedSiblingThread(\n   293\t  store: TempStore,\n   294\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\n   295\t  const double = createProviderDouble();\n   296\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n   297\t  const filePath = store.threadPath();\n   298\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   299\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   300\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\n   301\t  // real intake; the corruption writer adds another open row. The drain then\n   302\t  // claims t1's derivation against a record with two open turns.\n   303\t  await send(sdk, filePath, turnEvents(1));\n   304\t  await send(sdk, filePath, [\n   305\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n   306\t  ]);\n   307\t  corruptTwoOpenTurns(filePath);\n   308\t  const report = await sdk.work.drain({ filePath });\n   309\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n   310\t  const blocked = report.value.ran.find(\n   311\t    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n   312\t  );\n   313\t  if (blocked === undefined) {\n   314\t    throw new Error(\"fixture invariant: turn_derivation expected to land terminal on damage\");\n   315\t  }\n   316\t  return { filePath, sdk, blockedTurnId: \"t1\" };\n   317\t}\n","exit_code":0,"status":"completed"}}

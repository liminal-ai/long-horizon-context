{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '250,285p' && nl -ba packages/lhc/src/domains/messages/internal/forms.ts | sed -n '133,230p'\"","aggregated_output":"   250\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   251\t  } finally {\n   252\t    db.close();\n   253\t  }\n   254\t}\n   255\t\n   256\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   257\t\n   258\t// This owner's repair report: every message-owned form's durable state\n   259\t// joined with live queue detail in one query — the five operational\n   260\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n   261\t// without any queue API. Needs no provider; reads degrade, never block.\n   262\texport async function report(\n   263\t  thread: ThreadRef,\n   264\t  opts?: { notReady?: boolean; messageId?: string },\n   265\t): Promise<OpResult<FormReportEntry[]>> {\n   266\t  const resolved = await resolveThreadRef(thread);\n   267\t  if (!resolved.ok) return resolved;\n   268\t  const { filePath } = resolved.value;\n   269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   270\t\n   271\t  const opened = openThreadDatabase(filePath);\n   272\t  if (!opened.ok) return opened;\n   273\t  const db = opened.value;\n   274\t  try {\n   275\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n   276\t  } catch (cause) {\n   277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   278\t    return storageFailure(`report read failed: ${reason}`);\n   279\t  } finally {\n   280\t    db.close();\n   281\t  }\n   282\t}\n   283\t\n   284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   285\t\n   133\t): FormReportEntry[] {\n   134\t  const conditions = [\"df.subject_kind = 'message'\"];\n   135\t  const params: string[] = [];\n   136\t  if (opts.messageId !== undefined) {\n   137\t    conditions.push(\"df.subject_id = ?\");\n   138\t    params.push(opts.messageId);\n   139\t  }\n   140\t  // notReady is exact set equality by construction: every state but ready.\n   141\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   142\t  const rows = db\n   143\t    .prepare(\n   144\t      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\n   145\t              df.source_version, df.gaps, df.derived_at,\n   146\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   147\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   148\t       FROM derived_form df\n   149\t       LEFT JOIN work_item w\n   150\t         ON w.status IN ('queued', 'claimed')\n   151\t        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\n   152\t        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n   153\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   154\t       WHERE ${conditions.join(\" AND \")}\n   155\t       ORDER BY df.subject_id, df.form`,\n   156\t    )\n   157\t    .all(...params) as unknown as RawReportRow[];\n   158\t  return rows.map((row) => reportEntryFromRow(\"message\", row));\n   159\t}\n   160\t\n   161\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n   162\t// ever repeated; in a well-formed record the pair is unique. Deleted messages\n   163\t// are excluded (tech-design §Mechanics' deleted-read rule, epic-fix-001):\n   164\t// composition inputs and derivation reads never see deleted records, so a\n   165\t// tool_call whose paired result has been deleted reads no pair and derives\n   166\t// outcome `unknown` — never the dead result's outcome.\n   167\tfunction findPairedBlock(\n   168\t  db: DatabaseSync,\n   169\t  blockType: \"tool_call\" | \"tool_result\",\n   170\t  toolCallId: string,\n   171\t): Record<string, unknown> | undefined {\n   172\t  const row = db\n   173\t    .prepare(\n   174\t      `SELECT b.content FROM message_block b\n   175\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n   176\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n   177\t       ORDER BY m.source_event_order LIMIT 1`,\n   178\t    )\n   179\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n   180\t  if (row === undefined) return undefined;\n   181\t  return JSON.parse(row.content) as Record<string, unknown>;\n   182\t}\n   183\t\n   184\texport function findPairedToolResult(\n   185\t  db: DatabaseSync,\n   186\t  toolCallId: string,\n   187\t): { content: string; isError: boolean } | undefined {\n   188\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n   189\t  if (block === undefined) return undefined;\n   190\t  return {\n   191\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n   192\t    isError: block[\"isError\"] === true,\n   193\t  };\n   194\t}\n   195\t\n   196\texport function findPairedToolCall(\n   197\t  db: DatabaseSync,\n   198\t  toolCallId: string,\n   199\t): { toolName: string } | undefined {\n   200\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n   201\t  if (block === undefined) return undefined;\n   202\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n   203\t}\n   204\t\n   205\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n   206\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n   207\t// common case — call and result in one batch, summary not yet run — never\n   208\t// triggers a requeue. Returns the call's message id and the form's current\n   209\t// source version (the requeue enqueues at version + 1: the pair is the\n   210\t// summary's source, and a source completing follows clear-and-regenerate).\n   211\texport function findUnknownOutcomeCallSummary(\n   212\t  db: DatabaseSync,\n   213\t  toolCallId: string,\n   214\t): { messageId: string; sourceVersion: number } | undefined {\n   215\t  const row = db\n   216\t    .prepare(\n   217\t      `SELECT df.subject_id, df.source_version FROM message_block b\n   218\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\n   219\t       JOIN derived_form df ON df.subject_kind = 'message'\n   220\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n   221\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n   222\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n   223\t       LIMIT 1`,\n   224\t    )\n   225\t    .get(toolCallId) as unknown as\n   226\t    | { subject_id: string; source_version: number | bigint }\n   227\t    | undefined;\n   228\t  if (row === undefined) return undefined;\n   229\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n   230\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-select-golden.test.ts | sed -n '185,285p'\"","aggregated_output":"   185\t// ── Boundary G1 (Story 4, architecture-risk): the trajectory golden ─────\n   186\t//\n   187\t// Committed expected positions after each scripted batch — floor/target\n   188\t// arithmetic off-by-ones survive property tests, not goldens. The expected\n   189\t// values were hand-derived from the design rules (tech design §Boundary\n   190\t// advance) before implementation: contents are n joined \"tok\" words (exactly\n   191\t// n o200k tokens each), so every sum in the golden is checkable by hand.\n   192\t// Every advance fires through a real intake commit; positions and zone sums\n   193\t// read back through real pull/status calls (no test-only advance surface).\n   194\t\n   195\tinterface BoundaryGolden {\n   196\t  case: string;\n   197\t  budgets: { maxTokens: number; targetTokens: number; floorTokens: number };\n   198\t  batches: Array<{\n   199\t    label: string;\n   200\t    resultTokens: number[];\n   201\t    turnEnd: boolean;\n   202\t    expectedPosition: number;\n   203\t    expectedZoneTokens: number;\n   204\t  }>;\n   205\t}\n   206\t\n   207\tfunction trajectoryTokens(n: number): string {\n   208\t  return Array<string>(n).fill(\"tok\").join(\" \");\n   209\t}\n   210\t\n   211\tlet trajectoryCallCounter = 0;\n   212\t\n   213\tfunction trajectoryBatch(batch: BoundaryGolden[\"batches\"][number]): MessageEventInput[] {\n   214\t  const events: MessageEventInput[] = [\n   215\t    validEvent(\"user_prompt\", { payload: { text: \"trajectory prompt\" } }),\n   216\t  ];\n   217\t  for (const n of batch.resultTokens) {\n   218\t    trajectoryCallCounter += 1;\n   219\t    const toolCallId = `call-g1b-${trajectoryCallCounter}`;\n   220\t    events.push(\n   221\t      validEvent(\"tool_call\", {\n   222\t        payload: { toolCallId, toolName: \"read_file\", arguments: { path: `g1b-${trajectoryCallCounter}.txt` } },\n   223\t      }),\n   224\t      validEvent(\"tool_result\", {\n   225\t        payload: { toolCallId, content: trajectoryTokens(n), isError: false },\n   226\t      }),\n   227\t    );\n   228\t  }\n   229\t  if (batch.turnEnd) events.push(validEvent(\"turn_end\"));\n   230\t  return events;\n   231\t}\n   232\t\n   233\t// One full replay of the golden's script against a fresh thread: the\n   234\t// committed positions and zone sums after each batch.\n   235\tasync function replayTrajectory(\n   236\t  golden: BoundaryGolden,\n   237\t): Promise<Array<{ position: number; zoneTokens: number }>> {\n   238\t  const sdk = createSdk({\n   239\t    provider: createProviderDouble(),\n   240\t    mode: \"manual\",\n   241\t    view: { visibility: golden.budgets },\n   242\t  });\n   243\t  const filePath = store.threadPath();\n   244\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   245\t  if (!created.ok) throw new Error(`trajectory thread creation failed: ${created.error.reason}`);\n   246\t\n   247\t  const observed: Array<{ position: number; zoneTokens: number }> = [];\n   248\t  for (const batch of golden.batches) {\n   249\t    const result = await sdk.intakeStream.messageEvents({ filePath }, trajectoryBatch(batch));\n   250\t    if (!result.ok) throw new Error(`trajectory intake failed: ${result.error.reason}`);\n   251\t    const pulled = await sdk.threadView.pull({ filePath });\n   252\t    const status = await sdk.threadView.status({ filePath });\n   253\t    if (!pulled.ok || !status.ok) throw new Error(\"trajectory read-back failed\");\n   254\t    observed.push({\n   255\t      position: pulled.value.meta.boundaryPosition,\n   256\t      zoneTokens: status.value.visibility.zoneTokens,\n   257\t    });\n   258\t  }\n   259\t  return observed;\n   260\t}\n   261\t\n   262\tdescribe(\"Boundary G1 (committed JSON): the advance trajectory, floor legs included\", () => {\n   263\t  it(\"matches the committed positions and zone sums after every scripted batch\", async () => {\n   264\t    const golden = JSON.parse(\n   265\t      readFileSync(join(import.meta.dirname, \"goldens\", \"boundary-g1-trajectory.json\"), \"utf8\"),\n   266\t    ) as BoundaryGolden;\n   267\t    const observed = await replayTrajectory(golden);\n   268\t    if (process.env[\"GOLDEN_DUMP\"] === \"1\") {\n   269\t      console.log(`${golden.case}\\n${JSON.stringify(observed, null, 2)}`);\n   270\t    }\n   271\t    expect(observed).toEqual(\n   272\t      golden.batches.map((batch) => ({\n   273\t        position: batch.expectedPosition,\n   274\t        zoneTokens: batch.expectedZoneTokens,\n   275\t      })),\n   276\t    );\n   277\t\n   278\t    // TC-4.5 (AC-4.4) replay equality: the same record and budgets on a\n   279\t    // second fresh thread produce the same boundary trajectory.\n   280\t    expect(await replayTrajectory(golden)).toEqual(observed);\n   281\t  });\n   282\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-boundary.test.ts | sed -n '110,520p'\"","aggregated_output":"   110\t    .length;\n   111\t}\n   112\t\n   113\tdescribe(\"TC-4.1 (AC-4.3): under-max batches never move the boundary; the crossing batch moves once to target, oldest-first\", () => {\n   114\t  it(\"holds position and bytes below max, then flips exactly one oldest-first batch of results\", async () => {\n   115\t    const sdk = visSdk();\n   116\t    const filePath = await newThread(sdk);\n   117\t\n   118\t    // Two under-max batches (zone 40, then 80 ≤ max 100): boundary unmoved.\n   119\t    await intake(sdk, filePath, toolTurn([20, 20]));\n   120\t    const afterFirst = await sdk.threadView.pull({ filePath });\n   121\t    expect(afterFirst.ok).toBe(true);\n   122\t    if (!afterFirst.ok) return;\n   123\t    expect(afterFirst.value.meta.boundaryPosition).toBe(0);\n   124\t\n   125\t    await intake(sdk, filePath, toolTurn([20, 20]));\n   126\t    const afterSecond = await sdk.threadView.pull({ filePath });\n   127\t    expect(afterSecond.ok).toBe(true);\n   128\t    if (!afterSecond.ok) return;\n   129\t    expect(afterSecond.value.meta.boundaryPosition).toBe(0);\n   130\t    // Rendered bytes do not change below max: the earlier pull's messages are\n   131\t    // a byte-identical prefix of the later one (AC-4.3's no-churn half).\n   132\t    expect(afterSecond.value.messages.slice(0, afterFirst.value.messages.length)).toEqual(\n   133\t      afterFirst.value.messages,\n   134\t    );\n   135\t    expect(abridgedCount(afterSecond.value.messages)).toBe(0);\n   136\t\n   137\t    // The crossing batch (zone 120 > 100): one advance to target — the three\n   138\t    // oldest results flip (120→100→80→60 = target), the newer three stay\n   139\t    // full; the protected set (newest joined to 40 ≥ floor 30) is untouched.\n   140\t    await intake(sdk, filePath, toolTurn([20, 20]));\n   141\t    const results = await toolResults(sdk, filePath);\n   142\t    expect(results).toHaveLength(6);\n   143\t    const expectedPosition = results[2]?.sourceEventOrder;\n   144\t    const crossed = await sdk.threadView.pull({ filePath });\n   145\t    expect(crossed.ok).toBe(true);\n   146\t    if (!crossed.ok) return;\n   147\t    expect(crossed.value.meta.boundaryPosition).toBe(expectedPosition);\n   148\t    expect(abridgedCount(crossed.value.messages)).toBe(3);\n   149\t\n   150\t    // Oldest-first: precisely the first three results render abridged.\n   151\t    const abridgedIds = results\n   152\t      .filter((r) => r.sourceEventOrder <= (expectedPosition ?? 0))\n   153\t      .map((r) => r.messageId);\n   154\t    expect(abridgedIds).toEqual(results.slice(0, 3).map((r) => r.messageId));\n   155\t\n   156\t    // DoD: status's zone sum equals the advance's decision sum on the same\n   157\t    // state — the live tool-result estimates ahead of the boundary.\n   158\t    const status = await sdk.threadView.status({ filePath });\n   159\t    expect(status.ok).toBe(true);\n   160\t    if (!status.ok) return;\n   161\t    const expectedZone = results\n   162\t      .filter((r) => r.sourceEventOrder > (expectedPosition ?? 0))\n   163\t      .reduce((sum, r) => sum + r.tokenEstimate, 0);\n   164\t    expect(status.value.visibility.zoneTokens).toBe(expectedZone);\n   165\t    expect(status.value.visibility.zoneTokens).toBe(60);\n   166\t\n   167\t    // The next under-max batch (zone 70 ≤ 100): no movement.\n   168\t    await intake(sdk, filePath, toolTurn([10]));\n   169\t    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);\n   170\t  });\n   171\t});\n   172\t\n   173\tdescribe(\"TC-4.2 (AC-4.1, AC-4.2): flipped renders — summary when usable, deterministic truncation with marker when not; non-tool content untouched\", () => {\n   174\t  it(\"renders the ready summary, the truncation rung for the failed summary, and the interleaved assistant text full\", async () => {\n   175\t    const double = createProviderDouble();\n   176\t    const sdk = createSdk({ provider: double, mode: \"manual\", view: { visibility: BUDGETS } });\n   177\t    const filePath = await newThread(sdk);\n   178\t\n   179\t    // r1 (60 tokens, 239 chars — over the 200-char abbreviation limit) will\n   180\t    // have its summary FAIL terminally; r2 (20 tokens) drains a ready\n   181\t    // summary; an assistant message sits between them.\n   182\t    await intake(sdk, filePath, [\n   183\t      validEvent(\"user_prompt\", { payload: { text: \"flip rendering prompt\" } }),\n   184\t      ...toolRun(60),\n   185\t      validEvent(\"assistant_text\", { payload: { text: \"interleaved assistant text\" } }),\n   186\t      ...toolRun(20),\n   187\t      validEvent(\"turn_end\"),\n   188\t    ]);\n   189\t    // First tool_result_summary execution fails non-retryably (r1's — queue\n   190\t    // order is walk order); r2's succeeds. Real drain, production paths.\n   191\t    double.failKind(\"tool_result_summary\", 1, {\n   192\t      retryable: false,\n   193\t      reason: \"content_refusal: scripted permanent failure (boundary test)\",\n   194\t    });\n   195\t    const drained = await sdk.work.drain({ filePath });\n   196\t    expect(drained.ok).toBe(true);\n   197\t\n   198\t    const listed = await sdk.messages.listMessages({ filePath });\n   199\t    expect(listed.ok).toBe(true);\n   200\t    if (!listed.ok) return;\n   201\t    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n   202\t    const [r1, r2] = results;\n   203\t    expect(r1 && r2).toBeTruthy();\n   204\t    if (r1 === undefined || r2 === undefined) return;\n   205\t    expect(\n   206\t      r1.forms?.find((f) => f.form === \"tool_result_summary\")?.state,\n   207\t    ).toBe(\"failed\");\n   208\t    const r2Summary = r2.forms?.find(\n   209\t      (f) => f.form === \"tool_result_summary\" && f.state === \"ready\",\n   210\t    )?.content;\n   211\t    expect(r2Summary).toBeDefined();\n   212\t\n   213\t    // The crossing batch: an 80-token result (zone 60+20+80 = 160 > max).\n   214\t    // Flips r1 and r2 (160→100→80); the newest is protected alone (≥ floor).\n   215\t    await intake(sdk, filePath, toolTurn([80]));\n   216\t    expect(await boundaryOf(sdk, filePath)).toBe(r2.sourceEventOrder);\n   217\t\n   218\t    const pulled = await sdk.threadView.pull({ filePath });\n   219\t    expect(pulled.ok).toBe(true);\n   220\t    if (!pulled.ok) return;\n   221\t    const contents = pulled.value.messages.map((m) => m.content);\n   222\t\n   223\t    // r1: failed summary ⇒ deterministic truncation rung — fixed 200-char\n   224\t    // prefix, exact dropped-count marker, abridged marker, record pointer.\n   225\t    expect(contents).toContain(\n   226\t      `[tool result · read_file · abridged]\\n${tokens(60).slice(0, 200)}… [truncated 39 chars] [full content in record §${r1.messageId}]`,\n   227\t    );\n   228\t    // r2: usable summary ⇒ the summary verbatim.\n   229\t    expect(contents).toContain(\n   230\t      `[tool result · read_file · abridged]\\n${r2Summary} [full content in record §${r2.messageId}]`,\n   231\t    );\n   232\t    // The interleaved assistant message renders full — non-tool-result\n   233\t    // content is never affected by the boundary (AC-4.1).\n   234\t    expect(contents).toContain(\"interleaved assistant text\");\n   235\t    // The newest (protected) result renders full.\n   236\t    expect(contents).toContain(`[tool result · read_file]\\n${tokens(80)}`);\n   237\t  });\n   238\t});\n   239\t\n   240\tdescribe(\"TC-4.3 (AC-4.5): monster turn — the advance enters the open turn but stops at the whole-message protected set\", () => {\n   241\t  it(\"flips into the open turn, keeps the newest whole results (joined ≥ floor) full, and leaves the turn's text full\", async () => {\n   242\t    const sdk = visSdk();\n   243\t    const filePath = await newThread(sdk);\n   244\t    // One small closed turn, then one open turn whose tool results alone\n   245\t    // cross max: zone 20+40+40+40+25 = 165 > 100.\n   246\t    await intake(sdk, filePath, toolTurn([20]));\n   247\t    await intake(sdk, filePath, [\n   248\t      validEvent(\"user_prompt\", { payload: { text: \"monster prompt\" } }),\n   249\t      validEvent(\"assistant_thinking\", { payload: { text: \"monster thought\" } }),\n   250\t      ...toolRun(40),\n   251\t      ...toolRun(40),\n   252\t      ...toolRun(40),\n   253\t      ...toolRun(25),\n   254\t      validEvent(\"assistant_text\", { payload: { text: \"monster narration\" } }),\n   255\t      // No turn_end: the turn stays open.\n   256\t    ]);\n   257\t\n   258\t    const results = await toolResults(sdk, filePath);\n   259\t    expect(results).toHaveLength(5);\n   260\t    // Protected set, newest-backward joined to ≥ floor 30: m4 (25) alone is\n   261\t    // under the floor, so m3 joins (65) — whole messages, never a partial.\n   262\t    // Flips stop there with the zone at 65, legally above target 60.\n   263\t    const expectedPosition = results[2]?.sourceEventOrder; // m2: inside the open turn\n   264\t    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);\n   265\t\n   266\t    const pulled = await sdk.threadView.pull({ filePath });\n   267\t    expect(pulled.ok).toBe(true);\n   268\t    if (!pulled.ok) return;\n   269\t    const contents = pulled.value.messages.map((m) => m.content);\n   270\t    expect(abridgedCount(pulled.value.messages)).toBe(3); // r0, m1, m2\n   271\t    // The protected newest results render full.\n   272\t    expect(contents).toContain(`[tool result · read_file]\\n${tokens(40)}`);\n   273\t    expect(contents).toContain(`[tool result · read_file]\\n${tokens(25)}`);\n   274\t    // The turn's own text messages all render full.\n   275\t    expect(contents).toContain(\"monster prompt\");\n   276\t    expect(contents).toContain(\"[thinking]\\nmonster thought\\n[/thinking]\");\n   277\t    expect(contents).toContain(\"monster narration\");\n   278\t\n   279\t    const status = await sdk.threadView.status({ filePath });\n   280\t    expect(status.ok).toBe(true);\n   281\t    if (!status.ok) return;\n   282\t    expect(status.value.visibility.zoneTokens).toBe(65);\n   283\t  });\n   284\t\n   285\t  it(\"oversized-newest leg: a single result larger than the floor is protected alone; the zone legally sits above target\", async () => {\n   286\t    const sdk = visSdk();\n   287\t    const filePath = await newThread(sdk);\n   288\t    await intake(sdk, filePath, toolTurn([20]));\n   289\t    // Open turn: 40 + 40 + 80; zone 180 > max. The newest (80) exceeds the\n   290\t    // floor by itself and is protected alone (AC-4.5).\n   291\t    await intake(sdk, filePath, [\n   292\t      validEvent(\"user_prompt\", { payload: { text: \"oversized prompt\" } }),\n   293\t      ...toolRun(40),\n   294\t      ...toolRun(40),\n   295\t      ...toolRun(80),\n   296\t    ]);\n   297\t    const results = await toolResults(sdk, filePath);\n   298\t    expect(results).toHaveLength(4);\n   299\t    expect(await boundaryOf(sdk, filePath)).toBe(results[2]?.sourceEventOrder);\n   300\t\n   301\t    const pulled = await sdk.threadView.pull({ filePath });\n   302\t    expect(pulled.ok).toBe(true);\n   303\t    if (!pulled.ok) return;\n   304\t    // The oversized newest renders full; everything older flipped.\n   305\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\n   306\t      `[tool result · read_file]\\n${tokens(80)}`,\n   307\t    );\n   308\t    expect(abridgedCount(pulled.value.messages)).toBe(3);\n   309\t\n   310\t    const status = await sdk.threadView.status({ filePath });\n   311\t    expect(status.ok).toBe(true);\n   312\t    if (!status.ok) return;\n   313\t    expect(status.value.visibility.zoneTokens).toBe(80); // above target until room appears\n   314\t  });\n   315\t});\n   316\t\n   317\tdescribe(\"TC-4.4 (AC-4.6, AC-4.7): never backward within a window; compact resets to the compact point\", () => {\n   318\t  it(\"keeps flipped results flipped across small batches, then resets to the compact point with a full fresh tail\", async () => {\n   319\t    const sdk = visSdk();\n   320\t    const filePath = await newThread(sdk);\n   321\t    for (let i = 0; i < 3; i += 1) await intake(sdk, filePath, toolTurn([20, 20]));\n   322\t    const results = await toolResults(sdk, filePath);\n   323\t    const advanced = results[2]?.sourceEventOrder ?? 0;\n   324\t    expect(await boundaryOf(sdk, filePath)).toBe(advanced);\n   325\t\n   326\t    // Small tool-free batches: no backward motion, flipped stay flipped.\n   327\t    for (let i = 0; i < 2; i += 1) {\n   328\t      await intake(sdk, filePath, [\n   329\t        validEvent(\"user_prompt\", { payload: { text: `small batch ${i}` } }),\n   330\t        validEvent(\"assistant_text\", { payload: { text: `small answer ${i}` } }),\n   331\t        validEvent(\"turn_end\"),\n   332\t      ]);\n   333\t      const pulled = await sdk.threadView.pull({ filePath });\n   334\t      expect(pulled.ok).toBe(true);\n   335\t      if (!pulled.ok) return;\n   336\t      expect(pulled.value.meta.boundaryPosition).toBe(advanced);\n   337\t      expect(abridgedCount(pulled.value.messages)).toBe(3);\n   338\t    }\n   339\t\n   340\t    // Compact: the boundary resets to the compact point (AC-4.7 — the reset\n   341\t    // transaction landed in Story 2; this proves it end-to-end against a\n   342\t    // boundary the production advance moved).\n   343\t    const receipt = await sdk.threadView.compact(\n   344\t      { filePath },\n   345\t      { params: { lowerBound: 40 }, sweep: false },\n   346\t    );\n   347\t    expect(receipt.ok).toBe(true);\n   348\t    if (!receipt.ok) return;\n   349\t    const afterCompact = await sdk.threadView.pull({ filePath });\n   350\t    expect(afterCompact.ok).toBe(true);\n   351\t    if (!afterCompact.ok) return;\n   352\t    expect(afterCompact.value.meta.compactPoint).toBe(receipt.value.compactPoint);\n   353\t    expect(afterCompact.value.meta.boundaryPosition).toBe(receipt.value.compactPoint);\n   354\t\n   355\t    // Fresh tail renders full: a new under-max tool result is not abridged.\n   356\t    await intake(sdk, filePath, toolTurn([20]));\n   357\t    const fresh = await sdk.threadView.pull({ filePath });\n   358\t    expect(fresh.ok).toBe(true);\n   359\t    if (!fresh.ok) return;\n   360\t    const tail = fresh.value.messages.filter((m) => m.band === undefined);\n   361\t    expect(abridgedCount(tail)).toBe(0);\n   362\t    expect(tail.map((m) => m.content)).toContain(`[tool result · read_file]\\n${tokens(20)}`);\n   363\t  });\n   364\t});\n   365\t\n   366\tdescribe(\"TC-4.5 (AC-4.8): budget validation names the violated constraint (replay equality lives in the Boundary G1 golden)\", () => {\n   367\t  it(\"rejects max ≤ target at construction, naming the constraint\", () => {\n   368\t    expect(() =>\n   369\t      visSdk({ visibility: { maxTokens: 100, targetTokens: 200, floorTokens: 50 } }),\n   370\t    ).toThrow(/maxTokens \\(100\\) must be greater than targetTokens \\(200\\)/);\n   371\t  });\n   372\t\n   373\t  it(\"rejects target < floor at construction, naming the constraint\", () => {\n   374\t    expect(() =>\n   375\t      visSdk({ visibility: { maxTokens: 300, targetTokens: 100, floorTokens: 200 } }),\n   376\t    ).toThrow(/targetTokens \\(100\\) must be at least floorTokens \\(200\\)/);\n   377\t  });\n   378\t});\n   379\t\n   380\tdescribe(\"TC-4.6 (AC-4.9): a failed advance leaves intake intact and the condition visible; the next batch heals — and the poke still fires\", () => {\n   381\t  it(\"background mode: intake succeeds, boundary holds, status shows over-max, the drain still ran; cleared, the next batch lands at target\", async () => {\n   382\t    const sdk = visSdk({ visibility: BUDGETS }, \"background\");\n   383\t    const filePath = await newThread(sdk);\n   384\t\n   385\t    // The Story-0 facility's named post-commit point — not a mock of\n   386\t    // boundary.ts: an installed throw stands in for an advance failure.\n   387\t    let fired = 0;\n   388\t    setViewInjectionHook(\"post-commit-advance\", () => {\n   389\t      fired += 1;\n   390\t      throw new Error(\"injected advance failure\");\n   391\t    });\n   392\t\n   393\t    // One crossing batch: zone 120 > max 100.\n   394\t    const result = await sdk.intakeStream.messageEvents({ filePath }, toolTurn([40, 40, 40]));\n   395\t    expect(result.ok).toBe(true); // intake's outcome never depends on the advance\n   396\t    if (!result.ok) return;\n   397\t    expect(result.value.events.every((e) => e.outcome === \"recorded\")).toBe(true);\n   398\t    expect(fired).toBe(1);\n   399\t\n   400\t    // All messages committed; boundary unchanged; the over-budget condition\n   401\t    // is visible in status — computed live, the same sum the advance reads.\n   402\t    const results = await toolResults(sdk, filePath);\n   403\t    expect(results).toHaveLength(3);\n   404\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n   405\t    const status = await sdk.threadView.status({ filePath });\n   406\t    expect(status.ok).toBe(true);\n   407\t    if (!status.ok) return;\n   408\t    expect(status.value.visibility.zoneTokens).toBe(120);\n   409\t    expect(status.value.visibility.zoneTokens).toBeGreaterThan(status.value.visibility.maxTokens);\n   410\t\n   411\t    // Seam isolation, direction one: the throwing advance never ate the queue\n   412\t    // poke — the background drain ran and the summaries landed ready.\n   413\t    await sdk.drainSettled({ filePath });\n   414\t    const listed = await sdk.messages.listMessages({ filePath });\n   415\t    expect(listed.ok).toBe(true);\n   416\t    if (!listed.ok) return;\n   417\t    for (const m of listed.value.filter((msg) => msg.kind === \"tool_result\")) {\n   418\t      expect(m.forms?.find((f) => f.form === \"tool_result_summary\")?.state).toBe(\"ready\");\n   419\t    }\n   420\t\n   421\t    // Clear the injection; the next batch re-evaluates and lands at target:\n   422\t    // zone 130 → flip the two oldest (130→90→50 ≤ 60), stop before the\n   423\t    // protected set (r3+r4 joined to 50 ≥ floor 30).\n   424\t    setViewInjectionHook(\"post-commit-advance\", null);\n   425\t    await intake(sdk, filePath, toolTurn([10]));\n   426\t    const all = await toolResults(sdk, filePath);\n   427\t    expect(await boundaryOf(sdk, filePath)).toBe(all[1]?.sourceEventOrder);\n   428\t    const healed = await sdk.threadView.status({ filePath });\n   429\t    expect(healed.ok).toBe(true);\n   430\t    if (!healed.ok) return;\n   431\t    expect(healed.value.visibility.zoneTokens).toBe(50);\n   432\t  });\n   433\t});\n   434\t\n   435\tdescribe(\"seam isolation, direction two (architecture-risk): a failing poke never blocks the advance\", () => {\n   436\t  it(\"advances through a direct domain call (default budgets) even when the fallback poke throws\", async () => {\n   437\t    // Thread built through a manual SDK; the intake under test is a DIRECT\n   438\t    // domain call with no SDK seam in scope, so budgets fall back to the\n   439\t    // built-in defaults (32000/24000/8000) and the poke falls back to the\n   440\t    // below-SDK slot — which this leg makes throw.\n   441\t    const sdk = visSdk();\n   442\t    const filePath = await newThread(sdk);\n   443\t    setSchedulerPoke(() => {\n   444\t      throw new Error(\"injected poke failure\");\n   445\t    });\n   446\t\n   447\t    // Zone 40000 > default max 32000: flip the older result (→ 20000 ≤\n   448\t    // target 24000); the newest (20000 ≥ floor 8000) is protected alone.\n   449\t    await intakeStream.messageEvents({ filePath }, toolTurn([20000, 20000]));\n   450\t    setSchedulerPoke(null);\n   451\t\n   452\t    const results = await toolResults(sdk, filePath);\n   453\t    expect(results).toHaveLength(2); // the batch committed\n   454\t    // The advance ran before the throwing poke: position = the older result.\n   455\t    expect(await boundaryOf(sdk, filePath)).toBe(results[0]?.sourceEventOrder);\n   456\t  });\n   457\t});\n   458\t\n   459\tdescribe(\"deleted-filter consistency (story DoD): the advance's sum and status's zone sum both skip deleted results\", () => {\n   460\t  it(\"drops a deleted zone result from the live sum, and the next advance decides over the filtered population\", async () => {\n   461\t    const sdk = visSdk();\n   462\t    const filePath = await newThread(sdk);\n   463\t    // Zone 80 ≤ max 100: no advance yet.\n   464\t    await intake(sdk, filePath, toolTurn([40, 40]));\n   465\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n   466\t\n   467\t    // Delete the older result: the live zone drops to 40 — status computes\n   468\t    // the deleted-filtered sum, the same query the advance reads.\n   469\t    const results = await toolResults(sdk, filePath);\n   470\t    const deleted = await sdk.messages.deleteMessage(\n   471\t      { filePath },\n   472\t      { messageId: results[0]?.messageId ?? \"\" },\n   473\t    );\n   474\t    expect(deleted.ok).toBe(true);\n   475\t    const status = await sdk.threadView.status({ filePath });\n   476\t    expect(status.ok).toBe(true);\n   477\t    if (!status.ok) return;\n   478\t    expect(status.value.visibility.zoneTokens).toBe(40);\n   479\t\n   480\t    // The next batch's advance decides over the filtered population: live\n   481\t    // zone 40+40+40 = 120 > max; the deleted row neither sums nor flips.\n   482\t    // Flips: the two oldest LIVE results (120→80→40 ≤ target 60); the newest\n   483\t    // (40 ≥ floor 30) is protected alone.\n   484\t    await intake(sdk, filePath, toolTurn([40, 40]));\n   485\t    const all = await toolResults(sdk, filePath); // listMessages is deleted-filtered too\n   486\t    expect(all).toHaveLength(3);\n   487\t    expect(await boundaryOf(sdk, filePath)).toBe(all[1]?.sourceEventOrder);\n   488\t    const after = await sdk.threadView.status({ filePath });\n   489\t    expect(after.ok).toBe(true);\n   490\t    if (!after.ok) return;\n   491\t    expect(after.value.visibility.zoneTokens).toBe(40);\n   492\t  });\n   493\t});\n   494\t\n   495\tdescribe(\"both host modes advance in-process (story DoD; the process-boundary CLI leg is Story 5's named debt)\", () => {\n   496\t  it.each([\"manual\", \"background\"] as const)(\"%s-mode SDK intake advances to the same position\", async (mode) => {\n   497\t    const sdk = visSdk({ visibility: BUDGETS }, mode);\n   498\t    const filePath = await newThread(sdk);\n   499\t    // Zone 120 > 100: flip the two oldest (120→80→40 ≤ 60); the newest (40 ≥\n   500\t    // floor 30) is protected alone.\n   501\t    await intake(sdk, filePath, toolTurn([40, 40, 40]));\n   502\t    const results = await toolResults(sdk, filePath);\n   503\t    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n   504\t    if (mode === \"background\") await sdk.drainSettled({ filePath });\n   505\t  });\n   506\t});\n","exit_code":0,"status":"completed"}}

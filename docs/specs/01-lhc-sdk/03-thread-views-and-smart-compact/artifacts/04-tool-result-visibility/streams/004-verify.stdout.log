{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' packages/lhc/test/goldens/boundary-g1-trajectory.json\"","aggregated_output":"{\n  \"case\": \"Boundary G1 — trajectory: sums crossing max twice, one monster open turn, floor legs (whole-message join; oversized-newest protected alone)\",\n  \"budgets\": { \"maxTokens\": 100, \"targetTokens\": 60, \"floorTokens\": 30 },\n  \"batches\": [\n    {\n      \"label\": \"B1 under max: zone 40 <= 100, boundary holds at origin\",\n      \"resultTokens\": [20, 20],\n      \"turnEnd\": true,\n      \"expectedPosition\": 0,\n      \"expectedZoneTokens\": 40\n    },\n    {\n      \"label\": \"B2 still under max: zone 80 <= 100, boundary holds\",\n      \"resultTokens\": [20, 20],\n      \"turnEnd\": true,\n      \"expectedPosition\": 0,\n      \"expectedZoneTokens\": 80\n    },\n    {\n      \"label\": \"B3 crosses max: zone 120 > 100; flip oldest-first r1,r2,r3 (120->100->80->60 = target); protected set joins r6+r5 to 40 >= floor 30; position = r3's order\",\n      \"resultTokens\": [20, 20],\n      \"turnEnd\": true,\n      \"expectedPosition\": 9,\n      \"expectedZoneTokens\": 60\n    },\n    {\n      \"label\": \"B4 under max after the advance: zone 70 <= 100, no movement (never backward, no churn)\",\n      \"resultTokens\": [10],\n      \"turnEnd\": true,\n      \"expectedPosition\": 9,\n      \"expectedZoneTokens\": 70\n    },\n    {\n      \"label\": \"B5 monster open turn crosses max again: zone 230 > 100; the newest result (80 >= floor 30) is protected ALONE; flips stop at the protected set with the zone legally above target (80 > 60); position = m2's order, inside the open turn\",\n      \"resultTokens\": [40, 40, 80],\n      \"turnEnd\": false,\n      \"expectedPosition\": 27,\n      \"expectedZoneTokens\": 80\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SHoE5JfZU4wBqLzb4Pbckk","type":"tool_result","content":"1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4\t// Stories 3–5 extend the same per-event walk with projection, turn\n5\t// transitions, and work queueing.\n6\timport { existsSync } from \"node:fs\";\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport {\n9\t  createCommitHooks,\n10\t  resolveInstancePoke,\n11\t  type OperationContext,\n12\t} from \"../../../shared/context.js\";\n13\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n14\timport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n15\timport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\n16\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n17\timport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\n18\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n19\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n20\t\n21\t// Test seam (set only through test/fixtures): called after each event is\n22\t// processed inside the walk, so atomicity under mid-walk failure can be\n23\t// induced through a real mechanism — closing the handle — rather than a\n24\t// mocked transaction object.\n25\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n26\tlet walkHook: IntakeWalkHook | null = null;\n27\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n28\t  walkHook = hook;\n29\t}\n30\t\n31\t// Test seam (set only through test/fixtures): replaces the wall clock so\n32\t// recordedAt is sourced deterministically for the public SDK contract proof —\n33\t// TC-1.4 records the same batch through both reference forms and reads it back\n34\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n35\t// production: recording stamps real wall time. An explicit clock argument to\n36\t// runMessageEvents still wins over the seam.\n37\tlet injectedClock: (() => Date) | null = null;\n38\texport function setIntakeClock(clock: (() => Date) | null): void {\n39\t  injectedClock = clock;\n40\t}\n41\t\n42\tfunction detail(cause: unknown): string {\n43\t  return cause instanceof Error ? cause.message : String(cause);\n44\t}\n45\t\n46\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n47\t  return {\n48\t    ok: false,\n49\t    error: {\n50\t      errorClass: \"caller_error\",\n51\t      code: \"thread_not_found\",\n52\t      reason: `no thread file exists at ${filePath}`,\n53\t    },\n54\t  };\n55\t}\n56\t\n57\t// The skip set is read at transaction start and reads only the key column:\n58\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n59\t// Chunked to stay under SQLite's bound-parameter limit.\n60\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n61\t  const found = new Set<string>();\n62\t  for (let offset = 0; offset < keys.length; offset += 400) {\n63\t    const chunk = keys.slice(offset, offset + 400);\n64\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n65\t    const rows = db\n66\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n67\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n68\t    for (const row of rows) found.add(row.idempotency_key);\n69\t  }\n70\t  return found;\n71\t}\n72\t\n73\tfunction threadIdOf(db: DatabaseSync): string {\n74\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n75\t    | { thread_id: string }\n76\t    | undefined;\n77\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n78\t  return row.thread_id;\n79\t}\n80\t\n81\tfunction maxEventOrder(db: DatabaseSync): number {\n82\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n83\t    | { max_order: number | bigint | null }\n84\t    | undefined;\n85\t  return Number(row?.max_order ?? 0);\n86\t}\n87\t\n88\texport async function runMessageEvents(\n89\t  thread: ThreadRef,\n90\t  events: readonly MessageEventInput[],\n91\t  clock: () => Date = injectedClock ?? (() => new Date()),\n92\t): Promise<OpResult<BatchResult>> {\n93\t  // Pure validation first: a rejected batch never opens the file, never takes\n94\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n95\t  // not a skip (validation-before-idempotency precedence).\n96\t  const refFailure = validateThreadRef(thread);\n97\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n98\t  const batchFailure = validateEvents(events);\n99\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n100\t\n101\t  const resolved = await resolveThreadRef(thread);\n102\t  if (!resolved.ok) return resolved;\n103\t  const { filePath } = resolved.value;\n104\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n105\t\n106\t  // openThreadDatabase verifies the file is a real thread file, then brings\n107\t  // its schema to the current version before the batch transaction begins,\n108\t  // so a thread recorded under an earlier story is writable here (F-03-001)\n109\t  // and a non-thread file is rejected unmutated (F-03-002).\n110\t  const opened = openThreadDatabase(filePath);\n111\t  if (!opened.ok) return opened;\n112\t  const db = opened.value;\n113\t\n114\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n115\t  // single-writer violations fail loudly at a defined point.\n116\t  let inTransaction = false;\n117\t  try {\n118\t    db.exec(\"BEGIN IMMEDIATE;\");\n119\t    inTransaction = true;\n120\t\n121\t    // Cross-domain calls inside the transaction share the open handle through\n122\t    // the operation context (design decision 8); built once per batch, never\n123\t    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n124\t    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n125\t    // so they drop with the transaction.\n126\t    const hooks = createCommitHooks();\n127\t    const ctx: OperationContext = {\n128\t      db,\n129\t      clock,\n130\t      threadId: threadIdOf(db),\n131\t      onCommit: hooks.register,\n132\t      poke: resolveInstancePoke(),\n133\t    };\n134\t\n135\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n136\t    // any event is processed — once is sufficient because only this pipeline\n137\t    // writes turn state and the write lock is already held, so more than one\n138\t    // open turn can only mean external interference. The batch records\n139\t    // nothing: nothing has been written yet, and the rollback closes the\n140\t    // never-used transaction.\n141\t    const openTurnIds = listOpenTurnIds(ctx);\n142\t    if (openTurnIds.length > 1) {\n143\t      db.exec(\"ROLLBACK;\");\n144\t      inTransaction = false;\n145\t      return {\n146\t        ok: false,\n147\t        error: {\n148\t          errorClass: \"state_corruption\",\n149\t          code: \"turn_state_corrupt\",\n150\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n151\t        },\n152\t      };\n153\t    }\n154\t\n155\t    const skipSet = recordedKeys(\n156\t      db,\n157\t      events.map((event) => event.idempotencyKey),\n158\t    );\n159\t    // Order counter from MAX(event_order): only recorded events increment it,\n160\t    // so skips consume no order numbers and the sequence stays dense.\n161\t    let lastOrder = maxEventOrder(db);\n162\t\n163\t    const insert = db.prepare(\n164\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n165\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n166\t    );\n167\t\n168\t    const eventResults: BatchResult[\"events\"] = [];\n169\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n170\t    // Work items append as they queue, in walk order — the result is a\n171\t    // faithful log of what the transaction did (AC-2.7). The full records\n172\t    // (status, queuedAt) stay in the thread file; the result carries item\n173\t    // identity only.\n174\t    const queuedItems: WorkItemRecord[] = [];\n175\t    for (const [index, event] of events.entries()) {\n176\t      if (skipSet.has(event.idempotencyKey)) {\n177\t        eventResults.push({\n178\t          idempotencyKey: event.idempotencyKey,\n179\t          outcome: \"skipped\",\n180\t          skipReason: \"duplicate_idempotency_key\",\n181\t        });\n182\t      } else {\n183\t        lastOrder += 1;\n184\t        const recordedAt = clock().toISOString();\n185\t        insert.run(\n186\t          lastOrder,\n187\t          event.eventKind,\n188\t          event.idempotencyKey,\n189\t          event.actor,\n190\t          event.harness,\n191\t          JSON.stringify(event.payload),\n192\t          recordedAt,\n193\t        );\n194\t        skipSet.add(event.idempotencyKey);\n195\t        // Turn transition before projection — the order is load-bearing: a\n196\t        // prompt transitions first and stamps to the turn it just opened\n197\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n198\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n199\t        // call, so a resend causes no transition (TC-5.4).\n200\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n201\t        turnTransitions.push(...turnOutcome.transitions);\n202\t        queuedItems.push(...turnOutcome.queuedWork);\n203\t        // Projection runs in the same iteration that recorded the event, so\n204\t        // it can never drift from its source; a projection failure throws\n205\t        // and rejects the whole batch. Skipped events never reach this call\n206\t        // (no duplicate message, AC-5.4).\n207\t        const created = createFromEvent(\n208\t          ctx,\n209\t          {\n210\t            ...event,\n211\t            eventOrder: lastOrder,\n212\t            recordedAt,\n213\t          },\n214\t          turnOutcome.openTurnId,\n215\t        );\n216\t        // Message-owned work queues in the same iteration, gated on\n217\t        // recorded: a skipped event never reaches this call, so it queues\n218\t        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n219\t        // decides which messages are derivation sources (AC-2.8).\n220\t        queuedItems.push(...queueMessageWork(ctx, created));\n221\t        const entry: BatchResult[\"events\"][number] = {\n222\t          idempotencyKey: event.idempotencyKey,\n223\t          outcome: \"recorded\",\n224\t        };\n225\t        if (created !== null) entry.messageId = created.messageId;\n226\t        eventResults.push(entry);\n227\t      }\n228\t      walkHook?.(db, index);\n229\t    }\n230\t\n231\t    db.exec(\"COMMIT;\");\n232\t    inTransaction = false;\n233\t    hooks.flush();\n234\t\n235\t    return {\n236\t      ok: true,\n237\t      value: {\n238\t        events: eventResults,\n239\t        turnTransitions,\n240\t        queuedWork: queuedItems.map((item) => ({\n241\t          workItemId: item.workItemId,\n242\t          owner: item.owner,\n243\t          kind: item.kind,\n244\t          sourceRef: item.sourceRef,\n245\t        })),\n246\t        threadPosition: { lastEventOrder: lastOrder },\n247\t      },\n248\t    };\n249\t  } catch (cause) {\n250\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n251\t    // class-independent. The handle may already be gone (induced failure),\n252\t    // in which case SQLite has already discarded the uncommitted transaction.\n253\t    if (inTransaction) {\n254\t      try {\n255\t        db.exec(\"ROLLBACK;\");\n256\t      } catch {\n257\t        // handle closed mid-walk; the open transaction died with it\n258\t      }\n259\t    }\n260\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n261\t  } finally {\n262\t    try {\n263\t      db.close();\n264\t    } catch {\n265\t      // already closed by the induced-failure seam\n266\t    }\n267\t  }\n268\t}\n269\t\n270\tinterface RawEventRow {\n271\t  event_order: number | bigint;\n272\t  event_kind: string;\n273\t  idempotency_key: string;\n274\t  actor: string;\n275\t  harness: string;\n276\t  payload: string;\n277\t  recorded_at: string;\n278\t}\n279\t\n280\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n281\t  const refFailure = validateThreadRef(thread);\n282\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n283\t\n284\t  const resolved = await resolveThreadRef(thread);\n285\t  if (!resolved.ok) return resolved;\n286\t  const { filePath } = resolved.value;\n287\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n288\t\n289\t  const opened = openThreadDatabase(filePath);\n290\t  if (!opened.ok) return opened;\n291\t  const db = opened.value;\n292\t  try {\n293\t    const rows = db\n294\t      .prepare(\n295\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n296\t         FROM event ORDER BY event_order`,\n297\t      )\n298\t      .all() as unknown as RawEventRow[];\n299\t    const records = rows.map(\n300\t      (row) =>\n301\t        ({\n302\t          eventKind: row.event_kind,\n303\t          idempotencyKey: row.idempotency_key,\n304\t          actor: row.actor,\n305\t          harness: row.harness,\n306\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n307\t          eventOrder: Number(row.event_order),\n308\t          recordedAt: row.recorded_at,\n309\t        }) as unknown as EventRecord,\n310\t    );\n311\t    return { ok: true, value: records };\n312\t  } catch (cause) {\n313\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n314\t  } finally {\n315\t    db.close();\n316\t  }\n317\t}\n318\t"}]},"parent_tool_use_id":null,"session_id":"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763","uuid":"71e92287-6274-410d-afc6-41f7714c6e52","timestamp":"2026-06-11T17:29:14.536Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n// Stories 3–5 extend the same per-event walk with projection, turn\n// transitions, and work queueing.\nimport { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport {\n  createCommitHooks,\n  resolveInstancePoke,\n  type OperationContext,\n} from \"../../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\nimport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\nimport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\nimport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\nimport { validateEvents, validateThreadRef } from \"./validate.js\";\n\n// Test seam (set only through test/fixtures): called after each event is\n// processed inside the walk, so atomicity under mid-walk failure can be\n// induced through a real mechanism — closing the handle — rather than a\n// mocked transaction object.\nexport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\nlet walkHook: IntakeWalkHook | null = null;\nexport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n  walkHook = hook;\n}\n\n// Test seam (set only through test/fixtures): replaces the wall clock so\n// recordedAt is sourced deterministically for the public SDK contract proof —\n// TC-1.4 records the same batch through both reference forms and reads it back\n// field-for-field, recordedAt included, with nothing stripped. Unset in\n// production: recording stamps real wall time. An explicit clock argument to\n// runMessageEvents still wins over the seam.\nlet injectedClock: (() => Date) | null = null;\nexport function setIntakeClock(clock: (() => Date) | null): void {\n  injectedClock = clock;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The skip set is read at transaction start and reads only the key column:\n// key-wins-over-content is the absence of a content comparison (AC-5.5).\n// Chunked to stay under SQLite's bound-parameter limit.\nfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n  const found = new Set<string>();\n  for (let offset = 0; offset < keys.length; offset += 400) {\n    const chunk = keys.slice(offset, offset + 400);\n    const placeholders = chunk.map(() => \"?\").join(\", \");\n    const rows = db\n      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    for (const row of rows) found.add(row.idempotency_key);\n  }\n  return found;\n}\n\nfunction threadIdOf(db: DatabaseSync): string {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n  return row.thread_id;\n}\n\nfunction maxEventOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0);\n}\n\nexport async function runMessageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n  clock: () => Date = injectedClock ?? (() => new Date()),\n): Promise<OpResult<BatchResult>> {\n  // Pure validation first: a rejected batch never opens the file, never takes\n  // the write lock, and a duplicate key on a malformed event is a rejection,\n  // not a skip (validation-before-idempotency precedence).\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n  const batchFailure = validateEvents(events);\n  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file, then brings\n  // its schema to the current version before the batch transaction begins,\n  // so a thread recorded under an earlier story is writable here (F-03-001)\n  // and a non-thread file is rejected unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n\n  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n  // single-writer violations fail loudly at a defined point.\n  let inTransaction = false;\n  try {\n    db.exec(\"BEGIN IMMEDIATE;\");\n    inTransaction = true;\n\n    // Cross-domain calls inside the transaction share the open handle through\n    // the operation context (design decision 8); built once per batch, never\n    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n    // so they drop with the transaction.\n    const hooks = createCommitHooks();\n    const ctx: OperationContext = {\n      db,\n      clock,\n      threadId: threadIdOf(db),\n      onCommit: hooks.register,\n      poke: resolveInstancePoke(),\n    };\n\n    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n    // any event is processed — once is sufficient because only this pipeline\n    // writes turn state and the write lock is already held, so more than one\n    // open turn can only mean external interference. The batch records\n    // nothing: nothing has been written yet, and the rollback closes the\n    // never-used transaction.\n    const openTurnIds = listOpenTurnIds(ctx);\n    if (openTurnIds.length > 1) {\n      db.exec(\"ROLLBACK;\");\n      inTransaction = false;\n      return {\n        ok: false,\n        error: {\n          errorClass: \"state_corruption\",\n          code: \"turn_state_corrupt\",\n          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n        },\n      };\n    }\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    const eventResults: BatchResult[\"events\"] = [];\n    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n    // Work items append as they queue, in walk order — the result is a\n    // faithful log of what the transaction did (AC-2.7). The full records\n    // (status, queuedAt) stay in the thread file; the result carries item\n    // identity only.\n    const queuedItems: WorkItemRecord[] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        const recordedAt = clock().toISOString();\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          recordedAt,\n        );\n        skipSet.add(event.idempotencyKey);\n        // Turn transition before projection — the order is load-bearing: a\n        // prompt transitions first and stamps to the turn it just opened\n        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n        // call, so a resend causes no transition (TC-5.4).\n        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n        turnTransitions.push(...turnOutcome.transitions);\n        queuedItems.push(...turnOutcome.queuedWork);\n        // Projection runs in the same iteration that recorded the event, so\n        // it can never drift from its source; a projection failure throws\n        // and rejects the whole batch. Skipped events never reach this call\n        // (no duplicate message, AC-5.4).\n        const created = createFromEvent(\n          ctx,\n          {\n            ...event,\n            eventOrder: lastOrder,\n            recordedAt,\n          },\n          turnOutcome.openTurnId,\n        );\n        // Message-owned work queues in the same iteration, gated on\n        // recorded: a skipped event never reaches this call, so it queues\n        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n        // decides which messages are derivation sources (AC-2.8).\n        queuedItems.push(...queueMessageWork(ctx, created));\n        const entry: BatchResult[\"events\"][number] = {\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"recorded\",\n        };\n        if (created !== null) entry.messageId = created.messageId;\n        eventResults.push(entry);\n      }\n      walkHook?.(db, index);\n    }\n\n    db.exec(\"COMMIT;\");\n    inTransaction = false;\n    hooks.flush();\n\n    return {\n      ok: true,\n      value: {\n        events: eventResults,\n        turnTransitions,\n        queuedWork: queuedItems.map((item) => ({\n          workItemId: item.workItemId,\n          owner: item.owner,\n          kind: item.kind,\n          sourceRef: item.sourceRef,\n        })),\n        threadPosition: { lastEventOrder: lastOrder },\n      },\n    };\n  } catch (cause) {\n    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n    // class-independent. The handle may already be gone (induced failure),\n    // in which case SQLite has already discarded the uncommitted transaction.\n    if (inTransaction) {\n      try {\n        db.exec(\"ROLLBACK;\");\n      } catch {\n        // handle closed mid-walk; the open transaction died with it\n      }\n    }\n    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n  } finally {\n    try {\n      db.close();\n    } catch {\n      // already closed by the induced-failure seam\n    }\n  }\n}\n\ninterface RawEventRow {\n  event_order: number | bigint;\n  event_kind: string;\n  idempotency_key: string;\n  actor: string;\n  harness: string;\n  payload: string;\n  recorded_at: string;\n}\n\nexport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const rows = db\n      .prepare(\n        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n         FROM event ORDER BY event_order`,\n      )\n      .all() as unknown as RawEventRow[];\n    const records = rows.map(\n      (row) =>\n        ({\n          eventKind: row.event_kind,\n          idempotencyKey: row.idempotency_key,\n          actor: row.actor,\n          harness: row.harness,\n          payload: JSON.parse(row.payload) as Record<string, unknown>,\n          eventOrder: Number(row.event_order),\n          recordedAt: row.recorded_at,\n        }) as unknown as EventRecord,\n    );\n    return { ok: true, value: records };\n  } catch (cause) {\n    return storageFailure(`event read-back failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":318,"startLine":1,"totalLines":318}}}

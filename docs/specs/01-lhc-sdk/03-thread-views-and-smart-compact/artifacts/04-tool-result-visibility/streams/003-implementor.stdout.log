{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_01WtW5GM9rHP6oRXcnEeb34k","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019QasV2uVex6FB5WdNGUqFx","name":"Edit","input":{"replace_all":false,"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-boundary.test.ts","old_string":"    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n\n    // r1 (60 tokens, 239 chars — over the 200-char abbreviation limit) will\n    // have its summary FAIL terminally; r2 (20 tokens) drains a ready\n    // summary; an assistant message sits between them.\n    const r1Run = toolRun(60);\n    const r2Run = toolRun(20);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"flip rendering prompt\" } }),\n      ...r1Run,\n      validEvent(\"assistant_text\", { payload: { text: \"interleaved assistant text\" } }),\n      ...r2Run,\n      validEvent(\"turn_end\"),\n    ]);\n    // First tool_result_summary execution fails non-retryably (r1's — queue\n    // order is walk order); r2's succeeds. Real drain, production paths.\n    sdk.config.provider; // (provider double scripted below via the SDK's own instance)\n    const double = sdk.config.provider as ReturnType<typeof createProviderDouble>;\n    double.failKind(\"tool_result_summary\", 1, {","new_string":"    const double = createProviderDouble();\n    const sdk = createSdk({ provider: double, mode: \"manual\", view: { visibility: BUDGETS } });\n    const filePath = await newThread(sdk);\n\n    // r1 (60 tokens, 239 chars — over the 200-char abbreviation limit) will\n    // have its summary FAIL terminally; r2 (20 tokens) drains a ready\n    // summary; an assistant message sits between them.\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"flip rendering prompt\" } }),\n      ...toolRun(60),\n      validEvent(\"assistant_text\", { payload: { text: \"interleaved assistant text\" } }),\n      ...toolRun(20),\n      validEvent(\"turn_end\"),\n    ]);\n    // First tool_result_summary execution fails non-retryably (r1's — queue\n    // order is walk order); r2's succeeds. Real drain, production paths.\n    double.failKind(\"tool_result_summary\", 1, {"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18131,"cache_read_input_tokens":158264,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18131},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763","uuid":"1d5c3daa-0486-416f-9a69-3822d63ad3c3","request_id":"req_011CbwtBc15nYSXg1dWDz9iL"}

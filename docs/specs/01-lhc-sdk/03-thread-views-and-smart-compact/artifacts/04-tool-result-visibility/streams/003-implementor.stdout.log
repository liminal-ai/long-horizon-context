{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MNxYEdJBwUEqLdLC3RJtii","type":"tool_result","content":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures:\ncorrupt.ts\ndrain-runner.ts\nindex.ts\nintake-seam.ts\nlegacy.ts\nprovider-double.ts\nreceipt-schema.ts\nthreads.ts\nview-seam.ts\nview-thread.ts\nwork-handlers.ts\n\n/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/goldens:\ng1-proportions.json\ng2-edge-exclusion.json\ng2-edge-inclusion.json\ng3-oversized-loner.json\ng4-turnless-straggler.json\nREADME.md\n// Epic 03 Story 0 view-domain test seams. Lives in fixtures/ — the one\n// directory sanctioned to reach below the SDK surface (boundary check\n// exempt).\n//\n// The injection facility (FC-0.6): re-export of the thread-view seam so\n// tests install crash/failure hooks at the two named points — the\n// post-commit advance (TC-4.6) and compact's write path between sweep and\n// view write (TC-2.4). Uninstalled, production fires are no-ops.\nexport {\n  fireViewInjection,\n  setViewInjectionHook,\n  type ViewInjectionHook,\n  type ViewInjectionPoint,\n} from \"../../src/domains/thread-view/internal/seam.js\";\n\nimport { DatabaseSync } from \"node:sqlite\";\n\n// Sanctioned below-SDK write (same sanctioning as corrupt.ts): seeds the\n// view_boundary row to an arbitrary position for TC-1.4's mid-tail pulls.\n// Boundary *mechanics* — how the position legally moves — are Story 4's to\n// prove; this helper only manufactures a position the pull must respect.\n// UPDATE-only on purpose: migration v6 seeded the singleton row, mirroring\n// the production advance's write shape.\nexport function seedViewBoundary(filePath: string, position: number): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    const changed = db\n      .prepare(\n        `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n      )\n      .run(position, new Date().toISOString());\n    if (Number(changed.changes) !== 1) {\n      throw new Error(\n        `fixture seedViewBoundary hit ${String(changed.changes)} rows; expected the migration-seeded singleton`,\n      );\n    }\n  } finally {\n    db.close();\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763","uuid":"02fec791-d73a-4ea2-ac66-7b5929244eb3","timestamp":"2026-06-11T17:29:41.909Z","tool_use_result":{"stdout":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures:\ncorrupt.ts\ndrain-runner.ts\nindex.ts\nintake-seam.ts\nlegacy.ts\nprovider-double.ts\nreceipt-schema.ts\nthreads.ts\nview-seam.ts\nview-thread.ts\nwork-handlers.ts\n\n/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/goldens:\ng1-proportions.json\ng2-edge-exclusion.json\ng2-edge-inclusion.json\ng3-oversized-loner.json\ng4-turnless-straggler.json\nREADME.md\n// Epic 03 Story 0 view-domain test seams. Lives in fixtures/ — the one\n// directory sanctioned to reach below the SDK surface (boundary check\n// exempt).\n//\n// The injection facility (FC-0.6): re-export of the thread-view seam so\n// tests install crash/failure hooks at the two named points — the\n// post-commit advance (TC-4.6) and compact's write path between sweep and\n// view write (TC-2.4). Uninstalled, production fires are no-ops.\nexport {\n  fireViewInjection,\n  setViewInjectionHook,\n  type ViewInjectionHook,\n  type ViewInjectionPoint,\n} from \"../../src/domains/thread-view/internal/seam.js\";\n\nimport { DatabaseSync } from \"node:sqlite\";\n\n// Sanctioned below-SDK write (same sanctioning as corrupt.ts): seeds the\n// view_boundary row to an arbitrary position for TC-1.4's mid-tail pulls.\n// Boundary *mechanics* — how the position legally moves — are Story 4's to\n// prove; this helper only manufactures a position the pull must respect.\n// UPDATE-only on purpose: migration v6 seeded the singleton row, mirroring\n// the production advance's write shape.\nexport function seedViewBoundary(filePath: string, position: number): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    const changed = db\n      .prepare(\n        `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n      )\n      .run(position, new Date().toISOString());\n    if (Number(changed.changes) !== 1) {\n      throw new Error(\n        `fixture seedViewBoundary hit ${String(changed.changes)} rows; expected the migration-seeded singleton`,\n      );\n    }\n  } finally {\n    db.close();\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

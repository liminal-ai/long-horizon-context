{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UqnWhdBpQKSjRLy2gWitWf","type":"tool_result","content":"1\t// Tail and band formatting (Story 1): the seven-kind tail mapping table\n2\t// (tech design §Tail message rendering — contract, not implementation\n3\t// choice), short/full tool-result selection by boundary position, and the\n4\t// short-form ladder (ready summary → deterministic truncation). Pure\n5\t// functions over read state by design: no DB handle, no provider, no clock —\n6\t// determinism is structural (AC-1.7 byte-identical pulls fall out of it).\n7\t//\n8\t// Story 2 adds the band-entry side: the degrade ladders (tech design\n9\t// §Degrade ladders), gap entries as the last rung (never absence, AC-2.5),\n10\t// visible subject keys (§t12 / §c4, AC-2.10), the [degraded: …] and\n11\t// [inter-turn note] markers, and band-text assembly. select.ts consumes the\n12\t// same entry renderer to price entries during the fill walk, so the tokens\n13\t// the walk budgets are the tokens the band stores — one renderer, no drift.\n14\timport type { Band, ViewMessage } from \"../../../shared/view.js\";\n15\timport type { TailMessageRow } from \"./snapshot.js\";\n16\t\n17\t// Epic 01's deterministic abbreviation rule: a fixed prefix plus an exact\n18\t// tail marker, a pure function of the input string alone. Restated here —\n19\t// byte-identical to turns/internal/compose.ts's truncateForFallback —\n20\t// because cross-domain internals may not be imported and the turns domain\n21\t// is frozen for this epic (tech design §Top-Tier Surfaces: no changes).\n22\texport const ABBREVIATION_LIMIT = 200;\n23\t\n24\texport function deterministicTruncation(text: string): string {\n25\t  if (text.length <= ABBREVIATION_LIMIT) return text;\n26\t  const dropped = text.length - ABBREVIATION_LIMIT;\n27\t  return `${text.slice(0, ABBREVIATION_LIMIT)}… [truncated ${dropped} chars]`;\n28\t}\n29\t\n30\tfunction blockContent(message: TailMessageRow): Record<string, unknown> {\n31\t  return message.blocks[0]?.content ?? {};\n32\t}\n33\t\n34\tfunction textOf(message: TailMessageRow): string {\n35\t  const text = blockContent(message)[\"text\"];\n36\t  return typeof text === \"string\" ? text : \"\";\n37\t}\n38\t\n39\t// What the tail renderer needs beyond the message itself: the boundary\n40\t// position (short/full selection), the call-id → tool-name pairing (results\n41\t// carry only their call id), and the ready tool-result summaries (the\n42\t// short-form ladder's first rung).\n43\texport interface TailRenderContext {\n44\t  boundaryPosition: number;\n45\t  toolNameByCallId: ReadonlyMap<string, string>;\n46\t  toolResultSummaries: ReadonlyMap<string, string>;\n47\t}\n48\t\n49\t// The call-id → tool-name map from the messages in hand. Pairing within the\n50\t// tail is structurally sufficient: the compact point snaps to a turn start,\n51\t// so a tail result's call is never behind it.\n52\texport function toolNamesByCallId(\n53\t  messages: readonly TailMessageRow[],\n54\t): Map<string, string> {\n55\t  const names = new Map<string, string>();\n56\t  for (const message of messages) {\n57\t    if (message.kind !== \"tool_call\") continue;\n58\t    const block = blockContent(message);\n59\t    const callId = block[\"toolCallId\"];\n60\t    const toolName = block[\"toolName\"];\n61\t    if (typeof callId === \"string\" && typeof toolName === \"string\") {\n62\t      names.set(callId, toolName);\n63\t    }\n64\t  }\n65\t  return names;\n66\t}\n67\t\n68\tfunction renderToolCall(message: TailMessageRow): ViewMessage {\n69\t  const block = blockContent(message);\n70\t  const name = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n71\t  // Deterministic arg rendering: the projected arguments serialized verbatim,\n72\t  // oversized args abbreviated by the same Epic 01 rule.\n73\t  const args = deterministicTruncation(JSON.stringify(block[\"arguments\"] ?? {}));\n74\t  return { role: \"assistant\", content: `[tool call · ${name}] ${args}` };\n75\t}\n76\t\n77\tfunction renderToolResult(message: TailMessageRow, ctx: TailRenderContext): ViewMessage {\n78\t  const block = blockContent(message);\n79\t  const callId = block[\"toolCallId\"];\n80\t  const name =\n81\t    (typeof callId === \"string\" ? ctx.toolNameByCallId.get(callId) : undefined) ??\n82\t    \"unknown_tool\";\n83\t  const content = typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\";\n84\t  if (message.sourceEventOrder > ctx.boundaryPosition) {\n85\t    return { role: \"user\", content: `[tool result · ${name}]\\n${content}` };\n86\t  }\n87\t  // At-or-behind the boundary: the short-form ladder — the ready summary\n88\t  // when usable, else deterministic truncation of the raw content (AC-4.2's\n89\t  // vocabulary; the default-boundary leg lands here in Story 1). Short-form\n90\t  // rendering marks that fuller content exists in the record.\n91\t  const short = ctx.toolResultSummaries.get(message.messageId) ?? deterministicTruncation(content);\n92\t  return {\n93\t    role: \"user\",\n94\t    content: `[tool result · ${name} · abridged]\\n${short} [full content in record §${message.messageId}]`,\n95\t  };\n96\t}\n97\t\n98\t// One tail message → one ViewMessage per the mapping table. Each kind is its\n99\t// own arm so a single kind's drift fails its own named test leg.\n100\texport function renderTailMessage(\n101\t  message: TailMessageRow,\n102\t  ctx: TailRenderContext,\n103\t): ViewMessage {\n104\t  switch (message.kind) {\n105\t    case \"user_prompt\":\n106\t      return { role: \"user\", content: textOf(message) };\n107\t    case \"assistant_text\":\n108\t      return { role: \"assistant\", content: textOf(message) };\n109\t    case \"assistant_thinking\":\n110\t      // Included: the tail is full fidelity (bands compress thinking away for\n111\t      // older turns); harness-side conversion may re-block or drop.\n112\t      return { role: \"assistant\", content: `[thinking]\\n${textOf(message)}\\n[/thinking]` };\n113\t    case \"tool_call\":\n114\t      return renderToolCall(message);\n115\t    case \"tool_result\":\n116\t      return renderToolResult(message, ctx);\n117\t    case \"runtime_note\":\n118\t      return { role: \"user\", content: `[runtime note] ${textOf(message)}` };\n119\t  }\n120\t}\n121\t\n122\t// One non-empty band → one labeled `user` message: band-marker header, then\n123\t// the snapshot bytes verbatim (AC-5.1 resolution: provider APIs reject\n124\t// unknown roles; `user` is what the MVP's injection used).\n125\texport function renderBandMessage(band: Band, renderedText: string): ViewMessage {\n126\t  return { role: \"user\", band, content: `[context · ${band}]\\n${renderedText}` };\n127\t}\n128\t\n129\t// ── band entries: degrade ladders, gaps, keys (Story 2) ──────────\n130\t\n131\t// One derived form's stored state as the ladder reads it (a projection of\n132\t// DerivedForm: the resolvers never write, never re-derive).\n133\texport interface FormSnapshot {\n134\t  state: \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n135\t  content?: string;\n136\t  reason?: string;\n137\t}\n138\t\n139\texport type FormLookup = (subjectId: string, form: string) => FormSnapshot | undefined;\n140\t\n141\t// A subject's resolved representation: which rung of its ladder renders.\n142\t// `formUsed` is the arrangement/receipt vocabulary; `degradedMarker` is the\n143\t// rendered [degraded: …] text for fallback rungs.\n144\texport interface ResolvedRepresentation {\n145\t  formUsed: string;\n146\t  body: string;\n147\t  degraded: boolean;\n148\t  gap: boolean;\n149\t  degradedMarker?: string;\n150\t  reason?: string;\n151\t}\n152\t\n153\tfunction usable(form: FormSnapshot | undefined): form is FormSnapshot & { content: string } {\n154\t  // \"Usable\" means state = ready (tech design §Degrade ladders).\n155\t  return form?.state === \"ready\" && typeof form.content === \"string\";\n156\t}\n157\t\n158\tfunction ladderState(form: FormSnapshot | undefined): string {\n159\t  return form === undefined ? \"absent\" : form.state;\n160\t}\n161\t\n162\t// Smooth (turn) ladder: turn_rendering → lower_band_projection →\n163\t// deterministic excerpt of the turn's live messages → gap entry.\n164\texport function resolveSmoothRepresentation(\n165\t  turnId: string,\n166\t  lookup: FormLookup,\n167\t  excerpt: string | null,\n168\t): ResolvedRepresentation {\n169\t  const rendering = lookup(turnId, \"turn_rendering\");\n170\t  if (usable(rendering)) {\n171\t    return { formUsed: \"turn_rendering\", body: rendering.content, degraded: false, gap: false };\n172\t  }\n173\t  const projection = lookup(turnId, \"lower_band_projection\");\n174\t  if (usable(projection)) {\n175\t    return {\n176\t      formUsed: \"lower_band_projection\",\n177\t      body: projection.content,\n178\t      degraded: true,\n179\t      gap: false,\n180\t      degradedMarker: \"smooth-from-projection\",\n181\t    };\n182\t  }\n183\t  if (excerpt !== null) {\n184\t    return {\n185\t      formUsed: \"message_excerpt\",\n186\t      body: deterministicTruncation(excerpt),\n187\t      degraded: true,\n188\t      gap: false,\n189\t      degradedMarker: \"smooth-from-excerpt\",\n190\t    };\n191\t  }\n192\t  return {\n193\t    formUsed: \"gap\",\n194\t    body: \"\",\n195\t    degraded: false,\n196\t    gap: true,\n197\t    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\n198\t  };\n199\t}\n200\t\n201\t// Detailed (chunk) ladder: chunk_summary_detailed → chunk_summary_brief →\n202\t// concatenated member projections (truncated, marked) → gap entry.\n203\texport function resolveDetailedRepresentation(\n204\t  chunkId: string,\n205\t  lookup: FormLookup,\n206\t  memberProjections: readonly string[],\n207\t): ResolvedRepresentation {\n208\t  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n209\t  if (usable(detailed)) {\n210\t    return { formUsed: \"chunk_summary_detailed\", body: detailed.content, degraded: false, gap: false };\n211\t  }\n212\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n213\t  if (usable(brief)) {\n214\t    return {\n215\t      formUsed: \"chunk_summary_brief\",\n216\t      body: brief.content,\n217\t      degraded: true,\n218\t      gap: false,\n219\t      degradedMarker: \"detailed-from-brief\",\n220\t    };\n221\t  }\n222\t  if (memberProjections.length > 0) {\n223\t    return {\n224\t      formUsed: \"member_projections\",\n225\t      body: deterministicTruncation(memberProjections.join(\"\\n\")),\n226\t      degraded: true,\n227\t      gap: false,\n228\t      degradedMarker: \"detailed-from-projections\",\n229\t    };\n230\t  }\n231\t  return {\n232\t    formUsed: \"gap\",\n233\t    body: \"\",\n234\t    degraded: false,\n235\t    gap: true,\n236\t    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, chunk_summary_brief: ${ladderState(brief)}, member projections ready: 0)`,\n237\t  };\n238\t}\n239\t\n240\t// Brief (chunk) ladder: chunk_summary_brief → chunk_summary_detailed\n241\t// truncated → gap entry (no projections rung in this band's ladder).\n242\texport function resolveBriefRepresentation(\n243\t  chunkId: string,\n244\t  lookup: FormLookup,\n245\t): ResolvedRepresentation {\n246\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n247\t  if (usable(brief)) {\n248\t    return { formUsed: \"chunk_summary_brief\", body: brief.content, degraded: false, gap: false };\n249\t  }\n250\t  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n251\t  if (usable(detailed)) {\n252\t    return {\n253\t      formUsed: \"chunk_summary_detailed_truncated\",\n254\t      body: deterministicTruncation(detailed.content),\n255\t      degraded: true,\n256\t      gap: false,\n257\t      degradedMarker: \"brief-from-detailed\",\n258\t    };\n259\t  }\n260\t  return {\n261\t    formUsed: \"gap\",\n262\t    body: \"\",\n263\t    degraded: false,\n264\t    gap: true,\n265\t    reason: `no usable form (chunk_summary_brief: ${ladderState(brief)}, chunk_summary_detailed: ${ladderState(detailed)}, member projections ready: 0)`,\n266\t  };\n267\t}\n268\t\n269\t// The per-message line an excerpt or note renders — a compact, deterministic\n270\t// projection of the raw record (last-rung fallback, not the tail mapping).\n271\texport function excerptLine(\n272\t  kind: string,\n273\t  blocks: ReadonlyArray<{ blockType: string; content: Record<string, unknown> }>,\n274\t): string {\n275\t  const content = blocks[0]?.content ?? {};\n276\t  const text = typeof content[\"text\"] === \"string\" ? content[\"text\"] : \"\";\n277\t  switch (kind) {\n278\t    case \"tool_call\": {\n279\t      const name = typeof content[\"toolName\"] === \"string\" ? content[\"toolName\"] : \"unknown_tool\";\n280\t      return `[tool call · ${name}]`;\n281\t    }\n282\t    case \"tool_result\":\n283\t      return \"[tool result]\";\n284\t    default:\n285\t      return text;\n286\t  }\n287\t}\n288\t\n289\t// One selected subject → its band-entry text: any attached inter-turn notes\n290\t// (rule 6: rendered raw with the marker, immediately before the entry), then\n291\t// the keyed entry — §key, [degraded: …] when a fallback rung rendered, or the\n292\t// gap line as the last rung. select.ts prices exactly this text in the fill\n293\t// walk; the band stores exactly this text.\n294\texport function renderArrangementEntry(\n295\t  subjectKind: \"turn\" | \"chunk\",\n296\t  subjectId: string,\n297\t  rep: ResolvedRepresentation,\n298\t  noteTexts: readonly string[],\n299\t): string {\n300\t  const lines = noteTexts.map((text) => `[inter-turn note] ${text}`);\n301\t  if (rep.gap) {\n302\t    lines.push(`§${subjectId} [${subjectKind} ${subjectId} unavailable: ${rep.reason ?? \"unknown\"}]`);\n303\t  } else {\n304\t    const marker = rep.degraded ? ` [degraded: ${rep.degradedMarker ?? rep.formUsed}]` : \"\";\n305\t    lines.push(`§${subjectId}${marker}\\n${rep.body}`);\n306\t  }\n307\t  return lines.join(\"\\n\");\n308\t}\n309\t\n310\t// A band's snapshot bytes: its entries oldest-first, blank-line separated.\n311\texport function assembleBandText(entryTexts: readonly string[]): string {\n312\t  return entryTexts.join(\"\\n\\n\");\n313\t}\n314\t"}]},"parent_tool_use_id":null,"session_id":"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763","uuid":"97bf2169-7cb1-4a3f-847b-35950a194354","timestamp":"2026-06-11T17:29:28.979Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/render.ts","content":"// Tail and band formatting (Story 1): the seven-kind tail mapping table\n// (tech design §Tail message rendering — contract, not implementation\n// choice), short/full tool-result selection by boundary position, and the\n// short-form ladder (ready summary → deterministic truncation). Pure\n// functions over read state by design: no DB handle, no provider, no clock —\n// determinism is structural (AC-1.7 byte-identical pulls fall out of it).\n//\n// Story 2 adds the band-entry side: the degrade ladders (tech design\n// §Degrade ladders), gap entries as the last rung (never absence, AC-2.5),\n// visible subject keys (§t12 / §c4, AC-2.10), the [degraded: …] and\n// [inter-turn note] markers, and band-text assembly. select.ts consumes the\n// same entry renderer to price entries during the fill walk, so the tokens\n// the walk budgets are the tokens the band stores — one renderer, no drift.\nimport type { Band, ViewMessage } from \"../../../shared/view.js\";\nimport type { TailMessageRow } from \"./snapshot.js\";\n\n// Epic 01's deterministic abbreviation rule: a fixed prefix plus an exact\n// tail marker, a pure function of the input string alone. Restated here —\n// byte-identical to turns/internal/compose.ts's truncateForFallback —\n// because cross-domain internals may not be imported and the turns domain\n// is frozen for this epic (tech design §Top-Tier Surfaces: no changes).\nexport const ABBREVIATION_LIMIT = 200;\n\nexport function deterministicTruncation(text: string): string {\n  if (text.length <= ABBREVIATION_LIMIT) return text;\n  const dropped = text.length - ABBREVIATION_LIMIT;\n  return `${text.slice(0, ABBREVIATION_LIMIT)}… [truncated ${dropped} chars]`;\n}\n\nfunction blockContent(message: TailMessageRow): Record<string, unknown> {\n  return message.blocks[0]?.content ?? {};\n}\n\nfunction textOf(message: TailMessageRow): string {\n  const text = blockContent(message)[\"text\"];\n  return typeof text === \"string\" ? text : \"\";\n}\n\n// What the tail renderer needs beyond the message itself: the boundary\n// position (short/full selection), the call-id → tool-name pairing (results\n// carry only their call id), and the ready tool-result summaries (the\n// short-form ladder's first rung).\nexport interface TailRenderContext {\n  boundaryPosition: number;\n  toolNameByCallId: ReadonlyMap<string, string>;\n  toolResultSummaries: ReadonlyMap<string, string>;\n}\n\n// The call-id → tool-name map from the messages in hand. Pairing within the\n// tail is structurally sufficient: the compact point snaps to a turn start,\n// so a tail result's call is never behind it.\nexport function toolNamesByCallId(\n  messages: readonly TailMessageRow[],\n): Map<string, string> {\n  const names = new Map<string, string>();\n  for (const message of messages) {\n    if (message.kind !== \"tool_call\") continue;\n    const block = blockContent(message);\n    const callId = block[\"toolCallId\"];\n    const toolName = block[\"toolName\"];\n    if (typeof callId === \"string\" && typeof toolName === \"string\") {\n      names.set(callId, toolName);\n    }\n  }\n  return names;\n}\n\nfunction renderToolCall(message: TailMessageRow): ViewMessage {\n  const block = blockContent(message);\n  const name = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n  // Deterministic arg rendering: the projected arguments serialized verbatim,\n  // oversized args abbreviated by the same Epic 01 rule.\n  const args = deterministicTruncation(JSON.stringify(block[\"arguments\"] ?? {}));\n  return { role: \"assistant\", content: `[tool call · ${name}] ${args}` };\n}\n\nfunction renderToolResult(message: TailMessageRow, ctx: TailRenderContext): ViewMessage {\n  const block = blockContent(message);\n  const callId = block[\"toolCallId\"];\n  const name =\n    (typeof callId === \"string\" ? ctx.toolNameByCallId.get(callId) : undefined) ??\n    \"unknown_tool\";\n  const content = typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\";\n  if (message.sourceEventOrder > ctx.boundaryPosition) {\n    return { role: \"user\", content: `[tool result · ${name}]\\n${content}` };\n  }\n  // At-or-behind the boundary: the short-form ladder — the ready summary\n  // when usable, else deterministic truncation of the raw content (AC-4.2's\n  // vocabulary; the default-boundary leg lands here in Story 1). Short-form\n  // rendering marks that fuller content exists in the record.\n  const short = ctx.toolResultSummaries.get(message.messageId) ?? deterministicTruncation(content);\n  return {\n    role: \"user\",\n    content: `[tool result · ${name} · abridged]\\n${short} [full content in record §${message.messageId}]`,\n  };\n}\n\n// One tail message → one ViewMessage per the mapping table. Each kind is its\n// own arm so a single kind's drift fails its own named test leg.\nexport function renderTailMessage(\n  message: TailMessageRow,\n  ctx: TailRenderContext,\n): ViewMessage {\n  switch (message.kind) {\n    case \"user_prompt\":\n      return { role: \"user\", content: textOf(message) };\n    case \"assistant_text\":\n      return { role: \"assistant\", content: textOf(message) };\n    case \"assistant_thinking\":\n      // Included: the tail is full fidelity (bands compress thinking away for\n      // older turns); harness-side conversion may re-block or drop.\n      return { role: \"assistant\", content: `[thinking]\\n${textOf(message)}\\n[/thinking]` };\n    case \"tool_call\":\n      return renderToolCall(message);\n    case \"tool_result\":\n      return renderToolResult(message, ctx);\n    case \"runtime_note\":\n      return { role: \"user\", content: `[runtime note] ${textOf(message)}` };\n  }\n}\n\n// One non-empty band → one labeled `user` message: band-marker header, then\n// the snapshot bytes verbatim (AC-5.1 resolution: provider APIs reject\n// unknown roles; `user` is what the MVP's injection used).\nexport function renderBandMessage(band: Band, renderedText: string): ViewMessage {\n  return { role: \"user\", band, content: `[context · ${band}]\\n${renderedText}` };\n}\n\n// ── band entries: degrade ladders, gaps, keys (Story 2) ──────────\n\n// One derived form's stored state as the ladder reads it (a projection of\n// DerivedForm: the resolvers never write, never re-derive).\nexport interface FormSnapshot {\n  state: \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n  content?: string;\n  reason?: string;\n}\n\nexport type FormLookup = (subjectId: string, form: string) => FormSnapshot | undefined;\n\n// A subject's resolved representation: which rung of its ladder renders.\n// `formUsed` is the arrangement/receipt vocabulary; `degradedMarker` is the\n// rendered [degraded: …] text for fallback rungs.\nexport interface ResolvedRepresentation {\n  formUsed: string;\n  body: string;\n  degraded: boolean;\n  gap: boolean;\n  degradedMarker?: string;\n  reason?: string;\n}\n\nfunction usable(form: FormSnapshot | undefined): form is FormSnapshot & { content: string } {\n  // \"Usable\" means state = ready (tech design §Degrade ladders).\n  return form?.state === \"ready\" && typeof form.content === \"string\";\n}\n\nfunction ladderState(form: FormSnapshot | undefined): string {\n  return form === undefined ? \"absent\" : form.state;\n}\n\n// Smooth (turn) ladder: turn_rendering → lower_band_projection →\n// deterministic excerpt of the turn's live messages → gap entry.\nexport function resolveSmoothRepresentation(\n  turnId: string,\n  lookup: FormLookup,\n  excerpt: string | null,\n): ResolvedRepresentation {\n  const rendering = lookup(turnId, \"turn_rendering\");\n  if (usable(rendering)) {\n    return { formUsed: \"turn_rendering\", body: rendering.content, degraded: false, gap: false };\n  }\n  const projection = lookup(turnId, \"lower_band_projection\");\n  if (usable(projection)) {\n    return {\n      formUsed: \"lower_band_projection\",\n      body: projection.content,\n      degraded: true,\n      gap: false,\n      degradedMarker: \"smooth-from-projection\",\n    };\n  }\n  if (excerpt !== null) {\n    return {\n      formUsed: \"message_excerpt\",\n      body: deterministicTruncation(excerpt),\n      degraded: true,\n      gap: false,\n      degradedMarker: \"smooth-from-excerpt\",\n    };\n  }\n  return {\n    formUsed: \"gap\",\n    body: \"\",\n    degraded: false,\n    gap: true,\n    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\n  };\n}\n\n// Detailed (chunk) ladder: chunk_summary_detailed → chunk_summary_brief →\n// concatenated member projections (truncated, marked) → gap entry.\nexport function resolveDetailedRepresentation(\n  chunkId: string,\n  lookup: FormLookup,\n  memberProjections: readonly string[],\n): ResolvedRepresentation {\n  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n  if (usable(detailed)) {\n    return { formUsed: \"chunk_summary_detailed\", body: detailed.content, degraded: false, gap: false };\n  }\n  const brief = lookup(chunkId, \"chunk_summary_brief\");\n  if (usable(brief)) {\n    return {\n      formUsed: \"chunk_summary_brief\",\n      body: brief.content,\n      degraded: true,\n      gap: false,\n      degradedMarker: \"detailed-from-brief\",\n    };\n  }\n  if (memberProjections.length > 0) {\n    return {\n      formUsed: \"member_projections\",\n      body: deterministicTruncation(memberProjections.join(\"\\n\")),\n      degraded: true,\n      gap: false,\n      degradedMarker: \"detailed-from-projections\",\n    };\n  }\n  return {\n    formUsed: \"gap\",\n    body: \"\",\n    degraded: false,\n    gap: true,\n    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, chunk_summary_brief: ${ladderState(brief)}, member projections ready: 0)`,\n  };\n}\n\n// Brief (chunk) ladder: chunk_summary_brief → chunk_summary_detailed\n// truncated → gap entry (no projections rung in this band's ladder).\nexport function resolveBriefRepresentation(\n  chunkId: string,\n  lookup: FormLookup,\n): ResolvedRepresentation {\n  const brief = lookup(chunkId, \"chunk_summary_brief\");\n  if (usable(brief)) {\n    return { formUsed: \"chunk_summary_brief\", body: brief.content, degraded: false, gap: false };\n  }\n  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n  if (usable(detailed)) {\n    return {\n      formUsed: \"chunk_summary_detailed_truncated\",\n      body: deterministicTruncation(detailed.content),\n      degraded: true,\n      gap: false,\n      degradedMarker: \"brief-from-detailed\",\n    };\n  }\n  return {\n    formUsed: \"gap\",\n    body: \"\",\n    degraded: false,\n    gap: true,\n    reason: `no usable form (chunk_summary_brief: ${ladderState(brief)}, chunk_summary_detailed: ${ladderState(detailed)}, member projections ready: 0)`,\n  };\n}\n\n// The per-message line an excerpt or note renders — a compact, deterministic\n// projection of the raw record (last-rung fallback, not the tail mapping).\nexport function excerptLine(\n  kind: string,\n  blocks: ReadonlyArray<{ blockType: string; content: Record<string, unknown> }>,\n): string {\n  const content = blocks[0]?.content ?? {};\n  const text = typeof content[\"text\"] === \"string\" ? content[\"text\"] : \"\";\n  switch (kind) {\n    case \"tool_call\": {\n      const name = typeof content[\"toolName\"] === \"string\" ? content[\"toolName\"] : \"unknown_tool\";\n      return `[tool call · ${name}]`;\n    }\n    case \"tool_result\":\n      return \"[tool result]\";\n    default:\n      return text;\n  }\n}\n\n// One selected subject → its band-entry text: any attached inter-turn notes\n// (rule 6: rendered raw with the marker, immediately before the entry), then\n// the keyed entry — §key, [degraded: …] when a fallback rung rendered, or the\n// gap line as the last rung. select.ts prices exactly this text in the fill\n// walk; the band stores exactly this text.\nexport function renderArrangementEntry(\n  subjectKind: \"turn\" | \"chunk\",\n  subjectId: string,\n  rep: ResolvedRepresentation,\n  noteTexts: readonly string[],\n): string {\n  const lines = noteTexts.map((text) => `[inter-turn note] ${text}`);\n  if (rep.gap) {\n    lines.push(`§${subjectId} [${subjectKind} ${subjectId} unavailable: ${rep.reason ?? \"unknown\"}]`);\n  } else {\n    const marker = rep.degraded ? ` [degraded: ${rep.degradedMarker ?? rep.formUsed}]` : \"\";\n    lines.push(`§${subjectId}${marker}\\n${rep.body}`);\n  }\n  return lines.join(\"\\n\");\n}\n\n// A band's snapshot bytes: its entries oldest-first, blank-line separated.\nexport function assembleBandText(entryTexts: readonly string[]): string {\n  return entryTexts.join(\"\\n\\n\");\n}\n","numLines":314,"startLine":1,"totalLines":314}}}

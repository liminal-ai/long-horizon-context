{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011nEPBy6En5q2gLpFJukoP8","type":"tool_result","content":"1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n2\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n3\t// deterministic string assembly only, no inference, no network, no queue\n4\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n5\t// Story 3 lands `sweep` (standalone and embedded default-on in compact).\n6\t// `materialize` stays a structured-result stub until Story 5. Story 0's\n7\t// substrate (profile resolution, consumed by createSdk) re-exports at the\n8\t// bottom.\n9\timport { existsSync } from \"node:fs\";\n10\timport {\n11\t  resolveInstanceViewConfig,\n12\t  runWithThreadTouchSuppressed,\n13\t} from \"../../shared/context.js\";\n14\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n15\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n16\timport type {\n17\t  CompactReceipt,\n18\t  PullResult,\n19\t  ResolvedViewConfig,\n20\t  SweepReceipt,\n21\t  ViewCompactParams,\n22\t  ViewMessage,\n23\t  ViewProfile,\n24\t  ViewStatus,\n25\t} from \"../../shared/view.js\";\n26\timport * as messagesDomain from \"../messages/index.js\";\n27\timport * as turnsDomain from \"../turns/index.js\";\n28\timport {\n29\t  openThreadDatabase,\n30\t  resolveThreadRef,\n31\t  type ThreadRef,\n32\t} from \"../threads/index.js\";\n33\timport { readBoundaryPosition, visibilityZoneTokens } from \"./internal/boundary.js\";\n34\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n35\timport {\n36\t  assembleBandText,\n37\t  renderBandMessage,\n38\t  renderTailMessage,\n39\t  toolNamesByCallId,\n40\t} from \"./internal/render.js\";\n41\timport { fireViewInjection } from \"./internal/seam.js\";\n42\timport {\n43\t  CanonicalCorruptionError,\n44\t  readSelectionInputs,\n45\t  selectArrangement,\n46\t  type ArrangementEntry,\n47\t} from \"./internal/select.js\";\n48\timport {\n49\t  readReadyToolResultSummaries,\n50\t  readTailMessages,\n51\t  readViewSnapshot,\n52\t  replaceViewSnapshot,\n53\t  tailTokenSum,\n54\t} from \"./internal/snapshot.js\";\n55\timport { runSweep } from \"./internal/sweep.js\";\n56\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n57\timport type { Band } from \"../../shared/view.js\";\n58\t\n59\t// Config resolution for the operation in hand: the SDK instance's resolved\n60\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n61\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n62\t// through the same one resolution path createSdk uses.\n63\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n64\t\n65\tfunction viewConfig(): ResolvedViewConfig {\n66\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n67\t}\n68\t\n69\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n70\t  return {\n71\t    ok: false,\n72\t    error: {\n73\t      errorClass: \"caller_error\",\n74\t      code: \"thread_not_found\",\n75\t      reason: `no thread file exists at ${filePath}`,\n76\t    },\n77\t  };\n78\t}\n79\t\n80\tfunction detail(cause: unknown): string {\n81\t  return cause instanceof Error ? cause.message : String(cause);\n82\t}\n83\t\n84\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n85\t\n86\t// The hot-path read: view header + bands (if any), tail messages after the\n87\t// compact point (deleted-filtered, record order), boundary position; then\n88\t// format — band messages first, tail per the mapping table, tool results\n89\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n90\t// tail from event 1 (AC-1.3) through this same code path with the compact\n91\t// point at its zero origin — snapshot-absent, never a separate branch.\n92\t//\n93\t// Reads-only is structural, not disciplined: the whole operation runs in the\n94\t// touch-suppressed scope, so the open announcement that would let a\n95\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n96\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n97\t// AC-1.1's no-queue-interaction holds in both host modes.\n98\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n99\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n100\t}\n101\t\n102\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n103\t  const resolved = await resolveThreadRef(ref);\n104\t  if (!resolved.ok) return resolved;\n105\t  const { filePath } = resolved.value;\n106\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n107\t\n108\t  const opened = openThreadDatabase(filePath);\n109\t  if (!opened.ok) return opened;\n110\t  const db = opened.value;\n111\t  try {\n112\t    const snapshot = readViewSnapshot(db);\n113\t    const compactPoint = snapshot?.compactPoint ?? 0;\n114\t    const boundaryPosition = readBoundaryPosition(db);\n115\t    const tailRows = readTailMessages(db, compactPoint);\n116\t    const renderCtx = {\n117\t      boundaryPosition,\n118\t      toolNameByCallId: toolNamesByCallId(tailRows),\n119\t      toolResultSummaries: readReadyToolResultSummaries(db),\n120\t    };\n121\t\n122\t    const messages: ViewMessage[] = [];\n123\t    if (snapshot !== null) {\n124\t      for (const band of snapshot.bands) {\n125\t        messages.push(renderBandMessage(band.band, band.renderedText));\n126\t      }\n127\t    }\n128\t    for (const row of tailRows) {\n129\t      messages.push(renderTailMessage(row, renderCtx));\n130\t    }\n131\t\n132\t    return {\n133\t      ok: true,\n134\t      value: {\n135\t        messages,\n136\t        meta: {\n137\t          compactPoint: snapshot?.compactPoint ?? null,\n138\t          coveredFrom: snapshot?.coveredFrom ?? null,\n139\t          boundaryPosition,\n140\t          gapCount: snapshot?.gapCount ?? 0,\n141\t          degradedCount: snapshot?.degradedCount ?? 0,\n142\t          viewId: snapshot?.viewId ?? null,\n143\t          createdAt: snapshot?.createdAt ?? null,\n144\t        },\n145\t      },\n146\t    };\n147\t  } catch (cause) {\n148\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n149\t  } finally {\n150\t    db.close();\n151\t  }\n152\t}\n153\t\n154\t// ── status (AC-2.8) ───────────────────────────────────────────────\n155\t\n156\t// Derivation counts bucket from one report entry the way the report's own\n157\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n158\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n159\t// forms are healthy and not an operational situation.\n160\tfunction bucketDerivation(\n161\t  entries: readonly FormReportEntry[],\n162\t  counts: ViewStatus[\"derivation\"],\n163\t): void {\n164\t  for (const entry of entries) {\n165\t    switch (entry.state) {\n166\t      case \"pending\":\n167\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n168\t        else counts.pending += 1;\n169\t        break;\n170\t      case \"failed\":\n171\t        counts.failed += 1;\n172\t        break;\n173\t      case \"blocked\":\n174\t        counts.blocked += 1;\n175\t        break;\n176\t      case \"ready\":\n177\t        break;\n178\t    }\n179\t  }\n180\t}\n181\t\n182\t// Reads only, callable any time, no side effects: tail size against the\n183\t// configured trigger threshold with a compact recommendation (`tailTokens >\n184\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n185\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n186\t// direct derived_form read here), the active view's health or null\n187\t// pre-compact, and the visibility zone's sum against its max — computed live\n188\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n189\t// structural, not stored.\n190\t//\n191\t// Like pull, the whole read — including the owners' report surfaces it\n192\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n193\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n194\t// host modes).\n195\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n196\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n197\t}\n198\t\n199\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n200\t  const resolved = await resolveThreadRef(ref);\n201\t  if (!resolved.ok) return resolved;\n202\t  const { filePath } = resolved.value;\n203\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n204\t\n205\t  const config = viewConfig();\n206\t  const opened = openThreadDatabase(filePath);\n207\t  if (!opened.ok) return opened;\n208\t  const db = opened.value;\n209\t  let tailTokens: number;\n210\t  let zoneTokens: number;\n211\t  let view: ViewStatus[\"view\"];\n212\t  try {\n213\t    const snapshot = readViewSnapshot(db);\n214\t    const compactPoint = snapshot?.compactPoint ?? 0;\n215\t    const boundaryPosition = readBoundaryPosition(db);\n216\t    tailTokens = tailTokenSum(db, compactPoint);\n217\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n218\t    view =\n219\t      snapshot === null\n220\t        ? null\n221\t        : {\n222\t            degraded: snapshot.degradedCount,\n223\t            gaps: snapshot.gapCount,\n224\t            builtAt: snapshot.createdAt,\n225\t          };\n226\t  } catch (cause) {\n227\t    return storageFailure(`view status failed: ${detail(cause)}`);\n228\t  } finally {\n229\t    db.close();\n230\t  }\n231\t\n232\t  // The owners' report surfaces open their own handles; ours is closed first\n233\t  // so the status read never holds two handles on one thread file.\n234\t  const messageReport = await messagesDomain.report({ filePath });\n235\t  if (!messageReport.ok) return messageReport;\n236\t  const turnReport = await turnsDomain.report({ filePath });\n237\t  if (!turnReport.ok) return turnReport;\n238\t  const derivation: ViewStatus[\"derivation\"] = {\n239\t    pending: 0,\n240\t    retrying: 0,\n241\t    failed: 0,\n242\t    blocked: 0,\n243\t  };\n244\t  bucketDerivation(messageReport.value, derivation);\n245\t  bucketDerivation(turnReport.value, derivation);\n246\t\n247\t  return {\n248\t    ok: true,\n249\t    value: {\n250\t      tailTokens,\n251\t      threshold: config.compactThreshold,\n252\t      compactRecommended: tailTokens > config.compactThreshold,\n253\t      derivation,\n254\t      view,\n255\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n256\t    },\n257\t  };\n258\t}\n259\t\n260\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n261\t\n262\t// The default base when no profile is named: the first built-in, matching\n263\t// the epic's primary user (the PI continuation harness). Explicit params\n264\t// override the base field-wise (AC-2.2).\n265\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n266\t\n267\tfunction callerError(\n268\t  code: \"unknown_profile\" | \"invalid_view_config\",\n269\t  reason: string,\n270\t): { ok: false; error: ErrorResult } {\n271\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n272\t}\n273\t\n274\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n275\t\n276\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n277\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n278\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n279\t// skips (AC-3.6; the receipt records which) → read record + forms with the\n280\t// corruption check in the reads (pre-transaction, prior view trivially\n281\t// intact on refusal) → selection walk → band rendering → one BEGIN\n282\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\n283\t// Assembly is entirely from stored artifacts: nothing here can reach a\n284\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n285\t// through owners' requeue surfaces and calls no provider either).\n286\texport async function compact(\n287\t  ref: ThreadRef,\n288\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n289\t): Promise<OpResult<CompactReceipt>> {\n290\t  const resolved = await resolveThreadRef(ref);\n291\t  if (!resolved.ok) return resolved;\n292\t  const { filePath } = resolved.value;\n293\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n294\t\n295\t  const config = viewConfig();\n296\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n297\t  const base = config.profiles[baseName];\n298\t  if (base === undefined) {\n299\t    return callerError(\n300\t      \"unknown_profile\",\n301\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n302\t        .map((name) => `\"${name}\"`)\n303\t        .join(\", \")}`,\n304\t    );\n305\t  }\n306\t  const merged: ViewProfile = {\n307\t    name: base.name,\n308\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n309\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n310\t  };\n311\t  const violation = profileViolation(merged);\n312\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n313\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n314\t  // any param override means the config is no longer a named profile's mix,\n315\t  // even when one served as the merge base; the receipt's config carries the\n316\t  // resolved truth. A bare or profile-only call names its profile.\n317\t  const profileName = opts.params === undefined ? baseName : null;\n318\t\n319\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n320\t  // leaves the thread healthier than it found it; `sweep: false` skips with\n321\t  // the skip recorded in the receipt. Runs before this operation opens its\n322\t  // own handle (the owners' surfaces open theirs), and before any view\n323\t  // write — a sweep failure aborts the compact with the prior view intact.\n324\t  let sweepOutcome: SweepReceipt | { skipped: true };\n325\t  if (opts.sweep === false) {\n326\t    sweepOutcome = { skipped: true };\n327\t  } else {\n328\t    const swept = await runSweep(filePath);\n329\t    if (!swept.ok) return swept;\n330\t    sweepOutcome = swept.value;\n331\t  }\n332\t\n333\t  const opened = openThreadDatabase(filePath);\n334\t  if (!opened.ok) return opened;\n335\t  const db = opened.value;\n336\t  try {\n337\t    let inputs;\n338\t    try {\n339\t      inputs = readSelectionInputs(db);\n340\t    } catch (cause) {\n341\t      if (cause instanceof CanonicalCorruptionError) {\n342\t        // Pre-transaction refusal: nothing was written, the prior view and\n343\t        // the record are untouched (AC-2.5).\n344\t        return {\n345\t          ok: false,\n346\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n347\t        };\n348\t      }\n349\t      throw cause;\n350\t    }\n351\t    const selection = selectArrangement(inputs, {\n352\t      lowerBound: merged.lowerBound,\n353\t      percentages: merged.percentages,\n354\t    });\n355\t\n356\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n357\t      selection.entries.filter((entry) => entry.band === band);\n358\t    const bands = BAND_ORDER.flatMap((band) => {\n359\t      const entries = entriesByBand(band);\n360\t      if (entries.length === 0) return [];\n361\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n362\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n363\t    });\n364\t\n365\t    const createdAt = new Date().toISOString();\n366\t    // view_id is v<compact event order> — deterministic, and deliberately\n367\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n368\t    // into a uniqueness scheme; the singleton row is replaced whole).\n369\t    const viewId = `v${inputs.maxEventOrder}`;\n370\t\n371\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\n372\t    // view-write transaction. An installed hook's throw aborts here —\n373\t    // before BEGIN — so the previous view keeps serving.\n374\t    fireViewInjection(\"compact-write\");\n375\t\n376\t    replaceViewSnapshot(db, {\n377\t      viewId,\n378\t      createdAt,\n379\t      compactPoint: selection.compactPoint,\n380\t      coveredFrom: selection.coveredFrom,\n381\t      profileName,\n382\t      configJson: JSON.stringify({\n383\t        lowerBound: merged.lowerBound,\n384\t        percentages: merged.percentages,\n385\t      }),\n386\t      arrangementJson: JSON.stringify(\n387\t        selection.entries.map((entry) => ({\n388\t          band: entry.band,\n389\t          subjectKind: entry.subjectKind,\n390\t          subjectId: entry.subjectId,\n391\t          formUsed: entry.formUsed,\n392\t          degraded: entry.degraded,\n393\t        })),\n394\t      ),\n395\t      gapsJson: JSON.stringify(\n396\t        selection.entries\n397\t          .filter((entry) => entry.gap)\n398\t          .map((entry) => ({\n399\t            band: entry.band,\n400\t            subjectId: entry.subjectId,\n401\t            reason: entry.reason ?? \"unknown\",\n402\t          })),\n403\t      ),\n404\t      sourceStateJson: JSON.stringify({\n405\t        maxEventOrder: inputs.maxEventOrder,\n406\t        formCounts: inputs.formCounts,\n407\t      }),\n408\t      bands,\n409\t    });\n410\t\n411\t    const bandReport = {} as CompactReceipt[\"bands\"];\n412\t    for (const band of BAND_ORDER) {\n413\t      const stored = bands.find((row) => row.band === band);\n414\t      bandReport[band] = {\n415\t        entries: entriesByBand(band).length,\n416\t        tokens: stored?.tokenCount ?? 0,\n417\t      };\n418\t    }\n419\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n420\t    return {\n421\t      ok: true,\n422\t      value: {\n423\t        viewId,\n424\t        profile: profileName,\n425\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n426\t        bands: bandReport,\n427\t        tailTokens,\n428\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n429\t        totalTokens:\n430\t          bandReport.brief.tokens +\n431\t          bandReport.detailed.tokens +\n432\t          bandReport.smooth.tokens +\n433\t          tailTokens,\n434\t        coveredFrom: selection.coveredFrom,\n435\t        compactPoint: selection.compactPoint,\n436\t        degraded: selection.entries\n437\t          .filter((entry) => entry.degraded)\n438\t          .map((entry) => ({\n439\t            band: entry.band,\n440\t            subjectId: entry.subjectId,\n441\t            usedForm: entry.formUsed,\n442\t          })),\n443\t        gaps: selection.entries\n444\t          .filter((entry) => entry.gap)\n445\t          .map((entry) => ({\n446\t            band: entry.band,\n447\t            subjectId: entry.subjectId,\n448\t            reason: entry.reason ?? \"unknown\",\n449\t          })),\n450\t        sweep: sweepOutcome,\n451\t      },\n452\t    };\n453\t  } catch (cause) {\n454\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n455\t  } finally {\n456\t    db.close();\n457\t  }\n458\t}\n459\t\n460\t// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n461\t\n462\t// The standalone readiness sweep: walk the owners' reports, requeue the\n463\t// transiently-failed forms through the owners' requeue surfaces, return the\n464\t// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n465\t// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n466\t// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n467\t// Story 5's process suite). Returns without waiting on any queued work\n468\t// (AC-3.2): requeues are row writes; background mode's drain heals later.\n469\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n470\t  const resolved = await resolveThreadRef(ref);\n471\t  if (!resolved.ok) return resolved;\n472\t  const { filePath } = resolved.value;\n473\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n474\t  try {\n475\t    return await runSweep(filePath);\n476\t  } catch (cause) {\n477\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\n478\t  }\n479\t}\n480\t\n481\t// ── stub (Story 5) ───────────────────────────────────────────────\n482\t\n483\t// The skeleton's stub contract (tech design §Interface Definitions):\n484\t// structured result, machine-readable, never a throw on this surface.\n485\tfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n486\t  return {\n487\t    ok: false,\n488\t    error: {\n489\t      errorClass: \"system_error\",\n490\t      code: \"not_implemented\",\n491\t      reason: `not implemented: ${op}`,\n492\t    },\n493\t  };\n494\t}\n495\t\n496\texport async function materialize(\n497\t  ref: ThreadRef,\n498\t  opts: { path: string; format?: \"pi-session\" },\n499\t): Promise<OpResult<{ writtenPath: string }>> {\n500\t  void ref;\n501\t  void opts;\n502\t  return notImplemented(\"materialize\");\n503\t}\n504\t\n505\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n506\texport {\n507\t  BUILT_IN_PROFILES,\n508\t  DEFAULT_COMPACT_THRESHOLD,\n509\t  DEFAULT_VISIBILITY,\n510\t  resolveViewConfig,\n511\t} from \"./internal/profiles.js\";\n512\t"}]},"parent_tool_use_id":null,"session_id":"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763","uuid":"eefd2a5c-498a-4162-a5bc-09caecb40c71","timestamp":"2026-06-11T17:29:24.305Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/index.ts","content":"// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n// deterministic string assembly only, no inference, no network, no queue\n// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n// Story 3 lands `sweep` (standalone and embedded default-on in compact).\n// `materialize` stays a structured-result stub until Story 5. Story 0's\n// substrate (profile resolution, consumed by createSdk) re-exports at the\n// bottom.\nimport { existsSync } from \"node:fs\";\nimport {\n  resolveInstanceViewConfig,\n  runWithThreadTouchSuppressed,\n} from \"../../shared/context.js\";\nimport type { FormReportEntry } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewProfile,\n  ViewStatus,\n} from \"../../shared/view.js\";\nimport * as messagesDomain from \"../messages/index.js\";\nimport * as turnsDomain from \"../turns/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport { readBoundaryPosition, visibilityZoneTokens } from \"./internal/boundary.js\";\nimport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\nimport {\n  assembleBandText,\n  renderBandMessage,\n  renderTailMessage,\n  toolNamesByCallId,\n} from \"./internal/render.js\";\nimport { fireViewInjection } from \"./internal/seam.js\";\nimport {\n  CanonicalCorruptionError,\n  readSelectionInputs,\n  selectArrangement,\n  type ArrangementEntry,\n} from \"./internal/select.js\";\nimport {\n  readReadyToolResultSummaries,\n  readTailMessages,\n  readViewSnapshot,\n  replaceViewSnapshot,\n  tailTokenSum,\n} from \"./internal/snapshot.js\";\nimport { runSweep } from \"./internal/sweep.js\";\nimport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\nimport type { Band } from \"../../shared/view.js\";\n\n// Config resolution for the operation in hand: the SDK instance's resolved\n// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n// through the same one resolution path createSdk uses.\nconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n\nfunction viewConfig(): ResolvedViewConfig {\n  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n\n// The hot-path read: view header + bands (if any), tail messages after the\n// compact point (deleted-filtered, record order), boundary position; then\n// format — band messages first, tail per the mapping table, tool results\n// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n// tail from event 1 (AC-1.3) through this same code path with the compact\n// point at its zero origin — snapshot-absent, never a separate branch.\n//\n// Reads-only is structural, not disciplined: the whole operation runs in the\n// touch-suppressed scope, so the open announcement that would let a\n// background SDK's scheduler hang a first-touch catch-up drain off this read\n// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n// AC-1.1's no-queue-interaction holds in both host modes.\nexport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  return runWithThreadTouchSuppressed(() => pullInner(ref));\n}\n\nasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const snapshot = readViewSnapshot(db);\n    const compactPoint = snapshot?.compactPoint ?? 0;\n    const boundaryPosition = readBoundaryPosition(db);\n    const tailRows = readTailMessages(db, compactPoint);\n    const renderCtx = {\n      boundaryPosition,\n      toolNameByCallId: toolNamesByCallId(tailRows),\n      toolResultSummaries: readReadyToolResultSummaries(db),\n    };\n\n    const messages: ViewMessage[] = [];\n    if (snapshot !== null) {\n      for (const band of snapshot.bands) {\n        messages.push(renderBandMessage(band.band, band.renderedText));\n      }\n    }\n    for (const row of tailRows) {\n      messages.push(renderTailMessage(row, renderCtx));\n    }\n\n    return {\n      ok: true,\n      value: {\n        messages,\n        meta: {\n          compactPoint: snapshot?.compactPoint ?? null,\n          coveredFrom: snapshot?.coveredFrom ?? null,\n          boundaryPosition,\n          gapCount: snapshot?.gapCount ?? 0,\n          degradedCount: snapshot?.degradedCount ?? 0,\n          viewId: snapshot?.viewId ?? null,\n          createdAt: snapshot?.createdAt ?? null,\n        },\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view pull failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── status (AC-2.8) ───────────────────────────────────────────────\n\n// Derivation counts bucket from one report entry the way the report's own\n// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n// pending, retrying (pending with attempts spent), failed, blocked. Ready\n// forms are healthy and not an operational situation.\nfunction bucketDerivation(\n  entries: readonly FormReportEntry[],\n  counts: ViewStatus[\"derivation\"],\n): void {\n  for (const entry of entries) {\n    switch (entry.state) {\n      case \"pending\":\n        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n        else counts.pending += 1;\n        break;\n      case \"failed\":\n        counts.failed += 1;\n        break;\n      case \"blocked\":\n        counts.blocked += 1;\n        break;\n      case \"ready\":\n        break;\n    }\n  }\n}\n\n// Reads only, callable any time, no side effects: tail size against the\n// configured trigger threshold with a compact recommendation (`tailTokens >\n// threshold`, nothing smarter — the caller owns policy), derivation counts\n// by state read through the OWNERS' report surfaces (must-not-own: never a\n// direct derived_form read here), the active view's health or null\n// pre-compact, and the visibility zone's sum against its max — computed live\n// by the same query the Story 4 advance will use, so \"visible in status\" is\n// structural, not stored.\n//\n// Like pull, the whole read — including the owners' report surfaces it\n// consumes — runs in the touch-suppressed scope, so a background SDK's\n// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n// host modes).\nexport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  return runWithThreadTouchSuppressed(() => statusInner(ref));\n}\n\nasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  let tailTokens: number;\n  let zoneTokens: number;\n  let view: ViewStatus[\"view\"];\n  try {\n    const snapshot = readViewSnapshot(db);\n    const compactPoint = snapshot?.compactPoint ?? 0;\n    const boundaryPosition = readBoundaryPosition(db);\n    tailTokens = tailTokenSum(db, compactPoint);\n    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n    view =\n      snapshot === null\n        ? null\n        : {\n            degraded: snapshot.degradedCount,\n            gaps: snapshot.gapCount,\n            builtAt: snapshot.createdAt,\n          };\n  } catch (cause) {\n    return storageFailure(`view status failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n\n  // The owners' report surfaces open their own handles; ours is closed first\n  // so the status read never holds two handles on one thread file.\n  const messageReport = await messagesDomain.report({ filePath });\n  if (!messageReport.ok) return messageReport;\n  const turnReport = await turnsDomain.report({ filePath });\n  if (!turnReport.ok) return turnReport;\n  const derivation: ViewStatus[\"derivation\"] = {\n    pending: 0,\n    retrying: 0,\n    failed: 0,\n    blocked: 0,\n  };\n  bucketDerivation(messageReport.value, derivation);\n  bucketDerivation(turnReport.value, derivation);\n\n  return {\n    ok: true,\n    value: {\n      tailTokens,\n      threshold: config.compactThreshold,\n      compactRecommended: tailTokens > config.compactThreshold,\n      derivation,\n      view,\n      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n    },\n  };\n}\n\n// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n\n// The default base when no profile is named: the first built-in, matching\n// the epic's primary user (the PI continuation harness). Explicit params\n// override the base field-wise (AC-2.2).\nconst DEFAULT_PROFILE_NAME = \"continuation\";\n\nfunction callerError(\n  code: \"unknown_profile\" | \"invalid_view_config\",\n  reason: string,\n): { ok: false; error: ErrorResult } {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n\n// Compact runs only when invoked through this surface (AC-2.1: no code path\n// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n// skips (AC-3.6; the receipt records which) → read record + forms with the\n// corruption check in the reads (pre-transaction, prior view trivially\n// intact on refusal) → selection walk → band rendering → one BEGIN\n// IMMEDIATE replacing the view and resetting the boundary → receipt.\n// Assembly is entirely from stored artifacts: nothing here can reach a\n// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n// through owners' requeue surfaces and calls no provider either).\nexport async function compact(\n  ref: ThreadRef,\n  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n): Promise<OpResult<CompactReceipt>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n  const base = config.profiles[baseName];\n  if (base === undefined) {\n    return callerError(\n      \"unknown_profile\",\n      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n        .map((name) => `\"${name}\"`)\n        .join(\", \")}`,\n    );\n  }\n  const merged: ViewProfile = {\n    name: base.name,\n    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n    percentages: { ...base.percentages, ...opts.params?.percentages },\n  };\n  const violation = profileViolation(merged);\n  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n  // any param override means the config is no longer a named profile's mix,\n  // even when one served as the merge base; the receipt's config carries the\n  // resolved truth. A bare or profile-only call names its profile.\n  const profileName = opts.params === undefined ? baseName : null;\n\n  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n  // leaves the thread healthier than it found it; `sweep: false` skips with\n  // the skip recorded in the receipt. Runs before this operation opens its\n  // own handle (the owners' surfaces open theirs), and before any view\n  // write — a sweep failure aborts the compact with the prior view intact.\n  let sweepOutcome: SweepReceipt | { skipped: true };\n  if (opts.sweep === false) {\n    sweepOutcome = { skipped: true };\n  } else {\n    const swept = await runSweep(filePath);\n    if (!swept.ok) return swept;\n    sweepOutcome = swept.value;\n  }\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    let inputs;\n    try {\n      inputs = readSelectionInputs(db);\n    } catch (cause) {\n      if (cause instanceof CanonicalCorruptionError) {\n        // Pre-transaction refusal: nothing was written, the prior view and\n        // the record are untouched (AC-2.5).\n        return {\n          ok: false,\n          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n        };\n      }\n      throw cause;\n    }\n    const selection = selectArrangement(inputs, {\n      lowerBound: merged.lowerBound,\n      percentages: merged.percentages,\n    });\n\n    const entriesByBand = (band: Band): ArrangementEntry[] =>\n      selection.entries.filter((entry) => entry.band === band);\n    const bands = BAND_ORDER.flatMap((band) => {\n      const entries = entriesByBand(band);\n      if (entries.length === 0) return [];\n      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n    });\n\n    const createdAt = new Date().toISOString();\n    // view_id is v<compact event order> — deterministic, and deliberately\n    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n    // into a uniqueness scheme; the singleton row is replaced whole).\n    const viewId = `v${inputs.maxEventOrder}`;\n\n    // Story-0 injection point: TC-2.4's crash between the sweep and the\n    // view-write transaction. An installed hook's throw aborts here —\n    // before BEGIN — so the previous view keeps serving.\n    fireViewInjection(\"compact-write\");\n\n    replaceViewSnapshot(db, {\n      viewId,\n      createdAt,\n      compactPoint: selection.compactPoint,\n      coveredFrom: selection.coveredFrom,\n      profileName,\n      configJson: JSON.stringify({\n        lowerBound: merged.lowerBound,\n        percentages: merged.percentages,\n      }),\n      arrangementJson: JSON.stringify(\n        selection.entries.map((entry) => ({\n          band: entry.band,\n          subjectKind: entry.subjectKind,\n          subjectId: entry.subjectId,\n          formUsed: entry.formUsed,\n          degraded: entry.degraded,\n        })),\n      ),\n      gapsJson: JSON.stringify(\n        selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n      ),\n      sourceStateJson: JSON.stringify({\n        maxEventOrder: inputs.maxEventOrder,\n        formCounts: inputs.formCounts,\n      }),\n      bands,\n    });\n\n    const bandReport = {} as CompactReceipt[\"bands\"];\n    for (const band of BAND_ORDER) {\n      const stored = bands.find((row) => row.band === band);\n      bandReport[band] = {\n        entries: entriesByBand(band).length,\n        tokens: stored?.tokenCount ?? 0,\n      };\n    }\n    const tailTokens = tailTokenSum(db, selection.compactPoint);\n    return {\n      ok: true,\n      value: {\n        viewId,\n        profile: profileName,\n        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n        bands: bandReport,\n        tailTokens,\n        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n        totalTokens:\n          bandReport.brief.tokens +\n          bandReport.detailed.tokens +\n          bandReport.smooth.tokens +\n          tailTokens,\n        coveredFrom: selection.coveredFrom,\n        compactPoint: selection.compactPoint,\n        degraded: selection.entries\n          .filter((entry) => entry.degraded)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            usedForm: entry.formUsed,\n          })),\n        gaps: selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n        sweep: sweepOutcome,\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view compact failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n\n// The standalone readiness sweep: walk the owners' reports, requeue the\n// transiently-failed forms through the owners' requeue surfaces, return the\n// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n// Story 5's process suite). Returns without waiting on any queued work\n// (AC-3.2): requeues are row writes; background mode's drain heals later.\nexport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n  try {\n    return await runSweep(filePath);\n  } catch (cause) {\n    return storageFailure(`view sweep failed: ${detail(cause)}`);\n  }\n}\n\n// ── stub (Story 5) ───────────────────────────────────────────────\n\n// The skeleton's stub contract (tech design §Interface Definitions):\n// structured result, machine-readable, never a throw on this surface.\nfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"system_error\",\n      code: \"not_implemented\",\n      reason: `not implemented: ${op}`,\n    },\n  };\n}\n\nexport async function materialize(\n  ref: ThreadRef,\n  opts: { path: string; format?: \"pi-session\" },\n): Promise<OpResult<{ writtenPath: string }>> {\n  void ref;\n  void opts;\n  return notImplemented(\"materialize\");\n}\n\n// ── Story 0 substrate (consumed by createSdk at construction) ─────\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n  resolveViewConfig,\n} from \"./internal/profiles.js\";\n","numLines":512,"startLine":1,"totalLines":512}}}

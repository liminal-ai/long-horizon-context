{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TMKjY6GcdJkFxFZJzbii7M","type":"tool_result","content":"1\t// Epic 03 Story 1: pull and status on the record (TC-1.1, TC-1.2, TC-1.4,\n2\t// TC-2.5 pre-compact legs, the per-kind tail-mapping legs, and the pull/status\n3\t// legs of the suite-wide zero-provider assertion). Every TC goes through the\n4\t// real SDK surface (createSdk().threadView.pull/status) against real temp\n5\t// thread files; the provider double appears only in construction/fixture\n6\t// setup — no Epic 03 operation may touch it.\n7\timport { createHash } from \"node:crypto\";\n8\timport { join } from \"node:path\";\n9\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n10\timport { createSdk, type Lhc, type SdkViewConfig, type ViewMessage } from \"../src/index.js\";\n11\timport {\n12\t  blockedSiblingThread,\n13\t  createProviderDouble,\n14\t  derivedThreadFixture,\n15\t  openRaw,\n16\t  seedViewBoundary,\n17\t  tempStore,\n18\t  validEvent,\n19\t  type DerivedThreadFixture,\n20\t  type TempStore,\n21\t} from \"./fixtures/index.js\";\n22\t\n23\tlet store: TempStore;\n24\tlet fixture: DerivedThreadFixture;\n25\t\n26\tbeforeAll(async () => {\n27\t  store = tempStore();\n28\t  fixture = await derivedThreadFixture(store);\n29\t});\n30\tafterAll(() => {\n31\t  store.cleanup();\n32\t});\n33\t\n34\tfunction manualSdk(view?: SdkViewConfig): Lhc {\n35\t  return createSdk({\n36\t    provider: createProviderDouble(),\n37\t    mode: \"manual\",\n38\t    ...(view === undefined ? {} : { view }),\n39\t  });\n40\t}\n41\t\n42\tasync function newThread(sdk: Lhc): Promise<string> {\n43\t  const filePath = store.threadPath();\n44\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n45\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n46\t  return filePath;\n47\t}\n48\t\n49\tasync function intake(sdk: Lhc, filePath: string, batch: Parameters<Lhc[\"intakeStream\"][\"messageEvents\"]>[1]): Promise<void> {\n50\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n51\t  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n52\t}\n53\t\n54\tfunction sha256(value: unknown): string {\n55\t  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n56\t}\n57\t\n58\tfunction workItemCount(filePath: string): number {\n59\t  const db = openRaw(filePath);\n60\t  try {\n61\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\n62\t      n: number | bigint;\n63\t    };\n64\t    return Number(row.n);\n65\t  } finally {\n66\t    db.close();\n67\t  }\n68\t}\n69\t\n70\t// Below-SDK read-only snapshot of everything a read could illegally mutate:\n71\t// queue rows, form states, view rows, boundary position (TC-1.2 / TC-2.5\n72\t// reads-only assertions).\n73\tfunction stateSnapshot(filePath: string): Record<string, unknown> {\n74\t  const db = openRaw(filePath);\n75\t  try {\n76\t    return {\n77\t      workItems: (\n78\t        db\n79\t          .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\n80\t          .all() as unknown as Array<{ work_item_id: string; status: string; attempts: number | bigint }>\n81\t      ).map((row) => ({ id: row.work_item_id, status: row.status, attempts: Number(row.attempts) })),\n82\t      forms: db\n83\t        .prepare(`SELECT subject_id, form, state FROM derived_form ORDER BY subject_id, form`)\n84\t        .all(),\n85\t      viewRows: Number(\n86\t        (db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as { n: number | bigint }).n,\n87\t      ),\n88\t      boundary: Number(\n89\t        (db.prepare(`SELECT position FROM view_boundary`).get() as { position: number | bigint })\n90\t          .position,\n91\t      ),\n92\t    };\n93\t  } finally {\n94\t    db.close();\n95\t  }\n96\t}\n97\t\n98\tdescribe(\"surface skeleton: unimplemented ops return structured results\", () => {\n99\t  // Epic 03 Story 2 (sanctioned amendment): compact is real now, so its\n100\t  // not-implemented leg moved out of this test; view-compact.test.ts owns the\n101\t  // operation. Story 3 (sanctioned amendment): sweep is real now too —\n102\t  // view-sweep.test.ts owns it. materialize stays stubbed until Story 5.\n103\t  it(\"materialize returns ok:false not-implemented, never throws\", async () => {\n104\t    const ref = { filePath: fixture.filePath };\n105\t    const materialized = await fixture.sdk.threadView.materialize(ref, {\n106\t      path: join(store.dir, \"out.jsonl\"),\n107\t    });\n108\t    expect(materialized).toEqual({\n109\t      ok: false,\n110\t      error: { errorClass: \"system_error\", code: \"not_implemented\", reason: \"not implemented: materialize\" },\n111\t    });\n112\t  });\n113\t});\n114\t\n115\tdescribe(\"TC-1.1 (AC-1.2, AC-1.3): never-compacted thread pulls the full conversation in order; later intake appends\", () => {\n116\t  it(\"carries both intake rounds in record order with tail-only meta\", async () => {\n117\t    const sdk = manualSdk();\n118\t    const filePath = await newThread(sdk);\n119\t    await intake(sdk, filePath, [\n120\t      validEvent(\"user_prompt\", { payload: { text: \"first question\" } }),\n121\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n122\t      validEvent(\"turn_end\"),\n123\t    ]);\n124\t\n125\t    const first = await sdk.threadView.pull({ filePath });\n126\t    expect(first.ok).toBe(true);\n127\t    if (!first.ok) return;\n128\t    expect(first.value.messages).toEqual([\n129\t      { role: \"user\", content: \"first question\" },\n130\t      { role: \"assistant\", content: \"first answer\" },\n131\t    ]);\n132\t    // Never compacted: no band content, no error, tail from event 1 (AC-1.3).\n133\t    expect(first.value.messages.every((m) => m.band === undefined)).toBe(true);\n134\t    expect(first.value.meta).toEqual({\n135\t      compactPoint: null,\n136\t      coveredFrom: null,\n137\t      boundaryPosition: 0,\n138\t      gapCount: 0,\n139\t      degradedCount: 0,\n140\t      viewId: null,\n141\t      createdAt: null,\n142\t    });\n143\t\n144\t    await intake(sdk, filePath, [\n145\t      validEvent(\"user_prompt\", { payload: { text: \"second question\" } }),\n146\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n147\t      validEvent(\"turn_end\"),\n148\t    ]);\n149\t    const second = await sdk.threadView.pull({ filePath });\n150\t    expect(second.ok).toBe(true);\n151\t    if (!second.ok) return;\n152\t    // All committed intake appears, in record order; the new batch appends\n153\t    // after the first round's messages, which are byte-unchanged (AC-1.2).\n154\t    expect(second.value.messages).toEqual([\n155\t      { role: \"user\", content: \"first question\" },\n156\t      { role: \"assistant\", content: \"first answer\" },\n157\t      { role: \"user\", content: \"second question\" },\n158\t      { role: \"assistant\", content: \"second answer\" },\n159\t    ]);\n160\t  });\n161\t});\n162\t\n163\tdescribe(\"TC-1.2 (AC-1.1, AC-1.7): two pulls with nothing between are byte-identical and create no work or provider calls\", () => {\n164\t  it(\"hashes identical, zero work rows created, provider double observes zero calls\", async () => {\n165\t    // The double's capture log starts recording here; any Epic 03 read that\n166\t    // touched the provider would append to it (zero-provider assertion, pull\n167\t    // leg of the suite-wide architecture-risk row).\n168\t    const captured = fixture.double.captureInputs();\n169\t    const before = stateSnapshot(fixture.filePath);\n170\t    const workRowsBefore = workItemCount(fixture.filePath);\n171\t\n172\t    const one = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n173\t    const two = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n174\t    expect(one.ok && two.ok).toBe(true);\n175\t    if (!one.ok || !two.ok) return;\n176\t\n177\t    // Byte-identical via the FULL serialized result, not field spot-checks\n178\t    // (story Anti-Shim Requirements).\n179\t    expect(sha256(one.value)).toBe(sha256(two.value));\n180\t    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n181\t\n182\t    expect(workItemCount(fixture.filePath)).toBe(workRowsBefore);\n183\t    expect(stateSnapshot(fixture.filePath)).toEqual(before);\n184\t    expect(captured.length).toBe(0);\n185\t  });\n186\t});\n187\t\n188\tdescribe(\"tail mapping legs (architecture-risk): one named leg per message kind\", () => {\n189\t  let sdk: Lhc;\n190\t  let filePath: string;\n191\t  let pulled: ViewMessage[];\n192\t\n193\t  beforeAll(async () => {\n194\t    sdk = manualSdk();\n195\t    filePath = await newThread(sdk);\n196\t    await intake(sdk, filePath, [\n197\t      validEvent(\"user_prompt\", { payload: { text: \"mapping prompt\" } }),\n198\t      validEvent(\"assistant_thinking\", { payload: { text: \"mapping thought\" } }),\n199\t      validEvent(\"tool_call\", {\n200\t        payload: { toolCallId: \"call-map-1\", toolName: \"read_file\", arguments: { path: \"map.txt\" } },\n201\t      }),\n202\t      validEvent(\"tool_result\", {\n203\t        payload: { toolCallId: \"call-map-1\", content: \"mapping output\", isError: false },\n204\t      }),\n205\t      validEvent(\"runtime_note\", { payload: { text: \"mapping note\" } }),\n206\t      validEvent(\"assistant_text\", { payload: { text: \"mapping answer\" } }),\n207\t      validEvent(\"turn_end\"),\n208\t    ]);\n209\t    const result = await sdk.threadView.pull({ filePath });\n210\t    if (!result.ok) throw new Error(`pull failed: ${result.error.reason}`);\n211\t    pulled = result.value.messages;\n212\t  });\n213\t\n214\t  it(\"user_prompt: user role, text verbatim\", () => {\n215\t    expect(pulled[0]).toEqual({ role: \"user\", content: \"mapping prompt\" });\n216\t  });\n217\t\n218\t  it(\"assistant_thinking: assistant role, fenced [thinking] block\", () => {\n219\t    expect(pulled[1]).toEqual({\n220\t      role: \"assistant\",\n221\t      content: \"[thinking]\\nmapping thought\\n[/thinking]\",\n222\t    });\n223\t  });\n224\t\n225\t  it(\"tool_call: assistant role, name marker plus deterministic arg rendering\", () => {\n226\t    expect(pulled[2]).toEqual({\n227\t      role: \"assistant\",\n228\t      content: '[tool call · read_file] {\"path\":\"map.txt\"}',\n229\t    });\n230\t  });\n231\t\n232\t  it(\"tool_result ahead of the boundary: user role, name marker plus full content\", () => {\n233\t    expect(pulled[3]).toEqual({\n234\t      role: \"user\",\n235\t      content: \"[tool result · read_file]\\nmapping output\",\n236\t    });\n237\t  });\n238\t\n239\t  it(\"runtime_note: user role, [runtime note] marker plus text\", () => {\n240\t    expect(pulled[4]).toEqual({ role: \"user\", content: \"[runtime note] mapping note\" });\n241\t  });\n242\t\n243\t  it(\"assistant_text: assistant role, text verbatim\", () => {\n244\t    expect(pulled[5]).toEqual({ role: \"assistant\", content: \"mapping answer\" });\n245\t  });\n246\t\n247\t  it(\"tool_result at-or-behind the boundary: abridged marker plus short form (boundary seeded below-SDK)\", async () => {\n248\t    const listed = await sdk.messages.listMessages({ filePath });\n249\t    expect(listed.ok).toBe(true);\n250\t    if (!listed.ok) return;\n251\t    const result = listed.value.find((m) => m.kind === \"tool_result\");\n252\t    expect(result).toBeDefined();\n253\t    if (result === undefined) return;\n254\t    seedViewBoundary(filePath, result.sourceEventOrder);\n255\t\n256\t    const repulled = await sdk.threadView.pull({ filePath });\n257\t    expect(repulled.ok).toBe(true);\n258\t    if (!repulled.ok) return;\n259\t    const short = repulled.value.messages[3];\n260\t    // Summaries are pending on this undrained thread: the short-form ladder\n261\t    // falls to the deterministic truncation rung (content under the limit\n262\t    // passes through whole), with the abridged marker and the record pointer.\n263\t    expect(short).toEqual({\n264\t      role: \"user\",\n265\t      content: `[tool result · read_file · abridged]\\nmapping output [full content in record §${result.messageId}]`,\n266\t    });\n267\t    expect(repulled.value.meta.boundaryPosition).toBe(result.sourceEventOrder);\n268\t  });\n269\t});\n270\t\n271\tdescribe(\"TC-1.4 (AC-1.5): boundary mid-tail — short behind, full ahead, non-tool content full everywhere\", () => {\n272\t  it(\"renders the ready summary behind the boundary and full content ahead of it\", async () => {\n273\t    const sdk = manualSdk();\n274\t    const filePath = await newThread(sdk);\n275\t    for (const turn of [1, 2]) {\n276\t      await intake(sdk, filePath, [\n277\t        validEvent(\"user_prompt\", { payload: { text: `boundary prompt ${turn}` } }),\n278\t        validEvent(\"assistant_thinking\", { payload: { text: `boundary thought ${turn}` } }),\n279\t        validEvent(\"tool_call\", {\n280\t          payload: {\n281\t            toolCallId: `call-bd-${turn}`,\n282\t            toolName: \"read_file\",\n283\t            arguments: { path: `bd-${turn}.txt` },\n284\t          },\n285\t        }),\n286\t        validEvent(\"tool_result\", {\n287\t          payload: { toolCallId: `call-bd-${turn}`, content: `boundary output ${turn}`, isError: false },\n288\t        }),\n289\t        validEvent(\"assistant_text\", { payload: { text: `boundary answer ${turn}` } }),\n290\t        validEvent(\"turn_end\"),\n291\t      ]);\n292\t    }\n293\t    // Drain through the real Epic 02 machinery so the tool-result summaries\n294\t    // are ready — the short-form ladder's first rung.\n295\t    const drained = await sdk.work.drain({ filePath });\n296\t    expect(drained.ok).toBe(true);\n297\t\n298\t    const listed = await sdk.messages.listMessages({ filePath });\n299\t    expect(listed.ok).toBe(true);\n300\t    if (!listed.ok) return;\n301\t    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n302\t    expect(results).toHaveLength(2);\n303\t    const [behind, ahead] = results;\n304\t    if (behind === undefined || ahead === undefined) return;\n305\t    const behindSummary = behind.forms?.find(\n306\t      (form) => form.form === \"tool_result_summary\" && form.state === \"ready\",\n307\t    );\n308\t    expect(behindSummary?.content).toBeDefined();\n309\t\n310\t    // The sanctioned below-SDK helper seeds the boundary mid-tail: at the\n311\t    // first result's event order (at-or-behind includes it), ahead of nothing\n312\t    // else. Boundary mechanics are Story 4's; only the position's effect on\n313\t    // rendering is under test here.\n314\t    seedViewBoundary(filePath, behind.sourceEventOrder);\n315\t\n316\t    const pull = await sdk.threadView.pull({ filePath });\n317\t    expect(pull.ok).toBe(true);\n318\t    if (!pull.ok) return;\n319\t    const contents = pull.value.messages.map((m) => m.content);\n320\t\n321\t    // Behind: short form — the ready summary verbatim, abridged marker,\n322\t    // record pointer.\n323\t    expect(contents).toContain(\n324\t      `[tool result · read_file · abridged]\\n${behindSummary?.content} [full content in record §${behind.messageId}]`,\n325\t    );\n326\t    // Ahead: full content.\n327\t    expect(contents).toContain(\"[tool result · read_file]\\nboundary output 2\");\n328\t    // Non-tool-result content renders full everywhere, both sides of the\n329\t    // boundary (prompts, thinking, assistant text).\n330\t    for (const turn of [1, 2]) {\n331\t      expect(contents).toContain(`boundary prompt ${turn}`);\n332\t      expect(contents).toContain(`[thinking]\\nboundary thought ${turn}\\n[/thinking]`);\n333\t      expect(contents).toContain(`boundary answer ${turn}`);\n334\t    }\n335\t  });\n336\t\n337\t  it(\"falls to deterministic truncation when no summary is ready and the content is oversized\", async () => {\n338\t    const sdk = manualSdk();\n339\t    const filePath = await newThread(sdk);\n340\t    const longContent = \"x\".repeat(260);\n341\t    await intake(sdk, filePath, [\n342\t      validEvent(\"user_prompt\", { payload: { text: \"truncation prompt\" } }),\n343\t      validEvent(\"tool_call\", {\n344\t        payload: { toolCallId: \"call-tr-1\", toolName: \"read_file\", arguments: { path: \"tr.txt\" } },\n345\t      }),\n346\t      validEvent(\"tool_result\", {\n347\t        payload: { toolCallId: \"call-tr-1\", content: longContent, isError: false },\n348\t      }),\n349\t      validEvent(\"turn_end\"),\n350\t    ]);\n351\t    // No drain: the summary stays pending, so the ladder's truncation rung\n352\t    // renders — fixed 200-char prefix plus the exact dropped-count marker\n353\t    // (Epic 01's abbreviation rule).\n354\t    const listed = await sdk.messages.listMessages({ filePath });\n355\t    expect(listed.ok).toBe(true);\n356\t    if (!listed.ok) return;\n357\t    const result = listed.value.find((m) => m.kind === \"tool_result\");\n358\t    if (result === undefined) return;\n359\t    seedViewBoundary(filePath, result.sourceEventOrder);\n360\t\n361\t    const pull = await sdk.threadView.pull({ filePath });\n362\t    expect(pull.ok).toBe(true);\n363\t    if (!pull.ok) return;\n364\t    const short = pull.value.messages.find((m) => m.content.startsWith(\"[tool result\"));\n365\t    expect(short?.content).toBe(\n366\t      `[tool result · read_file · abridged]\\n${\"x\".repeat(200)}… [truncated 60 chars] [full content in record §${result.messageId}]`,\n367\t    );\n368\t  });\n369\t});\n370\t\n371\tdescribe(\"TC-2.5 pre-compact legs (AC-2.8): the status read on a heavy thread\", () => {\n372\t  // TC-2.5's intake leg mutates its thread, so this describe builds its own\n373\t  // fixture instance instead of sharing the suite's read-only one.\n374\t  let heavyStore: TempStore;\n375\t  let heavy: DerivedThreadFixture;\n376\t  let statusSdk: Lhc;\n377\t\n378\t  beforeAll(async () => {\n379\t    heavyStore = tempStore();\n380\t    heavy = await derivedThreadFixture(heavyStore);\n381\t    // A low threshold makes the fixture \"heavy\" relative to config: the\n382\t    // recommendation must trip without any conversation-scale inflation.\n383\t    statusSdk = manualSdk({ compactThreshold: 100 });\n384\t  });\n385\t  afterAll(() => {\n386\t    heavyStore.cleanup();\n387\t  });\n388\t\n389\t  it(\"reports tail tokens vs threshold, recommendation, derivation counts, null view health, and the zone sum — reads only\", async () => {\n390\t    // Status legs of the zero-provider assertion: the builder's double\n391\t    // records every call from here on; status must add none.\n392\t    const captured = heavy.double.captureInputs();\n393\t    const before = stateSnapshot(heavy.filePath);\n394\t\n395\t    const status = await statusSdk.threadView.status({ filePath: heavy.filePath });\n396\t    expect(status.ok).toBe(true);\n397\t    if (!status.ok) return;\n398\t\n399\t    expect(status.value.threshold).toBe(100);\n400\t    expect(status.value.tailTokens).toBeGreaterThan(100);\n401\t    expect(status.value.compactRecommended).toBe(true);\n402\t\n403\t    // Derivation counts by state, from the owners' report surfaces: the\n404\t    // fixture's two scripted failures (transient-exhausted + permanent), all\n405\t    // other forms drained ready — nothing pending, retrying, or blocked here\n406\t    // (the blocked leg reads the sacrificial sibling below).\n407\t    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\n408\t\n409\t    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\n410\t    // here; the view-health legs complete in Story 2).\n411\t    expect(status.value.view).toBeNull();\n412\t\n413\t    // The visibility zone: boundary at its seeded default 0, so the sum is\n414\t    // every live tool result's estimate — cross-checked against the record.\n415\t    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\n416\t    expect(listed.ok).toBe(true);\n417\t    if (!listed.ok) return;\n418\t    const expectedZone = listed.value\n419\t      .filter((m) => m.kind === \"tool_result\")\n420\t      .reduce((sum, m) => sum + m.tokenEstimate, 0);\n421\t    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\n422\t\n423\t    // Reads only: no work rows, no form-state change, no view row, boundary\n424\t    // unmoved, zero provider calls — and no compact occurred uninvoked.\n425\t    expect(stateSnapshot(heavy.filePath)).toEqual(before);\n426\t    expect(captured.length).toBe(0);\n427\t  });\n428\t\n429\t  it(\"counts blocked forms through the owner's report (sacrificial sibling)\", async () => {\n430\t    const sibling = await blockedSiblingThread(heavyStore);\n431\t    const status = await sibling.sdk.threadView.status({ filePath: sibling.filePath });\n432\t    expect(status.ok).toBe(true);\n433\t    if (!status.ok) return;\n434\t    // The sibling's damaged turn landed both turn forms blocked through the\n435\t    // production terminal path (turn_rendering + lower_band_projection).\n436\t    expect(status.value.derivation.blocked).toBe(2);\n437\t    expect(status.value.view).toBeNull();\n438\t  });\n439\t\n440\t  it(\"after more intake the tail grew; still no compact without invocation\", async () => {\n441\t    const first = await statusSdk.threadView.status({ filePath: heavy.filePath });\n442\t    expect(first.ok).toBe(true);\n443\t    if (!first.ok) return;\n444\t\n445\t    await intake(heavy.sdk, heavy.filePath, [\n446\t      validEvent(\"user_prompt\", { payload: { text: \"one more question for the heavy thread\" } }),\n447\t      validEvent(\"assistant_text\", { payload: { text: \"one more answer for the heavy thread\" } }),\n448\t      validEvent(\"turn_end\"),\n449\t    ]);\n450\t\n451\t    const second = await statusSdk.threadView.status({ filePath: heavy.filePath });\n452\t    expect(second.ok).toBe(true);\n453\t    if (!second.ok) return;\n454\t    expect(second.value.tailTokens).toBeGreaterThan(first.value.tailTokens);\n455\t    expect(second.value.view).toBeNull();\n456\t    expect(stateSnapshot(heavy.filePath)[\"viewRows\"]).toBe(0);\n457\t  });\n458\t});\n459\t\n460\tdescribe(\"TC-1.2 / TC-2.5 background legs (SV-01-PULL-STATUS-001): pull and status are reads-only in a background SDK with pending work queued\", () => {\n461\t  it(\"schedules no catch-up drain: work rows, form states, provider count, and status all unchanged; repeated pulls byte-identical\", async () => {\n462\t    // Pending work manufactured through a manual SDK (its no-op seam never\n463\t    // drains): one tool-heavy turn leaves live queue rows and pending forms.\n464\t    const seeder = manualSdk();\n465\t    const filePath = await newThread(seeder);\n466\t    await intake(seeder, filePath, [\n467\t      validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n468\t      validEvent(\"tool_call\", {\n469\t        payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n470\t      }),\n471\t      validEvent(\"tool_result\", {\n472\t        payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n473\t      }),\n474\t      validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n475\t      validEvent(\"turn_end\"),\n476\t    ]);\n477\t    expect(workItemCount(filePath)).toBeGreaterThan(0);\n478\t\n479\t    // The production background path: a fresh background SDK whose scheduler\n480\t    // WOULD hang a first-touch catch-up drain off the open announcement\n481\t    // (openThreadDatabase → fireThreadTouch → scheduler.touch) if pull or\n482\t    // status fired it — the SV-01-PULL-STATUS-001 side-effect path.\n483\t    const bgDouble = createProviderDouble();\n484\t    const bg = createSdk({\n485\t      provider: bgDouble,\n486\t      mode: \"background\",\n487\t      view: { compactThreshold: 100 },\n488\t    });\n489\t    const captured = bgDouble.captureInputs();\n490\t    const before = stateSnapshot(filePath);\n491\t\n492\t    const one = await bg.threadView.pull({ filePath });\n493\t    const firstStatus = await bg.threadView.status({ filePath });\n494\t    const two = await bg.threadView.pull({ filePath });\n495\t    expect(one.ok && two.ok && firstStatus.ok).toBe(true);\n496\t    if (!one.ok || !two.ok || !firstStatus.ok) return;\n497\t\n498\t    // The pending work is visible through the read itself (never-attempted\n499\t    // forms bucket as pending) — proof the reads ran against live queue rows.\n500\t    expect(firstStatus.value.derivation.pending).toBeGreaterThan(0);\n501\t\n502\t    // Give any wrongly-scheduled catch-up drain room to surface, then wait\n503\t    // out the scheduler before asserting nothing happened.\n504\t    await new Promise((resolve) => setTimeout(resolve, 25));\n505\t    await bg.drainSettled({ filePath });\n506\t\n507\t    // Byte-identical repeated pulls (AC-1.7) in background mode.\n508\t    expect(sha256(one.value)).toBe(sha256(two.value));\n509\t    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n510\t\n511\t    // Reads only: queue rows, form states, view rows, and boundary all\n512\t    // unchanged; the provider fake observed zero calls.\n513\t    expect(stateSnapshot(filePath)).toEqual(before);\n514\t    expect(captured.length).toBe(0);\n515\t\n516\t    // The status read repeats unchanged too — no state moved underneath it.\n517\t    const secondStatus = await bg.threadView.status({ filePath });\n518\t    expect(secondStatus.ok).toBe(true);\n519\t    if (!secondStatus.ok) return;\n520\t    expect(JSON.stringify(secondStatus.value)).toBe(JSON.stringify(firstStatus.value));\n521\t  });\n522\t});\n523\t"}]},"parent_tool_use_id":null,"session_id":"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763","uuid":"cad3bc16-34b7-4c40-b12a-09eca823ba2c","timestamp":"2026-06-11T17:32:12.728Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-pull.test.ts","content":"// Epic 03 Story 1: pull and status on the record (TC-1.1, TC-1.2, TC-1.4,\n// TC-2.5 pre-compact legs, the per-kind tail-mapping legs, and the pull/status\n// legs of the suite-wide zero-provider assertion). Every TC goes through the\n// real SDK surface (createSdk().threadView.pull/status) against real temp\n// thread files; the provider double appears only in construction/fixture\n// setup — no Epic 03 operation may touch it.\nimport { createHash } from \"node:crypto\";\nimport { join } from \"node:path\";\nimport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\nimport { createSdk, type Lhc, type SdkViewConfig, type ViewMessage } from \"../src/index.js\";\nimport {\n  blockedSiblingThread,\n  createProviderDouble,\n  derivedThreadFixture,\n  openRaw,\n  seedViewBoundary,\n  tempStore,\n  validEvent,\n  type DerivedThreadFixture,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nlet fixture: DerivedThreadFixture;\n\nbeforeAll(async () => {\n  store = tempStore();\n  fixture = await derivedThreadFixture(store);\n});\nafterAll(() => {\n  store.cleanup();\n});\n\nfunction manualSdk(view?: SdkViewConfig): Lhc {\n  return createSdk({\n    provider: createProviderDouble(),\n    mode: \"manual\",\n    ...(view === undefined ? {} : { view }),\n  });\n}\n\nasync function newThread(sdk: Lhc): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function intake(sdk: Lhc, filePath: string, batch: Parameters<Lhc[\"intakeStream\"][\"messageEvents\"]>[1]): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n}\n\nfunction sha256(value: unknown): string {\n  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n}\n\nfunction workItemCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\n      n: number | bigint;\n    };\n    return Number(row.n);\n  } finally {\n    db.close();\n  }\n}\n\n// Below-SDK read-only snapshot of everything a read could illegally mutate:\n// queue rows, form states, view rows, boundary position (TC-1.2 / TC-2.5\n// reads-only assertions).\nfunction stateSnapshot(filePath: string): Record<string, unknown> {\n  const db = openRaw(filePath);\n  try {\n    return {\n      workItems: (\n        db\n          .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\n          .all() as unknown as Array<{ work_item_id: string; status: string; attempts: number | bigint }>\n      ).map((row) => ({ id: row.work_item_id, status: row.status, attempts: Number(row.attempts) })),\n      forms: db\n        .prepare(`SELECT subject_id, form, state FROM derived_form ORDER BY subject_id, form`)\n        .all(),\n      viewRows: Number(\n        (db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as { n: number | bigint }).n,\n      ),\n      boundary: Number(\n        (db.prepare(`SELECT position FROM view_boundary`).get() as { position: number | bigint })\n          .position,\n      ),\n    };\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"surface skeleton: unimplemented ops return structured results\", () => {\n  // Epic 03 Story 2 (sanctioned amendment): compact is real now, so its\n  // not-implemented leg moved out of this test; view-compact.test.ts owns the\n  // operation. Story 3 (sanctioned amendment): sweep is real now too —\n  // view-sweep.test.ts owns it. materialize stays stubbed until Story 5.\n  it(\"materialize returns ok:false not-implemented, never throws\", async () => {\n    const ref = { filePath: fixture.filePath };\n    const materialized = await fixture.sdk.threadView.materialize(ref, {\n      path: join(store.dir, \"out.jsonl\"),\n    });\n    expect(materialized).toEqual({\n      ok: false,\n      error: { errorClass: \"system_error\", code: \"not_implemented\", reason: \"not implemented: materialize\" },\n    });\n  });\n});\n\ndescribe(\"TC-1.1 (AC-1.2, AC-1.3): never-compacted thread pulls the full conversation in order; later intake appends\", () => {\n  it(\"carries both intake rounds in record order with tail-only meta\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"first question\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const first = await sdk.threadView.pull({ filePath });\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.messages).toEqual([\n      { role: \"user\", content: \"first question\" },\n      { role: \"assistant\", content: \"first answer\" },\n    ]);\n    // Never compacted: no band content, no error, tail from event 1 (AC-1.3).\n    expect(first.value.messages.every((m) => m.band === undefined)).toBe(true);\n    expect(first.value.meta).toEqual({\n      compactPoint: null,\n      coveredFrom: null,\n      boundaryPosition: 0,\n      gapCount: 0,\n      degradedCount: 0,\n      viewId: null,\n      createdAt: null,\n    });\n\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"second question\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    const second = await sdk.threadView.pull({ filePath });\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    // All committed intake appears, in record order; the new batch appends\n    // after the first round's messages, which are byte-unchanged (AC-1.2).\n    expect(second.value.messages).toEqual([\n      { role: \"user\", content: \"first question\" },\n      { role: \"assistant\", content: \"first answer\" },\n      { role: \"user\", content: \"second question\" },\n      { role: \"assistant\", content: \"second answer\" },\n    ]);\n  });\n});\n\ndescribe(\"TC-1.2 (AC-1.1, AC-1.7): two pulls with nothing between are byte-identical and create no work or provider calls\", () => {\n  it(\"hashes identical, zero work rows created, provider double observes zero calls\", async () => {\n    // The double's capture log starts recording here; any Epic 03 read that\n    // touched the provider would append to it (zero-provider assertion, pull\n    // leg of the suite-wide architecture-risk row).\n    const captured = fixture.double.captureInputs();\n    const before = stateSnapshot(fixture.filePath);\n    const workRowsBefore = workItemCount(fixture.filePath);\n\n    const one = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    const two = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    expect(one.ok && two.ok).toBe(true);\n    if (!one.ok || !two.ok) return;\n\n    // Byte-identical via the FULL serialized result, not field spot-checks\n    // (story Anti-Shim Requirements).\n    expect(sha256(one.value)).toBe(sha256(two.value));\n    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n\n    expect(workItemCount(fixture.filePath)).toBe(workRowsBefore);\n    expect(stateSnapshot(fixture.filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n  });\n});\n\ndescribe(\"tail mapping legs (architecture-risk): one named leg per message kind\", () => {\n  let sdk: Lhc;\n  let filePath: string;\n  let pulled: ViewMessage[];\n\n  beforeAll(async () => {\n    sdk = manualSdk();\n    filePath = await newThread(sdk);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"mapping prompt\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"mapping thought\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-map-1\", toolName: \"read_file\", arguments: { path: \"map.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-map-1\", content: \"mapping output\", isError: false },\n      }),\n      validEvent(\"runtime_note\", { payload: { text: \"mapping note\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"mapping answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    const result = await sdk.threadView.pull({ filePath });\n    if (!result.ok) throw new Error(`pull failed: ${result.error.reason}`);\n    pulled = result.value.messages;\n  });\n\n  it(\"user_prompt: user role, text verbatim\", () => {\n    expect(pulled[0]).toEqual({ role: \"user\", content: \"mapping prompt\" });\n  });\n\n  it(\"assistant_thinking: assistant role, fenced [thinking] block\", () => {\n    expect(pulled[1]).toEqual({\n      role: \"assistant\",\n      content: \"[thinking]\\nmapping thought\\n[/thinking]\",\n    });\n  });\n\n  it(\"tool_call: assistant role, name marker plus deterministic arg rendering\", () => {\n    expect(pulled[2]).toEqual({\n      role: \"assistant\",\n      content: '[tool call · read_file] {\"path\":\"map.txt\"}',\n    });\n  });\n\n  it(\"tool_result ahead of the boundary: user role, name marker plus full content\", () => {\n    expect(pulled[3]).toEqual({\n      role: \"user\",\n      content: \"[tool result · read_file]\\nmapping output\",\n    });\n  });\n\n  it(\"runtime_note: user role, [runtime note] marker plus text\", () => {\n    expect(pulled[4]).toEqual({ role: \"user\", content: \"[runtime note] mapping note\" });\n  });\n\n  it(\"assistant_text: assistant role, text verbatim\", () => {\n    expect(pulled[5]).toEqual({ role: \"assistant\", content: \"mapping answer\" });\n  });\n\n  it(\"tool_result at-or-behind the boundary: abridged marker plus short form (boundary seeded below-SDK)\", async () => {\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const result = listed.value.find((m) => m.kind === \"tool_result\");\n    expect(result).toBeDefined();\n    if (result === undefined) return;\n    seedViewBoundary(filePath, result.sourceEventOrder);\n\n    const repulled = await sdk.threadView.pull({ filePath });\n    expect(repulled.ok).toBe(true);\n    if (!repulled.ok) return;\n    const short = repulled.value.messages[3];\n    // Summaries are pending on this undrained thread: the short-form ladder\n    // falls to the deterministic truncation rung (content under the limit\n    // passes through whole), with the abridged marker and the record pointer.\n    expect(short).toEqual({\n      role: \"user\",\n      content: `[tool result · read_file · abridged]\\nmapping output [full content in record §${result.messageId}]`,\n    });\n    expect(repulled.value.meta.boundaryPosition).toBe(result.sourceEventOrder);\n  });\n});\n\ndescribe(\"TC-1.4 (AC-1.5): boundary mid-tail — short behind, full ahead, non-tool content full everywhere\", () => {\n  it(\"renders the ready summary behind the boundary and full content ahead of it\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    for (const turn of [1, 2]) {\n      await intake(sdk, filePath, [\n        validEvent(\"user_prompt\", { payload: { text: `boundary prompt ${turn}` } }),\n        validEvent(\"assistant_thinking\", { payload: { text: `boundary thought ${turn}` } }),\n        validEvent(\"tool_call\", {\n          payload: {\n            toolCallId: `call-bd-${turn}`,\n            toolName: \"read_file\",\n            arguments: { path: `bd-${turn}.txt` },\n          },\n        }),\n        validEvent(\"tool_result\", {\n          payload: { toolCallId: `call-bd-${turn}`, content: `boundary output ${turn}`, isError: false },\n        }),\n        validEvent(\"assistant_text\", { payload: { text: `boundary answer ${turn}` } }),\n        validEvent(\"turn_end\"),\n      ]);\n    }\n    // Drain through the real Epic 02 machinery so the tool-result summaries\n    // are ready — the short-form ladder's first rung.\n    const drained = await sdk.work.drain({ filePath });\n    expect(drained.ok).toBe(true);\n\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n    expect(results).toHaveLength(2);\n    const [behind, ahead] = results;\n    if (behind === undefined || ahead === undefined) return;\n    const behindSummary = behind.forms?.find(\n      (form) => form.form === \"tool_result_summary\" && form.state === \"ready\",\n    );\n    expect(behindSummary?.content).toBeDefined();\n\n    // The sanctioned below-SDK helper seeds the boundary mid-tail: at the\n    // first result's event order (at-or-behind includes it), ahead of nothing\n    // else. Boundary mechanics are Story 4's; only the position's effect on\n    // rendering is under test here.\n    seedViewBoundary(filePath, behind.sourceEventOrder);\n\n    const pull = await sdk.threadView.pull({ filePath });\n    expect(pull.ok).toBe(true);\n    if (!pull.ok) return;\n    const contents = pull.value.messages.map((m) => m.content);\n\n    // Behind: short form — the ready summary verbatim, abridged marker,\n    // record pointer.\n    expect(contents).toContain(\n      `[tool result · read_file · abridged]\\n${behindSummary?.content} [full content in record §${behind.messageId}]`,\n    );\n    // Ahead: full content.\n    expect(contents).toContain(\"[tool result · read_file]\\nboundary output 2\");\n    // Non-tool-result content renders full everywhere, both sides of the\n    // boundary (prompts, thinking, assistant text).\n    for (const turn of [1, 2]) {\n      expect(contents).toContain(`boundary prompt ${turn}`);\n      expect(contents).toContain(`[thinking]\\nboundary thought ${turn}\\n[/thinking]`);\n      expect(contents).toContain(`boundary answer ${turn}`);\n    }\n  });\n\n  it(\"falls to deterministic truncation when no summary is ready and the content is oversized\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    const longContent = \"x\".repeat(260);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"truncation prompt\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-tr-1\", toolName: \"read_file\", arguments: { path: \"tr.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-tr-1\", content: longContent, isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ]);\n    // No drain: the summary stays pending, so the ladder's truncation rung\n    // renders — fixed 200-char prefix plus the exact dropped-count marker\n    // (Epic 01's abbreviation rule).\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const result = listed.value.find((m) => m.kind === \"tool_result\");\n    if (result === undefined) return;\n    seedViewBoundary(filePath, result.sourceEventOrder);\n\n    const pull = await sdk.threadView.pull({ filePath });\n    expect(pull.ok).toBe(true);\n    if (!pull.ok) return;\n    const short = pull.value.messages.find((m) => m.content.startsWith(\"[tool result\"));\n    expect(short?.content).toBe(\n      `[tool result · read_file · abridged]\\n${\"x\".repeat(200)}… [truncated 60 chars] [full content in record §${result.messageId}]`,\n    );\n  });\n});\n\ndescribe(\"TC-2.5 pre-compact legs (AC-2.8): the status read on a heavy thread\", () => {\n  // TC-2.5's intake leg mutates its thread, so this describe builds its own\n  // fixture instance instead of sharing the suite's read-only one.\n  let heavyStore: TempStore;\n  let heavy: DerivedThreadFixture;\n  let statusSdk: Lhc;\n\n  beforeAll(async () => {\n    heavyStore = tempStore();\n    heavy = await derivedThreadFixture(heavyStore);\n    // A low threshold makes the fixture \"heavy\" relative to config: the\n    // recommendation must trip without any conversation-scale inflation.\n    statusSdk = manualSdk({ compactThreshold: 100 });\n  });\n  afterAll(() => {\n    heavyStore.cleanup();\n  });\n\n  it(\"reports tail tokens vs threshold, recommendation, derivation counts, null view health, and the zone sum — reads only\", async () => {\n    // Status legs of the zero-provider assertion: the builder's double\n    // records every call from here on; status must add none.\n    const captured = heavy.double.captureInputs();\n    const before = stateSnapshot(heavy.filePath);\n\n    const status = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n\n    expect(status.value.threshold).toBe(100);\n    expect(status.value.tailTokens).toBeGreaterThan(100);\n    expect(status.value.compactRecommended).toBe(true);\n\n    // Derivation counts by state, from the owners' report surfaces: the\n    // fixture's two scripted failures (transient-exhausted + permanent), all\n    // other forms drained ready — nothing pending, retrying, or blocked here\n    // (the blocked leg reads the sacrificial sibling below).\n    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\n\n    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\n    // here; the view-health legs complete in Story 2).\n    expect(status.value.view).toBeNull();\n\n    // The visibility zone: boundary at its seeded default 0, so the sum is\n    // every live tool result's estimate — cross-checked against the record.\n    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const expectedZone = listed.value\n      .filter((m) => m.kind === \"tool_result\")\n      .reduce((sum, m) => sum + m.tokenEstimate, 0);\n    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\n\n    // Reads only: no work rows, no form-state change, no view row, boundary\n    // unmoved, zero provider calls — and no compact occurred uninvoked.\n    expect(stateSnapshot(heavy.filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n  });\n\n  it(\"counts blocked forms through the owner's report (sacrificial sibling)\", async () => {\n    const sibling = await blockedSiblingThread(heavyStore);\n    const status = await sibling.sdk.threadView.status({ filePath: sibling.filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    // The sibling's damaged turn landed both turn forms blocked through the\n    // production terminal path (turn_rendering + lower_band_projection).\n    expect(status.value.derivation.blocked).toBe(2);\n    expect(status.value.view).toBeNull();\n  });\n\n  it(\"after more intake the tail grew; still no compact without invocation\", async () => {\n    const first = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n\n    await intake(heavy.sdk, heavy.filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"one more question for the heavy thread\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"one more answer for the heavy thread\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const second = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    expect(second.value.tailTokens).toBeGreaterThan(first.value.tailTokens);\n    expect(second.value.view).toBeNull();\n    expect(stateSnapshot(heavy.filePath)[\"viewRows\"]).toBe(0);\n  });\n});\n\ndescribe(\"TC-1.2 / TC-2.5 background legs (SV-01-PULL-STATUS-001): pull and status are reads-only in a background SDK with pending work queued\", () => {\n  it(\"schedules no catch-up drain: work rows, form states, provider count, and status all unchanged; repeated pulls byte-identical\", async () => {\n    // Pending work manufactured through a manual SDK (its no-op seam never\n    // drains): one tool-heavy turn leaves live queue rows and pending forms.\n    const seeder = manualSdk();\n    const filePath = await newThread(seeder);\n    await intake(seeder, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n      }),\n      validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(workItemCount(filePath)).toBeGreaterThan(0);\n\n    // The production background path: a fresh background SDK whose scheduler\n    // WOULD hang a first-touch catch-up drain off the open announcement\n    // (openThreadDatabase → fireThreadTouch → scheduler.touch) if pull or\n    // status fired it — the SV-01-PULL-STATUS-001 side-effect path.\n    const bgDouble = createProviderDouble();\n    const bg = createSdk({\n      provider: bgDouble,\n      mode: \"background\",\n      view: { compactThreshold: 100 },\n    });\n    const captured = bgDouble.captureInputs();\n    const before = stateSnapshot(filePath);\n\n    const one = await bg.threadView.pull({ filePath });\n    const firstStatus = await bg.threadView.status({ filePath });\n    const two = await bg.threadView.pull({ filePath });\n    expect(one.ok && two.ok && firstStatus.ok).toBe(true);\n    if (!one.ok || !two.ok || !firstStatus.ok) return;\n\n    // The pending work is visible through the read itself (never-attempted\n    // forms bucket as pending) — proof the reads ran against live queue rows.\n    expect(firstStatus.value.derivation.pending).toBeGreaterThan(0);\n\n    // Give any wrongly-scheduled catch-up drain room to surface, then wait\n    // out the scheduler before asserting nothing happened.\n    await new Promise((resolve) => setTimeout(resolve, 25));\n    await bg.drainSettled({ filePath });\n\n    // Byte-identical repeated pulls (AC-1.7) in background mode.\n    expect(sha256(one.value)).toBe(sha256(two.value));\n    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n\n    // Reads only: queue rows, form states, view rows, and boundary all\n    // unchanged; the provider fake observed zero calls.\n    expect(stateSnapshot(filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n\n    // The status read repeats unchanged too — no state moved underneath it.\n    const secondStatus = await bg.threadView.status({ filePath });\n    expect(secondStatus.ok).toBe(true);\n    if (!secondStatus.ok) return;\n    expect(JSON.stringify(secondStatus.value)).toBe(JSON.stringify(firstStatus.value));\n  });\n});\n","numLines":523,"startLine":1,"totalLines":523}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FTdeeXVKFSTZfeewvhcwPR","type":"tool_result","content":"1\t// Epic 03 Story 2: selection goldens G1–G4 (architecture-risk). Exact\n2\t// arrangements against committed JSON (test/goldens/) — the only guard that\n3\t// catches tie-breaker drift (≤ vs <, newest-first ordering, newest-member\n4\t// chunk coverage) that replay-on-the-same-engine cannot. Each case runs a\n5\t// REAL compact through the SDK surface and compares the stored arrangement,\n6\t// compact point, covered_from, and gaps verbatim against the golden.\n7\t//\n8\t// Goldens are immutable once committed: an implementation that disagrees\n9\t// with one is wrong until the design rule is shown wrong (deviation process,\n10\t// never a golden edit). Regeneration instructions: test/goldens/README.md\n11\t// (GOLDEN_DUMP=1 prints actuals).\n12\timport { readFileSync } from \"node:fs\";\n13\timport { join } from \"node:path\";\n14\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n15\timport type { Lhc } from \"../src/index.js\";\n16\timport {\n17\t  derivedThreadFixture,\n18\t  openRaw,\n19\t  stragglerVariantThread,\n20\t  tempStore,\n21\t  type DerivedThreadFixture,\n22\t  type TempStore,\n23\t} from \"./fixtures/index.js\";\n24\t\n25\tinterface Golden {\n26\t  case: string;\n27\t  fixture: \"derived-thread\" | \"straggler-variant\";\n28\t  params: {\n29\t    lowerBound: number;\n30\t    percentages: { full: number; smooth: number; detailed: number; brief: number };\n31\t  };\n32\t  compactPoint: number;\n33\t  coveredFrom: number;\n34\t  arrangement: Array<{\n35\t    band: string;\n36\t    subjectKind: string;\n37\t    subjectId: string;\n38\t    formUsed: string;\n39\t    degraded: boolean;\n40\t  }>;\n41\t  gaps: Array<{ band: string; subjectId: string; reason: string }>;\n42\t}\n43\t\n44\tfunction loadGolden(name: string): Golden {\n45\t  return JSON.parse(\n46\t    readFileSync(join(import.meta.dirname, \"goldens\", name), \"utf8\"),\n47\t  ) as Golden;\n48\t}\n49\t\n50\tinterface StoredView {\n51\t  compactPoint: number;\n52\t  coveredFrom: number;\n53\t  arrangement: Golden[\"arrangement\"];\n54\t  gaps: Golden[\"gaps\"];\n55\t}\n56\t\n57\tfunction readStoredView(filePath: string): StoredView {\n58\t  const db = openRaw(filePath);\n59\t  try {\n60\t    const row = db\n61\t      .prepare(\n62\t        `SELECT compact_point, covered_from, arrangement_json, gaps_json\n63\t         FROM thread_view WHERE singleton = 1`,\n64\t      )\n65\t      .get() as\n66\t      | {\n67\t          compact_point: number | bigint;\n68\t          covered_from: number | bigint;\n69\t          arrangement_json: string;\n70\t          gaps_json: string;\n71\t        }\n72\t      | undefined;\n73\t    if (row === undefined) throw new Error(\"no view row after compact\");\n74\t    return {\n75\t      compactPoint: Number(row.compact_point),\n76\t      coveredFrom: Number(row.covered_from),\n77\t      arrangement: JSON.parse(row.arrangement_json) as Golden[\"arrangement\"],\n78\t      gaps: JSON.parse(row.gaps_json) as Golden[\"gaps\"],\n79\t    };\n80\t  } finally {\n81\t    db.close();\n82\t  }\n83\t}\n84\t\n85\tlet store: TempStore;\n86\tlet fixture: DerivedThreadFixture;\n87\tlet straggler: DerivedThreadFixture;\n88\t\n89\tbeforeAll(async () => {\n90\t  store = tempStore();\n91\t  fixture = await derivedThreadFixture(store);\n92\t  straggler = await stragglerVariantThread(store);\n93\t});\n94\tafterAll(() => {\n95\t  store.cleanup();\n96\t});\n97\t\n98\tasync function runGolden(golden: Golden): Promise<StoredView> {\n99\t  const target = golden.fixture === \"straggler-variant\" ? straggler : fixture;\n100\t  const receipt = await target.sdk.threadView.compact(\n101\t    { filePath: target.filePath },\n102\t    { params: golden.params },\n103\t  );\n104\t  expect(receipt.ok).toBe(true);\n105\t  if (!receipt.ok) throw new Error(receipt.error.reason);\n106\t  const stored = readStoredView(target.filePath);\n107\t  if (process.env[\"GOLDEN_DUMP\"] === \"1\") {\n108\t    console.log(`${golden.case}\\n${JSON.stringify(stored, null, 2)}`);\n109\t  }\n110\t  // Receipt and stored row agree (one selection, two reports).\n111\t  expect(receipt.value.compactPoint).toBe(stored.compactPoint);\n112\t  expect(receipt.value.coveredFrom).toBe(stored.coveredFrom);\n113\t  return stored;\n114\t}\n115\t\n116\tfunction expectMatches(stored: StoredView, golden: Golden): void {\n117\t  expect(stored.compactPoint).toBe(golden.compactPoint);\n118\t  expect(stored.coveredFrom).toBe(golden.coveredFrom);\n119\t  expect(stored.arrangement).toEqual(golden.arrangement);\n120\t  expect(stored.gaps).toEqual(golden.gaps);\n121\t}\n122\t\n123\tdescribe(\"selection goldens G1–G4 (committed JSON, exact arrangements)\", () => {\n124\t  it(\"G1 proportions: shares fill the full gradient as committed\", async () => {\n125\t    const golden = loadGolden(\"g1-proportions.json\");\n126\t    expectMatches(await runGolden(golden), golden);\n127\t  });\n128\t\n129\t  it(\"G2a budget edge: a turn exactly filling the smooth remainder is included (≤ rule)\", async () => {\n130\t    const golden = loadGolden(\"g2-edge-inclusion.json\");\n131\t    expectMatches(await runGolden(golden), golden);\n132\t  });\n133\t\n134\t  it(\"G2b budget edge: one token under the exact fill excludes the turn and stops the band\", async () => {\n135\t    const golden = loadGolden(\"g2-edge-exclusion.json\");\n136\t    expectMatches(await runGolden(golden), golden);\n137\t  });\n138\t\n139\t  it(\"G3 oversized loner: a single turn larger than the whole smooth budget represents alone\", async () => {\n140\t    const golden = loadGolden(\"g3-oversized-loner.json\");\n141\t    const stored = await runGolden(golden);\n142\t    expectMatches(stored, golden);\n143\t    // The loner condition itself: exactly one smooth entry, and the smooth\n144\t    // budget (250 × 4% = 10) is smaller than any turn entry could render.\n145\t    expect(stored.arrangement.filter((entry) => entry.band === \"smooth\")).toHaveLength(1);\n146\t  });\n147\t\n148\t  it(\"G4 turnless straggler: the note rides the following turn's band entry; the trailing note is tail\", async () => {\n149\t    const golden = loadGolden(\"g4-turnless-straggler.json\");\n150\t    const stored = await runGolden(golden);\n151\t    expectMatches(stored, golden);\n152\t\n153\t    // Rule 6's rendering halves, beyond the arrangement: the between-turns\n154\t    // note renders raw with its marker immediately before c2's entry (t4's\n155\t    // representation), and the trailing note pulls as tail.\n156\t    const pulled = await (straggler.sdk as Lhc).threadView.pull({\n157\t      filePath: straggler.filePath,\n158\t    });\n159\t    expect(pulled.ok).toBe(true);\n160\t    if (!pulled.ok) return;\n161\t    const detailedBand = pulled.value.messages.find((message) => message.band === \"detailed\");\n162\t    expect(detailedBand?.content).toMatch(\n163\t      /\\[inter-turn note\\] harness restarted between turns \\(fixture straggler\\)\\n§c2/,\n164\t    );\n165\t    const tail = pulled.value.messages.filter((message) => message.band === undefined);\n166\t    expect(\n167\t      tail.some(\n168\t        (message) =>\n169\t          message.content ===\n170\t          \"[runtime note] session closing note after the last turn (fixture straggler)\",\n171\t      ),\n172\t    ).toBe(true);\n173\t    // The note appears once: banded with c2, not duplicated into the tail.\n174\t    expect(\n175\t      tail.some((message) => message.content.includes(\"harness restarted between turns\")),\n176\t    ).toBe(false);\n177\t  });\n178\t});\n179\t"}]},"parent_tool_use_id":null,"session_id":"a19a2d2c-079f-4c8b-a6d9-08d7c8df8763","uuid":"27e6f594-5f65-4a6a-ac36-a600b04b69dd","timestamp":"2026-06-11T17:32:19.165Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-select-golden.test.ts","content":"// Epic 03 Story 2: selection goldens G1–G4 (architecture-risk). Exact\n// arrangements against committed JSON (test/goldens/) — the only guard that\n// catches tie-breaker drift (≤ vs <, newest-first ordering, newest-member\n// chunk coverage) that replay-on-the-same-engine cannot. Each case runs a\n// REAL compact through the SDK surface and compares the stored arrangement,\n// compact point, covered_from, and gaps verbatim against the golden.\n//\n// Goldens are immutable once committed: an implementation that disagrees\n// with one is wrong until the design rule is shown wrong (deviation process,\n// never a golden edit). Regeneration instructions: test/goldens/README.md\n// (GOLDEN_DUMP=1 prints actuals).\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\nimport type { Lhc } from \"../src/index.js\";\nimport {\n  derivedThreadFixture,\n  openRaw,\n  stragglerVariantThread,\n  tempStore,\n  type DerivedThreadFixture,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\ninterface Golden {\n  case: string;\n  fixture: \"derived-thread\" | \"straggler-variant\";\n  params: {\n    lowerBound: number;\n    percentages: { full: number; smooth: number; detailed: number; brief: number };\n  };\n  compactPoint: number;\n  coveredFrom: number;\n  arrangement: Array<{\n    band: string;\n    subjectKind: string;\n    subjectId: string;\n    formUsed: string;\n    degraded: boolean;\n  }>;\n  gaps: Array<{ band: string; subjectId: string; reason: string }>;\n}\n\nfunction loadGolden(name: string): Golden {\n  return JSON.parse(\n    readFileSync(join(import.meta.dirname, \"goldens\", name), \"utf8\"),\n  ) as Golden;\n}\n\ninterface StoredView {\n  compactPoint: number;\n  coveredFrom: number;\n  arrangement: Golden[\"arrangement\"];\n  gaps: Golden[\"gaps\"];\n}\n\nfunction readStoredView(filePath: string): StoredView {\n  const db = openRaw(filePath);\n  try {\n    const row = db\n      .prepare(\n        `SELECT compact_point, covered_from, arrangement_json, gaps_json\n         FROM thread_view WHERE singleton = 1`,\n      )\n      .get() as\n      | {\n          compact_point: number | bigint;\n          covered_from: number | bigint;\n          arrangement_json: string;\n          gaps_json: string;\n        }\n      | undefined;\n    if (row === undefined) throw new Error(\"no view row after compact\");\n    return {\n      compactPoint: Number(row.compact_point),\n      coveredFrom: Number(row.covered_from),\n      arrangement: JSON.parse(row.arrangement_json) as Golden[\"arrangement\"],\n      gaps: JSON.parse(row.gaps_json) as Golden[\"gaps\"],\n    };\n  } finally {\n    db.close();\n  }\n}\n\nlet store: TempStore;\nlet fixture: DerivedThreadFixture;\nlet straggler: DerivedThreadFixture;\n\nbeforeAll(async () => {\n  store = tempStore();\n  fixture = await derivedThreadFixture(store);\n  straggler = await stragglerVariantThread(store);\n});\nafterAll(() => {\n  store.cleanup();\n});\n\nasync function runGolden(golden: Golden): Promise<StoredView> {\n  const target = golden.fixture === \"straggler-variant\" ? straggler : fixture;\n  const receipt = await target.sdk.threadView.compact(\n    { filePath: target.filePath },\n    { params: golden.params },\n  );\n  expect(receipt.ok).toBe(true);\n  if (!receipt.ok) throw new Error(receipt.error.reason);\n  const stored = readStoredView(target.filePath);\n  if (process.env[\"GOLDEN_DUMP\"] === \"1\") {\n    console.log(`${golden.case}\\n${JSON.stringify(stored, null, 2)}`);\n  }\n  // Receipt and stored row agree (one selection, two reports).\n  expect(receipt.value.compactPoint).toBe(stored.compactPoint);\n  expect(receipt.value.coveredFrom).toBe(stored.coveredFrom);\n  return stored;\n}\n\nfunction expectMatches(stored: StoredView, golden: Golden): void {\n  expect(stored.compactPoint).toBe(golden.compactPoint);\n  expect(stored.coveredFrom).toBe(golden.coveredFrom);\n  expect(stored.arrangement).toEqual(golden.arrangement);\n  expect(stored.gaps).toEqual(golden.gaps);\n}\n\ndescribe(\"selection goldens G1–G4 (committed JSON, exact arrangements)\", () => {\n  it(\"G1 proportions: shares fill the full gradient as committed\", async () => {\n    const golden = loadGolden(\"g1-proportions.json\");\n    expectMatches(await runGolden(golden), golden);\n  });\n\n  it(\"G2a budget edge: a turn exactly filling the smooth remainder is included (≤ rule)\", async () => {\n    const golden = loadGolden(\"g2-edge-inclusion.json\");\n    expectMatches(await runGolden(golden), golden);\n  });\n\n  it(\"G2b budget edge: one token under the exact fill excludes the turn and stops the band\", async () => {\n    const golden = loadGolden(\"g2-edge-exclusion.json\");\n    expectMatches(await runGolden(golden), golden);\n  });\n\n  it(\"G3 oversized loner: a single turn larger than the whole smooth budget represents alone\", async () => {\n    const golden = loadGolden(\"g3-oversized-loner.json\");\n    const stored = await runGolden(golden);\n    expectMatches(stored, golden);\n    // The loner condition itself: exactly one smooth entry, and the smooth\n    // budget (250 × 4% = 10) is smaller than any turn entry could render.\n    expect(stored.arrangement.filter((entry) => entry.band === \"smooth\")).toHaveLength(1);\n  });\n\n  it(\"G4 turnless straggler: the note rides the following turn's band entry; the trailing note is tail\", async () => {\n    const golden = loadGolden(\"g4-turnless-straggler.json\");\n    const stored = await runGolden(golden);\n    expectMatches(stored, golden);\n\n    // Rule 6's rendering halves, beyond the arrangement: the between-turns\n    // note renders raw with its marker immediately before c2's entry (t4's\n    // representation), and the trailing note pulls as tail.\n    const pulled = await (straggler.sdk as Lhc).threadView.pull({\n      filePath: straggler.filePath,\n    });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    const detailedBand = pulled.value.messages.find((message) => message.band === \"detailed\");\n    expect(detailedBand?.content).toMatch(\n      /\\[inter-turn note\\] harness restarted between turns \\(fixture straggler\\)\\n§c2/,\n    );\n    const tail = pulled.value.messages.filter((message) => message.band === undefined);\n    expect(\n      tail.some(\n        (message) =>\n          message.content ===\n          \"[runtime note] session closing note after the last turn (fixture straggler)\",\n      ),\n    ).toBe(true);\n    // The note appears once: banded with c2, not duplicated into the tail.\n    expect(\n      tail.some((message) => message.content.includes(\"harness restarted between turns\")),\n    ).toBe(false);\n  });\n});\n","numLines":179,"startLine":1,"totalLines":179}}}

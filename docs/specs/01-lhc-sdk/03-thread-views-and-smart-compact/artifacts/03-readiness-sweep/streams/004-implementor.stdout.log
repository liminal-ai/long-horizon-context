{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S1kivpvBqziSoPhB7DeiWV","type":"tool_result","content":"1\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n2\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n3\t// domain owns the behavior, this module owns only the shapes.\n4\t\n5\texport type Band = \"brief\" | \"detailed\" | \"smooth\";\n6\t\n7\texport interface ViewProfile {\n8\t  name: string;\n9\t  // Target assembled size; whole-entry fills may land under or over (epic\n10\t  // Data Contracts — the bound is a target, not a cap).\n11\t  lowerBound: number;\n12\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n13\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n14\t}\n15\t\n16\t// A user profile entry as configured: a full profile under a new name, or a\n17\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n18\t// whose name matches no built-in has nothing to merge over and is rejected at\n19\t// construction (FC-0.2's unknown-override violation).\n20\texport interface ViewProfileOverride {\n21\t  name: string;\n22\t  lowerBound?: number;\n23\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n24\t}\n25\t\n26\t// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\n27\t// base profile, down to single band percentages — the same depth the CLI's\n28\t// per-band flags override at. A nested-partial deepening of the tech\n29\t// design's `Partial<ViewProfile>` sketch, which could not express a\n30\t// single-band override.\n31\texport interface ViewCompactParams {\n32\t  lowerBound?: number;\n33\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n34\t}\n35\t\n36\t// Visibility-boundary budgets (AC-4.x): max > target ≥ floor, all positive.\n37\texport interface VisibilityBudgets {\n38\t  maxTokens: number;\n39\t  targetTokens: number;\n40\t  floorTokens: number;\n41\t}\n42\t\n43\t// ── SDK assembly config (validated at construction, throws on nonsense\n44\t// per the Epic 02 rule) ───────────────────────────────────────────\n45\texport interface SdkViewConfig {\n46\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n47\t  visibility?: Partial<VisibilityBudgets>; // defaults: 32000 / 24000 / 8000\n48\t  compactThreshold?: number; // status trigger; default 160000\n49\t}\n50\t\n51\t// Every optional filled by createSdk's central defaults; profiles resolved\n52\t// to complete, validated entries keyed by name.\n53\texport interface ResolvedViewConfig {\n54\t  profiles: Readonly<Record<string, ViewProfile>>;\n55\t  visibility: VisibilityBudgets;\n56\t  compactThreshold: number;\n57\t}\n58\t\n59\t// ── pull / status shapes (the product crossing to the harness) ────\n60\t//\n61\t// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\n62\t// messages first — one `user` message per non-empty band, gradient order\n63\t// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\n64\t// the tail in record order. Tail messages render by the message-kind mapping\n65\t// table (tech design §Tail message rendering), the contract every later\n66\t// story renders into:\n67\t//\n68\t//   | Message kind                       | Role      | Content shape |\n69\t//   |------------------------------------|-----------|---------------|\n70\t//   | user_prompt                        | user      | text verbatim |\n71\t//   | assistant_text                     | assistant | text verbatim |\n72\t//   | assistant_thinking                 | assistant | fenced: `[thinking]\\n<text>\\n[/thinking]` — included (the tail is full fidelity) |\n73\t//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\n74\t//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\n<full content>` |\n75\t//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\n<summary or deterministic truncation>` (short-form ladder) |\n76\t//   | runtime_note                       | user      | `[runtime note] <text>` |\n77\texport interface ViewMessage {\n78\t  role: \"user\" | \"assistant\";\n79\t  content: string;\n80\t  band?: Band; // band absent ⇒ tail\n81\t}\n82\t\n83\texport interface ViewMeta {\n84\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n85\t  coveredFrom: number | null;\n86\t  boundaryPosition: number;\n87\t  gapCount: number;\n88\t  degradedCount: number;\n89\t  viewId: string | null;\n90\t  createdAt: string | null;\n91\t}\n92\t\n93\texport interface PullResult {\n94\t  messages: ViewMessage[];\n95\t  meta: ViewMeta;\n96\t}\n97\t\n98\texport interface ViewStatus {\n99\t  tailTokens: number;\n100\t  threshold: number;\n101\t  compactRecommended: boolean;\n102\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n103\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n104\t  visibility: { zoneTokens: number; maxTokens: number };\n105\t}\n106\t\n107\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n108\texport interface CompactReceipt {\n109\t  viewId: string;\n110\t  profile: string | null;\n111\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n112\t  bands: Record<Band, { entries: number; tokens: number }>;\n113\t  tailTokens: number;\n114\t  // The assembled view's actual total (band tokens + tail tokens) against\n115\t  // the configured lower bound — a target, not a cap: whole-entry fills may\n116\t  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n117\t  totalTokens: number;\n118\t  coveredFrom: number;\n119\t  compactPoint: number;\n120\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n121\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n122\t  // Story 2 ships the compact with the sweep step ABSENT: the field reports\n123\t  // the honest literal \"absent\" — never a fake empty SweepReceipt. Story 3\n124\t  // adds the embedded sweep and flips this to SweepReceipt | { skipped: true }\n125\t  // (cross-story debt, stated: stories/02-smart-compact.md §Scope out).\n126\t  sweep: SweepReceipt | { skipped: true } | \"absent\";\n127\t}\n128\t\n129\texport interface SweepReceipt {\n130\t  owners: Array<{\n131\t    owner: \"messages\" | \"turns\";\n132\t    kind: string;\n133\t    ready: number;\n134\t    inFlight: number;\n135\t    requeued: string[]; // subject ids\n136\t    blocked: Array<{ subjectId: string; reason: string }>;\n137\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\n138\t  }>;\n139\t}\n140\t"}]},"parent_tool_use_id":null,"session_id":"f006cddb-2184-479e-939b-55dccd3023e3","uuid":"cc2bf78f-9342-4847-86e3-3649f0acaa4f","timestamp":"2026-06-11T16:36:19.926Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/view.ts","content":"// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n// domain owns the behavior, this module owns only the shapes.\n\nexport type Band = \"brief\" | \"detailed\" | \"smooth\";\n\nexport interface ViewProfile {\n  name: string;\n  // Target assembled size; whole-entry fills may land under or over (epic\n  // Data Contracts — the bound is a target, not a cap).\n  lowerBound: number;\n  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n  percentages: { full: number; smooth: number; detailed: number; brief: number };\n}\n\n// A user profile entry as configured: a full profile under a new name, or a\n// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n// whose name matches no built-in has nothing to merge over and is rejected at\n// construction (FC-0.2's unknown-override violation).\nexport interface ViewProfileOverride {\n  name: string;\n  lowerBound?: number;\n  percentages?: Partial<ViewProfile[\"percentages\"]>;\n}\n\n// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\n// base profile, down to single band percentages — the same depth the CLI's\n// per-band flags override at. A nested-partial deepening of the tech\n// design's `Partial<ViewProfile>` sketch, which could not express a\n// single-band override.\nexport interface ViewCompactParams {\n  lowerBound?: number;\n  percentages?: Partial<ViewProfile[\"percentages\"]>;\n}\n\n// Visibility-boundary budgets (AC-4.x): max > target ≥ floor, all positive.\nexport interface VisibilityBudgets {\n  maxTokens: number;\n  targetTokens: number;\n  floorTokens: number;\n}\n\n// ── SDK assembly config (validated at construction, throws on nonsense\n// per the Epic 02 rule) ───────────────────────────────────────────\nexport interface SdkViewConfig {\n  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n  visibility?: Partial<VisibilityBudgets>; // defaults: 32000 / 24000 / 8000\n  compactThreshold?: number; // status trigger; default 160000\n}\n\n// Every optional filled by createSdk's central defaults; profiles resolved\n// to complete, validated entries keyed by name.\nexport interface ResolvedViewConfig {\n  profiles: Readonly<Record<string, ViewProfile>>;\n  visibility: VisibilityBudgets;\n  compactThreshold: number;\n}\n\n// ── pull / status shapes (the product crossing to the harness) ────\n//\n// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\n// messages first — one `user` message per non-empty band, gradient order\n// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\n// the tail in record order. Tail messages render by the message-kind mapping\n// table (tech design §Tail message rendering), the contract every later\n// story renders into:\n//\n//   | Message kind                       | Role      | Content shape |\n//   |------------------------------------|-----------|---------------|\n//   | user_prompt                        | user      | text verbatim |\n//   | assistant_text                     | assistant | text verbatim |\n//   | assistant_thinking                 | assistant | fenced: `[thinking]\\n<text>\\n[/thinking]` — included (the tail is full fidelity) |\n//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\n//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\n<full content>` |\n//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\n<summary or deterministic truncation>` (short-form ladder) |\n//   | runtime_note                       | user      | `[runtime note] <text>` |\nexport interface ViewMessage {\n  role: \"user\" | \"assistant\";\n  content: string;\n  band?: Band; // band absent ⇒ tail\n}\n\nexport interface ViewMeta {\n  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n  coveredFrom: number | null;\n  boundaryPosition: number;\n  gapCount: number;\n  degradedCount: number;\n  viewId: string | null;\n  createdAt: string | null;\n}\n\nexport interface PullResult {\n  messages: ViewMessage[];\n  meta: ViewMeta;\n}\n\nexport interface ViewStatus {\n  tailTokens: number;\n  threshold: number;\n  compactRecommended: boolean;\n  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n  view: { degraded: number; gaps: number; builtAt: string } | null;\n  visibility: { zoneTokens: number; maxTokens: number };\n}\n\n// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\nexport interface CompactReceipt {\n  viewId: string;\n  profile: string | null;\n  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n  bands: Record<Band, { entries: number; tokens: number }>;\n  tailTokens: number;\n  // The assembled view's actual total (band tokens + tail tokens) against\n  // the configured lower bound — a target, not a cap: whole-entry fills may\n  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n  totalTokens: number;\n  coveredFrom: number;\n  compactPoint: number;\n  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n  // Story 2 ships the compact with the sweep step ABSENT: the field reports\n  // the honest literal \"absent\" — never a fake empty SweepReceipt. Story 3\n  // adds the embedded sweep and flips this to SweepReceipt | { skipped: true }\n  // (cross-story debt, stated: stories/02-smart-compact.md §Scope out).\n  sweep: SweepReceipt | { skipped: true } | \"absent\";\n}\n\nexport interface SweepReceipt {\n  owners: Array<{\n    owner: \"messages\" | \"turns\";\n    kind: string;\n    ready: number;\n    inFlight: number;\n    requeued: string[]; // subject ids\n    blocked: Array<{ subjectId: string; reason: string }>;\n    permanentFailed: Array<{ subjectId: string; reason: string }>;\n  }>;\n}\n","numLines":140,"startLine":1,"totalLines":140}}}

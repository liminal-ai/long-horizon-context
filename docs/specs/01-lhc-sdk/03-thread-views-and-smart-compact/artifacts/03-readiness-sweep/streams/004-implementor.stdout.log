{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018AKMoTayR31GPghTroCRco","type":"tool_result","content":"445\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n446\t    validEvent(\"turn_end\"),\n447\t  );\n448\t  return events;\n449\t}\n450\t\n451\tinterface DegradedThread {\n452\t  filePath: string;\n453\t  sdk: Lhc;\n454\t  double: ProviderDouble;\n455\t  promptIdByTurn: Map<number, string>;\n456\t}\n457\t\n458\tasync function buildDegradedThread(intoStore: TempStore): Promise<DegradedThread> {\n459\t  const double = createProviderDouble();\n460\t  const sdk = createSdk({\n461\t    provider: double,\n462\t    mode: \"manual\",\n463\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n464\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n465\t  });\n466\t  const filePath = intoStore.threadPath();\n467\t  const created = await sdk.threads.newThread({ filePath, registryPath: intoStore.registryPath });\n468\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n469\t\n470\t  const promptIdByTurn = new Map<number, string>();\n471\t  for (let turn = 1; turn <= 12; turn += 1) {\n472\t    if (turn === 4) {\n473\t      // c1 closes during turn 4's drain (placement of t4): its brief summary\n474\t      // exhausts through real retry mechanics — a FAILED chunk summary.\n475\t      double.failKind(\"chunk_summary_brief\", 3, {\n476\t        retryable: true,\n477\t        reason: C1_BRIEF_EXHAUST_REASON,\n478\t      });\n479\t    }\n480\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\n481\t    if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\n482\t    const promptId = sent.value.events[0]?.messageId;\n483\t    if (promptId !== undefined && promptId !== null) promptIdByTurn.set(turn, promptId);\n484\t    const drained = await sdk.work.drain({ filePath });\n485\t    if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\n486\t  }\n487\t\n488\t  // Post-build edits, NOT drained: the cascade clears each edited message's\n489\t  // dependent chain to pending. t8 ⇒ a PENDING turn rendering in the smooth\n490\t  // band; t4+t5+t6 ⇒ c2's summaries pending with zero ready member\n491\t  // projections — the gap rung.\n492\t  for (const turn of [4, 5, 6, 8]) {\n493\t    const promptId = promptIdByTurn.get(turn);\n494\t    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\n495\t    const edited = await sdk.messages.edit(\n496\t      { filePath },\n497\t      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\n498\t    );\n499\t    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\n500\t  }\n501\t  return { filePath, sdk, double, promptIdByTurn };\n502\t}\n503\t\n504\tdescribe(\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\", () => {\n505\t  let degradedStore: TempStore;\n506\t  let degraded: DegradedThread;\n507\t\n508\t  beforeAll(async () => {\n509\t    degradedStore = tempStore();\n510\t    degraded = await buildDegradedThread(degradedStore);\n511\t  });\n512\t  afterAll(() => {\n513\t    degradedStore.cleanup();\n514\t  });\n515\t\n516\t  it(\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\", async () => {\n517\t    const captured = degraded.double.captureInputs();\n518\t    const capturedBefore = captured.length;\n519\t\n520\t    const receipt = await degraded.sdk.threadView.compact(\n521\t      { filePath: degraded.filePath },\n522\t      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\n523\t    );\n524\t    expect(receipt.ok).toBe(true);\n525\t    if (!receipt.ok) return;\n526\t\n527\t    // The pending turn rendering (t8, edited): the smooth entry degrades down\n528\t    // its ladder (projection pending too) to the deterministic excerpt.\n529\t    const t8 = receipt.value.degraded.find((entry) => entry.subjectId === \"t8\");\n530\t    expect(t8).toBeDefined();\n531\t    expect(t8?.band).toBe(\"smooth\");\n532\t    expect(t8?.usedForm).toBe(\"message_excerpt\");\n533\t\n534\t    // The failed chunk summary (c1's brief): the brief entry renders the\n535\t    // truncated detailed summary, marked.\n536\t    const c1 = receipt.value.degraded.find((entry) => entry.subjectId === \"c1\");\n537\t    expect(c1).toBeDefined();\n538\t    expect(c1?.band).toBe(\"brief\");\n539\t    expect(c1?.usedForm).toBe(\"chunk_summary_detailed_truncated\");\n540\t\n541\t    // The unusable chunk (c2: summaries pending, zero ready member\n542\t    // projections): an explicit gap entry with its reason — never absence.\n543\t    expect(receipt.value.gaps).toHaveLength(1);\n544\t    const gap = receipt.value.gaps[0];\n545\t    expect(gap?.subjectId).toBe(\"c2\");\n546\t    expect(gap?.reason).toMatch(/no usable form/);\n547\t    expect(gap?.reason).toContain(\"chunk_summary_detailed: pending\");\n548\t\n549\t    // Per-band counts present; no span silently absent: every turn in the\n550\t    // compacted range is accounted for by a band subject (c1: t1–t3, c2:\n551\t    // t4–t6, smooth: t7–t8) and everything after the compact point is tail.\n552\t    expect(receipt.value.bands.brief.entries).toBe(1);\n553\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n554\t    expect(receipt.value.bands.smooth.entries).toBe(2);\n555\t    expect(receipt.value.compactPoint).toBe(48);\n556\t    expect(receipt.value.coveredFrom).toBe(1);\n557\t\n558\t    // The rendered text carries the markers (degrade visibly, AC-2.5/2.10).\n559\t    const messages = await pullMessages(degraded.sdk, degraded.filePath);\n560\t    const bandText = bandMessages(messages)\n561\t      .map((message) => message.content)\n562\t      .join(\"\\n\\n\");\n563\t    expect(bandText).toContain(\"[degraded: brief-from-detailed]\");\n564\t    expect(bandText).toContain(\"[degraded: smooth-from-excerpt]\");\n565\t    expect(bandText).toMatch(/§c2 \\[chunk c2 unavailable: no usable form/);\n566\t\n567\t    // Zero provider calls: missing material degrades, it is never re-derived\n568\t    // inline (AC-2.4's no-inference rule with teeth).\n569\t    expect(captured.length).toBe(capturedBefore);\n570\t  });\n571\t\n572\t  it(\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\", async () => {\n573\t    const status = await degraded.sdk.threadView.status({ filePath: degraded.filePath });\n574\t    expect(status.ok).toBe(true);\n575\t    if (!status.ok) return;\n576\t    expect(status.value.view).not.toBeNull();\n577\t    expect(status.value.view?.degraded).toBe(2);\n578\t    expect(status.value.view?.gaps).toBe(1);\n579\t    expect(typeof status.value.view?.builtAt).toBe(\"string\");\n580\t    // The edits' requeued rebuild work is visible as pending derivation.\n581\t    expect(status.value.derivation.pending).toBeGreaterThan(0);\n582\t  });\n583\t});\n584\t\n585\tdescribe(\"TC-2.7 (AC-2.5): canonical corruption refuses; derived-only damage degrades\", () => {\n586\t  it(\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\", async () => {\n587\t    const corruptStore = tempStore();\n588\t    try {\n589\t      const double = createProviderDouble();\n590\t      const sdk = createSdk({ provider: double, mode: \"manual\" });\n591\t      const filePath = corruptStore.threadPath();\n592\t      const created = await sdk.threads.newThread({\n593\t        filePath,\n594\t        registryPath: corruptStore.registryPath,\n595\t      });\n596\t      expect(created.ok).toBe(true);\n597\t      for (let turn = 1; turn <= 4; turn += 1) {\n598\t        const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\n599\t        expect(sent.ok).toBe(true);\n600\t      }\n601\t      const drained = await sdk.work.drain({ filePath });\n602\t      expect(drained.ok).toBe(true);\n603\t\n604\t      // A prior view exists before the damage.\n605\t      const first = await sdk.threadView.compact(\n606\t        { filePath },\n607\t        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\n608\t      );\n609\t      expect(first.ok).toBe(true);\n610\t      const priorPull = await sdk.threadView.pull({ filePath });\n611\t      expect(priorPull.ok).toBe(true);\n612\t      if (!priorPull.ok) return;\n613\t\n614\t      // Manufactured canonical corruption, damaged below the SDK (the Epic 01\n615\t      // two-open-turns pattern): open a turn through real intake, then add a\n616\t      // second open row.\n617\t      const opened = await sdk.intakeStream.messageEvents({ filePath }, [\n618\t        validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n619\t      ]);\n620\t      expect(opened.ok).toBe(true);\n621\t      corruptTwoOpenTurns(filePath);\n622\t      const recordBefore = recordSnapshot(filePath);\n623\t\n624\t      const refused = await sdk.threadView.compact(\n625\t        { filePath },\n626\t        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\n627\t      );\n628\t      expect(refused.ok).toBe(false);\n629\t      if (refused.ok) return;\n630\t      expect(refused.error.errorClass).toBe(\"state_corruption\");\n631\t      expect(refused.error.code).toBe(\"turn_state_corrupt\");\n632\t      expect(refused.error.reason).toMatch(/open turns/);\n633\t\n634\t      // Pre-transaction refusal: prior view serves byte-identically, record\n635\t      // untouched.\n636\t      const afterPull = await sdk.threadView.pull({ filePath });\n637\t      expect(afterPull.ok).toBe(true);\n638\t      if (!afterPull.ok) return;\n639\t      expect(JSON.stringify(afterPull.value.messages.filter((m) => m.band !== undefined))).toBe(\n640\t        JSON.stringify(priorPull.value.messages.filter((m) => m.band !== undefined)),\n641\t      );\n642\t      expect(afterPull.value.meta.viewId).toBe(priorPull.value.meta.viewId);\n643\t      expect(recordSnapshot(filePath)).toBe(recordBefore);\n644\t    } finally {\n645\t      corruptStore.cleanup();\n646\t    }\n647\t  });\n648\t\n649\t  it(\"control: a thread with only derived-material damage compacts successfully with gaps\", async () => {\n650\t    // The suite fixture carries two scripted FAILED tool_result_summary forms\n651\t    // (derived damage only) and compacts clean throughout this file; the\n652\t    // explicit control here is the degraded build: summaries pending/failed,\n653\t    // zero usable forms on c2 — and the compact above completed with a gap\n654\t    // rather than refusing. Re-assert the contrast directly on the main\n655\t    // fixture: derived failures present, compact succeeds, no state_corruption.\n656\t    const receipt = await fixture.sdk.threadView.compact(\n657\t      { filePath: fixture.filePath },\n658\t      { params: GRADIENT_PARAMS },\n659\t    );\n660\t    expect(receipt.ok).toBe(true);\n661\t  });\n662\t});\n663\t\n664\tdescribe(\"TC-1.3 (AC-1.4) and TC-1.5 (AC-1.6): snapshot immutability under record mutation\", () => {\n665\t  let mutStore: TempStore;\n666\t  let mut: DerivedThreadFixture;\n667\t\n668\t  beforeAll(async () => {\n669\t    mutStore = tempStore();\n670\t    mut = await derivedThreadFixture(mutStore, { failures: false });\n671\t    const receipt = await mut.sdk.threadView.compact(\n672\t      { filePath: mut.filePath },\n673\t      { params: GRADIENT_PARAMS },\n674\t    );\n675\t    if (!receipt.ok) throw new Error(`setup compact failed: ${receipt.error.reason}`);\n676\t  });\n677\t  afterAll(() => {\n678\t    mutStore.cleanup();\n679\t  });\n680\t\n681\t  it(\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\", async () => {\n682\t    const before = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n683\t    const bandHash = sha256(before);\n684\t\n685\t    // t5 is banded inside c2's detailed entry; edit its prompt.\n686\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n687\t    expect(listed.ok).toBe(true);\n688\t    if (!listed.ok) return;\n689\t    const t5Prompt = listed.value.find((m) => m.turnId === \"t5\" && m.kind === \"user_prompt\");\n690\t    expect(t5Prompt).toBeDefined();\n691\t    if (t5Prompt === undefined) return;\n692\t    const edited = await mut.sdk.messages.edit(\n693\t      { filePath: mut.filePath },\n694\t      { messageId: t5Prompt.messageId, content: \"turn 5: edited after the snapshot\" },\n695\t    );\n696\t    expect(edited.ok).toBe(true);\n697\t\n698\t    const afterEdit = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n699\t    expect(sha256(afterEdit)).toBe(bandHash);\n700\t\n701\t    // Drain the requeued rebuilds: the rebuilt summary lands in the RECORD\n702\t    // only; the snapshot still serves the same bytes.\n703\t    const drained = await mut.sdk.work.drain({ filePath: mut.filePath });\n704\t    expect(drained.ok).toBe(true);\n705\t    const afterDrain = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n706\t    expect(sha256(afterDrain)).toBe(bandHash);\n707\t\n708\t    // The record really changed underneath: c2's rebuilt detailed summary is\n709\t    // not the text the band serves.\n710\t    const db = openRaw(mut.filePath);\n711\t    try {\n712\t      const row = db\n713\t        .prepare(\n714\t          `SELECT content FROM derived_form\n715\t           WHERE subject_kind = 'chunk' AND subject_id = 'c2' AND form = 'chunk_summary_detailed'`,\n716\t        )\n717\t        .get() as { content: string | null } | undefined;\n718\t      expect(row?.content).toBeDefined();\n719\t      const detailedBand = afterDrain.find((m) => m.band === \"detailed\");\n720\t      expect(detailedBand?.content).not.toContain(row?.content ?? \"<unset>\");\n721\t    } finally {\n722\t      db.close();\n723\t    }\n724\t  });\n725\t\n726\t  it(\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\", async () => {\n727\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n728\t    expect(listed.ok).toBe(true);\n729\t    if (!listed.ok) return;\n730\t\n731\t    // Tail region: t9 onward (compact point 48). Delete t10's findings.\n732\t    const tailTarget = listed.value.find((m) => m.turnId === \"t10\" && m.kind === \"assistant_text\");\n733\t    expect(tailTarget).toBeDefined();\n734\t    if (tailTarget === undefined) return;\n735\t    const statusBefore = await mut.sdk.threadView.status({ filePath: mut.filePath });\n736\t    expect(statusBefore.ok).toBe(true);\n737\t    if (!statusBefore.ok) return;\n738\t\n739\t    const tailDelete = await mut.sdk.messages.deleteMessage(\n740\t      { filePath: mut.filePath },\n741\t      { messageId: tailTarget.messageId },\n742\t    );\n743\t    expect(tailDelete.ok).toBe(true);\n744\t    const afterTailDelete = await pullMessages(mut.sdk, mut.filePath);\n745\t    expect(\n746\t      afterTailDelete.some((m) => m.content === \"findings for area 10\"),\n747\t    ).toBe(false);\n748\t\n749\t    // The record change is visible to the status read (tail sum shrank).\n750\t    const statusAfter = await mut.sdk.threadView.status({ filePath: mut.filePath });\n751\t    expect(statusAfter.ok).toBe(true);\n752\t    if (!statusAfter.ok) return;\n753\t    expect(statusAfter.value.tailTokens).toBeLessThan(statusBefore.value.tailTokens);\n754\t\n755\t    // Banded region: delete a t6 message whose derived content sits inside\n756\t    // c2's band entry. The snapshot is untouched until the next compact.\n757\t    const bandsBefore = bandMessages(afterTailDelete);\n758\t    const bandTarget = listed.value.find((m) => m.turnId === \"t6\" && m.kind === \"assistant_text\");\n759\t    expect(bandTarget).toBeDefined();\n760\t    if (bandTarget === undefined) return;\n761\t    const bandedDelete = await mut.sdk.messages.deleteMessage(\n762\t      { filePath: mut.filePath },\n763\t      { messageId: bandTarget.messageId },\n764\t    );\n765\t    expect(bandedDelete.ok).toBe(true);\n766\t\n767\t    const afterBandedDelete = await pullMessages(mut.sdk, mut.filePath);\n768\t    expect(sha256(bandMessages(afterBandedDelete))).toBe(sha256(bandsBefore));\n769\t\n770\t    // Next-compact visibility: the record changed under the snapshot — the\n771\t    // delete's cascade left rebuild work pending in the status read.\n772\t    const statusFinal = await mut.sdk.threadView.status({ filePath: mut.filePath });\n773\t    expect(statusFinal.ok).toBe(true);\n774\t    if (!statusFinal.ok) return;\n775\t    expect(statusFinal.value.derivation.pending).toBeGreaterThan(0);\n776\t  });\n777\t});\n778\t"}]},"parent_tool_use_id":null,"session_id":"f006cddb-2184-479e-939b-55dccd3023e3","uuid":"ec4eb732-257a-4d9b-8fcc-11e8bde638ee","timestamp":"2026-06-11T16:41:14.123Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-compact.test.ts","content":"    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n    validEvent(\"turn_end\"),\n  );\n  return events;\n}\n\ninterface DegradedThread {\n  filePath: string;\n  sdk: Lhc;\n  double: ProviderDouble;\n  promptIdByTurn: Map<number, string>;\n}\n\nasync function buildDegradedThread(intoStore: TempStore): Promise<DegradedThread> {\n  const double = createProviderDouble();\n  const sdk = createSdk({\n    provider: double,\n    mode: \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n  });\n  const filePath = intoStore.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: intoStore.registryPath });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n\n  const promptIdByTurn = new Map<number, string>();\n  for (let turn = 1; turn <= 12; turn += 1) {\n    if (turn === 4) {\n      // c1 closes during turn 4's drain (placement of t4): its brief summary\n      // exhausts through real retry mechanics — a FAILED chunk summary.\n      double.failKind(\"chunk_summary_brief\", 3, {\n        retryable: true,\n        reason: C1_BRIEF_EXHAUST_REASON,\n      });\n    }\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\n    if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\n    const promptId = sent.value.events[0]?.messageId;\n    if (promptId !== undefined && promptId !== null) promptIdByTurn.set(turn, promptId);\n    const drained = await sdk.work.drain({ filePath });\n    if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\n  }\n\n  // Post-build edits, NOT drained: the cascade clears each edited message's\n  // dependent chain to pending. t8 ⇒ a PENDING turn rendering in the smooth\n  // band; t4+t5+t6 ⇒ c2's summaries pending with zero ready member\n  // projections — the gap rung.\n  for (const turn of [4, 5, 6, 8]) {\n    const promptId = promptIdByTurn.get(turn);\n    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\n    const edited = await sdk.messages.edit(\n      { filePath },\n      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\n    );\n    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\n  }\n  return { filePath, sdk, double, promptIdByTurn };\n}\n\ndescribe(\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\", () => {\n  let degradedStore: TempStore;\n  let degraded: DegradedThread;\n\n  beforeAll(async () => {\n    degradedStore = tempStore();\n    degraded = await buildDegradedThread(degradedStore);\n  });\n  afterAll(() => {\n    degradedStore.cleanup();\n  });\n\n  it(\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\", async () => {\n    const captured = degraded.double.captureInputs();\n    const capturedBefore = captured.length;\n\n    const receipt = await degraded.sdk.threadView.compact(\n      { filePath: degraded.filePath },\n      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\n    );\n    expect(receipt.ok).toBe(true);\n    if (!receipt.ok) return;\n\n    // The pending turn rendering (t8, edited): the smooth entry degrades down\n    // its ladder (projection pending too) to the deterministic excerpt.\n    const t8 = receipt.value.degraded.find((entry) => entry.subjectId === \"t8\");\n    expect(t8).toBeDefined();\n    expect(t8?.band).toBe(\"smooth\");\n    expect(t8?.usedForm).toBe(\"message_excerpt\");\n\n    // The failed chunk summary (c1's brief): the brief entry renders the\n    // truncated detailed summary, marked.\n    const c1 = receipt.value.degraded.find((entry) => entry.subjectId === \"c1\");\n    expect(c1).toBeDefined();\n    expect(c1?.band).toBe(\"brief\");\n    expect(c1?.usedForm).toBe(\"chunk_summary_detailed_truncated\");\n\n    // The unusable chunk (c2: summaries pending, zero ready member\n    // projections): an explicit gap entry with its reason — never absence.\n    expect(receipt.value.gaps).toHaveLength(1);\n    const gap = receipt.value.gaps[0];\n    expect(gap?.subjectId).toBe(\"c2\");\n    expect(gap?.reason).toMatch(/no usable form/);\n    expect(gap?.reason).toContain(\"chunk_summary_detailed: pending\");\n\n    // Per-band counts present; no span silently absent: every turn in the\n    // compacted range is accounted for by a band subject (c1: t1–t3, c2:\n    // t4–t6, smooth: t7–t8) and everything after the compact point is tail.\n    expect(receipt.value.bands.brief.entries).toBe(1);\n    expect(receipt.value.bands.detailed.entries).toBe(1);\n    expect(receipt.value.bands.smooth.entries).toBe(2);\n    expect(receipt.value.compactPoint).toBe(48);\n    expect(receipt.value.coveredFrom).toBe(1);\n\n    // The rendered text carries the markers (degrade visibly, AC-2.5/2.10).\n    const messages = await pullMessages(degraded.sdk, degraded.filePath);\n    const bandText = bandMessages(messages)\n      .map((message) => message.content)\n      .join(\"\\n\\n\");\n    expect(bandText).toContain(\"[degraded: brief-from-detailed]\");\n    expect(bandText).toContain(\"[degraded: smooth-from-excerpt]\");\n    expect(bandText).toMatch(/§c2 \\[chunk c2 unavailable: no usable form/);\n\n    // Zero provider calls: missing material degrades, it is never re-derived\n    // inline (AC-2.4's no-inference rule with teeth).\n    expect(captured.length).toBe(capturedBefore);\n  });\n\n  it(\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\", async () => {\n    const status = await degraded.sdk.threadView.status({ filePath: degraded.filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    expect(status.value.view).not.toBeNull();\n    expect(status.value.view?.degraded).toBe(2);\n    expect(status.value.view?.gaps).toBe(1);\n    expect(typeof status.value.view?.builtAt).toBe(\"string\");\n    // The edits' requeued rebuild work is visible as pending derivation.\n    expect(status.value.derivation.pending).toBeGreaterThan(0);\n  });\n});\n\ndescribe(\"TC-2.7 (AC-2.5): canonical corruption refuses; derived-only damage degrades\", () => {\n  it(\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\", async () => {\n    const corruptStore = tempStore();\n    try {\n      const double = createProviderDouble();\n      const sdk = createSdk({ provider: double, mode: \"manual\" });\n      const filePath = corruptStore.threadPath();\n      const created = await sdk.threads.newThread({\n        filePath,\n        registryPath: corruptStore.registryPath,\n      });\n      expect(created.ok).toBe(true);\n      for (let turn = 1; turn <= 4; turn += 1) {\n        const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\n        expect(sent.ok).toBe(true);\n      }\n      const drained = await sdk.work.drain({ filePath });\n      expect(drained.ok).toBe(true);\n\n      // A prior view exists before the damage.\n      const first = await sdk.threadView.compact(\n        { filePath },\n        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\n      );\n      expect(first.ok).toBe(true);\n      const priorPull = await sdk.threadView.pull({ filePath });\n      expect(priorPull.ok).toBe(true);\n      if (!priorPull.ok) return;\n\n      // Manufactured canonical corruption, damaged below the SDK (the Epic 01\n      // two-open-turns pattern): open a turn through real intake, then add a\n      // second open row.\n      const opened = await sdk.intakeStream.messageEvents({ filePath }, [\n        validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n      ]);\n      expect(opened.ok).toBe(true);\n      corruptTwoOpenTurns(filePath);\n      const recordBefore = recordSnapshot(filePath);\n\n      const refused = await sdk.threadView.compact(\n        { filePath },\n        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\n      );\n      expect(refused.ok).toBe(false);\n      if (refused.ok) return;\n      expect(refused.error.errorClass).toBe(\"state_corruption\");\n      expect(refused.error.code).toBe(\"turn_state_corrupt\");\n      expect(refused.error.reason).toMatch(/open turns/);\n\n      // Pre-transaction refusal: prior view serves byte-identically, record\n      // untouched.\n      const afterPull = await sdk.threadView.pull({ filePath });\n      expect(afterPull.ok).toBe(true);\n      if (!afterPull.ok) return;\n      expect(JSON.stringify(afterPull.value.messages.filter((m) => m.band !== undefined))).toBe(\n        JSON.stringify(priorPull.value.messages.filter((m) => m.band !== undefined)),\n      );\n      expect(afterPull.value.meta.viewId).toBe(priorPull.value.meta.viewId);\n      expect(recordSnapshot(filePath)).toBe(recordBefore);\n    } finally {\n      corruptStore.cleanup();\n    }\n  });\n\n  it(\"control: a thread with only derived-material damage compacts successfully with gaps\", async () => {\n    // The suite fixture carries two scripted FAILED tool_result_summary forms\n    // (derived damage only) and compacts clean throughout this file; the\n    // explicit control here is the degraded build: summaries pending/failed,\n    // zero usable forms on c2 — and the compact above completed with a gap\n    // rather than refusing. Re-assert the contrast directly on the main\n    // fixture: derived failures present, compact succeeds, no state_corruption.\n    const receipt = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: GRADIENT_PARAMS },\n    );\n    expect(receipt.ok).toBe(true);\n  });\n});\n\ndescribe(\"TC-1.3 (AC-1.4) and TC-1.5 (AC-1.6): snapshot immutability under record mutation\", () => {\n  let mutStore: TempStore;\n  let mut: DerivedThreadFixture;\n\n  beforeAll(async () => {\n    mutStore = tempStore();\n    mut = await derivedThreadFixture(mutStore, { failures: false });\n    const receipt = await mut.sdk.threadView.compact(\n      { filePath: mut.filePath },\n      { params: GRADIENT_PARAMS },\n    );\n    if (!receipt.ok) throw new Error(`setup compact failed: ${receipt.error.reason}`);\n  });\n  afterAll(() => {\n    mutStore.cleanup();\n  });\n\n  it(\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\", async () => {\n    const before = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n    const bandHash = sha256(before);\n\n    // t5 is banded inside c2's detailed entry; edit its prompt.\n    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const t5Prompt = listed.value.find((m) => m.turnId === \"t5\" && m.kind === \"user_prompt\");\n    expect(t5Prompt).toBeDefined();\n    if (t5Prompt === undefined) return;\n    const edited = await mut.sdk.messages.edit(\n      { filePath: mut.filePath },\n      { messageId: t5Prompt.messageId, content: \"turn 5: edited after the snapshot\" },\n    );\n    expect(edited.ok).toBe(true);\n\n    const afterEdit = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n    expect(sha256(afterEdit)).toBe(bandHash);\n\n    // Drain the requeued rebuilds: the rebuilt summary lands in the RECORD\n    // only; the snapshot still serves the same bytes.\n    const drained = await mut.sdk.work.drain({ filePath: mut.filePath });\n    expect(drained.ok).toBe(true);\n    const afterDrain = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n    expect(sha256(afterDrain)).toBe(bandHash);\n\n    // The record really changed underneath: c2's rebuilt detailed summary is\n    // not the text the band serves.\n    const db = openRaw(mut.filePath);\n    try {\n      const row = db\n        .prepare(\n          `SELECT content FROM derived_form\n           WHERE subject_kind = 'chunk' AND subject_id = 'c2' AND form = 'chunk_summary_detailed'`,\n        )\n        .get() as { content: string | null } | undefined;\n      expect(row?.content).toBeDefined();\n      const detailedBand = afterDrain.find((m) => m.band === \"detailed\");\n      expect(detailedBand?.content).not.toContain(row?.content ?? \"<unset>\");\n    } finally {\n      db.close();\n    }\n  });\n\n  it(\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\", async () => {\n    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n\n    // Tail region: t9 onward (compact point 48). Delete t10's findings.\n    const tailTarget = listed.value.find((m) => m.turnId === \"t10\" && m.kind === \"assistant_text\");\n    expect(tailTarget).toBeDefined();\n    if (tailTarget === undefined) return;\n    const statusBefore = await mut.sdk.threadView.status({ filePath: mut.filePath });\n    expect(statusBefore.ok).toBe(true);\n    if (!statusBefore.ok) return;\n\n    const tailDelete = await mut.sdk.messages.deleteMessage(\n      { filePath: mut.filePath },\n      { messageId: tailTarget.messageId },\n    );\n    expect(tailDelete.ok).toBe(true);\n    const afterTailDelete = await pullMessages(mut.sdk, mut.filePath);\n    expect(\n      afterTailDelete.some((m) => m.content === \"findings for area 10\"),\n    ).toBe(false);\n\n    // The record change is visible to the status read (tail sum shrank).\n    const statusAfter = await mut.sdk.threadView.status({ filePath: mut.filePath });\n    expect(statusAfter.ok).toBe(true);\n    if (!statusAfter.ok) return;\n    expect(statusAfter.value.tailTokens).toBeLessThan(statusBefore.value.tailTokens);\n\n    // Banded region: delete a t6 message whose derived content sits inside\n    // c2's band entry. The snapshot is untouched until the next compact.\n    const bandsBefore = bandMessages(afterTailDelete);\n    const bandTarget = listed.value.find((m) => m.turnId === \"t6\" && m.kind === \"assistant_text\");\n    expect(bandTarget).toBeDefined();\n    if (bandTarget === undefined) return;\n    const bandedDelete = await mut.sdk.messages.deleteMessage(\n      { filePath: mut.filePath },\n      { messageId: bandTarget.messageId },\n    );\n    expect(bandedDelete.ok).toBe(true);\n\n    const afterBandedDelete = await pullMessages(mut.sdk, mut.filePath);\n    expect(sha256(bandMessages(afterBandedDelete))).toBe(sha256(bandsBefore));\n\n    // Next-compact visibility: the record changed under the snapshot — the\n    // delete's cascade left rebuild work pending in the status read.\n    const statusFinal = await mut.sdk.threadView.status({ filePath: mut.filePath });\n    expect(statusFinal.ok).toBe(true);\n    if (!statusFinal.ok) return;\n    expect(statusFinal.value.derivation.pending).toBeGreaterThan(0);\n  });\n});\n","numLines":334,"startLine":445,"totalLines":778}}}

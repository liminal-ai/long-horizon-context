{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EE1dYbvNZjY4heDA9U9jU9","type":"tool_result","content":"1\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n2\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n3\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n4\t// deterministic provider double into known form states. States are reached\n5\t// through production paths, never hand-written rows (the anti-shim line\n6\t// FC-0.3 enforces): the failed states come from scripted provider failures\n7\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\n8\t// real source damage on a sacrificial sibling thread. Every later Epic 03\n9\t// story compacts against what this builder returns.\n10\timport {\n11\t  createSdk,\n12\t  type FormReportEntry,\n13\t  type Lhc,\n14\t  type MessageEventInput,\n15\t} from \"../../src/index.js\";\n16\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n17\timport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\n18\timport { readChunks, type ChunkSnapshot } from \"./threads.js\";\n19\timport { validEvent, type TempStore } from \"./index.js\";\n20\t\n21\t// Reason classes the scripted failures stamp, chosen from the sweep\n22\t// classification table's vocabulary (tech design §Spec Validation): a\n23\t// rate-limit class reads transient, a content-refusal class reads permanent —\n24\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n25\t// Story 3 depends on it.\n26\texport const TRANSIENT_EXHAUST_REASON =\n27\t  \"rate_limit: scripted transient exhaustion (fixture)\";\n28\texport const PERMANENT_FAILURE_REASON =\n29\t  \"content_refusal: scripted permanent failure (fixture)\";\n30\t\n31\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n32\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\n33\t// deterministic double are near-constant in size (`projection(<digest>:<40\n34\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\n35\t// if drift ever moves it.\n36\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n37\t\n38\tconst TURN_COUNT = 12;\n39\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n40\t\n41\tfunction turnEvents(turn: number): MessageEventInput[] {\n42\t  const events: MessageEventInput[] = [\n43\t    validEvent(\"user_prompt\", {\n44\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n45\t    }),\n46\t    validEvent(\"assistant_thinking\", {\n47\t      payload: { text: `considering what area ${turn} contains` },\n48\t    }),\n49\t  ];\n50\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n51\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n52\t    // realistic over-max zone of tool results to age behind the boundary.\n53\t    for (const run of [1, 2]) {\n54\t      const toolCallId = `call-fx-${turn}-${run}`;\n55\t      events.push(\n56\t        validEvent(\"tool_call\", {\n57\t          payload: {\n58\t            toolCallId,\n59\t            toolName: \"read_file\",\n60\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n61\t          },\n62\t        }),\n63\t        validEvent(\"tool_result\", {\n64\t          payload: {\n65\t            toolCallId,\n66\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n67\t            isError: false,\n68\t          },\n69\t        }),\n70\t      );\n71\t    }\n72\t  }\n73\t  events.push(\n74\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n75\t    validEvent(\"turn_end\"),\n76\t  );\n77\t  return events;\n78\t}\n79\t\n80\texport interface DerivedThreadFixture {\n81\t  filePath: string;\n82\t  sdk: Lhc;\n83\t  double: ProviderDouble;\n84\t  turnIds: string[]; // t1..t12\n85\t  chunks: ChunkSnapshot;\n86\t  // The two manufactured failed subjects (tool_result_summary forms), reached\n87\t  // through real retry exhaustion / terminal failure — absent when failures\n88\t  // are disabled for a variant.\n89\t  failedTransientMessageId?: string;\n90\t  failedPermanentMessageId?: string;\n91\t  // The straggler variant's turnId-null messages: one between two turns, one\n92\t  // after the last turn — absent unless stragglers are enabled.\n93\t  stragglerBetweenMessageId?: string;\n94\t  stragglerTrailingMessageId?: string;\n95\t}\n96\t\n97\texport interface DerivedThreadOptions {\n98\t  failures?: boolean; // default true: manufacture the two failed states\n99\t  stragglers?: boolean; // default false: insert the turnless runtime notes\n100\t}\n101\t\n102\tasync function send(\n103\t  sdk: Lhc,\n104\t  filePath: string,\n105\t  batch: readonly MessageEventInput[],\n106\t): Promise<string[]> {\n107\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n108\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n109\t  return result.value.events.map((entry) => entry.messageId ?? \"\");\n110\t}\n111\t\n112\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n113\t  const report = await sdk.work.drain({ filePath });\n114\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n115\t  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n116\t    throw new Error(\n117\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n118\t    );\n119\t  }\n120\t}\n121\t\n122\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n123\t  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n124\t}\n125\t\n126\texport async function derivedThreadFixture(\n127\t  store: TempStore,\n128\t  opts: DerivedThreadOptions = {},\n129\t): Promise<DerivedThreadFixture> {\n130\t  const failures = opts.failures ?? true;\n131\t  const stragglers = opts.stragglers ?? false;\n132\t\n133\t  const double = createProviderDouble();\n134\t  const sdk = createSdk({\n135\t    provider: double,\n136\t    mode: \"manual\",\n137\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n138\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\n139\t  });\n140\t\n141\t  const filePath = store.threadPath();\n142\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n143\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n144\t\n145\t  const turnIds: string[] = [];\n146\t  const fixture: DerivedThreadFixture = {\n147\t    filePath,\n148\t    sdk,\n149\t    double,\n150\t    turnIds,\n151\t    chunks: { chunks: [], members: [] },\n152\t  };\n153\t\n154\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n155\t    if (failures && turn === 6) {\n156\t      // Retryable failures consumed to exhaustion by the head-first drain:\n157\t      // the first tool_result_summary item of this batch takes all three\n158\t      // attempts and lands failed with the transient reason class.\n159\t      double.failKind(\"tool_result_summary\", 3, {\n160\t        retryable: true,\n161\t        reason: TRANSIENT_EXHAUST_REASON,\n162\t      });\n163\t    }\n164\t    if (failures && turn === 7) {\n165\t      // One non-retryable failure: terminal on the first attempt — the\n166\t      // permanent reason class, attempts 1.\n167\t      double.failKind(\"tool_result_summary\", 1, {\n168\t        retryable: false,\n169\t        reason: PERMANENT_FAILURE_REASON,\n170\t      });\n171\t    }\n172\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\n173\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n174\t    // result, call, result, text, end — index 3 is the first tool result,\n175\t    // the scripted failures' subject.\n176\t    const firstToolResultId = messageIds[3];\n177\t    if (failures && (turn === 6 || turn === 7)) {\n178\t      if (firstToolResultId === undefined || firstToolResultId === \"\") {\n179\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\n180\t      }\n181\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\n182\t      else fixture.failedPermanentMessageId = firstToolResultId;\n183\t    }\n184\t    await drain(sdk, filePath);\n185\t\n186\t    if (stragglers && turn === 3) {\n187\t      // A runtime note between turn 3's end and turn 4's prompt: projected\n188\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\n189\t      const noteIds = await send(sdk, filePath, [\n190\t        validEvent(\"runtime_note\", {\n191\t          payload: { text: \"harness restarted between turns (fixture straggler)\" },\n192\t        }),\n193\t      ]);\n194\t      const noteId = noteIds[0];\n195\t      if (noteId === undefined || noteId === \"\") {\n196\t        throw new Error(\"fixture invariant: between-turns straggler did not project\");\n197\t      }\n198\t      fixture.stragglerBetweenMessageId = noteId;\n199\t    }\n200\t    turnIds.push(`t${turn}`);\n201\t  }\n202\t\n203\t  if (stragglers) {\n204\t    const noteIds = await send(sdk, filePath, [\n205\t      validEvent(\"runtime_note\", {\n206\t        payload: { text: \"session closing note after the last turn (fixture straggler)\" },\n207\t      }),\n208\t    ]);\n209\t    const noteId = noteIds[0];\n210\t    if (noteId === undefined || noteId === \"\") {\n211\t      throw new Error(\"fixture invariant: trailing straggler did not project\");\n212\t    }\n213\t    fixture.stragglerTrailingMessageId = noteId;\n214\t    await drain(sdk, filePath);\n215\t  }\n216\t\n217\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\n218\t  // chunks, the first three closed. A failure here means the deterministic\n219\t  // substrate moved (provider output or tokenizer), not a flaky test.\n220\t  fixture.chunks = readChunks(filePath);\n221\t  if (fixture.chunks.chunks.length !== 4) {\n222\t    throw new Error(\n223\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\n224\t    );\n225\t  }\n226\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \"closed\").length;\n227\t  if (closed !== 3) {\n228\t    throw new Error(\n229\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\n230\t    );\n231\t  }\n232\t\n233\t  if (failures) {\n234\t    // Verify the manufactured states by read-back through the owning report\n235\t    // surface before handing the fixture to any test (FC-0.3's enforcement\n236\t    // lives in the tests; this guards the builder's own contract).\n237\t    const report = await sdk.messages.report({ filePath });\n238\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\n239\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\n240\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\n241\t    if (\n242\t      transient.length !== 1 ||\n243\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\n244\t      permanent.length !== 1 ||\n245\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\n246\t    ) {\n247\t      throw new Error(\n248\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\n249\t      );\n250\t    }\n251\t  }\n252\t\n253\t  return fixture;\n254\t}\n255\t\n256\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\n257\t// conversation with a runtime note between two turns and one after the last\n258\t// turn, fully drained, no manufactured failures.\n259\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\n260\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\n261\t}\n262\t\n263\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\n264\t// short real conversation, drained clean, then damaged below the SDK into\n265\t// the two-open-turns state no public operation can produce. Canonical\n266\t// consumers refuse it with state_corruption.\n267\texport async function corruptedVariantThread(\n268\t  store: TempStore,\n269\t): Promise<{ filePath: string; sdk: Lhc }> {\n270\t  const double = createProviderDouble();\n271\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n272\t  const filePath = store.threadPath();\n273\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n274\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n275\t  for (let turn = 1; turn <= 3; turn += 1) {\n276\t    await send(sdk, filePath, turnEvents(turn));\n277\t  }\n278\t  await drain(sdk, filePath);\n279\t  // Open a turn through real intake, then add a second open row: two open\n280\t  // turns, the Epic 01 invariant violation.\n281\t  await send(sdk, filePath, [\n282\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n283\t  ]);\n284\t  corruptTwoOpenTurns(filePath);\n285\t  return { filePath, sdk };\n286\t}\n287\t\n288\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\n289\t// queued derivation meets real source damage at drain time — the handler\n290\t// finds two open turns and lands the turn forms blocked through the\n291\t// production terminal path, never a hand-written row.\n292\texport async function blockedSiblingThread(\n293\t  store: TempStore,\n294\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\n295\t  const double = createProviderDouble();\n296\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n297\t  const filePath = store.threadPath();\n298\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n299\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n300\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\n301\t  // real intake; the corruption writer adds another open row. The drain then\n302\t  // claims t1's derivation against a record with two open turns.\n303\t  await send(sdk, filePath, turnEvents(1));\n304\t  await send(sdk, filePath, [\n305\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n306\t  ]);\n307\t  corruptTwoOpenTurns(filePath);\n308\t  const report = await sdk.work.drain({ filePath });\n309\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n310\t  const blocked = report.value.ran.find(\n311\t    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n312\t  );\n313\t  if (blocked === undefined) {\n314\t    throw new Error(\"fixture invariant: turn_derivation expected to land terminal on damage\");\n315\t  }\n316\t  return { filePath, sdk, blockedTurnId: \"t1\" };\n317\t}\n318\t"}]},"parent_tool_use_id":null,"session_id":"f006cddb-2184-479e-939b-55dccd3023e3","uuid":"3996bdbd-b8f8-49fc-ac54-1e2022834f28","timestamp":"2026-06-11T16:36:42.047Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-thread.ts","content":"// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n// deterministic provider double into known form states. States are reached\n// through production paths, never hand-written rows (the anti-shim line\n// FC-0.3 enforces): the failed states come from scripted provider failures\n// consumed by the real retry/exhaustion mechanics, and blocked comes from\n// real source damage on a sacrificial sibling thread. Every later Epic 03\n// story compacts against what this builder returns.\nimport {\n  createSdk,\n  type FormReportEntry,\n  type Lhc,\n  type MessageEventInput,\n} from \"../../src/index.js\";\nimport { corruptTwoOpenTurns } from \"./corrupt.js\";\nimport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\nimport { readChunks, type ChunkSnapshot } from \"./threads.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\n// Reason classes the scripted failures stamp, chosen from the sweep\n// classification table's vocabulary (tech design §Spec Validation): a\n// rate-limit class reads transient, a content-refusal class reads permanent —\n// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n// Story 3 depends on it.\nexport const TRANSIENT_EXHAUST_REASON =\n  \"rate_limit: scripted transient exhaustion (fixture)\";\nexport const PERMANENT_FAILURE_REASON =\n  \"content_refusal: scripted permanent failure (fixture)\";\n\n// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n// (3 members each; c1–c3 closed, c4 still open). Projections from the\n// deterministic double are near-constant in size (`projection(<digest>:<40\n// chars>)`), so the cut is stable; the builder asserts the shape and throws\n// if drift ever moves it.\nconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n\nconst TURN_COUNT = 12;\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n\nfunction turnEvents(turn: number): MessageEventInput[] {\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", {\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n    }),\n    validEvent(\"assistant_thinking\", {\n      payload: { text: `considering what area ${turn} contains` },\n    }),\n  ];\n  if (TOOL_HEAVY_TURNS.has(turn)) {\n    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n    // realistic over-max zone of tool results to age behind the boundary.\n    for (const run of [1, 2]) {\n      const toolCallId = `call-fx-${turn}-${run}`;\n      events.push(\n        validEvent(\"tool_call\", {\n          payload: {\n            toolCallId,\n            toolName: \"read_file\",\n            arguments: { path: `area-${turn}/file-${run}.txt` },\n          },\n        }),\n        validEvent(\"tool_result\", {\n          payload: {\n            toolCallId,\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n            isError: false,\n          },\n        }),\n      );\n    }\n  }\n  events.push(\n    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n    validEvent(\"turn_end\"),\n  );\n  return events;\n}\n\nexport interface DerivedThreadFixture {\n  filePath: string;\n  sdk: Lhc;\n  double: ProviderDouble;\n  turnIds: string[]; // t1..t12\n  chunks: ChunkSnapshot;\n  // The two manufactured failed subjects (tool_result_summary forms), reached\n  // through real retry exhaustion / terminal failure — absent when failures\n  // are disabled for a variant.\n  failedTransientMessageId?: string;\n  failedPermanentMessageId?: string;\n  // The straggler variant's turnId-null messages: one between two turns, one\n  // after the last turn — absent unless stragglers are enabled.\n  stragglerBetweenMessageId?: string;\n  stragglerTrailingMessageId?: string;\n}\n\nexport interface DerivedThreadOptions {\n  failures?: boolean; // default true: manufacture the two failed states\n  stragglers?: boolean; // default false: insert the turnless runtime notes\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<string[]> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n  return result.value.events.map((entry) => entry.messageId ?? \"\");\n}\n\nasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n  const report = await sdk.work.drain({ filePath });\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n    throw new Error(\n      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n    );\n  }\n}\n\nfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n}\n\nexport async function derivedThreadFixture(\n  store: TempStore,\n  opts: DerivedThreadOptions = {},\n): Promise<DerivedThreadFixture> {\n  const failures = opts.failures ?? true;\n  const stragglers = opts.stragglers ?? false;\n\n  const double = createProviderDouble();\n  const sdk = createSdk({\n    provider: double,\n    mode: \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    chunkPolicy: FIXTURE_CHUNK_POLICY,\n  });\n\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n\n  const turnIds: string[] = [];\n  const fixture: DerivedThreadFixture = {\n    filePath,\n    sdk,\n    double,\n    turnIds,\n    chunks: { chunks: [], members: [] },\n  };\n\n  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n    if (failures && turn === 6) {\n      // Retryable failures consumed to exhaustion by the head-first drain:\n      // the first tool_result_summary item of this batch takes all three\n      // attempts and lands failed with the transient reason class.\n      double.failKind(\"tool_result_summary\", 3, {\n        retryable: true,\n        reason: TRANSIENT_EXHAUST_REASON,\n      });\n    }\n    if (failures && turn === 7) {\n      // One non-retryable failure: terminal on the first attempt — the\n      // permanent reason class, attempts 1.\n      double.failKind(\"tool_result_summary\", 1, {\n        retryable: false,\n        reason: PERMANENT_FAILURE_REASON,\n      });\n    }\n    const messageIds = await send(sdk, filePath, turnEvents(turn));\n    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n    // result, call, result, text, end — index 3 is the first tool result,\n    // the scripted failures' subject.\n    const firstToolResultId = messageIds[3];\n    if (failures && (turn === 6 || turn === 7)) {\n      if (firstToolResultId === undefined || firstToolResultId === \"\") {\n        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\n      }\n      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\n      else fixture.failedPermanentMessageId = firstToolResultId;\n    }\n    await drain(sdk, filePath);\n\n    if (stragglers && turn === 3) {\n      // A runtime note between turn 3's end and turn 4's prompt: projected\n      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\n      const noteIds = await send(sdk, filePath, [\n        validEvent(\"runtime_note\", {\n          payload: { text: \"harness restarted between turns (fixture straggler)\" },\n        }),\n      ]);\n      const noteId = noteIds[0];\n      if (noteId === undefined || noteId === \"\") {\n        throw new Error(\"fixture invariant: between-turns straggler did not project\");\n      }\n      fixture.stragglerBetweenMessageId = noteId;\n    }\n    turnIds.push(`t${turn}`);\n  }\n\n  if (stragglers) {\n    const noteIds = await send(sdk, filePath, [\n      validEvent(\"runtime_note\", {\n        payload: { text: \"session closing note after the last turn (fixture straggler)\" },\n      }),\n    ]);\n    const noteId = noteIds[0];\n    if (noteId === undefined || noteId === \"\") {\n      throw new Error(\"fixture invariant: trailing straggler did not project\");\n    }\n    fixture.stragglerTrailingMessageId = noteId;\n    await drain(sdk, filePath);\n  }\n\n  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\n  // chunks, the first three closed. A failure here means the deterministic\n  // substrate moved (provider output or tokenizer), not a flaky test.\n  fixture.chunks = readChunks(filePath);\n  if (fixture.chunks.chunks.length !== 4) {\n    throw new Error(\n      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\n    );\n  }\n  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \"closed\").length;\n  if (closed !== 3) {\n    throw new Error(\n      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\n    );\n  }\n\n  if (failures) {\n    // Verify the manufactured states by read-back through the owning report\n    // surface before handing the fixture to any test (FC-0.3's enforcement\n    // lives in the tests; this guards the builder's own contract).\n    const report = await sdk.messages.report({ filePath });\n    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\n    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\n    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\n    if (\n      transient.length !== 1 ||\n      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\n      permanent.length !== 1 ||\n      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\n    ) {\n      throw new Error(\n        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\n      );\n    }\n  }\n\n  return fixture;\n}\n\n// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\n// conversation with a runtime note between two turns and one after the last\n// turn, fully drained, no manufactured failures.\nexport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\n  return derivedThreadFixture(store, { failures: false, stragglers: true });\n}\n\n// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\n// short real conversation, drained clean, then damaged below the SDK into\n// the two-open-turns state no public operation can produce. Canonical\n// consumers refuse it with state_corruption.\nexport async function corruptedVariantThread(\n  store: TempStore,\n): Promise<{ filePath: string; sdk: Lhc }> {\n  const double = createProviderDouble();\n  const sdk = createSdk({ provider: double, mode: \"manual\" });\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  for (let turn = 1; turn <= 3; turn += 1) {\n    await send(sdk, filePath, turnEvents(turn));\n  }\n  await drain(sdk, filePath);\n  // Open a turn through real intake, then add a second open row: two open\n  // turns, the Epic 01 invariant violation.\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n  ]);\n  corruptTwoOpenTurns(filePath);\n  return { filePath, sdk };\n}\n\n// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\n// queued derivation meets real source damage at drain time — the handler\n// finds two open turns and lands the turn forms blocked through the\n// production terminal path, never a hand-written row.\nexport async function blockedSiblingThread(\n  store: TempStore,\n): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\n  const double = createProviderDouble();\n  const sdk = createSdk({ provider: double, mode: \"manual\" });\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  // Turn 1 closes (its turn_derivation queues); a second turn opens through\n  // real intake; the corruption writer adds another open row. The drain then\n  // claims t1's derivation against a record with two open turns.\n  await send(sdk, filePath, turnEvents(1));\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n  ]);\n  corruptTwoOpenTurns(filePath);\n  const report = await sdk.work.drain({ filePath });\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n  const blocked = report.value.ran.find(\n    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n  );\n  if (blocked === undefined) {\n    throw new Error(\"fixture invariant: turn_derivation expected to land terminal on damage\");\n  }\n  return { filePath, sdk, blockedTurnId: \"t1\" };\n}\n","numLines":318,"startLine":1,"totalLines":318}}}

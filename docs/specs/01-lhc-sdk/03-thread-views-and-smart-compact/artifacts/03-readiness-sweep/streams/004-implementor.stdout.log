unkBrief(i: {\n    memberProjections: string[];\n    memberOutcomes?: ToolOutcome[][];\n  }): Promise<ProviderResult> {\n    return this.run(\n      \"summarizeChunkBrief\",\n      i,\n      i.memberProjections.join(\" | \"),\n      deterministicOutcomesSuffix(i.memberOutcomes),\n    );\n---\ntest/view-pull.test.ts:169:    // The double's capture log starts recording here; any Epic 03 read that\ntest/view-pull.test.ts:172:    const captured = fixture.double.captureInputs();\ntest/view-pull.test.ts:188:    expect(captured.length).toBe(0);\ntest/view-pull.test.ts:396:    const captured = heavy.double.captureInputs();\ntest/view-pull.test.ts:430:    expect(captured.length).toBe(0);\ntest/view-pull.test.ts:493:    const captured = bgDouble.captureInputs();\ntest/view-pull.test.ts:518:    expect(captured.length).toBe(0);\ntest/view-compact.test.ts:229:    const captured = fixture.double.captureInputs();\ntest/view-compact.test.ts:230:    const capturedBefore = captured.length;\ntest/view-compact.test.ts:280:    expect(captured.length).toBe(capturedBefore);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

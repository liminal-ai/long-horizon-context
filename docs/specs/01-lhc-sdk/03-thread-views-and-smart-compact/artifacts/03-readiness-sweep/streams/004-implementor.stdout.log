{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018A8bkh145AXniSjhPbvhVM","type":"tool_result","content":"1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n2\t// Story 1 lands the skeleton with `pull` and `status` real — the hot-path\n3\t// reads: local reads and deterministic string assembly only, no inference,\n4\t// no network, no queue interaction, no writes (AC-1.1, AC-2.8). The other\n5\t// three are structured-result stubs until their stories (2, 3, 5) land.\n6\t// Story 0's substrate (profile resolution, consumed by createSdk) re-exports\n7\t// at the bottom.\n8\timport { existsSync } from \"node:fs\";\n9\timport {\n10\t  resolveInstanceViewConfig,\n11\t  runWithThreadTouchSuppressed,\n12\t} from \"../../shared/context.js\";\n13\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n14\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n15\timport type {\n16\t  CompactReceipt,\n17\t  PullResult,\n18\t  ResolvedViewConfig,\n19\t  SweepReceipt,\n20\t  ViewCompactParams,\n21\t  ViewMessage,\n22\t  ViewProfile,\n23\t  ViewStatus,\n24\t} from \"../../shared/view.js\";\n25\timport * as messagesDomain from \"../messages/index.js\";\n26\timport * as turnsDomain from \"../turns/index.js\";\n27\timport {\n28\t  openThreadDatabase,\n29\t  resolveThreadRef,\n30\t  type ThreadRef,\n31\t} from \"../threads/index.js\";\n32\timport { readBoundaryPosition, visibilityZoneTokens } from \"./internal/boundary.js\";\n33\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n34\timport {\n35\t  assembleBandText,\n36\t  renderBandMessage,\n37\t  renderTailMessage,\n38\t  toolNamesByCallId,\n39\t} from \"./internal/render.js\";\n40\timport { fireViewInjection } from \"./internal/seam.js\";\n41\timport {\n42\t  CanonicalCorruptionError,\n43\t  readSelectionInputs,\n44\t  selectArrangement,\n45\t  type ArrangementEntry,\n46\t} from \"./internal/select.js\";\n47\timport {\n48\t  readReadyToolResultSummaries,\n49\t  readTailMessages,\n50\t  readViewSnapshot,\n51\t  replaceViewSnapshot,\n52\t  tailTokenSum,\n53\t} from \"./internal/snapshot.js\";\n54\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n55\timport type { Band } from \"../../shared/view.js\";\n56\t\n57\t// Config resolution for the operation in hand: the SDK instance's resolved\n58\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n59\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n60\t// through the same one resolution path createSdk uses.\n61\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n62\t\n63\tfunction viewConfig(): ResolvedViewConfig {\n64\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n65\t}\n66\t\n67\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n68\t  return {\n69\t    ok: false,\n70\t    error: {\n71\t      errorClass: \"caller_error\",\n72\t      code: \"thread_not_found\",\n73\t      reason: `no thread file exists at ${filePath}`,\n74\t    },\n75\t  };\n76\t}\n77\t\n78\tfunction detail(cause: unknown): string {\n79\t  return cause instanceof Error ? cause.message : String(cause);\n80\t}\n81\t\n82\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n83\t\n84\t// The hot-path read: view header + bands (if any), tail messages after the\n85\t// compact point (deleted-filtered, record order), boundary position; then\n86\t// format — band messages first, tail per the mapping table, tool results\n87\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n88\t// tail from event 1 (AC-1.3) through this same code path with the compact\n89\t// point at its zero origin — snapshot-absent, never a separate branch.\n90\t//\n91\t// Reads-only is structural, not disciplined: the whole operation runs in the\n92\t// touch-suppressed scope, so the open announcement that would let a\n93\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n94\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n95\t// AC-1.1's no-queue-interaction holds in both host modes.\n96\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n97\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n98\t}\n99\t\n100\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n101\t  const resolved = await resolveThreadRef(ref);\n102\t  if (!resolved.ok) return resolved;\n103\t  const { filePath } = resolved.value;\n104\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n105\t\n106\t  const opened = openThreadDatabase(filePath);\n107\t  if (!opened.ok) return opened;\n108\t  const db = opened.value;\n109\t  try {\n110\t    const snapshot = readViewSnapshot(db);\n111\t    const compactPoint = snapshot?.compactPoint ?? 0;\n112\t    const boundaryPosition = readBoundaryPosition(db);\n113\t    const tailRows = readTailMessages(db, compactPoint);\n114\t    const renderCtx = {\n115\t      boundaryPosition,\n116\t      toolNameByCallId: toolNamesByCallId(tailRows),\n117\t      toolResultSummaries: readReadyToolResultSummaries(db),\n118\t    };\n119\t\n120\t    const messages: ViewMessage[] = [];\n121\t    if (snapshot !== null) {\n122\t      for (const band of snapshot.bands) {\n123\t        messages.push(renderBandMessage(band.band, band.renderedText));\n124\t      }\n125\t    }\n126\t    for (const row of tailRows) {\n127\t      messages.push(renderTailMessage(row, renderCtx));\n128\t    }\n129\t\n130\t    return {\n131\t      ok: true,\n132\t      value: {\n133\t        messages,\n134\t        meta: {\n135\t          compactPoint: snapshot?.compactPoint ?? null,\n136\t          coveredFrom: snapshot?.coveredFrom ?? null,\n137\t          boundaryPosition,\n138\t          gapCount: snapshot?.gapCount ?? 0,\n139\t          degradedCount: snapshot?.degradedCount ?? 0,\n140\t          viewId: snapshot?.viewId ?? null,\n141\t          createdAt: snapshot?.createdAt ?? null,\n142\t        },\n143\t      },\n144\t    };\n145\t  } catch (cause) {\n146\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n147\t  } finally {\n148\t    db.close();\n149\t  }\n150\t}\n151\t\n152\t// ── status (AC-2.8) ───────────────────────────────────────────────\n153\t\n154\t// Derivation counts bucket from one report entry the way the report's own\n155\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n156\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n157\t// forms are healthy and not an operational situation.\n158\tfunction bucketDerivation(\n159\t  entries: readonly FormReportEntry[],\n160\t  counts: ViewStatus[\"derivation\"],\n161\t): void {\n162\t  for (const entry of entries) {\n163\t    switch (entry.state) {\n164\t      case \"pending\":\n165\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n166\t        else counts.pending += 1;\n167\t        break;\n168\t      case \"failed\":\n169\t        counts.failed += 1;\n170\t        break;\n171\t      case \"blocked\":\n172\t        counts.blocked += 1;\n173\t        break;\n174\t      case \"ready\":\n175\t        break;\n176\t    }\n177\t  }\n178\t}\n179\t\n180\t// Reads only, callable any time, no side effects: tail size against the\n181\t// configured trigger threshold with a compact recommendation (`tailTokens >\n182\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n183\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n184\t// direct derived_form read here), the active view's health or null\n185\t// pre-compact, and the visibility zone's sum against its max — computed live\n186\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n187\t// structural, not stored.\n188\t//\n189\t// Like pull, the whole read — including the owners' report surfaces it\n190\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n191\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n192\t// host modes).\n193\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n194\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n195\t}\n196\t\n197\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n198\t  const resolved = await resolveThreadRef(ref);\n199\t  if (!resolved.ok) return resolved;\n200\t  const { filePath } = resolved.value;\n201\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n202\t\n203\t  const config = viewConfig();\n204\t  const opened = openThreadDatabase(filePath);\n205\t  if (!opened.ok) return opened;\n206\t  const db = opened.value;\n207\t  let tailTokens: number;\n208\t  let zoneTokens: number;\n209\t  let view: ViewStatus[\"view\"];\n210\t  try {\n211\t    const snapshot = readViewSnapshot(db);\n212\t    const compactPoint = snapshot?.compactPoint ?? 0;\n213\t    const boundaryPosition = readBoundaryPosition(db);\n214\t    tailTokens = tailTokenSum(db, compactPoint);\n215\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n216\t    view =\n217\t      snapshot === null\n218\t        ? null\n219\t        : {\n220\t            degraded: snapshot.degradedCount,\n221\t            gaps: snapshot.gapCount,\n222\t            builtAt: snapshot.createdAt,\n223\t          };\n224\t  } catch (cause) {\n225\t    return storageFailure(`view status failed: ${detail(cause)}`);\n226\t  } finally {\n227\t    db.close();\n228\t  }\n229\t\n230\t  // The owners' report surfaces open their own handles; ours is closed first\n231\t  // so the status read never holds two handles on one thread file.\n232\t  const messageReport = await messagesDomain.report({ filePath });\n233\t  if (!messageReport.ok) return messageReport;\n234\t  const turnReport = await turnsDomain.report({ filePath });\n235\t  if (!turnReport.ok) return turnReport;\n236\t  const derivation: ViewStatus[\"derivation\"] = {\n237\t    pending: 0,\n238\t    retrying: 0,\n239\t    failed: 0,\n240\t    blocked: 0,\n241\t  };\n242\t  bucketDerivation(messageReport.value, derivation);\n243\t  bucketDerivation(turnReport.value, derivation);\n244\t\n245\t  return {\n246\t    ok: true,\n247\t    value: {\n248\t      tailTokens,\n249\t      threshold: config.compactThreshold,\n250\t      compactRecommended: tailTokens > config.compactThreshold,\n251\t      derivation,\n252\t      view,\n253\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n254\t    },\n255\t  };\n256\t}\n257\t\n258\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n259\t\n260\t// The default base when no profile is named: the first built-in, matching\n261\t// the epic's primary user (the PI continuation harness). Explicit params\n262\t// override the base field-wise (AC-2.2).\n263\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n264\t\n265\tfunction callerError(\n266\t  code: \"unknown_profile\" | \"invalid_view_config\",\n267\t  reason: string,\n268\t): { ok: false; error: ErrorResult } {\n269\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n270\t}\n271\t\n272\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n273\t\n274\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n275\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n276\t// rejection provably touches nothing) → [sweep step ABSENT this story — the\n277\t// receipt's sweep field reports the literal \"absent\"; Story 3 embeds the\n278\t// real sweep here per stories/02-smart-compact.md §Scope out] → read record\n279\t// + forms with the corruption check in the reads (pre-transaction, prior\n280\t// view trivially intact on refusal) → selection walk → band rendering → one\n281\t// BEGIN IMMEDIATE replacing the view and resetting the boundary → receipt.\n282\t// Assembly is entirely from stored artifacts: nothing here can reach a\n283\t// provider (AC-2.4 zero-inference is structural).\n284\texport async function compact(\n285\t  ref: ThreadRef,\n286\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n287\t): Promise<OpResult<CompactReceipt>> {\n288\t  const resolved = await resolveThreadRef(ref);\n289\t  if (!resolved.ok) return resolved;\n290\t  const { filePath } = resolved.value;\n291\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n292\t\n293\t  const config = viewConfig();\n294\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n295\t  const base = config.profiles[baseName];\n296\t  if (base === undefined) {\n297\t    return callerError(\n298\t      \"unknown_profile\",\n299\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n300\t        .map((name) => `\"${name}\"`)\n301\t        .join(\", \")}`,\n302\t    );\n303\t  }\n304\t  const merged: ViewProfile = {\n305\t    name: base.name,\n306\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n307\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n308\t  };\n309\t  const violation = profileViolation(merged);\n310\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n311\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n312\t  // any param override means the config is no longer a named profile's mix,\n313\t  // even when one served as the merge base; the receipt's config carries the\n314\t  // resolved truth. A bare or profile-only call names its profile.\n315\t  const profileName = opts.params === undefined ? baseName : null;\n316\t\n317\t  const opened = openThreadDatabase(filePath);\n318\t  if (!opened.ok) return opened;\n319\t  const db = opened.value;\n320\t  try {\n321\t    let inputs;\n322\t    try {\n323\t      inputs = readSelectionInputs(db);\n324\t    } catch (cause) {\n325\t      if (cause instanceof CanonicalCorruptionError) {\n326\t        // Pre-transaction refusal: nothing was written, the prior view and\n327\t        // the record are untouched (AC-2.5).\n328\t        return {\n329\t          ok: false,\n330\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n331\t        };\n332\t      }\n333\t      throw cause;\n334\t    }\n335\t    const selection = selectArrangement(inputs, {\n336\t      lowerBound: merged.lowerBound,\n337\t      percentages: merged.percentages,\n338\t    });\n339\t\n340\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n341\t      selection.entries.filter((entry) => entry.band === band);\n342\t    const bands = BAND_ORDER.flatMap((band) => {\n343\t      const entries = entriesByBand(band);\n344\t      if (entries.length === 0) return [];\n345\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n346\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n347\t    });\n348\t\n349\t    const createdAt = new Date().toISOString();\n350\t    // view_id is v<compact event order> — deterministic, and deliberately\n351\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n352\t    // into a uniqueness scheme; the singleton row is replaced whole).\n353\t    const viewId = `v${inputs.maxEventOrder}`;\n354\t\n355\t    // Story-0 injection point: TC-2.4's crash between the (absent) sweep and\n356\t    // the view-write transaction. An installed hook's throw aborts here —\n357\t    // before BEGIN — so the previous view keeps serving.\n358\t    fireViewInjection(\"compact-write\");\n359\t\n360\t    replaceViewSnapshot(db, {\n361\t      viewId,\n362\t      createdAt,\n363\t      compactPoint: selection.compactPoint,\n364\t      coveredFrom: selection.coveredFrom,\n365\t      profileName,\n366\t      configJson: JSON.stringify({\n367\t        lowerBound: merged.lowerBound,\n368\t        percentages: merged.percentages,\n369\t      }),\n370\t      arrangementJson: JSON.stringify(\n371\t        selection.entries.map((entry) => ({\n372\t          band: entry.band,\n373\t          subjectKind: entry.subjectKind,\n374\t          subjectId: entry.subjectId,\n375\t          formUsed: entry.formUsed,\n376\t          degraded: entry.degraded,\n377\t        })),\n378\t      ),\n379\t      gapsJson: JSON.stringify(\n380\t        selection.entries\n381\t          .filter((entry) => entry.gap)\n382\t          .map((entry) => ({\n383\t            band: entry.band,\n384\t            subjectId: entry.subjectId,\n385\t            reason: entry.reason ?? \"unknown\",\n386\t          })),\n387\t      ),\n388\t      sourceStateJson: JSON.stringify({\n389\t        maxEventOrder: inputs.maxEventOrder,\n390\t        formCounts: inputs.formCounts,\n391\t      }),\n392\t      bands,\n393\t    });\n394\t\n395\t    const bandReport = {} as CompactReceipt[\"bands\"];\n396\t    for (const band of BAND_ORDER) {\n397\t      const stored = bands.find((row) => row.band === band);\n398\t      bandReport[band] = {\n399\t        entries: entriesByBand(band).length,\n400\t        tokens: stored?.tokenCount ?? 0,\n401\t      };\n402\t    }\n403\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n404\t    return {\n405\t      ok: true,\n406\t      value: {\n407\t        viewId,\n408\t        profile: profileName,\n409\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n410\t        bands: bandReport,\n411\t        tailTokens,\n412\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n413\t        totalTokens:\n414\t          bandReport.brief.tokens +\n415\t          bandReport.detailed.tokens +\n416\t          bandReport.smooth.tokens +\n417\t          tailTokens,\n418\t        coveredFrom: selection.coveredFrom,\n419\t        compactPoint: selection.compactPoint,\n420\t        degraded: selection.entries\n421\t          .filter((entry) => entry.degraded)\n422\t          .map((entry) => ({\n423\t            band: entry.band,\n424\t            subjectId: entry.subjectId,\n425\t            usedForm: entry.formUsed,\n426\t          })),\n427\t        gaps: selection.entries\n428\t          .filter((entry) => entry.gap)\n429\t          .map((entry) => ({\n430\t            band: entry.band,\n431\t            subjectId: entry.subjectId,\n432\t            reason: entry.reason ?? \"unknown\",\n433\t          })),\n434\t        // Sweep step absent this story (NOT skipped, NOT an empty receipt):\n435\t        // Story 3 embeds the sweep and flips this field's vocabulary.\n436\t        sweep: \"absent\",\n437\t      },\n438\t    };\n439\t  } catch (cause) {\n440\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n441\t  } finally {\n442\t    db.close();\n443\t  }\n444\t}\n445\t\n446\t// ── stubs (Stories 3, 5) ─────────────────────────────────────────\n447\t\n448\t// The skeleton's stub contract (tech design §Interface Definitions):\n449\t// structured result, machine-readable, never a throw on this surface.\n450\tfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n451\t  return {\n452\t    ok: false,\n453\t    error: {\n454\t      errorClass: \"system_error\",\n455\t      code: \"not_implemented\",\n456\t      reason: `not implemented: ${op}`,\n457\t    },\n458\t  };\n459\t}\n460\t\n461\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n462\t  void ref;\n463\t  return notImplemented(\"sweep\");\n464\t}\n465\t\n466\texport async function materialize(\n467\t  ref: ThreadRef,\n468\t  opts: { path: string; format?: \"pi-session\" },\n469\t): Promise<OpResult<{ writtenPath: string }>> {\n470\t  void ref;\n471\t  void opts;\n472\t  return notImplemented(\"materialize\");\n473\t}\n474\t\n475\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n476\texport {\n477\t  BUILT_IN_PROFILES,\n478\t  DEFAULT_COMPACT_THRESHOLD,\n479\t  DEFAULT_VISIBILITY,\n480\t  resolveViewConfig,\n481\t} from \"./internal/profiles.js\";\n482\t"}]},"parent_tool_use_id":null,"session_id":"f006cddb-2184-479e-939b-55dccd3023e3","uuid":"55b73318-02e7-4c75-92d4-8b8ab3c9a3f6","timestamp":"2026-06-11T16:35:28.321Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/index.ts","content":"// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n// Story 1 lands the skeleton with `pull` and `status` real — the hot-path\n// reads: local reads and deterministic string assembly only, no inference,\n// no network, no queue interaction, no writes (AC-1.1, AC-2.8). The other\n// three are structured-result stubs until their stories (2, 3, 5) land.\n// Story 0's substrate (profile resolution, consumed by createSdk) re-exports\n// at the bottom.\nimport { existsSync } from \"node:fs\";\nimport {\n  resolveInstanceViewConfig,\n  runWithThreadTouchSuppressed,\n} from \"../../shared/context.js\";\nimport type { FormReportEntry } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewProfile,\n  ViewStatus,\n} from \"../../shared/view.js\";\nimport * as messagesDomain from \"../messages/index.js\";\nimport * as turnsDomain from \"../turns/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport { readBoundaryPosition, visibilityZoneTokens } from \"./internal/boundary.js\";\nimport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\nimport {\n  assembleBandText,\n  renderBandMessage,\n  renderTailMessage,\n  toolNamesByCallId,\n} from \"./internal/render.js\";\nimport { fireViewInjection } from \"./internal/seam.js\";\nimport {\n  CanonicalCorruptionError,\n  readSelectionInputs,\n  selectArrangement,\n  type ArrangementEntry,\n} from \"./internal/select.js\";\nimport {\n  readReadyToolResultSummaries,\n  readTailMessages,\n  readViewSnapshot,\n  replaceViewSnapshot,\n  tailTokenSum,\n} from \"./internal/snapshot.js\";\nimport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\nimport type { Band } from \"../../shared/view.js\";\n\n// Config resolution for the operation in hand: the SDK instance's resolved\n// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n// through the same one resolution path createSdk uses.\nconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n\nfunction viewConfig(): ResolvedViewConfig {\n  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n\n// The hot-path read: view header + bands (if any), tail messages after the\n// compact point (deleted-filtered, record order), boundary position; then\n// format — band messages first, tail per the mapping table, tool results\n// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n// tail from event 1 (AC-1.3) through this same code path with the compact\n// point at its zero origin — snapshot-absent, never a separate branch.\n//\n// Reads-only is structural, not disciplined: the whole operation runs in the\n// touch-suppressed scope, so the open announcement that would let a\n// background SDK's scheduler hang a first-touch catch-up drain off this read\n// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n// AC-1.1's no-queue-interaction holds in both host modes.\nexport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  return runWithThreadTouchSuppressed(() => pullInner(ref));\n}\n\nasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const snapshot = readViewSnapshot(db);\n    const compactPoint = snapshot?.compactPoint ?? 0;\n    const boundaryPosition = readBoundaryPosition(db);\n    const tailRows = readTailMessages(db, compactPoint);\n    const renderCtx = {\n      boundaryPosition,\n      toolNameByCallId: toolNamesByCallId(tailRows),\n      toolResultSummaries: readReadyToolResultSummaries(db),\n    };\n\n    const messages: ViewMessage[] = [];\n    if (snapshot !== null) {\n      for (const band of snapshot.bands) {\n        messages.push(renderBandMessage(band.band, band.renderedText));\n      }\n    }\n    for (const row of tailRows) {\n      messages.push(renderTailMessage(row, renderCtx));\n    }\n\n    return {\n      ok: true,\n      value: {\n        messages,\n        meta: {\n          compactPoint: snapshot?.compactPoint ?? null,\n          coveredFrom: snapshot?.coveredFrom ?? null,\n          boundaryPosition,\n          gapCount: snapshot?.gapCount ?? 0,\n          degradedCount: snapshot?.degradedCount ?? 0,\n          viewId: snapshot?.viewId ?? null,\n          createdAt: snapshot?.createdAt ?? null,\n        },\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view pull failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── status (AC-2.8) ───────────────────────────────────────────────\n\n// Derivation counts bucket from one report entry the way the report's own\n// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n// pending, retrying (pending with attempts spent), failed, blocked. Ready\n// forms are healthy and not an operational situation.\nfunction bucketDerivation(\n  entries: readonly FormReportEntry[],\n  counts: ViewStatus[\"derivation\"],\n): void {\n  for (const entry of entries) {\n    switch (entry.state) {\n      case \"pending\":\n        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n        else counts.pending += 1;\n        break;\n      case \"failed\":\n        counts.failed += 1;\n        break;\n      case \"blocked\":\n        counts.blocked += 1;\n        break;\n      case \"ready\":\n        break;\n    }\n  }\n}\n\n// Reads only, callable any time, no side effects: tail size against the\n// configured trigger threshold with a compact recommendation (`tailTokens >\n// threshold`, nothing smarter — the caller owns policy), derivation counts\n// by state read through the OWNERS' report surfaces (must-not-own: never a\n// direct derived_form read here), the active view's health or null\n// pre-compact, and the visibility zone's sum against its max — computed live\n// by the same query the Story 4 advance will use, so \"visible in status\" is\n// structural, not stored.\n//\n// Like pull, the whole read — including the owners' report surfaces it\n// consumes — runs in the touch-suppressed scope, so a background SDK's\n// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n// host modes).\nexport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  return runWithThreadTouchSuppressed(() => statusInner(ref));\n}\n\nasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  let tailTokens: number;\n  let zoneTokens: number;\n  let view: ViewStatus[\"view\"];\n  try {\n    const snapshot = readViewSnapshot(db);\n    const compactPoint = snapshot?.compactPoint ?? 0;\n    const boundaryPosition = readBoundaryPosition(db);\n    tailTokens = tailTokenSum(db, compactPoint);\n    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n    view =\n      snapshot === null\n        ? null\n        : {\n            degraded: snapshot.degradedCount,\n            gaps: snapshot.gapCount,\n            builtAt: snapshot.createdAt,\n          };\n  } catch (cause) {\n    return storageFailure(`view status failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n\n  // The owners' report surfaces open their own handles; ours is closed first\n  // so the status read never holds two handles on one thread file.\n  const messageReport = await messagesDomain.report({ filePath });\n  if (!messageReport.ok) return messageReport;\n  const turnReport = await turnsDomain.report({ filePath });\n  if (!turnReport.ok) return turnReport;\n  const derivation: ViewStatus[\"derivation\"] = {\n    pending: 0,\n    retrying: 0,\n    failed: 0,\n    blocked: 0,\n  };\n  bucketDerivation(messageReport.value, derivation);\n  bucketDerivation(turnReport.value, derivation);\n\n  return {\n    ok: true,\n    value: {\n      tailTokens,\n      threshold: config.compactThreshold,\n      compactRecommended: tailTokens > config.compactThreshold,\n      derivation,\n      view,\n      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n    },\n  };\n}\n\n// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n\n// The default base when no profile is named: the first built-in, matching\n// the epic's primary user (the PI continuation harness). Explicit params\n// override the base field-wise (AC-2.2).\nconst DEFAULT_PROFILE_NAME = \"continuation\";\n\nfunction callerError(\n  code: \"unknown_profile\" | \"invalid_view_config\",\n  reason: string,\n): { ok: false; error: ErrorResult } {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n\n// Compact runs only when invoked through this surface (AC-2.1: no code path\n// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n// rejection provably touches nothing) → [sweep step ABSENT this story — the\n// receipt's sweep field reports the literal \"absent\"; Story 3 embeds the\n// real sweep here per stories/02-smart-compact.md §Scope out] → read record\n// + forms with the corruption check in the reads (pre-transaction, prior\n// view trivially intact on refusal) → selection walk → band rendering → one\n// BEGIN IMMEDIATE replacing the view and resetting the boundary → receipt.\n// Assembly is entirely from stored artifacts: nothing here can reach a\n// provider (AC-2.4 zero-inference is structural).\nexport async function compact(\n  ref: ThreadRef,\n  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n): Promise<OpResult<CompactReceipt>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n  const base = config.profiles[baseName];\n  if (base === undefined) {\n    return callerError(\n      \"unknown_profile\",\n      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n        .map((name) => `\"${name}\"`)\n        .join(\", \")}`,\n    );\n  }\n  const merged: ViewProfile = {\n    name: base.name,\n    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n    percentages: { ...base.percentages, ...opts.params?.percentages },\n  };\n  const violation = profileViolation(merged);\n  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n  // any param override means the config is no longer a named profile's mix,\n  // even when one served as the merge base; the receipt's config carries the\n  // resolved truth. A bare or profile-only call names its profile.\n  const profileName = opts.params === undefined ? baseName : null;\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    let inputs;\n    try {\n      inputs = readSelectionInputs(db);\n    } catch (cause) {\n      if (cause instanceof CanonicalCorruptionError) {\n        // Pre-transaction refusal: nothing was written, the prior view and\n        // the record are untouched (AC-2.5).\n        return {\n          ok: false,\n          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n        };\n      }\n      throw cause;\n    }\n    const selection = selectArrangement(inputs, {\n      lowerBound: merged.lowerBound,\n      percentages: merged.percentages,\n    });\n\n    const entriesByBand = (band: Band): ArrangementEntry[] =>\n      selection.entries.filter((entry) => entry.band === band);\n    const bands = BAND_ORDER.flatMap((band) => {\n      const entries = entriesByBand(band);\n      if (entries.length === 0) return [];\n      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n    });\n\n    const createdAt = new Date().toISOString();\n    // view_id is v<compact event order> — deterministic, and deliberately\n    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n    // into a uniqueness scheme; the singleton row is replaced whole).\n    const viewId = `v${inputs.maxEventOrder}`;\n\n    // Story-0 injection point: TC-2.4's crash between the (absent) sweep and\n    // the view-write transaction. An installed hook's throw aborts here —\n    // before BEGIN — so the previous view keeps serving.\n    fireViewInjection(\"compact-write\");\n\n    replaceViewSnapshot(db, {\n      viewId,\n      createdAt,\n      compactPoint: selection.compactPoint,\n      coveredFrom: selection.coveredFrom,\n      profileName,\n      configJson: JSON.stringify({\n        lowerBound: merged.lowerBound,\n        percentages: merged.percentages,\n      }),\n      arrangementJson: JSON.stringify(\n        selection.entries.map((entry) => ({\n          band: entry.band,\n          subjectKind: entry.subjectKind,\n          subjectId: entry.subjectId,\n          formUsed: entry.formUsed,\n          degraded: entry.degraded,\n        })),\n      ),\n      gapsJson: JSON.stringify(\n        selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n      ),\n      sourceStateJson: JSON.stringify({\n        maxEventOrder: inputs.maxEventOrder,\n        formCounts: inputs.formCounts,\n      }),\n      bands,\n    });\n\n    const bandReport = {} as CompactReceipt[\"bands\"];\n    for (const band of BAND_ORDER) {\n      const stored = bands.find((row) => row.band === band);\n      bandReport[band] = {\n        entries: entriesByBand(band).length,\n        tokens: stored?.tokenCount ?? 0,\n      };\n    }\n    const tailTokens = tailTokenSum(db, selection.compactPoint);\n    return {\n      ok: true,\n      value: {\n        viewId,\n        profile: profileName,\n        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n        bands: bandReport,\n        tailTokens,\n        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n        totalTokens:\n          bandReport.brief.tokens +\n          bandReport.detailed.tokens +\n          bandReport.smooth.tokens +\n          tailTokens,\n        coveredFrom: selection.coveredFrom,\n        compactPoint: selection.compactPoint,\n        degraded: selection.entries\n          .filter((entry) => entry.degraded)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            usedForm: entry.formUsed,\n          })),\n        gaps: selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n        // Sweep step absent this story (NOT skipped, NOT an empty receipt):\n        // Story 3 embeds the sweep and flips this field's vocabulary.\n        sweep: \"absent\",\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view compact failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── stubs (Stories 3, 5) ─────────────────────────────────────────\n\n// The skeleton's stub contract (tech design §Interface Definitions):\n// structured result, machine-readable, never a throw on this surface.\nfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"system_error\",\n      code: \"not_implemented\",\n      reason: `not implemented: ${op}`,\n    },\n  };\n}\n\nexport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n  void ref;\n  return notImplemented(\"sweep\");\n}\n\nexport async function materialize(\n  ref: ThreadRef,\n  opts: { path: string; format?: \"pi-session\" },\n): Promise<OpResult<{ writtenPath: string }>> {\n  void ref;\n  void opts;\n  return notImplemented(\"materialize\");\n}\n\n// ── Story 0 substrate (consumed by createSdk at construction) ─────\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n  resolveViewConfig,\n} from \"./internal/profiles.js\";\n","numLines":482,"startLine":1,"totalLines":482}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Noo1u8cBfVz37rG7EakctX","type":"tool_result","content":"95\t  try {\n96\t    return sha256({\n97\t      record: recordSnapshot(filePath),\n98\t      views: db.prepare(`SELECT * FROM thread_view`).all(),\n99\t      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n100\t      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\n101\t      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\n102\t    });\n103\t  } finally {\n104\t    db.close();\n105\t  }\n106\t}\n107\t\n108\tfunction viewRowCount(filePath: string): number {\n109\t  const db = openRaw(filePath);\n110\t  try {\n111\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\n112\t      n: number | bigint;\n113\t    };\n114\t    return Number(row.n);\n115\t  } finally {\n116\t    db.close();\n117\t  }\n118\t}\n119\t\n120\tfunction boundaryPosition(filePath: string): number {\n121\t  const db = openRaw(filePath);\n122\t  try {\n123\t    const row = db.prepare(`SELECT position FROM view_boundary`).get() as {\n124\t      position: number | bigint;\n125\t    };\n126\t    return Number(row.position);\n127\t  } finally {\n128\t    db.close();\n129\t  }\n130\t}\n131\t\n132\tfunction bandMessages(messages: readonly ViewMessage[]): ViewMessage[] {\n133\t  return messages.filter((message) => message.band !== undefined);\n134\t}\n135\t\n136\tasync function pullMessages(sdk: Lhc, filePath: string): Promise<ViewMessage[]> {\n137\t  const pulled = await sdk.threadView.pull({ filePath });\n138\t  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n139\t  return pulled.value.messages;\n140\t}\n141\t\n142\tdescribe(\"TC-2.1 (AC-2.2, AC-2.3, AC-2.7): profiles, explicit params, and named rejections\", () => {\n143\t  it(\"rejects percentages summing to 105 naming the sum, and an unknown profile naming it; thread unchanged\", async () => {\n144\t    const before = fullStateSnapshot(fixture.filePath);\n145\t\n146\t    const badSum = await fixture.sdk.threadView.compact(\n147\t      { filePath: fixture.filePath },\n148\t      { params: { percentages: { full: 30, smooth: 30, detailed: 25, brief: 20 } } },\n149\t    );\n150\t    expect(badSum.ok).toBe(false);\n151\t    if (badSum.ok) return;\n152\t    expect(badSum.error.errorClass).toBe(\"caller_error\");\n153\t    expect(badSum.error.code).toBe(\"invalid_view_config\");\n154\t    expect(badSum.error.reason).toContain(\"105\");\n155\t\n156\t    const badBound = await fixture.sdk.threadView.compact(\n157\t      { filePath: fixture.filePath },\n158\t      { params: { lowerBound: 0 } },\n159\t    );\n160\t    expect(badBound.ok).toBe(false);\n161\t    if (badBound.ok) return;\n162\t    expect(badBound.error.code).toBe(\"invalid_view_config\");\n163\t    expect(badBound.error.reason).toContain(\"lowerBound\");\n164\t\n165\t    const unknown = await fixture.sdk.threadView.compact(\n166\t      { filePath: fixture.filePath },\n167\t      { profile: \"nonesuch\" },\n168\t    );\n169\t    expect(unknown.ok).toBe(false);\n170\t    if (unknown.ok) return;\n171\t    expect(unknown.error.errorClass).toBe(\"caller_error\");\n172\t    expect(unknown.error.code).toBe(\"unknown_profile\");\n173\t    expect(unknown.error.reason).toContain('\"nonesuch\"');\n174\t\n175\t    // Thread unchanged after all rejections: no view row landed, no record\n176\t    // or boundary movement (read-back equality).\n177\t    expect(fullStateSnapshot(fixture.filePath)).toBe(before);\n178\t    expect(viewRowCount(fixture.filePath)).toBe(0);\n179\t  });\n180\t\n181\t  it(\"compacts with a built-in profile: the profile's bound and mix land in the receipt\", async () => {\n182\t    const receipt = await fixture.sdk.threadView.compact(\n183\t      { filePath: fixture.filePath },\n184\t      { profile: \"coding\" },\n185\t    );\n186\t    expect(receipt.ok).toBe(true);\n187\t    if (!receipt.ok) return;\n188\t    expect(receipt.value.profile).toBe(\"coding\");\n189\t    expect(receipt.value.config).toEqual({\n190\t      full: 25,\n191\t      smooth: 35,\n192\t      detailed: 20,\n193\t      brief: 20,\n194\t      lowerBound: 120000,\n195\t    });\n196\t    // Sweep step is absent this story (the honest literal, not a fake empty\n197\t    // receipt — Story 3 flips it).\n198\t    expect(receipt.value.sweep).toBe(\"absent\");\n199\t    // At a 120k bound this small thread is all tail: bands empty, compact\n200\t    // point at the origin, and the reported total IS the tail (totalTokens\n201\t    // receipt coverage, ruling 013).\n202\t    expect(receipt.value.compactPoint).toBe(0);\n203\t    expect(receipt.value.bands.smooth.entries).toBe(0);\n204\t    expect(receipt.value.totalTokens).toBe(receipt.value.tailTokens);\n205\t  });\n206\t\n207\t  it(\"explicit params override profile values field-wise and report profile null\", async () => {\n208\t    const receipt = await fixture.sdk.threadView.compact(\n209\t      { filePath: fixture.filePath },\n210\t      { profile: \"coding\", params: { lowerBound: 400, percentages: { smooth: 40, detailed: 15 } } },\n211\t    );\n212\t    expect(receipt.ok).toBe(true);\n213\t    if (!receipt.ok) return;\n214\t    // coding's mix with the two overridden fields; explicit params ⇒ the\n215\t    // receipt names no profile (config carries the resolved truth).\n216\t    expect(receipt.value.config).toEqual({\n217\t      full: 25,\n218\t      smooth: 40,\n219\t      detailed: 15,\n220\t      brief: 20,\n221\t      lowerBound: 400,\n222\t    });\n223\t    expect(receipt.value.profile).toBeNull();\n224\t  });\n225\t});\n226\t\n227\tdescribe(\"TC-2.2 (AC-2.4, AC-2.9): the compact targets the bound from stored artifacts only\", () => {\n228\t  it(\"actuals near shares with whole-entry deviations, zero provider calls, record untouched\", async () => {\n229\t    const captured = fixture.double.captureInputs();\n230\t    const capturedBefore = captured.length;\n231\t    const recordBefore = recordSnapshot(fixture.filePath);\n232\t\n233\t    const receipt = await fixture.sdk.threadView.compact(\n234\t      { filePath: fixture.filePath },\n235\t      { params: TARGET_PARAMS },\n236\t    );\n237\t    expect(receipt.ok).toBe(true);\n238\t    if (!receipt.ok) return;\n239\t    const shares = {\n240\t      smooth: (400 * 25) / 100,\n241\t      detailed: (400 * 25) / 100,\n242\t      brief: (400 * 25) / 100,\n243\t    };\n244\t\n245\t    // Whole-entry fills: a band lands at-or-under its share unless a single\n246\t    // indivisible entry had to represent (the only sanctioned over-share\n247\t    // deviation, AC-2.4).\n248\t    for (const band of [\"brief\", \"detailed\", \"smooth\"] as const) {\n249\t      const actual = receipt.value.bands[band];\n250\t      const attributable = actual.tokens <= shares[band] || actual.entries === 1;\n251\t      expect(attributable).toBe(true);\n252\t    }\n253\t    // The fixture's pinned arrangement under these params (literal rules):\n254\t    // smooth fills t6–t8 within its share, c1 fills detailed within its\n255\t    // share, brief is empty by candidacy, tail under the full share plus\n256\t    // turn-boundary snap.\n257\t    expect(receipt.value.bands.brief).toEqual({ entries: 0, tokens: 0 });\n258\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n259\t    expect(receipt.value.bands.detailed.tokens).toBeLessThanOrEqual(shares.detailed);\n260\t    expect(receipt.value.bands.smooth.entries).toBe(3);\n261\t    expect(receipt.value.bands.smooth.tokens).toBeLessThanOrEqual(shares.smooth);\n262\t    expect(receipt.value.tailTokens).toBeLessThanOrEqual((400 * 25) / 100);\n263\t    expect(receipt.value.compactPoint).toBe(48);\n264\t\n265\t    // The explicit total (ruling 013): the assembled view's actual size —\n266\t    // band tokens plus tail — reported beside the per-band actuals. Here it\n267\t    // lands UNDER the bound (insufficient stored material at this scale),\n268\t    // the bound being a target, not a cap.\n269\t    expect(receipt.value.totalTokens).toBe(\n270\t      receipt.value.bands.brief.tokens +\n271\t        receipt.value.bands.detailed.tokens +\n272\t        receipt.value.bands.smooth.tokens +\n273\t        receipt.value.tailTokens,\n274\t    );\n275\t    expect(receipt.value.totalTokens).toBeGreaterThan(0);\n276\t    expect(receipt.value.totalTokens).toBeLessThanOrEqual(400);\n277\t\n278\t    // No provider call anywhere in the compact path; the record (events,\n279\t    // messages, turns, chunks, forms) is byte-identical after.\n280\t    expect(captured.length).toBe(capturedBefore);\n281\t    expect(recordSnapshot(fixture.filePath)).toBe(recordBefore);\n282\t  });\n283\t});\n284\t\n285\tdescribe(\"TC-2.6 (AC-2.10): band entries carry their subject keys visibly\", () => {\n286\t  it(\"chunk keys in brief/detailed text, turn keys in smooth text\", async () => {\n287\t    const receipt = await fixture.sdk.threadView.compact(\n288\t      { filePath: fixture.filePath },\n289\t      { params: GRADIENT_PARAMS },\n290\t    );\n291\t    expect(receipt.ok).toBe(true);\n292\t\n293\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n294\t    const bands = bandMessages(messages);\n295\t    const byBand = new Map(bands.map((message) => [message.band, message.content]));\n296\t    expect(byBand.get(\"brief\")).toMatch(/§c\\d+/);\n297\t    expect(byBand.get(\"detailed\")).toMatch(/§c\\d+/);\n298\t    expect(byBand.get(\"smooth\")).toMatch(/§t\\d+/);\n299\t    expect(byBand.get(\"smooth\")).not.toMatch(/§c\\d+/);\n300\t  });\n301\t});\n302\t\n303\tdescribe(\"architecture-risk: coverage edge accounting\", () => {\n304\t  it(\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\", async () => {\n305\t    const receipt = await fixture.sdk.threadView.compact(\n306\t      { filePath: fixture.filePath },\n307\t      { params: EDGE_PARAMS },\n308\t    );\n309\t    expect(receipt.ok).toBe(true);\n310\t    if (!receipt.ok) return;\n311\t\n312\t    // The compact point lands at t10's close, so c3, c2, and c1 are all\n313\t    // chunk candidates; c3 takes detailed (loner), the brief share holds c2\n314\t    // alone, and c1 remains AFTER the budget: outside the view. covered_from\n315\t    // lands at c2's start — t4's prompt, event 13 — and the exclusion is\n316\t    // visible as coveredFrom > first event.\n317\t    expect(receipt.value.compactPoint).toBe(56);\n318\t    expect(receipt.value.coveredFrom).toBe(13);\n319\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n320\t    expect(receipt.value.bands.brief.entries).toBe(1);\n321\t    // No silent omission AND no phantom gap entries for the out-of-window\n322\t    // chunk: gaps report unusable material, not the window's edge.\n323\t    expect(receipt.value.gaps).toEqual([]);\n324\t\n325\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n326\t    const bandText = bandMessages(messages)\n327\t      .map((message) => message.content)\n328\t      .join(\"\\n\");\n329\t    expect(bandText).not.toContain(\"§c1\");\n330\t    expect(bandText).toContain(\"§c2\");\n331\t    expect(bandText).toContain(\"§c3\");\n332\t  });\n333\t});\n334\t\n335\tdescribe(\"architecture-risk: restart serves the snapshot (real-file durability)\", () => {\n336\t  it(\"a fresh SDK on the same file pulls byte-identical band content\", async () => {\n337\t    const receipt = await fixture.sdk.threadView.compact(\n338\t      { filePath: fixture.filePath },\n339\t      { params: GRADIENT_PARAMS },\n340\t    );\n341\t    expect(receipt.ok).toBe(true);\n342\t    const before = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n343\t    expect(before.ok).toBe(true);\n344\t    if (!before.ok) return;\n345\t\n346\t    // Not a same-process reread: a fresh SDK instance opens the file cold.\n347\t    const fresh = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n348\t    const after = await fresh.threadView.pull({ filePath: fixture.filePath });\n349\t    expect(after.ok).toBe(true);\n350\t    if (!after.ok) return;\n351\t    expect(JSON.stringify(after.value)).toBe(JSON.stringify(before.value));\n352\t  });\n353\t});\n354\t\n355\tdescribe(\"TC-2.4 (AC-2.6): crash injection at the compact-write point\", () => {\n356\t  it(\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\", async () => {\n357\t    const first = await fixture.sdk.threadView.compact(\n358\t      { filePath: fixture.filePath },\n359\t      { params: GRADIENT_PARAMS },\n360\t    );\n361\t    expect(first.ok).toBe(true);\n362\t    const priorPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n363\t    expect(priorPull.ok).toBe(true);\n364\t    if (!priorPull.ok) return;\n365\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\n366\t\n367\t    setViewInjectionHook(\"compact-write\", () => {\n368\t      throw new Error(\"injected crash between sweep and view write\");\n369\t    });\n370\t    try {\n371\t      const crashed = await fixture.sdk.threadView.compact(\n372\t        { filePath: fixture.filePath },\n373\t        { params: EDGE_PARAMS },\n374\t      );\n375\t      expect(crashed.ok).toBe(false);\n376\t      if (crashed.ok) return;\n377\t      expect(crashed.error.errorClass).toBe(\"system_error\");\n378\t      expect(crashed.error.reason).toContain(\"injected crash\");\n379\t    } finally {\n380\t      setViewInjectionHook(\"compact-write\", null);\n381\t    }\n382\t\n383\t    // The previous view still serves, byte-identical; no partial rows, no\n384\t    // boundary movement.\n385\t    const afterCrash = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n386\t    expect(afterCrash.ok).toBe(true);\n387\t    if (!afterCrash.ok) return;\n388\t    expect(JSON.stringify(afterCrash.value)).toBe(JSON.stringify(priorPull.value));\n389\t    expect(viewRowCount(fixture.filePath)).toBe(1);\n390\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\n391\t\n392\t    // Rerun: the new view lands whole and the boundary resets to ITS compact\n393\t    // point (56) in the same transaction.\n394\t    const rerun = await fixture.sdk.threadView.compact(\n395\t      { filePath: fixture.filePath },\n396\t      { params: EDGE_PARAMS },\n397\t    );\n398\t    expect(rerun.ok).toBe(true);\n399\t    if (!rerun.ok) return;\n400\t    expect(rerun.value.coveredFrom).toBe(13);\n401\t    expect(viewRowCount(fixture.filePath)).toBe(1);\n402\t    expect(boundaryPosition(fixture.filePath)).toBe(56);\n403\t    const rerunPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n404\t    expect(rerunPull.ok).toBe(true);\n405\t    if (!rerunPull.ok) return;\n406\t    expect(JSON.stringify(rerunPull.value)).not.toBe(JSON.stringify(priorPull.value));\n407\t  });\n408\t});\n409\t\n410\t// ── degraded thread (TC-2.3 + the TC-2.5 view-health completion legs) ──\n411\t\n412\t// The fixture conversation rebuilt with manufactured derived damage, all\n413\t// through production paths: c1's brief summary exhausts through scripted\n414\t// retryable provider failures at build; post-build edits clear t8's turn\n415\t// forms and all of c2's dependent chain to pending (the Epic 02 cascade) —\n416\t// a pending turn rendering for the smooth band, and a chunk with no usable\n417\t// form at all (summaries pending, zero ready member projections) for the\n418\t// gap rung.\n419\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n420\tconst C1_BRIEF_EXHAUST_REASON = \"rate_limit: scripted c1 brief exhaustion (test)\";\n421\t\n422\tfunction degradedTurnEvents(turn: number): MessageEventInput[] {\n423\t  const events: MessageEventInput[] = [\n424\t    validEvent(\"user_prompt\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\n425\t    validEvent(\"assistant_thinking\", { payload: { text: `considering what area ${turn} contains` } }),\n426\t  ];\n427\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n428\t    for (const run of [1, 2]) {\n429\t      const toolCallId = `call-dg-${turn}-${run}`;\n430\t      events.push(\n431\t        validEvent(\"tool_call\", {\n432\t          payload: { toolCallId, toolName: \"read_file\", arguments: { path: `area-${turn}/file-${run}.txt` } },\n433\t        }),\n434\t        validEvent(\"tool_result\", {\n435\t          payload: {\n436\t            toolCallId,\n437\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n438\t            isError: false,\n439\t          },\n440\t        }),\n441\t      );\n442\t    }\n443\t  }\n444\t  events.push("}]},"parent_tool_use_id":null,"session_id":"f006cddb-2184-479e-939b-55dccd3023e3","uuid":"79898b26-7963-44ac-bac8-78fdec14f890","timestamp":"2026-06-11T16:41:05.391Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-compact.test.ts","content":"  try {\n    return sha256({\n      record: recordSnapshot(filePath),\n      views: db.prepare(`SELECT * FROM thread_view`).all(),\n      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\n      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\n    });\n  } finally {\n    db.close();\n  }\n}\n\nfunction viewRowCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\n      n: number | bigint;\n    };\n    return Number(row.n);\n  } finally {\n    db.close();\n  }\n}\n\nfunction boundaryPosition(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    const row = db.prepare(`SELECT position FROM view_boundary`).get() as {\n      position: number | bigint;\n    };\n    return Number(row.position);\n  } finally {\n    db.close();\n  }\n}\n\nfunction bandMessages(messages: readonly ViewMessage[]): ViewMessage[] {\n  return messages.filter((message) => message.band !== undefined);\n}\n\nasync function pullMessages(sdk: Lhc, filePath: string): Promise<ViewMessage[]> {\n  const pulled = await sdk.threadView.pull({ filePath });\n  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n  return pulled.value.messages;\n}\n\ndescribe(\"TC-2.1 (AC-2.2, AC-2.3, AC-2.7): profiles, explicit params, and named rejections\", () => {\n  it(\"rejects percentages summing to 105 naming the sum, and an unknown profile naming it; thread unchanged\", async () => {\n    const before = fullStateSnapshot(fixture.filePath);\n\n    const badSum = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: { percentages: { full: 30, smooth: 30, detailed: 25, brief: 20 } } },\n    );\n    expect(badSum.ok).toBe(false);\n    if (badSum.ok) return;\n    expect(badSum.error.errorClass).toBe(\"caller_error\");\n    expect(badSum.error.code).toBe(\"invalid_view_config\");\n    expect(badSum.error.reason).toContain(\"105\");\n\n    const badBound = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: { lowerBound: 0 } },\n    );\n    expect(badBound.ok).toBe(false);\n    if (badBound.ok) return;\n    expect(badBound.error.code).toBe(\"invalid_view_config\");\n    expect(badBound.error.reason).toContain(\"lowerBound\");\n\n    const unknown = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { profile: \"nonesuch\" },\n    );\n    expect(unknown.ok).toBe(false);\n    if (unknown.ok) return;\n    expect(unknown.error.errorClass).toBe(\"caller_error\");\n    expect(unknown.error.code).toBe(\"unknown_profile\");\n    expect(unknown.error.reason).toContain('\"nonesuch\"');\n\n    // Thread unchanged after all rejections: no view row landed, no record\n    // or boundary movement (read-back equality).\n    expect(fullStateSnapshot(fixture.filePath)).toBe(before);\n    expect(viewRowCount(fixture.filePath)).toBe(0);\n  });\n\n  it(\"compacts with a built-in profile: the profile's bound and mix land in the receipt\", async () => {\n    const receipt = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { profile: \"coding\" },\n    );\n    expect(receipt.ok).toBe(true);\n    if (!receipt.ok) return;\n    expect(receipt.value.profile).toBe(\"coding\");\n    expect(receipt.value.config).toEqual({\n      full: 25,\n      smooth: 35,\n      detailed: 20,\n      brief: 20,\n      lowerBound: 120000,\n    });\n    // Sweep step is absent this story (the honest literal, not a fake empty\n    // receipt — Story 3 flips it).\n    expect(receipt.value.sweep).toBe(\"absent\");\n    // At a 120k bound this small thread is all tail: bands empty, compact\n    // point at the origin, and the reported total IS the tail (totalTokens\n    // receipt coverage, ruling 013).\n    expect(receipt.value.compactPoint).toBe(0);\n    expect(receipt.value.bands.smooth.entries).toBe(0);\n    expect(receipt.value.totalTokens).toBe(receipt.value.tailTokens);\n  });\n\n  it(\"explicit params override profile values field-wise and report profile null\", async () => {\n    const receipt = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { profile: \"coding\", params: { lowerBound: 400, percentages: { smooth: 40, detailed: 15 } } },\n    );\n    expect(receipt.ok).toBe(true);\n    if (!receipt.ok) return;\n    // coding's mix with the two overridden fields; explicit params ⇒ the\n    // receipt names no profile (config carries the resolved truth).\n    expect(receipt.value.config).toEqual({\n      full: 25,\n      smooth: 40,\n      detailed: 15,\n      brief: 20,\n      lowerBound: 400,\n    });\n    expect(receipt.value.profile).toBeNull();\n  });\n});\n\ndescribe(\"TC-2.2 (AC-2.4, AC-2.9): the compact targets the bound from stored artifacts only\", () => {\n  it(\"actuals near shares with whole-entry deviations, zero provider calls, record untouched\", async () => {\n    const captured = fixture.double.captureInputs();\n    const capturedBefore = captured.length;\n    const recordBefore = recordSnapshot(fixture.filePath);\n\n    const receipt = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: TARGET_PARAMS },\n    );\n    expect(receipt.ok).toBe(true);\n    if (!receipt.ok) return;\n    const shares = {\n      smooth: (400 * 25) / 100,\n      detailed: (400 * 25) / 100,\n      brief: (400 * 25) / 100,\n    };\n\n    // Whole-entry fills: a band lands at-or-under its share unless a single\n    // indivisible entry had to represent (the only sanctioned over-share\n    // deviation, AC-2.4).\n    for (const band of [\"brief\", \"detailed\", \"smooth\"] as const) {\n      const actual = receipt.value.bands[band];\n      const attributable = actual.tokens <= shares[band] || actual.entries === 1;\n      expect(attributable).toBe(true);\n    }\n    // The fixture's pinned arrangement under these params (literal rules):\n    // smooth fills t6–t8 within its share, c1 fills detailed within its\n    // share, brief is empty by candidacy, tail under the full share plus\n    // turn-boundary snap.\n    expect(receipt.value.bands.brief).toEqual({ entries: 0, tokens: 0 });\n    expect(receipt.value.bands.detailed.entries).toBe(1);\n    expect(receipt.value.bands.detailed.tokens).toBeLessThanOrEqual(shares.detailed);\n    expect(receipt.value.bands.smooth.entries).toBe(3);\n    expect(receipt.value.bands.smooth.tokens).toBeLessThanOrEqual(shares.smooth);\n    expect(receipt.value.tailTokens).toBeLessThanOrEqual((400 * 25) / 100);\n    expect(receipt.value.compactPoint).toBe(48);\n\n    // The explicit total (ruling 013): the assembled view's actual size —\n    // band tokens plus tail — reported beside the per-band actuals. Here it\n    // lands UNDER the bound (insufficient stored material at this scale),\n    // the bound being a target, not a cap.\n    expect(receipt.value.totalTokens).toBe(\n      receipt.value.bands.brief.tokens +\n        receipt.value.bands.detailed.tokens +\n        receipt.value.bands.smooth.tokens +\n        receipt.value.tailTokens,\n    );\n    expect(receipt.value.totalTokens).toBeGreaterThan(0);\n    expect(receipt.value.totalTokens).toBeLessThanOrEqual(400);\n\n    // No provider call anywhere in the compact path; the record (events,\n    // messages, turns, chunks, forms) is byte-identical after.\n    expect(captured.length).toBe(capturedBefore);\n    expect(recordSnapshot(fixture.filePath)).toBe(recordBefore);\n  });\n});\n\ndescribe(\"TC-2.6 (AC-2.10): band entries carry their subject keys visibly\", () => {\n  it(\"chunk keys in brief/detailed text, turn keys in smooth text\", async () => {\n    const receipt = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: GRADIENT_PARAMS },\n    );\n    expect(receipt.ok).toBe(true);\n\n    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n    const bands = bandMessages(messages);\n    const byBand = new Map(bands.map((message) => [message.band, message.content]));\n    expect(byBand.get(\"brief\")).toMatch(/§c\\d+/);\n    expect(byBand.get(\"detailed\")).toMatch(/§c\\d+/);\n    expect(byBand.get(\"smooth\")).toMatch(/§t\\d+/);\n    expect(byBand.get(\"smooth\")).not.toMatch(/§c\\d+/);\n  });\n});\n\ndescribe(\"architecture-risk: coverage edge accounting\", () => {\n  it(\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\", async () => {\n    const receipt = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: EDGE_PARAMS },\n    );\n    expect(receipt.ok).toBe(true);\n    if (!receipt.ok) return;\n\n    // The compact point lands at t10's close, so c3, c2, and c1 are all\n    // chunk candidates; c3 takes detailed (loner), the brief share holds c2\n    // alone, and c1 remains AFTER the budget: outside the view. covered_from\n    // lands at c2's start — t4's prompt, event 13 — and the exclusion is\n    // visible as coveredFrom > first event.\n    expect(receipt.value.compactPoint).toBe(56);\n    expect(receipt.value.coveredFrom).toBe(13);\n    expect(receipt.value.bands.detailed.entries).toBe(1);\n    expect(receipt.value.bands.brief.entries).toBe(1);\n    // No silent omission AND no phantom gap entries for the out-of-window\n    // chunk: gaps report unusable material, not the window's edge.\n    expect(receipt.value.gaps).toEqual([]);\n\n    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n    const bandText = bandMessages(messages)\n      .map((message) => message.content)\n      .join(\"\\n\");\n    expect(bandText).not.toContain(\"§c1\");\n    expect(bandText).toContain(\"§c2\");\n    expect(bandText).toContain(\"§c3\");\n  });\n});\n\ndescribe(\"architecture-risk: restart serves the snapshot (real-file durability)\", () => {\n  it(\"a fresh SDK on the same file pulls byte-identical band content\", async () => {\n    const receipt = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: GRADIENT_PARAMS },\n    );\n    expect(receipt.ok).toBe(true);\n    const before = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    expect(before.ok).toBe(true);\n    if (!before.ok) return;\n\n    // Not a same-process reread: a fresh SDK instance opens the file cold.\n    const fresh = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n    const after = await fresh.threadView.pull({ filePath: fixture.filePath });\n    expect(after.ok).toBe(true);\n    if (!after.ok) return;\n    expect(JSON.stringify(after.value)).toBe(JSON.stringify(before.value));\n  });\n});\n\ndescribe(\"TC-2.4 (AC-2.6): crash injection at the compact-write point\", () => {\n  it(\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\", async () => {\n    const first = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: GRADIENT_PARAMS },\n    );\n    expect(first.ok).toBe(true);\n    const priorPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    expect(priorPull.ok).toBe(true);\n    if (!priorPull.ok) return;\n    expect(boundaryPosition(fixture.filePath)).toBe(48);\n\n    setViewInjectionHook(\"compact-write\", () => {\n      throw new Error(\"injected crash between sweep and view write\");\n    });\n    try {\n      const crashed = await fixture.sdk.threadView.compact(\n        { filePath: fixture.filePath },\n        { params: EDGE_PARAMS },\n      );\n      expect(crashed.ok).toBe(false);\n      if (crashed.ok) return;\n      expect(crashed.error.errorClass).toBe(\"system_error\");\n      expect(crashed.error.reason).toContain(\"injected crash\");\n    } finally {\n      setViewInjectionHook(\"compact-write\", null);\n    }\n\n    // The previous view still serves, byte-identical; no partial rows, no\n    // boundary movement.\n    const afterCrash = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    expect(afterCrash.ok).toBe(true);\n    if (!afterCrash.ok) return;\n    expect(JSON.stringify(afterCrash.value)).toBe(JSON.stringify(priorPull.value));\n    expect(viewRowCount(fixture.filePath)).toBe(1);\n    expect(boundaryPosition(fixture.filePath)).toBe(48);\n\n    // Rerun: the new view lands whole and the boundary resets to ITS compact\n    // point (56) in the same transaction.\n    const rerun = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: EDGE_PARAMS },\n    );\n    expect(rerun.ok).toBe(true);\n    if (!rerun.ok) return;\n    expect(rerun.value.coveredFrom).toBe(13);\n    expect(viewRowCount(fixture.filePath)).toBe(1);\n    expect(boundaryPosition(fixture.filePath)).toBe(56);\n    const rerunPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    expect(rerunPull.ok).toBe(true);\n    if (!rerunPull.ok) return;\n    expect(JSON.stringify(rerunPull.value)).not.toBe(JSON.stringify(priorPull.value));\n  });\n});\n\n// ── degraded thread (TC-2.3 + the TC-2.5 view-health completion legs) ──\n\n// The fixture conversation rebuilt with manufactured derived damage, all\n// through production paths: c1's brief summary exhausts through scripted\n// retryable provider failures at build; post-build edits clear t8's turn\n// forms and all of c2's dependent chain to pending (the Epic 02 cascade) —\n// a pending turn rendering for the smooth band, and a chunk with no usable\n// form at all (summaries pending, zero ready member projections) for the\n// gap rung.\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\nconst C1_BRIEF_EXHAUST_REASON = \"rate_limit: scripted c1 brief exhaustion (test)\";\n\nfunction degradedTurnEvents(turn: number): MessageEventInput[] {\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\n    validEvent(\"assistant_thinking\", { payload: { text: `considering what area ${turn} contains` } }),\n  ];\n  if (TOOL_HEAVY_TURNS.has(turn)) {\n    for (const run of [1, 2]) {\n      const toolCallId = `call-dg-${turn}-${run}`;\n      events.push(\n        validEvent(\"tool_call\", {\n          payload: { toolCallId, toolName: \"read_file\", arguments: { path: `area-${turn}/file-${run}.txt` } },\n        }),\n        validEvent(\"tool_result\", {\n          payload: {\n            toolCallId,\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n            isError: false,\n          },\n        }),\n      );\n    }\n  }\n  events.push(","numLines":350,"startLine":95,"totalLines":778}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XJmoMzDWWuLwjEFstBByhx","type":"tool_result","content":"1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n5\t// clock in the signature: determinism is structural, not disciplined.\n6\t//\n7\t// Tool activity stays in message order and groups into runs (AC-3.4, Fix 2):\n8\t// a maximal stretch of consecutive tool_call/tool_result messages folds into\n9\t// ONE RenderingPart and ONE receipt — a run-level account naming the tools,\n10\t// the call count, and the per-call mechanical outcomes, so a run containing a\n11\t// state-changing call structurally cannot lose its outcome and mixed outcomes\n12\t// stay explicit, never collapsed into a vague success. Prompts and assistant\n13\t// text break a run; thinking and runtime notes do not (interior ones ride the\n14\t// run account inline, edge ones stand alone) — a story-deviation decision.\n15\t// Runs are never reordered to make accounts tidier; the outcome rides the\n16\t// part, not the prose.\n17\timport type {\n18\t  DependencyGap,\n19\t  DerivedFormMetadata,\n20\t  DerivedFormState,\n21\t  FormKind,\n22\t  RenderingPart,\n23\t  RenderingPartKind,\n24\t  ToolOutcome,\n25\t  ToolRunReceipt,\n26\t} from \"../../../shared/derivation.js\";\n27\t\n28\t// The member message as the composer sees it: kind plus projected blocks,\n29\t// verbatim from the record (already deleted-filtered by the caller's read).\n30\texport interface ComposeMessage {\n31\t  messageId: string;\n32\t  kind: RenderingPartKind;\n33\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n34\t}\n35\t\n36\t// One message-owned form row as composition input; keyed by the caller as\n37\t// `${messageId}/${form}`.\n38\texport interface ComposeFormRow {\n39\t  state: DerivedFormState;\n40\t  content?: string;\n41\t  metadata?: DerivedFormMetadata;\n42\t}\n43\t\n44\texport function composeFormKey(messageId: string, form: FormKind): string {\n45\t  return `${messageId}/${form}`;\n46\t}\n47\t\n48\texport interface CompositionInput {\n49\t  parts: RenderingPart[];\n50\t  gaps: DependencyGap[];\n51\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n52\t  // account + outcome, in message order — pure restatement of the\n53\t  // composition input, stamped on the rendering so chunk summaries read\n54\t  // receipts without re-deriving anything.\n55\t  receipts: ToolRunReceipt[];\n56\t}\n57\t\n58\t// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n59\t// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n60\t// function of the input string alone.\n61\texport const FALLBACK_TRUNCATION_LIMIT = 200;\n62\t\n63\texport function truncateForFallback(text: string): string {\n64\t  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n65\t  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n66\t  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n67\t}\n68\t\n69\tfunction textOf(message: ComposeMessage): string {\n70\t  const text = message.blocks[0]?.content[\"text\"];\n71\t  return typeof text === \"string\" ? text : \"\";\n72\t}\n73\t\n74\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n75\t// composition): a tool call's outcome comes from its paired result among the\n76\t// turn's messages — present and clean, present and isError, or absent.\n77\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n78\t  const byCallId = new Map<string, boolean>();\n79\t  for (const message of messages) {\n80\t    if (message.kind !== \"tool_result\") continue;\n81\t    const block = message.blocks[0]?.content ?? {};\n82\t    const callId = block[\"toolCallId\"];\n83\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n84\t  }\n85\t  return byCallId;\n86\t}\n87\t\n88\tfunction outcomeFromRecord(\n89\t  resultByCallId: Map<string, boolean>,\n90\t  callId: unknown,\n91\t): ToolOutcome {\n92\t  if (typeof callId !== \"string\") return \"unknown\";\n93\t  const isError = resultByCallId.get(callId);\n94\t  if (isError === undefined) return \"unknown\";\n95\t  return isError ? \"failed\" : \"succeeded\";\n96\t}\n97\t\n98\tinterface PartPlan {\n99\t  form?: FormKind; // the message-level form this kind composes from, if any\n100\t  fallbackText: (message: ComposeMessage) => string;\n101\t}\n102\t\n103\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n104\t// call/result → deterministic truncation; text/thinking/note → raw, no form\n105\t// to fall back from and therefore never a gap.\n106\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n107\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n108\t  assistant_text: { fallbackText: textOf },\n109\t  assistant_thinking: { fallbackText: textOf },\n110\t  runtime_note: { fallbackText: textOf },\n111\t  tool_call: {\n112\t    form: \"tool_call_summary\",\n113\t    fallbackText: (message) => {\n114\t      const block = message.blocks[0]?.content ?? {};\n115\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n116\t      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n117\t    },\n118\t  },\n119\t  tool_result: {\n120\t    form: \"tool_result_summary\",\n121\t    fallbackText: (message) => {\n122\t      const block = message.blocks[0]?.content ?? {};\n123\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n124\t    },\n125\t  },\n126\t};\n127\t\n128\t// One per-message atom before grouping: its composed part plus the structural\n129\t// facts the run-grouping reads. Tool atoms fold into runs; prompts and\n130\t// assistant text break runs; thinking and runtime notes are transparent —\n131\t// interior ones fold into the surrounding run's account, edge ones stand alone.\n132\tinterface ComposeAtom {\n133\t  part: RenderingPart;\n134\t  isTool: boolean;\n135\t  isBreak: boolean; // user_prompt | assistant_text — ends a run\n136\t  toolName?: string; // tool_call only\n137\t  toolCallId?: string; // tool_call | tool_result\n138\t}\n139\t\n140\tconst RUN_BREAK_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"user_prompt\", \"assistant_text\"]);\n141\tconst TOOL_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"tool_call\", \"tool_result\"]);\n142\t\n143\t// One message → its composed part (ready form verbatim, else raw/truncated\n144\t// fallback) plus a gap when a derivable form was not ready. Gaps stay\n145\t// per-message — precise to the source record — regardless of run grouping\n146\t// (AC-3.2/3.3): the caller lands them on the rendering and they hold until an\n147\t// explicit rebuild recomposes from current states.\n148\tfunction buildAtom(\n149\t  message: ComposeMessage,\n150\t  forms: ReadonlyMap<string, ComposeFormRow>,\n151\t  resultByCallId: Map<string, boolean>,\n152\t): { atom: ComposeAtom; gap?: DependencyGap } {\n153\t  const plan = PART_PLANS[message.kind];\n154\t  const form =\n155\t    plan.form === undefined\n156\t      ? undefined\n157\t      : forms.get(composeFormKey(message.messageId, plan.form));\n158\t  const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n159\t  const block = message.blocks[0]?.content ?? {};\n160\t  const part: RenderingPart = {\n161\t    messageId: message.messageId,\n162\t    kind: message.kind,\n163\t    text: ready ? (form.content as string) : plan.fallbackText(message),\n164\t    fallback: plan.form !== undefined && !ready,\n165\t  };\n166\t  if (message.kind === \"tool_call\") {\n167\t    part.outcome =\n168\t      ready && form.metadata?.outcome !== undefined\n169\t        ? form.metadata.outcome\n170\t        : outcomeFromRecord(resultByCallId, block[\"toolCallId\"]);\n171\t  } else if (message.kind === \"tool_result\") {\n172\t    part.outcome =\n173\t      ready && form.metadata?.outcome !== undefined\n174\t        ? form.metadata.outcome\n175\t        : block[\"isError\"] === true\n176\t          ? \"failed\"\n177\t          : \"succeeded\";\n178\t  }\n179\t  const atom: ComposeAtom = {\n180\t    part,\n181\t    isTool: TOOL_KINDS.has(message.kind),\n182\t    isBreak: RUN_BREAK_KINDS.has(message.kind),\n183\t  };\n184\t  if (message.kind === \"tool_call\" && typeof block[\"toolName\"] === \"string\") {\n185\t    atom.toolName = block[\"toolName\"];\n186\t  }\n187\t  if (atom.isTool && typeof block[\"toolCallId\"] === \"string\") {\n188\t    atom.toolCallId = block[\"toolCallId\"];\n189\t  }\n190\t  const gap: DependencyGap | undefined =\n191\t    part.fallback && plan.form !== undefined\n192\t      ? { subjectKind: \"message\", subjectId: message.messageId, form: plan.form }\n193\t      : undefined;\n194\t  return gap === undefined ? { atom } : { atom, gap };\n195\t}\n196\t\n197\tconst RUN_OUTCOME_ORDER: readonly ToolOutcome[] = [\"succeeded\", \"failed\", \"unknown\"];\n198\t\n199\t// The run's per-invocation outcome tally: each call counted once, plus any\n200\t// result whose paired call sits outside this run (a cross-turn pair). Mixed\n201\t// outcomes stay explicit; the run-level outcome is failed if any failed, else\n202\t// unknown if any unknown, else succeeded.\n203\tfunction tallyRun(members: readonly ComposeAtom[]): {\n204\t  counts: Record<ToolOutcome, number>;\n205\t  outcome: ToolOutcome;\n206\t  callCount: number;\n207\t  toolNames: string[];\n208\t} {\n209\t  const calls = members.filter((m) => m.part.kind === \"tool_call\");\n210\t  const callIds = new Set(\n211\t    calls.map((m) => m.toolCallId).filter((id): id is string => id !== undefined),\n212\t  );\n213\t  const orphanResults = members.filter(\n214\t    (m) =>\n215\t      m.part.kind === \"tool_result\" &&\n216\t      (m.toolCallId === undefined || !callIds.has(m.toolCallId)),\n217\t  );\n218\t  const counts: Record<ToolOutcome, number> = { succeeded: 0, failed: 0, unknown: 0 };\n219\t  for (const m of [...calls, ...orphanResults]) counts[m.part.outcome ?? \"unknown\"] += 1;\n220\t  const outcome: ToolOutcome =\n221\t    counts.failed > 0 ? \"failed\" : counts.unknown > 0 ? \"unknown\" : \"succeeded\";\n222\t  const toolNames: string[] = [];\n223\t  for (const call of calls) {\n224\t    if (call.toolName !== undefined && !toolNames.includes(call.toolName)) {\n225\t      toolNames.push(call.toolName);\n226\t    }\n227\t  }\n228\t  return { counts, outcome, callCount: calls.length, toolNames };\n229\t}\n230\t\n231\tfunction runTallyText(counts: Record<ToolOutcome, number>): string {\n232\t  const segs = RUN_OUTCOME_ORDER.filter((o) => counts[o] > 0).map((o) => `${counts[o]} ${o}`);\n233\t  return segs.length > 0 ? segs.join(\", \") : \"no outcomes\";\n234\t}\n235\t\n236\t// One RenderingPart and one ToolRunReceipt for a maximal tool run (AC-3.4): a\n237\t// run-level header (tools, call count, outcome tally) over the members'\n238\t// composed accounts in record order — each tool member stating its own\n239\t// outcome so a state-changing call cannot lose it, interior thinking/notes\n240\t// riding inline. The receipt restates the same account + run outcome for the\n241\t// chunk summaries (AC-3.8).\n242\tfunction composeRun(members: readonly ComposeAtom[]): {\n243\t  part: RenderingPart;\n244\t  receipt: ToolRunReceipt;\n245\t} {\n246\t  const { counts, outcome, callCount, toolNames } = tallyRun(members);\n247\t  const tools = toolNames.length > 0 ? toolNames.join(\", \") : \"tools\";\n248\t  const header = `tool run · ${tools} · ${callCount} call${callCount === 1 ? \"\" : \"s\"} · ${runTallyText(counts)}`;\n249\t  const detail = members\n250\t    .map((m) => (m.isTool ? `${m.part.text} ⇒ ${m.part.outcome ?? \"unknown\"}` : m.part.text))\n251\t    .join(\"\\n\");\n252\t  const text = `[${header}]\\n${detail}`;\n253\t  const lead = members[0];\n254\t  if (lead === undefined) throw new Error(\"composeRun: a tool run has no members\");\n255\t  return {\n256\t    part: {\n257\t      messageId: lead.part.messageId,\n258\t      kind: lead.part.kind,\n259\t      text,\n260\t      fallback: members.some((m) => m.isTool && m.part.fallback),\n261\t      outcome,\n262\t    },\n263\t    receipt: {\n264\t      messageId: lead.part.messageId,\n265\t      activity: lead.part.kind === \"tool_result\" ? \"tool_result\" : \"tool_call\",\n266\t      account: text,\n267\t      outcome,\n268\t    },\n269\t  };\n270\t}\n271\t\n272\t// Compose the ordered RenderingParts and tool-run receipts. Per-message atoms\n273\t// build first (forms verbatim or fallbacks, per-message gaps); then maximal\n274\t// runs of consecutive tool activity fold into one run part + one receipt each\n275\t// (AC-3.4), with prompts/assistant text breaking runs and thinking/runtime\n276\t// notes transparent to them.\n277\texport function composeRenderingInput(\n278\t  messages: readonly ComposeMessage[],\n279\t  forms: ReadonlyMap<string, ComposeFormRow>,\n280\t): CompositionInput {\n281\t  const resultByCallId = recordOutcomes(messages);\n282\t  const atoms: ComposeAtom[] = [];\n283\t  const gaps: DependencyGap[] = [];\n284\t  for (const message of messages) {\n285\t    const built = buildAtom(message, forms, resultByCallId);\n286\t    atoms.push(built.atom);\n287\t    if (built.gap !== undefined) gaps.push(built.gap);\n288\t  }\n289\t\n290\t  const parts: RenderingPart[] = [];\n291\t  const receipts: ToolRunReceipt[] = [];\n292\t  let i = 0;\n293\t  while (i < atoms.length) {\n294\t    const atom = atoms[i];\n295\t    if (atom === undefined) break; // i < length keeps this unreachable\n296\t    if (!atom.isTool) {\n297\t      parts.push(atom.part); // prompt, assistant text, or an edge thinking/note\n298\t      i += 1;\n299\t      continue;\n300\t    }\n301\t    // A maximal run starting at this tool atom: extend over following tool\n302\t    // atoms and interior transparent atoms (thinking/notes), stopping at the\n303\t    // next break (prompt/assistant text) or the turn's end. Transparent atoms\n304\t    // trailing the last tool atom stand alone, not folded into the run.\n305\t    let j = i;\n306\t    let lastToolIdx = i;\n307\t    for (let next = atoms[j + 1]; next !== undefined && !next.isBreak; next = atoms[j + 1]) {\n308\t      j += 1;\n309\t      if (next.isTool) lastToolIdx = j;\n310\t    }\n311\t    const run = composeRun(atoms.slice(i, lastToolIdx + 1));\n312\t    parts.push(run.part);\n313\t    receipts.push(run.receipt);\n314\t    for (let k = lastToolIdx + 1; k <= j; k += 1) {\n315\t      const trailing = atoms[k];\n316\t      if (trailing !== undefined) parts.push(trailing.part);\n317\t    }\n318\t    i = j + 1;\n319\t  }\n320\t\n321\t  return { parts, gaps, receipts };\n322\t}\n323\t"}]},"parent_tool_use_id":null,"session_id":"28aec8fc-3297-4f03-8488-65ebfbadd697","uuid":"545bfb4a-9d0f-4a7d-bbd1-23458f9fc4ae","timestamp":"2026-06-11T14:39:47.823Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/compose.ts","content":"// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n// gap records where a form is not ready. Pure by anti-shim requirement —\n// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n// clock in the signature: determinism is structural, not disciplined.\n//\n// Tool activity stays in message order and groups into runs (AC-3.4, Fix 2):\n// a maximal stretch of consecutive tool_call/tool_result messages folds into\n// ONE RenderingPart and ONE receipt — a run-level account naming the tools,\n// the call count, and the per-call mechanical outcomes, so a run containing a\n// state-changing call structurally cannot lose its outcome and mixed outcomes\n// stay explicit, never collapsed into a vague success. Prompts and assistant\n// text break a run; thinking and runtime notes do not (interior ones ride the\n// run account inline, edge ones stand alone) — a story-deviation decision.\n// Runs are never reordered to make accounts tidier; the outcome rides the\n// part, not the prose.\nimport type {\n  DependencyGap,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  RenderingPart,\n  RenderingPartKind,\n  ToolOutcome,\n  ToolRunReceipt,\n} from \"../../../shared/derivation.js\";\n\n// The member message as the composer sees it: kind plus projected blocks,\n// verbatim from the record (already deleted-filtered by the caller's read).\nexport interface ComposeMessage {\n  messageId: string;\n  kind: RenderingPartKind;\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n}\n\n// One message-owned form row as composition input; keyed by the caller as\n// `${messageId}/${form}`.\nexport interface ComposeFormRow {\n  state: DerivedFormState;\n  content?: string;\n  metadata?: DerivedFormMetadata;\n}\n\nexport function composeFormKey(messageId: string, form: FormKind): string {\n  return `${messageId}/${form}`;\n}\n\nexport interface CompositionInput {\n  parts: RenderingPart[];\n  gaps: DependencyGap[];\n  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n  // account + outcome, in message order — pure restatement of the\n  // composition input, stamped on the rendering so chunk summaries read\n  // receipts without re-deriving anything.\n  receipts: ToolRunReceipt[];\n}\n\n// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n// function of the input string alone.\nexport const FALLBACK_TRUNCATION_LIMIT = 200;\n\nexport function truncateForFallback(text: string): string {\n  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n}\n\nfunction textOf(message: ComposeMessage): string {\n  const text = message.blocks[0]?.content[\"text\"];\n  return typeof text === \"string\" ? text : \"\";\n}\n\n// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n// composition): a tool call's outcome comes from its paired result among the\n// turn's messages — present and clean, present and isError, or absent.\nfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n  const byCallId = new Map<string, boolean>();\n  for (const message of messages) {\n    if (message.kind !== \"tool_result\") continue;\n    const block = message.blocks[0]?.content ?? {};\n    const callId = block[\"toolCallId\"];\n    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n  }\n  return byCallId;\n}\n\nfunction outcomeFromRecord(\n  resultByCallId: Map<string, boolean>,\n  callId: unknown,\n): ToolOutcome {\n  if (typeof callId !== \"string\") return \"unknown\";\n  const isError = resultByCallId.get(callId);\n  if (isError === undefined) return \"unknown\";\n  return isError ? \"failed\" : \"succeeded\";\n}\n\ninterface PartPlan {\n  form?: FormKind; // the message-level form this kind composes from, if any\n  fallbackText: (message: ComposeMessage) => string;\n}\n\n// The fallback rules table (story Technical Notes): prompt → raw text; tool\n// call/result → deterministic truncation; text/thinking/note → raw, no form\n// to fall back from and therefore never a gap.\nconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n  assistant_text: { fallbackText: textOf },\n  assistant_thinking: { fallbackText: textOf },\n  runtime_note: { fallbackText: textOf },\n  tool_call: {\n    form: \"tool_call_summary\",\n    fallbackText: (message) => {\n      const block = message.blocks[0]?.content ?? {};\n      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n    },\n  },\n  tool_result: {\n    form: \"tool_result_summary\",\n    fallbackText: (message) => {\n      const block = message.blocks[0]?.content ?? {};\n      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n    },\n  },\n};\n\n// One per-message atom before grouping: its composed part plus the structural\n// facts the run-grouping reads. Tool atoms fold into runs; prompts and\n// assistant text break runs; thinking and runtime notes are transparent —\n// interior ones fold into the surrounding run's account, edge ones stand alone.\ninterface ComposeAtom {\n  part: RenderingPart;\n  isTool: boolean;\n  isBreak: boolean; // user_prompt | assistant_text — ends a run\n  toolName?: string; // tool_call only\n  toolCallId?: string; // tool_call | tool_result\n}\n\nconst RUN_BREAK_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"user_prompt\", \"assistant_text\"]);\nconst TOOL_KINDS: ReadonlySet<RenderingPartKind> = new Set([\"tool_call\", \"tool_result\"]);\n\n// One message → its composed part (ready form verbatim, else raw/truncated\n// fallback) plus a gap when a derivable form was not ready. Gaps stay\n// per-message — precise to the source record — regardless of run grouping\n// (AC-3.2/3.3): the caller lands them on the rendering and they hold until an\n// explicit rebuild recomposes from current states.\nfunction buildAtom(\n  message: ComposeMessage,\n  forms: ReadonlyMap<string, ComposeFormRow>,\n  resultByCallId: Map<string, boolean>,\n): { atom: ComposeAtom; gap?: DependencyGap } {\n  const plan = PART_PLANS[message.kind];\n  const form =\n    plan.form === undefined\n      ? undefined\n      : forms.get(composeFormKey(message.messageId, plan.form));\n  const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n  const block = message.blocks[0]?.content ?? {};\n  const part: RenderingPart = {\n    messageId: message.messageId,\n    kind: message.kind,\n    text: ready ? (form.content as string) : plan.fallbackText(message),\n    fallback: plan.form !== undefined && !ready,\n  };\n  if (message.kind === \"tool_call\") {\n    part.outcome =\n      ready && form.metadata?.outcome !== undefined\n        ? form.metadata.outcome\n        : outcomeFromRecord(resultByCallId, block[\"toolCallId\"]);\n  } else if (message.kind === \"tool_result\") {\n    part.outcome =\n      ready && form.metadata?.outcome !== undefined\n        ? form.metadata.outcome\n        : block[\"isError\"] === true\n          ? \"failed\"\n          : \"succeeded\";\n  }\n  const atom: ComposeAtom = {\n    part,\n    isTool: TOOL_KINDS.has(message.kind),\n    isBreak: RUN_BREAK_KINDS.has(message.kind),\n  };\n  if (message.kind === \"tool_call\" && typeof block[\"toolName\"] === \"string\") {\n    atom.toolName = block[\"toolName\"];\n  }\n  if (atom.isTool && typeof block[\"toolCallId\"] === \"string\") {\n    atom.toolCallId = block[\"toolCallId\"];\n  }\n  const gap: DependencyGap | undefined =\n    part.fallback && plan.form !== undefined\n      ? { subjectKind: \"message\", subjectId: message.messageId, form: plan.form }\n      : undefined;\n  return gap === undefined ? { atom } : { atom, gap };\n}\n\nconst RUN_OUTCOME_ORDER: readonly ToolOutcome[] = [\"succeeded\", \"failed\", \"unknown\"];\n\n// The run's per-invocation outcome tally: each call counted once, plus any\n// result whose paired call sits outside this run (a cross-turn pair). Mixed\n// outcomes stay explicit; the run-level outcome is failed if any failed, else\n// unknown if any unknown, else succeeded.\nfunction tallyRun(members: readonly ComposeAtom[]): {\n  counts: Record<ToolOutcome, number>;\n  outcome: ToolOutcome;\n  callCount: number;\n  toolNames: string[];\n} {\n  const calls = members.filter((m) => m.part.kind === \"tool_call\");\n  const callIds = new Set(\n    calls.map((m) => m.toolCallId).filter((id): id is string => id !== undefined),\n  );\n  const orphanResults = members.filter(\n    (m) =>\n      m.part.kind === \"tool_result\" &&\n      (m.toolCallId === undefined || !callIds.has(m.toolCallId)),\n  );\n  const counts: Record<ToolOutcome, number> = { succeeded: 0, failed: 0, unknown: 0 };\n  for (const m of [...calls, ...orphanResults]) counts[m.part.outcome ?? \"unknown\"] += 1;\n  const outcome: ToolOutcome =\n    counts.failed > 0 ? \"failed\" : counts.unknown > 0 ? \"unknown\" : \"succeeded\";\n  const toolNames: string[] = [];\n  for (const call of calls) {\n    if (call.toolName !== undefined && !toolNames.includes(call.toolName)) {\n      toolNames.push(call.toolName);\n    }\n  }\n  return { counts, outcome, callCount: calls.length, toolNames };\n}\n\nfunction runTallyText(counts: Record<ToolOutcome, number>): string {\n  const segs = RUN_OUTCOME_ORDER.filter((o) => counts[o] > 0).map((o) => `${counts[o]} ${o}`);\n  return segs.length > 0 ? segs.join(\", \") : \"no outcomes\";\n}\n\n// One RenderingPart and one ToolRunReceipt for a maximal tool run (AC-3.4): a\n// run-level header (tools, call count, outcome tally) over the members'\n// composed accounts in record order — each tool member stating its own\n// outcome so a state-changing call cannot lose it, interior thinking/notes\n// riding inline. The receipt restates the same account + run outcome for the\n// chunk summaries (AC-3.8).\nfunction composeRun(members: readonly ComposeAtom[]): {\n  part: RenderingPart;\n  receipt: ToolRunReceipt;\n} {\n  const { counts, outcome, callCount, toolNames } = tallyRun(members);\n  const tools = toolNames.length > 0 ? toolNames.join(\", \") : \"tools\";\n  const header = `tool run · ${tools} · ${callCount} call${callCount === 1 ? \"\" : \"s\"} · ${runTallyText(counts)}`;\n  const detail = members\n    .map((m) => (m.isTool ? `${m.part.text} ⇒ ${m.part.outcome ?? \"unknown\"}` : m.part.text))\n    .join(\"\\n\");\n  const text = `[${header}]\\n${detail}`;\n  const lead = members[0];\n  if (lead === undefined) throw new Error(\"composeRun: a tool run has no members\");\n  return {\n    part: {\n      messageId: lead.part.messageId,\n      kind: lead.part.kind,\n      text,\n      fallback: members.some((m) => m.isTool && m.part.fallback),\n      outcome,\n    },\n    receipt: {\n      messageId: lead.part.messageId,\n      activity: lead.part.kind === \"tool_result\" ? \"tool_result\" : \"tool_call\",\n      account: text,\n      outcome,\n    },\n  };\n}\n\n// Compose the ordered RenderingParts and tool-run receipts. Per-message atoms\n// build first (forms verbatim or fallbacks, per-message gaps); then maximal\n// runs of consecutive tool activity fold into one run part + one receipt each\n// (AC-3.4), with prompts/assistant text breaking runs and thinking/runtime\n// notes transparent to them.\nexport function composeRenderingInput(\n  messages: readonly ComposeMessage[],\n  forms: ReadonlyMap<string, ComposeFormRow>,\n): CompositionInput {\n  const resultByCallId = recordOutcomes(messages);\n  const atoms: ComposeAtom[] = [];\n  const gaps: DependencyGap[] = [];\n  for (const message of messages) {\n    const built = buildAtom(message, forms, resultByCallId);\n    atoms.push(built.atom);\n    if (built.gap !== undefined) gaps.push(built.gap);\n  }\n\n  const parts: RenderingPart[] = [];\n  const receipts: ToolRunReceipt[] = [];\n  let i = 0;\n  while (i < atoms.length) {\n    const atom = atoms[i];\n    if (atom === undefined) break; // i < length keeps this unreachable\n    if (!atom.isTool) {\n      parts.push(atom.part); // prompt, assistant text, or an edge thinking/note\n      i += 1;\n      continue;\n    }\n    // A maximal run starting at this tool atom: extend over following tool\n    // atoms and interior transparent atoms (thinking/notes), stopping at the\n    // next break (prompt/assistant text) or the turn's end. Transparent atoms\n    // trailing the last tool atom stand alone, not folded into the run.\n    let j = i;\n    let lastToolIdx = i;\n    for (let next = atoms[j + 1]; next !== undefined && !next.isBreak; next = atoms[j + 1]) {\n      j += 1;\n      if (next.isTool) lastToolIdx = j;\n    }\n    const run = composeRun(atoms.slice(i, lastToolIdx + 1));\n    parts.push(run.part);\n    receipts.push(run.receipt);\n    for (let k = lastToolIdx + 1; k <= j; k += 1) {\n      const trailing = atoms[k];\n      if (trailing !== undefined) parts.push(trailing.part);\n    }\n    i = j + 1;\n  }\n\n  return { parts, gaps, receipts };\n}\n","numLines":323,"startLine":1,"totalLines":323}}}

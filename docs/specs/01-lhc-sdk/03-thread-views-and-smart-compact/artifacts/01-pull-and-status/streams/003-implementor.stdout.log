{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015f8CShAc2zJwkkLpERVJa4","type":"tool_result","content":"1\t// Epic 03 Story 0 view-domain test seams. Lives in fixtures/ — the one\n2\t// directory sanctioned to reach below the SDK surface (boundary check\n3\t// exempt).\n4\t//\n5\t// The injection facility (FC-0.6): re-export of the thread-view seam so\n6\t// tests install crash/failure hooks at the two named points — the\n7\t// post-commit advance (TC-4.6) and compact's write path between sweep and\n8\t// view write (TC-2.4). Uninstalled, production fires are no-ops.\n9\texport {\n10\t  fireViewInjection,\n11\t  setViewInjectionHook,\n12\t  type ViewInjectionHook,\n13\t  type ViewInjectionPoint,\n14\t} from \"../../src/domains/thread-view/internal/seam.js\";\n15\t\n16\timport { DatabaseSync } from \"node:sqlite\";\n17\t\n18\t// Sanctioned below-SDK write (same sanctioning as corrupt.ts): seeds the\n19\t// view_boundary row to an arbitrary position for TC-1.4's mid-tail pulls.\n20\t// Boundary *mechanics* — how the position legally moves — are Story 4's to\n21\t// prove; this helper only manufactures a position the pull must respect.\n22\t// UPDATE-only on purpose: migration v6 seeded the singleton row, mirroring\n23\t// the production advance's write shape.\n24\texport function seedViewBoundary(filePath: string, position: number): void {\n25\t  const db = new DatabaseSync(filePath);\n26\t  try {\n27\t    const changed = db\n28\t      .prepare(\n29\t        `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n30\t      )\n31\t      .run(position, new Date().toISOString());\n32\t    if (Number(changed.changes) !== 1) {\n33\t      throw new Error(\n34\t        `fixture seedViewBoundary hit ${String(changed.changes)} rows; expected the migration-seeded singleton`,\n35\t      );\n36\t    }\n37\t  } finally {\n38\t    db.close();\n39\t  }\n40\t}\n41\t"}]},"parent_tool_use_id":null,"session_id":"28aec8fc-3297-4f03-8488-65ebfbadd697","uuid":"81560466-88bb-4597-927c-270f63d38742","timestamp":"2026-06-11T14:37:55.714Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-seam.ts","content":"// Epic 03 Story 0 view-domain test seams. Lives in fixtures/ — the one\n// directory sanctioned to reach below the SDK surface (boundary check\n// exempt).\n//\n// The injection facility (FC-0.6): re-export of the thread-view seam so\n// tests install crash/failure hooks at the two named points — the\n// post-commit advance (TC-4.6) and compact's write path between sweep and\n// view write (TC-2.4). Uninstalled, production fires are no-ops.\nexport {\n  fireViewInjection,\n  setViewInjectionHook,\n  type ViewInjectionHook,\n  type ViewInjectionPoint,\n} from \"../../src/domains/thread-view/internal/seam.js\";\n\nimport { DatabaseSync } from \"node:sqlite\";\n\n// Sanctioned below-SDK write (same sanctioning as corrupt.ts): seeds the\n// view_boundary row to an arbitrary position for TC-1.4's mid-tail pulls.\n// Boundary *mechanics* — how the position legally moves — are Story 4's to\n// prove; this helper only manufactures a position the pull must respect.\n// UPDATE-only on purpose: migration v6 seeded the singleton row, mirroring\n// the production advance's write shape.\nexport function seedViewBoundary(filePath: string, position: number): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    const changed = db\n      .prepare(\n        `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n      )\n      .run(position, new Date().toISOString());\n    if (Number(changed.changes) !== 1) {\n      throw new Error(\n        `fixture seedViewBoundary hit ${String(changed.changes)} rows; expected the migration-seeded singleton`,\n      );\n    }\n  } finally {\n    db.close();\n  }\n}\n","numLines":41,"startLine":1,"totalLines":41}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UpUxTjnKtEiJZA2V9YSTiR","type":"tool_result","content":"1\t// Epic 03 Story 0 foundation checks (FC-0.1–FC-0.6): migration v6 storage,\n2\t// profile config validation through real createSdk construction, the\n3\t// derived-thread fixture's state fidelity proven by read-back through the\n4\t// owning report surfaces (states reached through production drains, never\n5\t// hand-written rows), the corruption and turnless-straggler variants, and\n6\t// the two-point test injection facility.\n7\timport { afterAll, afterEach, beforeAll, describe, expect, it } from \"vitest\";\n8\timport { createSdk, messages, turns, type Lhc } from \"../src/index.js\";\n9\timport {\n10\t  blockedSiblingThread,\n11\t  corruptedVariantThread,\n12\t  createProviderDouble,\n13\t  derivedThreadFixture,\n14\t  fireViewInjection,\n15\t  openRaw,\n16\t  PERMANENT_FAILURE_REASON,\n17\t  schemaVersionOf,\n18\t  setViewInjectionHook,\n19\t  stragglerVariantThread,\n20\t  tempStore,\n21\t  TRANSIENT_EXHAUST_REASON,\n22\t  validEvent,\n23\t  type DerivedThreadFixture,\n24\t  type TempStore,\n25\t} from \"./fixtures/index.js\";\n26\t\n27\t// The main fixture is the suite's load-bearing asset and is expensive to\n28\t// drain; it is built once and read (never mutated) by every check below.\n29\tlet store: TempStore;\n30\tlet fixture: DerivedThreadFixture;\n31\t\n32\tbeforeAll(async () => {\n33\t  store = tempStore();\n34\t  fixture = await derivedThreadFixture(store);\n35\t});\n36\tafterAll(() => {\n37\t  store.cleanup();\n38\t});\n39\t\n40\tfunction manualSdk(view?: Parameters<typeof createSdk>[0][\"view\"]): Lhc {\n41\t  return createSdk({\n42\t    provider: createProviderDouble(),\n43\t    mode: \"manual\",\n44\t    ...(view === undefined ? {} : { view }),\n45\t  });\n46\t}\n47\t\n48\tdescribe(\"FC-0.1: migration v6 storage on a current thread file\", () => {\n49\t  it(\"creates the three view tables with their CHECK constraints and seeds the boundary at 0\", () => {\n50\t    expect(schemaVersionOf(fixture.filePath)).toBe(6);\n51\t    const db = openRaw(fixture.filePath);\n52\t    try {\n53\t      const tables = (\n54\t        db\n55\t          .prepare(\n56\t            `SELECT name FROM sqlite_master WHERE type = 'table'\n57\t             AND name IN ('thread_view', 'thread_view_band', 'view_boundary') ORDER BY name`,\n58\t          )\n59\t          .all() as unknown as Array<{ name: string }>\n60\t      ).map((row) => row.name);\n61\t      expect(tables).toEqual([\"thread_view\", \"thread_view_band\", \"view_boundary\"]);\n62\t\n63\t      // The boundary singleton is seeded at position 0 (everything full).\n64\t      const boundary = db\n65\t        .prepare(`SELECT thread_singleton, position, updated_at FROM view_boundary`)\n66\t        .all() as unknown as Array<{\n67\t        thread_singleton: number | bigint;\n68\t        position: number | bigint;\n69\t        updated_at: string;\n70\t      }>;\n71\t      expect(boundary).toHaveLength(1);\n72\t      expect(Number(boundary[0]!.thread_singleton)).toBe(1);\n73\t      expect(Number(boundary[0]!.position)).toBe(0);\n74\t      expect(boundary[0]!.updated_at.length).toBeGreaterThan(0);\n75\t\n76\t      // Singleton CHECKs enforce structurally: a second view row or a second\n77\t      // boundary row cannot exist (failed inserts, nothing mutated).\n78\t      expect(() =>\n79\t        db\n80\t          .prepare(\n81\t            `INSERT INTO thread_view (singleton, view_id, created_at, compact_point,\n82\t               covered_from, config_json, arrangement_json, gaps_json, source_state_json)\n83\t             VALUES (2, 'v1', 'now', 0, 0, '{}', '[]', '[]', '{}')`,\n84\t          )\n85\t          .run(),\n86\t      ).toThrow(/CHECK/);\n87\t      expect(() =>\n88\t        db\n89\t          .prepare(`INSERT INTO view_boundary (thread_singleton, position, updated_at) VALUES (2, 0, 'now')`)\n90\t          .run(),\n91\t      ).toThrow(/CHECK/);\n92\t\n93\t      // The band table pins its band vocabulary and cascade in the DDL.\n94\t      const bandDdl = (\n95\t        db\n96\t          .prepare(`SELECT sql FROM sqlite_master WHERE name = 'thread_view_band'`)\n97\t          .get() as { sql: string }\n98\t      ).sql;\n99\t      expect(bandDdl).toContain(\"CHECK (band IN ('brief','detailed','smooth'))\");\n100\t      expect(bandDdl).toContain(\"ON DELETE CASCADE\");\n101\t    } finally {\n102\t      db.close();\n103\t    }\n104\t  });\n105\t});\n106\t\n107\tdescribe(\"FC-0.2: view config validated at SDK construction, errors naming the violation\", () => {\n108\t  it(\"rejects a profile whose band percentages do not sum to 100\", () => {\n109\t    expect(() =>\n110\t      manualSdk({\n111\t        profiles: [\n112\t          {\n113\t            name: \"skewed\",\n114\t            lowerBound: 50000,\n115\t            percentages: { full: 30, smooth: 35, detailed: 20, brief: 20 },\n116\t          },\n117\t        ],\n118\t      }),\n119\t    ).toThrow(/profile \"skewed\": percentages must sum to 100, got 105/);\n120\t  });\n121\t\n122\t  it(\"rejects visibility budgets violating max > target >= floor, naming the constraint\", () => {\n123\t    expect(() => manualSdk({ visibility: { maxTokens: 24000, targetTokens: 24000 } })).toThrow(\n124\t      /visibility\\.maxTokens \\(24000\\) must be greater than targetTokens \\(24000\\)/,\n125\t    );\n126\t    expect(() =>\n127\t      manualSdk({ visibility: { targetTokens: 7000, floorTokens: 8000, maxTokens: 32000 } }),\n128\t    ).toThrow(/visibility\\.targetTokens \\(7000\\) must be at least floorTokens \\(8000\\)/);\n129\t  });\n130\t\n131\t  it(\"rejects a non-positive lower bound\", () => {\n132\t    expect(() =>\n133\t      manualSdk({\n134\t        profiles: [\n135\t          {\n136\t            name: \"hollow\",\n137\t            lowerBound: 0,\n138\t            percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n139\t          },\n140\t        ],\n141\t      }),\n142\t    ).toThrow(/profile \"hollow\": lowerBound must be a positive number, got 0/);\n143\t  });\n144\t\n145\t  it(\"rejects a partial profile that overrides no built-in (unknown override target)\", () => {\n146\t    expect(() => manualSdk({ profiles: [{ name: \"mystery\", lowerBound: 64000 }] })).toThrow(\n147\t      /profile \"mystery\" is partial but overrides no built-in \\(unknown built-in override target\\)/,\n148\t    );\n149\t  });\n150\t\n151\t  it(\"resolves defaults and merges a built-in override field-wise\", () => {\n152\t    const sdk = manualSdk({ profiles: [{ name: \"coding\", lowerBound: 64000 }] });\n153\t    expect(sdk.config.view.visibility).toEqual({\n154\t      maxTokens: 32000,\n155\t      targetTokens: 24000,\n156\t      floorTokens: 8000,\n157\t    });\n158\t    expect(sdk.config.view.compactThreshold).toBe(160000);\n159\t    // The override replaced only the named field; the built-in's percentages\n160\t    // survive, and the other built-ins are untouched.\n161\t    expect(sdk.config.view.profiles[\"coding\"]).toEqual({\n162\t      name: \"coding\",\n163\t      lowerBound: 64000,\n164\t      percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n165\t    });\n166\t    expect(sdk.config.view.profiles[\"continuation\"]).toEqual({\n167\t      name: \"continuation\",\n168\t      lowerBound: 120000,\n169\t      percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n170\t    });\n171\t    expect(sdk.config.view.profiles[\"conversation\"]?.percentages).toEqual({\n172\t      full: 12,\n173\t      smooth: 48,\n174\t      detailed: 20,\n175\t      brief: 20,\n176\t    });\n177\t  });\n178\t});\n179\t\n180\tdescribe(\"FC-0.3: fixture states proven by read-back through the owning report surfaces\", () => {\n181\t  it(\"ready: every turn rendering and the closed chunks' summaries read back ready through turns.report\", async () => {\n182\t    const report = await turns.report({ filePath: fixture.filePath });\n183\t    expect(report.ok).toBe(true);\n184\t    if (!report.ok) return;\n185\t    const renderings = report.value.filter((entry) => entry.form === \"turn_rendering\");\n186\t    expect(renderings.map((entry) => entry.subjectId).sort()).toEqual(\n187\t      [...fixture.turnIds].sort(),\n188\t    );\n189\t    for (const rendering of renderings) {\n190\t      expect(rendering.state).toBe(\"ready\");\n191\t      expect(rendering.content).toBeDefined();\n192\t    }\n193\t    // The fixture's pinned shape: 4 chunks, c1–c3 closed with both summary\n194\t    // forms ready (the drain ran their close→summary enqueues to completion).\n195\t    expect(fixture.chunks.chunks.map((chunk) => `${chunk.chunkId}:${chunk.status}`)).toEqual([\n196\t      \"c1:closed\",\n197\t      \"c2:closed\",\n198\t      \"c3:closed\",\n199\t      \"c4:open\",\n200\t    ]);\n201\t    for (const chunkId of [\"c1\", \"c2\", \"c3\"]) {\n202\t      for (const form of [\"chunk_summary_detailed\", \"chunk_summary_brief\"]) {\n203\t        const summary = report.value.find(\n204\t          (entry) => entry.subjectId === chunkId && entry.form === form,\n205\t        );\n206\t        expect(summary?.state).toBe(\"ready\");\n207\t      }\n208\t    }\n209\t  });\n210\t\n211\t  it(\"failed-transient and failed-permanent: the scripted subjects read back failed through messages.report\", async () => {\n212\t    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n213\t    expect(report.ok).toBe(true);\n214\t    if (!report.ok) return;\n215\t    const transient = report.value.find(\n216\t      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n217\t    );\n218\t    expect(transient?.form).toBe(\"tool_result_summary\");\n219\t    expect(transient?.state).toBe(\"failed\");\n220\t    const permanent = report.value.find(\n221\t      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n222\t    );\n223\t    expect(permanent?.form).toBe(\"tool_result_summary\");\n224\t    expect(permanent?.state).toBe(\"failed\");\n225\t    // Terminal failures left no live queue rows behind (DD-1): neither entry\n226\t    // carries queue detail.\n227\t    expect(transient?.queue).toBeUndefined();\n228\t    expect(permanent?.queue).toBeUndefined();\n229\t  });\n230\t\n231\t  it(\"blocked: real source damage on the sacrificial sibling lands the turn forms blocked\", async () => {\n232\t    const sibling = await blockedSiblingThread(store);\n233\t    const report = await turns.report({ filePath: sibling.filePath });\n234\t    expect(report.ok).toBe(true);\n235\t    if (!report.ok) return;\n236\t    const blocked = report.value.filter(\n237\t      (entry) => entry.subjectId === sibling.blockedTurnId && entry.state === \"blocked\",\n238\t    );\n239\t    expect(blocked.map((entry) => entry.form).sort()).toEqual([\n240\t      \"lower_band_projection\",\n241\t      \"turn_rendering\",\n242\t    ]);\n243\t    for (const entry of blocked) {\n244\t      expect(entry.reason).toMatch(/^source_damaged: turn state corrupt/);\n245\t    }\n246\t  });\n247\t});\n248\t\n249\tdescribe(\"FC-0.4: the two failed forms carry distinguishable reason classes (Story 3 dependency)\", () => {\n250\t  it(\"transient exhaustion persists the final failure's reason class and its attempt count\", async () => {\n251\t    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n252\t    expect(report.ok).toBe(true);\n253\t    if (!report.ok) return;\n254\t    const transient = report.value.find(\n255\t      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n256\t    );\n257\t    const permanent = report.value.find(\n258\t      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n259\t    );\n260\t\n261\t    // Not a bare retry-exhausted marker: the persisted reason is the final\n262\t    // provider failure's, classifiable by the sweep's reason-code table.\n263\t    expect(transient?.reason).toBe(TRANSIENT_EXHAUST_REASON);\n264\t    expect(transient?.reason).toMatch(/^rate_limit:/);\n265\t    expect(transient?.metadata?.attempts).toBe(3);\n266\t    expect(transient?.metadata?.lastError).toBe(TRANSIENT_EXHAUST_REASON);\n267\t\n268\t    expect(permanent?.reason).toBe(PERMANENT_FAILURE_REASON);\n269\t    expect(permanent?.reason).toMatch(/^content_refusal:/);\n270\t    expect(permanent?.metadata?.attempts).toBe(1);\n271\t\n272\t    // The classes are distinguishable on read-back — attempt count is NOT\n273\t    // the discriminator (it distinguishes retrying-vs-exhausted only).\n274\t    expect(transient?.reason).not.toBe(permanent?.reason);\n275\t  });\n276\t});\n277\t\n278\tdescribe(\"FC-0.5: corruption and turnless-straggler variants\", () => {\n279\t  it(\"the corruption variant refuses canonical consumption with state_corruption naming the damage\", async () => {\n280\t    const corrupted = await corruptedVariantThread(store);\n281\t    const refused = await corrupted.sdk.intakeStream.messageEvents({ filePath: corrupted.filePath }, [\n282\t      validEvent(\"user_prompt\", { payload: { text: \"after the damage\" } }),\n283\t    ]);\n284\t    expect(refused.ok).toBe(false);\n285\t    if (refused.ok) return;\n286\t    expect(refused.error.errorClass).toBe(\"state_corruption\");\n287\t    expect(refused.error.code).toBe(\"turn_state_corrupt\");\n288\t    expect(refused.error.reason).toMatch(/open turns/);\n289\t  });\n290\t\n291\t  it(\"the straggler variant carries turnId-null notes between two turns and after the last turn\", async () => {\n292\t    const variant = await stragglerVariantThread(store);\n293\t    const listed = await messages.listMessages({ filePath: variant.filePath });\n294\t    const turnList = await turns.listTurns({ filePath: variant.filePath });\n295\t    expect(listed.ok && turnList.ok).toBe(true);\n296\t    if (!listed.ok || !turnList.ok) return;\n297\t\n298\t    const between = listed.value.find(\n299\t      (message) => message.messageId === variant.stragglerBetweenMessageId,\n300\t    );\n301\t    const trailing = listed.value.find(\n302\t      (message) => message.messageId === variant.stragglerTrailingMessageId,\n303\t    );\n304\t    expect(between?.kind).toBe(\"runtime_note\");\n305\t    expect(between?.turnId).toBeUndefined();\n306\t    expect(trailing?.kind).toBe(\"runtime_note\");\n307\t    expect(trailing?.turnId).toBeUndefined();\n308\t\n309\t    // Between two turns: after t3 closed, before t4 opened — the selection\n310\t    // rule 6 / G4 position.\n311\t    const t3 = turnList.value.find((turn) => turn.turnId === \"t3\");\n312\t    const t4 = turnList.value.find((turn) => turn.turnId === \"t4\");\n313\t    expect(between!.sourceEventOrder).toBeGreaterThan(t3!.closedAtEventOrder!);\n314\t    expect(between!.sourceEventOrder).toBeLessThan(t4!.openedAtEventOrder);\n315\t\n316\t    // After the last turn: beyond t12's close, with no turn following.\n317\t    const t12 = turnList.value.find((turn) => turn.turnId === \"t12\");\n318\t    expect(trailing!.sourceEventOrder).toBeGreaterThan(t12!.closedAtEventOrder!);\n319\t    expect(Math.max(...listed.value.map((message) => message.sourceEventOrder))).toBe(\n320\t      trailing!.sourceEventOrder,\n321\t    );\n322\t  });\n323\t});\n324\t\n325\tdescribe(\"FC-0.6: the injection facility's two named points\", () => {\n326\t  afterEach(() => {\n327\t    setViewInjectionHook(\"post-commit-advance\", null);\n328\t    setViewInjectionHook(\"compact-write\", null);\n329\t  });\n330\t\n331\t  it(\"uninstalled, both points are no-ops\", () => {\n332\t    expect(() => fireViewInjection(\"post-commit-advance\")).not.toThrow();\n333\t    expect(() => fireViewInjection(\"compact-write\")).not.toThrow();\n334\t  });\n335\t\n336\t  it(\"an installed hook fires at its point only, its throw propagates, and uninstalling restores the no-op\", () => {\n337\t    const fired: string[] = [];\n338\t    setViewInjectionHook(\"post-commit-advance\", () => {\n339\t      fired.push(\"advance\");\n340\t    });\n341\t    fireViewInjection(\"post-commit-advance\");\n342\t    fireViewInjection(\"compact-write\"); // other point stays a no-op\n343\t    expect(fired).toEqual([\"advance\"]);\n344\t\n345\t    // Crash injection (TC-2.4 / TC-4.6's mechanism): a throwing hook's\n346\t    // failure reaches the production call site.\n347\t    setViewInjectionHook(\"compact-write\", () => {\n348\t      throw new Error(\"injected crash between sweep and view write\");\n349\t    });\n350\t    expect(() => fireViewInjection(\"compact-write\")).toThrow(/injected crash/);\n351\t\n352\t    setViewInjectionHook(\"post-commit-advance\", null);\n353\t    setViewInjectionHook(\"compact-write\", null);\n354\t    fired.length = 0;\n355\t    fireViewInjection(\"post-commit-advance\");\n356\t    fireViewInjection(\"compact-write\");\n357\t    expect(fired).toEqual([]);\n358\t  });\n359\t});\n360\t"}]},"parent_tool_use_id":null,"session_id":"28aec8fc-3297-4f03-8488-65ebfbadd697","uuid":"6434ca59-b9e4-402b-bf63-78e3e634c0e4","timestamp":"2026-06-11T14:40:07.545Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-fixture.test.ts","content":"// Epic 03 Story 0 foundation checks (FC-0.1–FC-0.6): migration v6 storage,\n// profile config validation through real createSdk construction, the\n// derived-thread fixture's state fidelity proven by read-back through the\n// owning report surfaces (states reached through production drains, never\n// hand-written rows), the corruption and turnless-straggler variants, and\n// the two-point test injection facility.\nimport { afterAll, afterEach, beforeAll, describe, expect, it } from \"vitest\";\nimport { createSdk, messages, turns, type Lhc } from \"../src/index.js\";\nimport {\n  blockedSiblingThread,\n  corruptedVariantThread,\n  createProviderDouble,\n  derivedThreadFixture,\n  fireViewInjection,\n  openRaw,\n  PERMANENT_FAILURE_REASON,\n  schemaVersionOf,\n  setViewInjectionHook,\n  stragglerVariantThread,\n  tempStore,\n  TRANSIENT_EXHAUST_REASON,\n  validEvent,\n  type DerivedThreadFixture,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\n// The main fixture is the suite's load-bearing asset and is expensive to\n// drain; it is built once and read (never mutated) by every check below.\nlet store: TempStore;\nlet fixture: DerivedThreadFixture;\n\nbeforeAll(async () => {\n  store = tempStore();\n  fixture = await derivedThreadFixture(store);\n});\nafterAll(() => {\n  store.cleanup();\n});\n\nfunction manualSdk(view?: Parameters<typeof createSdk>[0][\"view\"]): Lhc {\n  return createSdk({\n    provider: createProviderDouble(),\n    mode: \"manual\",\n    ...(view === undefined ? {} : { view }),\n  });\n}\n\ndescribe(\"FC-0.1: migration v6 storage on a current thread file\", () => {\n  it(\"creates the three view tables with their CHECK constraints and seeds the boundary at 0\", () => {\n    expect(schemaVersionOf(fixture.filePath)).toBe(6);\n    const db = openRaw(fixture.filePath);\n    try {\n      const tables = (\n        db\n          .prepare(\n            `SELECT name FROM sqlite_master WHERE type = 'table'\n             AND name IN ('thread_view', 'thread_view_band', 'view_boundary') ORDER BY name`,\n          )\n          .all() as unknown as Array<{ name: string }>\n      ).map((row) => row.name);\n      expect(tables).toEqual([\"thread_view\", \"thread_view_band\", \"view_boundary\"]);\n\n      // The boundary singleton is seeded at position 0 (everything full).\n      const boundary = db\n        .prepare(`SELECT thread_singleton, position, updated_at FROM view_boundary`)\n        .all() as unknown as Array<{\n        thread_singleton: number | bigint;\n        position: number | bigint;\n        updated_at: string;\n      }>;\n      expect(boundary).toHaveLength(1);\n      expect(Number(boundary[0]!.thread_singleton)).toBe(1);\n      expect(Number(boundary[0]!.position)).toBe(0);\n      expect(boundary[0]!.updated_at.length).toBeGreaterThan(0);\n\n      // Singleton CHECKs enforce structurally: a second view row or a second\n      // boundary row cannot exist (failed inserts, nothing mutated).\n      expect(() =>\n        db\n          .prepare(\n            `INSERT INTO thread_view (singleton, view_id, created_at, compact_point,\n               covered_from, config_json, arrangement_json, gaps_json, source_state_json)\n             VALUES (2, 'v1', 'now', 0, 0, '{}', '[]', '[]', '{}')`,\n          )\n          .run(),\n      ).toThrow(/CHECK/);\n      expect(() =>\n        db\n          .prepare(`INSERT INTO view_boundary (thread_singleton, position, updated_at) VALUES (2, 0, 'now')`)\n          .run(),\n      ).toThrow(/CHECK/);\n\n      // The band table pins its band vocabulary and cascade in the DDL.\n      const bandDdl = (\n        db\n          .prepare(`SELECT sql FROM sqlite_master WHERE name = 'thread_view_band'`)\n          .get() as { sql: string }\n      ).sql;\n      expect(bandDdl).toContain(\"CHECK (band IN ('brief','detailed','smooth'))\");\n      expect(bandDdl).toContain(\"ON DELETE CASCADE\");\n    } finally {\n      db.close();\n    }\n  });\n});\n\ndescribe(\"FC-0.2: view config validated at SDK construction, errors naming the violation\", () => {\n  it(\"rejects a profile whose band percentages do not sum to 100\", () => {\n    expect(() =>\n      manualSdk({\n        profiles: [\n          {\n            name: \"skewed\",\n            lowerBound: 50000,\n            percentages: { full: 30, smooth: 35, detailed: 20, brief: 20 },\n          },\n        ],\n      }),\n    ).toThrow(/profile \"skewed\": percentages must sum to 100, got 105/);\n  });\n\n  it(\"rejects visibility budgets violating max > target >= floor, naming the constraint\", () => {\n    expect(() => manualSdk({ visibility: { maxTokens: 24000, targetTokens: 24000 } })).toThrow(\n      /visibility\\.maxTokens \\(24000\\) must be greater than targetTokens \\(24000\\)/,\n    );\n    expect(() =>\n      manualSdk({ visibility: { targetTokens: 7000, floorTokens: 8000, maxTokens: 32000 } }),\n    ).toThrow(/visibility\\.targetTokens \\(7000\\) must be at least floorTokens \\(8000\\)/);\n  });\n\n  it(\"rejects a non-positive lower bound\", () => {\n    expect(() =>\n      manualSdk({\n        profiles: [\n          {\n            name: \"hollow\",\n            lowerBound: 0,\n            percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n          },\n        ],\n      }),\n    ).toThrow(/profile \"hollow\": lowerBound must be a positive number, got 0/);\n  });\n\n  it(\"rejects a partial profile that overrides no built-in (unknown override target)\", () => {\n    expect(() => manualSdk({ profiles: [{ name: \"mystery\", lowerBound: 64000 }] })).toThrow(\n      /profile \"mystery\" is partial but overrides no built-in \\(unknown built-in override target\\)/,\n    );\n  });\n\n  it(\"resolves defaults and merges a built-in override field-wise\", () => {\n    const sdk = manualSdk({ profiles: [{ name: \"coding\", lowerBound: 64000 }] });\n    expect(sdk.config.view.visibility).toEqual({\n      maxTokens: 32000,\n      targetTokens: 24000,\n      floorTokens: 8000,\n    });\n    expect(sdk.config.view.compactThreshold).toBe(160000);\n    // The override replaced only the named field; the built-in's percentages\n    // survive, and the other built-ins are untouched.\n    expect(sdk.config.view.profiles[\"coding\"]).toEqual({\n      name: \"coding\",\n      lowerBound: 64000,\n      percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n    });\n    expect(sdk.config.view.profiles[\"continuation\"]).toEqual({\n      name: \"continuation\",\n      lowerBound: 120000,\n      percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n    });\n    expect(sdk.config.view.profiles[\"conversation\"]?.percentages).toEqual({\n      full: 12,\n      smooth: 48,\n      detailed: 20,\n      brief: 20,\n    });\n  });\n});\n\ndescribe(\"FC-0.3: fixture states proven by read-back through the owning report surfaces\", () => {\n  it(\"ready: every turn rendering and the closed chunks' summaries read back ready through turns.report\", async () => {\n    const report = await turns.report({ filePath: fixture.filePath });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const renderings = report.value.filter((entry) => entry.form === \"turn_rendering\");\n    expect(renderings.map((entry) => entry.subjectId).sort()).toEqual(\n      [...fixture.turnIds].sort(),\n    );\n    for (const rendering of renderings) {\n      expect(rendering.state).toBe(\"ready\");\n      expect(rendering.content).toBeDefined();\n    }\n    // The fixture's pinned shape: 4 chunks, c1–c3 closed with both summary\n    // forms ready (the drain ran their close→summary enqueues to completion).\n    expect(fixture.chunks.chunks.map((chunk) => `${chunk.chunkId}:${chunk.status}`)).toEqual([\n      \"c1:closed\",\n      \"c2:closed\",\n      \"c3:closed\",\n      \"c4:open\",\n    ]);\n    for (const chunkId of [\"c1\", \"c2\", \"c3\"]) {\n      for (const form of [\"chunk_summary_detailed\", \"chunk_summary_brief\"]) {\n        const summary = report.value.find(\n          (entry) => entry.subjectId === chunkId && entry.form === form,\n        );\n        expect(summary?.state).toBe(\"ready\");\n      }\n    }\n  });\n\n  it(\"failed-transient and failed-permanent: the scripted subjects read back failed through messages.report\", async () => {\n    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const transient = report.value.find(\n      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n    );\n    expect(transient?.form).toBe(\"tool_result_summary\");\n    expect(transient?.state).toBe(\"failed\");\n    const permanent = report.value.find(\n      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n    );\n    expect(permanent?.form).toBe(\"tool_result_summary\");\n    expect(permanent?.state).toBe(\"failed\");\n    // Terminal failures left no live queue rows behind (DD-1): neither entry\n    // carries queue detail.\n    expect(transient?.queue).toBeUndefined();\n    expect(permanent?.queue).toBeUndefined();\n  });\n\n  it(\"blocked: real source damage on the sacrificial sibling lands the turn forms blocked\", async () => {\n    const sibling = await blockedSiblingThread(store);\n    const report = await turns.report({ filePath: sibling.filePath });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const blocked = report.value.filter(\n      (entry) => entry.subjectId === sibling.blockedTurnId && entry.state === \"blocked\",\n    );\n    expect(blocked.map((entry) => entry.form).sort()).toEqual([\n      \"lower_band_projection\",\n      \"turn_rendering\",\n    ]);\n    for (const entry of blocked) {\n      expect(entry.reason).toMatch(/^source_damaged: turn state corrupt/);\n    }\n  });\n});\n\ndescribe(\"FC-0.4: the two failed forms carry distinguishable reason classes (Story 3 dependency)\", () => {\n  it(\"transient exhaustion persists the final failure's reason class and its attempt count\", async () => {\n    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const transient = report.value.find(\n      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n    );\n    const permanent = report.value.find(\n      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n    );\n\n    // Not a bare retry-exhausted marker: the persisted reason is the final\n    // provider failure's, classifiable by the sweep's reason-code table.\n    expect(transient?.reason).toBe(TRANSIENT_EXHAUST_REASON);\n    expect(transient?.reason).toMatch(/^rate_limit:/);\n    expect(transient?.metadata?.attempts).toBe(3);\n    expect(transient?.metadata?.lastError).toBe(TRANSIENT_EXHAUST_REASON);\n\n    expect(permanent?.reason).toBe(PERMANENT_FAILURE_REASON);\n    expect(permanent?.reason).toMatch(/^content_refusal:/);\n    expect(permanent?.metadata?.attempts).toBe(1);\n\n    // The classes are distinguishable on read-back — attempt count is NOT\n    // the discriminator (it distinguishes retrying-vs-exhausted only).\n    expect(transient?.reason).not.toBe(permanent?.reason);\n  });\n});\n\ndescribe(\"FC-0.5: corruption and turnless-straggler variants\", () => {\n  it(\"the corruption variant refuses canonical consumption with state_corruption naming the damage\", async () => {\n    const corrupted = await corruptedVariantThread(store);\n    const refused = await corrupted.sdk.intakeStream.messageEvents({ filePath: corrupted.filePath }, [\n      validEvent(\"user_prompt\", { payload: { text: \"after the damage\" } }),\n    ]);\n    expect(refused.ok).toBe(false);\n    if (refused.ok) return;\n    expect(refused.error.errorClass).toBe(\"state_corruption\");\n    expect(refused.error.code).toBe(\"turn_state_corrupt\");\n    expect(refused.error.reason).toMatch(/open turns/);\n  });\n\n  it(\"the straggler variant carries turnId-null notes between two turns and after the last turn\", async () => {\n    const variant = await stragglerVariantThread(store);\n    const listed = await messages.listMessages({ filePath: variant.filePath });\n    const turnList = await turns.listTurns({ filePath: variant.filePath });\n    expect(listed.ok && turnList.ok).toBe(true);\n    if (!listed.ok || !turnList.ok) return;\n\n    const between = listed.value.find(\n      (message) => message.messageId === variant.stragglerBetweenMessageId,\n    );\n    const trailing = listed.value.find(\n      (message) => message.messageId === variant.stragglerTrailingMessageId,\n    );\n    expect(between?.kind).toBe(\"runtime_note\");\n    expect(between?.turnId).toBeUndefined();\n    expect(trailing?.kind).toBe(\"runtime_note\");\n    expect(trailing?.turnId).toBeUndefined();\n\n    // Between two turns: after t3 closed, before t4 opened — the selection\n    // rule 6 / G4 position.\n    const t3 = turnList.value.find((turn) => turn.turnId === \"t3\");\n    const t4 = turnList.value.find((turn) => turn.turnId === \"t4\");\n    expect(between!.sourceEventOrder).toBeGreaterThan(t3!.closedAtEventOrder!);\n    expect(between!.sourceEventOrder).toBeLessThan(t4!.openedAtEventOrder);\n\n    // After the last turn: beyond t12's close, with no turn following.\n    const t12 = turnList.value.find((turn) => turn.turnId === \"t12\");\n    expect(trailing!.sourceEventOrder).toBeGreaterThan(t12!.closedAtEventOrder!);\n    expect(Math.max(...listed.value.map((message) => message.sourceEventOrder))).toBe(\n      trailing!.sourceEventOrder,\n    );\n  });\n});\n\ndescribe(\"FC-0.6: the injection facility's two named points\", () => {\n  afterEach(() => {\n    setViewInjectionHook(\"post-commit-advance\", null);\n    setViewInjectionHook(\"compact-write\", null);\n  });\n\n  it(\"uninstalled, both points are no-ops\", () => {\n    expect(() => fireViewInjection(\"post-commit-advance\")).not.toThrow();\n    expect(() => fireViewInjection(\"compact-write\")).not.toThrow();\n  });\n\n  it(\"an installed hook fires at its point only, its throw propagates, and uninstalling restores the no-op\", () => {\n    const fired: string[] = [];\n    setViewInjectionHook(\"post-commit-advance\", () => {\n      fired.push(\"advance\");\n    });\n    fireViewInjection(\"post-commit-advance\");\n    fireViewInjection(\"compact-write\"); // other point stays a no-op\n    expect(fired).toEqual([\"advance\"]);\n\n    // Crash injection (TC-2.4 / TC-4.6's mechanism): a throwing hook's\n    // failure reaches the production call site.\n    setViewInjectionHook(\"compact-write\", () => {\n      throw new Error(\"injected crash between sweep and view write\");\n    });\n    expect(() => fireViewInjection(\"compact-write\")).toThrow(/injected crash/);\n\n    setViewInjectionHook(\"post-commit-advance\", null);\n    setViewInjectionHook(\"compact-write\", null);\n    fired.length = 0;\n    fireViewInjection(\"post-commit-advance\");\n    fireViewInjection(\"compact-write\");\n    expect(fired).toEqual([]);\n  });\n});\n","numLines":360,"startLine":1,"totalLines":360}}}

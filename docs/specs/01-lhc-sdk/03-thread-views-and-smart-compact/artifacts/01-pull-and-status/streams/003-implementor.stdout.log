{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LgtQKaRpigwqdEVo8hHF8r","type":"tool_result","content":"1\t// Profile config resolution and validation (Story 0, FC-0.2): built-in\n2\t// profiles, user profiles merged over them by name, and the budget rules —\n3\t// band shares sum to 100, lower bound positive, visibility max > target ≥\n4\t// floor. Pure functions, no IO. Config mistakes are programmer errors at SDK\n5\t// construction and throw naming the violation (Epic 02 rule); nothing here\n6\t// returns OpResults.\n7\timport type {\n8\t  ResolvedViewConfig,\n9\t  SdkViewConfig,\n10\t  ViewProfile,\n11\t  ViewProfileOverride,\n12\t  VisibilityBudgets,\n13\t} from \"../../../shared/view.js\";\n14\t\n15\t// Built-in profiles (tech design §Interface Definitions): defaults, knobs\n16\t// not architecture.\n17\texport const BUILT_IN_PROFILES: readonly ViewProfile[] = [\n18\t  {\n19\t    name: \"continuation\",\n20\t    lowerBound: 120000,\n21\t    percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n22\t  },\n23\t  {\n24\t    name: \"conversation\",\n25\t    lowerBound: 120000,\n26\t    percentages: { full: 12, smooth: 48, detailed: 20, brief: 20 },\n27\t  },\n28\t  {\n29\t    name: \"coding\",\n30\t    lowerBound: 120000,\n31\t    percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n32\t  },\n33\t];\n34\t\n35\texport const DEFAULT_VISIBILITY: VisibilityBudgets = {\n36\t  maxTokens: 32000,\n37\t  targetTokens: 24000,\n38\t  floorTokens: 8000,\n39\t};\n40\t\n41\texport const DEFAULT_COMPACT_THRESHOLD = 160000;\n42\t\n43\tfunction fail(detail: string): never {\n44\t  throw new TypeError(`createSdk config: view: ${detail}`);\n45\t}\n46\t\n47\tconst BAND_KEYS = [\"full\", \"smooth\", \"detailed\", \"brief\"] as const;\n48\t\n49\t// A complete, merged profile validates whole: positive lower bound, finite\n50\t// non-negative shares, shares summing to exactly 100. Errors name the\n51\t// violated constraint and the profile (AC-2.3's vocabulary, applied at\n52\t// construction).\n53\texport function validateProfile(profile: ViewProfile): void {\n54\t  if (!Number.isFinite(profile.lowerBound) || profile.lowerBound <= 0) {\n55\t    fail(\n56\t      `profile \"${profile.name}\": lowerBound must be a positive number, got ${profile.lowerBound}`,\n57\t    );\n58\t  }\n59\t  for (const key of BAND_KEYS) {\n60\t    const share = profile.percentages[key];\n61\t    if (!Number.isFinite(share) || share < 0) {\n62\t      fail(`profile \"${profile.name}\": percentage ${key} must be a non-negative number, got ${share}`);\n63\t    }\n64\t  }\n65\t  const sum = BAND_KEYS.reduce((total, key) => total + profile.percentages[key], 0);\n66\t  if (sum !== 100) {\n67\t    fail(`profile \"${profile.name}\": percentages must sum to 100, got ${sum}`);\n68\t  }\n69\t}\n70\t\n71\tfunction isCompleteOverride(entry: ViewProfileOverride): boolean {\n72\t  return (\n73\t    entry.lowerBound !== undefined &&\n74\t    entry.percentages !== undefined &&\n75\t    BAND_KEYS.every((key) => entry.percentages?.[key] !== undefined)\n76\t  );\n77\t}\n78\t\n79\t// Merge one configured entry: field-wise over the built-in it names, or — for\n80\t// a name no built-in carries — the entry must be complete, since there is\n81\t// nothing to merge over (FC-0.2's unknown-built-in-override-target violation).\n82\tfunction mergeProfile(entry: ViewProfileOverride, base: ViewProfile | undefined): ViewProfile {\n83\t  if (base === undefined) {\n84\t    if (!isCompleteOverride(entry)) {\n85\t      fail(\n86\t        `profile \"${entry.name}\" is partial but overrides no built-in (unknown built-in override target); built-ins are ${BUILT_IN_PROFILES.map((p) => `\"${p.name}\"`).join(\", \")} — a new profile must carry lowerBound and all four percentages`,\n87\t      );\n88\t    }\n89\t    return {\n90\t      name: entry.name,\n91\t      lowerBound: entry.lowerBound as number,\n92\t      percentages: {\n93\t        full: entry.percentages?.full as number,\n94\t        smooth: entry.percentages?.smooth as number,\n95\t        detailed: entry.percentages?.detailed as number,\n96\t        brief: entry.percentages?.brief as number,\n97\t      },\n98\t    };\n99\t  }\n100\t  return {\n101\t    name: entry.name,\n102\t    lowerBound: entry.lowerBound ?? base.lowerBound,\n103\t    percentages: {\n104\t      full: entry.percentages?.full ?? base.percentages.full,\n105\t      smooth: entry.percentages?.smooth ?? base.percentages.smooth,\n106\t      detailed: entry.percentages?.detailed ?? base.percentages.detailed,\n107\t      brief: entry.percentages?.brief ?? base.percentages.brief,\n108\t    },\n109\t  };\n110\t}\n111\t\n112\tfunction resolveVisibility(partial: Partial<VisibilityBudgets> | undefined): VisibilityBudgets {\n113\t  const visibility: VisibilityBudgets = {\n114\t    maxTokens: partial?.maxTokens ?? DEFAULT_VISIBILITY.maxTokens,\n115\t    targetTokens: partial?.targetTokens ?? DEFAULT_VISIBILITY.targetTokens,\n116\t    floorTokens: partial?.floorTokens ?? DEFAULT_VISIBILITY.floorTokens,\n117\t  };\n118\t  for (const key of [\"maxTokens\", \"targetTokens\", \"floorTokens\"] as const) {\n119\t    if (!Number.isFinite(visibility[key]) || visibility[key] <= 0) {\n120\t      fail(`visibility.${key} must be a positive number, got ${visibility[key]}`);\n121\t    }\n122\t  }\n123\t  // The budget ordering rule (AC-4.8): max > target ≥ floor.\n124\t  if (visibility.maxTokens <= visibility.targetTokens) {\n125\t    fail(\n126\t      `visibility.maxTokens (${visibility.maxTokens}) must be greater than targetTokens (${visibility.targetTokens})`,\n127\t    );\n128\t  }\n129\t  if (visibility.targetTokens < visibility.floorTokens) {\n130\t    fail(\n131\t      `visibility.targetTokens (${visibility.targetTokens}) must be at least floorTokens (${visibility.floorTokens})`,\n132\t    );\n133\t  }\n134\t  return visibility;\n135\t}\n136\t\n137\t// The one resolution path: built-ins, user profiles merged by name, every\n138\t// resolved profile validated, visibility and threshold defaulted and checked.\n139\t// Called from createSdk so validation runs through real construction, never a\n140\t// standalone validator (Story 0 production-path proof).\n141\texport function resolveViewConfig(config?: SdkViewConfig): ResolvedViewConfig {\n142\t  const profiles: Record<string, ViewProfile> = {};\n143\t  for (const builtIn of BUILT_IN_PROFILES) {\n144\t    profiles[builtIn.name] = builtIn;\n145\t  }\n146\t  for (const entry of config?.profiles ?? []) {\n147\t    if (typeof entry.name !== \"string\" || entry.name.length === 0) {\n148\t      fail(`profile entries must carry a non-empty name`);\n149\t    }\n150\t    profiles[entry.name] = mergeProfile(entry, profiles[entry.name]);\n151\t  }\n152\t  for (const profile of Object.values(profiles)) {\n153\t    validateProfile(profile);\n154\t  }\n155\t\n156\t  const compactThreshold = config?.compactThreshold ?? DEFAULT_COMPACT_THRESHOLD;\n157\t  if (!Number.isFinite(compactThreshold) || compactThreshold <= 0) {\n158\t    fail(`compactThreshold must be a positive number, got ${compactThreshold}`);\n159\t  }\n160\t\n161\t  return {\n162\t    profiles,\n163\t    visibility: resolveVisibility(config?.visibility),\n164\t    compactThreshold,\n165\t  };\n166\t}\n167\t"}]},"parent_tool_use_id":null,"session_id":"28aec8fc-3297-4f03-8488-65ebfbadd697","uuid":"27cfe9d1-0589-4e70-9178-492608f82300","timestamp":"2026-06-11T14:37:43.037Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/profiles.ts","content":"// Profile config resolution and validation (Story 0, FC-0.2): built-in\n// profiles, user profiles merged over them by name, and the budget rules —\n// band shares sum to 100, lower bound positive, visibility max > target ≥\n// floor. Pure functions, no IO. Config mistakes are programmer errors at SDK\n// construction and throw naming the violation (Epic 02 rule); nothing here\n// returns OpResults.\nimport type {\n  ResolvedViewConfig,\n  SdkViewConfig,\n  ViewProfile,\n  ViewProfileOverride,\n  VisibilityBudgets,\n} from \"../../../shared/view.js\";\n\n// Built-in profiles (tech design §Interface Definitions): defaults, knobs\n// not architecture.\nexport const BUILT_IN_PROFILES: readonly ViewProfile[] = [\n  {\n    name: \"continuation\",\n    lowerBound: 120000,\n    percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n  },\n  {\n    name: \"conversation\",\n    lowerBound: 120000,\n    percentages: { full: 12, smooth: 48, detailed: 20, brief: 20 },\n  },\n  {\n    name: \"coding\",\n    lowerBound: 120000,\n    percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n  },\n];\n\nexport const DEFAULT_VISIBILITY: VisibilityBudgets = {\n  maxTokens: 32000,\n  targetTokens: 24000,\n  floorTokens: 8000,\n};\n\nexport const DEFAULT_COMPACT_THRESHOLD = 160000;\n\nfunction fail(detail: string): never {\n  throw new TypeError(`createSdk config: view: ${detail}`);\n}\n\nconst BAND_KEYS = [\"full\", \"smooth\", \"detailed\", \"brief\"] as const;\n\n// A complete, merged profile validates whole: positive lower bound, finite\n// non-negative shares, shares summing to exactly 100. Errors name the\n// violated constraint and the profile (AC-2.3's vocabulary, applied at\n// construction).\nexport function validateProfile(profile: ViewProfile): void {\n  if (!Number.isFinite(profile.lowerBound) || profile.lowerBound <= 0) {\n    fail(\n      `profile \"${profile.name}\": lowerBound must be a positive number, got ${profile.lowerBound}`,\n    );\n  }\n  for (const key of BAND_KEYS) {\n    const share = profile.percentages[key];\n    if (!Number.isFinite(share) || share < 0) {\n      fail(`profile \"${profile.name}\": percentage ${key} must be a non-negative number, got ${share}`);\n    }\n  }\n  const sum = BAND_KEYS.reduce((total, key) => total + profile.percentages[key], 0);\n  if (sum !== 100) {\n    fail(`profile \"${profile.name}\": percentages must sum to 100, got ${sum}`);\n  }\n}\n\nfunction isCompleteOverride(entry: ViewProfileOverride): boolean {\n  return (\n    entry.lowerBound !== undefined &&\n    entry.percentages !== undefined &&\n    BAND_KEYS.every((key) => entry.percentages?.[key] !== undefined)\n  );\n}\n\n// Merge one configured entry: field-wise over the built-in it names, or — for\n// a name no built-in carries — the entry must be complete, since there is\n// nothing to merge over (FC-0.2's unknown-built-in-override-target violation).\nfunction mergeProfile(entry: ViewProfileOverride, base: ViewProfile | undefined): ViewProfile {\n  if (base === undefined) {\n    if (!isCompleteOverride(entry)) {\n      fail(\n        `profile \"${entry.name}\" is partial but overrides no built-in (unknown built-in override target); built-ins are ${BUILT_IN_PROFILES.map((p) => `\"${p.name}\"`).join(\", \")} — a new profile must carry lowerBound and all four percentages`,\n      );\n    }\n    return {\n      name: entry.name,\n      lowerBound: entry.lowerBound as number,\n      percentages: {\n        full: entry.percentages?.full as number,\n        smooth: entry.percentages?.smooth as number,\n        detailed: entry.percentages?.detailed as number,\n        brief: entry.percentages?.brief as number,\n      },\n    };\n  }\n  return {\n    name: entry.name,\n    lowerBound: entry.lowerBound ?? base.lowerBound,\n    percentages: {\n      full: entry.percentages?.full ?? base.percentages.full,\n      smooth: entry.percentages?.smooth ?? base.percentages.smooth,\n      detailed: entry.percentages?.detailed ?? base.percentages.detailed,\n      brief: entry.percentages?.brief ?? base.percentages.brief,\n    },\n  };\n}\n\nfunction resolveVisibility(partial: Partial<VisibilityBudgets> | undefined): VisibilityBudgets {\n  const visibility: VisibilityBudgets = {\n    maxTokens: partial?.maxTokens ?? DEFAULT_VISIBILITY.maxTokens,\n    targetTokens: partial?.targetTokens ?? DEFAULT_VISIBILITY.targetTokens,\n    floorTokens: partial?.floorTokens ?? DEFAULT_VISIBILITY.floorTokens,\n  };\n  for (const key of [\"maxTokens\", \"targetTokens\", \"floorTokens\"] as const) {\n    if (!Number.isFinite(visibility[key]) || visibility[key] <= 0) {\n      fail(`visibility.${key} must be a positive number, got ${visibility[key]}`);\n    }\n  }\n  // The budget ordering rule (AC-4.8): max > target ≥ floor.\n  if (visibility.maxTokens <= visibility.targetTokens) {\n    fail(\n      `visibility.maxTokens (${visibility.maxTokens}) must be greater than targetTokens (${visibility.targetTokens})`,\n    );\n  }\n  if (visibility.targetTokens < visibility.floorTokens) {\n    fail(\n      `visibility.targetTokens (${visibility.targetTokens}) must be at least floorTokens (${visibility.floorTokens})`,\n    );\n  }\n  return visibility;\n}\n\n// The one resolution path: built-ins, user profiles merged by name, every\n// resolved profile validated, visibility and threshold defaulted and checked.\n// Called from createSdk so validation runs through real construction, never a\n// standalone validator (Story 0 production-path proof).\nexport function resolveViewConfig(config?: SdkViewConfig): ResolvedViewConfig {\n  const profiles: Record<string, ViewProfile> = {};\n  for (const builtIn of BUILT_IN_PROFILES) {\n    profiles[builtIn.name] = builtIn;\n  }\n  for (const entry of config?.profiles ?? []) {\n    if (typeof entry.name !== \"string\" || entry.name.length === 0) {\n      fail(`profile entries must carry a non-empty name`);\n    }\n    profiles[entry.name] = mergeProfile(entry, profiles[entry.name]);\n  }\n  for (const profile of Object.values(profiles)) {\n    validateProfile(profile);\n  }\n\n  const compactThreshold = config?.compactThreshold ?? DEFAULT_COMPACT_THRESHOLD;\n  if (!Number.isFinite(compactThreshold) || compactThreshold <= 0) {\n    fail(`compactThreshold must be a positive number, got ${compactThreshold}`);\n  }\n\n  return {\n    profiles,\n    visibility: resolveVisibility(config?.visibility),\n    compactThreshold,\n  };\n}\n","numLines":167,"startLine":1,"totalLines":167}}}

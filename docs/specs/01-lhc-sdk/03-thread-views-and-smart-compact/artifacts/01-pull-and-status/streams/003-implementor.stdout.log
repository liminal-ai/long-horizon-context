{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJmDDyveYUCwqEywUijhAY","type":"tool_result","content":"1\t// Message and block row operations. Writes run on the caller's handle inside\n2\t// the batch transaction (insert failures propagate so the pipeline rejects\n3\t// the whole batch); reads run on a fresh handle per operation. The mutation\n4\t// half (Epic 02 Story 5) — the edit's validation read and content apply —\n5\t// also lives here: row-level mechanics, no policy.\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n8\timport type { Block, MessageRecord } from \"../index.js\";\n9\t\n10\texport interface MessageRow {\n11\t  messageId: string;\n12\t  sourceEventOrder: number;\n13\t  kind: MessageRecord[\"kind\"];\n14\t  tokenEstimate: number;\n15\t  actor: string;\n16\t  harness: string;\n17\t  // Membership stamp, settled at intake: the turn open after this event's\n18\t  // transition, or null in a gap. Written once here, never updated — a null\n19\t  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n20\t  // change (AC-3.7).\n21\t  turnId: string | null;\n22\t  blocks: Block[];\n23\t}\n24\t\n25\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n26\t  db.prepare(\n27\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n28\t     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n29\t  ).run(\n30\t    row.messageId,\n31\t    row.sourceEventOrder,\n32\t    row.kind,\n33\t    row.tokenEstimate,\n34\t    row.actor,\n35\t    row.harness,\n36\t    row.turnId,\n37\t  );\n38\t\n39\t  const insertBlock = db.prepare(\n40\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\n41\t     VALUES (?, ?, ?, ?)`,\n42\t  );\n43\t  for (const [index, block] of row.blocks.entries()) {\n44\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n45\t  }\n46\t}\n47\t\n48\t// The mutation operations' validation read (Flows 5/6): the live\n49\t// (deleted-filtered) message joined to its turn's status. A deleted target\n50\t// misses here and refuses as message_not_found — the filtered view is the\n51\t// refusal's read by design (never a distinct error for deleted; double\n52\t// delete reads the same way, AC-6.7). turnStatus is null for a gap message\n53\t// (no membership); the closed-turn target boundary refuses it the same as\n54\t// an open turn. initiatesTurn carries the prompt-protection fact (AC-6.3):\n55\t// a turn opens on its prompt's event, so the member whose source event\n56\t// order equals the turn's opened-at order is the turn's initiating prompt.\n57\texport interface MutableMessageView {\n58\t  messageId: string;\n59\t  kind: string;\n60\t  turnId: string | null;\n61\t  turnStatus: \"open\" | \"closed\" | null;\n62\t  initiatesTurn: boolean;\n63\t}\n64\t\n65\texport function readMutableMessage(\n66\t  db: DatabaseSync,\n67\t  messageId: string,\n68\t): MutableMessageView | undefined {\n69\t  const row = db\n70\t    .prepare(\n71\t      `SELECT m.message_id, m.kind, m.turn_id, m.source_event_order,\n72\t              t.status AS turn_status, t.opened_at_event_order\n73\t       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\n74\t       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\n75\t    )\n76\t    .get(messageId) as unknown as\n77\t    | {\n78\t        message_id: string;\n79\t        kind: string;\n80\t        turn_id: string | null;\n81\t        source_event_order: number | bigint;\n82\t        turn_status: string | null;\n83\t        opened_at_event_order: number | bigint | null;\n84\t      }\n85\t    | undefined;\n86\t  if (row === undefined) return undefined;\n87\t  return {\n88\t    messageId: row.message_id,\n89\t    kind: row.kind,\n90\t    turnId: row.turn_id,\n91\t    turnStatus: row.turn_status as MutableMessageView[\"turnStatus\"],\n92\t    initiatesTurn:\n93\t      row.opened_at_event_order !== null &&\n94\t      Number(row.source_event_order) === Number(row.opened_at_event_order),\n95\t  };\n96\t}\n97\t\n98\t// The delete's record apply (Flow 6): a projection-level tombstone — the\n99\t// deleted_at stamp every read filters on. The source events are never\n100\t// touched (record-never-destroyed, DD-12); event read-back keeps showing\n101\t// them. The bulk variant is turns.deleteTurn's member stamp, scoped to live\n102\t// rows so a turn whose messages were individually deleted first still\n103\t// deletes cleanly (membership walk on live rows); it returns the stamped\n104\t// ids in record order for the mutation result and the cascade's drop set.\n105\texport function markMessageDeleted(\n106\t  db: DatabaseSync,\n107\t  messageId: string,\n108\t  deletedAt: string,\n109\t): void {\n110\t  db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = ?`).run(\n111\t    deletedAt,\n112\t    messageId,\n113\t  );\n114\t}\n115\t\n116\texport function markTurnMessagesDeleted(\n117\t  db: DatabaseSync,\n118\t  turnId: string,\n119\t  deletedAt: string,\n120\t): string[] {\n121\t  const rows = db\n122\t    .prepare(\n123\t      `UPDATE message SET deleted_at = ?\n124\t       WHERE turn_id = ? AND deleted_at IS NULL\n125\t       RETURNING message_id, source_event_order`,\n126\t    )\n127\t    .all(deletedAt, turnId) as unknown as Array<{\n128\t    message_id: string;\n129\t    source_event_order: number | bigint;\n130\t  }>;\n131\t  return rows\n132\t    .sort((a, b) => Number(a.source_event_order) - Number(b.source_event_order))\n133\t    .map((row) => row.message_id);\n134\t}\n135\t\n136\t// The edit's record apply (AC-5.1): the new content lands in each block's\n137\t// content-bearing field — the same field per block type the projection wrote\n138\t// and counted (internal/project.ts) — and the token estimate re-stamps from\n139\t// the same estimator, so placement arithmetic stays current after edits.\n140\t// Events are untouched: this is projection-level mutation; the log keeps the\n141\t// original (DD-12).\n142\texport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\n143\t  const blocks = db\n144\t    .prepare(\n145\t      `SELECT block_index, block_type, content FROM message_block\n146\t       WHERE message_id = ? ORDER BY block_index`,\n147\t    )\n148\t    .all(messageId) as unknown as Array<{\n149\t    block_index: number | bigint;\n150\t    block_type: string;\n151\t    content: string;\n152\t  }>;\n153\t  const update = db.prepare(\n154\t    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\n155\t  );\n156\t  let tokenEstimate = estimateTokens(content);\n157\t  for (const block of blocks) {\n158\t    const parsed = JSON.parse(block.content) as Record<string, unknown>;\n159\t    switch (block.block_type) {\n160\t      case \"text\":\n161\t        parsed[\"text\"] = content;\n162\t        break;\n163\t      case \"tool_result\":\n164\t        parsed[\"content\"] = content;\n165\t        break;\n166\t      case \"tool_call\":\n167\t        // Arguments are the call's counted content; the edit's string lands\n168\t        // verbatim as the new arguments value, mirroring projection's\n169\t        // serialized-arguments estimate.\n170\t        parsed[\"arguments\"] = content;\n171\t        tokenEstimate = estimateTokens(JSON.stringify(content));\n172\t        break;\n173\t      default:\n174\t        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\n175\t    }\n176\t    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\n177\t  }\n178\t  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\n179\t    tokenEstimate,\n180\t    messageId,\n181\t  );\n182\t}\n183\t\n184\tinterface RawMessageRow {\n185\t  message_id: string;\n186\t  source_event_order: number | bigint;\n187\t  kind: string;\n188\t  token_estimate: number | bigint;\n189\t  actor: string;\n190\t  harness: string;\n191\t  turn_id: string | null;\n192\t}\n193\t\n194\tinterface RawBlockRow {\n195\t  message_id: string;\n196\t  block_type: string;\n197\t  content: string;\n198\t}\n199\t\n200\texport function readMessages(db: DatabaseSync): MessageRecord[] {\n201\t  const blockRows = db\n202\t    .prepare(\n203\t      `SELECT message_id, block_type, content FROM message_block\n204\t       ORDER BY message_id, block_index`,\n205\t    )\n206\t    .all() as unknown as RawBlockRow[];\n207\t  const blocksByMessage = new Map<string, Block[]>();\n208\t  for (const row of blockRows) {\n209\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n210\t    blocks.push({\n211\t      blockType: row.block_type as Block[\"blockType\"],\n212\t      content: JSON.parse(row.content) as Record<string, unknown>,\n213\t    });\n214\t    blocksByMessage.set(row.message_id, blocks);\n215\t  }\n216\t\n217\t  // The deleted-read filter (tech design §Mechanics): message reads surface\n218\t  // live projection rows only; a deleted message's source events stay\n219\t  // readable through the Epic 01 event read-back, the one unfiltered surface.\n220\t  const messageRows = db\n221\t    .prepare(\n222\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n223\t       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\n224\t    )\n225\t    .all() as unknown as RawMessageRow[];\n226\t  return messageRows.map((row) => {\n227\t    const record: MessageRecord = {\n228\t      messageId: row.message_id,\n229\t      sourceEventOrder: Number(row.source_event_order),\n230\t      kind: row.kind as MessageRecord[\"kind\"],\n231\t      blocks: blocksByMessage.get(row.message_id) ?? [],\n232\t      tokenEstimate: Number(row.token_estimate),\n233\t      actor: row.actor,\n234\t      harness: row.harness,\n235\t    };\n236\t    if (row.turn_id !== null) record.turnId = row.turn_id;\n237\t    return record;\n238\t  });\n239\t}\n240\t"}]},"parent_tool_use_id":null,"session_id":"28aec8fc-3297-4f03-8488-65ebfbadd697","uuid":"7db329db-ac83-4600-a3f8-421379f0c7b0","timestamp":"2026-06-11T14:38:59.304Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/store.ts","content":"// Message and block row operations. Writes run on the caller's handle inside\n// the batch transaction (insert failures propagate so the pipeline rejects\n// the whole batch); reads run on a fresh handle per operation. The mutation\n// half (Epic 02 Story 5) — the edit's validation read and content apply —\n// also lives here: row-level mechanics, no policy.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\nimport type { Block, MessageRecord } from \"../index.js\";\n\nexport interface MessageRow {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: MessageRecord[\"kind\"];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  // Membership stamp, settled at intake: the turn open after this event's\n  // transition, or null in a gap. Written once here, never updated — a null\n  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n  // change (AC-3.7).\n  turnId: string | null;\n  blocks: Block[];\n}\n\nexport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n  db.prepare(\n    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n  ).run(\n    row.messageId,\n    row.sourceEventOrder,\n    row.kind,\n    row.tokenEstimate,\n    row.actor,\n    row.harness,\n    row.turnId,\n  );\n\n  const insertBlock = db.prepare(\n    `INSERT INTO message_block (message_id, block_index, block_type, content)\n     VALUES (?, ?, ?, ?)`,\n  );\n  for (const [index, block] of row.blocks.entries()) {\n    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n  }\n}\n\n// The mutation operations' validation read (Flows 5/6): the live\n// (deleted-filtered) message joined to its turn's status. A deleted target\n// misses here and refuses as message_not_found — the filtered view is the\n// refusal's read by design (never a distinct error for deleted; double\n// delete reads the same way, AC-6.7). turnStatus is null for a gap message\n// (no membership); the closed-turn target boundary refuses it the same as\n// an open turn. initiatesTurn carries the prompt-protection fact (AC-6.3):\n// a turn opens on its prompt's event, so the member whose source event\n// order equals the turn's opened-at order is the turn's initiating prompt.\nexport interface MutableMessageView {\n  messageId: string;\n  kind: string;\n  turnId: string | null;\n  turnStatus: \"open\" | \"closed\" | null;\n  initiatesTurn: boolean;\n}\n\nexport function readMutableMessage(\n  db: DatabaseSync,\n  messageId: string,\n): MutableMessageView | undefined {\n  const row = db\n    .prepare(\n      `SELECT m.message_id, m.kind, m.turn_id, m.source_event_order,\n              t.status AS turn_status, t.opened_at_event_order\n       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\n       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\n    )\n    .get(messageId) as unknown as\n    | {\n        message_id: string;\n        kind: string;\n        turn_id: string | null;\n        source_event_order: number | bigint;\n        turn_status: string | null;\n        opened_at_event_order: number | bigint | null;\n      }\n    | undefined;\n  if (row === undefined) return undefined;\n  return {\n    messageId: row.message_id,\n    kind: row.kind,\n    turnId: row.turn_id,\n    turnStatus: row.turn_status as MutableMessageView[\"turnStatus\"],\n    initiatesTurn:\n      row.opened_at_event_order !== null &&\n      Number(row.source_event_order) === Number(row.opened_at_event_order),\n  };\n}\n\n// The delete's record apply (Flow 6): a projection-level tombstone — the\n// deleted_at stamp every read filters on. The source events are never\n// touched (record-never-destroyed, DD-12); event read-back keeps showing\n// them. The bulk variant is turns.deleteTurn's member stamp, scoped to live\n// rows so a turn whose messages were individually deleted first still\n// deletes cleanly (membership walk on live rows); it returns the stamped\n// ids in record order for the mutation result and the cascade's drop set.\nexport function markMessageDeleted(\n  db: DatabaseSync,\n  messageId: string,\n  deletedAt: string,\n): void {\n  db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = ?`).run(\n    deletedAt,\n    messageId,\n  );\n}\n\nexport function markTurnMessagesDeleted(\n  db: DatabaseSync,\n  turnId: string,\n  deletedAt: string,\n): string[] {\n  const rows = db\n    .prepare(\n      `UPDATE message SET deleted_at = ?\n       WHERE turn_id = ? AND deleted_at IS NULL\n       RETURNING message_id, source_event_order`,\n    )\n    .all(deletedAt, turnId) as unknown as Array<{\n    message_id: string;\n    source_event_order: number | bigint;\n  }>;\n  return rows\n    .sort((a, b) => Number(a.source_event_order) - Number(b.source_event_order))\n    .map((row) => row.message_id);\n}\n\n// The edit's record apply (AC-5.1): the new content lands in each block's\n// content-bearing field — the same field per block type the projection wrote\n// and counted (internal/project.ts) — and the token estimate re-stamps from\n// the same estimator, so placement arithmetic stays current after edits.\n// Events are untouched: this is projection-level mutation; the log keeps the\n// original (DD-12).\nexport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\n  const blocks = db\n    .prepare(\n      `SELECT block_index, block_type, content FROM message_block\n       WHERE message_id = ? ORDER BY block_index`,\n    )\n    .all(messageId) as unknown as Array<{\n    block_index: number | bigint;\n    block_type: string;\n    content: string;\n  }>;\n  const update = db.prepare(\n    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\n  );\n  let tokenEstimate = estimateTokens(content);\n  for (const block of blocks) {\n    const parsed = JSON.parse(block.content) as Record<string, unknown>;\n    switch (block.block_type) {\n      case \"text\":\n        parsed[\"text\"] = content;\n        break;\n      case \"tool_result\":\n        parsed[\"content\"] = content;\n        break;\n      case \"tool_call\":\n        // Arguments are the call's counted content; the edit's string lands\n        // verbatim as the new arguments value, mirroring projection's\n        // serialized-arguments estimate.\n        parsed[\"arguments\"] = content;\n        tokenEstimate = estimateTokens(JSON.stringify(content));\n        break;\n      default:\n        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\n    }\n    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\n  }\n  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\n    tokenEstimate,\n    messageId,\n  );\n}\n\ninterface RawMessageRow {\n  message_id: string;\n  source_event_order: number | bigint;\n  kind: string;\n  token_estimate: number | bigint;\n  actor: string;\n  harness: string;\n  turn_id: string | null;\n}\n\ninterface RawBlockRow {\n  message_id: string;\n  block_type: string;\n  content: string;\n}\n\nexport function readMessages(db: DatabaseSync): MessageRecord[] {\n  const blockRows = db\n    .prepare(\n      `SELECT message_id, block_type, content FROM message_block\n       ORDER BY message_id, block_index`,\n    )\n    .all() as unknown as RawBlockRow[];\n  const blocksByMessage = new Map<string, Block[]>();\n  for (const row of blockRows) {\n    const blocks = blocksByMessage.get(row.message_id) ?? [];\n    blocks.push({\n      blockType: row.block_type as Block[\"blockType\"],\n      content: JSON.parse(row.content) as Record<string, unknown>,\n    });\n    blocksByMessage.set(row.message_id, blocks);\n  }\n\n  // The deleted-read filter (tech design §Mechanics): message reads surface\n  // live projection rows only; a deleted message's source events stay\n  // readable through the Epic 01 event read-back, the one unfiltered surface.\n  const messageRows = db\n    .prepare(\n      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\n    )\n    .all() as unknown as RawMessageRow[];\n  return messageRows.map((row) => {\n    const record: MessageRecord = {\n      messageId: row.message_id,\n      sourceEventOrder: Number(row.source_event_order),\n      kind: row.kind as MessageRecord[\"kind\"],\n      blocks: blocksByMessage.get(row.message_id) ?? [],\n      tokenEstimate: Number(row.token_estimate),\n      actor: row.actor,\n      harness: row.harness,\n    };\n    if (row.turn_id !== null) record.turnId = row.turn_id;\n    return record;\n  });\n}\n","numLines":240,"startLine":1,"totalLines":240}}}

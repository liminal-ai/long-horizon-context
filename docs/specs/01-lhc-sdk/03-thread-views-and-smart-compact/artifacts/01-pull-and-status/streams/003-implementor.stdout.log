{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UE8AFb743eygfYvRFLos58","type":"tool_result","content":"1\timport { AsyncLocalStorage } from \"node:async_hooks\";\n2\timport type { DatabaseSync } from \"node:sqlite\";\n3\t\n4\texport interface OperationContext {\n5\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n6\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n7\t  threadId: string; // resolved identity of the thread being operated on\n8\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n9\t  // the registered callbacks after its COMMIT succeeds and drops them on\n10\t  // rollback, so anything registered here — the scheduler poke above all —\n11\t  // is transactional by construction.\n12\t  onCommit: (fn: () => void) => void;\n13\t  // The scheduler poke for the SDK instance whose operation is running (DD-5,\n14\t  // epic-fix-001): enqueue registers its onCommit poke against THIS, carried\n15\t  // on the context, never a shared module slot. Resolved from the per-SDK\n16\t  // seam in scope (background → its own scheduler; manual → a no-op), falling\n17\t  // back to the below-SDK default seam only for direct domain calls with no\n18\t  // SDK around. A manual SDK therefore never auto-drains even with a\n19\t  // background SDK alive in the same process.\n20\t  poke: (threadId: string) => void;\n21\t}\n22\t\n23\t// The callback list behind ctx.onCommit, owned by whoever owns the\n24\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n25\t// dropping the hooks is simply not flushing them.\n26\texport interface CommitHooks {\n27\t  register: (fn: () => void) => void;\n28\t  flush: () => void;\n29\t}\n30\t\n31\texport function createCommitHooks(): CommitHooks {\n32\t  const callbacks: Array<() => void> = [];\n33\t  return {\n34\t    register: (fn) => {\n35\t      callbacks.push(fn);\n36\t    },\n37\t    flush: () => {\n38\t      for (const fn of callbacks.splice(0)) fn();\n39\t    },\n40\t  };\n41\t}\n42\t\n43\t// Per-SDK-instance delivery seam (DD-5/DD-10, epic-fix-001). Each SDK runs\n44\t// every one of its operations inside runWithInstanceSeam, so the code reached\n45\t// deep inside — enqueue's poke and openThreadDatabase's touch — delivers to\n46\t// THAT SDK's scheduler (background) or to a no-op (manual), isolated from any\n47\t// other SDK in the process. Carried through async-context, not a mutable\n48\t// module slot two SDKs would share: that sharing was the bug — a manual SDK\n49\t// auto-drained because a background SDK had overwritten the global slot.\n50\texport interface InstanceSeam {\n51\t  poke: (threadId: string) => void;\n52\t  touch: (filePath: string, db: DatabaseSync) => void;\n53\t}\n54\tconst seamStore = new AsyncLocalStorage<InstanceSeam>();\n55\t\n56\texport function runWithInstanceSeam<T>(seam: InstanceSeam, fn: () => T): T {\n57\t  return seamStore.run(seam, fn);\n58\t}\n59\t\n60\t// The below-SDK default seam (the former module-global poke/touch slots),\n61\t// kept ONLY as the fallback for direct domain calls made with no SDK seam in\n62\t// scope: the enqueue-atomicity tests that drive enqueue/runInTransaction\n63\t// directly, and the single-background \"production path\" where a top-level\n64\t// mutation still reaches the one installed scheduler. A background SDK\n65\t// installs itself here at construction; a manual SDK leaves it alone AND\n66\t// scopes its own operations to a no-op seam, so the fallback can never\n67\t// auto-drain a manual SDK's queued work.\n68\ttype SchedulerPoke = (threadId: string) => void;\n69\tlet schedulerPoke: SchedulerPoke | null = null;\n70\t\n71\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n72\t  schedulerPoke = poke;\n73\t}\n74\t\n75\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n76\tlet threadTouch: ThreadTouch | null = null;\n77\t\n78\texport function setThreadTouch(touch: ThreadTouch | null): void {\n79\t  threadTouch = touch;\n80\t}\n81\t\n82\t// The poke target for a context built now: the running SDK's seam if one is\n83\t// in scope, else the below-SDK default (null-safe). Captured onto ctx.poke so\n84\t// the enqueue carries its target rather than reading a shared slot at fire\n85\t// time — except, deliberately, through the default fallback for direct calls.\n86\texport function resolveInstancePoke(): (threadId: string) => void {\n87\t  const seam = seamStore.getStore();\n88\t  if (seam !== undefined) return seam.poke;\n89\t  return (threadId) => {\n90\t    schedulerPoke?.(threadId);\n91\t  };\n92\t}\n93\t\n94\t// Thread-file open announcement (DD-10): openThreadDatabase fires this on\n95\t// every open, before any caller transaction begins. Delivers to the SDK seam\n96\t// in scope if any (background → first-touch catch-up; manual → no-op), else\n97\t// the below-SDK default. The background scheduler learns threadId→filePath\n98\t// and runs the first-touch catch-up off this seam.\n99\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n100\t  const seam = seamStore.getStore();\n101\t  if (seam !== undefined) {\n102\t    seam.touch(filePath, db);\n103\t    return;\n104\t  }\n105\t  threadTouch?.(filePath, db);\n106\t}\n107\t\n108\t// Transaction owner for operations outside the intake pipeline (mutations,\n109\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n110\t// body with a context whose onCommit registrations flush only after COMMIT\n111\t// succeeds and drop whole on rollback.\n112\texport function runInTransaction<T>(\n113\t  db: DatabaseSync,\n114\t  clock: () => Date,\n115\t  threadId: string,\n116\t  fn: (ctx: OperationContext) => T,\n117\t): T {\n118\t  const hooks = createCommitHooks();\n119\t  const poke = resolveInstancePoke();\n120\t  db.exec(\"BEGIN IMMEDIATE;\");\n121\t  let value: T;\n122\t  try {\n123\t    value = fn({ db, clock, threadId, onCommit: hooks.register, poke });\n124\t    db.exec(\"COMMIT;\");\n125\t  } catch (cause) {\n126\t    db.exec(\"ROLLBACK;\");\n127\t    throw cause;\n128\t  }\n129\t  hooks.flush();\n130\t  return value;\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"28aec8fc-3297-4f03-8488-65ebfbadd697","uuid":"c80d2f8b-e352-4aa6-b264-0664fd803540","timestamp":"2026-06-11T14:41:11.499Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/context.ts","content":"import { AsyncLocalStorage } from \"node:async_hooks\";\nimport type { DatabaseSync } from \"node:sqlite\";\n\nexport interface OperationContext {\n  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n  threadId: string; // resolved identity of the thread being operated on\n  // Post-commit callback registration (DD-5): the transaction owner flushes\n  // the registered callbacks after its COMMIT succeeds and drops them on\n  // rollback, so anything registered here — the scheduler poke above all —\n  // is transactional by construction.\n  onCommit: (fn: () => void) => void;\n  // The scheduler poke for the SDK instance whose operation is running (DD-5,\n  // epic-fix-001): enqueue registers its onCommit poke against THIS, carried\n  // on the context, never a shared module slot. Resolved from the per-SDK\n  // seam in scope (background → its own scheduler; manual → a no-op), falling\n  // back to the below-SDK default seam only for direct domain calls with no\n  // SDK around. A manual SDK therefore never auto-drains even with a\n  // background SDK alive in the same process.\n  poke: (threadId: string) => void;\n}\n\n// The callback list behind ctx.onCommit, owned by whoever owns the\n// transaction. Flush after COMMIT; never call flush on a rollback path —\n// dropping the hooks is simply not flushing them.\nexport interface CommitHooks {\n  register: (fn: () => void) => void;\n  flush: () => void;\n}\n\nexport function createCommitHooks(): CommitHooks {\n  const callbacks: Array<() => void> = [];\n  return {\n    register: (fn) => {\n      callbacks.push(fn);\n    },\n    flush: () => {\n      for (const fn of callbacks.splice(0)) fn();\n    },\n  };\n}\n\n// Per-SDK-instance delivery seam (DD-5/DD-10, epic-fix-001). Each SDK runs\n// every one of its operations inside runWithInstanceSeam, so the code reached\n// deep inside — enqueue's poke and openThreadDatabase's touch — delivers to\n// THAT SDK's scheduler (background) or to a no-op (manual), isolated from any\n// other SDK in the process. Carried through async-context, not a mutable\n// module slot two SDKs would share: that sharing was the bug — a manual SDK\n// auto-drained because a background SDK had overwritten the global slot.\nexport interface InstanceSeam {\n  poke: (threadId: string) => void;\n  touch: (filePath: string, db: DatabaseSync) => void;\n}\nconst seamStore = new AsyncLocalStorage<InstanceSeam>();\n\nexport function runWithInstanceSeam<T>(seam: InstanceSeam, fn: () => T): T {\n  return seamStore.run(seam, fn);\n}\n\n// The below-SDK default seam (the former module-global poke/touch slots),\n// kept ONLY as the fallback for direct domain calls made with no SDK seam in\n// scope: the enqueue-atomicity tests that drive enqueue/runInTransaction\n// directly, and the single-background \"production path\" where a top-level\n// mutation still reaches the one installed scheduler. A background SDK\n// installs itself here at construction; a manual SDK leaves it alone AND\n// scopes its own operations to a no-op seam, so the fallback can never\n// auto-drain a manual SDK's queued work.\ntype SchedulerPoke = (threadId: string) => void;\nlet schedulerPoke: SchedulerPoke | null = null;\n\nexport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n  schedulerPoke = poke;\n}\n\ntype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\nlet threadTouch: ThreadTouch | null = null;\n\nexport function setThreadTouch(touch: ThreadTouch | null): void {\n  threadTouch = touch;\n}\n\n// The poke target for a context built now: the running SDK's seam if one is\n// in scope, else the below-SDK default (null-safe). Captured onto ctx.poke so\n// the enqueue carries its target rather than reading a shared slot at fire\n// time — except, deliberately, through the default fallback for direct calls.\nexport function resolveInstancePoke(): (threadId: string) => void {\n  const seam = seamStore.getStore();\n  if (seam !== undefined) return seam.poke;\n  return (threadId) => {\n    schedulerPoke?.(threadId);\n  };\n}\n\n// Thread-file open announcement (DD-10): openThreadDatabase fires this on\n// every open, before any caller transaction begins. Delivers to the SDK seam\n// in scope if any (background → first-touch catch-up; manual → no-op), else\n// the below-SDK default. The background scheduler learns threadId→filePath\n// and runs the first-touch catch-up off this seam.\nexport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n  const seam = seamStore.getStore();\n  if (seam !== undefined) {\n    seam.touch(filePath, db);\n    return;\n  }\n  threadTouch?.(filePath, db);\n}\n\n// Transaction owner for operations outside the intake pipeline (mutations,\n// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n// body with a context whose onCommit registrations flush only after COMMIT\n// succeeds and drop whole on rollback.\nexport function runInTransaction<T>(\n  db: DatabaseSync,\n  clock: () => Date,\n  threadId: string,\n  fn: (ctx: OperationContext) => T,\n): T {\n  const hooks = createCommitHooks();\n  const poke = resolveInstancePoke();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  let value: T;\n  try {\n    value = fn({ db, clock, threadId, onCommit: hooks.register, poke });\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n  hooks.flush();\n  return value;\n}\n","numLines":132,"startLine":1,"totalLines":132}}}

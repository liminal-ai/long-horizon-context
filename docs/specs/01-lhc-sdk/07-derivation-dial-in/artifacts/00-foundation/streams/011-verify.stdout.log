{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/scripts/check-boundaries.mjs | sed -n '1,230p'\"","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Zero-dependency import-boundary check for the flat src/ layout (Epic 07\n     3\t// Story 0): the six domains are direct children of src/, and all non-domain\n     4\t// technical infrastructure lives under one src/shared-tech/ area.\n     5\t// Rules (AC-0.6, tech design §Import Boundary Rules):\n     6\t//   1. src/shared-tech/** may not import from any domain folder.\n     7\t//   2. A domain may import another domain's internal/ modules only from within\n     8\t//      that same domain — cross-domain internal access is forbidden.\n     9\t//   3. A domain may import another domain's surface (its index.ts / public\n    10\t//      files) only along an edge pinned in ALLOWED_SURFACE_IMPORTS below — a\n    11\t//      new cross-domain edge is a conscious decision, never a silent pass.\n    12\t// Domains may freely import src/shared-tech/** (the shared technical area is a\n    13\t// dependency of every domain, never the reverse). The test fixtures directory\n    14\t// (test/fixtures/) is exempt by design — it is the one sanctioned below-SDK\n    15\t// writer.\n    16\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n    17\timport path from \"node:path\";\n    18\timport { fileURLToPath, pathToFileURL } from \"node:url\";\n    19\t\n    20\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    21\tconst srcRoot = path.join(pkgRoot, \"src\");\n    22\tconst testRoot = path.join(pkgRoot, \"test\");\n    23\tconst fixturesRoot = path.join(testRoot, \"fixtures\");\n    24\t\n    25\t// The six domain surfaces (AC-0.1): direct children of src/.\n    26\tconst DOMAINS = new Set([\n    27\t  \"intake-stream\",\n    28\t  \"messages\",\n    29\t  \"turns\",\n    30\t  \"threads\",\n    31\t  \"thread-view\",\n    32\t  \"inspect\",\n    33\t]);\n    34\tconst SHARED_TECH = \"shared-tech\";\n    35\t\n    36\tfunction collectTsFiles(dir, out = []) {\n    37\t  let entries;\n    38\t  try {\n    39\t    entries = readdirSync(dir);\n    40\t  } catch {\n    41\t    return out;\n    42\t  }\n    43\t  for (const entry of entries) {\n    44\t    const full = path.join(dir, entry);\n    45\t    if (full === fixturesRoot) continue; // fixtures exempt\n    46\t    if (statSync(full).isDirectory()) {\n    47\t      collectTsFiles(full, out);\n    48\t    } else if (full.endsWith(\".ts\")) {\n    49\t      out.push(full);\n    50\t    }\n    51\t  }\n    52\t  return out;\n    53\t}\n    54\t\n    55\tfunction importSpecifiers(source) {\n    56\t  const specs = [];\n    57\t  const patterns = [\n    58\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    59\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    60\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n    61\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n    62\t  ];\n    63\t  for (const re of patterns) {\n    64\t    let m;\n    65\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n    66\t  }\n    67\t  return specs;\n    68\t}\n    69\t\n    70\t// The domain a file belongs to, or null for src/shared-tech/**, src/sdk.ts, and\n    71\t// test files. With the domains/ wrapper gone, the domain is simply parts[0]\n    72\t// when it names one of the six surfaces.\n    73\tfunction domainOf(filePath) {\n    74\t  const rel = path.relative(srcRoot, filePath);\n    75\t  if (rel.startsWith(\"..\")) return null;\n    76\t  const parts = rel.split(path.sep);\n    77\t  if (parts.length > 0 && DOMAINS.has(parts[0])) return parts[0];\n    78\t  return null;\n    79\t}\n    80\t\n    81\tfunction isSharedTech(filePath) {\n    82\t  const rel = path.relative(srcRoot, filePath);\n    83\t  return !rel.startsWith(\"..\") && rel.split(path.sep)[0] === SHARED_TECH;\n    84\t}\n    85\t\n    86\t// The pinned domain-surface dependency edges (rule 3). Epic 03 adds two:\n    87\t// thread-view consumes the messages/turns report surfaces and the threads\n    88\t// resolver; intake-stream gains the thread-view surface for the boundary\n    89\t// advance registration (Flow 4).\n    90\t// SANCTIONED CYCLE (Epic 03 tech design §Module Boundaries): intake-stream →\n    91\t// thread-view → messages/turns → intake-stream (the last edges are type-only\n    92\t// event vocabulary). The domain graph is therefore deliberately not a DAG —\n    93\t// runtime-safe because the advance is registration-then-flush with no\n    94\t// import-time execution — so this check pins the allowed edge set instead of\n    95\t// asserting acyclicity.\n    96\tconst ALLOWED_SURFACE_IMPORTS = {\n    97\t  \"intake-stream\": new Set([\"threads\", \"messages\", \"turns\", \"thread-view\"]),\n    98\t  messages: new Set([\"threads\", \"intake-stream\"]),\n    99\t  turns: new Set([\"threads\", \"intake-stream\", \"messages\"]),\n   100\t  \"thread-view\": new Set([\"threads\", \"messages\", \"turns\"]),\n   101\t  threads: new Set(),\n   102\t  // Epic 04: inspect sits at the top of the graph — pure consumer of the\n   103\t  // five surfaces, nothing imports it except sdk.ts. Acyclic by\n   104\t  // construction.\n   105\t  inspect: new Set([\"threads\", \"intake-stream\", \"messages\", \"turns\", \"thread-view\"]),\n   106\t};\n   107\t\n   108\t// Epic 04 source check (tech design §Testing Strategy): inspect composes\n   109\t// other domains' SURFACES — it owns no tables and may not reach storage at\n   110\t// all. Any sqlite usage or SQL keyword over a known table name inside\n   111\t// src/inspect/** is a violation; a direct-SQL implementation could match\n   112\t// report output while violating inspect's entire contract.\n   113\tconst INSPECT_FORBIDDEN_PATTERNS = [\n   114\t  [/node:sqlite/, \"imports node:sqlite\"],\n   115\t  [/DatabaseSync/, \"references DatabaseSync\"],\n   116\t  [/\\.prepare\\s*\\(/, \"prepares a SQL statement\"],\n   117\t  [\n   118\t    /\\b(?:FROM|JOIN|INSERT\\s+INTO|UPDATE|DELETE\\s+FROM)\\s+(?:event|message|message_block|turns|chunk|chunk_member|work_item|derived_form|derivation|thread_metadata|thread_view|thread_view_band|view_boundary|log)\\b/i,\n   119\t    \"contains raw SQL over a domain table\",\n   120\t  ],\n   121\t];\n   122\t\n   123\tfunction inspectSourceViolations(file, source) {\n   124\t  const rel = path.relative(srcRoot, file);\n   125\t  if (!rel.startsWith(path.join(\"inspect\") + path.sep)) return [];\n   126\t  const found = [];\n   127\t  for (const [pattern, label] of INSPECT_FORBIDDEN_PATTERNS) {\n   128\t    if (pattern.test(source)) {\n   129\t      found.push(`${path.relative(pkgRoot, file)} ${label} — inspect may not read storage`);\n   130\t    }\n   131\t  }\n   132\t  return found;\n   133\t}\n   134\t\n   135\t// Classify one file's source for boundary violations (rules 1–3 + the inspect\n   136\t// storage-ban). Exported so tests assert the rules directly with synthetic\n   137\t// (path, source) pairs — the path need not exist on disk; only its src/-relative\n   138\t// location and the source's import specifiers are read.\n   139\texport function checkSource(filePath, source) {\n   140\t  const violations = [];\n   141\t  violations.push(...inspectSourceViolations(filePath, source));\n   142\t  const fileDomain = domainOf(filePath);\n   143\t  const fileSharedTech = isSharedTech(filePath);\n   144\t\n   145\t  for (const spec of importSpecifiers(source)) {\n   146\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n   147\t    const resolved = path.resolve(path.dirname(filePath), spec);\n   148\t    const relToSrc = path.relative(srcRoot, resolved);\n   149\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n   150\t    const parts = relToSrc.split(path.sep);\n   151\t    const targetDomain = parts.length > 0 && DOMAINS.has(parts[0]) ? parts[0] : null;\n   152\t    if (targetDomain === null) continue; // imports into shared-tech/ (or elsewhere) are not a domain edge\n   153\t\n   154\t    // Rule 1: shared-tech may not import any domain (AC-0.6).\n   155\t    if (fileSharedTech) {\n   156\t      violations.push(\n   157\t        `${path.relative(pkgRoot, filePath)} imports ${spec} — shared-tech may not import domain \"${targetDomain}\" (AC-0.6)`,\n   158\t      );\n   159\t      continue;\n   160\t    }\n   161\t\n   162\t    // Rule 2: a domain may not reach into another domain's internal/ modules.\n   163\t    if (parts.includes(\"internal\") && fileDomain !== targetDomain) {\n   164\t      violations.push(\n   165\t        `${path.relative(pkgRoot, filePath)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n   166\t      );\n   167\t      continue;\n   168\t    }\n   169\t\n   170\t    // Rule 3: cross-domain surface imports only along a pinned edge.\n   171\t    if (!parts.includes(\"internal\") && fileDomain !== null && fileDomain !== targetDomain) {\n   172\t      const allowed = ALLOWED_SURFACE_IMPORTS[fileDomain];\n   173\t      if (allowed === undefined || !allowed.has(targetDomain)) {\n   174\t        violations.push(\n   175\t          `${path.relative(pkgRoot, filePath)} imports ${spec} — domain \"${fileDomain}\" has no pinned surface edge to \"${targetDomain}\" (rule 3)`,\n   176\t        );\n   177\t      }\n   178\t    }\n   179\t  }\n   180\t  return violations;\n   181\t}\n   182\t\n   183\t// Run only when executed directly (not when imported by a test).\n   184\tconst isMain =\n   185\t  process.argv[1] !== undefined &&\n   186\t  import.meta.url === pathToFileURL(process.argv[1]).href;\n   187\tif (isMain) {\n   188\t  const files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\n   189\t  const violations = [];\n   190\t  for (const file of files) violations.push(...checkSource(file, readFileSync(file, \"utf8\")));\n   191\t\n   192\t  if (violations.length > 0) {\n   193\t    console.error(\"boundary check FAILED:\");\n   194\t    for (const v of violations) console.error(`  - ${v}`);\n   195\t    process.exit(1);\n   196\t  }\n   197\t  console.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n   198\t}\n","exit_code":0,"status":"completed"}}

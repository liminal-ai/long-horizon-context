] = Object.keys(PROMPT_REGISTRY);\n    34\t\n    35\t// The default template per derivation type — the defaults an operator's first\n    36\t// config reaches for, and what test fixtures assign.\n    37\texport const DEFAULT_PROMPT_NAMES: Record<string, string> = {\n    38\t  smoothed_prompt: smoothingV1.name,\n    39\t  tool_result_summary: toolResultV1.name,\n    40\t  smooth_turn_compression: lowerBandV1.name,\n    41\t  chunk_summary_brief: chunkBriefV1.name,\n    42\t};\n","exit_code":0,"status":"completed"}}

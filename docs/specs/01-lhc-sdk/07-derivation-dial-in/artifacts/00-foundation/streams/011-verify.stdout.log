{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared-tech/inference-adapter.ts | sed -n '42,90p'\"","aggregated_output":"    42\t// `provider_failure` — the code Epic 02 has always landed on exhausted forms\n    43\t// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\n    44\t// with the failure kind named next; terminal kinds lead with the kind itself\n    45\t// and land failed immediately.\n    46\tfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\n    47\t  const { retryable } = FAILURE_CLASSIFICATION[kind];\n    48\t  const detail = message === \"\" ? kind : `${kind}: ${message}`;\n    49\t  return {\n    50\t    ok: false,\n    51\t    retryable,\n    52\t    reason: retryable ? `provider_failure: ${detail}` : detail,\n    53\t  };\n    54\t}\n    55\t\n    56\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\n    57\t  const callKind = async (kind: string, input: unknown): Promise<ProviderResult> => {\n    58\t    const assignment = config.assignments[kind];\n    59\t    if (assignment === undefined) {\n    60\t      return classifiedFailure(\n    61\t        \"invalid_request\",\n    62\t        `no assignment for derivation type \"${kind}\"`,\n    63\t      );\n    64\t    }\n    65\t    // Construction validated the name (AC-1.3); a miss here is registry\n    66\t    // drift after construction and is terminal, never retried into.\n    67\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\n    68\t    if (template === undefined) {\n    69\t      return classifiedFailure(\n    70\t        \"invalid_request\",\n    71\t        `prompt template \"${assignment.prompt}\" not in registry`,\n    72\t      );\n    73\t    }\n    74\t    const messages = template.render(input);\n    75\t    // safeCall contains the host (AC-3.3, DD-6): thrown exceptions arrive as\n    76\t    // structured `other` failures and a hung function loses the timeout race\n    77\t    // as `timeout` — both flow through the same classification below.\n    78\t    const result = await safeCall(\n    79\t      config.call,\n    80\t      { provider: assignment.provider, model: assignment.model, messages },\n    81\t      config.timeoutMs,\n    82\t    );\n    83\t    if (!result.ok) {\n    84\t      return classifiedFailure(result.kind, result.message);\n    85\t    }\n    86\t    // Shaping: surrounding whitespace never becomes derivation content — and a\n    87\t    // model that returned nothing but whitespace has not produced a\n    88\t    // derivation (AC-2.4): a classified retryable failure, never a ready\n    89\t    // derivation. `empty_output` is adapter-generated; hosts never return it.\n    90\t    const text = result.text.trim();\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared-tech/scheduler.ts | sed -n '1,80p'\"","aggregated_output":"     1\t// SDK-internal scheduler and drain (DD-4): the one component holding\n     2\t// cross-operation in-memory state. The drain loop lives here per the tech\n     3\t// design's placement — claim under BEGIN IMMEDIATE, dispatch through the\n     4\t// handler map with no open transaction (the provider call lives there),\n     5\t// complete in a second short transaction. Background mode adds per-thread\n     6\t// single-flight with pending-flag coalescing, post-commit pokes, first-touch\n     7\t// catch-up (DD-10), and drainSettled (issue 3). The in-memory state is\n     8\t// advisory only: cross-process safety comes from the durable lease alone, so\n     9\t// a fresh handle sees identical drain behavior — the queue is the rows.\n    10\timport { existsSync } from \"node:fs\";\n    11\timport {\n    12\t  clearTimeout as cancelTimer,\n    13\t  setImmediate as scheduleMacrotask,\n    14\t  setTimeout as scheduleTimer,\n    15\t} from \"node:timers\";\n    16\timport { DatabaseSync } from \"node:sqlite\";\n    17\timport type {\n    18\t  HandlerOutcome,\n    19\t  ResolvedSdkConfig,\n    20\t  WorkHandler,\n    21\t} from \"./derivation.js\";\n    22\timport { storageFailure, type ErrorResult, type OpResult } from \"./errors.js\";\n    23\timport {\n    24\t  claimNext,\n    25\t  complete,\n    26\t  countLiveItems,\n    27\t  failAttempt,\n    28\t  failTerminal,\n    29\t  type ClaimedWorkItem,\n    30\t  type WorkKind,\n    31\t  type WorkSourceRef,\n    32\t} from \"./work-queue/index.js\";\n    33\t\n    34\t// The type of the thread DB opener function, injected by SDK wiring to avoid\n    35\t// importing from the threads domain (AC-0.6: shared-tech may not import domains).\n    36\texport type ThreadDbOpener = (path: string) => OpResult<DatabaseSync>;\n    37\t\n    38\texport type SchedulerMode = \"background\" | \"manual\";\n    39\t\n    40\t// Report shape per tech design §Interfaces. `superseded` never appears here:\n    41\t// the cascade deletes superseded items and reports them on the mutation\n    42\t// result; a drain never sees them.\n    43\texport interface DrainReport {\n    44\t  ran: Array<{\n    45\t    workItemId: string;\n    46\t    kind: WorkKind;\n    47\t    sourceRef: WorkSourceRef;\n    48\t    disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\";\n    49\t    attempts: number;\n    50\t    reason?: string;\n    51\t  }>;\n    52\t  stoppedBecause: \"empty\" | \"in_flight\" | \"waiting\" | \"max_items\";\n    53\t  waitingUntil?: string; // head's eligible_at when stoppedBecause = \"waiting\"\n    54\t  remaining: number; // live items left behind the stop point\n    55\t}\n    56\t\n    57\texport interface DrainDeps {\n    58\t  lookupHandler: (kind: string) => OpResult<WorkHandler>;\n    59\t  // Whether any handler is registered at all. Background scheduling is gated\n    60\t  // on this, fail-closed: with an empty map a background drain could only\n    61\t  // turn queued rows into failed_terminal — destruction, not processing — so\n    62\t  // pokes and catch-up stay inert until a handler table is populated\n    63\t  // (Stories 2–3 in production; explicit registration in tests).\n    64\t  hasAnyHandler: () => boolean;\n    65\t  config: ResolvedSdkConfig;\n    66\t  // The thread DB opener, injected by SDK wiring to avoid importing from the\n    67\t  // threads domain (AC-0.6: shared-tech may not import domains).\n    68\t  openThreadDatabase: ThreadDbOpener;\n    69\t}\n    70\t\n    71\tfunction ranEntry(\n    72\t  item: ClaimedWorkItem,\n    73\t  disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\",\n    74\t  attempts: number,\n    75\t  reason?: string,\n    76\t): DrainReport[\"ran\"][number] {\n    77\t  const entry: DrainReport[\"ran\"][number] = {\n    78\t    workItemId: item.workItemId,\n    79\t    kind: item.kind as WorkKind,\n    80\t    sourceRef: item.sourceRef,\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared-tech/storage.ts | sed -n '1,230p'\"","aggregated_output":"     1\timport { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface Migration {\n     4\t  version: number; // 1-based, strictly increasing\n     5\t  statements: readonly string[];\n     6\t}\n     7\t\n     8\tconst databasePaths = new WeakMap<DatabaseSync, string>();\n     9\t\n    10\texport function openDatabase(path: string): DatabaseSync {\n    11\t  const db = new DatabaseSync(path);\n    12\t  databasePaths.set(db, path);\n    13\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n    14\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n    15\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n    16\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n    17\t  return db;\n    18\t}\n    19\t\n    20\texport function databasePathFor(db: DatabaseSync): string | undefined {\n    21\t  return databasePaths.get(db);\n    22\t}\n    23\t\n    24\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\n    25\t// on the existing work_item table, the derivation state table, the chunk\n    26\t// tables, and the projection-level delete stamps. The whole epic's schema\n    27\t// lands in one version — behavior arrives story by story. Assembled into the\n    28\t// thread-file migration history by threads/internal/create.ts.\n    29\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n    30\t  // claim mechanics on the existing table (DD-1: no disposition column —\n    31\t  // queue rows are live work only; terminal rows are deleted and their\n    32\t  // outcomes reported in-memory; durable outcome state lives on derivation)\n    33\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n    34\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n    35\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n    36\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n    37\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n    38\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n    39\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n    40\t  // inside an index definition, so the index covers the two real columns and\n    41\t  // claimNext's ORDER BY rowid walks the head as before.\n    42\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n    43\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n    44\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\n    45\t  // call id — never a block scan (anti-shim requirement).\n    46\t  `CREATE INDEX idx_message_block_tool_call_id\n    47\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n    48\t  `CREATE TABLE derived_form (\n    49\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    50\t    subject_id   TEXT NOT NULL,\n    51\t    form         TEXT NOT NULL,\n    52\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    53\t    content      TEXT,\n    54\t    reason       TEXT,\n    55\t    metadata     TEXT,\n    56\t    source_version INTEGER NOT NULL DEFAULT 1,\n    57\t    gaps         TEXT,\n    58\t    derived_at   TEXT,\n    59\t    PRIMARY KEY (subject_kind, subject_id, form)\n    60\t  );`,\n    61\t  `CREATE TABLE chunk (\n    62\t    chunk_id     TEXT PRIMARY KEY,\n    63\t    chunk_order  INTEGER NOT NULL UNIQUE,\n    64\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    65\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n    66\t  );`,\n    67\t  `CREATE TABLE chunk_member (\n    68\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    69\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    70\t    member_idx INTEGER NOT NULL,\n    71\t    PRIMARY KEY (chunk_id, member_idx)\n    72\t  );`,\n    73\t  // projection-level delete (the record keeps everything; reads filter)\n    74\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n    75\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n    76\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\n    77\t  // UPDATE-only completion finds them (row missing must mean deleted).\n    78\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    79\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n    80\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n    81\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    82\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n    83\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n    84\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    85\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n    86\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    87\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    88\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'smooth_turn_compression', 'pending', 1\n    89\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    90\t];\n    91\t\n    92\t// Epic 03's single migration (tech design §Storage): the thread-view\n    93\t// snapshot tables and the visibility boundary, living beside the record they\n    94\t// render so a thread file stays self-contained and snapshot-portable.\n    95\t// Singletons are CHECK-enforced structurally: one active view, one boundary\n    96\t// row per thread. Assembled into the thread-file migration history by\n    97\t// threads/internal/create.ts, like v5.\n    98\texport const MIGRATION_V6_STATEMENTS: readonly string[] = [\n    99\t  `CREATE TABLE thread_view (\n   100\t    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),  -- one active view, enforced structurally\n   101\t    view_id TEXT NOT NULL UNIQUE,        -- v<compact event order>, deterministic; receipts/materialize metadata\n   102\t    created_at TEXT NOT NULL,            -- clock at compact; metadata source for materialize\n   103\t    compact_point INTEGER NOT NULL,      -- event_order where the tail begins\n   104\t    covered_from INTEGER NOT NULL,       -- oldest event_order represented in any band\n   105\t    profile_name TEXT,                   -- null when explicit params\n   106\t    config_json TEXT NOT NULL,           -- resolved bound + percentages\n   107\t    arrangement_json TEXT NOT NULL,      -- ordered entries: {band, subjectKind, subjectId, derivationUsed, degraded}\n   108\t    gaps_json TEXT NOT NULL,             -- [{band, subjectId, reason}]\n   109\t    source_state_json TEXT NOT NULL      -- {maxEventOrder, derivationCounts} the compact saw — receipt/debug\n   110\t  );`,\n   111\t  `CREATE TABLE thread_view_band (\n   112\t    view_id TEXT NOT NULL REFERENCES thread_view(view_id) ON DELETE CASCADE,\n   113\t    band TEXT NOT NULL CHECK (band IN ('brief','detailed','smooth')),\n   114\t    rendered_text TEXT NOT NULL,         -- the snapshot bytes served verbatim\n   115\t    token_count INTEGER NOT NULL,\n   116\t    PRIMARY KEY (view_id, band)\n   117\t  );`,\n   118\t  `CREATE TABLE view_boundary (\n   119\t    thread_singleton INTEGER PRIMARY KEY CHECK (thread_singleton = 1),\n   120\t    position INTEGER NOT NULL,           -- source event order; tool results at-or-behind render short\n   121\t    updated_at TEXT NOT NULL\n   122\t  );`,\n   123\t  // Seed at position 0 (everything full) — the boundary row exists from\n   124\t  // migration on, so the advance and the compact reset are UPDATE-only.\n   125\t  `INSERT INTO view_boundary (thread_singleton, position, updated_at)\n   126\t    VALUES (1, 0, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));`,\n   127\t];\n   128\t\n   129\t// Epic 06 Story 0's single migration (tech design §DD-1, §DD-5):\n   130\t// 1. Rename derived_form table to derivation and column 'form' to 'derivation_type'\n   131\t// 2. Create the log table for fallback events and diagnostics\n   132\t// Singletons are CHECK-enforced structurally: one log entry per recorded event.\n   133\t// Assembled into the thread-file migration history by threads/internal/create.ts,\n   134\t// like v5 and v6.\n   135\texport const MIGRATION_V7_STATEMENTS: readonly string[] = [\n   136\t  // Rename table and column for derivation vocabulary (DD-1)\n   137\t  `ALTER TABLE derived_form RENAME TO derivation;`,\n   138\t  // SQLite doesn't support ALTER COLUMN directly, so we recreate the table\n   139\t  `CREATE TABLE derivation_new (\n   140\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n   141\t    subject_id   TEXT NOT NULL,\n   142\t    derivation_type TEXT NOT NULL,\n   143\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n   144\t    content      TEXT,\n   145\t    reason       TEXT,\n   146\t    metadata     TEXT,\n   147\t    source_version INTEGER NOT NULL DEFAULT 1,\n   148\t    gaps         TEXT,\n   149\t    derived_at   TEXT,\n   150\t    PRIMARY KEY (subject_kind, subject_id, derivation_type)\n   151\t  );`,\n   152\t  `INSERT INTO derivation_new SELECT subject_kind, subject_id, form, state, content, reason, metadata, source_version, gaps, derived_at FROM derivation;`,\n   153\t  `DROP TABLE derivation;`,\n   154\t  `ALTER TABLE derivation_new RENAME TO derivation;`,\n   155\t  `UPDATE thread_view\n   156\t     SET arrangement_json = replace(arrangement_json, '\"formUsed\"', '\"derivationUsed\"')\n   157\t     WHERE arrangement_json LIKE '%\"formUsed\"%';`,\n   158\t  `UPDATE thread_view\n   159\t     SET source_state_json = replace(source_state_json, '\"formCounts\"', '\"derivationCounts\"')\n   160\t     WHERE source_state_json LIKE '%\"formCounts\"%';`,\n   161\t  // Create log table (DD-5)\n   162\t  `CREATE TABLE log (\n   163\t    log_id INTEGER PRIMARY KEY AUTOINCREMENT,\n   164\t    level TEXT NOT NULL CHECK (level IN ('info','warning','error')),\n   165\t    message TEXT NOT NULL,\n   166\t    derivation_type TEXT,\n   167\t    subject_id TEXT,\n   168\t    reason TEXT,\n   169\t    floor_used TEXT,\n   170\t    recorded_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))\n   171\t  );`,\n   172\t  // Indexes for log queries by actionable fields\n   173\t  `CREATE INDEX idx_log_level ON log (level);`,\n   174\t  `CREATE INDEX idx_log_derivation_type ON log (derivation_type);`,\n   175\t  `CREATE INDEX idx_log_subject_id ON log (subject_id);`,\n   176\t  `CREATE INDEX idx_log_reason ON log (reason);`,\n   177\t];\n   178\t\n   179\t// Epic 06 Story 2: tool calls render as recorded, so the old\n   180\t// tool_call_summary derivation/work rows are no longer valid work.\n   181\texport const MIGRATION_V8_STATEMENTS: readonly string[] = [\n   182\t  `DELETE FROM work_item WHERE kind = 'tool_call_summary';`,\n   183\t  `DELETE FROM derivation WHERE subject_kind = 'message' AND derivation_type = 'tool_call_summary';`,\n   184\t];\n   185\t\n   186\t// Epic 07 Story 0's migration (tech design §Rename Migration point 6): the\n   187\t// rename lower_band_projection → smooth_turn_compression leaves queued work\n   188\t// items whose payload still names the old derivation type. After the rename no\n   189\t// path produces that type, so such an item would either strand or stamp a\n   190\t// derivation row under a type no query reads. They are safe to delete: the\n   191\t// derivation they would have produced is superseded by the next turn-close or\n   192\t// recovery pass under smooth_turn_compression. A warning is recorded in the log\n   193\t// table iff any such item existed, so the cleanup is observable, not silent.\n   194\t// Assembled into the thread-file migration history by threads/internal/create.ts.\n   195\texport const MIGRATION_V9_STATEMENTS: readonly string[] = [\n   196\t  `INSERT INTO log (level, message, derivation_type, reason, recorded_at)\n   197\t     SELECT 'warning',\n   198\t            'deleted stale lower_band_projection work items after rename to smooth_turn_compression',\n   199\t            'smooth_turn_compression',\n   200\t            'rename_migration',\n   201\t            strftime('%Y-%m-%dT%H:%M:%fZ', 'now')\n   202\t     FROM work_item WHERE payload LIKE '%lower_band_projection%' LIMIT 1;`,\n   203\t  `DELETE FROM work_item WHERE payload LIKE '%lower_band_projection%';`,\n   204\t];\n   205\t\n   206\texport function getSchemaVersion(db: DatabaseSync): number {\n   207\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n   208\t    | { user_version: number | bigint }\n   209\t    | undefined;\n   210\t  return Number(row?.user_version ?? 0);\n   211\t}\n   212\t\n   213\texport function runMigrations(\n   214\t  db: DatabaseSync,\n   215\t  migrations: readonly Migration[],\n   216\t): void {\n   217\t  let current = getSchemaVersion(db);\n   218\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n   219\t  for (const migration of ordered) {\n   220\t    if (migration.version <= current) continue;\n   221\t    db.exec(\"BEGIN IMMEDIATE;\");\n   222\t    try {\n   223\t      for (const statement of migration.statements) db.exec(statement);\n   224\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n   225\t      db.exec(\"COMMIT;\");\n   226\t    } catch (cause) {\n   227\t      db.exec(\"ROLLBACK;\");\n   228\t      throw cause;\n   229\t    }\n   230\t    current = migration.version;\n","exit_code":0,"status":"completed"}}

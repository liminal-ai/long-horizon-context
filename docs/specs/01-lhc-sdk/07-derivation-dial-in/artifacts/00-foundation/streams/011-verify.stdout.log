C-2.3); the dial-in working\n     2\t// period produces the tuned text under a new versioned name.\n     3\timport type { RenderingPart } from \"../derivation.js\";\n     4\timport type { PromptTemplate } from \"./index.js\";\n     5\t\n     6\tfunction partLine(part: RenderingPart): string {\n     7\t  const outcome = part.outcome === undefined ? \"\" : ` (outcome: ${part.outcome})`;\n     8\t  return `[${part.kind}${outcome}]\\n${part.text}`;\n     9\t}\n    10\t\n    11\texport const turnComposeV1: PromptTemplate<{ parts: RenderingPart[] }> = {\n    12\t  name: \"turn-compose-v1\",\n    13\t  render: (i) => [\n    14\t    {\n    15\t      role: \"system\",\n    16\t      content:\n    17\t        \"You compose one turn of an engineering conversation into a faithful narrative account. Work only from the parts given, in order. Attribute each action to its speaker or tool. Preserve concrete facts: paths, identifiers, counts, error text. State each tool outcome plainly using the outcome given. No commentary, no speculation, 250 words maximum.\",\n    18\t    },\n    19\t    { role: \"user\", content: `Turn parts, in order:\\n\\n${i.parts.map(partLine).join(\"\\n\\n\")}` },\n    20\t  ],\n    21\t};\n","exit_code":0,"status":"completed"}}

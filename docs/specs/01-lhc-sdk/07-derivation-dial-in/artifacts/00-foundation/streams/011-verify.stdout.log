{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared-tech/inference-types.ts | sed -n '20,110p'\"","aggregated_output":"    20\t\n    21\t/** `empty_output` is adapter-generated (AC-2.4); hosts never return it.\n    22\t *  Thrown exceptions classify as `other` (AC-3.3). */\n    23\texport type ModelCallFailureKind =\n    24\t  | \"rate_limit\"\n    25\t  | \"timeout\"\n    26\t  | \"network\"\n    27\t  | \"empty_output\"\n    28\t  | \"other\"\n    29\t  | \"auth\"\n    30\t  | \"invalid_request\";\n    31\t\n    32\t// ModelAssignment extended with target ranges for compression types (AC-6.1)\n    33\texport interface ModelAssignment {\n    34\t  provider: string;\n    35\t  model: string;\n    36\t  prompt: string; // must name a PROMPT_REGISTRY entry (AC-1.3)\n    37\t  // Optional target range for compression derivations (AC-6.1)\n    38\t  targetMinRatio?: number;\n    39\t  targetMaxRatio?: number;\n    40\t  targetAimRatio?: number;\n    41\t  thinking?: \"none\" | \"minimal\" | \"medium\" | \"high\"; // optional thinking level\n    42\t}\n    43\t\n    44\t// DerivationGuards config for operational limits (AC-6.2)\n    45\texport interface DerivationGuards {\n    46\t  smoothedPrompt?: {\n    47\t    maxInferenceTokens?: number; // default 700\n    48\t    suspiciousOutputRatio?: number; // default 0.15\n    49\t  };\n    50\t  toolResultSummary?: {\n    51\t    timeoutMs?: number; // default 60_000\n    52\t  };\n    53\t  smoothTurnCompression?: {\n    54\t    tinyTurnTokens?: number; // default 80\n    55\t  };\n    56\t}\n    57\t\n    58\t/** SdkConfig.inference — the alternative to SdkConfig.provider (DD-5). */\n    59\texport interface InferenceConfig {\n    60\t  call: ModelCall;\n    61\t  // Partial by design (AC-0.3, AC-6.2, AC-6.3): inference derivation types the\n    62\t  // host omits are filled from DEFAULT_INFERENCE_ASSIGNMENTS; deterministic\n    63\t  // types are optional. Unknown keys are rejected at construction.\n    64\t  assignments?: Record<string, ModelAssignment>;\n    65\t  guards?: DerivationGuards; // optional operational limits\n    66\t  timeoutMs?: number; // default 60_000 (DD-6)\n    67\t  maxInputChars?: number; // default 200_000 (DD-7)\n    68\t}\n    69\t\n    70\t/** InferenceConfig after createSdk validation: every optional filled. */\n    71\texport interface ResolvedInferenceConfig {\n    72\t  call: ModelCall;\n    73\t  assignments: Record<string, ModelAssignment>;\n    74\t  guards: DerivationGuards; // filled with defaults\n    75\t  timeoutMs: number;\n    76\t  maxInputChars: number;\n    77\t}\n    78\t\n    79\t// Default guard values (AC-6.2, TC-6.2a): the documented operational limits\n    80\t// applied when the host omits a guard. Centralized so construction and tests\n    81\t// share one source of truth for the defaults.\n    82\texport const DEFAULT_GUARDS: DerivationGuards = {\n    83\t  smoothedPrompt: { maxInferenceTokens: 700, suspiciousOutputRatio: 0.15 },\n    84\t  toolResultSummary: { timeoutMs: 60_000 },\n    85\t  smoothTurnCompression: { tinyTurnTokens: 80 },\n    86\t};\n    87\t\n    88\t// Fill a DerivationGuards with defaults for every omitted value (AC-6.2). A\n    89\t// pure function: no defaults drift between construction and the values tests\n    90\t// pin (TC-6.2a).\n    91\texport function resolveGuards(guards?: DerivationGuards): DerivationGuards {\n    92\t  const g = guards ?? {};\n    93\t  return {\n    94\t    smoothedPrompt: {\n    95\t      maxInferenceTokens:\n    96\t        g.smoothedPrompt?.maxInferenceTokens ?? DEFAULT_GUARDS.smoothedPrompt!.maxInferenceTokens!,\n    97\t      suspiciousOutputRatio:\n    98\t        g.smoothedPrompt?.suspiciousOutputRatio ?? DEFAULT_GUARDS.smoothedPrompt!.suspiciousOutputRatio!,\n    99\t    },\n   100\t    toolResultSummary: {\n   101\t      timeoutMs: g.toolResultSummary?.timeoutMs ?? DEFAULT_GUARDS.toolResultSummary!.timeoutMs!,\n   102\t    },\n   103\t    smoothTurnCompression: {\n   104\t      tinyTurnTokens:\n   105\t        g.smoothTurnCompression?.tinyTurnTokens ?? DEFAULT_GUARDS.smoothTurnCompression!.tinyTurnTokens!,\n   106\t    },\n   107\t  };\n   108\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '335,445p'\"","aggregated_output":"   335\t}\n   336\t\n   337\t// The default provider lane and model for inference derivation types (AC-6.4),\n   338\t// used when the host omits an inference type from inference.assignments\n   339\t// (AC-6.2). The provider key is an opaque routing key the host's ModelCall\n   340\t// interprets — LHC never resolves it.\n   341\tconst DEFAULT_INFERENCE_LANE = { provider: \"codex\", model: \"gpt-5.4-mini\" } as const;\n   342\t\n   343\t// Default assignment per inference derivation type (AC-6.2, AC-6.4): the\n   344\t// documented default lane and model, the registry's default prompt template,\n   345\t// and the tested target ratios for the compression/brief types. Deterministic\n   346\t// types (turn_rendering, chunk_summary_detailed) have no default — they are\n   347\t// optional (AC-6.3). Construction-internal: the defaults are observable\n   348\t// through routed calls (TC-6.4a), not part of the public export surface.\n   349\tconst DEFAULT_INFERENCE_ASSIGNMENTS: Readonly<Record<string, ModelAssignment>> = {\n   350\t  smoothed_prompt: {\n   351\t    provider: DEFAULT_INFERENCE_LANE.provider,\n   352\t    model: DEFAULT_INFERENCE_LANE.model,\n   353\t    prompt: DEFAULT_PROMPT_NAMES.smoothed_prompt ?? \"smoothing-v1\",\n   354\t  },\n   355\t  tool_result_summary: {\n   356\t    provider: DEFAULT_INFERENCE_LANE.provider,\n   357\t    model: DEFAULT_INFERENCE_LANE.model,\n   358\t    prompt: DEFAULT_PROMPT_NAMES.tool_result_summary ?? \"tool-result-v1\",\n   359\t  },\n   360\t  smooth_turn_compression: {\n   361\t    provider: DEFAULT_INFERENCE_LANE.provider,\n   362\t    model: DEFAULT_INFERENCE_LANE.model,\n   363\t    prompt: DEFAULT_PROMPT_NAMES.smooth_turn_compression ?? \"lower-band-v1\",\n   364\t    targetMinRatio: 0.35,\n   365\t    targetMaxRatio: 0.65,\n   366\t    targetAimRatio: 0.5,\n   367\t  },\n   368\t  chunk_summary_brief: {\n   369\t    provider: DEFAULT_INFERENCE_LANE.provider,\n   370\t    model: DEFAULT_INFERENCE_LANE.model,\n   371\t    prompt: DEFAULT_PROMPT_NAMES.chunk_summary_brief ?? \"chunk-brief-v1\",\n   372\t    targetMinRatio: 0.08,\n   373\t    targetMaxRatio: 0.2,\n   374\t    targetAimRatio: 0.12,\n   375\t  },\n   376\t};\n   377\t\n   378\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5; Epic 07\n   379\t// Story 0 AC-0.3/6.1–6.4): validate the host function and the assignment map,\n   380\t// then fill defaults. Provided inference assignments must carry non-empty\n   381\t// provider/model and a registry-known prompt (AC-6.1). Inference types the host\n   382\t// omits are filled from DEFAULT_INFERENCE_ASSIGNMENTS (AC-6.2, AC-6.4).\n   383\t// Deterministic types are optional (AC-6.3). Unknown keys are rejected — never\n   384\t// silently ignored. Then the adapter is built into the same DerivationProvider\n   385\t// slot direct injection uses. No partial construction: every mistake throws\n   386\t// before anything is assembled (AC-1.1, AC-1.3).\n   387\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n   388\t  if (typeof inference.call !== \"function\") {\n   389\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n   390\t  }\n   391\t  const provided = inference.assignments ?? {};\n   392\t  if (provided === null || typeof provided !== \"object\") {\n   393\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n   394\t  }\n   395\t\n   396\t  const inferenceKeys = new Set<string>(Object.keys(DEFAULT_INFERENCE_ASSIGNMENTS));\n   397\t  const deterministicKeys = new Set([\"turn_rendering\", \"chunk_summary_detailed\"]);\n   398\t  const knownKinds = new Set<string>([...inferenceKeys, ...deterministicKeys]);\n   399\t\n   400\t  // Unknown keys are rejected (anti-shim: never silently ignore) — TC-0.3a.\n   401\t  for (const key of Object.keys(provided)) {\n   402\t    if (!knownKinds.has(key)) {\n   403\t      throw new TypeError(\n   404\t        `createSdk config: inference.assignments has unknown derivation type \"${key}\"`,\n   405\t      );\n   406\t    }\n   407\t  }\n   408\t\n   409\t  // Validate every provided INFERENCE assignment (AC-6.1): non-empty\n   410\t  // provider/model/prompt, and the prompt must name a registry template.\n   411\t  for (const kind of inferenceKeys) {\n   412\t    const assignment = provided[kind];\n   413\t    if (assignment === undefined) continue; // filled from defaults below\n   414\t    if (assignment === null || typeof assignment !== \"object\") {\n   415\t      throw new TypeError(`createSdk config: inference.assignments.${kind} must be an object`);\n   416\t    }\n   417\t    for (const field of [\"provider\", \"model\", \"prompt\"] as const) {\n   418\t      const value = assignment[field];\n   419\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n   420\t        throw new TypeError(\n   421\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n   422\t        );\n   423\t      }\n   424\t    }\n   425\t    if (PROMPT_REGISTRY[assignment.prompt] === undefined) {\n   426\t      throw new TypeError(\n   427\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${assignment.prompt}\"`,\n   428\t      );\n   429\t    }\n   430\t  }\n   431\t\n   432\t  // Deterministic assignments are optional (AC-6.3); when present, a prompt —\n   433\t  // if supplied — must still name a registry template.\n   434\t  for (const kind of deterministicKeys) {\n   435\t    const assignment = provided[kind];\n   436\t    if (assignment === undefined || assignment.prompt === undefined) continue;\n   437\t    if (PROMPT_REGISTRY[assignment.prompt] === undefined) {\n   438\t      throw new TypeError(\n   439\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${assignment.prompt}\"`,\n   440\t      );\n   441\t    }\n   442\t  }\n   443\t\n   444\t  // Merge: inference types default-filled (AC-6.2, AC-6.4); deterministic types\n   445\t  // pass through only when the host supplied them.\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' packages/lhc/src/shared-tech/prompts/index.ts\"","aggregated_output":"// The name-keyed prompt registry (DD-8): one module per template exporting\n// `{ name, render(input) → messages }`; config selects by name and dial-in\n// swaps by adding a module and editing config — no handler, adapter, or host\n// changes. Versioning is in the name (`smoothing-v1`).\nimport type { ModelCallInput } from \"../inference-types.js\";\nimport { chunkBriefV1 } from \"./chunk-brief-v1.js\";\nimport { chunkDetailedV1 } from \"./chunk-detailed-v1.js\";\nimport { lowerBandV1 } from \"./lower-band-v1.js\";\nimport { smoothingV1 } from \"./smoothing-v1.js\";\nimport { toolResultV1 } from \"./tool-result-v1.js\";\nimport { turnComposeV1 } from \"./turn-compose-v1.js\";\n\nexport interface PromptTemplate<I = unknown> {\n  name: string;\n  render(input: I): ModelCallInput[\"messages\"];\n}\n\n// Every config-selectable name. `never` pins the registry read-only at the\n// type level — rendering goes through the adapter, which owns the only\n// kind→input pairing.\nexport const PROMPT_REGISTRY: Record<string, PromptTemplate<never>> = {\n  [smoothingV1.name]: smoothingV1,\n  [toolResultV1.name]: toolResultV1,\n  [turnComposeV1.name]: turnComposeV1,\n  [lowerBandV1.name]: lowerBandV1,\n  [chunkDetailedV1.name]: chunkDetailedV1,\n  [chunkBriefV1.name]: chunkBriefV1,\n};\n\n// Every config-selectable prompt name — the catalog an operator's assignment\n// config picks from. Exposed through the SDK surface (sdk.ts) so valid names\n// are discoverable without reading source.\nexport const PROMPT_NAMES: readonly string[] = Object.keys(PROMPT_REGISTRY);\n\n// The default template per derivation type — the defaults an operator's first\n// config reaches for, and what test fixtures assign.\nexport const DEFAULT_PROMPT_NAMES: Record<string, string> = {\n  smoothed_prompt: smoothingV1.name,\n  tool_result_summary: toolResultV1.name,\n  smooth_turn_compression: lowerBandV1.name,\n  chunk_summary_brief: chunkBriefV1.name,\n};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"agent_message","text":"{\"artifactsRead\":[\"packages/lhc/src/shared-tech/prompts/index.ts\"],\"reviewScopeSummary\":\"One material mismatch is visible already: the prompt registry still includes deterministic prompt templates. I’m checking SDK construction now because that determines whether AC-6.3’s optional deterministic assignment contract is actually satisfied.\",\"priorFindingStatuses\":[],\"newFindings\":[],\"openFindings\":[],\"requirementCoverage\":{\"verified\":[],\"unverified\":[\"AC-6.3 deterministic assignment shape and non-invocation\"]},\"gatesRun\":[{\"command\":\"cd packages/lhc && pnpm run verify\",\"result\":\"pass\"},{\"command\":\"cd packages/lhc && pnpm run verify-all\",\"result\":\"pass\"}],\"productionPathFindings\":[\"Prompt registry still includes turn-compose-v1 and chunk-detailed-v1 in shared-tech/prompts/index.ts; tech design says deterministic prompt files are removed and inference registry contains inference prompts only.\"],\"recommendedNextStep\":\"revise\",\"recommendedFixScope\":\"same-session-implementor\",\"openQuestions\":[],\"additionalObservations\":[]}"}}

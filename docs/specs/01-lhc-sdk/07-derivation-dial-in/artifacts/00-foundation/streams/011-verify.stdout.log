{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/turns/internal/derive.ts | sed -n '240,390p'\"","aggregated_output":"   240\t      subjectId: recovery.subjectId,\n   241\t      reason: recovery.reason,\n   242\t      floorUsed: recovery.floorUsed,\n   243\t    });\n   244\t    recoverDerivation(run.openDb(), {\n   245\t      subjectKind: recovery.subjectKind,\n   246\t      subjectId: recovery.subjectId,\n   247\t      derivationType: recovery.derivationType,\n   248\t      content: recovery.content,\n   249\t      sourceVersion: recovery.sourceVersion,\n   250\t      derivedAt: run.clock().toISOString(),\n   251\t    });\n   252\t  }\n   253\t\n   254\t  const rendering = await run.provider.composeTurnRendering({ parts });\n   255\t  if (!rendering.ok) return providerFailed(rendering);\n   256\t  const projection = await run.provider.compressSmoothTurn({ rendering: rendering.text });\n   257\t  if (!projection.ok) return providerFailed(projection);\n   258\t\n   259\t  // The projection's token count is estimated exactly once, here, as the\n   260\t  // artifact lands; placement reads this stored arithmetic and never\n   261\t  // re-counts (AC-3.9's determinism input).\n   262\t  const projectedTokens = estimateTokens(projection.text);\n   263\t  const threadId = readThreadId(run);\n   264\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\n   265\t  // from the composition input (AC-3.8) — the chunk summaries read them from\n   266\t  // here, never from provider prose. Provenance is copied from the provider\n   267\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\n   268\t  // deterministic provider sets none.\n   269\t  const renderingMetadata: DerivationMetadata = {\n   270\t    ...(receipts.length > 0 ? { receipts } : {}),\n   271\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\n   272\t  };\n   273\t\n   274\t  return {\n   275\t    ok: true,\n   276\t    derivations: [\n   277\t      {\n   278\t        subjectKind: \"turn\",\n   279\t        subjectId: turnId,\n   280\t        derivationType: \"turn_rendering\",\n   281\t        content: rendering.text,\n   282\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\n   283\t      },\n   284\t      {\n   285\t        subjectKind: \"turn\",\n   286\t        subjectId: turnId,\n   287\t        derivationType: \"smooth_turn_compression\",\n   288\t        content: projection.text,\n   289\t        ...(projection.provenance === undefined\n   290\t          ? {}\n   291\t          : { metadata: { provenance: projection.provenance } }),\n   292\t      },\n   293\t    ],\n   294\t    onApplied: (tx) => {\n   295\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   296\t      for (const chunkId of placement.closedChunkIds) {\n   297\t        enqueueChunkSummaries(\n   298\t          {\n   299\t            db: tx.db,\n   300\t            clock: run.clock,\n   301\t            threadId,\n   302\t            onCommit: tx.onCommit,\n   303\t            poke: resolveInstancePoke(),\n   304\t          },\n   305\t          chunkId,\n   306\t        );\n   307\t      }\n   308\t    },\n   309\t  };\n   310\t};\n   311\t\n   312\t// One read for both summary kinds — member projections in turn order — but\n   313\t// two contracts at the provider seam (AC-3.8): detailed receives the\n   314\t// members' tool-run receipts (what changed, outcome) read from the\n   315\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n   316\t// text stripped here so the brief provider call structurally cannot carry\n   317\t// it. Two work items, two handlers' runs, independent retry and states. A\n   318\t// member whose projection is not ready waits: chunk summary derivation is\n   319\t// background work, so it requeues until the member lower-band input lands.\n   320\tfunction chunkSummaryHandler(\n   321\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   322\t): WorkHandler {\n   323\t  return async (run, item) => {\n   324\t    const chunkId = item.sourceRef[\"chunkId\"];\n   325\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   326\t    const db = run.openDb();\n   327\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   328\t\n   329\t    const members = readMemberProjections(db, chunkId);\n   330\t    const memberProjections: string[] = [];\n   331\t    for (const member of members) {\n   332\t      if (member.sourceCorruptionReason !== undefined) {\n   333\t        return sourceDamaged(member.sourceCorruptionReason);\n   334\t      }\n   335\t      if (member.state === \"ready\" && member.content !== undefined) {\n   336\t        memberProjections.push(member.content);\n   337\t        continue;\n   338\t      }\n   339\t      if (member.state === \"blocked\") {\n   340\t        return sourceDamaged(\n   341\t          `member ${member.turnId} smooth_turn_compression blocked while deriving ${kind}`,\n   342\t        );\n   343\t      }\n   344\t      return dependencyNotReady(\n   345\t        `member_projection_not_ready: member ${member.turnId} smooth_turn_compression is ${member.state ?? \"missing\"}`,\n   346\t      );\n   347\t    }\n   348\t\n   349\t    const result =\n   350\t      kind === \"chunk_summary_detailed\"\n   351\t        ? await run.provider.summarizeChunkDetailed({\n   352\t            memberProjections,\n   353\t            memberReceipts: members.map((member) => member.receipts),\n   354\t          })\n   355\t        : await run.provider.summarizeChunkBrief({\n   356\t            memberProjections,\n   357\t            memberOutcomes: members.map((member) =>\n   358\t              member.receipts.map((receipt) => receipt.outcome),\n   359\t            ),\n   360\t          });\n   361\t    if (!result.ok) return providerFailed(result);\n   362\t\n   363\t    return {\n   364\t      ok: true,\n   365\t      derivations: [\n   366\t        {\n   367\t          subjectKind: \"chunk\",\n   368\t          subjectId: chunkId,\n   369\t          derivationType: kind,\n   370\t          content: result.text,\n   371\t          ...(result.provenance === undefined\n   372\t            ? {}\n   373\t            : { metadata: { provenance: result.provenance } }),\n   374\t        },\n   375\t      ],\n   376\t    };\n   377\t  };\n   378\t}\n   379\t\n   380\t// The domain's handler table, merged into the SDK dispatch map at\n   381\t// construction (DD-6).\n   382\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   383\t  turn_derivation: turnDerivationHandler,\n   384\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   385\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   386\t};\n","exit_code":0,"status":"completed"}}

{
  "name": "pi-lhc",
  "version": "0.0.0",
  "private": true,
  "description": "PI \u2194 LHC connector extension (Epic 1: Connector Core, observe-only).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-lhc": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "test:all": "pnpm run test",
    "format:check": "biome format .",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:all": "pnpm run verify"
  },
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:../../vendor/pi/packages/agent",
    "@earendil-works/pi-coding-agent": "file:../../vendor/pi/packages/coding-agent",
    "lhc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}

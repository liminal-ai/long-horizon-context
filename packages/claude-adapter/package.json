{
  "name": "claude-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Pure Claude-to-LHC adapters shared by the Claude hosts: Messages API block mapping, retrieval budgets and envelope, idempotency keys.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "lhc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}

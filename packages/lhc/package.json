{
  "name": "lhc",
  "version": "0.0.0",
  "private": true,
  "description": "Long Horizon Context SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --exclude 'test/inference-real.test.ts'",
    "format": "biome format --write packages/lhc",
    "lint": "biome check packages/lhc",
    "test:integration": "LHC_RUN_INTEGRATION=1 vitest run test/inference-real.test.ts",
    "test:all": "pnpm run test && pnpm run test:integration",
    "format:check": "biome format packages/lhc",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:all": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:all"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "effect": "^3.21.2",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}

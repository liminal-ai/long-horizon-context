{
  "name": "lhc",
  "version": "0.0.0",
  "private": true,
  "description": "Long Horizon Context SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "node scripts/lint.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "red-verify": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run boundaries",
    "verify": "pnpm run red-verify && vitest run",
    "green-verify": "pnpm run verify && node scripts/check-test-immutability.mjs",
    "verify-all": "pnpm run verify"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "effect": "^3.21.2",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}

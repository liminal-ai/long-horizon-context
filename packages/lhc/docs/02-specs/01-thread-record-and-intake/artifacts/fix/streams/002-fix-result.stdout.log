{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FuYkTQJLH56Geja3kKUW5Y","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n3\timport {\n4\t  createThreadFile,\n5\t  deleteThreadFile,\n6\t  generateThreadId,\n7\t  openThreadDatabase,\n8\t} from \"./internal/create.js\";\n9\t\n10\t// Re-exported for the other domain surfaces: opening a thread file through\n11\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n12\t// file gains the message tables here before any write or read touches them).\n13\texport { openThreadDatabase };\n14\timport {\n15\t  insertThreadRow,\n16\t  openRegistryForRead,\n17\t  openRegistryForWrite,\n18\t  resolveRegistryPath,\n19\t  selectAllThreadRows,\n20\t  selectThreadRow,\n21\t  type RegistryRow,\n22\t} from \"./internal/registry.js\";\n23\t\n24\texport type ThreadRef =\n25\t  | { threadId: string; registryPath?: string }\n26\t  | { filePath: string };\n27\t\n28\texport interface NewThreadInput {\n29\t  filePath: string;\n30\t  title?: string;\n31\t  registryPath?: string;\n32\t}\n33\t\n34\texport interface ThreadInfo {\n35\t  threadId: string;\n36\t  filePath: string;\n37\t  title?: string;\n38\t  createdAt: string; // ISO-8601\n39\t}\n40\t\n41\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n42\t  const info: ThreadInfo = {\n43\t    threadId: row.threadId,\n44\t    filePath: row.filePath,\n45\t    createdAt: row.createdAt,\n46\t  };\n47\t  if (row.title !== undefined) info.title = row.title;\n48\t  return info;\n49\t}\n50\t\n51\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n52\t  return {\n53\t    ok: false,\n54\t    error: {\n55\t      errorClass: \"caller_error\",\n56\t      code: \"thread_not_found\",\n57\t      reason: `no thread registered with id ${threadId}`,\n58\t    },\n59\t  };\n60\t}\n61\t\n62\tfunction detail(cause: unknown): string {\n63\t  return cause instanceof Error ? cause.message : String(cause);\n64\t}\n65\t\n66\t// Creation spans two databases that cannot share a transaction. Order is\n67\t// file-then-row with compensation: the invariant \"no registry row without\n68\t// its file\" is absolute; an orphan file from a crash between the writes is\n69\t// documented harmless (design decision 2).\n70\texport async function newThread(\n71\t  input: NewThreadInput,\n72\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n73\t  if (existsSync(input.filePath)) {\n74\t    return {\n75\t      ok: false,\n76\t      error: {\n77\t        errorClass: \"caller_error\",\n78\t        code: \"path_exists\",\n79\t        reason: `a file already exists at ${input.filePath}`,\n80\t      },\n81\t    };\n82\t  }\n83\t\n84\t  const threadId = generateThreadId();\n85\t  const createdAt = new Date().toISOString();\n86\t\n87\t  try {\n88\t    createThreadFile(input.filePath, threadId, createdAt);\n89\t  } catch (cause) {\n90\t    deleteThreadFile(input.filePath);\n91\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n92\t  }\n93\t\n94\t  let registry;\n95\t  try {\n96\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n97\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n98\t    if (input.title !== undefined) row.title = input.title;\n99\t    insertThreadRow(registry, row);\n100\t  } catch (cause) {\n101\t    deleteThreadFile(input.filePath);\n102\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n103\t  } finally {\n104\t    registry?.close();\n105\t  }\n106\t\n107\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n108\t}\n109\t\n110\texport async function resolve(input: {\n111\t  threadId: string;\n112\t  registryPath?: string;\n113\t}): Promise<OpResult<ThreadInfo>> {\n114\t  let registry;\n115\t  try {\n116\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n117\t    if (registry === null) return threadNotFound(input.threadId);\n118\t    const row = selectThreadRow(registry, input.threadId);\n119\t    if (row === undefined) return threadNotFound(input.threadId);\n120\t    return { ok: true, value: toThreadInfo(row) };\n121\t  } catch (cause) {\n122\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n123\t  } finally {\n124\t    registry?.close();\n125\t  }\n126\t}\n127\t\n128\texport async function listThreads(input?: {\n129\t  registryPath?: string;\n130\t}): Promise<OpResult<ThreadInfo[]>> {\n131\t  let registry;\n132\t  try {\n133\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n134\t    if (registry === null) return { ok: true, value: [] };\n135\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n136\t  } catch (cause) {\n137\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n138\t  } finally {\n139\t    registry?.close();\n140\t  }\n141\t}\n142\t\n143\t// The single interpreter of thread references: { threadId } resolves to a\n144\t// path through the registry, { filePath } passes through untouched. No other\n145\t// code ever reads a thread reference.\n146\texport async function resolveThreadRef(\n147\t  ref: ThreadRef,\n148\t): Promise<OpResult<{ filePath: string }>> {\n149\t  if (\"threadId\" in ref) {\n150\t    const resolved = await resolve(ref);\n151\t    if (!resolved.ok) return resolved;\n152\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n153\t  }\n154\t  return { ok: true, value: { filePath: ref.filePath } };\n155\t}\n156\t"}]},"parent_tool_use_id":null,"session_id":"0d748447-7717-482c-80b3-edb3c328c1b5","uuid":"dbc5e959-c87d-4ade-9009-e5f57f14163f","timestamp":"2026-06-10T15:27:25.382Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  createThreadFile,\n  deleteThreadFile,\n  generateThreadId,\n  openThreadDatabase,\n} from \"./internal/create.js\";\n\n// Re-exported for the other domain surfaces: opening a thread file through\n// the threads domain is what guarantees its schema is current (a pre-Story-3\n// file gains the message tables here before any write or read touches them).\nexport { openThreadDatabase };\nimport {\n  insertThreadRow,\n  openRegistryForRead,\n  openRegistryForWrite,\n  resolveRegistryPath,\n  selectAllThreadRows,\n  selectThreadRow,\n  type RegistryRow,\n} from \"./internal/registry.js\";\n\nexport type ThreadRef =\n  | { threadId: string; registryPath?: string }\n  | { filePath: string };\n\nexport interface NewThreadInput {\n  filePath: string;\n  title?: string;\n  registryPath?: string;\n}\n\nexport interface ThreadInfo {\n  threadId: string;\n  filePath: string;\n  title?: string;\n  createdAt: string; // ISO-8601\n}\n\nfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n  const info: ThreadInfo = {\n    threadId: row.threadId,\n    filePath: row.filePath,\n    createdAt: row.createdAt,\n  };\n  if (row.title !== undefined) info.title = row.title;\n  return info;\n}\n\nfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread registered with id ${threadId}`,\n    },\n  };\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Creation spans two databases that cannot share a transaction. Order is\n// file-then-row with compensation: the invariant \"no registry row without\n// its file\" is absolute; an orphan file from a crash between the writes is\n// documented harmless (design decision 2).\nexport async function newThread(\n  input: NewThreadInput,\n): Promise<OpResult<{ threadId: string; filePath: string }>> {\n  if (existsSync(input.filePath)) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"path_exists\",\n        reason: `a file already exists at ${input.filePath}`,\n      },\n    };\n  }\n\n  const threadId = generateThreadId();\n  const createdAt = new Date().toISOString();\n\n  try {\n    createThreadFile(input.filePath, threadId, createdAt);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n  }\n\n  let registry;\n  try {\n    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n    if (input.title !== undefined) row.title = input.title;\n    insertThreadRow(registry, row);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`registry insert failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n\n  return { ok: true, value: { threadId, filePath: input.filePath } };\n}\n\nexport async function resolve(input: {\n  threadId: string;\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n    if (registry === null) return threadNotFound(input.threadId);\n    const row = selectThreadRow(registry, input.threadId);\n    if (row === undefined) return threadNotFound(input.threadId);\n    return { ok: true, value: toThreadInfo(row) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\nexport async function listThreads(input?: {\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo[]>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n    if (registry === null) return { ok: true, value: [] };\n    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\n// The single interpreter of thread references: { threadId } resolves to a\n// path through the registry, { filePath } passes through untouched. No other\n// code ever reads a thread reference.\nexport async function resolveThreadRef(\n  ref: ThreadRef,\n): Promise<OpResult<{ filePath: string }>> {\n  if (\"threadId\" in ref) {\n    const resolved = await resolve(ref);\n    if (!resolved.ok) return resolved;\n    return { ok: true, value: { filePath: resolved.value.filePath } };\n  }\n  return { ok: true, value: { filePath: ref.filePath } };\n}\n","numLines":156,"startLine":1,"totalLines":156}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019BcDyZaQNaL7F36aYDG9qv","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Zero-dependency import-boundary check.\n3\t// Rules:\n4\t//   1. No file may import another domain's internal/ modules.\n5\t//   2. tech-utils/ and shared/ may not import from domains/.\n6\t// The test fixtures directory (test/fixtures/) is exempt by design — it is\n7\t// the one sanctioned below-SDK writer.\n8\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\t\n12\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n13\tconst srcRoot = path.join(pkgRoot, \"src\");\n14\tconst testRoot = path.join(pkgRoot, \"test\");\n15\tconst fixturesRoot = path.join(testRoot, \"fixtures\");\n16\t\n17\tfunction collectTsFiles(dir, out = []) {\n18\t  let entries;\n19\t  try {\n20\t    entries = readdirSync(dir);\n21\t  } catch {\n22\t    return out;\n23\t  }\n24\t  for (const entry of entries) {\n25\t    const full = path.join(dir, entry);\n26\t    if (full === fixturesRoot) continue; // fixtures exempt\n27\t    if (statSync(full).isDirectory()) {\n28\t      collectTsFiles(full, out);\n29\t    } else if (full.endsWith(\".ts\")) {\n30\t      out.push(full);\n31\t    }\n32\t  }\n33\t  return out;\n34\t}\n35\t\n36\tfunction importSpecifiers(source) {\n37\t  const specs = [];\n38\t  const patterns = [\n39\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n40\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n41\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n42\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n43\t  ];\n44\t  for (const re of patterns) {\n45\t    let m;\n46\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n47\t  }\n48\t  return specs;\n49\t}\n50\t\n51\tfunction domainOf(filePath) {\n52\t  const rel = path.relative(srcRoot, filePath);\n53\t  const parts = rel.split(path.sep);\n54\t  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n55\t  return null;\n56\t}\n57\t\n58\tconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\n59\tconst violations = [];\n60\t\n61\tfor (const file of files) {\n62\t  const source = readFileSync(file, \"utf8\");\n63\t  const fileDomain = domainOf(file);\n64\t  const inTechUtilsOrShared =\n65\t    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n66\t    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n67\t\n68\t  for (const spec of importSpecifiers(source)) {\n69\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n70\t    const resolved = path.resolve(path.dirname(file), spec);\n71\t    const relToSrc = path.relative(srcRoot, resolved);\n72\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n73\t    const parts = relToSrc.split(path.sep);\n74\t\n75\t    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n76\t      const targetDomain = parts[1];\n77\t      if (fileDomain !== targetDomain) {\n78\t        violations.push(\n79\t          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n80\t        );\n81\t      }\n82\t    }\n83\t    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n84\t      violations.push(\n85\t        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n86\t      );\n87\t    }\n88\t  }\n89\t}\n90\t\n91\tif (violations.length > 0) {\n92\t  console.error(\"boundary check FAILED:\");\n93\t  for (const v of violations) console.error(`  - ${v}`);\n94\t  process.exit(1);\n95\t}\n96\tconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n97\t"}]},"parent_tool_use_id":null,"session_id":"0d748447-7717-482c-80b3-edb3c328c1b5","uuid":"a7549b89-7982-49bc-b861-34a85ec0ec76","timestamp":"2026-06-10T15:29:25.254Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/scripts/check-boundaries.mjs","content":"#!/usr/bin/env node\n// Zero-dependency import-boundary check.\n// Rules:\n//   1. No file may import another domain's internal/ modules.\n//   2. tech-utils/ and shared/ may not import from domains/.\n// The test fixtures directory (test/fixtures/) is exempt by design — it is\n// the one sanctioned below-SDK writer.\nimport { readdirSync, readFileSync, statSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst srcRoot = path.join(pkgRoot, \"src\");\nconst testRoot = path.join(pkgRoot, \"test\");\nconst fixturesRoot = path.join(testRoot, \"fixtures\");\n\nfunction collectTsFiles(dir, out = []) {\n  let entries;\n  try {\n    entries = readdirSync(dir);\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    const full = path.join(dir, entry);\n    if (full === fixturesRoot) continue; // fixtures exempt\n    if (statSync(full).isDirectory()) {\n      collectTsFiles(full, out);\n    } else if (full.endsWith(\".ts\")) {\n      out.push(full);\n    }\n  }\n  return out;\n}\n\nfunction importSpecifiers(source) {\n  const specs = [];\n  const patterns = [\n    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n  ];\n  for (const re of patterns) {\n    let m;\n    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n  }\n  return specs;\n}\n\nfunction domainOf(filePath) {\n  const rel = path.relative(srcRoot, filePath);\n  const parts = rel.split(path.sep);\n  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n  return null;\n}\n\nconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\nconst violations = [];\n\nfor (const file of files) {\n  const source = readFileSync(file, \"utf8\");\n  const fileDomain = domainOf(file);\n  const inTechUtilsOrShared =\n    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n\n  for (const spec of importSpecifiers(source)) {\n    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n    const resolved = path.resolve(path.dirname(file), spec);\n    const relToSrc = path.relative(srcRoot, resolved);\n    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n    const parts = relToSrc.split(path.sep);\n\n    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n      const targetDomain = parts[1];\n      if (fileDomain !== targetDomain) {\n        violations.push(\n          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n        );\n      }\n    }\n    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n      violations.push(\n        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n      );\n    }\n  }\n}\n\nif (violations.length > 0) {\n  console.error(\"boundary check FAILED:\");\n  for (const v of violations) console.error(`  - ${v}`);\n  process.exit(1);\n}\nconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n","numLines":97,"startLine":1,"totalLines":97}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NXXhPCFiSjcY41ueHf6ZWU","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport type { OperationContext } from \"../../shared/context.js\";\n3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n4\timport {\n5\t  listItems,\n6\t  recordItem,\n7\t  type WorkItemRecord,\n8\t  type WorkKind,\n9\t} from \"../../tech-utils/work-queue/index.js\";\n10\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n11\timport {\n12\t  openThreadDatabase,\n13\t  resolveThreadRef,\n14\t  type ThreadRef,\n15\t} from \"../threads/index.js\";\n16\timport { projectEvent } from \"./internal/project.js\";\n17\timport { insertMessage, readMessages } from \"./internal/store.js\";\n18\t\n19\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n20\t\n21\texport interface Block {\n22\t  blockType: BlockType;\n23\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n24\t}\n25\t\n26\texport interface MessageRecord {\n27\t  messageId: string;\n28\t  sourceEventOrder: number;\n29\t  kind: Exclude<EventKind, \"turn_end\">;\n30\t  blocks: Block[];\n31\t  tokenEstimate: number;\n32\t  actor: string;\n33\t  harness: string;\n34\t  turnId?: string;\n35\t}\n36\t\n37\t// The event as the walk holds it after recording: the validated input plus\n38\t// its server-stamped order and timestamp.\n39\texport type RecordedEvent = EventRecord;\n40\t\n41\texport type MessageCreated = {\n42\t  messageId: string;\n43\t  kind: Exclude<EventKind, \"turn_end\">;\n44\t} | null;\n45\t\n46\t// Cross-domain surface, called by intake-stream inside the batch transaction\n47\t// (the first such call through the operation context; turns.applyEvent\n48\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n49\t// projection failure propagates to the pipeline's catch and rejects the\n50\t// whole batch — recorded events without messages is the stranded state the\n51\t// transaction exists to prevent. Returns null for turn_end (no message).\n52\t// turnId is the membership stamp, settled by the pipeline before this call:\n53\t// the turn open *after* this event's transition (so a prompt belongs to the\n54\t// turn it just opened), or null in a gap — written once, never updated.\n55\texport function createFromEvent(\n56\t  ctx: OperationContext,\n57\t  event: RecordedEvent,\n58\t  turnId: string | null,\n59\t): MessageCreated {\n60\t  const projected = projectEvent(event);\n61\t  if (projected === null) return null;\n62\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n63\t  const messageId = `m${event.eventOrder}`;\n64\t  insertMessage(ctx.db, {\n65\t    messageId,\n66\t    sourceEventOrder: event.eventOrder,\n67\t    kind,\n68\t    tokenEstimate: projected.tokenEstimate,\n69\t    actor: event.actor,\n70\t    harness: event.harness,\n71\t    turnId,\n72\t    blocks: projected.blocks,\n73\t  });\n74\t  return { messageId, kind };\n75\t}\n76\t\n77\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n78\t// result queues tool_result_summary, nothing else queues anything — text,\n79\t// thinking, and note messages are not derivation sources (AC-2.8, AC-2.7's\n80\t// TC-2.9 half). Cross-domain surface, called by intake-stream inside the\n81\t// batch transaction for every recorded message, so the item commits (or\n82\t// rolls back) with the batch.\n83\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n84\t  user_prompt: \"prompt_smoothing\",\n85\t  tool_result: \"tool_result_summary\",\n86\t};\n87\t\n88\texport function queueMessageWork(\n89\t  ctx: OperationContext,\n90\t  message: MessageCreated,\n91\t): WorkItemRecord[] {\n92\t  if (message === null) return [];\n93\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n94\t  if (kind === undefined) return [];\n95\t  const item = recordItem(\n96\t    ctx.db,\n97\t    { owner: \"messages\", kind, sourceRef: { messageId: message.messageId } },\n98\t    ctx.clock().toISOString(),\n99\t  );\n100\t  return [item];\n101\t}\n102\t\n103\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n104\t  return {\n105\t    ok: false,\n106\t    error: {\n107\t      errorClass: \"caller_error\",\n108\t      code: \"thread_not_found\",\n109\t      reason: `no thread file exists at ${filePath}`,\n110\t    },\n111\t  };\n112\t}\n113\t\n114\texport async function listMessages(\n115\t  thread: ThreadRef,\n116\t): Promise<OpResult<MessageRecord[]>> {\n117\t  const resolved = await resolveThreadRef(thread);\n118\t  if (!resolved.ok) return resolved;\n119\t  const { filePath } = resolved.value;\n120\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n121\t\n122\t  // openThreadDatabase verifies the file is a real thread file and migrates\n123\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n124\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n125\t  // unmutated (F-03-002).\n126\t  const opened = openThreadDatabase(filePath);\n127\t  if (!opened.ok) return opened;\n128\t  const db = opened.value;\n129\t  try {\n130\t    return { ok: true, value: readMessages(db) };\n131\t  } catch (cause) {\n132\t    const reason = cause instanceof Error ? cause.message : String(cause);\n133\t    return storageFailure(`message read-back failed: ${reason}`);\n134\t  } finally {\n135\t    db.close();\n136\t  }\n137\t}\n138\t\n139\texport async function listQueuedWork(\n140\t  thread: ThreadRef,\n141\t): Promise<OpResult<WorkItemRecord[]>> {\n142\t  const resolved = await resolveThreadRef(thread);\n143\t  if (!resolved.ok) return resolved;\n144\t  const { filePath } = resolved.value;\n145\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n146\t\n147\t  const opened = openThreadDatabase(filePath);\n148\t  if (!opened.ok) return opened;\n149\t  const db = opened.value;\n150\t  try {\n151\t    return { ok: true, value: listItems(db, \"messages\") };\n152\t  } catch (cause) {\n153\t    const reason = cause instanceof Error ? cause.message : String(cause);\n154\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n155\t  } finally {\n156\t    db.close();\n157\t  }\n158\t}\n159\t"}]},"parent_tool_use_id":null,"session_id":"0d748447-7717-482c-80b3-edb3c328c1b5","uuid":"47b49d0e-76b3-4c5d-8d93-a7f5f55e3378","timestamp":"2026-06-10T15:28:21.320Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"import { existsSync } from \"node:fs\";\nimport type { OperationContext } from \"../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  listItems,\n  recordItem,\n  type WorkItemRecord,\n  type WorkKind,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport { projectEvent } from \"./internal/project.js\";\nimport { insertMessage, readMessages } from \"./internal/store.js\";\n\nexport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n\nexport interface Block {\n  blockType: BlockType;\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n}\n\nexport interface MessageRecord {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: Exclude<EventKind, \"turn_end\">;\n  blocks: Block[];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  turnId?: string;\n}\n\n// The event as the walk holds it after recording: the validated input plus\n// its server-stamped order and timestamp.\nexport type RecordedEvent = EventRecord;\n\nexport type MessageCreated = {\n  messageId: string;\n  kind: Exclude<EventKind, \"turn_end\">;\n} | null;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// (the first such call through the operation context; turns.applyEvent\n// follows the pattern in Story 4). Synchronous and throwing by design: a\n// projection failure propagates to the pipeline's catch and rejects the\n// whole batch — recorded events without messages is the stranded state the\n// transaction exists to prevent. Returns null for turn_end (no message).\n// turnId is the membership stamp, settled by the pipeline before this call:\n// the turn open *after* this event's transition (so a prompt belongs to the\n// turn it just opened), or null in a gap — written once, never updated.\nexport function createFromEvent(\n  ctx: OperationContext,\n  event: RecordedEvent,\n  turnId: string | null,\n): MessageCreated {\n  const projected = projectEvent(event);\n  if (projected === null) return null;\n  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n  const messageId = `m${event.eventOrder}`;\n  insertMessage(ctx.db, {\n    messageId,\n    sourceEventOrder: event.eventOrder,\n    kind,\n    tokenEstimate: projected.tokenEstimate,\n    actor: event.actor,\n    harness: event.harness,\n    turnId,\n    blocks: projected.blocks,\n  });\n  return { messageId, kind };\n}\n\n// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n// result queues tool_result_summary, nothing else queues anything — text,\n// thinking, and note messages are not derivation sources (AC-2.8, AC-2.7's\n// TC-2.9 half). Cross-domain surface, called by intake-stream inside the\n// batch transaction for every recorded message, so the item commits (or\n// rolls back) with the batch.\nconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n  user_prompt: \"prompt_smoothing\",\n  tool_result: \"tool_result_summary\",\n};\n\nexport function queueMessageWork(\n  ctx: OperationContext,\n  message: MessageCreated,\n): WorkItemRecord[] {\n  if (message === null) return [];\n  const kind = MESSAGE_WORK_KINDS[message.kind];\n  if (kind === undefined) return [];\n  const item = recordItem(\n    ctx.db,\n    { owner: \"messages\", kind, sourceRef: { messageId: message.messageId } },\n    ctx.clock().toISOString(),\n  );\n  return [item];\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listMessages(\n  thread: ThreadRef,\n): Promise<OpResult<MessageRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file and migrates\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\n  // unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: readMessages(db) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`message read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"messages\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":159,"startLine":1,"totalLines":159}}}

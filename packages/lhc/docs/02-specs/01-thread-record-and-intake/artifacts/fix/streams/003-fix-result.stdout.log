{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011JyFbvo6uEnVKwDGZvuR9h","type":"tool_result","content":"1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4\t// Stories 3–5 extend the same per-event walk with projection, turn\n5\t// transitions, and work queueing.\n6\timport { existsSync } from \"node:fs\";\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport type { OperationContext } from \"../../../shared/context.js\";\n9\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n10\timport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n11\timport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\n12\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n13\timport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\n14\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n15\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n16\t\n17\t// Test seam (set only through test/fixtures): called after each event is\n18\t// processed inside the walk, so atomicity under mid-walk failure can be\n19\t// induced through a real mechanism — closing the handle — rather than a\n20\t// mocked transaction object.\n21\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n22\tlet walkHook: IntakeWalkHook | null = null;\n23\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n24\t  walkHook = hook;\n25\t}\n26\t\n27\t// Test seam (set only through test/fixtures): replaces the wall clock so\n28\t// recordedAt is sourced deterministically for the public SDK contract proof —\n29\t// TC-1.4 records the same batch through both reference forms and reads it back\n30\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n31\t// production: recording stamps real wall time. An explicit clock argument to\n32\t// runMessageEvents still wins over the seam.\n33\tlet injectedClock: (() => Date) | null = null;\n34\texport function setIntakeClock(clock: (() => Date) | null): void {\n35\t  injectedClock = clock;\n36\t}\n37\t\n38\tfunction detail(cause: unknown): string {\n39\t  return cause instanceof Error ? cause.message : String(cause);\n40\t}\n41\t\n42\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n43\t  return {\n44\t    ok: false,\n45\t    error: {\n46\t      errorClass: \"caller_error\",\n47\t      code: \"thread_not_found\",\n48\t      reason: `no thread file exists at ${filePath}`,\n49\t    },\n50\t  };\n51\t}\n52\t\n53\t// The skip set is read at transaction start and reads only the key column:\n54\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n55\t// Chunked to stay under SQLite's bound-parameter limit.\n56\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n57\t  const found = new Set<string>();\n58\t  for (let offset = 0; offset < keys.length; offset += 400) {\n59\t    const chunk = keys.slice(offset, offset + 400);\n60\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n61\t    const rows = db\n62\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n63\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n64\t    for (const row of rows) found.add(row.idempotency_key);\n65\t  }\n66\t  return found;\n67\t}\n68\t\n69\tfunction threadIdOf(db: DatabaseSync): string {\n70\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n71\t    | { thread_id: string }\n72\t    | undefined;\n73\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n74\t  return row.thread_id;\n75\t}\n76\t\n77\tfunction maxEventOrder(db: DatabaseSync): number {\n78\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n79\t    | { max_order: number | bigint | null }\n80\t    | undefined;\n81\t  return Number(row?.max_order ?? 0);\n82\t}\n83\t\n84\texport async function runMessageEvents(\n85\t  thread: ThreadRef,\n86\t  events: readonly MessageEventInput[],\n87\t  clock: () => Date = injectedClock ?? (() => new Date()),\n88\t): Promise<OpResult<BatchResult>> {\n89\t  // Pure validation first: a rejected batch never opens the file, never takes\n90\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n91\t  // not a skip (validation-before-idempotency precedence).\n92\t  const refFailure = validateThreadRef(thread);\n93\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n94\t  const batchFailure = validateEvents(events);\n95\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n96\t\n97\t  const resolved = await resolveThreadRef(thread);\n98\t  if (!resolved.ok) return resolved;\n99\t  const { filePath } = resolved.value;\n100\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n101\t\n102\t  // openThreadDatabase verifies the file is a real thread file, then brings\n103\t  // its schema to the current version before the batch transaction begins,\n104\t  // so a thread recorded under an earlier story is writable here (F-03-001)\n105\t  // and a non-thread file is rejected unmutated (F-03-002).\n106\t  const opened = openThreadDatabase(filePath);\n107\t  if (!opened.ok) return opened;\n108\t  const db = opened.value;\n109\t\n110\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n111\t  // single-writer violations fail loudly at a defined point.\n112\t  let inTransaction = false;\n113\t  try {\n114\t    db.exec(\"BEGIN IMMEDIATE;\");\n115\t    inTransaction = true;\n116\t\n117\t    // Cross-domain calls inside the transaction share the open handle through\n118\t    // the operation context (design decision 8); built once per batch, never\n119\t    // stored.\n120\t    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n121\t\n122\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n123\t    // any event is processed — once is sufficient because only this pipeline\n124\t    // writes turn state and the write lock is already held, so more than one\n125\t    // open turn can only mean external interference. The batch records\n126\t    // nothing: nothing has been written yet, and the rollback closes the\n127\t    // never-used transaction.\n128\t    const openTurnIds = listOpenTurnIds(ctx);\n129\t    if (openTurnIds.length > 1) {\n130\t      db.exec(\"ROLLBACK;\");\n131\t      inTransaction = false;\n132\t      return {\n133\t        ok: false,\n134\t        error: {\n135\t          errorClass: \"state_corruption\",\n136\t          code: \"turn_state_corrupt\",\n137\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n138\t        },\n139\t      };\n140\t    }\n141\t\n142\t    const skipSet = recordedKeys(\n143\t      db,\n144\t      events.map((event) => event.idempotencyKey),\n145\t    );\n146\t    // Order counter from MAX(event_order): only recorded events increment it,\n147\t    // so skips consume no order numbers and the sequence stays dense.\n148\t    let lastOrder = maxEventOrder(db);\n149\t\n150\t    const insert = db.prepare(\n151\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n152\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n153\t    );\n154\t\n155\t    const eventResults: BatchResult[\"events\"] = [];\n156\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n157\t    // Work items append as they queue, in walk order — the result is a\n158\t    // faithful log of what the transaction did (AC-2.7). The full records\n159\t    // (status, queuedAt) stay in the thread file; the result carries item\n160\t    // identity only.\n161\t    const queuedItems: WorkItemRecord[] = [];\n162\t    for (const [index, event] of events.entries()) {\n163\t      if (skipSet.has(event.idempotencyKey)) {\n164\t        eventResults.push({\n165\t          idempotencyKey: event.idempotencyKey,\n166\t          outcome: \"skipped\",\n167\t          skipReason: \"duplicate_idempotency_key\",\n168\t        });\n169\t      } else {\n170\t        lastOrder += 1;\n171\t        const recordedAt = clock().toISOString();\n172\t        insert.run(\n173\t          lastOrder,\n174\t          event.eventKind,\n175\t          event.idempotencyKey,\n176\t          event.actor,\n177\t          event.harness,\n178\t          JSON.stringify(event.payload),\n179\t          recordedAt,\n180\t        );\n181\t        skipSet.add(event.idempotencyKey);\n182\t        // Turn transition before projection — the order is load-bearing: a\n183\t        // prompt transitions first and stamps to the turn it just opened\n184\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n185\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n186\t        // call, so a resend causes no transition (TC-5.4).\n187\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n188\t        turnTransitions.push(...turnOutcome.transitions);\n189\t        queuedItems.push(...turnOutcome.queuedWork);\n190\t        // Projection runs in the same iteration that recorded the event, so\n191\t        // it can never drift from its source; a projection failure throws\n192\t        // and rejects the whole batch. Skipped events never reach this call\n193\t        // (no duplicate message, AC-5.4).\n194\t        const created = createFromEvent(\n195\t          ctx,\n196\t          {\n197\t            ...event,\n198\t            eventOrder: lastOrder,\n199\t            recordedAt,\n200\t          },\n201\t          turnOutcome.openTurnId,\n202\t        );\n203\t        // Message-owned work queues in the same iteration, gated on\n204\t        // recorded: a skipped event never reaches this call, so it queues\n205\t        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n206\t        // decides which messages are derivation sources (AC-2.8).\n207\t        queuedItems.push(...queueMessageWork(ctx, created));\n208\t        const entry: BatchResult[\"events\"][number] = {\n209\t          idempotencyKey: event.idempotencyKey,\n210\t          outcome: \"recorded\",\n211\t        };\n212\t        if (created !== null) entry.messageId = created.messageId;\n213\t        eventResults.push(entry);\n214\t      }\n215\t      walkHook?.(db, index);\n216\t    }\n217\t\n218\t    db.exec(\"COMMIT;\");\n219\t    inTransaction = false;\n220\t\n221\t    return {\n222\t      ok: true,\n223\t      value: {\n224\t        events: eventResults,\n225\t        turnTransitions,\n226\t        queuedWork: queuedItems.map((item) => ({\n227\t          workItemId: item.workItemId,\n228\t          owner: item.owner,\n229\t          kind: item.kind,\n230\t          sourceRef: item.sourceRef,\n231\t        })),\n232\t        threadPosition: { lastEventOrder: lastOrder },\n233\t      },\n234\t    };\n235\t  } catch (cause) {\n236\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n237\t    // class-independent. The handle may already be gone (induced failure),\n238\t    // in which case SQLite has already discarded the uncommitted transaction.\n239\t    if (inTransaction) {\n240\t      try {\n241\t        db.exec(\"ROLLBACK;\");\n242\t      } catch {\n243\t        // handle closed mid-walk; the open transaction died with it\n244\t      }\n245\t    }\n246\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n247\t  } finally {\n248\t    try {\n249\t      db.close();\n250\t    } catch {\n251\t      // already closed by the induced-failure seam\n252\t    }\n253\t  }\n254\t}\n255\t\n256\tinterface RawEventRow {\n257\t  event_order: number | bigint;\n258\t  event_kind: string;\n259\t  idempotency_key: string;\n260\t  actor: string;\n261\t  harness: string;\n262\t  payload: string;\n263\t  recorded_at: string;\n264\t}\n265\t\n266\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n267\t  const refFailure = validateThreadRef(thread);\n268\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n269\t\n270\t  const resolved = await resolveThreadRef(thread);\n271\t  if (!resolved.ok) return resolved;\n272\t  const { filePath } = resolved.value;\n273\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n274\t\n275\t  const opened = openThreadDatabase(filePath);\n276\t  if (!opened.ok) return opened;\n277\t  const db = opened.value;\n278\t  try {\n279\t    const rows = db\n280\t      .prepare(\n281\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n282\t         FROM event ORDER BY event_order`,\n283\t      )\n284\t      .all() as unknown as RawEventRow[];\n285\t    const records = rows.map(\n286\t      (row) =>\n287\t        ({\n288\t          eventKind: row.event_kind,\n289\t          idempotencyKey: row.idempotency_key,\n290\t          actor: row.actor,\n291\t          harness: row.harness,\n292\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n293\t          eventOrder: Number(row.event_order),\n294\t          recordedAt: row.recorded_at,\n295\t        }) as unknown as EventRecord,\n296\t    );\n297\t    return { ok: true, value: records };\n298\t  } catch (cause) {\n299\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n300\t  } finally {\n301\t    db.close();\n302\t  }\n303\t}\n304\t"}]},"parent_tool_use_id":null,"session_id":"36778e1e-3bb5-45c6-8164-3cc17eb2f31a","uuid":"8871c892-dcad-45a3-ab0d-0124309b2020","timestamp":"2026-06-10T15:38:28.586Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n// Stories 3–5 extend the same per-event walk with projection, turn\n// transitions, and work queueing.\nimport { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\nimport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\nimport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\nimport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\nimport { validateEvents, validateThreadRef } from \"./validate.js\";\n\n// Test seam (set only through test/fixtures): called after each event is\n// processed inside the walk, so atomicity under mid-walk failure can be\n// induced through a real mechanism — closing the handle — rather than a\n// mocked transaction object.\nexport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\nlet walkHook: IntakeWalkHook | null = null;\nexport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n  walkHook = hook;\n}\n\n// Test seam (set only through test/fixtures): replaces the wall clock so\n// recordedAt is sourced deterministically for the public SDK contract proof —\n// TC-1.4 records the same batch through both reference forms and reads it back\n// field-for-field, recordedAt included, with nothing stripped. Unset in\n// production: recording stamps real wall time. An explicit clock argument to\n// runMessageEvents still wins over the seam.\nlet injectedClock: (() => Date) | null = null;\nexport function setIntakeClock(clock: (() => Date) | null): void {\n  injectedClock = clock;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The skip set is read at transaction start and reads only the key column:\n// key-wins-over-content is the absence of a content comparison (AC-5.5).\n// Chunked to stay under SQLite's bound-parameter limit.\nfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n  const found = new Set<string>();\n  for (let offset = 0; offset < keys.length; offset += 400) {\n    const chunk = keys.slice(offset, offset + 400);\n    const placeholders = chunk.map(() => \"?\").join(\", \");\n    const rows = db\n      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    for (const row of rows) found.add(row.idempotency_key);\n  }\n  return found;\n}\n\nfunction threadIdOf(db: DatabaseSync): string {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n  return row.thread_id;\n}\n\nfunction maxEventOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0);\n}\n\nexport async function runMessageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n  clock: () => Date = injectedClock ?? (() => new Date()),\n): Promise<OpResult<BatchResult>> {\n  // Pure validation first: a rejected batch never opens the file, never takes\n  // the write lock, and a duplicate key on a malformed event is a rejection,\n  // not a skip (validation-before-idempotency precedence).\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n  const batchFailure = validateEvents(events);\n  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file, then brings\n  // its schema to the current version before the batch transaction begins,\n  // so a thread recorded under an earlier story is writable here (F-03-001)\n  // and a non-thread file is rejected unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n\n  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n  // single-writer violations fail loudly at a defined point.\n  let inTransaction = false;\n  try {\n    db.exec(\"BEGIN IMMEDIATE;\");\n    inTransaction = true;\n\n    // Cross-domain calls inside the transaction share the open handle through\n    // the operation context (design decision 8); built once per batch, never\n    // stored.\n    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n\n    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n    // any event is processed — once is sufficient because only this pipeline\n    // writes turn state and the write lock is already held, so more than one\n    // open turn can only mean external interference. The batch records\n    // nothing: nothing has been written yet, and the rollback closes the\n    // never-used transaction.\n    const openTurnIds = listOpenTurnIds(ctx);\n    if (openTurnIds.length > 1) {\n      db.exec(\"ROLLBACK;\");\n      inTransaction = false;\n      return {\n        ok: false,\n        error: {\n          errorClass: \"state_corruption\",\n          code: \"turn_state_corrupt\",\n          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n        },\n      };\n    }\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    const eventResults: BatchResult[\"events\"] = [];\n    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n    // Work items append as they queue, in walk order — the result is a\n    // faithful log of what the transaction did (AC-2.7). The full records\n    // (status, queuedAt) stay in the thread file; the result carries item\n    // identity only.\n    const queuedItems: WorkItemRecord[] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        const recordedAt = clock().toISOString();\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          recordedAt,\n        );\n        skipSet.add(event.idempotencyKey);\n        // Turn transition before projection — the order is load-bearing: a\n        // prompt transitions first and stamps to the turn it just opened\n        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n        // call, so a resend causes no transition (TC-5.4).\n        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n        turnTransitions.push(...turnOutcome.transitions);\n        queuedItems.push(...turnOutcome.queuedWork);\n        // Projection runs in the same iteration that recorded the event, so\n        // it can never drift from its source; a projection failure throws\n        // and rejects the whole batch. Skipped events never reach this call\n        // (no duplicate message, AC-5.4).\n        const created = createFromEvent(\n          ctx,\n          {\n            ...event,\n            eventOrder: lastOrder,\n            recordedAt,\n          },\n          turnOutcome.openTurnId,\n        );\n        // Message-owned work queues in the same iteration, gated on\n        // recorded: a skipped event never reaches this call, so it queues\n        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n        // decides which messages are derivation sources (AC-2.8).\n        queuedItems.push(...queueMessageWork(ctx, created));\n        const entry: BatchResult[\"events\"][number] = {\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"recorded\",\n        };\n        if (created !== null) entry.messageId = created.messageId;\n        eventResults.push(entry);\n      }\n      walkHook?.(db, index);\n    }\n\n    db.exec(\"COMMIT;\");\n    inTransaction = false;\n\n    return {\n      ok: true,\n      value: {\n        events: eventResults,\n        turnTransitions,\n        queuedWork: queuedItems.map((item) => ({\n          workItemId: item.workItemId,\n          owner: item.owner,\n          kind: item.kind,\n          sourceRef: item.sourceRef,\n        })),\n        threadPosition: { lastEventOrder: lastOrder },\n      },\n    };\n  } catch (cause) {\n    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n    // class-independent. The handle may already be gone (induced failure),\n    // in which case SQLite has already discarded the uncommitted transaction.\n    if (inTransaction) {\n      try {\n        db.exec(\"ROLLBACK;\");\n      } catch {\n        // handle closed mid-walk; the open transaction died with it\n      }\n    }\n    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n  } finally {\n    try {\n      db.close();\n    } catch {\n      // already closed by the induced-failure seam\n    }\n  }\n}\n\ninterface RawEventRow {\n  event_order: number | bigint;\n  event_kind: string;\n  idempotency_key: string;\n  actor: string;\n  harness: string;\n  payload: string;\n  recorded_at: string;\n}\n\nexport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const rows = db\n      .prepare(\n        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n         FROM event ORDER BY event_order`,\n      )\n      .all() as unknown as RawEventRow[];\n    const records = rows.map(\n      (row) =>\n        ({\n          eventKind: row.event_kind,\n          idempotencyKey: row.idempotency_key,\n          actor: row.actor,\n          harness: row.harness,\n          payload: JSON.parse(row.payload) as Record<string, unknown>,\n          eventOrder: Number(row.event_order),\n          recordedAt: row.recorded_at,\n        }) as unknown as EventRecord,\n    );\n    return { ok: true, value: records };\n  } catch (cause) {\n    return storageFailure(`event read-back failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":304,"startLine":1,"totalLines":304}}}

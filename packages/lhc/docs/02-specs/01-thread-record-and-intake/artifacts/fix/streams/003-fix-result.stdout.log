tCode: result.ok ? 0 : 1,\n    stdout: `${JSON.stringify(result, null, 2)}\\n`,\n    stderr: \"\",\n  };\n}\n\nexport function renderCliError(\n  errorClass: ErrorClass,\n  code: CliErrorCode,\n  reason: string,\n): CliResult {\n  return {\n    exitCode: 1,\n    stdout: `${JSON.stringify({ ok: false, error: { errorClass, code, reason } }, null, 2)}\\n`,\n    stderr: \"\",\n  };\n}\n","numLines":33,"startLine":1,"totalLines":33}}}

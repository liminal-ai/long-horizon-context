esult":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/red-manifest.json","content":"{\n  \"files\": {\n    \"test/threads.test.ts\": \"f728caa272e0cb5bc22b98c785dd4718710d4dbfe4e124d8c055dd8a1967041a\",\n    \"test/smoke.test.ts\": \"1e782fd17e0a95835a71ddc258a55a84c440714bca23af56a400603d1cc9dea0\",\n    \"test/cli-process.test.ts\": \"9b176d562952df702168c170065091326ec4f981f1001f3b19d07f69e8a488db\",\n    \"test/validation.test.ts\": \"4d1021c6c3a677002f1fac9209673912369a7a71c058487be06b9ae036c00045\",\n    \"test/idempotency.test.ts\": \"715b2a8cbfa9eac1029ec431745ec898e493ba6be849e86676475ff4611b3079\",\n    \"test/intake.test.ts\": \"0e256695a85351b6895b7881c8a64cf9fd921b5fd552d5221569695c2aa1f6d6\",\n    \"test/cli-process-intake.test.ts\": \"fb684b10aeb3b328e27811b5036467e0d1866d7b5accfc78eb0dee96d512872f\",\n    \"test/projection.test.ts\": \"35c1b3fa2a45932df8f92a743d0f47f2b769aa5cda316c5f4e47483cc02ae039\",\n    \"test/cli-process-projection.test.ts\": \"ef4770eacb01448c0414a4316ed0b1be17d45b42d2fa6dbead26f496f93b35e3\",\n    \"test/thread-migration.test.ts\": \"2d123de236690673eb2e2b0cd405aa3ae31f0616a044d93a430cf3f1a0123b86\",\n    \"test/turns.test.ts\": \"e97608cae9dfbab3f71ad3643bd8e509d8a696e0b07028ee94b8c4abae3a3e4f\",\n    \"test/state-machine.test.ts\": \"c056bb4d49194d6157c8dcf98301a8a9fd028ef0a7aea74ddf136ff5945f84d9\",\n    \"test/cli-process-turns.test.ts\": \"baecaf4e8939e949e38cc21f2e78c342a21065aef55971412cc2f5d326e14ba2\",\n    \"test/work-queue.test.ts\": \"771b8656581682635c674488583898cd295dca539b74287af9ea5bc135d937d5\",\n    \"test/cli-process-work-queue.test.ts\": \"10b8b43235769fb5755734689a41d53bd5868571718ff84b1ae365fd7fa1e808\"\n  }\n}\n","numLines":20,"startLine":1,"totalLines":20}}}

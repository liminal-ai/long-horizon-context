{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ACU8HHHvV4JBu1JMmkvzhK","type":"tool_result","content":"1\t// Flow 1: thread creation, registry, resolution (TC-1.1, 1.2, 1.3, 1.5, 1.6\n2\t// plus lazy-init and read-path-equivalence supplementals). TC-1.4 is owned by\n3\t// Story 2 and lives in test/intake.test.ts.\n4\timport { existsSync, readFileSync, writeFileSync } from \"node:fs\";\n5\timport { join } from \"node:path\";\n6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n7\timport { runCli, threads, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n8\timport { openRaw, tempStore, type TempStore } from \"./fixtures/index.js\";\n9\t\n10\tinterface MetadataRow {\n11\t  thread_id: string;\n12\t  created_at: string;\n13\t  token_estimator: string;\n14\t}\n15\t\n16\tinterface RegistryRow {\n17\t  thread_id: string;\n18\t  file_path: string;\n19\t  title: string | null;\n20\t  created_at: string;\n21\t}\n22\t\n23\tfunction readMetadata(threadPath: string): MetadataRow {\n24\t  const db = openRaw(threadPath);\n25\t  try {\n26\t    return db\n27\t      .prepare(\"SELECT thread_id, created_at, token_estimator FROM thread_metadata\")\n28\t      .get() as unknown as MetadataRow;\n29\t  } finally {\n30\t    db.close();\n31\t  }\n32\t}\n33\t\n34\tfunction registryRows(registryPath: string): RegistryRow[] {\n35\t  const db = openRaw(registryPath);\n36\t  try {\n37\t    return db\n38\t      .prepare(\n39\t        \"SELECT thread_id, file_path, title, created_at FROM threads ORDER BY created_at, thread_id\",\n40\t      )\n41\t      .all() as unknown as RegistryRow[];\n42\t  } finally {\n43\t    db.close();\n44\t  }\n45\t}\n46\t\n47\tlet store: TempStore;\n48\tbeforeEach(() => {\n49\t  store = tempStore();\n50\t});\n51\tafterEach(() => {\n52\t  store.cleanup();\n53\t});\n54\t\n55\tdescribe(\"Flow 1 (SDK): thread creation, registry, resolution\", () => {\n56\t  it(\"TC-1.1: create at a fresh path — file, metadata row, registry row\", async () => {\n57\t    const threadPath = store.threadPath();\n58\t    const result = await threads.newThread({\n59\t      filePath: threadPath,\n60\t      title: \"first thread\",\n61\t      registryPath: store.registryPath,\n62\t    });\n63\t\n64\t    expect(result.ok).toBe(true);\n65\t    if (!result.ok) return;\n66\t    expect(result.value.filePath).toBe(threadPath);\n67\t    expect(result.value.threadId).toMatch(/^th_[a-z0-9]+$/);\n68\t    expect(existsSync(threadPath)).toBe(true);\n69\t\n70\t    // AC-1.3: the id reads back from the file alone, no registry involved.\n71\t    const metadata = readMetadata(threadPath);\n72\t    expect(metadata.thread_id).toBe(result.value.threadId);\n73\t    expect(metadata.token_estimator).toBe(TOKEN_ESTIMATOR_ID);\n74\t    expect(new Date(metadata.created_at).toISOString()).toBe(metadata.created_at);\n75\t\n76\t    const rows = registryRows(store.registryPath);\n77\t    expect(rows).toHaveLength(1);\n78\t    expect(rows[0]).toEqual({\n79\t      thread_id: result.value.threadId,\n80\t      file_path: threadPath,\n81\t      title: \"first thread\",\n82\t      created_at: metadata.created_at,\n83\t    });\n84\t  });\n85\t\n86\t  it(\"TC-1.2: occupied path refused, file untouched, registry unchanged\", async () => {\n87\t    const first = await threads.newThread({\n88\t      filePath: store.threadPath(),\n89\t      registryPath: store.registryPath,\n90\t    });\n91\t    expect(first.ok).toBe(true);\n92\t\n93\t    const occupied = join(store.dir, \"occupied.bin\");\n94\t    const originalBytes = \"pre-existing content that must survive\";\n95\t    writeFileSync(occupied, originalBytes);\n96\t\n97\t    const result = await threads.newThread({\n98\t      filePath: occupied,\n99\t      registryPath: store.registryPath,\n100\t    });\n101\t    expect(result.ok).toBe(false);\n102\t    if (result.ok) return;\n103\t    expect(result.error.code).toBe(\"path_exists\");\n104\t    expect(result.error.errorClass).toBe(\"caller_error\");\n105\t\n106\t    expect(readFileSync(occupied, \"utf8\")).toBe(originalBytes);\n107\t    expect(registryRows(store.registryPath)).toHaveLength(1);\n108\t  });\n109\t\n110\t  it(\"TC-1.3: resolve known id returns path and metadata; unknown id fails thread_not_found\", async () => {\n111\t    const threadPath = store.threadPath();\n112\t    const created = await threads.newThread({\n113\t      filePath: threadPath,\n114\t      title: \"resolvable\",\n115\t      registryPath: store.registryPath,\n116\t    });\n117\t    expect(created.ok).toBe(true);\n118\t    if (!created.ok) return;\n119\t\n120\t    const known = await threads.resolve({\n121\t      threadId: created.value.threadId,\n122\t      registryPath: store.registryPath,\n123\t    });\n124\t    expect(known.ok).toBe(true);\n125\t    if (!known.ok) return;\n126\t    expect(known.value.threadId).toBe(created.value.threadId);\n127\t    expect(known.value.filePath).toBe(threadPath);\n128\t    expect(known.value.title).toBe(\"resolvable\");\n129\t    expect(known.value.createdAt).toBe(readMetadata(threadPath).created_at);\n130\t\n131\t    const unknown = await threads.resolve({\n132\t      threadId: \"th_does_not_exist\",\n133\t      registryPath: store.registryPath,\n134\t    });\n135\t    expect(unknown.ok).toBe(false);\n136\t    if (unknown.ok) return;\n137\t    expect(unknown.error.code).toBe(\"thread_not_found\");\n138\t    expect(unknown.error.errorClass).toBe(\"caller_error\");\n139\t  });\n140\t\n141\t  it(\"TC-1.5: listing returns all rows; absent registry lists empty without creating a file\", async () => {\n142\t    const created: Array<{ threadId: string; filePath: string }> = [];\n143\t    for (const title of [\"one\", \"two\", \"three\"]) {\n144\t      const result = await threads.newThread({\n145\t        filePath: store.threadPath(title),\n146\t        title,\n147\t        registryPath: store.registryPath,\n148\t      });\n149\t      expect(result.ok).toBe(true);\n150\t      if (result.ok) created.push(result.value);\n151\t    }\n152\t\n153\t    const listed = await threads.listThreads({ registryPath: store.registryPath });\n154\t    expect(listed.ok).toBe(true);\n155\t    if (!listed.ok) return;\n156\t    expect(listed.value).toHaveLength(3);\n157\t    const byId = new Map(listed.value.map((info) => [info.threadId, info]));\n158\t    for (const [index, title] of [\"one\", \"two\", \"three\"].entries()) {\n159\t      const info = byId.get(created[index]!.threadId);\n160\t      expect(info).toBeDefined();\n161\t      expect(info?.filePath).toBe(created[index]!.filePath);\n162\t      expect(info?.title).toBe(title);\n163\t      expect(info?.createdAt).toBeTruthy();\n164\t    }\n165\t\n166\t    const absentPath = join(store.dir, \"never-written.sqlite\");\n167\t    const empty = await threads.listThreads({ registryPath: absentPath });\n168\t    expect(empty.ok).toBe(true);\n169\t    if (!empty.ok) return;\n170\t    expect(empty.value).toEqual([]);\n171\t    expect(existsSync(absentPath)).toBe(false);\n172\t  });\n173\t\n174\t  it(\"TC-1.6: registry insert failure compensates — thread file deleted, no registry, no orphan row\", async () => {\n175\t    const blocker = join(store.dir, \"blocker\");\n176\t    writeFileSync(blocker, \"a regular file where a directory must be\");\n177\t    const badRegistry = join(blocker, \"registry.sqlite\");\n178\t\n179\t    const threadPath = store.threadPath();\n180\t    const result = await threads.newThread({\n181\t      filePath: threadPath,\n182\t      registryPath: badRegistry,\n183\t    });\n184\t    expect(result.ok).toBe(false);\n185\t    if (result.ok) return;\n186\t    expect(result.error.errorClass).toBe(\"system_error\");\n187\t    expect(result.error.code).toBe(\"storage_failure\");\n188\t\n189\t    expect(existsSync(threadPath)).toBe(false);\n190\t    expect(existsSync(badRegistry)).toBe(false);\n191\t    expect(readFileSync(blocker, \"utf8\")).toBe(\n192\t      \"a regular file where a directory must be\",\n193\t    );\n194\t  });\n195\t\n196\t  it(\"lazy-init supplemental: resolve against an absent registry returns thread_not_found and creates nothing\", async () => {\n197\t    const absentPath = join(store.dir, \"absent-registry.sqlite\");\n198\t    const result = await threads.resolve({\n199\t      threadId: \"th_anything\",\n200\t      registryPath: absentPath,\n201\t    });\n202\t    expect(result.ok).toBe(false);\n203\t    if (result.ok) return;\n204\t    expect(result.error.code).toBe(\"thread_not_found\");\n205\t    expect(existsSync(absentPath)).toBe(false);\n206\t  });\n207\t\n208\t  it(\"read-path equivalence: resolveThreadRef lands id and path references on the same file\", async () => {\n209\t    const threadPath = store.threadPath();\n210\t    const created = await threads.newThread({\n211\t      filePath: threadPath,\n212\t      registryPath: store.registryPath,\n213\t    });\n214\t    expect(created.ok).toBe(true);\n215\t    if (!created.ok) return;\n216\t\n217\t    const byId = await threads.resolveThreadRef({\n218\t      threadId: created.value.threadId,\n219\t      registryPath: store.registryPath,\n220\t    });\n221\t    const byPath = await threads.resolveThreadRef({ filePath: threadPath });\n222\t    expect(byId.ok).toBe(true);\n223\t    expect(byPath.ok).toBe(true);\n224\t    if (!byId.ok || !byPath.ok) return;\n225\t    expect(byId.value.filePath).toBe(threadPath);\n226\t    expect(byPath.value.filePath).toBe(threadPath);\n227\t\n228\t    // Both reads reach the same thread: identical metadata through either ref.\n229\t    expect(readMetadata(byId.value.filePath).thread_id).toBe(created.value.threadId);\n230\t    expect(readMetadata(byPath.value.filePath).thread_id).toBe(created.value.threadId);\n231\t\n232\t    const unknown = await threads.resolveThreadRef({\n233\t      threadId: \"th_unknown\",\n234\t      registryPath: store.registryPath,\n235\t    });\n236\t    expect(unknown.ok).toBe(false);\n237\t    if (unknown.ok) return;\n238\t    expect(unknown.error.code).toBe(\"thread_not_found\");\n239\t  });\n240\t\n241\t  // TC-1.4 (full id/path equivalence under message-events): Story 1's named\n242\t  // deferral, closed by Story 2 — the test lives in test/intake.test.ts.\n243\t});\n244\t\n245\tdescribe(\"Flow 1 (CLI in-process): threads commands\", () => {\n246\t  interface CliOk<T> {\n247\t    ok: true;\n248\t    value: T;\n249\t  }\n250\t  interface CliErr {\n251\t    ok: false;\n252\t    error: { errorClass: string; code: string; reason: string };\n253\t  }\n254\t\n255\t  function parseStdout<T>(stdout: string): CliOk<T> | CliErr {\n256\t    return JSON.parse(stdout) as CliOk<T> | CliErr;\n257\t  }\n258\t\n259\t  it(\"TC-1.1 (CLI): new-thread creates file, metadata, and registry row\", async () => {\n260\t    const threadPath = store.threadPath();\n261\t    const result = await runCli([\n262\t      \"threads\",\n263\t      \"new-thread\",\n264\t      \"--file-path\",\n265\t      threadPath,\n266\t      \"--title\",\n267\t      \"cli thread\",\n268\t      \"--registry\",\n269\t      store.registryPath,\n270\t    ]);\n271\t    expect(result.exitCode).toBe(0);\n272\t    const parsed = parseStdout<{ threadId: string; filePath: string }>(result.stdout);\n273\t    expect(parsed.ok).toBe(true);\n274\t    if (!parsed.ok) return;\n275\t    expect(parsed.value.filePath).toBe(threadPath);\n276\t    expect(readMetadata(threadPath).thread_id).toBe(parsed.value.threadId);\n277\t    expect(registryRows(store.registryPath)).toHaveLength(1);\n278\t  });\n279\t\n280\t  it(\"TC-1.2 (CLI): occupied path exits 1 with path_exists\", async () => {\n281\t    const occupied = join(store.dir, \"occupied.bin\");\n282\t    writeFileSync(occupied, \"already here\");\n283\t    const result = await runCli([\n284\t      \"threads\",\n285\t      \"new-thread\",\n286\t      \"--file-path\",\n287\t      occupied,\n288\t      \"--registry\",\n289\t      store.registryPath,\n290\t    ]);\n291\t    expect(result.exitCode).toBe(1);\n292\t    const parsed = parseStdout<never>(result.stdout);\n293\t    expect(parsed.ok).toBe(false);\n294\t    if (parsed.ok) return;\n295\t    expect(parsed.error.code).toBe(\"path_exists\");\n296\t    expect(readFileSync(occupied, \"utf8\")).toBe(\"already here\");\n297\t  });\n298\t\n299\t  it(\"TC-1.3 (CLI): resolve known id round-trips; unknown id exits 1 with thread_not_found\", async () => {\n300\t    const threadPath = store.threadPath();\n301\t    const created = await runCli([\n302\t      \"threads\",\n303\t      \"new-thread\",\n304\t      \"--file-path\",\n305\t      threadPath,\n306\t      \"--registry\",\n307\t      store.registryPath,\n308\t    ]);\n309\t    const createdParsed = parseStdout<{ threadId: string }>(created.stdout);\n310\t    expect(createdParsed.ok).toBe(true);\n311\t    if (!createdParsed.ok) return;\n312\t\n313\t    const known = await runCli([\n314\t      \"threads\",\n315\t      \"resolve\",\n316\t      \"--thread-id\",\n317\t      createdParsed.value.threadId,\n318\t      \"--registry\",\n319\t      store.registryPath,\n320\t    ]);\n321\t    expect(known.exitCode).toBe(0);\n322\t    const knownParsed = parseStdout<{ threadId: string; filePath: string }>(known.stdout);\n323\t    expect(knownParsed.ok).toBe(true);\n324\t    if (!knownParsed.ok) return;\n325\t    expect(knownParsed.value.filePath).toBe(threadPath);\n326\t\n327\t    const unknown = await runCli([\n328\t      \"threads\",\n329\t      \"resolve\",\n330\t      \"--thread-id\",\n331\t      \"th_nope\",\n332\t      \"--registry\",\n333\t      store.registryPath,\n334\t    ]);\n335\t    expect(unknown.exitCode).toBe(1);\n336\t    const unknownParsed = parseStdout<never>(unknown.stdout);\n337\t    expect(unknownParsed.ok).toBe(false);\n338\t    if (unknownParsed.ok) return;\n339\t    expect(unknownParsed.error.code).toBe(\"thread_not_found\");\n340\t  });\n341\t\n342\t  it(\"TC-1.5 (CLI): list returns created threads; absent registry lists empty and creates nothing\", async () => {\n343\t    for (const title of [\"a\", \"b\", \"c\"]) {\n344\t      const result = await runCli([\n345\t        \"threads\",\n346\t        \"new-thread\",\n347\t        \"--file-path\",\n348\t        store.threadPath(title),\n349\t        \"--title\",\n350\t        title,\n351\t        \"--registry\",\n352\t        store.registryPath,\n353\t      ]);\n354\t      expect(result.exitCode).toBe(0);\n355\t    }\n356\t    const listed = await runCli([\"threads\", \"list\", \"--registry\", store.registryPath]);\n357\t    expect(listed.exitCode).toBe(0);\n358\t    const parsed = parseStdout<Array<{ threadId: string; title?: string }>>(listed.stdout);\n359\t    expect(parsed.ok).toBe(true);\n360\t    if (!parsed.ok) return;\n361\t    expect(parsed.value).toHaveLength(3);\n362\t    expect(parsed.value.map((row) => row.title).sort()).toEqual([\"a\", \"b\", \"c\"]);\n363\t\n364\t    const absentPath = join(store.dir, \"absent.sqlite\");\n365\t    const empty = await runCli([\"threads\", \"list\", \"--registry\", absentPath]);\n366\t    expect(empty.exitCode).toBe(0);\n367\t    const emptyParsed = parseStdout<unknown[]>(empty.stdout);\n368\t    expect(emptyParsed.ok).toBe(true);\n369\t    if (!emptyParsed.ok) return;\n370\t    expect(emptyParsed.value).toEqual([]);\n371\t    expect(existsSync(absentPath)).toBe(false);\n372\t  });\n373\t\n374\t  it(\"TC-1.6 (CLI): registry failure compensates — exit 1 and the thread file is gone\", async () => {\n375\t    const blocker = join(store.dir, \"blocker\");\n376\t    writeFileSync(blocker, \"regular file\");\n377\t    const threadPath = store.threadPath();\n378\t    const result = await runCli([\n379\t      \"threads\",\n380\t      \"new-thread\",\n381\t      \"--file-path\",\n382\t      threadPath,\n383\t      \"--registry\",\n384\t      join(blocker, \"registry.sqlite\"),\n385\t    ]);\n386\t    expect(result.exitCode).toBe(1);\n387\t    const parsed = parseStdout<never>(result.stdout);\n388\t    expect(parsed.ok).toBe(false);\n389\t    if (parsed.ok) return;\n390\t    expect(parsed.error.errorClass).toBe(\"system_error\");\n391\t    expect(existsSync(threadPath)).toBe(false);\n392\t  });\n393\t});\n394\t"}]},"parent_tool_use_id":null,"session_id":"36778e1e-3bb5-45c6-8164-3cc17eb2f31a","uuid":"c1899ac0-8b22-42c4-aaa8-efef43a6df71","timestamp":"2026-06-10T15:39:14.068Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/threads.test.ts","content":"// Flow 1: thread creation, registry, resolution (TC-1.1, 1.2, 1.3, 1.5, 1.6\n// plus lazy-init and read-path-equivalence supplementals). TC-1.4 is owned by\n// Story 2 and lives in test/intake.test.ts.\nimport { existsSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { runCli, threads, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\nimport { openRaw, tempStore, type TempStore } from \"./fixtures/index.js\";\n\ninterface MetadataRow {\n  thread_id: string;\n  created_at: string;\n  token_estimator: string;\n}\n\ninterface RegistryRow {\n  thread_id: string;\n  file_path: string;\n  title: string | null;\n  created_at: string;\n}\n\nfunction readMetadata(threadPath: string): MetadataRow {\n  const db = openRaw(threadPath);\n  try {\n    return db\n      .prepare(\"SELECT thread_id, created_at, token_estimator FROM thread_metadata\")\n      .get() as unknown as MetadataRow;\n  } finally {\n    db.close();\n  }\n}\n\nfunction registryRows(registryPath: string): RegistryRow[] {\n  const db = openRaw(registryPath);\n  try {\n    return db\n      .prepare(\n        \"SELECT thread_id, file_path, title, created_at FROM threads ORDER BY created_at, thread_id\",\n      )\n      .all() as unknown as RegistryRow[];\n  } finally {\n    db.close();\n  }\n}\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\ndescribe(\"Flow 1 (SDK): thread creation, registry, resolution\", () => {\n  it(\"TC-1.1: create at a fresh path — file, metadata row, registry row\", async () => {\n    const threadPath = store.threadPath();\n    const result = await threads.newThread({\n      filePath: threadPath,\n      title: \"first thread\",\n      registryPath: store.registryPath,\n    });\n\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n    expect(result.value.filePath).toBe(threadPath);\n    expect(result.value.threadId).toMatch(/^th_[a-z0-9]+$/);\n    expect(existsSync(threadPath)).toBe(true);\n\n    // AC-1.3: the id reads back from the file alone, no registry involved.\n    const metadata = readMetadata(threadPath);\n    expect(metadata.thread_id).toBe(result.value.threadId);\n    expect(metadata.token_estimator).toBe(TOKEN_ESTIMATOR_ID);\n    expect(new Date(metadata.created_at).toISOString()).toBe(metadata.created_at);\n\n    const rows = registryRows(store.registryPath);\n    expect(rows).toHaveLength(1);\n    expect(rows[0]).toEqual({\n      thread_id: result.value.threadId,\n      file_path: threadPath,\n      title: \"first thread\",\n      created_at: metadata.created_at,\n    });\n  });\n\n  it(\"TC-1.2: occupied path refused, file untouched, registry unchanged\", async () => {\n    const first = await threads.newThread({\n      filePath: store.threadPath(),\n      registryPath: store.registryPath,\n    });\n    expect(first.ok).toBe(true);\n\n    const occupied = join(store.dir, \"occupied.bin\");\n    const originalBytes = \"pre-existing content that must survive\";\n    writeFileSync(occupied, originalBytes);\n\n    const result = await threads.newThread({\n      filePath: occupied,\n      registryPath: store.registryPath,\n    });\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.code).toBe(\"path_exists\");\n    expect(result.error.errorClass).toBe(\"caller_error\");\n\n    expect(readFileSync(occupied, \"utf8\")).toBe(originalBytes);\n    expect(registryRows(store.registryPath)).toHaveLength(1);\n  });\n\n  it(\"TC-1.3: resolve known id returns path and metadata; unknown id fails thread_not_found\", async () => {\n    const threadPath = store.threadPath();\n    const created = await threads.newThread({\n      filePath: threadPath,\n      title: \"resolvable\",\n      registryPath: store.registryPath,\n    });\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n\n    const known = await threads.resolve({\n      threadId: created.value.threadId,\n      registryPath: store.registryPath,\n    });\n    expect(known.ok).toBe(true);\n    if (!known.ok) return;\n    expect(known.value.threadId).toBe(created.value.threadId);\n    expect(known.value.filePath).toBe(threadPath);\n    expect(known.value.title).toBe(\"resolvable\");\n    expect(known.value.createdAt).toBe(readMetadata(threadPath).created_at);\n\n    const unknown = await threads.resolve({\n      threadId: \"th_does_not_exist\",\n      registryPath: store.registryPath,\n    });\n    expect(unknown.ok).toBe(false);\n    if (unknown.ok) return;\n    expect(unknown.error.code).toBe(\"thread_not_found\");\n    expect(unknown.error.errorClass).toBe(\"caller_error\");\n  });\n\n  it(\"TC-1.5: listing returns all rows; absent registry lists empty without creating a file\", async () => {\n    const created: Array<{ threadId: string; filePath: string }> = [];\n    for (const title of [\"one\", \"two\", \"three\"]) {\n      const result = await threads.newThread({\n        filePath: store.threadPath(title),\n        title,\n        registryPath: store.registryPath,\n      });\n      expect(result.ok).toBe(true);\n      if (result.ok) created.push(result.value);\n    }\n\n    const listed = await threads.listThreads({ registryPath: store.registryPath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    expect(listed.value).toHaveLength(3);\n    const byId = new Map(listed.value.map((info) => [info.threadId, info]));\n    for (const [index, title] of [\"one\", \"two\", \"three\"].entries()) {\n      const info = byId.get(created[index]!.threadId);\n      expect(info).toBeDefined();\n      expect(info?.filePath).toBe(created[index]!.filePath);\n      expect(info?.title).toBe(title);\n      expect(info?.createdAt).toBeTruthy();\n    }\n\n    const absentPath = join(store.dir, \"never-written.sqlite\");\n    const empty = await threads.listThreads({ registryPath: absentPath });\n    expect(empty.ok).toBe(true);\n    if (!empty.ok) return;\n    expect(empty.value).toEqual([]);\n    expect(existsSync(absentPath)).toBe(false);\n  });\n\n  it(\"TC-1.6: registry insert failure compensates — thread file deleted, no registry, no orphan row\", async () => {\n    const blocker = join(store.dir, \"blocker\");\n    writeFileSync(blocker, \"a regular file where a directory must be\");\n    const badRegistry = join(blocker, \"registry.sqlite\");\n\n    const threadPath = store.threadPath();\n    const result = await threads.newThread({\n      filePath: threadPath,\n      registryPath: badRegistry,\n    });\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"system_error\");\n    expect(result.error.code).toBe(\"storage_failure\");\n\n    expect(existsSync(threadPath)).toBe(false);\n    expect(existsSync(badRegistry)).toBe(false);\n    expect(readFileSync(blocker, \"utf8\")).toBe(\n      \"a regular file where a directory must be\",\n    );\n  });\n\n  it(\"lazy-init supplemental: resolve against an absent registry returns thread_not_found and creates nothing\", async () => {\n    const absentPath = join(store.dir, \"absent-registry.sqlite\");\n    const result = await threads.resolve({\n      threadId: \"th_anything\",\n      registryPath: absentPath,\n    });\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.code).toBe(\"thread_not_found\");\n    expect(existsSync(absentPath)).toBe(false);\n  });\n\n  it(\"read-path equivalence: resolveThreadRef lands id and path references on the same file\", async () => {\n    const threadPath = store.threadPath();\n    const created = await threads.newThread({\n      filePath: threadPath,\n      registryPath: store.registryPath,\n    });\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n\n    const byId = await threads.resolveThreadRef({\n      threadId: created.value.threadId,\n      registryPath: store.registryPath,\n    });\n    const byPath = await threads.resolveThreadRef({ filePath: threadPath });\n    expect(byId.ok).toBe(true);\n    expect(byPath.ok).toBe(true);\n    if (!byId.ok || !byPath.ok) return;\n    expect(byId.value.filePath).toBe(threadPath);\n    expect(byPath.value.filePath).toBe(threadPath);\n\n    // Both reads reach the same thread: identical metadata through either ref.\n    expect(readMetadata(byId.value.filePath).thread_id).toBe(created.value.threadId);\n    expect(readMetadata(byPath.value.filePath).thread_id).toBe(created.value.threadId);\n\n    const unknown = await threads.resolveThreadRef({\n      threadId: \"th_unknown\",\n      registryPath: store.registryPath,\n    });\n    expect(unknown.ok).toBe(false);\n    if (unknown.ok) return;\n    expect(unknown.error.code).toBe(\"thread_not_found\");\n  });\n\n  // TC-1.4 (full id/path equivalence under message-events): Story 1's named\n  // deferral, closed by Story 2 — the test lives in test/intake.test.ts.\n});\n\ndescribe(\"Flow 1 (CLI in-process): threads commands\", () => {\n  interface CliOk<T> {\n    ok: true;\n    value: T;\n  }\n  interface CliErr {\n    ok: false;\n    error: { errorClass: string; code: string; reason: string };\n  }\n\n  function parseStdout<T>(stdout: string): CliOk<T> | CliErr {\n    return JSON.parse(stdout) as CliOk<T> | CliErr;\n  }\n\n  it(\"TC-1.1 (CLI): new-thread creates file, metadata, and registry row\", async () => {\n    const threadPath = store.threadPath();\n    const result = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      threadPath,\n      \"--title\",\n      \"cli thread\",\n      \"--registry\",\n      store.registryPath,\n    ]);\n    expect(result.exitCode).toBe(0);\n    const parsed = parseStdout<{ threadId: string; filePath: string }>(result.stdout);\n    expect(parsed.ok).toBe(true);\n    if (!parsed.ok) return;\n    expect(parsed.value.filePath).toBe(threadPath);\n    expect(readMetadata(threadPath).thread_id).toBe(parsed.value.threadId);\n    expect(registryRows(store.registryPath)).toHaveLength(1);\n  });\n\n  it(\"TC-1.2 (CLI): occupied path exits 1 with path_exists\", async () => {\n    const occupied = join(store.dir, \"occupied.bin\");\n    writeFileSync(occupied, \"already here\");\n    const result = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      occupied,\n      \"--registry\",\n      store.registryPath,\n    ]);\n    expect(result.exitCode).toBe(1);\n    const parsed = parseStdout<never>(result.stdout);\n    expect(parsed.ok).toBe(false);\n    if (parsed.ok) return;\n    expect(parsed.error.code).toBe(\"path_exists\");\n    expect(readFileSync(occupied, \"utf8\")).toBe(\"already here\");\n  });\n\n  it(\"TC-1.3 (CLI): resolve known id round-trips; unknown id exits 1 with thread_not_found\", async () => {\n    const threadPath = store.threadPath();\n    const created = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      threadPath,\n      \"--registry\",\n      store.registryPath,\n    ]);\n    const createdParsed = parseStdout<{ threadId: string }>(created.stdout);\n    expect(createdParsed.ok).toBe(true);\n    if (!createdParsed.ok) return;\n\n    const known = await runCli([\n      \"threads\",\n      \"resolve\",\n      \"--thread-id\",\n      createdParsed.value.threadId,\n      \"--registry\",\n      store.registryPath,\n    ]);\n    expect(known.exitCode).toBe(0);\n    const knownParsed = parseStdout<{ threadId: string; filePath: string }>(known.stdout);\n    expect(knownParsed.ok).toBe(true);\n    if (!knownParsed.ok) return;\n    expect(knownParsed.value.filePath).toBe(threadPath);\n\n    const unknown = await runCli([\n      \"threads\",\n      \"resolve\",\n      \"--thread-id\",\n      \"th_nope\",\n      \"--registry\",\n      store.registryPath,\n    ]);\n    expect(unknown.exitCode).toBe(1);\n    const unknownParsed = parseStdout<never>(unknown.stdout);\n    expect(unknownParsed.ok).toBe(false);\n    if (unknownParsed.ok) return;\n    expect(unknownParsed.error.code).toBe(\"thread_not_found\");\n  });\n\n  it(\"TC-1.5 (CLI): list returns created threads; absent registry lists empty and creates nothing\", async () => {\n    for (const title of [\"a\", \"b\", \"c\"]) {\n      const result = await runCli([\n        \"threads\",\n        \"new-thread\",\n        \"--file-path\",\n        store.threadPath(title),\n        \"--title\",\n        title,\n        \"--registry\",\n        store.registryPath,\n      ]);\n      expect(result.exitCode).toBe(0);\n    }\n    const listed = await runCli([\"threads\", \"list\", \"--registry\", store.registryPath]);\n    expect(listed.exitCode).toBe(0);\n    const parsed = parseStdout<Array<{ threadId: string; title?: string }>>(listed.stdout);\n    expect(parsed.ok).toBe(true);\n    if (!parsed.ok) return;\n    expect(parsed.value).toHaveLength(3);\n    expect(parsed.value.map((row) => row.title).sort()).toEqual([\"a\", \"b\", \"c\"]);\n\n    const absentPath = join(store.dir, \"absent.sqlite\");\n    const empty = await runCli([\"threads\", \"list\", \"--registry\", absentPath]);\n    expect(empty.exitCode).toBe(0);\n    const emptyParsed = parseStdout<unknown[]>(empty.stdout);\n    expect(emptyParsed.ok).toBe(true);\n    if (!emptyParsed.ok) return;\n    expect(emptyParsed.value).toEqual([]);\n    expect(existsSync(absentPath)).toBe(false);\n  });\n\n  it(\"TC-1.6 (CLI): registry failure compensates — exit 1 and the thread file is gone\", async () => {\n    const blocker = join(store.dir, \"blocker\");\n    writeFileSync(blocker, \"regular file\");\n    const threadPath = store.threadPath();\n    const result = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      threadPath,\n      \"--registry\",\n      join(blocker, \"registry.sqlite\"),\n    ]);\n    expect(result.exitCode).toBe(1);\n    const parsed = parseStdout<never>(result.stdout);\n    expect(parsed.ok).toBe(false);\n    if (parsed.ok) return;\n    expect(parsed.error.errorClass).toBe(\"system_error\");\n    expect(existsSync(threadPath)).toBe(false);\n  });\n});\n","numLines":394,"startLine":1,"totalLines":394}}}

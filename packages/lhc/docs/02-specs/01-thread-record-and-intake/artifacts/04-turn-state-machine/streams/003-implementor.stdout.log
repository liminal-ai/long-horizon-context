{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KKsncnjzVcoLjhp5oE4fVh","type":"tool_result","content":"100\t    const recorded = await intakeStream.messageEvents({ filePath }, conversationTurn());\n101\t    expect(recorded.ok).toBe(true);\n102\t    const baseline = await readBack(filePath);\n103\t    expect(baseline).toHaveLength(5);\n104\t\n105\t    const rejected = await intakeStream.messageEvents({ filePath }, [\n106\t      validEvent(\"user_prompt\"),\n107\t      { ...validEvent(\"turn_end\"), payload: { oops: 1 } } as unknown as MessageEventInput,\n108\t    ]);\n109\t    expect(rejected.ok).toBe(false);\n110\t\n111\t    // Logical equality at the read-back level (events at this story; the\n112\t    // rollback ladder extends to messages/turns/work in Stories 3-5).\n113\t    expect(await readBack(filePath)).toEqual(baseline);\n114\t  });\n115\t\n116\t  it(\"TC-4.4 (caller/system legs): error classes separate; corruption leg is Story 4's\", async () => {\n117\t    const filePath = await createThread();\n118\t\n119\t    const callerLeg = await intakeStream.messageEvents({ filePath }, [\n120\t      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n121\t    ]);\n122\t    expect(callerLeg.ok).toBe(false);\n123\t    if (callerLeg.ok) return;\n124\t    expect(callerLeg.error.errorClass).toBe(\"caller_error\");\n125\t    expect(callerLeg.error.code).toBe(\"invalid_event\");\n126\t\n127\t    const blocker = join(store.dir, \"blocker-file\");\n128\t    writeFileSync(blocker, \"regular file standing where a directory must be\");\n129\t    const systemLeg = await threads.newThread({\n130\t      filePath: store.threadPath(),\n131\t      registryPath: join(blocker, \"registry.sqlite\"),\n132\t    });\n133\t    expect(systemLeg.ok).toBe(false);\n134\t    if (systemLeg.ok) return;\n135\t    expect(systemLeg.error.errorClass).toBe(\"system_error\");\n136\t    expect(systemLeg.error.code).toBe(\"storage_failure\");\n137\t\n138\t    expect(callerLeg.error.errorClass).not.toBe(systemLeg.error.errorClass);\n139\t\n140\t    // Same shapes through the CLI adapter (in-process).\n141\t    const cliCaller = await runCli(\n142\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n143\t      async () => JSON.stringify([{ ...validEvent(\"user_prompt\"), eventKind: \"bogus\" }]),\n144\t    );\n145\t    expect(cliCaller.exitCode).toBe(1);\n146\t    const cliCallerParsed = JSON.parse(cliCaller.stdout) as {\n147\t      ok: boolean;\n148\t      error: { errorClass: string; code: string };\n149\t    };\n150\t    expect(cliCallerParsed.error.errorClass).toBe(\"caller_error\");\n151\t    expect(cliCallerParsed.error.code).toBe(\"invalid_event\");\n152\t\n153\t    const cliSystem = await runCli([\n154\t      \"threads\",\n155\t      \"new-thread\",\n156\t      \"--file-path\",\n157\t      store.threadPath(),\n158\t      \"--registry\",\n159\t      join(blocker, \"registry.sqlite\"),\n160\t    ]);\n161\t    expect(cliSystem.exitCode).toBe(1);\n162\t    const cliSystemParsed = JSON.parse(cliSystem.stdout) as {\n163\t      ok: boolean;\n164\t      error: { errorClass: string; code: string };\n165\t    };\n166\t    expect(cliSystemParsed.error.errorClass).toBe(\"system_error\");\n167\t    expect(cliSystemParsed.error.code).toBe(\"storage_failure\");\n168\t  });\n169\t\n170\t  it(\"TC-4.5: a batch mixing new, duplicate, and invalid events is rejected whole\", async () => {\n171\t    const filePath = await createThread();\n172\t    const original = eventBatch([\"user_prompt\", \"assistant_text\"]);\n173\t    const recorded = await intakeStream.messageEvents({ filePath }, original);\n174\t    expect(recorded.ok).toBe(true);\n175\t    const baseline = await readBack(filePath);\n176\t    expect(baseline).toHaveLength(2);\n177\t\n178\t    const mixed = [\n179\t      validEvent(\"tool_call\"),"}]},"parent_tool_use_id":null,"session_id":"14254dfe-2bbf-48f8-b225-6e96c5d66caa","uuid":
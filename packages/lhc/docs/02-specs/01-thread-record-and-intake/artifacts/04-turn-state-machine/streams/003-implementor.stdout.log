{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HxPENTM28DLhrBxua5nv6j","type":"tool_result","content":"1\t// CLI process-boundary suite for message projection: TC-2.4's spawned-CLI\n2\t// leg. A 300KB tool result goes in through real stdin (stdin → pipeline →\n3\t// projection) and comes back byte-identical through `messages list`, proving\n4\t// no layer between the pipe and the read-back shortens content. Runs under\n5\t// verify-all only.\n6\timport { spawnSync } from \"node:child_process\";\n7\timport { mkdtempSync, rmSync } from \"node:fs\";\n8\timport { tmpdir } from \"node:os\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n12\timport { validEvent } from \"./fixtures/index.js\";\n13\t\n14\tconst cliPath = path.resolve(\n15\t  path.dirname(fileURLToPath(import.meta.url)),\n16\t  \"../dist/cli.js\",\n17\t);\n18\t\n19\tfunction runBinary(\n20\t  args: string[],\n21\t  input?: string,\n22\t): { status: number | null; stdout: string; stderr: string } {\n23\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n24\t    encoding: \"utf8\",\n25\t    maxBuffer: 64 * 1024 * 1024,\n26\t    ...(input === undefined ? {} : { input }),\n27\t  });\n28\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n29\t}\n30\t\n31\tlet dir: string;\n32\tlet threadPath: string;\n33\tbeforeEach(() => {\n34\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-projection-\"));\n35\t  threadPath = path.join(dir, \"thread.sqlite\");\n36\t  const created = runBinary([\n37\t    \"threads\",\n38\t    \"new-thread\",\n39\t    \"--file-path\",\n40\t    threadPath,\n41\t    \"--registry\",\n42\t    path.join(dir, \"registry.sqlite\"),\n43\t  ]);\n44\t  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n45\t});\n46\tafterEach(() => {\n47\t  rmSync(dir, { recursive: true, force: true });\n48\t});\n49\t\n50\tdescribe(\"Story 3 (process boundary): projection through the spawned binary\", () => {\n51\t  it(\"TC-2.4 (CLI leg): a 300KB tool result piped through real stdin reads back byte-identical via messages list\", () => {\n52\t    const bigContent = \"spawned-cli verbatim δσπ 😀 line\\n\".repeat(10_000);\n53\t    expect(Buffer.byteLength(bigContent, \"utf8\")).toBeGreaterThan(300_000);\n54\t    const batch = [\n55\t      validEvent(\"user_prompt\", { payload: { text: \"run the big tool\" } }),\n56\t      validEvent(\"tool_result\", {\n57\t        payload: { toolCallId: \"proc-big\", content: bigContent, isError: false },\n58\t      }),\n59\t      validEvent(\"turn_end\"),\n60\t    ];\n61\t\n62\t    const recorded = runBinary(\n63\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n64\t      JSON.stringify(batch),\n65\t    );\n66\t    expect(recorded.status).toBe(0);\n67\t    const recordedParsed = JSON.parse(recorded.stdout) as {\n68\t      ok: boolean;\n69\t      value: { events: Array<{ outcome: string; messageId?: string }> };\n70\t    };\n71\t    expect(recordedParsed.ok).toBe(true);\n72\t    expect(recordedParsed.value.events.map((entry) => entry.messageId)).toEqual([\n73\t      \"m1\",\n74\t      \"m2\",\n75\t      undefined,\n76\t    ]);\n77\t\n78\t    const listed = runBinary([\"messages\", \"list\", \"--file-path\", threadPath]);\n79\t    expect(listed.status).toBe(0);\n80\t    const listedParsed = JSON.parse(listed.stdout) as {\n81\t      ok: boolean;\n82\t      value: Array<{\n83\t        messageId: string;\n84\t        kind: string;\n85\t        tokenEstimate: number;\n86\t        blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n87\t      }>;\n88\t    };\n89\t    expect(listedParsed.ok).toBe(true);\n90\t    expect(listedParsed.value.map((message) => message.messageId)).toEqual([\"m1\", \"m2\"]);\n91\t\n92\t    const toolResult = listedParsed.value[1]!;\n93\t    expect(toolResult.kind).toBe(\"tool_result\");\n94\t    expect(toolResult.blocks).toHaveLength(1);\n95\t    expect(toolResult.blocks[0]!.blockType).toBe(\"tool_result\");\n96\t    expect(toolResult.blocks[0]!.content[\"content\"] === bigContent).toBe(true);\n97\t    expect(toolResult.blocks[0]!.content[\"toolCallId\"]).toBe(\"proc-big\");\n98\t    expect(toolResult.tokenEstimate).toBeGreaterThan(0);\n99\t  });\n100\t});\n101\t"}]},"parent_tool_use_id":null,"session_id":"14254dfe-2bbf-48f8-b225-6e96c5d66caa","uuid":"5c0d5e23-c21b-4130-b7f1-e32b61cf653c","timestamp":"2026-06-10T14:21:50.542Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-projection.test.ts","content":"// CLI process-boundary suite for message projection: TC-2.4's spawned-CLI\n// leg. A 300KB tool result goes in through real stdin (stdin → pipeline →\n// projection) and comes back byte-identical through `messages list`, proving\n// no layer between the pipe and the read-back shortens content. Runs under\n// verify-all only.\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { validEvent } from \"./fixtures/index.js\";\n\nconst cliPath = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  \"../dist/cli.js\",\n);\n\nfunction runBinary(\n  args: string[],\n  input?: string,\n): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    maxBuffer: 64 * 1024 * 1024,\n    ...(input === undefined ? {} : { input }),\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nlet threadPath: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-projection-\"));\n  threadPath = path.join(dir, \"thread.sqlite\");\n  const created = runBinary([\n    \"threads\",\n    \"new-thread\",\n    \"--file-path\",\n    threadPath,\n    \"--registry\",\n    path.join(dir, \"registry.sqlite\"),\n  ]);\n  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\ndescribe(\"Story 3 (process boundary): projection through the spawned binary\", () => {\n  it(\"TC-2.4 (CLI leg): a 300KB tool result piped through real stdin reads back byte-identical via messages list\", () => {\n    const bigContent = \"spawned-cli verbatim δσπ 😀 line\\n\".repeat(10_000);\n    expect(Buffer.byteLength(bigContent, \"utf8\")).toBeGreaterThan(300_000);\n    const batch = [\n      validEvent(\"user_prompt\", { payload: { text: \"run the big tool\" } }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"proc-big\", content: bigContent, isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ];\n\n    const recorded = runBinary(\n      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n      JSON.stringify(batch),\n    );\n    expect(recorded.status).toBe(0);\n    const recordedParsed = JSON.parse(recorded.stdout) as {\n      ok: boolean;\n      value: { events: Array<{ outcome: string; messageId?: string }> };\n    };\n    expect(recordedParsed.ok).toBe(true);\n    expect(recordedParsed.value.events.map((entry) => entry.messageId)).toEqual([\n      \"m1\",\n      \"m2\",\n      undefined,\n    ]);\n\n    const listed = runBinary([\"messages\", \"list\", \"--file-path\", threadPath]);\n    expect(listed.status).toBe(0);\n    const listedParsed = JSON.parse(listed.stdout) as {\n      ok: boolean;\n      value: Array<{\n        messageId: string;\n        kind: string;\n        tokenEstimate: number;\n        blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n      }>;\n    };\n    expect(listedParsed.ok).toBe(true);\n    expect(listedParsed.value.map((message) => message.messageId)).toEqual([\"m1\", \"m2\"]);\n\n    const toolResult = listedParsed.value[1]!;\n    expect(toolResult.kind).toBe(\"tool_result\");\n    expect(toolResult.blocks).toHaveLength(1);\n    expect(toolResult.blocks[0]!.blockType).toBe(\"tool_result\");\n    expect(toolResult.blocks[0]!.content[\"content\"] === bigContent).toBe(true);\n    expect(toolResult.blocks[0]!.content[\"toolCallId\"]).toBe(\"proc-big\");\n    expect(toolResult.tokenEstimate).toBeGreaterThan(0);\n  });\n});\n","numLines":101,"startLine":1,"totalLines":101}}}

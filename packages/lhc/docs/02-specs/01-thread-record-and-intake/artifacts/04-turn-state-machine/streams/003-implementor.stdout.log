{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SKVpes3YEqPfVTVrdfpaFi","type":"tool_result","content":"1\timport { DatabaseSync } from \"node:sqlite\";\n2\t\n3\texport interface Migration {\n4\t  version: number; // 1-based, strictly increasing\n5\t  statements: readonly string[];\n6\t}\n7\t\n8\texport function openDatabase(path: string): DatabaseSync {\n9\t  const db = new DatabaseSync(path);\n10\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n11\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n12\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n13\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n14\t  return db;\n15\t}\n16\t\n17\texport function getSchemaVersion(db: DatabaseSync): number {\n18\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n19\t    | { user_version: number | bigint }\n20\t    | undefined;\n21\t  return Number(row?.user_version ?? 0);\n22\t}\n23\t\n24\texport function runMigrations(\n25\t  db: DatabaseSync,\n26\t  migrations: readonly Migration[],\n27\t): void {\n28\t  let current = getSchemaVersion(db);\n29\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n30\t  for (const migration of ordered) {\n31\t    if (migration.version <= current) continue;\n32\t    db.exec(\"BEGIN IMMEDIATE;\");\n33\t    try {\n34\t      for (const statement of migration.statements) db.exec(statement);\n35\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n36\t      db.exec(\"COMMIT;\");\n37\t    } catch (cause) {\n38\t      db.exec(\"ROLLBACK;\");\n39\t      throw cause;\n40\t    }\n41\t    current = migration.version;\n42\t  }\n43\t}\n44\t"}]},"parent_tool_use_id":null,"session_id":"14254dfe-2bbf-48f8-b225-6e96c5d66caa","uuid":"ad6093dc-3d45-4afd-8d56-7d4102643c58","timestamp":"2026-06-10T14:20:25.870Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/storage.ts","content":"import { DatabaseSync } from \"node:sqlite\";\n\nexport interface Migration {\n  version: number; // 1-based, strictly increasing\n  statements: readonly string[];\n}\n\nexport function openDatabase(path: string): DatabaseSync {\n  const db = new DatabaseSync(path);\n  db.exec(\"PRAGMA journal_mode = WAL;\");\n  db.exec(\"PRAGMA foreign_keys = ON;\");\n  db.exec(\"PRAGMA busy_timeout = 5000;\");\n  db.exec(\"PRAGMA synchronous = NORMAL;\");\n  return db;\n}\n\nexport function getSchemaVersion(db: DatabaseSync): number {\n  const row = db.prepare(\"PRAGMA user_version\").get() as\n    | { user_version: number | bigint }\n    | undefined;\n  return Number(row?.user_version ?? 0);\n}\n\nexport function runMigrations(\n  db: DatabaseSync,\n  migrations: readonly Migration[],\n): void {\n  let current = getSchemaVersion(db);\n  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n  for (const migration of ordered) {\n    if (migration.version <= current) continue;\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      for (const statement of migration.statements) db.exec(statement);\n      db.exec(`PRAGMA user_version = ${migration.version};`);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    current = migration.version;\n  }\n}\n","numLines":44,"startLine":1,"totalLines":44}}}

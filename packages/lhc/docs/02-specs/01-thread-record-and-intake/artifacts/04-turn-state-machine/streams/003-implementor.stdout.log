{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015BYaJ7wRK9mo7yc9sT8e1f","type":"tool_result","content":"1\timport { randomBytes } from \"node:crypto\";\n2\timport { rmSync } from \"node:fs\";\n3\timport { DatabaseSync } from \"node:sqlite\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n5\timport {\n6\t  getSchemaVersion,\n7\t  openDatabase,\n8\t  runMigrations,\n9\t  type Migration,\n10\t} from \"../../../shared/storage.js\";\n11\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n12\t\n13\t// The one random id: its uniqueness scope is global across files and\n14\t// registries (design decision 7).\n15\texport function generateThreadId(): string {\n16\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n17\t}\n18\t\n19\t// The thread-file schema as a versioned history, never rewritten in place:\n20\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n21\t// each later story appends a version. Existing files upgrade lazily through\n22\t// openThreadDatabase, so a file recorded under an earlier story is always\n23\t// usable by a later one (F-03-001).\n24\t//\n25\t// Creation-time metadata values are interpolated through buildThreadMigrations\n26\t// for new files only; existing files already hold their metadata row and the\n27\t// upgrade path never touches it.\n28\tfunction buildThreadMigrations(\n29\t  metadata?: { threadId: string; createdAt: string },\n30\t): Migration[] {\n31\t  const metadataInsert =\n32\t    metadata === undefined\n33\t      ? []\n34\t      : [\n35\t          // Interpolated values are all generated by us (hex id, ISO\n36\t          // timestamp, estimator constant) — never caller input.\n37\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n38\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n39\t        ];\n40\t  return [\n41\t    {\n42\t      version: 1,\n43\t      statements: [\n44\t        `CREATE TABLE thread_metadata (\n45\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n46\t          thread_id TEXT NOT NULL,\n47\t          created_at TEXT NOT NULL,\n48\t          token_estimator TEXT NOT NULL\n49\t        );`,\n50\t        ...metadataInsert,\n51\t        `CREATE TABLE event (\n52\t          event_order INTEGER PRIMARY KEY,\n53\t          event_kind TEXT NOT NULL,\n54\t          idempotency_key TEXT NOT NULL UNIQUE,\n55\t          actor TEXT NOT NULL,\n56\t          harness TEXT NOT NULL,\n57\t          payload TEXT NOT NULL,\n58\t          recorded_at TEXT NOT NULL\n59\t        );`,\n60\t      ],\n61\t    },\n62\t    {\n63\t      version: 2, // Story 3: message projection\n64\t      statements: [\n65\t        `CREATE TABLE message (\n66\t          message_id TEXT PRIMARY KEY,\n67\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n68\t          kind TEXT NOT NULL,\n69\t          token_estimate INTEGER NOT NULL,\n70\t          actor TEXT NOT NULL,\n71\t          harness TEXT NOT NULL,\n72\t          turn_id TEXT\n73\t        );`,\n74\t        `CREATE TABLE message_block (\n75\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n76\t          block_index INTEGER NOT NULL,\n77\t          block_type TEXT NOT NULL,\n78\t          content TEXT NOT NULL,\n79\t          PRIMARY KEY (message_id, block_index)\n80\t        );`,\n81\t      ],\n82\t    },\n83\t  ];\n84\t}\n85\t\n86\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n87\t  return {\n88\t    ok: false,\n89\t    error: {\n90\t      errorClass: \"caller_error\",\n91\t      code: \"thread_not_found\",\n92\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n93\t    },\n94\t  };\n95\t}\n96\t\n97\tfunction errorDetail(cause: unknown): string {\n98\t  return cause instanceof Error ? cause.message : String(cause);\n99\t}\n100\t\n101\t// Identity check before any migration runs, on a read-only handle so an\n102\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n103\t// file always carries schema version >= 1 and the thread_metadata singleton\n104\t// row that creation wrote transactionally. Anything else — an empty\n105\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n106\t// caller error, never adopted.\n107\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n108\t  let db: DatabaseSync | undefined;\n109\t  try {\n110\t    db = new DatabaseSync(filePath, { readOnly: true });\n111\t    if (getSchemaVersion(db) < 1) {\n112\t      return notAThreadFile(filePath, \"no lhc schema version\");\n113\t    }\n114\t    const table = db\n115\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n116\t      .get();\n117\t    if (table === undefined) {\n118\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n119\t    }\n120\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n121\t    if (row === undefined) {\n122\t      return notAThreadFile(filePath, \"no thread metadata row\");\n123\t    }\n124\t    return { ok: true };\n125\t  } catch (cause) {\n126\t    const detail = errorDetail(cause);\n127\t    // SQLite refusing the file as a database is an identity failure, not an\n128\t    // environment failure; everything else stays a system error.\n129\t    if (detail.includes(\"not a database\")) {\n130\t      return notAThreadFile(filePath, detail);\n131\t    }\n132\t    return storageFailure(`could not inspect thread file: ${detail}`);\n133\t  } finally {\n134\t    db?.close();\n135\t  }\n136\t}\n137\t\n138\t// Opens a thread file and brings its schema to the current version before\n139\t// returning the handle. Every SDK operation on an existing thread file goes\n140\t// through here, so a pre-Story-3 file gains the message tables on its first\n141\t// open by newer code — but only after the file proves it is a thread file;\n142\t// migration never creates lhc schema on an arbitrary existing file. Each\n143\t// migration runs in its own transaction (storage helper), completing before\n144\t// any caller transaction begins.\n145\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n146\t  const valid = validateThreadFile(filePath);\n147\t  if (!valid.ok) return valid;\n148\t  let db: DatabaseSync;\n149\t  try {\n150\t    db = openDatabase(filePath);\n151\t  } catch (cause) {\n152\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n153\t  }\n154\t  try {\n155\t    runMigrations(db, buildThreadMigrations());\n156\t  } catch (cause) {\n157\t    db.close();\n158\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n159\t  }\n160\t  return { ok: true, value: db };\n161\t}\n162\t\n163\t// Schema v1 plus the metadata row land in one migration transaction, so the\n164\t// file either has its full schema and metadata row or creation fails whole.\n165\texport function createThreadFile(\n166\t  filePath: string,\n167\t  threadId: string,\n168\t  createdAt: string,\n169\t): void {\n170\t  const db = openDatabase(filePath);\n171\t  try {\n172\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n173\t  } finally {\n174\t    db.close();\n175\t  }\n176\t}\n177\t\n178\t// Compensation: removes the thread file and its WAL companions. Used when the\n179\t// registry insert fails after file creation (no registry row without its\n180\t// file) and when file creation itself fails partway.\n181\texport function deleteThreadFile(filePath: string): void {\n182\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n183\t    rmSync(`${filePath}${suffix}`, { force: true });\n184\t  }\n185\t}\n186\t"}]},"parent_tool_use_id":null,"session_id":"14254dfe-2bbf-48f8-b225-6e96c5d66caa","uuid":"9dd01ba2-d124-474b-9952-6be228f20890","timestamp":"2026-06-10T14:20:31.037Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/internal/create.ts","content":"import { randomBytes } from \"node:crypto\";\nimport { rmSync } from \"node:fs\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport {\n  getSchemaVersion,\n  openDatabase,\n  runMigrations,\n  type Migration,\n} from \"../../../shared/storage.js\";\nimport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n\n// The one random id: its uniqueness scope is global across files and\n// registries (design decision 7).\nexport function generateThreadId(): string {\n  return `th_${randomBytes(8).toString(\"hex\")}`;\n}\n\n// The thread-file schema as a versioned history, never rewritten in place:\n// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n// each later story appends a version. Existing files upgrade lazily through\n// openThreadDatabase, so a file recorded under an earlier story is always\n// usable by a later one (F-03-001).\n//\n// Creation-time metadata values are interpolated through buildThreadMigrations\n// for new files only; existing files already hold their metadata row and the\n// upgrade path never touches it.\nfunction buildThreadMigrations(\n  metadata?: { threadId: string; createdAt: string },\n): Migration[] {\n  const metadataInsert =\n    metadata === undefined\n      ? []\n      : [\n          // Interpolated values are all generated by us (hex id, ISO\n          // timestamp, estimator constant) — never caller input.\n          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n        ];\n  return [\n    {\n      version: 1,\n      statements: [\n        `CREATE TABLE thread_metadata (\n          id INTEGER PRIMARY KEY CHECK (id = 1),\n          thread_id TEXT NOT NULL,\n          created_at TEXT NOT NULL,\n          token_estimator TEXT NOT NULL\n        );`,\n        ...metadataInsert,\n        `CREATE TABLE event (\n          event_order INTEGER PRIMARY KEY,\n          event_kind TEXT NOT NULL,\n          idempotency_key TEXT NOT NULL UNIQUE,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          payload TEXT NOT NULL,\n          recorded_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 2, // Story 3: message projection\n      statements: [\n        `CREATE TABLE message (\n          message_id TEXT PRIMARY KEY,\n          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n          kind TEXT NOT NULL,\n          token_estimate INTEGER NOT NULL,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          turn_id TEXT\n        );`,\n        `CREATE TABLE message_block (\n          message_id TEXT NOT NULL REFERENCES message(message_id),\n          block_index INTEGER NOT NULL,\n          block_type TEXT NOT NULL,\n          content TEXT NOT NULL,\n          PRIMARY KEY (message_id, block_index)\n        );`,\n      ],\n    },\n  ];\n}\n\nfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n    },\n  };\n}\n\nfunction errorDetail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Identity check before any migration runs, on a read-only handle so an\n// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n// file always carries schema version >= 1 and the thread_metadata singleton\n// row that creation wrote transactionally. Anything else — an empty\n// database, an unrelated SQLite file, a non-database file — is rejected as a\n// caller error, never adopted.\nfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    if (getSchemaVersion(db) < 1) {\n      return notAThreadFile(filePath, \"no lhc schema version\");\n    }\n    const table = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n      .get();\n    if (table === undefined) {\n      return notAThreadFile(filePath, \"no thread_metadata table\");\n    }\n    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n    if (row === undefined) {\n      return notAThreadFile(filePath, \"no thread metadata row\");\n    }\n    return { ok: true };\n  } catch (cause) {\n    const detail = errorDetail(cause);\n    // SQLite refusing the file as a database is an identity failure, not an\n    // environment failure; everything else stays a system error.\n    if (detail.includes(\"not a database\")) {\n      return notAThreadFile(filePath, detail);\n    }\n    return storageFailure(`could not inspect thread file: ${detail}`);\n  } finally {\n    db?.close();\n  }\n}\n\n// Opens a thread file and brings its schema to the current version before\n// returning the handle. Every SDK operation on an existing thread file goes\n// through here, so a pre-Story-3 file gains the message tables on its first\n// open by newer code — but only after the file proves it is a thread file;\n// migration never creates lhc schema on an arbitrary existing file. Each\n// migration runs in its own transaction (storage helper), completing before\n// any caller transaction begins.\nexport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n  const valid = validateThreadFile(filePath);\n  if (!valid.ok) return valid;\n  let db: DatabaseSync;\n  try {\n    db = openDatabase(filePath);\n  } catch (cause) {\n    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n  }\n  try {\n    runMigrations(db, buildThreadMigrations());\n  } catch (cause) {\n    db.close();\n    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n  }\n  return { ok: true, value: db };\n}\n\n// Schema v1 plus the metadata row land in one migration transaction, so the\n// file either has its full schema and metadata row or creation fails whole.\nexport function createThreadFile(\n  filePath: string,\n  threadId: string,\n  createdAt: string,\n): void {\n  const db = openDatabase(filePath);\n  try {\n    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n  } finally {\n    db.close();\n  }\n}\n\n// Compensation: removes the thread file and its WAL companions. Used when the\n// registry insert fails after file creation (no registry row without its\n// file) and when file creation itself fails partway.\nexport function deleteThreadFile(filePath: string): void {\n  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n    rmSync(`${filePath}${suffix}`, { force: true });\n  }\n}\n","numLines":186,"startLine":1,"totalLines":186}}}

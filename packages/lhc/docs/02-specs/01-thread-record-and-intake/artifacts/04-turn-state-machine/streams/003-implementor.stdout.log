{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B1nFuvatsVZmioTnW8nE3h","type":"tool_result","content":"1\t// Message and block row operations. Writes run on the caller's handle inside\n2\t// the batch transaction (insert failures propagate so the pipeline rejects\n3\t// the whole batch); reads run on a fresh handle per operation.\n4\timport type { DatabaseSync } from \"node:sqlite\";\n5\timport type { Block, MessageRecord } from \"../index.js\";\n6\t\n7\texport interface MessageRow {\n8\t  messageId: string;\n9\t  sourceEventOrder: number;\n10\t  kind: MessageRecord[\"kind\"];\n11\t  tokenEstimate: number;\n12\t  actor: string;\n13\t  harness: string;\n14\t  blocks: Block[];\n15\t}\n16\t\n17\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n18\t  db.prepare(\n19\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n20\t     VALUES (?, ?, ?, ?, ?, ?, NULL)`,\n21\t  ).run(row.messageId, row.sourceEventOrder, row.kind, row.tokenEstimate, row.actor, row.harness);\n22\t\n23\t  const insertBlock = db.prepare(\n24\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\n25\t     VALUES (?, ?, ?, ?)`,\n26\t  );\n27\t  for (const [index, block] of row.blocks.entries()) {\n28\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n29\t  }\n30\t}\n31\t\n32\tinterface RawMessageRow {\n33\t  message_id: string;\n34\t  source_event_order: number | bigint;\n35\t  kind: string;\n36\t  token_estimate: number | bigint;\n37\t  actor: string;\n38\t  harness: string;\n39\t  turn_id: string | null;\n40\t}\n41\t\n42\tinterface RawBlockRow {\n43\t  message_id: string;\n44\t  block_type: string;\n45\t  content: string;\n46\t}\n47\t\n48\texport function readMessages(db: DatabaseSync): MessageRecord[] {\n49\t  const blockRows = db\n50\t    .prepare(\n51\t      `SELECT message_id, block_type, content FROM message_block\n52\t       ORDER BY message_id, block_index`,\n53\t    )\n54\t    .all() as unknown as RawBlockRow[];\n55\t  const blocksByMessage = new Map<string, Block[]>();\n56\t  for (const row of blockRows) {\n57\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n58\t    blocks.push({\n59\t      blockType: row.block_type as Block[\"blockType\"],\n60\t      content: JSON.parse(row.content) as Record<string, unknown>,\n61\t    });\n62\t    blocksByMessage.set(row.message_id, blocks);\n63\t  }\n64\t\n65\t  const messageRows = db\n66\t    .prepare(\n67\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n68\t       FROM message ORDER BY source_event_order`,\n69\t    )\n70\t    .all() as unknown as RawMessageRow[];\n71\t  return messageRows.map((row) => {\n72\t    const record: MessageRecord = {\n73\t      messageId: row.message_id,\n74\t      sourceEventOrder: Number(row.source_event_order),\n75\t      kind: row.kind as MessageRecord[\"kind\"],\n76\t      blocks: blocksByMessage.get(row.message_id) ?? [],\n77\t      tokenEstimate: Number(row.token_estimate),\n78\t      actor: row.actor,\n79\t      harness: row.harness,\n80\t    };\n81\t    if (row.turn_id !== null) record.turnId = row.turn_id;\n82\t    return record;\n83\t  });\n84\t}\n85\t"}]},"parent_tool_use_id":null,"session_id":"14254dfe-2bbf-48f8-b225-6e96c5d66caa","uuid":"f75c3078-3a12-4077-9bfb-42c0c4ed8086","timestamp":"2026-06-10T14:20:19.882Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/store.ts","content":"// Message and block row operations. Writes run on the caller's handle inside\n// the batch transaction (insert failures propagate so the pipeline rejects\n// the whole batch); reads run on a fresh handle per operation.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { Block, MessageRecord } from \"../index.js\";\n\nexport interface MessageRow {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: MessageRecord[\"kind\"];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  blocks: Block[];\n}\n\nexport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n  db.prepare(\n    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n     VALUES (?, ?, ?, ?, ?, ?, NULL)`,\n  ).run(row.messageId, row.sourceEventOrder, row.kind, row.tokenEstimate, row.actor, row.harness);\n\n  const insertBlock = db.prepare(\n    `INSERT INTO message_block (message_id, block_index, block_type, content)\n     VALUES (?, ?, ?, ?)`,\n  );\n  for (const [index, block] of row.blocks.entries()) {\n    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n  }\n}\n\ninterface RawMessageRow {\n  message_id: string;\n  source_event_order: number | bigint;\n  kind: string;\n  token_estimate: number | bigint;\n  actor: string;\n  harness: string;\n  turn_id: string | null;\n}\n\ninterface RawBlockRow {\n  message_id: string;\n  block_type: string;\n  content: string;\n}\n\nexport function readMessages(db: DatabaseSync): MessageRecord[] {\n  const blockRows = db\n    .prepare(\n      `SELECT message_id, block_type, content FROM message_block\n       ORDER BY message_id, block_index`,\n    )\n    .all() as unknown as RawBlockRow[];\n  const blocksByMessage = new Map<string, Block[]>();\n  for (const row of blockRows) {\n    const blocks = blocksByMessage.get(row.message_id) ?? [];\n    blocks.push({\n      blockType: row.block_type as Block[\"blockType\"],\n      content: JSON.parse(row.content) as Record<string, unknown>,\n    });\n    blocksByMessage.set(row.message_id, blocks);\n  }\n\n  const messageRows = db\n    .prepare(\n      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n       FROM message ORDER BY source_event_order`,\n    )\n    .all() as unknown as RawMessageRow[];\n  return messageRows.map((row) => {\n    const record: MessageRecord = {\n      messageId: row.message_id,\n      sourceEventOrder: Number(row.source_event_order),\n      kind: row.kind as MessageRecord[\"kind\"],\n      blocks: blocksByMessage.get(row.message_id) ?? [],\n      tokenEstimate: Number(row.token_estimate),\n      actor: row.actor,\n      harness: row.harness,\n    };\n    if (row.turn_id !== null) record.turnId = row.turn_id;\n    return record;\n  });\n}\n","numLines":85,"startLine":1,"totalLines":85}}}

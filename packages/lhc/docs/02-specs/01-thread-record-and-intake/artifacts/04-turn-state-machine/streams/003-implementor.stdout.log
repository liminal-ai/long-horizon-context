{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VjCbhPvHcuZch6jHoxC3bJ","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\t\n11\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n12\t// process stdin. null means interactive (TTY) — distinct from empty input\n13\t// only in how it arises; both are refused with empty_stdin before any SDK\n14\t// call (the SDK itself can never return that code).\n15\texport type StdinReader = () => Promise<string | null>;\n16\t\n17\tasync function readProcessStdin(): Promise<string | null> {\n18\t  if (process.stdin.isTTY) return null;\n19\t  process.stdin.setEncoding(\"utf8\");\n20\t  let data = \"\";\n21\t  for await (const chunk of process.stdin) data += String(chunk);\n22\t  return data;\n23\t}\n24\t\n25\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n26\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n27\t}\n28\t\n29\tconst HELP = `lhc — Long Horizon Context CLI\n30\t\n31\tUsage:\n32\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n33\t  lhc threads resolve --thread-id <id> [--registry <r>]\n34\t  lhc threads list [--registry <r>]\n35\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n36\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n37\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n38\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n39\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n40\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n41\t\n42\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n43\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n44\t`;\n45\t\n46\tinterface ParsedFlags {\n47\t  threadId?: string;\n48\t  filePath?: string;\n49\t  title?: string;\n50\t  registryPath?: string;\n51\t}\n52\t\n53\tfunction parseFlags(args: readonly string[]): ParsedFlags {\n54\t  const { values } = parseArgs({\n55\t    args: [...args],\n56\t    options: {\n57\t      \"thread-id\": { type: \"string\" },\n58\t      \"file-path\": { type: \"string\" },\n59\t      title: { type: \"string\" },\n60\t      registry: { type: \"string\" },\n61\t    },\n62\t    strict: false,\n63\t    allowPositionals: true,\n64\t  });\n65\t  const flags: ParsedFlags = {};\n66\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n67\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n68\t  if (typeof values.title === \"string\") flags.title = values.title;\n69\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n70\t  return flags;\n71\t}\n72\t\n73\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n74\t  if (flags.threadId !== undefined) {\n75\t    return flags.registryPath !== undefined\n76\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n77\t      : { threadId: flags.threadId };\n78\t  }\n79\t  return { filePath: flags.filePath ?? \"\" };\n80\t}\n81\t\n82\texport async function runCli(\n83\t  argv: readonly string[],\n84\t  readStdin: StdinReader = readProcessStdin,\n85\t): Promise<CliResult> {\n86\t  if (argv.length === 0) {\n87\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n88\t  }\n89\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n90\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n91\t  }\n92\t\n93\t  const [group, command, ...rest] = argv;\n94\t  const key = command === undefined ? group : `${group} ${command}`;\n95\t  const flags = parseFlags(command === undefined ? [] : rest);\n96\t\n97\t  switch (key) {\n98\t    case \"threads new-thread\": {\n99\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n100\t      // instead of failing, so the adapter refuses before any SDK call.\n101\t      if (flags.filePath === undefined) {\n102\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n103\t      }\n104\t      const input: Parameters<typeof threads.newThread>[0] = {\n105\t        filePath: flags.filePath,\n106\t      };\n107\t      if (flags.title !== undefined) input.title = flags.title;\n108\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n109\t      return renderResult(await threads.newThread(input));\n110\t    }\n111\t    case \"threads resolve\": {\n112\t      if (flags.threadId === undefined) {\n113\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n114\t      }\n115\t      const input: Parameters<typeof threads.resolve>[0] = {\n116\t        threadId: flags.threadId,\n117\t      };\n118\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n119\t      return renderResult(await threads.resolve(input));\n120\t    }\n121\t    case \"threads list\": {\n122\t      return renderResult(\n123\t        await threads.listThreads(\n124\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n125\t        ),\n126\t      );\n127\t    }\n128\t    case \"intake-stream message-events\": {\n129\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n130\t        return renderCliError(\n131\t          \"caller_error\",\n132\t          \"missing_flag\",\n133\t          \"intake-stream message-events requires --thread-id or --file-path\",\n134\t        );\n135\t      }\n136\t      const text = await readStdin();\n137\t      if (text === null || text.trim() === \"\") {\n138\t        return renderResult(\n139\t          stdinCallerError(\n140\t            \"empty_stdin\",\n141\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n142\t          ),\n143\t        );\n144\t      }\n145\t      let parsed: unknown;\n146\t      try {\n147\t        parsed = JSON.parse(text);\n148\t      } catch (cause) {\n149\t        const detail = cause instanceof Error ? cause.message : String(cause);\n150\t        return renderResult(\n151\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n152\t        );\n153\t      }\n154\t      if (!Array.isArray(parsed)) {\n155\t        return renderResult(\n156\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n157\t        );\n158\t      }\n159\t      return renderResult(\n160\t        await intakeStream.messageEvents(\n161\t          threadRefFrom(flags),\n162\t          parsed as readonly MessageEventInput[],\n163\t        ),\n164\t      );\n165\t    }\n166\t    case \"intake-stream list-events\": {\n167\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n168\t        return renderCliError(\n169\t          \"caller_error\",\n170\t          \"missing_flag\",\n171\t          \"intake-stream list-events requires --thread-id or --file-path\",\n172\t        );\n173\t      }\n174\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n175\t    }\n176\t    case \"messages list\":\n177\t      return 
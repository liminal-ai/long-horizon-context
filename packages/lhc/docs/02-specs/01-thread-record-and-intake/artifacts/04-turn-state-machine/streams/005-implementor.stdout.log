{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018mHR82V7jeBAy4PezXhdM2","type":"tool_result","content":"1\t// Turn row operations. Writes run on the caller's handle inside the batch\n2\t// transaction; reads run on a fresh handle per operation. A closed turn has\n3\t// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n4\t// any UPDATE that touches a closed row.\n5\timport type { DatabaseSync } from \"node:sqlite\";\n6\timport type { TurnRecord } from \"../index.js\";\n7\t\n8\texport function selectOpenTurnIds(db: DatabaseSync): string[] {\n9\t  const rows = db\n10\t    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n11\t    .all() as unknown as Array<{ turn_id: string }>;\n12\t  return rows.map((row) => row.turn_id);\n13\t}\n14\t\n15\texport function nextTurnOrder(db: DatabaseSync): number {\n16\t  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n17\t    | { max_order: number | bigint | null }\n18\t    | undefined;\n19\t  return Number(row?.max_order ?? 0) + 1;\n20\t}\n21\t\n22\texport function insertOpenTurn(\n23\t  db: DatabaseSync,\n24\t  turnOrder: number,\n25\t  openedAtEventOrder: number,\n26\t): string {\n27\t  const turnId = `t${turnOrder}`;\n28\t  db.prepare(\n29\t    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n30\t     VALUES (?, ?, 'open', ?)`,\n31\t  ).run(turnId, turnOrder, openedAtEventOrder);\n32\t  return turnId;\n33\t}\n34\t\n35\texport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n36\t  db.prepare(\n37\t    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n38\t  ).run(closedAtEventOrder, turnId);\n39\t}\n40\t\n41\tinterface RawTurnRow {\n42\t  turn_id: string;\n43\t  status: string;\n44\t  opened_at_event_order: number | bigint;\n45\t  closed_at_event_order: number | bigint | null;\n46\t}\n47\t\n48\t// Membership is stored on the member (message.turn_id), never as a list on\n49\t// the turn: memberMessageIds is a query, ordered by event order, so there is\n50\t// exactly one source of truth.\n51\texport function readTurns(db: DatabaseSync): TurnRecord[] {\n52\t  const memberRows = db\n53\t    .prepare(\n54\t      `SELECT message_id, turn_id FROM message\n55\t       WHERE turn_id IS NOT NULL ORDER BY source_event_order`,\n56\t    )\n57\t    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n58\t  const membersByTurn = new Map<string, string[]>();\n59\t  for (const row of memberRows) {\n60\t    const members = membersByTurn.get(row.turn_id) ?? [];\n61\t    members.push(row.message_id);\n62\t    membersByTurn.set(row.turn_id, members);\n63\t  }\n64\t\n65\t  const turnRows = db\n66\t    .prepare(\n67\t      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n68\t       FROM turns ORDER BY turn_order`,\n69\t    )\n70\t    .all() as unknown as RawTurnRow[];\n71\t  return turnRows.map((row) => {\n72\t    const record: TurnRecord = {\n73\t      turnId: row.turn_id,\n74\t      status: row.status as TurnRecord[\"status\"],\n75\t      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n76\t      openedAtEventOrder: Number(row.opened_at_event_order),\n77\t    };\n78\t    if (row.closed_at_event_order !== null) {\n79\t      record.closedAtEventOrder = Number(row.closed_at_event_order);\n80\t    }\n81\t    return record;\n82\t  });\n83\t}\n84\t"}]},"parent_tool_use_id":null,"session_id":"aadaa07d-c15f-4e26-9167-6bca5f9b186c","uuid":"b2abf3ba-314a-49d2-baf5-90333eeb3d9b","timestamp":"2026-06-10T14:31:17.801Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/store.ts","content":"// Turn row operations. Writes run on the caller's handle inside the batch\n// transaction; reads run on a fresh handle per operation. A closed turn has\n// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n// any UPDATE that touches a closed row.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { TurnRecord } from \"../index.js\";\n\nexport function selectOpenTurnIds(db: DatabaseSync): string[] {\n  const rows = db\n    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n    .all() as unknown as Array<{ turn_id: string }>;\n  return rows.map((row) => row.turn_id);\n}\n\nexport function nextTurnOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0) + 1;\n}\n\nexport function insertOpenTurn(\n  db: DatabaseSync,\n  turnOrder: number,\n  openedAtEventOrder: number,\n): string {\n  const turnId = `t${turnOrder}`;\n  db.prepare(\n    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n     VALUES (?, ?, 'open', ?)`,\n  ).run(turnId, turnOrder, openedAtEventOrder);\n  return turnId;\n}\n\nexport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n  db.prepare(\n    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n  ).run(closedAtEventOrder, turnId);\n}\n\ninterface RawTurnRow {\n  turn_id: string;\n  status: string;\n  opened_at_event_order: number | bigint;\n  closed_at_event_order: number | bigint | null;\n}\n\n// Membership is stored on the member (message.turn_id), never as a list on\n// the turn: memberMessageIds is a query, ordered by event order, so there is\n// exactly one source of truth.\nexport function readTurns(db: DatabaseSync): TurnRecord[] {\n  const memberRows = db\n    .prepare(\n      `SELECT message_id, turn_id FROM message\n       WHERE turn_id IS NOT NULL ORDER BY source_event_order`,\n    )\n    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n  const membersByTurn = new Map<string, string[]>();\n  for (const row of memberRows) {\n    const members = membersByTurn.get(row.turn_id) ?? [];\n    members.push(row.message_id);\n    membersByTurn.set(row.turn_id, members);\n  }\n\n  const turnRows = db\n    .prepare(\n      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n       FROM turns ORDER BY turn_order`,\n    )\n    .all() as unknown as RawTurnRow[];\n  return turnRows.map((row) => {\n    const record: TurnRecord = {\n      turnId: row.turn_id,\n      status: row.status as TurnRecord[\"status\"],\n      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n      openedAtEventOrder: Number(row.opened_at_event_order),\n    };\n    if (row.closed_at_event_order !== null) {\n      record.closedAtEventOrder = Number(row.closed_at_event_order);\n    }\n    return record;\n  });\n}\n","numLines":84,"startLine":1,"totalLines":84}}}

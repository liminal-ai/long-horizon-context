{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kzte3ceZRezx5YjvyKLtGy","type":"tool_result","content":"1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4\t// Stories 3–5 extend the same per-event walk with projection, turn\n5\t// transitions, and work queueing.\n6\timport { existsSync } from \"node:fs\";\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport type { OperationContext } from \"../../../shared/context.js\";\n9\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n10\timport { createFromEvent } from \"../../messages/index.js\";\n11\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n12\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n13\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n14\t\n15\t// Test seam (set only through test/fixtures): called after each event is\n16\t// processed inside the walk, so atomicity under mid-walk failure can be\n17\t// induced through a real mechanism — closing the handle — rather than a\n18\t// mocked transaction object.\n19\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n20\tlet walkHook: IntakeWalkHook | null = null;\n21\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n22\t  walkHook = hook;\n23\t}\n24\t\n25\t// Test seam (set only through test/fixtures): replaces the wall clock so\n26\t// recordedAt is sourced deterministically for the public SDK contract proof —\n27\t// TC-1.4 records the same batch through both reference forms and reads it back\n28\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n29\t// production: recording stamps real wall time. An explicit clock argument to\n30\t// runMessageEvents still wins over the seam.\n31\tlet injectedClock: (() => Date) | null = null;\n32\texport function setIntakeClock(clock: (() => Date) | null): void {\n33\t  injectedClock = clock;\n34\t}\n35\t\n36\tfunction detail(cause: unknown): string {\n37\t  return cause instanceof Error ? cause.message : String(cause);\n38\t}\n39\t\n40\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n41\t  return {\n42\t    ok: false,\n43\t    error: {\n44\t      errorClass: \"caller_error\",\n45\t      code: \"thread_not_found\",\n46\t      reason: `no thread file exists at ${filePath}`,\n47\t    },\n48\t  };\n49\t}\n50\t\n51\t// The skip set is read at transaction start and reads only the key column:\n52\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n53\t// Chunked to stay under SQLite's bound-parameter limit.\n54\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n55\t  const found = new Set<string>();\n56\t  for (let offset = 0; offset < keys.length; offset += 400) {\n57\t    const chunk = keys.slice(offset, offset + 400);\n58\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n59\t    const rows = db\n60\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n61\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n62\t    for (const row of rows) found.add(row.idempotency_key);\n63\t  }\n64\t  return found;\n65\t}\n66\t\n67\tfunction threadIdOf(db: DatabaseSync): string {\n68\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n69\t    | { thread_id: string }\n70\t    | undefined;\n71\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n72\t  return row.thread_id;\n73\t}\n74\t\n75\tfunction maxEventOrder(db: DatabaseSync): number {\n76\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n77\t    | { max_order: number | bigint | null }\n78\t    | undefined;\n79\t  return Number(row?.max_order ?? 0);\n80\t}\n81\t\n82\texport async function runMessageEvents(\n83\t  thread: ThreadRef,\n84\t  events: readonly MessageEventInput[],\n85\t  clock: () => Date = injectedClock ?? (() => new Date()),\n86\t): Promise<OpResult<BatchResult>> {\n87\t  // Pure validation first: a rejected batch never opens the file, never takes\n88\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n89\t  // not a skip (validation-before-idempotency precedence).\n90\t  const refFailure = validateThreadRef(thread);\n91\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n92\t  const batchFailure = validateEvents(events);\n93\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n94\t\n95\t  const resolved = await resolveThreadRef(thread);\n96\t  if (!resolved.ok) return resolved;\n97\t  const { filePath } = resolved.value;\n98\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n99\t\n100\t  // openThreadDatabase verifies the file is a real thread file, then brings\n101\t  // its schema to the current version before the batch transaction begins,\n102\t  // so a thread recorded under an earlier story is writable here (F-03-001)\n103\t  // and a non-thread file is rejected unmutated (F-03-002).\n104\t  const opened = openThreadDatabase(filePath);\n105\t  if (!opened.ok) return opened;\n106\t  const db = opened.value;\n107\t\n108\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n109\t  // single-writer violations fail loudly at a defined point.\n110\t  let inTransaction = false;\n111\t  try {\n112\t    db.exec(\"BEGIN IMMEDIATE;\");\n113\t    inTransaction = true;\n114\t\n115\t    const skipSet = recordedKeys(\n116\t      db,\n117\t      events.map((event) => event.idempotencyKey),\n118\t    );\n119\t    // Order counter from MAX(event_order): only recorded events increment it,\n120\t    // so skips consume no order numbers and the sequence stays dense.\n121\t    let lastOrder = maxEventOrder(db);\n122\t\n123\t    const insert = db.prepare(\n124\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n125\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n126\t    );\n127\t\n128\t    // Cross-domain calls inside the transaction share the open handle through\n129\t    // the operation context (design decision 8); built once per batch, never\n130\t    // stored.\n131\t    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n132\t\n133\t    const eventResults: BatchResult[\"events\"] = [];\n134\t    for (const [index, event] of events.entries()) {\n135\t      if (skipSet.has(event.idempotencyKey)) {\n136\t        eventResults.push({\n137\t          idempotencyKey: event.idempotencyKey,\n138\t          outcome: \"skipped\",\n139\t          skipReason: \"duplicate_idempotency_key\",\n140\t        });\n141\t      } else {\n142\t        lastOrder += 1;\n143\t        const recordedAt = clock().toISOString();\n144\t        insert.run(\n145\t          lastOrder,\n146\t          event.eventKind,\n147\t          event.idempotencyKey,\n148\t          event.actor,\n149\t          event.harness,\n150\t          JSON.stringify(event.payload),\n151\t          recordedAt,\n152\t        );\n153\t        skipSet.add(event.idempotencyKey);\n154\t        // Projection runs in the same iteration that recorded the event, so\n155\t        // it can never drift from its source; a projection failure throws\n156\t        // and rejects the whole batch. Skipped events never reach this call\n157\t        // (no duplicate message, AC-5.4).\n158\t        const created = createFromEvent(ctx, {\n159\t          ...event,\n160\t          eventOrder: lastOrder,\n161\t          recordedAt,\n162\t        });\n163\t        const entry: BatchResult[\"events\"][number] = {\n164\t          idempotencyKey: event.idempotencyKey,\n165\t          outcome: \"recorded\",\n166\t        };\n167\t        if (created !== null) entry.messageId = created.messageId;\n168\t        eventResults.push(entry);\n169\t      }\n170\t      walkHook?.(db, index);\n171\t    }\n172\t\n173\t    db.exec(\"COMMIT;\");\n174\t    inTransaction = false;\n175\t\n176\t    return {\n177\t      ok: true,\n178\t      value: {\n179\t        events: eventResults,\n180\t        turnTransitions: [], // populated by Story 4\n181\t        queuedWork: [], // populated by Story 5\n182\t        threadPosition: { lastEventOrder: lastOrder },\n183\t      },\n184\t    };\n185\t  } catch (cause) {\n186\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n187\t    // class-independent. The handle may already be gone (induced failure),\n188\t    // in which case SQLite has already discarded the uncommitted transaction.\n189\t    if (inTransaction) {\n190\t      try {\n191\t        db.exec(\"ROLLBACK;\");\n192\t      } catch {\n193\t        // handle closed mid-walk; the open transaction died with it\n194\t      }\n195\t    }\n196\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n197\t  } finally {\n198\t    try {\n199\t      db.close();\n200\t    } catch {\n201\t      // already closed by the induced-failure seam\n202\t    }\n203\t  }\n204\t}\n205\t\n206\tinterface RawEventRow {\n207\t  event_order: number | bigint;\n208\t  event_kind: string;\n209\t  idempotency_key: string;\n210\t  actor: string;\n211\t  harness: string;\n212\t  payload: string;\n213\t  recorded_at: string;\n214\t}\n215\t\n216\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n217\t  const refFailure = validateThreadRef(thread);\n218\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n219\t\n220\t  const resolved = await resolveThreadRef(thread);\n221\t  if (!resolved.ok) return resolved;\n222\t  const { filePath } = resolved.value;\n223\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n224\t\n225\t  const opened = openThreadDatabase(filePath);\n226\t  if (!opened.ok) return opened;\n227\t  const db = opened.value;\n228\t  try {\n229\t    const rows = db\n230\t      .prepare(\n231\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n232\t         FROM event ORDER BY event_order`,\n233\t      )\n234\t      .all() as unknown as RawEventRow[];\n235\t    const records = rows.map(\n236\t      (row) =>\n237\t        ({\n238\t          eventKind: row.event_kind,\n239\t          idempotencyKey: row.idempotency_key,\n240\t          actor: row.actor,\n241\t          harness: row.harness,\n242\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n243\t          eventOrder: Number(row.event_order),\n244\t          recordedAt: row.recorded_at,\n245\t        }) as unknown as EventRecord,\n246\t    );\n247\t    return { ok: true, value: records };\n248\t  } catch (cause) {\n249\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n250\t  } finally {\n251\t    db.close();\n252\t  }\n253\t}\n254\t"}]},"parent_tool_use_id":null,"session_id":"aadaa07d-c15f-4e26-9167-6bca5f9b186c","uuid":"bb537da2-3768-43db-99b4-a54a1573dc0b","timestamp":"2026-06-10T14:31:18.009Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n// Stories 3–5 extend the same per-event walk with projection, turn\n// transitions, and work queueing.\nimport { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport { createFromEvent } from \"../../messages/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\nimport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\nimport { validateEvents, validateThreadRef } from \"./validate.js\";\n\n// Test seam (set only through test/fixtures): called after each event is\n// processed inside the walk, so atomicity under mid-walk failure can be\n// induced through a real mechanism — closing the handle — rather than a\n// mocked transaction object.\nexport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\nlet walkHook: IntakeWalkHook | null = null;\nexport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n  walkHook = hook;\n}\n\n// Test seam (set only through test/fixtures): replaces the wall clock so\n// recordedAt is sourced deterministically for the public SDK contract proof —\n// TC-1.4 records the same batch through both reference forms and reads it back\n// field-for-field, recordedAt included, with nothing stripped. Unset in\n// production: recording stamps real wall time. An explicit clock argument to\n// runMessageEvents still wins over the seam.\nlet injectedClock: (() => Date) | null = null;\nexport function setIntakeClock(clock: (() => Date) | null): void {\n  injectedClock = clock;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The skip set is read at transaction start and reads only the key column:\n// key-wins-over-content is the absence of a content comparison (AC-5.5).\n// Chunked to stay under SQLite's bound-parameter limit.\nfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n  const found = new Set<string>();\n  for (let offset = 0; offset < keys.length; offset += 400) {\n    const chunk = keys.slice(offset, offset + 400);\n    const placeholders = chunk.map(() => \"?\").join(\", \");\n    const rows = db\n      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    for (const row of rows) found.add(row.idempotency_key);\n  }\n  return found;\n}\n\nfunction threadIdOf(db: DatabaseSync): string {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n  return row.thread_id;\n}\n\nfunction maxEventOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0);\n}\n\nexport async function runMessageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n  clock: () => Date = injectedClock ?? (() => new Date()),\n): Promise<OpResult<BatchResult>> {\n  // Pure validation first: a rejected batch never opens the file, never takes\n  // the write lock, and a duplicate key on a malformed event is a rejection,\n  // not a skip (validation-before-idempotency precedence).\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n  const batchFailure = validateEvents(events);\n  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file, then brings\n  // its schema to the current version before the batch transaction begins,\n  // so a thread recorded under an earlier story is writable here (F-03-001)\n  // and a non-thread file is rejected unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n\n  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n  // single-writer violations fail loudly at a defined point.\n  let inTransaction = false;\n  try {\n    db.exec(\"BEGIN IMMEDIATE;\");\n    inTransaction = true;\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    // Cross-domain calls inside the transaction share the open handle through\n    // the operation context (design decision 8); built once per batch, never\n    // stored.\n    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n\n    const eventResults: BatchResult[\"events\"] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        const recordedAt = clock().toISOString();\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          recordedAt,\n        );\n        skipSet.add(event.idempotencyKey);\n        // Projection runs in the same iteration that recorded the event, so\n        // it can never drift from its source; a projection failure throws\n        // and rejects the whole batch. Skipped events never reach this call\n        // (no duplicate message, AC-5.4).\n        const created = createFromEvent(ctx, {\n          ...event,\n          eventOrder: lastOrder,\n          recordedAt,\n        });\n        const entry: BatchResult[\"events\"][number] = {\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"recorded\",\n        };\n        if (created !== null) entry.messageId = created.messageId;\n        eventResults.push(entry);\n      }\n      walkHook?.(db, index);\n    }\n\n    db.exec(\"COMMIT;\");\n    inTransaction = false;\n\n    return {\n      ok: true,\n      value: {\n        events: eventResults,\n        turnTransitions: [], // populated by Story 4\n        queuedWork: [], // populated by Story 5\n        threadPosition: { lastEventOrder: lastOrder },\n      },\n    };\n  } catch (cause) {\n    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n    // class-independent. The handle may already be gone (induced failure),\n    // in which case SQLite has already discarded the uncommitted transaction.\n    if (inTransaction) {\n      try {\n        db.exec(\"ROLLBACK;\");\n      } catch {\n        // handle closed mid-walk; the open transaction died with it\n      }\n    }\n    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n  } finally {\n    try {\n      db.close();\n    } catch {\n      // already closed by the induced-failure seam\n    }\n  }\n}\n\ninterface RawEventRow {\n  event_order: number | bigint;\n  event_kind: string;\n  idempotency_key: string;\n  actor: string;\n  harness: string;\n  payload: string;\n  recorded_at: string;\n}\n\nexport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const rows = db\n      .prepare(\n        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n         FROM event ORDER BY event_order`,\n      )\n      .all() as unknown as RawEventRow[];\n    const records = rows.map(\n      (row) =>\n        ({\n          eventKind: row.event_kind,\n          idempotencyKey: row.idempotency_key,\n          actor: row.actor,\n          harness: row.harness,\n          payload: JSON.parse(row.payload) as Record<string, unknown>,\n          eventOrder: Number(row.event_order),\n          recordedAt: row.recorded_at,\n        }) as unknown as EventRecord,\n    );\n    return { ok: true, value: records };\n  } catch (cause) {\n    return storageFailure(`event read-back failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":254,"startLine":1,"totalLines":254}}}

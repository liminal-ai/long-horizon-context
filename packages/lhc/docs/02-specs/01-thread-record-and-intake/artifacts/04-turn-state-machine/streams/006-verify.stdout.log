{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts | sed -n '110,225p'\"","aggregated_output":"   110\t  // single-writer violations fail loudly at a defined point.\n   111\t  let inTransaction = false;\n   112\t  try {\n   113\t    db.exec(\"BEGIN IMMEDIATE;\");\n   114\t    inTransaction = true;\n   115\t\n   116\t    // Cross-domain calls inside the transaction share the open handle through\n   117\t    // the operation context (design decision 8); built once per batch, never\n   118\t    // stored.\n   119\t    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n   120\t\n   121\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n   122\t    // any event is processed — once is sufficient because only this pipeline\n   123\t    // writes turn state and the write lock is already held, so more than one\n   124\t    // open turn can only mean external interference. The batch records\n   125\t    // nothing: nothing has been written yet, and the rollback closes the\n   126\t    // never-used transaction.\n   127\t    const openTurnIds = listOpenTurnIds(ctx);\n   128\t    if (openTurnIds.length > 1) {\n   129\t      db.exec(\"ROLLBACK;\");\n   130\t      inTransaction = false;\n   131\t      return {\n   132\t        ok: false,\n   133\t        error: {\n   134\t          errorClass: \"state_corruption\",\n   135\t          code: \"turn_state_corrupt\",\n   136\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n   137\t        },\n   138\t      };\n   139\t    }\n   140\t\n   141\t    const skipSet = recordedKeys(\n   142\t      db,\n   143\t      events.map((event) => event.idempotencyKey),\n   144\t    );\n   145\t    // Order counter from MAX(event_order): only recorded events increment it,\n   146\t    // so skips consume no order numbers and the sequence stays dense.\n   147\t    let lastOrder = maxEventOrder(db);\n   148\t\n   149\t    const insert = db.prepare(\n   150\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   151\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   152\t    );\n   153\t\n   154\t    const eventResults: BatchResult[\"events\"] = [];\n   155\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n   156\t    for (const [index, event] of events.entries()) {\n   157\t      if (skipSet.has(event.idempotencyKey)) {\n   158\t        eventResults.push({\n   159\t          idempotencyKey: event.idempotencyKey,\n   160\t          outcome: \"skipped\",\n   161\t          skipReason: \"duplicate_idempotency_key\",\n   162\t        });\n   163\t      } else {\n   164\t        lastOrder += 1;\n   165\t        const recordedAt = clock().toISOString();\n   166\t        insert.run(\n   167\t          lastOrder,\n   168\t          event.eventKind,\n   169\t          event.idempotencyKey,\n   170\t          event.actor,\n   171\t          event.harness,\n   172\t          JSON.stringify(event.payload),\n   173\t          recordedAt,\n   174\t        );\n   175\t        skipSet.add(event.idempotencyKey);\n   176\t        // Turn transition before projection — the order is load-bearing: a\n   177\t        // prompt transitions first and stamps to the turn it just opened\n   178\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n   179\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n   180\t        // call, so a resend causes no transition (TC-5.4).\n   181\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n   182\t        turnTransitions.push(...turnOutcome.transitions);\n   183\t        // Projection runs in the same iteration that recorded the event, so\n   184\t        // it can never drift from its source; a projection failure throws\n   185\t        // and rejects the whole batch. Skipped events never reach this call\n   186\t        // (no duplicate message, AC-5.4).\n   187\t        const created = createFromEvent(\n   188\t          ctx,\n   189\t          {\n   190\t            ...event,\n   191\t            eventOrder: lastOrder,\n   192\t            recordedAt,\n   193\t          },\n   194\t          turnOutcome.openTurnId,\n   195\t        );\n   196\t        const entry: BatchResult[\"events\"][number] = {\n   197\t          idempotencyKey: event.idempotencyKey,\n   198\t          outcome: \"recorded\",\n   199\t        };\n   200\t        if (created !== null) entry.messageId = created.messageId;\n   201\t        eventResults.push(entry);\n   202\t      }\n   203\t      walkHook?.(db, index);\n   204\t    }\n   205\t\n   206\t    db.exec(\"COMMIT;\");\n   207\t    inTransaction = false;\n   208\t\n   209\t    return {\n   210\t      ok: true,\n   211\t      value: {\n   212\t        events: eventResults,\n   213\t        turnTransitions,\n   214\t        queuedWork: [], // populated by Story 5\n   215\t        threadPosition: { lastEventOrder: lastOrder },\n   216\t      },\n   217\t    };\n   218\t  } catch (cause) {\n   219\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n   220\t    // class-independent. The handle may already be gone (induced failure),\n   221\t    // in which case SQLite has already discarded the uncommitted transaction.\n   222\t    if (inTransaction) {\n   223\t      try {\n   224\t        db.exec(\"ROLLBACK;\");\n   225\t      } catch {\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/store.ts | sed -n '1,120p'\"","aggregated_output":"     1\t// Turn row operations. Writes run on the caller's handle inside the batch\n     2\t// transaction; reads run on a fresh handle per operation. A closed turn has\n     3\t// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n     4\t// any UPDATE that touches a closed row.\n     5\timport type { DatabaseSync } from \"node:sqlite\";\n     6\timport type { TurnRecord } from \"../index.js\";\n     7\t\n     8\texport function selectOpenTurnIds(db: DatabaseSync): string[] {\n     9\t  const rows = db\n    10\t    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n    11\t    .all() as unknown as Array<{ turn_id: string }>;\n    12\t  return rows.map((row) => row.turn_id);\n    13\t}\n    14\t\n    15\texport function nextTurnOrder(db: DatabaseSync): number {\n    16\t  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n    17\t    | { max_order: number | bigint | null }\n    18\t    | undefined;\n    19\t  return Number(row?.max_order ?? 0) + 1;\n    20\t}\n    21\t\n    22\texport function insertOpenTurn(\n    23\t  db: DatabaseSync,\n    24\t  turnOrder: number,\n    25\t  openedAtEventOrder: number,\n    26\t): string {\n    27\t  const turnId = `t${turnOrder}`;\n    28\t  db.prepare(\n    29\t    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n    30\t     VALUES (?, ?, 'open', ?)`,\n    31\t  ).run(turnId, turnOrder, openedAtEventOrder);\n    32\t  return turnId;\n    33\t}\n    34\t\n    35\texport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n    36\t  db.prepare(\n    37\t    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n    38\t  ).run(closedAtEventOrder, turnId);\n    39\t}\n    40\t\n    41\tinterface RawTurnRow {\n    42\t  turn_id: string;\n    43\t  status: string;\n    44\t  opened_at_event_order: number | bigint;\n    45\t  closed_at_event_order: number | bigint | null;\n    46\t}\n    47\t\n    48\t// Membership is stored on the member (message.turn_id), never as a list on\n    49\t// the turn: memberMessageIds is a query, ordered by event order, so there is\n    50\t// exactly one source of truth.\n    51\texport function readTurns(db: DatabaseSync): TurnRecord[] {\n    52\t  const memberRows = db\n    53\t    .prepare(\n    54\t      `SELECT message_id, turn_id FROM message\n    55\t       WHERE turn_id IS NOT NULL ORDER BY source_event_order`,\n    56\t    )\n    57\t    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n    58\t  const membersByTurn = new Map<string, string[]>();\n    59\t  for (const row of memberRows) {\n    60\t    const members = membersByTurn.get(row.turn_id) ?? [];\n    61\t    members.push(row.message_id);\n    62\t    membersByTurn.set(row.turn_id, members);\n    63\t  }\n    64\t\n    65\t  const turnRows = db\n    66\t    .prepare(\n    67\t      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n    68\t       FROM turns ORDER BY turn_order`,\n    69\t    )\n    70\t    .all() as unknown as RawTurnRow[];\n    71\t  return turnRows.map((row) => {\n    72\t    const record: TurnRecord = {\n    73\t      turnId: row.turn_id,\n    74\t      status: row.status as TurnRecord[\"status\"],\n    75\t      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n    76\t      openedAtEventOrder: Number(row.opened_at_event_order),\n    77\t    };\n    78\t    if (row.closed_at_event_order !== null) {\n    79\t      record.closedAtEventOrder = Number(row.closed_at_event_order);\n    80\t    }\n    81\t    return record;\n    82\t  });\n    83\t}\n","exit_code":0,"status":"completed"}}

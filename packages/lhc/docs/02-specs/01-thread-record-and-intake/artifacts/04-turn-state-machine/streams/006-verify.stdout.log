{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '45,80p'\"","aggregated_output":"    45\t} | null;\n    46\t\n    47\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    48\t// (the first such call through the operation context; turns.applyEvent\n    49\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    50\t// projection failure propagates to the pipeline's catch and rejects the\n    51\t// whole batch — recorded events without messages is the stranded state the\n    52\t// transaction exists to prevent. Returns null for turn_end (no message).\n    53\t// turnId is the membership stamp, settled by the pipeline before this call:\n    54\t// the turn open *after* this event's transition (so a prompt belongs to the\n    55\t// turn it just opened), or null in a gap — written once, never updated.\n    56\texport function createFromEvent(\n    57\t  ctx: OperationContext,\n    58\t  event: RecordedEvent,\n    59\t  turnId: string | null,\n    60\t): MessageCreated {\n    61\t  const projected = projectEvent(event);\n    62\t  if (projected === null) return null;\n    63\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    64\t  const messageId = `m${event.eventOrder}`;\n    65\t  insertMessage(ctx.db, {\n    66\t    messageId,\n    67\t    sourceEventOrder: event.eventOrder,\n    68\t    kind,\n    69\t    tokenEstimate: projected.tokenEstimate,\n    70\t    actor: event.actor,\n    71\t    harness: event.harness,\n    72\t    turnId,\n    73\t    blocks: projected.blocks,\n    74\t  });\n    75\t  return { messageId, kind };\n    76\t}\n    77\t\n    78\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    79\t  return {\n    80\t    ok: false,\n","exit_code":0,"status":"completed"}}

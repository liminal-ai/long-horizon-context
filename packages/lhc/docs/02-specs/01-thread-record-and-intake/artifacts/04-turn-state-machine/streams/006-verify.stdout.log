{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,140p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport type { OperationContext } from \"../../shared/context.js\";\n     3\timport {\n     4\t  notImplemented,\n     5\t  storageFailure,\n     6\t  type ErrorResult,\n     7\t  type OpResult,\n     8\t} from \"../../shared/errors.js\";\n     9\timport type { WorkItemRecord } from \"../../tech-utils/work-queue/index.js\";\n    10\timport type { EventKind } from \"../intake-stream/index.js\";\n    11\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    12\timport { transition } from \"./internal/state-machine.js\";\n    13\t\n    14\t// The pure rule table, re-exported for the golden supplemental suite (the\n    15\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    16\t// callers go through applyEvent.\n    17\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    18\timport {\n    19\t  closeTurn,\n    20\t  insertOpenTurn,\n    21\t  nextTurnOrder,\n    22\t  readTurns,\n    23\t  selectOpenTurnIds,\n    24\t} from \"./internal/store.js\";\n    25\t\n    26\texport interface TurnRecord {\n    27\t  turnId: string;\n    28\t  status: \"open\" | \"closed\";\n    29\t  memberMessageIds: string[];\n    30\t  openedAtEventOrder: number;\n    31\t  closedAtEventOrder?: number;\n    32\t}\n    33\t\n    34\texport interface TurnTransitionOutcome {\n    35\t  // Transitions in occurrence order: a close_then_open reports the close\n    36\t  // first, then the open, exactly as the batch result surfaces them.\n    37\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    38\t  // Turn state after the transition — the stamp for this event's message.\n    39\t  // Prompts see the turn they just opened (transition first, then stamp);\n    40\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    41\t  openTurnId: string | null;\n    42\t}\n    43\t\n    44\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    45\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    46\t// writes turn state, so more than one open turn means external interference.\n    47\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    48\t  return selectOpenTurnIds(ctx.db);\n    49\t}\n    50\t\n    51\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    52\t// for every recorded event. Synchronous and throwing by design, like\n    53\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n    54\t// Closing a turn queues nothing here — Story 5 adds the turn_derivation work\n    55\t// item to this already-working close path inside the same transaction.\n    56\texport function applyEvent(\n    57\t  ctx: OperationContext,\n    58\t  eventKind: EventKind,\n    59\t  eventOrder: number,\n    60\t): TurnTransitionOutcome {\n    61\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n    62\t  const effect = transition({ openTurnId }, eventKind);\n    63\t  switch (effect.kind) {\n    64\t    case \"none\":\n    65\t      return { transitions: [], openTurnId };\n    66\t    case \"open\": {\n    67\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n    68\t      return { transitions: [{ action: \"opened\", turnId }], openTurnId: turnId };\n    69\t    }\n    70\t    case \"close\": {\n    71\t      closeTurn(ctx.db, openTurnId as string, eventOrder);\n    72\t      return {\n    73\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n    74\t        openTurnId: null,\n    75\t      };\n    76\t    }\n    77\t    case \"close_then_open\": {\n    78\t      closeTurn(ctx.db, openTurnId as string, eventOrder);\n    79\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n    80\t      return {\n    81\t        transitions: [\n    82\t          { action: \"closed\", turnId: openTurnId as string },\n    83\t          { action: \"opened\", turnId },\n    84\t        ],\n    85\t        openTurnId: turnId,\n    86\t      };\n    87\t    }\n    88\t  }\n    89\t}\n    90\t\n    91\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    92\t  return {\n    93\t    ok: false,\n    94\t    error: {\n    95\t      errorClass: \"caller_error\",\n    96\t      code: \"thread_not_found\",\n    97\t      reason: `no thread file exists at ${filePath}`,\n    98\t    },\n    99\t  };\n   100\t}\n   101\t\n   102\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   103\t  const resolved = await resolveThreadRef(thread);\n   104\t  if (!resolved.ok) return resolved;\n   105\t  const { filePath } = resolved.value;\n   106\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   107\t\n   108\t  const opened = openThreadDatabase(filePath);\n   109\t  if (!opened.ok) return opened;\n   110\t  const db = opened.value;\n   111\t  try {\n   112\t    return { ok: true, value: readTurns(db) };\n   113\t  } catch (cause) {\n   114\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   115\t    return storageFailure(`turn read-back failed: ${reason}`);\n   116\t  } finally {\n   117\t    db.close();\n   118\t  }\n   119\t}\n   120\t\n   121\texport async function listQueuedWork(\n   122\t  _thread: ThreadRef,\n   123\t): Promise<OpResult<WorkItemRecord[]>> {\n   124\t  return notImplemented(\"turns.list-queued-work\");\n   125\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/turns.test.ts | sed -n '69,405p'\"","aggregated_output":"    69\t  it(\"TC-3.1: a prompt opens a turn and the whole activity stamps to it (AC-3.1, AC-3.2)\", async () => {\n    70\t    const filePath = await createThread();\n    71\t    const result = await send(filePath, [\n    72\t      validEvent(\"user_prompt\"),\n    73\t      validEvent(\"assistant_text\"),\n    74\t      validEvent(\"tool_call\"),\n    75\t      validEvent(\"tool_result\"),\n    76\t    ]);\n    77\t    expect(result.turnTransitions).toEqual([{ action: \"opened\", turnId: \"t1\" }]);\n    78\t\n    79\t    const turnRecords = await readTurns(filePath);\n    80\t    expect(turnRecords).toEqual([\n    81\t      {\n    82\t        turnId: \"t1\",\n    83\t        status: \"open\",\n    84\t        memberMessageIds: [\"m1\", \"m2\", \"m3\", \"m4\"],\n    85\t        openedAtEventOrder: 1,\n    86\t      },\n    87\t    ]);\n    88\t\n    89\t    // Membership is also visible on the members themselves.\n    90\t    const projected = await messages.listMessages({ filePath });\n    91\t    expect(projected.ok).toBe(true);\n    92\t    if (!projected.ok) return;\n    93\t    expect(projected.value.map((message) => message.turnId)).toEqual([\"t1\", \"t1\", \"t1\", \"t1\"]);\n    94\t  });\n    95\t\n    96\t  it(\"TC-3.2: a second prompt closes the open turn and opens a new one holding only the prompt (AC-3.3)\", async () => {\n    97\t    const filePath = await createThread();\n    98\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n    99\t\n   100\t    const second = await send(filePath, [validEvent(\"user_prompt\")]);\n   101\t    expect(second.turnTransitions).toEqual([\n   102\t      { action: \"closed\", turnId: \"t1\" },\n   103\t      { action: \"opened\", turnId: \"t2\" },\n   104\t    ]);\n   105\t\n   106\t    const turnRecords = await readTurns(filePath);\n   107\t    expect(turnRecords).toEqual([\n   108\t      {\n   109\t        turnId: \"t1\",\n   110\t        status: \"closed\",\n   111\t        memberMessageIds: [\"m1\", \"m2\"],\n   112\t        openedAtEventOrder: 1,\n   113\t        closedAtEventOrder: 3,\n   114\t      },\n   115\t      {\n   116\t        turnId: \"t2\",\n   117\t        status: \"open\",\n   118\t        memberMessageIds: [\"m3\"],\n   119\t        openedAtEventOrder: 3,\n   120\t      },\n   121\t    ]);\n   122\t  });\n   123\t\n   124\t  it(\"TC-3.3 (transition + membership half): turn_end closes the open turn (AC-3.4; work item is Story 5's)\", async () => {\n   125\t    const filePath = await createThread();\n   126\t    const result = await send(filePath, [\n   127\t      validEvent(\"user_prompt\"),\n   128\t      validEvent(\"assistant_text\"),\n   129\t      validEvent(\"turn_end\"),\n   130\t    ]);\n   131\t    expect(result.turnTransitions).toEqual([\n   132\t      { action: \"opened\", turnId: \"t1\" },\n   133\t      { action: \"closed\", turnId: \"t1\" },\n   134\t    ]);\n   135\t\n   136\t    const turnRecords = await readTurns(filePath);\n   137\t    expect(turnRecords).toEqual([\n   138\t      {\n   139\t        turnId: \"t1\",\n   140\t        status: \"closed\",\n   141\t        memberMessageIds: [\"m1\", \"m2\"],\n   142\t        openedAtEventOrder: 1,\n   143\t        closedAtEventOrder: 3,\n   144\t      },\n   145\t    ]);\n   146\t  });\n   147\t\n   148\t  it(\"TC-3.4: an orphan turn_end is recorded but inert; the next prompt opens t1 normally (AC-3.5)\", async () => {\n   149\t    const filePath = await createThread();\n   150\t    const orphan = await send(filePath, [validEvent(\"turn_end\")]);\n   151\t    expect(orphan.turnTransitions).toEqual([]);\n   152\t    expect(orphan.events[0]!.outcome).toBe(\"recorded\");\n   153\t\n   154\t    const events = await intakeStream.listEvents({ filePath });\n   155\t    expect(events.ok).toBe(true);\n   156\t    if (!events.ok) return;\n   157\t    expect(events.value).toHaveLength(1);\n   158\t    expect(events.value[0]!.eventOrder).toBe(1);\n   159\t\n   160\t    expect(await readTurns(filePath)).toEqual([]);\n   161\t\n   162\t    const next = await send(filePath, [validEvent(\"user_prompt\")]);\n   163\t    expect(next.turnTransitions).toEqual([{ action: \"opened\", turnId: \"t1\" }]);\n   164\t    expect(await readTurns(filePath)).toEqual([\n   165\t      { turnId: \"t1\", status: \"open\", memberMessageIds: [\"m2\"], openedAtEventOrder: 2 },\n   166\t    ]);\n   167\t  });\n   168\t\n   169\t  it(\"TC-3.5: gap messages stay membershipless forever; the closed turn reads back unchanged (AC-3.7, AC-3.8)\", async () => {\n   170\t    const filePath = await createThread();\n   171\t    await send(filePath, [\n   172\t      validEvent(\"user_prompt\"),\n   173\t      validEvent(\"assistant_text\"),\n   174\t      validEvent(\"turn_end\"),\n   175\t    ]);\n   176\t    const closedBefore = (await readTurns(filePath))[0]!;\n   177\t\n   178\t    // Post-close, pre-prompt: a gap message with no membership.\n   179\t    await send(filePath, [validEvent(\"assistant_text\")]);\n   180\t    // A new prompt opens t2; the gap message must not be adopted into it.\n   181\t    await send(filePath, [validEvent(\"user_prompt\")]);\n   182\t\n   183\t    const projected = await messages.listMessages({ filePath });\n   184\t    expect(projected.ok).toBe(true);\n   185\t    if (!projected.ok) return;\n   186\t    const gap = projected.value.find((message) => message.messageId === \"m4\")!;\n   187\t    expect(gap.turnId).toBeUndefined();\n   188\t\n   189\t    const turnRecords = await readTurns(filePath);\n   190\t    // Frozenness is behavioral: the closed turn's full record — members\n   191\t    // included — is identical after the later activity.\n   192\t    expect(turnRecords[0]).toEqual(closedBefore);\n   193\t    expect(turnRecords[1]).toEqual({\n   194\t      turnId: \"t2\",\n   195\t      status: \"open\",\n   196\t      memberMessageIds: [\"m5\"],\n   197\t      openedAtEventOrder: 5,\n   198\t    });\n   199\t  });\n   200\t\n   201\t  it(\"TC-3.6 (transition half): implicit close behaves exactly like explicit close (work parity is Story 5's)\", async () => {\n   202\t    const explicitPath = await createThread();\n   203\t    await send(explicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n   204\t    const explicitClose = await send(explicitPath, [validEvent(\"turn_end\")]);\n   205\t\n   206\t    const implicitPath = await createThread();\n   207\t    await send(implicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n   208\t    const implicitClose = await send(implicitPath, [validEvent(\"user_prompt\")]);\n   209\t\n   210\t    // Both paths close t1 at event order 3 with the same frozen membership.\n   211\t    expect(explicitClose.turnTransitions[0]).toEqual({ action: \"closed\", turnId: \"t1\" });\n   212\t    expect(implicitClose.turnTransitions[0]).toEqual({ action: \"closed\", turnId: \"t1\" });\n   213\t    const explicitT1 = (await readTurns(explicitPath))[0];\n   214\t    const implicitT1 = (await readTurns(implicitPath))[0];\n   215\t    expect(explicitT1).toEqual(implicitT1);\n   216\t  });\n   217\t\n   218\t  it(\"TC-3.7: two open turns fail any batch with turn_state_corrupt and the batch records nothing (AC-3.9)\", async () => {\n   219\t    const filePath = await createThread();\n   220\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n   221\t    corruptTwoOpenTurns(filePath);\n   222\t\n   223\t    // Baseline captured after the corruption: the failed batch must add\n   224\t    // nothing on top of it — full read-back diff, not just the error code.\n   225\t    const baseline = await readBack(filePath);\n   226\t\n   227\t    const failed = await intakeStream.messageEvents({ filePath }, [\n   228\t      validEvent(\"user_prompt\"),\n   229\t      validEvent(\"assistant_text\"),\n   230\t    ]);\n   231\t    expect(failed.ok).toBe(false);\n   232\t    if (failed.ok) return;\n   233\t    expect(failed.error.errorClass).toBe(\"state_corruption\");\n   234\t    expect(failed.error.code).toBe(\"turn_state_corrupt\");\n   235\t\n   236\t    // The check fired at state load, before any event was processed: no\n   237\t    // partial walk preceded detection (architecture-risk timing assertion,\n   238\t    // the rollback ladder's corruption rung).\n   239\t    expect(await readBack(filePath)).toEqual(baseline);\n   240\t  });\n   241\t\n   242\t  it(\"TC-3.8: one batch with two prompts and a turn_end yields two closed turns with correct membership (AC-3.3)\", async () => {\n   243\t    const filePath = await createThread();\n   244\t    const result = await send(filePath, [\n   245\t      validEvent(\"user_prompt\"),\n   246\t      validEvent(\"assistant_text\"),\n   247\t      validEvent(\"user_prompt\"),\n   248\t      validEvent(\"assistant_text\"),\n   249\t      validEvent(\"turn_end\"),\n   250\t    ]);\n   251\t\n   252\t    // Transitions in occurrence order, per event inside the walk.\n   253\t    expect(result.turnTransitions).toEqual([\n   254\t      { action: \"opened\", turnId: \"t1\" },\n   255\t      { action: \"closed\", turnId: \"t1\" },\n   256\t      { action: \"opened\", turnId: \"t2\" },\n   257\t      { action: \"closed\", turnId: \"t2\" },\n   258\t    ]);\n   259\t\n   260\t    expect(await readTurns(filePath)).toEqual([\n   261\t      {\n   262\t        turnId: \"t1\",\n   263\t        status: \"closed\",\n   264\t        memberMessageIds: [\"m1\", \"m2\"],\n   265\t        openedAtEventOrder: 1,\n   266\t        closedAtEventOrder: 3,\n   267\t      },\n   268\t      {\n   269\t        turnId: \"t2\",\n   270\t        status: \"closed\",\n   271\t        memberMessageIds: [\"m3\", \"m4\"],\n   272\t        openedAtEventOrder: 3,\n   273\t        closedAtEventOrder: 5,\n   274\t      },\n   275\t    ]);\n   276\t  });\n   277\t\n   278\t  it(\"TC-5.4 (no-transition clause): resending recorded events causes no transition and leaves turn state unchanged (AC-5.4)\", async () => {\n   279\t    const filePath = await createThread();\n   280\t    const prompt = validEvent(\"user_prompt\");\n   281\t    const end = validEvent(\"turn_end\");\n   282\t    await send(filePath, [prompt, validEvent(\"assistant_text\"), end]);\n   283\t    await send(filePath, [validEvent(\"user_prompt\")]); // t2 now open\n   284\t    const baseline = await readBack(filePath);\n   285\t\n   286\t    // A resent prompt cannot re-close a turn; a resent turn_end cannot close\n   287\t    // whatever happens to be open now.\n   288\t    const resend = await send(filePath, [prompt, end]);\n   289\t    expect(resend.events.map((entry) => entry.outcome)).toEqual([\"skipped\", \"skipped\"]);\n   290\t    expect(resend.turnTransitions).toEqual([]);\n   291\t    expect(await readBack(filePath)).toEqual(baseline);\n   292\t  });\n   293\t});\n   294\t\n   295\tdescribe(\"TC-4.4: three error classes, asserted against each other (AC-4.7)\", () => {\n   296\t  it(\"validation, corruption, and storage failures carry three distinct classes with stable codes\", async () => {\n   297\t    // Caller leg: a malformed event.\n   298\t    const callerPath = await createThread();\n   299\t    const callerLeg = await intakeStream.messageEvents({ filePath: callerPath }, [\n   300\t      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n   301\t    ]);\n   302\t    expect(callerLeg.ok).toBe(false);\n   303\t    if (callerLeg.ok) return;\n   304\t    expect(callerLeg.error.errorClass).toBe(\"caller_error\");\n   305\t    expect(callerLeg.error.code).toBe(\"invalid_event\");\n   306\t\n   307\t    // Corruption leg: the two-open-turns fixture.\n   308\t    const corruptPath = await createThread();\n   309\t    await send(corruptPath, [validEvent(\"user_prompt\")]);\n   310\t    corruptTwoOpenTurns(corruptPath);\n   311\t    const corruptionLeg = await intakeStream.messageEvents({ filePath: corruptPath }, [\n   312\t      validEvent(\"assistant_text\"),\n   313\t    ]);\n   314\t    expect(corruptionLeg.ok).toBe(false);\n   315\t    if (corruptionLeg.ok) return;\n   316\t    expect(corruptionLeg.error.errorClass).toBe(\"state_corruption\");\n   317\t    expect(corruptionLeg.error.code).toBe(\"turn_state_corrupt\");\n   318\t\n   319\t    // System leg: registry creation under a path whose parent is a file.\n   320\t    const blocker = join(store.dir, \"blocker-file\");\n   321\t    writeFileSync(blocker, \"regular file standing where a directory must be\");\n   322\t    const systemLeg = await threads.newThread({\n   323\t      filePath: store.threadPath(),\n   324\t      registryPath: join(blocker, \"registry.sqlite\"),\n   325\t    });\n   326\t    expect(systemLeg.ok).toBe(false);\n   327\t    if (systemLeg.ok) return;\n   328\t    expect(systemLeg.error.errorClass).toBe(\"system_error\");\n   329\t    expect(systemLeg.error.code).toBe(\"storage_failure\");\n   330\t\n   331\t    // The three classes compared against each other, not pattern-matched\n   332\t    // individually.\n   333\t    const classes = new Set([\n   334\t      callerLeg.error.errorClass,\n   335\t      corruptionLeg.error.errorClass,\n   336\t      systemLeg.error.errorClass,\n   337\t    ]);\n   338\t    expect(classes.size).toBe(3);\n   339\t\n   340\t    // The corruption class reaches the CLI error rendering unchanged.\n   341\t    const cliCorruption = await runCli(\n   342\t      [\"intake-stream\", \"message-events\", \"--file-path\", corruptPath],\n   343\t      async () => JSON.stringify([validEvent(\"assistant_text\")]),\n   344\t    );\n   345\t    expect(cliCorruption.exitCode).toBe(1);\n   346\t    const parsed = JSON.parse(cliCorruption.stdout) as {\n   347\t      ok: boolean;\n   348\t      error: { errorClass: string; code: string };\n   349\t    };\n   350\t    expect(parsed.ok).toBe(false);\n   351\t    expect(parsed.error.errorClass).toBe(\"state_corruption\");\n   352\t    expect(parsed.error.code).toBe(\"turn_state_corrupt\");\n   353\t  });\n   354\t});\n   355\t\n   356\tdescribe(\"Flow 3 (CLI in-process): turns list\", () => {\n   357\t  it(\"lists turn records with membership as JSON\", async () => {\n   358\t    const filePath = await createThread();\n   359\t    await send(filePath, [\n   360\t      validEvent(\"user_prompt\"),\n   361\t      validEvent(\"assistant_text\"),\n   362\t      validEvent(\"turn_end\"),\n   363\t      validEvent(\"user_prompt\"),\n   364\t    ]);\n   365\t\n   366\t    const listed = await runCli([\"turns\", \"list\", \"--file-path\", filePath]);\n   367\t    expect(listed.exitCode).toBe(0);\n   368\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; value: TurnRecord[] };\n   369\t    expect(parsed.ok).toBe(true);\n   370\t    expect(parsed.value).toEqual([\n   371\t      {\n   372\t        turnId: \"t1\",\n   373\t        status: \"closed\",\n   374\t        memberMessageIds: [\"m1\", \"m2\"],\n   375\t        openedAtEventOrder: 1,\n   376\t        closedAtEventOrder: 3,\n   377\t      },\n   378\t      {\n   379\t        turnId: \"t2\",\n   380\t        status: \"open\",\n   381\t        memberMessageIds: [\"m4\"],\n   382\t        openedAtEventOrder: 4,\n   383\t      },\n   384\t    ]);\n   385\t  });\n   386\t\n   387\t  it(\"turns list on an unknown thread id fails with thread_not_found\", async () => {\n   388\t    const listed = await runCli([\n   389\t      \"turns\",\n   390\t      \"list\",\n   391\t      \"--thread-id\",\n   392\t      \"th_nope\",\n   393\t      \"--registry\",\n   394\t      store.registryPath,\n   395\t    ]);\n   396\t    expect(listed.exitCode).toBe(1);\n   397\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; error: { code: string } };\n   398\t    expect(parsed.ok).toBe(false);\n   399\t    expect(parsed.error.code).toBe(\"thread_not_found\");\n   400\t  });\n   401\t});\n","exit_code":0,"status":"completed"}}

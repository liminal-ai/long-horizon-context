{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/scripts/fc07-gate-self-test.mjs | sed -n '1,140p'\"","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// FC-0.7 gate self-test — proves the verification gates fail when they should,\n     3\t// once, with REAL sacrificial files run through the REAL package scripts. This\n     4\t// is the load-bearing proof the story calls out: an unproven gate is an assumed\n     5\t// gate. Run once (Chunk 0), evidence recorded, sacrificial files removed.\n     6\t//\n     7\t//   Baseline : clean `pnpm run verify` exits 0 (also confirms the test typecheck fix).\n     8\t//   Proof 1  : a sacrificial FAILING test makes `pnpm run verify` exit non-zero.\n     9\t//   Proof 2a : an unchanged Red-manifest file passes `pnpm run green-verify` (the\n    10\t//              gate is discriminating, not always-fail).\n    11\t//   Proof 2b : editing that same Red-manifest file makes `pnpm run green-verify`\n    12\t//              fail at check-test-immutability — while `verify` itself stays green,\n    13\t//              so the failure is attributable to the immutability gate alone.\n    14\t//   End state: clean `pnpm run verify-all` exits 0 (files removed, manifest restored).\n    15\t//\n    16\t// Exits 0 only if every leg behaved exactly as required; non-zero otherwise.\n    17\timport { execFileSync } from \"node:child_process\";\n    18\timport { existsSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\n    19\timport path from \"node:path\";\n    20\timport { fileURLToPath } from \"node:url\";\n    21\t\n    22\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    23\tconst at = (p) => path.join(pkgRoot, p);\n    24\t\n    25\tconst FAILING = \"test/_fc07-failing.test.ts\";\n    26\tconst RED = \"test/_fc07-red.test.ts\";\n    27\tconst MANIFEST = \"test/red-manifest.json\";\n    28\tconst RECORD =\n    29\t  \"docs/02-specs/01-thread-record-and-intake/artifacts/00-foundation/fc-07-gate-self-test.md\";\n    30\t\n    31\tconst FAILING_SRC = `import { describe, expect, it } from \"vitest\";\n    32\t\n    33\t// FC-0.7 sacrificial: a deliberately failing assertion. Proves a failing test\n    34\t// fails \\`verify\\`. Created and removed by scripts/fc07-gate-self-test.mjs.\n    35\tdescribe(\"FC-0.7 sacrificial failing test\", () => {\n    36\t  it(\"fails on purpose so verify must go red\", () => {\n    37\t    expect(1).toBe(2);\n    38\t  });\n    39\t});\n    40\t`;\n    41\t\n    42\tconst RED_SRC = `import { describe, expect, it } from \"vitest\";\n    43\t\n    44\t// FC-0.7 sacrificial Red-phase test: passes, recorded into red-manifest.json,\n    45\t// then edited to prove green-verify's immutability check catches the change.\n    46\t// Created and removed by scripts/fc07-gate-self-test.mjs.\n    47\tdescribe(\"FC-0.7 sacrificial Red-phase test\", () => {\n    48\t  it(\"passes so verify stays green; the post-Red edit is what trips green-verify\", () => {\n    49\t    expect(true).toBe(true);\n    50\t  });\n    51\t});\n    52\t`;\n    53\t\n    54\tconst RED_EDIT = `\\n// Edited after the Red commit — green-verify's test-immutability check must reject this.\\n`;\n    55\t\n    56\tfunction runScript(script) {\n    57\t  try {\n    58\t    const out = execFileSync(\"pnpm\", [\"run\", script], {\n    59\t      cwd: pkgRoot,\n    60\t      encoding: \"utf8\",\n    61\t    });\n    62\t    return { code: 0, out };\n    63\t  } catch (e) {\n    64\t    const code = typeof e.status === \"number\" ? e.status : 1;\n    65\t    return { code, out: `${e.stdout ?? \"\"}${e.stderr ?? \"\"}` };\n    66\t  }\n    67\t}\n    68\t\n    69\tfunction tail(text, n = 30) {\n    70\t  const lines = text.replace(/\\s+$/, \"\").split(\"\\n\");\n    71\t  return lines.slice(Math.max(0, lines.length - n)).join(\"\\n\");\n    72\t}\n    73\t\n    74\tconst legs = [];\n    75\tfunction record(title, command, expectation, run, passed, extra = \"\") {\n    76\t  legs.push({ title, command, expectation, code: run.code, out: run.out, passed, extra });\n    77\t  const mark = passed ? \"OK  \" : \"FAIL\";\n    78\t  console.log(`\\n[${mark}] ${title} — exit ${run.code} (expected: ${expectation})`);\n    79\t  if (extra) console.log(`       ${extra}`);\n    80\t}\n    81\t\n    82\tlet ok = true;\n    83\tconst manifestExisted = existsSync(at(MANIFEST));\n    84\tconst manifestBackup = manifestExisted ? readFileSync(at(MANIFEST)) : null;\n    85\t\n    86\tfunction restoreManifest() {\n    87\t  if (manifestExisted) writeFileSync(at(MANIFEST), manifestBackup);\n    88\t  else rmSync(at(MANIFEST), { force: true });\n    89\t}\n    90\t\n    91\ttry {\n    92\t  // Baseline — clean verify must pass (confirms the typecheck fix landed clean).\n    93\t  const base = runScript(\"verify\");\n    94\t  const basePass = base.code === 0;\n    95\t  ok = ok && basePass;\n    96\t  record(\"Baseline: clean `pnpm run verify`\", \"pnpm run verify\", \"exit 0\", base, basePass);\n    97\t\n    98\t  // Proof 1 — a failing test fails verify.\n    99\t  writeFileSync(at(FAILING), FAILING_SRC);\n   100\t  const p1 = runScript(\"verify\");\n   101\t  const p1Pass = p1.code !== 0;\n   102\t  ok = ok && p1Pass;\n   103\t  record(\n   104\t    \"Proof 1: sacrificial failing test fails `pnpm run verify`\",\n   105\t    \"pnpm run verify  (with test/_fc07-failing.test.ts present)\",\n   106\t    \"non-zero exit\",\n   107\t    p1,\n   108\t    p1Pass,\n   109\t  );\n   110\t  rmSync(at(FAILING), { force: true });\n   111\t\n   112\t  // Proof 2 — edited Red-manifest file fails green-verify, verify itself green.\n   113\t  writeFileSync(at(RED), RED_SRC);\n   114\t  execFileSync(\"node\", [\"scripts/record-red-manifest.mjs\", RED], {\n   115\t    cwd: pkgRoot,\n   116\t    encoding: \"utf8\",\n   117\t  });\n   118\t\n   119\t  const p2a = runScript(\"green-verify\");\n   120\t  const p2aPass = p2a.code === 0;\n   121\t  ok = ok && p2aPass;\n   122\t  record(\n   123\t    \"Proof 2a: unchanged Red file passes `pnpm run green-verify`\",\n   124\t    \"pnpm run green-verify  (Red file matches manifest)\",\n   125\t    \"exit 0 (gate is discriminating)\",\n   126\t    p2a,\n   127\t    p2aPass,\n   128\t  );\n   129\t\n   130\t  writeFileSync(at(RED), RED_SRC + RED_EDIT);\n   131\t  const p2b = runScript(\"green-verify\");\n   132\t  const immutabilityTripped = /test-immutability FAILED/.test(p2b.out);\n   133\t  const p2bPass = p2b.code !== 0 && immutabilityTripped;\n   134\t  ok = ok && p2bPass;\n   135\t  record(\n   136\t    \"Proof 2b: edited Red file fails `pnpm run green-verify`\",\n   137\t    \"pnpm run green-verify  (Red file edited after manifest)\",\n   138\t    \"non-zero exit at check-test-immutability\",\n   139\t    p2b,\n   140\t    p2bPass,\n","exit_code":0,"status":"completed"}}

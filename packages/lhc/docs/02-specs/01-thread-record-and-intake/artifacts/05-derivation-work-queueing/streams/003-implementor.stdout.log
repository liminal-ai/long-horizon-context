{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011nhXNqBc6Yok7gzeNWsqy1","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport type { OperationContext } from \"../../shared/context.js\";\n3\timport {\n4\t  notImplemented,\n5\t  storageFailure,\n6\t  type ErrorResult,\n7\t  type OpResult,\n8\t} from \"../../shared/errors.js\";\n9\timport type { WorkItemRecord } from \"../../tech-utils/work-queue/index.js\";\n10\timport type { EventKind } from \"../intake-stream/index.js\";\n11\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n12\timport { transition } from \"./internal/state-machine.js\";\n13\t\n14\t// The pure rule table, re-exported for the golden supplemental suite (the\n15\t// test plan's one sanctioned direct entry besides the tokenizer); production\n16\t// callers go through applyEvent.\n17\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n18\timport {\n19\t  closeTurn,\n20\t  insertOpenTurn,\n21\t  nextTurnOrder,\n22\t  readTurns,\n23\t  selectOpenTurnIds,\n24\t} from \"./internal/store.js\";\n25\t\n26\texport interface TurnRecord {\n27\t  turnId: string;\n28\t  status: \"open\" | \"closed\";\n29\t  memberMessageIds: string[];\n30\t  openedAtEventOrder: number;\n31\t  closedAtEventOrder?: number;\n32\t}\n33\t\n34\texport interface TurnTransitionOutcome {\n35\t  // Transitions in occurrence order: a close_then_open reports the close\n36\t  // first, then the open, exactly as the batch result surfaces them.\n37\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n38\t  // Turn state after the transition — the stamp for this event's message.\n39\t  // Prompts see the turn they just opened (transition first, then stamp);\n40\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n41\t  openTurnId: string | null;\n42\t}\n43\t\n44\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n45\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n46\t// writes turn state, so more than one open turn means external interference.\n47\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n48\t  return selectOpenTurnIds(ctx.db);\n49\t}\n50\t\n51\t// Cross-domain surface, called by intake-stream inside the batch transaction\n52\t// for every recorded event. Synchronous and throwing by design, like\n53\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n54\t// Closing a turn queues nothing here — Story 5 adds the turn_derivation work\n55\t// item to this already-working close path inside the same transaction.\n56\texport function applyEvent(\n57\t  ctx: OperationContext,\n58\t  eventKind: EventKind,\n59\t  eventOrder: number,\n60\t): TurnTransitionOutcome {\n61\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n62\t  const effect = transition({ openTurnId }, eventKind);\n63\t  switch (effect.kind) {\n64\t    case \"none\":\n65\t      return { transitions: [], openTurnId };\n66\t    case \"open\": {\n67\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n68\t      return { transitions: [{ action: \"opened\", turnId }], openTurnId: turnId };\n69\t    }\n70\t    case \"close\": {\n71\t      closeTurn(ctx.db, openTurnId as string, eventOrder);\n72\t      return {\n73\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n74\t        openTurnId: null,\n75\t      };\n76\t    }\n77\t    case \"close_then_open\": {\n78\t      closeTurn(ctx.db, openTurnId as string, eventOrder);\n79\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n80\t      return {\n81\t        transitions: [\n82\t          { action: \"closed\", turnId: openTurnId as string },\n83\t          { action: \"opened\", turnId },\n84\t        ],\n85\t        openTurnId: turnId,\n86\t      };\n87\t    }\n88\t  }\n89\t}\n90\t\n91\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n92\t  return {\n93\t    ok: false,\n94\t    error: {\n95\t      errorClass: \"caller_error\",\n96\t      code: \"thread_not_found\",\n97\t      reason: `no thread file exists at ${filePath}`,\n98\t    },\n99\t  };\n100\t}\n101\t\n102\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n103\t  const resolved = await resolveThreadRef(thread);\n104\t  if (!resolved.ok) return resolved;\n105\t  const { filePath } = resolved.value;\n106\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n107\t\n108\t  const opened = openThreadDatabase(filePath);\n109\t  if (!opened.ok) return opened;\n110\t  const db = opened.value;\n111\t  try {\n112\t    return { ok: true, value: readTurns(db) };\n113\t  } catch (cause) {\n114\t    const reason = cause instanceof Error ? cause.message : String(cause);\n115\t    return storageFailure(`turn read-back failed: ${reason}`);\n116\t  } finally {\n117\t    db.close();\n118\t  }\n119\t}\n120\t\n121\texport async function listQueuedWork(\n122\t  _thread: ThreadRef,\n123\t): Promise<OpResult<WorkItemRecord[]>> {\n124\t  return notImplemented(\"turns.list-queued-work\");\n125\t}\n126\t"}]},"parent_tool_use_id":null,"session_id":"7ab0ad27-af7b-46f6-9ce5-aa43cce928f8","uuid":"35d3d31e-a659-4556-8e38-5760d61a0dd2","timestamp":"2026-06-10T14:50:57.450Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/index.ts","content":"import { existsSync } from \"node:fs\";\nimport type { OperationContext } from \"../../shared/context.js\";\nimport {\n  notImplemented,\n  storageFailure,\n  type ErrorResult,\n  type OpResult,\n} from \"../../shared/errors.js\";\nimport type { WorkItemRecord } from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind } from \"../intake-stream/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\nimport { transition } from \"./internal/state-machine.js\";\n\n// The pure rule table, re-exported for the golden supplemental suite (the\n// test plan's one sanctioned direct entry besides the tokenizer); production\n// callers go through applyEvent.\nexport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\nimport {\n  closeTurn,\n  insertOpenTurn,\n  nextTurnOrder,\n  readTurns,\n  selectOpenTurnIds,\n} from \"./internal/store.js\";\n\nexport interface TurnRecord {\n  turnId: string;\n  status: \"open\" | \"closed\";\n  memberMessageIds: string[];\n  openedAtEventOrder: number;\n  closedAtEventOrder?: number;\n}\n\nexport interface TurnTransitionOutcome {\n  // Transitions in occurrence order: a close_then_open reports the close\n  // first, then the open, exactly as the batch result surfaces them.\n  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n  // Turn state after the transition — the stamp for this event's message.\n  // Prompts see the turn they just opened (transition first, then stamp);\n  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n  openTurnId: string | null;\n}\n\n// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n// IMMEDIATE and before any event is processed. Only the batch pipeline\n// writes turn state, so more than one open turn means external interference.\nexport function listOpenTurnIds(ctx: OperationContext): string[] {\n  return selectOpenTurnIds(ctx.db);\n}\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// for every recorded event. Synchronous and throwing by design, like\n// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n// Closing a turn queues nothing here — Story 5 adds the turn_derivation work\n// item to this already-working close path inside the same transaction.\nexport function applyEvent(\n  ctx: OperationContext,\n  eventKind: EventKind,\n  eventOrder: number,\n): TurnTransitionOutcome {\n  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n  const effect = transition({ openTurnId }, eventKind);\n  switch (effect.kind) {\n    case \"none\":\n      return { transitions: [], openTurnId };\n    case \"open\": {\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return { transitions: [{ action: \"opened\", turnId }], openTurnId: turnId };\n    }\n    case \"close\": {\n      closeTurn(ctx.db, openTurnId as string, eventOrder);\n      return {\n        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n        openTurnId: null,\n      };\n    }\n    case \"close_then_open\": {\n      closeTurn(ctx.db, openTurnId as string, eventOrder);\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [\n          { action: \"closed\", turnId: openTurnId as string },\n          { action: \"opened\", turnId },\n        ],\n        openTurnId: turnId,\n      };\n    }\n  }\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: readTurns(db) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`turn read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  _thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  return notImplemented(\"turns.list-queued-work\");\n}\n","numLines":126,"startLine":1,"totalLines":126}}}

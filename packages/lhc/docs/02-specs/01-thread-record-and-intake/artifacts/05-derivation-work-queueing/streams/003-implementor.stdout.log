{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J5z533Uc5xWsEGpUYCzyh5","type":"tool_result","content":"1\t// CLI process-boundary suite for turns: the production-path proof for\n2\t// `lhc turns list` — a real conversation goes in through real stdin and the\n3\t// turn records come back as JSON through the spawned binary, with membership\n4\t// and boundary orders intact. Runs under verify-all only.\n5\timport { spawnSync } from \"node:child_process\";\n6\timport { mkdtempSync, rmSync } from \"node:fs\";\n7\timport { tmpdir } from \"node:os\";\n8\timport path from \"node:path\";\n9\timport { fileURLToPath } from \"node:url\";\n10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n11\timport type { TurnRecord } from \"../src/index.js\";\n12\timport { validEvent } from \"./fixtures/index.js\";\n13\t\n14\tconst cliPath = path.resolve(\n15\t  path.dirname(fileURLToPath(import.meta.url)),\n16\t  \"../dist/cli.js\",\n17\t);\n18\t\n19\tfunction runBinary(\n20\t  args: string[],\n21\t  input?: string,\n22\t): { status: number | null; stdout: string; stderr: string } {\n23\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n24\t    encoding: \"utf8\",\n25\t    ...(input === undefined ? {} : { input }),\n26\t  });\n27\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n28\t}\n29\t\n30\tlet dir: string;\n31\tlet threadPath: string;\n32\tbeforeEach(() => {\n33\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-turns-\"));\n34\t  threadPath = path.join(dir, \"thread.sqlite\");\n35\t  const created = runBinary([\n36\t    \"threads\",\n37\t    \"new-thread\",\n38\t    \"--file-path\",\n39\t    threadPath,\n40\t    \"--registry\",\n41\t    path.join(dir, \"registry.sqlite\"),\n42\t  ]);\n43\t  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n44\t});\n45\tafterEach(() => {\n46\t  rmSync(dir, { recursive: true, force: true });\n47\t});\n48\t\n49\tdescribe(\"Story 4 (process boundary): turns list through the spawned binary\", () => {\n50\t  it(\"a closed and an open turn read back with full shape via turns list\", () => {\n51\t    const batch = [\n52\t      validEvent(\"user_prompt\"),\n53\t      validEvent(\"assistant_text\"),\n54\t      validEvent(\"turn_end\"),\n55\t      validEvent(\"user_prompt\"),\n56\t    ];\n57\t    const recorded = runBinary(\n58\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n59\t      JSON.stringify(batch),\n60\t    );\n61\t    expect(recorded.status).toBe(0);\n62\t    const batchResult = JSON.parse(recorded.stdout) as {\n63\t      ok: boolean;\n64\t      value: { turnTransitions: Array<{ action: string; turnId: string }> };\n65\t    };\n66\t    expect(batchResult.ok).toBe(true);\n67\t    expect(batchResult.value.turnTransitions).toEqual([\n68\t      { action: \"opened\", turnId: \"t1\" },\n69\t      { action: \"closed\", turnId: \"t1\" },\n70\t      { action: \"opened\", turnId: \"t2\" },\n71\t    ]);\n72\t\n73\t    const listed = runBinary([\"turns\", \"list\", \"--file-path\", threadPath]);\n74\t    expect(listed.status).toBe(0);\n75\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; value: TurnRecord[] };\n76\t    expect(parsed.ok).toBe(true);\n77\t    expect(parsed.value).toEqual([\n78\t      {\n79\t        turnId: \"t1\",\n80\t        status: \"closed\",\n81\t        memberMessageIds: [\"m1\", \"m2\"],\n82\t        openedAtEventOrder: 1,\n83\t        closedAtEventOrder: 3,\n84\t      },\n85\t      {\n86\t        turnId: \"t2\",\n87\t        status: \"open\",\n88\t        memberMessageIds: [\"m4\"],\n89\t        openedAtEventOrder: 4,\n90\t      },\n91\t    ]);\n92\t  });\n93\t});\n94\t"}]},"parent_tool_use_id":null,"session_id":"7ab0ad27-af7b-46f6-9ce5-aa43cce928f8","uuid":"0bab0c3a-4b82-4c7f-b87b-0da36305e52f","timestamp":"2026-06-10T14:52:28.486Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-turns.test.ts","content":"// CLI process-boundary suite for turns: the production-path proof for\n// `lhc turns list` — a real conversation goes in through real stdin and the\n// turn records come back as JSON through the spawned binary, with membership\n// and boundary orders intact. Runs under verify-all only.\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport type { TurnRecord } from \"../src/index.js\";\nimport { validEvent } from \"./fixtures/index.js\";\n\nconst cliPath = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  \"../dist/cli.js\",\n);\n\nfunction runBinary(\n  args: string[],\n  input?: string,\n): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    ...(input === undefined ? {} : { input }),\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nlet threadPath: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-turns-\"));\n  threadPath = path.join(dir, \"thread.sqlite\");\n  const created = runBinary([\n    \"threads\",\n    \"new-thread\",\n    \"--file-path\",\n    threadPath,\n    \"--registry\",\n    path.join(dir, \"registry.sqlite\"),\n  ]);\n  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\ndescribe(\"Story 4 (process boundary): turns list through the spawned binary\", () => {\n  it(\"a closed and an open turn read back with full shape via turns list\", () => {\n    const batch = [\n      validEvent(\"user_prompt\"),\n      validEvent(\"assistant_text\"),\n      validEvent(\"turn_end\"),\n      validEvent(\"user_prompt\"),\n    ];\n    const recorded = runBinary(\n      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n      JSON.stringify(batch),\n    );\n    expect(recorded.status).toBe(0);\n    const batchResult = JSON.parse(recorded.stdout) as {\n      ok: boolean;\n      value: { turnTransitions: Array<{ action: string; turnId: string }> };\n    };\n    expect(batchResult.ok).toBe(true);\n    expect(batchResult.value.turnTransitions).toEqual([\n      { action: \"opened\", turnId: \"t1\" },\n      { action: \"closed\", turnId: \"t1\" },\n      { action: \"opened\", turnId: \"t2\" },\n    ]);\n\n    const listed = runBinary([\"turns\", \"list\", \"--file-path\", threadPath]);\n    expect(listed.status).toBe(0);\n    const parsed = JSON.parse(listed.stdout) as { ok: boolean; value: TurnRecord[] };\n    expect(parsed.ok).toBe(true);\n    expect(parsed.value).toEqual([\n      {\n        turnId: \"t1\",\n        status: \"closed\",\n        memberMessageIds: [\"m1\", \"m2\"],\n        openedAtEventOrder: 1,\n        closedAtEventOrder: 3,\n      },\n      {\n        turnId: \"t2\",\n        status: \"open\",\n        memberMessageIds: [\"m4\"],\n        openedAtEventOrder: 4,\n      },\n    ]);\n  });\n});\n","numLines":94,"startLine":1,"totalLines":94}}}

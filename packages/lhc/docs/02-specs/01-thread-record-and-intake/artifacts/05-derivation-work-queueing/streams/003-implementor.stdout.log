{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SSUMzYTZN7i8Fye5r9NDAY","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport type { DatabaseSync } from \"node:sqlite\";\n3\timport type { OperationContext } from \"../../shared/context.js\";\n4\timport {\n5\t  notImplemented,\n6\t  storageFailure,\n7\t  type ErrorResult,\n8\t  type OpResult,\n9\t} from \"../../shared/errors.js\";\n10\timport type { WorkItemRecord } from \"../../tech-utils/work-queue/index.js\";\n11\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n12\timport {\n13\t  openThreadDatabase,\n14\t  resolveThreadRef,\n15\t  type ThreadRef,\n16\t} from \"../threads/index.js\";\n17\timport { projectEvent } from \"./internal/project.js\";\n18\timport { insertMessage, readMessages } from \"./internal/store.js\";\n19\t\n20\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n21\t\n22\texport interface Block {\n23\t  blockType: BlockType;\n24\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n25\t}\n26\t\n27\texport interface MessageRecord {\n28\t  messageId: string;\n29\t  sourceEventOrder: number;\n30\t  kind: Exclude<EventKind, \"turn_end\">;\n31\t  blocks: Block[];\n32\t  tokenEstimate: number;\n33\t  actor: string;\n34\t  harness: string;\n35\t  turnId?: string;\n36\t}\n37\t\n38\t// The event as the walk holds it after recording: the validated input plus\n39\t// its server-stamped order and timestamp.\n40\texport type RecordedEvent = EventRecord;\n41\t\n42\texport type MessageCreated = {\n43\t  messageId: string;\n44\t  kind: Exclude<EventKind, \"turn_end\">;\n45\t} | null;\n46\t\n47\t// Cross-domain surface, called by intake-stream inside the batch transaction\n48\t// (the first such call through the operation context; turns.applyEvent\n49\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n50\t// projection failure propagates to the pipeline's catch and rejects the\n51\t// whole batch — recorded events without messages is the stranded state the\n52\t// transaction exists to prevent. Returns null for turn_end (no message).\n53\t// turnId is the membership stamp, settled by the pipeline before this call:\n54\t// the turn open *after* this event's transition (so a prompt belongs to the\n55\t// turn it just opened), or null in a gap — written once, never updated.\n56\texport function createFromEvent(\n57\t  ctx: OperationContext,\n58\t  event: RecordedEvent,\n59\t  turnId: string | null,\n60\t): MessageCreated {\n61\t  const projected = projectEvent(event);\n62\t  if (projected === null) return null;\n63\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n64\t  const messageId = `m${event.eventOrder}`;\n65\t  insertMessage(ctx.db, {\n66\t    messageId,\n67\t    sourceEventOrder: event.eventOrder,\n68\t    kind,\n69\t    tokenEstimate: projected.tokenEstimate,\n70\t    actor: event.actor,\n71\t    harness: event.harness,\n72\t    turnId,\n73\t    blocks: projected.blocks,\n74\t  });\n75\t  return { messageId, kind };\n76\t}\n77\t\n78\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n79\t  return {\n80\t    ok: false,\n81\t    error: {\n82\t      errorClass: \"caller_error\",\n83\t      code: \"thread_not_found\",\n84\t      reason: `no thread file exists at ${filePath}`,\n85\t    },\n86\t  };\n87\t}\n88\t\n89\texport async function listMessages(\n90\t  thread: ThreadRef,\n91\t): Promise<OpResult<MessageRecord[]>> {\n92\t  const resolved = await resolveThreadRef(thread);\n93\t  if (!resolved.ok) return resolved;\n94\t  const { filePath } = resolved.value;\n95\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n96\t\n97\t  // openThreadDatabase verifies the file is a real thread file and migrates\n98\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n99\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n100\t  // unmutated (F-03-002).\n101\t  const opened = openThreadDatabase(filePath);\n102\t  if (!opened.ok) return opened;\n103\t  const db = opened.value;\n104\t  try {\n105\t    return { ok: true, value: readMessages(db) };\n106\t  } catch (cause) {\n107\t    const reason = cause instanceof Error ? cause.message : String(cause);\n108\t    return storageFailure(`message read-back failed: ${reason}`);\n109\t  } finally {\n110\t    db.close();\n111\t  }\n112\t}\n113\t\n114\texport async function listQueuedWork(\n115\t  _thread: ThreadRef,\n116\t): Promise<OpResult<WorkItemRecord[]>> {\n117\t  return notImplemented(\"messages.list-queued-work\");\n118\t}\n119\t"}]},"parent_tool_use_id":null,"session_id":"7ab0ad27-af7b-46f6-9ce5-aa43cce928f8","uuid":"396759fd-9d94-41b5-ae72-14b289565d83","timestamp":"2026-06-10T14:51:01.752Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"import { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../shared/context.js\";\nimport {\n  notImplemented,\n  storageFailure,\n  type ErrorResult,\n  type OpResult,\n} from \"../../shared/errors.js\";\nimport type { WorkItemRecord } from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport { projectEvent } from \"./internal/project.js\";\nimport { insertMessage, readMessages } from \"./internal/store.js\";\n\nexport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n\nexport interface Block {\n  blockType: BlockType;\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n}\n\nexport interface MessageRecord {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: Exclude<EventKind, \"turn_end\">;\n  blocks: Block[];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  turnId?: string;\n}\n\n// The event as the walk holds it after recording: the validated input plus\n// its server-stamped order and timestamp.\nexport type RecordedEvent = EventRecord;\n\nexport type MessageCreated = {\n  messageId: string;\n  kind: Exclude<EventKind, \"turn_end\">;\n} | null;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// (the first such call through the operation context; turns.applyEvent\n// follows the pattern in Story 4). Synchronous and throwing by design: a\n// projection failure propagates to the pipeline's catch and rejects the\n// whole batch — recorded events without messages is the stranded state the\n// transaction exists to prevent. Returns null for turn_end (no message).\n// turnId is the membership stamp, settled by the pipeline before this call:\n// the turn open *after* this event's transition (so a prompt belongs to the\n// turn it just opened), or null in a gap — written once, never updated.\nexport function createFromEvent(\n  ctx: OperationContext,\n  event: RecordedEvent,\n  turnId: string | null,\n): MessageCreated {\n  const projected = projectEvent(event);\n  if (projected === null) return null;\n  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n  const messageId = `m${event.eventOrder}`;\n  insertMessage(ctx.db, {\n    messageId,\n    sourceEventOrder: event.eventOrder,\n    kind,\n    tokenEstimate: projected.tokenEstimate,\n    actor: event.actor,\n    harness: event.harness,\n    turnId,\n    blocks: projected.blocks,\n  });\n  return { messageId, kind };\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listMessages(\n  thread: ThreadRef,\n): Promise<OpResult<MessageRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file and migrates\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\n  // unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: readMessages(db) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`message read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  _thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  return notImplemented(\"messages.list-queued-work\");\n}\n","numLines":119,"startLine":1,"totalLines":119}}}

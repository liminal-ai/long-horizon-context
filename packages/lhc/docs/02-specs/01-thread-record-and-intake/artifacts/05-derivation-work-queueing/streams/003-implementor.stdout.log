{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KkP39d3Qb59Av32Un8zax5","type":"tool_result","content":"1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4\t// Stories 3–5 extend the same per-event walk with projection, turn\n5\t// transitions, and work queueing.\n6\timport { existsSync } from \"node:fs\";\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport type { OperationContext } from \"../../../shared/context.js\";\n9\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n10\timport { createFromEvent } from \"../../messages/index.js\";\n11\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n12\timport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\n13\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n14\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n15\t\n16\t// Test seam (set only through test/fixtures): called after each event is\n17\t// processed inside the walk, so atomicity under mid-walk failure can be\n18\t// induced through a real mechanism — closing the handle — rather than a\n19\t// mocked transaction object.\n20\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n21\tlet walkHook: IntakeWalkHook | null = null;\n22\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n23\t  walkHook = hook;\n24\t}\n25\t\n26\t// Test seam (set only through test/fixtures): replaces the wall clock so\n27\t// recordedAt is sourced deterministically for the public SDK contract proof —\n28\t// TC-1.4 records the same batch through both reference forms and reads it back\n29\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n30\t// production: recording stamps real wall time. An explicit clock argument to\n31\t// runMessageEvents still wins over the seam.\n32\tlet injectedClock: (() => Date) | null = null;\n33\texport function setIntakeClock(clock: (() => Date) | null): void {\n34\t  injectedClock = clock;\n35\t}\n36\t\n37\tfunction detail(cause: unknown): string {\n38\t  return cause instanceof Error ? cause.message : String(cause);\n39\t}\n40\t\n41\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n42\t  return {\n43\t    ok: false,\n44\t    error: {\n45\t      errorClass: \"caller_error\",\n46\t      code: \"thread_not_found\",\n47\t      reason: `no thread file exists at ${filePath}`,\n48\t    },\n49\t  };\n50\t}\n51\t\n52\t// The skip set is read at transaction start and reads only the key column:\n53\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n54\t// Chunked to stay under SQLite's bound-parameter limit.\n55\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n56\t  const found = new Set<string>();\n57\t  for (let offset = 0; offset < keys.length; offset += 400) {\n58\t    const chunk = keys.slice(offset, offset + 400);\n59\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n60\t    const rows = db\n61\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n62\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n63\t    for (const row of rows) found.add(row.idempotency_key);\n64\t  }\n65\t  return found;\n66\t}\n67\t\n68\tfunction threadIdOf(db: DatabaseSync): string {\n69\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n70\t    | { thread_id: string }\n71\t    | undefined;\n72\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n73\t  return row.thread_id;\n74\t}\n75\t\n76\tfunction maxEventOrder(db: DatabaseSync): number {\n77\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n78\t    | { max_order: number | bigint | null }\n79\t    | undefined;\n80\t  return Number(row?.max_order ?? 0);\n81\t}\n82\t\n83\texport async function runMessageEvents(\n84\t  thread: ThreadRef,\n85\t  events: readonly MessageEventInput[],\n86\t  clock: () => Date = injectedClock ?? (() => new Date()),\n87\t): Promise<OpResult<BatchResult>> {\n88\t  // Pure validation first: a rejected batch never opens the file, never takes\n89\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n90\t  // not a skip (validation-before-idempotency precedence).\n91\t  const refFailure = validateThreadRef(thread);\n92\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n93\t  const batchFailure = validateEvents(events);\n94\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n95\t\n96\t  const resolved = await resolveThreadRef(thread);\n97\t  if (!resolved.ok) return resolved;\n98\t  const { filePath } = resolved.value;\n99\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n100\t\n101\t  // openThreadDatabase verifies the file is a real thread file, then brings\n102\t  // its schema to the current version before the batch transaction begins,\n103\t  // so a thread recorded under an earlier story is writable here (F-03-001)\n104\t  // and a non-thread file is rejected unmutated (F-03-002).\n105\t  const opened = openThreadDatabase(filePath);\n106\t  if (!opened.ok) return opened;\n107\t  const db = opened.value;\n108\t\n109\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n110\t  // single-writer violations fail loudly at a defined point.\n111\t  let inTransaction = false;\n112\t  try {\n113\t    db.exec(\"BEGIN IMMEDIATE;\");\n114\t    inTransaction = true;\n115\t\n116\t    // Cross-domain calls inside the transaction share the open handle through\n117\t    // the operation context (design decision 8); built once per batch, never\n118\t    // stored.\n119\t    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n120\t\n121\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n122\t    // any event is processed — once is sufficient because only this pipeline\n123\t    // writes turn state and the write lock is already held, so more than one\n124\t    // open turn can only mean external interference. The batch records\n125\t    // nothing: nothing has been written yet, and the rollback closes the\n126\t    // never-used transaction.\n127\t    const openTurnIds = listOpenTurnIds(ctx);\n128\t    if (openTurnIds.length > 1) {\n129\t      db.exec(\"ROLLBACK;\");\n130\t      inTransaction = false;\n131\t      return {\n132\t        ok: false,\n133\t        error: {\n134\t          errorClass: \"state_corruption\",\n135\t          code: \"turn_state_corrupt\",\n136\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n137\t        },\n138\t      };\n139\t    }\n140\t\n141\t    const skipSet = recordedKeys(\n142\t      db,\n143\t      events.map((event) => event.idempotencyKey),\n144\t    );\n145\t    // Order counter from MAX(event_order): only recorded events increment it,\n146\t    // so skips consume no order numbers and the sequence stays dense.\n147\t    let lastOrder = maxEventOrder(db);\n148\t\n149\t    const insert = db.prepare(\n150\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n151\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n152\t    );\n153\t\n154\t    const eventResults: BatchResult[\"events\"] = [];\n155\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n156\t    for (const [index, event] of events.entries()) {\n157\t      if (skipSet.has(event.idempotencyKey)) {\n158\t        eventResults.push({\n159\t          idempotencyKey: event.idempotencyKey,\n160\t          outcome: \"skipped\",\n161\t          skipReason: \"duplicate_idempotency_key\",\n162\t        });\n163\t      } else {\n164\t        lastOrder += 1;\n165\t        const recordedAt = clock().toISOString();\n166\t        insert.run(\n167\t          lastOrder,\n168\t          event.eventKind,\n169\t          event.idempotencyKey,\n170\t          event.actor,\n171\t          event.harness,\n172\t          JSON.stringify(event.payload),\n173\t          recordedAt,\n174\t        );\n175\t        skipSet.add(event.idempotencyKey);\n176\t        // Turn transition before projection — the order is load-bearing: a\n177\t        // prompt transitions first and stamps to the turn it just opened\n178\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n179\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n180\t        // call, so a resend causes no transition (TC-5.4).\n181\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n182\t        turnTransitions.push(...turnOutcome.transitions);\n183\t        // Projection runs in the same iteration that recorded the event, so\n184\t        // it can never drift from its source; a projection failure throws\n185\t        // and rejects the whole batch. Skipped events never reach this call\n186\t        // (no duplicate message, AC-5.4).\n187\t        const created = createFromEvent(\n188\t          ctx,\n189\t          {\n190\t            ...event,\n191\t            eventOrder: lastOrder,\n192\t            recordedAt,\n193\t          },\n194\t          turnOutcome.openTurnId,\n195\t        );\n196\t        const entry: BatchResult[\"events\"][number] = {\n197\t          idempotencyKey: event.idempotencyKey,\n198\t          outcome: \"recorded\",\n199\t        };\n200\t        if (created !== null) entry.messageId = created.messageId;\n201\t        eventResults.push(entry);\n202\t      }\n203\t      walkHook?.(db, index);\n204\t    }\n205\t\n206\t    db.exec(\"COMMIT;\");\n207\t    inTransaction = false;\n208\t\n209\t    return {\n210\t      ok: true,\n211\t      value: {\n212\t        events: eventResults,\n213\t        turnTransitions,\n214\t        queuedWork: [], // populated by Story 5\n215\t        threadPosition: { lastEventOrder: lastOrder },\n216\t      },\n217\t    };\n218\t  } catch (cause) {\n219\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n220\t    // class-independent. The handle may already be gone (induced failure),\n221\t    // in which case SQLite has already discarded the uncommitted transaction.\n222\t    if (inTransaction) {\n223\t      try {\n224\t        db.exec(\"ROLLBACK;\");\n225\t      } catch {\n226\t        // handle closed mid-walk; the open transaction died with it\n227\t      }\n228\t    }\n229\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n230\t  } finally {\n231\t    try {\n232\t      db.close();\n233\t    } catch {\n234\t      // already closed by the induced-failure seam\n235\t    }\n236\t  }\n237\t}\n238\t\n239\tinterface RawEventRow {\n240\t  event_order: number | bigint;\n241\t  event_kind: string;\n242\t  idempotency_key: string;\n243\t  actor: string;\n244\t  harness: string;\n245\t  payload: string;\n246\t  recorded_at: string;\n247\t}\n248\t\n249\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n250\t  const refFailure = validateThreadRef(thread);\n251\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n252\t\n253\t  const resolved = await resolveThreadRef(thread);\n254\t  if (!resolved.ok) return resolved;\n255\t  const { filePath } = resolved.value;\n256\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n257\t\n258\t  const opened = openThreadDatabase(filePath);\n259\t  if (!opened.ok) return opened;\n260\t  const db = opened.value;\n261\t  try {\n262\t    const rows = db\n263\t      .prepare(\n264\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n265\t         FROM event ORDER BY event_order`,\n266\t      )\n267\t      .all() as unknown as RawEventRow[];\n268\t    const records = rows.map(\n269\t      (row) =>\n270\t        ({\n271\t          eventKind: row.event_kind,\n272\t          idempotencyKey: row.idempotency_key,\n273\t          actor: row.actor,\n274\t          harness: row.harness,\n275\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n276\t          eventOrder: Number(row.event_order),\n277\t          recordedAt: row.recorded_at,\n278\t        }) as unknown as EventRecord,\n279\t    );\n280\t    return { ok: true, value: records };\n281\t  } catch (cause) {\n282\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n283\t  } finally {\n284\t    db.close();\n285\t  }\n286\t}\n287\t"}]},"parent_tool_use_id":null,"session_id":"7ab0ad27-af7b-46f6-9ce5-aa43cce928f8","uuid":"d73b1973-25b0-47b1-bf3a-0c7dae529961","timestamp":"2026-06-10T14:50:47.919Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n// Stories 3–5 extend the same per-event walk with projection, turn\n// transitions, and work queueing.\nimport { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport { createFromEvent } from \"../../messages/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\nimport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\nimport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\nimport { validateEvents, validateThreadRef } from \"./validate.js\";\n\n// Test seam (set only through test/fixtures): called after each event is\n// processed inside the walk, so atomicity under mid-walk failure can be\n// induced through a real mechanism — closing the handle — rather than a\n// mocked transaction object.\nexport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\nlet walkHook: IntakeWalkHook | null = null;\nexport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n  walkHook = hook;\n}\n\n// Test seam (set only through test/fixtures): replaces the wall clock so\n// recordedAt is sourced deterministically for the public SDK contract proof —\n// TC-1.4 records the same batch through both reference forms and reads it back\n// field-for-field, recordedAt included, with nothing stripped. Unset in\n// production: recording stamps real wall time. An explicit clock argument to\n// runMessageEvents still wins over the seam.\nlet injectedClock: (() => Date) | null = null;\nexport function setIntakeClock(clock: (() => Date) | null): void {\n  injectedClock = clock;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The skip set is read at transaction start and reads only the key column:\n// key-wins-over-content is the absence of a content comparison (AC-5.5).\n// Chunked to stay under SQLite's bound-parameter limit.\nfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n  const found = new Set<string>();\n  for (let offset = 0; offset < keys.length; offset += 400) {\n    const chunk = keys.slice(offset, offset + 400);\n    const placeholders = chunk.map(() => \"?\").join(\", \");\n    const rows = db\n      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    for (const row of rows) found.add(row.idempotency_key);\n  }\n  return found;\n}\n\nfunction threadIdOf(db: DatabaseSync): string {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n  return row.thread_id;\n}\n\nfunction maxEventOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0);\n}\n\nexport async function runMessageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n  clock: () => Date = injectedClock ?? (() => new Date()),\n): Promise<OpResult<BatchResult>> {\n  // Pure validation first: a rejected batch never opens the file, never takes\n  // the write lock, and a duplicate key on a malformed event is a rejection,\n  // not a skip (validation-before-idempotency precedence).\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n  const batchFailure = validateEvents(events);\n  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file, then brings\n  // its schema to the current version before the batch transaction begins,\n  // so a thread recorded under an earlier story is writable here (F-03-001)\n  // and a non-thread file is rejected unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n\n  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n  // single-writer violations fail loudly at a defined point.\n  let inTransaction = false;\n  try {\n    db.exec(\"BEGIN IMMEDIATE;\");\n    inTransaction = true;\n\n    // Cross-domain calls inside the transaction share the open handle through\n    // the operation context (design decision 8); built once per batch, never\n    // stored.\n    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n\n    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n    // any event is processed — once is sufficient because only this pipeline\n    // writes turn state and the write lock is already held, so more than one\n    // open turn can only mean external interference. The batch records\n    // nothing: nothing has been written yet, and the rollback closes the\n    // never-used transaction.\n    const openTurnIds = listOpenTurnIds(ctx);\n    if (openTurnIds.length > 1) {\n      db.exec(\"ROLLBACK;\");\n      inTransaction = false;\n      return {\n        ok: false,\n        error: {\n          errorClass: \"state_corruption\",\n          code: \"turn_state_corrupt\",\n          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n        },\n      };\n    }\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    const eventResults: BatchResult[\"events\"] = [];\n    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        const recordedAt = clock().toISOString();\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          recordedAt,\n        );\n        skipSet.add(event.idempotencyKey);\n        // Turn transition before projection — the order is load-bearing: a\n        // prompt transitions first and stamps to the turn it just opened\n        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n        // call, so a resend causes no transition (TC-5.4).\n        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n        turnTransitions.push(...turnOutcome.transitions);\n        // Projection runs in the same iteration that recorded the event, so\n        // it can never drift from its source; a projection failure throws\n        // and rejects the whole batch. Skipped events never reach this call\n        // (no duplicate message, AC-5.4).\n        const created = createFromEvent(\n          ctx,\n          {\n            ...event,\n            eventOrder: lastOrder,\n            recordedAt,\n          },\n          turnOutcome.openTurnId,\n        );\n        const entry: BatchResult[\"events\"][number] = {\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"recorded\",\n        };\n        if (created !== null) entry.messageId = created.messageId;\n        eventResults.push(entry);\n      }\n      walkHook?.(db, index);\n    }\n\n    db.exec(\"COMMIT;\");\n    inTransaction = false;\n\n    return {\n      ok: true,\n      value: {\n        events: eventResults,\n        turnTransitions,\n        queuedWork: [], // populated by Story 5\n        threadPosition: { lastEventOrder: lastOrder },\n      },\n    };\n  } catch (cause) {\n    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n    // class-independent. The handle may already be gone (induced failure),\n    // in which case SQLite has already discarded the uncommitted transaction.\n    if (inTransaction) {\n      try {\n        db.exec(\"ROLLBACK;\");\n      } catch {\n        // handle closed mid-walk; the open transaction died with it\n      }\n    }\n    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n  } finally {\n    try {\n      db.close();\n    } catch {\n      // already closed by the induced-failure seam\n    }\n  }\n}\n\ninterface RawEventRow {\n  event_order: number | bigint;\n  event_kind: string;\n  idempotency_key: string;\n  actor: string;\n  harness: string;\n  payload: string;\n  recorded_at: string;\n}\n\nexport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const rows = db\n      .prepare(\n        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n         FROM event ORDER BY event_order`,\n      )\n      .all() as unknown as RawEventRow[];\n    const records = rows.map(\n      (row) =>\n        ({\n          eventKind: row.event_kind,\n          idempotencyKey: row.idempotency_key,\n          actor: row.actor,\n          harness: row.harness,\n          payload: JSON.parse(row.payload) as Record<string, unknown>,\n          eventOrder: Number(row.event_order),\n          recordedAt: row.recorded_at,\n        }) as unknown as EventRecord,\n    );\n    return { ok: true, value: records };\n  } catch (cause) {\n    return storageFailure(`event read-back failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":287,"startLine":1,"totalLines":287}}}

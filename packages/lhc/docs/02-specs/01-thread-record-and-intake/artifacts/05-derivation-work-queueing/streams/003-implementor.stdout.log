{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FYpCh9tXZ6rE4cNASgFk2u","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Records sha256 hashes of Red-phase test files into test/red-manifest.json.\n3\t// Usage: node scripts/record-red-manifest.mjs test/foo.test.ts [more files...]\n4\timport { createHash } from \"node:crypto\";\n5\timport { existsSync, readFileSync, writeFileSync } from \"node:fs\";\n6\timport path from \"node:path\";\n7\timport { fileURLToPath } from \"node:url\";\n8\t\n9\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n10\tconst manifestPath = path.join(pkgRoot, \"test\", \"red-manifest.json\");\n11\t\n12\tconst files = process.argv.slice(2);\n13\tif (files.length === 0) {\n14\t  console.error(\"usage: node scripts/record-red-manifest.mjs <test file> [...]\");\n15\t  process.exit(1);\n16\t}\n17\t\n18\tconst manifest = existsSync(manifestPath)\n19\t  ? JSON.parse(readFileSync(manifestPath, \"utf8\"))\n20\t  : { files: {} };\n21\tmanifest.files ??= {};\n22\t\n23\tfor (const file of files) {\n24\t  const rel = path.isAbsolute(file) ? path.relative(pkgRoot, file) : file;\n25\t  const full = path.join(pkgRoot, rel);\n26\t  manifest.files[rel] = createHash(\"sha256\").update(readFileSync(full)).digest(\"hex\");\n27\t  console.log(`recorded ${rel}`);\n28\t}\n29\t\n30\twriteFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\\n`);\n31\t"}]},"parent_tool_use_id":null,"session_id":"7ab0ad27-af7b-46f6-9ce5-aa43cce928f8","uuid":"75bd8b53-7286-4fde-a8d0-58d736c20e44","timestamp":"2026-06-10T14:52:15.462Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/scripts/record-red-manifest.mjs","content":"#!/usr/bin/env node\n// Records sha256 hashes of Red-phase test files into test/red-manifest.json.\n// Usage: node scripts/record-red-manifest.mjs test/foo.test.ts [more files...]\nimport { createHash } from \"node:crypto\";\nimport { existsSync, readFileSync, writeFileSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst manifestPath = path.join(pkgRoot, \"test\", \"red-manifest.json\");\n\nconst files = process.argv.slice(2);\nif (files.length === 0) {\n  console.error(\"usage: node scripts/record-red-manifest.mjs <test file> [...]\");\n  process.exit(1);\n}\n\nconst manifest = existsSync(manifestPath)\n  ? JSON.parse(readFileSync(manifestPath, \"utf8\"))\n  : { files: {} };\nmanifest.files ??= {};\n\nfor (const file of files) {\n  const rel = path.isAbsolute(file) ? path.relative(pkgRoot, file) : file;\n  const full = path.join(pkgRoot, rel);\n  manifest.files[rel] = createHash(\"sha256\").update(readFileSync(full)).digest(\"hex\");\n  console.log(`recorded ${rel}`);\n}\n\nwriteFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\\n`);\n","numLines":31,"startLine":1,"totalLines":31}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KBoCoE8nfgv4WdDduGiuNr","type":"tool_result","content":"1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n2\t\n3\texport type ErrorCode =\n4\t  | \"path_exists\"\n5\t  | \"thread_not_found\"\n6\t  | \"invalid_event\"\n7\t  | \"empty_batch\"\n8\t  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n9\t  | \"turn_state_corrupt\"\n10\t  | \"storage_failure\";\n11\t\n12\texport interface ErrorResult {\n13\t  errorClass: ErrorClass;\n14\t  code: ErrorCode;\n15\t  reason: string; // human-readable; machine logic switches on code\n16\t  eventIndex?: number; // present on batch validation failures\n17\t}\n18\t\n19\t// Expected operational failures — caller errors, corruption, environment\n20\t// failures — are always returned as OpResult errors, never thrown.\n21\t// Programmer bugs inside lhc may still throw; callers are not expected\n22\t// to handle throws as contract outcomes.\n23\texport type OpResult<T> =\n24\t  | { ok: true; value: T }\n25\t  | { ok: false; error: ErrorResult };\n26\t\n27\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n28\t// caught at the operation boundary and wrapped with the underlying detail.\n29\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n30\t  return {\n31\t    ok: false,\n32\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n33\t  };\n34\t}\n35\t\n36\texport function notImplemented(op: string): { ok: false; error: ErrorResult } {\n37\t  return {\n38\t    ok: false,\n39\t    error: {\n40\t      errorClass: \"system_error\",\n41\t      code: \"storage_failure\",\n42\t      reason: `not implemented: ${op}`,\n43\t    },\n44\t  };\n45\t}\n46\t"}]},"parent_tool_use_id":null,"session_id":"7ab0ad27-af7b-46f6-9ce5-aa43cce928f8","uuid":"8f680266-d932-4668-a34d-63ed3d723574","timestamp":"2026-06-10T14:52:28.238Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/errors.ts","content":"export type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n\nexport type ErrorCode =\n  | \"path_exists\"\n  | \"thread_not_found\"\n  | \"invalid_event\"\n  | \"empty_batch\"\n  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n  | \"turn_state_corrupt\"\n  | \"storage_failure\";\n\nexport interface ErrorResult {\n  errorClass: ErrorClass;\n  code: ErrorCode;\n  reason: string; // human-readable; machine logic switches on code\n  eventIndex?: number; // present on batch validation failures\n}\n\n// Expected operational failures — caller errors, corruption, environment\n// failures — are always returned as OpResult errors, never thrown.\n// Programmer bugs inside lhc may still throw; callers are not expected\n// to handle throws as contract outcomes.\nexport type OpResult<T> =\n  | { ok: true; value: T }\n  | { ok: false; error: ErrorResult };\n\n// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n// caught at the operation boundary and wrapped with the underlying detail.\nexport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n  };\n}\n\nexport function notImplemented(op: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"system_error\",\n      code: \"storage_failure\",\n      reason: `not implemented: ${op}`,\n    },\n  };\n}\n","numLines":46,"startLine":1,"totalLines":46}}}

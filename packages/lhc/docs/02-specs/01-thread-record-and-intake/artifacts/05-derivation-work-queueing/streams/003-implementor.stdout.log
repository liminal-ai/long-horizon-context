{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011fTP3oo7d8YKBt7D7gFg22","type":"tool_result","content":"1\timport { describe, expect, it } from \"vitest\";\n2\timport { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n3\t\n4\t// Story 1 made the threads commands real (test/threads.test.ts), Story 2 the\n5\t// intake-stream commands (test/intake.test.ts), Story 3 messages list\n6\t// (test/projection.test.ts), and Story 4 turns list (test/turns.test.ts);\n7\t// only the still-stubbed commands remain on this list.\n8\tconst PLANNED_COMMANDS: ReadonlyArray<{ argv: string[]; op: string }> = [\n9\t  { argv: [\"messages\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"messages.list-queued-work\" },\n10\t  { argv: [\"turns\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"turns.list-queued-work\" },\n11\t];\n12\t\n13\tdescribe(\"FC-0.3: CLI rail\", () => {\n14\t  it(\"responds to --help with usage for every planned command\", async () => {\n15\t    const result = await runCli([\"--help\"]);\n16\t    expect(result.exitCode).toBe(0);\n17\t    expect(result.stdout).toContain(\"Usage:\");\n18\t    for (const command of [\n19\t      \"threads new-thread\",\n20\t      \"threads resolve\",\n21\t      \"threads list\",\n22\t      \"intake-stream message-events\",\n23\t      \"intake-stream list-events\",\n24\t      \"messages list\",\n25\t      \"messages list-queued-work\",\n26\t      \"turns list\",\n27\t      \"turns list-queued-work\",\n28\t    ]) {\n29\t      expect(result.stdout).toContain(command);\n30\t    }\n31\t  });\n32\t\n33\t  it(\"unknown commands exit non-zero with a structured error\", async () => {\n34\t    const result = await runCli([\"frobnicate\", \"everything\"]);\n35\t    expect(result.exitCode).toBe(1);\n36\t    const parsed = JSON.parse(result.stdout) as {\n37\t      ok: boolean;\n38\t      error: { errorClass: string; code: string; reason: string };\n39\t    };\n40\t    expect(parsed.ok).toBe(false);\n41\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n42\t    expect(parsed.error.code).toBe(\"unknown_command\");\n43\t    expect(parsed.error.reason).toContain(\"frobnicate\");\n44\t  });\n45\t\n46\t  it(\"no command at all exits non-zero with a structured error\", async () => {\n47\t    const result = await runCli([]);\n48\t    expect(result.exitCode).toBe(1);\n49\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n50\t    expect(parsed.ok).toBe(false);\n51\t  });\n52\t\n53\t  it(\"every planned command routes to a fail-closed stub with the exact stub error shape\", async () => {\n54\t    for (const { argv, op } of PLANNED_COMMANDS) {\n55\t      const result = await runCli(argv);\n56\t      expect(result.exitCode, `exit code for: ${argv.join(\" \")}`).toBe(1);\n57\t      const parsed = JSON.parse(result.stdout) as unknown;\n58\t      expect(parsed, `stub shape for: ${argv.join(\" \")}`).toEqual({\n59\t        ok: false,\n60\t        error: {\n61\t          errorClass: \"system_error\",\n62\t          code: \"storage_failure\",\n63\t          reason: `not implemented: ${op}`,\n64\t        },\n65\t      });\n66\t    }\n67\t  });\n68\t});\n69\t\n70\tdescribe(\"FC-0.5: token counting\", () => {\n71\t  it(\"pins the estimator identity\", () => {\n72\t    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n73\t  });\n74\t\n75\t  it(\"returns golden counts for known strings\", () => {\n76\t    expect(estimateTokens(\"\")).toBe(0);\n77\t    expect(estimateTokens(\"hello world\")).toBe(2);\n78\t  });\n79\t\n80\t  it(\"same input, same count, every run\", () => {\n81\t    const inputs = [\n82\t      \"hello world\",\n83\t      \"The quick brown fox jumps over the lazy dog.\",\n84\t      \"tokens: émojis 🎉 and 中文 text\",\n85\t      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n86\t    ];\n87\t    for (const input of inputs) {\n88\t      const first = estimateTokens(input);\n89\t      expect(first).toBeGreaterThan(0);\n90\t      expect(estimateTokens(input)).toBe(first);\n91\t      expect(estimateTokens(input)).toBe(first);\n92\t    }\n93\t  });\n94\t});\n95\t"}]},"parent_tool_use_id":null,"session_id":"7ab0ad27-af7b-46f6-9ce5-aa43cce928f8","uuid":"bafdb2ac-2f61-4f05-aebd-ce49b42496b5","timestamp":"2026-06-10T15:00:49.609Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/smoke.test.ts","content":"import { describe, expect, it } from \"vitest\";\nimport { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n\n// Story 1 made the threads commands real (test/threads.test.ts), Story 2 the\n// intake-stream commands (test/intake.test.ts), Story 3 messages list\n// (test/projection.test.ts), and Story 4 turns list (test/turns.test.ts);\n// only the still-stubbed commands remain on this list.\nconst PLANNED_COMMANDS: ReadonlyArray<{ argv: string[]; op: string }> = [\n  { argv: [\"messages\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"messages.list-queued-work\" },\n  { argv: [\"turns\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"turns.list-queued-work\" },\n];\n\ndescribe(\"FC-0.3: CLI rail\", () => {\n  it(\"responds to --help with usage for every planned command\", async () => {\n    const result = await runCli([\"--help\"]);\n    expect(result.exitCode).toBe(0);\n    expect(result.stdout).toContain(\"Usage:\");\n    for (const command of [\n      \"threads new-thread\",\n      \"threads resolve\",\n      \"threads list\",\n      \"intake-stream message-events\",\n      \"intake-stream list-events\",\n      \"messages list\",\n      \"messages list-queued-work\",\n      \"turns list\",\n      \"turns list-queued-work\",\n    ]) {\n      expect(result.stdout).toContain(command);\n    }\n  });\n\n  it(\"unknown commands exit non-zero with a structured error\", async () => {\n    const result = await runCli([\"frobnicate\", \"everything\"]);\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string; reason: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"unknown_command\");\n    expect(parsed.error.reason).toContain(\"frobnicate\");\n  });\n\n  it(\"no command at all exits non-zero with a structured error\", async () => {\n    const result = await runCli([]);\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    expect(parsed.ok).toBe(false);\n  });\n\n  it(\"every planned command routes to a fail-closed stub with the exact stub error shape\", async () => {\n    for (const { argv, op } of PLANNED_COMMANDS) {\n      const result = await runCli(argv);\n      expect(result.exitCode, `exit code for: ${argv.join(\" \")}`).toBe(1);\n      const parsed = JSON.parse(result.stdout) as unknown;\n      expect(parsed, `stub shape for: ${argv.join(\" \")}`).toEqual({\n        ok: false,\n        error: {\n          errorClass: \"system_error\",\n          code: \"storage_failure\",\n          reason: `not implemented: ${op}`,\n        },\n      });\n    }\n  });\n});\n\ndescribe(\"FC-0.5: token counting\", () => {\n  it(\"pins the estimator identity\", () => {\n    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n  });\n\n  it(\"returns golden counts for known strings\", () => {\n    expect(estimateTokens(\"\")).toBe(0);\n    expect(estimateTokens(\"hello world\")).toBe(2);\n  });\n\n  it(\"same input, same count, every run\", () => {\n    const inputs = [\n      \"hello world\",\n      \"The quick brown fox jumps over the lazy dog.\",\n      \"tokens: émojis 🎉 and 中文 text\",\n      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n    ];\n    for (const input of inputs) {\n      const first = estimateTokens(input);\n      expect(first).toBeGreaterThan(0);\n      expect(estimateTokens(input)).toBe(first);\n      expect(estimateTokens(input)).toBe(first);\n    }\n  });\n});\n","numLines":95,"startLine":1,"totalLines":95}}}

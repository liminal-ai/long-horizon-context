{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts'","aggregated_output":"     1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n     2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n     3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n     4\t// Stories 3–5 extend the same per-event walk with projection, turn\n     5\t// transitions, and work queueing.\n     6\timport { existsSync } from \"node:fs\";\n     7\timport type { DatabaseSync } from \"node:sqlite\";\n     8\timport type { OperationContext } from \"../../../shared/context.js\";\n     9\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n    10\timport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n    11\timport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\n    12\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n    13\timport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\n    14\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n    15\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n    16\t\n    17\t// Test seam (set only through test/fixtures): called after each event is\n    18\t// processed inside the walk, so atomicity under mid-walk failure can be\n    19\t// induced through a real mechanism — closing the handle — rather than a\n    20\t// mocked transaction object.\n    21\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n    22\tlet walkHook: IntakeWalkHook | null = null;\n    23\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n    24\t  walkHook = hook;\n    25\t}\n    26\t\n    27\t// Test seam (set only through test/fixtures): replaces the wall clock so\n    28\t// recordedAt is sourced deterministically for the public SDK contract proof —\n    29\t// TC-1.4 records the same batch through both reference forms and reads it back\n    30\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n    31\t// production: recording stamps real wall time. An explicit clock argument to\n    32\t// runMessageEvents still wins over the seam.\n    33\tlet injectedClock: (() => Date) | null = null;\n    34\texport function setIntakeClock(clock: (() => Date) | null): void {\n    35\t  injectedClock = clock;\n    36\t}\n    37\t\n    38\tfunction detail(cause: unknown): string {\n    39\t  return cause instanceof Error ? cause.message : String(cause);\n    40\t}\n    41\t\n    42\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    43\t  return {\n    44\t    ok: false,\n    45\t    error: {\n    46\t      errorClass: \"caller_error\",\n    47\t      code: \"thread_not_found\",\n    48\t      reason: `no thread file exists at ${filePath}`,\n    49\t    },\n    50\t  };\n    51\t}\n    52\t\n    53\t// The skip set is read at transaction start and reads only the key column:\n    54\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n    55\t// Chunked to stay under SQLite's bound-parameter limit.\n    56\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n    57\t  const found = new Set<string>();\n    58\t  for (let offset = 0; offset < keys.length; offset += 400) {\n    59\t    const chunk = keys.slice(offset, offset + 400);\n    60\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n    61\t    const rows = db\n    62\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n    63\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    64\t    for (const row of rows) found.add(row.idempotency_key);\n    65\t  }\n    66\t  return found;\n    67\t}\n    68\t\n    69\tfunction threadIdOf(db: DatabaseSync): string {\n    70\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    71\t    | { thread_id: string }\n    72\t    | undefined;\n    73\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n    74\t  return row.thread_id;\n    75\t}\n    76\t\n    77\tfunction maxEventOrder(db: DatabaseSync): number {\n    78\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    79\t    | { max_order: number | bigint | null }\n    80\t    | undefined;\n    81\t  return Number(row?.max_order ?? 0);\n    82\t}\n    83\t\n    84\texport async function runMessageEvents(\n    85\t  thread: ThreadRef,\n    86\t  events: readonly MessageEventInput[],\n    87\t  clock: () => Date = injectedClock ?? (() => new Date()),\n    88\t): Promise<OpResult<BatchResult>> {\n    89\t  // Pure validation first: a rejected batch never opens the file, never takes\n    90\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n    91\t  // not a skip (validation-before-idempotency precedence).\n    92\t  const refFailure = validateThreadRef(thread);\n    93\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n    94\t  const batchFailure = validateEvents(events);\n    95\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n    96\t\n    97\t  const resolved = await resolveThreadRef(thread);\n    98\t  if (!resolved.ok) return resolved;\n    99\t  const { filePath } = resolved.value;\n   100\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   101\t\n   102\t  // openThreadDatabase verifies the file is a real thread file, then brings\n   103\t  // its schema to the current version before the batch transaction begins,\n   104\t  // so a thread recorded under an earlier story is writable here (F-03-001)\n   105\t  // and a non-thread file is rejected unmutated (F-03-002).\n   106\t  const opened = openThreadDatabase(filePath);\n   107\t  if (!opened.ok) return opened;\n   108\t  const db = opened.value;\n   109\t\n   110\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n   111\t  // single-writer violations fail loudly at a defined point.\n   112\t  let inTransaction = false;\n   113\t  try {\n   114\t    db.exec(\"BEGIN IMMEDIATE;\");\n   115\t    inTransaction = true;\n   116\t\n   117\t    // Cross-domain calls inside the transaction share the open handle through\n   118\t    // the operation context (design decision 8); built once per batch, never\n   119\t    // stored.\n   120\t    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n   121\t\n   122\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n   123\t    // any event is processed — once is sufficient because only this pipeline\n   124\t    // writes turn state and the write lock is already held, so more than one\n   125\t    // open turn can only mean external interference. The batch records\n   126\t    // nothing: nothing has been written yet, and the rollback closes the\n   127\t    // never-used transaction.\n   128\t    const openTurnIds = listOpenTurnIds(ctx);\n   129\t    if (openTurnIds.length > 1) {\n   130\t      db.exec(\"ROLLBACK;\");\n   131\t      inTransaction = false;\n   132\t      return {\n   133\t        ok: false,\n   134\t        error: {\n   135\t          errorClass: \"state_corruption\",\n   136\t          code: \"turn_state_corrupt\",\n   137\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n   138\t        },\n   139\t      };\n   140\t    }\n   141\t\n   142\t    const skipSet = recordedKeys(\n   143\t      db,\n   144\t      events.map((event) => event.idempotencyKey),\n   145\t    );\n   146\t    // Order counter from MAX(event_order): only recorded events increment it,\n   147\t    // so skips consume no order numbers and the sequence stays dense.\n   148\t    let lastOrder = maxEventOrder(db);\n   149\t\n   150\t    const insert = db.prepare(\n   151\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   152\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   153\t    );\n   154\t\n   155\t    const eventResults: BatchResult[\"events\"] = [];\n   156\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n   157\t    // Work items append as they queue, in walk order — the result is a\n   158\t    // faithful log of what the transaction did (AC-2.7). The full records\n   159\t    // (status, queuedAt) stay in the thread file; the result carries item\n   160\t    // identity only.\n   161\t    const queuedItems: WorkItemRecord[] = [];\n   162\t    for (const [index, event] of events.entries()) {\n   163\t      if (skipSet.has(event.idempotencyKey)) {\n   164\t        eventResults.push({\n   165\t          idempotencyKey: event.idempotencyKey,\n   166\t          outcome: \"skipped\",\n   167\t          skipReason: \"duplicate_idempotency_key\",\n   168\t        });\n   169\t      } else {\n   170\t        lastOrder += 1;\n   171\t        const recordedAt = clock().toISOString();\n   172\t        insert.run(\n   173\t          lastOrder,\n   174\t          event.eventKind,\n   175\t          event.idempotencyKey,\n   176\t          event.actor,\n   177\t          event.harness,\n   178\t          JSON.stringify(event.payload),\n   179\t          recordedAt,\n   180\t        );\n   181\t        skipSet.add(event.idempotencyKey);\n   182\t        // Turn transition before projection — the order is load-bearing: a\n   183\t        // prompt transitions first and stamps to the turn it just opened\n   184\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n   185\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n   186\t        // call, so a resend causes no transition (TC-5.4).\n   187\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n   188\t        turnTransitions.push(...turnOutcome.transitions);\n   189\t        queuedItems.push(...turnOutcome.queuedWork);\n   190\t        // Projection runs in the same iteration that recorded the event, so\n   191\t        // it can never drift from its source; a projection failure throws\n   192\t        // and rejects the whole batch. Skipped events never reach this call\n   193\t        // (no duplicate message, AC-5.4).\n   194\t        const created = createFromEvent(\n   195\t          ctx,\n   196\t          {\n   197\t            ...event,\n   198\t            eventOrder: lastOrder,\n   199\t            recordedAt,\n   200\t          },\n   201\t          turnOutcome.openTurnId,\n   202\t        );\n   203\t        // Message-owned work queues in the same iteration, gated on\n   204\t        // recorded: a skipped event never reaches this call, so it queues\n   205\t        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n   206\t        // decides which messages are derivation sources (AC-2.8).\n   207\t        queuedItems.push(...queueMessageWork(ctx, created));\n   208\t        const entry: BatchResult[\"events\"][number] = {\n   209\t          idempotencyKey: event.idempotencyKey,\n   210\t          outcome: \"recorded\",\n   211\t        };\n   212\t        if (created !== null) entry.messageId = created.messageId;\n   213\t        eventResults.push(entry);\n   214\t      }\n   215\t      walkHook?.(db, index);\n   216\t    }\n   217\t\n   218\t    db.exec(\"COMMIT;\");\n   219\t    inTransaction = false;\n   220\t\n   221\t    return {\n   222\t      ok: true,\n   223\t      value: {\n   224\t        events: eventResults,\n   225\t        turnTransitions,\n   226\t        queuedWork: queuedItems.map((item) => ({\n   227\t          workItemId: item.workItemId,\n   228\t          owner: item.owner,\n   229\t          kind: item.kind,\n   230\t          sourceRef: item.sourceRef,\n   231\t        })),\n   232\t        threadPosition: { lastEventOrder: lastOrder },\n   233\t      },\n   234\t    };\n   235\t  } catch (cause) {\n   236\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n   237\t    // class-independent. The handle may already be gone (induced failure),\n   238\t    // in which case SQLite has already discarded the uncommitted transaction.\n   239\t    if (inTransaction) {\n   240\t      try {\n   241\t        db.exec(\"ROLLBACK;\");\n   242\t      } catch {\n   243\t        // handle closed mid-walk; the open transaction died with it\n   244\t      }\n   245\t    }\n   246\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n   247\t  } finally {\n   248\t    try {\n   249\t      db.close();\n   250\t    } catch {\n   251\t      // already closed by the induced-failure seam\n   252\t    }\n   253\t  }\n   254\t}\n   255\t\n   256\tinterface RawEventRow {\n   257\t  event_order: number | bigint;\n   258\t  event_kind: string;\n   259\t  idempotency_key: string;\n   260\t  actor: string;\n   261\t  harness: string;\n   262\t  payload: string;\n   263\t  recorded_at: string;\n   264\t}\n   265\t\n   266\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n   267\t  const refFailure = validateThreadRef(thread);\n   268\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n   269\t\n   270\t  const resolved = await resolveThreadRef(thread);\n   271\t  if (!resolved.ok) return resolved;\n   272\t  const { filePath } = resolved.value;\n   273\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   274\t\n   275\t  const opened = openThreadDatabase(filePath);\n   276\t  if (!opened.ok) return opened;\n   277\t  const db = opened.value;\n   278\t  try {\n   279\t    const rows = db\n   280\t      .prepare(\n   281\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n   282\t         FROM event ORDER BY event_order`,\n   283\t      )\n   284\t      .all() as unknown as RawEventRow[];\n   285\t    const records = rows.map(\n   286\t      (row) =>\n   287\t        ({\n   288\t          eventKind: row.event_kind,\n   289\t          idempotencyKey: row.idempotency_key,\n   290\t          actor: row.actor,\n   291\t          harness: row.harness,\n   292\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n   293\t          eventOrder: Number(row.event_order),\n   294\t          recordedAt: row.recorded_at,\n   295\t        }) as unknown as EventRecord,\n   296\t    );\n   297\t    return { ok: true, value: records };\n   298\t  } catch (cause) {\n   299\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n   300\t  } finally {\n   301\t    db.close();\n   302\t  }\n   303\t}\n","exit_code":0,"status":"completed"}}

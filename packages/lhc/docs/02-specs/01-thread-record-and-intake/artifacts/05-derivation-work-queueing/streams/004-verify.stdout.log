{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/intake-stream/index.ts'","aggregated_output":"     1\timport type { OpResult } from \"../../shared/errors.js\";\n     2\timport type {\n     3\t  WorkKind,\n     4\t  WorkOwner,\n     5\t  WorkSourceRef,\n     6\t} from \"../../tech-utils/work-queue/index.js\";\n     7\timport type { ThreadRef } from \"../threads/index.js\";\n     8\timport { runListEvents, runMessageEvents } from \"./internal/pipeline.js\";\n     9\t\n    10\tinterface BaseEvent<K extends string, P> {\n    11\t  eventKind: K;\n    12\t  idempotencyKey: string;\n    13\t  actor: string; // non-empty\n    14\t  harness: string; // non-empty\n    15\t  payload: P; // shape fixed by kind, closed\n    16\t}\n    17\t\n    18\texport type MessageEventInput =\n    19\t  | BaseEvent<\"user_prompt\", { text: string }>\n    20\t  | BaseEvent<\"assistant_text\", { text: string }>\n    21\t  | BaseEvent<\"assistant_thinking\", { text: string }>\n    22\t  | BaseEvent<\"runtime_note\", { text: string }>\n    23\t  | BaseEvent<\n    24\t      \"tool_call\",\n    25\t      { toolCallId: string; toolName: string; arguments: Record<string, unknown> }\n    26\t    >\n    27\t  | BaseEvent<\"tool_result\", { toolCallId: string; content: string; isError?: boolean }>\n    28\t  | BaseEvent<\"turn_end\", Record<string, never>>;\n    29\t\n    30\t// Derived, not parallel-maintained: the kind list cannot drift from the union.\n    31\texport type EventKind = MessageEventInput[\"eventKind\"];\n    32\t\n    33\texport interface BatchResult {\n    34\t  events: Array<{\n    35\t    idempotencyKey: string;\n    36\t    outcome: \"recorded\" | \"skipped\";\n    37\t    messageId?: string;\n    38\t    skipReason?: \"duplicate_idempotency_key\";\n    39\t  }>;\n    40\t  turnTransitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    41\t  queuedWork: Array<{\n    42\t    workItemId: string;\n    43\t    owner: WorkOwner;\n    44\t    kind: WorkKind;\n    45\t    sourceRef: WorkSourceRef;\n    46\t  }>;\n    47\t  threadPosition: { lastEventOrder: number };\n    48\t}\n    49\t\n    50\t// Read-back preserves the discrimination: intersecting the input union with\n    51\t// server fields distributes over its members, so a narrowed eventKind narrows\n    52\t// the payload on read exactly as it does on write.\n    53\texport type EventRecord = MessageEventInput & {\n    54\t  eventOrder: number;\n    55\t  recordedAt: string;\n    56\t};\n    57\t\n    58\texport async function messageEvents(\n    59\t  thread: ThreadRef,\n    60\t  events: readonly MessageEventInput[],\n    61\t): Promise<OpResult<BatchResult>> {\n    62\t  return runMessageEvents(thread, events);\n    63\t}\n    64\t\n    65\texport async function listEvents(\n    66\t  thread: ThreadRef,\n    67\t): Promise<OpResult<EventRecord[]>> {\n    68\t  return runListEvents(thread);\n    69\t}\n","exit_code":0,"status":"completed"}}

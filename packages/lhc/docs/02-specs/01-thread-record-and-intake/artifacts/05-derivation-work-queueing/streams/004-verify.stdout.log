{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/work-queue.test.ts'","aggregated_output":"     1\t// Story 5 (Chunk 5): derivation work queueing. TC-2.6 (complete batch\n     2\t// result), TC-2.7/TC-2.9 (message-owned work and its kind gate), the work\n     3\t// halves of TC-3.3/TC-3.6 (Story 4's named debt, paid here), TC-3.8's\n     4\t// two-work-items assertion, TC-5.4's no-work-item clause, and the two\n     5\t// architecture-risk regressions: restart survival extended to work items and\n     6\t// the complete-surface rollback. Work items are asserted through the owning\n     7\t// domains' listQueuedWork read-back and openRaw — never through the batch\n     8\t// result alone. The work-queue util has no public SDK surface; everything\n     9\t// here enters through the SDK or the in-process CLI.\n    10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    11\timport {\n    12\t  intakeStream,\n    13\t  messages,\n    14\t  runCli,\n    15\t  threads,\n    16\t  turns,\n    17\t  type MessageEventInput,\n    18\t  type WorkItemRecord,\n    19\t} from \"../src/index.js\";\n    20\timport {\n    21\t  openRaw,\n    22\t  setIntakeClock,\n    23\t  tempStore,\n    24\t  validEvent,\n    25\t  type TempStore,\n    26\t} from \"./fixtures/index.js\";\n    27\t\n    28\tlet store: TempStore;\n    29\tbeforeEach(() => {\n    30\t  store = tempStore();\n    31\t});\n    32\tafterEach(() => {\n    33\t  store.cleanup();\n    34\t  setIntakeClock(null);\n    35\t});\n    36\t\n    37\tasync function createThread(): Promise<string> {\n    38\t  const filePath = store.threadPath();\n    39\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    40\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    41\t  return filePath;\n    42\t}\n    43\t\n    44\tasync function send(filePath: string, batch: MessageEventInput[]) {\n    45\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n    46\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n    47\t  return result.value;\n    48\t}\n    49\t\n    50\tasync function queuedFor(\n    51\t  filePath: string,\n    52\t  owner: \"messages\" | \"turns\",\n    53\t): Promise<WorkItemRecord[]> {\n    54\t  const result =\n    55\t    owner === \"messages\"\n    56\t      ? await messages.listQueuedWork({ filePath })\n    57\t      : await turns.listQueuedWork({ filePath });\n    58\t  if (!result.ok) throw new Error(`queued-work read-back failed: ${result.error.reason}`);\n    59\t  return result.value;\n    60\t}\n    61\t\n    62\t// Below-SDK count of durable work-item rows: the batch result alone is not\n    63\t// proof of durability (anti-shim requirement).\n    64\tfunction rawWorkItemCount(filePath: string): number {\n    65\t  const db = openRaw(filePath);\n    66\t  try {\n    67\t    const row = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as { n: number | bigint };\n    68\t    return Number(row.n);\n    69\t  } finally {\n    70\t    db.close();\n    71\t  }\n    72\t}\n    73\t\n    74\t// Full logical read-back across every record kind the epic owns — the\n    75\t// complete-surface rollback regression compares this whole.\n    76\tasync function readBack(filePath: string) {\n    77\t  const [events, projected, turnRecords, messageWork, turnWork] = await Promise.all([\n    78\t    intakeStream.listEvents({ filePath }),\n    79\t    messages.listMessages({ filePath }),\n    80\t    turns.listTurns({ filePath }),\n    81\t    messages.listQueuedWork({ filePath }),\n    82\t    turns.listQueuedWork({ filePath }),\n    83\t  ]);\n    84\t  if (!events.ok || !projected.ok || !turnRecords.ok || !messageWork.ok || !turnWork.ok) {\n    85\t    throw new Error(\"read-back failed\");\n    86\t  }\n    87\t  return {\n    88\t    events: events.value,\n    89\t    messages: projected.value,\n    90\t    turns: turnRecords.value,\n    91\t    messageWork: messageWork.value,\n    92\t    turnWork: turnWork.value,\n    93\t  };\n    94\t}\n    95\t\n    96\tconst FIXED_INSTANT = \"2026-06-10T12:00:00.000Z\";\n    97\t\n    98\tdescribe(\"Flow 2 (SDK): message-owned work queueing\", () => {\n    99\t  it(\"TC-2.7: a prompt and a tool result each durably queue their kind, owner messages (AC-2.8)\", async () => {\n   100\t    setIntakeClock(() => new Date(FIXED_INSTANT));\n   101\t    const filePath = await createThread();\n   102\t    const result = await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\")]);\n   103\t\n   104\t    // The batch result reports both items with full identity.\n   105\t    expect(result.queuedWork).toContainEqual({\n   106\t      workItemId: \"w-m1-prompt_smoothing\",\n   107\t      owner: \"messages\",\n   108\t      kind: \"prompt_smoothing\",\n   109\t      sourceRef: { messageId: \"m1\" },\n   110\t    });\n   111\t    expect(result.queuedWork).toContainEqual({\n   112\t      workItemId: \"w-m2-tool_result_summary\",\n   113\t      owner: \"messages\",\n   114\t      kind: \"tool_result_summary\",\n   115\t      sourceRef: { messageId: \"m2\" },\n   116\t    });\n   117\t\n   118\t    // Durable read-back through the owning domain: deterministic ids, status\n   119\t    // queued, queuedAt from the injected clock.\n   120\t    expect(await queuedFor(filePath, \"messages\")).toEqual([\n   121\t      {\n   122\t        workItemId: \"w-m1-prompt_smoothing\",\n   123\t        owner: \"messages\",\n   124\t        kind: \"prompt_smoothing\",\n   125\t        sourceRef: { messageId: \"m1\" },\n   126\t        status: \"queued\",\n   127\t        queuedAt: FIXED_INSTANT,\n   128\t      },\n   129\t      {\n   130\t        workItemId: \"w-m2-tool_result_summary\",\n   131\t        owner: \"messages\",\n   132\t        kind: \"tool_result_summary\",\n   133\t        sourceRef: { messageId: \"m2\" },\n   134\t        status: \"queued\",\n   135\t        queuedAt: FIXED_INSTANT,\n   136\t      },\n   137\t    ]);\n   138\t\n   139\t    // The prompt opened a turn that is still open: no turn-owned work yet,\n   140\t    // and each domain reads back only its own items.\n   141\t    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n   142\t    expect(rawWorkItemCount(filePath)).toBe(2);\n   143\t  });\n   144\t\n   145\t  it(\"TC-2.9: text, thinking, and note messages queue nothing — the kind gate is exact (AC-2.8)\", async () => {\n   146\t    const filePath = await createThread();\n   147\t    const result = await send(filePath, [\n   148\t      validEvent(\"assistant_text\"),\n   149\t      validEvent(\"assistant_thinking\"),\n   150\t      validEvent(\"runtime_note\"),\n   151\t    ]);\n   152\t    expect(result.queuedWork).toEqual([]);\n   153\t    expect(await queuedFor(filePath, \"messages\")).toEqual([]);\n   154\t    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n   155\t    expect(rawWorkItemCount(filePath)).toBe(0);\n   156\t  });\n   157\t\n   158\t  it(\"TC-2.6: a mixed batch's result is complete — outcomes, messageIds, transitions, queuedWork, position (AC-2.7)\", async () => {\n   159\t    const filePath = await createThread();\n   160\t    const original = validEvent(\"user_prompt\");\n   161\t    await send(filePath, [original]);\n   162\t\n   163\t    const result = await send(filePath, [\n   164\t      original, // duplicate: skipped\n   165\t      validEvent(\"assistant_text\"),\n   166\t      validEvent(\"turn_end\"),\n   167\t    ]);\n   168\t\n   169\t    expect(result.events).toEqual([\n   170\t      {\n   171\t        idempotencyKey: original.idempotencyKey,\n   172\t        outcome: \"skipped\",\n   173\t        skipReason: \"duplicate_idempotency_key\",\n   174\t      },\n   175\t      expect.objectContaining({ outcome: \"recorded\", messageId: \"m2\" }),\n   176\t      expect.objectContaining({ outcome: \"recorded\" }),\n   177\t    ]);\n   178\t    // turn_end produces no message.\n   179\t    expect(result.events[2]).not.toHaveProperty(\"messageId\");\n   180\t    expect(result.turnTransitions).toEqual([{ action: \"closed\", turnId: \"t1\" }]);\n   181\t    expect(result.queuedWork).toEqual([\n   182\t      {\n   183\t        workItemId: \"w-t1-turn_derivation\",\n   184\t        owner: \"turns\",\n   185\t        kind: \"turn_derivation\",\n   186\t        sourceRef: { turnId: \"t1\" },\n   187\t      },\n   188\t    ]);\n   189\t    expect(result.threadPosition).toEqual({ lastEventOrder: 3 });\n   190\t  });\n   191\t});\n   192\t\n   193\tdescribe(\"Flow 3 (SDK): turn-owned work queueing — Story 4's debt paid\", () => {\n   194\t  it(\"TC-3.3 (work half): explicit close durably queues w-t1-turn_derivation, owner turns (AC-3.4, AC-3.6)\", async () => {\n   195\t    setIntakeClock(() => new Date(FIXED_INSTANT));\n   196\t    const filePath = await createThread();\n   197\t    const result = await send(filePath, [\n   198\t      validEvent(\"user_prompt\"),\n   199\t      validEvent(\"assistant_text\"),\n   200\t      validEvent(\"turn_end\"),\n   201\t    ]);\n   202\t\n   203\t    expect(result.queuedWork).toContainEqual({\n   204\t      workItemId: \"w-t1-turn_derivation\",\n   205\t      owner: \"turns\",\n   206\t      kind: \"turn_derivation\",\n   207\t      sourceRef: { turnId: \"t1\" },\n   208\t    });\n   209\t    expect(await queuedFor(filePath, \"turns\")).toEqual([\n   210\t      {\n   211\t        workItemId: \"w-t1-turn_derivation\",\n   212\t        owner: \"turns\",\n   213\t        kind: \"turn_derivation\",\n   214\t        sourceRef: { turnId: \"t1\" },\n   215\t        status: \"queued\",\n   216\t        queuedAt: FIXED_INSTANT,\n   217\t      },\n   218\t    ]);\n   219\t  });\n   220\t\n   221\t  it(\"TC-3.6 (work half): implicit close queues the same work-item contract as the explicit path (AC-3.6)\", async () => {\n   222\t    const explicitPath = await createThread();\n   223\t    await send(explicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n   224\t    await send(explicitPath, [validEvent(\"turn_end\")]);\n   225\t\n   226\t    const implicitPath = await createThread();\n   227\t    await send(implicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n   228\t    await send(implicitPath, [validEvent(\"user_prompt\")]);\n   229\t\n   230\t    const explicitItems = await queuedFor(explicitPath, \"turns\");\n   231\t    const implicitItems = await queuedFor(implicitPath, \"turns\");\n   232\t    expect(explicitItems).toHaveLength(1);\n   233\t    // Same item contract modulo queuedAt (wall clock differs between runs).\n   234\t    const contract = (items: WorkItemRecord[]) =>\n   235\t      items.map(({ queuedAt: _queuedAt, ...rest }) => rest);\n   236\t    expect(contract(implicitItems)).toEqual(contract(explicitItems));\n   237\t    expect(contract(explicitItems)).toEqual([\n   238\t      {\n   239\t        workItemId: \"w-t1-turn_derivation\",\n   240\t        owner: \"turns\",\n   241\t        kind: \"turn_derivation\",\n   242\t        sourceRef: { turnId: \"t1\" },\n   243\t        status: \"queued\",\n   244\t      },\n   245\t    ]);\n   246\t  });\n   247\t\n   248\t  it(\"TC-3.8 (work count): a multi-turn batch queues one turn_derivation item per closed turn (AC-3.6)\", async () => {\n   249\t    const filePath = await createThread();\n   250\t    await send(filePath, [\n   251\t      validEvent(\"user_prompt\"),\n   252\t      validEvent(\"assistant_text\"),\n   253\t      validEvent(\"user_prompt\"),\n   254\t      validEvent(\"assistant_text\"),\n   255\t      validEvent(\"turn_end\"),\n   256\t    ]);\n   257\t\n   258\t    const turnWork = await queuedFor(filePath, \"turns\");\n   259\t    expect(turnWork.map((item) => item.workItemId)).toEqual([\n   260\t      \"w-t1-turn_derivation\",\n   261\t      \"w-t2-turn_derivation\",\n   262\t    ]);\n   263\t    expect(turnWork.every((item) => item.kind === \"turn_derivation\")).toBe(true);\n   264\t    expect(turnWork.every((item) => item.status === \"queued\")).toBe(true);\n   265\t  });\n   266\t\n   267\t  it(\"TC-5.4 (no-work-item clause): a skipped event queues nothing (AC-5.4)\", async () => {\n   268\t    const filePath = await createThread();\n   269\t    const prompt = validEvent(\"user_prompt\");\n   270\t    const end = validEvent(\"turn_end\");\n   271\t    await send(filePath, [prompt, validEvent(\"assistant_text\"), end]);\n   272\t    await send(filePath, [validEvent(\"user_prompt\")]); // t2 now open\n   273\t    const baseline = await readBack(filePath);\n   274\t    const baselineCount = rawWorkItemCount(filePath);\n   275\t\n   276\t    const resend = await send(filePath, [prompt, end]);\n   277\t    expect(resend.events.map((entry) => entry.outcome)).toEqual([\"skipped\", \"skipped\"]);\n   278\t    expect(resend.queuedWork).toEqual([]);\n   279\t    expect(await readBack(filePath)).toEqual(baseline);\n   280\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n   281\t  });\n   282\t});\n   283\t\n   284\tdescribe(\"architecture-risk: durability and rollback over the complete record surface\", () => {\n   285\t  it(\"restart survival: a reopened thread file holds its work items intact, status queued\", async () => {\n   286\t    const filePath = await createThread();\n   287\t    await send(filePath, [\n   288\t      validEvent(\"user_prompt\"),\n   289\t      validEvent(\"tool_call\"),\n   290\t      validEvent(\"tool_result\"),\n   291\t      validEvent(\"turn_end\"),\n   292\t    ]);\n   293\t    const before = await readBack(filePath);\n   294\t    expect(before.messageWork).toHaveLength(2);\n   295\t    expect(before.turnWork).toHaveLength(1);\n   296\t\n   297\t    // Every SDK operation opens and closes its own handle, so a fresh\n   298\t    // read-back is a real reopen of the real file. The raw scan proves the\n   299\t    // rows live in the thread file itself — not an in-memory queue.\n   300\t    const db = openRaw(filePath);\n   301\t    try {\n   302\t      const rows = db\n   303\t        .prepare(\"SELECT work_item_id, status FROM work_item ORDER BY work_item_id\")\n   304\t        .all() as unknown as Array<{ work_item_id: string; status: string }>;\n   305\t      expect(rows).toEqual([\n   306\t        { work_item_id: \"w-m1-prompt_smoothing\", status: \"queued\" },\n   307\t        { work_item_id: \"w-m3-tool_result_summary\", status: \"queued\" },\n   308\t        { work_item_id: \"w-t1-turn_derivation\", status: \"queued\" },\n   309\t      ]);\n   310\t    } finally {\n   311\t      db.close();\n   312\t    }\n   313\t    expect(await readBack(filePath)).toEqual(before);\n   314\t  });\n   315\t\n   316\t  it(\"complete-surface rollback: a rejected batch leaves events, messages, turns, and work items at baseline (AC-4.6)\", async () => {\n   317\t    const filePath = await createThread();\n   318\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\"), validEvent(\"turn_end\")]);\n   319\t    const baseline = await readBack(filePath);\n   320\t    const baselineCount = rawWorkItemCount(filePath);\n   321\t\n   322\t    // A valid prefix that would queue work, then one invalid event: the\n   323\t    // batch must reject whole and queue nothing.\n   324\t    const rejected = await intakeStream.messageEvents({ filePath }, [\n   325\t      validEvent(\"user_prompt\"),\n   326\t      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n   327\t    ]);\n   328\t    expect(rejected.ok).toBe(false);\n   329\t    if (rejected.ok) return;\n   330\t    expect(rejected.error.code).toBe(\"invalid_event\");\n   331\t\n   332\t    expect(await readBack(filePath)).toEqual(baseline);\n   333\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n   334\t  });\n   335\t});\n   336\t\n   337\tdescribe(\"CLI in-process: list-queued-work on both owning domains\", () => {\n   338\t  it(\"messages list-queued-work and turns list-queued-work each return only their owner's items\", async () => {\n   339\t    const filePath = await createThread();\n   340\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n   341\t\n   342\t    const messagesListed = await runCli([\"messages\", \"list-queued-work\", \"--file-path\", filePath]);\n   343\t    expect(messagesListed.exitCode).toBe(0);\n   344\t    const messagesParsed = JSON.parse(messagesListed.stdout) as {\n   345\t      ok: boolean;\n   346\t      value: WorkItemRecord[];\n   347\t    };\n   348\t    expect(messagesParsed.ok).toBe(true);\n   349\t    expect(messagesParsed.value).toHaveLength(1);\n   350\t    expect(messagesParsed.value[0]).toMatchObject({\n   351\t      workItemId: \"w-m1-prompt_smoothing\",\n   352\t      owner: \"messages\",\n   353\t      kind: \"prompt_smoothing\",\n   354\t      sourceRef: { messageId: \"m1\" },\n   355\t      status: \"queued\",\n   356\t    });\n   357\t\n   358\t    const turnsListed = await runCli([\"turns\", \"list-queued-work\", \"--file-path\", filePath]);\n   359\t    expect(turnsListed.exitCode).toBe(0);\n   360\t    const turnsParsed = JSON.parse(turnsListed.stdout) as {\n   361\t      ok: boolean;\n   362\t      value: WorkItemRecord[];\n   363\t    };\n   364\t    expect(turnsParsed.ok).toBe(true);\n   365\t    expect(turnsParsed.value).toHaveLength(1);\n   366\t    expect(turnsParsed.value[0]).toMatchObject({\n   367\t      workItemId: \"w-t1-turn_derivation\",\n   368\t      owner: \"turns\",\n   369\t      kind: \"turn_derivation\",\n   370\t      sourceRef: { turnId: \"t1\" },\n   371\t      status: \"queued\",\n   372\t    });\n   373\t  });\n   374\t\n   375\t  it(\"list-queued-work on an unknown thread id fails with thread_not_found\", async () => {\n   376\t    const listed = await runCli([\n   377\t      \"messages\",\n   378\t      \"list-queued-work\",\n   379\t      \"--thread-id\",\n   380\t      \"th_nope\",\n   381\t      \"--registry\",\n   382\t      store.registryPath,\n   383\t    ]);\n   384\t    expect(listed.exitCode).toBe(1);\n   385\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; error: { code: string } };\n   386\t    expect(parsed.ok).toBe(false);\n   387\t    expect(parsed.error.code).toBe(\"thread_not_found\");\n   388\t  });\n   389\t});\n","exit_code":0,"status":"completed"}}

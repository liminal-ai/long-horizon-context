{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/scripts/check-boundaries.mjs'","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Zero-dependency import-boundary check.\n     3\t// Rules:\n     4\t//   1. No file may import another domain's internal/ modules.\n     5\t//   2. tech-utils/ and shared/ may not import from domains/.\n     6\t// The test fixtures directory (test/fixtures/) is exempt by design — it is\n     7\t// the one sanctioned below-SDK writer.\n     8\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n     9\timport path from \"node:path\";\n    10\timport { fileURLToPath } from \"node:url\";\n    11\t\n    12\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    13\tconst srcRoot = path.join(pkgRoot, \"src\");\n    14\tconst testRoot = path.join(pkgRoot, \"test\");\n    15\tconst fixturesRoot = path.join(testRoot, \"fixtures\");\n    16\t\n    17\tfunction collectTsFiles(dir, out = []) {\n    18\t  let entries;\n    19\t  try {\n    20\t    entries = readdirSync(dir);\n    21\t  } catch {\n    22\t    return out;\n    23\t  }\n    24\t  for (const entry of entries) {\n    25\t    const full = path.join(dir, entry);\n    26\t    if (full === fixturesRoot) continue; // fixtures exempt\n    27\t    if (statSync(full).isDirectory()) {\n    28\t      collectTsFiles(full, out);\n    29\t    } else if (full.endsWith(\".ts\")) {\n    30\t      out.push(full);\n    31\t    }\n    32\t  }\n    33\t  return out;\n    34\t}\n    35\t\n    36\tfunction importSpecifiers(source) {\n    37\t  const specs = [];\n    38\t  const patterns = [\n    39\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    40\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    41\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n    42\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n    43\t  ];\n    44\t  for (const re of patterns) {\n    45\t    let m;\n    46\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n    47\t  }\n    48\t  return specs;\n    49\t}\n    50\t\n    51\tfunction domainOf(filePath) {\n    52\t  const rel = path.relative(srcRoot, filePath);\n    53\t  const parts = rel.split(path.sep);\n    54\t  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n    55\t  return null;\n    56\t}\n    57\t\n    58\tconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\n    59\tconst violations = [];\n    60\t\n    61\tfor (const file of files) {\n    62\t  const source = readFileSync(file, \"utf8\");\n    63\t  const fileDomain = domainOf(file);\n    64\t  const inTechUtilsOrShared =\n    65\t    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n    66\t    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n    67\t\n    68\t  for (const spec of importSpecifiers(source)) {\n    69\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n    70\t    const resolved = path.resolve(path.dirname(file), spec);\n    71\t    const relToSrc = path.relative(srcRoot, resolved);\n    72\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n    73\t    const parts = relToSrc.split(path.sep);\n    74\t\n    75\t    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n    76\t      const targetDomain = parts[1];\n    77\t      if (fileDomain !== targetDomain) {\n    78\t        violations.push(\n    79\t          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n    80\t        );\n    81\t      }\n    82\t    }\n    83\t    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n    84\t      violations.push(\n    85\t        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n    86\t      );\n    87\t    }\n    88\t  }\n    89\t}\n    90\t\n    91\tif (violations.length > 0) {\n    92\t  console.error(\"boundary check FAILED:\");\n    93\t  for (const v of violations) console.error(`  - ${v}`);\n    94\t  process.exit(1);\n    95\t}\n    96\tconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n","exit_code":0,"status":"completed"}}

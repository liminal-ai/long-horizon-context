{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/internal/state-machine.ts'","aggregated_output":"     1\t// The turn rule table as a pure function (Flow 3). Every row of the epic's\n     2\t// table is one golden case against this function: prompt with no open turn →\n     3\t// open; prompt with open turn → close_then_open; turn_end with open turn →\n     4\t// close; turn_end with none → none; every other kind → none (stamping is\n     5\t// membership, not transition). The corruption row (>1 open turn) is handled\n     6\t// by the pipeline at state load, not here — only the pipeline writes turn\n     7\t// state, so a violation means external interference and fails the batch\n     8\t// before any event reaches this function.\n     9\timport type { EventKind } from \"../../intake-stream/index.js\";\n    10\t\n    11\texport interface TurnState {\n    12\t  openTurnId: string | null;\n    13\t}\n    14\t\n    15\texport type TurnEffect =\n    16\t  | { kind: \"none\" }\n    17\t  | { kind: \"open\" }\n    18\t  | { kind: \"close\" }\n    19\t  | { kind: \"close_then_open\" };\n    20\t\n    21\texport function transition(state: TurnState, eventKind: EventKind): TurnEffect {\n    22\t  switch (eventKind) {\n    23\t    case \"user_prompt\":\n    24\t      return state.openTurnId === null ? { kind: \"open\" } : { kind: \"close_then_open\" };\n    25\t    case \"turn_end\":\n    26\t      return state.openTurnId === null ? { kind: \"none\" } : { kind: \"close\" };\n    27\t    case \"assistant_text\":\n    28\t    case \"assistant_thinking\":\n    29\t    case \"runtime_note\":\n    30\t    case \"tool_call\":\n    31\t    case \"tool_result\":\n    32\t      return { kind: \"none\" };\n    33\t  }\n    34\t}\n","exit_code":0,"status":"completed"}}

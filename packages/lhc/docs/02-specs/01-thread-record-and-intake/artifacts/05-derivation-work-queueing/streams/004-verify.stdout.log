{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/cli-process.test.ts'","aggregated_output":"     1\t// CLI process-boundary suite: spawns the built dist/cli.js. Runs under\n     2\t// verify-all only (needs a build artifact); plain verify announces the skip.\n     3\timport { spawnSync } from \"node:child_process\";\n     4\timport { existsSync, mkdtempSync, rmSync } from \"node:fs\";\n     5\timport { tmpdir } from \"node:os\";\n     6\timport path from \"node:path\";\n     7\timport { fileURLToPath } from \"node:url\";\n     8\timport { describe, expect, it } from \"vitest\";\n     9\t\n    10\tconst cliPath = path.resolve(\n    11\t  path.dirname(fileURLToPath(import.meta.url)),\n    12\t  \"../dist/cli.js\",\n    13\t);\n    14\t\n    15\tfunction runBinary(args: string[]): {\n    16\t  status: number | null;\n    17\t  stdout: string;\n    18\t  stderr: string;\n    19\t} {\n    20\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    21\t    encoding: \"utf8\",\n    22\t  });\n    23\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    24\t}\n    25\t\n    26\tdescribe(\"FC-0.3 (process boundary): built binary\", () => {\n    27\t  it(\"dist/cli.js exists (build ran before this suite)\", () => {\n    28\t    expect(existsSync(cliPath)).toBe(true);\n    29\t  });\n    30\t\n    31\t  it(\"--help exits 0 with usage on stdout\", () => {\n    32\t    const result = runBinary([\"--help\"]);\n    33\t    expect(result.status).toBe(0);\n    34\t    expect(result.stdout).toContain(\"Usage:\");\n    35\t  });\n    36\t\n    37\t  it(\"unknown command exits 1 with structured JSON\", () => {\n    38\t    const result = runBinary([\"nonsense\"]);\n    39\t    expect(result.status).toBe(1);\n    40\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    41\t    expect(parsed.ok).toBe(false);\n    42\t  });\n    43\t\n    44\t  it(\"a structured SDK error reaches the caller through the real binary\", () => {\n    45\t    // Every command went live by Story 5 (list-queued-work was the last\n    46\t    // stub), so the rail proof is now the real error path: an unknown thread\n    47\t    // id renders the SDK's error result as JSON with exit 1.\n    48\t    const result = runBinary([\"messages\", \"list-queued-work\", \"--thread-id\", \"th_x\"]);\n    49\t    expect(result.status).toBe(1);\n    50\t    expect(JSON.parse(result.stdout)).toEqual({\n    51\t      ok: false,\n    52\t      error: {\n    53\t        errorClass: \"caller_error\",\n    54\t        code: \"thread_not_found\",\n    55\t        reason: \"no thread registered with id th_x\",\n    56\t      },\n    57\t    });\n    58\t  });\n    59\t\n    60\t  it(\"Story 1: new-thread → resolve round-trip through the spawned binary\", () => {\n    61\t    const dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-\"));\n    62\t    try {\n    63\t      const registryPath = path.join(dir, \"registry.sqlite\");\n    64\t      const threadPath = path.join(dir, \"thread.sqlite\");\n    65\t\n    66\t      const created = runBinary([\n    67\t        \"threads\",\n    68\t        \"new-thread\",\n    69\t        \"--file-path\",\n    70\t        threadPath,\n    71\t        \"--title\",\n    72\t        \"process suite\",\n    73\t        \"--registry\",\n    74\t        registryPath,\n    75\t      ]);\n    76\t      expect(created.status).toBe(0);\n    77\t      const createdParsed = JSON.parse(created.stdout) as {\n    78\t        ok: boolean;\n    79\t        value: { threadId: string; filePath: string };\n    80\t      };\n    81\t      expect(createdParsed.ok).toBe(true);\n    82\t      expect(createdParsed.value.filePath).toBe(threadPath);\n    83\t\n    84\t      const resolved = runBinary([\n    85\t        \"threads\",\n    86\t        \"resolve\",\n    87\t        \"--thread-id\",\n    88\t        createdParsed.value.threadId,\n    89\t        \"--registry\",\n    90\t        registryPath,\n    91\t      ]);\n    92\t      expect(resolved.status).toBe(0);\n    93\t      const resolvedParsed = JSON.parse(resolved.stdout) as {\n    94\t        ok: boolean;\n    95\t        value: { threadId: string; filePath: string; title?: string };\n    96\t      };\n    97\t      expect(resolvedParsed.ok).toBe(true);\n    98\t      expect(resolvedParsed.value.threadId).toBe(createdParsed.value.threadId);\n    99\t      expect(resolvedParsed.value.filePath).toBe(threadPath);\n   100\t      expect(resolvedParsed.value.title).toBe(\"process suite\");\n   101\t    } finally {\n   102\t      rmSync(dir, { recursive: true, force: true });\n   103\t    }\n   104\t  });\n   105\t});\n","exit_code":0,"status":"completed"}}

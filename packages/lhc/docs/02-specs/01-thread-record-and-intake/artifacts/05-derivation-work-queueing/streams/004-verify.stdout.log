{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/cli-process-work-queue.test.ts'","aggregated_output":"     1\t// CLI process-boundary suite for work queueing: the production-path proof\n     2\t// for `lhc turns list-queued-work` and the queuedWork half of the batch\n     3\t// result — a real conversation goes in through real stdin and the queued\n     4\t// work items come back as JSON through the spawned binary. Runs under\n     5\t// verify-all only.\n     6\timport { spawnSync } from \"node:child_process\";\n     7\timport { mkdtempSync, rmSync } from \"node:fs\";\n     8\timport { tmpdir } from \"node:os\";\n     9\timport path from \"node:path\";\n    10\timport { fileURLToPath } from \"node:url\";\n    11\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    12\timport type { BatchResult, WorkItemRecord } from \"../src/index.js\";\n    13\timport { validEvent } from \"./fixtures/index.js\";\n    14\t\n    15\tconst cliPath = path.resolve(\n    16\t  path.dirname(fileURLToPath(import.meta.url)),\n    17\t  \"../dist/cli.js\",\n    18\t);\n    19\t\n    20\tfunction runBinary(\n    21\t  args: string[],\n    22\t  input?: string,\n    23\t): { status: number | null; stdout: string; stderr: string } {\n    24\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    25\t    encoding: \"utf8\",\n    26\t    ...(input === undefined ? {} : { input }),\n    27\t  });\n    28\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    29\t}\n    30\t\n    31\tlet dir: string;\n    32\tlet threadPath: string;\n    33\tbeforeEach(() => {\n    34\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-work-\"));\n    35\t  threadPath = path.join(dir, \"thread.sqlite\");\n    36\t  const created = runBinary([\n    37\t    \"threads\",\n    38\t    \"new-thread\",\n    39\t    \"--file-path\",\n    40\t    threadPath,\n    41\t    \"--registry\",\n    42\t    path.join(dir, \"registry.sqlite\"),\n    43\t  ]);\n    44\t  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n    45\t});\n    46\tafterEach(() => {\n    47\t  rmSync(dir, { recursive: true, force: true });\n    48\t});\n    49\t\n    50\tdescribe(\"Story 5 (process boundary): queued work through the spawned binary\", () => {\n    51\t  it(\"a closed turn's work item reads back via turns list-queued-work\", () => {\n    52\t    const batch = [validEvent(\"user_prompt\"), validEvent(\"assistant_text\"), validEvent(\"turn_end\")];\n    53\t    const recorded = runBinary(\n    54\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n    55\t      JSON.stringify(batch),\n    56\t    );\n    57\t    expect(recorded.status).toBe(0);\n    58\t    const batchResult = JSON.parse(recorded.stdout) as { ok: boolean; value: BatchResult };\n    59\t    expect(batchResult.ok).toBe(true);\n    60\t    expect(batchResult.value.queuedWork).toContainEqual({\n    61\t      workItemId: \"w-t1-turn_derivation\",\n    62\t      owner: \"turns\",\n    63\t      kind: \"turn_derivation\",\n    64\t      sourceRef: { turnId: \"t1\" },\n    65\t    });\n    66\t\n    67\t    const listed = runBinary([\"turns\", \"list-queued-work\", \"--file-path\", threadPath]);\n    68\t    expect(listed.status).toBe(0);\n    69\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; value: WorkItemRecord[] };\n    70\t    expect(parsed.ok).toBe(true);\n    71\t    expect(parsed.value).toHaveLength(1);\n    72\t    expect(parsed.value[0]).toMatchObject({\n    73\t      workItemId: \"w-t1-turn_derivation\",\n    74\t      owner: \"turns\",\n    75\t      kind: \"turn_derivation\",\n    76\t      sourceRef: { turnId: \"t1\" },\n    77\t      status: \"queued\",\n    78\t    });\n    79\t  });\n    80\t});\n","exit_code":0,"status":"completed"}}

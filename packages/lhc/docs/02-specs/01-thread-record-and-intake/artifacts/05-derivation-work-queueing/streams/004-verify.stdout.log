{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport type { OperationContext } from \"../../shared/context.js\";\n     3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     4\timport {\n     5\t  listItems,\n     6\t  recordItem,\n     7\t  type WorkItemRecord,\n     8\t} from \"../../tech-utils/work-queue/index.js\";\n     9\timport type { EventKind } from \"../intake-stream/index.js\";\n    10\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    11\timport { transition } from \"./internal/state-machine.js\";\n    12\t\n    13\t// The pure rule table, re-exported for the golden supplemental suite (the\n    14\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    15\t// callers go through applyEvent.\n    16\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    17\timport {\n    18\t  closeTurn,\n    19\t  insertOpenTurn,\n    20\t  nextTurnOrder,\n    21\t  readTurns,\n    22\t  selectOpenTurnIds,\n    23\t} from \"./internal/store.js\";\n    24\t\n    25\texport interface TurnRecord {\n    26\t  turnId: string;\n    27\t  status: \"open\" | \"closed\";\n    28\t  memberMessageIds: string[];\n    29\t  openedAtEventOrder: number;\n    30\t  closedAtEventOrder?: number;\n    31\t}\n    32\t\n    33\texport interface TurnTransitionOutcome {\n    34\t  // Transitions in occurrence order: a close_then_open reports the close\n    35\t  // first, then the open, exactly as the batch result surfaces them.\n    36\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    37\t  // Turn state after the transition — the stamp for this event's message.\n    38\t  // Prompts see the turn they just opened (transition first, then stamp);\n    39\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    40\t  openTurnId: string | null;\n    41\t  // Work queued by this transition: one turn_derivation item per closed\n    42\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    43\t  queuedWork: WorkItemRecord[];\n    44\t}\n    45\t\n    46\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    47\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    48\t// writes turn state, so more than one open turn means external interference.\n    49\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    50\t  return selectOpenTurnIds(ctx.db);\n    51\t}\n    52\t\n    53\t// Closing a turn — by either close path — durably queues that turn's\n    54\t// derivation work in the same transaction (AC-3.6): the close update and the\n    55\t// work item commit or roll back together.\n    56\tfunction closeTurnAndQueueWork(\n    57\t  ctx: OperationContext,\n    58\t  turnId: string,\n    59\t  eventOrder: number,\n    60\t): WorkItemRecord {\n    61\t  closeTurn(ctx.db, turnId, eventOrder);\n    62\t  return recordItem(\n    63\t    ctx.db,\n    64\t    { owner: \"turns\", kind: \"turn_derivation\", sourceRef: { turnId } },\n    65\t    ctx.clock().toISOString(),\n    66\t  );\n    67\t}\n    68\t\n    69\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    70\t// for every recorded event. Synchronous and throwing by design, like\n    71\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n    72\texport function applyEvent(\n    73\t  ctx: OperationContext,\n    74\t  eventKind: EventKind,\n    75\t  eventOrder: number,\n    76\t): TurnTransitionOutcome {\n    77\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n    78\t  const effect = transition({ openTurnId }, eventKind);\n    79\t  switch (effect.kind) {\n    80\t    case \"none\":\n    81\t      return { transitions: [], openTurnId, queuedWork: [] };\n    82\t    case \"open\": {\n    83\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n    84\t      return {\n    85\t        transitions: [{ action: \"opened\", turnId }],\n    86\t        openTurnId: turnId,\n    87\t        queuedWork: [],\n    88\t      };\n    89\t    }\n    90\t    case \"close\": {\n    91\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n    92\t      return {\n    93\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n    94\t        openTurnId: null,\n    95\t        queuedWork: [item],\n    96\t      };\n    97\t    }\n    98\t    case \"close_then_open\": {\n    99\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   100\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   101\t      return {\n   102\t        transitions: [\n   103\t          { action: \"closed\", turnId: openTurnId as string },\n   104\t          { action: \"opened\", turnId },\n   105\t        ],\n   106\t        openTurnId: turnId,\n   107\t        queuedWork: [item],\n   108\t      };\n   109\t    }\n   110\t  }\n   111\t}\n   112\t\n   113\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   114\t  return {\n   115\t    ok: false,\n   116\t    error: {\n   117\t      errorClass: \"caller_error\",\n   118\t      code: \"thread_not_found\",\n   119\t      reason: `no thread file exists at ${filePath}`,\n   120\t    },\n   121\t  };\n   122\t}\n   123\t\n   124\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   125\t  const resolved = await resolveThreadRef(thread);\n   126\t  if (!resolved.ok) return resolved;\n   127\t  const { filePath } = resolved.value;\n   128\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   129\t\n   130\t  const opened = openThreadDatabase(filePath);\n   131\t  if (!opened.ok) return opened;\n   132\t  const db = opened.value;\n   133\t  try {\n   134\t    return { ok: true, value: readTurns(db) };\n   135\t  } catch (cause) {\n   136\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   137\t    return storageFailure(`turn read-back failed: ${reason}`);\n   138\t  } finally {\n   139\t    db.close();\n   140\t  }\n   141\t}\n   142\t\n   143\texport async function listQueuedWork(\n   144\t  thread: ThreadRef,\n   145\t): Promise<OpResult<WorkItemRecord[]>> {\n   146\t  const resolved = await resolveThreadRef(thread);\n   147\t  if (!resolved.ok) return resolved;\n   148\t  const { filePath } = resolved.value;\n   149\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   150\t\n   151\t  const opened = openThreadDatabase(filePath);\n   152\t  if (!opened.ok) return opened;\n   153\t  const db = opened.value;\n   154\t  try {\n   155\t    return { ok: true, value: listItems(db, \"turns\") };\n   156\t  } catch (cause) {\n   157\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   158\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   159\t  } finally {\n   160\t    db.close();\n   161\t  }\n   162\t}\n","exit_code":0,"status":"completed"}}

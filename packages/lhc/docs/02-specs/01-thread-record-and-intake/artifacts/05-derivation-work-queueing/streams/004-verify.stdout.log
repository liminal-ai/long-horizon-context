{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/smoke.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n     3\t\n     4\t// Story 1 made the threads commands real (test/threads.test.ts), Story 2 the\n     5\t// intake-stream commands (test/intake.test.ts), Story 3 messages list\n     6\t// (test/projection.test.ts), Story 4 turns list (test/turns.test.ts), and\n     7\t// Story 5 both list-queued-work commands (test/work-queue.test.ts); no\n     8\t// stubbed commands remain, so the Story 0 fail-closed-stub rail test retired\n     9\t// with its last entry.\n    10\t\n    11\tdescribe(\"FC-0.3: CLI rail\", () => {\n    12\t  it(\"responds to --help with usage for every planned command\", async () => {\n    13\t    const result = await runCli([\"--help\"]);\n    14\t    expect(result.exitCode).toBe(0);\n    15\t    expect(result.stdout).toContain(\"Usage:\");\n    16\t    for (const command of [\n    17\t      \"threads new-thread\",\n    18\t      \"threads resolve\",\n    19\t      \"threads list\",\n    20\t      \"intake-stream message-events\",\n    21\t      \"intake-stream list-events\",\n    22\t      \"messages list\",\n    23\t      \"messages list-queued-work\",\n    24\t      \"turns list\",\n    25\t      \"turns list-queued-work\",\n    26\t    ]) {\n    27\t      expect(result.stdout).toContain(command);\n    28\t    }\n    29\t  });\n    30\t\n    31\t  it(\"unknown commands exit non-zero with a structured error\", async () => {\n    32\t    const result = await runCli([\"frobnicate\", \"everything\"]);\n    33\t    expect(result.exitCode).toBe(1);\n    34\t    const parsed = JSON.parse(result.stdout) as {\n    35\t      ok: boolean;\n    36\t      error: { errorClass: string; code: string; reason: string };\n    37\t    };\n    38\t    expect(parsed.ok).toBe(false);\n    39\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    40\t    expect(parsed.error.code).toBe(\"unknown_command\");\n    41\t    expect(parsed.error.reason).toContain(\"frobnicate\");\n    42\t  });\n    43\t\n    44\t  it(\"no command at all exits non-zero with a structured error\", async () => {\n    45\t    const result = await runCli([]);\n    46\t    expect(result.exitCode).toBe(1);\n    47\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    48\t    expect(parsed.ok).toBe(false);\n    49\t  });\n    50\t});\n    51\t\n    52\tdescribe(\"FC-0.5: token counting\", () => {\n    53\t  it(\"pins the estimator identity\", () => {\n    54\t    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n    55\t  });\n    56\t\n    57\t  it(\"returns golden counts for known strings\", () => {\n    58\t    expect(estimateTokens(\"\")).toBe(0);\n    59\t    expect(estimateTokens(\"hello world\")).toBe(2);\n    60\t  });\n    61\t\n    62\t  it(\"same input, same count, every run\", () => {\n    63\t    const inputs = [\n    64\t      \"hello world\",\n    65\t      \"The quick brown fox jumps over the lazy dog.\",\n    66\t      \"tokens: émojis 🎉 and 中文 text\",\n    67\t      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n    68\t    ];\n    69\t    for (const input of inputs) {\n    70\t      const first = estimateTokens(input);\n    71\t      expect(first).toBeGreaterThan(0);\n    72\t      expect(estimateTokens(input)).toBe(first);\n    73\t      expect(estimateTokens(input)).toBe(first);\n    74\t    }\n    75\t  });\n    76\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/messages/internal/store.ts'","aggregated_output":"     1\t// Message and block row operations. Writes run on the caller's handle inside\n     2\t// the batch transaction (insert failures propagate so the pipeline rejects\n     3\t// the whole batch); reads run on a fresh handle per operation.\n     4\timport type { DatabaseSync } from \"node:sqlite\";\n     5\timport type { Block, MessageRecord } from \"../index.js\";\n     6\t\n     7\texport interface MessageRow {\n     8\t  messageId: string;\n     9\t  sourceEventOrder: number;\n    10\t  kind: MessageRecord[\"kind\"];\n    11\t  tokenEstimate: number;\n    12\t  actor: string;\n    13\t  harness: string;\n    14\t  // Membership stamp, settled at intake: the turn open after this event's\n    15\t  // transition, or null in a gap. Written once here, never updated — a null\n    16\t  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n    17\t  // change (AC-3.7).\n    18\t  turnId: string | null;\n    19\t  blocks: Block[];\n    20\t}\n    21\t\n    22\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n    23\t  db.prepare(\n    24\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n    25\t     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    26\t  ).run(\n    27\t    row.messageId,\n    28\t    row.sourceEventOrder,\n    29\t    row.kind,\n    30\t    row.tokenEstimate,\n    31\t    row.actor,\n    32\t    row.harness,\n    33\t    row.turnId,\n    34\t  );\n    35\t\n    36\t  const insertBlock = db.prepare(\n    37\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\n    38\t     VALUES (?, ?, ?, ?)`,\n    39\t  );\n    40\t  for (const [index, block] of row.blocks.entries()) {\n    41\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n    42\t  }\n    43\t}\n    44\t\n    45\tinterface RawMessageRow {\n    46\t  message_id: string;\n    47\t  source_event_order: number | bigint;\n    48\t  kind: string;\n    49\t  token_estimate: number | bigint;\n    50\t  actor: string;\n    51\t  harness: string;\n    52\t  turn_id: string | null;\n    53\t}\n    54\t\n    55\tinterface RawBlockRow {\n    56\t  message_id: string;\n    57\t  block_type: string;\n    58\t  content: string;\n    59\t}\n    60\t\n    61\texport function readMessages(db: DatabaseSync): MessageRecord[] {\n    62\t  const blockRows = db\n    63\t    .prepare(\n    64\t      `SELECT message_id, block_type, content FROM message_block\n    65\t       ORDER BY message_id, block_index`,\n    66\t    )\n    67\t    .all() as unknown as RawBlockRow[];\n    68\t  const blocksByMessage = new Map<string, Block[]>();\n    69\t  for (const row of blockRows) {\n    70\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n    71\t    blocks.push({\n    72\t      blockType: row.block_type as Block[\"blockType\"],\n    73\t      content: JSON.parse(row.content) as Record<string, unknown>,\n    74\t    });\n    75\t    blocksByMessage.set(row.message_id, blocks);\n    76\t  }\n    77\t\n    78\t  const messageRows = db\n    79\t    .prepare(\n    80\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n    81\t       FROM message ORDER BY source_event_order`,\n    82\t    )\n    83\t    .all() as unknown as RawMessageRow[];\n    84\t  return messageRows.map((row) => {\n    85\t    const record: MessageRecord = {\n    86\t      messageId: row.message_id,\n    87\t      sourceEventOrder: Number(row.source_event_order),\n    88\t      kind: row.kind as MessageRecord[\"kind\"],\n    89\t      blocks: blocksByMessage.get(row.message_id) ?? [],\n    90\t      tokenEstimate: Number(row.token_estimate),\n    91\t      actor: row.actor,\n    92\t      harness: row.harness,\n    93\t    };\n    94\t    if (row.turn_id !== null) record.turnId = row.turn_id;\n    95\t    return record;\n    96\t  });\n    97\t}\n","exit_code":0,"status":"completed"}}

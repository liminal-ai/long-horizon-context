{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/tech-utils/work-queue/index.ts'","aggregated_output":"     1\t// Durable work-item mechanics: recording and ordered listing, nothing else.\n     2\t// The util is domain-blind by the tech-arch capability rule — it knows the\n     3\t// item vocabulary (owner, kind, sourceRef) but nothing about what a turn or\n     4\t// a summary is; which kinds queue for which sources is the owning domains'\n     5\t// business. Writes run on the caller's handle inside the batch transaction,\n     6\t// so items commit (or roll back) with the batch. No public SDK surface:\n     7\t// read-back reaches here only through the owning domains' listQueuedWork.\n     8\timport type { DatabaseSync } from \"node:sqlite\";\n     9\t\n    10\texport type WorkOwner = \"messages\" | \"turns\";\n    11\texport type WorkKind = \"prompt_smoothing\" | \"tool_result_summary\" | \"turn_derivation\";\n    12\texport type WorkSourceRef = { messageId: string } | { turnId: string };\n    13\t\n    14\texport interface WorkItemRecord {\n    15\t  workItemId: string;\n    16\t  owner: WorkOwner;\n    17\t  kind: WorkKind;\n    18\t  sourceRef: WorkSourceRef;\n    19\t  status: \"queued\"; // the only status this epic writes\n    20\t  queuedAt: string;\n    21\t}\n    22\t\n    23\texport interface WorkItemInput {\n    24\t  owner: WorkOwner;\n    25\t  kind: WorkKind;\n    26\t  sourceRef: WorkSourceRef;\n    27\t}\n    28\t\n    29\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n    30\t  return \"messageId\" in sourceRef ? sourceRef.messageId : sourceRef.turnId;\n    31\t}\n    32\t\n    33\t// Deterministic id: re-queueing the same kind for the same source is the\n    34\t// same id — natural idempotency for Epic 02's repair path (design decision 7).\n    35\texport function recordItem(\n    36\t  db: DatabaseSync,\n    37\t  input: WorkItemInput,\n    38\t  queuedAt: string,\n    39\t): WorkItemRecord {\n    40\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}`;\n    41\t  db.prepare(\n    42\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n    43\t     VALUES (?, ?, ?, ?, 'queued', ?)`,\n    44\t  ).run(workItemId, input.owner, input.kind, JSON.stringify(input.sourceRef), queuedAt);\n    45\t  return {\n    46\t    workItemId,\n    47\t    owner: input.owner,\n    48\t    kind: input.kind,\n    49\t    sourceRef: input.sourceRef,\n    50\t    status: \"queued\",\n    51\t    queuedAt,\n    52\t  };\n    53\t}\n    54\t\n    55\tinterface RawWorkItemRow {\n    56\t  work_item_id: string;\n    57\t  owner: string;\n    58\t  kind: string;\n    59\t  source_ref: string;\n    60\t  queued_at: string;\n    61\t}\n    62\t\n    63\t// Listing in queue order (insertion order within the walk); each owning\n    64\t// domain lists only its own items.\n    65\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n    66\t  const rows = db\n    67\t    .prepare(\n    68\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n    69\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n    70\t    )\n    71\t    .all(owner) as unknown as RawWorkItemRow[];\n    72\t  return rows.map((row) => ({\n    73\t    workItemId: row.work_item_id,\n    74\t    owner: row.owner as WorkOwner,\n    75\t    kind: row.kind as WorkKind,\n    76\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n    77\t    status: \"queued\",\n    78\t    queuedAt: row.queued_at,\n    79\t  }));\n    80\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/messages/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport type { OperationContext } from \"../../shared/context.js\";\n     3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     4\timport {\n     5\t  listItems,\n     6\t  recordItem,\n     7\t  type WorkItemRecord,\n     8\t  type WorkKind,\n     9\t} from \"../../tech-utils/work-queue/index.js\";\n    10\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    11\timport {\n    12\t  openThreadDatabase,\n    13\t  resolveThreadRef,\n    14\t  type ThreadRef,\n    15\t} from \"../threads/index.js\";\n    16\timport { projectEvent } from \"./internal/project.js\";\n    17\timport { insertMessage, readMessages } from \"./internal/store.js\";\n    18\t\n    19\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    20\t\n    21\texport interface Block {\n    22\t  blockType: BlockType;\n    23\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    24\t}\n    25\t\n    26\texport interface MessageRecord {\n    27\t  messageId: string;\n    28\t  sourceEventOrder: number;\n    29\t  kind: Exclude<EventKind, \"turn_end\">;\n    30\t  blocks: Block[];\n    31\t  tokenEstimate: number;\n    32\t  actor: string;\n    33\t  harness: string;\n    34\t  turnId?: string;\n    35\t}\n    36\t\n    37\t// The event as the walk holds it after recording: the validated input plus\n    38\t// its server-stamped order and timestamp.\n    39\texport type RecordedEvent = EventRecord;\n    40\t\n    41\texport type MessageCreated = {\n    42\t  messageId: string;\n    43\t  kind: Exclude<EventKind, \"turn_end\">;\n    44\t} | null;\n    45\t\n    46\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    47\t// (the first such call through the operation context; turns.applyEvent\n    48\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    49\t// projection failure propagates to the pipeline's catch and rejects the\n    50\t// whole batch — recorded events without messages is the stranded state the\n    51\t// transaction exists to prevent. Returns null for turn_end (no message).\n    52\t// turnId is the membership stamp, settled by the pipeline before this call:\n    53\t// the turn open *after* this event's transition (so a prompt belongs to the\n    54\t// turn it just opened), or null in a gap — written once, never updated.\n    55\texport function createFromEvent(\n    56\t  ctx: OperationContext,\n    57\t  event: RecordedEvent,\n    58\t  turnId: string | null,\n    59\t): MessageCreated {\n    60\t  const projected = projectEvent(event);\n    61\t  if (projected === null) return null;\n    62\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    63\t  const messageId = `m${event.eventOrder}`;\n    64\t  insertMessage(ctx.db, {\n    65\t    messageId,\n    66\t    sourceEventOrder: event.eventOrder,\n    67\t    kind,\n    68\t    tokenEstimate: projected.tokenEstimate,\n    69\t    actor: event.actor,\n    70\t    harness: event.harness,\n    71\t    turnId,\n    72\t    blocks: projected.blocks,\n    73\t  });\n    74\t  return { messageId, kind };\n    75\t}\n    76\t\n    77\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n    78\t// result queues tool_result_summary, nothing else queues anything — text,\n    79\t// thinking, and note messages are not derivation sources (AC-2.8, AC-2.7's\n    80\t// TC-2.9 half). Cross-domain surface, called by intake-stream inside the\n    81\t// batch transaction for every recorded message, so the item commits (or\n    82\t// rolls back) with the batch.\n    83\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n    84\t  user_prompt: \"prompt_smoothing\",\n    85\t  tool_result: \"tool_result_summary\",\n    86\t};\n    87\t\n    88\texport function queueMessageWork(\n    89\t  ctx: OperationContext,\n    90\t  message: MessageCreated,\n    91\t): WorkItemRecord[] {\n    92\t  if (message === null) return [];\n    93\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n    94\t  if (kind === undefined) return [];\n    95\t  const item = recordItem(\n    96\t    ctx.db,\n    97\t    { owner: \"messages\", kind, sourceRef: { messageId: message.messageId } },\n    98\t    ctx.clock().toISOString(),\n    99\t  );\n   100\t  return [item];\n   101\t}\n   102\t\n   103\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   104\t  return {\n   105\t    ok: false,\n   106\t    error: {\n   107\t      errorClass: \"caller_error\",\n   108\t      code: \"thread_not_found\",\n   109\t      reason: `no thread file exists at ${filePath}`,\n   110\t    },\n   111\t  };\n   112\t}\n   113\t\n   114\texport async function listMessages(\n   115\t  thread: ThreadRef,\n   116\t): Promise<OpResult<MessageRecord[]>> {\n   117\t  const resolved = await resolveThreadRef(thread);\n   118\t  if (!resolved.ok) return resolved;\n   119\t  const { filePath } = resolved.value;\n   120\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   121\t\n   122\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   123\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   124\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   125\t  // unmutated (F-03-002).\n   126\t  const opened = openThreadDatabase(filePath);\n   127\t  if (!opened.ok) return opened;\n   128\t  const db = opened.value;\n   129\t  try {\n   130\t    return { ok: true, value: readMessages(db) };\n   131\t  } catch (cause) {\n   132\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   133\t    return storageFailure(`message read-back failed: ${reason}`);\n   134\t  } finally {\n   135\t    db.close();\n   136\t  }\n   137\t}\n   138\t\n   139\texport async function listQueuedWork(\n   140\t  thread: ThreadRef,\n   141\t): Promise<OpResult<WorkItemRecord[]>> {\n   142\t  const resolved = await resolveThreadRef(thread);\n   143\t  if (!resolved.ok) return resolved;\n   144\t  const { filePath } = resolved.value;\n   145\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   146\t\n   147\t  const opened = openThreadDatabase(filePath);\n   148\t  if (!opened.ok) return opened;\n   149\t  const db = opened.value;\n   150\t  try {\n   151\t    return { ok: true, value: listItems(db, \"messages\") };\n   152\t  } catch (cause) {\n   153\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   154\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   155\t  } finally {\n   156\t    db.close();\n   157\t  }\n   158\t}\n","exit_code":0,"status":"completed"}}

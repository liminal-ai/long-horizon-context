{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/threads/internal/create.ts'","aggregated_output":"     1\timport { randomBytes } from \"node:crypto\";\n     2\timport { rmSync } from \"node:fs\";\n     3\timport { DatabaseSync } from \"node:sqlite\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n     5\timport {\n     6\t  getSchemaVersion,\n     7\t  openDatabase,\n     8\t  runMigrations,\n     9\t  type Migration,\n    10\t} from \"../../../shared/storage.js\";\n    11\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n    12\t\n    13\t// The one random id: its uniqueness scope is global across files and\n    14\t// registries (design decision 7).\n    15\texport function generateThreadId(): string {\n    16\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n    17\t}\n    18\t\n    19\t// The thread-file schema as a versioned history, never rewritten in place:\n    20\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n    21\t// each later story appends a version. Existing files upgrade lazily through\n    22\t// openThreadDatabase, so a file recorded under an earlier story is always\n    23\t// usable by a later one (F-03-001).\n    24\t//\n    25\t// Creation-time metadata values are interpolated through buildThreadMigrations\n    26\t// for new files only; existing files already hold their metadata row and the\n    27\t// upgrade path never touches it.\n    28\tfunction buildThreadMigrations(\n    29\t  metadata?: { threadId: string; createdAt: string },\n    30\t): Migration[] {\n    31\t  const metadataInsert =\n    32\t    metadata === undefined\n    33\t      ? []\n    34\t      : [\n    35\t          // Interpolated values are all generated by us (hex id, ISO\n    36\t          // timestamp, estimator constant) — never caller input.\n    37\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n    38\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n    39\t        ];\n    40\t  return [\n    41\t    {\n    42\t      version: 1,\n    43\t      statements: [\n    44\t        `CREATE TABLE thread_metadata (\n    45\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n    46\t          thread_id TEXT NOT NULL,\n    47\t          created_at TEXT NOT NULL,\n    48\t          token_estimator TEXT NOT NULL\n    49\t        );`,\n    50\t        ...metadataInsert,\n    51\t        `CREATE TABLE event (\n    52\t          event_order INTEGER PRIMARY KEY,\n    53\t          event_kind TEXT NOT NULL,\n    54\t          idempotency_key TEXT NOT NULL UNIQUE,\n    55\t          actor TEXT NOT NULL,\n    56\t          harness TEXT NOT NULL,\n    57\t          payload TEXT NOT NULL,\n    58\t          recorded_at TEXT NOT NULL\n    59\t        );`,\n    60\t      ],\n    61\t    },\n    62\t    {\n    63\t      version: 2, // Story 3: message projection\n    64\t      statements: [\n    65\t        `CREATE TABLE message (\n    66\t          message_id TEXT PRIMARY KEY,\n    67\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n    68\t          kind TEXT NOT NULL,\n    69\t          token_estimate INTEGER NOT NULL,\n    70\t          actor TEXT NOT NULL,\n    71\t          harness TEXT NOT NULL,\n    72\t          turn_id TEXT\n    73\t        );`,\n    74\t        `CREATE TABLE message_block (\n    75\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n    76\t          block_index INTEGER NOT NULL,\n    77\t          block_type TEXT NOT NULL,\n    78\t          content TEXT NOT NULL,\n    79\t          PRIMARY KEY (message_id, block_index)\n    80\t        );`,\n    81\t      ],\n    82\t    },\n    83\t    {\n    84\t      version: 3, // Story 4: turn state machine\n    85\t      statements: [\n    86\t        `CREATE TABLE turns (\n    87\t          turn_id TEXT PRIMARY KEY,\n    88\t          turn_order INTEGER NOT NULL UNIQUE,\n    89\t          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n    90\t          opened_at_event_order INTEGER NOT NULL,\n    91\t          closed_at_event_order INTEGER\n    92\t        );`,\n    93\t      ],\n    94\t    },\n    95\t    {\n    96\t      version: 4, // Story 5: derivation work queueing\n    97\t      statements: [\n    98\t        // Work items live in the thread file and commit with the batch —\n    99\t        // not a separate database, not a separate transaction. status is\n   100\t        // unconstrained TEXT: this epic only ever writes 'queued'; the\n   101\t        // claim/lease statuses are Epic 02's to add.\n   102\t        `CREATE TABLE work_item (\n   103\t          work_item_id TEXT PRIMARY KEY,\n   104\t          owner TEXT NOT NULL,\n   105\t          kind TEXT NOT NULL,\n   106\t          source_ref TEXT NOT NULL,\n   107\t          status TEXT NOT NULL,\n   108\t          queued_at TEXT NOT NULL\n   109\t        );`,\n   110\t      ],\n   111\t    },\n   112\t  ];\n   113\t}\n   114\t\n   115\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n   116\t  return {\n   117\t    ok: false,\n   118\t    error: {\n   119\t      errorClass: \"caller_error\",\n   120\t      code: \"thread_not_found\",\n   121\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n   122\t    },\n   123\t  };\n   124\t}\n   125\t\n   126\tfunction errorDetail(cause: unknown): string {\n   127\t  return cause instanceof Error ? cause.message : String(cause);\n   128\t}\n   129\t\n   130\t// Identity check before any migration runs, on a read-only handle so an\n   131\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n   132\t// file always carries schema version >= 1 and the thread_metadata singleton\n   133\t// row that creation wrote transactionally. Anything else — an empty\n   134\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n   135\t// caller error, never adopted.\n   136\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n   137\t  let db: DatabaseSync | undefined;\n   138\t  try {\n   139\t    db = new DatabaseSync(filePath, { readOnly: true });\n   140\t    if (getSchemaVersion(db) < 1) {\n   141\t      return notAThreadFile(filePath, \"no lhc schema version\");\n   142\t    }\n   143\t    const table = db\n   144\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n   145\t      .get();\n   146\t    if (table === undefined) {\n   147\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n   148\t    }\n   149\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n   150\t    if (row === undefined) {\n   151\t      return notAThreadFile(filePath, \"no thread metadata row\");\n   152\t    }\n   153\t    return { ok: true };\n   154\t  } catch (cause) {\n   155\t    const detail = errorDetail(cause);\n   156\t    // SQLite refusing the file as a database is an identity failure, not an\n   157\t    // environment failure; everything else stays a system error.\n   158\t    if (detail.includes(\"not a database\")) {\n   159\t      return notAThreadFile(filePath, detail);\n   160\t    }\n   161\t    return storageFailure(`could not inspect thread file: ${detail}`);\n   162\t  } finally {\n   163\t    db?.close();\n   164\t  }\n   165\t}\n   166\t\n   167\t// Opens a thread file and brings its schema to the current version before\n   168\t// returning the handle. Every SDK operation on an existing thread file goes\n   169\t// through here, so a pre-Story-3 file gains the message tables on its first\n   170\t// open by newer code — but only after the file proves it is a thread file;\n   171\t// migration never creates lhc schema on an arbitrary existing file. Each\n   172\t// migration runs in its own transaction (storage helper), completing before\n   173\t// any caller transaction begins.\n   174\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n   175\t  const valid = validateThreadFile(filePath);\n   176\t  if (!valid.ok) return valid;\n   177\t  let db: DatabaseSync;\n   178\t  try {\n   179\t    db = openDatabase(filePath);\n   180\t  } catch (cause) {\n   181\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n   182\t  }\n   183\t  try {\n   184\t    runMigrations(db, buildThreadMigrations());\n   185\t  } catch (cause) {\n   186\t    db.close();\n   187\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n   188\t  }\n   189\t  return { ok: true, value: db };\n   190\t}\n   191\t\n   192\t// Schema v1 plus the metadata row land in one migration transaction, so the\n   193\t// file either has its full schema and metadata row or creation fails whole.\n   194\texport function createThreadFile(\n   195\t  filePath: string,\n   196\t  threadId: string,\n   197\t  createdAt: string,\n   198\t): void {\n   199\t  const db = openDatabase(filePath);\n   200\t  try {\n   201\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n   202\t  } finally {\n   203\t    db.close();\n   204\t  }\n   205\t}\n   206\t\n   207\t// Compensation: removes the thread file and its WAL companions. Used when the\n   208\t// registry insert fails after file creation (no registry row without its\n   209\t// file) and when file creation itself fails partway.\n   210\texport function deleteThreadFile(filePath: string): void {\n   211\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n   212\t    rmSync(`${filePath}${suffix}`, { force: true });\n   213\t  }\n   214\t}\n","exit_code":0,"status":"completed"}}

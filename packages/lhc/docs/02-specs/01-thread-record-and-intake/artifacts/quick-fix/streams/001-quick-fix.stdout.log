{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013PYYP2dhuxMR9o5k66zuiH","type":"tool_result","content":"1\t// CLI process-boundary suite: spawns the built dist/cli.js. Runs under\n2\t// verify-all only (needs a build artifact); plain verify announces the skip.\n3\timport { spawnSync } from \"node:child_process\";\n4\timport { existsSync } from \"node:fs\";\n5\timport path from \"node:path\";\n6\timport { fileURLToPath } from \"node:url\";\n7\timport { describe, expect, it } from \"vitest\";\n8\t\n9\tconst cliPath = path.resolve(\n10\t  path.dirname(fileURLToPath(import.meta.url)),\n11\t  \"../dist/cli.js\",\n12\t);\n13\t\n14\tfunction runBinary(args: string[]): {\n15\t  status: number | null;\n16\t  stdout: string;\n17\t  stderr: string;\n18\t} {\n19\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n20\t    encoding: \"utf8\",\n21\t  });\n22\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n23\t}\n24\t\n25\tdescribe(\"FC-0.3 (process boundary): built binary\", () => {\n26\t  it(\"dist/cli.js exists (build ran before this suite)\", () => {\n27\t    expect(existsSync(cliPath)).toBe(true);\n28\t  });\n29\t\n30\t  it(\"--help exits 0 with usage on stdout\", () => {\n31\t    const result = runBinary([\"--help\"]);\n32\t    expect(result.status).toBe(0);\n33\t    expect(result.stdout).toContain(\"Usage:\");\n34\t  });\n35\t\n36\t  it(\"unknown command exits 1 with structured JSON\", () => {\n37\t    const result = runBinary([\"nonsense\"]);\n38\t    expect(result.status).toBe(1);\n39\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n40\t    expect(parsed.ok).toBe(false);\n41\t  });\n42\t\n43\t  it(\"a planned command reaches its fail-closed stub through the real binary\", () => {\n44\t    const result = runBinary([\"threads\", \"list\"]);\n45\t    expect(result.status).toBe(1);\n46\t    expect(JSON.parse(result.stdout)).toEqual({\n47\t      ok: false,\n48\t      error: {\n49\t        errorClass: \"system_error\",\n50\t        code: \"storage_failure\",\n51\t        reason: \"not implemented: threads.list\",\n52\t      },\n53\t    });\n54\t  });\n55\t});\n56\t"}]},"parent_tool_use_id":null,"session_id":"7d47137f-cd86-4c15-bbf8-4a8dc794929e","uuid":"ca777910-75db-45e0-b07f-b6119e93ba8d","timestamp":"2026-06-10T12:33:47.287Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process.test.ts","content":"// CLI process-boundary suite: spawns the built dist/cli.js. Runs under\n// verify-all only (needs a build artifact); plain verify announces the skip.\nimport { spawnSync } from \"node:child_process\";\nimport { existsSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { describe, expect, it } from \"vitest\";\n\nconst cliPath = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  \"../dist/cli.js\",\n);\n\nfunction runBinary(args: string[]): {\n  status: number | null;\n  stdout: string;\n  stderr: string;\n} {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\ndescribe(\"FC-0.3 (process boundary): built binary\", () => {\n  it(\"dist/cli.js exists (build ran before this suite)\", () => {\n    expect(existsSync(cliPath)).toBe(true);\n  });\n\n  it(\"--help exits 0 with usage on stdout\", () => {\n    const result = runBinary([\"--help\"]);\n    expect(result.status).toBe(0);\n    expect(result.stdout).toContain(\"Usage:\");\n  });\n\n  it(\"unknown command exits 1 with structured JSON\", () => {\n    const result = runBinary([\"nonsense\"]);\n    expect(result.status).toBe(1);\n    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    expect(parsed.ok).toBe(false);\n  });\n\n  it(\"a planned command reaches its fail-closed stub through the real binary\", () => {\n    const result = runBinary([\"threads\", \"list\"]);\n    expect(result.status).toBe(1);\n    expect(JSON.parse(result.stdout)).toEqual({\n      ok: false,\n      error: {\n        errorClass: \"system_error\",\n        code: \"storage_failure\",\n        reason: \"not implemented: threads.list\",\n      },\n    });\n  });\n});\n","numLines":56,"startLine":1,"totalLines":56}}}

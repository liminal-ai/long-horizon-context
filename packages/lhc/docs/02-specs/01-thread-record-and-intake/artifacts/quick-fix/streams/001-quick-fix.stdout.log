{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EN9Pj4H4uHeUTPoQf6AoCJ","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Zero-dependency lint. ESLint installation was not available in this\n3\t// environment, so the lint gate enforces a minimal in-repo rule set:\n4\t//   - no `var` declarations\n5\t//   - no `any` escapes (`: any`, `as any`, `<any>`)\n6\t//   - no `console.` usage in src/ (CLI output flows through render/CliResult)\n7\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n8\timport path from \"node:path\";\n9\timport { fileURLToPath } from \"node:url\";\n10\t\n11\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n12\t\n13\tfunction collectTsFiles(dir, out = []) {\n14\t  let entries;\n15\t  try {\n16\t    entries = readdirSync(dir);\n17\t  } catch {\n18\t    return out;\n19\t  }\n20\t  for (const entry of entries) {\n21\t    const full = path.join(dir, entry);\n22\t    if (statSync(full).isDirectory()) collectTsFiles(full, out);\n23\t    else if (full.endsWith(\".ts\")) out.push(full);\n24\t  }\n25\t  return out;\n26\t}\n27\t\n28\tconst srcFiles = collectTsFiles(path.join(pkgRoot, \"src\"));\n29\tconst testFiles = collectTsFiles(path.join(pkgRoot, \"test\"));\n30\tconst problems = [];\n31\t\n32\tconst rules = [\n33\t  { re: /(?<![\\w$.])var\\s+[A-Za-z_$]/, message: \"no `var` declarations\", srcOnly: false },\n34\t  { re: /:\\s*any\\b|as\\s+any\\b|<any>/, message: \"no `any` escapes\", srcOnly: false },\n35\t  { re: /(?<![\\w$.])console\\./, message: \"no console usage in src/\", srcOnly: true },\n36\t];\n37\t\n38\tfor (const file of [...srcFiles, ...testFiles]) {\n39\t  const isSrc = srcFiles.includes(file);\n40\t  const lines = readFileSync(file, \"utf8\").split(\"\\n\");\n41\t  lines.forEach((line, i) => {\n42\t    const code = line.replace(/\\/\\/.*$/, \"\");\n43\t    for (const rule of rules) {\n44\t      if (rule.srcOnly && !isSrc) continue;\n45\t      if (rule.re.test(code)) {\n46\t        problems.push(`${path.relative(pkgRoot, file)}:${i + 1} ${rule.message}`);\n47\t      }\n48\t    }\n49\t  });\n50\t}\n51\t\n52\tif (problems.length > 0) {\n53\t  console.error(\"lint FAILED:\");\n54\t  for (const p of problems) console.error(`  - ${p}`);\n55\t  process.exit(1);\n56\t}\n57\tconsole.log(`lint: OK (${srcFiles.length + testFiles.length} files)`);\n58\t"}]},"parent_tool_use_id":null,"session_id":"7d47137f-cd86-4c15-bbf8-4a8dc794929e","uuid":"a2bfd134-7ce9-47b9-953b-48aceeef0675","timestamp":"2026-06-10T12:40:28.788Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/scripts/lint.mjs","content":"#!/usr/bin/env node\n// Zero-dependency lint. ESLint installation was not available in this\n// environment, so the lint gate enforces a minimal in-repo rule set:\n//   - no `var` declarations\n//   - no `any` escapes (`: any`, `as any`, `<any>`)\n//   - no `console.` usage in src/ (CLI output flows through render/CliResult)\nimport { readdirSync, readFileSync, statSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\nfunction collectTsFiles(dir, out = []) {\n  let entries;\n  try {\n    entries = readdirSync(dir);\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    const full = path.join(dir, entry);\n    if (statSync(full).isDirectory()) collectTsFiles(full, out);\n    else if (full.endsWith(\".ts\")) out.push(full);\n  }\n  return out;\n}\n\nconst srcFiles = collectTsFiles(path.join(pkgRoot, \"src\"));\nconst testFiles = collectTsFiles(path.join(pkgRoot, \"test\"));\nconst problems = [];\n\nconst rules = [\n  { re: /(?<![\\w$.])var\\s+[A-Za-z_$]/, message: \"no `var` declarations\", srcOnly: false },\n  { re: /:\\s*any\\b|as\\s+any\\b|<any>/, message: \"no `any` escapes\", srcOnly: false },\n  { re: /(?<![\\w$.])console\\./, message: \"no console usage in src/\", srcOnly: true },\n];\n\nfor (const file of [...srcFiles, ...testFiles]) {\n  const isSrc = srcFiles.includes(file);\n  const lines = readFileSync(file, \"utf8\").split(\"\\n\");\n  lines.forEach((line, i) => {\n    const code = line.replace(/\\/\\/.*$/, \"\");\n    for (const rule of rules) {\n      if (rule.srcOnly && !isSrc) continue;\n      if (rule.re.test(code)) {\n        problems.push(`${path.relative(pkgRoot, file)}:${i + 1} ${rule.message}`);\n      }\n    }\n  });\n}\n\nif (problems.length > 0) {\n  console.error(\"lint FAILED:\");\n  for (const p of problems) console.error(`  - ${p}`);\n  process.exit(1);\n}\nconsole.log(`lint: OK (${srcFiles.length + testFiles.length} files)`);\n","numLines":58,"startLine":1,"totalLines":58}}}

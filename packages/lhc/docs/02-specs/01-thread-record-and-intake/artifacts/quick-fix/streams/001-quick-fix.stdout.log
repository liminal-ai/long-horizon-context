{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018WRZkEBXrQ1F3jWqEvoSh6","type":"tool_result","content":"1\timport { describe, expect, it } from \"vitest\";\n2\timport { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n3\t\n4\tconst PLANNED_COMMANDS: ReadonlyArray<{ argv: string[]; op: string }> = [\n5\t  { argv: [\"threads\", \"new-thread\", \"--file-path\", \"/tmp/x.sqlite\"], op: \"threads.new-thread\" },\n6\t  { argv: [\"threads\", \"resolve\", \"--thread-id\", \"th_x\"], op: \"threads.resolve\" },\n7\t  { argv: [\"threads\", \"list\"], op: \"threads.list\" },\n8\t  { argv: [\"intake-stream\", \"message-events\", \"--thread-id\", \"th_x\"], op: \"intake-stream.message-events\" },\n9\t  { argv: [\"intake-stream\", \"list-events\", \"--file-path\", \"/tmp/x.sqlite\"], op: \"intake-stream.list-events\" },\n10\t  { argv: [\"messages\", \"list\", \"--thread-id\", \"th_x\"], op: \"messages.list\" },\n11\t  { argv: [\"messages\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"messages.list-queued-work\" },\n12\t  { argv: [\"turns\", \"list\", \"--thread-id\", \"th_x\"], op: \"turns.list\" },\n13\t  { argv: [\"turns\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"turns.list-queued-work\" },\n14\t];\n15\t\n16\tdescribe(\"FC-0.3: CLI rail\", () => {\n17\t  it(\"responds to --help with usage for every planned command\", async () => {\n18\t    const result = await runCli([\"--help\"]);\n19\t    expect(result.exitCode).toBe(0);\n20\t    expect(result.stdout).toContain(\"Usage:\");\n21\t    for (const command of [\n22\t      \"threads new-thread\",\n23\t      \"threads resolve\",\n24\t      \"threads list\",\n25\t      \"intake-stream message-events\",\n26\t      \"intake-stream list-events\",\n27\t      \"messages list\",\n28\t      \"messages list-queued-work\",\n29\t      \"turns list\",\n30\t      \"turns list-queued-work\",\n31\t    ]) {\n32\t      expect(result.stdout).toContain(command);\n33\t    }\n34\t  });\n35\t\n36\t  it(\"unknown commands exit non-zero with a structured error\", async () => {\n37\t    const result = await runCli([\"frobnicate\", \"everything\"]);\n38\t    expect(result.exitCode).toBe(1);\n39\t    const parsed = JSON.parse(result.stdout) as {\n40\t      ok: boolean;\n41\t      error: { errorClass: string; code: string; reason: string };\n42\t    };\n43\t    expect(parsed.ok).toBe(false);\n44\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n45\t    expect(parsed.error.code).toBe(\"unknown_command\");\n46\t    expect(parsed.error.reason).toContain(\"frobnicate\");\n47\t  });\n48\t\n49\t  it(\"no command at all exits non-zero with a structured error\", async () => {\n50\t    const result = await runCli([]);\n51\t    expect(result.exitCode).toBe(1);\n52\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n53\t    expect(parsed.ok).toBe(false);\n54\t  });\n55\t\n56\t  it(\"every planned command routes to a fail-closed stub with the exact stub error shape\", async () => {\n57\t    for (const { argv, op } of PLANNED_COMMANDS) {\n58\t      const result = await runCli(argv);\n59\t      expect(result.exitCode, `exit code for: ${argv.join(\" \")}`).toBe(1);\n60\t      const parsed = JSON.parse(result.stdout) as unknown;\n61\t      expect(parsed, `stub shape for: ${argv.join(\" \")}`).toEqual({\n62\t        ok: false,\n63\t        error: {\n64\t          errorClass: \"system_error\",\n65\t          code: \"storage_failure\",\n66\t          reason: `not implemented: ${op}`,\n67\t        },\n68\t      });\n69\t    }\n70\t  });\n71\t});\n72\t\n73\tdescribe(\"FC-0.5: token counting\", () => {\n74\t  it(\"pins the estimator identity\", () => {\n75\t    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n76\t  });\n77\t\n78\t  it(\"returns golden counts for known strings\", () => {\n79\t    expect(estimateTokens(\"\")).toBe(0);\n80\t    expect(estimateTokens(\"hello world\")).toBe(2);\n81\t  });\n82\t\n83\t  it(\"same input, same count, every run\", () => {\n84\t    const inputs = [\n85\t      \"hello world\",\n86\t      \"The quick brown fox jumps over the lazy dog.\",\n87\t      \"tokens: émojis 🎉 and 中文 text\",\n88\t      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n89\t    ];\n90\t    for (const input of inputs) {\n91\t      const first = estimateTokens(input);\n92\t      expect(first).toBeGreaterThan(0);\n93\t      expect(estimateTokens(input)).toBe(first);\n94\t      expect(estimateTokens(input)).toBe(first);\n95\t    }\n96\t  });\n97\t});\n98\t"}]},"parent_tool_use_id":null,"session_id":"7d47137f-cd86-4c15-bbf8-4a8dc794929e","uuid":"22a20dc3-9750-4b98-9390-b7b48b4c19d3","timestamp":"2026-06-10T12:33:47.017Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/smoke.test.ts","content":"import { describe, expect, it } from \"vitest\";\nimport { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n\nconst PLANNED_COMMANDS: ReadonlyArray<{ argv: string[]; op: string }> = [\n  { argv: [\"threads\", \"new-thread\", \"--file-path\", \"/tmp/x.sqlite\"], op: \"threads.new-thread\" },\n  { argv: [\"threads\", \"resolve\", \"--thread-id\", \"th_x\"], op: \"threads.resolve\" },\n  { argv: [\"threads\", \"list\"], op: \"threads.list\" },\n  { argv: [\"intake-stream\", \"message-events\", \"--thread-id\", \"th_x\"], op: \"intake-stream.message-events\" },\n  { argv: [\"intake-stream\", \"list-events\", \"--file-path\", \"/tmp/x.sqlite\"], op: \"intake-stream.list-events\" },\n  { argv: [\"messages\", \"list\", \"--thread-id\", \"th_x\"], op: \"messages.list\" },\n  { argv: [\"messages\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"messages.list-queued-work\" },\n  { argv: [\"turns\", \"list\", \"--thread-id\", \"th_x\"], op: \"turns.list\" },\n  { argv: [\"turns\", \"list-queued-work\", \"--thread-id\", \"th_x\"], op: \"turns.list-queued-work\" },\n];\n\ndescribe(\"FC-0.3: CLI rail\", () => {\n  it(\"responds to --help with usage for every planned command\", async () => {\n    const result = await runCli([\"--help\"]);\n    expect(result.exitCode).toBe(0);\n    expect(result.stdout).toContain(\"Usage:\");\n    for (const command of [\n      \"threads new-thread\",\n      \"threads resolve\",\n      \"threads list\",\n      \"intake-stream message-events\",\n      \"intake-stream list-events\",\n      \"messages list\",\n      \"messages list-queued-work\",\n      \"turns list\",\n      \"turns list-queued-work\",\n    ]) {\n      expect(result.stdout).toContain(command);\n    }\n  });\n\n  it(\"unknown commands exit non-zero with a structured error\", async () => {\n    const result = await runCli([\"frobnicate\", \"everything\"]);\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string; reason: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"unknown_command\");\n    expect(parsed.error.reason).toContain(\"frobnicate\");\n  });\n\n  it(\"no command at all exits non-zero with a structured error\", async () => {\n    const result = await runCli([]);\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    expect(parsed.ok).toBe(false);\n  });\n\n  it(\"every planned command routes to a fail-closed stub with the exact stub error shape\", async () => {\n    for (const { argv, op } of PLANNED_COMMANDS) {\n      const result = await runCli(argv);\n      expect(result.exitCode, `exit code for: ${argv.join(\" \")}`).toBe(1);\n      const parsed = JSON.parse(result.stdout) as unknown;\n      expect(parsed, `stub shape for: ${argv.join(\" \")}`).toEqual({\n        ok: false,\n        error: {\n          errorClass: \"system_error\",\n          code: \"storage_failure\",\n          reason: `not implemented: ${op}`,\n        },\n      });\n    }\n  });\n});\n\ndescribe(\"FC-0.5: token counting\", () => {\n  it(\"pins the estimator identity\", () => {\n    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n  });\n\n  it(\"returns golden counts for known strings\", () => {\n    expect(estimateTokens(\"\")).toBe(0);\n    expect(estimateTokens(\"hello world\")).toBe(2);\n  });\n\n  it(\"same input, same count, every run\", () => {\n    const inputs = [\n      \"hello world\",\n      \"The quick brown fox jumps over the lazy dog.\",\n      \"tokens: émojis 🎉 and 中文 text\",\n      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n    ];\n    for (const input of inputs) {\n      const first = estimateTokens(input);\n      expect(first).toBeGreaterThan(0);\n      expect(estimateTokens(input)).toBe(first);\n      expect(estimateTokens(input)).toBe(first);\n    }\n  });\n});\n","numLines":98,"startLine":1,"totalLines":98}}}

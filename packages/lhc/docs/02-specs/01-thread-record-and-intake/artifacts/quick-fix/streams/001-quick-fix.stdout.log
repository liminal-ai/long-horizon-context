nds: readonly EventKind[]): MessageEventInput[] {\n51\t  return kinds.map((kind) => validEvent(kind));\n52\t}\n53\t\n54\texport function conversationTurn(): MessageEventInput[] {\n55\t  return eventBatch([\n56\t    \"user_prompt\",\n57\t    \"assistant_text\",\n58\t    \"tool_call\",\n59\t    \"tool_result\",\n60\t    \"turn_end\",\n61\t  ]);\n62\t}\n63\t\n64\texport interface TempStore {\n65\t  dir: string;\n66\t  registryPath: string;\n67\t  threadPath: (name?: string) => string;\n68\t  cleanup: () => void;\n69\t}\n70\t\n71\texport function tempStore(): TempStore {\n72\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n73\t  let threadCounter = 0;\n74\t  return {\n75\t    dir,\n76\t    registryPath: join(dir, \"registry.sqlite\"),\n77\t    threadPath: (name) => {\n78\t      threadCounter += 1;\n79\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n80\t    },\n81\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n82\t  };\n83\t}\n84\t\n85\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n86\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n87\texport function openRaw(path: string): DatabaseSync {\n88\t  return new DatabaseSync(path);\n89\t}\n90\t\n91\texport { corruptTwoOpenTurns } from \"./corrupt.js\";\n92\t"}]},"parent_tool_use_id":null,"session_id":"7d47137f-cd86-4c15-bbf8-4a8dc794929e","uuid":"08b37cb6-3215-4354-bd40-ef090438fc26","timestamp":"2026-06-10T12:31:23.356Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/index.ts","content":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n\nexport type EventByKind<K extends EventKind> = Extract<\n  MessageEventInput,\n  { eventKind: K }\n>;\n\nlet keyCounter = 0;\n\nconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n  user_prompt: () => ({ text: \"please read the file\" }),\n  assistant_text: () => ({ text: \"here is what I found\" }),\n  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n  tool_call: () => ({\n    toolCallId: \"call-1\",\n    toolName: \"read_file\",\n    arguments: { path: \"notes.txt\" },\n  }),\n  tool_result: () => ({\n    toolCallId: \"call-1\",\n    content: \"contents of notes.txt\",\n    isError: false,\n  }),\n  turn_end: () => ({}),\n};\n\n// Returns the discriminated MessageEventInput member for its kind, so a\n// kind/payload mismatch in test code is a compile error — building an invalid\n// pairing requires an explicit cast at the call site.\nexport function validEvent<K extends EventKind>(\n  kind: K,\n  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n): EventByKind<K> {\n  keyCounter += 1;\n  const base = {\n    eventKind: kind,\n    idempotencyKey: `fixture-key-${keyCounter}`,\n    actor: \"fixture-actor\",\n    harness: \"fixture-harness\",\n    payload: defaultPayloads[kind](),\n  };\n  return { ...base, ...overrides } as EventByKind<K>;\n}\n\nexport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n  return kinds.map((kind) => validEvent(kind));\n}\n\nexport function conversationTurn(): MessageEventInput[] {\n  return eventBatch([\n    \"user_prompt\",\n    \"assistant_text\",\n    \"tool_call\",\n    \"tool_result\",\n    \"turn_end\",\n  ]);\n}\n\nexport interface TempStore {\n  dir: string;\n  registryPath: string;\n  threadPath: (name?: string) => string;\n  cleanup: () => void;\n}\n\nexport function tempStore(): TempStore {\n  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n  let threadCounter = 0;\n  return {\n    dir,\n    registryPath: join(dir, \"registry.sqlite\"),\n    threadPath: (name) => {\n      threadCounter += 1;\n      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    },\n    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n  };\n}\n\n// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n// convention; fixtures/corrupt.ts is the one sanctioned writer.\nexport function openRaw(path: string): DatabaseSync {\n  return new DatabaseSync(path);\n}\n\nexport { corruptTwoOpenTurns } from \"./corrupt.js\";\n","numLines":92,"startLine":1,"totalLines":92}}}

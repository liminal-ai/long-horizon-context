{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QKdLdPStjvTvgTdi6Lq9Uc","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { ThreadRef } from \"../domains/threads/index.js\";\n7\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n8\t\n9\tconst HELP = `lhc — Long Horizon Context CLI\n10\t\n11\tUsage:\n12\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n13\t  lhc threads resolve --thread-id <id> [--registry <r>]\n14\t  lhc threads list [--registry <r>]\n15\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n16\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n17\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n18\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n19\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n20\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n21\t\n22\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n23\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n24\t`;\n25\t\n26\tinterface ParsedFlags {\n27\t  threadId?: string;\n28\t  filePath?: string;\n29\t  title?: string;\n30\t  registryPath?: string;\n31\t}\n32\t\n33\tfunction parseFlags(args: readonly string[]): ParsedFlags {\n34\t  const { values } = parseArgs({\n35\t    args: [...args],\n36\t    options: {\n37\t      \"thread-id\": { type: \"string\" },\n38\t      \"file-path\": { type: \"string\" },\n39\t      title: { type: \"string\" },\n40\t      registry: { type: \"string\" },\n41\t    },\n42\t    strict: false,\n43\t    allowPositionals: true,\n44\t  });\n45\t  const flags: ParsedFlags = {};\n46\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n47\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n48\t  if (typeof values.title === \"string\") flags.title = values.title;\n49\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n50\t  return flags;\n51\t}\n52\t\n53\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n54\t  if (flags.threadId !== undefined) {\n55\t    return flags.registryPath !== undefined\n56\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n57\t      : { threadId: flags.threadId };\n58\t  }\n59\t  return { filePath: flags.filePath ?? \"\" };\n60\t}\n61\t\n62\texport async function runCli(argv: readonly string[]): Promise<CliResult> {\n63\t  if (argv.length === 0) {\n64\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n65\t  }\n66\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n67\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n68\t  }\n69\t\n70\t  const [group, command, ...rest] = argv;\n71\t  const key = command === undefined ? group : `${group} ${command}`;\n72\t  const flags = parseFlags(command === undefined ? [] : rest);\n73\t\n74\t  switch (key) {\n75\t    case \"threads new-thread\": {\n76\t      const input: Parameters<typeof threads.newThread>[0] = {\n77\t        filePath: flags.filePath ?? \"\",\n78\t      };\n79\t      if (flags.title !== undefined) input.title = flags.title;\n80\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n81\t      return renderResult(await threads.newThread(input));\n82\t    }\n83\t    case \"threads resolve\": {\n84\t      const input: Parameters<typeof threads.resolve>[0] = {\n85\t        threadId: flags.threadId ?? \"\",\n86\t      };\n87\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n88\t      return renderResult(await threads.resolve(input));\n89\t    }\n90\t    case \"threads list\": {\n91\t      return renderResult(\n92\t        await threads.listThreads(\n93\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n94\t        ),\n95\t      );\n96\t    }\n97\t    case \"intake-stream message-events\":\n98\t      return renderResult(await intakeStream.messageEvents(threadRefFrom(flags), []));\n99\t    case \"intake-stream list-events\":\n100\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n101\t    case \"messages list\":\n102\t      return renderResult(await messages.listMessages(threadRefFrom(flags)));\n103\t    case \"messages list-queued-work\":\n104\t      return renderResult(await messages.listQueuedWork(threadRefFrom(flags)));\n105\t    case \"turns list\":\n106\t      return renderResult(await turns.listTurns(threadRefFrom(flags)));\n107\t    case \"turns list-queued-work\":\n108\t      return renderResult(await turns.listQueuedWork(threadRefFrom(flags)));\n109\t    default:\n110\t      return renderCliError(\n111\t        \"caller_error\",\n112\t        \"unknown_command\",\n113\t        `unknown command: ${key}; run lhc --help`,\n114\t      );\n115\t  }\n116\t}\n117\t"}]},"parent_tool_use_id":null,"session_id":"7d47137f-cd86-4c15-bbf8-4a8dc794929e","uuid":"bc9542ca-068d-4037-b80e-ac09627fe5c1","timestamp":"2026-06-10T12:32:25.203Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/index.ts","content":"import { parseArgs } from \"node:util\";\nimport * as intakeStream from \"../domains/intake-stream/index.js\";\nimport * as messages from \"../domains/messages/index.js\";\nimport * as threads from \"../domains/threads/index.js\";\nimport * as turns from \"../domains/turns/index.js\";\nimport type { ThreadRef } from \"../domains/threads/index.js\";\nimport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n\nconst HELP = `lhc — Long Horizon Context CLI\n\nUsage:\n  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n  lhc threads resolve --thread-id <id> [--registry <r>]\n  lhc threads list [--registry <r>]\n  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n\nEvery command prints the SDK result (value or error) as JSON and exits 0 on\nsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n`;\n\ninterface ParsedFlags {\n  threadId?: string;\n  filePath?: string;\n  title?: string;\n  registryPath?: string;\n}\n\nfunction parseFlags(args: readonly string[]): ParsedFlags {\n  const { values } = parseArgs({\n    args: [...args],\n    options: {\n      \"thread-id\": { type: \"string\" },\n      \"file-path\": { type: \"string\" },\n      title: { type: \"string\" },\n      registry: { type: \"string\" },\n    },\n    strict: false,\n    allowPositionals: true,\n  });\n  const flags: ParsedFlags = {};\n  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n  if (typeof values.title === \"string\") flags.title = values.title;\n  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n  return flags;\n}\n\nfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n  if (flags.threadId !== undefined) {\n    return flags.registryPath !== undefined\n      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n      : { threadId: flags.threadId };\n  }\n  return { filePath: flags.filePath ?? \"\" };\n}\n\nexport async function runCli(argv: readonly string[]): Promise<CliResult> {\n  if (argv.length === 0) {\n    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n  }\n  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n  }\n\n  const [group, command, ...rest] = argv;\n  const key = command === undefined ? group : `${group} ${command}`;\n  const flags = parseFlags(command === undefined ? [] : rest);\n\n  switch (key) {\n    case \"threads new-thread\": {\n      const input: Parameters<typeof threads.newThread>[0] = {\n        filePath: flags.filePath ?? \"\",\n      };\n      if (flags.title !== undefined) input.title = flags.title;\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.newThread(input));\n    }\n    case \"threads resolve\": {\n      const input: Parameters<typeof threads.resolve>[0] = {\n        threadId: flags.threadId ?? \"\",\n      };\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.resolve(input));\n    }\n    case \"threads list\": {\n      return renderResult(\n        await threads.listThreads(\n          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n        ),\n      );\n    }\n    case \"intake-stream message-events\":\n      return renderResult(await intakeStream.messageEvents(threadRefFrom(flags), []));\n    case \"intake-stream list-events\":\n      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n    case \"messages list\":\n      return renderResult(await messages.listMessages(threadRefFrom(flags)));\n    case \"messages list-queued-work\":\n      return renderResult(await messages.listQueuedWork(threadRefFrom(flags)));\n    case \"turns list\":\n      return renderResult(await turns.listTurns(threadRefFrom(flags)));\n    case \"turns list-queued-work\":\n      return renderResult(await turns.listQueuedWork(threadRefFrom(flags)));\n    default:\n      return renderCliError(\n        \"caller_error\",\n        \"unknown_command\",\n        `unknown command: ${key}; run lhc --help`,\n      );\n  }\n}\n","numLines":117,"startLine":1,"totalLines":117}}}

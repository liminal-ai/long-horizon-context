{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P3tW7ZFea68Q9EXZ1j8QBa","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { describe, expect, it } from \"vitest\";\n3\timport type { EventKind } from \"../src/index.js\";\n4\timport {\n5\t  conversationTurn,\n6\t  eventBatch,\n7\t  openRaw,\n8\t  tempStore,\n9\t  validEvent,\n10\t} from \"./fixtures/index.js\";\n11\t\n12\tconst ALL_KINDS: readonly EventKind[] = [\n13\t  \"user_prompt\",\n14\t  \"assistant_text\",\n15\t  \"assistant_thinking\",\n16\t  \"runtime_note\",\n17\t  \"tool_call\",\n18\t  \"tool_result\",\n19\t  \"turn_end\",\n20\t];\n21\t\n22\tconst GOLDEN_PAYLOAD_KEYS: Record<EventKind, string[]> = {\n23\t  user_prompt: [\"text\"],\n24\t  assistant_text: [\"text\"],\n25\t  assistant_thinking: [\"text\"],\n26\t  runtime_note: [\"text\"],\n27\t  tool_call: [\"toolCallId\", \"toolName\", \"arguments\"],\n28\t  tool_result: [\"toolCallId\", \"content\", \"isError\"],\n29\t  turn_end: [],\n30\t};\n31\t\n32\tdescribe(\"FC-0.4: fixture builders\", () => {\n33\t  it(\"validEvent produces a golden-shaped event for every kind\", () => {\n34\t    for (const kind of ALL_KINDS) {\n35\t      const event = validEvent(kind);\n36\t      expect(event.eventKind).toBe(kind);\n37\t      expect(event.idempotencyKey.length).toBeGreaterThan(0);\n38\t      expect(event.actor.length).toBeGreaterThan(0);\n39\t      expect(event.harness.length).toBeGreaterThan(0);\n40\t      expect(Object.keys(event.payload).sort()).toEqual(\n41\t        [...GOLDEN_PAYLOAD_KEYS[kind]].sort(),\n42\t      );\n43\t      expect(Object.keys(event).sort()).toEqual(\n44\t        [\"actor\", \"eventKind\", \"harness\", \"idempotencyKey\", \"payload\"].sort(),\n45\t      );\n46\t    }\n47\t  });\n48\t\n49\t  it(\"validEvent applies overrides without changing the kind\", () => {\n50\t    const event = validEvent(\"user_prompt\", {\n51\t      actor: \"custom-actor\",\n52\t      payload: { text: \"custom prompt\" },\n53\t    });\n54\t    expect(event.eventKind).toBe(\"user_prompt\");\n55\t    expect(event.actor).toBe(\"custom-actor\");\n56\t    expect(event.payload.text).toBe(\"custom prompt\");\n57\t  });\n58\t\n59\t  it(\"building an invalid kind/payload pairing requires an explicit cast\", () => {\n60\t    // @ts-expect-error — a tool_call payload on a user_prompt event must not compile\n61\t    const forced = validEvent(\"user_prompt\", {\n62\t      payload: { toolCallId: \"x\", toolName: \"y\", arguments: {} },\n63\t    });\n64\t    expect(forced.eventKind).toBe(\"user_prompt\");\n65\t  });\n66\t\n67\t  it(\"eventBatch yields unique idempotency keys in order\", () => {\n68\t    const batch = eventBatch(ALL_KINDS);\n69\t    expect(batch.map((e) => e.eventKind)).toEqual([...ALL_KINDS]);\n70\t    const keys = new Set(batch.map((e) => e.idempotencyKey));\n71\t    expect(keys.size).toBe(batch.length);\n72\t  });\n73\t\n74\t  it(\"conversationTurn is one complete turn\", () => {\n75\t    expect(conversationTurn().map((e) => e.eventKind)).toEqual([\n76\t      \"user_prompt\",\n77\t      \"assistant_text\",\n78\t      \"tool_call\",\n79\t      \"tool_result\",\n80\t      \"turn_end\",\n81\t    ]);\n82\t  });\n83\t\n84\t  it(\"tempStore creates an isolated directory and cleans it up\", () => {\n85\t    const store = tempStore();\n86\t    expect(existsSync(store.dir)).toBe(true);\n87\t    expect(store.registryPath.startsWith(store.dir)).toBe(true);\n88\t    const a = store.threadPath();\n89\t    const b = store.threadPath();\n90\t    expect(a).not.toBe(b);\n91\t    store.cleanup();\n92\t    expect(existsSync(store.dir)).toBe(false);\n93\t  });\n94\t\n95\t  it(\"openRaw opens a real sqlite handle for below-SDK assertions\", () => {\n96\t    const store = tempStore();\n97\t    const path = store.threadPath(\"raw\");\n98\t    const writer = openRaw(path);\n99\t    writer.exec(\"CREATE TABLE probe (id INTEGER PRIMARY KEY, note TEXT)\");\n100\t    writer.exec(\"INSERT INTO probe (note) VALUES ('hello')\");\n101\t    writer.close();\n102\t    const reader = openRaw(path);\n103\t    const row = reader.prepare(\"SELECT note FROM probe WHERE id = 1\").get() as\n104\t      | { note: string }\n105\t      | undefined;\n106\t    expect(row?.note).toBe(\"hello\");\n107\t    reader.close();\n108\t    store.cleanup();\n109\t  });\n110\t});\n111\t"}]},"parent_tool_use_id":null,"session_id":"7d47137f-cd86-4c15-bbf8-4a8dc794929e","uuid":"ef3a5d95-0a81-4eab-8f09-e1331a331bb8","timestamp":"2026-06-10T12:31:22.873Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures.test.ts","content":"import { existsSync } from \"node:fs\";\nimport { describe, expect, it } from \"vitest\";\nimport type { EventKind } from \"../src/index.js\";\nimport {\n  conversationTurn,\n  eventBatch,\n  openRaw,\n  tempStore,\n  validEvent,\n} from \"./fixtures/index.js\";\n\nconst ALL_KINDS: readonly EventKind[] = [\n  \"user_prompt\",\n  \"assistant_text\",\n  \"assistant_thinking\",\n  \"runtime_note\",\n  \"tool_call\",\n  \"tool_result\",\n  \"turn_end\",\n];\n\nconst GOLDEN_PAYLOAD_KEYS: Record<EventKind, string[]> = {\n  user_prompt: [\"text\"],\n  assistant_text: [\"text\"],\n  assistant_thinking: [\"text\"],\n  runtime_note: [\"text\"],\n  tool_call: [\"toolCallId\", \"toolName\", \"arguments\"],\n  tool_result: [\"toolCallId\", \"content\", \"isError\"],\n  turn_end: [],\n};\n\ndescribe(\"FC-0.4: fixture builders\", () => {\n  it(\"validEvent produces a golden-shaped event for every kind\", () => {\n    for (const kind of ALL_KINDS) {\n      const event = validEvent(kind);\n      expect(event.eventKind).toBe(kind);\n      expect(event.idempotencyKey.length).toBeGreaterThan(0);\n      expect(event.actor.length).toBeGreaterThan(0);\n      expect(event.harness.length).toBeGreaterThan(0);\n      expect(Object.keys(event.payload).sort()).toEqual(\n        [...GOLDEN_PAYLOAD_KEYS[kind]].sort(),\n      );\n      expect(Object.keys(event).sort()).toEqual(\n        [\"actor\", \"eventKind\", \"harness\", \"idempotencyKey\", \"payload\"].sort(),\n      );\n    }\n  });\n\n  it(\"validEvent applies overrides without changing the kind\", () => {\n    const event = validEvent(\"user_prompt\", {\n      actor: \"custom-actor\",\n      payload: { text: \"custom prompt\" },\n    });\n    expect(event.eventKind).toBe(\"user_prompt\");\n    expect(event.actor).toBe(\"custom-actor\");\n    expect(event.payload.text).toBe(\"custom prompt\");\n  });\n\n  it(\"building an invalid kind/payload pairing requires an explicit cast\", () => {\n    // @ts-expect-error — a tool_call payload on a user_prompt event must not compile\n    const forced = validEvent(\"user_prompt\", {\n      payload: { toolCallId: \"x\", toolName: \"y\", arguments: {} },\n    });\n    expect(forced.eventKind).toBe(\"user_prompt\");\n  });\n\n  it(\"eventBatch yields unique idempotency keys in order\", () => {\n    const batch = eventBatch(ALL_KINDS);\n    expect(batch.map((e) => e.eventKind)).toEqual([...ALL_KINDS]);\n    const keys = new Set(batch.map((e) => e.idempotencyKey));\n    expect(keys.size).toBe(batch.length);\n  });\n\n  it(\"conversationTurn is one complete turn\", () => {\n    expect(conversationTurn().map((e) => e.eventKind)).toEqual([\n      \"user_prompt\",\n      \"assistant_text\",\n      \"tool_call\",\n      \"tool_result\",\n      \"turn_end\",\n    ]);\n  });\n\n  it(\"tempStore creates an isolated directory and cleans it up\", () => {\n    const store = tempStore();\n    expect(existsSync(store.dir)).toBe(true);\n    expect(store.registryPath.startsWith(store.dir)).toBe(true);\n    const a = store.threadPath();\n    const b = store.threadPath();\n    expect(a).not.toBe(b);\n    store.cleanup();\n    expect(existsSync(store.dir)).toBe(false);\n  });\n\n  it(\"openRaw opens a real sqlite handle for below-SDK assertions\", () => {\n    const store = tempStore();\n    const path = store.threadPath(\"raw\");\n    const writer = openRaw(path);\n    writer.exec(\"CREATE TABLE probe (id INTEGER PRIMARY KEY, note TEXT)\");\n    writer.exec(\"INSERT INTO probe (note) VALUES ('hello')\");\n    writer.close();\n    const reader = openRaw(path);\n    const row = reader.prepare(\"SELECT note FROM probe WHERE id = 1\").get() as\n      | { note: string }\n      | undefined;\n    expect(row?.note).toBe(\"hello\");\n    reader.close();\n    store.cleanup();\n  });\n});\n","numLines":111,"startLine":1,"totalLines":111}}}

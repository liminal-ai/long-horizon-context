{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts | sed -n '1,230p'\"","aggregated_output":"     1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n     2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n     3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n     4\t// Stories 3–5 extend the same per-event walk with projection, turn\n     5\t// transitions, and work queueing.\n     6\timport { existsSync } from \"node:fs\";\n     7\timport type { DatabaseSync } from \"node:sqlite\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n     9\timport { openDatabase } from \"../../../shared/storage.js\";\n    10\timport { resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n    11\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n    12\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n    13\t\n    14\t// Test seam (set only through test/fixtures): called after each event is\n    15\t// processed inside the walk, so atomicity under mid-walk failure can be\n    16\t// induced through a real mechanism — closing the handle — rather than a\n    17\t// mocked transaction object.\n    18\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n    19\tlet walkHook: IntakeWalkHook | null = null;\n    20\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n    21\t  walkHook = hook;\n    22\t}\n    23\t\n    24\t// Test seam (set only through test/fixtures): replaces the wall clock so\n    25\t// recordedAt is sourced deterministically for the public SDK contract proof —\n    26\t// TC-1.4 records the same batch through both reference forms and reads it back\n    27\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n    28\t// production: recording stamps real wall time. An explicit clock argument to\n    29\t// runMessageEvents still wins over the seam.\n    30\tlet injectedClock: (() => Date) | null = null;\n    31\texport function setIntakeClock(clock: (() => Date) | null): void {\n    32\t  injectedClock = clock;\n    33\t}\n    34\t\n    35\tfunction detail(cause: unknown): string {\n    36\t  return cause instanceof Error ? cause.message : String(cause);\n    37\t}\n    38\t\n    39\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    40\t  return {\n    41\t    ok: false,\n    42\t    error: {\n    43\t      errorClass: \"caller_error\",\n    44\t      code: \"thread_not_found\",\n    45\t      reason: `no thread file exists at ${filePath}`,\n    46\t    },\n    47\t  };\n    48\t}\n    49\t\n    50\t// The skip set is read at transaction start and reads only the key column:\n    51\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n    52\t// Chunked to stay under SQLite's bound-parameter limit.\n    53\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n    54\t  const found = new Set<string>();\n    55\t  for (let offset = 0; offset < keys.length; offset += 400) {\n    56\t    const chunk = keys.slice(offset, offset + 400);\n    57\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n    58\t    const rows = db\n    59\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n    60\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    61\t    for (const row of rows) found.add(row.idempotency_key);\n    62\t  }\n    63\t  return found;\n    64\t}\n    65\t\n    66\tfunction maxEventOrder(db: DatabaseSync): number {\n    67\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    68\t    | { max_order: number | bigint | null }\n    69\t    | undefined;\n    70\t  return Number(row?.max_order ?? 0);\n    71\t}\n    72\t\n    73\texport async function runMessageEvents(\n    74\t  thread: ThreadRef,\n    75\t  events: readonly MessageEventInput[],\n    76\t  clock: () => Date = injectedClock ?? (() => new Date()),\n    77\t): Promise<OpResult<BatchResult>> {\n    78\t  // Pure validation first: a rejected batch never opens the file, never takes\n    79\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n    80\t  // not a skip (validation-before-idempotency precedence).\n    81\t  const refFailure = validateThreadRef(thread);\n    82\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n    83\t  const batchFailure = validateEvents(events);\n    84\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n    85\t\n    86\t  const resolved = await resolveThreadRef(thread);\n    87\t  if (!resolved.ok) return resolved;\n    88\t  const { filePath } = resolved.value;\n    89\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n    90\t\n    91\t  let db: DatabaseSync;\n    92\t  try {\n    93\t    db = openDatabase(filePath);\n    94\t  } catch (cause) {\n    95\t    return storageFailure(`could not open thread file: ${detail(cause)}`);\n    96\t  }\n    97\t\n    98\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n    99\t  // single-writer violations fail loudly at a defined point.\n   100\t  let inTransaction = false;\n   101\t  try {\n   102\t    db.exec(\"BEGIN IMMEDIATE;\");\n   103\t    inTransaction = true;\n   104\t\n   105\t    const skipSet = recordedKeys(\n   106\t      db,\n   107\t      events.map((event) => event.idempotencyKey),\n   108\t    );\n   109\t    // Order counter from MAX(event_order): only recorded events increment it,\n   110\t    // so skips consume no order numbers and the sequence stays dense.\n   111\t    let lastOrder = maxEventOrder(db);\n   112\t\n   113\t    const insert = db.prepare(\n   114\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   115\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   116\t    );\n   117\t\n   118\t    const eventResults: BatchResult[\"events\"] = [];\n   119\t    for (const [index, event] of events.entries()) {\n   120\t      if (skipSet.has(event.idempotencyKey)) {\n   121\t        eventResults.push({\n   122\t          idempotencyKey: event.idempotencyKey,\n   123\t          outcome: \"skipped\",\n   124\t          skipReason: \"duplicate_idempotency_key\",\n   125\t        });\n   126\t      } else {\n   127\t        lastOrder += 1;\n   128\t        insert.run(\n   129\t          lastOrder,\n   130\t          event.eventKind,\n   131\t          event.idempotencyKey,\n   132\t          event.actor,\n   133\t          event.harness,\n   134\t          JSON.stringify(event.payload),\n   135\t          clock().toISOString(),\n   136\t        );\n   137\t        skipSet.add(event.idempotencyKey);\n   138\t        eventResults.push({ idempotencyKey: event.idempotencyKey, outcome: \"recorded\" });\n   139\t      }\n   140\t      walkHook?.(db, index);\n   141\t    }\n   142\t\n   143\t    db.exec(\"COMMIT;\");\n   144\t    inTransaction = false;\n   145\t\n   146\t    return {\n   147\t      ok: true,\n   148\t      value: {\n   149\t        events: eventResults,\n   150\t        turnTransitions: [], // populated by Story 4\n   151\t        queuedWork: [], // populated by Story 5\n   152\t        threadPosition: { lastEventOrder: lastOrder },\n   153\t      },\n   154\t    };\n   155\t  } catch (cause) {\n   156\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n   157\t    // class-independent. The handle may already be gone (induced failure),\n   158\t    // in which case SQLite has already discarded the uncommitted transaction.\n   159\t    if (inTransaction) {\n   160\t      try {\n   161\t        db.exec(\"ROLLBACK;\");\n   162\t      } catch {\n   163\t        // handle closed mid-walk; the open transaction died with it\n   164\t      }\n   165\t    }\n   166\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n   167\t  } finally {\n   168\t    try {\n   169\t      db.close();\n   170\t    } catch {\n   171\t      // already closed by the induced-failure seam\n   172\t    }\n   173\t  }\n   174\t}\n   175\t\n   176\tinterface RawEventRow {\n   177\t  event_order: number | bigint;\n   178\t  event_kind: string;\n   179\t  idempotency_key: string;\n   180\t  actor: string;\n   181\t  harness: string;\n   182\t  payload: string;\n   183\t  recorded_at: string;\n   184\t}\n   185\t\n   186\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n   187\t  const refFailure = validateThreadRef(thread);\n   188\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n   189\t\n   190\t  const resolved = await resolveThreadRef(thread);\n   191\t  if (!resolved.ok) return resolved;\n   192\t  const { filePath } = resolved.value;\n   193\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   194\t\n   195\t  let db: DatabaseSync | undefined;\n   196\t  try {\n   197\t    db = openDatabase(filePath);\n   198\t    const rows = db\n   199\t      .prepare(\n   200\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n   201\t         FROM event ORDER BY event_order`,\n   202\t      )\n   203\t      .all() as unknown as RawEventRow[];\n   204\t    const records = rows.map(\n   205\t      (row) =>\n   206\t        ({\n   207\t          eventKind: row.event_kind,\n   208\t          idempotencyKey: row.idempotency_key,\n   209\t          actor: row.actor,\n   210\t          harness: row.harness,\n   211\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n   212\t          eventOrder: Number(row.event_order),\n   213\t          recordedAt: row.recorded_at,\n   214\t        }) as unknown as EventRecord,\n   215\t    );\n   216\t    return { ok: true, value: records };\n   217\t  } catch (cause) {\n   218\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n   219\t  } finally {\n   220\t    db?.close();\n   221\t  }\n   222\t}\n","exit_code":0,"status":"completed"}}

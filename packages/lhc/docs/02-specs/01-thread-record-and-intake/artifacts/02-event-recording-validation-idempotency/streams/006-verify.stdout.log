{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/intake.test.ts | sed -n '85,145p'\"","aggregated_output":"    85\t    const result = await intakeStream.messageEvents({ filePath }, []);\n    86\t    expect(result.ok).toBe(false);\n    87\t    if (result.ok) return;\n    88\t    expect(result.error.errorClass).toBe(\"caller_error\");\n    89\t    expect(result.error.code).toBe(\"empty_batch\");\n    90\t    expect(result.error.reason).toContain(\"empty\");\n    91\t\n    92\t    expect(await readBack(filePath)).toEqual([]);\n    93\t  });\n    94\t\n    95\t  it(\"TC-1.4: the same batch by thread id and by file path produces identical results and read-back (closes Story 1's deferral)\", async () => {\n    96\t    // recordedAt is sourced from the injected clock (test-plan: fixed per\n    97\t    // test), so the two independent recordings stamp the same instant and the\n    98\t    // read-back can be compared field-for-field — recordedAt included, nothing\n    99\t    // stripped.\n   100\t    const recordedAt = new Date(\"2026-01-01T00:00:00.000Z\");\n   101\t    setIntakeClock(() => recordedAt);\n   102\t\n   103\t    const pathA = store.threadPath();\n   104\t    const createdA = await threads.newThread({\n   105\t      filePath: pathA,\n   106\t      registryPath: store.registryPath,\n   107\t    });\n   108\t    expect(createdA.ok).toBe(true);\n   109\t    if (!createdA.ok) return;\n   110\t    const pathB = await createThread();\n   111\t\n   112\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\", \"turn_end\"]);\n   113\t    const byId = await intakeStream.messageEvents(\n   114\t      { threadId: createdA.value.threadId, registryPath: store.registryPath },\n   115\t      batch,\n   116\t    );\n   117\t    const byPath = await intakeStream.messageEvents({ filePath: pathB }, batch);\n   118\t    expect(byId.ok).toBe(true);\n   119\t    expect(byPath.ok).toBe(true);\n   120\t    if (!byId.ok || !byPath.ok) return;\n   121\t    expect(byId.value).toEqual(byPath.value);\n   122\t\n   123\t    // Exact read-back equivalence through both reference forms — every field,\n   124\t    // recordedAt included. Determinism comes from the injected clock, not from\n   125\t    // weakening the assertion.\n   126\t    const readById = await intakeStream.listEvents({\n   127\t      threadId: createdA.value.threadId,\n   128\t      registryPath: store.registryPath,\n   129\t    });\n   130\t    expect(readById.ok).toBe(true);\n   131\t    if (!readById.ok) return;\n   132\t    const readByPath = await readBack(pathB);\n   133\t    expect(readById.value).toEqual(readByPath);\n   134\t\n   135\t    // recordedAt is the injected instant, proving it came from the clock seam\n   136\t    // rather than wall time.\n   137\t    expect(readById.value.map((e: EventRecord) => e.recordedAt)).toEqual(\n   138\t      readByPath.map(() => recordedAt.toISOString()),\n   139\t    );\n   140\t  });\n   141\t\n   142\t  it(\"architecture-risk: mid-walk failure rolls the whole batch back to baseline\", async () => {\n   143\t    const filePath = await createThread();\n   144\t    const baselineBatch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n   145\t    const recorded = await intakeStream.messageEvents({ filePath }, baselineBatch);\n","exit_code":0,"status":"completed"}}

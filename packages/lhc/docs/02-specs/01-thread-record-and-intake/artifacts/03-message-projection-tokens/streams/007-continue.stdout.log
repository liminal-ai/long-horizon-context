esult<DatabaseSync> {","+  const valid = validateThreadFile(filePath);","+  if (!valid.ok) return valid;","+  let db: DatabaseSync;","   try {","+    db = openDatabase(filePath);","+  } catch (cause) {","+    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);","+  }","+  try {","     runMigrations(db, buildThreadMigrations());","   } catch (cause) {","     db.close();","-    throw cause;","+    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);","   }","-  return db;","+  return { ok: true, value: db };"," }"," "," // Schema v1 plus the metadata row land in one migration transaction, so the"]}],"userModified":false,"replaceAll":false}}

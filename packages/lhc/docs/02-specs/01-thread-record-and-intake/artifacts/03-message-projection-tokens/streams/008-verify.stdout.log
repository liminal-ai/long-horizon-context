{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/threads/internal/create.ts'","aggregated_output":"     1\timport { randomBytes } from \"node:crypto\";\n     2\timport { rmSync } from \"node:fs\";\n     3\timport { DatabaseSync } from \"node:sqlite\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n     5\timport {\n     6\t  getSchemaVersion,\n     7\t  openDatabase,\n     8\t  runMigrations,\n     9\t  type Migration,\n    10\t} from \"../../../shared/storage.js\";\n    11\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n    12\t\n    13\t// The one random id: its uniqueness scope is global across files and\n    14\t// registries (design decision 7).\n    15\texport function generateThreadId(): string {\n    16\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n    17\t}\n    18\t\n    19\t// The thread-file schema as a versioned history, never rewritten in place:\n    20\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n    21\t// each later story appends a version. Existing files upgrade lazily through\n    22\t// openThreadDatabase, so a file recorded under an earlier story is always\n    23\t// usable by a later one (F-03-001).\n    24\t//\n    25\t// Creation-time metadata values are interpolated through buildThreadMigrations\n    26\t// for new files only; existing files already hold their metadata row and the\n    27\t// upgrade path never touches it.\n    28\tfunction buildThreadMigrations(\n    29\t  metadata?: { threadId: string; createdAt: string },\n    30\t): Migration[] {\n    31\t  const metadataInsert =\n    32\t    metadata === undefined\n    33\t      ? []\n    34\t      : [\n    35\t          // Interpolated values are all generated by us (hex id, ISO\n    36\t          // timestamp, estimator constant) — never caller input.\n    37\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n    38\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n    39\t        ];\n    40\t  return [\n    41\t    {\n    42\t      version: 1,\n    43\t      statements: [\n    44\t        `CREATE TABLE thread_metadata (\n    45\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n    46\t          thread_id TEXT NOT NULL,\n    47\t          created_at TEXT NOT NULL,\n    48\t          token_estimator TEXT NOT NULL\n    49\t        );`,\n    50\t        ...metadataInsert,\n    51\t        `CREATE TABLE event (\n    52\t          event_order INTEGER PRIMARY KEY,\n    53\t          event_kind TEXT NOT NULL,\n    54\t          idempotency_key TEXT NOT NULL UNIQUE,\n    55\t          actor TEXT NOT NULL,\n    56\t          harness TEXT NOT NULL,\n    57\t          payload TEXT NOT NULL,\n    58\t          recorded_at TEXT NOT NULL\n    59\t        );`,\n    60\t      ],\n    61\t    },\n    62\t    {\n    63\t      version: 2, // Story 3: message projection\n    64\t      statements: [\n    65\t        `CREATE TABLE message (\n    66\t          message_id TEXT PRIMARY KEY,\n    67\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n    68\t          kind TEXT NOT NULL,\n    69\t          token_estimate INTEGER NOT NULL,\n    70\t          actor TEXT NOT NULL,\n    71\t          harness TEXT NOT NULL,\n    72\t          turn_id TEXT\n    73\t        );`,\n    74\t        `CREATE TABLE message_block (\n    75\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n    76\t          block_index INTEGER NOT NULL,\n    77\t          block_type TEXT NOT NULL,\n    78\t          content TEXT NOT NULL,\n    79\t          PRIMARY KEY (message_id, block_index)\n    80\t        );`,\n    81\t      ],\n    82\t    },\n    83\t  ];\n    84\t}\n    85\t\n    86\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n    87\t  return {\n    88\t    ok: false,\n    89\t    error: {\n    90\t      errorClass: \"caller_error\",\n    91\t      code: \"thread_not_found\",\n    92\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n    93\t    },\n    94\t  };\n    95\t}\n    96\t\n    97\tfunction errorDetail(cause: unknown): string {\n    98\t  return cause instanceof Error ? cause.message : String(cause);\n    99\t}\n   100\t\n   101\t// Identity check before any migration runs, on a read-only handle so an\n   102\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n   103\t// file always carries schema version >= 1 and the thread_metadata singleton\n   104\t// row that creation wrote transactionally. Anything else — an empty\n   105\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n   106\t// caller error, never adopted.\n   107\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n   108\t  let db: DatabaseSync | undefined;\n   109\t  try {\n   110\t    db = new DatabaseSync(filePath, { readOnly: true });\n   111\t    if (getSchemaVersion(db) < 1) {\n   112\t      return notAThreadFile(filePath, \"no lhc schema version\");\n   113\t    }\n   114\t    const table = db\n   115\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n   116\t      .get();\n   117\t    if (table === undefined) {\n   118\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n   119\t    }\n   120\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n   121\t    if (row === undefined) {\n   122\t      return notAThreadFile(filePath, \"no thread metadata row\");\n   123\t    }\n   124\t    return { ok: true };\n   125\t  } catch (cause) {\n   126\t    const detail = errorDetail(cause);\n   127\t    // SQLite refusing the file as a database is an identity failure, not an\n   128\t    // environment failure; everything else stays a system error.\n   129\t    if (detail.includes(\"not a database\")) {\n   130\t      return notAThreadFile(filePath, detail);\n   131\t    }\n   132\t    return storageFailure(`could not inspect thread file: ${detail}`);\n   133\t  } finally {\n   134\t    db?.close();\n   135\t  }\n   136\t}\n   137\t\n   138\t// Opens a thread file and brings its schema to the current version before\n   139\t// returning the handle. Every SDK operation on an existing thread file goes\n   140\t// through here, so a pre-Story-3 file gains the message tables on its first\n   141\t// open by newer code — but only after the file proves it is a thread file;\n   142\t// migration never creates lhc schema on an arbitrary existing file. Each\n   143\t// migration runs in its own transaction (storage helper), completing before\n   144\t// any caller transaction begins.\n   145\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n   146\t  const valid = validateThreadFile(filePath);\n   147\t  if (!valid.ok) return valid;\n   148\t  let db: DatabaseSync;\n   149\t  try {\n   150\t    db = openDatabase(filePath);\n   151\t  } catch (cause) {\n   152\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n   153\t  }\n   154\t  try {\n   155\t    runMigrations(db, buildThreadMigrations());\n   156\t  } catch (cause) {\n   157\t    db.close();\n   158\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n   159\t  }\n   160\t  return { ok: true, value: db };\n   161\t}\n   162\t\n   163\t// Schema v1 plus the metadata row land in one migration transaction, so the\n   164\t// file either has its full schema and metadata row or creation fails whole.\n   165\texport function createThreadFile(\n   166\t  filePath: string,\n   167\t  threadId: string,\n   168\t  createdAt: string,\n   169\t): void {\n   170\t  const db = openDatabase(filePath);\n   171\t  try {\n   172\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n   173\t  } finally {\n   174\t    db.close();\n   175\t  }\n   176\t}\n   177\t\n   178\t// Compensation: removes the thread file and its WAL companions. Used when the\n   179\t// registry insert fails after file creation (no registry row without its\n   180\t// file) and when file creation itself fails partway.\n   181\texport function deleteThreadFile(filePath: string): void {\n   182\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n   183\t    rmSync(`${filePath}${suffix}`, { force: true });\n   184\t  }\n   185\t}\n","exit_code":0,"status":"completed"}}

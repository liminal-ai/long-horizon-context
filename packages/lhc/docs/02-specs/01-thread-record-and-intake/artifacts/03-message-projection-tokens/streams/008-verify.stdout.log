{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/messages/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport type { DatabaseSync } from \"node:sqlite\";\n     3\timport type { OperationContext } from \"../../shared/context.js\";\n     4\timport {\n     5\t  notImplemented,\n     6\t  storageFailure,\n     7\t  type ErrorResult,\n     8\t  type OpResult,\n     9\t} from \"../../shared/errors.js\";\n    10\timport type { WorkItemRecord } from \"../../tech-utils/work-queue/index.js\";\n    11\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    12\timport {\n    13\t  openThreadDatabase,\n    14\t  resolveThreadRef,\n    15\t  type ThreadRef,\n    16\t} from \"../threads/index.js\";\n    17\timport { projectEvent } from \"./internal/project.js\";\n    18\timport { insertMessage, readMessages } from \"./internal/store.js\";\n    19\t\n    20\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    21\t\n    22\texport interface Block {\n    23\t  blockType: BlockType;\n    24\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    25\t}\n    26\t\n    27\texport interface MessageRecord {\n    28\t  messageId: string;\n    29\t  sourceEventOrder: number;\n    30\t  kind: Exclude<EventKind, \"turn_end\">;\n    31\t  blocks: Block[];\n    32\t  tokenEstimate: number;\n    33\t  actor: string;\n    34\t  harness: string;\n    35\t  turnId?: string;\n    36\t}\n    37\t\n    38\t// The event as the walk holds it after recording: the validated input plus\n    39\t// its server-stamped order and timestamp.\n    40\texport type RecordedEvent = EventRecord;\n    41\t\n    42\texport type MessageCreated = {\n    43\t  messageId: string;\n    44\t  kind: Exclude<EventKind, \"turn_end\">;\n    45\t} | null;\n    46\t\n    47\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    48\t// (the first such call through the operation context; turns.applyEvent\n    49\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    50\t// projection failure propagates to the pipeline's catch and rejects the\n    51\t// whole batch — recorded events without messages is the stranded state the\n    52\t// transaction exists to prevent. Returns null for turn_end (no message).\n    53\texport function createFromEvent(\n    54\t  ctx: OperationContext,\n    55\t  event: RecordedEvent,\n    56\t): MessageCreated {\n    57\t  const projected = projectEvent(event);\n    58\t  if (projected === null) return null;\n    59\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    60\t  const messageId = `m${event.eventOrder}`;\n    61\t  insertMessage(ctx.db, {\n    62\t    messageId,\n    63\t    sourceEventOrder: event.eventOrder,\n    64\t    kind,\n    65\t    tokenEstimate: projected.tokenEstimate,\n    66\t    actor: event.actor,\n    67\t    harness: event.harness,\n    68\t    blocks: projected.blocks,\n    69\t  });\n    70\t  return { messageId, kind };\n    71\t}\n    72\t\n    73\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    74\t  return {\n    75\t    ok: false,\n    76\t    error: {\n    77\t      errorClass: \"caller_error\",\n    78\t      code: \"thread_not_found\",\n    79\t      reason: `no thread file exists at ${filePath}`,\n    80\t    },\n    81\t  };\n    82\t}\n    83\t\n    84\texport async function listMessages(\n    85\t  thread: ThreadRef,\n    86\t): Promise<OpResult<MessageRecord[]>> {\n    87\t  const resolved = await resolveThreadRef(thread);\n    88\t  if (!resolved.ok) return resolved;\n    89\t  const { filePath } = resolved.value;\n    90\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n    91\t\n    92\t  // openThreadDatabase verifies the file is a real thread file and migrates\n    93\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n    94\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n    95\t  // unmutated (F-03-002).\n    96\t  const opened = openThreadDatabase(filePath);\n    97\t  if (!opened.ok) return opened;\n    98\t  const db = opened.value;\n    99\t  try {\n   100\t    return { ok: true, value: readMessages(db) };\n   101\t  } catch (cause) {\n   102\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   103\t    return storageFailure(`message read-back failed: ${reason}`);\n   104\t  } finally {\n   105\t    db.close();\n   106\t  }\n   107\t}\n   108\t\n   109\texport async function listQueuedWork(\n   110\t  _thread: ThreadRef,\n   111\t): Promise<OpResult<WorkItemRecord[]>> {\n   112\t  return notImplemented(\"messages.list-queued-work\");\n   113\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/thread-migration.test.ts'","aggregated_output":"     1\t// F-03-001: an existing valid Story 2 thread file (user_version=1, only\n     2\t// thread_metadata/event tables) must be migrated to the current schema before\n     3\t// any Story 3 message write or read. The fixture reproduces the accepted\n     4\t// Story 2 on-disk layout exactly; the assertions go through the production\n     5\t// entry points (messageEvents, listMessages, listEvents) plus below-SDK\n     6\t// schema-version reads.\n     7\t// F-03-002: the lazy opener must reject existing files that are not thread\n     8\t// files without creating lhc schema or bumping user_version on them.\n     9\timport { readFileSync, writeFileSync } from \"node:fs\";\n    10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    11\timport { intakeStream, messages } from \"../src/index.js\";\n    12\timport {\n    13\t  legacyStory2ThreadFile,\n    14\t  openRaw,\n    15\t  schemaVersionOf,\n    16\t  tempStore,\n    17\t  validEvent,\n    18\t  type TempStore,\n    19\t} from \"./fixtures/index.js\";\n    20\t\n    21\tlet store: TempStore;\n    22\tbeforeEach(() => {\n    23\t  store = tempStore();\n    24\t});\n    25\tafterEach(() => {\n    26\t  store.cleanup();\n    27\t});\n    28\t\n    29\tconst legacyEvent = {\n    30\t  eventOrder: 1,\n    31\t  eventKind: \"user_prompt\",\n    32\t  idempotencyKey: \"legacy-key-1\",\n    33\t  actor: \"legacy-actor\",\n    34\t  harness: \"legacy-harness\",\n    35\t  payload: { text: \"recorded before story 3 shipped\" },\n    36\t  recordedAt: \"2026-06-01T00:00:01.000Z\",\n    37\t};\n    38\t\n    39\tdescribe(\"F-03-001: Story 2 thread files migrate before message write/read\", () => {\n    40\t  it(\"messageEvents on a Story 2 file upgrades the schema, keeps the legacy record intact, and projects the new events\", async () => {\n    41\t    const filePath = store.threadPath();\n    42\t    legacyStory2ThreadFile(filePath, \"th_legacy01\", [legacyEvent]);\n    43\t    expect(schemaVersionOf(filePath)).toBe(1);\n    44\t\n    45\t    const result = await intakeStream.messageEvents({ filePath }, [\n    46\t      validEvent(\"assistant_text\", { payload: { text: \"answered after upgrade\" } }),\n    47\t      validEvent(\"turn_end\"),\n    48\t    ]);\n    49\t    expect(result.ok).toBe(true);\n    50\t    if (!result.ok) return;\n    51\t    expect(result.value.events.map((entry) => entry.outcome)).toEqual([\n    52\t      \"recorded\",\n    53\t      \"recorded\",\n    54\t    ]);\n    55\t    // The order counter continues from the legacy record; the new message id\n    56\t    // derives from the continued order.\n    57\t    expect(result.value.threadPosition.lastEventOrder).toBe(3);\n    58\t    expect(result.value.events[0]!.messageId).toBe(\"m2\");\n    59\t\n    60\t    expect(schemaVersionOf(filePath)).toBe(2);\n    61\t\n    62\t    // The legacy event survives the upgrade byte-for-byte at the SDK level.\n    63\t    const events = await intakeStream.listEvents({ filePath });\n    64\t    expect(events.ok).toBe(true);\n    65\t    if (!events.ok) return;\n    66\t    expect(events.value).toHaveLength(3);\n    67\t    expect(events.value[0]).toEqual({\n    68\t      eventKind: \"user_prompt\",\n    69\t      idempotencyKey: \"legacy-key-1\",\n    70\t      actor: \"legacy-actor\",\n    71\t      harness: \"legacy-harness\",\n    72\t      payload: { text: \"recorded before story 3 shipped\" },\n    73\t      eventOrder: 1,\n    74\t      recordedAt: \"2026-06-01T00:00:01.000Z\",\n    75\t    });\n    76\t\n    77\t    // Projection is intake-time, not retroactive: the new assistant_text\n    78\t    // projects; the legacy pre-Story-3 event stays event-only.\n    79\t    const projected = await messages.listMessages({ filePath });\n    80\t    expect(projected.ok).toBe(true);\n    81\t    if (!projected.ok) return;\n    82\t    expect(projected.value).toHaveLength(1);\n    83\t    expect(projected.value[0]!.messageId).toBe(\"m2\");\n    84\t    expect(projected.value[0]!.sourceEventOrder).toBe(2);\n    85\t    expect(projected.value[0]!.blocks).toEqual([\n    86\t      { blockType: \"text\", content: { text: \"answered after upgrade\" } },\n    87\t    ]);\n    88\t    expect(projected.value[0]!.tokenEstimate).toBeGreaterThan(0);\n    89\t  });\n    90\t\n    91\t  it(\"listMessages on an untouched Story 2 file migrates on read and returns an empty list\", async () => {\n    92\t    const filePath = store.threadPath();\n    93\t    legacyStory2ThreadFile(filePath, \"th_legacy02\", [legacyEvent]);\n    94\t    expect(schemaVersionOf(filePath)).toBe(1);\n    95\t\n    96\t    const projected = await messages.listMessages({ filePath });\n    97\t    expect(projected.ok).toBe(true);\n    98\t    if (!projected.ok) return;\n    99\t    expect(projected.value).toEqual([]);\n   100\t\n   101\t    expect(schemaVersionOf(filePath)).toBe(2);\n   102\t\n   103\t    // The read-path upgrade changed no record content.\n   104\t    const events = await intakeStream.listEvents({ filePath });\n   105\t    expect(events.ok).toBe(true);\n   106\t    if (!events.ok) return;\n   107\t    expect(events.value).toHaveLength(1);\n   108\t    expect(events.value[0]!.idempotencyKey).toBe(\"legacy-key-1\");\n   109\t  });\n   110\t\n   111\t  it(\"idempotency keys recorded under Story 2 still skip after the upgrade\", async () => {\n   112\t    const filePath = store.threadPath();\n   113\t    legacyStory2ThreadFile(filePath, \"th_legacy03\", [legacyEvent]);\n   114\t\n   115\t    const resend = await intakeStream.messageEvents({ filePath }, [\n   116\t      validEvent(\"user_prompt\", {\n   117\t        idempotencyKey: \"legacy-key-1\",\n   118\t        payload: { text: \"resent after upgrade\" },\n   119\t      }),\n   120\t    ]);\n   121\t    expect(resend.ok).toBe(true);\n   122\t    if (!resend.ok) return;\n   123\t    expect(resend.value.events[0]).toEqual({\n   124\t      idempotencyKey: \"legacy-key-1\",\n   125\t      outcome: \"skipped\",\n   126\t      skipReason: \"duplicate_idempotency_key\",\n   127\t    });\n   128\t\n   129\t    // No message was created for the skipped resend of the legacy event.\n   130\t    const projected = await messages.listMessages({ filePath });\n   131\t    expect(projected.ok).toBe(true);\n   132\t    if (!projected.ok) return;\n   133\t    expect(projected.value).toEqual([]);\n   134\t  });\n   135\t});\n   136\t\n   137\t// Tables present in a file, by name — asserts what schema (if any) the\n   138\t// rejected open left behind.\n   139\tfunction tableNames(filePath: string): string[] {\n   140\t  const db = openRaw(filePath);\n   141\t  try {\n   142\t    const rows = db\n   143\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name\")\n   144\t      .all() as unknown as Array<{ name: string }>;\n   145\t    return rows.map((row) => row.name);\n   146\t  } finally {\n   147\t    db.close();\n   148\t  }\n   149\t}\n   150\t\n   151\tdescribe(\"F-03-002: non-thread files are rejected, not adopted\", () => {\n   152\t  it(\"listMessages against an existing empty database file fails without creating schema or bumping user_version\", async () => {\n   153\t    const filePath = store.threadPath();\n   154\t    writeFileSync(filePath, \"\"); // exists, zero bytes — a valid empty SQLite database\n   155\t\n   156\t    const result = await messages.listMessages({ filePath });\n   157\t    expect(result.ok).toBe(false);\n   158\t    if (result.ok) return;\n   159\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   160\t    expect(result.error.code).toBe(\"thread_not_found\");\n   161\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n   162\t\n   163\t    expect(schemaVersionOf(filePath)).toBe(0);\n   164\t    expect(tableNames(filePath)).toEqual([]);\n   165\t  });\n   166\t\n   167\t  it(\"messageEvents against an unrelated SQLite database fails and leaves its content untouched\", async () => {\n   168\t    const filePath = store.threadPath();\n   169\t    const foreign = openRaw(filePath);\n   170\t    try {\n   171\t      foreign.exec(\"CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL);\");\n   172\t      foreign.prepare(\"INSERT INTO notes (id, body) VALUES (1, ?)\").run(\"not lhc data\");\n   173\t    } finally {\n   174\t      foreign.close();\n   175\t    }\n   176\t\n   177\t    const result = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   178\t    expect(result.ok).toBe(false);\n   179\t    if (result.ok) return;\n   180\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   181\t    expect(result.error.code).toBe(\"thread_not_found\");\n   182\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n   183\t\n   184\t    // No lhc tables were created, the version was not bumped, and the\n   185\t    // foreign data is intact.\n   186\t    expect(schemaVersionOf(filePath)).toBe(0);\n   187\t    expect(tableNames(filePath)).toEqual([\"notes\"]);\n   188\t    const db = openRaw(filePath);\n   189\t    try {\n   190\t      const row = db.prepare(\"SELECT body FROM notes WHERE id = 1\").get() as unknown as {\n   191\t        body: string;\n   192\t      };\n   193\t      expect(row.body).toBe(\"not lhc data\");\n   194\t    } finally {\n   195\t      db.close();\n   196\t    }\n   197\t  });\n   198\t\n   199\t  it(\"a non-SQLite file is rejected as a caller error with its bytes unchanged\", async () => {\n   200\t    const filePath = store.threadPath();\n   201\t    const original = \"just some text, definitely not a database\\n\";\n   202\t    writeFileSync(filePath, original);\n   203\t\n   204\t    const listed = await messages.listMessages({ filePath });\n   205\t    expect(listed.ok).toBe(false);\n   206\t    if (listed.ok) return;\n   207\t    expect(listed.error.errorClass).toBe(\"caller_error\");\n   208\t    expect(listed.error.code).toBe(\"thread_not_found\");\n   209\t\n   210\t    const batched = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   211\t    expect(batched.ok).toBe(false);\n   212\t    if (batched.ok) return;\n   213\t    expect(batched.error.errorClass).toBe(\"caller_error\");\n   214\t    expect(batched.error.code).toBe(\"thread_not_found\");\n   215\t\n   216\t    expect(readFileSync(filePath, \"utf8\")).toBe(original);\n   217\t  });\n   218\t});\n","exit_code":0,"status":"completed"}}

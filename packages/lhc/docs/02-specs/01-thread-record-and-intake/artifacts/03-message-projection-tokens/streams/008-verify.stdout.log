{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/threads/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     3\timport {\n     4\t  createThreadFile,\n     5\t  deleteThreadFile,\n     6\t  generateThreadId,\n     7\t  openThreadDatabase,\n     8\t} from \"./internal/create.js\";\n     9\t\n    10\t// Re-exported for the other domain surfaces: opening a thread file through\n    11\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n    12\t// file gains the message tables here before any write or read touches them).\n    13\texport { openThreadDatabase };\n    14\timport {\n    15\t  insertThreadRow,\n    16\t  openRegistryForRead,\n    17\t  openRegistryForWrite,\n    18\t  resolveRegistryPath,\n    19\t  selectAllThreadRows,\n    20\t  selectThreadRow,\n    21\t  type RegistryRow,\n    22\t} from \"./internal/registry.js\";\n    23\t\n    24\texport type ThreadRef =\n    25\t  | { threadId: string; registryPath?: string }\n    26\t  | { filePath: string };\n    27\t\n    28\texport interface NewThreadInput {\n    29\t  filePath: string;\n    30\t  title?: string;\n    31\t  registryPath?: string;\n    32\t}\n    33\t\n    34\texport interface ThreadInfo {\n    35\t  threadId: string;\n    36\t  filePath: string;\n    37\t  title?: string;\n    38\t  createdAt: string; // ISO-8601\n    39\t}\n    40\t\n    41\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n    42\t  const info: ThreadInfo = {\n    43\t    threadId: row.threadId,\n    44\t    filePath: row.filePath,\n    45\t    createdAt: row.createdAt,\n    46\t  };\n    47\t  if (row.title !== undefined) info.title = row.title;\n    48\t  return info;\n    49\t}\n    50\t\n    51\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n    52\t  return {\n    53\t    ok: false,\n    54\t    error: {\n    55\t      errorClass: \"caller_error\",\n    56\t      code: \"thread_not_found\",\n    57\t      reason: `no thread registered with id ${threadId}`,\n    58\t    },\n    59\t  };\n    60\t}\n    61\t\n    62\tfunction detail(cause: unknown): string {\n    63\t  return cause instanceof Error ? cause.message : String(cause);\n    64\t}\n    65\t\n    66\t// Creation spans two databases that cannot share a transaction. Order is\n    67\t// file-then-row with compensation: the invariant \"no registry row without\n    68\t// its file\" is absolute; an orphan file from a crash between the writes is\n    69\t// documented harmless (design decision 2).\n    70\texport async function newThread(\n    71\t  input: NewThreadInput,\n    72\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n    73\t  if (existsSync(input.filePath)) {\n    74\t    return {\n    75\t      ok: false,\n    76\t      error: {\n    77\t        errorClass: \"caller_error\",\n    78\t        code: \"path_exists\",\n    79\t        reason: `a file already exists at ${input.filePath}`,\n    80\t      },\n    81\t    };\n    82\t  }\n    83\t\n    84\t  const threadId = generateThreadId();\n    85\t  const createdAt = new Date().toISOString();\n    86\t\n    87\t  try {\n    88\t    createThreadFile(input.filePath, threadId, createdAt);\n    89\t  } catch (cause) {\n    90\t    deleteThreadFile(input.filePath);\n    91\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n    92\t  }\n    93\t\n    94\t  let registry;\n    95\t  try {\n    96\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n    97\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n    98\t    if (input.title !== undefined) row.title = input.title;\n    99\t    insertThreadRow(registry, row);\n   100\t  } catch (cause) {\n   101\t    deleteThreadFile(input.filePath);\n   102\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n   103\t  } finally {\n   104\t    registry?.close();\n   105\t  }\n   106\t\n   107\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n   108\t}\n   109\t\n   110\texport async function resolve(input: {\n   111\t  threadId: string;\n   112\t  registryPath?: string;\n   113\t}): Promise<OpResult<ThreadInfo>> {\n   114\t  let registry;\n   115\t  try {\n   116\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n   117\t    if (registry === null) return threadNotFound(input.threadId);\n   118\t    const row = selectThreadRow(registry, input.threadId);\n   119\t    if (row === undefined) return threadNotFound(input.threadId);\n   120\t    return { ok: true, value: toThreadInfo(row) };\n   121\t  } catch (cause) {\n   122\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   123\t  } finally {\n   124\t    registry?.close();\n   125\t  }\n   126\t}\n   127\t\n   128\texport async function listThreads(input?: {\n   129\t  registryPath?: string;\n   130\t}): Promise<OpResult<ThreadInfo[]>> {\n   131\t  let registry;\n   132\t  try {\n   133\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n   134\t    if (registry === null) return { ok: true, value: [] };\n   135\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n   136\t  } catch (cause) {\n   137\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   138\t  } finally {\n   139\t    registry?.close();\n   140\t  }\n   141\t}\n   142\t\n   143\t// The single interpreter of thread references: { threadId } resolves to a\n   144\t// path through the registry, { filePath } passes through untouched. No other\n   145\t// code ever reads a thread reference.\n   146\texport async function resolveThreadRef(\n   147\t  ref: ThreadRef,\n   148\t): Promise<OpResult<{ filePath: string }>> {\n   149\t  if (\"threadId\" in ref) {\n   150\t    const resolved = await resolve(ref);\n   151\t    if (!resolved.ok) return resolved;\n   152\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n   153\t  }\n   154\t  return { ok: true, value: { filePath: ref.filePath } };\n   155\t}\n","exit_code":0,"status":"completed"}}

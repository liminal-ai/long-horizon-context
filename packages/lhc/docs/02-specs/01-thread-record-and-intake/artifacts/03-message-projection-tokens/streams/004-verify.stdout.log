{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/errors.ts'","aggregated_output":"     1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n     2\t\n     3\texport type ErrorCode =\n     4\t  | \"path_exists\"\n     5\t  | \"thread_not_found\"\n     6\t  | \"invalid_event\"\n     7\t  | \"empty_batch\"\n     8\t  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n     9\t  | \"turn_state_corrupt\"\n    10\t  | \"storage_failure\";\n    11\t\n    12\texport interface ErrorResult {\n    13\t  errorClass: ErrorClass;\n    14\t  code: ErrorCode;\n    15\t  reason: string; // human-readable; machine logic switches on code\n    16\t  eventIndex?: number; // present on batch validation failures\n    17\t}\n    18\t\n    19\t// Expected operational failures — caller errors, corruption, environment\n    20\t// failures — are always returned as OpResult errors, never thrown.\n    21\t// Programmer bugs inside lhc may still throw; callers are not expected\n    22\t// to handle throws as contract outcomes.\n    23\texport type OpResult<T> =\n    24\t  | { ok: true; value: T }\n    25\t  | { ok: false; error: ErrorResult };\n    26\t\n    27\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n    28\t// caught at the operation boundary and wrapped with the underlying detail.\n    29\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n    30\t  return {\n    31\t    ok: false,\n    32\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n    33\t  };\n    34\t}\n    35\t\n    36\texport function notImplemented(op: string): { ok: false; error: ErrorResult } {\n    37\t  return {\n    38\t    ok: false,\n    39\t    error: {\n    40\t      errorClass: \"system_error\",\n    41\t      code: \"storage_failure\",\n    42\t      reason: `not implemented: ${op}`,\n    43\t    },\n    44\t  };\n    45\t}\n","exit_code":0,"status":"completed"}}

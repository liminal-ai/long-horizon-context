{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/cli-process-projection.test.ts'","aggregated_output":"     1\t// CLI process-boundary suite for message projection: TC-2.4's spawned-CLI\n     2\t// leg. A 300KB tool result goes in through real stdin (stdin → pipeline →\n     3\t// projection) and comes back byte-identical through `messages list`, proving\n     4\t// no layer between the pipe and the read-back shortens content. Runs under\n     5\t// verify-all only.\n     6\timport { spawnSync } from \"node:child_process\";\n     7\timport { mkdtempSync, rmSync } from \"node:fs\";\n     8\timport { tmpdir } from \"node:os\";\n     9\timport path from \"node:path\";\n    10\timport { fileURLToPath } from \"node:url\";\n    11\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    12\timport { validEvent } from \"./fixtures/index.js\";\n    13\t\n    14\tconst cliPath = path.resolve(\n    15\t  path.dirname(fileURLToPath(import.meta.url)),\n    16\t  \"../dist/cli.js\",\n    17\t);\n    18\t\n    19\tfunction runBinary(\n    20\t  args: string[],\n    21\t  input?: string,\n    22\t): { status: number | null; stdout: string; stderr: string } {\n    23\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    24\t    encoding: \"utf8\",\n    25\t    maxBuffer: 64 * 1024 * 1024,\n    26\t    ...(input === undefined ? {} : { input }),\n    27\t  });\n    28\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    29\t}\n    30\t\n    31\tlet dir: string;\n    32\tlet threadPath: string;\n    33\tbeforeEach(() => {\n    34\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-projection-\"));\n    35\t  threadPath = path.join(dir, \"thread.sqlite\");\n    36\t  const created = runBinary([\n    37\t    \"threads\",\n    38\t    \"new-thread\",\n    39\t    \"--file-path\",\n    40\t    threadPath,\n    41\t    \"--registry\",\n    42\t    path.join(dir, \"registry.sqlite\"),\n    43\t  ]);\n    44\t  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n    45\t});\n    46\tafterEach(() => {\n    47\t  rmSync(dir, { recursive: true, force: true });\n    48\t});\n    49\t\n    50\tdescribe(\"Story 3 (process boundary): projection through the spawned binary\", () => {\n    51\t  it(\"TC-2.4 (CLI leg): a 300KB tool result piped through real stdin reads back byte-identical via messages list\", () => {\n    52\t    const bigContent = \"spawned-cli verbatim δσπ 😀 line\\n\".repeat(10_000);\n    53\t    expect(Buffer.byteLength(bigContent, \"utf8\")).toBeGreaterThan(300_000);\n    54\t    const batch = [\n    55\t      validEvent(\"user_prompt\", { payload: { text: \"run the big tool\" } }),\n    56\t      validEvent(\"tool_result\", {\n    57\t        payload: { toolCallId: \"proc-big\", content: bigContent, isError: false },\n    58\t      }),\n    59\t      validEvent(\"turn_end\"),\n    60\t    ];\n    61\t\n    62\t    const recorded = runBinary(\n    63\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n    64\t      JSON.stringify(batch),\n    65\t    );\n    66\t    expect(recorded.status).toBe(0);\n    67\t    const recordedParsed = JSON.parse(recorded.stdout) as {\n    68\t      ok: boolean;\n    69\t      value: { events: Array<{ outcome: string; messageId?: string }> };\n    70\t    };\n    71\t    expect(recordedParsed.ok).toBe(true);\n    72\t    expect(recordedParsed.value.events.map((entry) => entry.messageId)).toEqual([\n    73\t      \"m1\",\n    74\t      \"m2\",\n    75\t      undefined,\n    76\t    ]);\n    77\t\n    78\t    const listed = runBinary([\"messages\", \"list\", \"--file-path\", threadPath]);\n    79\t    expect(listed.status).toBe(0);\n    80\t    const listedParsed = JSON.parse(listed.stdout) as {\n    81\t      ok: boolean;\n    82\t      value: Array<{\n    83\t        messageId: string;\n    84\t        kind: string;\n    85\t        tokenEstimate: number;\n    86\t        blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    87\t      }>;\n    88\t    };\n    89\t    expect(listedParsed.ok).toBe(true);\n    90\t    expect(listedParsed.value.map((message) => message.messageId)).toEqual([\"m1\", \"m2\"]);\n    91\t\n    92\t    const toolResult = listedParsed.value[1]!;\n    93\t    expect(toolResult.kind).toBe(\"tool_result\");\n    94\t    expect(toolResult.blocks).toHaveLength(1);\n    95\t    expect(toolResult.blocks[0]!.blockType).toBe(\"tool_result\");\n    96\t    expect(toolResult.blocks[0]!.content[\"content\"] === bigContent).toBe(true);\n    97\t    expect(toolResult.blocks[0]!.content[\"toolCallId\"]).toBe(\"proc-big\");\n    98\t    expect(toolResult.tokenEstimate).toBeGreaterThan(0);\n    99\t  });\n   100\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/projection.test.ts'","aggregated_output":"     1\t// Story 3 (Flow 2, projection half): TC-2.2 through TC-2.5, TC-5.4's\n     2\t// no-duplicate-message clause, and the projection rung of the rollback ladder\n     3\t// (an induced projection failure rejects the whole batch). Everything enters\n     4\t// through the SDK or the in-process CLI; the spawned-CLI leg of TC-2.4 lives\n     5\t// in cli-process-projection.test.ts.\n     6\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     7\timport {\n     8\t  intakeStream,\n     9\t  messages,\n    10\t  runCli,\n    11\t  threads,\n    12\t  type EventRecord,\n    13\t  type MessageRecord,\n    14\t} from \"../src/index.js\";\n    15\timport {\n    16\t  eventBatch,\n    17\t  openRaw,\n    18\t  setIntakeWalkHook,\n    19\t  tempStore,\n    20\t  validEvent,\n    21\t  type TempStore,\n    22\t} from \"./fixtures/index.js\";\n    23\t\n    24\tlet store: TempStore;\n    25\tbeforeEach(() => {\n    26\t  store = tempStore();\n    27\t});\n    28\tafterEach(() => {\n    29\t  setIntakeWalkHook(null);\n    30\t  store.cleanup();\n    31\t});\n    32\t\n    33\tasync function createThread(): Promise<string> {\n    34\t  const filePath = store.threadPath();\n    35\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    36\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    37\t  return filePath;\n    38\t}\n    39\t\n    40\tasync function readEvents(filePath: string): Promise<EventRecord[]> {\n    41\t  const result = await intakeStream.listEvents({ filePath });\n    42\t  if (!result.ok) throw new Error(`event read-back failed: ${result.error.reason}`);\n    43\t  return result.value;\n    44\t}\n    45\t\n    46\tasync function readMessages(filePath: string): Promise<MessageRecord[]> {\n    47\t  const result = await messages.listMessages({ filePath });\n    48\t  if (!result.ok) throw new Error(`message read-back failed: ${result.error.reason}`);\n    49\t  return result.value;\n    50\t}\n    51\t\n    52\tdescribe(\"Flow 2 (SDK): message projection\", () => {\n    53\t  it(\"TC-2.2: one of each kind projects six messages with kind-appropriate blocks; turn_end stays event-only (AC-2.2, AC-2.3)\", async () => {\n    54\t    const filePath = await createThread();\n    55\t    const batch = [\n    56\t      validEvent(\"user_prompt\", { payload: { text: \"please summarize the file\" } }),\n    57\t      validEvent(\"assistant_text\", { payload: { text: \"the file describes turn handling\" } }),\n    58\t      validEvent(\"assistant_thinking\", { payload: { text: \"the request needs the file first\" } }),\n    59\t      validEvent(\"runtime_note\", { payload: { text: \"harness reconnected\" } }),\n    60\t      validEvent(\"tool_call\", {\n    61\t        payload: {\n    62\t          toolCallId: \"call-42\",\n    63\t          toolName: \"read_file\",\n    64\t          arguments: { path: \"notes.txt\", offset: 10 },\n    65\t        },\n    66\t      }),\n    67\t      validEvent(\"tool_result\", {\n    68\t        payload: { toolCallId: \"call-42\", content: \"line one\\nline two\", isError: false },\n    69\t      }),\n    70\t      validEvent(\"turn_end\"),\n    71\t    ];\n    72\t\n    73\t    const result = await intakeStream.messageEvents({ filePath }, batch);\n    74\t    expect(result.ok).toBe(true);\n    75\t    if (!result.ok) return;\n    76\t\n    77\t    // messageId appears on every recorded message-producing entry, in walk\n    78\t    // order; the turn_end entry is recorded but carries no messageId.\n    79\t    expect(result.value.events.map((entry) => entry.outcome)).toEqual(\n    80\t      Array.from({ length: 7 }, () => \"recorded\"),\n    81\t    );\n    82\t    expect(result.value.events.map((entry) => entry.messageId)).toEqual([\n    83\t      \"m1\",\n    84\t      \"m2\",\n    85\t      \"m3\",\n    86\t      \"m4\",\n    87\t      \"m5\",\n    88\t      \"m6\",\n    89\t      undefined,\n    90\t    ]);\n    91\t\n    92\t    // turn_end is present in the event order but absent from messages.\n    93\t    expect((await readEvents(filePath)).map((event) => event.eventKind)).toEqual([\n    94\t      \"user_prompt\",\n    95\t      \"assistant_text\",\n    96\t      \"assistant_thinking\",\n    97\t      \"runtime_note\",\n    98\t      \"tool_call\",\n    99\t      \"tool_result\",\n   100\t      \"turn_end\",\n   101\t    ]);\n   102\t\n   103\t    const projected = await readMessages(filePath);\n   104\t    expect(projected.map((message) => message.messageId)).toEqual([\n   105\t      \"m1\",\n   106\t      \"m2\",\n   107\t      \"m3\",\n   108\t      \"m4\",\n   109\t      \"m5\",\n   110\t      \"m6\",\n   111\t    ]);\n   112\t    expect(projected.map((message) => message.sourceEventOrder)).toEqual([1, 2, 3, 4, 5, 6]);\n   113\t    expect(projected.map((message) => message.kind)).toEqual([\n   114\t      \"user_prompt\",\n   115\t      \"assistant_text\",\n   116\t      \"assistant_thinking\",\n   117\t      \"runtime_note\",\n   118\t      \"tool_call\",\n   119\t      \"tool_result\",\n   120\t    ]);\n   121\t\n   122\t    // Full block structure per kind, content verbatim — not just block count.\n   123\t    expect(projected[0]!.blocks).toEqual([\n   124\t      { blockType: \"text\", content: { text: \"please summarize the file\" } },\n   125\t    ]);\n   126\t    expect(projected[1]!.blocks).toEqual([\n   127\t      { blockType: \"text\", content: { text: \"the file describes turn handling\" } },\n   128\t    ]);\n   129\t    expect(projected[2]!.blocks).toEqual([\n   130\t      { blockType: \"text\", content: { text: \"the request needs the file first\" } },\n   131\t    ]);\n   132\t    expect(projected[3]!.blocks).toEqual([\n   133\t      { blockType: \"text\", content: { text: \"harness reconnected\" } },\n   134\t    ]);\n   135\t    expect(projected[4]!.blocks).toEqual([\n   136\t      {\n   137\t        blockType: \"tool_call\",\n   138\t        content: {\n   139\t          toolCallId: \"call-42\",\n   140\t          toolName: \"read_file\",\n   141\t          arguments: { path: \"notes.txt\", offset: 10 },\n   142\t        },\n   143\t      },\n   144\t    ]);\n   145\t    expect(projected[5]!.blocks).toEqual([\n   146\t      {\n   147\t        blockType: \"tool_result\",\n   148\t        content: { toolCallId: \"call-42\", content: \"line one\\nline two\", isError: false },\n   149\t      },\n   150\t    ]);\n   151\t\n   152\t    // turnId stays unset until Story 4 stamps membership.\n   153\t    for (const message of projected) {\n   154\t      expect(message.turnId).toBeUndefined();\n   155\t    }\n   156\t  });\n   157\t\n   158\t  it(\"TC-2.3: identical content in two threads yields identical token estimates; every message carries one (AC-2.4)\", async () => {\n   159\t    const threadA = await createThread();\n   160\t    const threadB = await createThread();\n   161\t    const buildBatch = () => [\n   162\t      validEvent(\"user_prompt\", { payload: { text: \"estimate me consistently\" } }),\n   163\t      validEvent(\"tool_call\", {\n   164\t        payload: { toolCallId: \"c1\", toolName: \"search\", arguments: { query: \"same query\" } },\n   165\t      }),\n   166\t      validEvent(\"tool_result\", {\n   167\t        payload: { toolCallId: \"c1\", content: \"same result content\", isError: false },\n   168\t      }),\n   169\t    ];\n   170\t\n   171\t    const inA = await intakeStream.messageEvents({ filePath: threadA }, buildBatch());\n   172\t    const inB = await intakeStream.messageEvents({ filePath: threadB }, buildBatch());\n   173\t    expect(inA.ok).toBe(true);\n   174\t    expect(inB.ok).toBe(true);\n   175\t\n   176\t    const messagesA = await readMessages(threadA);\n   177\t    const messagesB = await readMessages(threadB);\n   178\t    expect(messagesA).toHaveLength(3);\n   179\t    for (const message of [...messagesA, ...messagesB]) {\n   180\t      expect(typeof message.tokenEstimate).toBe(\"number\");\n   181\t      expect(Number.isInteger(message.tokenEstimate)).toBe(true);\n   182\t      expect(message.tokenEstimate).toBeGreaterThan(0);\n   183\t    }\n   184\t    expect(messagesA.map((message) => message.tokenEstimate)).toEqual(\n   185\t      messagesB.map((message) => message.tokenEstimate),\n   186\t    );\n   187\t  });\n   188\t\n   189\t  it(\"TC-2.4: a 300KB tool result reads back byte-identical through the SDK (AC-2.5)\", async () => {\n   190\t    const filePath = await createThread();\n   191\t    // Varied content (unicode included) repeated past any rendering\n   192\t    // threshold; byte-identity is asserted on the full string, not a length\n   193\t    // or checksum shortcut.\n   194\t    const bigContent = \"tool output line δσπ 😀 — verbatim?\\n\".repeat(8000);\n   195\t    expect(Buffer.byteLength(bigContent, \"utf8\")).toBeGreaterThan(300_000);\n   196\t\n   197\t    const result = await intakeStream.messageEvents({ filePath }, [\n   198\t      validEvent(\"tool_result\", {\n   199\t        payload: { toolCallId: \"big-1\", content: bigContent, isError: false },\n   200\t      }),\n   201\t    ]);\n   202\t    expect(result.ok).toBe(true);\n   203\t\n   204\t    const events = await readEvents(filePath);\n   205\t    expect(events).toHaveLength(1);\n   206\t    expect(events[0]!.eventKind).toBe(\"tool_result\");\n   207\t    if (events[0]!.eventKind !== \"tool_result\") return;\n   208\t    expect(events[0]!.payload.content === bigContent).toBe(true);\n   209\t\n   210\t    const projected = await readMessages(filePath);\n   211\t    expect(projected).toHaveLength(1);\n   212\t    expect(projected[0]!.blocks).toHaveLength(1);\n   213\t    const block = projected[0]!.blocks[0]!;\n   214\t    expect(block.blockType).toBe(\"tool_result\");\n   215\t    expect(block.content[\"content\"] === bigContent).toBe(true);\n   216\t    expect(block.content[\"toolCallId\"]).toBe(\"big-1\");\n   217\t  });\n   218\t\n   219\t  it(\"TC-2.5: actor and harness are recorded as given and carried onto messages (AC-2.6)\", async () => {\n   220\t    const filePath = await createThread();\n   221\t    const batch = [\n   222\t      validEvent(\"user_prompt\", { actor: \"user:lee\", harness: \"pi-extension/1.2\" }),\n   223\t      validEvent(\"assistant_text\", { actor: \"agent:claude\", harness: \"claude-code/2.0\" }),\n   224\t    ];\n   225\t    const result = await intakeStream.messageEvents({ filePath }, batch);\n   226\t    expect(result.ok).toBe(true);\n   227\t\n   228\t    const events = await readEvents(filePath);\n   229\t    expect(events.map((event) => [event.actor, event.harness])).toEqual([\n   230\t      [\"user:lee\", \"pi-extension/1.2\"],\n   231\t      [\"agent:claude\", \"claude-code/2.0\"],\n   232\t    ]);\n   233\t\n   234\t    const projected = await readMessages(filePath);\n   235\t    expect(projected.map((message) => [message.actor, message.harness])).toEqual([\n   236\t      [\"user:lee\", \"pi-extension/1.2\"],\n   237\t      [\"agent:claude\", \"claude-code/2.0\"],\n   238\t    ]);\n   239\t  });\n   240\t\n   241\t  it(\"TC-5.4 (message clause): a skipped event creates no duplicate message (AC-5.4)\", async () => {\n   242\t    const filePath = await createThread();\n   243\t    const batch = eventBatch([\"user_prompt\", \"turn_end\"]);\n   244\t    const first = await intakeStream.messageEvents({ filePath }, batch);\n   245\t    expect(first.ok).toBe(true);\n   246\t    const baseline = await readMessages(filePath);\n   247\t    expect(baseline).toHaveLength(1);\n   248\t\n   249\t    const resend = await intakeStream.messageEvents({ filePath }, batch);\n   250\t    expect(resend.ok).toBe(true);\n   251\t    if (!resend.ok) return;\n   252\t    expect(resend.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n   253\t    expect(resend.value.events.every((entry) => entry.messageId === undefined)).toBe(true);\n   254\t\n   255\t    expect(await readMessages(filePath)).toEqual(baseline);\n   256\t\n   257\t    // Below the SDK: exactly one message row per source event order.\n   258\t    const db = openRaw(filePath);\n   259\t    try {\n   260\t      const counts = db\n   261\t        .prepare(\"SELECT source_event_order, COUNT(*) AS n FROM message GROUP BY source_event_order\")\n   262\t        .all() as unknown as Array<{ source_event_order: number | bigint; n: number | bigint }>;\n   263\t      expect(counts).toHaveLength(1);\n   264\t      expect(Number(counts[0]!.n)).toBe(1);\n   265\t    } finally {\n   266\t      db.close();\n   267\t    }\n   268\t  });\n   269\t\n   270\t  it(\"architecture-risk: an induced projection failure rejects the whole batch — no recorded events without messages\", async () => {\n   271\t    const filePath = await createThread();\n   272\t    const seeded = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   273\t    expect(seeded.ok).toBe(true);\n   274\t    const baselineEvents = await readEvents(filePath);\n   275\t    const baselineMessages = await readMessages(filePath);\n   276\t    expect(baselineEvents).toHaveLength(1);\n   277\t    expect(baselineMessages).toHaveLength(1);\n   278\t\n   279\t    // Real mechanism: after the new batch's first event records and projects,\n   280\t    // the seam drops the block table, so the second event's projection insert\n   281\t    // fails inside the transaction.\n   282\t    setIntakeWalkHook((db, eventIndex) => {\n   283\t      if (eventIndex === 0) db.exec(\"DROP TABLE message_block\");\n   284\t    });\n   285\t    const result = await intakeStream.messageEvents(\n   286\t      { filePath },\n   287\t      eventBatch([\"assistant_text\", \"assistant_thinking\"]),\n   288\t    );\n   289\t    setIntakeWalkHook(null);\n   290\t    expect(result.ok).toBe(false);\n   291\t    if (result.ok) return;\n   292\t    expect(result.error.errorClass).toBe(\"system_error\");\n   293\t    expect(result.error.code).toBe(\"storage_failure\");\n   294\t\n   295\t    // Read-back state, not the error result alone: events and messages are\n   296\t    // both at baseline — projection failure stranded no event rows.\n   297\t    expect(await readEvents(filePath)).toEqual(baselineEvents);\n   298\t    expect(await readMessages(filePath)).toEqual(baselineMessages);\n   299\t  });\n   300\t});\n   301\t\n   302\tdescribe(\"Flow 2 (CLI in-process): messages list\", () => {\n   303\t  it(\"lists projected messages with blocks and estimates as JSON\", async () => {\n   304\t    const filePath = await createThread();\n   305\t    const recorded = await intakeStream.messageEvents({ filePath }, [\n   306\t      validEvent(\"user_prompt\", { payload: { text: \"cli read-back\" } }),\n   307\t      validEvent(\"turn_end\"),\n   308\t    ]);\n   309\t    expect(recorded.ok).toBe(true);\n   310\t\n   311\t    const listed = await runCli([\"messages\", \"list\", \"--file-path\", filePath]);\n   312\t    expect(listed.exitCode).toBe(0);\n   313\t    const parsed = JSON.parse(listed.stdout) as {\n   314\t      ok: boolean;\n   315\t      value: Array<{\n   316\t        messageId: string;\n   317\t        kind: string;\n   318\t        blocks: Array<{ blockType: string; content: { text?: string } }>;\n   319\t        tokenEstimate: number;\n   320\t      }>;\n   321\t    };\n   322\t    expect(parsed.ok).toBe(true);\n   323\t    expect(parsed.value).toHaveLength(1);\n   324\t    expect(parsed.value[0]!.messageId).toBe(\"m1\");\n   325\t    expect(parsed.value[0]!.kind).toBe(\"user_prompt\");\n   326\t    expect(parsed.value[0]!.blocks).toEqual([\n   327\t      { blockType: \"text\", content: { text: \"cli read-back\" } },\n   328\t    ]);\n   329\t    expect(parsed.value[0]!.tokenEstimate).toBeGreaterThan(0);\n   330\t  });\n   331\t});\n","exit_code":0,"status":"completed"}}

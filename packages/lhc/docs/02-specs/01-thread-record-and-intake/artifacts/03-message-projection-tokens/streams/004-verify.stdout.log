{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/threads/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     3\timport {\n     4\t  createThreadFile,\n     5\t  deleteThreadFile,\n     6\t  generateThreadId,\n     7\t} from \"./internal/create.js\";\n     8\timport {\n     9\t  insertThreadRow,\n    10\t  openRegistryForRead,\n    11\t  openRegistryForWrite,\n    12\t  resolveRegistryPath,\n    13\t  selectAllThreadRows,\n    14\t  selectThreadRow,\n    15\t  type RegistryRow,\n    16\t} from \"./internal/registry.js\";\n    17\t\n    18\texport type ThreadRef =\n    19\t  | { threadId: string; registryPath?: string }\n    20\t  | { filePath: string };\n    21\t\n    22\texport interface NewThreadInput {\n    23\t  filePath: string;\n    24\t  title?: string;\n    25\t  registryPath?: string;\n    26\t}\n    27\t\n    28\texport interface ThreadInfo {\n    29\t  threadId: string;\n    30\t  filePath: string;\n    31\t  title?: string;\n    32\t  createdAt: string; // ISO-8601\n    33\t}\n    34\t\n    35\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n    36\t  const info: ThreadInfo = {\n    37\t    threadId: row.threadId,\n    38\t    filePath: row.filePath,\n    39\t    createdAt: row.createdAt,\n    40\t  };\n    41\t  if (row.title !== undefined) info.title = row.title;\n    42\t  return info;\n    43\t}\n    44\t\n    45\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n    46\t  return {\n    47\t    ok: false,\n    48\t    error: {\n    49\t      errorClass: \"caller_error\",\n    50\t      code: \"thread_not_found\",\n    51\t      reason: `no thread registered with id ${threadId}`,\n    52\t    },\n    53\t  };\n    54\t}\n    55\t\n    56\tfunction detail(cause: unknown): string {\n    57\t  return cause instanceof Error ? cause.message : String(cause);\n    58\t}\n    59\t\n    60\t// Creation spans two databases that cannot share a transaction. Order is\n    61\t// file-then-row with compensation: the invariant \"no registry row without\n    62\t// its file\" is absolute; an orphan file from a crash between the writes is\n    63\t// documented harmless (design decision 2).\n    64\texport async function newThread(\n    65\t  input: NewThreadInput,\n    66\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n    67\t  if (existsSync(input.filePath)) {\n    68\t    return {\n    69\t      ok: false,\n    70\t      error: {\n    71\t        errorClass: \"caller_error\",\n    72\t        code: \"path_exists\",\n    73\t        reason: `a file already exists at ${input.filePath}`,\n    74\t      },\n    75\t    };\n    76\t  }\n    77\t\n    78\t  const threadId = generateThreadId();\n    79\t  const createdAt = new Date().toISOString();\n    80\t\n    81\t  try {\n    82\t    createThreadFile(input.filePath, threadId, createdAt);\n    83\t  } catch (cause) {\n    84\t    deleteThreadFile(input.filePath);\n    85\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n    86\t  }\n    87\t\n    88\t  let registry;\n    89\t  try {\n    90\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n    91\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n    92\t    if (input.title !== undefined) row.title = input.title;\n    93\t    insertThreadRow(registry, row);\n    94\t  } catch (cause) {\n    95\t    deleteThreadFile(input.filePath);\n    96\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n    97\t  } finally {\n    98\t    registry?.close();\n    99\t  }\n   100\t\n   101\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n   102\t}\n   103\t\n   104\texport async function resolve(input: {\n   105\t  threadId: string;\n   106\t  registryPath?: string;\n   107\t}): Promise<OpResult<ThreadInfo>> {\n   108\t  let registry;\n   109\t  try {\n   110\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n   111\t    if (registry === null) return threadNotFound(input.threadId);\n   112\t    const row = selectThreadRow(registry, input.threadId);\n   113\t    if (row === undefined) return threadNotFound(input.threadId);\n   114\t    return { ok: true, value: toThreadInfo(row) };\n   115\t  } catch (cause) {\n   116\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   117\t  } finally {\n   118\t    registry?.close();\n   119\t  }\n   120\t}\n   121\t\n   122\texport async function listThreads(input?: {\n   123\t  registryPath?: string;\n   124\t}): Promise<OpResult<ThreadInfo[]>> {\n   125\t  let registry;\n   126\t  try {\n   127\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n   128\t    if (registry === null) return { ok: true, value: [] };\n   129\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n   130\t  } catch (cause) {\n   131\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   132\t  } finally {\n   133\t    registry?.close();\n   134\t  }\n   135\t}\n   136\t\n   137\t// The single interpreter of thread references: { threadId } resolves to a\n   138\t// path through the registry, { filePath } passes through untouched. No other\n   139\t// code ever reads a thread reference.\n   140\texport async function resolveThreadRef(\n   141\t  ref: ThreadRef,\n   142\t): Promise<OpResult<{ filePath: string }>> {\n   143\t  if (\"threadId\" in ref) {\n   144\t    const resolved = await resolve(ref);\n   145\t    if (!resolved.ok) return resolved;\n   146\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n   147\t  }\n   148\t  return { ok: true, value: { filePath: ref.filePath } };\n   149\t}\n","exit_code":0,"status":"completed"}}

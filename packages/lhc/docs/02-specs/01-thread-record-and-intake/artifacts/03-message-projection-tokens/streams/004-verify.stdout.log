{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/intake-stream/internal/pipeline.ts'","aggregated_output":"     1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n     2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n     3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n     4\t// Stories 3–5 extend the same per-event walk with projection, turn\n     5\t// transitions, and work queueing.\n     6\timport { existsSync } from \"node:fs\";\n     7\timport type { DatabaseSync } from \"node:sqlite\";\n     8\timport type { OperationContext } from \"../../../shared/context.js\";\n     9\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n    10\timport { openDatabase } from \"../../../shared/storage.js\";\n    11\timport { createFromEvent } from \"../../messages/index.js\";\n    12\timport { resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n    13\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n    14\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n    15\t\n    16\t// Test seam (set only through test/fixtures): called after each event is\n    17\t// processed inside the walk, so atomicity under mid-walk failure can be\n    18\t// induced through a real mechanism — closing the handle — rather than a\n    19\t// mocked transaction object.\n    20\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n    21\tlet walkHook: IntakeWalkHook | null = null;\n    22\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n    23\t  walkHook = hook;\n    24\t}\n    25\t\n    26\t// Test seam (set only through test/fixtures): replaces the wall clock so\n    27\t// recordedAt is sourced deterministically for the public SDK contract proof —\n    28\t// TC-1.4 records the same batch through both reference forms and reads it back\n    29\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n    30\t// production: recording stamps real wall time. An explicit clock argument to\n    31\t// runMessageEvents still wins over the seam.\n    32\tlet injectedClock: (() => Date) | null = null;\n    33\texport function setIntakeClock(clock: (() => Date) | null): void {\n    34\t  injectedClock = clock;\n    35\t}\n    36\t\n    37\tfunction detail(cause: unknown): string {\n    38\t  return cause instanceof Error ? cause.message : String(cause);\n    39\t}\n    40\t\n    41\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    42\t  return {\n    43\t    ok: false,\n    44\t    error: {\n    45\t      errorClass: \"caller_error\",\n    46\t      code: \"thread_not_found\",\n    47\t      reason: `no thread file exists at ${filePath}`,\n    48\t    },\n    49\t  };\n    50\t}\n    51\t\n    52\t// The skip set is read at transaction start and reads only the key column:\n    53\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n    54\t// Chunked to stay under SQLite's bound-parameter limit.\n    55\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n    56\t  const found = new Set<string>();\n    57\t  for (let offset = 0; offset < keys.length; offset += 400) {\n    58\t    const chunk = keys.slice(offset, offset + 400);\n    59\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n    60\t    const rows = db\n    61\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n    62\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    63\t    for (const row of rows) found.add(row.idempotency_key);\n    64\t  }\n    65\t  return found;\n    66\t}\n    67\t\n    68\tfunction threadIdOf(db: DatabaseSync): string {\n    69\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    70\t    | { thread_id: string }\n    71\t    | undefined;\n    72\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n    73\t  return row.thread_id;\n    74\t}\n    75\t\n    76\tfunction maxEventOrder(db: DatabaseSync): number {\n    77\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    78\t    | { max_order: number | bigint | null }\n    79\t    | undefined;\n    80\t  return Number(row?.max_order ?? 0);\n    81\t}\n    82\t\n    83\texport async function runMessageEvents(\n    84\t  thread: ThreadRef,\n    85\t  events: readonly MessageEventInput[],\n    86\t  clock: () => Date = injectedClock ?? (() => new Date()),\n    87\t): Promise<OpResult<BatchResult>> {\n    88\t  // Pure validation first: a rejected batch never opens the file, never takes\n    89\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n    90\t  // not a skip (validation-before-idempotency precedence).\n    91\t  const refFailure = validateThreadRef(thread);\n    92\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n    93\t  const batchFailure = validateEvents(events);\n    94\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n    95\t\n    96\t  const resolved = await resolveThreadRef(thread);\n    97\t  if (!resolved.ok) return resolved;\n    98\t  const { filePath } = resolved.value;\n    99\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   100\t\n   101\t  let db: DatabaseSync;\n   102\t  try {\n   103\t    db = openDatabase(filePath);\n   104\t  } catch (cause) {\n   105\t    return storageFailure(`could not open thread file: ${detail(cause)}`);\n   106\t  }\n   107\t\n   108\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n   109\t  // single-writer violations fail loudly at a defined point.\n   110\t  let inTransaction = false;\n   111\t  try {\n   112\t    db.exec(\"BEGIN IMMEDIATE;\");\n   113\t    inTransaction = true;\n   114\t\n   115\t    const skipSet = recordedKeys(\n   116\t      db,\n   117\t      events.map((event) => event.idempotencyKey),\n   118\t    );\n   119\t    // Order counter from MAX(event_order): only recorded events increment it,\n   120\t    // so skips consume no order numbers and the sequence stays dense.\n   121\t    let lastOrder = maxEventOrder(db);\n   122\t\n   123\t    const insert = db.prepare(\n   124\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   125\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   126\t    );\n   127\t\n   128\t    // Cross-domain calls inside the transaction share the open handle through\n   129\t    // the operation context (design decision 8); built once per batch, never\n   130\t    // stored.\n   131\t    const ctx: OperationContext = { db, clock, threadId: threadIdOf(db) };\n   132\t\n   133\t    const eventResults: BatchResult[\"events\"] = [];\n   134\t    for (const [index, event] of events.entries()) {\n   135\t      if (skipSet.has(event.idempotencyKey)) {\n   136\t        eventResults.push({\n   137\t          idempotencyKey: event.idempotencyKey,\n   138\t          outcome: \"skipped\",\n   139\t          skipReason: \"duplicate_idempotency_key\",\n   140\t        });\n   141\t      } else {\n   142\t        lastOrder += 1;\n   143\t        const recordedAt = clock().toISOString();\n   144\t        insert.run(\n   145\t          lastOrder,\n   146\t          event.eventKind,\n   147\t          event.idempotencyKey,\n   148\t          event.actor,\n   149\t          event.harness,\n   150\t          JSON.stringify(event.payload),\n   151\t          recordedAt,\n   152\t        );\n   153\t        skipSet.add(event.idempotencyKey);\n   154\t        // Projection runs in the same iteration that recorded the event, so\n   155\t        // it can never drift from its source; a projection failure throws\n   156\t        // and rejects the whole batch. Skipped events never reach this call\n   157\t        // (no duplicate message, AC-5.4).\n   158\t        const created = createFromEvent(ctx, {\n   159\t          ...event,\n   160\t          eventOrder: lastOrder,\n   161\t          recordedAt,\n   162\t        });\n   163\t        const entry: BatchResult[\"events\"][number] = {\n   164\t          idempotencyKey: event.idempotencyKey,\n   165\t          outcome: \"recorded\",\n   166\t        };\n   167\t        if (created !== null) entry.messageId = created.messageId;\n   168\t        eventResults.push(entry);\n   169\t      }\n   170\t      walkHook?.(db, index);\n   171\t    }\n   172\t\n   173\t    db.exec(\"COMMIT;\");\n   174\t    inTransaction = false;\n   175\t\n   176\t    return {\n   177\t      ok: true,\n   178\t      value: {\n   179\t        events: eventResults,\n   180\t        turnTransitions: [], // populated by Story 4\n   181\t        queuedWork: [], // populated by Story 5\n   182\t        threadPosition: { lastEventOrder: lastOrder },\n   183\t      },\n   184\t    };\n   185\t  } catch (cause) {\n   186\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n   187\t    // class-independent. The handle may already be gone (induced failure),\n   188\t    // in which case SQLite has already discarded the uncommitted transaction.\n   189\t    if (inTransaction) {\n   190\t      try {\n   191\t        db.exec(\"ROLLBACK;\");\n   192\t      } catch {\n   193\t        // handle closed mid-walk; the open transaction died with it\n   194\t      }\n   195\t    }\n   196\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n   197\t  } finally {\n   198\t    try {\n   199\t      db.close();\n   200\t    } catch {\n   201\t      // already closed by the induced-failure seam\n   202\t    }\n   203\t  }\n   204\t}\n   205\t\n   206\tinterface RawEventRow {\n   207\t  event_order: number | bigint;\n   208\t  event_kind: string;\n   209\t  idempotency_key: string;\n   210\t  actor: string;\n   211\t  harness: string;\n   212\t  payload: string;\n   213\t  recorded_at: string;\n   214\t}\n   215\t\n   216\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n   217\t  const refFailure = validateThreadRef(thread);\n   218\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n   219\t\n   220\t  const resolved = await resolveThreadRef(thread);\n   221\t  if (!resolved.ok) return resolved;\n   222\t  const { filePath } = resolved.value;\n   223\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   224\t\n   225\t  let db: DatabaseSync | undefined;\n   226\t  try {\n   227\t    db = openDatabase(filePath);\n   228\t    const rows = db\n   229\t      .prepare(\n   230\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n   231\t         FROM event ORDER BY event_order`,\n   232\t      )\n   233\t      .all() as unknown as RawEventRow[];\n   234\t    const records = rows.map(\n   235\t      (row) =>\n   236\t        ({\n   237\t          eventKind: row.event_kind,\n   238\t          idempotencyKey: row.idempotency_key,\n   239\t          actor: row.actor,\n   240\t          harness: row.harness,\n   241\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n   242\t          eventOrder: Number(row.event_order),\n   243\t          recordedAt: row.recorded_at,\n   244\t        }) as unknown as EventRecord,\n   245\t    );\n   246\t    return { ok: true, value: records };\n   247\t  } catch (cause) {\n   248\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n   249\t  } finally {\n   250\t    db?.close();\n   251\t  }\n   252\t}\n","exit_code":0,"status":"completed"}}

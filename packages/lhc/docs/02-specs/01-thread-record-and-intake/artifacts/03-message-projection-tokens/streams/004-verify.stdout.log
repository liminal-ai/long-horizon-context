tx: OperationContext,\n+  event: RecordedEvent,\n+): MessageCreated {\n+  const projected = projectEvent(event);\n+  if (projected === null) return null;\n+  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n+  const messageId = `m${event.eventOrder}`;\n+  insertMessage(ctx.db, {\n+    messageId,\n+    sourceEventOrder: event.eventOrder,\n+    kind,\n+    tokenEstimate: projected.tokenEstimate,\n+    actor: event.actor,\n+    harness: event.harness,\n+    blocks: projected.blocks,\n+  });\n+  return { messageId, kind };\n+}\n+\n+function threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n+  return {\n+    ok: false,\n+    error: {\n+      errorClass: \"caller_error\",\n+      code: \"thread_not_found\",\n+      reason: `no thread file exists at ${filePath}`,\n+    },\n+  };\n+}\n+\n export async function listMessages(\n-  _thread: ThreadRef,\n+  thread: ThreadRef,\n ): Promise<OpResult<MessageRecord[]>> {\n-  return notImplemented(\"messages.list\");\n+  const resolved = await resolveThreadRef(thread);\n+  if (!resolved.ok) return resolved;\n+  const { filePath } = resolved.value;\n+  if (!existsSync(filePath)) return threadNotFound(filePath);\n+\n+  let db: DatabaseSync | undefined;\n+  try {\n+    db = openDatabase(filePath);\n+    return { ok: true, value: readMessages(db) };\n+  } catch (cause) {\n+    const reason = cause instanceof Error ? cause.message : String(cause);\n+    return storageFailure(`message read-back failed: ${reason}`);\n+  } finally {\n+    db?.close();\n+  }\n }\n \n export async function listQueuedWork(\ndiff --git a/packages/lhc/src/sdk.ts b/packages/lhc/src/sdk.ts\nindex 9d4e8be..152e904 100644\n--- a/packages/lhc/src/sdk.ts\n+++ b/packages/lhc/src/sdk.ts\n@@ -24,6 +24,11 @@ export type {\n export type { OperationContext } from \"./shared/context.js\";\n \n export type { ThreadRef } from \"./domains/threads/index.js\";\n+export type {\n+  Block,\n+  BlockType,\n+  MessageRecord,\n+} from \"./domains/messages/index.js\";\n export type {\n   BatchResult,\n   EventKind,\ndiff --git a/packages/lhc/test/cli-process.test.ts b/packages/lhc/test/cli-process.test.ts\nindex 817354a..04cf582 100644\n--- a/packages/lhc/test/cli-process.test.ts\n+++ b/packages/lhc/test/cli-process.test.ts\n@@ -42,14 +42,15 @@ describe(\"FC-0.3 (process boundary): built binary\", () => {\n   });\n \n   it(\"a planned command reaches its fail-closed stub through the real binary\", () => {\n-    const result = runBinary([\"messages\", \"list\", \"--thread-id\", \"th_x\"]);\n+    // messages list went live in Story 3; list-queued-work is still stubbed.\n+    const result = runBinary([\"messages\", \"list-queued-work\", \"--thread-id\", \"th_x\"]);\n     expect(result.status).toBe(1);\n     expect(JSON.parse(result.stdout)).toEqual({\n       ok: false,\n       error: {\n         errorClass: \"system_error\",\n         code: \"storage_failure\",\n-        reason: \"not implemented: messages.list\",\n+        reason: \"not implemented: messages.list-queued-work\",\n       },\n     });\n   });\ndiff --git a/packages/lhc/test/smoke.test.ts b/packages/lhc/test/smoke.test.ts\nindex 4e65d21..ceffba1 100644\n--- a/packages/lhc/test/smoke.test.ts\n+++ b/packages/lhc/test/smoke.test.ts\n@@ -1,11 +1,11 @@\n import { describe, expect, it } from \"vitest\";\n import { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n \n-// Story 1 made the threads commands real (test/threads.test.ts) and Story 2\n-// made the intake-stream commands real (test/intake.test.ts); only the\n-// still-stubbed commands remain on this list.\n+// Story 1 made the threads commands real (test/threads.test.ts), Story 2 the\n+// intake-stream commands (test/intake.test.ts), and Story 3 messages list\n+// (test/projection.test.ts); only the still-stubbed commands remain on this\n+// list.\n const PLANNED_COMMANDS: ReadonlyArray<{ argv: string[]; op: string }> = [\n-  { argv: [\"messages\", \"list\", \"--thread-id\", \
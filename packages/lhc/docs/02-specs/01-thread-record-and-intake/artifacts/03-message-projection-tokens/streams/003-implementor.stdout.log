{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016k56Lbc77NPeWvg2Nym73m","type":"tool_result","content":"1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4\t// Stories 3–5 extend the same per-event walk with projection, turn\n5\t// transitions, and work queueing.\n6\timport { existsSync } from \"node:fs\";\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n9\timport { openDatabase } from \"../../../shared/storage.js\";\n10\timport { resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n11\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n12\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n13\t\n14\t// Test seam (set only through test/fixtures): called after each event is\n15\t// processed inside the walk, so atomicity under mid-walk failure can be\n16\t// induced through a real mechanism — closing the handle — rather than a\n17\t// mocked transaction object.\n18\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n19\tlet walkHook: IntakeWalkHook | null = null;\n20\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n21\t  walkHook = hook;\n22\t}\n23\t\n24\t// Test seam (set only through test/fixtures): replaces the wall clock so\n25\t// recordedAt is sourced deterministically for the public SDK contract proof —\n26\t// TC-1.4 records the same batch through both reference forms and reads it back\n27\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n28\t// production: recording stamps real wall time. An explicit clock argument to\n29\t// runMessageEvents still wins over the seam.\n30\tlet injectedClock: (() => Date) | null = null;\n31\texport function setIntakeClock(clock: (() => Date) | null): void {\n32\t  injectedClock = clock;\n33\t}\n34\t\n35\tfunction detail(cause: unknown): string {\n36\t  return cause instanceof Error ? cause.message : String(cause);\n37\t}\n38\t\n39\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n40\t  return {\n41\t    ok: false,\n42\t    error: {\n43\t      errorClass: \"caller_error\",\n44\t      code: \"thread_not_found\",\n45\t      reason: `no thread file exists at ${filePath}`,\n46\t    },\n47\t  };\n48\t}\n49\t\n50\t// The skip set is read at transaction start and reads only the key column:\n51\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n52\t// Chunked to stay under SQLite's bound-parameter limit.\n53\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n54\t  const found = new Set<string>();\n55\t  for (let offset = 0; offset < keys.length; offset += 400) {\n56\t    const chunk = keys.slice(offset, offset + 400);\n57\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n58\t    const rows = db\n59\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n60\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n61\t    for (const row of rows) found.add(row.idempotency_key);\n62\t  }\n63\t  return found;\n64\t}\n65\t\n66\tfunction maxEventOrder(db: DatabaseSync): number {\n67\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n68\t    | { max_order: number | bigint | null }\n69\t    | undefined;\n70\t  return Number(row?.max_order ?? 0);\n71\t}\n72\t\n73\texport async function runMessageEvents(\n74\t  thread: ThreadRef,\n75\t  events: readonly MessageEventInput[],\n76\t  clock: () => Date = injectedClock ?? (() => new Date()),\n77\t): Promise<OpResult<BatchResult>> {\n78\t  // Pure validation first: a rejected batch never opens the file, never takes\n79\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n80\t  // not a skip (validation-before-idempotency precedence).\n81\t  const refFailure = validateThreadRef(thread);\n82\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n83\t  const batchFailure = validateEvents(events);\n84\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n85\t\n86\t  const resolved = await resolveThreadRef(thread);\n87\t  if (!resolved.ok) return resolved;\n88\t  const { filePath } = resolved.value;\n89\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n90\t\n91\t  let db: DatabaseSync;\n92\t  try {\n93\t    db = openDatabase(filePath);\n94\t  } catch (cause) {\n95\t    return storageFailure(`could not open thread file: ${detail(cause)}`);\n96\t  }\n97\t\n98\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n99\t  // single-writer violations fail loudly at a defined point.\n100\t  let inTransaction = false;\n101\t  try {\n102\t    db.exec(\"BEGIN IMMEDIATE;\");\n103\t    inTransaction = true;\n104\t\n105\t    const skipSet = recordedKeys(\n106\t      db,\n107\t      events.map((event) => event.idempotencyKey),\n108\t    );\n109\t    // Order counter from MAX(event_order): only recorded events increment it,\n110\t    // so skips consume no order numbers and the sequence stays dense.\n111\t    let lastOrder = maxEventOrder(db);\n112\t\n113\t    const insert = db.prepare(\n114\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n115\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n116\t    );\n117\t\n118\t    const eventResults: BatchResult[\"events\"] = [];\n119\t    for (const [index, event] of events.entries()) {\n120\t      if (skipSet.has(event.idempotencyKey)) {\n121\t        eventResults.push({\n122\t          idempotencyKey: event.idempotencyKey,\n123\t          outcome: \"skipped\",\n124\t          skipReason: \"duplicate_idempotency_key\",\n125\t        });\n126\t      } else {\n127\t        lastOrder += 1;\n128\t        insert.run(\n129\t          lastOrder,\n130\t          event.eventKind,\n131\t          event.idempotencyKey,\n132\t          event.actor,\n133\t          event.harness,\n134\t          JSON.stringify(event.payload),\n135\t          clock().toISOString(),\n136\t        );\n137\t        skipSet.add(event.idempotencyKey);\n138\t        eventResults.push({ idempotencyKey: event.idempotencyKey, outcome: \"recorded\" });\n139\t      }\n140\t      walkHook?.(db, index);\n141\t    }\n142\t\n143\t    db.exec(\"COMMIT;\");\n144\t    inTransaction = false;\n145\t\n146\t    return {\n147\t      ok: true,\n148\t      value: {\n149\t        events: eventResults,\n150\t        turnTransitions: [], // populated by Story 4\n151\t        queuedWork: [], // populated by Story 5\n152\t        threadPosition: { lastEventOrder: lastOrder },\n153\t      },\n154\t    };\n155\t  } catch (cause) {\n156\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n157\t    // class-independent. The handle may already be gone (induced failure),\n158\t    // in which case SQLite has already discarded the uncommitted transaction.\n159\t    if (inTransaction) {\n160\t      try {\n161\t        db.exec(\"ROLLBACK;\");\n162\t      } catch {\n163\t        // handle closed mid-walk; the open transaction died with it\n164\t      }\n165\t    }\n166\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n167\t  } finally {\n168\t    try {\n169\t      db.close();\n170\t    } catch {\n171\t      // already closed by the induced-failure seam\n172\t    }\n173\t  }\n174\t}\n175\t\n176\tinterface RawEventRow {\n177\t  event_order: number | bigint;\n178\t  event_kind: string;\n179\t  idempotency_key: string;\n180\t  actor: string;\n181\t  harness: string;\n182\t  payload: string;\n183\t  recorded_at: string;\n184\t}\n185\t\n186\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n187\t  const refFailure = validateThreadRef(thread);\n188\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n189\t\n190\t  const resolved = await resolveThreadRef(thread);\n191\t  if (!resolved.ok) return resolved;\n192\t  const { filePath } = resolved.value;\n193\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n194\t\n195\t  let db: DatabaseSync | undefined;\n196\t  try {\n197\t    db = openDatabase(filePath);\n198\t    const rows = db\n199\t      .prepare(\n200\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n201\t         FROM event ORDER BY event_order`,\n202\t      )\n203\t      .all() as unknown as RawEventRow[];\n204\t    const records = rows.map(\n205\t      (row) =>\n206\t        ({\n207\t          eventKind: row.event_kind,\n208\t          idempotencyKey: row.idempotency_key,\n209\t          actor: row.actor,\n210\t          harness: row.harness,\n211\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n212\t          eventOrder: Number(row.event_order),\n213\t          recordedAt: row.recorded_at,\n214\t        }) as unknown as EventRecord,\n215\t    );\n216\t    return { ok: true, value: records };\n217\t  } catch (cause) {\n218\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n219\t  } finally {\n220\t    db?.close();\n221\t  }\n222\t}\n223\t"}]},"parent_tool_use_id":null,"session_id":"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa","uuid":"8ea57dd2-93bd-479f-b235-ad8ddb263283","timestamp":"2026-06-10T13:46:10.225Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n// Stories 3–5 extend the same per-event walk with projection, turn\n// transitions, and work queueing.\nimport { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport { openDatabase } from \"../../../shared/storage.js\";\nimport { resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\nimport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\nimport { validateEvents, validateThreadRef } from \"./validate.js\";\n\n// Test seam (set only through test/fixtures): called after each event is\n// processed inside the walk, so atomicity under mid-walk failure can be\n// induced through a real mechanism — closing the handle — rather than a\n// mocked transaction object.\nexport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\nlet walkHook: IntakeWalkHook | null = null;\nexport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n  walkHook = hook;\n}\n\n// Test seam (set only through test/fixtures): replaces the wall clock so\n// recordedAt is sourced deterministically for the public SDK contract proof —\n// TC-1.4 records the same batch through both reference forms and reads it back\n// field-for-field, recordedAt included, with nothing stripped. Unset in\n// production: recording stamps real wall time. An explicit clock argument to\n// runMessageEvents still wins over the seam.\nlet injectedClock: (() => Date) | null = null;\nexport function setIntakeClock(clock: (() => Date) | null): void {\n  injectedClock = clock;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The skip set is read at transaction start and reads only the key column:\n// key-wins-over-content is the absence of a content comparison (AC-5.5).\n// Chunked to stay under SQLite's bound-parameter limit.\nfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n  const found = new Set<string>();\n  for (let offset = 0; offset < keys.length; offset += 400) {\n    const chunk = keys.slice(offset, offset + 400);\n    const placeholders = chunk.map(() => \"?\").join(\", \");\n    const rows = db\n      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    for (const row of rows) found.add(row.idempotency_key);\n  }\n  return found;\n}\n\nfunction maxEventOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0);\n}\n\nexport async function runMessageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n  clock: () => Date = injectedClock ?? (() => new Date()),\n): Promise<OpResult<BatchResult>> {\n  // Pure validation first: a rejected batch never opens the file, never takes\n  // the write lock, and a duplicate key on a malformed event is a rejection,\n  // not a skip (validation-before-idempotency precedence).\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n  const batchFailure = validateEvents(events);\n  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  let db: DatabaseSync;\n  try {\n    db = openDatabase(filePath);\n  } catch (cause) {\n    return storageFailure(`could not open thread file: ${detail(cause)}`);\n  }\n\n  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n  // single-writer violations fail loudly at a defined point.\n  let inTransaction = false;\n  try {\n    db.exec(\"BEGIN IMMEDIATE;\");\n    inTransaction = true;\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    const eventResults: BatchResult[\"events\"] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          clock().toISOString(),\n        );\n        skipSet.add(event.idempotencyKey);\n        eventResults.push({ idempotencyKey: event.idempotencyKey, outcome: \"recorded\" });\n      }\n      walkHook?.(db, index);\n    }\n\n    db.exec(\"COMMIT;\");\n    inTransaction = false;\n\n    return {\n      ok: true,\n      value: {\n        events: eventResults,\n        turnTransitions: [], // populated by Story 4\n        queuedWork: [], // populated by Story 5\n        threadPosition: { lastEventOrder: lastOrder },\n      },\n    };\n  } catch (cause) {\n    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n    // class-independent. The handle may already be gone (induced failure),\n    // in which case SQLite has already discarded the uncommitted transaction.\n    if (inTransaction) {\n      try {\n        db.exec(\"ROLLBACK;\");\n      } catch {\n        // handle closed mid-walk; the open transaction died with it\n      }\n    }\n    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n  } finally {\n    try {\n      db.close();\n    } catch {\n      // already closed by the induced-failure seam\n    }\n  }\n}\n\ninterface RawEventRow {\n  event_order: number | bigint;\n  event_kind: string;\n  idempotency_key: string;\n  actor: string;\n  harness: string;\n  payload: string;\n  recorded_at: string;\n}\n\nexport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  let db: DatabaseSync | undefined;\n  try {\n    db = openDatabase(filePath);\n    const rows = db\n      .prepare(\n        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n         FROM event ORDER BY event_order`,\n      )\n      .all() as unknown as RawEventRow[];\n    const records = rows.map(\n      (row) =>\n        ({\n          eventKind: row.event_kind,\n          idempotencyKey: row.idempotency_key,\n          actor: row.actor,\n          harness: row.harness,\n          payload: JSON.parse(row.payload) as Record<string, unknown>,\n          eventOrder: Number(row.event_order),\n          recordedAt: row.recorded_at,\n        }) as unknown as EventRecord,\n    );\n    return { ok: true, value: records };\n  } catch (cause) {\n    return storageFailure(`event read-back failed: ${detail(cause)}`);\n  } finally {\n    db?.close();\n  }\n}\n","numLines":223,"startLine":1,"totalLines":223}}}

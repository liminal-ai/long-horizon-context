{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TbkwwHtjpzqTh47xHTrPDe","type":"tool_result","content":"1\t// Flow 5: idempotent resend (TC-5.1 through TC-5.5, asserted at the event\n2\t// level — the no-message / no-transition / no-work-item clauses re-assert in\n3\t// Stories 3-5 as those records exist).\n4\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n5\timport { intakeStream, threads, type EventRecord } from \"../src/index.js\";\n6\timport { conversationTurn, eventBatch, openRaw, tempStore, validEvent, type TempStore } from \"./fixtures/index.js\";\n7\t\n8\tlet store: TempStore;\n9\tbeforeEach(() => {\n10\t  store = tempStore();\n11\t});\n12\tafterEach(() => {\n13\t  store.cleanup();\n14\t});\n15\t\n16\tasync function createThread(): Promise<string> {\n17\t  const filePath = store.threadPath();\n18\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n19\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n20\t  return filePath;\n21\t}\n22\t\n23\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n24\t  const result = await intakeStream.listEvents({ filePath });\n25\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n26\t  return result.value;\n27\t}\n28\t\n29\t// Serializes every row of every table for below-SDK absence assertions.\n30\tfunction rawDump(filePath: string): string {\n31\t  const db = openRaw(filePath);\n32\t  try {\n33\t    const tables = db\n34\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table'\")\n35\t      .all() as unknown as Array<{ name: string }>;\n36\t    let dump = \"\";\n37\t    for (const table of tables) {\n38\t      dump += JSON.stringify(db.prepare(`SELECT * FROM \"${table.name}\"`).all());\n39\t    }\n40\t    return dump;\n41\t  } finally {\n42\t    db.close();\n43\t  }\n44\t}\n45\t\n46\tdescribe(\"Flow 5 (SDK): idempotent resend\", () => {\n47\t  it(\"TC-5.1: resending a fully recorded batch skips everything and changes nothing\", async () => {\n48\t    const filePath = await createThread();\n49\t    const batch = conversationTurn();\n50\t    const first = await intakeStream.messageEvents({ filePath }, batch);\n51\t    expect(first.ok).toBe(true);\n52\t    if (!first.ok) return;\n53\t    expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n54\t    expect(first.value.threadPosition.lastEventOrder).toBe(5);\n55\t    const baseline = await readBack(filePath);\n56\t\n57\t    const resend = await intakeStream.messageEvents({ filePath }, batch);\n58\t    expect(resend.ok).toBe(true);\n59\t    if (!resend.ok) return;\n60\t    expect(resend.value.events).toHaveLength(5);\n61\t    for (const [index, entry] of resend.value.events.entries()) {\n62\t      expect(entry.outcome).toBe(\"skipped\");\n63\t      expect(entry.skipReason).toBe(\"duplicate_idempotency_key\");\n64\t      expect(entry.idempotencyKey).toBe(batch[index]!.idempotencyKey);\n65\t    }\n66\t    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n67\t\n68\t    expect(await readBack(filePath)).toEqual(baseline);\n69\t  });\n70\t\n71\t  it(\"TC-5.2: partial resend skips the old, records the new, and keeps the order dense\", async () => {\n72\t    const filePath = await createThread();\n73\t    const old = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n74\t    const first = await intakeStream.messageEvents({ filePath }, old);\n75\t    expect(first.ok).toBe(true);\n76\t\n77\t    const fresh = [validEvent(\"tool_result\"), validEvent(\"turn_end\")];\n78\t    const resend = await intakeStream.messageEvents({ filePath }, [...old, ...fresh]);\n79\t    expect(resend.ok).toBe(true);\n80\t    if (!resend.ok) return;\n81\t    expect(resend.value.events.map((entry) => entry.outcome)).toEqual([\n82\t      \"skipped\",\n83\t      \"skipped\",\n84\t      \"skipped\",\n85\t      \"recorded\",\n86\t      \"recorded\",\n87\t    ]);\n88\t    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n89\t\n90\t    const events = await readBack(filePath);\n91\t    expect(events.map((event) => event.eventOrder)).toEqual([1, 2, 3, 4, 5]);\n92\t    expect(events[3]!.idempotencyKey).toBe(fresh[0]!.idempotencyKey);\n93\t    expect(events[4]!.idempotencyKey).toBe(fresh[1]!.idempotencyKey);\n94\t  });\n95\t\n96\t  it(\"TC-5.3: idempotency keys are scoped to the thread — same key records in both threads\", async () => {\n97\t    const threadA = await createThread();\n98\t    const threadB = await createThread();\n99\t    const event = validEvent(\"user_prompt\", { idempotencyKey: \"shared-key-1\" });\n100\t\n101\t    const inA = await intakeStream.messageEvents({ filePath: threadA }, [event]);\n102\t    const inB = await intakeStream.messageEvents({ filePath: threadB }, [event]);\n103\t    expect(inA.ok).toBe(true);\n104\t    expect(inB.ok).toBe(true);\n105\t    if (!inA.ok || !inB.ok) return;\n106\t    expect(inA.value.events[0]!.outcome).toBe(\"recorded\");\n107\t    expect(inB.value.events[0]!.outcome).toBe(\"recorded\");\n108\t\n109\t    expect((await readBack(threadA)).map((e) => e.idempotencyKey)).toEqual([\"shared-key-1\"]);\n110\t    expect((await readBack(threadB)).map((e) => e.idempotencyKey)).toEqual([\"shared-key-1\"]);\n111\t  });\n112\t\n113\t  it(\"TC-5.4: skips are inert — no duplicate rows, no order numbers consumed, no transitions reported\", async () => {\n114\t    const filePath = await createThread();\n115\t    const batch = eventBatch([\"user_prompt\", \"turn_end\"]);\n116\t    const first = await intakeStream.messageEvents({ filePath }, batch);\n117\t    expect(first.ok).toBe(true);\n118\t\n119\t    const resend = await intakeStream.messageEvents({ filePath }, batch);\n120\t    expect(resend.ok).toBe(true);\n121\t    if (!resend.ok) return;\n122\t    expect(resend.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n123\t    expect(resend.value.turnTransitions).toEqual([]);\n124\t    expect(resend.value.queuedWork).toEqual([]);\n125\t\n126\t    // No duplicate event rows: each key appears exactly once below the SDK.\n127\t    const db = openRaw(filePath);\n128\t    try {\n129\t      const counts = db\n130\t        .prepare(\"SELECT idempotency_key, COUNT(*) AS n FROM event GROUP BY idempotency_key\")\n131\t        .all() as unknown as Array<{ idempotency_key: string; n: number | bigint }>;\n132\t      expect(counts).toHaveLength(2);\n133\t      for (const row of counts) expect(Number(row.n)).toBe(1);\n134\t    } finally {\n135\t      db.close();\n136\t    }\n137\t\n138\t    // Skips consumed no order numbers: the next recorded event lands at 3.\n139\t    const next = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n140\t    expect(next.ok).toBe(true);\n141\t    if (!next.ok) return;\n142\t    expect(next.value.threadPosition.lastEventOrder).toBe(3);\n143\t    expect((await readBack(filePath)).map((e) => e.eventOrder)).toEqual([1, 2, 3]);\n144\t  });\n145\t\n146\t  it(\"TC-5.5: key wins over content — original payload intact, resent payload stored nowhere\", async () => {\n147\t    const filePath = await createThread();\n148\t    const original = validEvent(\"user_prompt\", {\n149\t      idempotencyKey: \"key-K\",\n150\t      payload: { text: \"PAYLOAD-A-ORIGINAL\" },\n151\t    });\n152\t    const first = await intakeStream.messageEvents({ filePath }, [original]);\n153\t    expect(first.ok).toBe(true);\n154\t\n155\t    const reused = validEvent(\"user_prompt\", {\n156\t      idempotencyKey: \"key-K\",\n157\t      payload: { text: \"PAYLOAD-B-MUST-VANISH\" },\n158\t    });\n159\t    const resend = await intakeStream.messageEvents({ filePath }, [reused]);\n160\t    expect(resend.ok).toBe(true);\n161\t    if (!resend.ok) return;\n162\t    expect(resend.value.events[0]).toEqual({\n163\t      idempotencyKey: \"key-K\",\n164\t      outcome: \"skipped\",\n165\t      skipReason: \"duplicate_idempotency_key\",\n166\t    });\n167\t\n168\t    const events = await readBack(filePath);\n169\t    expect(events).toHaveLength(1);\n170\t    expect(events[0]!.payload).toEqual({ text: \"PAYLOAD-A-ORIGINAL\" });\n171\t\n172\t    // openRaw scan: payload B appears in no table at all.\n173\t    const dump = rawDump(filePath);\n174\t    expect(dump).toContain(\"PAYLOAD-A-ORIGINAL\");\n175\t    expect(dump).not.toContain(\"PAYLOAD-B-MUST-VANISH\");\n176\t  });\n177\t});\n178\t"}]},"parent_tool_use_id":null,"session_id":"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa","uuid":"f656872b-d1b0-423c-998e-ee05fd6c0415","timestamp":"2026-06-10T13:47:31.985Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/idempotency.test.ts","content":"// Flow 5: idempotent resend (TC-5.1 through TC-5.5, asserted at the event\n// level — the no-message / no-transition / no-work-item clauses re-assert in\n// Stories 3-5 as those records exist).\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { intakeStream, threads, type EventRecord } from \"../src/index.js\";\nimport { conversationTurn, eventBatch, openRaw, tempStore, validEvent, type TempStore } from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nasync function createThread(): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function readBack(filePath: string): Promise<EventRecord[]> {\n  const result = await intakeStream.listEvents({ filePath });\n  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n  return result.value;\n}\n\n// Serializes every row of every table for below-SDK absence assertions.\nfunction rawDump(filePath: string): string {\n  const db = openRaw(filePath);\n  try {\n    const tables = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table'\")\n      .all() as unknown as Array<{ name: string }>;\n    let dump = \"\";\n    for (const table of tables) {\n      dump += JSON.stringify(db.prepare(`SELECT * FROM \"${table.name}\"`).all());\n    }\n    return dump;\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"Flow 5 (SDK): idempotent resend\", () => {\n  it(\"TC-5.1: resending a fully recorded batch skips everything and changes nothing\", async () => {\n    const filePath = await createThread();\n    const batch = conversationTurn();\n    const first = await intakeStream.messageEvents({ filePath }, batch);\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.events.every((entry) => entry.outcome === \"recorded\")).toBe(true);\n    expect(first.value.threadPosition.lastEventOrder).toBe(5);\n    const baseline = await readBack(filePath);\n\n    const resend = await intakeStream.messageEvents({ filePath }, batch);\n    expect(resend.ok).toBe(true);\n    if (!resend.ok) return;\n    expect(resend.value.events).toHaveLength(5);\n    for (const [index, entry] of resend.value.events.entries()) {\n      expect(entry.outcome).toBe(\"skipped\");\n      expect(entry.skipReason).toBe(\"duplicate_idempotency_key\");\n      expect(entry.idempotencyKey).toBe(batch[index]!.idempotencyKey);\n    }\n    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n\n    expect(await readBack(filePath)).toEqual(baseline);\n  });\n\n  it(\"TC-5.2: partial resend skips the old, records the new, and keeps the order dense\", async () => {\n    const filePath = await createThread();\n    const old = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n    const first = await intakeStream.messageEvents({ filePath }, old);\n    expect(first.ok).toBe(true);\n\n    const fresh = [validEvent(\"tool_result\"), validEvent(\"turn_end\")];\n    const resend = await intakeStream.messageEvents({ filePath }, [...old, ...fresh]);\n    expect(resend.ok).toBe(true);\n    if (!resend.ok) return;\n    expect(resend.value.events.map((entry) => entry.outcome)).toEqual([\n      \"skipped\",\n      \"skipped\",\n      \"skipped\",\n      \"recorded\",\n      \"recorded\",\n    ]);\n    expect(resend.value.threadPosition.lastEventOrder).toBe(5);\n\n    const events = await readBack(filePath);\n    expect(events.map((event) => event.eventOrder)).toEqual([1, 2, 3, 4, 5]);\n    expect(events[3]!.idempotencyKey).toBe(fresh[0]!.idempotencyKey);\n    expect(events[4]!.idempotencyKey).toBe(fresh[1]!.idempotencyKey);\n  });\n\n  it(\"TC-5.3: idempotency keys are scoped to the thread — same key records in both threads\", async () => {\n    const threadA = await createThread();\n    const threadB = await createThread();\n    const event = validEvent(\"user_prompt\", { idempotencyKey: \"shared-key-1\" });\n\n    const inA = await intakeStream.messageEvents({ filePath: threadA }, [event]);\n    const inB = await intakeStream.messageEvents({ filePath: threadB }, [event]);\n    expect(inA.ok).toBe(true);\n    expect(inB.ok).toBe(true);\n    if (!inA.ok || !inB.ok) return;\n    expect(inA.value.events[0]!.outcome).toBe(\"recorded\");\n    expect(inB.value.events[0]!.outcome).toBe(\"recorded\");\n\n    expect((await readBack(threadA)).map((e) => e.idempotencyKey)).toEqual([\"shared-key-1\"]);\n    expect((await readBack(threadB)).map((e) => e.idempotencyKey)).toEqual([\"shared-key-1\"]);\n  });\n\n  it(\"TC-5.4: skips are inert — no duplicate rows, no order numbers consumed, no transitions reported\", async () => {\n    const filePath = await createThread();\n    const batch = eventBatch([\"user_prompt\", \"turn_end\"]);\n    const first = await intakeStream.messageEvents({ filePath }, batch);\n    expect(first.ok).toBe(true);\n\n    const resend = await intakeStream.messageEvents({ filePath }, batch);\n    expect(resend.ok).toBe(true);\n    if (!resend.ok) return;\n    expect(resend.value.events.every((entry) => entry.outcome === \"skipped\")).toBe(true);\n    expect(resend.value.turnTransitions).toEqual([]);\n    expect(resend.value.queuedWork).toEqual([]);\n\n    // No duplicate event rows: each key appears exactly once below the SDK.\n    const db = openRaw(filePath);\n    try {\n      const counts = db\n        .prepare(\"SELECT idempotency_key, COUNT(*) AS n FROM event GROUP BY idempotency_key\")\n        .all() as unknown as Array<{ idempotency_key: string; n: number | bigint }>;\n      expect(counts).toHaveLength(2);\n      for (const row of counts) expect(Number(row.n)).toBe(1);\n    } finally {\n      db.close();\n    }\n\n    // Skips consumed no order numbers: the next recorded event lands at 3.\n    const next = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n    expect(next.ok).toBe(true);\n    if (!next.ok) return;\n    expect(next.value.threadPosition.lastEventOrder).toBe(3);\n    expect((await readBack(filePath)).map((e) => e.eventOrder)).toEqual([1, 2, 3]);\n  });\n\n  it(\"TC-5.5: key wins over content — original payload intact, resent payload stored nowhere\", async () => {\n    const filePath = await createThread();\n    const original = validEvent(\"user_prompt\", {\n      idempotencyKey: \"key-K\",\n      payload: { text: \"PAYLOAD-A-ORIGINAL\" },\n    });\n    const first = await intakeStream.messageEvents({ filePath }, [original]);\n    expect(first.ok).toBe(true);\n\n    const reused = validEvent(\"user_prompt\", {\n      idempotencyKey: \"key-K\",\n      payload: { text: \"PAYLOAD-B-MUST-VANISH\" },\n    });\n    const resend = await intakeStream.messageEvents({ filePath }, [reused]);\n    expect(resend.ok).toBe(true);\n    if (!resend.ok) return;\n    expect(resend.value.events[0]).toEqual({\n      idempotencyKey: \"key-K\",\n      outcome: \"skipped\",\n      skipReason: \"duplicate_idempotency_key\",\n    });\n\n    const events = await readBack(filePath);\n    expect(events).toHaveLength(1);\n    expect(events[0]!.payload).toEqual({ text: \"PAYLOAD-A-ORIGINAL\" });\n\n    // openRaw scan: payload B appears in no table at all.\n    const dump = rawDump(filePath);\n    expect(dump).toContain(\"PAYLOAD-A-ORIGINAL\");\n    expect(dump).not.toContain(\"PAYLOAD-B-MUST-VANISH\");\n  });\n});\n","numLines":178,"startLine":1,"totalLines":178}}}

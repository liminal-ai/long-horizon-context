{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ZsJ2bfy9V95V8sBYLye5e","type":"tool_result","content":"1\timport { mkdtempSync, rmSync } from \"node:fs\";\n2\timport { tmpdir } from \"node:os\";\n3\timport { join } from \"node:path\";\n4\timport { DatabaseSync } from \"node:sqlite\";\n5\timport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n6\t\n7\texport type EventByKind<K extends EventKind> = Extract<\n8\t  MessageEventInput,\n9\t  { eventKind: K }\n10\t>;\n11\t\n12\tlet keyCounter = 0;\n13\t\n14\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n15\t  user_prompt: () => ({ text: \"please read the file\" }),\n16\t  assistant_text: () => ({ text: \"here is what I found\" }),\n17\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n18\t  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n19\t  tool_call: () => ({\n20\t    toolCallId: \"call-1\",\n21\t    toolName: \"read_file\",\n22\t    arguments: { path: \"notes.txt\" },\n23\t  }),\n24\t  tool_result: () => ({\n25\t    toolCallId: \"call-1\",\n26\t    content: \"contents of notes.txt\",\n27\t    isError: false,\n28\t  }),\n29\t  turn_end: () => ({}),\n30\t};\n31\t\n32\t// Returns the discriminated MessageEventInput member for its kind, so a\n33\t// kind/payload mismatch in test code is a compile error — building an invalid\n34\t// pairing requires an explicit cast at the call site.\n35\texport function validEvent<K extends EventKind>(\n36\t  kind: K,\n37\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n38\t): EventByKind<K> {\n39\t  keyCounter += 1;\n40\t  const base = {\n41\t    eventKind: kind,\n42\t    idempotencyKey: `fixture-key-${keyCounter}`,\n43\t    actor: \"fixture-actor\",\n44\t    harness: \"fixture-harness\",\n45\t    payload: defaultPayloads[kind](),\n46\t  };\n47\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n48\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n49\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n50\t  // parameter types, not this assertion.\n51\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n52\t}\n53\t\n54\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n55\t  return kinds.map((kind) => validEvent(kind));\n56\t}\n57\t\n58\texport function conversationTurn(): MessageEventInput[] {\n59\t  return eventBatch([\n60\t    \"user_prompt\",\n61\t    \"assistant_text\",\n62\t    \"tool_call\",\n63\t    \"tool_result\",\n64\t    \"turn_end\",\n65\t  ]);\n66\t}\n67\t\n68\texport interface TempStore {\n69\t  dir: string;\n70\t  registryPath: string;\n71\t  threadPath: (name?: string) => string;\n72\t  cleanup: () => void;\n73\t}\n74\t\n75\texport function tempStore(): TempStore {\n76\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n77\t  let threadCounter = 0;\n78\t  return {\n79\t    dir,\n80\t    registryPath: join(dir, \"registry.sqlite\"),\n81\t    threadPath: (name) => {\n82\t      threadCounter += 1;\n83\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n84\t    },\n85\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n86\t  };\n87\t}\n88\t\n89\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n90\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n91\texport function openRaw(path: string): DatabaseSync {\n92\t  return new DatabaseSync(path);\n93\t}\n94\t\n95\texport { corruptTwoOpenTurns } from \"./corrupt.js\";\n96\texport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\n97\t"}]},"parent_tool_use_id":null,"session_id":"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa","uuid":"e73b07dc-c8dc-4fc4-923a-46d9bd01fd83","timestamp":"2026-06-10T13:47:21.926Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/index.ts","content":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n\nexport type EventByKind<K extends EventKind> = Extract<\n  MessageEventInput,\n  { eventKind: K }\n>;\n\nlet keyCounter = 0;\n\nconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n  user_prompt: () => ({ text: \"please read the file\" }),\n  assistant_text: () => ({ text: \"here is what I found\" }),\n  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n  tool_call: () => ({\n    toolCallId: \"call-1\",\n    toolName: \"read_file\",\n    arguments: { path: \"notes.txt\" },\n  }),\n  tool_result: () => ({\n    toolCallId: \"call-1\",\n    content: \"contents of notes.txt\",\n    isError: false,\n  }),\n  turn_end: () => ({}),\n};\n\n// Returns the discriminated MessageEventInput member for its kind, so a\n// kind/payload mismatch in test code is a compile error — building an invalid\n// pairing requires an explicit cast at the call site.\nexport function validEvent<K extends EventKind>(\n  kind: K,\n  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n): EventByKind<K> {\n  keyCounter += 1;\n  const base = {\n    eventKind: kind,\n    idempotencyKey: `fixture-key-${keyCounter}`,\n    actor: \"fixture-actor\",\n    harness: \"fixture-harness\",\n    payload: defaultPayloads[kind](),\n  };\n  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n  // so the final reconciliation goes through unknown. Call-site safety lives in the\n  // parameter types, not this assertion.\n  return { ...base, ...overrides } as unknown as EventByKind<K>;\n}\n\nexport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n  return kinds.map((kind) => validEvent(kind));\n}\n\nexport function conversationTurn(): MessageEventInput[] {\n  return eventBatch([\n    \"user_prompt\",\n    \"assistant_text\",\n    \"tool_call\",\n    \"tool_result\",\n    \"turn_end\",\n  ]);\n}\n\nexport interface TempStore {\n  dir: string;\n  registryPath: string;\n  threadPath: (name?: string) => string;\n  cleanup: () => void;\n}\n\nexport function tempStore(): TempStore {\n  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n  let threadCounter = 0;\n  return {\n    dir,\n    registryPath: join(dir, \"registry.sqlite\"),\n    threadPath: (name) => {\n      threadCounter += 1;\n      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    },\n    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n  };\n}\n\n// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n// convention; fixtures/corrupt.ts is the one sanctioned writer.\nexport function openRaw(path: string): DatabaseSync {\n  return new DatabaseSync(path);\n}\n\nexport { corruptTwoOpenTurns } from \"./corrupt.js\";\nexport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\n","numLines":97,"startLine":1,"totalLines":97}}}

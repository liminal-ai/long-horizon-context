{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QgfQMi5DDv6Qdrjp6humos","type":"tool_result","content":"1\t// CLI process-boundary suite for intake-stream: spawns the built dist/cli.js\n2\t// with real stdin pipes and real exit codes. Runs under verify-all only.\n3\t// The TTY leg of empty_stdin cannot be fabricated through a spawned pipe\n4\t// (no pty in the suite); it is proven in-process in intake.test.ts, and the\n5\t// empty-pipe leg here exercises the same adapter refusal.\n6\timport { spawnSync } from \"node:child_process\";\n7\timport { mkdtempSync, rmSync } from \"node:fs\";\n8\timport { tmpdir } from \"node:os\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n12\timport { eventBatch } from \"./fixtures/index.js\";\n13\t\n14\tconst cliPath = path.resolve(\n15\t  path.dirname(fileURLToPath(import.meta.url)),\n16\t  \"../dist/cli.js\",\n17\t);\n18\t\n19\tfunction runBinary(\n20\t  args: string[],\n21\t  input?: string,\n22\t): { status: number | null; stdout: string; stderr: string } {\n23\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n24\t    encoding: \"utf8\",\n25\t    ...(input === undefined ? {} : { input }),\n26\t  });\n27\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n28\t}\n29\t\n30\tlet dir: string;\n31\tlet threadPath: string;\n32\tbeforeEach(() => {\n33\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-intake-\"));\n34\t  threadPath = path.join(dir, \"thread.sqlite\");\n35\t  const created = runBinary([\n36\t    \"threads\",\n37\t    \"new-thread\",\n38\t    \"--file-path\",\n39\t    threadPath,\n40\t    \"--registry\",\n41\t    path.join(dir, \"registry.sqlite\"),\n42\t  ]);\n43\t  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n44\t});\n45\tafterEach(() => {\n46\t  rmSync(dir, { recursive: true, force: true });\n47\t});\n48\t\n49\tdescribe(\"Story 2 (process boundary): message-events and list-events\", () => {\n50\t  it(\"records a batch piped through real stdin and reads it back\", () => {\n51\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n52\t    const recorded = runBinary(\n53\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n54\t      JSON.stringify(batch),\n55\t    );\n56\t    expect(recorded.status).toBe(0);\n57\t    const recordedParsed = JSON.parse(recorded.stdout) as {\n58\t      ok: boolean;\n59\t      value: { events: Array<{ outcome: string }>; threadPosition: { lastEventOrder: number } };\n60\t    };\n61\t    expect(recordedParsed.ok).toBe(true);\n62\t    expect(recordedParsed.value.events).toHaveLength(3);\n63\t    expect(recordedParsed.value.threadPosition.lastEventOrder).toBe(3);\n64\t\n65\t    const listed = runBinary([\"intake-stream\", \"list-events\", \"--file-path\", threadPath]);\n66\t    expect(listed.status).toBe(0);\n67\t    const listedParsed = JSON.parse(listed.stdout) as {\n68\t      ok: boolean;\n69\t      value: Array<{ eventOrder: number; idempotencyKey: string }>;\n70\t    };\n71\t    expect(listedParsed.ok).toBe(true);\n72\t    expect(listedParsed.value.map((e) => e.eventOrder)).toEqual([1, 2, 3]);\n73\t    expect(listedParsed.value.map((e) => e.idempotencyKey)).toEqual(\n74\t      batch.map((e) => e.idempotencyKey),\n75\t    );\n76\t  });\n77\t\n78\t  it(\"an empty stdin pipe exits 1 with empty_stdin\", () => {\n79\t    const result = runBinary(\n80\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n81\t      \"\",\n82\t    );\n83\t    expect(result.status).toBe(1);\n84\t    const parsed = JSON.parse(result.stdout) as {\n85\t      ok: boolean;\n86\t      error: { errorClass: string; code: string };\n87\t    };\n88\t    expect(parsed.ok).toBe(false);\n89\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n90\t    expect(parsed.error.code).toBe(\"empty_stdin\");\n91\t  });\n92\t\n93\t  it(\"malformed stdin JSON exits 1 with a structured caller error\", () => {\n94\t    const result = runBinary(\n95\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n96\t      \"{definitely not json\",\n97\t    );\n98\t    expect(result.status).toBe(1);\n99\t    const parsed = JSON.parse(result.stdout) as {\n100\t      ok: boolean;\n101\t      error: { errorClass: string; code: string };\n102\t    };\n103\t    expect(parsed.ok).toBe(false);\n104\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n105\t    expect(parsed.error.code).toBe(\"invalid_event\");\n106\t  });\n107\t\n108\t  it(\"a validation failure exits 1 with the JSON error shape naming the event index\", () => {\n109\t    const batch = [{ ...eventBatch([\"user_prompt\"])[0]!, eventKind: \"mystery_kind\" }];\n110\t    const result = runBinary(\n111\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n112\t      JSON.stringify(batch),\n113\t    );\n114\t    expect(result.status).toBe(1);\n115\t    const parsed = JSON.parse(result.stdout) as {\n116\t      ok: boolean;\n117\t      error: { errorClass: string; code: string; eventIndex?: number };\n118\t    };\n119\t    expect(parsed.ok).toBe(false);\n120\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n121\t    expect(parsed.error.code).toBe(\"invalid_event\");\n122\t    expect(parsed.error.eventIndex).toBe(0);\n123\t  });\n124\t});\n125\t"}]},"parent_tool_use_id":null,"session_id":"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa","uuid":"56ac8e28-832f-4e83-b2e1-0daec776b284","timestamp":"2026-06-10T13:47:43.521Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-intake.test.ts","content":"// CLI process-boundary suite for intake-stream: spawns the built dist/cli.js\n// with real stdin pipes and real exit codes. Runs under verify-all only.\n// The TTY leg of empty_stdin cannot be fabricated through a spawned pipe\n// (no pty in the suite); it is proven in-process in intake.test.ts, and the\n// empty-pipe leg here exercises the same adapter refusal.\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { eventBatch } from \"./fixtures/index.js\";\n\nconst cliPath = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  \"../dist/cli.js\",\n);\n\nfunction runBinary(\n  args: string[],\n  input?: string,\n): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    ...(input === undefined ? {} : { input }),\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nlet threadPath: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-intake-\"));\n  threadPath = path.join(dir, \"thread.sqlite\");\n  const created = runBinary([\n    \"threads\",\n    \"new-thread\",\n    \"--file-path\",\n    threadPath,\n    \"--registry\",\n    path.join(dir, \"registry.sqlite\"),\n  ]);\n  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\ndescribe(\"Story 2 (process boundary): message-events and list-events\", () => {\n  it(\"records a batch piped through real stdin and reads it back\", () => {\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]);\n    const recorded = runBinary(\n      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n      JSON.stringify(batch),\n    );\n    expect(recorded.status).toBe(0);\n    const recordedParsed = JSON.parse(recorded.stdout) as {\n      ok: boolean;\n      value: { events: Array<{ outcome: string }>; threadPosition: { lastEventOrder: number } };\n    };\n    expect(recordedParsed.ok).toBe(true);\n    expect(recordedParsed.value.events).toHaveLength(3);\n    expect(recordedParsed.value.threadPosition.lastEventOrder).toBe(3);\n\n    const listed = runBinary([\"intake-stream\", \"list-events\", \"--file-path\", threadPath]);\n    expect(listed.status).toBe(0);\n    const listedParsed = JSON.parse(listed.stdout) as {\n      ok: boolean;\n      value: Array<{ eventOrder: number; idempotencyKey: string }>;\n    };\n    expect(listedParsed.ok).toBe(true);\n    expect(listedParsed.value.map((e) => e.eventOrder)).toEqual([1, 2, 3]);\n    expect(listedParsed.value.map((e) => e.idempotencyKey)).toEqual(\n      batch.map((e) => e.idempotencyKey),\n    );\n  });\n\n  it(\"an empty stdin pipe exits 1 with empty_stdin\", () => {\n    const result = runBinary(\n      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n      \"\",\n    );\n    expect(result.status).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"empty_stdin\");\n  });\n\n  it(\"malformed stdin JSON exits 1 with a structured caller error\", () => {\n    const result = runBinary(\n      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n      \"{definitely not json\",\n    );\n    expect(result.status).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"invalid_event\");\n  });\n\n  it(\"a validation failure exits 1 with the JSON error shape naming the event index\", () => {\n    const batch = [{ ...eventBatch([\"user_prompt\"])[0]!, eventKind: \"mystery_kind\" }];\n    const result = runBinary(\n      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n      JSON.stringify(batch),\n    );\n    expect(result.status).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string; eventIndex?: number };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"invalid_event\");\n    expect(parsed.error.eventIndex).toBe(0);\n  });\n});\n","numLines":125,"startLine":1,"totalLines":125}}}

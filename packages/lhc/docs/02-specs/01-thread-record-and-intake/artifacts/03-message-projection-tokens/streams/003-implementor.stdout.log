{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K14nYWsougdgBxFvBrLvy5","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n3\timport {\n4\t  createThreadFile,\n5\t  deleteThreadFile,\n6\t  generateThreadId,\n7\t} from \"./internal/create.js\";\n8\timport {\n9\t  insertThreadRow,\n10\t  openRegistryForRead,\n11\t  openRegistryForWrite,\n12\t  resolveRegistryPath,\n13\t  selectAllThreadRows,\n14\t  selectThreadRow,\n15\t  type RegistryRow,\n16\t} from \"./internal/registry.js\";\n17\t\n18\texport type ThreadRef =\n19\t  | { threadId: string; registryPath?: string }\n20\t  | { filePath: string };\n21\t\n22\texport interface NewThreadInput {\n23\t  filePath: string;\n24\t  title?: string;\n25\t  registryPath?: string;\n26\t}\n27\t\n28\texport interface ThreadInfo {\n29\t  threadId: string;\n30\t  filePath: string;\n31\t  title?: string;\n32\t  createdAt: string; // ISO-8601\n33\t}\n34\t\n35\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n36\t  const info: ThreadInfo = {\n37\t    threadId: row.threadId,\n38\t    filePath: row.filePath,\n39\t    createdAt: row.createdAt,\n40\t  };\n41\t  if (row.title !== undefined) info.title = row.title;\n42\t  return info;\n43\t}\n44\t\n45\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n46\t  return {\n47\t    ok: false,\n48\t    error: {\n49\t      errorClass: \"caller_error\",\n50\t      code: \"thread_not_found\",\n51\t      reason: `no thread registered with id ${threadId}`,\n52\t    },\n53\t  };\n54\t}\n55\t\n56\tfunction detail(cause: unknown): string {\n57\t  return cause instanceof Error ? cause.message : String(cause);\n58\t}\n59\t\n60\t// Creation spans two databases that cannot share a transaction. Order is\n61\t// file-then-row with compensation: the invariant \"no registry row without\n62\t// its file\" is absolute; an orphan file from a crash between the writes is\n63\t// documented harmless (design decision 2).\n64\texport async function newThread(\n65\t  input: NewThreadInput,\n66\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n67\t  if (existsSync(input.filePath)) {\n68\t    return {\n69\t      ok: false,\n70\t      error: {\n71\t        errorClass: \"caller_error\",\n72\t        code: \"path_exists\",\n73\t        reason: `a file already exists at ${input.filePath}`,\n74\t      },\n75\t    };\n76\t  }\n77\t\n78\t  const threadId = generateThreadId();\n79\t  const createdAt = new Date().toISOString();\n80\t\n81\t  try {\n82\t    createThreadFile(input.filePath, threadId, createdAt);\n83\t  } catch (cause) {\n84\t    deleteThreadFile(input.filePath);\n85\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n86\t  }\n87\t\n88\t  let registry;\n89\t  try {\n90\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n91\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n92\t    if (input.title !== undefined) row.title = input.title;\n93\t    insertThreadRow(registry, row);\n94\t  } catch (cause) {\n95\t    deleteThreadFile(input.filePath);\n96\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n97\t  } finally {\n98\t    registry?.close();\n99\t  }\n100\t\n101\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n102\t}\n103\t\n104\texport async function resolve(input: {\n105\t  threadId: string;\n106\t  registryPath?: string;\n107\t}): Promise<OpResult<ThreadInfo>> {\n108\t  let registry;\n109\t  try {\n110\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n111\t    if (registry === null) return threadNotFound(input.threadId);\n112\t    const row = selectThreadRow(registry, input.threadId);\n113\t    if (row === undefined) return threadNotFound(input.threadId);\n114\t    return { ok: true, value: toThreadInfo(row) };\n115\t  } catch (cause) {\n116\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n117\t  } finally {\n118\t    registry?.close();\n119\t  }\n120\t}\n121\t\n122\texport async function listThreads(input?: {\n123\t  registryPath?: string;\n124\t}): Promise<OpResult<ThreadInfo[]>> {\n125\t  let registry;\n126\t  try {\n127\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n128\t    if (registry === null) return { ok: true, value: [] };\n129\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n130\t  } catch (cause) {\n131\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n132\t  } finally {\n133\t    registry?.close();\n134\t  }\n135\t}\n136\t\n137\t// The single interpreter of thread references: { threadId } resolves to a\n138\t// path through the registry, { filePath } passes through untouched. No other\n139\t// code ever reads a thread reference.\n140\texport async function resolveThreadRef(\n141\t  ref: ThreadRef,\n142\t): Promise<OpResult<{ filePath: string }>> {\n143\t  if (\"threadId\" in ref) {\n144\t    const resolved = await resolve(ref);\n145\t    if (!resolved.ok) return resolved;\n146\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n147\t  }\n148\t  return { ok: true, value: { filePath: ref.filePath } };\n149\t}\n150\t"}]},"parent_tool_use_id":null,"session_id":"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa","uuid":"6163fd18-3280-46e5-9a5f-c390eb6fac00","timestamp":"2026-06-10T13:50:05.841Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  createThreadFile,\n  deleteThreadFile,\n  generateThreadId,\n} from \"./internal/create.js\";\nimport {\n  insertThreadRow,\n  openRegistryForRead,\n  openRegistryForWrite,\n  resolveRegistryPath,\n  selectAllThreadRows,\n  selectThreadRow,\n  type RegistryRow,\n} from \"./internal/registry.js\";\n\nexport type ThreadRef =\n  | { threadId: string; registryPath?: string }\n  | { filePath: string };\n\nexport interface NewThreadInput {\n  filePath: string;\n  title?: string;\n  registryPath?: string;\n}\n\nexport interface ThreadInfo {\n  threadId: string;\n  filePath: string;\n  title?: string;\n  createdAt: string; // ISO-8601\n}\n\nfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n  const info: ThreadInfo = {\n    threadId: row.threadId,\n    filePath: row.filePath,\n    createdAt: row.createdAt,\n  };\n  if (row.title !== undefined) info.title = row.title;\n  return info;\n}\n\nfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread registered with id ${threadId}`,\n    },\n  };\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Creation spans two databases that cannot share a transaction. Order is\n// file-then-row with compensation: the invariant \"no registry row without\n// its file\" is absolute; an orphan file from a crash between the writes is\n// documented harmless (design decision 2).\nexport async function newThread(\n  input: NewThreadInput,\n): Promise<OpResult<{ threadId: string; filePath: string }>> {\n  if (existsSync(input.filePath)) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"path_exists\",\n        reason: `a file already exists at ${input.filePath}`,\n      },\n    };\n  }\n\n  const threadId = generateThreadId();\n  const createdAt = new Date().toISOString();\n\n  try {\n    createThreadFile(input.filePath, threadId, createdAt);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n  }\n\n  let registry;\n  try {\n    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n    if (input.title !== undefined) row.title = input.title;\n    insertThreadRow(registry, row);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`registry insert failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n\n  return { ok: true, value: { threadId, filePath: input.filePath } };\n}\n\nexport async function resolve(input: {\n  threadId: string;\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n    if (registry === null) return threadNotFound(input.threadId);\n    const row = selectThreadRow(registry, input.threadId);\n    if (row === undefined) return threadNotFound(input.threadId);\n    return { ok: true, value: toThreadInfo(row) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\nexport async function listThreads(input?: {\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo[]>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n    if (registry === null) return { ok: true, value: [] };\n    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\n// The single interpreter of thread references: { threadId } resolves to a\n// path through the registry, { filePath } passes through untouched. No other\n// code ever reads a thread reference.\nexport async function resolveThreadRef(\n  ref: ThreadRef,\n): Promise<OpResult<{ filePath: string }>> {\n  if (\"threadId\" in ref) {\n    const resolved = await resolve(ref);\n    if (!resolved.ok) return resolved;\n    return { ok: true, value: { filePath: resolved.value.filePath } };\n  }\n  return { ok: true, value: { filePath: ref.filePath } };\n}\n","numLines":150,"startLine":1,"totalLines":150}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DvWhqA9y7Y7BBRhFWayeEk","type":"tool_result","content":"1\t// Flow 2 (recording half): TC-2.1, TC-2.8, TC-1.4 (closing Story 1's\n2\t// deferral), the four architecture-risk tests (mid-walk rollback, restart\n3\t// survival, no-lock-on-rejection, system_error rollback parity), and the CLI\n4\t// in-process stdin legs.\n5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n6\timport {\n7\t  intakeStream,\n8\t  runCli,\n9\t  threads,\n10\t  type EventRecord,\n11\t  type MessageEventInput,\n12\t} from \"../src/index.js\";\n13\timport {\n14\t  conversationTurn,\n15\t  eventBatch,\n16\t  openRaw,\n17\t  setIntakeClock,\n18\t  setIntakeWalkHook,\n19\t  tempStore,\n20\t  validEvent,\n21\t  type TempStore,\n22\t} from \"./fixtures/index.js\";\n23\t\n24\tlet store: TempStore;\n25\tbeforeEach(() => {\n26\t  store = tempStore();\n27\t});\n28\tafterEach(() => {\n29\t  setIntakeWalkHook(null);\n30\t  setIntakeClock(null);\n31\t  store.cleanup();\n32\t});\n33\t\n34\tasync function createThread(): Promise<string> {\n35\t  const filePath = store.threadPath();\n36\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n37\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n38\t  return filePath;\n39\t}\n40\t\n41\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n42\t  const result = await intakeStream.listEvents({ filePath });\n43\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n44\t  return result.value;\n45\t}\n46\t\n47\tdescribe(\"Flow 2 (SDK): event recording\", () => {\n48\t  it(\"TC-2.1: two batches record in array order with a dense, continuing event order\", async () => {\n49\t    const filePath = await createThread();\n50\t    const batchOne = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n51\t    const batchTwo = eventBatch([\"tool_result\", \"runtime_note\", \"turn_end\"]);\n52\t\n53\t    const first = await intakeStream.messageEvents({ filePath }, batchOne);\n54\t    expect(first.ok).toBe(true);\n55\t    if (!first.ok) return;\n56\t    expect(first.value.events.map((e) => e.outcome)).toEqual([\n57\t      \"recorded\",\n58\t      \"recorded\",\n59\t      \"recorded\",\n60\t    ]);\n61\t    expect(first.value.threadPosition.lastEventOrder).toBe(3);\n62\t\n63\t    const second = await intakeStream.messageEvents({ filePath }, batchTwo);\n64\t    expect(second.ok).toBe(true);\n65\t    if (!second.ok) return;\n66\t    expect(second.value.threadPosition.lastEventOrder).toBe(6);\n67\t\n68\t    const events = await readBack(filePath);\n69\t    expect(events.map((e) => e.eventOrder)).toEqual([1, 2, 3, 4, 5, 6]);\n70\t    expect(events.map((e) => e.eventKind)).toEqual([\n71\t      \"user_prompt\",\n72\t      \"assistant_text\",\n73\t      \"tool_call\",\n74\t      \"tool_result\",\n75\t      \"runtime_note\",\n76\t      \"turn_end\",\n77\t    ]);\n78\t    expect(events.map((e) => e.idempotencyKey)).toEqual(\n79\t      [...batchOne, ...batchTwo].map((e) => e.idempotencyKey),\n80\t    );\n81\t  });\n82\t\n83\t  it(\"TC-2.8: an empty batch is a caller error and records nothing\", async () => {\n84\t    const filePath = await createThread();\n85\t    const result = await intakeStream.messageEvents({ filePath }, []);\n86\t    expect(result.ok).toBe(false);\n87\t    if (result.ok) return;\n88\t    expect(result.error.errorClass).toBe(\"caller_error\");\n89\t    expect(result.error.code).toBe(\"empty_batch\");\n90\t    expect(result.error.reason).toContain(\"empty\");\n91\t\n92\t    expect(await readBack(filePath)).toEqual([]);\n93\t  });\n94\t\n95\t  it(\"TC-1.4: the same batch by thread id and by file path produces identical results and read-back (closes Story 1's deferral)\", async () => {\n96\t    // recordedAt is sourced from the injected clock (test-plan: fixed per\n97\t    // test), so the two independent recordings stamp the same instant and the\n98\t    // read-back can be compared field-for-field — recordedAt included, nothing\n99\t    // stripped.\n100\t    const recordedAt = new Date(\"2026-01-01T00:00:00.000Z\");\n101\t    setIntakeClock(() => recordedAt);\n102\t\n103\t    const pathA = store.threadPath();\n104\t    const createdA = await threads.newThread({\n105\t      filePath: pathA,\n106\t      registryPath: store.registryPath,\n107\t    });\n108\t    expect(createdA.ok).toBe(true);\n109\t    if (!createdA.ok) return;\n110\t    const pathB = await createThread();\n111\t\n112\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\", \"turn_end\"]);\n113\t    const byId = await intakeStream.messageEvents(\n114\t      { threadId: createdA.value.threadId, registryPath: store.registryPath },\n115\t      batch,\n116\t    );\n117\t    const byPath = await intakeStream.messageEvents({ filePath: pathB }, batch);\n118\t    expect(byId.ok).toBe(true);\n119\t    expect(byPath.ok).toBe(true);\n120\t    if (!byId.ok || !byPath.ok) return;\n121\t    expect(byId.value).toEqual(byPath.value);\n122\t\n123\t    // Exact read-back equivalence through both reference forms — every field,\n124\t    // recordedAt included. Determinism comes from the injected clock, not from\n125\t    // weakening the assertion.\n126\t    const readById = await intakeStream.listEvents({\n127\t      threadId: createdA.value.threadId,\n128\t      registryPath: store.registryPath,\n129\t    });\n130\t    expect(readById.ok).toBe(true);\n131\t    if (!readById.ok) return;\n132\t    const readByPath = await readBack(pathB);\n133\t    expect(readById.value).toEqual(readByPath);\n134\t\n135\t    // recordedAt is the injected instant, proving it came from the clock seam\n136\t    // rather than wall time.\n137\t    expect(readById.value.map((e: EventRecord) => e.recordedAt)).toEqual(\n138\t      readByPath.map(() => recordedAt.toISOString()),\n139\t    );\n140\t  });\n141\t\n142\t  it(\"architecture-risk: mid-walk failure rolls the whole batch back to baseline\", async () => {\n143\t    const filePath = await createThread();\n144\t    const baselineBatch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n145\t    const recorded = await intakeStream.messageEvents({ filePath }, baselineBatch);\n146\t    expect(recorded.ok).toBe(true);\n147\t    const baseline = await readBack(filePath);\n148\t    expect(baseline).toHaveLength(2);\n149\t\n150\t    // Real mechanism: the seam closes the handle inside the transaction after\n151\t    // the first event of the new batch has been recorded.\n152\t    setIntakeWalkHook((db, eventIndex) => {\n153\t      if (eventIndex === 0) db.close();\n154\t    });\n155\t    const result = await intakeStream.messageEvents(\n156\t      { filePath },\n157\t      eventBatch([\"tool_call\", \"tool_result\", \"turn_end\"]),\n158\t    );\n159\t    setIntakeWalkHook(null);\n160\t    expect(result.ok).toBe(false);\n161\t    if (result.ok) return;\n162\t    expect(result.error.errorClass).toBe(\"system_error\");\n163\t    expect(result.error.code).toBe(\"storage_failure\");\n164\t\n165\t    // Post-reopen read-back: not the operation's own claim about itself.\n166\t    expect(await readBack(filePath)).toEqual(baseline);\n167\t  });\n168\t\n169\t  it(\"architecture-risk: system_error rollback parity — storage failure mid-batch leaves no partial events\", async () => {\n170\t    const filePath = await createThread();\n171\t    setIntakeWalkHook((db, eventIndex) => {\n172\t      if (eventIndex === 1) db.close();\n173\t    });\n174\t    const result = await intakeStream.messageEvents({ filePath }, conversationTurn());\n175\t    setIntakeWalkHook(null);\n176\t    expect(result.ok).toBe(false);\n177\t    if (result.ok) return;\n178\t    expect(result.error.errorClass).toBe(\"system_error\");\n179\t    expect(result.error.code).toBe(\"storage_failure\");\n180\t\n181\t    // AC-4.6 is class-independent: the first two walked events are gone too.\n182\t    expect(await readBack(filePath)).toEqual([]);\n183\t    const db = openRaw(filePath);\n184\t    try {\n185\t      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n186\t        n: number | bigint;\n187\t      };\n188\t      expect(Number(row.n)).toBe(0);\n189\t    } finally {\n190\t      db.close();\n191\t    }\n192\t  });\n193\t\n194\t  it(\"architecture-risk: restart survival — reopen sees the identical record\", async () => {\n195\t    const filePath = await createThread();\n196\t    const batch = conversationTurn();\n197\t    const recorded = await intakeStream.messageEvents({ filePath }, batch);\n198\t    expect(recorded.ok).toBe(true);\n199\t\n200\t    // Every SDK operation opens and closes its own handle, so each read-back\n201\t    // below is a fresh open of the file the write durably left behind.\n202\t    const firstRead = await readBack(filePath);\n203\t    expect(firstRead).toHaveLength(5);\n204\t    const secondRead = await readBack(filePath);\n205\t    expect(secondRead).toEqual(firstRead);\n206\t\n207\t    const db = openRaw(filePath);\n208\t    try {\n209\t      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n210\t        n: number | bigint;\n211\t      };\n212\t      expect(Number(row.n)).toBe(5);\n213\t    } finally {\n214\t      db.close();\n215\t    }\n216\t  });\n217\t\n218\t  it(\"architecture-risk: a rejected batch takes no lock — rejection succeeds while another connection holds the write lock\", async () => {\n219\t    const filePath = await createThread();\n220\t    const locker = openRaw(filePath);\n221\t    try {\n222\t      locker.exec(\"BEGIN IMMEDIATE;\");\n223\t      // If rejection touched the transaction path it would block on the held\n224\t      // lock and surface SQLITE_BUSY as storage_failure; pure validation\n225\t      // returns the caller error immediately instead.\n226\t      const result = await intakeStream.messageEvents({ filePath }, [\n227\t        { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n228\t      ]);\n229\t      expect(result.ok).toBe(false);\n230\t      if (!result.ok) {\n231\t        expect(result.error.errorClass).toBe(\"caller_error\");\n232\t        expect(result.error.code).toBe(\"invalid_event\");\n233\t      }\n234\t      locker.exec(\"ROLLBACK;\");\n235\t    } finally {\n236\t      locker.close();\n237\t    }\n238\t    expect(await readBack(filePath)).toEqual([]);\n239\t  });\n240\t});\n241\t\n242\tdescribe(\"Flow 2 (CLI in-process): message-events stdin handling\", () => {\n243\t  it(\"records a batch from stdin and reads it back through list-events\", async () => {\n244\t    const filePath = await createThread();\n245\t    const batch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n246\t    const recorded = await runCli(\n247\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n248\t      async () => JSON.stringify(batch),\n249\t    );\n250\t    expect(recorded.exitCode).toBe(0);\n251\t    const recordedParsed = JSON.parse(recorded.stdout) as {\n252\t      ok: boolean;\n253\t      value: { events: Array<{ outcome: string }>; threadPosition: { lastEventOrder: number } };\n254\t    };\n255\t    expect(recordedParsed.ok).toBe(true);\n256\t    expect(recordedParsed.value.events.map((e) => e.outcome)).toEqual([\n257\t      \"recorded\",\n258\t      \"recorded\",\n259\t    ]);\n260\t    expect(recordedParsed.value.threadPosition.lastEventOrder).toBe(2);\n261\t\n262\t    const listed = await runCli([\"intake-stream\", \"list-events\", \"--file-path\", filePath]);\n263\t    expect(listed.exitCode).toBe(0);\n264\t    const listedParsed = JSON.parse(listed.stdout) as {\n265\t      ok: boolean;\n266\t      value: Array<{ eventOrder: number; eventKind: string }>;\n267\t    };\n268\t    expect(listedParsed.ok).toBe(true);\n269\t    expect(listedParsed.value.map((e) => e.eventOrder)).toEqual([1, 2]);\n270\t  });\n271\t\n272\t  it(\"a TTY stdin is refused with empty_stdin before any SDK call\", async () => {\n273\t    const filePath = await createThread();\n274\t    const result = await runCli(\n275\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n276\t      async () => null,\n277\t    );\n278\t    expect(result.exitCode).toBe(1);\n279\t    const parsed = JSON.parse(result.stdout) as {\n280\t      ok: boolean;\n281\t      error: { errorClass: string; code: string };\n282\t    };\n283\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n284\t    expect(parsed.error.code).toBe(\"empty_stdin\");\n285\t    expect(await readBack(filePath)).toEqual([]);\n286\t  });\n287\t\n288\t  it(\"empty stdin is refused with empty_stdin; a JSON [] reaches the SDK as empty_batch — distinct codes\", async () => {\n289\t    const filePath = await createThread();\n290\t\n291\t    const empty = await runCli(\n292\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n293\t      async () => \"\",\n294\t    );\n295\t    expect(empty.exitCode).toBe(1);\n296\t    const emptyParsed = JSON.parse(empty.stdout) as { error: { code: string } };\n297\t    expect(emptyParsed.error.code).toBe(\"empty_stdin\");\n298\t\n299\t    const emptyArray = await runCli(\n300\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n301\t      async () => \"[]\",\n302\t    );\n303\t    expect(emptyArray.exitCode).toBe(1);\n304\t    const emptyArrayParsed = JSON.parse(emptyArray.stdout) as { error: { code: string } };\n305\t    expect(emptyArrayParsed.error.code).toBe(\"empty_batch\");\n306\t  });\n307\t\n308\t  it(\"malformed stdin JSON and a missing thread flag are caller errors\", async () => {\n309\t    const filePath = await createThread();\n310\t    const malformed = await runCli(\n311\t      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n312\t      async () => \"{not json\",\n313\t    );\n314\t    expect(malformed.exitCode).toBe(1);\n315\t    const malformedParsed = JSON.parse(malformed.stdout) as {\n316\t      error: { errorClass: string; code: string };\n317\t    };\n318\t    expect(malformedParsed.error.errorClass).toBe(\"caller_error\");\n319\t    expect(malformedParsed.error.code).toBe(\"invalid_event\");\n320\t\n321\t    const missingFlag = await runCli(\n322\t      [\"intake-stream\", \"message-events\"],\n323\t      async () => \"[]\",\n324\t    );\n325\t    expect(missingFlag.exitCode).toBe(1);\n326\t    const missingParsed = JSON.parse(missingFlag.stdout) as { error: { code: string } };\n327\t    expect(missingParsed.error.code).toBe(\"missing_flag\");\n328\t  });\n329\t});\n330\t"}]},"parent_tool_use_id":null,"session_id":"4de8d8b1-5d3a-4643-b6ad-a0c0a326f4fa","uuid":"2dfae7d0-7aa6-4e4d-9670-d12687ac16a6","timestamp":"2026-06-10T13:47:31.638Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/intake.test.ts","content":"// Flow 2 (recording half): TC-2.1, TC-2.8, TC-1.4 (closing Story 1's\n// deferral), the four architecture-risk tests (mid-walk rollback, restart\n// survival, no-lock-on-rejection, system_error rollback parity), and the CLI\n// in-process stdin legs.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  intakeStream,\n  runCli,\n  threads,\n  type EventRecord,\n  type MessageEventInput,\n} from \"../src/index.js\";\nimport {\n  conversationTurn,\n  eventBatch,\n  openRaw,\n  setIntakeClock,\n  setIntakeWalkHook,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  setIntakeWalkHook(null);\n  setIntakeClock(null);\n  store.cleanup();\n});\n\nasync function createThread(): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function readBack(filePath: string): Promise<EventRecord[]> {\n  const result = await intakeStream.listEvents({ filePath });\n  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n  return result.value;\n}\n\ndescribe(\"Flow 2 (SDK): event recording\", () => {\n  it(\"TC-2.1: two batches record in array order with a dense, continuing event order\", async () => {\n    const filePath = await createThread();\n    const batchOne = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);\n    const batchTwo = eventBatch([\"tool_result\", \"runtime_note\", \"turn_end\"]);\n\n    const first = await intakeStream.messageEvents({ filePath }, batchOne);\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.events.map((e) => e.outcome)).toEqual([\n      \"recorded\",\n      \"recorded\",\n      \"recorded\",\n    ]);\n    expect(first.value.threadPosition.lastEventOrder).toBe(3);\n\n    const second = await intakeStream.messageEvents({ filePath }, batchTwo);\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    expect(second.value.threadPosition.lastEventOrder).toBe(6);\n\n    const events = await readBack(filePath);\n    expect(events.map((e) => e.eventOrder)).toEqual([1, 2, 3, 4, 5, 6]);\n    expect(events.map((e) => e.eventKind)).toEqual([\n      \"user_prompt\",\n      \"assistant_text\",\n      \"tool_call\",\n      \"tool_result\",\n      \"runtime_note\",\n      \"turn_end\",\n    ]);\n    expect(events.map((e) => e.idempotencyKey)).toEqual(\n      [...batchOne, ...batchTwo].map((e) => e.idempotencyKey),\n    );\n  });\n\n  it(\"TC-2.8: an empty batch is a caller error and records nothing\", async () => {\n    const filePath = await createThread();\n    const result = await intakeStream.messageEvents({ filePath }, []);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"empty_batch\");\n    expect(result.error.reason).toContain(\"empty\");\n\n    expect(await readBack(filePath)).toEqual([]);\n  });\n\n  it(\"TC-1.4: the same batch by thread id and by file path produces identical results and read-back (closes Story 1's deferral)\", async () => {\n    // recordedAt is sourced from the injected clock (test-plan: fixed per\n    // test), so the two independent recordings stamp the same instant and the\n    // read-back can be compared field-for-field — recordedAt included, nothing\n    // stripped.\n    const recordedAt = new Date(\"2026-01-01T00:00:00.000Z\");\n    setIntakeClock(() => recordedAt);\n\n    const pathA = store.threadPath();\n    const createdA = await threads.newThread({\n      filePath: pathA,\n      registryPath: store.registryPath,\n    });\n    expect(createdA.ok).toBe(true);\n    if (!createdA.ok) return;\n    const pathB = await createThread();\n\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\", \"turn_end\"]);\n    const byId = await intakeStream.messageEvents(\n      { threadId: createdA.value.threadId, registryPath: store.registryPath },\n      batch,\n    );\n    const byPath = await intakeStream.messageEvents({ filePath: pathB }, batch);\n    expect(byId.ok).toBe(true);\n    expect(byPath.ok).toBe(true);\n    if (!byId.ok || !byPath.ok) return;\n    expect(byId.value).toEqual(byPath.value);\n\n    // Exact read-back equivalence through both reference forms — every field,\n    // recordedAt included. Determinism comes from the injected clock, not from\n    // weakening the assertion.\n    const readById = await intakeStream.listEvents({\n      threadId: createdA.value.threadId,\n      registryPath: store.registryPath,\n    });\n    expect(readById.ok).toBe(true);\n    if (!readById.ok) return;\n    const readByPath = await readBack(pathB);\n    expect(readById.value).toEqual(readByPath);\n\n    // recordedAt is the injected instant, proving it came from the clock seam\n    // rather than wall time.\n    expect(readById.value.map((e: EventRecord) => e.recordedAt)).toEqual(\n      readByPath.map(() => recordedAt.toISOString()),\n    );\n  });\n\n  it(\"architecture-risk: mid-walk failure rolls the whole batch back to baseline\", async () => {\n    const filePath = await createThread();\n    const baselineBatch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n    const recorded = await intakeStream.messageEvents({ filePath }, baselineBatch);\n    expect(recorded.ok).toBe(true);\n    const baseline = await readBack(filePath);\n    expect(baseline).toHaveLength(2);\n\n    // Real mechanism: the seam closes the handle inside the transaction after\n    // the first event of the new batch has been recorded.\n    setIntakeWalkHook((db, eventIndex) => {\n      if (eventIndex === 0) db.close();\n    });\n    const result = await intakeStream.messageEvents(\n      { filePath },\n      eventBatch([\"tool_call\", \"tool_result\", \"turn_end\"]),\n    );\n    setIntakeWalkHook(null);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"system_error\");\n    expect(result.error.code).toBe(\"storage_failure\");\n\n    // Post-reopen read-back: not the operation's own claim about itself.\n    expect(await readBack(filePath)).toEqual(baseline);\n  });\n\n  it(\"architecture-risk: system_error rollback parity — storage failure mid-batch leaves no partial events\", async () => {\n    const filePath = await createThread();\n    setIntakeWalkHook((db, eventIndex) => {\n      if (eventIndex === 1) db.close();\n    });\n    const result = await intakeStream.messageEvents({ filePath }, conversationTurn());\n    setIntakeWalkHook(null);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"system_error\");\n    expect(result.error.code).toBe(\"storage_failure\");\n\n    // AC-4.6 is class-independent: the first two walked events are gone too.\n    expect(await readBack(filePath)).toEqual([]);\n    const db = openRaw(filePath);\n    try {\n      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n        n: number | bigint;\n      };\n      expect(Number(row.n)).toBe(0);\n    } finally {\n      db.close();\n    }\n  });\n\n  it(\"architecture-risk: restart survival — reopen sees the identical record\", async () => {\n    const filePath = await createThread();\n    const batch = conversationTurn();\n    const recorded = await intakeStream.messageEvents({ filePath }, batch);\n    expect(recorded.ok).toBe(true);\n\n    // Every SDK operation opens and closes its own handle, so each read-back\n    // below is a fresh open of the file the write durably left behind.\n    const firstRead = await readBack(filePath);\n    expect(firstRead).toHaveLength(5);\n    const secondRead = await readBack(filePath);\n    expect(secondRead).toEqual(firstRead);\n\n    const db = openRaw(filePath);\n    try {\n      const row = db.prepare(\"SELECT COUNT(*) AS n FROM event\").get() as unknown as {\n        n: number | bigint;\n      };\n      expect(Number(row.n)).toBe(5);\n    } finally {\n      db.close();\n    }\n  });\n\n  it(\"architecture-risk: a rejected batch takes no lock — rejection succeeds while another connection holds the write lock\", async () => {\n    const filePath = await createThread();\n    const locker = openRaw(filePath);\n    try {\n      locker.exec(\"BEGIN IMMEDIATE;\");\n      // If rejection touched the transaction path it would block on the held\n      // lock and surface SQLITE_BUSY as storage_failure; pure validation\n      // returns the caller error immediately instead.\n      const result = await intakeStream.messageEvents({ filePath }, [\n        { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n      ]);\n      expect(result.ok).toBe(false);\n      if (!result.ok) {\n        expect(result.error.errorClass).toBe(\"caller_error\");\n        expect(result.error.code).toBe(\"invalid_event\");\n      }\n      locker.exec(\"ROLLBACK;\");\n    } finally {\n      locker.close();\n    }\n    expect(await readBack(filePath)).toEqual([]);\n  });\n});\n\ndescribe(\"Flow 2 (CLI in-process): message-events stdin handling\", () => {\n  it(\"records a batch from stdin and reads it back through list-events\", async () => {\n    const filePath = await createThread();\n    const batch = eventBatch([\"user_prompt\", \"assistant_text\"]);\n    const recorded = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => JSON.stringify(batch),\n    );\n    expect(recorded.exitCode).toBe(0);\n    const recordedParsed = JSON.parse(recorded.stdout) as {\n      ok: boolean;\n      value: { events: Array<{ outcome: string }>; threadPosition: { lastEventOrder: number } };\n    };\n    expect(recordedParsed.ok).toBe(true);\n    expect(recordedParsed.value.events.map((e) => e.outcome)).toEqual([\n      \"recorded\",\n      \"recorded\",\n    ]);\n    expect(recordedParsed.value.threadPosition.lastEventOrder).toBe(2);\n\n    const listed = await runCli([\"intake-stream\", \"list-events\", \"--file-path\", filePath]);\n    expect(listed.exitCode).toBe(0);\n    const listedParsed = JSON.parse(listed.stdout) as {\n      ok: boolean;\n      value: Array<{ eventOrder: number; eventKind: string }>;\n    };\n    expect(listedParsed.ok).toBe(true);\n    expect(listedParsed.value.map((e) => e.eventOrder)).toEqual([1, 2]);\n  });\n\n  it(\"a TTY stdin is refused with empty_stdin before any SDK call\", async () => {\n    const filePath = await createThread();\n    const result = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => null,\n    );\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string };\n    };\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"empty_stdin\");\n    expect(await readBack(filePath)).toEqual([]);\n  });\n\n  it(\"empty stdin is refused with empty_stdin; a JSON [] reaches the SDK as empty_batch — distinct codes\", async () => {\n    const filePath = await createThread();\n\n    const empty = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => \"\",\n    );\n    expect(empty.exitCode).toBe(1);\n    const emptyParsed = JSON.parse(empty.stdout) as { error: { code: string } };\n    expect(emptyParsed.error.code).toBe(\"empty_stdin\");\n\n    const emptyArray = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => \"[]\",\n    );\n    expect(emptyArray.exitCode).toBe(1);\n    const emptyArrayParsed = JSON.parse(emptyArray.stdout) as { error: { code: string } };\n    expect(emptyArrayParsed.error.code).toBe(\"empty_batch\");\n  });\n\n  it(\"malformed stdin JSON and a missing thread flag are caller errors\", async () => {\n    const filePath = await createThread();\n    const malformed = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", filePath],\n      async () => \"{not json\",\n    );\n    expect(malformed.exitCode).toBe(1);\n    const malformedParsed = JSON.parse(malformed.stdout) as {\n      error: { errorClass: string; code: string };\n    };\n    expect(malformedParsed.error.errorClass).toBe(\"caller_error\");\n    expect(malformedParsed.error.code).toBe(\"invalid_event\");\n\n    const missingFlag = await runCli(\n      [\"intake-stream\", \"message-events\"],\n      async () => \"[]\",\n    );\n    expect(missingFlag.exitCode).toBe(1);\n    const missingParsed = JSON.parse(missingFlag.stdout) as { error: { code: string } };\n    expect(missingParsed.error.code).toBe(\"missing_flag\");\n  });\n});\n","numLines":330,"startLine":1,"totalLines":330}}}

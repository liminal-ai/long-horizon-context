{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-render-targets.test.ts | sed -n '148,270p'\"","aggregated_output":"   148\tdescribe(\"TC-5.2 (AC-5.2, AC-5.3): materialize/pull parity, byte-identical repeat, thread state untouched\", () => {\n   149\t  it(\"every pull message appears in the file, same order, same text; repeat is byte-identical; state hash unchanged\", async () => {\n   150\t    const ref = { filePath: fixture.filePath };\n   151\t    // The view from TC-5.1's compact (suite order) — recompact defensively so\n   152\t    // this test stands alone too.\n   153\t    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n   154\t    expect(compacted.ok).toBe(true);\n   155\t    const pulled = await fixture.sdk.threadView.pull(ref);\n   156\t    expect(pulled.ok).toBe(true);\n   157\t    if (!pulled.ok) return;\n   158\t\n   159\t    const before = fullStateHash(fixture.filePath);\n   160\t    const outPath = join(store.dir, \"render-parity.jsonl\");\n   161\t    const materialized = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n   162\t    expect(materialized.ok).toBe(true);\n   163\t    if (!materialized.ok) return;\n   164\t    expect(materialized.value.writtenPath).toBe(outPath);\n   165\t\n   166\t    // Item-for-item parity: same count, same order, same role, same rendered\n   167\t    // text in the target encoding (one text block per message).\n   168\t    const file = readSessionFile(outPath);\n   169\t    expect(file.entries).toHaveLength(pulled.value.messages.length);\n   170\t    file.entries.forEach((entry, i) => {\n   171\t      const source = pulled.value.messages[i] as ViewMessage;\n   172\t      expect(entry.message.role).toBe(source.role);\n   173\t      expect(entry.message.content).toEqual([{ type: \"text\", text: source.content }]);\n   174\t    });\n   175\t\n   176\t    // Band entries' generated fields derive from view metadata: the view's\n   177\t    // created-at and viewId, never a write-time clock.\n   178\t    expect(file.entries[0]?.timestamp).toBe(pulled.value.meta.createdAt);\n   179\t    expect(file.entries[0]?.id).toBe(`${pulled.value.meta.viewId}-brief`);\n   180\t    expect(file.header[\"timestamp\"]).toBe(pulled.value.meta.createdAt);\n   181\t\n   182\t    // Repeat with no thread changes → byte-identical file.\n   183\t    const again = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n   184\t    expect(again.ok).toBe(true);\n   185\t    expect(sha256(readFileSync(outPath))).toBe(sha256(Buffer.from(file.text)));\n   186\t\n   187\t    // The write changed no thread state — full-file hash, view rows and\n   188\t    // boundary included.\n   189\t    expect(fullStateHash(fixture.filePath)).toBe(before);\n   190\t  });\n   191\t\n   192\t  it(\"rejects an unknown format naming the accepted values, writing nothing\", async () => {\n   193\t    const outPath = join(store.dir, \"never-written.jsonl\");\n   194\t    const result = await fixture.sdk.threadView.materialize(\n   195\t      { filePath: fixture.filePath },\n   196\t      { path: outPath, format: \"markdown\" as \"pi-session\" },\n   197\t    );\n   198\t    expect(result.ok).toBe(false);\n   199\t    if (result.ok) return;\n   200\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   201\t    expect(result.error.code).toBe(\"unknown_format\");\n   202\t    expect(result.error.reason).toContain(\"pi-session\");\n   203\t    expect(() => readFileSync(outPath)).toThrow();\n   204\t  });\n   205\t});\n   206\t\n   207\tdescribe(\"TC-5.3 (AC-5.4): a never-compacted thread materializes its tail-only view\", () => {\n   208\t  it(\"valid file, tail-only content, loadable against the format fixture, header from the thread's created-at\", async () => {\n   209\t    const sdk: Lhc = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n   210\t    const filePath = store.threadPath(\"never-compacted\");\n   211\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   212\t    expect(created.ok).toBe(true);\n   213\t    const seeded = await sdk.intakeStream.messageEvents({ filePath }, [\n   214\t      ...eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n   215\t      ...eventBatch([\"user_prompt\", \"assistant_text\"]),\n   216\t    ]);\n   217\t    expect(seeded.ok).toBe(true);\n   218\t\n   219\t    const outPath = join(store.dir, \"tail-only.jsonl\");\n   220\t    const materialized = await sdk.threadView.materialize({ filePath }, { path: outPath });\n   221\t    expect(materialized.ok).toBe(true);\n   222\t\n   223\t    const file = readSessionFile(outPath);\n   224\t    expect(() => assertPiSessionConformance(file.text)).not.toThrow();\n   225\t\n   226\t    // Tail-only: every entry is a record message (no band context entries),\n   227\t    // matching the pull of the same never-compacted thread.\n   228\t    const pulled = await sdk.threadView.pull({ filePath });\n   229\t    expect(pulled.ok).toBe(true);\n   230\t    if (!pulled.ok) return;\n   231\t    expect(pulled.value.meta.viewId).toBeNull();\n   232\t    // Four record messages (turn_end projects no message), zero band entries.\n   233\t    expect(file.entries).toHaveLength(4);\n   234\t    expect(file.entries.every((e) => !e.message.content[0]?.text.startsWith(\"[context ·\"))).toBe(\n   235\t      true,\n   236\t    );\n   237\t    file.entries.forEach((entry, i) => {\n   238\t      expect(entry.message.content[0]?.text).toBe(pulled.value.messages[i]?.content);\n   239\t    });\n   240\t\n   241\t    // viewId null ⇒ the header derives from the thread's created-at.\n   242\t    const db = openRaw(filePath);\n   243\t    const meta = db\n   244\t      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n   245\t      .get() as { thread_id: string; created_at: string };\n   246\t    db.close();\n   247\t    expect(file.header[\"timestamp\"]).toBe(meta.created_at);\n   248\t    expect(file.header[\"id\"]).toBe(`${meta.thread_id}:${meta.created_at}`);\n   249\t  });\n   250\t});\n   251\t\n   252\tdescribe(\"TC-5.5 (AC-5.3): materialized file conforms to the real-PI-session structure fixture\", () => {\n   253\t  it(\"header line, entry shape, parentId chain, message encoding all validate\", async () => {\n   254\t    const ref = { filePath: fixture.filePath };\n   255\t    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n   256\t    expect(compacted.ok).toBe(true);\n   257\t    const outPath = join(store.dir, \"conformance.jsonl\");\n   258\t    const materialized = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n   259\t    expect(materialized.ok).toBe(true);\n   260\t\n   261\t    const file = readSessionFile(outPath);\n   262\t    expect(() => assertPiSessionConformance(file.text)).not.toThrow();\n   263\t\n   264\t    // The chain explicitly, beyond the helper: first entry parentId null,\n   265\t    // every later entry chained to the previous id.\n   266\t    expect(file.entries[0]?.parentId).toBeNull();\n   267\t    for (let i = 1; i < file.entries.length; i += 1) {\n   268\t      expect(file.entries[i]?.parentId).toBe(file.entries[i - 1]?.id);\n   269\t    }\n   270\t  });\n","exit_code":0,"status":"completed"}}

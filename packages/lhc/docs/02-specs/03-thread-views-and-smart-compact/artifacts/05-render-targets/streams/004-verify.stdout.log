{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/view.ts | sed -n '120,190p'\"","aggregated_output":"   120\t  const parsed = parseViewFlags(args);\n   121\t  if (!parsed.ok) {\n   122\t    return renderCliError(\n   123\t      \"caller_error\",\n   124\t      \"unknown_flag\",\n   125\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n   126\t    );\n   127\t  }\n   128\t  const flags = parsed.flags;\n   129\t  const name = command === undefined ? \"view\" : `view ${command}`;\n   130\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n   131\t    return renderCliError(\n   132\t      \"caller_error\",\n   133\t      \"missing_flag\",\n   134\t      `${name} requires --thread-id or --file-path`,\n   135\t    );\n   136\t  }\n   137\t  const ref = threadRefFrom(flags);\n   138\t\n   139\t  switch (command) {\n   140\t    case \"pull\":\n   141\t      return renderResult(await threadView.pull(ref));\n   142\t    case \"status\":\n   143\t      return renderResult(await threadView.status(ref));\n   144\t    case \"sweep\":\n   145\t      return renderResult(await threadView.sweep(ref));\n   146\t    case \"compact\": {\n   147\t      const opts: Parameters<typeof threadView.compact>[1] = {};\n   148\t      if (flags.profile !== undefined) opts.profile = flags.profile;\n   149\t      if (flags.noSweep === true) opts.sweep = false;\n   150\t      // Band flags override the profile field-wise BEFORE validation\n   151\t      // (AC-2.2): `--full 40` over a 30/30/20/20 profile fails the sum check\n   152\t      // with the named violation — correct behavior, not adapter business.\n   153\t      const params: ViewCompactParams = {};\n   154\t      const percentages: NonNullable<ViewCompactParams[\"percentages\"]> = {};\n   155\t      const numeric: Array<[string | undefined, string, (n: number) => void]> = [\n   156\t        [flags.lowerBound, \"--lower-bound\", (n) => (params.lowerBound = n)],\n   157\t        [flags.full, \"--full\", (n) => (percentages.full = n)],\n   158\t        [flags.smooth, \"--smooth\", (n) => (percentages.smooth = n)],\n   159\t        [flags.detailed, \"--detailed\", (n) => (percentages.detailed = n)],\n   160\t        [flags.brief, \"--brief\", (n) => (percentages.brief = n)],\n   161\t      ];\n   162\t      for (const [raw, flag, assign] of numeric) {\n   163\t        if (raw === undefined) continue;\n   164\t        const value = parseNumericFlag(raw, flag);\n   165\t        if (!value.ok) return value.result;\n   166\t        assign(value.value);\n   167\t      }\n   168\t      if (Object.keys(percentages).length > 0) params.percentages = percentages;\n   169\t      if (Object.keys(params).length > 0) opts.params = params;\n   170\t      return renderResult(await threadView.compact(ref, opts));\n   171\t    }\n   172\t    case \"materialize\": {\n   173\t      if (flags.out === undefined) {\n   174\t        return renderCliError(\n   175\t          \"caller_error\",\n   176\t          \"missing_flag\",\n   177\t          \"view materialize requires --out <path>\",\n   178\t        );\n   179\t      }\n   180\t      const opts: Parameters<typeof threadView.materialize>[1] = { path: flags.out };\n   181\t      // Passed through as given: an unknown format is the operation's\n   182\t      // caller_error naming the accepted values, identically to an SDK caller.\n   183\t      if (flags.format !== undefined) {\n   184\t        opts.format = flags.format as \"pi-session\";\n   185\t      }\n   186\t      return renderResult(await threadView.materialize(ref, opts));\n   187\t    }\n   188\t    default:\n   189\t      return renderCliError(\n   190\t        \"caller_error\",\n","exit_code":0,"status":"completed"}}

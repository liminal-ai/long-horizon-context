{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' packages/lhc/src/cli/render.ts\"","aggregated_output":"import type { ErrorClass, OpResult } from \"../shared/errors.js\";\n\nexport interface CliResult {\n  exitCode: number;\n  stdout: string;\n  stderr: string;\n}\n\n// Adapter-level failures (unknown command, missing command) happen before any\n// SDK call, so they carry adapter codes outside the SDK's ErrorCode set while\n// keeping the same structural shape.\nexport type CliErrorCode = \"unknown_command\" | \"missing_flag\" | \"unknown_flag\";\n\nexport function renderResult(result: OpResult<unknown>): CliResult {\n  return {\n    exitCode: result.ok ? 0 : 1,\n    stdout: `${JSON.stringify(result, null, 2)}\\n`,\n    stderr: \"\",\n  };\n}\n\nexport function renderCliError(\n  errorClass: ErrorClass,\n  code: CliErrorCode,\n  reason: string,\n): CliResult {\n  return {\n    exitCode: 1,\n    stdout: `${JSON.stringify({ ok: false, error: { errorClass, code, reason } }, null, 2)}\\n`,\n    stderr: \"\",\n  };\n}\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012DNqxnY451eLTxDWdt9zSN","type":"tool_result","content":"1\t// `lhc work drain` plus the per-owner report and requeue mirrors (Story 4)\n2\t// — work.ts owns the drain/report/requeue command surface per tech design\n3\t// §Placement. Provider resolution per DD-11: explicit `--provider` or\n4\t// LHC_PROVIDER, looked up in the named-provider registry; no default and no\n5\t// silent no-op — an unresolvable provider is a caller error naming both the\n6\t// flag and the env var. Report, requeue, and mutations need no provider;\n7\t// only drain dispatches handlers.\n8\timport * as messages from \"../domains/messages/index.js\";\n9\timport * as turns from \"../domains/turns/index.js\";\n10\timport type { ThreadRef } from \"../domains/threads/index.js\";\n11\timport { registeredProviderNames, resolveNamedProvider } from \"../providers/registry.js\";\n12\timport { createSdk } from \"../sdk.js\";\n13\timport type { DerivationProvider, FormKind } from \"../shared/derivation.js\";\n14\timport type { ErrorResult, OpResult } from \"../shared/errors.js\";\n15\timport { renderResult, type CliResult } from \"./render.js\";\n16\t\n17\tfunction providerNotConfigured(reason: string): { ok: false; error: ErrorResult } {\n18\t  return {\n19\t    ok: false,\n20\t    error: { errorClass: \"caller_error\", code: \"provider_not_configured\", reason },\n21\t  };\n22\t}\n23\t\n24\texport function resolveCliProvider(\n25\t  providerFlag: string | undefined,\n26\t): OpResult<DerivationProvider> {\n27\t  const name = providerFlag ?? process.env[\"LHC_PROVIDER\"];\n28\t  if (name === undefined || name === \"\") {\n29\t    return providerNotConfigured(\n30\t      \"work drain needs a derivation provider: pass --provider <name> or set LHC_PROVIDER\",\n31\t    );\n32\t  }\n33\t  const provider = resolveNamedProvider(name);\n34\t  if (provider === undefined) {\n35\t    return providerNotConfigured(\n36\t      `no provider registered under \"${name}\" (--provider / LHC_PROVIDER); known: ${registeredProviderNames().join(\", \")}`,\n37\t    );\n38\t  }\n39\t  return { ok: true, value: provider };\n40\t}\n41\t\n42\texport async function runWorkDrain(\n43\t  threadRef: ThreadRef,\n44\t  flags: { provider?: string; maxItems?: number },\n45\t): Promise<CliResult> {\n46\t  const provider = resolveCliProvider(flags.provider);\n47\t  if (!provider.ok) return renderResult(provider);\n48\t  // The CLI is the manual host: it assembles the same SDK production hosts\n49\t  // do and drains through the same surface — no in-process shortcut.\n50\t  const sdk = createSdk({ provider: provider.value, mode: \"manual\" });\n51\t  return renderResult(\n52\t    await sdk.work.drain(\n53\t      threadRef,\n54\t      flags.maxItems !== undefined ? { maxItems: flags.maxItems } : undefined,\n55\t    ),\n56\t  );\n57\t}\n58\t\n59\t// The report and requeue mirrors call the same domain operations the SDK\n60\t// surfaces expose — same validation, same result JSON (AC-4.3/AC-4.4 CLI\n61\t// parity). Form names pass through as given; an unknown form is refused by\n62\t// the operation's own mapping check, identically to an SDK caller.\n63\t\n64\texport async function runMessagesReport(\n65\t  threadRef: ThreadRef,\n66\t  flags: { notReady?: boolean; messageId?: string },\n67\t): Promise<CliResult> {\n68\t  const opts: { notReady?: boolean; messageId?: string } = {};\n69\t  if (flags.notReady === true) opts.notReady = true;\n70\t  if (flags.messageId !== undefined) opts.messageId = flags.messageId;\n71\t  return renderResult(await messages.report(threadRef, opts));\n72\t}\n73\t\n74\texport async function runMessagesRequeue(\n75\t  threadRef: ThreadRef,\n76\t  flags: { messageId: string; form: string },\n77\t): Promise<CliResult> {\n78\t  return renderResult(\n79\t    await messages.requeue(threadRef, {\n80\t      messageId: flags.messageId,\n81\t      form: flags.form as FormKind,\n82\t    }),\n83\t  );\n84\t}\n85\t\n86\texport async function runTurnsReport(\n87\t  threadRef: ThreadRef,\n88\t  flags: { notReady?: boolean; turnId?: string; chunkId?: string },\n89\t): Promise<CliResult> {\n90\t  const opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n91\t  if (flags.notReady === true) opts.notReady = true;\n92\t  if (flags.turnId !== undefined) opts.turnId = flags.turnId;\n93\t  if (flags.chunkId !== undefined) opts.chunkId = flags.chunkId;\n94\t  return renderResult(await turns.report(threadRef, opts));\n95\t}\n96\t\n97\texport async function runTurnsRequeue(\n98\t  threadRef: ThreadRef,\n99\t  flags: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: string },\n100\t): Promise<CliResult> {\n101\t  return renderResult(\n102\t    await turns.requeue(threadRef, {\n103\t      subjectKind: flags.subjectKind,\n104\t      subjectId: flags.subjectId,\n105\t      form: flags.form as FormKind,\n106\t    }),\n107\t  );\n108\t}\n109\t"}]},"parent_tool_use_id":null,"session_id":"d96b6140-abf0-4148-ae10-52f37fa752e0","uuid":"a169179b-cdb5-46f0-b7ce-03874817821a","timestamp":"2026-06-11T17:51:22.529Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/work.ts","content":"// `lhc work drain` plus the per-owner report and requeue mirrors (Story 4)\n// — work.ts owns the drain/report/requeue command surface per tech design\n// §Placement. Provider resolution per DD-11: explicit `--provider` or\n// LHC_PROVIDER, looked up in the named-provider registry; no default and no\n// silent no-op — an unresolvable provider is a caller error naming both the\n// flag and the env var. Report, requeue, and mutations need no provider;\n// only drain dispatches handlers.\nimport * as messages from \"../domains/messages/index.js\";\nimport * as turns from \"../domains/turns/index.js\";\nimport type { ThreadRef } from \"../domains/threads/index.js\";\nimport { registeredProviderNames, resolveNamedProvider } from \"../providers/registry.js\";\nimport { createSdk } from \"../sdk.js\";\nimport type { DerivationProvider, FormKind } from \"../shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"../shared/errors.js\";\nimport { renderResult, type CliResult } from \"./render.js\";\n\nfunction providerNotConfigured(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"caller_error\", code: \"provider_not_configured\", reason },\n  };\n}\n\nexport function resolveCliProvider(\n  providerFlag: string | undefined,\n): OpResult<DerivationProvider> {\n  const name = providerFlag ?? process.env[\"LHC_PROVIDER\"];\n  if (name === undefined || name === \"\") {\n    return providerNotConfigured(\n      \"work drain needs a derivation provider: pass --provider <name> or set LHC_PROVIDER\",\n    );\n  }\n  const provider = resolveNamedProvider(name);\n  if (provider === undefined) {\n    return providerNotConfigured(\n      `no provider registered under \"${name}\" (--provider / LHC_PROVIDER); known: ${registeredProviderNames().join(\", \")}`,\n    );\n  }\n  return { ok: true, value: provider };\n}\n\nexport async function runWorkDrain(\n  threadRef: ThreadRef,\n  flags: { provider?: string; maxItems?: number },\n): Promise<CliResult> {\n  const provider = resolveCliProvider(flags.provider);\n  if (!provider.ok) return renderResult(provider);\n  // The CLI is the manual host: it assembles the same SDK production hosts\n  // do and drains through the same surface — no in-process shortcut.\n  const sdk = createSdk({ provider: provider.value, mode: \"manual\" });\n  return renderResult(\n    await sdk.work.drain(\n      threadRef,\n      flags.maxItems !== undefined ? { maxItems: flags.maxItems } : undefined,\n    ),\n  );\n}\n\n// The report and requeue mirrors call the same domain operations the SDK\n// surfaces expose — same validation, same result JSON (AC-4.3/AC-4.4 CLI\n// parity). Form names pass through as given; an unknown form is refused by\n// the operation's own mapping check, identically to an SDK caller.\n\nexport async function runMessagesReport(\n  threadRef: ThreadRef,\n  flags: { notReady?: boolean; messageId?: string },\n): Promise<CliResult> {\n  const opts: { notReady?: boolean; messageId?: string } = {};\n  if (flags.notReady === true) opts.notReady = true;\n  if (flags.messageId !== undefined) opts.messageId = flags.messageId;\n  return renderResult(await messages.report(threadRef, opts));\n}\n\nexport async function runMessagesRequeue(\n  threadRef: ThreadRef,\n  flags: { messageId: string; form: string },\n): Promise<CliResult> {\n  return renderResult(\n    await messages.requeue(threadRef, {\n      messageId: flags.messageId,\n      form: flags.form as FormKind,\n    }),\n  );\n}\n\nexport async function runTurnsReport(\n  threadRef: ThreadRef,\n  flags: { notReady?: boolean; turnId?: string; chunkId?: string },\n): Promise<CliResult> {\n  const opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n  if (flags.notReady === true) opts.notReady = true;\n  if (flags.turnId !== undefined) opts.turnId = flags.turnId;\n  if (flags.chunkId !== undefined) opts.chunkId = flags.chunkId;\n  return renderResult(await turns.report(threadRef, opts));\n}\n\nexport async function runTurnsRequeue(\n  threadRef: ThreadRef,\n  flags: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: string },\n): Promise<CliResult> {\n  return renderResult(\n    await turns.requeue(threadRef, {\n      subjectKind: flags.subjectKind,\n      subjectId: flags.subjectId,\n      form: flags.form as FormKind,\n    }),\n  );\n}\n","numLines":109,"startLine":1,"totalLines":109}}}

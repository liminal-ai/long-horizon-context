{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FviL1hgLUvbgPnRo3hwFr7","type":"tool_result","content":"1\t// The pull's read path (Story 1): the stored view snapshot — header plus\n2\t// band rows, absent ⇒ tail-only signal — and the record reads the tail\n3\t// assembly needs (live messages after the compact point, their ready\n4\t// tool-result summaries, the tail token sum). Story 2 adds the one writer:\n5\t// the atomic replace at compact. Direct record/derived_form reads are\n6\t// sanctioned for thread-view internals (tech design §System View — the\n7\t// surface-import rule governs code imports, not SQL); what must NOT read\n8\t// derived_form directly is the status's derivation counting, which goes\n9\t// through the owners' report surfaces in index.ts.\n10\timport type { DatabaseSync } from \"node:sqlite\";\n11\timport type { Band } from \"../../../shared/view.js\";\n12\timport type { RenderingPartKind } from \"../../../shared/derivation.js\";\n13\t\n14\t// ── view snapshot (header + bands) ────────────────────────────────\n15\t\n16\texport interface ViewSnapshot {\n17\t  viewId: string;\n18\t  createdAt: string;\n19\t  compactPoint: number;\n20\t  coveredFrom: number;\n21\t  gapCount: number;\n22\t  degradedCount: number;\n23\t  // Non-empty bands in gradient order (brief → detailed → smooth), the order\n24\t  // the pull prepends them in.\n25\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n26\t}\n27\t\n28\tinterface RawViewRow {\n29\t  view_id: string;\n30\t  created_at: string;\n31\t  compact_point: number | bigint;\n32\t  covered_from: number | bigint;\n33\t  arrangement_json: string;\n34\t  gaps_json: string;\n35\t}\n36\t\n37\tconst BAND_GRADIENT_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n38\t\n39\t// null ⇒ no view exists (never compacted): the whole record renders as tail\n40\t// from event 1 through the same pull code path — snapshot-absent, not a\n41\t// separate branch (story Anti-Shim Requirements).\n42\texport function readViewSnapshot(db: DatabaseSync): ViewSnapshot | null {\n43\t  const header = db\n44\t    .prepare(\n45\t      `SELECT view_id, created_at, compact_point, covered_from, arrangement_json, gaps_json\n46\t       FROM thread_view WHERE singleton = 1`,\n47\t    )\n48\t    .get() as RawViewRow | undefined;\n49\t  if (header === undefined) return null;\n50\t\n51\t  const arrangement = JSON.parse(header.arrangement_json) as Array<{ degraded?: boolean }>;\n52\t  const gaps = JSON.parse(header.gaps_json) as unknown[];\n53\t  const bandRows = db\n54\t    .prepare(\n55\t      `SELECT band, rendered_text, token_count FROM thread_view_band WHERE view_id = ?`,\n56\t    )\n57\t    .all(header.view_id) as unknown as Array<{\n58\t    band: string;\n59\t    rendered_text: string;\n60\t    token_count: number | bigint;\n61\t  }>;\n62\t  const byBand = new Map(bandRows.map((row) => [row.band, row]));\n63\t\n64\t  return {\n65\t    viewId: header.view_id,\n66\t    createdAt: header.created_at,\n67\t    compactPoint: Number(header.compact_point),\n68\t    coveredFrom: Number(header.covered_from),\n69\t    gapCount: gaps.length,\n70\t    degradedCount: arrangement.filter((entry) => entry.degraded === true).length,\n71\t    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\n72\t      const row = byBand.get(band);\n73\t      return row === undefined\n74\t        ? []\n75\t        : [{ band, renderedText: row.rendered_text, tokenCount: Number(row.token_count) }];\n76\t    }),\n77\t  };\n78\t}\n79\t\n80\t// ── tail record reads ─────────────────────────────────────────────\n81\t\n82\texport interface TailMessageRow {\n83\t  messageId: string;\n84\t  sourceEventOrder: number;\n85\t  kind: RenderingPartKind;\n86\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n87\t}\n88\t\n89\t// Live messages after the compact point in record order, with their projected\n90\t// blocks — the deleted-read filter applied here so a deleted message never\n91\t// reaches rendering (AC-1.x delete filtering).\n92\texport function readTailMessages(db: DatabaseSync, compactPoint: number): TailMessageRow[] {\n93\t  const messageRows = db\n94\t    .prepare(\n95\t      `SELECT message_id, source_event_order, kind FROM message\n96\t       WHERE deleted_at IS NULL AND source_event_order > ?\n97\t       ORDER BY source_event_order`,\n98\t    )\n99\t    .all(compactPoint) as unknown as Array<{\n100\t    message_id: string;\n101\t    source_event_order: number | bigint;\n102\t    kind: string;\n103\t  }>;\n104\t  const blockRows = db\n105\t    .prepare(\n106\t      `SELECT mb.message_id, mb.block_type, mb.content\n107\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n108\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\n109\t       ORDER BY m.source_event_order, mb.block_index`,\n110\t    )\n111\t    .all(compactPoint) as unknown as Array<{\n112\t    message_id: string;\n113\t    block_type: string;\n114\t    content: string;\n115\t  }>;\n116\t  const blocksByMessage = new Map<string, TailMessageRow[\"blocks\"]>();\n117\t  for (const row of blockRows) {\n118\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n119\t    blocks.push({\n120\t      blockType: row.block_type,\n121\t      content: JSON.parse(row.content) as Record<string, unknown>,\n122\t    });\n123\t    blocksByMessage.set(row.message_id, blocks);\n124\t  }\n125\t  return messageRows.map((row) => ({\n126\t    messageId: row.message_id,\n127\t    sourceEventOrder: Number(row.source_event_order),\n128\t    kind: row.kind as RenderingPartKind,\n129\t    blocks: blocksByMessage.get(row.message_id) ?? [],\n130\t  }));\n131\t}\n132\t\n133\t// The tail's token sum for status (AC-2.8): every live message after the\n134\t// compact point, all kinds — the same population the pull renders as tail.\n135\texport function tailTokenSum(db: DatabaseSync, compactPoint: number): number {\n136\t  const row = db\n137\t    .prepare(\n138\t      `SELECT COALESCE(SUM(token_estimate), 0) AS total FROM message\n139\t       WHERE deleted_at IS NULL AND source_event_order > ?`,\n140\t    )\n141\t    .get(compactPoint) as { total: number | bigint };\n142\t  return Number(row.total);\n143\t}\n144\t\n145\t// ── the atomic replace (Story 2, AC-2.6) ──────────────────────────\n146\t\n147\texport interface ViewReplaceInput {\n148\t  viewId: string;\n149\t  createdAt: string;\n150\t  compactPoint: number;\n151\t  coveredFrom: number;\n152\t  profileName: string | null;\n153\t  configJson: string;\n154\t  arrangementJson: string;\n155\t  gapsJson: string;\n156\t  sourceStateJson: string;\n157\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n158\t}\n159\t\n160\t// Compact's one transaction: delete the singleton view row (the FK cascade\n161\t// drops its bands), insert the new header and bands, and reset the boundary\n162\t// to the compact point (AC-4.7) — all inside one BEGIN IMMEDIATE, so a crash\n163\t// anywhere rolls the whole replace back and the previous view keeps serving\n164\t// (AC-2.6, TC-2.4). Compact is the only writer of these rows; the boundary's\n165\t// other writer is Story 4's advance.\n166\texport function replaceViewSnapshot(db: DatabaseSync, input: ViewReplaceInput): void {\n167\t  db.exec(\"BEGIN IMMEDIATE;\");\n168\t  try {\n169\t    db.prepare(`DELETE FROM thread_view WHERE singleton = 1`).run();\n170\t    db.prepare(\n171\t      `INSERT INTO thread_view (singleton, view_id, created_at, compact_point, covered_from,\n172\t         profile_name, config_json, arrangement_json, gaps_json, source_state_json)\n173\t       VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n174\t    ).run(\n175\t      input.viewId,\n176\t      input.createdAt,\n177\t      input.compactPoint,\n178\t      input.coveredFrom,\n179\t      input.profileName,\n180\t      input.configJson,\n181\t      input.arrangementJson,\n182\t      input.gapsJson,\n183\t      input.sourceStateJson,\n184\t    );\n185\t    const insertBand = db.prepare(\n186\t      `INSERT INTO thread_view_band (view_id, band, rendered_text, token_count)\n187\t       VALUES (?, ?, ?, ?)`,\n188\t    );\n189\t    for (const band of input.bands) {\n190\t      insertBand.run(input.viewId, band.band, band.renderedText, band.tokenCount);\n191\t    }\n192\t    db.prepare(\n193\t      `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n194\t    ).run(input.compactPoint, input.createdAt);\n195\t    db.exec(\"COMMIT;\");\n196\t  } catch (cause) {\n197\t    db.exec(\"ROLLBACK;\");\n198\t    throw cause;\n199\t  }\n200\t}\n201\t\n202\t// Ready tool-result summaries by message id — the short-form ladder's first\n203\t// rung. Stored state read verbatim, never derived here (no-inference rule).\n204\texport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\n205\t  const rows = db\n206\t    .prepare(\n207\t      `SELECT subject_id, content FROM derived_form\n208\t       WHERE subject_kind = 'message' AND form = 'tool_result_summary'\n209\t         AND state = 'ready' AND content IS NOT NULL`,\n210\t    )\n211\t    .all() as unknown as Array<{ subject_id: string; content: string }>;\n212\t  return new Map(rows.map((row) => [row.subject_id, row.content]));\n213\t}\n214\t"}]},"parent_tool_use_id":null,"session_id":"d96b6140-abf0-4148-ae10-52f37fa752e0","uuid":"30a8e1e8-d6b7-4e52-92e6-6961fc949465","timestamp":"2026-06-11T17:51:12.320Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/snapshot.ts","content":"// The pull's read path (Story 1): the stored view snapshot — header plus\n// band rows, absent ⇒ tail-only signal — and the record reads the tail\n// assembly needs (live messages after the compact point, their ready\n// tool-result summaries, the tail token sum). Story 2 adds the one writer:\n// the atomic replace at compact. Direct record/derived_form reads are\n// sanctioned for thread-view internals (tech design §System View — the\n// surface-import rule governs code imports, not SQL); what must NOT read\n// derived_form directly is the status's derivation counting, which goes\n// through the owners' report surfaces in index.ts.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { Band } from \"../../../shared/view.js\";\nimport type { RenderingPartKind } from \"../../../shared/derivation.js\";\n\n// ── view snapshot (header + bands) ────────────────────────────────\n\nexport interface ViewSnapshot {\n  viewId: string;\n  createdAt: string;\n  compactPoint: number;\n  coveredFrom: number;\n  gapCount: number;\n  degradedCount: number;\n  // Non-empty bands in gradient order (brief → detailed → smooth), the order\n  // the pull prepends them in.\n  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n}\n\ninterface RawViewRow {\n  view_id: string;\n  created_at: string;\n  compact_point: number | bigint;\n  covered_from: number | bigint;\n  arrangement_json: string;\n  gaps_json: string;\n}\n\nconst BAND_GRADIENT_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n\n// null ⇒ no view exists (never compacted): the whole record renders as tail\n// from event 1 through the same pull code path — snapshot-absent, not a\n// separate branch (story Anti-Shim Requirements).\nexport function readViewSnapshot(db: DatabaseSync): ViewSnapshot | null {\n  const header = db\n    .prepare(\n      `SELECT view_id, created_at, compact_point, covered_from, arrangement_json, gaps_json\n       FROM thread_view WHERE singleton = 1`,\n    )\n    .get() as RawViewRow | undefined;\n  if (header === undefined) return null;\n\n  const arrangement = JSON.parse(header.arrangement_json) as Array<{ degraded?: boolean }>;\n  const gaps = JSON.parse(header.gaps_json) as unknown[];\n  const bandRows = db\n    .prepare(\n      `SELECT band, rendered_text, token_count FROM thread_view_band WHERE view_id = ?`,\n    )\n    .all(header.view_id) as unknown as Array<{\n    band: string;\n    rendered_text: string;\n    token_count: number | bigint;\n  }>;\n  const byBand = new Map(bandRows.map((row) => [row.band, row]));\n\n  return {\n    viewId: header.view_id,\n    createdAt: header.created_at,\n    compactPoint: Number(header.compact_point),\n    coveredFrom: Number(header.covered_from),\n    gapCount: gaps.length,\n    degradedCount: arrangement.filter((entry) => entry.degraded === true).length,\n    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\n      const row = byBand.get(band);\n      return row === undefined\n        ? []\n        : [{ band, renderedText: row.rendered_text, tokenCount: Number(row.token_count) }];\n    }),\n  };\n}\n\n// ── tail record reads ─────────────────────────────────────────────\n\nexport interface TailMessageRow {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: RenderingPartKind;\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n}\n\n// Live messages after the compact point in record order, with their projected\n// blocks — the deleted-read filter applied here so a deleted message never\n// reaches rendering (AC-1.x delete filtering).\nexport function readTailMessages(db: DatabaseSync, compactPoint: number): TailMessageRow[] {\n  const messageRows = db\n    .prepare(\n      `SELECT message_id, source_event_order, kind FROM message\n       WHERE deleted_at IS NULL AND source_event_order > ?\n       ORDER BY source_event_order`,\n    )\n    .all(compactPoint) as unknown as Array<{\n    message_id: string;\n    source_event_order: number | bigint;\n    kind: string;\n  }>;\n  const blockRows = db\n    .prepare(\n      `SELECT mb.message_id, mb.block_type, mb.content\n       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\n       ORDER BY m.source_event_order, mb.block_index`,\n    )\n    .all(compactPoint) as unknown as Array<{\n    message_id: string;\n    block_type: string;\n    content: string;\n  }>;\n  const blocksByMessage = new Map<string, TailMessageRow[\"blocks\"]>();\n  for (const row of blockRows) {\n    const blocks = blocksByMessage.get(row.message_id) ?? [];\n    blocks.push({\n      blockType: row.block_type,\n      content: JSON.parse(row.content) as Record<string, unknown>,\n    });\n    blocksByMessage.set(row.message_id, blocks);\n  }\n  return messageRows.map((row) => ({\n    messageId: row.message_id,\n    sourceEventOrder: Number(row.source_event_order),\n    kind: row.kind as RenderingPartKind,\n    blocks: blocksByMessage.get(row.message_id) ?? [],\n  }));\n}\n\n// The tail's token sum for status (AC-2.8): every live message after the\n// compact point, all kinds — the same population the pull renders as tail.\nexport function tailTokenSum(db: DatabaseSync, compactPoint: number): number {\n  const row = db\n    .prepare(\n      `SELECT COALESCE(SUM(token_estimate), 0) AS total FROM message\n       WHERE deleted_at IS NULL AND source_event_order > ?`,\n    )\n    .get(compactPoint) as { total: number | bigint };\n  return Number(row.total);\n}\n\n// ── the atomic replace (Story 2, AC-2.6) ──────────────────────────\n\nexport interface ViewReplaceInput {\n  viewId: string;\n  createdAt: string;\n  compactPoint: number;\n  coveredFrom: number;\n  profileName: string | null;\n  configJson: string;\n  arrangementJson: string;\n  gapsJson: string;\n  sourceStateJson: string;\n  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n}\n\n// Compact's one transaction: delete the singleton view row (the FK cascade\n// drops its bands), insert the new header and bands, and reset the boundary\n// to the compact point (AC-4.7) — all inside one BEGIN IMMEDIATE, so a crash\n// anywhere rolls the whole replace back and the previous view keeps serving\n// (AC-2.6, TC-2.4). Compact is the only writer of these rows; the boundary's\n// other writer is Story 4's advance.\nexport function replaceViewSnapshot(db: DatabaseSync, input: ViewReplaceInput): void {\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    db.prepare(`DELETE FROM thread_view WHERE singleton = 1`).run();\n    db.prepare(\n      `INSERT INTO thread_view (singleton, view_id, created_at, compact_point, covered_from,\n         profile_name, config_json, arrangement_json, gaps_json, source_state_json)\n       VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n    ).run(\n      input.viewId,\n      input.createdAt,\n      input.compactPoint,\n      input.coveredFrom,\n      input.profileName,\n      input.configJson,\n      input.arrangementJson,\n      input.gapsJson,\n      input.sourceStateJson,\n    );\n    const insertBand = db.prepare(\n      `INSERT INTO thread_view_band (view_id, band, rendered_text, token_count)\n       VALUES (?, ?, ?, ?)`,\n    );\n    for (const band of input.bands) {\n      insertBand.run(input.viewId, band.band, band.renderedText, band.tokenCount);\n    }\n    db.prepare(\n      `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n    ).run(input.compactPoint, input.createdAt);\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// Ready tool-result summaries by message id — the short-form ladder's first\n// rung. Stored state read verbatim, never derived here (no-inference rule).\nexport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\n  const rows = db\n    .prepare(\n      `SELECT subject_id, content FROM derived_form\n       WHERE subject_kind = 'message' AND form = 'tool_result_summary'\n         AND state = 'ready' AND content IS NOT NULL`,\n    )\n    .all() as unknown as Array<{ subject_id: string; content: string }>;\n  return new Map(rows.map((row) => [row.subject_id, row.content]));\n}\n","numLines":214,"startLine":1,"totalLines":214}}}

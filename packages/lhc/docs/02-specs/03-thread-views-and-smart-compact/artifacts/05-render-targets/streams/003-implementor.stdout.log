{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D4hTrJHHvY6QPkMyJJg8fe","type":"tool_result","content":"1\t// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\n2\t// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\n3\t// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \"same\n4\t// receipt shape\" is proven by both targets passing the same checker, not by\n5\t// two hand-kept assertion lists drifting apart.\n6\timport type { SweepReceipt } from \"../../src/index.js\";\n7\t\n8\tfunction fail(path: string, expected: string, actual: unknown): never {\n9\t  throw new Error(\n10\t    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\n11\t  );\n12\t}\n13\t\n14\tfunction assertCount(value: unknown, path: string): void {\n15\t  if (typeof value !== \"number\" || !Number.isInteger(value) || value < 0) {\n16\t    fail(path, \"a non-negative integer\", value);\n17\t  }\n18\t}\n19\t\n20\tfunction assertSubjectReasonList(value: unknown, path: string): void {\n21\t  if (!Array.isArray(value)) fail(path, \"an array\", value);\n22\t  value.forEach((item, i) => {\n23\t    if (typeof item !== \"object\" || item === null) fail(`${path}[${i}]`, \"an object\", item);\n24\t    const entry = item as Record<string, unknown>;\n25\t    if (typeof entry.subjectId !== \"string\" || entry.subjectId === \"\") {\n26\t      fail(`${path}[${i}].subjectId`, \"a non-empty string\", entry.subjectId);\n27\t    }\n28\t    if (typeof entry.reason !== \"string\" || entry.reason === \"\") {\n29\t      fail(`${path}[${i}].reason`, \"a non-empty string\", entry.reason);\n30\t    }\n31\t  });\n32\t}\n33\t\n34\texport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\n35\t  if (typeof value !== \"object\" || value === null) fail(\"receipt\", \"an object\", value);\n36\t  const receipt = value as Record<string, unknown>;\n37\t  if (!Array.isArray(receipt.owners)) fail(\"receipt.owners\", \"an array\", receipt.owners);\n38\t  receipt.owners.forEach((line, i) => {\n39\t    const path = `owners[${i}]`;\n40\t    if (typeof line !== \"object\" || line === null) fail(path, \"an object\", line);\n41\t    const entry = line as Record<string, unknown>;\n42\t    if (entry.owner !== \"messages\" && entry.owner !== \"turns\") {\n43\t      fail(`${path}.owner`, '\"messages\" | \"turns\"', entry.owner);\n44\t    }\n45\t    if (typeof entry.kind !== \"string\" || entry.kind === \"\") {\n46\t      fail(`${path}.kind`, \"a non-empty string\", entry.kind);\n47\t    }\n48\t    assertCount(entry.ready, `${path}.ready`);\n49\t    assertCount(entry.inFlight, `${path}.inFlight`);\n50\t    if (\n51\t      !Array.isArray(entry.requeued) ||\n52\t      entry.requeued.some((id) => typeof id !== \"string\" || id === \"\")\n53\t    ) {\n54\t      fail(`${path}.requeued`, \"an array of non-empty subject-id strings\", entry.requeued);\n55\t    }\n56\t    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\n57\t    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\n58\t  });\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"d96b6140-abf0-4148-ae10-52f37fa752e0","uuid":"d686c1e0-18c2-43ab-b0c2-fcdf8d35a6fc","timestamp":"2026-06-11T17:53:30.976Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/receipt-schema.ts","content":"// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\n// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\n// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \"same\n// receipt shape\" is proven by both targets passing the same checker, not by\n// two hand-kept assertion lists drifting apart.\nimport type { SweepReceipt } from \"../../src/index.js\";\n\nfunction fail(path: string, expected: string, actual: unknown): never {\n  throw new Error(\n    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\n  );\n}\n\nfunction assertCount(value: unknown, path: string): void {\n  if (typeof value !== \"number\" || !Number.isInteger(value) || value < 0) {\n    fail(path, \"a non-negative integer\", value);\n  }\n}\n\nfunction assertSubjectReasonList(value: unknown, path: string): void {\n  if (!Array.isArray(value)) fail(path, \"an array\", value);\n  value.forEach((item, i) => {\n    if (typeof item !== \"object\" || item === null) fail(`${path}[${i}]`, \"an object\", item);\n    const entry = item as Record<string, unknown>;\n    if (typeof entry.subjectId !== \"string\" || entry.subjectId === \"\") {\n      fail(`${path}[${i}].subjectId`, \"a non-empty string\", entry.subjectId);\n    }\n    if (typeof entry.reason !== \"string\" || entry.reason === \"\") {\n      fail(`${path}[${i}].reason`, \"a non-empty string\", entry.reason);\n    }\n  });\n}\n\nexport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\n  if (typeof value !== \"object\" || value === null) fail(\"receipt\", \"an object\", value);\n  const receipt = value as Record<string, unknown>;\n  if (!Array.isArray(receipt.owners)) fail(\"receipt.owners\", \"an array\", receipt.owners);\n  receipt.owners.forEach((line, i) => {\n    const path = `owners[${i}]`;\n    if (typeof line !== \"object\" || line === null) fail(path, \"an object\", line);\n    const entry = line as Record<string, unknown>;\n    if (entry.owner !== \"messages\" && entry.owner !== \"turns\") {\n      fail(`${path}.owner`, '\"messages\" | \"turns\"', entry.owner);\n    }\n    if (typeof entry.kind !== \"string\" || entry.kind === \"\") {\n      fail(`${path}.kind`, \"a non-empty string\", entry.kind);\n    }\n    assertCount(entry.ready, `${path}.ready`);\n    assertCount(entry.inFlight, `${path}.inFlight`);\n    if (\n      !Array.isArray(entry.requeued) ||\n      entry.requeued.some((id) => typeof id !== \"string\" || id === \"\")\n    ) {\n      fail(`${path}.requeued`, \"an array of non-empty subject-id strings\", entry.requeued);\n    }\n    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\n    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\n  });\n}\n","numLines":60,"startLine":1,"totalLines":60}}}

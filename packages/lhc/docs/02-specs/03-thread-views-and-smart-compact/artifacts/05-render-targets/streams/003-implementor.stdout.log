{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tf8VE3vGfPCqWgFgkXJAkF","type":"tool_result","content":"1\t// Epic 03 Story 2: smart compact (TC-2.1–2.4, TC-2.6, TC-2.7, TC-1.3,\n2\t// TC-1.5, the TC-2.5 view-health completion legs, and the architecture-risk\n3\t// rows: restart-serves-snapshot and coverage-edge accounting). Every TC goes\n4\t// through the real SDK surface (createSdk().threadView.compact) against real\n5\t// temp thread files; the provider double appears only in fixture setup —\n6\t// degraded states are reached through production paths (scripted provider\n7\t// exhaustion at build, edit-cascade pending clears), never by writing\n8\t// derived_form directly.\n9\timport { createHash } from \"node:crypto\";\n10\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n11\timport {\n12\t  createSdk,\n13\t  type Lhc,\n14\t  type MessageEventInput,\n15\t  type ViewMessage,\n16\t} from \"../src/index.js\";\n17\timport {\n18\t  corruptTwoOpenTurns,\n19\t  createProviderDouble,\n20\t  derivedThreadFixture,\n21\t  openRaw,\n22\t  setViewInjectionHook,\n23\t  tempStore,\n24\t  validEvent,\n25\t  type DerivedThreadFixture,\n26\t  type ProviderDouble,\n27\t  type TempStore,\n28\t} from \"./fixtures/index.js\";\n29\t\n30\tlet store: TempStore;\n31\tlet fixture: DerivedThreadFixture;\n32\t\n33\tbeforeAll(async () => {\n34\t  store = tempStore();\n35\t  fixture = await derivedThreadFixture(store);\n36\t});\n37\tafterAll(() => {\n38\t  store.cleanup();\n39\t});\n40\t\n41\t// The story's reference configs (hand-derived from the fixture's\n42\t// deterministic token costs via the literal selection rules — ruling 013;\n43\t// the goldens in view-select-golden.test.ts pin arrangements exactly).\n44\t// TARGET: equal shares for the targets-the-bound assertions (smooth absorbs\n45\t// t6–t8 within share; c1 fills detailed; brief left empty by candidacy).\n46\tconst TARGET_PARAMS = {\n47\t  lowerBound: 400,\n48\t  percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 },\n49\t};\n50\t// GRADIENT: all three bands non-empty (smooth t7+t8, detailed c2, brief c1).\n51\tconst GRADIENT_PARAMS = {\n52\t  lowerBound: 400,\n53\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n54\t};\n55\t// EDGE: compact point lands at t10's close (full 50 tokens), making c3, c2,\n56\t// and c1 chunk candidates; the brief share (30) holds c2 alone (36, loner)\n57\t// and excludes c1 — the coverage edge.\n58\tconst EDGE_PARAMS = {\n59\t  lowerBound: 100,\n60\t  percentages: { full: 50, smooth: 10, detailed: 10, brief: 30 },\n61\t};\n62\t\n63\tfunction sha256(value: unknown): string {\n64\t  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n65\t}\n66\t\n67\t// The canonical record plus its derived state — everything compact must\n68\t// never touch (AC-2.9). View tables and the boundary are deliberately\n69\t// excluded: those are compact's own rows.\n70\tfunction recordSnapshot(filePath: string): string {\n71\t  const db = openRaw(filePath);\n72\t  try {\n73\t    return sha256({\n74\t      events: db.prepare(`SELECT * FROM event ORDER BY event_order`).all(),\n75\t      messages: db.prepare(`SELECT * FROM message ORDER BY source_event_order`).all(),\n76\t      blocks: db\n77\t        .prepare(`SELECT * FROM message_block ORDER BY message_id, block_index`)\n78\t        .all(),\n79\t      turns: db.prepare(`SELECT * FROM turns ORDER BY turn_order`).all(),\n80\t      chunks: db.prepare(`SELECT * FROM chunk ORDER BY chunk_order`).all(),\n81\t      members: db.prepare(`SELECT * FROM chunk_member ORDER BY chunk_id, member_idx`).all(),\n82\t      forms: db\n83\t        .prepare(`SELECT * FROM derived_form ORDER BY subject_kind, subject_id, form`)\n84\t        .all(),\n85\t    });\n86\t  } finally {\n87\t    db.close();\n88\t  }\n89\t}\n90\t\n91\t// Full-file state including the view rows and boundary — for the\n92\t// thread-unchanged-after-rejection assertions.\n93\tfunction fullStateSnapshot(filePath: string): string {\n94\t  const db = openRaw(filePath);\n95\t  try {\n96\t    return sha256({\n97\t      record: recordSnapshot(filePath),\n98\t      views: db.prepare(`SELECT * FROM thread_view`).all(),\n99\t      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n100\t      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\n101\t      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\n102\t    });\n103\t  } finally {\n104\t    db.close();\n105\t  }\n106\t}\n107\t\n108\tfunction viewRowCount(filePath: string): number {\n109\t  const db = openRaw(filePath);\n110\t  try {\n111\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\n112\t      n: number | bigint;\n113\t    };\n114\t    return Number(row.n);\n115\t  } finally {\n116\t    db.close();\n117\t  }\n118\t}\n119\t\n120\tfunction boundaryPosition(filePath: string): number {"}]},"parent_tool_use_id":null,"session_id":"d96b6140-abf0-4148-ae10-52f37fa752e0","uuid":"7bbd22ed-21d9-4edf-bc6e-7c3f418953b3","timestamp":"2026-06-11T17:53:48.790Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-compact.test.ts","content":"// Epic 03 Story 2: smart compact (TC-2.1–2.4, TC-2.6, TC-2.7, TC-1.3,\n// TC-1.5, the TC-2.5 view-health completion legs, and the architecture-risk\n// rows: restart-serves-snapshot and coverage-edge accounting). Every TC goes\n// through the real SDK surface (createSdk().threadView.compact) against real\n// temp thread files; the provider double appears only in fixture setup —\n// degraded states are reached through production paths (scripted provider\n// exhaustion at build, edit-cascade pending clears), never by writing\n// derived_form directly.\nimport { createHash } from \"node:crypto\";\nimport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  type Lhc,\n  type MessageEventInput,\n  type ViewMessage,\n} from \"../src/index.js\";\nimport {\n  corruptTwoOpenTurns,\n  createProviderDouble,\n  derivedThreadFixture,\n  openRaw,\n  setViewInjectionHook,\n  tempStore,\n  validEvent,\n  type DerivedThreadFixture,\n  type ProviderDouble,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nlet fixture: DerivedThreadFixture;\n\nbeforeAll(async () => {\n  store = tempStore();\n  fixture = await derivedThreadFixture(store);\n});\nafterAll(() => {\n  store.cleanup();\n});\n\n// The story's reference configs (hand-derived from the fixture's\n// deterministic token costs via the literal selection rules — ruling 013;\n// the goldens in view-select-golden.test.ts pin arrangements exactly).\n// TARGET: equal shares for the targets-the-bound assertions (smooth absorbs\n// t6–t8 within share; c1 fills detailed; brief left empty by candidacy).\nconst TARGET_PARAMS = {\n  lowerBound: 400,\n  percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 },\n};\n// GRADIENT: all three bands non-empty (smooth t7+t8, detailed c2, brief c1).\nconst GRADIENT_PARAMS = {\n  lowerBound: 400,\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n};\n// EDGE: compact point lands at t10's close (full 50 tokens), making c3, c2,\n// and c1 chunk candidates; the brief share (30) holds c2 alone (36, loner)\n// and excludes c1 — the coverage edge.\nconst EDGE_PARAMS = {\n  lowerBound: 100,\n  percentages: { full: 50, smooth: 10, detailed: 10, brief: 30 },\n};\n\nfunction sha256(value: unknown): string {\n  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n}\n\n// The canonical record plus its derived state — everything compact must\n// never touch (AC-2.9). View tables and the boundary are deliberately\n// excluded: those are compact's own rows.\nfunction recordSnapshot(filePath: string): string {\n  const db = openRaw(filePath);\n  try {\n    return sha256({\n      events: db.prepare(`SELECT * FROM event ORDER BY event_order`).all(),\n      messages: db.prepare(`SELECT * FROM message ORDER BY source_event_order`).all(),\n      blocks: db\n        .prepare(`SELECT * FROM message_block ORDER BY message_id, block_index`)\n        .all(),\n      turns: db.prepare(`SELECT * FROM turns ORDER BY turn_order`).all(),\n      chunks: db.prepare(`SELECT * FROM chunk ORDER BY chunk_order`).all(),\n      members: db.prepare(`SELECT * FROM chunk_member ORDER BY chunk_id, member_idx`).all(),\n      forms: db\n        .prepare(`SELECT * FROM derived_form ORDER BY subject_kind, subject_id, form`)\n        .all(),\n    });\n  } finally {\n    db.close();\n  }\n}\n\n// Full-file state including the view rows and boundary — for the\n// thread-unchanged-after-rejection assertions.\nfunction fullStateSnapshot(filePath: string): string {\n  const db = openRaw(filePath);\n  try {\n    return sha256({\n      record: recordSnapshot(filePath),\n      views: db.prepare(`SELECT * FROM thread_view`).all(),\n      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\n      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\n    });\n  } finally {\n    db.close();\n  }\n}\n\nfunction viewRowCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\n      n: number | bigint;\n    };\n    return Number(row.n);\n  } finally {\n    db.close();\n  }\n}\n\nfunction boundaryPosition(filePath: string): number {","numLines":120,"startLine":1,"totalLines":787}}}

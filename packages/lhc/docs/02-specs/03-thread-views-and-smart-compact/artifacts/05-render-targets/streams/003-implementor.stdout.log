ompacted = await fixture.sdk.threadView.compact(\n      { filePath: fixture.filePath },\n      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 } } },\n    );\n    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\n    const materialized = await fixture.sdk.threadView.materialize(\n      { filePath: fixture.filePath },\n      { path: `${fixture.filePath}.out.jsonl` },\n    );\n\n    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\n    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\n    expect(captured.length).toBe(before);\n  });\n});\n\ndescribe(\"classification edges (architecture-risk): blocked, in-walk dedupe, unclassified\", () => {\n  let store: TempStore;\n\n  beforeAll(() => {\n    store = tempStore();\n  });\n  afterAll(() => {\n    store.cleanup();\n1c6a698 Story 4 (lhc epic 03): tool-result visibility — boundary advance on post-commit seam, floor protection, compact reset\n1765ccd Story 3 (lhc epic 03): readiness sweep — report walk, reason-class table, transient requeue, compact embed\ne08e695 Story 2 (lhc epic 03): smart compact — selection walk, degrade ladders, atomic snapshot replace, receipts, goldens G1-G4\nscripts/fc07-gate-self-test.mjs:114:  execFileSync(\"node\", [\"scripts/record-red-manifest.mjs\", RED], {\nscripts/check-test-immutability.mjs:4:// may not modify Red's. Record hashes with scripts/record-red-manifest.mjs.\nscripts/record-red-manifest.mjs:3:// Usage: node scripts/record-red-manifest.mjs test/foo.test.ts [more files...]\ncheck-boundaries.mjs\ncheck-test-immutability.mjs\nfc07-gate-self-test.mjs\nlint.mjs\nrecord-red-manifest.mjs","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
